    10817   define temp-table tt_price-doc-forming-gds-xxx no-undo like ub.price-doc-forming-gds-qnty .
    10818   define temp-table tt-gds-list no-undo like ub.goods
    10819   field nn as integer
    10820   index by-nn nn
    10821   index by_gds-code gds-code
    10822   .
    10823   function f-ost-part return decimal
    10824   ( input p-b-code as integer     ,
    10825     input p-obj-type as character ,
    10826     input p-obj-code as integer   )
    10827     :
    10828   define variable v-qnty as decimal   no-undo .
    10829   define buffer buf_bar-code for ub.bar-code  .
    10830   define buffer buf_parts for ub.parts  .
    10831   define buffer buf_gds-obj for ub.gds-obj  .
    10832   v-qnty = ? .
    10833   find first buf_bar-code no-lock where
    10834              buf_bar-code.b-code = p-b-code no-error .
    10835     find first buf_gds-obj no-lock where
    10836                 buf_gds-obj.gds-code  = buf_bar-code.gds-code and
    10837                 buf_gds-obj.obj-type  = p-obj-type  and
    10838                 buf_gds-obj.obj-code = p-obj-code  no-error .
    10839   if buf_bar-code.in-code = "" then do:
    10840      if available buf_gds-obj then  v-qnty =  buf_gds-obj.fact-qnty.
    10841   end.
    10842   else do:
    10843       find first buf_parts no-lock where
    10844                  buf_parts.artic     = buf_gds-obj.artic and
    10845                  buf_parts.prod-type = buf_gds-obj.prod-type  and
    10846                  buf_parts.prod-code = buf_gds-obj.prod-code  and
    10847                  buf_parts.obj-type  = buf_gds-obj.obj-type  and
    10848                  buf_parts.obj-code  = buf_gds-obj.obj-code  and
    10849                  buf_parts.in-code   = buf_bar-code.in-code    and
    10850                  buf_parts.part-code = buf_bar-code.part-code  and
    10851                  buf_parts.out-code   = 'free-zone':U and
    10852                  buf_parts.rsrv-free  = true and
    10853                  buf_parts.status_    = false  no-error .
    10854        if available buf_parts then v-qnty = buf_parts.fact-qnty .
    10855   end.
    10856     return v-qnty .
    10857   end function.
    10858   function func-part-code return character
    10859   ( input p-rec as recid ) :
    10860   define  BUFFER local-pdf FOR ub.price-doc-forming-gds .
    10861   define buffer buf_bar-code for ub.bar-code  .
    10862   find first local-pdf no-lock where recid (local-pdf) = p-rec no-error .
    10863   if error-status :error then return "" .
    10864   find first buf_bar-code no-lock where
    10865              buf_bar-code.b-code = local-pdf.b-code no-error .
    10866   if error-status :error then return "" .
    10867      return buf_bar-code.part-code .
    10868   end function.
    10869   function func-old-pc return decimal
    10870   ( input p-rec as recid ) :
    10871   define  BUFFER local-pdf FOR ub.price-doc-forming-gds .
    10872   find first local-pdf no-lock where recid (local-pdf) = p-rec no-error .
    10873   if error-status :error then return ? .
    10874   define variable old-pc as decimal no-undo.
    10875     old-pc = (local-pdf.price-sale-doc / local-pdf.price-prev-doc - 1) * 100.
    10876     if old-pc > 9999 then
    10877       old-pc = ?.
    10878     return (old-pc).
    10879   end function.
    10880   function func-calc-pc return decimal
    10881   ( input p-rec as recid ) :
    10882   define  BUFFER local-pdf FOR ub.price-doc-forming-gds .
    10883   find first local-pdf no-lock where recid (local-pdf) = p-rec no-error .
    10884   if error-status :error then return ? .
    10885   define variable old-pc as decimal no-undo.
    10886     old-pc = (local-pdf.price-sale-doc / local-pdf.price-calc-doc - 1) * 100.
    10887     if old-pc > 9999 then
    10888       old-pc = ?.
    10889     return (old-pc).
    10890   end function.
    10891   FUNCTION get-mark RETURNS CHARACTER
    10892   (buffer local-doc-line for buf_price-doc-forming-gds ):
    10893   if lookup (string (recid (local-doc-line)), del-list) > 0  then return "*".
    10894                                                              else return "".
    10895   end function.
    10896   function name-grp returns character
    10897    ( buffer loc-table for tt_price-doc-forming-gds-xxx   ) :
