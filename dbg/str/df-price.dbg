    11691       "$Workfile$"
    11692       "Указанному интерфейсному элементу фокус не может быть передан" skip
    11693       "Интерфейсный элемент" self :name  skip
    11694       "Тип" self :type  skip
    11695       "Процедура" this-procedure :file-name skip
    11696       view-as alert-box .
    11697   end.
    11698   else do:
    11699     apply "entry":u to self  .
    11700     if focus :handle <> self :handle  then do:
    11701       return no-apply .
    11702     end.
    11703   end.
    11704   define variable notes as character no-undo .
    11705   notes = buf_price-doc-forming.des.
    11706   if p-mode = 'ПРОСМОТР':U then do:
    11707     run gbl/d-prompt.w (
    11708         'title=Примечание\'
    11709       + 'type=editor\'
    11710       + 'fillin_width=96\'
    11711       + 'fillin_height=15\'
    11712       + 'readonly=yes\'
    11713       , input-output notes).
    11714   end.
    11715   else do:
    11716      run gbl/d-prompt.w (
    11717         'title=примечание\'
    11718       + 'type=editor\'
    11719       + 'fillin_width=96\'
    11720       + 'fillin_height=15\'
    11721       , input-output notes).
    11722     if return-value = 'false':u
    11723     then do:
    11724       return .
    11725     end.
    11726     if buf_price-doc-forming.des <> notes then do:
    11727       do transaction on error undo, return no-apply :
    11728         find current buf_price-doc-forming exclusive-lock .
    11729         assign
    11730           buf_price-doc-forming.des = notes.
    11731       end.
    11732     end.
    11733   end.
    11734   END.
