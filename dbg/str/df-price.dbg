     6982   ,output p-slt-pc
     6983   ,output v-prev-doc-code
     6984   ,output v-d-pcnt
     6985   ).
     6986   end.
     6987   else do:
     6988   run set-price-line in this-procedure (
     6989    input p-plt-id
     6990   ,input p-plt-db-num
     6991   ,input  'Единая':U
     6992   ,input  0
     6993   ,input  'Отключено':U
     6994   ,input  0
     6995   ,input  p-b-code
     6996   ,input  ub.goods.gds-code
     6997   ,input  p-artic
     6998   ,input  p-prod-type
     6999   ,input  p-prod-code
     7000   ,input  V-base-rate
     7001   ,input  V-base-scale
     7002   ,input  V-exch-scale
     7003   ,input  V-exch-rate
     7004   ,input  ""
