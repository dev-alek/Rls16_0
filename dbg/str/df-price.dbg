     6699      , output v-slt-pc
     6700      , output v-prev-doc-code
     6701      , output v-d-pcnt
     6702      ) no-error .
     6703      if error-status :error then
     6704      message
     6705        vss-workfile vss-revision vss-description skip
     6706        error-status :get-message(1) skip
     6707        return-value skip
     6708        "123calc-price-line"
     6709        "p-calc-method     "  p-calc-method     skip
     6710        "p-increase-pc     "  p-increase-pc     skip
     6711        "round-method      "    round-method    skip
     6712        "round-base        "    round-base      skip
     6713        "p-b-code          "    p-b-code        skip
     6714        "p-gds-code        "    p-gds-code      skip
     6715        "p-artic           "    p-artic         skip
     6716        "p-prod-type       "    p-prod-type     skip
     6717        "p-prod-code       "    p-prod-code     skip
     6718        "v-base-rate       "   v-base-rate     skip
     6719        "v-base-scale      "  v-base-scale    skip
     6720        "v-exch-scale      "  v-exch-scale    skip
     6721        "v-exch-rate       "  v-exch-rate     skip
     6722        "v-doc-code        "  v-doc-code      skip
