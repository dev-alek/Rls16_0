     6865   define variable v-excise-doc       as decimal   no-undo .
     6866   define variable v-excise-rubl      as decimal   no-undo .
     6867   define variable V-base-rate       as decimal   no-undo .
     6868   define variable V-base-scale      as decimal   no-undo .
     6869   define variable V-exch-scale      as decimal   no-undo .
     6870   define variable V-exch-rate       as decimal   no-undo .
     6871   define variable v-curr-abbr as character no-undo .
     6872   define variable p-vat-pc as decimal   no-undo .
     6873   define variable p-slt-pc as decimal   no-undo .
     6874     do
     6875     on error undo, return error return-value
     6876     :
     6877   find first ub.price-list-type  no-lock  where
     6878              ub.price-list-type.plt-db-num = p-plt-db-num  and
     6879              ub.price-list-type.plt-id     = p-plt-id
     6880              no-error .
     6881   if error-status :error then message
     6882     vss-workfile vss-revision vss-description skip
     6883     error-status :get-message(1) skip
     6884     return-value skip
     6885     "Ошибка!"
     6886     view-as alert-box error
     6887   .
     6888   find first ub.price-doc-forming no-lock  where
     6889              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     6890              ub.price-doc-forming.plt-id     = p-plt-id     and
     6891              ub.price-doc-forming.pdf-db     = p-pdf-db     and
     6892              ub.price-doc-forming.pdf-id     = p-pdf-id
     6893               no-error .
     6894   if error-status :error then message
     6895     vss-workfile vss-revision vss-description skip
     6896     error-status :get-message(1) skip
     6897     return-value skip
     6898     "Ошибка!"
     6899     view-as alert-box error
     6900   .
     6901   find first ub.goods no-lock where
     6902    ub.goods.artic = p-artic and
     6903    ub.goods.prod-type = p-prod-type and
     6904    ub.goods.prod-code = p-prod-code no-error .
     6905   if error-status :error then message
     6906     vss-workfile vss-revision vss-description skip
     6907     error-status :get-message(1) skip
     6908     return-value skip
     6909     "Ошибка!"
     6910     view-as alert-box error
     6911   .
     6912   if ub.price-list-type.fix-cource-crc-base = true then do:
     6913       assign
     6914         V-base-rate  = ub.price-doc-forming.base-rate
     6915         V-base-scale = ub.price-doc-forming.base-scale
     6916       .
     6917   end.
     6918   else do:
     6919   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6921     (input  v-cntxt-host-code-obj
     6922     ,input  today
     6923     ,output v-base-rate
     6924     ,output v-base-scale
     6925     )  .
     6926   end.
     6927   if ub.price-list-type.fix-cource-crc-doc = true then do:
     6928       assign
     6929         V-exch-rate  = ub.price-doc-forming.exch-rate
     6930         V-exch-scale = ub.price-doc-forming.exch-scale
     6931       .
     6932   end.
     6933   else do:
     6934   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6935   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6936     (input  ub.price-list-type.curr-code
     6937     ,input  today
     6938     ,output v-exch-rate
     6939     ,output v-exch-scale
     6940     ,output v-curr-abbr
     6941     )  .
     6942   end.
     6943   define variable p-new-calc-method as character no-undo .
     6944   define variable v-prev-doc-code as character no-undo .
     6945   define variable v-d-pcnt as decimal   no-undo .
     6946   if ub.price-list-type.main then do:
     6947   run calc-price-line in this-procedure (
     6948    input  'Единая':U
     6949   ,input  0
     6950   ,input  'Отключено':U
     6951   ,input  0
