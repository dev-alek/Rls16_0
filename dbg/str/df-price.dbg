    12230   ON CHOOSE OF MENU-ITEM m-all-chg
    12231   DO:
    12232   define variable v-prt as logical   no-undo .
    12233   define variable vrec as recid no-undo .
    12234   message
    12235   "Рассчитать продажные цены для выбранных товаров ?"
    12236     view-as alert-box question
    12237     BUTTONS yes-no
    12238     UPDATE v-ok as logical .
    12239   if not v-ok then return.
    12240   if input frame Dialog-Frame increase-pc < - 100 then do:
    12241     message "Наценка не может быть меньше - 100 % !"
    12242             view-as alert-box error.
    12243     apply "entry" to BROWSE-1 in frame Dialog-Frame.
    12244     return no-apply.
    12245   end.
    12246   if not available buf_price-doc-forming-gds then do:
    12247     message "Задайте товары клавишей 'ДОБАВИТЬ' ! "
    12248             view-as alert-box error.
    12249     return no-apply.
    12250   end.
    12251     for each buf_price-doc-forming-gds
    12252        where buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
    12253          and buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
    12254          and buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
    12255          and buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db no-lock :
    12256             assign vrec = recid(buf_price-doc-forming-gds) no-error .
    12257             if lookup(string(vrec), del-list) = 0 then next.
    12258             find first buf_goods
    12259                  where buf_goods.artic     = buf_price-doc-forming-gds.artic
    12260                    and buf_goods.prod-type = buf_price-doc-forming-gds.prod-type
    12261                    and buf_goods.prod-code = buf_price-doc-forming-gds.prod-code no-lock no-error .
    12262             empty temp-table  tt-gds-list .
    12263             create tt-gds-list.
    12264             buffer-copy buf_goods to tt-gds-list .
    12265             run ver-bar-code-prt (input buf_price-doc-forming-gds.b-code , output v-prt ) .
    12266             if v-prt then do:
    12267               run proc-add-gds in this-procedure ( 3 , buf_price-doc-forming-gds.b-code ) .
    12268             end.
    12269             else do:
    12270               run proc-add-gds in this-procedure ( 2 , ? ) .
    12271             end.
    12272     end.
    12273   reposition browse-1 to recid vrec no-error .
    12274   run vc-pdf in this-procedure .
    12275   END.
    12276   ON CHOOSE OF MENU-ITEM m-import-bb
    12277   DO:
    12278     run import-proc in this-procedure  ("bb").
    12279     run OpenBr in this-procedure (yes, no, '':U).
    12280     find first buf_price-doc-forming-gds no-lock where
    12281                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    12282                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    12283                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    12284                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    12285                buf_price-doc-forming-gds.line-num   = v-line-num no-error .
    12286      reposition browse-1 to rowid rowid(buf_price-doc-forming-gds) no-error .
    12287      apply "value-changed" to browse-1 in frame Dialog-Frame.
    12288   END.
    12289   ON CHOOSE OF MENU-ITEM m-import-txt
    12290   DO:
    12291     run import-proc in this-procedure  ("txt").
    12292     run OpenBr in this-procedure (yes, no, '':U).
    12293     find first buf_price-doc-forming-gds no-lock where
    12294                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    12295                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    12296                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    12297                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    12298                buf_price-doc-forming-gds.line-num   = v-line-num no-error .
    12299      reposition browse-1 to rowid rowid(buf_price-doc-forming-gds) no-error .
    12300      apply "value-changed" to browse-1 in frame Dialog-Frame.
    12301   END.
    12302   ON CHOOSE OF MENU-ITEM m-one-chg
    12303   DO:
    12304   define variable v-prt as logical   no-undo .
    12305   define variable vrec as recid no-undo .
    12306   if input frame Dialog-Frame increase-pc < - 100 then do:
    12307     message "Наценка не может быть меньше - 100 % !"
    12308             view-as alert-box error.
    12309     apply "entry" to BROWSE-1 in frame Dialog-Frame.
    12310     return no-apply.
    12311   end.
    12312   if not available buf_price-doc-forming-gds then do:
    12313     message "Задайте товары клавишей 'ДОБАВИТЬ' ! "
    12314             view-as alert-box error.
    12315     return no-apply.
    12316   end.
    12317   find first buf_goods no-lock where
    12318              buf_goods.artic     = buf_price-doc-forming-gds.artic          and
    12319              buf_goods.prod-type = buf_price-doc-forming-gds.prod-type  and
    12320              buf_goods.prod-code = buf_price-doc-forming-gds.prod-code  no-error .
    12321   empty temp-table  tt-gds-list .
    12322   create tt-gds-list.
    12323   buffer-copy buf_goods to tt-gds-list .
    12324   vrec = recid(buf_price-doc-forming-gds) no-error .
    12325   run ver-bar-code-prt (input buf_price-doc-forming-gds.b-code , output v-prt ) .
    12326   if v-prt then do:
    12327      run proc-add-gds in this-procedure ( 3 , buf_price-doc-forming-gds.b-code ) .
    12328   end.
    12329   else do:
    12330      run proc-add-gds in this-procedure ( 2 , ? ) .
    12331      end.
    12332   reposition browse-1 to recid vrec no-error .
    12333   run vc-pdf in this-procedure .
    12334   END.
    12335   ON CHOOSE OF r-copy IN FRAME Dialog-Frame
    12336   DO:
    12337   define variable vss-include-info108 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12338   if lookup(self :type
    12339            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    12340            ) = 0
    12341   then do:
    12342     message
    12343       "$Workfile$"
    12344       "Указанному интерфейсному элементу фокус не может быть передан" skip
    12345       "Интерфейсный элемент" self :name  skip
    12346       "Тип" self :type  skip
    12347       "Процедура" this-procedure :file-name skip
    12348       view-as alert-box .
    12349   end.
    12350   else do:
    12351     apply "entry":u to self  .
    12352     if focus :handle <> self :handle  then do:
    12353       return no-apply .
    12354     end.
    12355   end.
    12356   define variable loc-ref-list as character no-undo .
    12357   define variable ref-list as character no-undo .
    12358   define variable ref-rec as recid no-undo .
    12359   case calc-method:
    12360     when 'Объект':U then do:
    12361       run ref/cli-all.w
    12362         ( parParentProc
    12363           , "b-sel"
    12364           , ?
    12365           , ?
    12366           , ?
    12367           , ?
    12368           , ?
    12369           , ?
    12370           , output ref-list) .
    12371       apply "entry" to copy-type in frame Dialog-Frame.
    12372       if ref-list = "" then
    12373         return no-apply.
    12374       ref-rec = integer (ref-list).
    12375       find ub.clients where recid (ub.clients) = ref-rec no-lock.
    12376       if not ( ub.clients.obj-type = 'скл':U or
    12377                ub.clients.obj-type = 'маг':U ) then do:
    12378         message "Объектом для копирования цены может быть только склад или магазин."
    12379                 view-as alert-box error.
    12380         return no-apply.
    12381       end.
    12382       assign
    12383         copy-code = ub.clients.obj-code
    12384         copy-type = ub.clients.obj-type
    12385         .
    12386       display copy-type copy-code with frame Dialog-Frame.
    12387     end.
    12388     when 'Накладная':U  or
    12389     when 'НсП+накл':U or
    12390     when 'Накл-безНДС':U then do:
    12391       assign
    12392         doc-rec = ?  .
    12393       run str/all-docs.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code, input 'объект':U, input ?, input ?, input ?, input ?, input "b-sel":u, input ?, input ?, input ?, output loc-ref-list).
    12394       find ub.trn-doc where recid (ub.trn-doc) = int (loc-ref-list) no-lock no-error .
    12395       if not available ub.trn-doc then do:
    12396         message "Накладная не выбрана."
    12397                 view-as alert-box error.
    12398         return no-apply.
    12399       end.
    12400       doc-code = ub.trn-doc.doc-code.
    12401       display doc-code with frame Dialog-Frame.
    12402     end.
    12403     when 'Единая':U then do:
    12404       display common-price with frame Dialog-Frame.
    12405     end.
    12406     when 'ДокФормЦены':U then do:
    12407       run str/docsprls.w ( parparentproc , "all" , ? , ? , "b-sel" , input-output loc-ref-list) .
    12408       find first ub.price-doc-forming no-lock where recid ( ub.price-doc-forming ) = integer ( loc-ref-list ) no-error.
    12409       if not available ub.price-doc-forming then do:
    12410          message "ДНЦ не выбран." error-status :get-message(1)  view-as alert-box error.
    12411          return no-apply.
    12412       end.
    12413       doc-code = string(ub.price-doc-forming.pdf-id) + "|" +  string(ub.price-doc-forming.pdf-db)  .
    12414       display doc-code with frame Dialog-Frame.
    12415     end.
    12416     when 'Переоценка':U then do:
    12417       run str/pr-docs.w (
    12418           input parParentProc ,
    12419           input "b-sel":U ,
    12420           input 'работа':U ,
    12421           input "" ,
    12422           input v-cntxt-obj-type ,
    12423           input v-cntxt-obj-code ,
    12424           input "" ,
    12425           output loc-ref-list ).
    12426       doc-rec = integer ( loc-ref-list ) .
    12427       find ub.price-doc where recid (ub.price-doc) = doc-rec no-lock no-error.
    12428       if not available ub.price-doc then do:
    12429         message "Переоценка не выбрана."
    12430                 view-as alert-box error.
    12431         return no-apply.
    12432       end.
    12433       doc-code = ub.price-doc.doc-num.
    12434       display doc-code with frame Dialog-Frame.
    12435     end.
    12436     otherwise do:
    12437            assign
    12438                 doc-rec = ?  .
    12439               run str/all-docs.w
    12440                  (input parparentproc,
    12441                   input v-cntxt-host-code-obj,
    12442                   input v-cntxt-obj-type,
    12443                   input v-cntxt-obj-code,
    12444                   input  'ТИП':U,
    12445                   input  ?   ,
    12446                   input  'при':U ,
    12447                   input  ?         ,
    12448                   input  no        ,
    12449                   input  "b-sel":U ,
    12450                   input  'ie':U,
    12451                   input  false          ,
    12452                   input  ?              ,
    12453                   output loc-ref-list).
    12454               find ub.trn-doc where recid (ub.trn-doc) = int (loc-ref-list) no-lock no-error .
    12455               if not available ub.trn-doc then do:
    12456                 message "Накладная не выбрана."
    12457                         view-as alert-box error.
    12458                 return no-apply.
    12459               end.
    12460               doc-code = ub.trn-doc.doc-code.
    12461               display doc-code with frame Dialog-Frame.
    12462       end.
    12463   end case.
    12464     if par-is-pharm = "yes" then do:
    12465       find first ub.trn-doc no-lock  where ub.trn-doc.doc-code = doc-code no-error .
    12466       if available ub.trn-doc then do:
    12467           message
    12468           "Добавить товары и партии из накладной"
    12469             doc-code "в ДНЦ ?"
    12470             view-as alert-box question
    12471             BUTTONS yes-no
    12472             UPDATE v-ok as logical .
    12473               if v-ok then do:
    12474                  empty temp-table tt-gds-list.
    12475                  run proc-add-gds in this-procedure  ( input 4 , ? ).
    12476                  run OpenBr in this-procedure (yes, no, '':U).
    12477               end.
    12478       end.
    12479     end.
    12480   END.
    12481   ON VALUE-CHANGED OF R-mode-code IN FRAME Dialog-Frame
    12482   DO:
    12483     ASSIGN R-mode-code.
    12484     RUN OpenBr in this-procedure (yes, no, '':U).
    12485   END.
    12486   ON VALUE-CHANGED OF round-method IN FRAME Dialog-Frame
    12487   DO:
    12488    assign round-method .
    12489    run proc-value-2 in this-procedure .
    12490   END.
    12491   assign
    12492     b-chg     :popup-menu in frame Dialog-Frame         = menu m-chg  :handle
    12493     b-chg     :menu-mouse                                = 1
    12494     b-import  :popup-menu in frame Dialog-Frame         = menu m-import :handle
    12495     b-import  :menu-mouse                                = 1
    12496   .
    12497   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
    12498   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
    12499   define variable vss-include-info109 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12500   on help of frame Dialog-Frame
    12501   do:
    12502     run gbl/app_help.p
    12503       (input this-procedure :file-name
    12504       ,input ''
    12505       ,input ?
    12506       ) no-error.
    12507     if error-status :error then do:
    12508       message
    12509         "Ошибка при вызове помощи"
    12510         error-status :get-message(1)
    12511         view-as alert-box .
    12512     end.
    12513   end.
    12514   run minbtn-set in this-procedure .
    12515   on choose of b-help in frame Dialog-Frame
    12516   do:
    12517     apply "help":u to frame Dialog-Frame .
    12518   end.
    12519   define variable vss-include-info110 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12520   procedure minbtn-set :
    12521       do
    12522           on error undo, return error return-value
    12523           :
    12524           define variable ii              as integer       no-undo .
    12525           define variable fh              as widget-handle no-undo .
    12526           define variable hh              as widget-handle no-undo .
    12527           define variable v-h             as handle        extent 4 no-undo .
    12528           define variable v-name-button   as character     no-undo .
    12529           define variable v-help-old-x    as decimal       no-undo .
    12530           define variable v-help-old-y    as decimal       no-undo .
    12531           define variable v-help-old-size as decimal       no-undo .
    12532           define variable v-frame-width   as decimal       no-undo .
    12533           define variable jj              as integer       no-undo .
    12534           do
    12535               on error undo, return error
    12536               :
    12537               assign
    12538                   v-frame-width = frame Dialog-Frame:width - 0.3
    12539                   fh            = frame Dialog-Frame:first-child
    12540                   hh            = fh:first-child
    12541                   ii            = 1
    12542                   .
    12543               do while valid-handle(hh):
    12544                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    12545                   do:
    12546                       case lc(hh:name) :
    12547                           when "b-help" then
    12548                               do:
    12549                                   hh:load-image-up("cmp/b-help.bmp":u) .
    12550                                   hh:load-image-down("cmp/b-help.bmp":u) .
    12551                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    12552                                   hh:TOOLTIP = "Помощь" .
    12553                                   v-help-old-x = hh:column .
    12554                                   v-help-old-y = hh:row    .
    12555                                   v-help-old-size = hh:width .
    12556                                   hh:width-chars = 2.5 .
    12557                               end.
    12558                           when "b-print" then
    12559                               do:
    12560                                   hh:load-image("cmp/b-print.bmp":u) .
    12561                                   hh:TOOLTIP = "Печать" .
    12562                                   v-h[ii] = hh:handle .
    12563                                   ii = ii + 1 .
    12564                                   hh:width-chars = 3 .
    12565                               end.
    12566                           when "b-history" or
    12567                           when "b-hist" then
    12568                               do:
    12569                                   hh:load-image("cmp/b-hist.bmp":u) .
    12570                                   hh:TOOLTIP = "История" .
    12571                                   v-h[ii] = hh:handle .
    12572                                   ii = ii + 1 .
    12573                                   hh:width-chars = 3 .
    12574                               end.
    12575                           when "b-sch" then
    12576                               do:
    12577                                   hh:load-image("cmp/b-sch.bmp":u) .
    12578                                   hh:TOOLTIP = "Установка Фильтра" .
    12579                                   v-h[ii] = hh:handle .
    12580                                   ii = ii + 1 .
    12581                                   hh:width-chars = 3 .
    12582                               end.
    12583                           when "b-hist-user" then
    12584                               do:
    12585                                   hh:load-image("cmp/b-hist.bmp":u) .
    12586                                   hh:TOOLTIP = "История пользователя" .
    12587                                   ii = ii + 1 .
    12588                               end.
    12589                       end case.
    12590                   end.
    12591                   hh = hh:next-sibling.
    12592               end.
    12593               b-help:column = v-frame-width - b-help:width-chars.
    12594               jj = 0.
    12595               repeat ii = 4 to 1 by -1 :
    12596                   if valid-handle (v-h[ii] ) then
    12597                   do:
    12598                       jj  = jj + 1 .
    12599                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    12600                       v-h[ii]:row    = v-help-old-y .
    12601                   end.
    12602               end.
    12603           end.
    12604       end.
    12605   end procedure.
    12606   define variable vss-include-info111 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    12607   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    12608   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    12609   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    12610   define variable v-diasize-current-frame-width  as decimal   no-undo .
    12611   define variable v-diasize-current-frame-height as decimal   no-undo .
    12612   define variable v-diasize-change-size          as logical   no-undo .
    12613   define variable v-diasize-resize-button        as handle    no-undo .
    12614   define variable v-diasize-wndmax               as logical   no-undo .
    12615   define variable v-diasize-wndstore             as logical   no-undo .
    12616   define variable v-diasize-proc-name            as character no-undo .
    12617   define variable v-diasize-browse-handle        as handle    no-undo .
    12618   define variable v-diasize-browse-number        as integer   no-undo .
    12619   define variable v-diasize-need-full-display    as logical   no-undo init false .
    12620   define temp-table temp-diasize-handle no-undo
    12621     field handle-value  as handle
    12622     field save-position as decimal
    12623     index xpk is primary unique handle-value
    12624     .
    12625   define temp-table temp-browse-handle no-undo
    12626     field browse-type   as character
    12627     field browse-number as integer
    12628     field browse-handle as handle
    12629     field original-size as decimal
    12630     index xpk is primary unique browse-type browse-number
    12631     index xie browse-type browse-handle
    12632   .
    12633   procedure diasize_change-height :
    12634     define input  parameter p-change-value  as decimal   no-undo .
    12635     define input  parameter p-move-resize   as logical   no-undo .
    12636     define variable v-field-group-handle    as handle    no-undo .
    12637     define variable v-object-handle         as handle    no-undo .
    12638     define variable v-frame-height          as decimal   no-undo .
    12639     define variable v-frame-virtual-height  as decimal   no-undo .
    12640     define variable v-browse-height         as decimal   no-undo .
    12641     define variable v-window-height         as decimal   no-undo .
    12642     define variable v-window-virtual-height as decimal   no-undo .
    12643     define variable v-change-sign           as integer   no-undo .
    12644     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    12645     define buffer buf_temp-browse-handle  for temp-browse-handle .
    12646     if p-change-value > 0
    12647     then do:
    12648       if frame Dialog-Frame :height + p-change-value
    12649           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    12650       then do:
    12651         assign
    12652           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    12653                           - (frame Dialog-Frame :height-chars)
    12654         .
    12655         if p-change-value <= 0
    12656         then do:
    12657           run diasize_position-resize-button in this-procedure .
    12658           return .
    12659         end.
    12660       end.
    12661     end.
    12662     if p-change-value < 0
    12663     then do:
    12664       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
    12665       then do:
    12666         assign
    12667           p-change-value = v-diasize-orig-frame-height
    12668                          - (frame Dialog-Frame :height-chars)
    12669         .
    12670         if p-change-value >= 0
    12671         then do:
    12672           run diasize_position-resize-button in this-procedure .
    12673           return .
    12674         end.
    12675       end.
    12676     end.
    12677     if p-change-value >= 0
    12678     then do:
    12679       assign
    12680         v-change-sign = 1
    12681       .
    12682     end.
    12683     else do:
    12684       assign
    12685         v-change-sign = -1
    12686       .
    12687     end.
    12688     assign
    12689       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    12690     .
    12691     if p-change-value = 0
    12692     then do:
    12693       run diasize_position-resize-button in this-procedure .
    12694       return .
    12695     end.
    12696     move_block:
    12697     do
    12698     on error undo move_block, retry move_block
    12699     :
    12700       if retry
    12701       then do:
    12702         do
    12703         on error undo move_block, leave move_block
    12704         :
    12705           if p-change-value > 0
    12706           then do:
    12707             for each buf_temp-diasize-handle
    12708             on error undo, next
    12709             :
    12710               assign
    12711                 v-object-handle = buf_temp-diasize-handle.handle-value
    12712               .
    12713               if v-object-handle <> v-diasize-resize-button
    12714               then do:
    12715                 assign
    12716                   v-object-handle :row = buf_temp-diasize-handle.save-position
    12717                 .
    12718               end.
    12719             end.
    12720             assign
    12721               v-diasize-browse-handle :height = v-browse-height
    12722             .
    12723             for each buf_temp-browse-handle
    12724               where buf_temp-browse-handle.browse-type = 'height':u
    12725             on error undo, next
    12726             :
    12727               assign
    12728                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    12729               .
    12730             end.
    12731             assign
    12732               frame Dialog-Frame :height = v-frame-height
    12733             .
    12734             if frame Dialog-Frame :scrollable = true
    12735             then do:
    12736               assign
    12737                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
    12738               .
    12739             end.
    12740             run diasize_position-resize-button in this-procedure .
    12741           end.
    12742           else do:
    12743             if frame Dialog-Frame :scrollable = true
    12744             then do:
    12745               assign
    12746                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
    12747               .
    12748             end.
    12749             assign
    12750               frame Dialog-Frame :height = v-frame-height
    12751             .
    12752             assign
    12753               v-diasize-browse-handle :height = v-browse-height
    12754             .
    12755             for each buf_temp-browse-handle
    12756               where buf_temp-browse-handle.browse-type = 'height':u
    12757             on error undo, next
    12758             :
    12759               assign
    12760                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    12761               .
    12762             end.
    12763             for each buf_temp-diasize-handle
    12764             on error undo, next
    12765             :
    12766               assign
    12767                 v-object-handle = buf_temp-diasize-handle.handle-value
    12768               .
    12769               if v-object-handle <> v-diasize-resize-button
    12770               then do:
    12771                 assign
    12772                   v-object-handle :row = buf_temp-diasize-handle.save-position
    12773                 .
    12774               end.
    12775             end.
    12776             run diasize_position-resize-button in this-procedure .
    12777           end.
    12778           assign
    12779             v-diasize-change-size = false
    12780           .
    12781           leave move_block .
    12782         end.
    12783       end.
    12784       assign
    12785         v-diasize-need-full-display = true
    12786       .
    12787       if v-diasize-change-size = false
    12788       then do:
    12789         assign
    12790           v-diasize-change-size = true
    12791         .
    12792       end.
    12793       else do:
    12794         return .
    12795       end.
    12796       assign
    12797         v-frame-height = frame Dialog-Frame :height
    12798         v-frame-virtual-height = frame Dialog-Frame :virtual-height
    12799         v-browse-height = v-diasize-browse-handle :height
    12800       .
    12801       for each buf_temp-browse-handle
    12802         where buf_temp-browse-handle.browse-type = 'height':u
    12803       :
    12804         assign
    12805           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
    12806         .
    12807       end.
    12808       for each buf_temp-diasize-handle
    12809       :
    12810         delete buf_temp-diasize-handle .
    12811       end.
    12812       assign
    12813         v-field-group-handle = frame Dialog-Frame :first-child
    12814       .
    12815       do while valid-handle(v-field-group-handle)
    12816       :
    12817         assign
    12818           v-object-handle = v-field-group-handle :first-child
    12819         .
    12820         do while valid-handle(v-object-handle)
    12821         :
    12822           if  v-object-handle <> v-diasize-browse-handle :handle
    12823           and can-query(v-object-handle, "row")
    12824           and can-query(v-object-handle, "height")
    12825           and ( v-object-handle :row > v-diasize-browse-handle :row )
    12826           then do:
    12827             find first buf_temp-browse-handle
    12828               where buf_temp-browse-handle.browse-type   = 'height':u
    12829                 and buf_temp-browse-handle.browse-handle = v-object-handle
    12830               no-error .
    12831             if available buf_temp-browse-handle
    12832             then do:
    12833             end.
    12834             else do:
    12835               create buf_temp-diasize-handle .
    12836               assign
    12837                 buf_temp-diasize-handle.handle-value  = v-object-handle
    12838                 buf_temp-diasize-handle.save-position = v-object-handle :row
    12839               .
    12840             end.
    12841           end.
    12842           assign
    12843             v-object-handle = v-object-handle :next-sibling
    12844           .
    12845         end.
    12846         assign
    12847           v-field-group-handle = v-field-group-handle :next-sibling
    12848         .
    12849       end.
    12850       do with frame Dialog-Frame
    12851       :
    12852         hide v-diasize-resize-button .
    12853         assign
    12854           v-diasize-resize-button :row    = 1
    12855           v-diasize-resize-button :column = 1
    12856         .
    12857       end.
    12858       if p-change-value > 0
    12859       then do:
    12860         if frame Dialog-Frame :scrollable = true
    12861         then do:
    12862           assign
    12863             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
    12864             no-error .
    12865           if error-status :error
    12866           or error-status :get-message(1) <> ""
    12867           then do:
    12868             undo move_block, retry move_block .
    12869           end.
    12870         end.
    12871         assign
    12872           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
    12873           no-error .
    12874         if error-status :error
    12875         or error-status :get-message(1) <> ""
    12876         then do:
    12877           undo move_block, retry move_block .
    12878         end.
    12879         assign
    12880           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    12881           no-error .
    12882         if error-status :error
    12883         or error-status :get-message(1) <> ""
    12884         then do:
    12885           undo move_block, retry move_block .
    12886         end.
    12887         for each buf_temp-browse-handle
    12888           where buf_temp-browse-handle.browse-type = 'height':u
    12889         on error undo move_block, retry move_block
    12890         :
    12891           assign
    12892             buf_temp-browse-handle.browse-handle :height
    12893               = buf_temp-browse-handle.browse-handle :height + p-change-value
    12894             no-error .
    12895           if error-status :error
    12896           or error-status :get-message(1) <> ""
    12897           then do:
    12898             undo move_block, retry move_block .
    12899           end.
    12900         end.
    12901         for each buf_temp-diasize-handle
    12902         on error undo move_block, retry move_block
    12903         :
    12904           assign
    12905             v-object-handle = buf_temp-diasize-handle.handle-value
    12906           .
    12907           if v-object-handle <> v-diasize-resize-button
    12908           then do:
    12909             assign
    12910               v-object-handle :row = v-object-handle :row + p-change-value
    12911               no-error .
    12912             if error-status :error
    12913             or error-status :get-message(1) <> ""
    12914             then do:
    12915               undo move_block, retry move_block .
    12916             end.
    12917           end.
    12918         end.
    12919       end.
    12920       else do:
    12921         for each buf_temp-diasize-handle
    12922         on error undo move_block, retry move_block
    12923         :
    12924           assign
    12925             v-object-handle = buf_temp-diasize-handle.handle-value
    12926           .
    12927           if v-object-handle <> v-diasize-resize-button
    12928           then do:
    12929             assign
    12930               v-object-handle :row = v-object-handle :row + p-change-value
    12931               no-error .
    12932             if error-status :error
    12933             or error-status :get-message(1) <> ""
    12934             then do:
    12935               undo move_block, retry move_block .
    12936             end.
    12937           end.
    12938         end.
    12939         assign
    12940           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    12941           no-error .
    12942         if error-status :error
    12943         or error-status :get-message(1) <> ""
    12944         then do:
    12945           undo move_block, retry move_block .
    12946         end.
    12947         for each buf_temp-browse-handle
    12948           where buf_temp-browse-handle.browse-type = 'height':u
    12949         on error undo move_block, retry move_block
    12950         :
    12951           assign
    12952             buf_temp-browse-handle.browse-handle :height
    12953               = buf_temp-browse-handle.browse-handle :height + p-change-value
    12954             no-error .
    12955           if error-status :error
    12956           or error-status :get-message(1) <> ""
    12957           then do:
    12958             undo move_block, retry move_block .
    12959           end.
    12960         end.
    12961         assign
    12962           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
    12963           no-error .
    12964         if error-status :error
    12965         or error-status :get-message(1) <> ""
    12966         then do:
    12967           undo move_block, retry move_block .
    12968         end.
    12969         if frame Dialog-Frame :scrollable = true
    12970         then do:
    12971           assign
    12972             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
    12973             no-error .
    12974           if error-status :error
    12975           or error-status :get-message(1) <> ""
    12976           then do:
    12977             undo move_block, retry move_block .
    12978           end.
    12979         end.
    12980       end.
    12981       if p-move-resize = true
    12982       then do:
    12983         run diasize_position-resize-button in this-procedure .
    12984       end.
    12985       if v-diasize-wndstore = true
    12986       then do:
    12987         if connected("ub") = true
    12988         then do:
    12989           define variable v-cntxt-db-num        as integer   no-undo .
    12990           define variable v-cntxt-userid        as character no-undo .
    12991           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    12992                                             , OUTPUT v-cntxt-userid
    12993                                             ) .
    12994           run gbl/wndsizew.p
    12995             (input  v-cntxt-db-num
    12996             ,input  v-cntxt-userid
    12997             ,input  v-diasize-proc-name
    12998             ,input  'height':u
    12999             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
    13000             ) .
    13001         end.
    13002       end.
    13003     end.
    13004     assign
    13005       v-diasize-change-size = false
    13006     .
    13007   end procedure.
    13008   procedure diasize_set-height :
    13009     define input  parameter p-new-height  as decimal   no-undo .
    13010     define input  parameter p-move-resize as logical   no-undo .
    13011     do
    13012     on error undo, return error return-value
    13013     :
    13014       run diasize_change-height in this-procedure
    13015         (input  (p-new-height - frame Dialog-Frame :height)
    13016         ,input  p-move-resize
    13017         ) .
    13018     end.
    13019   end procedure.
    13020   procedure diasize_change-width :
    13021     define input  parameter p-change-value as decimal   no-undo .
    13022     define input  parameter p-move-resize  as logical   no-undo .
    13023     define variable v-field-group-handle   as handle    no-undo .
    13024     define variable v-object-handle        as handle    no-undo .
    13025     define variable v-frame-width          as decimal   no-undo .
    13026     define variable v-frame-virtual-width  as decimal   no-undo .
    13027     define variable v-browse-width         as decimal   no-undo .
    13028     define variable v-window-width         as decimal   no-undo .
    13029     define variable v-window-virtual-width as decimal   no-undo .
    13030     define variable v-change-sign          as integer   no-undo .
    13031     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    13032     define buffer buf_temp-browse-handle  for temp-browse-handle .
    13033     if p-change-value > 0
    13034     then do:
    13035       if frame Dialog-Frame :width + p-change-value >
    13036           session :width-chars
    13037       then do:
    13038         assign
    13039           p-change-value = session :width-chars - frame Dialog-Frame :width
    13040         .
    13041         if p-change-value <= 0
    13042         then do:
    13043           run diasize_position-resize-button in this-procedure .
    13044           return .
    13045         end.
    13046       end.
    13047     end.
    13048     if p-change-value < 0
    13049     then do:
    13050       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
    13051       then do:
    13052         assign
    13053           p-change-value = v-diasize-orig-frame-width
    13054                          - frame Dialog-Frame :width
    13055         .
    13056         if p-change-value >= 0
    13057         then do:
    13058           run diasize_position-resize-button in this-procedure .
    13059           return .
    13060         end.
    13061       end.
    13062     end.
    13063     if p-change-value >= 0
    13064     then do:
    13065       assign
    13066         v-change-sign = 1
    13067       .
    13068     end.
    13069     else do:
    13070       assign
    13071         v-change-sign = -1
    13072       .
    13073     end.
    13074     assign
    13075       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    13076     .
    13077     if p-change-value = 0
    13078     then do:
    13079       run diasize_position-resize-button in this-procedure .
    13080       return .
    13081     end.
    13082     move_block:
    13083     do
    13084     on error undo move_block, leave move_block
    13085     :
    13086       if retry
    13087       then do:
    13088         do
    13089         on error undo move_block, leave move_block
    13090         :
    13091           if p-change-value > 0
    13092           then do:
    13093             for each buf_temp-diasize-handle
    13094             on error undo, next
    13095             :
    13096               assign
    13097                 v-object-handle = buf_temp-diasize-handle.handle-value
    13098               .
    13099               if v-object-handle <> v-diasize-resize-button
    13100               then do:
    13101                 assign
    13102                   v-object-handle :col = buf_temp-diasize-handle.save-position
    13103                 .
    13104               end.
    13105             end.
    13106             assign
    13107               v-diasize-browse-handle :width = v-browse-width
    13108             .
    13109             for each buf_temp-browse-handle
    13110               where buf_temp-browse-handle.browse-type = 'width':u
    13111             on error undo, next
    13112             :
    13113               assign
    13114                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    13115               .
    13116             end.
    13117             assign
    13118               frame Dialog-Frame :width = v-frame-width
    13119             .
    13120             if frame Dialog-Frame :scrollable = true
    13121             then do:
    13122               assign
    13123                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
    13124               .
    13125             end.
    13126             run diasize_position-resize-button in this-procedure .
    13127           end.
    13128           else do:
    13129             if frame Dialog-Frame :scrollable = true
    13130             then do:
    13131               assign
    13132                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
    13133               .
    13134             end.
    13135             assign
    13136               frame Dialog-Frame :width = v-frame-width
    13137             .
    13138             for each buf_temp-browse-handle
    13139               where buf_temp-browse-handle.browse-type = 'width':u
    13140             on error undo, next
    13141             :
    13142               assign
    13143                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    13144               .
    13145             end.
    13146             assign
    13147               v-diasize-browse-handle :width = v-browse-width
    13148             .
    13149             for each buf_temp-diasize-handle
    13150             on error undo, next
    13151             :
    13152               assign
    13153                 v-object-handle = buf_temp-diasize-handle.handle-value
    13154               .
    13155               if v-object-handle <> v-diasize-resize-button
    13156               then do:
    13157                 assign
    13158                   v-object-handle :col = buf_temp-diasize-handle.save-position
    13159                 .
    13160               end.
    13161             end.
    13162             run diasize_position-resize-button in this-procedure .
    13163           end.
    13164           assign
    13165             v-diasize-change-size = false
    13166           .
    13167           leave move_block .
    13168         end.
    13169       end.
    13170       assign
    13171         v-diasize-need-full-display = true
    13172       .
    13173       if v-diasize-change-size = false
    13174       then do:
    13175         assign
    13176           v-diasize-change-size = true
    13177         .
    13178       end.
    13179       else do:
    13180         return .
    13181       end.
    13182       assign
    13183         v-frame-width = frame Dialog-Frame :width
    13184         v-frame-virtual-width = frame Dialog-Frame :virtual-width
    13185         v-browse-width = v-diasize-browse-handle :width
    13186       .
    13187       for each buf_temp-browse-handle
    13188         where buf_temp-browse-handle.browse-type = 'width':u
    13189       :
    13190         assign
    13191           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
    13192         .
    13193       end.
    13194       for each buf_temp-diasize-handle
    13195       :
    13196         delete buf_temp-diasize-handle .
    13197       end.
    13198       assign
    13199         v-field-group-handle = frame Dialog-Frame :first-child
    13200       .
    13201       do while valid-handle(v-field-group-handle)
    13202       :
    13203         assign
    13204           v-object-handle = v-field-group-handle :first-child
    13205         .
    13206         do while valid-handle(v-object-handle)
    13207         :
    13208           if  v-object-handle <> v-diasize-browse-handle :handle
    13209           and v-object-handle <> v-diasize-resize-button
    13210           and can-query(v-object-handle, "row")
    13211           and can-query(v-object-handle, "height")
    13212           and ( v-object-handle :col + v-object-handle :width
    13213                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
    13214               )
    13215           then do:
    13216             find first buf_temp-browse-handle
    13217               where buf_temp-browse-handle.browse-type   = 'width':u
    13218                 and buf_temp-browse-handle.browse-handle = v-object-handle
    13219               no-error .
    13220             if available buf_temp-browse-handle
    13221             then do:
    13222             end.
    13223             else do:
    13224               create buf_temp-diasize-handle .
    13225               assign
    13226                 buf_temp-diasize-handle.handle-value  = v-object-handle
    13227                 buf_temp-diasize-handle.save-position = v-object-handle :col
    13228               .
    13229             end.
    13230           end.
    13231           assign
    13232             v-object-handle = v-object-handle :next-sibling
    13233           .
    13234         end.
    13235         assign
    13236           v-field-group-handle = v-field-group-handle :next-sibling
    13237         .
    13238       end.
    13239       do with frame Dialog-Frame
    13240       :
    13241         hide v-diasize-resize-button .
    13242         v-diasize-resize-button :row = 1.
    13243         v-diasize-resize-button :column = 1.
    13244       end.
    13245       if p-change-value > 0
    13246       then do:
    13247         if frame Dialog-Frame :scrollable = true
    13248         then do:
    13249           assign
    13250             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
    13251             no-error .
    13252           if error-status :error
    13253           or error-status :get-message(1) <> ""
    13254           then do:
    13255             undo move_block, retry move_block.
    13256           end.
    13257         end.
    13258         assign
    13259           frame Dialog-Frame :width = v-frame-width + p-change-value
    13260           no-error .
    13261         if error-status :error
    13262         or error-status :get-message(1) <> ""
    13263         then do:
    13264           undo move_block, retry move_block.
    13265         end.
    13266         assign
    13267           v-diasize-browse-handle :width = v-browse-width + p-change-value
    13268         no-error .
    13269         if error-status :error
    13270         or error-status :get-message(1) <> ""
    13271         then do:
    13272           undo move_block, retry move_block.
    13273         end.
    13274         for each buf_temp-browse-handle
    13275           where buf_temp-browse-handle.browse-type = 'width':u
    13276         on error undo move_block, retry move_block
    13277         :
    13278           assign
    13279             buf_temp-browse-handle.browse-handle :width
    13280               = buf_temp-browse-handle.browse-handle :width + p-change-value
    13281             no-error .
    13282           if error-status :error
    13283           or error-status :get-message(1) <> ""
    13284           then do:
    13285             undo move_block, retry move_block .
    13286           end.
    13287         end.
    13288         for each buf_temp-diasize-handle
    13289         on error undo move_block, retry move_block
    13290         :
    13291           assign
    13292             v-object-handle = buf_temp-diasize-handle.handle-value
    13293           .
    13294           if v-object-handle <> v-diasize-resize-button
    13295           then do:
    13296             assign
    13297               v-object-handle :col = v-object-handle :col + p-change-value
    13298               no-error .
    13299             if error-status :error
    13300             or error-status :get-message(1) <> ""
    13301             then do:
    13302               undo move_block, retry move_block .
    13303             end.
    13304           end.
    13305         end.
    13306       end.
    13307       else do:
    13308         for each buf_temp-diasize-handle
    13309         on error undo move_block, retry move_block
    13310         :
    13311           assign
    13312             v-object-handle = buf_temp-diasize-handle.handle-value
    13313           .
    13314           if v-object-handle <> v-diasize-resize-button
    13315           then do:
    13316             assign
    13317               v-object-handle :col = v-object-handle :col + p-change-value
    13318               no-error .
    13319             if error-status :error
    13320             or error-status :get-message(1) <> ""
    13321             then do:
    13322               undo move_block, retry move_block .
    13323             end.
    13324           end.
    13325         end.
    13326         for each buf_temp-browse-handle
    13327           where buf_temp-browse-handle.browse-type = 'width':u
    13328         on error undo move_block, retry move_block
    13329         :
    13330           assign
    13331             buf_temp-browse-handle.browse-handle :width
    13332               = buf_temp-browse-handle.browse-handle :width + p-change-value
    13333             no-error .
    13334           if error-status :error
    13335           or error-status :get-message(1) <> ""
    13336           then do:
    13337             undo move_block, retry move_block .
    13338           end.
    13339         end.
    13340         assign
    13341           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
    13342           no-error .
    13343         if error-status :error
    13344         or error-status :get-message(1) <> ""
    13345         then do:
    13346           undo move_block, retry move_block.
    13347         end.
    13348         assign
    13349           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
    13350         no-error .
    13351         if error-status :error
    13352         or error-status :get-message(1) <> ""
    13353         then do:
    13354           undo move_block, retry move_block.
    13355         end.
    13356         if frame Dialog-Frame :scrollable = true
    13357         then do:
    13358           assign
    13359             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
    13360           no-error .
    13361           if error-status :error
    13362           or error-status :get-message(1) <> ""
    13363           then do:
    13364             undo move_block, retry move_block.
    13365           end.
    13366         end.
    13367       end.
    13368       if p-move-resize
    13369       then do:
    13370         run diasize_position-resize-button in this-procedure .
    13371       end.
    13372       if v-diasize-wndstore = true
    13373       then do:
    13374         if connected("ub") = true
    13375         then do:
    13376           define variable v-cntxt-db-num        as integer   no-undo .
    13377           define variable v-cntxt-userid        as character no-undo .
    13378           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    13379                                             , OUTPUT v-cntxt-userid
    13380                                             ) .
    13381           run gbl/wndsizew.p
    13382             (input  v-cntxt-db-num
    13383             ,input  v-cntxt-userid
    13384             ,input  v-diasize-proc-name
    13385             ,input  'width':u
    13386             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
    13387             ) .
    13388         end.
    13389       end.
    13390     end.
    13391     assign
    13392       v-diasize-change-size = false
    13393     .
    13394   end procedure.
    13395   procedure diasize_set-width :
    13396     define input  parameter p-new-width  as decimal   no-undo .
    13397     define input  parameter p-move-resize as logical   no-undo .
    13398     do
    13399     on error undo, return error return-value
    13400     :
    13401       run diasize_change-width in this-procedure
    13402         (input  (p-new-width - frame Dialog-Frame :width)
    13403         ,input  p-move-resize
    13404         ) .
    13405     end.
    13406   end procedure.
    13407   procedure diasize_position-resize-button :
    13408     do with frame Dialog-Frame
    13409     :
    13410       hide v-diasize-resize-button .
    13411       assign
    13412         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
    13413                     - 1
    13414                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
    13415         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
    13416                     - 1
    13417                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
    13418       .
    13419       view v-diasize-resize-button .
    13420     end.
    13421   end procedure.
    13422   on alt-right anywhere
    13423   do:
    13424     run diasize_change-width in this-procedure
    13425       (input 1
    13426       ,input true
    13427       ) .
    13428     return no-apply .
    13429   end.
    13430   on alt-left anywhere
    13431   do:
    13432     run diasize_change-width in this-procedure
    13433       (input -1
    13434       ,input true
    13435       ) .
    13436     return no-apply .
    13437   end.
    13438   on alt-down anywhere
    13439   do:
    13440     run diasize_change-height in this-procedure
    13441       (input 1
    13442       ,input true
    13443       ) .
    13444     return no-apply .
    13445   end.
    13446   on alt-up anywhere
    13447   do:
    13448     run diasize_change-height in this-procedure
    13449       (input -1
    13450       ,input true
    13451       ) .
    13452     return no-apply .
    13453   end.
    13454   on alt-enter of frame Dialog-Frame
    13455   do:
    13456     run diasize_maximize in this-procedure
    13457       (input  ?
    13458       ).
    13459     return no-apply .
    13460   end.
    13461   procedure diasize_end-move :
    13462     do
    13463     on error undo, return error return-value
    13464     :
    13465       define variable v-row-delta as decimal   no-undo .
    13466       define variable v-col-delta as decimal   no-undo .
    13467       define variable v-new-row as decimal   no-undo .
    13468       define variable v-new-col as decimal   no-undo .
    13469       assign
    13470         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    13471         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    13472       .
    13473       assign
    13474         v-row-delta = v-new-row - frame Dialog-Frame :height
    13475         v-col-delta = v-new-col - frame Dialog-Frame :width
    13476       .
    13477       run diasize_change-height in this-procedure
    13478         (input v-row-delta
    13479         ,input true
    13480         ) .
    13481       run diasize_change-width in this-procedure
    13482         (input v-col-delta
    13483         ,input true
    13484         ) .
    13485     end.
    13486   end procedure.
    13487   procedure diasize_maximize :
    13488     define input  parameter p-action as logical   no-undo .
    13489     do
    13490     on error undo, return error return-value
    13491     :
    13492       if p-action = ?
    13493       then do:
    13494         if v-diasize-need-maximize = true
    13495         then do:
    13496           assign
    13497             p-action = true
    13498           .
    13499         end.
    13500         else do:
    13501           assign
    13502             p-action = false
    13503           .
    13504         end.
    13505       end.
    13506       if p-action = true
    13507       then do:
    13508         run diasize_change-height in this-procedure
    13509           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    13510               - frame Dialog-Frame :height-chars
    13511           ,input true
    13512           ) .
    13513         run diasize_change-width in this-procedure
    13514           (input session :width-chars
    13515               - frame Dialog-Frame :width-chars
    13516           ,input true
    13517           ) .
    13518         assign
    13519           v-diasize-need-maximize = false
    13520         .
    13521       end.
    13522       else do:
    13523         run diasize_change-width in this-procedure
    13524           (input v-diasize-orig-frame-width
    13525               - frame Dialog-Frame :width-chars
    13526           ,input true
    13527           ) .
    13528         run diasize_change-height in this-procedure
    13529           (input v-diasize-orig-frame-height
    13530               - frame Dialog-Frame :height-chars
    13531           ,input true
    13532           ) .
    13533         assign
    13534           v-diasize-need-maximize = true
    13535         .
    13536       end.
    13537     end.
    13538   end procedure.
    13539   procedure diasize_restore-orig-size :
    13540     do
    13541     on error undo, return error return-value
    13542     :
    13543       assign
    13544         v-diasize-current-frame-width  = frame Dialog-Frame :width
    13545         v-diasize-current-frame-height = frame Dialog-Frame :height
    13546       .
    13547       run diasize_set-height in this-procedure
    13548         (input  v-diasize-orig-frame-height
    13549         ,input  true
    13550         ) .
    13551       run diasize_set-width in this-procedure
    13552         (input  v-diasize-orig-frame-width
    13553         ,input  true
    13554         ) .
    13555     end.
    13556   end procedure.
    13557   procedure diasize_restore-current-size :
    13558     do
    13559     on error undo, return error return-value
    13560     :
    13561       run diasize_set-height in this-procedure
    13562         (input  v-diasize-current-frame-height
    13563         ,input  true
    13564         ) .
    13565       run diasize_set-width in this-procedure
    13566         (input  v-diasize-current-frame-width
    13567         ,input  true
    13568         ) .
    13569     end.
    13570   end procedure.
    13571   procedure diasize_set-browse-handle :
    13572     define input  parameter p-browse-handle as handle   no-undo .
    13573     define buffer buf_temp-browse-handle for temp-browse-handle .
    13574     do
    13575     on error undo, return error return-value
    13576     :
    13577       assign
    13578         v-diasize-browse-handle = p-browse-handle
    13579       .
    13580       for each buf_temp-browse-handle
    13581       on error undo, return error return-value
    13582       :
    13583         delete buf_temp-browse-handle .
    13584       end.
    13585     end.
    13586   end procedure.
    13587   procedure diasize_add_browse :
    13588     define input  parameter p-browse-type   as character no-undo .
    13589     define input  parameter p-browse-handle as handle    no-undo .
    13590     define buffer buf_temp-browse-handle for temp-browse-handle .
    13591     do
    13592     on error undo, return error return-value
    13593     :
    13594       assign
    13595         v-diasize-browse-number = v-diasize-browse-number + 1
    13596       .
    13597       create buf_temp-browse-handle .
    13598       assign
    13599         buf_temp-browse-handle.browse-type   = p-browse-type
    13600         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    13601         buf_temp-browse-handle.browse-handle = p-browse-handle
    13602       .
    13603     end.
    13604   end procedure.
    13605   procedure diasize_init :
    13606     define variable v-default-value    as logical   no-undo .
    13607     define variable v-restore-saved    as logical   no-undo .
    13608     define variable v-resize-value-str as character no-undo .
    13609     do
    13610     on error undo, return error return-value
    13611     :
    13612       do with frame Dialog-Frame
    13613       :
    13614         assign
    13615           v-diasize-orig-frame-height = frame Dialog-Frame :height
    13616           v-diasize-orig-frame-width  = frame Dialog-Frame :width
    13617           v-diasize-browse-handle     = browse BROWSE-1 :handle
    13618         .
    13619         create button v-diasize-resize-button
    13620         assign
    13621           parent        = frame Dialog-Frame :first-child
    13622           label         = "s"
    13623           height-pixels = 16
    13624           width-pixels  = 16
    13625           visible       = true
    13626           sensitive     = true
    13627           movable       = true
    13628           triggers:
    13629             on end-move persistent run diasize_end-move in this-procedure .
    13630           end triggers.
    13631         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    13632         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    13633         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    13634         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    13635         assign
    13636           v-diasize-wndmax = false
    13637         .
    13638         if connected("ub") = true
    13639         then do:
    13640           define variable v-cntxt-db-num        as integer   no-undo .
    13641           define variable v-cntxt-userid        as character no-undo .
    13642           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    13643                                             , OUTPUT v-cntxt-userid
    13644                                             ) .
    13645           run gbl/wndpar_r.p
    13646             (input  v-cntxt-db-num
    13647             ,input  v-cntxt-userid
    13648             ,input  'wndmax':U
    13649             ,output v-diasize-wndmax
    13650             ,output v-default-value
    13651             ) .
    13652         end.
    13653         assign
    13654           v-diasize-wndstore = false
    13655         .
    13656         if connected("ub") = true
    13657         then do:
    13658           run gbl/wndpar_r.p
    13659             (input  v-cntxt-db-num
    13660             ,input  v-cntxt-userid
    13661             ,input  'wndstore':U
    13662             ,output v-diasize-wndstore
    13663             ,output v-default-value
    13664             ) .
    13665         end.
    13666         assign
    13667           v-diasize-proc-name = entry(1, program-name(2), '.')
    13668         .
    13669         if v-diasize-wndstore = true
    13670         then do:
    13671           assign
    13672             v-restore-saved = false
    13673           .
    13674           if connected("ub") = true
    13675           then do:
    13676             run gbl/wndsizer.p
    13677               (input  v-cntxt-db-num
    13678               ,input  v-cntxt-userid
    13679               ,input  v-diasize-proc-name
    13680               ,input  'height':u
    13681               ,output v-resize-value-str
    13682               ) .
    13683             if v-resize-value-str <> '':U
    13684             then do:
    13685               run diasize_change-height in this-procedure
    13686                 (input  integer(v-resize-value-str)
    13687                 ,input  true
    13688                 ) .
    13689               assign
    13690                 v-restore-saved = true
    13691               .
    13692             end.
    13693           end.
    13694           if connected("ub") = true
    13695           then do:
    13696             run gbl/wndsizer.p
    13697               (input  v-cntxt-db-num
    13698               ,input  v-cntxt-userid
    13699               ,input  v-diasize-proc-name
    13700               ,input  'width':u
    13701               ,output v-resize-value-str
    13702               ) .
    13703             if v-resize-value-str <> '':U
    13704             then do:
    13705               run diasize_change-width in this-procedure
    13706                 (input  integer(v-resize-value-str)
    13707                 ,input  true
    13708                 ) .
    13709               assign
    13710                 v-restore-saved = true
    13711               .
    13712             end.
    13713           end.
    13714           if v-restore-saved <> true
    13715           then do:
    13716             if v-diasize-wndmax = true
    13717             then do:
    13718               run diasize_maximize in this-procedure
    13719                 (input  true
    13720                 ) .
    13721             end.
    13722           end.
    13723         end.
    13724         else do:
    13725           if v-diasize-wndmax = true
    13726           then do:
    13727             run diasize_maximize in this-procedure
    13728               (input  true
    13729               ) .
    13730           end.
    13731         end.
    13732       end.
    13733     end.
    13734   end procedure.
    13735   procedure diasize_need-full-display :
    13736     define output parameter p-need-full-display as logical   no-undo .
    13737     do
    13738     on error undo, return error return-value
    13739     :
    13740       assign
    13741         p-need-full-display = v-diasize-need-full-display
    13742       .
    13743       assign
    13744         v-diasize-need-full-display = false
    13745       .
    13746     end.
    13747   end procedure.
    13748   procedure get-context :
    13749      define output parameter p-db-num as integer          no-undo.
    13750      define output parameter p-user-id as character        no-undo.
    13751      define variable v-login               as character    no-undo.
    13752      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    13753      define buffer buf_user-login  for ub.user-login .
    13754      do
    13755      on error undo, return error
    13756      :
    13757            FIND FIRST buf_sys-ctrl no-lock.
    13758            ASSIGN
    13759               v-login = USERID("ub")
    13760               p-db-num = buf_sys-ctrl.db-num
    13761            .
    13762            FIND FIRST buf_user-login
    13763                 WHERE buf_user-login.db-num = p-db-num
    13764                   AND buf_user-login.user-login = v-login
    13765                 no-lock
    13766                 no-error
    13767                 .
    13768            IF AVAILABLE buf_user-login
    13769            THEN DO:
    13770               assign
    13771                  p-user-id = buf_user-login.user-id
    13772               .
    13773            END.
    13774      end.
    13775   end procedure.
    13776       run diasize_init in this-procedure .
    13777   define variable vss-include-info112 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13778   on ' ' of FILL-IN_start-shift-date in frame Dialog-Frame
    13779   do:
    13780     if (can-query (self, "sensitive")
    13781        and
    13782        self :sensitive = true
    13783        )
    13784     or (can-query (self, "read-only")
    13785        and
    13786        self :read-only = false
    13787        )
    13788     then do:
    13789       assign
    13790         self :screen-value = ?
    13791       .
    13792     end.
    13793     return no-apply.
    13794   end.
