     9557       end.
     9558   end procedure.
     9559   def var vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9560   procedure check-use-bar-code :
     9561     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     9562     do
     9563     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info95, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     9564     on stop   undo, return error substitute( "&1. stop", vss-include-info95 )
     9565     on endkey undo, return error substitute( "&1. endkey", vss-include-info95 )
     9566     :
     9567       define buffer buf_bar-code for ub.bar-code .
     9568       find first buf_bar-code no-lock
     9569         where buf_bar-code.b-code     = p-b-code
     9570         no-error .
     9571       if not available buf_bar-code then do:
     9572         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info95, p-b-code ) .
     9573       end.
     9574       if buf_bar-code.stts = integer('99':U) then do:
     9575         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9576                                 + "Выполняется удаление бар-кода"
     9577                                 ,vss-include-info95
     9578                                 ,p-b-code
     9579                                 ,chr(10)
     9580                               ) .
     9581       end.
     9582       if buf_bar-code.stts = integer('79':U) then do:
     9583         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     9584                                 + "Бар-код выключен"
     9585                                 ,vss-include-info95
     9586                                 ,p-b-code
     9587                                 ,chr(10)
     9588                               ) .
     9589       end.
     9590       return .
     9591     end.
     9592   end procedure.
     9593   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9594   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     9595   procedure fltopend_fltopend :
     9596   define input parameter p-parent-handle as handle no-undo .
     9597   define input parameter p-qh as handle no-undo .
     9598   define input parameter p-flt-open-open-query  as character no-undo .
     9599   define input parameter p-where-cond as character no-undo .
     9600   define input parameter p-use-indFIRST-query-tail as character no-undo .
     9601   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     9602   define input parameter p-indexed-reposition as character no-undo .
     9603     do
     9604     on error undo, return error
     9605     :
     9606   define variable v-prepare-string as character no-undo .
     9607   define variable glog as logical no-undo .
     9608   assign
     9609   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     9610                      p-where-cond + chr(32)  +
     9611                      p-use-indFIRST-query-tail + chr(32) +
     9612                      p-use-ind-sort-clmn-by + chr(32) +
     9613                      p-indexed-reposition
     9614   .
     9615   assign
     9616   glog = p-qh:query-prepare(v-prepare-string) no-error .
     9617   if not glog
     9618   or error-status:error then do:
     9619     message error-status:get-message(1) view-as alert-box .
     9620     undo, return error .
     9621   end.
     9622   assign
     9623   glog = p-qh:query-open no-error .
     9624   if not glog
     9625   or error-status:error then do:
     9626     message error-status:get-message(1) view-as alert-box .
     9627     undo, return error .
     9628   end.
     9629     end.
     9630   end procedure.
     9631   procedure fltopend_fltfindd :
     9632   define input parameter p-parent-handle as handle no-undo .
     9633   define input parameter p-qh as handle no-undo .
     9634   define input parameter p-rowid as rowid no-undo .
     9635   define input parameter p-next as logical no-undo .
     9636   define input parameter p-lock as integer no-undo .
     9637   define input parameter p-bh as handle no-undo .
     9638   define input parameter p-where-cond as character no-undo .
     9639   define input parameter p-use-index-phrase as character no-undo .
     9640   define variable glog as logical no-undo .
     9641   define variable v-qh as handle no-undo .
     9642   define variable v-bh as handle no-undo .
     9643   define variable v-recid as recid no-undo .
     9644   define variable v-prepare-string as character no-undo .
     9645   do
     9646   on error undo, return error
     9647   on stop undo, return error
     9648   :
     9649     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     9650     create buffer v-bh for table p-bh buffer-name p-bh:name.
     9651     create query v-qh.
     9652     v-qh:set-buffers(v-bh).
     9653     v-prepare-string = substitute("for each &1 &2 &3"
     9654                                     ,v-bh:name
     9655                                     ,p-where-cond
     9656                                     ,p-use-index-phrase).
     9657     glog = v-qh:query-prepare(v-prepare-string) no-error.
     9658     if not glog then do:
     9659       delete object v-qh.
     9660       delete object v-bh.
     9661       undo, return error .
     9662     end.
     9663     glog = v-qh:query-open no-error .
     9664     if not glog then do:
     9665       delete object v-qh.
     9666       delete object v-bh.
     9667       undo, return error .
     9668     end.
     9669     if p-next then do:
     9670       v-qh:reposition-to-rowid(p-rowid) no-error .
     9671       glog = v-qh:get-next( p-lock) no-error .
     9672       glog = v-qh:get-next( p-lock) no-error .
     9673       if not glog or v-qh:query-off-end = yes then do:
     9674         glog = v-qh:get-first( p-lock) no-error .
     9675       end.
     9676     end.
     9677     else do:
     9678       glog = v-qh:get-first( p-lock) no-error .
     9679     end.
     9680     v-recid = v-bh:recid no-error .
     9681     delete object v-qh.
     9682     delete object v-bh.
     9683     return string(v-recid) .
     9684   end.
     9685   end procedure.
     9686   procedure fltopend_fltfindq :
     9687   define input parameter p-parent-handle as handle no-undo .
     9688   define input parameter p-qh as handle no-undo .
     9689   define input parameter p-next as logical no-undo .
     9690   define input parameter p-lock as integer no-undo .
     9691   define input parameter p-flt-open-open-query  as character no-undo .
     9692   define input parameter p-where-cond as character no-undo .
     9693   define input parameter p-use-indFIRST-query-tail as character no-undo .
     9694   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     9695   define input parameter p-indexed-reposition as character no-undo .
     9696   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     9697   define variable glog as logical no-undo .
     9698   define variable v-qh as handle no-undo .
     9699   define variable v-bh as handle no-undo extent 18.
     9700   define variable v-rowid as rowid no-undo extent 18.
     9701   define variable v-ii as integer no-undo .
     9702   define variable v-prepare-string as character no-undo .
     9703   do
     9704   on error undo, return error
     9705   on stop undo, return error
     9706   :
     9707     create query v-qh.
     9708     do v-ii = 1 to p-qh:num-buffers:
     9709       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     9710       assign
     9711       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     9712       no-error.
     9713       v-qh:add-buffer(v-bh[v-ii]).
     9714     end.
     9715     assign
     9716     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     9717                       p-where-cond + chr(32)  +
     9718                       p-use-indFIRST-query-tail + chr(32) +
     9719                       p-use-ind-sort-clmn-by + chr(32) +
     9720                       p-indexed-reposition
     9721     .
     9722     glog = v-qh:query-prepare( v-prepare-string) no-error .
     9723     if not glog then do:
     9724       delete object v-qh.
     9725       do v-ii = 1 to p-qh:num-buffers:
     9726         delete object v-bh[v-ii].
     9727       end.
     9728       undo, return error .
     9729     end.
     9730     glog = v-qh:query-open no-error .
     9731     if not glog then do:
     9732       delete object v-qh.
     9733       do v-ii = 1 to p-qh:num-buffers:
     9734         delete object v-bh[v-ii].
     9735       end.
     9736       undo, return error .
     9737     end.
     9738     if p-next then do:
     9739       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     9740       glog = v-qh:get-next( p-lock) no-error .
     9741       glog = v-qh:get-next( p-lock) no-error .
     9742       if not glog or v-qh:query-off-end = yes then do:
     9743         glog = v-qh:get-first( p-lock) no-error .
     9744       end.
     9745     end.
     9746     else do:
     9747       glog = v-qh:get-first( p-lock) no-error .
     9748     end.
     9749     do v-ii = 1 to p-qh:num-buffers:
     9750       assign
     9751       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     9752       no-error.
     9753     end.
     9754     delete object v-qh.
     9755     do v-ii = 1 to p-qh:num-buffers:
     9756       delete object v-bh[v-ii].
     9757     end.
     9758   end.
     9759   end procedure.
