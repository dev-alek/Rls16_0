     1098   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   define variable v-waitfram-action01         as character   no-undo .
     1100   define variable v-waitfram-action02         as character   no-undo .
     1101   define variable v-waitfram-action03         as character   no-undo .
     1102   define variable mWaitFramTextBeg            as character   no-undo.
     1103   define variable mWaitFramTextEnd            as character   no-undo.
     1104   define variable mWaitFramView               as logical     no-undo.
     1105   define variable mWaitProcEvent              as logical     no-undo init yes.
     1106   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1107   define variable mWaitFramStop               as logical     no-undo.
     1108   define variable mWaitFramStopUser           as logical     no-undo.
     1109   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1110   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1111   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1112   define button B-WaitFramStop auto-end-key
     1113        label "Стоп"
     1114        size 10 by 1 tooltip "Остоновить процесс".
     1115   define button B-viewProcInfo
     1116        label "Информация"
     1117        size 15 by 1 tooltip "Информация о процесс".
     1118   define frame waitfram
     1119     v-waitfram-action01 format "x(72)" no-label skip
     1120     v-waitfram-action02 format "x(72)" no-label skip
     1121     v-waitfram-action03 format "x(72)" no-label skip
     1122     B-viewProcInfo
     1123     B-WaitFramStop at row 4 col 30
     1124     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1125     .
     1126   define new global shared variable mBatchMode as logical no-undo init ?.
     1127   define variable mFramBachModHandle as handle no-undo.
     1128   mFramBachModHandle = frame waitfram:handle.
     1129   define variable mFameOldVis as logical no-undo.
     1130   define variable mVisCUrentVin as logical no-undo.
     1131   if session:batch-mode
     1132   then
     1133      mBatchMode = yes.
     1134   if mBatchMode = ? then do:
     1135     mVisCUrentVin = current-window:visible.
     1136     mFameOldVis = mFramBachModHandle:visible.
     1137     mFramBachModHandle:visible  = yes.
     1138     mBatchMode = mFramBachModHandle:visible ne yes.
     1139     mFramBachModHandle:visible = mFameOldVis.
     1140     current-window:visible = mVisCUrentVin.
     1141   end.
     1142    if  log-manager:logfile-name ne ?
     1143     then DO:
     1144         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1145         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1146         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1147     end.
     1148   on choose of B-WaitFramStop in frame waitfram
     1149   do:
     1150     mWaitFramStop = yes.
     1151     mWaitFramStopUser = yes.
     1152   end.
     1153   function waitfram-check-timeout returns logical():
     1154      define variable vtime as int64 no-undo.
     1155      if mWaitFramStopTimeOut
     1156      then
     1157         return yes.
     1158      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1159      if     mWaitFramTimeOut ne ?
     1160         and mWaitFramTimeOut ne 0
     1161         and mWaitFramTimeOut lt vtime
     1162      then do:
     1163         mWaitFramStopTimeOut = yes.
     1164      end.
     1165      return mWaitFramStopTimeOut.
     1166   end.
     1167   procedure waitfram-hide :
     1168     if not session:batch-mode
     1169     then do
     1170     on error undo, return error return-value
     1171     :
     1172       pause 0 before-hide .
     1173       if not mBatchMode then
     1174         hide frame waitfram .
     1175     if     not mWaitFramView
     1176        and mWaitProcEvent
     1177     then
     1178       process events .
     1179     end.
     1180   end procedure.
     1181   procedure waitfram-show :
     1182     define input  parameter p-message as character no-undo .
     1183     define variable v-left-margin as integer   no-undo .
     1184     if not session:batch-mode
     1185     then do
     1186     on error undo, return error return-value
     1187     :
     1188       if length(p-message) <= 70 then do:
     1189         assign
     1190           v-left-margin = integer((70 - length(p-message)) / 2)
     1191         .
     1192         assign
     1193           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1194         .
     1195         assign
     1196           v-waitfram-action01 = " "
     1197           v-waitfram-action02 = " "
     1198                                    + fill(" ", v-left-margin)
     1199                                    + p-message
     1200           v-waitfram-action03 = " "
     1201         .
     1202       end.
     1203       else do:
     1204         define variable vRindex1 as integer no-undo.
     1205         define variable vRindex2 as integer no-undo.
     1206         vRindex1 = r-index(p-message," ",70).
     1207         if vRindex1 = 0
     1208         then
     1209            vRindex1 = 70.
     1210         if length(p-message)  <= vRindex1 + 70 then do:
     1211           assign
     1212             v-waitfram-action01 = " "
     1213             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1214             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1215           .
     1216         end.
     1217         else do:
     1218           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1219           if vRindex2 <= vRindex1
     1220           then
     1221              vRindex2 = vRindex1 + 70.
     1222           assign
     1223             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1224             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1225             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1226           .
     1227         end.
     1228       end.
     1229       B-viewProcInfo:visible   in frame waitfram = no.
     1230       B-viewProcInfo:sensitive in frame waitfram = no.
     1231       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1232       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1233       if  (   mWaitFramView
     1234          or  mWaitProcEvent)
     1235          and not mBatchMode
     1236       then
     1237          display
     1238             v-waitfram-action01 skip
     1239             v-waitfram-action02 skip
     1240             v-waitfram-action03 skip
     1241          with frame waitfram .
     1242       if     mWaitFramView
     1243          then do:
     1244             if     mWaitFramInterval ne ?
     1245                and not mBatchMode
     1246             then
     1247                wait-for go of frame waitfram pause mWaitFramInterval.
     1248          end.
     1249          else
     1250             if     mWaitProcEvent
     1251                and not mBatchMode
     1252             then
     1253                process events .
     1254     end.
     1255   end procedure.
     1256      procedure waitfram-show-this:
     1257         define input  parameter iInterval as int64 no-undo.
     1258         define variable vtime as int64 no-undo.
     1259         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1260         mWaitFramInterval = iInterval.
     1261         run waitfram-show (substitute("&1&2 &3&4" ,
     1262                                       mWaitFramTextBeg ,
     1263                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1264                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1265                                       mWaitFramTextEnd
     1266                                      )
     1267                           ).
     1268      end.
     1269      procedure WaitFramRunPause:
     1270         define input  parameter iInterval as dec no-undo.
     1271         define variable vStart  as datetime-tz no-undo.
     1272         define variable vend    as datetime-tz no-undo.
     1273         define variable vint as int64 no-undo.
     1274         define variable vOk as logical no-undo.
     1275         vStart = now.
     1276         vend   = vStart.
     1277         publish "WaitFramPause" (iInterval,output vOk).
     1278         vend   =  now.
     1279         vint = vend - vStart.
     1280         vint = iInterval - vint / 1000.
     1281         if     not mWaitFramStop
     1282            and (   vint > 0
     1283                 or (    not vOk
     1284                     and iInterval eq ?
     1285                     )
     1286                 )
     1287         then
     1288            run waitfram-show-this (iInterval).
     1289         vend   =  now.
     1290         vint = vend - vStart.
     1291         vint = iInterval - vint / 1000.
     1292         if     not mWaitFramStop
     1293            and vint > 0
     1294         then do:
     1295            run gbl/pause.p (vint * 1000).
     1296         end.
     1297         if iInterval ne ?
     1298         then
     1299            publish "WaitFramStop".
     1300         waitfram-check-timeout().
     1301      end.
     1302      procedure WaitFramWaitFor:
     1303         define input  parameter iInterval as dec no-undo.
     1304         assign
     1305            mWaitFramStartProc   = now
     1306            mWaitFramStopUser    = no
     1307            mWaitFramStopTimeOut = no
     1308         .
     1309         block-wait:
     1310         do while not mWaitFramStop:
     1311            run WaitFramRunPause (iInterval).
     1312            if  waitfram-check-timeout()
     1313            then do:
     1314               leave block-wait.
     1315            end.
     1316         end.
     1317         run waitfram-hide.
     1318      end.
     1319   procedure waitfram-join :
     1320     define input  parameter p-line-1  as character no-undo .
     1321     define input  parameter p-line-2  as character no-undo .
     1322     define input  parameter p-line-3  as character no-undo .
     1323     define output parameter p-message as character no-undo .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       assign
     1328         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1329                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1330                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1331       .
     1332     end.
     1333   end procedure.
     1334   function waitfram-join-function returns character
     1335     (input p-line-1 as character
     1336     ,input p-line-2 as character
     1337     ,input p-line-3 as character
     1338     ).
     1339     define variable v-message as character no-undo .
     1340     run waitfram-join in this-procedure
     1341       (input  p-line-1
     1342       ,input  p-line-2
     1343       ,input  p-line-3
     1344       ,output v-message
     1345       ) .
     1346     return v-message .
     1347   end function .
     1348   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1349   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     1350   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     1351   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
     1352   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
     1353   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
     1354   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1355   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1356   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1357   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1358   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1359   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1360   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
     1361   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
     1362   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
     1363   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
     1364   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
     1365   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
     1366   function hvrdtax return logical (input parrecid as recid):
     1367   define variable varresult as logical no-undo.
     1368   run hvrdtax-proc (input parrecid, output varresult).
     1369   return varresult.
     1370   end function.
     1371   procedure hvrdtax-proc:
     1372   define input  parameter parrecid  as recid   no-undo.
     1373   define output parameter parresult as logical no-undo.
     1374   define buffer bf_goods for ub.goods.
     1375   define buffer bf_units for ub.units.
     1376   define buffer rt_tax   for ub.tax.
     1377   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1378   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1379   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1380   if available rt_tax and
     1381       can-find(first ub.tax-units No-LOCK WHERE
     1382                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1383                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1384                                                       else assign parresult = no.
     1385   end procedure.
     1386   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     1388                                           local-doc-num as char).
     1389   define buffer base-price        for ub.price-list.
     1390   define variable local-main-code like ub.bar-code.b-code no-undo.
     1391   define variable local-base-code like ub.bar-code.b-code no-undo.
     1392     run prc-base-code (input local-bc, output local-base-code).
     1393     find base-price no-lock where
     1394          base-price.doc-num = local-doc-num and
     1395          base-price.b-code  = local-base-code and
     1396          base-price.price-type = "" no-error.
     1397     if not available base-price then do:
     1398       run prc-main-code (input local-bc, output local-main-code).
     1399       find  base-price no-lock where
     1400             base-price.doc-num = local-doc-num and
     1401             base-price.b-code  = local-main-code and
     1402             base-price.price-type = "" no-error.
     1403     end.
     1404     if available base-price then
     1405       return (base-price.price-sale).
     1406     else
     1407       return (?).
     1408   END FUNCTION.
     1409   procedure prc-main-code:
     1410   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1411   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     1412   define buffer local-bar-code        for ub.bar-code.
     1413   define buffer local-goods           for ub.goods.
     1414   define buffer main-code             for ub.bar-code.
     1415   define buffer main-prt              for ub.gds-prt.
     1416     local-main-code = ?.
     1417     find local-bar-code no-lock where
     1418          local-bar-code.b-code = local-bc no-error.
     1419     if not available local-bar-code then
     1420       return.
     1421     find local-goods no-lock where
     1422          local-goods.gds-code = local-bar-code.gds-code.
     1423     find first  main-prt no-lock where
     1424                 main-prt.upper-code = local-goods.prt-root.
     1425     find  main-code no-lock where
     1426           main-code.gds-code  = local-bar-code.gds-code and
     1427           main-code.in-code   = "" and
     1428           main-code.part-code = "" and
     1429           main-code.unit-cli  = local-goods.unit-base and
     1430           main-code.node-code = main-prt.node-code.
     1431     local-main-code = main-code.b-code.
     1432   end procedure.
     1433   procedure prc-base-code:
     1434   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     1435   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     1436   define buffer local-bar-code for ub.bar-code.
     1437   define buffer local-goods    for ub.goods.
     1438   define buffer base-code      for ub.bar-code.
     1439     local-base-code = ?.
     1440     find local-bar-code no-lock where
     1441          local-bar-code.b-code = local-bc no-error.
     1442     if not available local-bar-code then
     1443       return.
     1444     find local-goods no-lock where
     1445          local-goods.gds-code = local-bar-code.gds-code.
     1446     find base-code no-lock where
     1447          base-code.gds-code  = local-bar-code.gds-code and
     1448          base-code.node-code = local-bar-code.node-code and
     1449          base-code.in-code   = local-bar-code.in-code and
     1450          base-code.part-code = local-bar-code.part-code and
     1451          base-code.unit-cli  = local-goods.unit-base.
     1452     local-base-code = base-code.b-code.
     1453   end procedure.
     1454   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1455   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1456   procedure prcreate-new-price-doc :
     1457   do
     1458   on error undo, return error return-value
     1459   :
     1460   define input  parameter p-curr-db-num  as integer   no-undo .
     1461   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1462   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1463   define input  parameter p-plt-id       as integer   no-undo .
     1464   define input  parameter p-plt-db-num   as integer   no-undo .
     1465   define input  parameter p-pdf-id       as integer   no-undo .
     1466   define input  parameter p-pdf-db-num   as integer   no-undo .
     1467   define output parameter p-price-doc-recid  as recid                no-undo.
     1468   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1469   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1470   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1471   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1472   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1473   define buffer buf_price-doc         for ub.price-doc.
     1474   find first buf_price-doc-forming no-lock where
     1475              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1476              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1477              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1478              buf_price-doc-forming.plt-id     = p-plt-id
     1479              no-error .
     1480   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1481      run create_new_price-doc-forming
     1482           ( input p-obj-type ,
     1483             input p-obj-code ,
     1484             output p-pdf-db-num ,
     1485             output p-pdf-id ,
     1486             output p-plt-db-num ,
     1487             output p-plt-id
     1488             ).
     1489       find first buf_price-doc-forming no-lock where
     1490                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1491                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1492                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1493                 buf_price-doc-forming.plt-id     = p-plt-id
     1494                 no-error .
     1495   end.
     1496       create buf_price-doc .
     1497       run doc-code in this-procedure
     1498       (input  "main",
     1499        input  p-obj-type  ,
     1500        input  p-obj-code  ,
     1501        input  ?,
     1502        output buf_price-doc.doc-num) no-error.
     1503       if error-status:error then do:
     1504         message vss-workfile vss-revision vss-description skip
     1505                error-status :get-message(1)
     1506               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1507         return error.
     1508       end.
     1509   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1511     (input  p-obj-type
     1512     ,input  p-obj-code
     1513     ,output v-host-code
     1514     )  .
     1515       v-obj-current-date  = today .
     1516       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1517           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1518           v-base-scale  =  buf_price-doc-forming.base-scale .
     1519       end.
     1520       else do:
     1521   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1523     (input  v-host-code
     1524     ,input  v-obj-current-date
     1525     ,output v-base-rate
     1526     ,output v-base-scale
     1527     )  .
     1528       end.
     1529      assign
     1530       buf_price-doc.base-rate      = v-base-rate
     1531       buf_price-doc.base-scale     = v-base-scale
     1532       buf_price-doc.cr-db-num      = p-curr-db-num
     1533       buf_price-doc.doc-date       = v-obj-current-date
     1534       buf_price-doc.fact-num       = 0
     1535       buf_price-doc.host-code      = v-host-code
     1536       buf_price-doc.is-corr        = false
     1537       buf_price-doc.is-del         = false
     1538       buf_price-doc.obj-code       = p-obj-code
     1539       buf_price-doc.obj-type       = p-obj-type
     1540       buf_price-doc.out-code       = ""
     1541       buf_price-doc.pdf-db         = p-pdf-db-num
     1542       buf_price-doc.pdf-id         = p-pdf-id
     1543       buf_price-doc.plt-db-num     = p-plt-db-num
     1544       buf_price-doc.plt-id         = p-plt-id
     1545       buf_price-doc.PS             = "@ "
     1546       buf_price-doc.rest-base      = 0
     1547       buf_price-doc.rest-last      = 0
     1548       buf_price-doc.rest-qnty      = 0
     1549       buf_price-doc.rest-sale      = 0
     1550       buf_price-doc.sale-base      = 0
     1551       buf_price-doc.status_        = 'новый':U
     1552       .
     1553       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1554       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1555       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1556       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1557       assign
     1558           p-price-doc-recid = recid ( buf_price-doc )
     1559       .
     1560   end.
     1561   end procedure.
     1562   procedure prcreate-new-price-list :
     1563   do
     1564   on error undo, return error return-value
     1565   :
     1566   define input parameter p-price-doc-recid   as recid                    no-undo.
     1567   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1568   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1569   define output parameter p-update           as logical                  no-undo.
     1570   define variable kk as integer no-undo .
     1571   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1572   define variable p-hostcode as int no-undo .
     1573   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1574   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1575   define buffer buf_price-doc        for ub.price-doc.
     1576   define buffer buf_price-list       for ub.price-list.
     1577   define buffer buf_bar-code         for ub.bar-code.
     1578   define buffer buf_goods            for ub.goods.
     1579   define buffer buf_root_gds-prt     for ub.gds-prt.
     1580   define buffer buf_gds-prt          for ub.gds-prt.
     1581   find first buf_price-doc no-lock
     1582        where recid( buf_price-doc ) = p-price-doc-recid
     1583   .
     1584   find first buf_goods no-lock
     1585        where buf_goods.gds-code = p-gds-code
     1586   .
     1587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1588     (input  p-gds-code
     1589     ,input  ?
     1590     ,output v-b-code
     1591     ) no-error .
     1592   if error-status :error
     1593   then do:
     1594       message
     1595           "Не найден основной бар-код"
     1596           skip "для товара "
     1597           skip string(buf_goods.artic)
     1598           skip buf_goods.gds-name
     1599       view-as alert-box
     1600       title "Ошибка при выполнении prcreate.i".
     1601       undo, return error .
     1602   end.
     1603   find first buf_bar-code no-lock
     1604        where buf_bar-code.b-code = v-b-code
     1605   no-error.
     1606   if error-status :error
     1607   then do:
     1608       message
     1609           "Не найдена запись bar-code"
     1610           skip "для товара "
     1611           skip string(buf_goods.artic)
     1612           skip buf_goods.gds-name
     1613           skip "С основным бар-кодом"
     1614           skip string(v-b-code)
     1615       view-as alert-box
     1616       title "Ошибка при выполнении prcreate.i".
     1617       undo, return error .
     1618   end.
     1619   find first buf_root_gds-prt no-lock
     1620        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1621   .
     1622   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1623     and buf_bar-code.in-code <> ""
     1624   then do:
     1625       message
     1626           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1627           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1628           view-as alert-box error.
     1629       undo, return error.
     1630   end.
     1631   find first buf_gds-prt no-lock
     1632        where buf_gds-prt.node-code = buf_bar-code.node-code
     1633   .
     1634   find first buf_price-list
     1635        where buf_price-list.doc-num = buf_price-doc.doc-num
     1636          and buf_price-list.b-code  = v-b-code
     1637   no-error.
     1638   if available buf_price-list
     1639   then do:
     1640       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1641          skip "  Цена:   " buf_price-list.price-sale
     1642          skip "Цена будет изменена"
     1643       view-as alert-box warning.
     1644       assign
     1645           p-update = yes
     1646       .
     1647   end.
     1648   else do:
     1649   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1651     (input  buf_price-doc.obj-type
     1652     ,input  buf_price-doc.obj-code
     1653     ,output p-hostcode
     1654     ) no-error .
     1655   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1657     (input  buf_goods.gds-code
     1658     ,input  '1':U
     1659     ,input  ?
     1660     ,input  p-hostcode
     1661     ,input  buf_price-doc.obj-type
     1662     ,input  buf_price-doc.obj-code
     1663     ,output local_vat-pc
     1664     ) no-error .
     1665   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1667     (input  buf_goods.gds-code
     1668     ,input  '2':U
     1669     ,input  ?
     1670     ,input  p-hostcode
     1671     ,input  buf_price-doc.obj-type
     1672     ,input  buf_price-doc.obj-code
     1673     ,output local_slt-pc
     1674     ) no-error .
     1675       kk = kk + 1.
     1676   define variable v-main-bar-code as integer   no-undo .
     1677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1678     (input  buf_goods.gds-code
     1679     ,input  ?
     1680     ,output v-main-bar-code
     1681     )  .
     1682       create buf_price-list.
     1683       assign
     1684           buf_price-list.line-num    = kk
     1685           buf_price-list.doc-num     = buf_price-doc.doc-num
     1686           buf_price-list.b-code      = buf_bar-code.b-code
     1687           buf_price-list.artic       = buf_goods.artic
     1688           buf_price-list.prod-type   = buf_goods.prod-type
     1689           buf_price-list.prod-code   = buf_goods.prod-code
     1690           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1691           buf_price-list.calc-method = 'Отсутствует':U
     1692           buf_price-list.obj-type    = buf_price-doc.obj-type
     1693           buf_price-list.obj-code    = buf_price-doc.obj-code
     1694           buf_price-list.price-sale  = p-price-sale
     1695           buf_price-list.vat-pc      = local_vat-pc
     1696           buf_price-list.slt-pc      = local_slt-pc
     1697           p-update                   = no
     1698       .
     1699   end.
     1700   end.
     1701   end procedure.
     1702   procedure create_new_price-doc-forming :
     1703   define input  parameter p-obj-type   as character no-undo .
     1704   define input  parameter p-obj-code   as integer   no-undo .
     1705   define output parameter p-pdf-db-num as integer   no-undo .
