    11356        l-loc-hour AT ROW 3 COL 62 COLON-ALIGNED
    11357        l-loc-min AT ROW 3 COL 65 COLON-ALIGNED NO-LABEL
    11358        R-mode-code AT ROW 3.75 COL 81.13 NO-LABEL
    11359        b-log-2 AT ROW 3.75 COL 93.38
    11360        b-log AT ROW 3.75 COL 93.63
    11361        b-type-price AT ROW 3.75 COL 97.63
    11362        FILL-IN_exch-rate AT ROW 3.83 COL 9.5 COLON-ALIGNED
    11363        FILL-IN_exch-scale AT ROW 3.83 COL 21.5 COLON-ALIGNED NO-LABEL
    11364        FILL-IN_have-end-period AT ROW 3.83 COL 33.63
    11365        FILL-IN_end-shift-date AT ROW 3.83 COL 45.5 COLON-ALIGNED NO-LABEL
    11366        FILL-IN_end-sys-date AT ROW 3.83 COL 45.5 COLON-ALIGNED NO-LABEL
    11367        FILL-IN_end-date AT ROW 3.83 COL 45.5 COLON-ALIGNED NO-LABEL
    11368        FILL-IN_end-shift-num AT ROW 3.83 COL 54.75 COLON-ALIGNED NO-LABEL
    11369        l-loc-hour-2 AT ROW 3.83 COL 62 COLON-ALIGNED
    11370        l-loc-min-2 AT ROW 3.83 COL 65 COLON-ALIGNED NO-LABEL
    11371        BROWSE-1 AT ROW 4.75 COL 1
    11372        BROWSE-2 AT ROW 12.46 COL 1.13
    11373        a-n-c AT ROW 17.33 COL 1 NO-LABEL
    11374        loc-name AT ROW 17.92 COL 11 COLON-ALIGNED
    11375        loc-code AT ROW 17.92 COL 11 COLON-ALIGNED
    11376        loc-art AT ROW 17.92 COL 11 COLON-ALIGNED
    11377        FILL-IN_name AT ROW 21 COL 61.5 NO-LABEL
    11378        v-curr-abbr-bv AT ROW 3.04 COL 27 COLON-ALIGNED NO-LABEL
    11379        v-curr-abbr-vd AT ROW 3.88 COL 27 COLON-ALIGNED NO-LABEL
    11380        p-calc-metod AT ROW 17.33 COL 77 COLON-ALIGNED NO-LABEL
    11381        p-old AT ROW 18 COL 39.13 COLON-ALIGNED
    11382        p-new AT ROW 18 COL 65 COLON-ALIGNED
    11383        p-pc-prev AT ROW 18 COL 89 COLON-ALIGNED
    11384        p-pr-doc-old AT ROW 18.75 COL 12.21 COLON-ALIGNED
    11385        p-op-pr-doc-old AT ROW 18.79 COL 40.5 COLON-ALIGNED
    11386        p-pc-pr-doc-old AT ROW 18.79 COL 66.63 COLON-ALIGNED
    11387        p-pc-op-pr-doc-old AT ROW 18.79 COL 89 COLON-ALIGNED
    11388        p-avrg AT ROW 19.42 COL 11 COLON-ALIGNED
    11389        p-op-avrg AT ROW 19.46 COL 40.5 COLON-ALIGNED
    11390       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
    11391            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
    11392   DEFINE FRAME Dialog-Frame
    11393        p-pc-avrg AT ROW 19.46 COL 66.63 COLON-ALIGNED
    11394        p-pc-op-avrg AT ROW 19.46 COL 89 COLON-ALIGNED
    11395        p-last AT ROW 20.13 COL 11 COLON-ALIGNED
    11396        p-op-last AT ROW 20.17 COL 40.5 COLON-ALIGNED
    11397        p-pc-last AT ROW 20.17 COL 66.63 COLON-ALIGNED
    11398        p-pc-op-last AT ROW 20.17 COL 89 COLON-ALIGNED
    11399        prev-price_doc-num AT ROW 20.92 COL 12 COLON-ALIGNED
    11400        v-free-qnty AT ROW 20.92 COL 40.5 COLON-ALIGNED
    11401        v-ost AT ROW 21.13 COL 44.25 COLON-ALIGNED WIDGET-ID 8
    11402        obj-in-code AT ROW 21.67 COL 11 COLON-ALIGNED
    11403        v-fact-qnty AT ROW 21.67 COL 40.5 COLON-ALIGNED
    11404        v-new-price-vat AT ROW 21.75 COL 44.25 COLON-ALIGNED WIDGET-ID 16
    11405        obj-in-date AT ROW 22.38 COL 11 COLON-ALIGNED
    11406        v-in-doc-qnty AT ROW 22.38 COL 40.5 COLON-ALIGNED
    11407        v-prod-price-prc AT ROW 22.42 COL 89 COLON-ALIGNED WIDGET-ID 14
    11408        v-prod-price AT ROW 22.5 COL 44.25 COLON-ALIGNED WIDGET-ID 12
    11409        v-prod-price-prc-2 AT ROW 23 COL 89 COLON-ALIGNED WIDGET-ID 20
    11410        v-priceprodwithvat-2 AT ROW 23.25 COL 44.25 COLON-ALIGNED WIDGET-ID 18
    11411        v-prod-price-prc-3 AT ROW 23.58 COL 89 COLON-ALIGNED WIDGET-ID 22
    11412        " Информация по строке" VIEW-AS TEXT
    11413             SIZE 22 BY .67 AT ROW 17.25 COL 40
    11414             FGCOLOR 4
    11415        SPACE(39.24) SKIP(6.36)
    11416       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
    11417            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
    11418            TITLE "Документ назначения цены".
    11419   ASSIGN
    11420          FRAME Dialog-Frame:SCROLLABLE       = FALSE
    11421          FRAME Dialog-Frame:HIDDEN           = TRUE.
    11422   ASSIGN
    11423          b-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-chg:HANDLE.
    11424   ASSIGN
    11425          B-import:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-import:HANDLE.
    11426   ASSIGN
    11427          common-price:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11428   ASSIGN
    11429          copy-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11430   ASSIGN
    11431          copy-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11432   ASSIGN
    11433          doc-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11434   ASSIGN
    11435          loc-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11436   ASSIGN
    11437          loc-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11438   ASSIGN
    11439          r-copy:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    11440   ON GO OF FRAME Dialog-Frame
    11441   DO:
    11442    if p-mode = 'ПРОСМОТР':U then return.
    11443     run save-proc in this-procedure no-error.
    11444     if error-status :error  then do:
    11445     message
    11446       "Ошибка сохранения ! "
    11447       error-status :get-message(1) skip
    11448       return-value skip
    11449       view-as alert-box error
    11450       .
    11451       return no-apply .
    11452     end.
    11453   END.
    11454   on end-error, stop of frame Dialog-Frame  do:
    11455     apply "choose" to b-exit in frame Dialog-Frame .
    11456     return no-apply.
    11457   end.
    11458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
    11459   DO:
    11460     p-next-prev = no.
    11461     APPLY "END-ERROR":U TO SELF.
    11462   END.
    11463   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
    11464   DO:
    11465     assign a-n-c .
    11466      case a-n-c :
    11467         when "art"
    11468         then do:
    11469            hide loc-name loc-code in frame Dialog-Frame .
    11470            display loc-art with frame Dialog-Frame .
    11471            apply "ENTRY":U to loc-art in frame Dialog-Frame.
    11472         end.
    11473         when "name"
    11474         then do:
    11475            hide loc-art loc-code in frame Dialog-Frame .
    11476            display loc-name with frame Dialog-Frame .
    11477            apply "ENTRY":U to loc-name in frame Dialog-Frame.
    11478         end.
    11479         when "code"
    11480         then do:
    11481            hide loc-name loc-art in frame Dialog-Frame .
    11482            display loc-code with frame Dialog-Frame .
    11483            apply "ENTRY":U to loc-code in frame Dialog-Frame.
    11484         end.
    11485      end case.
    11486   END.
    11487   ON CHOOSE OF b-add IN FRAME Dialog-Frame
    11488   DO:
    11489     empty temp-table tt-gds-list.
    11490     run proc-add-gds in this-procedure  ( input 1 , ?).
    11491     run OpenBr in this-procedure (yes, no, '':U).
    11492     find first buf_price-doc-forming-gds no-lock where
    11493                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    11494                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    11495                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    11496                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    11497                buf_price-doc-forming-gds.line-num   = v-line-num no-error .
    11498      reposition browse-1 to rowid rowid(buf_price-doc-forming-gds) no-error .
    11499      apply "value-changed" to browse-1 in frame Dialog-Frame.
    11500   END.
    11501   ON CHOOSE OF b-alt IN FRAME Dialog-Frame
    11502   DO:
    11503   if not available buf_price-doc-forming then return.
    11504   if not available buf_bar-code then return.
    11505     run str/mpl-alt.w
    11506     (  input         parParentProc
    11507       ,input         v-last-obj-type
    11508       ,input         v-last-obj-code
    11509       ,input         recid (buf_price-doc-forming)
    11510       ,input         p-mode
    11511       ,input         "code"
    11512       ,input         buf_bar-code.b-code
    11513       ,input-output  round-method
    11514       ,input-output  round-base
    11515       ,input-output  v-sec
    11516       ).
    11517     run OpenBr in this-procedure (yes, no, '':U).
    11518     reposition browse-1 to rowid rowid(buf_price-doc-forming-gds) no-error .
    11519     apply "value-changed" to browse-1 in frame Dialog-Frame.
    11520   END.
    11521   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
    11522   DO:
    11523     run OpenBr in this-procedure (yes, no, '':U).
    11524     apply "value-changed" to browse-1 in frame Dialog-Frame.
    11525   END.
    11526   ON CHOOSE OF b-cust IN FRAME Dialog-Frame
    11527   DO:
    11528     run str/vi-tt.w
    11529       ( table tt-table3 ,
    11530         v-bgr-name + chr(4) + "Код"  + chr(4) + "Покупатели"
    11531       ) .
    11532   END.
    11533   ON CHOOSE OF b-del IN FRAME Dialog-Frame
    11534   DO:
    11535   define variable varlog as logical   no-undo .
    11536   define variable line-rec as recid no-undo .
    11537   define variable rep-rec as recid no-undo .
    11538   define variable  varlns-cnt  as integer   no-undo .
    11539   define variable rr as recid no-undo .
    11540   if del-list = "" then do:
    11541     if not available buf_price-doc-forming-gds then do:
    11542       message "Неправильный выбор строки.".
    11543       return no-apply.
    11544     end.
    11545     varlog = no.
    11546     message "Удалить строку ДНЦ ?   Вы уверены ?"
    11547                   view-as alert-box question buttons OK-Cancel update varlog.
    11548     if NOT varlog then return no-apply.
    11549     line-rec = recid (buf_price-doc-forming-gds).
    11550     g#log = BROWSE-1:select-next-row () in frame Dialog-Frame no-error .
    11551     rep-rec =  recid (buf_price-doc-forming-gds) no-error .
    11552     del-list = "".
    11553     run del-doc-line1 ( line-rec ) .
    11554     run OpenBr in this-procedure (yes, no, '':U).
    11555     reposition BROWSE-1 to recid rep-rec no-error.
    11556     run vc-pdf in this-procedure .
    11557   end.
    11558   else do:
    11559     varlog = ?.
    11560     message "Удалить строки ДНЦ ?" skip (2)
    11561             "ДА - удалить все отмеченные строки" skip
    11562             "НЕТ - оставить только отмеченные строки и удалить все остальные"
    11563     view-as alert-box question buttons yes-no-cancel update varlog.
    11564     if varlog = ? then return no-apply.
    11565   end.
    11566   if varlog then do:
    11567     assign
    11568       varlns-cnt = 1.
    11569     do while varlns-cnt <= num-entries (del-list):
    11570       assign
    11571         line-rec   = integer (entry (varlns-cnt, del-list))
    11572         varlns-cnt = varlns-cnt + 1.
    11573         reposition BROWSE-1 to recid line-rec no-error.
    11574         g#log = BROWSE-1:select-next-row () in frame Dialog-Frame no-error .
    11575         rep-rec =  recid (buf_price-doc-forming-gds) no-error .
    11576         run del-doc-line1 ( line-rec ) .
    11577     end.
    11578   end.
    11579   else do:
    11580     for each buf_price-doc-forming-gds where
    11581                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    11582                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    11583                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    11584                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db :
    11585       if can-do (del-list, string (recid (buf_price-doc-forming-gds))) then next.
    11586          line-rec = recid (buf_price-doc-forming-gds) .
    11587           reposition BROWSE-1 to recid line-rec no-error.
    11588           g#log = BROWSE-1:select-next-row () in frame Dialog-Frame no-error .
    11589           rep-rec =  recid (buf_price-doc-forming-gds) no-error .
    11590           run del-doc-line1 ( line-rec ) .
    11591       end.
    11592    end.
    11593   del-list = "" .
    11594   run OpenBr in this-procedure (yes, no, '':U).
    11595   reposition BROWSE-1 to recid rep-rec no-error.
    11596   run vc-pdf in this-procedure .
    11597   END.
    11598   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
    11599   DO:
    11600     p-next-prev = NO.
    11601   END.
    11602   ON CHOOSE OF b-grp IN FRAME Dialog-Frame
    11603   DO:
    11604     run str/vi-tt.w
    11605       ( TABLE tt-table2 ,
    11606       "Список групп товаров по документу назначения цены" + chr(4) + " " + chr(4) + "Наименование группы"
    11607       ) .
    11608   END.
    11609   ON CHOOSE OF B-history IN FRAME Dialog-Frame
    11610   DO:
    11611   define variable vss-include-info103 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11612   if lookup(self :type
    11613            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11614            ) = 0
    11615   then do:
    11616     message
    11617       "$Workfile$"
    11618       "Указанному интерфейсному элементу фокус не может быть передан" skip
    11619       "Интерфейсный элемент" self :name  skip
    11620       "Тип" self :type  skip
    11621       "Процедура" this-procedure :file-name skip
    11622       view-as alert-box .
    11623   end.
    11624   else do:
    11625     apply "entry":u to self  .
    11626     if focus :handle <> self :handle  then do:
    11627       return no-apply .
    11628     end.
    11629   end.
    11630     if not available buf_price-doc-forming-gds then return .
    11631     run ref/cpr-form.w
    11632         ( parParentProc ,
    11633           buf_price-doc-forming-gds.plt-id     ,
    11634           buf_price-doc-forming-gds.plt-db-num ,
    11635           buf_price-doc-forming-gds.pdf-id     ,
    11636           buf_price-doc-forming-gds.pdf-db
    11637           ) .
    11638   END.
    11639   ON CHOOSE OF b-log IN FRAME Dialog-Frame
    11640   DO:
    11641   define variable row-i as integer   no-undo .
    11642   define variable g-log as logical   no-undo .
    11643     row-i = 0 .
    11644     reposition browse-1 to  row 1 no-error .
    11645     get first  browse-1 exclusive-lock .
    11646     do while available buf_price-doc-forming-gds :
    11647         assign
    11648           row-i = row-i + 1
    11649           buf_price-doc-forming-gds.line-num = row-i
    11650         .
    11651         get next  browse-1 exclusive-lock.
    11652     end.
    11653     release buf_price-doc-forming-gds.
    11654     run OpenBr in this-procedure (yes, no, '':U) .
