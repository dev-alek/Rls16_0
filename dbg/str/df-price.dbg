     2359   procedure grp-obj-notcorr-value :
     2360   do
     2361   on error undo, return error
     2362   :
     2363   define input parameter p-node-code             as integer      no-undo.
     2364   define input parameter p-obj-type              as character    no-undo.
     2365   define input parameter p-obj-code              as integer      no-undo.
     2366   define output parameter p-notcorr              as character    no-undo init ?.
     2367   define output parameter p-range-notcorr     as integer      no-undo.
     2368   define output parameter p-exists-notcorr    as logical      no-undo.
     2369   define variable v-host-code as integer      no-undo.
     2370   DEFINE VARIABLE v-found as logical no-undo .
     2371   DEFINE VARIABLE v-exists as logical no-undo .
     2372   DEFINE VARIABLE v-range as integer no-undo .
     2373   DEFINE VARIABLE jj as integer no-undo .
     2374   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2375   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2376   define buffer buf_gds-grp for ub.gds-grp.
     2377   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2378   find first buf_gds-grp no-lock where
     2379              buf_gds-grp.node-code = p-node-code no-error .
     2380   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2381     message
     2382       vss-workfile vss-revision vss-description
     2383       skip "Не удалось найти группу товаров с кодом" p-node-code
     2384       view-as alert-box error .
     2385     undo, return error .
     2386   end.
     2387   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2389     (input  p-obj-type
     2390     ,input  p-obj-code
     2391     ,output v-host-code
     2392     ) no-error .
     2393   if error-status :error
     2394   then do:
     2395       message
     2396         vss-workfile vss-revision vss-description
     2397         skip "Не удалось найти фирму объекта"
     2398         skip p-obj-type p-obj-code
     2399         skip return-value
     2400         skip trim(error-status :get-message(1))
     2401       view-as alert-box error.
     2402       undo, return error .
     2403   end.
     2404   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2405   do while v-found = no and jj < 2:
     2406     if v-range <> 3 then do:
     2407       find first buf_gds-grp-obj no-lock
     2408           where buf_gds-grp-obj.node-code = p-node-code
     2409             and buf_gds-grp-obj.host-code = v-host-code
     2410             and buf_gds-grp-obj.obj-type  = p-obj-type
     2411             and buf_gds-grp-obj.obj-code  = p-obj-code
     2412       no-error .
     2413     end.
     2414     if v-range = 3 or not available buf_gds-grp-obj
     2415     then do:
     2416        if v-range <> 2 then do:
     2417           find first buf_gds-grp-obj no-lock
     2418               where buf_gds-grp-obj.node-code = p-node-code
     2419                 and buf_gds-grp-obj.host-code = v-host-code
     2420                 and buf_gds-grp-obj.obj-type  = ""
     2421                 and buf_gds-grp-obj.obj-code  = 0
     2422           no-error .
     2423         end.
     2424         if v-range = 2 or not available buf_gds-grp-obj
     2425         then do:
     2426             if v-range <> 1 then do:
     2427               find first buf_gds-grp-obj no-lock
     2428                   where buf_gds-grp-obj.node-code = p-node-code
     2429                   and buf_gds-grp-obj.host-code = 0
     2430                   and buf_gds-grp-obj.obj-type  = ""
     2431                   and buf_gds-grp-obj.obj-code  = 0
     2432               no-error .
     2433             end.
     2434             if v-range = 1 or not available buf_gds-grp-obj
     2435             then do:
     2436                 assign
     2437                     v-exists = no
     2438                 .
     2439             end.
     2440             else do:
     2441                 assign
     2442                     v-exists = yes
     2443                     v-range = 1
     2444                 .
     2445             end.
     2446         end.
     2447         else do:
     2448             assign
     2449                 v-exists = yes
     2450                 v-range  = 2
     2451             .
     2452         end.
     2453     end.
     2454     else do:
     2455         assign
     2456             v-exists = yes
     2457             v-range  = 3
     2458         .
     2459     end.
     2460     if available buf_gds-grp-obj
     2461     then do:
     2462       find first buf_gds-grp-obj-attr no-lock
     2463         where buf_gds-grp-obj-attr.node-code   = p-node-code
     2464           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     2465           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     2466           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     2467           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     2468         no-error .
     2469       if available buf_gds-grp-obj-attr then do:
     2470         assign
     2471           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     2472         .
     2473       end.
     2474       else do:
     2475         assign
     2476           v-notcorr-value = ?
     2477         .
     2478       end.
     2479       assign
     2480       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     2481                           then yes
     2482                           else p-exists-notcorr)
     2483       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     2484                         then v-range
     2485                         else p-range-notcorr
     2486       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     2487                         then v-notcorr-value
     2488                         else p-notcorr
     2489       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2490       jj = jj + 1
     2491       .
     2492     end.
     2493     else do:
     2494       assign
     2495       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2496       jj = jj + 1
     2497       .
     2498     end.
     2499   end.
     2500   end.
     2501   end procedure.
     2502   define variable vss-include-info32 as character format "X(65)" no-undo
     2503   initial "@(#)$Workfile$ $Revision$".
     2504   procedure grplib-get-full-name :
     2505      define input parameter p-node-code  as integer      no-undo.
     2506      define output parameter p-full-name as character    no-undo.
     2507      do
     2508   on error undo, return error
     2509   :
     2510       define variable v-upper-code    as integer           no-undo.
     2511       define buffer buf_gds-grp       for ub.gds-grp.
     2512       define buffer buf_upper_gds-grp for ub.gds-grp.
     2513       find first buf_gds-grp no-lock
     2514            where buf_gds-grp.node-code = p-node-code
     2515       no-error.
     2516       if not available buf_gds-grp
     2517       then do:
     2518           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2519       end.
     2520       assign
     2521           p-full-name  = ""
     2522           v-upper-code = 1
     2523       .
     2524       do while buf_gds-grp.upper-code <> 0
     2525       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2526       :
     2527           assign
     2528               p-full-name  = buf_gds-grp.node-name
     2529                            + (if p-full-name <> "" then chr(47) else "")
     2530                            + p-full-name
     2531               v-upper-code = buf_gds-grp.upper-code
     2532           .
     2533           find first buf_gds-grp no-lock
     2534                where buf_gds-grp.node-code = v-upper-code
     2535           no-error.
     2536           if not available buf_gds-grp
     2537           then do:
     2538               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2539                                   + string( v-upper-code )
     2540                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2541           end.
     2542       end.
     2543       assign
     2544       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2545       .
     2546   end.
     2547   end .
     2548   procedure grplib-get-node-from-full-name :
     2549   define input parameter p-full-name as character no-undo .
     2550   define output parameter p-node-code as integer no-undo .
     2551   define variable v-ii as integer no-undo .
     2552   define variable v-upper-code as integer no-undo .
     2553   define variable v-root-code as integer no-undo .
     2554   define variable v-entry as character no-undo .
     2555   define buffer buf_gds-grp       for ub.gds-grp.
     2556   do
     2557   on error undo, return error
     2558   :
     2559     find first buf_gds-grp no-lock
     2560         where buf_gds-grp.upper-code = 0
     2561     no-error .
     2562     if not available buf_gds-grp
     2563     then do:
     2564         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2565     end.
     2566     else do:
     2567       assign
     2568       v-root-code = buf_gds-grp.node-code
     2569       .
     2570     end.
     2571     v-upper-code = v-root-code.
     2572     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2573       assign
     2574       v-entry = entry(v-ii, p-full-name, chr(47)).
     2575       if v-entry = '' then leave.
     2576       find first buf_gds-grp no-lock where
     2577                 buf_gds-grp.node-name = v-entry
     2578             and buf_gds-grp.upper-code = v-upper-code
     2579             no-error.
     2580       if not available buf_gds-grp then do:
     2581         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2582       end.
     2583       else do:
     2584         p-node-code = buf_gds-grp.node-code.
     2585         v-upper-code = buf_gds-grp.node-code.
     2586       end.
     2587     end.
     2588   end.
     2589   end .
     2590   procedure  chec-par :
     2591   define output parameter l-par as logical no-undo .
     2592   define input parameter l-host like ub.clients.obj-code no-undo .
     2593   define input parameter l-type like ub.clients.obj-type no-undo .
     2594   define input parameter l-code like ub.clients.obj-code no-undo .
     2595   define variable par-type          as character no-undo.
     2596   define variable v-value-character as character no-undo .
     2597   define variable v-value-date      as date      no-undo .
     2598   define variable v-value-decimal   as decimal   no-undo .
     2599   define variable v-value-integer   as integer   no-undo .
     2600   define variable v-value-logical   as logical   no-undo .
     2601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2602     (input  'alcohol'
     2603     ,input  l-host
     2604     ,input  l-type
     2605     ,input  l-code
     2606     ,input  ''
     2607     ,input  ''
     2608     ,input  ''
     2609     ,input  no
     2610     ,output par-alcohol
     2611     ,output par-type
     2612     ) no-error .
     2613    .
     2614   empty temp-table thbjattr_thbj-attr.
     2615   run adm/shattri.p (
     2616      input "get":U
     2617     ,input l-type
     2618     ,input l-code
     2619     ,input 'overval':U
     2620     ,input  ""
     2621     ,output v-value-character
     2622     ,output v-value-date
     2623     ,output v-value-decimal
     2624     ,output v-value-integer
     2625     ,output v-value-logical
     2626     ,output par-type
     2627     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2628     ) no-error .
     2629   for each thbjattr_thbj-attr :
     2630       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2631       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2632       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     2633       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     2634       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     2635       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     2636       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     2637       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     2638       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     2639       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     2640       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     2641       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2642       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2643       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     2644       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     2645       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     2646       if v-cntxt-db-num = 0 then do:
     2647         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2648         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2649       end.
     2650       else do:
     2651         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     2652         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     2653       end.
     2654   end.
     2655   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2656   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     2657     (input  ?
     2658     ,input  l-type
     2659     ,input  l-code
     2660     ,output par-gen-mrgn-ie
     2661     ,output par-gen-mrgn-iv
     2662     ,output par-gen-mrgn-im
     2663     ) no-error .
     2664      IF error-status :error THEN message
     2665        vss-workfile vss-revision vss-description skip
     2666        error-status :get-message(1) skip
     2667        return-value skip
     2668        "gbl/gtplmrgn.i"
