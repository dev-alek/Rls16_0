     1730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1731     (input  v-host-code
     1732     ,input  today
     1733     ,output v-base-rate
     1734     ,output v-base-scale
     1735     )  .
     1736   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1737   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1738     (input  ?
     1739     ,input  p-obj-type
     1740     ,input  p-obj-code
     1741     ,input  yes
     1742     ,output p-plt-id
     1743     ,output p-plt-db-num
     1744     )  .
     1745      create ub.price-doc-forming.
     1746      assign
     1747         ub.price-doc-forming.plt-id       = p-plt-id
     1748         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1749         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1750         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1751         ub.price-doc-forming.base-rate    = v-base-rate
     1752         ub.price-doc-forming.base-scale   = v-base-scale
     1753         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1754         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1755         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1756         ub.price-doc-forming.stts         = 0
     1757         ub.price-doc-forming.sys-date     = today
     1758         ub.price-doc-forming.sys-time     = time
     1759         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1760         ub.price-doc-forming.who          = v-cntxt-userid
     1761         ub.price-doc-forming.name         = "автосоздание"
     1762      .
     1763      assign
     1764       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1765       p-pdf-id      = ub.price-doc-forming.pdf-id
     1766       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1767       p-plt-id      = ub.price-doc-forming.plt-id
     1768      .
     1769     end.
     1770   end procedure.
     1771   procedure prcreate-new-price-doc-forming-gds :
     1772   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1773   define input  parameter p-obj-type   as character no-undo .
     1774   define input  parameter p-obj-code   as integer   no-undo .
     1775   define input  parameter par-pr-notls as character no-undo .
     1776   define input  parameter par-pr-altex as character no-undo .
     1777   define input  parameter par-pr-sclex as character no-undo .
     1778   define input  parameter p-line-num    as integer   no-undo .
     1779   define input  parameter p-gds-code    as integer   no-undo .
     1780   define input  parameter p-price-sale  as decimal   no-undo .
     1781   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1782   define buffer buf_goods for ub.goods  .
     1783   define buffer buf_bar-code for ub.bar-code  .
     1784   define buffer main_bar-code for ub.bar-code  .
     1785   define variable main-b-code as integer   no-undo .
     1786   define variable v-sec as integer   no-undo .
     1787     do
     1788     on error undo, return error return-value
     1789     :
     1790   define variable v-cur-dn as character no-undo .
     1791   define variable v-cur-pr as decimal   no-undo .
     1792   define variable v-cur-rt as decimal   no-undo .
     1793   define variable v-cur-ex as decimal   no-undo .
     1794   find first buf_price-doc-forming no-lock where
     1795              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1796              if error-status :error then return error .
     1797   find first buf_goods no-lock where
     1798              buf_goods.gds-code  = p-gds-code no-error .
     1799              if error-status :error then return error .
     1800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1801     (input  buf_goods.gds-code
     1802     ,input  ?
     1803     ,output main-b-code
     1804     ) no-error .
     1805   run check-use-bar-code (main-b-code) no-error .
     1806   if error-status :error then return .
     1807   run create-line-pdf-mpl-lib (
     1808        input buf_price-doc-forming.plt-db-num
     1809       ,input buf_price-doc-forming.plt-id
     1810       ,input buf_price-doc-forming.pdf-db
     1811       ,input buf_price-doc-forming.pdf-id
     1812       ,input p-line-num
     1813       ,input main-b-code
     1814       ,input buf_goods.artic
     1815       ,input buf_goods.prod-type
     1816       ,input buf_goods.prod-code
     1817       ,input ""
     1818       ,input 0
     1819       ,input p-price-sale
     1820       ,input ""
     1821       ,input 0
     1822      ,input-output v-sec ) no-error .
     1823      if error-status :error  then do:
     1824        message
     1825          vss-workfile vss-revision vss-description skip
     1826          error-status :get-message(1) skip
     1827          return-value skip
     1828          "2"
     1829          view-as alert-box error
     1830        .
     1831      end.
     1832   define buffer old_price-list for ub.price-list  .
     1833   if par-pr-notls = "yes" then do:
     1834   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1836     (input  p-obj-type
     1837     ,input  p-obj-code
     1838     ,input  main-b-code
     1839     ,input  0
     1840     ,input  0
     1841     ,output v-cur-dn
     1842     ,output v-cur-pr
     1843     ,output v-cur-rt
     1844     ,output v-cur-ex
     1845     )  .
     1846   end.
     1847   if par-pr-altex = "yes" and
     1848      par-pr-notls = "yes" then do:
     1849       if v-cur-dn <> "" then do:
     1850           for each old_price-list no-lock where
     1851                    old_price-list.doc-num = v-cur-dn and
     1852                    old_price-list.artic      = buf_goods.artic and
     1853                    old_price-list.prod-type  = buf_goods.prod-type and
     1854                    old_price-list.prod-code  = buf_goods.prod-code and
     1855                    old_price-list.main-price = no,
     1856                   first buf_bar-code no-lock where
     1857                         buf_bar-code.b-code   = old_price-list.b-code and
     1858                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1859                         :
     1860                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1861                          if error-status :error then next.
     1862                    run create-line-pdf-mpl-lib (
     1863                          input buf_price-doc-forming.plt-db-num
     1864                         ,input buf_price-doc-forming.plt-id
     1865                         ,input buf_price-doc-forming.pdf-db
     1866                         ,input buf_price-doc-forming.pdf-id
     1867                         ,input p-line-num
     1868                         ,input old_price-list.b-code
     1869                         ,input buf_goods.artic
     1870                         ,input buf_goods.prod-type
     1871                         ,input buf_goods.prod-code
     1872                         ,input ""
     1873                         ,input 0
     1874                         ,input old_price-list.price-sale
     1875                         ,input ""
     1876                         ,input 0
     1877                        ,input-output v-sec ) no-error .
     1878           end.
     1879       end.
     1880   end.
     1881   if par-pr-sclex = "yes" and
     1882      par-pr-notls = "yes" then do:
     1883       if v-cur-dn <> "" then do:
     1884           for each old_price-list no-lock where
     1885                    old_price-list.doc-num    = v-cur-dn and
     1886                    old_price-list.artic      = buf_goods.artic and
     1887                    old_price-list.prod-type  = buf_goods.prod-type and
     1888                    old_price-list.prod-code  = buf_goods.prod-code and
     1889                    old_price-list.main-price = no,
     1890                   first buf_bar-code no-lock where
     1891                         buf_bar-code.b-code   = old_price-list.b-code and
     1892                         buf_bar-code.in-code  = "" and
     1893                         buf_bar-code.unit-cli = buf_goods.unit-base
     1894                         :
     1895                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1896                          if error-status :error then next.
     1897                    run create-line-pdf-mpl-lib (
     1898                          input buf_price-doc-forming.plt-db-num
     1899                         ,input buf_price-doc-forming.plt-id
     1900                         ,input buf_price-doc-forming.pdf-db
     1901                         ,input buf_price-doc-forming.pdf-id
     1902                         ,input p-line-num
     1903                         ,input old_price-list.b-code
     1904                         ,input buf_goods.artic
     1905                         ,input buf_goods.prod-type
     1906                         ,input buf_goods.prod-code
     1907                         ,input ""
     1908                         ,input 0
     1909                         ,input old_price-list.price-sale
     1910                         ,input ""
     1911                         ,input 0
     1912                       ,input-output v-sec ) no-error .
     1913           end.
     1914       end.
     1915   end.
     1916   end.
     1917   end procedure.
     1918   procedure copy_new_price-doc-forming :
     1919   define input  parameter       p-recid      as recid no-undo .
     1920   define input-output parameter p-plt-db-num as integer   no-undo .
     1921   define input-output parameter p-plt-id     as integer   no-undo .
     1922   define output parameter       p-pdf-db-num as integer   no-undo .
     1923   define output parameter       p-pdf-id     as integer   no-undo .
     1924   define buffer buf_price-list-type        for ub.price-list-type  .
     1925   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1926   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1927   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1928   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1929   define variable v-host-code  as integer   no-undo .
     1930   define variable v-base-rate  as decimal   no-undo .
     1931   define variable v-base-scale as integer   no-undo .
     1932   define variable v-exch-rate  as decimal   no-undo .
     1933   define variable v-exch-scale as integer   no-undo .
     1934   define variable v-base as logical   no-undo .
     1935   define variable v-name as character no-undo .
     1936     do
     1937     on error undo, return error return-value
     1938     :
     1939   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1940   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1941     (output v-base
     1942     )  .
     1943   find first buf_price-list-type no-lock where
     1944              buf_price-list-type.plt-db-num = p-plt-db-num and
     1945              buf_price-list-type.plt-id     = p-plt-id no-error .
     1946   if error-status :error then return error "Не найден ТПЛ".
     1947   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1948   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1949       if available buf_price-doc-forming then do :
     1950           assign
     1951             v-base-rate  = buf_price-doc-forming.base-rate
     1952             v-base-scale = buf_price-doc-forming.base-scale
     1953             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1954           .
     1955       end.
     1956       else do:
     1957           assign
     1958             v-base-rate  = 1
     1959             v-base-scale = 1
     1960             v-name       = "Автосоздание"
     1961           .
     1962       end.
     1963      create ub.price-doc-forming.
     1964      assign
     1965         ub.price-doc-forming.plt-id       = p-plt-id
     1966         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1967         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1968         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1969         ub.price-doc-forming.base-rate    = v-base-rate
     1970         ub.price-doc-forming.base-scale   = v-base-scale
     1971         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1972         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1973         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1974         ub.price-doc-forming.stts         = 0
     1975         ub.price-doc-forming.sys-date     = today
     1976         ub.price-doc-forming.sys-time     = time
     1977         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1978         ub.price-doc-forming.who          = v-cntxt-userid
     1979         ub.price-doc-forming.name         = v-name
     1980      .
     1981      assign
     1982       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1983       p-pdf-id      = ub.price-doc-forming.pdf-id
     1984       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1985       p-plt-id      = ub.price-doc-forming.plt-id
     1986      .
     1987     end.
     1988     if not available buf_price-doc-forming then return .
     1989   for each buf_price-doc-forming-attr no-lock where
     1990            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1991            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1992            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1993            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1994       create ub.price-doc-forming-attr.
     1995       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1996       assign
     1997         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1998         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1999         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2000         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2001         .
     2002   end.
     2003   for each buf_price-doc-forming-gds no-lock where
     2004            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2005            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2006            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2007            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2008       create ub.price-doc-forming-gds.
     2009       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2010       assign
     2011         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2012         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2013         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2014         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2015       .
     2016   end.
     2017   for each buf_pd-forming-gds-attr no-lock where
     2018            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2019            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2020            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2021            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2022       create ub.price-doc-forming-gdsattr.
     2023       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2024       assign
     2025         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2026         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2027         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2028         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2029       .
     2030   end.
     2031   end procedure.
     2032   define variable par-pr-incpc as character no-undo.
     2033   define variable par-pr-rndmt as character no-undo.
     2034   define variable par-pr-rndbs as character no-undo.
     2035   define variable par-pr-clt-q as character no-undo.
     2036   define variable par-pr-dpl-q as character no-undo.
     2037   define variable par-pr-rdc-q as character no-undo.
     2038   define variable par-pr-abs-d as character no-undo.
     2039   define variable par-pr-altex as character no-undo.
     2040   define variable par-pr-parex as character no-undo.
     2041   define variable par-pr-sclex as character no-undo.
     2042   define variable par-pr-notls as character no-undo.
     2043   define variable par-pr-equ-dq as integer  no-undo.
     2044   define variable par-pr-discm as character no-undo .
     2045   define variable par-pr-dscnt as character no-undo .
     2046   define variable par-pr-print as character no-undo .
     2047   define variable par-pr-sigma as character no-undo .
     2048   define variable par-pr-goods as character no-undo.
     2049   define variable par-pr-nogds as character no-undo.
     2050   define variable par-alcohol  as character no-undo.
     2051   define variable par-gen-mrgn-ie as character no-undo .
     2052   define variable par-gen-mrgn-iv as character no-undo .
     2053   define variable par-gen-mrgn-im as character no-undo .
     2054   define variable par-pr-nakl-ie  as logical   no-undo .
     2055   define variable par-pr-nakl-iv  as logical   no-undo .
     2056   define variable par-pr-nakl-im  as logical   no-undo .
     2057   define variable par-pr-nogds-long as longchar no-undo .
     2058   define temp-table tmp-proof-price no-undo
     2059     field node-code like ub.gds-grp.node-code
     2060     field proof as decimal
     2061     field price as decimal
     2062   index pi node-code proof descending .
     2063   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2065   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2066   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2067   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2068   ASSIGN
     2069      v-S_CONTRACT                = "Contract":U
     2070      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2071      v-DELIM_CHR_3               = ","
     2072      .
     2073   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2074   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2075   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2076   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2077      INPUT iHost-Code    AS INTEGER,
     2078      INPUT iContract-Num AS INTEGER,
     2079      INPUT iGds-Code     AS INTEGER ):
     2080      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2081      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2082      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2083      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2084      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2085      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2086          INPUT  iHost-Code,
     2087          INPUT  iContract-Num,
     2088          OUTPUT iTmp-Extent3
     2089          ).
     2090      IF iTmp-Extent3[1] = 2 THEN DO:
     2091         ASSIGN
     2092            iTmp-Host-Code      = iTmp-Extent3[2]
     2093            iTmp-Contract-Num   = iTmp-Extent3[3]
     2094            .
     2095      END. ELSE DO:
     2096         ASSIGN
     2097            iTmp-Host-Code      = iHost-Code
     2098            iTmp-Contract-Num   = iContract-Num
     2099            .
     2100      END.
     2101      IF iGds-Code = ? THEN DO:
     2102         ASSIGN
     2103            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2104                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2105                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2106                           ).
     2107      END. ELSE DO:
     2108            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2109                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2110                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2111                              AND buf_Spec.Gds-Code      = iGds-Code
     2112                            ).
     2113      END.
     2114      RETURN (lRet).
     2115   END FUNCTION.
     2116   PROCEDURE MS-Contract-EXTENT-3:
     2117      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2118      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2119      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2120      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2121      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2122      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2123      FIND FIRST buf_Cont-2 WHERE
     2124                 buf_Cont-2.Host-Code      = i-Host-Code
     2125             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2126           NO-LOCK NO-ERROR.
     2127      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2128         RETURN.
     2129      END.
     2130      FOR FIRST buf_Ext-Classif WHERE
     2131                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2132           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2133                                               STRING(i-Contract-code)
     2134           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2135          NO-LOCK,
     2136          EACH buf_Cont WHERE
     2137               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2138           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2139          NO-LOCK:
     2140          ASSIGN
     2141             i-Ret[1] = 1
     2142             i-Ret[2] = buf_Cont.Host-code
     2143             i-Ret[3] = buf_Cont.Contract-code
     2144             .
     2145          LEAVE.
     2146      END.
     2147      IF i-Ret[1] <> 1 THEN DO:
     2148         FOR FIRST buf_Ext-Classif WHERE
     2149                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2150              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2151                                                  STRING(i-Contract-code)
     2152              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2153             NO-LOCK,
     2154             EACH buf_Cont WHERE
     2155                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2156              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2157             NO-LOCK:
     2158             ASSIGN
     2159                i-Ret[1] = 2
     2160                i-Ret[2] = buf_Cont.Host-code
     2161                i-Ret[3] = buf_Cont.Contract-code
     2162                .
     2163             LEAVE.
     2164         END.
     2165      END.
     2166      RETURN.
     2167   END PROCEDURE.
