     7253             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     7254            .
     7255        end.
     7256         if v-total-avrg-qnty > 0 then  do :
     7257         assign
