     7259             p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     7260             .
     7261         end.
     7262         if v-total-avrg-qnty <= 0 then do :
     7263             run last-incom-S in this-procedure
     7264                ( input p-artic
     7265                 ,input p-prod-type
     7266                 ,input p-prod-code
     7267                 ,output p-in-code
     7268                 ,output p-obj-type
