    16944      logical(buf-price-list-type.have-rs-turn-group) = true then do:
    16945     OPEN QUERY BROWSE-2 FOR EACH tt_price-doc-forming-gds-xxx OF                                  buf_price-doc-forming-gds NO-LOCK INDEXED-REPOSITION.
    16946   end.
    16947   END PROCEDURE.
    16948   PROCEDURE proc-add-gds :
    16949   define input  parameter p-mode   as integer   no-undo .
    16950   define input  parameter p-b-code as integer   no-undo .
    16951   define buffer buf_goods for ub.goods  .
    16952   define buffer buf_doc-line for ub.doc-line  .
    16953   define buffer buf_price-list for ub.price-list  .
