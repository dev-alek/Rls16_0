    16497   PROCEDURE new-price-sub :
    16498   define input  parameter p-plt-db-num as integer   no-undo .
    16499   define input  parameter p-plt-id     as integer   no-undo .
    16500   define input  parameter p-pdf-db     as integer   no-undo .
    16501   define input  parameter p-pdf-id     as integer   no-undo .
    16502   define input  parameter p-b-code     as integer   no-undo .
    16503   define input  parameter p-artic      as character no-undo .
    16504   define input  parameter p-prod-type  as character no-undo .
    16505   define input  parameter p-prod-code  as integer   no-undo .
    16506   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
    16507   for each buf2_price-doc-forming-gds no-lock where
    16508           buf2_price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
    16509           buf2_price-doc-forming-gds.plt-id      =  p-plt-id     and
    16510           buf2_price-doc-forming-gds.pdf-db      =  p-pdf-db     and
    16511           buf2_price-doc-forming-gds.pdf-id      =  p-pdf-id     and
    16512           buf2_price-doc-forming-gds.artic       =  p-artic      and
    16513           buf2_price-doc-forming-gds.prod-type   =  p-prod-type  and
    16514           buf2_price-doc-forming-gds.prod-code   =  p-prod-code  :
    16515     find first buf_price-doc-forming-gds no-lock  where
    16516                buf_price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
    16517                buf_price-doc-forming-gds.plt-id      =  p-plt-id     and
    16518                buf_price-doc-forming-gds.pdf-db      =  p-pdf-db     and
    16519                buf_price-doc-forming-gds.pdf-id      =  p-pdf-id     and
    16520                buf_price-doc-forming-gds.b-code      =  buf2_price-doc-forming-gds.b-code
    16521                no-error .
    16522       run make-xxx-line in this-procedure .
    16523   end.
    16524   END PROCEDURE.
    16525   PROCEDURE open1 :
    16526    OPEN QUERY browse-1 FOR EACH buf_price-doc-forming-gds OF buf_price-doc-forming NO-LOCK,
    16527                EACH buf_goods OF buf_price-doc-forming-gds NO-LOCK,
    16528                EACH buf_bar-code OF buf_price-doc-forming-gds no-lock
    16529                by buf_price-doc-forming-gds.artic
    16530                by buf_bar-code.node-code
    16531                by buf_price-doc-forming-gds.line-num.
    16532   run vc-pdf in this-procedure .
    16533   END PROCEDURE.
