    17138     run ver-pr-nogds ( input  buf1_goods.gds-code , input par-pr-nogds, output v-next , output v-errstr ) .
    17139     if not v-next then do:
    17140     case string(v-type-goods) :
    17141       when '8':U       then do:
    17142         v-errr = true .
    17143         v-errstr = "Запрет на  включение в переоценку товаров, услуг и топлива" .
    17144         leave .
    17145       end.
    17146       when '1':U    then do:
    17147       end.
    17148       when '2':U     then do:
    17149           if buf1_goods.gds-type = 'т':U  and is-petrolium = false  then do:
    17150              v-errr = true .
