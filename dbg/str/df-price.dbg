    16975           find first buf_goods no-lock where
    16976                      buf_goods.artic     = buf_doc-line.artic and
    16977                      buf_goods.prod-type = buf_doc-line.prod-type and
    16978                      buf_goods.prod-code = buf_doc-line.prod-code no-error .
    16979           find first buf_gds-obj no-lock where
    16980                      buf_gds-obj.obj-type = v-cntxt-obj-type and
    16981                      buf_gds-obj.obj-code = v-cntxt-obj-code and
    16982                      buf_gds-obj.gds-code = buf_goods.gds-code  and
    16983                      buf_gds-obj.fact-qnty <> 0
    16984                      no-error .
    16985           if not available buf_gds-obj then  next.
    16986           find first tt-gds-list where tt-gds-list.gds-code = buf_goods.gds-code no-error .
    16987           if not available tt-gds-list then do:
    16988               create tt-gds-list.
    16989               buffer-copy buf_goods to tt-gds-list .
    16990           end.
    16991       end.
    16992       end.
    16993   end.
    16994   else do:
    16995     if not ( calc-method = 'Накладная':U or
    16996              calc-method = 'Накл-безНДС':U or
    16997              calc-method = 'НсП+накл':U or
    16998              calc-method = 'Переоценка':U or
    16999              calc-method = 'ДокФормЦены':U
    17000              )
    17001     then do:
    17002       if p-mode = 1 then do:
