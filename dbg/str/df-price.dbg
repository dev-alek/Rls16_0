     7397   procedure calc-sigma :
     7398    do
     7399    on error undo, return error return-value
     7400    :
     7401   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7402   define input-output parameter new-price as decimal no-undo .
     7403   define input parameter l-host as integer no-undo .
     7404   define input parameter l-code as integer no-undo .
     7405   define input parameter l-type as character no-undo .
     7406   define output parameter p-ret as logical no-undo .
     7407   define variable conf-par     as character no-undo.
     7408   define variable par-type     as character no-undo.
     7409   define variable i-sigma as decimal no-undo .
     7410   define variable cur-pr like ub.price-list.price-sale no-undo.
     7411   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7412   define variable cur-ex like ub.price-list.excise     no-undo.
     7413   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7414   define variable old-price as decimal no-undo .
     7415   p-ret = true  .
     7416   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     7417   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7419     (input  l-type
     7420     ,input  l-code
     7421     ,input  l-bcode
     7422     ,input  0
     7423     ,input  0
     7424     ,output cur-dn
     7425     ,output cur-pr
     7426     ,output cur-rt
     7427     ,output cur-ex
     7428     )  .
     7429   old-price = cur-pr .
     7430   if old-price =  new-price then do:
     7431      p-ret = true .
     7432      return.
     7433   end.
     7434      i-sigma = decimal(par-pr-sigma) .
     7435      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     7436          p-ret = false .
     7437          new-price = old-price.
     7438          end.
     7439      else p-ret = true .
     7440   end.
     7441    end.
     7442   end procedure.
     7443   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7444   define variable var-pr-r-b as character no-undo .
     7445   define variable v-str2 as character no-undo .
     7446   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7448     (output var-pr-r-b
     7449     )  .
     7450   function f-base-code return integer ( p-b-code as integer ).
     7451     define variable main-b-code as integer   no-undo .
     7452     define buffer buf_bar-code for ub.bar-code  .
     7453     find first buf_bar-code no-lock where
     7454               buf_bar-code.b-code = p-b-code no-error .
     7455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7456     (input  buf_bar-code.gds-code
     7457     ,input  ?
     7458     ,output main-b-code
     7459     )  .
     7460     return (main-b-code).
     7461   end function.
     7462   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7463     define variable f-cost     as decimal no-undo .
     7464     define variable f-cost-pc  as decimal no-undo .
     7465     define variable v-qnty     as decimal no-undo .
     7466     define variable v-sum      as decimal no-undo .
     7467     define variable fact_price as decimal no-undo .
     7468     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     7469                               ub.goods.prod-type = local-price-list.prod-type and
     7470                               ub.goods.prod-code = local-price-list.prod-code no-lock
     7471                               no-error .
     7472     assign
     7473       v-sum  =  0
     7474       v-qnty =  0
     7475       .
     7476     for each x_obj-group :
     7477         find ub.gds-obj no-lock where
     7478             ub.gds-obj.gds-code = ub.goods.gds-code and
     7479             ub.gds-obj.obj-type = x_obj-group.obj-type and
     7480             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     7481         if  available ub.gds-obj then
     7482           if ub.goods.gds-type = 'т':U then
     7483             assign
     7484               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     7485               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     7486               .
     7487             else  v-sum = ?.
     7488         else v-sum = ?.
     7489     end.
     7490     f-cost = v-sum / v-qnty .
     7491     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7492     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     7493     return (f-cost-pc).
     7494   end function.
     7495   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     7496   define variable f-pr     as decimal no-undo .
     7497   define variable f-pr-pc  as decimal no-undo.
     7498   define variable v-qnty as decimal   no-undo .
     7499   define variable v-sum as decimal   no-undo .
     7500   define variable fact_price as decimal   no-undo .
     7501   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7502                          ub.goods.prod-type = local-price-list.prod-type and
     7503                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7504    assign
     7505      v-sum  =  0
     7506      v-qnty =  0
     7507      .
     7508   for each x_obj-group :
     7509   find ub.gds-obj no-lock where
     7510        ub.gds-obj.gds-code = ub.goods.gds-code and
     7511        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7512        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     7513   if  available ub.gds-obj then do:
     7514     if ub.goods.gds-type = 'т':U then
     7515       assign
     7516         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     7517         .
     7518       else f-pr = ?.
     7519   end.
     7520   else f-pr = ?.
     7521   end.
     7522     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     7523     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     7524     return (f-pr-pc).
     7525   end function.
     7526   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7527   define variable f-cost   as decimal no-undo .
     7528   find first  x_obj-group.
     7529   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7530                          ub.goods.prod-type = local-price-list.prod-type and
     7531                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7532   find ub.gds-obj no-lock where
     7533        ub.gds-obj.gds-code = ub.goods.gds-code  and
     7534        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7535        ub.gds-obj.obj-code = x_obj-group.obj-code
     7536        no-error.
     7537   if  available ub.gds-obj then
     7538     if ub.goods.gds-type = 'т':U then
     7539       assign
     7540         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     7541         .
     7542       else  f-cost = ?.
     7543   else f-cost = ?.
     7544     return ( f-cost ).
     7545   end function.
     7546   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     7547   define variable f-pr   as decimal no-undo .
     7548   find first x_obj-group .
     7549   find first ub.goods where ub.goods.artic = local-price-list.artic and
     7550                          ub.goods.prod-type = local-price-list.prod-type and
     7551                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     7552   find ub.gds-obj no-lock where
     7553        ub.gds-obj.gds-code = ub.goods.gds-code and
     7554        ub.gds-obj.obj-type = x_obj-group.obj-type and
     7555        ub.gds-obj.obj-code = x_obj-group.obj-code
     7556        no-error.
     7557   if  available ub.gds-obj then
     7558     if ub.goods.gds-type = 'т':U then
     7559       assign
     7560         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     7561         .
     7562       else  f-pr = ?.
     7563   else f-pr = ?.
     7564      return ( f-pr ).
     7565   end function.
     7566   procedure make-fact-order-lib3 :
     7567   define input  parameter p-recid as recid no-undo .
     7568   define output parameter p-fact-order-sys-from as decimal   no-undo .
     7569   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     7570   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7571   define buffer buf_price-list-type for ub.price-list-type  .
     7572   define variable v-shift-end-fact-order as decimal no-undo .
     7573   define variable v-day-end-fact-order   as decimal no-undo .
     7574   define variable v-fact-order           as decimal no-undo .
     7575     do
     7576     on error undo, return error return-value
     7577     :
     7578   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7579     if error-status :error then return error error-status :get-message(1) .
     7580   find first buf_price-list-type  no-lock where
     7581              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7582              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7583     if error-status :error then return error error-status :get-message(1) .
     7584    if buf_price-doc-forming.have-start-period = 1 then do:
     7585       case buf_price-list-type.work-date :
     7586         when int('1':U)  then
     7587           do :
     7588              run day-begin-fact-order
     7589                   ( buf_price-doc-forming.start-date ,
     7590                    output p-fact-order-sys-from ) no-error .
     7591                    if error-status :error then
     7592                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     7593                                               error-status :get-message(1) ,
     7594                                               return-value ).
     7595           end.
     7596         when int('2':U)   then
     7597           do :
     7598             run factord (
     7599                input   buf_price-doc-forming.start-shift-date
     7600               ,input   buf_price-doc-forming.sys-time
     7601               ,input   1
     7602               ,input   buf_price-doc-forming.start-shift-date
     7603               ,input   buf_price-doc-forming.start-shift-num
     7604               ,input   true
     7605               ,output  p-fact-order-sys-from
     7606               ,output  v-shift-end-fact-order
     7607               ,output  v-day-end-fact-order
     7608               ) no-error  .
     7609               if error-status :error then
     7610                    return error substitute ( "Ошибка из factord &1 &2" ,
     7611                                               error-status :get-message(1) ,
     7612                                               return-value ).
     7613           end.
     7614         when int('3':U)   then
     7615           do :
     7616             run factord (
     7617               input    buf_price-doc-forming.start-sys-date
     7618               ,input   buf_price-doc-forming.start-sys-time
     7619               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     7620               ,input   ?
     7621               ,input   ?
     7622               ,input   false
     7623               ,output  p-fact-order-sys-from
     7624               ,output  v-shift-end-fact-order
     7625               ,output  v-day-end-fact-order
     7626               ) no-error .
     7627               if error-status :error then
     7628                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7629                                               error-status :get-message(1) ,
     7630                                               return-value ).
     7631           end.
     7632       end case.
     7633     end.
     7634    if buf_price-doc-forming.have-end-period = 1 then do:
     7635       case buf_price-list-type.work-date :
     7636         when int('1':U)   then
     7637           do :
     7638              run factord-end-day
     7639                 ( buf_price-doc-forming.end-date ,
     7640                   output p-fact-order-sys-to ) no-error .
     7641                   if error-status :error then
     7642                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     7643                                               error-status :get-message(1) ,
     7644                                               return-value ).
     7645           end.
     7646         when int('2':U)   then
     7647           do :
     7648             run factord (
     7649                input   buf_price-doc-forming.end-shift-date
     7650               ,input   buf_price-doc-forming.sys-time
     7651               ,input   1
     7652               ,input   buf_price-doc-forming.end-shift-date
     7653               ,input   buf_price-doc-forming.end-shift-num
     7654               ,input   true
     7655               ,output  v-fact-order
     7656               ,output  p-fact-order-sys-to
     7657               ,output  v-day-end-fact-order
     7658               ) no-error .
     7659               if error-status :error then
     7660                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     7661                                           error-status :get-message(1) ,
     7662                                           return-value ).
     7663           end.
     7664         when int('3':U)   then
     7665           do :
     7666             run factord (
     7667                input   buf_price-doc-forming.end-sys-date
     7668               ,input   buf_price-doc-forming.end-sys-time
     7669               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     7670               ,input   ?
     7671               ,input   ?
     7672               ,input   false
     7673               ,output  p-fact-order-sys-to
     7674               ,output  v-shift-end-fact-order
     7675               ,output  v-day-end-fact-order
     7676               ) no-error .
     7677               if error-status :error then
     7678                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     7679                                           error-status :get-message(1) ,
     7680                                           return-value ).
     7681           end.
     7682       end case.
     7683     end.
     7684     end.
     7685   end procedure.
     7686   procedure ver-dfc-mpl-lib3 :
     7687   define input  parameter p-recid as recid no-undo .
     7688   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     7689   define buffer buf_price-list-type for ub.price-list-type  .
     7690   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7691   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     7692   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     7693   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     7694   define variable v-fact-order-sys-from   as decimal   no-undo .
     7695   define variable v-fact-order-sys-to     as decimal   no-undo .
     7696     do
     7697     on error undo, return error return-value
     7698    :
     7699   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     7700     if error-status :error then return error error-status :get-message(1) .
     7701   find first buf_price-list-type  no-lock where
     7702              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     7703              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     7704     if error-status :error then return error error-status :get-message(1) .
     7705     if buf_price-list-type.stts = integer('1':U) then do:
     7706        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     7707     end.
     7708     if buf_price-list-type.bgr-id > 0 then do:
     7709         find ub.buyer-group where
     7710               ub.buyer-group.stts       = 0  and
     7711               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     7712               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     7713               no-lock no-error .
     7714         if not available ub.buyer-group then
     7715         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     7716     end.
     7717     if buf_price-list-type.sgr-id > 0 then do:
     7718         find ub.sum-group where
     7719               ub.sum-group.stts       = 0  and
     7720               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     7721               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     7722               no-lock no-error .
     7723         if not available ub.sum-group then
     7724         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     7725     end.
     7726     if buf_price-list-type.qgr-id > 0 then do:
     7727         find ub.qnty-group where
     7728              ub.qnty-group.stts       = 0  and
     7729              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     7730              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     7731              no-lock no-error .
     7732         if not available ub.qnty-group then
     7733         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     7734     end.
     7735     if buf_price-list-type.tog-id > 0 then do:
     7736         find ub.turnover-group where
     7737              ub.turnover-group.stts       = 0  and
     7738              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     7739              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     7740             no-lock no-error .
     7741         if not available ub.turnover-group then
     7742         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     7743     end.
     7744     if buf_price-list-type.gop-id > 0 then do:
     7745         find ub.grp-obj-price where
     7746               ub.grp-obj-price.stts       = 0  and
     7747               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     7748               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     7749               no-lock no-error .
     7750         if not available ub.grp-obj-price then
     7751         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     7752     end.
     7753     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     7754         find ub.grp-obj-price where
     7755               ub.grp-obj-price.stts       = 0  and
     7756               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     7757               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     7758               no-lock no-error .
     7759         if not available ub.grp-obj-price then
     7760         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     7761     end.
     7762      if buf_price-doc-forming.have-start-period = integer(true) then do:
     7763         case buf_price-list-type.work-date :
     7764             when int('1':U)     then
     7765               do :
     7766                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     7767               end.
     7768             when int('2':U)   then
     7769               do :
     7770                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     7771                   if buf_price-doc-forming.start-shift-num  = ? or
     7772                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     7773               end.
     7774             when int('3':U)     then
     7775               do :
     7776                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     7777                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     7778               end.
     7779         end case.
     7780      end.
     7781      if buf_price-doc-forming.have-end-period = integer(true) then do:
     7782         case buf_price-list-type.work-date :
     7783             when int('1':U)     then
     7784               do :
     7785                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     7786               end.
     7787             when int('2':U)   then
     7788               do :
     7789                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     7790                   if buf_price-doc-forming.end-shift-num  = ? or
     7791                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     7792               end.
     7793             when int('3':U)     then
     7794               do :
     7795                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     7796                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     7797               end.
     7798         end case.
     7799      end.
     7800      if buf_price-doc-forming.have-start-period = integer(true) and
     7801         buf_price-doc-forming.have-end-period = integer(true) then do:
     7802         case buf_price-list-type.work-date :
     7803             when int('1':U)     then
     7804               do :
     7805                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     7806               end.
     7807             when int('2':U)   then
     7808               do :
     7809                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     7810                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     7811                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     7812                   end.
     7813               end.
     7814             when int('3':U)     then
     7815               do :
     7816                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     7817                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     7818                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     7819                   end.
     7820               end.
     7821         end case.
     7822      end.
     7823   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     7824   if buf_price-list-type.main = false then do:
     7825       run make-fact-order-lib3 in this-procedure
     7826           ( input  p-recid ,
     7827             output v-fact-order-sys-from ,
     7828             output v-fact-order-sys-to   ) .
     7829   end.
     7830   define variable old-price as decimal   no-undo .
     7831   define variable v-kol-rec as integer   no-undo .
     7832   define variable v-gds-null-price as character no-undo initial "" .
     7833   define variable v-type as character no-undo .
     7834   v-kol-rec = 0.
     7835   for each buf_price-doc-forming-gds no-lock where
     7836            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     7837            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     7838            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     7839            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     7840       find first ub.bar-code no-lock where
     7841                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     7842                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     7843       find first ub.goods no-lock where
     7844                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     7845                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     7846                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     7847                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7848       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     7849       run gds-attr-value in this-procedure (input ub.goods.gds-code
     7850                                            ,input 'null-price':U
     7851                                            ,output v-gds-null-price
     7852                                            ,output v-type ) no-error .
     7853       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     7854                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     7855       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     7856                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     7857       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     7858                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     7859       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7860       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     7861   old-price = ? .
     7862     for each buf_price-doc-forming-gds-qnty no-lock where
     7863              buf_price-doc-forming-gds-qnty.plt-id = buf_price-doc-forming-gds.plt-id and
     7864              buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7865              buf_price-doc-forming-gds-qnty.pdf-id = buf_price-doc-forming-gds.pdf-id and
     7866              buf_price-doc-forming-gds-qnty.pdf-db = buf_price-doc-forming-gds.pdf-db and
     7867              buf_price-doc-forming-gds-qnty.b-code = buf_price-doc-forming-gds.b-code
     7868              by buf_price-doc-forming-gds-qnty.ggr-qnty :
     7869              if old-price < buf_price-doc-forming-gds-qnty.price-sale-doc and old-price <> ? then do:
     7870                 return error substitute ("Цена по товару &1 &2 &3 по категории количество покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-qnty.ggr-qnty ,old-price , buf_price-doc-forming-gds-qnty.price-sale-doc) .
     7871              end.
     7872              old-price = buf_price-doc-forming-gds-qnty.price-sale-doc .
     7873     end.
     7874   old-price = ? .
     7875     for each buf_price-doc-sum no-lock where
     7876              buf_price-doc-sum.plt-id     = buf_price-doc-forming-gds.plt-id and
     7877              buf_price-doc-sum.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7878              buf_price-doc-sum.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     7879              buf_price-doc-sum.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     7880              buf_price-doc-sum.b-code     = buf_price-doc-forming-gds.b-code
     7881              by buf_price-doc-sum.ssg-summa
     7882              :
     7883              if old-price < buf_price-doc-sum.price-sale-doc and old-price <> ? then do:
     7884                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-sum.ssg-summa , old-price , buf_price-doc-sum.price-sale-doc) .
     7885              end.
     7886              old-price = buf_price-doc-sum.price-sale-doc .
     7887     end.
     7888   old-price = ? .
     7889     for each buf_price-doc-forming-gds-tnv no-lock where
     7890              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     7891              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     7892              buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     7893              buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     7894              buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code
     7895              by buf_price-doc-forming-gds-tnv.ttg-summa :
     7896              if old-price < buf_price-doc-forming-gds-tnv.price-sale-doc and old-price <> ? then do:
     7897                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма оборота покупателя >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-tnv.ttg-summa ,old-price , buf_price-doc-forming-gds-tnv.price-sale-doc) .
     7898              end.
     7899              old-price = buf_price-doc-forming-gds-tnv.price-sale-doc .
     7900     end.
     7901     define buffer old_price-doc-forming for ub.price-doc-forming  .
     7902     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     7903     define buffer old_price-all for ub.price-all.
     7904     if buf_price-list-type.main = false then do:
     7905        for each old_price-doc-forming no-lock where
     7906                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     7907                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     7908                 old_price-doc-forming.stts       = integer('3':U)  ,
     7909                 each old_price-doc-forming-gds no-lock where
     7910                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     7911                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     7912                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     7913                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     7914                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     7915                for each old_price-all no-lock where
     7916                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     7917                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     7918                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     7919                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     7920                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     7921                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     7922                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     7923                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     7924                                                  buf_price-doc-forming-gds.artic ,
     7925                                                  buf_price-doc-forming-gds.prod-type ,
     7926                                                  buf_price-doc-forming-gds.prod-code,
     7927                                                  old_price-all.pdf-id ,
     7928                                                  old_price-all.pdf-db ,
     7929                                                  old_price-doc-forming-gds.price-sale-doc ,
     7930                                                  old_price-all.plt-priority
     7931                                                  ) .
     7932                end.
     7933        end.
     7934        end.
     7935       assign v-kol-rec = v-kol-rec + 1 .
     7936   end.
     7937     run ver-pr-equ-qS in this-procedure
     7938       ( input buf_price-doc-forming.plt-id ,
     7939         input buf_price-doc-forming.plt-db-num,
     7940         input buf_price-doc-forming.pdf-id ,
     7941         input buf_price-doc-forming.pdf-db
     7942         ) no-error .
     7943     if error-status :error then  return error  "Ошибка при удалении строки ДНЦ "   .
     7944   if v-kol-rec = 0 then return error "no-records":U.
     7945   end.
     7946   end procedure.
     7947   procedure ver-pr-equ-qS :
     7948   define input parameter  p-plt-id      as integer   no-undo .
     7949   define input parameter  p-plt-db-num  as integer   no-undo .
     7950   define input parameter  p-pdf-id      as integer   no-undo .
     7951   define input parameter  p-pdf-db      as integer   no-undo .
     7952     do
     7953     on error undo, return error return-value
     7954     :
     7955   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     7956   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     7957   define buffer pp_price-list   for ub.price-doc-forming-gds .
     7958   define buffer main_price-list for ub.price-doc-forming-gds .
     7959   define buffer alt_price-list  for ub.price-doc-forming-gds .
     7960   define buffer buf1-bar-code   for ub.bar-code .
     7961   define buffer buf2-bar-code   for ub.bar-code .
     7962   define buffer buf_goods for ub.goods  .
     7963   define buffer buf2_goods for ub.goods  .
     7964   define variable v-num as integer init 0 no-undo .
     7965   define variable bbb   as logical no-undo .
     7966   define variable l-price-sale like ub.price-list.price-sale no-undo .
     7967   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     7968   define variable l-excise     like ub.price-list.excise     no-undo .
     7969   define variable l-ok          as logical no-undo .
     7970   define variable check-par     as logical no-undo .
     7971   define variable main-b-code   as integer no-undo .
     7972   define variable par-pr-equ-dq as integer no-undo .
     7973   define variable v-price-sale  as decimal no-undo .
     7974   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7975   empty temp-table thbjattr_thbj-attr.
     7976   run adm/shattri.p (
     7977      input "get":U
     7978     ,input v-cntxt-obj-type
     7979     ,input v-cntxt-obj-code
     7980     ,input 'overval':U
     7981     ,input  ""
     7982     ,output v-value-character
     7983     ,output v-value-date
     7984     ,output v-value-decimal
     7985     ,output v-value-integer
     7986     ,output v-value-logical
     7987     ,output par-type
     7988     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7989     ) no-error .
     7990   for each thbjattr_thbj-attr :
     7991       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     7992   end.
     7993   if par-pr-equ-dq = 1 then return .
     7994   for each pdf_price-list exclusive-lock where
     7995            pdf_price-list.plt-id     = p-plt-id     and
     7996            pdf_price-list.plt-db-num = p-plt-db-num and
     7997            pdf_price-list.pdf-id     = p-pdf-id     and
     7998            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     7999           :
     8000       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     8001       check-par = false .
     8002      find first x_obj-group no-error .
     8003   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8004   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8005     (input  x_obj-group.obj-type
     8006     ,input  x_obj-group.obj-code
     8007     ,input  pdf_price-list.b-code
     8008     ,input  0
     8009     ,input  0
     8010     ,output l-doc-num2
     8011     ,output l-price-sale
     8012     ,output l-road-tax
     8013     ,output l-excise
     8014     ) no-error .
     8015       v-price-sale = l-price-sale .
     8016      for each x_obj-group :
     8017   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8019     (input  x_obj-group.obj-type
     8020     ,input  x_obj-group.obj-code
     8021     ,input  pdf_price-list.b-code
     8022     ,input  0
     8023     ,input  0
     8024     ,output l-doc-num2
     8025     ,output l-price-sale
     8026     ,output l-road-tax
     8027     ,output l-excise
     8028     ) no-error .
     8029       if v-price-sale <> l-price-sale  then do :
     8030         v-price-sale = l-price-sale.
     8031         leave .
     8032       end.
     8033      end.
     8034      find first x_obj-group no-error .
     8035   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8037     (input  x_obj-group.obj-type
     8038     ,input  x_obj-group.obj-code
     8039     ,input  pdf_price-list.b-code
     8040     ,input  0
     8041     ,input  0
     8042     ,output l-doc-num2
     8043     ,output l-price-sale
     8044     ,output l-road-tax
     8045     ,output l-excise
     8046     ) no-error .
     8047         if l-doc-num2 <> ? then do :
     8048           if l-price-sale = pdf_price-list.price-sale-doc
     8049           and v-price-sale = pdf_price-list.price-sale-doc
     8050           then do:
     8051                find first buf_goods no-lock where
     8052                           buf_goods.artic     =  pdf_price-list.artic and
     8053                           buf_goods.prod-type =  pdf_price-list.prod-type and
     8054                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     8055               check-par = false .
     8056                  for each pp_price-list no-lock where
     8057                           pp_price-list.plt-id     = p-plt-id     and
     8058                           pp_price-list.plt-db-num = p-plt-db-num and
     8059                           pp_price-list.pdf-id     = p-pdf-id     and
     8060                           pp_price-list.pdf-db     = p-pdf-db     and
     8061                           pp_price-list.artic      = pdf_price-list.artic and
     8062                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     8063                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     8064                        first buf1-bar-code no-lock where
     8065                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8066                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     8067                       :
     8068                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     8069                       check-par = true  .
     8070                       leave.
     8071                   end.
     8072                  for each pp_price-list no-lock where
     8073                           pp_price-list.plt-id     = p-plt-id     and
     8074                           pp_price-list.plt-db-num = p-plt-db-num and
     8075                           pp_price-list.pdf-id     = p-pdf-id     and
     8076                           pp_price-list.pdf-db     = p-pdf-db     and
     8077                           pp_price-list.artic      = pdf_price-list.artic and
     8078                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     8079                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     8080                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     8081                        first buf1-bar-code no-lock where
     8082                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8083                             buf1-bar-code.unit-cli = buf_goods.unit-base
     8084                       :
     8085                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     8086                       check-par = true  .
     8087                       leave.
     8088                   end.
     8089               if check-par = true then next.
     8090               if par-pr-equ-dq = 2 then do:
     8091                     if  ( v-num <= 2  and check-par = false ) then
     8092                         run gbl/d-askw.w
     8093                           (input "Удалить строку?"
     8094                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     8095                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     8096                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     8097                                       + " Бар-код " + string(pdf_price-list.b-code)
     8098                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     8099                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     8100                                       + " Удалить строку? "
     8101                           ,input "|^"
     8102                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     8103                           ,input "Удалить строку|"
     8104                               + "Не удалять строку|"
     8105                               + "Удалять у всех товаров, цена на которые не изменилась|"
     8106                               + "Не удалять у всех товаров, цена на которые не изменилась"
     8107                           ,input 1
     8108                           ,input 2
     8109                           ,output v-num
     8110                           ).
     8111                 end.
     8112                 else do:
     8113                   v-num = 3 .
     8114                 end.
     8115                   if v-num = 1 then do:
     8116                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     8117                                     if error-status :error then do:
     8118                                             message  vss-workfile vss-revision vss-description skip
     8119                                             "Ошибка при удаление строки ДНЦ"
     8120                                             pdf_price-list.b-code skip
     8121                                             error-status :get-message(1) .
     8122                                             return error.
     8123                                     end.
     8124                   end.
     8125                   if v-num = 3  then do:
     8126                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     8127                   end.
     8128           end.
     8129          end.
     8130   end.
     8131     for each main_price-list no-lock where
     8132                 main_price-list.plt-id      = p-plt-id and
     8133                 main_price-list.plt-db-num  = p-plt-db-num and
     8134                 main_price-list.pdf-id      = p-pdf-id and
     8135                 main_price-list.pdf-db      = p-pdf-db
     8136                 :
     8137                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     8138                   for each pp_price-list no-lock where
     8139                             pp_price-list.plt-id       = main_price-list.plt-id     and
     8140                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     8141                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     8142                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     8143                             pp_price-list.artic        = main_price-list.artic      and
     8144                             pp_price-list.prod-type    = main_price-list.prod-type  and
     8145                             pp_price-list.prod-code    = main_price-list.prod-code  and
     8146                             pp_price-list.b-code      <> main_price-list.b-code     and
     8147                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     8148                       first buf_goods no-lock where
     8149                             buf_goods.artic     =  pp_price-list.artic and
     8150                             buf_goods.prod-type =  pp_price-list.prod-type and
     8151                             buf_goods.prod-code =  pp_price-list.prod-code ,
     8152                       first buf1-bar-code no-lock where
     8153                             buf1-bar-code.b-code   = pp_price-list.b-code and
     8154                             buf1-bar-code.unit-cli = buf_goods.unit-base
     8155                             :
     8156                             bbb = true .
     8157                             for each alt_price-list no-lock where
     8158                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     8159                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     8160                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     8161                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     8162                                     alt_price-list.artic      = pp_price-list.artic      and
     8163                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     8164                                     alt_price-list.b-code     <> main_price-list.b-code  and
     8165                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     8166                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     8167                               first buf2_goods no-lock where
     8168                                     buf2_goods.artic     =  pp_price-list.artic     and
     8169                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     8170                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     8171                               first buf2-bar-code no-lock where
     8172                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     8173                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     8174                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     8175                                   :
     8176                                   bbb = false.
     8177                                   leave.
     8178                             end.
     8179                             if bbb = true  then do:
     8180                                 run del-doc-line ( input recid (pp_price-list)) no-error  .
     8181                                 if error-status :error then do:
     8182                                     message  vss-workfile vss-revision vss-description skip
     8183                                     " Нельзя удалить " pp_price-list.b-code skip
     8184                                     error-status :get-message(1) .
     8185                                 end.
     8186                             end.
     8187                   end.
     8188     end.
     8189   end.
     8190   end procedure.
