     9782                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
     9783                no-error .
     9784         if available buf_price-doc-forming-attr then do:
     9785            delete buf_price-doc-forming-attr .
     9786         end.
     9787     end.
     9788   end procedure.
