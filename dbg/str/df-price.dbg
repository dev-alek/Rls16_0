    17011                   output ref-list,
    17012                   output table tt-gds-list,
    17013                   input false
    17014                   ) no-error.
    17015           if error-status :error then message
    17016             vss-workfile vss-revision vss-description skip
    17017             error-status :get-message(1) skip
    17018             return-value skip
    17019             ""
    17020             view-as alert-box error
    17021           .
    17022       end.
    17023     end.
    17024     else do:
    17025         if p-mode <> 2 then do:
    17026         case calc-method :
    17027           when 'ДокФормЦены':U then do:
    17028           find first bufo_price-doc-forming no-lock where
    17029                      bufo_price-doc-forming.pdf-id = integer(entry( 1 , doc-code , "|" )) and
    17030                      bufo_price-doc-forming.pdf-db = integer(entry( 2 , doc-code , "|" )) no-error .
    17031             if available bufo_price-doc-forming then do:
    17032             for each bufo_price-doc-forming-gds no-lock where
    17033                      bufo_price-doc-forming-gds.pdf-id = bufo_price-doc-forming.pdf-id and
    17034                      bufo_price-doc-forming-gds.pdf-db = bufo_price-doc-forming.pdf-db and
    17035                      bufo_price-doc-forming-gds.plt-id = bufo_price-doc-forming.plt-id and
    17036                      bufo_price-doc-forming-gds.plt-db-num = bufo_price-doc-forming.plt-db-num
    17037                     :
    17038                 find first buf_goods no-lock where
    17039                            buf_goods.artic     = bufo_price-doc-forming-gds.artic     and
    17040                            buf_goods.prod-type = bufo_price-doc-forming-gds.prod-type and
    17041                            buf_goods.prod-code = bufo_price-doc-forming-gds.prod-code
    17042                            no-error .
    17043                 find first tt-gds-list where
    17044                            tt-gds-list.gds-code = buf_goods.gds-code
    17045                            no-error .
    17046                 if not available tt-gds-list then do:
    17047                   create tt-gds-list.
    17048                   buffer-copy buf_goods to tt-gds-list .
    17049                 end.
    17050             end.
    17051             end.
    17052           end.
    17053           when 'Переоценка':U then do:
    17054             for each buf_price-list no-lock where buf_price-list.doc-num = doc-code :
    17055                 find first buf_goods no-lock where
    17056                           buf_goods.artic     = buf_price-list.artic and
    17057                           buf_goods.prod-type = buf_price-list.prod-type and
    17058                           buf_goods.prod-code = buf_price-list.prod-code no-error .
    17059                 find first tt-gds-list where tt-gds-list.gds-code = buf_goods.gds-code no-error .
    17060                 if not available tt-gds-list then do:
    17061                     create tt-gds-list.
    17062                     buffer-copy buf_goods to tt-gds-list .
    17063                 end.
    17064             end.
    17065           end.
    17066           when 'Накладная':U or
    17067           when 'Накл-безНДС':U then do:
    17068             for each buf_doc-line no-lock where buf_doc-line.doc-code = doc-code by buf_doc-line.line-num :
    17069                 find first buf_goods no-lock where
    17070                           buf_goods.artic     = buf_doc-line.artic and
    17071                           buf_goods.prod-type = buf_doc-line.prod-type and
    17072                           buf_goods.prod-code = buf_doc-line.prod-code no-error .
    17073                 find first tt-gds-list where tt-gds-list.gds-code = buf_goods.gds-code no-error .
    17074                 if not available tt-gds-list then do:
    17075                     create tt-gds-list.
    17076                     buffer-copy buf_goods to tt-gds-list .
    17077                 end.
    17078             end.
    17079           end.
    17080          otherwise do:
    17081          end.
    17082          end case.
    17083       end.
    17084     end.
    17085   end.
    17086   if  logical(buf-price-list-type.use-gds-group) = true then do:
    17087       for each tt-gds-list :
    17088           find first tt-table2 no-lock where  ( tt-gds-list.grp-name begins tt-table2.f2 ) no-error .
    17089           if not available tt-table2 then do:
    17090              delete tt-gds-list .
    17091           end.
    17092       end.
    17093   end.
    17094   if p-mode = 1 or p-mode = 4 then do:
    17095       run ver-pr-conf no-error .
    17096       if error-status :error then return error return-value .
    17097       run last-num in this-procedure (
    17098           input recid(buf_price-doc-forming) ,
    17099           output v-line-num )
    17100           .
    17101   end.
    17102   define variable v-type-goods as integer   no-undo .
    17103   define variable i as integer   no-undo .
    17104   define variable is-petrolium as logical   no-undo .
    17105   define variable is-pieces    as logical   no-undo .
    17106   define variable v-next as logical   no-undo .
    17107   if par-pr-goods = "" or num-entries (par-pr-goods,".") <> 2 then v-type-goods = integer('1':U) .
    17108   repeat i = 1 to 8 :
    17109     if par-pr-goods begins string(i) + "."  then  do:
    17110        v-type-goods = i .
    17111        leave.
    17112     end.
    17113   end.
    17114   define variable v-errr as logical   no-undo .
    17115   define variable v-errstr as character no-undo .
