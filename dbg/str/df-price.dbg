    18036   PROCEDURE select-header :
    18037   do
    18038     on error undo, return error return-value
    18039     :
    18040   define variable v-exist as logical   no-undo .
    18041   define variable v-param-sp as character no-undo .
    18042   define variable p-type as character no-undo .
    18043   run pdf-exist (
    18044         buf_price-doc-forming.pdf-id  ,
    18045         buf_price-doc-forming.pdf-db  ,
    18046         buf_price-doc-forming.plt-id  ,
    18047         buf_price-doc-forming.plt-db-num ,
    18048         'pricedocI' ,
    18049         output v-exist ).
    18050   if v-exist then  do:
    18051      run pdf-value (
    18052         buf_price-doc-forming.pdf-id  ,
    18053         buf_price-doc-forming.pdf-db  ,
    18054         buf_price-doc-forming.plt-id  ,
    18055         buf_price-doc-forming.plt-db-num ,
    18056         'pricedocI',
    18057         output v-param-sp
    18058         ) .
    18059      if num-entries(v-param-sp,chr(4)) >= 3 then
    18060         assign
    18061           calc-method  = entry (1,v-param-sp,chr(4))
    18062           increase-pc  = decimal (entry(2,v-param-sp,chr(4)))
    18063           round-method = entry (3,v-param-sp,chr(4))
    18064           round-base   = decimal (entry(4,v-param-sp,chr(4)))
    18065           doc-code     = entry (5,v-param-sp,chr(4))
    18066           common-price = decimal(entry (6,v-param-sp,chr(4)))
    18067           copy-type    = substring(entry (7,v-param-sp,chr(4)),1,3)
    18068           copy-code    = integer(substring(entry (7,v-param-sp,chr(4)),4,15))
    18069           .
    18070      calc-method:screen-value in frame Dialog-Frame  = calc-method  .
    18071      doc-code:screen-value in frame Dialog-Frame     = doc-code     .
    18072      increase-pc:screen-value in frame Dialog-Frame  = string(increase-pc)  .
    18073      round-method:screen-value in frame Dialog-Frame = round-method .
    18074      round-base:screen-value in frame Dialog-Frame   = string(round-base )  .
    18075      common-price:screen-value in frame Dialog-Frame = string(common-price) .
    18076      copy-type:screen-value in frame Dialog-Frame    = copy-type    .
    18077      copy-code:screen-value in frame Dialog-Frame    = string(copy-code)    .
    18078      run proc-value-1 in this-procedure .
    18079      run proc-value-2 in this-procedure .
    18080   end.
    18081   end.
    18082   end procedure.
    18083   PROCEDURE select-xxx-line :
    18084       if logical(buf-price-list-type.have-rs-qnty-group) = true then do:
    18085           define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
    18086           for each buf_price-doc-forming-gds-qnty no-lock where
    18087                   buf_price-doc-forming-gds-qnty.pdf-db     = buf_price-doc-forming.pdf-db    and
    18088                   buf_price-doc-forming-gds-qnty.pdf-id     = buf_price-doc-forming.pdf-id    and
    18089                   buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming.plt-db-num and
    18090                   buf_price-doc-forming-gds-qnty.plt-id     = buf_price-doc-forming.plt-id     :
    18091               create tt_price-doc-forming-gds-xxx.
    18092               buffer-copy buf_price-doc-forming-gds-qnty to tt_price-doc-forming-gds-xxx.
    18093           end.
    18094       end.
    18095       if buf-price-list-type.have-rs-sum-group = true then do:
    18096           define buffer buf_price-doc-forming-gds-sum  for ub.price-doc-forming-gds-sum   .
    18097           for each buf_price-doc-forming-gds-sum no-lock where
    18098                   buf_price-doc-forming-gds-sum.pdf-db     = buf_price-doc-forming.pdf-db    and
    18099                   buf_price-doc-forming-gds-sum.pdf-id     = buf_price-doc-forming.pdf-id    and
    18100                   buf_price-doc-forming-gds-sum.plt-db-num = buf_price-doc-forming.plt-db-num and
    18101                   buf_price-doc-forming-gds-sum.plt-id     = buf_price-doc-forming.plt-id     :
    18102               create tt_price-doc-forming-gds-xxx.
    18103               buffer-copy buf_price-doc-forming-gds-sum to tt_price-doc-forming-gds-xxx
    18104               assign
    18105                   tt_price-doc-forming-gds-xxx.ggr-qnty    = buf_price-doc-forming-gds-sum.ssg-summa
    18106                   tt_price-doc-forming-gds-xxx.qgr-db-num  = buf_price-doc-forming-gds-sum.sgr-db-num
    18107                   tt_price-doc-forming-gds-xxx.qgr-id      = buf_price-doc-forming-gds-sum.sgr-id
    18108                   .
    18109           end.
    18110       end.
    18111       if logical(buf-price-list-type.have-rs-turn-group) = true then do:
    18112           define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv   .
    18113           for each buf_price-doc-forming-gds-tnv no-lock where
    18114                   buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming.pdf-db    and
    18115                   buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming.pdf-id    and
    18116                   buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming.plt-db-num and
    18117                   buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming.plt-id     :
    18118               create tt_price-doc-forming-gds-xxx.
    18119               buffer-copy buf_price-doc-forming-gds-tnv to tt_price-doc-forming-gds-xxx
    18120               assign
    18121                   tt_price-doc-forming-gds-xxx.ggr-qnty    = buf_price-doc-forming-gds-tnv.ttg-summa
    18122                   tt_price-doc-forming-gds-xxx.qgr-db-num  = buf_price-doc-forming-gds-tnv.tog-db-num
    18123                   tt_price-doc-forming-gds-xxx.qgr-id      = buf_price-doc-forming-gds-tnv.tog-id
    18124                   .
    18125           end.
    18126       end.
    18127   END PROCEDURE.
    18128   PROCEDURE upd-br-field :
    18129   define variable v-recid as recid no-undo .
    18130   v-recid = recid (buf_price-doc-forming-gds) .
    18131   define buffer loc_price-doc-forming-gds for ub.price-doc-forming-gds  .
    18132   find first loc_price-doc-forming-gds no-lock where recid(loc_price-doc-forming-gds ) = v-recid no-error .
    18133   run ref/h-pdfgds.p
    18134     ( buffer loc_price-doc-forming-gds ,
    18135        input buf_price-doc-forming-gds.price-sale-doc :screen-value in browse browse-1 ,
    18136        input-output v-sec
    18137        ) no-error .
    18138        if error-status :error then do:
    18139           message
    18140             vss-workfile vss-revision vss-description skip
    18141             error-status :get-message(1) skip
    18142             return-value skip
    18143             "h-pdfgds.p"
    18144             view-as alert-box error
    18145           .
    18146        end.
    18147   END PROCEDURE.
    18148   PROCEDURE vc-pdf :
    18149   v-in-doc-qnty = ? .
    18150   if not available buf_price-doc-forming-gds then return.
    18151   define variable v1-recid as recid no-undo .
    18152   define buffer bf_goods for ub.goods   .
    18153   define variable p-avrg1  as decimal   no-undo .
    18154   define variable p-qnty1  as decimal   no-undo .
    18155   assign
    18156     p-avrg1 = 0
    18157     p-qnty1 = 0
    18158     obj-in-date = 01/01/1990
    18159     obj-in-code = ""
    18160     p-last = 0
    18161     v-free-qnty = 0
    18162     v-fact-qnty = 0
    18163     v-in-doc-qnty = ?
    18164   .
    18165   find first bf_goods no-lock where
    18166              bf_goods.artic = buf_price-doc-forming-gds.artic and
    18167              bf_goods.prod-type = buf_price-doc-forming-gds.prod-type and
    18168              bf_goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
    18169   run metod-delobj-usr (
    18170       buf_price-doc-forming.pdf-id  ,
    18171       buf_price-doc-forming.pdf-db ,
    18172       buf_price-doc-forming.plt-id    ,
    18173       buf_price-doc-forming.plt-db-num
    18174      ).
    18175   for each x_obj-group :
    18176       find ub.gds-obj no-lock where
    18177           ub.gds-obj.artic     = buf_price-doc-forming-gds.artic     and
    18178           ub.gds-obj.prod-type = buf_price-doc-forming-gds.prod-type and
    18179           ub.gds-obj.prod-code = buf_price-doc-forming-gds.prod-code and
    18180           ub.gds-obj.obj-type  = x_obj-group.obj-type and
    18181           ub.gds-obj.obj-code  = x_obj-group.obj-code no-error.
    18182           if available ub.gds-obj and ub.gds-obj.avrg-rubl <> ? then do:
    18183              assign
    18184               p-avrg1 = p-avrg1 + (if var-pr-r-b = "rubl" then  ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
    18185               p-qnty1 = p-qnty1 + ub.gds-obj.avrg-qnty
    18186              .
    18187           end.
    18188           if available ub.gds-obj and ub.gds-obj.in-date <> ? then do:
    18189               if obj-in-date < ub.gds-obj.in-date then do:
    18190                   assign
    18191                     obj-in-date = ub.gds-obj.in-date
    18192                     obj-in-code = ub.gds-obj.in-code
    18193                     p-last = if var-pr-r-b = "rubl" then  ub.gds-obj.last-rubl else ub.gds-obj.last-base
    18194                     v-free-qnty = ub.gds-obj.free-qnty
    18195                     v-fact-qnty = ub.gds-obj.fact-qnty
    18196                   .
    18197               end.
    18198           end.
    18199   end.
    18200   if obj-in-code <> ? and obj-in-code > "" and available bf_goods
    18201   then do:
    18202     find first buf_doc-line no-lock where buf_doc-line.doc-code  = obj-in-code
    18203                                      and buf_doc-line.artic     = bf_goods.artic
    18204                                      and buf_doc-line.prod-type = bf_goods.prod-type
    18205                                      and buf_doc-line.prod-code = bf_goods.prod-code no-error .
    18206     if available buf_doc-line
    18207     then do:
    18208       v-in-doc-qnty = buf_doc-line.fact-qnty .
    18209     end.
    18210     else do:
    18211       v-in-doc-qnty = ? .
    18212     end.
    18213   end.
    18214   if obj-in-date = 01/01/1990  then obj-in-date = ?.
    18215   if p-qnty1 = 0 or p-qnty1 = ? then p-avrg = ? .
    18216                                 else p-avrg = p-avrg1 / p-qnty1.
    18217   define variable v-cur-dn as character no-undo .
    18218   define variable v-cur-pr as decimal   no-undo .
    18219   define variable v-cur-rt as decimal   no-undo .
    18220   define variable v-cur-ex as decimal   no-undo .
    18221   find first x_obj-group no-error .
    18222   if error-status :error then return .
    18223   define variable vss-include-info144 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    18225     (input  x_obj-group.obj-type
    18226     ,input  x_obj-group.obj-code
    18227     ,input  buf_price-doc-forming-gds.b-code
    18228     ,input  0
    18229     ,input  0
    18230     ,output v-cur-dn
    18231     ,output v-cur-pr
    18232     ,output v-cur-rt
    18233     ,output v-cur-ex
    18234     )  .
    18235   if par-is-pharm = "yes"  then do:
    18236   define variable vss-include-info145 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
    18238   (  input  buf_price-doc-forming-gds.b-code
    18239    , input  x_obj-group.obj-type
    18240    , input  x_obj-group.obj-code
    18241    , output v-prod-price
    18242    , output v-priceprodwithvat-2
    18243    , output v-prod-vat
    18244    , output v-str1
    18245    , output v-str1
    18246           )  .
    18247     v-ost  = f-ost-part ( buf_price-doc-forming-gds.b-code,x_obj-group.obj-type , x_obj-group.obj-code ) .
    18248     var-vat-pc = 0 .
    18249   define variable vss-include-info146 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    18251     (input  bf_goods.gds-code
    18252     ,input  '1':U
    18253     ,input  ?
    18254     ,input  v-cntxt-host-code-obj
    18255     ,input  x_obj-group.obj-type
    18256     ,input  x_obj-group.obj-code
    18257     ,output var-vat-pc
    18258     ) no-error .
    18259   end.
    18260   assign
    18261     p-pr-doc-old = v-cur-pr
    18262     prev-price_doc-num =  v-cur-dn
    18263     p-old = buf_price-doc-forming-gds.price-prev-doc
    18264     p-new = buf_price-doc-forming-gds.price-sale-doc
    18265     p-pc-prev = (p-new / p-old  - 1) * 100
    18266     p-op-avrg = (p-old / p-avrg - 1) * 100
    18267     p-pc-avrg = (p-new / p-avrg - 1) * 100
    18268     p-op-pr-doc-old = (p-old / p-pr-doc-old - 1) * 100
    18269     p-pc-pr-doc-old = (p-new / p-pr-doc-old - 1) * 100
    18270     p-op-last = (p-old / p-last - 1) * 100
    18271     p-pc-last = (p-new / p-last - 1) * 100
    18272     p-pc-op-pr-doc-old = p-pc-pr-doc-old - p-op-pr-doc-old
    18273     p-pc-op-avrg = p-pc-avrg - p-op-avrg
    18274     p-pc-op-last = p-pc-last - p-op-last
    18275     p-calc-metod = buf_price-doc-forming-gds.calc-method
    18276     v-new-price-vat  = p-new - ( p-new * var-vat-pc / (100 + var-vat-pc))
    18277     v-prod-price-prc   = ( p-new  / v-prod-price - 1 ) * 100
    18278     v-prod-price-prc-2 = ( v-new-price-vat / v-priceprodwithvat-2 - 1 ) * 100
    18279     v-prod-price-prc-3 = ( p-new / v-priceprodwithvat-2 - 1 ) * 100
    18280     .
    18281     if num-entries(buf_price-doc-forming-gds.calc-method,chr(4)) >= 2 then do:
    18282        p-calc-metod          = entry(1,buf_price-doc-forming-gds.calc-method,chr(4)) .
    18283        p-calc-metod:tooltip in frame Dialog-Frame  = entry(2,buf_price-doc-forming-gds.calc-method,chr(4)) .
    18284     end.
    18285     else do:
    18286      p-calc-metod:tooltip in frame Dialog-Frame  = "" .
    18287     end.
    18288     if p-pc-prev > 9999 then
    18289       p-pc-prev = ?.
    18290     if p-pc-avrg > 9999 then
    18291       p-pc-avrg = ?.
    18292     if p-op-avrg > 9999 then
    18293       p-op-avrg = ?.
    18294     if p-pc-pr-doc-old > 9999 then
    18295       p-pc-pr-doc-old = ?.
    18296     if p-op-pr-doc-old > 9999 then
    18297       p-op-pr-doc-old = ?.
    18298     if p-pc-last > 9999 then
    18299       p-pc-last = ?.
    18300     if p-op-last > 9999 then
    18301       p-op-last = ?.
    18302     if   p-pc-op-avrg > 9999 then
    18303       p-pc-op-avrg = ?.
    18304     if   p-pc-op-pr-doc-old > 9999 then
    18305       p-pc-op-pr-doc-old = ?.
    18306     if p-pc-op-last > 9999 then
    18307       p-pc-op-last = ?.
    18308     if v-prod-price-prc > 9999 then
    18309        v-prod-price-prc = ?.
    18310   display
    18311        p-new p-old  prev-price_doc-num
    18312        p-last obj-in-code obj-in-date    p-pc-op-last p-calc-metod
    18313        p-pc-prev   p-op-last p-pc-last
    18314        p-avrg
    18315        p-op-avrg
    18316        p-pc-avrg
    18317        p-pc-op-avrg
    18318        p-pr-doc-old
    18319        p-op-pr-doc-old
    18320        p-pc-pr-doc-old
    18321        p-pc-op-pr-doc-old
    18322        with frame Dialog-Frame no-error .
    18323     if par-is-pharm = "yes" then do:
    18324         display
    18325           v-ost
    18326           v-prod-price
    18327           v-new-price-vat
    18328           v-prod-price-prc
    18329           v-priceprodwithvat-2
    18330           v-prod-price-prc-2
    18331           v-prod-price-prc-3
    18332           doc-code
    18333         with frame Dialog-Frame no-error .
    18334         enable doc-code with frame Dialog-Frame .
    18335     end.
    18336     else do :
    18337       hide
    18338           v-ost
    18339           v-prod-price
    18340           v-new-price-vat
    18341           v-prod-price-prc
    18342           v-priceprodwithvat-2
    18343           v-prod-price-prc-2
    18344           v-prod-price-prc-3
    18345         in frame Dialog-Frame  .
    18346       display
    18347         v-free-qnty
    18348         v-fact-qnty
    18349         v-in-doc-qnty
    18350       with frame Dialog-Frame no-error .
    18351     end.
    18352   if p-mode = 'ПРОСМОТР':U then  disable doc-code with frame Dialog-Frame .
    18353   END PROCEDURE.
    18354   PROCEDURE ver-bar-code-prt :
    18355   define input  parameter p-b-code as integer   no-undo .
    18356   define output parameter p-is-prt as logical   no-undo .
    18357   define buffer main_bar-code for ub.bar-code  .
    18358   define buffer buf1_bar-code for ub.bar-code  .
    18359   define buffer buf1_goods    for ub.goods  .
    18360   define variable main-b-code as integer   no-undo .
    18361   find first buf1_bar-code no-lock where
    18362              buf1_bar-code.b-code = p-b-code no-error .
    18363   find first buf1_goods no-lock where
    18364              buf1_goods.gds-code = buf1_bar-code.gds-code no-error .
    18365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    18366     (input  buf1_goods.gds-code
    18367     ,input  ?
    18368     ,output main-b-code
    18369     )  .
    18370    p-is-prt = false  .
    18371    if main-b-code <> p-b-code and buf1_goods.unit-base = buf1_bar-code.unit-cli then p-is-prt = true .
    18372   END PROCEDURE.
    18373   PROCEDURE ver-pr-conf :
    18374   define buffer buf-bar-code  for ub.bar-code.
    18375   define buffer buf-goods     for ub.goods.
    18376   define buffer buf-gds-prt   for ub.gds-prt.
    18377   define buffer curr_price-doc-forming-gds for ub.price-doc-forming-gds  .
    18378   define buffer f_price-doc   for ub.price-doc  .
    18379   define variable v-ex1               as logical   no-undo .
    18380   define variable v-ex1-doc-num       as character no-undo .
    18381   define variable v-ex1-doc-status    as character no-undo .
    18382   define variable v-ex1-doc-obj-type  as character no-undo .
    18383   define variable v-ex1-doc-obj-code  as integer   no-undo .
    18384   define variable v-ret               as logical   no-undo .
    18385   define variable bc-main             as integer   no-undo .
    18386   define variable g#log               as logical   no-undo .
    18387   for each  x_obj-group :
    18388   for each tt-gds-list :
    18389       find  buf-goods no-lock where
    18390             buf-goods.gds-code = tt-gds-list.gds-code.
    18391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    18392     (input  tt-gds-list.gds-code
    18393     ,input  ?
    18394     ,output bc-main
    18395     )  .
    18396       run ver-modificator-price-is-null (
    18397           input  tt-gds-list.artic ,
    18398           input  tt-gds-list.prod-type ,
    18399           input  tt-gds-list.prod-code ,
    18400           input  v-cntxt-obj-type ,
    18401           input  v-cntxt-obj-code ,
    18402           output v-ret ).
    18403           if v-ret = false then do:
    18404               message
    18405                 "На модификатор : " skip
    18406                 "Артикул : " buf-goods.artic skip
    18407                   buf-goods.gds-name skip
    18408                 "не должно быть цены! "
    18409                 view-as alert-box information .
    18410                 delete tt-gds-list .
    18411                 next.
    18412           end.
    18413         if par-pr-dpl-q = "yes" then do:
    18414             assign
    18415               v-ex1 = false
    18416               v-ex1-doc-num =    ""
    18417               v-ex1-doc-status   = ""
    18418               v-ex1-doc-obj-type = ""
    18419               v-ex1-doc-obj-code = 0
    18420             .
    18421                   for each  ub.price-list no-lock where
    18422                             ub.price-list.b-code   = bc-main and
    18423                             ub.price-list.obj-type = x_obj-group.obj-type and
    18424                             ub.price-list.obj-code = x_obj-group.obj-code and
    18425                             ub.price-list.price-type = "" and
    18426                             ub.price-list.fact-order = 0 ,
    18427                             first f_price-doc no-lock where
    18428                                   f_price-doc.doc-num = ub.price-list.doc-num and
    18429                                 ( f_price-doc.status_ = 'приказ':U or  f_price-doc.status_ = 'разрешен':U )
    18430                             :
    18431                             assign
    18432                               v-ex1 = true
    18433                               v-ex1-doc-num =     ub.price-list.doc-num
    18434                               v-ex1-doc-status   = f_price-doc.status_
    18435                               v-ex1-doc-obj-type = f_price-doc.obj-type
    18436                               v-ex1-doc-obj-code = f_price-doc.obj-code
    18437                               .
    18438                             leave.
    18439                   end.
    18440           if v-ex1 = true  then do:
    18441             g#log = yes.
    18442             message "Строка :" buf-goods.artic buf-goods.gds-name
    18443                     "ЕСТЬ в ПЕРЕОЦЕНКЕ №" v-ex1-doc-num  "статус:" v-ex1-doc-status
    18444                     "для" v-ex1-doc-obj-type v-ex1-doc-obj-code skip
    18445                     "Продолжать?"
    18446                     view-as alert-box question buttons ok-cancel update g#log.
    18447             if not g#log then do:
    18448               delete tt-gds-list .
    18449               next.
    18450             end.
    18451           end.
    18452         end.
    18453       if par-pr-clt-q = "yes" then do:
    18454       find first curr_price-doc-forming-gds no-lock where
    18455                 curr_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db     and
    18456                 curr_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id     and
    18457                 curr_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    18458                 curr_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id     and
    18459                 curr_price-doc-forming-gds.artic      = buf-goods.artic                  and
    18460                 curr_price-doc-forming-gds.prod-type  = buf-goods.prod-type              and
    18461                 curr_price-doc-forming-gds.prod-code  = buf-goods.prod-code  no-error .
    18462         if available curr_price-doc-forming-gds then do:
    18463             g#log = yes.
    18464             message "Строка :" buf-goods.artic buf-goods.gds-name
    18465                     "уже ЕСТЬ в заполняемом ДНЦ, цена =" curr_price-doc-forming-gds.price-sale-doc skip
    18466                     "Продолжать?"
    18467                     view-as alert-box question buttons ok-cancel update g#log.
    18468             if not g#log then  do:
    18469               delete tt-gds-list .
    18470               next.
    18471             end.
    18472         end.
    18473       end.
    18474   end.
    18475   end.
    18476   END PROCEDURE.
    18477   FUNCTION fnc-color RETURNS integer
    18478     ( buffer b-goods for ub.goods , buffer b-bar-code for ub.bar-code ) :
    18479   define buffer b-gds-prt for ub.gds-prt.
    18480   find first b-gds-prt no-lock where b-gds-prt.node-code = b-bar-code.node-code no-error .
    18481   if available b-gds-prt then do:
    18482      if b-gds-prt.upper-code = b-goods.prt-root then do:
    18483         if b-goods.unit-base = b-bar-code.unit-cli then return ?.
    18484                                                    else return dark_gray_color .
    18485      end.
    18486     else do:
    18487       if b-goods.unit-base = b-bar-code.unit-cli then return dark_green_color .
    18488                                                  else return blue_color .
    18489     end.
    18490   end.
    18491   END FUNCTION.
    18492   FUNCTION fnc-gds-name RETURNS CHARACTER
    18493   ( input p-rec1 as recid , input p-rec2 as recid ) :
    18494   define buffer b-goods    for ub.goods  .
    18495   define buffer b-bar-code for ub.bar-code  .
    18496   define buffer b-gds-prt  for ub.gds-prt.
    18497   define buffer buf_parts  for ub.parts  .
    18498   define variable v-name as character no-undo .
    18499   find first b-goods    no-lock where recid(b-goods) = p-rec1 no-error .
    18500        if error-status :error then return '' .
    18501   find first b-bar-code no-lock where recid(b-bar-code)  = p-rec2 no-error .
    18502   find first b-gds-prt no-lock where b-gds-prt.node-code = b-bar-code.node-code no-error .
    18503   find first buf_parts no-lock where
    18504              buf_parts.part-code  = b-bar-code.part-code and
    18505              buf_parts.in-code    = b-bar-code.in-code and
    18506              buf_parts.out-code   = b-bar-code.in-code and
    18507              buf_parts.artic      = b-goods.artic      and
    18508              buf_parts.prod-type  = b-goods.prod-type      and
    18509              buf_parts.prod-code  = b-goods.prod-code    no-error .
    18510    v-name = if b-gds-prt.upper-code = b-goods.prt-root
    18511            then
    18512            if b-bar-code.in-code = ''
    18513               then  b-goods.gds-name
    18514               else  substitute("  &1  ПН &2 до &3" , b-bar-code.part-code, b-bar-code.in-code , if available buf_parts then  string(buf_parts.last-date , "99/99/9999") else "" )
    18515         else        substitute("    &1" , b-gds-prt.f-name)
    18516         .
    18517         return v-name.
    18518   END FUNCTION.
