     6616   procedure create-calc-bc :
     6617   define input parameter  v-new-recid as recid no-undo .
     6618   define input parameter  p-calc-method  as character no-undo .
     6619   define input parameter  p-increase-pc  as decimal   no-undo .
     6620   define input parameter  round-method as character no-undo .
     6621   define input parameter  round-base   as decimal   no-undo .
     6622   define input parameter  p-b-code     as integer   no-undo .
     6623   define input parameter  p-gds-code   as integer   no-undo .
     6624   define input parameter  p-artic      as character no-undo .
     6625   define input parameter  p-prod-type  as character no-undo .
     6626   define input parameter  p-prod-code  as integer   no-undo .
     6627   define input parameter  v-base-rate  as decimal   no-undo .
     6628   define input parameter  v-base-scale as decimal   no-undo .
     6629   define input parameter  v-exch-scale as decimal   no-undo .
     6630   define input parameter  v-exch-rate  as decimal   no-undo .
     6631   define input parameter  v-doc-code   as character no-undo .
     6632   define input parameter  v-common-price as decimal   no-undo .
     6633   define input parameter  v-copy-type as character no-undo .
     6634   define input parameter  v-copy-code as integer   no-undo .
     6635   define input-output parameter v-line-num as integer   no-undo .
     6636   define input-output parameter v-sec     as integer   no-undo .
     6637   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6638   define variable v-price-calc-base as decimal   no-undo .
     6639   define variable v-price-calc-doc  as decimal   no-undo .
     6640   define variable v-price-calc-rubl as decimal   no-undo .
     6641   define variable v-price-prev-base as decimal   no-undo .
     6642   define variable v-price-prev-doc  as decimal   no-undo .
     6643   define variable v-price-prev-rubl as decimal   no-undo .
     6644   define variable v-price-sale-base as decimal   no-undo .
     6645   define variable v-price-sale-doc  as decimal   no-undo .
     6646   define variable v-price-sale-rubl as decimal   no-undo .
     6647   define variable v-road-tax-base   as decimal   no-undo .
     6648   define variable v-road-tax-doc    as decimal   no-undo .
     6649   define variable v-road-tax-rubl   as decimal   no-undo .
     6650   define variable v-excise-base     as decimal   no-undo .
     6651   define variable v-excise-doc      as decimal   no-undo .
     6652   define variable v-excise-rubl     as decimal   no-undo .
     6653   define variable v-vat-pc          as decimal   no-undo .
     6654   define variable v-slt-pc          as decimal   no-undo .
     6655   define variable v-prev-doc-code   as character no-undo .
     6656   define variable v-d-pcnt as decimal   no-undo .
     6657     do
     6658     on error undo, return error return-value
     6659     :
     6660     find  buf_price-doc-forming no-lock where
     6661           recid(buf_price-doc-forming) = v-new-recid no-error .
     6662      if error-status :error then return error error-status :get-message(1) .
     6663      v-line-num = v-line-num + 1.
     6664      run calc-price-line  in this-procedure (
     6665        input  p-calc-method
     6666      , input  p-increase-pc
     6667      , input  round-method
     6668      , input  round-base
     6669      , input  p-b-code
     6670      , input  p-gds-code
     6671      , input  p-artic
     6672      , input  p-prod-type
     6673      , input  p-prod-code
     6674      , input  v-base-rate
     6675      , input  v-base-scale
     6676      , input  v-exch-scale
     6677      , input  v-exch-rate
     6678      , input  v-doc-code
     6679      , input  v-common-price
     6680      , input  v-copy-type
     6681      , input  v-copy-code
     6682      , output p-calc-method
     6683      , output v-price-calc-base
     6684      , output v-price-calc-doc
     6685      , output v-price-calc-rubl
     6686      , output v-price-prev-base
     6687      , output v-price-prev-doc
     6688      , output v-price-prev-rubl
     6689      , output v-price-sale-base
     6690      , output v-price-sale-doc
     6691      , output v-price-sale-rubl
     6692      , output v-road-tax-base
     6693      , output v-road-tax-doc
     6694      , output v-road-tax-rubl
     6695      , output v-excise-base
     6696      , output v-excise-doc
     6697      , output v-excise-rubl
