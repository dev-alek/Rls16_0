    14993        and
    14994        self :sensitive = true
    14995        )
    14996     or (can-query (self, "read-only")
    14997        and
    14998        self :read-only = false
    14999        )
    15000     then do:
    15001       if self :handle <> focus :handle
    15002       then do:
    15003         apply "entry":u to self .
    15004       end.
    15005       define variable v-curr-sv-date as date no-undo .
    15006       define variable v-new-sv-date  as date no-undo .
    15007       assign
    15008         v-curr-sv-date = date(self :screen-value) no-error
    15009       .
    15010       if v-curr-sv-date = ?
    15011       then do:
    15012         run gbl/getcurdt.p
    15013           (output v-curr-sv-date
    15014           ) .
    15015       end.
    15016       if v-curr-sv-date <> ?
    15017       then do:
    15018         run gbl/lastdate.p
    15019           (input  v-curr-sv-date
    15020           ,output v-new-sv-date
    15021           ).
    15022         assign
    15023           self :screen-value = string(v-new-sv-date) .
    15024         .
    15025       end.
    15026     end.
    15027     return no-apply .
    15028   end.
    15029   on ctrl-f of FILL-IN_end-sys-date in frame Dialog-Frame
    15030   do:
    15031     if (can-query (self, "sensitive")
    15032        and
    15033        self :sensitive = true
    15034        )
    15035     or (can-query (self, "read-only")
    15036        and
    15037        self :read-only = false
    15038        )
    15039     then do:
    15040       if self :handle <> focus :handle
    15041       then do:
    15042         apply "entry":u to self .
    15043       end.
    15044       define variable v-ok            as logical   no-undo .
    15045       define variable v-curr-sv-date  as date      no-undo .
    15046       define variable v-description   as character no-undo .
    15047       assign
    15048         v-curr-sv-date = date(self :screen-value) no-error
    15049       .
    15050       if v-curr-sv-date = ?
    15051       then do:
    15052         run gbl/getcurdt.p
    15053           (output v-curr-sv-date
    15054           ) .
    15055       end.
    15056       if v-curr-sv-date <> ?
    15057       then do:
    15058         run gbl/d-inpday.w
    15059           (input ?
    15060           ,input "Выбор даты"
    15061           ,input v-description
    15062           ,input ""
    15063           ,input-output v-curr-sv-date
    15064           ,output v-ok
    15065           ).
    15066         if v-ok = true
    15067         then do:
    15068           assign
    15069             self :screen-value = string(v-curr-sv-date) .
    15070           .
    15071         end.
    15072       end.
    15073     end.
    15074     return no-apply .
    15075   end.
