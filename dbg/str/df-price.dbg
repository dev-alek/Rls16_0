    16201   PROCEDURE local-mark :
    16202   if not available buf_price-doc-forming-gds then do:
    16203       message "Неправильный выбор строки.".
    16204       return no-apply.
    16205     end.
    16206   define variable vss-include-info135 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16207   define variable v-str-recid136 as character no-undo .
    16208   define variable v-num-entry136 as integer   no-undo .
    16209   assign
    16210     v-str-recid136 = trim( string( recid( buf_price-doc-forming-gds ) , "->>>>>>>>>>>9":U ) )
    16211     v-num-entry136 = lookup( v-str-recid136 , del-list )
    16212   .
    16213   if v-num-entry136 > 0 then do:
    16214     assign
    16215       entry( v-num-entry136, del-list ) = "":U
    16216       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    16217     .
    16218   end.
    16219   else do:
    16220     assign
    16221       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid136
    16222     .
    16223   end.
    16224     BROWSE-1:refresh() in frame Dialog-Frame .
    16225     run vc-pdf in this-procedure .
    16226   END PROCEDURE.
