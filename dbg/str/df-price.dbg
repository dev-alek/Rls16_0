    11852     if not available buf_price-doc-forming-gds then return.
    11853     if decimal (buf_price-doc-forming-gds.price-sale-doc :screen-value in browse browse-1) <> round (buf_price-doc-forming-gds.price-sale-doc,2)
    11854        and buf_bar-code.unit-cli <> buf_goods.unit-base
    11855        then do:
    11856             message "Изменение в режиме НЕОСНОВНЫЕ ЦЕНЫ !" view-as alert-box information .
    11857             display  buf_price-doc-forming-gds.price-sale-doc  with browse browse-1.
    11858             apply "value-changed" to browse-1 in frame Dialog-Frame.
    11859     end.
    11860     if decimal (buf_price-doc-forming-gds.price-sale-doc :screen-value in browse browse-1) <> round (buf_price-doc-forming-gds.price-sale-doc,2)
    11861     and   buf_bar-code.unit-cli = buf_goods.unit-base
    11862       then do:
    11863       g#log = yes.
    11864       message "Строка изменена. Записать это изменение?"
    11865               view-as alert-box question buttons yes-no update g#log.
    11866             if g#log then do:
    11867               find current buf_price-doc-forming-gds exclusive-lock no-error .
    11868               assign  buf_price-doc-forming-gds.price-calc-doc = buf_price-doc-forming-gds.price-sale-doc
    11869                       buf_price-doc-forming-gds.price-sale-doc
    11870                       buf_price-doc-forming-gds.price-sale-rubl = buf_price-doc-forming-gds.price-sale-doc * v-exch-rate / v-exch-scale
    11871                       buf_price-doc-forming-gds.price-sale-base = buf_price-doc-forming-gds.price-sale-rubl / v-base-rate * v-base-scale
    11872                       buf_price-doc-forming-gds.calc-method = 'Отсутствует':U
    11873                       .
    11874                   run calc-price-sub in this-procedure
    11875                                    (input  buf_price-doc-forming-gds.b-code,
    11876                                     input  recid (buf_price-doc-forming),
    11877                                     input  calc-method,
    11878                                     input  increase-pc,
    11879                                     input  round-method,
    11880                                     input  round-base,
    11881                                     input  doc-code,
    11882                                     input  common-price,
    11883                                     input  copy-type,
    11884                                     input  copy-code,
    11885                                     output calc-rec ) no-error.
    11886                       run recalc-neos (
    11887                           buf_price-doc-forming-gds.b-code,
    11888                           buf_price-doc-forming-gds.artic,
    11889                           buf_price-doc-forming-gds.prod-type,
    11890                           buf_price-doc-forming-gds.prod-code
    11891                           ) no-error .
    11892                           if error-status :error then do:
    11893                             message
    11894                               vss-workfile vss-revision vss-description skip
    11895                               error-status :get-message(1) skip
    11896                               return-value skip
    11897                               "ошибка пересчета 2"
    11898                               view-as alert-box error
    11899                             .
    11900                           end.
    11901                   if error-status :error then do:
    11902                       message
    11903                         vss-workfile vss-revision vss-description skip
    11904                         error-status :get-message(1) skip
    11905                         return-value skip
    11906                         "calc-price-sub"
    11907                         view-as alert-box error
    11908                       .
    11909                         display  buf_price-doc-forming-gds.price-sale-doc  with browse browse-1.
    11910                         apply "value-changed" to browse-1 in frame Dialog-Frame.
    11911                         undo, return.
    11912                     end.
    11913                   run OpenBr in this-procedure (yes, no, '':U).
    11914                   reposition browse-1 to recid calc-rec no-error .
    11915               run upd-br-field in this-procedure .
    11916               run make-xxx-line in this-procedure .
    11917               v-rec-id = recid(buf_price-doc-forming-gds).
    11918               run OpenBr in this-procedure (yes, no, '':U).
    11919               reposition browse-1 to recid v-rec-id no-error.
    11920               apply "value-changed" to browse-1 in frame Dialog-Frame.
    11921             end.
