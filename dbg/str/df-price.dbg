    11295       buf_price-doc-forming-gds.road-tax-rubl COLUMN-LABEL 'Комп.цены (нац.вал)' FORMAT "->>>,>>>,>>9.99":U
    11296       buf_price-doc-forming-gds.excise-rubl COLUMN-LABEL 'Акциз (нац.вал)' FORMAT "->>>,>>>,>>9.99":U
    11297       buf_price-doc-forming-gds.price-sale-base COLUMN-LABEL 'Новая (баз.вал)' FORMAT "->>>,>>>,>>9.99":U
    11298       buf_price-doc-forming-gds.price-prev-base COLUMN-LABEL 'Последняя (баз.вал)' FORMAT "->>>,>>>,>>9.99":U
    11299       buf_price-doc-forming-gds.price-calc-base COLUMN-LABEL 'Исходная  (баз.вал)' FORMAT "->>>,>>>,>>9.99":U
    11300       buf_price-doc-forming-gds.road-tax-base COLUMN-LABEL 'Комп.цены (баз.вал)' FORMAT "->>>,>>>,>>9.99":U
    11301       buf_price-doc-forming-gds.excise-base COLUMN-LABEL 'Акциз (баз.вал)' FORMAT "->>>,>>>,>>9.99":U
