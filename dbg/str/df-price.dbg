     2670      .
     2671   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2672   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     2673     (input  ?
     2674     ,input  l-type
     2675     ,input  l-code
     2676     ,output par-pr-nakl-ie
     2677     ,output par-pr-nakl-iv
     2678     ,output par-pr-nakl-im
     2679     ) no-error .
     2680      define variable ii as integer   no-undo .
     2681      define variable nn as integer   no-undo .
     2682      define variable v-fullname as character no-undo .
     2683      nn = num-entries ( par-pr-nogds ).
     2684      par-pr-nogds-long = "".
     2685      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     2686         repeat ii = 1 to nn :
     2687           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     2688           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     2689         end.
     2690         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     2691      end.
     2692   l-par = true .
     2693   end procedure.
     2694   PROCEDURE cre-pr-list:
     2695   define input  parameter bc      like ub.price-list.b-code no-undo.
     2696   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     2697   define output parameter new-rec as recid             no-undo.
     2698   define buffer buf-price-list for ub.price-list.
     2699   define buffer buf-price-doc  for ub.price-doc.
     2700   define buffer buf-bar-code   for ub.bar-code.
     2701   define buffer buf-goods      for ub.goods.
     2702   define buffer buf-gds-prt    for ub.gds-prt.
     2703   define buffer root-gds-prt   for ub.gds-prt.
     2704   define variable cur-pr like ub.price-list.price-sale no-undo.
     2705   define variable cur-rt like ub.price-list.road-tax   no-undo.
     2706   define variable cur-ex like ub.price-list.excise     no-undo.
     2707   define variable cur-dn like ub.price-list.doc-num    no-undo.
     2708   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2709   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2710   define variable cur-rt-base as decimal no-undo .
     2711   define variable cur-rt-rubl as decimal no-undo .
     2712   define variable p-hostcode as int no-undo .
     2713   define variable v-line-num as integer no-undo .
     2714   define variable v-skip-del-gds as logical no-undo initial no .
     2715   cre-pr:
     2716   do on error undo cre-pr, return error:
     2717     find  buf-bar-code no-lock where
     2718           buf-bar-code.b-code = bc.
     2719     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     2720     if error-status :error then do:
     2721       message
     2722         return-value skip
     2723         "Ошибка !"
     2724         view-as alert-box error
     2725       .
     2726       undo cre-pr, return.
     2727     end.
     2728     find  buf-goods no-lock where
     2729           buf-goods.gds-code = buf-bar-code.gds-code.
     2730     find first root-gds-prt no-lock where
     2731               root-gds-prt.upper-code = buf-goods.prt-root.
     2732     if root-gds-prt.node-name <> '_Пустая шкала':U and
     2733       buf-bar-code.in-code <> "" then do:
     2734       message
     2735         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2736         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2737         view-as alert-box error.
     2738       undo cre-pr, return.
     2739     end.
     2740     find  buf-gds-prt no-lock where
     2741           buf-gds-prt.node-code = buf-bar-code.node-code.
     2742     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     2743       message
     2744         "Не допускается создавать цены на удаленные товары!" skip (2)
     2745         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2746         view-as alert-box error.
     2747       undo cre-pr, return.
     2748     end.
     2749     find  buf-price-doc where
     2750           buf-price-doc.doc-num = new-num.
     2751   define variable v-ret as logical no-undo .
     2752      run ver-modificator-price-is-null (
     2753             input    buf-goods.artic        ,
     2754             input    buf-goods.prod-type    ,
     2755             input    buf-goods.prod-code    ,
     2756             input    buf-price-doc.obj-type   ,
     2757             input    buf-price-doc.obj-code   ,
     2758             output   v-ret ).
     2759         if v-ret = false then dO:
     2760             message
     2761               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     2762               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     2763               view-as alert-box error.
     2764             undo cre-pr, return.
     2765           end.
     2766   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2768     (input  buf-price-doc.obj-type
     2769     ,input  buf-price-doc.obj-code
     2770     ,output p-hostcode
     2771     ) no-error .
     2772   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2774     (input  buf-goods.gds-code
     2775     ,input  '1':U
     2776     ,input  ?
     2777     ,input  p-hostcode
     2778     ,input  buf-price-doc.obj-type
     2779     ,input  buf-price-doc.obj-code
     2780     ,output local_vat-pc
     2781     ) no-error .
     2782   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2784     (input  buf-goods.gds-code
     2785     ,input  '2':U
     2786     ,input  ?
     2787     ,input  p-hostcode
     2788     ,input  buf-price-doc.obj-type
     2789     ,input  buf-price-doc.obj-code
     2790     ,output local_slt-pc
     2791     ) no-error .
     2792   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2794     (input  buf-price-doc.obj-type
     2795     ,input  buf-price-doc.obj-code
     2796     ,input  bc
     2797     ,input  0
     2798     ,input  0
     2799     ,output cur-dn
     2800     ,output cur-pr
     2801     ,output cur-rt
     2802     ,output cur-ex
     2803     ) no-error .
     2804     find first buf-price-list where
     2805               buf-price-list.b-code  = buf-bar-code.b-code and
     2806               buf-price-list.doc-num = new-num  and
     2807               buf-price-list.price-type = ""    no-error .
     2808     if not available buf-price-list then do:
     2809       run calc-price-line-num (input  new-num , output v-line-num) .
     2810       create buf-price-list.
     2811       assign
     2812         buf-price-list.line-num  = v-line-num
     2813         buf-price-list.b-code    = buf-bar-code.b-code
     2814         buf-price-list.doc-num   = buf-price-doc.doc-num
     2815         buf-price-list.prod-type = buf-goods.prod-type
     2816         buf-price-list.prod-code = buf-goods.prod-code
     2817         buf-price-list.artic     = buf-goods.artic
     2818         buf-price-list.obj-type  = buf-price-doc.obj-type
     2819         buf-price-list.obj-code  = buf-price-doc.obj-code
     2820         buf-price-list.vat-pc    = local_vat-pc
     2821         buf-price-list.slt-pc    = local_slt-pc
     2822         buf-price-list.price-prev = cur-pr
     2823         .
     2824       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     2825           buf-bar-code.in-code   = "" and
     2826           buf-bar-code.part-code = "" and
     2827           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     2828         buf-price-list.main-price = yes.
     2829         if cur-pr <> ? then do:
     2830           run exp-prt (input buf-goods.gds-code,
     2831                       input cur-dn,
     2832                       input new-num,
     2833                       output new-rec) no-error.
     2834           if error-status :error then do:
     2835             message
     2836               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     2837               view-as alert-box error.
     2838             undo cre-pr, return error.
     2839           end.
     2840         end.
     2841       end.
     2842       else do:
     2843         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2844           buf-price-list.d-pcnt = ?.
     2845         end.
     2846         buf-price-list.main-price = no.
     2847       end.
     2848     end.
     2849   end.
     2850   new-rec = recid (buf-price-list).
     2851   END PROCEDURE.
     2852   procedure calc-price-line-num :
     2853    do
     2854    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2855    :
     2856   define input parameter p-doc-num as character no-undo .
     2857   define output parameter p-num  as integer no-undo .
     2858   define variable v-fact as integer no-undo .
     2859   define buffer buf_1_price-list for ub.price-list .
     2860   p-num = 1 .
     2861   find last  buf_1_price-list no-lock where
     2862              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2863              if available buf_1_price-list then
     2864                   assign
     2865                     v-fact = buf_1_price-list.line-num
     2866                   .
     2867   v-fact = v-fact + 1.
     2868   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2869    end.
     2870   end procedure.
     2871   PROCEDURE del-pr-list:
     2872   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2873   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2874   define input parameter round-method as character         no-undo.
     2875   define input parameter round-base   as decimal      no-undo.
     2876   define buffer buf-price-list for ub.price-list.
     2877   define buffer buf-bar-code   for ub.bar-code.
     2878   define buffer buf-goods      for ub.goods.
     2879   define variable l-ov-on as logical no-undo .
     2880   del-pr:
     2881   do on error undo del-pr, return error:
     2882     find first  buf-price-list no-lock where
     2883                 buf-price-list.doc-num    = d-num and
     2884                 buf-price-list.b-code     = bc and
     2885                 buf-price-list.price-type = "" no-error.
     2886     if not available buf-price-list then
     2887       undo del-pr, return error.
     2888     find  buf-goods no-lock where
     2889           buf-goods.prod-type = buf-price-list.prod-type and
     2890           buf-goods.prod-code = buf-price-list.prod-code and
     2891           buf-goods.artic     = buf-price-list.artic.
     2892     if buf-price-list.main-price then do:
     2893       for each  buf-price-list exclusive-lock where
     2894                 buf-price-list.doc-num   = d-num and
     2895                 buf-price-list.artic     = buf-goods.artic and
     2896                 buf-price-list.prod-type = buf-goods.prod-type and
     2897                 buf-price-list.prod-code = buf-goods.prod-code,
     2898           first buf-bar-code no-lock where
     2899                 buf-bar-code.b-code = buf-price-list.b-code
     2900       on error undo del-pr, return error:
     2901   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2902   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2903     (input  ub.buf-price-list.obj-type
     2904     ,input  ub.buf-price-list.obj-code
     2905     ,input  ub.buf-price-list.artic
     2906     ,input  ub.buf-price-list.prod-type
     2907     ,input  ub.buf-price-list.prod-code
     2908     ,input  'ov-on=request:exclusive'
     2909     ,output l-ov-on
     2910     ) no-error .
     2911         if error-status:error then do:
     2912           message
     2913             vss-workfile vss-revision vss-description skip
     2914             "Ошибка получения признака товара на объекте" skip
     2915             error-status :get-message(1) skip
     2916             return-value skip
     2917             view-as alert-box error .
     2918         end.
     2919         if l-ov-on then do:
     2920   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2922     (input  ub.buf-price-list.obj-type
     2923     ,input  ub.buf-price-list.obj-code
     2924     ,input  ub.buf-price-list.artic
     2925     ,input  ub.buf-price-list.prod-type
     2926     ,input  ub.buf-price-list.prod-code
     2927     ,input  'ov-on=false'
     2928     ,output l-ov-on
     2929     ) no-error .
     2930           if error-status :error then do:
     2931           end.
     2932          end.
     2933         delete buf-price-list.
     2934       end.
     2935     end.
     2936     else do:
     2937       find  buf-bar-code no-lock where
     2938             buf-bar-code.b-code = buf-price-list.b-code.
     2939       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2940         message
     2941           "Нельзя удалить неосновную цену." skip
     2942           "Неосновная цена (скидка) не может быть неопределенной." skip
     2943           "Код:" bc skip
     2944           "Переоценка:" d-num
     2945           view-as alert-box error.
     2946         undo del-pr, return error.
     2947       end.
     2948       find current buf-price-list exclusive-lock no-error .
     2949       delete buf-price-list.
     2950       run calc-base-upd (input buf-bar-code.b-code,
     2951                         input d-num,
     2952                         input round-method,
     2953                         input round-base) no-error.
     2954       if error-status :error then
     2955         undo del-pr, return error.
     2956     end.
     2957   end.
     2958   END PROCEDURE.
     2959   PROCEDURE calc-base-upd:
     2960   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2961   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2962   define input parameter round-method as character         no-undo.
     2963   define input parameter round-base   as decimal      no-undo.
     2964   define buffer alt-bar-code   for ub.bar-code.
     2965   define buffer alt-price-list for ub.price-list.
     2966   define buffer buf-bar-code   for ub.bar-code.
     2967   define buffer buf-goods      for ub.goods.
     2968   calc-base:
     2969   do on error undo calc-base, return error:
     2970     find  buf-bar-code no-lock where
     2971           buf-bar-code.b-code = bc.
     2972     find  buf-goods no-lock where
     2973           buf-goods.gds-code = buf-bar-code.gds-code.
     2974     for each  alt-bar-code no-lock where
     2975               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2976               alt-bar-code.node-code = buf-bar-code.node-code and
     2977               alt-bar-code.part-code = buf-bar-code.part-code and
     2978               alt-bar-code.in-code   = buf-bar-code.in-code and
     2979               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2980         each  alt-price-list where
     2981               alt-price-list.doc-num    = d-num and
     2982               alt-price-list.b-code     = alt-bar-code.b-code and
     2983               alt-price-list.price-type = ""
     2984         on error undo calc-base, return error:
     2985       run calc-pr-alt (input d-num,
     2986                       input alt-bar-code.b-code,
     2987                       input round-method,
     2988                       input round-base) no-error.
     2989       if error-status:error then
     2990         undo calc-base, return error.
     2991     end.
     2992   end.
     2993   END PROCEDURE.
     2994   PROCEDURE calc-pr-alt:
     2995   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2996   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2997   define input parameter r-method as character             no-undo.
     2998   define input parameter r-base   as decimal              no-undo.
     2999   define buffer buf-price-doc  for ub.price-doc.
     3000   define buffer buf-price-list for ub.price-list.
     3001   define buffer buf-bar-code   for ub.bar-code.
     3002   define buffer buf-goods      for ub.goods.
     3003   define buffer old-price-list for ub.price-list.
     3004   define variable pr-rec   as   recid                  no-undo.
     3005   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3006   pr-alt:
     3007   do on error undo pr-alt, return error:
     3008     if r-method = ? or
     3009        r-base = ? then do:
     3010       message
     3011         "Нельзя удалить основную цену." skip
     3012         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     3013         "Код:" bc skip
     3014         "Переоценка:" d-num
     3015         view-as alert-box error.
     3016       undo pr-alt, return error.
     3017     end.
     3018     find  buf-price-doc where
     3019           buf-price-doc.doc-num = d-num.
     3020     find  buf-bar-code no-lock where
     3021           buf-bar-code.b-code = bc.
     3022     find  buf-goods no-lock where
     3023           buf-goods.gds-code = buf-bar-code.gds-code.
     3024     find  buf-price-list where
     3025           buf-price-list.doc-num = buf-price-doc.doc-num and
     3026           buf-price-list.b-code  = bc.
     3027     if buf-price-list.d-pcnt = ? then do:
     3028   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3030     (input  buf-price-doc.obj-type
     3031     ,input  buf-price-doc.obj-code
     3032     ,input  bc
     3033     ,input  0
     3034     ,input  0
     3035     ,output pr-rec
     3036     ,output pr-c-b-r
     3037     )  .
     3038       find old-price-list no-lock where
     3039           recid (old-price-list) = pr-rec no-error.
     3040       if available old-price-list and
     3041         old-price-list.b-code = bc then
     3042         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     3043       else
     3044         buf-price-list.d-pcnt = 0.
     3045     end.
     3046      if buf-price-list.d-pcnt = ? then do:
     3047         assign
     3048           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     3049           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     3050           .
     3051     end.
     3052     else do:
     3053         assign
     3054           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     3055                                         buf-bar-code.cli-base-rate *
     3056                                         (1 - buf-price-list.d-pcnt / 100)
     3057           buf-price-list.calc-method =  'Основная':U
     3058           .
     3059   case r-method :
     3060     when '9-окончание':U then do:
     3061       if buf-price-list.price-sale < 29 then do:
     3062         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     3063           assign
     3064             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     3065           .
     3066         end.
     3067       end.
     3068       else do:
     3069         if (buf-price-list.price-sale modulo 10) < 3 then do:
     3070           assign
     3071             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3072                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3073                   - 1 ) * 10
     3074                 + 9
     3075           .
     3076         end.
     3077         else do:
     3078           assign
     3079             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3080                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3081                   ) * 10
     3082                 + 9
     3083           .
     3084         end.
     3085         assign
     3086           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3087         .
     3088       end.
     3089     end.
     3090     when '9-99окончание':U then do:
     3091       if buf-price-list.price-sale < r-base then do:
     3092         assign
     3093           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     3094         .
     3095       end.
     3096       else do:
     3097         assign
     3098           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     3099         .
     3100       end.
     3101     end.
     3102     when 'Без-дробных':U then do:
     3103       assign
     3104         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3105       .
     3106     end.
     3107     when 'Произвольно':U then do:
     3108       if r-base <> 0 then do:
     3109         assign
     3110           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     3111         .
     3112         if buf-price-list.price-sale = 0 then do:
     3113           assign
     3114             buf-price-list.price-sale = r-base
     3115           .
     3116         end.
     3117       end.
     3118     end.
     3119     when 'Вверх':U then do:
     3120       if r-base <> 0 then do:
     3121         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     3122           assign
     3123             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     3124           .
     3125         end.
     3126       end.
     3127       if buf-price-list.price-sale = 0 then do:
     3128         assign
     3129           buf-price-list.price-sale = r-base
     3130         .
     3131       end.
     3132     end.
     3133     when 'Коэффициент':U then do:
     3134       if r-base <> 0 then do:
     3135         assign
     3136           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     3137         .
     3138       end.
     3139     end.
     3140     when 'Отключено':U then do:
     3141     end.
     3142     otherwise do:
     3143       message
     3144         vss-workfile vss-revision vss-description skip
     3145         "Неизвестный метод округления продажной цены" skip
     3146         "round-method" r-method skip
     3147         "round-base"   r-base   skip
     3148         "price"        buf-price-list.price-sale             skip
     3149         view-as alert-box error .
     3150     end.
     3151   end.
     3152     end.
     3153   end.
     3154   END PROCEDURE.
     3155   PROCEDURE calc-pr-discnt:
     3156   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3157   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3158   define buffer buf-price-doc  for ub.price-doc.
     3159   define buffer buf-price-list for ub.price-list.
     3160   define buffer buf-bar-code   for ub.bar-code.
     3161   define buffer buf-goods      for ub.goods.
     3162   define buffer old-price-list for ub.price-list.
     3163   define variable pr-rec   as   recid                  no-undo.
     3164   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3165   pr-discnt:
     3166   do on error undo pr-discnt, return error:
     3167     find  buf-price-doc where
     3168           buf-price-doc.doc-num = d-num.
     3169     find  buf-bar-code no-lock where
     3170           buf-bar-code.b-code = bc.
     3171     find  buf-goods no-lock where
     3172           buf-goods.gds-code = buf-bar-code.gds-code.
     3173     find  buf-price-list where
     3174           buf-price-list.doc-num = buf-price-doc.doc-num and
     3175           buf-price-list.b-code  = bc.
     3176     buf-price-list.d-pcnt = (1 -
     3177                              buf-price-list.price-sale /
     3178                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3179                              buf-bar-code.cli-base-rate) *
     3180                              100
     3181                              .
     3182   end.
     3183   END PROCEDURE.
     3184   PROCEDURE calc-pr-sub :
     3185   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3186   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3187   define  input  parameter calc-method  as character    no-undo.
     3188   define  input  parameter increase-pc  as decimal      no-undo.
     3189   define  input  parameter round-method as character    no-undo.
     3190   define  input  parameter round-base   as decimal      no-undo.
     3191   define  output parameter calc-rec     as recid        no-undo.
     3192   define  buffer buf-price-list for ub.price-list.
     3193   define  buffer buf-bar-code   for ub.bar-code.
     3194   define  buffer buf-goods      for ub.goods.
     3195   define  buffer buf-gds-prt    for ub.gds-prt.
     3196   define  buffer buf-gds-grp    for ub.gds-grp.
     3197   define  buffer buf-price-doc  for ub.price-doc.
     3198   calc-sub:
     3199   do on error undo calc-sub, return error:
     3200     find  buf-bar-code no-lock where
     3201           buf-bar-code.b-code = bc.
     3202     find  buf-goods no-lock where
     3203           buf-goods.gds-code = buf-bar-code.gds-code.
     3204     find  buf-gds-prt no-lock where
     3205           buf-gds-prt.node-code = buf-bar-code.node-code.
     3206     find  buf-price-list where
     3207           buf-price-list.doc-num    = d-num and
     3208           buf-price-list.b-code     = bc and
     3209           buf-price-list.price-type = "".
     3210     find  buf-price-doc where
     3211           buf-price-doc.doc-num = d-num.
     3212     calc-rec = recid (buf-price-list).
     3213     if buf-price-list.main-price then do:
     3214       for each  buf-price-list where
     3215                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3216                 buf-price-list.main-price = no and
     3217                 buf-price-list.artic      = buf-goods.artic and
     3218                 buf-price-list.prod-type  = buf-goods.prod-type and
     3219                 buf-price-list.prod-code  = buf-goods.prod-code,
     3220           first buf-bar-code no-lock where
     3221                 buf-bar-code.b-code   = buf-price-list.b-code and
     3222                 buf-bar-code.unit-cli = buf-goods.unit-base
     3223           on error undo calc-sub, return error:
     3224         run calc-pr-list (input  buf-bar-code.b-code,
     3225                           input  buf-price-list.doc-num,
     3226                           input  calc-method,
     3227                           input  increase-pc,
     3228                           input  round-method,
     3229                           input  round-base,
     3230                           input ? ,
     3231                           input ? ,
     3232                           input ? ,
     3233                           input ? ,
     3234                           output calc-rec) no-error.
     3235         if error-status :error then
     3236           undo calc-sub, return error.
     3237         calc-rec = recid (buf-price-list).
     3238       end.
     3239       for each  buf-price-list where
     3240                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3241                 buf-price-list.main-price = no and
     3242                 buf-price-list.artic      = buf-goods.artic and
     3243                 buf-price-list.prod-type  = buf-goods.prod-type and
     3244                 buf-price-list.prod-code  = buf-goods.prod-code,
     3245           first buf-bar-code no-lock where
     3246                 buf-bar-code.b-code    = buf-price-list.b-code and
     3247                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3248           on error undo calc-sub, return error:
     3249         run calc-pr-alt (input buf-price-doc.doc-num,
     3250                         input buf-bar-code.b-code,
     3251                         input round-method,
     3252                         input round-base) no-error.
     3253         if error-status :error then
     3254           undo calc-sub, return error.
     3255       end.
     3256     end.
     3257     else do:
     3258       run calc-base-upd (input buf-bar-code.b-code,
     3259                         input buf-price-doc.doc-num,
     3260                         input round-method,
     3261                         input round-base) no-error.
     3262       if error-status :error then
     3263         undo calc-sub, return error.
     3264     end.
     3265   end.
     3266   END PROCEDURE.
     3267   procedure ver-pr-nogds :
     3268   define input  parameter p-gds-code      as integer   no-undo .
     3269   define input  parameter p-par-pr-nogds  as character no-undo .
     3270   define output parameter p-not           as logical   no-undo .
     3271   define output parameter p-str           as character no-undo .
     3272   define buffer buf_goods for ub.goods  .
     3273   define variable nn as integer   no-undo .
     3274   define variable ii as integer   no-undo .
     3275   define variable v-namegrp as character no-undo .
     3276     do
     3277     on error undo, return error return-value
     3278     :
     3279     if p-par-pr-nogds = "1" then do:
     3280        assign
     3281         p-not = true
     3282         p-str = ""
     3283        .
     3284        return .
     3285     end.
     3286     assign
     3287       p-not = false
     3288       p-str = ""
     3289     .
     3290     find first buf_goods no-lock where
     3291                buf_goods.gds-code = p-gds-code no-error .
     3292     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3293     repeat ii = 1 to nn:
     3294        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3295        if buf_goods.grp-name  begins v-namegrp  then do:
     3296           assign
     3297             p-not = true
     3298             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3299           .
     3300           leave .
     3301        end.
     3302     end.
     3303     end.
     3304   end procedure.
     3305   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3306   procedure ver-modificator-price-is-null :
     3307    do
     3308    on error undo, return error return-value
     3309    :
     3310   define input parameter p-artic     like ub.goods.artic no-undo.
     3311   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     3312   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     3313   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     3314   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     3315   define output parameter p-ret as logical no-undo .
     3316   define variable v-gds-code  like ub.goods.gds-code no-undo .
     3317   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3318   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3320     (input  p-artic
     3321     ,input  p-prod-type
     3322     ,input  p-prod-code
     3323     ,output v-gds-code
     3324     )  .
     3325   p-ret = true .
     3326   find first buf_fbr-gds-obj no-lock where
     3327               buf_fbr-gds-obj.gds-code = v-gds-code and
     3328               buf_fbr-gds-obj.obj-code = p-obj-code and
     3329               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
     3330    if available buf_fbr-gds-obj then
     3331                 if buf_fbr-gds-obj.is-modificator = true and
     3332                    buf_fbr-gds-obj.is-null-price = true
     3333                    then  p-ret = false .
     3334    end.
     3335   end procedure.
     3336   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3337   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338   define temp-table tt-level-dis-attr no-undo
     3339         field attr-code   like global-state-attr.attr-code
     3340         field attr-value  like global-state-attr.attr-value
     3341         index pi   attr-value descending
     3342         index pi1 is unique attr-value
     3343               attr-code .
     3344   procedure lvldsc-byattr :
     3345   define input  parameter p-attr-code  as character no-undo .
     3346   define input  parameter p-attr-value as character no-undo .
     3347   define output parameter p-val1       as decimal   no-undo .
     3348   define output parameter p-val2       as decimal   no-undo .
     3349   define output parameter p-prc        as decimal   no-undo .
     3350     do
     3351     on error undo, return error return-value
     3352     :
     3353     define variable v-str1 as character no-undo .
     3354     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     3355     v-str1 = trim ( v-str1 , chr(4) ) .
     3356    run lvldsc-bytt (
     3357         input   v-str1
     3358       , input   p-attr-value
     3359       , output  p-val1
     3360       , output  p-val2
     3361       , output  p-prc )
     3362         no-error .
     3363     end.
     3364   end procedure.
     3365   procedure lvldsc-bytt :
     3366   define input  parameter p-attr-code as character no-undo .
     3367   define input  parameter p-attr-value as character no-undo .
     3368   define output parameter p-val1 as decimal   no-undo .
     3369   define output parameter p-val2 as decimal   no-undo .
     3370   define output parameter p-prc  as decimal   no-undo .
     3371   define variable v-str1 as character no-undo .
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375     assign
     3376        v-str1 = trim ( p-attr-code , "[]()" )
     3377        p-val1 = decimal(entry(1,v-str1, ";"))
     3378        p-val2 = decimal(entry(2,v-str1, ";"))
     3379        p-prc  = decimal(p-attr-value)
     3380        no-error
     3381     .
     3382     end.
     3383   end procedure.
     3384   procedure level-dis-value :
     3385   define input  parameter p-price-prod as decimal   no-undo .
     3386   define input  parameter p-b-code     as integer   no-undo .
     3387   define input  parameter p-obj-type   as character no-undo .
     3388   define input  parameter p-obj-code   as integer   no-undo .
     3389   define output parameter p-prc as decimal   no-undo .
     3390   define variable v-level-dis-attr as character no-undo .
     3391   define variable v-type as character no-undo .
     3392   define variable v-val1 as decimal   no-undo .
     3393   define variable v-val2 as decimal   no-undo .
     3394   define variable v-prc  as decimal   no-undo .
     3395   define variable ix     as integer   no-undo .
     3396   do
     3397    on error undo, return error return-value
     3398    :
     3399   define buffer buf_goods for ub.goods  .
     3400   define buffer buf_bar-code for ub.bar-code  .
     3401   find first buf_bar-code no-lock where
     3402              buf_bar-code.b-code = p-b-code
     3403              no-error .
     3404   find first buf_goods no-lock where
     3405              buf_goods.gds-code = buf_bar-code.gds-code
     3406              no-error .
     3407   run ggoattr-value (
     3408      input   buf_goods.grp-code
     3409     ,input   v-cntxt-host-code-obj
     3410     ,input   p-obj-type
     3411     ,input   p-obj-code
     3412     ,input   'level-dis':U
     3413     ,output  v-level-dis-attr
     3414     ,output  v-type ) no-error .
     3415   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     3416     create
     3417       tt-level-dis-attr
     3418     .
     3419     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3420     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     3421   end.
     3422   p-prc = 0 .
     3423     if p-price-prod = 0 then do:
     3424         for each tt-level-dis-attr no-lock
     3425                 :
     3426               run lvldsc-bytt (
     3427                 input   tt-level-dis-attr.attr-code
     3428               , input   tt-level-dis-attr.attr-value
     3429               , output  v-val1
     3430               , output  v-val2
     3431               , output  v-prc  )
     3432               .
     3433               if v-val1  = 0  then do:
     3434                  p-prc = v-prc .
     3435                 leave.
     3436               end.
     3437         end.
     3438     end.
     3439     else do:
     3440         for each tt-level-dis-attr no-lock
     3441                 :
     3442               run lvldsc-bytt (
     3443                 input   tt-level-dis-attr.attr-code
     3444               , input   tt-level-dis-attr.attr-value
     3445               , output  v-val1
     3446               , output  v-val2
     3447               , output  v-prc  )
     3448               .
     3449               if p-price-prod   > v-val1 and
     3450                  p-price-prod  <= v-val2 then do:
     3451                  p-prc = v-prc .
     3452                 leave.
     3453               end.
     3454         end.
     3455     end.
     3456   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     3457    end.
     3458   end procedure.
     3459   procedure calc-price-levelprod :
     3460   define input  parameter p-mode     as integer   no-undo .
     3461   define input  parameter p-rb       as character no-undo .
     3462   define input  parameter p-b-code   as integer   no-undo .
     3463   define input  parameter p-obj-type as character no-undo .
     3464   define input  parameter p-obj-code as integer   no-undo .
     3465   define output parameter p-price-sale as decimal   no-undo .
     3466   define output parameter p-descript-calc as character no-undo .
     3467   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     3468   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     3469   define variable  v-prod-vat        as decimal   no-undo init 0.
     3470   define variable  v-discnt          as decimal   no-undo init 0.
     3471   define buffer buf_goods for ub.goods  .
     3472   define buffer buf_bar-code for ub.bar-code  .
     3473   define buffer buf_parts for ub.parts  .
     3474   define variable v-part-code as character no-undo .
     3475   define variable v-in-code   as character no-undo .
     3476     do
     3477     on error undo, return error return-value
     3478     :
     3479   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3481   (  input  p-b-code
     3482    , input  p-obj-type
     3483    , input  p-obj-code
     3484    , output v-PriceWithoutVat
     3485    , output v-PriceWithVat
     3486    , output v-prod-vat
     3487    , output v-part-code
     3488    , output v-in-code
     3489           ) no-error .
     3490         if error-status :error then do:
     3491           return error "Нет цены производителя!".
     3492         end.
     3493   find first buf_bar-code no-lock where
     3494              buf_bar-code.b-code = p-b-code
     3495              no-error .
     3496   find first buf_goods no-lock where
     3497              buf_goods.gds-code = buf_bar-code.gds-code
     3498              no-error .
     3499   find first buf_parts no-lock where
     3500              buf_parts.artic      = buf_goods.artic        and
     3501              buf_parts.prod-type  = buf_goods.prod-type    and
     3502              buf_parts.prod-code  = buf_goods.prod-code    and
     3503              buf_parts.in-code    = buf_bar-code.in-code   and
     3504              buf_parts.out-code   = buf_bar-code.in-code   and
     3505              buf_parts.part-code  = buf_bar-code.part-code
     3506              no-error .
     3507               if error-status :error then do:
     3508                   find first buf_parts no-lock where
     3509                             buf_parts.artic      = buf_goods.artic        and
     3510                             buf_parts.prod-type  = buf_goods.prod-type    and
     3511                             buf_parts.prod-code  = buf_goods.prod-code    and
     3512                             buf_parts.in-code    = v-in-code              and
     3513                             buf_parts.out-code   = v-in-code              and
     3514                             buf_parts.part-code  = v-part-code
     3515                             no-error .
     3516                   if error-status :error then do:
     3517                      message
     3518                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     3519                                   v-in-code,
     3520                                   v-part-code ,
     3521                                   buf_goods.artic   ,
     3522                                   buf_goods.prod-type,
     3523                                   buf_goods.prod-code ) .
     3524                      return error "Нет цены производителя !!!".
     3525                   end.
     3526               end.
     3527   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     3528   define variable v-postWithoutVat-rubl as decimal   no-undo .
     3529   define variable v-postWithoutVat-base as decimal   no-undo .
     3530      case p-mode :
     3531       when 1 then do:
     3532          if p-rb = "rubl" then do:
     3533             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     3534          end.
     3535          else do:
     3536             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     3537          end.
     3538       end.
     3539       when 2 then do:
     3540         if p-rb = "rubl" then do:
     3541           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     3542           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     3543         end.
     3544         else do:
     3545           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     3546           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     3547         end.
     3548       end.
     3549      end case.
     3550   p-descript-calc =
     3551     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     3552     buf_goods.gds-name                  +  chr(10) +
     3553     buf_goods.artic +
     3554     buf_goods.prod-type +
     3555     string(buf_goods.prod-code)         + chr(10) +
     3556     "бар-код " +  string(p-b-code)      + chr(10)  +
     3557     'ПН    ' + v-in-code  +
     3558     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     3559     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     3560     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     3561     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     3562     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     3563     chr(10) +
     3564     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     3565     chr(10) +
     3566     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     3567     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     3568     chr(10) +
     3569     string(p-price-sale)                                                               +  chr(10) +
     3570     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     3571     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     3572   .
     3573     end.
     3574   end procedure.
     3575   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3576   PROCEDURE write-bonus :
     3577   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3578   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3579   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3580   define input  parameter v-bonus as decimal   no-undo .
     3581     do
     3582     on error undo, return error return-value
     3583     :
     3584       find first ub.contract-specif-attr exclusive-lock  where
     3585                  ub.contract-specif-attr.contract-num = p-contract-num  and
     3586                  ub.contract-specif-attr.host-code    = p-host-code     and
     3587                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     3588                  ub.contract-specif-attr.attr-code    = 'bonus':U
     3589                 no-error .
     3590         if not available ub.contract-specif-attr then do:
     3591            create ub.contract-specif-attr .
     3592            assign
     3593                 ub.contract-specif-attr.contract-num = p-contract-num
     3594                 ub.contract-specif-attr.host-code    = p-host-code
     3595                 ub.contract-specif-attr.gds-code     = p-gds-code
     3596                 ub.contract-specif-attr.attr-code    = 'bonus':U
     3597            .
     3598         end.
     3599         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     3600   end.
     3601   END PROCEDURE.
     3602   PROCEDURE read-bonus :
     3603   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3604   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3605   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3606   define output parameter v-bonus as decimal   no-undo .
     3607     do
     3608     on error undo, return error return-value
     3609     :
     3610   find first ub.contract-specif-attr no-lock  where
     3611              ub.contract-specif-attr.contract-num = p-contract-num  and
     3612              ub.contract-specif-attr.host-code    = p-host-code     and
     3613              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3614              ub.contract-specif-attr.attr-code    = 'bonus':U
     3615              no-error .
     3616      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     3617                                           else  v-bonus = 0 .
     3618   end.
     3619   END PROCEDURE.
     3620   PROCEDURE write-prc-min :
     3621   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3622   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3623   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3624   define input  parameter v-prc-min        as decimal   no-undo .
     3625     do
     3626     on error undo, return error return-value
     3627     :
     3628       find first ub.contract-specif-attr exclusive-lock  where
     3629                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3630                 ub.contract-specif-attr.host-code    = p-host-code     and
     3631                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3632                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3633                 no-error .
     3634         if not available ub.contract-specif-attr then do:
     3635            create ub.contract-specif-attr .
     3636            assign
     3637                 ub.contract-specif-attr.contract-num = p-contract-num
     3638                 ub.contract-specif-attr.host-code    = p-host-code
     3639                 ub.contract-specif-attr.gds-code     = p-gds-code
     3640                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     3641                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     3642            .
     3643         end.
     3644         else do:
     3645            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     3646         end.
     3647       find first ub.contract-specif exclusive-lock where
     3648           ub.contract-specif.contract-num = p-contract-num and
     3649           ub.contract-specif.host-code    = p-host-code    and
     3650           ub.contract-specif.gds-code     = p-gds-code.
     3651           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3652   end.
     3653   END PROCEDURE.
     3654   PROCEDURE read-prc-min :
     3655   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3656   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3657   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3658   define output parameter v-prc-min as decimal   no-undo .
