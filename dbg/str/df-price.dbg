    17758          .
    17759       run save-tt-line in this-procedure .
    17760       if can-find (first buf_price-doc-forming-gds where
    17761                          buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    17762                          buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    17763                          buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    17764                          buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    17765                          buf_price-doc-forming-gds.price-sale = ? no-lock)
    17766                      then do:
    17767         g#log = no.
    17768         message "В документе есть нерассчитанные строки. Удалить их ?"
    17769         view-as alert-box question buttons yes-no update g#log.
    17770             if g#log then do:
    17771                 for each buf_price-doc-forming-gds no-lock where
    17772                           buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    17773                           buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    17774                           buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    17775                           buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    17776                           buf_price-doc-forming-gds.price-sale = ? :
    17777                         run del-doc-line ( input recid (buf_price-doc-forming-gds)) no-error  .
    17778                         if error-status :error then do:
    17779                             message  vss-workfile vss-revision vss-description skip
    17780                             " Нельзя удалить " buf_price-doc-forming-gds.b-code skip
    17781                             error-status :get-message(1) .
    17782                         end.
    17783                   end.
    17784             end.
    17785     end.
    17786       run ver-dfc-mpl-lib3 in this-procedure ( recid (buf_price-doc-forming) ) no-error  .
    17787       if error-status :error and return-value <> "no-records":U then do:
    17788          message
    17789          return-value
    17790          skip
    17791          "Документ нельзя записать в БД, удалить его ? "  view-as alert-box question
    17792          buttons yes-no
    17793          update v-ok1 as logical
    17794          .
    17795          error-status :error = false .
    17796          if v-ok1 = true then  do:
    17797             delete buf_price-doc-forming .
    17798          end.
    17799       end.
    17800       if return-value = "no-records":U then do:
    17801          message "В документе нет ни одной строки , удалить ?" view-as alert-box question
    17802          buttons yes-no
    17803          update v-ok as logical
    17804          .
    17805          if v-ok = true then  do:
    17806             delete buf_price-doc-forming .
    17807          end.
    17808       end.
    17809       else do:
    17810          if error-status :error then return error SUBSTITUTE("- &1  &2" , return-value , error-status :get-message(1)) .
    17811       end.
    17812     define variable p-err as logical   no-undo .
    17813     if available buf_price-doc-forming then do:
    17814       if doc-code <> "" and par-pr-discm = 'sale-' then do:
    17815         buf_price-doc-forming.out-code = doc-code .
    17816       end.
    17817       run save-header.
    17818         run ver-pr-discnS in this-procedure (
    17819           input buf_price-doc-forming.plt-id   ,
    17820           input buf_price-doc-forming.plt-db-num ,
    17821           input buf_price-doc-forming.pdf-id ,
    17822           input buf_price-doc-forming.pdf-db ,
    17823           input "",
    17824           input buf_price-doc-forming.out-code ,
    17825           output p-err )
    17826             no-error .
    17827             if error-status :error then do:
    17828                 message "Ошибка при проверке процента наценки!" skip
    17829                 "Остаться в документе для исправления строки ?" skip
    17830                 view-as alert-box question
    17831                 buttons yes-no
    17832                 Title "Внимание !!!"
    17833                 update v-qqq as logical
    17834                   .
    17835             if v-qqq then p-err = true .
    17836             else p-err = false .
    17837           if p-err then return error return-value .
    17838        end.
    17839     end.
    17840   END PROCEDURE.
