     9761   FUNCTION mark-string RETURNS CHARACTER
     9762     ( input p-recid as recid, input mark-list as character  ) :
     9763     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     9764   END FUNCTION.
