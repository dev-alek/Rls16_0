    15271    assign
    15272      buf_price-doc-forming-gds.road-tax-doc :label  = dor-nal + " в.д."
    15273      buf_price-doc-forming-gds.road-tax-rubl :label = dor-nal + " руб"
    15274      buf_price-doc-forming-gds.road-tax-base :label = dor-nal + " б.в."
    15275      .
    15276   p-next-prev = yes.
    15277   n-p: do while p-next-prev :
    15278   MAIN-BLOCK:
    15279   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    15280      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
    15281     run init-proc in this-procedure .
    15282     run enable_ui in this-procedure .
    15283     if p-mode = 'ПРОСМОТР':U then do:
    15284         run my_lookup in this-procedure .
    15285         run OpenBr in this-procedure (yes, no, '':U).
    15286         if  p-recid-gds <> ? then do:
    15287             reposition BROWSE-1 to recid p-recid-gds no-error .
    15288         end.
    15289     end.
    15290     else do:
    15291       run my_enable in this-procedure .
    15292       run Open1 .
    15293     end.
    15294     if par-is-pharm = "yes" then do:
    15295         display
    15296           v-ost
    15297           v-prod-price
    15298           v-new-price-vat
    15299           v-prod-price-prc
    15300           v-priceprodwithvat-2
    15301           v-prod-price-prc-2
    15302           v-prod-price-prc-3
    15303           doc-code
    15304         with frame Dialog-Frame no-error .
    15305         enable doc-code with frame Dialog-Frame .
    15306     end.
    15307     else do :
    15308       hide
    15309           v-ost
    15310           v-prod-price
    15311           v-new-price-vat
    15312           v-prod-price-prc
    15313           v-priceprodwithvat-2
    15314           v-prod-price-prc-2
    15315           v-prod-price-prc-3
    15316         in frame Dialog-Frame  .
    15317       display
    15318         v-free-qnty
    15319         v-fact-qnty
    15320         v-in-doc-qnty
    15321       with frame Dialog-Frame no-error .
    15322     end.
    15323     a-n-c = "art" .
    15324     apply "value-change" to a-n-c in frame Dialog-Frame .
    15325     display a-n-c with frame Dialog-Frame .
    15326     if p-mode <> 'ПРОСМОТР':U then do:
    15327       run select-header .
    15328       display calc-method with frame Dialog-Frame.
    15329     end.
    15330     wait-for go of frame Dialog-Frame focus BROWSE-1  .
    15331   end.
    15332   end.
    15333   run disable_UI in this-procedure .
    15334   PROCEDURE add-spec :
    15335   define variable num-rec as integer   no-undo .
    15336   define variable recid-list as character no-undo .
    15337   define variable v-price-calc-base as decimal   no-undo .
    15338   define variable v-price-calc-doc  as decimal   no-undo .
    15339   define variable v-price-calc-rubl as decimal   no-undo .
    15340   define variable v-price-prev-base as decimal   no-undo .
    15341   define variable v-price-prev-doc  as decimal   no-undo .
    15342   define variable v-price-prev-rubl as decimal   no-undo .
    15343   define variable v-price-sale-base as decimal   no-undo .
    15344   define variable v-price-sale-doc  as decimal   no-undo .
    15345   define variable v-price-sale-rubl as decimal   no-undo .
    15346   define variable v-road-tax-base   as decimal   no-undo .
    15347   define variable v-road-tax-doc    as decimal   no-undo .
    15348   define variable v-road-tax-rubl   as decimal   no-undo .
    15349   define variable v-excise-base     as decimal   no-undo .
    15350   define variable v-excise-doc      as decimal   no-undo .
    15351   define variable v-excise-rubl     as decimal   no-undo .
    15352   define variable v-vat-pc          as decimal   no-undo .
    15353   define variable v-slt-pc          as decimal   no-undo .
    15354   define variable v-prev-doc-code   as character no-undo .
    15355   define buffer buf_scl_bar-code for ub.bar-code  .
    15356    if par-is-pharm = "yes" then do:
    15357     run ref/bas-cds.w
    15358        ( parParentProc,
    15359          v-last-obj-type,
    15360          v-last-obj-code,
    15361          "par-gds-free",
    15362          buf_bar-code.gds-code,
    15363          output recid-list
    15364          ) .
    15365    end.
    15366    else do:
    15367     run ref/bas-cds.w
    15368        ( parParentProc,
    15369          v-last-obj-type,
    15370          v-last-obj-code,
    15371          "scl-gds-all",
    15372          buf_bar-code.gds-code,
    15373          output recid-list
    15374          ) .
    15375    end.
    15376     run last-num in this-procedure (input recid(buf_price-doc-forming) , output v-line-num ) .
    15377     define variable v-nn as integer   no-undo .
    15378     define variable v-d-pcnt as decimal   no-undo .
    15379     v-nn = num-entries (recid-list).
    15380     do num-rec = 1 to v-nn:
    15381       find first buf_scl_bar-code no-lock where
    15382           recid (buf_scl_bar-code) = integer (entry (num-rec, recid-list)) no-error .
    15383       if available buf_scl_bar-code  and
    15384          ( par-is-pharm = "yes"  or  ( buf_scl_bar-code.part-code = "" and  buf_scl_bar-code.in-code = "" ))
    15385       then do:
    15386           v-line-num = v-line-num + 1.
    15387           run calc-price-line  in this-procedure (
    15388             input  calc-method
    15389           , input  increase-pc
    15390           , input  round-method
    15391           , input  round-base
    15392           , input  buf_scl_bar-code.b-code
    15393           , input  buf_goods.gds-code
    15394           , input  buf_goods.artic
    15395           , input  buf_goods.prod-type
    15396           , input  buf_goods.prod-code
    15397           , input  v-base-rate
    15398           , input  v-base-scale
    15399           , input  v-exch-scale
    15400           , input  v-exch-rate
    15401           , input  doc-code
    15402           , input  common-price
    15403           , input  copy-type
    15404           , input  copy-code
    15405           , output p-new-calc-method
    15406           , output v-price-calc-base
    15407           , output v-price-calc-doc
    15408           , output v-price-calc-rubl
    15409           , output v-price-prev-base
    15410           , output v-price-prev-doc
    15411           , output v-price-prev-rubl
    15412           , output v-price-sale-base
    15413           , output v-price-sale-doc
    15414           , output v-price-sale-rubl
    15415           , output v-road-tax-base
    15416           , output v-road-tax-doc
    15417           , output v-road-tax-rubl
    15418           , output v-excise-base
    15419           , output v-excise-doc
    15420           , output v-excise-rubl
    15421           , output v-vat-pc
    15422           , output v-slt-pc
    15423           , output v-prev-doc-code
    15424           , output v-d-pcnt
    15425           ).
    15426           run create-line  in this-procedure (
    15427              buf_price-doc-forming.plt-db-num
    15428             ,buf_price-doc-forming.plt-id
    15429             ,buf_price-doc-forming.pdf-db
    15430             ,buf_price-doc-forming.pdf-id
    15431             ,v-line-num
    15432             ,buf_scl_bar-code.b-code
    15433             ,buf_goods.artic
    15434             ,buf_goods.prod-type
    15435             ,buf_goods.prod-code
    15436             ,p-new-calc-method
    15437             ,v-d-pcnt
    15438             ,FILL-IN_have-start-period
    15439             ,FILL-IN_start-date
    15440             ,FILL-IN_start-shift-date
    15441             ,FILL-IN_start-shift-name
    15442             ,FILL-IN_start-shift-num
    15443             ,FILL-IN_start-sys-date
    15444             ,( l-loc-hour * 60 * 60 )  + ( l-loc-min * 60 )
    15445             ,FILL-IN_have-end-period
    15446             ,FILL-IN_end-date
    15447             ,FILL-IN_end-shift-date
    15448             ,FILL-IN_end-shift-name
    15449             ,FILL-IN_end-shift-num
    15450             ,FILL-IN_end-sys-date
    15451             , ( l-loc-hour-2 * 60 * 60 )  + ( l-loc-min-2 * 60 )
    15452             ,v-price-calc-base
    15453             ,v-price-calc-doc
    15454             ,v-price-calc-rubl
    15455             ,v-price-prev-base
    15456             ,v-price-prev-doc
    15457             ,v-price-prev-rubl
    15458             ,v-price-sale-base
    15459             ,v-price-sale-doc
    15460             ,v-price-sale-rubl
    15461             ,v-road-tax-base
    15462             ,v-road-tax-doc
    15463             ,v-road-tax-rubl
    15464             ,v-excise-base
    15465             ,v-excise-doc
    15466             ,v-excise-rubl
    15467             ,v-vat-pc
    15468             ,v-slt-pc
    15469             ,v-prev-doc-code
    15470             ,0
    15471             ,input-output v-sec
    15472             ) no-error .
    15473             if error-status :error then
    15474             message
    15475               vss-workfile vss-revision vss-description skip
    15476               error-status :get-message(1) skip
    15477               return-value skip
    15478               "bbbb"
    15479               view-as alert-box error
    15480             .
    15481             find first buf_price-doc-forming-gds no-lock  where
    15482                       buf_price-doc-forming-gds.plt-db-num  =  buf_price-doc-forming.plt-db-num and
    15483                       buf_price-doc-forming-gds.plt-id      =  buf_price-doc-forming.plt-id     and
    15484                       buf_price-doc-forming-gds.pdf-db      =  buf_price-doc-forming.pdf-db     and
    15485                       buf_price-doc-forming-gds.pdf-id      =  buf_price-doc-forming.pdf-id     and
    15486                       buf_price-doc-forming-gds.b-code      =  buf_scl_bar-code.b-code
    15487                       no-error .
    15488             run make-xxx-line in this-procedure .
    15489             run calc-price-sub in this-procedure
    15490                 (input  buf_scl_bar-code.b-code ,
    15491                 input  recid ( buf_price-doc-forming ) ,
    15492                 input  calc-method,
    15493                 input  increase-pc,
    15494                 input  round-method,
    15495                 input  round-base,
    15496                 input  doc-code,
    15497                 input  common-price,
    15498                 input  copy-type,
    15499                 input  copy-code,
    15500                 output calc-rec) no-error.
    15501              if error-status :error then
    15502              message
    15503                vss-workfile vss-revision vss-description skip
    15504                error-status :get-message(1) skip
    15505                return-value skip
    15506                "calc-price-sub"
    15507                view-as alert-box error
    15508              .
    15509         end.
    15510     end.
    15511   END PROCEDURE.
    15512   PROCEDURE del-doc-line1 :
    15513   define input  parameter p-recid  as recid no-undo .
    15514   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
    15515   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
    15516   define buffer b-gds-prt for ub.gds-prt.
    15517   define buffer buf_bar-code for ub.bar-code  .
    15518   define variable v-artic     as character no-undo .
    15519   define variable v-prod-type as character no-undo .
    15520   define variable v-prod-code as integer   no-undo .
    15521   find first buf_price-doc-forming-gds exclusive-lock where
    15522              recid(buf_price-doc-forming-gds)  = p-recid no-error .
    15523   find first buf_bar-code no-lock  where
    15524              buf_bar-code.b-code  = buf_price-doc-forming-gds.b-code no-error .
    15525   find first buf_goods no-lock  where
    15526              buf_goods.gds-code = buf_bar-code.gds-code no-error .
    15527   if not available buf_price-doc-forming-gds then return.
    15528     assign
    15529       v-artic      = buf_price-doc-forming-gds.artic
    15530       v-prod-type  = buf_price-doc-forming-gds.prod-type
    15531       v-prod-code  = buf_price-doc-forming-gds.prod-code
    15532     .
    15533   find first b-gds-prt no-lock where b-gds-prt.node-code = buf_bar-code.node-code no-error .
    15534       if b-gds-prt.upper-code = buf_goods.prt-root and
    15535          buf_goods.unit-base = buf_bar-code.unit-cli and
    15536          buf_bar-code.in-code = ""     then  do:
    15537           for each buf2_price-doc-forming-gds exclusive-lock  where
    15538                 buf2_price-doc-forming-gds.pdf-db     = buf_price-doc-forming-gds.pdf-db  and
    15539                 buf2_price-doc-forming-gds.pdf-id     = buf_price-doc-forming-gds.pdf-id  and
    15540                 buf2_price-doc-forming-gds.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
    15541                 buf2_price-doc-forming-gds.plt-id     = buf_price-doc-forming-gds.plt-id and
    15542                 buf2_price-doc-forming-gds.artic      =  v-artic     and
    15543                 buf2_price-doc-forming-gds.prod-type  =  v-prod-type and
    15544                 buf2_price-doc-forming-gds.prod-code  =  v-prod-code  :
    15545             for each tt_price-doc-forming-gds-xxx  where
    15546                   tt_price-doc-forming-gds-xxx.b-code      = buf2_price-doc-forming-gds.b-code     and
    15547                   tt_price-doc-forming-gds-xxx.pdf-db      = buf2_price-doc-forming-gds.pdf-db     and
    15548                   tt_price-doc-forming-gds-xxx.pdf-id      = buf2_price-doc-forming-gds.pdf-id     and
    15549                   tt_price-doc-forming-gds-xxx.plt-db-num  = buf2_price-doc-forming-gds.plt-db-num and
    15550                   tt_price-doc-forming-gds-xxx.plt-id      = buf2_price-doc-forming-gds.plt-id
    15551                   :
    15552                   delete tt_price-doc-forming-gds-xxx .
    15553             end.
    15554             delete buf2_price-doc-forming-gds .
    15555          end.
    15556       end.
    15557       else do:
    15558          for each buf2_price-doc-forming-gds exclusive-lock  where
    15559              recid(buf2_price-doc-forming-gds) = recid (buf_price-doc-forming-gds) :
    15560                   for each tt_price-doc-forming-gds-xxx  where
    15561                         tt_price-doc-forming-gds-xxx.b-code      = buf2_price-doc-forming-gds.b-code     and
    15562                         tt_price-doc-forming-gds-xxx.pdf-db      = buf2_price-doc-forming-gds.pdf-db     and
    15563                         tt_price-doc-forming-gds-xxx.pdf-id      = buf2_price-doc-forming-gds.pdf-id     and
    15564                         tt_price-doc-forming-gds-xxx.plt-db-num  = buf2_price-doc-forming-gds.plt-db-num and
    15565                         tt_price-doc-forming-gds-xxx.plt-id      = buf2_price-doc-forming-gds.plt-id
    15566                         :
    15567                         delete tt_price-doc-forming-gds-xxx .
    15568                   end.
    15569              delete buf2_price-doc-forming-gds .
    15570          end.
    15571       end.
    15572   END PROCEDURE.
    15573   PROCEDURE disable_UI :
    15574     HIDE FRAME Dialog-Frame.
    15575   END PROCEDURE.
    15576   PROCEDURE enable_UI :
    15577     DISPLAY calc-method increase-pc round-method round-base FILL-IN_base-rate
    15578             FILL-IN_base-scale FILL-IN_have-start-period l-loc-hour l-loc-min
    15579             R-mode-code FILL-IN_exch-rate FILL-IN_exch-scale
    15580             FILL-IN_have-end-period l-loc-hour-2 l-loc-min-2 a-n-c loc-art
    15581             FILL-IN_name v-curr-abbr-bv v-curr-abbr-vd p-calc-metod p-old p-new
    15582             p-pc-prev p-pr-doc-old p-op-pr-doc-old p-pc-pr-doc-old
    15583             p-pc-op-pr-doc-old p-avrg p-op-avrg p-pc-avrg p-pc-op-avrg p-last
    15584             p-op-last p-pc-last p-pc-op-last prev-price_doc-num v-ost obj-in-code
    15585             v-new-price-vat obj-in-date v-prod-price-prc v-prod-price
    15586             v-prod-price-prc-2 v-priceprodwithvat-2 v-prod-price-prc-3
    15587         WITH FRAME Dialog-Frame.
    15588     ENABLE b-exit b-prev b-next b-mark b-sel-all b-unmark b-add b-del b-chg
    15589            b-special b-obj b-grp b-cust b-notes B-import B-history b-help
    15590            calc-method increase-pc round-method round-base FILL-IN_base-rate
    15591            FILL-IN_base-scale FILL-IN_have-start-period l-loc-hour l-loc-min
    15592            R-mode-code b-log-2 b-log b-type-price FILL-IN_exch-rate
    15593            FILL-IN_exch-scale FILL-IN_have-end-period l-loc-hour-2 l-loc-min-2
    15594            BROWSE-1 BROWSE-2 a-n-c loc-art loc-name loc-code FILL-IN_name
    15595            v-curr-abbr-bv v-curr-abbr-vd p-calc-metod p-old p-new p-pc-prev
    15596            p-pr-doc-old p-op-pr-doc-old p-pc-pr-doc-old p-pc-op-pr-doc-old p-avrg
    15597            p-op-avrg p-pc-avrg p-pc-op-avrg p-last p-op-last p-pc-last
    15598            p-pc-op-last prev-price_doc-num v-ost obj-in-code v-new-price-vat
    15599            obj-in-date v-prod-price-prc v-prod-price v-prod-price-prc-2
    15600            v-priceprodwithvat-2 v-prod-price-prc-3
    15601         WITH FRAME Dialog-Frame.
    15602     VIEW FRAME Dialog-Frame.
    15603     OPEN QUERY BROWSE-1 FOR EACH buf_price-doc-forming-gds OF buf_price-doc-forming NO-LOCK,              EACH buf_goods OF buf_price-doc-forming-gds NO-LOCK,              EACH buf_bar-code OF buf_price-doc-forming-gds NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-2 FOR EACH tt_price-doc-forming-gds-xxx OF                                  buf_price-doc-forming-gds NO-LOCK INDEXED-REPOSITION.
    15604   END PROCEDURE.
    15605   PROCEDURE get-gds-rec :
    15606   define buffer buf_goods for ub.goods  .
    15607     do
    15608     on error undo, return error return-value
    15609     :
    15610      gds-rec = ? .
    15611      if not available buf_price-doc-forming-gds then return.
    15612         find first buf_goods no-lock where
    15613                    buf_goods.artic     = buf_price-doc-forming-gds.artic     and
    15614                    buf_goods.prod-type = buf_price-doc-forming-gds.prod-type and
    15615                    buf_goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
    15616         if available buf_goods then gds-rec = recid(buf_goods).
    15617     end.
    15618   end procedure.
    15619   PROCEDURE import-proc :
    15620   define input  parameter p-mode as character no-undo .
    15621   define variable l-ok     as logical   no-undo .
    15622   define variable imp-save as integer   no-undo .
    15623   define variable v-file-name as char no-undo.
    15624   define variable i1 as integer no-undo.
    15625   define variable impc as integer   no-undo .
    15626   define variable s  as character no-undo.
    15627   define variable owner   as character no-undo INITIAL "".
    15628   define variable v-price like ub.price-list.price-sale no-undo.
    15629   define variable v-bar-code as integer no-undo.
    15630   define variable main-b-code  as integer   no-undo .
    15631   define variable v-doc-num    like ub.price-list.doc-num    no-undo .
    15632   define variable v-price-sale like ub.price-list.price-sale no-undo .
    15633   define variable v-road-tax   like ub.price-list.road-tax   no-undo .
    15634   define variable v-excise     like ub.price-list.excise     no-undo .
    15635   define buffer main_price-doc-forming-gds for ub.price-doc-forming-gds  .
    15636   define buffer buf_gds-obj for ub.gds-obj  .
    15637   define buffer bf_bar-code for ub.bar-code  .
    15638   if p-mode = "txt"
    15639       then do:
    15640         v-str = "Проводить импорт из текстового файла  формата:     бар-код;цена    ? ".
    15641       end.
    15642       else do:
    15643         v-str = "Проводить импорт из списка кодов ?".
    15644       end.
    15645     l-ok = true .
    15646     message v-str
    15647       view-as alert-box question
    15648       buttons yes-no
    15649       update l-ok .
    15650     if l-ok = false then return.
    15651     system-dialog get-file v-file-name
    15652     title "Выберите файл для заполнения переоценки"
    15653     filters "Текстовый файл (*.csv)"   "*.csv" ,
    15654             "Текстовый файл (*.txt)"   "*.txt" ,
    15655             "Список кодов   (*.bb)"    "*.bb" ,
    15656             "Все файлы" "*.*"
    15657              update l-ok.
    15658     if not l-ok then return.
    15659     input stream imp from value ( v-file-name ) .
    15660    repeat :
    15661        s = "".
    15662        import stream imp unformatted s NO-ERROR.
    15663        if error-status :error then do:
    15664        message
    15665          vss-workfile vss-revision vss-description skip
    15666          error-status :get-message(1) skip
    15667          return-value skip
    15668          ""
    15669          view-as alert-box error
    15670        .
    15671        end.
    15672        assign
    15673         impc   = impc + 1
    15674         i1 = i1 + 1
    15675         s = trim (s)
    15676        .
    15677        if s = "" then leave.
    15678    if p-mode = "txt" then do:
    15679        assign
    15680         v-price = decimal ( replace (entry (2, s, ";") ,"," , ".") )
    15681         v-bar-code = integer(entry (1, s, ";"))
    15682        no-error.
    15683    end.
    15684    if p-mode = "bb" then do:
    15685       v-bar-code = integer(entry (1, s, " ")) no-error.
    15686   define variable vss-include-info128 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    15688     (input  v-cntxt-obj-type
    15689     ,input  v-cntxt-obj-code
    15690     ,input  v-bar-code
    15691     ,input  0
    15692     ,input  0
    15693     ,output v-doc-num
    15694     ,output v-price
    15695     ,output v-road-tax
    15696     ,output v-excise
    15697     ) no-error .
    15698    end.
    15699        if v-price <= 0 or v-price = ? then next.
    15700        if v-bar-code <= 0 or v-bar-code = ? then next.
    15701     display
    15702     impc  label "Прочитано"
    15703     i1    label "Сохранено"
    15704     v-bar-code format ">>>>>>>>>9" label "Bar-code"
    15705     with frame ff view-as dialog-box
    15706     title substitute(": Импорт товаров из файла в ДНЦ"  ) .
    15707     pause 0.
    15708        find first bf_bar-code where bf_bar-code.b-code = v-bar-code
    15709        no-lock no-error.
    15710        if not available bf_bar-code then do:
    15711               message "Отсутствует БК для товара с bar-code:" v-bar-code .
    15712               next.
    15713        end.
    15714        find first buf_goods where buf_goods.gds-code = bf_bar-code.gds-code  no-lock no-error.
    15715        if not available buf_goods then do:
    15716               message "Отсутствует товар с gds-code:" bf_bar-code.gds-code .
    15717               next.
    15718        end.
    15719   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    15720     (input  buf_goods.gds-code
    15721     ,input  ?
    15722     ,output main-b-code
    15723     )  .
    15724         find first buf_price-doc-forming-gds exclusive-lock where
    15725                    buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
    15726               and  buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
    15727               and  buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
    15728               and  buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db
    15729               and  buf_price-doc-forming-gds.b-code     = bf_bar-code.b-code no-error .
    15730         if available buf_price-doc-forming-gds then do:
    15731           delete buf_price-doc-forming-gds.
    15732         end.
    15733         imp-save = imp-save + 1 .
    15734         if buf_goods.unit-base = bf_bar-code.unit-cli then do:
    15735             find first buf_price-doc-forming-gds exclusive-lock where
    15736                        buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
    15737                   and  buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
    15738                   and  buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
    15739                   and  buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db
    15740                   and  buf_price-doc-forming-gds.b-code     = main-b-code no-error .
    15741             if not available buf_price-doc-forming-gds then do:
    15742             run prcreate-new-price-doc-forming-gds in this-procedure (
    15743                 input recid ( buf_price-doc-forming )
    15744               , input v-cntxt-obj-type
    15745               , input v-cntxt-obj-code
    15746               , input par-pr-notls
    15747               , input par-pr-altex
    15748               , input par-pr-sclex
    15749               , input imp-save
    15750               , input buf_goods.gds-code
    15751               , input v-price
    15752               ) no-error.
    15753               if error-status :error then do:
    15754               message
    15755                 vss-workfile vss-revision vss-description skip
    15756                 error-status :get-message(1) skip
    15757                 return-value skip
    15758                 ""
    15759                 view-as alert-box error
    15760               .
    15761               end.
    15762               end.
    15763               if main-b-code  <>  bf_bar-code.b-code then do:
    15764                   find first buf_price-doc-forming-gds exclusive-lock where
    15765                             buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
    15766                             buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
    15767                             buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
    15768                             buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      and
    15769                             buf_price-doc-forming-gds.b-code     = bf_bar-code.b-code no-error .
    15770                   if available buf_price-doc-forming-gds then do:
    15771                     delete buf_price-doc-forming-gds .
    15772                   end.
    15773                   assign
    15774                     imp-save = imp-save + 1
    15775                     v-sec =  v-sec + 1
    15776                   .
    15777                     run create-line-pdf-mpl-lib (
    15778                         input buf_price-doc-forming.plt-db-num
    15779                         ,input buf_price-doc-forming.plt-id
    15780                         ,input buf_price-doc-forming.pdf-db
    15781                         ,input buf_price-doc-forming.pdf-id
    15782                         ,input imp-save
    15783                         ,input bf_bar-code.b-code
    15784                         ,input buf_goods.artic
    15785                         ,input buf_goods.prod-type
    15786                         ,input buf_goods.prod-code
    15787                         ,input ""
    15788                         ,input 0
    15789                         ,input v-price
    15790                         ,input ""
    15791                         ,input 0
    15792                         ,input-output v-sec ) no-error .
    15793               end.
    15794           end.
    15795           else do:
    15796           find first main_price-doc-forming-gds no-lock where
    15797                      main_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
    15798                      main_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
    15799                      main_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
    15800                      main_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      and
    15801                      main_price-doc-forming-gds.b-code     = main-b-code no-error .
    15802           if not available main_price-doc-forming-gds then do:
    15803           find first buf_gds-obj no-lock where
    15804                      buf_gds-obj.obj-type = v-cntxt-obj-type  and
    15805                      buf_gds-obj.obj-code = v-cntxt-obj-code  and
    15806                      buf_gds-obj.gds-code = buf_goods.gds-code     no-error .
    15807           run prcreate-new-price-doc-forming-gds in this-procedure (
    15808               input recid ( buf_price-doc-forming )
    15809             , input v-cntxt-obj-type
    15810             , input v-cntxt-obj-code
    15811             , input par-pr-notls
    15812             , input par-pr-altex
    15813             , input par-pr-sclex
    15814             , input imp-save
    15815             , input buf_goods.gds-code
    15816             , input ( if available buf_gds-obj and buf_gds-obj.price-sale <> 0 then buf_gds-obj.price-sale else v-price / bf_bar-code.cli-base-rate )
    15817             ) no-error.
    15818             if error-status :error then do:
    15819                message
