    12086   ON CURSOR-DOWN OF l-loc-hour IN FRAME Dialog-Frame
    12087   DO:
    12088     assign  frame Dialog-Frame l-loc-hour .
    12089     l-loc-hour = l-loc-hour -  1.
    12090     if l-loc-hour < 0 then return no-apply.
    12091     display l-loc-hour with frame Dialog-Frame.
    12092   END.
    12093   ON CURSOR-UP OF l-loc-hour IN FRAME Dialog-Frame
    12094   DO:
    12095     assign  frame Dialog-Frame l-loc-hour .
    12096     l-loc-hour = l-loc-hour +  1.
    12097     if l-loc-hour > 24 then return no-apply.
    12098     display l-loc-hour with frame Dialog-Frame.
    12099   END.
    12100   ON LEAVE OF l-loc-hour IN FRAME Dialog-Frame
    12101   DO:
    12102       assign frame Dialog-Frame l-loc-hour .
    12103      if l-loc-hour > 24 then do:
    12104      message "Часы должны быть   до 24 ! " .
    12105      return no-apply.
    12106      end.
    12107       if l-loc-hour < 0 then do:
    12108      message "Часы должны быть  от 0 до 24 ! " .
    12109      return no-apply.
    12110      end.
    12111   END.
    12112   ON CURSOR-DOWN OF l-loc-hour-2 IN FRAME Dialog-Frame
    12113   DO:
    12114     assign  frame Dialog-Frame l-loc-hour-2 .
    12115     l-loc-hour-2 = l-loc-hour-2 -  1.
    12116     if l-loc-hour-2 < 0 then return no-apply.
    12117     display l-loc-hour-2 with frame Dialog-Frame.
    12118   END.
    12119   ON CURSOR-UP OF l-loc-hour-2 IN FRAME Dialog-Frame
    12120   DO:
    12121     assign  frame Dialog-Frame l-loc-hour-2 .
    12122     l-loc-hour-2 = l-loc-hour-2 +  1.
    12123     if l-loc-hour-2 > 24 then return no-apply.
    12124     display l-loc-hour-2 with frame Dialog-Frame.
    12125   END.
    12126   ON LEAVE OF l-loc-hour-2 IN FRAME Dialog-Frame
    12127   DO:
    12128       assign frame Dialog-Frame l-loc-hour-2 .
    12129      if l-loc-hour-2 > 24 then do:
    12130      message "Часы должны быть   до 24 ! " .
    12131      return no-apply.
    12132      end.
    12133       if l-loc-hour-2 < 0 then do:
    12134      message "Часы должны быть  от 0 до 24 ! " .
    12135      return no-apply.
    12136      end.
    12137   END.
    12138   ON CURSOR-DOWN OF l-loc-min IN FRAME Dialog-Frame
    12139   DO:
    12140     assign  frame Dialog-Frame l-loc-min .
    12141     l-loc-min = l-loc-min -  1.
    12142     if l-loc-min < 0 then return no-apply.
    12143     display l-loc-min with frame Dialog-Frame.
    12144   END.
    12145   ON CURSOR-UP OF l-loc-min IN FRAME Dialog-Frame
    12146   DO:
    12147      assign  frame Dialog-Frame l-loc-min .
    12148     l-loc-min = l-loc-min +  1.
    12149     if l-loc-min > 59 then return no-apply.
    12150     display l-loc-min with frame Dialog-Frame.
    12151   END.
    12152   ON LEAVE OF l-loc-min IN FRAME Dialog-Frame
    12153   DO:
    12154      assign frame Dialog-Frame l-loc-min .
    12155      if l-loc-min > 59 then do:
    12156      message "Минуты должны быть  от 0 до 59 ! " .
    12157      return no-apply.
    12158      end.
    12159   END.
    12160   ON CURSOR-DOWN OF l-loc-min-2 IN FRAME Dialog-Frame
    12161   DO:
    12162     assign  frame Dialog-Frame l-loc-min-2 .
    12163     l-loc-min-2 = l-loc-min-2 -  1.
    12164     if l-loc-min-2 < 0 then return no-apply.
    12165     display l-loc-min-2 with frame Dialog-Frame.
    12166   END.
    12167   ON CURSOR-UP OF l-loc-min-2 IN FRAME Dialog-Frame
    12168   DO:
    12169      assign  frame Dialog-Frame l-loc-min-2 .
    12170     l-loc-min-2 = l-loc-min-2 +  1.
    12171     if l-loc-min-2 > 59 then return no-apply.
    12172     display l-loc-min-2 with frame Dialog-Frame.
    12173   END.
    12174   ON LEAVE OF l-loc-min-2 IN FRAME Dialog-Frame
    12175   DO:
    12176      assign frame Dialog-Frame l-loc-min-2 .
    12177      if l-loc-min-2 > 59 then do:
    12178      message "Минуты должны быть  от 0 до 59 ! " .
    12179      return no-apply.
    12180      end.
    12181   END.
    12182   ON LEAVE OF loc-art IN FRAME Dialog-Frame
    12183   DO:
    12184   END.
    12185   ON CTRL-J OF loc-art IN FRAME Dialog-Frame
    12186   do:
    12187     assign loc-art .
    12188     run seach-artic in this-procedure ( loc-art , true  ) no-error .
