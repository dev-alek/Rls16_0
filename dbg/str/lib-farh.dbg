      855   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856   if valid-handle (g#lib-farh)
      857   and g#lib-farh <> this-procedure :handle
      858   and g#lib-farh :get-signature('lib-farh_crfdsclk':u) <> ""
      859   then do:
