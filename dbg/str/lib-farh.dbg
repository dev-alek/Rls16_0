     3215                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-rubl  else - tt-sum-fin-doc-tax.sum-line-rubl     ) ,
     3216                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-base  else - tt-sum-fin-doc-tax.sum-line-base     ) ,
     3217                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-contr else - tt-sum-fin-doc-tax.sum-line-contr    ) ,
     3218                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-doc    else - tt-sum-fin-doc-tax.sum-vat-doc  ) ,
     3219                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-rubl   else - tt-sum-fin-doc-tax.sum-vat-rubl ) ,
     3220                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-base   else - tt-sum-fin-doc-tax.sum-vat-base ) ,
     3221                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-contr  else - tt-sum-fin-doc-tax.sum-vat-contr) ,
     3222                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-doc    else - tt-sum-fin-doc-tax.sum-slt-doc  ) ,
     3223                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-rubl   else - tt-sum-fin-doc-tax.sum-slt-rubl ) ,
     3224                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-base   else - tt-sum-fin-doc-tax.sum-slt-base ) ,
     3225                                                                    input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-contr  else - tt-sum-fin-doc-tax.sum-slt-contr)
     3226                                                                    ).
     3227             end.
     3228           end.
     3229           else do:
     3230             if (pararh-name = "all":u                               or
     3231             lookup ('arh-fin-doc-schet-tax-nal':U, pararh-name) > 0 )   and  v-curr-db-num = v-obj-db-num
     3232             then do:
     3233             if bf_sysconf.firm-db-num = v-curr-db-num then
     3234             run libfarhp_calc-arh-fin-doc-schet-tax-n in g#libfarhp (input parmode,
     3235                                                                      input bf_fin-doc.host-code,
     3236                                                                      input bf_fin-doc.payer-type,
     3237                                                                      input bf_fin-doc.payer-code,
     3238                                                                      input bf_fin-doc.receiver-type,
     3239                                                                      input bf_fin-doc.receiver-code,
     3240                                                                      input (if v-is-income then bf_fin-doc.cor-acc1 else bf_fin-doc.cor-acc ),
     3241                                                                      input (if v-is-income then bf_fin-doc.cor-acc  else bf_fin-doc.cor-acc1),
     3242                                                                      input bf_fin-doc.fin-ext-doc-type,
     3243                                                                      input '':U,
     3244                                                                      input bf_fin-doc.fact-order,
     3245                                                                      input bf_fin-doc.fin-doc-code,
     3246                                                                      input bf_fin-doc.fact-date,
     3247                                                                      input bf_fin-doc.curr-code,
     3248                                                                      input bf_sysconf.base-code,
     3249                                                                      input varfin-doc-tax-vat-pc,
     3250                                                                      input varfin-doc-tax-slt-pc,
     3251                                                                      input bf_fin-doc-tax.with-vat,
     3252                                                                      input bf_fin-doc-tax.with-slt,
     3253                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-doc   else - tt-sum-fin-doc-tax.sum-line-doc      ) ,
     3254                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-rubl  else - tt-sum-fin-doc-tax.sum-line-rubl     ) ,
     3255                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-base  else - tt-sum-fin-doc-tax.sum-line-base     ) ,
     3256                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-line-contr else - tt-sum-fin-doc-tax.sum-line-contr    ) ,
     3257                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-doc    else - tt-sum-fin-doc-tax.sum-vat-doc  ) ,
     3258                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-rubl   else - tt-sum-fin-doc-tax.sum-vat-rubl ) ,
     3259                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-base   else - tt-sum-fin-doc-tax.sum-vat-base ) ,
     3260                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-vat-contr  else - tt-sum-fin-doc-tax.sum-vat-contr) ,
     3261                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-doc    else - tt-sum-fin-doc-tax.sum-slt-doc  ) ,
     3262                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-rubl   else - tt-sum-fin-doc-tax.sum-slt-rubl ) ,
     3263                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-base   else - tt-sum-fin-doc-tax.sum-slt-base ) ,
     3264                                                                      input (if parmode = "close":u then tt-sum-fin-doc-tax.sum-slt-contr  else - tt-sum-fin-doc-tax.sum-slt-contr)
     3265                                                                      ).
     3266             end.
     3267           end.
     3268         end.
     3269       end.
     3270     end.
     3271   end.
     3272   end procedure.
     3273   procedure calc-sum:
     3274   define input parameter parmode         as   character               no-undo.
     3275   define input parameter parhost-code    like ub.fin-doc.host-code    no-undo.
     3276   define input parameter parfin-doc-code like ub.fin-doc.fin-doc-code no-undo.
     3277   define output parameter varznaksum-doc        as decimal no-undo.
     3278   define output parameter varznaksum-rubl       as decimal no-undo.
     3279   define output parameter varznaksum-base       as decimal no-undo.
     3280   define output parameter varznaksum-contr      as decimal no-undo.
     3281   define output parameter varznaksum-vat-doc    as decimal no-undo.
     3282   define output parameter varznaksum-vat-rubl   as decimal no-undo.
     3283   define output parameter varznaksum-vat-base   as decimal no-undo.
     3284   define output parameter varznaksum-vat-contr  as decimal no-undo.
     3285   define output parameter varznaksum-slt-doc    as decimal no-undo.
     3286   define output parameter varznaksum-slt-rubl   as decimal no-undo.
     3287   define output parameter varznaksum-slt-base   as decimal no-undo.
     3288   define output parameter varznaksum-slt-contr  as decimal no-undo.
     3289   define variable varsum-vat-doc        as   decimal               no-undo.
     3290   define variable varsum-vat-rubl       as   decimal               no-undo.
     3291   define variable varsum-vat-base       as   decimal               no-undo.
     3292   define variable varsum-vat-contr      as   decimal               no-undo.
     3293   define variable varsum-slt-doc        as   decimal               no-undo.
     3294   define variable varsum-slt-rubl       as   decimal               no-undo.
     3295   define variable varsum-slt-base       as   decimal               no-undo.
     3296   define variable varsum-slt-contr      as   decimal               no-undo.
     3297   define buffer bf_fin-doc     for ub.fin-doc.
     3298   define buffer bf_fin-doc-tax for ub.fin-doc-tax.
     3299   do on error undo, return error substitute ("&1 &2 &3", return-value, error-status :get-message(1), error-status :get-message(2) ):
     3300   find first bf_fin-doc where bf_fin-doc.host-code    = parhost-code    and
     3301                               bf_fin-doc.fin-doc-code = parfin-doc-code.
     3302   assign
     3303     varsum-vat-doc   = 0
     3304     varsum-vat-rubl  = 0
     3305     varsum-vat-base  = 0
     3306     varsum-vat-contr = 0
     3307     varsum-slt-doc   = 0
     3308     varsum-slt-rubl  = 0
     3309     varsum-slt-base  = 0
     3310     varsum-slt-contr = 0 .
     3311   for each bf_fin-doc-tax where bf_fin-doc-tax.host-code    = bf_fin-doc.host-code    and
     3312                                 bf_fin-doc-tax.fin-doc-code = bf_fin-doc.fin-doc-code on error undo, return error return-value :
     3313      assign
     3314        varsum-vat-doc   = varsum-vat-doc   + bf_fin-doc-tax.sum-vat-line-doc
     3315        varsum-vat-rubl  = varsum-vat-rubl  + bf_fin-doc-tax.sum-vat-line-rubl
     3316        varsum-vat-base  = varsum-vat-base  + bf_fin-doc-tax.sum-vat-line-base
     3317        varsum-vat-contr = varsum-vat-contr + bf_fin-doc-tax.sum-vat-line-contr
     3318        varsum-slt-doc   = varsum-slt-doc   + bf_fin-doc-tax.sum-slt-line-doc
     3319        varsum-slt-rubl  = varsum-slt-rubl  + bf_fin-doc-tax.sum-slt-line-rubl
     3320        varsum-slt-base  = varsum-slt-base  + bf_fin-doc-tax.sum-slt-line-base
     3321        varsum-slt-contr = varsum-slt-contr + bf_fin-doc-tax.sum-slt-line-contr
     3322     .
     3323   end.
     3324   assign
     3325     varznaksum-doc       = (if parmode = "close":u then bf_fin-doc.sum-doc   else - bf_fin-doc.sum-doc   )
     3326     varznaksum-rubl      = (if parmode = "close":u then bf_fin-doc.sum-rubl  else - bf_fin-doc.sum-rubl  )
     3327     varznaksum-base      = (if parmode = "close":u then bf_fin-doc.sum-base  else - bf_fin-doc.sum-base  )
     3328     varznaksum-contr     = (if parmode = "close":u then bf_fin-doc.sum-contr else - bf_fin-doc.sum-contr )
     3329     varznaksum-vat-doc   = (if parmode = "close":u then varsum-vat-doc       else - varsum-vat-doc       )
     3330     varznaksum-vat-rubl  = (if parmode = "close":u then varsum-vat-rubl      else - varsum-vat-rubl      )
     3331     varznaksum-vat-base  = (if parmode = "close":u then varsum-vat-base      else - varsum-vat-base      )
     3332     varznaksum-vat-contr = (if parmode = "close":u then varsum-vat-contr     else - varsum-vat-contr     )
     3333     varznaksum-slt-doc   = (if parmode = "close":u then varsum-slt-doc       else - varsum-slt-doc       )
     3334     varznaksum-slt-rubl  = (if parmode = "close":u then varsum-slt-rubl      else - varsum-slt-rubl      )
     3335     varznaksum-slt-base  = (if parmode = "close":u then varsum-slt-base      else - varsum-slt-base      )
     3336     varznaksum-slt-contr = (if parmode = "close":u then varsum-slt-contr     else - varsum-slt-contr     )
     3337   .
     3338   end.
     3339   end procedure.
     3340   procedure check-attr-doc:
     3341   define input parameter parhost-code    like ub.fin-doc.host-code    no-undo.
     3342   define input parameter parfin-doc-code like ub.fin-doc.fin-doc-code no-undo.
     3343   define buffer bf-payer_fin-schet         for ub.fin-schet.
     3344   define buffer bf-receiver_fin-schet      for ub.fin-schet.
     3345   define buffer bf-first_fin-code-cor-acc  for ub.fin-code-cor-acc.
     3346   define buffer bf-second_fin-code-cor-acc for ub.fin-code-cor-acc.
     3347   define buffer bf_fin-code-an-uchet       for ub.fin-code-an-uchet.
     3348   define buffer bf_fin-code-cel-nazn       for ub.fin-code-cel-nazn.
     3349   define buffer bf_fin-doc                 for ub.fin-doc.
     3350   define buffer bf_sysconf                 for ub.sysconf.
     3351   do on error undo, return error return-value :
     3352   find first bf_fin-doc where bf_fin-doc.host-code    = parhost-code    and
     3353                               bf_fin-doc.fin-doc-code = parfin-doc-code.
     3354     find first bf_sysconf where bf_sysconf.host-code = bf_fin-doc.host-code no-lock.
     3355     if bf_fin-doc.fin-ext-doc-type = 'ппп':U  or
     3356        bf_fin-doc.fin-ext-doc-type = 'рпп':U
     3357        then do:
     3358       find first bf-payer_fin-schet where bf-payer_fin-schet.host-code  = bf_fin-doc.host-code        and
     3359                                           bf-payer_fin-schet.code-schet = bf_fin-doc.payer-code-schet no-lock no-error.
     3360       if not available bf-payer_fin-schet then do:
     3361         return error substitute ("Не найден счет плательщика по фирме &1. Внутренний номер счета &2.", bf_fin-doc.host-code, bf_fin-doc.payer-code-schet).
     3362       end.
     3363       find first bf-receiver_fin-schet where bf-receiver_fin-schet.host-code  = bf_fin-doc.host-code           and
     3364                                              bf-receiver_fin-schet.code-schet = bf_fin-doc.receiver-code-schet no-lock no-error.
     3365       if not available bf-receiver_fin-schet then do:
     3366         return error substitute ("Не найден счет получателя по фирме &1. Внутренний номер счета &2.", bf_fin-doc.host-code, bf_fin-doc.receiver-code-schet).
     3367       end.
     3368       if bf-payer_fin-schet.curr-code <> bf-receiver_fin-schet.curr-code then do:
     3369         return error substitute ("Счета плательщика и получателя документа с внутренним номером &1 на фирме &2 имеют разную валюту.", bf_fin-doc.fin-doc-code, bf_fin-doc.host-code).
     3370       end.
     3371     end.
     3372     else do:
     3373       find first bf-first_fin-code-cor-acc where bf-first_fin-code-cor-acc.host-code = bf_fin-doc.host-code and
     3374                                                  bf-first_fin-code-cor-acc.fin-code  = bf_fin-doc.cor-acc   no-lock no-error.
     3375       if not available bf-first_fin-code-cor-acc then do:
     3376         if bf_sysconf.is-corr-acc then do:
     3377           return error substitute ("Не найден корреспондирующий счет по фирме &1. Внутренний номер счета &2.", bf_fin-doc.host-code, bf_fin-doc.cor-acc).
     3378         end.
     3379       end.
     3380       find first bf-second_fin-code-cor-acc where bf-second_fin-code-cor-acc.host-code = bf_fin-doc.host-code and
     3381                                                   bf-second_fin-code-cor-acc.fin-code  = bf_fin-doc.cor-acc1  no-lock no-error.
     3382       if not available bf-second_fin-code-cor-acc then do:
     3383         if bf_sysconf.is-cassa-acc and not bf_fin-doc.prn-doc-code begins "тех" and program-name(3) <> "trg/finddocdl.p" then do:
     3384           return error substitute ("Не найден корреспондирующий счет по фирме &1. Внутренний номер счета &2.", bf_fin-doc.host-code, bf_fin-doc.cor-acc1).
     3385         end.
     3386       end.
     3387     end.
     3388     find first bf_fin-code-an-uchet where bf_fin-code-an-uchet.host-code = bf_fin-doc.host-code     and
     3389                                           bf_fin-code-an-uchet.fin-code  = bf_fin-doc.an-uchet-code no-lock no-error.
     3390     if not available bf_fin-code-an-uchet then do:
     3391       if bf_sysconf.is-an-uchet then do:
     3392         return error substitute ("Не найден код аналитического учета по фирме &1. Код аналитического учета &2.", bf_fin-doc.host-code, bf_fin-doc.an-uchet-code).
     3393       end.
     3394     end.
     3395     find first bf_fin-code-cel-nazn where bf_fin-code-cel-nazn.host-code = bf_fin-doc.host-code     and
     3396                                           bf_fin-code-cel-nazn.fin-code  = bf_fin-doc.cel-nazn-code no-lock no-error.
     3397     if not available bf_fin-code-cel-nazn then do:
     3398       if bf_sysconf.is-code-cel-nazn then do:
     3399         return error substitute ("Не найден код целевого назначения по фирме &1. Код целевого назначения &2.", bf_fin-doc.host-code, bf_fin-doc.cel-nazn-code).
     3400       end.
     3401     end.
     3402     if not (bf_fin-doc.fin-ext-doc-type = 'пко':U      or
     3403             bf_fin-doc.fin-ext-doc-type = 'рко':U     or
     3404             bf_fin-doc.fin-ext-doc-type = 'ппп':U  or
     3405             bf_fin-doc.fin-ext-doc-type = 'рпп':U or
     3406             bf_fin-doc.fin-ext-doc-type = 'апп':U    or
     3407             bf_fin-doc.fin-ext-doc-type = 'апр':U   ) then do:
     3408       return error substitute ("Неизвестный расширенный тип &1 платежного документа с номером &2 внутренний номер &3.", bf_fin-doc.fin-ext-doc-type, bf_fin-doc.prn-doc-code, bf_fin-doc.fin-doc-code).
     3409     end.
     3410   end.
     3411   end procedure.
     3412   procedure full-lock:
     3413   define input parameter parhost-code    like ub.fin-doc.host-code    no-undo.
     3414   define input parameter parfin-doc-code like ub.fin-doc.fin-doc-code no-undo.
     3415   define input parameter paruser-name    as   character               no-undo.
     3416   define buffer bf_fin-doc     for ub.fin-doc.
     3417   do on error undo, return error return-value :
     3418   find first bf_fin-doc where bf_fin-doc.host-code    = parhost-code    and
     3419                               bf_fin-doc.fin-doc-code = parfin-doc-code.
     3420     case bf_fin-doc.fin-ext-doc-type :
     3421       when 'пко':U    or
     3422       when 'рко':U   or
     3423       when 'апп':U  or
     3424       when 'апр':U then do:
     3425         run lib-farh_lkcordoc in this-procedure (input bf_fin-doc.host-code,
     3426                                                  input bf_fin-doc.cor-acc,
     3427                                                  input paruser-name,
     3428                                                  input bf_fin-doc.fin-doc-code) no-error.
     3429         if error-status:error then do:
     3430           return error return-value.
     3431         end.
     3432         run lib-farh_lkcordoc in this-procedure (input bf_fin-doc.host-code,
     3433                                                  input bf_fin-doc.cor-acc1,
     3434                                                  input paruser-name,
     3435                                                  input bf_fin-doc.fin-doc-code) no-error.
     3436         if error-status:error then do:
     3437           return error return-value.
     3438         end.
     3439       end.
     3440       when 'ппп':U  or
     3441       when 'рпп':U then do:
     3442         run lib-farh_lkschdoc in this-procedure (input bf_fin-doc.host-code,
     3443                                                  input bf_fin-doc.payer-code-schet,
     3444                                                  input paruser-name,
     3445                                                  input bf_fin-doc.fin-doc-code) no-error.
     3446         if error-status:error then do:
     3447           return error return-value.
     3448         end.
     3449         run lib-farh_lkschdoc in this-procedure (input bf_fin-doc.host-code,
     3450                                                  input bf_fin-doc.receiver-code-schet,
     3451                                                  input paruser-name,
     3452                                                  input bf_fin-doc.fin-doc-code) no-error.
     3453         if error-status:error then do:
     3454           return error return-value.
     3455         end.
     3456       end.
     3457       otherwise do:
     3458         return error substitute ("Неизвестный расширенный тип &1 платежного документа с номером &2 внутренний номер &3.", bf_fin-doc.fin-ext-doc-type, bf_fin-doc.prn-doc-code, bf_fin-doc.fin-doc-code).
     3459       end.
     3460     end case.
     3461   end.
     3462   end procedure.
     3463   procedure check-sum-doc:
     3464   define input parameter parhost-code     like ub.fin-doc.host-code    no-undo.
     3465   define input parameter parfin-doc-code  like ub.fin-doc.fin-doc-code no-undo.
     3466   define output parameter varhave-connect as   logical                 no-undo.
     3467   define buffer bf_fin-doc     for ub.fin-doc.
     3468   define buffer bf_fin-doc-tax for ub.fin-doc-tax.
     3469   define buffer bf_fin-connect for ub.fin-connect.
     3470   define buffer bf_clients     for ub.clients.
     3471   define buffer bf_fin-ob      for ub.fin-ob.
     3472   define buffer bf_fin-ob-tax  for ub.fin-ob-tax.
     3473   define variable varsum-vat-rubl-ob    as   decimal               no-undo.
     3474   define variable varsum-vat-base-ob    as   decimal               no-undo.
     3475   define variable varsum-vat-contr-ob   as   decimal               no-undo.
     3476   define variable varsum-vat-doc-ob     as   decimal               no-undo.
     3477   define variable varsum-slt-rubl-ob    as   decimal               no-undo.
     3478   define variable varsum-slt-base-ob    as   decimal               no-undo.
     3479   define variable varsum-slt-contr-ob   as   decimal               no-undo.
     3480   define variable varsum-slt-doc-ob     as   decimal               no-undo.
     3481   define variable varsum-vat-rubl-tot   as   decimal               no-undo.
     3482   define variable varsum-vat-base-tot   as   decimal               no-undo.
     3483   define variable varsum-vat-contr-tot  as   decimal               no-undo.
     3484   define variable varsum-vat-doc-tot    as   decimal               no-undo.
     3485   define variable varsum-slt-rubl-tot   as   decimal               no-undo.
     3486   define variable varsum-slt-base-tot   as   decimal               no-undo.
     3487   define variable varsum-slt-contr-tot  as   decimal               no-undo.
     3488   define variable varsum-slt-doc-tot    as   decimal               no-undo.
     3489   define variable varsum-line-doc       as   decimal               no-undo.
     3490   define variable varsum-line-rubl      as   decimal               no-undo.
     3491   define variable varsum-line-base      as   decimal               no-undo.
     3492   define variable varsum-line-contr     as   decimal               no-undo.
     3493   define variable varsum-vat-rubl-line  as   decimal               no-undo.
     3494   define variable varsum-vat-base-line  as   decimal               no-undo.
     3495   define variable varsum-vat-contr-line as   decimal               no-undo.
     3496   define variable varsum-vat-doc-line   as   decimal               no-undo.
     3497   define variable varsum-slt-rubl-line  as   decimal               no-undo.
     3498   define variable varsum-slt-base-line  as   decimal               no-undo.
     3499   define variable varsum-slt-contr-line as   decimal               no-undo.
     3500   define variable varsum-slt-doc-line   as   decimal               no-undo.
     3501   define variable varsum-rubl           as   decimal               no-undo.
     3502   define variable varsum-base           as   decimal               no-undo.
     3503   define variable varsum-contr          as   decimal               no-undo.
     3504   define variable varsum-doc            as   decimal               no-undo.
     3505   do on error undo, return error return-value :
     3506   find first bf_fin-doc where bf_fin-doc.host-code    = parhost-code    and
     3507                               bf_fin-doc.fin-doc-code = parfin-doc-code.
     3508   for each tt-sum-con-fin-ob-obj on error undo, return error return-value :
     3509     delete tt-sum-con-fin-ob-obj.
     3510   end.
     3511   for each tt-sum-con-fin-ob-tax-obj on error undo, return error return-value :
     3512     delete tt-sum-con-fin-ob-tax-obj.
     3513   end.
     3514   for each tt-sum-fin-doc-tax on error undo, return error return-value :
     3515     delete tt-sum-fin-doc-tax.
     3516   end.
     3517   for each tt-sum-fin-ob-tax on error undo, return error return-value :
     3518     delete tt-sum-fin-ob-tax.
     3519   end.
     3520   find first bf_fin-connect where bf_fin-connect.host-code    = bf_fin-doc.host-code    and
     3521                                   bf_fin-connect.fin-doc-code = bf_fin-doc.fin-doc-code no-error.
     3522   if not available bf_fin-connect then do:
     3523     if bf_fin-doc.obj-type = "":u and
     3524        bf_fin-doc.obj-code = 0    then do:
     3525       return error substitute ("По фирме &1 ведется финансовый учет по объектам. В платежном документе &2 с внутренним номером &3 не указан объект",
     3526                                bf_fin-doc.host-code,
     3527                                bf_fin-doc.prn-doc-code,
     3528                                bf_fin-doc.fin-doc-code).
     3529     end.
     3530     find first bf_clients where bf_clients.obj-type = bf_fin-doc.obj-type and
     3531                                 bf_clients.obj-code = bf_fin-doc.obj-code no-lock no-error.
     3532     if not available bf_clients then do:
     3533       return error substitute ("По фирме &1 ведется финансовый учет по объектам. В платежном документе &2 с внутренним номером &3 указан объект &4 &5 которого нет в справочнике.",
     3534                                bf_fin-doc.host-code,
     3535                                bf_fin-doc.prn-doc-code,
     3536                                bf_fin-doc.fin-doc-code,
     3537                                bf_fin-doc.obj-type,
     3538                                bf_fin-doc.obj-code).
     3539     end.
     3540     assign
     3541       varhave-connect = no.
     3542   end.
     3543   else do:
     3544     assign
     3545       varhave-connect = yes.
     3546     for each bf_fin-connect where bf_fin-connect.host-code    = bf_fin-doc.host-code    and
     3547                                   bf_fin-connect.fin-doc-code = bf_fin-doc.fin-doc-code on error undo, return error return-value :
     3548       find first bf_fin-ob where bf_fin-ob.host-code = bf_fin-connect.host-code   and
     3549                                  bf_fin-ob.doc-code  = bf_fin-connect.fin-ob-code no-error.
     3550       if not available bf_fin-ob then do:
     3551         return error substitute ("Финансовый документ по фирме &1 с внутренним номером &2 имеет связь с финансовым обязательством с внутренним номером &3. Но этого финансового обязательства нет в базе данных.",
     3552                                  bf_fin-doc.host-code,
     3553                                  bf_fin-doc.fin-doc-code,
     3554                                  bf_fin-ob.doc-code).
     3555       end.
     3556       if bf_fin-ob.contract-code <> bf_fin-doc.contract-code then do:
     3557         return error substitute ("Финансовый документ по фирме &1 с внутренним номером &2 имеет связь с финансовым обязательством с внутренним номером &3. Внутренний номер договора по финансовому документу &4. Внутренний номер договора по финансовому обязательству &5. Это недопустимо.",
     3558                                  bf_fin-doc.host-code,
     3559                                  bf_fin-doc.fin-doc-code,
     3560                                  bf_fin-ob.doc-code,
     3561                                  bf_fin-doc.contract-code,
     3562                                  bf_fin-ob.contract-code).
     3563       end.
     3564       assign
     3565         varsum-rubl  = varsum-rubl  + bf_fin-connect.sum-rubl
     3566         varsum-base  = varsum-base  + bf_fin-connect.sum-base
     3567         varsum-contr = varsum-contr + bf_fin-connect.sum-contr
     3568         varsum-doc   = varsum-doc   + bf_fin-connect.sum-doc.
     3569       find first tt-sum-con-fin-ob-obj where tt-sum-con-fin-ob-obj.obj-type = bf_fin-ob.obj-type and
     3570                                              tt-sum-con-fin-ob-obj.obj-code = bf_fin-ob.obj-code no-error.
     3571       if not available tt-sum-con-fin-ob-obj then do:
     3572         create tt-sum-con-fin-ob-obj.
     3573         assign
     3574           tt-sum-con-fin-ob-obj.obj-type = bf_fin-ob.obj-type
     3575           tt-sum-con-fin-ob-obj.obj-code = bf_fin-ob.obj-code
     3576         .
     3577       end.
     3578       assign
     3579         tt-sum-con-fin-ob-obj.sum-base  = tt-sum-con-fin-ob-obj.sum-base  + bf_fin-connect.sum-base
     3580         tt-sum-con-fin-ob-obj.sum-rubl  = tt-sum-con-fin-ob-obj.sum-rubl  + bf_fin-connect.sum-rubl
     3581         tt-sum-con-fin-ob-obj.sum-contr = tt-sum-con-fin-ob-obj.sum-contr + bf_fin-connect.sum-contr
     3582         tt-sum-con-fin-ob-obj.sum-doc   = tt-sum-con-fin-ob-obj.sum-doc   + bf_fin-connect.sum-doc
     3583       .
     3584       for each bf_fin-ob-tax where bf_fin-ob-tax.host-code = bf_fin-ob.host-code and
     3585                                    bf_fin-ob-tax.doc-code  = bf_fin-ob.doc-code  on error undo, return error return-value :
     3586         find first tt-sum-con-fin-ob-tax-obj where tt-sum-con-fin-ob-tax-obj.obj-type = bf_fin-ob.obj-type     and
     3587                                                    tt-sum-con-fin-ob-tax-obj.obj-code = bf_fin-ob.obj-code     and
     3588                                                    tt-sum-con-fin-ob-tax-obj.vat-pc   = bf_fin-ob-tax.vat-pc   and
     3589                                                    tt-sum-con-fin-ob-tax-obj.slt-pc   = bf_fin-ob-tax.slt-pc   and
     3590                                                    tt-sum-con-fin-ob-tax-obj.with-vat = bf_fin-ob-tax.with-vat and
     3591                                                    tt-sum-con-fin-ob-tax-obj.with-slt = bf_fin-ob-tax.with-slt no-error.
     3592         if not available tt-sum-con-fin-ob-tax-obj then do:
     3593           create tt-sum-con-fin-ob-tax-obj.
     3594           assign
     3595             tt-sum-con-fin-ob-tax-obj.obj-type = bf_fin-ob.obj-type
     3596             tt-sum-con-fin-ob-tax-obj.obj-code = bf_fin-ob.obj-code
     3597             tt-sum-con-fin-ob-tax-obj.vat-pc   = bf_fin-ob-tax.vat-pc
     3598             tt-sum-con-fin-ob-tax-obj.slt-pc   = bf_fin-ob-tax.slt-pc
     3599             tt-sum-con-fin-ob-tax-obj.with-vat = bf_fin-ob-tax.with-vat
     3600             tt-sum-con-fin-ob-tax-obj.with-slt = bf_fin-ob-tax.with-slt
     3601           .
     3602         end.
     3603         if bf_fin-ob.sum-rubl = bf_fin-connect.sum-rubl then do:
     3604           assign
     3605             varsum-line-doc       = bf_fin-ob-tax.sum-line-doc
     3606             varsum-line-rubl      = bf_fin-ob-tax.sum-line-rubl
     3607             varsum-line-base      = bf_fin-ob-tax.sum-line-base
     3608             varsum-line-contr     = bf_fin-ob-tax.sum-line-contr
     3609             varsum-vat-rubl-line  = bf_fin-ob-tax.sum-vat-line-rubl
     3610             varsum-vat-base-line  = bf_fin-ob-tax.sum-vat-line-base
     3611             varsum-vat-contr-line = bf_fin-ob-tax.sum-vat-line-contr
     3612             varsum-vat-doc-line   = bf_fin-ob-tax.sum-vat-line-doc
     3613             varsum-slt-rubl-line  = bf_fin-ob-tax.sum-slt-line-rubl
     3614             varsum-slt-base-line  = bf_fin-ob-tax.sum-slt-line-base
     3615             varsum-slt-contr-line = bf_fin-ob-tax.sum-slt-line-contr
     3616             varsum-slt-doc-line   = bf_fin-ob-tax.sum-slt-line-doc
     3617           .
     3618         end.
     3619         else do:
     3620           assign
     3621             varsum-line-doc       = bf_fin-ob-tax.sum-line-doc        * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3622             varsum-line-rubl      = bf_fin-ob-tax.sum-line-rubl       * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3623             varsum-line-base      = bf_fin-ob-tax.sum-line-base       * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3624             varsum-line-contr     = bf_fin-ob-tax.sum-line-contr      * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3625             varsum-vat-rubl-line  = bf_fin-ob-tax.sum-vat-line-rubl   * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3626             varsum-vat-base-line  = bf_fin-ob-tax.sum-vat-line-base   * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3627             varsum-vat-contr-line = bf_fin-ob-tax.sum-vat-line-contr  * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3628             varsum-vat-doc-line   = bf_fin-ob-tax.sum-vat-line-doc    * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3629             varsum-slt-rubl-line  = bf_fin-ob-tax.sum-slt-line-rubl   * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3630             varsum-slt-base-line  = bf_fin-ob-tax.sum-slt-line-base   * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3631             varsum-slt-contr-line = bf_fin-ob-tax.sum-slt-line-contr  * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3632             varsum-slt-doc-line   = bf_fin-ob-tax.sum-slt-line-doc    * (bf_fin-connect.sum-rubl / bf_fin-ob.sum-rubl)
     3633           .
     3634         end.
     3635         assign
     3636           tt-sum-con-fin-ob-tax-obj.sum-doc        = tt-sum-con-fin-ob-tax-obj.sum-doc        + varsum-line-doc
     3637           tt-sum-con-fin-ob-tax-obj.sum-rubl       = tt-sum-con-fin-ob-tax-obj.sum-rubl       + varsum-line-rubl
     3638           tt-sum-con-fin-ob-tax-obj.sum-base       = tt-sum-con-fin-ob-tax-obj.sum-base       + varsum-line-base
     3639           tt-sum-con-fin-ob-tax-obj.sum-contr      = tt-sum-con-fin-ob-tax-obj.sum-contr      + varsum-line-contr
     3640           tt-sum-con-fin-ob-tax-obj.sum-vat-rubl   = tt-sum-con-fin-ob-tax-obj.sum-vat-rubl   + varsum-vat-rubl-line
     3641           tt-sum-con-fin-ob-tax-obj.sum-vat-base   = tt-sum-con-fin-ob-tax-obj.sum-vat-base   + varsum-vat-base-line
     3642           tt-sum-con-fin-ob-tax-obj.sum-vat-contr  = tt-sum-con-fin-ob-tax-obj.sum-vat-contr  + varsum-vat-contr-line
     3643           tt-sum-con-fin-ob-tax-obj.sum-vat-doc    = tt-sum-con-fin-ob-tax-obj.sum-vat-doc    + varsum-vat-doc-line
     3644           tt-sum-con-fin-ob-tax-obj.sum-slt-rubl   = tt-sum-con-fin-ob-tax-obj.sum-slt-rubl   + varsum-slt-rubl-line
     3645           tt-sum-con-fin-ob-tax-obj.sum-slt-base   = tt-sum-con-fin-ob-tax-obj.sum-slt-base   + varsum-slt-base-line
     3646           tt-sum-con-fin-ob-tax-obj.sum-slt-contr  = tt-sum-con-fin-ob-tax-obj.sum-slt-contr  + varsum-slt-contr-line
     3647           tt-sum-con-fin-ob-tax-obj.sum-slt-doc    = tt-sum-con-fin-ob-tax-obj.sum-slt-doc    + varsum-slt-doc-line
     3648         .
     3649         assign
     3650           varsum-vat-rubl-ob  = varsum-vat-rubl-ob  + varsum-vat-rubl-line
     3651           varsum-vat-base-ob  = varsum-vat-base-ob  + varsum-vat-base-line
     3652           varsum-vat-contr-ob = varsum-vat-contr-ob + varsum-vat-contr-line
     3653           varsum-vat-doc-ob   = varsum-vat-doc-ob   + varsum-vat-doc-line
     3654           varsum-slt-rubl-ob  = varsum-slt-rubl-ob  + varsum-slt-rubl-line
     3655           varsum-slt-base-ob  = varsum-slt-base-ob  + varsum-slt-base-line
     3656           varsum-slt-contr-ob = varsum-slt-contr-ob + varsum-slt-contr-line
     3657           varsum-slt-doc-ob   = varsum-slt-doc-ob   + varsum-slt-doc-line
     3658         .
     3659         find first tt-sum-fin-ob-tax where tt-sum-fin-ob-tax.vat-pc   = bf_fin-ob-tax.vat-pc   and
     3660                                            tt-sum-fin-ob-tax.slt-pc   = bf_fin-ob-tax.slt-pc   and
     3661                                            tt-sum-fin-ob-tax.with-vat = bf_fin-ob-tax.with-vat and
     3662                                            tt-sum-fin-ob-tax.with-slt = bf_fin-ob-tax.with-slt no-error.
     3663         if not available tt-sum-fin-ob-tax then do:
     3664           create tt-sum-fin-ob-tax.
     3665           assign
     3666             tt-sum-fin-ob-tax.vat-pc   = bf_fin-ob-tax.vat-pc
     3667             tt-sum-fin-ob-tax.slt-pc   = bf_fin-ob-tax.slt-pc
     3668             tt-sum-fin-ob-tax.with-vat = bf_fin-ob-tax.with-vat
     3669             tt-sum-fin-ob-tax.with-slt = bf_fin-ob-tax.with-slt
     3670           .
     3671         end.
     3672         assign
     3673           tt-sum-fin-ob-tax.sum-vat-rubl  = tt-sum-fin-ob-tax.sum-vat-rubl  + varsum-vat-rubl-line
     3674           tt-sum-fin-ob-tax.sum-vat-base  = tt-sum-fin-ob-tax.sum-vat-base  + varsum-vat-base-line
     3675           tt-sum-fin-ob-tax.sum-vat-contr = tt-sum-fin-ob-tax.sum-vat-contr + varsum-vat-contr-line
     3676           tt-sum-fin-ob-tax.sum-vat-doc   = tt-sum-fin-ob-tax.sum-vat-doc   + varsum-vat-doc-line
     3677           tt-sum-fin-ob-tax.sum-slt-rubl  = tt-sum-fin-ob-tax.sum-slt-rubl  + varsum-slt-rubl-line
     3678           tt-sum-fin-ob-tax.sum-slt-base  = tt-sum-fin-ob-tax.sum-slt-base  + varsum-slt-base-line
     3679           tt-sum-fin-ob-tax.sum-slt-contr = tt-sum-fin-ob-tax.sum-slt-contr + varsum-slt-contr-line
     3680           tt-sum-fin-ob-tax.sum-slt-doc   = tt-sum-fin-ob-tax.sum-slt-doc   + varsum-slt-doc-line
     3681         .
     3682       end.
     3683     end.
     3684     for each bf_fin-doc-tax where bf_fin-doc-tax.host-code    = bf_fin-doc.host-code    and
     3685                                   bf_fin-doc-tax.fin-doc-code = bf_fin-doc.fin-doc-code on error undo, return error return-value :
     3686       find first tt-sum-fin-doc-tax where tt-sum-fin-doc-tax.vat-pc   = bf_fin-doc-tax.vat-pc   and
     3687                                           tt-sum-fin-doc-tax.slt-pc   = bf_fin-doc-tax.slt-pc   and
     3688                                           tt-sum-fin-doc-tax.with-vat = bf_fin-doc-tax.with-vat and
     3689                                           tt-sum-fin-doc-tax.with-slt = bf_fin-doc-tax.with-slt no-error.
     3690       if not available tt-sum-fin-doc-tax then do:
     3691         create tt-sum-fin-doc-tax.
     3692         assign
     3693           tt-sum-fin-doc-tax.vat-pc   = bf_fin-doc-tax.vat-pc
     3694           tt-sum-fin-doc-tax.slt-pc   = bf_fin-doc-tax.slt-pc
     3695           tt-sum-fin-doc-tax.with-vat = bf_fin-doc-tax.with-vat
     3696           tt-sum-fin-doc-tax.with-slt = bf_fin-doc-tax.with-slt
     3697         .
     3698       end.
     3699       assign
     3700         tt-sum-fin-doc-tax.sum-vat-rubl  = tt-sum-fin-doc-tax.sum-vat-rubl  + bf_fin-doc-tax.sum-vat-line-rubl
     3701         tt-sum-fin-doc-tax.sum-vat-base  = tt-sum-fin-doc-tax.sum-vat-base  + bf_fin-doc-tax.sum-vat-line-base
     3702         tt-sum-fin-doc-tax.sum-vat-contr = tt-sum-fin-doc-tax.sum-vat-contr + bf_fin-doc-tax.sum-vat-line-contr
     3703         tt-sum-fin-doc-tax.sum-vat-doc   = tt-sum-fin-doc-tax.sum-vat-doc   + bf_fin-doc-tax.sum-vat-line-doc
     3704         tt-sum-fin-doc-tax.sum-slt-rubl  = tt-sum-fin-doc-tax.sum-slt-rubl  + bf_fin-doc-tax.sum-slt-line-rubl
     3705         tt-sum-fin-doc-tax.sum-slt-base  = tt-sum-fin-doc-tax.sum-slt-base  + bf_fin-doc-tax.sum-slt-line-base
     3706         tt-sum-fin-doc-tax.sum-slt-contr = tt-sum-fin-doc-tax.sum-slt-contr + bf_fin-doc-tax.sum-slt-line-contr
     3707         tt-sum-fin-doc-tax.sum-slt-doc   = tt-sum-fin-doc-tax.sum-slt-doc   + bf_fin-doc-tax.sum-slt-line-doc
     3708       .
     3709       assign
     3710         varsum-vat-rubl-tot  = varsum-vat-rubl-tot  +  bf_fin-doc-tax.sum-vat-line-rubl
     3711         varsum-vat-base-tot  = varsum-vat-base-tot  +  bf_fin-doc-tax.sum-vat-line-base
     3712         varsum-vat-contr-tot = varsum-vat-contr-tot +  bf_fin-doc-tax.sum-vat-line-contr
     3713         varsum-vat-doc-tot   = varsum-vat-doc-tot   +  bf_fin-doc-tax.sum-vat-line-doc
     3714         varsum-slt-rubl-tot  = varsum-slt-rubl-tot  +  bf_fin-doc-tax.sum-slt-line-rubl
     3715         varsum-slt-base-tot  = varsum-slt-base-tot  +  bf_fin-doc-tax.sum-slt-line-base
     3716         varsum-slt-contr-tot = varsum-slt-contr-tot +  bf_fin-doc-tax.sum-slt-line-contr
     3717         varsum-slt-doc-tot   = varsum-slt-doc-tot   +  bf_fin-doc-tax.sum-slt-line-doc
     3718       .
     3719     end.
     3720   end.
     3721   for each tt-sum-fin-doc-tax on error undo, return error return-value :
     3722     find first tt-sum-fin-ob-tax where tt-sum-fin-ob-tax.vat-pc   = tt-sum-fin-doc-tax.vat-pc   and
     3723                                        tt-sum-fin-ob-tax.slt-pc   = tt-sum-fin-doc-tax.slt-pc   and
     3724                                        tt-sum-fin-ob-tax.with-vat = tt-sum-fin-doc-tax.with-vat         and
     3725                                        tt-sum-fin-ob-tax.with-slt = tt-sum-fin-doc-tax.with-slt         no-error.
     3726     if not available tt-sum-fin-ob-tax then do:
     3727       return error substitute ("Финансовый документ по фирме &1 номер &2 с внутренним номером &3 имеет строку по налогам НДС &4, НП &5, с НДС &6, с НП &7. Но у финобязательств с которыми он имеет связи такой строки нет. Это недопустимо.",
     3728                                bf_fin-doc.host-code,
     3729                                bf_fin-doc.prn-doc-code,
     3730                                bf_fin-doc.fin-doc-code,
     3731                                tt-sum-fin-doc-tax.vat-pc,
     3732                                tt-sum-fin-doc-tax.slt-pc,
     3733                                tt-sum-fin-doc-tax.with-vat,
     3734                                tt-sum-fin-doc-tax.with-slt).
     3735     end.
     3736   end.
     3737   for each tt-sum-fin-ob-tax on error undo, return error return-value :
     3738     find first tt-sum-fin-doc-tax where tt-sum-fin-doc-tax.vat-pc   = tt-sum-fin-ob-tax.vat-pc   and
     3739                                         tt-sum-fin-doc-tax.slt-pc   = tt-sum-fin-ob-tax.slt-pc   and
     3740                                         tt-sum-fin-doc-tax.with-vat = tt-sum-fin-ob-tax.with-vat and
     3741                                         tt-sum-fin-doc-tax.with-slt = tt-sum-fin-ob-tax.with-slt no-error.
     3742     if not available tt-sum-fin-ob-tax then do:
     3743       return error substitute ("По финансовым обязательствам с которыми у финанасового документа по фирме &1 номер &2 с внутренним номером &3 есть связь есть строки по налогам НДС &4, НП &5, с НДС &6, с НП &7. Но у финансового документа такой строки нет. Это недопустимо.",
     3744                                bf_fin-doc.host-code,
     3745                                bf_fin-doc.prn-doc-code,
     3746                                bf_fin-doc.fin-doc-code,
     3747                                tt-sum-fin-ob-tax.vat-pc,
     3748                                tt-sum-fin-ob-tax.slt-pc,
     3749                                tt-sum-fin-ob-tax.with-vat,
     3750                                tt-sum-fin-ob-tax.with-slt).
     3751     end.
     3752   end.
     3753   for each tt-sum-con-fin-ob-tax-obj on error undo, return error return-value :
     3754     find first tt-sum-con-fin-ob-obj where tt-sum-con-fin-ob-obj.obj-type = tt-sum-con-fin-ob-tax-obj.obj-type and
     3755                                            tt-sum-con-fin-ob-obj.obj-code = tt-sum-con-fin-ob-tax-obj.obj-code .
     3756     assign
     3757       tt-sum-con-fin-ob-obj.sum-vat-rubl  = tt-sum-con-fin-ob-obj.sum-vat-rubl  +  tt-sum-con-fin-ob-tax-obj.sum-vat-rubl
     3758       tt-sum-con-fin-ob-obj.sum-vat-base  = tt-sum-con-fin-ob-obj.sum-vat-base  +  tt-sum-con-fin-ob-tax-obj.sum-vat-base
     3759       tt-sum-con-fin-ob-obj.sum-vat-contr = tt-sum-con-fin-ob-obj.sum-vat-contr +  tt-sum-con-fin-ob-tax-obj.sum-vat-contr
     3760       tt-sum-con-fin-ob-obj.sum-vat-doc   = tt-sum-con-fin-ob-obj.sum-vat-doc   +  tt-sum-con-fin-ob-tax-obj.sum-vat-doc
     3761       tt-sum-con-fin-ob-obj.sum-slt-rubl  = tt-sum-con-fin-ob-obj.sum-slt-rubl  +  tt-sum-con-fin-ob-tax-obj.sum-slt-rubl
     3762       tt-sum-con-fin-ob-obj.sum-slt-base  = tt-sum-con-fin-ob-obj.sum-slt-base  +  tt-sum-con-fin-ob-tax-obj.sum-slt-base
     3763       tt-sum-con-fin-ob-obj.sum-slt-contr = tt-sum-con-fin-ob-obj.sum-slt-contr +  tt-sum-con-fin-ob-tax-obj.sum-slt-contr
     3764       tt-sum-con-fin-ob-obj.sum-slt-doc   = tt-sum-con-fin-ob-obj.sum-slt-doc   +  tt-sum-con-fin-ob-tax-obj.sum-slt-doc
     3765     .
     3766   end.
     3767   end.
     3768   end procedure.
     3769   procedure lib-farh_finchkdb :
     3770   define input parameter p-host-code     like ub.fin-doc.host-code    no-undo.
     3771   define input parameter p-fin-doc-code  like ub.fin-doc.fin-doc-code no-undo.
     3772   define input parameter p-obj-type as character no-undo .
     3773   define input parameter p-obj-code as integer no-undo .
     3774   define input parameter p-fin-ext-doc-type as character no-undo .
     3775   define input parameter p-cash-book-place as character no-undo .
     3776   define input parameter p-is-auto-obj as logical no-undo .
     3777   define output parameter p-ok as logical no-undo .
     3778   define output parameter p-mess as character no-undo .
     3779   define variable v-curr-db-num as integer no-undo .
     3780   define variable v-obj-db-num as integer no-undo .
     3781   define variable v-firm as logical no-undo .
     3782   define variable v-cash as logical no-undo .
     3783   define variable v-obj-place-to-compare as character no-undo .
     3784   define variable v-is-auto-obj as logical no-undo .
     3785   define buffer buf_clients for ub.clients.
     3786   define buffer buf_sysconf for ub.sysconf.
     3787   main-block:
     3788   do
     3789   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3790   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3791   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3792   :
     3793     find first buf_sysconf no-lock where
     3794               buf_sysconf.host-code = p-host-code.
     3795   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3797     (output v-curr-db-num
     3798     )  .
     3799     if (p-obj-type = ''
     3800             and
     3801             p-obj-code = 0) then do:
     3802       v-firm = yes.
     3803     end.
     3804     else do:
     3805       v-obj-place-to-compare = p-obj-type + string(p-obj-code, "99999").
     3806     end.
     3807     if lookup(p-fin-ext-doc-type, 'пко,рко':U) > 0 then do:
     3808       v-cash = yes.
     3809     end.
     3810     case v-firm:
     3811       when yes then do:
     3812         case v-curr-db-num:
     3813           when buf_sysconf.firm-db-num then do:
     3814             p-mess = "".
     3815         p-ok = yes.
     3816         return.
     3817       end.
     3818           otherwise do:
     3819             p-mess = substitute ("В платежном документе с внутренним номером &2 (фирма &1) не указан объект&3"+
     3820                                 "такие документы могут создаваться/изменяться/удаляться только в главной БД фирмы&3" +
     3821                                 "номер текущей БД &4, номер ГЛАВНОЙ БД фирмы &5"
     3822                                   ,p-host-code
     3823                                   ,p-fin-doc-code
     3824                                   ,chr(10)
     3825                                   ,v-curr-db-num
     3826                                   ,buf_sysconf.firm-db-num
     3827                                   ).
     3828             return.
     3829           end.
     3830         end case.
     3831       end.
     3832       when no then do:
     3833       find first buf_clients where
     3834                 buf_clients.obj-type = p-obj-type
     3835             and buf_clients.obj-code = p-obj-code no-lock no-error.
     3836       if not available buf_clients then do:
     3837         return error substitute ("В платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4, которого нет в справочнике."
     3838                                 ,p-host-code
     3839                                 ,p-fin-doc-code
     3840                                 ,p-obj-type
     3841                                 ,p-obj-code).
     3842       end.
     3843         case v-cash:
     3844           when no then do:
     3845             case v-curr-db-num:
     3846               when buf_sysconf.firm-db-num then do:
     3847                 p-ok = yes.
     3848                 return.
     3849               end.
     3850               otherwise do:
     3851                 p-mess = substitute ("В Платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4,&5"+
     3852                                     "документы типа &6 могут создаваться/изменяться/удаляться только в главной БД фирмы&5" +
     3853                                     "номер текущей БД &7, номер главной БД фирмы &8"
     3854                                       ,p-host-code
     3855                                       ,p-fin-doc-code
     3856                                       ,p-obj-type
     3857                                       ,p-obj-code
     3858                                       ,chr(10)
     3859                                       ,p-fin-ext-doc-type
     3860                                       ,v-curr-db-num
     3861                                       ,buf_sysconf.firm-db-num).
     3862                 return.
     3863               end.
     3864             end case.
     3865           end.
     3866           when yes then do:
     3867             define variable v-cash-book as integer no-undo .
     3868   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3869   define variable v-param-type8 as character no-undo .
     3870   define variable v-value-date8 as date no-undo .
     3871   define variable v-value-decimal8 as decimal no-undo .
     3872   define variable v-value-character8 as INTEGER no-undo .
     3873   define variable v-value-logical8 AS LOGICAL no-undo .
     3874   define variable v-tth8 as handle no-undo .
     3875   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3877     (input  p-obj-type
     3878     ,input  p-obj-code
     3879     ,output v-obj-db-num
     3880     )  .
     3881             case v-cash-book:
     3882               when integer('1':U) then do:
     3883                 case v-curr-db-num:
     3884                   when v-obj-db-num then do:
     3885                     case p-cash-book-place:
     3886                       when '' then do:
     3887                         p-mess = substitute ("В Платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4,&5"+
     3888                                              "документы типа &6 могут создаваться/изменяться/удаляться на БД объекта,&5" +
     3889                                              "если на нем ведется Операционная кассовая книга,&5" +
     3890                                              "но при этом в платеже должна быть правильно указана Операционная касса"
     3891                                   ,p-host-code
     3892                                   ,p-fin-doc-code
     3893                                   ,p-obj-type
     3894                                   ,p-obj-code
     3895                                   ,chr(10)
     3896                                   ,p-fin-ext-doc-type
     3897                                               ).
     3898             return.
     3899           end.
     3900                       when v-obj-place-to-compare then do:
     3901                         p-mess = "".
     3902             p-ok = yes.
     3903           end.
     3904                       otherwise do:
     3905                         undo, return error substitute ("В Платежном документе с внутренним номером &2 (фирма &1) неверное значение Операционное кассы (&3)&4"
     3906                                               ,p-host-code
     3907                                               ,p-fin-doc-code
     3908                                               ,p-cash-book-place
     3909                                               , chr(10)
     3910                                               ).
     3911                       end.
     3912                     end.
     3913                   end.
     3914                   when buf_sysconf.firm-db-num then do:
     3915                     case p-cash-book-place:
     3916                       when '' then do:
     3917                         if p-is-auto-obj then do:
     3918                           v-is-auto-obj = p-is-auto-obj.
     3919                         end.
     3920         else do:
     3921                           run lib-farh_fautoobj in this-procedure ( input p-host-code
     3922                                                                   ,input p-fin-doc-code
     3923                                                                   ,output v-is-auto-obj) no-error.
     3924                         end.
     3925                         case v-is-auto-obj:
     3926                           when yes then do:
     3927                             p-ok = yes.
     3928                           end.
     3929                           otherwise do:
     3930             p-mess = substitute ("В платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4,&5"+
     3931                                                 "на БД объекта ведется Операционная кассовая книга&5" +
     3932                                                 "такие документы типа &6 могут создаваться/изменяться/удаляться только в БД объекта&5" +
     3933                                                 "номер текущей БД &7, ОПЕРАЦИОННАЯ КАССОВАЯ КНИГА ведется в БД &8"
     3934                                   ,p-host-code
     3935                                   ,p-fin-doc-code
     3936                                   ,p-obj-type
     3937                                   ,p-obj-code
     3938                                   ,chr(10)
     3939                                   ,p-fin-ext-doc-type
     3940                                   ,v-curr-db-num
     3941                                                   ,v-obj-db-num).
     3942           end.
     3943                         end.
     3944                       end.
     3945                       when v-obj-place-to-compare then do:
     3946                         p-mess = substitute ("В платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4,&5"+
     3947                                             "и указана Операционная касса &6,поэтому он может создаваться/изменяться/удаляться ТОЛЬКО&5" +
     3948                                             "в главной БД фирмы и ТОЛЬКО если там ведется Операционная кассовая книга&5" +
     3949                                             "номер текущей БД &7, Операционная кассовая книга ведется в БД &8"
     3950                                               ,p-host-code
     3951                                               ,p-fin-doc-code
     3952                                               ,p-obj-type
     3953                                               ,p-obj-code
     3954                                               ,chr(10)
     3955                                               ,p-fin-ext-doc-type
     3956                                               ,v-curr-db-num
     3957                                               ,v-obj-db-num).
     3958                       end.
     3959                       otherwise do:
     3960                         undo, return error  substitute ("В Платежном документе с внутренним номером &2 (фирма &1) неверное значение Операционное кассы (&3)&4"
     3961                                               ,p-host-code
     3962                                               ,p-fin-doc-code
     3963                                               ,p-cash-book-place
     3964                                               , chr(10)
     3965                                               ).
     3966                       end.
     3967                     end case.
     3968                   end.
     3969                   otherwise do:
     3970                     p-mess = substitute ("Платежный документ с внутренним номером &2 (фирма &1) не может создаватся/изменяться/удалястья в БД &3"
     3971                                           ,p-host-code
     3972                                           ,p-fin-doc-code
     3973                                           ,v-curr-db-num
     3974                                           ).
     3975                   end.
     3976                 end case.
     3977               end.
     3978               when integer('0':U) then do:
     3979                 case v-curr-db-num:
     3980                   when buf_sysconf.firm-db-num then do:
     3981                     case p-cash-book-place:
     3982                       when '' then do:
     3983                         p-mess = "".
     3984             p-ok = yes.
     3985           end.
     3986                       when v-obj-place-to-compare then do:
     3987                         p-mess = substitute ("В платежном документе с внутренним номером &2 (фирма &1) указан объект &3&4,&5"+
     3988                                             "и указана Операционная касса &6,однакоу он может создаваться/изменяться/удаляться ТОЛЬКО&5" +
     3989                                             "в главной БД фирмы потому что кассовая книга для &3&4 ведется там&5" +
     3990                                             "номер текущей БД &7, Операционная кассовая книга ведется в БД &8"
     3991                                 ,p-host-code
     3992                                 ,p-fin-doc-code
     3993                                 ,p-obj-type
     3994                                 ,p-obj-code
     3995                                 ,chr(10)
     3996                                 ,p-fin-ext-doc-type
     3997                                 ,v-curr-db-num
     3998                                 ,buf_sysconf.firm-db-num).
     3999         end.
     4000                       otherwise do:
     4001                         undo, return error  substitute ("В Платежном документе с внутренним номером &2 (фирма &1) неверное значение Операционное кассы (&3)&4"
     4002                                               ,p-host-code
     4003                                               ,p-fin-doc-code
     4004                                               ,p-cash-book-place
     4005                                               , chr(10)
     4006                                               ).
     4007                       end.
     4008                     end case.
     4009                   end.
     4010                   otherwise do:
     4011                     p-mess = substitute ("Платежный документ с внутренним номером &2 (фирма &1) не может создаваться/изменяться/удаляться&3" +
     4012                                          " не в главной БД фирмы, потому что кассовая книга для объекта ведется в Главной БД фирмы&3" +
     4013                                          "Текущая БД - &4 Главная Бд фирмы - &5"
     4014                                           ,p-host-code
     4015                                           ,p-fin-doc-code
     4016                                           ,chr(10)
     4017                                           ,v-curr-db-num
     4018                                           ,buf_sysconf.firm-db-num
     4019                                           ).
     4020                   end.
     4021                 end case.
     4022               end.
     4023               otherwise do:
     4024                 undo, return error substitute("Неверное значение места ведения кассовой книги (&3) для платежных документов по &1&2"
     4025                                              ,p-obj-type
     4026                                              ,p-obj-code
     4027                                              ,v-cash-book).
     4028         end.
     4029             end case.
     4030           end.
     4031         end case.
     4032       end.
     4033     end case.
     4034   end.
     4035   end procedure.
     4036   procedure lib-farh_fautoobj :
     4037   define input parameter p-host-code as integer no-undo .
     4038   define input parameter p-fin-doc-code as integer no-undo .
     4039   define output parameter p-is-auto-obj as logical no-undo .
     4040   define buffer buf_fin-connect  for ub.fin-connect.
     4041   define buffer buf_fin-ob  for ub.fin-ob.
     4042   find first buf_fin-connect no-lock where
     4043           buf_fin-connect.host-code      = p-host-code
     4044       AND buf_fin-connect.fin-doc-code   = p-fin-doc-code no-error.
     4045   if available buf_fin-connect then do:
     4046     find first buf_fin-ob no-lock where
     4047               buf_fin-ob.doc-code =  buf_fin-connect.fin-ob-code no-error .
     4048     if available buf_fin-ob and
     4049     not (buf_fin-ob.obj-type = "":U
     4050           and  buf_fin-ob.obj-code  = 0) then do:
     4051       assign
     4052       p-is-auto-obj = yes
     4053       .
     4054     end.
     4055   end.
     4056   end procedure.
