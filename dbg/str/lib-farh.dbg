      523   procedure fin-doc-attr-write :
      524    do
      525    on error undo, return error return-value
      526    :
      527   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      528   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      529   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      530   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      531   define variable  v-format         as character no-undo .
      532   define variable  v-label          as character no-undo .
      533   define variable  v-user-can-edit  as logical   no-undo .
      534   define variable  v-output-display as logical   no-undo .
      535   define variable  v-other          as character no-undo .
      536   define variable  v-type           as character no-undo .
      537   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      538   run fd-attr-code in this-procedure
      539                                     (input  p-attr-code
      540                                     ,output v-type
      541                                     ,output v-format
      542                                     ,output v-label
      543                                     ,output v-user-can-edit
      544                                     ,output v-output-display
      545                                     ,output v-other
      546                                     ) no-error .
      547   if error-status :error then do:
      548     undo, return error return-value .
      549   end.
      550   find first buf_fin-doc-attr  exclusive-lock  where
      551             buf_fin-doc-attr.attr-code    = p-attr-code
      552         AND buf_fin-doc-attr.host-code    = p-host-code
      553         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      554     if not available  buf_fin-doc-attr then do:
      555         create buf_fin-doc-attr.
      556         assign
      557         buf_fin-doc-attr.attr-code    = p-attr-code
      558         buf_fin-doc-attr.attr-value   = p-attr-value
      559         buf_fin-doc-attr.host-code    = p-host-code
      560         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      561         .
      562     end.
      563     else do:
      564          assign
      565          buf_fin-doc-attr.attr-value = p-attr-value.
      566     end.
      567    end.
      568   end procedure.
      569   procedure fd-attr-exist :
      570     do
      571     on error undo, return error
      572     :
      573       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      574       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      575       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      576       define output parameter p-exist   as logical  no-undo .
      577       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      578       define variable  v-type           as character no-undo .
      579       define variable  v-format         as character no-undo .
      580       define variable  v-label          as character no-undo .
      581       define variable  v-user-can-edit  as logical   no-undo .
      582       define variable  v-output-display as logical   no-undo .
      583       define variable  v-other          as character no-undo .
      584       run fd-attr-code in this-procedure
      585         (input  p-code
      586         ,output v-type
      587         ,output v-format
      588         ,output v-label
      589         ,output v-user-can-edit
      590         ,output v-output-display
      591         ,output v-other
      592         ) no-error .
      593       if error-status :error then do:
      594         undo, return error return-value .
      595       end.
      596       find first buf_fin-doc-attr exclusive-lock
      597         where buf_fin-doc-attr.host-code  = p-host-code
      598           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      599           and buf_fin-doc-attr.attr-code = p-code
      600         no-error .
      601       if  available buf_fin-doc-attr then do:
      602         p-exist = yes.
      603       end.
      604     end.
      605   end procedure.
      606   procedure fd-attr-delete :
      607     do
      608     on error undo, return error
      609     :
      610     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      611     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      612     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      613     define output parameter p-deleted  as logical no-undo.
      614       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      615       define variable  v-type           as character no-undo .
      616       define variable  v-format         as character no-undo .
      617       define variable  v-label          as character no-undo .
      618       define variable  v-user-can-edit  as logical   no-undo .
      619       define variable  v-output-display as logical   no-undo .
      620       define variable  v-other          as character no-undo .
      621       run fd-attr-code in this-procedure
      622         (input  p-code
      623         ,output v-type
      624         ,output v-format
      625         ,output v-label
      626         ,output v-user-can-edit
      627         ,output v-output-display
      628         ,output v-other
      629         ) no-error .
      630       if error-status :error then do:
      631         undo, return error return-value .
      632       end.
      633       find first buf_fin-doc-attr exclusive-lock
      634         where buf_fin-doc-attr.host-code  = p-host-code
      635           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      636           and buf_fin-doc-attr.attr-code = p-code
      637         no-error NO-WAIT.
      638       if not available buf_fin-doc-attr then do:
      639         p-deleted = no.
      640       end.
      641       else do:
      642         delete buf_fin-doc-attr no-error .
      643         if error-status:error then do:
      644           undo, return error return-value .
      645         end.
      646         p-deleted = yes.
      647       end.
      648     end.
      649   end procedure.
