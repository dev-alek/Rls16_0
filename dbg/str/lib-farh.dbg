      884   define stream str-err.
      885   procedure lib-farh_crfdsclk :
      886   define input parameter parhost-code    like ub.fin-doc-schet-lk.host-code    no-undo.
      887   define input parameter parcode-schet   like ub.fin-doc-schet-lk.code-schet   no-undo.
      888   define input parameter paruser-name    like ub.fin-doc-schet-lk.user-name    no-undo.
      889   define input parameter parfin-doc-code like ub.fin-doc-schet-lk.fin-doc-code no-undo.
      890   define input parameter partype-lock    like ub.fin-doc-schet-lk.type-lock    no-undo.
      891   define input parameter pardate-lock    like ub.fin-doc-schet-lk.date-lock    no-undo.
      892   define input parameter partime-lock    like ub.fin-doc-schet-lk.time-lock    no-undo.
      893   define buffer bf_fin-doc-schet-lk for ub.fin-doc-schet-lk.
      894   do on error undo, return error return-value :
      895   find first bf_fin-doc-schet-lk where bf_fin-doc-schet-lk.host-code  = parhost-code  and
      896                                        bf_fin-doc-schet-lk.code-schet = parcode-schet no-lock no-error.
      897   if not available bf_fin-doc-schet-lk then do:
      898     create bf_fin-doc-schet-lk.
      899     assign
      900       bf_fin-doc-schet-lk.host-code     = parhost-code
      901       bf_fin-doc-schet-lk.code-schet    = parcode-schet
      902       bf_fin-doc-schet-lk.user-name     = paruser-name
      903       bf_fin-doc-schet-lk.fin-doc-code  = parfin-doc-code
      904       bf_fin-doc-schet-lk.type-lock     = partype-lock
      905       bf_fin-doc-schet-lk.date-lock     = pardate-lock
      906       bf_fin-doc-schet-lk.time-lock     = partime-lock    .
      907   end.
      908   end.
      909   end procedure.
      910   procedure lib-farh_crfdcrlk :
      911   define input parameter parhost-code         like ub.fin-doc-schet-lk.host-code    no-undo.
      912   define input parameter parfin-code-cor-acc  like ub.fin-code-cor-acc.fin-code     no-undo.
      913   define input parameter paruser-name         like ub.fin-doc-schet-lk.user-name    no-undo.
      914   define input parameter parfin-doc-code      like ub.fin-doc-schet-lk.fin-doc-code no-undo.
      915   define input parameter partype-lock         like ub.fin-doc-schet-lk.type-lock    no-undo.
      916   define input parameter pardate-lock         like ub.fin-doc-schet-lk.date-lock    no-undo.
      917   define input parameter partime-lock         like ub.fin-doc-schet-lk.time-lock    no-undo.
      918   define buffer bf_fin-doc-cor-acc-lk for ub.fin-doc-cor-acc-lk.
      919   do on error undo, return error return-value :
      920   find first bf_fin-doc-cor-acc-lk where bf_fin-doc-cor-acc-lk.host-code = parhost-code        and
      921                                          bf_fin-doc-cor-acc-lk.fin-code  = parfin-code-cor-acc no-lock no-error.
      922   if not available bf_fin-doc-cor-acc-lk then do:
      923     create bf_fin-doc-cor-acc-lk.
      924     assign
      925       bf_fin-doc-cor-acc-lk.host-code     = parhost-code
      926       bf_fin-doc-cor-acc-lk.fin-code      = parfin-code-cor-acc
      927       bf_fin-doc-cor-acc-lk.user-name     = paruser-name
      928       bf_fin-doc-cor-acc-lk.fin-doc-code  = parfin-doc-code
      929       bf_fin-doc-cor-acc-lk.type-lock     = partype-lock
      930       bf_fin-doc-cor-acc-lk.date-lock     = pardate-lock
      931       bf_fin-doc-cor-acc-lk.time-lock     = partime-lock    .
      932   end.
      933   end.
      934   end procedure.
      935   procedure lib-farh_lkschdoc :
      936   define input parameter parhost-code    like ub.fin-schet.host-code.
      937   define input parameter parcode-schet   like ub.fin-schet.code-schet.
      938   define input parameter paruser-name    as character no-undo .
      939   define input parameter parfin-doc-code like ub.fin-doc.fin-doc-code.
      940   define buffer bf_fin-schet        for ub.fin-schet.
      941   define buffer bf_fin-doc-schet-lk for ub.fin-doc-schet-lk.
      942   do on error undo, return error return-value :
      943     find first bf_fin-schet where bf_fin-schet.host-code  = parhost-code  and
      944                                   bf_fin-schet.code-schet = parcode-schet no-lock no-error.
      945     if not available bf_fin-schet then do:
      946       return error substitute ("Не найден счет с внутренним номером &1 по фирме &2.", parcode-schet, parhost-code).
      947     end.
      948     find first bf_fin-doc-schet-lk where bf_fin-doc-schet-lk.host-code  = bf_fin-schet.host-code  and
      949                                          bf_fin-doc-schet-lk.code-schet = bf_fin-schet.code-schet exclusive-lock no-error.
      950     if not available bf_fin-doc-schet-lk then do:
      951       run lib-farh_crfdsclk in this-procedure
      952         (input bf_fin-schet.host-code,
      953          input bf_fin-schet.code-schet,
      954          input paruser-name,
      955          input parfin-doc-code,
      956          input "расчет финансовых архивов":u,
      957          input today,
      958          input time) no-error.
      959       if error-status:error then do:
      960         return error return-value.
      961       end.
      962     end.
      963     find first bf_fin-doc-schet-lk where bf_fin-doc-schet-lk.host-code  = bf_fin-schet.host-code  and
      964                                          bf_fin-doc-schet-lk.code-schet = bf_fin-schet.code-schet exclusive-lock.
      965   end.
      966   end procedure.
      967   procedure lib-farh_lkcordoc :
      968   define input parameter parhost-code        like ub.fin-schet.host-code.
      969   define input parameter parfin-code-cor-acc like ub.fin-code-cor-acc.fin-code.
      970   define input parameter paruser-name        as character no-undo .
      971   define input parameter pardoc-code         like ub.fin-doc.fin-doc-code.
      972   define buffer bf_fin-doc-cor-acc-lk for ub.fin-doc-cor-acc-lk.
      973   do on error undo, return error return-value :
      974     find first bf_fin-doc-cor-acc-lk where bf_fin-doc-cor-acc-lk.host-code = parhost-code        and
      975                                            bf_fin-doc-cor-acc-lk.fin-code  = parfin-code-cor-acc exclusive-lock no-error.
      976     if not available bf_fin-doc-cor-acc-lk then do:
      977       run lib-farh_crfdcrlk in this-procedure
      978         (input parhost-code       ,
      979          input parfin-code-cor-acc,
      980          input paruser-name,
      981          input pardoc-code,
      982          input "расчет финансовых архивов":u,
      983          input today,
      984          input time) no-error.
      985       if error-status:error then do:
      986         return error return-value.
      987       end.
      988     end.
      989     find first bf_fin-doc-cor-acc-lk where bf_fin-doc-cor-acc-lk.host-code = parhost-code        and
      990                                            bf_fin-doc-cor-acc-lk.fin-code  = parfin-code-cor-acc exclusive-lock.
      991   end.
      992   end procedure.
