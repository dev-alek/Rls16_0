     1048   define temp-table tt-sum-fin-ob-tax no-undo
     1049   field vat-pc        like ub.fin-ob-tax.vat-pc
     1050   field slt-pc        like ub.fin-ob-tax.slt-pc
     1051   field with-vat      like ub.fin-ob-tax.with-vat
     1052   field with-slt      like ub.fin-ob-tax.with-slt
     1053   field sum-vat-base  like ub.fin-ob-tax.sum-vat-line-base
     1054   field sum-vat-rubl  like ub.fin-ob-tax.sum-vat-line-rubl
     1055   field sum-vat-contr like ub.fin-ob-tax.sum-vat-line-contr
     1056   field sum-vat-doc   like ub.fin-doc.sum-doc
     1057   field sum-slt-base  like ub.fin-ob-tax.sum-slt-line-base
     1058   field sum-slt-rubl  like ub.fin-ob-tax.sum-slt-line-rubl
     1059   field sum-slt-contr like ub.fin-ob-tax.sum-slt-line-contr
     1060   field sum-slt-doc   like ub.fin-doc.sum-doc
     1061   index pi is unique primary vat-pc slt-pc with-vat with-slt.
     1062   procedure lib-farh_taskclcd:
     1063   define input parameter parhost-code    like ub.fin-doc.host-code    no-undo.
     1064   define input parameter parfin-doc-code like ub.fin-doc.fin-doc-code no-undo.
     1065   define input parameter pararh-name     as character no-undo .
     1066   define input parameter paruser-name    as character no-undo .
     1067   define input parameter parmode         as character no-undo .
     1068   define buffer bf_contract                for ub.contract.
     1069   define buffer bf_fin-doc                 for ub.fin-doc.
     1070   define buffer bf_fin-doc-tax             for ub.fin-doc-tax.
     1071   define buffer bf_sysconf                 for ub.sysconf.
     1072   define variable varrel-dog-code       as   logical               no-undo.
     1073   define variable varcurr-dog-code      like ub.currency.curr-code no-undo.
     1074   define variable varhave-connect       as   logical               no-undo.
     1075   define variable varznaksum-doc        as   decimal               no-undo.
     1076   define variable varznaksum-rubl       as   decimal               no-undo.
     1077   define variable varznaksum-base       as   decimal               no-undo.
     1078   define variable varznaksum-contr      as   decimal               no-undo.
     1079   define variable varznaksum-vat-doc    as   decimal               no-undo.
     1080   define variable varznaksum-vat-rubl   as   decimal               no-undo.
     1081   define variable varznaksum-vat-base   as   decimal               no-undo.
     1082   define variable varznaksum-vat-contr  as   decimal               no-undo.
     1083   define variable varznaksum-slt-doc    as   decimal               no-undo.
     1084   define variable varznaksum-slt-rubl   as   decimal               no-undo.
     1085   define variable varznaksum-slt-base   as   decimal               no-undo.
     1086   define variable varznaksum-slt-contr  as   decimal               no-undo.
     1087   define variable varfin-doc-tax-vat-pc as   decimal               no-undo.
     1088   define variable varfin-doc-tax-slt-pc as   decimal               no-undo.
     1089   define variable v-curr-db-num         as   integer               no-undo.
     1090   define variable v-is-income as logical no-undo .
     1091   define variable v-is-expense as logical no-undo .
     1092   define variable v-is-cash as logical no-undo .
     1093   define variable v-is-cashless as logical no-undo .
     1094   define variable v-is-payoff as logical no-undo .
     1095   define variable v-recalc as logical no-undo .
     1096   do on error undo, return error return-value :
     1097     find first bf_fin-doc where bf_fin-doc.host-code    = parhost-code    and
     1098                                 bf_fin-doc.fin-doc-code = parfin-doc-code exclusive-lock no-error.
     1099     if not available bf_fin-doc then do:
     1100       return error substitute ("Не найден платежный документ с внутренним номером &1 по фирме &2.", parfin-doc-code, parhost-code).
     1101     end.
     1102     if bf_fin-doc.contract-code <> 0 then do:
     1103       find first bf_contract where bf_contract.host-code     = bf_fin-doc.host-code     and
     1104                                    bf_contract.contract-code = bf_fin-doc.contract-code no-lock no-error.
     1105       if not available bf_contract then do:
     1106         return error substitute ("По платежному документу с внутренним номером &1 на фирме &2 указан договор с внутренним номером &3, которого нет в базе данных.", bf_fin-doc.fin-doc-code, bf_fin-doc.host-code, bf_fin-doc.contract-code).
     1107       end.
     1108       assign
     1109         varrel-dog-code  = yes
     1110         varcurr-dog-code = bf_contract.curr-code.
     1111     end.
     1112     else do:
     1113       assign
     1114         varrel-dog-code = no.
     1115     end.
     1116     find first bf_sysconf where bf_sysconf.host-code = bf_fin-doc.host-code no-lock.
     1117     if bf_sysconf.fin-calc = 1 then do:
     1118       run check-sum-doc  in this-procedure (input bf_fin-doc.host-code, input bf_fin-doc.fin-doc-code, output varhave-connect).
     1119     end.
     1120     if parmode <> "close":u  and
     1121        parmode <> "delete":u and
     1122        parmode <> "recalc":u then do:
     1123       return error substitute ("Неверный параметр вызова расчета финансовых архивов &1. Должен быть close или delete.", parmode).
     1124     end.
     1125     if parmode = "recalc":u  then do:
     1126       v-recalc = yes.
     1127       parmode = "close".
     1128     end.
     1129     if bf_fin-doc.status_ <> 'факт':U then do:
     1130       return error substitute ("Платежный документ с номером &1 не находится в статусе &2.", bf_fin-doc.prn-doc-code, 'факт':U).
     1131     end.
     1132     run check-attr-doc in this-procedure (input bf_fin-doc.host-code, input bf_fin-doc.fin-doc-code).
     1133     run full-lock in this-procedure (input bf_fin-doc.host-code, input bf_fin-doc.fin-doc-code, input paruser-name).
     1134     run calc-sum  in this-procedure (input parmode,
     1135                                      input bf_fin-doc.host-code,
     1136                                      input bf_fin-doc.fin-doc-code,
     1137                                      output varznaksum-doc      ,
     1138                                      output varznaksum-rubl     ,
     1139                                      output varznaksum-base     ,
     1140                                      output varznaksum-contr    ,
     1141                                      output varznaksum-vat-doc  ,
     1142                                      output varznaksum-vat-rubl ,
     1143                                      output varznaksum-vat-base ,
     1144                                      output varznaksum-vat-contr,
     1145                                      output varznaksum-slt-doc  ,
     1146                                      output varznaksum-slt-rubl ,
     1147                                      output varznaksum-slt-base ,
     1148                                      output varznaksum-slt-contr
     1149                                      ).
     1150   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1152     (output v-curr-db-num
     1153     )  .
     1154     assign
     1155     v-is-income = lookup(bf_fin-doc.fin-ext-doc-type, 'пко,ппп,апп':U) > 0
     1156     v-is-expense = lookup(bf_fin-doc.fin-ext-doc-type, 'рко,рпп,апр,':U) > 0
     1157     v-is-cash = lookup(bf_fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     1158     v-is-cashless = lookup(bf_fin-doc.fin-ext-doc-type, 'ппп,рпп':U) > 0
     1159     v-is-payoff = lookup(bf_fin-doc.fin-ext-doc-type, 'апп,апр':U) > 0
     1160     .
     1161     define variable v-obj-db-num as integer init ? no-undo .
     1162     if bf_fin-doc.obj-type <> ''  then do:
     1163   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1165     (input  bf_fin-doc.obj-type
     1166     ,input  bf_fin-doc.obj-code
     1167     ,output v-obj-db-num
     1168     )  .
     1169       if bf_fin-doc.shift-flag = integer('1':U)
     1170       and (v-obj-db-num = v-curr-db-num or v-recalc or v-curr-db-num = 0)
     1171       then do:
     1172       end.
     1173     end.
     1174     if v-obj-db-num = ? then  v-obj-db-num = bf_sysconf.firm-db-num.
     1175       if v-is-cashless then do:
     1176       if pararh-name = "all":u                        or
     1177       lookup ('arh-fin-doc-an':U, pararh-name) > 0  and  v-curr-db-num = v-obj-db-num then do:
     1178         if bf_sysconf.firm-db-num = v-curr-db-num then
     1179         run libfarhp_calc-arh-fin-doc-an in g#libfarhp (input parmode,
     1180                                                         input bf_fin-doc.host-code,
     1181                                                         input bf_fin-doc.payer-type,
     1182                                                         input bf_fin-doc.payer-code,
     1183                                                         input bf_fin-doc.receiver-type,
     1184                                                         input bf_fin-doc.receiver-code,
     1185                                                         input bf_fin-doc.payer-code-schet,
     1186                                                         input bf_fin-doc.receiver-code-schet,
     1187                                                         input bf_fin-doc.fin-ext-doc-type,
     1188                                                         input bf_fin-doc.an-uchet-code,
     1189                                                         input bf_fin-doc.cel-nazn-code,
     1190                                                         input bf_fin-doc.cor-acc,
     1191                                                         input '':U,
     1192                                                         input bf_fin-doc.fact-order,
     1193                                                         input bf_fin-doc.fin-doc-code,
     1194                                                         input bf_fin-doc.fact-date,
     1195                                                         input bf_fin-doc.curr-code,
     1196                                                         input bf_sysconf.base-code,
     1197                                                         input varcurr-dog-code,
     1198                                                         input varrel-dog-code,
     1199                                                         input varznaksum-doc      ,
     1200                                                         input varznaksum-rubl     ,
     1201                                                         input varznaksum-base     ,
     1202                                                         input varznaksum-contr    ,
     1203                                                         input varznaksum-vat-doc  ,
     1204                                                         input varznaksum-vat-rubl ,
     1205                                                         input varznaksum-vat-base ,
     1206                                                         input varznaksum-vat-contr,
     1207                                                         input varznaksum-slt-doc  ,
     1208                                                         input varznaksum-slt-rubl ,
     1209                                                         input varznaksum-slt-base ,
     1210                                                         input varznaksum-slt-contr
     1211                                                         ).
     1212         if bf_sysconf.firm-db-num = v-curr-db-num then
     1213         run libfarhp_calc-arh-fin-doc-an in g#libfarhp (input parmode,
     1214                                                         input bf_fin-doc.host-code,
     1215                                                         input bf_fin-doc.payer-type,
     1216                                                         input bf_fin-doc.payer-code,
     1217                                                         input bf_fin-doc.receiver-type,
     1218                                                         input bf_fin-doc.receiver-code,
     1219                                                         input bf_fin-doc.payer-code-schet,
     1220                                                         input bf_fin-doc.receiver-code-schet,
     1221                                                         input bf_fin-doc.fin-ext-doc-type,
     1222                                                         input bf_fin-doc.an-uchet-code,
     1223                                                         input 0,
     1224                                                         input 0,
     1225                                                         input 'sum-schet-uchet':U,
     1226                                                         input bf_fin-doc.fact-order,
     1227                                                         input bf_fin-doc.fin-doc-code,
     1228                                                         input bf_fin-doc.fact-date,
     1229                                                         input bf_fin-doc.curr-code,
     1230                                                         input bf_sysconf.base-code,
     1231                                                         input varcurr-dog-code,
     1232                                                         input varrel-dog-code,
     1233                                                         input varznaksum-doc      ,
     1234                                                         input varznaksum-rubl     ,
     1235                                                         input varznaksum-base     ,
     1236                                                         input varznaksum-contr    ,
     1237                                                         input varznaksum-vat-doc  ,
     1238                                                         input varznaksum-vat-rubl ,
     1239                                                         input varznaksum-vat-base ,
     1240                                                         input varznaksum-vat-contr,
     1241                                                         input varznaksum-slt-doc  ,
     1242                                                         input varznaksum-slt-rubl ,
     1243                                                         input varznaksum-slt-base ,
     1244                                                         input varznaksum-slt-contr
     1245                                                         ).
     1246         if bf_sysconf.firm-db-num = v-curr-db-num then
     1247         run libfarhp_calc-arh-fin-doc-an in g#libfarhp (input parmode,
     1248                                                         input bf_fin-doc.host-code,
     1249                                                         input bf_fin-doc.payer-type,
     1250                                                         input bf_fin-doc.payer-code,
     1251                                                         input bf_fin-doc.receiver-type,
     1252                                                         input bf_fin-doc.receiver-code,
