      421     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      422     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      423     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
