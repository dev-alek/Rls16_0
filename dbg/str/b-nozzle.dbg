      425     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      426     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      427     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      428     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      429     IF "":U = "":U THEN
      430       RUN modify-list-attribute IN adm-broker-hdl
      431         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      432     RUN use-create-on-add(?).
      433   PROCEDURE adm-add-record :
      434       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      435          "must have at least one Enabled Table to perform Add.":U
      436          VIEW-AS ALERT-BOX ERROR.
      437       RETURN.
      438   END PROCEDURE.
      439   PROCEDURE adm-assign-record :
      440    MESSAGE
      441          "Object ":U THIS-PROCEDURE:FILE-NAME
      442            "must have at least one Enabled Table to perform Assign.":U
      443              VIEW-AS ALERT-BOX ERROR.
      444      RETURN.
      445     END PROCEDURE.
      446   PROCEDURE adm-assign-statement :
      447     RETURN.
      448   END PROCEDURE.
      449   PROCEDURE adm-cancel-record :
      450      RETURN.
      451     END PROCEDURE.
      452   PROCEDURE adm-copy-record :
      453       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      454        "must have at least one Enabled Table to perform Copy.":U
      455          VIEW-AS ALERT-BOX ERROR.
      456       RETURN.
      457   END PROCEDURE.
      458   PROCEDURE adm-create-record :
      459      RETURN.
      460   END PROCEDURE.
      461   PROCEDURE adm-current-changed :
      462     RETURN.
      463   END PROCEDURE.
      464   PROCEDURE adm-delete-record :
      465    MESSAGE
      466          "Object ":U THIS-PROCEDURE:FILE-NAME
      467            "must have at least one Enabled Table to perform Delete.":U
      468              VIEW-AS ALERT-BOX ERROR.
      469       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      470       RETURN.
      471   END PROCEDURE.
      472   PROCEDURE adm-disable-fields :
      473         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      474       RETURN.
      475   END PROCEDURE.
      476   PROCEDURE adm-enable-fields :
      477       RETURN.
      478   END PROCEDURE.
      479   PROCEDURE adm-end-update :
      480     RETURN.
      481   END PROCEDURE.
      482   PROCEDURE adm-reset-record :
      483       RETURN.
      484   END PROCEDURE.
      485   PROCEDURE adm-update-record :
      486       MESSAGE
      487         "Object ":U THIS-PROCEDURE:FILE-NAME
      488           "must have at least one Enabled Table to perform Update.":U
      489             VIEW-AS ALERT-BOX ERROR.
      490      RETURN.
      491   END PROCEDURE.
      492   PROCEDURE check-modified :
      493   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      494   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      495   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      496   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      497     IF check-state = "check":U THEN
      498     DO:
      499       RUN get-link-handle IN adm-broker-hdl
      500         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      501            OUTPUT group-target-list).
      502       IF group-target-list NE "":U THEN
      503       DO i = 1 TO NUM-ENTRIES(group-target-list):
      504         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      505         RUN check-modified IN curr-widget ('group-check':U).
      506         IF RETURN-VALUE NE "":U THEN
      507         DO:
      508           RUN check-modified-message(RETURN-VALUE).
      509           RETURN "":U.
      510         END.
      511       END.
      512     END.
      513     RETURN "":U.
      514   END PROCEDURE.
      515   PROCEDURE check-modified-message :
      516     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      517        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      518           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      519        IF RETURN-VALUE = "YES":U THEN
      520           RUN notify ('view,CONTAINER-SOURCE':U).
      521        MESSAGE IF p-changed-table NE ? THEN
      522           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      523           ELSE "Current values have been changed."
      524           SKIP "  Do you wish to save those changes?"
      525           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      526        IF ANS THEN
      527        DO:
      528           IF group-assign-target THEN
      529             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      530           ELSE RUN dispatch('update-record':U).
      531           IF RETURN-VALUE = "ADM-ERROR":U THEN
      532           DO:
      533               MESSAGE "Changes to the previous record were not saved."
      534                 VIEW-AS ALERT-BOX ERROR.
      535               IF group-assign-target THEN
      536                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      537               ELSE RUN dispatch ('cancel-record':U).
      538           END.
      539        END.
      540        ELSE DO:
      541          IF group-assign-target THEN
      542             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      543          ELSE RUN dispatch('cancel-record':U).
      544        END.
      545        RETURN.
      546   END PROCEDURE.
      547   PROCEDURE get-rowid :
      548       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      549       ASSIGN
      550       p-table   =   adm-first-table.
      551       RETURN.
      552   END PROCEDURE.
      553   PROCEDURE init-group-assign :
      554       RUN request-attribute IN adm-broker-hdl
      555         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      556       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      557         group-assign-target = yes.
      558       ELSE group-assign-target = no.
      559       RETURN.
      560   END PROCEDURE.
      561   PROCEDURE set-editors :
      562       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      563       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      564       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      565       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      566       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      567       DO WHILE VALID-HANDLE (curr-widget):
      568           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      569              curr-widget:HIDDEN = no THEN DO:
      570             CASE p-field-setting:
      571               WHEN "INITIALIZE":U THEN
      572               DO:
      573                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      574                     read-only-list +
      575                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      576                        STRING(curr-widget).
      577               END.
      578               WHEN "DISABLE":U OR
      579               WHEN "ENABLE":U THEN
      580               DO:
      581                   curr-widget:SENSITIVE = yes.
      582                   RUN get-attribute ('Read-Only-Editors':U).
      583                   IF RETURN-VALUE = ? OR
      584                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      585                       curr-widget:READ-ONLY =
      586                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      587               END.
      588               WHEN "CLEAR":U THEN
      589                   curr-widget:SCREEN-VALUE = "":U.
      590             END CASE.
      591           END.
      592           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      593       END.
      594       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      595         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      596           + '"':U).
      597       RETURN.
      598   END PROCEDURE.
      599   PROCEDURE use-check-modified-all :
      600    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      601     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      602     RETURN.
      603   END PROCEDURE.
      604   PROCEDURE use-create-on-add :
      605   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      606      RETURN.
      607   END PROCEDURE.
      608   PROCEDURE use-initial-lock :
      609     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      610     ASSIGN adm-initial-lock = p-attr-value.
      611     RETURN.
      612   END PROCEDURE.
      613   PROCEDURE adm-display-fields :
      614         IF AVAILABLE ub.nozzle THEN
      615             DISPLAY ub.nozzle.nozzle-code WITH BROWSE br_table
      616               NO-ERROR.
      617         DISPLAY UNLESS-HIDDEN varPS
      618             WITH FRAME F-Main NO-ERROR.
      619       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      620       RETURN.
      621   END PROCEDURE.
      622   PROCEDURE adm-open-query :
      623               RUN dispatch ('open-query-cases':U).
      624           adm-query-opened = yes.
      625           IF NUM-RESULTS("br_table":U) = 0 THEN
      626               RUN new-state ('no-record-available,SELF':U).
      627           ELSE DO:
      628               RUN new-state ('record-available,SELF':U).
      629               RUN new-state ('first-record,SELF':U).
      630           END.
      631           IF NOT adm-updating-record THEN
      632               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      633     RETURN.
      634   END PROCEDURE.
      635   PROCEDURE adm-row-changed :
      636         IF VALID-HANDLE(adm-object-hdl) THEN
      637           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      638         RUN notify ('row-available':U).
      639         RETURN.
      640   END PROCEDURE.
      641   PROCEDURE reposition-query :
      642       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      643       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      644       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      645       IF table-name <> ? THEN
      646           REPOSITION br_table TO ROWID table-name NO-ERROR.
      647       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      648       RETURN.
      649   END PROCEDURE.
      650     adm-sts = br_table:SET-REPOSITIONED-ROW
      651       (br_table:DOWN,"CONDITIONAL":U).
      652     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      653   PROCEDURE set-size :
      654     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      655     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      656     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      657     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      658     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      659     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      660     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      661     ASSIGN pd_height = MAX(pd_height, 2.0)
      662            pd_width  = MAX(pd_width, 2.0)
      663            hBrowse     = br_table:HANDLE IN FRAME F-Main
      664            hFieldGroup = hBrowse:PARENT
      665            htmpWidget  = hFieldGroup:FIRST-CHILD
      666            hFrame      = hFieldGroup:PARENT.
      667     Search-For-Siblings:
      668     REPEAT WHILE VALID-HANDLE(htmpWidget):
      669       IF htmpWidget NE hBrowse THEN DO:
      670         IF htmpWidget:TYPE NE "BUTTON" OR
      671            htmpWidget:X    NE 4 OR
      672            htmpWidget:Y    NE 4 THEN DO:
      673           RETURN.
      674         END.
      675       END.
      676       htmpWidget = htmpWidget:NEXT-SIBLING.
      677     END.
      678     IF pd_width < hBrowse:WIDTH THEN
      679       ASSIGN hBrowse:WIDTH = pd_width
      680              hFrame:WIDTH  = pd_width     NO-ERROR.
      681     ELSE
      682       ASSIGN hFrame:WIDTH  = pd_width
      683              hBrowse:WIDTH = pd_width     NO-ERROR.
      684     IF pd_height < hBrowse:HEIGHT THEN
      685       ASSIGN hBrowse:HEIGHT = pd_height
      686              hFrame:HEIGHT  = pd_height     NO-ERROR.
      687     ELSE
      688       ASSIGN hFrame:HEIGHT  = pd_height
      689              hBrowse:HEIGHT = pd_height     NO-ERROR.
      690   END PROCEDURE.
      691   ASSIGN
      692          FRAME F-Main:SCROLLABLE       = FALSE
      693          FRAME F-Main:HIDDEN           = TRUE.
      694   ON CHOOSE OF b-add IN FRAME F-Main
      695   DO:
      696   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   do:
      698     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      699       (input  v-db-num
      700       ,input  v-userid
      701       ,input  0
      702       ,input  'actn_pump-reference_work':U
      703       ,input  'object':U
      704       ,input  v-host-code
      705       ,input  v-obj-type
      706       ,input  v-obj-code
      707       ,input  0
      708       ,input  0
      709       ,input  0
      710       ,input  true
      711       ,output glog
      712       )  .
      713   end.
      714     if NOT glog then return no-apply.
      715   define variable varrec-id as recid no-undo.
      716     CASE "nozzle"
      717     :
      718      WHEN "nozzle" THEN DO:
      719        run str/d-nozzle.w (input  varobj-type,
      720                        input  varobj-code,
      721                        output varrec-id) no-error.
      722      END.
      723      WHEN "plpmnz" THEN DO:
      724        run str/d-plpmnz.w
      725         ( input parparentproc
      726          ,input varobj-type
      727          ,input varobj-code
      728          ,output varrec-id
      729         ) no-error.
      730      END.
      731      WHEN "plpump" THEN DO:
      732        run str/d-plpump.w
      733         ( input parparentproc
      734          ,input varobj-type
      735          ,input varobj-code
      736          ,output varrec-id
      737         ) no-error.
      738      END.
      739      WHEN "pump" THEN DO:
      740        run str/d-pump.w
      741         ( input parparentproc
      742          ,input varobj-type
      743          ,input  varobj-code
      744          ,output varrec-id
      745         ) no-error.
      746      END.
      747      WHEN "pumpnz" THEN DO:
      748        run str/d-pumpnz.w
      749         ( input parparentproc
      750          ,input varobj-type
      751          ,input varobj-code
      752          ,output varrec-id
      753         ) no-error.
      754      END.
      755      OTHERWISE DO:
      756   message
      757     vss-workfile vss-revision vss-description skip
      758     "Неверное имя файла d-nozzle.w." skip
      759     "-----------Cистемная ошибка------------" skip
      760     return-value skip
      761     "------Ошибка исполнения программы------" skip
      762     trim(error-status :get-message(1)) +
      763     trim(error-status :get-message(2)) +
      764     trim(error-status :get-message(3)) +
      765     trim(error-status :get-message(4)) +
      766     trim(error-status :get-message(5)) skip
      767     view-as alert-box error .
      768        return no-apply.
      769      END.
      770     END CASE.
      771     if error-status:error then do:
      772   message
      773     vss-workfile vss-revision vss-description skip
      774     "Ошибка при вызове файла d-nozzle.w." skip
      775     "-----------Cистемная ошибка------------" skip
      776     return-value skip
      777     "------Ошибка исполнения программы------" skip
      778     trim(error-status :get-message(1)) +
      779     trim(error-status :get-message(2)) +
      780     trim(error-status :get-message(3)) +
      781     trim(error-status :get-message(4)) +
      782     trim(error-status :get-message(5)) skip
      783     view-as alert-box error .
      784        return no-apply.
      785     end.
      786     if varrec-id <> ? then do:
      787        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      788        REPOSITION br_table to recid varrec-id.
      789     end.
      790   END.
      791   ON CHOOSE OF B-del IN FRAME F-Main
      792   DO:
      793   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   do:
      795     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      796       (input  v-db-num
      797       ,input  v-userid
      798       ,input  0
      799       ,input  'actn_pump-reference_work':U
      800       ,input  'object':U
      801       ,input  v-host-code
      802       ,input  v-obj-type
      803       ,input  v-obj-code
      804       ,input  0
      805       ,input  0
      806       ,input  0
      807       ,input  true
      808       ,output glog
      809       )  .
      810   end.
      811     if NOT glog then return no-apply.
      812   if available ub.nozzle then do:
      813      assign varmes-log = no.
      814      message "Вы хотите удалить запись <<пистолет ТРК>> с номером " ub.nozzle.nozzle-code " ?" skip
      815              "ПРИ ЭТОМ БУДУТ УДАЛЕНЫ ВСЕ СВЯЗИ ПИСТОЛЕТА С ДАННЫМ НОМЕРОМ НА ВСЕХ РЕЗЕРВУАРАХ И ТРК!!!" skip
      816              "Вы уверены?"
      817              view-as alert-box question buttons yes-no update varmes-log.
      818     if varmes-log = yes then do:
      819        run nozzledv (input ub.nozzle.obj-type,
      820                      input ub.nozzle.obj-code,
      821                      input ub.nozzle.nozzle-code) no-error.
      822        if error-status:error then do:
      823   message
      824     vss-workfile vss-revision vss-description skip
      825     "Ошибка при удалении пистолета ТРК." skip
      826     "-----------Cистемная ошибка------------" skip
      827     return-value skip
      828     "------Ошибка исполнения программы------" skip
      829     trim(error-status :get-message(1)) +
      830     trim(error-status :get-message(2)) +
      831     trim(error-status :get-message(3)) +
      832     trim(error-status :get-message(4)) +
      833     trim(error-status :get-message(5)) skip
      834     view-as alert-box error .
      835           return no-apply.
      836        end.
      837        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      838     end.
      839   end.
      840   END.
      841   ON CHOOSE OF b-hist IN FRAME F-Main
      842   DO:
      843     define variable v-rec-list as character no-undo.
      844     if available ub.nozzle then do:
      845         run ref/cnzlhist.w (
      846                          INPUT parParentProc
      847                        , input ub.nozzle.obj-type
      848                        , input ub.nozzle.obj-code
      849                        , input "":U
      850                        , "one":U
      851                        , input ub.nozzle.obj-type
      852                        , input ub.nozzle.obj-code
      853                        , input ub.nozzle.nozzle-code
      854                        , input 0
      855                        , input 0
      856                        , input '':U
      857                        , input-output v-rec-list
      858                        ) no-error .
      859     end.
      860     apply "entry" to browse br_table.
      861   END.
      862   ON ROW-ENTRY OF br_table IN FRAME F-Main
      863   DO:
      864   END.
      865   ON ROW-LEAVE OF br_table IN FRAME F-Main
      866   DO:
      867   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      868   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      869   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      870     widget-enter = last-event:widget-enter.
      871     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      872     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      873       THEN widget-frame = widget-enter:FRAME.
      874     IF ((NOT VALID-HANDLE(widget-enter)) OR
      875         (widget-parent:TYPE = "BROWSE":U) OR
      876         (NOT VALID-HANDLE(widget-frame)) OR
      877         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      878     THEN DO:
      879         IF adm-brs-in-update THEN
      880         DO:
      881           MESSAGE
      882           "You must complete or cancel the update before leaving the current row."
      883               VIEW-AS ALERT-BOX WARNING.
      884           RETURN NO-APPLY.
      885         END.
      886         IF br_table:CURRENT-ROW-MODIFIED  OR
      887           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      888         DO:
      889           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      890           THEN DO:
      891             MESSAGE
      892             "Current record has been changed. " SKIP
      893             "Do you wish to save those changes?"
      894               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      895             IF l-save THEN
      896             DO:
      897                RUN dispatch('update-record':U).
      898                IF RETURN-VALUE = "ADM-ERROR":U THEN
      899                    RETURN NO-APPLY.
      900             END.
      901             ELSE RUN dispatch ('cancel-record':U).
      902           END.
      903           ELSE DO:
      904             RUN dispatch('update-record':U).
      905             IF RETURN-VALUE = "ADM-ERROR":U THEN
      906                 RETURN NO-APPLY.
      907           END.
      908         END.
      909     END.
      910   END.
      911   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      912   DO:
      913   RUN get-attribute('ADM-NEW-RECORD':U).
      914   IF RETURN-VALUE NE "YES":U THEN
      915     RUN notify ('row-available':U).
      916     run state-recid-nozzle.
      917   END.
      918   ON LEAVE OF varPS IN FRAME F-Main
      919   DO:
      920     define buffer bf_nozzle for ub.nozzle.
      921     if available ub.nozzle then do:
      922       if ub.nozzle.ps <> input frame F-Main varps then do:
      923         if varps-upd = no then do:
      924             message
      925               "Вы не можете изменять примечание!"
      926               view-as alert-box.
      927             display
      928               ub.nozzle.ps @ varps
      929               with frame F-Main
      930             .
      931         end.
      932         else do:
      933           assign
      934             varmes-log = yes
      935           .
      936           message
      937             "Вы хотите изменить примечание к " "пистолету ТРК"
      938             view-as alert-box question buttons yes-no update varmes-log.
      939           if varmes-log = true then do:
      940             do transaction
      941             on error  undo, retry
      942             on stop   undo, retry
      943             on endkey undo, retry
      944             :
      945               if retry then do:
      946                 message
      947                   vss-workfile vss-revision vss-description skip(1)
      948                   "Ошибка при сохранении PS!!!" skip
      949                   error-status :get-message(1) skip
      950                   return-value skip
      951                   view-as alert-box error .
      952                 return no-apply.
      953               end.
      954               find first bf_nozzle exclusive-lock
      955                 where recid(bf_nozzle) = recid(ub.nozzle)
      956               .
      957               assign
      958                 frame F-Main varps
      959               .
      960               assign
      961                 bf_nozzle.ps = varps
      962               .
      963             end.
      964           end.
      965           else do:
      966             assign
      967               varps = ub.nozzle.ps
      968             .
      969             display
      970               varps
      971               with frame F-Main
      972             .
      973           end.
      974         end.
      975       end.
      976     end.
      977   END.
      978   if not this-procedure :persistent
      979   then do:
      980     message
      981       vss-workfile vss-revision vss-description skip
      982       "Ошибка при запуске процедуры" skip
      983       "Данную процедуру следует запускать только с параметром persistent" skip
      984       view-as alert-box error .
      985     undo, return error .
      986   end.
      987   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   on help of frame F-Main
      989   do:
      990     run gbl/app_help.p
      991       (input this-procedure :file-name
      992       ,input ''
      993       ,input ?
      994       ) no-error.
      995     if error-status :error then do:
      996       message
      997         "Ошибка при вызове помощи"
      998         error-status :get-message(1)
      999         view-as alert-box .
     1000     end.
     1001   end.
     1002   run minbtn-set in this-procedure .
     1003   on choose of b-help in frame F-Main
     1004   do:
     1005     apply "help":u to frame F-Main .
     1006   end.
     1007   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   procedure minbtn-set :
     1009       do
     1010           on error undo, return error return-value
     1011           :
     1012           define variable ii              as integer       no-undo .
     1013           define variable fh              as widget-handle no-undo .
     1014           define variable hh              as widget-handle no-undo .
     1015           define variable v-h             as handle        extent 4 no-undo .
     1016           define variable v-name-button   as character     no-undo .
     1017           define variable v-help-old-x    as decimal       no-undo .
     1018           define variable v-help-old-y    as decimal       no-undo .
     1019           define variable v-help-old-size as decimal       no-undo .
     1020           define variable v-frame-width   as decimal       no-undo .
     1021           define variable jj              as integer       no-undo .
     1022           do
     1023               on error undo, return error
     1024               :
     1025               assign
     1026                   v-frame-width = frame F-Main:width - 0.3
     1027                   fh            = frame F-Main:first-child
     1028                   hh            = fh:first-child
     1029                   ii            = 1
     1030                   .
     1031               do while valid-handle(hh):
     1032                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1033                   do:
     1034                       case lc(hh:name) :
     1035                           when "b-help" then
     1036                               do:
     1037                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1038                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1039                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1040                                   hh:TOOLTIP = "Помощь" .
     1041                                   v-help-old-x = hh:column .
     1042                                   v-help-old-y = hh:row    .
     1043                                   v-help-old-size = hh:width .
     1044                                   hh:width-chars = 2.5 .
     1045                               end.
     1046                           when "b-print" then
     1047                               do:
     1048                                   hh:load-image("cmp/b-print.bmp":u) .
     1049                                   hh:TOOLTIP = "Печать" .
     1050                                   v-h[ii] = hh:handle .
     1051                                   ii = ii + 1 .
     1052                                   hh:width-chars = 3 .
     1053                               end.
     1054                           when "b-history" or
     1055                           when "b-hist" then
     1056                               do:
     1057                                   hh:load-image("cmp/b-hist.bmp":u) .
     1058                                   hh:TOOLTIP = "История" .
     1059                                   v-h[ii] = hh:handle .
     1060                                   ii = ii + 1 .
     1061                                   hh:width-chars = 3 .
     1062                               end.
     1063                           when "b-sch" then
     1064                               do:
     1065                                   hh:load-image("cmp/b-sch.bmp":u) .
     1066                                   hh:TOOLTIP = "Установка Фильтра" .
     1067                                   v-h[ii] = hh:handle .
     1068                                   ii = ii + 1 .
     1069                                   hh:width-chars = 3 .
     1070                               end.
     1071                           when "b-hist-user" then
     1072                               do:
     1073                                   hh:load-image("cmp/b-hist.bmp":u) .
     1074                                   hh:TOOLTIP = "История пользователя" .
     1075                                   ii = ii + 1 .
     1076                               end.
     1077                       end case.
     1078                   end.
     1079                   hh = hh:next-sibling.
     1080               end.
     1081               b-help:column = v-frame-width - b-help:width-chars.
     1082               jj = 0.
     1083               repeat ii = 4 to 1 by -1 :
     1084                   if valid-handle (v-h[ii] ) then
     1085                   do:
     1086                       jj  = jj + 1 .
     1087                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1088                       v-h[ii]:row    = v-help-old-y .
     1089                   end.
     1090               end.
     1091           end.
     1092       end.
     1093   end procedure.
     1094   PROCEDURE adm-open-query-cases :
     1095     OPEN QUERY br_table FOR EACH ub.nozzle WHERE ub.nozzle.obj-type = varobj-type and                                               ub.nozzle.obj-code = varobj-code NO-LOCK      INDEXED-REPOSITION.
     1096   END PROCEDURE.
     1097   PROCEDURE adm-row-available :
     1098     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1099     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1100     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1101     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1102     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1103     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1104     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1105     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1106     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1107     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1108     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1109     IF adm-updating-record THEN RETURN.
     1110     RUN get-attribute ('FIELDS-ENABLED':U).
     1111     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1112     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1113         OUTPUT link-handle) NO-ERROR.
     1114     IF link-handle = "":U THEN
     1115         RETURN.
     1116     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1117     IF NUM-ENTRIES(link-handle) > 1 THEN
     1118         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1119             "encountered more than one RECORD-SOURCE.":U SKIP
     1120             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1121                VIEW-AS ALERT-BOX ERROR.
     1122     RUN get-attribute ('Key-Name':U).
     1123     key-name = RETURN-VALUE.
     1124     IF key-name = "":U THEN key-name = ?.
     1125     IF key-name NE ? THEN DO:
     1126       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1127         NO-ERROR.
     1128       IF key-value NE ? THEN
     1129         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1130     END.
     1131   IF VALID-HANDLE (adm-object-hdl) THEN
     1132       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1133     IF key-name ne ? OR different-row
     1134     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1135     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1136   END PROCEDURE.
     1137   PROCEDURE disable_UI :
     1138     HIDE FRAME F-Main.
     1139     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1140   END PROCEDURE.
     1141   PROCEDURE local-initialize :
     1142   RUN request-attribute IN adm-broker-hdl
     1143       (INPUT THIS-PROCEDURE,
     1144        INPUT 'Container-Source':U,
     1145        INPUT 'parparentproc':U) NO-ERROR.
     1146   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "parparentproc" + " для получения данных." view-as alert-box error. return error.                    end.
     1147   assign parparentproc = widget-handle(return-value).
     1148   RUN request-attribute IN adm-broker-hdl
     1149       (INPUT THIS-PROCEDURE,
     1150        INPUT 'Container-Source':U,
     1151        INPUT 'obj-type':U) NO-ERROR.
     1152   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-type" + " для получения данных." view-as alert-box error. return error.                    end.
     1153   assign varobj-type = return-value.
     1154   RUN request-attribute IN adm-broker-hdl
     1155       (INPUT THIS-PROCEDURE,
     1156        INPUT 'Container-Source':U,
     1157        INPUT 'obj-code':U) NO-ERROR.
     1158   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-code" + " для получения данных." view-as alert-box error. return error.                    end.
     1159   assign varobj-code = integer(return-value).
     1160   RUN request-attribute IN adm-broker-hdl
     1161       (INPUT THIS-PROCEDURE,
     1162        INPUT 'Container-Source':U,
     1163        INPUT 'buttons':U) NO-ERROR.
     1164   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "buttons" + " для получения данных." view-as alert-box error. return error.                    end.
     1165   assign varbuttons = return-value.
     1166   assign varbuttons = replace (varbuttons, "|", ",").
     1167   if lookup('b-add', varbuttons) = 0 then do:
     1168     assign
     1169       b-add:sensitive in frame F-Main = no
     1170       b-add:visible   in frame F-Main = no
     1171       varps:read-only in frame F-Main = yes
     1172       varps-upd                    = no
     1173     .
     1174   end.
     1175   else do:
     1176     assign
     1177       varps-upd = yes
     1178     .
     1179   end.
     1180   if lookup('b-del', varbuttons) = 0 then
     1181      assign b-del:sensitive in frame F-Main = no
     1182             b-del:visible   in frame F-Main = no.
     1183     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1184   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185     run mainmenu_getcntxt in parparentproc
     1186       (output v-cntxt-db-num
     1187       ,output v-cntxt-userid
     1188       ,output v-cntxt-level
     1189       ,output v-cntxt-host-code-obj
     1190       ,output v-cntxt-obj-type
     1191       ,output v-cntxt-obj-code
     1192       ,output v-cntxt-db-num-obj
     1193       ,output v-cntxt-is-admin
     1194       ) .
     1195         assign
     1196           v-db-num    = v-cntxt-db-num
     1197           v-host-code = v-cntxt-host-code-obj
     1198           v-obj-code  = v-cntxt-obj-code
     1199           v-obj-type  = v-cntxt-obj-type
     1200           v-userid    = v-cntxt-userid
     1201           .
     1202     if available ub.nozzle then do:
     1203        assign varps     = ub.nozzle.ps.
     1204        display varps with frame F-Main.
     1205     end.
     1206     run state-recid-nozzle.
     1207   END PROCEDURE.
     1208   PROCEDURE send-key :
     1209   END PROCEDURE.
     1210   PROCEDURE send-records :
     1211     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1212     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1213     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1214     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1215     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1216     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1217         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1218         CASE ENTRY(i, p-tbl-list):
     1219       WHEN "ub.nozzle":U THEN p-rowid-list = p-rowid-list +
     1220           IF AVAILABLE ub.nozzle THEN STRING(ROWID(ub.nozzle))
     1221           ELSE "?":U.
     1222           OTHERWISE
     1223           DO:
     1224               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1225                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1226               IF link-handle NE "":U THEN
     1227               DO:
     1228                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1229                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1230                               "encountered more than one RECORD-SOURCE.":U SKIP
     1231                               "The first will be used.":U
     1232                               VIEW-AS ALERT-BOX ERROR.
     1233                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1234                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1235                   p-rowid-list = p-rowid-list + rowid-string.
     1236               END.
     1237               ELSE
     1238               DO:
     1239                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1240                           "does not match tables in send-records":U
     1241                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1242                           "Check that objects are linked properly and that":U
     1243                           "database qualification is consistent.":U
     1244                       VIEW-AS ALERT-BOX ERROR.
     1245                   RETURN ERROR.
     1246               END.
     1247           END.
     1248           END CASE.
     1249       END.
     1250   END PROCEDURE.
     1251   PROCEDURE state-changed :
     1252     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1253     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1254     CASE p-state:
     1255       WHEN "update-begin":U THEN
     1256       DO:
     1257           adm-brs-in-update = yes.
     1258           RUN dispatch ('enable-fields':U).
     1259           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1260           DO:
     1261             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1262             RUN new-state('update-complete':U).
     1263           END.
     1264           ELSE DO:
     1265             RUN dispatch ('apply-entry':U).
     1266             RUN new-state('update':U).
     1267           END.
     1268       END.
     1269       WHEN "update":U THEN
     1270         DO:
     1271           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1272           RUN get-link-handle IN adm-broker-hdl
     1273               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1274                   NO-ERROR.
     1275           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1276             br_table:SENSITIVE IN FRAME F-Main = no.
     1277         END.
     1278       WHEN "update-complete":U THEN DO:
     1279           br_table:SENSITIVE IN FRAME F-Main = yes.
     1280           adm-brs-in-update = no.
     1281           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1282           IF RETURN-VALUE NE "YES":U THEN
     1283           DO:
     1284             IF NUM-RESULTS("br_table":U) NE ? AND
     1285                NUM-RESULTS("br_table":U) NE 0
     1286             THEN DO:
     1287               GET CURRENT br_table.
     1288               RUN dispatch ('row-changed':U).
     1289             END.
     1290           END.
     1291           RUN new-state ('update-complete':U).
     1292       END.
     1293       WHEN "delete-complete":U THEN DO:
     1294          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1295          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1296          IF NUM-RESULTS("br_table":U) = 0 THEN
     1297            RUN notify('row-available':U).
     1298       END.
     1299       WHEN   'first-record':U        OR
     1300         WHEN 'last-record':U         OR
     1301         WHEN 'only-record':U         OR
     1302         WHEN 'not-first-or-last':U   OR
     1303         WHEN 'no-record-available':U OR
     1304         WHEN 'no-external-record-available':U THEN
     1305           RUN set-attribute-list('Query-Position=':U + p-state).
     1306     END CASE.
     1307   END PROCEDURE.
     1308   PROCEDURE state-recid-nozzle :
     1309   if available ub.nozzle then do:
     1310        assign varPS = ub.nozzle.pS.
     1311        display varPS with frame F-Main.
     1312        run set-attribute-list ("recid-nozzle=" + string(recid(ub.nozzle))).
     1313        run notify ('recid-nozzle,recid-nozzle-target':u).
     1314     end.
     1315   END PROCEDURE.
