        1   CREATE WIDGET-POOL.
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Smart browser общения с пистолетами ТРК".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable varmes-log as logical no-undo.
      132   define variable parparentproc as widget-handle no-undo .
      133   define variable varobj-type like ub.clients.obj-type no-undo.
      134   define variable varobj-code like ub.clients.obj-code no-undo.
      135   define variable varbuttons  as   character        no-undo.
      136   define variable varps-upd   as   logical          no-undo.
      137   procedure nozzledv:
      138   define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      139   define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      140   define input parameter parnozzle-code like ub.nozzle.nozzle-code no-undo.
      141   define buffer bf_clients        for ub.clients.
      142   define buffer bf_nozzle         for ub.nozzle.
      143   define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
      144   define buffer bf_pump-nozzle    for ub.pump-nozzle.
      145   define variable varrec-id as recid no-undo.
      146   define variable varmes-log as logical no-undo.
      147   define variable varobj-type like ub.clients.obj-type no-undo.
      148   define variable varobj-code like ub.clients.obj-code no-undo.
      149   define variable varbuttons  as   character        no-undo.
      150   define variable varps-upd   as   logical          no-undo.
      151   find first bf_clients where bf_clients.obj-type = parobj-type and
      152                               bf_clients.obj-code = parobj-code no-lock no-error.
      153   if not available bf_clients then
      154      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      155   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      156                              bf_nozzle.obj-code    = parobj-code    and
      157                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      158   if not available bf_nozzle then do:
      159      return error SUBSTITUTE("Не найден пистолет с номером &1", parnozzle-code)
      160                   + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      161   end.
      162   assign varrec-id = RECID(bf_nozzle).
      163   run chkcsptr (input parobj-type,
      164                 input parobj-code) no-error.
      165   if error-status:error then return error trim(return-value) +
      166                                           trim(error-status:get-message(1)) +
      167                                           trim(error-status:get-message(2)) +
      168                                           trim(error-status:get-message(3)) +
      169                                           trim(error-status:get-message(4)) +
      170                                           trim(error-status:get-message(5)).
      171   tr:
      172   do transaction on error undo tr, return error
      173                  on stop  undo tr, return error
      174                  on quit  undo tr, return error :
      175     for each bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = parobj-type    and
      176                                      bf_pl-pump-nozzle.obj-code    = parobj-code    and
      177                                      bf_pl-pump-nozzle.nozzle-code = parnozzle-code exclusive-lock
      178                                      on error undo tr, return error
      179                                      on stop  undo tr, return error
      180                                      on quit  undo tr, return error :
      181         delete bf_pl-pump-nozzle.
      182     end.
      183     for each bf_pump-nozzle    where bf_pump-nozzle.obj-type       = parobj-type    and
      184                                      bf_pump-nozzle.obj-code       = parobj-code    and
      185                                      bf_pump-nozzle.nozzle-code    = parnozzle-code exclusive-lock
      186                                      on error undo tr, return error
      187                                      on stop  undo tr, return error
      188                                      on quit  undo tr, return error :
      189         delete bf_pump-nozzle.
      190     end.
      191     find first bf_nozzle where RECID(bf_nozzle) = varrec-id exclusive-lock.
      192     delete bf_nozzle.
      193   end.
      194   end procedure.
      195   procedure chkcsptr:
      196   define input parameter parobj-type   like ub.clients.obj-type     no-undo.
      197   define input parameter parobj-code   like ub.clients.obj-code     no-undo.
      198   define variable        varretobjat   as   character            no-undo.
      199   define variable        varshift-date like ub.shift-obj.shift-date no-undo.
      200   define variable        varshift-num  like ub.shift-obj.shift-num  no-undo.
      201   define buffer bf_clients   for ub.clients.
      202   define buffer bf_shift-obj for ub.shift-obj.
      203   define buffer bf_rvs-doc   for ub.rvs-doc.
      204   find first bf_clients where bf_clients.obj-type = parobj-type and
      205                               bf_clients.obj-code = parobj-code no-lock no-error.
      206   if not available bf_clients then return error "Нет такого объекта " + parobj-type +
      207                                                 " "                   + string(parobj-code) + ".".
      208   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      210     (input  parobj-type
      211     ,input  parobj-code
      212     ,input  'shift-on=request'
      213     ,output varretobjat
      214     ) no-error .
      215   if error-status:error then  return error "Ошибка при вызове файла library.p: objat".
      216   if varretobjat <> "yes" then do:
      217      return error "Фатальная ошибка. На объекте " + parobj-type + " " + string(parobj-code) + " не включены смены.".
      218   end.
      219   find first bf_shift-obj
      220        where bf_shift-obj.obj-type = parobj-type
      221          and bf_shift-obj.obj-code = parobj-code
      222          and bf_shift-obj.status_  = 'тек':U
      223         use-index pi no-error .
      224   if available bf_shift-obj then do:
      225      find first bf_rvs-doc where bf_rvs-doc.obj-type   = parobj-type             and
      226                                  bf_rvs-doc.obj-code   = parobj-code             and
      227                                  bf_rvs-doc.shift-date = bf_shift-obj.shift-date and
      228                                  bf_rvs-doc.shift-num  = bf_shift-obj.shift-num  and
      229                                  bf_rvs-doc.status_    = 'факт':U                 and
      230                                  bf_rvs-doc.rvs-type   = 'смена':U            no-lock no-error.
      231      if not available bf_rvs-doc then
      232      return error "Смена открыта и не сделан документ сверки типа 'смена' за текущую смену.".
      233   end.
      234   end procedure.
      235         define variable v-chk-act-host-code as integer   no-undo .
      236         define variable glog                as logical   no-undo .
      237         define variable v-userid            as character no-undo .
      238         define variable v-db-num            as integer   no-undo .
      239         define variable v-host-code         as integer   no-undo .
      240         define variable v-obj-type          as character no-undo .
      241         define variable v-obj-code          as integer   no-undo .
      242   RUN set-attribute-list (
      243       'Keys-Accepted = ,
      244        Keys-Supplied = ':U).
      245   RUN set-attribute-list (
      246       'SortBy-Options = ""':U).
      247   DEFINE BUTTON b-add
      248        LABEL "Добавить"
      249        SIZE 10 BY 1.
      250   DEFINE BUTTON B-del
      251        LABEL "&Удалить"
      252        SIZE 10 BY 1.
      253   DEFINE BUTTON b-help
      254        LABEL "&Помощь"
      255        SIZE 10 BY 1.
      256   DEFINE BUTTON b-hist
      257        LABEL "&История"
      258        SIZE 10 BY 1.
      259   DEFINE VARIABLE varPS AS CHARACTER FORMAT "X(256)":U
      260        VIEW-AS FILL-IN
      261        SIZE 46.25 BY 1.88 NO-UNDO.
      262   DEFINE QUERY br_table FOR
      263         ub.nozzle SCROLLING.
      264   DEFINE BROWSE br_table
      265     QUERY br_table NO-LOCK DISPLAY
      266         ub.nozzle.nozzle-code
      267       WITH NO-ASSIGN SEPARATORS SIZE 17.88 BY 7.29.
      268   DEFINE FRAME F-Main
      269        br_table AT ROW 1 COL 1
      270        varPS AT ROW 8.42 COL 1 NO-LABEL
      271        b-add AT ROW 10.54 COL 1.38
      272        B-del AT ROW 10.54 COL 11.75
      273        b-hist AT ROW 10.54 COL 22.13
      274        b-help AT ROW 10.54 COL 32.5
      275       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      276            SIDE-LABELS NO-UNDERLINE THREE-D
      277            AT COL 1 ROW 1 SCROLLABLE
      278            BGCOLOR 8 FGCOLOR 0 .
      279   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      280   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      281   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      282   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      283   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      284   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      285   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      286   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      287   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      288   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      289   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      290         adm-object-hdl = FRAME F-Main:HANDLE.
      291   RUN ensure-broker.
      292   THIS-PROCEDURE:ADM-DATA =
      293        'ADM1.1~`':U +
      294        'SmartObject~`':U +
      295        '~`':U +
      296        'YES~`':U +
      297        '~`':U +
      298        'ub.nozzle~`':U +
      299        '~`':U +
      300        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      301           + "~`":U +
      302        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      303        'Record-Source,Record-Target,TableIO-Target~`':U +
      304        '~`':U +
      305        '~`~`~`~`~`~`~`~`~`~`~`':U +
      306        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      307            THEN "^^":U
      308        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      309             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      310   PROCEDURE adm-apply-entry :
      311     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      312   END PROCEDURE.
      313   PROCEDURE adm-destroy :
      314    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      315   END PROCEDURE.
      316   PROCEDURE adm-disable :
      317       DISABLE br_table varPS b-add B-del b-hist b-help WITH FRAME F-Main.
      318       RUN dispatch ('disable-fields':U).
      319       RUN set-attribute-list ('ENABLED=no':U).
      320       RETURN.
      321   END PROCEDURE.
      322   PROCEDURE adm-edit-attribute-list :
      323         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      324         RETURN.
      325   END PROCEDURE.
      326   PROCEDURE adm-enable :
      327       ENABLE UNLESS-HIDDEN br_table varPS b-add B-del b-hist b-help WITH FRAME F-Main.
      328       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      329       RUN set-attribute-list ('ENABLED=yes':U).
      330       RETURN.
      331   END PROCEDURE.
      332   PROCEDURE adm-exit :
      333        RUN notify ('exit':U).
      334     RETURN.
      335   END PROCEDURE.
      336   PROCEDURE adm-hide :
      337     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      338   END PROCEDURE.
      339   PROCEDURE adm-initialize :
      340     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      341   END PROCEDURE.
      342   PROCEDURE adm-show-errors :
      343       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      344       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      345           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      346       END.
      347       RETURN.
      348   END PROCEDURE.
      349   PROCEDURE adm-UIB-mode :
      350     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      351   END PROCEDURE.
      352   PROCEDURE adm-view :
      353     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      354   END PROCEDURE.
      355   PROCEDURE dispatch :
      356       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      357       RUN broker-dispatch IN adm-broker-hdl
      358           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      359       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      360   END PROCEDURE.
      361   PROCEDURE ensure-broker :
      362   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      363   IF RETURN-VALUE NE "ADM-Broker":U THEN
      364   DO:
      365       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      366       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      367   END.
      368   END PROCEDURE.
      369   PROCEDURE get-attribute :
      370     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      371     RUN broker-get-attribute IN adm-broker-hdl
      372         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      373     RETURN RETURN-VALUE.
      374   END PROCEDURE.
      375   PROCEDURE get-attribute-list :
      376     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      377     RUN broker-get-attribute-list IN adm-broker-hdl
      378         (INPUT THIS-PROCEDURE,
      379          INPUT ?,
      380          OUTPUT p-attr-list) NO-ERROR.
      381     RETURN.
      382   END PROCEDURE.
      383   PROCEDURE new-state :
      384     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      385     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      386     RETURN.
      387   END PROCEDURE.
      388   PROCEDURE notify :
      389     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      390     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      391     IF RETURN-VALUE = "ADM-ERROR":U THEN
      392         RETURN "ADM-ERROR":U.
      393     RETURN.
      394   END PROCEDURE.
      395   PROCEDURE set-attribute-list :
      396     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      397     RUN ensure-broker.
      398     RUN broker-set-attribute-list IN adm-broker-hdl
      399         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      400     RETURN.
      401   END PROCEDURE.
      402   PROCEDURE set-position :
      403       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      404       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      405       IF VALID-HANDLE(adm-object-hdl) THEN
      406       DO:
      407         ASSIGN adm-object-hdl:ROW    =   p-row
      408                adm-object-hdl:COLUMN =   p-col.
      409       END.
      410       RETURN.
      411   END PROCEDURE.
      412     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      413     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      414     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      415     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      416     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      417     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      418     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      419     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
