        1   define parameter buffer bf_goods      for ub.goods.
        2   define input parameter paranother-gds-code like ub.goods.gds-code no-undo.
        3   define input  parameter pardoc-code  as character no-undo.
        4   define input  parameter parobj-type  as character no-undo.
        5   define input  parameter parobj-code  as integer   no-undo.
        6   define input  parameter parwrite-off as logical   no-undo.
        7   define input  parameter parmode      as character no-undo.
        8   define output parameter parstate     as logical initial no no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Обработка топливных товаров в документе пересортица".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define new global shared variable g#lib-trn  as handle no-undo .
      119   define new global shared variable g#lib-trn2 as handle no-undo .
      120   define new global shared variable g#lib-trn3 as handle no-undo .
      121   define new global shared variable g#lib-trn4 as handle no-undo .
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      125   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      126   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      127   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      128   define variable ptrlprop-autopump      as logical   no-undo initial false .
      129   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      130   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      131   define variable ptrlprop-olddens       as logical   no-undo initial false .
      132   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      133   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      134   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      135   define variable ptrlprop-algoincome as integer no-undo init 0.
      136   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      137   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      138   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      139   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      140   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      141   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      142   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      143   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      144   define variable ptrlprop-block-nozzle as logical no-undo init false.
      145   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      146   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      147   procedure get-ptrl-prop :
      148     define input  parameter p-obj-type as character no-undo .
      149     define input  parameter p-obj-code as integer   no-undo .
      150     do
      151     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      152     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      153     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      154     :
      155       define variable par-type          as character no-undo.
      156       define variable v-value-character as character no-undo .
      157       define variable v-value-date      as date      no-undo .
      158       define variable v-value-decimal   as decimal   no-undo .
      159       define variable v-value-integer   as integer   no-undo .
      160       define variable v-value-logical   as logical   no-undo .
      161       for each thbjattr_thbj-attr
      162       :
      163         delete thbjattr_thbj-attr .
      164       end.
      165       run adm/shattri.p
      166         ( input "get":U
      167         , input p-obj-type
      168         , input p-obj-code
      169         , input 'petrol':U
      170         , input  ""
      171         , output v-value-character
      172         , output v-value-date
      173         , output v-value-decimal
      174         , output v-value-integer
      175         , output v-value-logical
      176         , output par-type
      177         , input-output table thbjattr_thbj-attr
      178         ) no-error .
      179       for each thbjattr_thbj-attr
      180       on error undo, return error return-value
      181       :
      182         case thbjattr_thbj-attr.prop-code :
      183           when 'denstclc':U then do:
      184             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      185               assign
      186                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      187               .
      188             end.
      189           end.
      190           when 'expptrl':U then do:
      191             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      192               and thbjattr_thbj-attr.prop-value-type = 'character':U
      193             then do:
      194               assign
      195                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      196               .
      197             end.
      198           end.
      199           when 'inpptrl':U then do:
      200             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      201               and thbjattr_thbj-attr.prop-value-type = 'character':U
      202             then do:
      203               assign
      204                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      205               .
      206             end.
      207           end.
      208           when 'autopump':U then do:
      209             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      210               assign
      211                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      212               .
      213             end.
      214           end.
      215           when 'rvsnmter':U then do:
      216             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      217               assign
      218                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      219               .
      220             end.
      221           end.
      222           when 'avtinvpm':U then do:
      223             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      224               assign
      225                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      226               .
      227             end.
      228           end.
      229           when 'invclipt':U then do:
      230             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      231               assign
      232                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      233               .
      234             end.
      235           end.
      236           when 'olddens':U then do:
      237             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      238               assign
      239                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      240               .
      241             end.
      242           end.
      243           when 'algrvspt':U then do:
      244             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      245               assign
      246                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      247               .
      248             end.
      249           end.
      250           when 'temp-for-pomi':U then do:
      251             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      252               assign
      253                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      254               .
      255             end.
      256           end.
      257           when 'algoincome':U then do:
      258             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      259               assign
      260                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      261               .
      262             end.
      263           end.
      264           when 'mand-choice-autocar':U then do:
      265             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      266               assign
      267                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      268               .
      269             end.
      270           end.
      271           when 'block-nozzle':U then do:
      272             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      273               assign
      274                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      275               .
      276             end.
      277           end.
      278           when 'timeout-block-nozzle':U then do:
      279             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      280               assign
      281                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      282               .
      283             end.
      284           end.
      285           when 'Delta-mass-horiz':U then do:
      286             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      287               assign
      288                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      289               .
      290             end.
      291           end.
      292           when 'Delta-mass-vert':U then do:
      293             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      294               assign
      295                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      296               .
      297             end.
      298           end.
      299           when 'calc-free-vol':U then do:
      300             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      301               assign
      302                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      303               .
      304             end.
      305           end.
      306           when 'calc-free-vol-sug':U then do:
      307             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      308               assign
      309                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      310               .
      311             end.
      312           end.
      313           when 'trn-reas-sug':U then do:
      314             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      315               assign
      316                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      317               .
      318             end.
      319           end.
      320                 when 'rvd-own-nb':U then do:
      321             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      322               assign
      323                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      324               .
      325             end.
      326           end.
      327           when 'qr-scan-time':U then do:
      328             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      329               assign
      330                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      331               .
      332             end.
      333           end.
      334           when 'autopump-skip-time':U then do:
      335             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      336               assign
      337                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      338               .
      339             end.
      340           end.
      341         end case.
      342         delete thbjattr_thbj-attr .
      343       end.
      344     end.
      345     return .
      346   end procedure.
      347   DEFINE SHARED TEMP-TABLE tt-place NO-UNDO
      348       FIELD pl-code             LIKE ub.place.pl-code
      349       FIELD loc1                LIKE ub.place.loc1
      350       FIELD pl-name             LIKE ub.place.pl-name
      351       FIELD before-l            AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      352       FIELD before-kg           AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      353       FIELD write-off-l         AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      354       FIELD income-l            AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      355       FIELD write-off-kg        AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      356       FIELD income-kg           AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      357       FIELD write-off-doc-l     AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      358       FIELD income-doc-l        AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      359       FIELD write-off-doc-kg    AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      360       FIELD income-doc-kg       AS   DECIMAL FORMAT "->,>>>,>>>,>>9.9999"
      361       INDEX pi IS UNIQUE PRIMARY pl-code.
      362   DEFINE BUFFER bf_gds-obj  FOR ub.gds-obj.
      363   DEFINE BUFFER bf_doc-line FOR ub.doc-line.
      364   DEFINE BUFFER bf_inv-line FOR ub.inv-line.
      365   DEFINE BUFFER bf_clients  FOR ub.clients.
      366   DEFINE BUTTON b-cancel AUTO-END-KEY
      367        LABEL "&Отмена"
      368        SIZE 10 BY 1
      369        BGCOLOR 8 .
      370   DEFINE BUTTON b-chg
      371        LABEL "&Изменить"
      372        SIZE 10 BY 1.
      373   DEFINE BUTTON b-help
      374        LABEL "&Помощь"
      375        SIZE 10 BY 1
      376        BGCOLOR 8 .
      377   DEFINE BUTTON b-save AUTO-GO
      378        LABEL "&Сохранить"
      379        SIZE 10 BY 1
      380        BGCOLOR 8 .
      381   DEFINE VARIABLE varafter-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      382        LABEL "Остаток (л)"
      383        VIEW-AS FILL-IN
      384        SIZE 13 BY 1 NO-UNDO.
      385   DEFINE VARIABLE varbefore-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      386        LABEL "Факт(л)"
      387        VIEW-AS FILL-IN
      388        SIZE 13 BY 1 NO-UNDO.
      389   DEFINE VARIABLE varwork-kg AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      390        LABEL "По документу(кг)"
      391        VIEW-AS FILL-IN
      392        SIZE 13 BY 1 NO-UNDO.
      393   DEFINE VARIABLE varwork-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      394        LABEL "По документу(л)"
      395        VIEW-AS FILL-IN
      396        SIZE 13 BY 1 NO-UNDO.
      397   DEFINE QUERY b-place FOR
      398         tt-place SCROLLING.
      399   DEFINE BROWSE b-place
      400     QUERY b-place DISPLAY
      401         pl-code             COLUMN-LABEL "Бар-код рез." FORMAT "99999999999":U
      402   loc1                COLUMN-LABEL "Код"
      403   pl-name             COLUMN-LABEL "Название"
      404   before-l            COLUMN-LABEL "Факт(л)"
      405   write-off-l         COLUMN-LABEL "Списано(л)"
      406   income-l            COLUMN-LABEL "Оприходовано(л)"
      407   write-off-kg        COLUMN-LABEL "Списано(кг)"
      408   income-kg           COLUMN-LABEL "Оприходовано(кг)"
      409   write-off-doc-l     COLUMN-LABEL "Списано в док(л)"
      410   income-doc-l        COLUMN-LABEL "Оприходовано в док(л)"
      411   write-off-doc-kg    COLUMN-LABEL "Списано в док(кг)"
      412   income-doc-kg       COLUMN-LABEL "Оприходовано в док(кг)"
      413       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.25 BY 15.75 EXPANDABLE.
      414   DEFINE FRAME frame-place
      415        b-save AT ROW 1 COL 1
      416        b-cancel AT ROW 1 COL 11
      417        b-chg AT ROW 1 COL 21
      418        b-help AT ROW 1 COL 86
      419        varbefore-l AT ROW 2.5 COL 8 COLON-ALIGNED
      420        varafter-l AT ROW 2.5 COL 56 COLON-ALIGNED
      421        varwork-l AT ROW 3.75 COL 20.5 COLON-ALIGNED
      422        varwork-kg AT ROW 3.75 COL 69 COLON-ALIGNED
      423        b-place AT ROW 5 COL 1.5
      424        SPACE(0.25) SKIP(0.24)
      425       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      426            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      427            TITLE "<insert dialog title>"
      428            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      429   ASSIGN
      430          FRAME frame-place:SCROLLABLE       = FALSE
      431          FRAME frame-place:HIDDEN           = TRUE.
      432   ON GO OF FRAME frame-place
      433   DO:
      434     ASSIGN
      435       parstate = YES.
      436   END.
      437   ON return OF FRAME frame-place
      438   DO:
      439     RETURN NO-APPLY.
      440   END.
      441   ON WINDOW-CLOSE OF FRAME frame-place
      442   DO:
      443     APPLY "END-ERROR":U TO SELF.
      444   END.
      445   ON CHOOSE OF b-chg IN FRAME frame-place
      446   DO:
      447     define variable varstate       as logical no-undo.
      448     define variable varqnty-l      as decimal no-undo.
      449     define variable varqnty-kg     as decimal no-undo.
      450     define variable varqnty-l-mem  as decimal no-undo.
      451     define variable varqnty-kg-mem as decimal no-undo.
      452     define buffer bf_place for ub.place.
      453     if available tt-place then do:
      454       if parwrite-off = yes then do:
      455         assign
      456           varqnty-l-mem  = tt-place.write-off-l
      457           varqnty-kg-mem = tt-place.write-off-kg .
      458       end.
      459       else do:
      460         assign
      461           varqnty-l-mem  = tt-place.income-l
      462           varqnty-kg-mem = tt-place.income-kg .
      463       end.
      464       find first bf_place where bf_place.obj-type = parobj-type      and
      465                                 bf_place.obj-code = parobj-code      and
      466                                 bf_place.pl-code  = tt-place.pl-code no-lock.
      467       run str/prstptru.w (buffer bf_goods,
      468                       buffer bf_place,
      469                       input  (if ptrlprop-expptrl = 'volume':U then yes else no),
      470                       input  'ИЗМЕНЕНИЕ':U,
      471                       input  (if parwrite-off = yes then yes else no),
      472                       input  tt-place.before-l,
      473                       input  tt-place.before-kg,
      474                       input  (if parwrite-off = yes then tt-place.write-off-l  else tt-place.income-l),
      475                       input  (if parwrite-off = yes then tt-place.write-off-kg else tt-place.income-kg),
      476                       input  tt-place.write-off-doc-l,
      477                       input  tt-place.write-off-doc-kg,
      478                       input  tt-place.income-doc-l,
      479                       input  tt-place.income-doc-kg,
      480                       output varstate,
      481                       output varqnty-l,
      482                       output varqnty-kg) no-error.
      483       if not error-status:error and
      484          varstate = yes         then do:
      485         if parwrite-off = yes then do:
      486           assign
      487             tt-place.write-off-l  = varqnty-l
      488             tt-place.write-off-kg = varqnty-kg
      489             tt-place.write-off-doc-l  = tt-place.write-off-doc-l  - varqnty-l-mem + varqnty-l
      490             tt-place.write-off-doc-kg = tt-place.write-off-doc-kg - varqnty-kg-mem + varqnty-kg
      491           .
      492         end.
      493         else do:
      494           assign
      495             tt-place.income-l  = varqnty-l
      496             tt-place.income-kg = varqnty-kg
      497             tt-place.income-doc-l  = tt-place.income-doc-l  - varqnty-l-mem + varqnty-l
      498             tt-place.income-doc-kg = tt-place.income-doc-kg - varqnty-kg-mem + varqnty-kg
      499           .
      500         end.
      501         display tt-place.write-off-l tt-place.write-off-kg tt-place.write-off-doc-l tt-place.write-off-doc-kg tt-place.income-l tt-place.income-kg tt-place.income-doc-l tt-place.income-doc-kg
      502         with browse b-place.
      503         run disp-free-qnty in this-procedure.
      504       end.
      505     end.
      506   END.
      507   ON return OF b-place IN FRAME frame-place
      508   DO:
      509     RETURN NO-APPLY.
      510   END.
      511   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME frame-place:PARENT eq ?
      512   THEN FRAME frame-place:PARENT = ACTIVE-WINDOW.
      513   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   on help of frame frame-place
      515   do:
      516     run gbl/app_help.p
      517       (input this-procedure :file-name
      518       ,input ''
      519       ,input ?
      520       ) no-error.
      521     if error-status :error then do:
      522       message
      523         "Ошибка при вызове помощи"
      524         error-status :get-message(1)
      525         view-as alert-box .
      526     end.
      527   end.
      528   run minbtn-set in this-procedure .
      529   on choose of b-help in frame frame-place
      530   do:
      531     apply "help":u to frame frame-place .
      532   end.
      533   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   procedure minbtn-set :
      535       do
      536           on error undo, return error return-value
      537           :
      538           define variable ii              as integer       no-undo .
      539           define variable fh              as widget-handle no-undo .
      540           define variable hh              as widget-handle no-undo .
      541           define variable v-h             as handle        extent 4 no-undo .
      542           define variable v-name-button   as character     no-undo .
      543           define variable v-help-old-x    as decimal       no-undo .
      544           define variable v-help-old-y    as decimal       no-undo .
      545           define variable v-help-old-size as decimal       no-undo .
      546           define variable v-frame-width   as decimal       no-undo .
      547           define variable jj              as integer       no-undo .
      548           do
      549               on error undo, return error
      550               :
      551               assign
      552                   v-frame-width = frame frame-place:width - 0.3
      553                   fh            = frame frame-place:first-child
      554                   hh            = fh:first-child
      555                   ii            = 1
      556                   .
      557               do while valid-handle(hh):
      558                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      559                   do:
      560                       case lc(hh:name) :
      561                           when "b-help" then
      562                               do:
      563                                   hh:load-image-up("cmp/b-help.bmp":u) .
      564                                   hh:load-image-down("cmp/b-help.bmp":u) .
      565                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      566                                   hh:TOOLTIP = "Помощь" .
      567                                   v-help-old-x = hh:column .
      568                                   v-help-old-y = hh:row    .
      569                                   v-help-old-size = hh:width .
      570                                   hh:width-chars = 2.5 .
      571                               end.
      572                           when "b-print" then
      573                               do:
      574                                   hh:load-image("cmp/b-print.bmp":u) .
      575                                   hh:TOOLTIP = "Печать" .
      576                                   v-h[ii] = hh:handle .
      577                                   ii = ii + 1 .
      578                                   hh:width-chars = 3 .
      579                               end.
      580                           when "b-history" or
      581                           when "b-hist" then
      582                               do:
      583                                   hh:load-image("cmp/b-hist.bmp":u) .
      584                                   hh:TOOLTIP = "История" .
      585                                   v-h[ii] = hh:handle .
      586                                   ii = ii + 1 .
      587                                   hh:width-chars = 3 .
      588                               end.
      589                           when "b-sch" then
      590                               do:
      591                                   hh:load-image("cmp/b-sch.bmp":u) .
      592                                   hh:TOOLTIP = "Установка Фильтра" .
      593                                   v-h[ii] = hh:handle .
      594                                   ii = ii + 1 .
      595                                   hh:width-chars = 3 .
      596                               end.
      597                           when "b-hist-user" then
      598                               do:
      599                                   hh:load-image("cmp/b-hist.bmp":u) .
      600                                   hh:TOOLTIP = "История пользователя" .
      601                                   ii = ii + 1 .
      602                               end.
      603                       end case.
      604                   end.
      605                   hh = hh:next-sibling.
      606               end.
      607               b-help:column = v-frame-width - b-help:width-chars.
      608               jj = 0.
      609               repeat ii = 4 to 1 by -1 :
      610                   if valid-handle (v-h[ii] ) then
      611                   do:
      612                       jj  = jj + 1 .
      613                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      614                       v-h[ii]:row    = v-help-old-y .
      615                   end.
      616               end.
      617           end.
      618       end.
      619   end procedure.
      620   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      621   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      622   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      623   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      624   define variable v-diasize-current-frame-width  as decimal   no-undo .
      625   define variable v-diasize-current-frame-height as decimal   no-undo .
      626   define variable v-diasize-change-size          as logical   no-undo .
      627   define variable v-diasize-resize-button        as handle    no-undo .
      628   define variable v-diasize-wndmax               as logical   no-undo .
      629   define variable v-diasize-wndstore             as logical   no-undo .
      630   define variable v-diasize-proc-name            as character no-undo .
      631   define variable v-diasize-browse-handle        as handle    no-undo .
      632   define variable v-diasize-browse-number        as integer   no-undo .
      633   define variable v-diasize-need-full-display    as logical   no-undo init false .
      634   define temp-table temp-diasize-handle no-undo
      635     field handle-value  as handle
      636     field save-position as decimal
      637     index xpk is primary unique handle-value
      638     .
      639   define temp-table temp-browse-handle no-undo
      640     field browse-type   as character
      641     field browse-number as integer
      642     field browse-handle as handle
      643     field original-size as decimal
      644     index xpk is primary unique browse-type browse-number
      645     index xie browse-type browse-handle
      646   .
      647   procedure diasize_change-height :
      648     define input  parameter p-change-value  as decimal   no-undo .
      649     define input  parameter p-move-resize   as logical   no-undo .
      650     define variable v-field-group-handle    as handle    no-undo .
      651     define variable v-object-handle         as handle    no-undo .
      652     define variable v-frame-height          as decimal   no-undo .
      653     define variable v-frame-virtual-height  as decimal   no-undo .
      654     define variable v-browse-height         as decimal   no-undo .
      655     define variable v-window-height         as decimal   no-undo .
      656     define variable v-window-virtual-height as decimal   no-undo .
      657     define variable v-change-sign           as integer   no-undo .
      658     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      659     define buffer buf_temp-browse-handle  for temp-browse-handle .
      660     if p-change-value > 0
      661     then do:
      662       if frame frame-place :height + p-change-value
      663           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      664       then do:
      665         assign
      666           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      667                           - (frame frame-place :height-chars)
      668         .
      669         if p-change-value <= 0
      670         then do:
      671           run diasize_position-resize-button in this-procedure .
      672           return .
      673         end.
      674       end.
      675     end.
      676     if p-change-value < 0
      677     then do:
      678       if frame frame-place :height + p-change-value < v-diasize-orig-frame-height
      679       then do:
      680         assign
      681           p-change-value = v-diasize-orig-frame-height
      682                          - (frame frame-place :height-chars)
      683         .
      684         if p-change-value >= 0
      685         then do:
      686           run diasize_position-resize-button in this-procedure .
      687           return .
      688         end.
      689       end.
      690     end.
      691     if p-change-value >= 0
      692     then do:
      693       assign
      694         v-change-sign = 1
      695       .
      696     end.
      697     else do:
      698       assign
      699         v-change-sign = -1
      700       .
      701     end.
      702     assign
      703       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      704     .
      705     if p-change-value = 0
      706     then do:
      707       run diasize_position-resize-button in this-procedure .
      708       return .
      709     end.
      710     move_block:
      711     do
      712     on error undo move_block, retry move_block
      713     :
      714       if retry
      715       then do:
      716         do
      717         on error undo move_block, leave move_block
      718         :
      719           if p-change-value > 0
      720           then do:
      721             for each buf_temp-diasize-handle
      722             on error undo, next
      723             :
      724               assign
      725                 v-object-handle = buf_temp-diasize-handle.handle-value
      726               .
      727               if v-object-handle <> v-diasize-resize-button
      728               then do:
      729                 assign
      730                   v-object-handle :row = buf_temp-diasize-handle.save-position
      731                 .
      732               end.
      733             end.
      734             assign
      735               v-diasize-browse-handle :height = v-browse-height
      736             .
      737             for each buf_temp-browse-handle
      738               where buf_temp-browse-handle.browse-type = 'height':u
      739             on error undo, next
      740             :
      741               assign
      742                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      743               .
      744             end.
      745             assign
      746               frame frame-place :height = v-frame-height
      747             .
      748             if frame frame-place :scrollable = true
      749             then do:
      750               assign
      751                 frame frame-place :virtual-height = v-frame-virtual-height
      752               .
      753             end.
      754             run diasize_position-resize-button in this-procedure .
      755           end.
      756           else do:
      757             if frame frame-place :scrollable = true
      758             then do:
      759               assign
      760                 frame frame-place :virtual-height = v-frame-virtual-height
      761               .
      762             end.
      763             assign
      764               frame frame-place :height = v-frame-height
      765             .
      766             assign
      767               v-diasize-browse-handle :height = v-browse-height
      768             .
      769             for each buf_temp-browse-handle
      770               where buf_temp-browse-handle.browse-type = 'height':u
      771             on error undo, next
      772             :
      773               assign
      774                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      775               .
      776             end.
      777             for each buf_temp-diasize-handle
      778             on error undo, next
      779             :
      780               assign
      781                 v-object-handle = buf_temp-diasize-handle.handle-value
      782               .
      783               if v-object-handle <> v-diasize-resize-button
      784               then do:
      785                 assign
      786                   v-object-handle :row = buf_temp-diasize-handle.save-position
      787                 .
      788               end.
      789             end.
      790             run diasize_position-resize-button in this-procedure .
      791           end.
      792           assign
      793             v-diasize-change-size = false
      794           .
      795           leave move_block .
      796         end.
      797       end.
      798       assign
      799         v-diasize-need-full-display = true
      800       .
      801       if v-diasize-change-size = false
      802       then do:
      803         assign
      804           v-diasize-change-size = true
      805         .
      806       end.
      807       else do:
      808         return .
      809       end.
      810       assign
      811         v-frame-height = frame frame-place :height
      812         v-frame-virtual-height = frame frame-place :virtual-height
      813         v-browse-height = v-diasize-browse-handle :height
      814       .
      815       for each buf_temp-browse-handle
      816         where buf_temp-browse-handle.browse-type = 'height':u
      817       :
      818         assign
      819           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      820         .
      821       end.
      822       for each buf_temp-diasize-handle
      823       :
      824         delete buf_temp-diasize-handle .
      825       end.
      826       assign
      827         v-field-group-handle = frame frame-place :first-child
      828       .
      829       do while valid-handle(v-field-group-handle)
      830       :
      831         assign
      832           v-object-handle = v-field-group-handle :first-child
      833         .
      834         do while valid-handle(v-object-handle)
      835         :
      836           if  v-object-handle <> v-diasize-browse-handle :handle
      837           and can-query(v-object-handle, "row")
      838           and can-query(v-object-handle, "height")
      839           and ( v-object-handle :row > v-diasize-browse-handle :row )
      840           then do:
      841             find first buf_temp-browse-handle
      842               where buf_temp-browse-handle.browse-type   = 'height':u
      843                 and buf_temp-browse-handle.browse-handle = v-object-handle
      844               no-error .
      845             if available buf_temp-browse-handle
      846             then do:
      847             end.
      848             else do:
      849               create buf_temp-diasize-handle .
      850               assign
      851                 buf_temp-diasize-handle.handle-value  = v-object-handle
      852                 buf_temp-diasize-handle.save-position = v-object-handle :row
      853               .
      854             end.
      855           end.
      856           assign
      857             v-object-handle = v-object-handle :next-sibling
      858           .
      859         end.
      860         assign
      861           v-field-group-handle = v-field-group-handle :next-sibling
      862         .
      863       end.
      864       do with frame frame-place
      865       :
      866         hide v-diasize-resize-button .
      867         assign
      868           v-diasize-resize-button :row    = 1
      869           v-diasize-resize-button :column = 1
      870         .
      871       end.
      872       if p-change-value > 0
      873       then do:
      874         if frame frame-place :scrollable = true
      875         then do:
      876           assign
      877             frame frame-place :virtual-height = frame frame-place :virtual-height + p-change-value
      878             no-error .
      879           if error-status :error
      880           or error-status :get-message(1) <> ""
      881           then do:
      882             undo move_block, retry move_block .
      883           end.
      884         end.
      885         assign
      886           frame frame-place :height = frame frame-place :height + p-change-value
      887           no-error .
      888         if error-status :error
      889         or error-status :get-message(1) <> ""
      890         then do:
      891           undo move_block, retry move_block .
      892         end.
      893         assign
      894           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      895           no-error .
      896         if error-status :error
      897         or error-status :get-message(1) <> ""
      898         then do:
      899           undo move_block, retry move_block .
      900         end.
      901         for each buf_temp-browse-handle
      902           where buf_temp-browse-handle.browse-type = 'height':u
      903         on error undo move_block, retry move_block
      904         :
      905           assign
      906             buf_temp-browse-handle.browse-handle :height
      907               = buf_temp-browse-handle.browse-handle :height + p-change-value
      908             no-error .
      909           if error-status :error
      910           or error-status :get-message(1) <> ""
      911           then do:
      912             undo move_block, retry move_block .
      913           end.
      914         end.
      915         for each buf_temp-diasize-handle
      916         on error undo move_block, retry move_block
      917         :
      918           assign
      919             v-object-handle = buf_temp-diasize-handle.handle-value
      920           .
      921           if v-object-handle <> v-diasize-resize-button
      922           then do:
      923             assign
      924               v-object-handle :row = v-object-handle :row + p-change-value
      925               no-error .
      926             if error-status :error
      927             or error-status :get-message(1) <> ""
      928             then do:
      929               undo move_block, retry move_block .
      930             end.
      931           end.
      932         end.
      933       end.
      934       else do:
      935         for each buf_temp-diasize-handle
      936         on error undo move_block, retry move_block
      937         :
      938           assign
      939             v-object-handle = buf_temp-diasize-handle.handle-value
      940           .
      941           if v-object-handle <> v-diasize-resize-button
      942           then do:
      943             assign
      944               v-object-handle :row = v-object-handle :row + p-change-value
      945               no-error .
      946             if error-status :error
      947             or error-status :get-message(1) <> ""
      948             then do:
      949               undo move_block, retry move_block .
      950             end.
      951           end.
      952         end.
      953         assign
      954           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      955           no-error .
      956         if error-status :error
      957         or error-status :get-message(1) <> ""
      958         then do:
      959           undo move_block, retry move_block .
      960         end.
      961         for each buf_temp-browse-handle
      962           where buf_temp-browse-handle.browse-type = 'height':u
      963         on error undo move_block, retry move_block
      964         :
      965           assign
      966             buf_temp-browse-handle.browse-handle :height
      967               = buf_temp-browse-handle.browse-handle :height + p-change-value
      968             no-error .
      969           if error-status :error
      970           or error-status :get-message(1) <> ""
      971           then do:
      972             undo move_block, retry move_block .
      973           end.
      974         end.
      975         assign
      976           frame frame-place :height = frame frame-place :height + p-change-value
      977           no-error .
      978         if error-status :error
      979         or error-status :get-message(1) <> ""
      980         then do:
      981           undo move_block, retry move_block .
      982         end.
      983         if frame frame-place :scrollable = true
      984         then do:
      985           assign
      986             frame frame-place :virtual-height = frame frame-place :virtual-height + p-change-value
      987             no-error .
      988           if error-status :error
      989           or error-status :get-message(1) <> ""
      990           then do:
      991             undo move_block, retry move_block .
      992           end.
      993         end.
      994       end.
      995       if p-move-resize = true
      996       then do:
      997         run diasize_position-resize-button in this-procedure .
      998       end.
      999       if v-diasize-wndstore = true
     1000       then do:
     1001         if connected("ub") = true
     1002         then do:
     1003           define variable v-cntxt-db-num        as integer   no-undo .
     1004           define variable v-cntxt-userid        as character no-undo .
     1005           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1006                                             , OUTPUT v-cntxt-userid
     1007                                             ) .
     1008           run gbl/wndsizew.p
     1009             (input  v-cntxt-db-num
     1010             ,input  v-cntxt-userid
     1011             ,input  v-diasize-proc-name
     1012             ,input  'height':u
     1013             ,input  string(frame frame-place :height - v-diasize-orig-frame-height)
     1014             ) .
     1015         end.
     1016       end.
     1017     end.
     1018     assign
     1019       v-diasize-change-size = false
     1020     .
     1021   end procedure.
     1022   procedure diasize_set-height :
     1023     define input  parameter p-new-height  as decimal   no-undo .
     1024     define input  parameter p-move-resize as logical   no-undo .
     1025     do
     1026     on error undo, return error return-value
     1027     :
     1028       run diasize_change-height in this-procedure
     1029         (input  (p-new-height - frame frame-place :height)
     1030         ,input  p-move-resize
     1031         ) .
     1032     end.
     1033   end procedure.
     1034   procedure diasize_change-width :
     1035     define input  parameter p-change-value as decimal   no-undo .
     1036     define input  parameter p-move-resize  as logical   no-undo .
     1037     define variable v-field-group-handle   as handle    no-undo .
     1038     define variable v-object-handle        as handle    no-undo .
     1039     define variable v-frame-width          as decimal   no-undo .
     1040     define variable v-frame-virtual-width  as decimal   no-undo .
     1041     define variable v-browse-width         as decimal   no-undo .
     1042     define variable v-window-width         as decimal   no-undo .
     1043     define variable v-window-virtual-width as decimal   no-undo .
     1044     define variable v-change-sign          as integer   no-undo .
     1045     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1046     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1047     if p-change-value > 0
     1048     then do:
     1049       if frame frame-place :width + p-change-value >
     1050           session :width-chars
     1051       then do:
     1052         assign
     1053           p-change-value = session :width-chars - frame frame-place :width
     1054         .
     1055         if p-change-value <= 0
     1056         then do:
     1057           run diasize_position-resize-button in this-procedure .
     1058           return .
     1059         end.
     1060       end.
     1061     end.
     1062     if p-change-value < 0
     1063     then do:
     1064       if frame frame-place :width + p-change-value < v-diasize-orig-frame-width
     1065       then do:
     1066         assign
     1067           p-change-value = v-diasize-orig-frame-width
     1068                          - frame frame-place :width
     1069         .
     1070         if p-change-value >= 0
     1071         then do:
     1072           run diasize_position-resize-button in this-procedure .
     1073           return .
     1074         end.
     1075       end.
     1076     end.
     1077     if p-change-value >= 0
     1078     then do:
     1079       assign
     1080         v-change-sign = 1
     1081       .
     1082     end.
     1083     else do:
     1084       assign
     1085         v-change-sign = -1
     1086       .
     1087     end.
     1088     assign
     1089       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1090     .
     1091     if p-change-value = 0
     1092     then do:
     1093       run diasize_position-resize-button in this-procedure .
     1094       return .
     1095     end.
     1096     move_block:
     1097     do
     1098     on error undo move_block, leave move_block
     1099     :
     1100       if retry
     1101       then do:
     1102         do
     1103         on error undo move_block, leave move_block
     1104         :
     1105           if p-change-value > 0
     1106           then do:
     1107             for each buf_temp-diasize-handle
     1108             on error undo, next
     1109             :
     1110               assign
     1111                 v-object-handle = buf_temp-diasize-handle.handle-value
     1112               .
     1113               if v-object-handle <> v-diasize-resize-button
     1114               then do:
     1115                 assign
     1116                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1117                 .
     1118               end.
     1119             end.
     1120             assign
     1121               v-diasize-browse-handle :width = v-browse-width
     1122             .
     1123             for each buf_temp-browse-handle
     1124               where buf_temp-browse-handle.browse-type = 'width':u
     1125             on error undo, next
     1126             :
     1127               assign
     1128                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1129               .
     1130             end.
     1131             assign
     1132               frame frame-place :width = v-frame-width
     1133             .
     1134             if frame frame-place :scrollable = true
     1135             then do:
     1136               assign
     1137                 frame frame-place :virtual-width = v-frame-virtual-width
     1138               .
     1139             end.
     1140             run diasize_position-resize-button in this-procedure .
     1141           end.
     1142           else do:
     1143             if frame frame-place :scrollable = true
     1144             then do:
     1145               assign
     1146                 frame frame-place :virtual-width = v-frame-virtual-width
     1147               .
     1148             end.
     1149             assign
     1150               frame frame-place :width = v-frame-width
     1151             .
     1152             for each buf_temp-browse-handle
     1153               where buf_temp-browse-handle.browse-type = 'width':u
     1154             on error undo, next
     1155             :
     1156               assign
     1157                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1158               .
     1159             end.
     1160             assign
     1161               v-diasize-browse-handle :width = v-browse-width
     1162             .
     1163             for each buf_temp-diasize-handle
     1164             on error undo, next
     1165             :
     1166               assign
     1167                 v-object-handle = buf_temp-diasize-handle.handle-value
     1168               .
     1169               if v-object-handle <> v-diasize-resize-button
     1170               then do:
     1171                 assign
     1172                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1173                 .
     1174               end.
     1175             end.
     1176             run diasize_position-resize-button in this-procedure .
     1177           end.
     1178           assign
     1179             v-diasize-change-size = false
     1180           .
     1181           leave move_block .
     1182         end.
     1183       end.
     1184       assign
     1185         v-diasize-need-full-display = true
     1186       .
     1187       if v-diasize-change-size = false
     1188       then do:
     1189         assign
     1190           v-diasize-change-size = true
     1191         .
     1192       end.
     1193       else do:
     1194         return .
     1195       end.
     1196       assign
     1197         v-frame-width = frame frame-place :width
     1198         v-frame-virtual-width = frame frame-place :virtual-width
     1199         v-browse-width = v-diasize-browse-handle :width
     1200       .
     1201       for each buf_temp-browse-handle
     1202         where buf_temp-browse-handle.browse-type = 'width':u
     1203       :
     1204         assign
     1205           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1206         .
     1207       end.
     1208       for each buf_temp-diasize-handle
     1209       :
     1210         delete buf_temp-diasize-handle .
     1211       end.
     1212       assign
     1213         v-field-group-handle = frame frame-place :first-child
     1214       .
     1215       do while valid-handle(v-field-group-handle)
     1216       :
     1217         assign
     1218           v-object-handle = v-field-group-handle :first-child
     1219         .
     1220         do while valid-handle(v-object-handle)
     1221         :
     1222           if  v-object-handle <> v-diasize-browse-handle :handle
     1223           and v-object-handle <> v-diasize-resize-button
     1224           and can-query(v-object-handle, "row")
     1225           and can-query(v-object-handle, "height")
     1226           and ( v-object-handle :col + v-object-handle :width
     1227                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1228               )
     1229           then do:
     1230             find first buf_temp-browse-handle
     1231               where buf_temp-browse-handle.browse-type   = 'width':u
     1232                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1233               no-error .
     1234             if available buf_temp-browse-handle
     1235             then do:
     1236             end.
     1237             else do:
     1238               create buf_temp-diasize-handle .
     1239               assign
     1240                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1241                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1242               .
     1243             end.
     1244           end.
     1245           assign
     1246             v-object-handle = v-object-handle :next-sibling
     1247           .
     1248         end.
     1249         assign
     1250           v-field-group-handle = v-field-group-handle :next-sibling
     1251         .
     1252       end.
     1253       do with frame frame-place
     1254       :
     1255         hide v-diasize-resize-button .
     1256         v-diasize-resize-button :row = 1.
     1257         v-diasize-resize-button :column = 1.
     1258       end.
     1259       if p-change-value > 0
     1260       then do:
     1261         if frame frame-place :scrollable = true
     1262         then do:
     1263           assign
     1264             frame frame-place :virtual-width = frame frame-place :virtual-width + p-change-value
     1265             no-error .
     1266           if error-status :error
     1267           or error-status :get-message(1) <> ""
     1268           then do:
     1269             undo move_block, retry move_block.
     1270           end.
     1271         end.
     1272         assign
     1273           frame frame-place :width = v-frame-width + p-change-value
     1274           no-error .
     1275         if error-status :error
     1276         or error-status :get-message(1) <> ""
     1277         then do:
     1278           undo move_block, retry move_block.
     1279         end.
     1280         assign
     1281           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1282         no-error .
     1283         if error-status :error
     1284         or error-status :get-message(1) <> ""
     1285         then do:
     1286           undo move_block, retry move_block.
     1287         end.
     1288         for each buf_temp-browse-handle
     1289           where buf_temp-browse-handle.browse-type = 'width':u
     1290         on error undo move_block, retry move_block
     1291         :
     1292           assign
     1293             buf_temp-browse-handle.browse-handle :width
     1294               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1295             no-error .
     1296           if error-status :error
     1297           or error-status :get-message(1) <> ""
     1298           then do:
     1299             undo move_block, retry move_block .
     1300           end.
     1301         end.
     1302         for each buf_temp-diasize-handle
     1303         on error undo move_block, retry move_block
     1304         :
     1305           assign
     1306             v-object-handle = buf_temp-diasize-handle.handle-value
     1307           .
     1308           if v-object-handle <> v-diasize-resize-button
     1309           then do:
     1310             assign
     1311               v-object-handle :col = v-object-handle :col + p-change-value
     1312               no-error .
     1313             if error-status :error
     1314             or error-status :get-message(1) <> ""
     1315             then do:
     1316               undo move_block, retry move_block .
     1317             end.
     1318           end.
     1319         end.
     1320       end.
     1321       else do:
     1322         for each buf_temp-diasize-handle
     1323         on error undo move_block, retry move_block
     1324         :
     1325           assign
     1326             v-object-handle = buf_temp-diasize-handle.handle-value
     1327           .
     1328           if v-object-handle <> v-diasize-resize-button
     1329           then do:
     1330             assign
     1331               v-object-handle :col = v-object-handle :col + p-change-value
     1332               no-error .
     1333             if error-status :error
     1334             or error-status :get-message(1) <> ""
     1335             then do:
     1336               undo move_block, retry move_block .
     1337             end.
     1338           end.
     1339         end.
     1340         for each buf_temp-browse-handle
     1341           where buf_temp-browse-handle.browse-type = 'width':u
     1342         on error undo move_block, retry move_block
     1343         :
     1344           assign
     1345             buf_temp-browse-handle.browse-handle :width
     1346               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1347             no-error .
     1348           if error-status :error
     1349           or error-status :get-message(1) <> ""
     1350           then do:
     1351             undo move_block, retry move_block .
     1352           end.
     1353         end.
     1354         assign
     1355           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1356           no-error .
     1357         if error-status :error
     1358         or error-status :get-message(1) <> ""
     1359         then do:
     1360           undo move_block, retry move_block.
     1361         end.
     1362         assign
     1363           frame frame-place :width = frame frame-place :width + p-change-value
     1364         no-error .
     1365         if error-status :error
     1366         or error-status :get-message(1) <> ""
     1367         then do:
     1368           undo move_block, retry move_block.
     1369         end.
     1370         if frame frame-place :scrollable = true
     1371         then do:
     1372           assign
     1373             frame frame-place :virtual-width = frame frame-place :virtual-width + p-change-value
     1374           no-error .
     1375           if error-status :error
     1376           or error-status :get-message(1) <> ""
     1377           then do:
     1378             undo move_block, retry move_block.
     1379           end.
     1380         end.
     1381       end.
     1382       if p-move-resize
     1383       then do:
     1384         run diasize_position-resize-button in this-procedure .
     1385       end.
     1386       if v-diasize-wndstore = true
     1387       then do:
     1388         if connected("ub") = true
     1389         then do:
     1390           define variable v-cntxt-db-num        as integer   no-undo .
     1391           define variable v-cntxt-userid        as character no-undo .
     1392           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1393                                             , OUTPUT v-cntxt-userid
     1394                                             ) .
     1395           run gbl/wndsizew.p
     1396             (input  v-cntxt-db-num
     1397             ,input  v-cntxt-userid
     1398             ,input  v-diasize-proc-name
     1399             ,input  'width':u
     1400             ,input  string(frame frame-place :width - v-diasize-orig-frame-width)
     1401             ) .
     1402         end.
     1403       end.
     1404     end.
     1405     assign
     1406       v-diasize-change-size = false
     1407     .
     1408   end procedure.
     1409   procedure diasize_set-width :
     1410     define input  parameter p-new-width  as decimal   no-undo .
     1411     define input  parameter p-move-resize as logical   no-undo .
     1412     do
     1413     on error undo, return error return-value
     1414     :
     1415       run diasize_change-width in this-procedure
     1416         (input  (p-new-width - frame frame-place :width)
     1417         ,input  p-move-resize
     1418         ) .
     1419     end.
     1420   end procedure.
     1421   procedure diasize_position-resize-button :
     1422     do with frame frame-place
     1423     :
     1424       hide v-diasize-resize-button .
     1425       assign
     1426         v-diasize-resize-button :row = frame frame-place :height - v-diasize-resize-button :height
     1427                     - 1
     1428                     - (frame frame-place :border-bottom-pixels / session :pixels-per-row)
     1429         v-diasize-resize-button :col = frame frame-place :width - v-diasize-resize-button :width
     1430                     - 1
     1431                     - (frame frame-place :border-right-pixels / session :pixels-per-column)
     1432       .
     1433       view v-diasize-resize-button .
     1434     end.
     1435   end procedure.
     1436   on alt-right anywhere
     1437   do:
     1438     run diasize_change-width in this-procedure
     1439       (input 1
     1440       ,input true
     1441       ) .
     1442     return no-apply .
     1443   end.
     1444   on alt-left anywhere
     1445   do:
     1446     run diasize_change-width in this-procedure
     1447       (input -1
     1448       ,input true
     1449       ) .
     1450     return no-apply .
     1451   end.
     1452   on alt-down anywhere
     1453   do:
     1454     run diasize_change-height in this-procedure
     1455       (input 1
     1456       ,input true
     1457       ) .
     1458     return no-apply .
     1459   end.
     1460   on alt-up anywhere
     1461   do:
     1462     run diasize_change-height in this-procedure
     1463       (input -1
     1464       ,input true
     1465       ) .
     1466     return no-apply .
     1467   end.
     1468   on alt-enter of frame frame-place
     1469   do:
     1470     run diasize_maximize in this-procedure
     1471       (input  ?
     1472       ).
     1473     return no-apply .
     1474   end.
     1475   procedure diasize_end-move :
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       define variable v-row-delta as decimal   no-undo .
     1480       define variable v-col-delta as decimal   no-undo .
     1481       define variable v-new-row as decimal   no-undo .
     1482       define variable v-new-col as decimal   no-undo .
     1483       assign
     1484         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1485         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1486       .
     1487       assign
     1488         v-row-delta = v-new-row - frame frame-place :height
     1489         v-col-delta = v-new-col - frame frame-place :width
     1490       .
     1491       run diasize_change-height in this-procedure
     1492         (input v-row-delta
     1493         ,input true
     1494         ) .
     1495       run diasize_change-width in this-procedure
     1496         (input v-col-delta
     1497         ,input true
     1498         ) .
     1499     end.
     1500   end procedure.
     1501   procedure diasize_maximize :
     1502     define input  parameter p-action as logical   no-undo .
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506       if p-action = ?
     1507       then do:
     1508         if v-diasize-need-maximize = true
     1509         then do:
     1510           assign
     1511             p-action = true
     1512           .
     1513         end.
     1514         else do:
     1515           assign
     1516             p-action = false
     1517           .
     1518         end.
     1519       end.
     1520       if p-action = true
     1521       then do:
     1522         run diasize_change-height in this-procedure
     1523           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1524               - frame frame-place :height-chars
     1525           ,input true
     1526           ) .
     1527         run diasize_change-width in this-procedure
     1528           (input session :width-chars
     1529               - frame frame-place :width-chars
     1530           ,input true
     1531           ) .
     1532         assign
     1533           v-diasize-need-maximize = false
     1534         .
     1535       end.
     1536       else do:
     1537         run diasize_change-width in this-procedure
     1538           (input v-diasize-orig-frame-width
     1539               - frame frame-place :width-chars
     1540           ,input true
     1541           ) .
     1542         run diasize_change-height in this-procedure
     1543           (input v-diasize-orig-frame-height
     1544               - frame frame-place :height-chars
     1545           ,input true
     1546           ) .
     1547         assign
     1548           v-diasize-need-maximize = true
     1549         .
     1550       end.
     1551     end.
     1552   end procedure.
     1553   procedure diasize_restore-orig-size :
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       assign
     1558         v-diasize-current-frame-width  = frame frame-place :width
     1559         v-diasize-current-frame-height = frame frame-place :height
     1560       .
     1561       run diasize_set-height in this-procedure
     1562         (input  v-diasize-orig-frame-height
     1563         ,input  true
     1564         ) .
     1565       run diasize_set-width in this-procedure
     1566         (input  v-diasize-orig-frame-width
     1567         ,input  true
     1568         ) .
     1569     end.
     1570   end procedure.
     1571   procedure diasize_restore-current-size :
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575       run diasize_set-height in this-procedure
     1576         (input  v-diasize-current-frame-height
     1577         ,input  true
     1578         ) .
     1579       run diasize_set-width in this-procedure
     1580         (input  v-diasize-current-frame-width
     1581         ,input  true
     1582         ) .
     1583     end.
     1584   end procedure.
     1585   procedure diasize_set-browse-handle :
     1586     define input  parameter p-browse-handle as handle   no-undo .
     1587     define buffer buf_temp-browse-handle for temp-browse-handle .
     1588     do
     1589     on error undo, return error return-value
     1590     :
     1591       assign
     1592         v-diasize-browse-handle = p-browse-handle
     1593       .
     1594       for each buf_temp-browse-handle
     1595       on error undo, return error return-value
     1596       :
     1597         delete buf_temp-browse-handle .
     1598       end.
     1599     end.
     1600   end procedure.
     1601   procedure diasize_add_browse :
     1602     define input  parameter p-browse-type   as character no-undo .
     1603     define input  parameter p-browse-handle as handle    no-undo .
     1604     define buffer buf_temp-browse-handle for temp-browse-handle .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       assign
     1609         v-diasize-browse-number = v-diasize-browse-number + 1
     1610       .
     1611       create buf_temp-browse-handle .
     1612       assign
     1613         buf_temp-browse-handle.browse-type   = p-browse-type
     1614         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1615         buf_temp-browse-handle.browse-handle = p-browse-handle
     1616       .
     1617     end.
     1618   end procedure.
     1619   procedure diasize_init :
     1620     define variable v-default-value    as logical   no-undo .
     1621     define variable v-restore-saved    as logical   no-undo .
     1622     define variable v-resize-value-str as character no-undo .
     1623     do
     1624     on error undo, return error return-value
     1625     :
     1626       do with frame frame-place
     1627       :
     1628         assign
     1629           v-diasize-orig-frame-height = frame frame-place :height
     1630           v-diasize-orig-frame-width  = frame frame-place :width
     1631           v-diasize-browse-handle     = browse b-place :handle
     1632         .
     1633         create button v-diasize-resize-button
     1634         assign
     1635           parent        = frame frame-place :first-child
     1636           label         = "s"
     1637           height-pixels = 16
     1638           width-pixels  = 16
     1639           visible       = true
     1640           sensitive     = true
     1641           movable       = true
     1642           triggers:
     1643             on end-move persistent run diasize_end-move in this-procedure .
     1644           end triggers.
     1645         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1646         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1647         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1648         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1649         assign
     1650           v-diasize-wndmax = false
     1651         .
     1652         if connected("ub") = true
     1653         then do:
     1654           define variable v-cntxt-db-num        as integer   no-undo .
     1655           define variable v-cntxt-userid        as character no-undo .
     1656           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1657                                             , OUTPUT v-cntxt-userid
     1658                                             ) .
     1659           run gbl/wndpar_r.p
     1660             (input  v-cntxt-db-num
     1661             ,input  v-cntxt-userid
     1662             ,input  'wndmax':U
     1663             ,output v-diasize-wndmax
     1664             ,output v-default-value
     1665             ) .
     1666         end.
     1667         assign
     1668           v-diasize-wndstore = false
     1669         .
     1670         if connected("ub") = true
     1671         then do:
     1672           run gbl/wndpar_r.p
     1673             (input  v-cntxt-db-num
     1674             ,input  v-cntxt-userid
     1675             ,input  'wndstore':U
     1676             ,output v-diasize-wndstore
     1677             ,output v-default-value
     1678             ) .
     1679         end.
     1680         assign
     1681           v-diasize-proc-name = entry(1, program-name(2), '.')
     1682         .
     1683         if v-diasize-wndstore = true
     1684         then do:
     1685           assign
     1686             v-restore-saved = false
     1687           .
     1688           if connected("ub") = true
     1689           then do:
     1690             run gbl/wndsizer.p
     1691               (input  v-cntxt-db-num
     1692               ,input  v-cntxt-userid
     1693               ,input  v-diasize-proc-name
     1694               ,input  'height':u
     1695               ,output v-resize-value-str
     1696               ) .
     1697             if v-resize-value-str <> '':U
     1698             then do:
     1699               run diasize_change-height in this-procedure
     1700                 (input  integer(v-resize-value-str)
     1701                 ,input  true
     1702                 ) .
     1703               assign
     1704                 v-restore-saved = true
     1705               .
     1706             end.
     1707           end.
     1708           if connected("ub") = true
     1709           then do:
     1710             run gbl/wndsizer.p
     1711               (input  v-cntxt-db-num
     1712               ,input  v-cntxt-userid
     1713               ,input  v-diasize-proc-name
     1714               ,input  'width':u
     1715               ,output v-resize-value-str
     1716               ) .
     1717             if v-resize-value-str <> '':U
     1718             then do:
     1719               run diasize_change-width in this-procedure
     1720                 (input  integer(v-resize-value-str)
     1721                 ,input  true
     1722                 ) .
     1723               assign
     1724                 v-restore-saved = true
     1725               .
     1726             end.
     1727           end.
     1728           if v-restore-saved <> true
     1729           then do:
     1730             if v-diasize-wndmax = true
     1731             then do:
     1732               run diasize_maximize in this-procedure
     1733                 (input  true
     1734                 ) .
     1735             end.
     1736           end.
     1737         end.
     1738         else do:
     1739           if v-diasize-wndmax = true
     1740           then do:
     1741             run diasize_maximize in this-procedure
     1742               (input  true
     1743               ) .
     1744           end.
     1745         end.
     1746       end.
     1747     end.
     1748   end procedure.
     1749   procedure diasize_need-full-display :
     1750     define output parameter p-need-full-display as logical   no-undo .
     1751     do
     1752     on error undo, return error return-value
     1753     :
     1754       assign
     1755         p-need-full-display = v-diasize-need-full-display
     1756       .
     1757       assign
     1758         v-diasize-need-full-display = false
     1759       .
     1760     end.
     1761   end procedure.
     1762   procedure get-context :
     1763      define output parameter p-db-num as integer          no-undo.
     1764      define output parameter p-user-id as character        no-undo.
     1765      define variable v-login               as character    no-undo.
     1766      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1767      define buffer buf_user-login  for ub.user-login .
     1768      do
     1769      on error undo, return error
     1770      :
     1771            FIND FIRST buf_sys-ctrl no-lock.
     1772            ASSIGN
     1773               v-login = USERID("ub")
     1774               p-db-num = buf_sys-ctrl.db-num
     1775            .
     1776            FIND FIRST buf_user-login
     1777                 WHERE buf_user-login.db-num = p-db-num
     1778                   AND buf_user-login.user-login = v-login
     1779                 no-lock
     1780                 no-error
     1781                 .
     1782            IF AVAILABLE buf_user-login
     1783            THEN DO:
     1784               assign
     1785                  p-user-id = buf_user-login.user-id
     1786               .
     1787            END.
     1788      end.
     1789   end procedure.
     1790       run diasize_init in this-procedure .
     1791   MAIN-BLOCK:
     1792   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1793      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1794    ASSIGN
     1795       frame frame-place:TITLE = "Определение количеств в резервуарах для документа пересортица " + pardoc-code + " для товара " + bf_goods.artic + " " + bf_goods.prod-type + " " + string(bf_goods.prod-code) + " " + bf_goods.gds-name.
     1796     FIND FIRST bf_gds-obj WHERE bf_gds-obj.obj-type  = parobj-type  AND
     1797                                 bf_gds-obj.obj-code  = parobj-code  AND
     1798                                 bf_gds-obj.artic     = bf_goods.artic     AND
     1799                                 bf_gds-obj.prod-type = bf_goods.prod-type AND
     1800                                 bf_gds-obj.prod-code = bf_goods.prod-code NO-LOCK no-error.
     1801     if available bf_gds-obj then do:
     1802       ASSIGN
     1803         varbefore-l = bf_gds-obj.fact-qnty.
     1804     end.
     1805     DISPLAY varbefore-l WITH FRAME frame-place.
     1806     RUN make-tt-table IN THIS-PROCEDURE.
     1807     RUN disp-free-qnty IN THIS-PROCEDURE.
     1808     FIND FIRST bf_clients WHERE bf_clients.obj-type = parobj-type AND
     1809                                 bf_clients.obj-code = parobj-code NO-LOCK.
     1810   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1811   run get-ptrl-prop in this-procedure
     1812     ( input parobj-type
     1813     , input parobj-code
     1814     ) .
     1815     RUN enable_UI.
     1816     IF parmode = 'ДОБАВЛЕНИЕ':U OR
     1817        parmode = 'ИЗМЕНЕНИЕ':U  THEN DO:
     1818       ENABLE b-save b-chg WITH FRAME frame-place.
     1819     END.
     1820     ASSIGN
     1821       tt-place.pl-name:WIDTH IN BROWSE b-place = 30
     1822       tt-place.pl-name:RESIZABLE IN BROWSE b-place = YES.
     1823     WAIT-FOR GO OF FRAME frame-place.
     1824   END.
     1825   RUN disable_UI.
     1826   PROCEDURE disable_UI :
     1827     HIDE FRAME frame-place.
     1828   END PROCEDURE.
     1829   PROCEDURE disp-free-qnty :
     1830   DEFINE BUFFER bf_tt-place FOR tt-place.
     1831     ASSIGN
     1832       varwork-l  = 0.00
     1833       varwork-kg = 0.00  .
     1834     FOR EACH bf_tt-place ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1835       assign
     1836         varwork-l  = varwork-l  + bf_tt-place.income-doc-l  - bf_tt-place.write-off-doc-l
     1837         varwork-kg = varwork-kg + bf_tt-place.income-doc-kg - bf_tt-place.write-off-doc-kg.
     1838     END.
     1839     ASSIGN
     1840       varafter-l  = varbefore-l  + varwork-l.
     1841     DISPLAY varwork-l varwork-kg varafter-l WITH FRAME frame-place.
     1842   END PROCEDURE.
     1843   PROCEDURE enable_UI :
     1844     DISPLAY varbefore-l varafter-l varwork-l varwork-kg
     1845         WITH FRAME frame-place.
     1846     ENABLE b-cancel b-help b-place
     1847         WITH FRAME frame-place.
     1848     VIEW FRAME frame-place.
     1849     OPEN QUERY b-place FOR EACH tt-place.
     1850   END PROCEDURE.
     1851   PROCEDURE make-tt-table :
     1852   DEFINE BUFFER bf_pl-gds     FOR ub.pl-gds.
     1853   DEFINE BUFFER bf_place      FOR ub.place.
     1854   DEFINE BUFFER bf_parts      FOR ub.parts.
     1855   define buffer bf-another_parts for ub.parts.
     1856   define buffer bf_parts-root for ub.parts-root.
     1857   define buffer bf-another_goods for ub.goods.
     1858   define buffer bf_doc-pl        for ub.doc-pl.
     1859   DEFINE VARIABLE varwrite-off-doc-l  AS DECIMAL NO-UNDO.
     1860   DEFINE VARIABLE varincome-doc-l     AS DECIMAL NO-UNDO.
     1861   DEFINE VARIABLE varwrite-off-doc-kg AS DECIMAL NO-UNDO.
     1862   DEFINE VARIABLE varincome-doc-kg    AS DECIMAL NO-UNDO.
     1863   DEFINE VARIABLE varwrite-off-l      AS DECIMAL NO-UNDO.
     1864   DEFINE VARIABLE varincome-l         AS DECIMAL NO-UNDO.
     1865   DEFINE VARIABLE varwrite-off-kg     AS DECIMAL NO-UNDO.
     1866   DEFINE VARIABLE varincome-kg        AS DECIMAL NO-UNDO.
     1867   FOR EACH tt-place ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1868     DELETE tt-place.
     1869   END.
     1870   FOR EACH bf_pl-gds WHERE bf_pl-gds.gds-code = bf_goods.gds-code AND
     1871                            bf_pl-gds.obj-type = parobj-type       AND
     1872                            bf_pl-gds.obj-code = parobj-code       NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1873     FIND FIRST bf_place WHERE bf_place.obj-type = bf_pl-gds.obj-type AND
     1874                               bf_place.obj-code = bf_pl-gds.obj-code AND
     1875                               bf_place.pl-code  = bf_pl-gds.pl-code  NO-LOCK.
     1876     ASSIGN
     1877       varwrite-off-doc-l  = 0.00
     1878       varincome-doc-l     = 0.00
     1879       varwrite-off-doc-kg = 0.00
     1880       varincome-doc-kg    = 0.00
     1881       varwrite-off-l  = 0.00
     1882       varincome-l     = 0.00
     1883       varwrite-off-kg = 0.00
     1884       varincome-kg    = 0.00
     1885       .
     1886     FOR EACH bf_parts WHERE bf_parts.out-code  = pardoc-code        AND
     1887                             bf_parts.obj-type  = parobj-type        AND
     1888                             bf_parts.obj-code  = parobj-code        AND
     1889                             bf_parts.artic     = bf_goods.artic     AND
     1890                             bf_parts.prod-type = bf_goods.prod-type AND
     1891                             bf_parts.prod-code = bf_goods.prod-code AND
     1892                             bf_parts.pl-code   = bf_pl-gds.pl-code  ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1893       find first bf_doc-pl where bf_doc-pl.obj-type = bf_parts.obj-type and
     1894                                  bf_doc-pl.obj-code = bf_parts.obj-code and
     1895                                  bf_doc-pl.pl-code  = bf_parts.pl-code  and
     1896                                  bf_doc-pl.out-code = bf_parts.out-code and
     1897                                  bf_doc-pl.gds-code = bf_goods.gds-code no-lock.
     1898       IF bf_parts.fact-qnty < 0 THEN DO:
     1899         ASSIGN
     1900           varwrite-off-doc-l  = varwrite-off-doc-l  - bf_parts.fact-qnty
     1901           varwrite-off-doc-kg = varwrite-off-doc-kg - (bf_doc-pl.cli-fact-qnty / bf_doc-pl.fact-qnty) * bf_parts.fact-qnty.
     1902       END.
     1903       ELSE DO:
     1904         ASSIGN
     1905           varincome-doc-l  = varincome-doc-l  + bf_parts.fact-qnty
     1906           varincome-doc-kg = varincome-doc-kg + (bf_doc-pl.cli-fact-qnty / bf_doc-pl.fact-qnty) * bf_parts.fact-qnty.
     1907       END.
     1908       if parmode <> 'ДОБАВЛЕНИЕ':U then do:
     1909         find first bf-another_goods where bf-another_goods.gds-code = paranother-gds-code no-lock.
     1910         if parwrite-off then do:
     1911           find first bf_parts-root where bf_parts-root.doc-code       = bf_parts.out-code         and
     1912                                          bf_parts-root.orig-in-code   = bf_parts.in-code          and
     1913                                          bf_parts-root.orig-gds-code  = bf_goods.gds-code         and
     1914                                          bf_parts-root.orig-part-code = bf_parts.part-code        and
     1915                                          bf_parts-root.gds-code       = bf-another_goods.gds-code no-lock no-error.
     1916           if available bf_parts-root then do:
     1917             find first bf-another_parts where bf-another_parts.obj-type   = bf_parts.obj-type          and
     1918                                               bf-another_parts.obj-code   = bf_parts.obj-code          and
     1919                                               bf-another_parts.artic      = bf-another_goods.artic     and
     1920                                               bf-another_parts.prod-type  = bf-another_goods.prod-type and
     1921                                               bf-another_parts.prod-code  = bf-another_goods.prod-code and
     1922                                               bf-another_parts.in-code    = bf_parts-root.in-code      and
     1923                                               bf-another_parts.out-code   = bf_parts.out-code          and
     1924                                               bf-another_parts.part-code  = bf_parts-root.part-code    no-lock.
     1925                ASSIGN
     1926                  varwrite-off-l  = varwrite-off-l  + bf-another_parts.real-qnty
     1927                  varwrite-off-kg = varwrite-off-kg + (bf_doc-pl.cli-fact-qnty / bf_doc-pl.fact-qnty) * bf-another_parts.real-qnty.
     1928           end.
     1929         end.
     1930         else do:
     1931           find first bf_parts-root where bf_parts-root.doc-code      = bf_parts.out-code         and
     1932                                          bf_parts-root.orig-gds-code = bf-another_goods.gds-code and
     1933                                          bf_parts-root.in-code       = bf_parts.in-code          and
     1934                                          bf_parts-root.gds-code      = bf_goods.gds-code         and
     1935                                          bf_parts-root.part-code     = bf_parts.part-code        no-lock no-error.
     1936           if available bf_parts-root then do:
     1937             find first bf-another_parts where bf-another_parts.obj-type   = bf_parts.obj-type            and
     1938                                               bf-another_parts.obj-code   = bf_parts.obj-code            and
     1939                                               bf-another_parts.artic      = bf-another_goods.artic       and
     1940                                               bf-another_parts.prod-type  = bf-another_goods.prod-type   and
     1941                                               bf-another_parts.prod-code  = bf-another_goods.prod-code   and
     1942                                               bf-another_parts.in-code    = bf_parts-root.orig-in-code   and
     1943                                               bf-another_parts.out-code   = bf_parts.out-code            and
     1944                                               bf-another_parts.part-code  = bf_parts-root.orig-part-code no-lock.
     1945             ASSIGN
     1946               varincome-l  = varincome-l  + bf-another_parts.real-qnty
     1947               varincome-kg = varincome-kg + (bf_doc-pl.cli-fact-qnty / bf_doc-pl.fact-qnty) * bf-another_parts.real-qnty.
     1948           end.
     1949         end.
     1950       end.
     1951     END.
     1952     CREATE tt-place.
     1953     ASSIGN
     1954       tt-place.pl-code          = bf_place.pl-code
     1955       tt-place.loc1             = bf_place.loc1
     1956       tt-place.pl-name          = bf_place.pl-name
     1957       tt-place.before-l         = bf_pl-gds.fact-qnty
     1958       tt-place.before-kg        = bf_pl-gds.cli-fact-qnty
     1959       tt-place.write-off-l      = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else varwrite-off-l)
     1960       tt-place.income-l         = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else varincome-l)
     1961       tt-place.write-off-kg     = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else varwrite-off-kg)
     1962       tt-place.income-kg        = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else varincome-kg   )
     1963       tt-place.write-off-doc-l  = varwrite-off-doc-l
     1964       tt-place.income-doc-l     = varincome-doc-l
     1965       tt-place.write-off-doc-kg = varwrite-off-doc-kg
     1966       tt-place.income-doc-kg    = varincome-doc-kg
     1967     .
     1968   END.
     1969   END PROCEDURE.
