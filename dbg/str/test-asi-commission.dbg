        1   define temp-table tt-commission no-undo
        2     field ii as integer
        3     field comp as character
        4     field FIO  as character
        5     field position_ as character
        6     index pi as primary unique
        7       ii
        8   .
        9   define input parameter p-rvs-code as character no-undo .
       10   define input parameter p-mode as character no-undo .
       11   define variable vss-revision    as character no-undo initial "$Revision$":U.
       12   define variable vss-author      as character no-undo initial "$Author$":U.
       13   define variable vss-date        as character no-undo initial "$Date$":U.
       14   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       15   define variable vss-archive     as character no-undo initial "$Archive$":U.
       16   define variable vss-description as character no-undo initial "Состав комиссии (проверка корректности работы АСИ)":U.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define new global shared variable g#language as character no-undo .
      117   if g#language <> '' and g#language <> 'rus':U then do:
      118     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      119   end.
      120   define variable ii as integer no-undo .
      121   define buffer buf_rvs-doc-attr for ub.rvs-doc-attr .
      122   DEFINE BUTTON b-chg
      123        LABEL "Изменить"
      124        SIZE 15 BY 1.14.
      125   DEFINE BUTTON B-exit AUTO-GO
      126        LABEL "Выход"
      127        SIZE 15 BY 1.14
      128        BGCOLOR 8 .
      129   define query br-comm for tt-commission scrolling .
      130   define browse br-comm query br-comm no-lock
      131   display
      132     tt-commission.comp column-label "Состав комиссии" format "X(22)"
      133     tt-commission.FIO  column-label "ФИО" format "X(256)" width 30
      134     tt-commission.position_ column-label "Должность" format "X(256)" width 25
      135   with size 80.25 by 6 separators.
      136   DEFINE FRAME Dialog-Frame
      137        B-exit AT ROW 1.5 COL 2
      138        b-chg AT ROW 1.5 COL 26 WIDGET-ID 2
      139        br-comm AT ROW 2.7 COL 2 WIDGET-ID 2
      140        SPACE(2) SKIP(0.5)
      141       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      142            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      143            TITLE "Состав комиссии"
      144            DEFAULT-BUTTON B-exit WIDGET-ID 100.
      145   ASSIGN
      146          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      147          FRAME Dialog-Frame:HIDDEN           = TRUE.
      148   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      149   DO:
      150     APPLY "END-ERROR":U TO SELF.
      151   END.
      152   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      153   DO:
      154     define variable v-FIO as character no-undo .
      155     define variable v-position as character no-undo .
      156     if available tt-commission
      157     then do :
      158       assign
      159         v-FIO = tt-commission.FIO
      160         v-position = tt-commission.position_
      161       .
      162       run str/test-asi-commission-chg.w (input-output v-FIO,
      163                                          input-output v-position)
      164                                          .
      165       assign
      166         tt-commission.FIO = v-FIO
      167         tt-commission.position_ = v-position
      168       .
      169     end .
      170     OPEN QUERY br-comm FOR EACH tt-commission .
      171   END.
      172   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      173   DO:
      174     for each tt-commission :
      175       if trim(tt-commission.FIO) > ""
      176       or trim(tt-commission.position_) > ""
      177       then do :
      178         find first buf_rvs-doc-attr exclusive-lock where buf_rvs-doc-attr.rvs-code = p-rvs-code
      179                                                      and buf_rvs-doc-attr.attr-code = ("test-asi-commission-" + string(tt-commission.ii))
      180                                                      no-error .
      181         if not available buf_rvs-doc-attr
      182         then do :
      183           create buf_rvs-doc-attr .
      184           assign
      185             buf_rvs-doc-attr.rvs-code = p-rvs-code
      186             buf_rvs-doc-attr.attr-code = ("test-asi-commission-" + string(tt-commission.ii))
      187           .
      188         end .
      189         assign buf_rvs-doc-attr.attr-value = tt-commission.FIO + chr(4) + tt-commission.position_ .
      190       end .
      191     end .
      192   END.
      193   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      194   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      195   MAIN-BLOCK:
      196   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      197      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      198     do ii = 1 to 5 :
      199       create tt-commission .
      200       assign
      201         tt-commission.ii = ii
      202         tt-commission.comp = (if ii = 1 then "Председатель комиссии" else "Участник комиссии")
      203       .
      204       find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = p-rvs-code
      205                                             and buf_rvs-doc-attr.attr-code = ("test-asi-commission-" + string(ii))
      206                                             no-error .
      207       if available buf_rvs-doc-attr
      208       and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      209       then do :
      210         assign
      211           tt-commission.FIO = entry(1, buf_rvs-doc-attr.attr-value, chr(4))
      212           tt-commission.position_ = entry(2, buf_rvs-doc-attr.attr-value, chr(4))
      213         .
      214       end .
      215     end .
      216     RUN enable_UI.
      217     if p-mode = 'ПРОСМОТР':U
      218     then do :
      219       disable b-chg with FRAME Dialog-Frame.
      220     end .
      221     WAIT-FOR GO OF FRAME Dialog-Frame.
      222   END.
      223   RUN disable_UI.
      224   PROCEDURE disable_UI :
      225     HIDE FRAME Dialog-Frame.
      226   END PROCEDURE.
      227   PROCEDURE enable_UI :
      228     ENABLE B-exit b-chg br-comm
      229         WITH FRAME Dialog-Frame.
      230     VIEW FRAME Dialog-Frame.
      231     OPEN QUERY br-comm FOR EACH tt-commission .
      232   END PROCEDURE.
