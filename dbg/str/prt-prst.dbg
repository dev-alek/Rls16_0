        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   procedure proc-alt-shift-f2:
        6     if not ibs.th.gbl.gbl-var:rcode
        7   then
        8     run gbl\inidebug.p .
        9   end.
       10   procedure proc-alt-shift-f3:
       11     run gbl/prvssinf.p
       12       ( input this-procedure
       13       ) .
       14   end.
       15   define variable v-inform-launched as logical no-undo initial false .
       16   procedure proc-alt-shift-f4:
       17     define variable v-action as character no-undo .
       18     if v-inform-launched = false then do:
       19       assign
       20         v-inform-launched = true
       21       .
       22       run gbl/d-inform.w
       23         (  input self
       24         ,  input this-procedure
       25         , output v-action
       26         ) no-error .
       27       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       28       assign
       29         v-inform-launched = false
       30       .
       31     end.
       32   end.
       33   procedure proc-alt-f1:
       34     run gbl/corrhelp.p
       35       (input this-procedure
       36       ) .
       37   end .
       38   on alt-shift-f2 anywhere do:
       39     run proc-alt-shift-f2.
       40   end.
       41   on alt-shift-f3 anywhere do:
       42     run proc-alt-shift-f3 in this-procedure .
       43   end.
       44   on alt-shift-f4 anywhere do:
       45     run proc-alt-shift-f4 in this-procedure.
       46   end.
       47   on alt-f1 anywhere do:
       48     run proc-alt-f1 in this-procedure .
       49   end.
       50   DEFINE PARAMETER BUFFER bf_goods FOR ub.goods.
       51   DEFINE INPUT PARAMETER pardoc-code AS CHARACTER NO-UNDO.
       52   DEFINE INPUT PARAMETER parobj-type AS CHARACTER NO-UNDO.
       53   DEFINE INPUT PARAMETER parobj-code AS INTEGER NO-UNDO.
       54   DEFINE INPUT PARAMETER parwrite-off AS LOGICAL NO-UNDO.
       55   DEFINE INPUT PARAMETER parmode AS CHARACTER NO-UNDO.
       56   DEFINE OUTPUT PARAMETER parstate AS LOGICAL INITIAL NO NO-UNDO.
       57   DEFINE SHARED TEMP-TABLE tt-gds-prt NO-UNDO
       58   FIELD prt-code LIKE ub.gds-dtl.prt-code
       59   FIELD prt-name AS CHARACTER
       60   FIELD write-off-doc-qnty AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999"
       61   FIELD income-doc-qnty AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999"
       62   FIELD write-off-qnty AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999"
       63   FIELD income-qnty AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999"
       64   FIELD fact-qnty AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999"
       65   INDEX pi IS UNIQUE PRIMARY prt-code.
       66   DEFINE BUFFER bf_gds-obj FOR ub.gds-obj.
       67   DEFINE VARIABLE varfree-brw-qnty AS DECIMAL NO-UNDO.
       68   DEFINE BUTTON b-cancel AUTO-END-KEY
       69        LABEL "&Отмена"
       70        SIZE 10 BY 1
       71        BGCOLOR 8 .
       72   DEFINE BUTTON b-exit AUTO-GO
       73        LABEL "&Ввод"
       74        SIZE 10 BY 1
       75        BGCOLOR 8 .
       76   DEFINE BUTTON b-help
       77        LABEL "&Помощь"
       78        SIZE 10 BY 1
       79        BGCOLOR 8 .
       80   DEFINE VARIABLE varbrw-f-name AS CHARACTER
       81        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
       82        SIZE 94 BY 3.42 NO-UNDO.
       83   DEFINE VARIABLE varfact-qnty AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
       84        LABEL "Факт"
       85        VIEW-AS FILL-IN
       86        SIZE 14 BY 1 NO-UNDO.
       87   DEFINE VARIABLE varfree-qnty AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
       88        LABEL "Свободно"
       89        VIEW-AS FILL-IN
       90        SIZE 14 BY 1 NO-UNDO.
       91   DEFINE VARIABLE varwork-qnty AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
       92        LABEL "По документу"
       93        VIEW-AS FILL-IN
       94        SIZE 14 BY 1 NO-UNDO.
       95   DEFINE QUERY b-gds-dtl FOR
       96         TT-gds-prt SCROLLING.
       97   DEFINE BROWSE b-gds-dtl
       98     QUERY b-gds-dtl NO-LOCK DISPLAY
       99         tt-gds-prt.prt-name FORMAT "x(300)" COLUMN-LABEL "Шкала" WIDTH 40
      100         tt-gds-prt.fact-qnty FORMAT "->>,>>>,>>9.<<<":U  COLUMN-LABEL "Было"
      101         tt-gds-prt.write-off-qnty FORMAT ">>,>>>,>>9.<<<" COLUMN-LABEL "Списано"
      102         tt-gds-prt.income-qnty FORMAT ">>,>>>,>>9.<<<" COLUMN-LABEL "Оприходовано"
      103         tt-gds-prt.fact-qnty + (if parmode = 'ДОБАВЛЕНИЕ':U then - tt-gds-prt.write-off-doc-qnty + tt-gds-prt.income-doc-qnty - tt-gds-prt.write-off-qnty + tt-gds-prt.income-qnty else - tt-gds-prt.write-off-qnty + tt-gds-prt.income-qnty)  @ varfree-brw-qnty FORMAT "->>,>>>,>>9.<<<" COLUMN-LABEL "Стало"
      104         tt-gds-prt.write-off-doc-qnty FORMAT ">>,>>>,>>9.<<<" COLUMN-LABEL "Списано в док"
      105         tt-gds-prt.income-doc-qnty FORMAT ">>,>>>,>>9.<<<" COLUMN-LABEL "Оприходовано в док"
      106         ENABLE tt-gds-prt.write-off-qnty tt-gds-prt.income-qnty
      107       WITH NO-ROW-MARKERS SEPARATORS SIZE 94 BY 13.5 EXPANDABLE.
      108   DEFINE FRAME Dialog-Frame
      109        b-exit AT ROW 1 COL 1
      110        b-cancel AT ROW 1 COL 11
      111        b-help AT ROW 1 COL 21
      112        varfact-qnty AT ROW 2.5 COL 6.5 COLON-ALIGNED
      113        varwork-qnty AT ROW 2.5 COL 37.5 COLON-ALIGNED
      114        varfree-qnty AT ROW 2.5 COL 65 COLON-ALIGNED
      115        b-gds-dtl AT ROW 4 COL 1
      116        varbrw-f-name AT ROW 17.5 COL 1 NO-LABEL
      117        SPACE(0.37) SKIP(0.00)
      118       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      119            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      120            TITLE "<insert dialog title>"
      121            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      122   ASSIGN
      123          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      124          FRAME Dialog-Frame:HIDDEN           = TRUE.
      125   ON GO OF FRAME Dialog-Frame
      126   DO:
      127     ASSIGN
      128       parstate = YES.
      129   END.
      130   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      131   DO:
      132     APPLY "END-ERROR":U TO SELF.
      133   END.
      134   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      135   DO:
      136   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   if lookup(self :type
      138            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      139            ) = 0
      140   then do:
      141     message
      142       "$Workfile$"
      143       "Указанному интерфейсному элементу фокус не может быть передан" skip
      144       "Интерфейсный элемент" self :name  skip
      145       "Тип" self :type  skip
      146       "Процедура" this-procedure :file-name skip
      147       view-as alert-box .
      148   end.
      149   else do:
      150     apply "entry":u to self  .
      151     if focus :handle <> self :handle  then do:
      152       return no-apply .
      153     end.
      154   end.
      155   END.
      156   ON GO OF b-gds-dtl IN FRAME Dialog-Frame
      157   DO:
      158     RETURN NO-APPLY.
      159   END.
      160   ON RETURN OF b-gds-dtl IN FRAME Dialog-Frame
      161   DO:
      162     RETURN NO-APPLY.
      163   END.
      164   ON ROW-LEAVE OF b-gds-dtl IN FRAME Dialog-Frame
      165   DO:
      166   ASSIGN
      167     BROWSE b-gds-dtl
      168       tt-gds-prt.write-off-qnty tt-gds-prt.income-qnty.
      169     RUN disp-free-qnty IN THIS-PROCEDURE NO-ERROR.
      170     DISPLAY (if parmode = 'ДОБАВЛЕНИЕ':U then tt-gds-prt.fact-qnty - tt-gds-prt.write-off-doc-qnty + tt-gds-prt.income-doc-qnty - tt-gds-prt.write-off-qnty + tt-gds-prt.income-qnty else tt-gds-prt.fact-qnty - tt-gds-prt.write-off-qnty + tt-gds-prt.income-qnty) @ varfree-brw-qnty WITH browse b-gds-dtl.
      171   END.
      172   ON VALUE-CHANGED OF b-gds-dtl IN FRAME Dialog-Frame
      173   DO:
      174     IF AVAILABLE tt-gds-prt THEN DO:
      175       ASSIGN
      176         varbrw-f-name = tt-gds-prt.prt-name.
      177       DISPLAY varbrw-f-name WITH FRAME Dialog-Frame.
      178     END.
      179   END.
      180   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      181   OR HELP OF FRAME Dialog-Frame
      182   DO:
      183   END.
      184   ON return OF tt-gds-prt.write-off-qnty IN BROWSE b-gds-dtl
      185   DO:
      186     APPLY "value-changed" TO BROWSE b-gds-dtl.
      187     RETURN NO-APPLY.
      188   END.
      189   ON return OF tt-gds-prt.income-qnty IN BROWSE b-gds-dtl
      190   DO:
      191     APPLY "value-changed" TO BROWSE b-gds-dtl.
      192     RETURN NO-APPLY.
      193   END.
      194   ON GO OF tt-gds-prt.write-off-qnty IN BROWSE b-gds-dtl
      195   DO:
      196     RETURN NO-APPLY.
      197   END.
      198   ON GO OF tt-gds-prt.income-qnty IN BROWSE b-gds-dtl
      199   DO:
      200     RETURN NO-APPLY.
      201   END.
      202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      204   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   on help of frame Dialog-Frame
      206   do:
      207     run gbl/app_help.p
      208       (input this-procedure :file-name
      209       ,input ''
      210       ,input ?
      211       ) no-error.
      212     if error-status :error then do:
      213       message
      214         "Ошибка при вызове помощи"
      215         error-status :get-message(1)
      216         view-as alert-box .
      217     end.
      218   end.
      219   run minbtn-set in this-procedure .
      220   on choose of b-help in frame Dialog-Frame
      221   do:
      222     apply "help":u to frame Dialog-Frame .
      223   end.
      224   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure minbtn-set :
      226       do
      227           on error undo, return error return-value
      228           :
      229           define variable ii              as integer       no-undo .
      230           define variable fh              as widget-handle no-undo .
      231           define variable hh              as widget-handle no-undo .
      232           define variable v-h             as handle        extent 4 no-undo .
      233           define variable v-name-button   as character     no-undo .
      234           define variable v-help-old-x    as decimal       no-undo .
      235           define variable v-help-old-y    as decimal       no-undo .
      236           define variable v-help-old-size as decimal       no-undo .
      237           define variable v-frame-width   as decimal       no-undo .
      238           define variable jj              as integer       no-undo .
      239           do
      240               on error undo, return error
      241               :
      242               assign
      243                   v-frame-width = frame Dialog-Frame:width - 0.3
      244                   fh            = frame Dialog-Frame:first-child
      245                   hh            = fh:first-child
      246                   ii            = 1
      247                   .
      248               do while valid-handle(hh):
      249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      250                   do:
      251                       case lc(hh:name) :
      252                           when "b-help" then
      253                               do:
      254                                   hh:load-image-up("cmp/b-help.bmp":u) .
      255                                   hh:load-image-down("cmp/b-help.bmp":u) .
      256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      257                                   hh:TOOLTIP = "Помощь" .
      258                                   v-help-old-x = hh:column .
      259                                   v-help-old-y = hh:row    .
      260                                   v-help-old-size = hh:width .
      261                                   hh:width-chars = 2.5 .
      262                               end.
      263                           when "b-print" then
      264                               do:
      265                                   hh:load-image("cmp/b-print.bmp":u) .
      266                                   hh:TOOLTIP = "Печать" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-history" or
      272                           when "b-hist" then
      273                               do:
      274                                   hh:load-image("cmp/b-hist.bmp":u) .
      275                                   hh:TOOLTIP = "История" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-sch" then
      281                               do:
      282                                   hh:load-image("cmp/b-sch.bmp":u) .
      283                                   hh:TOOLTIP = "Установка Фильтра" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-hist-user" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История пользователя" .
      292                                   ii = ii + 1 .
      293                               end.
      294                       end case.
      295                   end.
      296                   hh = hh:next-sibling.
      297               end.
      298               b-help:column = v-frame-width - b-help:width-chars.
      299               jj = 0.
      300               repeat ii = 4 to 1 by -1 :
      301                   if valid-handle (v-h[ii] ) then
      302                   do:
      303                       jj  = jj + 1 .
      304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      305                       v-h[ii]:row    = v-help-old-y .
      306                   end.
      307               end.
      308           end.
      309       end.
      310   end procedure.
      311   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      312   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      313   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      314   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      315   define variable v-diasize-current-frame-width  as decimal   no-undo .
      316   define variable v-diasize-current-frame-height as decimal   no-undo .
      317   define variable v-diasize-change-size          as logical   no-undo .
      318   define variable v-diasize-resize-button        as handle    no-undo .
      319   define variable v-diasize-wndmax               as logical   no-undo .
      320   define variable v-diasize-wndstore             as logical   no-undo .
      321   define variable v-diasize-proc-name            as character no-undo .
      322   define variable v-diasize-browse-handle        as handle    no-undo .
      323   define variable v-diasize-browse-number        as integer   no-undo .
      324   define variable v-diasize-need-full-display    as logical   no-undo init false .
      325   define temp-table temp-diasize-handle no-undo
      326     field handle-value  as handle
      327     field save-position as decimal
      328     index xpk is primary unique handle-value
      329     .
      330   define temp-table temp-browse-handle no-undo
      331     field browse-type   as character
      332     field browse-number as integer
      333     field browse-handle as handle
      334     field original-size as decimal
      335     index xpk is primary unique browse-type browse-number
      336     index xie browse-type browse-handle
      337   .
      338   procedure diasize_change-height :
      339     define input  parameter p-change-value  as decimal   no-undo .
      340     define input  parameter p-move-resize   as logical   no-undo .
      341     define variable v-field-group-handle    as handle    no-undo .
      342     define variable v-object-handle         as handle    no-undo .
      343     define variable v-frame-height          as decimal   no-undo .
      344     define variable v-frame-virtual-height  as decimal   no-undo .
      345     define variable v-browse-height         as decimal   no-undo .
      346     define variable v-window-height         as decimal   no-undo .
      347     define variable v-window-virtual-height as decimal   no-undo .
      348     define variable v-change-sign           as integer   no-undo .
      349     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      350     define buffer buf_temp-browse-handle  for temp-browse-handle .
      351     if p-change-value > 0
      352     then do:
      353       if frame Dialog-Frame :height + p-change-value
      354           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      355       then do:
      356         assign
      357           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      358                           - (frame Dialog-Frame :height-chars)
      359         .
      360         if p-change-value <= 0
      361         then do:
      362           run diasize_position-resize-button in this-procedure .
      363           return .
      364         end.
      365       end.
      366     end.
      367     if p-change-value < 0
      368     then do:
      369       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      370       then do:
      371         assign
      372           p-change-value = v-diasize-orig-frame-height
      373                          - (frame Dialog-Frame :height-chars)
      374         .
      375         if p-change-value >= 0
      376         then do:
      377           run diasize_position-resize-button in this-procedure .
      378           return .
      379         end.
      380       end.
      381     end.
      382     if p-change-value >= 0
      383     then do:
      384       assign
      385         v-change-sign = 1
      386       .
      387     end.
      388     else do:
      389       assign
      390         v-change-sign = -1
      391       .
      392     end.
      393     assign
      394       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      395     .
      396     if p-change-value = 0
      397     then do:
      398       run diasize_position-resize-button in this-procedure .
      399       return .
      400     end.
      401     move_block:
      402     do
      403     on error undo move_block, retry move_block
      404     :
      405       if retry
      406       then do:
      407         do
      408         on error undo move_block, leave move_block
      409         :
      410           if p-change-value > 0
      411           then do:
      412             for each buf_temp-diasize-handle
      413             on error undo, next
      414             :
      415               assign
      416                 v-object-handle = buf_temp-diasize-handle.handle-value
      417               .
      418               if v-object-handle <> v-diasize-resize-button
      419               then do:
      420                 assign
      421                   v-object-handle :row = buf_temp-diasize-handle.save-position
      422                 .
      423               end.
      424             end.
      425             assign
      426               v-diasize-browse-handle :height = v-browse-height
      427             .
      428             for each buf_temp-browse-handle
      429               where buf_temp-browse-handle.browse-type = 'height':u
      430             on error undo, next
      431             :
      432               assign
      433                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      434               .
      435             end.
      436             assign
      437               frame Dialog-Frame :height = v-frame-height
      438             .
      439             if frame Dialog-Frame :scrollable = true
      440             then do:
      441               assign
      442                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      443               .
      444             end.
      445             run diasize_position-resize-button in this-procedure .
      446           end.
      447           else do:
      448             if frame Dialog-Frame :scrollable = true
      449             then do:
      450               assign
      451                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      452               .
      453             end.
      454             assign
      455               frame Dialog-Frame :height = v-frame-height
      456             .
      457             assign
      458               v-diasize-browse-handle :height = v-browse-height
      459             .
      460             for each buf_temp-browse-handle
      461               where buf_temp-browse-handle.browse-type = 'height':u
      462             on error undo, next
      463             :
      464               assign
      465                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      466               .
      467             end.
      468             for each buf_temp-diasize-handle
      469             on error undo, next
      470             :
      471               assign
      472                 v-object-handle = buf_temp-diasize-handle.handle-value
      473               .
      474               if v-object-handle <> v-diasize-resize-button
      475               then do:
      476                 assign
      477                   v-object-handle :row = buf_temp-diasize-handle.save-position
      478                 .
      479               end.
      480             end.
      481             run diasize_position-resize-button in this-procedure .
      482           end.
      483           assign
      484             v-diasize-change-size = false
      485           .
      486           leave move_block .
      487         end.
      488       end.
      489       assign
      490         v-diasize-need-full-display = true
      491       .
      492       if v-diasize-change-size = false
      493       then do:
      494         assign
      495           v-diasize-change-size = true
      496         .
      497       end.
      498       else do:
      499         return .
      500       end.
      501       assign
      502         v-frame-height = frame Dialog-Frame :height
      503         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      504         v-browse-height = v-diasize-browse-handle :height
      505       .
      506       for each buf_temp-browse-handle
      507         where buf_temp-browse-handle.browse-type = 'height':u
      508       :
      509         assign
      510           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      511         .
      512       end.
      513       for each buf_temp-diasize-handle
      514       :
      515         delete buf_temp-diasize-handle .
      516       end.
      517       assign
      518         v-field-group-handle = frame Dialog-Frame :first-child
      519       .
      520       do while valid-handle(v-field-group-handle)
      521       :
      522         assign
      523           v-object-handle = v-field-group-handle :first-child
      524         .
      525         do while valid-handle(v-object-handle)
      526         :
      527           if  v-object-handle <> v-diasize-browse-handle :handle
      528           and can-query(v-object-handle, "row")
      529           and can-query(v-object-handle, "height")
      530           and ( v-object-handle :row > v-diasize-browse-handle :row )
      531           then do:
      532             find first buf_temp-browse-handle
      533               where buf_temp-browse-handle.browse-type   = 'height':u
      534                 and buf_temp-browse-handle.browse-handle = v-object-handle
      535               no-error .
      536             if available buf_temp-browse-handle
      537             then do:
      538             end.
      539             else do:
      540               create buf_temp-diasize-handle .
      541               assign
      542                 buf_temp-diasize-handle.handle-value  = v-object-handle
      543                 buf_temp-diasize-handle.save-position = v-object-handle :row
      544               .
      545             end.
      546           end.
      547           assign
      548             v-object-handle = v-object-handle :next-sibling
      549           .
      550         end.
      551         assign
      552           v-field-group-handle = v-field-group-handle :next-sibling
      553         .
      554       end.
      555       do with frame Dialog-Frame
      556       :
      557         hide v-diasize-resize-button .
      558         assign
      559           v-diasize-resize-button :row    = 1
      560           v-diasize-resize-button :column = 1
      561         .
      562       end.
      563       if p-change-value > 0
      564       then do:
      565         if frame Dialog-Frame :scrollable = true
      566         then do:
      567           assign
      568             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      569             no-error .
      570           if error-status :error
      571           or error-status :get-message(1) <> ""
      572           then do:
      573             undo move_block, retry move_block .
      574           end.
      575         end.
      576         assign
      577           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      578           no-error .
      579         if error-status :error
      580         or error-status :get-message(1) <> ""
      581         then do:
      582           undo move_block, retry move_block .
      583         end.
      584         assign
      585           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      586           no-error .
      587         if error-status :error
      588         or error-status :get-message(1) <> ""
      589         then do:
      590           undo move_block, retry move_block .
      591         end.
      592         for each buf_temp-browse-handle
      593           where buf_temp-browse-handle.browse-type = 'height':u
      594         on error undo move_block, retry move_block
      595         :
      596           assign
      597             buf_temp-browse-handle.browse-handle :height
      598               = buf_temp-browse-handle.browse-handle :height + p-change-value
      599             no-error .
      600           if error-status :error
      601           or error-status :get-message(1) <> ""
      602           then do:
      603             undo move_block, retry move_block .
      604           end.
      605         end.
      606         for each buf_temp-diasize-handle
      607         on error undo move_block, retry move_block
      608         :
      609           assign
      610             v-object-handle = buf_temp-diasize-handle.handle-value
      611           .
      612           if v-object-handle <> v-diasize-resize-button
      613           then do:
      614             assign
      615               v-object-handle :row = v-object-handle :row + p-change-value
      616               no-error .
      617             if error-status :error
      618             or error-status :get-message(1) <> ""
      619             then do:
      620               undo move_block, retry move_block .
      621             end.
      622           end.
      623         end.
      624       end.
      625       else do:
      626         for each buf_temp-diasize-handle
      627         on error undo move_block, retry move_block
      628         :
      629           assign
      630             v-object-handle = buf_temp-diasize-handle.handle-value
      631           .
      632           if v-object-handle <> v-diasize-resize-button
      633           then do:
      634             assign
      635               v-object-handle :row = v-object-handle :row + p-change-value
      636               no-error .
      637             if error-status :error
      638             or error-status :get-message(1) <> ""
      639             then do:
      640               undo move_block, retry move_block .
      641             end.
      642           end.
      643         end.
      644         assign
      645           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      646           no-error .
      647         if error-status :error
      648         or error-status :get-message(1) <> ""
      649         then do:
      650           undo move_block, retry move_block .
      651         end.
      652         for each buf_temp-browse-handle
      653           where buf_temp-browse-handle.browse-type = 'height':u
      654         on error undo move_block, retry move_block
      655         :
      656           assign
      657             buf_temp-browse-handle.browse-handle :height
      658               = buf_temp-browse-handle.browse-handle :height + p-change-value
      659             no-error .
      660           if error-status :error
      661           or error-status :get-message(1) <> ""
      662           then do:
      663             undo move_block, retry move_block .
      664           end.
      665         end.
      666         assign
      667           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      668           no-error .
      669         if error-status :error
      670         or error-status :get-message(1) <> ""
      671         then do:
      672           undo move_block, retry move_block .
      673         end.
      674         if frame Dialog-Frame :scrollable = true
      675         then do:
      676           assign
      677             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      678             no-error .
      679           if error-status :error
      680           or error-status :get-message(1) <> ""
      681           then do:
      682             undo move_block, retry move_block .
      683           end.
      684         end.
      685       end.
      686       if p-move-resize = true
      687       then do:
      688         run diasize_position-resize-button in this-procedure .
      689       end.
      690       if v-diasize-wndstore = true
      691       then do:
      692         if connected("ub") = true
      693         then do:
      694           define variable v-cntxt-db-num        as integer   no-undo .
      695           define variable v-cntxt-userid        as character no-undo .
      696           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      697                                             , OUTPUT v-cntxt-userid
      698                                             ) .
      699           run gbl/wndsizew.p
      700             (input  v-cntxt-db-num
      701             ,input  v-cntxt-userid
      702             ,input  v-diasize-proc-name
      703             ,input  'height':u
      704             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      705             ) .
      706         end.
      707       end.
      708     end.
      709     assign
      710       v-diasize-change-size = false
      711     .
      712   end procedure.
      713   procedure diasize_set-height :
      714     define input  parameter p-new-height  as decimal   no-undo .
      715     define input  parameter p-move-resize as logical   no-undo .
      716     do
      717     on error undo, return error return-value
      718     :
      719       run diasize_change-height in this-procedure
      720         (input  (p-new-height - frame Dialog-Frame :height)
      721         ,input  p-move-resize
      722         ) .
      723     end.
      724   end procedure.
      725   procedure diasize_change-width :
      726     define input  parameter p-change-value as decimal   no-undo .
      727     define input  parameter p-move-resize  as logical   no-undo .
      728     define variable v-field-group-handle   as handle    no-undo .
      729     define variable v-object-handle        as handle    no-undo .
      730     define variable v-frame-width          as decimal   no-undo .
      731     define variable v-frame-virtual-width  as decimal   no-undo .
      732     define variable v-browse-width         as decimal   no-undo .
      733     define variable v-window-width         as decimal   no-undo .
      734     define variable v-window-virtual-width as decimal   no-undo .
      735     define variable v-change-sign          as integer   no-undo .
      736     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      737     define buffer buf_temp-browse-handle  for temp-browse-handle .
      738     if p-change-value > 0
      739     then do:
      740       if frame Dialog-Frame :width + p-change-value >
      741           session :width-chars
      742       then do:
      743         assign
      744           p-change-value = session :width-chars - frame Dialog-Frame :width
      745         .
      746         if p-change-value <= 0
      747         then do:
      748           run diasize_position-resize-button in this-procedure .
      749           return .
      750         end.
      751       end.
      752     end.
      753     if p-change-value < 0
      754     then do:
      755       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      756       then do:
      757         assign
      758           p-change-value = v-diasize-orig-frame-width
      759                          - frame Dialog-Frame :width
      760         .
      761         if p-change-value >= 0
      762         then do:
      763           run diasize_position-resize-button in this-procedure .
      764           return .
      765         end.
      766       end.
      767     end.
      768     if p-change-value >= 0
      769     then do:
      770       assign
      771         v-change-sign = 1
      772       .
      773     end.
      774     else do:
      775       assign
      776         v-change-sign = -1
      777       .
      778     end.
      779     assign
      780       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      781     .
      782     if p-change-value = 0
      783     then do:
      784       run diasize_position-resize-button in this-procedure .
      785       return .
      786     end.
      787     move_block:
      788     do
      789     on error undo move_block, leave move_block
      790     :
      791       if retry
      792       then do:
      793         do
      794         on error undo move_block, leave move_block
      795         :
      796           if p-change-value > 0
      797           then do:
      798             for each buf_temp-diasize-handle
      799             on error undo, next
      800             :
      801               assign
      802                 v-object-handle = buf_temp-diasize-handle.handle-value
      803               .
      804               if v-object-handle <> v-diasize-resize-button
      805               then do:
      806                 assign
      807                   v-object-handle :col = buf_temp-diasize-handle.save-position
      808                 .
      809               end.
      810             end.
      811             assign
      812               v-diasize-browse-handle :width = v-browse-width
      813             .
      814             for each buf_temp-browse-handle
      815               where buf_temp-browse-handle.browse-type = 'width':u
      816             on error undo, next
      817             :
      818               assign
      819                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      820               .
      821             end.
      822             assign
      823               frame Dialog-Frame :width = v-frame-width
      824             .
      825             if frame Dialog-Frame :scrollable = true
      826             then do:
      827               assign
      828                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      829               .
      830             end.
      831             run diasize_position-resize-button in this-procedure .
      832           end.
      833           else do:
      834             if frame Dialog-Frame :scrollable = true
      835             then do:
      836               assign
      837                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      838               .
      839             end.
      840             assign
      841               frame Dialog-Frame :width = v-frame-width
      842             .
      843             for each buf_temp-browse-handle
      844               where buf_temp-browse-handle.browse-type = 'width':u
      845             on error undo, next
      846             :
      847               assign
      848                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      849               .
      850             end.
      851             assign
      852               v-diasize-browse-handle :width = v-browse-width
      853             .
      854             for each buf_temp-diasize-handle
      855             on error undo, next
      856             :
      857               assign
      858                 v-object-handle = buf_temp-diasize-handle.handle-value
      859               .
      860               if v-object-handle <> v-diasize-resize-button
      861               then do:
      862                 assign
      863                   v-object-handle :col = buf_temp-diasize-handle.save-position
      864                 .
      865               end.
      866             end.
      867             run diasize_position-resize-button in this-procedure .
      868           end.
      869           assign
      870             v-diasize-change-size = false
      871           .
      872           leave move_block .
      873         end.
      874       end.
      875       assign
      876         v-diasize-need-full-display = true
      877       .
      878       if v-diasize-change-size = false
      879       then do:
      880         assign
      881           v-diasize-change-size = true
      882         .
      883       end.
      884       else do:
      885         return .
      886       end.
      887       assign
      888         v-frame-width = frame Dialog-Frame :width
      889         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      890         v-browse-width = v-diasize-browse-handle :width
      891       .
      892       for each buf_temp-browse-handle
      893         where buf_temp-browse-handle.browse-type = 'width':u
      894       :
      895         assign
      896           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      897         .
      898       end.
      899       for each buf_temp-diasize-handle
      900       :
      901         delete buf_temp-diasize-handle .
      902       end.
      903       assign
      904         v-field-group-handle = frame Dialog-Frame :first-child
      905       .
      906       do while valid-handle(v-field-group-handle)
      907       :
      908         assign
      909           v-object-handle = v-field-group-handle :first-child
      910         .
      911         do while valid-handle(v-object-handle)
      912         :
      913           if  v-object-handle <> v-diasize-browse-handle :handle
      914           and v-object-handle <> v-diasize-resize-button
      915           and can-query(v-object-handle, "row")
      916           and can-query(v-object-handle, "height")
      917           and ( v-object-handle :col + v-object-handle :width
      918                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      919               )
      920           then do:
      921             find first buf_temp-browse-handle
      922               where buf_temp-browse-handle.browse-type   = 'width':u
      923                 and buf_temp-browse-handle.browse-handle = v-object-handle
      924               no-error .
      925             if available buf_temp-browse-handle
      926             then do:
      927             end.
      928             else do:
      929               create buf_temp-diasize-handle .
      930               assign
      931                 buf_temp-diasize-handle.handle-value  = v-object-handle
      932                 buf_temp-diasize-handle.save-position = v-object-handle :col
      933               .
      934             end.
      935           end.
      936           assign
      937             v-object-handle = v-object-handle :next-sibling
      938           .
      939         end.
      940         assign
      941           v-field-group-handle = v-field-group-handle :next-sibling
      942         .
      943       end.
      944       do with frame Dialog-Frame
      945       :
      946         hide v-diasize-resize-button .
      947         v-diasize-resize-button :row = 1.
      948         v-diasize-resize-button :column = 1.
      949       end.
      950       if p-change-value > 0
      951       then do:
      952         if frame Dialog-Frame :scrollable = true
      953         then do:
      954           assign
      955             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      956             no-error .
      957           if error-status :error
      958           or error-status :get-message(1) <> ""
      959           then do:
      960             undo move_block, retry move_block.
      961           end.
      962         end.
      963         assign
      964           frame Dialog-Frame :width = v-frame-width + p-change-value
      965           no-error .
      966         if error-status :error
      967         or error-status :get-message(1) <> ""
      968         then do:
      969           undo move_block, retry move_block.
      970         end.
      971         assign
      972           v-diasize-browse-handle :width = v-browse-width + p-change-value
      973         no-error .
      974         if error-status :error
      975         or error-status :get-message(1) <> ""
      976         then do:
      977           undo move_block, retry move_block.
      978         end.
      979         for each buf_temp-browse-handle
      980           where buf_temp-browse-handle.browse-type = 'width':u
      981         on error undo move_block, retry move_block
      982         :
      983           assign
      984             buf_temp-browse-handle.browse-handle :width
      985               = buf_temp-browse-handle.browse-handle :width + p-change-value
      986             no-error .
      987           if error-status :error
      988           or error-status :get-message(1) <> ""
      989           then do:
      990             undo move_block, retry move_block .
      991           end.
      992         end.
      993         for each buf_temp-diasize-handle
      994         on error undo move_block, retry move_block
      995         :
      996           assign
      997             v-object-handle = buf_temp-diasize-handle.handle-value
      998           .
      999           if v-object-handle <> v-diasize-resize-button
     1000           then do:
     1001             assign
     1002               v-object-handle :col = v-object-handle :col + p-change-value
     1003               no-error .
     1004             if error-status :error
     1005             or error-status :get-message(1) <> ""
     1006             then do:
     1007               undo move_block, retry move_block .
     1008             end.
     1009           end.
     1010         end.
     1011       end.
     1012       else do:
     1013         for each buf_temp-diasize-handle
     1014         on error undo move_block, retry move_block
     1015         :
     1016           assign
     1017             v-object-handle = buf_temp-diasize-handle.handle-value
     1018           .
     1019           if v-object-handle <> v-diasize-resize-button
     1020           then do:
     1021             assign
     1022               v-object-handle :col = v-object-handle :col + p-change-value
     1023               no-error .
     1024             if error-status :error
     1025             or error-status :get-message(1) <> ""
     1026             then do:
     1027               undo move_block, retry move_block .
     1028             end.
     1029           end.
     1030         end.
     1031         for each buf_temp-browse-handle
     1032           where buf_temp-browse-handle.browse-type = 'width':u
     1033         on error undo move_block, retry move_block
     1034         :
     1035           assign
     1036             buf_temp-browse-handle.browse-handle :width
     1037               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1038             no-error .
     1039           if error-status :error
     1040           or error-status :get-message(1) <> ""
     1041           then do:
     1042             undo move_block, retry move_block .
     1043           end.
     1044         end.
     1045         assign
     1046           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1047           no-error .
     1048         if error-status :error
     1049         or error-status :get-message(1) <> ""
     1050         then do:
     1051           undo move_block, retry move_block.
     1052         end.
     1053         assign
     1054           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1055         no-error .
     1056         if error-status :error
     1057         or error-status :get-message(1) <> ""
     1058         then do:
     1059           undo move_block, retry move_block.
     1060         end.
     1061         if frame Dialog-Frame :scrollable = true
     1062         then do:
     1063           assign
     1064             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1065           no-error .
     1066           if error-status :error
     1067           or error-status :get-message(1) <> ""
     1068           then do:
     1069             undo move_block, retry move_block.
     1070           end.
     1071         end.
     1072       end.
     1073       if p-move-resize
     1074       then do:
     1075         run diasize_position-resize-button in this-procedure .
     1076       end.
     1077       if v-diasize-wndstore = true
     1078       then do:
     1079         if connected("ub") = true
     1080         then do:
     1081           define variable v-cntxt-db-num        as integer   no-undo .
     1082           define variable v-cntxt-userid        as character no-undo .
     1083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1084                                             , OUTPUT v-cntxt-userid
     1085                                             ) .
     1086           run gbl/wndsizew.p
     1087             (input  v-cntxt-db-num
     1088             ,input  v-cntxt-userid
     1089             ,input  v-diasize-proc-name
     1090             ,input  'width':u
     1091             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1092             ) .
     1093         end.
     1094       end.
     1095     end.
     1096     assign
     1097       v-diasize-change-size = false
     1098     .
     1099   end procedure.
     1100   procedure diasize_set-width :
     1101     define input  parameter p-new-width  as decimal   no-undo .
     1102     define input  parameter p-move-resize as logical   no-undo .
     1103     do
     1104     on error undo, return error return-value
     1105     :
     1106       run diasize_change-width in this-procedure
     1107         (input  (p-new-width - frame Dialog-Frame :width)
     1108         ,input  p-move-resize
     1109         ) .
     1110     end.
     1111   end procedure.
     1112   procedure diasize_position-resize-button :
     1113     do with frame Dialog-Frame
     1114     :
     1115       hide v-diasize-resize-button .
     1116       assign
     1117         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1118                     - 1
     1119                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1120         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1121                     - 1
     1122                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1123       .
     1124       view v-diasize-resize-button .
     1125     end.
     1126   end procedure.
     1127   on alt-right anywhere
     1128   do:
     1129     run diasize_change-width in this-procedure
     1130       (input 1
     1131       ,input true
     1132       ) .
     1133     return no-apply .
     1134   end.
     1135   on alt-left anywhere
     1136   do:
     1137     run diasize_change-width in this-procedure
     1138       (input -1
     1139       ,input true
     1140       ) .
     1141     return no-apply .
     1142   end.
     1143   on alt-down anywhere
     1144   do:
     1145     run diasize_change-height in this-procedure
     1146       (input 1
     1147       ,input true
     1148       ) .
     1149     return no-apply .
     1150   end.
     1151   on alt-up anywhere
     1152   do:
     1153     run diasize_change-height in this-procedure
     1154       (input -1
     1155       ,input true
     1156       ) .
     1157     return no-apply .
     1158   end.
     1159   on alt-enter of frame Dialog-Frame
     1160   do:
     1161     run diasize_maximize in this-procedure
     1162       (input  ?
     1163       ).
     1164     return no-apply .
     1165   end.
     1166   procedure diasize_end-move :
     1167     do
     1168     on error undo, return error return-value
     1169     :
     1170       define variable v-row-delta as decimal   no-undo .
     1171       define variable v-col-delta as decimal   no-undo .
     1172       define variable v-new-row as decimal   no-undo .
     1173       define variable v-new-col as decimal   no-undo .
     1174       assign
     1175         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1176         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1177       .
     1178       assign
     1179         v-row-delta = v-new-row - frame Dialog-Frame :height
     1180         v-col-delta = v-new-col - frame Dialog-Frame :width
     1181       .
     1182       run diasize_change-height in this-procedure
     1183         (input v-row-delta
     1184         ,input true
     1185         ) .
     1186       run diasize_change-width in this-procedure
     1187         (input v-col-delta
     1188         ,input true
     1189         ) .
     1190     end.
     1191   end procedure.
     1192   procedure diasize_maximize :
     1193     define input  parameter p-action as logical   no-undo .
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197       if p-action = ?
     1198       then do:
     1199         if v-diasize-need-maximize = true
     1200         then do:
     1201           assign
     1202             p-action = true
     1203           .
     1204         end.
     1205         else do:
     1206           assign
     1207             p-action = false
     1208           .
     1209         end.
     1210       end.
     1211       if p-action = true
     1212       then do:
     1213         run diasize_change-height in this-procedure
     1214           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1215               - frame Dialog-Frame :height-chars
     1216           ,input true
     1217           ) .
     1218         run diasize_change-width in this-procedure
     1219           (input session :width-chars
     1220               - frame Dialog-Frame :width-chars
     1221           ,input true
     1222           ) .
     1223         assign
     1224           v-diasize-need-maximize = false
     1225         .
     1226       end.
     1227       else do:
     1228         run diasize_change-width in this-procedure
     1229           (input v-diasize-orig-frame-width
     1230               - frame Dialog-Frame :width-chars
     1231           ,input true
     1232           ) .
     1233         run diasize_change-height in this-procedure
     1234           (input v-diasize-orig-frame-height
     1235               - frame Dialog-Frame :height-chars
     1236           ,input true
     1237           ) .
     1238         assign
     1239           v-diasize-need-maximize = true
     1240         .
     1241       end.
     1242     end.
     1243   end procedure.
     1244   procedure diasize_restore-orig-size :
     1245     do
     1246     on error undo, return error return-value
     1247     :
     1248       assign
     1249         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1250         v-diasize-current-frame-height = frame Dialog-Frame :height
     1251       .
     1252       run diasize_set-height in this-procedure
     1253         (input  v-diasize-orig-frame-height
     1254         ,input  true
     1255         ) .
     1256       run diasize_set-width in this-procedure
     1257         (input  v-diasize-orig-frame-width
     1258         ,input  true
     1259         ) .
     1260     end.
     1261   end procedure.
     1262   procedure diasize_restore-current-size :
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       run diasize_set-height in this-procedure
     1267         (input  v-diasize-current-frame-height
     1268         ,input  true
     1269         ) .
     1270       run diasize_set-width in this-procedure
     1271         (input  v-diasize-current-frame-width
     1272         ,input  true
     1273         ) .
     1274     end.
     1275   end procedure.
     1276   procedure diasize_set-browse-handle :
     1277     define input  parameter p-browse-handle as handle   no-undo .
     1278     define buffer buf_temp-browse-handle for temp-browse-handle .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       assign
     1283         v-diasize-browse-handle = p-browse-handle
     1284       .
     1285       for each buf_temp-browse-handle
     1286       on error undo, return error return-value
     1287       :
     1288         delete buf_temp-browse-handle .
     1289       end.
     1290     end.
     1291   end procedure.
     1292   procedure diasize_add_browse :
     1293     define input  parameter p-browse-type   as character no-undo .
     1294     define input  parameter p-browse-handle as handle    no-undo .
     1295     define buffer buf_temp-browse-handle for temp-browse-handle .
     1296     do
     1297     on error undo, return error return-value
     1298     :
     1299       assign
     1300         v-diasize-browse-number = v-diasize-browse-number + 1
     1301       .
     1302       create buf_temp-browse-handle .
     1303       assign
     1304         buf_temp-browse-handle.browse-type   = p-browse-type
     1305         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1306         buf_temp-browse-handle.browse-handle = p-browse-handle
     1307       .
     1308     end.
     1309   end procedure.
     1310   procedure diasize_init :
     1311     define variable v-default-value    as logical   no-undo .
     1312     define variable v-restore-saved    as logical   no-undo .
     1313     define variable v-resize-value-str as character no-undo .
     1314     do
     1315     on error undo, return error return-value
     1316     :
     1317       do with frame Dialog-Frame
     1318       :
     1319         assign
     1320           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1321           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1322           v-diasize-browse-handle     = browse b-gds-dtl :handle
     1323         .
     1324         create button v-diasize-resize-button
     1325         assign
     1326           parent        = frame Dialog-Frame :first-child
     1327           label         = "s"
     1328           height-pixels = 16
     1329           width-pixels  = 16
     1330           visible       = true
     1331           sensitive     = true
     1332           movable       = true
     1333           triggers:
     1334             on end-move persistent run diasize_end-move in this-procedure .
     1335           end triggers.
     1336         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1337         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1338         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1339         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1340         assign
     1341           v-diasize-wndmax = false
     1342         .
     1343         if connected("ub") = true
     1344         then do:
     1345           define variable v-cntxt-db-num        as integer   no-undo .
     1346           define variable v-cntxt-userid        as character no-undo .
     1347           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1348                                             , OUTPUT v-cntxt-userid
     1349                                             ) .
     1350           run gbl/wndpar_r.p
     1351             (input  v-cntxt-db-num
     1352             ,input  v-cntxt-userid
     1353             ,input  'wndmax':U
     1354             ,output v-diasize-wndmax
     1355             ,output v-default-value
     1356             ) .
     1357         end.
     1358         assign
     1359           v-diasize-wndstore = false
     1360         .
     1361         if connected("ub") = true
     1362         then do:
     1363           run gbl/wndpar_r.p
     1364             (input  v-cntxt-db-num
     1365             ,input  v-cntxt-userid
     1366             ,input  'wndstore':U
     1367             ,output v-diasize-wndstore
     1368             ,output v-default-value
     1369             ) .
     1370         end.
     1371         assign
     1372           v-diasize-proc-name = entry(1, program-name(2), '.')
     1373         .
     1374         if v-diasize-wndstore = true
     1375         then do:
     1376           assign
     1377             v-restore-saved = false
     1378           .
     1379           if connected("ub") = true
     1380           then do:
     1381             run gbl/wndsizer.p
     1382               (input  v-cntxt-db-num
     1383               ,input  v-cntxt-userid
     1384               ,input  v-diasize-proc-name
     1385               ,input  'height':u
     1386               ,output v-resize-value-str
     1387               ) .
     1388             if v-resize-value-str <> '':U
     1389             then do:
     1390               run diasize_change-height in this-procedure
     1391                 (input  integer(v-resize-value-str)
     1392                 ,input  true
     1393                 ) .
     1394               assign
     1395                 v-restore-saved = true
     1396               .
     1397             end.
     1398           end.
     1399           if connected("ub") = true
     1400           then do:
     1401             run gbl/wndsizer.p
     1402               (input  v-cntxt-db-num
     1403               ,input  v-cntxt-userid
     1404               ,input  v-diasize-proc-name
     1405               ,input  'width':u
     1406               ,output v-resize-value-str
     1407               ) .
     1408             if v-resize-value-str <> '':U
     1409             then do:
     1410               run diasize_change-width in this-procedure
     1411                 (input  integer(v-resize-value-str)
     1412                 ,input  true
     1413                 ) .
     1414               assign
     1415                 v-restore-saved = true
     1416               .
     1417             end.
     1418           end.
     1419           if v-restore-saved <> true
     1420           then do:
     1421             if v-diasize-wndmax = true
     1422             then do:
     1423               run diasize_maximize in this-procedure
     1424                 (input  true
     1425                 ) .
     1426             end.
     1427           end.
     1428         end.
     1429         else do:
     1430           if v-diasize-wndmax = true
     1431           then do:
     1432             run diasize_maximize in this-procedure
     1433               (input  true
     1434               ) .
     1435           end.
     1436         end.
     1437       end.
     1438     end.
     1439   end procedure.
     1440   procedure diasize_need-full-display :
     1441     define output parameter p-need-full-display as logical   no-undo .
     1442     do
     1443     on error undo, return error return-value
     1444     :
     1445       assign
     1446         p-need-full-display = v-diasize-need-full-display
     1447       .
     1448       assign
     1449         v-diasize-need-full-display = false
     1450       .
     1451     end.
     1452   end procedure.
     1453   procedure get-context :
     1454      define output parameter p-db-num as integer          no-undo.
     1455      define output parameter p-user-id as character        no-undo.
     1456      define variable v-login               as character    no-undo.
     1457      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1458      define buffer buf_user-login  for ub.user-login .
     1459      do
     1460      on error undo, return error
     1461      :
     1462            FIND FIRST buf_sys-ctrl no-lock.
     1463            ASSIGN
     1464               v-login = USERID("ub")
     1465               p-db-num = buf_sys-ctrl.db-num
     1466            .
     1467            FIND FIRST buf_user-login
     1468                 WHERE buf_user-login.db-num = p-db-num
     1469                   AND buf_user-login.user-login = v-login
     1470                 no-lock
     1471                 no-error
     1472                 .
     1473            IF AVAILABLE buf_user-login
     1474            THEN DO:
     1475               assign
     1476                  p-user-id = buf_user-login.user-id
     1477               .
     1478            END.
     1479      end.
     1480   end procedure.
     1481       run diasize_init in this-procedure .
     1482   MAIN-BLOCK:
     1483   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1484      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1485    ASSIGN
     1486       frame Dialog-Frame:TITLE = "Редактирование признаков для документа пересортица " + pardoc-code + " для товара " + bf_goods.artic + " " + bf_goods.prod-type + " " + string(bf_goods.prod-code) + " " + bf_goods.gds-name.
     1487     FIND FIRST bf_gds-obj WHERE bf_gds-obj.obj-type  = parobj-type        AND
     1488                                 bf_gds-obj.obj-code  = parobj-code        AND
     1489                                 bf_gds-obj.artic     = bf_goods.artic     AND
     1490                                 bf_gds-obj.prod-type = bf_goods.prod-type AND
     1491                                 bf_gds-obj.prod-code = bf_goods.prod-code NO-LOCK no-error .
     1492     ASSIGN
     1493       varfact-qnty = if available bf_gds-obj then bf_gds-obj.fact-qnty else 0.
     1494     DISPLAY varfact-qnty WITH FRAME Dialog-Frame.
     1495     RUN make-tt-table IN THIS-PROCEDURE.
     1496     RUN disp-free-qnty IN THIS-PROCEDURE.
     1497     RUN enable_UI.
     1498     IF parwrite-off = YES THEN DO:
     1499       ASSIGN
     1500         tt-gds-prt.income-qnty:READ-ONLY = YES.
     1501     END.
     1502     ELSE DO:
     1503       ASSIGN
     1504         tt-gds-prt.write-off-qnty:READ-ONLY = YES.
     1505     END.
     1506     IF parmode = 'ПРОСМОТР':U THEN DO:
     1507       ASSIGN
     1508         tt-gds-prt.income-qnty:READ-ONLY    = YES
     1509         tt-gds-prt.write-off-qnty:READ-ONLY = YES.
     1510       DISABLE b-exit WITH FRAME Dialog-Frame.
     1511     END.
     1512     apply "VALUE-CHANGED" to b-gds-dtl IN FRAME Dialog-Frame.
     1513     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS b-gds-dtl.
     1514   END.
     1515   RUN disable_UI.
     1516   PROCEDURE disable_UI :
     1517     HIDE FRAME Dialog-Frame.
     1518   END PROCEDURE.
     1519   PROCEDURE disp-free-qnty :
     1520   DEFINE BUFFER bf_tt-gds-prt FOR tt-gds-prt.
     1521     ASSIGN
     1522       varwork-qnty = 0.00.
     1523     FOR EACH bf_tt-gds-prt ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1524       ASSIGN
     1525         varwork-qnty = varwork-qnty + (if parmode = 'ДОБАВЛЕНИЕ':U then - bf_tt-gds-prt.write-off-doc-qnty + bf_tt-gds-prt.income-doc-qnty - bf_tt-gds-prt.write-off-qnty + bf_tt-gds-prt.income-qnty else - bf_tt-gds-prt.write-off-qnty + bf_tt-gds-prt.income-qnty).
     1526     END.
     1527     ASSIGN
     1528       varfree-qnty = varfact-qnty + varwork-qnty.
     1529     DISPLAY varwork-qnty varfree-qnty WITH FRAME Dialog-Frame.
     1530   END PROCEDURE.
     1531   PROCEDURE enable_UI :
     1532     DISPLAY varfact-qnty varwork-qnty varfree-qnty varbrw-f-name
     1533         WITH FRAME Dialog-Frame.
     1534     ENABLE b-exit b-cancel b-help b-gds-dtl
     1535         WITH FRAME Dialog-Frame.
     1536     VIEW FRAME Dialog-Frame.
     1537     OPEN QUERY b-gds-dtl FOR EACH TT-gds-prt NO-LOCK INDEXED-REPOSITION.
     1538   END PROCEDURE.
     1539   PROCEDURE make-tt-table :
     1540   DEFINE BUFFER bf_prt-obj      FOR ub.prt-obj.
     1541   DEFINE BUFFER bf_gds-dtl      FOR ub.gds-dtl.
     1542   DEFINE BUFFER bf-root_gds-prt FOR ub.gds-prt.
     1543   DEFINE BUFFER bf_gds-prt      FOR ub.gds-prt.
     1544   DEFINE BUFFER bf_parts        FOR ub.parts.
     1545   DEFINE VARIABLE varwrite-off-qnty AS DECIMAL NO-UNDO.
     1546   DEFINE VARIABLE varincome-qnty    AS DECIMAL NO-UNDO.
     1547   FOR EACH tt-gds-prt :
     1548     DELETE tt-gds-prt.
     1549   END.
     1550   ASSIGN
     1551     varwrite-off-qnty = 0.00
     1552     varincome-qnty    = 0.00.
     1553   IF parwrite-off THEN DO:
     1554    FOR EACH bf_prt-obj WHERE bf_prt-obj.obj-type  = parobj-type        AND
     1555                              bf_prt-obj.obj-code  = parobj-code        AND
     1556                              bf_prt-obj.artic     = bf_goods.artic     AND
     1557                              bf_prt-obj.prod-type = bf_goods.prod-type AND
     1558                              bf_prt-obj.prod-code = bf_goods.prod-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1559       if bf_prt-obj.free-qnty <= 0 then next.
     1560       FIND FIRST bf_gds-prt WHERE bf_gds-prt.node-code = bf_prt-obj.prt-code NO-LOCK .
     1561       IF bf_gds-prt.is-term <> YES THEN DO:
     1562         NEXT.
     1563       END.
     1564       FIND FIRST bf_gds-dtl WHERE bf_gds-dtl.doc-code  = pardoc-code          AND
     1565                                   bf_gds-dtl.artic     = bf_prt-obj.artic     AND
     1566                                   bf_gds-dtl.prod-type = bf_prt-obj.prod-type AND
     1567                                   bf_gds-dtl.prod-code = bf_prt-obj.prod-code AND
     1568                                   bf_gds-dtl.prt-code  = bf_prt-obj.prt-code  NO-LOCK NO-ERROR.
     1569       CREATE tt-gds-prt.
     1570       ASSIGN
     1571         tt-gds-prt.prt-code              = bf_gds-prt.node-code
     1572         tt-gds-prt.prt-name              = bf_gds-prt.f-name
     1573         tt-gds-prt.fact-qnty             = bf_prt-obj.fact-qnty
     1574         tt-gds-prt.write-off-doc-qnty    = (if available bf_gds-dtl and bf_gds-dtl.doc-qnty < 0 then - bf_gds-dtl.doc-qnty else 0)
     1575         tt-gds-prt.income-doc-qnty       = (if available bf_gds-dtl and bf_gds-dtl.doc-qnty > 0 then   bf_gds-dtl.doc-qnty else 0)
     1576         tt-gds-prt.write-off-qnty        = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else tt-gds-prt.write-off-doc-qnty )
     1577         tt-gds-prt.income-qnty           = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else tt-gds-prt.income-doc-qnty    )
     1578       .
     1579     END.
     1580   END.
     1581   ELSE DO:
     1582     FIND FIRST bf-root_gds-prt WHERE bf-root_gds-prt.upper-code = bf_goods.prt-root no-lock.
     1583     FOR EACH bf_gds-prt WHERE bf_gds-prt.prt-root = bf-root_gds-prt.prt-root and
     1584                               bf_gds-prt.is-term  = YES                      NO-LOCK ON ERROR UNDO, RETURN ERROR :
     1585       FIND FIRST bf_prt-obj WHERE bf_prt-obj.obj-type  = parobj-type         AND
     1586                                   bf_prt-obj.obj-code  = parobj-code         AND
     1587                                   bf_prt-obj.artic     = bf_goods.artic      AND
     1588                                   bf_prt-obj.prod-type = bf_goods.prod-type  AND
     1589                                   bf_prt-obj.prod-code = bf_goods.prod-code  AND
     1590                                   bf_prt-obj.prt-code  = bf_gds-prt.node-code  NO-LOCK NO-ERROR.
     1591       FIND FIRST bf_gds-dtl WHERE bf_gds-dtl.doc-code  = pardoc-code          AND
     1592                                   bf_gds-dtl.artic     = bf_goods.artic     AND
     1593                                   bf_gds-dtl.prod-type = bf_goods.prod-type AND
     1594                                   bf_gds-dtl.prod-code = bf_goods.prod-code AND
     1595                                   bf_gds-dtl.prt-code  = bf_gds-prt.node-code NO-LOCK NO-ERROR.
     1596       CREATE tt-gds-prt.
     1597       ASSIGN
     1598         tt-gds-prt.prt-code           = bf_gds-prt.node-code
     1599         tt-gds-prt.prt-name           = bf_gds-prt.f-name
     1600         tt-gds-prt.fact-qnty          = (IF AVAILABLE bf_prt-obj THEN bf_prt-obj.fact-qnty ELSE 0)
     1601         tt-gds-prt.write-off-doc-qnty = (if available bf_gds-dtl and bf_gds-dtl.doc-qnty < 0 then - bf_gds-dtl.doc-qnty else 0)
     1602         tt-gds-prt.income-doc-qnty    = (if available bf_gds-dtl and bf_gds-dtl.doc-qnty > 0 then   bf_gds-dtl.doc-qnty else 0)
     1603         tt-gds-prt.write-off-qnty     = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else tt-gds-prt.write-off-doc-qnty)
     1604         tt-gds-prt.income-qnty        = (if parmode = 'ДОБАВЛЕНИЕ':U then 0 else tt-gds-prt.income-doc-qnty   )
     1605       .
     1606     END.
     1607   END.
     1608   END PROCEDURE.
