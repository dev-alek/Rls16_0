       74     define output parameter p-label          as character no-undo .
       75     define output parameter p-user-can-edit  as logical   no-undo .
       76     define output parameter p-output-display as logical   no-undo .
       77     define output parameter p-other          as character no-undo .
       78     do
       79     on error undo, return error
       80     :
       81           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
       82         (input  p-code
       83         ,output p-type
       84         ,output p-format
       85         ,output p-label
       86         ,output p-user-can-edit
       87         ,output p-output-display
       88         ,output p-other
       89         ) no-error .
       90       if error-status :error
       91       then do:
       92         undo, return error return-value .
       93       end.
       94     end.
