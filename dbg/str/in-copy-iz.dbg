      649   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   procedure lineattr-value :
      651     do
      652     on error undo, return error return-value
      653     :
      654       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      655       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      656       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      657       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      658       define output parameter p-type     as character no-undo .
      659       define buffer buf_doc-line-attr for ub.doc-line-attr .
      660       def var v-format         as character no-undo .
      661       def var v-fillin_width   as integer   no-undo .
      662       def var v-fillin_height  as integer   no-undo .
      663       def var v-label          as character no-undo .
      664       def var v-user-can-edit  as logical   no-undo .
      665       def var v-output-display as logical   no-undo .
      666       def var v-other          as character no-undo .
      667       run lineattr-code in this-procedure
      668         (input  p-code
      669         ,output p-type
      670         ,output v-format
      671         ,output v-fillin_width
      672         ,output v-fillin_height
      673         ,output v-label
      674         ,output v-user-can-edit
      675         ,output v-output-display
      676         ,output v-other
      677         ) no-error .
      678       if error-status :error then do:
      679         undo, return error return-value .
      680       end.
      681       find first buf_doc-line-attr no-lock
      682         where buf_doc-line-attr.doc-code  = p-doc-code
      683           and buf_doc-line-attr.gds-code  = p-gds-code
      684           and buf_doc-line-attr.attr-code = p-code
      685         no-error .
      686       if avail buf_doc-line-attr then do:
      687         assign
      688           p-value =  buf_doc-line-attr.attr-value
      689         .
      690       end.
      691       else do:
      692         assign
      693           p-value = if p-type = 'L':U then "no":U else ""
      694         .
      695       end.
      696     end.
      697   end procedure.
      698   procedure lineattr-write :
      699     do
      700     on error undo, return error return-value
      701     :
      702       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      703       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      704       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      705       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      706       define buffer buf_doc-line-attr for ub.doc-line-attr .
      707       def var v-type           as character no-undo .
      708       def var v-format         as character no-undo .
      709       def var v-fillin_width   as integer   no-undo .
      710       def var v-fillin_height  as integer   no-undo .
      711       def var v-label          as character no-undo .
      712       def var v-user-can-edit  as logical   no-undo .
      713       def var v-output-display as logical   no-undo .
      714       def var v-other          as character no-undo .
      715       run lineattr-code in this-procedure
      716         (input  p-code
      717         ,output v-type
      718         ,output v-format
      719         ,output v-fillin_width
      720         ,output v-fillin_height
      721         ,output v-label
      722         ,output v-user-can-edit
      723         ,output v-output-display
      724         ,output v-other
      725         ) no-error .
      726       if error-status :error then do:
      727         undo, return error return-value .
      728       end.
      729       find first buf_doc-line-attr exclusive-lock
      730         where buf_doc-line-attr.doc-code  = p-doc-code
      731           and buf_doc-line-attr.gds-code  = p-gds-code
      732           and buf_doc-line-attr.attr-code = p-code
      733         no-error .
      734       if not available buf_doc-line-attr then do:
      735         create buf_doc-line-attr .
      736         assign
      737           buf_doc-line-attr.doc-code  = p-doc-code
      738           buf_doc-line-attr.gds-code = p-gds-code
      739           buf_doc-line-attr.attr-code = p-code
      740         .
      741       end.
      742       assign
      743         buf_doc-line-attr.attr-value = p-value
      744       .
      745        release buf_doc-line-attr.
      746     end.
      747   end procedure.
      748   procedure lineattr-exist :
      749     do
      750     on error undo, return error return-value
      751     :
      752       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      753       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      754       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      755       define output parameter p-exist   as logical  no-undo .
      756       define buffer buf_doc-line-attr for ub.doc-line-attr .
      757       def var v-type           as character no-undo .
      758       def var v-format         as character no-undo .
      759       def var v-fillin_width   as integer   no-undo .
      760       def var v-fillin_height  as integer   no-undo .
      761       def var v-label          as character no-undo .
      762       def var v-user-can-edit  as logical   no-undo .
      763       def var v-output-display as logical   no-undo .
      764       def var v-other          as character no-undo .
      765       run lineattr-code in this-procedure
      766         (input  p-code
      767         ,output v-type
      768         ,output v-format
      769         ,output v-fillin_width
      770         ,output v-fillin_height
      771         ,output v-label
      772         ,output v-user-can-edit
      773         ,output v-output-display
      774         ,output v-other
      775         ) no-error .
      776       if error-status :error then do:
      777         undo, return error return-value .
      778       end.
      779       find first buf_doc-line-attr no-lock
      780         where buf_doc-line-attr.doc-code  = p-doc-code
      781           and buf_doc-line-attr.gds-code = p-gds-code
      782           and buf_doc-line-attr.attr-code = p-code
      783         no-error .
      784       if  available buf_doc-line-attr then do:
      785         p-exist = yes.
      786       end.
      787     end.
      788   end procedure.
      789   procedure lineattr-delete :
      790     do
      791     on error undo, return error return-value
      792     :
      793       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      794       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      795       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      796       define output parameter p-deleted  as logical no-undo.
      797       define buffer buf_doc-line-attr for ub.doc-line-attr .
      798       def var v-type           as character no-undo .
      799       def var v-format         as character no-undo .
      800       def var v-fillin_width   as integer   no-undo .
      801       def var v-fillin_height  as integer   no-undo .
      802       def var v-label          as character no-undo .
      803       def var v-user-can-edit  as logical   no-undo .
      804       def var v-output-display as logical   no-undo .
      805       def var v-other          as character no-undo .
      806       run lineattr-code in this-procedure
      807         (input  p-code
      808         ,output v-type
      809         ,output v-format
      810         ,output v-fillin_width
      811         ,output v-fillin_height
      812         ,output v-label
      813         ,output v-user-can-edit
      814         ,output v-output-display
      815         ,output v-other
      816         ) no-error .
      817       if error-status :error then do:
      818         undo, return error return-value .
      819       end.
      820       find first buf_doc-line-attr exclusive-lock
      821         where buf_doc-line-attr.doc-code  = p-doc-code
      822           and buf_doc-line-attr.gds-code  = p-gds-code
      823           and buf_doc-line-attr.attr-code = p-code
      824         no-error NO-WAIT.
      825       if not available buf_doc-line-attr then do:
      826         p-deleted = no.
      827       end.
      828       else do:
      829         delete buf_doc-line-attr.
      830         p-deleted = yes.
      831       end.
      832     end.
      833   end procedure.
      834   procedure lineattr-code :
      835     do on error undo, return error return-value
      836     :
      837       define input  parameter p-code           as character no-undo .
      838       define output parameter p-type           as character no-undo .
      839       define output parameter p-format         as character no-undo .
      840       define output parameter p-fillin_width   as integer   no-undo .
      841       define output parameter p-fillin_height  as integer   no-undo .
      842       define output parameter p-label          as character no-undo .
      843       define output parameter p-user-can-edit  as logical   no-undo .
      844       define output parameter p-output-display as logical   no-undo .
      845       define output parameter p-other          as character no-undo .
      846       case p-code :
      847               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      848               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      849               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      850               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      851               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      852               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      853               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      854               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      855               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      856               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      857               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      858         otherwise do:
      859           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      860         end.
      861       end.
      862     end.
      863   end procedure.
      864   procedure lineattr-value-flora-gds :
      865     do
      866     on error undo, return error return-value
      867     :
      868       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      869       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      870       define input  parameter p-prt-code    as integer   no-undo .
      871       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      872       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      873       define output parameter p-value       as    decimal   no-undo .
      874       define buffer buf_doc-line-attr for ub.doc-line-attr .
      875       find first buf_doc-line-attr no-lock
      876         where buf_doc-line-attr.doc-code  = p-doc-code
      877           and buf_doc-line-attr.gds-code  = p-gds-code
      878           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      879         no-error .
      880       if avail buf_doc-line-attr then do:
      881         assign
      882           p-value = decimal( buf_doc-line-attr.attr-value)
      883         .
      884       end.
      885       else do:
      886         assign
      887           p-value = 0
      888         .
      889       end.
      890     end.
      891   end procedure.
      892   procedure lineattr-write-flora-gds :
      893     do
      894     on error undo, return error return-value
      895     :
      896       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      897       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      898       define input parameter p-prt-code    as integer   no-undo .
      899       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      900       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      901       define input parameter p-value    as decimal   no-undo .
      902       define buffer buf_doc-line-attr for ub.doc-line-attr .
      903       find first buf_doc-line-attr exclusive-lock
      904         where buf_doc-line-attr.doc-code  = p-doc-code
      905           and buf_doc-line-attr.gds-code  = p-gds-code
      906           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      907         no-error .
      908       if not available buf_doc-line-attr then do:
      909         create buf_doc-line-attr .
      910         assign
      911           buf_doc-line-attr.doc-code  = p-doc-code
      912           buf_doc-line-attr.gds-code  = p-gds-code
      913           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      914         .
      915       end.
      916       assign
      917         buf_doc-line-attr.attr-value = string( p-value )
      918       .
      919     end.
      920   end procedure.
      921   procedure lineattr-delete-flora-gds :
      922     do
      923     on error undo, return error return-value
      924     :
      925       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      926       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      927       define input  parameter p-prt-code    as integer   no-undo .
      928       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      929       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      930       define output parameter p-deleted  as logical no-undo.
      931       define buffer buf_doc-line-attr for ub.doc-line-attr .
      932       find first buf_doc-line-attr exclusive-lock
      933         where buf_doc-line-attr.doc-code  = p-doc-code
      934           and buf_doc-line-attr.gds-code  = p-gds-code
      935           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      936         no-error NO-WAIT.
      937       if not available buf_doc-line-attr then do:
      938         p-deleted = no.
      939       end.
      940       else do:
      941         delete buf_doc-line-attr.
      942         p-deleted = yes.
      943       end.
      944     end.
      945   end procedure.
      946   procedure lineattr-delete-flora-all :
      947     do
      948     on error undo, return error return-value
      949     :
      950       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      951       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      952       define input  parameter p-prt-code    as integer   no-undo .
      953       define buffer buf_doc-line-attr for ub.doc-line-attr .
      954       for each buf_doc-line-attr exclusive-lock
      955         where buf_doc-line-attr.doc-code  = p-doc-code
      956           and buf_doc-line-attr.gds-code  = p-gds-code
      957           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      958        :
      959         delete buf_doc-line-attr.
      960       end.
      961    end.
      962   end procedure.
      963   procedure lineattr-exist-flora-gds :
      964     do
      965     on error undo, return error return-value
      966     :
      967       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      968       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      969       define input  parameter p-prt-code    as integer   no-undo .
      970       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      971       define output parameter p-exist as logical   no-undo .
      972       define buffer buf_doc-line-attr for ub.doc-line-attr .
      973       p-exist = false .
      974       find first buf_doc-line-attr no-lock
      975         where buf_doc-line-attr.doc-code  = p-doc-code
      976           and buf_doc-line-attr.gds-code  = p-gds-code
      977           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      978         no-error .
      979       if avail buf_doc-line-attr then do:
      980         assign
      981          p-exist = true
      982         .
      983       end.
      984     end.
      985   end procedure.
      986   procedure lineattr-write-add-line-cli :
      987   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      988   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      989   define input  parameter p-cli-type      as character no-undo .
      990   define input  parameter p-cli-code      as integer   no-undo .
      991   define input  parameter p-contract-code as integer   no-undo .
      992   define input  parameter p-host-code     as integer   no-undo .
      993   define input  parameter p-exch-code     as integer   no-undo .
      994   define input  parameter p-exch-rate     as decimal   no-undo .
      995   define input  parameter p-exch-scale    as integer   no-undo .
      996   define input  parameter p-sum-cli       as decimal   no-undo .
      997   define input  parameter p-sum-vat       as decimal   no-undo .
      998   define buffer buf_doc-line-attr for ub.doc-line-attr .
      999     do
     1000     on error undo, return error return-value
     1001     :
     1002       find first buf_doc-line-attr exclusive-lock
     1003         where buf_doc-line-attr.doc-code  = p-doc-code
     1004           and buf_doc-line-attr.gds-code  = p-gds-code
     1005           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1006                                             chr(4) + p-cli-type +
     1007                                             chr(4) + string(p-cli-code) +
     1008                                             chr(4) + string(p-contract-code) +
     1009                                             chr(4) + string(p-host-code)
     1010         no-error .
     1011       if not available buf_doc-line-attr then do:
     1012         create buf_doc-line-attr .
     1013         assign
     1014           buf_doc-line-attr.doc-code  = p-doc-code
     1015           buf_doc-line-attr.gds-code  = p-gds-code
     1016           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     1017                                         chr(4) + p-cli-type +
     1018                                         chr(4) + string(p-cli-code) +
     1019                                         chr(4) + string(p-contract-code) +
     1020                                         chr(4) + string(p-host-code)
     1021         .
     1022       end.
     1023       assign
     1024         buf_doc-line-attr.attr-value =
     1025         string(p-exch-code)  + chr(4) +
     1026         string(p-exch-rate)  + chr(4) +
     1027         string(p-exch-scale) + chr(4) +
     1028         string(p-sum-cli)    + chr(4) +
     1029         string(p-sum-vat)
     1030         .
     1031     end.
     1032   end procedure.
     1033   procedure lineattr-value-add-line-cli :
     1034   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1035   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1036   define input   parameter p-cli-type      as character no-undo .
     1037   define input   parameter p-cli-code      as integer   no-undo .
     1038   define input   parameter p-contract-code as integer   no-undo .
     1039   define input   parameter p-host-code     as integer   no-undo .
     1040   define output  parameter p-exch-code     as integer   no-undo .
     1041   define output  parameter p-exch-rate     as decimal   no-undo .
     1042   define output  parameter p-exch-scale    as integer   no-undo .
     1043   define output  parameter p-sum-cli       as decimal   no-undo .
     1044   define output  parameter p-sum-vat       as decimal   no-undo .
     1045   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1046     do
     1047     on error undo, return error return-value
     1048     :
     1049       find first buf_doc-line-attr exclusive-lock
     1050         where buf_doc-line-attr.doc-code  = p-doc-code
     1051           and buf_doc-line-attr.gds-code  = p-gds-code
     1052           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1053                                             chr(4) + p-cli-type +
     1054                                             chr(4) + string(p-cli-code) +
     1055                                             chr(4) + string(p-contract-code) +
     1056                                             chr(4) + string(p-host-code)
     1057         no-error .
     1058       if available buf_doc-line-attr then do:
     1059        assign
     1060           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1061           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1062           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1063           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1064           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1065          .
     1066        end.
     1067     end.
     1068   end procedure.
     1069   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1070     define variable v-code as character no-undo .
     1071     define variable v-type as character no-undo .
     1072     define variable v-gds-code as integer   no-undo .
     1073   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1075     (input  local-doc-line.artic
     1076     ,input  local-doc-line.prod-type
     1077     ,input  local-doc-line.prod-code
     1078     ,output v-gds-code
     1079     )  .
     1080     run lineattr-value (
     1081         input   local-doc-line.doc-code ,
     1082         input   v-gds-code              ,
     1083         input   'reason-code':U ,
     1084         output  v-code                  ,
     1085         output  v-type ) .
     1086     find first ub.trn-reason no-lock where
     1087                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1088     if not available ub.trn-reason then do:
     1089        return "" .
     1090     end.
     1091     else do:
     1092        return ub.trn-reason.reason-name .
     1093     end.
     1094   end function.
     1095   procedure lineattr-value-parts :
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1100       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1101       define input  parameter p-part-code   as character no-undo .
     1102       define input  parameter p_in-code     as character no-undo .
     1103       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1104       define output parameter p-value       as    decimal   no-undo .
     1105       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1106       find first buf_doc-line-attr no-lock
     1107         where buf_doc-line-attr.doc-code  = p-doc-code
     1108           and buf_doc-line-attr.gds-code  = p-gds-code
     1109           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1110         no-error .
     1111       if avail buf_doc-line-attr then do:
     1112         assign
     1113           p-value = decimal( buf_doc-line-attr.attr-value)
     1114         .
     1115       end.
     1116       else do:
     1117         assign
     1118           p-value = 0
     1119         .
     1120       end.
     1121     end.
     1122   end procedure.
     1123   procedure lineattr-write-parts :
     1124     do
     1125     on error undo, return error return-value
     1126     :
     1127       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1128       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1129       define input parameter p-part-code  as character no-undo .
     1130       define input parameter p_in-code    as character no-undo .
     1131       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     1132       define input parameter p-value      as decimal   no-undo .
     1133       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1134       find first buf_doc-line-attr exclusive-lock
     1135         where buf_doc-line-attr.doc-code  = p-doc-code
     1136           and buf_doc-line-attr.gds-code  = p-gds-code
     1137           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1138         no-error .
     1139       if not available buf_doc-line-attr then do:
     1140         create buf_doc-line-attr .
     1141         assign
     1142           buf_doc-line-attr.doc-code  = p-doc-code
     1143           buf_doc-line-attr.gds-code  = p-gds-code
     1144           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1145         .
     1146       end.
     1147       assign
     1148         buf_doc-line-attr.attr-value = string( p-value )
     1149       .
     1150     end.
     1151   end procedure.
     1152   define input        parameter parparentproc       as   handle                no-undo .
     1153   define input        parameter p-mode              as   character             no-undo .
     1154   define input        parameter p-gds-code          like ub.goods.gds-code     no-undo .
     1155   define output       parameter p-place-si          as   integer               no-undo .
     1156   define output       parameter p-num-plotn         as   character             no-undo .
     1157   define output       parameter p-passport-plotn    as   character             no-undo .
     1158   define output       parameter p-date-pov-plotn    like ub.rvs-line.real-date no-undo .
     1159     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1160       define variable v-answ as logical no-undo .
     1161       if ( p-unit-base-cli-eq = true
     1162            and p-density = 1.0
     1163          )
     1164         or ( p-unit-base-cli-eq = false
     1165              and p-density <> ?
     1166              and p-density > 0.0
     1167              and p-density < 1.0
     1168            )
     1169       then do:
     1170         assign
     1171           v-answ = true
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           v-answ = false
     1177         .
     1178       end.
     1179       return v-answ.
     1180     end function.
     1181   define VARIABLE v-artic        like ub.goods.artic no-undo .
     1182   define VARIABLE v-prod-code    like ub.goods.prod-code no-undo .
     1183   define VARIABLE v-prod-type    like ub.goods.prod-type no-undo .
     1184   define buffer buf_goods for ub.goods .
     1185   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1186   define buffer buf_doc-line for ub.doc-line .
     1187   define buffer buf_trn-doc for ub.trn-doc .
     1188   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     1189   define temp-table tt-doc-iz no-undo like ub.trn-doc
     1190     field code-doc                as character
     1191     field gds-code                like ub.goods.gds-code
     1192     field date-doc                like ub.trn-doc.doc-date
     1193     field num-iz                  as integer
     1194     field iz-name                 as character
     1195     field num-iz-pov              as character
     1196     field date-pov                as date
     1197     field passport-pov            as character
     1198   index pi is unique primary code-doc
     1199   .
     1200   DEFINE BUTTON b_help
     1201        LABEL "&Помощь"
     1202        SIZE 15 BY 1.15
     1203        BGCOLOR 8 .
     1204   DEFINE BUTTON b_quit AUTO-END-KEY
     1205        LABEL "&Отмена"
     1206        SIZE 15 BY 1.15
     1207        BGCOLOR 8 .
     1208   DEFINE BUTTON b_save AUTO-GO
     1209        LABEL "&Выбор"
     1210        SIZE 15 BY 1.15
     1211        BGCOLOR 8 .
     1212   DEFINE QUERY br-copy-iz FOR
     1213         tt-doc-iz SCROLLING.
     1214   DEFINE BROWSE br-copy-iz
     1215     QUERY br-copy-iz DISPLAY
     1216         tt-doc-iz.code-doc      format "X(10)":U column-label 'Номер'
     1217   tt-doc-iz.date-doc      format "99/99/99":U column-label 'Дата'
     1218   tt-doc-iz.num-iz        format ">>>>>>":U column-label 'Ср.изм.'
     1219   tt-doc-iz.iz-name       format "x(16)":U column-label 'Название ср.изм.'
     1220   tt-doc-iz.num-iz-pov    format "X(16)":U column-label 'Номер ср.изм.'
     1221   tt-doc-iz.date-pov      format "99/99/99":U column-label 'Дата поверки'
     1222   tt-doc-iz.passport-pov  format "X(16)":U column-label 'Паспорт'
     1223       WITH NO-ROW-MARKERS SEPARATORS SIZE 94 BY 9.33 FIT-LAST-COLUMN.
     1224   DEFINE FRAME Dialog-Frame
     1225        b_save AT ROW 1.11 COL 1.25
     1226        b_quit AT ROW 1.11 COL 16.5
     1227        b_help AT ROW 1.11 COL 79.88
     1228        br-copy-iz AT ROW 2.37 COL 1 WIDGET-ID 200
     1229        SPACE(0.37) SKIP(0.59)
     1230       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1231            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1232            TITLE "Накладные с заполненной доп.инфо"
     1233            DEFAULT-BUTTON b_save CANCEL-BUTTON b_quit WIDGET-ID 100.
     1234   ASSIGN
     1235          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1236          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1237   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1238   DO:
     1239     APPLY "END-ERROR":U TO SELF.
     1240   END.
     1241   ON CHOOSE OF b_help IN FRAME Dialog-Frame
     1242   OR HELP OF FRAME Dialog-Frame
     1243   DO:
     1244     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\str\in-copy-iz.w" VIEW-AS ALERT-BOX INFORMATION.
     1245   END.
     1246   ON CHOOSE OF b_save IN FRAME Dialog-Frame
     1247   DO:
     1248     if AVAILABLE tt-doc-iz then do:
     1249       assign
     1250       p-place-si = tt-doc-iz.num-iz
     1251       p-num-plotn = tt-doc-iz.num-iz-pov
     1252       p-passport-plotn = tt-doc-iz.passport-pov
     1253       p-date-pov-plotn = tt-doc-iz.date-pov.
     1254     end.
     1255     else
     1256     MESSAGE "Нет данных для выбора"
     1257     VIEW-AS ALERT-BOX.
     1258   END.
     1259   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1260   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1261   MAIN-BLOCK:
     1262   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1263      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1264     Run fill-tables no-error.
     1265     RUN enable_UI.
     1266     WAIT-FOR GO OF FRAME Dialog-Frame.
     1267   END.
     1268   RUN disable_UI.
     1269   PROCEDURE disable_UI :
     1270     HIDE FRAME Dialog-Frame.
     1271   END PROCEDURE.
     1272   PROCEDURE enable_UI :
     1273     ENABLE b_save b_quit b_help br-copy-iz
     1274         WITH FRAME Dialog-Frame.
     1275     VIEW FRAME Dialog-Frame.
     1276     OPEN QUERY br-copy-iz FOR EACH tt-doc-iz.
     1277   END PROCEDURE.
     1278   PROCEDURE fill-tables :
     1279   define VARIABLE i as DECIMAL no-undo.
     1280   define VARIABLE v-value as character no-undo .
     1281   define VARIABLE v-type as character no-undo .
     1282   define VARIABLE v-format         as character no-undo .
     1283   define VARIABLE v-fillin_width   as integer   no-undo .
     1284   define VARIABLE v-fillin_height  as integer   no-undo .
     1285   define VARIABLE v-label          as character no-undo .
     1286   define VARIABLE v-user-can-edit  as logical   no-undo .
     1287   define VARIABLE v-output-display as logical   no-undo .
     1288   define VARIABLE v-other          as character no-undo .
     1289   find first buf_goods where buf_goods.gds-code = p-gds-code.
     1290         assign
     1291         v-artic = buf_goods.artic
     1292         v-prod-type = buf_goods.prod-type
     1293         v-prod-code = buf_goods.prod-code.
     1294     for each buf_doc-line where buf_doc-line.artic = v-artic
     1295       and buf_doc-line.prod-type = v-prod-type
     1296       and buf_doc-line.prod-code = v-prod-code
     1297       and buf_doc-line.ext-doc-type = 'ie':U
     1298       by buf_doc-line.fact-order desc:
     1299       if i < 10 then
     1300       do:
     1301         find first buf_doc-line-attr where buf_doc-line-attr.attr-code = "place-si"
     1302           and buf_doc-line-attr.gds-code = p-gds-code
     1303           and buf_doc-line-attr.doc-code = buf_doc-line.doc-code no-error.
     1304         if AVAILABLE buf_doc-line-attr then
     1305         do:
     1306           p-place-si = integer(buf_doc-line-attr.attr-value).
     1307           if p-place-si <> 0 then
     1308           do:
     1309             i=i + 1.
     1310             find first buf_trn-doc where buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     1311             find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = p-place-si no-error.
     1312             find first buf_doc-line-attr where buf_doc-line-attr.attr-code = "num-plotn"
     1313               and buf_doc-line-attr.gds-code = p-gds-code
     1314               and buf_doc-line-attr.doc-code = buf_doc-line.doc-code no-error.
     1315             p-num-plotn = buf_doc-line-attr.attr-value no-error.
     1316             find first buf_doc-line-attr where buf_doc-line-attr.attr-code = "date-pov-plotn"
     1317               and buf_doc-line-attr.gds-code = p-gds-code
     1318               and buf_doc-line-attr.doc-code = buf_doc-line.doc-code no-error.
     1319             p-date-pov-plotn = date(buf_doc-line-attr.attr-value) no-error.
     1320             if buf_sr-izmerenia.sr-type-id = 3 or buf_sr-izmerenia.sr-type-id = 4 then
     1321             do:
     1322               find first buf_doc-line-attr where buf_doc-line-attr.attr-code = "passport-plotn"
     1323                 and buf_doc-line-attr.gds-code = p-gds-code
     1324                 and buf_doc-line-attr.doc-code = buf_doc-line.doc-code no-error.
     1325               p-passport-plotn = buf_doc-line-attr.attr-value no-error.
     1326             end.
     1327             else p-passport-plotn = "".
     1328             create tt-doc-iz.
     1329             assign
     1330               tt-doc-iz.code-doc     = buf_doc-line.doc-code
     1331               tt-doc-iz.gds-code     = p-gds-code
     1332               tt-doc-iz.date-doc     = buf_trn-doc.doc-date
     1333               tt-doc-iz.num-iz       = p-place-si
     1334               tt-doc-iz.iz-name      = buf_sr-izmerenia.sr-model
     1335               tt-doc-iz.num-iz-pov   = p-num-plotn
     1336               tt-doc-iz.date-pov     = p-date-pov-plotn
     1337               tt-doc-iz.passport-pov = p-passport-plotn.
     1338           end.
     1339         end.
     1340       end.
     1341     end.
     1342   END PROCEDURE.
