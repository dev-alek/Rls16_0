     1101            input-output shift-date      ,
     1102            input-output shift-num       ,
     1103            input-output shift-name      ,
     1104            input        yes
     1105            ) no-error .
     1106         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1107         v-fact-date = p-doc-date .
     1108         run factord in this-procedure
     1109           (input  v-fact-date
     1110           ,input  v-fact-time
     1111           ,input  v-fact-time
     1112           ,input  shift-date
     1113           ,input  shift-num
     1114           ,input  l-shift-on
     1115           ,output v-fact-order
     1116           ,output v-shift-end-fact-order
     1117           ,output v-day-end-fact-order
