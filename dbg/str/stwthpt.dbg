      369   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   procedure cur-time :
      373      define output parameter p-today as date      no-undo .
      374      define output parameter p-time  as integer   no-undo .
      375     do
      376     on error undo, return error
      377     :
      378       define variable v-date1 as date      no-undo .
      379       define variable v-date2 as date      no-undo .
      380       define variable v-time  as integer   no-undo .
      381       assign
      382         v-date1 = today
      383         v-time  = time
      384         v-date2 = today
      385       .
      386       if v-date1 <> v-date2
      387       then do:
      388         assign
      389           v-date1 = today
      390           v-time  = v-time
      391         .
      392       end.
      393       assign
      394         p-today = v-date1
      395         p-time  = v-time
      396       .
      397     end.
      398   end.
      399   function cur-time-date returns character
      400   :
      401     return string(today, '99/99/9999':U) .
      402   end.
      403   function cur-time-mjd returns decimal
      404   :
      405     define variable v-date as date      no-undo .
      406     define variable v-time as integer   no-undo .
      407     run cur-time in this-procedure
      408       (output v-date
      409       ,output v-time
      410       ) .
      411     return integer(v-date) - 2400002 + (v-time / 86400) .
      412   end.
      413   function cur-time-get-ending-index returns integer
      414   (input p-number as integer
      415   )
      416   :
      417     if p-number < 0
      418     or p-number = ?
      419     then do:
      420       return 1 .
      421     end.
      422     define variable v-rest as integer   no-undo .
      423     assign
      424       p-number = p-number modulo 100
      425     .
      426     if p-number < 20
      427     then do:
      428       assign
      429         v-rest = p-number
      430       .
      431     end.
      432     else do:
      433       assign
      434         v-rest = p-number modulo 10
      435       .
      436     end.
      437     case v-rest :
      438       when 1
      439       then do:
      440         return 2 .
      441       end.
      442       when 2 or
      443       when 3 or
      444       when 4
      445       then do:
      446         return 3 .
      447       end.
      448       otherwise do:
      449         return 1 .
      450       end.
      451     end case .
      452   end.
      453   procedure cur-time-mjd-to-date :
      454      define input  parameter i-mjd-diff as decimal no-undo.
      455      define output parameter o-Date     as date    no-undo.
      456      define output parameter o-Time     as integer no-undo.
      457      define variable v-day-number as integer   no-undo .
      458      if    i-mjd-diff < 0
      459         or i-mjd-diff = ?
      460      then do:
      461         return "?" .
      462      end.
      463      assign
      464         v-day-number = truncate(i-mjd-diff,0).
      465         o-Date = date(v-day-number + 2400002).
      466         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      467     .
      468   end.
      469   function cur-time-mjd-to-string returns character
      470   (input p-mjd-diff as decimal
      471   )
      472   :
      473     define variable v-day-number as integer   no-undo .
      474     define variable v-seconds    as integer   no-undo .
      475     define variable v-hour       as integer   no-undo .
      476     define variable v-min        as integer   no-undo .
      477     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      478     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      479     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      480     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      481     if p-mjd-diff < 0
      482     or p-mjd-diff = ?
      483     then do:
      484       return "?" .
      485     end.
      486     assign
      487       v-day-number = integer(truncate(p-mjd-diff,0))
      488       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      489     .
      490     if v-seconds > 86400
      491     then do:
      492       assign
      493         v-seconds = 86400 - 1
      494       .
      495     end.
      496     if v-seconds < 0
      497     then do:
      498       assign
      499         v-seconds = 0
      500       .
      501     end.
      502     assign
      503       v-hour = truncate(v-seconds / 3600, 0)
      504     .
      505     assign
      506       v-seconds = v-seconds modulo 3600
      507     .
      508     assign
      509       v-min = truncate(v-seconds / 60, 0)
      510     .
      511     assign
      512       v-seconds = v-seconds modulo 60
      513     .
      514     return
      515         (if v-day-number <> 0
      516           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      517           else ""
      518         )
      519       + (if v-day-number <> 0 or v-hour <> 0
      520           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      521           else ""
      522         )
      523       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      524           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      525           else ""
      526         )
      527       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      528       .
      529   end.
      530   function cur-time-string returns character
      531   :
      532     define variable v-date as date      no-undo .
      533     define variable v-time as integer   no-undo .
      534     run cur-time in this-procedure
      535       (output v-date
      536       ,output v-time
      537       ) .
      538     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      539   end.
      540   function cur-time-string-sec returns character
      541   :
      542     define variable v-date as date      no-undo .
      543     define variable v-time as integer   no-undo .
      544     run cur-time in this-procedure
      545       (output v-date
      546       ,output v-time
      547       ) .
      548     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      549   end.
      550   function cur-time-custom  returns character
      551   (input p-prefix as character
      552   ,input p-date-format as character
      553   ,input p-delimiter as character
      554   ,input p-time-format as character
      555   ,input p-suffix as character
      556   )
      557   :
      558     define variable v-date as date      no-undo .
      559     define variable v-time as integer   no-undo .
      560     run cur-time in this-procedure
      561       (output v-date
      562       ,output v-time
      563       ) .
      564     return
      565       p-prefix
      566       + string(v-date, p-date-format)
      567       + p-delimiter
      568       + string(v-time, p-time-format)
      569       + p-suffix
      570       .
      571   end.
      572   function cur-time-print  returns character
      573   :
      574     define variable v-date as date      no-undo .
      575     define variable v-time as integer   no-undo .
      576     run cur-time in this-procedure
      577       (output v-date
      578       ,output v-time
      579       ) .
      580     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      581   end.
      582   function cur-time-datetime returns datetime
      583   :
      584     define variable v-char as character no-undo .
      585     define variable v-datetime as datetime no-undo .
      586     v-char = cur-time-string().
      587     v-datetime = datetime(v-char).
      588     return  v-datetime.
      589   end.
      590   function cur-time-string-msec returns character
      591   :
      592     define variable v-date as datetime  no-undo .
      593     v-date = now.
      594     return string(v-date) .
      595   end.
      596   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   procedure factord :
      598     define input  parameter p-fact-date            as date    no-undo .
      599     define input  parameter p-fact-time            as integer no-undo .
      600     define input  parameter p-fact-num             as integer no-undo .
      601     define input  parameter p-shift-date           as date    no-undo .
      602     define input  parameter p-shift-num            as integer no-undo .
      603     define input  parameter p-shift-on             as logical no-undo .
      604     define output parameter p-fact-order           as decimal no-undo .
      605     define output parameter p-shift-end-fact-order as decimal no-undo .
      606     define output parameter p-day-end-fact-order   as decimal no-undo .
      607     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      608     if p-fact-date = ?
      609     then do:
      610       return error "Не указана фактическая дата" .
      611     end.
      612     define variable v-fact-date-num as integer no-undo .
      613     assign
      614       v-fact-date-num = integer(p-fact-date)
      615     .
      616     if p-fact-num = ?
      617     or p-fact-num = 0
      618     then do:
      619       return error "Не задан p-fact-num " + string(p-fact-num) .
      620     end.
      621     if p-fact-num < 0
      622     then do:
      623       return error "Отрицательный fact-num " + string(p-fact-num) .
      624     end.
      625     if p-fact-num >= 100000000
      626     then do:
      627       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      628     end.
      629     if p-shift-on = true
      630     then do:
      631       if p-shift-date = ?
      632       then do:
      633         return error "Не задана дата смены" .
      634       end.
      635       if p-shift-num = ?
      636       or p-shift-num = 0
      637       then do:
      638         return error "Не задан номер смены" .
      639       end.
      640     end.
      641     else do:
      642       assign
      643         p-shift-date = p-fact-date
      644         p-shift-num  = 24
      645       .
      646     end.
      647     define variable v-shift-offset as integer no-undo .
      648     if p-shift-date = p-fact-date
      649     then do:
      650       assign
      651         v-shift-offset = 1
      652       .
      653     end.
      654     if p-shift-date < p-fact-date
      655     then do:
      656       assign
      657         v-shift-offset = 0
      658       .
      659     end.
      660     if p-shift-date > p-fact-date
      661     then do:
      662       message
      663         vss-workfile vss-revision vss-description skip
      664         "Неправильная дата закрытия смены" skip
      665         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      666         view-as alert-box error .
      667       undo, return error
      668         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      669           ,string(p-fact-date, '99/99/9999':U)
      670           ,string(p-shift-date, '99/99/9999':U)
      671           )
      672       .
      673     end.
      674     if p-shift-num < 1
      675     or p-shift-num > 24
      676     then do:
      677       message
      678         vss-workfile vss-revision vss-description skip
      679         "Неправильный номер смены" skip
      680         "p-shift-num" p-shift-num skip
      681         view-as alert-box error .
      682       undo, return error return-value .
      683     end.
      684     assign
      685       p-fact-order           = v-fact-date-num
      686                              + v-shift-offset * 0.5
      687                              + p-shift-num    * 0.02 - 0.01
      688                              + p-fact-num     * 0.0000000001
      689       p-shift-end-fact-order = v-fact-date-num
      690                              + v-shift-offset * 0.5
      691                              + p-shift-num    * 0.02
      692       p-day-end-fact-order   = v-fact-date-num
      693                              + 0.99
      694     .
      695     if p-fact-order           <= v-fact-date-num
      696     or p-shift-end-fact-order <= v-fact-date-num
      697     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      698     or p-shift-end-fact-order >= p-day-end-fact-order
      699     then do:
      700       message
      701         vss-workfile vss-revision vss-description skip
      702         "Внутренняя ошибка при генерации фактического номера" skip
      703         "p-fact-date"            p-fact-date            skip
      704         "p-fact-time"            p-fact-time            skip
      705         "p-fact-num"             p-fact-num             skip
      706         "p-shift-date"           p-shift-date           skip
      707         "p-shift-num"            p-shift-num            skip
      708         "p-shift-on"             p-shift-on             skip
      709         "p-shift-end-fact-order" p-shift-end-fact-order skip
      710         "p-day-end-fact-order"   p-day-end-fact-order   skip
      711         "v-fact-date-num"        v-fact-date-num        skip
      712         view-as alert-box error .
      713       undo, return error return-value .
      714     end.
      715   end procedure.
      716   procedure day-begin-fact-order :
      717     define input  parameter p-fact-date            as date    no-undo .
      718     define output parameter p-day-begin-fact-order as decimal no-undo .
      719     do
      720     on error undo, return error return-value
      721     :
      722       if p-fact-date = ?
      723       then do:
      724         assign
      725           p-day-begin-fact-order = 0
      726         .
      727       end.
      728       else do:
      729         assign
      730           p-day-begin-fact-order = integer(p-fact-date)
      731         .
      732       end.
      733     end.
      734   end procedure.
      735   procedure factord-max-fact-order :
      736     define output parameter p-max-fact-order as decimal   no-undo .
      737     do
      738     on error undo, return error return-value
      739     :
      740       run day-begin-fact-order in this-procedure
      741         (input  date(1, 1, 5000)
      742         ,output p-max-fact-order
      743         ) .
      744     end.
      745   end procedure.
      746   procedure factord-cut-archive :
      747     define input  parameter p-obj-type             as character no-undo .
      748     define input  parameter p-obj-code             as integer   no-undo .
      749     define input  parameter p-fact-date            as date      no-undo .
      750     define output parameter p-shift-on             as logical   no-undo .
      751     define output parameter p-shift-date           as date      no-undo .
      752     define output parameter p-shift-num            as integer   no-undo .
      753     define output parameter p-day-end-fact-order   as decimal   no-undo .
      754     define output parameter p-shift-end-fact-order as decimal   no-undo .
      755     define variable v-fact-order as decimal   no-undo .
      756     define buffer buf_shift-obj for ub.shift-obj .
      757     do
      758     on error undo, return error return-value
      759     :
      760   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      762     (input  p-obj-type
      763     ,input  p-obj-code
      764     ,input  'shift-on=request'
      765     ,output p-shift-on
      766     ) no-error .
      767       if error-status :error
      768       then do:
      769         message
      770           vss-workfile vss-revision vss-description skip
      771           "Ошибка при определении атрибута объекта" skip
      772           "Объект" p-obj-type p-obj-code skip
      773           error-status :get-message(1) skip
      774           return-value skip
      775           view-as alert-box error .
      776         undo, return error return-value .
      777       end.
      778       if p-shift-on = false
      779       then do:
      780         assign
      781           p-shift-date               = ?
      782           p-shift-num                = 0
      783         .
      784       end.
      785       else do:
      786         find first buf_shift-obj share-lock
      787           where buf_shift-obj.obj-type   = p-obj-type
      788             and buf_shift-obj.obj-code   = p-obj-code
      789             and buf_shift-obj.shift-date > p-fact-date
      790           use-index pi
      791           no-error .
      792         if not available buf_shift-obj
      793         or buf_shift-obj.status_ <> 'зкр':U
      794         then do:
      795           message
      796             vss-workfile vss-revision vss-description skip
      797             "Невозможно вычислить последнюю смену" skip
      798             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      799             "Объект" p-obj-type p-obj-code skip
      800             "Дата" p-fact-date skip
      801             view-as alert-box error .
      802           undo, return error return-value .
      803         end.
      804         find last buf_shift-obj share-lock
      805           where buf_shift-obj.obj-type = p-obj-type
      806             and buf_shift-obj.obj-code = p-obj-code
      807             and buf_shift-obj.shift-date <= p-fact-date
      808           use-index pi
      809           no-error .
      810         if available buf_shift-obj
      811         then do:
      812           if  buf_shift-obj.status_ = 'зкр':U
      813           then do:
      814             assign
      815               p-shift-date = buf_shift-obj.shift-date
      816               p-shift-num  = buf_shift-obj.shift-num
      817             .
      818           end.
      819           else do:
      820             message
      821               vss-workfile vss-revision vss-description skip
      822               "Невозможно вычислить последнюю смену" skip
      823               "Статус смены отличен от статуса" 'зкр':U skip
      824               "Объект" p-obj-type p-obj-code skip
      825               "Дата" p-fact-date skip
      826               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      827               view-as alert-box error .
      828             undo, return error return-value .
      829           end.
      830         end.
      831         else do:
      832           assign
      833             p-shift-date = p-fact-date - 1
      834             p-shift-num  = 1
      835           .
      836         end.
      837       end.
      838       run factord in this-procedure
      839         (input  p-fact-date
      840         ,input  1
      841         ,input  1
      842         ,input  p-shift-date
      843         ,input  p-shift-num
      844         ,input  p-shift-on
      845         ,output v-fact-order
      846         ,output p-shift-end-fact-order
      847         ,output p-day-end-fact-order
      848         ) no-error .
      849       if error-status :error
      850       then do:
      851         message
      852           vss-workfile vss-revision vss-description skip
      853           "Ошибка при вызове процедуры factord"
      854           error-status :get-message(1) skip
      855           return-value skip
      856           view-as alert-box error .
      857         undo, return error return-value .
      858       end.
      859     end.
      860   end procedure.
      861   procedure factord-lock-shift :
      862     define input  parameter p-obj-type  as character no-undo .
      863     define input  parameter p-obj-code  as integer   no-undo .
      864     define input  parameter p-fact-date as date      no-undo .
      865     define parameter buffer buf_shift-obj for ub.shift-obj .
      866     define variable v-shift-on      as logical   no-undo .
      867     define variable v-extra-message as character no-undo .
      868     define variable v-error as character no-undo .
      869     do
      870     on error undo, return error return-value
      871     :
      872   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      874     (input  p-obj-type
      875     ,input  p-obj-code
      876     ,input  'shift-on=request'
      877     ,output v-shift-on
      878     ) no-error .
      879       if error-status :error
      880       then do:
      881         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      882         undo, return error v-error .
      883       end.
      884       if v-shift-on = true
      885       then do:
      886         find first buf_shift-obj share-lock
      887           where buf_shift-obj.obj-type   = p-obj-type
      888             and buf_shift-obj.obj-code   = p-obj-code
      889             and buf_shift-obj.shift-date > p-fact-date
      890           use-index pi
      891           no-error .
      892         if not available buf_shift-obj
      893         or buf_shift-obj.status_ <> 'зкр':U
      894         then do:
      895           find last buf_shift-obj
      896             where buf_shift-obj.obj-type = p-obj-type
      897               and buf_shift-obj.obj-code = p-obj-code
      898               and buf_shift-obj.status_  = 'зкр':U
      899             use-index stts
      900             no-error .
      901           if available buf_shift-obj
      902           then do:
      903             assign
      904               v-extra-message =
      905                     substitute("Дата начала последеней закрытой смены на объекте &1"
      906                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      907                               )
      908             .
      909           end.
      910           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      911           undo, return error v-error .
      912         end.
      913       end.
      914     end.
      915   end procedure.
      916   procedure factord-end-day :
      917     define input  parameter p-fact-date            as date    no-undo .
      918     define output parameter p-day-end-fact-order   as decimal no-undo .
      919     do
      920     on error undo, return error return-value
      921     :
      922       if p-fact-date = ?
      923       then do:
      924         return error "Не указана фактическая дата" .
      925       end.
      926       assign
      927         p-day-end-fact-order = integer(p-fact-date) + 0.99
      928       .
      929     end.
      930   end procedure.
      931   procedure factord-to-date :
      932     define input  parameter p-fact-order as decimal no-undo .
      933     define output parameter p-fact-date  as date    no-undo .
      934     define variable v-ref-date  as date      no-undo .
      935     define variable v-ref-delta as integer   no-undo .
      936     do
      937     on error undo, return error return-value
      938     :
      939       if p-fact-order = ?
      940       or p-fact-order = 0
      941       then do:
      942         return error "Не указан fact-order" .
      943       end.
      944       assign
      945         v-ref-date  = date(1, 1, 2000)
      946       .
      947       assign
      948         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      949       .
      950       assign
      951         p-fact-date = v-ref-date + v-ref-delta
      952       .
      953     end.
      954   end procedure.
      955   procedure factord-to-fact-num :
      956     define input  parameter p-fact-order as decimal no-undo .
      957     define output parameter p-fact-num   as integer no-undo .
      958     define variable v-fact-order-trunc as decimal no-undo .
      959     do
      960     on error undo, return error return-value
      961     :
      962       if p-fact-order = ?
      963       or p-fact-order = 0
      964       then do:
      965         return error "Не указан fact-order" .
      966       end.
      967       assign
      968        v-fact-order-trunc = truncate(p-fact-order, 2)
      969       .
      970       assign
      971         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      972       .
      973     end.
      974   end procedure.
      975   procedure factord-to-shift-num :
      976     define input  parameter p-fact-order as decimal no-undo .
      977     define output parameter p-shift-num   as integer no-undo .
      978     define variable  p-shift-numd  as decimal   no-undo .
      979     define variable v-fact-order-trunc as decimal no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983       if p-fact-order = ?
      984       or p-fact-order = 0
      985       then do:
      986         return error "Не указан fact-order" .
      987       end.
      988       assign
      989        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      990       .
      991       if v-fact-order-trunc < 0.5 then do:
      992         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      993       end.
      994       assign
      995         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      996         .
      997        assign
      998         p-shift-num = truncate (p-shift-numd , 0)
      999       .
     1000     end.
     1001   end procedure.
     1002   procedure fact-order-mpl :
     1003     do
     1004     on error undo, return error return-value
     1005     :
     1006   define input  parameter p-doc-date as date     no-undo .
     1007   define input  parameter p-obj-type as character no-undo .
     1008   define input  parameter p-obj-code as integer   no-undo .
     1009   define output parameter p-fact-order as decimal   no-undo .
     1010   define variable v-fact-date            as date    no-undo .
     1011   define variable v-fact-time            as integer no-undo .
     1012   define variable v-fact-order           as decimal no-undo .
     1013   define variable v-shift-end-fact-order as decimal no-undo .
     1014   define variable v-day-end-fact-order   as decimal no-undo .
