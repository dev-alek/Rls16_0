     1027        view-as alert-box error
     1028      .
     1029      return error return-value .
     1030   end.
     1031     run cur-time in this-procedure
     1032     ( output v-fact-date ,
     1033       output v-fact-time  ).
     1034   if p-doc-date = ? then do:
     1035   if buf_global-state.pl-use-sys-date-time  = true then do:
     1036         run factord in this-procedure
     1037           (input  v-fact-date
     1038           ,input  v-fact-time
     1039           ,input  v-fact-time
     1040           ,input  ?
     1041           ,input  ?
     1042           ,input  false
     1043           ,output v-fact-order
     1044           ,output v-shift-end-fact-order
     1045           ,output v-day-end-fact-order
     1046           ) no-error .
     1047         if error-status :error
