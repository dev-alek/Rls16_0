     1287     (input  v-host-code
     1288     ,input  to-day
     1289     ,output v-base-rate0
     1290     ,output v-base-scale0
     1291     )  .
     1292     v-cli-oborot-ALL  = 0 .
     1293     for each buf_turnover-buyer-main no-lock  where
     1294              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1295              buf_turnover-buyer-main.cli-code = p-cli-code
     1296              :
     1297              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1298     end.
     1299   for each buf_price-all no-lock where
     1300            buf_price-all.obj-type = p-obj-type and
     1301            buf_price-all.obj-code = p-obj-code and
     1302            buf_price-all.gds-code = buf_goods.gds-code and
     1303            buf_price-all.status_  = 'акт':U  and
     1304          ( p-only-b-code = false   or
     1305          ( buf_price-all.b-code = p-main-b-code or
     1306            buf_price-all.b-code = p-b-code))    and
     1307           ( p-only-b-code = true  or
     1308             buf_price-all.b-code = p-b-code)
     1309             and
     1310             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1311           ( buf_price-all.fact-order-sys-to = ? or
     1312             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1313           :
     1314            v-interv   = "" .
     1315            v-grp-name = "" .
     1316            v-pay-name = "" .
     1317            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1318            if buf_price-all.bgr-id > 0 then do:
     1319               find first buf_buyer-group no-lock where
     1320                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1321                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1322               if available buf_buyer-group then do:
     1323                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1324                  find first buf_buyer-in-buyer-group no-lock where
     1325                             buf_buyer-in-buyer-group.stts         = 0 and
     1326                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1327                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1328                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1329                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1330                             no-error .
     1331                             if not available buf_buyer-in-buyer-group then do:
     1332                                v-grp-name = "".
     1333                                next.
     1334                             end.
     1335                             v-grp-name = buf_buyer-group.name .
     1336                  end.
     1337               end.
     1338               else do:
     1339                    v-grp-name = "".
     1340                    next.
     1341               end.
     1342            end.
     1343            if buf_price-all.tog-id > 0 then do:
     1344               find first buf_turnover-group no-lock where
     1345                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1346                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1347               if available buf_turnover-group then do:
     1348                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1349                     v-cli-oborot = v-cli-oborot-all  .
     1350                     find first buf1_tnv-in-turnover-group no-lock where
     1351                                buf1_tnv-in-turnover-group.stts       =  0     and
     1352                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1353                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1354                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1355                     find first buf2_tnv-in-turnover-group no-lock where
     1356                                buf2_tnv-in-turnover-group.stts       =  0     and
     1357                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1358                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1359                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1360                     if not (available buf1_tnv-in-turnover-group and
     1361                             available buf2_tnv-in-turnover-group ) then do:
     1362                             v-grp-name = "".
     1363                             next .
     1364                     end.
     1365                     v-grp-name = buf_turnover-group.name.
     1366                  end.
     1367               end.
     1368               else do:
     1369                    v-grp-name = "".
     1370                    next.
     1371               end.
     1372            end.
     1373            if buf_price-all.plt-fix-cource-crc-base = true then
     1374               assign
     1375                 v-base-rate  = buf_price-all.pdf-base-rate
     1376                 v-base-scale = buf_price-all.pdf-base-scale
     1377               .
     1378               else
     1379               assign
     1380                 v-base-rate  = v-base-rate0
     1381                 v-base-scale = v-base-scale0
     1382               .
     1383            if buf_price-all.plt-fix-cource-crc-doc = true then
     1384               assign
     1385                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1386                 v-exch-scale = buf_price-all.pdf-exch-scale
     1387               .
     1388               else do:
     1389   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1391     (input  buf_price-all.curr-code
     1392     ,input  to-day
     1393     ,output v-exch-rate0
     1394     ,output v-exch-scale0
     1395     ,output v-curr-abbr
     1396     )  .
     1397               assign
     1398                 v-exch-rate  = v-exch-rate0
     1399                 v-exch-scale = v-exch-scale0
     1400                 .
     1401              end.
     1402              v-date-1 = date ( "" )  .
     1403              if buf_price-all.fact-order-sys-from > 0 then do:
     1404                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1405                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1406                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1407              end.
     1408              v-date-2 =  date ( "" )  .
     1409              if buf_price-all.fact-order-sys-to > 0 then do:
     1410                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1411                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1412                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1413              end.
     1414              if buf_price-all.qnty-from <> ? then do :
     1415                 if not (
     1416                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1417                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1418                 ) then do:
     1419                        v-interv = "".
     1420                        next.
     1421                 end.
     1422                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1423              end.
     1424              if buf_price-all.sum-from <> ? then do :
     1425                 if not (
     1426                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1427                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1428                 ) then do:
     1429                    v-interv = "".
     1430                    next.
     1431                 end.
     1432                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1433              end.
     1434              if buf_price-all.turnover-from <> ? then do :
     1435                 if not (
     1436                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1437                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1438                 ) then do:
     1439                    v-interv = "".
     1440                    next.
     1441                 end.
     1442                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1443              end.
     1444              if buf_price-all.use-pay-type = 1 then do :
     1445                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1446                    v-pay-name = "" .
     1447                    next.
     1448                  end.
     1449                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1450              end.
     1451              if buf_price-all.use-cash-pay = 1 then do :
     1452                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1453                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1454                   v-pay-name = "" .
     1455                   next.
     1456                 end.
     1457                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1458              end.
     1459             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1460             create tt_price-all .
     1461             buffer-copy buf_price-all to tt_price-all
     1462             assign
     1463               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1464               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1465               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1466               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1467               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1468               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1469               tt_price-all.price-sale     = buf_price-all.price-sale
     1470               tt_price-all.road-tax       = buf_price-all.road-tax
     1471               tt_price-all.excise         = buf_price-all.excise
     1472               tt_price-all.pdf-exch-rate   = v-exch-rate
     1473               tt_price-all.pdf-exch-scale  = v-exch-scale
     1474               tt_price-all.pdf-base-rate   = v-base-rate
     1475               tt_price-all.pdf-base-scale  = v-base-scale
     1476               tt_price-all.grp-name        = v-grp-name
     1477               tt_price-all.date-1          = v-date-1
     1478               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1479               tt_price-all.time-1          = buf_price-all.start-sys-time
     1480               tt_price-all.date-2          = v-date-2
     1481               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1482               tt_price-all.time-2          = buf_price-all.end-sys-time
     1483               tt_price-all.interv-name     = v-interv
     1484               tt_price-all.pay-name        = v-pay-name
     1485               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1486             .
     1487   end.
     1488   define variable vt-plt-id as integer   no-undo .
     1489   define variable vt-plt-db as integer   no-undo .
     1490   define variable vt-pdf-id as integer   no-undo .
     1491   define variable vt-pdf-db as integer   no-undo .
     1492   define buffer neos_price-all for tt_price-all  .
     1493   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1494       if available tt_price-all then do:
     1495        assign
     1496          vt-plt-id = tt_price-all.plt-id
     1497          vt-plt-db = tt_price-all.plt-db-num
     1498          vt-pdf-id = tt_price-all.pdf-id
     1499          vt-pdf-db = tt_price-all.pdf-db
     1500        .
     1501        if tt_price-all.b-code = p-b-code then do:
     1502             assign
     1503               p-plt-id           = tt_price-all.plt-id
     1504               p-plt-db-num       = tt_price-all.plt-db-num
     1505               p-pdf-id           = tt_price-all.pdf-id
     1506               p-pdf-db-num       = tt_price-all.pdf-db
     1507               p-sale-price-base  = tt_price-all.price-sale-base
     1508               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1509               p-road-tax-base    = tt_price-all.road-tax-base
     1510               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1511               p-excise-base      = tt_price-all.excise-base
     1512               p-excise-rubl      = tt_price-all.excise-rubl
     1513               .
     1514        end.
     1515        else do:
     1516          find first neos_price-all where
     1517                     neos_price-all.b-code     = p-b-code  and
     1518                     neos_price-all.plt-id     = vt-plt-id and
     1519                     neos_price-all.plt-db-num = vt-plt-db and
     1520                     neos_price-all.pdf-id     = vt-pdf-id and
     1521                     neos_price-all.pdf-db     = vt-pdf-db
     1522                     use-index pi no-error .
     1523            if available neos_price-all then do:
     1524             assign
     1525               p-plt-id           = tt_price-all.plt-id
     1526               p-plt-db-num       = tt_price-all.plt-db-num
     1527               p-pdf-id           = tt_price-all.pdf-id
     1528               p-pdf-db-num       = tt_price-all.pdf-db
     1529               p-sale-price-base  = neos_price-all.price-sale-base
     1530               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1531               p-road-tax-base    = neos_price-all.road-tax-base
     1532               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1533               p-excise-base      = neos_price-all.excise-base
     1534               p-excise-rubl      = neos_price-all.excise-rubl
     1535               .
     1536            end.
     1537            else do:
     1538                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1539                 if error-status :error    then do:
     1540                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1541                   return error return-value .
     1542                 end.
     1543             assign
     1544               p-plt-id           = tt_price-all.plt-id
     1545               p-plt-db-num       = tt_price-all.plt-db-num
     1546               p-pdf-id           = tt_price-all.pdf-id
     1547               p-pdf-db-num       = tt_price-all.pdf-db
     1548               p-sale-price-base  = tt_price-all.price-sale-base
     1549               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1550               p-road-tax-base    = tt_price-all.road-tax-base
     1551               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1552               p-excise-base      = tt_price-all.excise-base
     1553               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1554               .
     1555            end.
     1556        end.
     1557     end.
     1558   end.
     1559   end procedure.
     1560   procedure mpl-tpl-auto :
     1561   define input  parameter p-b-code     as integer   no-undo .
     1562   define input  parameter p-obj-type   as character no-undo .
     1563   define input  parameter p-obj-code   as integer   no-undo .
     1564   define input  parameter p-plt-id     as integer   no-undo .
     1565   define input  parameter p-plt-db-num as integer   no-undo .
     1566   define input  parameter p-fact-order as decimal   no-undo .
     1567   define output parameter p-sale-price as decimal   no-undo .
     1568   define output parameter p-pdf-id     as integer   no-undo .
     1569   define output parameter p-pdf-db-num as integer   no-undo .
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573   if p-fact-order = ? then do:
     1574     run fact-order-mpl (
     1575         input   today       ,
     1576         input   p-obj-type  ,
     1577         input   p-obj-code  ,
     1578         output  p-fact-order ) .
     1579   end.
     1580   assign
     1581     p-pdf-id      = ?
     1582     p-pdf-db-num  = ?
     1583     p-sale-price  = ?
     1584   .
     1585   define buffer buf_bar-code for ub.bar-code  .
     1586   define buffer buf_goods for ub.goods  .
     1587   find first buf_bar-code no-lock where
     1588              buf_bar-code.b-code = p-b-code
     1589              no-error .
     1590   if error-status :error then return error return-value .
     1591   find first buf_goods no-lock where
     1592              buf_goods.gds-code = buf_bar-code.gds-code
     1593              no-error .
     1594   if error-status :error then return error return-value .
     1595   define variable v-main-b-code as integer   no-undo .
     1596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1597     (input  buf_goods.gds-code
     1598     ,input  ?
     1599     ,output v-main-b-code
     1600     )  .
     1601   define buffer buf_price-all for ub.price-all  .
     1602   for each tt_price-all : delete tt_price-all. end.
     1603       for each buf_price-all no-lock where
     1604               buf_price-all.plt-id     = p-plt-id                 and
     1605               buf_price-all.plt-db-num = p-plt-db-num             and
     1606               buf_price-all.obj-type   = p-obj-type               and
     1607               buf_price-all.obj-code   = p-obj-code               and
     1608               buf_price-all.gds-code   = buf_goods.gds-code       and
     1609             ( buf_price-all.b-code = v-main-b-code or
     1610               buf_price-all.b-code = p-b-code)    and
     1611               buf_price-all.status_    = 'акт':U         and
     1612               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1613             ( buf_price-all.fact-order-sys-to = ? or
     1614               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1615               :
     1616                 create tt_price-all .
     1617                 buffer-copy buf_price-all to tt_price-all
     1618                 assign
     1619                   tt_price-all.price-sale  = buf_price-all.price-sale
     1620                 .
     1621       end.
     1622   define variable vt-plt-id as integer   no-undo .
     1623   define variable vt-plt-db as integer   no-undo .
     1624   define variable vt-pdf-id as integer   no-undo .
     1625   define variable vt-pdf-db as integer   no-undo .
     1626   define buffer neos_price-all for tt_price-all  .
     1627   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1628       if available tt_price-all then do:
     1629        assign
     1630          vt-plt-id = tt_price-all.plt-id
     1631          vt-plt-db = tt_price-all.plt-db-num
     1632          vt-pdf-id = tt_price-all.pdf-id
     1633          vt-pdf-db = tt_price-all.pdf-db
     1634        .
     1635        if tt_price-all.b-code = p-b-code then do:
     1636             assign
     1637               p-plt-id           = tt_price-all.plt-id
     1638               p-plt-db-num       = tt_price-all.plt-db-num
     1639               p-pdf-id           = tt_price-all.pdf-id
     1640               p-pdf-db-num       = tt_price-all.pdf-db
     1641               p-sale-price       = tt_price-all.price-sale
     1642               .
     1643        end.
     1644        else do:
     1645          find first neos_price-all where
     1646                     neos_price-all.b-code     = p-b-code  and
     1647                     neos_price-all.plt-id     = vt-plt-id and
     1648                     neos_price-all.plt-db-num = vt-plt-db and
     1649                     neos_price-all.pdf-id     = vt-pdf-id and
     1650                     neos_price-all.pdf-db     = vt-pdf-db
     1651                     use-index pi no-error .
     1652            if available neos_price-all then do:
     1653             assign
     1654               p-plt-id           = tt_price-all.plt-id
     1655               p-plt-db-num       = tt_price-all.plt-db-num
     1656               p-pdf-id           = tt_price-all.pdf-id
     1657               p-pdf-db-num       = tt_price-all.pdf-db
     1658               p-sale-price       = neos_price-all.price-sale
     1659               .
     1660            end.
     1661            else do:
     1662           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1663           if error-status :error    then do:
     1664              message "Не найден бар-код" p-b-code view-as alert-box error .
     1665              return error return-value .
     1666           end.
     1667             assign
     1668               p-plt-id           = tt_price-all.plt-id
     1669               p-plt-db-num       = tt_price-all.plt-db-num
     1670               p-pdf-id           = tt_price-all.pdf-id
     1671               p-pdf-db-num       = tt_price-all.pdf-db
     1672               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1673               .
     1674            end.
     1675        end.
     1676     end.
     1677     end.
     1678   end procedure.
     1679   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   procedure wthcattr-sprcli :
     1682   define input parameter parparentproc  as widget-handle no-undo.
     1683   define input parameter p-mode  as character no-undo.
     1684   define input-output parameter p-value as character no-undo .
     1685   define output parameter p-setted as logical no-undo .
     1686     DEFINE VARIABLE v-value as character no-undo .
     1687     define variable v-cli-type as character no-undo .
     1688     define variable v-cli-code as integer no-undo .
     1689     define buffer buf_clients   for ub.clients.
     1690     define variable v_rid as character no-undo.
     1691     define variable ref-rec as recid no-undo .
     1692     do
     1693     on error undo, return error
     1694     :
     1695         v-value = p-value.
     1696      if p-value <> '':U then do:
     1697       assign
     1698       v-cli-type = substring(p-value, 1, 3)
     1699       v-cli-code = integer(substring(p-value, 4))
     1700       no-error.
     1701       if error-status:error then do:
     1702         assign
     1703         v-cli-type = '':U
     1704         v-cli-code = 0
     1705         .
     1706       end.
     1707      end.
     1708      FIND FIRST buf_clients NO-LOCK WHERE
     1709               buf_clients.obj-type = v-cli-type AND
     1710               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1711      IF available(buf_clients) then do:
     1712       run ref/cli-all.w (
     1713                   input parparentproc
     1714                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1715                  ,input v-cli-type
     1716                  ,input 'все':U
     1717                  ,input 'все':U
     1718                  ,input RECID( buf_clients )
     1719                  ,input ",,,,,,NO"
     1720                  ,input ?
     1721                  ,OUTPUT v_rid ).
     1722     END.
     1723     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1724       run ref/cli-all.w (
     1725                    input parparentproc
     1726                   ,INPUT "b-sel":U
     1727                  ,input  v-cli-type
     1728                  ,input 'все':U
     1729                  ,input 'текущие':U
     1730                  ,input ?
     1731                  ,input ",,,,,,NO"
     1732                  ,input ?
     1733                  ,OUTPUT v_rid ).
     1734     END.
     1735     else do:
     1736       message
     1737       if p-value = "":U then 'Атрибут не задан!'
     1738       else substitute('Не найден клиент &1',p-value)
     1739       view-as alert-box warning.
     1740     end.
     1741     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1742       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1743       IF ERROR-STATUS:ERROR THEN DO:
     1744           RETURN NO-APPLY.
     1745       END.
     1746       FIND FIRST buf_clients NO-LOCK WHERE
     1747                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1748       IF AVAIL buf_clients THEN DO:
     1749         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1750       end.
     1751     end.
     1752     if v-value <> p-value then do:
     1753       p-value = v-value.
     1754       p-setted = yes.
     1755     end.
     1756     end.
     1757   end procedure.
     1758     define new global shared variable g#wthcalib as handle no-undo.
     1759   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1760   define variable v-tth as handle no-undo .
     1761   assign
     1762   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1763   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1764   Procedure wth-doc-close:
     1765       define input parameter p-rec        as recid     no-undo .
     1766       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1767     do
     1768     on error undo, return error return-value
     1769     :
     1770       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1771       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1772       CASE cur-wth-parts.ext-doc-type:
     1773           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1774           OR WHEN 'fj':U
     1775           THEN DO:
     1776              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1777           END.
     1778           WHEN 'ee':U THEN DO:
     1779               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1780           END.
     1781           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1782             OR WHEN 'ip':U OR WHEN 'pc':U
     1783             OR WHEN 'pj':U
     1784              THEN DO:
     1785               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1786           END.
     1787           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1788             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1789           end.
     1790           when 'ep':U or when 'ef':U
     1791           OR WHEN 'oj':U or when 'jj':U
     1792           then .
     1793           when 'xc':U then do:
     1794             if cur-wth-parts.type = 'при':U then
     1795                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1796             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1797           end.
     1798           OTHERWISE DO:
     1799               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1800                                    , cur-wth-parts.ext-doc-type
     1801                                       ).
     1802           END.
     1803       END CASE.
     1804       RELEASE cur-wth-parts.
     1805       END.
     1806   END.
     1807   PROCEDURE wth-parts-close:
     1808       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1809       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1810       define variable v-rec as recid.
     1811       if bfrom_wth-parts.stts  = 1 then return.
     1812          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1813                     INPUT     bfrom_wth-parts.obj-type,
     1814                     INPUT     bfrom_wth-parts.obj-code,
     1815                     INPUT     bfrom_wth-parts.w-p-code,
     1816                     INPUT     bfrom_wth-parts.wth-code,
     1817                     INPUT     bfrom_wth-parts.par-code,
     1818                     INPUT     bfrom_wth-parts.in-code ,
     1819                     INPUT     p-zone,
     1820                     INPUT     bfrom_wth-parts.ser-code,
     1821                     INPUT     bfrom_wth-parts.db-num  ,
     1822                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1823                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1824                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1825                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1826                     INPUT     bfrom_wth-parts.host-code     ,
     1827                     INPUT     bfrom_wth-parts.contract-code               ,
     1828                     INPUT     bfrom_wth-parts.price-rubl    ,
     1829                     INPUT     bfrom_wth-parts.price-base    ,
     1830                     INPUT     bfrom_wth-parts.supp-type,
     1831                     INPUT     bfrom_wth-parts.supp-code,
     1832                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1833                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1834                     INPUT     bfrom_wth-parts.ext-doc-type,
     1835                     INPUT     bfrom_wth-parts.gds-code,
     1836                     INPUT     bfrom_wth-parts.stts               ,
     1837                     INPUT     bfrom_wth-parts.beg-dt        ,
     1838                     INPUT     bfrom_wth-parts.end-dt        ,
     1839                     INPUT     bfrom_wth-parts.vat-pc        ,
     1840                     INPUT     bfrom_wth-parts.cli-code,
     1841                     INPUT     bfrom_wth-parts.cli-type,
     1842                     INPUT     bfrom_wth-parts.out-obj-code,
     1843                     INPUT     bfrom_wth-parts.out-obj-type,
     1844                     INPUT     bfrom_wth-parts.sale-obj-code,
     1845                     INPUT     bfrom_wth-parts.sale-obj-type,
     1846                     INPUT     bfrom_wth-parts.out-code ,
     1847                     INPUT  yes,
     1848                     INPUT     '':U ,
     1849                     INPUT-OUTPUT v-rec
     1850                     ) no-error.
     1851       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1852   END.
     1853   Procedure wth-doc-razrez:
     1854       define input parameter p-rec as recid NO-UNDO.
     1855       define input parameter p-doc-del AS log NO-UNDO.
     1856       define variable v-mess AS CHAR NO-UNDO.
     1857       define variable p-silent AS LOG INIT NO NO-UNDO.
     1858       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1859       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1860       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1861     do
     1862     on error undo, return error return-value
     1863     :
     1864       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1865                                 EXCLUSIVE-LOCK .
     1866       IF AVAILABLE cur-wth-parts THEN DO:
     1867           CASE cur-wth-parts.ext-doc-type:
     1868               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1869               or when 'ff':U or when 'rf':U
     1870               or when 'fj':U or when 'pj':U
     1871               THEN DO:
     1872                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1873               END.
     1874               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1875               THEN DO:
     1876                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1877               END.
     1878               WHEN 'ep':U or when 'oj':U THEN DO:
     1879                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     1880               END.
     1881               WHEN 'pc':U THEN DO:
     1882                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1883               END.
     1884               WHEN 'dp':U THEN DO:
     1885                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     1886               END.
     1887               WHEN 'df':U THEN DO:
     1888                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     1889               END.
     1890               WHEN 'dc':U THEN DO:
     1891                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1892               END.
     1893               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     1894                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     1895               END.
     1896               when 'xc':U then do:
     1897                 if cur-wth-parts.type = 'при':U then
     1898                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     1899                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     1900               end.
     1901               OTHERWISE DO:
     1902                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     1903                                        , cur-wth-parts.ext-doc-type
     1904                                        , error-status:get-message(1)
     1905                                        , return-value
     1906                                        ).
     1907               END.
     1908           END CASE.
     1909       END.
     1910     END.
     1911   END.
     1912   PROCEDURE wth-parts-raz:
     1913       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1914       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1915       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     1916       define variable v-mes as char no-undo.
     1917       define variable v-rec as recid no-undo.
     1918       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     1923                                      ,bfrom_wth-parts.ser-code
     1924                                      ,bfrom_wth-parts.db-num
     1925                                      ,bfrom_wth-parts.doc-rangeFrom
     1926                                      ,bfrom_wth-parts.doc-rangeTo).
     1927       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     1928           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     1929                                , error-status:get-message(1)
     1930                                , bfrom_wth-parts.out-code
     1931                                , return-value
     1932                                ,chr(10)
     1933                                ,v-mes
     1934                                ).
     1935       END.
     1936       v-rec = recid(bfrom_wth-parts).
     1937       CASE bfrom_wth-parts.ext-doc-type:
     1938           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     1939               delete bfrom_wth-parts NO-ERROR.
     1940               if error-status:error then do:
     1941                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1942                                      , error-status:get-message(1)
     1943                                      , chr(10)
     1944                                      , return-value
     1945                                      ,v-mes
     1946                                      ).
     1947               END.
     1948           END.
     1949           when 'rp':U or when 'rf':U then do:
     1950             if p-doc-del then do:
     1951               delete bfrom_wth-parts NO-ERROR.
     1952               if error-status:error then do:
     1953                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1954                                      , error-status:get-message(1)
     1955                                      , chr(10)
     1956                                      , return-value
     1957                                      ,v-mes
     1958                                      ).
     1959               END.
     1960             end.
     1961             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     1962           end.
     1963           when 'ip':U or when 'ff':U then do:
     1964             if p-doc-del then do:
     1965               delete bfrom_wth-parts NO-ERROR.
     1966               if error-status:error then do:
     1967                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1968                                      , error-status:get-message(1)
     1969                                      , chr(10)
     1970                                      , return-value
     1971                                      ,v-mes
     1972                                      ).
     1973               END.
     1974             end.
     1975             else do:
     1976               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     1977                     INPUT     bfrom_wth-parts.obj-type,
     1978                     INPUT     bfrom_wth-parts.obj-code,
     1979                     INPUT     bfrom_wth-parts.w-p-code,
     1980                     INPUT     bfrom_wth-parts.wth-code,
     1981                     INPUT     bfrom_wth-parts.par-code,
     1982                     INPUT     bfrom_wth-parts.in-code ,
     1983                     INPUT     bfrom_wth-parts.out-code,
     1984                     INPUT     bfrom_wth-parts.ser-code,
     1985                     INPUT     bfrom_wth-parts.db-num  ,
     1986                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1987                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     1988                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     1989                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     1990                     INPUT     bfrom_wth-parts.host-code     ,
     1991                     INPUT     bfrom_wth-parts.contract-code ,
     1992                     INPUT     bfrom_wth-parts.price-rubl    ,
     1993                     INPUT     bfrom_wth-parts.price-base    ,
     1994                     INPUT     bfrom_wth-parts.supp-type,
     1995                     INPUT     bfrom_wth-parts.supp-code,
     1996                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1997                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1998                     INPUT     bfrom_wth-parts.ext-doc-type,
     1999                     INPUT     bfrom_wth-parts.gds-code,
     2000                     INPUT     1            ,
     2001                     INPUT     bfrom_wth-parts.beg-dt        ,
     2002                     INPUT     bfrom_wth-parts.end-dt        ,
     2003                     INPUT     bfrom_wth-parts.vat-pc        ,
     2004                     INPUT     bfrom_wth-parts.cli-code,
     2005                     INPUT     bfrom_wth-parts.cli-type,
     2006                     INPUT     bfrom_wth-parts.out-obj-code,
     2007                     INPUT     bfrom_wth-parts.out-obj-type,
     2008                     INPUT     bfrom_wth-parts.sale-obj-code,
     2009                     INPUT     bfrom_wth-parts.sale-obj-type,
     2010                     INPUT     bfrom_wth-parts.doc-code ,
     2011                     INPUT  yes,
     2012                     INPUT     bfrom_wth-parts.type ,
     2013                     INPUT-OUTPUT v-rec
     2014                     ) no-error.
     2015                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2016             end.
     2017           end.
     2018           OTHERWISE DO:
     2019            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2020                     INPUT     bfrom_wth-parts.obj-type,
     2021                     INPUT     bfrom_wth-parts.obj-code,
     2022                     INPUT     bfrom_wth-parts.w-p-code,
     2023                     INPUT     bfrom_wth-parts.wth-code,
     2024                     INPUT     bfrom_wth-parts.par-code,
     2025                     INPUT     bfrom_wth-parts.in-code ,
     2026                     INPUT     p-zone,
     2027                     INPUT     bfrom_wth-parts.ser-code,
     2028                     INPUT     bfrom_wth-parts.db-num  ,
     2029                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2030                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2031                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2032                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2033                     INPUT     bfrom_wth-parts.host-code     ,
     2034                     INPUT     bfrom_wth-parts.contract-code ,
     2035                     INPUT     bfrom_wth-parts.price-rubl    ,
     2036                     INPUT     bfrom_wth-parts.price-base    ,
     2037                     INPUT     bfrom_wth-parts.supp-type,
     2038                     INPUT     bfrom_wth-parts.supp-code,
     2039                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2040                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2041                     INPUT     bfrom_wth-parts.ext-doc-type,
     2042                     INPUT     bfrom_wth-parts.gds-code,
     2043                     INPUT     bfrom_wth-parts.stts             ,
     2044                     INPUT     bfrom_wth-parts.beg-dt        ,
     2045                     INPUT     bfrom_wth-parts.end-dt        ,
     2046                     INPUT     bfrom_wth-parts.vat-pc        ,
     2047                     INPUT     bfrom_wth-parts.cli-code,
     2048                     INPUT     bfrom_wth-parts.cli-type,
     2049                     INPUT     bfrom_wth-parts.out-obj-code,
     2050                     INPUT     bfrom_wth-parts.out-obj-type,
     2051                     INPUT     bfrom_wth-parts.sale-obj-code,
     2052                     INPUT     bfrom_wth-parts.sale-obj-type,
     2053                     INPUT     bfrom_wth-parts.doc-code ,
     2054                     INPUT  yes,
     2055                     INPUT      "":U ,
     2056                     INPUT-OUTPUT v-rec
     2057                     ) no-error.
     2058       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2059           END.
     2060       END CASE.
     2061     END.
     2062   END.
     2063   procedure wth-parts-rezerv:
     2064       define input parameter        p-param            as logical no-undo.
     2065       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2066       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2067       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2068       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2069       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2070       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2071       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2072       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2073       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2074       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2075       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2076       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2077       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2078       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2079       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2080       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2081       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2082       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2083       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2084       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2085       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2086       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2087       define input-output parameter p-rec        as recid     no-undo .
     2088     define buffer bfrom_wth-parts   for ub.wth-parts.
     2089     define buffer bufr_wth-doc      for ub.wth-doc.
     2090     define variable v-rec    as recid        no-undo.
     2091     define variable v-recDop as recid        no-undo.
     2092     define variable v-zone   as character    no-undo.
     2093     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2094     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2095     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2096     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2097     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2098     define variable v-mpl-date         as date      no-undo.
     2099     empty temp-table tt-wthlib-parts.
     2100   main-block:
     2101   do  transaction
     2102   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2103   on stop   undo main-block, return error
     2104   on endkey undo main-block, return error
     2105   :
     2106   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2107   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2108     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2109           then do:
     2110        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2111                     INPUT  p-obj-type,
     2112                     INPUT  p-obj-code,
     2113                     INPUT  p-w-p-code,
     2114                     INPUT  p-wth-code,
     2115                     INPUT  p-par-code,
     2116                     INPUT  p-in-code,
     2117                     INPUT  p-doc-code,
     2118                     INPUT  p-ser-code,
     2119                     INPUT  p-db-num  ,
     2120                     INPUT  p-Fact-RangeFrom ,
     2121                     INPUT  p-fact-rangeTo  ,
     2122                     INPUT  p-Fact-RangeFrom ,
     2123                     INPUT  p-fact-rangeTo ,
     2124                     INPUT  p-host-code     ,
     2125                     INPUT  0   ,
     2126                     INPUT  p-price-rubl    ,
     2127                     INPUT  p-price-base    ,
     2128                     INPUT  '':U,
     2129                     INPUT  0,
     2130                     INPUT  p-obj-type      ,
     2131                     INPUT  p-obj-code      ,
     2132                     INPUT  p-ext-doc-type,
     2133                     INPUT  p-gds-code,
     2134                     INPUT  0           ,
     2135                     INPUT  p-beg-dt        ,
     2136                     INPUT  p-end-dt        ,
     2137                     INPUT  p-vat-pc      ,
     2138                     INPUT  0,
     2139                     INPUT  '':U,
     2140                     INPUT  0,
     2141                     INPUT  '':U,
     2142                     INPUT  0,
     2143                     INPUT  '':U,
     2144                     INPUT  p-doc-code,
     2145                     INPUT  yes,
     2146                     INPUT p-type,
     2147                     INPUT-OUTPUT p-rec
     2148                     ) no-error.
     2149                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2150     end.
     2151     else do:
     2152       if p-rec <> ? then do:
     2153         find first bfrom_wth-parts exclusive-lock where
     2154                   recid(bfrom_wth-parts) = p-rec no-error.
     2155         if  available bfrom_wth-parts
     2156           and bfrom_wth-parts.wth-code = p-wth-code
     2157           and bfrom_wth-parts.par-code = p-par-code
     2158           and bfrom_wth-parts.ser-code = p-ser-code
     2159           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2160         then.
     2161         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2162         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2163                                      ,bfrom_wth-parts.ser-code
     2164                                      ,bfrom_wth-parts.db-num
     2165                                      ,bfrom_wth-parts.doc-rangeFrom
     2166                                      ,bfrom_wth-parts.doc-rangeTo).
     2167         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2168         if available bfrom_wth-parts
     2169            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2170            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2171         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2172                                            ,chr(10)
     2173                                            ,bfrom_wth-parts.doc-rangeFrom
     2174                                            ,bfrom_wth-parts.doc-rangeTo
     2175                                            ,p-fact-rangeFrom
     2176                                            ,p-fact-rangeTo).
     2177       end.
     2178       else do:
     2179         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2180           for first bfrom_wth-parts no-lock where
     2181                                     bfrom_wth-parts.wth-code = p-wth-code
     2182                                 and bfrom_wth-parts.par-code = p-par-code
     2183                                 and bfrom_wth-parts.ser-code = p-ser-code
     2184                                 and bfrom_wth-parts.db-num = p-db-num
     2185                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2186                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2187                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2188                                 and bfrom_wth-parts.stts = 0
     2189                                 and bfrom_wth-parts.cli-code = p-cli-code
     2190                                 and bfrom_wth-parts.cli-type = p-cli-type
     2191                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2192                                 use-index  wth-idnt:
     2193                                 p-rec = recid(bfrom_wth-parts).
     2194            end.
     2195           If p-rec = ? and p-in-code > '' then do:
     2196              for first bfrom_wth-parts no-lock where
     2197                                     bfrom_wth-parts.wth-code = p-wth-code
     2198                                 and bfrom_wth-parts.par-code = p-par-code
     2199                                 and bfrom_wth-parts.ser-code = p-ser-code
     2200                                 and bfrom_wth-parts.db-num = p-db-num
     2201                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2202                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2203                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2204                                 and bfrom_wth-parts.stts = 0
     2205                                 and bfrom_wth-parts.cli-code = p-cli-code
     2206                                 and bfrom_wth-parts.cli-type = p-cli-type
     2207                                 use-index  wth-idnt:
     2208                                 p-rec = recid(bfrom_wth-parts).
     2209                 end.
     2210           end.
     2211                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2212                   recid(bfrom_wth-parts) = p-rec no-error.
     2213         end.
     2214         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2215           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2216                                 and bfrom_wth-parts.par-code = p-par-code
     2217                                 and bfrom_wth-parts.ser-code = p-ser-code
     2218                                 and bfrom_wth-parts.db-num = p-db-num
     2219                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2220                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2221                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2222                                 and bfrom_wth-parts.stts = 0
     2223                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2224                                 use-index wth-idnt:
     2225                                 p-rec = recid(bfrom_wth-parts).
     2226            end.
     2227           If p-rec = ? and p-in-code > '' then do:
     2228            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2229                                 and bfrom_wth-parts.par-code = p-par-code
     2230                                 and bfrom_wth-parts.ser-code = p-ser-code
     2231                                 and bfrom_wth-parts.db-num = p-db-num
     2232                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2233                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2234                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2235                                 and bfrom_wth-parts.stts = 0
     2236                                 :
     2237                                 p-rec = recid(bfrom_wth-parts).
     2238            end.
     2239           end.
     2240           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2241                   recid(bfrom_wth-parts) = p-rec no-error.
     2242         end.
     2243         else do:
     2244           CASE p-ext-doc-type:
     2245                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2246                   or when 'jj':U THEN DO:
     2247                       v-zone = 'free-zone':U.
     2248                   END.
     2249                   WHEN 'ep':U or when 'oj':U THEN DO:
     2250                       v-zone = 'put-zone':U.
     2251                   END.
     2252                   WHEN 'df':U THEN DO:
     2253                       v-zone = 'free-zone':U.
     2254                   END.
     2255                   WHEN 'dp':U  THEN DO:
     2256                       v-zone = 'put-zone':U.
     2257                   END.
     2258                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2259                       v-zone = 'cli-zone':U.
     2260                   END.
     2261                   OTHERWISE DO:
     2262                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2263                                            , p-ext-doc-type
     2264                                               ).
     2265                   END.
     2266           END CASE.
     2267           find first bfrom_wth-parts no-lock where
     2268                                     bfrom_wth-parts.wth-code = p-wth-code
     2269                                 and bfrom_wth-parts.obj-code = p-obj-code
     2270                                 and bfrom_wth-parts.obj-type = p-obj-type
     2271                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2272                                 and bfrom_wth-parts.par-code = p-par-code
     2273                                 and bfrom_wth-parts.ser-code = p-ser-code
     2274                                 and bfrom_wth-parts.db-num = p-db-num
     2275                                 and bfrom_wth-parts.out-code = v-zone
     2276                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2277                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2278                                 and bfrom_wth-parts.stts = 0
     2279                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2280                                 no-error.
     2281          If not available bfrom_wth-parts and p-in-code > '' then do:
     2282                  find first bfrom_wth-parts no-lock where
     2283                                     bfrom_wth-parts.wth-code = p-wth-code
     2284                                 and bfrom_wth-parts.obj-code = p-obj-code
     2285                                 and bfrom_wth-parts.obj-type = p-obj-type
     2286                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2287                                 and bfrom_wth-parts.par-code = p-par-code
     2288                                 and bfrom_wth-parts.ser-code = p-ser-code
     2289                                 and bfrom_wth-parts.db-num = p-db-num
     2290                                 and bfrom_wth-parts.out-code = v-zone
     2291                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2292                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2293                                 and bfrom_wth-parts.stts = 0
     2294                                 no-error.
     2295          end.
     2296         end.
     2297       end.
     2298       if not available bfrom_wth-parts then do:
     2299            if g#news then do:
     2300             return error 'forged':U.
     2301            end.
     2302            else
     2303             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2304                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2305                                           p-fact-rangeTo).
     2306       end.
     2307       p-rec = recid(bfrom_wth-parts).
     2308       find current bfrom_wth-parts exclusive-lock.
     2309       create tt-wthlib-parts.
     2310       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2311           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2312                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2313                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2314                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2315                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2316       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2317           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2318               RUN init_prtdate ( INPUT p-obj-type
     2319                                                 ,INPUT p-obj-code
     2320                                                 ,INPUT p-ser-code
     2321                                                 ,INPUT p-db-num
     2322                                                 ,INPUT bufr_wth-doc.doc-date
     2323                                                 ,OUTPUT v-beg-dt
     2324                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2325               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2326           END.
     2327           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2328             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2329                                ,bufr_wth-doc.doc-date
     2330                                , v-beg-dt
     2331                                , output v-mpl-date) no-error.
     2332               RUN INIT_prtprice (
     2333                             p-host-code
     2334                           , p-obj-type
     2335                           , p-obj-code
     2336                           , p-cli-type
     2337                           , p-cli-code
     2338                           , p-wth-code
     2339                           , p-gds-code
     2340                           , p-par-code
     2341                           , v-mpl-date
     2342                           , OUTPUT  v-vat-pc
     2343                           , OUTPUT  v-price-rubl
     2344                           , OUTPUT  v-price-base
     2345                   ) NO-ERROR.
     2346             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2347           END.
     2348       END.
     2349         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2350                     INPUT     p-obj-type,
     2351                     INPUT     p-obj-code,
     2352                     INPUT     p-w-p-code,
     2353                     INPUT     bfrom_wth-parts.wth-code,
     2354                     INPUT     bfrom_wth-parts.par-code,
     2355                     INPUT     bfrom_wth-parts.in-code ,
     2356                     INPUT     p-doc-code,
     2357                     INPUT     bfrom_wth-parts.ser-code,
     2358                     INPUT     bfrom_wth-parts.db-num  ,
     2359                     INPUT     p-Fact-RangeFrom ,
     2360                     INPUT     p-fact-rangeTo  ,
     2361                     INPUT     p-Fact-RangeFrom ,
     2362                     INPUT     p-fact-rangeTo ,
     2363                     INPUT     bfrom_wth-parts.host-code     ,
     2364                     INPUT     bfrom_wth-parts.contract-code               ,
     2365                     INPUT     v-price-rubl ,
     2366                     INPUT     v-price-base  ,
     2367                     INPUT     bfrom_wth-parts.supp-type,
     2368                     INPUT     bfrom_wth-parts.supp-code,
     2369                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2370                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2371                     INPUT     p-ext-doc-type,
     2372                     INPUT     bfrom_wth-parts.gds-code,
     2373                     INPUT     0              ,
     2374                     INPUT     v-beg-dt    ,
     2375                     INPUT     v-end-dt   ,
     2376                     INPUT     v-vat-pc    ,
     2377                     INPUT     bfrom_wth-parts.cli-code,
     2378                     INPUT     bfrom_wth-parts.cli-type,
     2379                     INPUT     bfrom_wth-parts.out-obj-code,
     2380                     INPUT     bfrom_wth-parts.out-obj-type,
     2381                     INPUT     bfrom_wth-parts.sale-obj-code,
     2382                     INPUT     bfrom_wth-parts.sale-obj-type,
     2383                     INPUT     bfrom_wth-parts.doc-code,
     2384                     INPUT     yes,
     2385                     INPUT     p-type,
     2386                     INPUT-OUTPUT p-rec
     2387                     ) no-error.
     2388       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2389       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2390       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2391                     INPUT     tt-wthlib-parts.obj-type,
     2392                     INPUT     tt-wthlib-parts.obj-code,
     2393                     INPUT     tt-wthlib-parts.w-p-code,
     2394                     INPUT     tt-wthlib-parts.wth-code,
     2395                     INPUT     tt-wthlib-parts.par-code,
     2396                     INPUT     tt-wthlib-parts.in-code ,
     2397                     INPUT     tt-wthlib-parts.out-code,
     2398                     INPUT     tt-wthlib-parts.ser-code,
     2399                     INPUT     tt-wthlib-parts.db-num  ,
     2400                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2401                     INPUT     p-fact-rangeFrom - 1  ,
     2402                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2403                     INPUT     p-fact-rangeFrom - 1,
     2404                     INPUT     tt-wthlib-parts.host-code     ,
     2405                     INPUT     tt-wthlib-parts.contract-code               ,
     2406                     INPUT     tt-wthlib-parts.price-rubl    ,
     2407                     INPUT     tt-wthlib-parts.price-base    ,
     2408                     INPUT     tt-wthlib-parts.supp-type,
     2409                     INPUT     tt-wthlib-parts.supp-code,
     2410                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2411                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2412                     INPUT     tt-wthlib-parts.ext-doc-type,
     2413                     INPUT     tt-wthlib-parts.gds-code,
     2414                     INPUT     tt-wthlib-parts.stts               ,
     2415                     INPUT     tt-wthlib-parts.beg-dt        ,
     2416                     INPUT     tt-wthlib-parts.end-dt        ,
     2417                     INPUT     tt-wthlib-parts.vat-pc        ,
     2418                     INPUT     tt-wthlib-parts.cli-code,
     2419                     INPUT     tt-wthlib-parts.cli-type,
     2420                     INPUT     tt-wthlib-parts.out-obj-code,
     2421                     INPUT     tt-wthlib-parts.out-obj-type,
     2422                     INPUT     tt-wthlib-parts.sale-obj-code,
     2423                     INPUT     tt-wthlib-parts.sale-obj-type,
     2424                     INPUT     tt-wthlib-parts.doc-code,
     2425                     INPUT  yes,
     2426                     INPUT    tt-wthlib-parts.type,
     2427                     INPUT-OUTPUT v-recDop
     2428                     ) no-error.
     2429       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2430       end.
     2431       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2432               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2433                     INPUT     tt-wthlib-parts.obj-type,
     2434                     INPUT     tt-wthlib-parts.obj-code,
     2435                     INPUT     tt-wthlib-parts.w-p-code,
     2436                     INPUT     tt-wthlib-parts.wth-code,
     2437                     INPUT     tt-wthlib-parts.par-code,
     2438                     INPUT     tt-wthlib-parts.in-code ,
     2439                     INPUT     tt-wthlib-parts.out-code,
     2440                     INPUT     tt-wthlib-parts.ser-code,
     2441                     INPUT     tt-wthlib-parts.db-num  ,
     2442                     INPUT     p-fact-rangeTo + 1 ,
     2443                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2444                     INPUT     p-fact-rangeTo + 1 ,
     2445                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2446                     INPUT     tt-wthlib-parts.host-code     ,
     2447                     INPUT     tt-wthlib-parts.contract-code               ,
     2448                     INPUT     tt-wthlib-parts.price-rubl    ,
     2449                     INPUT     tt-wthlib-parts.price-base    ,
     2450                     INPUT     tt-wthlib-parts.supp-type,
     2451                     INPUT     tt-wthlib-parts.supp-code,
     2452                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2453                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2454                     INPUT     tt-wthlib-parts.ext-doc-type,
     2455                     INPUT     tt-wthlib-parts.gds-code,
     2456                     INPUT     tt-wthlib-parts.stts               ,
     2457                     INPUT     tt-wthlib-parts.beg-dt        ,
     2458                     INPUT     tt-wthlib-parts.end-dt        ,
     2459                     INPUT     tt-wthlib-parts.vat-pc        ,
     2460                     INPUT     tt-wthlib-parts.cli-code,
     2461                     INPUT     tt-wthlib-parts.cli-type,
     2462                     INPUT     tt-wthlib-parts.out-obj-code,
     2463                     INPUT     tt-wthlib-parts.out-obj-type,
     2464                     INPUT     tt-wthlib-parts.sale-obj-code,
     2465                     INPUT     tt-wthlib-parts.sale-obj-type,
     2466                     INPUT     tt-wthlib-parts.doc-code,
     2467                     INPUT     yes,
     2468                     INPUT     tt-wthlib-parts.type,
     2469                     INPUT-OUTPUT v-recDop
     2470                     ) no-error.
     2471         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2472       end.
     2473     end.
     2474   end.
     2475   end procedure.
     2476   procedure wth-parts-inter-edit:
     2477     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2478     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2479     define input-output parameter p-rec        as recid     no-undo .
     2480     define buffer bfrom_wth-parts   for ub.wth-parts.
     2481     define variable v-recDop as recid        no-undo.
     2482     do on error undo, return error:
     2483         find first bfrom_wth-parts exclusive-lock where
     2484                   recid(bfrom_wth-parts) = p-rec no-error.
     2485         if not available bfrom_wth-parts then return error
     2486           substitute('Не найдена партия (recid &1)', p-rec).
     2487         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2488            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2489            return error 'Нельзя увеличивать границы диапазона.'.
     2490         end.
     2491         empty temp-table tt-wthlib-parts.
     2492         create tt-wthlib-parts.
     2493         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2494         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2495                     INPUT     bfrom_wth-parts.obj-type,
     2496                     INPUT     bfrom_wth-parts.obj-code,
     2497                     INPUT     bfrom_wth-parts.w-p-code,
     2498                     INPUT     bfrom_wth-parts.wth-code,
     2499                     INPUT     bfrom_wth-parts.par-code,
     2500                     INPUT     bfrom_wth-parts.in-code ,
     2501                     INPUT     bfrom_wth-parts.doc-code,
     2502                     INPUT     bfrom_wth-parts.ser-code,
     2503                     INPUT     bfrom_wth-parts.db-num  ,
     2504                     INPUT     p-Fact-RangeFrom ,
     2505                     INPUT     p-fact-rangeTo  ,
     2506                     INPUT     p-Fact-RangeFrom ,
     2507                     INPUT     p-fact-rangeTo ,
     2508                     INPUT     bfrom_wth-parts.host-code     ,
     2509                     INPUT     bfrom_wth-parts.contract-code               ,
     2510                     INPUT     bfrom_wth-parts.price-rubl  ,
     2511                     INPUT     bfrom_wth-parts.price-base    ,
     2512                     INPUT     bfrom_wth-parts.supp-type,
     2513                     INPUT     bfrom_wth-parts.supp-code,
     2514                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2515                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2516                     INPUT     bfrom_wth-parts.ext-doc-type,
     2517                     INPUT     bfrom_wth-parts.gds-code,
     2518                     INPUT     0              ,
     2519                     INPUT     bfrom_wth-parts.beg-dt      ,
     2520                     INPUT     bfrom_wth-parts.end-dt      ,
     2521                     INPUT     bfrom_wth-parts.vat-pc      ,
     2522                     INPUT     bfrom_wth-parts.cli-code,
     2523                     INPUT     bfrom_wth-parts.cli-type,
     2524                     INPUT     bfrom_wth-parts.out-obj-code,
     2525                     INPUT     bfrom_wth-parts.out-obj-type,
     2526                     INPUT     bfrom_wth-parts.sale-obj-code,
     2527                     INPUT     bfrom_wth-parts.sale-obj-type,
     2528                     INPUT     bfrom_wth-parts.doc-code,
     2529                     INPUT     yes,
     2530                     INPUT     bfrom_wth-parts.type,
     2531                     INPUT-OUTPUT p-rec
     2532                     ) no-error.
     2533       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2534       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2535       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2536                     INPUT     tt-wthlib-parts.obj-type,
     2537                     INPUT     tt-wthlib-parts.obj-code,
     2538                     INPUT     tt-wthlib-parts.w-p-code,
     2539                     INPUT     tt-wthlib-parts.wth-code,
     2540                     INPUT     tt-wthlib-parts.par-code,
     2541                     INPUT     tt-wthlib-parts.in-code ,
     2542                     INPUT     tt-wthlib-parts.out-code,
     2543                     INPUT     tt-wthlib-parts.ser-code,
     2544                     INPUT     tt-wthlib-parts.db-num  ,
     2545                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2546                     INPUT     p-fact-rangeFrom - 1  ,
     2547                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2548                     INPUT     p-fact-rangeFrom - 1,
     2549                     INPUT     tt-wthlib-parts.host-code     ,
     2550                     INPUT     tt-wthlib-parts.contract-code               ,
     2551                     INPUT     tt-wthlib-parts.price-rubl    ,
     2552                     INPUT     tt-wthlib-parts.price-base    ,
     2553                     INPUT     tt-wthlib-parts.supp-type,
     2554                     INPUT     tt-wthlib-parts.supp-code,
     2555                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2556                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2557                     INPUT     tt-wthlib-parts.ext-doc-type,
     2558                     INPUT     tt-wthlib-parts.gds-code,
     2559                     INPUT     1             ,
     2560                     INPUT     tt-wthlib-parts.beg-dt        ,
     2561                     INPUT     tt-wthlib-parts.end-dt        ,
     2562                     INPUT     tt-wthlib-parts.vat-pc        ,
     2563                     INPUT     tt-wthlib-parts.cli-code,
     2564                     INPUT     tt-wthlib-parts.cli-type,
     2565                     INPUT     tt-wthlib-parts.out-obj-code,
     2566                     INPUT     tt-wthlib-parts.out-obj-type,
     2567                     INPUT     tt-wthlib-parts.sale-obj-code,
     2568                     INPUT     tt-wthlib-parts.sale-obj-type,
     2569                     INPUT     tt-wthlib-parts.doc-code,
     2570                     INPUT  yes,
     2571                     INPUT    tt-wthlib-parts.type,
     2572                     INPUT-OUTPUT v-recDop
     2573                     ) no-error.
     2574       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2575       end.
     2576       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2577               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2578                     INPUT     tt-wthlib-parts.obj-type,
     2579                     INPUT     tt-wthlib-parts.obj-code,
     2580                     INPUT     tt-wthlib-parts.w-p-code,
     2581                     INPUT     tt-wthlib-parts.wth-code,
     2582                     INPUT     tt-wthlib-parts.par-code,
     2583                     INPUT     tt-wthlib-parts.in-code ,
     2584                     INPUT     tt-wthlib-parts.out-code,
     2585                     INPUT     tt-wthlib-parts.ser-code,
     2586                     INPUT     tt-wthlib-parts.db-num  ,
     2587                     INPUT     p-fact-rangeTo + 1 ,
     2588                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2589                     INPUT     p-fact-rangeTo + 1 ,
     2590                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2591                     INPUT     tt-wthlib-parts.host-code     ,
     2592                     INPUT     tt-wthlib-parts.contract-code               ,
     2593                     INPUT     tt-wthlib-parts.price-rubl    ,
     2594                     INPUT     tt-wthlib-parts.price-base    ,
     2595                     INPUT     tt-wthlib-parts.supp-type,
     2596                     INPUT     tt-wthlib-parts.supp-code,
     2597                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2598                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2599                     INPUT     tt-wthlib-parts.ext-doc-type,
     2600                     INPUT     tt-wthlib-parts.gds-code,
     2601                     INPUT     1             ,
     2602                     INPUT     tt-wthlib-parts.beg-dt        ,
     2603                     INPUT     tt-wthlib-parts.end-dt        ,
     2604                     INPUT     tt-wthlib-parts.vat-pc        ,
     2605                     INPUT     tt-wthlib-parts.cli-code,
     2606                     INPUT     tt-wthlib-parts.cli-type,
     2607                     INPUT     tt-wthlib-parts.out-obj-code,
     2608                     INPUT     tt-wthlib-parts.out-obj-type,
     2609                     INPUT     tt-wthlib-parts.sale-obj-code,
     2610                     INPUT     tt-wthlib-parts.sale-obj-type,
     2611                     INPUT     tt-wthlib-parts.doc-code,
     2612                     INPUT     yes,
     2613                     INPUT     tt-wthlib-parts.type,
     2614                     INPUT-OUTPUT v-recDop
     2615                     ) no-error.
     2616         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2617         end.
     2618     end.
     2619   end procedure.
     2620   PROCEDURE INIT_prtdate:
     2621       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2622       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2623       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2624       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2625       define input parameter        p-date                AS DATE no-undo .
     2626       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2627       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2628       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2629       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2630       define variable v-value-character as character no-undo .
     2631       define variable v-value-date as date no-undo .
     2632       define variable v-value-decimal as decimal no-undo .
     2633       define variable v-value-integer as INTEGER no-undo .
     2634       define variable v-value-logical AS LOGICAL no-undo .
     2635       define variable v-param-type as character no-undo .
     2636       FIND FIRST buf_wth-ser NO-LOCK
     2637           WHERE buf_wth-ser.ser-code = p-ser-code
     2638           AND buf_wth-ser.db-num = p-db-num.
     2639       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2640           p-beg-dt = buf_wth-ser.beg-dt.
     2641       END.
     2642       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2643           p-end-dt = buf_wth-ser.end-dt.
     2644       END.
     2645       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2646           run adm/shattri.p (
     2647               input "get":U
     2648               ,input  p-obj-type
     2649               ,input  p-obj-code
     2650               ,input  'wthdoc_obj':U
     2651               ,input  'rangerule':U
     2652               ,output v-value-character
     2653               ,output v-value-date
     2654               ,output v-value-decimal
     2655               ,output v-value-integer
     2656               ,output v-value-logical
     2657               ,output v-param-type
     2658               ,INPUT-OUTPUT table-handle v-tth
     2659               ) no-error .
     2660           IF not error-status:error  then do:
     2661               v-rangeRule =  v-value-integer.
     2662           END.
     2663           CASE v-rangeRule:
     2664           WHEN 1 THEN DO:
     2665               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2666                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2667               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2668                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2669               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2670                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2671           END.
     2672           when 2 then do:
     2673             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2674                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2675             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2676                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2677                        .
     2678           end.
     2679           WHEN 3 THEN DO:
     2680               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2681                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2682               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2683                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2684               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2685                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2686               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2687                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2688           END.
     2689           when 4 then do:
     2690                p-beg-dt = p-date.
     2691                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2692           end.
     2693           END CASE.
     2694       END.
     2695   END.
     2696   PROCEDURE INIT_prtprice:
     2697   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2698   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2699   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2700   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2701   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2702   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2703   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2704   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2705   define input parameter        p-date                AS DATE no-undo .
     2706   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2707   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2708   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2709   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2710   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2711   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2712   define variable p-plt-id AS INT no-undo.
     2713   define variable  p-plt-db-num   AS INT no-undo.
     2714   define variable  p-pdf-id  AS INT no-undo.
     2715   define variable  p-pdf-db-num AS INT no-undo.
     2716   define variable  p-sale-price-base AS DEC no-undo.
     2717   define variable  p-sale-price-rubl AS DEC no-undo.
     2718   define variable  p-road-tax-base AS DEC no-undo.
     2719   define variable  p-road-tax-rubl AS DEC no-undo.
     2720   define variable  p-excise-base AS DEC no-undo.
     2721   define variable  p-excise-rubl AS DEC no-undo.
     2722   define variable  p-fact-order  AS DEC no-undo.
     2723   do on error undo, return error return-value :
     2724     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2725                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2726     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2727     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2728     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2729     ELSE v-cash-type-pay = ?.
     2730     run fact-order-mpl (
     2731         INPUT p-date ,
     2732         INPUT p-obj-type ,
     2733         INPUT p-obj-code ,
     2734         OUTPUT p-fact-order
     2735         ) no-error .
     2736     if error-status:error then do:
     2737       message   return-value skip error-status:get-message(1)
     2738       skip  'Получение цены из множественного прайс-листа отклонено.'
     2739       view-as alert-box.
     2740       return.
     2741     end.
     2742   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2744     (input  p-gds-code
     2745     ,input  '1':U
     2746     ,input  ?
     2747     ,input  p-host-code
     2748     ,input  p-obj-type
     2749     ,input  p-obj-code
     2750     ,output p-vat-pc
     2751     ) no-error .
     2752     run mpl-autoprice in this-procedure
     2753       ( input    false
     2754         ,input   p-cli-type
     2755         ,input   p-cli-code
     2756         ,input   p-gds-code
     2757         ,input   p-gds-code
     2758         ,input   p-obj-type
     2759         ,input   p-obj-code
     2760         ,input   0
     2761         ,input   0
     2762         ,input   ""
     2763         ,input   v-cash-type-pay
     2764         ,input   p-fact-order
     2765         ,output  p-plt-id
     2766         ,output  p-plt-db-num
     2767         ,output  p-pdf-id
     2768         ,output  p-pdf-db-num
     2769         ,output  p-sale-price-base
     2770         ,output  p-sale-price-rubl
     2771         ,output  p-road-tax-base
     2772         ,output  p-road-tax-rubl
     2773         ,output  p-excise-base
     2774         ,output  p-excise-rubl
     2775         ) no-error .
     2776     if error-status:error then do:
     2777       message   return-value skip error-status:get-message(1) view-as alert-box.
     2778       return.
     2779     end.
     2780     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2781     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2782   end.
     2783   END.
     2784   procedure  set-wthmpl-date:
     2785   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2786   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2787   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2788   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2789   define variable v-atrValue      as character no-undo .
     2790   define variable v-atrDsf      as CHARACTER no-undo .
     2791   define variable v-atrType     as character no-undo .
     2792   do on error undo, return error return-value :
     2793   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2794                           input 'wthdsf':U ,
     2795                          output v-atrValue ,
     2796                          output v-atrType )  .
     2797     p-date = date(v-atrValue) no-error.
     2798     if p-date = ? then p-date = p-beg-dt no-error.
     2799     if p-date = ? then p-date = p-doc-date.
     2800   end.
     2801   end procedure.
     2802   define buffer buf_wth-doc      for wth-doc.
     2803   define buffer buf_wth-parts   for wth-parts.
     2804   def var v-rec as recid.
     2805   tr:
     2806   do transaction
     2807   on error undo tr,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2808   on stop  undo tr,  return error substitute( "&1. stop", vss-workfile )
     2809   on quit  undo tr,  return error substitute( "&1. endkey", vss-workfile )
     2810   :
     2811     find first buf_wth-doc where recid(buf_wth-doc) = parrec_wth-doc no-error.
     2812     if not available buf_wth-doc then do:
     2813       return error
     2814       "Неправильные входные параметры файла stwthpt.p. Указан record id документа материальных ценностей: " +
     2815       string(parrec_wth-doc).
     2816     end.
     2817     for each buf_wth-parts where buf_wth-parts.out-code = buf_wth-doc.doc-code exclusive-lock
     2818     :
     2819       run wth-doc-close(input recid(buf_wth-parts) ) no-error.
     2820       if error-status:error then undo tr, return error return-value + error-status:get-message(1).
     2821     end.
     2822   end.
