     1216   define variable v-cash-pay-code as integer   no-undo .
     1217   do
     1218   on error undo, return error return-value
     1219   :
     1220   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1221   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1222   if p-fact-order = ? then do:
     1223     run fact-order-mpl (
     1224         input   today       ,
     1225         input   p-obj-type  ,
     1226         input   p-obj-code  ,
     1227         output  p-fact-order ).
     1228   end.
     1229   if p-vid-pay <> "" then do:
     1230      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1231      if available buf_pay-type
     1232         then v-trn-pay-code = buf_pay-type.obj-code.
     1233         else v-trn-pay-code =  0.
     1234   end.
     1235   else v-trn-pay-code = 0 .
     1236   if p-cash-pay-type <> "" then do:
     1237      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1238      if available buf_pay-type
     1239         then
     1240           assign
     1241             v-cash-pay-curr = buf_cash-pay.curr-code
     1242             v-cash-pay-code = buf_cash-pay.cdpay-code
     1243           .
     1244         else
     1245           assign
     1246             v-cash-pay-curr = 0
     1247             v-cash-pay-code = 0
     1248             .
     1249   end.
     1250   else
     1251     assign
     1252       v-cash-pay-curr = 0
     1253       v-cash-pay-code = 0
     1254       .
     1255   for each tt_price-all  : delete tt_price-all . end.
     1256   assign
     1257     p-plt-id             = ?
     1258     p-plt-db-num         = ?
     1259     p-pdf-id             = ?
     1260     p-pdf-db-num         = ?
     1261     p-sale-price-base    = ?
     1262     p-sale-price-rubl    = ?
     1263     v-cli-oborot         = 0
