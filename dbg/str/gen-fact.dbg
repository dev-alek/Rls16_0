        1   def var vss-revision    as character no-undo init "$Revision$":U .
        2   def var vss-author      as character no-undo init "$Author$":U .
        3   def var vss-date        as character no-undo init "$Date$":U .
        4   def var vss-workfile    as character no-undo init "$Workfile$":U .
        5   def var vss-archive     as character no-undo init "$Archive$":U .
        6   def var vss-description as character no-undo init "Генерация счетов-фактур".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   procedure proc-alt-shift-f2:
       62     if not ibs.th.gbl.gbl-var:rcode
       63   then
       64     run gbl\inidebug.p .
       65   end.
       66   procedure proc-alt-shift-f3:
       67     run gbl/prvssinf.p
       68       ( input this-procedure
       69       ) .
       70   end.
       71   define variable v-inform-launched as logical no-undo initial false .
       72   procedure proc-alt-shift-f4:
       73     define variable v-action as character no-undo .
       74     if v-inform-launched = false then do:
       75       assign
       76         v-inform-launched = true
       77       .
       78       run gbl/d-inform.w
       79         (  input self
       80         ,  input this-procedure
       81         , output v-action
       82         ) no-error .
       83       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       84       assign
       85         v-inform-launched = false
       86       .
       87     end.
       88   end.
       89   procedure proc-alt-f1:
       90     run gbl/corrhelp.p
       91       (input this-procedure
       92       ) .
       93   end .
       94   on alt-shift-f2 anywhere do:
       95     run proc-alt-shift-f2.
       96   end.
       97   on alt-shift-f3 anywhere do:
       98     run proc-alt-shift-f3 in this-procedure .
       99   end.
      100   on alt-shift-f4 anywhere do:
      101     run proc-alt-shift-f4 in this-procedure.
      102   end.
      103   on alt-f1 anywhere do:
      104     run proc-alt-f1 in this-procedure .
      105   end.
      106   define new global shared variable g#language as character no-undo .
      107   if g#language <> '' and g#language <> 'rus':U then do:
      108     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure cur-time :
      112      define output parameter p-today as date      no-undo .
      113      define output parameter p-time  as integer   no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       define variable v-date1 as date      no-undo .
      118       define variable v-date2 as date      no-undo .
      119       define variable v-time  as integer   no-undo .
      120       assign
      121         v-date1 = today
      122         v-time  = time
      123         v-date2 = today
      124       .
      125       if v-date1 <> v-date2
      126       then do:
      127         assign
      128           v-date1 = today
      129           v-time  = v-time
      130         .
      131       end.
      132       assign
      133         p-today = v-date1
      134         p-time  = v-time
      135       .
      136     end.
      137   end.
      138   function cur-time-date returns character
      139   :
      140     return string(today, '99/99/9999':U) .
      141   end.
      142   function cur-time-mjd returns decimal
      143   :
      144     define variable v-date as date      no-undo .
      145     define variable v-time as integer   no-undo .
      146     run cur-time in this-procedure
      147       (output v-date
      148       ,output v-time
      149       ) .
      150     return integer(v-date) - 2400002 + (v-time / 86400) .
      151   end.
      152   function cur-time-get-ending-index returns integer
      153   (input p-number as integer
      154   )
      155   :
      156     if p-number < 0
      157     or p-number = ?
      158     then do:
      159       return 1 .
      160     end.
      161     define variable v-rest as integer   no-undo .
      162     assign
      163       p-number = p-number modulo 100
      164     .
      165     if p-number < 20
      166     then do:
      167       assign
      168         v-rest = p-number
      169       .
      170     end.
      171     else do:
      172       assign
      173         v-rest = p-number modulo 10
      174       .
      175     end.
      176     case v-rest :
      177       when 1
      178       then do:
      179         return 2 .
      180       end.
      181       when 2 or
      182       when 3 or
      183       when 4
      184       then do:
      185         return 3 .
      186       end.
      187       otherwise do:
      188         return 1 .
      189       end.
      190     end case .
      191   end.
      192   procedure cur-time-mjd-to-date :
      193      define input  parameter i-mjd-diff as decimal no-undo.
      194      define output parameter o-Date     as date    no-undo.
      195      define output parameter o-Time     as integer no-undo.
      196      define variable v-day-number as integer   no-undo .
      197      if    i-mjd-diff < 0
      198         or i-mjd-diff = ?
      199      then do:
      200         return "?" .
      201      end.
      202      assign
      203         v-day-number = truncate(i-mjd-diff,0).
      204         o-Date = date(v-day-number + 2400002).
      205         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207   end.
      208   function cur-time-mjd-to-string returns character
      209   (input p-mjd-diff as decimal
      210   )
      211   :
      212     define variable v-day-number as integer   no-undo .
      213     define variable v-seconds    as integer   no-undo .
      214     define variable v-hour       as integer   no-undo .
      215     define variable v-min        as integer   no-undo .
      216     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      217     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      218     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      219     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      220     if p-mjd-diff < 0
      221     or p-mjd-diff = ?
      222     then do:
      223       return "?" .
      224     end.
      225     assign
      226       v-day-number = integer(truncate(p-mjd-diff,0))
      227       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229     if v-seconds > 86400
      230     then do:
      231       assign
      232         v-seconds = 86400 - 1
      233       .
      234     end.
      235     if v-seconds < 0
      236     then do:
      237       assign
      238         v-seconds = 0
      239       .
      240     end.
      241     assign
      242       v-hour = truncate(v-seconds / 3600, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 3600
      246     .
      247     assign
      248       v-min = truncate(v-seconds / 60, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 60
      252     .
      253     return
      254         (if v-day-number <> 0
      255           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0
      259           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      263           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      264           else ""
      265         )
      266       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      267       .
      268   end.
      269   function cur-time-string returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-string-sec returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      288   end.
      289   function cur-time-custom  returns character
      290   (input p-prefix as character
      291   ,input p-date-format as character
      292   ,input p-delimiter as character
      293   ,input p-time-format as character
      294   ,input p-suffix as character
      295   )
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return
      304       p-prefix
      305       + string(v-date, p-date-format)
      306       + p-delimiter
      307       + string(v-time, p-time-format)
      308       + p-suffix
      309       .
      310   end.
      311   function cur-time-print  returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-datetime returns datetime
      322   :
      323     define variable v-char as character no-undo .
      324     define variable v-datetime as datetime no-undo .
      325     v-char = cur-time-string().
      326     v-datetime = datetime(v-char).
      327     return  v-datetime.
      328   end.
      329   function cur-time-string-msec returns character
      330   :
      331     define variable v-date as datetime  no-undo .
      332     v-date = now.
      333     return string(v-date) .
      334   end.
      335   define new global shared variable g#library  as handle no-undo .
      336   define new global shared variable g#library2 as handle no-undo .
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   procedure factord :
      339     define input  parameter p-fact-date            as date    no-undo .
      340     define input  parameter p-fact-time            as integer no-undo .
      341     define input  parameter p-fact-num             as integer no-undo .
      342     define input  parameter p-shift-date           as date    no-undo .
      343     define input  parameter p-shift-num            as integer no-undo .
      344     define input  parameter p-shift-on             as logical no-undo .
      345     define output parameter p-fact-order           as decimal no-undo .
      346     define output parameter p-shift-end-fact-order as decimal no-undo .
      347     define output parameter p-day-end-fact-order   as decimal no-undo .
      348     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      349     if p-fact-date = ?
      350     then do:
      351       return error "Не указана фактическая дата" .
      352     end.
      353     define variable v-fact-date-num as integer no-undo .
      354     assign
      355       v-fact-date-num = integer(p-fact-date)
      356     .
      357     if p-fact-num = ?
      358     or p-fact-num = 0
      359     then do:
      360       return error "Не задан p-fact-num " + string(p-fact-num) .
      361     end.
      362     if p-fact-num < 0
      363     then do:
      364       return error "Отрицательный fact-num " + string(p-fact-num) .
      365     end.
      366     if p-fact-num >= 100000000
      367     then do:
      368       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      369     end.
      370     if p-shift-on = true
      371     then do:
      372       if p-shift-date = ?
      373       then do:
      374         return error "Не задана дата смены" .
      375       end.
      376       if p-shift-num = ?
      377       or p-shift-num = 0
      378       then do:
      379         return error "Не задан номер смены" .
      380       end.
      381     end.
      382     else do:
      383       assign
      384         p-shift-date = p-fact-date
      385         p-shift-num  = 24
      386       .
      387     end.
      388     define variable v-shift-offset as integer no-undo .
      389     if p-shift-date = p-fact-date
      390     then do:
      391       assign
      392         v-shift-offset = 1
      393       .
      394     end.
      395     if p-shift-date < p-fact-date
      396     then do:
      397       assign
      398         v-shift-offset = 0
      399       .
      400     end.
      401     if p-shift-date > p-fact-date
      402     then do:
      403       message
      404         vss-workfile vss-revision vss-description skip
      405         "Неправильная дата закрытия смены" skip
      406         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      407         view-as alert-box error .
      408       undo, return error
      409         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      410           ,string(p-fact-date, '99/99/9999':U)
      411           ,string(p-shift-date, '99/99/9999':U)
      412           )
      413       .
      414     end.
      415     if p-shift-num < 1
      416     or p-shift-num > 24
      417     then do:
      418       message
      419         vss-workfile vss-revision vss-description skip
      420         "Неправильный номер смены" skip
      421         "p-shift-num" p-shift-num skip
      422         view-as alert-box error .
      423       undo, return error return-value .
      424     end.
      425     assign
      426       p-fact-order           = v-fact-date-num
      427                              + v-shift-offset * 0.5
      428                              + p-shift-num    * 0.02 - 0.01
      429                              + p-fact-num     * 0.0000000001
      430       p-shift-end-fact-order = v-fact-date-num
      431                              + v-shift-offset * 0.5
      432                              + p-shift-num    * 0.02
      433       p-day-end-fact-order   = v-fact-date-num
      434                              + 0.99
      435     .
      436     if p-fact-order           <= v-fact-date-num
      437     or p-shift-end-fact-order <= v-fact-date-num
      438     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      439     or p-shift-end-fact-order >= p-day-end-fact-order
      440     then do:
      441       message
      442         vss-workfile vss-revision vss-description skip
      443         "Внутренняя ошибка при генерации фактического номера" skip
      444         "p-fact-date"            p-fact-date            skip
      445         "p-fact-time"            p-fact-time            skip
      446         "p-fact-num"             p-fact-num             skip
      447         "p-shift-date"           p-shift-date           skip
      448         "p-shift-num"            p-shift-num            skip
      449         "p-shift-on"             p-shift-on             skip
      450         "p-shift-end-fact-order" p-shift-end-fact-order skip
      451         "p-day-end-fact-order"   p-day-end-fact-order   skip
      452         "v-fact-date-num"        v-fact-date-num        skip
      453         view-as alert-box error .
      454       undo, return error return-value .
      455     end.
      456   end procedure.
      457   procedure day-begin-fact-order :
      458     define input  parameter p-fact-date            as date    no-undo .
      459     define output parameter p-day-begin-fact-order as decimal no-undo .
      460     do
      461     on error undo, return error return-value
      462     :
      463       if p-fact-date = ?
      464       then do:
      465         assign
      466           p-day-begin-fact-order = 0
      467         .
      468       end.
      469       else do:
      470         assign
      471           p-day-begin-fact-order = integer(p-fact-date)
      472         .
      473       end.
      474     end.
      475   end procedure.
      476   procedure factord-max-fact-order :
      477     define output parameter p-max-fact-order as decimal   no-undo .
      478     do
      479     on error undo, return error return-value
      480     :
      481       run day-begin-fact-order in this-procedure
      482         (input  date(1, 1, 5000)
      483         ,output p-max-fact-order
      484         ) .
      485     end.
      486   end procedure.
      487   procedure factord-cut-archive :
      488     define input  parameter p-obj-type             as character no-undo .
      489     define input  parameter p-obj-code             as integer   no-undo .
      490     define input  parameter p-fact-date            as date      no-undo .
      491     define output parameter p-shift-on             as logical   no-undo .
      492     define output parameter p-shift-date           as date      no-undo .
      493     define output parameter p-shift-num            as integer   no-undo .
      494     define output parameter p-day-end-fact-order   as decimal   no-undo .
      495     define output parameter p-shift-end-fact-order as decimal   no-undo .
      496     define variable v-fact-order as decimal   no-undo .
      497     define buffer buf_shift-obj for ub.shift-obj .
      498     do
      499     on error undo, return error return-value
      500     :
      501   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      503     (input  p-obj-type
      504     ,input  p-obj-code
      505     ,input  'shift-on=request'
      506     ,output p-shift-on
      507     ) no-error .
      508       if error-status :error
      509       then do:
      510         message
      511           vss-workfile vss-revision vss-description skip
      512           "Ошибка при определении атрибута объекта" skip
      513           "Объект" p-obj-type p-obj-code skip
      514           error-status :get-message(1) skip
      515           return-value skip
      516           view-as alert-box error .
      517         undo, return error return-value .
      518       end.
      519       if p-shift-on = false
      520       then do:
      521         assign
      522           p-shift-date               = ?
      523           p-shift-num                = 0
      524         .
      525       end.
      526       else do:
      527         find first buf_shift-obj share-lock
      528           where buf_shift-obj.obj-type   = p-obj-type
      529             and buf_shift-obj.obj-code   = p-obj-code
      530             and buf_shift-obj.shift-date > p-fact-date
      531           use-index pi
      532           no-error .
      533         if not available buf_shift-obj
      534         or buf_shift-obj.status_ <> 'зкр':U
      535         then do:
      536           message
      537             vss-workfile vss-revision vss-description skip
      538             "Невозможно вычислить последнюю смену" skip
      539             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      540             "Объект" p-obj-type p-obj-code skip
      541             "Дата" p-fact-date skip
      542             view-as alert-box error .
      543           undo, return error return-value .
      544         end.
      545         find last buf_shift-obj share-lock
      546           where buf_shift-obj.obj-type = p-obj-type
      547             and buf_shift-obj.obj-code = p-obj-code
      548             and buf_shift-obj.shift-date <= p-fact-date
      549           use-index pi
      550           no-error .
      551         if available buf_shift-obj
      552         then do:
      553           if  buf_shift-obj.status_ = 'зкр':U
      554           then do:
      555             assign
      556               p-shift-date = buf_shift-obj.shift-date
      557               p-shift-num  = buf_shift-obj.shift-num
      558             .
      559           end.
      560           else do:
      561             message
      562               vss-workfile vss-revision vss-description skip
      563               "Невозможно вычислить последнюю смену" skip
      564               "Статус смены отличен от статуса" 'зкр':U skip
      565               "Объект" p-obj-type p-obj-code skip
      566               "Дата" p-fact-date skip
      567               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      568               view-as alert-box error .
      569             undo, return error return-value .
      570           end.
      571         end.
      572         else do:
      573           assign
      574             p-shift-date = p-fact-date - 1
      575             p-shift-num  = 1
      576           .
      577         end.
      578       end.
      579       run factord in this-procedure
      580         (input  p-fact-date
      581         ,input  1
      582         ,input  1
      583         ,input  p-shift-date
      584         ,input  p-shift-num
      585         ,input  p-shift-on
      586         ,output v-fact-order
      587         ,output p-shift-end-fact-order
      588         ,output p-day-end-fact-order
      589         ) no-error .
      590       if error-status :error
      591       then do:
      592         message
      593           vss-workfile vss-revision vss-description skip
      594           "Ошибка при вызове процедуры factord"
      595           error-status :get-message(1) skip
      596           return-value skip
      597           view-as alert-box error .
      598         undo, return error return-value .
      599       end.
      600     end.
      601   end procedure.
      602   procedure factord-lock-shift :
      603     define input  parameter p-obj-type  as character no-undo .
      604     define input  parameter p-obj-code  as integer   no-undo .
      605     define input  parameter p-fact-date as date      no-undo .
      606     define parameter buffer buf_shift-obj for ub.shift-obj .
      607     define variable v-shift-on      as logical   no-undo .
      608     define variable v-extra-message as character no-undo .
      609     define variable v-error as character no-undo .
      610     do
      611     on error undo, return error return-value
      612     :
      613   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      615     (input  p-obj-type
      616     ,input  p-obj-code
      617     ,input  'shift-on=request'
      618     ,output v-shift-on
      619     ) no-error .
      620       if error-status :error
      621       then do:
      622         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      623         undo, return error v-error .
      624       end.
      625       if v-shift-on = true
      626       then do:
      627         find first buf_shift-obj share-lock
      628           where buf_shift-obj.obj-type   = p-obj-type
      629             and buf_shift-obj.obj-code   = p-obj-code
      630             and buf_shift-obj.shift-date > p-fact-date
      631           use-index pi
      632           no-error .
      633         if not available buf_shift-obj
      634         or buf_shift-obj.status_ <> 'зкр':U
      635         then do:
      636           find last buf_shift-obj
      637             where buf_shift-obj.obj-type = p-obj-type
      638               and buf_shift-obj.obj-code = p-obj-code
      639               and buf_shift-obj.status_  = 'зкр':U
      640             use-index stts
      641             no-error .
      642           if available buf_shift-obj
      643           then do:
      644             assign
      645               v-extra-message =
      646                     substitute("Дата начала последеней закрытой смены на объекте &1"
      647                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      648                               )
      649             .
      650           end.
      651           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      652           undo, return error v-error .
      653         end.
      654       end.
      655     end.
      656   end procedure.
      657   procedure factord-end-day :
      658     define input  parameter p-fact-date            as date    no-undo .
      659     define output parameter p-day-end-fact-order   as decimal no-undo .
      660     do
      661     on error undo, return error return-value
      662     :
      663       if p-fact-date = ?
      664       then do:
      665         return error "Не указана фактическая дата" .
      666       end.
      667       assign
      668         p-day-end-fact-order = integer(p-fact-date) + 0.99
      669       .
      670     end.
      671   end procedure.
      672   procedure factord-to-date :
      673     define input  parameter p-fact-order as decimal no-undo .
      674     define output parameter p-fact-date  as date    no-undo .
      675     define variable v-ref-date  as date      no-undo .
      676     define variable v-ref-delta as integer   no-undo .
      677     do
      678     on error undo, return error return-value
      679     :
      680       if p-fact-order = ?
      681       or p-fact-order = 0
      682       then do:
      683         return error "Не указан fact-order" .
      684       end.
      685       assign
      686         v-ref-date  = date(1, 1, 2000)
      687       .
      688       assign
      689         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      690       .
      691       assign
      692         p-fact-date = v-ref-date + v-ref-delta
      693       .
      694     end.
      695   end procedure.
      696   procedure factord-to-fact-num :
      697     define input  parameter p-fact-order as decimal no-undo .
      698     define output parameter p-fact-num   as integer no-undo .
      699     define variable v-fact-order-trunc as decimal no-undo .
      700     do
      701     on error undo, return error return-value
      702     :
      703       if p-fact-order = ?
      704       or p-fact-order = 0
      705       then do:
      706         return error "Не указан fact-order" .
      707       end.
      708       assign
      709        v-fact-order-trunc = truncate(p-fact-order, 2)
      710       .
      711       assign
      712         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      713       .
      714     end.
      715   end procedure.
      716   procedure factord-to-shift-num :
      717     define input  parameter p-fact-order as decimal no-undo .
      718     define output parameter p-shift-num   as integer no-undo .
      719     define variable  p-shift-numd  as decimal   no-undo .
      720     define variable v-fact-order-trunc as decimal no-undo .
      721     do
      722     on error undo, return error return-value
      723     :
      724       if p-fact-order = ?
      725       or p-fact-order = 0
      726       then do:
      727         return error "Не указан fact-order" .
      728       end.
      729       assign
      730        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      731       .
      732       if v-fact-order-trunc < 0.5 then do:
      733         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      734       end.
      735       assign
      736         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      737         .
      738        assign
      739         p-shift-num = truncate (p-shift-numd , 0)
      740       .
      741     end.
      742   end procedure.
      743   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744     define variable v-cntxt-db-num        as integer   no-undo .
      745     define variable v-cntxt-userid        as character no-undo .
      746     define variable v-cntxt-level         as character no-undo .
      747     define variable v-cntxt-host-code-obj as integer   no-undo .
      748     define variable v-cntxt-obj-type      as character no-undo .
      749     define variable v-cntxt-obj-code      as integer   no-undo .
      750     define variable v-cntxt-db-num-obj    as integer   no-undo .
      751     define variable v-cntxt-is-admin      as logical   no-undo .
      752   define input parameter ParParentProc  as widget-handle no-undo.
      753   define input parameter par-host-code  like ub.clients.obj-code no-undo.
      754   define temp-table tt-trn no-undo like ub.trn-doc.
      755   define temp-table c-tt-trn no-undo like ub.c-trn-doc.
      756   define variable v-type-trn-doc as character no-undo .
      757   define temp-table temp-obj-firm no-undo
      758     field obj-code      as integer
      759     field obj-type      as char
      760   index pi is primary unique
      761   obj-code
      762   obj-type
      763   .
      764   DEFINE BUTTON b-exec
      765        LABEL "В&ыполнить"
      766        SIZE 14.5 BY 1.
      767   DEFINE BUTTON b-exit AUTO-END-KEY
      768        LABEL "&Выход"
      769        SIZE 10 BY 1.
      770   DEFINE BUTTON B-help DEFAULT
      771        LABEL "Помо&щь"
      772        SIZE 10 BY 1
      773        BGCOLOR 8 .
      774   DEFINE BUTTON i-exit
      775        IMAGE-UP FILE "cmp/i-run.bmp":U
      776        IMAGE-DOWN FILE "cmp/i-run.bmp":U
      777        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
      778        LABEL ""
      779        SIZE 2.5 BY .75.
      780   DEFINE VARIABLE res AS CHARACTER
      781        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      782        SIZE 70.38 BY 9.5 NO-UNDO.
      783   DEFINE VARIABLE date-end AS DATE FORMAT "99/99/9999":U
      784        VIEW-AS FILL-IN
      785        SIZE 11.38 BY 1 NO-UNDO.
      786   DEFINE VARIABLE FILL-IN-10 AS CHARACTER FORMAT "X(256)":U INITIAL "Обработать документы по :"
      787         VIEW-AS TEXT
      788        SIZE 26.25 BY 1
      789        FGCOLOR 4  NO-UNDO.
      790   DEFINE VARIABLE FILL-IN-11 AS CHARACTER FORMAT "X(256)":U INITIAL "Генерация по:"
      791         VIEW-AS TEXT
      792        SIZE 15.5 BY 1
      793        FGCOLOR 4  NO-UNDO.
      794   DEFINE VARIABLE FILL-IN-13 AS CHARACTER FORMAT "X(256)":U INITIAL "Дата Счета-фактуры:"
      795         VIEW-AS TEXT
      796        SIZE 20.5 BY 1 TOOLTIP "Дата док. для ФО"
      797        FGCOLOR 4  NO-UNDO.
      798   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      799        VIEW-AS RADIO-SET HORIZONTAL
      800        RADIO-BUTTONS
      801             "Сегодня", 1,
      802   "Дата по", 2
      803        SIZE 23 BY 1.21 TOOLTIP "Дата док. для ФО" NO-UNDO.
      804   DEFINE VARIABLE is-fin-doc AS LOGICAL INITIAL no
      805        LABEL "Платежам"
      806        VIEW-AS TOGGLE-BOX
      807        SIZE 26 BY .83 NO-UNDO.
      808   DEFINE VARIABLE is-fin-ob AS LOGICAL INITIAL no
      809        LABEL "Финансовым обязательствам"
      810        VIEW-AS TOGGLE-BOX
      811        SIZE 28.13 BY .83 NO-UNDO.
      812   DEFINE VARIABLE is-nakl-add-doc AS LOGICAL INITIAL no
      813        LABEL "Документ ДопРасх"
      814        VIEW-AS TOGGLE-BOX
      815        SIZE 37 BY .83 NO-UNDO.
      816   DEFINE VARIABLE is-nakl-pri AS LOGICAL INITIAL no
      817        LABEL "Приходным накладным"
      818        VIEW-AS TOGGLE-BOX
      819        SIZE 26 BY .83 NO-UNDO.
      820   DEFINE VARIABLE is-nakl-smena-type AS LOGICAL INITIAL no
      821        LABEL "Накладным смены типа приобретения"
      822        VIEW-AS TOGGLE-BOX
      823        SIZE 37 BY .83 NO-UNDO.
      824   DEFINE FRAME Dialog-Frame
      825        b-exit AT ROW 1 COL 1
      826        b-exec AT ROW 1 COL 11
      827        i-exit AT ROW 1.13 COL 11.13 WIDGET-ID 2
      828        B-help AT ROW 1 COL 61.63
      829        is-nakl-pri AT ROW 3.33 COL 33.38
      830        date-end AT ROW 3.42 COL 3.5 COLON-ALIGNED NO-LABEL
      831        is-nakl-smena-type AT ROW 4.08 COL 33.38
      832        is-fin-ob AT ROW 5.63 COL 33.38
      833        is-fin-doc AT ROW 6.33 COL 33.38
      834        RADIO-SET-1 AT ROW 9.75 COL 38 NO-LABEL
      835        res AT ROW 7.25 COL 1.13 NO-LABEL
      836        FILL-IN-10 AT ROW 2.29 COL 2 NO-LABEL
      837        FILL-IN-11 AT ROW 2.29 COL 32.38 NO-LABEL
      838        FILL-IN-13 AT ROW 7.75 COL 37.5 NO-LABEL
      839        is-nakl-add-doc AT ROW 4.83 COL 33.38 WIDGET-ID 4
      840        SPACE(1.25) SKIP(11.12)
      841       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      842            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      843            TITLE "Генерация счетов-фактур"
      844            CANCEL-BUTTON b-exit.
      845   ASSIGN
      846          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      847          FRAME Dialog-Frame:HIDDEN           = TRUE.
      848   ASSIGN
      849          FILL-IN-13:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      850   ASSIGN
      851          RADIO-SET-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      852   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      853   DO:
      854     APPLY "END-ERROR":U TO SELF.
      855   END.
      856   ON CHOOSE OF b-exec IN FRAME Dialog-Frame
      857   DO:
      858     assign date-end is-nakl-pri is-nakl-smena-type is-fin-ob is-fin-doc  is-nakl-add-doc .
      859     define buffer buf_trn-doc for ub.trn-doc .
      860     define buffer buf_add-doc for ub.add-doc .
      861     define buffer buf_fin-doc for ub.fin-doc .
      862     define buffer buf_fin-ob  for ub.fin-ob .
      863     define variable v-calc as integer no-undo .
      864     define variable v-fact-order-end     as decimal   no-undo .
      865     define variable v-list as character no-undo .
      866     run day-begin-fact-order in this-procedure ( input ( date-end + 1 ),   output v-fact-order-end ).
      867     assign
      868       res = ""
      869       v-calc = 0
      870     .
      871     define buffer buf_sysconf for ub.sysconf .
      872     find first buf_sysconf no-lock where buf_sysconf.host-code = v-cntxt-host-code-obj .
      873     if buf_sysconf.gen-s-f-office then do:
      874       if v-cntxt-db-num <> 0 then do:
      875          message  "Генерация счетов-фактур на текущей фирме разрешена только в офисе!" view-as alert-box.
      876          return no-apply .
      877       end.
      878     end.
      879     if is-nakl-pri or is-nakl-smena-type or is-nakl-add-doc then run make-temp-obj-firm.
      880     if is-nakl-pri then do:
      881       assign res = res + "Генерация по приходным накладным " + chr(10) .
      882       display res  with frame Dialog-Frame .
      883       for each temp-obj-firm :
      884         find first ub.clients no-lock
      885           where ub.clients.obj-type = temp-obj-firm.obj-type
      886             and ub.clients.obj-code = temp-obj-firm.obj-code
      887         no-error .
      888         if buf_sysconf.gen-s-f-office = no and v-cntxt-db-num <> ub.clients.db-num then next .
      889         for each buf_trn-doc no-lock where
      890           buf_trn-doc.obj-type     = temp-obj-firm.obj-type and
      891           buf_trn-doc.obj-code     = temp-obj-firm.obj-code and
      892           buf_trn-doc.status_      = 'факт':U                and
      893           buf_trn-doc.fact-date   <= date-end               and
      894           buf_trn-doc.host-code    = par-host-code          and
      895           buf_trn-doc.need-factur  = 1                      and
      896           buf_trn-doc.cr-factur    = false                  and
      897           buf_trn-doc.ext-doc-type = 'ie':U
      898         :
      899           assign v-calc = v-calc + 1 .
      900           assign res = res + string(v-calc) + ". накладная " + buf_trn-doc.doc-code + chr(10) .
      901           display res  with frame Dialog-Frame .
      902           run str/gen-scf.p ( input parParentProc, input recid (buf_trn-doc), "trn-doc", output v-list) no-error .
      903           if error-status:error then do:
      904             assign res = res + "Ошибка создания счета-фактуры по накладной " + buf_trn-doc.doc-code + chr(10) .
      905             display res  with frame Dialog-Frame .
      906           end.
      907           else do:
      908             assign res = res + v-list .
      909             display res  with frame Dialog-Frame .
      910           end.
      911         end.
      912       end.
      913       assign res = res + "Всего обработано " + string(v-calc) + " накладных" + chr(10) .
      914       display res  with frame Dialog-Frame .
      915     end.
      916     assign v-calc = 0 .
      917     if is-nakl-add-doc then do:
      918       assign res = res + "Генерация по документам ДопРасх " + chr(10) .
      919       display res  with frame Dialog-Frame .
      920       for each temp-obj-firm :
      921         find first ub.clients no-lock
      922           where ub.clients.obj-type = temp-obj-firm.obj-type
      923             and ub.clients.obj-code = temp-obj-firm.obj-code
      924         no-error .
      925         if buf_sysconf.gen-s-f-office = no and v-cntxt-db-num <> ub.clients.db-num then next .
      926         for each buf_add-doc no-lock where
      927           buf_add-doc.obj-type     = temp-obj-firm.obj-type and
      928           buf_add-doc.obj-code     = temp-obj-firm.obj-code and
      929           buf_add-doc.status_      = 'факт':U                and
      930           buf_add-doc.fact-date   <= date-end               and
      931           buf_add-doc.host-code    = par-host-code          and
      932           buf_add-doc.need-factur  = 1                      and
      933           buf_add-doc.cr-factur    = false
      934         :
      935           assign v-calc = v-calc + 1 .
      936           assign res = res + string(v-calc) + ". ДопРасх " + buf_add-doc.doc-code + chr(10) .
      937           display res  with frame Dialog-Frame .
      938           run str/gen-scf.p ( input parParentProc, input recid (buf_add-doc), "add-doc", output v-list) no-error .
      939           if error-status:error then do:
      940             assign res = res + "Ошибка создания счета-фактуры по ДопРасх " + buf_add-doc.doc-code + " " + return-value + chr(10) .
      941             display res  with frame Dialog-Frame .
      942           end.
      943           else do:
      944             assign res = res + v-list .
      945             display res  with frame Dialog-Frame .
      946           end.
      947         end.
      948       end.
      949       assign res = res + "Всего обработано " + string(v-calc) + " ДопРасх." + chr(10) .
      950       display res  with frame Dialog-Frame .
      951     end.
      952     assign v-calc = 0 .
      953     if is-nakl-smena-type then do:
      954       assign res = res + "Генерация по накладным смены типа приобретения" + chr(10) .
      955       display res  with frame Dialog-Frame .
      956       for each temp-obj-firm :
      957         find first ub.clients no-lock
      958           where ub.clients.obj-type = temp-obj-firm.obj-type
      959             and ub.clients.obj-code = temp-obj-firm.obj-code
      960         no-error .
      961         if buf_sysconf.gen-s-f-office = no and v-cntxt-db-num <> ub.clients.db-num then next .
      962         for each buf_trn-doc no-lock where
      963           buf_trn-doc.obj-type     = temp-obj-firm.obj-type and
      964           buf_trn-doc.obj-code     = temp-obj-firm.obj-code and
      965           buf_trn-doc.status_      = 'факт':U                and
      966           buf_trn-doc.fact-date   <= date-end               and
      967           buf_trn-doc.host-code    = par-host-code          and
      968           buf_trn-doc.need-factur  = 1                      and
      969           buf_trn-doc.cr-factur    = false                  and
      970           buf_trn-doc.ext-doc-type = 'pc':U
      971         :
      972           assign v-calc = v-calc + 1 .
      973           assign res = res + string(v-calc) + ". накладная " + buf_trn-doc.doc-code + chr(10) .
      974           display res  with frame Dialog-Frame .
      975           run str/gen-scf.p ( input parParentProc, input recid (buf_trn-doc), "trn-doc", output v-list) no-error .
      976           if error-status:error then do:
      977             assign res = res + "Ошибка создания счета-фактуры по накладной " + buf_trn-doc.doc-code + " " + return-value +  chr(10) .
      978             display res  with frame Dialog-Frame .
      979           end.
      980           else do:
      981             assign res = res + v-list .
      982             display res  with frame Dialog-Frame .
      983           end.
      984         end.
      985       end.
      986       assign res = res + "Всего обработано " + string(v-calc) + " накладных" + chr(10) .
      987       display res  with frame Dialog-Frame .
      988     end.
      989     assign v-calc = 0 .
      990     if is-fin-ob and v-cntxt-db-num = 0 then do:
      991       assign res = res + "Генерация по фин. обязательствам" + chr(10) .
      992       display res  with frame Dialog-Frame .
      993       for each buf_fin-ob no-lock where
      994           buf_fin-ob.host-code    = par-host-code          and
      995           buf_fin-ob.status_      = 'факт':U                and
      996           buf_fin-ob.fact-order   < v-fact-order-end       and
      997           buf_fin-ob.need-factur  = 1                      and
      998           buf_fin-ob.cr-factur    = false
      999       :
     1000         assign v-calc = v-calc + 1 .
     1001         assign res = res + string(v-calc) + ".  фин. обязательство " + string(buf_fin-ob.doc-code) + chr(10) .
     1002         display res  with frame Dialog-Frame .
     1003         run str/gen-scf.p ( input parParentProc, input recid (buf_fin-ob), "fin-ob", output v-list) no-error .
     1004         if error-status:error then do:
     1005           assign res = res + "Ошибка создания счета-фактуры по фин. обязательству " + string(buf_fin-ob.doc-code) + " " + return-value +  chr(10) .
     1006           display res  with frame Dialog-Frame .
     1007         end.
     1008         else do:
     1009           assign res = res + v-list .
     1010           display res  with frame Dialog-Frame .
     1011         end.
     1012       end.
     1013       assign res = res + "Всего обработано " + string(v-calc) + " фин. обязательств" + chr(10) .
     1014       display res  with frame Dialog-Frame .
     1015     end.
     1016     if is-fin-doc and v-cntxt-db-num = 0  then do:
     1017       assign res = res + "Генерация по платежам" + chr(10) .
     1018       display res  with frame Dialog-Frame .
     1019       for each buf_fin-doc no-lock where
     1020           buf_fin-doc.host-code    = par-host-code          and
     1021           buf_fin-doc.status_      = 'факт':U            and
     1022           buf_fin-doc.fact-order   < v-fact-order-end       and
     1023           buf_fin-doc.need-factur  = 1                      and
     1024           buf_fin-doc.cr-factur    = false
     1025       :
     1026         assign v-calc = v-calc + 1 .
     1027         assign res = res + string(v-calc) + ". Платеж " + string(buf_fin-doc.fin-doc-code) + chr(10) .
     1028         display res  with frame Dialog-Frame .
     1029         run str/gen-scf.p ( input parParentProc, input recid (buf_fin-doc), "fin-doc", output v-list) no-error .
     1030         if error-status:error then do:
     1031           assign res = res + "Ошибка создания счета-фактуры по фин. платежу " + string(buf_fin-doc.fin-doc-code)  + " " + return-value + chr(10) .
     1032           display res  with frame Dialog-Frame .
     1033         end.
     1034         else do:
     1035           assign res = res + v-list .
     1036           display res  with frame Dialog-Frame .
     1037         end.
     1038       end.
     1039       assign res = res + "Всего обработано " + string(v-calc) + " платежей" + chr(10) .
     1040       display res  with frame Dialog-Frame .
     1041     end.
     1042     assign res = res + "Генерация завершена " + string(today,"99/99/9999") + " за период " + string(date-end,"99/99/9999") + chr(10) .
     1043     display res  with frame Dialog-Frame .
     1044   END.
     1045   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1046   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1047   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   on help of frame Dialog-Frame
     1049   do:
     1050     run gbl/app_help.p
     1051       (input this-procedure :file-name
     1052       ,input ''
     1053       ,input ?
     1054       ) no-error.
     1055     if error-status :error then do:
     1056       message
     1057         "Ошибка при вызове помощи"
     1058         error-status :get-message(1)
     1059         view-as alert-box .
     1060     end.
     1061   end.
     1062   run minbtn-set in this-procedure .
     1063   on choose of b-help in frame Dialog-Frame
     1064   do:
     1065     apply "help":u to frame Dialog-Frame .
     1066   end.
     1067   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068   procedure minbtn-set :
     1069       do
     1070           on error undo, return error return-value
     1071           :
     1072           define variable ii              as integer       no-undo .
     1073           define variable fh              as widget-handle no-undo .
     1074           define variable hh              as widget-handle no-undo .
     1075           define variable v-h             as handle        extent 4 no-undo .
     1076           define variable v-name-button   as character     no-undo .
     1077           define variable v-help-old-x    as decimal       no-undo .
     1078           define variable v-help-old-y    as decimal       no-undo .
     1079           define variable v-help-old-size as decimal       no-undo .
     1080           define variable v-frame-width   as decimal       no-undo .
     1081           define variable jj              as integer       no-undo .
     1082           do
     1083               on error undo, return error
     1084               :
     1085               assign
     1086                   v-frame-width = frame Dialog-Frame:width - 0.3
     1087                   fh            = frame Dialog-Frame:first-child
     1088                   hh            = fh:first-child
     1089                   ii            = 1
     1090                   .
     1091               do while valid-handle(hh):
     1092                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1093                   do:
     1094                       case lc(hh:name) :
     1095                           when "b-help" then
     1096                               do:
     1097                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1098                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1099                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1100                                   hh:TOOLTIP = "Помощь" .
     1101                                   v-help-old-x = hh:column .
     1102                                   v-help-old-y = hh:row    .
     1103                                   v-help-old-size = hh:width .
     1104                                   hh:width-chars = 2.5 .
     1105                               end.
     1106                           when "b-print" then
     1107                               do:
     1108                                   hh:load-image("cmp/b-print.bmp":u) .
     1109                                   hh:TOOLTIP = "Печать" .
     1110                                   v-h[ii] = hh:handle .
     1111                                   ii = ii + 1 .
     1112                                   hh:width-chars = 3 .
     1113                               end.
     1114                           when "b-history" or
     1115                           when "b-hist" then
     1116                               do:
     1117                                   hh:load-image("cmp/b-hist.bmp":u) .
     1118                                   hh:TOOLTIP = "История" .
     1119                                   v-h[ii] = hh:handle .
     1120                                   ii = ii + 1 .
     1121                                   hh:width-chars = 3 .
     1122                               end.
     1123                           when "b-sch" then
     1124                               do:
     1125                                   hh:load-image("cmp/b-sch.bmp":u) .
     1126                                   hh:TOOLTIP = "Установка Фильтра" .
     1127                                   v-h[ii] = hh:handle .
     1128                                   ii = ii + 1 .
     1129                                   hh:width-chars = 3 .
     1130                               end.
     1131                           when "b-hist-user" then
     1132                               do:
     1133                                   hh:load-image("cmp/b-hist.bmp":u) .
     1134                                   hh:TOOLTIP = "История пользователя" .
     1135                                   ii = ii + 1 .
     1136                               end.
     1137                       end case.
     1138                   end.
     1139                   hh = hh:next-sibling.
     1140               end.
     1141               b-help:column = v-frame-width - b-help:width-chars.
     1142               jj = 0.
     1143               repeat ii = 4 to 1 by -1 :
     1144                   if valid-handle (v-h[ii] ) then
     1145                   do:
     1146                       jj  = jj + 1 .
     1147                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1148                       v-h[ii]:row    = v-help-old-y .
     1149                   end.
     1150               end.
     1151           end.
     1152       end.
     1153   end procedure.
     1154   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   on ' ' of date-end in frame Dialog-Frame
     1156   do:
     1157     if (can-query (self, "sensitive")
     1158        and
     1159        self :sensitive = true
     1160        )
     1161     or (can-query (self, "read-only")
     1162        and
     1163        self :read-only = false
     1164        )
     1165     then do:
     1166       assign
     1167         self :screen-value = ?
     1168       .
     1169     end.
     1170     return no-apply.
     1171   end.
     1172   on delete-character of date-end in frame Dialog-Frame
     1173   do:
     1174     if (can-query (self, "sensitive")
     1175        and
     1176        self :sensitive = true
     1177        )
     1178     or (can-query (self, "read-only")
     1179        and
     1180        self :read-only = false
     1181        )
     1182     then do:
     1183       assign
     1184         self :screen-value = ?
     1185       .
     1186     end.
     1187     return no-apply.
     1188   end.
     1189   on ctrl-d of date-end in frame Dialog-Frame
     1190   do:
     1191     define variable v-curr-sv-date as date no-undo .
     1192     if (can-query (self, "sensitive")
     1193        and
     1194        self :sensitive = true
     1195        )
     1196     or (can-query (self, "read-only")
     1197        and
     1198        self :read-only = false
     1199        )
     1200     then do:
     1201       if self :handle <> focus :handle
     1202       then do:
     1203         apply "entry":u to self .
     1204       end.
     1205       run gbl/getcurdt.p
     1206         (output v-curr-sv-date
     1207         ) .
     1208       assign
     1209         self :screen-value = string(v-curr-sv-date) .
     1210       .
     1211     end.
     1212     return no-apply.
     1213   end.
     1214   on ctrl-b of date-end in frame Dialog-Frame
     1215   do:
     1216     if (can-query (self, "sensitive")
     1217        and
     1218        self :sensitive = true
     1219        )
     1220     or (can-query (self, "read-only")
     1221        and
     1222        self :read-only = false
     1223        )
     1224     then do:
     1225       if self :handle <> focus :handle
     1226       then do:
     1227         apply "entry":u to self .
     1228       end.
     1229       define variable v-curr-sv-date as date no-undo .
     1230       define variable v-new-sv-date  as date no-undo .
     1231       assign
     1232         v-curr-sv-date = date(self :screen-value) no-error
     1233       .
     1234       if v-curr-sv-date = ?
     1235       then do:
     1236         run gbl/getcurdt.p
     1237           (output v-curr-sv-date
     1238           ) .
     1239       end.
     1240       if v-curr-sv-date <> ?
     1241       then do:
     1242         assign
     1243           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1244         .
     1245         assign
     1246           self :screen-value = string(v-new-sv-date) .
     1247         .
     1248       end.
     1249     end.
     1250     return no-apply .
     1251   end.
     1252   on ctrl-e of date-end in frame Dialog-Frame
     1253   do:
     1254     if (can-query (self, "sensitive")
     1255        and
     1256        self :sensitive = true
     1257        )
     1258     or (can-query (self, "read-only")
     1259        and
     1260        self :read-only = false
     1261        )
     1262     then do:
     1263       if self :handle <> focus :handle
     1264       then do:
     1265         apply "entry":u to self .
     1266       end.
     1267       define variable v-curr-sv-date as date no-undo .
     1268       define variable v-new-sv-date  as date no-undo .
     1269       assign
     1270         v-curr-sv-date = date(self :screen-value) no-error
     1271       .
     1272       if v-curr-sv-date = ?
     1273       then do:
     1274         run gbl/getcurdt.p
     1275           (output v-curr-sv-date
     1276           ) .
     1277       end.
     1278       if v-curr-sv-date <> ?
     1279       then do:
     1280         run gbl/lastdate.p
     1281           (input  v-curr-sv-date
     1282           ,output v-new-sv-date
     1283           ).
     1284         assign
     1285           self :screen-value = string(v-new-sv-date) .
     1286         .
     1287       end.
     1288     end.
     1289     return no-apply .
     1290   end.
     1291   on ctrl-f of date-end in frame Dialog-Frame
     1292   do:
     1293     if (can-query (self, "sensitive")
     1294        and
     1295        self :sensitive = true
     1296        )
     1297     or (can-query (self, "read-only")
     1298        and
     1299        self :read-only = false
     1300        )
     1301     then do:
     1302       if self :handle <> focus :handle
     1303       then do:
     1304         apply "entry":u to self .
     1305       end.
     1306       define variable v-ok            as logical   no-undo .
     1307       define variable v-curr-sv-date  as date      no-undo .
     1308       define variable v-description   as character no-undo .
     1309       assign
     1310         v-curr-sv-date = date(self :screen-value) no-error
     1311       .
     1312       if v-curr-sv-date = ?
     1313       then do:
     1314         run gbl/getcurdt.p
     1315           (output v-curr-sv-date
     1316           ) .
     1317       end.
     1318       if v-curr-sv-date <> ?
     1319       then do:
     1320         run gbl/d-inpday.w
     1321           (input ?
     1322           ,input "Выбор даты"
     1323           ,input v-description
     1324           ,input ""
     1325           ,input-output v-curr-sv-date
     1326           ,output v-ok
     1327           ).
     1328         if v-ok = true
     1329         then do:
     1330           assign
     1331             self :screen-value = string(v-curr-sv-date) .
     1332           .
     1333         end.
     1334       end.
     1335     end.
     1336     return no-apply .
     1337   end.
     1338     define MENU m-ed-date8
     1339       MENU-ITEM m-ed-date8-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1340       MENU-ITEM m-ed-date8-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1341       MENU-ITEM m-ed-date8-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1342       MENU-ITEM m-ed-date8-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1343       .
     1344     if date-end :POPUP-MENU in frame Dialog-Frame = ?
     1345     then do:
     1346       ASSIGN
     1347         date-end :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
     1348         date-end :MENU-MOUSE in frame Dialog-Frame = 3
     1349       .
     1350     end.
     1351     define variable v-label-handle8 as handle no-undo .
     1352     assign
     1353       v-label-handle8 = date-end :side-label-handle in frame Dialog-Frame
     1354     .
     1355     if valid-handle (v-label-handle8)
     1356     then do:
     1357       if v-label-handle8 :tooltip = ""
     1358       or v-label-handle8 :tooltip = ?
     1359       then do:
     1360         assign
     1361           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1362         .
     1363       end.
     1364     end.
     1365     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
     1366       apply "ctrl-b":U to date-end in frame Dialog-Frame .
     1367     END.
     1368     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
     1369       apply "ctrl-d":U to date-end in frame Dialog-Frame .
     1370     END.
     1371     ON CHOOSE OF MENU-ITEM m-ed-date8-3 in menu m-ed-date8 DO:
     1372       apply "ctrl-e":U to date-end in frame Dialog-Frame .
     1373     END.
     1374     ON CHOOSE OF MENU-ITEM m-ed-date8-4 in menu m-ed-date8 DO:
     1375       apply "ctrl-f":U to date-end in frame Dialog-Frame .
     1376     END.
     1377   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378     run mainmenu_getcntxt in parparentproc
     1379       (output v-cntxt-db-num
     1380       ,output v-cntxt-userid
     1381       ,output v-cntxt-level
     1382       ,output v-cntxt-host-code-obj
     1383       ,output v-cntxt-obj-type
     1384       ,output v-cntxt-obj-code
     1385       ,output v-cntxt-db-num-obj
     1386       ,output v-cntxt-is-admin
     1387       ) .
     1388   MAIN-BLOCK:
     1389   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1390      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1391     date-end = date(cur-time-date()) .
     1392     RUN enable_UI.
     1393     WAIT-FOR GO OF FRAME Dialog-Frame focus date-end .
     1394   END.
     1395   RUN disable_UI.
     1396   PROCEDURE disable_UI :
     1397     HIDE FRAME Dialog-Frame.
     1398   END PROCEDURE.
     1399   PROCEDURE enable_UI :
     1400     DISPLAY is-nakl-pri date-end is-nakl-smena-type is-fin-ob is-fin-doc
     1401             RADIO-SET-1 res FILL-IN-10 FILL-IN-11 is-nakl-add-doc
     1402         WITH FRAME Dialog-Frame.
     1403     ENABLE b-exit b-exec i-exit B-help is-nakl-pri date-end is-nakl-smena-type
     1404            is-fin-ob is-fin-doc res is-nakl-add-doc
     1405         WITH FRAME Dialog-Frame.
     1406     VIEW FRAME Dialog-Frame.
     1407   END PROCEDURE.
     1408   PROCEDURE make-temp-obj-firm :
     1409   do on error undo, return error return-value :
     1410       define buffer buf_shop for ub.shop .
     1411       define buffer buf_store for ub.store .
     1412       for each temp-obj-firm : delete temp-obj-firm. end.
     1413       for each buf_shop no-lock where buf_shop.host-code = par-host-code  on error undo, return error :
     1414         create temp-obj-firm.
     1415         assign
     1416           temp-obj-firm.obj-code = buf_shop.obj-code
     1417           temp-obj-firm.obj-type = 'маг':U
     1418         .
     1419       end.
     1420       for each buf_store no-lock where buf_store.host-code = par-host-code  on error undo, return error :
     1421         create temp-obj-firm.
     1422         assign
     1423           temp-obj-firm.obj-code = buf_store.obj-code
     1424           temp-obj-firm.obj-type = 'скл':U
     1425         .
     1426       end.
     1427     end.
     1428   end procedure.
