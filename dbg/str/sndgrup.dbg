        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter i-obj-code like ub.shop.obj-code no-undo.
        4   define input parameter mode as char no-undo .
        5   define input parameter p-subject as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sndgrup.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/sndgrup.p $":U .
       11   define variable vss-description as character no-undo init "Пересылка различных справочников - пускальник".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   def
       72   NEW shared
       73   temp-table  obj-list no-undo
       74     field obj-type like ub.clients.obj-type
       75     field obj-code like ub.clients.obj-code
       76     field obj-name like ub.clients.obj-name
       77     field obj-id   as integer
       78     field db-num   as integer
       79     index pi is primary unique obj-id
       80     index ie1 obj-type obj-code
       81     index ie2 obj-name
       82   .
       83   procedure create_obj-list :
       84      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       85      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       86      do
       87      on error undo, return error return-value
       88      :
       89         define buffer cli-obj for ub.clients .
       90         define variable p-var as integer no-undo .
       91         define buffer buf_obj-list for obj-list .
       92         find last buf_obj-list  use-index pi no-error .
       93         if available buf_obj-list
       94         then
       95            p-var = buf_obj-list.obj-id + 1.
       96         else
       97            p-var = 1.
       98         find first cli-obj where
       99                   cli-obj.obj-type = p-obj-type
      100               and cli-obj.obj-code = p-obj-code
      101         no-lock no-error.
      102         if available cli-obj
      103         then do:
      104            create buf_obj-list.
      105            assign
      106               buf_obj-list.obj-id   = p-var
      107               buf_obj-list.obj-code = cli-obj.obj-code
      108               buf_obj-list.obj-type = cli-obj.obj-type
      109               buf_obj-list.obj-name = cli-obj.obj-name
      110               buf_obj-list.db-num   = cli-obj.db-num
      111            .
      112         end.
      113      end.
      114   end.
      115   define variable v-message as character no-undo .
      116   CASE p-subject:
      117     when '':U then do:
      118       assign
      119       v-message = substitute("Отсылка групп товаров на кассы магазина &1", i-obj-code)
      120       .
      121     end.
      122     when 'group-BO' then do:
      123       assign
      124       v-message = substitute("Отсылка справочника групп товаров IBS TH в информационный киоск")
      125       .
      126     end.
      127     when 'units' then do:
      128       assign
      129       v-message = substitute("Отсылка справочника единиц измерения в информационный киоск")
      130       .
      131     end.
      132     when 'gds-prt' then do:
      133       assign
      134       v-message = substitute("Отсылка справочника шкал в информационный киоск")
      135       .
      136     end.
      137     when 'country' then do:
      138       assign
      139       v-message = substitute("Отсылка справочника стран в информационный киоск")
      140       .
      141     end.
      142   END CASE.
      143    run str/diallog.w (
      144           input parParentProc
      145         , input this-procedure
      146         , input "str/sendgrup.p":U
      147         , input (string(i-obj-code) + chr(4) + mode + chr(4) + p-subject)
      148         , input no
      149         , input "":U
      150         , input v-message
      151     ) no-error.
