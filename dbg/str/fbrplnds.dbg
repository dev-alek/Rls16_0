        1   define input parameter p-label-text     as character    no-undo.
        2   define output parameter p-obj-type      as character    no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Импорт данных из РКС".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-exit
      113        LABEL "&Выбор"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помощ&ь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE ed-text AS CHARACTER INITIAL "Надпись"
      121        VIEW-AS EDITOR
      122        SIZE 27.75 BY 1.63 NO-BOX
      123        FGCOLOR 1  NO-UNDO.
      124   DEFINE VARIABLE rs-obj-type AS INTEGER
      125        VIEW-AS RADIO-SET VERTICAL
      126        RADIO-BUTTONS
      127             "Магазин", 1,
      128   "Склад", 2
      129        SIZE 16 BY 2.38 NO-UNDO.
      130   DEFINE FRAME Dialog-Frame
      131        b-exit AT ROW 1.17 COL 2
      132        b-help AT ROW 1.17 COL 20
      133        ed-text AT ROW 2.46 COL 2.38 NO-LABEL
      134        rs-obj-type AT ROW 4.46 COL 9.13 NO-LABEL
      135        SPACE(5.99) SKIP(0.44)
      136       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      137            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      138            TITLE "Выбор типа объекта"
      139            DEFAULT-BUTTON b-exit.
      140   ASSIGN
      141          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      142          FRAME Dialog-Frame:HIDDEN           = TRUE.
      143   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      144   DO:
      145     APPLY "END-ERROR":U TO SELF.
      146   END.
      147   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      148   DO:
      149       assign
      150           rs-obj-type
      151       .
      152       assign
      153           p-obj-type = ( if rs-obj-type = 1 then 'маг':U else 'скл':U )
      154       .
      155       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      156   END.
      157   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   on help of frame Dialog-Frame
      159   do:
      160     run gbl/app_help.p
      161       (input this-procedure :file-name
      162       ,input ''
      163       ,input ?
      164       ) no-error.
      165     if error-status :error then do:
      166       message
      167         "Ошибка при вызове помощи"
      168         error-status :get-message(1)
      169         view-as alert-box .
      170     end.
      171   end.
      172   run minbtn-set in this-procedure .
      173   on choose of b-help in frame Dialog-Frame
      174   do:
      175     apply "help":u to frame Dialog-Frame .
      176   end.
      177   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   procedure minbtn-set :
      179       do
      180           on error undo, return error return-value
      181           :
      182           define variable ii              as integer       no-undo .
      183           define variable fh              as widget-handle no-undo .
      184           define variable hh              as widget-handle no-undo .
      185           define variable v-h             as handle        extent 4 no-undo .
      186           define variable v-name-button   as character     no-undo .
      187           define variable v-help-old-x    as decimal       no-undo .
      188           define variable v-help-old-y    as decimal       no-undo .
      189           define variable v-help-old-size as decimal       no-undo .
      190           define variable v-frame-width   as decimal       no-undo .
      191           define variable jj              as integer       no-undo .
      192           do
      193               on error undo, return error
      194               :
      195               assign
      196                   v-frame-width = frame Dialog-Frame:width - 0.3
      197                   fh            = frame Dialog-Frame:first-child
      198                   hh            = fh:first-child
      199                   ii            = 1
      200                   .
      201               do while valid-handle(hh):
      202                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      203                   do:
      204                       case lc(hh:name) :
      205                           when "b-help" then
      206                               do:
      207                                   hh:load-image-up("cmp/b-help.bmp":u) .
      208                                   hh:load-image-down("cmp/b-help.bmp":u) .
      209                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      210                                   hh:TOOLTIP = "Помощь" .
      211                                   v-help-old-x = hh:column .
      212                                   v-help-old-y = hh:row    .
      213                                   v-help-old-size = hh:width .
      214                                   hh:width-chars = 2.5 .
      215                               end.
      216                           when "b-print" then
      217                               do:
      218                                   hh:load-image("cmp/b-print.bmp":u) .
      219                                   hh:TOOLTIP = "Печать" .
      220                                   v-h[ii] = hh:handle .
      221                                   ii = ii + 1 .
      222                                   hh:width-chars = 3 .
      223                               end.
      224                           when "b-history" or
      225                           when "b-hist" then
      226                               do:
      227                                   hh:load-image("cmp/b-hist.bmp":u) .
      228                                   hh:TOOLTIP = "История" .
      229                                   v-h[ii] = hh:handle .
      230                                   ii = ii + 1 .
      231                                   hh:width-chars = 3 .
      232                               end.
      233                           when "b-sch" then
      234                               do:
      235                                   hh:load-image("cmp/b-sch.bmp":u) .
      236                                   hh:TOOLTIP = "Установка Фильтра" .
      237                                   v-h[ii] = hh:handle .
      238                                   ii = ii + 1 .
      239                                   hh:width-chars = 3 .
      240                               end.
      241                           when "b-hist-user" then
      242                               do:
      243                                   hh:load-image("cmp/b-hist.bmp":u) .
      244                                   hh:TOOLTIP = "История пользователя" .
      245                                   ii = ii + 1 .
      246                               end.
      247                       end case.
      248                   end.
      249                   hh = hh:next-sibling.
      250               end.
      251               b-help:column = v-frame-width - b-help:width-chars.
      252               jj = 0.
      253               repeat ii = 4 to 1 by -1 :
      254                   if valid-handle (v-h[ii] ) then
      255                   do:
      256                       jj  = jj + 1 .
      257                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      258                       v-h[ii]:row    = v-help-old-y .
      259                   end.
      260               end.
      261           end.
      262       end.
      263   end procedure.
      264   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      265   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      266   MAIN-BLOCK:
      267   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      268      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      269      assign
      270          ed-text = p-label-text
      271      .
      272     RUN enable_UI.
      273     apply "entry" to rs-obj-type in frame Dialog-Frame .
      274     WAIT-FOR GO OF FRAME Dialog-Frame.
      275   END.
      276   RUN disable_UI.
      277   PROCEDURE disable_UI :
      278     HIDE FRAME Dialog-Frame.
      279   END PROCEDURE.
      280   PROCEDURE enable_UI :
      281     DISPLAY ed-text rs-obj-type
      282         WITH FRAME Dialog-Frame.
      283     ENABLE b-exit b-help rs-obj-type
      284         WITH FRAME Dialog-Frame.
      285     VIEW FRAME Dialog-Frame.
      286   END PROCEDURE.
