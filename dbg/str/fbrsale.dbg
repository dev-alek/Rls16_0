        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo.
        4   define input parameter p-log-handle     as handle           no-undo.
        5   define input parameter p-parameters     as character        no-undo.
        6   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        7   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        8   define variable vss-revision    as character no-undo initial "$Revision$":U .
        9   define variable vss-author      as character no-undo initial "$Author$":U .
       10   define variable vss-date        as character no-undo initial "$Date$":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       12   define variable vss-archive     as character no-undo initial "$Archive$":U .
       13   define variable vss-description as character no-undo initial "Производство блюд при продаже":U .
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   procedure doc-code:
      301   define input  parameter parmode          as   character           no-undo.
      302   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      303   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      304   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      305   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      306   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      307   define variable vardb-remote     as   logical             no-undo.
      308   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      309   define variable v-delimiter as character no-undo .
      310   do
      311   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      312   :
      313   find first buf_sys-ctrl no-lock .
      314   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      315     CASE parmode:
      316       when "main":u then do:
      317         if vardb-remote then do:
      318           assign
      319             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      320         end.
      321         else do:
      322           assign
      323             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      324         end.
      325       end.
      326       when "trio" then do:
      327         assign
      328           pardoc-code = replace (parroot-doc-code, "=", "*").
      329       end.
      330       otherwise do:
      331         assign
      332         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      333         no-error
      334         .
      335         if error-status:error  then do:
      336           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      337                                         ,chr(10)
      338                                         ,parmode
      339                                         ).
      340         end.
      341         if num-entries(parmode) = 1
      342         and parmode <> "chip":U
      343         and parmode <> "chip_s":U
      344         then do:
      345           assign
      346           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      347         end.
      348         else if (lookup("chip":U, parmode) > 0
      349                  or
      350                  lookup("chip_s":U, parmode) > 0) then do:
      351           assign
      352             vartemp-doc-code = parroot-doc-code.
      353           do while true:
      354             if index (vartemp-doc-code , ".") = 0 then
      355               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      356             else
      357               vartemp-doc-code  =
      358               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      359               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      360               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      361             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      362           end.
      363           assign
      364             pardoc-code = vartemp-doc-code.
      365         end.
      366       end.
      367     end CASE.
      368     if pardoc-code = '':U
      369     or (parroot-doc-code <> '':U
      370     and pardoc-code = parroot-doc-code) then do:
      371       undo, return error substitute("Ошибка при генерации номера документа&1"
      372                                     ,chr(10)).
      373     end.
      374   end.
      375   end. // procedure/method
      376   function get-doc-code-int64 returns int64
      377     ( input p-doc-code as character ) :
      378     define variable v-ind              as integer   no-undo .
      379     define variable v-num-entries      as integer   no-undo .
      380     define variable v-doc-code-int64   as int64     no-undo .
      381     define variable v-canonic-doc-code as character no-undo .
      382     assign
      383       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      384       v-canonic-doc-code = p-doc-code
      385     .
      386     do v-ind = 1 to v-num-entries
      387     :
      388       assign
      389         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      390       .
      391     end.
      392     assign
      393       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      394     .
      395     return v-doc-code-int64 .
      396   end. // function/method
      397   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      399   procedure partslib-clear-temp-parts :
      400     define buffer buf_temp-parts for temp-parts .
      401     do
      402     on error undo, return error
      403     :
      404       for each buf_temp-parts
      405       on error undo, return error
      406       :
      407         delete buf_temp-parts .
      408       end.
      409     end.
      410   end procedure.
      411   procedure partslib-create-temp-parts :
      412     define parameter buffer buf_parts       for ub.parts .
      413     define parameter buffer buf_temp-parts  for temp-parts .
      414     define input  parameter p-goods-twounit as logical   no-undo .
      415     define variable v-base-part-code as character no-undo .
      416     do
      417     on error undo, return error
      418     :
      419       if p-goods-twounit = true
      420       then do:
      421         assign
      422           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      423         .
      424       end.
      425       else do:
      426         assign
      427           v-base-part-code = buf_parts.part-code
      428         .
      429       end.
      430       find first buf_temp-parts exclusive-lock
      431         where buf_temp-parts.obj-type  = buf_parts.obj-type
      432           and buf_temp-parts.obj-code  = buf_parts.obj-code
      433           and buf_temp-parts.artic     = buf_parts.artic
      434           and buf_temp-parts.prod-type = buf_parts.prod-type
      435           and buf_temp-parts.prod-code = buf_parts.prod-code
      436           and buf_temp-parts.in-code   = buf_parts.in-code
      437           and buf_temp-parts.out-code  = 'free-zone':U
      438           and buf_temp-parts.part-code = v-base-part-code
      439         no-error.
      440       if not available buf_temp-parts
      441       then do:
      442         create buf_temp-parts .
      443         buffer-copy buf_parts to buf_temp-parts
      444         assign
      445           buf_temp-parts.out-code  = 'free-zone':U
      446           buf_temp-parts.part-code = v-base-part-code
      447           buf_temp-parts.rsrv-free = yes
      448           buf_temp-parts.status_   = no
      449           buf_temp-parts.qnty      = 0
      450           buf_temp-parts.fact-qnty = 0
      451           buf_temp-parts.real-qnty = 0
      452           buf_temp-parts.cli-qnty  = 0
      453         .
      454       end.
      455     end.
      456   end procedure.
      457   procedure partslib-init-temp-parts :
      458     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      459     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      460     define input parameter p-artic           like ub.parts.artic     no-undo .
      461     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      462     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      463     define buffer buf_parts      for ub.parts .
      464     define buffer buf_temp-parts for temp-parts .
      465     define variable v-goods-twounit    as logical   no-undo .
      466     do
      467     on error undo, return error
      468     :
      469   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      471     (input  p-artic
      472     ,input  p-prod-type
      473     ,input  p-prod-code
      474     ,input  'twounit=request':u
      475     ,output v-goods-twounit
      476     ) no-error .
      477       if error-status :error
      478       then do:
      479         message
      480           vss-workfile vss-revision vss-description skip
      481           vss-include-info2 skip
      482           "Ошибка при определении атрибута товара" skip
      483           "Артикул" p-artic p-prod-type p-prod-code skip
      484           "twounit=request" skip
      485           error-status :get-message(1) skip
      486           return-value skip
      487           view-as alert-box error .
      488         undo, return error return-value .
      489       end.
      490       run partslib-clear-temp-parts in this-procedure .
      491       for each buf_parts
      492         where buf_parts.obj-type  = p-obj-type
      493           and buf_parts.obj-code  = p-obj-code
      494           and buf_parts.artic     = p-artic
      495           and buf_parts.prod-type = p-prod-type
      496           and buf_parts.prod-code = p-prod-code
      497           and buf_parts.rsrv-free = yes
      498           and buf_parts.status_   = no
      499           and buf_parts.in-code   <> buf_parts.out-code
      500       on error undo, return error
      501       :
      502         run partslib-create-temp-parts in this-procedure
      503           (buffer buf_parts
      504           ,buffer buf_temp-parts
      505           ,input  v-goods-twounit
      506           ) .
      507         define variable v-parts-qnty          as decimal   no-undo .
      508         define variable v-parts-cli-qnty      as decimal   no-undo .
      509         define variable v-parts-free-qnty     as decimal   no-undo .
      510         define variable v-parts-free-cli-qnty as decimal   no-undo .
      511         if buf_parts.out-code = 'free-zone':U
      512         then do:
      513           assign
      514             v-parts-qnty          = buf_parts.qnty
      515             v-parts-cli-qnty      = buf_parts.cli-qnty
      516             v-parts-free-qnty     = buf_parts.qnty
      517             v-parts-free-cli-qnty = buf_parts.cli-qnty
      518           .
      519         end.
      520         else do:
      521           assign
      522             v-parts-qnty          = abs(buf_parts.qnty)
      523             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      524             v-parts-free-qnty     = 0
      525             v-parts-free-cli-qnty = 0
      526           .
      527         end.
      528         assign
      529           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      530           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      531           buf_temp-parts.real-qnty     = 0
      532           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      533           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      534           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      535         .
      536       end.
      537     end.
      538   end procedure.
      539   procedure partslib-init-temp-parts-by-factord :
      540     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      541     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      542     define input parameter p-artic              like ub.parts.artic     no-undo .
      543     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      544     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      545     define input parameter p-fact-order         as decimal   no-undo .
      546     define input parameter p-include-fact-order as logical   no-undo .
      547     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      548     define buffer buf_gds-obj  for ub.gds-obj .
      549     do
      550     on error undo, return error
      551     :
      552       do transaction
      553       on error undo, return error
      554       :
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      557     (input  p-obj-type
      558     ,input  p-obj-code
      559     ,input  p-artic
      560     ,input  p-prod-type
      561     ,input  p-prod-code
      562     ,buffer buf_gds-obj
      563     ) no-error .
      564         if error-status :error
      565         then do:
      566           message
      567             vss-workfile vss-revision vss-description skip
      568             vss-include-info2 skip
      569             "Невозможно найти товар на объекте" skip
      570             "Объект" p-obj-type p-obj-code skip
      571             "Артикул" p-artic p-prod-type p-prod-code skip
      572             error-status :get-message(1) skip
      573             return-value skip
      574             view-as alert-box error .
      575           undo, return error .
      576         end.
      577         find current buf_gds-obj exclusive-lock .
      578       end.
      579       run partslib-init-temp-parts in this-procedure
      580         (input p-obj-type
      581         ,input p-obj-code
      582         ,input p-artic
      583         ,input p-prod-type
      584         ,input p-prod-code
      585         ) no-error .
      586       if error-status :error
      587       then do:
      588         message
      589           vss-workfile vss-revision vss-description skip
      590           vss-include-info2 skip
      591           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      592           "Объект" p-obj-type p-obj-code skip
      593           "Артикул" p-artic p-prod-type p-prod-code skip
      594           "p-fact-order" p-fact-order skip
      595           view-as alert-box error .
      596         undo, return error .
      597       end.
      598       if p-include-fact-order = true
      599       then do:
      600         assign
      601           p-fact-order = p-fact-order - 0.0000000001
      602         .
      603       end.
      604       define variable v-max-fact-order as character no-undo .
      605       run factord-max-fact-order in this-procedure
      606         (output v-max-fact-order
      607         ) no-error .
      608       if error-status :error
      609       then do:
      610         message
      611           vss-workfile vss-revision vss-description skip
      612           vss-include-info2 skip
      613           "Ошибка при вызове процедуры factord-max-fact-order" skip
      614           "Объект" p-obj-type p-obj-code skip
      615           "Артикул" p-artic p-prod-type p-prod-code skip
      616           "p-fact-order" p-fact-order skip
      617           view-as alert-box error .
      618         undo, return error .
      619       end.
      620       run partslib-update-by-factord in this-procedure
      621         (input p-obj-type
      622         ,input p-obj-code
      623         ,input p-artic
      624         ,input p-prod-type
      625         ,input p-prod-code
      626         ,input p-fact-order
      627         ,input v-max-fact-order
      628         ,input false
      629         ) no-error .
      630       if error-status :error
      631       then do:
      632         message
      633           vss-workfile vss-revision vss-description skip
      634           vss-include-info2 skip
      635           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      636           "Объект" p-obj-type p-obj-code skip
      637           "Артикул" p-artic p-prod-type p-prod-code skip
      638           "p-fact-order" p-fact-order skip
      639           "v-max-fact-order" v-max-fact-order skip
      640           view-as alert-box error .
      641         undo, return error .
      642       end.
      643     end.
      644   end procedure.
      645   procedure partslib-update-by-factord :
      646     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      647     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      648     define input parameter p-artic              like ub.parts.artic     no-undo .
      649     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      650     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      651     define input parameter p-start-fact-order   as decimal   no-undo .
      652     define input parameter p-end-fact-order     as decimal   no-undo .
      653     define input parameter p-lock-gds-obj       as logical   no-undo .
      654     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      655     define buffer buf_gds-obj  for ub.gds-obj .
      656     define buffer buf_doc-line for ub.doc-line .
      657     define variable v-total-parts-qnty as decimal   no-undo .
      658     define variable v-goods-gds-goods  as logical   no-undo .
      659     define variable v-goods-twounit    as logical   no-undo .
      660     do
      661     on error undo, return error
      662     :
      663       if p-start-fact-order > p-end-fact-order
      664       then do:
      665         message
      666           vss-workfile vss-revision vss-description skip
      667           vss-include-info2 skip
      668           "Ошибка задания входных параметров" skip
      669           "Начало интервала превышает конец интервала" skip
      670           "Объект" p-obj-type p-obj-code skip
      671           "Артикул" p-artic p-prod-type p-prod-code skip
      672           "p-start-fact-order" p-start-fact-order skip
      673           "p-end-fact-order"   p-end-fact-order skip
      674           view-as alert-box error .
      675         undo, return error .
      676       end.
      677       if p-lock-gds-obj = true
      678       then do:
      679         do transaction
      680         on error undo, return error
      681         :
      682   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      684     (input  p-obj-type
      685     ,input  p-obj-code
      686     ,input  p-artic
      687     ,input  p-prod-type
      688     ,input  p-prod-code
      689     ,buffer buf_gds-obj
      690     ) no-error .
      691           if error-status :error
      692           then do:
      693             message
      694               vss-workfile vss-revision vss-description skip
      695               vss-include-info2 skip
      696               "Невозможно найти gds-obj" skip
      697               error-status :get-message(1) skip
      698               return-value skip
      699               view-as alert-box error .
      700             undo, return error .
      701           end.
      702           find current buf_gds-obj exclusive-lock .
      703         end.
      704       end.
      705   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      707     (input  p-artic
      708     ,input  p-prod-type
      709     ,input  p-prod-code
      710     ,input  'gds-goods=request':u
      711     ,output v-goods-gds-goods
      712     ) no-error .
      713       if error-status :error
      714       then do:
      715         message
      716           vss-workfile vss-revision vss-description skip
      717           vss-include-info2 skip
      718           "Ошибка при определении атрибута товара" skip
      719           "Артикул" p-artic p-prod-type p-prod-code skip
      720           "gds-goods=request" skip
      721           error-status :get-message(1) skip
      722           return-value skip
      723           view-as alert-box error .
      724         undo, return error return-value .
      725       end.
      726   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      728     (input  p-artic
      729     ,input  p-prod-type
      730     ,input  p-prod-code
      731     ,input  'twounit=request':u
      732     ,output v-goods-twounit
      733     ) no-error .
      734       if error-status :error
      735       then do:
      736         message
      737           vss-workfile vss-revision vss-description skip
      738           vss-include-info2 skip
      739           "Ошибка при определении атрибута товара" skip
      740           "Артикул" p-artic p-prod-type p-prod-code skip
      741           "twounit=request" skip
      742           error-status :get-message(1) skip
      743           return-value skip
      744           view-as alert-box error .
      745         undo, return error return-value .
      746       end.
      747       for each buf_doc-line no-lock
      748         where buf_doc-line.obj-type   = p-obj-type
      749           and buf_doc-line.obj-code   = p-obj-code
      750           and buf_doc-line.artic      = p-artic
      751           and buf_doc-line.prod-type  = p-prod-type
      752           and buf_doc-line.prod-code  = p-prod-code
      753           and buf_doc-line.status_    = 'факт':U
      754           and buf_doc-line.fact-order > p-start-fact-order
      755           and buf_doc-line.fact-order <= p-end-fact-order
      756       on error undo, return error
      757       :
      758         run partslib-process-document in this-procedure
      759           (input  buf_doc-line.doc-code
      760           ,input  p-obj-type
      761           ,input  p-obj-code
      762           ,input  p-artic
      763           ,input  p-prod-type
      764           ,input  p-prod-code
      765           ,input  v-goods-gds-goods
      766           ,input  v-goods-twounit
      767           ,output v-total-parts-qnty
      768           ) no-error .
      769         if error-status :error
      770         then do:
      771           message
      772             vss-workfile vss-revision vss-description skip
      773             vss-include-info2 skip
      774             "Ошибка при вызове процедуры partslib-process-document" skip
      775             "Документ" buf_doc-line.doc-code skip
      776             "Объект" p-obj-type p-obj-code skip
      777             "Артикул" p-artic p-prod-type p-prod-code skip
      778             "p-start-fact-order" p-start-fact-order skip
      779             "p-end-fact-order" p-end-fact-order skip
      780             error-status :get-message(1) skip
      781             return-value skip
      782             view-as alert-box error .
      783           undo, return error return-value .
      784         end.
      785       end.
      786     end.
      787   end procedure.
      788   procedure partslib-process-document :
      789     define input  parameter p-doc-code         as character no-undo .
      790     define input  parameter p-obj-type         as character no-undo .
      791     define input  parameter p-obj-code         as integer   no-undo .
      792     define input  parameter p-artic            as character no-undo .
      793     define input  parameter p-prod-type        as character no-undo .
      794     define input  parameter p-prod-code        as integer   no-undo .
      795     define input  parameter p-goods-gds-goods  as logical   no-undo .
      796     define input  parameter p-goods-twounit    as logical   no-undo .
      797     define output parameter p-total-parts-qnty as decimal   no-undo .
      798     define variable v-parts-sign as integer   no-undo .
      799     define buffer buf_trn-doc    for ub.trn-doc .
      800     define buffer buf_doc-line   for ub.doc-line .
      801     define buffer buf_parts      for ub.parts .
      802     define buffer buf_temp-parts for temp-parts .
      803     do
      804     on error undo, return error return-value
      805     :
      806       find first buf_trn-doc no-lock
      807         where buf_trn-doc.doc-code = p-doc-code
      808         no-error .
      809       if not available buf_trn-doc
      810       then do:
      811         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      812                                      ,p-doc-code
      813                                      ) .
      814       end.
      815       case buf_trn-doc.doc-type
      816       :
      817         when 'при':U or
      818         when 'возврат':U or
      819         when 'инв':U
      820         then do:
      821           assign
      822             v-parts-sign = -1
      823           .
      824         end.
      825         when 'рас':U or
      826         when 'спи':U
      827         then do:
      828           assign
      829             v-parts-sign = 1
      830           .
      831         end.
      832         otherwise do:
      833           undo, return error substitute("Неизвестный тип документа &1"
      834                                       ,buf_trn-doc.doc-type
      835                                       ) .
      836         end.
      837       end.
      838       find first buf_doc-line no-lock
      839         where buf_doc-line.doc-code  = p-doc-code
      840           and buf_doc-line.artic     = p-artic
      841           and buf_doc-line.prod-type = p-prod-type
      842           and buf_doc-line.prod-code = p-prod-code
      843         no-error .
      844       if not available buf_doc-line
      845       then do:
      846         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      847                                      ,p-doc-code
      848                                      ,artic
      849                                      ,prod-type
      850                                      ,prod-code
      851                                      ) .
      852       end.
      853       assign
      854         p-total-parts-qnty = 0
      855       .
      856       if p-goods-gds-goods = true
      857       then do:
      858         for each buf_parts no-lock
      859           where buf_parts.out-code  = p-doc-code
      860             and buf_parts.obj-type  = p-obj-type
      861             and buf_parts.obj-code  = p-obj-code
      862             and buf_parts.artic     = p-artic
      863             and buf_parts.prod-type = p-prod-type
      864             and buf_parts.prod-code = p-prod-code
      865         on error undo, return error
      866         :
      867           run partslib-create-temp-parts in this-procedure
      868             (buffer buf_parts
      869             ,buffer buf_temp-parts
      870             ,input  p-goods-twounit
      871             ) .
      872           assign
      873             p-total-parts-qnty        = p-total-parts-qnty
      874                                       + v-parts-sign * buf_parts.fact-qnty
      875             buf_temp-parts.qnty       = buf_temp-parts.qnty
      876                                       + v-parts-sign * buf_parts.fact-qnty
      877             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      878                                       + v-parts-sign * buf_parts.fact-qnty
      879             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      880                                       + v-parts-sign * buf_parts.cli-qnty
      881           .
      882           if buf_temp-parts.qnty = 0
      883           then do:
      884             delete buf_temp-parts .
      885           end.
      886         end.
      887       end.
      888       else do:
      889         assign
      890           p-total-parts-qnty = p-total-parts-qnty
      891                              + v-parts-sign * buf_doc-line.fact-qnty
      892         .
      893       end.
      894     end.
      895   end procedure.
      896   procedure partslib-init-temp-parts-by-date :
      897     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      898     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      899     define input parameter p-artic           like ub.parts.artic     no-undo .
      900     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      901     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      902     define input parameter p-fact-date       as date      no-undo .
      903     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      904     do
      905     on error undo, return error
      906     :
      907       define variable v-fact-order                as decimal   no-undo .
      908       define variable v-shift-end-fact-order      as decimal   no-undo .
      909       define variable v-day-end-fact-order        as decimal   no-undo .
      910       run factord in this-procedure
      911         (input  p-fact-date
      912         ,input  1
      913         ,input  1
      914         ,input  ?
      915         ,input  0
      916         ,input  false
      917         ,output v-fact-order
      918         ,output v-shift-end-fact-order
      919         ,output v-day-end-fact-order
      920         ) no-error .
      921       if error-status :error
      922       then do:
      923         message
      924           vss-workfile vss-revision vss-description skip
      925           vss-include-info2 skip
      926           "Ошибка при определении момента времени, на который требуется остаток" skip
      927           "Объект" p-obj-type p-obj-code skip
      928           "Артикул" p-artic p-prod-type p-prod-code skip
      929           "Дата" p-fact-date skip
      930           view-as alert-box error .
      931         undo, return error .
      932       end.
      933       run partslib-init-temp-parts-by-factord in this-procedure
      934         (input p-obj-type
      935         ,input p-obj-code
      936         ,input p-artic
      937         ,input p-prod-type
      938         ,input p-prod-code
      939         ,input v-day-end-fact-order
      940         ,input false
      941         ) no-error .
      942       if error-status :error
      943       then do:
      944         message
      945           vss-workfile vss-revision vss-description skip
      946           vss-include-info2 skip
      947           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      948           "Объект" p-obj-type p-obj-code skip
      949           "Артикул" p-artic p-prod-type p-prod-code skip
      950           "Дата" p-fact-date skip
      951           view-as alert-box error .
      952         undo, return error .
      953       end.
      954     end.
      955   end procedure.
      956   procedure partslib-calc-cost :
      957     define output parameter p-fact-qnty      as decimal   no-undo .
      958     define output parameter p-vat-pc         as decimal   no-undo .
      959     define output parameter p-slt-pc         as decimal   no-undo .
      960     define output parameter p-sum-base       as decimal   no-undo .
      961     define output parameter p-sum-rubl       as decimal   no-undo .
      962     define output parameter p-vat-base       as decimal   no-undo .
      963     define output parameter p-vat-rubl       as decimal   no-undo .
      964     define output parameter p-slt-base       as decimal   no-undo .
      965     define output parameter p-slt-rubl       as decimal   no-undo .
      966     define output parameter p-road-tax-base  as decimal   no-undo .
      967     define output parameter p-road-tax-rubl  as decimal   no-undo .
      968     define output parameter p-transport-base as decimal   no-undo .
      969     define output parameter p-transport-rubl as decimal   no-undo .
      970     define output parameter p-other-base     as decimal   no-undo .
      971     define output parameter p-other-rubl     as decimal   no-undo .
      972     define output parameter p-excise-base    as decimal   no-undo .
      973     define output parameter p-excise-rubl    as decimal   no-undo .
      974     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      975     do
      976     on error undo, return error return-value
      977     :
      978       define buffer buf_temp-parts for temp-parts .
      979       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      980       define buffer   in-vatp-parts    for ub.parts   .
      981       define buffer   in-vatp-doc      for ub.trn-doc .
      982       define buffer   in-vatp-goods    for ub.goods   .
      983       define buffer   in-vatp-sysconf  for ub.sysconf .
      984       define buffer   in-vatp_doc-attr for ub.doc-attr.
      985       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      986       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      987       define variable varinvprb                  as   character              no-undo.
      988       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      989       define variable cli-base-rate              as   decimal                no-undo.
      990       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      991       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      992       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      993       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      994       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      995       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      996       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      997       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      998       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      999       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1000       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1001       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1002       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1003       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1004       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1005       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1006       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1007       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1008       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1009       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1010       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1011       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1012       define variable varinvatp-envd             as   character              no-undo.
     1013       define variable varinvatp-type             as   character              no-undo.
     1014       for each buf_temp-parts
     1015       on error undo, return error
     1016       :
     1017   assign
     1018     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1019     price-base-with-tax-loc = buf_temp-parts.price-base
     1020   .
     1021   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1023     (output varinvprb
     1024     )  .
     1025     if buf_temp-parts.out-code = 'free-zone':U     or
     1026        buf_temp-parts.out-code = 'out-zone':U   or
     1027        buf_temp-parts.doc-type = 'акт':U then do:
     1028       assign
     1029         in-vatp-have-vat-slt = yes.
     1030     end.
     1031     else do:
     1032       find first in-vatp_doc-attr no-lock
     1033         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1034           and in-vatp_doc-attr.attr-code = 'envd':U
     1035         no-error .
     1036       if not available in-vatp_doc-attr then do:
     1037         assign
     1038           in-vatp-have-vat-slt = yes.
     1039       end.
     1040       else do:
     1041            in-vatp-have-vat-slt = no.
     1042       end.
     1043     end.
     1044     assign
     1045      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1046      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1047     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1048              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1049     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1050             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1051             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1052             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1053             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1054             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1055             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1056       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1057     assign
     1058       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1059     assign
     1060       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1061       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1062       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1063       transport-cli-loc  = 0
     1064       other-cli-loc      = 0
     1065     .
     1066   ASSIGN
     1067             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1068       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1069   .
     1070         assign
     1071           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1072           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1073           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1074           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1075           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1076           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1077           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1078           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1079           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1080           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1081           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1082           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1083           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1084           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1085           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1086           p-excise-base    = p-excise-base    + 0
     1087           p-excise-rubl    = p-excise-rubl    + 0
     1088         .
     1089       end.
     1090       if p-fact-qnty      = ?
     1091       or p-sum-base       = ?
     1092       or p-sum-rubl       = ?
     1093       or p-vat-base       = ?
     1094       or p-vat-rubl       = ?
     1095       or p-slt-base       = ?
     1096       or p-slt-rubl       = ?
     1097       or p-road-tax-base  = ?
     1098       or p-road-tax-rubl  = ?
     1099       or p-transport-base = ?
     1100       or p-transport-rubl = ?
     1101       or p-other-base     = ?
     1102       or p-other-rubl     = ?
     1103       or p-excise-base    = ?
     1104       or p-excise-rubl    = ?
     1105       then do:
     1106         message
     1107           vss-workfile vss-revision vss-description skip
     1108           vss-include-info2 skip
     1109           "Программа in-vatp.i вернула неопределенные значения" skip
     1110           "p-fact-qnty"      p-fact-qnty      skip
     1111           "p-sum-base"       p-sum-base       skip
     1112           "p-sum-rubl"       p-sum-rubl       skip
     1113           "p-vat-base"       p-vat-base       skip
     1114           "p-vat-rubl"       p-vat-rubl       skip
     1115           "p-slt-base"       p-slt-base       skip
     1116           "p-slt-rubl"       p-slt-rubl       skip
     1117           "p-road-tax-base"  p-road-tax-base  skip
     1118           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1119           "p-transport-base" p-transport-base skip
     1120           "p-transport-rubl" p-transport-rubl skip
     1121           "p-other-base"     p-other-base     skip
     1122           "p-other-rubl"     p-other-rubl     skip
     1123           "p-excise-base"    p-excise-base    skip
     1124           "p-excise-rubl"    p-excise-rubl    skip
     1125           view-as alert-box error .
     1126         undo, return error .
     1127       end.
     1128     end.
     1129   end procedure.
     1130   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131       def var log-file-name as char no-undo.
     1132       if search('fbr.log') = ?
     1133       then do:
     1134           assign
     1135               log-file-name = ""
     1136           .
     1137       end.
     1138       else do:
     1139           assign
     1140               log-file-name = 'fbr.log'
     1141           .
     1142       end.
     1143       DEF STREAM stm-log.
     1144       PROCEDURE writelog:
     1145       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     1146       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     1147       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     1148       if p-file-name <> ""
     1149       then do:
     1150       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     1151           PUT STREAM stm-log UNFORMATTED chr(10).
     1152           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     1153                                           OR p-log-string = "&Line") THEN "" ELSE
     1154                                           cur-time-string-sec() + " ").
     1155           PUT STREAM stm-log UNFORMATTED
     1156                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     1157                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     1158                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     1159       OUTPUT STREAM stm-log CLOSE.
     1160       end.
     1161       END PROCEDURE.
