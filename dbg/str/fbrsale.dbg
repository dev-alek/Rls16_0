     1285   procedure fbrrest-get-free-qnty :
     1286   do
     1287   on error undo, return error
     1288   :
     1289   define input parameter p-obj-type       as character            no-undo.
     1290   define input parameter p-obj-code       as integer              no-undo.
     1291   define input parameter p-gds-code       as integer              no-undo.
     1292   define input parameter p-autofbr        as logical              no-undo.
     1293   define output parameter p-avail-qnty    as decimal              no-undo.
     1294       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     1295       define variable v-free-qnty as decimal       no-undo.
     1296       define buffer buf_goods         for ub.goods.
     1297       define buffer buf_gds-obj       for ub.gds-obj.
     1298       define buffer buf_temp-parts    for temp-parts.
     1299       find first buf_goods no-lock
     1300            where buf_goods.gds-code = p-gds-code
     1301       .
     1302       assign
     1303           p-avail-qnty = 0
     1304       .
     1305       run partslib-init-temp-parts in this-procedure (
     1306             input p-obj-type
     1307           , input p-obj-code
     1308           , input buf_goods.artic
     1309           , input buf_goods.prod-type
     1310           , input buf_goods.prod-code
     1311       ).
     1312       assign
     1313           v-free-qnty = 0
     1314       .
     1315       for each buf_temp-parts
     1316       on error undo, return error
     1317       :
     1318           if buf_temp-parts.qnty > 0
     1319           then do:
     1320               assign
     1321                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     1322               .
     1323           end.
     1324       end.
     1325       assign
     1326           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     1327       .
     1328   end.
     1329   end procedure.
     1330   procedure fbrrest-get-catering-object :
     1331   do
     1332   on error undo, return error
     1333   :
     1334   define input parameter p-obj-code            as integer      no-undo.
     1335   define output parameter p-catering-obj-type  as character    no-undo.
     1336   define output parameter p-catering-obj-code  as integer      no-undo.
     1337       define buffer buf_shop              for ub.shop.
     1338       find first buf_shop no-lock
     1339            where buf_shop.obj-code = p-obj-code
     1340       .
     1341       assign
     1342           p-catering-obj-type = buf_shop.kitchen-store-type
     1343           p-catering-obj-code = buf_shop.kitchen-store-code
     1344       .
     1345   end.
     1346   end procedure.
