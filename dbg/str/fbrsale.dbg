     5307               else do:
     5308                   find first buf_change_fbr-line exclusive-lock
     5309                        where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5310                          and buf_change_fbr-line.is-comp     = yes
     5311                          and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5312                   .
     5313                   assign
     5314                       buf_start_temp_goods-qnty.need-qnty  = buf_start_temp_goods-qnty.need-qnty + buf_fbr-line.fact-qnty
     5315                       buf_change_fbr-line.fact-qnty        = buf_start_temp_goods-qnty.need-qnty
     5316                   .
