     5187             otherwise do:
     5188               message
     5189                 vss-workfile vss-revision vss-description skip
     5190                 "Неизвестный тип рецепта производства" skip
     5191                 "Тип рецепта" buf_fbr-recipe.recipe-type skip
     5192                 "Документ производства" buf_fbr-recipe.doc-code skip
     5193                 "Код рецепта" buf_fbr-recipe.recipe-code skip
