     5197           end case .
     5198           if v-have-rights = no
     5199           then do:
     5200               message
     5201                   "Недостаточно прав для производства."
     5202                   skip(1) "Обратитесь к администратору."
     5203                   skip(1) return-value
     5204               view-as alert-box information.
     5205               run clear-temp-tables in this-procedure .
     5206               undo, return error.
     5207           end.
     5208           find first buf_fbr-line no-lock
     5209                where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     5210                  and buf_fbr-line.is-comp     = yes
     5211                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5212           no-error.
     5213           if available buf_fbr-line
     5214           then do:
     5215               define buffer buf_change_fbr-line      for ub.fbr-line.
     5216               run writelog in this-procedure ( log-file-name, 3, "В документе уже есть выбранный рецепт." ).
     5217               if buf_start_temp_goods-qnty.need-qnty = ?
     5218               and v-is-manual-input = yes
     5219               then do:
     5220                   define variable v-old-fact-qnty  as decimal       no-undo.
     5221                   define variable v-old-price-sale as decimal       no-undo.
     5222                   assign
     5223                       v-old-fact-qnty  = buf_fbr-line.fact-qnty
     5224                       v-old-price-sale = buf_fbr-line.price-sale
     5225                   .
     5226                   run str/fbr-line.w (
     5227                         input p-fbrhist-handle
     5228                       , input buf_fbr-doc.status_
     5229                       , input p-fbr-doc-doc-code
     5230                       , input recid( buf_fbr-line )
     5231                       , input ?
     5232                       , output v-cancel
     5233                   ).
     5234                   if error-status :error
     5235                   or v-cancel = yes
     5236                   then do:
     5237                       find first buf_change_fbr-line exclusive-lock
     5238                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5239                              and buf_change_fbr-line.is-comp     = yes
     5240                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5241                       .
     5242                       message
     5243                                vss-workfile vss-revision vss-description
     5244                           skip "Ошибка изменения строки."
     5245                           skip return-value
     5246                           skip trim(error-status :get-message(1))
     5247                                trim(error-status :get-message(2))
     5248                                trim(error-status :get-message(3))
     5249                           skip buf_change_fbr-line.fact-qnty
     5250                       view-as alert-box error.
     5251                       assign
     5252                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5253                           buf_change_fbr-line.price-sale = v-old-price-sale
     5254                       .
     5255                       run clear-temp-tables in this-procedure.
     5256                       return.
     5257                   end.
     5258                   if buf_fbr-line.fact-qnty <= v-old-fact-qnty
     5259                   then do:
     5260                       define variable v-gds-name    as character    no-undo.
     5261   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5262   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     5263     (input  buf_fbr-line.artic
     5264     ,input  buf_fbr-line.prod-type
     5265     ,input  buf_fbr-line.prod-code
     5266     ,output v-gds-name
     5267     )  .
     5268                       message
     5269                                "Для производства товаров документа необходимо"
     5270                           skip "большее количество товара, чем было добавлено."
     5271                           skip "Количество товара в документе будет восстановлено."
     5272                           skip(1)
     5273                           skip "Товар: " buf_fbr-line.artic v-gds-name
     5274                           skip "Количество в строке документа производства:" v-old-fact-qnty
     5275                           skip "Новое количество:" buf_fbr-line.fact-qnty
     5276                       view-as alert-box information
     5277                       title "Изменение строки документа производства".
     5278                       find first buf_change_fbr-line exclusive-lock
     5279                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5280                              and buf_change_fbr-line.is-comp     = yes
     5281                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5282                       .
     5283                       assign
     5284                           buf_change_fbr-line.fact-qnty  = v-old-fact-qnty
     5285                           buf_change_fbr-line.price-sale = v-old-price-sale
     5286                       .
     5287                       delete buf_start_temp_goods-qnty.
     5288                   end.
     5289                   else do:
     5290                       find first buf_change_fbr-line exclusive-lock
     5291                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5292                              and buf_change_fbr-line.is-comp     = yes
     5293                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5294                       .
     5295                       assign
     5296                           buf_start_temp_goods-qnty.need-qnty  = buf_fbr-line.fact-qnty
     5297                           buf_start_temp_goods-qnty.calculated = no
     5298                           buf_change_fbr-line.fact-qnty     = 0
     5299                       .
     5300                   end.
     5301                   run test-temp-tables in this-procedure ( "Товар добавлять не надо - параметр fbr-frcp=yes, но введенное в диалоге количество меньше необходимого." ).
     5302                   find first buf_start_temp_goods-qnty
     5303                        where buf_start_temp_goods-qnty.calculated = no
     5304                   no-error.
     5305                   next calc-not-calculated-goods.
