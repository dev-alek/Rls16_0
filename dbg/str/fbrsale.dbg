     6623   procedure fbrattr-write :
     6624     define input parameter p-doc-type       as character        no-undo.
     6625     define input parameter p-doc-code       as character        no-undo.
     6626     define input parameter p-attr-code      as character        no-undo.
     6627     define input parameter p-attr-value     as character        no-undo.
     6628     do
     6629     on error undo, return error
     6630     :
     6631   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input substitute('&1-&2',p-doc-type,p-doc-code) ,
     6632                          input p-attr-code ,
     6633                          input p-attr-value )  .
     6634     end.
     6635   end procedure.
     6636   procedure fbrattr-value :
     6637     define  input parameter p-doc-type      as character        no-undo.
     6638     define  input parameter p-doc-code      as character        no-undo.
     6639     define  input parameter p-attr-code     as character        no-undo.
     6640     define output parameter p-attr-value    as character        no-undo.
     6641     define variable v-par-value     as character    no-undo.
     6642     define variable v-par-type      as character    no-undo.
     6643     define buffer buf_clients       for ub.clients.
     6644     do
     6645     for buf_clients
     6646     on error undo, return error
     6647     :
     6648   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input substitute('&1-&2',p-doc-type,p-doc-code) ,
     6649                           input p-attr-code ,
     6650                          output p-attr-value ,
     6651                          output v-par-type )  .
     6652     end.
     6653   end procedure.
     6654   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
