     8918   procedure check-fbr-doc :
     8919      define input parameter p-doc-code   as character    no-undo.
     8920      define output parameter p-ok        as logical      no-undo.
     8921      define buffer buf_fbr-doc  for fbr-doc.
     8922      define buffer buf_fbr-line for fbr-line.
     8923      do
     8924         for buf_fbr-doc
     8925         , buf_fbr-line
     8926         on error undo, return error
     8927         :
     8928         find first buf_fbr-line no-lock
     8929            where buf_fbr-line.doc-code = p-doc-code
     8930            no-error.
     8931         if not available buf_fbr-line
     8932            then
     8933         do:
     8934            find first buf_fbr-doc exclusive-lock
     8935               where buf_fbr-doc.doc-code = p-doc-code
     8936               .
     8937            delete buf_fbr-doc.
     8938            assign
     8939               p-ok = no
     8940               .
     8941         end.
     8942         else
     8943         do:
     8944            assign
     8945               p-ok = yes
     8946               .
     8947         end.
     8948      end.
     8949   end procedure.
