     1411   DEFINE VARIABLE v-today as date no-undo .
     1412   DEFINE VARIABLE v-time as integer no-undo .
     1413   define variable v-doc-code as character no-undo .
     1414   define variable fi-pay-code as integer no-undo .
     1415   define buffer buf_fbr-doc for ub.fbr-doc.
     1416   define buffer buf_curr-accnt for ub.curr-accnt.
     1417   do
     1418   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1419   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1420   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1421   :
     1422   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1424     (input  p-obj-type
     1425     ,input  p-obj-code
     1426     ,output v-host-code
     1427     )  .
     1428   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1430     (input  p-obj-type
     1431     ,input  p-obj-code
     1432     ,output v-obj-db-num
     1433     )  .
     1434   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1436     (output v-db-num
     1437     )  .
     1438   if v-obj-db-num <> v-db-num then do:
     1439     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1440                             , chr(10)
     1441                             , p-obj-type
     1442                             , p-obj-code
     1443                             , v-obj-db-num
     1444                             , v-db-num).
     1445   end.
     1446   run cur-time in this-procedure ( output v-today, output v-time).
     1447   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1449     (input  p-obj-type
     1450     ,input  p-obj-code
     1451     ,output v-today
     1452     )  .
     1453   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1455     (input  v-host-code
     1456     ,output v-base-code
     1457     )  .
     1458   find last buf_curr-accnt no-lock
     1459       where buf_curr-accnt.curr-code = v-base-code
     1460         and buf_curr-accnt.exch-date <= v-today use-index pi
     1461   no-error.
     1462   if not available buf_curr-accnt
     1463   then do:
     1464     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1465                                     , string(v-today, "99/99/9999")
     1466                                     , v-base-code).
     1467   end.
     1468   run doc-code in this-procedure (
     1469         input  "main"
     1470       , input  p-obj-type
     1471       , input  p-obj-code
     1472       , input  ?
     1473       , output v-doc-code
     1474   ) no-error.
     1475   if error-status:error
     1476   then do:
     1477     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1478                                   , chr(10)
     1479                                   , error-status:get-message(1)
     1480                                   , return-value ).
     1481   end.
     1482   run trg/chkdocnm.p (
     1483         input v-doc-code
     1484       , input 'fbr-doc':U
     1485       , input ?
     1486   ) no-error.
     1487   if error-status:error
     1488   then do:
     1489     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1490                                   , chr(10)
     1491                                   , error-status:get-message(1)
     1492                                   , return-value ).
     1493   end.
     1494   create buf_fbr-doc.
     1495   assign
     1496   buf_fbr-doc.doc-code  = v-doc-code
     1497   buf_fbr-doc.creid     = p-userid
     1498   buf_fbr-doc.doc-date  = v-today
     1499   buf_fbr-doc.doc-type  = 'производство':U
     1500   buf_fbr-doc.host-code = v-host-code
     1501   buf_fbr-doc.obj-code  = p-obj-code
     1502   buf_fbr-doc.obj-type  = p-obj-type
     1503   buf_fbr-doc.PS        = "@"
     1504   buf_fbr-doc.status_   = 'новый':U
     1505   buf_fbr-doc.user-db-num = v-obj-db-num
     1506   buf_fbr-doc.user-name   = p-userid
     1507   .
     1508   run fbrlib_get-default-pay-code in this-procedure (
     1509         input buf_fbr-doc.obj-type
     1510       , input buf_fbr-doc.obj-code
     1511       , output fi-pay-code
     1512   ).
     1513   buf_fbr-doc.pay-code = fi-pay-code.
     1514   p-recid = recid(buf_fbr-doc).
     1515   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1516   end.
     1517   end procedure.
     1518   procedure fbrlib_get-default-pay-code :
     1519   define input parameter p-obj-type   as character        no-undo.
     1520   define input parameter p-obj-code   as integer          no-undo.
     1521   define output parameter p-pay-code  as integer          no-undo.
     1522   define variable v-host-code as integer no-undo .
     1523   define buffer buf_shop          for ub.shop.
     1524   define buffer buf_store         for ub.store.
     1525   define buffer buf_sysconf       for ub.sysconf.
     1526   do
     1527   for buf_shop
     1528     , buf_store
     1529     , buf_sysconf
     1530   on error undo, return error
     1531   :
     1532     case p-obj-type  :
     1533       when 'маг':U then do:
     1534           find first buf_shop no-lock
     1535                 where buf_shop.obj-code = p-obj-code
     1536           no-error.
     1537           if available buf_shop
     1538           then do:
     1539               assign
     1540                   p-pay-code = buf_shop.fbr-pay
     1541               .
     1542           end.
     1543       end.
     1544       when 'скл':U then do:
     1545           find first buf_store no-lock
     1546                 where buf_store.obj-code = p-obj-code
     1547           no-error.
     1548           if available buf_store
     1549           then do:
     1550               assign
     1551                   p-pay-code = buf_store.fbr-pay
     1552               .
     1553           end.
     1554       end.
     1555     end case.
     1556     if p-pay-code = ?
     1557     or p-pay-code = 0
     1558     then do:
     1559   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1561     (input  p-obj-type
     1562     ,input  p-obj-code
     1563     ,output v-host-code
     1564     )  .
     1565         find first buf_sysconf no-lock
     1566               where buf_sysconf.host-code = v-host-code
     1567         no-error.
     1568         if available buf_sysconf
     1569         then do:
     1570             assign
     1571                 p-pay-code = buf_sysconf.fbr-pay
     1572             .
     1573         end.
     1574     end.
     1575     if p-pay-code = ?
     1576     or p-pay-code = 0
     1577     then do:
     1578   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1580     (input  p-obj-type
     1581     ,input  p-obj-code
     1582     ,output p-pay-code
     1583     )  .
     1584     end.
     1585   end.
     1586   end procedure.
     1587   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1588   do
     1589   on error undo, return error
     1590   :
     1591   define input parameter p-fbr-doc-code as character    no-undo.
     1592       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1593       define variable v-gds-name      as character    no-undo.
     1594       define buffer buf_fbr-doc               for ub.fbr-doc.
     1595       define buffer buf_fbr-line              for ub.fbr-line.
     1596       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1597       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1598       find first buf_fbr-doc no-lock
     1599            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1600       .
     1601       for each buf_temp_fbrlib_recipe
     1602       :
     1603           delete buf_temp_fbrlib_recipe.
     1604       end.
     1605       for each buf_fbr-line no-lock
     1606          where buf_fbr-line.doc-code = p-fbr-doc-code
     1607       :
     1608           find first buf_temp_fbrlib_recipe
     1609                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1610           no-error.
     1611           if not available buf_temp_fbrlib_recipe
     1612           then do:
     1613               create buf_temp_fbrlib_recipe.
     1614               assign
     1615                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1616                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1617               .
     1618           end.
     1619       end.
     1620       for each buf_temp_fbrlib_recipe
     1621       :
     1622           assign
     1623               buf_temp_fbrlib_recipe.count-income                = 0
     1624               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1625               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1626               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1627               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1628               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1629               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1630               buf_temp_fbrlib_recipe.count-write-off             = 0
     1631               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1632               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1633               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1634               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1635               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1636               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1637           .
     1638           for each buf_fbr-line no-lock
     1639              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1640                and buf_fbr-line.trn-type     = 'при':U
     1641                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1642           :
     1643               if ( buf_fbr-line.price-base   = ?
     1644                   or buf_fbr-line.price-rubl = ?
     1645                   or buf_fbr-line.price-base <= 0
     1646                   or buf_fbr-line.price-rubl <= 0 )
     1647               and buf_fbr-line.fact-qnty <> 0
     1648               and buf_fbr-line.rsrv-qnty <> ?
     1649               and buf_fbr-doc.is-free    = no
     1650               then do:
     1651   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1653     (input  buf_fbr-line.artic
     1654     ,input  buf_fbr-line.prod-type
     1655     ,input  buf_fbr-line.prod-code
     1656     ,output v-gds-name
     1657     ) no-error .
     1658                   if error-status :error
     1659                   then do:
     1660                       assign
     1661                           v-gds-name = ""
     1662                       .
     1663                   end.
     1664                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1665                                                 ,vss-description
     1666                                                 ,buf_fbr-doc.doc-code
     1667                                                 ,chr(10)
     1668                                                 ,buf_fbr-line.recipe-code
     1669                                                 ,buf_fbr-line.artic
     1670                                                 ,v-gds-name).
     1671               end.
     1672               assign
     1673                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1674                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1675                                                                   + buf_fbr-line.fact-qnty
     1676                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1677                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1678               .
     1679               if buf_fbr-line.is-waste = no
     1680               then do:
     1681                   assign
     1682                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1683                                                                       + buf_fbr-line.price-sum-base
     1684                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1685                                                                       + buf_fbr-line.price-sum-rubl
     1686                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1687                                                                       + buf_fbr-line.price-sum-vat-base
     1688                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1689                                                                       + buf_fbr-line.price-sum-vat-rubl
     1690                   .
     1691               end.
     1692           end.
     1693           for each buf_fbr-line no-lock
     1694              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1695                and buf_fbr-line.trn-type     = 'спи':U
     1696                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1697           :
     1698               if ( buf_fbr-line.price-base   = ?
     1699                   or buf_fbr-line.price-rubl = ?
     1700                   or buf_fbr-line.price-base <= 0
     1701                   or buf_fbr-line.price-rubl <= 0 )
     1702               and buf_fbr-line.fact-qnty <> 0
     1703               and buf_fbr-line.rsrv-qnty <> ?
     1704               and buf_fbr-doc.is-free    = no
     1705               and buf_fbr-doc.status_    = 'разрешен':U
     1706               then do:
     1707   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1709     (input  buf_fbr-line.artic
     1710     ,input  buf_fbr-line.prod-type
     1711     ,input  buf_fbr-line.prod-code
     1712     ,output v-gds-name
     1713     ) no-error .
     1714                   if error-status :error
     1715                   then do:
     1716                       assign
     1717                           v-gds-name = ""
     1718                       .
     1719                   end.
     1720                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1721                                                 ,vss-description
     1722                                                 ,buf_fbr-doc.doc-code
     1723                                                 ,chr(10)
     1724                                                 ,buf_fbr-line.recipe-code
     1725                                                 ,buf_fbr-line.artic
     1726                                                 ,v-gds-name).
     1727               end.
     1728               assign
     1729                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1730                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1731                                                                   + buf_fbr-line.fact-qnty
     1732                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1733                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1734               .
     1735               if buf_fbr-line.is-waste = no
     1736               then do:
     1737                   assign
     1738                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1739                                                                       + buf_fbr-line.price-sum-base
     1740                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1741                                                                       + buf_fbr-line.price-sum-rubl
     1742                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1743                                                                       + buf_fbr-line.price-sum-vat-base
     1744                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1745                                                                       + buf_fbr-line.price-sum-vat-rubl
     1746                   .
     1747               end.
     1748           end.
     1749           if buf_fbr-doc.status_    = 'разрешен':U
     1750           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1751           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1752           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1753           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1754               )
     1755           then do:
     1756            undo, return error
     1757               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1758                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1759                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1760                           "Сумма в &9.&4&7&4&4&8&2"
     1761                          , buf_fbr-doc.doc-code
     1762                          , chr(10)
     1763                          , buf_temp_fbrlib_recipe.recipe-code
     1764                          , chr(9)
     1765                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1766                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1767                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1768                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1769                          , "руб"
     1770                          )
     1771              +
     1772              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1773                         "НДС в &7.&1&5&1&1&6&4"
     1774                        ,  chr(9)
     1775                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1776                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1777                        ,chr(10)
     1778                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1779                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1780                        ,"руб"
     1781                        )       .
     1782           end.
     1783       end.
     1784   end.
     1785   end procedure.
     1786   procedure fbrlib-fill-sum-fbr-doc :
     1787   do
     1788   on error undo, return error
     1789   :
     1790   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1791   define input parameter p-mode           as character    no-undo.
     1792       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1793       define buffer buf_fbr-doc           for ub.fbr-doc.
     1794       define buffer buf_fbr-line          for ub.fbr-line.
     1795       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1796       define variable v-in-count          as integer       no-undo.
     1797       define variable v-out-count         as integer       no-undo.
     1798       find first buf_fbr-doc exclusive-lock
     1799            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1800       .
     1801       find first buf_temp_fbrlib_recipe no-error.
     1802       if not available buf_temp_fbrlib_recipe
     1803       then do:
     1804           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1805               input buf_fbr-doc.doc-code
     1806           ) no-error.
     1807           if error-status :error
     1808           then do:
     1809               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1810                                              , vss-description
     1811                                              , chr(10)
     1812                                              , error-status:get-message(1)
     1813                                              , return-value ).
     1814           end.
     1815       end.
     1816       assign
     1817           v-in-count                  = 0
     1818           buf_fbr-doc.in-qnty         = 0
     1819           buf_fbr-doc.in-sale         = 0
     1820           buf_fbr-doc.in-base         = 0
     1821           buf_fbr-doc.in-rubl         = 0
     1822           buf_fbr-doc.in-vat-base     = 0
     1823           buf_fbr-doc.in-vat-rubl     = 0
     1824           v-out-count                 = 0
     1825           buf_fbr-doc.out-qnty        = 0
     1826           buf_fbr-doc.out-sale        = 0
     1827           buf_fbr-doc.out-base        = 0
     1828           buf_fbr-doc.out-rubl        = 0
     1829           buf_fbr-doc.out-vat-base    = 0
     1830           buf_fbr-doc.out-vat-rubl    = 0
     1831       .
     1832       for each buf_temp_fbrlib_recipe
     1833       :
     1834           assign
     1835               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1836               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1837               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1838               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1839               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1840               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1841               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1842               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1843               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1844               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1845               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1846               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1847               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1848               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1849           .
     1850       end.
     1851       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1852       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1853       or p-mode <> 'факт':U
     1854       then do:
     1855           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1856           then do:
     1857               assign
     1858                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1859                                   + string( v-out-count, ">>>,>>9" )
     1860                                   + chr(10) + "Строк исходных товаров : "
     1861                                   + string( v-in-count, ">>>,>>9" )
     1862               .
     1863           end.
     1864       end.
     1865       else do:
     1866         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1867                                       "Сумма списанных товаров в &3 - &4&2" +
     1868                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1869                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1870                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1871                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1872                                       , buf_fbr-doc.doc-code
     1873                                       , chr(10)
     1874                                       , "рублях"
     1875                                       , round( buf_fbr-doc.out-rubl, 2 )
     1876                                       , round( buf_fbr-doc.in-rubl,  2 )
     1877                                       , round( buf_fbr-doc.in-rubl,  2 )
     1878                                       , round( buf_fbr-doc.out-base, 2 )
     1879                                       , round( buf_fbr-doc.in-base,  2 )).
     1880       end.
     1881   end.
     1882   end procedure.
     1883   procedure fbrlib-calc-prices :
     1884   do
     1885   on error undo, return error
     1886   :
     1887   define input parameter p-fbr-line-recid as recid        no-undo.
     1888   define input parameter p-price-obj-type as character    no-undo.
     1889   define input parameter p-price-obj-code as integer      no-undo.
     1890   define output parameter p-current-price as decimal      no-undo.
     1891       define variable v-void          as decimal       no-undo.
     1892       define variable v-void-char     as character     no-undo.
     1893       define variable v-gds-code      as integer       no-undo.
     1894       define variable v-b-code        as integer       no-undo.
     1895       define buffer buf_fbr-doc   for ub.fbr-doc.
     1896       define buffer buf_fbr-line  for ub.fbr-line.
     1897       define buffer buf_gds-prt   for ub.gds-prt.
     1898       define buffer buf_bar-code  for ub.bar-code.
     1899       find first buf_fbr-line no-lock
     1900           where recid( buf_fbr-line ) = p-fbr-line-recid
     1901       .
     1902   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1903   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1904     (input  buf_fbr-line.artic
     1905     ,input  buf_fbr-line.prod-type
     1906     ,input  buf_fbr-line.prod-code
     1907     ,output v-gds-code
     1908     ) no-error .
     1909       if error-status :error
     1910       then do:
     1911         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1912                                         ,vss-workfile
     1913                                         ,vss-revision
     1914                                         ,vss-description
     1915                                         ,chr(10)
     1916                                         , error-status:get-message(1)
     1917                                         , return-value
     1918                                         , buf_fbr-line.artic
     1919                                         ).
     1920       end.
     1921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1922     (input  v-gds-code
     1923     ,input  ?
     1924     ,output v-b-code
     1925     ) no-error .
     1926       if error-status :error
     1927       then do:
     1928         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1929                                         ,vss-workfile
     1930                                         ,vss-revision
     1931                                         ,vss-description
     1932                                         ,chr(10)
     1933                                         , error-status:get-message(1)
     1934                                         , return-value
     1935                                         , v-gds-code
     1936                                         ).
     1937       end.
     1938       if buf_fbr-line.is-calc = no
     1939       then do:
     1940   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1942     (input  p-price-obj-type
     1943     ,input  p-price-obj-code
     1944     ,input  v-b-code
     1945     ,input  0
     1946     ,input  0
     1947     ,output v-void-char
     1948     ,output p-current-price
     1949     ,output v-void
     1950     ,output v-void
     1951     ) no-error .
     1952           if error-status :error
     1953           then do:
     1954             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1955                                             ,vss-workfile
     1956                                             ,vss-revision
     1957                                             ,vss-description
     1958                                             ,chr(10)
     1959                                             , error-status:get-message(1)
     1960                                             , return-value
     1961                                             , v-gds-code
     1962                                             ).
     1963           end.
     1964       end.
     1965       else do:
     1966           assign
     1967               p-current-price = buf_fbr-line.price-sale
     1968           .
     1969       end.
     1970   end.
     1971   end procedure.
     1972   procedure fbrlib-put-in-order-recipe :
     1973   do
     1974   on error undo, return error
     1975   :
     1976   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1977       define variable v-recipe-counter    as integer          no-undo.
     1978       define variable v-recipe-amount     as integer init 0   no-undo.
     1979       define variable v-child-counter     as integer          no-undo.
     1980       define variable v-is-call-cycle     as logical          no-undo.
     1981       define variable v-str as character     no-undo.
     1982       define buffer buf_in_fbr-line       for ub.fbr-line.
     1983       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1984       define buffer buf_fbr-line          for ub.fbr-line.
     1985       define buffer buf_recipe-gds        for ub.recipe-gds.
     1986       define buffer buf_recipe            for ub.recipe.
     1987       for each temp_recipe-childs-qnty
     1988       :
     1989           delete temp_recipe-childs-qnty.
     1990       end.
     1991       for each temp_recipe-childs
     1992       :
     1993           delete temp_recipe-childs.
     1994       end.
     1995       for each temp_recipe-order
     1996       :
     1997           delete temp_recipe-order.
     1998       end.
     1999       for each buf_fbr-line no-lock
     2000          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2001       on error undo, return error
     2002       :
     2003           find first temp_recipe-childs-qnty
     2004                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2005           no-error.
     2006           if not available temp_recipe-childs-qnty
     2007           then do:
     2008               create temp_recipe-childs-qnty.
     2009               assign
     2010                   v-recipe-amount                     = v-recipe-amount + 1
     2011                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2012                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2013                   temp_recipe-childs-qnty.childs-qnty = 0
     2014                   v-child-counter                     = 0
     2015               .
     2016           end.
     2017       end.
     2018       for each buf_in_fbr-line no-lock
     2019          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2020            and buf_in_fbr-line.trn-type = 'спи':U
     2021       on error undo, return error
     2022       :
     2023           for each buf_dress_fbr-line no-lock
     2024              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2025                and buf_dress_fbr-line.trn-type    = 'при':U
     2026                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2027                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2028                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2029           on error undo, return error
     2030           :
     2031               find first buf_recipe no-lock
     2032                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2033               .
     2034               if buf_in_fbr-line.is-comp = yes
     2035               then do:
     2036                   find last temp_recipe-childs-qnty
     2037                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2038                   .
     2039                   assign
     2040                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2041                   .
     2042                   create temp_recipe-childs.
     2043                   assign
     2044                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2045                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2046                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2047                   .
     2048               end.
     2049               else do:
     2050               end.
     2051           end.
     2052       end.
     2053       for each buf_in_fbr-line no-lock
     2054          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2055            and buf_in_fbr-line.trn-type = 'при':U
     2056       on error undo, return error
     2057       :
     2058           find first buf_recipe no-lock
     2059                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2060           no-error.
     2061           if buf_in_fbr-line.is-comp = no
     2062           then do:
     2063           end.
     2064           else do:
     2065               for each buf_recipe-gds no-lock
     2066               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2067               :
     2068                   for each buf_fbr-line no-lock
     2069                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2070                       and buf_fbr-line.trn-type    = 'при':U
     2071                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2072                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2073                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2074                   on error undo, return error
     2075                   :
     2076                       find first buf_recipe no-lock
     2077                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2078                       .
     2079                       if buf_recipe.recipe-type = 'разделка':U
     2080                       then do:
     2081                       end.
     2082                       else do:
     2083                           find last temp_recipe-childs-qnty
     2084                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2085                           .
     2086                           assign
     2087                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2088                           .
     2089                           create temp_recipe-childs.
     2090                           assign
     2091                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2092                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2093                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2094                           .
     2095                       end.
     2096                   end.
     2097               end.
     2098           end.
     2099       end.
     2100       for each temp_recipe-order
     2101       on error undo, return error
     2102       :
     2103           delete temp_recipe-order.
     2104       end.
     2105       assign
     2106           v-fbrlib-recipe-order = 0
     2107       .
     2108       do v-recipe-counter = 1 to v-recipe-amount
     2109       on error undo, return error
     2110       :
     2111           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2112                 input v-recipe-counter
     2113               , input 0
     2114               , output v-is-call-cycle
     2115           ).
     2116           if v-is-call-cycle = yes
     2117           then do:
     2118               message
     2119                       "Достигнут максимальный уровень вложенности рецептов."
     2120                   skip(1)
     2121                   skip "Невозможно упорядочить рецепты."
     2122                   skip(1)
     2123                   skip "Необходимо изменить структуру рецептов,"
     2124                   skip "используемых при формировании"
     2125                   skip "данного документа производства."
     2126               view-as alert-box error
     2127               title "Невозможно рассчитать документ производства".
     2128               for each temp_recipe-childs-qnty
     2129               :
     2130                   delete temp_recipe-childs-qnty.
     2131               end.
     2132               for each temp_recipe-childs
     2133               :
     2134                   delete temp_recipe-childs.
     2135               end.
     2136               for each temp_recipe-order
     2137               :
     2138                   delete temp_recipe-order.
     2139               end.
     2140               for each temp_recipe-order
     2141               on error undo, return error
     2142               :
     2143                   delete temp_recipe-order.
     2144               end.
     2145               for each temp_fbrlib_recipe
     2146               on error undo, return error
     2147               :
     2148                   delete temp_recipe-order.
     2149               end.
     2150               undo, return error.
     2151           end.
     2152       end.
     2153   end.
     2154   end procedure.
     2155   procedure fbrlib-add-recipe-in-tmp-order :
     2156   do
     2157   on error undo, return error
     2158   :
     2159   define input parameter p-order              as integer      no-undo.
     2160   define input parameter p-call-counter       as integer      no-undo.
     2161   define output parameter p-is-call-cycle     as logical      no-undo.
     2162       define variable v-nodes-counter     as integer       no-undo.
     2163       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2164       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2165       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2166       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2167       assign
     2168           p-call-counter = p-call-counter + 1
     2169       .
     2170       if p-call-counter > 50
     2171       then do:
     2172           assign
     2173               p-is-call-cycle = yes
     2174           .
     2175       end.
     2176       else do:
     2177           find first buf_temp_recipe-childs-qnty
     2178                where buf_temp_recipe-childs-qnty.order = p-order
     2179           .
     2180           find first buf_temp_recipe-order
     2181                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2182           no-error.
     2183           if not available buf_temp_recipe-order
     2184           then do:
     2185               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2186               :
     2187                   find first buf_temp_recipe-childs
     2188                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2189                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2190                   .
     2191                   find first buf_c_temp_recipe-childs-qnty
     2192                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2193                   .
     2194                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2195                         input buf_c_temp_recipe-childs-qnty.order
     2196                       , input p-call-counter
     2197                       , output p-is-call-cycle
     2198                   ).
     2199                   if p-is-call-cycle = yes
     2200                   then do:
     2201                       return.
     2202                   end.
     2203               end.
     2204               assign
     2205                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2206               .
     2207               create buf_temp_recipe-order.
     2208               assign
     2209                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2210                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2211               .
     2212           end.
     2213       end.
     2214   end.
     2215   end procedure.
     2216   procedure fbrlib-get-trn-type :
     2217   define input parameter p-recipe-code    as character    no-undo.
     2218   define input parameter p-goods-recid    as recid        no-undo.
     2219   define input parameter p-is-integration as logical      no-undo.
     2220   define output parameter p-is-comp       as logical      no-undo.
     2221   define output parameter p-trn-type      as character    no-undo.
     2222   define buffer buf_recipe    for ub.recipe.
     2223   define buffer buf_goods     for ub.goods.
     2224   do
     2225   for buf_recipe
     2226     , buf_goods
     2227   on error undo, return error
     2228   :
     2229       find first buf_goods no-lock
     2230            where recid( buf_goods ) = p-goods-recid
     2231       .
     2232       find first buf_recipe no-lock
     2233            where buf_recipe.recipe-code = p-recipe-code
     2234       no-error.
     2235       if not available buf_recipe
     2236       then do:
     2237           assign
     2238               p-is-comp = no
     2239               p-trn-type = "":U
     2240           .
     2241           undo, return.
     2242       end.
     2243       if  buf_recipe.artic        = buf_goods.artic
     2244       and buf_recipe.prod-type    = buf_goods.prod-type
     2245       and buf_recipe.prod-code    = buf_goods.prod-code
     2246       then do:
     2247           assign
     2248               p-is-comp = yes
     2249           .
     2250       end.
     2251       else do:
     2252           assign
     2253               p-is-comp = no
     2254           .
     2255       end.
     2256       case buf_recipe.recipe-type
     2257       :
     2258           when 'производство':U
     2259           then do:
     2260               if p-is-comp = yes
     2261               then do:
     2262                   assign
     2263                       p-trn-type = 'при':U
     2264                   .
     2265               end.
     2266               else do:
     2267                   assign
     2268                       p-trn-type = 'спи':U
     2269                   .
     2270               end.
     2271           end.
     2272           when 'альтернатива':U
     2273           then do:
     2274               if p-is-comp = yes
     2275               then do:
     2276                   assign
     2277                       p-trn-type = 'при':U
     2278                   .
     2279               end.
     2280               else do:
     2281                   assign
     2282                       p-trn-type = 'спи':U
     2283                   .
     2284               end.
     2285           end.
     2286           when 'разделка':U
     2287           then do:
     2288               if p-is-comp = no
     2289               then do:
     2290                   assign
     2291                       p-trn-type = 'при':U
     2292                   .
     2293               end.
     2294               else do:
     2295                   assign
     2296                       p-trn-type = 'спи':U
     2297                   .
     2298               end.
     2299           end.
     2300           when 'комплектация':U
     2301           then do:
     2302               if p-is-integration = ?
     2303               then do:
     2304                   message
     2305                       "Выберите тип операции по рецепту комплектации:"
     2306                       skip (2) "YES - комплектация"
     2307                       skip     "NO - разукомплектация"
     2308                   view-as alert-box question
     2309                   buttons YES-NO
     2310                   update p-is-integration.
     2311               end.
     2312               if p-is-integration = yes
     2313               then do:
     2314                   if p-is-comp = yes
     2315                   then do:
     2316                       assign
     2317                           p-trn-type = 'при':U
     2318                       .
     2319                   end.
     2320                   else do:
     2321                       assign
     2322                           p-trn-type = 'спи':U
     2323                       .
     2324                   end.
     2325               end.
     2326               else do:
     2327                   if p-is-comp = yes
     2328                   then do:
     2329                       assign
     2330                           p-trn-type = 'спи':U
     2331                       .
     2332                   end.
     2333                   else do:
     2334                       assign
     2335                           p-trn-type = 'при':U
     2336                       .
     2337                   end.
     2338               end.
     2339           end.
     2340       end case.
     2341   end.
     2342   end procedure.
     2343   procedure fbrlib-get-mark :
     2344   define input parameter p-recipe-code    as character    no-undo.
     2345   define output parameter p-mark          as logical    no-undo.
     2346   define buffer buf_goods-attr     for ub.goods-attr.
     2347   define buffer buf_recipe-gds for ub.recipe-gds .
     2348       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2349            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2350                                               buf_goods-attr.attr-code = 'mark-type':U:
     2351            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2352               p-mark = true .
     2353               return .
     2354            end.
     2355       end.
     2356   end procedure.
     2357   procedure fbrlib-check-temp-tables :
     2358   do
     2359   on error undo, return error
     2360   :
     2361   define input parameter p-title  as character    no-undo.
     2362       define variable v-str               as character        no-undo.
     2363       assign
     2364           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2365       .
     2366       for each temp_recipe-childs-qnty
     2367       on error undo, return error
     2368       :
     2369           assign
     2370               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2371                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2372                       + "   " + string( temp_recipe-childs-qnty.order )
     2373                       + chr(10)
     2374           .
     2375       end.
     2376       assign
     2377           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2378       .
     2379       for each temp_recipe-childs
     2380       on error undo, return error
     2381       :
     2382           assign
     2383               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2384                       + "   " + string( temp_recipe-childs.child-code )
     2385                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2386                       + chr(10)
     2387           .
     2388       end.
     2389       assign
     2390           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2391       .
     2392       for each temp_recipe-order
     2393       on error undo, return error
     2394       :
     2395           assign
     2396               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2397                       + "   " + string( temp_recipe-order.order )
     2398                       + chr(10)
     2399           .
     2400       end.
     2401       assign
     2402           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2403       .
     2404       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2405       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2406       for each temp_fbrlib_recipe
     2407       on error undo, return error
     2408       :
     2409           assign
     2410               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2411                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2412                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2413                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2414                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2415                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2416                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2417                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2418                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2419                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2420                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2421                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2422                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2423                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2424                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2425                       + chr(10)
     2426           .
     2427           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2428       end.
     2429   end.
     2430   end procedure.
     2431   procedure fbrlib-s-coeff-value :
     2432   define input  parameter p-gds-code    as integer        no-undo.
     2433   define input  parameter p-date        as date           no-undo.
     2434   define input  parameter p-obj-type    as character      no-undo.
     2435   define input  parameter p-obj-code    as integer        no-undo.
     2436   define output parameter p-coeff-value as decimal        no-undo.
     2437   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2438       define variable v-date          as date         no-undo.
     2439       define variable v-host-code     as integer      no-undo.
     2440       define buffer buf_goods       for ub.goods.
     2441       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2442       define buffer buf_clients     for ub.clients.
     2443       define buffer buf_s-coeff     for ub.s-coeff.
     2444   do
     2445   for buf_goods
     2446     , buf_fbr-gds-obj
     2447     , buf_clients
     2448     , buf_s-coeff
     2449   on error undo, return error return-value
     2450   :
     2451       find first buf_goods no-lock
     2452            where buf_goods.gds-code = p-gds-code
     2453       no-error .
     2454       if not available buf_goods
     2455       then do:
     2456          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2457       end.
     2458       find first buf_clients no-lock
     2459            where buf_clients.obj-type = p-obj-type
     2460              and buf_clients.obj-code = p-obj-code
     2461       no-error.
     2462       if not available buf_clients
     2463       then do:
     2464          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2465       end.
     2466       assign
     2467           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2468       .
     2469       find first buf_fbr-gds-obj no-lock
     2470            where buf_fbr-gds-obj.gds-code = p-gds-code
     2471              and buf_fbr-gds-obj.obj-type = p-obj-type
     2472              and buf_fbr-gds-obj.obj-code = p-obj-code
     2473       no-error.
     2474       if not available buf_fbr-gds-obj
     2475       or buf_fbr-gds-obj.is-season = no
     2476       then do:
     2477           assign
     2478               p-coeff-value = 0
     2479           .
     2480           return.
     2481       end.
     2482   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2484     (input  p-obj-type
     2485     ,input  p-obj-code
     2486     ,output v-host-code
     2487     )  .
     2488       find last buf_s-coeff no-lock
     2489           where buf_s-coeff.gds-code = p-gds-code
     2490             and buf_s-coeff.host-code = v-host-code
     2491             and buf_s-coeff.obj-type = p-obj-type
     2492             and buf_s-coeff.obj-code = p-obj-code
     2493             and buf_s-coeff.s-date <= v-date
     2494       no-error.
     2495       if available buf_s-coeff
     2496       then do:
     2497           assign
     2498               p-coeff-value = buf_s-coeff.coeff-value
     2499           .
     2500           return.
     2501       end.
     2502       find last buf_s-coeff no-lock
     2503           where buf_s-coeff.gds-code = p-gds-code
     2504             and buf_s-coeff.host-code = v-host-code
     2505             and buf_s-coeff.obj-type = "":U
     2506             and buf_s-coeff.obj-code = 0
     2507             and buf_s-coeff.s-date <= v-date
     2508       no-error.
     2509       if available buf_s-coeff
     2510       then do:
     2511           assign
     2512               p-coeff-value = buf_s-coeff.coeff-value
     2513           .
     2514           return.
     2515       end.
     2516       find last buf_s-coeff no-lock
     2517           where buf_s-coeff.gds-code = p-gds-code
     2518             and buf_s-coeff.host-code = 0
     2519             and buf_s-coeff.obj-type = "":U
     2520             and buf_s-coeff.obj-code = 0
     2521             and buf_s-coeff.s-date <= v-date
     2522       no-error.
     2523       if available buf_s-coeff
     2524       then do:
     2525           assign
     2526               p-coeff-value = buf_s-coeff.coeff-value
     2527           .
     2528       end.
     2529       else do:
     2530           assign
     2531               p-coeff-value = 0
     2532           .
     2533       end.
     2534   end.
     2535   end procedure.
     2536   procedure fbrlib_create-fbr-recipe-gds :
     2537   define input parameter p-doc-code         as character      no-undo.
     2538   define input parameter p-recipe-code      as character      no-undo.
     2539   define input parameter p-prod-type        as character      no-undo.
     2540   define input parameter p-prod-code        as integer        no-undo.
     2541   define input parameter p-artic            as character      no-undo.
     2542   define input parameter p-gds-code         as integer        no-undo.
     2543   define input parameter p-is-waste         as logical        no-undo.
     2544   define input parameter p-proc-number      as integer        no-undo.
     2545   define input parameter p-obj-date         as date           no-undo.
     2546   define input parameter p-obj-type         as character      no-undo.
     2547   define input parameter p-obj-code         as integer        no-undo.
     2548   define input parameter p-calc-method      as decimal        no-undo.
     2549   define input parameter p-coeff-waste      as decimal        no-undo.
     2550   define input parameter p-orig-qnty        as decimal        no-undo.
     2551   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2552       define variable v-coeff-season  as decimal      no-undo.
     2553       define variable v-void-decimal  as decimal      no-undo.
     2554       define variable v-void-integer  as integer      no-undo.
     2555       define variable v-recipe-type   as character    no-undo.
     2556       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2557       define buffer buf_goods             for ub.goods.
     2558       define buffer buf_recipe            for ub.recipe.
     2559   do
     2560   for buf_fbr-recipe-gds
     2561     , buf_recipe
     2562     , buf_goods
     2563   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2564   :
     2565       find first buf_fbr-recipe-gds exclusive-lock
     2566            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2567              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2568              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2569              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2570              and buf_fbr-recipe-gds.artic       = p-artic
     2571       no-error.
     2572       if not available buf_fbr-recipe-gds
     2573       then do:
     2574           create buf_fbr-recipe-gds.
     2575           assign
     2576               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2577               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2578               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2579               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2580               buf_fbr-recipe-gds.artic              = p-artic
     2581               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2582               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2583               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2584               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2585               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2586           .
     2587           find first buf_goods no-lock
     2588                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2589                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2590                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2591           .
     2592           run fbrlib-s-coeff-value in this-procedure (
     2593                 input buf_goods.gds-code
     2594               , input p-obj-date
     2595               , input p-obj-type
     2596               , input p-obj-code
     2597               , output v-coeff-season
     2598           ) no-error.
     2599           if error-status:error
     2600           then do:
     2601               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2602           end.
     2603           assign
     2604               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2605               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2606               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2607           .
     2608           run fbrlib-get-recipe-type in this-procedure (
     2609                 input buf_fbr-recipe-gds.doc-code
     2610               , input buf_fbr-recipe-gds.recipe-code
     2611               , output v-recipe-type
     2612           ).
     2613           if v-recipe-type <> 'производство':U
     2614           then do:
     2615               assign
     2616                   buf_fbr-recipe-gds.coeff-value  = 0
     2617                   buf_fbr-recipe-gds.coeff-waste  = 0
     2618                   buf_fbr-recipe-gds.calc-method  = 1
     2619                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2620               .
     2621           end.
     2622           else do:
     2623               run fbrlib-calc-brutto in this-procedure (
     2624                     input v-recipe-type
     2625                   , input buf_fbr-recipe-gds.qnty
     2626                   , input buf_fbr-recipe-gds.coeff-value
     2627                   , input buf_fbr-recipe-gds.coeff-waste
     2628                   , input 0
     2629                   , input 3
     2630                   , output v-void-decimal
     2631                   , output v-void-decimal
     2632                   , output buf_fbr-recipe-gds.brutto-qnty
     2633                   , output v-void-integer
     2634               ).
     2635               assign
     2636                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2637               .
     2638               run fbrlib-calc-brutto in this-procedure (
     2639                     input v-recipe-type
     2640                   , input buf_fbr-recipe-gds.qnty
     2641                   , input buf_fbr-recipe-gds.coeff-value
     2642                   , input buf_fbr-recipe-gds.coeff-waste
     2643                   , input buf_fbr-recipe-gds.brutto-qnty
     2644                   , input buf_fbr-recipe-gds.calc-method
     2645                   , output buf_fbr-recipe-gds.qnty
     2646                   , output v-void-decimal
     2647                   , output v-void-decimal
     2648                   , output v-void-integer
     2649               ).
     2650           end.
     2651       end.
     2652   end.
     2653   end procedure.
     2654   procedure fbrlib-set-default-recipe :
     2655   define input parameter p-obj-type   as character    no-undo.
     2656   define input parameter p-obj-code   as integer      no-undo.
     2657   define input parameter p-gds-code   as integer      no-undo.
     2658       define variable v-artic             as character    no-undo.
     2659       define variable v-prod-type         as character    no-undo.
     2660       define variable v-prod-code         as character    no-undo.
     2661       define variable v-recipe-code       as character    no-undo.
     2662       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2663       define variable v-recipe-found      as logical      no-undo.
     2664       define buffer buf_recipe        for ub.recipe.
     2665       define buffer buf_other_recipe  for ub.recipe.
     2666       define buffer buf_goods         for ub.goods.
     2667       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2668   do
     2669   for buf_recipe
     2670     , buf_goods
     2671     , buf_fbr-gds-obj
     2672   on error undo, return error
     2673   :
     2674       find first buf_goods no-lock
     2675            where buf_goods.gds-code = p-gds-code
     2676       .
     2677       run fbrlib-get-obj-recipe in this-procedure (
     2678             input p-obj-type
     2679           , input p-obj-code
     2680           , input p-gds-code
     2681           , output v-recipe-code
     2682       ).
     2683       if v-recipe-code <> ""
     2684       then do:
     2685           find first buf_recipe no-lock
     2686               where buf_recipe.recipe-code = v-recipe-code
     2687           no-error.
     2688           if not available buf_recipe
     2689           then do:
     2690               assign
     2691                   v-recipe-code = ""
     2692               .
     2693           end.
     2694       end.
     2695       if v-recipe-code = ""
     2696       then do:
     2697           find first buf_fbr-gds-obj exclusive-lock
     2698                where buf_fbr-gds-obj.obj-type = p-obj-type
     2699                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2700                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2701           no-error.
     2702           if not available buf_fbr-gds-obj
     2703           then do:
     2704               run ref/fgdsobj1.p (
     2705                     input-output v-fbr-gds-obj-recid
     2706                   , input 'ДОБАВЛЕНИЕ':U
     2707                   , input no
     2708                   , input p-gds-code
     2709                   , input p-obj-type
     2710                   , input p-obj-code
     2711                   , input 0
     2712                   , input ""
     2713                   , input 0
     2714                   , input no
     2715                   , input no
     2716                   , input no
     2717                   , input no
     2718                   , input no
     2719                   , input no
     2720               ) no-error.
     2721               if error-status:error
     2722               then do:
     2723                   message
     2724                           vss-workfile vss-revision vss-description
     2725                       skip "Ошибка изменения атрибутов товара на объекте"
     2726                       skip return-value
     2727                       skip trim(error-status :get-message(1))
     2728                               trim(error-status :get-message(2))
     2729                               trim(error-status :get-message(3))
     2730                   view-as alert-box error.
     2731                   undo, return error .
     2732               end.
     2733               find first buf_fbr-gds-obj exclusive-lock
     2734                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2735               .
     2736           end.
     2737           assign
     2738               v-recipe-found = no
     2739           .
     2740           for first buf_recipe no-lock
     2741               where buf_recipe.obj-type    = p-obj-type
     2742                 and buf_recipe.obj-code    = p-obj-code
     2743                 and buf_recipe.artic       = buf_goods.artic
     2744                 and buf_recipe.prod-type   = buf_goods.prod-type
     2745                 and buf_recipe.prod-code   = buf_goods.prod-code
     2746                 and buf_recipe.recipe-type = 'производство':U
     2747                 or (
     2748                     buf_recipe.obj-type    = ""
     2749                 and buf_recipe.obj-code    = 0
     2750                 and buf_recipe.artic       = buf_goods.artic
     2751                 and buf_recipe.prod-type   = buf_goods.prod-type
     2752                 and buf_recipe.prod-code   = buf_goods.prod-code
     2753                 and buf_recipe.recipe-type = 'производство':U
     2754                     )
     2755           :
     2756               assign
     2757                   v-recipe-found = yes
     2758                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2759               .
     2760           end.
     2761           if v-recipe-found = no
     2762           then do:
     2763               for first buf_recipe no-lock
     2764                   where buf_recipe.obj-type    = p-obj-type
     2765                     and buf_recipe.obj-code    = p-obj-code
     2766                     and buf_recipe.artic       = buf_goods.artic
     2767                     and buf_recipe.prod-type   = buf_goods.prod-type
     2768                     and buf_recipe.prod-code   = buf_goods.prod-code
     2769                     and buf_recipe.recipe-type <> 'альтернатива':U
     2770                     or (
     2771                         buf_recipe.obj-type    = ""
     2772                     and buf_recipe.obj-code    = 0
     2773                     and buf_recipe.artic       = buf_goods.artic
     2774                     and buf_recipe.prod-type   = buf_goods.prod-type
     2775                     and buf_recipe.prod-code   = buf_goods.prod-code
     2776                     and buf_recipe.recipe-type <> 'альтернатива':U
     2777                         )
     2778               :
     2779                   assign
     2780                       v-recipe-found = yes
     2781                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2782                   .
     2783               end.
     2784               if v-recipe-found = no
     2785               then do:
     2786                   for first buf_recipe no-lock
     2787                       where buf_recipe.obj-type    = p-obj-type
     2788                         and buf_recipe.obj-code    = p-obj-code
     2789                         and buf_recipe.artic       = buf_goods.artic
     2790                         and buf_recipe.prod-type   = buf_goods.prod-type
     2791                         and buf_recipe.prod-code   = buf_goods.prod-code
     2792                         or (
     2793                             buf_recipe.obj-type    = ""
     2794                         and buf_recipe.obj-code    = 0
     2795                         and buf_recipe.artic       = buf_goods.artic
     2796                         and buf_recipe.prod-type   = buf_goods.prod-type
     2797                         and buf_recipe.prod-code   = buf_goods.prod-code
     2798                             )
     2799                   :
     2800                       assign
     2801                           v-recipe-found = yes
     2802                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2803                       .
     2804                   end.
     2805                   if v-recipe-found = no
     2806                   then do:
     2807                       assign
     2808                           buf_fbr-gds-obj.default-recipe-code = ""
     2809                       .
     2810                   end.
     2811               end.
     2812           end.
     2813       end.
     2814   end.
     2815   end procedure.
     2816   procedure fbrlib-get-obj-recipe :
     2817   define input parameter p-obj-type       as character    no-undo.
     2818   define input parameter p-obj-code       as integer      no-undo.
     2819   define input parameter p-gds-code       as integer      no-undo.
     2820   define output parameter p-recipe-code   as character    no-undo.
     2821       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2822   do
     2823   for buf_fbr-gds-obj
     2824   on error undo, return error
     2825   :
     2826       find first buf_fbr-gds-obj no-lock
     2827            where buf_fbr-gds-obj.obj-type = p-obj-type
     2828              and buf_fbr-gds-obj.obj-code = p-obj-code
     2829              and buf_fbr-gds-obj.gds-code = p-gds-code
     2830       no-error.
     2831       if available buf_fbr-gds-obj
     2832       then do:
     2833           assign
     2834               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2835           .
     2836       end.
     2837       else do:
     2838           assign
     2839               p-recipe-code = ""
     2840           .
     2841       end.
     2842   end.
     2843   end procedure.
     2844   procedure fbrlib-create-or-update-recipe-gds :
     2845   define input parameter p-recipe-code    as character        no-undo.
     2846   define input parameter p-gds-code       as integer          no-undo.
     2847   define input parameter p-is-waste       as logical          no-undo.
     2848   define input parameter p-qnty           as decimal          no-undo.
     2849   define input parameter p-proc-number    as integer          no-undo.
     2850   define input parameter p-nws-self       as logical          no-undo.
     2851       define variable v-max-proc-num  as integer      no-undo.
     2852       define variable v-recipe-type   as character    no-undo.
     2853       define buffer buf_goods             for ub.goods.
     2854       define buffer buf_recipe-gds        for ub.recipe-gds.
     2855       define buffer buf_recipe            for ub.recipe.
     2856       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2857   do
     2858   for buf_goods
     2859     , buf_recipe-gds
     2860     , buf_recipe
     2861     , buf_proc_recipe-gds
     2862   on error undo, return error
     2863   :
     2864       find first buf_recipe no-lock
     2865            where buf_recipe.recipe-code = p-recipe-code
     2866       .
     2867       find first buf_goods no-lock
     2868            where buf_goods.gds-code = p-gds-code
     2869       .
     2870       find first buf_recipe-gds
     2871            where buf_recipe-gds.recipe-code = p-recipe-code
     2872              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2873              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2874              and buf_recipe-gds.artic       = buf_goods.artic
     2875       no-error.
     2876       if not available buf_recipe-gds
     2877       then do:
     2878           create buf_recipe-gds.
     2879           assign
     2880               buf_recipe-gds.recipe-code = p-recipe-code
     2881               buf_recipe-gds.gds-code    = p-gds-code
     2882               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2883               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2884               buf_recipe-gds.artic       = buf_goods.artic
     2885           .
     2886           assign
     2887               buf_recipe-gds.is-waste    = no
     2888               buf_recipe-gds.qnty        = 0
     2889               buf_recipe-gds.coeff-waste = 0
     2890               buf_recipe-gds.brutto-qnty = 0
     2891               buf_recipe-gds.proc-number = 0
     2892               buf_recipe-gds.nws-self    = no
     2893           .
     2894       end.
     2895       assign
     2896           buf_recipe-gds.is-waste    = p-is-waste
     2897       .
     2898       run fbrlib-get-recipe-type in this-procedure (
     2899             input "":U
     2900           , input buf_recipe-gds.recipe-code
     2901           , output v-recipe-type
     2902       ).
     2903       if v-recipe-type <> 'производство':U
     2904       then do:
     2905           assign
     2906               buf_recipe-gds.calc-method = 1
     2907               buf_recipe-gds.qnty        = p-qnty
     2908               buf_recipe-gds.brutto-qnty = p-qnty
     2909               buf_recipe-gds.coeff-waste = 0
     2910           .
     2911       end.
     2912       else do:
     2913           assign
     2914               buf_recipe-gds.calc-method = 1
     2915               buf_recipe-gds.brutto-qnty = p-qnty
     2916           .
     2917           run fbrlib-calc-brutto in this-procedure (
     2918                 input v-recipe-type
     2919               , input 0
     2920               , input 0
     2921               , input buf_recipe-gds.coeff-waste
     2922               , input buf_recipe-gds.brutto-qnty
     2923               , input 1
     2924               , output buf_recipe-gds.qnty
     2925               , output buf_recipe-gds.coeff-waste
     2926               , output buf_recipe-gds.brutto-qnty
     2927               , output buf_recipe-gds.calc-method
     2928           ).
     2929       end.
     2930       assign
     2931           buf_recipe-gds.nws-self    = p-nws-self
     2932       .
     2933       if buf_recipe.recipe-type = 'альтернатива':U
     2934       and buf_recipe-gds.proc-number <> 0
     2935       then do:
     2936       end.
     2937       else do:
     2938           if p-proc-number <> 0
     2939           then do:
     2940               assign
     2941                   buf_recipe-gds.proc-number = p-proc-number
     2942               .
     2943           end.
     2944           else do:
     2945               assign
     2946                   v-max-proc-num = 0
     2947               .
     2948               for each buf_proc_recipe-gds no-lock
     2949                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2950               :
     2951                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2952                   then do:
     2953                       assign
     2954                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2955                       .
     2956                   end.
     2957               end.
     2958               assign
     2959                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2960               .
     2961           end.
     2962       end.
     2963   end.
     2964   end procedure.
     2965   PROCEDURE fbrlib-create-or-update-recipe :
     2966   define input parameter p-mode               as character    no-undo.
     2967   define input parameter p-obj-type           as character    no-undo.
     2968   define input parameter p-obj-code           as integer      no-undo.
     2969   define input parameter p-recipe-code        as character    no-undo.
     2970   define input parameter p-recipe-type        as character    no-undo.
     2971   define input parameter p-gds-code           as integer      no-undo.
     2972   define input parameter p-name               as character    no-undo.
     2973   define input parameter p-design             as character    no-undo.
     2974   define input parameter p-order              as integer      no-undo.
     2975   define input parameter p-quality            as character    no-undo.
     2976   define input parameter p-ref-num            as character    no-undo.
     2977   define input parameter p-technique          as character    no-undo.
     2978   define input parameter p-template           as character    no-undo.
     2979   define input parameter p-qnty               as decimal      no-undo.
     2980   define input parameter p-portion-qnty       as integer      no-undo.
     2981   define input parameter p-portion-weight     as decimal      no-undo.
     2982   define output parameter p-new-recipe-code   as character    no-undo.
     2983       define variable v-host-code         as integer      no-undo.
     2984       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2985       define buffer buf_recipe    for ub.recipe.
     2986       define buffer buf_goods     for ub.goods.
     2987   do
     2988   for buf_recipe
     2989     , buf_goods
     2990   on error undo, return error
     2991   :
     2992       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2993       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2994       then do:
     2995           message
     2996               skip "Ошибка задания типа операции для создания или измения рецепта."
     2997               skip (1)
     2998               skip "Задан тип операции:" p-mode
     2999           view-as alert-box error.
     3000           undo, return error .
     3001       end.
     3002       if p-recipe-code = ""
     3003       then do:
     3004   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3006     (input  p-obj-type
     3007     ,input  p-obj-code
     3008     ,output v-host-code
     3009     )  .
     3010           find first buf_goods no-lock
     3011                where buf_goods.gds-code = p-gds-code
     3012           .
     3013           create buf_recipe .
     3014           run fbrcode-gen-recipe-code in this-procedure (
     3015                 input p-obj-type
     3016               , input p-obj-code
     3017               , output buf_recipe.recipe-code
     3018           ).
     3019           assign
     3020               buf_recipe.artic               = buf_goods.artic
     3021               buf_recipe.prod-type           = buf_goods.prod-type
     3022               buf_recipe.prod-code           = buf_goods.prod-code
     3023               buf_recipe.recipe-type         = p-recipe-type
     3024               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3025               buf_recipe.gds-code            = p-gds-code
     3026               buf_recipe.host-code           = v-host-code
     3027               buf_recipe.obj-type            = p-obj-type
     3028               buf_recipe.obj-code            = p-obj-code
     3029               buf_recipe.recipe-design       = ""
     3030               buf_recipe.recipe-order        = 0
     3031               buf_recipe.recipe-quality      = ""
     3032               buf_recipe.recipe-ref-num      = ""
     3033               buf_recipe.recipe-technique    = ""
     3034               buf_recipe.recipe-template     = ""
     3035               buf_recipe.qnty                = 1.0
     3036               buf_recipe.portion-qnty        = 1
     3037               buf_recipe.portion-weight      = 0
     3038           .
     3039       end.
     3040       if p-name <> ""
     3041       then do:
     3042           assign
     3043               buf_recipe.recipe-name = p-name
     3044           .
     3045       end.
     3046       assign
     3047           buf_recipe.recipe-design       = p-design
     3048           buf_recipe.recipe-order        = p-order
     3049           buf_recipe.recipe-quality      = p-quality
     3050           buf_recipe.recipe-ref-num      = p-ref-num
     3051           buf_recipe.recipe-technique    = p-technique
     3052           buf_recipe.recipe-template     = p-template
     3053           buf_recipe.qnty                = p-qnty
     3054           buf_recipe.portion-qnty        = p-portion-qnty
     3055           buf_recipe.portion-weight      = p-portion-weight
     3056       .
     3057       assign
     3058           p-new-recipe-code = buf_recipe.recipe-code
     3059       .
     3060       run fbrlib-set-default-recipe in this-procedure (
     3061             input p-obj-type
     3062           , input p-obj-code
     3063           , input buf_goods.gds-code
     3064       ).
     3065   end.
     3066   END PROCEDURE.
     3067   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3068   define input parameter parparentproc-handle as widget-handle no-undo .
     3069   define input parameter p-doc-code   as character no-undo.
     3070   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3071       define variable v-shift-on      as logical      no-undo.
     3072       define variable v-shift-date    as date         no-undo.
     3073       define variable v-shift-num     as integer      no-undo.
     3074       define variable v-shift-name    as character    no-undo.
     3075       define variable v-obj-date      as date         no-undo.
     3076       define variable v-chip-num      as integer      no-undo.
     3077       define buffer buf_fbr-doc       for ub.fbr-doc.
     3078       define buffer buf_fbr-line      for ub.fbr-line.
     3079       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3080       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3081       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3082       define buffer buf_marking-lines for ub.marking-lines .
     3083       define buffer buf_marking       for ub.marking .
     3084       define buffer buf_goods         for ub.goods .
     3085   do
     3086   for buf_fbr-doc
     3087     , buf_fbr-line
     3088     , buf_c-fbr-doc
     3089     , buf_fbr-recipe
     3090     , buf_fbr-recipe-gds
     3091     , buf_goods
     3092     , buf_marking
     3093     , buf_marking-lines
     3094   on error undo, return error
     3095   :
     3096   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3097     define variable v-cntxt-db-num        as integer   no-undo .
     3098     define variable v-cntxt-userid        as character no-undo .
     3099     define variable v-cntxt-level         as character no-undo .
     3100     define variable v-cntxt-host-code-obj as integer   no-undo .
     3101     define variable v-cntxt-obj-type      as character no-undo .
     3102     define variable v-cntxt-obj-code      as integer   no-undo .
     3103     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3104     define variable v-cntxt-is-admin      as logical   no-undo .
     3105   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3106     run mainmenu_getcntxt in parparentproc-handle
     3107       (output v-cntxt-db-num
     3108       ,output v-cntxt-userid
     3109       ,output v-cntxt-level
     3110       ,output v-cntxt-host-code-obj
     3111       ,output v-cntxt-obj-type
     3112       ,output v-cntxt-obj-code
     3113       ,output v-cntxt-db-num-obj
     3114       ,output v-cntxt-is-admin
     3115       ) .
     3116       if search ("delfbr.err") <> ?
     3117       then do:
     3118           os-delete "delfbr.err".
     3119       end.
     3120     _del-block:
     3121       do transaction
     3122     on error undo _del-block, return error return-value
     3123     on endkey undo _del-block , return error return-value
     3124     on stop undo _del-block , return error return-value
     3125       :
     3126           find first buf_fbr-doc exclusive-lock
     3127                where buf_fbr-doc.doc-code = p-doc-code
     3128           no-error.
     3129           if not available buf_fbr-doc
     3130           then do:
     3131         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3132                                           ,vss-workfile
     3133                                           ,vss-revision
     3134                                           ,vss-description
     3135                                           ,chr(10)
     3136                                           , p-doc-code).
     3137           end.
     3138           run fbrlib-delete-fact-trn-doc in this-procedure (
     3139               input parparentproc-handle
     3140              ,input p-doc-code
     3141              ,input 'при':U
     3142              ,input p-chip-num
     3143              ,output v-chip-num
     3144           ) no-error.
     3145           if error-status :error
     3146           then do:
     3147               run fbrlib-print-del-error-message in this-procedure .
     3148         undo _del-block, return error.
     3149           end.
     3150           assign
     3151           p-chip-num = (if p-chip-num = ?
     3152                         then v-chip-num
     3153                         else p-chip-num).
     3154           run fbrlib-delete-fact-trn-doc in this-procedure (
     3155               input parparentproc-handle
     3156              ,input p-doc-code
     3157              ,input 'рас':U
     3158              ,input p-chip-num
     3159              ,output v-chip-num
     3160           ) no-error.
     3161           if error-status :error
     3162           then do:
     3163               run fbrlib-print-del-error-message in this-procedure .
     3164         undo _del-block, return error.
     3165           end.
     3166           run fbrlib-delete-fact-trn-doc in this-procedure (
     3167               input parparentproc-handle
     3168              ,input p-doc-code
     3169              ,input 'спи':U
     3170              ,input p-chip-num
     3171              ,output v-chip-num
     3172           ) no-error.
     3173           if error-status :error
     3174           then do:
     3175               run fbrlib-print-del-error-message in this-procedure .
     3176         undo _del-block, return error.
     3177           end.
     3178           create buf_c-fbr-doc.
     3179           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3180   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3182     (input  buf_fbr-doc.obj-type
     3183     ,input  buf_fbr-doc.obj-code
     3184     ,output v-obj-date
     3185     ) no-error .
     3186           if error-status :error
     3187           or v-obj-date = ?
     3188           then do:
     3189         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3190           end.
     3191   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3193     (input  buf_fbr-doc.obj-type
     3194     ,input  buf_fbr-doc.obj-code
     3195     ,input  'shift-on=request'
     3196     ,output v-shift-on
     3197     )  .
     3198           if v-shift-on
     3199           then do:
     3200   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3202     (input  buf_fbr-doc.obj-type
     3203     ,input  buf_fbr-doc.obj-code
     3204     ,output v-shift-date
     3205     ,output v-shift-num
     3206     ,output v-shift-name
     3207     ) no-error .
     3208               if error-status :error
     3209               then do:
     3210           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3211               end.
     3212           end.
     3213           else do:
     3214               assign
     3215                   v-shift-date = ?
     3216                   v-shift-num  = ?
     3217                   v-shift-name = ?
     3218               .
     3219           end.
     3220           define variable v-today       as date         no-undo.
     3221           define variable v-time        as integer      no-undo.
     3222           run cur-time in this-procedure (
     3223                 output v-today
     3224               , output v-time
     3225           ).
     3226           assign
     3227               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3228               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3229               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3230               buf_c-fbr-doc.corr-date        = v-today
     3231               buf_c-fbr-doc.corr-time        = v-time
     3232               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3233               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3234               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3235               buf_c-fbr-doc.is-del           = yes
     3236           .
     3237           assign
     3238               buf_fbr-doc.is-del = yes
     3239           .
     3240           for each buf_fbr-line exclusive-lock
     3241              where buf_fbr-line.doc-code = p-doc-code
     3242       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3243       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3244       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3245           :
     3246               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3247                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3248                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3249               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3250                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3251                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3252                                                       and buf_marking-lines.in-code  = "manufacturing"
     3253                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3254                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3255                                                       and buf_marking-lines.prt-code = 0
     3256               :
     3257                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3258                   assign
     3259                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3260                   .
     3261                 end .
     3262                 delete buf_marking-lines.
     3263               end .
     3264               delete buf_fbr-line.
     3265           end.
     3266           for each buf_fbr-recipe exclusive-lock
     3267              where buf_fbr-recipe.doc-code = p-doc-code
     3268       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3269       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3270       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3271           :
     3272               delete buf_fbr-recipe.
     3273           end.
     3274           for each buf_fbr-recipe-gds exclusive-lock
     3275              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3276       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3277       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3278       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3279           :
     3280               delete buf_fbr-recipe-gds.
     3281           end.
     3282           delete buf_fbr-doc.
     3283       end.
     3284   end.
     3285   END PROCEDURE.
     3286   PROCEDURE fbrlib-del-trn-doc :
     3287   do
     3288   on error undo, return error
     3289   :
     3290   define input parameter parparentproc        as widget-handle no-undo .
     3291   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3292   define input parameter p-trn-doc-type       as character    no-undo.
     3293   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3294   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3295       define variable v-trn-doc-doc-code  as character     no-undo.
     3296       define buffer buf_trn-doc       for ub.trn-doc.
     3297   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3298     define variable v-cntxt-db-num        as integer   no-undo .
     3299     define variable v-cntxt-userid        as character no-undo .
     3300     define variable v-cntxt-level         as character no-undo .
     3301     define variable v-cntxt-host-code-obj as integer   no-undo .
     3302     define variable v-cntxt-obj-type      as character no-undo .
     3303     define variable v-cntxt-obj-code      as integer   no-undo .
     3304     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3305     define variable v-cntxt-is-admin      as logical   no-undo .
     3306   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3307     run mainmenu_getcntxt in parparentproc
     3308       (output v-cntxt-db-num
     3309       ,output v-cntxt-userid
     3310       ,output v-cntxt-level
     3311       ,output v-cntxt-host-code-obj
     3312       ,output v-cntxt-obj-type
     3313       ,output v-cntxt-obj-code
     3314       ,output v-cntxt-db-num-obj
     3315       ,output v-cntxt-is-admin
     3316       ) .
     3317       run fbrcode-trn-doc in this-procedure (
     3318             input 'производство':U
     3319           , input p-fbr-doc-doc-code
     3320           , input p-trn-doc-type
     3321           , output v-trn-doc-doc-code
     3322       ).
     3323       find first buf_trn-doc no-lock
     3324            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3325       no-error.
     3326       if available buf_trn-doc
     3327       then do:
     3328           run str/del-doc.p (
     3329                 input parparentproc
     3330               , input buf_trn-doc.doc-code
     3331               , input v-cntxt-db-num
     3332               , input "del-doc.err"
     3333               , input ?
     3334               , input p-fbr-doc-doc-code
     3335               , input v-cntxt-userid
     3336               , input 0
     3337               , input p-phchip-num
     3338               , output p-chip-num
     3339           ) no-error.
     3340           if error-status :error
     3341           then do:
     3342             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3343                                           ,v-trn-doc-doc-code
     3344                                           ,p-fbr-doc-doc-code
     3345                                           , chr(10)
     3346                                           , error-status:get-message(1)
     3347                                           , return-value ).
     3348           end.
     3349       end.
     3350   end.
     3351   END PROCEDURE.
     3352   PROCEDURE fbrlib-delete-fact-trn-doc :
     3353   define input parameter parparentproc    as widget-handle    no-undo.
     3354   define input parameter p-fbr-doc-code   as character        no-undo.
     3355   define input parameter p-doc-type       as character    no-undo.
     3356   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3357   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3358       define variable v-doc-code          as character        no-undo.
     3359       define variable v-ext-doc-type      as character        no-undo.
     3360       define variable v-trn-doc-recid     as recid            no-undo.
     3361       define variable varchip-code        as integer          no-undo.
     3362       define variable varchip-code2       as integer          no-undo.
     3363       define variable v-chip-counter      as integer          no-undo.
     3364       define buffer buf_trn-doc       for ub.trn-doc.
     3365       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3366       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3367   do
     3368   for buf_trn-doc
     3369     , buf_pri_trn-doc
     3370     , buf_cons_trn-doc
     3371   on error undo, return error
     3372   :
     3373   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3374     define variable v-cntxt-db-num        as integer   no-undo .
     3375     define variable v-cntxt-userid        as character no-undo .
     3376     define variable v-cntxt-level         as character no-undo .
     3377     define variable v-cntxt-host-code-obj as integer   no-undo .
     3378     define variable v-cntxt-obj-type      as character no-undo .
     3379     define variable v-cntxt-obj-code      as integer   no-undo .
     3380     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3381     define variable v-cntxt-is-admin      as logical   no-undo .
     3382   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3383     run mainmenu_getcntxt in parparentproc
     3384       (output v-cntxt-db-num
     3385       ,output v-cntxt-userid
     3386       ,output v-cntxt-level
     3387       ,output v-cntxt-host-code-obj
     3388       ,output v-cntxt-obj-type
     3389       ,output v-cntxt-obj-code
     3390       ,output v-cntxt-db-num-obj
     3391       ,output v-cntxt-is-admin
     3392       ) .
     3393       run fbrcode-trn-doc in this-procedure (
     3394             input 'производство':U
     3395           , input p-fbr-doc-code
     3396           , input p-doc-type
     3397           , output v-doc-code
     3398       ).
     3399       find first buf_trn-doc no-lock
     3400            where buf_trn-doc.doc-code = v-doc-code
     3401       no-error.
     3402       if not available buf_trn-doc
     3403       then do:
     3404           if p-doc-type <> 'спи':U
     3405           then do:
     3406               message
     3407                   "Не найден документ '" p-doc-type "'"
     3408                   "по документу производства " p-fbr-doc-code
     3409               view-as alert-box.
     3410               undo, return error.
     3411           end.
     3412           else do:
     3413           end.
     3414       end.
     3415       else do:
     3416           assign
     3417               v-trn-doc-recid = recid( buf_trn-doc )
     3418               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3419           .
     3420           if v-ext-doc-type = 'ev':U
     3421           then do:
     3422               find first buf_pri_trn-doc no-lock
     3423                    where buf_pri_trn-doc.out-code     = v-doc-code
     3424                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3425               no-error.
     3426               if available buf_pri_trn-doc
     3427               then do:
     3428                   run str/del-doc.p (
     3429                         input parparentproc
     3430                       , input buf_pri_trn-doc.doc-code
     3431                       , input v-cntxt-db-num
     3432                       , input "delfbr.err"
     3433                       , input ?
     3434                       , input p-fbr-doc-code
     3435                       , input v-cntxt-userid
     3436                       , input 0
     3437                       , input (if p-ph-chip-num <> ?
     3438                               then p-ph-chip-num
     3439                               else (if varchip-code <> 0
     3440                                   then varchip-code
     3441                                   else ?)
     3442                               )
     3443                       , output varchip-code2
     3444                   ) no-error.
     3445                   if error-status :error
     3446                   then do:
     3447                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3448                                                   ,buf_pri_trn-doc.doc-code
     3449                                                   ,p-fbr-doc-code
     3450                                                   , chr(10)
     3451                                                   , error-status:get-message(1)
     3452                                                   , return-value ).
     3453                   end.
     3454               end.
     3455           end.
     3456           define buffer buf_out_trn-doc       for ub.trn-doc.
     3457           if p-doc-type = 'при':U
     3458           then do:
     3459               assign
     3460                   v-chip-counter = 0
     3461               .
     3462               for each buf_out_trn-doc exclusive-lock
     3463                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3464               on error undo, return error
     3465               :
     3466                   assign
     3467                       v-chip-counter = v-chip-counter + 1
     3468                   .
     3469                   if v-chip-counter > 1
     3470                   then do:
     3471                       assign
     3472                           varchip-code = varchip-code2
     3473                       .
     3474                   end.
     3475                   run str/del-doc.p (
     3476                         input parparentproc
     3477                       , input buf_out_trn-doc.doc-code
     3478                       , input v-cntxt-db-num
     3479                       , input "delfbr.err"
     3480                       , input ?
     3481                       , input p-fbr-doc-code
     3482                       , input v-cntxt-userid
     3483                       , input 0
     3484                       , input (if p-ph-chip-num <> ?
     3485                               then p-ph-chip-num
     3486                               else (if varchip-code <> 0
     3487                                   then varchip-code
     3488                                   else ?)
     3489                               )
     3490                       , output varchip-code2
     3491                   ) no-error.
     3492                   if error-status :error
     3493                   then do:
     3494                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3495                                                   ,buf_out_trn-doc.doc-code
     3496                                                   ,buf_trn-doc.doc-code
     3497                                                   ,p-fbr-doc-code
     3498                                                   , chr(10)
     3499                                                   , error-status:get-message(1)
     3500                                                   , return-value ).
     3501                   end.
     3502               end.
     3503           end.
     3504           run str/del-doc.p (
     3505                 input parparentproc
     3506               , input buf_trn-doc.doc-code
     3507               , input v-cntxt-db-num
     3508               , input "delfbr.err"
     3509               , input ?
     3510               , input p-fbr-doc-code
     3511               , input v-cntxt-userid
     3512               , input 0
     3513               , input (if p-ph-chip-num <> ?
     3514                        then p-ph-chip-num
     3515                        else (if varchip-code <> 0
     3516                              then varchip-code
     3517                              else ?)
     3518                        )
     3519               , output varchip-code2
     3520           ) no-error.
     3521           if error-status :error
     3522           then do:
     3523               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3524                                             ,buf_trn-doc.doc-code
     3525                                             ,p-fbr-doc-code
     3526                                             , chr(10)
     3527                                             , error-status:get-message(1)
     3528                                             , return-value ).
     3529           end.
     3530           if p-doc-type = 'рас':U
     3531           or p-doc-type = 'спи':U
     3532           then do:
     3533               assign
     3534                   v-chip-counter = 0
     3535               .
     3536               for each buf_cons_trn-doc no-lock
     3537                  where buf_cons_trn-doc.out-code      = v-doc-code
     3538                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3539               :
     3540                   assign
     3541                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3542                       v-chip-counter = v-chip-counter + 1
     3543                   .
     3544                   assign
     3545                   varchip-code = if v-chip-counter = 2
     3546                                  then varchip-code2
     3547                                  else varchip-code.
     3548                   run str/del-doc.p (
     3549                         input parparentproc
     3550                       , input buf_cons_trn-doc.doc-code
     3551                       , input v-cntxt-db-num
     3552                       , input "delfbr.err"
     3553                       , input ?
     3554                       , input ?
     3555                       , input v-cntxt-userid
     3556                       , input 0
     3557                       , input (if p-ph-chip-num <> ?
     3558                                then p-ph-chip-num
     3559                                else ( if v-chip-counter = 1
     3560                                       then ?
     3561                                       else varchip-code )
     3562                                )
     3563                       , output varchip-code2
     3564                   ) no-error.
     3565                   if error-status :error
     3566                   then do:
     3567                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3568                                                     ,buf_cons_trn-doc.doc-code
     3569                                                     ,p-fbr-doc-code
     3570                                                     , chr(10)
     3571                                                     , error-status:get-message(1)
     3572                                                     , return-value ).
     3573                   end.
     3574                   assign
     3575                       p-chip-num = varchip-code2
     3576                   .
     3577               end.
     3578           end.
     3579           assign
     3580               p-chip-num = varchip-code2
     3581           .
     3582       end.
     3583   end.
     3584   END PROCEDURE.
     3585   PROCEDURE fbrlib-print-del-error-message :
     3586   do
     3587   on error undo, return error
     3588   :
     3589       define variable v-user-action   as character    no-undo.
     3590       define variable v-printed       as logical      no-undo.
     3591       message
     3592           vss-workfile vss-revision vss-description
     3593           skip "Ошибка при удалении документа."
     3594           skip return-value
     3595           skip trim(error-status :get-message(1))
     3596           skip trim(error-status :get-message(2))
     3597           skip trim(error-status :get-message(3))
     3598       view-as alert-box error.
     3599       if search ("delfbr.err") <> ?
     3600       then do:
     3601         run gbl/prnfilen.w
     3602           (input  "Ошибки при удалении документа производства"
     3603           ,input  0
     3604           ,input  "delfbr.err"
     3605           ,input  7
     3606           ,output v-user-action
     3607           ,output v-printed
     3608           ).
     3609       end.
     3610   end.
     3611   END PROCEDURE.
     3612   procedure fbrlib-calc-brutto :
     3613   define input parameter p-recipe-type        as character        no-undo.
     3614   define input parameter p-netto              as decimal          no-undo.
     3615   define input parameter p-coeff-value        as decimal          no-undo.
     3616   define input parameter p-coeff-waste        as decimal          no-undo.
     3617   define input parameter p-brutto             as decimal          no-undo.
     3618   define input parameter p-calc-method        as integer          no-undo.
     3619   define output parameter p-new-netto         as decimal          no-undo.
     3620   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3621   define output parameter p-new-brutto        as decimal          no-undo.
     3622   define output parameter p-new-calc-method   as integer          no-undo.
     3623   do
     3624   on error undo, return error
     3625   :
     3626       if p-recipe-type <> 'производство':U
     3627       then do:
     3628           assign
     3629               p-new-coeff-waste = 0
     3630               p-new-calc-method = 1
     3631               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3632               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3633           .
     3634       end.
     3635       else do:
     3636           assign
     3637               p-new-calc-method = p-calc-method
     3638           .
     3639           if p-coeff-waste = 0
     3640           then do:
     3641               assign
     3642                   p-coeff-value = 0
     3643               .
     3644           end.
     3645           case p-calc-method
     3646           :
     3647               when 1
     3648               then do:
     3649                   assign
     3650                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3651                       p-new-coeff-waste   = p-coeff-waste
     3652                       p-new-brutto        = p-brutto
     3653                   .
     3654               end.
     3655               when 2
     3656               then do:
     3657                   assign
     3658                       p-new-netto         = p-netto
     3659                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3660                       p-new-brutto        = p-brutto
     3661                   .
     3662               end.
     3663               when 3
     3664               then do:
     3665                   assign
     3666                       p-new-netto         = p-netto
     3667                       p-new-coeff-waste   = p-coeff-waste
     3668                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3669                   .
     3670               end.
     3671               otherwise do:
     3672                   define variable v-yesno    as logical      no-undo.
     3673                   assign
     3674                       v-yesno = yes
     3675                   .
     3676                   message
     3677                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3678                       skip "Значение метода должно быть 1, 2 или 3."
     3679                       skip(1)
     3680                       skip "Заданное значение:" p-calc-method
     3681                       skip(1)
     3682                       skip "Установить значение метода расчета 1"
     3683                       skip "(расчет нетто по брутто и проценту потерь)?"
     3684                   view-as alert-box warning
     3685                   buttons yes-no
     3686                   title "Неверное значение метода пересчета в строках документа-производства"
     3687                   update v-yesno
     3688                   .
     3689                   if v-yesno = yes
     3690                   then do:
     3691                       assign
     3692                           p-new-calc-method   = 1
     3693                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3694                           p-new-coeff-waste   = p-coeff-waste
     3695                           p-new-brutto        = p-brutto
     3696                       .
     3697                   end.
     3698                   else do:
     3699                       message
     3700                               vss-workfile vss-revision vss-description
     3701                           skip(1)
     3702                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3703                           skip return-value
     3704                           skip trim(error-status :get-message(1))
     3705                               trim(error-status :get-message(2))
     3706                               trim(error-status :get-message(3))
     3707                       view-as alert-box error
     3708                       title "Неверное значение метода расчета"
     3709                       .
     3710                       undo, return error .
     3711                   end.
     3712               end.
     3713           end case.
     3714       end.
     3715   end.
     3716   end procedure.
     3717   procedure fbrlib-check-brutto :
     3718   define input parameter p-recipe-type        as character        no-undo.
     3719   define input parameter p-netto              as decimal          no-undo.
     3720   define input parameter p-coeff-value        as decimal          no-undo.
     3721   define input parameter p-coeff-waste        as decimal          no-undo.
     3722   define input parameter p-brutto             as decimal          no-undo.
     3723   define input parameter p-calc-method        as integer          no-undo.
     3724   define output parameter p-error-message     as character        no-undo.
     3725   define output parameter p-not-good          as logical          no-undo.
     3726   do
     3727   on error undo, return error
     3728   :
     3729       if p-recipe-type <> 'производство':U
     3730       then do:
     3731           if p-netto <> p-brutto
     3732           or p-coeff-waste <> 0
     3733           then do:
     3734               assign
     3735                   p-not-good      = yes
     3736                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3737                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3738               .
     3739           end.
     3740       end.
     3741       else do:
     3742           if p-coeff-waste = 0
     3743           then do:
     3744               assign
     3745                   p-coeff-value = 0
     3746               .
     3747           end.
     3748           case p-calc-method
     3749           :
     3750               when 1
     3751               then do:
     3752                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3753                   then do:
     3754                       assign
     3755                           p-not-good      = yes
     3756                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3757                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3758                       .
     3759                   end.
     3760               end.
     3761               when 2
     3762               then do:
     3763                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3764                   then do:
     3765                       assign
     3766                           p-not-good      = yes
     3767                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3768                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3769                       .
     3770                   end.
     3771               end.
     3772               when 3
     3773               then do:
     3774                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3775                   then do:
     3776                       assign
     3777                           p-not-good      = yes
     3778                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3779                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3780                       .
     3781                   end.
     3782               end.
     3783               otherwise do:
     3784                   assign
     3785                       p-not-good      = yes
     3786                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3787                   .
     3788               end.
     3789           end case.
     3790       end.
     3791   end.
     3792   end procedure.
     3793   procedure fbrlib-check-fbr-recipe :
     3794   define input parameter p-doc-code       as character        no-undo.
     3795   define input parameter p-recipe-code    as character        no-undo.
     3796   define output parameter p-is-correct    as logical          no-undo.
     3797       define variable v-comp-factor    as decimal      no-undo.
     3798       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3799       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3800       define buffer buf_fbr-line          for ub.fbr-line.
     3801   do
     3802   for buf_fbr-recipe
     3803     , buf_fbr-recipe-gds
     3804     , buf_fbr-line
     3805   on error undo, return error
     3806   :
     3807       assign
     3808           p-is-correct = yes
     3809       .
     3810       find first buf_fbr-recipe no-lock
     3811            where buf_fbr-recipe.doc-code    = p-doc-code
     3812              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3813       .
     3814       if not available buf_fbr-recipe then do:
     3815         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3816       end.
     3817       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3818       then do:
     3819       end.
     3820       else do:
     3821           find first buf_fbr-line no-lock
     3822                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3823                  and buf_fbr-line.is-comp     = yes
     3824                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3825                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3826                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3827                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3828           .
     3829           assign
     3830               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3831           .
     3832           recipe-line-cycle:
     3833           for each buf_fbr-recipe-gds no-lock
     3834              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3835                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3836           on error undo, return error
     3837           :
     3838               find first buf_fbr-line no-lock
     3839                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3840                      and buf_fbr-line.is-comp     = no
     3841                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3842                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3843                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3844                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3845               .
     3846               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3847               then do:
     3848                   assign
     3849                       p-is-correct = no
     3850                   .
     3851                   leave recipe-line-cycle.
     3852               end.
     3853           end.
     3854       end.
     3855   end.
     3856   end procedure.
     3857   procedure fbrlib-get-recipe-type :
     3858   define input parameter p-fbr-doc-code   as character        no-undo.
     3859   define input parameter p-recipe-code    as character        no-undo.
     3860   define output parameter p-recipe-type   as character        no-undo.
     3861       define buffer buf_recipe        for ub.recipe.
     3862       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3863   do
     3864   for buf_recipe
     3865     , buf_fbr-recipe
     3866   on error undo, return error
     3867   :
     3868       if p-fbr-doc-code = ""
     3869       then do:
     3870           find first buf_recipe no-lock
     3871                where buf_recipe.recipe-code = p-recipe-code
     3872           no-error.
     3873           if available buf_recipe
     3874           then do:
     3875               assign
     3876                   p-recipe-type = buf_recipe.recipe-type
     3877               .
     3878           end.
     3879           else do:
     3880               assign
     3881                   p-recipe-type = "":U
     3882               .
     3883           end.
     3884       end.
     3885       else do:
     3886           find first buf_fbr-recipe no-lock
     3887                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3888                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3889           no-error.
     3890           if available buf_fbr-recipe
     3891           then do:
     3892               assign
     3893                   p-recipe-type = buf_fbr-recipe.recipe-type
     3894               .
     3895           end.
     3896           else do:
     3897               assign
     3898                   p-recipe-type = "":U
     3899               .
     3900           end.
     3901       end.
     3902   end.
     3903   end procedure.
     3904   PROCEDURE calc-comp-from-ingr :
     3905   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3906   define input parameter p-fact-qnty                          as decimal      no-undo.
     3907   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3908   define output parameter p-comp-qnty                         as decimal      no-undo.
     3909       define variable v-ingr-qnty     as decimal       no-undo.
     3910       define buffer buf_i_fbr-line    for ub.fbr-line.
     3911       define buffer buf_fbr-line      for ub.fbr-line.
     3912       define buffer buf_recipe        for ub.fbr-recipe.
     3913       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3914   do
     3915   for buf_i_fbr-line
     3916     , buf_fbr-line
     3917     , buf_recipe
     3918     , buf_recipe-gds
     3919   on error undo, return error
     3920   :
     3921       find first buf_i_fbr-line no-lock
     3922            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3923       .
     3924       find first buf_recipe no-lock
     3925            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3926              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3927       no-error.
     3928       if not available buf_recipe
     3929       then do:
     3930           message
     3931                   vss-workfile vss-revision vss-description
     3932               skip "В строке производства не указан рецепт."
     3933               skip "Невозможно рассчитать количество составного товара."
     3934               skip return-value
     3935               skip trim(error-status :get-message(1))
     3936                   trim(error-status :get-message(2))
     3937                   trim(error-status :get-message(3))
     3938           view-as alert-box error.
     3939           undo, return error .
     3940       end.
     3941       if buf_recipe.recipe-type = 'альтернатива':U
     3942       then do:
     3943           for each buf_fbr-line no-lock
     3944              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3945                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3946                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3947           on error undo, return error
     3948           :
     3949               find first buf_recipe-gds no-lock
     3950                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3951                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3952                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3953                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3954                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3955               .
     3956               assign
     3957                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3958               .
     3959           end.
     3960           assign
     3961               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3962           .
     3963       end.
     3964       else do:
     3965           find first buf_recipe-gds no-lock
     3966                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3967                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3968                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3969                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3970                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3971           .
     3972           assign
     3973               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3974           .
     3975       end.
     3976       find first buf_fbr-line no-lock
     3977            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3978              and buf_fbr-line.is-comp     = yes
     3979              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3980       .
     3981       assign
     3982           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3983       .
     3984   end.
     3985   END PROCEDURE.
     3986   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3987   define input parameter p-recipe-code    as character    no-undo.
     3988   define input parameter p-gds-code       as integer      no-undo.
     3989   define output parameter p-line-qnty     as decimal      no-undo.
     3990   define output parameter p-used-qnty     as decimal      no-undo.
     3991   define output parameter p-recipe-qnty   as decimal      no-undo.
     3992       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3993   do
     3994   for buf_temp_dressing-ingr
     3995   on error undo, return error
     3996   :
     3997       find first buf_temp_dressing-ingr no-lock
     3998            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3999              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4000       no-error.
     4001       if available buf_temp_dressing-ingr
     4002       then do:
     4003           assign
     4004               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4005               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4006               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4007           .
     4008       end.
     4009       else do:
     4010           assign
     4011               p-line-qnty     = 0
     4012               p-used-qnty     = 0
     4013               p-recipe-qnty   = 0
     4014           .
     4015       end.
     4016   end.
     4017   END PROCEDURE.
     4018   PROCEDURE fbrlib_adjust-recipe :
     4019   do
     4020   on error undo, return error
     4021   :
     4022   define input parameter parparentproc as widget-handle no-undo .
     4023   define input parameter p-fbrhist-handle as handle no-undo .
     4024   define input parameter p-doc-code       as character    no-undo.
     4025   define input parameter p-recipe-code    as character    no-undo.
     4026   define input parameter p-price-sale-obj-type as character no-undo .
     4027   define input parameter p-price-sale-obj-code as integer no-undo .
     4028       define variable v-recipe-qnty       as decimal      no-undo.
     4029       define variable v-comp-qnty         as decimal      no-undo.
     4030       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4031       define variable v-ingr-qnty         as decimal      no-undo.
     4032       define variable v-qnty              as decimal      no-undo.
     4033       define variable v-coeff-waste       as decimal      no-undo.
     4034       define variable v-brutto-qnty       as decimal      no-undo.
     4035       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4036       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4037       define buffer buf_fbr-line          for ub.fbr-line.
     4038       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4039       find first buf_fbr-recipe no-lock
     4040            where buf_fbr-recipe.doc-code      = p-doc-code
     4041              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4042       .
     4043       assign
     4044           v-recipe-qnty = buf_fbr-recipe.qnty
     4045       .
     4046       find first buf_fbr-line no-lock
     4047            where buf_fbr-line.doc-code    = p-doc-code
     4048              and buf_fbr-line.is-comp     = yes
     4049              and buf_fbr-line.recipe-code = p-recipe-code
     4050       .
     4051       assign
     4052           v-comp-qnty = buf_fbr-line.fact-qnty
     4053       .
     4054       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4055       then do:
     4056       end.
     4057       else do:
     4058           for each buf_fbr-recipe-gds no-lock
     4059              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4060                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4061           on error undo, return error
     4062           :
     4063               find first buf_fbr-line no-lock
     4064                    where buf_fbr-line.doc-code    = p-doc-code
     4065                      and buf_fbr-line.is-comp     = no
     4066                      and buf_fbr-line.recipe-code = p-recipe-code
     4067                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4068                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4069                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4070               .
     4071               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4072               then do:
     4073                   do transaction
     4074                   on error undo, return error
     4075                   :
     4076                       find first buf_el_fbr-recipe-gds exclusive-lock
     4077                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4078                       .
     4079                       assign
     4080                           buf_el_fbr-recipe-gds.calc-method   = 1
     4081                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4082                       .
     4083                       run fbrlib-calc-brutto in this-procedure (
     4084                             input buf_fbr-recipe.recipe-type
     4085                           , input 0
     4086                           , input buf_el_fbr-recipe-gds.coeff-value
     4087                           , input buf_el_fbr-recipe-gds.coeff-waste
     4088                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4089                           , input 1
     4090                           , output buf_el_fbr-recipe-gds.qnty
     4091                           , output buf_el_fbr-recipe-gds.coeff-waste
     4092                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4093                           , output buf_el_fbr-recipe-gds.calc-method
     4094                       ).
     4095                   end.
     4096               end.
     4097           end.
     4098           run fbrlib_adjust-doc-lines in this-procedure (
     4099                 input parparentproc
     4100               , input p-fbrhist-handle
     4101               , input p-doc-code
     4102               , input p-recipe-code
     4103               , input p-price-sale-obj-type
     4104               , input p-price-sale-obj-code
     4105           ).
     4106       end.
     4107   end.
     4108   END PROCEDURE.
     4109   PROCEDURE fbrlib_adjust-doc-lines :
     4110   define input parameter parparentproc as widget-handle no-undo .
     4111   define input parameter p-fbrhist-handle as handle no-undo .
     4112   define input parameter p-doc-code       as character    no-undo.
     4113   define input parameter p-recipe-code    as character    no-undo.
     4114   define input parameter p-price-sale-obj-type as character no-undo .
     4115   define input parameter p-price-sale-obj-code as integer no-undo .
     4116   define variable v-comp-qnty         as decimal      no-undo.
     4117   define variable v-trn-type          as character    no-undo.
     4118   define variable v-ingr-qnty         as decimal      no-undo.
     4119   define variable v-recipe-qnty       as decimal      no-undo.
     4120   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4121   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4122   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4123   define buffer buf_fbr-line          for ub.fbr-line.
     4124   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4125   define buffer buf_goods             for ub.goods.
     4126   define buffer buf_fbr-doc           for ub.fbr-doc.
     4127   do
     4128   for buf_fbr-recipe
     4129     , buf_fbr-recipe-gds
     4130     , buf_fbr-line
     4131     , buf_coeff_fbr-line
     4132     , buf_goods
     4133     , buf_fbr-doc
     4134   on error undo, return error
     4135   :
     4136       find first buf_fbr-line no-lock
     4137            where buf_fbr-line.doc-code      = p-doc-code
     4138              and buf_fbr-line.is-comp       = yes
     4139              and buf_fbr-line.recipe-code   = p-recipe-code
     4140       .
     4141       find first buf_fbr-doc no-lock
     4142            where buf_fbr-doc.doc-code      = p-doc-code
     4143       .
     4144       assign
     4145           v-comp-qnty = buf_fbr-line.fact-qnty
     4146           v-trn-type  = buf_fbr-line.trn-type
     4147       .
     4148       find first buf_fbr-recipe no-lock
     4149            where buf_fbr-recipe.doc-code    = p-doc-code
     4150              and buf_fbr-recipe.recipe-code = p-recipe-code
     4151       .
     4152       assign
     4153       v-recipe-qnty = buf_fbr-recipe.qnty
     4154       .
     4155       do transaction
     4156       on error undo, return error
     4157       :
     4158           for each buf_fbr-recipe-gds no-lock
     4159              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4160                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4161           on error undo, return error
     4162           :
     4163               find first buf_fbr-line no-lock
     4164                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4165                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4166                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4167                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4168                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4169               no-error.
     4170               if not available buf_fbr-line
     4171               then do:
     4172                   find first buf_goods no-lock
     4173                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4174                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4175                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4176                   .
     4177                   run str/fbr-crln.p (
     4178                         input parparentproc
     4179                       , input recid( buf_fbr-doc )
     4180                       , input recid( buf_goods )
     4181                       , input buf_fbr-recipe-gds.recipe-code
     4182                       , input v-trn-type
     4183                       , input no
     4184                       , input no
     4185                       , input buf_fbr-doc.obj-type
     4186                       , input buf_fbr-doc.obj-code
     4187                       , output v-fbr-v-fbr-doc-line-recid
     4188                   ).
     4189                   find first buf_fbr-line no-lock
     4190                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4191                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4192                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4193                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4194                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4195                   no-error.
     4196                   if not available buf_fbr-line
     4197                   then do:
     4198                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4199                                                      , p-doc-code
     4200                                                      , buf_fbr-recipe-gds.artic
     4201                                                      , buf_fbr-recipe-gds.prod-type
     4202                                                      , buf_fbr-recipe-gds.prod-code).
     4203                   end.
     4204               end.
     4205               find first buf_coeff_fbr-line exclusive-lock
     4206                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4207               .
     4208               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4209               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4210               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4211               then do:
     4212                   assign
     4213                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4214                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4215                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4216                   .
     4217               end.
     4218           end.
     4219       end.
     4220       define variable v-need-goods    as logical       no-undo.
     4221       define variable v-need-goods-list       as character     no-undo.
     4222       define variable v-need-goods-qnty-list  as character     no-undo.
     4223       find first buf_fbr-line no-lock
     4224            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4225              and buf_fbr-line.is-comp     = yes
     4226              and buf_fbr-line.recipe-code = p-recipe-code
     4227       .
     4228       run str/fbr-qnty.p (
     4229             input parparentproc
     4230           , input p-fbrhist-handle
     4231           , input recid( buf_fbr-doc )
     4232           , input recid( buf_fbr-line )
     4233           , input no
     4234           , input "ingr"
     4235           , input no
     4236           , input p-price-sale-obj-type
     4237           , input p-price-sale-obj-code
     4238           , input no
     4239           , input no
     4240           , input no
     4241           , output v-need-goods
     4242           , output v-need-goods-list
     4243           , output v-need-goods-qnty-list
     4244       ).
     4245   end.
     4246   END PROCEDURE.
     4247   procedure fbrlib_check-before-close :
     4248   define input parameter p-doc-code as character no-undo .
     4249   define variable same-sale as decimal no-undo .
     4250   define variable is-waste as logical no-undo .
     4251   define variable fix-price as logical no-undo .
     4252   define buffer buf_fbr-doc for ub.fbr-doc.
     4253   define buffer buf_fbr-line for ub.fbr-line.
     4254   define buffer buf_goods for ub.goods.
     4255   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4256   do
     4257   on error undo, return error
     4258   :
     4259     for each buf_fbr-line no-lock
     4260         where buf_fbr-line.doc-code = p-doc-code
     4261       , each buf_goods no-lock
     4262         where buf_goods.artic     = buf_fbr-line.artic
     4263           and buf_goods.prod-type = buf_fbr-line.prod-type
     4264           and buf_goods.prod-code = buf_fbr-line.prod-code
     4265     break by buf_fbr-line.prod-type
     4266           by buf_fbr-line.prod-code
     4267           by buf_fbr-line.artic
     4268     :
     4269       if first-of (buf_fbr-line.artic)
     4270       then do:
     4271         assign
     4272         same-sale = buf_fbr-line.price-sale
     4273         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4274         fix-price = buf_fbr-line.is-calc
     4275         .
     4276       end.
     4277       if same-sale <> buf_fbr-line.price-sale
     4278       then do:
     4279           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4280                                         ,p-doc-code
     4281                                         ,buf_goods.artic
     4282                                         ,buf_goods.gds-name
     4283                                         ,chr(10)).
     4284       end.
     4285       if fix-price <> buf_fbr-line.is-calc then do:
     4286           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4287                                         ,p-doc-code
     4288                                         ,buf_goods.artic
     4289                                         ,buf_goods.gds-name
     4290                                         ,chr(10)).
     4291       end.
     4292       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4293       then do:
     4294         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4295                                         ,p-doc-code
     4296                                         ,buf_goods.artic
     4297                                         ,buf_goods.gds-name
     4298                                         ,chr(10)).
     4299       end.
     4300       if buf_fbr-line.rsrv-qnty <> ?
     4301       and buf_goods.gds-type <> 'у':U
     4302       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4303       and buf_fbr-line.fact-qnty <> 0
     4304       then do:
     4305         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4306           if  can-find(first buf_fbr-gds-obj no-lock where
     4307                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4308               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4309               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4310               and buf_fbr-gds-obj.is-null-price  )  then .
     4311                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4312                                         ,p-doc-code
     4313                                         ,buf_goods.artic
     4314                                         ,buf_goods.gds-name
     4315                                         ,chr(10)
     4316                                         ,buf_fbr-line.recipe-code
     4317                                         ).
     4318         end.
     4319         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4320                                         ,p-doc-code
     4321                                         ,buf_goods.artic
     4322                                         ,buf_goods.gds-name
     4323                                         ,chr(10)
     4324                                         ,buf_fbr-line.recipe-code
     4325                                         ).
     4326       end.
     4327     end.
     4328   end.
     4329   end procedure.
     4330   define variable vss-include-info34 as character format "X(65)" no-undo
     4331   initial "@(#)$Workfile$ $Revision$".
     4332   procedure fbrpln-create-line :
     4333   define input parameter p-doc-code       as character    no-undo.
     4334   define input parameter p-gds-code       as integer      no-undo.
     4335   define input parameter p-recipe-code    as character    no-undo.
     4336   define input parameter p-fbr-obj-type   as character    no-undo.
     4337   define input parameter p-fbr-obj-code   as integer      no-undo.
     4338   define input parameter p-silence        as logical      no-undo.
     4339   define input parameter p-qnty           as decimal      no-undo.
     4340       define buffer buf_fbr-pln       for fbr-pln.
     4341       define buffer buf_fbr-pln-line  for fbr-pln-line.
     4342       define buffer buf_goods         for goods.
     4343   do
     4344   for buf_fbr-pln
     4345     , buf_fbr-pln-line
     4346     , buf_goods
     4347   on error undo, return error
     4348   :
     4349       find first buf_fbr-pln no-lock
     4350            where buf_fbr-pln.doc-code = p-doc-code
     4351       .
     4352       if buf_fbr-pln.status_ <> 'новый':U
     4353       then do:
     4354           if p-silence = no
     4355           then do:
     4356               message
     4357                   skip "Добавить строки можно только"
     4358                   skip "в документ в статусе 'новый'"
     4359               view-as alert-box error.
     4360           end.
     4361           undo, return error .
     4362       end.
     4363       find first buf_goods no-lock
     4364            where buf_goods.gds-code = p-gds-code
     4365       .
     4366       if p-recipe-code <> ""
     4367       and p-fbr-obj-type = ""
     4368       and p-fbr-obj-code = 0
     4369       then do:
     4370           if p-silence = no
     4371           then do:
     4372               message
     4373                   skip "Не задан объект для производства товара с рецептом."
     4374                   skip "Товар: " buf_goods.artic buf_goods.gds-name
     4375                   skip(1)
     4376                   skip "Товар не может быть включен в план-меню."
     4377               view-as alert-box error.
     4378           end.
     4379           undo, return error .
     4380       end.
     4381       do transaction
     4382       on error undo, return error
     4383       :
     4384           create buf_fbr-pln-line.
     4385           assign
     4386               buf_fbr-pln-line.doc-code       = p-doc-code
     4387               buf_fbr-pln-line.gds-code       = p-gds-code
     4388               buf_fbr-pln-line.recipe-code    = p-recipe-code
     4389               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
     4390               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
     4391               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
     4392               buf_fbr-pln-line.fact-qnty      = p-qnty
     4393               buf_fbr-pln-line.artic          = buf_goods.artic
     4394               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
     4395               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
     4396               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
     4397               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
     4398               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
     4399           .
     4400       end.
     4401   end.
     4402   end procedure.
     4403   procedure fbrpln-create-doc :
     4404   define input parameter p-obj-type   as character    no-undo.
     4405   define input parameter p-obj-code   as integer      no-undo.
     4406   define input parameter p-doc-type   as character    no-undo.
     4407   define input parameter p-db-remote  as logical          no-undo.
     4408   define input parameter p-userid     as character        no-undo.
     4409   define output parameter p-doc-code  as character    no-undo.
     4410       define variable v-today     as date           no-undo.
     4411       define variable v-time      as integer        no-undo.
     4412       define variable v-host-code as integer        no-undo.
     4413       define variable v-doc-code  as character      no-undo.
     4414       define buffer buf_fbr-pln       for fbr-pln.
     4415   do
     4416   for buf_fbr-pln
     4417   on error undo, return error
     4418   :
     4419       run cur-time in this-procedure (
     4420             output v-today
     4421           , output v-time
     4422       ).
     4423   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4425     (input  p-obj-type
     4426     ,input  p-obj-code
     4427     ,output v-host-code
     4428     )  .
     4429       run fbrpln-doc-code (
     4430             input p-obj-type
     4431           , input p-obj-code
     4432           , input p-db-remote
     4433           , output v-doc-code
     4434       ).
     4435       create buf_fbr-pln.
     4436       assign
     4437           buf_fbr-pln.doc-code        = v-doc-code
     4438           buf_fbr-pln.doc-type        = p-doc-type
     4439           buf_fbr-pln.obj-type        = p-obj-type
     4440           buf_fbr-pln.obj-code        = p-obj-code
     4441           buf_fbr-pln.doc-date        = v-today
     4442           buf_fbr-pln.creid           = p-userid
     4443           buf_fbr-pln.PS              = ""
     4444           buf_fbr-pln.fact-date       = ?
     4445           buf_fbr-pln.fact-time       = ?
     4446           buf_fbr-pln.fact-num        = 0
     4447           buf_fbr-pln.fact-order      = 0
     4448           buf_fbr-pln.host-code       = v-host-code
     4449           buf_fbr-pln.status_         = 'новый':U
     4450           buf_fbr-pln.sys-date        = v-today
     4451           buf_fbr-pln.sys-time-int    = v-time
     4452           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
     4453           buf_fbr-pln.user-name       = p-userid
     4454       .
     4455       assign
     4456           p-doc-code = buf_fbr-pln.doc-code
     4457       .
     4458   end.
     4459   end procedure.
     4460   procedure fbrpln-create-fbr-doc :
     4461   define input parameter p-obj-type       as character        no-undo.
     4462   define input parameter p-obj-code       as integer          no-undo.
     4463   define input parameter p-pln-doc-code   as character        no-undo.
     4464   define input parameter p-db-remote      as logical          no-undo.
     4465   define input parameter p-userid         as character        no-undo.
     4466   define output parameter p-doc-code      as character        no-undo.
     4467       define variable v-today         as date             no-undo.
     4468       define variable v-host-code     as integer          no-undo.
     4469       define variable v-base-code     as integer          no-undo.
     4470       define buffer buf_curr-accnt    for curr-accnt.
     4471       define buffer buf_fbr-doc       for fbr-doc.
     4472       define buffer buf_fbr-pln       for fbr-pln.
     4473   do
     4474   for buf_curr-accnt
     4475     , buf_fbr-doc
     4476     , buf_fbr-pln
     4477   on error undo, return error
     4478   :
     4479   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4481     (input  p-obj-type
     4482     ,input  p-obj-code
     4483     ,output v-today
     4484     )  .
     4485   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4487     (input  p-obj-type
     4488     ,input  p-obj-code
     4489     ,output v-host-code
     4490     )  .
     4491   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4493     (input  v-host-code
     4494     ,output v-base-code
     4495     )  .
     4496       find last buf_curr-accnt no-lock
     4497           where buf_curr-accnt.curr-code = v-base-code
     4498             and buf_curr-accnt.exch-date <= v-today
     4499       use-index pi
     4500       no-error.
     4501       if not available buf_curr-accnt
     4502       then do:
     4503           message
     4504               "На дату" v-today "неизвестен курс базовой валюты."
     4505           view-as alert-box error.
     4506           undo, return error.
     4507       end.
     4508       run doc-code in this-procedure (
     4509             input  "main"
     4510           , input  p-obj-type
     4511           , input  p-obj-code
     4512           , input  ?
     4513           , output p-doc-code
     4514       ) no-error.
     4515       if error-status:error
     4516       then do:
     4517           message
     4518               "Ошибка при генерации номера документа производства."
     4519               skip return-value
     4520               skip trim(error-status :get-message(1))
     4521                       trim(error-status :get-message(2))
     4522                       trim(error-status :get-message(3))
     4523           view-as alert-box error.
     4524           return error.
     4525       end.
     4526       run trg/chkdocnm.p (
     4527             input p-doc-code
     4528           , input "fbr-doc"
     4529           , input "?"
     4530       ) no-error.
     4531       if error-status:error
     4532       then do:
     4533           message
     4534                       vss-workfile vss-revision vss-description
     4535               skip "Ошибка при проверке номера для нового документа."
     4536               skip return-value
     4537               skip trim(error-status :get-message(1))
     4538                       trim(error-status :get-message(2))
     4539                       trim(error-status :get-message(3))
     4540           view-as alert-box error.
     4541           undo, return error .
     4542       end.
     4543       create buf_fbr-doc.
     4544       assign
     4545           buf_fbr-doc.doc-code  = p-doc-code
     4546           buf_fbr-doc.creid     = p-userid
     4547           buf_fbr-doc.doc-date  = v-today
     4548           buf_fbr-doc.doc-type  = 'производство':U
     4549           buf_fbr-doc.host-code = v-host-code
     4550           buf_fbr-doc.obj-type  = p-obj-type
     4551           buf_fbr-doc.obj-code  = p-obj-code
     4552           buf_fbr-doc.PS        = "@"
     4553           buf_fbr-doc.status_   = 'новый':U
     4554           buf_fbr-doc.out-code  = p-pln-doc-code
     4555       .
     4556   end.
     4557   end procedure.
     4558   procedure fbrpln-doc-code :
     4559   define input parameter p-obj-type   as character    no-undo.
     4560   define input parameter p-obj-code   as integer      no-undo.
     4561   define input parameter p-db-remote  as logical      no-undo.
     4562   define output parameter p-doc-code  as character    no-undo.
     4563   do
     4564   on error undo, return error
     4565   :
     4566       if p-db-remote = yes
     4567       then do:
     4568           assign
     4569               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
     4570                           + "-"
     4571                           + trim( string( p-obj-code, ">>>>9" ) )
     4572                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     4573           .
     4574       end.
     4575       else do:
     4576           assign
     4577               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
     4578           .
     4579       end.
     4580   end.
     4581   end procedure.
     4582   define variable vss-include-info39 as character format "X(65)" no-undo
     4583   initial "@(#)$Workfile$ $Revision$".
     4584   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4585   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     4586       define variable v-upper-code as int no-undo.
     4587       define variable v-value as character no-undo.
     4588       define variable v-type as character no-undo.
     4589       define buffer lc_gds-grp for ub.gds-grp.
     4590       define buffer lc_goods for ub.goods.
     4591      if p-gds-code <> 0 then do:
     4592       find first lc_goods where lc_goods.gds-code = p-gds-code.
     4593       v-upper-code = lc_goods.grp-code.
     4594       do while v-upper-code > 0 :
     4595           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4596           run ggoattr-value(
     4597             input lc_gds-grp.node-code,
     4598             input 0,
     4599             input "",
     4600             input 0,
     4601             input 'ban-sales-via-cd':U,
     4602             output v-value,
     4603             output v-type
     4604           ).
     4605          if v-value = "yes" then
     4606             return true.
     4607          else
     4608          do:
     4609             run ggoattr-value(
     4610                input lc_gds-grp.node-code,
     4611                input v-cntxt-host-code-obj,
     4612                input "",
     4613                input 0,
     4614                input 'ban-sales-via-cd':U,
     4615                output v-value,
     4616                output v-type
     4617                ).
     4618             if v-value = "yes" then
     4619                return true.
     4620             else
     4621             do:
     4622                run ggoattr-value(
     4623                   input lc_gds-grp.node-code,
     4624                   input v-cntxt-host-code-obj,
     4625                   input v-cntxt-obj-type,
     4626                   input v-cntxt-obj-code,
     4627                   input 'ban-sales-via-cd':U,
     4628                   output v-value,
     4629                   output v-type
     4630                   ).
     4631                if v-value = "yes" then
     4632                   return true.
     4633                else v-upper-code = lc_gds-grp.upper-code.
     4634             end .
     4635          end.
     4636         end.
     4637       end.
     4638       if v-value = "" or logical(v-value) = false then return false .
     4639   end.
     4640   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     4641       define variable v-upper-code as int no-undo.
     4642       define variable v-value as character no-undo.
     4643       define variable v-type as character no-undo.
     4644       define buffer lc_gds-grp for ub.gds-grp.
     4645       define buffer lc_goods for ub.goods.
     4646       v-upper-code = p-grp-code.
     4647       do while v-upper-code > 0 :
     4648           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4649           run ggoattr-value(
     4650             input lc_gds-grp.node-code,
     4651             input 0,
     4652             input "",
     4653             input 0,
     4654             input 'ban-sales-via-cd':U,
     4655             output v-value,
     4656             output v-type
     4657           ).
     4658          if v-value = "yes" then
     4659             return true.
     4660          else
     4661          do:
     4662             run ggoattr-value(
     4663                input lc_gds-grp.node-code,
     4664                input v-cntxt-host-code-obj,
     4665                input "",
     4666                input 0,
     4667                input 'ban-sales-via-cd':U,
     4668                output v-value,
     4669                output v-type
     4670                ).
     4671             if v-value = "yes" then
     4672                return true.
     4673             else
     4674             do:
     4675                run ggoattr-value(
     4676                   input lc_gds-grp.node-code,
     4677                   input v-cntxt-host-code-obj,
     4678                   input v-cntxt-obj-type,
     4679                   input v-cntxt-obj-code,
     4680                   input 'ban-sales-via-cd':U,
     4681                   output v-value,
     4682                   output v-type
     4683                   ).
     4684                if v-value = "yes" then
     4685                   return true.
     4686                else v-upper-code = lc_gds-grp.upper-code.
     4687             end .
     4688          end.
     4689         end.
     4690   end.
     4691   define temp-table temp_goods-qnty no-undo
     4692       field gds-code      as integer
     4693       field artic         as character
     4694       field prod-type     as character
     4695       field prod-code     as integer
     4696       field recipe-type   as character
     4697       field recipe-code   as character
     4698       field trn-type      as character
     4699       field need-qnty     as decimal
     4700       field calculated    as logical
     4701       index pi is primary unique gds-code recipe-code
     4702       index cl calculated
     4703   .
     4704   PROCEDURE create-initial-temp-goods :
     4705   do
     4706   on error undo, return error
     4707   :
     4708   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4709   define input parameter p-artic              as character    no-undo.
     4710   define input parameter p-prod-type          as character    no-undo.
     4711   define input parameter p-prod-code          as integer      no-undo.
     4712   define input parameter p-trn-type           as character    no-undo.
     4713   define input parameter p-recipe-type        as character    no-undo.
     4714   define input parameter p-recipe-code        as character    no-undo.
     4715   define input parameter p-need-qnty          as decimal      no-undo.
     4716   define output parameter p-same-good             as logical      no-undo.
     4717   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     4718       define variable v-gds-code    as integer      no-undo.
     4719       define buffer buf_fbr-doc               for ub.fbr-doc.
     4720       define buffer buf_fbr-line              for ub.fbr-line.
     4721       define buffer buf_recipe                for ub.fbr-recipe.
     4722       define buffer buf_obj_recipe            for ub.recipe.
     4723       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4724       run clear-temp-tables in this-procedure.
     4725   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4727     (input  p-artic
     4728     ,input  p-prod-type
     4729     ,input  p-prod-code
     4730     ,output v-gds-code
     4731     )  .
     4732       create buf_temp_goods-qnty.
     4733       assign
     4734           buf_temp_goods-qnty.gds-code    = v-gds-code
     4735           buf_temp_goods-qnty.artic       = p-artic
     4736           buf_temp_goods-qnty.prod-type   = p-prod-type
     4737           buf_temp_goods-qnty.prod-code   = p-prod-code
     4738           buf_temp_goods-qnty.trn-type    = p-trn-type
     4739           buf_temp_goods-qnty.recipe-type = p-recipe-type
     4740           buf_temp_goods-qnty.recipe-code = p-recipe-code
     4741           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     4742           buf_temp_goods-qnty.calculated  = no
     4743       .
     4744       assign
     4745           p-same-good                 = no
     4746           p-same-good-old-qnty        = 0
     4747       .
     4748       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     4749       for each buf_fbr-line no-lock
     4750          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4751            and buf_fbr-line.is-comp  = yes
     4752       on error undo, return error
     4753       :
     4754           find first buf_temp_goods-qnty
     4755                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     4756                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     4757                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     4758           no-error.
     4759           if available buf_temp_goods-qnty
     4760           then do:
     4761               assign
     4762                   p-same-good                 = yes
     4763                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     4764                   buf_temp_goods-qnty.calculated  = no
     4765               .
     4766           end.
     4767           else do:
     4768               define variable v-recipe-type   as character     no-undo.
     4769               run copy-recipe-in-doc in this-procedure (
     4770                     input p-fbr-doc-doc-code
     4771                   , input buf_fbr-line.recipe-code
     4772                   , input buf_fbr-doc.doc-date
     4773                   , input buf_fbr-doc.obj-type
     4774                   , input buf_fbr-doc.obj-code
     4775               ).
     4776               find first buf_recipe no-lock
     4777                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     4778                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     4779               no-error.
     4780               if available buf_recipe
     4781               then do:
     4782                   assign
     4783                       v-recipe-type = buf_recipe.recipe-type
     4784                   .
     4785                   if v-recipe-type = 'разделка':U
     4786                   or ( v-recipe-type = 'комплектация':U
     4787                       and buf_fbr-line.trn-type = 'спи':U )
     4788                   then do:
     4789                       run fill-temp-dressing-ingr in this-procedure (
     4790                             input buf_fbr-line.doc-code
     4791                           , input buf_recipe.recipe-code
     4792                       ).
     4793                   end.
     4794               end.
     4795               else do:
     4796                   assign
     4797                       v-recipe-type = ?
     4798                   .
     4799               end.
     4800   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4802     (input  buf_fbr-line.artic
     4803     ,input  buf_fbr-line.prod-type
     4804     ,input  buf_fbr-line.prod-code
     4805     ,output v-gds-code
     4806     )  .
     4807               create buf_temp_goods-qnty.
     4808               assign
     4809                   buf_temp_goods-qnty.gds-code    = v-gds-code
     4810                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     4811                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     4812                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     4813                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     4814                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     4815                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     4816                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     4817                   buf_temp_goods-qnty.calculated  = yes
     4818               .
     4819           end.
     4820       end.
     4821   end.
     4822   END PROCEDURE.
     4823   PROCEDURE calc-not-calculated-goods :
     4824   do
     4825   on error undo, return error
     4826   :
     4827   define input parameter p-mainmenu-handle        as handle           no-undo.
     4828   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     4829   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     4830   define input parameter p-same-good              as logical          no-undo.
     4831   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     4832   define input parameter p-always-select-recipe   as logical          no-undo.
     4833   define input parameter p-add-childs             as logical          no-undo.
     4834   define input parameter p-price-sale-obj-type    as character        no-undo.
     4835   define input parameter p-price-sale-obj-code    as integer          no-undo.
     4836   define input parameter p-autofbr                as logical          no-undo.
     4837   define input parameter p-have-store             as logical          no-undo.
     4838       define variable v-counter               as integer       no-undo.
     4839       define variable v-recipe-type           as character     no-undo.
     4840       define variable v-recipe-code           as character     no-undo.
     4841       define variable v-recipe-found          as logical       no-undo.
     4842       define variable v-gds-code              as integer       no-undo.
     4843       define variable v-yesno                 as logical       no-undo.
     4844       define variable v-fbr-line-recid        as recid         no-undo.
     4845       define variable v-recipe-recid-list     as character     no-undo.
     4846       define variable v-need-goods            as logical       no-undo.
     4847       define variable v-need-goods-list       as character     no-undo.
     4848       define variable v-need-goods-qnty-list  as character     no-undo.
     4849       define variable v-have-rights           as logical       no-undo.
     4850       define variable v-trn-type              as character     no-undo.
     4851       define variable v-is-comp               as logical       no-undo.
     4852       define variable v-host-code             as integer       no-undo.
     4853       define variable v-is-manual-input       as logical       no-undo.
     4854       define variable v-add-good              as logical       no-undo.
     4855       define variable v-cancel                as logical       no-undo.
     4856       define variable v-value          as character no-undo .
     4857       define variable v-type           as character no-undo .
     4858       define variable v-attr-value     as character no-undo .
     4859       define variable v-attr-value-rec as character no-undo .
     4860       define variable v-attr-type      as character no-undo .
     4861       define variable v-mark-qnty      as decimal no-undo init ? .
     4862       define buffer buf_obj_recipe            for recipe.
     4863       define buffer buf_obj_recipe-gds        for recipe-gds.
     4864       define buffer buf_fbr-recipe            for fbr-recipe.
     4865       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     4866       define buffer buf_goods                 for goods.
     4867       define buffer buf_fbr-doc               for fbr-doc.
     4868       define buffer buf_fbr-line              for fbr-line.
     4869       define buffer buf_comp_fbr-line         for fbr-line.
     4870       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4871       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     4872       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     4873       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     4874       define buffer buf_marking-lines         for ub.marking-lines .
     4875       define buffer buf_marking               for ub.marking .
     4876      define variable v-ban-recipes as logical no-undo .
     4877      define variable v-ban-altr    as logical no-undo .
     4878      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     4879      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     4880       find first buf_fbr-doc no-lock
     4881            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4882       .
     4883       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     4884       find first buf_start_temp_goods-qnty
     4885            where buf_start_temp_goods-qnty.calculated = no
     4886       no-error.
     4887       calc-not-calculated-goods:
     4888       do while available buf_start_temp_goods-qnty
     4889       :
     4890           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     4891           find first buf_goods no-lock
     4892                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     4893           .
     4894           if buf_start_temp_goods-qnty.recipe-code = ?
     4895           then do:
     4896               assign
     4897                   v-is-manual-input = yes
     4898               .
     4899           end.
     4900           else do:
     4901               assign
     4902                   v-is-manual-input = no
     4903               .
     4904           end.
     4905           if buf_start_temp_goods-qnty.recipe-code = ?
     4906           or p-always-select-recipe = yes
     4907           then do:
     4908               assign
     4909                   v-yesno     = ?
     4910                   v-add-good  = no
     4911               .
     4912               do while v-yesno = ?
     4913               and v-add-good = no
     4914               :
     4915                   run ref/rcp-all.w (
     4916                         input p-mainmenu-handle
     4917                       , input "b-add,b-sel"
     4918                       , input 'все':U
     4919                       , input recid( buf_goods )
     4920                       , input buf_fbr-doc.obj-type
     4921                       , input buf_fbr-doc.obj-code
     4922                       , output v-recipe-recid-list
     4923                   ) no-error.
     4924                   if error-status :error
     4925                   or v-recipe-recid-list = ""
     4926                   then do:
     4927                       message
     4928                           "Отменить добавление товара?"
     4929                           skip(1)
     4930                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     4931                           skip(1)
     4932                           skip "Yes - отменить добавление текущего товара"
     4933                           skip "No  - отменить добавление всех товаров списка"
     4934                           skip "Cancel - вернуться к выбору рецепта"
     4935                       view-as alert-box question
     4936                       buttons yes-no-cancel
     4937                       title "Отмена"
     4938                       update v-yesno
     4939                       .
     4940                   end.
     4941                   else do:
     4942         if v-ban-altr or v-ban-recipes then
     4943         do:
     4944            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     4945               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     4946               do:
     4947                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4948                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4949                        , input  'mark-type':U
     4950                        , output v-attr-value
     4951                        , output v-attr-type
     4952                        ) no-error .
     4953                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4954                     do:
     4955                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     4956                           view-as alert-box.
     4957                        return .
     4958                     end.
     4959                  end.
     4960               end.
     4961               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     4962               do:
     4963                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     4964                  do:
     4965                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     4966                        view-as alert-box.
     4967                     return .
     4968                  end.
     4969               end.
     4970               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     4971               do:
     4972                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4973                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4974                        , input  'mark-type':U
     4975                        , output v-attr-value
     4976                        , output v-attr-type
     4977                        ) no-error .
     4978                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4979                     do:
     4980                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     4981                           , input  'mark-type':U
     4982                           , output v-attr-value-rec
     4983                           , output v-attr-type
     4984                           ) no-error .
     4985                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     4986                        do:
     4987                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     4988                              view-as alert-box.
     4989                           return .
     4990                        end.
     4991                        else leave.
     4992                     end.
     4993                  end.
     4994               end.
     4995            end.
     4996         end.
     4997                       assign
     4998                           v-add-good = yes
     4999                       .
     5000                   end.
     5001               end.
     5002               if v-add-good = no
     5003               then do:
     5004                   if v-yesno = yes
     5005                   then do:
     5006                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5007                       :
     5008                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5009                           assign
     5010                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5011                           .
     5012                         end .
     5013                         delete tt-marking-lines .
     5014                       end .
     5015                       delete buf_start_temp_goods-qnty.
     5016                       find first buf_start_temp_goods-qnty
     5017                               where buf_start_temp_goods-qnty.calculated = no
     5018                       no-error.
     5019                       next calc-not-calculated-goods.
     5020                   end.
     5021                   else do:
     5022                       undo, return error .
     5023                   end.
     5024               end.
     5025               find first buf_obj_recipe no-lock
     5026                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
     5027               no-error.
     5028               if not available buf_obj_recipe
     5029               then do:
     5030                   if p-always-select-recipe = yes
     5031                   then do:
     5032                       assign
     5033                           buf_start_temp_goods-qnty.calculated = yes
     5034                       .
     5035                       find first buf_start_temp_goods-qnty
     5036                            where buf_start_temp_goods-qnty.calculated = no
     5037                       no-error.
     5038                       next calc-not-calculated-goods.
     5039                   end.
     5040                   else do:
     5041                       message
     5042                           "Неверно выбран рецепт для товара."
     5043                       view-as alert-box information.
     5044                       undo, return error .
     5045                   end.
     5046               end.
     5047               else do:
     5048                   run copy-recipe-in-doc in this-procedure (
     5049                         input buf_fbr-doc.doc-code
     5050                       , input buf_obj_recipe.recipe-code
     5051                       , input buf_fbr-doc.doc-date
     5052                       , input buf_fbr-doc.obj-type
     5053                       , input buf_fbr-doc.obj-code
     5054                   ).
     5055                   find first buf_fbr-recipe no-lock
