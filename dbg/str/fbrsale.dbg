     5325           end.
     5326           run fbrlib-get-trn-type in this-procedure (
     5327                 input buf_fbr-recipe.recipe-code
     5328               , input recid( buf_goods )
     5329               , input ( if buf_start_temp_goods-qnty.trn-type = ?
     5330                         then ?
     5331                         else ( if buf_start_temp_goods-qnty.trn-type = 'при':U
     5332                                then yes
     5333                                else no ) )
     5334               , output v-is-comp
     5335               , output v-trn-type
     5336           ).
     5337           assign
     5338               buf_start_temp_goods-qnty.trn-type = v-trn-type
     5339           .
     5340           run str/fbr-crln.p (
     5341                 input p-mainmenu-handle
     5342               , input recid( buf_fbr-doc )
     5343               , input recid( buf_goods )
     5344               , input buf_fbr-recipe.recipe-code
     5345               , input v-trn-type
     5346               , input v-is-comp
     5347               , input yes
     5348               , input buf_fbr-doc.obj-type
     5349               , input buf_fbr-doc.obj-code
     5350               , output v-fbr-line-recid
     5351           ).
     5352           if buf_start_temp_goods-qnty.need-qnty = ?
     5353           then do:
     5354               find first tt-marking-lines no-error .
     5355               if available tt-marking-lines
     5356               then do :
     5357                 assign v-mark-qnty = 0 .
     5358                 for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5359                 first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5360                                           and buf_goods.prod-type = buf_fbr-line.prod-type
     5361                                           and buf_goods.prod-code = buf_fbr-line.prod-code,
     5362                 each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5363                 :
     5364                   assign v-mark-qnty = v-mark-qnty + tt-marking-lines.box-qnty .
     5365                 end .
     5366               end .
     5367               run str/fbr-line.w (
     5368                     input p-fbrhist-handle
     5369                   , input buf_fbr-doc.status_
     5370                   , input p-fbr-doc-doc-code
     5371                   , input v-fbr-line-recid
     5372                   , input v-mark-qnty
     5373                   , output v-cancel
     5374               ) no-error.
     5375               if error-status :error
     5376               or v-cancel = yes
     5377               then do:
     5378                   find first buf_fbr-line exclusive-lock
     5379                        where recid( buf_fbr-line ) = v-fbr-line-recid
     5380                   .
     5381                   for first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5382                                             and buf_goods.prod-type = buf_fbr-line.prod-type
     5383                                             and buf_goods.prod-code = buf_fbr-line.prod-code,
     5384                   each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5385                   :
     5386                     for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5387                       assign
     5388                         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5389                       .
     5390                     end .
     5391                   end .
     5392                   delete buf_fbr-line.
     5393                   run clear-temp-tables in this-procedure.
     5394                   return.
     5395               end.
     5396               for first buf_fbr-line no-lock where recid(buf_fbr-line) = v-fbr-line-recid,
     5397               first buf_goods no-lock where buf_goods.artic     = buf_fbr-line.artic
     5398                                         and buf_goods.prod-type = buf_fbr-line.prod-type
     5399                                         and buf_goods.prod-code = buf_fbr-line.prod-code,
     5400               each tt-marking-lines where tt-marking-lines.gds-code = buf_goods.gds-code
     5401               :
     5402                 create buf_marking-lines .
     5403                 assign
     5404                   buf_marking-lines.mark      = tt-marking-lines.mark
     5405                   buf_marking-lines.obj-type  = buf_fbr-doc.obj-type
     5406                   buf_marking-lines.obj-code  = buf_fbr-doc.obj-code
     5407                   buf_marking-lines.gds-code  = buf_goods.gds-code
     5408                   buf_marking-lines.in-code   = "manufacturing"
     5409                   buf_marking-lines.out-code  = buf_fbr-line.doc-code
     5410                   buf_marking-lines.part-code = buf_fbr-line.recipe-code
     5411                   buf_marking-lines.prt-code  = 0
     5412                   buf_marking-lines.doc-level = 1
     5413                 .
     5414               end .
     5415               find first buf_fbr-line exclusive-lock
     5416                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5417               .
     5418               if p-same-good = yes
     5419               then do:
     5420                   if p-autofbr = yes
     5421                   then do:
     5422                       assign
     5423                           v-yesno = yes
     5424                       .
     5425                   end.
     5426                   else do:
     5427                       message
     5428                                "Товар уже есть в документе."
     5429                           skip "Вы можете добавить введенное количество в строку документа,"
     5430                           skip "изменить количество в документе на введенное"
     5431                           skip "или отменить добавление товара, оставив рецепт без изменений"
     5432                           skip(1)
     5433                           skip "Артикул товара:        " buf_start_temp_goods-qnty.artic
     5434                           skip "Количество в документе:" p-same-good-old-qnty
     5435                           skip(1)
     5436                           skip "Добавить в строку?"
     5437                       view-as alert-box question
     5438                       buttons yes-no-cancel
     5439                       title "Добавление товара"
     5440                       update v-yesno.
     5441                       if v-yesno = ?
     5442                       then do:
     5443                           assign
     5444                               buf_start_temp_goods-qnty.need-qnty   = p-same-good-old-qnty
     5445                               buf_start_temp_goods-qnty.calculated  = yes
     5446                           .
     5447                           run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Расчитанная строка документа оставлена без изменений. Количество &1", buf_start_temp_goods-qnty.need-qnty ) ).
     5448                           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5449                           find first buf_start_temp_goods-qnty
     5450                                where buf_start_temp_goods-qnty.calculated = no
     5451                           no-error.
     5452                           next calc-not-calculated-goods.
     5453                       end.
     5454                   end.
     5455                   assign
     5456                       buf_start_temp_goods-qnty.calculated  = no
     5457                   .
     5458                   if v-yesno = yes
     5459                   then do:
     5460                       assign
     5461                           buf_fbr-line.fact-qnty = buf_fbr-line.fact-qnty + p-same-good-old-qnty
     5462                       .
     5463                   end.
     5464                   run writelog in this-procedure ( log-file-name, 3, substitute( "Товар уже есть в документе. Количество в рассчитанной строке документа изменено на &1", buf_fbr-line.fact-qnty ) ).
     5465               end.
     5466               assign
     5467                   buf_start_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     5468                   buf_start_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     5469                   buf_start_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     5470               .
     5471           end.
     5472           run writelog in this-procedure ( log-file-name, 2, "Идем по ингредиентам товара." ).
     5473           for each buf_fbr-recipe-gds no-lock
     5474              where buf_fbr-recipe-gds.doc-code    = buf_fbr-recipe.doc-code
     5475                and buf_fbr-recipe-gds.recipe-code = buf_fbr-recipe.recipe-code
     5476           on error undo, return error
     5477           :
     5478               find first buf_goods no-lock
     5479                    where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5480                      and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5481                      and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5482               .
     5483               assign
     5484                   v-is-comp = no
     5485                   v-trn-type = ( if buf_start_temp_goods-qnty.trn-type = 'при':U then 'спи':U else 'при':U )
     5486               .
     5487               run str/fbr-crln.p (
     5488                     input p-mainmenu-handle
     5489                   , input recid( buf_fbr-doc )
     5490                   , input recid( buf_goods )
     5491                   , input buf_fbr-recipe.recipe-code
     5492                   , input v-trn-type
     5493                   , input v-is-comp
     5494                   , input yes
     5495                   , input buf_fbr-doc.obj-type
     5496                   , input buf_fbr-doc.obj-code
     5497                   , output v-fbr-line-recid
     5498               ).
     5499               find first buf_fbr-line no-lock
     5500                    where recid( buf_fbr-line ) = v-fbr-line-recid
     5501               .
     5502               run writelog in this-procedure ( log-file-name, 3, substitute( "Создана строка ингредиента с артикулом '&1'", buf_fbr-line.artic ) ).
     5503           end.
     5504           run writelog in this-procedure ( log-file-name, 2, substitute( "Упорядочивание рецептов. Идем по рецептам с последнего." ) ).
     5505           run fbrlib-put-in-order-recipe in this-procedure (
     5506               input buf_fbr-doc.doc-code
     5507           ) no-error.
     5508           if error-status :error
     5509           then do:
     5510               for each buf_del_temp_goods-qnty
     5511               :
     5512                   delete buf_del_temp_goods-qnty.
     5513               end.
     5514               undo, return error.
     5515           end.
     5516           find last temp_recipe-order.
     5517           calc-all-recipes:
     5518           do while available temp_recipe-order
     5519           :
     5520               run writelog in this-procedure ( log-file-name, 3, substitute( "Обработка рецепта номер: &1", temp_recipe-order.recipe-code ) ).
     5521               find first buf_comp_fbr-line exclusive-lock
     5522                    where buf_comp_fbr-line.doc-code    = p-fbr-doc-doc-code
     5523                      and buf_comp_fbr-line.is-comp     = yes
     5524                      and buf_comp_fbr-line.recipe-code = temp_recipe-order.recipe-code
     5525               .
     5526               find first buf_temp_goods-qnty
     5527                    where buf_temp_goods-qnty.artic        = buf_comp_fbr-line.artic
     5528                      and buf_temp_goods-qnty.prod-type    = buf_comp_fbr-line.prod-type
     5529                      and buf_temp_goods-qnty.prod-code    = buf_comp_fbr-line.prod-code
     5530                      and buf_temp_goods-qnty.recipe-code  = buf_comp_fbr-line.recipe-code
     5531               no-error.
     5532               if not available buf_temp_goods-qnty
     5533               or buf_temp_goods-qnty.calculated = no
     5534               then do:
     5535                   run writelog in this-procedure ( log-file-name, 4, "Товар рецепта не рассчитан. Рассчитываем." ).
     5536                   if available buf_temp_goods-qnty
     5537                   and buf_temp_goods-qnty.need-qnty <> buf_comp_fbr-line.fact-qnty
     5538                   then do:
     5539                       assign
     5540                           buf_comp_fbr-line.fact-qnty = buf_temp_goods-qnty.need-qnty
     5541                       .
     5542                       run writelog in this-procedure ( log-file-name, 5, substitute( "Прописываем количество в строку составного товара: &1", buf_comp_fbr-line.fact-qnty  ) ).
     5543                   end.
     5544                   run str/fbr-qnty.p (
     5545                         input p-mainmenu-handle
     5546                       , input p-fbrhist-handle
     5547                       , input recid( buf_fbr-doc )
     5548                       , input recid( buf_comp_fbr-line )
     5549                       , input no
     5550                       , input "ingr"
     5551                       , input no
     5552                       , input p-price-sale-obj-type
     5553                       , input p-price-sale-obj-code
     5554                       , input yes
     5555                       , input p-autofbr
     5556                       , input p-have-store
     5557                       , output v-need-goods
     5558                       , output v-need-goods-list
     5559                       , output v-need-goods-qnty-list
     5560                   ).
     5561                   if p-add-childs  = yes
     5562                   and v-need-goods = yes
     5563                   then do:
     5564                       do v-counter = 1 to num-entries( v-need-goods-list ) / 2
     5565                       :
     5566                           run add-new-recipe in this-procedure (
     5567                                 input p-mainmenu-handle
     5568                               , input buf_fbr-doc.doc-code
     5569                               , input entry( 2 * v-counter, v-need-goods-list )
     5570                               , input integer( entry( 2 * v-counter - 1 , v-need-goods-list ) )
     5571                               , input decimal( entry( v-counter, v-need-goods-qnty-list ) )
     5572                               , input p-autofbr
     5573                               , input p-have-store
     5574                           ).
     5575                       end.
     5576                       leave calc-all-recipes.
     5577                   end.
     5578               end.
     5579               find prev temp_recipe-order no-error.
     5580           end.
     5581           assign
     5582               buf_start_temp_goods-qnty.calculated = yes
     5583           .
     5584           if buf_start_temp_goods-qnty.recipe-type = 'разделка':U
     5585           or ( buf_start_temp_goods-qnty.recipe-type = 'комплектация':U
     5586                and buf_start_temp_goods-qnty.trn-type = 'спи':U )
     5587           then do:
     5588               run fill-temp-dressing-ingr in this-procedure (
     5589                     input buf_fbr-doc.doc-code
     5590                   , input buf_start_temp_goods-qnty.recipe-code
     5591               ).
     5592           end.
     5593           run test-temp-tables in this-procedure ( "Добавили товар." ).
     5594           find first buf_start_temp_goods-qnty
     5595                where buf_start_temp_goods-qnty.calculated = no
     5596           no-error.
     5597       end.
     5598   end.
     5599   END PROCEDURE.
     5600   PROCEDURE clear-temp-tables :
     5601   do
     5602   on error undo, return error
     5603   :
     5604       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5605       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5606       for each buf_temp_goods-qnty
     5607       on error undo, return error
     5608       :
     5609           delete buf_temp_goods-qnty.
     5610       end.
     5611       for each buf_temp_dressing-ingr
     5612       on error undo, return error
     5613       :
     5614           delete buf_temp_dressing-ingr.
     5615       end.
     5616   end.
     5617   END PROCEDURE.
     5618   PROCEDURE copy-recipe-in-doc :
     5619   define input parameter p-doc-code       as character             no-undo.
     5620   define input parameter p-recipe-code    as character             no-undo.
     5621   define input parameter p-obj-date       as date                  no-undo.
     5622   define input parameter p-obj-type       like ub.clients.obj-type no-undo.
     5623   define input parameter p-obj-code       like ub.clients.obj-code no-undo.
     5624       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5625       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5626       define buffer buf_recipe            for ub.recipe.
     5627       define buffer buf_recipe-gds        for ub.recipe-gds.
     5628   do
     5629   for buf_fbr-recipe
     5630     , buf_fbr-recipe-gds
     5631     , buf_recipe
     5632     , buf_recipe-gds
     5633   on error undo, return error return-value
     5634   :
     5635   find first buf_recipe no-lock
     5636        where buf_recipe.recipe-code = p-recipe-code
     5637   .
     5638   find first buf_fbr-recipe exclusive-lock
     5639        where buf_fbr-recipe.doc-code      = p-doc-code
     5640          and buf_fbr-recipe.recipe-code   = p-recipe-code
     5641   no-error.
     5642   if not available buf_fbr-recipe
     5643   then do:
     5644     create buf_fbr-recipe.
     5645     assign
     5646       buf_fbr-recipe.doc-code     = p-doc-code
     5647       buf_fbr-recipe.recipe-code  = p-recipe-code
     5648       buf_fbr-recipe.recipe-type  = buf_recipe.recipe-type
     5649     .
     5650     for each buf_recipe-gds exclusive-lock
     5651        where buf_recipe-gds.recipe-code = p-recipe-code
     5652     on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     5653           run fbrlib_create-fbr-recipe-gds in this-procedure (
     5654                 input p-doc-code
     5655               , input buf_recipe-gds.recipe-code
     5656               , input buf_recipe-gds.prod-type
     5657               , input buf_recipe-gds.prod-code
     5658               , input buf_recipe-gds.artic
     5659               , input buf_recipe-gds.gds-code
     5660               , input buf_recipe-gds.is-waste
     5661               , input buf_recipe-gds.proc-number
     5662               , input p-obj-date
     5663               , input p-obj-type
     5664               , input p-obj-code
     5665               , input buf_recipe-gds.calc-method
     5666               , input buf_recipe-gds.coeff-waste
     5667               , input buf_recipe-gds.qnty
     5668               , input buf_recipe-gds.brutto-qnty
     5669         ) no-error.
     5670         if error-status:error
     5671         then do:
     5672               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     5673         end.
     5674     end.
     5675     buffer-copy buf_recipe to buf_fbr-recipe.
     5676   end.
     5677   end.
     5678   END PROCEDURE.
     5679   PROCEDURE fill-temp-dressing-ingr :
     5680   do
     5681   on error undo, return error
     5682   :
     5683   define input parameter p-doc-code       as character    no-undo.
     5684   define input parameter p-recipe-code    as character    no-undo.
     5685       define variable v-free-qnty     as decimal       no-undo.
     5686       define buffer buf_fbr-doc               for ub.fbr-doc.
     5687       define buffer buf_c_fbr-line            for ub.fbr-line.
     5688       define buffer buf_i_fbr-line            for ub.fbr-line.
     5689       define buffer buf_i_other_fbr-line      for ub.fbr-line.
     5690       define buffer buf_goods                 for ub.goods.
     5691       define buffer buf_recipe                for ub.fbr-recipe.
     5692       define buffer buf_recipe-gds            for ub.fbr-recipe-gds.
     5693       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5694       find first buf_fbr-doc no-lock
     5695            where buf_fbr-doc.doc-code = p-doc-code
     5696       .
     5697       find first buf_recipe no-lock
     5698            where buf_recipe.doc-code    = p-doc-code
     5699              and buf_recipe.recipe-code = p-recipe-code
     5700       .
     5701       find first buf_c_fbr-line no-lock
     5702            where buf_c_fbr-line.doc-code    = p-doc-code
     5703              and buf_c_fbr-line.is-comp     = yes
     5704              and buf_c_fbr-line.recipe-code = p-recipe-code
     5705       .
     5706       if buf_recipe.recipe-type <> 'разделка':U
     5707       and ( buf_recipe.recipe-type <> 'комплектация':U
     5708            or buf_c_fbr-line.trn-type <> 'спи':U )
     5709       then do:
     5710           message
     5711                    vss-workfile vss-revision vss-description
     5712               skip "Процедура fill-temp-dressing-ingr применима только к рецептам разделки и разукомплектации."
     5713               skip return-value
     5714           view-as alert-box error.
     5715           undo, return error .
     5716       end.
     5717       for each buf_temp_dressing-ingr
     5718       :
     5719           delete buf_temp_dressing-ingr.
     5720       end.
     5721       for each buf_i_fbr-line no-lock
     5722          where buf_i_fbr-line.doc-code    = p-doc-code
     5723            and buf_i_fbr-line.is-comp     = no
     5724            and buf_i_fbr-line.recipe-code = p-recipe-code
     5725       on error undo, return error
     5726       :
     5727           find first buf_goods no-lock
     5728                where buf_goods.artic      = buf_i_fbr-line.artic
     5729                  and buf_goods.prod-type  = buf_i_fbr-line.prod-type
     5730                  and buf_goods.prod-code  = buf_i_fbr-line.prod-code
     5731           .
     5732           find first buf_temp_dressing-ingr
     5733                where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5734                  and buf_temp_dressing-ingr.gds-code    = buf_goods.gds-code
     5735           no-error.
     5736           if not available buf_temp_dressing-ingr
     5737           then do:
     5738               create buf_temp_dressing-ingr.
     5739               assign
     5740                   buf_temp_dressing-ingr.recipe-code  = p-recipe-code
     5741                   buf_temp_dressing-ingr.gds-code     = buf_goods.gds-code
     5742                   buf_temp_dressing-ingr.used-qnty    = 0
     5743                   buf_temp_dressing-ingr.line-qnty    = 0
     5744                   buf_temp_dressing-ingr.recipe-qnty  = 0
     5745               .
     5746           end.
     5747           run fbrrest-get-free-qnty in this-procedure (
     5748                 input buf_fbr-doc.obj-type
     5749               , input buf_fbr-doc.obj-code
     5750               , input buf_goods.gds-code
     5751               , input no
     5752               , output v-free-qnty
     5753           ).
     5754           find first buf_recipe-gds no-lock
     5755                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5756                  and buf_recipe-gds.recipe-code = p-recipe-code
     5757                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5758                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5759                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5760           .
     5761           for each buf_i_other_fbr-line no-lock
     5762              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5763                and buf_i_other_fbr-line.is-comp     = no
     5764                and buf_i_other_fbr-line.recipe-code <> p-recipe-code
     5765                and buf_i_other_fbr-line.artic       = buf_i_fbr-line.artic
     5766                and buf_i_other_fbr-line.prod-type   = buf_i_fbr-line.prod-type
     5767                and buf_i_other_fbr-line.prod-code   = buf_i_fbr-line.prod-code
     5768           :
     5769               assign
     5770                   buf_temp_dressing-ingr.line-qnty    = buf_temp_dressing-ingr.line-qnty
     5771                                                           + buf_i_other_fbr-line.fact-qnty
     5772               .
     5773           end.
     5774           if available buf_temp_dressing-ingr
     5775           then do:
     5776               assign
     5777                   buf_temp_dressing-ingr.used-qnty = buf_temp_dressing-ingr.line-qnty - v-free-qnty
     5778               .
     5779           end.
     5780       end.
     5781       for each buf_temp_dressing-ingr
     5782          where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5783       :
     5784           find first buf_goods no-lock
     5785                where buf_goods.gds-code = buf_temp_dressing-ingr.gds-code
     5786           .
     5787           for each buf_i_other_fbr-line no-lock
     5788              where buf_i_other_fbr-line.doc-code    = p-doc-code
     5789                and buf_i_other_fbr-line.is-comp     = no
     5790                and buf_i_other_fbr-line.recipe-code = buf_temp_dressing-ingr.recipe-code
     5791                and buf_i_other_fbr-line.artic       = buf_goods.artic
     5792                and buf_i_other_fbr-line.prod-type   = buf_goods.prod-type
     5793                and buf_i_other_fbr-line.prod-code   = buf_goods.prod-code
     5794           on error undo, return error
     5795           :
     5796               assign
     5797                   buf_temp_dressing-ingr.recipe-qnty = buf_temp_dressing-ingr.recipe-qnty
     5798                                                       + buf_i_other_fbr-line.fact-qnty
     5799               .
     5800           end.
     5801       end.
     5802   end.
     5803   END PROCEDURE.
     5804   PROCEDURE test-temp-tables :
     5805       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5806       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5807   do
     5808   on error undo, return error
     5809   :
     5810   define input parameter p-title  as character    no-undo.
     5811   define variable v-str               as character        no-undo.
     5812       assign
     5813           v-str = p-title + " temp_goods-qnty:"
     5814       .
     5815       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5816       for each buf_temp_goods-qnty
     5817       on error undo, return error
     5818       :
     5819           assign
     5820               v-str   = string( buf_temp_goods-qnty.gds-code )
     5821                       + "   " + ( if buf_temp_goods-qnty.recipe-type = ? then "?" else string( buf_temp_goods-qnty.recipe-type ) )
     5822                       + "   " + ( if buf_temp_goods-qnty.recipe-code = ? then "?" else string( buf_temp_goods-qnty.recipe-code ) )
     5823                       + "   " + ( if buf_temp_goods-qnty.trn-type = ?    then "?" else string( buf_temp_goods-qnty.trn-type ) )
     5824                       + "   " + ( if buf_temp_goods-qnty.need-qnty = ?   then "?" else string( buf_temp_goods-qnty.need-qnty ) )
     5825                       + "   " + string( buf_temp_goods-qnty.calculated )
     5826           .
     5827           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5828       end.
     5829       assign
     5830           v-str = "        temp_dressing-ingr:"
     5831       .
     5832       run writelog in this-procedure (  log-file-name, 0, v-str ).
     5833       for each buf_temp_dressing-ingr
     5834       on error undo, return error
     5835       :
     5836           assign
     5837               v-str   = string( buf_temp_dressing-ingr.recipe-code  )
     5838                       + "   " + string( buf_temp_dressing-ingr.gds-code )
     5839                       + "   " + ( if buf_temp_dressing-ingr.line-qnty = ?   then "?" else string( buf_temp_dressing-ingr.line-qnty ) )
     5840                       + "   " + ( if buf_temp_dressing-ingr.used-qnty = ?   then "?" else string( buf_temp_dressing-ingr.used-qnty ) )
     5841                       + "   " + ( if buf_temp_dressing-ingr.recipe-qnty = ? then "?" else string( buf_temp_dressing-ingr.recipe-qnty ) )
     5842           .
     5843           run writelog in this-procedure (  log-file-name, 1, v-str ).
     5844       end.
     5845   end.
     5846   END PROCEDURE.
     5847   PROCEDURE add-new-recipe :
     5848   do
     5849   on error undo, return error
     5850   :
     5851   define input parameter p-mainmenu-handle    as handle           no-undo.
     5852   define input parameter p-doc-code           as character        no-undo.
     5853   define input parameter p-trn-type           as character        no-undo.
     5854   define input parameter p-gds-code           as integer          no-undo.
     5855   define input parameter p-need-qnty          as decimal          no-undo.
     5856   define input parameter p-autofbr            as logical          no-undo.
     5857   define input parameter p-have-store         as logical          no-undo.
     5858       define variable v-comp-gds-code         as integer          no-undo.
     5859       define variable v-comp-trn-type         as character        no-undo.
     5860       define variable v-comp-need-qnty        as decimal          no-undo.
     5861       define variable v-comp-recipe-type      as character        no-undo.
     5862       define variable v-comp-recipe-code      as character        no-undo.
     5863       define variable v-comp-recipe-found     as logical          no-undo.
     5864       define variable v-ext-comp-recipe-type  as character        no-undo.
     5865       define variable v-no-add-good           as logical          no-undo.
     5866       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     5867       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     5868       define buffer buf_goods                 for ub.goods.
     5869       define buffer buf_fbr-line              for ub.fbr-line.
     5870       define buffer buf_fbr-doc               for ub.fbr-doc.
     5871       define variable v-value          as character no-undo .
     5872       define variable v-type           as character no-undo .
     5873       define variable v-attr-value     as character no-undo .
     5874       define variable v-attr-value-rec as character no-undo .
     5875       define variable v-attr-type      as character no-undo .
     5876       define variable v-ban-recipes as logical no-undo .
     5877       define variable v-ban-altr    as logical no-undo .
     5878       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     5879       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     5880       find first buf_fbr-doc no-lock
     5881            where buf_fbr-doc.doc-code = p-doc-code
     5882       .
     5883       run extend-noweight-gds-qnty in this-procedure (
     5884             input p-gds-code
     5885           , input p-need-qnty
     5886           , output p-need-qnty
     5887       ).
     5888       run select-recipe in this-procedure (
     5889             input p-mainmenu-handle
     5890           , input buf_fbr-doc.obj-type
     5891           , input buf_fbr-doc.obj-code
     5892           , input p-gds-code
     5893           , input p-trn-type
     5894           , input p-need-qnty
     5895           , input p-autofbr
     5896           , input p-have-store
     5897           , output v-comp-gds-code
     5898           , output v-comp-trn-type
     5899           , output v-comp-need-qnty
     5900           , output v-comp-recipe-type
     5901           , output v-comp-recipe-code
     5902           , output v-comp-recipe-found
     5903           , output v-no-add-good
     5904       ) no-error.
     5905       if not error-status :error
     5906       and v-comp-recipe-found = yes
     5907       and v-no-add-good       = no
     5908       then do:
     5909           find first buf_goods no-lock
     5910                where buf_goods.gds-code = v-comp-gds-code
     5911           .
     5912           assign
     5913               v-ext-comp-recipe-type = v-comp-recipe-type
     5914           .
     5915           if v-comp-recipe-type = 'комплектация':U
     5916           and v-comp-trn-type   = 'спи':U
     5917           then do:
     5918               assign
     5919                   v-ext-comp-recipe-type = 'разделка':U
     5920               .
     5921           end.
     5922           case v-ext-comp-recipe-type
     5923           :
     5924               when 'разделка':U
     5925               then do:
     5926                   find first buf_temp_goods-qnty
     5927                        where buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5928                          and buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5929                   no-error.
     5930                   if not available buf_temp_goods-qnty
     5931                   then do:
     5932                       create buf_temp_goods-qnty.
     5933                       assign
     5934                           buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     5935                           buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     5936                           buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     5937                           buf_temp_goods-qnty.artic       = buf_goods.artic
     5938                           buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     5939                           buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     5940                           buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     5941                           buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     5942                           buf_temp_goods-qnty.calculated  = no
     5943                       .
     5944                   end.
     5945                   else do:
     5946                       find first buf_goods no-lock
     5947                            where buf_goods.gds-code = p-gds-code
     5948                       .
     5949                       find first buf_fbr-line no-lock
     5950                            where buf_fbr-line.doc-code    = p-doc-code
     5951                              and buf_fbr-line.trn-type    = p-trn-type
     5952                              and buf_fbr-line.recipe-code = v-comp-recipe-code
     5953                              and buf_fbr-line.artic       = buf_goods.artic
     5954                              and buf_fbr-line.prod-type   = buf_goods.prod-type
     5955                              and buf_fbr-line.prod-code   = buf_goods.prod-code
     5956                       no-error.
     5957                       if available buf_fbr-line
     5958                       then do:
     5959                           define variable v-line-qnty             as decimal   no-undo.
     5960                           define variable v-used-qnty             as decimal   no-undo.
     5961                           define variable v-free-qnty             as decimal   no-undo.
     5962                           define variable v-recipe-qnty           as decimal   no-undo.
     5963                           define variable v-comp-fbr-line-recid   as recid     no-undo.
     5964                           run get-temp_dressing-ingr-used-qnty in this-procedure (
     5965                                 input v-comp-recipe-code
     5966                               , input p-gds-code
     5967                               , output v-line-qnty
     5968                               , output v-used-qnty
     5969                               , output v-recipe-qnty
     5970                           ).
     5971                           run fbrrest-get-free-qnty in this-procedure (
     5972                                 input buf_fbr-doc.obj-type
     5973                               , input buf_fbr-doc.obj-code
     5974                               , input p-gds-code
     5975                               , input p-autofbr
     5976                               , output v-free-qnty
     5977                           ).
     5978                           assign
     5979                               p-need-qnty = p-need-qnty + v-recipe-qnty
     5980                           .
     5981                           run calc-comp-from-ingr in this-procedure (
     5982                                 input recid( buf_fbr-line )
     5983                               , input p-need-qnty
     5984                               , output v-comp-fbr-line-recid
     5985                               , output v-comp-need-qnty
     5986                           ) .
     5987                       end.
     5988                       assign
     5989                           buf_temp_goods-qnty.need-qnty   = maximum( buf_temp_goods-qnty.need-qnty, v-comp-need-qnty )
     5990                           buf_temp_goods-qnty.calculated  = no
     5991                       .
     5992                   end.
     5993               end.
     5994               otherwise do:
     5995         if v-ban-altr or v-ban-recipes then
     5996         do:
     5997             if v-ext-comp-recipe-type = 'производство':U and v-ban-recipes then
     5998             do:
     5999                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6000                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6001                      , input  'mark-type':U
     6002                      , output v-attr-value
     6003                      , output v-attr-type
     6004                      ) no-error .
     6005                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6006                   do:
     6007                      message "Рецепт производства " + v-comp-recipe-code + " содержит маркированный товар."
     6008                         view-as alert-box.
     6009                      return .
     6010                   end.
     6011                end.
     6012             end.
     6013             if v-ext-comp-recipe-type = 'альтернатива':U and v-ban-altr then
     6014             do:
     6015                if not check-ban-sales-via-cd(buf_goods.gds-code) then
     6016                do:
     6017                  message "Рецепт альтернатива " + v-comp-recipe-code + " входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     6018                    view-as alert-box.
     6019                  return .
     6020                end.
     6021             end.
     6022             if v-ext-comp-recipe-type = 'комплектация':U and v-ban-recipes then
     6023             do:
     6024                for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = v-comp-recipe-code:
     6025                   run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     6026                      , input  'mark-type':U
     6027                      , output v-attr-value
     6028                      , output v-attr-type
     6029                      ) no-error .
     6030                   if v-attr-value <> "" and v-attr-value <> "not-type" then
     6031                   do:
     6032                      run gds-attr-value in this-procedure  ( input  p-gds-code
     6033                         , input  'mark-type':U
     6034                         , output v-attr-value-rec
     6035                         , output v-attr-type
     6036                         ) no-error .
     6037                      if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     6038                      do:
     6039                         message "Рецепт комплектации " + v-comp-recipe-code + " должен быть маркированным"
     6040                            view-as alert-box.
     6041                         return .
     6042                      end.
     6043                      else leave.
     6044                   end.
     6045                end.
     6046             end.
     6047         end.
     6048                   find first buf_temp_goods-qnty
     6049                        where buf_temp_goods-qnty.gds-code = p-gds-code
     6050                          and buf_temp_goods-qnty.trn-type = p-trn-type
     6051                   no-error.
     6052                   if available buf_temp_goods-qnty
     6053                   then do:
     6054                       assign
     6055                           buf_temp_goods-qnty.need-qnty  = buf_temp_goods-qnty.need-qnty + p-need-qnty
     6056                       .
     6057                       if buf_temp_goods-qnty.recipe-code <> ""
     6058                       then do:
     6059                           assign
     6060                               buf_temp_goods-qnty.calculated = no
     6061                           .
     6062                       end.
     6063                       run writelog in this-procedure ( log-file-name, 5, substitute( "Раскрутка ингредиетнов: добавляем товар '&1' к уже рассчитанному: &2", buf_temp_goods-qnty.artic, buf_temp_goods-qnty.need-qnty  ) ).
     6064                   end.
     6065                   else do:
     6066                       find first buf_temp_goods-qnty
     6067                            where buf_temp_goods-qnty.gds-code = v-comp-gds-code
     6068                              and buf_temp_goods-qnty.trn-type = v-comp-trn-type
     6069                       no-error.
     6070                       if not available buf_temp_goods-qnty
     6071                       then do:
     6072                           create buf_temp_goods-qnty.
     6073                           find first buf_goods no-lock
     6074                                where buf_goods.gds-code = v-comp-gds-code
     6075                           .
     6076                           assign
     6077                               buf_temp_goods-qnty.gds-code    = v-comp-gds-code
     6078                               buf_temp_goods-qnty.artic       = buf_goods.artic
     6079                               buf_temp_goods-qnty.prod-type   = buf_goods.prod-type
     6080                               buf_temp_goods-qnty.prod-code   = buf_goods.prod-code
     6081                               buf_temp_goods-qnty.trn-type    = v-comp-trn-type
     6082                               buf_temp_goods-qnty.need-qnty   = v-comp-need-qnty
     6083                               buf_temp_goods-qnty.recipe-type = v-comp-recipe-type
     6084                               buf_temp_goods-qnty.recipe-code = v-comp-recipe-code
     6085                               buf_temp_goods-qnty.calculated  = no
     6086                           .
     6087                           run writelog in this-procedure ( log-file-name, 5, "Раскрутка ингредиентов: добавляем товар как не рассчитанный." ).
     6088                       end.
     6089                   end.
     6090               end.
     6091           end case.
     6092           if available buf_temp_goods-qnty
     6093           then do:
     6094               run extend-noweight-gds-qnty in this-procedure (
     6095                     input buf_temp_goods-qnty.gds-code
     6096                   , input buf_temp_goods-qnty.need-qnty
     6097                   , output buf_temp_goods-qnty.need-qnty
     6098               ).
     6099           end.
     6100           find first buf_goods no-lock
     6101                where buf_goods.gds-code = v-comp-gds-code
     6102           .
     6103           if v-ext-comp-recipe-type = 'разделка':U
     6104           then do:
     6105               find first buf_fbr-line exclusive-lock
     6106                   where buf_fbr-line.doc-code    = p-doc-code
     6107                   and buf_fbr-line.trn-type    = v-comp-trn-type
     6108                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6109                   and buf_fbr-line.artic       = buf_goods.artic
     6110                   and buf_fbr-line.prod-type   = buf_goods.prod-type
     6111                   and buf_fbr-line.prod-code   = buf_goods.prod-code
     6112               no-error.
     6113               if available buf_fbr-line
     6114               then do:
     6115                   assign
     6116                       buf_fbr-line.fact-qnty = 0
     6117                   .
     6118               end.
     6119           end.
     6120           else do:
     6121               for each buf_fbr-line exclusive-lock
     6122               where buf_fbr-line.doc-code    = p-doc-code
     6123                   and buf_fbr-line.recipe-code = v-comp-recipe-code
     6124               on error undo, return error
     6125               :
     6126                   delete buf_fbr-line.
     6127               end.
     6128           end.
     6129       end.
     6130   end.
     6131   END PROCEDURE.
     6132   PROCEDURE extend-noweight-gds-qnty :
     6133   do
     6134   on error undo, return error
     6135   :
     6136   define input parameter p-gds-code   as integer      no-undo.
     6137   define input parameter p-in-qnty    as decimal      no-undo.
     6138   define output parameter p-out-qnty  as decimal      no-undo.
     6139       define buffer buf_goods                 for ub.goods.
     6140       define buffer buf_units                 for ub.units.
     6141       find first buf_goods no-lock
     6142            where buf_goods.gds-code = p-gds-code
     6143       .
     6144       find first buf_units no-lock
     6145            where buf_units.unit-name = buf_goods.unit-base
     6146       .
     6147       assign
     6148           p-out-qnty = p-in-qnty
     6149       .
     6150       if not ( lookup( 'вес':U, buf_units.type ) > 0
     6151                or lookup ('дро':U, buf_units.type) > 0 )
     6152       then do:
     6153           if p-out-qnty <> truncate( p-out-qnty, 0 )
     6154           then do:
     6155               assign
     6156                   p-out-qnty = truncate( p-out-qnty, 0 ) + 1
     6157               .
     6158           end.
     6159       end.
     6160   end.
     6161   END PROCEDURE.
     6162   PROCEDURE select-recipe :
     6163   do
     6164   on error undo, return error
     6165   :
     6166   define input parameter p-mainmenu-handle    as handle           no-undo.
     6167   define input parameter p-obj-type           as character        no-undo.
     6168   define input parameter p-obj-code           as integer          no-undo.
     6169   define input parameter p-gds-code           as integer          no-undo.
     6170   define input parameter p-trn-type           as character        no-undo.
     6171   define input parameter p-gds-qnty           as decimal          no-undo.
     6172   define input parameter p-autofbr            as logical          no-undo.
     6173   define input parameter p-have-store         as logical          no-undo.
     6174   define output parameter p-out-gds-code      as integer          no-undo.
     6175   define output parameter p-out-trn-type      as character        no-undo.
     6176   define output parameter p-out-gds-qnty      as decimal          no-undo.
     6177   define output parameter p-out-recipe-type   as character        no-undo.
     6178   define output parameter p-out-recipe-code   as character        no-undo.
     6179   define output parameter p-recipe-found      as logical          no-undo.
     6180   define output parameter p-no-need-good      as logical          no-undo.
     6181   define variable v-host-code             as integer      no-undo.
     6182   define variable v-value-character as character  no-undo .
     6183   define variable v-value-date      as date       no-undo .
     6184   define variable v-value-decimal   as decimal    no-undo .
     6185   define variable v-value-integer   as integer    no-undo .
     6186   define variable v-value-logical   as logical    no-undo .
     6187   define variable v-tth             as handle     no-undo .
     6188   define variable v-param-type            as character no-undo .
     6189   define variable v-type                  as character    no-undo.
     6190   define variable v-recipe-type           as character    no-undo.
     6191   define variable v-recipe-list           as character    no-undo.
     6192   define variable v-is-comp               as logical      no-undo.
     6193   define variable v-is-integration        as logical      no-undo.
     6194   define variable v-cancel                as logical      no-undo.
     6195   define variable v-yesno                 as logical      no-undo.
     6196   define variable v-default-recipe-code   as character    no-undo.
     6197       define buffer buf_recipe            for ub.recipe.
     6198       define buffer buf_goods             for ub.goods.
     6199       define buffer buf_selected_recipe   for ub.recipe.
     6200       define buffer buf_recipe-gds        for ub.recipe-gds.
     6201       define buffer buf_ingr_goods        for ub.goods.
     6202       run writelog in this-procedure (
     6203           input log-file-name
     6204           , input 0
     6205           , input "******** select-recipe ***************************************"
     6206       ).
     6207       find first buf_goods no-lock
     6208            where buf_goods.gds-code = p-gds-code
     6209       .
     6210       if p-trn-type = ?
     6211       then do:
     6212           run writelog in this-procedure ( log-file-name, 0, "Не определен тип строки. Добавление невозможно" ).
     6213           undo, return error.
     6214       end.
     6215   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6217     (input  p-obj-type
     6218     ,input  p-obj-code
     6219     ,output v-host-code
     6220     )  .
     6221       run adm/shattri.p ( input "get":U
     6222                         , input  '':u
     6223                         , input  0
     6224                         , input  'fbrattr':U
     6225                         , input  'fbr-frcp':U
     6226                         , output v-value-character
     6227                         , output v-value-date
     6228                         , output v-value-decimal
     6229                         , output v-value-integer
     6230                         , output v-value-logical
     6231                         , output v-param-type
     6232                         , input-output table-handle v-tth
     6233                         ) no-error .
     6234       if error-status :error then do:
     6235          assign
     6236             v-value-logical = FALSE
     6237          .
     6238       end.
     6239       run writelog in this-procedure (
     6240             input log-file-name
     6241           , input 1
     6242           , input substitute( "fbr-frcp = '&1'", v-value-logical )
     6243       ).
     6244       assign
     6245           p-out-recipe-type = ?
     6246           p-out-recipe-code = ?
     6247           v-recipe-type = ?
     6248       .
     6249       run fbrlib-get-obj-recipe in this-procedure (
     6250             input p-obj-type
     6251           , input p-obj-code
     6252           , input p-gds-code
     6253           , output v-default-recipe-code
     6254       ).
     6255       comp-recipe:
     6256       for each buf_recipe no-lock
     6257          where ( buf_recipe.obj-type = p-obj-type
     6258              and buf_recipe.obj-code = p-obj-code
     6259              and buf_recipe.artic     = buf_goods.artic
     6260              and buf_recipe.prod-type = buf_goods.prod-type
     6261              and buf_recipe.prod-code = buf_goods.prod-code
     6262              and buf_recipe.stts      <> 2
     6263             )
     6264             or ( buf_recipe.obj-type = ""
     6265              and buf_recipe.obj-code = 0
     6266              and buf_recipe.artic     = buf_goods.artic
     6267              and buf_recipe.prod-type = buf_goods.prod-type
     6268              and buf_recipe.prod-code = buf_goods.prod-code
     6269              and buf_recipe.stts      <> 2
     6270             )
     6271       :
     6272           if  ( p-autofbr = yes or v-value-logical = yes ) and buf_recipe.recipe-code <> v-default-recipe-code
     6273           then do:
     6274               undo comp-recipe, next comp-recipe.
     6275           end.
     6276           run writelog in this-procedure (
     6277                 input log-file-name
     6278               , input 3
     6279               , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6280           ).
     6281           if p-autofbr = yes
     6282           and buf_recipe.recipe-type <> 'производство':U
     6283           and buf_recipe.recipe-type <> 'альтернатива':U
     6284           and buf_recipe.recipe-type <> 'комплектация':U
     6285           and buf_recipe.recipe-type <> 'комплектация':U
     6286           then do:
     6287               next comp-recipe.
     6288           end.
     6289           if p-trn-type = 'при':U
     6290           and buf_recipe.recipe-type = 'разделка':U
     6291           then do:
     6292               run writelog in this-procedure (
     6293                     input log-file-name
     6294                   , input 4
     6295                   , input "Разделка для составного не может дать прихода. Ищем следующий рецепт"
     6296               ).
     6297               next comp-recipe.
     6298           end.
     6299           if p-trn-type = 'спи':U
     6300           and buf_recipe.recipe-type <> 'разделка':U
     6301           and buf_recipe.recipe-type <> 'комплектация':U
     6302           then do:
     6303               run writelog in this-procedure (
     6304                     input log-file-name
     6305                   , input 4
     6306                   , input "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт"
     6307               ).
     6308               next comp-recipe.
     6309           end.
     6310           if v-recipe-type = ?
     6311           then do:
     6312               assign
     6313                   p-out-recipe-type = buf_recipe.recipe-type
     6314                   p-out-recipe-code = buf_recipe.recipe-code
     6315                   v-recipe-type = "recipe"
     6316                   v-is-integration = yes
     6317               .
     6318               run writelog in this-procedure (
     6319                     input log-file-name
     6320                   , input 4
     6321                   , input "Найден первый подходящий рецепт для составного"
     6322               ).
     6323               if v-value-logical
     6324               then do:
     6325                   run writelog in this-procedure (
     6326                       input log-file-name
     6327                       , input 4
     6328                       , input "Включен параметр fbr-frcp. Больше рецепт не ищем"
     6329                   ).
     6330                   leave comp-recipe.
     6331               end.
     6332               if p-autofbr = yes
     6333               then do:
     6334                   run writelog in this-procedure (
     6335                         input log-file-name
     6336                       , input 4
     6337                       , input "Раскрутка для ресторана. Больше рецепт не ищем"
     6338                   ).
     6339                   leave comp-recipe.
     6340               end.
     6341           end.
     6342           else do:
     6343               run writelog in this-procedure (
     6344                     input log-file-name
     6345                   , input 4
     6346                   , input "Найден еще один подходящий рецепт"
     6347               ).
     6348               assign
     6349                   v-yesno = ?
     6350                   p-no-need-good = yes
     6351               .
     6352               do while v-yesno = ?
     6353               and p-no-need-good = yes
     6354               :
     6355                   run ref/rcp-all.w (
     6356                         input p-mainmenu-handle
     6357                       , input "b-sel"
     6358                       , input 'все':U
     6359                       , input recid( buf_goods )
     6360                       , input p-obj-type
     6361                       , input p-obj-code
     6362                       , output v-recipe-list
     6363                   ) no-error.
     6364                   if error-status :error
     6365                   or v-recipe-list = ""
     6366                   then do:
     6367                       message
     6368                           "Отменить добавление товара?"
     6369                           skip(1)
     6370                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     6371                           skip(1)
     6372                           skip "Yes - отменить добавление текущего товара"
     6373                           skip "No  - отменить добавление товаров"
     6374                           skip "Cancel - вернуться к выбору рецептов"
     6375                       view-as alert-box question
     6376                       buttons yes-no-cancel
     6377                       title "Отмена"
     6378                       update v-yesno
     6379                       .
     6380                   end.
     6381                   else do:
     6382                       assign
     6383                           p-no-need-good = no
     6384                       .
     6385                   end.
     6386               end.
     6387               if p-no-need-good = yes
     6388               then do:
     6389                   if v-yesno = no
     6390                   then do:
     6391                       undo, return error .
     6392                   end.
     6393                   else do:
     6394                       return.
     6395                   end.
     6396               end.
     6397               find first buf_selected_recipe no-lock
     6398                    where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
     6399               no-error.
     6400               if not available buf_selected_recipe
     6401               then do:
     6402                   assign
     6403                       p-out-recipe-type = ?
     6404                       p-out-recipe-code = ?
     6405                       v-is-integration  = ?
     6406                   .
     6407               end.
     6408               else do:
     6409                   assign
     6410                       p-out-recipe-type   = buf_selected_recipe.recipe-type
     6411                       p-out-recipe-code   = buf_selected_recipe.recipe-code
     6412                       v-recipe-type       = "recipe"
     6413                       v-is-integration    = yes
     6414                   .
     6415                   leave comp-recipe.
     6416               end.
     6417           end.
     6418       end.
     6419       if v-recipe-type = ?
     6420       and p-autofbr = no
     6421       then do:
     6422           run writelog in this-procedure (
     6423                 input log-file-name
     6424               , input 3
     6425               , input "Поиск товара среди ингредиентов рецептов."
     6426           ).
     6427           search-recipe-gds:
     6428           for each buf_recipe-gds
     6429              where buf_recipe-gds.artic       = buf_goods.artic
     6430                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6431                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6432           :
     6433               find first buf_recipe no-lock
     6434                    where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
     6435                      and buf_recipe.obj-type    = p-obj-type
     6436                      and buf_recipe.obj-code    = p-obj-code
     6437                    no-error
     6438               .
     6439               if not available buf_recipe then next search-recipe-gds.
     6440               find buf_ingr_goods no-lock
     6441                   where buf_ingr_goods.gds-code = buf_recipe.gds-code
     6442               .
     6443               if buf_ingr_goods.stts <> 0 then do:
     6444                   run writelog in this-procedure (
     6445                         input log-file-name
     6446                       , input 3
     6447                       , input subst("Рецепт &1 на товар &2 не подходит т.к. товар удален", buf_recipe.recipe-code, buf_ingr_goods.gds-code)
     6448                   ).
     6449                   next search-recipe-gds.
     6450               end.
     6451               run writelog in this-procedure (
     6452                     input log-file-name
     6453                   , input 3
     6454                   , input substitute( "Рецепт: &1. Тип: &2 " , buf_recipe.recipe-code, buf_recipe.recipe-type )
     6455               ).
     6456               if p-trn-type = 'при':U
     6457               and buf_recipe.recipe-type <> 'разделка':U
     6458               and buf_recipe.recipe-type <> 'комплектация':U
     6459               then do:
     6460                   run writelog in this-procedure (
     6461                         input log-file-name
     6462                       , input 3
     6463                       , input "Тип не подходит. Только разделка или разукомплектация для ингредиента может дать приход"
     6464                   ).
     6465                   next search-recipe-gds.
     6466               end.
     6467               if p-trn-type = 'спи':U
     6468               and buf_recipe.recipe-type = 'разделка':U
     6469               then do:
     6470                   run writelog in this-procedure (
     6471                         input log-file-name
     6472                       , input 3
     6473                       , input "Тип не подходит. Разделка для ингредиента не может дать списания"
     6474                   ).
     6475                   next search-recipe-gds.
     6476               end.
     6477               if v-recipe-type = ?
     6478               then do:
     6479                   assign
     6480                       p-out-recipe-type   = buf_recipe.recipe-type
     6481                       p-out-recipe-code   = buf_recipe.recipe-code
     6482                       v-recipe-type       = "recipe-gds"
     6483                       v-is-integration    = no
     6484                   .
     6485                   if v-value-logical
     6486                   then do:
     6487                       leave search-recipe-gds.
     6488                   end.
     6489               end.
     6490               else do:
     6491                   assign
     6492                       p-out-recipe-type = ?
     6493                       p-out-recipe-code = p-out-recipe-code + chr(44) + buf_recipe.recipe-code
     6494                       v-is-integration  = ?
     6495                   .
     6496               end.
     6497           end.
     6498       end.
     6499       if p-out-recipe-type = ?
     6500       and p-out-recipe-code = ?
     6501       then do:
     6502           assign
     6503               p-recipe-found = no
     6504           .
     6505       end.
     6506       else do:
     6507           if p-out-recipe-type = ?
     6508           then do:
     6509               define variable v-recipe-recid-list as character     no-undo.
     6510               run str/rcp-sel.w (
     6511                     input p-mainmenu-handle
     6512                   , input buf_goods.gds-code
     6513                   , input 'при':U
     6514                   , output p-out-recipe-code
     6515                   , output v-is-integration
     6516                   , output v-cancel
     6517               ) .
     6518               if v-cancel = yes
     6519               then do:
     6520                   assign
     6521                       p-recipe-found = no
     6522                       p-no-need-good = yes
     6523                   .
     6524                   return.
     6525               end.
     6526           end.
     6527           assign
     6528               p-recipe-found = yes
     6529           .
     6530           find first buf_recipe no-lock
     6531                where buf_recipe.recipe-code = p-out-recipe-code
     6532           .
     6533           find first buf_goods no-lock
     6534                where buf_goods.artic      = buf_recipe.artic
     6535                  and buf_goods.prod-type  = buf_recipe.prod-type
     6536                  and buf_goods.prod-code  = buf_recipe.prod-code
     6537           .
     6538           assign
     6539               p-out-recipe-type   = buf_recipe.recipe-type
     6540               p-out-gds-code      = buf_goods.gds-code
     6541           .
     6542           run fbrlib-get-trn-type in this-procedure (
     6543                 input buf_recipe.recipe-code
     6544               , input recid( buf_goods )
     6545               , input v-is-integration
     6546               , output v-is-comp
     6547               , output p-out-trn-type
     6548           ).
     6549           run writelog in this-procedure (
     6550                 input log-file-name
     6551               , input 1
     6552               , input substitute( "Найден рецепт '&1' с is-comp = &2, товаром '&3 &4', типом &5"
     6553                                   , p-out-recipe-code
     6554                                   , v-is-comp
     6555                                   , buf_goods.artic
     6556                                   , buf_goods.gds-name
     6557                                   , p-out-trn-type )
     6558           ).
     6559           if p-out-gds-code <> p-gds-code
     6560           then do:
     6561               run writelog in this-procedure (
     6562                     input log-file-name
     6563                   , input 1
     6564                   , input "Необходимый товар является ингредиентом"
     6565               ).
     6566               find first buf_goods no-lock
     6567                    where buf_goods.gds-code = p-gds-code
     6568               .
     6569               find first buf_recipe-gds no-lock
     6570                    where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     6571                      and buf_recipe-gds.artic       = buf_goods.artic
     6572                      and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6573                      and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6574               .
     6575               if buf_recipe-gds.brutto-qnty = ?
     6576               or buf_recipe-gds.brutto-qnty = 0
     6577               then do:
     6578                   message
     6579                       "При раскрутке рецепта обнаружен ингредиент с количеством " buf_recipe-gds.brutto-qnty
     6580                       skip "Продолжение расчета документа невозможно."
     6581                       skip(1) "Код рецепта:      " buf_recipe.recipe-code
     6582                       skip    "Товар ингредиента:" buf_recipe-gds.artic buf_goods.gds-name
     6583                   view-as alert-box error.
     6584                   undo, return error .
     6585               end.
     6586               assign
     6587                   p-out-gds-qnty = p-gds-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     6588                   p-out-trn-type = ( if p-trn-type = 'спи':U then 'при':U else 'спи':U )
     6589               .
     6590               run writelog in this-procedure (
     6591                   input log-file-name
     6592                   , input 1
     6593                   , input substitute( "Количество товара: &1. Для его производства необходимо: &2 по рецепту: &3. Тип строки составного: &4."
     6594                                       , p-gds-qnty
     6595                                       , p-out-gds-qnty
     6596                                       , p-out-recipe-code
     6597                                       , p-out-trn-type )
     6598               ).
     6599           end.
     6600           else do:
     6601               assign
     6602                   p-out-gds-qnty = p-gds-qnty
     6603                   p-out-trn-type = p-trn-type
     6604               .
     6605               run writelog in this-procedure (
     6606                     input log-file-name
     6607                   , input 1
     6608                   , input substitute( "Для производства товара необходимо: &1 по рецепту: &2. Тип строки: &3."
     6609                                       , p-out-gds-qnty
     6610                                       , p-out-recipe-code
     6611                                       , p-out-trn-type )
     6612               ).
     6613           end.
     6614       end.
     6615   end.
     6616   END PROCEDURE.
