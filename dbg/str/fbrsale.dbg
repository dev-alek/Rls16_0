     7764   procedure grp-obj-notcorr-value :
     7765   do
     7766   on error undo, return error
     7767   :
     7768   define input parameter p-node-code             as integer      no-undo.
     7769   define input parameter p-obj-type              as character    no-undo.
     7770   define input parameter p-obj-code              as integer      no-undo.
     7771   define output parameter p-notcorr              as character    no-undo init ?.
     7772   define output parameter p-range-notcorr     as integer      no-undo.
     7773   define output parameter p-exists-notcorr    as logical      no-undo.
     7774   define variable v-host-code as integer      no-undo.
     7775   DEFINE VARIABLE v-found as logical no-undo .
     7776   DEFINE VARIABLE v-exists as logical no-undo .
     7777   DEFINE VARIABLE v-range as integer no-undo .
     7778   DEFINE VARIABLE jj as integer no-undo .
     7779   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7780   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7781   define buffer buf_gds-grp for ub.gds-grp.
     7782   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7783   find first buf_gds-grp no-lock where
     7784              buf_gds-grp.node-code = p-node-code no-error .
     7785   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7786     message
     7787       vss-workfile vss-revision vss-description
     7788       skip "Не удалось найти группу товаров с кодом" p-node-code
     7789       view-as alert-box error .
     7790     undo, return error .
     7791   end.
     7792   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7794     (input  p-obj-type
     7795     ,input  p-obj-code
     7796     ,output v-host-code
     7797     ) no-error .
     7798   if error-status :error
     7799   then do:
     7800       message
     7801         vss-workfile vss-revision vss-description
     7802         skip "Не удалось найти фирму объекта"
     7803         skip p-obj-type p-obj-code
     7804         skip return-value
     7805         skip trim(error-status :get-message(1))
     7806       view-as alert-box error.
     7807       undo, return error .
     7808   end.
     7809   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7810   do while v-found = no and jj < 2:
     7811     if v-range <> 3 then do:
     7812       find first buf_gds-grp-obj no-lock
     7813           where buf_gds-grp-obj.node-code = p-node-code
     7814             and buf_gds-grp-obj.host-code = v-host-code
     7815             and buf_gds-grp-obj.obj-type  = p-obj-type
     7816             and buf_gds-grp-obj.obj-code  = p-obj-code
     7817       no-error .
     7818     end.
     7819     if v-range = 3 or not available buf_gds-grp-obj
     7820     then do:
     7821        if v-range <> 2 then do:
     7822           find first buf_gds-grp-obj no-lock
     7823               where buf_gds-grp-obj.node-code = p-node-code
     7824                 and buf_gds-grp-obj.host-code = v-host-code
     7825                 and buf_gds-grp-obj.obj-type  = ""
     7826                 and buf_gds-grp-obj.obj-code  = 0
     7827           no-error .
     7828         end.
     7829         if v-range = 2 or not available buf_gds-grp-obj
     7830         then do:
     7831             if v-range <> 1 then do:
     7832               find first buf_gds-grp-obj no-lock
     7833                   where buf_gds-grp-obj.node-code = p-node-code
     7834                   and buf_gds-grp-obj.host-code = 0
     7835                   and buf_gds-grp-obj.obj-type  = ""
     7836                   and buf_gds-grp-obj.obj-code  = 0
     7837               no-error .
     7838             end.
     7839             if v-range = 1 or not available buf_gds-grp-obj
     7840             then do:
     7841                 assign
     7842                     v-exists = no
     7843                 .
     7844             end.
     7845             else do:
     7846                 assign
     7847                     v-exists = yes
     7848                     v-range = 1
     7849                 .
     7850             end.
     7851         end.
     7852         else do:
     7853             assign
     7854                 v-exists = yes
     7855                 v-range  = 2
     7856             .
     7857         end.
     7858     end.
     7859     else do:
     7860         assign
     7861             v-exists = yes
     7862             v-range  = 3
     7863         .
     7864     end.
     7865     if available buf_gds-grp-obj
     7866     then do:
     7867       find first buf_gds-grp-obj-attr no-lock
     7868         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7869           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7870           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7871           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7872           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7873         no-error .
     7874       if available buf_gds-grp-obj-attr then do:
     7875         assign
     7876           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7877         .
     7878       end.
     7879       else do:
     7880         assign
     7881           v-notcorr-value = ?
     7882         .
     7883       end.
     7884       assign
     7885       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7886                           then yes
     7887                           else p-exists-notcorr)
     7888       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7889                         then v-range
     7890                         else p-range-notcorr
     7891       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7892                         then v-notcorr-value
     7893                         else p-notcorr
     7894       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7895       jj = jj + 1
     7896       .
     7897     end.
     7898     else do:
     7899       assign
     7900       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7901       jj = jj + 1
     7902       .
     7903     end.
     7904   end.
     7905   end.
     7906   end procedure.
     7907   define variable v-fbr-log-file-name as character no-undo init 'fbr-rsrv-errors.txt'.
     7908   define variable v-fbr-tt-log-file-name as character no-undo init 'fbr-rsrv-errors-tt.txt'.
     7909   define temp-table tt-rsrv-err no-undo
     7910     field artic like ub.goods.artic
     7911     field gds-name like ub.goods.gds-name
     7912     field rsrv-qnty like ub.gds-obj.fact-qnty
     7913     field req-qnty like ub.gds-obj.fact-qnty
     7914   .
     7915   define stream stm.
     7916   os-delete value('fbr-rsrv-errors.txt') no-error.
     7917   os-delete value('fbr-rsrv-errors-tt.txt') no-error.
     7918   define temp-table temp_fbr-objects no-undo
     7919      field obj-type as character
     7920      field obj-code as integer
     7921      index pi is primary unique obj-type obj-code
     7922      .
     7923   define variable v-fbr-doc-code           as character no-undo.
     7924   define variable v-out-gds-code           as integer   no-undo.
     7925   define variable v-out-trn-type           as character no-undo.
     7926   define variable v-out-gds-qnty           as decimal   no-undo.
     7927   define variable v-out-recipe-type        as character no-undo.
     7928   define variable v-out-recipe-code        as character no-undo.
     7929   define variable v-recipe-found           as logical   no-undo.
     7930   define variable v-no-need-good           as logical   no-undo.
     7931   define variable v-same-good              as logical   no-undo.
     7932   define variable v-same-good-old-qnty     as decimal   no-undo.
     7933   define variable v-reserved               as logical   no-undo.
     7934   define variable v-doc-code               as character no-undo.
     7935   define variable v-kitchen-rest           as logical   no-undo.
     7936   define variable v-store-rest             as logical   no-undo.
     7937   define variable v-kitchen-free-qnty      as decimal   no-undo.
     7938   define variable v-restaurant-free-qnty   as decimal   no-undo.
     7939   define variable v-need-qnty              as decimal   no-undo.
     7940   define variable v-fbr-doc-is-not-empty   as logical   no-undo.
     7941   define variable v-fbrsale-hst-upper-code as integer   no-undo.
     7942   define variable v-upper-code             as integer   no-undo.
     7943   define variable v-store-type             as character no-undo.
     7944   define variable v-store-code             as integer   no-undo.
     7945   define variable v-host-code              as integer   no-undo.
     7946   define variable v-is-res                 as character no-undo.
     7947   define variable v-par-type               as character no-undo.
     7948   define variable v-mess                   as character no-undo .
     7949   define variable v-value                  as character no-undo .
     7950   define variable v-type                   as character no-undo .
     7951   define variable v-attr-value             as character no-undo .
     7952   define variable v-attr-value-rec         as character no-undo .
     7953   define variable v-attr-type              as character no-undo .
     7954   define buffer buf_recipe      for recipe.
     7955   define buffer buf_fbr-doc     for fbr-doc.
     7956   define buffer buf_doc-fbr-gds for doc-fbr-gds.
     7957   define buffer buf_goods       for goods.
     7958   define buffer buf_trn-doc     for trn-doc.
     7959   define buffer buf_sale-doc    for ub.sale-doc.
     7960   define buffer buf_obj_recipe  for recipe.
     7961   define variable v-ban-recipes as logical no-undo .
     7962   define variable v-ban-altr    as logical no-undo .
     7963   do
     7964      for buf_recipe
     7965      , buf_fbr-doc
     7966      , buf_doc-fbr-gds
     7967      , buf_goods
     7968      , buf_trn-doc
     7969      , buf_sale-doc
     7970      on error undo, return error
     7971      :
     7972   if session :set-wait-state( "compiler" ) then.
     7973      run get-db-num in parparentproc ( output v-cntxt-db-num).
     7974      run get-userid in parparentproc ( output v-cntxt-userid).
     7975      assign
     7976         v-doc-code     = entry( 1, p-parameters, chr(4) )
     7977         v-kitchen-rest = ( entry( 2, p-parameters, chr(4) ) = "yes" )
     7978         v-store-rest   = ( entry( 3, p-parameters, chr(4) ) = "yes" )
     7979         .
     7980      do transaction
     7981         on error undo, return error
     7982         :
     7983         find first buf_trn-doc no-lock
     7984            where buf_trn-doc.doc-code = v-doc-code
     7985            .
     7986         assign
     7987            v-store-type = buf_trn-doc.obj-type
     7988            v-store-code = buf_trn-doc.obj-code
     7989            .
     7990         assign
     7991            v-cntxt-obj-type = buf_trn-doc.obj-type
     7992            v-cntxt-obj-code = buf_trn-doc.obj-code
     7993            .
     7994   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7996     (input  v-store-type
     7997     ,input  v-store-code
     7998     ,output v-host-code
     7999     )  .
     8000         run gbl/conf-rd.p (
     8001            input "is-res"
     8002            , input v-host-code
     8003            , input v-store-type
     8004            , input v-store-code
     8005            , input ""
     8006            , input ""
     8007            , input ""
     8008            , input no
     8009            , output v-is-res
     8010            , output v-par-type
     8011            ) no-error.
     8012         if error-status :error
     8013            or v-is-res <> "yes"
     8014            then
     8015         do:
     8016            run write-log in p-log-handle (
     8017               input 0
     8018               , input substitute( "Не включен АРМ Ресторан.&1Невозможна автоматическая раскрутка товаров производства&1при закрытии продажи.&1&1Обратитесь к администратору."
     8019               , chr(10)
     8020               )
     8021               ).
     8022         end.
     8023         if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-store-type, v-store-code):IsBanRecipes then v-ban-recipes = true .
     8024         if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-store-type, v-store-code):IsBanAltr then v-ban-altr = true .
     8025         for each buf_sale-doc where
     8026            buf_sale-doc.inkas-code = v-doc-code
     8027            and buf_sale-doc.fbrsale = yes,
     8028            each buf_doc-fbr-gds no-lock
     8029            where buf_doc-fbr-gds.obj-type     = v-store-type
     8030            and buf_doc-fbr-gds.obj-code     = v-store-code
     8031            and buf_doc-fbr-gds.out-code     = buf_sale-doc.doc-code
     8032            on error undo, return error
     8033            :
     8034            find first temp_fbr-objects
     8035               where temp_fbr-objects.obj-type = buf_doc-fbr-gds.fbr-obj-type
     8036               and temp_fbr-objects.obj-code = buf_doc-fbr-gds.fbr-obj-code
     8037               no-error.
     8038            if not available temp_fbr-objects
     8039               then
     8040            do:
     8041               create temp_fbr-objects.
     8042               assign
     8043                  temp_fbr-objects.obj-type = buf_doc-fbr-gds.fbr-obj-type
     8044                  temp_fbr-objects.obj-code = buf_doc-fbr-gds.fbr-obj-code
     8045                  .
     8046            end.
     8047         end.
     8048         run write-log in p-log-handle (
     8049            input 1
     8050            , input substitute( "Ресторан &1 &2. Документ продажи '&3'."
     8051            , v-store-type
     8052            , v-store-code
     8053            , v-doc-code
     8054            )
     8055            ).
     8056         run writelog in this-procedure (
     8057            input log-file-name
     8058            , input 0
     8059            , input substitute( "Ресторан &1 &2. Документ продажи '&3'."
     8060            , v-store-type
     8061            , v-store-code
     8062            , v-doc-code
     8063            )
     8064            ).
     8065         if valid-handle ( p-fbrhist-handle )
     8066            then
     8067         do:
     8068            run fbrhist-set-zero-upper-code in p-fbrhist-handle.
     8069            run fbrhist-write in p-fbrhist-handle (
     8070               input v-cntxt-userid
     8071               , input v-store-type
     8072               , input v-store-code
     8073               , input 'запуск':U
     8074               , input 1
     8075               , input "str/fbrsale.p"
     8076               , input substitute( "parameters: &1", p-parameters )
     8077               , input v-doc-code
     8078               , input 'рес_автопроизводство':U
     8079               , input ""
     8080               , input no
     8081               , input ""
     8082               , input ""
     8083               , input 0
     8084               , input ""
     8085               , input 0
     8086               , input substitute( "Запуск автопроизводства по документу продажи '&3' на объекте &1 &2."
     8087               , v-store-type
     8088               , v-store-code
     8089               , v-doc-code
     8090               )
     8091               , input no
     8092               ).
     8093            run fbrhist-set-upper-code in p-fbrhist-handle.
     8094            run fbrhist-save-current-code in p-fbrhist-handle.
     8095         end.
     8096         for each temp_fbr-objects
     8097            on error undo, return error
     8098            :
     8099            run write-log in p-log-handle (
     8100               input 3
     8101               , input substitute( "Кухня &1 &2."
     8102               , temp_fbr-objects.obj-type
     8103               , temp_fbr-objects.obj-code
     8104               )
     8105               ).
     8106            run writelog in this-procedure (
     8107               input log-file-name
     8108               , input 0
     8109               , input substitute( "Кухня &1 &2."
     8110               , temp_fbr-objects.obj-type
     8111               , temp_fbr-objects.obj-code
     8112               )
     8113               ).
     8114            run fbrpln-create-fbr-doc in this-procedure (
     8115               input temp_fbr-objects.obj-type
     8116               , input temp_fbr-objects.obj-code
     8117               , input v-doc-code
     8118               , input ( v-cntxt-db-num <> 0 )
     8119               , input v-cntxt-userid
     8120               , output v-fbr-doc-code
     8121               ).
     8122            run write-log in p-log-handle (
     8123               input 5
     8124               , input substitute( "Создается документ производства '&1'..."
     8125               , v-fbr-doc-code
     8126               )
     8127               ).
     8128            run writelog in this-procedure (
     8129               input log-file-name
     8130               , input 0
     8131               , input substitute( "Создается документ производства '&1'..."
     8132               , v-fbr-doc-code
     8133               )
     8134               ).
     8135            run fbrattr-write in this-procedure (
     8136               input 'fbr-doc':U
     8137               , input v-fbr-doc-code
     8138               , input 'fbrauto':U
     8139               , input "yes":U
     8140               ) no-error.
     8141            if error-status :error
     8142               then
     8143            do:
     8144               v-mess = substitute("&1 &2 &3&4Не удалось установить атрибут для документа производства." +
     8145                  "Имя атрибута: &5:&4&6&4&7"
     8146                  ,vss-workfile
     8147                  ,vss-revision
     8148                  ,vss-description
     8149                  ,chr(10)
     8150                  ,'fbrauto':U
     8151                  , error-status:get-message(1)
     8152                  , return-value
     8153                  ).
     8154               run write-log in p-log-handle (
     8155                  input 5
     8156                  , input v-mess
     8157                  ).
     8158               run writelog in this-procedure (
     8159                  input log-file-name
     8160                  , input 0
     8161                  , input v-mess
     8162                  ).
     8163            end.
     8164            if valid-handle ( p-fbrhist-handle )
     8165               then
     8166            do:
     8167               run fbrhist-write in p-fbrhist-handle (
     8168                  input v-cntxt-userid
     8169                  , input temp_fbr-objects.obj-type
     8170                  , input temp_fbr-objects.obj-code
     8171                  , input 'соз_док':U
     8172                  , input 1
     8173                  , input "str/fbrsale.p"
     8174                  , input substitute( "parameters: &1", p-parameters )
     8175                  , input v-doc-code
     8176                  , input 'рес_автопроизводство':U
     8177                  , input 'новый':U
     8178                  , input no
     8179                  , input ""
     8180                  , input ""
     8181                  , input 0
     8182                  , input ""
     8183                  , input 0
     8184                  , input substitute( "Создан документ производства '&3' на объекте &1 &2."
     8185                  , temp_fbr-objects.obj-type
     8186                  , temp_fbr-objects.obj-code
     8187                  , v-fbr-doc-code
     8188                  )
     8189                  , input no
     8190                  ).
     8191               run fbrhist-set-upper-code in p-fbrhist-handle.
     8192            end.
     8193            create-by-recipe:
     8194            for each buf_sale-doc where
     8195               buf_sale-doc.inkas-code = v-doc-code
     8196               and buf_sale-doc.fbrsale = yes,
     8197               each buf_doc-fbr-gds no-lock
     8198               where buf_doc-fbr-gds.obj-type     = v-store-type
     8199               and buf_doc-fbr-gds.obj-code     = v-store-code
     8200               and buf_doc-fbr-gds.fbr-obj-type = temp_fbr-objects.obj-type
     8201               and buf_doc-fbr-gds.fbr-obj-code = temp_fbr-objects.obj-code
     8202               and buf_doc-fbr-gds.out-code     = buf_sale-doc.doc-code
     8203               on error undo, return error
     8204               :
     8205               if v-kitchen-rest = yes
     8206                  then
     8207               do:
     8208                  run fbrrest-get-free-qnty in this-procedure (
     8209                     input temp_fbr-objects.obj-type
     8210                     , input temp_fbr-objects.obj-code
     8211                     , input buf_doc-fbr-gds.gds-code
     8212                     , input no
     8213                     , output v-kitchen-free-qnty
     8214                     ).
     8215                  if  v-store-type = temp_fbr-objects.obj-type
     8216                     and v-store-code = temp_fbr-objects.obj-code
     8217                     then
     8218                  do:
     8219                     assign
     8220                        v-restaurant-free-qnty = 0
     8221                        .
     8222                  end.
     8223                  else
     8224                  do:
     8225                     run fbrrest-get-free-qnty in this-procedure (
     8226                        input v-store-type
     8227                        , input v-store-code
     8228                        , input buf_doc-fbr-gds.gds-code
     8229                        , input no
     8230                        , output v-restaurant-free-qnty
     8231                        ).
     8232                  end.
     8233               end.
     8234               else
     8235               do:
     8236                  assign
     8237                     v-kitchen-free-qnty    = 0
     8238                     v-restaurant-free-qnty = 0
     8239                     .
     8240               end.
     8241               assign
     8242                  v-need-qnty = buf_doc-fbr-gds.fact-qnty - v-kitchen-free-qnty - v-restaurant-free-qnty
     8243                  .
     8244               if v-need-qnty <= 0
     8245                  then
     8246               do:
     8247                  undo create-by-recipe, next create-by-recipe.
     8248               end.
     8249               find first buf_goods no-lock
     8250                  where buf_goods.gds-code = buf_doc-fbr-gds.gds-code
     8251                  .
     8252               run write-counter in p-log-handle (
     8253                  input substitute( "Приготовление блюда: &1 &2 ..."
     8254                  , buf_goods.artic
     8255                  , buf_goods.gds-name
     8256                  )
     8257                  ).
     8258               run select-recipe in this-procedure (
     8259                  input parparentproc
     8260                  , input temp_fbr-objects.obj-type
     8261                  , input temp_fbr-objects.obj-code
     8262                  , input buf_doc-fbr-gds.gds-code
     8263                  , input 'при':U
     8264                  , input v-need-qnty
     8265                  , input yes
     8266                  , input yes
     8267                  , output v-out-gds-code
     8268                  , output v-out-trn-type
     8269                  , output v-out-gds-qnty
     8270                  , output v-out-recipe-type
     8271                  , output v-out-recipe-code
     8272                  , output v-recipe-found
     8273                  , output v-no-need-good
     8274                  ).
     8275               if v-recipe-found = no
     8276                  or v-out-gds-code <> buf_doc-fbr-gds.gds-code
     8277                  or v-out-trn-type <> 'при':U
     8278                  then
     8279               do:
     8280                  v-mess = substitute("Не найден рецепт для производства товара&1" +
     8281                     "Код товара: &2"  +
     8282                     "Артикул: &3" +
     8283                     "Наименование: &4"
     8284                     , chr(10)
     8285                     , buf_doc-fbr-gds.gds-code
     8286                     , buf_goods.artic
     8287                     , buf_goods.gds-name).
     8288                  run write-log in p-log-handle (
     8289                     input 5
     8290                     , input v-mess
     8291                     ).
     8292                  run writelog in this-procedure (
     8293                     input log-file-name
     8294                     , input 0
     8295                     , input v-mess
     8296                     ).
     8297                  undo, return error .
     8298               end.
     8299               find first buf_recipe no-lock
     8300                  where buf_recipe.recipe-code = v-out-recipe-code
     8301                  .
     8302               if v-ban-altr or v-ban-recipes
     8303               then do:
     8304                  if buf_recipe.recipe-type = 'производство':U and v-ban-recipes then
     8305                  do:
     8306                     for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_recipe.recipe-code:
     8307                        run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     8308                           , input  'mark-type':U
     8309                           , output v-attr-value
     8310                           , output v-attr-type
     8311                           ) no-error .
     8312                        if v-attr-value <> "" and v-attr-value <> "not-type" then
     8313                        do:
     8314                           v-mess =  "Рецепт производства " + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + " содержит маркированный товар." .
     8315                           run write-log in p-log-handle (
     8316                              input 5
     8317                              , input v-mess
     8318                              ).
     8319                           run writelog in this-procedure (
     8320                              input log-file-name
     8321                              , input 0
     8322                              , input v-mess
     8323                              ).
     8324                           undo create-by-recipe, next create-by-recipe.
     8325                        end.
     8326                     end.
     8327                  end.
     8328                  if buf_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     8329                  do:
     8330                     for first buf_goods no-lock where buf_goods.gds-code = buf_recipe.gds-code,
     8331                        first ub.gds-grp exclusive-lock where ub.gds-grp.node-code = buf_goods.grp-code:
     8332                        run ggoattr-value (
     8333                           input   ub.gds-grp.node-code
     8334                           ,input   buf_recipe.host-code
     8335                           ,input   buf_recipe.obj-type
     8336                           ,input   buf_recipe.obj-code
     8337                           ,input   'ban-sales-via-cd':U
     8338                           ,output   v-value
     8339                           ,output   v-type
     8340                           ) no-error .
     8341                        if error-status :error then
     8342                        do:
     8343                           undo, return error.
     8344                        end.
     8345                        if v-value <> "yes" and v-value <> "true" then
     8346                        do:
     8347                           run ggoattr-value (
     8348                              input   ub.gds-grp.node-code
     8349                              ,input   0
     8350                              ,input   ""
     8351                              ,input   0
     8352                              ,input   'ban-sales-via-cd':U
     8353                              ,output   v-value
     8354                              ,output   v-type
     8355                              ) no-error .
     8356                           if error-status :error then
     8357                           do:
     8358                              undo, return error.
     8359                           end.
     8360                           if v-value <> "yes" and v-value <> "true" then
     8361                           do:
     8362                              v-mess =  "Рецепт альтернатива " + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу." .
     8363                              run write-log in p-log-handle (
     8364                                 input 5
     8365                                 , input v-mess
     8366                                 ).
     8367                              run writelog in this-procedure (
     8368                                 input log-file-name
     8369                                 , input 0
     8370                                 , input v-mess
     8371                                 ).
     8372                              undo create-by-recipe, next create-by-recipe.
     8373                           end.
     8374                        end.
     8375                     end.
     8376                  end.
     8377                  if buf_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     8378                  do:
     8379                     for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_recipe.recipe-code:
     8380                        run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     8381                           , input  'mark-type':U
     8382                           , output v-attr-value
     8383                           , output v-attr-type
     8384                           ) no-error .
     8385                        if v-attr-value <> "" and v-attr-value <> "not-type" then
     8386                        do:
     8387                           run gds-attr-value in this-procedure  ( input  buf_recipe.gds-code
     8388                              , input  'mark-type':U
     8389                              , output v-attr-value-rec
     8390                              , output v-attr-type
     8391                              ) no-error .
     8392                           if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     8393                           do:
     8394                              v-mess =   "Рецепт комплектации " + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + " должен быть маркированным." .
     8395                              run write-log in p-log-handle (
     8396                                 input 5
     8397                                 , input v-mess
     8398                                 ).
     8399                              run writelog in this-procedure (
     8400                                 input log-file-name
     8401                                 , input 0
     8402                                 , input v-mess
     8403                                 ).
     8404                              undo create-by-recipe, next create-by-recipe.
     8405                           end.
     8406                           else leave.
     8407                        end.
     8408                     end.
     8409                  end.
     8410               end.
     8411               run create-initial-temp-goods in this-procedure (
     8412                  input v-fbr-doc-code
     8413                  , input buf_goods.artic
     8414                  , input buf_goods.prod-type
     8415                  , input buf_goods.prod-code
     8416                  , input 'при':U
     8417                  , input v-out-recipe-type
     8418                  , input v-out-recipe-code
     8419                  , input v-need-qnty
     8420                  , output v-same-good
     8421                  , output v-same-good-old-qnty
     8422                  ).
     8423               run calc-not-calculated-goods in this-procedure (
     8424                  input parparentproc
     8425                  , input p-fbrhist-handle
     8426                  , input v-fbr-doc-code
     8427                  , input v-same-good
     8428                  , input v-same-good-old-qnty
     8429                  , input no
     8430                  , input yes
     8431                  , input temp_fbr-objects.obj-type
     8432                  , input temp_fbr-objects.obj-code
     8433                  , input yes
     8434                  , input yes
     8435                  ).
     8436               if valid-handle ( p-fbrhist-handle )
     8437                  then
     8438               do:
     8439                  run fbrhist-write in p-fbrhist-handle (
     8440                     input v-cntxt-userid
     8441                     , input temp_fbr-objects.obj-type
     8442                     , input temp_fbr-objects.obj-code
     8443                     , input 'соз_стр':U
     8444                     , input 2
     8445                     , input "str/fbrsale.p"
     8446                     , input substitute( "parameters: &1", p-parameters )
     8447                     , input v-doc-code
     8448                     , input 'рес_автопроизводство':U
     8449                     , input 'новый':U
     8450                     , input no
     8451                     , input v-out-recipe-code
     8452                     , input v-out-recipe-type
     8453                     , input buf_goods.gds-code
     8454                     , input 'при':U
     8455                     , input v-need-qnty
     8456                     , input substitute( "Создана строка документа производства для товара '&1 &2' с количеством &3"
     8457                     , buf_goods.artic
     8458                     , buf_goods.gds-name
     8459                     , v-need-qnty
     8460                     )
     8461                     , input no
     8462                     ).
     8463               end.
     8464            end.
     8465            run check-fbr-doc in this-procedure (
     8466               input v-fbr-doc-code
     8467               , output v-fbr-doc-is-not-empty
     8468               ).
     8469            run write-counter in p-log-handle (
     8470               input ""
     8471               ).
     8472            if v-fbr-doc-is-not-empty = yes
     8473               then
     8474            do:
     8475               run write-log in p-log-handle (
     8476                  input 5
     8477                  , input substitute( "Создан документ производства '&1'. Идет резервирование товаров..."
     8478                  , v-fbr-doc-code
     8479                  )
     8480                  ).
     8481               find first buf_fbr-doc no-lock
     8482                  where buf_fbr-doc.doc-code = v-fbr-doc-code
     8483                  .
     8484               run str/fbr-rsrv.p (
     8485                  input parparentproc
     8486                  , input p-fbrhist-handle
     8487                  , input recid( buf_fbr-doc )
     8488                  , input yes
     8489                  , input yes
     8490                  , input yes
     8491                  , input v-store-rest
     8492                  , output v-reserved
     8493                  ) no-error.
     8494               if error-status :error
     8495                  or v-reserved = no
     8496                  then
     8497               do:
     8498                  define variable v-user-action as character no-undo .
     8499                  define variable v-printed     as logical   no-undo .
     8500                  if search ('fbr-rsrv-errors-tt.txt') <> ? then
     8501                  do:
     8502                     input stream stm from value('fbr-rsrv-errors-tt.txt').
     8503                     repeat .
     8504                        create tt-rsrv-err.
     8505                        import stream stm tt-rsrv-err no-error.
     8506                        if error-status:error
     8507                           then delete tt-rsrv-err.
     8508                     END.
     8509                     output stream stm to value (v-fbr-tt-log-file-name).
     8510                     for each tt-rsrv-err no-lock break by tt-rsrv-err.artic:
     8511                        if last-of (tt-rsrv-err.artic) and tt-rsrv-err.artic <> "" then
     8512                        do:
     8513                           put stream stm unformatted substitute("Ошибка при резервировании товара артикул &1 &5: требуемое кол-во &2 зарезервировано &3&4"
     8514                              , tt-rsrv-err.artic
     8515                              , tt-rsrv-err.req-qnty
     8516                              , tt-rsrv-err.rsrv-qnty
     8517                              , chr(10)
     8518                              , tt-rsrv-err.gds-name
     8519                              ).
     8520                        end.
     8521                     end.
     8522                     output stream stm close.
     8523                     if search ('fbr-rsrv-errors-tt.txt') <> ? then
     8524                     do:
     8525                        run gbl/prnfilen.w (
     8526                           input "Список не зарезервированных товаров при автопроизводстве":U
     8527                           , input 8
     8528                           , input search('fbr-rsrv-errors-tt.txt')
     8529                           , input 7
     8530                           , output v-user-action
     8531                           , output v-printed
     8532                           ).
