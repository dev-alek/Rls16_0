        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: 66c80260f80d, 2644, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        4   define variable vss-date        as character no-undo initial "$Date: 2020/10/23 18:03:38 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: pstlnadd.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: str/pstlnadd.p $":U .
        7   define variable vss-description as character no-undo initial "Добавление связки пересортицы":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define temp-table tt-gds-dtl no-undo
       73   field gds-code like ub.goods.gds-code
       74   field prt-code like ub.gds-dtl.prt-code
       75   field qnty     as   decimal
       76   index pi is unique primary gds-code prt-code.
       77   define temp-table tt-gds-dtl-plus no-undo
       78   field gds-code like ub.goods.gds-code
       79   field prt-code like ub.gds-dtl.prt-code
       80   field qnty     as   decimal
       81   index pi is unique primary gds-code prt-code.
       82   define temp-table tt-pl-qty no-undo
       83   field pl-code like ub.place.pl-code
       84   field qnty-l  as   decimal
       85   field qnty-kg as   decimal
       86   index pi is unique primary pl-code.
       87   define temp-table tt-pl-qty-plus no-undo
       88   field pl-code like ub.place.pl-code
       89   field qnty-l  as   decimal
       90   field rsrv-l  as   decimal
       91   field qnty-kg as   decimal
       92   index pi is unique primary pl-code.
       93   define input  parameter parparentproc      as   handle              no-undo.
       94   define input  parameter parcallback        as   handle              no-undo.
       95   define input  parameter pardoc-code        like ub.trn-doc.doc-code no-undo.
       96   define input  parameter parold-supp-cntr   as   logical             no-undo.
       97   define input  parameter parpstunqtn-log    as   logical             no-undo.
       98   define input  parameter parmxpcicp-dec     as   decimal             no-undo.
       99   define input  parameter parmxpcdcp-dec     as   decimal             no-undo.
      100   define input  parameter parmxsmicp-dec     as   decimal             no-undo.
      101   define input  parameter parmxsmdcp-dec     as   decimal             no-undo.
      102   define input  parameter pargrp-is-eq       as   logical             no-undo.
      103   define input  parameter parpstunit         as   logical             no-undo.
      104   define output parameter parrec-minus-line  as   recid               no-undo.
      105   define output parameter parrec-plus-line   as   recid               no-undo.
      106   define output parameter paradd             as   logical initial no  no-undo.
      107   define variable varoutgds-code           like ub.goods.gds-code  no-undo.
      108   define variable varoutgds-code-plus      like ub.goods.gds-code  no-undo.
      109   define variable varoutqnty               as   decimal            no-undo.
      110   define variable varoutqnty-plus          as   decimal            no-undo.
      111   define variable varoutqnty-kg            as   decimal            no-undo.
      112   define variable varoutqnty-kg-plus       as   decimal            no-undo.
      113   define variable varset                   as   logical            no-undo.
      114   define variable varvat-pc                as   decimal            no-undo.
      115   define variable varvat-pc-plus           as   decimal            no-undo.
      116   define variable vartax-date              as   date               no-undo.
      117   define variable varmem-qnty              as   decimal            no-undo.
      118   define variable varchg-qnty              as   decimal            no-undo.
      119   define variable varqnty-check            as   decimal            no-undo.
      120   define variable varqnty-check-plus       as   decimal            no-undo.
      121   define variable varqnty-check-pl         as   decimal            no-undo.
      122   define variable varqnty-check-pl-plus    as   decimal            no-undo.
      123   define variable varqnty-check-pl-kg      as   decimal            no-undo.
      124   define variable varqnty-check-pl-kg-plus as   decimal            no-undo.
      125   define variable varkoeff                 as   decimal            no-undo.
      126   define variable varpart-code             as   character          no-undo.
      127   define variable varlog                   as   logical            no-undo.
      128   define variable varinv-on                as   logical            no-undo.
      129   define variable varshift-on              as   logical            no-undo.
      130   define variable varfact-order            as   decimal            no-undo.
      131   define variable varshift-fo              as   decimal            no-undo.
      132   define variable varday-fo                as   decimal            no-undo.
      133   define variable varis-petrol             as   logical            no-undo.
      134   define variable varis-pieces             as   logical            no-undo.
      135   define variable varis-petrol-plus        as   logical            no-undo.
      136   define variable varis-pieces-plus        as   logical            no-undo.
      137   define variable varrsrv-plus-parts       as   logical            no-undo.
      138   define variable varunrsrv-qnty-pl        as   decimal            no-undo.
      139   define variable varcrparts-qnty          as   decimal            no-undo.
      140   define variable vardensity-reserv        as   decimal            no-undo.
      141   define variable varcli-base-rate-reserv  as   decimal            no-undo.
      142   define variable varprice-reserv          as   decimal            no-undo.
      143   define variable varcorrect               as   logical            no-undo.
      144   define variable varqnty-pieces           as   decimal            no-undo.
      145   define variable varpices-varkoeff        as   decimal            no-undo.
      146   define variable vartotal-rsrv-qnty-parts   like ub.parts.fact-qnty  no-undo.
      147   define variable vartotal-rsrv-qnty-gds-dtl like ub.gds-dtl.doc-qnty no-undo.
      148   define variable varbefore-qnty             like ub.gds-dtl.doc-qnty no-undo.
      149   define buffer bf_trn-doc           for ub.trn-doc.
      150   define buffer bf-add_goods         for ub.goods.
      151   define buffer bf-add-plus_goods    for ub.goods.
      152   define buffer bf-add_doc-line      for ub.doc-line.
      153   define buffer bf-add_inv-line      for ub.inv-line.
      154   define buffer bf-add-plus_doc-line for ub.doc-line.
      155   define buffer bf-add-plus_inv-line for ub.inv-line.
      156   define buffer bf-add_parts-root    for ub.parts-root.
      157   define buffer bf-add-cr_parts-root for ub.parts-root.
      158   define buffer bf-add_parts         for ub.parts.
      159   define buffer bf-add-plus_parts    for ub.parts.
      160   define buffer bf-add_gds-dtl       for ub.gds-dtl.
      161   define buffer bf-add-plus_gds-dtl  for ub.gds-dtl.
      162   define buffer bf-inv_doc-line      for ub.doc-line.
      163   define buffer bf_sysconf           for ub.sysconf.
      164   define buffer bf-add_doc-pl        for ub.doc-pl.
      165   define buffer bf-add-plus_doc-pl   for ub.doc-pl.
      166   define buffer bf_parts-root        for ub.parts-root.
      167   define temp-table tt-parts       no-undo like ub.parts.
      168   do on error undo, return error return-value :
      169   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
      170   find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
      171   for each tt-gds-dtl on error undo, return error return-value :
      172     delete tt-gds-dtl.
      173   end.
      174   for each tt-pl-qty on error undo, return error return-value :
      175     delete tt-pl-qty.
      176   end.
      177   for each tt-gds-dtl-plus on error undo, return error return-value :
      178     delete tt-gds-dtl-plus.
      179   end.
      180   for each tt-pl-qty-plus on error undo, return error return-value :
      181     delete tt-pl-qty-plus.
      182   end.
      183   run str/prst-gds.w (input  parparentproc,
      184                   input  bf_trn-doc.doc-code,
      185                   input  'ДОБАВЛЕНИЕ':U,
      186                   input  bf_trn-doc.obj-type,
      187                   input  bf_trn-doc.obj-code,
      188                   input  ?,
      189                   input  ?,
      190                   input  ?,
      191                   input  ?,
      192                   input  ?,
      193                   input  ?,
      194                   input  parpstunqtn-log,
      195                   input  parpstunit,
      196                   input  parmxpcicp-dec,
      197                   input  parmxpcdcp-dec,
      198                   input  parmxsmicp-dec,
      199                   input  parmxsmdcp-dec,
      200                   output varoutgds-code,
      201                   output varoutgds-code-plus,
      202                   output table tt-gds-dtl,
      203                   output table tt-pl-qty,
      204                   output varoutqnty,
      205                   output varoutqnty-plus,
      206                   output varoutqnty-kg,
      207                   output varoutqnty-kg-plus,
      208                   output table tt-gds-dtl-plus,
      209                   output table tt-pl-qty-plus,
      210                   output varset) no-error.
      211   if varset = yes then do transaction on error undo, return error return-value :
      212     assign
      213       paradd = yes.
      214     find first bf-add_goods where bf-add_goods.gds-code = varoutgds-code no-lock no-error.
      215     if not available bf-add_goods then do:
      216       undo, return error substitute ("Не найден товар для списания с внутренним кодом: &1.", varoutgds-code).
      217     end.
      218     find first bf-add-plus_goods where bf-add-plus_goods.gds-code = varoutgds-code-plus no-lock no-error.
      219     if not available bf-add-plus_goods then do:
      220       undo, return error substitute ("Не найден товар для оприходования с внутренним кодом: &1.", varoutgds-code).
      221     end.
      222     if bf-add_goods.grp-code <> bf-add-plus_goods.grp-code and pargrp-is-eq then
      223       undo, return error "Включен параметр pstgrp(Запрещена пересортица товаров из разных групп) из секции настроек ИНВЕНТАРИЗАЦИИ. Товары можно добавлять только из одной группы".
      224     if not (varoutqnty > 0)  then do:
      225       undo, return error substitute ("Неверно задано количество по списываемому товару: &1.", varoutqnty).
      226     end.
      227     if not (varoutqnty-plus > 0)  then do:
      228       undo, return error substitute ("Неверно задано количество по оприходуемому товару: &1.", varoutqnty-plus).
      229     end.
      230   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      231     (
      232        input bf-add_goods.artic
      233     ,  input bf-add_goods.prod-type
      234     ,  input bf-add_goods.prod-code
      235     , output varis-petrol
      236     , output varis-pieces
      237     ) .
      238   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      239     (
      240        input bf-add-plus_goods.artic
      241     ,  input bf-add-plus_goods.prod-type
      242     ,  input bf-add-plus_goods.prod-code
      243     , output varis-petrol-plus
      244     , output varis-pieces-plus
      245     ) .
      246     if varis-petrol     and
      247        not varis-pieces then do:
      248       if not (varoutqnty-kg > 0)  then do:
      249         undo, return error substitute ("Неверно задано количество по списываемому товару в килограммах: &1.", varoutqnty-kg).
      250       end.
      251     end.
      252     if varis-petrol-plus     and
      253        not varis-pieces-plus then do:
      254       if not (varoutqnty-kg-plus > 0)  then do:
      255         undo, return error substitute ("Неверно задано количество по оприходуемому товару в килограммах: &1.", varoutqnty-kg-plus).
      256       end.
      257     end.
      258     assign
      259       varqnty-check            = 0.00
      260       varqnty-check-plus       = 0.00
      261       varqnty-check-pl         = 0.00
      262       varqnty-check-pl-plus    = 0.00
      263       varqnty-check-pl-kg      = 0.00
      264       varqnty-check-pl-kg-plus = 0.00
      265       .
      266     for each tt-gds-dtl on error undo, return error return-value :
      267       if tt-gds-dtl.gds-code <> bf-add_goods.gds-code then do:
      268         undo, return error substitute ("Критическая ошибка. В признаках для списания товара указан товар с внутренним кодом: &1. Товар для списания с внутренним кодом: &2", tt-gds-dtl.gds-code, bf-add_goods.gds-code).
      269       end.
      270       assign
      271         varqnty-check = varqnty-check + tt-gds-dtl.qnty.
      272     end.
      273     for each tt-gds-dtl-plus on error undo, return error return-value :
      274       if tt-gds-dtl-plus.gds-code <> bf-add-plus_goods.gds-code then do:
      275         undo, return error substitute ("Критическая ошибка. В признаках для оприходования товара указан товар с внутренним кодом: &1. Товар для оприходования с внутренним кодом: &2.", tt-gds-dtl-plus.gds-code, bf-add-plus_goods.gds-code).
      276       end.
      277       assign
      278         varqnty-check-plus = varqnty-check-plus + tt-gds-dtl-plus.qnty.
      279     end.
      280     if varoutqnty <> varqnty-check then do:
      281       undo, return error substitute ("Ошибка в количестве по списываемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по признакам: &6.", bf-add_goods.artic, bf-add_goods.prod-type, bf-add_goods.prod-code, bf-add_goods.gds-name, varoutqnty, varqnty-check) .
      282     end.
      283     if varoutqnty-plus <> varqnty-check-plus then do:
      284       undo, return error substitute("Ошибка в количестве по оприходоваемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по признакам: &6.", bf-add-plus_goods.artic, bf-add-plus_goods.prod-type, bf-add-plus_goods.prod-code, bf-add-plus_goods.gds-name, varoutqnty-plus, varqnty-check-plus).
      285     end.
      286     if varis-petrol     and
      287        not varis-pieces then do:
      288       for each tt-pl-qty on error undo, return error return-value :
      289         assign
      290           varqnty-check-pl    = varqnty-check-pl    + tt-pl-qty.qnty-l
      291           varqnty-check-pl-kg = varqnty-check-pl-kg + tt-pl-qty.qnty-kg.
      292       end.
      293       if varoutqnty <> varqnty-check-pl then do:
      294         undo, return error substitute ("Ошибка в количестве по списываемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по резервуарам: &6.", bf-add_goods.artic, bf-add_goods.prod-type, bf-add_goods.prod-code, bf-add_goods.gds-name, varoutqnty, varqnty-check-pl) .
      295       end.
      296       if varoutqnty-kg <> varqnty-check-pl-kg then do:
      297         undo, return error substitute ("Ошибка в количестве в кг по списываемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по резервуарам: &6.", bf-add_goods.artic, bf-add_goods.prod-type, bf-add_goods.prod-code, bf-add_goods.gds-name, varoutqnty-kg, varqnty-check-pl-kg) .
      298       end.
      299     end.
      300     if varis-petrol-plus     and
      301        not varis-pieces-plus then do:
      302       for each tt-pl-qty-plus on error undo, return error return-value :
      303         assign
      304           varqnty-check-pl-plus    = varqnty-check-pl-plus    + tt-pl-qty-plus.qnty-l
      305           varqnty-check-pl-kg-plus = varqnty-check-pl-kg-plus + tt-pl-qty-plus.qnty-kg.
      306       end.
      307       if varoutqnty-plus <> varqnty-check-pl-plus then do:
      308         undo, return error substitute("Ошибка в количестве по оприходоваемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по резервуарам: &6.", bf-add-plus_goods.artic, bf-add-plus_goods.prod-type, bf-add-plus_goods.prod-code, bf-add-plus_goods.gds-name, varoutqnty-plus, varqnty-check-pl-plus).
      309       end.
      310       if varoutqnty-kg-plus <> varqnty-check-pl-kg-plus then do:
      311         undo, return error substitute("Ошибка в количестве в кг по оприходоваемому товару: &1 &2 &3 &4. Задано количество по товару: &5. Задано количество по резервуарам: &6.", bf-add-plus_goods.artic, bf-add-plus_goods.prod-type, bf-add-plus_goods.prod-code, bf-add-plus_goods.gds-name, varoutqnty-kg-plus, varqnty-check-pl-kg-plus).
      312       end.
      313     end.
      314     assign
      315       varkoeff = varoutqnty-plus / varoutqnty.
      316     find first bf-add_parts-root where bf-add_parts-root.doc-code      = bf_trn-doc.doc-code        and
      317                                        bf-add_parts-root.orig-gds-code = bf-add-plus_goods.gds-code and
      318                                        bf-add_parts-root.gds-code      = bf-add_goods.gds-code      use-index pi no-error.
      319     if available bf-add_parts-root then do:
      320       return error substitute ("Для списания выбран товар: &1 &2 &3 &4. Для оприходывания выбран товар: &5 &6 &7 &8. Но уже есть связка когда списываемый товар оприходуется, а оприходуемый списывается. Это недопустимо.", bf-add_goods.artic, bf-add_goods.prod-type, bf-add_goods.prod-code, bf-add_goods.gds-name, bf-add-plus_goods.artic, bf-add-plus_goods.prod-type, bf-add-plus_goods.prod-code, bf-add-plus_goods.gds-name ).
      321     end.
      322     find first bf-add_parts-root where bf-add_parts-root.doc-code      = bf_trn-doc.doc-code        and
      323                                        bf-add_parts-root.orig-gds-code = bf-add_goods.gds-code      and
      324                                        bf-add_parts-root.gds-code      = bf-add-plus_goods.gds-code use-index pi no-error.
      325     if available bf-add_parts-root then do:
      326       assign
      327         varlog = no.
      328       message "В документе уже есть связка по пересортице выбранных товаров." skip
      329               "Вы хотите добавить к существующей пересортице установленные количества?"
      330        view-as alert-box question buttons yes-no update varlog.
      331       if varlog <> yes then do:
      332         return error.
      333       end.
