      869             else do:
      870               assign
      871                 tt-pl-qty-plus.rsrv-l = tt-pl-qty-plus.qnty-l
      872                 varunrsrv-qnty-pl     = varunrsrv-qnty-pl - (tt-pl-qty-plus.qnty-l - tt-pl-qty-plus.rsrv-l) .
      873               assign
      874                 varcrparts-qnty = (tt-pl-qty-plus.qnty-l - tt-pl-qty-plus.rsrv-l).
      875               run local-create-parts in this-procedure
      876               (varcrparts-qnty,
      877                vardensity-reserv * varcrparts-qnty,
      878                varprice-reserv,
      879                varcli-base-rate-reserv,
      880                varcrparts-qnty / varkoeff,
      881                tt-pl-qty-plus.pl-code,
      882                (if parold-supp-cntr then bf-add_parts.supp-type     else bf_trn-doc.cli-type),
      883                (if parold-supp-cntr then bf-add_parts.supp-code     else bf_trn-doc.cli-code),
      884                (if parold-supp-cntr then bf-add_parts.contract-code else bf_trn-doc.contract-code)) no-error.
      885               if error-status :error then do:
      886                 undo, return error substitute ("Ошибка при создании партии: &1", return-value).
      887               end.
      888             end.
      889           end.
      890           if varrsrv-plus-parts = no then do:
      891             undo, return error "Не удалось зарезервировать оприходованное количество в разрезе складских мест".
      892           end.
      893         end.
      894         else if not varis-pieces-plus then do:
      895           run local-create-parts in this-procedure
      896           ((if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty) * varkoeff else - bf-add_parts.fact-qnty * varkoeff),
      897            (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty) * varkoeff else - bf-add_parts.fact-qnty * varkoeff),
      898            (bf-add_parts.price-rubl - bf-add_parts.road-tax-rubl - bf-add_parts.transport-rubl - bf-add_parts.other-rubl )/ varkoeff,
      899            1,
      900            (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty)  else - bf-add_parts.fact-qnty),
      901            0,
      902            (if parold-supp-cntr then bf-add_parts.supp-type     else bf_trn-doc.cli-type),
      903            (if parold-supp-cntr then bf-add_parts.supp-code     else bf_trn-doc.cli-code),
      904            (if parold-supp-cntr then bf-add_parts.contract-code else bf_trn-doc.contract-code)
      905            )
      906           no-error.
      907           if error-status :error then do:
      908             undo, return error substitute ("Ошибка при создании партии: &1", return-value).
      909           end.
      910         end.
      911         else do:
      912           if varoutqnty = (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty) else - bf-add_parts.fact-qnty) then varqnty-pieces = varoutqnty-plus.
      913           else  varqnty-pieces = max(1,(if available tt-parts then - truncate((bf-add_parts.fact-qnty - tt-parts.fact-qnty) * varpices-varkoeff, 0) else - truncate(bf-add_parts.fact-qnty * varpices-varkoeff, 0))).
      914           run local-create-parts in this-procedure
      915           (
      916            varqnty-pieces,
      917            varqnty-pieces,
      918            ((bf-add_parts.price-rubl - bf-add_parts.road-tax-rubl - bf-add_parts.transport-rubl - bf-add_parts.other-rubl ) / (varqnty-pieces / (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty) else - bf-add_parts.fact-qnty) )),
      919            1,
      920            (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty)  else - bf-add_parts.fact-qnty),
      921            0,
      922            (if parold-supp-cntr then bf-add_parts.supp-type     else bf_trn-doc.cli-type),
      923            (if parold-supp-cntr then bf-add_parts.supp-code     else bf_trn-doc.cli-code),
      924            (if parold-supp-cntr then bf-add_parts.contract-code else bf_trn-doc.contract-code)
      925            )
      926           no-error.
      927           if error-status :error then do:
      928             undo, return error substitute ("Ошибка при создании партии: &1", return-value).
      929           end.
      930           varoutqnty-plus = varoutqnty-plus - varqnty-pieces.
      931           varoutqnty = varoutqnty - (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty)  else - bf-add_parts.fact-qnty).
      932           varpices-varkoeff = varoutqnty-plus / varoutqnty.
      933         end.
      934       end.
      935     end.
      936     if vartotal-rsrv-qnty-parts <> vartotal-rsrv-qnty-gds-dtl then do:
      937       if abs (vartotal-rsrv-qnty-parts - vartotal-rsrv-qnty-gds-dtl) > 0.01 then do:
      938          message "Невозможно зарезервировать данную связку товаров при установленных количествах." skip
      939                  "Зарезервированное количество по партиям:   " vartotal-rsrv-qnty-parts skip
      940                  "Зарезервированное количество по признакам: " vartotal-rsrv-qnty-gds-dtl
      941          view-as alert-box.
      942          return error.
      943       end.
      944       assign
      945         varcorrect = no.
      946       for each bf_parts-root where bf_parts-root.doc-code      = bf_trn-doc.doc-code        and
      947                                    bf_parts-root.orig-gds-code = bf-add_goods.gds-code      and
      948                                    bf_parts-root.gds-code      = bf-add-plus_goods.gds-code,
      949         first bf-add-plus_parts where bf-add-plus_parts.out-code   = bf_trn-doc.doc-code         and
      950                                       bf-add-plus_parts.obj-type   = bf_trn-doc.obj-type         and
      951                                       bf-add-plus_parts.obj-code   = bf_trn-doc.obj-code         and
      952                                       bf-add-plus_parts.artic      = bf-add-plus_goods.artic     and
      953                                       bf-add-plus_parts.prod-type  = bf-add-plus_goods.prod-type and
      954                                       bf-add-plus_parts.prod-code  = bf-add-plus_goods.prod-code and
      955                                       bf-add-plus_parts.in-code    = bf_parts-root.in-code       and
      956                                       bf-add-plus_parts.part-code  = bf_parts-root.part-code     and
      957                                       bf-add-plus_parts.fact-qnty  > 0                           and
      958                                       bf-add-plus_parts.fact-qnty  > vartotal-rsrv-qnty-parts - vartotal-rsrv-qnty-gds-dtl :
      959         assign
      960           bf-add-plus_parts.fact-qnty = bf-add-plus_parts.fact-qnty - (vartotal-rsrv-qnty-parts - vartotal-rsrv-qnty-gds-dtl)
      961           varcorrect = yes.
      962         leave.
      963       end.
      964       if varcorrect = no then do:
      965          message "Невозможно зарезервировать данную связку товаров при установленных количествах." skip
      966          view-as alert-box.
      967          return error.
      968       end.
      969     end.
      970     run local-recalc in parcallback (input "update":u,
      971                                      input recid(bf-add-plus_doc-line),
      972                                      input no) no-error.
      973     if error-status:error then do:
      974       undo, return error substitute ("Ошибка при пересчете строки документа: ", return-value).
      975     end.
      976   end.
      977   end.
      978   procedure local-create-parts:
      979   define input parameter parqnty          as decimal   no-undo.
      980   define input parameter parcli-qnty      as decimal   no-undo.
      981   define input parameter parprice-cli     as decimal   no-undo.
      982   define input parameter parcli-base-rate as decimal   no-undo.
      983   define input parameter parreal-qnty     as decimal   no-undo.
      984   define input parameter parpl-code       as integer   no-undo.
      985   define input parameter parsupp-type     as character no-undo.
      986   define input parameter parsupp-code     as integer   no-undo.
      987   define input parameter parcontract-code as integer   no-undo.
      988   define buffer bf-add-plus_parts    for ub.parts.
      989   define variable new-qnty as decimal no-undo.
      990   define variable Loc-cr-varkoeff  as decimal no-undo.
      991   define variable new-cli-qnty as decimal no-undo.
      992   do on error undo, return error return-value :
      993     run holdprts-get-part-code in parcallback ( input bf_trn-doc.doc-code
      994                                                ,output varpart-code
      995                                               ) no-error .
      996     if error-status:error then do:
      997       undo, return error substitute ("Ошибка при получении кода партии: &1", return-value).
      998     end.
      999     Loc-cr-varkoeff = varkoeff.
     1000     if varis-pieces-plus then do:
     1001        Loc-cr-varkoeff =  parqnty / parreal-qnty.
     1002     end.
     1003     create bf-add-plus_parts.
     1004     assign
     1005       bf-add-plus_parts.prod-type      = bf-add-plus_goods.prod-type
     1006       bf-add-plus_parts.prod-code      = bf-add-plus_goods.prod-code
     1007       bf-add-plus_parts.artic          = bf-add-plus_goods.artic
     1008       bf-add-plus_parts.in-code        = bf_trn-doc.doc-code
     1009       bf-add-plus_parts.out-code       = bf_trn-doc.doc-code
     1010       bf-add-plus_parts.price-base     = bf-add_parts.price-base / Loc-cr-varkoeff
     1011       bf-add-plus_parts.price-rubl     = bf-add_parts.price-rubl / Loc-cr-varkoeff
     1012       bf-add-plus_parts.obj-type       = bf_trn-doc.obj-type
     1013       bf-add-plus_parts.obj-code       = bf_trn-doc.obj-code
     1014       bf-add-plus_parts.VAT-pc         = bf-add_parts.vat-pc
     1015       bf-add-plus_parts.part-code      = varpart-code
     1016       bf-add-plus_parts.PS             = bf-add_parts.PS
     1017       bf-add-plus_parts.pay-code       = bf-add_parts.pay-code
     1018       bf-add-plus_parts.status_        = no
     1019       bf-add-plus_parts.supp-type      = parsupp-type
     1020       bf-add-plus_parts.supp-code      = parsupp-code
     1021       bf-add-plus_parts.rsrv-free      = ?
     1022       bf-add-plus_parts.doc-type       = bf_trn-doc.doc-type
     1023       bf-add-plus_parts.pl-code        = 0
     1024       bf-add-plus_parts.VAT-type       = bf-add_parts.vat-type
     1025       bf-add-plus_parts.exch-code      = 0
     1026       bf-add-plus_parts.SLT-pc         = bf-add_parts.slt-pc
     1027       bf-add-plus_parts.host-code      = bf_trn-doc.host-code
     1028       bf-add-plus_parts.is-supp        = yes
     1029       bf-add-plus_parts.SLT-type       = bf-add_parts.slt-type
     1030       bf-add-plus_parts.cst-code       = "":u
     1031       bf-add-plus_parts.last-date      = ?
     1032       bf-add-plus_parts.road-tax-base  = bf-add_parts.road-tax-base  / Loc-cr-varkoeff
     1033       bf-add-plus_parts.road-tax-rubl  = bf-add_parts.road-tax-rubl  / Loc-cr-varkoeff
     1034       bf-add-plus_parts.transport-base = bf-add_parts.transport-base / Loc-cr-varkoeff
     1035       bf-add-plus_parts.transport-rubl = bf-add_parts.transport-rubl / Loc-cr-varkoeff
     1036       bf-add-plus_parts.other-base     = bf-add_parts.other-base     / Loc-cr-varkoeff
     1037       bf-add-plus_parts.other-rubl     = bf-add_parts.other-rubl     / Loc-cr-varkoeff
     1038       bf-add-plus_parts.purch-code     = bf-add_parts.purch-code
     1039       bf-add-plus_parts.contract-code  = parcontract-code
     1040       bf-add-plus_parts.qnty           = parqnty
     1041       bf-add-plus_parts.cli-qnty       = parcli-qnty
     1042       bf-add-plus_parts.price-cli      = parprice-cli
     1043       bf-add-plus_parts.cli-base-rate  = parcli-base-rate
     1044       bf-add-plus_parts.real-qnty      = parreal-qnty
     1045       bf-add-plus_parts.fact-qnty      = bf-add-plus_parts.qnty
     1046       bf-add-plus_parts.pl-code        = parpl-code
     1047     .
     1048     if bf-add-plus_parts.supp-type = bf-add-plus_parts.obj-type and
     1049        bf-add-plus_parts.supp-code = bf-add-plus_parts.obj-code then do:
     1050       assign
     1051         bf-add-plus_parts.is-supp = no.
     1052     end.
     1053     assign
     1054       vartotal-rsrv-qnty-parts = vartotal-rsrv-qnty-parts + bf-add-plus_parts.fact-qnty.
     1055     create bf-add-cr_parts-root.
     1056     assign
     1057       bf-add-cr_parts-root.doc-code       = bf-add_parts.out-code
     1058       bf-add-cr_parts-root.orig-in-code   = bf-add_parts.in-code
     1059       bf-add-cr_parts-root.orig-gds-code  = bf-add_goods.gds-code
     1060       bf-add-cr_parts-root.orig-part-code = bf-add_parts.part-code
     1061       bf-add-cr_parts-root.in-code        = bf-add-plus_parts.in-code
     1062       bf-add-cr_parts-root.gds-code       = bf-add-plus_goods.gds-code
     1063       bf-add-cr_parts-root.part-code      = bf-add-plus_parts.part-code
     1064     .
     1065     find first bf-add-plus_doc-pl where bf-add-plus_doc-pl.obj-type = bf_trn-doc.obj-type        and
     1066                                         bf-add-plus_doc-pl.obj-code = bf_trn-doc.obj-code        and
     1067                                         bf-add-plus_doc-pl.pl-code  = parpl-code                 and
     1068                                         bf-add-plus_doc-pl.out-code = bf_trn-doc.doc-code        and
     1069                                         bf-add-plus_doc-pl.gds-code = bf-add-plus_goods.gds-code no-error.
     1070     if not available bf-add-plus_doc-pl then do:
     1071       create bf-add-plus_doc-pl.
     1072       assign
     1073         bf-add-plus_doc-pl.obj-type = bf_trn-doc.obj-type
     1074         bf-add-plus_doc-pl.obj-code = bf_trn-doc.obj-code
     1075         bf-add-plus_doc-pl.pl-code  = parpl-code
     1076         bf-add-plus_doc-pl.out-code = bf_trn-doc.doc-code
     1077         bf-add-plus_doc-pl.gds-code = bf-add-plus_goods.gds-code
     1078       .
     1079     end.
     1080     assign
     1081       bf-add-plus_doc-pl.doc-qnty      = bf-add-plus_doc-pl.doc-qnty + parqnty
     1082       bf-add-plus_doc-pl.fact-qnty     = bf-add-plus_doc-pl.doc-qnty
     1083       bf-add-plus_doc-pl.cli-qnty      = bf-add-plus_doc-pl.cli-qnty + parcli-qnty
     1084       bf-add-plus_doc-pl.cli-doc-qnty  = bf-add-plus_doc-pl.cli-qnty
     1085       bf-add-plus_doc-pl.cli-fact-qnty = bf-add-plus_doc-pl.cli-qnty
     1086     .
     1087   end.
     1088   end procedure.
