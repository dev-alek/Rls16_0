      834       if not available tt-parts or
      835          available tt-parts and - tt-parts.fact-qnty < - bf-add_parts.fact-qnty then do:
      836         if varis-petrol-plus     and
      837            not varis-pieces-plus then do:
      838           assign
      839             varrsrv-plus-parts = no
      840             varunrsrv-qnty-pl  = (if available tt-parts then - (bf-add_parts.fact-qnty - tt-parts.fact-qnty) * varkoeff else - bf-add_parts.fact-qnty * varkoeff).
      841           for each tt-pl-qty-plus where tt-pl-qty-plus.qnty-l - tt-pl-qty-plus.rsrv-l > 0 on error undo, return error return-value :
      842             assign
      843               vardensity-reserv       = tt-pl-qty-plus.qnty-kg  / tt-pl-qty-plus.qnty-l
      844               varcli-base-rate-reserv = tt-pl-qty-plus.qnty-l   / tt-pl-qty-plus.qnty-kg
      845               varprice-reserv         = bf-add_parts.price-rubl / varkoeff / vardensity-reserv.
      846             if tt-pl-qty-plus.qnty-l - tt-pl-qty-plus.rsrv-l >= varunrsrv-qnty-pl then do:
      847               assign
      848                 varcrparts-qnty   = varunrsrv-qnty-pl.
      849               run local-create-parts in this-procedure
      850               (varcrparts-qnty,
      851                vardensity-reserv * varcrparts-qnty,
      852                varprice-reserv,
      853                varcli-base-rate-reserv,
      854                varcrparts-qnty / varkoeff,
      855                tt-pl-qty-plus.pl-code,
      856                (if parold-supp-cntr then bf-add_parts.supp-type     else bf_trn-doc.cli-type),
      857                (if parold-supp-cntr then bf-add_parts.supp-code     else bf_trn-doc.cli-code),
      858                (if parold-supp-cntr then bf-add_parts.contract-code else bf_trn-doc.contract-code)
      859                ) no-error.
      860               if error-status :error then do:
      861                 undo, return error substitute ("Ошибка при создании партии: &1", return-value).
      862               end.
      863               assign
      864                 tt-pl-qty-plus.rsrv-l = tt-pl-qty-plus.rsrv-l + varunrsrv-qnty-pl
      865                 varunrsrv-qnty-pl     = 0.00
      866                 varrsrv-plus-parts    = yes.
