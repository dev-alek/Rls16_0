        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter  p-rid as recid no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: wthcdlkp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/wthcdlkp.p $":U .
        9   define variable vss-description as character no-undo init "Просмотр одного УДАЛЕННОГО документа МЦ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable glog as logical no-undo .
       80   define variable next-prev as character no-undo .
       81   define variable v-doc-rec as recid no-undo .
       82   define buffer buf_c-wth-doc for ub.c-wth-doc.
       83   find first buf_c-wth-doc no-lock where recid(buf_c-wth-doc) = p-rid no-error.
       84   if NOT available buf_c-wth-doc then  do:
       85     message
       86     "Неправильный выбор удаленного документа МЦ."
       87     view-as alert-box WARNING .
       88     return no-apply.
       89   end.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91     run mainmenu_getcntxt in parparentproc
       92       (output v-cntxt-db-num
       93       ,output v-cntxt-userid
       94       ,output v-cntxt-level
       95       ,output v-cntxt-host-code-obj
       96       ,output v-cntxt-obj-type
       97       ,output v-cntxt-obj-code
       98       ,output v-cntxt-db-num-obj
       99       ,output v-cntxt-is-admin
      100       ) .
      101   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   do:
      103     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      104       (input  v-cntxt-db-num
      105       ,input  v-cntxt-userid
      106       ,input  0
      107       ,input  'actn_wth-doc_lookup':U
      108       ,input  'object':U
      109       ,input  buf_c-wth-doc.host-code
      110       ,input  buf_c-wth-doc.obj-type
      111       ,input  buf_c-wth-doc.obj-code
      112       ,input  0
      113       ,input  0
      114       ,input  0
      115       ,input  true
      116       ,output glog
      117       )  .
      118   end.
      119   if NOT glog then return .
      120   assign
      121   v-doc-rec = recid(buf_c-WTH-DOC)
      122   .
      123   CASE buf_c-wth-doc.doc-type :
      124   WHEN 'при':U OR
      125   WHEN 'рас':U OR
      126   WHEN 'спи':U THEN DO:
      127       run str/wth-inc.w (  INPUT parparentproc
      128                       ,INPUT 'ПРОСМОТР':U
      129                       ,INPUT buf_c-wth-doc.host-code
      130                       ,INPUT buf_c-wth-doc.obj-type
      131                       ,INPUT buf_c-wth-doc.obj-code
      132                       ,INPUT buf_c-wth-doc.cli-type
      133                       ,INPUT buf_c-wth-doc.cli-code
      134                       ,INPUT buf_c-wth-doc.ext-doc-type
      135                       ,INPUT buf_c-wth-doc.doc-type
      136                       ,INPUT buf_c-wth-doc.auto-filL
      137                       ,INPUT-OUTPUT v-doc-rec
      138                       ,input ?
      139                       ,input-output next-prev
      140                       ) no-error .
      141   END.
      142   WHEN 'инв':U THEN DO:
      143       run str/wth-inv.w (  INPUT parparentproc
      144                       ,INPUT 'ПРОСМОТР':U
      145                       ,INPUT buf_c-wth-doc.host-code
      146                       ,INPUT buf_c-wth-doc.obj-type
      147                       ,INPUT buf_c-wth-doc.obj-code
      148                       ,INPUT buf_c-wth-doc.cli-type
      149                       ,INPUT buf_c-wth-doc.cli-code
      150                       ,input buf_c-wth-doc.ext-doc-type
      151                       ,INPUT buf_c-wth-doc.auto-fill
      152                       ,INPUT-OUTPUT v-doc-rec
      153                       ,input ?
      154                       ,input-output next-prev
      155                       ) no-error .
      156   END.
      157   END CASE.
