        1   block-level on error undo, throw.
        2   define  input parameter parparentproc      as   widget-handle                no-undo.
        3   define  input parameter pardoc-code        like ub.trn-doc.doc-code          no-undo.
        4   define  input parameter pardb-num          like ub.db.db-num                 no-undo.
        5   define  input parameter parfilename        as   character                    no-undo.
        6   define  input parameter parcorr-inkas-code like ub.c-trn-doc.corr-inkas-code no-undo.
        7   define  input parameter parcorr-fbr-code   like ub.c-trn-doc.corr-fbr-code   no-undo.
        8   define  input parameter paruserid          as   character                    no-undo.
        9   define  input parameter parphdoc-code      like ub.trn-doc.doc-code          no-undo.
       10   define  input parameter parphchip-num      as   integer                      no-undo.
       11   define output parameter parchip-num        as   integer                      no-undo.
       12   define variable vss-revision    as character no-undo initial "$Revision: f9f9d1396dd0, 1038, rls $":U.
       13   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U.
       14   define variable vss-date        as character no-undo initial "$Date: Fri Oct 06 18:30:18 2017 +0300 $":U.
       15   define variable vss-workfile    as character no-undo initial "$Workfile: del-doc.p $":U.
       16   define variable vss-archive     as character no-undo initial "$Archive: str/del-doc.p $":U.
       17   define variable vss-description as character no-undo initial "Удаление документов + вывод информации о ходе процесса":U.
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define new global shared variable g#lib-trn  as handle no-undo .
       88   define new global shared variable g#lib-trn2 as handle no-undo .
       89   define new global shared variable g#lib-trn3 as handle no-undo .
       90   define new global shared variable g#lib-trn4 as handle no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define variable v-waitfram-action01         as character   no-undo .
       93   define variable v-waitfram-action02         as character   no-undo .
       94   define variable v-waitfram-action03         as character   no-undo .
       95   define variable mWaitFramTextBeg            as character   no-undo.
       96   define variable mWaitFramTextEnd            as character   no-undo.
       97   define variable mWaitFramView               as logical     no-undo.
       98   define variable mWaitProcEvent              as logical     no-undo init yes.
       99   define variable mWaitFramInterval           as integer     no-undo init 1 .
      100   define variable mWaitFramStop               as logical     no-undo.
      101   define variable mWaitFramStopUser           as logical     no-undo.
      102   define variable mWaitFramStopTimeOut        as logical     no-undo.
      103   define variable mWaitFramStartProc          as datetime-tz no-undo.
      104   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      105   define button B-WaitFramStop auto-end-key
      106        label "Стоп"
      107        size 10 by 1 tooltip "Остоновить процесс".
      108   define button B-viewProcInfo
      109        label "Информация"
      110        size 15 by 1 tooltip "Информация о процесс".
      111   define frame waitfram
      112     v-waitfram-action01 format "x(72)" no-label skip
      113     v-waitfram-action02 format "x(72)" no-label skip
      114     v-waitfram-action03 format "x(72)" no-label skip
      115     B-viewProcInfo
      116     B-WaitFramStop at row 4 col 30
      117     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      118     .
      119   define new global shared variable mBatchMode as logical no-undo init ?.
      120   define variable mFramBachModHandle as handle no-undo.
      121   mFramBachModHandle = frame waitfram:handle.
      122   define variable mFameOldVis as logical no-undo.
      123   define variable mVisCUrentVin as logical no-undo.
      124   if session:batch-mode
      125   then
      126      mBatchMode = yes.
      127   if mBatchMode = ? then do:
      128     mVisCUrentVin = current-window:visible.
      129     mFameOldVis = mFramBachModHandle:visible.
      130     mFramBachModHandle:visible  = yes.
      131     mBatchMode = mFramBachModHandle:visible ne yes.
      132     mFramBachModHandle:visible = mFameOldVis.
      133     current-window:visible = mVisCUrentVin.
      134   end.
      135    if  log-manager:logfile-name ne ?
      136     then DO:
      137         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      138         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      139         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      140     end.
      141   on choose of B-WaitFramStop in frame waitfram
      142   do:
      143     mWaitFramStop = yes.
      144     mWaitFramStopUser = yes.
      145   end.
      146   function waitfram-check-timeout returns logical():
      147      define variable vtime as int64 no-undo.
      148      if mWaitFramStopTimeOut
      149      then
      150         return yes.
      151      vtime = ( now - mWaitFramStartProc ) / 1000 .
      152      if     mWaitFramTimeOut ne ?
      153         and mWaitFramTimeOut ne 0
      154         and mWaitFramTimeOut lt vtime
      155      then do:
      156         mWaitFramStopTimeOut = yes.
      157      end.
      158      return mWaitFramStopTimeOut.
      159   end.
      160   procedure waitfram-hide :
      161     if not session:batch-mode
      162     then do
      163     on error undo, return error return-value
      164     :
      165       pause 0 before-hide .
      166       if not mBatchMode then
      167         hide frame waitfram .
      168     end.
      169   end procedure.
      170   procedure waitfram-show :
      171     define input  parameter p-message as character no-undo .
      172     define variable v-left-margin as integer   no-undo .
      173     if not session:batch-mode
      174     then do
      175     on error undo, return error return-value
      176     :
      177       if length(p-message) <= 70 then do:
      178         assign
      179           v-left-margin = integer((70 - length(p-message)) / 2)
      180         .
      181         assign
      182           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      183         .
      184         assign
      185           v-waitfram-action01 = " "
      186           v-waitfram-action02 = " "
      187                                    + fill(" ", v-left-margin)
      188                                    + p-message
      189           v-waitfram-action03 = " "
      190         .
      191       end.
      192       else do:
      193         define variable vRindex1 as integer no-undo.
      194         define variable vRindex2 as integer no-undo.
      195         vRindex1 = r-index(p-message," ",70).
      196         if vRindex1 = 0
      197         then
      198            vRindex1 = 70.
      199         if length(p-message)  <= vRindex1 + 70 then do:
      200           assign
      201             v-waitfram-action01 = " "
      202             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      203             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      204           .
      205         end.
      206         else do:
      207           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      208           if vRindex2 <= vRindex1
      209           then
      210              vRindex2 = vRindex1 + 70.
      211           assign
      212             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      213             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      214             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      215           .
      216         end.
      217       end.
      218       B-viewProcInfo:visible   in frame waitfram = no.
      219       B-viewProcInfo:sensitive in frame waitfram = no.
      220       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      221       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      222       if  (   mWaitFramView
      223          or  mWaitProcEvent)
      224          and not mBatchMode
      225       then
      226          display
      227             v-waitfram-action01 skip
      228             v-waitfram-action02 skip
      229             v-waitfram-action03 skip
      230          with frame waitfram .
      231     end.
      232   end procedure.
      233      procedure waitfram-show-this:
      234         define input  parameter iInterval as int64 no-undo.
      235         define variable vtime as int64 no-undo.
      236         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      237         mWaitFramInterval = iInterval.
      238         run waitfram-show (substitute("&1&2 &3&4" ,
      239                                       mWaitFramTextBeg ,
      240                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      241                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      242                                       mWaitFramTextEnd
      243                                      )
      244                           ).
      245      end.
      246      procedure WaitFramRunPause:
      247         define input  parameter iInterval as dec no-undo.
      248         define variable vStart  as datetime-tz no-undo.
      249         define variable vend    as datetime-tz no-undo.
      250         define variable vint as int64 no-undo.
      251         define variable vOk as logical no-undo.
      252         vStart = now.
      253         vend   = vStart.
      254         publish "WaitFramPause" (iInterval,output vOk).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and (   vint > 0
      260                 or (    not vOk
      261                     and iInterval eq ?
      262                     )
      263                 )
      264         then
      265            run waitfram-show-this (iInterval).
      266         vend   =  now.
      267         vint = vend - vStart.
      268         vint = iInterval - vint / 1000.
      269         if     not mWaitFramStop
      270            and vint > 0
      271         then do:
      272            run gbl/pause.p (vint * 1000).
      273         end.
      274         if iInterval ne ?
      275         then
      276            publish "WaitFramStop".
      277         waitfram-check-timeout().
      278      end.
      279      procedure WaitFramWaitFor:
      280         define input  parameter iInterval as dec no-undo.
      281         assign
      282            mWaitFramStartProc   = now
      283            mWaitFramStopUser    = no
      284            mWaitFramStopTimeOut = no
      285         .
      286         block-wait:
      287         do while not mWaitFramStop:
      288            run WaitFramRunPause (iInterval).
      289            if  waitfram-check-timeout()
      290            then do:
      291               leave block-wait.
      292            end.
      293         end.
      294         run waitfram-hide.
      295      end.
      296   procedure waitfram-join :
      297     define input  parameter p-line-1  as character no-undo .
      298     define input  parameter p-line-2  as character no-undo .
      299     define input  parameter p-line-3  as character no-undo .
      300     define output parameter p-message as character no-undo .
      301     do
      302     on error undo, return error return-value
      303     :
      304       assign
      305         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      307                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      308       .
      309     end.
      310   end procedure.
      311   function waitfram-join-function returns character
      312     (input p-line-1 as character
      313     ,input p-line-2 as character
      314     ,input p-line-3 as character
      315     ).
      316     define variable v-message as character no-undo .
      317     run waitfram-join in this-procedure
      318       (input  p-line-1
      319       ,input  p-line-2
      320       ,input  p-line-3
      321       ,output v-message
      322       ) .
      323     return v-message .
      324   end function .
      325   define variable v-vid-action as integer  no-undo .
      326   define variable v-vid-param  as longchar no-undo .
      327   define variable v-initiator  as character no-undo.
      328   case true:
      329     when g#auto then v-initiator = "Auto".
      330     when g#news then v-initiator = "Nws".
      331     when g#esys then v-initiator = "Esys".
      332     otherwise v-initiator = "User".
      333   end case.
      334   define variable varshift-date as date      no-undo.
      335   define variable varshift-num  as integer   no-undo.
      336   define variable varshift-name as character no-undo.
      337   define variable v-mess        as character no-undo.
      338   define variable v-boss        as character no-undo.
      339   define variable v-contr       as character no-undo.
      340   define variable v-status      as character no-undo.
      341   define variable v-flag        as logical   no-undo.
      342   find first ub.trn-doc no-lock where ub.trn-doc.doc-code = pardoc-code no-error.
      343   if ub.trn-doc.status_ = 'факт':U
      344   then do:
      345     v-vid-action = 59.
      346     find first ub.clients no-lock where ub.clients.obj-type = 'чел':U and ub.clients.obj-code = ub.trn-doc.boss no-error.
      347     v-boss = if available (ub.clients) then ub.clients.obj-name else "".
      348     v-contr = ub.trn-doc.cli-name.
      349   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      351     (input  ub.trn-doc.obj-type
      352     ,input  ub.trn-doc.obj-code
      353     ,output varshift-date
      354     ,output varshift-num
      355     ,output varshift-name
      356     ) no-error .
      357   end.
      358   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_del-doc in g#lib-trn
      359     (
      360        input parparentproc
      361     ,  input pardoc-code
      362     ,  input pardb-num
      363     ,  input parfilename
      364     ,  input parcorr-inkas-code
      365     ,  input parcorr-fbr-code
      366     ,  input paruserid
      367     ,  input parphdoc-code
      368     ,  input parphchip-num
      369     , output parchip-num
      370     ,  input this-procedure
      371     ) no-error.
      372     if error-status :error then do:
      373       if ub.trn-doc.status_ = 'факт':U
      374       then do:
      375         v-mess = return-value.
      376         v-vid-param = "Initiator=" + "User" + chr(4) +
      377                       "ResponsiblePerson=" + v-boss + chr(4) +
      378                       "SHOP_NUM=" + string(ub.trn-doc.obj-code) + chr(4) +
      379                       "Contractor=" + v-contr + chr(4) +
      380                       "DocNum=" + string(ub.trn-doc.doc-code) + chr(4) +
      381                       "FactDate=" + (if string(ub.trn-doc.fact-date) = ? then '' else string(ub.trn-doc.fact-date)) + chr(4) +
      382                       "DocType=" + string(ub.trn-doc.doc-type) + chr(4) +
      383                       "SHIFT_NUM_DOC=" + (if string(ub.trn-doc.shift-num) = ? then '' else string(ub.trn-doc.shift-num)) + (if string(ub.trn-doc.shift-date) = ? then '' else string(ub.trn-doc.shift-date, "99999999")) + chr(4) +
      384                       "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
      385                       "Status=" + string(ub.trn-doc.status_) + (if ub.trn-doc.flag then "+" else "-" ) + chr(4) +
      386                       "RESULT=" + string( 1 ) + chr(4) +
      387                       "Description=" + v-mess no-error.
      388         run trg/userlog.p (
      389               input 'delete_err':U
      390             , input 'trn-doc':U
      391             , input ( buffer ub.trn-doc :handle )
      392             , input v-vid-action
      393             , input v-vid-param
      394         ) no-error.
      395       end.
      396       run waitfram-hide in this-procedure no-error.
      397       return error substitute( "&1 &2", v-mess, error-status :get-message( 1 ) ).
      398     end.
      399     find last ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code = pardoc-code and ub.c-trn-doc.corr-user-db-num = pardb-num no-error.
      400     if available (ub.c-trn-doc) and ub.c-trn-doc.status_ = 'факт':U
      401     then do:
      402       v-vid-param = "Initiator=" + "User" + chr(4) +
      403                     "ResponsiblePerson=" + v-boss + chr(4) +
      404                     "SHOP_NUM=" + string(c-trn-doc.obj-code) + chr(4) +
      405                     "Contractor=" + v-contr + chr(4) +
      406                     "DocNum=" + string(c-trn-doc.doc-code) + chr(4) +
      407                     "FactDate=" + (if string(c-trn-doc.fact-date) = ? then '' else string(c-trn-doc.fact-date)) + chr(4) +
      408                     "DocType=" + string(c-trn-doc.doc-type) + chr(4) +
      409                     "SHIFT_NUM_DOC=" + (if string(c-trn-doc.shift-num) = ? then '' else string(c-trn-doc.shift-num)) + (if string(c-trn-doc.shift-date) = ? then '' else string(c-trn-doc.shift-date, "99999999")) + chr(4) +
      410                     "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
      411                     "Status=" + string(c-trn-doc.status_) + (if c-trn-doc.flag then "+" else "-" ) + chr(4) +
      412                     "RESULT=" + string( 0 ) + chr(4) +
      413                     "Description=" no-error.
      414       run trg/userlog.p (
      415             input 'delete':U
      416           , input 'c-trn-doc':U
      417           , input ( buffer ub.c-trn-doc :handle )
      418           , input v-vid-action
      419           , input v-vid-param
      420       ) no-error.
      421     end.
      422     run waitfram-hide in this-procedure no-error.
