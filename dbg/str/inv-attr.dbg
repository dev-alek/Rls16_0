      110   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   function funcgrzp returns character
      112   ( input p-par-code as char  ,
      113     input p-par-value as char ) .
      114   def buffer buf_clients for ub.clients .
      115   define variable v-type as character no-undo .
      116   define variable v-code as integer   no-undo .
      117   if lookup(p-par-code,'Recipient':U) = 0  then return "".
      118   assign
      119     v-type = substring(p-par-value,1,3)
      120     v-code = int(substring(p-par-value,4,15) )
      121   .
      122   if error-status :error then return "".
      123   find first buf_clients no-lock where
      124              buf_clients.obj-type = v-type and
      125              buf_clients.obj-code = v-code
      126              no-error .
      127              if error-status :error then return "" .
      128   return buf_clients.obj-name .
      129   end function.
      130   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      133   define variable par-type          as character no-undo.
      134   define variable v-value-character as character no-undo .
      135   define variable v-value-date      as date      no-undo .
      136   define variable v-value-decimal   as decimal   no-undo .
      137   define variable v-value-integer   as integer   no-undo .
      138   define variable v-value-logical   as logical   no-undo .
      139   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      141   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      142   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      143   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      144   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      145   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      146   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      147   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      148   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      149   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      150   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      151   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      152   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      153   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      154   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      155   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      156   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      157   define new global shared variable g#lib-trn  as handle no-undo .
      158   define new global shared variable g#lib-trn2 as handle no-undo .
      159   define new global shared variable g#lib-trn3 as handle no-undo .
      160   define new global shared variable g#lib-trn4 as handle no-undo .
      161   define input parameter parParentProc as handle no-undo .
      162   define input parameter parbtn as character no-undo.
      163   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
      164   define input parameter table for tt-upd-attr .
      165   define variable varrec-id          as recid     no-undo.
      166   define variable v-no-news          as logical   no-undo init false .
      167   define variable v-attr-mandat-wayb as character no-undo .
      168   define variable ii                 as integer   no-undo .
      169   define variable bcol               as handle    extent no-undo.
      170   define variable hBrowse            as handle    no-undo.
      171   define buffer buf_trn-doc for ub.trn-doc .
      172   define temp-table tt-inv-attr no-undo
      173     field attr-code     as character
      174     field attr-value    as character
      175     field second-code   as character
      176     field second-value  as character
      177     field label-attr    as character
      178     field user-can-edit as logical
      179     field sort_         as integer
      180     index code is primary unique attr-code
      181     index by-sort                sort_
      182     .
      183   DEFINE BUTTON b-chg
      184     LABEL "&Изменить"
      185     SIZE 10 BY 1
      186     BGCOLOR 8 .
      187   DEFINE BUTTON b-exit AUTO-END-KEY
      188     LABEL "&Выход"
      189     SIZE 10 BY 1
      190     BGCOLOR 8 .
      191   DEFINE BUTTON b-lkp
      192     LABEL "&Просмотр"
      193     SIZE 10 BY 1
      194     BGCOLOR 8 .
      195   DEFINE VARIABLE tech AS LOGICAL INITIAL no
      196     LABEL "Техническая операция"
      197     VIEW-AS TOGGLE-BOX
      198     SIZE 24.5 BY .83 NO-UNDO.
      199   DEFINE QUERY b-doc-attr FOR
      200     tt-inv-attr SCROLLING.
      201   DEFINE BROWSE b-doc-attr
      202     QUERY b-doc-attr NO-LOCK DISPLAY
      203     tt-inv-attr.label-attr COLUMN-LABEL "Код" FORMAT "X(45)"
      204     tt-inv-attr.attr-value COLUMN-LABEL "Значение" FORMAT "X(30)"
      205     tt-inv-attr.second-value COLUMN-LABEL "Должность" FORMAT "X(30)"
      206       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.63 BY 19.29.
      207   DEFINE FRAME Dialog-Frame
      208     b-exit AT ROW 1 COL 1
      209     b-lkp AT ROW 1 COL 21
      210     b-chg AT ROW 1 COL 31
      211     tech AT ROW 1.08 COL 44 WIDGET-ID 2
      212     b-doc-attr AT ROW 2.46 COL 1.75
      213     SPACE(0.00) SKIP(0.07)
      214     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      215     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      216     TITLE "Атрибуты инвентаризации"
      217     DEFAULT-BUTTON b-exit.
      218   ASSIGN
      219     FRAME Dialog-Frame:SCROLLABLE = FALSE
      220     FRAME Dialog-Frame:HIDDEN     = TRUE.
      221   ASSIGN
      222     b-doc-attr:COLUMN-RESIZABLE IN FRAME Dialog-Frame = TRUE.
      223   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      224     DO:
      225       apply "chose":U to b-exit .
      226       APPLY "END-ERROR":U TO SELF.
      227     END.
      228   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      229     DO:
      230       define variable is-check as logical   no-undo .
      231       define variable is-mes   as character no-undo .
      232       define variable varlog   as logical   no-undo .
      233       define buffer fio_inv-attr    for tt-inv-attr .
      234       define buffer pos_inv-attr    for tt-inv-attr .
      235       define buffer prikaz_inv-attr for tt-inv-attr .
      236       if lookup ("b-chg", parbtn) = 0 then return .
      237       if not tech then
      238       do:
      239         if not can-find (first prikaz_inv-attr no-lock where
      240           prikaz_inv-attr.attr-code = 'trdcattr-prikaz-date':U and
      241           prikaz_inv-attr.attr-value <> "") then
      242         do:
      243           is-check = true .
      244         end.
      245         if not can-find (first fio_inv-attr no-lock where
      246           (fio_inv-attr.attr-code = 'trdcattr-fio-agent':U or
      247           fio_inv-attr.attr-code = 'trdcattr-fio-player1':U or
      248           fio_inv-attr.attr-code = 'trdcattr-fio-player2':U or
      249           fio_inv-attr.attr-code = 'trdcattr-fio-player3':U) and
      250           fio_inv-attr.attr-value <> "") then
      251         do:
      252           is-check = true .
      253         end.
      254         if not can-find (first fio_inv-attr no-lock where
      255           (fio_inv-attr.second-code = 'trdcattr-pos-agent':U or
      256           fio_inv-attr.second-code = 'trdcattr-pos-player1':U or
      257           fio_inv-attr.second-code = 'trdcattr-pos-player2':U or
      258           fio_inv-attr.second-code = 'trdcattr-pos-player3':U) and
      259           fio_inv-attr.second-value <> "")then
      260         do:
      261           is-check = true .
      262         end.
      263         if is-check then is-mes = "Не заполнены обязательные атрибуты накладной инвентаризации." + chr(10).
      264           find first fio_inv-attr no-lock where
      265           fio_inv-attr.attr-code = 'trdcattr-fio-agent':U and
      266           fio_inv-attr.attr-value <> "" no-error .
      267           if not available (fio_inv-attr) then do:
      268           find first pos_inv-attr no-lock where
      269           pos_inv-attr.second-code = 'trdcattr-pos-agent':U and
      270           pos_inv-attr.second-value <> "" no-error .
      271           if available (pos_inv-attr) then is-mes = is-mes + "Не заполнена ФИО председателя комиссии." + chr(10).
      272           end.
      273           else do:
      274           find first pos_inv-attr no-lock where
      275           pos_inv-attr.second-code = 'trdcattr-pos-agent':U and
      276           pos_inv-attr.second-value <> "" no-error .
      277           if not available (pos_inv-attr) then is-mes = is-mes + "Не заполнена должность председателя комиссии." + chr(10).
      278           end.
      279           find first fio_inv-attr no-lock where
      280           fio_inv-attr.attr-code = 'trdcattr-fio-player1':U and
      281           fio_inv-attr.attr-value <> "" no-error .
      282           if not available (fio_inv-attr) then do:
      283           find first pos_inv-attr no-lock where
      284           pos_inv-attr.second-code = 'trdcattr-pos-player1':U and
      285           pos_inv-attr.second-value <> "" no-error .
      286           if available (pos_inv-attr) then is-mes = is-mes + "Не заполнена ФИО первого участника комиссии." + chr(10).
      287           end.
      288           else do:
      289           find first pos_inv-attr no-lock where
      290           pos_inv-attr.second-code = 'trdcattr-pos-player1':U and
      291           pos_inv-attr.second-value <> "" no-error .
      292           if not available (pos_inv-attr) then is-mes = is-mes + "Не заполнена должность первого участника комиссии." + chr(10).
      293           end.
      294           find first fio_inv-attr no-lock where
      295           fio_inv-attr.attr-code = 'trdcattr-fio-player2':U and
      296           fio_inv-attr.attr-value <> "" no-error .
      297           if not available (fio_inv-attr) then do:
      298           find first pos_inv-attr no-lock where
      299           pos_inv-attr.second-code = 'trdcattr-pos-player2':U and
      300           pos_inv-attr.second-value <> "" no-error .
      301           if available (pos_inv-attr) then is-mes = is-mes + "Не заполнена ФИО второго участника комиссии." + chr(10).
      302           end.
      303           else do:
      304           find first pos_inv-attr no-lock where
      305           pos_inv-attr.second-code = 'trdcattr-pos-player2':U and
      306           pos_inv-attr.second-value <> "" no-error .
      307           if not available (pos_inv-attr) then is-mes = is-mes + "Не заполнена должность второго участника комиссии." + chr(10).
      308           end.
      309           find first fio_inv-attr no-lock where
      310           fio_inv-attr.attr-code = 'trdcattr-fio-player3':U and
      311           fio_inv-attr.attr-value <> "" no-error .
      312           if not available (fio_inv-attr) then do:
      313           find first pos_inv-attr no-lock where
      314           pos_inv-attr.second-code = 'trdcattr-pos-player3':U and
      315           pos_inv-attr.second-value <> "" no-error .
      316           if available (pos_inv-attr) then is-mes = is-mes + "Не заполнена ФИО третьего участника комиссии." + chr(10).
      317           end.
      318           else do:
      319           find first pos_inv-attr no-lock where
      320           pos_inv-attr.second-code = 'trdcattr-pos-player3':U and
      321           pos_inv-attr.second-value <> "" no-error .
      322           if not available (pos_inv-attr) then is-mes = is-mes + "Не заполнена должность третьего участника комиссии." + chr(10).
      323           end.
      324           if is-mes <> "" then is-mes = is-mes + "Вы уверены, что хотите выйти, не заполнив обязательные атрибуты?" .
      325         if is-mes <> "" then
      326         do:
      327           message
      328             is-mes
      329             view-as alert-box question buttons yes-no update varlog.
      330             if not varlog then return no-apply.
      331         end.
      332       end.
      333     END.
      334   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      335     DO:
      336       define variable vartemp-char  as character no-undo.
      337       define variable p-anyfromproc as character no-undo .
      338       define variable p-start-h     as integer   no-undo.
      339       define variable p-start-m     as integer   no-undo.
      340       define variable p-end-h       as integer   no-undo.
      341       define variable p-end-m       as integer   no-undo.
      342       if available tt-inv-attr then
      343       do:
      344         find first tt-upd-attr no-lock where tt-upd-attr.code = tt-inv-attr.attr-code no-error .
      345         if available (tt-upd-attr) then
      346         do:
      347           if tt-inv-attr.second-code = "" then
      348           do:
      349             run gbl/d-prompt.w (
      350               'title=':u + 'Изменение атрибутов инвентаризации' + '\':u
      351               + 'text1=':u + tt-upd-attr.label-attr + '\':u
      352               + 'format=' + tt-upd-attr.format-attr + '\':u
      353               + 'type=' + tt-upd-attr.type-attr + '\':u
      354               + 'fillin_row=2\':u
      355               + 'fillin_col=4\':u
      356               + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      357               + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      358               + 'max-chars=70\':u
      359               + 'readonly=' + 'no':u + '\':u
      360               , input-output tt-inv-attr.attr-value
      361               ) no-error.
      362             if error-status:error then
      363             do:
      364               message "Ошибка при изменении атрибута." skip
      365                 return-value skip
      366                 error-status:get-message(1) view-as alert-box error.
      367               return no-apply.
      368             end.
      369             if return-value = 'false':u then
      370             do:
      371               return no-apply.
      372             end.
      373             if tt-inv-attr.attr-code = 'trdcattr-prikaz-date':U or tt-inv-attr.attr-code = 'trdcattr-inv-date':U
      374             then do:
      375                 define variable ddate as date no-undo.
      376                 if tt-inv-attr.attr-value <> "" then do:
      377                     ddate = date(tt-inv-attr.attr-value) no-error.
      378                     if error-status:error then do:
      379                         message "Некорректный формат даты." view-as alert-box error.
      380                         return no-apply.
      381                     end.
      382                     if year(ddate) < 2000 or year(ddate) > 2100 then do:
      383                         message "Год должен быть от 2000 до 2100. " view-as alert-box error.
      384                         return no-apply.
      385                     end.
      386                 end.
      387             end.
      388   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-wrt in g#trdcalib ( input pardoc-code ,
      389                          input tt-inv-attr.attr-code ,
      390                          input tt-inv-attr.attr-value ) no-error .
      391             if error-status :error then
      392             do:
      393               message "Ошибка при сохранении атрибута." view-as alert-box.
      394               undo, return no-apply.
      395             end.
      396           end.
      397           else
      398           do:
      399             run ref/d-invAttr.w (
      400               'title=':u + 'Изменение атрибутов инвентаризации' + '\':u
      401               + 'text1=':u + tt-upd-attr.label-attr + '\':u
      402               + 'text2=':u + "Должность" + '\':u
      403               + 'format=' + tt-upd-attr.format-attr + '\':u
      404               + 'type=' + tt-upd-attr.type-attr + '\':u
      405               + 'fillin_row=2\':u
      406               + 'fillin_col=4\':u
      407               + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      408               + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      409               + 'max-chars=70\':u
      410               + 'readonly=' + 'no':u + '\':u
      411               , input tech
      412               , input-output tt-inv-attr.attr-value
      413               , input-output tt-inv-attr.second-value
      414               ) no-error.
      415             if error-status:error then
      416             do:
      417               message "Ошибка при изменении атрибута." skip
      418                 return-value skip
      419                 error-status:get-message(1) view-as alert-box error.
      420               return no-apply.
      421             end.
      422   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-wrt in g#trdcalib ( input pardoc-code ,
      423                          input tt-inv-attr.second-code ,
      424                          input tt-inv-attr.second-value ) no-error .
      425             if error-status :error then
      426             do:
      427               message "Ошибка при сохранении атрибута." view-as alert-box.
      428               undo, return no-apply.
      429             end.
      430   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-wrt in g#trdcalib ( input pardoc-code ,
      431                          input tt-inv-attr.attr-code ,
      432                          input tt-inv-attr.attr-value ) no-error .
      433             if error-status :error then
      434             do:
      435               message "Ошибка при сохранении атрибута." view-as alert-box.
      436               undo, return no-apply.
      437             end.
      438           end.
      439           assign
      440             varrec-id = recid(tt-inv-attr).
      441           OPEN QUERY b-doc-attr FOR EACH tt-inv-attr NO-LOCK by tt-inv-attr.sort                                         .
      442           reposition b-doc-attr to recid varrec-id.
      443         end.
      444       end.
      445     END.
      446   ON return OF b-doc-attr IN FRAME Dialog-Frame
      447     DO:
      448       if  b-chg:sensitive THEN apply "CHOOSE":U to b-chg.
      449       else apply "choose":U to b-lkp.
      450       return no-apply.
      451     END.
      452   ON ROW-DISPLAY OF b-doc-attr IN FRAME Dialog-Frame
      453     DO:
      454       run rowdisp .
      455     END.
      456   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      457     DO:
      458       define variable vartemp-char as character no-undo.
      459       if available tt-inv-attr then
      460       do:
      461         find first tt-upd-attr no-lock where tt-upd-attr.code = tt-inv-attr.attr-code no-error .
      462         if available (tt-upd-attr) then
      463         do:
      464           assign
      465             vartemp-char = tt-inv-attr.attr-value
      466             .
      467           if tt-inv-attr.second-code = "" then
      468           do:
      469             run gbl/d-prompt.w (
      470               'title=':u + 'Изменение атрибутов документа' + '\':u
      471               + 'text1=':u + tt-upd-attr.label-attr + '\':u
      472               + 'format=' + tt-upd-attr.format-attr + '\':u
      473               + 'type=' + tt-upd-attr.type-attr + '\':u
      474               + 'fillin_row=2\':u
      475               + 'fillin_col=4\':u
      476               + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      477               + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      478               + 'max-chars=70\':u
      479               + 'readonly=' + 'yes':u + '\':u
      480               , input-output vartemp-char
      481               ) no-error.
      482           end.
      483           else
      484           do:
      485             run ref/d-invAttr.w (
      486               'title=':u + 'Изменение атрибутов инвентаризации' + '\':u
      487               + 'text1=':u + tt-upd-attr.label-attr + '\':u
      488               + 'text2=':u + "Должность" + '\':u
      489               + 'format=' + tt-upd-attr.format-attr + '\':u
      490               + 'type=' + tt-upd-attr.type-attr + '\':u
      491               + 'fillin_row=2\':u
      492               + 'fillin_col=4\':u
      493               + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      494               + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      495               + 'max-chars=70\':u
      496               + 'readonly=' + 'yes':u + '\':u
      497               , input-output tt-inv-attr.attr-value
      498               , input-output tt-inv-attr.second-value
      499               ) no-error.
      500           end.
      501         end.
      502       end.
      503     end.
      504   ON VALUE-CHANGED OF tech IN FRAME Dialog-Frame
      505     DO:
      506       assign tech .
      507       find first ub.inv-doc-attr exclusive-lock where ub.inv-doc-attr.doc-code = pardoc-code and
      508         ub.inv-doc-attr.attr-code = "invTech" no-error .
      509       if not available (ub.inv-doc-attr) then
      510       do:
      511         create ub.inv-doc-attr .
      512         assign
      513           ub.inv-doc-attr.doc-code  = pardoc-code
      514           ub.inv-doc-attr.attr-code = "invTech"
      515           .
      516       end.
      517       ub.inv-doc-attr.attr-value = string(tech) .
      518     END.
      519   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      520     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      521   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   on F3 of frame Dialog-Frame anywhere do:
      523     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
      524     return no-apply.
      525   end.
      526   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   on F4 of frame Dialog-Frame anywhere do:
      528     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
      529     return no-apply.
      530   end.
      531   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   on f5 of frame Dialog-Frame anywhere
      533   do:
      534     OPEN QUERY b-doc-attr FOR EACH tt-inv-attr NO-LOCK by tt-inv-attr.sort                                         .
      535       apply "VALUE-CHANGED" to b-doc-attr.
      536   end.
      537   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   do:
      539     b-doc-attr :SET-REPOSITIONED-ROW(4, "CONDITIONAL") .
      540   end.
      541   MAIN-BLOCK:
      542   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      543     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      544     if lookup ("b-lkp", parbtn) > 0 then
      545     do:
      546       enable b-lkp with frame Dialog-Frame.
      547     end.
      548     if lookup ("b-chg", parbtn) > 0 then
      549     do:
      550       enable b-chg tech with frame Dialog-Frame.
      551     end.
      552     run init-proc in this-procedure .
      553     hbrowse = browse b-doc-attr:handle.
      554     extent (bcol) = hbrowse:num-columns.
      555     bcol[1] = hbrowse:first-column.
      556     do ii = 1 to extent (bcol).
      557       bcol[ii] = hbrowse:get-browse-column (ii).
      558     end.
      559     RUN enable_UI.
      560     apply 'entry':u to browse b-doc-attr .
      561     wait-for go of frame Dialog-Frame.
      562   END.
      563   RUN disable_UI.
      564   PROCEDURE disable_UI :
      565     HIDE FRAME Dialog-Frame.
      566   END PROCEDURE.
      567   PROCEDURE enable_UI :
      568     DISPLAY tech
      569       WITH FRAME Dialog-Frame.
      570     ENABLE b-exit b-doc-attr
      571       WITH FRAME Dialog-Frame.
      572     VIEW FRAME Dialog-Frame.
      573     OPEN QUERY b-doc-attr FOR EACH tt-inv-attr NO-LOCK by tt-inv-attr.sort                                         .
      574   END PROCEDURE.
      575   PROCEDURE init-proc :
      576     define variable v-func-name as character no-undo .
      577     define variable v-proc-name as character no-undo .
      578     define variable tt          as character no-undo .
      579     define variable i           as integer   no-undo .
      580     define variable list-attr   as character no-undo .
      581     list-attr = 'trdcattr-fio-player3':U + "/" + 'trdcattr-fio-player2':U + "/" + 'trdcattr-fio-player1':U + "/" + 'trdcattr-fio-agent':U .
      582     for each tt-upd-attr where tt-upd-attr.output-display = yes  :
      583       create tt-inv-attr .
      584       assign
      585         tt-inv-attr.label-attr = tt-upd-attr.label-attr
      586         tt-inv-attr.attr-code  = tt-upd-attr.code
      587         tt-inv-attr.sort_      = tt-upd-attr.sort_
      588         .
      589       if lookup(tt-inv-attr.attr-code,list-attr,"/") > 0 then
      590       do:
      591         case tt-inv-attr.attr-code:
      592           when 'trdcattr-fio-agent':U then
      593             do:
      594               tt-inv-attr.second-code = 'trdcattr-pos-agent':U .
      595             end.
      596           when 'trdcattr-fio-player1':U then
      597             do:
      598               tt-inv-attr.second-code = 'trdcattr-pos-player1':U .
      599             end.
      600           when 'trdcattr-fio-player2':U then
      601             do:
      602               tt-inv-attr.second-code = 'trdcattr-pos-player2':U .
      603             end.
      604           when 'trdcattr-fio-player3':U then
      605             do:
      606               tt-inv-attr.second-code = 'trdcattr-pos-player3':U .
      607             end.
      608         end case .
      609       end.
      610     end.
      611     for each tt-inv-attr:
      612       for first ub.inv-doc-attr no-lock where ub.inv-doc-attr.attr-code = tt-inv-attr.attr-code and
      613         ub.inv-doc-attr.doc-code = pardoc-code:
      614         tt-inv-attr.attr-value = ub.inv-doc-attr.attr-value .
      615       end.
      616       for first ub.inv-doc-attr no-lock where ub.inv-doc-attr.attr-code = tt-inv-attr.second-code and
      617         ub.inv-doc-attr.doc-code = pardoc-code:
      618         tt-inv-attr.second-value = ub.inv-doc-attr.attr-value .
      619       end.
      620     end.
      621     find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = pardoc-code and
      622       ub.inv-doc-attr.attr-code = "invTech" no-error .
      623     if available (ub.inv-doc-attr) then tech = logical (ub.inv-doc-attr.attr-value) .
      624   END PROCEDURE.
      625   PROCEDURE rowdisp :
      626   END PROCEDURE.
      627   PROCEDURE st-attr :
      628     define variable varattr-code like ub.doc-attr.attr-code no-undo.
      629     define buffer bf_doc-attr for ub.doc-attr.
      630     define variable vartemp-char as character no-undo.
      631     define buffer buf_doc-attr    for ub.doc-attr .
      632     define buffer buf_tt-upd-attr for tt-upd-attr .
      633     do
      634       transaction on error undo, return error return-value
      635       :
      636       for each buf_tt-upd-attr
      637         on error undo, return error return-value
      638         :
      639         find first buf_doc-attr no-lock
      640           where buf_doc-attr.doc-code  = pardoc-code
      641           and buf_doc-attr.attr-code = buf_tt-upd-attr.code
      642           no-error .
      643         if available buf_doc-attr
      644           then
      645         do:
      646           assign
      647             buf_tt-upd-attr.can-select = false
      648             .
      649         end.
      650         else
      651         do:
      652           assign
      653             buf_tt-upd-attr.can-select = true
      654             .
      655         end.
      656       end.
      657       run str/b-attr.w
      658         (input table tt-upd-attr
      659         ,output varattr-code
      660         ) no-error .
      661       if error-status :error
      662         then
      663       do:
      664         if return-value <> ""
      665           then
      666         do:
      667           message
      668             "Ошибка при выборе добавляемого атрибута."
      669             view-as alert-box error.
      670         end.
      671         undo, return error.
      672       end.
      673       find first tt-upd-attr where tt-upd-attr.code = varattr-code no-error.
      674       if not available tt-upd-attr then
      675       do:
      676         message "Не верно выбран атрибут для добавления." view-as alert-box error.
      677         undo, return error.
      678       end.
      679       if tt-upd-attr.user-can-edit <> yes then
      680       do:
      681         message "Атрибут нельзя добавить в данном интерфейсе." view-as alert-box.
      682         undo, return error.
      683       end.
      684       find first bf_doc-attr where bf_doc-attr.doc-code   = pardoc-code and
      685         bf_doc-attr.attr-code = varattr-code no-lock no-error.
      686       if available bf_doc-attr then
      687       do:
      688         message "Атрибут " tt-upd-attr.label-attr " уже есть в документе " pardoc-code " ."
      689           view-as alert-box error.
      690         undo, return error.
      691       end.
      692       create ub.inv-doc-attr.
      693       assign
      694         ub.inv-doc-attr.doc-code  = pardoc-code
      695         ub.inv-doc-attr.attr-code = varattr-code.
      696       run gbl/d-prompt.w (
      697         'title=':u + 'Изменение атрибутов документа' + '\':u
      698         + 'text1=':u + tt-upd-attr.label-attr + '\':u
      699         + 'format=' + tt-upd-attr.format-attr + '\':u
      700         + 'type=' + tt-upd-attr.type-attr + '\':u
      701         + 'fillin_row=2\':u
      702         + 'fillin_col=4\':u
      703         + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
      704         + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
      705         + 'max-chars=70\':u
      706         + 'readonly=' + 'no':u + '\':u
      707         , input-output vartemp-char
      708         ) no-error.
      709       if error-status:error then
      710       do:
      711         message "Ошибка при изменении атрибута." skip
      712           return-value skip
      713           error-status:get-message(1) view-as alert-box error.
      714         undo, return error.
      715       end.
      716       if return-value = 'false':u then
      717       do:
      718         undo, return error.
      719       end.
      720   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-wrt in g#trdcalib ( input ub.inv-doc-attr.doc-code ,
      721                          input ub.inv-doc-attr.attr-code ,
      722                          input vartemp-char ) no-error .
      723       if error-status :error then
      724       do:
      725         message "Ошибка при сохранении атрибута." view-as alert-box.
      726         undo, return error.
      727       end.
      728       assign
      729         varrec-id = recid(ub.doc-attr)
      730         .
      731       if not v-no-news  then
      732       do:
      733   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdatinv-oth in g#trdcalib ( input ub.inv-doc-attr.doc-code ,
      734                          input ub.inv-doc-attr.attr-code ,
      735                          input vartemp-char ) no-error .
      736         if error-status :error then
      737         do:
      738           message "Ошибка при обработке атрибута." view-as alert-box.
      739           undo, return no-apply.
      740         end.
      741       end.
      742     end.
      743   END PROCEDURE.
