      889        size 15 by 1 tooltip "Информация о процесс".
      890   define frame waitfram
      891     v-waitfram-action01 format "x(72)" no-label skip
      892     v-waitfram-action02 format "x(72)" no-label skip
      893     v-waitfram-action03 format "x(72)" no-label skip
      894     B-viewProcInfo
      895     B-WaitFramStop at row 4 col 30
      896     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      897     .
      898   define new global shared variable mBatchMode as logical no-undo init ?.
      899   define variable mFramBachModHandle as handle no-undo.
      900   mFramBachModHandle = frame waitfram:handle.
      901   define variable mFameOldVis as logical no-undo.
      902   define variable mVisCUrentVin as logical no-undo.
      903   if session:batch-mode
      904   then
      905      mBatchMode = yes.
      906   if mBatchMode = ? then do:
      907     mVisCUrentVin = current-window:visible.
      908     mFameOldVis = mFramBachModHandle:visible.
      909     mFramBachModHandle:visible  = yes.
      910     mBatchMode = mFramBachModHandle:visible ne yes.
      911     mFramBachModHandle:visible = mFameOldVis.
      912     current-window:visible = mVisCUrentVin.
      913   end.
      914    if  log-manager:logfile-name ne ?
      915     then DO:
      916         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      917         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      918         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      919     end.
      920   on choose of B-WaitFramStop in frame waitfram
      921   do:
      922     mWaitFramStop = yes.
      923     mWaitFramStopUser = yes.
      924   end.
      925   function waitfram-check-timeout returns logical():
      926      define variable vtime as int64 no-undo.
      927      if mWaitFramStopTimeOut
      928      then
      929         return yes.
      930      vtime = ( now - mWaitFramStartProc ) / 1000 .
      931      if     mWaitFramTimeOut ne ?
      932         and mWaitFramTimeOut ne 0
      933         and mWaitFramTimeOut lt vtime
      934      then do:
      935         mWaitFramStopTimeOut = yes.
      936      end.
      937      return mWaitFramStopTimeOut.
      938   end.
      939   procedure waitfram-hide :
      940     if not session:batch-mode
      941     then do
      942     on error undo, return error return-value
      943     :
      944       pause 0 before-hide .
      945       if not mBatchMode then
      946         hide frame waitfram .
      947     if     not mWaitFramView
      948        and mWaitProcEvent
      949     then
      950       process events .
      951     end.
      952   end procedure.
      953   procedure waitfram-show :
      954     define input  parameter p-message as character no-undo .
      955     define variable v-left-margin as integer   no-undo .
      956     if not session:batch-mode
      957     then do
      958     on error undo, return error return-value
      959     :
      960       if length(p-message) <= 70 then do:
      961         assign
      962           v-left-margin = integer((70 - length(p-message)) / 2)
      963         .
      964         assign
      965           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      966         .
      967         assign
      968           v-waitfram-action01 = " "
      969           v-waitfram-action02 = " "
      970                                    + fill(" ", v-left-margin)
      971                                    + p-message
      972           v-waitfram-action03 = " "
      973         .
      974       end.
      975       else do:
      976         define variable vRindex1 as integer no-undo.
      977         define variable vRindex2 as integer no-undo.
      978         vRindex1 = r-index(p-message," ",70).
      979         if vRindex1 = 0
      980         then
      981            vRindex1 = 70.
      982         if length(p-message)  <= vRindex1 + 70 then do:
      983           assign
      984             v-waitfram-action01 = " "
      985             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      986             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      987           .
      988         end.
      989         else do:
      990           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      991           if vRindex2 <= vRindex1
      992           then
      993              vRindex2 = vRindex1 + 70.
      994           assign
      995             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      996             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      997             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      998           .
      999         end.
     1000       end.
     1001       B-viewProcInfo:visible   in frame waitfram = no.
     1002       B-viewProcInfo:sensitive in frame waitfram = no.
     1003       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1004       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1005       if  (   mWaitFramView
     1006          or  mWaitProcEvent)
     1007          and not mBatchMode
     1008       then
     1009          display
     1010             v-waitfram-action01 skip
     1011             v-waitfram-action02 skip
     1012             v-waitfram-action03 skip
     1013          with frame waitfram .
     1014       if     mWaitFramView
     1015          then do:
     1016             if     mWaitFramInterval ne ?
     1017                and not mBatchMode
     1018             then
     1019                wait-for go of frame waitfram pause mWaitFramInterval.
     1020          end.
     1021          else
     1022             if     mWaitProcEvent
     1023                and not mBatchMode
     1024             then
     1025                process events .
     1026     end.
     1027   end procedure.
     1028      procedure waitfram-show-this:
     1029         define input  parameter iInterval as int64 no-undo.
     1030         define variable vtime as int64 no-undo.
     1031         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1032         mWaitFramInterval = iInterval.
     1033         run waitfram-show (substitute("&1&2 &3&4" ,
     1034                                       mWaitFramTextBeg ,
     1035                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1036                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1037                                       mWaitFramTextEnd
     1038                                      )
     1039                           ).
     1040      end.
     1041      procedure WaitFramRunPause:
     1042         define input  parameter iInterval as dec no-undo.
     1043         define variable vStart  as datetime-tz no-undo.
     1044         define variable vend    as datetime-tz no-undo.
     1045         define variable vint as int64 no-undo.
     1046         define variable vOk as logical no-undo.
     1047         vStart = now.
     1048         vend   = vStart.
     1049         publish "WaitFramPause" (iInterval,output vOk).
     1050         vend   =  now.
     1051         vint = vend - vStart.
     1052         vint = iInterval - vint / 1000.
     1053         if     not mWaitFramStop
     1054            and (   vint > 0
     1055                 or (    not vOk
     1056                     and iInterval eq ?
     1057                     )
     1058                 )
     1059         then
     1060            run waitfram-show-this (iInterval).
     1061         vend   =  now.
     1062         vint = vend - vStart.
     1063         vint = iInterval - vint / 1000.
     1064         if     not mWaitFramStop
     1065            and vint > 0
     1066         then do:
     1067            run gbl/pause.p (vint * 1000).
     1068         end.
     1069         if iInterval ne ?
     1070         then
     1071            publish "WaitFramStop".
     1072         waitfram-check-timeout().
     1073      end.
     1074      procedure WaitFramWaitFor:
     1075         define input  parameter iInterval as dec no-undo.
     1076         assign
     1077            mWaitFramStartProc   = now
     1078            mWaitFramStopUser    = no
     1079            mWaitFramStopTimeOut = no
     1080         .
     1081         block-wait:
     1082         do while not mWaitFramStop:
     1083            run WaitFramRunPause (iInterval).
     1084            if  waitfram-check-timeout()
     1085            then do:
     1086               leave block-wait.
     1087            end.
     1088         end.
     1089         run waitfram-hide.
     1090      end.
     1091   procedure waitfram-join :
     1092     define input  parameter p-line-1  as character no-undo .
     1093     define input  parameter p-line-2  as character no-undo .
     1094     define input  parameter p-line-3  as character no-undo .
     1095     define output parameter p-message as character no-undo .
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099       assign
     1100         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1101                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1102                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1103       .
     1104     end.
     1105   end procedure.
     1106   function waitfram-join-function returns character
     1107     (input p-line-1 as character
     1108     ,input p-line-2 as character
     1109     ,input p-line-3 as character
     1110     ).
     1111     define variable v-message as character no-undo .
     1112     run waitfram-join in this-procedure
     1113       (input  p-line-1
     1114       ,input  p-line-2
     1115       ,input  p-line-3
     1116       ,output v-message
     1117       ) .
     1118     return v-message .
     1119   end function .
     1120   define variable g#report-num as integer   no-undo .
     1121   run get-report-num in parparentproc (output g#report-num ).
     1122   define variable PrintCopiesCounter  as integer  INIT 1 no-undo.
     1123   define variable RepPathName     as      character         no-undo.
     1124   define variable LifeStartDate     as      character         no-undo.
     1125   define variable PrintRubl     as      logical         no-undo.
     1126   define variable type-par as char no-undo.
     1127   define variable tmp-var as character no-undo.
     1128   define variable FullGdsName as log no-undo.
     1129   define variable XL-delim as character no-undo.
     1130   define variable trim-artic-ch as character no-undo.
     1131   define variable in-cur-rate as log no-undo.
     1132   define variable Line       as   char    no-undo.
     1133   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   function breakstr returns character ( input        for-name    as character,
     1135                                         input        line-length as integer,
     1136                                         input-output line1       as character,
     1137                                         input-output line2       as character ) :
     1138     define variable ii as integer no-undo.
     1139     if length( for-name ) > line-length then do:
     1140       assign ii    = 1
     1141              line1 = "":u
     1142              line2 = "":u.
     1143       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1144         assign line1 =       substring( for-name, 1, line-length     )
     1145                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1146       end.                                                     else do:
     1147         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1148           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1149                  ii    = ii    + 1.
     1150           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1151             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1152           end.
     1153         end.
     1154         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1155       end.
     1156     end.                                else do:
     1157       assign line1 = for-name
     1158              line2 = "":u.
     1159     end.
     1160     return ( line1 ).
     1161   end function.
