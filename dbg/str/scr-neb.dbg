     2053         (input  (p-new-height - frame Dialog-Frame :height)
     2054         ,input  p-move-resize
     2055         ) .
     2056     end.
     2057   end procedure.
     2058   procedure diasize_change-width :
     2059     define input  parameter p-change-value as decimal   no-undo .
     2060     define input  parameter p-move-resize  as logical   no-undo .
     2061     define variable v-field-group-handle   as handle    no-undo .
