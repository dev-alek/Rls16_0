     2392           undo move_block, retry move_block.
     2393         end.
     2394         if frame Dialog-Frame :scrollable = true
     2395         then do:
     2396           assign
     2397             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2398           no-error .
     2399           if error-status :error
     2400           or error-status :get-message(1) <> ""
     2401           then do:
     2402             undo move_block, retry move_block.
     2403           end.
     2404         end.
     2405       end.
     2406       if p-move-resize
     2407       then do:
     2408         run diasize_position-resize-button in this-procedure .
     2409       end.
     2410       if v-diasize-wndstore = true
     2411       then do:
     2412         if connected("ub") = true
     2413         then do:
     2414           define variable v-cntxt-db-num        as integer   no-undo .
     2415           define variable v-cntxt-userid        as character no-undo .
     2416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2417                                             , OUTPUT v-cntxt-userid
     2418                                             ) .
     2419           run gbl/wndsizew.p
     2420             (input  v-cntxt-db-num
     2421             ,input  v-cntxt-userid
     2422             ,input  v-diasize-proc-name
     2423             ,input  'width':u
     2424             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2425             ) .
     2426         end.
     2427       end.
     2428     end.
     2429     assign
     2430       v-diasize-change-size = false
     2431     .
     2432   end procedure.
     2433   procedure diasize_set-width :
     2434     define input  parameter p-new-width  as decimal   no-undo .
     2435     define input  parameter p-move-resize as logical   no-undo .
     2436     do
     2437     on error undo, return error return-value
     2438     :
     2439       run diasize_change-width in this-procedure
     2440         (input  (p-new-width - frame Dialog-Frame :width)
     2441         ,input  p-move-resize
     2442         ) .
     2443     end.
     2444   end procedure.
     2445   procedure diasize_position-resize-button :
     2446     do with frame Dialog-Frame
     2447     :
     2448       hide v-diasize-resize-button .
     2449       assign
     2450         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2451                     - 1
     2452                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2453         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2454                     - 1
     2455                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2456       .
     2457       view v-diasize-resize-button .
     2458     end.
     2459   end procedure.
     2460   on alt-right anywhere
     2461   do:
     2462     run diasize_change-width in this-procedure
     2463       (input 1
     2464       ,input true
     2465       ) .
     2466     return no-apply .
     2467   end.
     2468   on alt-left anywhere
     2469   do:
     2470     run diasize_change-width in this-procedure
     2471       (input -1
     2472       ,input true
     2473       ) .
     2474     return no-apply .
     2475   end.
     2476   on alt-down anywhere
     2477   do:
     2478     run diasize_change-height in this-procedure
     2479       (input 1
     2480       ,input true
     2481       ) .
     2482     return no-apply .
     2483   end.
     2484   on alt-up anywhere
     2485   do:
     2486     run diasize_change-height in this-procedure
     2487       (input -1
     2488       ,input true
     2489       ) .
     2490     return no-apply .
     2491   end.
     2492   on alt-enter of frame Dialog-Frame
     2493   do:
     2494     run diasize_maximize in this-procedure
     2495       (input  ?
     2496       ).
     2497     return no-apply .
     2498   end.
     2499   procedure diasize_end-move :
     2500     do
     2501     on error undo, return error return-value
     2502     :
     2503       define variable v-row-delta as decimal   no-undo .
     2504       define variable v-col-delta as decimal   no-undo .
     2505       define variable v-new-row as decimal   no-undo .
     2506       define variable v-new-col as decimal   no-undo .
     2507       assign
     2508         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2509         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2510       .
     2511       assign
     2512         v-row-delta = v-new-row - frame Dialog-Frame :height
     2513         v-col-delta = v-new-col - frame Dialog-Frame :width
     2514       .
     2515       run diasize_change-height in this-procedure
     2516         (input v-row-delta
     2517         ,input true
     2518         ) .
     2519       run diasize_change-width in this-procedure
     2520         (input v-col-delta
     2521         ,input true
     2522         ) .
     2523     end.
     2524   end procedure.
     2525   procedure diasize_maximize :
     2526     define input  parameter p-action as logical   no-undo .
     2527     do
     2528     on error undo, return error return-value
     2529     :
     2530       if p-action = ?
     2531       then do:
     2532         if v-diasize-need-maximize = true
     2533         then do:
     2534           assign
     2535             p-action = true
     2536           .
     2537         end.
     2538         else do:
     2539           assign
     2540             p-action = false
     2541           .
     2542         end.
     2543       end.
     2544       if p-action = true
     2545       then do:
     2546         run diasize_change-height in this-procedure
     2547           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2548               - frame Dialog-Frame :height-chars
     2549           ,input true
     2550           ) .
     2551         run diasize_change-width in this-procedure
     2552           (input session :width-chars
     2553               - frame Dialog-Frame :width-chars
     2554           ,input true
     2555           ) .
     2556         assign
     2557           v-diasize-need-maximize = false
     2558         .
     2559       end.
     2560       else do:
     2561         run diasize_change-width in this-procedure
     2562           (input v-diasize-orig-frame-width
     2563               - frame Dialog-Frame :width-chars
     2564           ,input true
     2565           ) .
     2566         run diasize_change-height in this-procedure
     2567           (input v-diasize-orig-frame-height
     2568               - frame Dialog-Frame :height-chars
     2569           ,input true
     2570           ) .
     2571         assign
     2572           v-diasize-need-maximize = true
     2573         .
     2574       end.
     2575     end.
     2576   end procedure.
     2577   procedure diasize_restore-orig-size :
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       assign
     2582         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2583         v-diasize-current-frame-height = frame Dialog-Frame :height
     2584       .
     2585       run diasize_set-height in this-procedure
     2586         (input  v-diasize-orig-frame-height
     2587         ,input  true
     2588         ) .
     2589       run diasize_set-width in this-procedure
     2590         (input  v-diasize-orig-frame-width
     2591         ,input  true
     2592         ) .
     2593     end.
     2594   end procedure.
     2595   procedure diasize_restore-current-size :
     2596     do
     2597     on error undo, return error return-value
     2598     :
     2599       run diasize_set-height in this-procedure
     2600         (input  v-diasize-current-frame-height
     2601         ,input  true
     2602         ) .
     2603       run diasize_set-width in this-procedure
     2604         (input  v-diasize-current-frame-width
     2605         ,input  true
     2606         ) .
     2607     end.
     2608   end procedure.
     2609   procedure diasize_set-browse-handle :
     2610     define input  parameter p-browse-handle as handle   no-undo .
     2611     define buffer buf_temp-browse-handle for temp-browse-handle .
     2612     do
     2613     on error undo, return error return-value
     2614     :
     2615       assign
     2616         v-diasize-browse-handle = p-browse-handle
     2617       .
     2618       for each buf_temp-browse-handle
     2619       on error undo, return error return-value
     2620       :
     2621         delete buf_temp-browse-handle .
     2622       end.
     2623     end.
     2624   end procedure.
     2625   procedure diasize_add_browse :
     2626     define input  parameter p-browse-type   as character no-undo .
     2627     define input  parameter p-browse-handle as handle    no-undo .
     2628     define buffer buf_temp-browse-handle for temp-browse-handle .
     2629     do
     2630     on error undo, return error return-value
     2631     :
     2632       assign
     2633         v-diasize-browse-number = v-diasize-browse-number + 1
     2634       .
     2635       create buf_temp-browse-handle .
     2636       assign
     2637         buf_temp-browse-handle.browse-type   = p-browse-type
     2638         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2639         buf_temp-browse-handle.browse-handle = p-browse-handle
     2640       .
     2641     end.
     2642   end procedure.
     2643   procedure diasize_init :
     2644     define variable v-default-value    as logical   no-undo .
     2645     define variable v-restore-saved    as logical   no-undo .
     2646     define variable v-resize-value-str as character no-undo .
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       do with frame Dialog-Frame
     2651       :
     2652         assign
     2653           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2654           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2655           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2656         .
     2657         create button v-diasize-resize-button
     2658         assign
     2659           parent        = frame Dialog-Frame :first-child
     2660           label         = "s"
     2661           height-pixels = 16
     2662           width-pixels  = 16
     2663           visible       = true
     2664           sensitive     = true
     2665           movable       = true
     2666           triggers:
     2667             on end-move persistent run diasize_end-move in this-procedure .
     2668           end triggers.
     2669         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2670         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2671         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2672         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2673         assign
     2674           v-diasize-wndmax = false
     2675         .
     2676         if connected("ub") = true
     2677         then do:
     2678           define variable v-cntxt-db-num        as integer   no-undo .
     2679           define variable v-cntxt-userid        as character no-undo .
     2680           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2681                                             , OUTPUT v-cntxt-userid
     2682                                             ) .
     2683           run gbl/wndpar_r.p
     2684             (input  v-cntxt-db-num
     2685             ,input  v-cntxt-userid
     2686             ,input  'wndmax':U
     2687             ,output v-diasize-wndmax
     2688             ,output v-default-value
     2689             ) .
     2690         end.
     2691         assign
     2692           v-diasize-wndstore = false
     2693         .
     2694         if connected("ub") = true
     2695         then do:
     2696           run gbl/wndpar_r.p
     2697             (input  v-cntxt-db-num
     2698             ,input  v-cntxt-userid
     2699             ,input  'wndstore':U
     2700             ,output v-diasize-wndstore
     2701             ,output v-default-value
     2702             ) .
     2703         end.
     2704         assign
     2705           v-diasize-proc-name = entry(1, program-name(2), '.')
     2706         .
     2707         if v-diasize-wndstore = true
     2708         then do:
     2709           assign
     2710             v-restore-saved = false
     2711           .
     2712           if connected("ub") = true
     2713           then do:
     2714             run gbl/wndsizer.p
     2715               (input  v-cntxt-db-num
     2716               ,input  v-cntxt-userid
     2717               ,input  v-diasize-proc-name
     2718               ,input  'height':u
     2719               ,output v-resize-value-str
     2720               ) .
     2721             if v-resize-value-str <> '':U
     2722             then do:
     2723               run diasize_change-height in this-procedure
     2724                 (input  integer(v-resize-value-str)
     2725                 ,input  true
     2726                 ) .
     2727               assign
     2728                 v-restore-saved = true
     2729               .
     2730             end.
     2731           end.
     2732           if connected("ub") = true
     2733           then do:
     2734             run gbl/wndsizer.p
     2735               (input  v-cntxt-db-num
     2736               ,input  v-cntxt-userid
     2737               ,input  v-diasize-proc-name
     2738               ,input  'width':u
     2739               ,output v-resize-value-str
     2740               ) .
     2741             if v-resize-value-str <> '':U
     2742             then do:
     2743               run diasize_change-width in this-procedure
     2744                 (input  integer(v-resize-value-str)
     2745                 ,input  true
     2746                 ) .
     2747               assign
     2748                 v-restore-saved = true
     2749               .
     2750             end.
     2751           end.
     2752           if v-restore-saved <> true
     2753           then do:
     2754             if v-diasize-wndmax = true
     2755             then do:
     2756               run diasize_maximize in this-procedure
     2757                 (input  true
     2758                 ) .
     2759             end.
     2760           end.
     2761         end.
     2762         else do:
     2763           if v-diasize-wndmax = true
     2764           then do:
     2765             run diasize_maximize in this-procedure
     2766               (input  true
     2767               ) .
     2768           end.
     2769         end.
     2770       end.
     2771     end.
     2772   end procedure.
     2773   procedure diasize_need-full-display :
     2774     define output parameter p-need-full-display as logical   no-undo .
     2775     do
     2776     on error undo, return error return-value
     2777     :
     2778       assign
     2779         p-need-full-display = v-diasize-need-full-display
     2780       .
     2781       assign
     2782         v-diasize-need-full-display = false
     2783       .
     2784     end.
     2785   end procedure.
     2786   procedure get-context :
     2787      define output parameter p-db-num as integer          no-undo.
     2788      define output parameter p-user-id as character        no-undo.
     2789      define variable v-login               as character    no-undo.
     2790      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2791      define buffer buf_user-login  for ub.user-login .
     2792      do
     2793      on error undo, return error
     2794      :
     2795            FIND FIRST buf_sys-ctrl no-lock.
     2796            ASSIGN
     2797               v-login = USERID("ub")
     2798               p-db-num = buf_sys-ctrl.db-num
     2799            .
     2800            FIND FIRST buf_user-login
     2801                 WHERE buf_user-login.db-num = p-db-num
     2802                   AND buf_user-login.user-login = v-login
     2803                 no-lock
     2804                 no-error
     2805                 .
     2806            IF AVAILABLE buf_user-login
     2807            THEN DO:
     2808               assign
     2809                  p-user-id = buf_user-login.user-id
     2810               .
     2811            END.
     2812      end.
     2813   end procedure.
     2814       run diasize_init in this-procedure .
     2815   MAIN-BLOCK:
     2816   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2817      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2818     RUN enable_UI.
     2819     assign
     2820       editor-1 = "d  - товар присутствует только в документе" + chr(10) +
     2821                  "f  - товар присутствует только по факту"     + chr(10) +
     2822                  "<> - кол-во в документе не равно кол-ву по факту"  + chr(10) +
     2823                  "?  - приведен бар-код партии или складского места".
     2824     display editor-1 with frame Dialog-Frame.
     2825     if paradd-qnty = yes then do:
     2826       assign varstr:sensitive = yes
     2827                         varstr:visible     = yes.
     2828     end.
     2829     assign b-exp-f:MENU-MOUSE = 1.
     2830     WAIT-FOR GO OF FRAME Dialog-Frame.
     2831   END.
     2832   RUN disable_UI.
     2833   PROCEDURE disable_UI :
     2834     HIDE FRAME Dialog-Frame.
     2835   END PROCEDURE.
     2836   PROCEDURE enable_UI :
     2837     DISPLAY EDITOR-1
     2838         WITH FRAME Dialog-Frame.
     2839     ENABLE b-exit b-cancel b-re b-exp-f b-print b-help BROWSE-1
     2840         WITH FRAME Dialog-Frame.
     2841     VIEW FRAME Dialog-Frame.
     2842     OPEN QUERY BROWSE-1 FOR EACH tt-bar-code-ne.
     2843   END PROCEDURE.
