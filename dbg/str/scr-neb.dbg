     1364   ON ROW-DISPLAY OF BROWSE-1 IN FRAME Dialog-Frame
     1365   DO:
     1366   if tt-bar-code-ne.mark = "f" then do:
     1367       assign tt-bar-code-ne.b-c:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.artic:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.scn-qnty-file:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.scn-qnty-doc:fgcolor in browse BROWSE-1 = red_color varqnty:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.gds-name:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.node-name:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.prod-type:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.prod-code:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.in-code:fgcolor in browse BROWSE-1 = red_color tt-bar-code-ne.part-code:fgcolor in browse BROWSE-1 = red_color .
     1368   end.
     1369   if tt-bar-code-ne.mark = "d" then do:
     1370       assign tt-bar-code-ne.b-c:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.artic:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.scn-qnty-file:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.scn-qnty-doc:fgcolor in browse BROWSE-1 = dark_green_color varqnty:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.gds-name:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.node-name:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.prod-type:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.prod-code:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.in-code:fgcolor in browse BROWSE-1 = dark_green_color tt-bar-code-ne.part-code:fgcolor in browse BROWSE-1 = dark_green_color .
     1371   end.
     1372   if tt-bar-code-ne.mark = ">" then do:
     1373       assign tt-bar-code-ne.b-c:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.artic:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.scn-qnty-file:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.scn-qnty-doc:fgcolor in browse BROWSE-1 = blue_color varqnty:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.gds-name:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.node-name:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.prod-type:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.prod-code:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.in-code:fgcolor in browse BROWSE-1 = blue_color tt-bar-code-ne.part-code:fgcolor in browse BROWSE-1 = blue_color .
     1374   end.
     1375   if tt-bar-code-ne.mark = "<" then do:
     1376       assign tt-bar-code-ne.b-c:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.artic:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.scn-qnty-file:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.scn-qnty-doc:fgcolor in browse BROWSE-1 = brown_color varqnty:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.gds-name:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.node-name:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.prod-type:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.prod-code:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.in-code:fgcolor in browse BROWSE-1 = brown_color tt-bar-code-ne.part-code:fgcolor in browse BROWSE-1 = brown_color .
     1377   end.
     1378   END.
     1379   ON CHOOSE OF MENU-ITEM m_f
     1380   DO:
     1381     output stream str-f to value(parfile-name + ".f").
     1382     for each tt-bar-code-ne :
     1383       if tt-bar-code-ne.mark <> "f" then next.
     1384       put stream str-f unformatted tt-bar-code-ne.b-c ", " tt-bar-code-ne.scn-qnty-file skip.
     1385     end.
     1386     output stream str-f close.
     1387   END.
     1388   ON CHOOSE OF MENU-ITEM m_f2
     1389   DO:
     1390     output stream str-fg to value(parfile-name + ".fg").
     1391     for each tt-bar-code-ne :
     1392       if tt-bar-code-ne.mark <> ">" and
     1393          tt-bar-code-ne.mark <> "f" then next.
     1394       put stream str-fg unformatted tt-bar-code-ne.b-c ", " (tt-bar-code-ne.scn-qnty-file - tt-bar-code-ne.scn-qnty-doc)  skip.
     1395     end.
     1396     output stream str-fg close.
     1397   END.
     1398   ON CHOOSE OF MENU-ITEM m_item
     1399   DO:
     1400     output stream str-g to value(parfile-name + ".g").
     1401     for each tt-bar-code-ne :
     1402       if tt-bar-code-ne.mark <> ">" then next.
     1403       put stream str-g unformatted tt-bar-code-ne.b-c ", " (tt-bar-code-ne.scn-qnty-file - tt-bar-code-ne.scn-qnty-doc)  skip.
     1404     end.
     1405     output stream str-g close.
     1406   END.
     1407   ON return OF varstr IN FRAME Dialog-Frame
     1408   DO:
     1409   define variable varresult   as character                no-undo.
     1410   define variable vartype-bc  as character                no-undo.
     1411   define variable varweight   as decimal                  no-undo.
     1412   define buffer bf_bar-code for ub.bar-code.
     1413   define buffer bf_prod-bc  for ub.prod-bc.
     1414   define buffer bf_place    for ub.place.
     1415   define buffer bf_goods    for ub.goods.
     1416   define buffer bf_gds-prt  for ub.gds-prt.
     1417   define buffer bf_tt-bar-code-ne for tt-bar-code-ne.
     1418   assign frame Dialog-Frame varstr.
     1419   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1420   define variable varscales-pref as character no-undo .
     1421   define variable varpgscales-pref as character no-undo .
     1422   define variable varscales-pref-type8 as character no-undo.
     1423   varscales-pref  = ?.
     1424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1425     (input  'sclspref':u
     1426     ,input  '':u
     1427     ,input  '':u
     1428     ,input  0
     1429     ,input  '':u
     1430     ,input  '':u
     1431     ,input  '':u
     1432     ,input  no
     1433     ,output varscales-pref
     1434     ,output varscales-pref-type8
     1435     ) no-error .
     1436   if varscales-pref = ? then do:
     1437     assign
     1438     varscales-pref = '21,23,25':U.
     1439   end.
     1440   define variable varpgscales-pref-type8 as character no-undo.
     1441   varpgscales-pref  = ?.
     1442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1443     (input  'scpgpref':u
     1444     ,input  '':u
     1445     ,input  '':u
     1446     ,input  0
     1447     ,input  '':u
     1448     ,input  '':u
     1449     ,input  '':u
     1450     ,input  no
     1451     ,output varpgscales-pref
     1452     ,output varpgscales-pref-type8
     1453     ) no-error .
     1454   if varpgscales-pref = ? then do:
     1455     assign
     1456     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1457   end.
     1458   if varstr <> "" then
     1459   do:
     1460     run checkTypeByBarCode in this-procedure (integer(varstr), ?) no-error.
     1461     if error-status:error then
     1462     do:
     1463       varstr = "".
     1464       disp varstr with frame Dialog-Frame.
     1465       return no-apply.
     1466     end.
     1467   end.
     1468   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1469   (
     1470    input  parparentproc
     1471   ,input  varstr
     1472   ,input  ?
     1473   ,input  parobj-type
     1474   ,input  parobj-code
     1475   ,input  yes
     1476   ,input  no
     1477   ,input  varscales-pref
     1478   ,input  varpgscales-pref
     1479   ,output varresult
     1480   ,output vartype-bc
     1481   ,output varweight
     1482   ,buffer bf_bar-code
     1483   ,buffer bf_prod-bc
     1484   ,buffer bf_place
     1485   ) no-error.
     1486   if error-status:error then do:
     1487     message
     1488     "Ошибка при вызове процедуры распознования бар-кода." skip
     1489     return-value skip
     1490     error-status:get-message(1) skip
     1491     error-status:get-message(2) skip
     1492     error-status:get-message(3)
     1493     view-as alert-box error.
     1494     display "" @ varstr with frame Dialog-Frame.
     1495     return no-apply.
     1496   end.
     1497   if not available bf_bar-code then do:
     1498     message "Бар-код не распознан." view-as alert-box error.
     1499     display "" @ varstr with frame Dialog-Frame.
     1500     return no-apply.
     1501   end.
     1502   find first bf_tt-bar-code-ne where bf_tt-bar-code-ne.b-c = bf_bar-code.b-code no-error.
     1503   if not available bf_tt-bar-code-ne then do:
     1504     message "Такого бар-кода нет в документе" view-as alert-box error.
     1505     find first bf_goods   where bf_goods.gds-code    = bf_bar-code.gds-code  no-lock.
     1506     find first bf_gds-prt where bf_gds-prt.node-code = bf_bar-code.node-code no-lock.
     1507     create bf_tt-bar-code-ne.
     1508     assign
     1509       bf_tt-bar-code-ne.nm             = -1
     1510       bf_tt-bar-code-ne.mark           = "f"
     1511       bf_tt-bar-code-ne.b-c            = bf_bar-code.b-code
     1512       bf_tt-bar-code-ne.scn-qnty-doc   = 0
     1513       bf_tt-bar-code-ne.mem-qnty       = 0
     1514       bf_tt-bar-code-ne.bef-qnty       = 0
     1515       bf_tt-bar-code-ne.artic          = bf_goods.artic
     1516       bf_tt-bar-code-ne.prod-type      = bf_goods.prod-type
     1517       bf_tt-bar-code-ne.prod-code      = bf_goods.prod-code
     1518       bf_tt-bar-code-ne.gds-name       = bf_goods.gds-name
     1519       bf_tt-bar-code-ne.node-name      = (if bf_gds-prt.node-name = '_Пустая шкала':U then "--------------------" else bf_gds-prt.node-name)
     1520       bf_tt-bar-code-ne.part-code      = ''
     1521       bf_tt-bar-code-ne.in-code        = ''.
     1522     display "" @ varstr with frame Dialog-Frame.
     1523     OPEN QUERY BROWSE-1 FOR EACH tt-bar-code-ne.
     1524   end.
     1525   assign
     1526      bf_tt-bar-code-ne.scn-qnty-file = bf_tt-bar-code-ne.scn-qnty-file + 1.
     1527   if bf_tt-bar-code-ne.mark <> "f" then do:
     1528     assign
     1529     bf_tt-bar-code-ne.mark = (if bf_tt-bar-code-ne.scn-qnty-file < bf_tt-bar-code-ne.scn-qnty-doc then "<" else (if bf_tt-bar-code-ne.scn-qnty-file > bf_tt-bar-code-ne.scn-qnty-doc then ">" else "")).
     1530   end.
     1531   reposition BROWSE-1 to recid recid(bf_tt-bar-code-ne).
     1532   apply "ROW-DISPLAY" to BROWSE-1 IN FRAME Dialog-Frame.
     1533   display "" @ varstr with frame Dialog-Frame.
     1534   END.
     1535   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1536   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1537   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   on help of frame Dialog-Frame
     1539   do:
     1540     run gbl/app_help.p
     1541       (input this-procedure :file-name
     1542       ,input ''
     1543       ,input ?
     1544       ) no-error.
     1545     if error-status :error then do:
     1546       message
     1547         "Ошибка при вызове помощи"
     1548         error-status :get-message(1)
     1549         view-as alert-box .
     1550     end.
     1551   end.
     1552   run minbtn-set in this-procedure .
     1553   on choose of b-help in frame Dialog-Frame
     1554   do:
     1555     apply "help":u to frame Dialog-Frame .
     1556   end.
     1557   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   procedure minbtn-set :
     1559       do
     1560           on error undo, return error return-value
     1561           :
     1562           define variable ii              as integer       no-undo .
     1563           define variable fh              as widget-handle no-undo .
     1564           define variable hh              as widget-handle no-undo .
     1565           define variable v-h             as handle        extent 4 no-undo .
     1566           define variable v-name-button   as character     no-undo .
     1567           define variable v-help-old-x    as decimal       no-undo .
     1568           define variable v-help-old-y    as decimal       no-undo .
     1569           define variable v-help-old-size as decimal       no-undo .
     1570           define variable v-frame-width   as decimal       no-undo .
     1571           define variable jj              as integer       no-undo .
     1572           do
     1573               on error undo, return error
     1574               :
     1575               assign
     1576                   v-frame-width = frame Dialog-Frame:width - 0.3
     1577                   fh            = frame Dialog-Frame:first-child
     1578                   hh            = fh:first-child
     1579                   ii            = 1
     1580                   .
     1581               do while valid-handle(hh):
     1582                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1583                   do:
     1584                       case lc(hh:name) :
     1585                           when "b-help" then
     1586                               do:
     1587                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1588                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1589                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1590                                   hh:TOOLTIP = "Помощь" .
     1591                                   v-help-old-x = hh:column .
     1592                                   v-help-old-y = hh:row    .
     1593                                   v-help-old-size = hh:width .
     1594                                   hh:width-chars = 2.5 .
     1595                               end.
     1596                           when "b-print" then
     1597                               do:
     1598                                   hh:load-image("cmp/b-print.bmp":u) .
     1599                                   hh:TOOLTIP = "Печать" .
     1600                                   v-h[ii] = hh:handle .
     1601                                   ii = ii + 1 .
     1602                                   hh:width-chars = 3 .
     1603                               end.
     1604                           when "b-history" or
     1605                           when "b-hist" then
     1606                               do:
     1607                                   hh:load-image("cmp/b-hist.bmp":u) .
     1608                                   hh:TOOLTIP = "История" .
     1609                                   v-h[ii] = hh:handle .
     1610                                   ii = ii + 1 .
     1611                                   hh:width-chars = 3 .
     1612                               end.
     1613                           when "b-sch" then
     1614                               do:
     1615                                   hh:load-image("cmp/b-sch.bmp":u) .
     1616                                   hh:TOOLTIP = "Установка Фильтра" .
     1617                                   v-h[ii] = hh:handle .
     1618                                   ii = ii + 1 .
     1619                                   hh:width-chars = 3 .
     1620                               end.
     1621                           when "b-hist-user" then
     1622                               do:
     1623                                   hh:load-image("cmp/b-hist.bmp":u) .
     1624                                   hh:TOOLTIP = "История пользователя" .
     1625                                   ii = ii + 1 .
     1626                               end.
     1627                       end case.
     1628                   end.
     1629                   hh = hh:next-sibling.
     1630               end.
     1631               b-help:column = v-frame-width - b-help:width-chars.
     1632               jj = 0.
     1633               repeat ii = 4 to 1 by -1 :
     1634                   if valid-handle (v-h[ii] ) then
     1635                   do:
     1636                       jj  = jj + 1 .
     1637                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1638                       v-h[ii]:row    = v-help-old-y .
     1639                   end.
     1640               end.
     1641           end.
     1642       end.
     1643   end procedure.
     1644   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1645   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1646   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1647   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1648   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1649   define variable v-diasize-current-frame-height as decimal   no-undo .
     1650   define variable v-diasize-change-size          as logical   no-undo .
     1651   define variable v-diasize-resize-button        as handle    no-undo .
     1652   define variable v-diasize-wndmax               as logical   no-undo .
     1653   define variable v-diasize-wndstore             as logical   no-undo .
     1654   define variable v-diasize-proc-name            as character no-undo .
     1655   define variable v-diasize-browse-handle        as handle    no-undo .
     1656   define variable v-diasize-browse-number        as integer   no-undo .
     1657   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1658   define temp-table temp-diasize-handle no-undo
     1659     field handle-value  as handle
     1660     field save-position as decimal
     1661     index xpk is primary unique handle-value
     1662     .
     1663   define temp-table temp-browse-handle no-undo
     1664     field browse-type   as character
     1665     field browse-number as integer
     1666     field browse-handle as handle
     1667     field original-size as decimal
     1668     index xpk is primary unique browse-type browse-number
     1669     index xie browse-type browse-handle
     1670   .
     1671   procedure diasize_change-height :
     1672     define input  parameter p-change-value  as decimal   no-undo .
     1673     define input  parameter p-move-resize   as logical   no-undo .
     1674     define variable v-field-group-handle    as handle    no-undo .
     1675     define variable v-object-handle         as handle    no-undo .
     1676     define variable v-frame-height          as decimal   no-undo .
     1677     define variable v-frame-virtual-height  as decimal   no-undo .
     1678     define variable v-browse-height         as decimal   no-undo .
     1679     define variable v-window-height         as decimal   no-undo .
     1680     define variable v-window-virtual-height as decimal   no-undo .
     1681     define variable v-change-sign           as integer   no-undo .
     1682     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1683     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1684     if p-change-value > 0
     1685     then do:
     1686       if frame Dialog-Frame :height + p-change-value
     1687           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1688       then do:
     1689         assign
     1690           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1691                           - (frame Dialog-Frame :height-chars)
     1692         .
     1693         if p-change-value <= 0
     1694         then do:
     1695           run diasize_position-resize-button in this-procedure .
     1696           return .
     1697         end.
     1698       end.
     1699     end.
     1700     if p-change-value < 0
     1701     then do:
     1702       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1703       then do:
     1704         assign
     1705           p-change-value = v-diasize-orig-frame-height
     1706                          - (frame Dialog-Frame :height-chars)
     1707         .
     1708         if p-change-value >= 0
     1709         then do:
     1710           run diasize_position-resize-button in this-procedure .
     1711           return .
     1712         end.
     1713       end.
     1714     end.
     1715     if p-change-value >= 0
     1716     then do:
     1717       assign
     1718         v-change-sign = 1
     1719       .
     1720     end.
     1721     else do:
     1722       assign
     1723         v-change-sign = -1
     1724       .
     1725     end.
     1726     assign
     1727       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1728     .
     1729     if p-change-value = 0
     1730     then do:
     1731       run diasize_position-resize-button in this-procedure .
     1732       return .
     1733     end.
     1734     move_block:
     1735     do
     1736     on error undo move_block, retry move_block
     1737     :
     1738       if retry
     1739       then do:
     1740         do
     1741         on error undo move_block, leave move_block
     1742         :
     1743           if p-change-value > 0
     1744           then do:
     1745             for each buf_temp-diasize-handle
     1746             on error undo, next
     1747             :
     1748               assign
     1749                 v-object-handle = buf_temp-diasize-handle.handle-value
     1750               .
     1751               if v-object-handle <> v-diasize-resize-button
     1752               then do:
     1753                 assign
     1754                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1755                 .
     1756               end.
     1757             end.
     1758             assign
     1759               v-diasize-browse-handle :height = v-browse-height
     1760             .
     1761             for each buf_temp-browse-handle
     1762               where buf_temp-browse-handle.browse-type = 'height':u
     1763             on error undo, next
     1764             :
     1765               assign
     1766                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1767               .
     1768             end.
     1769             assign
     1770               frame Dialog-Frame :height = v-frame-height
     1771             .
     1772             if frame Dialog-Frame :scrollable = true
     1773             then do:
