     2068     define variable v-change-sign          as integer   no-undo .
     2069     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2070     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2071     if p-change-value > 0
     2072     then do:
     2073       if frame Dialog-Frame :width + p-change-value >
     2074           session :width-chars
     2075       then do:
     2076         assign
     2077           p-change-value = session :width-chars - frame Dialog-Frame :width
     2078         .
     2079         if p-change-value <= 0
     2080         then do:
     2081           run diasize_position-resize-button in this-procedure .
     2082           return .
     2083         end.
     2084       end.
     2085     end.
     2086     if p-change-value < 0
     2087     then do:
     2088       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2089       then do:
     2090         assign
     2091           p-change-value = v-diasize-orig-frame-width
     2092                          - frame Dialog-Frame :width
     2093         .
     2094         if p-change-value >= 0
     2095         then do:
     2096           run diasize_position-resize-button in this-procedure .
     2097           return .
     2098         end.
     2099       end.
     2100     end.
     2101     if p-change-value >= 0
     2102     then do:
     2103       assign
     2104         v-change-sign = 1
     2105       .
     2106     end.
     2107     else do:
     2108       assign
     2109         v-change-sign = -1
     2110       .
     2111     end.
     2112     assign
     2113       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2114     .
     2115     if p-change-value = 0
     2116     then do:
     2117       run diasize_position-resize-button in this-procedure .
     2118       return .
     2119     end.
