        1   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        2   define temp-table tt-bar-code-ne no-undo
        3   field nm            as integer
        4   field mark          as character
        5   field b-c           as integer
        6   field scn-qnty-doc  as decimal
        7   field scn-qnty-file as decimal
        8   field mem-qnty      as decimal
        9   field bef-qnty      as decimal
       10   field artic         like ub.goods.artic
