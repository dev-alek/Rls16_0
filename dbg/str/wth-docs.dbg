     3441         parobj-type parobj-code
     3442         view-as alert-box ERROR.
     3443         return.
     3444     end.
     3445     CASE par-mode:
     3446       WHEN 'все':U        THEN DO:
     3447       END.
     3448       WHEN 'фирма':U    THEN DO:
     3449           FIND FIRST buf_cli No-LOCK WHERE
     3450                           buf_cli.obj-type = 'орг':U and
     3451                           buf_cli.obj-code = parhost-code No-ERROR.
     3452           if not avail buf_cli then do:
     3453               message vss-workfile vss-revision vss-description skip
     3454               view-as alert-box ERROR.
     3455               return.
     3456           end.
     3457           FIND FIRST ub.sysconf No-LOCK WHERE
     3458                             ub.sysconf.host-code = parhost-code No-ERROR.
     3459           if not avail ub.sysconf then do:
     3460               message vss-workfile vss-revision vss-description skip
     3461               view-as alert-box ERROR.
     3462               return.
     3463           end.
     3464           assign vhost-name = buf_cli.obj-name.
     3465       END.
     3466       WHEN 'объект':U then dO:
     3467           FIND FIRST buf_cli No-LOCK WHERE
     3468                           buf_cli.obj-type = parobj-type and
     3469                           buf_cli.obj-code = parobj-code No-ERROR.
     3470           if not avail buf_cli then do:
     3471               message vss-workfile vss-revision vss-description skip
     3472               view-as alert-box ERROR.
     3473               return.
     3474           end.
     3475       end.
     3476       WHEN "doc-type":U    THEN DO:
     3477           FIND FIRST buf_cli No-LOCK WHERE
     3478                           buf_cli.obj-type = 'орг':U and
     3479                           buf_cli.obj-code = parhost-code No-ERROR.
     3480           if not avail buf_cli then do:
     3481               message vss-workfile vss-revision vss-description skip
     3482               "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3483               parobj-type parobj-code
     3484               view-as alert-box ERROR.
     3485               return.
     3486           end.
     3487           if NOT (par-type = 'при':U or par-type = 'рас':U or par-type = 'инв':U or par-type = 'спи':U) then do:
     3488               message vss-workfile vss-revision vss-description skip
     3489               "Неверное значение параметра вызова par-type" par-type
     3490               view-as alert-box ERROR.
     3491               return.
     3492           end.
     3493       END.
     3494       WHEN "ext-doc-type":U    THEN DO:
