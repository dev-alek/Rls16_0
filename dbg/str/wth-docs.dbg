     3729                                   if error-status :error then do:       message "Ошибка при установке атрибутов документа." skip            error-status :get-message(1) skip return-value    view-as alert-box.    return error.    end.
     3730       create tt-upd-attr.  assign  tt-upd-attr.code =  'wthreceiver':U  .
     3731   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input tt-upd-attr.code ,
     3732                          output tt-upd-attr.type-attr ,
     3733                          output tt-upd-attr.format-attr ,
