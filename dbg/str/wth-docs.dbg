     1084   procedure wthcattr-sprcli :
     1085   define input parameter parparentproc  as widget-handle no-undo.
     1086   define input parameter p-mode  as character no-undo.
     1087   define input-output parameter p-value as character no-undo .
     1088   define output parameter p-setted as logical no-undo .
     1089     DEFINE VARIABLE v-value as character no-undo .
     1090     define variable v-cli-type as character no-undo .
     1091     define variable v-cli-code as integer no-undo .
     1092     define buffer buf_clients   for ub.clients.
     1093     define variable v_rid as character no-undo.
     1094     define variable ref-rec as recid no-undo .
     1095     do
     1096     on error undo, return error
     1097     :
     1098         v-value = p-value.
     1099      if p-value <> '':U then do:
     1100       assign
     1101       v-cli-type = substring(p-value, 1, 3)
     1102       v-cli-code = integer(substring(p-value, 4))
     1103       no-error.
     1104       if error-status:error then do:
     1105         assign
     1106         v-cli-type = '':U
     1107         v-cli-code = 0
     1108         .
     1109       end.
     1110      end.
     1111      FIND FIRST buf_clients NO-LOCK WHERE
     1112               buf_clients.obj-type = v-cli-type AND
     1113               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1114      IF available(buf_clients) then do:
     1115       run ref/cli-all.w (
     1116                   input parparentproc
     1117                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1118                  ,input v-cli-type
     1119                  ,input 'все':U
     1120                  ,input 'все':U
     1121                  ,input RECID( buf_clients )
     1122                  ,input ",,,,,,NO"
     1123                  ,input ?
     1124                  ,OUTPUT v_rid ).
     1125     END.
     1126     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1127       run ref/cli-all.w (
     1128                    input parparentproc
     1129                   ,INPUT "b-sel":U
     1130                  ,input  v-cli-type
     1131                  ,input 'все':U
     1132                  ,input 'текущие':U
     1133                  ,input ?
     1134                  ,input ",,,,,,NO"
     1135                  ,input ?
     1136                  ,OUTPUT v_rid ).
     1137     END.
     1138     else do:
     1139       message
     1140       if p-value = "":U then 'Атрибут не задан!'
     1141       else substitute('Не найден клиент &1',p-value)
     1142       view-as alert-box warning.
     1143     end.
     1144     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1145       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1146       IF ERROR-STATUS:ERROR THEN DO:
     1147           RETURN NO-APPLY.
     1148       END.
     1149       FIND FIRST buf_clients NO-LOCK WHERE
     1150                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1151       IF AVAIL buf_clients THEN DO:
     1152         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1153       end.
     1154     end.
     1155     if v-value <> p-value then do:
     1156       p-value = v-value.
     1157       p-setted = yes.
     1158     end.
     1159     end.
     1160   end procedure.
     1161     define new global shared variable g#wthcalib as handle no-undo.
     1162   define variable filter-label0 as character no-undo init "Движение матценностей" .
     1163   define variable filter-label as character no-undo init "Движение матценностей" .
     1164   define variable filter-point as character no-undo init "wth-docs" .
     1165   define variable filter-point0 as character no-undo init "wth-docs" .
     1166   define variable sort-column-name as character no-undo .
     1167   define variable v-rid-list as character no-undo .
     1168   define variable vcli-name like ub.clients.obj-name no-undo.
     1169   define variable vhost-name like ub.clients.obj-name no-undo.
     1170   define variable print-option as character no-undo.
     1171   define variable add-option as character no-undo.
     1172   define variable glog as logical no-undo .
     1173   define variable v-r-b-abbr like ub.currency.curr-abbr no-undo .
     1174   define variable v-doc-rec as recid no-undo .
     1175   define variable parext-doc-name as character no-undo.
     1176   define buffer buf_cli for ub.clients.
     1177   define buffer buf_obj for ub.clients .
     1178   define new shared buffer wth-doc for ub.wth-doc.
     1179   DEFINE MENU MENU-B-print
     1180          MENU-ITEM m_one          LABEL "Документ"
     1181          MENU-ITEM m_list         LABEL "Список"        .
     1182   DEFINE BUTTON B-add
     1183        LABEL "&Добавить"
     1184        SIZE 10 BY 1.
     1185   DEFINE BUTTON b-attr
     1186        LABEL "Атрибуты"
     1187        SIZE 10 BY 1.
     1188   DEFINE BUTTON b-auto
     1189        LABEL "По чекам"
     1190        SIZE 10 BY 1 TOOLTIP "Добавить документ по чекам МЦ".
     1191   DEFINE BUTTON B-chg
     1192        LABEL "&Изменить"
     1193        SIZE 10 BY 1.
     1194   DEFINE BUTTON B-close
     1195        LABEL "&Закрыть"
     1196        SIZE 10 BY 1.
     1197   DEFINE BUTTON B-del
     1198        LABEL "&Удалить"
     1199        SIZE 10 BY 1.
     1200   DEFINE BUTTON B-Help
     1201        LABEL "Помо&щь"
     1202        SIZE 3 BY 1
     1203        BGCOLOR 8 .
     1204   DEFINE BUTTON B-hist
     1205        LABEL "Ис&тория"
     1206        SIZE 3 BY 1.
     1207   DEFINE BUTTON b-lkp
     1208        LABEL "&Просмотр"
     1209        SIZE 10 BY 1.
     1210   DEFINE BUTTON B-mark
     1211        LABEL "&*"
     1212        SIZE 3 BY 1.
     1213   DEFINE BUTTON B-open
     1214        LABEL "&Открыть"
     1215        SIZE 10 BY 1.
     1216   DEFINE BUTTON B-print
     1217        LABEL "Пе&чать"
     1218        SIZE 3 BY 1.
     1219   DEFINE BUTTON b-quit AUTO-GO
     1220        LABEL "&Выход"
     1221        SIZE 8 BY 1
     1222        BGCOLOR 8 .
     1223   DEFINE BUTTON B-sch
     1224        LABEL "&Фильтр"
     1225        SIZE 3 BY 1.
     1226   DEFINE BUTTON B-sel AUTO-GO
     1227        LABEL "Вы&бор"
     1228        SIZE 10 BY 1.
     1229   DEFINE VARIABLE ED-notes AS CHARACTER
     1230        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1231        SIZE 98 BY 2
     1232        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1233   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1234         VIEW-AS TEXT
     1235        SIZE 4 BY 1
     1236        FGCOLOR 4  NO-UNDO.
     1237   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(14)":U
     1238        LABEL "номеру"
     1239        VIEW-AS FILL-IN
     1240        SIZE 12.5 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1241   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1242        LABEL "дате"
     1243        VIEW-AS FILL-IN
     1244        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1245   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999":U
     1246        LABEL "дате факт"
     1247        VIEW-AS FILL-IN
     1248        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1249   DEFINE VARIABLE v_creid AS CHARACTER FORMAT "X(256)":U
     1250        LABEL "Опер"
     1251         VIEW-AS TEXT
     1252        SIZE 14 BY .71
     1253        FGCOLOR 4  NO-UNDO.
     1254   DEFINE VARIABLE v_deliver AS CHARACTER FORMAT "X(256)":U
     1255        LABEL "Передал"
     1256         VIEW-AS TEXT
     1257        SIZE 14 BY .71
     1258        FGCOLOR 4  NO-UNDO.
