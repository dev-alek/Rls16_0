      363   procedure fltfield-clear :
      364     define output parameter loc-fld as character no-undo.
      365     define output parameter loc-lab as character no-undo .
      366     define output parameter loc-spr as character no-undo .
      367     define output parameter loc-dim as character no-undo .
      368     assign
      369       loc-fld = ""
      370       loc-lab = ""
      371       loc-spr = ""
      372       loc-dim = "0"
      373     .
      374   end procedure .
      375   procedure fltfield-add :
      376     define input        parameter par-fld as character no-undo.
      377     define input        parameter par-lab as character no-undo .
      378     define input        parameter par-spr as character no-undo .
      379     define input-output parameter loc-fld as character no-undo.
      380     define input-output parameter loc-lab as character no-undo .
      381     define input-output parameter loc-spr as character no-undo .
      382     define input-output parameter loc-dim as character no-undo .
      383     do
      384     on error undo, return error
      385     :
      386       assign
      387       loc-fld = if loc-dim = '0'
      388                 then par-fld
      389                 else (loc-fld + chr(44) + par-fld)
      390       loc-lab = if loc-dim = '0'
      391                 then par-lab
      392                 else (loc-lab + chr(44) + par-lab)
      393       loc-spr = if loc-dim = '0'
      394                 then par-spr
      395                 else (loc-spr + chr(44) + par-spr)
      396       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      397                 string(integer(if num-entries(loc-dim) > 1
      398                               then entry(2, loc-dim)
      399                               else entry(1, loc-dim)
      400                               ) + 1)
      401       no-error
      402       .
      403     end.
      404   end procedure.
      405   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   define  stream PrnLibStream.
      407   procedure prn-lib-prn-file :
      408     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      409     define input parameter p-DIsabledoptions as integer no-undo .
      410     define variable v-report-name as character no-undo .
      411     define variable v-user-action as character no-undo .
      412     define variable v-printed     as logical   no-undo .
      413     define variable v-exist       as logical   no-undo .
      414     do
      415       on error undo, return error
      416       :
      417       run prn-lib-get-report-name  in this-procedure (
      418         input parParentProc
      419         ,output v-report-name
      420         ).
      421   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      423     (input  v-report-name
      424     ,input  2
      425     ,output v-exist
      426     )  .
      427       if NOT v-exist then
      428       DO:
      429         Message
      430           "Нет заданий на печать ! "
      431           view-as alert-box .
      432         Return  .
      433       End.
      434       run gbl/prnfilen.w
      435         (input  ""
      436         ,input  p-DisabledOptions
      437         ,input  string(v-report-name )
      438         ,input  7
      439         ,output v-user-action
      440         ,output v-printed
      441         ) .
      442       if v-printed then
      443       do:
      444         return "YES" .
      445       end.
      446       else
      447       do:
      448         return "NO" .
      449       end.
      450     end.
      451   end procedure.
      452   procedure prn-lib-open-stream :
      453     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      454     define input parameter p-page-size    as integer no-undo .
      455     define input parameter p-is-stream    as logical no-undo .
      456     define input parameter p-append       as logical no-undo .
      457     define variable v-report-name as character no-undo .
      458     do
      459       on error undo, return error
      460       :
      461       run prn-lib-get-report-name  in this-procedure (
      462         input parParentProc
      463         ,output v-report-name
      464         ).
      465       if p-is-stream then
      466       do:
      467         if p-append then
      468         do:
      469           output stream PrnLibStream to value( v-report-name )
      470             page-size value(p-page-size) append .
      471         end.
      472         if not p-append then
      473         do:
      474           output stream PrnLibStream to value( v-report-name )
      475             page-size value(p-page-size) .
      476         end.
      477       end.
      478       if not p-is-stream then
      479       do:
      480         if p-append then
      481         do:
      482           output to value( v-report-name )
      483             page-size value(p-page-size) append .
      484         end.
      485         if not p-append then
      486         do:
      487           output to value( v-report-name )
      488             page-size value(p-page-size) .
      489         end.
      490       end.
      491     end.
      492   end procedure.
      493   procedure prn-lib-open-exp :
      494     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      495     define input parameter p-is-stream    as logical no-undo .
      496     define input parameter p-is-append    as logical no-undo .
      497     define output parameter p-ReportFileName as char init "report" no-undo.
      498     define output parameter p-process as logical no-undo .
      499     define variable glog as logical no-undo .
      500     do
      501       on error undo, return error
      502       :
      503       SYSTEM-DIALOG GET-FILE p-ReportFileName
      504         TITLE      "Укажите путь"
      505         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      506         ASK-OVERWRITE
      507         CREATE-TEST-FILE
      508         SAVE-AS
      509         USE-FILENAME
      510         DEFAULT-EXTENSION "txt"
      511         UPDATE glog
      512         .
      513       if not glog then  return.
      514       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      515       if p-is-stream then
      516       do:
      517         if p-is-append then
      518         do:
      519           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      520         end.
      521         else
      522         do:
      523           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      524         end.
      525       end.
      526       else
      527       do:
      528         if p-is-append then
      529         do:
      530           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      531         end.
      532         else
      533         do:
      534           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      535         end.
      536       end.
      537       p-process = yes.
      538     end.
      539   end procedure.
      540   procedure prn-lib-get-report-name :
      541     define input parameter parParentProc  as widget-handle no-undo.
      542     define output parameter p-report-name as character no-undo .
      543     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      544   end procedure.
      545   procedure prn-lib-reportviewer-report-name :
      546     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      547     define input parameter p-report-name-html as character no-undo .
      548     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      549   end procedure.
      550   procedure prn-lib-reportviewer :
      551     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      552     define input parameter p-report-name-html as character no-undo .
      553     define input parameter p-param        as character no-undo .
      554     define variable v-excel           as character no-undo init 'TRUE' .
      555     define variable v-value-character as character no-undo .
      556     define variable v-value-integer   as character no-undo .
      557     define variable v-value-date      as date      no-undo .
      558     define variable v-value-decimal   as decimal   no-undo .
      559     define variable rep-excel         as logical   no-undo .
      560     define variable excel-string      as character no-undo .
      561     define variable v-param-type      as character no-undo .
      562     define variable v-tth             as handle    no-undo .
      563     run adm/shattri.p (
      564       input "get":U
      565       ,input  ""
      566       ,input  0
      567       ,input  'report-glob':U
      568       ,input  'rep-excel':U
      569       ,output v-value-character
      570       ,output v-value-date
      571       ,output v-value-decimal
      572       ,output v-value-integer
      573       ,output rep-excel
      574       ,output v-param-type
      575       ,INPUT-OUTPUT table-handle v-tth
      576       )  .
      577     if rep-excel then v-excel = "TRUE" .
      578     else v-excel = "FALSE" .
      579     if p-param eq ""
      580     then
      581        p-param = "EXCEL:" + v-excel.
      582     else
      583        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      584     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      585   end procedure.
      586   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   define variable v-waitfram-action01         as character   no-undo .
      588   define variable v-waitfram-action02         as character   no-undo .
      589   define variable v-waitfram-action03         as character   no-undo .
      590   define variable mWaitFramTextBeg            as character   no-undo.
      591   define variable mWaitFramTextEnd            as character   no-undo.
      592   define variable mWaitFramView               as logical     no-undo.
      593   define variable mWaitProcEvent              as logical     no-undo init yes.
      594   define variable mWaitFramInterval           as integer     no-undo init 1 .
      595   define variable mWaitFramStop               as logical     no-undo.
      596   define variable mWaitFramStopUser           as logical     no-undo.
      597   define variable mWaitFramStopTimeOut        as logical     no-undo.
      598   define variable mWaitFramStartProc          as datetime-tz no-undo.
      599   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      600   define button B-WaitFramStop auto-end-key
      601        label "Стоп"
      602        size 10 by 1 tooltip "Остоновить процесс".
      603   define button B-viewProcInfo
      604        label "Информация"
      605        size 15 by 1 tooltip "Информация о процесс".
      606   define frame waitfram
      607     v-waitfram-action01 format "x(72)" no-label skip
      608     v-waitfram-action02 format "x(72)" no-label skip
      609     v-waitfram-action03 format "x(72)" no-label skip
      610     B-viewProcInfo
      611     B-WaitFramStop at row 4 col 30
      612     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      613     .
      614   define new global shared variable mBatchMode as logical no-undo init ?.
      615   define variable mFramBachModHandle as handle no-undo.
      616   mFramBachModHandle = frame waitfram:handle.
      617   define variable mFameOldVis as logical no-undo.
      618   define variable mVisCUrentVin as logical no-undo.
      619   if session:batch-mode
      620   then
      621      mBatchMode = yes.
      622   if mBatchMode = ? then do:
      623     mVisCUrentVin = current-window:visible.
      624     mFameOldVis = mFramBachModHandle:visible.
      625     mFramBachModHandle:visible  = yes.
      626     mBatchMode = mFramBachModHandle:visible ne yes.
      627     mFramBachModHandle:visible = mFameOldVis.
      628     current-window:visible = mVisCUrentVin.
      629   end.
      630    if  log-manager:logfile-name ne ?
      631     then DO:
      632         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      633         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      634         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      635     end.
      636   on choose of B-WaitFramStop in frame waitfram
      637   do:
      638     mWaitFramStop = yes.
      639     mWaitFramStopUser = yes.
      640   end.
      641   function waitfram-check-timeout returns logical():
      642      define variable vtime as int64 no-undo.
      643      if mWaitFramStopTimeOut
      644      then
      645         return yes.
      646      vtime = ( now - mWaitFramStartProc ) / 1000 .
      647      if     mWaitFramTimeOut ne ?
      648         and mWaitFramTimeOut ne 0
      649         and mWaitFramTimeOut lt vtime
      650      then do:
      651         mWaitFramStopTimeOut = yes.
      652      end.
      653      return mWaitFramStopTimeOut.
      654   end.
      655   procedure waitfram-hide :
      656     if not session:batch-mode
      657     then do
      658     on error undo, return error return-value
      659     :
      660       pause 0 before-hide .
      661       if not mBatchMode then
      662         hide frame waitfram .
      663     if     not mWaitFramView
      664        and mWaitProcEvent
      665     then
      666       process events .
      667     end.
      668   end procedure.
      669   procedure waitfram-show :
      670     define input  parameter p-message as character no-undo .
      671     define variable v-left-margin as integer   no-undo .
      672     if not session:batch-mode
      673     then do
      674     on error undo, return error return-value
      675     :
      676       if length(p-message) <= 70 then do:
      677         assign
      678           v-left-margin = integer((70 - length(p-message)) / 2)
      679         .
      680         assign
      681           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      682         .
      683         assign
      684           v-waitfram-action01 = " "
      685           v-waitfram-action02 = " "
      686                                    + fill(" ", v-left-margin)
      687                                    + p-message
      688           v-waitfram-action03 = " "
      689         .
      690       end.
      691       else do:
      692         define variable vRindex1 as integer no-undo.
      693         define variable vRindex2 as integer no-undo.
      694         vRindex1 = r-index(p-message," ",70).
      695         if vRindex1 = 0
      696         then
      697            vRindex1 = 70.
      698         if length(p-message)  <= vRindex1 + 70 then do:
      699           assign
      700             v-waitfram-action01 = " "
      701             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      702             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      703           .
      704         end.
      705         else do:
      706           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      707           if vRindex2 <= vRindex1
      708           then
      709              vRindex2 = vRindex1 + 70.
      710           assign
      711             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      712             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      713             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      714           .
      715         end.
      716       end.
      717       B-viewProcInfo:visible   in frame waitfram = no.
      718       B-viewProcInfo:sensitive in frame waitfram = no.
      719       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      720       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      721       if  (   mWaitFramView
      722          or  mWaitProcEvent)
      723          and not mBatchMode
      724       then
      725          display
      726             v-waitfram-action01 skip
      727             v-waitfram-action02 skip
      728             v-waitfram-action03 skip
      729          with frame waitfram .
      730       if     mWaitFramView
      731          then do:
      732             if     mWaitFramInterval ne ?
      733                and not mBatchMode
      734             then
      735                wait-for go of frame waitfram pause mWaitFramInterval.
      736          end.
      737          else
      738             if     mWaitProcEvent
      739                and not mBatchMode
      740             then
      741                process events .
      742     end.
      743   end procedure.
      744      procedure waitfram-show-this:
      745         define input  parameter iInterval as int64 no-undo.
      746         define variable vtime as int64 no-undo.
      747         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      748         mWaitFramInterval = iInterval.
      749         run waitfram-show (substitute("&1&2 &3&4" ,
      750                                       mWaitFramTextBeg ,
      751                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      752                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      753                                       mWaitFramTextEnd
      754                                      )
      755                           ).
      756      end.
      757      procedure WaitFramRunPause:
      758         define input  parameter iInterval as dec no-undo.
      759         define variable vStart  as datetime-tz no-undo.
      760         define variable vend    as datetime-tz no-undo.
      761         define variable vint as int64 no-undo.
      762         define variable vOk as logical no-undo.
      763         vStart = now.
      764         vend   = vStart.
      765         publish "WaitFramPause" (iInterval,output vOk).
      766         vend   =  now.
      767         vint = vend - vStart.
      768         vint = iInterval - vint / 1000.
      769         if     not mWaitFramStop
      770            and (   vint > 0
      771                 or (    not vOk
      772                     and iInterval eq ?
      773                     )
      774                 )
      775         then
      776            run waitfram-show-this (iInterval).
      777         vend   =  now.
      778         vint = vend - vStart.
      779         vint = iInterval - vint / 1000.
      780         if     not mWaitFramStop
      781            and vint > 0
      782         then do:
      783            run gbl/pause.p (vint * 1000).
      784         end.
      785         if iInterval ne ?
      786         then
      787            publish "WaitFramStop".
      788         waitfram-check-timeout().
      789      end.
      790      procedure WaitFramWaitFor:
      791         define input  parameter iInterval as dec no-undo.
      792         assign
      793            mWaitFramStartProc   = now
      794            mWaitFramStopUser    = no
      795            mWaitFramStopTimeOut = no
      796         .
      797         block-wait:
      798         do while not mWaitFramStop:
      799            run WaitFramRunPause (iInterval).
      800            if  waitfram-check-timeout()
      801            then do:
      802               leave block-wait.
      803            end.
      804         end.
      805         run waitfram-hide.
      806      end.
      807   procedure waitfram-join :
      808     define input  parameter p-line-1  as character no-undo .
      809     define input  parameter p-line-2  as character no-undo .
      810     define input  parameter p-line-3  as character no-undo .
      811     define output parameter p-message as character no-undo .
      812     do
      813     on error undo, return error return-value
      814     :
      815       assign
      816         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      817                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      818                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      819       .
      820     end.
      821   end procedure.
      822   function waitfram-join-function returns character
      823     (input p-line-1 as character
      824     ,input p-line-2 as character
      825     ,input p-line-3 as character
      826     ).
      827     define variable v-message as character no-undo .
      828     run waitfram-join in this-procedure
      829       (input  p-line-1
      830       ,input  p-line-2
      831       ,input  p-line-3
      832       ,output v-message
      833       ) .
      834     return v-message .
      835   end function .
