      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable c-point  as character no-undo .
      127   define variable tbl      as character no-undo .
      128   define variable join-tbl as character no-undo .
