     1260        LABEL "Исп"
     1261         VIEW-AS TEXT
     1262        SIZE 14 BY .71
     1263        FGCOLOR 4  NO-UNDO.
     1264   DEFINE VARIABLE v_receiver AS CHARACTER FORMAT "X(256)":U
     1265        LABEL "Получил"
     1266         VIEW-AS TEXT
     1267        SIZE 14 BY .79
     1268        FGCOLOR 4  NO-UNDO.
     1269   DEFINE VARIABLE rs-auto AS INTEGER
     1270        VIEW-AS RADIO-SET HORIZONTAL
     1271        RADIO-BUTTONS
     1272             "Все", 1,
     1273   "По чекам", 2,
     1274   "Созд. вручную", 3
     1275        SIZE 40.5 BY 1 NO-UNDO.
     1276   DEFINE NEW SHARED QUERY BR-docs FOR
     1277                   X_wth-doc SCROLLING.
     1278   DEFINE BROWSE BR-docs
     1279     QUERY BR-docs NO-LOCK DISPLAY
     1280         mark-string( recid(X_wth-doc), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1281   X_wth-doc.doc-type COLUMN-LABEL "Т" FORMAT "X(1)":U
     1282   X_wth-doc.status_  COLUMN-LABEL "Стат" FORMAT "X(4)":U
     1283   X_wth-doc.doc-code  FORMAT "X(12)":U  COLUMN-LABEL "№ документа"
     1284   X_wth-doc.fact-date FORMAT "99/99/99":U
     1285   X_wth-doc.doc-date  FORMAT "99/99/99":U
     1286   shift-name-no-err(buffer X_wth-doc) COLUMN-LABEL "№" FORMAT "X(3)":U
     1287   (substring ((string (X_wth-doc.shift-date)), 1, 5)) COLUMN-LABEL "Смена" FORMAT "X(5)":U
     1288   X_wth-doc.inter_ COLUMN-LABEL "В" FORMAT "+/":U
     1289   X_wth-doc.exter_ COLUMN-LABEL "Ш" FORMAT "+/":U
     1290   X_wth-doc.auto-fill COLUMN-LABEL "А" FORMAT "+/":U
     1291   X_wth-doc.cli-name FORMAT "X(20)":U
     1292   X_wth-doc.fact-sum FORMAT "->>,>>>,>>9.99":U COLUMN-LABEL "Кол-во "WIDTH 11
     1293   X_wth-doc.sum-gds-rubl COLUMN-LABEL "Сумма (тов)" FORMAT "->>>,>>>,>>9.99":U WIDTH 12
     1294   X_wth-doc.doc-sum  COLUMN-LABEL "Кол-во(док)" FORMAT "->>,>>>,>>9.99":U
     1295   X_wth-doc.sum-gds-base FORMAT "->>>,>>>,>>9.99":U COLUMN-LABEL "Сумма по тов. (баз. вал.)"
     1296   (trim (X_wth-doc.obj-type) + " " + string (X_wth-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1297   X_wth-doc.source-type + chr(32) + X_wth-doc.source-ref COLUMN-LABEL "На документ" FORMAT "X(20)":U
     1298   X_wth-doc.bge-date COLUMN-LABEL "Внеш.пров." FORMAT "99/99/99":U
     1299   ENABLE
     1300   X_wth-doc.bge-date
     1301       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14.25.
     1302   DEFINE FRAME Dialog-Frame
     1303        b-quit AT ROW 1 COL 1.13
     1304        B-mark AT ROW 1 COL 9
     1305        B-sel AT ROW 1 COL 16
     1306        B-add AT ROW 1 COL 26
     1307        b-lkp AT ROW 1 COL 36
     1308        B-chg AT ROW 1 COL 46
     1309        B-del AT ROW 1 COL 56
     1310        B-close AT ROW 1 COL 66
     1311        B-open AT ROW 1 COL 76
     1312        B-sch AT ROW 1 COL 86
     1313        B-print AT ROW 1 COL 89
     1314        B-hist AT ROW 1 COL 92
     1315        B-Help AT ROW 1 COL 95
     1316        b-auto AT ROW 2 COL 26 WIDGET-ID 2
     1317        b-attr AT ROW 2 COL 36 WIDGET-ID 10
     1318        rs-auto AT ROW 3.25 COL 1 NO-LABEL WIDGET-ID 4
     1319        BR-docs AT ROW 4.25 COL 1.13
     1320        ED-notes AT ROW 19.75 COL 1 NO-LABEL
     1321        sch-code AT ROW 22 COL 19 COLON-ALIGNED
     1322        sch-date AT ROW 22 COL 46 COLON-ALIGNED
     1323        sch-fact AT ROW 22 COL 77.5 COLON-ALIGNED
     1324        mark-num AT ROW 1 COL 10 COLON-ALIGNED NO-LABEL
     1325        v_operator AT ROW 18.75 COL 5 COLON-ALIGNED
     1326        v_deliver AT ROW 18.75 COL 30 COLON-ALIGNED
     1327        v_receiver AT ROW 18.75 COL 55 COLON-ALIGNED
     1328        v_creid AT ROW 18.75 COL 80 COLON-ALIGNED
     1329        "ПОИСК ПО" VIEW-AS TEXT
     1330             SIZE 9.25 BY 1 AT ROW 22 COL 1.5
     1331             FGCOLOR 4
     1332        SPACE(88.54) SKIP(0.19)
     1333       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1334            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1335            TITLE "Движение материальных ценностей"
     1336            DEFAULT-BUTTON b-lkp.
     1337   ASSIGN
     1338          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1339          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1340   ASSIGN
     1341          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1342   ON GO OF FRAME Dialog-Frame
     1343   DO:
     1344     p-rid-list = v-rid-list.
     1345   END.
     1346   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1347   DO:
     1348     APPLY "END-ERROR":U TO SELF.
     1349   END.
     1350   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1351   DO:
     1352   define variable v-doc-rec as recid no-undo .
     1353   define variable next-prev as character no-undo .
     1354     if lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") > 0 or parext-type = '':U then do:
     1355       message 'Добавить документ в данном режиме невозможно' view-as alert-box.
     1356       return no-apply.
     1357     end.
     1358   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   do:
     1360     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1361       (input  v-cntxt-db-num
     1362       ,input  v-cntxt-userid
     1363       ,input  0
     1364       ,input  'actn_wth-doc_add-def':U
     1365       ,input  'object':U
     1366       ,input  parhost-code
     1367       ,input  parobj-type
     1368       ,input  parobj-code
     1369       ,input  0
     1370       ,input  0
     1371       ,input  0
     1372       ,input  true
     1373       ,output glog
     1374       )  .
     1375   end.
     1376     IF glog <> YES THEN DO:
     1377       add-option = "":U.
     1378       RETURN NO-APPLY.
     1379     END.
     1380     ASSIGN
     1381     v-doc-rec = RECID( X_wth-doc )
     1382     .
     1383       CASE par-type :
     1384       WHEN 'при':U OR
     1385       WHEN 'рас':U OR
     1386       WHEN 'спи':U OR
     1387       WHEN 'обмен':U OR
     1388       when 'декл':U thEN DO:
     1389           run str/wth-inc.w (
     1390                            INPUT parparentproc
     1391                           ,INPUT 'ДОБАВЛЕНИЕ':U
     1392                           ,INPUT parhost-code
     1393                           ,INPUT parobj-type
     1394                           ,INPUT parobj-code
     1395                           ,INPUT parcli-type
     1396                           ,INPUT parcli-code
     1397                           ,INPUT parext-type
     1398                           ,INPUT par-type
     1399                           ,INPUT (add-option = "auto":U )
     1400                           ,INPUT-OUTPUT v-doc-rec
     1401                           ,input ?
     1402                           ,input-output next-prev
     1403                           ).
     1404       END.
     1405       WHEN 'инв':U THEN DO:
     1406           run str/wth-inv.w (
     1407                           INPUT parparentproc
     1408                           ,INPUT 'ДОБАВЛЕНИЕ':U
     1409                           ,INPUT parhost-code
     1410                           ,INPUT parobj-type
     1411                           ,INPUT parobj-code
     1412                           ,INPUT parcli-type
     1413                           ,INPUT parcli-code
     1414                           ,INPUT parext-type
     1415                           ,INPUT (add-option = "auto":U )
     1416                           ,INPUT-OUTPUT v-doc-rec
     1417                           ,input ?
     1418                           ,input-output next-prev
     1419                         ).
     1420       END.
     1421     END CASE.
     1422     add-option = "":U.
     1423     if v-doc-rec <> ? then do:
     1424       RUN OpenBr in this-procedure ( input yes
     1425                                    , input no
     1426                                    , input '':U).
     1427       reposition br-docs to recid v-doc-rec no-error.
     1428     end.
     1429     APPLY "Value-CHanged" to br-docs.
     1430     APPLY "ENTRY" to br-docs.
     1431   END.
     1432   ON CHOOSE OF b-attr IN FRAME Dialog-Frame
     1433   DO:
     1434     if not avail X_wth-doc then return no-apply.
     1435     run init-attr-general in this-procedure no-error .
     1436     if error-status:error then do:
     1437       message return-value skip
     1438       error-status:get-message(1)
     1439       view-as alert-box.
     1440     end.
     1441     IF not (lookup('b-add':U, bttns) > 0 and (par-mode = 'ext-doc-type':U) and ub.sys-ctrl.db-num = buf_obj.db-num  ) THEN DO:
     1442       run str/wthdattr.w (input parparentproc,
     1443                           input "b-lkp",
     1444                           input X_wth-doc.doc-code,
     1445                           input table tt-upd-attr) no-error.
     1446     END.
     1447     else if X_wth-doc.STATUS_ = 'факт':U then do:
     1448        run str/wthdattr.w (input parparentproc,
     1449                            input "b-lkp,b-chg,b-add,b-del",
     1450                            input X_wth-doc.doc-code,
     1451                            input table tt-upd-attr) no-error.
     1452     end.
     1453     else do:
     1454        run str/wthdattr.w (input parparentproc,
     1455                            input "b-lkp,b-chg,b-add,b-del,no-news",
     1456                            input X_wth-doc.doc-code,
     1457                            input table tt-upd-attr) no-error.
     1458     end.
     1459     if error-status:error then do:
     1460       message return-value skip
     1461       error-status:get-message(1)
     1462       view-as alert-box.
     1463     end.
     1464   END.
     1465   ON CHOOSE OF b-auto IN FRAME Dialog-Frame
     1466   DO:
     1467     assign
     1468     add-option = 'auto':U.
     1469     APPLY "CHOOSE" to b-add in frame Dialog-Frame.
     1470   END.
     1471   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1472   DO:
     1473   define variable v-doc-rec as recid no-undo .
     1474   define variable next-prev as character no-undo .
     1475    define buffer check_wth-doc for ub.wth-doc .
     1476      if not avail X_wth-doc then return no-apply.
     1477   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   do:
     1479     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1480       (input  v-cntxt-db-num
     1481       ,input  v-cntxt-userid
     1482       ,input  0
     1483       ,input  'actn_wth-doc_update':U
     1484       ,input  'object':U
     1485       ,input  parhost-code
     1486       ,input  parobj-type
     1487       ,input  parobj-code
     1488       ,input  0
     1489       ,input  0
     1490       ,input  0
     1491       ,input  true
     1492       ,output glog
     1493       )  .
     1494   end.
     1495     IF glog <> YES THEN DO:
     1496       RETURN NO-APPLY.
     1497     END.
     1498     do on stop undo, return no-apply:
     1499       FIND FIRST check_wth-doc where
     1500                 recid(check_wth-doc) = RECID(X_wth-doc) No-ERROR.
     1501       if not avail check_WTH-DOC THEN DO:
     1502           RETURN NO-APPLY.
     1503       END.
     1504       IF CHECK_WTH-DOC.STATUS_ = 'факт':U THEN Do:
     1505           message "Документ движения МЦ с N " check_wth-doc.doc-code  " имеет статус " check_wth-doc.status_ SKIP
     1506                   "Изменения не допускаются"
     1507           view-as alert-box error.
     1508           return no-apply.
     1509       end.
     1510       if  check_wth-doc.doc-type = 'возврат':U then do:
     1511           message  substitute("Изменение документов с типом &1 не допускается!",'возврат':U)
     1512           view-as alert-box error.
     1513           return no-apply.
     1514       end.
     1515       if  parobj-type <> check_wth-doc.obj-type
     1516       or parobj-code <> check_wth-doc.obj-code then do:
     1517               message  "Документ может быть изменен только на активной стороне!"
     1518                   view-as alert-box ERROR.
     1519                   return no-apply.
     1520       end.
     1521       ASSIGN
     1522       v-doc-rec = RECID( X_wth-doc )
     1523       .
     1524       CASE X_wth-doc.doc-type :
     1525         WHEN 'при':U OR
     1526         WHEN 'рас':U OR
     1527         when 'возврат':U  OR
     1528         WHEN 'обмен':U OR
     1529         WHEN 'спи':U THEN DO:
     1530             run str/wth-inc.w (
     1531                             INPUT parparentproc
     1532                             ,INPUT 'ИЗМЕНЕНИЕ':U
     1533                             ,INPUT parhost-code
     1534                             ,INPUT parobj-type
     1535                             ,INPUT parobj-code
     1536                             ,INPUT X_wth-doc.cli-type
     1537                             ,INPUT X_wth-doc.cli-code
     1538                             ,INPUT X_wth-doc.ext-doc-type
     1539                             ,INPUT X_wth-doc.doc-type
     1540                             ,INPUT X_wth-doc.auto-fill
     1541                             ,INPUT-OUTPUT v-doc-rec
     1542                             ,input ?
     1543                             ,INPUT-OUTPUT next-prev
     1544                               ) no-error .
     1545         END.
     1546         WHEN 'инв':U THEN DO:
     1547                   run str/wth-inv.w (
     1548                             INPUT parparentproc
     1549                             ,INPUT 'ИЗМЕНЕНИЕ':U
     1550                             ,INPUT parhost-code
     1551                             ,INPUT parobj-type
     1552                             ,INPUT parobj-code
     1553                             ,INPUT X_wth-doc.cli-type
     1554                             ,INPUT X_wth-doc.cli-code
     1555                             ,INPUT X_wth-doc.ext-doc-type
     1556                             ,INPUT X_wth-doc.auto-fill
     1557                             ,INPUT-OUTPUT v-doc-rec
     1558                             ,input ?
     1559                             ,INPUT-OUTPUT next-prev
     1560                           ) no-error .
     1561                           if error-status:error then message return-value.
     1562         END.
     1563       END CASE.
     1564     end.
     1565     ASSIGN glog = br-docs:REFRESH( ).
     1566     reposition br-docs to recid v-doc-rec No-ERROR.
     1567     APPLY "Value-CHanged" to br-docs.
     1568     APPLY "ENTRY" to br-docs.
     1569   END.
     1570   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     1571   DO:
     1572     if not avail X_wth-doc then return no-apply.
     1573     run proc-b-close in this-procedure  ( input self:name) no-error.
     1574     if error-status:error then return no-apply.
     1575   END.
     1576   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1577   DO:
     1578     define variable glog as logical no-undo .
     1579     define variable v-chip-num as integer no-undo .
     1580     define buffer buf_wth-doc for ub.wth-doc.
     1581     define buffer buf_out_wth-doc for ub.wth-doc.
     1582     define variable v-user-action    as character no-undo.
     1583     define variable v-printed        as logical   no-undo.
     1584     define variable v-proc-name-err    as character    no-undo.
     1585     define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
     1586     find first buf_wth-doc exclusive-lock where
     1587     recid(buf_wth-doc) = recid(X_wth-doc) NO-ERROR.
     1588     if not avail buf_wth-doc then return no-apply.
     1589     IF buf_wth-doc.status_ <> 'факт':U
     1590       and buf_wth-doc.status_ <> 'накл':U THEN DO:
     1591        message
     1592        substitute("Документы перемещения МЦ можно удалять только в статусах &1 и &2"
     1593                   , 'накл':U
     1594                   , 'факт':U)
     1595       view-as alert-box error .
     1596       return no-apply.
     1597     end.
     1598     if not (buf_wth-doc.obj-type = parobj-type and
     1599             buf_wth-doc.obj-code = parobj-code)  then do:
     1600         message "Документ можно удалять только на объекте создания!"
     1601         view-as alert-box error.
     1602         return no-apply.
     1603     end.
     1604   v-proc-name-err = string(session:TEMP-DIRECTORY) + '/delWdoc.err':U .
     1605   if search (v-proc-name-err) <> ? then do:
     1606     os-delete value(v-proc-name-err).
     1607   end.
     1608     IF buf_wth-doc.status_ = 'факт':U
     1609     THEN DO:
     1610   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611   do:
     1612     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1613       (input  v-cntxt-db-num
     1614       ,input  v-cntxt-userid
     1615       ,input  0
     1616       ,input  'actn_wth-doc_del-fact':U
     1617       ,input  'object':U
     1618       ,input  parhost-code
     1619       ,input  parobj-type
     1620       ,input  parobj-code
     1621       ,input  0
     1622       ,input  0
     1623       ,input  0
     1624       ,input  true
     1625       ,output glog
     1626       )  .
     1627   end.
     1628       IF glog <> YES
     1629       THEN DO:
     1630         RETURN NO-APPLY.
     1631       END.
     1632       if buf_wth-doc.borned = yes then do:
     1633          message
     1634          substitute("Данный документ МЦ &1 порожден другим документом &2&3" +
     1635                     "для удаления связки документов выберите для удаления документ МЦ &2"
     1636                     , buf_wth-doc.doc-code
     1637                     , buf_wth-doc.source-ref
     1638                     , chr(10)
     1639                     )
     1640          view-as alert-box error .
     1641          RETURN NO-APPLY.
     1642       end.
     1643       if buf_wth-doc.ext-doc-type = 'ci':U
     1644       or buf_wth-doc.ext-doc-type = 'ce':U then do:
     1645          message
     1646          substitute("Документы МЦ с типом &1 и типом &2 удаляются при удалении создавшего их отчета о продаже"
     1647                     ,'возврат покупателю через кассы':U
     1648                     ,'приход внешний через кассы':U )
     1649          view-as alert-box error .
     1650          RETURN NO-APPLY.
     1651       end.
     1652       MESSAGE
     1653       "Документ перемещения МЦ закрыт на факт" skip
     1654       "Вы действительно хотите его удалить?"
     1655       VIEW-AS ALERT-BOX QUESTION buttons YES-NO update glog.
     1656       if not glog then    RETURN NO-APPLY.
     1657          run waitfram-show in this-procedure ( input "Ждите..." ).
     1658          run trg/wthdocdl.p ( input buf_wth-doc.doc-code
     1659                             ,input  ?
     1660                             ,input v-proc-name-err
     1661                             ,output v-chip-num) no-error.
     1662          if error-status:error then do:
     1663           run waitfram-hide in this-procedure .
     1664           message vss-workfile vss-revision vss-description skip
     1665           "Ошибка удаления документа МЦ" skip
     1666           error-status:get-message(1) skip
     1667           return-value skip
     1668           view-as alert-box error title 'Ошибка удаления'.
     1669           if search (v-proc-name-err) <> ? then do:
     1670            run gbl/prnfilen.w
     1671              (input  "Ошибки при закрытии документа"
     1672              ,input  0
     1673              ,input  v-proc-name-err
     1674              ,input  7
     1675              ,output v-user-action
     1676              ,output v-printed
     1677              ).
     1678           end.
     1679           return no-apply.
     1680          end.
     1681     END.
     1682     else if buf_wth-doc.status_ = 'накл':U
     1683     then do:
     1684   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   do:
     1686     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1687       (input  v-cntxt-db-num
     1688       ,input  v-cntxt-userid
     1689       ,input  0
     1690       ,input  'actn_wth-doc_deletion':U
     1691       ,input  'object':U
     1692       ,input  parhost-code
     1693       ,input  parobj-type
     1694       ,input  parobj-code
     1695       ,input  0
     1696       ,input  0
     1697       ,input  0
     1698       ,input  true
     1699       ,output glog
     1700       )  .
     1701   end.
     1702       IF glog <> YES
     1703       THEN DO:
     1704         RETURN NO-APPLY.
     1705       END.
     1706       MESSAGE "Вы уверены, что хотите удалить документ?" VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1707       IF glog <> YES THEN DO:
     1708         RETURN NO-APPLY.
     1709       END.
     1710       if buf_wth-doc.borned = yes then do:
     1711          message
     1712          substitute("Данный документ МЦ &1 порожден другим документом &2&3" +
     1713                     "для удаления связки документов выберите для удаления документ МЦ &2"
     1714                     , buf_wth-doc.doc-code
     1715                     , buf_wth-doc.source-ref
     1716                     , chr(10)
     1717                     )
     1718          view-as alert-box error .
     1719          RETURN NO-APPLY.
     1720       end.
     1721       for each ub.chk-doc EXCLUSIVE-LOCK WHERE
     1722               ub.chk-doc.out-code = buf_wth-doc.doc-code
     1723               and  lookup(string(ub.chk-doc.chk-type),'2,3,4,5,7':U )  > 0
     1724       ON ERROR UNDO, return no-apply
     1725       ON STOP UNDO, return no-apply
     1726               :
     1727         FOR each ub.chk-pay exclusive-lock where
     1728               ub.chk-pay.doc-code = ub.chk-doc.doc-code:
     1729           ub.chk-pay.out-code = ?.
     1730         END.
     1731         ub.chk-doc.out-code = ?.
     1732       END.
     1733       for each buf_inkas-pay-wth exclusive-lock where
     1734               buf_inkas-pay-wth.inkas-code = buf_wth-doc.doc-code
     1735       ON ERROR UNDO, return no-apply
     1736       ON STOP UNDO, return no-apply
     1737       :
     1738          delete buf_inkas-pay-wth.
     1739       end.
     1740       DELETE buf_wth-doc no-error.
     1741       if error-status:error then do:
     1742         run waitfram-hide in this-procedure .
     1743         message return-value skip error-status:get-message(1)
     1744         view-as alert-box error.
     1745         return no-apply.
     1746       end.
     1747     end.
     1748     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     1749     reposition br-docs to row 1 No-ERROR.
     1750     APPLY "Value-CHanged" to br-docs.
     1751     APPLY "ENTRY" to br-docs.
     1752   END.
     1753   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1754   DO:
     1755   define variable v-rid-list as character no-undo .
     1756     if not available X_wth-doc then return no-apply.
     1757       run str/wthcdocs.w
     1758         (
     1759          input  parparentproc
     1760         ,input  'b-add'
     1761         ,input  'one':U
     1762         ,input  X_wth-doc.host-code
     1763         ,input  X_wth-doc.obj-type
     1764         ,input  X_wth-doc.obj-code
     1765         ,input  '':U
     1766         ,input  0
     1767         ,input '':U
     1768         ,input  X_wth-doc.doc-code
     1769         ,output v-rid-list
     1770         ).
     1771   END.
     1772   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1773   DO:
     1774   define variable v-doc-rec as recid no-undo .
     1775   define variable next-prev as character no-undo .
     1776     IF NOT AVAIL X_wth-doc THEN RETURN NO-apply.
     1777   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1778   do:
     1779     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1780       (input  v-cntxt-db-num
     1781       ,input  v-cntxt-userid
     1782       ,input  0
     1783       ,input  'actn_wth-doc_lookup':U
     1784       ,input  'object':U
     1785       ,input  parhost-code
     1786       ,input  parobj-type
     1787       ,input  parobj-code
     1788       ,input  0
     1789       ,input  0
     1790       ,input  0
     1791       ,input  true
     1792       ,output glog
     1793       )  .
     1794   end.
     1795     IF glog <> YES
     1796     THEN DO:
     1797       RETURN NO-APPLY.
     1798     END.
     1799     ASSIGN
     1800     v-doc-rec = recid(X_wth-doc)
     1801     next-prev = '':U
     1802     .
     1803     DO WHILE next-prev = "":U:
     1804         if NOT available X_wth-doc then do:
     1805           message "Неправильно выбран документ МЦ." view-as alert-box ERROR.
     1806           return no-apply.
     1807         end.
     1808       CASE X_wth-doc.doc-type :
     1809         WHEN 'инв':U THEN DO:
     1810             run str/wth-inv.w (  INPUT parparentproc
     1811                             ,INPUT 'ПРОСМОТР':U
     1812                             ,INPUT X_wth-doc.host-code
     1813                             ,INPUT X_wth-doc.obj-type
     1814                             ,INPUT X_wth-doc.obj-code
     1815                             ,INPUT X_wth-doc.cli-type
     1816                             ,INPUT X_wth-doc.cli-code
     1817                             ,INPUT X_wth-doc.ext-doc-type
     1818                             ,INPUT X_wth-doc.auto-fill
     1819                             ,INPUT-OUTPUT v-doc-rec
     1820                             ,input this-procedure:handle
     1821                             ,input-output next-prev
     1822                             ).
     1823         END.
     1824         otherwise do:
     1825                   run str/wth-inc.w (
     1826                              INPUT parparentproc
     1827                             ,INPUT 'ПРОСМОТР':U
     1828                             ,INPUT X_wth-doc.host-code
     1829                             ,INPUT X_wth-doc.obj-type
     1830                             ,INPUT X_wth-doc.obj-code
     1831                             ,INPUT X_wth-doc.cli-type
     1832                             ,INPUT X_wth-doc.cli-code
     1833                             ,INPUT X_wth-doc.ext-doc-type
     1834                             ,INPUT X_wth-doc.doc-type
     1835                             ,INPUT X_wth-doc.auto-fill
     1836                             ,INPUT-OUTPUT v-doc-rec
     1837                             ,input this-procedure:handle
     1838                             ,input-output next-prev
     1839                             ).
     1840         end.
     1841       END CASE.
     1842    END.
     1843    RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     1844    reposition br-docs to recid v-doc-rec no-error.
     1845    APPLY "ENTRY":U  TO br-docs IN FRAME Dialog-Frame.
     1846    APPLY "VALUE-CHANGED":U TO br-docs IN FRAME Dialog-Frame.
     1847   END.
     1848   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1849   DO:
     1850     if available X_wth-doc then do:
     1851   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1852   define variable v-str-recid20 as character no-undo .
     1853   define variable v-num-entry20 as integer   no-undo .
     1854   assign
     1855     v-str-recid20 = trim( string( recid( X_wth-doc ) , "->>>>>>>>>>>9":U ) )
     1856     v-num-entry20 = lookup( v-str-recid20 , v-rid-list )
     1857   .
     1858   if v-num-entry20 > 0 then do:
     1859     assign
     1860       entry( v-num-entry20, v-rid-list ) = "":U
     1861       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1862     .
     1863   end.
     1864   else do:
     1865     assign
     1866       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     1867     .
     1868   end.
     1869       glog = br-docs:refresh() .
     1870       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1871           glog = br-docs:select-next-row ().
     1872           apply "iteration-changed" to br-docs in frame Dialog-Frame.
     1873       end.
     1874       if num-entries( v-rid-list ) = 0
     1875       then
     1876           hide mark-num in frame Dialog-Frame.
     1877       else
     1878           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1879     end.
     1880     apply "entry" to br-docs in frame Dialog-Frame.
     1881   END.
     1882   ON CHOOSE OF B-open IN FRAME Dialog-Frame
     1883   DO:
     1884     if not avail X_wth-doc then return no-apply.
     1885     run proc-b-close in this-procedure ( input self:name) no-error.
     1886     if error-status:error then return no-apply.
     1887   END.
     1888   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1889   DO:
     1890       if not avail X_wth-doc then
     1891       return no-apply.
     1892       if print-option = '':U then do:
     1893           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1894       end.
     1895       if print-option = '':U then return no-apply.
     1896       run proc-b-print in this-procedure (
     1897             input X_wth-doc.doc-code
     1898           , input print-option
     1899       ) no-error.
     1900       if error-status:error then do:
     1901           print-option = '':U.
     1902           return no-apply.
     1903       end.
     1904       APPLY "ENTRY" to br-docs.
     1905   END.
     1906   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1907   DO:
     1908   run proc-b-sch in this-procedure no-error.
     1909   if error-status:error then return no-apply.
     1910   END.
     1911   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1912   DO:
     1913         if ( available X_wth-doc ) AND ( v-rid-list = ""  or
     1914           b-mark:sensitive = no ) then
     1915       v-rid-list = string( recid( X_wth-doc ) ) .
     1916   END.
     1917   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1918   DO:
     1919      sch-code:screen-value = sch-code:screen-value + last-event:label.
     1920       apply "entry" to sch-code in frame Dialog-Frame.
     1921   apply "end" to sch-code in frame Dialog-Frame.
     1922   END.
     1923   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1924   DO:
     1925      if b-mark:sensitive in frame Dialog-Frame then
     1926     APPLY "CHOOSE" to b-mark.
     1927   END.
     1928   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1929   DO:
     1930     if b-mark:sensitive in frame Dialog-Frame then
     1931     APPLY "CHOOSE" to b-mark.
     1932       else do:
     1933         if b-sel:sensitive in frame Dialog-Frame then
     1934         APPLY "CHOOSE" to b-sel.
     1935       end.
     1936   END.
     1937   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1938   or MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME Dialog-Frame DO:
     1939     apply "choose" to b-lkp in frame Dialog-Frame.
     1940       return no-apply.
     1941   END.
     1942   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1943   DO:
     1944       define buffer buf-oper for ub.clients.
     1945       define buffer buf-deliver for ub.clients.
     1946       define buffer buf-receiver for ub.clients.
     1947         if available X_wth-doc then do:
     1948           FIND buf-oper NO-LOCK WHERE
     1949                   buf-oper.obj-type = 'чел':U AND
     1950                   buf-oper.obj-code = X_wth-doc.operator NO-ERROR.
     1951           FIND buf-deliver NO-LOCK WHERE
     1952                   buf-deliver.obj-type = 'чел':U AND
     1953                   buf-deliver.obj-code = X_wth-doc.deliver NO-ERROR.
     1954           FIND buf-receiver NO-LOCK WHERE
     1955                   buf-receiver.obj-type = 'чел':U AND
     1956                   buf-receiver.obj-code = X_wth-doc.receiver NO-ERROR.
     1957           assign
     1958           ed-notes = X_wth-doc.PS
     1959           v_operator = ( IF AVAIL buf-oper THEN buf-oper.obj-name ELSE "":U ).
     1960           v_deliver =  ( IF AVAIL buf-deliver THEN buf-deliver.obj-name ELSE "":U ).
     1961           v_receiver = ( IF AVAIL buf-receiver THEN buf-receiver.obj-name ELSE "":U ).
     1962           .
     1963   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1965     (input  X_wth-doc.user-name
     1966     ,output v_creid
     1967     )  .
     1968           if X_wth-doc.status_ = 'факт':U then do:
     1969             disable
     1970             b-open
     1971             b-close
     1972             b-chg
     1973             with frame Dialog-Frame .
     1974           end.
     1975           else do:
     1976             enable
     1977             b-open  when (lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num)
     1978             b-close when (lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num)
     1979             b-chg when lookup('b-add':U, bttns) > 0 and ub.sys-ctrl.db-num = buf_obj.db-num  and parstatus <> 'факт':U and lookup(parext-type,"ci,ce,rj,pc,") = 0
     1980             with frame Dialog-Frame .
     1981           end.
     1982           enable
     1983           b-lkp
     1984           b-attr when lookup('b-add':U, bttns) >0 and (par-mode = 'ext-doc-type':U) and ub.sys-ctrl.db-num = buf_obj.db-num and lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") = 0
     1985           B-del when lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num  and ( not par-mode = 'ext-doc-type':U or lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") = 0)
     1986           with frame Dialog-Frame .
     1987       end.
     1988       else do:
     1989           assign
     1990           ed-notes = '':U
     1991           v_operator = '':U
     1992           v_deliver = '':U
     1993           v_receiver = '':U
     1994           v_creid = '':U
     1995           .
     1996           disable
     1997             b-open
     1998             b-close
     1999             b-chg
     2000             b-del
     2001             b-attr
     2002             b-lkp
     2003           with frame Dialog-Frame .
     2004       end.
     2005       display
     2006       ed-notes
     2007       v_creid
     2008       v_deliver
     2009       v_operator
     2010       v_receiver
     2011       with frame Dialog-Frame.
     2012   END.
     2013   ON CHOOSE OF MENU-ITEM m_list
     2014   DO:
     2015    assign
     2016     print-option = 'LIST':U.
     2017     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     2018   END.
     2019   ON CHOOSE OF MENU-ITEM m_one
     2020   DO:
     2021    assign
     2022     print-option = 'ONE':U.
     2023     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     2024   END.
     2025   ON VALUE-CHANGED OF rs-auto IN FRAME Dialog-Frame
     2026   DO:
     2027         RUN OpenBr in this-procedure ( input yes
     2028                                    , input no
     2029                                    , input '':U).
     2030   END.
     2031   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2032   DO:
     2033     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     2034     if error-status:error then return no-apply.
     2035   END.
     2036   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2037   DO:
     2038     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     2039     if error-status:error then return no-apply.
     2040   END.
     2041   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     2042   DO:
     2043      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     2044     if error-status:error then return no-apply.
     2045   END.
     2046   ON RETURN OF sch-date IN FRAME Dialog-Frame
     2047   DO:
     2048       run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     2049     if error-status:error then return no-apply.
     2050   END.
     2051   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     2052   DO:
     2053      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2054     if error-status:error then return no-apply.
     2055   END.
     2056   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     2057   DO:
     2058     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2059     if error-status:error then return no-apply.
     2060   END.
     2061   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2062   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2063   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   on help of frame Dialog-Frame
     2065   do:
     2066     run gbl/app_help.p
     2067       (input this-procedure :file-name
     2068       ,input ''
     2069       ,input ?
     2070       ) no-error.
     2071     if error-status :error then do:
     2072       message
     2073         "Ошибка при вызове помощи"
     2074         error-status :get-message(1)
     2075         view-as alert-box .
     2076     end.
     2077   end.
     2078   run minbtn-set in this-procedure .
     2079   on choose of b-help in frame Dialog-Frame
     2080   do:
     2081     apply "help":u to frame Dialog-Frame .
     2082   end.
     2083   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2084   procedure minbtn-set :
     2085       do
     2086           on error undo, return error return-value
     2087           :
     2088           define variable ii              as integer       no-undo .
     2089           define variable fh              as widget-handle no-undo .
     2090           define variable hh              as widget-handle no-undo .
     2091           define variable v-h             as handle        extent 4 no-undo .
     2092           define variable v-name-button   as character     no-undo .
     2093           define variable v-help-old-x    as decimal       no-undo .
     2094           define variable v-help-old-y    as decimal       no-undo .
     2095           define variable v-help-old-size as decimal       no-undo .
     2096           define variable v-frame-width   as decimal       no-undo .
     2097           define variable jj              as integer       no-undo .
     2098           do
     2099               on error undo, return error
     2100               :
     2101               assign
     2102                   v-frame-width = frame Dialog-Frame:width - 0.3
     2103                   fh            = frame Dialog-Frame:first-child
     2104                   hh            = fh:first-child
     2105                   ii            = 1
     2106                   .
     2107               do while valid-handle(hh):
     2108                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2109                   do:
     2110                       case lc(hh:name) :
     2111                           when "b-help" then
     2112                               do:
     2113                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2114                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2115                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2116                                   hh:TOOLTIP = "Помощь" .
     2117                                   v-help-old-x = hh:column .
     2118                                   v-help-old-y = hh:row    .
     2119                                   v-help-old-size = hh:width .
     2120                                   hh:width-chars = 2.5 .
     2121                               end.
     2122                           when "b-print" then
     2123                               do:
     2124                                   hh:load-image("cmp/b-print.bmp":u) .
     2125                                   hh:TOOLTIP = "Печать" .
     2126                                   v-h[ii] = hh:handle .
     2127                                   ii = ii + 1 .
     2128                                   hh:width-chars = 3 .
     2129                               end.
     2130                           when "b-history" or
     2131                           when "b-hist" then
     2132                               do:
     2133                                   hh:load-image("cmp/b-hist.bmp":u) .
     2134                                   hh:TOOLTIP = "История" .
     2135                                   v-h[ii] = hh:handle .
     2136                                   ii = ii + 1 .
     2137                                   hh:width-chars = 3 .
     2138                               end.
     2139                           when "b-sch" then
     2140                               do:
     2141                                   hh:load-image("cmp/b-sch.bmp":u) .
     2142                                   hh:TOOLTIP = "Установка Фильтра" .
     2143                                   v-h[ii] = hh:handle .
     2144                                   ii = ii + 1 .
     2145                                   hh:width-chars = 3 .
     2146                               end.
     2147                           when "b-hist-user" then
     2148                               do:
     2149                                   hh:load-image("cmp/b-hist.bmp":u) .
     2150                                   hh:TOOLTIP = "История пользователя" .
     2151                                   ii = ii + 1 .
     2152                               end.
     2153                       end case.
     2154                   end.
     2155                   hh = hh:next-sibling.
     2156               end.
     2157               b-help:column = v-frame-width - b-help:width-chars.
     2158               jj = 0.
     2159               repeat ii = 4 to 1 by -1 :
     2160                   if valid-handle (v-h[ii] ) then
     2161                   do:
     2162                       jj  = jj + 1 .
     2163                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2164                       v-h[ii]:row    = v-help-old-y .
     2165                   end.
     2166               end.
     2167           end.
     2168       end.
     2169   end procedure.
     2170   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2171   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2172   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2173   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2174   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2175   define variable v-diasize-current-frame-height as decimal   no-undo .
     2176   define variable v-diasize-change-size          as logical   no-undo .
     2177   define variable v-diasize-resize-button        as handle    no-undo .
     2178   define variable v-diasize-wndmax               as logical   no-undo .
     2179   define variable v-diasize-wndstore             as logical   no-undo .
     2180   define variable v-diasize-proc-name            as character no-undo .
     2181   define variable v-diasize-browse-handle        as handle    no-undo .
     2182   define variable v-diasize-browse-number        as integer   no-undo .
     2183   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2184   define temp-table temp-diasize-handle no-undo
     2185     field handle-value  as handle
     2186     field save-position as decimal
     2187     index xpk is primary unique handle-value
     2188     .
     2189   define temp-table temp-browse-handle no-undo
     2190     field browse-type   as character
     2191     field browse-number as integer
     2192     field browse-handle as handle
     2193     field original-size as decimal
     2194     index xpk is primary unique browse-type browse-number
     2195     index xie browse-type browse-handle
     2196   .
     2197   procedure diasize_change-height :
     2198     define input  parameter p-change-value  as decimal   no-undo .
     2199     define input  parameter p-move-resize   as logical   no-undo .
     2200     define variable v-field-group-handle    as handle    no-undo .
     2201     define variable v-object-handle         as handle    no-undo .
     2202     define variable v-frame-height          as decimal   no-undo .
     2203     define variable v-frame-virtual-height  as decimal   no-undo .
     2204     define variable v-browse-height         as decimal   no-undo .
     2205     define variable v-window-height         as decimal   no-undo .
     2206     define variable v-window-virtual-height as decimal   no-undo .
     2207     define variable v-change-sign           as integer   no-undo .
     2208     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2209     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2210     if p-change-value > 0
     2211     then do:
     2212       if frame Dialog-Frame :height + p-change-value
     2213           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2214       then do:
     2215         assign
     2216           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2217                           - (frame Dialog-Frame :height-chars)
     2218         .
     2219         if p-change-value <= 0
     2220         then do:
     2221           run diasize_position-resize-button in this-procedure .
     2222           return .
     2223         end.
     2224       end.
     2225     end.
     2226     if p-change-value < 0
     2227     then do:
     2228       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2229       then do:
     2230         assign
     2231           p-change-value = v-diasize-orig-frame-height
     2232                          - (frame Dialog-Frame :height-chars)
     2233         .
     2234         if p-change-value >= 0
     2235         then do:
     2236           run diasize_position-resize-button in this-procedure .
     2237           return .
     2238         end.
     2239       end.
     2240     end.
     2241     if p-change-value >= 0
     2242     then do:
     2243       assign
     2244         v-change-sign = 1
     2245       .
     2246     end.
     2247     else do:
     2248       assign
     2249         v-change-sign = -1
     2250       .
     2251     end.
     2252     assign
     2253       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2254     .
     2255     if p-change-value = 0
     2256     then do:
     2257       run diasize_position-resize-button in this-procedure .
     2258       return .
     2259     end.
     2260     move_block:
     2261     do
     2262     on error undo move_block, retry move_block
     2263     :
     2264       if retry
     2265       then do:
     2266         do
     2267         on error undo move_block, leave move_block
     2268         :
     2269           if p-change-value > 0
     2270           then do:
     2271             for each buf_temp-diasize-handle
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 v-object-handle = buf_temp-diasize-handle.handle-value
     2276               .
     2277               if v-object-handle <> v-diasize-resize-button
     2278               then do:
     2279                 assign
     2280                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2281                 .
     2282               end.
     2283             end.
     2284             assign
     2285               v-diasize-browse-handle :height = v-browse-height
     2286             .
     2287             for each buf_temp-browse-handle
     2288               where buf_temp-browse-handle.browse-type = 'height':u
     2289             on error undo, next
     2290             :
     2291               assign
     2292                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2293               .
     2294             end.
     2295             assign
     2296               frame Dialog-Frame :height = v-frame-height
     2297             .
     2298             if frame Dialog-Frame :scrollable = true
     2299             then do:
     2300               assign
     2301                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2302               .
     2303             end.
     2304             run diasize_position-resize-button in this-procedure .
     2305           end.
     2306           else do:
     2307             if frame Dialog-Frame :scrollable = true
     2308             then do:
     2309               assign
     2310                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2311               .
     2312             end.
     2313             assign
     2314               frame Dialog-Frame :height = v-frame-height
     2315             .
     2316             assign
     2317               v-diasize-browse-handle :height = v-browse-height
     2318             .
     2319             for each buf_temp-browse-handle
     2320               where buf_temp-browse-handle.browse-type = 'height':u
     2321             on error undo, next
     2322             :
     2323               assign
     2324                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2325               .
     2326             end.
     2327             for each buf_temp-diasize-handle
     2328             on error undo, next
     2329             :
     2330               assign
     2331                 v-object-handle = buf_temp-diasize-handle.handle-value
     2332               .
     2333               if v-object-handle <> v-diasize-resize-button
     2334               then do:
     2335                 assign
     2336                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2337                 .
     2338               end.
     2339             end.
     2340             run diasize_position-resize-button in this-procedure .
     2341           end.
     2342           assign
     2343             v-diasize-change-size = false
     2344           .
     2345           leave move_block .
     2346         end.
     2347       end.
     2348       assign
     2349         v-diasize-need-full-display = true
     2350       .
     2351       if v-diasize-change-size = false
     2352       then do:
     2353         assign
     2354           v-diasize-change-size = true
     2355         .
     2356       end.
     2357       else do:
     2358         return .
     2359       end.
     2360       assign
     2361         v-frame-height = frame Dialog-Frame :height
     2362         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2363         v-browse-height = v-diasize-browse-handle :height
     2364       .
     2365       for each buf_temp-browse-handle
     2366         where buf_temp-browse-handle.browse-type = 'height':u
     2367       :
     2368         assign
     2369           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2370         .
     2371       end.
     2372       for each buf_temp-diasize-handle
     2373       :
     2374         delete buf_temp-diasize-handle .
     2375       end.
     2376       assign
     2377         v-field-group-handle = frame Dialog-Frame :first-child
     2378       .
     2379       do while valid-handle(v-field-group-handle)
     2380       :
     2381         assign
     2382           v-object-handle = v-field-group-handle :first-child
     2383         .
     2384         do while valid-handle(v-object-handle)
     2385         :
     2386           if  v-object-handle <> v-diasize-browse-handle :handle
     2387           and can-query(v-object-handle, "row")
     2388           and can-query(v-object-handle, "height")
     2389           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2390           then do:
     2391             find first buf_temp-browse-handle
     2392               where buf_temp-browse-handle.browse-type   = 'height':u
     2393                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2394               no-error .
     2395             if available buf_temp-browse-handle
     2396             then do:
     2397             end.
     2398             else do:
     2399               create buf_temp-diasize-handle .
     2400               assign
     2401                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2402                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2403               .
     2404             end.
     2405           end.
     2406           assign
     2407             v-object-handle = v-object-handle :next-sibling
     2408           .
     2409         end.
     2410         assign
     2411           v-field-group-handle = v-field-group-handle :next-sibling
     2412         .
     2413       end.
     2414       do with frame Dialog-Frame
     2415       :
     2416         hide v-diasize-resize-button .
     2417         assign
     2418           v-diasize-resize-button :row    = 1
     2419           v-diasize-resize-button :column = 1
     2420         .
     2421       end.
     2422       if p-change-value > 0
     2423       then do:
     2424         if frame Dialog-Frame :scrollable = true
     2425         then do:
     2426           assign
     2427             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2428             no-error .
     2429           if error-status :error
     2430           or error-status :get-message(1) <> ""
     2431           then do:
     2432             undo move_block, retry move_block .
     2433           end.
     2434         end.
     2435         assign
     2436           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2437           no-error .
     2438         if error-status :error
     2439         or error-status :get-message(1) <> ""
     2440         then do:
     2441           undo move_block, retry move_block .
     2442         end.
     2443         assign
     2444           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2445           no-error .
     2446         if error-status :error
     2447         or error-status :get-message(1) <> ""
     2448         then do:
     2449           undo move_block, retry move_block .
     2450         end.
     2451         for each buf_temp-browse-handle
     2452           where buf_temp-browse-handle.browse-type = 'height':u
     2453         on error undo move_block, retry move_block
     2454         :
     2455           assign
     2456             buf_temp-browse-handle.browse-handle :height
     2457               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2458             no-error .
     2459           if error-status :error
     2460           or error-status :get-message(1) <> ""
     2461           then do:
     2462             undo move_block, retry move_block .
     2463           end.
     2464         end.
     2465         for each buf_temp-diasize-handle
     2466         on error undo move_block, retry move_block
     2467         :
     2468           assign
     2469             v-object-handle = buf_temp-diasize-handle.handle-value
     2470           .
     2471           if v-object-handle <> v-diasize-resize-button
     2472           then do:
     2473             assign
     2474               v-object-handle :row = v-object-handle :row + p-change-value
     2475               no-error .
     2476             if error-status :error
     2477             or error-status :get-message(1) <> ""
     2478             then do:
     2479               undo move_block, retry move_block .
     2480             end.
     2481           end.
     2482         end.
     2483       end.
     2484       else do:
     2485         for each buf_temp-diasize-handle
     2486         on error undo move_block, retry move_block
     2487         :
     2488           assign
     2489             v-object-handle = buf_temp-diasize-handle.handle-value
     2490           .
     2491           if v-object-handle <> v-diasize-resize-button
     2492           then do:
     2493             assign
     2494               v-object-handle :row = v-object-handle :row + p-change-value
     2495               no-error .
     2496             if error-status :error
     2497             or error-status :get-message(1) <> ""
     2498             then do:
     2499               undo move_block, retry move_block .
     2500             end.
     2501           end.
     2502         end.
     2503         assign
     2504           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2505           no-error .
     2506         if error-status :error
     2507         or error-status :get-message(1) <> ""
     2508         then do:
     2509           undo move_block, retry move_block .
     2510         end.
     2511         for each buf_temp-browse-handle
     2512           where buf_temp-browse-handle.browse-type = 'height':u
     2513         on error undo move_block, retry move_block
     2514         :
     2515           assign
     2516             buf_temp-browse-handle.browse-handle :height
     2517               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2518             no-error .
     2519           if error-status :error
     2520           or error-status :get-message(1) <> ""
     2521           then do:
     2522             undo move_block, retry move_block .
     2523           end.
     2524         end.
     2525         assign
     2526           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2527           no-error .
     2528         if error-status :error
     2529         or error-status :get-message(1) <> ""
     2530         then do:
     2531           undo move_block, retry move_block .
     2532         end.
     2533         if frame Dialog-Frame :scrollable = true
     2534         then do:
     2535           assign
     2536             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2537             no-error .
     2538           if error-status :error
     2539           or error-status :get-message(1) <> ""
     2540           then do:
     2541             undo move_block, retry move_block .
     2542           end.
     2543         end.
     2544       end.
     2545       if p-move-resize = true
     2546       then do:
     2547         run diasize_position-resize-button in this-procedure .
     2548       end.
     2549       if v-diasize-wndstore = true
     2550       then do:
     2551         if connected("ub") = true
     2552         then do:
     2553           define variable v-cntxt-db-num        as integer   no-undo .
     2554           define variable v-cntxt-userid        as character no-undo .
     2555           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2556                                             , OUTPUT v-cntxt-userid
     2557                                             ) .
     2558           run gbl/wndsizew.p
     2559             (input  v-cntxt-db-num
     2560             ,input  v-cntxt-userid
     2561             ,input  v-diasize-proc-name
     2562             ,input  'height':u
     2563             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2564             ) .
     2565         end.
     2566       end.
     2567     end.
     2568     assign
     2569       v-diasize-change-size = false
     2570     .
     2571   end procedure.
     2572   procedure diasize_set-height :
     2573     define input  parameter p-new-height  as decimal   no-undo .
     2574     define input  parameter p-move-resize as logical   no-undo .
     2575     do
     2576     on error undo, return error return-value
     2577     :
     2578       run diasize_change-height in this-procedure
     2579         (input  (p-new-height - frame Dialog-Frame :height)
     2580         ,input  p-move-resize
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_change-width :
     2585     define input  parameter p-change-value as decimal   no-undo .
     2586     define input  parameter p-move-resize  as logical   no-undo .
     2587     define variable v-field-group-handle   as handle    no-undo .
     2588     define variable v-object-handle        as handle    no-undo .
     2589     define variable v-frame-width          as decimal   no-undo .
     2590     define variable v-frame-virtual-width  as decimal   no-undo .
     2591     define variable v-browse-width         as decimal   no-undo .
     2592     define variable v-window-width         as decimal   no-undo .
     2593     define variable v-window-virtual-width as decimal   no-undo .
     2594     define variable v-change-sign          as integer   no-undo .
     2595     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2596     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2597     if p-change-value > 0
     2598     then do:
     2599       if frame Dialog-Frame :width + p-change-value >
     2600           session :width-chars
     2601       then do:
     2602         assign
     2603           p-change-value = session :width-chars - frame Dialog-Frame :width
     2604         .
     2605         if p-change-value <= 0
     2606         then do:
     2607           run diasize_position-resize-button in this-procedure .
     2608           return .
     2609         end.
     2610       end.
     2611     end.
     2612     if p-change-value < 0
     2613     then do:
     2614       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2615       then do:
     2616         assign
     2617           p-change-value = v-diasize-orig-frame-width
     2618                          - frame Dialog-Frame :width
     2619         .
     2620         if p-change-value >= 0
     2621         then do:
     2622           run diasize_position-resize-button in this-procedure .
     2623           return .
     2624         end.
     2625       end.
     2626     end.
     2627     if p-change-value >= 0
     2628     then do:
     2629       assign
     2630         v-change-sign = 1
     2631       .
     2632     end.
     2633     else do:
     2634       assign
     2635         v-change-sign = -1
     2636       .
     2637     end.
     2638     assign
     2639       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2640     .
     2641     if p-change-value = 0
     2642     then do:
     2643       run diasize_position-resize-button in this-procedure .
     2644       return .
     2645     end.
     2646     move_block:
     2647     do
     2648     on error undo move_block, leave move_block
     2649     :
     2650       if retry
     2651       then do:
     2652         do
     2653         on error undo move_block, leave move_block
     2654         :
     2655           if p-change-value > 0
     2656           then do:
     2657             for each buf_temp-diasize-handle
     2658             on error undo, next
     2659             :
     2660               assign
     2661                 v-object-handle = buf_temp-diasize-handle.handle-value
     2662               .
     2663               if v-object-handle <> v-diasize-resize-button
     2664               then do:
     2665                 assign
     2666                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2667                 .
     2668               end.
     2669             end.
     2670             assign
     2671               v-diasize-browse-handle :width = v-browse-width
     2672             .
     2673             for each buf_temp-browse-handle
     2674               where buf_temp-browse-handle.browse-type = 'width':u
     2675             on error undo, next
     2676             :
     2677               assign
     2678                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2679               .
     2680             end.
     2681             assign
     2682               frame Dialog-Frame :width = v-frame-width
     2683             .
     2684             if frame Dialog-Frame :scrollable = true
     2685             then do:
     2686               assign
     2687                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2688               .
     2689             end.
     2690             run diasize_position-resize-button in this-procedure .
     2691           end.
     2692           else do:
     2693             if frame Dialog-Frame :scrollable = true
     2694             then do:
     2695               assign
     2696                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2697               .
     2698             end.
     2699             assign
     2700               frame Dialog-Frame :width = v-frame-width
     2701             .
     2702             for each buf_temp-browse-handle
     2703               where buf_temp-browse-handle.browse-type = 'width':u
     2704             on error undo, next
     2705             :
     2706               assign
     2707                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2708               .
     2709             end.
     2710             assign
     2711               v-diasize-browse-handle :width = v-browse-width
     2712             .
     2713             for each buf_temp-diasize-handle
     2714             on error undo, next
     2715             :
     2716               assign
     2717                 v-object-handle = buf_temp-diasize-handle.handle-value
     2718               .
     2719               if v-object-handle <> v-diasize-resize-button
     2720               then do:
     2721                 assign
     2722                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2723                 .
     2724               end.
     2725             end.
     2726             run diasize_position-resize-button in this-procedure .
     2727           end.
     2728           assign
     2729             v-diasize-change-size = false
     2730           .
     2731           leave move_block .
     2732         end.
     2733       end.
     2734       assign
     2735         v-diasize-need-full-display = true
     2736       .
     2737       if v-diasize-change-size = false
     2738       then do:
     2739         assign
     2740           v-diasize-change-size = true
     2741         .
     2742       end.
     2743       else do:
     2744         return .
     2745       end.
     2746       assign
     2747         v-frame-width = frame Dialog-Frame :width
     2748         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2749         v-browse-width = v-diasize-browse-handle :width
     2750       .
     2751       for each buf_temp-browse-handle
     2752         where buf_temp-browse-handle.browse-type = 'width':u
     2753       :
     2754         assign
     2755           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2756         .
     2757       end.
     2758       for each buf_temp-diasize-handle
     2759       :
     2760         delete buf_temp-diasize-handle .
     2761       end.
     2762       assign
     2763         v-field-group-handle = frame Dialog-Frame :first-child
     2764       .
     2765       do while valid-handle(v-field-group-handle)
     2766       :
     2767         assign
     2768           v-object-handle = v-field-group-handle :first-child
     2769         .
     2770         do while valid-handle(v-object-handle)
     2771         :
     2772           if  v-object-handle <> v-diasize-browse-handle :handle
     2773           and v-object-handle <> v-diasize-resize-button
     2774           and can-query(v-object-handle, "row")
     2775           and can-query(v-object-handle, "height")
     2776           and ( v-object-handle :col + v-object-handle :width
     2777                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2778               )
     2779           then do:
     2780             find first buf_temp-browse-handle
     2781               where buf_temp-browse-handle.browse-type   = 'width':u
     2782                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2783               no-error .
     2784             if available buf_temp-browse-handle
     2785             then do:
     2786             end.
     2787             else do:
     2788               create buf_temp-diasize-handle .
     2789               assign
     2790                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2791                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2792               .
     2793             end.
     2794           end.
     2795           assign
     2796             v-object-handle = v-object-handle :next-sibling
     2797           .
     2798         end.
     2799         assign
     2800           v-field-group-handle = v-field-group-handle :next-sibling
     2801         .
     2802       end.
     2803       do with frame Dialog-Frame
     2804       :
     2805         hide v-diasize-resize-button .
     2806         v-diasize-resize-button :row = 1.
     2807         v-diasize-resize-button :column = 1.
     2808       end.
     2809       if p-change-value > 0
     2810       then do:
     2811         if frame Dialog-Frame :scrollable = true
     2812         then do:
     2813           assign
     2814             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2815             no-error .
     2816           if error-status :error
     2817           or error-status :get-message(1) <> ""
     2818           then do:
     2819             undo move_block, retry move_block.
     2820           end.
     2821         end.
     2822         assign
     2823           frame Dialog-Frame :width = v-frame-width + p-change-value
     2824           no-error .
     2825         if error-status :error
     2826         or error-status :get-message(1) <> ""
     2827         then do:
     2828           undo move_block, retry move_block.
     2829         end.
     2830         assign
     2831           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2832         no-error .
     2833         if error-status :error
     2834         or error-status :get-message(1) <> ""
     2835         then do:
     2836           undo move_block, retry move_block.
     2837         end.
     2838         for each buf_temp-browse-handle
     2839           where buf_temp-browse-handle.browse-type = 'width':u
     2840         on error undo move_block, retry move_block
     2841         :
     2842           assign
     2843             buf_temp-browse-handle.browse-handle :width
     2844               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2845             no-error .
     2846           if error-status :error
     2847           or error-status :get-message(1) <> ""
     2848           then do:
     2849             undo move_block, retry move_block .
     2850           end.
     2851         end.
     2852         for each buf_temp-diasize-handle
     2853         on error undo move_block, retry move_block
     2854         :
     2855           assign
     2856             v-object-handle = buf_temp-diasize-handle.handle-value
     2857           .
     2858           if v-object-handle <> v-diasize-resize-button
     2859           then do:
     2860             assign
     2861               v-object-handle :col = v-object-handle :col + p-change-value
     2862               no-error .
     2863             if error-status :error
     2864             or error-status :get-message(1) <> ""
     2865             then do:
     2866               undo move_block, retry move_block .
     2867             end.
     2868           end.
     2869         end.
     2870       end.
     2871       else do:
     2872         for each buf_temp-diasize-handle
     2873         on error undo move_block, retry move_block
     2874         :
     2875           assign
     2876             v-object-handle = buf_temp-diasize-handle.handle-value
     2877           .
     2878           if v-object-handle <> v-diasize-resize-button
     2879           then do:
     2880             assign
     2881               v-object-handle :col = v-object-handle :col + p-change-value
     2882               no-error .
     2883             if error-status :error
     2884             or error-status :get-message(1) <> ""
     2885             then do:
     2886               undo move_block, retry move_block .
     2887             end.
     2888           end.
     2889         end.
     2890         for each buf_temp-browse-handle
     2891           where buf_temp-browse-handle.browse-type = 'width':u
     2892         on error undo move_block, retry move_block
     2893         :
     2894           assign
     2895             buf_temp-browse-handle.browse-handle :width
     2896               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2897             no-error .
     2898           if error-status :error
     2899           or error-status :get-message(1) <> ""
     2900           then do:
     2901             undo move_block, retry move_block .
     2902           end.
     2903         end.
     2904         assign
     2905           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2906           no-error .
     2907         if error-status :error
     2908         or error-status :get-message(1) <> ""
     2909         then do:
     2910           undo move_block, retry move_block.
     2911         end.
     2912         assign
     2913           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2914         no-error .
     2915         if error-status :error
     2916         or error-status :get-message(1) <> ""
     2917         then do:
     2918           undo move_block, retry move_block.
     2919         end.
     2920         if frame Dialog-Frame :scrollable = true
     2921         then do:
     2922           assign
     2923             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2924           no-error .
     2925           if error-status :error
     2926           or error-status :get-message(1) <> ""
     2927           then do:
     2928             undo move_block, retry move_block.
     2929           end.
     2930         end.
     2931       end.
     2932       if p-move-resize
     2933       then do:
     2934         run diasize_position-resize-button in this-procedure .
     2935       end.
     2936       if v-diasize-wndstore = true
     2937       then do:
     2938         if connected("ub") = true
     2939         then do:
     2940           define variable v-cntxt-db-num        as integer   no-undo .
     2941           define variable v-cntxt-userid        as character no-undo .
     2942           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2943                                             , OUTPUT v-cntxt-userid
     2944                                             ) .
     2945           run gbl/wndsizew.p
     2946             (input  v-cntxt-db-num
     2947             ,input  v-cntxt-userid
     2948             ,input  v-diasize-proc-name
     2949             ,input  'width':u
     2950             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2951             ) .
     2952         end.
     2953       end.
     2954     end.
     2955     assign
     2956       v-diasize-change-size = false
     2957     .
     2958   end procedure.
     2959   procedure diasize_set-width :
     2960     define input  parameter p-new-width  as decimal   no-undo .
     2961     define input  parameter p-move-resize as logical   no-undo .
     2962     do
     2963     on error undo, return error return-value
     2964     :
     2965       run diasize_change-width in this-procedure
     2966         (input  (p-new-width - frame Dialog-Frame :width)
     2967         ,input  p-move-resize
     2968         ) .
     2969     end.
     2970   end procedure.
     2971   procedure diasize_position-resize-button :
     2972     do with frame Dialog-Frame
     2973     :
     2974       hide v-diasize-resize-button .
     2975       assign
     2976         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2977                     - 1
     2978                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2979         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2980                     - 1
     2981                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2982       .
     2983       view v-diasize-resize-button .
     2984     end.
     2985   end procedure.
     2986   on alt-right anywhere
     2987   do:
     2988     run diasize_change-width in this-procedure
     2989       (input 1
     2990       ,input true
     2991       ) .
     2992     return no-apply .
     2993   end.
     2994   on alt-left anywhere
     2995   do:
     2996     run diasize_change-width in this-procedure
     2997       (input -1
     2998       ,input true
     2999       ) .
     3000     return no-apply .
     3001   end.
     3002   on alt-down anywhere
     3003   do:
     3004     run diasize_change-height in this-procedure
     3005       (input 1
     3006       ,input true
     3007       ) .
     3008     return no-apply .
     3009   end.
     3010   on alt-up anywhere
     3011   do:
     3012     run diasize_change-height in this-procedure
     3013       (input -1
     3014       ,input true
     3015       ) .
     3016     return no-apply .
     3017   end.
     3018   on alt-enter of frame Dialog-Frame
     3019   do:
     3020     run diasize_maximize in this-procedure
     3021       (input  ?
     3022       ).
     3023     return no-apply .
     3024   end.
     3025   procedure diasize_end-move :
     3026     do
     3027     on error undo, return error return-value
     3028     :
     3029       define variable v-row-delta as decimal   no-undo .
     3030       define variable v-col-delta as decimal   no-undo .
     3031       define variable v-new-row as decimal   no-undo .
     3032       define variable v-new-col as decimal   no-undo .
     3033       assign
     3034         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3035         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3036       .
     3037       assign
     3038         v-row-delta = v-new-row - frame Dialog-Frame :height
     3039         v-col-delta = v-new-col - frame Dialog-Frame :width
     3040       .
     3041       run diasize_change-height in this-procedure
     3042         (input v-row-delta
     3043         ,input true
     3044         ) .
     3045       run diasize_change-width in this-procedure
     3046         (input v-col-delta
     3047         ,input true
     3048         ) .
     3049     end.
     3050   end procedure.
     3051   procedure diasize_maximize :
     3052     define input  parameter p-action as logical   no-undo .
     3053     do
     3054     on error undo, return error return-value
     3055     :
     3056       if p-action = ?
     3057       then do:
     3058         if v-diasize-need-maximize = true
     3059         then do:
     3060           assign
     3061             p-action = true
     3062           .
     3063         end.
     3064         else do:
     3065           assign
     3066             p-action = false
     3067           .
     3068         end.
     3069       end.
     3070       if p-action = true
     3071       then do:
     3072         run diasize_change-height in this-procedure
     3073           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3074               - frame Dialog-Frame :height-chars
     3075           ,input true
     3076           ) .
     3077         run diasize_change-width in this-procedure
     3078           (input session :width-chars
     3079               - frame Dialog-Frame :width-chars
     3080           ,input true
     3081           ) .
     3082         assign
     3083           v-diasize-need-maximize = false
     3084         .
     3085       end.
     3086       else do:
     3087         run diasize_change-width in this-procedure
     3088           (input v-diasize-orig-frame-width
     3089               - frame Dialog-Frame :width-chars
     3090           ,input true
     3091           ) .
     3092         run diasize_change-height in this-procedure
     3093           (input v-diasize-orig-frame-height
     3094               - frame Dialog-Frame :height-chars
     3095           ,input true
     3096           ) .
     3097         assign
     3098           v-diasize-need-maximize = true
     3099         .
     3100       end.
     3101     end.
     3102   end procedure.
     3103   procedure diasize_restore-orig-size :
     3104     do
     3105     on error undo, return error return-value
     3106     :
     3107       assign
     3108         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3109         v-diasize-current-frame-height = frame Dialog-Frame :height
     3110       .
     3111       run diasize_set-height in this-procedure
     3112         (input  v-diasize-orig-frame-height
     3113         ,input  true
     3114         ) .
     3115       run diasize_set-width in this-procedure
     3116         (input  v-diasize-orig-frame-width
     3117         ,input  true
     3118         ) .
     3119     end.
     3120   end procedure.
     3121   procedure diasize_restore-current-size :
     3122     do
     3123     on error undo, return error return-value
     3124     :
     3125       run diasize_set-height in this-procedure
     3126         (input  v-diasize-current-frame-height
     3127         ,input  true
     3128         ) .
     3129       run diasize_set-width in this-procedure
     3130         (input  v-diasize-current-frame-width
     3131         ,input  true
     3132         ) .
     3133     end.
     3134   end procedure.
     3135   procedure diasize_set-browse-handle :
     3136     define input  parameter p-browse-handle as handle   no-undo .
     3137     define buffer buf_temp-browse-handle for temp-browse-handle .
     3138     do
     3139     on error undo, return error return-value
     3140     :
     3141       assign
     3142         v-diasize-browse-handle = p-browse-handle
     3143       .
     3144       for each buf_temp-browse-handle
     3145       on error undo, return error return-value
     3146       :
     3147         delete buf_temp-browse-handle .
     3148       end.
     3149     end.
     3150   end procedure.
     3151   procedure diasize_add_browse :
     3152     define input  parameter p-browse-type   as character no-undo .
     3153     define input  parameter p-browse-handle as handle    no-undo .
     3154     define buffer buf_temp-browse-handle for temp-browse-handle .
     3155     do
     3156     on error undo, return error return-value
     3157     :
     3158       assign
     3159         v-diasize-browse-number = v-diasize-browse-number + 1
     3160       .
     3161       create buf_temp-browse-handle .
     3162       assign
     3163         buf_temp-browse-handle.browse-type   = p-browse-type
     3164         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3165         buf_temp-browse-handle.browse-handle = p-browse-handle
     3166       .
     3167     end.
     3168   end procedure.
     3169   procedure diasize_init :
     3170     define variable v-default-value    as logical   no-undo .
     3171     define variable v-restore-saved    as logical   no-undo .
     3172     define variable v-resize-value-str as character no-undo .
     3173     do
     3174     on error undo, return error return-value
     3175     :
     3176       do with frame Dialog-Frame
     3177       :
     3178         assign
     3179           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3180           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3181           v-diasize-browse-handle     = browse BR-docs :handle
     3182         .
     3183         create button v-diasize-resize-button
     3184         assign
     3185           parent        = frame Dialog-Frame :first-child
     3186           label         = "s"
     3187           height-pixels = 16
     3188           width-pixels  = 16
     3189           visible       = true
     3190           sensitive     = true
     3191           movable       = true
     3192           triggers:
     3193             on end-move persistent run diasize_end-move in this-procedure .
     3194           end triggers.
     3195         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3196         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3197         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3198         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3199         assign
     3200           v-diasize-wndmax = false
     3201         .
     3202         if connected("ub") = true
     3203         then do:
     3204           define variable v-cntxt-db-num        as integer   no-undo .
     3205           define variable v-cntxt-userid        as character no-undo .
     3206           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3207                                             , OUTPUT v-cntxt-userid
     3208                                             ) .
     3209           run gbl/wndpar_r.p
     3210             (input  v-cntxt-db-num
     3211             ,input  v-cntxt-userid
     3212             ,input  'wndmax':U
     3213             ,output v-diasize-wndmax
     3214             ,output v-default-value
     3215             ) .
     3216         end.
     3217         assign
     3218           v-diasize-wndstore = false
     3219         .
     3220         if connected("ub") = true
     3221         then do:
     3222           run gbl/wndpar_r.p
     3223             (input  v-cntxt-db-num
     3224             ,input  v-cntxt-userid
     3225             ,input  'wndstore':U
     3226             ,output v-diasize-wndstore
     3227             ,output v-default-value
     3228             ) .
     3229         end.
     3230         assign
     3231           v-diasize-proc-name = entry(1, program-name(2), '.')
     3232         .
     3233         if v-diasize-wndstore = true
     3234         then do:
     3235           assign
     3236             v-restore-saved = false
     3237           .
     3238           if connected("ub") = true
     3239           then do:
     3240             run gbl/wndsizer.p
     3241               (input  v-cntxt-db-num
     3242               ,input  v-cntxt-userid
     3243               ,input  v-diasize-proc-name
     3244               ,input  'height':u
     3245               ,output v-resize-value-str
     3246               ) .
     3247             if v-resize-value-str <> '':U
     3248             then do:
     3249               run diasize_change-height in this-procedure
     3250                 (input  integer(v-resize-value-str)
     3251                 ,input  true
     3252                 ) .
     3253               assign
     3254                 v-restore-saved = true
     3255               .
     3256             end.
     3257           end.
     3258           if connected("ub") = true
     3259           then do:
     3260             run gbl/wndsizer.p
     3261               (input  v-cntxt-db-num
     3262               ,input  v-cntxt-userid
     3263               ,input  v-diasize-proc-name
     3264               ,input  'width':u
     3265               ,output v-resize-value-str
     3266               ) .
     3267             if v-resize-value-str <> '':U
