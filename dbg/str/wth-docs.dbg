     3497                           buf_cli.obj-code = parhost-code No-ERROR.
     3498           if not avail buf_cli then do:
     3499               message vss-workfile vss-revision vss-description skip
     3500               "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3501               parobj-type parobj-code
     3502               view-as alert-box ERROR.
     3503               return.
     3504           end.
     3505           if lookup(parext-type,'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u) = 0 then do:
     3506               message vss-workfile vss-revision vss-description skip
     3507               "Неверное значение параметра вызова parext-type" parext-type
     3508               view-as alert-box ERROR.
     3509               return.
     3510           end.
     3511       END.
     3512       WHEN 'Контрагент':U    THEN DO:
     3513           FIND FIRST buf_cli No-LOCK WHERE
