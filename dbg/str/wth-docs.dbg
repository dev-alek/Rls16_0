     3421       ,output v-cntxt-obj-code
     3422       ,output v-cntxt-db-num-obj
     3423       ,output v-cntxt-is-admin
     3424       ) .
     3425     FIND FIRST ub.sys-ctrl NO-LOCK.
     3426     if avail sys-ctrl then do:
     3427       FIND FIRST ub.db no-LOCK where
     3428                 ub.db.db-num = ub.sys-ctrl.db-num NO-ERROR.
     3429       if not avail db then do:
     3430         message "Отсутствует запись о БД (db)"
     3431         view-as alert-box ERROR.
     3432         return error.
     3433       end.
     3434     END.
     3435     FIND FIRST buf_obj No-LOCK WHERE
     3436                     buf_obj.obj-type = parobj-type and
     3437                     buf_obj.obj-code = parobj-code No-ERROR.
     3438     if not avail buf_obj then do:
     3439         message vss-workfile vss-revision vss-description skip
