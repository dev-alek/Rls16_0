     3515                           buf_cli.obj-code = parobj-code No-ERROR.
     3516           if not avail buf_cli then do:
     3517               message vss-workfile vss-revision vss-description skip
     3518               "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3519               parobj-type parobj-code
     3520               view-as alert-box ERROR.
     3521               return.
     3522           end.
     3523           FIND FIRST buf_cli No-LOCK WHERE
     3524                           buf_cli.obj-type = parcli-type and
     3525                           buf_cli.obj-code = parcli-code No-ERROR.
     3526           if not avail buf_cli then do:
     3527               message vss-workfile vss-revision vss-description skip
     3528               "Неверное значение параметров вызова parcli-type и/или parcli-code"
     3529               parcli-type parcli-code
