     3414   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3415     run mainmenu_getcntxt in parparentproc
     3416       (output v-cntxt-db-num
     3417       ,output v-cntxt-userid
     3418       ,output v-cntxt-level
     3419       ,output v-cntxt-host-code-obj
