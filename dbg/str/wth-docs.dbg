     5336     if l-filter-open-54 = false then do:
     5337       OPEN QUERY br-docs FOR EACH X_wth-doc
     5338         where        X_wth-doc.host-code = parhost-code  AND       X_wth-doc.obj-type  = parobj-type  AND       X_wth-doc.obj-code  = parobj-code  AND       X_wth-doc.ext-doc-type  = parext-type AND       (rs-auto = 1 or (rs-auto = 2 and X_wth-doc.auto-fill) or (rs-auto = 3 and not X_wth-doc.auto-fill ) ) AND       (if parstatus > '' and parstatus <> 'все':U then (if parstatus = 'факт':U then X_wth-doc.status_ = 'факт':U else X_wth-doc.status_ <> 'факт':U ) else true)
     5339          USE-INDEX obj-date
     5340         indexed-reposition
     5341     .
     5342         assign
     5343           l-query-was-opened = true
     5344         .
     5345     end.
     5346   end.
     5347   else do:
     5348     assign
     5349       v-doc-rec = recid( X_wth-doc )
     5350     .
     5351     do
     5352     on stop undo, leave
     5353     on error undo, leave
     5354     :
     5355       if query br-docs:handle:get-buffer-handle(1) = (buffer X_wth-doc:handle) then do:
     5356         assign
     5357         parameter-2-54 = (if p-find-next then "true":u else "false":u )
     5358         parameter-4-54 =
     5359           "where ":u +  substitute( '       X_wth-doc.host-code    = &1 AND       X_wth-doc.obj-type     = &7&2&7 AND       X_wth-doc.obj-code     = &3 AND       X_wth-doc.ext-doc-type = &7&4&7 AND       ( &5 = 1 or ( &5 = 2 and X_wth-doc.auto-fill ) or ( &5 = 3 and not X_wth-doc.auto-fill ) ) AND        ( if &7&6&7 > &7&7 and &7&6&7 <> &7&8&7         then (if &7&6&7 = &7&9&7                 then X_wth-doc.status_ =  &7&9&7                      else X_wth-doc.status_ <> &7&9&7                   )         else true       )       '       , parhost-code                  , parobj-type                   , parobj-code                   , parext-type                   , rs-auto                       , parstatus                     , chr(34)             , 'все':U                        , 'факт':U                       )        + " ":u + where-phrase-54 + " ":u + p-find-condition + " " + ""
     5360         parameter-5-54 = ' USE-INDEX obj-date '
     5361       .
     5362         run fltopend_fltfindd in this-procedure  (
     5363                             input this-procedure:handle
     5364                             ,input query br-docs:handle
     5365                             ,input rowid(X_wth-doc)
     5366                             ,input logical(parameter-2-54)
     5367                             ,input no-lock
     5368                             ,input (buffer X_wth-doc:handle)
     5369                             ,input parameter-4-54
     5370                             ,input parameter-5-54
     5371                             ) no-error.
     5372         .
     5373         assign
     5374           v-doc-rec = integer(return-value)
     5375           v-fltopend-rowid[1] = ?
     5376         .
     5377       end.
     5378       else do:
     5379         assign
     5380         parameter-2-54 = (if p-find-next then "true":u else "false":u )
     5381         parameter-3-54 =  "FOR EACH X_wth-doc"
     5382         parameter-4-54 =
     5383           (
     5384             if ("       X_wth-doc.host-code = parhost-code  AND       X_wth-doc.obj-type  = parobj-type  AND       X_wth-doc.obj-code  = parobj-code  AND       X_wth-doc.ext-doc-type  = parext-type AND       (rs-auto = 1 or (rs-auto = 2 and X_wth-doc.auto-fill) or (rs-auto = 3 and not X_wth-doc.auto-fill ) ) AND       (if parstatus > '' and parstatus <> 'все':U then (if parstatus = 'факт':U then X_wth-doc.status_ = 'факт':U else X_wth-doc.status_ <> 'факт':U ) else true)                   " + " " + where-phrase-54) <> ""
     5385             then  substitute( '       X_wth-doc.host-code    = &1 AND       X_wth-doc.obj-type     = &7&2&7 AND       X_wth-doc.obj-code     = &3 AND       X_wth-doc.ext-doc-type = &7&4&7 AND       ( &5 = 1 or ( &5 = 2 and X_wth-doc.auto-fill ) or ( &5 = 3 and not X_wth-doc.auto-fill ) ) AND        ( if &7&6&7 > &7&7 and &7&6&7 <> &7&8&7         then (if &7&6&7 = &7&9&7                 then X_wth-doc.status_ =  &7&9&7                      else X_wth-doc.status_ <> &7&9&7                   )         else true       )       '       , parhost-code                  , parobj-type                   , parobj-code                   , parext-type                   , rs-auto                       , parstatus                     , chr(34)             , 'все':U                        , 'факт':U                       )        + " " + where-phrase-54
     5386             else "true"
     5387           )
     5388         parameter-5-54 = (" " + "" + " " + "" + " " + p-find-condition)
     5389         parameter-6-54 = if sort-phrase-54 = ''
     5390                              then
     5391           (
     5392           " " + ' USE-INDEX obj-date ' +
     5393             " " + sort-column-phrase +
     5394           " " + "  "
     5395           )
     5396                              else
     5397           (
     5398           " " + ' USE-INDEX obj-date ' +
     5399             " " + sort-column-phrase +
     5400           " " + sort-phrase-54
     5401           )
     5402         parameter-7-54 =
     5403           " indexed-reposition  "
     5404       .
     5405         run fltopend_fltfindq in this-procedure  (
     5406                             input this-procedure:handle
     5407                             ,input query br-docs:handle
     5408                             ,input logical(parameter-2-54)
     5409                             ,input no-lock
     5410                             ,input parameter-3-54
     5411                             ,input parameter-4-54
     5412                             ,input parameter-5-54
     5413                             ,input parameter-6-54
     5414                             ,input parameter-7-54
     5415                             ,output v-fltopend-rowid
     5416                             ) no-error.
     5417         .
     5418         v-doc-rec = ?.
     5419       end.
     5420       assign
     5421         l-query-was-opened = true
     5422       .
     5423     end.
     5424   end.
     5425     run waitfram-hide in this-procedure .
     5426   END.
     5427   END CASE.
     5428   if not p-open-query and v-doc-rec <> ? then
     5429   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     5430   run waitfram-hide in this-procedure .
     5431   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     5432   APPLY "ENTRY" TO br-docs.
     5433   END PROCEDURE.
     5434   PROCEDURE proc-b-close :
     5435   DEFINE INPUT PARAMETER loc-mode as character no-undo.
     5436   define variable r_w-doc-recid AS RECID NO-UNDO.
     5437   DEF BUFFER b_wth-doc  FOR ub.wth-doc.
     5438   DEF BUFFER buf_wth-obj  FOR ub.wth-obj.
     5439   DEF BUFFER buf_wth-line FOR ub.wth-line.
     5440   define variable v-proc-name-err as char no-undo.
     5441   define variable v-user-action    as character no-undo.
     5442   define variable v-printed        as logical   no-undo.
     5443   define variable vss-include-info55 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5444   do:
     5445     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5446       (input  v-cntxt-db-num
     5447       ,input  v-cntxt-userid
     5448       ,input  0
     5449       ,input  'actn_wth-doc_update':U
     5450       ,input  'object':U
     5451       ,input  parhost-code
     5452       ,input  parobj-type
     5453       ,input  parobj-code
     5454       ,input  0
     5455       ,input  0
     5456       ,input  0
     5457       ,input  true
     5458       ,output glog
     5459       )  .
     5460   end.
     5461   if not glog
     5462   then do:
     5463     return error.
     5464   end.
     5465   ASSIGN v-doc-rec = RECID( X_wth-doc ).
     5466   ASSIGN r_w-doc-recid = v-doc-rec.
     5467   FIND FIRST b_wth-doc where
     5468                   recid(b_wth-doc) = v-doc-rec No-ERROR.
     5469   if not avail b_wth-doc then return error.
     5470   ASSIGN glog = NO.
     5471   CASE LOC-MODE:
     5472   WHEN "B-CLOSE":U THEN DO:
     5473     IF b_wth-doc.status_ = 'факт':U THEN DO:
     5474       MESSAGE "Документ уже закрыт на ФАКТ!  " VIEW-AS ALERT-BOX ERROR.
     5475       RETURN error.
     5476     END.
     5477     MESSAGE
     5478       "Вы собираетесь закрыть документ со статуса ~"" + CAPS( b_wth-doc.status_ ) +
     5479       "~" на статус ~"" + CAPS(
     5480       ( IF b_wth-doc.status_ = 'накл':U AND  b_wth-doc.doc-type = 'инв':U
     5481         THEN 'разрешен':U
     5482         ELSE 'факт':U ) ) + "~"." SKIP
     5483       "Учтите, что закрытые документы открывать нельзя!" SKIP( 1 )
     5484       "Вы уверены, что хотите закрыть документ?     "
     5485     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     5486     IF glog <> YES THEN DO:
     5487       RETURN error.
     5488     END.
     5489   END.
     5490   WHEN "B-OPEN":U THEN DO:
     5491     IF b_wth-doc.status_ = 'накл':U THEN DO:
     5492       MESSAGE "Документ уже открыт!  " VIEW-AS ALERT-BOX ERROR.
     5493       RETURN error.
     5494     END.
     5495     if b_wth-doc.status_ = 'факт':U then do:
     5496       message "Нельзя открыть документ, закрытый на факт"
     5497       view-as alert-box error .
     5498       return error.
     5499     end.
     5500     MESSAGE
     5501       "Вы собираетесь открыть документ со статуса ~"" + CAPS( b_wth-doc.status_ ) +
     5502       "~" на статус ~"" + CAPS(
     5503       ( IF b_wth-doc.status_ = 'разрешен':U THEN 'накл':U ELSE '') ) + "~"." SKIP
     5504       "Вы уверены, что хотите открыть документ?     "
     5505     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     5506     IF glog <> YES THEN DO:
     5507       RETURN error.
     5508     END.
     5509   END.
     5510     OTHERWISE RETURN ERROR.
     5511   end case.
     5512   v-proc-name-err = string(session:TEMP-DIRECTORY) + '/clsWdoc.err':U .
     5513   if search (v-proc-name-err) <> ? then do:
     5514     os-delete value(v-proc-name-err).
     5515   end.
     5516   run str/wth-stts.p (
     5517                    input parparentproc
     5518                   ,BUFFER b_wth-doc
     5519                   ,INPUT (if loc-mode = "b-close":U then "+":U else "-":U)
     5520                   ,INPUT YES
     5521                   ,INPUT parobj-type
     5522                   ,INPUT PAROBJ-code
     5523                   ,input v-proc-name-err ) NO-ERROR.
     5524   IF ERROR-STATUS :ERROR THEN DO:
     5525     case loc-mode:
     5526       when "b-close":U then
     5527       MESSAGE "Не удалось закрыть документ!  " VIEW-AS ALERT-BOX ERROR.
     5528       when "b-open":U then
     5529       MESSAGE "Не удалось открыть документ!  " VIEW-AS ALERT-BOX ERROR.
     5530     end CASE.
     5531     if search (v-proc-name-err) <> ? then do:
     5532       run gbl/prnfilen.w
     5533         (input  "Ошибки при закрытии документа"
     5534         ,input  0
     5535         ,input  v-proc-name-err
     5536         ,input  7
     5537         ,output v-user-action
     5538         ,output v-printed
     5539         ).
     5540     end.
     5541     RETURN error.
     5542   END.
     5543   else if return-value = 'warning':U  and search (v-proc-name-err) <> ? then do:
     5544        message 'Документ закрыт успешно.' skip
     5545                'Просмотрите дополнительную информацию в лог-файле.'
     5546                view-as alert-box warning.
     5547   end.
     5548   ASSIGN glog = br-docs:REFRESH( ) in frame Dialog-Frame.
     5549   RUN OpenBr in this-procedure ( input yes, input no, input '':U ).
     5550   IF v-doc-rec <> r_w-doc-recid THEN DO:
     5551     ASSIGN v-doc-rec = r_w-doc-recid.
     5552   END.
     5553   Reposition br-docs to recid v-doc-rec No-ERROR.
     5554   END PROCEDURE.
     5555   PROCEDURE proc-b-print :
     5556   define input parameter p-doc-code   as character        no-undo.
     5557   define input parameter loc-option   as character        no-undo.
     5558   if loc-option = '':U then return error.
     5559   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5560   do:
     5561     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5562       (input  v-cntxt-db-num
     5563       ,input  v-cntxt-userid
     5564       ,input  0
     5565       ,input  'actn_wth-doc_print':U
     5566       ,input  'object':U
     5567       ,input  parhost-code
     5568       ,input  parobj-type
     5569       ,input  parobj-code
     5570       ,input  0
     5571       ,input  0
     5572       ,input  0
     5573       ,input  true
     5574       ,output glog
     5575       )  .
     5576   end.
     5577   IF glog <> YES
     5578   THEN DO:
     5579     RETURN ERROR.
     5580   END.
     5581   CASE loc-option:
     5582   when 'ONE':U
     5583   then do:
     5584       run rep/wth-prn.p (
     5585             input parparentproc
     5586           , input p-doc-code
     5587       ) no-error.
     5588       if error-status :error
     5589       then do:
     5590           message
     5591                    vss-workfile vss-revision vss-description
     5592               skip(1)
     5593               skip "Ошибка печати документа материальных ценностей."
     5594               skip(1)
     5595               skip "Номер документа:" p-doc-code
     5596               skip(1)
     5597               skip return-value
     5598               skip trim( error-status :get-message( 1 ) )
     5599                    trim( error-status :get-message( 2 ) )
     5600                    trim( error-status :get-message( 3 ) )
     5601           view-as alert-box error.
     5602           undo, return error.
     5603       end.
     5604   end.
     5605   when 'LIST':U then do:
     5606       run proc-print-list in this-procedure no-error.
     5607   end.
     5608   end case.
     5609   loc-option = ''.
     5610   END PROCEDURE.
     5611   PROCEDURE proc-b-sch :
     5612   assign
     5613   tbl = 'wth-doc'
     5614   join-tbl = 'X_wth-doc'
     5615   fld = ""
     5616   lab = ""
     5617   spr = ""
     5618   dim = '0'
     5619   .
     5620   run fltfield-add in this-procedure('doc-code', 'Номер', '',
     5621   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5622   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5623   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5624   run fltfield-add in this-procedure('doc-date', 'Дата', '',
     5625   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5626   run fltfield-add in this-procedure('fact-date', 'Факт', '',
     5627   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5628   run fltfield-add in this-procedure('doc-type', 'Тип', 'trn-type',
     5629   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5630   run fltfield-add in this-procedure('ext-doc-type', 'Расш. тип', 'wth-ext-type',
     5631   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5632   run fltfield-add in this-procedure('status_', 'Статус', 'trn-stat',
     5633   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5634   run fltfield-add in this-procedure('inter_', 'Внутр', '',
     5635   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5636   run fltfield-add in this-procedure('exter_', 'Внеш', '',
     5637   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5638   run fltfield-add in this-procedure('cli-type*cli-code', 'Контрагент', 'cli',
     5639   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5640   run fltfield-add in this-procedure('cli-name', 'Имя контраг', '',
     5641   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5642   run fltfield-add in this-procedure('doc-sum', 'Сумма', '',
     5643   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5644   run fltfield-add in this-procedure('fact-sum', 'Сумма факт', '',
     5645   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5646   run fltfield-add in this-procedure('shift-date', 'Дата смены', '',
     5647   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5648   run fltfield-add in this-procedure('shift-num', 'Порядок смены', '',
     5649   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5650   run fltfield-add in this-procedure('shift-name', '№ смены', '',
     5651   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5652   run fltfield-add in this-procedure('bge-date', 'Дата внеш.пров.', '',
     5653   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5654   run fltfield-add in this-procedure('scf-date', 'Дата сч-факт', '',
     5655   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5656   run fltfield-add in this-procedure('source-ref', 'Ссылка на док-т', '',
     5657   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5658   run fltfield-add in this-procedure('borned', 'Порожден', '',
     5659   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5660   run fltfield-add in this-procedure('operator', 'Исполнитель', 'cli',
     5661   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5662   run fltfield-add in this-procedure('deliver', 'Доставил', 'cli',
     5663   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5664   run fltfield-add in this-procedure('receiver', 'Получил', 'cli',
     5665   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5666   run fltfield-add in this-procedure('PS', 'Комментарий', '',
     5667   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5668   run fltfield-add in this-procedure('creid', 'Опер-р', 'cli',
     5669   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5670   run fltfield-add in this-procedure('credate', 'Дата создания', '',
     5671   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5672   Filter-Block:
     5673   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5674     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5675     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5676   run gbl/filter.w ( INPUT parparentproc
     5677                     , INPUT (filter-point + chr(4) +
     5678                               filter-label + chr(4) +
     5679                               string(yes))
     5680                     , INPUT tbl
     5681                     , INPUT join-tbl
     5682                     , INPUT fld
     5683                     , INPUT lab
     5684                     , INPUT spr
     5685                     , INPUT dim ).
     5686   RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5687   END.
     5688   END PROCEDURE.
     5689   PROCEDURE proc-find-code :
     5690   define input parameter par-next as logical no-undo.
     5691   define input parameter pardoc-code like ub.wth-doc.doc-code no-undo.
     5692   display
     5693   "  /  /":U @ sch-date
     5694   "  /  /":U @ sch-fact
     5695   with frame Dialog-Frame.
     5696   assign
     5697   pardoc-code = chr(34) + pardoc-code + chr(34).
     5698   run OpenBr in this-procedure
     5699     (input false
     5700     ,input par-next
     5701     ,input substitute("and X_wth-doc.doc-code   begins &1 "
     5702       , pardoc-code)
     5703     ).
     5704   apply "entry":u to sch-code in frame Dialog-Frame .
     5705   END PROCEDURE.
     5706   PROCEDURE proc-find-date :
     5707   define input parameter par-next as logical no-undo.
     5708   define input parameter par-date like ub.wth-doc.doc-date no-undo.
     5709   define input parameter parwhat-date as character no-undo.
     5710   define variable var-datechr as character no-undo.
     5711   display
     5712   '':U @ sch-code
     5713   with frame Dialog-Frame.
     5714   assign
     5715   var-datechr = string(day(par-date)) + chr(47) +
     5716                 string(month(par-date)) + chr(47) +
     5717                 string(year(par-date)).
     5718   case parwhat-date:
     5719     when "doc-date":U then do:
     5720       display
     5721       "  /  /":U @ sch-fact
     5722       with frame Dialog-Frame.
     5723       run OpenBr in this-procedure
     5724       (input false
     5725       ,input true
     5726       ,input substitute("and X_wth-doc.doc-date = &1 "
     5727         , var-datechr)
     5728       ).
     5729       apply "entry":u to sch-date in frame Dialog-Frame.
     5730     end.
     5731     when "fact-date":U then do:
     5732       display
     5733       "  /  /":U @ sch-date
     5734       with frame Dialog-Frame.
     5735       run OpenBr in this-procedure
     5736         (input false
     5737         ,input true
     5738         ,input substitute("and X_wth-doc.fact-date = &1 "
     5739         , var-datechr)
     5740         ).
     5741       apply "entry":u to sch-fact in frame Dialog-Frame.
     5742     end.
     5743   END.
     5744   END PROCEDURE.
     5745   PROCEDURE proc-print-list :
     5746   DEFINE VARIABLE vardoc-rec as recid no-undo.
     5747   DEFINE VARIABLE for-doc-date as character no-undo.
     5748   DEFINE VARIABLE for-shift-date as character no-undo.
     5749   DEFINE VARIABLE for-obj as character no-undo.
     5750   define variable accum-count as integer.
     5751   define variable accum-doc-sum as decimal.
     5752   define variable accum-fact-sum as decimal.
     5753   define variable date_string     as      char    no-undo.
     5754   define variable loc-v_operator  as   char    no-undo.
     5755   define variable loc-v_deliver as      char    no-undo.
     5756   define variable loc-v_receiver as      char    no-undo.
     5757   define variable v-shift-name-num as character no-undo.
     5758   define variable v-header-base-curr as character no-undo .
     5759   define variable v-curr-r-b as character no-undo .
     5760   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5762     (output v-curr-r-b
     5763     )  .
     5764   if v-curr-r-b = 'base':U then do:
     5765     assign
     5766     v-header-base-curr = string( "( Б.Вал. - " + caps( v-r-b-abbr ) + " )" )
     5767     .
     5768   end.
     5769   define variable Line                as      char    no-undo.
     5770   define buffer buf-oper for ub.clients.
     5771   define buffer buf-deliver for ub.clients.
     5772   define buffer buf-receiver for ub.clients.
     5773   DEFINE FRAME wth-list
     5774   X_wth-doc.doc-type COLUMN-LABEL "Т" FORMAT "X(1)"
     5775   X_wth-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     5776   X_wth-doc.doc-code
     5777   for-doc-date  COLUMN-LABEL "Дата" FORMAT "X(5)"
     5778   X_wth-doc.fact-date
     5779   v-shift-name-num COLUMN-LABEL "N см." FORMAT "X(6)"
     5780   for-shift-date  COLUMN-LABEL "Смена" FORMAT "X(5)"
     5781   X_wth-doc.inter_ COLUMN-LABEL "В"
     5782   X_wth-doc.exter_ COLUMN-LABEL "Ш"
     5783   X_wth-doc.cli-name FORMAT "X(26)"
     5784   for-obj COLUMN-LABEL "Объект" FORMAT "X(9)"
     5785   X_wth-doc.doc-sum COLUMN-LABEL "Сумма по док-ту"
     5786   X_wth-doc.fact-sum
     5787   X_wth-doc.source-ref COLUMN-LABEL "На документ"
     5788   X_wth-doc.bge-date COLUMN-LABEL "Внеш.пров."
     5789   loc-v_operator COLUMN-LABEL "Исп" FORMAT "X(8)"
     5790   loc-v_deliver  COLUMN-LABEL "Передал" FORMAT "X(8)"
     5791   loc-v_receiver  COLUMN-LABEL "Получил" FORMAT "X(8)"
     5792   X_wth-doc.creid  COLUMN-LABEL "Опер" FORMAT "X(8)"
     5793   HEADER  date_string AT 5 format "X(35)"
     5794   v-header-base-curr        format "X(20)" AT 42
     5795    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5796   Line format "X(198)" AT 1
     5797   with width 232 down stream-io use-text    .
     5798   if b-sch:tooltip in frame Dialog-Frame <> '' then do:
     5799       message "В списке не установлен фильтр" SKIP
     5800                     "Печать списка может занять длительное время" SKIP
     5801                     "Продолжать?"
     5802       view-as alert-box QUESTION buttons YES-NO update glog.
     5803       if not glog then return.
     5804   end.
     5805   Line = fill("-", 198).
     5806   date_string = cur-time-print() .
     5807   run prn-lib-open-stream  in this-procedure (
     5808                                                input parParentProc
     5809                                               ,input 43
     5810                                               ,input yes
     5811                                               ,input no
     5812                                               ).
     5813   PUT  STREAM PrnLibStream
     5814   SPACE(25) ( frame Dialog-Frame:title )
     5815   format "x(90)" SKIP(1) .
     5816   FORM HEADER
     5817   Line format "X(198)" AT 1 SKIP
     5818   "Продолжение - на следующей странице" AT 30 SKIP
     5819   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5820   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5821   FORM with FRAME wth-list  .
     5822   run waitfram-show in this-procedure ( input "Ждите..." ).
     5823   vardoc-rec = recid(X_wth-doc).
     5824   DO WHILE available X_wth-doc :
     5825     GET prev br-docs.
     5826   END.
     5827   GET next br-docs.
     5828    DO WHILE available X_wth-doc :
     5829           FIND buf-oper NO-LOCK WHERE
     5830                   buf-oper.obj-type = 'чел':U AND
     5831                   buf-oper.obj-code = X_wth-doc.operator NO-ERROR.
     5832           FIND buf-deliver NO-LOCK WHERE
     5833                   buf-deliver.obj-type = 'чел':U AND
     5834                   buf-deliver.obj-code = X_wth-doc.deliver NO-ERROR.
     5835           FIND buf-receiver NO-LOCK WHERE
     5836                   buf-receiver.obj-type = 'чел':U AND
     5837                   buf-receiver.obj-code = X_wth-doc.receiver NO-ERROR.
     5838           assign
     5839           loc-v_operator = ( IF AVAIL buf-oper THEN buf-oper.obj-name ELSE "":U ).
     5840           loc-v_deliver = ( IF AVAIL buf-deliver THEN buf-deliver.obj-name ELSE "":U ).
     5841           loc-v_receiver = ( IF AVAIL buf-receiver THEN buf-receiver.obj-name ELSE "":U )
     5842           .
     5843     Display STREAM PrnLibStream
     5844       X_wth-doc.doc-type
     5845       X_wth-doc.status_
     5846       X_wth-doc.doc-code
     5847       (substring ((string (X_wth-doc.doc-date)), 1, 5)) @ for-doc-date
     5848       X_wth-doc.fact-date
     5849       shift-name-no-err(buffer X_wth-doc) @ v-shift-name-num
     5850       (substring ((string (X_wth-doc.shift-date)), 1, 5)) @ for-shift-date
     5851       X_wth-doc.inter_
     5852       X_wth-doc.exter_
     5853       X_wth-doc.cli-name
     5854       (trim (X_wth-doc.obj-type) + " " + string (X_wth-doc.obj-code, ">>>>9")) @ for-obj
     5855       X_wth-doc.doc-sum
     5856       X_wth-doc.fact-sum
     5857       X_wth-doc.source-ref
     5858       X_wth-doc.bge-date
     5859       loc-v_operator
     5860        loc-v_deliver
     5861       loc-v_receiver
     5862       X_wth-doc.creid
     5863     with FRAME wth-list .
     5864     DOWN STREAM PrnLibStream 1
     5865     with FRAME wth-list  .
     5866     assign
     5867     accum-count = accum-count + 1
     5868     accum-doc-sum = accum-doc-sum + X_wth-doc.doc-sum
     5869       accum-fact-sum = accum-fact-sum + X_wth-doc.fact-sum
     5870       .
     5871     GET next br-docs.
     5872     END.
     5873     UNDERLINE  STREAM PrnLibStream
     5874       X_wth-doc.doc-type
     5875       X_wth-doc.status_
     5876       X_wth-doc.doc-code
     5877       for-doc-date
     5878       X_wth-doc.fact-date
     5879       v-shift-name-num
     5880       for-shift-date
     5881       X_wth-doc.inter_
     5882       X_wth-doc.exter_
     5883       X_wth-doc.cli-name
     5884       for-obj
     5885       X_wth-doc.doc-sum
     5886       X_wth-doc.fact-sum
     5887       X_wth-doc.source-ref
     5888       X_wth-doc.bge-date
     5889       loc-v_operator
     5890       loc-v_deliver
     5891       loc-v_receiver
     5892       X_wth-doc.creid
     5893     with FRAME wth-list .
     5894     DISPLAY STREAM PrnLibStream
     5895     ("ИТОГО" + chr(32) + string(accum-count))  @ X_wth-doc.doc-code
     5896    accum-doc-sum @ X_wth-doc.doc-sum
     5897     accum-fact-sum @ X_wth-doc.fact-sum
     5898     with frame wth-list.
     5899   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5900   HIDE  STREAM PrnLibStream FRAME wth-List.
     5901   output  STREAM PrnLibStream CLOSE.
     5902   REPOSITION br-docs to recid vardoc-rec no-error.
     5903   APPLY "entry" to br-docs.
     5904   run waitfram-hide in this-procedure .
     5905   run prn-lib-prn-file in this-procedure (
     5906                                             input parParentProc
     5907                                             ,input 8
     5908                                             ).
     5909   END PROCEDURE.
     5910   PROCEDURE reposition-query :
     5911   define input parameter p-recid as recid no-undo .
     5912     if p-recid <> ?
     5913     then do:
     5914       reposition br-docs to recid p-recid no-error.
     5915     end.
     5916     do with frame Dialog-Frame:
     5917       apply "entry":u to browse BR-docs .
     5918       apply "VALUE-CHANGED":u to browse BR-docs .
     5919     end.
     5920   END PROCEDURE.
     5921   PROCEDURE reposition-wth-doc :
     5922   define input  parameter p-direction   as character no-undo .
     5923   define output parameter p-wth-doc-recid as recid no-undo .
     5924     case p-direction :
     5925       when "first":U
     5926       then do:
     5927         get first br-docs.
     5928       end.
     5929       when "last":U
     5930       then do:
     5931         get last br-docs.
     5932       end.
     5933       when "prev":U
     5934       then do:
     5935         get prev br-docs.
     5936         if not available X_wth-doc then do:
     5937           message
     5938           "Это первый документ списка"
     5939           view-as alert-box.
     5940         end.
     5941       end.
     5942       when "next":U
     5943       then do:
     5944         get next br-docs.
     5945         if not available X_wth-doc then do:
     5946           message
     5947           "Это последний документ списка"
     5948           view-as alert-box.
     5949         end.
     5950       end.
     5951     end case .
     5952     assign
     5953     p-wth-doc-recid = recid(X_wth-doc)
     5954     .
     5955     run reposition-query in this-procedure
     5956       (input p-wth-doc-recid
     5957       ).
     5958   END PROCEDURE.
