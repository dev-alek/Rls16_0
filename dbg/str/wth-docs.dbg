     3744   PROCEDURE create-attr :
     3745   define  input parameter p-doc-code   like ub.wth-doc.doc-code    no-undo.
     3746   define  input parameter p-attr-code  like ub.wth-doc-attr.attr-code  no-undo.
     3747   define  input parameter p-attr-value like ub.wth-doc-attr.attr-value no-undo.
     3748   define output parameter p-exist      as   logical                no-undo.
     3749   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-xst in g#wthcalib (  input p-doc-code ,
     3750                           input p-attr-code ,
     3751                          output p-exist )  .
     3752     if p-exist = no then do:
     3753   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-wrt in g#wthcalib ( input p-doc-code ,
     3754                          input p-attr-code ,
     3755                          input p-attr-value ) no-error .
     3756       if error-status :error then do:
     3757         message error-status :error error-status :get-message( 1 ) '"' + p-attr-code + '"'
     3758         view-as alert-box error.
     3759       end.
     3760     end.
     3761   END PROCEDURE.
     3762   PROCEDURE disable_UI :
     3763     HIDE FRAME Dialog-Frame.
     3764   END PROCEDURE.
     3765   PROCEDURE enable_UI :
     3766     DISPLAY rs-auto ED-notes sch-code sch-date sch-fact mark-num v_operator
     3767             v_deliver v_receiver v_creid
     3768         WITH FRAME Dialog-Frame.
     3769     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-close B-open B-sch
     3770            B-print B-hist B-Help rs-auto BR-docs ED-notes sch-code sch-date
     3771            sch-fact mark-num v_operator v_deliver v_receiver v_creid
     3772         WITH FRAME Dialog-Frame.
     3773     VIEW FRAME Dialog-Frame.
     3774   END PROCEDURE.
     3775   PROCEDURE init-attr-general :
     3776   if available X_wth-doc
     3777   then
     3778   do on error undo, return error return-value :
     3779   run cr-tt-upd-general .
     3780   define variable varexist                  as logical   no-undo.
     3781   if lookup(X_wth-doc.ext-doc-type, "ie,ee,pz") > 0
     3782   then do:
     3783         run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthnsf':U                                                         , input  ""                                                         , output varexist ) no-error.
     3784         run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthdsf':U                                                         , input  ""                                                         , output varexist ) no-error.
     3785         run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthpaydoc':U                                                         , input  ""                                                         , output varexist ) no-error.
     3786     if X_wth-doc.doc-type <> 'при':U then do:
     3787           run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthconsignee':U                                                         , input  ""                                                         , output varexist ) no-error.
     3788     end.
     3789   end.
     3790   if lookup(X_wth-doc.ext-doc-type, "ie,ee,pz,xc") > 0
     3791   then do:
     3792         run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthproxy':U                                                         , input  ""                                                         , output varexist ) no-error.
     3793         run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthreceiver':U                                                         , input  ""                                                         , output varexist ) no-error.
     3794   END.
     3795   run create-attr in this-procedure (   input X_wth-doc.doc-code                                                         , input 'wthreason':U                                                         , input  ""                                                         , output varexist ) no-error.
     3796   end.
     3797   END PROCEDURE.
     3798   PROCEDURE Myenable :
     3799   ASSIGN
     3800     br-docs:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 4
     3801     X_wth-doc.bge-date:READ-ONLY IN BROWSE BR-docs = YES
     3802     b-print:MENU-MOUSE = 1
     3803   .
     3804   if par-type = 'спи':U then
     3805   DISPLAY
     3806   ED-notes
     3807   sch-code
     3808   sch-date
     3809   sch-fact
     3810   mark-num
     3811   v_operator
     3812   v_deliver
     3813   v_receiver
     3814   v_creid
     3815   WITH FRAME Dialog-Frame.
     3816   ENABLE
     3817   b-quit
     3818   rs-auto
     3819   B-mark when lookup('b-mark':U, bttns) >0
     3820   B-sel  when lookup('b-sel':U, bttns) >0
     3821   B-add  when lookup('b-add':U, bttns) >0 and (par-mode = 'ext-doc-type':U) and ub.sys-ctrl.db-num = buf_obj.db-num and lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") = 0
     3822   b-attr
     3823   b-auto when lookup('b-add':U, bttns) >0 and (par-mode = 'ext-doc-type':U) and ub.sys-ctrl.db-num = buf_obj.db-num and lookup(parext-type,'ii,fj,jj,pj,oj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,xc':U) = 0 and lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") = 0
     3824   b-lkp
     3825   B-chg when lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num  and parstatus <> 'факт':U and lookup(parext-type,"ci,ce,rj,pc,") = 0
     3826   B-del when lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num  and ( not par-mode = 'ext-doc-type':U or lookup(parext-type,"ip,rp,rj,pc,ff,rf,fj,pj,ii,rj,ci,ce,de") = 0)
     3827   B-close when (lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num)
     3828   B-open  when (lookup('b-add':U, bttns) >0 and ub.sys-ctrl.db-num = buf_obj.db-num)
     3829   B-sch
     3830   B-print
     3831   B-hist
     3832   B-Help
     3833   BR-docs
     3834   ED-notes
     3835   sch-code
     3836   sch-date
     3837   sch-fact
     3838   mark-num
     3839   v_operator
     3840   v_deliver
     3841   v_receiver
     3842   v_creid
     3843   WITH FRAME Dialog-Frame.
     3844   if not ( (par-mode = 'ext-doc-type':U and lookup(parext-type,"ie,ee,ij,ej,iy,de") > 0) or
     3845             par-mode = 'объект':U or
     3846             par-mode = 'doc-type':U or
     3847             par-mode = 'фирма':U or
     3848             par-mode = 'все':U
     3849          )
     3850   then disable rs-auto
     3851   with frame Dialog-Frame.
     3852   VIEW FRAME Dialog-Frame.
     3853   rs-auto:screen-value = '1'.
     3854   RUN openbr in this-procedure ( input yes, input no, input '':U).
     3855   END PROCEDURE.
     3856   PROCEDURE OpenBr :
     3857   define input  parameter p-open-query     as logical   no-undo .
     3858   define input  parameter p-find-next      as logical   no-undo .
     3859   define input  parameter p-find-condition as character no-undo .
     3860   define variable l-query-was-opened as logical no-undo .
     3861   define variable title0 as character no-undo.
     3862   title0 = "Движение материальных ценностей".
     3863   run waitfram-show in this-procedure ( input "Ждите...").
     3864   define variable sort-column-phrase as character no-undo .
     3865   assign frame Dialog-Frame rs-auto.
     3866   case sort-column-name :
     3867   when "" then do:
     3868   assign
     3869     sort-column-phrase = ""
     3870   .
     3871   end.
     3872   otherwise do:
     3873   assign
     3874     sort-column-phrase = "by " + sort-column-name
     3875   .
     3876   end.
     3877   end case.
     3878   define variable l-open-query as logical   no-undo .
     3879   filter-point = filter-point0 + par-mode.
     3880   CASE par-mode :
     3881   WHEN 'все':U        THEN DO:
     3882     assign
     3883     frame Dialog-Frame:TITLE = title0
     3884     filter-label = substitute("&1", filter-label0)
     3885     .
     3886   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3887   define variable  l-disable-where-40  as logical   no-undo .
     3888   define variable  l-filter-open-40    as logical   .
     3889   define variable  flt-rec-40       as recid     no-undo .
     3890   define variable  filter-name-40      as character no-undo .
     3891   define variable  where-phrase-40     as character no-undo .
     3892   define variable  sort-phrase-40      as character no-undo .
     3893   define variable  where-phrase-rus-40 as character no-undo .
     3894   define variable  sort-phrase-rus-40  as character no-undo .
     3895     run waitfram-show in this-procedure
     3896       (input "ЖДИТЕ ..."
     3897       ).
     3898   run gbl/flt-get.p
     3899     (input filter-point
     3900     ,output flt-rec-40
     3901     ,output filter-name-40
     3902     ,output where-phrase-40
     3903     ,output sort-phrase-40
     3904     ,output where-phrase-rus-40
     3905     ,output sort-phrase-rus-40
     3906     ).
     3907   if p-open-query then do:
     3908       run set-filter-name in this-procedure
     3909         (INPUT filter-name-40
     3910         ) no-error .
     3911     assign
     3912       l-filter-open-40 = false
     3913     .
     3914     if flt-rec-40 <> ?
     3915       or sort-column-phrase > ""
     3916     then do:
     3917       define variable  parameter-2-40 as character no-undo .
     3918       define variable  parameter-3-40 as character no-undo .
     3919       define variable  parameter-4-40 as character no-undo .
     3920       define variable  parameter-5-40 as character no-undo .
     3921       define variable  parameter-6-40 as character no-undo .
     3922       define variable  parameter-7-40 as character no-undo .
     3923         assign
     3924         parameter-3-40 =
     3925                                 "FOR EACH X_wth-doc"
     3926         parameter-4-40 =
     3927           (
     3928             if (" (rs-auto = 1 or (rs-auto = 2 and X_wth-doc.auto-fill) or (rs-auto = 3 and not X_wth-doc.auto-fill ) ) " + " " + where-phrase-40) <> ""
     3929             then  substitute(' ( &1 = 1 or ( &1 = 2 and X_wth-doc.auto-fill ) or ( &1 = 3 and not X_wth-doc.auto-fill ) )', rs-auto )  + " " + where-phrase-40
     3930             else "true"
     3931           )
     3932         parameter-5-40 = (" " + "" + " " + "")
     3933         parameter-6-40 = if sort-phrase-40 = ''
     3934                              then
     3935           (
     3936           " " + ' USE-INDEX host-date ' +
     3937             " " + sort-column-phrase +
     3938           " " + "  "
     3939           )
     3940                              else
     3941           (
     3942           " " + ' USE-INDEX host-date ' +
     3943             " " + sort-column-phrase +
     3944           " " + sort-phrase-40
     3945           )
     3946         parameter-7-40 =
     3947           " indexed-reposition  "
     3948       .
     3949       do
     3950       on stop undo, leave
     3951       on error undo, leave
     3952       :
     3953         assign
     3954           l-disable-where-40 =
     3955             (" (rs-auto = 1 or (rs-auto = 2 and X_wth-doc.auto-fill) or (rs-auto = 3 and not X_wth-doc.auto-fill ) ) " + " " + where-phrase-40 = "")
     3956         .
     3957         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3958                             ,input query br-docs:handle
     3959                             ,input parameter-3-40
     3960                             ,input parameter-4-40
     3961                             ,input parameter-5-40
     3962                             ,input parameter-6-40
     3963                             ,input parameter-7-40
     3964                             )
     3965         .
     3966         assign
     3967           l-filter-open-40 = true
     3968         .
     3969       end.
     3970       if l-filter-open-40 = false then do:
     3971         message
     3972           "Ошибка при фильтрации / сортировке" skip
     3973           "Будут показаны записи без учета фильтра" skip
     3974           view-as alert-box .
     3975       end.
     3976       else do:
