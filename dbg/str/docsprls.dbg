      976   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure prcreate-new-price-doc :
      978   do
      979   on error undo, return error return-value
      980   :
      981   define input  parameter p-curr-db-num  as integer   no-undo .
      982   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      983   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      984   define input  parameter p-plt-id       as integer   no-undo .
      985   define input  parameter p-plt-db-num   as integer   no-undo .
      986   define input  parameter p-pdf-id       as integer   no-undo .
      987   define input  parameter p-pdf-db-num   as integer   no-undo .
      988   define output parameter p-price-doc-recid  as recid                no-undo.
      989   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      990   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      991   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      992   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      993   define buffer buf_price-doc-forming for ub.price-doc-forming.
      994   define buffer buf_price-doc         for ub.price-doc.
      995   find first buf_price-doc-forming no-lock where
      996              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      997              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      998              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      999              buf_price-doc-forming.plt-id     = p-plt-id
     1000              no-error .
     1001   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1002      run create_new_price-doc-forming
     1003           ( input p-obj-type ,
     1004             input p-obj-code ,
     1005             output p-pdf-db-num ,
     1006             output p-pdf-id ,
     1007             output p-plt-db-num ,
     1008             output p-plt-id
     1009             ).
     1010       find first buf_price-doc-forming no-lock where
     1011                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1012                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1013                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1014                 buf_price-doc-forming.plt-id     = p-plt-id
     1015                 no-error .
     1016   end.
     1017       create buf_price-doc .
     1018       run doc-code in this-procedure
     1019       (input  "main",
     1020        input  p-obj-type  ,
     1021        input  p-obj-code  ,
     1022        input  ?,
     1023        output buf_price-doc.doc-num) no-error.
     1024       if error-status:error then do:
     1025         message vss-workfile vss-revision vss-description skip
     1026                error-status :get-message(1)
     1027               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1028         return error.
     1029       end.
     1030   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1032     (input  p-obj-type
     1033     ,input  p-obj-code
     1034     ,output v-host-code
     1035     )  .
     1036       v-obj-current-date  = today .
     1037       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1038           v-base-rate   =  buf_price-doc-forming.base-rate  .
     1039           v-base-scale  =  buf_price-doc-forming.base-scale .
     1040       end.
     1041       else do:
     1042   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1044     (input  v-host-code
     1045     ,input  v-obj-current-date
     1046     ,output v-base-rate
     1047     ,output v-base-scale
     1048     )  .
     1049       end.
     1050      assign
     1051       buf_price-doc.base-rate      = v-base-rate
     1052       buf_price-doc.base-scale     = v-base-scale
     1053       buf_price-doc.cr-db-num      = p-curr-db-num
     1054       buf_price-doc.doc-date       = v-obj-current-date
     1055       buf_price-doc.fact-num       = 0
     1056       buf_price-doc.host-code      = v-host-code
     1057       buf_price-doc.is-corr        = false
     1058       buf_price-doc.is-del         = false
     1059       buf_price-doc.obj-code       = p-obj-code
     1060       buf_price-doc.obj-type       = p-obj-type
     1061       buf_price-doc.out-code       = ""
     1062       buf_price-doc.pdf-db         = p-pdf-db-num
     1063       buf_price-doc.pdf-id         = p-pdf-id
     1064       buf_price-doc.plt-db-num     = p-plt-db-num
     1065       buf_price-doc.plt-id         = p-plt-id
     1066       buf_price-doc.PS             = "@ "
     1067       buf_price-doc.rest-base      = 0
     1068       buf_price-doc.rest-last      = 0
     1069       buf_price-doc.rest-qnty      = 0
     1070       buf_price-doc.rest-sale      = 0
     1071       buf_price-doc.sale-base      = 0
     1072       buf_price-doc.status_        = 'новый':U
     1073       .
     1074       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     1075       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1076       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1077       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     1078       assign
     1079           p-price-doc-recid = recid ( buf_price-doc )
     1080       .
     1081   end.
     1082   end procedure.
     1083   procedure prcreate-new-price-list :
     1084   do
     1085   on error undo, return error return-value
     1086   :
     1087   define input parameter p-price-doc-recid   as recid                    no-undo.
     1088   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1089   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1090   define output parameter p-update           as logical                  no-undo.
     1091   define variable kk as integer no-undo .
     1092   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1093   define variable p-hostcode as int no-undo .
     1094   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1095   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1096   define buffer buf_price-doc        for ub.price-doc.
     1097   define buffer buf_price-list       for ub.price-list.
     1098   define buffer buf_bar-code         for ub.bar-code.
     1099   define buffer buf_goods            for ub.goods.
     1100   define buffer buf_root_gds-prt     for ub.gds-prt.
     1101   define buffer buf_gds-prt          for ub.gds-prt.
     1102   find first buf_price-doc no-lock
     1103        where recid( buf_price-doc ) = p-price-doc-recid
     1104   .
     1105   find first buf_goods no-lock
     1106        where buf_goods.gds-code = p-gds-code
     1107   .
     1108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1109     (input  p-gds-code
     1110     ,input  ?
     1111     ,output v-b-code
     1112     ) no-error .
     1113   if error-status :error
     1114   then do:
     1115       message
     1116           "Не найден основной бар-код"
     1117           skip "для товара "
     1118           skip string(buf_goods.artic)
     1119           skip buf_goods.gds-name
     1120       view-as alert-box
     1121       title "Ошибка при выполнении prcreate.i".
     1122       undo, return error .
     1123   end.
     1124   find first buf_bar-code no-lock
     1125        where buf_bar-code.b-code = v-b-code
     1126   no-error.
     1127   if error-status :error
     1128   then do:
     1129       message
     1130           "Не найдена запись bar-code"
     1131           skip "для товара "
     1132           skip string(buf_goods.artic)
     1133           skip buf_goods.gds-name
     1134           skip "С основным бар-кодом"
     1135           skip string(v-b-code)
     1136       view-as alert-box
     1137       title "Ошибка при выполнении prcreate.i".
     1138       undo, return error .
     1139   end.
     1140   find first buf_root_gds-prt no-lock
     1141        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1142   .
     1143   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1144     and buf_bar-code.in-code <> ""
     1145   then do:
     1146       message
     1147           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1148           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1149           view-as alert-box error.
     1150       undo, return error.
     1151   end.
     1152   find first buf_gds-prt no-lock
     1153        where buf_gds-prt.node-code = buf_bar-code.node-code
     1154   .
     1155   find first buf_price-list
     1156        where buf_price-list.doc-num = buf_price-doc.doc-num
     1157          and buf_price-list.b-code  = v-b-code
     1158   no-error.
     1159   if available buf_price-list
     1160   then do:
     1161       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1162          skip "  Цена:   " buf_price-list.price-sale
     1163          skip "Цена будет изменена"
     1164       view-as alert-box warning.
     1165       assign
     1166           p-update = yes
     1167       .
     1168   end.
     1169   else do:
     1170   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1172     (input  buf_price-doc.obj-type
     1173     ,input  buf_price-doc.obj-code
     1174     ,output p-hostcode
     1175     ) no-error .
     1176   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1178     (input  buf_goods.gds-code
     1179     ,input  '1':U
     1180     ,input  ?
     1181     ,input  p-hostcode
     1182     ,input  buf_price-doc.obj-type
     1183     ,input  buf_price-doc.obj-code
     1184     ,output local_vat-pc
     1185     ) no-error .
     1186   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1188     (input  buf_goods.gds-code
     1189     ,input  '2':U
     1190     ,input  ?
     1191     ,input  p-hostcode
     1192     ,input  buf_price-doc.obj-type
     1193     ,input  buf_price-doc.obj-code
     1194     ,output local_slt-pc
     1195     ) no-error .
     1196       kk = kk + 1.
     1197   define variable v-main-bar-code as integer   no-undo .
     1198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1199     (input  buf_goods.gds-code
     1200     ,input  ?
     1201     ,output v-main-bar-code
     1202     )  .
     1203       create buf_price-list.
     1204       assign
     1205           buf_price-list.line-num    = kk
     1206           buf_price-list.doc-num     = buf_price-doc.doc-num
     1207           buf_price-list.b-code      = buf_bar-code.b-code
     1208           buf_price-list.artic       = buf_goods.artic
     1209           buf_price-list.prod-type   = buf_goods.prod-type
     1210           buf_price-list.prod-code   = buf_goods.prod-code
     1211           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1212           buf_price-list.calc-method = 'Отсутствует':U
     1213           buf_price-list.obj-type    = buf_price-doc.obj-type
     1214           buf_price-list.obj-code    = buf_price-doc.obj-code
     1215           buf_price-list.price-sale  = p-price-sale
     1216           buf_price-list.vat-pc      = local_vat-pc
     1217           buf_price-list.slt-pc      = local_slt-pc
     1218           p-update                   = no
     1219       .
     1220   end.
     1221   end.
     1222   end procedure.
     1223   procedure create_new_price-doc-forming :
     1224   define input  parameter p-obj-type   as character no-undo .
     1225   define input  parameter p-obj-code   as integer   no-undo .
     1226   define output parameter p-pdf-db-num as integer   no-undo .
     1227   define output parameter p-pdf-id     as integer   no-undo .
     1228   define output parameter p-plt-db-num as integer   no-undo .
     1229   define output parameter p-plt-id     as integer   no-undo .
     1230   define buffer buf_price-list-type for ub.price-list-type  .
     1231   define variable v-host-code  as integer   no-undo .
     1232   define variable v-base-rate  as decimal   no-undo .
     1233   define variable v-base-scale as integer   no-undo .
     1234   define variable v-exch-rate  as decimal   no-undo .
     1235   define variable v-exch-scale as integer   no-undo .
     1236   define variable v-base as logical   no-undo .
     1237     do
     1238     on error undo, return error return-value
     1239     :
     1240   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1242     (output v-base
     1243     )  .
     1244   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1246     (input  p-obj-type
     1247     ,input  p-obj-code
     1248     ,output v-host-code
     1249     )  .
     1250   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1252     (input  v-host-code
     1253     ,input  today
     1254     ,output v-base-rate
     1255     ,output v-base-scale
     1256     )  .
     1257   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1258   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1259     (input  ?
     1260     ,input  p-obj-type
     1261     ,input  p-obj-code
     1262     ,input  yes
     1263     ,output p-plt-id
     1264     ,output p-plt-db-num
     1265     )  .
     1266      create ub.price-doc-forming.
     1267      assign
     1268         ub.price-doc-forming.plt-id       = p-plt-id
     1269         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1270         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1271         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1272         ub.price-doc-forming.base-rate    = v-base-rate
     1273         ub.price-doc-forming.base-scale   = v-base-scale
     1274         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1275         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1276         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1277         ub.price-doc-forming.stts         = 0
     1278         ub.price-doc-forming.sys-date     = today
     1279         ub.price-doc-forming.sys-time     = time
     1280         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1281         ub.price-doc-forming.who          = v-cntxt-userid
     1282         ub.price-doc-forming.name         = "автосоздание"
     1283      .
     1284      assign
     1285       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1286       p-pdf-id      = ub.price-doc-forming.pdf-id
     1287       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1288       p-plt-id      = ub.price-doc-forming.plt-id
     1289      .
     1290     end.
     1291   end procedure.
     1292   procedure prcreate-new-price-doc-forming-gds :
     1293   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1294   define input  parameter p-obj-type   as character no-undo .
     1295   define input  parameter p-obj-code   as integer   no-undo .
     1296   define input  parameter par-pr-notls as character no-undo .
     1297   define input  parameter par-pr-altex as character no-undo .
     1298   define input  parameter par-pr-sclex as character no-undo .
     1299   define input  parameter p-line-num    as integer   no-undo .
     1300   define input  parameter p-gds-code    as integer   no-undo .
     1301   define input  parameter p-price-sale  as decimal   no-undo .
     1302   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1303   define buffer buf_goods for ub.goods  .
     1304   define buffer buf_bar-code for ub.bar-code  .
     1305   define buffer main_bar-code for ub.bar-code  .
     1306   define variable main-b-code as integer   no-undo .
     1307   define variable v-sec as integer   no-undo .
     1308     do
     1309     on error undo, return error return-value
     1310     :
     1311   define variable v-cur-dn as character no-undo .
     1312   define variable v-cur-pr as decimal   no-undo .
     1313   define variable v-cur-rt as decimal   no-undo .
     1314   define variable v-cur-ex as decimal   no-undo .
     1315   find first buf_price-doc-forming no-lock where
     1316              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     1317              if error-status :error then return error .
     1318   find first buf_goods no-lock where
     1319              buf_goods.gds-code  = p-gds-code no-error .
     1320              if error-status :error then return error .
     1321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1322     (input  buf_goods.gds-code
     1323     ,input  ?
     1324     ,output main-b-code
     1325     ) no-error .
     1326   run check-use-bar-code (main-b-code) no-error .
     1327   if error-status :error then return .
     1328   run create-line-pdf-mpl-lib (
     1329        input buf_price-doc-forming.plt-db-num
     1330       ,input buf_price-doc-forming.plt-id
     1331       ,input buf_price-doc-forming.pdf-db
     1332       ,input buf_price-doc-forming.pdf-id
     1333       ,input p-line-num
     1334       ,input main-b-code
     1335       ,input buf_goods.artic
     1336       ,input buf_goods.prod-type
     1337       ,input buf_goods.prod-code
     1338       ,input ""
     1339       ,input 0
     1340       ,input p-price-sale
     1341       ,input ""
     1342       ,input 0
     1343      ,input-output v-sec ) no-error .
     1344      if error-status :error  then do:
     1345        message
     1346          vss-workfile vss-revision vss-description skip
     1347          error-status :get-message(1) skip
     1348          return-value skip
     1349          "2"
     1350          view-as alert-box error
     1351        .
     1352      end.
     1353   define buffer old_price-list for ub.price-list  .
     1354   if par-pr-notls = "yes" then do:
     1355   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1357     (input  p-obj-type
     1358     ,input  p-obj-code
     1359     ,input  main-b-code
     1360     ,input  0
     1361     ,input  0
     1362     ,output v-cur-dn
     1363     ,output v-cur-pr
     1364     ,output v-cur-rt
     1365     ,output v-cur-ex
     1366     )  .
     1367   end.
     1368   if par-pr-altex = "yes" and
     1369      par-pr-notls = "yes" then do:
     1370       if v-cur-dn <> "" then do:
     1371           for each old_price-list no-lock where
     1372                    old_price-list.doc-num = v-cur-dn and
     1373                    old_price-list.artic      = buf_goods.artic and
     1374                    old_price-list.prod-type  = buf_goods.prod-type and
     1375                    old_price-list.prod-code  = buf_goods.prod-code and
     1376                    old_price-list.main-price = no,
     1377                   first buf_bar-code no-lock where
     1378                         buf_bar-code.b-code   = old_price-list.b-code and
     1379                         buf_bar-code.unit-cli <> buf_goods.unit-base
     1380                         :
     1381                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1382                          if error-status :error then next.
     1383                    run create-line-pdf-mpl-lib (
     1384                          input buf_price-doc-forming.plt-db-num
     1385                         ,input buf_price-doc-forming.plt-id
     1386                         ,input buf_price-doc-forming.pdf-db
     1387                         ,input buf_price-doc-forming.pdf-id
     1388                         ,input p-line-num
     1389                         ,input old_price-list.b-code
     1390                         ,input buf_goods.artic
     1391                         ,input buf_goods.prod-type
     1392                         ,input buf_goods.prod-code
     1393                         ,input ""
     1394                         ,input 0
     1395                         ,input old_price-list.price-sale
     1396                         ,input ""
     1397                         ,input 0
     1398                        ,input-output v-sec ) no-error .
     1399           end.
     1400       end.
     1401   end.
     1402   if par-pr-sclex = "yes" and
     1403      par-pr-notls = "yes" then do:
     1404       if v-cur-dn <> "" then do:
     1405           for each old_price-list no-lock where
     1406                    old_price-list.doc-num    = v-cur-dn and
     1407                    old_price-list.artic      = buf_goods.artic and
     1408                    old_price-list.prod-type  = buf_goods.prod-type and
     1409                    old_price-list.prod-code  = buf_goods.prod-code and
     1410                    old_price-list.main-price = no,
     1411                   first buf_bar-code no-lock where
     1412                         buf_bar-code.b-code   = old_price-list.b-code and
     1413                         buf_bar-code.in-code  = "" and
     1414                         buf_bar-code.unit-cli = buf_goods.unit-base
     1415                         :
     1416                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1417                          if error-status :error then next.
     1418                    run create-line-pdf-mpl-lib (
     1419                          input buf_price-doc-forming.plt-db-num
     1420                         ,input buf_price-doc-forming.plt-id
     1421                         ,input buf_price-doc-forming.pdf-db
     1422                         ,input buf_price-doc-forming.pdf-id
     1423                         ,input p-line-num
     1424                         ,input old_price-list.b-code
     1425                         ,input buf_goods.artic
     1426                         ,input buf_goods.prod-type
     1427                         ,input buf_goods.prod-code
     1428                         ,input ""
     1429                         ,input 0
     1430                         ,input old_price-list.price-sale
     1431                         ,input ""
     1432                         ,input 0
     1433                       ,input-output v-sec ) no-error .
     1434           end.
     1435       end.
     1436   end.
     1437   end.
     1438   end procedure.
     1439   procedure copy_new_price-doc-forming :
     1440   define input  parameter       p-recid      as recid no-undo .
     1441   define input-output parameter p-plt-db-num as integer   no-undo .
     1442   define input-output parameter p-plt-id     as integer   no-undo .
     1443   define output parameter       p-pdf-db-num as integer   no-undo .
     1444   define output parameter       p-pdf-id     as integer   no-undo .
     1445   define buffer buf_price-list-type        for ub.price-list-type  .
     1446   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1447   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1448   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1449   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1450   define variable v-host-code  as integer   no-undo .
     1451   define variable v-base-rate  as decimal   no-undo .
     1452   define variable v-base-scale as integer   no-undo .
     1453   define variable v-exch-rate  as decimal   no-undo .
     1454   define variable v-exch-scale as integer   no-undo .
     1455   define variable v-base as logical   no-undo .
     1456   define variable v-name as character no-undo .
     1457     do
     1458     on error undo, return error return-value
     1459     :
     1460   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1462     (output v-base
     1463     )  .
     1464   find first buf_price-list-type no-lock where
     1465              buf_price-list-type.plt-db-num = p-plt-db-num and
     1466              buf_price-list-type.plt-id     = p-plt-id no-error .
     1467   if error-status :error then return error "Не найден ТПЛ".
     1468   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1469   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1470       if available buf_price-doc-forming then do :
     1471           assign
     1472             v-base-rate  = buf_price-doc-forming.base-rate
     1473             v-base-scale = buf_price-doc-forming.base-scale
     1474             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1475           .
     1476       end.
     1477       else do:
     1478           assign
     1479             v-base-rate  = 1
     1480             v-base-scale = 1
     1481             v-name       = "Автосоздание"
     1482           .
     1483       end.
     1484      create ub.price-doc-forming.
     1485      assign
     1486         ub.price-doc-forming.plt-id       = p-plt-id
     1487         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1488         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1489         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1490         ub.price-doc-forming.base-rate    = v-base-rate
     1491         ub.price-doc-forming.base-scale   = v-base-scale
     1492         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1493         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1494         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1495         ub.price-doc-forming.stts         = 0
     1496         ub.price-doc-forming.sys-date     = today
     1497         ub.price-doc-forming.sys-time     = time
     1498         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1499         ub.price-doc-forming.who          = v-cntxt-userid
     1500         ub.price-doc-forming.name         = v-name
     1501      .
     1502      assign
     1503       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1504       p-pdf-id      = ub.price-doc-forming.pdf-id
     1505       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1506       p-plt-id      = ub.price-doc-forming.plt-id
     1507      .
     1508     end.
     1509     if not available buf_price-doc-forming then return .
     1510   for each buf_price-doc-forming-attr no-lock where
     1511            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1512            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1513            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1514            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1515       create ub.price-doc-forming-attr.
     1516       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1517       assign
     1518         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1519         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1520         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1521         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1522         .
     1523   end.
     1524   for each buf_price-doc-forming-gds no-lock where
     1525            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1526            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1527            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1528            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1529       create ub.price-doc-forming-gds.
     1530       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1531       assign
     1532         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1533         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1534         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1535         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1536       .
     1537   end.
     1538   for each buf_pd-forming-gds-attr no-lock where
     1539            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1540            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1541            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1542            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1543       create ub.price-doc-forming-gdsattr.
     1544       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1545       assign
     1546         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1547         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1548         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1549         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1550       .
     1551   end.
     1552   end procedure.
     1553   define variable v-rec-list-cli as character no-undo .
     1554   define variable g-log          as logical   no-undo .
     1555   define variable br-handle      as handle    no-undo .
     1556   define variable buffer-handle  as handle    no-undo .
     1557   define variable next-prev      as logical   no-undo .
     1558   define variable v-rec-list     as character no-undo .
     1559   define variable ref-rec        as recid     no-undo .
     1560   define variable loc_gop-db-num as integer   no-undo .
     1561   define variable loc_gop-id     as integer   no-undo .
     1562   define variable var-paket      as logical   no-undo init false .
     1563   define variable filter-point   as character no-undo init "pdf-list" .
     1564   define variable filter-label   as character no-undo init "Список всех ДНЦ" .
     1565   define variable v-title-0      as character no-undo .
     1566   define variable sort-column-name    as character no-undo .
     1567   define variable v-flt-rec           as character no-undo .
     1568   define variable v-filter-name       as character no-undo .
     1569   define variable v-where-phrase      as character no-undo .
     1570   define variable v-sort-phrase       as character no-undo .
     1571   define variable v-where-phrase-rus  as character no-undo .
     1572   define variable v-sort-phrase-rus   as character no-undo .
     1573   function mark-string returns character
     1574     ( buffer loc-table for ub.price-doc-forming, input mark-list as character  ) :
     1575     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
     1576   end function.
     1577   function stts-string returns character
     1578     ( buffer loc-table for ub.price-doc-forming   ) :
     1579    case loc-table.stts :
     1580       when 0 then return 'новый':U .
     1581       when 1 then return 'удал':U .
     1582       when 3 then return 'факт':U .
     1583       when 4 then return 'готов':U .
     1584    end case.
     1585   end function.
     1586   function activ-pr returns character
     1587     ( buffer loc-table for ub.price-doc-forming  ) :
     1588   define buffer buf_price-all  for ub.price-all .
     1589   define buffer buf2_price-all for ub.price-all .
     1590     find first buf_price-all no-lock where
     1591                buf_price-all.pdf-db = loc-table.pdf-db  and
     1592                buf_price-all.pdf-id = loc-table.pdf-id  and
     1593                buf_price-all.plt-db-num = loc-table.plt-db-num and
     1594                buf_price-all.plt-id     = loc-table.plt-id and
     1595                buf_price-all.status_    = 'акт':U
     1596                no-error .
     1597      if available buf_price-all then do:
     1598               find first buf2_price-all no-lock where
     1599                         buf2_price-all.pdf-db = loc-table.pdf-db  and
     1600                         buf2_price-all.pdf-id = loc-table.pdf-id  and
     1601                         buf2_price-all.plt-db-num = loc-table.plt-db-num and
     1602                         buf2_price-all.plt-id     = loc-table.plt-id and
     1603                         buf2_price-all.status_    <> 'акт':U
     1604                         no-error .
     1605                if available buf2_price-all then return "не все" .
     1606                else return "все +" .
     1607         end.
     1608      else do:
     1609         return "".
     1610      end.
     1611   end function.
     1612   DEFINE QUERY external_tables FOR buf_price-list-type.
