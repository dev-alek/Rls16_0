     4014   PROCEDURE my_en :
     4015     DISPLAY loc-pdf-id R-status R-obj T-paket FILL-IN-6 FILL-IN-1 FILL-IN-2
     4016             loc_gop_name v-user-name
     4017         WITH FRAME Dialog-Frame.
     4018     ENABLE B-Cancel B-mark B-sel B-add B-lkp B-chg B-del B-close B-print B-sch B-sch B-ftpl
     4019            B-history B-Help B-price-doc B-del-pr loc-pdf-id R-status R-obj
     4020            T-paket BROWSE-1grp b-lkp-pd BROWSE-2-pr FILL-IN-6 FILL-IN-1 FILL-IN-2
     4021            loc_gop_name v-user-name i-schTPL b-copy i-copy
     4022         WITH FRAME Dialog-Frame.
     4023     DISPLAY i-schTPL   WITH FRAME Dialog-Frame.
     4024     VIEW FRAME Dialog-Frame.
     4025      run openbr  in this-procedure .
     4026   END PROCEDURE.
     4027   PROCEDURE openbr :
     4028   define variable p-open-query       as logical no-undo init true .
     4029   define variable l-query-was-opened as logical no-undo .
     4030   define variable doc-rec  as recid     no-undo .
     4031   define variable p-find-next      as logical   no-undo .
     4032   define variable p-find-condition as character no-undo .
     4033   define variable sort-column-phrase as character no-undo .
     4034   case sort-column-name :
     4035     when "" then do:
     4036       assign
     4037         sort-column-phrase = ""
     4038       .
     4039     end.
     4040     otherwise do:
     4041       assign
     4042         sort-column-phrase = "by " + sort-column-name
     4043       .
     4044     end.
     4045   end case.
     4046   define variable title0 as character no-undo init "Список ДНЦ" .
     4047   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4048   define variable  l-disable-where-41  as logical   no-undo .
     4049   define variable  l-filter-open-41    as logical   .
     4050   define variable  flt-rec-41       as recid     no-undo .
     4051   define variable  filter-name-41      as character no-undo .
     4052   define variable  where-phrase-41     as character no-undo .
     4053   define variable  sort-phrase-41      as character no-undo .
     4054   define variable  where-phrase-rus-41 as character no-undo .
     4055   define variable  sort-phrase-rus-41  as character no-undo .
     4056     run waitfram-show in this-procedure
     4057       (input "ЖДИТЕ ..."
     4058       ).
     4059   run gbl/flt-get.p
     4060     (input filter-point
     4061     ,output flt-rec-41
     4062     ,output filter-name-41
     4063     ,output where-phrase-41
     4064     ,output sort-phrase-41
     4065     ,output where-phrase-rus-41
     4066     ,output sort-phrase-rus-41
     4067     ).
     4068   if p-open-query then do:
     4069       run set-filter-name in this-procedure
     4070         (INPUT filter-name-41
     4071         ) no-error .
     4072     assign
     4073       l-filter-open-41 = false
     4074     .
     4075     if flt-rec-41 <> ?
     4076       or sort-column-phrase > ""
     4077     then do:
     4078       define variable  parameter-2-41 as character no-undo .
     4079       define variable  parameter-3-41 as character no-undo .
     4080       define variable  parameter-4-41 as character no-undo .
     4081       define variable  parameter-5-41 as character no-undo .
     4082       define variable  parameter-6-41 as character no-undo .
     4083       define variable  parameter-7-41 as character no-undo .
     4084         assign
     4085         parameter-3-41 =
     4086                                 "FOR EACH buf_price-doc-forming"
     4087         parameter-4-41 =
     4088           (
     4089             if ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND                    ( p-mode = 'all' OR                    ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-41) <> ""
     4090             then  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) AND                          ( &5&2&5 = &5all&5 OR                       ( buf_price-doc-forming.plt-id = &3 AND                          buf_price-doc-forming.plt-db-num = &4 )) ' ,                         r-status, p-mode, p-plt-id, p-plt-db-num , chr(34)                         )  + " " + where-phrase-41
     4091             else "true"
     4092           )
     4093         parameter-5-41 = (" " + " " + " " + substitute(' ,     FIRST buf_price-list-type  WHERE            buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num &5 AND            ( &4 = 2 OR  ( buf_price-list-type.gop-id     = &2 AND                             buf_price-list-type.gop-db-num = &3 )) &6 ', chr(34) , loc_gop-id , loc_gop-db-num , r-obj  ,v-where-phrase , v-sort-phrase))
     4094         parameter-6-41 = if sort-phrase-41 = ''
     4095                              then
     4096           (
     4097           " " + "" +
     4098             " " + sort-column-phrase +
     4099           " " + "  "
     4100           )
     4101                              else
     4102           (
     4103           " " + "" +
     4104             " " + sort-column-phrase +
     4105           " " + sort-phrase-41
     4106           )
     4107         parameter-7-41 =
     4108           "   "
     4109       .
     4110       do
     4111       on stop undo, leave
     4112       on error undo, leave
     4113       :
     4114         assign
     4115           l-disable-where-41 =
     4116             ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND                    ( p-mode = 'all' OR                    ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-41 = "")
     4117         .
     4118         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4119                             ,input query BROWSE-1grp:handle
     4120                             ,input parameter-3-41
     4121                             ,input parameter-4-41
     4122                             ,input parameter-5-41
     4123                             ,input parameter-6-41
     4124                             ,input parameter-7-41
     4125                             )
     4126         .
     4127         assign
     4128           l-filter-open-41 = true
     4129         .
     4130       end.
     4131       if l-filter-open-41 = false then do:
     4132         message
     4133           "Ошибка при фильтрации / сортировке" skip
     4134           "Будут показаны записи без учета фильтра" skip
     4135           view-as alert-box .
     4136       end.
     4137       else do:
     4138           assign
     4139             l-query-was-opened = true
     4140           .
     4141       end.
     4142     end.
     4143     if l-filter-open-41 = false then do:
     4144       OPEN QUERY BROWSE-1grp FOR EACH buf_price-doc-forming no-lock
     4145         where ( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND                    ( p-mode = 'all' OR                    ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num ))
     4146       ,     FIRST buf_price-list-type  WHERE           buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND             buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num AND           ( r-obj = 2 OR  ( buf_price-list-type.gop-id     = loc_gop-id AND                              buf_price-list-type.gop-db-num = loc_gop-db-num ))
     4147     .
     4148         assign
     4149           l-query-was-opened = true
     4150         .
     4151     end.
     4152   end.
     4153   else do:
     4154     assign
     4155       doc-rec = recid( buf_price-doc-forming )
     4156     .
     4157     do
     4158     on stop undo, leave
     4159     on error undo, leave
     4160     :
     4161       if query BROWSE-1grp:handle:get-buffer-handle(1) = (buffer buf_price-doc-forming:handle) then do:
     4162         assign
     4163         parameter-2-41 = (if p-find-next then "true":u else "false":u )
     4164         parameter-4-41 =
     4165           "where ":u +  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) AND                          ( &5&2&5 = &5all&5 OR                       ( buf_price-doc-forming.plt-id = &3 AND                          buf_price-doc-forming.plt-db-num = &4 )) ' ,                         r-status, p-mode, p-plt-id, p-plt-db-num , chr(34)                         )  + " ":u + where-phrase-41 + " ":u + p-find-condition + " " + " "
     4166         parameter-5-41 = ""
     4167       .
     4168         run fltopend_fltfindd in this-procedure  (
     4169                             input this-procedure:handle
     4170                             ,input query BROWSE-1grp:handle
     4171                             ,input rowid(buf_price-doc-forming)
     4172                             ,input logical(parameter-2-41)
     4173                             ,input no-lock
     4174                             ,input (buffer buf_price-doc-forming:handle)
     4175                             ,input parameter-4-41
     4176                             ,input parameter-5-41
     4177                             ) no-error.
     4178         .
     4179         assign
     4180           doc-rec = integer(return-value)
     4181           v-fltopend-rowid[1] = ?
     4182         .
     4183       end.
     4184       else do:
     4185         assign
     4186         parameter-2-41 = (if p-find-next then "true":u else "false":u )
     4187         parameter-3-41 =  "FOR EACH buf_price-doc-forming"
     4188         parameter-4-41 =
     4189           (
     4190             if ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND                    ( p-mode = 'all' OR                    ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-41) <> ""
     4191             then  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) AND                          ( &5&2&5 = &5all&5 OR                       ( buf_price-doc-forming.plt-id = &3 AND                          buf_price-doc-forming.plt-db-num = &4 )) ' ,                         r-status, p-mode, p-plt-id, p-plt-db-num , chr(34)                         )  + " " + where-phrase-41
     4192             else "true"
     4193           )
     4194         parameter-5-41 = (" " + " " + " " + substitute(' ,     FIRST buf_price-list-type  WHERE            buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num &5 AND            ( &4 = 2 OR  ( buf_price-list-type.gop-id     = &2 AND                             buf_price-list-type.gop-db-num = &3 )) &6 ', chr(34) , loc_gop-id , loc_gop-db-num , r-obj  ,v-where-phrase , v-sort-phrase) + " " + p-find-condition)
     4195         parameter-6-41 = if sort-phrase-41 = ''
     4196                              then
     4197           (
     4198           " " + "" +
     4199             " " + sort-column-phrase +
     4200           " " + "  "
     4201           )
     4202                              else
     4203           (
     4204           " " + "" +
     4205             " " + sort-column-phrase +
     4206           " " + sort-phrase-41
     4207           )
     4208         parameter-7-41 =
     4209           "   "
     4210       .
     4211         run fltopend_fltfindq in this-procedure  (
     4212                             input this-procedure:handle
     4213                             ,input query BROWSE-1grp:handle
     4214                             ,input logical(parameter-2-41)
     4215                             ,input no-lock
     4216                             ,input parameter-3-41
     4217                             ,input parameter-4-41
     4218                             ,input parameter-5-41
     4219                             ,input parameter-6-41
     4220                             ,input parameter-7-41
     4221                             ,output v-fltopend-rowid
     4222                             ) no-error.
     4223         .
     4224         doc-rec = ?.
     4225       end.
     4226       assign
     4227         l-query-was-opened = true
     4228       .
     4229     end.
     4230   end.
     4231     run waitfram-hide in this-procedure .
     4232   APPLY "VALUE-CHANGED" TO BROWSE-1grp in frame Dialog-Frame.
     4233   APPLY "ENTRY" TO BROWSE-1grp.
     4234     OPEN QUERY BROWSE-2-pr FOR EACH buf_price-doc NO-LOCK WHERE       buf_price-doc.pdf-id = buf_price-doc-forming.pdf-id AND       buf_price-doc.pdf-db = buf_price-doc-forming.pdf-db AND       buf_price-doc.plt-id = buf_price-doc-forming.plt-id AND       buf_price-doc.plt-db-num = buf_price-doc-forming.plt-db-num INDEXED-REPOSITION.
     4235   END PROCEDURE.
     4236   PROCEDURE seach-pdf-id :
     4237   define input  parameter p-id as INTEGER no-undo .
     4238   define input  parameter p-next as logical   no-undo .
     4239   if p-next = true then do:
     4240      find next buf_price-doc-forming no-lock where
     4241         buf_price-doc-forming.pdf-id     = p-id no-error .
     4242         if not available buf_price-doc-forming then do:
     4243           message "Еще запись не найдена ! " view-as alert-box information .
     4244           return .
     4245         end.
     4246   end.
     4247   else do:
     4248     find first buf_price-doc-forming no-lock where
     4249                buf_price-doc-forming.pdf-id     = p-id
     4250    no-error .
     4251                 if not available buf_price-doc-forming then do:
     4252                   message "Запись не найдена !" view-as alert-box information .
     4253                   return .
     4254                 end.
     4255   end.
     4256   reposition BROWSE-1grp to rowid rowid(buf_price-doc-forming) no-error .
     4257   apply "value-changed" to BROWSE-1grp in frame Dialog-Frame.
     4258   END PROCEDURE.
     4259   PROCEDURE set-filter-name :
     4260     define input parameter p-filter-name as character no-undo .
     4261     do with frame Dialog-Frame:
     4262       if p-filter-name > "" then do:
     4263         assign
     4264           frame Dialog-Frame:title
     4265             = v-title-0  + "   ФИЛЬТР: " + p-filter-name.
     4266         .
     4267         assign
     4268           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4269         .
     4270       end.
     4271       else do:
     4272         assign
     4273           b-sch :TOOLTIP = ""
     4274           frame Dialog-Frame:title = v-title-0 .
     4275         .
     4276       end.
     4277     end.
     4278   END PROCEDURE.
