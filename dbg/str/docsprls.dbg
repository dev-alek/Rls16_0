        1   DEFINE BUFFER buf_price-doc FOR ub.price-doc.
        2   DEFINE BUFFER buf_price-doc-forming FOR ub.price-doc-forming.
        3   DEFINE NEW SHARED BUFFER buf_price-list-type FOR ub.price-list-type.
        4   define input  parameter parParentProc as handle no-undo .
        5   define input  parameter p-mode  as character no-undo .
        6   define input  parameter p-plt-id as int no-undo .
        7   define input  parameter p-plt-db-num as int no-undo .
        8   define input  parameter p-bttns as character no-undo .
        9   define input-output parameter  p-rec-list as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список документов назначения цены".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#library  as handle no-undo .
      120   define new global shared variable g#library2 as handle no-undo .
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122     define variable v-cntxt-db-num        as integer   no-undo .
      123     define variable v-cntxt-userid        as character no-undo .
      124     define variable v-cntxt-level         as character no-undo .
      125     define variable v-cntxt-host-code-obj as integer   no-undo .
      126     define variable v-cntxt-obj-type      as character no-undo .
      127     define variable v-cntxt-obj-code      as integer   no-undo .
      128     define variable v-cntxt-db-num-obj    as integer   no-undo .
      129     define variable v-cntxt-is-admin      as logical   no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131     run mainmenu_getcntxt in parparentproc
      132       (output v-cntxt-db-num
      133       ,output v-cntxt-userid
      134       ,output v-cntxt-level
      135       ,output v-cntxt-host-code-obj
      136       ,output v-cntxt-obj-type
      137       ,output v-cntxt-obj-code
      138       ,output v-cntxt-db-num-obj
      139       ,output v-cntxt-is-admin
      140       ) .
      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define variable v-waitfram-action01         as character   no-undo .
      143   define variable v-waitfram-action02         as character   no-undo .
      144   define variable v-waitfram-action03         as character   no-undo .
      145   define variable mWaitFramTextBeg            as character   no-undo.
      146   define variable mWaitFramTextEnd            as character   no-undo.
      147   define variable mWaitFramView               as logical     no-undo.
      148   define variable mWaitProcEvent              as logical     no-undo init yes.
      149   define variable mWaitFramInterval           as integer     no-undo init 1 .
      150   define variable mWaitFramStop               as logical     no-undo.
      151   define variable mWaitFramStopUser           as logical     no-undo.
      152   define variable mWaitFramStopTimeOut        as logical     no-undo.
      153   define variable mWaitFramStartProc          as datetime-tz no-undo.
      154   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      155   define button B-WaitFramStop auto-end-key
      156        label "Стоп"
      157        size 10 by 1 tooltip "Остоновить процесс".
      158   define button B-viewProcInfo
      159        label "Информация"
      160        size 15 by 1 tooltip "Информация о процесс".
      161   define frame waitfram
      162     v-waitfram-action01 format "x(72)" no-label skip
      163     v-waitfram-action02 format "x(72)" no-label skip
      164     v-waitfram-action03 format "x(72)" no-label skip
      165     B-viewProcInfo
      166     B-WaitFramStop at row 4 col 30
      167     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      168     .
      169   define new global shared variable mBatchMode as logical no-undo init ?.
      170   define variable mFramBachModHandle as handle no-undo.
      171   mFramBachModHandle = frame waitfram:handle.
      172   define variable mFameOldVis as logical no-undo.
      173   define variable mVisCUrentVin as logical no-undo.
      174   if session:batch-mode
      175   then
      176      mBatchMode = yes.
      177   if mBatchMode = ? then do:
      178     mVisCUrentVin = current-window:visible.
      179     mFameOldVis = mFramBachModHandle:visible.
      180     mFramBachModHandle:visible  = yes.
      181     mBatchMode = mFramBachModHandle:visible ne yes.
      182     mFramBachModHandle:visible = mFameOldVis.
      183     current-window:visible = mVisCUrentVin.
      184   end.
      185    if  log-manager:logfile-name ne ?
      186     then DO:
      187         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      188         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      189         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      190     end.
      191   on choose of B-WaitFramStop in frame waitfram
      192   do:
      193     mWaitFramStop = yes.
      194     mWaitFramStopUser = yes.
      195   end.
      196   function waitfram-check-timeout returns logical():
      197      define variable vtime as int64 no-undo.
      198      if mWaitFramStopTimeOut
      199      then
      200         return yes.
      201      vtime = ( now - mWaitFramStartProc ) / 1000 .
      202      if     mWaitFramTimeOut ne ?
      203         and mWaitFramTimeOut ne 0
      204         and mWaitFramTimeOut lt vtime
      205      then do:
      206         mWaitFramStopTimeOut = yes.
      207      end.
      208      return mWaitFramStopTimeOut.
      209   end.
      210   procedure waitfram-hide :
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       pause 0 before-hide .
      216       if not mBatchMode then
      217         hide frame waitfram .
      218     if     not mWaitFramView
      219        and mWaitProcEvent
      220     then
      221       process events .
      222     end.
      223   end procedure.
      224   procedure waitfram-show :
      225     define input  parameter p-message as character no-undo .
      226     define variable v-left-margin as integer   no-undo .
      227     if not session:batch-mode
      228     then do
      229     on error undo, return error return-value
      230     :
      231       if length(p-message) <= 70 then do:
      232         assign
      233           v-left-margin = integer((70 - length(p-message)) / 2)
      234         .
      235         assign
      236           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      237         .
      238         assign
      239           v-waitfram-action01 = " "
      240           v-waitfram-action02 = " "
      241                                    + fill(" ", v-left-margin)
      242                                    + p-message
      243           v-waitfram-action03 = " "
      244         .
      245       end.
      246       else do:
      247         define variable vRindex1 as integer no-undo.
      248         define variable vRindex2 as integer no-undo.
      249         vRindex1 = r-index(p-message," ",70).
      250         if vRindex1 = 0
      251         then
      252            vRindex1 = 70.
      253         if length(p-message)  <= vRindex1 + 70 then do:
      254           assign
      255             v-waitfram-action01 = " "
      256             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      258           .
      259         end.
      260         else do:
      261           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      262           if vRindex2 <= vRindex1
      263           then
      264              vRindex2 = vRindex1 + 70.
      265           assign
      266             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      268             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      269           .
      270         end.
      271       end.
      272       B-viewProcInfo:visible   in frame waitfram = no.
      273       B-viewProcInfo:sensitive in frame waitfram = no.
      274       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      275       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      276       if  (   mWaitFramView
      277          or  mWaitProcEvent)
      278          and not mBatchMode
      279       then
      280          display
      281             v-waitfram-action01 skip
      282             v-waitfram-action02 skip
      283             v-waitfram-action03 skip
      284          with frame waitfram .
      285       if     mWaitFramView
      286          then do:
      287             if     mWaitFramInterval ne ?
      288                and not mBatchMode
      289             then
      290                wait-for go of frame waitfram pause mWaitFramInterval.
      291          end.
      292          else
      293             if     mWaitProcEvent
      294                and not mBatchMode
      295             then
      296                process events .
      297     end.
      298   end procedure.
      299      procedure waitfram-show-this:
      300         define input  parameter iInterval as int64 no-undo.
      301         define variable vtime as int64 no-undo.
      302         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      303         mWaitFramInterval = iInterval.
      304         run waitfram-show (substitute("&1&2 &3&4" ,
      305                                       mWaitFramTextBeg ,
      306                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      307                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      308                                       mWaitFramTextEnd
      309                                      )
      310                           ).
      311      end.
      312      procedure WaitFramRunPause:
      313         define input  parameter iInterval as dec no-undo.
      314         define variable vStart  as datetime-tz no-undo.
      315         define variable vend    as datetime-tz no-undo.
      316         define variable vint as int64 no-undo.
      317         define variable vOk as logical no-undo.
      318         vStart = now.
      319         vend   = vStart.
      320         publish "WaitFramPause" (iInterval,output vOk).
      321         vend   =  now.
      322         vint = vend - vStart.
      323         vint = iInterval - vint / 1000.
      324         if     not mWaitFramStop
      325            and (   vint > 0
      326                 or (    not vOk
      327                     and iInterval eq ?
      328                     )
      329                 )
      330         then
      331            run waitfram-show-this (iInterval).
      332         vend   =  now.
      333         vint = vend - vStart.
      334         vint = iInterval - vint / 1000.
      335         if     not mWaitFramStop
      336            and vint > 0
      337         then do:
      338            run gbl/pause.p (vint * 1000).
      339         end.
      340         if iInterval ne ?
      341         then
      342            publish "WaitFramStop".
      343         waitfram-check-timeout().
      344      end.
      345      procedure WaitFramWaitFor:
      346         define input  parameter iInterval as dec no-undo.
      347         assign
      348            mWaitFramStartProc   = now
      349            mWaitFramStopUser    = no
      350            mWaitFramStopTimeOut = no
      351         .
      352         block-wait:
      353         do while not mWaitFramStop:
      354            run WaitFramRunPause (iInterval).
      355            if  waitfram-check-timeout()
      356            then do:
      357               leave block-wait.
      358            end.
      359         end.
      360         run waitfram-hide.
      361      end.
      362   procedure waitfram-join :
      363     define input  parameter p-line-1  as character no-undo .
      364     define input  parameter p-line-2  as character no-undo .
      365     define input  parameter p-line-3  as character no-undo .
      366     define output parameter p-message as character no-undo .
      367     do
      368     on error undo, return error return-value
      369     :
      370       assign
      371         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      372                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      374       .
      375     end.
      376   end procedure.
      377   function waitfram-join-function returns character
      378     (input p-line-1 as character
      379     ,input p-line-2 as character
      380     ,input p-line-3 as character
      381     ).
      382     define variable v-message as character no-undo .
      383     run waitfram-join in this-procedure
      384       (input  p-line-1
      385       ,input  p-line-2
      386       ,input  p-line-3
      387       ,output v-message
      388       ) .
      389     return v-message .
      390   end function .
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define temp-table x_obj-group no-undo like ub.clients  .
      393   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      394   procedure metod-gop-obj :
      395     do
      396     on error undo, return error return-value
      397     :
      398   define input  parameter p-cntxt-db-num as integer   no-undo .
      399   define input  parameter p-gop-id       as integer   no-undo .
      400   define input  parameter p-gop-db-num   as integer   no-undo .
      401   define buffer buf1_clients for ub.clients  .
      402   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      403   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      404   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      405   for each  x_obj-group : delete x_obj-group. end.
      406   if p-gop-id = 0 or p-gop-id = ?  then do:
      407      if p-cntxt-db-num = 0  then do:
      408           for each buf1_clients no-lock where
      409                   (buf1_clients.obj-type = 'маг':U  or
      410                    buf1_clients.obj-type = 'скл':U  )
      411                   and
      412                   buf1_clients.db-num >= 0  and
      413                   buf1_clients.stts = 0
      414                   :
      415             create x_obj-group .
      416             assign
      417               x_obj-group.obj-code   = buf1_clients.obj-code
      418               x_obj-group.obj-type   = buf1_clients.obj-type
      419               x_obj-group.obj-name   = buf1_clients.obj-name
      420               x_obj-group.db-num     = buf1_clients.db-num
      421             .
      422           end.
      423      end.
      424      else do:
      425           for each buf1_clients no-lock where
      426                   (buf1_clients.obj-type = 'маг':U  or
      427                    buf1_clients.obj-type = 'скл':U  ) and
      428                    buf1_clients.db-num = p-cntxt-db-num  and
      429                    buf1_clients.stts = 0
      430                   :
      431             create x_obj-group .
      432             assign
      433               x_obj-group.obj-code   = buf1_clients.obj-code
      434               x_obj-group.obj-type   = buf1_clients.obj-type
      435               x_obj-group.obj-name   = buf1_clients.obj-name
      436               x_obj-group.db-num     = buf1_clients.db-num
      437             .
      438           end.
      439      end.
      440   end.
      441   else do:
      442         for each buf_db-grp-obj-price  where
      443                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      444                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      445                 buf_db-grp-obj-price.stts = 0  no-lock :
      446           for each buf1_clients no-lock where
      447                  (buf1_clients.obj-type = 'маг':U  or
      448                   buf1_clients.obj-type = 'скл':U  ) and
      449                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      450                   buf1_clients.stts = 0
      451                   :
      452             create x_obj-group .
      453             assign
      454               x_obj-group.obj-code   = buf1_clients.obj-code
      455               x_obj-group.obj-type   = buf1_clients.obj-type
      456               x_obj-group.obj-name   = buf1_clients.obj-name
      457               x_obj-group.db-num     = buf1_clients.db-num
      458             .
      459           end.
      460         end.
      461       for each buf_host-grp-obj-price where
      462               buf_host-grp-obj-price.gop-id     = p-gop-id and
      463               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      464               buf_host-grp-obj-price.stts = 0
      465               no-lock :
      466         for each buf1_clients no-lock where
      467                (buf1_clients.obj-type = 'маг':U  or
      468                 buf1_clients.obj-type = 'скл':U  ) and
      469                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      470                 buf1_clients.stts = 0
      471                 :
      472             find first x_obj-group no-lock  where
      473                       x_obj-group.obj-code   = buf1_clients.obj-code and
      474                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      475             if not available  x_obj-group then   create x_obj-group .
      476             assign
      477               x_obj-group.obj-code   = buf1_clients.obj-code
      478               x_obj-group.obj-type   = buf1_clients.obj-type
      479               x_obj-group.obj-name   = buf1_clients.obj-name
      480               x_obj-group.db-num     = buf1_clients.db-num
      481             .
      482         end.
      483       end.
      484       for each buf_obj-grp-obj-price where
      485               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      486               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      487               buf_obj-grp-obj-price.stts = 0
      488               no-lock :
      489         for each buf1_clients no-lock where
      490                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      491                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      492                   buf1_clients.stts     = 0
      493                   :
      494             find first  x_obj-group no-lock  where
      495                         x_obj-group.obj-code   = buf1_clients.obj-code and
      496                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      497             if not available  x_obj-group then   create x_obj-group .
      498             assign
      499               x_obj-group.obj-code   = buf1_clients.obj-code
      500               x_obj-group.obj-type   = buf1_clients.obj-type
      501               x_obj-group.obj-name   = buf1_clients.obj-name
      502               x_obj-group.db-num     = buf1_clients.db-num
      503             .
      504         end.
      505       end.
      506   end.
      507   end.
      508   end procedure.
      509   procedure metod-obj-in-gop :
      510   define input  parameter p-curr-db-num as integer   no-undo .
      511   define input  parameter p-obj-type as character no-undo .
      512   define input  parameter p-obj-code as integer   no-undo .
      513   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      514     do
      515     on error undo, return error return-value
      516     :
      517       empty temp-table x_grp-obj-price.
      518       for each buf_grp-obj-price where
      519                buf_grp-obj-price.stts = 0
      520                no-lock :
      521                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      522                  for each x_obj-group where
      523                           x_obj-group.obj-type = p-obj-type and
      524                           x_obj-group.obj-code = p-obj-code :
      525                       create  x_grp-obj-price.
      526                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      527                  end.
      528       end.
      529     end.
      530   end procedure.
      531   procedure metod-delobj-usr :
      532   define input  parameter p-pdf-id  as integer   no-undo .
      533   define input  parameter p-pdf-db  as integer   no-undo .
      534   define input  parameter p-plt-id  as integer   no-undo .
      535   define input  parameter p-plt-db-num as integer   no-undo .
      536   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      537     do
      538     on error undo, return error return-value
      539     :
      540   for each buf_price-doc-forming-attr no-lock  where
      541            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      542            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      543            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      544            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      545            buf_price-doc-forming-attr.attr-code begins "obj" :
      546      for each x_obj-group  where
      547               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      548               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      549        delete x_obj-group.
      550      end.
      551   end.
      552     if not can-find (first x_obj-group) then do:
      553        return "nullobj" .
      554     end.
      555   end.
      556   end procedure.
      557   procedure metod-obj-pdf :
      558   define input  parameter p-cntxt-db-num as integer   no-undo .
      559   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      560   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      561   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      562   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      563   define buffer buf_price-list-type for ub.price-list-type  .
      564   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      565     do
      566     on error undo, return error return-value
      567     :
      568    for each  x_obj-group : delete x_obj-group. end.
      569    find first buf_price-list-type no-lock where
      570               buf_price-list-type.plt-id = p-plt-id and
      571               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      572   if error-status :error then return error return-value .
      573    find first buf_price-doc-forming no-lock where
      574               buf_price-doc-forming.plt-id     = p-plt-id and
      575               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      576               buf_price-doc-forming.pdf-id     = p-pdf-id and
      577               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      578               no-error .
      579   if error-status :error then return error return-value .
      580     run metod-gop-obj in this-procedure (
      581         p-cntxt-db-num,
      582         buf_price-list-type.gop-id ,
      583         buf_price-list-type.gop-db-num
      584         ) no-error .
      585     run metod-delobj-usr in this-procedure (
      586       buf_price-doc-forming.pdf-id ,
      587       buf_price-doc-forming.pdf-db ,
      588       buf_price-doc-forming.plt-id ,
      589       buf_price-doc-forming.plt-db-num
      590       ) no-error .
      591     end.
      592   end procedure.
      593   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      595   procedure price-doc-forming-DELETE :
      596   define input  parameter p-plt-db-num       as integer   no-undo .
      597   define input  parameter p-plt-id           as integer   no-undo .
      598   define input  parameter p-pdf-db-num       as integer   no-undo .
      599   define input  parameter p-pdf-id           as integer   no-undo .
      600   define input  parameter p-db-num-usr       as integer   no-undo .
      601   define input  parameter p-userid           as character no-undo .
      602   define buffer buf_price-list-type for ub.price-list-type  .
      603   define variable v-value-character as character no-undo .
      604   define variable v-date-close-period as date      no-undo .
      605   define variable v-value-decimal as decimal   no-undo .
      606   define variable v-value-integer as integer   no-undo .
      607   define variable v-value-logical as logical   no-undo .
      608   define variable v-value-type as character no-undo .
      609   define variable v-ask  as logical   no-undo init false .
      610     do
      611     on error undo, return error return-value
      612     :
      613   if p-pdf-db-num <> p-db-num-usr then do:
      614      message "Нельзя удалять ДНЦ на чужой БД !" view-as alert-box error .
      615      return .
      616   end.
      617   find first ub.price-doc-forming no-lock  where
      618           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      619           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      620           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      621           ub.price-doc-forming.plt-id       = p-plt-id
      622           no-error .
      623   if  ub.price-doc-forming.STTS = integer('1':U) then do:
      624      message "ДНЦ уже удален !" view-as alert-box error .
      625      return .
      626   end.
      627   if  ub.price-doc-forming.STTS = integer('4':U) then do:
      628      message "ДНЦ в статусе ГОТОВ удалять нельзя !" view-as alert-box error .
      629      return .
      630   end.
      631   if  ub.price-doc-forming.STTS = integer('3':U) then do:
      632   find first ub.price-doc-forming exclusive-lock  where
      633           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      634           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      635           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      636           ub.price-doc-forming.plt-id       = p-plt-id
      637           no-error .
      638    empty temp-table x_obj-group.
      639    find first buf_price-list-type no-lock where
      640               buf_price-list-type.plt-id    =  ub.price-doc-forming.plt-id and
      641               buf_price-list-type.plt-db-num = ub.price-doc-forming.plt-db-num no-error .
      642     run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf_price-list-type.gop-id , buf_price-list-type.gop-db-num) .
      643     run metod-delobj-usr (
      644       ub.price-doc-forming.pdf-id  ,
      645       ub.price-doc-forming.pdf-db ,
      646       ub.price-doc-forming.plt-id    ,
      647       ub.price-doc-forming.plt-db-num
      648       ).
      649    for each x_obj-group :
      650     run adm/shattri.p (
      651          input "get":U
      652         ,input x_obj-group.obj-type
      653         ,input x_obj-group.obj-code
      654         ,input 'nakl_par':U
      655         ,input  "date-close-period"
      656         ,output v-value-character
      657         ,output v-date-close-period
      658         ,output v-value-decimal
      659         ,output v-value-integer
      660         ,output v-value-logical
      661         ,output v-value-type
      662         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      663         ) no-error .
      664     if error-status :error then v-date-close-period = date('').
      665         if v-date-close-period <> date('') then do:
      666             if ub.price-doc-forming.sys-date < v-date-close-period
      667             then do:
      668               message  substitute(
      669                 "Дата закрытия ДНЦ &1 более ранняя, чем дата закрытия периода &2
      670                 Дата закрытия документа  &3 &2
      671                 Дата закрытия периода    &4 &2
      672                 Объект &5 &6 "
      673                 ,
      674                 ub.price-doc-forming.pdf-id  ,
      675                 chr(10)  ,
      676                 string ( ub.price-doc-forming.sys-date , "99/99/9999" ) ,
      677                 string ( v-date-close-period,   "99/99/9999") ,
      678                           x_obj-group.obj-type ,
      679                           x_obj-group.obj-code  ) view-as alert-box information .
      680                 return.
      681             end.
      682         end.
      683     end.
      684       if available ub.price-doc-forming then do :
      685             ub.price-doc-forming.stts = integer('1':U) .
      686             release ub.price-doc-forming.
      687             find first ub.price-doc-forming no-lock  where
      688                     ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      689                     ub.price-doc-forming.pdf-id       = p-pdf-id      and
      690                     ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      691                     ub.price-doc-forming.plt-id       = p-plt-id
      692                     no-error .
      693   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run a-nwspdf in g#library2
      695     (input  ub.price-doc-forming.plt-id
      696     ,input  ub.price-doc-forming.plt-db-num
      697     ,input  ub.price-doc-forming.pdf-id
      698     ,input  ub.price-doc-forming.pdf-db
      699     ,output v-ask
      700     )  .
      701             if v-ask then do:
      702               run str/diallog.w
      703                       ( input parparentproc
      704                       , input this-procedure
      705                       , input 'str/sendpdfr.p':U
      706                       , input ("D":U + chr(4) +
      707                               string(ub.price-doc-forming.plt-id) + chr(4)  +
      708                               string(ub.price-doc-forming.plt-db-num) + chr(4) +
      709                               string(ub.price-doc-forming.pdf-id) + chr(4)  +
      710                               string(ub.price-doc-forming.pdf-db)
      711                               )
      712                       , input yes
      713                       , input '':U
      714                       , input '') no-error .
      715                       if error-status :error then do:
      716                       message
      717                         vss-workfile vss-revision vss-description skip
      718                         error-status :get-message(1) skip
      719                         return-value skip
      720                         "str/sendpdfr.p"
      721                         view-as alert-box error
      722                       .
      723                       end.
      724             end.
      725       end.
      726   end.
      727   if  ub.price-doc-forming.STTS = integer('0':U) then do:
      728   find first ub.price-doc-forming exclusive-lock  where
      729           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      730           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      731           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      732           ub.price-doc-forming.plt-id       = p-plt-id
      733           no-error .
      734       if available ub.price-doc-forming then do :
      735          delete ub.price-doc-forming.
      736       end.
      737   end.
      738     end.
      739   end procedure.
      740   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      742   procedure fltopend_fltopend :
      743   define input parameter p-parent-handle as handle no-undo .
      744   define input parameter p-qh as handle no-undo .
      745   define input parameter p-flt-open-open-query  as character no-undo .
      746   define input parameter p-where-cond as character no-undo .
      747   define input parameter p-use-indFIRST-query-tail as character no-undo .
      748   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      749   define input parameter p-indexed-reposition as character no-undo .
      750     do
      751     on error undo, return error
      752     :
      753   define variable v-prepare-string as character no-undo .
      754   define variable glog as logical no-undo .
      755   assign
      756   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      757                      p-where-cond + chr(32)  +
      758                      p-use-indFIRST-query-tail + chr(32) +
      759                      p-use-ind-sort-clmn-by + chr(32) +
      760                      p-indexed-reposition
      761   .
      762   assign
      763   glog = p-qh:query-prepare(v-prepare-string) no-error .
      764   if not glog
      765   or error-status:error then do:
      766     message error-status:get-message(1) view-as alert-box .
      767     undo, return error .
      768   end.
      769   assign
      770   glog = p-qh:query-open no-error .
      771   if not glog
      772   or error-status:error then do:
      773     message error-status:get-message(1) view-as alert-box .
      774     undo, return error .
      775   end.
      776     end.
      777   end procedure.
      778   procedure fltopend_fltfindd :
      779   define input parameter p-parent-handle as handle no-undo .
      780   define input parameter p-qh as handle no-undo .
      781   define input parameter p-rowid as rowid no-undo .
      782   define input parameter p-next as logical no-undo .
      783   define input parameter p-lock as integer no-undo .
      784   define input parameter p-bh as handle no-undo .
      785   define input parameter p-where-cond as character no-undo .
      786   define input parameter p-use-index-phrase as character no-undo .
      787   define variable glog as logical no-undo .
      788   define variable v-qh as handle no-undo .
      789   define variable v-bh as handle no-undo .
      790   define variable v-recid as recid no-undo .
      791   define variable v-prepare-string as character no-undo .
      792   do
      793   on error undo, return error
      794   on stop undo, return error
      795   :
      796     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      797     create buffer v-bh for table p-bh buffer-name p-bh:name.
      798     create query v-qh.
      799     v-qh:set-buffers(v-bh).
      800     v-prepare-string = substitute("for each &1 &2 &3"
      801                                     ,v-bh:name
      802                                     ,p-where-cond
      803                                     ,p-use-index-phrase).
      804     glog = v-qh:query-prepare(v-prepare-string) no-error.
      805     if not glog then do:
      806       delete object v-qh.
      807       delete object v-bh.
      808       undo, return error .
      809     end.
      810     glog = v-qh:query-open no-error .
      811     if not glog then do:
      812       delete object v-qh.
      813       delete object v-bh.
      814       undo, return error .
      815     end.
      816     if p-next then do:
      817       v-qh:reposition-to-rowid(p-rowid) no-error .
      818       glog = v-qh:get-next( p-lock) no-error .
      819       glog = v-qh:get-next( p-lock) no-error .
      820       if not glog or v-qh:query-off-end = yes then do:
      821         glog = v-qh:get-first( p-lock) no-error .
      822       end.
      823     end.
      824     else do:
      825       glog = v-qh:get-first( p-lock) no-error .
      826     end.
      827     v-recid = v-bh:recid no-error .
      828     delete object v-qh.
      829     delete object v-bh.
      830     return string(v-recid) .
      831   end.
      832   end procedure.
      833   procedure fltopend_fltfindq :
      834   define input parameter p-parent-handle as handle no-undo .
      835   define input parameter p-qh as handle no-undo .
      836   define input parameter p-next as logical no-undo .
      837   define input parameter p-lock as integer no-undo .
      838   define input parameter p-flt-open-open-query  as character no-undo .
      839   define input parameter p-where-cond as character no-undo .
      840   define input parameter p-use-indFIRST-query-tail as character no-undo .
      841   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      842   define input parameter p-indexed-reposition as character no-undo .
      843   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      844   define variable glog as logical no-undo .
      845   define variable v-qh as handle no-undo .
      846   define variable v-bh as handle no-undo extent 18.
      847   define variable v-rowid as rowid no-undo extent 18.
      848   define variable v-ii as integer no-undo .
      849   define variable v-prepare-string as character no-undo .
      850   do
      851   on error undo, return error
      852   on stop undo, return error
      853   :
      854     create query v-qh.
      855     do v-ii = 1 to p-qh:num-buffers:
      856       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      857       assign
      858       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      859       no-error.
      860       v-qh:add-buffer(v-bh[v-ii]).
      861     end.
      862     assign
      863     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      864                       p-where-cond + chr(32)  +
      865                       p-use-indFIRST-query-tail + chr(32) +
      866                       p-use-ind-sort-clmn-by + chr(32) +
      867                       p-indexed-reposition
      868     .
      869     glog = v-qh:query-prepare( v-prepare-string) no-error .
      870     if not glog then do:
      871       delete object v-qh.
      872       do v-ii = 1 to p-qh:num-buffers:
      873         delete object v-bh[v-ii].
      874       end.
      875       undo, return error .
      876     end.
      877     glog = v-qh:query-open no-error .
      878     if not glog then do:
      879       delete object v-qh.
      880       do v-ii = 1 to p-qh:num-buffers:
      881         delete object v-bh[v-ii].
      882       end.
      883       undo, return error .
      884     end.
      885     if p-next then do:
      886       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      887       glog = v-qh:get-next( p-lock) no-error .
      888       glog = v-qh:get-next( p-lock) no-error .
      889       if not glog or v-qh:query-off-end = yes then do:
      890         glog = v-qh:get-first( p-lock) no-error .
      891       end.
      892     end.
      893     else do:
      894       glog = v-qh:get-first( p-lock) no-error .
      895     end.
      896     do v-ii = 1 to p-qh:num-buffers:
      897       assign
      898       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      899       no-error.
      900     end.
      901     delete object v-qh.
      902     do v-ii = 1 to p-qh:num-buffers:
      903       delete object v-bh[v-ii].
      904     end.
      905   end.
      906   end procedure.
      907   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   define variable c-point  as character no-undo .
      909   define variable tbl      as character no-undo .
      910   define variable join-tbl as character no-undo .
      911   define variable fld      as character no-undo .
      912   define variable lab      as character no-undo .
      913   define variable spr      as character no-undo .
      914   define variable dim      as character no-undo .
      915   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure fltfield-clear :
      917     define output parameter loc-fld as character no-undo.
      918     define output parameter loc-lab as character no-undo .
      919     define output parameter loc-spr as character no-undo .
      920     define output parameter loc-dim as character no-undo .
      921     assign
      922       loc-fld = ""
      923       loc-lab = ""
      924       loc-spr = ""
      925       loc-dim = "0"
      926     .
      927   end procedure .
      928   procedure fltfield-add :
      929     define input        parameter par-fld as character no-undo.
      930     define input        parameter par-lab as character no-undo .
      931     define input        parameter par-spr as character no-undo .
      932     define input-output parameter loc-fld as character no-undo.
      933     define input-output parameter loc-lab as character no-undo .
      934     define input-output parameter loc-spr as character no-undo .
      935     define input-output parameter loc-dim as character no-undo .
      936     do
      937     on error undo, return error
      938     :
      939       assign
      940       loc-fld = if loc-dim = '0'
      941                 then par-fld
      942                 else (loc-fld + chr(44) + par-fld)
      943       loc-lab = if loc-dim = '0'
      944                 then par-lab
      945                 else (loc-lab + chr(44) + par-lab)
      946       loc-spr = if loc-dim = '0'
      947                 then par-spr
      948                 else (loc-spr + chr(44) + par-spr)
      949       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      950                 string(integer(if num-entries(loc-dim) > 1
      951                               then entry(2, loc-dim)
      952                               else entry(1, loc-dim)
      953                               ) + 1)
      954       no-error
      955       .
      956     end.
      957   end procedure.
