     1726   "Все", 2,
     1727   "Закрытые", 3,
     1728   "Готовые", 4,
     1729   "Удаленные", 1
     1730        SIZE 45 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
     1731   DEFINE VARIABLE T-paket AS LOGICAL INITIAL no
     1732        LABEL "пакетный режим"
     1733        VIEW-AS TOGGLE-BOX
     1734        SIZE 17 BY .83 NO-UNDO.
     1735   DEFINE QUERY BROWSE-1grp FOR
     1736         buf_price-doc-forming,
     1737         buf_price-list-type SCROLLING.
     1738   DEFINE QUERY BROWSE-2-pr FOR
     1739         buf_price-doc SCROLLING.
     1740   DEFINE BROWSE BROWSE-1grp
     1741     QUERY BROWSE-1grp NO-LOCK DISPLAY
     1742         mark-string ( buffer buf_price-doc-forming, p-rec-list ) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1743         buf_price-list-type.priority              COLUMN-LABEL "Прио-!ритет" FORMAT ">>>>9":U
     1744         stts-string ( buffer buf_price-doc-forming )             COLUMN-LABEL "Ста-!тус" FORMAT "x(4)":U
     1745         activ-pr ( buffer buf_price-doc-forming ) COLUMN-LABEL "Есть акт!цены"            FORMAT "x(8)":U
     1746         buf_price-doc-forming.pdf-id   COLUMN-LABEL "Код ДНЦ! " FORMAT ">>>>>>>>>9":U
     1747         buf_price-doc-forming.sys-date         COLUMN-LABEL "Дата!изм"  FORMAT "99/99/99":U
     1748         buf_price-doc-forming.sys-time-chr     COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1749         buf_price-doc-forming.name   COLUMN-LABEL "Название документа! " FORMAT "X(100)":U WIDTH 30
     1750         buf_price-list-type.plt-id   COLUMN-LABEL "Код!типа" FORMAT ">>>>>9":U
     1751         buf_price-list-type.main     COLUMN-LABEL "Г! " FORMAT "+/ ":U
     1752         buf_price-list-type.name               COLUMN-LABEL "Тип прайс-листа! " FORMAT "X(100)":U WIDTH 30
     1753         buf_price-doc-forming.db-num-chg       COLUMN-LABEL "БД!изм"    FORMAT ">>>>9":U
     1754         buf_price-doc-forming.pdf-db           COLUMN-LABEL "БД!док" FORMAT ">>>>9":U
     1755         buf_price-list-type.plt-db-num         COLUMN-LABEL "БД!ТПЛ" FORMAT ">>>>9":U
     1756         buf_price-doc-forming.out-code         COLUMN-LABEL "№!накл" FORMAT "X(16)":U
     1757         buf_price-doc-forming.start-date         COLUMN-LABEL "Дата объекта!c"  FORMAT "99/99/99":U
     1758         buf_price-doc-forming.end-date           COLUMN-LABEL "Дата объекта!по"  FORMAT "99/99/99":U
     1759         buf_price-doc-forming.start-sys-date         COLUMN-LABEL "Дата sys!c"  FORMAT "99/99/99":U
     1760         string(buf_price-doc-forming.start-sys-time,"hh:mm:ss")         COLUMN-LABEL "Время sys!c"  FORMAT "x(8)":U
     1761         buf_price-doc-forming.end-sys-date           COLUMN-LABEL "Дата sys!по"  FORMAT "99/99/99":U
     1762         string(buf_price-doc-forming.end-sys-time,"hh:mm:ss")           COLUMN-LABEL "Время sys!по"  FORMAT "x(8)":U
     1763         buf_price-doc-forming.start-shift-date         COLUMN-LABEL "Дата смены!c"  FORMAT "99/99/99":U
     1764         buf_price-doc-forming.start-shift-num          COLUMN-LABEL "№ смены!c"
     1765         buf_price-doc-forming.end-shift-date           COLUMN-LABEL "Дата смены!по"  FORMAT "99/99/99":U
     1766         buf_price-doc-forming.end-shift-num            COLUMN-LABEL "№ смены!по"
     1767     ENABLE
     1768         buf_price-doc-forming.name
     1769       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.63 BY 11.5 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
     1770   DEFINE BROWSE BROWSE-2-pr
     1771     QUERY BROWSE-2-pr NO-LOCK DISPLAY
     1772         buf_price-doc.status_ COLUMN-LABEL "Статус"
     1773         buf_price-doc.doc-num format "x(16)"
     1774         buf_price-doc.doc-date  column-label "Дата"
     1775         buf_price-doc.fact-date COLUMN-LABEL "Факт"
     1776         (trim (buf_price-doc.obj-type) + " " + string (buf_price-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "x(9)"
     1777         buf_price-doc.rest-qnty column-label "Кол-во"
     1778         buf_price-doc.sale-base COLUMN-LABEL "Сумма "
     1779         buf_price-doc.rest-sale COLUMN-LABEL "Было "
     1780         buf_price-doc.out-code  COLUMN-LABEL "Накладная"
     1781       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 5.5 ROW-HEIGHT-CHARS .58.
     1782   DEFINE FRAME Dialog-Frame
     1783        B-Cancel AT ROW 1 COL 1
     1784        B-mark AT ROW 1 COL 11
     1785        B-sel AT ROW 1 COL 14.25
     1786        B-add AT ROW 1 COL 24.25
     1787        B-lkp AT ROW 1 COL 34.25
     1788        B-chg AT ROW 1 COL 44.25
     1789        B-del AT ROW 1 COL 54.25
     1790        B-close AT ROW 1 COL 64.25
     1791        B-ftpl AT ROW 1 COL 74.25 WIDGET-ID 8
     1792        B-sch AT ROW 1 COL 88.5 WIDGET-ID 6
     1793        B-print AT ROW 1 COL 91.5
     1794        B-history AT ROW 1 COL 94
     1795        B-Help AT ROW 1 COL 97
     1796        i-schTPL AT ROW 1.04 COL 74.25 WIDGET-ID 12 NO-TAB-STOP
     1797        B-price-doc AT ROW 2 COL 1
     1798        B-del-pr AT ROW 2 COL 14.13
     1799        B-copy AT ROW 2 COL 29.25 WIDGET-ID 18
     1800        i-copy AT ROW 2.08 COL 29.38 WIDGET-ID 20 NO-TAB-STOP
     1801        loc-pdf-id AT ROW 3 COL 83 COLON-ALIGNED NO-LABEL
     1802        R-status AT ROW 3.25 COL 10.63 NO-LABEL
     1803        R-obj AT ROW 4.13 COL 10.63 NO-LABEL
     1804        T-paket AT ROW 4.13 COL 82.13 WIDGET-ID 4
     1805        BROWSE-1grp AT ROW 5 COL 1.38
     1806        b-lkp-pd AT ROW 16.5 COL 12.38
     1807        BROWSE-2-pr AT ROW 17.5 COL 1.5
     1808        FILL-IN-6 AT ROW 3.17 COL 78.5 NO-LABEL
     1809        FILL-IN-1 AT ROW 3.21 COL 1.88 NO-LABEL
     1810        FILL-IN-2 AT ROW 4.13 COL 1.75 NO-LABEL
     1811        loc_gop_name AT ROW 4.13 COL 24.25 COLON-ALIGNED NO-LABEL
     1812        v-user-name AT ROW 16.5 COL 82 COLON-ALIGNED WIDGET-ID 2
     1813        "ПЕРЕОЦЕНКИ" VIEW-AS TEXT
     1814             SIZE 10.5 BY .67 AT ROW 16.63 COL 1.5
     1815             FGCOLOR 4
     1816        SPACE(88.38) SKIP(5.83)
     1817       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1818            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1819            TITLE "Список документов назначения цены"
     1820            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
     1821   ASSIGN
     1822          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1823          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1824   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1825   DO:
     1826     APPLY "END-ERROR":U TO SELF.
     1827   END.
     1828   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1829   DO:
     1830      define variable g#log as logical   no-undo .
     1831   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1832   do:
     1833     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1834       (input  v-cntxt-db-num
     1835       ,input  v-cntxt-userid
     1836       ,input  0
     1837       ,input  'actn_pdf_update':U
     1838       ,input  'global':U
     1839       ,input  v-cntxt-host-code-obj
     1840       ,input  v-cntxt-obj-type
     1841       ,input  v-cntxt-obj-code
     1842       ,input  0
     1843       ,input  0
     1844       ,input  0
     1845       ,input  true
     1846       ,output g#log
     1847       )  .
     1848   end.
     1849     if not g#log then return .
     1850     define variable v-rec-id as recid no-undo .
     1851     define variable v-recid as character no-undo .
     1852     define buffer buf1_price-list-type for ub.price-list-type  .
     1853     define variable v-only-main  as logical   no-undo .
     1854     define variable v-plt-id     as integer   no-undo .
     1855     define variable v-plt-db-num as integer   no-undo .
     1856     next-prev = false .
     1857   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstmain in g#library
     1859     (output v-only-main
     1860     )  .
     1861     if v-only-main = false then do:
     1862         run ref/typepric.w (
     1863             input parParentProc     ,
     1864             input "b-sel"           ,
     1865             input-output v-recid
     1866             ) no-error .
     1867         find first buf1_price-list-type no-lock where recid(buf1_price-list-type) = int(v-recid) no-error .
     1868     end.
     1869     else do:
     1870   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1871   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1872     (input  parparentproc
     1873     ,input  v-cntxt-obj-type
     1874     ,input  v-cntxt-obj-code
     1875     ,input  no
     1876     ,output v-plt-id
     1877     ,output v-plt-db-num
     1878     ) no-error .
     1879        find first buf1_price-list-type no-lock where
     1880                   buf1_price-list-type.plt-id = v-plt-id and
     1881                   buf1_price-list-type.plt-db-num = v-plt-db-num
     1882                   no-error .
     1883     end.
     1884     if available buf1_price-list-type then do:
     1885         if buf1_price-list-type.stts <> integer('0':U) then do:
     1886            message "ДНЦ можно создать только с текущим типом прайс-листов !" view-as alert-box information  .
     1887            return .
     1888         end.
     1889         if buf1_price-list-type.under-type-list <> 0 then do:
     1890            message "Нельзя выбирать подчиненный прайс-лист !" view-as alert-box information  .
     1891            return .
     1892         end.
     1893         run str/df-price.w
     1894           ( input parparentproc,
     1895             input 'ДОБАВЛЕНИЕ':U ,
     1896             input buf1_price-list-type.plt-id,
     1897             input buf1_price-list-type.plt-db-num ,
     1898             input ? ,
     1899             output v-rec-list ,
     1900             input-output v-rec-id ,
     1901             input-output br-handle ,
     1902             input-output buffer-handle ,
     1903             input-output next-prev
     1904             ) .
     1905         run openbr in this-procedure .
     1906         reposition BROWSE-1grp to recid v-rec-id no-error .
     1907         apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1908       end.
     1909       else do:
     1910         message "Не выбран ТПЛ !!!" view-as alert-box .
     1911         return no-apply .
     1912       end.
     1913   END.
     1914   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1915   DO:
     1916      define variable g#log as logical   no-undo .
     1917   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918   do:
     1919     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1920       (input  v-cntxt-db-num
     1921       ,input  v-cntxt-userid
     1922       ,input  0
     1923       ,input  'actn_pdf_update':U
     1924       ,input  'global':U
     1925       ,input  v-cntxt-host-code-obj
     1926       ,input  v-cntxt-obj-type
     1927       ,input  v-cntxt-obj-code
     1928       ,input  0
     1929       ,input  0
     1930       ,input  0
     1931       ,input  true
     1932       ,output g#log
     1933       )  .
     1934   end.
     1935     if not g#log then return .
     1936     next-prev = false .
     1937     if not available buf_price-doc-forming then return .
     1938     if buf_price-doc-forming.stts <> integer('0':U) then do:
     1939      message "Закрытые или удаленные ДНЦ корректировать нельзя! "
     1940            view-as alert-box information .
     1941      return .
     1942      end.
     1943     define variable v-rec-id as recid no-undo .
     1944     define variable v-recid as character no-undo .
     1945     if available buf_price-doc-forming then do:
     1946         v-rec-id = recid (buf_price-doc-forming) .
     1947         run str/df-price.w
     1948         ( input parparentproc,
     1949           input 'ИЗМЕНЕНИЕ':U ,
     1950           input buf_price-doc-forming.plt-id,
     1951           input buf_price-doc-forming.plt-db-num ,
     1952           input ? ,
     1953           output v-rec-list ,
     1954           input-output v-rec-id ,
     1955           input-output br-handle ,
     1956           input-output buffer-handle ,
     1957           input-output next-prev
     1958           ) .
     1959         run openbr in this-procedure .
     1960         reposition BROWSE-1grp to recid v-rec-id no-error .
     1961         apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     1962       end.
     1963   END.
     1964   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     1965   DO:
     1966      define variable g#log as logical   no-undo .
     1967   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1968   do:
     1969     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1970       (input  v-cntxt-db-num
     1971       ,input  v-cntxt-userid
     1972       ,input  0
     1973       ,input  'actn_pdf_close':U
     1974       ,input  'global':U
     1975       ,input  v-cntxt-host-code-obj
     1976       ,input  v-cntxt-obj-type
     1977       ,input  v-cntxt-obj-code
     1978       ,input  0
     1979       ,input  0
     1980       ,input  0
     1981       ,input  true
     1982       ,output g#log
     1983       )  .
     1984   end.
     1985     if not g#log then return .
     1986   define variable v-rec-id as recid no-undo .
     1987   define variable v-mode as character no-undo .
     1988   define variable v-ask-pr as logical   no-undo .
     1989    if var-paket = false then do:
     1990     if not available buf_price-doc-forming then return .
     1991     if buf_price-doc-forming.stts <> integer('0':U) then do:
     1992      message "Закрытые или удаленные ДНЦ закрывать нельзя! "
     1993               view-as alert-box information .
     1994      return .
     1995      end.
     1996     v-rec-id = recid(buf_price-doc-forming) .
     1997     if buf_price-list-type.main = true  then do:
     1998        run str/pdf-cask.w ( input parparentproc , input recid( buf_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     1999        if v-mode = "" or  v-ask-pr = ? then return no-apply.
     2000     end.
     2001     else do:
     2002     message "Закрывать ДНЦ" buf_price-doc-forming.pdf-id "?"
     2003         view-as alert-box question
     2004         buttons yes-no
     2005         update var-ok as logical
     2006         .
     2007     if var-ok =  false then return .
     2008     end.
     2009       run str/diallog.w
     2010           (parparentproc
     2011           , this-procedure
     2012           , 'str/pdf-clos.p':U
     2013           , ( string(v-rec-id) + chr(4) +
     2014              'no' + chr(4) +
     2015              'no' + chr(4) +
     2016              '?' + chr(4) +
     2017              '?' + chr(4) +
     2018              string(v-mode) + chr(4) +
     2019              '?' + chr(4) +
     2020              string(v-ask-pr)  )
     2021           , yes
     2022           , '':U
     2023           , 'Закрытие ДНЦ') no-error .
     2024       if error-status :error then
     2025       message
     2026         error-status :get-message(1) skip
     2027         return-value skip
     2028         "Ошибка закрытия ДНЦ"
     2029         view-as alert-box error
     2030       .
     2031     end.
     2032     else do:
     2033         define variable nn as integer   no-undo .
     2034         define variable v-recid as recid no-undo .
     2035         define buffer cl_price-doc-forming for ub.price-doc-forming  .
     2036         define buffer cl_price-list-type   for ub.price-list-type  .
     2037         define variable i as integer   no-undo .
     2038         nn = num-entries(p-rec-list) .
     2039             if nn = 0 then do:
     2040                 message "Не выбрано ни одной строки для закрытия! "  view-as alert-box information .
     2041                 return .
     2042             end.
     2043             message substitute("Закрыть &1 отмеченных ДНЦ ?  " , nn)
     2044               view-as alert-box question
     2045               buttons yes-no
     2046               update v-ok as logical.
     2047             if v-ok then do:
     2048               repeat i = 1 to nn :
     2049                   v-recid = int(entry( i , p-rec-list )) .
     2050                   find first cl_price-doc-forming no-lock where
     2051                       recid(cl_price-doc-forming) = v-recid no-error .
     2052                       if available cl_price-doc-forming then do:
     2053                           find first cl_price-list-type no-lock where
     2054                                     cl_price-list-type.plt-id = cl_price-doc-forming.plt-id and
     2055                                     cl_price-list-type.plt-db-num = cl_price-doc-forming.plt-db-num
     2056                                     no-error .
     2057                                if cl_price-doc-forming.stts <> integer('0':U)   then do:
     2058                                   message substitute("ДНЦ &1 закрыть уже нельзя !" , cl_price-doc-forming.pdf-id) view-as alert-box information .
     2059                                 end.
     2060                                 else do:
     2061                                     if cl_price-list-type.main = true  then do:
     2062                                         if v-mode = "" or  v-ask-pr = ? then
     2063                                         run str/pdf-cask.w ( input parparentproc , input recid(cl_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     2064                                             if v-mode = "" or  v-ask-pr = ? then do:
     2065                                                 next.
     2066                                             end.
     2067                                     end.
     2068                                       run str/diallog.w
     2069                                           (parparentproc
     2070                                           , this-procedure
     2071                                           , 'str/pdf-clos.p':U
     2072                                           , ( string(recid(cl_price-doc-forming )) + chr(4) +
     2073                                             'no' + chr(4) +
     2074                                             'no' + chr(4) +
     2075                                             '?' + chr(4) +
     2076                                             '?' + chr(4) +
     2077                                             string(v-mode) + chr(4) +
     2078                                             '?' + chr(4) +
     2079                                             string(v-ask-pr)  )
     2080                                           , yes
     2081                                           , '':U
     2082                                           , 'Закрытие ДНЦ') no-error .
     2083                             end.
     2084                       end.
     2085               end.
     2086             end.
     2087     end.
     2088     run openbr in this-procedure .
     2089     reposition BROWSE-1grp to recid v-rec-id no-error .
     2090     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     2091   END.
     2092   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
     2093   DO:
     2094     define variable g#log as logical   no-undo .
     2095   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2096   do:
     2097     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2098       (input  v-cntxt-db-num
     2099       ,input  v-cntxt-userid
     2100       ,input  0
     2101       ,input  'actn_pdf_update':U
     2102       ,input  'global':U
     2103       ,input  v-cntxt-host-code-obj
     2104       ,input  v-cntxt-obj-type
     2105       ,input  v-cntxt-obj-code
     2106       ,input  0
     2107       ,input  0
     2108       ,input  0
     2109       ,input  true
     2110       ,output g#log
     2111       )  .
     2112   end.
     2113   if not g#log then return .
     2114   define variable v-rec-id     as recid     no-undo .
     2115   define variable v-plt-db-num as integer   no-undo .
     2116   define variable v-plt-id     as integer   no-undo .
     2117   define variable v-pdf-db-num as integer   no-undo .
     2118   define variable v-pdf-id     as integer   no-undo .
     2119   define variable v-ok1        as integer   no-undo .
     2120   if not available buf_price-doc-forming then return.
     2121   v-rec-id = recid (buf_price-doc-forming) .
     2122     message "Копировать ДНЦ №" buf_price-doc-forming.pdf-id skip
     2123             "БД:"              buf_price-doc-forming.pdf-db skip
     2124             "на другой ТПЛ ?"                               skip
     2125     "При копировании из текущего ДНЦ в новый ДНЦ перенесутся все баркоды с ценами КАК ЕСТЬ, " skip
     2126     "При этом не проверяются НИ КАКИЕ настройки !!! " skip
     2127     "(ни проверка наличия спец цен (шкал,партий и другой единицы измерения), ни проверка наличия свободной зоны, "
     2128     " ни ограничения нового ТПЛ)"
     2129     view-as alert-box question
     2130     button yes-no
     2131     update v-ok as logical .
     2132     if not v-ok then return .
     2133   define variable v-spis-recid as character no-undo .
     2134   define variable i as integer   no-undo .
     2135   define variable v-kol as integer   no-undo .
     2136   define buffer bufc_price-list-type for ub.price-list-type  .
     2137   v-spis-recid = "" .
     2138   run ref/typepric.w (
     2139       input parParentProc     ,
     2140       input "mode=all,b-mark,b-sel,title=ВЫБИРИТЕ Типы Прайс-листов для копирования endtitle" ,
     2141       input-output v-spis-recid
     2142       ) no-error .
     2143       v-kol = num-entries(v-spis-recid).
     2144       v-ok1 = 0.
     2145       repeat i = 1 to v-kol :
     2146          find first bufc_price-list-type no-lock  where recid(bufc_price-list-type) = int(entry(i,v-spis-recid)) no-error .
     2147          if bufc_price-list-type.stts <> 0 then next.
     2148          v-plt-db-num = bufc_price-list-type.plt-db-num .
     2149          v-plt-id     = bufc_price-list-type.plt-id     .
     2150          run copy_new_price-doc-forming (
     2151              input v-rec-id  ,
     2152              input-output v-plt-db-num  ,
     2153              input-output v-plt-id      ,
     2154              output v-pdf-db-num  ,
     2155              output v-pdf-id
     2156              ) no-error .
     2157              if not error-status :error then do:
     2158                 v-ok1 = v-ok1 + 1 .
     2159              end.
     2160       end.
     2161     run openbr in this-procedure .
     2162     reposition BROWSE-1grp to recid v-rec-id no-error .
