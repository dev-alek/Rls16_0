     2595   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2596   procedure minbtn-set :
     2597       do
     2598           on error undo, return error return-value
     2599           :
     2600           define variable ii              as integer       no-undo .
     2601           define variable fh              as widget-handle no-undo .
     2602           define variable hh              as widget-handle no-undo .
     2603           define variable v-h             as handle        extent 4 no-undo .
     2604           define variable v-name-button   as character     no-undo .
     2605           define variable v-help-old-x    as decimal       no-undo .
     2606           define variable v-help-old-y    as decimal       no-undo .
     2607           define variable v-help-old-size as decimal       no-undo .
     2608           define variable v-frame-width   as decimal       no-undo .
     2609           define variable jj              as integer       no-undo .
     2610           do
     2611               on error undo, return error
     2612               :
     2613               assign
     2614                   v-frame-width = frame Dialog-Frame:width - 0.3
     2615                   fh            = frame Dialog-Frame:first-child
     2616                   hh            = fh:first-child
     2617                   ii            = 1
     2618                   .
     2619               do while valid-handle(hh):
     2620                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2621                   do:
     2622                       case lc(hh:name) :
     2623                           when "b-help" then
     2624                               do:
     2625                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2626                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2627                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2628                                   hh:TOOLTIP = "Помощь" .
     2629                                   v-help-old-x = hh:column .
     2630                                   v-help-old-y = hh:row    .
     2631                                   v-help-old-size = hh:width .
     2632                                   hh:width-chars = 2.5 .
     2633                               end.
     2634                           when "b-print" then
     2635                               do:
     2636                                   hh:load-image("cmp/b-print.bmp":u) .
     2637                                   hh:TOOLTIP = "Печать" .
     2638                                   v-h[ii] = hh:handle .
     2639                                   ii = ii + 1 .
     2640                                   hh:width-chars = 3 .
     2641                               end.
     2642                           when "b-history" or
     2643                           when "b-hist" then
     2644                               do:
     2645                                   hh:load-image("cmp/b-hist.bmp":u) .
     2646                                   hh:TOOLTIP = "История" .
     2647                                   v-h[ii] = hh:handle .
     2648                                   ii = ii + 1 .
     2649                                   hh:width-chars = 3 .
     2650                               end.
     2651                           when "b-sch" then
     2652                               do:
     2653                                   hh:load-image("cmp/b-sch.bmp":u) .
     2654                                   hh:TOOLTIP = "Установка Фильтра" .
     2655                                   v-h[ii] = hh:handle .
     2656                                   ii = ii + 1 .
     2657                                   hh:width-chars = 3 .
     2658                               end.
     2659                           when "b-hist-user" then
     2660                               do:
     2661                                   hh:load-image("cmp/b-hist.bmp":u) .
     2662                                   hh:TOOLTIP = "История пользователя" .
     2663                                   ii = ii + 1 .
     2664                               end.
     2665                       end case.
     2666                   end.
     2667                   hh = hh:next-sibling.
     2668               end.
     2669               b-help:column = v-frame-width - b-help:width-chars.
     2670               jj = 0.
     2671               repeat ii = 4 to 1 by -1 :
     2672                   if valid-handle (v-h[ii] ) then
     2673                   do:
     2674                       jj  = jj + 1 .
     2675                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2676                       v-h[ii]:row    = v-help-old-y .
     2677                   end.
     2678               end.
     2679           end.
     2680       end.
     2681   end procedure.
     2682   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2683   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2684   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2685   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2686   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2687   define variable v-diasize-current-frame-height as decimal   no-undo .
     2688   define variable v-diasize-change-size          as logical   no-undo .
     2689   define variable v-diasize-resize-button        as handle    no-undo .
     2690   define variable v-diasize-wndmax               as logical   no-undo .
     2691   define variable v-diasize-wndstore             as logical   no-undo .
     2692   define variable v-diasize-proc-name            as character no-undo .
     2693   define variable v-diasize-browse-handle        as handle    no-undo .
     2694   define variable v-diasize-browse-number        as integer   no-undo .
     2695   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2696   define temp-table temp-diasize-handle no-undo
     2697     field handle-value  as handle
     2698     field save-position as decimal
     2699     index xpk is primary unique handle-value
     2700     .
     2701   define temp-table temp-browse-handle no-undo
     2702     field browse-type   as character
     2703     field browse-number as integer
     2704     field browse-handle as handle
     2705     field original-size as decimal
     2706     index xpk is primary unique browse-type browse-number
     2707     index xie browse-type browse-handle
     2708   .
     2709   procedure diasize_change-height :
     2710     define input  parameter p-change-value  as decimal   no-undo .
     2711     define input  parameter p-move-resize   as logical   no-undo .
     2712     define variable v-field-group-handle    as handle    no-undo .
     2713     define variable v-object-handle         as handle    no-undo .
     2714     define variable v-frame-height          as decimal   no-undo .
     2715     define variable v-frame-virtual-height  as decimal   no-undo .
     2716     define variable v-browse-height         as decimal   no-undo .
     2717     define variable v-window-height         as decimal   no-undo .
     2718     define variable v-window-virtual-height as decimal   no-undo .
     2719     define variable v-change-sign           as integer   no-undo .
     2720     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2721     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2722     if p-change-value > 0
     2723     then do:
     2724       if frame Dialog-Frame :height + p-change-value
     2725           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2726       then do:
     2727         assign
     2728           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2729                           - (frame Dialog-Frame :height-chars)
     2730         .
     2731         if p-change-value <= 0
     2732         then do:
     2733           run diasize_position-resize-button in this-procedure .
     2734           return .
     2735         end.
     2736       end.
     2737     end.
     2738     if p-change-value < 0
     2739     then do:
     2740       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2741       then do:
     2742         assign
     2743           p-change-value = v-diasize-orig-frame-height
     2744                          - (frame Dialog-Frame :height-chars)
     2745         .
     2746         if p-change-value >= 0
     2747         then do:
     2748           run diasize_position-resize-button in this-procedure .
     2749           return .
     2750         end.
     2751       end.
     2752     end.
     2753     if p-change-value >= 0
     2754     then do:
     2755       assign
     2756         v-change-sign = 1
     2757       .
     2758     end.
     2759     else do:
     2760       assign
     2761         v-change-sign = -1
     2762       .
     2763     end.
     2764     assign
     2765       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2766     .
     2767     if p-change-value = 0
     2768     then do:
     2769       run diasize_position-resize-button in this-procedure .
     2770       return .
     2771     end.
     2772     move_block:
     2773     do
     2774     on error undo move_block, retry move_block
     2775     :
     2776       if retry
     2777       then do:
     2778         do
     2779         on error undo move_block, leave move_block
     2780         :
     2781           if p-change-value > 0
     2782           then do:
     2783             for each buf_temp-diasize-handle
     2784             on error undo, next
     2785             :
     2786               assign
     2787                 v-object-handle = buf_temp-diasize-handle.handle-value
     2788               .
     2789               if v-object-handle <> v-diasize-resize-button
     2790               then do:
     2791                 assign
     2792                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2793                 .
     2794               end.
     2795             end.
     2796             assign
     2797               v-diasize-browse-handle :height = v-browse-height
     2798             .
     2799             for each buf_temp-browse-handle
     2800               where buf_temp-browse-handle.browse-type = 'height':u
     2801             on error undo, next
     2802             :
     2803               assign
     2804                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2805               .
     2806             end.
     2807             assign
     2808               frame Dialog-Frame :height = v-frame-height
     2809             .
     2810             if frame Dialog-Frame :scrollable = true
     2811             then do:
     2812               assign
     2813                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2814               .
     2815             end.
     2816             run diasize_position-resize-button in this-procedure .
     2817           end.
     2818           else do:
     2819             if frame Dialog-Frame :scrollable = true
     2820             then do:
     2821               assign
     2822                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2823               .
     2824             end.
     2825             assign
     2826               frame Dialog-Frame :height = v-frame-height
     2827             .
     2828             assign
     2829               v-diasize-browse-handle :height = v-browse-height
     2830             .
     2831             for each buf_temp-browse-handle
     2832               where buf_temp-browse-handle.browse-type = 'height':u
     2833             on error undo, next
     2834             :
     2835               assign
     2836                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2837               .
     2838             end.
     2839             for each buf_temp-diasize-handle
     2840             on error undo, next
     2841             :
     2842               assign
     2843                 v-object-handle = buf_temp-diasize-handle.handle-value
     2844               .
     2845               if v-object-handle <> v-diasize-resize-button
     2846               then do:
     2847                 assign
     2848                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2849                 .
     2850               end.
     2851             end.
     2852             run diasize_position-resize-button in this-procedure .
     2853           end.
     2854           assign
     2855             v-diasize-change-size = false
     2856           .
     2857           leave move_block .
     2858         end.
     2859       end.
     2860       assign
     2861         v-diasize-need-full-display = true
     2862       .
     2863       if v-diasize-change-size = false
     2864       then do:
     2865         assign
     2866           v-diasize-change-size = true
     2867         .
     2868       end.
     2869       else do:
     2870         return .
     2871       end.
     2872       assign
     2873         v-frame-height = frame Dialog-Frame :height
     2874         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2875         v-browse-height = v-diasize-browse-handle :height
     2876       .
     2877       for each buf_temp-browse-handle
     2878         where buf_temp-browse-handle.browse-type = 'height':u
     2879       :
     2880         assign
     2881           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2882         .
     2883       end.
     2884       for each buf_temp-diasize-handle
     2885       :
     2886         delete buf_temp-diasize-handle .
     2887       end.
     2888       assign
     2889         v-field-group-handle = frame Dialog-Frame :first-child
     2890       .
     2891       do while valid-handle(v-field-group-handle)
     2892       :
     2893         assign
     2894           v-object-handle = v-field-group-handle :first-child
     2895         .
     2896         do while valid-handle(v-object-handle)
     2897         :
     2898           if  v-object-handle <> v-diasize-browse-handle :handle
     2899           and can-query(v-object-handle, "row")
     2900           and can-query(v-object-handle, "height")
     2901           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2902           then do:
     2903             find first buf_temp-browse-handle
     2904               where buf_temp-browse-handle.browse-type   = 'height':u
     2905                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2906               no-error .
     2907             if available buf_temp-browse-handle
     2908             then do:
     2909             end.
     2910             else do:
     2911               create buf_temp-diasize-handle .
     2912               assign
     2913                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2914                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2915               .
     2916             end.
     2917           end.
     2918           assign
     2919             v-object-handle = v-object-handle :next-sibling
     2920           .
     2921         end.
     2922         assign
     2923           v-field-group-handle = v-field-group-handle :next-sibling
     2924         .
     2925       end.
     2926       do with frame Dialog-Frame
     2927       :
     2928         hide v-diasize-resize-button .
     2929         assign
     2930           v-diasize-resize-button :row    = 1
     2931           v-diasize-resize-button :column = 1
     2932         .
     2933       end.
     2934       if p-change-value > 0
     2935       then do:
     2936         if frame Dialog-Frame :scrollable = true
     2937         then do:
     2938           assign
     2939             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2940             no-error .
     2941           if error-status :error
     2942           or error-status :get-message(1) <> ""
     2943           then do:
     2944             undo move_block, retry move_block .
     2945           end.
     2946         end.
     2947         assign
     2948           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2949           no-error .
     2950         if error-status :error
     2951         or error-status :get-message(1) <> ""
     2952         then do:
     2953           undo move_block, retry move_block .
     2954         end.
     2955         assign
     2956           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2957           no-error .
     2958         if error-status :error
     2959         or error-status :get-message(1) <> ""
     2960         then do:
     2961           undo move_block, retry move_block .
     2962         end.
     2963         for each buf_temp-browse-handle
     2964           where buf_temp-browse-handle.browse-type = 'height':u
     2965         on error undo move_block, retry move_block
     2966         :
     2967           assign
     2968             buf_temp-browse-handle.browse-handle :height
     2969               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2970             no-error .
     2971           if error-status :error
     2972           or error-status :get-message(1) <> ""
     2973           then do:
     2974             undo move_block, retry move_block .
     2975           end.
     2976         end.
     2977         for each buf_temp-diasize-handle
     2978         on error undo move_block, retry move_block
     2979         :
     2980           assign
     2981             v-object-handle = buf_temp-diasize-handle.handle-value
     2982           .
     2983           if v-object-handle <> v-diasize-resize-button
     2984           then do:
     2985             assign
     2986               v-object-handle :row = v-object-handle :row + p-change-value
     2987               no-error .
     2988             if error-status :error
     2989             or error-status :get-message(1) <> ""
     2990             then do:
     2991               undo move_block, retry move_block .
     2992             end.
     2993           end.
     2994         end.
     2995       end.
     2996       else do:
     2997         for each buf_temp-diasize-handle
     2998         on error undo move_block, retry move_block
     2999         :
     3000           assign
     3001             v-object-handle = buf_temp-diasize-handle.handle-value
     3002           .
     3003           if v-object-handle <> v-diasize-resize-button
     3004           then do:
     3005             assign
     3006               v-object-handle :row = v-object-handle :row + p-change-value
     3007               no-error .
     3008             if error-status :error
     3009             or error-status :get-message(1) <> ""
     3010             then do:
     3011               undo move_block, retry move_block .
     3012             end.
     3013           end.
     3014         end.
     3015         assign
     3016           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3017           no-error .
     3018         if error-status :error
     3019         or error-status :get-message(1) <> ""
     3020         then do:
     3021           undo move_block, retry move_block .
     3022         end.
     3023         for each buf_temp-browse-handle
     3024           where buf_temp-browse-handle.browse-type = 'height':u
     3025         on error undo move_block, retry move_block
     3026         :
     3027           assign
     3028             buf_temp-browse-handle.browse-handle :height
     3029               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3030             no-error .
     3031           if error-status :error
     3032           or error-status :get-message(1) <> ""
     3033           then do:
     3034             undo move_block, retry move_block .
     3035           end.
     3036         end.
     3037         assign
     3038           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3039           no-error .
     3040         if error-status :error
     3041         or error-status :get-message(1) <> ""
     3042         then do:
     3043           undo move_block, retry move_block .
     3044         end.
     3045         if frame Dialog-Frame :scrollable = true
     3046         then do:
     3047           assign
     3048             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3049             no-error .
     3050           if error-status :error
     3051           or error-status :get-message(1) <> ""
     3052           then do:
     3053             undo move_block, retry move_block .
     3054           end.
     3055         end.
     3056       end.
     3057       if p-move-resize = true
     3058       then do:
     3059         run diasize_position-resize-button in this-procedure .
     3060       end.
     3061       if v-diasize-wndstore = true
     3062       then do:
     3063         if connected("ub") = true
     3064         then do:
     3065           define variable v-cntxt-db-num        as integer   no-undo .
     3066           define variable v-cntxt-userid        as character no-undo .
     3067           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3068                                             , OUTPUT v-cntxt-userid
     3069                                             ) .
     3070           run gbl/wndsizew.p
     3071             (input  v-cntxt-db-num
     3072             ,input  v-cntxt-userid
     3073             ,input  v-diasize-proc-name
     3074             ,input  'height':u
     3075             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3076             ) .
     3077         end.
     3078       end.
     3079     end.
     3080     assign
     3081       v-diasize-change-size = false
     3082     .
     3083   end procedure.
     3084   procedure diasize_set-height :
     3085     define input  parameter p-new-height  as decimal   no-undo .
     3086     define input  parameter p-move-resize as logical   no-undo .
     3087     do
     3088     on error undo, return error return-value
     3089     :
     3090       run diasize_change-height in this-procedure
     3091         (input  (p-new-height - frame Dialog-Frame :height)
     3092         ,input  p-move-resize
     3093         ) .
     3094     end.
     3095   end procedure.
     3096   procedure diasize_change-width :
     3097     define input  parameter p-change-value as decimal   no-undo .
     3098     define input  parameter p-move-resize  as logical   no-undo .
     3099     define variable v-field-group-handle   as handle    no-undo .
     3100     define variable v-object-handle        as handle    no-undo .
     3101     define variable v-frame-width          as decimal   no-undo .
     3102     define variable v-frame-virtual-width  as decimal   no-undo .
     3103     define variable v-browse-width         as decimal   no-undo .
     3104     define variable v-window-width         as decimal   no-undo .
     3105     define variable v-window-virtual-width as decimal   no-undo .
     3106     define variable v-change-sign          as integer   no-undo .
     3107     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3108     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3109     if p-change-value > 0
     3110     then do:
     3111       if frame Dialog-Frame :width + p-change-value >
     3112           session :width-chars
     3113       then do:
     3114         assign
     3115           p-change-value = session :width-chars - frame Dialog-Frame :width
     3116         .
     3117         if p-change-value <= 0
     3118         then do:
     3119           run diasize_position-resize-button in this-procedure .
     3120           return .
     3121         end.
     3122       end.
     3123     end.
     3124     if p-change-value < 0
     3125     then do:
     3126       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3127       then do:
     3128         assign
     3129           p-change-value = v-diasize-orig-frame-width
     3130                          - frame Dialog-Frame :width
     3131         .
     3132         if p-change-value >= 0
     3133         then do:
     3134           run diasize_position-resize-button in this-procedure .
     3135           return .
     3136         end.
     3137       end.
     3138     end.
     3139     if p-change-value >= 0
     3140     then do:
     3141       assign
     3142         v-change-sign = 1
     3143       .
     3144     end.
     3145     else do:
     3146       assign
     3147         v-change-sign = -1
     3148       .
     3149     end.
     3150     assign
     3151       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3152     .
     3153     if p-change-value = 0
     3154     then do:
     3155       run diasize_position-resize-button in this-procedure .
     3156       return .
     3157     end.
     3158     move_block:
     3159     do
     3160     on error undo move_block, leave move_block
     3161     :
     3162       if retry
     3163       then do:
     3164         do
     3165         on error undo move_block, leave move_block
     3166         :
     3167           if p-change-value > 0
     3168           then do:
     3169             for each buf_temp-diasize-handle
     3170             on error undo, next
     3171             :
     3172               assign
     3173                 v-object-handle = buf_temp-diasize-handle.handle-value
     3174               .
     3175               if v-object-handle <> v-diasize-resize-button
     3176               then do:
     3177                 assign
     3178                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3179                 .
     3180               end.
     3181             end.
     3182             assign
     3183               v-diasize-browse-handle :width = v-browse-width
     3184             .
     3185             for each buf_temp-browse-handle
     3186               where buf_temp-browse-handle.browse-type = 'width':u
     3187             on error undo, next
     3188             :
     3189               assign
     3190                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3191               .
     3192             end.
     3193             assign
     3194               frame Dialog-Frame :width = v-frame-width
     3195             .
     3196             if frame Dialog-Frame :scrollable = true
     3197             then do:
     3198               assign
     3199                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3200               .
     3201             end.
     3202             run diasize_position-resize-button in this-procedure .
     3203           end.
     3204           else do:
     3205             if frame Dialog-Frame :scrollable = true
     3206             then do:
     3207               assign
     3208                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3209               .
     3210             end.
     3211             assign
     3212               frame Dialog-Frame :width = v-frame-width
     3213             .
     3214             for each buf_temp-browse-handle
     3215               where buf_temp-browse-handle.browse-type = 'width':u
     3216             on error undo, next
     3217             :
     3218               assign
     3219                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3220               .
     3221             end.
     3222             assign
     3223               v-diasize-browse-handle :width = v-browse-width
     3224             .
     3225             for each buf_temp-diasize-handle
     3226             on error undo, next
     3227             :
     3228               assign
     3229                 v-object-handle = buf_temp-diasize-handle.handle-value
     3230               .
     3231               if v-object-handle <> v-diasize-resize-button
     3232               then do:
     3233                 assign
     3234                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3235                 .
     3236               end.
     3237             end.
     3238             run diasize_position-resize-button in this-procedure .
     3239           end.
     3240           assign
     3241             v-diasize-change-size = false
     3242           .
     3243           leave move_block .
     3244         end.
     3245       end.
     3246       assign
     3247         v-diasize-need-full-display = true
     3248       .
     3249       if v-diasize-change-size = false
     3250       then do:
     3251         assign
     3252           v-diasize-change-size = true
     3253         .
     3254       end.
     3255       else do:
     3256         return .
     3257       end.
     3258       assign
     3259         v-frame-width = frame Dialog-Frame :width
     3260         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3261         v-browse-width = v-diasize-browse-handle :width
     3262       .
     3263       for each buf_temp-browse-handle
     3264         where buf_temp-browse-handle.browse-type = 'width':u
     3265       :
     3266         assign
     3267           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3268         .
     3269       end.
     3270       for each buf_temp-diasize-handle
     3271       :
     3272         delete buf_temp-diasize-handle .
     3273       end.
     3274       assign
     3275         v-field-group-handle = frame Dialog-Frame :first-child
     3276       .
     3277       do while valid-handle(v-field-group-handle)
     3278       :
     3279         assign
     3280           v-object-handle = v-field-group-handle :first-child
     3281         .
     3282         do while valid-handle(v-object-handle)
     3283         :
     3284           if  v-object-handle <> v-diasize-browse-handle :handle
     3285           and v-object-handle <> v-diasize-resize-button
     3286           and can-query(v-object-handle, "row")
     3287           and can-query(v-object-handle, "height")
     3288           and ( v-object-handle :col + v-object-handle :width
     3289                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3290               )
     3291           then do:
     3292             find first buf_temp-browse-handle
     3293               where buf_temp-browse-handle.browse-type   = 'width':u
     3294                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3295               no-error .
     3296             if available buf_temp-browse-handle
     3297             then do:
     3298             end.
     3299             else do:
     3300               create buf_temp-diasize-handle .
     3301               assign
     3302                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3303                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3304               .
     3305             end.
     3306           end.
     3307           assign
     3308             v-object-handle = v-object-handle :next-sibling
     3309           .
     3310         end.
     3311         assign
     3312           v-field-group-handle = v-field-group-handle :next-sibling
     3313         .
     3314       end.
     3315       do with frame Dialog-Frame
     3316       :
     3317         hide v-diasize-resize-button .
     3318         v-diasize-resize-button :row = 1.
     3319         v-diasize-resize-button :column = 1.
     3320       end.
     3321       if p-change-value > 0
     3322       then do:
     3323         if frame Dialog-Frame :scrollable = true
     3324         then do:
     3325           assign
     3326             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3327             no-error .
     3328           if error-status :error
     3329           or error-status :get-message(1) <> ""
     3330           then do:
     3331             undo move_block, retry move_block.
     3332           end.
     3333         end.
     3334         assign
     3335           frame Dialog-Frame :width = v-frame-width + p-change-value
     3336           no-error .
     3337         if error-status :error
     3338         or error-status :get-message(1) <> ""
     3339         then do:
     3340           undo move_block, retry move_block.
     3341         end.
     3342         assign
     3343           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3344         no-error .
     3345         if error-status :error
     3346         or error-status :get-message(1) <> ""
     3347         then do:
     3348           undo move_block, retry move_block.
     3349         end.
     3350         for each buf_temp-browse-handle
     3351           where buf_temp-browse-handle.browse-type = 'width':u
     3352         on error undo move_block, retry move_block
     3353         :
     3354           assign
     3355             buf_temp-browse-handle.browse-handle :width
     3356               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3357             no-error .
     3358           if error-status :error
     3359           or error-status :get-message(1) <> ""
     3360           then do:
     3361             undo move_block, retry move_block .
     3362           end.
     3363         end.
     3364         for each buf_temp-diasize-handle
     3365         on error undo move_block, retry move_block
     3366         :
     3367           assign
     3368             v-object-handle = buf_temp-diasize-handle.handle-value
     3369           .
     3370           if v-object-handle <> v-diasize-resize-button
     3371           then do:
     3372             assign
     3373               v-object-handle :col = v-object-handle :col + p-change-value
     3374               no-error .
     3375             if error-status :error
     3376             or error-status :get-message(1) <> ""
     3377             then do:
     3378               undo move_block, retry move_block .
     3379             end.
     3380           end.
     3381         end.
     3382       end.
     3383       else do:
     3384         for each buf_temp-diasize-handle
     3385         on error undo move_block, retry move_block
     3386         :
     3387           assign
     3388             v-object-handle = buf_temp-diasize-handle.handle-value
     3389           .
     3390           if v-object-handle <> v-diasize-resize-button
     3391           then do:
     3392             assign
     3393               v-object-handle :col = v-object-handle :col + p-change-value
     3394               no-error .
     3395             if error-status :error
     3396             or error-status :get-message(1) <> ""
     3397             then do:
     3398               undo move_block, retry move_block .
     3399             end.
     3400           end.
     3401         end.
     3402         for each buf_temp-browse-handle
     3403           where buf_temp-browse-handle.browse-type = 'width':u
     3404         on error undo move_block, retry move_block
     3405         :
     3406           assign
     3407             buf_temp-browse-handle.browse-handle :width
     3408               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3409             no-error .
     3410           if error-status :error
     3411           or error-status :get-message(1) <> ""
     3412           then do:
     3413             undo move_block, retry move_block .
     3414           end.
     3415         end.
     3416         assign
     3417           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3418           no-error .
     3419         if error-status :error
     3420         or error-status :get-message(1) <> ""
     3421         then do:
     3422           undo move_block, retry move_block.
     3423         end.
     3424         assign
     3425           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3426         no-error .
     3427         if error-status :error
     3428         or error-status :get-message(1) <> ""
     3429         then do:
     3430           undo move_block, retry move_block.
     3431         end.
     3432         if frame Dialog-Frame :scrollable = true
     3433         then do:
     3434           assign
     3435             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3436           no-error .
     3437           if error-status :error
     3438           or error-status :get-message(1) <> ""
     3439           then do:
     3440             undo move_block, retry move_block.
     3441           end.
     3442         end.
     3443       end.
     3444       if p-move-resize
     3445       then do:
     3446         run diasize_position-resize-button in this-procedure .
     3447       end.
     3448       if v-diasize-wndstore = true
     3449       then do:
     3450         if connected("ub") = true
     3451         then do:
     3452           define variable v-cntxt-db-num        as integer   no-undo .
     3453           define variable v-cntxt-userid        as character no-undo .
     3454           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3455                                             , OUTPUT v-cntxt-userid
     3456                                             ) .
     3457           run gbl/wndsizew.p
     3458             (input  v-cntxt-db-num
     3459             ,input  v-cntxt-userid
     3460             ,input  v-diasize-proc-name
     3461             ,input  'width':u
     3462             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3463             ) .
     3464         end.
     3465       end.
     3466     end.
     3467     assign
     3468       v-diasize-change-size = false
     3469     .
     3470   end procedure.
     3471   procedure diasize_set-width :
     3472     define input  parameter p-new-width  as decimal   no-undo .
     3473     define input  parameter p-move-resize as logical   no-undo .
     3474     do
     3475     on error undo, return error return-value
     3476     :
     3477       run diasize_change-width in this-procedure
     3478         (input  (p-new-width - frame Dialog-Frame :width)
     3479         ,input  p-move-resize
     3480         ) .
     3481     end.
     3482   end procedure.
     3483   procedure diasize_position-resize-button :
     3484     do with frame Dialog-Frame
     3485     :
     3486       hide v-diasize-resize-button .
     3487       assign
     3488         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3489                     - 1
     3490                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3491         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3492                     - 1
     3493                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3494       .
     3495       view v-diasize-resize-button .
     3496     end.
     3497   end procedure.
     3498   on alt-right anywhere
     3499   do:
     3500     run diasize_change-width in this-procedure
     3501       (input 1
     3502       ,input true
     3503       ) .
     3504     return no-apply .
     3505   end.
     3506   on alt-left anywhere
     3507   do:
     3508     run diasize_change-width in this-procedure
     3509       (input -1
     3510       ,input true
     3511       ) .
     3512     return no-apply .
     3513   end.
     3514   on alt-down anywhere
     3515   do:
     3516     run diasize_change-height in this-procedure
     3517       (input 1
     3518       ,input true
     3519       ) .
     3520     return no-apply .
     3521   end.
     3522   on alt-up anywhere
     3523   do:
     3524     run diasize_change-height in this-procedure
     3525       (input -1
     3526       ,input true
     3527       ) .
     3528     return no-apply .
     3529   end.
     3530   on alt-enter of frame Dialog-Frame
     3531   do:
     3532     run diasize_maximize in this-procedure
     3533       (input  ?
     3534       ).
     3535     return no-apply .
     3536   end.
     3537   procedure diasize_end-move :
     3538     do
     3539     on error undo, return error return-value
     3540     :
     3541       define variable v-row-delta as decimal   no-undo .
     3542       define variable v-col-delta as decimal   no-undo .
     3543       define variable v-new-row as decimal   no-undo .
     3544       define variable v-new-col as decimal   no-undo .
     3545       assign
     3546         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3547         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3548       .
     3549       assign
     3550         v-row-delta = v-new-row - frame Dialog-Frame :height
     3551         v-col-delta = v-new-col - frame Dialog-Frame :width
     3552       .
     3553       run diasize_change-height in this-procedure
     3554         (input v-row-delta
     3555         ,input true
     3556         ) .
     3557       run diasize_change-width in this-procedure
     3558         (input v-col-delta
     3559         ,input true
     3560         ) .
     3561     end.
     3562   end procedure.
     3563   procedure diasize_maximize :
     3564     define input  parameter p-action as logical   no-undo .
     3565     do
     3566     on error undo, return error return-value
     3567     :
     3568       if p-action = ?
     3569       then do:
     3570         if v-diasize-need-maximize = true
     3571         then do:
     3572           assign
     3573             p-action = true
     3574           .
     3575         end.
     3576         else do:
     3577           assign
     3578             p-action = false
     3579           .
     3580         end.
     3581       end.
     3582       if p-action = true
     3583       then do:
     3584         run diasize_change-height in this-procedure
     3585           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3586               - frame Dialog-Frame :height-chars
     3587           ,input true
     3588           ) .
     3589         run diasize_change-width in this-procedure
     3590           (input session :width-chars
     3591               - frame Dialog-Frame :width-chars
     3592           ,input true
     3593           ) .
     3594         assign
     3595           v-diasize-need-maximize = false
     3596         .
     3597       end.
     3598       else do:
     3599         run diasize_change-width in this-procedure
     3600           (input v-diasize-orig-frame-width
     3601               - frame Dialog-Frame :width-chars
     3602           ,input true
     3603           ) .
     3604         run diasize_change-height in this-procedure
     3605           (input v-diasize-orig-frame-height
     3606               - frame Dialog-Frame :height-chars
     3607           ,input true
     3608           ) .
     3609         assign
     3610           v-diasize-need-maximize = true
     3611         .
     3612       end.
     3613     end.
     3614   end procedure.
     3615   procedure diasize_restore-orig-size :
     3616     do
     3617     on error undo, return error return-value
     3618     :
     3619       assign
     3620         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3621         v-diasize-current-frame-height = frame Dialog-Frame :height
     3622       .
     3623       run diasize_set-height in this-procedure
     3624         (input  v-diasize-orig-frame-height
     3625         ,input  true
     3626         ) .
     3627       run diasize_set-width in this-procedure
     3628         (input  v-diasize-orig-frame-width
     3629         ,input  true
     3630         ) .
     3631     end.
     3632   end procedure.
     3633   procedure diasize_restore-current-size :
     3634     do
     3635     on error undo, return error return-value
     3636     :
     3637       run diasize_set-height in this-procedure
     3638         (input  v-diasize-current-frame-height
     3639         ,input  true
     3640         ) .
     3641       run diasize_set-width in this-procedure
     3642         (input  v-diasize-current-frame-width
     3643         ,input  true
     3644         ) .
     3645     end.
     3646   end procedure.
     3647   procedure diasize_set-browse-handle :
     3648     define input  parameter p-browse-handle as handle   no-undo .
     3649     define buffer buf_temp-browse-handle for temp-browse-handle .
     3650     do
     3651     on error undo, return error return-value
     3652     :
     3653       assign
     3654         v-diasize-browse-handle = p-browse-handle
     3655       .
     3656       for each buf_temp-browse-handle
     3657       on error undo, return error return-value
     3658       :
     3659         delete buf_temp-browse-handle .
     3660       end.
     3661     end.
     3662   end procedure.
     3663   procedure diasize_add_browse :
     3664     define input  parameter p-browse-type   as character no-undo .
     3665     define input  parameter p-browse-handle as handle    no-undo .
     3666     define buffer buf_temp-browse-handle for temp-browse-handle .
     3667     do
     3668     on error undo, return error return-value
     3669     :
     3670       assign
     3671         v-diasize-browse-number = v-diasize-browse-number + 1
     3672       .
     3673       create buf_temp-browse-handle .
     3674       assign
     3675         buf_temp-browse-handle.browse-type   = p-browse-type
     3676         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3677         buf_temp-browse-handle.browse-handle = p-browse-handle
     3678       .
     3679     end.
     3680   end procedure.
     3681   procedure diasize_init :
     3682     define variable v-default-value    as logical   no-undo .
     3683     define variable v-restore-saved    as logical   no-undo .
     3684     define variable v-resize-value-str as character no-undo .
     3685     do
     3686     on error undo, return error return-value
     3687     :
     3688       do with frame Dialog-Frame
     3689       :
     3690         assign
     3691           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3692           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3693           v-diasize-browse-handle     = browse BROWSE-1grp :handle
     3694         .
     3695         create button v-diasize-resize-button
     3696         assign
     3697           parent        = frame Dialog-Frame :first-child
     3698           label         = "s"
     3699           height-pixels = 16
     3700           width-pixels  = 16
     3701           visible       = true
     3702           sensitive     = true
     3703           movable       = true
     3704           triggers:
     3705             on end-move persistent run diasize_end-move in this-procedure .
     3706           end triggers.
     3707         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3708         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3709         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3710         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3711         assign
     3712           v-diasize-wndmax = false
     3713         .
     3714         if connected("ub") = true
     3715         then do:
     3716           define variable v-cntxt-db-num        as integer   no-undo .
     3717           define variable v-cntxt-userid        as character no-undo .
     3718           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3719                                             , OUTPUT v-cntxt-userid
     3720                                             ) .
     3721           run gbl/wndpar_r.p
     3722             (input  v-cntxt-db-num
     3723             ,input  v-cntxt-userid
     3724             ,input  'wndmax':U
     3725             ,output v-diasize-wndmax
     3726             ,output v-default-value
     3727             ) .
     3728         end.
     3729         assign
     3730           v-diasize-wndstore = false
     3731         .
     3732         if connected("ub") = true
     3733         then do:
     3734           run gbl/wndpar_r.p
     3735             (input  v-cntxt-db-num
     3736             ,input  v-cntxt-userid
     3737             ,input  'wndstore':U
     3738             ,output v-diasize-wndstore
     3739             ,output v-default-value
     3740             ) .
     3741         end.
     3742         assign
     3743           v-diasize-proc-name = entry(1, program-name(2), '.')
     3744         .
     3745         if v-diasize-wndstore = true
     3746         then do:
     3747           assign
     3748             v-restore-saved = false
     3749           .
     3750           if connected("ub") = true
     3751           then do:
     3752             run gbl/wndsizer.p
     3753               (input  v-cntxt-db-num
     3754               ,input  v-cntxt-userid
     3755               ,input  v-diasize-proc-name
     3756               ,input  'height':u
     3757               ,output v-resize-value-str
     3758               ) .
     3759             if v-resize-value-str <> '':U
     3760             then do:
     3761               run diasize_change-height in this-procedure
     3762                 (input  integer(v-resize-value-str)
     3763                 ,input  true
     3764                 ) .
     3765               assign
     3766                 v-restore-saved = true
     3767               .
     3768             end.
     3769           end.
     3770           if connected("ub") = true
     3771           then do:
     3772             run gbl/wndsizer.p
     3773               (input  v-cntxt-db-num
     3774               ,input  v-cntxt-userid
     3775               ,input  v-diasize-proc-name
     3776               ,input  'width':u
     3777               ,output v-resize-value-str
     3778               ) .
     3779             if v-resize-value-str <> '':U
     3780             then do:
     3781               run diasize_change-width in this-procedure
     3782                 (input  integer(v-resize-value-str)
     3783                 ,input  true
     3784                 ) .
     3785               assign
     3786                 v-restore-saved = true
     3787               .
     3788             end.
     3789           end.
     3790           if v-restore-saved <> true
     3791           then do:
     3792             if v-diasize-wndmax = true
     3793             then do:
     3794               run diasize_maximize in this-procedure
     3795                 (input  true
     3796                 ) .
     3797             end.
     3798           end.
     3799         end.
     3800         else do:
     3801           if v-diasize-wndmax = true
     3802           then do:
     3803             run diasize_maximize in this-procedure
     3804               (input  true
     3805               ) .
     3806           end.
     3807         end.
     3808       end.
     3809     end.
     3810   end procedure.
     3811   procedure diasize_need-full-display :
     3812     define output parameter p-need-full-display as logical   no-undo .
     3813     do
     3814     on error undo, return error return-value
     3815     :
     3816       assign
     3817         p-need-full-display = v-diasize-need-full-display
     3818       .
     3819       assign
     3820         v-diasize-need-full-display = false
     3821       .
     3822     end.
     3823   end procedure.
     3824   procedure get-context :
     3825      define output parameter p-db-num as integer          no-undo.
     3826      define output parameter p-user-id as character        no-undo.
     3827      define variable v-login               as character    no-undo.
     3828      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3829      define buffer buf_user-login  for ub.user-login .
     3830      do
     3831      on error undo, return error
     3832      :
     3833            FIND FIRST buf_sys-ctrl no-lock.
     3834            ASSIGN
     3835               v-login = USERID("ub")
     3836               p-db-num = buf_sys-ctrl.db-num
     3837            .
     3838            FIND FIRST buf_user-login
     3839                 WHERE buf_user-login.db-num = p-db-num
     3840                   AND buf_user-login.user-login = v-login
     3841                 no-lock
     3842                 no-error
     3843                 .
     3844            IF AVAILABLE buf_user-login
     3845            THEN DO:
     3846               assign
     3847                  p-user-id = buf_user-login.user-id
     3848               .
     3849            END.
     3850      end.
     3851   end procedure.
     3852   run diasize_add_browse in this-procedure
     3853     (input  'width':u
     3854     ,input  browse BROWSE-2-pr:handle
     3855     ) .
     3856   run diasize_init in this-procedure .
     3857   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3858   on f5 of frame Dialog-Frame anywhere
     3859   do:
     3860     run openbr in this-procedure .
     3861       apply "VALUE-CHANGED" to BROWSE-1grp.
     3862   end.
     3863   MAIN-BLOCK:
     3864   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3865      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3866     buf_price-list-type.name:resizable in browse BROWSE-1grp   = true .
     3867     buf_price-doc-forming.name:resizable in browse BROWSE-1grp   = true .
     3868     buf_price-doc-forming.name:read-only in browse BROWSE-1grp   = true .
     3869     frame Dialog-Frame:TITLE = ( if p-mode = "pl-type":U  then ("ДНЦ по ТИПУ прайс-листа № " + string( p-plt-id) + " БД " + string( p-plt-db-num))
     3870                                                           else "Документы назначения цены" )   .
     3871     v-title-0 = frame Dialog-Frame:TITLE .
     3872     R-status = 2.
     3873     run my_en in this-procedure .
     3874     apply "VALUE-CHANGED" to BROWSE-1grp IN FRAME Dialog-Frame .
     3875     disable
     3876        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     3877        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     3878        B-copy     when LOOKUP ("b-add":U,    p-bttns) = 0
     3879        i-copy     when LOOKUP ("b-add":U,    p-bttns) = 0
     3880        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     3881        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     3882        B-del-pr   when LOOKUP ("b-del":U,    p-bttns) = 0
     3883        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     3884       with frame Dialog-Frame .
     3885     hide B-del-pr in frame Dialog-Frame .
     3886     WAIT-FOR GO OF FRAME Dialog-Frame.
     3887   END.
     3888   run disable_ui in this-procedure .
     3889   PROCEDURE color-all :
     3890   define input  parameter p-color as integer   no-undo .
     3891     buf_price-doc-forming.pdf-id:fgcolor  in browse BROWSE-1grp =  p-color.
     3892     buf_price-doc-forming.name:fgcolor    in browse BROWSE-1grp =  p-color.
     3893   END PROCEDURE.
     3894   PROCEDURE disable_UI :
     3895     HIDE FRAME Dialog-Frame.
     3896   END PROCEDURE.
     3897   PROCEDURE enable_UI :
     3898     DISPLAY loc-pdf-id R-status R-obj T-paket FILL-IN-6 FILL-IN-1 FILL-IN-2
     3899             loc_gop_name v-user-name
     3900         WITH FRAME Dialog-Frame.
     3901     ENABLE B-Cancel B-mark B-sel B-add B-lkp B-chg B-del B-close B-ftpl B-sch
     3902            B-print B-history B-Help i-schTPL B-price-doc B-del-pr B-copy i-copy
     3903            loc-pdf-id R-status R-obj T-paket BROWSE-1grp b-lkp-pd BROWSE-2-pr
     3904            FILL-IN-6 FILL-IN-1 FILL-IN-2 loc_gop_name v-user-name
     3905         WITH FRAME Dialog-Frame.
     3906     VIEW FRAME Dialog-Frame.
     3907     OPEN QUERY BROWSE-1grp FOR     EACH buf_price-doc-forming WHERE     ( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND     ( p-mode = "all" OR (buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num))     USE-INDEX spis ,            FIRST buf_price-list-type  WHERE           buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num AND        ( r-obj = 2 OR        ( buf_price-list-type.gop-id     = loc_gop-id AND          buf_price-list-type.gop-db-num = loc_gop-db-num )).    OPEN QUERY BROWSE-2-pr FOR EACH buf_price-doc NO-LOCK WHERE       buf_price-doc.pdf-id = buf_price-doc-forming.pdf-id AND       buf_price-doc.pdf-db = buf_price-doc-forming.pdf-db AND       buf_price-doc.plt-id = buf_price-doc-forming.plt-id AND       buf_price-doc.plt-db-num = buf_price-doc-forming.plt-db-num INDEXED-REPOSITION.
     3908   END PROCEDURE.
     3909   PROCEDURE ini-flt-tpl :
     3910   define variable v-point as character no-undo .
     3911   define variable v-label as character no-undo .
     3912     assign
     3913     tbl = "price-list-type"
     3914     join-tbl = "buf_price-list-type"
     3915     fld = ""
     3916     lab = ""
     3917     spr = ""
     3918     dim = '0'
     3919     v-point = "tpl-pdf-obj"
     3920     v-label = "Типы прайс-листов"
     3921     .
     3922     run fltfield-add in this-procedure('main'        , 'Главный тип (ГТПЛ)',    '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3923     run fltfield-add in this-procedure('only-gbd'    , 'Автопереоценки', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3924     run fltfield-add in this-procedure('priority'    , 'Приоритет ТПЛ',  '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3925     run fltfield-add in this-procedure('ban-discnt'  , 'Шаблон Скидки',  '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3926     run fltfield-add in this-procedure('gop-db-num*gop-id'  , 'Группа объектов ценообразования','gop', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3927     run fltfield-add in this-procedure('name'        , 'Название ТПЛ',   '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3928     run fltfield-add in this-procedure('stts'        , 'Статус',         '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3929     run fltfield-add in this-procedure('sys-date'    , 'Дата изменения', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3930     run fltfield-add in this-procedure('sys-time'    , 'Время изменения', 'time', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3931     run fltfield-add in this-procedure('who'         , 'Кто', 'usr', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3932   Filter-Block:
     3933   DO  ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3934       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3935       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3936     run gbl/filter.w ( INPUT parparentproc,
     3937     INPUT v-point + chr(4) + v-label + chr(4) + "yes",
     3938     INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3939     run gbl/flt-get.p
     3940         (input v-point
     3941         ,output v-flt-rec
     3942         ,output v-filter-name
     3943         ,output v-where-phrase
     3944         ,output v-sort-phrase
     3945         ,output v-where-phrase-rus
     3946         ,output v-sort-phrase-rus
     3947         ).
     3948     B-ftpl:tooltip in frame Dialog-Frame  = v-filter-name .
     3949     if v-flt-rec = ? then do:
     3950        i-schTPL:LOAD-IMAGE ("cmp/b-sch.bmp") .
     3951        v-filter-name  = 'Фильтр по ТПЛ не установлен' .
     3952     end.
     3953     else do:
     3954        i-schTPL:LOAD-IMAGE ("cmp/b-sche.bmp") .
     3955     end.
     3956     B-ftpl:tooltip in frame Dialog-Frame  = v-filter-name .
     3957     i-schTPL:tooltip in frame Dialog-Frame  = v-filter-name .
     3958     run openbr in this-procedure .
     3959   END.
     3960   END PROCEDURE.
