     1692   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     1693         VIEW-AS TEXT
     1694        SIZE 7.5 BY .67
     1695        FGCOLOR 4  NO-UNDO.
     1696   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Объекты:"
     1697         VIEW-AS TEXT
     1698        SIZE 8.5 BY .67
     1699        FGCOLOR 4  NO-UNDO.
     1700   DEFINE VARIABLE FILL-IN-6 AS CHARACTER FORMAT "X(256)":U INITIAL "№ ДНЦ:"
     1701         VIEW-AS TEXT
     1702        SIZE 6 BY .67
     1703        FGCOLOR 4  NO-UNDO.
