        1   define output parameter odate as date no-undo.
        2   define output parameter oDocumentCreator as character no-undo.
        3   define output parameter oDocumentCreatorBase as character no-undo.
        4   define output parameter oOperationCode as character no-undo.
        5   define output parameter oOperationContent as character no-undo.
        6   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
        7        LABEL "Отмена"
        8        SIZE 15 BY 1.13
        9        BGCOLOR 8 .
       10   DEFINE BUTTON Btn_OK AUTO-GO
       11        LABEL "Ввод"
       12        SIZE 15 BY 1.13
       13        BGCOLOR 8 .
       14   DEFINE VARIABLE mDocCerator AS CHARACTER FORMAT "X(1000)":U
       15        LABEL "Наим. субъекта составителя"
       16        VIEW-AS FILL-IN
       17        SIZE 55 BY 1 TOOLTIP "НаимЭконСубСост" NO-UNDO.
       18   DEFINE VARIABLE mDocCrBase AS CHARACTER FORMAT "X(256)":U
       19        LABEL "Доверенность"
       20        VIEW-AS FILL-IN
       21        SIZE 55 BY 1 TOOLTIP "ОснДоверОргСост" NO-UNDO.
       22   DEFINE VARIABLE mDate AS DATE FORMAT "99/99/9999":U
       23        LABEL "Дата"
       24        VIEW-AS FILL-IN
       25        SIZE 14 BY 1 NO-UNDO.
       26   DEFINE VARIABLE mOperationCode AS CHARACTER FORMAT "X(256)":U
       27        LABEL "Вид операции"
       28        VIEW-AS FILL-IN
       29        SIZE 55 BY 1 TOOLTIP "ВидОперации" NO-UNDO.
       30   DEFINE VARIABLE mOperationContent AS CHARACTER FORMAT "X(256)":U INITIAL "1"
       31        LABEL "Содержание операции"
       32        VIEW-AS  COMBO-BOX INNER-LINES 7
       33        LIST-ITEM-PAIRS "Принято без разногласий","1",
       34                        "Принято с разногласиями","2"
       35        SIZE 55 BY 1 TOOLTIP "СодОпер" NO-UNDO.
       36   DEFINE FRAME Dialog-Frame
       37        Btn_OK AT ROW 1.25 COL 2
       38        Btn_Cancel AT ROW 1.25 COL 19
       39        mDate AT ROW 3 COL 35 COLON-ALIGNED WIDGET-ID 10
       40        mDocCerator AT ROW 4.5 COL 35 COLON-ALIGNED WIDGET-ID 2
       41        mDocCrBase AT ROW 6 COL 35 COLON-ALIGNED WIDGET-ID 4
       42        mOperationCode AT ROW 7.5 COL 35 COLON-ALIGNED WIDGET-ID 6
       43        mOperationContent AT ROW 9 COL 35 COLON-ALIGNED WIDGET-ID 8
       44        SPACE(2.74) SKIP(0.74)
       45       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       46            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       47            TITLE "Подпись документа"
       48            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       49   ASSIGN
       50          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       51          FRAME Dialog-Frame:HIDDEN           = TRUE.
       52   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       53   DO:
       54     APPLY "END-ERROR":U TO SELF.
       55   END.
       56   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
       57   DO:
       58      assign
       59         mDate
       60         mDocCerator
       61         mDocCrBase
       62         mOperationCode
       63         mOperationContent
       64      .
       65      if    mDocCerator eq ""
       66         or mDocCerator eq ?
       67      then do:
       68         message "Наименование субъекта обязательно для заполнения" view-as alert-box.
       69         return no-apply.
       70      end.
       71      assign
       72         odate                 = mDate
       73         oDocumentCreator      = mDocCerator
       74         oDocumentCreatorBase  = mDocCrBase
       75         oOperationCode        = mOperationCode
       76         oOperationContent     = mOperationContent
       77      .
       78   END.
       79   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       80   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       81   MAIN-BLOCK:
       82   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       83      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       84         mDate = today.
       85     RUN enable_UI.
       86     WAIT-FOR GO OF FRAME Dialog-Frame.
       87   END.
       88   RUN disable_UI.
       89   PROCEDURE disable_UI :
       90     HIDE FRAME Dialog-Frame.
       91   END PROCEDURE.
       92   PROCEDURE enable_UI :
       93     DISPLAY mDate mDocCerator mDocCrBase mOperationCode mOperationContent
       94         WITH FRAME Dialog-Frame.
       95     ENABLE Btn_OK Btn_Cancel mDate mDocCerator mDocCrBase mOperationCode
       96            mOperationContent
       97         WITH FRAME Dialog-Frame.
       98     VIEW FRAME Dialog-Frame.
       99   END PROCEDURE.
