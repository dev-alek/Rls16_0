     1616           .
     1617           FIND FIRST buf_inkas No-LOCK WHERE
     1618                             buf_inkas.inkas-code = buf_chk-doc.out-code No-ERROR.
     1619           assign
     1620               old-netto = buf_inkas.netto
     1621               old-tot-doc = buf_inkas.tot-doc
     1622               old-discnt = buf_inkas.discnt
     1623           .
