     2988       if not g#log then g#log = br-handle:select-prev-row().
     2989       v-doc-rec = recid (buf_fin-liab) .
     2990     end.
     2991      run OpenBr in this-procedure (yes, no, '':U).
     2992      apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2993      reposition BR-docs to recid v-doc-rec no-error.
     2994   END.
