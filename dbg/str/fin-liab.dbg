     8240   define variable p-ri                as recid no-undo.
     8241   define buffer buf2_fin-liab for ub.fin-ob.
     8242   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8243   do:
     8244     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8245       (input  v-cntxt-db-num
     8246       ,input  v-cntxt-userid
     8247       ,input  0
     8248       ,input  'actn_fin-liability_export':U
     8249       ,input  'firm':U
     8250       ,input  par-host-code
     8251       ,input  '':U
     8252       ,input  0
     8253       ,input  0
     8254       ,input  0
     8255       ,input  0
     8256       ,input  true
     8257       ,output g-log
     8258       )  .
     8259   end.
     8260   if not g-log then  return .
     8261   if not g-log then  return .
     8262   if num-entries(rid-list) = 0 then do:
     8263      message "Не отмечены записи для копирования !!!" .
     8264      return .
     8265   end.
     8266     define variable v-user-select as logical   no-undo .
     8267   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8268   run userhsts_select-many in this-procedure
     8269     (input  parparentproc
     8270     ,input  v-cntxt-db-num
     8271     ,input  v-cntxt-userid
     8272     ,input  v-cntxt-host-code-obj
     8273     ,output v-user-select
     8274     )  .
     8275     if v-user-select <> true
     8276     then do:
     8277       return no-apply .
     8278     end.
     8279     define variable v-total-select as integer   no-undo .
     8280     run userhsts_object-count in this-procedure
     8281       (output v-total-select
     8282       ) .
     8283     if v-total-select  = 0
     8284     then do:
     8285       message "Не выбрана фирма для копирования !!!" .
     8286       return .
     8287     end.
     8288     message
     8289       "Отмечено фирм:" v-total-select skip
     8290       "Скопировать выбранные значения справочника в эти фирмы ?"
     8291       view-as alert-box question
     8292       buttons yes-no
     8293       update p-ok.
     8294     k = 0.
     8295     if p-ok = false then return.
     8296     define variable v-8 as integer   no-undo .
     8297     v-8 = num-entries(rid-list) .
     8298       define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     8299       for each buf_userhsts_temp-user-host
     8300       :
     8301           repeat j = 1 to v-8
     8302           :
     8303             for each buf2_fin-liab where recid(buf2_fin-liab) =  integer(entry(j,rid-list)):
     8304             if not can-find ( first buf_fin-liab no-lock where
     8305                                 buf_fin-liab.host-code      = buf_userhsts_temp-user-host.host-code and
     8306                                 buf_fin-liab.doc-code       = buf2_fin-liab.doc-code) then do:
     8307                     run current-db  in this-procedure
     8308                     (   input buf_fin-liab.host-code,
     8309                         input par-host-code,
     8310                         output p-ret ) .
     8311                     if p-ret = no then next.
     8312                     run fin-ob-code     in this-procedure (input g#db-num , output p-doc-code ).
     8313                     run create-fin-liab in this-procedure
     8314                     (   input yes ,
     8315                         input  p-doc-code            ,
     8316                         input  today            ,
     8317                         input  buf2_fin-liab.doc-type            ,
     8318                         input  buf2_fin-liab.payer-name            ,
     8319                         input  buf2_fin-liab.receiver-name            ,
     8320                         input  buf2_fin-liab.curr-code           ,
     8321                         input  buf2_fin-liab.sum-doc             ,
     8322                         input  buf2_fin-liab.user-db-num-doc     ,
     8323                         input  buf2_fin-liab.user-name-doc       ,
     8324                         input  buf2_fin-liab.base-rate           ,
     8325                         input  buf2_fin-liab.base-scale          ,
     8326                         input  buf2_fin-liab.receiver-code       ,
     8327                         input  buf2_fin-liab.receiver-type       ,
     8328                         input  buf2_fin-liab.contract-code       ,
     8329                         input  buf2_fin-liab.exch-rate           ,
     8330                         input  buf2_fin-liab.exch-scale          ,
     8331                         input  buf2_fin-liab.contract-curr       ,
     8332                         input  buf2_fin-liab.contract-rate       ,
     8333                         input  buf2_fin-liab.contract-scale      ,
     8334                         input  buf2_fin-liab.fact-date           ,
     8335                         input  buf2_fin-liab.fact-order          ,
     8336                         input  par-host-code           ,
     8337                         input  buf2_fin-liab.payer-code          ,
     8338                         input  buf2_fin-liab.payer-type          ,
     8339                         input  buf2_fin-liab.pay-date            ,
     8340                         input  buf2_fin-liab.prn-doc-code        ,
     8341                         input  'новый':U          ,
     8342                         input  buf2_fin-liab.sum-base-orig       ,
     8343                         input  buf2_fin-liab.sum-base            ,
     8344                         input  buf2_fin-liab.sum-doc-orig        ,
     8345                         input  buf2_fin-liab.sum-rubl-orig       ,
     8346                         input  buf2_fin-liab.sum-rubl            ,
     8347                         input  buf2_fin-liab.sum-contract        ,
     8348                         input  buf2_fin-liab.trn-doc-code        ,
     8349                         input  buf2_fin-liab.user-db-num-fact    ,
     8350                         input  buf2_fin-liab.user-db-num-pay        ,
     8351                         input  buf2_fin-liab.user-name-fact         ,
     8352                         input  buf2_fin-liab.user-name-pay          ,
     8353                         input  buf2_fin-liab.in-type                ,
     8354                         input  buf2_fin-liab.sum-tax-base           ,
     8355                         input  buf2_fin-liab.sum-tax-doc            ,
     8356                         input  buf2_fin-liab.sum-tax-rubl           ,
     8357                         input  buf2_fin-liab.sum-tax-contract       ,
     8358                         input  ""                       ,
     8359                         output p-ri ).
     8360                         k = k + 1.
     8361                     end.
     8362             end.
     8363           end.
     8364        end.
     8365   message "Скопировано " k  "обязательств" view-as alert-box .
     8366   END PROCEDURE.
     8367   PROCEDURE proc-find-code :
     8368   define input parameter par-next as logical no-undo.
     8369   define input parameter pardoc-code as char no-undo.
     8370   display "" @ p-desc with frame Dialog-Frame.
     8371   display "" @ p-date with frame Dialog-Frame.
     8372     doc-rec = ? .
     8373     find first  buf_fin-liab no-lock where  buf_fin-liab.prn-doc-code = pardoc-code no-error  .
     8374     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     8375     reposition BR-docs to recid doc-rec no-error .
     8376     if not error-status :error then apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     8377     else do:
     8378          message " Запись не найдена " view-as alert-box information .
     8379     end.
     8380   END PROCEDURE.
     8381   PROCEDURE proc-find-date :
     8382   define input parameter par-next as logical no-undo.
     8383   define input parameter pardoc-code as date no-undo.
     8384   define variable ppp as character no-undo .
     8385   display "" @ p-desc with frame Dialog-Frame.
     8386   display "" @ sch-code with frame Dialog-Frame.
     8387     doc-rec = ? .
     8388     if par-next = true then find next buf_fin-liab no-lock where  buf_fin-liab.doc-date = pardoc-code no-error  .
     8389     else  find first  buf_fin-liab no-lock where  buf_fin-liab.doc-date = pardoc-code no-error  .
     8390     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     8391     reposition BR-docs to recid doc-rec no-error .
     8392     if not error-status :error then apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     8393     else do:
     8394          message " Запись не найдена " view-as alert-box information .
     8395     end.
     8396   END PROCEDURE.
     8397   PROCEDURE proc-find-desc :
     8398   define input parameter par-next as logical no-undo.
     8399   define input parameter pardoc-code as char no-undo.
     8400   define variable pp as integer no-undo.
     8401   define buffer b_contract for ub.contract.
     8402   display "" @ sch-code with frame Dialog-Frame.
     8403   display "" @ p-date with frame Dialog-Frame.
     8404   if  par-next = true then
     8405       find next b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code use-index num no-error .
     8406   else
     8407     find first b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code  use-index num no-error .
     8408   if available b_contract
     8409   then do:
     8410     doc-rec = ? .
     8411     if par-next = true then find next buf_fin-liab no-lock where  buf_fin-liab.contract-code = b_contract.contract-code no-error  .
     8412     else  find first  buf_fin-liab no-lock where  buf_fin-liab.contract-code = b_contract.contract-code no-error  .
     8413     if available buf_fin-liab then doc-rec = recid(buf_fin-liab) .
     8414     reposition BR-docs to recid doc-rec no-error .
     8415     if not error-status :error then apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     8416     else do:
     8417          message " Запись не найдена " view-as alert-box information .
     8418     end.
     8419   end.
     8420   else do:
     8421     message "Договор с таким номером не найден !!!" .
     8422     apply "entry":u to p-desc in frame Dialog-Frame .
     8423   end.
     8424   END PROCEDURE.
     8425   PROCEDURE proc-m_gen-1 :
     8426   define buffer bf_fin-ob for ub.fin-ob.
     8427   define variable vari as integer no-undo.
     8428   define variable vardoc-code as integer no-undo.
     8429   define variable varlog as logical   no-undo .
     8430   define variable v-list as character no-undo .
     8431   define variable v-9 as integer   no-undo .
     8432   do on error undo, return error return-value :
     8433     if num-entries(rid-list) = 0 then do:
     8434       message "Не выделено ни одного ФО для генерации счета-фактуры !".
     8435       return .
     8436     end.
     8437       varlog = yes.
     8438       message "Выбрано " + string( num-entries( rid-list)  ) +  " ФО . Провести генерацию счетов-фактур?" skip
     8439               view-as alert-box question buttons OK-Cancel update varlog.
     8440       if not varlog then return.
     8441       v-9 = num-entries (rid-list).
     8442       do vari = 1 to v-9 :
     8443           assign vardoc-code = integer(entry (vari, rid-list)).
     8444           find first bf_fin-ob where recid(bf_fin-ob) = vardoc-code no-lock no-error .
     8445           if not available bf_fin-ob then next.
     8446           if bf_fin-ob.status_ <> 'факт':U then do:
     8447             message "Документ " bf_fin-ob.prn-doc-code " статус " bf_fin-ob.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
     8448             next .
     8449           end.
     8450           if bf_fin-ob.cr-factur = yes then do:
     8451             message "По документу " bf_fin-ob.doc-code " уже создавался счет-фактура от " bf_fin-ob.factur-date " числа." view-as alert-box.
     8452           end.
     8453           else do:
     8454             run str/gen-scf.p ( input parParentProc, input vardoc-code, "fin-ob", output v-list) no-error .
     8455             if error-status:error then  return error substitute(" Ошибка создания счета-фактуры по ФО &1 &2 &3" ,bf_fin-ob.prn-doc-code, return-value , error-status :get-message(1)) .
     8456           end.
     8457       end.
     8458       assign rid-list = "" .
     8459       run OpenBr in this-procedure (yes, no, '':U) .
     8460     end.
     8461   end procedure.
     8462   PROCEDURE proc-m_gen-2 :
     8463   define buffer bf_sysconf for ub.sysconf.
     8464   define buffer bf_fin-ob for ub.fin-ob.
     8465   define variable vari as integer no-undo.
     8466   define variable vardoc-code as integer no-undo.
     8467   do on error undo, return error return-value
     8468   :
     8469   define variable v-10 as integer   no-undo .
     8470   v-10 = num-entries (rid-list) .
     8471       if rid-list = "" then do:
     8472         if available buf_fin-liab then assign rid-list = string(recid(buf_fin-liab)).
     8473       end.
     8474   vari-cycle:
     8475     do vari = 1 to v-10 :
     8476       assign vardoc-code = integer(entry (vari, rid-list)).
     8477       find first bf_fin-ob where recid(bf_fin-ob) = vardoc-code exclusive-lock.
     8478       if bf_fin-ob.status_ <> 'факт':U then do:
     8479         message "Документ " bf_fin-ob.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
     8480         next vari-cycle.
     8481       end.
     8482       find first bf_sysconf where bf_sysconf.host-code = bf_fin-ob.host-code no-lock.
     8483       if bf_fin-ob.user-db-num-doc <> g#db-num then do:
     8484         message "БД документа с кодом " bf_fin-ob.doc-code " не coвпадает с текущей БД." skip
     8485                 "Текущая БД: " v-cntxt-db-num skip "БД док-та: " bf_fin-ob.user-db-num-doc  " . Пропускаем."
     8486         view-as alert-box error.
     8487         next vari-cycle.
     8488       end.
     8489       if bf_fin-ob.cr-factur = yes then do:
     8490         message "По документу " bf_fin-ob.doc-code " уже создавался счет-фактура от " bf_fin-ob.factur-date " числа." view-as alert-box.
     8491         next vari-cycle.
     8492       end.
     8493       else do:
     8494         if bf_fin-ob.need-factur = 1 or bf_fin-ob.need-factur = 2 then assign  bf_fin-ob.need-factur = 0.
     8495         else do:
     8496           message "Данный документ не нуждался в генерации счета-фактуры." view-as alert-box.
     8497           next vari-cycle.
     8498         end.
     8499         reposition BR-docs to recid recid(bf_fin-ob) no-error.
     8500         if not error-status:error then do:
     8501           display f-factur (recid( bf_fin-ob)) @ varfactur with browse BR-docs.
     8502         end.
     8503       end.
     8504     end.
     8505     assign rid-list = "".
     8506   end.
     8507   end procedure.
     8508   PROCEDURE proc-m_gen-3 :
     8509   define buffer bf_sysconf for ub.sysconf.
     8510   define buffer bf_fin-ob for ub.fin-ob.
     8511   define variable vari as integer no-undo.
     8512   define variable vardoc-code as integer no-undo.
     8513   define variable varlog as logical   no-undo .
     8514   do on error undo, return error return-value
     8515   :
     8516     if rid-list = "" then do:
     8517       if available buf_fin-liab then assign rid-list = string(recid(buf_fin-liab)).
     8518     end.
     8519   define variable v-11 as integer   no-undo .
     8520   v-11 = num-entries (rid-list) .
     8521   vari-cycle:
     8522     do vari = 1 to v-11 :
     8523       assign vardoc-code = integer(entry (vari, rid-list)).
     8524       find first bf_fin-ob where recid(bf_fin-ob) = vardoc-code exclusive-lock.
     8525       find first bf_sysconf where bf_sysconf.host-code = bf_fin-ob.host-code no-lock.
     8526       if bf_fin-ob.status_ <> 'факт':U then do:
     8527         message "Документ " bf_fin-ob.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
     8528         next vari-cycle.
     8529       end.
     8530       if bf_fin-ob.user-db-num-doc <> g#db-num then do:
     8531         message "БД документа с кодом " bf_fin-ob.doc-code " не coвпадает с текущей БД." skip
     8532                 "Текущая БД: " v-cntxt-db-num skip "БД док-та: " bf_fin-ob.user-db-num-doc  " . Пропускаем."
     8533         view-as alert-box error.
     8534         next vari-cycle.
     8535       end.
     8536       if bf_fin-ob.cr-factur = yes then do:
     8537         assign
     8538           varlog = no.
     8539           message "По документу " bf_fin-ob.doc-code " был создан счет-фактура от " bf_fin-ob.factur-date " ." skip
     8540                   "Вы действительно хотите снять признак, чтобы по этому документу был счет-фактура?"
     8541           view-as alert-box question buttons yes-no update varlog.
     8542          if varlog <> yes then  next vari-cycle.
     8543          assign
     8544            bf_fin-ob.cr-factur   = no
     8545            bf_fin-ob.factur-date = 01/01/1990
     8546          .
     8547          reposition BR-docs to recid recid(bf_fin-ob) no-error.
     8548         if not error-status:error then do:
     8549           display f-factur (recid( bf_fin-ob)) @ varfactur with browse BR-docs.
     8550         end.
     8551       end.
     8552       else do:
     8553         message "По документу " bf_fin-ob.doc-code " не было генерации."
     8554         view-as alert-box.
     8555      end.
     8556    end.
     8557    assign rid-list = "".
     8558   end.
     8559   end procedure.
     8560   PROCEDURE proc-m_gen-4 :
     8561   define buffer bf_sysconf for ub.sysconf.
     8562   define buffer bf_fin-ob for ub.fin-ob.
     8563   define variable vari as integer no-undo.
     8564   define variable vardoc-code as integer no-undo.
     8565   define variable varneed-factur as logical no-undo.
     8566   define buffer bf_contract for ub.contract.
     8567   do on error undo, return error return-value
     8568   :
     8569     if rid-list = "" then do:
     8570       if available buf_fin-liab then assign rid-list = string(recid(buf_fin-liab)).
     8571     end.
     8572   define variable v-12 as integer   no-undo .
     8573   v-12 = num-entries (rid-list).
     8574   vari-cycle:
     8575     do vari = 1 to v-12:
     8576       assign vardoc-code = integer(entry (vari, rid-list)) .
     8577       find first bf_fin-ob where recid(bf_fin-ob) = vardoc-code exclusive-lock.
     8578       find first bf_sysconf where bf_sysconf.host-code = bf_fin-ob.host-code no-lock.
     8579       if bf_fin-ob.status_ <> 'факт':U then do:
     8580         message "Документ " bf_fin-ob.status_ " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
     8581         next.
     8582       end.
     8583       if bf_fin-ob.user-db-num-doc <> g#db-num then do:
     8584         message "БД документа с кодом " bf_fin-ob.doc-code " не coвпадает с текущей БД." skip
     8585                 "Текущая БД: " v-cntxt-db-num skip "БД док-та: " bf_fin-ob.user-db-num-doc  " . Пропускаем."
     8586         view-as alert-box error.
     8587         return error.
     8588       end.
     8589       if bf_fin-ob.need-factur = 2 then do:
     8590         if bf_fin-ob.contract-code <> 0 then do:
     8591           find first bf_contract where bf_contract.host-code     = bf_fin-ob.host-code   and
     8592                                        bf_contract.contract-code = bf_fin-ob.contract-code no-lock no-error.
     8593           if available bf_contract then do:
     8594             if bf_contract.gen-factur = 2 or bf_contract.gen-factur = 12 or bf_contract.gen-factur = 102 or bf_contract.gen-factur = 112 then do:
     8595               assign bf_fin-ob.need-factur = 1  .
     8596               reposition BR-docs to recid recid(bf_fin-ob) no-error.
     8597               if not error-status:error then display f-factur (recid( bf_fin-ob)) @ varfactur with browse BR-docs.
     8598             end.
     8599             else message "По документу " bf_fin-ob.doc-code " нет договоров для генерации счета-фактуры."  view-as alert-box.
     8600           end.
     8601         end.
     8602       end.
     8603       else do:
     8604         message "Документ " bf_fin-ob.doc-code "не имеет признака 'не опред' генерация счета-фактуры."
     8605         view-as alert-box.
     8606         next vari-cycle.
     8607       end.
     8608     end.
     8609     assign rid-list = "" .
     8610   end.
     8611   end procedure.
     8612   PROCEDURE set-filter-name :
     8613   define input parameter p-filter-name as character no-undo .
     8614     do with frame Dialog-Frame:
     8615       if p-filter-name > "" then do:
     8616         assign
     8617           frame Dialog-Frame:title
     8618             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     8619         .
     8620         assign
     8621           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     8622         .
     8623       end.
     8624       else do:
     8625         assign
     8626           b-sch :TOOLTIP = ""
     8627         .
     8628       end.
     8629     end.
     8630   END PROCEDURE.
     8631   PROCEDURE set-selection :
     8632   define buffer buf_clients for ub.clients  .
     8633   assign frame Dialog-Frame
     8634     r-1
     8635     r-2
     8636     r-3
     8637     v-date-doc-1
     8638     v-date-doc-2
     8639     v-date-pay-1
     8640     v-date-pay-2
     8641     .
     8642   if v-date-doc-1 = ? and v-date-doc-2 = ? then d-1 = 1 .
     8643                                            else d-1 = 2 .
     8644   if v-date-pay-1 = ? and v-date-pay-2 = ? then d-2 = 1 .
     8645                                            else d-2 = 2 .
     8646   if v-date-doc-1 = ? then v-date-doc-1 = 01/01/91 .
     8647   if v-date-pay-1 = ? then v-date-pay-1 = 01/01/91 .
     8648   if v-date-doc-2 = ? then v-date-doc-2 = today + 3 .
     8649   if v-date-pay-2 = ? then v-date-pay-2 = today + 3 .
     8650   if d-1 = 2 then do:
     8651     if v-date-doc-1 > v-date-doc-2 then do: message "Не верно задан интервал дат создания ФО ! " view-as alert-box error .
     8652     return error return-value .
     8653     end.
     8654   end.
     8655   if d-2 = 2 then do:
     8656     if v-date-pay-1 > v-date-pay-2 then do: message "Не верно задан интервал дат платежа ! " view-as alert-box error .
     8657     return error return-value .
     8658     end.
     8659   end.
     8660   if r-1 = 2 then do:
     8661         find first buf_clients no-lock where
     8662                     buf_clients.obj-code = hard-flt-cli-code  and
     8663                     buf_clients.obj-type = hard-flt-cli-type  no-error .
     8664                     if error-status :error then r-1 = 1 .
     8665   end.
     8666   if r-2 = 2 then do:
     8667         find first x-contract no-lock  no-error .
     8668         if error-status :error then r-2 = 1 .
     8669   end.
     8670   case r-3 :
     8671     when 1 then do:
     8672        r-31 = 1.
     8673        r-32 = 1.
     8674     end.
     8675     when 2 then do:
     8676        r-31 = 2.
     8677        r-32 = 1.
     8678     end.
     8679     when 3 then do:
     8680        r-31 = 1.
     8681        r-32 = 2.
     8682     end.
     8683   end case.
     8684   END PROCEDURE.
     8685   FUNCTION contract-gen RETURNS CHARACTER
     8686   ( input p-rec as recid ) :
     8687   define BUFFER loc-fin-liab FOR ub.fin-ob.
     8688   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error.
     8689   if error-status :error then return ''.
     8690     define variable rr as character no-undo .
     8691     define buffer buf-f_contract for ub.contract.
     8692     find first buf-f_contract no-lock where  buf-f_contract.host-code      = par-host-code  and
     8693                                             buf-f_contract.contract-code  = loc-fin-liab.contract-code  no-error.
     8694     if available buf-f_contract then   rr = buf-f_contract.usl-opl .
     8695        else rr = "".
     8696     RETURN rr.
     8697   END FUNCTION.
     8698   FUNCTION contract-id RETURNS CHARACTER
     8699   ( input p-rec as recid ) :
     8700   define  BUFFER loc-fin-liab FOR ub.fin-ob.
     8701   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     8702   if error-status :error then return '' .
     8703     define variable rr as character no-undo .
     8704     define buffer buf-f_contract for ub.contract.
     8705     find first buf-f_contract no-lock where  buf-f_contract.host-code      = par-host-code  and
     8706                                             buf-f_contract.contract-code  = loc-fin-liab.contract-code  no-error.
     8707     if available buf-f_contract then   rr = buf-f_contract.contract-prn-code.
     8708        else rr = "".
     8709     RETURN rr.
     8710   END FUNCTION.
     8711   FUNCTION debts RETURNS DECIMAL
     8712   ( input p-rec as recid ) :
     8713   define  BUFFER buf_fin-liab FOR ub.fin-ob .
     8714   find first  buf_fin-liab no-lock where recid (buf_fin-liab) = p-rec no-error .
     8715   if error-status :error then return ? .
     8716     RETURN buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl .
     8717   END FUNCTION.
     8718   FUNCTION f-factur RETURNS CHARACTER
     8719   ( input p-rec as recid ) :
     8720   define buffer loc-t-doc for ub.fin-ob .
     8721   find first loc-t-doc no-lock where recid (loc-t-doc) = p-rec no-error .
     8722   if error-status :error then return '' .
     8723    if loc-t-doc.cr-factur = yes then do:
     8724      return string (loc-t-doc.factur-date, "99/99/99").
     8725    end.
     8726    else do:
     8727      if loc-t-doc.need-factur = 0 then do:
     8728        return "--------".
     8729      end.
     8730      if loc-t-doc.need-factur = 1 then do:
     8731        return " ".
     8732      end.
     8733      if loc-t-doc.need-factur = 2 then do:
     8734        return "не опред".
     8735      end.
     8736    end.
     8737   END FUNCTION.
     8738   FUNCTION sel-abbr RETURNS CHARACTER
     8739    ( p-curr-code as int ) :
     8740     define variable rr as character no-undo .
     8741     find first ub.currency no-lock where  ub.currency.curr-code  = p-curr-code no-error.
     8742     rr = ub.currency.curr-abbr.
     8743     RETURN rr.
     8744   END FUNCTION.
     8745   FUNCTION val-abbr-type RETURNS CHARACTER
     8746   ( input p-rec as recid ) :
     8747   define  BUFFER loc-fin-liab FOR ub.fin-ob.
     8748   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     8749   if error-status :error then return '' .
     8750     define variable rr as character no-undo .
     8751        find first ub.currency no-lock where ub.currency.curr-code  = loc-fin-liab.curr-code no-error.
     8752     rr = currency.curr-abbr .
     8753   if available ub.currency then  rr = ub.currency.curr-abbr.
     8754   else rr = ""   .
     8755     RETURN rr.
     8756   END FUNCTION.
