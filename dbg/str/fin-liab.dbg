     2199   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2200   procedure fltopend_fltopend :
     2201   define input parameter p-parent-handle as handle no-undo .
     2202   define input parameter p-qh as handle no-undo .
     2203   define input parameter p-flt-open-open-query  as character no-undo .
     2204   define input parameter p-where-cond as character no-undo .
     2205   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2206   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2207   define input parameter p-indexed-reposition as character no-undo .
     2208     do
     2209     on error undo, return error
     2210     :
     2211   define variable v-prepare-string as character no-undo .
     2212   define variable glog as logical no-undo .
     2213   assign
     2214   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2215                      p-where-cond + chr(32)  +
     2216                      p-use-indFIRST-query-tail + chr(32) +
     2217                      p-use-ind-sort-clmn-by + chr(32) +
     2218                      p-indexed-reposition
     2219   .
     2220   assign
     2221   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2222   if not glog
     2223   or error-status:error then do:
     2224     message error-status:get-message(1) view-as alert-box .
     2225     undo, return error .
     2226   end.
     2227   assign
     2228   glog = p-qh:query-open no-error .
     2229   if not glog
     2230   or error-status:error then do:
     2231     message error-status:get-message(1) view-as alert-box .
     2232     undo, return error .
     2233   end.
     2234     end.
     2235   end procedure.
     2236   procedure fltopend_fltfindd :
     2237   define input parameter p-parent-handle as handle no-undo .
     2238   define input parameter p-qh as handle no-undo .
     2239   define input parameter p-rowid as rowid no-undo .
     2240   define input parameter p-next as logical no-undo .
     2241   define input parameter p-lock as integer no-undo .
     2242   define input parameter p-bh as handle no-undo .
     2243   define input parameter p-where-cond as character no-undo .
     2244   define input parameter p-use-index-phrase as character no-undo .
     2245   define variable glog as logical no-undo .
     2246   define variable v-qh as handle no-undo .
     2247   define variable v-bh as handle no-undo .
     2248   define variable v-recid as recid no-undo .
     2249   define variable v-prepare-string as character no-undo .
     2250   do
     2251   on error undo, return error
     2252   on stop undo, return error
     2253   :
     2254     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2255     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2256     create query v-qh.
     2257     v-qh:set-buffers(v-bh).
     2258     v-prepare-string = substitute("for each &1 &2 &3"
     2259                                     ,v-bh:name
     2260                                     ,p-where-cond
     2261                                     ,p-use-index-phrase).
     2262     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2263     if not glog then do:
     2264       delete object v-qh.
     2265       delete object v-bh.
     2266       undo, return error .
     2267     end.
     2268     glog = v-qh:query-open no-error .
     2269     if not glog then do:
     2270       delete object v-qh.
     2271       delete object v-bh.
     2272       undo, return error .
     2273     end.
     2274     if p-next then do:
     2275       v-qh:reposition-to-rowid(p-rowid) no-error .
     2276       glog = v-qh:get-next( p-lock) no-error .
     2277       glog = v-qh:get-next( p-lock) no-error .
     2278       if not glog or v-qh:query-off-end = yes then do:
     2279         glog = v-qh:get-first( p-lock) no-error .
     2280       end.
     2281     end.
     2282     else do:
     2283       glog = v-qh:get-first( p-lock) no-error .
     2284     end.
     2285     v-recid = v-bh:recid no-error .
     2286     delete object v-qh.
     2287     delete object v-bh.
     2288     return string(v-recid) .
     2289   end.
     2290   end procedure.
     2291   procedure fltopend_fltfindq :
     2292   define input parameter p-parent-handle as handle no-undo .
     2293   define input parameter p-qh as handle no-undo .
     2294   define input parameter p-next as logical no-undo .
     2295   define input parameter p-lock as integer no-undo .
     2296   define input parameter p-flt-open-open-query  as character no-undo .
     2297   define input parameter p-where-cond as character no-undo .
     2298   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2299   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2300   define input parameter p-indexed-reposition as character no-undo .
     2301   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2302   define variable glog as logical no-undo .
     2303   define variable v-qh as handle no-undo .
     2304   define variable v-bh as handle no-undo extent 18.
     2305   define variable v-rowid as rowid no-undo extent 18.
     2306   define variable v-ii as integer no-undo .
     2307   define variable v-prepare-string as character no-undo .
     2308   do
     2309   on error undo, return error
     2310   on stop undo, return error
     2311   :
     2312     create query v-qh.
     2313     do v-ii = 1 to p-qh:num-buffers:
     2314       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2315       assign
     2316       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2317       no-error.
     2318       v-qh:add-buffer(v-bh[v-ii]).
     2319     end.
     2320     assign
     2321     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2322                       p-where-cond + chr(32)  +
     2323                       p-use-indFIRST-query-tail + chr(32) +
     2324                       p-use-ind-sort-clmn-by + chr(32) +
     2325                       p-indexed-reposition
     2326     .
     2327     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2328     if not glog then do:
     2329       delete object v-qh.
     2330       do v-ii = 1 to p-qh:num-buffers:
     2331         delete object v-bh[v-ii].
     2332       end.
     2333       undo, return error .
     2334     end.
     2335     glog = v-qh:query-open no-error .
     2336     if not glog then do:
     2337       delete object v-qh.
     2338       do v-ii = 1 to p-qh:num-buffers:
     2339         delete object v-bh[v-ii].
     2340       end.
     2341       undo, return error .
     2342     end.
     2343     if p-next then do:
     2344       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2345       glog = v-qh:get-next( p-lock) no-error .
     2346       glog = v-qh:get-next( p-lock) no-error .
     2347       if not glog or v-qh:query-off-end = yes then do:
     2348         glog = v-qh:get-first( p-lock) no-error .
     2349       end.
     2350     end.
     2351     else do:
     2352       glog = v-qh:get-first( p-lock) no-error .
     2353     end.
     2354     do v-ii = 1 to p-qh:num-buffers:
     2355       assign
     2356       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2357       no-error.
     2358     end.
     2359     delete object v-qh.
     2360     do v-ii = 1 to p-qh:num-buffers:
     2361       delete object v-bh[v-ii].
     2362     end.
     2363   end.
     2364   end procedure.
