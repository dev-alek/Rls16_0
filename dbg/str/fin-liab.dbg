     6996   PROCEDURE OpenBr :
     6997   define input  parameter p-open-query     as logical   no-undo .
     6998   define input  parameter p-find-next      as logical   no-undo .
     6999   define input  parameter p-find-condition as character no-undo .
     7000   define variable l-query-was-opened as logical no-undo .
     7001   define variable title0 as character no-undo.
     7002   define buffer buff_contract for ub.contract.
     7003   define variable loc_contract-code as character no-undo .
     7004   title0 = caps(p-file-label) + chr(32).
     7005   define variable sort-column-phrase as character no-undo .
     7006   case sort-column-name :
     7007     when "" then do:
     7008       assign
     7009         sort-column-phrase = ""
     7010       .
     7011     end.
     7012     otherwise do:
     7013       assign
     7014         sort-column-phrase = "by " + sort-column-name
     7015       .
     7016     end.
     7017   end case.
     7018   define variable l-open-query as logical   no-undo .
     7019          find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     7020          if not available buf_clients then return .
     7021          filter-point = filter-point0 + par-mode.
     7022     CASE par-mode :
     7023       WHEN 'фирма':U THEN DO:
     7024          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + " код: " +  string(par-host-code).
     7025   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7026   define variable  l-disable-where-54  as logical   no-undo .
     7027   define variable  l-filter-open-54    as logical   .
     7028   define variable  flt-rec-54       as recid     no-undo .
     7029   define variable  filter-name-54      as character no-undo .
     7030   define variable  where-phrase-54     as character no-undo .
     7031   define variable  sort-phrase-54      as character no-undo .
     7032   define variable  where-phrase-rus-54 as character no-undo .
     7033   define variable  sort-phrase-rus-54  as character no-undo .
     7034     run waitfram-show in this-procedure
     7035       (input "ЖДИТЕ ..."
     7036       ).
     7037   run gbl/flt-get.p
     7038     (input filter-point
     7039     ,output flt-rec-54
     7040     ,output filter-name-54
     7041     ,output where-phrase-54
     7042     ,output sort-phrase-54
     7043     ,output where-phrase-rus-54
     7044     ,output sort-phrase-rus-54
     7045     ).
     7046   if p-open-query then do:
     7047       run set-filter-name in this-procedure
     7048         (INPUT filter-name-54
     7049         ) no-error .
     7050     assign
     7051       l-filter-open-54 = false
     7052     .
     7053     if flt-rec-54 <> ?
     7054       or sort-column-phrase > ""
     7055     then do:
     7056       define variable  parameter-2-54 as character no-undo .
     7057       define variable  parameter-3-54 as character no-undo .
     7058       define variable  parameter-4-54 as character no-undo .
     7059       define variable  parameter-5-54 as character no-undo .
     7060       define variable  parameter-6-54 as character no-undo .
     7061       define variable  parameter-7-54 as character no-undo .
     7062         assign
     7063         parameter-3-54 =
     7064                                 "FOR EACH buf_fin-liab"
     7065         parameter-4-54 =
     7066           (
     7067             if ("     buf_fin-liab.host-code = par-host-code  and    ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))    " + " " + where-phrase-54) <> ""
     7068             then           substitute('           buf_fin-liab.host-code = &2  and           ( &3 = 1 or ( buf_fin-liab.receiver-code = &4 and buf_fin-liab.receiver-type = &1&5&1 )) and          ( &6 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &7 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ' , chr(34) , par-host-code , r-1 , hard-flt-cli-code , hard-flt-cli-type , r-31 ,r-32) +          substitute('           ( &2 = 1  or ( &3 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &4 )) and          ( &5 = 1  or ( &6 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &7 ))           ' , chr(34) , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1 , v-date-pay-2 )           + " " + where-phrase-54
     7069             else "true"
     7070           )
     7071         parameter-5-54 = (" " + "" + " " + substitute(' , FIRST xx-contract where (  &1 = 1  or (  xx-contract.contract-code = buf_fin-liab.contract-code )) ' , r-2 ))
     7072         parameter-6-54 = if sort-phrase-54 = ''
     7073                              then
     7074           (
     7075           " " + " " +
     7076             " " + sort-column-phrase +
     7077           " " + " "
     7078           )
     7079                              else
     7080           (
     7081           " " + " " +
     7082             " " + sort-column-phrase +
     7083           " " + sort-phrase-54
     7084           )
     7085         parameter-7-54 =
     7086           "   "
     7087       .
     7088       do
     7089       on stop undo, leave
     7090       on error undo, leave
     7091       :
     7092         assign
     7093           l-disable-where-54 =
     7094             ("     buf_fin-liab.host-code = par-host-code  and    ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))    " + " " + where-phrase-54 = "")
     7095         .
     7096         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7097                             ,input query br-docs:handle
     7098                             ,input parameter-3-54
     7099                             ,input parameter-4-54
     7100                             ,input parameter-5-54
     7101                             ,input parameter-6-54
     7102                             ,input parameter-7-54
     7103                             )
     7104         .
     7105         assign
     7106           l-filter-open-54 = true
     7107         .
     7108       end.
     7109       if l-filter-open-54 = false then do:
     7110         message
     7111           "Ошибка при фильтрации / сортировке" skip
     7112           "Будут показаны записи без учета фильтра" skip
     7113           view-as alert-box .
     7114       end.
     7115       else do:
     7116           assign
     7117             l-query-was-opened = true
     7118           .
     7119       end.
     7120     end.
     7121     if l-filter-open-54 = false then do:
     7122       OPEN QUERY br-docs FOR EACH buf_fin-liab no-lock
     7123         where      buf_fin-liab.host-code = par-host-code  and    ( r-1 = 1  or ( buf_fin-liab.receiver-code = hard-flt-cli-code and buf_fin-liab.receiver-type = hard-flt-cli-type )) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))
     7124       , FIRST xx-contract where ( r-2 = 1  or ( buf_fin-liab.contract-code = xx-contract.contract-code ))
     7125     .
     7126         assign
     7127           l-query-was-opened = true
     7128         .
     7129     end.
     7130   end.
     7131   else do:
     7132     assign
     7133       doc-rec = recid( buf_fin-liab )
     7134     .
     7135     do
     7136     on stop undo, leave
     7137     on error undo, leave
     7138     :
     7139       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-liab:handle) then do:
     7140         assign
     7141         parameter-2-54 = (if p-find-next then "true":u else "false":u )
     7142         parameter-4-54 =
     7143           "where ":u +           substitute('           buf_fin-liab.host-code = &2  and           ( &3 = 1 or ( buf_fin-liab.receiver-code = &4 and buf_fin-liab.receiver-type = &1&5&1 )) and          ( &6 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &7 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ' , chr(34) , par-host-code , r-1 , hard-flt-cli-code , hard-flt-cli-type , r-31 ,r-32) +          substitute('           ( &2 = 1  or ( &3 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &4 )) and          ( &5 = 1  or ( &6 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &7 ))           ' , chr(34) , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1 , v-date-pay-2 )           + " ":u + where-phrase-54 + " ":u + p-find-condition + " " + ""
     7144         parameter-5-54 = " "
     7145       .
     7146         run fltopend_fltfindd in this-procedure  (
     7147                             input this-procedure:handle
     7148                             ,input query br-docs:handle
