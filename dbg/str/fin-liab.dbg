      160   procedure cur-time :
      161      define output parameter p-today as date      no-undo .
      162      define output parameter p-time  as integer   no-undo .
      163     do
      164     on error undo, return error
      165     :
      166       define variable v-date1 as date      no-undo .
      167       define variable v-date2 as date      no-undo .
      168       define variable v-time  as integer   no-undo .
      169       assign
      170         v-date1 = today
      171         v-time  = time
      172         v-date2 = today
      173       .
      174       if v-date1 <> v-date2
      175       then do:
      176         assign
      177           v-date1 = today
      178           v-time  = v-time
      179         .
      180       end.
      181       assign
      182         p-today = v-date1
      183         p-time  = v-time
      184       .
      185     end.
      186   end.
      187   function cur-time-date returns character
      188   :
      189     return string(today, '99/99/9999':U) .
      190   end.
      191   function cur-time-mjd returns decimal
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     run cur-time in this-procedure
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return integer(v-date) - 2400002 + (v-time / 86400) .
      200   end.
      201   function cur-time-get-ending-index returns integer
      202   (input p-number as integer
      203   )
      204   :
      205     if p-number < 0
      206     or p-number = ?
      207     then do:
      208       return 1 .
      209     end.
      210     define variable v-rest as integer   no-undo .
      211     assign
      212       p-number = p-number modulo 100
      213     .
      214     if p-number < 20
      215     then do:
      216       assign
      217         v-rest = p-number
      218       .
      219     end.
      220     else do:
      221       assign
      222         v-rest = p-number modulo 10
      223       .
      224     end.
      225     case v-rest :
      226       when 1
      227       then do:
      228         return 2 .
      229       end.
      230       when 2 or
      231       when 3 or
      232       when 4
      233       then do:
      234         return 3 .
      235       end.
      236       otherwise do:
      237         return 1 .
      238       end.
      239     end case .
      240   end.
      241   procedure cur-time-mjd-to-date :
      242      define input  parameter i-mjd-diff as decimal no-undo.
      243      define output parameter o-Date     as date    no-undo.
      244      define output parameter o-Time     as integer no-undo.
      245      define variable v-day-number as integer   no-undo .
      246      if    i-mjd-diff < 0
      247         or i-mjd-diff = ?
      248      then do:
      249         return "?" .
      250      end.
      251      assign
      252         v-day-number = truncate(i-mjd-diff,0).
      253         o-Date = date(v-day-number + 2400002).
      254         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      255     .
      256   end.
      257   function cur-time-mjd-to-string returns character
      258   (input p-mjd-diff as decimal
      259   )
      260   :
      261     define variable v-day-number as integer   no-undo .
      262     define variable v-seconds    as integer   no-undo .
      263     define variable v-hour       as integer   no-undo .
      264     define variable v-min        as integer   no-undo .
      265     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      266     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      267     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      268     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      269     if p-mjd-diff < 0
      270     or p-mjd-diff = ?
      271     then do:
      272       return "?" .
      273     end.
      274     assign
      275       v-day-number = integer(truncate(p-mjd-diff,0))
      276       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      277     .
      278     if v-seconds > 86400
      279     then do:
      280       assign
      281         v-seconds = 86400 - 1
      282       .
      283     end.
      284     if v-seconds < 0
      285     then do:
      286       assign
      287         v-seconds = 0
      288       .
      289     end.
      290     assign
      291       v-hour = truncate(v-seconds / 3600, 0)
      292     .
      293     assign
      294       v-seconds = v-seconds modulo 3600
      295     .
      296     assign
      297       v-min = truncate(v-seconds / 60, 0)
      298     .
      299     assign
      300       v-seconds = v-seconds modulo 60
      301     .
      302     return
      303         (if v-day-number <> 0
      304           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      305           else ""
      306         )
      307       + (if v-day-number <> 0 or v-hour <> 0
      308           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      309           else ""
      310         )
      311       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      312           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      313           else ""
      314         )
      315       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      316       .
      317   end.
      318   function cur-time-string returns character
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      327   end.
      328   function cur-time-string-sec returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      337   end.
      338   function cur-time-custom  returns character
      339   (input p-prefix as character
      340   ,input p-date-format as character
      341   ,input p-delimiter as character
      342   ,input p-time-format as character
      343   ,input p-suffix as character
      344   )
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return
      353       p-prefix
      354       + string(v-date, p-date-format)
      355       + p-delimiter
      356       + string(v-time, p-time-format)
      357       + p-suffix
      358       .
      359   end.
      360   function cur-time-print  returns character
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      369   end.
      370   function cur-time-datetime returns datetime
      371   :
      372     define variable v-char as character no-undo .
      373     define variable v-datetime as datetime no-undo .
      374     v-char = cur-time-string().
      375     v-datetime = datetime(v-char).
      376     return  v-datetime.
      377   end.
      378   function cur-time-string-msec returns character
      379   :
      380     define variable v-date as datetime  no-undo .
      381     v-date = now.
      382     return string(v-date) .
      383   end.
      384   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
