     1591   procedure uf-get :
     1592     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1593     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1594     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1595     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1596     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1597     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1598     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1599     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1600     do
     1601     on error undo, return error
     1602     :
     1603       define buffer buf_usr-flt for ubflt.usr-flt .
     1604       define variable v-use-List_     as logical   no-undo .
     1605       define variable v-type-List_     as character no-undo .
     1606       define variable v-format-List_   as character no-undo .
     1607       define variable v-use-Naim      as logical   no-undo .
     1608       define variable v-type-Naim      as character no-undo .
     1609       define variable v-format-Naim    as character no-undo .
     1610       define variable v-use-print-graft as logical   no-undo .
     1611       define variable v-use-sort-gr     as logical   no-undo .
     1612       define variable v-use-type-price  as logical   no-undo .
     1613       define variable v-use-type-val    as logical   no-undo .
     1614       define variable v-label          as character no-undo .
     1615       define variable v-tooltip        as character no-undo .
     1616       define variable v-user-can-edit  as logical   no-undo .
     1617       define variable v-output-display as logical   no-undo .
     1618       define variable v-other          as character no-undo .
     1619       run uf-name in this-procedure
     1620          (input  entry(1, p-code, chr(4))
     1621         ,output v-use-List_
     1622         ,output v-type-List_
     1623         ,output v-format-List_
     1624         ,output v-use-Naim
     1625         ,output v-type-Naim
     1626         ,output v-format-Naim
     1627         ,output v-use-print-graft
     1628         ,output v-use-sort-gr
     1629         ,output v-use-type-price
     1630         ,output v-use-type-val
     1631         ,output v-label
     1632         ,output v-tooltip
     1633         ,output v-user-can-edit
     1634         ,output v-output-display
     1635         ,output v-other
     1636         ) no-error .
     1637       if error-status :error then do:
     1638         undo, return error return-value .
     1639       end.
     1640       find first buf_usr-flt no-lock where
     1641                  buf_usr-flt.Call-point     = p-code AND
     1642                  buf_usr-flt.user-name       = p-user-name
     1643         no-error .
     1644       if avail buf_usr-flt then do:
     1645         assign
     1646         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1647         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1648         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1649         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1650         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1651         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1652         .
     1653       end.
     1654       else do:
     1655         assign
     1656         p-List_        = (if v-use-List_       then "":U                    else ?)
     1657         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1658         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1659         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1660         p-type-price   = (if v-use-type-price  then no                      else ?)
     1661         p-type-val     = (if v-use-List_       then no                      else ?)
     1662         .
     1663       end.
     1664     end.
     1665   end procedure.
     1666   procedure uf-set :
     1667     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1668     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1669     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1670     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1671     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1672     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1673     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1674     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1675     do
     1676     on error undo, return error
     1677     :
     1678       define buffer buf_usr-flt for ubflt.usr-flt .
     1679       define variable v-use-List_     as logical   no-undo .
     1680       define variable v-type-List_     as character no-undo .
     1681       define variable v-format-List_   as character no-undo .
     1682       define variable v-use-Naim      as logical   no-undo .
     1683       define variable v-type-Naim      as character no-undo .
     1684       define variable v-format-Naim    as character no-undo .
     1685       define variable v-use-print-graft as logical   no-undo .
     1686       define variable v-use-sort-gr   as logical   no-undo .
     1687       define variable v-use-type-price as logical   no-undo .
     1688       define variable v-use-type-val  as logical   no-undo .
     1689       define variable v-tooltip        as character no-undo .
     1690       define variable v-label          as character no-undo .
     1691       define variable v-user-can-edit  as logical   no-undo .
     1692       define variable v-output-display as logical   no-undo .
     1693       define variable v-other          as character no-undo .
     1694       run uf-name in this-procedure
     1695         (input  entry(1, p-code, chr(4))
     1696         ,output v-use-List_
     1697         ,output v-type-List_
     1698         ,output v-format-List_
     1699         ,output v-use-Naim
     1700         ,output v-type-Naim
     1701         ,output v-format-Naim
     1702         ,output v-use-print-graft
     1703         ,output v-use-sort-gr
     1704         ,output v-use-type-price
     1705         ,output v-use-type-val
     1706         ,output v-label
     1707         ,output v-tooltip
     1708         ,output v-user-can-edit
     1709         ,output v-output-display
     1710         ,output v-other
     1711         ) no-error .
     1712       if error-status :error then do:
     1713         undo, return error return-value .
     1714       end.
     1715       find first buf_usr-flt where
     1716                  buf_usr-flt.Call-point     = p-code AND
     1717                  buf_usr-flt.user-name       = p-user-name
     1718         no-error .
     1719       if not avail buf_usr-flt then do:
     1720           create buf_usr-flt .
     1721           assign
     1722           buf_usr-flt.call-point = p-code
     1723           buf_usr-flt.user-name  = p-user-name
     1724           .
     1725       end.
     1726       if avail buf_usr-flt then do:
     1727        assign
     1728        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1729        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1730        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1731        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1732        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1733        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1734       .
     1735       release buf_usr-flt.
     1736       end.
     1737       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1738     end.
     1739   end procedure.
