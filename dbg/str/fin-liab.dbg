     8109   PROCEDURE proc-close :
     8110   define variable rr as recid no-undo .
     8111   define variable ii as integer no-undo .
     8112   define variable g-ok as logical no-undo .
     8113   define variable v-recid  as recid no-undo .
     8114   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8115   do:
     8116     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8117       (input  v-cntxt-db-num
     8118       ,input  v-cntxt-userid
     8119       ,input  0
     8120       ,input  'actn_fin-liability_close-fact':U
     8121       ,input  'firm':U
     8122       ,input  par-host-code
     8123       ,input  '':U
     8124       ,input  0
     8125       ,input  0
     8126       ,input  0
     8127       ,input  0
     8128       ,input  true
     8129       ,output g-log
     8130       )  .
     8131   end.
     8132   if not g-log then  return .
     8133     if t-paket then do:
     8134       define variable v-4 as integer   no-undo .
     8135       v-4 = num-entries(rid-list) .
     8136       repeat ii = 1 to v-4 :
     8137         v-recid = integer(entry(ii, rid-list)).
     8138         run proc-close-one-fin-ob in this-procedure ( input v-recid ) .
     8139       end.
     8140     end.
     8141     else do:
     8142       find current   buf_fin-liab no-lock no-error .
     8143       v-recid = recid( buf_fin-liab ).
     8144       run proc-close-one-fin-ob in this-procedure ( input v-recid ) .
     8145     end.
     8146     run OpenBr in this-procedure (yes, no, '':U) .
     8147     reposition br-docs  TO RECID v-recid NO-ERROR .
     8148     if error-status :error then  reposition br-docs  TO row 1 NO-ERROR .
     8149     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     8150   END PROCEDURE.
     8151   PROCEDURE proc-open :
     8152   define variable rr as recid no-undo .
     8153   define variable ii as integer no-undo .
     8154   define variable v-recid  as recid no-undo .
