     3603   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3604   define buffer buf_file for ub.fin-ob .
     3605   procedure current-db :
     3606    do
     3607    on error undo, return error return-value
     3608    :
     3609   define input parameter  p-host-code as integer no-undo .
     3610   define input parameter  c-host-code as integer no-undo .
     3611   define output parameter ret         as logical no-undo .
     3612   define buffer current_sysconf for ub.sysconf.
     3613   define variable v-current-db as integer no-undo .
     3614   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     3615   if error-status :error then return error .
     3616      v-current-db = current_sysconf.firm-db-num .
     3617      ret = true .
     3618   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     3619   if not( ub.sysconf.firm-db-num = v-current-db or
     3620           ub.sysconf.firm-db-num = 0 )
     3621     then do:
     3622     ret = false .
     3623     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     3624     return .
     3625   end.
     3626    end.
     3627   end procedure.
     3628   procedure ver-db :
     3629    do
     3630    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3631    :
     3632   define input parameter  c-host-code as integer no-undo .
     3633   define input parameter  par-ver-db  as integer no-undo .
     3634   define input parameter  p-mess as logical no-undo .
     3635   define output parameter ret         as logical no-undo .
     3636   define buffer current_sysconf for ub.sysconf.
     3637   define variable v-current-db as integer no-undo .
     3638   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     3639   if error-status :error then return error .
     3640      v-current-db = current_sysconf.firm-db-num .
     3641      ret = true .
     3642   if not( par-ver-db = v-current-db or
     3643           par-ver-db = 0 )
     3644     then do:
     3645     ret = false .
     3646     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     3647     return .
     3648   end.
     3649    end.
     3650   end procedure.
     3651   procedure fin-ob-code :
     3652    do
     3653    on error undo, return error return-value
     3654    :
     3655     define input  parameter p-db-num as integer no-undo .
     3656     define output parameter p-fin-ob-code  as character no-undo .
     3657     if p-db-num = 0 then
     3658         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
     3659         else
     3660         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
     3661    end.
     3662   end procedure.
