     3375   ON VALUE-CHANGED OF R-1 IN FRAME Dialog-Frame
     3376   DO:
     3377          hard-flt-cli-code = ?.
     3378          hard-flt-cli-type = ?.
     3379          s-name = "" .
     3380     assign r-1 .
     3381     if r-1 = 1 then
     3382        hide s-name in frame Dialog-Frame .
     3383     else do :
     3384     def buffer b#clients for ub.clients.
     3385          run ref/cli-all.w ( parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
     3386              find first b#clients where recid(b#clients) = integer(rid-list) no-lock no-error.
     3387      if available  b#clients then do:
     3388          hard-flt-cli-code = b#clients.obj-code.
     3389          hard-flt-cli-type = b#clients.obj-type.
     3390          s-name = b#clients.obj-name.
     3391      end.
     3392      else do:
     3393        r-1 = 1.
     3394      end.
     3395      display  r-1 s-name with frame Dialog-Frame .
     3396     end.
     3397   END.
     3398   ON VALUE-CHANGED OF R-2 IN FRAME Dialog-Frame
     3399   DO:
     3400   define buffer buf_contract for ub.contract  .
     3401   define variable ii as integer   no-undo .
     3402   define variable v-tt as character no-undo .
     3403   define variable p-rid-list as character no-undo .
     3404   define variable v-cli-type as character no-undo .
     3405   define variable v-cli-code as integer   no-undo .
     3406   assign r-2 .
     3407   for each x-contract : delete x-contract . end.
     3408     if r-2 = 1 then do:
     3409        hide s-tt in frame Dialog-Frame .
     3410         FIND FIRST buf_contract no-lock  no-error .
     3411         if available buf_contract then do:
     3412                 CREATE x-contract.
     3413                 BUFFER-COPY buf_contract TO x-contract  .
     3414         end.
     3415         else  do:
     3416           CREATE x-contract.
     3417           assign
     3418             x-contract.contract-code = 1
     3419             x-contract.host-code = 1
     3420           .
     3421         end.
     3422     end.
     3423     else do:
     3424         if r-1 = 2 then do:
     3425           assign
     3426             v-cli-type = hard-flt-cli-type
     3427             v-cli-code = hard-flt-cli-code
     3428           .
     3429         end.
     3430         else do:
     3431           assign
     3432             v-cli-type = ?
     3433             v-cli-code = ?
     3434             .
     3435         end.
     3436         run str/cont-all.w
     3437         (   input   parParentProc   ,
     3438             input   par-host-code   ,
     3439             input   "b-sel,b-mark"  ,
     3440             input   'фирма':U      ,
     3441             input   v-cli-type      ,
     3442             input   v-cli-code      ,
     3443             input   ?               ,
     3444             input   ?               ,
     3445             input   "current"       ,
     3446             input  ( if p-doc-type = 'при':U then 'рас':U else 'при':U ) ,
     3447             input-output p-rid-list )
     3448             .
     3449             if p-rid-list = "" then do:
     3450               CREATE x-contract.
     3451               assign
     3452                 x-contract.contract-code = 1
     3453                 x-contract.host-code = 1
     3454               .
     3455               r-2 = 1.
     3456             end.
     3457             v-tt =  "".
     3458             define variable v-3 as integer   no-undo .
     3459             v-3 = num-entries (p-rid-list) .
     3460             repeat ii = 1 to v-3 :
     3461               find first buf_contract no-lock where recid(buf_contract) =  integer( entry(ii, p-rid-list)) no-error .
     3462               if available buf_contract then do:
     3463                     CREATE x-contract.
     3464                     BUFFER-COPY buf_contract TO x-contract  .
     3465                     v-tt = v-tt + buf_contract.contract-prn-code + "(" + string (buf_contract.contract-code) + "),".
     3466               end.
     3467             end.
     3468           s-tt:LIST-ITEMS  = trim (v-tt, ",") .
     3469           display s-tt r-2 with frame Dialog-Frame .
     3470           enable s-tt with frame Dialog-Frame .
     3471     end.
     3472   END.
     3473   ON VALUE-CHANGED OF R-3 IN FRAME Dialog-Frame
     3474   DO:
     3475     ASSIGN r-3 .
     3476   END.
     3477   ON RETURN OF sch-code IN FRAME Dialog-Frame
