     1750   define temp-table userhsts_temp-user-host no-undo
     1751     field host-code as integer
     1752     index xpk is primary unique host-code
     1753     .
     1754   procedure userhsts_clear :
     1755     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       for each buf_userhsts_temp-user-host
     1760       on error undo, return error return-value
     1761       :
     1762         delete buf_userhsts_temp-user-host .
     1763       end.
     1764     end.
     1765   end procedure.
     1766   procedure userhsts_object-count :
     1767     define output parameter p-total-count as integer   no-undo .
     1768     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     1769     do
     1770     on error undo, return error return-value
     1771     :
     1772       assign
     1773         p-total-count = 0
     1774       .
     1775       for each buf_userhsts_temp-user-host
     1776       on error undo, return error return-value
     1777       :
     1778         assign
     1779           p-total-count = p-total-count + 1
     1780         .
     1781       end.
     1782     end.
     1783   end procedure.
     1784   procedure userhsts_append :
     1785     define input  parameter p-host-code as integer   no-undo .
     1786     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     1787     do
     1788     on error undo, return error return-value
     1789     :
     1790       find first buf_userhsts_temp-user-host
     1791         where buf_userhsts_temp-user-host.host-code = p-host-code
     1792         no-error .
     1793       if not available buf_userhsts_temp-user-host
     1794       then do:
     1795         create buf_userhsts_temp-user-host .
     1796         assign
     1797           buf_userhsts_temp-user-host.host-code = p-host-code
     1798         .
     1799       end.
     1800     end.
     1801   end procedure.
     1802   procedure userhsts_object-exist :
     1803     define output parameter p-object-exist as logical   no-undo .
     1804     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     1805     do
     1806     on error undo, return error return-value
     1807     :
     1808       find first buf_userhsts_temp-user-host
     1809         no-error .
     1810       if not available buf_userhsts_temp-user-host
     1811       then do:
     1812         assign
     1813           p-object-exist = false
     1814         .
     1815       end.
     1816       else do:
     1817         assign
     1818           p-object-exist = true
     1819         .
     1820       end.
     1821     end.
     1822   end procedure.
     1823   procedure userhsts_transfer :
     1824     define input  parameter p-callback-handle as handle no-undo .
     1825     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
     1826     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       if valid-handle(p-callback-handle) <> true
     1831       then do:
     1832         message
     1833           vss-workfile vss-revision vss-description skip
     1834           "Ошибка задания входных параметров" skip
     1835           "Неизвестный указатель на процедуру" skip
     1836           view-as alert-box error .
     1837         undo, return error return-value .
     1838       end.
     1839       if p-callback-handle :get-signature("userhsts_append") = ""
     1840       then do:
     1841         message
     1842           vss-workfile vss-revision vss-description skip
     1843           "Ошибка задания входных параметров" skip
     1844           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
     1845                     ,p-callback-handle :file-name
     1846                     ) skip
     1847           view-as alert-box error .
     1848         undo, return error return-value .
     1849       end.
     1850       for each buf_userhsts_temp-user-host
     1851       on error undo, return error return-value
     1852       :
     1853         run userhsts_append in p-callback-handle
     1854           (input  buf_userhsts_temp-user-host.host-code
     1855           ) .
     1856       end.
     1857     end.
     1858   end procedure.
