     2745        T-paket AT ROW 21.08 COL 73.75
     2746        FILL-IN-20 AT ROW 3 COL 1 NO-LABEL
     2747        FILL-IN-21 AT ROW 3 COL 13.5 NO-LABEL
     2748        FILL-IN-22 AT ROW 3 COL 44.5 NO-LABEL
     2749        FILL-IN-24 AT ROW 3 COL 58.75 NO-LABEL
     2750        FILL-IN-26 AT ROW 3 COL 72 NO-LABEL
     2751        s-name AT ROW 5.25 COL 1 NO-LABEL
     2752        FILL-IN-1 AT ROW 6.75 COL 1.5 NO-LABEL
     2753        loc_receiver-name AT ROW 20.25 COL 1.5
     2754        loc_sum-doc AT ROW 20.25 COL 44.5 COLON-ALIGNED
     2755        d-abbr AT ROW 20.25 COL 62.88 COLON-ALIGNED NO-LABEL
     2756        loc_user-name AT ROW 20.25 COL 79.13 COLON-ALIGNED
     2757        loc_payer-name AT ROW 21.08 COL 1.5
     2758        loc_sum-rubl AT ROW 21.08 COL 44.5 COLON-ALIGNED
     2759        r-abbr AT ROW 21.08 COL 62.88 COLON-ALIGNED NO-LABEL
     2760        loc_sum-base AT ROW 21.92 COL 44.5 COLON-ALIGNED
     2761        v-abbr AT ROW 21.92 COL 62.88 COLON-ALIGNED NO-LABEL
     2762        mark-num AT ROW 22.5 COL 74 NO-LABEL
     2763        loc_sum-contr AT ROW 22.71 COL 44.5 COLON-ALIGNED
     2764        v-abbr-contr AT ROW 22.71 COL 62.88 COLON-ALIGNED NO-LABEL
     2765        RECT-1 AT ROW 3 COL 1
     2766        SPACE(1.63) SKIP(17.08)
     2767       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2768            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2769            TITLE "Финансовые обязательства"
     2770            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
     2771   ASSIGN
     2772          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2773          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2774   ASSIGN
     2775          b-fact:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-fact:HANDLE.
     2776   ASSIGN
     2777          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-print:HANDLE.
     2778   ASSIGN
     2779          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     2780   ASSIGN
     2781          mark-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2782   ASSIGN
     2783          S-tt:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2784   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2785   DO:
     2786     APPLY "END-ERROR":U TO SELF.
     2787   END.
     2788   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2789   DO:
     2790     define variable g-log as logical no-undo .
     2791   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2792   do:
     2793     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2794       (input  v-cntxt-db-num
     2795       ,input  v-cntxt-userid
     2796       ,input  0
     2797       ,input  'actn_fin-liability_add-def':U
     2798       ,input  'firm':U
     2799       ,input  par-host-code
     2800       ,input  '':U
     2801       ,input  0
     2802       ,input  0
     2803       ,input  0
     2804       ,input  0
     2805       ,input  true
     2806       ,output g-log
     2807       )  .
     2808   end.
     2809   if not g-log then  return .
     2810     run add-proc in this-procedure .
     2811   END.
     2812   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2813   DO:
     2814   define variable cur-clmn-loc as integer   no-undo .
     2815   define variable column-handle as handle no-undo .
     2816   define variable v-list as character no-undo .
     2817     assign
     2818       cur-clmn-loc  = 1
     2819       column-handle = BR-docs:first-column
     2820       v-list        = column-handle:label + "#"
     2821     .
     2822     do while valid-handle(column-handle) :
     2823       if cur-clmn-loc = BR-docs:num-columns then do:
     2824         leave .
     2825       end.
     2826       assign
     2827         column-handle = column-handle:NEXT-COLUMN
     2828         cur-clmn-loc  = cur-clmn-loc + 1
     2829         v-list        = v-list + column-handle:label + "#"
     2830       .
     2831     end.
     2832      v-list = trim(v-list, "#") .
     2833      define variable v-i as integer   no-undo .
     2834      define variable v-pos as integer   no-undo .
     2835      define variable v-list-new as character no-undo .
     2836      define variable v-elem as character no-undo .
     2837      repeat v-i = 1 to BR-docs:num-columns :
     2838         v-elem = entry( v-i, v-list , "#") .
     2839         v-pos = lookup( v-elem, '*' + '#' +  'Статус' + '#' +  '№ док-та' + '#' +  'Создан' + '#' +  'Закрыт' + '#' +  'Договор' + '#' +  'Получатель' + '#' +  'Плательщик' + '#' +  'Платеж' + '#' +  'Вал' + '#' +  'Сумма в валюте!док-та' + '#' +  'Внутр.№' + '#' +  'Тип' + '#' +  'Непогаш.задолж!(руб.)' + '#' +  'Объект' + '#' +  'Наименование' + '#' +  'Условие генерации' + '#' +  'Счет-фактура' , "#") .
     2840         v-list-new = v-list-new + string(v-pos) + "," .
     2841      end.
     2842      define variable v-list-str as character no-undo .
     2843      define variable v-1 as integer   no-undo .
     2844      v-list-str = "" .
     2845      v-1 = num-entries(v-list-new)  .
     2846      repeat v-i = 1 to v-1 :
     2847         v-elem = entry(v-i , v-list-new ) .
     2848         if int(v-elem) > 3 then
     2849         v-list-str  = v-list-str + v-elem + "," .
     2850      end.
     2851      v-list-new = trim(v-list-str ,",")  +  chr(4)
     2852                 + string(decimal( buf_fin-liab.receiver-name:width in browse BR-docs)) +  chr(4)
     2853                 + string(decimal( p-gen:width                    in browse BR-docs)) +  chr(4)
     2854                 + string(decimal( buf_fin-liab.sum-doc:width     in browse BR-docs)) +  chr(4)
     2855                 + string(decimal( p-contr:width                  in browse BR-docs)) +  chr(4)
     2856                 + string(decimal( buf_fin-liab.status_:width     in browse BR-docs)) +  chr(4)  .
     2857   run uf-set in this-procedure(
     2858       input  'fin-ob-p':U
     2859       ,input v-cntxt-userid
     2860       ,input v-list-new
     2861       ,input v-uf-Naim
     2862       ,input v-uf-print-graft
     2863       ,input v-uf-sort-gr
     2864       ,input v-uf-type-price
     2865       ,input v-uf-type-val
     2866   ) no-error    .
     2867       if error-status :error then
     2868       message
     2869         vss-workfile vss-revision vss-description skip
     2870         error-status :get-message(1) skip
     2871         return-value skip
     2872         "uf-set"
     2873         view-as alert-box error
     2874       .
     2875   END.
     2876   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2877   DO:
     2878   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2879   do:
     2880     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2881       (input  v-cntxt-db-num
     2882       ,input  v-cntxt-userid
     2883       ,input  0
     2884       ,input  'actn_fin-liability_update':U
     2885       ,input  'firm':U
     2886       ,input  par-host-code
     2887       ,input  '':U
     2888       ,input  0
     2889       ,input  0
     2890       ,input  0
     2891       ,input  0
     2892       ,input  true
     2893       ,output g-log
     2894       )  .
     2895   end.
     2896   if not g-log then  return .
     2897   if not available buf_fin-liab then return .
     2898   if  buf_fin-liab.status_ = 'факт':U then do:
     2899       message "Финансовое обязательство в статусе " buf_fin-liab.status_ " изменять нельзя !!!"
     2900       view-as alert-box information .
     2901       return no-apply.
     2902   end.
     2903   define variable rr as recid no-undo .
     2904       if available buf_fin-liab then do:
     2905           rr = recid( buf_fin-liab ).
     2906           p-doc-type = buf_fin-liab.doc-type .
     2907           p-status_  = buf_fin-liab.status_  .
     2908           run str/fi-liabi.w
     2909              (input parParentProc ,
     2910               input 'ИЗМЕНЕНИЕ':U ,
     2911               input-output rr ,
     2912               input par-host-code  ,
     2913               input p-doc-type,
     2914               input p-status_
     2915               ).
     2916           g-log =  BR-docs:refresh() .
     2917           apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     2918       end.
     2919   END.
     2920   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     2921   DO:
     2922     run proc-close in this-procedure no-error.
     2923     if error-status:error then return no-apply.
     2924   END.
     2925   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2926   DO:
     2927   if not available buf_fin-liab then return .
     2928   define buffer buf_del-fin-ob for ub.fin-ob .
     2929   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2930   do:
     2931     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2932       (input  v-cntxt-db-num
     2933       ,input  v-cntxt-userid
     2934       ,input  0
     2935       ,input  'actn_fin-liability_deletion':U
     2936       ,input  'firm':U
     2937       ,input  par-host-code
     2938       ,input  '':U
     2939       ,input  0
     2940       ,input  0
     2941       ,input  0
     2942       ,input  0
     2943       ,input  true
     2944       ,output g-log
     2945       )  .
     2946   end.
     2947   if not g-log then  return .
     2948     else do:
     2949         message "Удалить запись ?"
     2950         view-as alert-box question
     2951         buttons yes-no
     2952         update g-log.
     2953         if g-log = false then return no-apply.
     2954     end.
     2955     define variable v-recid as integer no-undo .
     2956     define variable ii as integer no-undo .
     2957     assign
     2958     t-paket
     2959     .
     2960     if t-paket then do:
     2961       define variable rr as integer init 0 no-undo .
     2962       define variable v-2 as integer   no-undo .
     2963       v-2 = num-entries (rid-list) .
     2964       repeat ii = 1 to v-2 :
     2965          v-recid = integer(entry(ii, rid-list)).
     2966          find first buf_del-fin-ob no-lock where recid(buf_del-fin-ob) = v-recid no-error .
     2967           if error-status :error then next.
     2968           if  buf_del-fin-ob.status_ = 'факт':U then next.
     2969           find first buf_del-fin-ob  exclusive-lock   where recid(buf_del-fin-ob) = v-recid no-error .
     2970           if available buf_del-fin-ob then do:
