     8191   PROCEDURE proc-open-one :
     8192   define input parameter p-recid  as recid no-undo .
     8193   find first  buf_fin-liab exclusive-lock  where recid(buf_fin-liab) = p-recid  no-error .
     8194   if available buf_fin-liab then do:
     8195       if buf_fin-liab.status_ = 'новый':U then do:
     8196         message "Финансовое обязательство " buf_fin-liab.prn-doc-code " находится в статусе НОВЫЙ".
     8197         return.
     8198       end.
     8199      buf_fin-liab.status_ = 'новый':U .
     8200   end.
     8201   END PROCEDURE.
