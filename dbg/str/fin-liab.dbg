     7640           (
     7641             if (" buf_fin-liab.host-code = par-host-code  and buf_fin-liab.contract-code = integer(p-char) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))    " + " " + where-phrase-60) <> ""
     7642             then           substitute('           buf_fin-liab.host-code = &2  and           ( &3 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &4 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ( &5 = 1 or ( &6 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &7 )) and          ( &8 = 1 or ( &9 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &1 )) and          ' , v-date-pay-2 , par-host-code , r-31 , r-32  , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1  ) +          substitute(' buf_fin-liab.contract-code = integer(&1)  ' , p-char)    + " " + where-phrase-60
     7643             else "true"
     7644           )
     7645         parameter-5-60 = (" " + "" + " " + substitute(' , FIRST xx-contract ' ))
     7646         parameter-6-60 = if sort-phrase-60 = ''
     7647                              then
     7648           (
     7649           " " + "  " +
     7650             " " + sort-column-phrase +
     7651           " " + "  "
     7652           )
     7653                              else
     7654           (
     7655           " " + "  " +
     7656             " " + sort-column-phrase +
     7657           " " + sort-phrase-60
     7658           )
     7659         parameter-7-60 =
     7660           "   "
     7661       .
     7662       do
     7663       on stop undo, leave
     7664       on error undo, leave
     7665       :
     7666         assign
     7667           l-disable-where-60 =
     7668             (" buf_fin-liab.host-code = par-host-code  and buf_fin-liab.contract-code = integer(p-char) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))    " + " " + where-phrase-60 = "")
     7669         .
     7670         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7671                             ,input query br-docs:handle
     7672                             ,input parameter-3-60
     7673                             ,input parameter-4-60
     7674                             ,input parameter-5-60
     7675                             ,input parameter-6-60
     7676                             ,input parameter-7-60
     7677                             )
     7678         .
     7679         assign
     7680           l-filter-open-60 = true
     7681         .
     7682       end.
     7683       if l-filter-open-60 = false then do:
     7684         message
     7685           "Ошибка при фильтрации / сортировке" skip
     7686           "Будут показаны записи без учета фильтра" skip
     7687           view-as alert-box .
     7688       end.
     7689       else do:
     7690           assign
     7691             l-query-was-opened = true
     7692           .
     7693       end.
     7694     end.
     7695     if l-filter-open-60 = false then do:
     7696       OPEN QUERY br-docs FOR EACH buf_fin-liab no-lock
     7697         where  buf_fin-liab.host-code = par-host-code  and buf_fin-liab.contract-code = integer(p-char) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))
     7698       , FIRST xx-contract
     7699     .
     7700         assign
     7701           l-query-was-opened = true
     7702         .
     7703     end.
     7704   end.
     7705   else do:
     7706     assign
     7707       doc-rec = recid( buf_fin-liab )
     7708     .
     7709     do
     7710     on stop undo, leave
     7711     on error undo, leave
     7712     :
     7713       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-liab:handle) then do:
     7714         assign
     7715         parameter-2-60 = (if p-find-next then "true":u else "false":u )
     7716         parameter-4-60 =
     7717           "where ":u +           substitute('           buf_fin-liab.host-code = &2  and           ( &3 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &4 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ( &5 = 1 or ( &6 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &7 )) and          ( &8 = 1 or ( &9 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &1 )) and          ' , v-date-pay-2 , par-host-code , r-31 , r-32  , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1  ) +          substitute(' buf_fin-liab.contract-code = integer(&1)  ' , p-char)    + " ":u + where-phrase-60 + " ":u + p-find-condition + " " + ""
     7718         parameter-5-60 = "  "
     7719       .
     7720         run fltopend_fltfindd in this-procedure  (
     7721                             input this-procedure:handle
     7722                             ,input query br-docs:handle
     7723                             ,input rowid(buf_fin-liab)
     7724                             ,input logical(parameter-2-60)
     7725                             ,input no-lock
     7726                             ,input (buffer buf_fin-liab:handle)
     7727                             ,input parameter-4-60
     7728                             ,input parameter-5-60
     7729                             ) no-error.
     7730         .
     7731         assign
     7732           doc-rec = integer(return-value)
     7733           v-fltopend-rowid[1] = ?
     7734         .
     7735       end.
     7736       else do:
     7737         assign
     7738         parameter-2-60 = (if p-find-next then "true":u else "false":u )
     7739         parameter-3-60 =  "FOR EACH buf_fin-liab"
     7740         parameter-4-60 =
     7741           (
     7742             if (" buf_fin-liab.host-code = par-host-code  and buf_fin-liab.contract-code = integer(p-char) and   ( r-31 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and   ( r-32 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and   ( d-1 = 1  or ( v-date-doc-1 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= v-date-doc-2 )) and   ( d-2 = 1  or ( v-date-pay-1 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= v-date-pay-2 ))    " + " " + where-phrase-60) <> ""
     7743             then           substitute('           buf_fin-liab.host-code = &2  and           ( &3 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl > 0 ))  and          ( &4 = 1 or ( buf_fin-liab.sum-rubl - buf_fin-liab.con-sum-rubl <= 0 )) and          ( &5 = 1 or ( &6 <= buf_fin-liab.doc-date and buf_fin-liab.doc-date <= &7 )) and          ( &8 = 1 or ( &9 <= buf_fin-liab.pay-date and buf_fin-liab.pay-date <= &1 )) and          ' , v-date-pay-2 , par-host-code , r-31 , r-32  , d-1  , v-date-doc-1 , v-date-doc-2 , d-2 , v-date-pay-1  ) +          substitute(' buf_fin-liab.contract-code = integer(&1)  ' , p-char)    + " " + where-phrase-60
     7744             else "true"
     7745           )
     7746         parameter-5-60 = (" " + "" + " " + substitute(' , FIRST xx-contract ' ) + " " + p-find-condition)
     7747         parameter-6-60 = if sort-phrase-60 = ''
     7748                              then
     7749           (
     7750           " " + "  " +
     7751             " " + sort-column-phrase +
     7752           " " + "  "
     7753           )
     7754                              else
     7755           (
     7756           " " + "  " +
     7757             " " + sort-column-phrase +
     7758           " " + sort-phrase-60
     7759           )
     7760         parameter-7-60 =
     7761           "   "
     7762       .
     7763         run fltopend_fltfindq in this-procedure  (
     7764                             input this-procedure:handle
     7765                             ,input query br-docs:handle
     7766                             ,input logical(parameter-2-60)
     7767                             ,input no-lock
     7768                             ,input parameter-3-60
     7769                             ,input parameter-4-60
     7770                             ,input parameter-5-60
     7771                             ,input parameter-6-60
     7772                             ,input parameter-7-60
     7773                             ,output v-fltopend-rowid
     7774                             ) no-error.
     7775         .
     7776         doc-rec = ?.
     7777       end.
     7778       assign
     7779         l-query-was-opened = true
     7780       .
     7781     end.
     7782   end.
     7783     run waitfram-hide in this-procedure .
     7784       END.
     7785   END CASE.
     7786   if not p-open-query then
     7787   reposition br-docs to recid doc-rec no-error.
     7788   if not p-open-query and v-fltopend-rowid[1] <> ? then
     7789   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     7790   END PROCEDURE.
     7791   PROCEDURE print-proc :
     7792   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7793   do:
     7794     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7795       (input  v-cntxt-db-num
     7796       ,input  v-cntxt-userid
     7797       ,input  0
     7798       ,input  'actn_fin-liability_print':U
     7799       ,input  'firm':U
     7800       ,input  par-host-code
     7801       ,input  '':U
     7802       ,input  0
     7803       ,input  0
     7804       ,input  0
     7805       ,input  0
     7806       ,input  true
     7807       ,output g-log
     7808       )  .
     7809   end.
     7810   if not g-log then  return .
     7811   define variable v-kol   as integer   no-undo .
     7812   define variable v-i-sum as decimal   no-undo .
     7813   define variable v-d as decimal   no-undo .
     7814   v-kol   = 0 .
     7815   v-i-sum = 0 .
     7816   v-d = 0 .
     7817    EMPTY TEMP-TABLE tt-val .
     7818   define variable sym1  as char format "X(1)" init ":".
     7819   define variable sym2  as char format "X(1)" init ":".
     7820   define variable sym3  as char format "X(1)" init ":".
     7821   define variable sym4  as char format "X(1)" init ":".
     7822   define variable sym5  as char format "X(1)" init ":".
     7823   define variable sym6  as char format "X(1)" init ":".
     7824   define variable sym7  as char format "X(1)" init ":".
     7825   define variable sym8  as char format "X(1)" init ":".
     7826   define variable sym9  as char format "X(1)" init ":".
     7827   define variable sym10 as char format "X(1)" init ":".
     7828   define variable sym11 as char format "X(1)" init ":".
     7829   define variable sym12 as char format "X(1)" init ":".
     7830   define variable date_string     as      char    no-undo.
     7831   define variable Line                as      char    no-undo.
     7832   define variable for-time as char.
     7833   define variable vv-val as character no-undo .
     7834   define variable v-i as integer   no-undo .
     7835   define variable p-delta as decimal format "->,>>>,>>>,>>>,>>9.99"  no-undo .
     7836   DEFINE FRAME prt-frame
     7837        buf_fin-liab.status_    COLUMN-LABEL 'Статус'        Format "x(6)"
     7838        buf_fin-liab.prn-doc-code    COLUMN-LABEL '№ док-та'        Format "x(10)"
     7839        buf_fin-liab.doc-date    COLUMN-LABEL 'Создан'      format "99/99/99"
     7840        buf_fin-liab.fact-date    COLUMN-LABEL 'Закрыт'        format "99/99/99"
     7841        p-contr   COLUMN-LABEL 'Договор'           Format "x(16)"
     7842        buf_fin-liab.receiver-name    COLUMN-LABEL 'Получатель'      Format "x(10)"
     7843        buf_fin-liab.payer-name    COLUMN-LABEL 'Плательщик'      Format "x(10)"
     7844        buf_fin-liab.pay-date   COLUMN-LABEL 'Платеж'         format "99/99/99"
     7845        l-curr COLUMN-LABEL 'Вал'              Format "x(3)"
     7846        buf_fin-liab.sum-doc   COLUMN-LABEL "Сумма в вал.док"
     7847        p-delta   COLUMN-LABEL "Задолженность в вал.док"   format "->,>>>,>>>,>>>,>>9.99"
     7848        p-gen   COLUMN-LABEL 'Условие генерации'           Format "x(25)"
     7849           HEADER  date_string AT 5 format "X(35)"
     7850                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     7851                       Line format "X(157)" AT 1
     7852       with width 232 down stream-io use-text    .
     7853       Line = fill("-", 157).
     7854       date_string = cur-time-print() .
     7855       run prn-lib-open-stream in this-procedure
     7856       (  input parParentProc
     7857         ,input 43
     7858         ,input yes
     7859         ,input no
     7860         ).
     7861       PUT  STREAM PrnLibStream
     7862       SPACE(25) ( frame Dialog-Frame:title )
     7863       format "x(157)" SKIP(1) .
     7864       FORM HEADER
     7865               Line format "X(177)" AT 1 SKIP
     7866               "Продолжение - на следующей странице" AT 30 SKIP
     7867               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     7868       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     7869       FORM with FRAME prt-frame  .
     7870       run waitfram-show in this-procedure ("Ждите печатаю...").
     7871       run OpenBR in this-procedure (yes, no, '':U).
     7872        DO WHILE available buf_fin-liab :
     7873          v-kol    = v-kol   + 1 .
     7874          v-i-sum = v-i-sum + buf_fin-liab.sum-doc .
     7875          v-d =  (buf_fin-liab.sum-DOC - buf_fin-liab.con-sum-DOC) .
     7876          vv-val = val-abbr-type(recid( buf_fin-liab)) .
     7877          find first tt-val where
     7878                     tt-val.val = vv-val no-error .
     7879           if not available tt-val then create tt-val.
     7880               assign
     7881                 tt-val.val = vv-val
     7882                 tt-val.s1  = tt-val.s1  + buf_fin-liab.sum-doc
     7883                 tt-val.s2  = tt-val.s2  + (buf_fin-liab.sum-DOC - buf_fin-liab.con-sum-DOC)
     7884                 tt-val.kol = tt-val.kol + 1
     7885               .
     7886           Display STREAM PrnLibStream
     7887                 buf_fin-liab.status_
     7888                 buf_fin-liab.prn-doc-code
     7889                 buf_fin-liab.doc-date
     7890                 buf_fin-liab.fact-date
     7891                 contract-id(recid( buf_fin-liab))   @ p-contr
     7892                 buf_fin-liab.receiver-name
     7893                 buf_fin-liab.payer-name
     7894                 buf_fin-liab.pay-date
     7895                 val-abbr-type(recid( buf_fin-liab))  @ l-curr
     7896                 buf_fin-liab.sum-doc
     7897                 v-d @ p-delta
     7898                 contract-gen(recid(buf_fin-liab)) @ p-gen
     7899               with FRAME prt-frame .
     7900               DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     7901               GET next br-docs.
     7902         END.
     7903         UNDERLINE  STREAM PrnLibStream
     7904           buf_fin-liab.status_
     7905           buf_fin-liab.prn-doc-code
     7906           buf_fin-liab.doc-date
     7907           buf_fin-liab.fact-date
     7908           p-contr
     7909           buf_fin-liab.receiver-name
     7910           buf_fin-liab.payer-name
     7911           buf_fin-liab.pay-date
     7912           l-curr
     7913           buf_fin-liab.sum-doc
     7914           p-delta
     7915           p-gen
     7916       with FRAME prt-frame .
     7917       v-i = 0 .
     7918       for each tt-val :
     7919           v-i = v-i + 1.
     7920       end.
     7921       if v-i > 1 then do:
     7922           Display STREAM PrnLibStream
     7923           "Итого"    @  buf_fin-liab.status_
     7924           "док.шт."  @  buf_fin-liab.prn-doc-code
     7925            v-kol     @  buf_fin-liab.doc-date
     7926           with FRAME prt-frame .
     7927       end.
     7928           DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     7929           for each tt-val :
     7930               Display STREAM PrnLibStream
     7931               "Итого "       @ buf_fin-liab.status_
     7932                tt-val.val    @ buf_fin-liab.prn-doc-code
     7933                tt-val.kol     @  buf_fin-liab.doc-date
     7934                   tt-val.s1  @ buf_fin-liab.sum-doc
     7935                   tt-val.s2  @ p-delta
     7936               with FRAME prt-frame .
     7937           DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     7938           end.
     7939         UNDERLINE  STREAM PrnLibStream
     7940           buf_fin-liab.status_
     7941           buf_fin-liab.prn-doc-code
     7942           buf_fin-liab.doc-date
     7943           buf_fin-liab.fact-date
     7944           p-contr
     7945           buf_fin-liab.receiver-name
     7946           buf_fin-liab.payer-name
     7947           buf_fin-liab.pay-date
     7948           l-curr
     7949           buf_fin-liab.sum-doc
     7950           p-delta
     7951           p-gen
     7952       with FRAME prt-frame .
     7953       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     7954       HIDE  STREAM PrnLibStream FRAME CheckList.
     7955       output  STREAM PrnLibStream CLOSE.
     7956       run waitfram-hide in this-procedure .
     7957       run prn-lib-prn-file in this-procedure (
     7958           input parParentProc
     7959          ,input 8
     7960           ).
     7961   END PROCEDURE.
     7962   PROCEDURE proc-b-exp :
     7963   define variable varxmldocfl      as character no-undo.
     7964   define variable varxmldocfl-type as character no-undo.
     7965   define variable v-file-name as character no-undo .
     7966   define variable for-dir as character no-undo .
     7967   define variable accum-count as integer no-undo init 0.
     7968   define variable accum-count-ok as integer no-undo init 0 .
     7969   define variable loclog as logical no-undo .
     7970   define variable ii as integer no-undo .
     7971   define variable ii0 as integer no-undo .
     7972   define buffer buf_fin-ob for ub.fin-ob.
     7973   if not available buf_fin-liab then do:
     7974     message "Неправильный выбор документа.".
     7975     return no-apply.
     7976   end.
     7977   CASE T-paket:
     7978     when no then do:
     7979       assign
     7980       v-file-name =  ?
     7981       .
     7982       run bge/xmlfo.p ( input buf_fin-liab.host-code, buf_fin-liab.doc-code, input-output v-file-name, yes, yes) no-error .
     7983     end.
     7984     when  yes then do:
     7985       if rid-list = "":U then do:
     7986           message
     7987           "Вы не отметили ни одного ФО"
     7988           view-as alert-box error.
     7989           return error.
     7990       end.
     7991       run gbl/d-file.p
     7992         (input-output v-file-name
     7993         ,input-output for-dir
     7994         ,input  (" Все файлы XML (*.xml) ")
     7995         ,input  ("*.xml":U)
     7996         ,input  chr(44)
     7997         ,input  (".xml":U)
     7998         ,input  no
     7999         ,input  yes
     8000         ,input  yes
     8001         ,input  "Введите имя файла"
     8002         ,output loclog
     8003         ) .
     8004       if not loclog then do:
     8005         return .
     8006       end.
     8007       run waitfram-show in this-procedure ("Ждите...").
     8008       assign
     8009        ii0 = num-entries(rid-list)
     8010       .
     8011       repeat  ii = 1 to ii0 :
     8012         find first buf_fin-ob no-lock where
     8013                   recid(buf_fin-ob) = integer(entry(ii, rid-list)) no-error .
     8014         if available buf_fin-ob then do:
     8015           assign
     8016             accum-count = accum-count + 1
     8017           .
     8018           run bge/xmlfo.p
     8019           (               input buf_fin-ob.host-code
     8020                         , input buf_fin-ob.doc-code
     8021                         , input-output v-file-name
     8022                         , input (accum-count-ok = 0)
     8023                         , input ii = ii0
     8024                         ) no-error .
     8025           if not error-status:error then
     8026           assign
     8027             accum-count-ok = accum-count-ok + 1
     8028           .
     8029         end.
     8030       run waitfram-hide in this-procedure .
     8031     end.
     8032   end.
     8033   END CASE.
     8034   if error-status:error
     8035   or (t-paket and accum-count <> accum-count-ok)
     8036   then do:
     8037     message
     8038     "Ошибка при выгрузке ФО в XML-формате" skip
     8039     string(if t-paket then substitute("Выгружено &1 ФО из &2", accum-count-ok, accum-count) else "":U) skip
     8040     error-status :get-message(1)
     8041     view-as alert-box .
     8042     if not t-paket then
     8043     return error .
     8044   end.
     8045   define variable v-sys-key as character no-undo.
     8046   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     8047   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     8048     (output v-sys-key
     8049     ) no-error .
     8050   if search ("exmldoc.bat") <> ? then do:
     8051     os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     8052   end.
     8053   else do:
     8054     if search (v-file-name ) <> ? then do:
     8055       if accum-count-ok  > 1 then
     8056          message "ФО выгружены в файл " v-file-name view-as alert-box.
     8057       else
     8058         message "ФО выгружен в файл " v-file-name view-as alert-box.
     8059     end.
     8060   end.
     8061   END PROCEDURE.
