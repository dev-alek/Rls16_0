      574     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      575   end procedure.
      576   procedure prn-lib-reportviewer :
      577     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      578     define input parameter p-report-name-html as character no-undo .
      579     define input parameter p-param        as character no-undo .
      580     define variable v-excel           as character no-undo init 'TRUE' .
      581     define variable v-value-character as character no-undo .
      582     define variable v-value-integer   as character no-undo .
      583     define variable v-value-date      as date      no-undo .
      584     define variable v-value-decimal   as decimal   no-undo .
      585     define variable rep-excel         as logical   no-undo .
      586     define variable excel-string      as character no-undo .
      587     define variable v-param-type      as character no-undo .
      588     define variable v-tth             as handle    no-undo .
      589     run adm/shattri.p (
      590       input "get":U
      591       ,input  ""
      592       ,input  0
      593       ,input  'report-glob':U
      594       ,input  'rep-excel':U
      595       ,output v-value-character
      596       ,output v-value-date
      597       ,output v-value-decimal
      598       ,output v-value-integer
      599       ,output rep-excel
      600       ,output v-param-type
      601       ,INPUT-OUTPUT table-handle v-tth
      602       )  .
      603     if rep-excel then v-excel = "TRUE" .
      604     else v-excel = "FALSE" .
      605     if p-param eq ""
      606     then
      607        p-param = "EXCEL:" + v-excel.
      608     else
      609        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      610     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      611   end procedure.
      612   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      613   define variable v-waitfram-action01         as character   no-undo .
      614   define variable v-waitfram-action02         as character   no-undo .
      615   define variable v-waitfram-action03         as character   no-undo .
      616   define variable mWaitFramTextBeg            as character   no-undo.
      617   define variable mWaitFramTextEnd            as character   no-undo.
      618   define variable mWaitFramView               as logical     no-undo.
      619   define variable mWaitProcEvent              as logical     no-undo init yes.
      620   define variable mWaitFramInterval           as integer     no-undo init 1 .
      621   define variable mWaitFramStop               as logical     no-undo.
      622   define variable mWaitFramStopUser           as logical     no-undo.
      623   define variable mWaitFramStopTimeOut        as logical     no-undo.
      624   define variable mWaitFramStartProc          as datetime-tz no-undo.
      625   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      626   define button B-WaitFramStop auto-end-key
      627        label "Стоп"
      628        size 10 by 1 tooltip "Остоновить процесс".
      629   define button B-viewProcInfo
      630        label "Информация"
      631        size 15 by 1 tooltip "Информация о процесс".
      632   define frame waitfram
      633     v-waitfram-action01 format "x(72)" no-label skip
      634     v-waitfram-action02 format "x(72)" no-label skip
      635     v-waitfram-action03 format "x(72)" no-label skip
      636     B-viewProcInfo
      637     B-WaitFramStop at row 4 col 30
      638     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      639     .
      640   define new global shared variable mBatchMode as logical no-undo init ?.
      641   define variable mFramBachModHandle as handle no-undo.
      642   mFramBachModHandle = frame waitfram:handle.
      643   define variable mFameOldVis as logical no-undo.
      644   define variable mVisCUrentVin as logical no-undo.
      645   if session:batch-mode
      646   then
      647      mBatchMode = yes.
      648   if mBatchMode = ? then do:
      649     mVisCUrentVin = current-window:visible.
      650     mFameOldVis = mFramBachModHandle:visible.
      651     mFramBachModHandle:visible  = yes.
      652     mBatchMode = mFramBachModHandle:visible ne yes.
      653     mFramBachModHandle:visible = mFameOldVis.
      654     current-window:visible = mVisCUrentVin.
      655   end.
      656    if  log-manager:logfile-name ne ?
      657     then DO:
      658         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      659         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      660         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      661     end.
      662   on choose of B-WaitFramStop in frame waitfram
      663   do:
      664     mWaitFramStop = yes.
      665     mWaitFramStopUser = yes.
      666   end.
      667   function waitfram-check-timeout returns logical():
      668      define variable vtime as int64 no-undo.
      669      if mWaitFramStopTimeOut
      670      then
      671         return yes.
      672      vtime = ( now - mWaitFramStartProc ) / 1000 .
      673      if     mWaitFramTimeOut ne ?
      674         and mWaitFramTimeOut ne 0
      675         and mWaitFramTimeOut lt vtime
      676      then do:
      677         mWaitFramStopTimeOut = yes.
      678      end.
      679      return mWaitFramStopTimeOut.
      680   end.
      681   procedure waitfram-hide :
      682     if not session:batch-mode
      683     then do
      684     on error undo, return error return-value
      685     :
      686       pause 0 before-hide .
      687       if not mBatchMode then
      688         hide frame waitfram .
      689     if     not mWaitFramView
      690        and mWaitProcEvent
      691     then
      692       process events .
      693     end.
      694   end procedure.
      695   procedure waitfram-show :
      696     define input  parameter p-message as character no-undo .
      697     define variable v-left-margin as integer   no-undo .
      698     if not session:batch-mode
      699     then do
      700     on error undo, return error return-value
      701     :
      702       if length(p-message) <= 70 then do:
      703         assign
      704           v-left-margin = integer((70 - length(p-message)) / 2)
      705         .
      706         assign
      707           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      708         .
      709         assign
      710           v-waitfram-action01 = " "
      711           v-waitfram-action02 = " "
      712                                    + fill(" ", v-left-margin)
      713                                    + p-message
      714           v-waitfram-action03 = " "
      715         .
      716       end.
      717       else do:
      718         define variable vRindex1 as integer no-undo.
      719         define variable vRindex2 as integer no-undo.
      720         vRindex1 = r-index(p-message," ",70).
      721         if vRindex1 = 0
      722         then
      723            vRindex1 = 70.
      724         if length(p-message)  <= vRindex1 + 70 then do:
      725           assign
      726             v-waitfram-action01 = " "
      727             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      728             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      729           .
      730         end.
      731         else do:
      732           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      733           if vRindex2 <= vRindex1
      734           then
      735              vRindex2 = vRindex1 + 70.
      736           assign
      737             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      738             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      739             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      740           .
      741         end.
      742       end.
      743       B-viewProcInfo:visible   in frame waitfram = no.
      744       B-viewProcInfo:sensitive in frame waitfram = no.
      745       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      746       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      747       if  (   mWaitFramView
      748          or  mWaitProcEvent)
      749          and not mBatchMode
      750       then
      751          display
      752             v-waitfram-action01 skip
      753             v-waitfram-action02 skip
      754             v-waitfram-action03 skip
      755          with frame waitfram .
      756       if     mWaitFramView
      757          then do:
      758             if     mWaitFramInterval ne ?
      759                and not mBatchMode
      760             then
      761                wait-for go of frame waitfram pause mWaitFramInterval.
      762          end.
      763          else
      764             if     mWaitProcEvent
      765                and not mBatchMode
      766             then
      767                process events .
      768     end.
      769   end procedure.
      770      procedure waitfram-show-this:
      771         define input  parameter iInterval as int64 no-undo.
      772         define variable vtime as int64 no-undo.
      773         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      774         mWaitFramInterval = iInterval.
      775         run waitfram-show (substitute("&1&2 &3&4" ,
      776                                       mWaitFramTextBeg ,
      777                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      778                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      779                                       mWaitFramTextEnd
      780                                      )
      781                           ).
      782      end.
      783      procedure WaitFramRunPause:
      784         define input  parameter iInterval as dec no-undo.
      785         define variable vStart  as datetime-tz no-undo.
      786         define variable vend    as datetime-tz no-undo.
      787         define variable vint as int64 no-undo.
      788         define variable vOk as logical no-undo.
      789         vStart = now.
      790         vend   = vStart.
      791         publish "WaitFramPause" (iInterval,output vOk).
      792         vend   =  now.
      793         vint = vend - vStart.
      794         vint = iInterval - vint / 1000.
      795         if     not mWaitFramStop
      796            and (   vint > 0
      797                 or (    not vOk
      798                     and iInterval eq ?
      799                     )
      800                 )
      801         then
      802            run waitfram-show-this (iInterval).
      803         vend   =  now.
      804         vint = vend - vStart.
      805         vint = iInterval - vint / 1000.
      806         if     not mWaitFramStop
      807            and vint > 0
      808         then do:
      809            run gbl/pause.p (vint * 1000).
      810         end.
      811         if iInterval ne ?
      812         then
      813            publish "WaitFramStop".
      814         waitfram-check-timeout().
      815      end.
      816      procedure WaitFramWaitFor:
      817         define input  parameter iInterval as dec no-undo.
      818         assign
      819            mWaitFramStartProc   = now
      820            mWaitFramStopUser    = no
      821            mWaitFramStopTimeOut = no
      822         .
      823         block-wait:
      824         do while not mWaitFramStop:
      825            run WaitFramRunPause (iInterval).
      826            if  waitfram-check-timeout()
      827            then do:
      828               leave block-wait.
      829            end.
      830         end.
      831         run waitfram-hide.
      832      end.
      833   procedure waitfram-join :
      834     define input  parameter p-line-1  as character no-undo .
      835     define input  parameter p-line-2  as character no-undo .
      836     define input  parameter p-line-3  as character no-undo .
      837     define output parameter p-message as character no-undo .
      838     do
      839     on error undo, return error return-value
      840     :
      841       assign
      842         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      843                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      844                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      845       .
      846     end.
      847   end procedure.
      848   function waitfram-join-function returns character
      849     (input p-line-1 as character
      850     ,input p-line-2 as character
      851     ,input p-line-3 as character
      852     ).
      853     define variable v-message as character no-undo .
      854     run waitfram-join in this-procedure
      855       (input  p-line-1
      856       ,input  p-line-2
      857       ,input  p-line-3
      858       ,output v-message
      859       ) .
      860     return v-message .
      861   end function .
      862   define new global shared variable g#libofarh as handle no-undo .
      863   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   procedure factord :
      865     define input  parameter p-fact-date            as date    no-undo .
      866     define input  parameter p-fact-time            as integer no-undo .
      867     define input  parameter p-fact-num             as integer no-undo .
      868     define input  parameter p-shift-date           as date    no-undo .
      869     define input  parameter p-shift-num            as integer no-undo .
      870     define input  parameter p-shift-on             as logical no-undo .
      871     define output parameter p-fact-order           as decimal no-undo .
      872     define output parameter p-shift-end-fact-order as decimal no-undo .
      873     define output parameter p-day-end-fact-order   as decimal no-undo .
      874     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      875     if p-fact-date = ?
      876     then do:
      877       return error "Не указана фактическая дата" .
      878     end.
      879     define variable v-fact-date-num as integer no-undo .
      880     assign
      881       v-fact-date-num = integer(p-fact-date)
      882     .
      883     if p-fact-num = ?
      884     or p-fact-num = 0
      885     then do:
      886       return error "Не задан p-fact-num " + string(p-fact-num) .
      887     end.
      888     if p-fact-num < 0
      889     then do:
      890       return error "Отрицательный fact-num " + string(p-fact-num) .
      891     end.
      892     if p-fact-num >= 100000000
      893     then do:
      894       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      895     end.
      896     if p-shift-on = true
      897     then do:
      898       if p-shift-date = ?
      899       then do:
      900         return error "Не задана дата смены" .
      901       end.
      902       if p-shift-num = ?
      903       or p-shift-num = 0
      904       then do:
      905         return error "Не задан номер смены" .
      906       end.
      907     end.
      908     else do:
      909       assign
      910         p-shift-date = p-fact-date
      911         p-shift-num  = 24
      912       .
      913     end.
      914     define variable v-shift-offset as integer no-undo .
      915     if p-shift-date = p-fact-date
      916     then do:
      917       assign
      918         v-shift-offset = 1
      919       .
      920     end.
      921     if p-shift-date < p-fact-date
      922     then do:
      923       assign
      924         v-shift-offset = 0
      925       .
      926     end.
      927     if p-shift-date > p-fact-date
      928     then do:
      929       message
      930         vss-workfile vss-revision vss-description skip
      931         "Неправильная дата закрытия смены" skip
      932         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      933         view-as alert-box error .
      934       undo, return error
      935         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      936           ,string(p-fact-date, '99/99/9999':U)
      937           ,string(p-shift-date, '99/99/9999':U)
      938           )
      939       .
      940     end.
      941     if p-shift-num < 1
      942     or p-shift-num > 24
      943     then do:
      944       message
      945         vss-workfile vss-revision vss-description skip
      946         "Неправильный номер смены" skip
      947         "p-shift-num" p-shift-num skip
      948         view-as alert-box error .
      949       undo, return error return-value .
      950     end.
      951     assign
      952       p-fact-order           = v-fact-date-num
      953                              + v-shift-offset * 0.5
      954                              + p-shift-num    * 0.02 - 0.01
      955                              + p-fact-num     * 0.0000000001
      956       p-shift-end-fact-order = v-fact-date-num
      957                              + v-shift-offset * 0.5
      958                              + p-shift-num    * 0.02
      959       p-day-end-fact-order   = v-fact-date-num
      960                              + 0.99
      961     .
      962     if p-fact-order           <= v-fact-date-num
      963     or p-shift-end-fact-order <= v-fact-date-num
      964     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      965     or p-shift-end-fact-order >= p-day-end-fact-order
      966     then do:
      967       message
      968         vss-workfile vss-revision vss-description skip
      969         "Внутренняя ошибка при генерации фактического номера" skip
      970         "p-fact-date"            p-fact-date            skip
      971         "p-fact-time"            p-fact-time            skip
      972         "p-fact-num"             p-fact-num             skip
      973         "p-shift-date"           p-shift-date           skip
      974         "p-shift-num"            p-shift-num            skip
      975         "p-shift-on"             p-shift-on             skip
      976         "p-shift-end-fact-order" p-shift-end-fact-order skip
      977         "p-day-end-fact-order"   p-day-end-fact-order   skip
      978         "v-fact-date-num"        v-fact-date-num        skip
      979         view-as alert-box error .
      980       undo, return error return-value .
      981     end.
      982   end procedure.
      983   procedure day-begin-fact-order :
      984     define input  parameter p-fact-date            as date    no-undo .
      985     define output parameter p-day-begin-fact-order as decimal no-undo .
      986     do
      987     on error undo, return error return-value
      988     :
      989       if p-fact-date = ?
      990       then do:
      991         assign
      992           p-day-begin-fact-order = 0
      993         .
      994       end.
      995       else do:
      996         assign
      997           p-day-begin-fact-order = integer(p-fact-date)
      998         .
      999       end.
     1000     end.
     1001   end procedure.
     1002   procedure factord-max-fact-order :
     1003     define output parameter p-max-fact-order as decimal   no-undo .
     1004     do
     1005     on error undo, return error return-value
     1006     :
     1007       run day-begin-fact-order in this-procedure
     1008         (input  date(1, 1, 5000)
     1009         ,output p-max-fact-order
     1010         ) .
     1011     end.
     1012   end procedure.
     1013   procedure factord-cut-archive :
     1014     define input  parameter p-obj-type             as character no-undo .
     1015     define input  parameter p-obj-code             as integer   no-undo .
     1016     define input  parameter p-fact-date            as date      no-undo .
     1017     define output parameter p-shift-on             as logical   no-undo .
     1018     define output parameter p-shift-date           as date      no-undo .
     1019     define output parameter p-shift-num            as integer   no-undo .
     1020     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1021     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1022     define variable v-fact-order as decimal   no-undo .
     1023     define buffer buf_shift-obj for ub.shift-obj .
     1024     do
     1025     on error undo, return error return-value
     1026     :
     1027   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1029     (input  p-obj-type
     1030     ,input  p-obj-code
     1031     ,input  'shift-on=request'
     1032     ,output p-shift-on
     1033     ) no-error .
     1034       if error-status :error
     1035       then do:
     1036         message
     1037           vss-workfile vss-revision vss-description skip
     1038           "Ошибка при определении атрибута объекта" skip
     1039           "Объект" p-obj-type p-obj-code skip
     1040           error-status :get-message(1) skip
     1041           return-value skip
     1042           view-as alert-box error .
     1043         undo, return error return-value .
     1044       end.
     1045       if p-shift-on = false
     1046       then do:
     1047         assign
     1048           p-shift-date               = ?
     1049           p-shift-num                = 0
     1050         .
     1051       end.
     1052       else do:
     1053         find first buf_shift-obj share-lock
     1054           where buf_shift-obj.obj-type   = p-obj-type
     1055             and buf_shift-obj.obj-code   = p-obj-code
     1056             and buf_shift-obj.shift-date > p-fact-date
     1057           use-index pi
     1058           no-error .
     1059         if not available buf_shift-obj
     1060         or buf_shift-obj.status_ <> 'зкр':U
     1061         then do:
     1062           message
     1063             vss-workfile vss-revision vss-description skip
     1064             "Невозможно вычислить последнюю смену" skip
     1065             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1066             "Объект" p-obj-type p-obj-code skip
     1067             "Дата" p-fact-date skip
     1068             view-as alert-box error .
     1069           undo, return error return-value .
     1070         end.
     1071         find last buf_shift-obj share-lock
     1072           where buf_shift-obj.obj-type = p-obj-type
     1073             and buf_shift-obj.obj-code = p-obj-code
     1074             and buf_shift-obj.shift-date <= p-fact-date
     1075           use-index pi
     1076           no-error .
     1077         if available buf_shift-obj
     1078         then do:
     1079           if  buf_shift-obj.status_ = 'зкр':U
     1080           then do:
     1081             assign
     1082               p-shift-date = buf_shift-obj.shift-date
     1083               p-shift-num  = buf_shift-obj.shift-num
     1084             .
     1085           end.
     1086           else do:
     1087             message
     1088               vss-workfile vss-revision vss-description skip
     1089               "Невозможно вычислить последнюю смену" skip
     1090               "Статус смены отличен от статуса" 'зкр':U skip
     1091               "Объект" p-obj-type p-obj-code skip
     1092               "Дата" p-fact-date skip
     1093               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1094               view-as alert-box error .
     1095             undo, return error return-value .
     1096           end.
     1097         end.
     1098         else do:
     1099           assign
     1100             p-shift-date = p-fact-date - 1
     1101             p-shift-num  = 1
     1102           .
     1103         end.
     1104       end.
     1105       run factord in this-procedure
     1106         (input  p-fact-date
     1107         ,input  1
     1108         ,input  1
     1109         ,input  p-shift-date
     1110         ,input  p-shift-num
     1111         ,input  p-shift-on
     1112         ,output v-fact-order
     1113         ,output p-shift-end-fact-order
     1114         ,output p-day-end-fact-order
     1115         ) no-error .
     1116       if error-status :error
     1117       then do:
     1118         message
     1119           vss-workfile vss-revision vss-description skip
     1120           "Ошибка при вызове процедуры factord"
     1121           error-status :get-message(1) skip
     1122           return-value skip
     1123           view-as alert-box error .
     1124         undo, return error return-value .
     1125       end.
     1126     end.
     1127   end procedure.
     1128   procedure factord-lock-shift :
     1129     define input  parameter p-obj-type  as character no-undo .
     1130     define input  parameter p-obj-code  as integer   no-undo .
     1131     define input  parameter p-fact-date as date      no-undo .
     1132     define parameter buffer buf_shift-obj for ub.shift-obj .
     1133     define variable v-shift-on      as logical   no-undo .
     1134     define variable v-extra-message as character no-undo .
     1135     define variable v-error as character no-undo .
     1136     do
     1137     on error undo, return error return-value
     1138     :
     1139   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1141     (input  p-obj-type
     1142     ,input  p-obj-code
     1143     ,input  'shift-on=request'
     1144     ,output v-shift-on
     1145     ) no-error .
     1146       if error-status :error
     1147       then do:
     1148         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1149         undo, return error v-error .
     1150       end.
     1151       if v-shift-on = true
     1152       then do:
     1153         find first buf_shift-obj share-lock
     1154           where buf_shift-obj.obj-type   = p-obj-type
     1155             and buf_shift-obj.obj-code   = p-obj-code
     1156             and buf_shift-obj.shift-date > p-fact-date
     1157           use-index pi
     1158           no-error .
     1159         if not available buf_shift-obj
     1160         or buf_shift-obj.status_ <> 'зкр':U
     1161         then do:
     1162           find last buf_shift-obj
     1163             where buf_shift-obj.obj-type = p-obj-type
     1164               and buf_shift-obj.obj-code = p-obj-code
     1165               and buf_shift-obj.status_  = 'зкр':U
     1166             use-index stts
     1167             no-error .
     1168           if available buf_shift-obj
     1169           then do:
     1170             assign
     1171               v-extra-message =
     1172                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1173                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1174                               )
     1175             .
     1176           end.
     1177           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1178           undo, return error v-error .
     1179         end.
     1180       end.
     1181     end.
     1182   end procedure.
     1183   procedure factord-end-day :
     1184     define input  parameter p-fact-date            as date    no-undo .
     1185     define output parameter p-day-end-fact-order   as decimal no-undo .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       if p-fact-date = ?
     1190       then do:
     1191         return error "Не указана фактическая дата" .
     1192       end.
     1193       assign
     1194         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1195       .
     1196     end.
     1197   end procedure.
     1198   procedure factord-to-date :
     1199     define input  parameter p-fact-order as decimal no-undo .
     1200     define output parameter p-fact-date  as date    no-undo .
     1201     define variable v-ref-date  as date      no-undo .
     1202     define variable v-ref-delta as integer   no-undo .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206       if p-fact-order = ?
     1207       or p-fact-order = 0
     1208       then do:
     1209         return error "Не указан fact-order" .
     1210       end.
     1211       assign
     1212         v-ref-date  = date(1, 1, 2000)
     1213       .
     1214       assign
     1215         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1216       .
     1217       assign
     1218         p-fact-date = v-ref-date + v-ref-delta
     1219       .
     1220     end.
     1221   end procedure.
     1222   procedure factord-to-fact-num :
     1223     define input  parameter p-fact-order as decimal no-undo .
     1224     define output parameter p-fact-num   as integer no-undo .
     1225     define variable v-fact-order-trunc as decimal no-undo .
     1226     do
     1227     on error undo, return error return-value
     1228     :
     1229       if p-fact-order = ?
     1230       or p-fact-order = 0
     1231       then do:
     1232         return error "Не указан fact-order" .
     1233       end.
     1234       assign
     1235        v-fact-order-trunc = truncate(p-fact-order, 2)
     1236       .
     1237       assign
     1238         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1239       .
     1240     end.
     1241   end procedure.
     1242   procedure factord-to-shift-num :
     1243     define input  parameter p-fact-order as decimal no-undo .
     1244     define output parameter p-shift-num   as integer no-undo .
     1245     define variable  p-shift-numd  as decimal   no-undo .
     1246     define variable v-fact-order-trunc as decimal no-undo .
     1247     do
     1248     on error undo, return error return-value
     1249     :
     1250       if p-fact-order = ?
     1251       or p-fact-order = 0
     1252       then do:
     1253         return error "Не указан fact-order" .
     1254       end.
     1255       assign
     1256        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1257       .
     1258       if v-fact-order-trunc < 0.5 then do:
     1259         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1260       end.
     1261       assign
     1262         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1263         .
     1264        assign
     1265         p-shift-num = truncate (p-shift-numd , 0)
     1266       .
     1267     end.
     1268   end procedure.
     1269   procedure proc-close-one-fin-ob :
     1270    do
     1271    on error undo, return error return-value
     1272    :
     1273   define input parameter p-recid  as recid no-undo .
     1274   define buffer buf_fin-liab-fo   for ub.fin-ob .
     1275   define buffer buf_fin-ob-before for ub.fin-ob-before .
     1276   define buffer ff_fin-ob-trn     for ub.fin-ob-trn  .
     1277   define variable  v-fact-date            as date    no-undo .
     1278   define variable  v-fact-time            as integer no-undo .
     1279   define variable  v-fact-num             as integer no-undo .
     1280   define variable  v-shift-date           as date    no-undo .
     1281   define variable  v-shift-num            as integer no-undo .
     1282   define variable  v-shift-on             as logical no-undo .
     1283   define variable  v-fact-order           as decimal no-undo .
     1284   define variable  v-shift-end-fact-order as decimal no-undo .
     1285   define variable  v-day-end-fact-order   as decimal no-undo .
     1286   define variable  var-fo-fact as logical   no-undo .
     1287   define variable  par-type         as character no-undo .
     1288   define variable  v-value-date     as date   no-undo .
     1289   define variable  v-value-decimal  as decimal   no-undo .
     1290   define variable  v-value-integer  as integer   no-undo .
     1291   define variable  v-value-logical  as logical   no-undo .
     1292   define variable v-found           as logical   no-undo .
     1293   define variable v-value-character as character no-undo .
     1294   define variable v-i as integer   no-undo .
     1295   define variable p-recalc     as logical   no-undo .
     1296   define variable p-recalc2    as logical   no-undo .
     1297   define buffer recalc_fin-ob for ub.fin-ob  .
     1298   run thbjattr_value in this-procedure  (
     1299     input   "",
     1300     input   0 ,
     1301     input   'fin-global':U ,
     1302     input   'fo-fact'  ,
     1303     output  v-value-character ,
     1304     output  v-value-date      ,
     1305     output  v-value-decimal   ,
     1306     output  v-value-integer   ,
     1307     output  var-fo-fact  ,
     1308     output  par-type            ,
     1309     output  v-found
     1310     ) no-error
     1311     .
     1312   if error-status :error then var-fo-fact = false .
     1313   find first buf_fin-liab-fo no-lock where recid(buf_fin-liab-fo) = p-recid  no-error .
     1314   release buf_fin-liab-fo no-error .
     1315   find first  buf_fin-liab-fo  exclusive-lock  where recid(buf_fin-liab-fo) = p-recid  no-error .
     1316   if not available buf_fin-liab-fo then return error .
     1317      if buf_fin-liab-fo.pay-date = ? then do:
     1318         message "Финансовое обязательство : " buf_fin-liab-fo.prn-doc-code  skip
     1319                 "не задана дата платежа!"  skip
     1320                 "Закрывать ФО ?"
     1321                 view-as alert-box question
     1322                 buttons yes-no
     1323                 update v-ok as log
     1324               .
     1325         if v-ok = false then  return.
     1326      end.
     1327      if buf_fin-liab-fo.status_ = 'факт':U then do:
     1328         message "Финансовое обязательство " buf_fin-liab-fo.prn-doc-code  " уже закрыто до ФАКТ".
     1329         return.
     1330      end.
     1331     run cur-time
     1332         ( output v-fact-date
     1333         , output v-fact-time
     1334         ).
     1335     if var-fo-fact = yes then do:
     1336        v-fact-date = 01/01/1900 .
     1337        v-i = 0 .
     1338        for each ff_fin-ob-trn no-lock  where
     1339                 ff_fin-ob-trn.doc-code  =  buf_fin-liab-fo.doc-code and
     1340                 ff_fin-ob-trn.host-code =  buf_fin-liab-fo.host-code
     1341               :
     1342               v-i = v-i + 1.
     1343              case ff_fin-ob-trn.doc-type  :
     1344              when "spc" then do:
     1345                 run cur-time
     1346                     ( output v-fact-date
     1347                     , output v-fact-time
     1348                     ).
     1349              end.
     1350              when "order" then do:
     1351                   find first ub.ord-doc   no-lock where ub.ord-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1352                   if available ub.ord-doc then do:
     1353                       if v-fact-date < ub.ord-doc.fact-date then v-fact-date = ub.ord-doc.fact-date.
     1354                   end.
     1355              end.
     1356              when "rcv" then do:
     1357                 run cur-time
     1358                     ( output v-fact-date
     1359                     , output v-fact-time
     1360                     ).
     1361              end.
     1362              when "add" then do:
     1363                 run cur-time
     1364                     ( output v-fact-date
     1365                     , output v-fact-time
     1366                     ).
     1367              end.
     1368              otherwise do:
     1369                   find first ub.trn-doc   no-lock where ub.trn-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1370                   if available ub.trn-doc then do:
     1371                       if v-fact-date < ub.trn-doc.fact-date then v-fact-date = ub.trn-doc.fact-date.
     1372                   end.
     1373                   find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code =  ff_fin-ob-trn.trn-doc-code
     1374                                                     and ub.c-trn-doc.is-del = true   no-error .
     1375                   if available ub.c-trn-doc then do:
     1376                       if v-fact-date < ub.c-trn-doc.corr-date then v-fact-date = ub.c-trn-doc.corr-date.
     1377                   end.
     1378              end.
     1379              end case.
     1380        end.
     1381        if v-i = 0  then do:
     1382             run cur-time
     1383                 ( output v-fact-date
     1384                 , output v-fact-time
     1385                 ).
     1386        end.
     1387     end.
     1388     assign
     1389         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     1390         v-shift-date = ?
     1391         v-shift-num  = ?
     1392         v-shift-on   = false
     1393     .
     1394      run factord in this-procedure (
     1395          input  v-fact-date
     1396         ,input  v-fact-time
     1397         ,input  v-fact-num
     1398         ,input  v-shift-date
     1399         ,input  v-shift-num
     1400         ,input  v-shift-on
     1401         ,output v-fact-order
     1402         ,output v-shift-end-fact-order
     1403         ,output v-day-end-fact-order
     1404         ) .
     1405      assign
     1406       buf_fin-liab-fo.fact-order       =  v-fact-order
     1407       buf_fin-liab-fo.status_          =  'факт':U
     1408       buf_fin-liab-fo.fact-date        =  v-fact-date
     1409       buf_fin-liab-fo.user-db-num-fact =  g#db-num
     1410       buf_fin-liab-fo.user-name-fact   =  g#userid
     1411      .
     1412      run str/calc-bal.p (input "finob", input yes, input buf_fin-liab-fo.doc-type, input buf_fin-liab-fo.host-code, input buf_fin-liab-fo.contract-code, input buf_fin-liab-fo.sum-contract, input buf_fin-liab-fo.sum-rubl, input buf_fin-liab-fo.sum-base) .
     1413      find first ub.contract no-lock
     1414           where ub.contract.contract-code = buf_fin-liab-fo.contract-code and
     1415                 ub.contract.host-code     = buf_fin-liab-fo.host-code
     1416                 no-error.
     1417      if available ub.contract then do:
     1418        if ( ub.contract.gen-factur = 2 or
     1419             ub.contract.gen-factur = 12 or
     1420             ub.contract.gen-factur = 102 or
     1421             ub.contract.gen-factur = 112) then
     1422          assign
     1423            buf_fin-liab-fo.need-factur = 1
     1424            .
     1425      end.
     1426      for each buf_fin-ob-before  exclusive-lock  where
     1427               buf_fin-ob-before.host-code = buf_fin-liab-fo.host-code and
     1428               buf_fin-ob-before.doc-code  = buf_fin-liab-fo.doc-code and
     1429               buf_fin-ob-before.status_   = 'авто':U
     1430               on error undo, return error :
     1431           assign
     1432             buf_fin-ob-before.fact-order       =  v-fact-order
     1433             buf_fin-ob-before.status_          =  'факт':U
     1434             buf_fin-ob-before.fact-date        =  v-fact-date
     1435             buf_fin-ob-before.user-db-num-fact =  g#db-num
     1436             buf_fin-ob-before.user-name-fact   =  g#userid
     1437           .
     1438      end.
     1439   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1440   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_taskclco in g#libofarh
     1441   (input buf_fin-liab-fo.host-code
     1442   ,input buf_fin-liab-fo.doc-code
     1443   ,input g#userid
     1444   ,input 'close':u
     1445   ,input yes
     1446   ,output p-recalc
     1447   ) no-error
     1448   .
     1449           if error-status :error then do:
     1450             message
     1451               "При обновлении архива обнаружена ошибка " skip
     1452               return-value skip
     1453               error-status :get-message(1) skip
     1454               view-as alert-box error .
     1455             undo, return error "Ошибка расчета архива" .
     1456           end.
     1457           if p-recalc then do:
     1458                 for each recalc_fin-ob no-lock where
     1459                          recalc_fin-ob.host-code = buf_fin-liab-fo.host-code  and
     1460                          recalc_fin-ob.status_   = 'факт':U  and
     1461                          recalc_fin-ob.fact-order > buf_fin-liab-fo.fact-order
     1462                          break by recalc_fin-ob.fact-order
     1463                     :
     1464   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_taskclco in g#libofarh
     1466   (input recalc_fin-ob.host-code
     1467   ,input recalc_fin-ob.doc-code
     1468   ,input g#userid
     1469   ,input 'close':u
     1470   ,input yes
     1471   ,output p-recalc2
     1472   ) no-error
     1473   .
     1474                       if error-status :error then do:
     1475                         message
     1476                         "При персчете архива обнаружена ошибка " skip
     1477                         return-value skip
     1478                         error-status :get-message(1) skip
     1479                         view-as alert-box error .
     1480                         undo, return error "Ошибка расчета архива" .
     1481                       end.
     1482                 end.
     1483           end.
     1484    end.
     1485   end procedure.
     1486   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1487   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1488   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1489   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1490   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1491   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1492   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1493   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1494   procedure uf-name :
     1495     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1496     define output parameter p-use-List_     as logical   no-undo .
     1497     define output parameter p-type-List_     as character no-undo .
     1498     define output parameter p-format-List_   as character no-undo .
     1499     define output parameter p-use-Naim      as logical   no-undo .
     1500     define output parameter p-type-Naim      as character no-undo .
     1501     define output parameter p-format-Naim    as character no-undo .
     1502     define output parameter p-use-print-graft as logical   no-undo .
     1503     define output parameter p-use-sort-gr   as logical   no-undo .
     1504     define output parameter p-use-type-price as logical   no-undo .
     1505     define output parameter p-use-type-val  as logical   no-undo .
     1506     define output parameter p-label          as character no-undo .
     1507     define output parameter p-tooltip        as character no-undo .
     1508     define output parameter p-user-can-edit  as logical   no-undo .
     1509     define output parameter p-output-display as logical   no-undo .
     1510     define output parameter p-other          as character no-undo .
     1511     do
     1512     on error undo, return error
     1513     :
     1514       case p-code :
     1515               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1516               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
