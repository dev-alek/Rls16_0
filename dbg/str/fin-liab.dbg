     2687   DEFINE new shared QUERY BR-docs FOR
     2688         buf_fin-liab except ,
     2689         xx-contract SCROLLING.
     2690   DEFINE BROWSE BR-docs
     2691     QUERY BR-docs DISPLAY
     2692        mark-string(recid( buf_fin-liab), rid-list) @ p-mark  COLUMN-LABEL '*'   FORMAT "x(1)"
     2693        buf_fin-liab.status_    COLUMN-LABEL 'Статус'          Format "x(6)"
     2694        buf_fin-liab.prn-doc-code    COLUMN-LABEL '№ док-та'          Format "x(10)"
     2695        buf_fin-liab.doc-date    COLUMN-LABEL 'Создан'          format "99/99/99"
     2696        buf_fin-liab.fact-date    COLUMN-LABEL 'Закрыт'          format "99/99/99"
     2697        contract-id(recid( buf_fin-liab)) @ p-contr   COLUMN-LABEL 'Договор'          Format "x(16)"
     2698        (buf_fin-liab.receiver-type + ' ' + string(buf_fin-liab.receiver-code))    COLUMN-LABEL 'Получатель'          Format "x(10)"
     2699        (buf_fin-liab.payer-type + ' ' + string(buf_fin-liab.payer-code))    COLUMN-LABEL 'Плательщик'          Format "x(10)"
     2700        buf_fin-liab.pay-date   COLUMN-LABEL 'Платеж'           format "99/99/99"
     2701        val-abbr-type(recid( buf_fin-liab))  @ l-curr COLUMN-LABEL 'Вал'         Format "x(3)"
     2702        buf_fin-liab.sum-doc   COLUMN-LABEL 'Сумма в валюте!док-та'
     2703        buf_fin-liab.doc-code   COLUMN-LABEL 'Внутр.№'         Format "99999999"
     2704        if buf_fin-liab.doc-type = 'при':U then 'с покупателем' else 'с поставщиком' @ p-type   COLUMN-LABEL 'Тип'          Format "x(13)"
     2705        debts(recid (buf_fin-liab)) @ p-debts  COLUMN-LABEL 'Непогаш.задолж!(руб.)'          Format  "->>>>>>>>>>>9.99"
     2706        (buf_fin-liab.obj-type + ' ' + string(buf_fin-liab.obj-code)) @ p-obj  COLUMN-LABEL 'Объект'   Format "x(9)"
     2707        buf_fin-liab.receiver-name   COLUMN-LABEL 'Наименование'          Format "x(40)"
     2708        contract-gen(recid(buf_fin-liab)) @ p-gen  COLUMN-LABEL 'Условие генерации'          Format "x(40)"
     2709        f-factur(recid(buf_fin-liab)) @ varfactur column-label 'Счет-фактура' format "x(8)"
     2710         enable buf_fin-liab.status_
     2711       WITH NO-ROW-MARKERS SEPARATORS SIZE 93.75 BY 12.5.
     2712   DEFINE FRAME Dialog-Frame
     2713        B-exit AT ROW 1 COL 1
     2714        B-sel AT ROW 1 COL 14
     2715        B-close AT ROW 1 COL 24
     2716        B-Export AT ROW 1 COL 34
     2717        b-fact AT ROW 1 COL 44
     2718        B-trn AT ROW 1 COL 54
     2719        B-parts AT ROW 1 COL 64
     2720        B-PFO AT ROW 1 COL 74
     2721        B-Help AT ROW 1 COL 84
     2722        B-sch AT ROW 1 COL 84
     2723        B-History AT ROW 1 COL 85
     2724        B-mark AT ROW 2 COL 1
     2725        B-add AT ROW 2 COL 4
     2726        B-lkp AT ROW 2 COL 14
     2727        B-chg AT ROW 2 COL 24
     2728        B-del AT ROW 2 COL 34
     2729        b-exec-fo AT ROW 2 COL 44
     2730        b-exec-pay AT ROW 2 COL 64
     2731        B-print AT ROW 2 COL 84
     2732        S-tt AT ROW 3 COL 25 NO-LABEL
     2733        R-1 AT ROW 3.75 COL 1 NO-LABEL
     2734        R-2 AT ROW 3.75 COL 13.5 NO-LABEL
     2735        v-date-doc-1 AT ROW 3.75 COL 47.5 COLON-ALIGNED
     2736        v-date-pay-1 AT ROW 3.75 COL 60.75 COLON-ALIGNED
     2737        R-3 AT ROW 3.75 COL 72 NO-LABEL
     2738        v-date-doc-2 AT ROW 4.75 COL 47.5 COLON-ALIGNED
     2739        v-date-pay-2 AT ROW 4.75 COL 60.75 COLON-ALIGNED
     2740        B-reopen-br AT ROW 5 COL 84
     2741        sch-code AT ROW 6.58 COL 10.87
     2742        p-desc AT ROW 6.58 COL 37.13
     2743        p-date AT ROW 6.58 COL 70
