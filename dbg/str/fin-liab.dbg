     8156   do:
     8157     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8158       (input  v-cntxt-db-num
     8159       ,input  v-cntxt-userid
     8160       ,input  0
     8161       ,input  'actn_fin-liability_close-fact':U
