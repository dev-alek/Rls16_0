     2366   FUNCTION mark-string RETURNS CHARACTER
     2367     ( input p-recid as recid, input mark-list as character  ) :
     2368     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2369   END FUNCTION.
