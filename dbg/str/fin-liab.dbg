      389   procedure fltfield-clear :
      390     define output parameter loc-fld as character no-undo.
      391     define output parameter loc-lab as character no-undo .
      392     define output parameter loc-spr as character no-undo .
      393     define output parameter loc-dim as character no-undo .
      394     assign
      395       loc-fld = ""
      396       loc-lab = ""
      397       loc-spr = ""
      398       loc-dim = "0"
      399     .
      400   end procedure .
      401   procedure fltfield-add :
      402     define input        parameter par-fld as character no-undo.
      403     define input        parameter par-lab as character no-undo .
      404     define input        parameter par-spr as character no-undo .
      405     define input-output parameter loc-fld as character no-undo.
      406     define input-output parameter loc-lab as character no-undo .
      407     define input-output parameter loc-spr as character no-undo .
      408     define input-output parameter loc-dim as character no-undo .
      409     do
      410     on error undo, return error
      411     :
      412       assign
      413       loc-fld = if loc-dim = '0'
      414                 then par-fld
      415                 else (loc-fld + chr(44) + par-fld)
      416       loc-lab = if loc-dim = '0'
      417                 then par-lab
      418                 else (loc-lab + chr(44) + par-lab)
      419       loc-spr = if loc-dim = '0'
      420                 then par-spr
      421                 else (loc-spr + chr(44) + par-spr)
      422       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      423                 string(integer(if num-entries(loc-dim) > 1
      424                               then entry(2, loc-dim)
      425                               else entry(1, loc-dim)
      426                               ) + 1)
      427       no-error
      428       .
      429     end.
      430   end procedure.
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   define  stream PrnLibStream.
      433   procedure prn-lib-prn-file :
      434     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      435     define input parameter p-DIsabledoptions as integer no-undo .
      436     define variable v-report-name as character no-undo .
      437     define variable v-user-action as character no-undo .
      438     define variable v-printed     as logical   no-undo .
      439     define variable v-exist       as logical   no-undo .
      440     do
      441       on error undo, return error
      442       :
      443       run prn-lib-get-report-name  in this-procedure (
      444         input parParentProc
      445         ,output v-report-name
      446         ).
      447   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      449     (input  v-report-name
      450     ,input  2
      451     ,output v-exist
      452     )  .
      453       if NOT v-exist then
      454       DO:
      455         Message
      456           "Нет заданий на печать ! "
      457           view-as alert-box .
      458         Return  .
      459       End.
      460       run gbl/prnfilen.w
      461         (input  ""
      462         ,input  p-DisabledOptions
      463         ,input  string(v-report-name )
      464         ,input  7
      465         ,output v-user-action
      466         ,output v-printed
      467         ) .
      468       if v-printed then
      469       do:
      470         return "YES" .
      471       end.
      472       else
      473       do:
      474         return "NO" .
      475       end.
      476     end.
      477   end procedure.
      478   procedure prn-lib-open-stream :
      479     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      480     define input parameter p-page-size    as integer no-undo .
      481     define input parameter p-is-stream    as logical no-undo .
      482     define input parameter p-append       as logical no-undo .
      483     define variable v-report-name as character no-undo .
      484     do
      485       on error undo, return error
      486       :
      487       run prn-lib-get-report-name  in this-procedure (
      488         input parParentProc
      489         ,output v-report-name
      490         ).
      491       if p-is-stream then
      492       do:
      493         if p-append then
      494         do:
      495           output stream PrnLibStream to value( v-report-name )
      496             page-size value(p-page-size) append .
      497         end.
      498         if not p-append then
      499         do:
      500           output stream PrnLibStream to value( v-report-name )
      501             page-size value(p-page-size) .
      502         end.
      503       end.
      504       if not p-is-stream then
      505       do:
      506         if p-append then
      507         do:
      508           output to value( v-report-name )
      509             page-size value(p-page-size) append .
      510         end.
      511         if not p-append then
      512         do:
      513           output to value( v-report-name )
      514             page-size value(p-page-size) .
      515         end.
      516       end.
      517     end.
      518   end procedure.
      519   procedure prn-lib-open-exp :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-is-stream    as logical no-undo .
      522     define input parameter p-is-append    as logical no-undo .
      523     define output parameter p-ReportFileName as char init "report" no-undo.
      524     define output parameter p-process as logical no-undo .
      525     define variable glog as logical no-undo .
      526     do
      527       on error undo, return error
      528       :
      529       SYSTEM-DIALOG GET-FILE p-ReportFileName
      530         TITLE      "Укажите путь"
      531         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      532         ASK-OVERWRITE
      533         CREATE-TEST-FILE
      534         SAVE-AS
      535         USE-FILENAME
      536         DEFAULT-EXTENSION "txt"
      537         UPDATE glog
      538         .
      539       if not glog then  return.
      540       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      541       if p-is-stream then
      542       do:
      543         if p-is-append then
      544         do:
      545           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      546         end.
      547         else
      548         do:
      549           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      550         end.
      551       end.
      552       else
      553       do:
      554         if p-is-append then
      555         do:
      556           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      557         end.
      558         else
      559         do:
      560           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      561         end.
      562       end.
      563       p-process = yes.
      564     end.
      565   end procedure.
      566   procedure prn-lib-get-report-name :
      567     define input parameter parParentProc  as widget-handle no-undo.
      568     define output parameter p-report-name as character no-undo .
      569     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      570   end procedure.
      571   procedure prn-lib-reportviewer-report-name :
