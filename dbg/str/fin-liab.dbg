     3859      ub.fin-ob-before.doc-type      =     p-doc-type
     3860      ub.fin-ob-before.payer-name    =     p-payer-name
     3861      ub.fin-ob-before.receiver-name =     p-receiver-name
     3862      ub.fin-ob-before.curr-code     =     p-curr-code
     3863      ub.fin-ob-before.user-db-num-doc =   p-user-db-num-doc
     3864      ub.fin-ob-before.user-name-doc   =   p-user-name-doc
     3865      ub.fin-ob-before.base-rate     =     p-base-rate
     3866      ub.fin-ob-before.base-scale    =     p-base-scale
     3867      ub.fin-ob-before.receiver-code =     p-receiver-code
     3868      ub.fin-ob-before.receiver-type =     p-receiver-type
     3869      ub.fin-ob-before.contract-code =     p-contract-code
     3870      ub.fin-ob-before.exch-rate     =     p-exch-rate
     3871      ub.fin-ob-before.exch-scale    =     p-exch-scale
     3872      ub.fin-ob-before.contract-curr =     p-contract-curr
     3873      ub.fin-ob-before.contract-rate =     p-contract-rate
     3874      ub.fin-ob-before.contract-scale =    p-contract-scale
     3875      ub.fin-ob-before.fact-date     =     p-fact-date
     3876      ub.fin-ob-before.fact-order    =     p-fact-order
     3877      ub.fin-ob-before.host-code     =     p-host-code
     3878      ub.fin-ob-before.payer-code    =     p-payer-code
     3879      ub.fin-ob-before.payer-type    =     p-payer-type
     3880      ub.fin-ob-before.pay-date      =     p-pay-date
     3881      ub.fin-ob-before.prn-doc-code  =     p-prn-doc-code
     3882      ub.fin-ob-before.status_       =     p-status_
     3883      ub.fin-ob-before.sum-doc       =     p-sum-doc
     3884      ub.fin-ob-before.sum-base      =     p-sum-base
     3885      ub.fin-ob-before.sum-contract  =     p-sum-contract
     3886      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
     3887      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
     3888      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
     3889      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
     3890      ub.fin-ob-before.sum-tax-rubl  =     p-sum-tax-rubl
     3891      ub.fin-ob-before.sum-doc-orig  =     p-sum-doc-orig
     3892      ub.fin-ob-before.sum-rubl-orig =     p-sum-rubl-orig
     3893      ub.fin-ob-before.sum-base-orig =     p-sum-base-orig
     3894      ub.fin-ob-before.trn-doc-code  =     p-trn-doc-code
     3895      ub.fin-ob-before.trn-doc-code-orig  =     p-trn-doc-code-orig
     3896      ub.fin-ob-before.user-db-num-fact =  p-user-db-num-fact
     3897      ub.fin-ob-before.user-db-num-pay  =  p-user-db-num-pay
     3898      ub.fin-ob-before.user-name-fact   =  p-user-name-fact
     3899      ub.fin-ob-before.user-name-pay    =  p-user-name-pay
     3900      ub.fin-ob-before.in-type          =  p-in-type
     3901      ub.fin-ob-before.ps               =  p-ps
     3902     no-error .
     3903     if error-status :error then do:
     3904         message vss-include-info34 skip
     3905                 error-status :get-message(1)
     3906                 view-as alert-box error .
     3907         return error .
     3908     end.
     3909     p-rec-id = recid(fin-ob-before) .
     3910    end.
     3911   end procedure.
     3912   procedure make-tax :
     3913    do
     3914    on error undo, return error return-value
     3915    :
     3916   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     3917   define input parameter p-host-code as integer no-undo .
     3918   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     3919   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     3920   define buffer buf_fin-ob       for  ub.fin-ob     .
     3921   define variable v-line              as integer no-undo .
     3922   define variable v-sum               as decimal no-undo .
     3923   define variable v-sum-rubl          as decimal no-undo .
     3924   define variable v-sum-base          as decimal no-undo .
     3925   define variable v-sum-contract      as decimal no-undo .
     3926   define variable v-sum-slt           as decimal no-undo .
     3927   define variable v-sum-rubl-slt      as decimal no-undo .
     3928   define variable v-sum-base-slt      as decimal no-undo .
     3929   define variable v-sum-contract-slt  as decimal no-undo .
     3930   define variable v-sum-vat           as decimal no-undo .
     3931   define variable v-sum-rubl-vat      as decimal no-undo .
     3932   define variable v-sum-base-vat      as decimal no-undo .
     3933   define variable v-sum-contract-vat  as decimal no-undo .
     3934   define variable v-tax-sum           as decimal no-undo .
     3935   define variable v-tax-sum-rubl      as decimal no-undo .
     3936   define variable v-tax-sum-base      as decimal no-undo .
     3937   define variable v-tax-sum-contr     as decimal no-undo .
     3938   define variable v-tax-sum-doc       as decimal no-undo .
     3939   define variable var-doc             as decimal no-undo .
     3940   define variable var-doc-slt         as decimal no-undo .
     3941   define variable var-doc-vat         as decimal no-undo .
     3942   define variable v-basecode as integer no-undo .
     3943   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3945     (input  p-host-code
     3946     ,output v-basecode
     3947     )  .
     3948   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     3949                                               buf_fin-ob.doc-code  = p-doc-code
     3950                                               on error undo, return error :
     3951      assign
     3952       v-tax-sum-rubl  = 0
     3953       v-tax-sum-base  = 0
     3954       v-tax-sum-contr = 0
     3955       v-tax-sum-doc   = 0
     3956       v-sum           = 0
     3957       v-sum-rubl      = 0
     3958       v-sum-base      = 0
     3959       v-sum-contract  = 0
     3960       v-sum-vat       = 0
     3961       v-sum-rubl-vat  = 0
     3962       v-sum-base-vat  = 0
     3963       v-sum-contract-vat  = 0
     3964       v-sum-slt           = 0
     3965       v-sum-rubl-slt      = 0
     3966       v-sum-base-slt      = 0
     3967       v-sum-contract-slt  = 0
     3968       v-line = 0
     3969       .
     3970       for each buf_fin-gds-part no-lock where
     3971                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     3972                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     3973                break  by buf_fin-gds-part.SLT-pc
     3974                       by buf_fin-gds-part.vat-pc
     3975                on error undo, return error :
     3976                 case buf_fin-ob.curr-code:
     3977                   when 0 then do :
     3978                   assign
     3979                   var-doc      =  buf_fin-gds-part.sum-rubl
     3980                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
     3981                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
     3982                   .
     3983                   end.
     3984                   when v-basecode then do :
     3985                   assign
     3986                   var-doc      =  buf_fin-gds-part.sum-base
     3987                   var-doc-slt  =  buf_fin-gds-part.slt-base
     3988                   var-doc-vat  =  buf_fin-gds-part.vat-base
     3989                   .
     3990                   end.
     3991                   when buf_fin-ob.contract-curr then do :
     3992                   assign
     3993                   var-doc      =  buf_fin-gds-part.sum-contract
     3994                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     3995                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     3996                   .
     3997                   end.
     3998                 end case.
     3999                assign
     4000                  v-sum           = v-sum          + var-doc
     4001                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     4002                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     4003                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     4004                  v-sum-slt           = v-sum-slt          + var-doc-slt
     4005                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     4006                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     4007                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     4008                  v-sum-vat           = v-sum-vat          + var-doc-vat
     4009                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     4010                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     4011                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     4012                .
     4013                if last-of(buf_fin-gds-part.vat-pc) then do:
     4014                   v-line = v-line + 1.
     4015                   create buf_fin-ob-tax.
     4016                   assign
     4017                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     4018                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     4019                       buf_fin-ob-tax.line-num           = v-line
     4020                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     4021                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     4022                       buf_fin-ob-tax.with-slt           = true
     4023                       buf_fin-ob-tax.with-vat           = true
     4024                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     4025                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     4026                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     4027                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     4028                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     4029                       buf_fin-ob-tax.sum-line-doc        = v-sum
     4030                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     4031                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     4032                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     4033                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     4034                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     4035                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     4036                       .
     4037                       assign
     4038                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     4039                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     4040                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     4041                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     4042                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     4043                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     4044                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     4045                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     4046                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     4047                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     4048                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     4049                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     4050                       .
     4051                       assign
     4052                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     4053                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     4054                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     4055                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     4056                       .
     4057                       assign
     4058                       v-sum  = 0
     4059                       v-sum-rubl      = 0
     4060                       v-sum-base      = 0
     4061                       v-sum-contract  = 0
     4062                       v-sum-slt           =0
     4063                       v-sum-rubl-slt      =0
     4064                       v-sum-base-slt      =0
     4065                       v-sum-contract-slt  =0
     4066                       v-sum-vat           =0
     4067                       v-sum-rubl-vat      =0
     4068                       v-sum-base-vat      =0
     4069                       v-sum-contract-vat  =0
     4070                       .
     4071                 end.
     4072       end.
     4073       assign
     4074         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     4075         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     4076         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     4077         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     4078         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     4079         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     4080         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     4081         buf_fin-ob.base-scale       = 1
     4082         buf_fin-ob.exch-scale       = 1
     4083         buf_fin-ob.contract-scale   = 1
     4084       .
     4085       assign
     4086       v-tax-sum-rubl  = 0
     4087       v-tax-sum-base  = 0
     4088       v-tax-sum-contr = 0
     4089       v-tax-sum-doc   = 0
     4090       v-sum-vat          = 0
     4091       v-sum-rubl-vat     = 0
     4092       v-sum-base-vat     = 0
     4093       v-sum-contract-vat    = 0
     4094       v-sum-slt          = 0
     4095       v-sum-rubl-slt     = 0
     4096       v-sum-base-slt     = 0
     4097       v-sum-contract-slt    = 0
     4098       .
     4099   end.
     4100    end.
     4101   end procedure.
     4102   procedure update-fin-ob_obj :
     4103    do
     4104    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4105    :
     4106   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     4107   define input parameter p-host-code as integer no-undo .
     4108   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     4109   define buffer buf_fin-ob       for  ub.fin-ob     .
     4110   define variable v-obj-code as integer no-undo init 0 .
     4111   define variable v-obj-type as character no-undo init "" .
     4112   define variable var-fin-calc as integer no-undo .
     4113   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     4114   var-fin-calc = ub.sysconf.fin-calc   .
     4115   if var-fin-calc = 0 then return.
     4116   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     4117                                               buf_fin-ob.doc-code = p-doc-code
     4118                                               on error undo, return error :
     4119       for each buf_fin-gds-part no-lock where
     4120                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     4121                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     4122                on error undo, return error :
     4123             assign
     4124                v-obj-code  =  buf_fin-gds-part.obj-code
     4125                v-obj-type  =  buf_fin-gds-part.obj-type
     4126                .
     4127              leave.
     4128       end.
     4129       assign
     4130         buf_fin-ob.obj-code  =   v-obj-code
     4131         buf_fin-ob.obj-type  =   v-obj-type
     4132       .
     4133   end.
     4134    end.
     4135   end procedure.
     4136   procedure make-tax-rubl :
     4137    do
     4138    on error undo, return error return-value
     4139    :
     4140   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     4141   define input parameter p-host-code as integer no-undo .
     4142   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     4143   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     4144   define buffer buf_fin-ob       for  ub.fin-ob     .
     4145   define variable v-line    as integer no-undo .
     4146   define variable v-sum         as decimal no-undo .
     4147   define variable v-tax-sum       as decimal no-undo .
     4148   define variable v-tax-sum-rubl  as decimal no-undo .
     4149   define variable v-tax-sum-base  as decimal no-undo .
     4150   define variable v-tax-sum-contr as decimal no-undo .
     4151   define variable v-tax-sum-doc   as decimal no-undo .
     4152   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     4153                                               buf_fin-ob.doc-code = p-doc-code
     4154                                               on error undo, return error :
     4155      assign
     4156       v-tax-sum-rubl = 0
     4157       v-tax-sum-base = 0
     4158       v-tax-sum-contr = 0
     4159       v-tax-sum-doc  = 0
     4160       v-sum          = 0
     4161       v-line = 0
     4162       .
     4163       for each buf_fin-gds-part no-lock where
     4164                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     4165                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     4166                break  by buf_fin-gds-part.SLT-pc
     4167                       by buf_fin-gds-part.vat-pc
     4168                on error undo, return error :
     4169                assign
     4170                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     4171                .
     4172                if last-of(buf_fin-gds-part.vat-pc) then do:
     4173                   v-line = v-line + 1.
     4174                   create buf_fin-ob-tax.
     4175                   assign
     4176                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     4177                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     4178                       buf_fin-ob-tax.line-num           = v-line
     4179                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     4180                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     4181                       buf_fin-ob-tax.with-slt           = true
     4182                       buf_fin-ob-tax.with-vat           = true
     4183                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     4184                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     4185                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     4186                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     4187                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     4188                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     4189                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     4190                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     4191                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     4192                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     4193                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     4194                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     4195                       .
     4196                       assign
     4197                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     4198                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     4199                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     4200                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     4201                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     4202                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     4203                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     4204                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     4205                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     4206                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     4207                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
