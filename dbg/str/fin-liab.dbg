     5382           define variable v-help-old-y    as decimal       no-undo .
     5383           define variable v-help-old-size as decimal       no-undo .
     5384           define variable v-frame-width   as decimal       no-undo .
     5385           define variable jj              as integer       no-undo .
     5386           do
     5387               on error undo, return error
     5388               :
     5389               assign
     5390                   v-frame-width = frame Dialog-Frame:width - 0.3
     5391                   fh            = frame Dialog-Frame:first-child
     5392                   hh            = fh:first-child
     5393                   ii            = 1
     5394                   .
     5395               do while valid-handle(hh):
     5396                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5397                   do:
     5398                       case lc(hh:name) :
     5399                           when "b-help" then
     5400                               do:
     5401                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5402                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5403                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5404                                   hh:TOOLTIP = "Помощь" .
     5405                                   v-help-old-x = hh:column .
     5406                                   v-help-old-y = hh:row    .
     5407                                   v-help-old-size = hh:width .
     5408                                   hh:width-chars = 2.5 .
     5409                               end.
     5410                           when "b-print" then
     5411                               do:
     5412                                   hh:load-image("cmp/b-print.bmp":u) .
     5413                                   hh:TOOLTIP = "Печать" .
     5414                                   v-h[ii] = hh:handle .
     5415                                   ii = ii + 1 .
     5416                                   hh:width-chars = 3 .
     5417                               end.
     5418                           when "b-history" or
     5419                           when "b-hist" then
     5420                               do:
     5421                                   hh:load-image("cmp/b-hist.bmp":u) .
     5422                                   hh:TOOLTIP = "История" .
     5423                                   v-h[ii] = hh:handle .
     5424                                   ii = ii + 1 .
     5425                                   hh:width-chars = 3 .
     5426                               end.
     5427                           when "b-sch" then
     5428                               do:
     5429                                   hh:load-image("cmp/b-sch.bmp":u) .
     5430                                   hh:TOOLTIP = "Установка Фильтра" .
     5431                                   v-h[ii] = hh:handle .
     5432                                   ii = ii + 1 .
     5433                                   hh:width-chars = 3 .
     5434                               end.
     5435                           when "b-hist-user" then
     5436                               do:
     5437                                   hh:load-image("cmp/b-hist.bmp":u) .
     5438                                   hh:TOOLTIP = "История пользователя" .
     5439                                   ii = ii + 1 .
     5440                               end.
     5441                       end case.
     5442                   end.
     5443                   hh = hh:next-sibling.
     5444               end.
     5445               b-help:column = v-frame-width - b-help:width-chars.
     5446               jj = 0.
     5447               repeat ii = 4 to 1 by -1 :
     5448                   if valid-handle (v-h[ii] ) then
     5449                   do:
     5450                       jj  = jj + 1 .
     5451                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5452                       v-h[ii]:row    = v-help-old-y .
     5453                   end.
     5454               end.
     5455           end.
     5456       end.
     5457   end procedure.
     5458   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5459   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5460   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5461   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5462   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5463   define variable v-diasize-current-frame-height as decimal   no-undo .
     5464   define variable v-diasize-change-size          as logical   no-undo .
     5465   define variable v-diasize-resize-button        as handle    no-undo .
     5466   define variable v-diasize-wndmax               as logical   no-undo .
     5467   define variable v-diasize-wndstore             as logical   no-undo .
     5468   define variable v-diasize-proc-name            as character no-undo .
     5469   define variable v-diasize-browse-handle        as handle    no-undo .
     5470   define variable v-diasize-browse-number        as integer   no-undo .
     5471   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5472   define temp-table temp-diasize-handle no-undo
     5473     field handle-value  as handle
     5474     field save-position as decimal
     5475     index xpk is primary unique handle-value
     5476     .
     5477   define temp-table temp-browse-handle no-undo
     5478     field browse-type   as character
     5479     field browse-number as integer
     5480     field browse-handle as handle
     5481     field original-size as decimal
     5482     index xpk is primary unique browse-type browse-number
     5483     index xie browse-type browse-handle
     5484   .
     5485   procedure diasize_change-height :
     5486     define input  parameter p-change-value  as decimal   no-undo .
     5487     define input  parameter p-move-resize   as logical   no-undo .
     5488     define variable v-field-group-handle    as handle    no-undo .
     5489     define variable v-object-handle         as handle    no-undo .
     5490     define variable v-frame-height          as decimal   no-undo .
     5491     define variable v-frame-virtual-height  as decimal   no-undo .
     5492     define variable v-browse-height         as decimal   no-undo .
     5493     define variable v-window-height         as decimal   no-undo .
     5494     define variable v-window-virtual-height as decimal   no-undo .
     5495     define variable v-change-sign           as integer   no-undo .
     5496     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5497     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5498     if p-change-value > 0
     5499     then do:
     5500       if frame Dialog-Frame :height + p-change-value
     5501           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5502       then do:
     5503         assign
     5504           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5505                           - (frame Dialog-Frame :height-chars)
     5506         .
     5507         if p-change-value <= 0
     5508         then do:
     5509           run diasize_position-resize-button in this-procedure .
     5510           return .
     5511         end.
     5512       end.
     5513     end.
     5514     if p-change-value < 0
     5515     then do:
     5516       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     5517       then do:
     5518         assign
     5519           p-change-value = v-diasize-orig-frame-height
     5520                          - (frame Dialog-Frame :height-chars)
     5521         .
     5522         if p-change-value >= 0
     5523         then do:
     5524           run diasize_position-resize-button in this-procedure .
     5525           return .
     5526         end.
     5527       end.
     5528     end.
     5529     if p-change-value >= 0
     5530     then do:
     5531       assign
     5532         v-change-sign = 1
     5533       .
     5534     end.
     5535     else do:
     5536       assign
     5537         v-change-sign = -1
     5538       .
     5539     end.
     5540     assign
     5541       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5542     .
     5543     if p-change-value = 0
     5544     then do:
     5545       run diasize_position-resize-button in this-procedure .
     5546       return .
     5547     end.
     5548     move_block:
     5549     do
     5550     on error undo move_block, retry move_block
     5551     :
     5552       if retry
     5553       then do:
     5554         do
     5555         on error undo move_block, leave move_block
     5556         :
     5557           if p-change-value > 0
     5558           then do:
     5559             for each buf_temp-diasize-handle
     5560             on error undo, next
     5561             :
     5562               assign
     5563                 v-object-handle = buf_temp-diasize-handle.handle-value
     5564               .
     5565               if v-object-handle <> v-diasize-resize-button
     5566               then do:
     5567                 assign
     5568                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5569                 .
     5570               end.
     5571             end.
     5572             assign
     5573               v-diasize-browse-handle :height = v-browse-height
     5574             .
     5575             for each buf_temp-browse-handle
     5576               where buf_temp-browse-handle.browse-type = 'height':u
     5577             on error undo, next
     5578             :
     5579               assign
     5580                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5581               .
     5582             end.
     5583             assign
     5584               frame Dialog-Frame :height = v-frame-height
     5585             .
     5586             if frame Dialog-Frame :scrollable = true
     5587             then do:
     5588               assign
     5589                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     5590               .
     5591             end.
     5592             run diasize_position-resize-button in this-procedure .
     5593           end.
     5594           else do:
     5595             if frame Dialog-Frame :scrollable = true
     5596             then do:
     5597               assign
     5598                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     5599               .
     5600             end.
     5601             assign
     5602               frame Dialog-Frame :height = v-frame-height
     5603             .
     5604             assign
     5605               v-diasize-browse-handle :height = v-browse-height
     5606             .
     5607             for each buf_temp-browse-handle
     5608               where buf_temp-browse-handle.browse-type = 'height':u
     5609             on error undo, next
     5610             :
     5611               assign
     5612                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5613               .
     5614             end.
     5615             for each buf_temp-diasize-handle
     5616             on error undo, next
     5617             :
     5618               assign
     5619                 v-object-handle = buf_temp-diasize-handle.handle-value
     5620               .
     5621               if v-object-handle <> v-diasize-resize-button
     5622               then do:
     5623                 assign
     5624                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5625                 .
     5626               end.
     5627             end.
     5628             run diasize_position-resize-button in this-procedure .
     5629           end.
     5630           assign
     5631             v-diasize-change-size = false
     5632           .
     5633           leave move_block .
     5634         end.
     5635       end.
     5636       assign
     5637         v-diasize-need-full-display = true
     5638       .
     5639       if v-diasize-change-size = false
     5640       then do:
     5641         assign
     5642           v-diasize-change-size = true
     5643         .
     5644       end.
     5645       else do:
     5646         return .
     5647       end.
     5648       assign
     5649         v-frame-height = frame Dialog-Frame :height
     5650         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     5651         v-browse-height = v-diasize-browse-handle :height
     5652       .
     5653       for each buf_temp-browse-handle
     5654         where buf_temp-browse-handle.browse-type = 'height':u
     5655       :
     5656         assign
     5657           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     5658         .
     5659       end.
     5660       for each buf_temp-diasize-handle
     5661       :
     5662         delete buf_temp-diasize-handle .
     5663       end.
     5664       assign
     5665         v-field-group-handle = frame Dialog-Frame :first-child
     5666       .
     5667       do while valid-handle(v-field-group-handle)
     5668       :
     5669         assign
     5670           v-object-handle = v-field-group-handle :first-child
     5671         .
     5672         do while valid-handle(v-object-handle)
     5673         :
     5674           if  v-object-handle <> v-diasize-browse-handle :handle
     5675           and can-query(v-object-handle, "row")
     5676           and can-query(v-object-handle, "height")
     5677           and ( v-object-handle :row > v-diasize-browse-handle :row )
     5678           then do:
     5679             find first buf_temp-browse-handle
     5680               where buf_temp-browse-handle.browse-type   = 'height':u
     5681                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5682               no-error .
     5683             if available buf_temp-browse-handle
     5684             then do:
     5685             end.
     5686             else do:
     5687               create buf_temp-diasize-handle .
     5688               assign
     5689                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5690                 buf_temp-diasize-handle.save-position = v-object-handle :row
     5691               .
     5692             end.
     5693           end.
     5694           assign
     5695             v-object-handle = v-object-handle :next-sibling
     5696           .
     5697         end.
     5698         assign
     5699           v-field-group-handle = v-field-group-handle :next-sibling
     5700         .
     5701       end.
     5702       do with frame Dialog-Frame
     5703       :
     5704         hide v-diasize-resize-button .
     5705         assign
     5706           v-diasize-resize-button :row    = 1
     5707           v-diasize-resize-button :column = 1
     5708         .
     5709       end.
     5710       if p-change-value > 0
     5711       then do:
     5712         if frame Dialog-Frame :scrollable = true
     5713         then do:
     5714           assign
     5715             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     5716             no-error .
     5717           if error-status :error
     5718           or error-status :get-message(1) <> ""
     5719           then do:
     5720             undo move_block, retry move_block .
     5721           end.
     5722         end.
     5723         assign
     5724           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5725           no-error .
     5726         if error-status :error
     5727         or error-status :get-message(1) <> ""
     5728         then do:
     5729           undo move_block, retry move_block .
     5730         end.
     5731         assign
     5732           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5733           no-error .
     5734         if error-status :error
     5735         or error-status :get-message(1) <> ""
     5736         then do:
     5737           undo move_block, retry move_block .
     5738         end.
     5739         for each buf_temp-browse-handle
     5740           where buf_temp-browse-handle.browse-type = 'height':u
     5741         on error undo move_block, retry move_block
     5742         :
     5743           assign
     5744             buf_temp-browse-handle.browse-handle :height
     5745               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5746             no-error .
     5747           if error-status :error
     5748           or error-status :get-message(1) <> ""
     5749           then do:
     5750             undo move_block, retry move_block .
     5751           end.
     5752         end.
     5753         for each buf_temp-diasize-handle
     5754         on error undo move_block, retry move_block
     5755         :
     5756           assign
     5757             v-object-handle = buf_temp-diasize-handle.handle-value
     5758           .
     5759           if v-object-handle <> v-diasize-resize-button
     5760           then do:
     5761             assign
     5762               v-object-handle :row = v-object-handle :row + p-change-value
     5763               no-error .
     5764             if error-status :error
     5765             or error-status :get-message(1) <> ""
     5766             then do:
     5767               undo move_block, retry move_block .
     5768             end.
     5769           end.
     5770         end.
     5771       end.
     5772       else do:
     5773         for each buf_temp-diasize-handle
     5774         on error undo move_block, retry move_block
     5775         :
     5776           assign
     5777             v-object-handle = buf_temp-diasize-handle.handle-value
     5778           .
     5779           if v-object-handle <> v-diasize-resize-button
     5780           then do:
     5781             assign
     5782               v-object-handle :row = v-object-handle :row + p-change-value
     5783               no-error .
     5784             if error-status :error
     5785             or error-status :get-message(1) <> ""
     5786             then do:
     5787               undo move_block, retry move_block .
     5788             end.
     5789           end.
     5790         end.
     5791         assign
     5792           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     5793           no-error .
     5794         if error-status :error
     5795         or error-status :get-message(1) <> ""
     5796         then do:
     5797           undo move_block, retry move_block .
     5798         end.
     5799         for each buf_temp-browse-handle
     5800           where buf_temp-browse-handle.browse-type = 'height':u
     5801         on error undo move_block, retry move_block
     5802         :
     5803           assign
     5804             buf_temp-browse-handle.browse-handle :height
     5805               = buf_temp-browse-handle.browse-handle :height + p-change-value
     5806             no-error .
     5807           if error-status :error
     5808           or error-status :get-message(1) <> ""
     5809           then do:
     5810             undo move_block, retry move_block .
     5811           end.
     5812         end.
     5813         assign
     5814           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     5815           no-error .
     5816         if error-status :error
     5817         or error-status :get-message(1) <> ""
     5818         then do:
     5819           undo move_block, retry move_block .
     5820         end.
     5821         if frame Dialog-Frame :scrollable = true
     5822         then do:
     5823           assign
     5824             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     5825             no-error .
     5826           if error-status :error
     5827           or error-status :get-message(1) <> ""
     5828           then do:
     5829             undo move_block, retry move_block .
     5830           end.
     5831         end.
     5832       end.
     5833       if p-move-resize = true
     5834       then do:
     5835         run diasize_position-resize-button in this-procedure .
     5836       end.
     5837       if v-diasize-wndstore = true
     5838       then do:
     5839         if connected("ub") = true
     5840         then do:
     5841           define variable v-cntxt-db-num        as integer   no-undo .
     5842           define variable v-cntxt-userid        as character no-undo .
     5843           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5844                                             , OUTPUT v-cntxt-userid
     5845                                             ) .
     5846           run gbl/wndsizew.p
     5847             (input  v-cntxt-db-num
     5848             ,input  v-cntxt-userid
     5849             ,input  v-diasize-proc-name
     5850             ,input  'height':u
     5851             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     5852             ) .
     5853         end.
     5854       end.
     5855     end.
     5856     assign
     5857       v-diasize-change-size = false
     5858     .
     5859   end procedure.
     5860   procedure diasize_set-height :
     5861     define input  parameter p-new-height  as decimal   no-undo .
     5862     define input  parameter p-move-resize as logical   no-undo .
     5863     do
     5864     on error undo, return error return-value
     5865     :
     5866       run diasize_change-height in this-procedure
     5867         (input  (p-new-height - frame Dialog-Frame :height)
     5868         ,input  p-move-resize
     5869         ) .
     5870     end.
     5871   end procedure.
     5872   procedure diasize_change-width :
     5873     define input  parameter p-change-value as decimal   no-undo .
     5874     define input  parameter p-move-resize  as logical   no-undo .
     5875     define variable v-field-group-handle   as handle    no-undo .
     5876     define variable v-object-handle        as handle    no-undo .
     5877     define variable v-frame-width          as decimal   no-undo .
     5878     define variable v-frame-virtual-width  as decimal   no-undo .
     5879     define variable v-browse-width         as decimal   no-undo .
     5880     define variable v-window-width         as decimal   no-undo .
     5881     define variable v-window-virtual-width as decimal   no-undo .
     5882     define variable v-change-sign          as integer   no-undo .
     5883     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5884     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5885     if p-change-value > 0
     5886     then do:
     5887       if frame Dialog-Frame :width + p-change-value >
     5888           session :width-chars
     5889       then do:
     5890         assign
     5891           p-change-value = session :width-chars - frame Dialog-Frame :width
     5892         .
     5893         if p-change-value <= 0
     5894         then do:
     5895           run diasize_position-resize-button in this-procedure .
     5896           return .
     5897         end.
     5898       end.
     5899     end.
     5900     if p-change-value < 0
     5901     then do:
     5902       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5903       then do:
     5904         assign
     5905           p-change-value = v-diasize-orig-frame-width
     5906                          - frame Dialog-Frame :width
     5907         .
     5908         if p-change-value >= 0
     5909         then do:
     5910           run diasize_position-resize-button in this-procedure .
     5911           return .
     5912         end.
     5913       end.
     5914     end.
     5915     if p-change-value >= 0
     5916     then do:
     5917       assign
     5918         v-change-sign = 1
     5919       .
     5920     end.
     5921     else do:
     5922       assign
     5923         v-change-sign = -1
     5924       .
     5925     end.
     5926     assign
     5927       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5928     .
     5929     if p-change-value = 0
     5930     then do:
     5931       run diasize_position-resize-button in this-procedure .
     5932       return .
     5933     end.
     5934     move_block:
     5935     do
     5936     on error undo move_block, leave move_block
     5937     :
     5938       if retry
     5939       then do:
     5940         do
     5941         on error undo move_block, leave move_block
     5942         :
     5943           if p-change-value > 0
     5944           then do:
     5945             for each buf_temp-diasize-handle
     5946             on error undo, next
     5947             :
     5948               assign
     5949                 v-object-handle = buf_temp-diasize-handle.handle-value
     5950               .
     5951               if v-object-handle <> v-diasize-resize-button
     5952               then do:
     5953                 assign
     5954                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5955                 .
     5956               end.
     5957             end.
     5958             assign
     5959               v-diasize-browse-handle :width = v-browse-width
     5960             .
     5961             for each buf_temp-browse-handle
     5962               where buf_temp-browse-handle.browse-type = 'width':u
     5963             on error undo, next
     5964             :
     5965               assign
     5966                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5967               .
     5968             end.
     5969             assign
     5970               frame Dialog-Frame :width = v-frame-width
     5971             .
     5972             if frame Dialog-Frame :scrollable = true
     5973             then do:
     5974               assign
     5975                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5976               .
     5977             end.
     5978             run diasize_position-resize-button in this-procedure .
     5979           end.
     5980           else do:
     5981             if frame Dialog-Frame :scrollable = true
     5982             then do:
     5983               assign
     5984                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5985               .
     5986             end.
     5987             assign
     5988               frame Dialog-Frame :width = v-frame-width
     5989             .
     5990             for each buf_temp-browse-handle
     5991               where buf_temp-browse-handle.browse-type = 'width':u
     5992             on error undo, next
     5993             :
     5994               assign
     5995                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5996               .
     5997             end.
     5998             assign
     5999               v-diasize-browse-handle :width = v-browse-width
     6000             .
     6001             for each buf_temp-diasize-handle
     6002             on error undo, next
     6003             :
     6004               assign
     6005                 v-object-handle = buf_temp-diasize-handle.handle-value
     6006               .
     6007               if v-object-handle <> v-diasize-resize-button
     6008               then do:
     6009                 assign
     6010                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6011                 .
     6012               end.
     6013             end.
     6014             run diasize_position-resize-button in this-procedure .
     6015           end.
     6016           assign
     6017             v-diasize-change-size = false
     6018           .
     6019           leave move_block .
     6020         end.
     6021       end.
     6022       assign
     6023         v-diasize-need-full-display = true
     6024       .
     6025       if v-diasize-change-size = false
     6026       then do:
     6027         assign
     6028           v-diasize-change-size = true
     6029         .
     6030       end.
     6031       else do:
     6032         return .
     6033       end.
     6034       assign
     6035         v-frame-width = frame Dialog-Frame :width
     6036         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     6037         v-browse-width = v-diasize-browse-handle :width
     6038       .
     6039       for each buf_temp-browse-handle
     6040         where buf_temp-browse-handle.browse-type = 'width':u
     6041       :
     6042         assign
     6043           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6044         .
     6045       end.
     6046       for each buf_temp-diasize-handle
     6047       :
     6048         delete buf_temp-diasize-handle .
     6049       end.
     6050       assign
     6051         v-field-group-handle = frame Dialog-Frame :first-child
     6052       .
     6053       do while valid-handle(v-field-group-handle)
     6054       :
     6055         assign
     6056           v-object-handle = v-field-group-handle :first-child
     6057         .
     6058         do while valid-handle(v-object-handle)
     6059         :
     6060           if  v-object-handle <> v-diasize-browse-handle :handle
     6061           and v-object-handle <> v-diasize-resize-button
     6062           and can-query(v-object-handle, "row")
     6063           and can-query(v-object-handle, "height")
     6064           and ( v-object-handle :col + v-object-handle :width
     6065                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6066               )
     6067           then do:
     6068             find first buf_temp-browse-handle
     6069               where buf_temp-browse-handle.browse-type   = 'width':u
     6070                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6071               no-error .
     6072             if available buf_temp-browse-handle
     6073             then do:
     6074             end.
     6075             else do:
     6076               create buf_temp-diasize-handle .
     6077               assign
     6078                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6079                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6080               .
     6081             end.
     6082           end.
     6083           assign
     6084             v-object-handle = v-object-handle :next-sibling
     6085           .
     6086         end.
     6087         assign
     6088           v-field-group-handle = v-field-group-handle :next-sibling
     6089         .
     6090       end.
     6091       do with frame Dialog-Frame
     6092       :
     6093         hide v-diasize-resize-button .
     6094         v-diasize-resize-button :row = 1.
     6095         v-diasize-resize-button :column = 1.
     6096       end.
     6097       if p-change-value > 0
     6098       then do:
     6099         if frame Dialog-Frame :scrollable = true
     6100         then do:
     6101           assign
     6102             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6103             no-error .
     6104           if error-status :error
     6105           or error-status :get-message(1) <> ""
     6106           then do:
     6107             undo move_block, retry move_block.
     6108           end.
     6109         end.
     6110         assign
     6111           frame Dialog-Frame :width = v-frame-width + p-change-value
     6112           no-error .
     6113         if error-status :error
     6114         or error-status :get-message(1) <> ""
     6115         then do:
     6116           undo move_block, retry move_block.
     6117         end.
     6118         assign
     6119           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6120         no-error .
     6121         if error-status :error
     6122         or error-status :get-message(1) <> ""
     6123         then do:
     6124           undo move_block, retry move_block.
     6125         end.
     6126         for each buf_temp-browse-handle
     6127           where buf_temp-browse-handle.browse-type = 'width':u
     6128         on error undo move_block, retry move_block
     6129         :
     6130           assign
     6131             buf_temp-browse-handle.browse-handle :width
     6132               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6133             no-error .
     6134           if error-status :error
     6135           or error-status :get-message(1) <> ""
     6136           then do:
     6137             undo move_block, retry move_block .
     6138           end.
     6139         end.
     6140         for each buf_temp-diasize-handle
     6141         on error undo move_block, retry move_block
     6142         :
     6143           assign
     6144             v-object-handle = buf_temp-diasize-handle.handle-value
     6145           .
     6146           if v-object-handle <> v-diasize-resize-button
     6147           then do:
     6148             assign
     6149               v-object-handle :col = v-object-handle :col + p-change-value
     6150               no-error .
     6151             if error-status :error
     6152             or error-status :get-message(1) <> ""
     6153             then do:
     6154               undo move_block, retry move_block .
     6155             end.
     6156           end.
     6157         end.
     6158       end.
     6159       else do:
     6160         for each buf_temp-diasize-handle
     6161         on error undo move_block, retry move_block
     6162         :
     6163           assign
     6164             v-object-handle = buf_temp-diasize-handle.handle-value
     6165           .
     6166           if v-object-handle <> v-diasize-resize-button
     6167           then do:
     6168             assign
     6169               v-object-handle :col = v-object-handle :col + p-change-value
     6170               no-error .
     6171             if error-status :error
     6172             or error-status :get-message(1) <> ""
     6173             then do:
     6174               undo move_block, retry move_block .
     6175             end.
     6176           end.
     6177         end.
     6178         for each buf_temp-browse-handle
     6179           where buf_temp-browse-handle.browse-type = 'width':u
     6180         on error undo move_block, retry move_block
     6181         :
     6182           assign
     6183             buf_temp-browse-handle.browse-handle :width
     6184               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6185             no-error .
     6186           if error-status :error
     6187           or error-status :get-message(1) <> ""
     6188           then do:
     6189             undo move_block, retry move_block .
     6190           end.
     6191         end.
     6192         assign
     6193           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6194           no-error .
     6195         if error-status :error
     6196         or error-status :get-message(1) <> ""
     6197         then do:
     6198           undo move_block, retry move_block.
     6199         end.
     6200         assign
     6201           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     6202         no-error .
     6203         if error-status :error
     6204         or error-status :get-message(1) <> ""
     6205         then do:
     6206           undo move_block, retry move_block.
     6207         end.
     6208         if frame Dialog-Frame :scrollable = true
     6209         then do:
     6210           assign
     6211             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6212           no-error .
     6213           if error-status :error
     6214           or error-status :get-message(1) <> ""
     6215           then do:
     6216             undo move_block, retry move_block.
     6217           end.
     6218         end.
     6219       end.
     6220       if p-move-resize
     6221       then do:
     6222         run diasize_position-resize-button in this-procedure .
     6223       end.
     6224       if v-diasize-wndstore = true
     6225       then do:
     6226         if connected("ub") = true
     6227         then do:
     6228           define variable v-cntxt-db-num        as integer   no-undo .
     6229           define variable v-cntxt-userid        as character no-undo .
     6230           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6231                                             , OUTPUT v-cntxt-userid
     6232                                             ) .
     6233           run gbl/wndsizew.p
     6234             (input  v-cntxt-db-num
     6235             ,input  v-cntxt-userid
     6236             ,input  v-diasize-proc-name
     6237             ,input  'width':u
     6238             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     6239             ) .
     6240         end.
     6241       end.
     6242     end.
     6243     assign
     6244       v-diasize-change-size = false
     6245     .
     6246   end procedure.
     6247   procedure diasize_set-width :
     6248     define input  parameter p-new-width  as decimal   no-undo .
     6249     define input  parameter p-move-resize as logical   no-undo .
     6250     do
     6251     on error undo, return error return-value
     6252     :
     6253       run diasize_change-width in this-procedure
     6254         (input  (p-new-width - frame Dialog-Frame :width)
     6255         ,input  p-move-resize
     6256         ) .
     6257     end.
     6258   end procedure.
     6259   procedure diasize_position-resize-button :
     6260     do with frame Dialog-Frame
     6261     :
     6262       hide v-diasize-resize-button .
     6263       assign
     6264         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     6265                     - 1
     6266                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     6267         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     6268                     - 1
     6269                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     6270       .
     6271       view v-diasize-resize-button .
     6272     end.
     6273   end procedure.
     6274   on alt-right anywhere
     6275   do:
     6276     run diasize_change-width in this-procedure
     6277       (input 1
     6278       ,input true
     6279       ) .
     6280     return no-apply .
     6281   end.
     6282   on alt-left anywhere
     6283   do:
     6284     run diasize_change-width in this-procedure
     6285       (input -1
     6286       ,input true
     6287       ) .
     6288     return no-apply .
     6289   end.
     6290   on alt-down anywhere
     6291   do:
     6292     run diasize_change-height in this-procedure
     6293       (input 1
     6294       ,input true
     6295       ) .
     6296     return no-apply .
     6297   end.
     6298   on alt-up anywhere
     6299   do:
     6300     run diasize_change-height in this-procedure
     6301       (input -1
     6302       ,input true
     6303       ) .
     6304     return no-apply .
     6305   end.
     6306   on alt-enter of frame Dialog-Frame
     6307   do:
     6308     run diasize_maximize in this-procedure
     6309       (input  ?
     6310       ).
     6311     return no-apply .
     6312   end.
     6313   procedure diasize_end-move :
     6314     do
     6315     on error undo, return error return-value
     6316     :
     6317       define variable v-row-delta as decimal   no-undo .
     6318       define variable v-col-delta as decimal   no-undo .
     6319       define variable v-new-row as decimal   no-undo .
     6320       define variable v-new-col as decimal   no-undo .
     6321       assign
     6322         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6323         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6324       .
     6325       assign
     6326         v-row-delta = v-new-row - frame Dialog-Frame :height
     6327         v-col-delta = v-new-col - frame Dialog-Frame :width
     6328       .
     6329       run diasize_change-height in this-procedure
     6330         (input v-row-delta
     6331         ,input true
     6332         ) .
     6333       run diasize_change-width in this-procedure
     6334         (input v-col-delta
     6335         ,input true
     6336         ) .
     6337     end.
     6338   end procedure.
     6339   procedure diasize_maximize :
     6340     define input  parameter p-action as logical   no-undo .
     6341     do
     6342     on error undo, return error return-value
     6343     :
     6344       if p-action = ?
     6345       then do:
     6346         if v-diasize-need-maximize = true
     6347         then do:
     6348           assign
     6349             p-action = true
     6350           .
     6351         end.
     6352         else do:
     6353           assign
     6354             p-action = false
     6355           .
     6356         end.
     6357       end.
     6358       if p-action = true
     6359       then do:
     6360         run diasize_change-height in this-procedure
     6361           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6362               - frame Dialog-Frame :height-chars
     6363           ,input true
     6364           ) .
     6365         run diasize_change-width in this-procedure
     6366           (input session :width-chars
     6367               - frame Dialog-Frame :width-chars
     6368           ,input true
     6369           ) .
     6370         assign
     6371           v-diasize-need-maximize = false
     6372         .
     6373       end.
     6374       else do:
     6375         run diasize_change-width in this-procedure
     6376           (input v-diasize-orig-frame-width
     6377               - frame Dialog-Frame :width-chars
     6378           ,input true
     6379           ) .
     6380         run diasize_change-height in this-procedure
     6381           (input v-diasize-orig-frame-height
     6382               - frame Dialog-Frame :height-chars
     6383           ,input true
     6384           ) .
     6385         assign
     6386           v-diasize-need-maximize = true
     6387         .
     6388       end.
     6389     end.
     6390   end procedure.
     6391   procedure diasize_restore-orig-size :
     6392     do
     6393     on error undo, return error return-value
     6394     :
     6395       assign
     6396         v-diasize-current-frame-width  = frame Dialog-Frame :width
     6397         v-diasize-current-frame-height = frame Dialog-Frame :height
     6398       .
     6399       run diasize_set-height in this-procedure
     6400         (input  v-diasize-orig-frame-height
     6401         ,input  true
     6402         ) .
     6403       run diasize_set-width in this-procedure
     6404         (input  v-diasize-orig-frame-width
     6405         ,input  true
     6406         ) .
     6407     end.
     6408   end procedure.
     6409   procedure diasize_restore-current-size :
     6410     do
     6411     on error undo, return error return-value
     6412     :
     6413       run diasize_set-height in this-procedure
     6414         (input  v-diasize-current-frame-height
     6415         ,input  true
     6416         ) .
     6417       run diasize_set-width in this-procedure
     6418         (input  v-diasize-current-frame-width
     6419         ,input  true
     6420         ) .
     6421     end.
     6422   end procedure.
     6423   procedure diasize_set-browse-handle :
     6424     define input  parameter p-browse-handle as handle   no-undo .
     6425     define buffer buf_temp-browse-handle for temp-browse-handle .
     6426     do
     6427     on error undo, return error return-value
     6428     :
     6429       assign
     6430         v-diasize-browse-handle = p-browse-handle
     6431       .
     6432       for each buf_temp-browse-handle
     6433       on error undo, return error return-value
     6434       :
     6435         delete buf_temp-browse-handle .
     6436       end.
     6437     end.
     6438   end procedure.
     6439   procedure diasize_add_browse :
     6440     define input  parameter p-browse-type   as character no-undo .
     6441     define input  parameter p-browse-handle as handle    no-undo .
     6442     define buffer buf_temp-browse-handle for temp-browse-handle .
     6443     do
     6444     on error undo, return error return-value
     6445     :
     6446       assign
     6447         v-diasize-browse-number = v-diasize-browse-number + 1
     6448       .
     6449       create buf_temp-browse-handle .
     6450       assign
     6451         buf_temp-browse-handle.browse-type   = p-browse-type
     6452         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6453         buf_temp-browse-handle.browse-handle = p-browse-handle
     6454       .
     6455     end.
     6456   end procedure.
     6457   procedure diasize_init :
     6458     define variable v-default-value    as logical   no-undo .
     6459     define variable v-restore-saved    as logical   no-undo .
     6460     define variable v-resize-value-str as character no-undo .
     6461     do
     6462     on error undo, return error return-value
     6463     :
     6464       do with frame Dialog-Frame
     6465       :
     6466         assign
     6467           v-diasize-orig-frame-height = frame Dialog-Frame :height
     6468           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     6469           v-diasize-browse-handle     = browse BR-docs :handle
     6470         .
     6471         create button v-diasize-resize-button
     6472         assign
     6473           parent        = frame Dialog-Frame :first-child
     6474           label         = "s"
     6475           height-pixels = 16
     6476           width-pixels  = 16
     6477           visible       = true
     6478           sensitive     = true
     6479           movable       = true
     6480           triggers:
     6481             on end-move persistent run diasize_end-move in this-procedure .
     6482           end triggers.
     6483         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6484         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6485         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6486         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6487         assign
     6488           v-diasize-wndmax = false
     6489         .
     6490         if connected("ub") = true
     6491         then do:
     6492           define variable v-cntxt-db-num        as integer   no-undo .
     6493           define variable v-cntxt-userid        as character no-undo .
     6494           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6495                                             , OUTPUT v-cntxt-userid
     6496                                             ) .
     6497           run gbl/wndpar_r.p
     6498             (input  v-cntxt-db-num
     6499             ,input  v-cntxt-userid
     6500             ,input  'wndmax':U
     6501             ,output v-diasize-wndmax
     6502             ,output v-default-value
     6503             ) .
     6504         end.
     6505         assign
     6506           v-diasize-wndstore = false
     6507         .
     6508         if connected("ub") = true
     6509         then do:
     6510           run gbl/wndpar_r.p
     6511             (input  v-cntxt-db-num
     6512             ,input  v-cntxt-userid
     6513             ,input  'wndstore':U
     6514             ,output v-diasize-wndstore
     6515             ,output v-default-value
     6516             ) .
     6517         end.
     6518         assign
     6519           v-diasize-proc-name = entry(1, program-name(2), '.')
     6520         .
     6521         if v-diasize-wndstore = true
     6522         then do:
     6523           assign
     6524             v-restore-saved = false
     6525           .
     6526           if connected("ub") = true
     6527           then do:
     6528             run gbl/wndsizer.p
     6529               (input  v-cntxt-db-num
     6530               ,input  v-cntxt-userid
     6531               ,input  v-diasize-proc-name
     6532               ,input  'height':u
     6533               ,output v-resize-value-str
     6534               ) .
     6535             if v-resize-value-str <> '':U
     6536             then do:
     6537               run diasize_change-height in this-procedure
     6538                 (input  integer(v-resize-value-str)
     6539                 ,input  true
     6540                 ) .
     6541               assign
     6542                 v-restore-saved = true
     6543               .
     6544             end.
     6545           end.
     6546           if connected("ub") = true
     6547           then do:
     6548             run gbl/wndsizer.p
     6549               (input  v-cntxt-db-num
     6550               ,input  v-cntxt-userid
     6551               ,input  v-diasize-proc-name
     6552               ,input  'width':u
     6553               ,output v-resize-value-str
     6554               ) .
     6555             if v-resize-value-str <> '':U
     6556             then do:
     6557               run diasize_change-width in this-procedure
     6558                 (input  integer(v-resize-value-str)
     6559                 ,input  true
     6560                 ) .
     6561               assign
     6562                 v-restore-saved = true
     6563               .
     6564             end.
     6565           end.
     6566           if v-restore-saved <> true
     6567           then do:
     6568             if v-diasize-wndmax = true
     6569             then do:
     6570               run diasize_maximize in this-procedure
     6571                 (input  true
     6572                 ) .
     6573             end.
     6574           end.
     6575         end.
     6576         else do:
     6577           if v-diasize-wndmax = true
     6578           then do:
     6579             run diasize_maximize in this-procedure
     6580               (input  true
     6581               ) .
     6582           end.
     6583         end.
     6584       end.
     6585     end.
     6586   end procedure.
     6587   procedure diasize_need-full-display :
     6588     define output parameter p-need-full-display as logical   no-undo .
     6589     do
     6590     on error undo, return error return-value
     6591     :
     6592       assign
     6593         p-need-full-display = v-diasize-need-full-display
     6594       .
     6595       assign
     6596         v-diasize-need-full-display = false
     6597       .
     6598     end.
     6599   end procedure.
     6600   procedure get-context :
     6601      define output parameter p-db-num as integer          no-undo.
     6602      define output parameter p-user-id as character        no-undo.
     6603      define variable v-login               as character    no-undo.
     6604      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     6605      define buffer buf_user-login  for ub.user-login .
     6606      do
     6607      on error undo, return error
     6608      :
     6609            FIND FIRST buf_sys-ctrl no-lock.
     6610            ASSIGN
     6611               v-login = USERID("ub")
     6612               p-db-num = buf_sys-ctrl.db-num
     6613            .
     6614            FIND FIRST buf_user-login
     6615                 WHERE buf_user-login.db-num = p-db-num
     6616                   AND buf_user-login.user-login = v-login
     6617                 no-lock
     6618                 no-error
     6619                 .
     6620            IF AVAILABLE buf_user-login
     6621            THEN DO:
     6622               assign
     6623                  p-user-id = buf_user-login.user-id
     6624               .
     6625            END.
     6626      end.
     6627   end procedure.
     6628       run diasize_init in this-procedure .
     6629   def var sort-labelBR-docs   as character no-undo .
     6630   def var sort-clmnBR-docs    as handle    no-undo .
     6631   def var cur-clmnBR-docs     as handle    no-undo .
     6632   def var cur-clmn-locBR-docs as integer   no-undo .
     6633   def var re-queryBR-docs     as logical   initial no no-undo .
     6634   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     6635      run sort-brBR-docs
     6636        (input (if available ub.fin-ob
     6637                then recid(ub.fin-ob)
     6638                else ?
     6639               )
     6640        ).
     6641   end.
     6642   PROCEDURE sort-brBR-docs :
     6643     define input parameter p-recid as recid no-undo .
     6644     if re-queryBR-docs = no then do:
     6645       assign
     6646          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     6647       .
     6648       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     6649       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     6650         assign
     6651            sort-labelBR-docs = ""
     6652            sort-clmnBR-docs = ?
     6653         .
     6654        end.
     6655        else do:
     6656          assign
     6657            sort-labelBR-docs = cur-clmnBR-docs:label
     6658            sort-clmnBR-docs  = cur-clmnBR-docs
     6659            sort-clmnBR-docs:column-fgcolor = 4
     6660          .
     6661        end.
     6662      end.
     6663     assign
     6664       cur-clmn-locBR-docs = 1
     6665     .
     6666     def var column-handle as handle no-undo .
     6667     column-handle = BR-docs:first-column.
     6668     do while valid-handle(column-handle) :
     6669       if column-handle = cur-clmnBR-docs then do:
     6670         leave .
     6671       end.
     6672       column-handle = column-handle:NEXT-COLUMN.
     6673       assign
     6674         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     6675       .
     6676     end.
     6677     case sort-labelBR-docs:
     6678           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_fin-liab), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     6679           when 'Статус'  then DO:    assign       sort-column-name = "buf_fin-liab.status_"     .     run OpenBr (yes, no, '':U).   . END.
     6680           when '№ док-та'  then DO:    assign       sort-column-name = "buf_fin-liab.prn-doc-code"     .     run OpenBr (yes, no, '':U).   . END.
     6681           when 'Создан'  then DO:    assign       sort-column-name = "buf_fin-liab.doc-date"     .     run OpenBr (yes, no, '':U).   . END.
     6682           when 'Закрыт'  then DO:    assign       sort-column-name = "buf_fin-liab.fact-date"     .     run OpenBr (yes, no, '':U).   . END.
     6683           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-id&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     6684           when 'Получатель'  then DO:    assign       sort-column-name = "buf_fin-liab.receiver-name"     .     run OpenBr (yes, no, '':U).   . END.
     6685           when 'Плательщик'  then DO:    assign       sort-column-name = "buf_fin-liab.payer-name"     .     run OpenBr (yes, no, '':U).   . END.
     6686           when 'Платеж'  then DO:    assign       sort-column-name = "buf_fin-liab.pay-date"     .     run OpenBr (yes, no, '':U).   . END.
     6687           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1val-abbr-type&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     6688           when 'Сумма в валюте!док-та'  then DO:    assign       sort-column-name = "buf_fin-liab.sum-doc"     .     run OpenBr (yes, no, '':U).   . END.
     6689           when 'Внутр.№'  then DO:    assign       sort-column-name = "buf_fin-liab.doc-code"     .     run OpenBr (yes, no, '':U).   . END.
     6690           when 'Тип'  then DO:    assign       sort-column-name = "buf_fin-liab.doc-type"     .     run OpenBr (yes, no, '':U).   . END.
     6691           when 'Непогаш.задолж!(руб.)'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1debts&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     6692           when 'Объект'  then DO:    assign       sort-column-name = "buf_fin-liab.obj-code"     .     run OpenBr (yes, no, '':U).   . END.
     6693           when 'Наименование'  then DO:    assign       sort-column-name = "buf_fin-liab.receiver-name"     .     run OpenBr (yes, no, '':U).   . END.
     6694           when 'Условие генерации'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-gen&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     6695           when 'Счет-фактура'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-factur&1, recid(buf_fin-liab))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     6696       otherwise do:
     6697         assign
     6698           sort-column-name = ""
     6699         .
     6700         run OpenBr (yes, no, '':U).
     6701           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-docs') then do:
     6702             run mv-brw-defaultBR-docs.
     6703           end.
     6704         if sort-labelBR-docs <> "" then do:
     6705           assign
     6706             cur-clmnBR-docs:column-fgcolor = 0
     6707           .
     6708         end.
     6709         assign
     6710           cur-clmn-locBR-docs = ?
     6711         .
     6712       end.
     6713     end case.
     6714       if cur-clmn-locBR-docs <> ? then do:
     6715         if can-do( this-procedure:internal-entries, 'ch-clmnBR-docs') then do:
     6716           run ch-clmnBR-docs in this-procedure (cur-clmn-locBR-docs).
     6717         end.
     6718       end.
     6719     if p-recid <> ? then do:
     6720       reposition BR-docs to recid p-recid no-error.
     6721       apply "value-changed" to BR-docs in frame Dialog-Frame.
     6722     end.
     6723     apply "entry" to BR-docs in frame Dialog-Frame.
     6724   END PROCEDURE.
     6725   procedure re-open-query-srt-clmnBR-docs:
     6726   if cur-clmnBR-docs = ? then do:
     6727      run OpenBr (yes, no, '':U).
     6728   end.
     6729   else do:
     6730      assign re-queryBR-docs = yes.
     6731      run sort-brBR-docs
     6732        (input (if available ub.fin-ob
     6733                then recid(ub.fin-ob)
     6734                else ?
     6735               )
     6736        ).
     6737      assign re-queryBR-docs = no.
     6738   end.
     6739   end.
     6740   MAIN-BLOCK:
     6741   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6742      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6743     find first ub.sysconf no-lock where ub.sysconf.host-code = par-host-code no-error .
     6744     var-fin-calc = ub.sysconf.fin-calc   .
     6745   buf_fin-liab.receiver-name:resizable in browse BR-docs   = true .
     6746   p-gen:resizable                      in browse BR-docs   = true .
     6747   buf_fin-liab.sum-doc:resizable in browse BR-docs   = true .
     6748   p-contr:resizable              in browse BR-docs   = true .
     6749   buf_fin-liab.status_:resizable in browse BR-docs   = true .
     6750   buf_fin-liab.receiver-name:width     in browse BR-docs   = v-size-col1 .
     6751   p-gen:width                          in browse BR-docs   = v-size-col2 .
     6752   buf_fin-liab.sum-doc:width     in browse BR-docs   = v-size-col3 .
     6753   p-contr:width                  in browse BR-docs   = v-size-col4 .
     6754   buf_fin-liab.status_:width     in browse BR-docs   = v-size-col5 .
     6755   buf_fin-liab.status_:read-only in browse BR-docs = true .
     6756    if var-fin-calc = 0 then
     6757       p-obj:visible in browse BR-docs = false .
     6758   define variable p-file-label as character no-undo .
     6759   p-file-label =  "Финансовые обязательства".
     6760   r-abbr  =  "РУБ".
     6761   define buffer buf_clients for  ub.clients .
     6762   CASE par-mode:
     6763       WHEN 'фирма':U THEN DO:
     6764         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     6765         if not available buf_clients then  return .
     6766       END.
     6767       WHEN "doc-type":U THEN DO:
     6768         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     6769         if not available buf_clients then  return .
     6770           if p-char <> "" then do:
     6771               assign
     6772               r-31 = 2
     6773               r-32 = 1
     6774               d-2 = 2
     6775               v-date-pay-1 = 01/01/91
     6776               v-date-pay-2 = date(p-char).
     6777           end.
     6778       END.
     6779       WHEN "status":U THEN DO:
     6780         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     6781         if not available buf_clients then  return .
     6782       END.
     6783       WHEN "contract":U THEN DO:
     6784       end.
     6785       otherwise do:
     6786         message vss-workfile vss-revision vss-description skip
     6787         "Неверный вызов - par-mode=" par-mode
     6788         view-as alert-box ERROR.
     6789         return.
     6790       end.
     6791     end CASE.
     6792       if pardoc-rec <> ? then do:
     6793         FIND FIRST find_code No-LOCK where
     6794                    recid(find_code) = pardoc-rec No-ERROR.
     6795         if not avail find_code then do:
     6796           message
     6797           vss-workfile vss-revision vss-description skip
     6798           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     6799           view-as alert-box error .
     6800           return error.
     6801         end.
     6802         doc-rec = pardoc-rec.
     6803       end.
     6804     run my-enable_UI in this-procedure .
     6805     r-1 = 1 .
     6806     r-2 = 1 .
     6807     r-3 = 1 .
     6808     FIND FIRST buf_contract no-lock  no-error .
     6809   if available buf_contract then do:
     6810           CREATE xx-contract.
     6811           BUFFER-COPY buf_contract TO xx-contract  .
     6812       end.
     6813       else  do:
     6814         CREATE xx-contract.
     6815         assign
     6816           xx-contract.contract-code = 1
     6817           xx-contract.host-code = 1
     6818         .
     6819       end.
     6820     run OpenBR in this-procedure (yes, no, '':U).
     6821   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6822   DEF VAR cur-clmn-numBR-docs as INT EXTENT 19 no-undo.
     6823   DEF VAR varmviBR-docs       as INT no-undo.
     6824   DEF VAR varmvjBR-docs       as INT no-undo.
     6825   DEF VAR varmvkBR-docs       as INT no-undo.
     6826   DEF VAR varmvlBR-docs       as INT no-undo.
     6827   DEF VAR move-elementBR-docs as INT no-undo.
     6828   def var jjBR-docs           as int no-undo.
     6829   do varmviBR-docs = 1 to EXTENT(cur-clmn-numBR-docs):
     6830     ASSIGN cur-clmn-numBR-docs[varmviBR-docs] = varmviBR-docs.
     6831   END.
     6832   RUN start-mv-clmnBR-docs.
     6833   PROCEDURE start-mv-clmnBR-docs:
     6834   def var old-session as logical no-undo.
     6835      old-session = SESSION:IMMEDIATE-DISPLAY.
     6836      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     6837          IF  true = true   THEN DO:
     6838      DO jjBR-docs = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     6839        RUN re-move-clmnBR-docs ( cur-clmn-numBR-docs[INTEGER(ENTRY (jjBR-docs, v-order-col))] , 4).
     6840      END.
     6841          END.
     6842      SESSION:IMMEDIATE-DISPLAY = old-session.
     6843   END.
     6844   ON ctrl-cursor-right OF BROWSE BR-docs do:
     6845     RUN re-move-clmnBR-docs ( 4, 19).
     6846   END.
     6847   ON ctrl-cursor-left OF BROWSE BR-docs do:
     6848     RUN re-move-clmnBR-docs (19, 4).
     6849   END.
     6850   PROCEDURE re-move-clmnBR-docs:
     6851     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     6852     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     6853     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     6854       if cur-clmn-numBR-docs[varmviBR-docs] = source-column THEN cur-clmn-numBR-docs[varmviBR-docs] = -1.
     6855     END.
     6856     if BR-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     6857     if source-column > target-column THEN
     6858     DO varmvjBR-docs = source-column - 1 to target-column BY -1:
     6859       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     6860           if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     6861             cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] + 1.
     6862           END.
     6863       END.
     6864     END.
     6865     ELSE
     6866     DO varmvjBR-docs = source-column + 1 to target-column:
     6867       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     6868         if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     6869           cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] - 1.
     6870         END.
     6871       END.
     6872     END.
     6873     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     6874       if cur-clmn-numBR-docs[varmviBR-docs] = -1 THEN cur-clmn-numBR-docs[varmviBR-docs] = target-column.
     6875     END.
     6876   END PROCEDURE.
     6877   PROCEDURE ch-clmnBR-docs:
     6878     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     6879     if cur-clmn-loc <= 4 then do:
     6880       return .
     6881     end.
     6882     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     6883       if cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-loc THEN move-elementBR-docs = varmviBR-docs.
     6884     END.
     6885     RUN re-move-clmnBR-docs (cur-clmn-loc, 4).
     6886   END PROCEDURE.
     6887   PROCEDURE mv-brw-defaultBR-docs:
     6888   def var old-session as logical no-undo.
     6889     old-session = SESSION:IMMEDIATE-DISPLAY.
     6890     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     6891     do varmvlBR-docs = 4 to EXTENT(cur-clmn-numBR-docs):
     6892       RUN re-move-clmnBR-docs (cur-clmn-numBR-docs[varmvlBR-docs], varmvlBR-docs).
     6893     END.
     6894     RUN start-mv-clmnBR-docs.
     6895     SESSION:IMMEDIATE-DISPLAY = old-session.
     6896   END PROCEDURE.
     6897   .
     6898     hide mark-num in frame Dialog-Frame .
     6899     if pardoc-rec <> ? then
     6900        reposition br-docs to recid doc-rec no-error.
     6901     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     6902     WAIT-FOR GO OF FRAME Dialog-Frame focus br-docs.
     6903   END.
     6904   run disable_UI in this-procedure .
     6905   PROCEDURE add-proc :
     6906   define variable v-doc-rec as recid no-undo .
     6907   if  p-doc-type = ?   then do:
     6908     message  "Добавление финансовых обязательств возможно только  по типам !" view-as alert-box information .
     6909     return .
     6910   end.
     6911   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6912   do:
     6913     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6914       (input  v-cntxt-db-num
     6915       ,input  v-cntxt-userid
     6916       ,input  0
     6917       ,input  'actn_fin-liability_add-def':U
     6918       ,input  'firm':U
     6919       ,input  par-host-code
     6920       ,input  '':U
     6921       ,input  0
     6922       ,input  0
     6923       ,input  0
     6924       ,input  0
     6925       ,input  true
     6926       ,output g-log
     6927       )  .
     6928   end.
     6929   if not g-log then  return .
     6930   define variable rr as recid no-undo .
     6931     run str/fi-liabi.w ( parParentProc, 'ДОБАВЛЕНИЕ':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
     6932     v-doc-rec = rr .
     6933     run OpenBr in this-procedure (yes, no, '':U).
     6934     reposition br-docs to recid v-doc-rec no-error .
     6935     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     6936   END PROCEDURE.
     6937   PROCEDURE disable_UI :
     6938     HIDE FRAME Dialog-Frame.
     6939   END PROCEDURE.
     6940   PROCEDURE enable_UI :
     6941     DISPLAY R-1 R-2 v-date-doc-1 v-date-pay-1 R-3 v-date-doc-2 v-date-pay-2
     6942             sch-code p-desc p-date T-paket FILL-IN-20 FILL-IN-21 FILL-IN-22
     6943             FILL-IN-24 FILL-IN-26 s-name FILL-IN-1 loc_receiver-name loc_sum-doc
     6944             d-abbr loc_user-name loc_payer-name loc_sum-rubl r-abbr loc_sum-base
     6945             v-abbr mark-num loc_sum-contr v-abbr-contr
     6946         WITH FRAME Dialog-Frame.
     6947     ENABLE B-exit RECT-1 B-sel B-close B-Export b-fact B-trn B-parts B-PFO B-Help
     6948            B-sch B-History B-mark B-add B-lkp B-chg B-del b-exec-fo b-exec-pay
     6949            B-print R-1 R-2 v-date-doc-1 v-date-pay-1 R-3 v-date-doc-2
     6950            v-date-pay-2 B-reopen-br sch-code p-desc p-date BR-docs T-paket
     6951            FILL-IN-20 FILL-IN-21 FILL-IN-22 FILL-IN-24 FILL-IN-26 s-name
     6952            FILL-IN-1 loc_receiver-name loc_sum-doc d-abbr loc_user-name
     6953            loc_payer-name loc_sum-rubl r-abbr loc_sum-base v-abbr mark-num
     6954            loc_sum-contr v-abbr-contr
     6955         WITH FRAME Dialog-Frame.
     6956     VIEW FRAME Dialog-Frame.
     6957     OPEN QUERY BR-docs FOR EACH buf_fin-liab  NO-LOCK ,        FIRST xx-contract .
     6958   END PROCEDURE.
     6959   PROCEDURE my-enable_UI :
     6960   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6961   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6962     (input  par-host-code
     6963     ,output p-base-code
     6964     )  .
     6965   assign
     6966   loc_sum-rubl:label in frame Dialog-Frame = "Сумма руб."
     6967   .
     6968   DISPLAY sch-code p-desc   p-date mark-num FILL-IN-1 FILL-IN-20 FILL-IN-21 FILL-IN-22 FILL-IN-24
     6969        FILL-IN-26
     6970         WITH FRAME Dialog-Frame.
     6971     ENABLE B-exit
     6972            B-lkp
     6973            B-add       when LOOKUP("b-add":U,  bttns) > 0
     6974            B-chg       when LOOKUP("b-chg":U,  bttns) > 0
     6975            b-exec-fo   when LOOKUP("b-exec-fo":U,  bttns) > 0
     6976            B-Export
     6977            B-close
     6978            B-PFO       when LOOKUP("no-B-PFO":U,  bttns) = 0
     6979            B-History
     6980            b-trn
     6981            b-parts
     6982            B-sch
     6983            B-print
     6984            B-Help
