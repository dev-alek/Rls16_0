     3487   ON VALUE-CHANGED OF T-paket IN FRAME Dialog-Frame
     3488   DO:
     3489     assign T-paket.
     3490     rid-list = "" .
     3491     g-log = br-docs:SELECT-ROW(1) no-error  .
     3492     if error-status :get-message(1) = "" then
     3493        g-log = br-docs:refresh()  .
     3494     IF t-paket= TRUE THEN DO:
     3495         ENABLE B-close
     3496                B-del
     3497                B-lkp when LOOKUP("b-lkp":U,  bttns) > 0
     3498                B-mark
     3499                with frame Dialog-Frame .
     3500         disable
     3501            B-add     when LOOKUP("b-add":U,  bttns) > 0
     3502            B-chg     when LOOKUP("b-chg":U,  bttns) > 0
     3503            B-sel     when LOOKUP("b-sel":U,  bttns) > 0
     3504            b-exec-fo
     3505            B-History
     3506            B-parts
     3507            B-PFO
     3508            B-print
     3509            B-trn
     3510         with frame Dialog-Frame .
     3511     END.
     3512     ELSE DO:
     3513         disable
     3514                B-mark when LOOKUP("b-mark":U,  bttns) = 0
     3515                with frame Dialog-Frame .
     3516         enable
     3517            B-add     when LOOKUP("b-add":U,  bttns) > 0
     3518            B-chg     when LOOKUP("b-chg":U,  bttns) > 0
     3519            B-sel     when LOOKUP("b-sel":U,  bttns) > 0
     3520            b-exec-fo when LOOKUP("b-exec-fo":U,  bttns) > 0
     3521            B-History
     3522            B-parts
     3523            B-PFO
     3524            B-print
     3525            B-trn
     3526         with frame Dialog-Frame .
     3527     END.
     3528   END.
