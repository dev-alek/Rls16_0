     2972             rr = rr + 1.
     2973           end.
     2974       end.
     2975     end.
     2976     else do:
     2977           find current buf_fin-liab  exclusive-lock  no-error .
     2978           v-recid = recid ( buf_fin-liab ) .
     2979           if available buf_fin-liab then do:
     2980              delete buf_fin-liab  .
     2981           end.
     2982      end.
     2983       define variable g#log as logical no-undo .
