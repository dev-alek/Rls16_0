     9779     v-num-entry31 = lookup( v-str-recid31 , v-rid-list )
     9780   .
     9781   if v-num-entry31 > 0 then do:
     9782     assign
     9783       entry( v-num-entry31, v-rid-list ) = "":U
     9784       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     9785     .
     9786   end.
     9787   else do:
     9788     assign
     9789       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid31
     9790     .
     9791   end.
     9792             loc#log = br-utd:refresh() .
     9793         end.
     9794     end.
     9795   END.
