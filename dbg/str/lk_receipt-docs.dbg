      293   procedure thobjs :
      294      define input        parameter parparentproc     as widget-handle no-undo .
      295      define input        parameter i-bttns           as character     no-undo .
      296      define input        parameter i-list-mode       as character     no-undo.
      297      define input        parameter i-obj-type        as character     no-undo.
      298      define input        parameter i-db-num          as integer       no-undo.
      299      define input        parameter i-host-code       as integer       no-undo.
