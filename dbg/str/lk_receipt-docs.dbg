     8649     .
     8650   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8651   procedure ext-system-attr-code :
     8652     define input  parameter p-code           as character no-undo .
     8653     define output parameter p-type           as character no-undo .
     8654     define output parameter p-format         as character no-undo .
     8655     define output parameter p-label          as character no-undo .
     8656     define output parameter p-user-can-edit  as logical   no-undo .
     8657     define output parameter p-output-display as logical   no-undo .
     8658     define output parameter p-other          as character no-undo .
     8659     do
     8660     on error undo, return error
     8661     :
     8662           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
     8663         (input  p-code
     8664         ,output p-type
     8665         ,output p-format
     8666         ,output p-label
     8667         ,output p-user-can-edit
     8668         ,output p-output-display
     8669         ,output p-other
     8670         ) no-error .
     8671       if error-status :error
     8672       then do:
     8673         undo, return error return-value .
     8674       end.
     8675     end.
     8676   end procedure.
     8677   procedure ext-system-attr-tooltip :
     8678     define input  parameter p-code    as character no-undo .
     8679     define output parameter p-tooltip as character no-undo .
     8680     define output parameter p-label   as character no-undo .
     8681     do
     8682     on error undo, return error
     8683     :
