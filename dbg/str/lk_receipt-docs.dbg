     1769   procedure xmlchar-encode :
     1770   define input parameter p-in-string      as character        no-undo.
     1771   define output parameter p-out-string    as character        no-undo.
     1772       define variable v-position      as integer      no-undo.
     1773       define variable v-current-char  as character    no-undo.
     1774   do
     1775   on error undo, return error
     1776   :
     1777       assign
     1778           p-out-string = "":U
     1779       .
     1780       case p-in-string
     1781       :
     1782           when ?
     1783           then do:
     1784               assign
     1785                   p-out-string = "?":U
     1786               .
     1787           end.
     1788           when "?":U
     1789           then do:
     1790               assign
     1791                   p-out-string = "&#63;":U
     1792               .
     1793           end.
     1794           otherwise do:
     1795               do v-position = 1 to length( p-in-string )
     1796               :
     1797                   assign
     1798                       v-current-char = substring( p-in-string, v-position, 1 )
     1799                   .
     1800                   case v-current-char
     1801                   :
     1802                       when "&":U
     1803                       then do:
     1804                           assign
     1805                               p-out-string = p-out-string + "&amp;":U
     1806                           .
     1807                       end.
     1808                       when ">":U
     1809                       then do:
     1810                           assign
     1811                               p-out-string = p-out-string + "&gt;":U
     1812                           .
     1813                       end.
     1814                       when "<":U
     1815                       then do:
     1816                           assign
     1817                               p-out-string = p-out-string + "&lt;":U
     1818                           .
     1819                       end.
     1820                       when "'":U
     1821                       then do:
     1822                           assign
     1823                               p-out-string = p-out-string + "&apos;":U
     1824                           .
     1825                       end.
     1826                       when '"':U
     1827                       then do:
     1828                           assign
     1829                               p-out-string = p-out-string + "&quot;":U
     1830                           .
     1831                       end.
     1832                       when chr(1)
     1833                       then do:
     1834                           assign
     1835                               p-out-string = p-out-string + "":U
     1836                           .
     1837                       end.
     1838                       when chr(2)
     1839                       then do:
     1840                           assign
     1841                               p-out-string = p-out-string + "":U
     1842                           .
     1843                       end.
     1844                       when chr(3)
     1845                       then do:
     1846                           assign
     1847                               p-out-string = p-out-string + "":U
     1848                           .
     1849                       end.
     1850                       when chr(4)
     1851                       then do:
     1852                           assign
     1853                               p-out-string = p-out-string + "":U
     1854                           .
     1855                       end.
     1856                       when chr(5)
     1857                       then do:
     1858                           assign
     1859                               p-out-string = p-out-string + "":U
     1860                           .
     1861                       end.
     1862                       when chr(6)
     1863                       then do:
     1864                           assign
     1865                               p-out-string = p-out-string + "":U
     1866                           .
     1867                       end.
     1868                       when chr(7)
     1869                       then do:
     1870                           assign
     1871                               p-out-string = p-out-string + "":U
     1872                           .
     1873                       end.
     1874                       when chr(8)
     1875                       then do:
     1876                           assign
     1877                               p-out-string = p-out-string + "":U
     1878                           .
     1879                       end.
     1880                       when chr(9)
     1881                       then do:
     1882                           assign
     1883                               p-out-string = p-out-string + "":U
     1884                           .
     1885                       end.
     1886                       when chr(29)
     1887                       then do:
     1888                           assign
     1889                               p-out-string = p-out-string + "":U
     1890                           .
     1891                       end.
     1892                       when chr(10)
     1893                       then do:
     1894                           assign
     1895                               p-out-string = p-out-string + "&#10;":U
     1896                           .
     1897                       end.
     1898                       when chr(13)
     1899                       then do:
     1900                           assign
     1901                               p-out-string = p-out-string + "&#13;":U
     1902                           .
     1903                       end.
     1904                       otherwise do:
     1905                           assign
     1906                               p-out-string = p-out-string + v-current-char
     1907                           .
     1908                       end.
     1909                   end case.
     1910               end.
     1911           end.
     1912       end case.
     1913   end.
     1914   end .
     1915   procedure xmlchar-encode-1c :
     1916   define input parameter p-in-string      as character        no-undo.
     1917   define output parameter p-out-string    as character        no-undo.
     1918       define variable v-position      as integer      no-undo.
     1919       define variable v-current-char  as character    no-undo.
     1920   do
     1921   on error undo, return error
     1922   :
     1923       assign
     1924           p-out-string = "":U
     1925       .
     1926       case p-in-string
     1927       :
     1928           when ?
     1929           then do:
     1930               assign
     1931                   p-out-string = "?":U
     1932               .
     1933           end.
     1934           otherwise do:
     1935               do v-position = 1 to length( p-in-string )
     1936               :
     1937                   assign
     1938                       v-current-char = substring( p-in-string, v-position, 1 )
     1939                   .
     1940                   case v-current-char
     1941                   :
     1942                       when chr(1)
     1943                       then do:
