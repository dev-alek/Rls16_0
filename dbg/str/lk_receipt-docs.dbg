     9220   DEFINE BROWSE br-utd
     9221     QUERY br-utd NO-LOCK DISPLAY
     9222         mark-string(recid(X_utd), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     9223         X_utd.DocumentNumber COLUMN-LABEL "Номер!документа" FORMAT "x(16)":U
     9224         doc-type(X_utd.doc-code) COLUMN-LABEL "Тип" FORMAT "X(15)":U
     9225         X_utd.DocumentDate COLUMN-LABEL "Дата документа" FORMAT "99/99/9999":U
     9226         X_utd.stts COLUMN-LABEL "Статус ТН" FORMAT "X(44)":U
     9227         X_utd.LoadDate COLUMN-LABEL "Дата загрузки" FORMAT "99/99/9999":U
     9228         X_utd.DocumentExt COLUMN-LABEL "ID документа" FORMAT "x(50)":U
     9229               WIDTH 40.6
     9230     enable
     9231         X_utd.DocumentExt
     9232       WITH NO-ROW-MARKERS SEPARATORS SIZE 131 BY 14.95 FIT-LAST-COLUMN.
     9233   DEFINE FRAME d-utd
     9234        b-exit AT ROW 1 COL 1.6
     9235        b-utd AT ROW 1 COL 12 WIDGET-ID 230
     9236        b-trn-doc at row 1 col 22.4
     9237        B-refresh AT ROW 1 COL 100 WIDGET-ID 286
     9238        b-print AT ROW 1 COL 126.2 WIDGET-ID 62
     9239        b-errors at row 1 col 110
     9240        b-hist AT ROW 1 COL 129 WIDGET-ID 64
     9241        F-date-to AT ROW 2.29 COL 13.6 COLON-ALIGNED WIDGET-ID 238
     9242        F-date-from AT ROW 2.29 COL 28 COLON-ALIGNED NO-LABEL WIDGET-ID 36
     9243        F-sertif AT ROW 2.29 COL 78.6 COLON-ALIGNED WIDGET-ID 232 NO-TAB-STOP
     9244        b-choose-sertif AT ROW 2.29 COL 121.8 WIDGET-ID 234
     9245        R-obj AT ROW 3.52 COL 11.6 NO-LABEL WIDGET-ID 290
     9246        obj-list AT ROW 3.52 COL 47.4 RIGHT-ALIGNED NO-LABEL WIDGET-ID 30
     9247        bt-sel-obj AT ROW 3.52 COL 48.4 WIDGET-ID 28
     9248        c-status AT ROW 3.52 COL 74 COLON-ALIGNED WIDGET-ID 228
     9249        bt-not-sel-all AT ROW 4.76 COL 2.6 WIDGET-ID 10 NO-TAB-STOP
     9250        bt-not-sel-desel-all AT ROW 4.76 COL 5.6 WIDGET-ID 12 NO-TAB-STOP
     9251        b-mark AT ROW 4.76 COL 8.6 WIDGET-ID 4 NO-TAB-STOP
     9252        br-utd AT ROW 6.05 COL 1.6
     9253        B-write-sertif AT ROW 21.5 COL 2 WIDGET-ID 236
     9254        b-comment at row 21.5 col 30 WIDGET-ID 220
     9255        "Объекты:" VIEW-AS TEXT
     9256             SIZE 8 BY .67 AT ROW 3.71 COL 2.6 WIDGET-ID 296
     9257        "по" VIEW-AS TEXT
     9258             SIZE 2.6 BY .67 AT ROW 2.48 COL 27 WIDGET-ID 38
     9259        SPACE(102.99) SKIP(19.84)
     9260       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     9261            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     9262            TITLE "Список документов Вывода из оборота (ОСУ)":L.
     9263   ASSIGN
     9264          FRAME d-utd:SCROLLABLE       = FALSE.
     9265   ASSIGN
     9266          br-utd:COLUMN-RESIZABLE IN FRAME d-utd       = TRUE.
     9267   ON GO OF FRAME d-utd
     9268   DO:
     9269   END.
     9270   ON CHOOSE OF b-errors IN FRAME d-utd
     9271   DO:
     9272     if available X_utd
     9273     then do :
     9274       run ref/dialog-error.w (input X_utd.db-num, input X_utd.doc-id, input "" , input 0) .
     9275     end .
     9276   END.
     9277   ON CHOOSE OF b-comment IN FRAME d-utd
     9278   DO:
     9279     if available X_utd
     9280     then do :
     9281       row_utd = rowid (X_utd) .
     9282       run str/LK_RECEIPT-comment.w (input X_utd.db-num, input X_utd.doc-id) .
     9283       run init-sort in this-procedure .
     9284       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK INDEXED-REPOSITION.
     9285       br-utd:refresh ().
     9286       reposition br-utd to rowid row_utd no-error .
     9287       apply "value-changed" to br-utd IN FRAME d-utd.
     9288     end .
     9289   END.
     9290   ON CHOOSE OF b-choose-sertif IN FRAME d-utd
     9291   DO:
     9292       run str/sertif.w (input parparentproc,
     9293           output v-sertif_num
     9294           ) no-error .
     9295       F-sertif = v-sertif_num .
     9296       if f-sertif <> "" then
     9297       do:
     9298         enable B-write-sertif with frame d-utd .
     9299       end.
     9300       else
     9301       do:
     9302         disable B-write-sertif with frame d-utd .
     9303       end.
     9304       display
     9305           F-sertif
     9306           with frame d-utd .
     9307   END.
     9308   ON CHOOSE OF b-exit IN FRAME d-utd
     9309   DO:
     9310     if v-current-sort-string <> "" then
     9311     do:
     9312       c-status = string(entry(1,v-current-sort-string,chr(3))) .
     9313     end.
     9314     v-current-sort-string = c-status .
     9315     v-current-sertif-string = v-sertif_num.
     9316     run uf-set(
     9317         input 'LK_RECEIPT':U
     9318           , input v-cntxt-userid
     9319           , input v-current-sertif-string
     9320           , input v-current-sort-string
     9321           , input no
     9322           , input no
     9323           , input no
     9324           , input no
     9325           ) no-error.
     9326     assign
     9327       mflagExit = yes
     9328     .
     9329   END.
     9330   ON choose OF b-hist IN FRAME d-utd
     9331   DO:
     9332     define variable v-rid-list_ as character no-undo.
     9333     if available (X_utd) then
     9334     do:
     9335       row_utd = rowid (X_utd) .
     9336       run ref/cutdhist.w (
     9337           X_utd.db-num,
     9338           X_utd.doc-id,
     9339           parparentproc,
     9340           0,
     9341           "",
     9342           0,
     9343           "",
     9344           "one",
     9345           ?,
     9346           "",
     9347           "" ,
     9348           v-cntxt-db-num,
     9349           ?,
     9350           input-output v-rid-list_ ) .
     9351       br-utd:refresh ().
     9352       reposition br-utd to rowid row_utd.
     9353     end.
     9354   END.
     9355   ON CHOOSE OF b-mark IN FRAME d-utd
     9356   DO:
     9357     define variable loc#log as logical no-undo .
     9358     if available X_utd then
     9359     do:
     9360   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9361   define variable v-str-recid24 as character no-undo .
     9362   define variable v-num-entry24 as integer   no-undo .
     9363   assign
     9364     v-str-recid24 = trim( string( recid( X_utd ) , "->>>>>>>>>>>9":U ) )
     9365     v-num-entry24 = lookup( v-str-recid24 , v-rid-list )
     9366   .
     9367   if v-num-entry24 > 0 then do:
     9368     assign
     9369       entry( v-num-entry24, v-rid-list ) = "":U
     9370       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     9371     .
     9372   end.
     9373   else do:
     9374     assign
     9375       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid24
     9376     .
     9377   end.
     9378       row_utd = rowid(X_utd).
     9379       loc#log = br-utd:refresh() .
     9380       reposition br-utd to rowid row_utd.
     9381       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     9382       do:
     9383         loc#log = br-utd:select-next-row ().
     9384         apply "VALUE-CHANGED" to br-utd in frame d-utd.
     9385       end.
     9386     end.
     9387     apply "entry" to br-utd in frame d-utd.
     9388   END.
     9389   ON choose OF b-trn-doc IN FRAME d-utd
     9390   DO:
     9391     define variable g-log as logical no-undo.
     9392     if available (x_utd) then
     9393     do:
     9394       find first trn-doc where trn-doc.doc-code = x_utd.doc-code no-lock no-error.
     9395       if not available trn-doc then do:
     9396         message "Не найден документ для просмотра" view-as alert-box.
     9397         return no-apply .
     9398       end.
     9399       case trn-doc.doc-type
     9400       :
     9401         when 'при':U
     9402         then do:
     9403   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9404   do:
     9405     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9406       (input  v-cntxt-db-num
     9407       ,input  v-cntxt-userid
     9408       ,input  0
     9409       ,input  'actn_income_lookup':U
     9410       ,input  'object':U
     9411       ,input  trn-doc.host-code
     9412       ,input  trn-doc.obj-type
     9413       ,input  trn-doc.obj-code
     9414       ,input  0
     9415       ,input  0
     9416       ,input  0
     9417       ,input  true
     9418       ,output g-log
     9419       )  .
     9420   end.
     9421         end.
     9422         when 'рас':U
     9423         then do:
     9424   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9425   do:
     9426     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9427       (input  v-cntxt-db-num
     9428       ,input  v-cntxt-userid
     9429       ,input  0
     9430       ,input  'actn_expense_lookup':U
     9431       ,input  'object':U
     9432       ,input  trn-doc.host-code
     9433       ,input  trn-doc.obj-type
     9434       ,input  trn-doc.obj-code
     9435       ,input  0
     9436       ,input  0
     9437       ,input  0
     9438       ,input  true
     9439       ,output g-log
     9440       )  .
     9441   end.
     9442         end.
     9443         when 'спи':U
     9444         then do:
     9445   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9446   do:
     9447     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9448       (input  v-cntxt-db-num
     9449       ,input  v-cntxt-userid
     9450       ,input  0
     9451       ,input  'actn_write-off_lookup':U
     9452       ,input  'object':U
     9453       ,input  trn-doc.host-code
     9454       ,input  trn-doc.obj-type
     9455       ,input  trn-doc.obj-code
     9456       ,input  0
     9457       ,input  0
     9458       ,input  0
     9459       ,input  true
     9460       ,output g-log
     9461       )  .
     9462   end.
     9463         end.
     9464         when 'инв':U
     9465         then do:
     9466   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9467   do:
     9468     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9469       (input  v-cntxt-db-num
     9470       ,input  v-cntxt-userid
     9471       ,input  0
     9472       ,input  'actn_inventory_lookup':U
     9473       ,input  'object':U
     9474       ,input  trn-doc.host-code
     9475       ,input  trn-doc.obj-type
     9476       ,input  trn-doc.obj-code
     9477       ,input  0
     9478       ,input  0
     9479       ,input  0
     9480       ,input  true
     9481       ,output g-log
     9482       )  .
     9483   end.
     9484         end.
     9485         when 'возврат':U
     9486         then do:
     9487   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9488   do:
     9489     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9490       (input  v-cntxt-db-num
     9491       ,input  v-cntxt-userid
     9492       ,input  0
     9493       ,input  'actn_return_lookup':U
     9494       ,input  'object':U
     9495       ,input  trn-doc.host-code
     9496       ,input  trn-doc.obj-type
     9497       ,input  trn-doc.obj-code
     9498       ,input  0
     9499       ,input  0
     9500       ,input  0
     9501       ,input  true
     9502       ,output g-log
     9503       )  .
     9504   end.
     9505         end.
     9506         otherwise do:
     9507           message
     9508            vss-workfile vss-revision vss-description skip
     9509            "Неизвестный тип документа" skip
     9510            "Тип документа" trn-doc.doc-type skip
     9511            "Код документа" trn-doc.doc-code skip
     9512            view-as alert-box error .
     9513           undo, return no-apply .
     9514         end.
     9515       end case .
     9516       if not g-log then return no-apply.
     9517       row_utd = rowid (X_utd) .
     9518       find doc-line where doc-line.doc-code  = trn-doc.doc-code no-lock no-error.
     9519       run str/trn-lkp.p (parparentproc, recid(trn-doc), recid(doc-line)).
     9520       reposition br-utd to rowid row_utd no-error .
     9521     end.
     9522   END.
     9523   ON CHOOSE OF B-refresh IN FRAME d-utd
     9524   DO:
     9525       f-date-from = date(f-date-from:screen-value) .
     9526       f-date-to   = date(f-date-to:screen-value) .
     9527       run init-sort .
     9528       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK INDEXED-REPOSITION.
     9529       apply "value-changed" to br-utd IN FRAME d-utd.
     9530   END.
     9531   ON choose OF b-utd IN FRAME d-utd
     9532   DO:
     9533     define variable Log-Res as logical no-undo.
     9534     if available (x_utd) then
     9535     do:
     9536       log-res = yes .
     9537       if log-res then
     9538       do:
     9539         row_utd = rowid (X_utd) .
     9540         run str/upd_browse.w (input parparentproc,
     9541               input x_utd.doc-id,
     9542               input x_utd.db-num,
     9543               input x_utd.EDocType,
     9544               input 'ПРОСМОТР':U,
     9545               input mDiadocConnection
     9546         ) no-error .
     9547       end.
     9548       reposition br-utd to rowid row_utd no-error .
     9549     end.
     9550     else
     9551     do:
     9552       message "Не выбран УПД"
     9553           view-as alert-box.
     9554       return no-apply .
     9555     end.
     9556   END.
     9557   ON CHOOSE OF B-write-sertif IN FRAME d-utd
     9558   DO:
     9559     define variable Log-Res as logical no-undo.
     9560     define variable oMotp as class ibs.th.bge.is_motp.is_motp no-undo .
     9561     define variable vUUID as character no-undo .
     9562     define buffer buf_ext-system      for ub.ext-system .
     9563     define buffer buf_ext-system-attr for ub.ext-system-attr .
     9564     define buffer buf_trn-doc for ub.trn-doc .
     9565     log-res = yes .
     9566     if log-res then
     9567     do:
     9568       for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'obj':U
     9569           and buf_ext-system-attr.esya-attr-value  = v-cntxt-obj-type + string(v-cntxt-obj-code)
     9570           :
     9571           find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
     9572               and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
     9573               no-error .
     9574           R-obj = 2 .
     9575           empty temp-table tt-obj-list .
     9576           create tt-obj-list .
     9577           assign
     9578               tt-obj-list.obj-code = v-cntxt-obj-code
     9579               tt-obj-list.obj-type = v-cntxt-obj-type
     9580               .
     9581           obj-list = v-cntxt-obj-type + " " + string(v-cntxt-obj-code) .
     9582           display obj-list r-obj with frame d-utd .
     9583           disable bt-sel-obj with frame d-utd .
     9584           if available buf_ext-system then leave .
     9585       end .
     9586       if not available buf_ext-system
     9587           then
     9588           for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'host-code':U
     9589               and buf_ext-system-attr.esya-attr-value  = string(v-cntxt-host-code-obj)
     9590               :
     9591               find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
     9592                   and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
     9593                   no-error .
     9594               if available buf_ext-system then leave .
     9595           end .
     9596       if not available buf_ext-system
     9597           then
     9598       do :
     9599           if v-mes-Token then
     9600           do:
     9601               message "Нет внешней системы с типом ИС МОТП" view-as alert-box .
     9602               return no-apply .
     9603           end.
     9604           else return no-apply .
     9605       end.
     9606       oMotp = new is_motp(buf_ext-system.db-num, buf_ext-system.esys-id) .
     9607       oMotp:isDebug = session:debug-alert .
     9608       if oMotp:currToken = ""
     9609       or oMotp:currToken = ?
     9610       then do :
     9611         vToken = oMotp:authorize(input f-sertif, input "SerialNumber") no-error .
     9612         if error-status:error
     9613             then
     9614         do:
     9615             time_motp = oMotp:currTokenDT .
     9616             vtime = max(0,time_motp + 10500000 - now).
     9617             if vtime = 0 then v-Token-error = true .
     9618             else v-Token-error = false .
     9619             message oMotp:MSG view-as alert-box .
     9620             return no-apply .
     9621         end.
     9622       end .
     9623       else do :
     9624         vToken = oMotp:currToken .
     9625       end .
     9626       if vToken > ""
     9627       then do :
     9628         if v-rid-list <> "" then
     9629         do:
     9630           utd_ :
     9631           do ii = 1 to num-entries (v-rid-list):
     9632             recid_utd = integer(entry(ii,v-rid-list)) .
     9633             find first x_utd where recid (x_utd) = recid_utd .
     9634             if x_utd.sts <> StatusTH:LK_RECEIPT_New:KeyIntDB
     9635             then next utd_ .
     9636             if not can-find(buf_trn-doc no-lock where buf_trn-doc.doc-code = X_utd.doc-code)
     9637             then next utd_ .
     9638             vUUID = oMotp:SendDoc_LK_RECEIPT ( vToken,
     9639                                                x_utd.db-num,
     9640                                                x_utd.doc-id,
     9641                                                f-sertif,
     9642                                                "SerialNumber"
     9643                                               )
     9644             .
     9645           end.
     9646           run init-sort in this-procedure .
     9647           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK INDEXED-REPOSITION.
     9648           apply "value-changed" to br-utd IN FRAME d-utd.
     9649         end.
     9650         else
     9651         do:
     9652           if available (X_utd) then
     9653           do:
     9654             row_utd = rowid (X_utd) .
     9655             find first x_utd where rowid (x_utd) = row_utd .
     9656             if x_utd.sts <> StatusTH:LK_RECEIPT_New:KeyIntDB
     9657             then do :
     9658               message 'Возможно только для документов в статусе "Требует подписания"' view-as alert-box .
     9659               return no-apply .
     9660             end .
     9661             if not can-find(buf_trn-doc no-lock where buf_trn-doc.doc-code = X_utd.doc-code)
     9662             then do :
     9663               message 'Первичный документ удален. Подписание и отправка документа невозможна.' view-as alert-box .
     9664               return no-apply .
     9665             end .
     9666             vUUID = oMotp:SendDoc_LK_RECEIPT ( vToken,
     9667                                                x_utd.db-num,
     9668                                                x_utd.doc-id,
     9669                                                f-sertif,
     9670                                                "SerialNumber"
     9671                                               )
     9672             .
     9673             if vUUID = ?
     9674             or trim(vUUID) = ""
     9675             then do :
     9676               message oMotp:MSG view-as alert-box .
     9677             end .
     9678             else do :
     9679             end .
     9680             run init-sort in this-procedure .
     9681             OPEN QUERY br-utd FOR EACH X_utd NO-LOCK INDEXED-REPOSITION.
