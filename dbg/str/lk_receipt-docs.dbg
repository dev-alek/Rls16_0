     1964                           .
     1965                       end.
     1966                       when chr(5)
     1967                       then do:
     1968                           assign
     1969                               p-out-string = p-out-string + " ":U
     1970                           .
     1971                       end.
     1972                       when chr(6)
     1973                       then do:
     1974                           assign
     1975                               p-out-string = p-out-string + " ":U
     1976                           .
     1977                       end.
     1978                       when chr(7)
     1979                       then do:
     1980                           assign
