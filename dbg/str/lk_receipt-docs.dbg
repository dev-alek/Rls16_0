      311   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   procedure cur-time :
      313      define output parameter p-today as date      no-undo .
      314      define output parameter p-time  as integer   no-undo .
      315     do
      316     on error undo, return error
      317     :
      318       define variable v-date1 as date      no-undo .
      319       define variable v-date2 as date      no-undo .
      320       define variable v-time  as integer   no-undo .
      321       assign
      322         v-date1 = today
      323         v-time  = time
      324         v-date2 = today
      325       .
      326       if v-date1 <> v-date2
      327       then do:
      328         assign
      329           v-date1 = today
      330           v-time  = v-time
      331         .
      332       end.
      333       assign
      334         p-today = v-date1
      335         p-time  = v-time
      336       .
      337     end.
      338   end.
      339   function cur-time-date returns character
      340   :
      341     return string(today, '99/99/9999':U) .
      342   end.
      343   function cur-time-mjd returns decimal
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return integer(v-date) - 2400002 + (v-time / 86400) .
      352   end.
      353   function cur-time-get-ending-index returns integer
      354   (input p-number as integer
      355   )
      356   :
      357     if p-number < 0
      358     or p-number = ?
      359     then do:
      360       return 1 .
      361     end.
      362     define variable v-rest as integer   no-undo .
      363     assign
      364       p-number = p-number modulo 100
      365     .
      366     if p-number < 20
      367     then do:
      368       assign
      369         v-rest = p-number
      370       .
      371     end.
      372     else do:
      373       assign
      374         v-rest = p-number modulo 10
      375       .
      376     end.
      377     case v-rest :
      378       when 1
      379       then do:
      380         return 2 .
      381       end.
      382       when 2 or
      383       when 3 or
      384       when 4
      385       then do:
      386         return 3 .
      387       end.
      388       otherwise do:
      389         return 1 .
      390       end.
      391     end case .
      392   end.
      393   procedure cur-time-mjd-to-date :
      394      define input  parameter i-mjd-diff as decimal no-undo.
      395      define output parameter o-Date     as date    no-undo.
      396      define output parameter o-Time     as integer no-undo.
      397      define variable v-day-number as integer   no-undo .
      398      if    i-mjd-diff < 0
      399         or i-mjd-diff = ?
      400      then do:
      401         return "?" .
      402      end.
      403      assign
      404         v-day-number = truncate(i-mjd-diff,0).
      405         o-Date = date(v-day-number + 2400002).
      406         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      407     .
      408   end.
      409   function cur-time-mjd-to-string returns character
      410   (input p-mjd-diff as decimal
      411   )
      412   :
      413     define variable v-day-number as integer   no-undo .
      414     define variable v-seconds    as integer   no-undo .
      415     define variable v-hour       as integer   no-undo .
      416     define variable v-min        as integer   no-undo .
      417     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      418     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      419     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      420     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      421     if p-mjd-diff < 0
      422     or p-mjd-diff = ?
      423     then do:
      424       return "?" .
      425     end.
      426     assign
      427       v-day-number = integer(truncate(p-mjd-diff,0))
      428       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      429     .
      430     if v-seconds > 86400
      431     then do:
      432       assign
      433         v-seconds = 86400 - 1
      434       .
      435     end.
      436     if v-seconds < 0
      437     then do:
      438       assign
      439         v-seconds = 0
      440       .
      441     end.
      442     assign
      443       v-hour = truncate(v-seconds / 3600, 0)
      444     .
      445     assign
      446       v-seconds = v-seconds modulo 3600
      447     .
      448     assign
      449       v-min = truncate(v-seconds / 60, 0)
      450     .
      451     assign
      452       v-seconds = v-seconds modulo 60
      453     .
      454     return
      455         (if v-day-number <> 0
      456           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      457           else ""
      458         )
      459       + (if v-day-number <> 0 or v-hour <> 0
      460           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      461           else ""
      462         )
      463       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      464           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      465           else ""
      466         )
      467       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      468       .
      469   end.
      470   function cur-time-string returns character
      471   :
      472     define variable v-date as date      no-undo .
      473     define variable v-time as integer   no-undo .
      474     run cur-time in this-procedure
      475       (output v-date
      476       ,output v-time
      477       ) .
      478     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      479   end.
      480   function cur-time-string-sec returns character
      481   :
      482     define variable v-date as date      no-undo .
      483     define variable v-time as integer   no-undo .
      484     run cur-time in this-procedure
      485       (output v-date
      486       ,output v-time
      487       ) .
      488     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      489   end.
      490   function cur-time-custom  returns character
      491   (input p-prefix as character
      492   ,input p-date-format as character
      493   ,input p-delimiter as character
      494   ,input p-time-format as character
      495   ,input p-suffix as character
      496   )
      497   :
      498     define variable v-date as date      no-undo .
      499     define variable v-time as integer   no-undo .
      500     run cur-time in this-procedure
      501       (output v-date
      502       ,output v-time
      503       ) .
      504     return
      505       p-prefix
      506       + string(v-date, p-date-format)
      507       + p-delimiter
      508       + string(v-time, p-time-format)
      509       + p-suffix
      510       .
      511   end.
      512   function cur-time-print  returns character
      513   :
      514     define variable v-date as date      no-undo .
      515     define variable v-time as integer   no-undo .
      516     run cur-time in this-procedure
      517       (output v-date
      518       ,output v-time
      519       ) .
      520     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      521   end.
      522   function cur-time-datetime returns datetime
      523   :
      524     define variable v-char as character no-undo .
      525     define variable v-datetime as datetime no-undo .
      526     v-char = cur-time-string().
      527     v-datetime = datetime(v-char).
      528     return  v-datetime.
      529   end.
      530   function cur-time-string-msec returns character
      531   :
      532     define variable v-date as datetime  no-undo .
      533     v-date = now.
      534     return string(v-date) .
      535   end.
