     1007   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1008   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1009   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1010   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1011   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
     1012   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
     1013   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
     1014   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
     1015   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
     1016   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
     1017   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
     1018   define variable mDebug as logical no-undo.
     1019   mDebug = session:debug-alert.
     1020   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   define variable mDiadocApi as component-handle no-undo.
     1022   define variable mDiadocConnection as component-handle no-undo.
     1023   define variable m-sys-key as character no-undo.
     1024   define variable marpar-type as character no-undo.
     1025   define variable mPublishHand as handle  no-undo.
     1026   define variable mFlaftest as logical no-undo.
     1027      create "Diadoc.DiadocClient":U mDiadocApi no-error.
     1028   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1029   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1030   define variable mySeqUtd as int64 no-undo init ?.
     1031   if mDiadocApi eq ?
     1032   then do:
     1033      if  log-manager:logfile-name ne ?
     1034      then
     1035         log-manager:write-message("Нет библиотеки Diadoc или не удалось создать объект Diadoc.DiadocClient", "EDOError").
     1036   end.
