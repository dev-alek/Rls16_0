     8616     field type     as integer
     8617     field doc-id   as integer
     8618     field db-num   as integer
     8619     field EdocType as integer
     8620     index pi mark out-code doc-type .
     8621   define temp-table tt-marking like ub.marking
     8622     .
     8623   define temp-table tt-utd-marking-lines like ub.utd-marking-lines
     8624     .
     8625   define temp-table tt-inv-marking no-undo
