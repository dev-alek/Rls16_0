     8921               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8922                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8923               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8924         otherwise do:
     8925           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     8926         end.
     8927       end CASE.
     8928     end.
     8929   end procedure.
     8930   procedure uf-get :
     8931     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     8932     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     8933     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     8934     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     8935     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     8936     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     8937     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     8938     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     8939     do
     8940     on error undo, return error
     8941     :
     8942       define buffer buf_usr-flt for ubflt.usr-flt .
     8943       define variable v-use-List_     as logical   no-undo .
     8944       define variable v-type-List_     as character no-undo .
     8945       define variable v-format-List_   as character no-undo .
     8946       define variable v-use-Naim      as logical   no-undo .
     8947       define variable v-type-Naim      as character no-undo .
     8948       define variable v-format-Naim    as character no-undo .
     8949       define variable v-use-print-graft as logical   no-undo .
     8950       define variable v-use-sort-gr     as logical   no-undo .
     8951       define variable v-use-type-price  as logical   no-undo .
     8952       define variable v-use-type-val    as logical   no-undo .
     8953       define variable v-label          as character no-undo .
     8954       define variable v-tooltip        as character no-undo .
     8955       define variable v-user-can-edit  as logical   no-undo .
     8956       define variable v-output-display as logical   no-undo .
     8957       define variable v-other          as character no-undo .
     8958       run uf-name in this-procedure
     8959          (input  entry(1, p-code, chr(4))
     8960         ,output v-use-List_
     8961         ,output v-type-List_
     8962         ,output v-format-List_
     8963         ,output v-use-Naim
     8964         ,output v-type-Naim
     8965         ,output v-format-Naim
     8966         ,output v-use-print-graft
     8967         ,output v-use-sort-gr
     8968         ,output v-use-type-price
     8969         ,output v-use-type-val
     8970         ,output v-label
     8971         ,output v-tooltip
     8972         ,output v-user-can-edit
     8973         ,output v-output-display
     8974         ,output v-other
     8975         ) no-error .
     8976       if error-status :error then do:
     8977         undo, return error return-value .
     8978       end.
     8979       find first buf_usr-flt no-lock where
     8980                  buf_usr-flt.Call-point     = p-code AND
     8981                  buf_usr-flt.user-name       = p-user-name
     8982         no-error .
     8983       if avail buf_usr-flt then do:
     8984         assign
     8985         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     8986         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     8987         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     8988         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     8989         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     8990         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     8991         .
     8992       end.
     8993       else do:
     8994         assign
     8995         p-List_        = (if v-use-List_       then "":U                    else ?)
     8996         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     8997         p-print-graft  = (if v-use-print-graft then no                      else ?)
     8998         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     8999         p-type-price   = (if v-use-type-price  then no                      else ?)
     9000         p-type-val     = (if v-use-List_       then no                      else ?)
     9001         .
     9002       end.
     9003     end.
     9004   end procedure.
     9005   procedure uf-set :
     9006     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     9007     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     9008     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     9009     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     9010     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     9011     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     9012     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     9013     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     9014     do
     9015     on error undo, return error
     9016     :
     9017       define buffer buf_usr-flt for ubflt.usr-flt .
     9018       define variable v-use-List_     as logical   no-undo .
     9019       define variable v-type-List_     as character no-undo .
     9020       define variable v-format-List_   as character no-undo .
     9021       define variable v-use-Naim      as logical   no-undo .
     9022       define variable v-type-Naim      as character no-undo .
     9023       define variable v-format-Naim    as character no-undo .
     9024       define variable v-use-print-graft as logical   no-undo .
     9025       define variable v-use-sort-gr   as logical   no-undo .
     9026       define variable v-use-type-price as logical   no-undo .
     9027       define variable v-use-type-val  as logical   no-undo .
     9028       define variable v-tooltip        as character no-undo .
     9029       define variable v-label          as character no-undo .
     9030       define variable v-user-can-edit  as logical   no-undo .
     9031       define variable v-output-display as logical   no-undo .
     9032       define variable v-other          as character no-undo .
     9033       run uf-name in this-procedure
     9034         (input  entry(1, p-code, chr(4))
     9035         ,output v-use-List_
     9036         ,output v-type-List_
     9037         ,output v-format-List_
     9038         ,output v-use-Naim
     9039         ,output v-type-Naim
     9040         ,output v-format-Naim
     9041         ,output v-use-print-graft
     9042         ,output v-use-sort-gr
     9043         ,output v-use-type-price
     9044         ,output v-use-type-val
     9045         ,output v-label
     9046         ,output v-tooltip
     9047         ,output v-user-can-edit
     9048         ,output v-output-display
     9049         ,output v-other
     9050         ) no-error .
     9051       if error-status :error then do:
     9052         undo, return error return-value .
     9053       end.
     9054       find first buf_usr-flt where
     9055                  buf_usr-flt.Call-point     = p-code AND
     9056                  buf_usr-flt.user-name       = p-user-name
     9057         no-error .
     9058       if not avail buf_usr-flt then do:
     9059           create buf_usr-flt .
     9060           assign
     9061           buf_usr-flt.call-point = p-code
     9062           buf_usr-flt.user-name  = p-user-name
     9063           .
     9064       end.
     9065       if avail buf_usr-flt then do:
     9066        assign
     9067        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     9068        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     9069        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     9070        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     9071        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     9072        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     9073       .
     9074       release buf_usr-flt.
     9075       end.
     9076       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     9077     end.
     9078   end procedure.
