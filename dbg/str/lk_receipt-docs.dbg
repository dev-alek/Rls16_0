      123   define temp-table userobjs_temp-user-obj no-undo
      124     field obj-type as character
      125     field obj-code as integer
      126     index xpk is primary unique obj-type obj-code
      127     .
      128   procedure userobjs_clear :
      129     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      130     do
      131     on error undo, return error return-value
      132     :
      133       for each buf_userobjs_temp-user-obj
      134       on error undo, return error return-value
      135       :
      136         delete buf_userobjs_temp-user-obj .
      137       end.
      138     end.
      139   end .
      140   procedure userobjs_object-count :
      141     define output parameter p-total-count as integer   no-undo .
      142     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      143     do
      144     on error undo, return error return-value
      145     :
      146       assign
      147         p-total-count = 0
      148       .
      149       for each buf_userobjs_temp-user-obj
      150       on error undo, return error return-value
      151       :
      152         assign
      153           p-total-count = p-total-count + 1
      154         .
      155       end.
      156     end.
      157   end.
      158   procedure userobjs_append :
      159      define input  parameter p-obj-type as character no-undo .
      160      define input  parameter p-obj-code as integer   no-undo .
      161     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      162     do
      163     on error undo, return error return-value
      164     :
      165       find first buf_userobjs_temp-user-obj
      166         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      167           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      168         no-error .
      169       if not available buf_userobjs_temp-user-obj
      170       then do:
      171         create buf_userobjs_temp-user-obj .
      172         assign
      173           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      174           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      175         .
      176       end.
      177     end.
      178   end.
      179   procedure userobjs_object-exist :
      180     define output parameter p-object-exist as logical   no-undo .
      181     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      182     do
      183     on error undo, return error return-value
      184     :
      185       find first buf_userobjs_temp-user-obj
      186         no-error .
      187       if not available buf_userobjs_temp-user-obj
      188       then do:
      189         assign
      190           p-object-exist = false
      191         .
      192       end.
      193       else do:
      194         assign
      195           p-object-exist = true
      196         .
      197       end.
      198     end.
      199   end.
      200   procedure userobjs_transfer :
      201     define input  parameter p-callback-handle as handle no-undo .
      202     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      203     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      204     do
      205     on error undo, return error return-value
      206     :
      207       if valid-handle(p-callback-handle) <> true
      208       then do:
      209         message
      210           vss-workfile vss-revision vss-description skip
      211           "Ошибка задания входных параметров" skip
      212           "Неизвестный указатель на процедуру" skip
      213           view-as alert-box error .
      214         undo, return error return-value .
      215       end.
      216       if p-callback-handle :get-signature("userobjs_append") = ""
      217       then do:
      218         message
      219           vss-workfile vss-revision vss-description skip
      220           "Ошибка задания входных параметров" skip
      221           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      222                     ,p-callback-handle :file-name
      223                     ) skip
      224           view-as alert-box error .
      225         undo, return error return-value .
      226       end.
      227       for each buf_userobjs_temp-user-obj
      228       on error undo, return error return-value
      229       :
      230         run userobjs_append in p-callback-handle
      231           (input  buf_userobjs_temp-user-obj.obj-type
      232           ,input  buf_userobjs_temp-user-obj.obj-code
      233           ) .
      234       end.
      235     end.
      236   end procedure.
      237   procedure userobjs_select-one :
