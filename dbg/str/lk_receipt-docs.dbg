     1041   end.
     1042   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   procedure gen-key-rec :
     1044     define input  parameter p-tbl-name    as character no-undo.
     1045     define input  parameter p-bh_tbl-name as handle    no-undo.
     1046     define output parameter p-key-rec     as character no-undo.
     1047     do
     1048     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1049     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1050     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1051     :
     1052       define variable fh               as handle    no-undo .
     1053       define variable v-ok             as logical   no-undo .
     1054       define variable v-inform         as character no-undo .
     1055       define variable v-ind            as integer   no-undo .
     1056       define variable v-idx-field-qnty as integer   no-undo .
     1057       if p-tbl-name = ?
     1058         or p-tbl-name = "":U
     1059       then do:
     1060         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     1061       end.
     1062       if not p-bh_tbl-name:available then do:
     1063         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     1064       end.
     1065       assign
     1066         p-key-rec = p-tbl-name
     1067         v-inform  = p-bh_tbl-name:index-information(1)
     1068         v-ind     = 2
     1069       .
     1070       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1071       on error undo, return error
     1072       :
     1073         assign
     1074           v-inform = p-bh_tbl-name:index-information( v-ind )
     1075           v-ind    = v-ind + 1
     1076         .
     1077       end.
     1078       if v-inform = ?
     1079         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1080         or entry( 3, v-inform, ",":U ) <> "1":U
     1081       then do:
     1082         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     1083       end.
     1084       else do:
     1085         assign
     1086           v-idx-field-qnty = num-entries( v-inform ) - 4
     1087         .
     1088         if v-idx-field-qnty < 2 then do:
     1089           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     1090         end.
     1091         do v-ind = 1 to v-idx-field-qnty by 2
     1092         on error undo, return error
     1093         :
     1094           assign
     1095             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1096             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1097           .
     1098         end.
     1099       end.
     1100       if p-key-rec = ? then do:
     1101         assign
     1102           p-key-rec = "":U
     1103         .
     1104         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     1105       end.
     1106     end.
     1107     return.
     1108   end procedure.
     1109   procedure gen-where-keyr-tab :
     1110     define input  parameter i-tableSerach as character no-undo.
     1111     define input  parameter i-tablekey   as character  no-undo.
     1112     define input  parameter p-key-rec    as character  no-undo.
     1113     define input  parameter p-key-handle as handle     no-undo .
     1114     define input  parameter p-db-name    as character  no-undo .
     1115     define input  parameter p-tt-handle  as handle     no-undo .
     1116     define output parameter o-Where      as character  no-undo.
     1117     do
     1118     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1119     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1120     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1121     :
     1122       define variable v-full-tbl-name  as character no-undo .
     1123       define variable bh_tbl-name      as handle    no-undo .
     1124       define variable fh_key           as handle    no-undo .
     1125       define variable fh_search        as handle    no-undo .
     1126       define variable v-field-num      as integer   no-undo .
     1127       define variable v-count-fld      as integer   no-undo .
     1128       define variable v-inform         as character no-undo .
     1129       define variable v-ind            as integer   no-undo .
     1130       define variable v-idx-field-qnty as integer   no-undo .
     1131       define variable v-field-name     as character no-undo .
     1132       define variable v-field-val      as character no-undo .
     1133       define variable v-word-link      as character no-undo .
     1134       define variable vTable           as character no-undo.
     1135       define variable bh_tbl-key       as handle    no-undo .
     1136       assign
     1137         p-key-rec = trim( p-key-rec )
     1138       .
     1139       if p-key-handle <> ? then do:
     1140         if not valid-handle(p-key-handle)
     1141            or p-key-handle:type <> "buffer"
     1142         then do:
     1143           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     1144         end.
     1145         if num-entries( p-key-rec, chr(3) ) > 1
     1146           or p-key-rec = ?
     1147           or p-key-rec = "":U
     1148         then do:
     1149           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     1150         end.
     1151       end.
     1152       else do:
     1153         if p-key-rec = ?
     1154           or p-key-rec = "":U
     1155         then do:
     1156           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1157         end.
     1158       end.
     1159       assign
     1160         vTable = entry( 1 , p-key-rec, chr(3) )
     1161       .
     1162       if p-tt-handle <> ?
     1163         and ( not valid-handle(p-tt-handle)
     1164               or p-tt-handle:type <> "buffer"
     1165             )
     1166       then do:
     1167         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     1168       end.
     1169       if p-tt-handle = ? then do:
     1170         assign
     1171           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1172         .
     1173         create buffer bh_tbl-name for table v-full-tbl-name .
     1174       end.
     1175       else do:
     1176         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1177       end.
     1178       assign
     1179         v-inform = bh_tbl-name:index-information(1)
     1180         v-ind    = 2
     1181       .
     1182       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1183       on error undo, return error
     1184       :
     1185         assign
     1186           v-inform = bh_tbl-name:index-information( v-ind )
     1187           v-ind    = v-ind + 1
     1188         .
     1189       end.
     1190       if v-inform = ?
     1191         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1192         or entry( 3, v-inform, ",":U ) <> "1":U
     1193       then do:
     1194         delete object bh_tbl-name no-error.
     1195         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     1196       end.
     1197       assign
     1198         v-idx-field-qnty = num-entries( v-inform ) - 4
     1199       .
     1200       if v-idx-field-qnty < 2 then do:
     1201         delete object bh_tbl-name no-error.
     1202         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     1203       end.
     1204       assign
     1205         o-where     = "where":U
     1206         v-word-link = "":U
     1207         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1208         v-count-fld = 0
     1209       .
     1210       if i-tablekey ne "" and i-tablekey ne ?
     1211       then do:
     1212         assign
     1213           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1214         .
     1215         create buffer bh_tbl-key for table v-full-tbl-name .
     1216       end.
     1217       if i-tableSerach ne "" and i-tableSerach ne ?
     1218       then do:
     1219         delete object bh_tbl-name no-error.
     1220         assign
     1221           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1222         .
     1223         create buffer bh_tbl-name for table v-full-tbl-name .
     1224       end.
     1225       block_where:
     1226       do v-ind = 1 to v-idx-field-qnty by 2
     1227       on error undo, return error
     1228       :
     1229         assign
     1230           v-count-fld = v-count-fld + 1
     1231         .
     1232         if p-key-handle = ?
     1233           and v-count-fld > v-field-num
     1234         then do:
     1235           leave block_where.
     1236         end.
     1237         define variable VfieldKeyTable as handle no-undo.
     1238         assign
     1239           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1240           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1241         .
     1242         if     bh_tbl-key ne ?
     1243         then do:
     1244            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1245            if VfieldKeyTable eq ?
     1246            then next block_where.
     1247         end.
     1248         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1249         then
     1250            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1251         else
     1252            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1253         if p-key-handle = ? then do:
     1254           assign
     1255             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1256           .
     1257         end.
     1258         else do:
     1259           assign
     1260             fh_key = p-key-handle:buffer-field( v-field-name )
     1261           .
     1262           if fh_key = ?
     1263             or not valid-handle( fh_key )
     1264           then do:
     1265             delete object bh_tbl-name.
     1266             if     bh_tbl-key ne ?
     1267             then
     1268                delete object bh_tbl-key.
     1269             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     1270           end.
     1271           assign
     1272             v-field-val = fh_key:buffer-value
     1273           .
     1274         end.
     1275         if fh_search:data-type ="character":U then do:
     1276           assign
     1277             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1278             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1279             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1280             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1281             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1282             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1283             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1284             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1285             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1286             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1287             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1288             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1289             v-field-val = substitute( '"&1"', v-field-val )
     1290           .
     1291         end.
     1292         assign
     1293           o-where = substitute( "&1 &2", o-where, v-field-val )
     1294         .
     1295         if v-word-link = "":U then do:
     1296           assign
     1297             v-word-link = "and":U
     1298           .
     1299         end.
     1300       end.
     1301       delete object bh_tbl-name.
     1302       if     bh_tbl-key ne ?
     1303       then
     1304          delete object bh_tbl-key.
     1305       if p-key-handle = ?
     1306         and v-count-fld <> v-field-num
     1307       then do:
     1308         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     1309       end.
     1310     end.
     1311   end procedure.
     1312   procedure gen-hn-keyr-tab :
     1313     define input  parameter i-tableSerach as character no-undo.
     1314     define input  parameter i-tablekey   as character no-undo.
     1315     define input  parameter p-key-rec    as character no-undo.
     1316     define input  parameter p-key-handle as handle    no-undo .
     1317     define input  parameter p-db-name    as character no-undo .
     1318     define input  parameter p-tt-handle  as handle    no-undo .
     1319     define input  parameter p-stts-lock  as integer   no-undo .
     1320     define output parameter o-hn         as handle    no-undo.
     1321     define variable v-full-tbl-name as character no-undo.
     1322     define variable v-where         as character no-undo.
     1323     define variable bh_tbl-name     as handle    no-undo.
     1324     define variable vTable          as character no-undo.
     1325     do
     1326     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1327     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1328     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1329         run gen-where-keyr-tab(i-tableSerach,
     1330                                i-tablekey,
     1331                                p-key-rec,
     1332                                p-key-handle,
     1333                                p-db-name,
     1334                                p-tt-handle,
     1335                                output v-where).
     1336         if i-tableSerach ne "" and i-tableSerach ne ?
     1337         then do:
     1338            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1339            create buffer bh_tbl-name for table v-full-tbl-name .
     1340         end.
     1341         else do:
     1342            if p-tt-handle = ? then do:
     1343               assign
     1344                  vTable = entry( 1 , p-key-rec, chr(3) )
     1345               .
     1346               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1347               create buffer bh_tbl-name for table v-full-tbl-name .
     1348            end.
     1349            else do:
     1350               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1351            end.
     1352         end.
     1353         if p-tt-handle = ? then do:
     1354            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1355         end.
     1356         else do:
     1357            bh_tbl-name:find-first( v-where ) no-error .
     1358         end.
     1359         o-hn = bh_tbl-name.
     1360      end.
     1361   end procedure.
     1362   procedure gen-hn-keyr :
     1363     define input  parameter p-key-rec    as character no-undo.
     1364     define input  parameter p-key-handle as handle    no-undo .
     1365     define input  parameter p-db-name    as character no-undo .
     1366     define input  parameter p-tt-handle  as handle    no-undo .
     1367     define input  parameter p-stts-lock  as integer   no-undo .
     1368     define output parameter o-hn         as handle    no-undo.
     1369     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1370   end.
     1371   procedure gen-row-keyr :
     1372     define input  parameter p-key-rec    as character no-undo.
     1373     define input  parameter p-key-handle as handle    no-undo .
     1374     define input  parameter p-db-name    as character no-undo .
     1375     define input  parameter p-tt-handle  as handle    no-undo .
     1376     define input  parameter p-stts-lock  as integer   no-undo .
     1377     define output parameter p-tbl-row    as rowid     no-undo.
     1378     define output parameter p-tbl-name   as character no-undo.
     1379     define variable vHn as handle no-undo.
     1380       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1381       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1382       p-tbl-name =  vHn:table.
     1383       delete object vHn no-error.
     1384     if p-tbl-row = ? then do:
     1385       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     1386     end.
     1387     else do:
     1388       return.
     1389     end.
     1390   end procedure.
     1391   procedure gen-key-fv :
     1392     define input  parameter p-key-rec    as character no-undo .
     1393     define output parameter p-field-list as character no-undo .
     1394     define output parameter p-value-list as character no-undo.
     1395     do
     1396     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1397     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1398     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1399     :
     1400       define variable v-full-tbl-name  as character no-undo .
     1401       define variable bh_tbl-name      as handle    no-undo .
     1402       define variable v-tbl-name       as character no-undo .
     1403       define variable v-field-num      as integer   no-undo .
     1404       define variable v-count-fld      as integer   no-undo .
     1405       define variable v-inform         as character no-undo .
     1406       define variable v-ind            as integer   no-undo .
     1407       define variable v-idx-field-qnty as integer   no-undo .
     1408       define variable v-delim-key      as character no-undo .
     1409       if p-key-rec = ?
     1410         or p-key-rec = "":U
     1411       then do:
     1412         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1413       end.
     1414       assign
     1415         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1416         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1417       .
     1418       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1419       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     1420       assign
     1421         v-inform = bh_tbl-name:index-information(1)
     1422         v-ind    = 2
     1423       .
     1424       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1425       on error undo, return error
     1426       :
     1427         assign
     1428           v-inform = bh_tbl-name:index-information( v-ind )
     1429           v-ind    = v-ind + 1
     1430         .
     1431       end.
     1432       if v-inform = ?
     1433         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1434         or entry( 3, v-inform, ",":U ) <> "1":U
     1435       then do:
     1436         delete object bh_tbl-name no-error.
     1437         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1438       end.
     1439       assign
     1440         v-idx-field-qnty = num-entries( v-inform ) - 4
     1441       .
     1442       if v-idx-field-qnty < 2 then do:
     1443         delete object bh_tbl-name no-error.
     1444         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1445       end.
     1446       assign
     1447         p-field-list = "":U
     1448         p-value-list = "":U
     1449         v-delim-key  = "":U
     1450         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1451         v-count-fld  = 0
     1452       .
     1453       block_where:
     1454       do v-ind = 1 to v-idx-field-qnty by 2
     1455       on error undo, return error
     1456       :
     1457         assign
     1458           v-count-fld = v-count-fld + 1
     1459         .
     1460         if v-count-fld > v-field-num then do:
     1461           leave block_where.
     1462         end.
     1463         assign
     1464           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1465           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1466         .
     1467         if v-ind = 1 then do:
     1468           assign
     1469             v-delim-key = chr(3)
     1470           .
     1471         end.
     1472       end.
     1473       delete object bh_tbl-name.
     1474       if v-count-fld <> v-field-num then do:
     1475         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     1476       end.
     1477     end.
     1478   end procedure.
     1479   procedure gen-key-field :
     1480     define input  parameter p-table      as character no-undo .
     1481     define output parameter p-field-list as character no-undo .
     1482     do
     1483     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1484     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1485     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1486     :
     1487       define variable v-full-tbl-name  as character no-undo .
     1488       define variable bh_tbl-name      as handle    no-undo .
     1489       define variable v-tbl-name       as character no-undo .
     1490       define variable v-field-num      as integer   no-undo .
     1491       define variable v-count-fld      as integer   no-undo .
     1492       define variable v-inform         as character no-undo .
     1493       define variable v-ind            as integer   no-undo .
     1494       define variable v-idx-field-qnty as integer   no-undo .
     1495       define variable v-delim-key      as character no-undo .
     1496       if p-table = ?
     1497         or p-table = "":U
     1498       then do:
     1499         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     1500       end.
     1501       assign
     1502         v-tbl-name      = p-table
     1503         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1504       .
     1505       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1506       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     1507       assign
     1508         v-inform = bh_tbl-name:index-information(1)
     1509         v-ind    = 2
     1510       .
     1511       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1512       on error undo, return error
     1513       :
     1514         assign
     1515           v-inform = bh_tbl-name:index-information( v-ind )
     1516           v-ind    = v-ind + 1
     1517         .
     1518       end.
     1519       if v-inform = ?
     1520         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1521         or entry( 3, v-inform, ",":U ) <> "1":U
     1522       then do:
     1523         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1524       end.
     1525       assign
     1526         v-idx-field-qnty = num-entries( v-inform ) - 4
     1527       .
     1528       if v-idx-field-qnty < 2 then do:
     1529         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1530       end.
     1531       assign
     1532         p-field-list = "":U
     1533         v-delim-key  = "":U
     1534         v-count-fld  = 0
     1535       .
     1536       block_where:
     1537       do v-ind = 1 to v-idx-field-qnty by 2
     1538       on error undo, return error
     1539       :
     1540         assign
     1541           v-count-fld = v-count-fld + 1
     1542         .
     1543         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1544         if v-ind = 1 then do:
     1545           assign
     1546             v-delim-key = chr(3)
     1547           .
     1548         end.
     1549       end.
     1550       delete object bh_tbl-name.
     1551     end.
     1552   end procedure.
     1553   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   function getattrUtdex returns char
     1555   (idb-num   as integer,
     1556    idoc-id   as integer,
     1557    iattrcode as character,
     1558    iExValue  as character  ):
     1559      define buffer utd-attr for utd-attr.
     1560      find first utd-attr where utd-attr.db-num eq idb-num
     1561                            and utd-attr.doc-id eq idoc-id
     1562                            and utd-attr.attr-code eq iattrcode
     1563      no-lock no-error.
     1564      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1565   end.
     1566   function getattrUtd returns char
     1567   (idb-num   as integer,
     1568    idoc-id   as integer,
     1569    iattrcode as character ):
     1570     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1571   end.
     1572   function setattrUtd returns logical
     1573   (idb-num   as integer,
     1574    idoc-id   as integer,
     1575    iattrcode as character,
     1576    iattrval  as character ):
     1577      define buffer utd-attr for utd-attr.
     1578      find first utd-attr where utd-attr.db-num eq idb-num
     1579                            and utd-attr.doc-id eq idoc-id
     1580                            and utd-attr.attr-code eq iattrcode
     1581      no-lock no-error.
     1582      if not available utd-attr
     1583      then do:
     1584         create utd-attr.
     1585         assign
     1586            utd-attr.db-num    = idb-num
     1587            utd-attr.doc-id    = idoc-id
     1588            utd-attr.attr-code = iattrcode
     1589            utd-attr.attr-value = iattrval
     1590         .
     1591      end.
     1592      else do:
     1593         if utd-attr.attr-value ne iattrval
     1594         then do:
     1595            find current utd-attr exclusive-lock no-error.
     1596            if available utd-attr
     1597            then
     1598               utd-attr.attr-value = iattrval.
     1599         end.
     1600      end.
     1601      release utd-attr.
     1602   end.
     1603   function GetAttrUtdlinesEx returns char
