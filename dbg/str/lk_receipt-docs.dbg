     9690   ON ROW-DISPLAY OF br-utd IN FRAME d-utd
     9691   DO:
     9692     define buffer buf_trn-doc for ub.trn-doc .
     9693     if AVAILABLE (X_utd) then
     9694     do:
     9695       if not can-find(buf_trn-doc no-lock where buf_trn-doc.doc-code = X_utd.doc-code)
     9696       then do :
     9697         X_utd.DocumentNumber:fGCOLOR in browse br-utd = RED_COLOR.
     9698       end .
     9699     end.
     9700   end.
     9701   ON value-changed OF br-utd IN FRAME d-utd
     9702   DO:
     9703     if available x_utd
     9704     then do :
     9705       if x_utd.sts = StatusTH:LK_RECEIPT_New:KeyIntDB
     9706       then do :
     9707         if f-sertif > ""
     9708         then do :
     9709           enable b-write-sertif with frame d-utd .
     9710         end .
     9711       end .
     9712       else do :
     9713         disable b-write-sertif with frame d-utd .
     9714       end .
     9715       if x_utd.sts = StatusTH:LK_RECEIPT_Error:KeyIntDB
     9716       or x_utd.sts = StatusTH:LK_RECEIPT_Signed:KeyIntDB
     9717       or x_utd.sts = StatusTH:LK_RECEIPT_SentDelete:KeyIntDB
     9718       or x_utd.sts = StatusTH:LK_RECEIPT_ConfirmedHand:KeyIntDB
     9719       or x_utd.sts = StatusTH:LK_RECEIPT_DeleteHand:KeyIntDB
     9720       then do :
     9721         enable b-comment with frame d-utd .
     9722       end .
     9723       else do :
     9724         disable b-comment with frame d-utd .
     9725       end .
     9726     end .
     9727   END.
     9728   ON CHOOSE OF b-print IN FRAME d-utd
     9729   DO:
     9730     define variable loc#log as logical no-undo .
     9731     define buffer bf_utd for ub.utd .
     9732     define variable v-rec-list as character no-undo .
     9733     v-rec-list = "" .
     9734     if v-rid-list > ""
     9735     then do :
     9736       do ii = 1 to num-entries (v-rid-list):
     9737         recid_utd = integer(entry(ii,v-rid-list)) .
     9738         find first X_utd where recid (x_utd) = recid_utd .
     9739         find first bf_utd no-lock where bf_utd.db-num = X_utd.db-num
     9740                                     and bf_utd.doc-id = X_utd.doc-id
     9741                                     no-error .
     9742         if available bf_utd
     9743         then do :
     9744           v-rec-list = v-rec-list + string(rowid(bf_utd)) + "," .
     9745         end .
     9746       end .
     9747     end .
     9748     else do :
     9749       if available X_utd
     9750       then do:
     9751         find first bf_utd no-lock where bf_utd.db-num = X_utd.db-num
     9752                                     and bf_utd.doc-id = X_utd.doc-id
     9753                                     no-error .
     9754         if available bf_utd
     9755         then do :
     9756           v-rec-list = string(rowid(bf_utd)) .
     9757         end .
     9758       end.
     9759     end .
     9760     v-rec-list = trim(v-rec-list, ",") .
     9761     if v-rec-list > ""
     9762     then do :
     9763       run rep/LK_RECEIPT-print.p (input parparentproc,
     9764                                   input v-rec-list) .
     9765     end .
     9766   END.
     9767   ON CHOOSE OF bt-not-sel-all IN FRAME d-utd
     9768   DO:
     9769     define variable loc#log as logical no-undo .
     9770     if available X_utd then
     9771     do:
     9772         v-rid-list = "" .
     9773         for each X_utd no-lock:
     9774   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9775   define variable v-str-recid31 as character no-undo .
