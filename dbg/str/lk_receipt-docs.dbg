     8190                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     8191                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     8192                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     8193                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     8194                                  no-lock no-error.
     8195                                  if not available utd-marking-lines
     8196                                  then do:
     8197                                    vtext = vunit:Value.
     8198                                    do viii = 1 to num-entries(vtext," "):
     8199                                       VValue = entry(viii,vtext," ").
     8200                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     8201                                    end.
     8202                                 end.
     8203                              end.
     8204                              release object  vunit.
     8205                           end.
     8206                           release object  vunits.
     8207                            release object vExtendedInvoiceItem.
     8208                         end.
     8209                         release object vItems.
     8210                     end.
     8211                     release object vContent.
     8212                  end.
     8213                  else do:
     8214                     create tt-recid.
     8215                     assign
     8216                        tt-recid.orgid = vOrganizationGuid
     8217                        tt-recid.docid = vDocumentid
     8218                     .
     8219                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     8220                     release object vDocumentChild.
     8221                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     8222                  end.
     8223               end.
     8224            end.
     8225            release object vDocumentChild.
     8226            define variable vsetPAck as logical no-undo.
     8227            define variable vcli-type as character no-undo.
     8228            define variable vcli-code as integer no-undo.
     8229            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     8230                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     8231            no-lock no-error.
     8232            if available ext-classif
     8233            then do:
     8234               assign
     8235                  vcli-type = ext-classif.CharKey_One
     8236                  vcli-code = ext-classif.Key#_One
     8237               .
     8238               define variable vPack as character no-undo.
     8239               if   iDocument:type eq "UniversalTransferDocument"
     8240               then
     8241                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     8242               else if iDocument:type eq "UniversalTransferDocumentRevision"
     8243               then
     8244                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     8245               else
     8246                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     8247               if vPack ne utd.PackageId
     8248               then
     8249                  assign
     8250                     vsetPAck      = yes
     8251                     utd.PackageId = vPack
     8252                  .
     8253            end.
     8254            if vNewUtd or vsetPAck then do:
     8255               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     8256               then do:
     8257                  if vNewUtd  then do:
     8258                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8259                     find first old_utd where old_utd.db-num eq volddb-num
     8260                                          and old_utd.doc-id eq volddoc-id
     8261                        no-lock no-error.
     8262                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     8263                                                  and utd-marking-lines.doc-id eq utd.doc-id
     8264                     exclusive-lock:
     8265                        if available old_utd
     8266                           and utd.db-num ne volddb-num
     8267                           and utd.doc-id ne volddoc-id
     8268                        then
     8269                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     8270                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     8271                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     8272                           no-lock no-error.
     8273                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     8274                     end.
     8275                     validate utd.
     8276                     ReCheckload( utd.db-num, utd.doc-id,yes).
     8277                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     8278                  end.
     8279               end.
     8280               else do:
     8281                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8282                  find first old_utd where old_utd.db-num eq volddb-num
     8283                                       and old_utd.doc-id eq volddoc-id
     8284                  no-lock no-error.
     8285                  if not available old_utd
     8286                     or (   utd.db-num eq volddb-num
     8287                        and utd.doc-id eq volddoc-id)
     8288                  then
     8289                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     8290                  else do:
     8291                      assign
     8292                          utd.obj-inn               = old_utd.obj-inn
     8293                          utd.obj-kpp               = old_utd.obj-kpp
     8294                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     8295                          utd.obj-info              = old_utd.obj-info
     8296                          utd.parentDocumentExt     = old_utd.DocumentExt
     8297                          utd.parentOrganizationExt = old_utd.OrganizationExt
     8298                          utd.contract-code         = old_utd.contract-code
     8299                      .
     8300                  end.
     8301                  validate utd.
     8302                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     8303               end.
     8304            end.
     8305            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8306            find first old_utd where old_utd.db-num eq volddb-num
     8307                                 and old_utd.doc-id eq volddoc-id
     8308            no-lock no-error.
     8309            if available old_utd
     8310            then
     8311               assign
     8312                  utd.parentDocumentExt     = old_utd.DocumentExt
     8313                  utd.parentOrganizationExt = old_utd.OrganizationExt
     8314               .
     8315            create tt-recid.
     8316            assign
     8317               tt-recid.orgid = vOrganizationGuid
     8318               tt-recid.docid = vDocumentid
     8319            .
     8320            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     8321            then do:
     8322               tt-recid.parent = utd.PackageId.
     8323               tt-recid.stamp  = utd.Timestamp.
     8324            end.
     8325            release utd no-error.
     8326            if error-status:error
     8327            then
     8328               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     8329            else
     8330               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     8331            unsubscribe "getNextseq".
     8332         end.
     8333      end.
     8334   end.
     8335   function packetupdd returns date
     8336   (iOrganization as component-handle, iDocument as component-handle):
     8337      define variable VPack as character no-undo.
     8338      define variable vorgid as character no-undo.
     8339      define variable vdocid as character no-undo.
     8340      define variable vstamp as datetime no-undo.
     8341      define variable VPack2 as character no-undo.
     8342      define variable vorgid2 as character no-undo.
     8343      define variable vdocid2 as character no-undo.
     8344      define variable vstamp2 as datetime no-undo.
     8345      define variable VPackage as component-handle no-undo.
     8346      define variable vi as integer no-undo.
     8347      define variable vDocument as component-handle no-undo.
     8348      define variable vDocuments as component-handle no-undo.
     8349         VPack = iDocument:PackageId.
     8350         vorgid = iDocument:OrganizationGuid.
     8351         vdocid = iDocument:DocumentId.
     8352         vstamp = iDocument:Timestamp.
     8353         find first tt-pack where tt-pack.packid eq VPack
     8354                              and tt-pack.stamp  eq vstamp
     8355                              and tt-pack.orgid  eq vorgid
     8356                              and tt-pack.docid  eq vdocid
     8357         no-lock no-error.
     8358         if not available tt-pack
     8359         then do:
     8360            create tt-pack.
     8361            assign
     8362               tt-pack.packid = VPack
     8363               tt-pack.stamp  = vstamp
     8364               tt-pack.orgid  = vorgid
     8365               tt-pack.docid  = vdocid
     8366            .
     8367         end.
     8368         getdesc(iDocument ).
     8369         getdesc(iDocument:InitialDocumentIds ).
     8370         vDocuments = iDocument:InitialDocumentIds.
     8371         do vi= 1 to vDocuments:Count:
     8372            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     8373            getdesc(vDocument ).
     8374            vorgid2 = vDocument:OrganizationGuid.
     8375            vdocid2 = vDocument:DocumentId.
     8376            vstamp2 = vDocument:Timestamp.
     8377            find first tt-pack where tt-pack.packid eq VPack
     8378                                 and tt-pack.stamp  eq vstamp2
     8379                                 and tt-pack.orgid  eq vorgid2
     8380                                 and tt-pack.docid  eq vdocid2
     8381            no-lock no-error.
     8382            if not available tt-pack
     8383            then do:
     8384               create tt-pack.
     8385               assign
     8386                  tt-pack.packid = VPack
     8387                  tt-pack.stamp  = vstamp2
     8388                  tt-pack.orgid  = vorgid2
     8389                  tt-pack.docid  = vdocid2
     8390               .
     8391            end.
     8392            release object vDocument.
     8393         end.
     8394         release object vDocuments.
     8395   end.
     8396   procedure UpdateUTDInform:
     8397      define input  parameter ibeg-date as date no-undo.
     8398      define input  parameter iend-date as date no-undo.
     8399      define output parameter odatelast as date no-undo.
     8400      define variable vOrganizationList as component-handle no-undo.
     8401      define variable vOrganization as component-handle no-undo.
     8402      define variable vDocumentsTask as component-handle no-undo.
     8403      define variable vDocumentList  as component-handle no-undo.
     8404      define variable vDocumentchildList  as component-handle no-undo.
     8405      define variable vDocument       as component-handle no-undo.
     8406      define buffer ext-classif_obj for ext-classif.
     8407      define buffer ext-classif_Cli  for ext-classif.
     8408      define variable vi  as integer no-undo.
     8409      define variable vii as integer no-undo.
     8410      odatelast = ibeg-date.
     8411      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     8412      if vOrganizationList eq ? then return error ?.
     8413      vi = vOrganizationList:Count()no-error.
     8414      if vi eq ?
     8415      then
     8416         return error ?.
     8417      for each tt-recid:
     8418         delete tt-recid.
     8419      end.
     8420      for each tt-pack:
     8421         delete tt-pack.
     8422      end.
     8423      do vi = 1 to vOrganizationList:Count() :
     8424         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     8425         getdesc(vOrganization).
     8426         run changeIdtoGuid(vOrganization).
     8427         vDocumentsTask = vOrganization:GetDocumentsTask().
     8428                     vDocumentsTask:FromSendDate = ibeg-date  .
     8429                     vDocumentsTask:ToSendDate   = iend-date.
     8430                     for each tt-type, each tt-Class:
     8431                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     8432                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     8433                                          chr(10),
     8434                                          ibeg-date ,
     8435                                          iend-date,
     8436                                          if tt-type .id eq "Any" then "" else tt-type.name,
     8437                                          tt-Class.name)).
     8438                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     8439                         if vDocumentList ne ?
     8440                         then do:
     8441                           do vii= 1 to vDocumentList:Count:
     8442                              if chekStop() then return ?.
     8443                              vDocument = vDocumentList:GetItem(vii - 1).
     8444                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     8445                              odatelast = min(odatelast,today).
     8446                              packetupdd(vOrganization, vDocument).
     8447                              release object vDocument.
     8448                            end.
     8449                            release object vDocumentList.
     8450                         end.
     8451                      end.
     8452                      define variable VAlldoc    as integer no-undo.
     8453                      define variable vprocessed as integer no-undo.
     8454                      for each tt-pack :
     8455                         VAlldoc = VAlldoc + 1.
     8456                      end.
     8457                      for each tt-pack :
     8458                          if chekStop() then return ?.
     8459                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     8460                         then do:
     8461                             run  UpdateUTDInformOne(vDocument).
     8462                            release object vDocument.
     8463                        end.
     8464                        vprocessed = vprocessed + 1.
     8465                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     8466                     end.
     8467         release object vOrganization.
     8468         release object vDocumentsTask.
     8469      end.
     8470      release object vOrganizationList.
     8471   end.
     8472   procedure updOneUTD:
     8473      define input  parameter idb-num as integer no-undo.
     8474      define input  parameter idoc-id as integer no-undo.
     8475      define variable vDocument as component-handle no-undo.
     8476      define buffer utd for utd.
     8477      for each tt-recid:
     8478         delete tt-recid.
     8479      end.
     8480      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     8481      then do:
     8482          run  UpdateUTDInformOne(vDocument).
     8483         release object vDocument.
     8484      end.
     8485   end.
     8486   function CRnewDocum return character
     8487   (
     8488   iOrgGuid as character,
     8489   iContGuid as character,
     8490   iTypeUTD as character,
     8491    iFile as character
     8492    ):
     8493   define variable vOrganization as component-handle no-undo.
     8494   define variable vSendTask as component-handle no-undo.
     8495       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     8496       if vOrganization ne ?
     8497       then do:
     8498          vSendTask = vOrganization:CreatePackageSendTask2().
     8499          getdesc(vSendTask).
     8500          vSendTask:CounteragentId = iContGuid  .
     8501          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     8502          vSendTask:Send()no-error.
     8503          if error-status:num-messages > 0 then do:
     8504             PutErr("ERROR Ошибка отправки документа").
     8505             return error "ERROR Ошибка отправки документа".
     8506          end.
     8507          else do:
     8508             PutMes("Документ отправлен успешно.").
     8509             message "Документ отправлен успешно."
     8510             view-as alert-box.
     8511          end.
     8512          release object vSendTask.
     8513         release object vOrganization .
     8514      end.
     8515   end.
     8516   procedure MySeqForUtd:
     8517      define input  parameter iTable       as character no-undo.
     8518      define input  parameter iseqnamehist as character no-undo.
     8519      define input  parameter idb-name     as character no-undo.
     8520      define output parameter Oseq         as int64 no-undo.
     8521      if iTable begins "utd"
     8522      then do:
     8523         if myseqUtd eq ?
     8524         then
     8525            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     8526         Oseq = myseqUtd.
     8527      end.
     8528      else
     8529         Oseq = ?.
     8530      return.
     8531   end.
