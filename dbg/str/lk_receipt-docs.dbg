    10509   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    10510   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    10511   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    10512   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    10513   define variable v-diasize-current-frame-width  as decimal   no-undo .
    10514   define variable v-diasize-current-frame-height as decimal   no-undo .
    10515   define variable v-diasize-change-size          as logical   no-undo .
    10516   define variable v-diasize-resize-button        as handle    no-undo .
    10517   define variable v-diasize-wndmax               as logical   no-undo .
    10518   define variable v-diasize-wndstore             as logical   no-undo .
    10519   define variable v-diasize-proc-name            as character no-undo .
    10520   define variable v-diasize-browse-handle        as handle    no-undo .
    10521   define variable v-diasize-browse-number        as integer   no-undo .
    10522   define variable v-diasize-need-full-display    as logical   no-undo init false .
    10523   define temp-table temp-diasize-handle no-undo
    10524     field handle-value  as handle
    10525     field save-position as decimal
    10526     index xpk is primary unique handle-value
    10527     .
    10528   define temp-table temp-browse-handle no-undo
    10529     field browse-type   as character
    10530     field browse-number as integer
    10531     field browse-handle as handle
    10532     field original-size as decimal
    10533     index xpk is primary unique browse-type browse-number
    10534     index xie browse-type browse-handle
    10535   .
    10536   procedure diasize_change-height :
    10537     define input  parameter p-change-value  as decimal   no-undo .
    10538     define input  parameter p-move-resize   as logical   no-undo .
    10539     define variable v-field-group-handle    as handle    no-undo .
    10540     define variable v-object-handle         as handle    no-undo .
    10541     define variable v-frame-height          as decimal   no-undo .
    10542     define variable v-frame-virtual-height  as decimal   no-undo .
    10543     define variable v-browse-height         as decimal   no-undo .
    10544     define variable v-window-height         as decimal   no-undo .
    10545     define variable v-window-virtual-height as decimal   no-undo .
    10546     define variable v-change-sign           as integer   no-undo .
    10547     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    10548     define buffer buf_temp-browse-handle  for temp-browse-handle .
    10549     if p-change-value > 0
    10550     then do:
    10551       if frame d-utd :height + p-change-value
    10552           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    10553       then do:
    10554         assign
    10555           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    10556                           - (frame d-utd :height-chars)
    10557         .
    10558         if p-change-value <= 0
    10559         then do:
    10560           run diasize_position-resize-button in this-procedure .
    10561           return .
    10562         end.
    10563       end.
    10564     end.
    10565     if p-change-value < 0
    10566     then do:
    10567       if frame d-utd :height + p-change-value < v-diasize-orig-frame-height
    10568       then do:
    10569         assign
    10570           p-change-value = v-diasize-orig-frame-height
    10571                          - (frame d-utd :height-chars)
    10572         .
    10573         if p-change-value >= 0
    10574         then do:
    10575           run diasize_position-resize-button in this-procedure .
    10576           return .
    10577         end.
    10578       end.
    10579     end.
    10580     if p-change-value >= 0
    10581     then do:
    10582       assign
    10583         v-change-sign = 1
    10584       .
    10585     end.
    10586     else do:
    10587       assign
    10588         v-change-sign = -1
    10589       .
    10590     end.
    10591     assign
    10592       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    10593     .
    10594     if p-change-value = 0
    10595     then do:
    10596       run diasize_position-resize-button in this-procedure .
    10597       return .
    10598     end.
    10599     move_block:
    10600     do
    10601     on error undo move_block, retry move_block
    10602     :
    10603       if retry
    10604       then do:
    10605         do
    10606         on error undo move_block, leave move_block
    10607         :
    10608           if p-change-value > 0
    10609           then do:
    10610             for each buf_temp-diasize-handle
    10611             on error undo, next
    10612             :
    10613               assign
    10614                 v-object-handle = buf_temp-diasize-handle.handle-value
    10615               .
    10616               if v-object-handle <> v-diasize-resize-button
    10617               then do:
    10618                 assign
    10619                   v-object-handle :row = buf_temp-diasize-handle.save-position
    10620                 .
    10621               end.
    10622             end.
    10623             assign
    10624               v-diasize-browse-handle :height = v-browse-height
    10625             .
    10626             for each buf_temp-browse-handle
    10627               where buf_temp-browse-handle.browse-type = 'height':u
    10628             on error undo, next
    10629             :
    10630               assign
    10631                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    10632               .
    10633             end.
    10634             assign
    10635               frame d-utd :height = v-frame-height
    10636             .
    10637             if frame d-utd :scrollable = true
    10638             then do:
    10639               assign
    10640                 frame d-utd :virtual-height = v-frame-virtual-height
    10641               .
    10642             end.
    10643             run diasize_position-resize-button in this-procedure .
    10644           end.
    10645           else do:
    10646             if frame d-utd :scrollable = true
    10647             then do:
    10648               assign
    10649                 frame d-utd :virtual-height = v-frame-virtual-height
    10650               .
    10651             end.
    10652             assign
    10653               frame d-utd :height = v-frame-height
    10654             .
    10655             assign
    10656               v-diasize-browse-handle :height = v-browse-height
    10657             .
    10658             for each buf_temp-browse-handle
    10659               where buf_temp-browse-handle.browse-type = 'height':u
    10660             on error undo, next
    10661             :
    10662               assign
    10663                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    10664               .
    10665             end.
    10666             for each buf_temp-diasize-handle
    10667             on error undo, next
    10668             :
    10669               assign
    10670                 v-object-handle = buf_temp-diasize-handle.handle-value
    10671               .
    10672               if v-object-handle <> v-diasize-resize-button
    10673               then do:
    10674                 assign
    10675                   v-object-handle :row = buf_temp-diasize-handle.save-position
    10676                 .
    10677               end.
    10678             end.
    10679             run diasize_position-resize-button in this-procedure .
    10680           end.
    10681           assign
    10682             v-diasize-change-size = false
    10683           .
    10684           leave move_block .
    10685         end.
    10686       end.
    10687       assign
    10688         v-diasize-need-full-display = true
    10689       .
    10690       if v-diasize-change-size = false
    10691       then do:
    10692         assign
    10693           v-diasize-change-size = true
    10694         .
    10695       end.
    10696       else do:
    10697         return .
    10698       end.
    10699       assign
    10700         v-frame-height = frame d-utd :height
    10701         v-frame-virtual-height = frame d-utd :virtual-height
    10702         v-browse-height = v-diasize-browse-handle :height
    10703       .
    10704       for each buf_temp-browse-handle
    10705         where buf_temp-browse-handle.browse-type = 'height':u
    10706       :
    10707         assign
    10708           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
    10709         .
    10710       end.
    10711       for each buf_temp-diasize-handle
    10712       :
    10713         delete buf_temp-diasize-handle .
    10714       end.
    10715       assign
    10716         v-field-group-handle = frame d-utd :first-child
    10717       .
    10718       do while valid-handle(v-field-group-handle)
    10719       :
    10720         assign
    10721           v-object-handle = v-field-group-handle :first-child
    10722         .
    10723         do while valid-handle(v-object-handle)
    10724         :
    10725           if  v-object-handle <> v-diasize-browse-handle :handle
    10726           and can-query(v-object-handle, "row")
    10727           and can-query(v-object-handle, "height")
    10728           and ( v-object-handle :row > v-diasize-browse-handle :row )
    10729           then do:
    10730             find first buf_temp-browse-handle
    10731               where buf_temp-browse-handle.browse-type   = 'height':u
    10732                 and buf_temp-browse-handle.browse-handle = v-object-handle
    10733               no-error .
    10734             if available buf_temp-browse-handle
    10735             then do:
    10736             end.
    10737             else do:
    10738               create buf_temp-diasize-handle .
    10739               assign
    10740                 buf_temp-diasize-handle.handle-value  = v-object-handle
    10741                 buf_temp-diasize-handle.save-position = v-object-handle :row
    10742               .
    10743             end.
    10744           end.
    10745           assign
    10746             v-object-handle = v-object-handle :next-sibling
    10747           .
    10748         end.
    10749         assign
    10750           v-field-group-handle = v-field-group-handle :next-sibling
    10751         .
    10752       end.
    10753       do with frame d-utd
    10754       :
    10755         hide v-diasize-resize-button .
    10756         assign
    10757           v-diasize-resize-button :row    = 1
    10758           v-diasize-resize-button :column = 1
    10759         .
    10760       end.
    10761       if p-change-value > 0
    10762       then do:
    10763         if frame d-utd :scrollable = true
    10764         then do:
    10765           assign
    10766             frame d-utd :virtual-height = frame d-utd :virtual-height + p-change-value
    10767             no-error .
    10768           if error-status :error
    10769           or error-status :get-message(1) <> ""
    10770           then do:
    10771             undo move_block, retry move_block .
    10772           end.
    10773         end.
    10774         assign
    10775           frame d-utd :height = frame d-utd :height + p-change-value
    10776           no-error .
    10777         if error-status :error
    10778         or error-status :get-message(1) <> ""
    10779         then do:
    10780           undo move_block, retry move_block .
    10781         end.
    10782         assign
    10783           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    10784           no-error .
    10785         if error-status :error
    10786         or error-status :get-message(1) <> ""
    10787         then do:
    10788           undo move_block, retry move_block .
    10789         end.
    10790         for each buf_temp-browse-handle
    10791           where buf_temp-browse-handle.browse-type = 'height':u
    10792         on error undo move_block, retry move_block
    10793         :
    10794           assign
    10795             buf_temp-browse-handle.browse-handle :height
    10796               = buf_temp-browse-handle.browse-handle :height + p-change-value
    10797             no-error .
    10798           if error-status :error
    10799           or error-status :get-message(1) <> ""
    10800           then do:
    10801             undo move_block, retry move_block .
    10802           end.
    10803         end.
    10804         for each buf_temp-diasize-handle
    10805         on error undo move_block, retry move_block
    10806         :
    10807           assign
    10808             v-object-handle = buf_temp-diasize-handle.handle-value
    10809           .
    10810           if v-object-handle <> v-diasize-resize-button
    10811           then do:
    10812             assign
    10813               v-object-handle :row = v-object-handle :row + p-change-value
    10814               no-error .
    10815             if error-status :error
    10816             or error-status :get-message(1) <> ""
    10817             then do:
    10818               undo move_block, retry move_block .
    10819             end.
    10820           end.
    10821         end.
    10822       end.
    10823       else do:
    10824         for each buf_temp-diasize-handle
    10825         on error undo move_block, retry move_block
    10826         :
    10827           assign
    10828             v-object-handle = buf_temp-diasize-handle.handle-value
    10829           .
    10830           if v-object-handle <> v-diasize-resize-button
    10831           then do:
    10832             assign
    10833               v-object-handle :row = v-object-handle :row + p-change-value
    10834               no-error .
    10835             if error-status :error
    10836             or error-status :get-message(1) <> ""
    10837             then do:
    10838               undo move_block, retry move_block .
    10839             end.
    10840           end.
    10841         end.
    10842         assign
    10843           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    10844           no-error .
    10845         if error-status :error
    10846         or error-status :get-message(1) <> ""
    10847         then do:
    10848           undo move_block, retry move_block .
    10849         end.
    10850         for each buf_temp-browse-handle
    10851           where buf_temp-browse-handle.browse-type = 'height':u
    10852         on error undo move_block, retry move_block
    10853         :
    10854           assign
    10855             buf_temp-browse-handle.browse-handle :height
    10856               = buf_temp-browse-handle.browse-handle :height + p-change-value
    10857             no-error .
    10858           if error-status :error
    10859           or error-status :get-message(1) <> ""
    10860           then do:
    10861             undo move_block, retry move_block .
    10862           end.
    10863         end.
    10864         assign
    10865           frame d-utd :height = frame d-utd :height + p-change-value
    10866           no-error .
    10867         if error-status :error
    10868         or error-status :get-message(1) <> ""
    10869         then do:
    10870           undo move_block, retry move_block .
    10871         end.
    10872         if frame d-utd :scrollable = true
    10873         then do:
    10874           assign
    10875             frame d-utd :virtual-height = frame d-utd :virtual-height + p-change-value
    10876             no-error .
    10877           if error-status :error
    10878           or error-status :get-message(1) <> ""
    10879           then do:
    10880             undo move_block, retry move_block .
    10881           end.
    10882         end.
    10883       end.
    10884       if p-move-resize = true
    10885       then do:
    10886         run diasize_position-resize-button in this-procedure .
    10887       end.
    10888       if v-diasize-wndstore = true
    10889       then do:
    10890         if connected("ub") = true
    10891         then do:
    10892           define variable v-cntxt-db-num        as integer   no-undo .
    10893           define variable v-cntxt-userid        as character no-undo .
    10894           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    10895                                             , OUTPUT v-cntxt-userid
    10896                                             ) .
    10897           run gbl/wndsizew.p
    10898             (input  v-cntxt-db-num
    10899             ,input  v-cntxt-userid
    10900             ,input  v-diasize-proc-name
    10901             ,input  'height':u
    10902             ,input  string(frame d-utd :height - v-diasize-orig-frame-height)
    10903             ) .
    10904         end.
    10905       end.
    10906     end.
    10907     assign
    10908       v-diasize-change-size = false
    10909     .
    10910   end procedure.
    10911   procedure diasize_set-height :
    10912     define input  parameter p-new-height  as decimal   no-undo .
    10913     define input  parameter p-move-resize as logical   no-undo .
    10914     do
    10915     on error undo, return error return-value
    10916     :
    10917       run diasize_change-height in this-procedure
    10918         (input  (p-new-height - frame d-utd :height)
    10919         ,input  p-move-resize
    10920         ) .
    10921     end.
    10922   end procedure.
    10923   procedure diasize_change-width :
    10924     define input  parameter p-change-value as decimal   no-undo .
    10925     define input  parameter p-move-resize  as logical   no-undo .
    10926     define variable v-field-group-handle   as handle    no-undo .
    10927     define variable v-object-handle        as handle    no-undo .
    10928     define variable v-frame-width          as decimal   no-undo .
    10929     define variable v-frame-virtual-width  as decimal   no-undo .
    10930     define variable v-browse-width         as decimal   no-undo .
    10931     define variable v-window-width         as decimal   no-undo .
    10932     define variable v-window-virtual-width as decimal   no-undo .
    10933     define variable v-change-sign          as integer   no-undo .
    10934     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    10935     define buffer buf_temp-browse-handle  for temp-browse-handle .
    10936     if p-change-value > 0
    10937     then do:
    10938       if frame d-utd :width + p-change-value >
    10939           session :width-chars
    10940       then do:
    10941         assign
    10942           p-change-value = session :width-chars - frame d-utd :width
    10943         .
    10944         if p-change-value <= 0
    10945         then do:
    10946           run diasize_position-resize-button in this-procedure .
    10947           return .
    10948         end.
    10949       end.
    10950     end.
    10951     if p-change-value < 0
    10952     then do:
    10953       if frame d-utd :width + p-change-value < v-diasize-orig-frame-width
    10954       then do:
    10955         assign
    10956           p-change-value = v-diasize-orig-frame-width
    10957                          - frame d-utd :width
    10958         .
    10959         if p-change-value >= 0
    10960         then do:
    10961           run diasize_position-resize-button in this-procedure .
    10962           return .
    10963         end.
    10964       end.
    10965     end.
    10966     if p-change-value >= 0
    10967     then do:
    10968       assign
    10969         v-change-sign = 1
    10970       .
    10971     end.
    10972     else do:
    10973       assign
    10974         v-change-sign = -1
    10975       .
    10976     end.
    10977     assign
    10978       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    10979     .
    10980     if p-change-value = 0
    10981     then do:
    10982       run diasize_position-resize-button in this-procedure .
    10983       return .
    10984     end.
    10985     move_block:
    10986     do
    10987     on error undo move_block, leave move_block
    10988     :
    10989       if retry
    10990       then do:
    10991         do
    10992         on error undo move_block, leave move_block
    10993         :
    10994           if p-change-value > 0
    10995           then do:
    10996             for each buf_temp-diasize-handle
    10997             on error undo, next
    10998             :
    10999               assign
    11000                 v-object-handle = buf_temp-diasize-handle.handle-value
    11001               .
    11002               if v-object-handle <> v-diasize-resize-button
    11003               then do:
    11004                 assign
    11005                   v-object-handle :col = buf_temp-diasize-handle.save-position
    11006                 .
    11007               end.
    11008             end.
    11009             assign
    11010               v-diasize-browse-handle :width = v-browse-width
    11011             .
    11012             for each buf_temp-browse-handle
    11013               where buf_temp-browse-handle.browse-type = 'width':u
    11014             on error undo, next
    11015             :
    11016               assign
    11017                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    11018               .
    11019             end.
    11020             assign
    11021               frame d-utd :width = v-frame-width
    11022             .
    11023             if frame d-utd :scrollable = true
    11024             then do:
    11025               assign
    11026                 frame d-utd :virtual-width = v-frame-virtual-width
    11027               .
    11028             end.
    11029             run diasize_position-resize-button in this-procedure .
    11030           end.
    11031           else do:
    11032             if frame d-utd :scrollable = true
    11033             then do:
    11034               assign
    11035                 frame d-utd :virtual-width = v-frame-virtual-width
    11036               .
    11037             end.
    11038             assign
    11039               frame d-utd :width = v-frame-width
    11040             .
    11041             for each buf_temp-browse-handle
    11042               where buf_temp-browse-handle.browse-type = 'width':u
    11043             on error undo, next
    11044             :
    11045               assign
    11046                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    11047               .
    11048             end.
    11049             assign
    11050               v-diasize-browse-handle :width = v-browse-width
    11051             .
    11052             for each buf_temp-diasize-handle
    11053             on error undo, next
    11054             :
    11055               assign
    11056                 v-object-handle = buf_temp-diasize-handle.handle-value
    11057               .
    11058               if v-object-handle <> v-diasize-resize-button
    11059               then do:
    11060                 assign
    11061                   v-object-handle :col = buf_temp-diasize-handle.save-position
    11062                 .
    11063               end.
    11064             end.
    11065             run diasize_position-resize-button in this-procedure .
    11066           end.
    11067           assign
    11068             v-diasize-change-size = false
    11069           .
    11070           leave move_block .
    11071         end.
    11072       end.
    11073       assign
    11074         v-diasize-need-full-display = true
    11075       .
    11076       if v-diasize-change-size = false
    11077       then do:
    11078         assign
    11079           v-diasize-change-size = true
    11080         .
    11081       end.
    11082       else do:
    11083         return .
    11084       end.
    11085       assign
    11086         v-frame-width = frame d-utd :width
    11087         v-frame-virtual-width = frame d-utd :virtual-width
    11088         v-browse-width = v-diasize-browse-handle :width
    11089       .
    11090       for each buf_temp-browse-handle
    11091         where buf_temp-browse-handle.browse-type = 'width':u
    11092       :
    11093         assign
    11094           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
    11095         .
    11096       end.
    11097       for each buf_temp-diasize-handle
    11098       :
    11099         delete buf_temp-diasize-handle .
    11100       end.
    11101       assign
    11102         v-field-group-handle = frame d-utd :first-child
    11103       .
    11104       do while valid-handle(v-field-group-handle)
    11105       :
    11106         assign
    11107           v-object-handle = v-field-group-handle :first-child
    11108         .
    11109         do while valid-handle(v-object-handle)
    11110         :
    11111           if  v-object-handle <> v-diasize-browse-handle :handle
    11112           and v-object-handle <> v-diasize-resize-button
    11113           and can-query(v-object-handle, "row")
    11114           and can-query(v-object-handle, "height")
    11115           and ( v-object-handle :col + v-object-handle :width
    11116                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
    11117               )
    11118           then do:
    11119             find first buf_temp-browse-handle
    11120               where buf_temp-browse-handle.browse-type   = 'width':u
    11121                 and buf_temp-browse-handle.browse-handle = v-object-handle
    11122               no-error .
    11123             if available buf_temp-browse-handle
    11124             then do:
    11125             end.
    11126             else do:
    11127               create buf_temp-diasize-handle .
    11128               assign
    11129                 buf_temp-diasize-handle.handle-value  = v-object-handle
    11130                 buf_temp-diasize-handle.save-position = v-object-handle :col
    11131               .
    11132             end.
    11133           end.
    11134           assign
    11135             v-object-handle = v-object-handle :next-sibling
    11136           .
    11137         end.
    11138         assign
    11139           v-field-group-handle = v-field-group-handle :next-sibling
    11140         .
    11141       end.
    11142       do with frame d-utd
    11143       :
    11144         hide v-diasize-resize-button .
    11145         v-diasize-resize-button :row = 1.
    11146         v-diasize-resize-button :column = 1.
    11147       end.
    11148       if p-change-value > 0
    11149       then do:
    11150         if frame d-utd :scrollable = true
    11151         then do:
    11152           assign
    11153             frame d-utd :virtual-width = frame d-utd :virtual-width + p-change-value
    11154             no-error .
    11155           if error-status :error
    11156           or error-status :get-message(1) <> ""
    11157           then do:
    11158             undo move_block, retry move_block.
    11159           end.
    11160         end.
    11161         assign
    11162           frame d-utd :width = v-frame-width + p-change-value
    11163           no-error .
    11164         if error-status :error
    11165         or error-status :get-message(1) <> ""
    11166         then do:
    11167           undo move_block, retry move_block.
    11168         end.
    11169         assign
    11170           v-diasize-browse-handle :width = v-browse-width + p-change-value
    11171         no-error .
    11172         if error-status :error
    11173         or error-status :get-message(1) <> ""
    11174         then do:
    11175           undo move_block, retry move_block.
    11176         end.
    11177         for each buf_temp-browse-handle
    11178           where buf_temp-browse-handle.browse-type = 'width':u
    11179         on error undo move_block, retry move_block
    11180         :
    11181           assign
    11182             buf_temp-browse-handle.browse-handle :width
    11183               = buf_temp-browse-handle.browse-handle :width + p-change-value
    11184             no-error .
    11185           if error-status :error
    11186           or error-status :get-message(1) <> ""
    11187           then do:
    11188             undo move_block, retry move_block .
    11189           end.
    11190         end.
    11191         for each buf_temp-diasize-handle
    11192         on error undo move_block, retry move_block
    11193         :
    11194           assign
    11195             v-object-handle = buf_temp-diasize-handle.handle-value
    11196           .
    11197           if v-object-handle <> v-diasize-resize-button
    11198           then do:
    11199             assign
    11200               v-object-handle :col = v-object-handle :col + p-change-value
    11201               no-error .
    11202             if error-status :error
    11203             or error-status :get-message(1) <> ""
    11204             then do:
    11205               undo move_block, retry move_block .
    11206             end.
    11207           end.
    11208         end.
    11209       end.
    11210       else do:
    11211         for each buf_temp-diasize-handle
    11212         on error undo move_block, retry move_block
    11213         :
    11214           assign
    11215             v-object-handle = buf_temp-diasize-handle.handle-value
    11216           .
    11217           if v-object-handle <> v-diasize-resize-button
    11218           then do:
    11219             assign
    11220               v-object-handle :col = v-object-handle :col + p-change-value
    11221               no-error .
    11222             if error-status :error
    11223             or error-status :get-message(1) <> ""
    11224             then do:
    11225               undo move_block, retry move_block .
    11226             end.
    11227           end.
    11228         end.
    11229         for each buf_temp-browse-handle
    11230           where buf_temp-browse-handle.browse-type = 'width':u
    11231         on error undo move_block, retry move_block
    11232         :
    11233           assign
    11234             buf_temp-browse-handle.browse-handle :width
    11235               = buf_temp-browse-handle.browse-handle :width + p-change-value
    11236             no-error .
    11237           if error-status :error
    11238           or error-status :get-message(1) <> ""
    11239           then do:
    11240             undo move_block, retry move_block .
    11241           end.
    11242         end.
    11243         assign
    11244           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
    11245           no-error .
    11246         if error-status :error
    11247         or error-status :get-message(1) <> ""
    11248         then do:
    11249           undo move_block, retry move_block.
    11250         end.
    11251         assign
    11252           frame d-utd :width = frame d-utd :width + p-change-value
    11253         no-error .
    11254         if error-status :error
    11255         or error-status :get-message(1) <> ""
    11256         then do:
    11257           undo move_block, retry move_block.
    11258         end.
    11259         if frame d-utd :scrollable = true
    11260         then do:
    11261           assign
    11262             frame d-utd :virtual-width = frame d-utd :virtual-width + p-change-value
    11263           no-error .
    11264           if error-status :error
    11265           or error-status :get-message(1) <> ""
    11266           then do:
    11267             undo move_block, retry move_block.
    11268           end.
    11269         end.
    11270       end.
    11271       if p-move-resize
    11272       then do:
    11273         run diasize_position-resize-button in this-procedure .
    11274       end.
    11275       if v-diasize-wndstore = true
    11276       then do:
    11277         if connected("ub") = true
    11278         then do:
    11279           define variable v-cntxt-db-num        as integer   no-undo .
    11280           define variable v-cntxt-userid        as character no-undo .
    11281           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    11282                                             , OUTPUT v-cntxt-userid
    11283                                             ) .
    11284           run gbl/wndsizew.p
    11285             (input  v-cntxt-db-num
    11286             ,input  v-cntxt-userid
    11287             ,input  v-diasize-proc-name
    11288             ,input  'width':u
    11289             ,input  string(frame d-utd :width - v-diasize-orig-frame-width)
    11290             ) .
    11291         end.
    11292       end.
    11293     end.
    11294     assign
    11295       v-diasize-change-size = false
    11296     .
    11297   end procedure.
    11298   procedure diasize_set-width :
    11299     define input  parameter p-new-width  as decimal   no-undo .
    11300     define input  parameter p-move-resize as logical   no-undo .
    11301     do
    11302     on error undo, return error return-value
    11303     :
    11304       run diasize_change-width in this-procedure
    11305         (input  (p-new-width - frame d-utd :width)
    11306         ,input  p-move-resize
    11307         ) .
    11308     end.
    11309   end procedure.
    11310   procedure diasize_position-resize-button :
    11311     do with frame d-utd
    11312     :
    11313       hide v-diasize-resize-button .
    11314       assign
    11315         v-diasize-resize-button :row = frame d-utd :height - v-diasize-resize-button :height
    11316                     - 1
    11317                     - (frame d-utd :border-bottom-pixels / session :pixels-per-row)
    11318         v-diasize-resize-button :col = frame d-utd :width - v-diasize-resize-button :width
    11319                     - 1
    11320                     - (frame d-utd :border-right-pixels / session :pixels-per-column)
    11321       .
    11322       view v-diasize-resize-button .
    11323     end.
    11324   end procedure.
    11325   on alt-right anywhere
    11326   do:
    11327     run diasize_change-width in this-procedure
    11328       (input 1
    11329       ,input true
    11330       ) .
    11331     return no-apply .
    11332   end.
    11333   on alt-left anywhere
    11334   do:
    11335     run diasize_change-width in this-procedure
    11336       (input -1
    11337       ,input true
    11338       ) .
    11339     return no-apply .
    11340   end.
    11341   on alt-down anywhere
    11342   do:
    11343     run diasize_change-height in this-procedure
    11344       (input 1
    11345       ,input true
    11346       ) .
    11347     return no-apply .
    11348   end.
    11349   on alt-up anywhere
    11350   do:
    11351     run diasize_change-height in this-procedure
    11352       (input -1
    11353       ,input true
    11354       ) .
    11355     return no-apply .
    11356   end.
    11357   on alt-enter of frame d-utd
    11358   do:
    11359     run diasize_maximize in this-procedure
    11360       (input  ?
    11361       ).
    11362     return no-apply .
    11363   end.
    11364   procedure diasize_end-move :
    11365     do
    11366     on error undo, return error return-value
    11367     :
    11368       define variable v-row-delta as decimal   no-undo .
    11369       define variable v-col-delta as decimal   no-undo .
    11370       define variable v-new-row as decimal   no-undo .
    11371       define variable v-new-col as decimal   no-undo .
    11372       assign
    11373         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    11374         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    11375       .
    11376       assign
    11377         v-row-delta = v-new-row - frame d-utd :height
    11378         v-col-delta = v-new-col - frame d-utd :width
    11379       .
    11380       run diasize_change-height in this-procedure
    11381         (input v-row-delta
    11382         ,input true
    11383         ) .
    11384       run diasize_change-width in this-procedure
    11385         (input v-col-delta
    11386         ,input true
    11387         ) .
    11388     end.
    11389   end procedure.
    11390   procedure diasize_maximize :
    11391     define input  parameter p-action as logical   no-undo .
    11392     do
    11393     on error undo, return error return-value
    11394     :
    11395       if p-action = ?
    11396       then do:
    11397         if v-diasize-need-maximize = true
    11398         then do:
    11399           assign
    11400             p-action = true
    11401           .
    11402         end.
    11403         else do:
    11404           assign
    11405             p-action = false
    11406           .
    11407         end.
    11408       end.
    11409       if p-action = true
    11410       then do:
    11411         run diasize_change-height in this-procedure
    11412           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    11413               - frame d-utd :height-chars
    11414           ,input true
    11415           ) .
    11416         run diasize_change-width in this-procedure
    11417           (input session :width-chars
    11418               - frame d-utd :width-chars
    11419           ,input true
    11420           ) .
    11421         assign
    11422           v-diasize-need-maximize = false
    11423         .
    11424       end.
    11425       else do:
    11426         run diasize_change-width in this-procedure
    11427           (input v-diasize-orig-frame-width
    11428               - frame d-utd :width-chars
    11429           ,input true
    11430           ) .
    11431         run diasize_change-height in this-procedure
    11432           (input v-diasize-orig-frame-height
    11433               - frame d-utd :height-chars
    11434           ,input true
    11435           ) .
    11436         assign
    11437           v-diasize-need-maximize = true
    11438         .
    11439       end.
    11440     end.
    11441   end procedure.
    11442   procedure diasize_restore-orig-size :
    11443     do
    11444     on error undo, return error return-value
    11445     :
    11446       assign
    11447         v-diasize-current-frame-width  = frame d-utd :width
    11448         v-diasize-current-frame-height = frame d-utd :height
    11449       .
    11450       run diasize_set-height in this-procedure
    11451         (input  v-diasize-orig-frame-height
    11452         ,input  true
    11453         ) .
    11454       run diasize_set-width in this-procedure
    11455         (input  v-diasize-orig-frame-width
    11456         ,input  true
    11457         ) .
    11458     end.
    11459   end procedure.
    11460   procedure diasize_restore-current-size :
    11461     do
    11462     on error undo, return error return-value
    11463     :
    11464       run diasize_set-height in this-procedure
    11465         (input  v-diasize-current-frame-height
    11466         ,input  true
    11467         ) .
    11468       run diasize_set-width in this-procedure
    11469         (input  v-diasize-current-frame-width
    11470         ,input  true
    11471         ) .
    11472     end.
    11473   end procedure.
    11474   procedure diasize_set-browse-handle :
    11475     define input  parameter p-browse-handle as handle   no-undo .
    11476     define buffer buf_temp-browse-handle for temp-browse-handle .
    11477     do
    11478     on error undo, return error return-value
    11479     :
    11480       assign
    11481         v-diasize-browse-handle = p-browse-handle
    11482       .
    11483       for each buf_temp-browse-handle
    11484       on error undo, return error return-value
    11485       :
    11486         delete buf_temp-browse-handle .
    11487       end.
    11488     end.
    11489   end procedure.
    11490   procedure diasize_add_browse :
    11491     define input  parameter p-browse-type   as character no-undo .
    11492     define input  parameter p-browse-handle as handle    no-undo .
    11493     define buffer buf_temp-browse-handle for temp-browse-handle .
    11494     do
    11495     on error undo, return error return-value
    11496     :
    11497       assign
    11498         v-diasize-browse-number = v-diasize-browse-number + 1
    11499       .
    11500       create buf_temp-browse-handle .
    11501       assign
    11502         buf_temp-browse-handle.browse-type   = p-browse-type
    11503         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    11504         buf_temp-browse-handle.browse-handle = p-browse-handle
    11505       .
    11506     end.
    11507   end procedure.
    11508   procedure diasize_init :
    11509     define variable v-default-value    as logical   no-undo .
    11510     define variable v-restore-saved    as logical   no-undo .
    11511     define variable v-resize-value-str as character no-undo .
    11512     do
    11513     on error undo, return error return-value
    11514     :
    11515       do with frame d-utd
    11516       :
    11517         assign
    11518           v-diasize-orig-frame-height = frame d-utd :height
    11519           v-diasize-orig-frame-width  = frame d-utd :width
    11520           v-diasize-browse-handle     = browse br-utd :handle
    11521         .
    11522         create button v-diasize-resize-button
    11523         assign
    11524           parent        = frame d-utd :first-child
    11525           label         = "s"
    11526           height-pixels = 16
    11527           width-pixels  = 16
    11528           visible       = true
    11529           sensitive     = true
    11530           movable       = true
    11531           triggers:
    11532             on end-move persistent run diasize_end-move in this-procedure .
    11533           end triggers.
    11534         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    11535         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    11536         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    11537         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    11538         assign
    11539           v-diasize-wndmax = false
    11540         .
    11541         if connected("ub") = true
    11542         then do:
    11543           define variable v-cntxt-db-num        as integer   no-undo .
    11544           define variable v-cntxt-userid        as character no-undo .
    11545           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    11546                                             , OUTPUT v-cntxt-userid
    11547                                             ) .
    11548           run gbl/wndpar_r.p
    11549             (input  v-cntxt-db-num
    11550             ,input  v-cntxt-userid
    11551             ,input  'wndmax':U
    11552             ,output v-diasize-wndmax
    11553             ,output v-default-value
    11554             ) .
    11555         end.
    11556         assign
    11557           v-diasize-wndstore = false
    11558         .
    11559         if connected("ub") = true
    11560         then do:
    11561           run gbl/wndpar_r.p
    11562             (input  v-cntxt-db-num
    11563             ,input  v-cntxt-userid
    11564             ,input  'wndstore':U
    11565             ,output v-diasize-wndstore
    11566             ,output v-default-value
    11567             ) .
    11568         end.
    11569         assign
    11570           v-diasize-proc-name = entry(1, program-name(2), '.')
    11571         .
    11572         if v-diasize-wndstore = true
    11573         then do:
    11574           assign
    11575             v-restore-saved = false
    11576           .
    11577           if connected("ub") = true
    11578           then do:
    11579             run gbl/wndsizer.p
    11580               (input  v-cntxt-db-num
    11581               ,input  v-cntxt-userid
    11582               ,input  v-diasize-proc-name
    11583               ,input  'height':u
    11584               ,output v-resize-value-str
    11585               ) .
    11586             if v-resize-value-str <> '':U
    11587             then do:
    11588               run diasize_change-height in this-procedure
    11589                 (input  integer(v-resize-value-str)
    11590                 ,input  true
    11591                 ) .
    11592               assign
    11593                 v-restore-saved = true
    11594               .
    11595             end.
    11596           end.
    11597           if connected("ub") = true
    11598           then do:
    11599             run gbl/wndsizer.p
    11600               (input  v-cntxt-db-num
    11601               ,input  v-cntxt-userid
    11602               ,input  v-diasize-proc-name
    11603               ,input  'width':u
    11604               ,output v-resize-value-str
    11605               ) .
    11606             if v-resize-value-str <> '':U
    11607             then do:
    11608               run diasize_change-width in this-procedure
    11609                 (input  integer(v-resize-value-str)
    11610                 ,input  true
    11611                 ) .
    11612               assign
    11613                 v-restore-saved = true
    11614               .
    11615             end.
    11616           end.
    11617           if v-restore-saved <> true
    11618           then do:
    11619             if v-diasize-wndmax = true
    11620             then do:
    11621               run diasize_maximize in this-procedure
    11622                 (input  true
    11623                 ) .
    11624             end.
    11625           end.
    11626         end.
    11627         else do:
    11628           if v-diasize-wndmax = true
    11629           then do:
    11630             run diasize_maximize in this-procedure
    11631               (input  true
    11632               ) .
    11633           end.
    11634         end.
    11635       end.
    11636     end.
    11637   end procedure.
    11638   procedure diasize_need-full-display :
    11639     define output parameter p-need-full-display as logical   no-undo .
    11640     do
    11641     on error undo, return error return-value
    11642     :
    11643       assign
    11644         p-need-full-display = v-diasize-need-full-display
    11645       .
    11646       assign
    11647         v-diasize-need-full-display = false
    11648       .
    11649     end.
    11650   end procedure.
    11651   procedure get-context :
    11652      define output parameter p-db-num as integer          no-undo.
    11653      define output parameter p-user-id as character        no-undo.
    11654      define variable v-login               as character    no-undo.
    11655      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    11656      define buffer buf_user-login  for ub.user-login .
    11657      do
    11658      on error undo, return error
    11659      :
    11660            FIND FIRST buf_sys-ctrl no-lock.
    11661            ASSIGN
    11662               v-login = USERID("ub")
    11663               p-db-num = buf_sys-ctrl.db-num
    11664            .
    11665            FIND FIRST buf_user-login
    11666                 WHERE buf_user-login.db-num = p-db-num
    11667                   AND buf_user-login.user-login = v-login
    11668                 no-lock
    11669                 no-error
    11670                 .
    11671            IF AVAILABLE buf_user-login
    11672            THEN DO:
    11673               assign
    11674                  p-user-id = buf_user-login.user-id
    11675               .
    11676            END.
    11677      end.
    11678   end procedure.
    11679     run diasize_init in this-procedure .
    11680     run enable_UI in this-procedure .
    11681     apply "value-changed" to br-utd IN FRAME d-utd.
    11682     WAIT-FOR GO OF FRAME d-utd focus br-utd .
    11683   END.
    11684   run disable_UI in this-procedure .
    11685   PROCEDURE disable_UI :
    11686     HIDE FRAME d-utd.
    11687   END PROCEDURE.
    11688   PROCEDURE enable_UI :
    11689       X_utd.DocumentExt:column-read-only in browse br-utd = yes .
    11690       if p-mode = "" then
    11691       do:
    11692           ENABLE
    11693               br-utd
    11694               b-exit
    11695               R-obj
    11696               b-utd
    11697               b-trn-doc
    11698               b-errors
    11699               b-hist
    11700               b-print
    11701               c-status
    11702               b-refresh
    11703               F-date-from
    11704               F-date-to
    11705               b-mark
    11706               bt-not-sel-all
    11707               bt-not-sel-desel-all
    11708               WITH FRAME d-utd.
    11709           display
    11710               B-write-sertif
    11711               F-sertif
    11712               F-date-from
    11713               F-date-to
    11714               with frame d-utd .
    11715           enable
    11716               b-choose-sertif
    11717               with frame d-utd .
    11718       end.
    11719       if p-mode = 'ВЫБОР':U then
    11720       do:
    11721           ENABLE
    11722               b-mark
    11723               bt-not-sel-all
    11724               br-utd
    11725               b-exit
    11726               bt-not-sel-desel-all
    11727               R-obj
    11728               c-status
    11729               F-date-from
    11730               F-date-to
    11731               WITH FRAME d-utd.
    11732           display     F-date-from
    11733               F-date-to
    11734               with frame d-utd .
    11735           disable
    11736               b-hist
    11737               b-refresh
    11738               b-print
    11739               B-write-sertif
    11740               F-sertif
    11741               b-choose-sertif
    11742               with frame d-utd .
    11743       end.
    11744       if v-current-sertif-string <> "" then
    11745       do:
    11746           v-sertif_num =  v-current-sertif-string .
    11747           F-sertif = v-sertif_num .
    11748           if f-sertif <> "" then
    11749           do:
    11750               enable       B-write-sertif with frame d-utd .
    11751           end.
    11752           else
    11753           do:
    11754               disable       B-write-sertif with frame d-utd .
    11755           end.
    11756           display
    11757               F-sertif
    11758               with frame d-utd .
    11759       end.
    11760   END PROCEDURE.
    11761   PROCEDURE init-sort :
    11762       define variable p-ok    as logical no-undo .
    11763       find first x_utd no-lock no-error .
    11764       if AVAILABLE (X_utd) then empty temp-table X_utd .
    11765       define variable mQuery as handle    no-undo.
    11766       define variable vqry   as character no-undo.
    11767       create query mQuery.
    11768       mQuery:set-buffers(buffer buf_utd:HANDLE).
    11769       vqry = substitute("FOR EACH buf_utd where buf_utd.EDocType = &1 and buf_utd.host-code = &2 and buf_utd.DocumentDate >= &3 and buf_utd.DocumentDate <= &4 no-lock" , EdocType:LK_RECEIPT:KeyIntDB, v-cntxt-host-code-obj, f-date-to, f-date-from).
    11770       mQuery:query-prepare(vqry).
    11771       mQuery:query-open ().
    11772       mQuery:get-first ().
    11773       do while not mQuery:query-off-end:
    11774         create X_utd .
    11775         buffer-copy buf_utd to X_utd .
    11776         X_utd.stts = StatusTHName(X_utd.sts).
    11777         X_utd.cli-name = CliName(X_utd.cli-code, X_utd.cli-type).
    11778         X_utd.EdoTypeName = EdoTypeName(X_utd.EDocType).
    11779         X_utd.GrayZone = no .
    11780         X_utd.obj-name = buf_utd.obj-type + " " + string(buf_utd.obj-code) .
    11781         mQuery:get-next ().
    11782       end.
    11783       delete object mQuery.
    11784       find first tt-obj-list no-error .
    11785       if available (tt-obj-list) then
    11786       do:
    11787         for each X_utd:
    11788           p-ok = false .
    11789           obj-list_ :
    11790           for each tt-obj-list:
    11791             if X_utd.obj-code = tt-obj-list.obj-code
    11792             and X_utd.obj-type = tt-obj-list.obj-type
    11793             then do :
    11794               p-ok = true.
    11795               leave obj-list_ .
    11796             end .
    11797           end.
    11798           if p-ok <> true then delete X_utd .
    11799         end.
    11800       end.
    11801       if c-status <> "-1"
    11802       then do:
    11803         if c-status = "0"
    11804         then do :
    11805           for each X_utd where X_utd.sts <> StatusTH:LK_RECEIPT_New:KeyIntDB
    11806                            and X_utd.sts <> StatusTH:LK_RECEIPT_Error:KeyIntDB
    11807                            and X_utd.sts <> StatusTH:LK_RECEIPT_SentDelete:KeyIntDB
    11808                            and X_utd.sts <> StatusTH:LK_RECEIPT_Signed:KeyIntDB
    11809           :
    11810             delete X_utd .
    11811           end.
    11812         end .
    11813         else do :
    11814           for each X_utd where X_utd.sts <> integer(c-status):
    11815             delete X_utd .
    11816           end.
    11817         end .
    11818       end.
    11819       apply "value-changed" to br-utd IN FRAME d-utd.
    11820   END PROCEDURE.
    11821   PROCEDURE init-temp :
    11822       define variable ii         as integer   no-undo .
    11823       define variable Status_    as character no-undo .
    11824       define variable Status_EDI as character no-undo .
    11825       define variable Edoc_type  as character no-undo .
    11826       Status_ = "Все" + chr(44) + '-1':U + chr(44)
    11827               + "В работе" + chr(44) + '0':U .
    11828       do ii = 1 to StatusTH:mapType:GetItemByLab(ii):
    11829           if StatusTH:CurrProp:KeyIntDB >= 50
    11830           and StatusTH:CurrProp:KeyIntDB < 60
    11831           then do :
    11832             Status_ = Status_ + chr(44) + StatusTH:CurrProp:Label_ + chr(44) + string(StatusTH:CurrProp:KeyIntDB) .
    11833           end .
    11834       end.
    11835       ASSIGN
    11836           c-status:LIST-ITEM-PAIRS  in frame d-utd = Status_ .
    11837       c-status = "0" .
    11838       display c-status with frame d-utd .
    11839       run proc-Token .
    11840       run init-sort .
    11841       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK INDEXED-REPOSITION.
    11842       apply "value-changed" to br-utd IN FRAME d-utd.
    11843   END PROCEDURE.
    11844   PROCEDURE proc-Token :
    11845       define buffer buf_ext-system      for ub.ext-system .
    11846       define buffer buf_ext-system-attr for ub.ext-system-attr .
    11847       define variable oMotp as class ibs.th.bge.is_motp.is_motp no-undo .
    11848       for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'obj':U
    11849           and buf_ext-system-attr.esya-attr-value  = v-cntxt-obj-type + string(v-cntxt-obj-code)
    11850           :
    11851           find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
    11852               and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
    11853               no-error .
    11854           R-obj = 2 .
    11855           empty temp-table tt-obj-list .
    11856           create tt-obj-list .
    11857           assign
    11858               tt-obj-list.obj-code = v-cntxt-obj-code
    11859               tt-obj-list.obj-type = v-cntxt-obj-type
    11860               .
    11861           obj-list = v-cntxt-obj-type + " " + string(v-cntxt-obj-code) .
    11862           display obj-list r-obj with frame d-utd .
    11863           disable bt-sel-obj with frame d-utd .
    11864           if available buf_ext-system then leave .
    11865       end .
    11866       if not available buf_ext-system
    11867           then
    11868           for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'host-code':U
    11869               and buf_ext-system-attr.esya-attr-value  = string(v-cntxt-host-code-obj)
    11870               :
    11871               find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
    11872                   and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
    11873                   no-error .
    11874               if available buf_ext-system then leave .
    11875           end .
    11876       if not available buf_ext-system
    11877           then
    11878       do :
    11879           if v-mes-Token then
    11880           do:
    11881               message "Нет внешней системы с типом ИС МОТП" view-as alert-box .
    11882               return .
    11883           end.
    11884           else return .
    11885       end.
    11886       v-mes-Token = no .
    11887       oMotp = new is_motp(buf_ext-system.db-num, buf_ext-system.esys-id) .
    11888       time_motp = oMotp:currTokenDT .
    11889       if oMotp:currToken = ""
    11890       or oMotp:currToken = ?
    11891       then do :
    11892           if f-sertif <> ? and f-sertif <> "" then
    11893           do:
    11894             vToken = oMotp:authorize(input f-sertif, input "SerialNumber") no-error .
    11895             if error-status:error
    11896                 then
    11897             do:
    11898                 time_motp = oMotp:currTokenDT .
    11899                 vtime = max(0,time_motp + 10500000 - now).
    11900                 if vtime = 0 then v-Token-error = true .
    11901                 else v-Token-error = false .
    11902                 message "Ошибка авторизации в ГИС МТ." skip oMotp:MSG view-as alert-box .
    11903             end.
    11904             else
    11905             do:
    11906                 time_motp = oMotp:currTokenDT .
    11907                 v-Token-error = false.
    11908             end.
    11909         end.
    11910         else
    11911         do:
    11912             time_motp = oMotp:currTokenDT .
    11913             vtime = max(0,time_motp + 10500000 - now).
    11914             if vtime = 0 then v-Token-error = true .
    11915             else v-Token-error = false .
    11916         end.
    11917       end .
    11918       delete object oMotp.
    11919   END PROCEDURE.
    11920   FUNCTION CliName RETURNS CHARACTER
    11921       (input p-cli-code as integer, input p-cli-type as character) :
    11922       define variable v-cli-name as character no-undo .
    11923       find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
    11924           and buf_clients.obj-type = p-cli-type no-error .
    11925       if available (buf_clients) then v-cli-name = buf_clients.obj-name .
    11926       RETURN v-cli-name.
    11927   END FUNCTION.
    11928   FUNCTION EdoTypeName RETURNS CHARACTER
    11929       ( input p-stsTH as integer ) :
    11930       RETURN EdocType:GetLabel(p-stsTH) .
    11931   END FUNCTION.
    11932   FUNCTION StatusTHName RETURNS CHARACTER
    11933       ( input p-stsTH as integer ) :
    11934       RETURN StatusTH:GetLabel(p-stsTH) .
    11935   END FUNCTION.
    11936   FUNCTION doc-type RETURNS CHARACTER
    11937       ( input p-doc-code as character ) :
    11938     define buffer bf_trn-doc for ub.trn-doc .
    11939     for first bf_trn-doc no-lock where bf_trn-doc.doc-code = p-doc-code :
    11940       case bf_trn-doc.ext-doc-type :
    11941         when 'wm':U then return "Производство" .
    11942         when 'vt':U then return "Инвентаризация" .
    11943         when 'we':U then return "Списание" .
    11944         otherwise do :
    11945           return "?" .
    11946         end .
    11947       end case .
    11948     end .
    11949   END FUNCTION.
