     8534     field stts-edi    as character
     8535     field cli-name    as character
     8536     field EDoTypeName as character
     8537     field ModifyTime_ as character
     8538     field orig-code   as character
     8539     field GrayZone    as logical
     8540     field obj-name    as character
     8541     field is-initial  as character
     8542     field scan-qnty   as decimal
     8543     field free-qnty   as decimal
     8544     .
     8545   define temp-table tt-sert-utd
     8546     field doc-id like ub.utd.doc-id
     8547     field db-num like ub.utd.db-num
     8548     field DocumentDate like ub.utd.DocumentDate
     8549     field DocumentNumber like ub.utd.DocumentNumber
