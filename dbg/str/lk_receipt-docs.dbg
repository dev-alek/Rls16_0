     1624   function setattrUtdlines returns logical
     1625   (idb-num   as integer,
     1626    idoc-id   as integer,
     1627    ilinenum  as integer,
     1628    iattrcode as character,
     1629    iattrval  as character ):
     1630      define buffer utd-lines-attr for utd-lines-attr.
     1631      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1632                                  and utd-lines-attr.doc-id    eq idoc-id
     1633                                  and utd-lines-attr.lineNum   eq ilineNum
     1634                                  and utd-lines-attr.attr-code eq iattrcode
     1635      no-lock no-error.
     1636      if not available utd-lines-attr
     1637      then do:
     1638         if iattrval ne ?
     1639            and iattrval ne ""
     1640         then do:
     1641            create utd-lines-attr.
     1642            assign
     1643               utd-lines-attr.db-num    = idb-num
     1644               utd-lines-attr.doc-id    = idoc-id
     1645               utd-lines-attr.lineNum   = ilineNum
     1646               utd-lines-attr.attr-code = iattrcode
     1647               utd-lines-attr.attr-value = iattrval
     1648            .
     1649         end.
     1650      end.
     1651      else do:
     1652         if utd-lines-attr.attr-value ne iattrval
     1653         then do:
     1654            find current utd-lines-attr exclusive-lock no-error.
     1655            if available utd-lines-attr
     1656            then do:
     1657               if    iattrval eq ?
     1658                  or iattrval eq ""
     1659               then do:
     1660                  delete utd-lines-attr.
     1661               end.
     1662               else do:
     1663                  utd-lines-attr.attr-value = iattrval.
     1664               end.
     1665            end.
     1666         end.
     1667      end.
     1668      release utd-lines-attr.
     1669   end.
