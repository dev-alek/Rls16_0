     1993                               p-out-string = p-out-string + " ":U
     1994                           .
     1995                       end.
     1996                       when chr(29)
     1997                       then do:
     1998                           assign
     1999                               p-out-string = p-out-string + " ":U
     2000                           .
     2001                       end.
     2002                       when chr(10)
     2003                       then do:
     2004                           assign
     2005                               p-out-string = p-out-string + " ":U
     2006                           .
     2007                       end.
     2008                       when chr(13)
     2009                       then do:
     2010                           assign
     2011                               p-out-string = p-out-string + " ":U
     2012                           .
     2013                       end.
     2014                       otherwise do:
     2015                           assign
     2016                               p-out-string = p-out-string + v-current-char
     2017                           .
     2018                       end.
     2019                   end case.
     2020               end.
     2021           end.
     2022       end case.
     2023   end.
     2024   end .
     2025   procedure xmlchar-decode :
     2026   define input parameter p-in-string      as character        no-undo.
     2027   define output parameter p-out-string    as character        no-undo.
     2028       define variable v-position      as integer      no-undo.
     2029       define variable v-last-position as integer      no-undo.
     2030       define variable v-temp-integer  as integer      no-undo.
     2031       define variable v-current-char  as character    no-undo.
     2032       define variable v-next-char     as character    no-undo.
     2033       define variable v-success       as logical      no-undo.
     2034   do
     2035   on error undo, return error
     2036   :
     2037       assign
     2038           p-out-string = "":U
     2039           v-position   = 0
     2040       .
     2041       replace-cycle:
     2042       do while yes
     2043       on error undo, return error
     2044       :
     2045           assign
     2046               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2047           .
     2048           if v-last-position <= v-position
     2049           then do:
     2050               if v-position = 0
     2051               then do:
     2052                   assign
     2053                       p-out-string = p-in-string
     2054                   .
     2055               end.
     2056               else do:
     2057                   assign
     2058                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2059                   .
     2060               end.
     2061               leave replace-cycle.
     2062           end.
     2063           else do:
     2064               assign
     2065                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2066                   v-position      = v-last-position
     2067                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2068               .
     2069               if v-current-char = "#":U
     2070               then do:
     2071                   assign
     2072                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2073                   .
     2074                   if v-last-position > 0
     2075                   then do:
     2076                       run xmlchar-read-integer in this-procedure
     2077                        (
     2078                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2079                           , output v-temp-integer
     2080                           , output v-success
     2081                       ).
     2082                       if v-success = yes
     2083                       and v-temp-integer >= 1
     2084                       and v-temp-integer <= 255
     2085                       then do:
     2086                           assign
     2087                               p-out-string = p-out-string + chr( v-temp-integer )
     2088                               v-position   = v-last-position + 1
     2089                           .
     2090                       end.
     2091                       else do:
     2092                           assign
     2093                               p-out-string = p-out-string + "&":U
     2094                               v-position   = v-position   + 1
     2095                           .
     2096                       end.
     2097                   end.
     2098                   else do:
     2099                       assign
     2100                           p-out-string = p-out-string + "&":U
     2101                           v-position   = v-position   + 1
     2102                       .
     2103                   end.
     2104               end.
     2105               else do:
     2106                   case substring( p-in-string, v-position + 1, 3 )
     2107                   :
     2108                       when "lt;":U
     2109                       then do:
     2110                           assign
     2111                               p-out-string = p-out-string + "<":U
     2112                               v-position   = v-position   + 3
     2113                           .
     2114                       end.
     2115                       when "gt;":U
     2116                       then do:
     2117                           assign
     2118                               p-out-string = p-out-string + ">":U
     2119                               v-position   = v-position   + 3
     2120                           .
     2121                       end.
     2122                       otherwise do:
     2123                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2124                           then do:
     2125                               assign
     2126                                   p-out-string = p-out-string + "&":U
     2127                                   v-position   = v-position   + 4
     2128                               .
     2129                           end.
     2130                           else do:
     2131                               case substring( p-in-string, v-position + 1, 5 )
     2132                               :
     2133                                   when "quot;":U
     2134                                   then do:
     2135                                       assign
     2136                                           p-out-string = p-out-string + '"':U
     2137                                           v-position   = v-position   + 5
     2138                                       .
     2139                                   end.
     2140                                   when "apos;":U
     2141                                   then do:
     2142                                       assign
     2143                                           p-out-string = p-out-string + "'":U
     2144                                           v-position   = v-position   + 5
     2145                                       .
     2146                                   end.
     2147                                   otherwise do:
     2148                                       assign
     2149                                           p-out-string = p-out-string + "&":U
     2150                                       .
     2151                                   end.
     2152                               end case.
     2153                           end.
     2154                       end.
     2155                   end case.
     2156               end.
     2157           end.
     2158       end.
     2159   end.
     2160   end .
     2161   procedure xmlchar-read-integer :
     2162   define input parameter p-input-string      as character        no-undo.
     2163   define output parameter p-output-integer   as integer          no-undo.
     2164   define output parameter p-success       as logical          no-undo.
     2165   do
     2166   on error undo, return error
     2167   :
     2168       assign
     2169           p-output-integer = integer( p-input-string )
     2170       no-error.
     2171       if error-status :error
     2172       then do:
     2173           assign
     2174               p-success           = no
     2175               p-output-integer    = 0
     2176           .
     2177       end.
     2178       else do:
     2179           assign
     2180               p-success           = yes
     2181           .
     2182       end.
     2183   end.
     2184   end.
     2185   define variable mMRCCode  as logical    no-undo.
     2186   define variable mTypeMark as character  no-undo.
     2187   function IS-NeedMark returns logical
     2188   ( input ib-code as integer  ,
     2189     input ib-str as character ):
     2190      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2191      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2192                                    and buf_prod-bc-attr.b-str  eq ib-str
     2193                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2194        no-lock no-error.
     2195      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2196   end.
     2197   function repTegforDm return char
     2198   (iDM as char ):
     2199       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2200       define variable vteg as character no-undo.
     2201       define variable oDM as character no-undo.
     2202       define variable vi as integer no-undo.
     2203       oDM = iDm.
     2204       do vi = 1 to num-entries(vTeglist):
     2205          vTeg = entry(vi,vTeglist).
     2206          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2207       end.
     2208       return oDM.
     2209   end.
     2210   function repSpecSimbforDm return char
     2211   (iDM as char ):
     2212       define variable oDM as character no-undo.
     2213     run
     2214       xmlchar-decode(iDM, output oDM).
     2215     return repTegforDm (oDM).
     2216   end.
     2217   function CheckGtin return logical
     2218   (iGtin as char):
     2219      define variable bar_code as character no-undo.
     2220      define variable vGtin as logical no-undo init "yes".
     2221      if length(iGtin) eq 14
     2222      then do:
     2223         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2224         run str/chk-sum.p
     2225          (input-output bar_code ) no-error .
     2226         if iGtin ne  bar_code
     2227         then
     2228            vGtin = no.
     2229      end.
     2230      else
     2231         vGtin = no.
     2232      return vgtin.
     2233   end.
     2234   function repSpecSimbforXlm return char
     2235   (iDM as char ):
     2236       iDM = replace(iDM,chr(29),"").
     2237       return iDM.
     2238   end.
     2239   function getGtinByDM return char
     2240   (IDM as char):
     2241      define variable VTXT as char no-undo.
     2242      define variable vGtin as char no-undo.
     2243      vTXt = IdM.
     2244      vGtin = IDM.
     2245      if    length(vtxt) > 14
     2246      then do:
     2247         if   vtxt begins "(01)"
     2248                or vtxt begins "(02)"
     2249         then
     2250            vGtin = substring(vtxt,5,14).
     2251         else if   (vtxt begins "01"
     2252                or vtxt begins "02" )
     2253                and (   (    substring(iDm,17,2) eq "21"
     2254                         and length(vtxt) >= 21)
     2255                     or substring(iDm,17,2) eq "37"
     2256                     or substring(iDm,17,4) eq "(37)" )
     2257         then do:
     2258            vGtin = substring(vtxt,3,14).
     2259            if not checkGtin(vGtin)
     2260            then
     2261               vGtin = substring(vtxt,1,14).
     2262         end.
     2263         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2264             or length(vtxt) eq 14 + 7 + 4
     2265             or length(vtxt) eq 14 + 7
     2266         then
     2267            vGtin = substring(vtxt,1,14).
     2268      end.
     2269      if not checkGtin(vGtin)
     2270      then
     2271         vGtin = "".
     2272      return vgtin.
     2273   end.
     2274   function getGdsCodeByGtin return int
     2275   (iGtin as char):
     2276      define buffer prod-bc  for ub.prod-bc.
     2277      define buffer bar-code for ub.bar-code.
     2278      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2279      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2280      return if avail bar-code then bar-code.gds-code else ?.
     2281   end.
     2282   function getQntyCodeByGtin return decimal
     2283   (iGtin as char):
     2284      define buffer prod-bc  for ub.prod-bc.
     2285      define buffer bar-code for ub.bar-code.
     2286      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2287      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2288      return if avail bar-code then bar-code.cli-base-rate else ?.
     2289   end.
     2290   function getGdsCodeByDM return int
     2291   (iDm as char):
     2292      define variable vGtin as char no-undo.
     2293      define buffer prod-bc for ub.prod-bc.
     2294      vGtin  = getGtinByDM (IDM ).
     2295      return getGdsCodeByGtin (vGtin).
     2296   end.
     2297   function ChekTypeMarkByGds return logical
     2298   (iGds-code as integer ):
     2299      define buffer goods-attr for ub.goods-attr.
     2300      find first goods-attr where goods-attr.gds-code   = iGds-code
     2301                              and goods-attr.attr-code  = 'mark-type':U
     2302      no-lock no-error.
     2303      if available goods-attr
     2304      then do:
     2305         mTypeMark = goods-attr.attr-value.
     2306         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2307           .
     2308      end.
     2309      else
     2310         return no.
     2311   end.
     2312   function ChekTypeMarkByDm return logical
     2313   (iDM as char ):
     2314      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2315   end.
     2316   function ChekTypeMarkByGtin return logical
     2317   (iGtin as char ):
     2318      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2319   end.
     2320   function GetNextElement return character
     2321     (input iAllTeg        as logical
     2322     ,output oteg          as character
     2323     ,output otegval       as character
     2324     ,input-output pstr    as character
     2325      ):
     2326        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2327        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2328        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2329        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2330        define variable vTeg as character no-undo.
     2331        define variable vLength as integer no-undo.
     2332        define variable vi as integer no-undo.
     2333        define variable vj as integer no-undo.
     2334        define buffer code for ub.code.
     2335        find first code where Code.parent eq "MarkType"
     2336                          and Code.CodeValue   eq mTypeMark
     2337                          no-lock no-error.
     2338        if     available code
     2339           and Code.misc1 ne ""
     2340           and Code.misc1 ne ?
     2341        then do:
     2342           integer (Code.misc1) no-error.
     2343           if not error-status:error
     2344           then
     2345             entry (4,vlistleng) = Code.misc1.
     2346        end.
     2347        if iAllTeg
     2348        then
     2349           assign
     2350              vlistElem     = vlistElem    + vlistElemDop
     2351              vlistleng     = vlistleng    + vlistlengDop
     2352           .
     2353        else if mMRCCode
     2354        then
     2355           assign
     2356              vlistElem     = vlistElem    + ",(8005),8005"
     2357              vlistleng     = vlistleng    + ",000006,0006"
     2358           .
     2359       block-elem:
     2360       do vi = 1 to num-entries(vlistElem):
     2361          vTeg = entry(vi,vlistElem).
     2362          if pstr begins vTeg
     2363          then do:
     2364             if    vTeg eq "21"
     2365             then
     2366                vLength = index(pstr,chr(29)) - 2 no-error.
     2367             if vLength  <= 0
     2368             then
     2369                vLength = int(entry(vi,vlistleng)).
     2370             otegval = substring (pstr,length(vteg) + 1, vLength).
     2371             oteg = replace(replace(vteg,")",""),"(","").
     2372             vTeg = vteg + otegval.
     2373             otegval = replace(otegval,chr(29),"").
     2374             oteg = replace(replace(oteg,")",""),"(","").
     2375             pstr = substring (pstr,length(vTeg)+ 1).
     2376             vTeg = replace(vTeg,chr(29),"").
     2377             leave block-elem.
     2378          end.
     2379          else
     2380             vTeg = "".
     2381       end.
     2382       return vteg.
     2383   end.
     2384   function GetCodeIdent return character
     2385   (iDm as char):
     2386      define variable Velement   as character no-undo init "first".
     2387      define variable oCodeIdent as character no-undo.
     2388      define variable vteg as character no-undo.
     2389      define variable vtegval as character no-undo.
     2390      define variable vGtin as character no-undo.
     2391      define buffer marking for ub.marking.
     2392      for first marking no-lock where
     2393                marking.mark eq iDm
     2394            and marking.unit-ext = "LEVEL2"
     2395      :
     2396        return iDm.
     2397      end.
     2398      vGtin  = getGtinByDM (iDm ).
     2399      ChekTypeMarkByDm(idm).
     2400      if iDm begins 'tech_':U
     2401      then
     2402         oCodeIdent = iDm.
     2403      else if length(iDm) < 21
     2404      then do:
     2405         find first marking where marking.mark eq idm
     2406         no-lock no-error.
     2407         oCodeIdent = if available marking then marking.mark else  ?.
     2408      end.
     2409      else if     length(iDm) eq 29
     2410         and not iDm begins "01"
     2411         and not iDm begins "02"
     2412      then
     2413         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2414      else  if     length(iDm) >= 24
     2415               and (  iDm begins "01"
     2416                   or iDm begins "02")
     2417               and  substring(iDm,17,2) ne "21"
     2418      then do:
     2419         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2420                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2421         then
     2422            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2423         else
     2424            oCodeIdent = iDM.
     2425      end.
     2426      else  if     (   length(iDm) eq 25
     2427                    or length(iDm) eq 21)
     2428               and (not iDm begins "01"
     2429               and  not iDm begins "02")
     2430      then
     2431         oCodeIdent = substring(iDm,1,21).
     2432      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2433      then
     2434         oCodeIdent = substring(iDm,1,21).
     2435      else do while Velement ne "" and idm ne "":
     2436         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2437         oCodeIdent = oCodeIdent + Velement.
     2438      end.
     2439      return oCodeIdent.
     2440   end.
     2441   function GetTegCod return character
     2442   (icodeIdent as char, iTeg as char):
     2443      define variable Velement   as character no-undo init "first".
     2444      define variable oTeg as character no-undo init ?.
     2445      define variable vteg as character no-undo.
     2446      define variable vtegval as character no-undo.
     2447      if     ((length(icodeIdent) eq 21
     2448         and not icodeIdent begins "01"
     2449         and not icodeIdent begins "02")
     2450         or
     2451             ( length(icodeIdent) eq 25
     2452               and not icodeIdent begins "01"
     2453               and not icodeIdent begins "02"))
     2454      then do:
     2455         if iTeg eq "01" or iTeg eq "02"
     2456         then
     2457            oTeg = substring(icodeIdent,1,21).
     2458         else  if  iTeg eq "21"
     2459         then
     2460            oTeg = substring(icodeIdent,15,7).
     2461      end.
     2462      else do:
     2463         ChekTypeMarkByDm(icodeIdent).
     2464         block-teg:
     2465            do while Velement ne "" and icodeIdent ne "":
     2466            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2467            if    Velement begins iTeg
     2468               or Velement begins "(" + iTeg + ")"
     2469            then do:
     2470               oTeg = vtegval.
     2471               leave block-teg.
     2472            end.
     2473         end.
     2474      end.
     2475      return oTeg.
     2476   end.
     2477   function isOAD return logical
     2478   (icodeIdent as character):
     2479      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2480   end.
     2481   function isMark return logical
     2482   (icodeIdent as character):
     2483      define buffer buf_marking for ub.marking.
     2484      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2485             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2486   end.
     2487   function addBracketForCode return character
     2488   (icodeIdent as char):
     2489      define variable Velement   as character no-undo init "first".
     2490      define variable oTeg as character no-undo.
     2491      define variable vteg as character no-undo.
     2492      define variable vtegval as character no-undo.
     2493      define buffer marking for ub.marking.
     2494      find first marking no-lock where
     2495                 marking.mark begins icodeIdent no-error.
     2496      if    not ChekTypeMarkByDm(icodeIdent)
     2497         or length(icodeIdent) le 24
     2498         or (avail marking and marking.unit-ext = "LEVEL2")
     2499      then
     2500         oTeg = icodeIdent.
     2501      else do:
     2502         if (  icodeIdent begins "01"
     2503            or icodeIdent begins "02"
     2504            ) and CheckGtin(substring (icodeIdent,3,14))
     2505            and substring (icodeIdent,17,2) eq "21"
     2506         then do:
     2507            mMRCCode = yes.
     2508            ChekTypeMarkByDm(icodeIdent).
     2509            block-teg:
     2510            do while Velement ne "" and icodeIdent ne "":
     2511               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2512               if vteg ne ""
     2513               then
     2514                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2515            end.
     2516            mMRCCode = no.
     2517         end.
     2518         else do:
     2519            oTeg = icodeIdent.
     2520         end.
     2521      end.
     2522      return oTeg.
     2523   end.
     2524   function getlevelByCodId return int
     2525   (iCode as char):
     2526      define variable vLength as int no-undo.
     2527      define variable vLevel  as int no-undo.
     2528      if not ChekTypeMarkByDM (icode) then return ?.
     2529      vLength = length(iCode).
     2530      if    vLength eq 18
     2531         or vLength eq 20
     2532      then
     2533         Vlevel = 4.
     2534      else if vLength eq 21
     2535      then
     2536         Vlevel = 1.
     2537      else if vLength eq 25
     2538      then do:
     2539         if  iCode begins "01"
     2540         then
     2541            Vlevel = 3.
     2542         else
     2543            Vlevel = 1.
     2544      end.
     2545      else if     vLength >= 26
     2546              and vLength <= 46
     2547      then do:
     2548         if    substring(iCode,17,2) eq "11"
     2549            or substring(iCode,17,2) eq "13"
     2550            or (    substring(iCode,17,2) eq "21"
     2551                and vLength >= 33
     2552                and substring(iCode,26,4) ne "8005")
     2553         then
     2554            Vlevel = 4.
     2555         else if    vLength eq 31
     2556                 or vLength eq 38
     2557                 or vLength eq 39
     2558                 or vLength eq 45
     2559         then
     2560            Vlevel = 1.
     2561         else if    vLength eq 35
     2562                 or vLength eq 43
     2563         then
     2564            Vlevel = 3.
     2565         else
     2566            Vlevel = ?.
     2567      end.
     2568      else
     2569         Vlevel = ?.
     2570      return Vlevel.
     2571   end.
     2572   function getLevelMotpBycodid return character
     2573   (iDm as char):
     2574      define variable vLevel as integer no-undo.
     2575      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2576      vLevel = getlevelByCodId(iDm).
     2577      if    vLevel eq ?
     2578         or vLevel < 1
     2579         or vLevel > 6
     2580      then
     2581         return ?.
     2582      else
     2583         return entry(vlevel,vList).
     2584   end.
     2585   function getLevelUTDByLevelMotp return character
     2586   (iUnit as char):
     2587      define variable vLevel as integer no-undo.
     2588      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2589      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2590      vLevel = lookup(iUnit,vListMOTP).
     2591      if    vLevel eq ?
     2592         or vLevel < 1
     2593         or vLevel > 4
     2594      then
     2595         return ?.
     2596      else
     2597         return entry(vlevel,vListutd).
     2598   end.
     2599   function getLevelMotpByDM return character
     2600   (iDm as char):
     2601      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2602   end.
     2603   function getLevelUTDByCodId return character
     2604   (iDm as char):
     2605      define variable vLevel as integer no-undo.
     2606      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2607      vLevel = getlevelByCodId(iDm).
     2608      if    vLevel eq ?
     2609         or vLevel < 1
     2610         or vLevel > 4
     2611      then
     2612         return ?.
     2613      else
     2614         return entry(vlevel,vList).
     2615   end.
     2616   function getLevelUTDByDM return character
     2617   (iDm as char):
     2618      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2619   end.
     2620   define variable mNotMarkQnty as logical no-undo.
     2621   function getQntyUTDByCodId return decimal
     2622   (iDM as char):
     2623      define variable vLevel as integer no-undo.
     2624      define variable vList as character no-undo init "1,5,10,500".
     2625      define variable vGtin as character no-undo.
     2626      define variable vqnty as decimal no-undo init ?.
     2627      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2628      if vqnty eq ?
     2629      then do:
     2630         if not mNotMarkQnty
     2631         then do:
     2632            define buffer marking for ub.marking.
     2633            define variable vCodident as character no-undo.
     2634            vCodident = GetCodeIdent(idm).
     2635            find first marking where marking.mark begins vCodident no-lock no-error.
     2636            if     available marking
     2637               and marking.box-qnty ne ?
     2638            then
     2639               return marking.box-qnty.
     2640         end.
     2641         vGtin = getGtinByDm(iDM).
     2642         if ChekTypeMarkByGtin (vGtin)
     2643         then do:
     2644            vLevel = getlevelByCodId(iDM).
     2645            if     vLevel >= 1
     2646               and vLevel <= 4
     2647            then
     2648               vqnty = int(entry(vlevel,vList)).
     2649         end.
     2650         else
     2651            vqnty = getQntyCodeByGtin(vgtin).
     2652      end.
     2653      return vqnty.
     2654   end.
     2655   function getQntyUTDByDM return decimal
     2656   (iDm as char):
     2657      define variable vDM as character no-undo.
     2658      if     length (iDm) ne 25
     2659         and length (iDm) ne 29
     2660         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2661      then
     2662         vDM = substring (iDm,1,length (iDm) - 6 ).
     2663      else
     2664         vDM = substring (iDm,1,length (iDm) - 4 ).
     2665      return getQntyUTDByCodId(vDM).
     2666   end.
     2667   function getMRC4 return decimal
     2668   (iMRC as char):
     2669      define variable oMrc     as decimal no-undo init ?.
     2670      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2671      define variable vi       as integer no-undo.
     2672      define variable vfound   as integer no-undo.
     2673      define variable vposStart   as integer no-undo.
     2674      do:
     2675      OMRc = 0.
     2676      do vi = 1 to 4:
     2677         define variable vsimb as character no-undo.
     2678         vsimb = substring(iMRC,vi,1).
     2679         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2680         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2681         if vfound > 0
     2682         then
     2683            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2684         end.
     2685         OMRc = OMRc / 100.
     2686      end.
     2687      return OMRc.
     2688   end.
     2689   function getMRCByDM return decimal
     2690   (iDm as char):
     2691      define variable vMRC     as character no-undo.
     2692      define variable oMrc     as decimal no-undo init ?.
     2693      define variable Velement as character no-undo init "empty".
     2694      define variable vteg as character no-undo.
     2695      define variable vtegval as character no-undo.
     2696      if    length(idm) eq 14 + 7 + 4 + 4
     2697         or length(idm) eq 14 + 7 + 4
     2698      then do:
     2699         vMRC = substring(idm,22,4).
     2700         omrc = getMRC4(vMRC).
     2701      end.
     2702      else do:
     2703          ChekTypeMarkByDm(iDm).
     2704          block-mrc:
     2705          do while Velement ne "" and idm ne "":
     2706             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2707             if Velement begins "8005"
     2708             then do:
     2709                vMRC = substring(Velement,5,6).
     2710                leave block-mrc.
     2711             end.
     2712             else if Velement begins "(8005)"
     2713             then do:
     2714                vMRC = substring(Velement,7,6).
     2715                leave block-mrc.
     2716             end.
     2717          end.
     2718          if vMRC ne ""
     2719          then
     2720             OMRc = dec(vmrc) / 100 no-error.
     2721      end.
     2722      return OMRc.
     2723   end.
     2724   function MoveDate return Date
     2725   (idate as date,
     2726    iMonth as int64):
     2727      define variable vMonth   as int64 no-undo.
     2728      define variable vYear    as int64 no-undo.
     2729      define variable vDateNew as date  no-undo.
     2730       define variable vDay     as int64 no-undo.
     2731       vMonth = month(iDate) + iMonth.
     2732       vYear =  year(iDate).
     2733       if vMonth <= 0
     2734       then assign
     2735          vMonth = vMonth + 12
     2736           vYear  = vYear - 1
     2737       .
     2738       else if vMonth > 12
     2739       then assign
     2740          vMonth = vMonth - 12
     2741           vYear  = vYear + 1
     2742       .
     2743       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2744       do while error-status:error eq yes:
     2745          VDay = vDay + 1.
     2746          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2747       end.
     2748       if VDay > 0
     2749       then
     2750          vDateNew + 1.
     2751       return vDateNew.
     2752   end.
     2753   procedure checkEMRC:
     2754   define input  parameter iDm as character no-undo.
     2755   define output parameter vok as logical   no-undo init yes.
     2756      define variable v-value-emrc as character no-undo.
     2757      define variable v-type-emrc  as character no-undo.
     2758      define variable vDateIso     as character no-undo.
     2759      define variable vMRC         as decimal no-undo.
     2760      define variable vqnty        as decimal no-undo.
     2761      define variable vPrice       as decimal no-undo.
     2762      define variable vparent      as character no-undo.
     2763      define variable vgds-code    as integer no-undo.
     2764      define buffer code for ub.code.
     2765      vMRC = getMRCByDM(iDm).
     2766      if vMRC > 0
     2767      then do:
     2768         vgds-code = getGdsCodeByDM(iDm).
     2769         vqnty     = getQntyUTDByDM(iDm).
     2770               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2771            (
     2772             input   vgds-code
     2773            ,input   'emrc-type':U
     2774            ,output   v-value-emrc
     2775            ,output   v-type-emrc
     2776          ) no-error.
     2777          if     v-value-emrc ne ""
     2778             and v-value-emrc ne ?
     2779          then do:
     2780             vDateIso = iso-date(today).
     2781             vPrice = vMRC / vqnty.
     2782             vparent ="emc" + chr(4) + v-value-emrc.
     2783             find last code where Code.parent      eq vparent
     2784                              and Code.code        le vDateIso
     2785                              and code.status_  eq 0
     2786             no-lock no-error.
     2787             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2788             then
     2789                vOk = true .
     2790             else do:
     2791                 define variable vText      as character no-undo.
     2792                 define variable vDate      as date no-undo.
     2793                 define variable vDateLast  as character no-undo.
     2794                 define variable vDateFirst as character no-undo.
     2795                 define variable vDate3     as date no-undo.
     2796                 vdate = date(code.misc1).
     2797                 vDateLast = code.misc1.
     2798                 vDate3 = MoveDate(today, - 3 ).
     2799                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2800                                      string(vDate3  , "99/99/9999"),
     2801                                      string(vDate   , "99/99/9999")
     2802                                      ).
     2803                 vdateIso = iso-date(vdate3).
     2804                 find last code  where Code.parent      eq vparent
     2805                                   and Code.code        le vDateIso
     2806                                   and code.status_  eq 0 no-lock no-error.
     2807                 if available code
     2808                 then
     2809                    vDateIso = code.code.
     2810                 vDateFirst = vDateIso.
     2811                 vDateLast = iso-date(vdate).
     2812                 define variable vGood as logical no-undo.
     2813                 define variable vDateSale as date no-undo.
     2814                 define buffer bcode for code.
     2815                 for last code where Code.parent   eq vparent
     2816                                 and code.status_  eq 0
     2817                                 and code.code     < vDateLast
     2818                                 and code.code     >= vDateFirst
     2819                 no-lock:
     2820                    find first bcode where bCode.parent   eq vparent
     2821                                       and bcode.status_  eq 0
     2822                                       and bcode.code     > code.code no-lock no-error.
     2823                    if available bcode
     2824                    then do:
     2825                       if vPrice < dec(Code.CodeValue)
     2826                       then
     2827                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2828                                                     chr(10),
     2829                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2830                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2831                                                     ).
     2832                       else do:
     2833                          vGood = yes.
     2834                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2835                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2836                                                     chr(10),
     2837                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2838                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2839                                                     string(         vDateSale            ,"99/99/9999"),
     2840                                                     string(vDateSale - today)
     2841                                                     ).
     2842                       end.
     2843                    end.
     2844                 end.
     2845                 if vgood
     2846                 then do:
     2847                    define variable choice as integer no-undo .
     2848                    run gbl/d-askw.w (input "Уточнение"
     2849                           ,input  vText
     2850                           ,input "|"
     2851                           ,input "Принять|Вернуть"
     2852                           ,input "Принять данный товар|Вернуть товар постащику"
     2853                           ,input 1
     2854                           ,input 2
     2855                           ,output choice) no-error.
     2856                    vok = choice eq 1.
     2857                 end.
     2858                 else
     2859                    vok =false.
     2860             end.
     2861          end.
     2862      end.
     2863   end.
     2864   function addGs2Mark return character
     2865   (iMark as char):
     2866      define variable vDM   as character no-undo.
     2867      define variable vIdx  as integer   no-undo.
     2868      if index(iMark,chr(29),1) > 0
     2869      then return iMark.
     2870      if substring(iMark,26,4) = "8005" then
     2871      do:
     2872        vIdx = index(iMark,"93",26 + 4 + 5).
     2873        if vIdx > 1 then do:
     2874          vDM = substitute("&1&4&2&4&3",
     2875                           substring(iMark,1,25),
     2876                           substring(iMark,26,vIdx - 25 - 1),
     2877                           substring(iMark,vIdx),
     2878                           chr(29)) no-error.
     2879          vIdx = index(vDm,"240",vIdx + 4).
     2880          if vIdx > 0 then
     2881          do:
     2882            vDM = substitute("&1&3&2",
     2883                             substring(vDm,1,vIdx - 1),
     2884                             substring(vDm,vIdx),
     2885                             chr(29)) no-error.
     2886          end.
     2887        end.
     2888        else
     2889          vDM = substitute("&1&3&2",
     2890                           substring(iMark,1,25),
     2891                           substring(iMark,26),
     2892                           chr(29)) no-error.
     2893      end.
     2894      else if substring(iMark,32,2) = "91" then
     2895      do:
     2896        vIdx = index(iMark,"92",32).
     2897        if vIdx > 1 then
     2898          vDM = substitute("&1&4&2&4&3",
     2899                           substring(iMark,1,31),
     2900                           substring(iMark,32,vIdx - 31 - 1),
     2901                           substring(iMark,vIdx),
     2902                           chr(29)) no-error.
     2903        else
     2904          vDM = substitute("&1&3&2",
     2905                           substring(iMark,1,31),
     2906                           substring(iMark,32),
     2907                           chr(29)) no-error.
     2908      end.
     2909      else if substring(iMark,39,2) = "91" then
     2910      do:
     2911        vIdx = index(iMark,"92",38).
     2912        if vIdx > 1 then
     2913          vDM = substitute("&1&4&2&4&3",
     2914                           substring(iMark,1,38),
     2915                           substring(iMark,39,vIdx - 38 - 1),
     2916                           substring(iMark,vIdx),
     2917                           chr(29)) no-error.
     2918        else
     2919          vDM = substitute("&1&3&2",
     2920                           substring(iMark,1,38),
     2921                           substring(iMark,39),
     2922                           chr(29)) no-error.
     2923      end.
     2924      else if substring(iMark,25,2) = "93" then
     2925      do:
     2926        vIdx = index(iMark,"92",25).
     2927        if vIdx > 1 then
     2928          vDM = substitute("&1&4&2&4&3",
     2929                           substring(iMark,1,24),
     2930                           substring(iMark,25,vIdx - 24 - 1),
     2931                           substring(iMark,vIdx),
     2932                           chr(29)) no-error.
     2933        else
     2934          vIdx = index(iMark,"3103",25).
     2935          if vIdx > 0 then
     2936          vDM = substitute("&1&4&2&4&3",
     2937                           substring(iMark,1,24),
     2938                           substring(iMark,25,vIdx - 24 - 1),
     2939                           substring(iMark,vIdx),
     2940                           chr(29)) no-error.
     2941          else
     2942            vDM = substitute("&1&3&2",
     2943                             substring(iMark,1,24),
     2944                             substring(iMark,25),
     2945                             chr(29)) no-error.
     2946      end.
     2947      else if substring(iMark,32,2) = "93" then
     2948      do:
     2949        vDM = substitute("&1&3&2",
     2950              substring(iMark,1,31),
     2951              substring(iMark,32),
     2952              chr(29)) no-error.
     2953      end.
     2954      return if vDM <> "" then vDm else iMark.
     2955   end.
     2956   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2957   function AddUtdErrForTab returns logical
     2958   (idb-num         as integer ,
     2959    idoc-id         as integer ,
     2960    iTab            as character,
     2961    iObj            as handle ,
     2962    iCheckType      as character,
     2963    iCodeErr        as character,
     2964    iCheckObj       as character ):
     2965      define buffer utd-err for utd-err.
     2966      define buffer utd for utd.
     2967      find first utd where utd.db-num     eq idb-num
     2968                       and utd.doc-id     eq idoc-id
     2969                       and utd.Direction  eq 'Outbound'
     2970      no-lock no-error.
     2971      if available utd
     2972      then
     2973         return no.
     2974      define variable vRecKey as character no-undo.
     2975            run gen-key-rec (input iTab,
     2976                             input  iObj,
     2977                             output vRecKey).
     2978      find first utd-err where utd-err.db-num     eq idb-num
     2979                           and utd-err.doc-id     eq idoc-id
     2980                           and utd-err.CheckType  eq iCheckType
     2981                           and utd-err.CodeErr    eq iCodeErr
     2982                           and utd-err.CheckObj   eq iCheckObj
     2983      exclusive-lock no-error.
     2984      if not available utd-err
     2985      then do:
     2986         create utd-err.
     2987         assign
     2988            utd-err.db-num         = idb-num
     2989            utd-err.doc-id         = idoc-id
     2990            utd-err.CheckType      = iCheckType
     2991            utd-err.CodeErr        = iCodeErr
     2992            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2993            utd-err.reckey         = vRecKey
     2994            utd-err.qnty           = 1
     2995         .
     2996      end.
     2997      else
     2998         utd-err.qnty = utd-err.qnty + 1.
     2999      return utd-err.qnty eq 1.
     3000   end.
     3001   function AddUtdErr returns logical
     3002   (idb-num         as integer ,
     3003    idoc-id         as integer ,
     3004    iObj            as handle ,
     3005    iCheckType      as character,
     3006    iCodeErr        as character,
     3007    iCheckObj       as character ):
     3008      AddUtdErrForTab
     3009         (idb-num,
     3010          idoc-id,
     3011          iObj:table,
     3012          iObj,
     3013          iCheckType,
     3014          iCodeErr,
     3015          iCheckObj).
     3016   end.
     3017   function ClearUtdErrTypeCode returns logical
     3018   (idb-num         as integer,
     3019    idoc-id         as integer ,
     3020    iCheckType      as character,
     3021    iCodeErr        as character
     3022    ):
     3023      define buffer utd-err for utd-err.
     3024      if    iCheckType eq "*"
     3025         or iCheckType eq ?
     3026      then do:
     3027         if     iCodeErr ne ?
     3028            and iCodeErr ne "*"
     3029         then
     3030            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3031            view-as alert-box.
     3032         else
     3033         for each utd-err where utd-err.db-num  eq idb-num
     3034                            and utd-err.doc-id  eq idoc-id
     3035         exclusive-lock:
     3036            delete utd-err.
     3037         end.
     3038      end.
     3039      else do:
     3040         if    iCodeErr eq ?
     3041            or iCodeErr eq "*"
     3042         then do:
     3043            for each utd-err where utd-err.db-num     eq idb-num
     3044                               and utd-err.doc-id     eq idoc-id
     3045                               and utd-err.CheckType  eq iCheckType
     3046            exclusive-lock:
     3047               delete utd-err.
     3048            end.
     3049         end.
     3050         else do:
     3051            for each utd-err where utd-err.db-num     eq idb-num
     3052                               and utd-err.doc-id     eq idoc-id
     3053                               and utd-err.CheckType  eq iCheckType
     3054                               and ub.utd-err.CodeErr eq iCodeErr
     3055            exclusive-lock:
     3056               delete utd-err.
     3057            end.
     3058         end.
     3059      end.
     3060   end.
     3061   function ClearUtdErr returns logical
     3062   (idb-num         as integer,
     3063    idoc-id         as integer ,
     3064    iCheckType      as character
     3065    ):
     3066      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3067   end.
     3068   function GetMesError returns character
     3069   (itxt as character,
     3070    iobj as character ):
     3071    define variable vi as integer no-undo.
     3072    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3073       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3074    end.
     3075    return itxt.
     3076   end.
     3077   function GetTextErrorType returns character
     3078   (iCheckType as character,
     3079    iCodeErr   as character,
     3080    iChechObj  as character,
     3081    iType      as character  ):
     3082      define buffer code    for code.
     3083      define variable vError as character no-undo.
     3084      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3085                        and code.code   eq iCodeErr
     3086      no-lock no-error.
     3087      if available code
     3088      then do:
     3089         define variable vType as integer no-undo.
     3090         if code.misc3 eq "error"
     3091         then
     3092            vType = 0.
     3093         else if code.misc3 eq "warning"
     3094         then
     3095            vType = 1.
     3096         else if code.misc3 eq "Hiden"
     3097         then
     3098            vType = 2.
     3099         else
     3100            vtype = int(code.misc3) no-error.
     3101         case itype:
     3102            when "error"
     3103            then do:
     3104               if vtype eq 0
     3105               then
     3106                  vError = GetMesError(Code.CodeValue,iChechObj).
     3107            end.
     3108            when "warning"
     3109            then do:
     3110               if vtype <= 1
     3111               then
     3112                  vError = GetMesError(Code.CodeValue,iChechObj).
     3113            end.
     3114            otherwise do:
     3115               vError = GetMesError(Code.CodeValue,iChechObj).
     3116            end.
     3117         end.
     3118      end.
     3119      else
     3120         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3121      return vError.
     3122   end.
     3123   function GetTypeError returns integer
     3124   (iCheckType as character,
     3125    iCodeErr   as character):
     3126      define buffer code    for code.
     3127      define variable vType as integer no-undo.
     3128      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3129                        and code.code   eq iCodeErr
     3130      no-lock no-error.
     3131      if     not available code
     3132         and code.misc3 eq "error"
     3133      then
     3134         vType = 0.
     3135      else if code.misc3 eq "warning"
     3136      then
     3137         vType = 1.
     3138      else if code.misc3 eq "Hiden"
     3139      then
     3140         vType = 2.
     3141      else
     3142         vtype = int(code.misc3) no-error.
     3143      return vtype.
     3144   end.
     3145   function GetTextError returns character
     3146   (iCheckType as character,
     3147    iCodeErr   as character,
     3148    iChechObj  as character ):
     3149      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3150   end.
     3151   function GetErrForUtdStr returns character
     3152   (idb-num     as integer ,
     3153    idoc-id     as integer ,
     3154    iCheckType  as character
     3155    ):
     3156      define buffer utd-err for utd-err.
     3157      define buffer code    for code.
     3158      define variable vHQry as handle no-undo.
     3159      define variable vError as longchar no-undo.
     3160      define variable vErrorOne as longchar  no-undo.
     3161      define variable oError as character no-undo.
     3162      create query vHQry.
     3163      vHQry:set-buffers(buffer utd-err:handle).
     3164      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3165                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3166                               + if    iCheckType eq "*"
     3167                                    or iCheckType eq ?
     3168                                 then       ""
     3169                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3170      vHQry:query-open().
     3171      vHQry:get-first().
     3172      QRY-BLOCK:
     3173      repeat while not vHQry:query-off-end:
     3174         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3175         if     vErrorOne ne ""
     3176            and vErrorOne ne ?
     3177         then
     3178            vError = vError + ", " + vErrorOne.
     3179         vHQry:get-next().
     3180      end.
     3181      oError = substring(vError,3,4002).
     3182      return oError.
     3183   end.
     3184   function GetErrJsonForUtd returns character
     3185   (idb-num         as integer ,
     3186    idoc-id         as integer ,
     3187    iCheckType      as character
     3188    ):
     3189      define buffer utd-err for utd-err.
     3190      define variable vHQry as handle no-undo.
     3191      define variable vError as longchar no-undo.
     3192      define variable oError as character no-undo.
     3193      create query vHQry.
     3194      define variable vi as integer no-undo.
     3195      vHQry:set-buffers(buffer utd-err:handle).
     3196      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3197                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3198                               + if    iCheckType eq "*"
     3199                                    or iCheckType eq ?
     3200                                 then       ""
     3201                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3202      vHQry:query-open().
     3203      vHQry:get-first().
     3204      QRY-BLOCK:
     3205      repeat while not vHQry:query-off-end:
     3206         define variable vErrorOne as character no-undo.
     3207         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3208         if     vErrorOne ne ?
     3209            and vErrorOne ne ""
     3210         then do:
     3211            vi = vi + 1.
     3212            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3213                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3214                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3215         end.
     3216         vHQry:get-next().
     3217      end.
     3218      for first utd where utd.db-num eq idb-num
     3219                      and utd.doc-id eq idoc-id
     3220                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3221      no-lock,
     3222         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3223                                  and utd-marking-lines.doc-id eq idoc-id
     3224                                  and utd-marking-lines.doc-level eq 1
     3225      no-lock,
     3226         first marking where marking.mark eq utd-marking-lines.mark
     3227                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3228      no-lock:
     3229         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3230         if     vErrorOne ne ?
     3231            and vErrorOne ne ""
     3232         then do:
     3233            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3234                            + '","ОбъектОш":"' + marking.mark
     3235                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3236         end.
     3237      end.
     3238      if vError ne ""
     3239      then
     3240         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3241      return oError.
     3242   end.
     3243   function GetErrJsonForUtdReturn returns character
     3244   (idb-num         as integer ,
     3245    idoc-id         as integer ,
     3246    iCheckType      as character
     3247    ):
     3248      define buffer utd-err for utd-err.
     3249      define variable vHQry as handle no-undo.
     3250      define variable vError as longchar no-undo.
     3251      define variable oError as character no-undo.
     3252      define variable vi as integer no-undo.
     3253      create query vHQry.
     3254      vHQry:set-buffers(buffer utd-err:handle).
     3255      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3256                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3257                               + if    iCheckType eq "*"
     3258                                    or iCheckType eq ?
     3259                                 then       ""
     3260                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3261      vHQry:query-open().
     3262      vHQry:get-first().
     3263      QRY-BLOCK:
     3264      repeat while not vHQry:query-off-end:
     3265         define variable vErrorOne as character no-undo.
     3266         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3267         if     vErrorOne ne ?
     3268            and vErrorOne ne ""
     3269         then do:
     3270            vi = vi + 1.
     3271            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3272                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3273                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3274         end.
     3275         vHQry:get-next().
     3276      end.
     3277      if vError ne ""
     3278      then
     3279         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3280      return oError.
     3281   end.
     3282   function GetCodeTextError returns character
     3283   (iCheckType as character,
     3284    iCodeErr   as character,
     3285    iChechObj  as character,
     3286    output oCode as character,
     3287    output ovalue as character ):
     3288      define buffer code    for code.
     3289      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3290                        and code.code   eq iCodeErr
     3291      no-lock no-error.
     3292      if     available code
     3293      then do:
     3294         define variable vi as integer no-undo init ?.
     3295         vi = int(Code.misc3) no-error.
     3296         if    code.misc3 ne "error"
     3297            and vi ne 0
     3298         then
     3299            oCode = ?.
     3300         else if     Code.misc1 ne ?
     3301                 and Code.misc1 ne ""
     3302         then
     3303            assign
     3304               oCode  = GetMesError(Code.misc1,iChechObj)
     3305               ovalue = GetMesError(Code.misc2,iChechObj)
     3306            .
     3307      end.
     3308      return if oCode eq ""
     3309             then ""
     3310             else (oCode + "_" + ovalue).
     3311   end.
     3312   define temp-table TT-err no-undo
     3313     field code_ as character
     3314     field text_ as character
     3315   index code_ code_.
     3316   function GetErrTxtForUtd returns character
     3317   (idb-num         as integer ,
     3318    idoc-id         as integer ,
     3319    iCheckType      as character
     3320    ):
     3321      define buffer utd-err for utd-err.
     3322      define variable vHQry as handle no-undo.
     3323      define variable oError as character no-undo.
     3324      create query vHQry.
     3325      define variable vi as integer no-undo.
     3326      for each tt-err :
     3327         delete tt-err.
     3328      end.
     3329      vHQry:set-buffers(buffer utd-err:handle).
     3330      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3331                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3332                               + if    iCheckType eq "*"
     3333                                    or iCheckType eq ?
     3334                                 then       ""
     3335                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3336      vHQry:query-open().
     3337      vHQry:get-first().
     3338      define variable vcode as character no-undo.
     3339      define variable vvalue as character no-undo.
     3340      QRY-BLOCK:
     3341      repeat while not vHQry:query-off-end:
     3342         vi = vi + 1.
     3343         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3344         if vcode ne ?
     3345         then do:
     3346            find first tt-err where tt-err.code eq vcode
     3347            no-error.
     3348            if not available tt-err
     3349            then do:
     3350               create tt-err.
     3351               assign
     3352                  tt-err.code_ = vcode
     3353                  tt-err.text_ = vvalue
     3354               .
     3355            end.
     3356            else
     3357               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3358         end.
     3359         vHQry:get-next().
     3360      end.
     3361     find first utd where utd.db-num eq idb-num
     3362                         and utd.doc-id eq idoc-id
     3363         no-lock.
     3364      define buffer cancel_utd-lines for utd-lines.
     3365      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3366                                  and cancel_utd-lines.doc-id eq idoc-id
     3367      no-lock:
     3368         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3369         then do:
     3370            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3371                                        and utd-marking-lines.doc-id eq idoc-id
     3372                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3373            no-lock,
     3374               first marking where marking.mark eq utd-marking-lines.mark
     3375                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3376            no-lock:
     3377               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3378               find first tt-err where tt-err.code eq vcode
     3379               no-error.
     3380               if not available tt-err
     3381               then do:
     3382                  create tt-err.
     3383                  assign
     3384                     tt-err.code_ = vcode
     3385                     tt-err.text_ = vvalue
     3386                  .
     3387               end.
     3388               else
     3389                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3390            end.
     3391         end.
     3392         else do:
     3393            define variable vqnty as decimal no-undo.
     3394            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3395            if vqnty eq ? then vqnty = 0.
     3396            if vqnty ne cancel_utd-lines.Quantity
     3397            then do:
     3398               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3399               find first tt-err where tt-err.code eq vcode
     3400               no-error.
     3401               if not available tt-err
     3402               then do:
     3403                  create tt-err.
     3404                  assign
     3405                     tt-err.code_ = vcode
     3406                     tt-err.text_ = vvalue
     3407                  .
     3408               end.
     3409               else
     3410                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3411            end.
     3412         end.
     3413      end.
     3414      for each tt-err:
     3415         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3416      end.
     3417      return oError.
     3418   end.
     3419   define variable mFormatErr as character no-undo init "text".
     3420   function GetErrForUtd returns character
     3421   (idb-num         as integer ,
     3422    idoc-id         as integer ,
     3423    iType           as character
     3424    ):
     3425      if mFormatErr eq "text"
     3426      then
     3427         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3428      else do:
     3429         if itype eq "return"
     3430         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3431         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3432      end.
     3433   end.
     3434   function GetErrComText returns longchar
     3435   (icomment as character,
     3436    itext    as longchar ):
     3437       define variable vText as longchar no-undo.
     3438      if mFormatErr eq "text"
     3439      then do:
     3440         if icomment ne ""
     3441         then
     3442            icomment = substitute("comment:|&1|",icomment).
     3443         vText = icomment + itext.
     3444      end.
     3445      else do:
     3446         icomment = if icomment begins  '"'
     3447                    then icomment
     3448                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3449         vText = icomment + "," + itext.
     3450         vText = "~{" + trim(vText,",") + "~}".
     3451      end.
     3452      return vText.
     3453   end.
     3454   function CheckTypeForMarkLineType returns logical
     3455   (iObj            as handle,
     3456    iCheckType      as character,
     3457    iCodeErr        as character ,
     3458    iTypeErr        as character ):
     3459      define variable vRecKey-markLine as character no-undo.
     3460      define variable vGoodMark        as logical no-undo.
     3461      define variable vdb-num          as integer no-undo.
     3462      define variable vdoc-id          as integer no-undo.
     3463      define variable vlinenum         as integer no-undo.
     3464      define variable vErrorOne as character no-undo.
     3465      define buffer buf_utd-err for utd-err.
     3466      run gen-key-rec (input "utd-marking-lines",
     3467                       input  iObj,
     3468                       output vRecKey-markLine).
     3469      vGoodMark = yes.
     3470      vdb-num = iObj::db-num.
     3471      vdoc-id = iObj::doc-id.
     3472      vlinenum = iObj::linenum.
     3473      block-mark-err:
     3474      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3475                               and buf_utd-err.db-num = vdb-num
     3476                               and buf_utd-err.reckey = vRecKey-markLine
     3477                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3478                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3479      no-lock:
     3480         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3481         if     vErrorOne ne ?
     3482            and vErrorOne ne ""
     3483         then do:
     3484            vGoodMark = no.
     3485            leave block-mark-err.
     3486         end.
     3487      end.
     3488      return not vGoodMark.
     3489   end.
     3490   function CheckErrForMarkLineType returns logical
     3491   (iObj            as handle,
     3492    iType           as character  ):
     3493      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3494   end.
     3495   function CheckErrForMarkLine returns logical
     3496   (iObj            as handle):
     3497      return CheckErrForMarkLineType(iObj,"*").
     3498   end.
     3499   function CheckErrForLineTypeCode returns logical
     3500   (iObj                 as handle,
     3501    iCheckType           as character,
     3502    iCodeErr             as character,
     3503    iTypeErr             as character,
     3504    iOneErr              as logical):
     3505      define variable vRecKey-line     as character no-undo.
     3506      define buffer buf_utd-err for utd-err.
     3507      define variable vUtdlineError as logical no-undo.
     3508      define variable vErrorOne as character no-undo.
     3509            run gen-key-rec (input "utd-lines",
     3510                             input  iObj,
     3511                             output vRecKey-line).
     3512         define variable vdb-num as integer no-undo.
     3513         define variable vdoc-id as integer no-undo.
     3514         define variable vlinenum as integer no-undo.
     3515         vdb-num = iObj::db-num.
     3516         vdoc-id = iObj::doc-id.
     3517         vlinenum = iObj::linenum.
     3518         block-err:
     3519         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3520                                  and buf_utd-err.db-num = vdb-num
     3521                                  and buf_utd-err.reckey = vRecKey-line
     3522                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3523                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3524         no-lock:
     3525            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3526            if     vErrorOne ne ?
     3527               and vErrorOne ne ""
     3528            then do:
     3529               vUtdlineError = yes.
     3530               leave block-err.
     3531            end.
     3532         end.
     3533         if  not vUtdlineError
     3534         then do:
     3535            define variable vGoodMark as logical no-undo.
     3536            vGoodMark = yes.
     3537            block-line-err:
     3538            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3539                                         and utd-marking-lines.doc-id  eq vdoc-id
     3540                                         and utd-marking-lines.LineNum eq vLineNum
     3541            no-lock:
     3542               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3543               if     vGoodMark
     3544                  and iOneErr eq no
     3545               then
     3546                  leave block-line-err.
     3547               if     iOneErr = yes
     3548                  and not vGoodMark
     3549               then
     3550                  leave block-line-err.
     3551            end.
     3552            vUtdlineError = not vGoodMark.
     3553         end.
     3554      return vUtdlineError.
     3555   end.
     3556   function getErrForLineType returns character
     3557   (iObj            as handle,
     3558    iType           as character  ):
     3559      define variable vRecKey-line     as character no-undo.
     3560      define buffer buf_utd-err for utd-err.
     3561      define variable vUtdlineError as logical no-undo.
     3562      define variable vErrorOne as character no-undo.
     3563      define variable oError as character no-undo.
     3564            run gen-key-rec (input "utd-lines",
     3565                             input  iObj,
     3566                             output vRecKey-line).
     3567         define variable vdb-num as integer no-undo.
     3568         define variable vdoc-id as integer no-undo.
     3569         define variable vlinenum as integer no-undo.
     3570         vdb-num = iObj::db-num.
     3571         vdoc-id = iObj::doc-id.
     3572         vlinenum = iObj::linenum.
     3573         block-err:
     3574         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3575                                  and buf_utd-err.db-num = vdb-num
     3576                                  and buf_utd-err.reckey = vRecKey-line
     3577                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3578         no-lock:
     3579            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3580            if     vErrorOne ne ?
     3581               and vErrorOne ne ""
     3582            then do:
     3583               oError = oError + vErrorOne + " ".
     3584            end.
     3585         end.
     3586      return oError.
     3587   end.
     3588   function CheckErrForLineType returns logical
     3589   (iObj            as handle,
     3590    iType           as character  ):
     3591       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3592   end.
     3593   function CheckErrForLine returns logical
     3594   (iObj            as handle):
     3595      return CheckErrForLineType(iobj,"*").
     3596   end.
     3597   function CheckErrForUtd returns logical
     3598   (idb-num         as integer ,
     3599    idoc-id         as integer ):
     3600      for each utd-lines where utd-lines.db-num eq idb-num
     3601                           and utd-lines.doc-id eq idoc-id
     3602      no-lock :
     3603         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3604         then
     3605            return no.
     3606      end.
     3607      return yes.
     3608   end.
     3609   function CheckMarkUtd-28rel return logical
     3610    (input idb-num as integer,
     3611    input idoc-id as integer):
     3612    define buffer utd                   for utd.
     3613    define buffer utd-lines             for utd-lines.
     3614    define buffer utd-marking-lines     for utd-marking-lines.
     3615    define variable v-par-type as character no-undo.
     3616    define variable vgdsNoMark as logical no-undo.
     3617    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3618      define variable v-par-val  as character no-undo.
     3619      find first utd where utd.db-num eq idb-num
     3620                       and utd.doc-id eq idoc-id
     3621      no-lock no-error.
     3622      if available utd
     3623      then do:
     3624         if     utd.obj-code ne ?
     3625            and utd.obj-type ne ?
     3626         then do:
     3627            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3628            Block-utd-lines:
     3629            for each utd-lines where utd-lines.db-num eq idb-num
     3630                                 and utd-lines.doc-id eq idoc-id
     3631            no-lock:
     3632               if     utd-lines.gds-code ne ?
     3633                  and utd-lines.gds-code ne 0
     3634               then do:
     3635                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3636                       ( utd-lines.gds-code,
     3637                         'mark-type':U,
     3638                          output v-par-val,
     3639                          output v-par-type
     3640                       ).
     3641                  if     EDOParSec:IsEdo
     3642                     and EDOParSec:GetIsEDOForType(v-par-val)
     3643                  then do:
     3644                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3645                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3646                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3647                                                    and length(utd-marking-lines.mark) > 13
     3648                     no-lock no-error.
     3649                     if     avail utd-marking-lines
     3650                        and not CheckErrForLine(buffer utd-lines:handle)
     3651                     then
     3652                        leave Block-utd-lines.
     3653                  end.
     3654                  else
     3655                     vgdsNoMark = yes.
     3656               end.
     3657            end.
     3658            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3659            if vgdsNoMark then return available utd-lines . else return yes .
     3660         end.
     3661      end.
     3662      return yes.
     3663   end.
     3664   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3665   define temp-table tt-utd-mark no-undo like utd-marking-lines
     3666     field side as character.
     3667   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3668   function CheckMarkUtd return logical
     3669    (input idb-num  as integer,
     3670     input idoc-id  as integer):
     3671     define buffer utd-lines             for ub.utd-lines.
     3672     block-line:
     3673     for each utd-lines where utd-lines.db-num eq idb-num
     3674                          and utd-lines.doc-id eq idoc-id
     3675     no-lock:
     3676        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3677        then
     3678           leave block-line.
     3679     end.
     3680     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3681     return available utd-lines.
     3682   end.
     3683   function CheckNotMarkUtd return logical
     3684    (input idb-num  as integer,
     3685     input idoc-id  as integer):
     3686     define buffer utd-lines             for ub.utd-lines.
     3687     for each utd-lines where utd-lines.db-num eq idb-num
     3688                          and utd-lines.doc-id eq idoc-id
     3689     no-lock:
     3690        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3691        then
     3692           return yes.
     3693     end.
     3694     return no.
     3695   end.
     3696   function CheckMarkUtdLine return logical
     3697    (input idb-num  as integer,
     3698     input idoc-id  as integer,
     3699     input iLineNum as integer):
     3700    define buffer utd                   for utd.
     3701    define buffer utd-lines             for utd-lines.
     3702    define buffer utd-marking-lines     for utd-marking-lines.
     3703    define variable v-par-type as character no-undo.
     3704    define variable vMarking        as logical no-undo.
     3705    define variable vArtic          as logical no-undo.
     3706    define variable vTransitional   as logical no-undo.
     3707    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3708      define variable v-par-val  as character no-undo.
     3709      find first utd where utd.db-num eq idb-num
     3710                       and utd.doc-id eq idoc-id
     3711      no-lock no-error.
     3712      if available utd
     3713      then do:
     3714         if     utd.obj-code ne ?
     3715            and utd.obj-type ne ?
     3716         then do:
     3717            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3718            Block-utd-lines:
     3719            for each utd-lines where utd-lines.db-num   eq idb-num
     3720                                 and utd-lines.doc-id   eq idoc-id
     3721                                 and utd-lines.LineNum  eq iLineNum
     3722            no-lock:
     3723               if     utd-lines.gds-code ne ?
     3724                  and utd-lines.gds-code ne 0
     3725               then do:
     3726                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3727                       ( utd-lines.gds-code,
     3728                         'mark-type':U,
     3729                          output v-par-val,
     3730                          output v-par-type
     3731                       ).
     3732                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3733                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3734                  if vMarking
     3735                  then do:
     3736                     block-marking:
     3737                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3738                                                    and utd-marking-lines.doc-id   eq idoc-id
     3739                                                    and utd-marking-lines.LineNum  eq iLineNum
     3740                                                    and length(utd-marking-lines.mark) > 13
     3741                     no-lock:
     3742                        if isOAD(utd-marking-lines.mark)
     3743                        then do:
     3744                           assign
     3745                              vArtic   = yes
     3746                              vMarking = no
     3747                           .
     3748                           leave block-marking.
     3749                        end.
     3750                     end.
     3751                  end.
     3752                  if vArtic
     3753                  then do:
     3754                     block-artic:
     3755                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3756                                                    and utd-marking-lines.doc-id   eq idoc-id
     3757                                                    and utd-marking-lines.LineNum  eq iLineNum
     3758                                                    and length(utd-marking-lines.mark) > 13
     3759                     no-lock:
     3760                        if isMark(utd-marking-lines.mark)
     3761                        then do:
     3762                           assign
     3763                              vArtic   = no
     3764                              vMarking = yes
     3765                           .
     3766                           leave block-artic.
     3767                        end.
     3768                     end.
     3769                  end.
     3770                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3771                  if vTransitional
     3772                  then do:
     3773                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3774                                                    and utd-marking-lines.doc-id   eq idoc-id
     3775                                                    and utd-marking-lines.LineNum  eq iLineNum
     3776                                                    and length(utd-marking-lines.mark) > 13
     3777                     no-lock no-error.
     3778                     if not available utd-marking-lines
     3779                     then assign
     3780                        vMarking = no
     3781                        vArtic   = no
     3782                     .
     3783                  end.
     3784               end.
     3785               else
     3786                  assign
     3787                     vMarking      = yes
     3788                     vArtic        = no
     3789                     vTransitional = no
     3790                  .
     3791               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3792               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3793               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3794            end.
     3795         end.
     3796      end.
     3797      return vMarking or vArtic.
     3798   end.
     3799   function getMarkUtdLine return logical
     3800    (input  idb-num  as integer,
     3801     input  idoc-id  as integer,
     3802     input  iLineNum as integer,
     3803     output oMarking        as logical,
     3804     output oArtic          as logical,
     3805     output oTransitional   as logical):
     3806     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3807     oArtic        = not oMarking
     3808            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3809     oTransitional = (oMarking or oArtic)
     3810            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3811   end.
     3812   function CheckMarking return logical
     3813    (input idb-num as integer,
     3814    input idoc-id as integer,
     3815    input iTypeErr as character ):
     3816     define variable vMarkutd as logical no-undo.
     3817     define variable vCrErr   as logical no-undo.
     3818     define buffer utd-lines         for utd-lines.
     3819     define buffer utd-marking-lines for utd-marking-lines.
     3820     define buffer marking           for marking.
     3821     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3822      block-line:
     3823      for each utd-lines where utd-lines.db-num eq idb-num
     3824                           and utd-lines.doc-id eq idoc-id
     3825      no-lock:
     3826         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3827         then do:
     3828            for each utd-marking-lines
     3829                     where utd-marking-lines.db-num  = utd-lines.db-num
     3830                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3831                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3832            no-lock:
     3833               if isMark(utd-marking-lines.mark)
     3834               then do:
     3835                  find first marking where marking.mark eq utd-marking-lines.mark
     3836                  no-lock no-error.
     3837                  if not available marking
     3838                  then do:
     3839                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3840                     vCrErr = yes.
     3841                     next block-line.
     3842                  end.
     3843               end.
     3844            end.
     3845         end.
     3846      end.
     3847      return vCrErr.
     3848   end.
     3849   function CheckMarkForType return logical
     3850    (input idb-num   as integer,
     3851     input idoc-id   as integer):
     3852      define variable vMarking        as logical no-undo.
     3853      define variable vArtic          as logical no-undo.
     3854      define variable vTransitional   as logical no-undo.
     3855      define buffer utd-lines         for utd-lines.
     3856      define buffer utd-marking-lines for utd-marking-lines.
     3857      block-line:
     3858      for each utd-lines where utd-lines.db-num eq idb-num
     3859                           and utd-lines.doc-id eq idoc-id
     3860      no-lock:
     3861         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3862                          output vMarking         , output vArtic          , output vTransitional).
     3863         for each utd-marking-lines
     3864                     where utd-marking-lines.db-num  = utd-lines.db-num
     3865                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3866                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3867         no-lock:
     3868            if length(utd-marking-lines.mark) < 14
     3869            then do:
     3870               if (vMarking or vArtic) and not vTransitional
     3871               then
     3872                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3873            end.
     3874            else if not isMark(utd-marking-lines.mark)
     3875            then do:
     3876               if vMarking
     3877               then
     3878                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3879            end.
     3880            else do:
     3881            end.
     3882         end.
     3883      end.
     3884   end.
     3885   function WeighedProd return logical
     3886      ( input p-gds-code as integer) :
     3887      define variable v-par-val  as character no-undo.
     3888      define variable v-par-type as character no-undo.
     3889              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3890               ( p-gds-code,
     3891                 'weighed-gds':U,
     3892                  output v-par-val,
     3893                  output v-par-type
     3894               ).
     3895      return logical(v-par-val).
     3896   end.
     3897   function WghProdVariable return logical
     3898       (input p-obj-type as char,
     3899        input p-obj-code as integer,
     3900        input p-gds-code as integer) :
     3901      define variable v-wgh-val  as character no-undo.
     3902      define variable v-par-val  as character no-undo.
     3903      define variable v-par-type as character no-undo.
     3904      define variable vMarking        as logical no-undo.
     3905      define variable vArtic          as logical no-undo.
     3906      define variable vTransitional   as logical no-undo.
     3907      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3908         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3909           ( p-gds-code,
     3910             'weighed-gds':U,
     3911              output v-wgh-val,
     3912              output v-par-type
     3913           ).
     3914       if logical(v-wgh-val) = yes then do:
     3915           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3916               ( p-gds-code,
     3917                 'mark-type':U,
     3918                  output v-par-val,
     3919                  output v-par-type
     3920               ).
     3921           if v-par-val <> "" then do:
     3922               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3923               assign
     3924                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3925                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3926                  .
     3927           end.
     3928      end.
     3929      if v-wgh-val > "" and (vMarking or vArtic)
     3930      then return yes.
     3931      else return no.
     3932   end.
     3933   function MarkWeight return decimal
     3934      ( input p-mark as character) :
     3935      define buffer  buf_marking-attr for  ub.marking-attr.
     3936      define variable vMarkWeight as decimal no-undo.
     3937      vMarkWeight = 0.
     3938      if p-mark <> "" and p-mark <> ?
     3939      then do:
     3940          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3941                                        and buf_marking-attr.attr-code eq "weight"
     3942             no-lock no-error.
     3943          if not available buf_marking-attr
     3944          then do :
     3945            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3946                                          and buf_marking-attr.attr-code eq "weight"
     3947               no-lock no-error.
     3948          end .
     3949          if avail buf_marking-attr
     3950          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3951      end.
     3952      return vMarkWeight.
     3953   end.
     3954   function CheckQnty returns logical
     3955   (  input idb-num  as integer,
     3956      input idoc-id  as integer,
     3957      input iErrType as character
     3958   ):
     3959      if iErrType ne "loadUTD"
     3960      then do:
     3961         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3962         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3963         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3964      end.
     3965      if iErrType ne "CheckQnty"
     3966      then do:
     3967         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3968         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3969         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3970      end.
     3971      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3972      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3973      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3974      define buffer marking               for marking.
     3975      define buffer utd-lines             for utd-lines.
     3976      define buffer utd-marking-lines     for utd-marking-lines.
     3977      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3978      block-line:
     3979      for each utd-lines where utd-lines.db-num eq idb-num
     3980                           and utd-lines.doc-id eq idoc-id
     3981      no-lock:
     3982         define variable Vflagmark as logical no-undo.
     3983         find first buf_utd-marking-lines
     3984                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3985                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3986                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3987                         and length(buf_utd-marking-lines.mark) > 13
     3988         no-lock no-error.
     3989         if not available buf_utd-marking-lines
     3990         then
     3991            next block-line.
     3992         define variable vqntyMark as integer no-undo.
     3993         define variable vqntyOAD  as integer no-undo.
     3994         vqntyMark = 0.
     3995         vqntyOAD  = 0.
     3996         block-mark:
     3997         for each utd-marking-lines
     3998              where utd-marking-lines.db-num  = utd-lines.db-num
     3999                and utd-marking-lines.doc-id  = utd-lines.doc-id
     4000                and utd-marking-lines.LineNum = utd-lines.LineNum
     4001                and length(utd-marking-lines.mark) > 13
     4002                and utd-marking-lines.doc-level  = 1
     4003         no-lock:
     4004            if isMark(utd-marking-lines.mark)
     4005            then do:
     4006               find first marking where marking.mark eq utd-marking-lines.mark
     4007               no-lock no-error.
     4008               if available marking
     4009               then do:
     4010                  if marking.box-qnty ne ?
     4011                  then
     4012                     vqntyMark = vqntyMark + marking.box-qnty.
     4013               end.
     4014            end.
     4015            else do:
     4016               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     4017                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     4018                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     4019                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     4020                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     4021               no-lock no-error.
     4022               if available utd-marking-lines-attr
     4023               then
     4024                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     4025            end.
     4026         end.
     4027         if     utd-lines.gds-code   gt 0
     4028            and utd-lines.gds-code   ne ?
     4029            and vqntyMark            ne 0
     4030         then do:
     4031            if utd-lines.Quantity  < vqntyMark
     4032            then
     4033               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4034            else if utd-lines.Quantity  <> vqntyMark
     4035            then
     4036               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4037         end.
     4038         else if     utd-lines.gds-code   gt 0
     4039            and utd-lines.gds-code   ne ?
     4040            and vqntyOAD ne 0
     4041            and utd-lines.Quantity  ne vqntyOAD
     4042         then
     4043            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     4044      end.
     4045   end.
     4046   function CheckGds returns logical
     4047   (  input idb-num   as integer,
     4048      input idoc-id   as integer,
     4049      input iobj-type as character,
     4050      input iobj-code as integer,
     4051      input iErrType as character
     4052   ):
     4053      if iErrType ne "loadUTD"
     4054      then do:
     4055         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     4056         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     4057         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     4058         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     4059         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     4060         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     4061         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     4062         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     4063         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     4064         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     4065         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     4066      end.
     4067      if iErrType ne "CheckGds"
     4068      then do:
     4069         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     4070         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     4071         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     4072         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     4073         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     4074         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     4075         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     4076         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     4077         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     4078         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     4079         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     4080      end.
     4081      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     4082      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     4083      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     4084      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     4085      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     4086      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     4087      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     4088      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     4089      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     4090      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     4091      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     4092      define variable v-par-type as character no-undo.
     4093      define variable v-par-val  as character no-undo.
     4094      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4095      define buffer marking               for marking.
     4096      define buffer utd-lines             for utd-lines.
     4097      define buffer buf_utd-lines         for utd-lines.
     4098      define buffer utd-marking-lines     for utd-marking-lines.
     4099      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4100      define variable vGdsCode as integer no-undo.
     4101      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     4102      block-line:
     4103      for each utd-lines where utd-lines.db-num eq idb-num
     4104                           and utd-lines.doc-id eq idoc-id
     4105      no-lock:
     4106         vGdsCode = ?.
     4107         define variable Vflagmark as logical no-undo.
     4108         define variable VflagOAD  as logical no-undo.
     4109         assign
     4110            Vflagmark = no
     4111            VflagOAD = no
     4112         .
     4113         block-mark:
     4114         for each utd-marking-lines
     4115                  where utd-marking-lines.db-num  = utd-lines.db-num
     4116                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4117                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4118         no-lock:
     4119            if    isMark(utd-marking-lines.mark)
     4120               or isOAD (utd-marking-lines.mark)
     4121            then do:
     4122               define variable vnewGdsCode as integer no-undo.
     4123               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     4124               if isMark(utd-marking-lines.mark)
     4125               then do:
     4126                  Vflagmark = yes.
     4127                  find first marking where marking.mark eq utd-marking-lines.mark
     4128                  no-lock no-error.
     4129                  if not available marking
     4130                  then do:
     4131                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     4132                     next block-mark.
     4133                  end.
     4134                  if vnewGdsCode eq ?
     4135                  then
     4136                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     4137                  if    marking.gds-code eq 0
     4138                     or marking.gds-code eq ?
     4139                     or marking.sts eq 0
     4140                     or marking.sts eq ?
     4141                     or marking.box-qnty eq ?
     4142                     or (marking.gds-code ne vnewGdsCode
     4143                         and vnewGdsCode ne ?
     4144                         and vnewGdsCode ne 0)
     4145                  then do:
     4146                     find first marking where marking.mark eq utd-marking-lines.mark
     4147                     exclusive-lock no-error.
     4148                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     4149                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     4150                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     4151                     if    marking.gds-ext-id eq ""
     4152                        or marking.gds-ext-id eq ?
     4153                     then do:
     4154                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     4155                     end.
     4156                     else if    marking.gds-code eq 0
     4157                             or marking.gds-code eq ?
     4158                     then
     4159                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     4160                     else if     marking.sts eq 0
     4161                             or  marking.sts eq ?
     4162                     then
     4163                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     4164                  end.
     4165                  if utd-marking-lines.doc-level eq 1
     4166                  then do:
     4167                     if marking.box-qnty eq ?
     4168                     then
     4169                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4170                  end.
     4171               end.
     4172               else do:
     4173                  VflagOAD = yes.
     4174                  define variable vQnty as decimal no-undo.
     4175                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     4176                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     4177                                          utd-marking-lines.doc-id,
     4178                                          utd-marking-lines.LineNum,
     4179                                          utd-marking-lines.mark,
     4180                                          "box-qnty",
     4181                                           string(vQnty)).
     4182                  define variable vgtin as character no-undo.
     4183                  vgtin = getGtinByDM(utd-marking-lines.mark).
     4184                  if getQntyCodeByGtin(vgtin) ne 1
     4185                  then
     4186                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     4187               end.
     4188               if utd-marking-lines.gds-code ne vnewGdsCode
     4189               and vnewGdsCode ne ?
     4190               and vnewGdsCode ne 0
     4191               then do:
     4192                  find first buf_utd-marking-lines
     4193                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4194                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4195                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4196                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4197                  exclusive-lock no-error.
     4198                  if available buf_utd-marking-lines
     4199                  then do:
     4200                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     4201                  end.
     4202               end.
     4203            end.
     4204            else  do:
     4205               define variable vgdsbar as integer no-undo.
     4206               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     4207               if    utd-marking-lines.gds-code ne vgdsbar
     4208               then do:
     4209                  find first buf_utd-marking-lines
     4210                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4211                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4212                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4213                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4214                  exclusive-lock no-error.
     4215                  if available buf_utd-marking-lines
     4216                  then do:
     4217                     buf_utd-marking-lines.gds-code = vgdsbar.
     4218                  end.
     4219               end.
     4220               if vgdsbar ne ?
     4221               then do:
     4222                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4223                            ( vgdsbar,
     4224                              'mark-type':U,
     4225                              output v-par-val,
     4226                              output v-par-type
     4227                             ).
     4228                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     4229                       or  EDOParSec:GetIsArticForType(v-par-val))
     4230                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     4231                   and     EDOParSec:IsEdo
     4232                  then do:
     4233                     AddUtdErr(utd-marking-lines.db-num,
     4234                               utd-marking-lines.doc-id,
     4235                               buffer utd-marking-lines:handle,
     4236                               iErrType,
     4237                               "MarkingForTypeEDO",
     4238                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4239                  end.
     4240               end.
     4241            end.
     4242            if vGdsCode eq ?
     4243            then
     4244               vGdsCode = utd-marking-lines.gds-code.
     4245            if vGdsCode ne utd-marking-lines.gds-code
     4246            and utd-marking-lines.gds-code > 0
     4247            then do:
     4248               vGdsCode = -1.
     4249            end.
     4250         end.
     4251         if  vGdsCode = -1
     4252         then do:
     4253            vGdsCode = ?.
     4254            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     4255            next block-line.
     4256         end.
     4257         if vGdsCode ne ?
     4258         then do:
     4259                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4260                      ( vGdsCode,
     4261                        'mark-type':U,
     4262                        output v-par-val,
     4263                        output v-par-type
     4264                       ).
     4265            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     4266                and(
     4267                 (    EDOParSec:GetIsEDOForType(v-par-val)
     4268                     and not Vflagmark)
     4269                 or  (EDOParSec:GetIsArticForType(v-par-val)
     4270                     and not VflagOAD
     4271                     and not Vflagmark))
     4272            then do:
     4273               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     4274            end.
     4275         end.
     4276         if utd-lines.gds-code ne vGdsCode
     4277         then do:
     4278            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4279                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4280                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     4281            exclusive-lock no-error.
     4282            if available buf_utd-lines
     4283            then
     4284               buf_utd-lines.gds-code = vGdsCode.
     4285            release buf_utd-lines.
     4286         end.
     4287         define variable VBarCode as character no-undo.
     4288         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     4289         if VBarCode ne ?
     4290         then do:
     4291            if num-entries(VBarCode," ") > 0
     4292            then
     4293               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     4294            vgdsbar = GetGdsCodeByGtin(VBarCode).
     4295            if vgdsbar eq ? or vgdsbar eq 0
     4296            then do:
     4297               AddUtdErr(utd-lines.db-num,
     4298                         utd-lines.doc-id,
     4299                         buffer utd-lines:handle,
     4300                         iErrType,
     4301                         "NotFindGdsForBarCode",
     4302                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     4303            end.
     4304            else do:
     4305               if    utd-lines.gds-code eq ?
     4306                  or utd-lines.gds-code eq 0
     4307               then do:
     4308                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4309                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4310                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4311                  exclusive-lock no-error.
     4312                  if available buf_utd-lines
     4313                  then
     4314                     buf_utd-lines.gds-code = vgdsbar.
     4315                  release buf_utd-lines.
     4316               end.
     4317               else if utd-lines.gds-code ne vgdsbar
     4318               then do:
     4319                  AddUtdErr(utd-lines.db-num,
     4320                         utd-lines.doc-id,
     4321                         buffer utd-lines:handle,
     4322                         iErrType,
     4323                         "NotEqGgsForLineAndMark",
     4324                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     4325               end.
     4326            end.
     4327         end.
     4328         if vGdsCode eq ? and utd-lines.gds-code eq ?
     4329         then
     4330            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     4331      end.
     4332   end.
     4333   function GetUtdLineForOrig return logical
     4334   (input idb-num as integer,
     4335    input idoc-id as integer,
     4336    input ilineNum as integer,
     4337    input idb-numOrig as integer,
     4338    input idoc-idOrig as integer,
     4339    buffer edoc-lines for utd-lines):
     4340      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4341      block-mark:
     4342      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     4343                                   and utd-marking-lines.doc-id  eq idoc-id
     4344                                   and utd-marking-lines.LineNum eq iLineNum
     4345                                   and utd-marking-lines.site eq "-"
     4346      no-lock:
     4347         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     4348                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     4349                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4350                     no-lock no-error.
     4351         if available edoc-marking-lines
     4352         then do:
     4353            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4354                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4355                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4356            no-lock no-error.
     4357               leave block-mark.
     4358          end.
     4359      end.
     4360       if not available edoc-lines
     4361       then do:
     4362          find  first  utd-lines where utd-lines.db-num      = idb-num
     4363                                   and utd-lines.doc-id      = idoc-id
     4364                                   and utd-lines.LineNum     = ilinenum
     4365             no-lock no-error.
     4366          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4367                                  and edoc-lines.doc-id      = idoc-idOrig
     4368                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     4369          no-lock no-error.
     4370       end.
     4371       if not available edoc-lines
     4372       then
     4373          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4374                                  and edoc-lines.doc-id      = idoc-idOrig
     4375                                  and edoc-lines.gds-code    = utd-lines.gds-code
     4376          no-lock no-error.
     4377   end.
     4378   function GetLastUTDinPack returns logical
     4379   (input idb-num as integer,
     4380    input idoc-id as integer,
     4381    output odb-num as integer,
     4382    output odoc-id as integer ) forward.
     4383   function getObgFns return logical
     4384   (input iDocumentNumber   as character ,
     4385    input iFnsParticipantId as character ,
     4386    input ikpp              as character ,
     4387    output ohost-code       as integer,
     4388    output oobj-type        as character ,
     4389    output oobj-code        as integer ,
     4390    output otext            as character  ):
     4391       define buffer ext-classif   for ext-classif.
     4392       define buffer clients       for clients.
     4393       define buffer buf_clients   for clients.
     4394       define buffer clients-attr  for clients-attr.
     4395       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4396                                and ext-classif.charkey_three eq iFnsParticipantId
     4397       no-lock no-error.
     4398       if available ext-classif
     4399       then do:
     4400          if ext-classif.CharKey_One eq 'маг':U
     4401          then do:
     4402             assign
     4403                oobj-type = ext-classif.CharKey_One
     4404                oobj-code = ext-classif.Key#_One
     4405             .
     4406             find first clients
     4407                  where clients.obj-type   = ext-classif.CharKey_One
     4408                    and clients.obj-code   = ext-classif.Key#_One
     4409             no-lock no-error .
     4410             if available clients
     4411             then
     4412                ohost-code =  clients.host-code.
     4413          end.
     4414          else do:
     4415             find first clients
     4416                  where clients.obj-type   = ext-classif.CharKey_One
     4417                    and clients.obj-code   = ext-classif.Key#_One
     4418                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     4419             no-lock no-error .
     4420             if not available clients
     4421             then do:
     4422                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     4423                return no.
     4424             end.
     4425             ohost-code = ext-classif.Key#_One.
     4426             block-cl:
     4427             for each clients-attr
     4428                where clients-attr.attr-code  = 'kpp':U
     4429                  and clients-attr.obj-type   = 'маг':U
     4430                  and clients-attr.attr-value = ikpp
     4431                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     4432                                             and buf_clients.obj-code   = clients-attr.obj-code
     4433                                             and buf_clients.host-code  = ohost-code)
     4434             no-lock :
     4435                leave block-cl.
     4436             end.
     4437             if     available clients
     4438                and clients.obj-type eq 'маг':U
     4439             then do:
     4440                assign
     4441                   oobj-type = clients.obj-type
     4442                   oobj-code = clients.obj-code
     4443                .
     4444             end.
     4445             else if available clients-attr
     4446             then do:
     4447                assign
     4448                   oobj-type = clients-attr.obj-type
     4449                   oobj-code = clients-attr.obj-code
     4450                .
     4451             end.
     4452             else do:
     4453                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     4454                return yes.
     4455             end.
     4456          end.
     4457       end.
     4458       else do:
     4459          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     4460          return no.
     4461       end.
     4462       return ?.
     4463   end.
     4464   function CheckUcdForReturn return logical
     4465   (input idb-numUcd as integer,
     4466    input idoc-idUcd as integer,
     4467    input idb-numRet as integer,
     4468    input idoc-idRet as integer  ):
     4469       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     4470                                    and utd-marking-lines.doc-id eq idoc-idUcd
     4471                                    and utd-marking-lines.doc-level eq 1
     4472       no-lock:
     4473          create tt-utd-mark.
     4474          buffer-copy utd-marking-lines to tt-utd-mark
     4475          assign
     4476             tt-utd-mark.side = "+"
     4477          .
     4478       end.
     4479       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     4480                                    and utd-marking-lines.doc-id eq idoc-idRet
     4481                                    and utd-marking-lines.doc-level eq 1
     4482       no-lock:
     4483          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4484          no-lock no-error.
     4485          if available tt-utd-mark
     4486          then
     4487             tt-utd-mark.side = "".
     4488          else do:
     4489             create tt-utd-mark.
     4490             buffer-copy utd-marking-lines to tt-utd-mark
     4491             assign
     4492                tt-utd-mark.side = "-"
     4493             .
     4494          end.
     4495       end.
     4496       for each tt-utd-mark where  tt-utd-mark.side ne ""
     4497       no-lock:
     4498          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     4499       end.
     4500       for each tt-utd-mark:
     4501          delete tt-utd-mark.
     4502       end.
     4503   end.
     4504   function GetLastUTDinPackAft returns logical
     4505   (input idb-num as integer,
     4506    input idoc-id as integer,
     4507    output odb-num as integer,
     4508    output odoc-id as integer ) forward.
     4509   function SaturateAndCheckUTD return character
     4510   (input idb-num as integer,
     4511    input idoc-id as integer  ):
     4512      define buffer clients-attr          for clients-attr.
     4513      define buffer clients               for clients.
     4514      define buffer Utd                   for Utd.
     4515      define buffer utd_ret               for ub.utd.
     4516      define buffer utd-lines             for utd-lines.
     4517      define buffer buf_utd-lines         for utd-lines.
     4518      define buffer buf_utddoc-lines      for utd-lines.
     4519      define buffer marking               for marking.
     4520      define buffer marking-lines         for marking-lines.
     4521      define buffer utd-marking-lines     for utd-marking-lines.
     4522      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4523      define buffer contract              for contract.
     4524      define buffer old_utd               for Utd.
     4525      define variable vError as character no-undo.
     4526      define variable vGdsCode as integer no-undo.
     4527      define variable vcli-type as character no-undo.
     4528      define variable vcli-code as integer no-undo.
     4529      define variable vhost-code as integer no-undo init ?.
     4530      define variable vcontract-code as integer no-undo.
     4531      define variable vobj-type as character no-undo init ?.
     4532      define variable vobj-code as integer no-undo init ?.
     4533      define variable volddb-num as integer no-undo.
     4534      define variable volddoc-id as integer no-undo.
     4535      define variable vMark as logical no-undo.
     4536      define variable VUcd as logical no-undo.
     4537      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4538      define variable v-par-type as character no-undo.
     4539      define variable v-par-val  as character no-undo.
     4540      define variable VFileMark as logical no-undo.
     4541      define variable vunit     as int no-undo.
     4542      define variable vunitCode as character no-undo.
     4543      define variable vMarkingUtd as logical no-undo.
     4544      find first Utd where utd.db-num eq idb-num
     4545                       and utd.doc-id eq idoc-id
     4546      no-lock no-error.
     4547      if available Utd
     4548      then do:
     4549         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     4550         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     4551         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     4552         assign
     4553               vobj-type  = utd.obj-type
     4554               vobj-code  = utd.obj-code
     4555               vhost-code = utd.host-code
     4556         .
     4557         do:
     4558            define variable vtext       as character no-undo.
     4559            define variable vhost-code1 as integer   no-undo.
     4560            define variable vobj-type1  as character no-undo.
     4561            define variable vobj-code1  as integer   no-undo.
     4562             getObgFns
     4563                       (input utd.DocumentNumber ,
     4564                        input utd.obj-FnsParticipantId ,
     4565                        input utd.obj-kpp,
     4566                        output vhost-code1,
     4567                        output vobj-type1,
     4568                        output vobj-code1,
     4569                        output vtext ).
     4570            assign
     4571               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     4572               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     4573               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     4574            .
     4575            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     4576            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     4577            block-line:
     4578            for each utd-lines where utd-lines.db-num eq utd.db-num
     4579                                 and utd-lines.doc-id eq utd.doc-id
     4580            no-lock:
     4581               vGdsCode =?.
     4582               define variable vNotMarkForLine as logical no-undo.
     4583               vNotMarkForLine = no.
     4584               if not VUcd
     4585               then do:
     4586                  find first utd-marking-lines
     4587                       where utd-marking-lines.db-num  = utd-lines.db-num
     4588                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     4589                         and utd-marking-lines.LineNum = utd-lines.LineNum
     4590                  no-lock no-error.
     4591                  if not available utd-marking-lines
     4592                  then do:
     4593                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     4594                     vNotMarkForLine = yes.
     4595                  end.
     4596               end.
     4597               block-mark:
     4598               for each utd-marking-lines
     4599                  where utd-marking-lines.db-num  = utd-lines.db-num
     4600                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4601                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4602               no-lock:
     4603                  vMark = yes.
     4604                  if     isMark(utd-marking-lines.mark)
     4605                     and utd-marking-lines.gds-code  ne 0
     4606                     and utd-marking-lines.gds-code ne ?
     4607                  then do:
     4608                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4609                           ( utd-marking-lines.gds-code,
     4610                            'mark-type':U,
     4611                            output v-par-val,
     4612                            output v-par-type
     4613                            ).
     4614                      if     not VFileMark
     4615                         and not VUcd
     4616                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     4617                      then do:
     4618                          AddUtdErr(utd.db-num,
     4619                                     utd.doc-id,
     4620                                     buffer utd-marking-lines:handle,
     4621                                     "loadUtd",
     4622                                     "NotON_NSCHFDOPPRMARK",
     4623                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4624                     end.
     4625                  end.
     4626               end.
     4627               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     4628               then do :
     4629                  if     VUcd
     4630                  then do:
     4631                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     4632                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     4633                     if available buf_utddoc-lines
     4634                     then do:
     4635                        vGdsCode = buf_utddoc-lines.gds-code.
     4636                        vunitCode = buf_utddoc-lines.UnitCode.
     4637                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4638                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4639                        then
     4640                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4641                               "loadUtd",
     4642                               "UcdUnitChangForUtd",
     4643                               string(utd-lines.LineNum )                  + chr(4) +
     4644                               buf_utddoc-lines.UnitCode                   + chr(4) +
     4645                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4646                     end.
     4647                     if     utd-lines.UnitCode ne ?
     4648                        and utd-lines.UnitCode ne ""
     4649                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4650                     then
     4651                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4652                               "loadUtd",
     4653                               "UcdUnitChang",
     4654                               string(utd-lines.LineNum )                  + chr(4) +
     4655                               utd-lines.UnitCode                          + chr(4) +
     4656                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4657                  end.
     4658               end.
     4659               else
     4660                  vGdsCode = utd-lines.gds-code.
     4661               define variable vValText as character no-undo.
     4662               define variable vValDec  as decimal no-undo.
     4663               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     4664               if VValText = ?
     4665               then do:
     4666                  vValDec = utd-lines.Quantity.
     4667                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     4668               end.
     4669               else
     4670                  vValDec = dec(VValText).
     4671               release bar-code .
     4672               if     vGdsCode > 0 and vGdsCode ne ?
     4673               then do:
     4674                  assign
     4675                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     4676                     vunit = ?
     4677                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     4678                  no-error.
     4679                  if vunit ne 0 and vunit ne ?
     4680                  then do:
     4681                     find units where units.OKEI eq vunit no-lock no-error.
     4682                     if available units
     4683                     then
     4684                        vunitCode = units.unit-name.
     4685                  end.
     4686                  find first bar-code where bar-code.gds-code eq vGdsCode
     4687                                        and bar-code.unit-cli eq vUnitCode
     4688                  no-lock no-error.
     4689                  if not available bar-code
     4690                  then
     4691                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4692                               "loadUtd",
     4693                               "Unit",
     4694                               string(utd-lines.LineNum )                  + chr(4) +
     4695                               string(vGdsCode)                            + chr(4) +
     4696                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     4697                               vunitCode).
     4698               end.
     4699               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     4700               then do:
     4701                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4702                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4703                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4704                  exclusive-lock no-error.
     4705                  if available buf_utd-lines
     4706                  then do:
     4707                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     4708                     release buf_utd-lines.
     4709                  end.
     4710               end.
     4711               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     4712               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     4713               if     not VUcd
     4714                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     4715               then
     4716                  vMarkingUtd = yes .
     4717            end.
     4718            if not VUcd
     4719            then
     4720               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4721            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4722                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4723            no-lock no-error.
     4724            if available ext-classif
     4725            then
     4726               assign
     4727                  vcli-type = ext-classif.CharKey_One
     4728                  vcli-code = ext-classif.Key#_One
     4729               .
     4730            else do:
     4731               assign
     4732                 vcli-type = ?
     4733                 vcli-code = ?
     4734               .
     4735               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4736            end.
     4737            find first contract  where contract.host-code eq vhost-code
     4738                                   and contract.cli-type  eq vcli-type
     4739                                   and contract.cli-code  eq vcli-code
     4740                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4741            no-lock no-error.
     4742            define variable VContractEdo as logical no-undo init yes.
     4743            if available contract
     4744            then do:
     4745               assign
     4746                  VContractEdo = contract.whole-send-news > 0
     4747                  vcontract-code = contract.contract-code
     4748               .
     4749               if not VContractEdo
     4750               then
     4751                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4752            end.
     4753            else do:
     4754               vcontract-code = ?.
     4755            end.
     4756         end.
     4757         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4758         then do:
     4759            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4760         end.
     4761         define variable vdoc-code as character no-undo init ?.
     4762         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4763         then do:
     4764            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4765                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4766                                 and utd_ret.Timestamp             le utd.Timestamp
     4767                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4768            no-lock no-error.
     4769            if available utd_ret
     4770            then do:
     4771               vdoc-code = utd_ret.doc-code.
     4772               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4773            end.
     4774         end.
     4775      end.
     4776      find current utd exclusive-lock no-error.
     4777      if available utd
     4778      then do:
     4779         assign
     4780            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4781            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4782            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4783            utd.contract-code = vcontract-code when vcontract-code ne ?
     4784            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4785            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4786            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4787         .
     4788         if   ( utd.contract-code eq ?
     4789            or utd.contract-code eq 0)
     4790            and not vucd
     4791         then
     4792            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4793         if utd.host-code eq ?
     4794            or utd.host-code eq 0
     4795         then
     4796            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4797         if utd.obj-code eq ?
     4798            or utd.obj-code eq 0
     4799         then
     4800            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4801      end.
     4802      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4803      if vError eq ""
     4804      then do:
     4805         if utd.sts eq 0 or utd.sts eq ?
     4806         then
     4807            utd.sts = if VUcd
     4808                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4809                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4810         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4811         then do:
     4812            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4813         end.
     4814         if     not VUcd
     4815            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4816         then do:
     4817            if not vMarkingUtd
     4818            then
     4819               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4820         end.
     4821      end.
     4822      else do:
     4823         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4824         then
     4825            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4826      end.
     4827      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4828         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4829      then
     4830         utd.sts-edi = ?.
     4831      else if     (not vMark and  not vucd) or not VContractEdo
     4832              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4833      then
     4834         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4835      release utd no-error.
     4836      if error-status:error
     4837      then
     4838         return error return-value.
     4839      return vError.
     4840   end.
     4841   function ReCheckload returns logical
     4842   (idb-num as integer,
     4843    idoc-id as integer,
     4844    iload   as logical ):
     4845      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4846      define buffer buf_c-utd for ub.c-utd .
     4847      define buffer buf_utd   for ub.utd .
     4848      find first buf_utd where buf_utd.db-num eq idb-num
     4849                           and buf_utd.doc-id eq idoc-id
     4850      exclusive-lock no-error.
     4851      if available buf_utd
     4852      then do:
     4853         if    iload
     4854            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4855         then do:
     4856            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4857            if  error-status:error then
     4858            do:
     4859               message return-value view-as alert-box.
     4860            end.
     4861         end.
     4862         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4863            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4864            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4865            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4866         then do:
     4867            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4868                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4869                                              buf_c-utd.sts    eq buf_utd.sts and
     4870                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4871            no-error .
     4872            if available (buf_c-utd)
     4873            then do:
     4874               buf_utd.sts = buf_c-utd.sts .
     4875               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4876            end.
     4877            else do:
     4878               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4879                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4880               then
     4881                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4882               else
     4883                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4884               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4885            end.
     4886         end.
     4887         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4888         then do:
     4889            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4890                                     input buf_utd.doc-id) .
     4891         end.
     4892      end.
     4893      release buf_utd.
     4894      unsubscribe "getNextseq".
     4895   end.
     4896   function ReCheck returns logical
     4897   (idb-num as integer,
     4898    idoc-id as integer ):
     4899      ReCheckload(idb-num,idoc-id,no).
     4900   end.
     4901   function GetLastUTDForPac returns logical
     4902   (iPackegeId as character ,
     4903    iTimestamp as datetime,
     4904    output odb-num as integer,
     4905    output odoc-id as integer ):
     4906      define buffer buf_utd for utd.
     4907      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4908                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4909                                and Buf_utd.Timestamp gt iTimestamp
     4910      no-lock no-error.
     4911      if available  buf_utd
     4912      then
     4913         assign
     4914            odb-num = buf_utd.db-num
     4915            odoc-id = buf_utd.doc-id
     4916         no-error.
     4917      else
     4918         assign
     4919            odb-num = ?
     4920            odoc-id = ?
     4921         no-error.
     4922   end.
     4923   function GetprevUTDForPac returns logical
     4924   (iPackegeId as character ,
     4925    iTimestamp as datetime,
     4926    output odb-num as integer,
     4927    output odoc-id as integer ):
     4928      define buffer buf_utd for utd.
     4929      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4930                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4931                                and Buf_utd.Timestamp < iTimestamp
     4932      no-lock no-error.
     4933      if available  buf_utd
     4934      then
     4935         assign
     4936            odb-num = buf_utd.db-num
     4937            odoc-id = buf_utd.doc-id
     4938         no-error.
     4939      else
     4940         assign
     4941            odb-num = ?
     4942            odoc-id = ?
     4943         no-error.
     4944   end.
     4945   function GetLastUTDinPackAft returns logical
     4946   (input idb-num as integer,
     4947    input idoc-id as integer,
     4948    output odb-num as integer,
     4949    output odoc-id as integer ):
     4950      define buffer buf_utd for utd.
     4951      define buffer     utd for utd.
     4952      find first utd where utd.db-num eq idb-num
     4953                       and utd.doc-id eq idoc-id
     4954      no-lock no-error.
     4955      if available utd
     4956      then do:
     4957         if utd.PackageId eq ""
     4958         then do:
     4959            assign
     4960               odb-num = utd.db-num
     4961               odoc-id = utd.doc-id
     4962            .
     4963            return yes.
     4964         end.
     4965         else do:
     4966            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4967            if    odb-num eq ?
     4968               or odoc-id eq ?
     4969            then do:
     4970               assign
     4971                  odb-num = utd.db-num
     4972                  odoc-id = utd.doc-id
     4973               .
     4974               return yes.
     4975            end.
     4976            else
     4977               return odoc-id = utd.doc-id.
     4978         end.
     4979      end.
     4980      return ?.
     4981   end.
     4982   function GetLastUTDinPackbef returns logical
     4983   (input idb-num as integer,
     4984    input idoc-id as integer,
     4985    output odb-num as integer,
     4986    output odoc-id as integer ):
     4987      define buffer buf_utd for utd.
     4988      define buffer     utd for utd.
     4989      find first utd where utd.db-num eq idb-num
     4990                       and utd.doc-id eq idoc-id
     4991      no-lock no-error.
     4992      if available utd
     4993      then do:
     4994         if utd.PackageId eq ""
     4995         then do:
     4996            assign
     4997               odb-num = utd.db-num
     4998               odoc-id = utd.doc-id
     4999            .
     5000            return yes.
     5001         end.
     5002         else do:
     5003            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     5004            if    odb-num eq ?
     5005               or odoc-id eq ?
     5006            then do:
     5007               assign
     5008                  odb-num = utd.db-num
     5009                  odoc-id = utd.doc-id
     5010               .
     5011               return yes.
     5012            end.
     5013            else
     5014               return odoc-id = utd.doc-id.
     5015         end.
     5016      end.
     5017      return ?.
     5018   end.
     5019   function GetLastUTDinPack returns logical
     5020   (input idb-num as integer,
     5021    input idoc-id as integer,
     5022    output odb-num as integer,
     5023    output odoc-id as integer ):
     5024      define buffer buf_utd for utd.
     5025      define buffer     utd for utd.
     5026      find first utd where utd.db-num eq idb-num
     5027                       and utd.doc-id eq idoc-id
     5028      no-lock no-error.
     5029      if available utd
     5030      then do:
     5031         if utd.PackageId eq ""
     5032         then do:
     5033            assign
     5034               odb-num = utd.db-num
     5035               odoc-id = utd.doc-id
     5036            .
     5037            return yes.
     5038         end.
     5039         else do:
     5040            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     5041            if    odb-num eq ?
     5042               or odoc-id eq ?
     5043            then do:
     5044               assign
     5045                  odb-num = utd.db-num
     5046                  odoc-id = utd.doc-id
     5047               .
     5048               return yes.
     5049            end.
     5050            else
     5051               return odoc-id = utd.doc-id.
     5052         end.
     5053      end.
     5054      return ?.
     5055   end.
     5056   function delMark returns logical
     5057   ( buffer utd-marking-lines for utd-marking-lines ):
     5058      define buffer buf_utd-marking-line for utd-marking-lines.
     5059      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5060         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5061                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5062                                           and buf_utd-marking-line.mark      eq marking.mark
     5063         no-lock no-error.
     5064         if available  buf_utd-marking-line
     5065         then do:
     5066            delMark(buffer buf_utd-marking-line).
     5067            delete buf_utd-marking-line.
     5068         end.
     5069      end.
     5070   end.
     5071   function addMark returns logical
     5072   ( buffer utd-marking-lines for utd-marking-lines ):
     5073      define buffer buf_utd-marking-line for utd-marking-lines.
     5074      define buffer par_utd-marking-line for utd-marking-lines.
     5075      define buffer buf_utd for ub.utd .
     5076      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5077         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5078                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5079                                           and buf_utd-marking-line.mark      eq marking.mark
     5080         no-lock no-error.
     5081         if available  buf_utd-marking-line
     5082         then do:
     5083            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     5084            then do:
     5085               find current  buf_utd-marking-line exclusive-lock no-error.
     5086               if available buf_utd-marking-line
     5087               then
     5088                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     5089            end.
     5090         end.
     5091         else do:
     5092            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     5093                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     5094                                         no-error .
     5095            create buf_utd-marking-line.
     5096            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     5097            assign
     5098               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     5099               buf_utd-marking-line.mark      = marking.mark
     5100               buf_utd-marking-line.gds-code  = marking.Gds-code
     5101               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     5102                                               then marking.sts
     5103                                               else
     5104                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     5105                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     5106                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5107                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     5108                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5109                                                else marking.sts
     5110            .
     5111            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     5112            do:
     5113              for first par_utd-marking-line no-lock where
     5114                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     5115                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     5116                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     5117                    and par_utd-marking-line.mark    = marking.mark-parent
     5118                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5119              :
     5120                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5121              end.
     5122            end.
     5123         end.
     5124         addMark(buffer buf_utd-marking-line).
     5125      end.
     5126   end.
     5127   function UnLockUTDMarkbuf returns logical
     5128   (buffer old_utd for utd,
     5129    iAll as logical ):
     5130      define variable voldkey    as character no-undo.
     5131         run gen-key-rec (input "utd",
     5132                          input  buffer old_utd:handle,
     5133                          output voldkey).
     5134      for each marking where marking.loc-key eq voldkey
     5135      exclusive-lock:
     5136         if    iAll
     5137            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5138                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     5139         then do:
     5140            marking.loc-key = "".
     5141            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     5142         end.
     5143      end.
     5144   end.
     5145   function UnLockUTDMark returns logical
     5146   (idb-num as integer ,idoc-id as integer ,iall as logical):
     5147      define buffer old_utd for utd.
     5148      find first old_utd where old_utd.db-num eq idb-num
     5149                           and old_utd.db-num eq idoc-id
     5150      no-lock no-error.
     5151      if available old_utd
     5152      then do:
     5153         UnLockUTDMarkbuf(buffer old_utd,iall).
     5154      end.
     5155   end.
     5156   function changSts returns logical
     5157   (idb-num as integer ,
     5158    idoc-id as integer ,
     5159    old_sts_edo as character ,
     5160    new_sts_edo as character  ):
     5161      if     old_sts_edo ne new_sts_edo
     5162         and ( new_sts_edo eq "RevocationAccepted"
     5163              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     5164              )
     5165      then
     5166         UnLockUTDMark(idb-num,idoc-id,yes).
     5167      if     old_sts_edo ne new_sts_edo
     5168         and ( new_sts_edo eq "WithRecipientSignature"
     5169           or  new_sts_edo eq "WithRecipientPartiallySignature"
     5170              )
     5171      then
     5172         UnLockUTDMark(idb-num,idoc-id,no).
     5173   end.
     5174   function SetLockUTDMark returns logical
     5175   (idb-num as integer ,idoc-id as integer ):
     5176      define buffer new_utd for utd.
     5177      define buffer old_utd for utd.
     5178      define variable volddb-num as integer no-undo.
     5179      define variable volddoc-id as integer no-undo.
     5180      define variable voldkey    as character no-undo.
     5181      define variable vnewkey    as character no-undo.
     5182      find first new_utd where new_utd.db-num eq idb-num
     5183                           and new_utd.doc-id eq idoc-id
     5184      no-lock no-error.
     5185      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     5186      then do trans:
     5187         find first old_utd where old_utd.db-num eq volddb-num
     5188                              and old_utd.doc-id eq volddoc-id
     5189         no-lock no-error.
     5190            run gen-key-rec (input "utd",
     5191                             input  buffer new_utd:handle,
     5192                             output vnewkey).
     5193            run gen-key-rec (input "utd",
     5194                             input  buffer old_utd:handle,
     5195                             output voldkey).
     5196         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     5197                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     5198         no-lock:
     5199            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     5200            if available  marking
     5201            then do:
     5202               if    marking.loc-key eq ""
     5203                  or marking.loc-key eq ?
     5204                  or marking.loc-key eq voldkey
     5205               then do:
     5206                  find current marking exclusive-lock no-error.
     5207                  if available marking
     5208                  then do:
     5209                     marking.loc-key = vnewkey.
     5210                     release marking.
     5211                  end.
     5212               end.
     5213               else if marking.loc-key ne vnewkey
     5214               then do:
     5215                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     5216               end.
     5217            end.
     5218         end.
     5219         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     5220      end.
     5221   end.
     5222   function CheckedocMark return logical
     5223   (input idb-numorig as integer,
     5224    input idoc-idorig as integer,
     5225    input idb-numedoc as integer,
     5226    input idoc-idedoc as integer  ):
     5227       define variable VChekOk    as logical   no-undo init yes.
     5228       define variable vMarkUtd   as logical   no-undo.
     5229       define variable v-par-type as character no-undo.
     5230       define variable v-par-val  as character no-undo.
     5231       define buffer buf_utd-attr      for utd-attr.
     5232       define buffer buf_utd           for utd.
     5233       define buffer utd-marking-lines for utd-marking-lines.
     5234       define buffer utd-lines         for utd-lines.
     5235       define buffer marking           for marking.
     5236       define buffer edoc-lines        for utd-lines.
     5237          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     5238                                       and utd-marking-lines.doc-id    eq idoc-idorig
     5239                                       and utd-marking-lines.doc-level eq 1
     5240                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     5241          no-lock:
     5242             if    isMark (utd-marking-lines.mark)
     5243             then do:
     5244                create tt-utd-mark.
     5245                buffer-copy utd-marking-lines to tt-utd-mark
     5246                assign
     5247                   tt-utd-mark.side = "+"
     5248                .
     5249             end.
     5250          end.
     5251          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     5252                                       and utd-marking-lines.doc-id eq idoc-idedoc
     5253                                       and utd-marking-lines.doc-level eq 1
     5254          no-lock:
     5255             if    isMark (utd-marking-lines.mark)
     5256             then do:
     5257                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     5258                no-lock no-error.
     5259                if available tt-utd-mark
     5260                then
     5261                   tt-utd-mark.side = "".
     5262                else do:
     5263                   create tt-utd-mark.
     5264                   buffer-copy utd-marking-lines to tt-utd-mark
     5265                   assign
     5266                      tt-utd-mark.side = "-"
     5267                   .
     5268                end.
     5269             end.
     5270          end.
     5271          for each tt-utd-mark where  tt-utd-mark.side ne ""
     5272          no-lock:
     5273             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     5274             VChekOk = no.
     5275          end.
     5276          for each utd-lines where utd-lines.db-num    eq idb-numorig
     5277                               and utd-lines.doc-id    eq idoc-idorig
     5278          no-lock:
     5279             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     5280                                     and edoc-lines.doc-id eq idoc-idedoc
     5281                                     and edoc-lines.LineNum eq utd-lines.LineNum
     5282             no-lock no-error.
     5283             define variable VUtdlinequentity as decimal no-undo.
     5284             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     5285             if     VUtdlinequentity eq ?
     5286                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     5287             then
     5288                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     5289          end.
     5290       for each tt-utd-mark:
     5291          delete tt-utd-mark.
     5292       end.
     5293   end.
     5294   function CheckEdoc returns character
     5295   (idb-numOrig as integer ,
     5296    idoc-idOrig as integer,
     5297    idb-num as integer ,
     5298    idoc-id as integer ):
     5299      define buffer utd  for ub.utd.
     5300      define buffer utd-lines  for ub.utd-lines.
     5301      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5302      define buffer edoc-lines for ub.utd-lines.
     5303      define variable vSts as integer no-undo.
     5304      define variable vMarkutd as logical no-undo.
     5305      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     5306      Block-line:
     5307      for each utd-lines where utd-lines.db-num eq idb-num
     5308                           and utd-lines.doc-id eq idoc-id
     5309      exclusive-lock:
     5310         define variable ismarkin as logical no-undo.
     5311         define variable isOAD as logical no-undo.
     5312         define variable isper as logical no-undo.
     5313         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     5314              output ismarkin, output isOAD, output isper).
     5315         if    utd-lines.Price                eq 0
     5316            or utd-lines.Total                eq 0
     5317            or utd-lines.TotalWithVatExcluded eq 0
     5318            or utd-lines.Quantity             eq 0
     5319         then do:
     5320            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5321                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5322                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5323            no-lock:
     5324               if    isMark(utd-marking-lines.mark)
     5325                  or isOad(utd-marking-lines.mark)
     5326               then do:
     5327                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     5328                  next Block-line.
     5329               end.
     5330            end.
     5331            delete utd-lines.
     5332         end.
     5333         else if   ( utd-lines.Total                ne 0
     5334                 or utd-lines.Quantity             ne 0)
     5335                 and ismarkin or isOAD
     5336         then do:
     5337            Block-mark:
     5338            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5339                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5340                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5341            no-lock:
     5342               if  (isOAD and
     5343                     isMark(utd-marking-lines.mark)
     5344                  or isOad(utd-marking-lines.mark) )
     5345                  or (ismarkin and
     5346                     isMark(utd-marking-lines.mark))
     5347               then do:
     5348                  leave Block-mark.
     5349               end.
     5350            end.
     5351            if not available utd-marking-lines
     5352            then
     5353               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     5354         end.
     5355      end.
     5356      for each utd-lines where utd-lines.db-num eq idb-numOrig
     5357                           and utd-lines.doc-id eq idoc-idOrig
     5358      no-lock:
     5359         find first edoc-lines where edoc-lines.db-num eq idb-num
     5360                                 and edoc-lines.doc-id eq idoc-id
     5361                                 and edoc-lines.LineNum eq utd-lines.LineNum
     5362         no-lock no-error.
     5363         if     available edoc-lines
     5364         then do:
     5365            if edoc-lines.Quantity ne 0
     5366            then do:
     5367               if edoc-lines.Price ne utd-lines.Price
     5368               then
     5369                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     5370            end.
     5371         end.
     5372         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5373         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     5374      end.
     5375      define variable vError as character no-undo.
     5376      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     5377      if vError ne ""
     5378      then
     5379         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     5380      else
     5381         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5382      find first utd where utd.db-num eq idb-num
     5383                       and utd.doc-id eq idoc-id
     5384      exclusive-lock no-error.
     5385      if available utd
     5386      then do:
     5387         utd.sts = vsts.
     5388      end.
     5389   end.
     5390   function CrEdoc returns character
     5391   (iPack as character ,
     5392    iTimestamp as datetime):
     5393      define variable vdb-num as integer no-undo.
     5394      define variable vdoc-id as integer no-undo.
     5395      define buffer utd  for ub.utd.
     5396      define buffer edoc for ub.utd.
     5397      define buffer utd_ret   for ub.utd.
     5398      define buffer utd-attr  for ub.utd-attr.
     5399      define buffer edoc-attr for ub.utd-attr.
     5400      define buffer utd-lines  for ub.utd-lines.
     5401      define buffer edoc-lines for ub.utd-lines.
     5402      define buffer utd-lines-attr  for ub.utd-lines-attr.
     5403      define buffer edoc-lines-attr for ub.utd-lines-attr.
     5404      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5405      define buffer edoc-marking-lines for ub.utd-marking-lines.
     5406      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5407      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     5408      define variable vTimestamp  as datetime no-undo.
     5409      find last utd where utd.PackageId eq iPack
     5410                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5411                      and utd.Timestamp ge iTimestamp
     5412      no-lock no-error.
     5413      if available utd
     5414      then
     5415         return "Есть документ позже".
     5416      find last utd where utd.PackageId eq iPack
     5417                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     5418                      and utd.Timestamp le iTimestamp
     5419      no-lock no-error.
     5420      if not available utd
     5421      then
     5422         return "Не найден УКД".
     5423      define variable vdb-numOrig as integer no-undo.
     5424      define variable vdoc-idOrig as integer no-undo.
     5425      find last utd where utd.PackageId eq iPack
     5426                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5427                      and utd.Timestamp le iTimestamp
     5428      no-lock no-error.
     5429      if available utd
     5430      then do:
     5431         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5432         MySeqUtd = ?.
     5433         vTimestamp = utd.Timestamp.
     5434         create edoc.
     5435         vdb-num = utd.db-num.
     5436         vdoc-id = utd.doc-id.
     5437         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     5438         assign
     5439            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5440            edoc.Timestamp = iTimestamp + 1
     5441            edoc.AmendmentRequested = no
     5442            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     5443         .
     5444         validate edoc.
     5445         for each utd-attr where utd-attr.db-num eq vdb-num
     5446                             and utd-attr.doc-id eq vdoc-id
     5447                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     5448                             and utd-attr.attr-code ne "sendcode"
     5449         no-lock:
     5450            create edoc-attr.
     5451            buffer-copy utd-attr except doc-id db-num to edoc-attr
     5452            assign
     5453               edoc-attr.db-num = edoc.db-num
     5454               edoc-attr.doc-id = edoc.doc-id
     5455            .
     5456         end.
     5457         for each utd-lines where utd-lines.db-num eq vdb-num
     5458                              and utd-lines.doc-id eq vdoc-id
     5459         no-lock:
     5460            create edoc-lines.
     5461            buffer-copy utd-lines except doc-id db-num to edoc-lines
     5462            assign
     5463               edoc-lines.db-num = edoc.db-num
     5464               edoc-lines.doc-id = edoc.doc-id
     5465            .
     5466            release edoc-lines.
     5467         end.
     5468         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     5469                                   and utd-lines-attr.doc-id eq vdoc-id
     5470         no-lock:
     5471            create edoc-lines-attr.
     5472            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     5473            assign
     5474               edoc-lines-attr.db-num = edoc.db-num
     5475               edoc-lines-attr.doc-id = edoc.doc-id
     5476            .
     5477         end.
     5478         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     5479                                      and utd-marking-lines.doc-id eq vdoc-id
     5480                                      and utd-marking-lines.doc-level eq 1
     5481         no-lock:
     5482            create edoc-marking-lines.
     5483            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5484            assign
     5485               edoc-marking-lines.db-num = edoc.db-num
     5486               edoc-marking-lines.doc-id = edoc.doc-id
     5487            .
     5488         end.
     5489         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     5490                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     5491         no-lock:
     5492            if utd-marking-lines-attr.attr-code eq "box-qnty"
     5493            then do:
     5494                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     5495                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     5496                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     5497                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     5498                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     5499                no-lock no-error.
     5500            end.
     5501            if not avail edoc-marking-lines-attr
     5502            then do:
     5503                create edoc-marking-lines-attr.
     5504                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     5505                assign
     5506                   edoc-marking-lines-attr.db-num = vdb-num
     5507                   edoc-marking-lines-attr.doc-id = vdoc-id
     5508                .
     5509            end.
     5510            release edoc-marking-lines-attr.
     5511         end.
     5512         for each utd where utd.PackageId eq iPack
     5513                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     5514                        and utd.Timestamp gt vTimestamp
     5515                        and utd.Timestamp le iTimestamp
     5516                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     5517                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     5518                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     5519                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     5520                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5521                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     5522         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     5523            edoc.Total = edoc.Total + utd.total.
     5524            edoc.Vat = edoc.Vat + utd.Vat.
     5525            edoc.DocumentDate = utd.DocumentDate.
     5526            edoc.Timestamp = utd.Timestamp + 1.
     5527            for each utd-lines where utd-lines.db-num     = utd.db-num
     5528                                 and utd-lines.doc-id     = utd.doc-id
     5529            no-lock:
     5530               block-mark:
     5531               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5532                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5533                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5534                                            and utd-marking-lines.site eq "-"
     5535                                            no-lock:
     5536                  if isOAD(utd-marking-lines.mark)
     5537                  then do:
     5538                     define variable VOAD as character no-undo.
     5539                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5540                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5541                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     5542                                                  and edoc-marking-lines.mark   begins VOAD
     5543                     no-lock no-error.
     5544                  end.
     5545                  else
     5546                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5547                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5548                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5549                        no-lock no-error.
     5550                  if available edoc-marking-lines
     5551                  then do:
     5552                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     5553                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     5554                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     5555                     exclusive-lock no-error.
     5556                     leave block-mark.
     5557                  end.
     5558               end.
     5559               if not available edoc-lines
     5560               then
     5561                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     5562                                          and edoc-lines.doc-id      = edoc.doc-id
     5563                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     5564                  exclusive-lock no-error.
     5565               if not available edoc-lines
     5566               then do:
     5567                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     5568                                         and edoc-lines.doc-id      = edoc.doc-id
     5569                  no-lock no-error.
     5570                  define variable vline as integer no-undo.
     5571                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     5572                  create edoc-lines.
     5573                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     5574                  assign
     5575                     edoc-lines.db-num = edoc.db-num
     5576                     edoc-lines.doc-id = edoc.doc-id
     5577                     edoc-lines.linenum = vline
     5578                  .
     5579               end.
     5580               else
     5581                  assign
     5582                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     5583                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     5584                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     5585                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     5586                  .
     5587               define variable Vqnty as decimal no-undo.
     5588               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     5589                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     5590               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     5591               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     5592                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5593               then
     5594                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5595                      "loadUtd",
     5596                      "UcdUnitChangForUtd",
     5597                      string(edoc-lines.LineNum )                  + chr(4) +
     5598                      edoc-lines.UnitCode                   + chr(4) +
     5599                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5600               if     utd-lines.UnitCode ne ?
     5601                  and utd-lines.UnitCode ne ""
     5602                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5603               then
     5604                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5605                         "loadUtd",
     5606                         "UcdUnitChang",
     5607                         string(edoc-lines.LineNum )                  + chr(4) +
     5608                         utd-lines.UnitCode                          + chr(4) +
     5609                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5610               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5611                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5612                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5613               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     5614                  if utd-marking-lines.site eq "-"
     5615                  then do:
     5616                     if isOAD(utd-marking-lines.mark)
     5617                     then do:
     5618                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5619                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5620                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5621                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5622                        exclusive-lock no-error.
     5623                        if not available edoc-marking-lines
     5624                        then
     5625                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5626                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     5627                                                        and edoc-marking-lines.mark   begins VOAD
     5628                           exclusive-lock no-error.
     5629                        if not available edoc-marking-lines
     5630                        then
     5631                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5632                        else do:
     5633                           define variable v37tegdoc as character no-undo.
     5634                           define variable v37tegedoc as character no-undo.
     5635                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5636                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5637                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     5638                           if error-status:error
     5639                           then
     5640                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5641                              view-as alert-box.
     5642                           else if vqnty = 0
     5643                           then
     5644                              delete edoc-marking-lines.
     5645                           else do:
     5646                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5647                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5648                                             edoc-marking-lines.doc-id,
     5649                                             edoc-marking-lines.LineNum,
     5650                                             edoc-marking-lines.mark,
     5651                                             "box-qnty",
     5652                                              string(vQnty)).
     5653                           end.
     5654                        end.
     5655                     end.
     5656                     else do:
     5657                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5658                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5659                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5660                        exclusive-lock no-error.
     5661                        if available edoc-marking-lines
     5662                        then
     5663                           delete edoc-marking-lines.
     5664                        else
     5665                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5666                     end.
     5667                  end.
     5668                  else if utd-marking-lines.site eq "+"
     5669                  then do:
     5670                     if isOAD(utd-marking-lines.mark)
     5671                     then do:
     5672                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5673                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5674                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5675                                                     and edoc-marking-lines.mark   begins VOAD
     5676                        exclusive-lock no-error.
     5677                        if available edoc-marking-lines
     5678                        then do:
     5679                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5680                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5681                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     5682                           if error-status:error
     5683                           then
     5684                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5685                              view-as alert-box.
     5686                           else if vqnty = 0
     5687                           then
     5688                              delete edoc-marking-lines.
     5689                           else do:
     5690                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5691                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5692                                             edoc-marking-lines.doc-id,
     5693                                             edoc-marking-lines.LineNum,
     5694                                             edoc-marking-lines.mark,
     5695                                             "box-qnty",
     5696                                              string(vQnty)).
     5697                           end.
     5698                        end.
     5699                        else do:
     5700                           create edoc-marking-lines.
     5701                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5702                           assign
     5703                              edoc-marking-lines.db-num = edoc.db-num
     5704                              edoc-marking-lines.doc-id = edoc.doc-id
     5705                           .
     5706                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5707                                             edoc-marking-lines.doc-id,
     5708                                             edoc-marking-lines.LineNum,
     5709                                             edoc-marking-lines.mark,
     5710                                             "box-qnty",
     5711                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     5712                        end.
     5713                     end.
     5714                     else do:
     5715                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5716                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5717                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5718                     no-lock no-error.
     5719                     if not available edoc-marking-lines
     5720                     then do:
     5721                        create edoc-marking-lines.
     5722                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     5723                        assign
     5724                           edoc-marking-lines.db-num  = edoc-lines.db-num
     5725                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     5726                           edoc-marking-lines.linenum = edoc-lines.linenum
     5727                        .
     5728                     end.
     5729                     else
     5730                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5731                  end.
     5732               end.
     5733               release edoc-lines.
     5734            end.
     5735            release edoc-lines.
     5736         end.
     5737         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     5738                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     5739                                 and utd_ret.Timestamp             le utd.Timestamp
     5740                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5741            no-lock no-error.
     5742         if not avail utd_ret
     5743         then
     5744            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5745      end.
     5746      for each utd where utd.PackageId eq iPack
     5747                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5748                        and utd.Timestamp < iTimestamp
     5749         exclusive-lock:
     5750            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5751            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5752         end.
     5753         unsubscribe "getNextseq".
     5754      end.
     5755   end.
     5756   define variable Mext-sys as integer no-undo init ?.
     5757   define variable mdb-num-local as integer no-undo.
     5758   run gbl/getdbnum.p (output mdb-num-local).
     5759   function  getExtSys returns integer
     5760   ():
     5761      define buffer ext-system      for ext-system.
     5762      define buffer ext-system-attr for ext-system-attr.
     5763      Mext-sys = ?.
     5764      block-sys-obj:
     5765      for each ext-system where ext-system.esys-type eq 12
     5766                            and ext-system.db-num    eq mdb-num-local
     5767      no-lock:
     5768          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5769                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5770                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5771          no-lock no-error.
     5772          if     available ext-system-attr
     5773             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5774          then do:
     5775             Mext-sys = ext-system-attr.esys-id.
     5776             leave block-sys-obj.
     5777          end.
     5778      end.
     5779      if Mext-sys eq ?
     5780      then do:
     5781         block-sys-host:
     5782         for each ext-system where ext-system.esys-type eq 12
     5783                               and ext-system.db-num    eq mdb-num-local
     5784         no-lock:
     5785             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5786                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5787                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5788             no-lock no-error.
     5789             if     available ext-system-attr
     5790                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5791             then do:
     5792                Mext-sys = ext-system-attr.esys-id.
     5793                leave block-sys-host.
     5794             end.
     5795         end.
     5796      end.
     5797      return Mext-sys.
     5798   end.
     5799   function  getExtAttr returns character
     5800   (input icode as character ):
     5801      define variable oValue as character no-undo.
     5802      define variable vtype as character no-undo.
     5803      define buffer ext-system for ext-system.
     5804      get-key-value section "ProxyServ" key icode value oValue.
     5805      if oValue eq ?
     5806      then do:
     5807         if Mext-sys eq ?
     5808         then
     5809            getExtSys ().
     5810         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5811                                         and ext-system.esys-id eq Mext-sys no-error.
     5812         if available ext-system
     5813         then do:
     5814                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5815            (ext-system.esys-id,
     5816             mdb-num-local,
     5817             icode,
     5818             output oValue,
     5819             output vtype) no-error.
     5820          end.
     5821      end.
     5822      return if oValue eq ? then "" else oValue .
     5823   end.
     5824   function  SetExtAttr returns character
     5825   (input icode   as character,
     5826    input iValue  as character):
     5827      define variable vtype as character no-undo.
     5828      define buffer ext-system for ext-system.
     5829      if Mext-sys eq ?
     5830      then
     5831         getExtSys ().
     5832      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5833                                      and ext-system.esys-id eq Mext-sys no-error.
     5834      if available ext-system
     5835      then do:
     5836          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5837         (ext-system.esys-id,
     5838          mdb-num-local,
     5839          icode,
     5840          iValue) no-error.
     5841       end.
     5842   end.
     5843   define stream File-stream.
     5844   function PutMes returns character
     5845   (idext as character ):
     5846      if valid-handle(mPublishHand)
     5847      then
     5848         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5849      else do:
     5850         if idext begins "error"
     5851         then do:
     5852            message substring (idext,6)
     5853               view-as alert-box.
     5854            if mDiadocApi ne ?
     5855            then
     5856               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5857         end.
     5858         output stream File-stream to "diadoc_user.log" append.
     5859         put stream File-stream unformatted now " " idext skip.
     5860         output stream File-stream close.
     5861      end.
     5862   end.
     5863   function PutErr returns character
     5864   (idext as character ):
     5865      define variable vi as integer no-undo.
     5866      define variable vnumerr as integer no-undo.
     5867      define variable vtext as character extent 25 no-undo .
     5868      if error-status:num-messages > 0 then do:
     5869         vnumerr = error-status:num-messages.
     5870         vnumerr = min(vnumerr,extent(vtext)).
     5871         do vi = 1 to vnumerr:
     5872            vtext[vi] = error-status:get-message(vi).
     5873         end.
     5874         idext = idext + chr(10) + "Ошибка: [":U.
     5875         do vi = 1 to vnumerr:
     5876            idext = idext + chr(10) + vtext[vi] no-error.
     5877         end.
     5878         idext = idext +  chr(10) +  " ]" no-error.
     5879         if not  idext begins "Error"
     5880         then
     5881            idext = "Error " + idext.
     5882         PutMes(idext).
     5883      end.
     5884   end.
     5885   function PutStat returns character
     5886   (itext as character,
     5887    iflag as logical):
     5888      if valid-handle(mPublishHand)
     5889      then
     5890         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5891      PutMes(itext).
     5892   end.
     5893   function chekStop returns logical
     5894   ( ):
     5895      define variable oStop as logical no-undo.
     5896      if valid-handle(mPublishHand)
     5897      then
     5898         publish "StopProc" from mPublishHand (output oStop).
     5899      return oStop.
     5900   end.
     5901   function  putloggetdesc returns logical
     5902   (is1 as character ,is2 as character ,
     5903   is3 as character ):
     5904   end.
     5905   function  getdesc returns logical
     5906   (input iObj as component-handle):
     5907      if iObj eq ? then return false.
     5908      if mdebug
     5909      then do:
     5910      output stream File-stream to "diadoc_load.txt" append.
     5911      define variable vReflector as component-handle no-undo.
     5912      define variable vDescobj  as component-handle no-undo.
     5913      define variable vPropertyNames  as component-handle no-undo.
     5914      define variable vMethodsNames as component-handle no-undo.
     5915      define variable vMethodDesc as component-handle no-undo.
     5916      define variable vMethodsName as character  no-undo.
     5917      define variable vPropertyValue as char no-undo.
     5918      create "Diadoc.Reflector" vReflector.
     5919      vDescobj = vReflector:Describe(iObj).
     5920     put   stream File-stream  unformatted skip (1)
     5921      "------------------------------------------" skip
     5922      vDescobj:GetInterfaceName() skip.
     5923      define variable vPropertyName as character no-undo.
     5924      define variable vPropertyType as character no-undo.
     5925      .
     5926      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5927      putloggetdesc("property","","").
     5928      define variable vi as integer no-undo.
     5929      define variable vii as integer no-undo.
     5930     put stream File-stream  unformatted skip "property" skip.
     5931     vPropertyNames = vDescobj:GetPropertiesNames().
     5932      vi= vPropertyNames:count.
     5933      do vi= 1 to vPropertyNames:count :
     5934         vPropertyName = "".
     5935         vPropertyType = "".
     5936         vPropertyValue = "".
     5937         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5938         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5939         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5940         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5941        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5942      end.
     5943      release object vPropertyNames.
     5944      put stream File-stream  unformatted skip "method" skip.
     5945      vMethodsNames = vDescobj:GetMethodsNames().
     5946      vi = vMethodsNames:count.
     5947      do vi = 1 to vMethodsNames:count :
     5948         vMethodsName = "".
     5949         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5950         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5951         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5952         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5953         do vii  = 1 to vMethodDesc:args:count:
     5954            define variable varg as character no-undo.
     5955            varg = "".
     5956            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5957            put stream File-stream  unformatted " args " varg  skip .
     5958            putloggetdesc(" args ",varg, "").
     5959         end.
     5960         release object vMethodDesc.
     5961      end.
     5962      release object vMethodsNames.
     5963      put stream File-stream  unformatted "end---------------------------------------" skip.
     5964      output stream File-stream close.
     5965      release object vDescobj.
     5966      release object vReflector.
     5967      end.
     5968      return true.
     5969   end.
     5970   function getxsddocum returns logical
     5971   (iOrganization as component-handle):
     5972      if iOrganization eq ? then return false.
     5973      define variable vDocumentTypes as component-handle no-undo.
     5974      define variable vDocumentType as component-handle no-undo.
     5975      define variable vFunctions as component-handle no-undo.
     5976      define variable vFunction as component-handle no-undo.
     5977      define variable vVersions as component-handle no-undo.
     5978      define variable vVersion as component-handle no-undo.
     5979      define variable vTitles as component-handle no-undo.
     5980      define variable vTitle as component-handle no-undo.
     5981      define variable vi as integer no-undo.
     5982      define variable vii as integer no-undo.
     5983      define variable viii as integer no-undo.
     5984      define variable viiii as integer no-undo.
     5985      if mdebug
     5986      then do:
     5987      output stream File-stream to "diadoc_doc.txt" append.
     5988      vDocumentTypes = iOrganization:GetDocumentTypes().
     5989      do vi =1 to vDocumentTypes:count:
     5990         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5991         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5992         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5993         vFunctions = vDocumentType:Functions.
     5994         do vii =1 to vFunctions:count:
     5995            vFunction = vFunctions:GetItem(vii - 1 ).
     5996            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     5997            vVersions = vFunction:Versions.
     5998            do viii =1 to vVersions:count:
     5999               vVersion = vVersions:GetItem(viii - 1 ).
     6000               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     6001               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     6002               vTitles  = vVersion:Titles.
     6003               do viiii =1 to vTitles:count:
     6004                  vTitle = vTitles:GetItem(viiii - 1 ).
     6005                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     6006                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     6007                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     6008                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     6009                  release object vTitle.
     6010               end.
     6011              release object vTitles.
     6012               release object vVersion.
     6013            end.
     6014            release object vVersions.
     6015            release object vFunction.
     6016         end.
     6017         release object vFunctions.
     6018         release object vDocumentType.
     6019      end.
     6020      release object vDocumentTypes.
     6021      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     6022     output stream File-stream close.
     6023     end.
     6024      return true.
     6025   end.
     6026   function GetDocTitleType returns character
     6027   (iOrganizationGuid as character ,
     6028   itype as character ,
     6029   ifunction as character,
     6030   iversion as character
     6031   ):
     6032      if iOrganizationGuid eq ? then return "".
     6033      define variable vOrganization  as component-handle no-undo.
     6034      define variable vDocumentTypes as component-handle no-undo.
     6035      define variable vDocumentType  as component-handle no-undo.
     6036      define variable vFunctions     as component-handle no-undo.
     6037      define variable vFunction      as component-handle no-undo.
     6038      define variable vVersions      as component-handle no-undo.
     6039      define variable vVersion       as component-handle no-undo.
     6040      define variable vTitles        as component-handle no-undo.
     6041      define variable vTitle         as component-handle no-undo.
     6042      define variable vi             as integer no-undo.
     6043      define variable vii            as integer no-undo.
     6044      define variable viii           as integer no-undo.
     6045      define variable viiii          as integer no-undo.
     6046      define variable oTitleType as character no-undo.
     6047      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6048      if vOrganization eq ? then return "".
     6049      vDocumentTypes = vOrganization:GetDocumentTypes().
     6050      do vi =1 to vDocumentTypes:count:
     6051         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6052         if vDocumentType:name eq iType
     6053         then do:
     6054            vFunctions = vDocumentType:Functions.
     6055            do vii =1 to vFunctions:count:
     6056               vFunction = vFunctions:GetItem(vii - 1 ).
     6057               if vFunction:name eq ifunction
     6058               then do:
     6059                  vVersions = vFunction:Versions.
     6060                  do viii =1 to vVersions:count:
     6061                     vVersion = vVersions:GetItem(viii - 1 ).
     6062                     if vVersion:version eq iversion
     6063                     then do:
     6064                        vTitles  = vVersion:Titles.
     6065                        do viiii =1 to vTitles:count:
     6066                           vTitle = vTitles:GetItem(viiii - 1 ).
     6067                           oTitleType = oTitleType + "," + vTitle:type.
     6068                           release object vTitle.
     6069                        end.
     6070                        release object vTitles.
     6071                     end.
     6072                     release object vVersion.
     6073                  end.
     6074                  release object vVersions.
     6075               end.
     6076               release object vFunction.
     6077            end.
     6078            release object vFunctions.
     6079         end.
     6080         release object vDocumentType.
     6081      end.
     6082      release object vDocumentTypes.
     6083      release object vOrganization.
     6084      return left-trim(oTitleType,",").
     6085   end.
     6086   define temp-table tt-type no-undo
     6087             field id as char
     6088             field name as character
     6089             index pi id .
     6090   define temp-table tt-Class no-undo like tt-type.
     6091   function crcode returns character
     6092   ():
     6093      define variable vtypelist as character no-undo.
     6094      define variable vtypename as character no-undo.
     6095      define variable vi as integer no-undo.
     6096      vtypelist =
     6097                 "UniversalTransferDocument|"
     6098                + "UniversalTransferDocumentRevision|"
     6099                + "UniversalCorrectionDocument|"
     6100                + "UniversalCorrectionDocumentRevision"
     6101                .
     6102      vtypename =
     6103                 "УПД|"
     6104                + "Исправление УПД|"
     6105                + "УКД|"
     6106                + "Исправление УКД"
     6107                .
     6108      do vi = 1 to num-entries(vtypelist,"|"):
     6109         create tt-type.
     6110         assign
     6111            tt-type.id   =  entry(vi,vtypelist,"|")
     6112            tt-type.name =  entry(vi,vtypename,"|")
     6113         .
     6114      end.
     6115      vtypelist = "Inbound|"
     6116                + "Outbound|"
     6117                + "Proxy".
     6118      vtypename = "входящий документ|"
     6119                + "исходящий документ|"
     6120                + "документ, переданный через промежуточного получателя|".
     6121      do vi = 1 to num-entries(vtypelist,"|"):
     6122         create tt-Class.
     6123         assign
     6124            tt-Class.id   =  entry(vi,vtypelist,"|")
     6125            tt-Class.name =  entry(vi,vtypename,"|")
     6126         .
     6127      end.
     6128   end.
     6129   crcode().
     6130   function getOrganizationInfo returns character
     6131   (input iContAgent as component-handle,
     6132                                                   output oinn as character,
     6133                                                   output oKpp as character,
     6134                                                   output oFnsParticipantId as character,
     6135                                                   output oOrgName as character,
     6136                                                   output oAdditionalInfo as character,
     6137                                                   output OarddrRus as character
     6138                                                    ):
     6139      define variable vi as integer no-undo.
     6140      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     6141      define variable vAddrRus                        as component-handle no-undo.
     6142      if iContAgent ne ?
     6143      then do:
     6144         getdesc(iContAgent).
     6145         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     6146         oinn = vContAgentOrganizationDetails:Inn.
     6147         oKpp = vContAgentOrganizationDetails:Kpp.
     6148         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     6149         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     6150         getdesc(vContAgentOrganizationDetails).
     6151         oOrgName = vContAgentOrganizationDetails:OrgName.
     6152         getdesc(vContAgentOrganizationDetails:Address).
     6153         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     6154         getdesc(vAddrRus ).
     6155         if vAddrRus ne ?
     6156         then do:
     6157            if vAddrRus:ZipCode ne ""
     6158            then
     6159               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     6160            if vAddrRus:Region ne ""
     6161            then
     6162               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     6163            if vAddrRus:Territory ne ""
     6164            then
     6165               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     6166            if vAddrRus:City ne ""
     6167            then
     6168               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     6169            if vAddrRus:Locality ne ""
     6170            then
     6171               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     6172            if vAddrRus:Street ne ""
     6173            then
     6174               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     6175            if vAddrRus:Block ne ""
     6176            then
     6177               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     6178            if vAddrRus:Building ne ""
     6179            then
     6180               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     6181            if vAddrRus:Apartment ne ""
     6182            then
     6183               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     6184         end.
     6185         release object vAddrRus.
     6186         release object vContAgentOrganizationDetails.
     6187      end.
     6188   end.
     6189   function ConectByCertif return component-handle
     6190   (iThumbprint as character ):
     6191     if mDiadocApi eq ? then return ?.
     6192     if iThumbprint eq ""
     6193     then do:
     6194        release object mDiadocConnection no-error.
     6195        return ?.
     6196     end.
     6197      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     6198      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     6199      define variable vSSl as character no-undo.
     6200      vSSl =  getextAttr('diadoc-ssl':U).
     6201      if vSSl ne ""
     6202         and logical(vSSl)
     6203      then
     6204         mDiadocApi:VerifySslCertificate = no.
     6205      if mDiadocApi:ApiClientId eq ""
     6206         or  mDiadocApi:ServerUrl eq ""
     6207      then do:
     6208        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     6209        view-as alert-box.
     6210        release object mDiadocConnection no-error.
     6211        return ?.
     6212     end.
     6213     define variable VProxy as character no-undo.
     6214      vProxy =  getextAttr('proxy-addr':U).
     6215      if     vProxy ne ""
     6216         and vProxy ne ?
     6217      then do:
     6218         mDiadocApi:ProxyMode =  "UseProxy".
     6219         mDiadocApi:ProxySettings:Url = vProxy.
     6220         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6221         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6222      end.
     6223      define variable vtest as component-handle no-undo.
     6224      vtest = mDiadocApi:TestConnection2().
     6225      if not vtest:ConnectionSuccess
     6226      then do:
     6227         PutMes(vtest:ErrorText).
     6228      end.
     6229      else
     6230         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     6231      if mDiadocConnection eq ?
     6232      then
     6233         PutErr("DiadocApi:CreateConnectionByCertificate:").
     6234      release object vtest.
     6235      return mDiadocConnection.
     6236   end.
     6237   function ConectByLogin return component-handle
     6238   ():
     6239      define variable vSSl as character no-undo.
     6240      if mDiadocApi eq ? then return ?.
     6241      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     6242      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     6243      if mDiadocApi:ApiClientId eq ""
     6244         or  mDiadocApi:ServerUrl eq ""
     6245      then do:
     6246        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     6247        release object mDiadocConnection no-error.
     6248        return ?.
     6249     end.
     6250     vSSl =  getextAttr('diadoc-ssl':U).
     6251     if vSSl ne ""
     6252        and logical(vSSl)
     6253     then
     6254         mDiadocApi:VerifySslCertificate = no.
     6255     define variable VProxy as character no-undo.
     6256      vProxy =  getextAttr('proxy-addr':U).
     6257      if     vProxy ne ""
     6258         and vProxy ne ?
     6259      then do:
     6260         mDiadocApi:ProxyMode =  "UseProxy".
     6261         mDiadocApi:ProxySettings:Url = vProxy.
     6262         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6263         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6264      end.
     6265      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     6266      define variable vi as integer no-undo.
     6267      if mDiadocConnection eq ?
     6268      then
     6269         PutErr("DiadocAPI:CreateConnectionByLogin").
     6270      return mDiadocConnection.
     6271   end.
     6272   function GetDocumforid returns character
     6273   (input  iorg as character ,
     6274    input  idoc-id as character ,
     6275    output oDocument      as component-handle
     6276     ):
     6277      define variable vOrganization  as component-handle no-undo.
     6278      define variable vDocument      as component-handle no-undo.
     6279      define buffer utd           for ub.utd.
     6280      if
     6281             iorg  ne ?
     6282         and iorg  ne ""
     6283         and idoc-id ne ?
     6284         and idoc-id ne ""
     6285      then do:
     6286         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     6287         if vOrganization ne ?
     6288         then do:
     6289            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     6290            if oDocument eq ?
     6291            then
     6292               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     6293         end.
     6294         else do:
     6295            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     6296            return "Нет доступа к организации " + iorg.
     6297         end.
     6298      end.
     6299      else
     6300         return "Нет доступа к организации не ЭДО".
     6301      release object vOrganization no-error.
     6302      return "".
     6303   end.
     6304   function GetDocum returns character
     6305   (input  idb-num as integer,
     6306    input  idoc-id as integer,
     6307    output oDocument      as component-handle
     6308     ):
     6309      define variable vOrganization  as component-handle no-undo.
     6310      define variable vDocument      as component-handle no-undo.
     6311      define buffer utd           for ub.utd.
     6312      find first utd where utd.db-num eq idb-num
     6313                       and utd.doc-id eq idoc-id
     6314      no-lock no-error.
     6315      if     available utd
     6316         and utd.OrganizationExt ne ?
     6317         and utd.OrganizationExt ne ""
     6318         and utd.DocumentExt ne ?
     6319         and utd.DocumentExt ne ""
     6320      then do:
     6321         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     6322         if vOrganization ne ?
     6323         then do:
     6324            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     6325            if oDocument eq ?
     6326            then
     6327               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     6328            release object vOrganization no-error.
     6329         end.
     6330         else do:
     6331            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     6332            return "Нет доступа к организации " + utd.OrganizationExt.
     6333         end.
     6334      end.
     6335      else
     6336         return "Нет доступа к организации не ЭДО".
     6337      return "".
     6338   end.
     6339   function GetFirstUTDinPack returns logical
     6340   (input idb-num as integer,
     6341    input idoc-id as integer,
     6342    output odb-num as integer,
     6343    output odoc-id as integer ):
     6344      define buffer buf_utd for utd.
     6345      define buffer     utd for utd.
     6346      find first utd where utd.db-num eq idb-num
     6347                       and utd.doc-id eq idoc-id
     6348      no-lock no-error.
     6349      if available utd
     6350      then do:
     6351         if utd.PackageId eq ""
     6352         then do:
     6353            assign
     6354               odb-num = utd.db-num
     6355               odoc-id = utd.doc-id
     6356            .
     6357            return yes.
     6358         end.
     6359         else do:
     6360            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     6361                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6362            no-lock.
     6363            assign
     6364               odb-num = buf_utd.db-num
     6365               odoc-id = buf_utd.doc-id
     6366            .
     6367            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     6368         end.
     6369      end.
     6370      return ?.
     6371   end.
     6372   function AddOADLine returns integer
     6373   (iDb-num  as integer ,
     6374    iDoc-id  as integer ,
     6375    ilinenum as integer ,
     6376    iGtin    as char,
     6377    iQnty    as int,
     6378    isite    as character ):
     6379       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6380       define variable vnewMark as character no-undo.
     6381       define variable vQnty    as integer   no-undo.
     6382       vnewMark = "02" + iGtin + "37" + string(iQnty).
     6383       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     6384                                      and utd-marking-lines.db-num     = idb-num
     6385                                      and utd-marking-lines.doc-id     = idoc-id
     6386                                      and utd-marking-lines.Linenum    = iLinenum
     6387       exclusive-lock no-error.
     6388       if available utd-marking-lines
     6389       then do:
     6390          delete utd-marking-lines.
     6391          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     6392       end.
     6393       else do:
     6394          create utd-marking-lines.
     6395          assign
     6396             utd-marking-lines.mark      = vnewMark
     6397             utd-marking-lines.db-num    = idb-num
     6398             utd-marking-lines.doc-id    = idoc-id
     6399             utd-marking-lines.Linenum   = iLinenum
     6400             utd-marking-lines.site      = isite
     6401             utd-marking-lines.doc-level = 1
     6402             utd-marking-lines.gds-code  = ?
     6403          .
     6404          vQnty = iQnty.
     6405       end.
     6406       return vQnty.
     6407    end.
     6408   function addMarkforUtd returns recid
     6409   (iDb-num  as integer ,
     6410    iDoc-id  as integer ,
     6411    ilinenum as integer ,
     6412    iMark as character  ,
     6413    isite   as character,
     6414    iUtdType as character    ):
     6415       define buffer     marking            for ub.marking.
     6416       define buffer     marking-attr       for ub.marking-attr.
     6417       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6418       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     6419       define variable vMRC  as decimal no-undo.
     6420       define variable vQnty as decimal no-undo.
     6421      define variable vRec as recid no-undo.
     6422      if     imark ne "-"
     6423         and imark ne ""
     6424         and imark ne ?
     6425      then do:
     6426         imark = repTegforDm(imark).
     6427         vQnty = getQntyUTDByCodId(imark) .
     6428         find first utd-marking-lines where utd-marking-lines.mark       = imark
     6429                                        and utd-marking-lines.db-num     = idb-num
     6430                                        and utd-marking-lines.doc-id     = idoc-id
     6431                                        and utd-marking-lines.Linenum    = iLinenum
     6432         exclusive-lock no-error.
     6433         if not available utd-marking-lines
     6434         then do:
     6435            create utd-marking-lines.
     6436            assign
     6437               utd-marking-lines.mark      = imark
     6438               utd-marking-lines.db-num    = idb-num
     6439               utd-marking-lines.doc-id    = idoc-id
     6440               utd-marking-lines.Linenum   = iLinenum
     6441               utd-marking-lines.site      = isite
     6442               utd-marking-lines.doc-level = 1
     6443               utd-marking-lines.gds-code  = ?
     6444            .
     6445            create utd-marking-lines-attr.
     6446            assign
     6447               utd-marking-lines-attr.mark      = imark
     6448               utd-marking-lines-attr.db-num    = idb-num
     6449               utd-marking-lines-attr.doc-id    = idoc-id
     6450               utd-marking-lines-attr.Linenum   = iLinenum
     6451               utd-marking-lines-attr.attr-code = "box-qnty"
     6452               utd-marking-lines-attr.attr-value = string(vQnty)
     6453            .
     6454            vRec = recid(utd-marking-lines).
     6455            release utd-marking-lines-attr.
     6456            release utd-marking-lines.
     6457         end.
     6458         else do:
     6459            if    (    isite eq "-"
     6460               and utd-marking-lines.site eq "+")
     6461            or (    isite eq "+"
     6462               and utd-marking-lines.site eq "-")
     6463            then
     6464               delete utd-marking-lines.
     6465            else if isOAD (imark)
     6466            then do:
     6467               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     6468               create utd-marking-lines-attr.
     6469               assign
     6470                  utd-marking-lines-attr.mark      = imark
     6471                  utd-marking-lines-attr.db-num    = idb-num
     6472                  utd-marking-lines-attr.doc-id    = idoc-id
     6473                  utd-marking-lines-attr.Linenum   = iLinenum
     6474                  utd-marking-lines-attr.attr-code = "box-qnty"
     6475                  utd-marking-lines-attr.attr-value = string(vQnty)
     6476               .
     6477            end.
     6478            vRec = recid(utd-marking-lines).
     6479            release utd-marking-lines.
     6480         end.
     6481         if isMark (imark)
     6482         then do:
     6483            find first marking where marking.mark eq iMark exclusive-lock no-error.
     6484            if not available marking
     6485            then do:
     6486               create marking.
     6487               marking.mark = iMark.
     6488               marking.gds-code = ?.
     6489               marking.unit     = getLevelUTDByCodId(marking.mark) .
     6490            end.
     6491            assign
     6492              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     6493                                      getLevelMotpByCodId(marking.mark)
     6494                                   else marking.unit-ext
     6495              marking.box-qnty   = vQnty
     6496              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     6497            .
     6498            if        (     iUtdType eq "UniversalTransferDocument"
     6499                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     6500            then
     6501               marking.sts = ?.
     6502         end.
     6503      end.
     6504      return vRec.
     6505   end.
     6506   function isSaleMarkInUpak returns logical
     6507   (iMark    as char ):
     6508      define buffer buf_marking       for ub.marking.
     6509      for each buf_marking no-lock where
     6510               buf_marking.mark-parent = iMark
     6511      :
     6512        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     6513           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     6514          return true.
     6515        if isSaleMarkInUpak(buf_marking.mark) then
     6516          return true.
     6517      end.
     6518      return false.
     6519    end.
     6520   function setStatusUpak returns logical
     6521   (iDbNum   as integer ,
     6522    iDocId   as integer ,
     6523    iLineNum as integer ,
     6524    iMark    as char ,
     6525    iSts     as integer):
     6526      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6527      define buffer buf_marking           for ub.marking.
     6528      for each buf_marking exclusive-lock where
     6529               buf_marking.mark-parent = iMark,
     6530         first buf_utd-marking-lines exclusive-lock where
     6531               buf_utd-marking-lines.doc-id  = iDocId
     6532           and buf_utd-marking-lines.db-num  = iDbNum
     6533           and buf_utd-marking-lines.lineNum = iLineNum
     6534           and buf_utd-marking-lines.mark = buf_marking.mark
     6535      :
     6536        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     6537      end.
     6538      for first buf_utd-marking-lines exclusive-lock where
     6539                buf_utd-marking-lines.doc-id  = iDocId
     6540            and buf_utd-marking-lines.db-num  = iDbNum
     6541            and buf_utd-marking-lines.lineNum = iLineNum
     6542            and buf_utd-marking-lines.mark = iMark,
     6543          first buf_marking exclusive-lock where
     6544                buf_marking.mark = buf_utd-marking-lines.mark
     6545      :
     6546        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     6547        then do:
     6548          assign
     6549            buf_utd-marking-lines.sts = iSts
     6550            buf_marking.sts           = iSts
     6551          .
     6552        end.
     6553      end.
     6554      return true.
     6555   end.
     6556   define temp-table tt-recid no-undo
     6557             field orgid as char
     6558             field docid as char
     6559             field parent as char
     6560             field stamp as datetime
     6561             index pi orgid docid
     6562             index parent parent  stamp.
     6563   function ProcessSystemMessStart return component-handle
     6564   (IStartStop as logical):
     6565      if mDiadocConnection eq ? then
     6566      define variable vOrganizationList as component-handle no-undo.
     6567      define variable vOrganization as component-handle no-undo.
     6568      define variable vReceiptGenerationProcess as component-handle no-undo.
     6569      define variable vi as integer no-undo.
     6570      if mDiadocConnection ne ?
     6571      then do:
     6572         vOrganizationList = mDiadocConnection:GetOrganizationList().
     6573          do vi = 1 to vOrganizationList:count:
     6574             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6575             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     6576             release object vOrganization.
     6577             if IStartStop
     6578             then
     6579                vReceiptGenerationProcess:Start().
     6580             else
     6581                vReceiptGenerationProcess:Stop().
     6582             release object vReceiptGenerationProcess.
     6583          end.
     6584          release object vOrganizationList.
     6585      end.
     6586   end.
     6587   procedure  changeIdToGuid :
     6588   define input  parameter iOrganization as component-handle no-undo.
     6589      define variable vOrgId   as character no-undo.
     6590      define variable vOrgGuid as character no-undo.
     6591      define buffer utd for utd.
     6592      assign
     6593         vOrgId   = iOrganization:id.
     6594         vOrgGuid = iOrganization:guid
     6595      no-error.
     6596      if     error-status:num-messages eq 0
     6597         and vOrgId   ne ""
     6598         and vOrgGuid ne ""
     6599      then do:
     6600         define variable vfirst as logical no-undo init yes.
     6601         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     6602            find next utd.
     6603            if vfirst
     6604            then do:
     6605               PutMes("Конвертация документов").
     6606               vfirst = no.
     6607            end.
     6608            utd.OrganizationExt = vOrgGuid.
     6609            validate utd.
     6610            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     6611         end.
     6612         if not vfirst
     6613         then
     6614            PutMes("Конвертация документов завершина.").
     6615      end.
     6616   end.
     6617   procedure getNewUpd :
     6618      define variable VLastDate as date no-undo init ?.
     6619      define variable vDocument     as component-handle no-undo.
     6620      define variable vYear         as integer no-undo.
     6621      define variable vMonth        as integer no-undo.
     6622      define variable vDay          as integer no-undo.
     6623      define variable vBegLoadDate  as date    no-undo.
     6624      define variable vLastLoadDate as date    no-undo.
     6625      define buffer utd for utd.
     6626      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     6627      find first sys-ctrl no-lock.
     6628      if VLastDate eq ?
     6629      then
     6630         VLastDate = sys-ctrl.cut-date + 3.
     6631      else if sys-ctrl.cut-date ne ?
     6632      then
     6633         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     6634      vLastLoadDate = VLastDate.
     6635      for each tt-recid:
     6636         delete tt-recid.
     6637      end.
     6638      if chekStop() then return "Остановка пользователем".
     6639       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     6640      if chekStop() then return "Остановка пользователем".
     6641      if VLastDate ne ?
     6642      then do:
     6643         setextAttr('diadoc-lastload':U,string(VLastDate)).
     6644         vYear = year(vLastLoadDate).
     6645         vMonth = month(vLastLoadDate) - 2.
     6646         vDay   = day(vLastLoadDate).
     6647         if vMonth <= 0 then
     6648            assign
     6649               vMonth = vMonth + 12
     6650               vYear  = vYear - 1
     6651               .
     6652         repeat:
     6653            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     6654            if error-status:error then
     6655               vDay = vDay - 1.
     6656            else
     6657               leave.
     6658         end.
     6659         vBegLoadDate = vBegLoadDate + 1.
     6660      end.
     6661      block-rec:
     6662      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     6663         if  tt-recid.parent eq ""
     6664         then next  block-rec.
     6665         if first-of (tt-recid.parent)
     6666         then do:
     6667            for each utd where utd.PackageId eq tt-recid.parent
     6668            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     6669               if chekStop() then return "Остановка пользователем".
     6670               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6671               then do:
     6672                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6673                  MySeqUtd = ?.
     6674                  CrEdoc(utd.PackageId,utd.Timestamp).
     6675                  unsubscribe "getNextseq".
     6676                  next block-rec.
     6677               end.
     6678            end.
     6679         end.
     6680      end.
     6681      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     6682                                                                                        string(vBegLoadDate)
     6683                                                                                     else "?")
     6684                                                                                     + " по " +
     6685                                                                                     (if vLastLoadDate <> ? then
     6686                                                                                         string(vLastLoadDate)
     6687                                                                                      else
     6688                                                                                         "?")
     6689                                                                                      ).
     6690      define variable vobj as character no-undo.
     6691      vobj = getExtAttr('host-code':U).
     6692      if vobj ne "0"
     6693      then
     6694          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6695                         and utd.host-code eq int(vobj)
     6696                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6697                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6698                              )
     6699          no-lock break by utd.OrganizationExt:
     6700             if chekStop() then return "Остановка пользователем".
     6701             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6702             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6703                                   and tt-recid.docid = utd.DocumentExt
     6704                    no-error.
     6705             if     not available tt-recid
     6706                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6707             then do:
     6708                 run  UpdateUTDInformOne(vDocument).
     6709                release object vDocument no-error.
     6710             end.
     6711          end.
     6712      vobj = getExtAttr('obj':U).
     6713      if vobj ne ""
     6714      then
     6715          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6716                         and utd.obj-type + string(utd.obj-code) eq vobj
     6717          no-lock break by utd.OrganizationExt:
     6718             if chekStop() then return "Остановка пользователем".
     6719             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6720             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6721                                   and tt-recid.docid = utd.DocumentExt
     6722                    no-error.
     6723             if     not available tt-recid
     6724                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6725             then do:
     6726                 run  UpdateUTDInformOne(vDocument).
     6727                release object vDocument no-error.
     6728             end.
     6729          end.
     6730   end.
     6731   procedure  SendAuto:
     6732    define variable vOrganization as component-handle no-undo.
     6733    define variable vOrganizationList as component-handle no-undo.
     6734    define variable vi as integer no-undo.
     6735      if mDiadocConnection eq ?
     6736      then do:
     6737         message "По данному сертификату не удалось подключиться к Диадок"
     6738         view-as alert-box.
     6739      end.
     6740      else do:
     6741         for each tt-recid:
     6742            delete tt-recid.
     6743         end.
     6744         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6745         if vOrganizationList eq ? then return error ?.
     6746         vi = vOrganizationList:Count()no-error.
     6747         if vi eq ?
     6748         then
     6749            return error ?.
     6750         do vi = 1 to vOrganizationList:Count() :
     6751            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6752            define variable vorgid as character no-undo.
     6753            vorgid = vOrganization:guid.
     6754            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6755                           and utd.host-code eq v-cntxt-host-code-obj
     6756                           and utd.OrganizationExt eq vorgid
     6757            no-lock:
     6758                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6759            end.
     6760            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6761                           and utd.host-code eq v-cntxt-host-code-obj
     6762                           and utd.OrganizationExt eq vorgid
     6763            no-lock:
     6764                run  updOneUTD(utd.db-num,utd.doc-id).
     6765            end.
     6766         end.
     6767      end.
     6768   end.
     6769   procedure SendAccept:
     6770      define input  parameter iTypeAccept     as character no-undo.
     6771      define input  parameter iReplyTask      as component-handle no-undo.
     6772      define input  parameter iOrganizationGuid as character no-undo.
     6773      define input  parameter iWorkflowId     as integer no-undo.
     6774      define input  parameter iTitleTypes    as character  no-undo.
     6775      define output parameter oOperationCode as character no-undo.
     6776      define variable vContentItems as component-handle no-undo.
     6777      define variable vContentItem  as component-handle no-undo.
     6778      define variable vSigner       as component-handle no-undo.
     6779      define variable vBuyerTitle   as component-handle no-undo.
     6780      define variable vEmployee     as component-handle no-undo.
     6781      define variable vContentOperCode as component-handle no-undo.
     6782      define variable vOrganization   as component-handle no-undo.
     6783      define variable vUserperm   as component-handle no-undo.
     6784      define variable vi as integer no-undo.
     6785     define variable vdate as date no-undo.
     6786     define variable vDocumentCreator as character no-undo.
     6787     define variable vDocumentCreatorBase as character no-undo.
     6788     define variable vOperationCode as character no-undo.
     6789     define variable vOperationContenttext as character no-undo.
     6790     define variable vOperationContent as character no-undo.
     6791     define variable vThumbprint as character no-undo.
     6792     define variable vJobTitle   as character no-undo.
     6793     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6794     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6795     if vOrganization eq ?
     6796     then do:
     6797        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6798        if vdate eq ?
     6799        then
     6800           return error "".
     6801     end.
     6802     else do:
     6803        define variable vTitleType as character no-undo.
     6804        define variable vSignSet   as component-handle no-undo.
     6805        define variable vSeller as logical no-undo.
     6806        vUserperm = vOrganization:GetUserPermissions().
     6807        vJobTitle = vUserperm:JobTitle.
     6808        release object vUserperm.
     6809        blk-tit:
     6810        do vi = 1 to num-entries(iTitleTypes):
     6811           vTitleType = entry(vi,iTitleTypes).
     6812           vSeller = index(vTitleType,"Seller") > 0.
     6813           if vSeller
     6814           then
     6815              next blk-tit.
     6816           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6817           if error-status:num-messages > 0
     6818           then do:
     6819              define variable vTasksetSign   as component-handle no-undo.
     6820              define variable vTasksetSignDetal   as component-handle no-undo.
     6821              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6822              getdesc(vTasksetSign).
     6823              vTasksetSign:DocumentTitleType = vTitleType.
     6824              getdesc(vTasksetSign).
     6825              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6826              getdesc(vTasksetSignDetal).
     6827              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6828              vTasksetSignDetal:SignerType = "LegalEntity" .
     6829              vTasksetSignDetal:SignerInfo = "".
     6830              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6831              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6832              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6833              getdesc(vTasksetSignDetal).
     6834              release object vTasksetSignDetal.
     6835              vTasksetSign:send() no-error.
     6836              if error-status:num-messages > 0 then do:
     6837                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6838              end.
     6839              release object vTasksetSign.
     6840           end.
     6841           else do:
     6842              getdesc(vSignSet).
     6843              release object vSignSet.
     6844           end.
     6845        end.
     6846        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6847                            then "2"
     6848                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6849                            then "3"
     6850                            else "1".
     6851        vdate = today.
     6852        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6853        release object vOrganization.
     6854     end.
     6855     if    vJobTitle eq ?
     6856        or vJobTitle eq ""
     6857     then
     6858        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6859      if (   iWorkflowId = 3
     6860         or iWorkflowId = 5
     6861         or iWorkflowId = 8
     6862         or iWorkflowId = 11
     6863         or iWorkflowId = 12
     6864         or iWorkflowId = 13
     6865         or iWorkflowId = 16)
     6866         and iReplyTask ne ?
     6867      then do:
     6868         getdesc(iReplyTask).
     6869         vContentItems = iReplyTask:ContentItems.
     6870         getdesc(vContentItems).
     6871         do vi = 1 to vContentItems:count:
     6872            getdesc(vContentItems:GetItem(vi - 1 )).
     6873            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6874            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6875            getdesc(vContentItem).
     6876            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6877            getdesc(vBuyerTitle).
     6878              if vBuyerTitle eq ?
     6879            then do:
     6880               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6881               getdesc(vBuyerTitle).
     6882               vOperationContenttext = "C изменением стоимости согласен".
     6883            end.
     6884            else do:
     6885               oOperationCode = vOperationContent.
     6886      vOperationContenttext = if vOperationContent eq "1"
     6887                          then "Принято без разногласий"
     6888                          else if vOperationContent eq "2"
     6889                          then "Принято с разногласиями"
     6890                          else if vOperationContent eq "3"
     6891                          then "Товары не приняты"
     6892                          else vOperationContent.
     6893               getdesc(vBuyerTitle).
     6894               vEmployee = vBuyerTitle:Employee.
     6895               getdesc(vEmployee).
     6896               define variable vUser   as component-handle no-undo.
     6897               vUser = mDiadocConnection:GetMyUser().
     6898               getdesc(vUser).
     6899               vEmployee:position        = vJobTitle    .
     6900               vEmployee:FirstName       = vUser:FirstName  .
     6901               vEmployee:LastName        = vUser:LastName   .
     6902               vEmployee:MiddleName      = vUser:MiddleName .
     6903               vEmployee:EmployeeBase     = "Должностные обязанности".
     6904               release object vUser.
     6905               getdesc(vEmployee).
     6906               getdesc(mDiadocConnection:Certificate).
     6907               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6908               getdesc(vBuyerTitle:ContentOperCode).
     6909               vContentOperCode = vBuyerTitle:ContentOperCode.
     6910               vContentOperCode:TotalCode = vOperationContent.
     6911               vBuyerTitle:OperationCode   = oOperationCode.
     6912               release object vContentOperCode.
     6913               release object vEmployee.
     6914            end.
     6915            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6916            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6917            vBuyerTitle:OperationContent =  vOperationContenttext.
     6918            vBuyerTitle:AcceptanceDate   = vdate.
     6919            getdesc(vBuyerTitle).
     6920            getdesc(vBuyerTitle:Signers).
     6921            vSigner = vBuyerTitle:Signers:additems().
     6922            getdesc(vSigner).
     6923            getdesc(vSigner:SignerReference).
     6924            getdesc(vSigner:SignerDetails).
     6925            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6926            vSigner:SignerReference:boxid = iOrganizationGuid.
     6927            getdesc(vSigner:SignerReference).
     6928            release object vBuyerTitle no-error.
     6929            release object vContentItem.
     6930         end.
     6931         release object vContentItems.
     6932      end.
     6933   end.
     6934   function SendAnswer returns character
     6935   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6936      define variable vContent       as component-handle no-undo.
     6937      define variable vContentItems  as component-handle no-undo.
     6938      define variable vSigner        as component-handle no-undo.
     6939      define variable vSignTask      as component-handle no-undo.
     6940      define variable vOrganization  as component-handle no-undo.
     6941      define variable vUserperm      as component-handle no-undo.
     6942      define variable vUser          as component-handle no-undo.
     6943      define variable vi as integer no-undo.
     6944      if     itypeAnswer ne "AcceptRevocation"
     6945         and iReplyTask  ne ?
     6946      then do:
     6947         getdesc(iReplyTask).
     6948         vContentItems = iReplyTask:ContentItems.
     6949         getdesc(vContentItems).
     6950         do vi = 1 to vContentItems:count:
     6951            getdesc(vContentItems:GetItem(vi - 1 )).
     6952            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6953            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6954            vContent:comment =  imes.
     6955           getdesc(vContent).
     6956            vSigner = vContent:Signer.
     6957            getdesc(vSigner).
     6958            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6959            vUserperm = vOrganization:GetUserPermissions().
     6960            define variable vJobTitle as character no-undo.
     6961            vJobTitle = vUserperm:JobTitle.
     6962            if    vJobTitle eq ?
     6963               or vJobTitle eq ""
     6964            then
     6965               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6966            release object vUserperm.
     6967            release object vOrganization.
     6968            vUser = mDiadocConnection:GetMyUser().
     6969            getdesc(vUser).
     6970            vSigner:Surname    = vUser:FirstName.
     6971            vSigner:FirstName  = vUser:LastName.
     6972            vSigner:Patronymic = vUser:MiddleName.
     6973            vSigner:JobTitle   = vJobTitle.
     6974            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6975            getdesc(vSigner).
     6976            release object vUser.
     6977            release object vSigner.
     6978            release object vContent.
     6979         end.
     6980         release object vContentItems.
     6981      end.
     6982   end.
     6983   procedure send:
     6984      define input  parameter iDocument as component-handle no-undo.
     6985      define input  parameter iTypeAnswer as character no-undo.
     6986      define input  parameter icomment as character no-undo.
     6987      define output parameter oOperationCode as character no-undo.
     6988      define variable vReplyTask    as component-handle no-undo.
     6989      define variable vTypeAnswer as character no-undo.
     6990      define variable vTypeAnswer_orig as character no-undo.
     6991      define variable Vmes as longchar  no-undo.
     6992      define variable vOrganizationGuid as character no-undo.
     6993      define variable vDocumentid as character no-undo.
     6994      define variable vi as integer no-undo.
     6995      if iDocument ne ?
     6996      then do:
     6997         case iTypeAnswer:
     6998            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     6999            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     7000            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     7001            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     7002            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     7003            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     7004            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     7005            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     7006            otherwise vTypeAnswer = iTypeAnswer .
     7007         end case.
     7008         vTypeAnswer_orig = vTypeAnswer.
     7009         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     7010            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     7011         then
     7012            vTypeAnswer =  "AcceptDocument".
     7013         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     7014         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     7015         vOrganizationGuid = iDocument:OrganizationGuid.
     7016         vDocumentid     = iDocument:DocumentId.
     7017         getdesc(iDocument).
     7018         if vTypeAnswer =  "AcceptDocument"
     7019         then do:
     7020            define variable vtitletype as character no-undo.
     7021            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     7022            run sendAccept in this-procedure (vTypeAnswer_orig,
     7023                                              vReplyTask,
     7024                                              iDocument:OrganizationGuid,
     7025                                              iDocument:WorkflowId,
     7026                                              vtitletype,
     7027                                              output oOperationCode ) no-error.
     7028            if error-status:error
     7029            then
     7030               return error "".
     7031         end.
     7032         else do:
     7033            find first utd where utd.DocumentExt     = vDocumentid
     7034                             and utd.OrganizationExt = vOrganizationGuid
     7035            no-lock no-error.
     7036            if available utd
     7037            then do:
     7038               if   vTypeAnswer ne  "CorrectionRequest"
     7039                   and vTypeAnswer ne  "RejectDocument"
     7040               then
     7041                  icomment = "".
     7042               if vTypeAnswer eq  "RejectDocument"
     7043               then do:
     7044                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     7045                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     7046               end.
     7047               else do:
     7048                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     7049                   Vmes = GetErrComText(icomment,Vmes).
     7050               end.
     7051               if mFlaftest
     7052               then do:
     7053                  output stream File-stream to "SendAnswer.txt" .
     7054                  put stream File-stream unformatted string(Vmes).
     7055                  output stream File-stream close.
     7056                  message "сформирован файл " search("SendAnswer.txt")
     7057                  view-as alert-box.
     7058                  return error "ничего не отправляем".
     7059               end.
     7060               else
     7061                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     7062               if error-status:error
     7063               then
     7064                  return error "".
     7065               end.
     7066            end.
     7067         if not mFlaftest
     7068         then do:
     7069            getdesc(vReplyTask).
     7070             vReplyTask:Send() no-error.
     7071            if error-status:num-messages > 0 then do:
     7072               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     7073               release object vReplyTask.
     7074               return error "Ошибка при выполнение дейстия с документом".
     7075            end.
     7076         end.
     7077      end.
     7078   end.
     7079   procedure SendReceiptsAsync :
     7080   define input  parameter idb-num as integer no-undo.
     7081   define input  parameter idoc-id as integer no-undo.
     7082      define variable vDocument as component-handle no-undo.
     7083      define buffer utd for utd.
     7084      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7085      then do:
     7086         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7087         define variable vAsyncResult   as component-handle no-undo.
     7088         vAsyncResult = vDocument:SendReceiptsAsync().
     7089         release object vDocument.
     7090         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7091         find first utd where utd.db-num eq idb-num
     7092                          and utd.doc-id eq idoc-id
     7093         exclusive-lock no-error.
     7094         if available utd
     7095         then do:
     7096            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7097            then do:
     7098                run  UpdateUTDInformOne(vDocument).
     7099               release object vDocument.
     7100            end.
     7101            utd.flagRI = yes.
     7102       end.
     7103         PutMes(vAsyncResult:Result).
     7104         release object vAsyncResult.
     7105         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7106         then do:
     7107             run  UpdateUTDInformOne(vDocument).
     7108            release object vDocument.
     7109         end.
     7110      end.
     7111   end.
     7112   procedure SendAnsver:
     7113      define input  parameter idb-num as integer no-undo.
     7114      define input  parameter idoc-id as integer no-undo.
     7115      define input  parameter iTypeAnswer as character no-undo.
     7116      define input  parameter iComment as character no-undo.
     7117      define variable vSendcode as character no-undo.
     7118      define variable vDocument as component-handle no-undo.
     7119      define buffer utd for utd.
     7120      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7121      then do:
     7122         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     7123          run   SendReceiptsAsync(idb-num,idoc-id).
     7124            find first utd where utd.db-num eq idb-num
     7125                                   and utd.doc-id eq idoc-id
     7126                  no-lock.
     7127         if      (not utd.AmendmentRequested
     7128             and  iTypeAnswer eq "CorrectionRequest")
     7129             or iTypeAnswer ne "CorrectionRequest"
     7130         then do:
     7131             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     7132            if error-status:error
     7133            then do:
     7134               release object vDocument.
     7135               return error return-value.
     7136            end.
     7137            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     7138         end.
     7139         else
     7140            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     7141         release object vDocument.
     7142         if     vSendcode ne ?
     7143            and vSendcode ne ""
     7144         then
     7145            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     7146         if not mFlaftest
     7147         then do:
     7148            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7149            then do:
     7150                run   UpdateUTDInformOne(vDocument).
     7151               release object vDocument.
     7152            end.
     7153            if    iTypeAnswer eq "CorrectionRequest"
     7154               or iTypeAnswer eq "AcceptRevocation"
     7155               or iTypeAnswer eq "RejectRevocation"
     7156               or iTypeAnswer eq "RejectDocument"
     7157               or iTypeAnswer eq "AcceptDocument"
     7158               or iTypeAnswer eq "AcceptDocumentWithDisc"
     7159               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     7160            then do:
     7161               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7162               then do:
     7163                   run  UpdateUTDInformOne(vDocument).
     7164                  release object vDocument.
     7165               end.
     7166               if   not mFlaftest
     7167               then do trans:
     7168                  find first utd where utd.db-num eq idb-num
     7169                                   and utd.doc-id eq idoc-id
     7170                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7171                  exclusive-lock no-error.
     7172                  if available utd
     7173                  then do :
     7174                     case iTypeAnswer:
     7175                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7176                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7177                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     7178                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     7179                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     7180                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7181                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7182                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7183                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7184                     end case.
     7185                     if iTypeAnswer eq "CorrectionRequest"
     7186                     then do:
     7187                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     7188                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7189                        then do:
     7190                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     7191                        end.
     7192                     end.
     7193                  end.
     7194               end.
     7195            end.
     7196         end.
     7197      end.
     7198   end.
     7199   procedure  SendResponse :
     7200      define input  parameter idb-num as integer no-undo.
     7201      define input  parameter idoc-id as integer no-undo.
     7202      define input  parameter iAccept as logical no-undo.
     7203      define input  parameter itestMod as logical no-undo.
     7204       define buffer utd for utd.
     7205       define buffer buf_utd for utd.
     7206       itestMod = not itestMod.
     7207       define variable vreturn as logical no-undo.
     7208       find first utd where utd.db-num eq idb-num
     7209                        and utd.doc-id eq idoc-id
     7210       no-lock no-error.
     7211       if available utd
     7212       then do:
     7213          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     7214          then do:
     7215             if     iAccept
     7216                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     7217                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     7218             then do:
     7219                vreturn = yes.
     7220                if itestMod
     7221                then do:
     7222                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     7223                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     7224                                      and buf_utd.Timestamp <= utd.Timestamp
     7225                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     7226                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7227                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     7228                   no-lock :
     7229                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     7230                      if error-status:error then return error return-value.
     7231                   end.
     7232                end.
     7233             end.
     7234          end.
     7235          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7236          then do:
     7237             if iAccept
     7238             then do:
     7239                vreturn = yes.
     7240                if itestMod
     7241                then do:
     7242                   define variable vsend as logical no-undo.
     7243                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     7244                   if vsend
     7245                   then
     7246                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     7247                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     7248                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     7249                   no-lock no-error.
     7250                   if available buf_utd
     7251                   then do:
     7252                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     7253                      then do:
     7254                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     7255                         if error-status:error then return error return-value.
     7256                      end.
     7257                   end.
     7258                   run bge/sendutd.p(
     7259                        parparentproc,
     7260                        mDiadocConnection:Certificate:Thumbprint,
     7261                        idb-num,
     7262                        idoc-id) no-error.
     7263                   if error-status:error then return error return-value.
     7264                   do trans :
     7265                      find first utd where utd.db-num eq idb-num
     7266                                       and utd.doc-id eq idoc-id
     7267                      exclusive-lock no-error.
     7268                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     7269                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     7270                   end.
     7271                end.
     7272             end.
     7273          end.
     7274          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7275          then do:
     7276             if iAccept
     7277             then do:
     7278                vreturn = yes.
     7279                if itestMod
     7280                then
     7281                    run  SendReceiptsAsync(idb-num,idoc-id).
     7282             end.
     7283          end.
     7284          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     7285          then do:
     7286             if not iAccept
     7287             then do:
     7288                vreturn = yes.
     7289                if itestMod
     7290                then do:
     7291                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7292                   if error-status:error then return error return-value.
     7293                end.
     7294             end.
     7295          end.
     7296          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     7297          then do:
     7298             vreturn = yes.
     7299             if iAccept
     7300             then do:
     7301                if itestMod
     7302                then do:
     7303                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     7304                   if error-status:error then return error return-value.
     7305                end.
     7306             end.
     7307             else do:
     7308                if itestMod
     7309                then do:
     7310                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     7311                   if error-status:error then return error return-value.
     7312                end.
     7313             end.
     7314          end.
     7315          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     7316                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     7317          then do:
     7318             vreturn = yes.
     7319             if iAccept
     7320             then do:
     7321                if itestMod
     7322                then do:
     7323                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     7324                   if error-status:error then return error return-value.
     7325                end.
     7326             end.
     7327             else do:
     7328                if itestMod
     7329                then do:
     7330                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7331                   if error-status:error then return error return-value.
     7332                end.
     7333             end.
     7334          end.
     7335          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7336          then do:
     7337             if iAccept
     7338             then do:
     7339                vreturn = yes.
     7340                if itestMod
     7341                then do:
     7342                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7343                   if error-status:error then return error return-value.
     7344                end.
     7345             end.
     7346          end.
     7347          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     7348          then do:
     7349             if iAccept
     7350             then do:
     7351                vreturn = yes.
     7352                if itestMod
     7353                then do:
     7354                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     7355                   if error-status:error then return error return-value.
     7356                end.
     7357             end.
     7358          end.
     7359          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     7360          then do:
     7361             if iAccept
     7362             then do:
     7363                vreturn = yes.
     7364                if itestMod
     7365                then do:
     7366                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     7367                   if error-status:error then return error return-value.
     7368                end.
     7369             end.
     7370          end.
     7371          if itestmod and not vreturn
     7372          then do:
     7373             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     7374                                utd.db-num,
     7375                                utd.doc-id,
     7376                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     7377                                if iAccept then "Подписать" else "Отказать",
     7378                                utd.DocumentNumber)
     7379                                ).
     7380          end.
     7381       end.
     7382       return string(vreturn).
     7383   end.
     7384   define temp-table tt-pack no-undo
     7385             field orgid as char
     7386             field docid as char
     7387             field packid as char
     7388             field stamp as datetime
     7389             index pi packid   stamp   orgid  docid
     7390             .
     7391   function CheckLoad returns logical
     7392   (iDocument as component-handle,
     7393    output ohost-code as integer ,
     7394    output oObj-type  as character  ,
     7395    output oObj-code  as integer ):
     7396      define variable vFlag as logical no-undo.
     7397      define variable vDocumentChild as component-handle no-undo.
     7398      define variable vContent as component-handle no-undo.
     7399      define variable vConsignees as component-handle no-undo.
     7400      define variable vfilename as character no-undo.
     7401      oObj-type  = ?.
     7402      oObj-code  = ?.
     7403      ohost-code = ?.
     7404      define buffer ext-classif   for ext-classif.
     7405      define buffer clients       for clients.
     7406      define buffer buf_clients   for clients.
     7407      define buffer clients-attr  for clients-attr.
     7408      if   iDocument:type eq "UniversalTransferDocument"
     7409        or iDocument:type eq "UniversalTransferDocumentRevision"
     7410      then main-block :
     7411      do on error undo main-block, return error:
     7412         getdesc(iDocument).
     7413         vfilename = iDocument:filename.
     7414         if iDocument:Direction eq "Inbound"
     7415         then do:
     7416            define variable vOrganizationGuid as character no-undo.
     7417            define variable vDocumentid as character no-undo.
     7418            vOrganizationGuid = iDocument:OrganizationGuid.
     7419            vDocumentid     = iDocument:DocumentId.
     7420            find first utd where utd.DocumentExt     = vDocumentid
     7421                             and utd.OrganizationExt = vOrganizationGuid
     7422            no-lock no-error .
     7423            if available utd
     7424            then do:
     7425               assign
     7426                  Oobj-type = utd.obj-type
     7427                  Oobj-code = utd.obj-code
     7428                  ohost-code = utd.host-code.
     7429               .
     7430            end.
     7431            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     7432            getdesc(vDocumentChild).
     7433            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7434               and ohost-code ne 0 and ohost-code ne ?)
     7435            then vFlag = no.
     7436            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7437               and (ohost-code eq 0 and ohost-code eq ?))
     7438            then do:
     7439                find first clients  where clients.obj-type   = Oobj-type
     7440                                      and clients.obj-code   = Oobj-code
     7441                no-lock no-error .
     7442                if available clients
     7443                then
     7444                   ohost-code =  clients.host-code.
     7445                vFlag = no.
     7446            end.
     7447            else if vDocumentChild ne ?
     7448            then do:
     7449               if iDocument:version  eq "utd820_05_01_01"
     7450               then do:
     7451                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     7452               end.
     7453               else
     7454                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7455               release object vDocumentChild.
     7456               if vContent ne ?
     7457               then do:
     7458                  getdesc(vContent).
     7459                  define variable vFnsParticipantId as character no-undo.
     7460                  define variable vinn as character no-undo.
     7461                  define variable vkpp as character no-undo.
     7462                  define variable vorgname as character no-undo.
     7463                  define variable vAddrOrg as character no-undo.
     7464                  define variable vAdditionalInfo as character no-undo.
     7465                  if iDocument:version  eq "utd820_05_01_01"
     7466                  then do:
     7467                     getdesc(vContent:Sellers).
     7468                     getdesc(vContent:Sellers:Seller).
     7469                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     7470                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     7471                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7472                  end.
     7473                  else do:
     7474                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     7475                  end.
     7476                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7477                                           and ext-classif.charkey_three eq vFnsParticipantId
     7478                  no-lock no-error.
     7479                  if available ext-classif
     7480                  then do:
     7481                     find first clients
     7482                       where clients.obj-type   = ext-classif.CharKey_One
     7483                         and clients.obj-code   = ext-classif.Key#_One
     7484                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     7485                     no-lock no-error .
     7486                     if not available clients
     7487                     then do:
     7488                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7489                        return no.
     7490                     end.
     7491                  end.
     7492                  else do:
     7493                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7494                     return no.
     7495                  end.
     7496                  if iDocument:version  eq "utd820_05_01_01"
     7497                  then do:
     7498                     getdesc(vContent:Buyers).
     7499                     getdesc(vContent:Buyers:Buyer).
     7500                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     7501                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     7502                  end.
     7503                  else do:
     7504                     vConsignees = vContent:Consignees.
     7505                     getdesc(vConsignees).
     7506                     getdesc(vConsignees:Consignee).
     7507                     if vConsignees:Consignee:count > 0
     7508                     then do:
     7509                        getdesc(vConsignees:Consignee:GetItem(0)).
     7510                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7511                     end.
     7512                     release object vConsignees.
     7513                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     7514                  end.
     7515                  release object vContent.
     7516                  define variable otext as character no-undo.
     7517                  vFlag = getObgFns
     7518                             (input iDocument:DocumentNumber ,
     7519                              input vFnsParticipantId ,
     7520                              input vkpp,
     7521                              output ohost-code,
     7522                              output oobj-type,
     7523                              output oobj-code,
     7524                              output otext ).
     7525                  if otext ne "" and otext ne ?
     7526                  then
     7527                     PutMes( otext).
     7528                  if vFlag  eq no
     7529                  then
     7530                     return vFlag .
     7531               end.
     7532               else do:
     7533                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     7534                  return no.
     7535               end.
     7536            end.
     7537            else do:
     7538               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7539               return no.
     7540            end.
     7541         end.
     7542         else
     7543            return yes.
     7544         if ohost-code eq ? or ohost-code eq 0
     7545         then do:
     7546            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7547            return no.
     7548         end.
     7549      end.
     7550      else do:
     7551         define variable vdb-num as integer no-undo.
     7552         define variable vdoc-id as integer no-undo.
     7553         define variable vpack as character no-undo init ?.
     7554         define variable vcli-type as character no-undo.
     7555         define variable vcli-code as integer no-undo.
     7556         define variable vfns as character no-undo.
     7557         define variable vchar as character no-undo.
     7558         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     7559         if vDocumentChild eq ?
     7560         then do:
     7561            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7562            return no.
     7563         end.
     7564         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     7565         if vContent ne ?
     7566         then do:
     7567            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     7568            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7569                                     and ext-classif.charkey_three eq vFns
     7570            no-lock no-error.
     7571            if available ext-classif
     7572            then do:
     7573               assign
     7574                  vcli-type = ext-classif.CharKey_One
     7575                  vcli-code = ext-classif.Key#_One
     7576               .
     7577               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7578               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     7579               release object vContent.
     7580            end.
     7581            else do:
     7582                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7583                     return no.
     7584                  end.
     7585         end.
     7586         else do:
     7587            PutErr("Error Ошибка получения данных из Диадок Seller").
     7588            return no.
     7589         end.
     7590         release object vDocumentChild.
     7591         define buffer     utd for utd.
     7592         find first utd where utd.db-num eq vdb-num
     7593                          and utd.doc-id eq vdoc-id
     7594         no-lock no-error.
     7595         if available utd
     7596         then do:
     7597            assign
     7598               oobj-type  = utd.obj-type
     7599               oobj-code  = utd.obj-code
     7600               ohost-code = utd.host-code
     7601               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     7602            .
     7603         end.
     7604         else do:
     7605            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     7606            return no.
     7607         end.
     7608      end.
     7609      if  yes
     7610      then do:
     7611         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7612         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     7613         if     not EDOParSec:IsEdo
     7614            and vfilename begins "ON_NSCHFDOPPRMARK_"
     7615         then do:
     7616            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     7617            vFlag = no.
     7618         end.
     7619         else if     not EDOParSec:IsEdoNotmark
     7620                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     7621         then do:
     7622            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     7623            vFlag = no.
     7624         end.
     7625         else
     7626            vFlag = yes.
     7627      end.
     7628      return vFlag.
     7629   end.
     7630   procedure  UpdateUTDInformOne :
     7631      define input  parameter iDocument as component-handle no-undo.
     7632      define variable vOrganizationGuid as character no-undo.
     7633      define variable vDocumentId as character no-undo.
     7634      define variable vi as integer no-undo.
     7635      define variable vii as integer no-undo.
     7636      define variable viii as integer no-undo.
     7637      define variable vtext as longchar no-undo.
     7638      define buffer utd           for ub.utd.
     7639      define buffer old_utd           for ub.utd.
     7640      define buffer utd-lines      for ub.utd-lines.
     7641      define buffer marking       for ub.marking.
     7642      define buffer marking-lines for ub.marking-lines.
     7643      define buffer utd-marking-lines for ub.utd-marking-lines.
     7644      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     7645      define variable vDocumentChild               as component-handle no-undo.
     7646      define variable vContent                     as component-handle no-undo.
     7647      define variable vValues                      as component-handle no-undo.
     7648      define variable vSellers                     as component-handle no-undo.
     7649      define variable vConsignees                  as component-handle no-undo.
     7650      define variable vInvoiceTable                as component-handle no-undo.
     7651      define variable vItems                       as component-handle no-undo.
     7652      define variable vExtendedInvoiceItem         as component-handle no-undo.
     7653      define variable vItemIdentificationNumber    as component-handle no-undo.
     7654      define variable vTransferBaseCol             as component-handle no-undo.
     7655      define variable vTransferBase                as component-handle no-undo.
     7656      define variable vorgname as character no-undo.
     7657      define variable vAddrOrg as character no-undo.
     7658      define variable vAdditionalInfo as character no-undo.
     7659      define variable volddb-num as integer no-undo.
     7660      define variable volddoc-id as integer no-undo.
     7661      define variable vunits  as component-handle no-undo.
     7662      define variable vunit   as component-handle no-undo.
     7663      define variable VValue  as character        no-undo.
     7664      define variable vsite   as character        no-undo.
     7665      define variable vNewUtd as logical          no-undo.
     7666      if iDocument eq ?
     7667      then
     7668        return.
     7669      vOrganizationGuid = iDocument:OrganizationGuid.
     7670      vDocumentid     = iDocument:DocumentId.
     7671      find first utd where utd.DocumentExt     = vDocumentid
     7672                       and utd.OrganizationExt = vOrganizationGuid
     7673      no-lock no-error .
     7674      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     7675                            and tt-recid.docid eq vDocumentid
     7676      no-lock no-error.
     7677      if not available tt-recid
     7678      then do trans:
     7679         if iDocument  ne ?
     7680            and (
     7681                     iDocument:type eq "UniversalTransferDocument"
     7682                  or iDocument:type eq "UniversalTransferDocumentRevision"
     7683                  or iDocument:type eq "UniversalCorrectionDocument"
     7684                 )
     7685         then do:
     7686            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7687            define variable vhost-code as integer   no-undo.
     7688            define variable vobj-type  as character no-undo.
     7689            define variable vobj-code  as integer   no-undo.
     7690            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     7691            then do:
     7692               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7693               create tt-recid.
     7694               assign
     7695                  tt-recid.orgid = vOrganizationGuid
     7696                  tt-recid.docid = vDocumentid
     7697               .
     7698               return.
     7699            end.
     7700            find first utd where utd.DocumentExt     = vDocumentid
     7701                             and utd.OrganizationExt = vOrganizationGuid
     7702            no-lock no-error  .
     7703            if available utd
     7704            then do:
     7705               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7706                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     7707               then do:
     7708                  create tt-recid.
     7709                  assign
     7710                     tt-recid.orgid = vOrganizationGuid.
     7711                     tt-recid.docid = vDocumentid
     7712                  .
     7713                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7714               end.
     7715               find current utd exclusive-lock no-error  no-wait  .
     7716               if  not available  utd
     7717               then do:
     7718                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     7719                  return.
     7720               end.
     7721            end.
     7722            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7723            MySeqUtd = ?.
     7724            if     not available  utd
     7725            then do:
     7726               create utd.
     7727               assign
     7728                  utd.DocumentExt      = vDocumentid
     7729                  utd.OrganizationExt  = vOrganizationGuid
     7730                  vNewUtd              = yes
     7731               .
     7732               validate utd.
     7733            end.
     7734            assign
     7735               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     7736               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     7737               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     7738            .
     7739            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7740            utd.RevocationStatus = iDocument:RevocationStatus.
     7741            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7742            utd.TypeId           = iDocument:type.
     7743            utd.CounteragentId   = iDocument:Counteragent:guid.
     7744            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7745            utd.sts-edi = ?.
     7746            utd.DocumentNumber = iDocument:DocumentNumber.
     7747            utd.DocumentDate   = date(iDocument:DocumentDate).
     7748            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7749            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     7750            utd.Direction      = iDocument:Direction.
     7751            utd.ModifyDate = today.
     7752            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     7753            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     7754                             or iDocument:type eq "UniversalTransferDocumentRevision"
     7755                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7756                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     7757            getdesc(iDocument).
     7758            getdesc(iDocument:Counteragent).
     7759            getdesc(iDocument:RecipientReceiptMetadata).
     7760            getdesc(iDocument:ConfirmationMetadata).
     7761            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     7762            if iDocument:type ne "UniversalTransferDocumentRevision"
     7763            then do:
     7764                   utd.Revised = logical(iDocument:Revised).
     7765                   utd.Corrected = logical(iDocument:Corrected).
     7766            end.
     7767            vDocumentChild = iDocument:GetDynamicContent("Seller").
     7768            getdesc(vDocumentChild).
     7769            if   iDocument:type eq "UniversalTransferDocument"
     7770              or iDocument:type eq "UniversalTransferDocumentRevision"
     7771            then do:
     7772               utd.Total = iDocument:total.
     7773               utd.Vat = iDocument:Vat.
     7774            end.
     7775            else do:
     7776               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     7777               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     7778            end.
     7779            find first utd-lines where utd-lines.db-num     = utd.db-num
     7780                                   and utd-lines.doc-id     = utd.doc-id
     7781                                   no-lock no-error.
     7782            if     (   vNewUtd
     7783                    or utd.Direction ne "Inbound"
     7784                    or not available utd-lines)
     7785               and vDocumentChild ne ?
     7786            then do:
     7787               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7788               then do:
     7789                  if iDocument:version  eq "utd820_05_01_01"
     7790                  then do:
     7791                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     7792                  end.
     7793                  else
     7794                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7795                  if vContent ne ?
     7796                  then do:
     7797                     getdesc(vContent).
     7798                     define variable vInfoCount as integer no-undo.
     7799                     define variable vInfos as component-handle no-undo.
     7800                     define variable vInfo as component-handle no-undo.
     7801                     vInfos = vContent:AdditionalInfoId:AdditionalInfo.
     7802                     do vInfoCount = 1 to vInfos:count:
     7803                        vInfo = vInfos:getitem(vInfoCount - 1).
     7804                        getdesc(vInfo).
     7805                        setattrutd (utd.db-num,utd.doc-id,vInfo:id,vInfo:value).
     7806                     end.
     7807                     getdesc(vContent:TransferInfo).
     7808                     getdesc(vContent:TransferInfo:TransferBases).
     7809                     vTransferBasecol = vContent:TransferInfo:TransferBases:TransferBase.
     7810                     getdesc(vTransferBasecol).
     7811                     do vi = 1 to min(vTransferBasecol:count,1):
     7812                        vTransferBase = vTransferBasecol:getitem(vi - 1).
     7813                        getdesc(vTransferBase).
     7814                        utd.BaseDocumentNumber = vTransferBase:BaseDocumentNumber.
     7815                        utd.BaseDocumentName   = vTransferBase:BaseDocumentName.
     7816                        utd.BaseDocumentDate   = date(vTransferBase:BaseDocumentDate).
     7817                        release object vTransferBase.
     7818                     end.
     7819                     release object vTransferBasecol.
     7820                     vSellers = vContent:Sellers.
     7821                     getdesc(vSellers).
     7822                     getdesc(vSellers:Seller:GetItem(0)).
