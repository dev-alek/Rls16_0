      565   define  stream PrnLibStream.
      566   procedure prn-lib-prn-file :
      567     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      568     define input parameter p-DIsabledoptions as integer no-undo .
      569     define variable v-report-name as character no-undo .
      570     define variable v-user-action as character no-undo .
      571     define variable v-printed     as logical   no-undo .
      572     define variable v-exist       as logical   no-undo .
      573     do
      574       on error undo, return error
      575       :
      576       run prn-lib-get-report-name  in this-procedure (
      577         input parParentProc
      578         ,output v-report-name
      579         ).
      580   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      582     (input  v-report-name
      583     ,input  2
      584     ,output v-exist
      585     )  .
      586       if NOT v-exist then
      587       DO:
      588         Message
      589           "Нет заданий на печать ! "
      590           view-as alert-box .
      591         Return  .
      592       End.
      593       run gbl/prnfilen.w
      594         (input  ""
      595         ,input  p-DisabledOptions
      596         ,input  string(v-report-name )
      597         ,input  7
      598         ,output v-user-action
      599         ,output v-printed
      600         ) .
      601       if v-printed then
      602       do:
      603         return "YES" .
      604       end.
      605       else
      606       do:
      607         return "NO" .
      608       end.
      609     end.
      610   end procedure.
      611   procedure prn-lib-open-stream :
      612     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      613     define input parameter p-page-size    as integer no-undo .
      614     define input parameter p-is-stream    as logical no-undo .
      615     define input parameter p-append       as logical no-undo .
      616     define variable v-report-name as character no-undo .
      617     do
      618       on error undo, return error
      619       :
      620       run prn-lib-get-report-name  in this-procedure (
      621         input parParentProc
      622         ,output v-report-name
      623         ).
      624       if p-is-stream then
      625       do:
      626         if p-append then
      627         do:
      628           output stream PrnLibStream to value( v-report-name )
      629             page-size value(p-page-size) append .
      630         end.
      631         if not p-append then
      632         do:
      633           output stream PrnLibStream to value( v-report-name )
      634             page-size value(p-page-size) .
      635         end.
      636       end.
      637       if not p-is-stream then
      638       do:
      639         if p-append then
      640         do:
      641           output to value( v-report-name )
      642             page-size value(p-page-size) append .
      643         end.
      644         if not p-append then
      645         do:
      646           output to value( v-report-name )
      647             page-size value(p-page-size) .
      648         end.
      649       end.
      650     end.
      651   end procedure.
      652   procedure prn-lib-open-exp :
      653     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      654     define input parameter p-is-stream    as logical no-undo .
      655     define input parameter p-is-append    as logical no-undo .
      656     define output parameter p-ReportFileName as char init "report" no-undo.
      657     define output parameter p-process as logical no-undo .
      658     define variable glog as logical no-undo .
      659     do
      660       on error undo, return error
      661       :
      662       SYSTEM-DIALOG GET-FILE p-ReportFileName
      663         TITLE      "Укажите путь"
      664         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      665         ASK-OVERWRITE
      666         CREATE-TEST-FILE
      667         SAVE-AS
      668         USE-FILENAME
      669         DEFAULT-EXTENSION "txt"
      670         UPDATE glog
      671         .
      672       if not glog then  return.
      673       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      674       if p-is-stream then
      675       do:
      676         if p-is-append then
      677         do:
      678           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      679         end.
      680         else
      681         do:
      682           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      683         end.
      684       end.
      685       else
      686       do:
      687         if p-is-append then
      688         do:
      689           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      690         end.
      691         else
      692         do:
      693           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      694         end.
      695       end.
      696       p-process = yes.
      697     end.
      698   end procedure.
      699   procedure prn-lib-get-report-name :
      700     define input parameter parParentProc  as widget-handle no-undo.
      701     define output parameter p-report-name as character no-undo .
      702     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      703   end procedure.
      704   procedure prn-lib-reportviewer-report-name :
      705     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      706     define input parameter p-report-name-html as character no-undo .
      707     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      708   end procedure.
      709   procedure prn-lib-reportviewer :
      710     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      711     define input parameter p-report-name-html as character no-undo .
      712     define input parameter p-param        as character no-undo .
      713     define variable v-excel           as character no-undo init 'TRUE' .
      714     define variable v-value-character as character no-undo .
      715     define variable v-value-integer   as character no-undo .
      716     define variable v-value-date      as date      no-undo .
      717     define variable v-value-decimal   as decimal   no-undo .
      718     define variable rep-excel         as logical   no-undo .
      719     define variable excel-string      as character no-undo .
      720     define variable v-param-type      as character no-undo .
      721     define variable v-tth             as handle    no-undo .
      722     run adm/shattri.p (
      723       input "get":U
      724       ,input  ""
      725       ,input  0
      726       ,input  'report-glob':U
      727       ,input  'rep-excel':U
      728       ,output v-value-character
      729       ,output v-value-date
      730       ,output v-value-decimal
      731       ,output v-value-integer
      732       ,output rep-excel
      733       ,output v-param-type
      734       ,INPUT-OUTPUT table-handle v-tth
      735       )  .
      736     if rep-excel then v-excel = "TRUE" .
      737     else v-excel = "FALSE" .
      738     if p-param eq ""
      739     then
      740        p-param = "EXCEL:" + v-excel.
      741     else
      742        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      743     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      744   end procedure.
      745   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   define variable v-waitfram-action01         as character   no-undo .
      747   define variable v-waitfram-action02         as character   no-undo .
      748   define variable v-waitfram-action03         as character   no-undo .
      749   define variable mWaitFramTextBeg            as character   no-undo.
      750   define variable mWaitFramTextEnd            as character   no-undo.
      751   define variable mWaitFramView               as logical     no-undo.
      752   define variable mWaitProcEvent              as logical     no-undo init yes.
      753   define variable mWaitFramInterval           as integer     no-undo init 1 .
      754   define variable mWaitFramStop               as logical     no-undo.
      755   define variable mWaitFramStopUser           as logical     no-undo.
      756   define variable mWaitFramStopTimeOut        as logical     no-undo.
      757   define variable mWaitFramStartProc          as datetime-tz no-undo.
      758   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      759   define button B-WaitFramStop auto-end-key
      760        label "Стоп"
      761        size 10 by 1 tooltip "Остоновить процесс".
      762   define button B-viewProcInfo
      763        label "Информация"
      764        size 15 by 1 tooltip "Информация о процесс".
      765   define frame waitfram
      766     v-waitfram-action01 format "x(72)" no-label skip
      767     v-waitfram-action02 format "x(72)" no-label skip
      768     v-waitfram-action03 format "x(72)" no-label skip
      769     B-viewProcInfo
      770     B-WaitFramStop at row 4 col 30
      771     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      772     .
      773   define new global shared variable mBatchMode as logical no-undo init ?.
      774   define variable mFramBachModHandle as handle no-undo.
      775   mFramBachModHandle = frame waitfram:handle.
      776   define variable mFameOldVis as logical no-undo.
      777   define variable mVisCUrentVin as logical no-undo.
      778   if session:batch-mode
      779   then
      780      mBatchMode = yes.
      781   if mBatchMode = ? then do:
      782     mVisCUrentVin = current-window:visible.
      783     mFameOldVis = mFramBachModHandle:visible.
      784     mFramBachModHandle:visible  = yes.
      785     mBatchMode = mFramBachModHandle:visible ne yes.
      786     mFramBachModHandle:visible = mFameOldVis.
      787     current-window:visible = mVisCUrentVin.
      788   end.
      789    if  log-manager:logfile-name ne ?
      790     then DO:
      791         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      792         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      793         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      794     end.
      795   on choose of B-WaitFramStop in frame waitfram
      796   do:
      797     mWaitFramStop = yes.
      798     mWaitFramStopUser = yes.
      799   end.
      800   function waitfram-check-timeout returns logical():
      801      define variable vtime as int64 no-undo.
      802      if mWaitFramStopTimeOut
      803      then
      804         return yes.
      805      vtime = ( now - mWaitFramStartProc ) / 1000 .
      806      if     mWaitFramTimeOut ne ?
      807         and mWaitFramTimeOut ne 0
      808         and mWaitFramTimeOut lt vtime
      809      then do:
      810         mWaitFramStopTimeOut = yes.
      811      end.
      812      return mWaitFramStopTimeOut.
      813   end.
      814   procedure waitfram-hide :
      815     if not session:batch-mode
      816     then do
      817     on error undo, return error return-value
      818     :
      819       pause 0 before-hide .
      820       if not mBatchMode then
      821         hide frame waitfram .
      822     if     not mWaitFramView
      823        and mWaitProcEvent
      824     then
      825       process events .
      826     end.
      827   end procedure.
      828   procedure waitfram-show :
      829     define input  parameter p-message as character no-undo .
      830     define variable v-left-margin as integer   no-undo .
      831     if not session:batch-mode
      832     then do
      833     on error undo, return error return-value
      834     :
      835       if length(p-message) <= 70 then do:
      836         assign
      837           v-left-margin = integer((70 - length(p-message)) / 2)
      838         .
      839         assign
      840           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      841         .
      842         assign
      843           v-waitfram-action01 = " "
      844           v-waitfram-action02 = " "
      845                                    + fill(" ", v-left-margin)
      846                                    + p-message
      847           v-waitfram-action03 = " "
      848         .
      849       end.
      850       else do:
      851         define variable vRindex1 as integer no-undo.
      852         define variable vRindex2 as integer no-undo.
      853         vRindex1 = r-index(p-message," ",70).
      854         if vRindex1 = 0
      855         then
      856            vRindex1 = 70.
      857         if length(p-message)  <= vRindex1 + 70 then do:
      858           assign
      859             v-waitfram-action01 = " "
      860             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      861             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      862           .
      863         end.
      864         else do:
      865           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      866           if vRindex2 <= vRindex1
      867           then
      868              vRindex2 = vRindex1 + 70.
      869           assign
      870             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      871             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      872             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      873           .
      874         end.
      875       end.
      876       B-viewProcInfo:visible   in frame waitfram = no.
      877       B-viewProcInfo:sensitive in frame waitfram = no.
      878       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      879       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      880       if  (   mWaitFramView
      881          or  mWaitProcEvent)
      882          and not mBatchMode
      883       then
      884          display
      885             v-waitfram-action01 skip
      886             v-waitfram-action02 skip
      887             v-waitfram-action03 skip
      888          with frame waitfram .
      889       if     mWaitFramView
      890          then do:
      891             if     mWaitFramInterval ne ?
      892                and not mBatchMode
      893             then
      894                wait-for go of frame waitfram pause mWaitFramInterval.
      895          end.
      896          else
      897             if     mWaitProcEvent
      898                and not mBatchMode
      899             then
      900                process events .
      901     end.
      902   end procedure.
      903      procedure waitfram-show-this:
      904         define input  parameter iInterval as int64 no-undo.
      905         define variable vtime as int64 no-undo.
      906         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      907         mWaitFramInterval = iInterval.
      908         run waitfram-show (substitute("&1&2 &3&4" ,
      909                                       mWaitFramTextBeg ,
      910                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      911                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      912                                       mWaitFramTextEnd
      913                                      )
      914                           ).
      915      end.
      916      procedure WaitFramRunPause:
      917         define input  parameter iInterval as dec no-undo.
      918         define variable vStart  as datetime-tz no-undo.
      919         define variable vend    as datetime-tz no-undo.
      920         define variable vint as int64 no-undo.
      921         define variable vOk as logical no-undo.
      922         vStart = now.
      923         vend   = vStart.
      924         publish "WaitFramPause" (iInterval,output vOk).
      925         vend   =  now.
      926         vint = vend - vStart.
      927         vint = iInterval - vint / 1000.
      928         if     not mWaitFramStop
      929            and (   vint > 0
      930                 or (    not vOk
      931                     and iInterval eq ?
      932                     )
      933                 )
      934         then
      935            run waitfram-show-this (iInterval).
      936         vend   =  now.
      937         vint = vend - vStart.
      938         vint = iInterval - vint / 1000.
      939         if     not mWaitFramStop
      940            and vint > 0
      941         then do:
      942            run gbl/pause.p (vint * 1000).
      943         end.
      944         if iInterval ne ?
      945         then
      946            publish "WaitFramStop".
      947         waitfram-check-timeout().
      948      end.
      949      procedure WaitFramWaitFor:
      950         define input  parameter iInterval as dec no-undo.
      951         assign
      952            mWaitFramStartProc   = now
      953            mWaitFramStopUser    = no
      954            mWaitFramStopTimeOut = no
      955         .
      956         block-wait:
      957         do while not mWaitFramStop:
      958            run WaitFramRunPause (iInterval).
      959            if  waitfram-check-timeout()
      960            then do:
      961               leave block-wait.
      962            end.
      963         end.
      964         run waitfram-hide.
      965      end.
      966   procedure waitfram-join :
      967     define input  parameter p-line-1  as character no-undo .
      968     define input  parameter p-line-2  as character no-undo .
      969     define input  parameter p-line-3  as character no-undo .
      970     define output parameter p-message as character no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       assign
      975         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      976                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      977                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      978       .
      979     end.
      980   end procedure.
      981   function waitfram-join-function returns character
      982     (input p-line-1 as character
      983     ,input p-line-2 as character
      984     ,input p-line-3 as character
      985     ).
      986     define variable v-message as character no-undo .
      987     run waitfram-join in this-procedure
      988       (input  p-line-1
      989       ,input  p-line-2
      990       ,input  p-line-3
      991       ,output v-message
      992       ) .
      993     return v-message .
      994   end function .
      995   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   FUNCTION mark-string RETURNS CHARACTER
      997     ( input p-recid as recid, input mark-list as character  ) :
      998     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      999   END FUNCTION.
     1000   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     1002   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     1003   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
     1004   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
     1005   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
