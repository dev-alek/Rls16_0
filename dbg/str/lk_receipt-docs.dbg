     1750   procedure xmlchar-test :
     1751   define input parameter p-in-string          as character        no-undo.
     1752   define output parameter p-out-string-enc    as character        no-undo.
     1753   define output parameter p-out-string-dec    as character        no-undo.
     1754   do
     1755   on error undo, return error
     1756   :
     1757          run xmlchar-encode in this-procedure
     1758       (
     1759             input p-in-string
     1760           , output p-out-string-enc
     1761       ).
     1762          run xmlchar-decode in this-procedure
     1763       (
     1764             input p-out-string-enc
     1765           , output p-out-string-dec
     1766       ).
