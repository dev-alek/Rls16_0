     2886               "     Артикул    |    Количество   | Не хватает на складе |"
     2887               "     Наименование "
     2888               skip
     2889               "     Артикул    | для перемещения | "
     2890               v-store-obj-type
     2891               v-store-obj-code
     2892               skip
     2893               fill( "-", 160 )  format "X(160)"
     2894           .
     2895       output close.
     2896       run doc-code in this-procedure (
     2897             input "main"
     2898           , input v-store-obj-type
     2899           , input v-store-obj-code
     2900           , input ""
     2901           , output v-trn-doc-code
     2902       ).
