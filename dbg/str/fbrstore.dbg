     2045   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2046   function octal-to-char return character
     2047   ( p-string as character ) :
     2048     def var v-asc     as integer no-undo .
     2049     def var v-new-asc as integer no-undo .
     2050     def var ind       as integer no-undo .
     2051     if length(p-string) <> 3 then do:
     2052       return ? .
     2053     end.
     2054     assign
     2055       v-asc = 0
     2056     .
     2057     do ind = 1 to length(p-string)
     2058     :
     2059       assign
     2060         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2061       .
     2062       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2063         return ? .
     2064       end.
     2065       assign
     2066         v-asc = v-asc * 8 + v-new-asc
     2067       .
     2068     end.
     2069     return chr(v-asc) .
     2070   end function .
     2071   function char-to-octal return character
     2072   ( p-chr as character ) :
     2073     def var v-asc    as integer   no-undo .
     2074     def var ind      as integer   no-undo .
     2075     def var v-string as character no-undo .
     2076     if length(p-chr) <> 1 then do:
     2077       return ? .
     2078     end.
     2079     assign
     2080       v-asc    = asc(p-chr)
     2081       v-string = ""
     2082     .
     2083     do ind = 1 to 3
     2084     :
     2085       assign
     2086         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2087       .
     2088       assign
     2089         v-asc = truncate(v-asc / 8, 0)
     2090       .
     2091     end.
     2092     return v-string .
     2093   end.
     2094   function str-encode return character
     2095   (   p-init-string       as character
     2096     , p-encode-char       as character
     2097     , p-special-char-list as character
     2098   ) :
     2099     def var p-encode-string as character no-undo .
     2100     def var ind                as integer no-undo .
     2101     def var v-num-special-char as integer no-undo .
     2102     def var v-special-char     as character no-undo .
     2103     if p-encode-char = ?
     2104     or p-encode-char = "" then do:
     2105       assign
     2106         p-encode-char = "~~"
     2107       .
     2108     end.
     2109     if p-init-string = ? then do:
     2110       return "?" .
     2111     end.
     2112     if p-init-string = "?" then do:
     2113       return p-encode-char + char-to-octal("?") .
     2114     end.
     2115     assign
     2116       v-num-special-char = length(p-special-char-list)
     2117       p-encode-string    = replace(p-init-string
     2118                                   ,p-encode-char
     2119                                   ,p-encode-char + char-to-octal(p-encode-char)
     2120                                   )
     2121     .
     2122     do ind = 1 to v-num-special-char
     2123     :
     2124       assign
     2125         v-special-char = substring(p-special-char-list, ind, 1)
     2126       .
     2127       if v-special-char <> p-encode-char then do:
     2128         assign
     2129           p-encode-string = replace (p-encode-string
     2130                                     ,v-special-char
     2131                                     ,p-encode-char + char-to-octal(v-special-char)
     2132                                     )
     2133         .
     2134       end.
     2135     end.
     2136     return p-encode-string .
     2137   end.
     2138   function str-decode returns character
     2139     (p-init-string   as character
     2140     ,p-encode-char   as character
     2141     ) :
     2142     def var p-decode-string as character no-undo .
     2143     def var ind                       as integer no-undo .
     2144     def var v-num-entries-init-string as integer no-undo .
     2145     def var v-sub-phrase              as character no-undo .
     2146     def var v-special-char            as character no-undo .
     2147     if p-encode-char = ?
     2148     or p-encode-char = "" then do:
     2149       assign
     2150         p-encode-char = "~~"
     2151       .
     2152     end.
     2153     if p-init-string = "?" then do:
     2154       return ? .
     2155     end.
     2156     assign
     2157       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2158     .
     2159     if v-num-entries-init-string > 1 then do:
     2160       assign
     2161         p-decode-string = entry(1, p-init-string, p-encode-char)
     2162       .
     2163       do ind = 2 to v-num-entries-init-string
     2164       :
     2165         assign
     2166           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2167         .
     2168         assign
     2169           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2170         .
     2171         if v-special-char <> ? then do:
     2172           assign
     2173             p-decode-string = p-decode-string
     2174                             + v-special-char
     2175                             + substring(v-sub-phrase, 4)
     2176           .
     2177         end.
     2178         else do:
     2179           assign
     2180             p-decode-string = p-decode-string
     2181                             + p-encode-char
     2182                             + v-sub-phrase
     2183           .
     2184         end.
     2185       end.
     2186     end.
     2187     else do:
     2188       assign
     2189         p-decode-string = p-init-string
     2190       .
     2191     end.
     2192     return p-decode-string .
     2193   end.
     2194   define variable vss-include-info20 as character format "X(65)" no-undo
     2195   initial "@(#)$Workfile$ $Revision$".
     2196   procedure fbrrsrv-rsrv-goods :
     2197   define input parameter p-parent-proc            as handle                   no-undo.
     2198   define input parameter p-goods-recid            as recid                    no-undo.
     2199   define input parameter p-doc-line-recid         as recid                    no-undo.
     2200   define input parameter p-required-qnty          like doc-line.doc-qnty      no-undo.
     2201   define input parameter p-set-price              as logical                  no-undo.
     2202   define input parameter p-price                  as decimal                  no-undo.
     2203   define input parameter p-rsrv-by-parts          as logical                  no-undo.
     2204   define input parameter p-income-trn-doc-code    as character                no-undo.
     2205   define output parameter p-rsrv-qnty             like doc-line.doc-qnty      no-undo.
     2206       define variable v-parts-rsrv-qnty       as decimal      no-undo.
     2207       define variable v-sum-parts-rsrv-qnty   as decimal      no-undo.
     2208       define variable v-r-b-is-base           as logical      no-undo.
     2209       define variable v-cost-base             as decimal      no-undo.
     2210       define variable v-cost-rubl             as decimal      no-undo.
     2211       define variable v-parts-parameter       as character    no-undo.
     2212       define variable v-parts-found           as logical      no-undo.
     2213       define variable v-price-base            as decimal      no-undo.
     2214       define variable v-price-rubl            as decimal      no-undo.
     2215       define variable v-yesno                 as logical      no-undo.
     2216       define buffer buf_goods         for goods.
     2217       define buffer buf_gds-prt       for gds-prt.
     2218       define buffer buf_gds-dtl       for gds-dtl.
     2219       define buffer buf_trn-doc       for trn-doc.
     2220       define buffer buf_doc-line      for doc-line.
     2221       define buffer buf_parts         for parts.
     2222   do
     2223   for buf_goods
     2224     , buf_gds-prt
     2225     , buf_gds-dtl
     2226     , buf_trn-doc
     2227     , buf_doc-line
     2228     , buf_parts
     2229   on error undo, return error
     2230   :
     2231   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2233     (output v-r-b-is-base
     2234     )  .
     2235       find first buf_goods no-lock
     2236            where recid( buf_goods ) = p-goods-recid
     2237       .
     2238       find first buf_gds-prt no-lock
     2239            where buf_gds-prt.upper-code = buf_goods.prt-root
     2240       .
     2241       find first buf_doc-line no-lock
     2242            where recid( buf_doc-line ) = p-doc-line-recid
     2243       .
     2244       find first buf_trn-doc exclusive-lock
     2245            where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2246       .
     2247       assign
     2248           buf_trn-doc.print-rubl = ( if v-r-b-is-base = yes then no else yes )
     2249       .
     2250   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     2251     ( input buf_trn-doc.obj-code
     2252      ,input buf_trn-doc.obj-type
     2253      ,input buf_trn-doc.doc-code
     2254      ,input buf_goods.artic
     2255      ,input buf_goods.prod-code
     2256      ,input buf_goods.prod-type
     2257      ,input buf_gds-prt.node-code
     2258      ,input yes
     2259     ) no-error .
     2260       if error-status:error
     2261       then do:
     2262           message
     2263               "Ошибка при создании признака."
     2264               skip return-value
     2265           view-as alert-box error.
     2266       end.
     2267       find first buf_gds-dtl exclusive-lock
     2268            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     2269              and buf_gds-dtl.artic     = buf_goods.artic
     2270              and buf_gds-dtl.prod-type = buf_goods.prod-type
     2271              and buf_gds-dtl.prod-code = buf_goods.prod-code
     2272              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     2273       .
     2274       if p-set-price = yes
     2275       then do:
     2276           if v-r-b-is-base = yes
     2277           then do:
     2278               assign
     2279                   buf_gds-dtl.price-base = p-price
     2280                   buf_gds-dtl.price-rubl = p-price * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     2281               .
     2282           end.
     2283           else do:
     2284               assign
     2285                   buf_gds-dtl.price-rubl = p-price
     2286                   buf_gds-dtl.price-base = p-price / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     2287               .
     2288           end.
     2289       end.
     2290       else do:
     2291   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2292   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     2293     ( input recid(buf_gds-dtl)
     2294     , input no
     2295     , input ?
     2296     ) no-error.
     2297           if error-status:error
     2298           then do:
     2299               message
     2300                   "Ошибка при назначении цены признака."
     2301                   skip return-value
     2302               view-as alert-box error.
     2303           end.
     2304           if v-r-b-is-base = yes
     2305           then do:
     2306               assign
     2307                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-base * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     2308                   buf_gds-dtl.price-base = buf_gds-dtl.price-base
     2309               .
     2310           end.
     2311           else do:
     2312               assign
     2313                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-rubl
     2314                   buf_gds-dtl.price-base = buf_gds-dtl.price-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     2315               .
     2316           end.
     2317       end.
     2318       assign
     2319           buf_trn-doc.status_ = 'накл':U
     2320           buf_trn-doc.flag_   = no
     2321       .
     2322       assign
     2323           buf_gds-dtl.ov  = yes
     2324           v-cost-base     = buf_doc-line.price-base
     2325           v-cost-rubl     = buf_doc-line.price-rubl
     2326           p-rsrv-qnty     = round( p-required-qnty, 3 )
     2327       .
     2328       if p-rsrv-by-parts = yes
     2329       then do:
     2330           assign
     2331               v-parts-found           = no
     2332               v-sum-parts-rsrv-qnty   = 0
     2333           .
     2334           if p-income-trn-doc-code <> ""
     2335           then do:
     2336               for each buf_parts no-lock
     2337                  where buf_parts.obj-type  = buf_doc-line.obj-type
     2338                    and buf_parts.obj-code  = buf_doc-line.obj-code
     2339                    and buf_parts.prod-type = buf_doc-line.prod-type
     2340                    and buf_parts.prod-code = buf_doc-line.prod-code
     2341                    and buf_parts.artic     = buf_doc-line.artic
     2342                    and buf_parts.in-code   = p-income-trn-doc-code
     2343                    and buf_parts.out-code  = p-income-trn-doc-code
     2344               on error undo, return error return-value
     2345               :
     2346                   assign
     2347                       v-parts-found     = yes
     2348                       v-parts-parameter = 'reserv':U
     2349                                   + ",":U + 'no-message':U
     2350                                   + ",":U + 'rsrv-single-part':U
     2351                                   + ",":U + 'rsrv-in-code':U   + "=":U + str-encode ( buf_parts.in-code  ,  "", ",=":U )
     2352                                   + ",":U + 'rsrv-part-code':U + "=":U + str-encode ( buf_parts.part-code,  "", ",=":U )
     2353                   .
     2354                   assign
     2355                       v-parts-rsrv-qnty = ( if p-rsrv-qnty < buf_parts.fact-qnty then p-rsrv-qnty else buf_parts.fact-qnty )
     2356                   .
     2357                   run trg/rsrv-dtl.p (
     2358                         input p-parent-proc
     2359                       , input v-parts-parameter
     2360                       , buffer buf_gds-dtl
     2361                       , input-output v-parts-rsrv-qnty
     2362                       , input-output v-cost-base
     2363                       , input-output v-cost-rubl
     2364                       , input -1
     2365                       , input ""
     2366                   ) no-error.
     2367                   if error-status:error
     2368                   then do:
     2369                       undo, return error return-value.
     2370                   end.
     2371                   if v-cost-base <= 0
     2372                   or v-cost-rubl <= 0
     2373                   then do:
     2374                       undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2375                                                     ,chr(10)
     2376                                                     ,"РУБЛИ:   "
     2377                                                     ,v-cost-rubl
     2378                                                     ,v-cost-base
     2379                                                     ,buf_doc-line.artic).
     2380                       .
     2381                   end.
     2382                   assign
     2383                       v-sum-parts-rsrv-qnty = v-sum-parts-rsrv-qnty + v-parts-rsrv-qnty
     2384                       p-rsrv-qnty           = p-rsrv-qnty           - v-parts-rsrv-qnty
     2385                   .
     2386               end.
     2387           end.
     2388           if p-rsrv-qnty > 0
     2389           then do:
     2390               run trg/rsrv-dtl.p (
     2391                     input p-parent-proc
     2392                   , input 'reserv':U
     2393                           + ",":U + 'no-message':U
     2394                           + ",":U + 'negative-check':U + '=':U + '1':U
     2395                   , buffer buf_gds-dtl
     2396                   , input-output p-rsrv-qnty
     2397                   , input-output v-cost-base
     2398                   , input-output v-cost-rubl
     2399                   , input -1
     2400                   , input ""
     2401               ) no-error.
     2402               if error-status:error
     2403               then do:
     2404                   undo, return error return-value.
     2405               end.
     2406               if v-cost-base <= 0
     2407               or v-cost-rubl <= 0
     2408               then do:
     2409                   undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2410                                                 ,chr(10)
     2411                                                 ,"РУБЛИ:   "
     2412                                                 ,v-cost-rubl
     2413                                                 ,v-cost-base
     2414                                                 ,buf_doc-line.artic).
     2415               end.
     2416           end.
     2417           assign
     2418               p-rsrv-qnty = p-rsrv-qnty + v-sum-parts-rsrv-qnty
     2419           .
     2420       end.
     2421       else do:
     2422           run trg/rsrv-dtl.p (
     2423                 input p-parent-proc
     2424               , input 'reserv':U
     2425                       + ",":U + 'no-message':U
     2426                       + ",":U + 'negative-check':U + '=':U + '1':U
     2427               , buffer buf_gds-dtl
     2428               , input-output p-rsrv-qnty
     2429               , input-output v-cost-base
     2430               , input-output v-cost-rubl
     2431               , input -1
     2432               , input ""
     2433           ) no-error.
     2434           if error-status:error
     2435           then do:
     2436               undo, return error return-value.
     2437           end.
     2438           if v-cost-base <= 0
     2439           or v-cost-rubl <= 0
     2440           then do:
     2441             undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2442                                           ,chr(10)
     2443                                           ,"РУБЛИ:   "
     2444                                           ,v-cost-rubl
     2445                                           ,v-cost-base
     2446                                           ,buf_doc-line.artic).
     2447           end.
     2448       end.
     2449   end.
     2450   end procedure.
     2451   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2452   procedure doc-code:
     2453   define input  parameter parmode          as   character           no-undo.
     2454   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2455   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2456   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2457   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2458   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2459   define variable vardb-remote     as   logical             no-undo.
     2460   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2461   define variable v-delimiter as character no-undo .
     2462   do
     2463   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2464   :
     2465   find first buf_sys-ctrl no-lock .
     2466   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2467     CASE parmode:
     2468       when "main":u then do:
     2469         if vardb-remote then do:
     2470           assign
     2471             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2472         end.
     2473         else do:
     2474           assign
     2475             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2476         end.
     2477       end.
     2478       when "trio" then do:
     2479         assign
     2480           pardoc-code = replace (parroot-doc-code, "=", "*").
     2481       end.
     2482       otherwise do:
     2483         assign
     2484         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2485         no-error
     2486         .
     2487         if error-status:error  then do:
     2488           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2489                                         ,chr(10)
     2490                                         ,parmode
     2491                                         ).
     2492         end.
     2493         if num-entries(parmode) = 1
     2494         and parmode <> "chip":U
     2495         and parmode <> "chip_s":U
     2496         then do:
     2497           assign
     2498           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2499         end.
     2500         else if (lookup("chip":U, parmode) > 0
     2501                  or
     2502                  lookup("chip_s":U, parmode) > 0) then do:
     2503           assign
     2504             vartemp-doc-code = parroot-doc-code.
     2505           do while true:
     2506             if index (vartemp-doc-code , ".") = 0 then
     2507               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2508             else
     2509               vartemp-doc-code  =
     2510               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2511               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2512               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2513             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2514           end.
     2515           assign
     2516             pardoc-code = vartemp-doc-code.
     2517         end.
     2518       end.
     2519     end CASE.
     2520     if pardoc-code = '':U
     2521     or (parroot-doc-code <> '':U
     2522     and pardoc-code = parroot-doc-code) then do:
     2523       undo, return error substitute("Ошибка при генерации номера документа&1"
     2524                                     ,chr(10)).
     2525     end.
     2526   end.
     2527   end. // procedure/method
     2528   function get-doc-code-int64 returns int64
     2529     ( input p-doc-code as character ) :
     2530     define variable v-ind              as integer   no-undo .
     2531     define variable v-num-entries      as integer   no-undo .
     2532     define variable v-doc-code-int64   as int64     no-undo .
     2533     define variable v-canonic-doc-code as character no-undo .
     2534     assign
     2535       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2536       v-canonic-doc-code = p-doc-code
     2537     .
     2538     do v-ind = 1 to v-num-entries
     2539     :
     2540       assign
     2541         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2542       .
     2543     end.
     2544     assign
     2545       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2546     .
     2547     return v-doc-code-int64 .
     2548   end. // function/method
     2549   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2550   procedure cur-time :
     2551      define output parameter p-today as date      no-undo .
     2552      define output parameter p-time  as integer   no-undo .
     2553     do
     2554     on error undo, return error
     2555     :
     2556       define variable v-date1 as date      no-undo .
     2557       define variable v-date2 as date      no-undo .
     2558       define variable v-time  as integer   no-undo .
     2559       assign
     2560         v-date1 = today
     2561         v-time  = time
     2562         v-date2 = today
     2563       .
     2564       if v-date1 <> v-date2
     2565       then do:
     2566         assign
     2567           v-date1 = today
     2568           v-time  = v-time
     2569         .
     2570       end.
     2571       assign
     2572         p-today = v-date1
     2573         p-time  = v-time
     2574       .
     2575     end.
     2576   end.
     2577   function cur-time-date returns character
     2578   :
     2579     return string(today, '99/99/9999':U) .
     2580   end.
     2581   function cur-time-mjd returns decimal
     2582   :
     2583     define variable v-date as date      no-undo .
     2584     define variable v-time as integer   no-undo .
     2585     run cur-time in this-procedure
     2586       (output v-date
     2587       ,output v-time
     2588       ) .
     2589     return integer(v-date) - 2400002 + (v-time / 86400) .
     2590   end.
     2591   function cur-time-get-ending-index returns integer
     2592   (input p-number as integer
     2593   )
     2594   :
     2595     if p-number < 0
     2596     or p-number = ?
     2597     then do:
     2598       return 1 .
     2599     end.
     2600     define variable v-rest as integer   no-undo .
     2601     assign
     2602       p-number = p-number modulo 100
     2603     .
     2604     if p-number < 20
     2605     then do:
     2606       assign
     2607         v-rest = p-number
     2608       .
     2609     end.
     2610     else do:
     2611       assign
     2612         v-rest = p-number modulo 10
     2613       .
     2614     end.
     2615     case v-rest :
     2616       when 1
     2617       then do:
     2618         return 2 .
     2619       end.
     2620       when 2 or
     2621       when 3 or
     2622       when 4
     2623       then do:
     2624         return 3 .
     2625       end.
     2626       otherwise do:
     2627         return 1 .
     2628       end.
     2629     end case .
     2630   end.
     2631   procedure cur-time-mjd-to-date :
     2632      define input  parameter i-mjd-diff as decimal no-undo.
     2633      define output parameter o-Date     as date    no-undo.
     2634      define output parameter o-Time     as integer no-undo.
     2635      define variable v-day-number as integer   no-undo .
     2636      if    i-mjd-diff < 0
     2637         or i-mjd-diff = ?
     2638      then do:
     2639         return "?" .
     2640      end.
     2641      assign
     2642         v-day-number = truncate(i-mjd-diff,0).
     2643         o-Date = date(v-day-number + 2400002).
     2644         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2645     .
     2646   end.
     2647   function cur-time-mjd-to-string returns character
     2648   (input p-mjd-diff as decimal
     2649   )
     2650   :
     2651     define variable v-day-number as integer   no-undo .
     2652     define variable v-seconds    as integer   no-undo .
     2653     define variable v-hour       as integer   no-undo .
     2654     define variable v-min        as integer   no-undo .
     2655     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2656     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2657     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2658     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2659     if p-mjd-diff < 0
     2660     or p-mjd-diff = ?
     2661     then do:
     2662       return "?" .
     2663     end.
     2664     assign
     2665       v-day-number = integer(truncate(p-mjd-diff,0))
     2666       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2667     .
     2668     if v-seconds > 86400
     2669     then do:
     2670       assign
     2671         v-seconds = 86400 - 1
     2672       .
     2673     end.
     2674     if v-seconds < 0
     2675     then do:
     2676       assign
     2677         v-seconds = 0
     2678       .
     2679     end.
     2680     assign
     2681       v-hour = truncate(v-seconds / 3600, 0)
     2682     .
     2683     assign
     2684       v-seconds = v-seconds modulo 3600
     2685     .
     2686     assign
     2687       v-min = truncate(v-seconds / 60, 0)
     2688     .
     2689     assign
     2690       v-seconds = v-seconds modulo 60
     2691     .
     2692     return
     2693         (if v-day-number <> 0
     2694           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2695           else ""
     2696         )
     2697       + (if v-day-number <> 0 or v-hour <> 0
     2698           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2699           else ""
     2700         )
     2701       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2702           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2703           else ""
     2704         )
     2705       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2706       .
     2707   end.
     2708   function cur-time-string returns character
     2709   :
     2710     define variable v-date as date      no-undo .
     2711     define variable v-time as integer   no-undo .
     2712     run cur-time in this-procedure
     2713       (output v-date
     2714       ,output v-time
     2715       ) .
     2716     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2717   end.
     2718   function cur-time-string-sec returns character
     2719   :
     2720     define variable v-date as date      no-undo .
     2721     define variable v-time as integer   no-undo .
     2722     run cur-time in this-procedure
     2723       (output v-date
     2724       ,output v-time
     2725       ) .
     2726     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2727   end.
     2728   function cur-time-custom  returns character
     2729   (input p-prefix as character
     2730   ,input p-date-format as character
     2731   ,input p-delimiter as character
     2732   ,input p-time-format as character
     2733   ,input p-suffix as character
     2734   )
     2735   :
     2736     define variable v-date as date      no-undo .
     2737     define variable v-time as integer   no-undo .
     2738     run cur-time in this-procedure
     2739       (output v-date
     2740       ,output v-time
     2741       ) .
     2742     return
     2743       p-prefix
     2744       + string(v-date, p-date-format)
     2745       + p-delimiter
     2746       + string(v-time, p-time-format)
     2747       + p-suffix
     2748       .
     2749   end.
     2750   function cur-time-print  returns character
     2751   :
     2752     define variable v-date as date      no-undo .
     2753     define variable v-time as integer   no-undo .
     2754     run cur-time in this-procedure
     2755       (output v-date
     2756       ,output v-time
     2757       ) .
     2758     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2759   end.
     2760   function cur-time-datetime returns datetime
     2761   :
     2762     define variable v-char as character no-undo .
     2763     define variable v-datetime as datetime no-undo .
     2764     v-char = cur-time-string().
     2765     v-datetime = datetime(v-char).
     2766     return  v-datetime.
     2767   end.
     2768   function cur-time-string-msec returns character
     2769   :
     2770     define variable v-date as datetime  no-undo .
     2771     v-date = now.
     2772     return string(v-date) .
     2773   end.
     2774   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
