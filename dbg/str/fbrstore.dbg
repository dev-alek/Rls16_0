     2810   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2811   define new global shared variable g#trdcalib as handle no-undo.
     2812       define variable v-store-obj-type    as character      no-undo.
     2813       define variable v-store-obj-code    as integer        no-undo.
     2814       define variable v-trn-doc-code      as character      no-undo.
     2815       define variable v-today             as date           no-undo.
     2816       define variable v-time              as integer        no-undo.
     2817       define variable v-host-code         as integer        no-undo.
     2818       define variable v-base-code         as integer        no-undo.
     2819       define variable v-host-name         as character      no-undo.
     2820       define variable v-down-pay          as integer        no-undo.
     2821       define variable v-store-free-qnty   as decimal        no-undo.
     2822       define variable v-kitchen-free-qnty as decimal        no-undo.
     2823       define variable v-cntxt-db-num as integer no-undo .
     2824       define variable v-cntxt-userid as character no-undo .
     2825       define variable v-sum-base          as decimal        no-undo.
     2826       define variable v-sum-rubl          as decimal        no-undo.
     2827       define variable v-sum-vat-base      as decimal        no-undo.
     2828       define variable v-sum-vat-rubl      as decimal        no-undo.
     2829       define variable v-rb-is-base        as logical        no-undo.
     2830       define buffer buf_fbr-doc           for fbr-doc.
     2831       define buffer buf_fbr-line          for fbr-line.
     2832       define buffer buf_curr-accnt        for curr-accnt.
     2833       define buffer buf_trn-doc           for trn-doc.
     2834       define buffer buf_income_trn-doc    for trn-doc.
     2835       define buffer buf_doc-line          for doc-line.
     2836       define buffer buf_shop              for shop.
     2837   do
     2838   for buf_fbr-doc
     2839     , buf_fbr-line
     2840     , buf_curr-accnt
     2841     , buf_trn-doc
     2842     , buf_income_trn-doc
     2843     , buf_doc-line
     2844     , buf_shop
     2845   on error undo, return error
     2846   :
     2847       run get-db-num in parparentproc ( output v-cntxt-db-num).
     2848       run get-userid in parparentproc ( output v-cntxt-userid).
     2849       find first buf_fbr-doc no-lock
     2850            where buf_fbr-doc.doc-code = p-fbr-doc-code
     2851       .
     2852       run fbrrest-get-catering-object in this-procedure (
     2853             input buf_fbr-doc.obj-code
     2854           , output v-store-obj-type
     2855           , output v-store-obj-code
     2856       ).
     2857       IF v-store-obj-type = ""
     2858       OR v-store-obj-code = 0
     2859       THEN DO:
     2860           message
     2861                "Невозможно зарезервировать товар:"
     2862           skip "Не задан склад-подсобка для ресторана."
     2863           view-as alert-box error.
     2864           undo, return error .
     2865       END.
     2866       if v-store-obj-type  = buf_fbr-doc.obj-type
     2867       and v-store-obj-code = buf_fbr-doc.obj-code
     2868       then do:
     2869           undo, return.
     2870       end.
     2871   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2873     (output v-rb-is-base
     2874     )  .
     2875       output to "fbrgoods.log".
     2876           put
     2877               "Товары, которые надо переместить на кухню ("
     2878               buf_fbr-doc.obj-type
     2879               buf_fbr-doc.obj-code
     2880               ") со склада ("
