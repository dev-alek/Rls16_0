     1325         ASSIGN
     1326           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1327           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1328           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1329           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1330           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1331           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1332                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1333           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1334                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1335           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1336           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1337           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1338         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1339         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1340         if transport-base-loc = ? then transport-base-loc = 0.
     1341         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1342         if other-base-loc     = ? then other-base-loc     = 0.
     1343         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1344         assign
     1345           transport-cli-loc      = 0
     1346           other-cli-loc          = 0
     1347           road-tax-cli-loc       = ?
     1348           vat-cli-loc            = ?
     1349           slt-cli-loc            = ?
     1350           price-cli-with-tax-loc = ?.
     1351      end.
     1352   ASSIGN
     1353             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1354       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1355   .
     1356             assign
     1357               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1358               v-vat-pc              = vat-pc-loc
     1359               v-slt-pc              = slt-pc-loc
     1360               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1361               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1362               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1363               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1364               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1365               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1366               v-road-tax-base       =  0
     1367               v-road-tax-rubl       =  0
     1368               v-excise-base         =  0
     1369               v-excise-rubl         =  0
     1370               v-transport-base      =  0
     1371               v-transport-rubl      =  0
     1372               v-other-base          =  0
     1373               v-other-rubl          =  0
     1374             .
     1375       end.
     1376     end.
     1377   end procedure.
     1378   procedure fbrrep-fill-qnty-and-prices :
     1379   do
     1380   on error undo, return error
     1381   :
     1382   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1383       define variable v-gds-code  as integer       no-undo.
     1384       define variable v-gds-name  as character     no-undo.
     1385       define variable v-sign      as decimal       no-undo.
     1386       define buffer buf_fbr-line          for ub.fbr-line.
     1387       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1388       for each buf_fbr-line no-lock
     1389          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1390       on error undo, return error
     1391       :
     1392           find first buf_temp_fbrrep-goods
     1393                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1394                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1395                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1396           use-index ar
     1397           no-error.
     1398           if not available buf_temp_fbrrep-goods
     1399           then do:
     1400               create buf_temp_fbrrep-goods.
     1401   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1403     (input  buf_fbr-line.artic
     1404     ,input  buf_fbr-line.prod-type
     1405     ,input  buf_fbr-line.prod-code
     1406     ,output v-gds-code
     1407     )  .
     1408   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1410     (input  buf_fbr-line.artic
     1411     ,input  buf_fbr-line.prod-type
     1412     ,input  buf_fbr-line.prod-code
     1413     ,output v-gds-name
     1414     )  .
     1415   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1417     (input  buf_fbr-line.artic
     1418     ,input  buf_fbr-line.prod-type
     1419     ,input  buf_fbr-line.prod-code
     1420     ,input  'gds-goods=request':u
     1421     ,output buf_temp_fbrrep-goods.is-not-office
     1422     )  .
     1423               assign
     1424                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     1425                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     1426                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     1427                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     1428                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     1429                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     1430                   buf_temp_fbrrep-goods.fact-qnty            = 0
     1431                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1432                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     1433                   buf_temp_fbrrep-goods.income-qnty          = 0
     1434                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1435                   buf_temp_fbrrep-goods.cost-rubl            = 0
     1436                   buf_temp_fbrrep-goods.cost-base            = 0
     1437                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1438                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     1439                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1440                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     1441                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1442                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1443                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     1444                   buf_temp_fbrrep-goods.deleted              = no
     1445               .
     1446   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1448     (input  v-gds-code
     1449     ,output buf_temp_fbrrep-goods.unit-base
     1450     )  .
     1451           end.
     1452           case buf_fbr-line.trn-type
     1453           :
     1454               when 'при':U
     1455               then do:
     1456                   assign
     1457                       v-sign                                  = 1
     1458                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     1459                   .
     1460                   if buf_fbr-line.rsrv-qnty <> ?
     1461                   then do:
     1462                       assign
     1463                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1464                       .
     1465                   end.
     1466               end.
     1467               when 'спи':U
     1468               then do:
     1469                   assign
     1470                       v-sign                                  = -1
     1471                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     1472                   .
     1473                   if buf_fbr-line.rsrv-qnty <> ?
     1474                   then do:
     1475                       assign
     1476                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1477                       .
     1478                   end.
     1479               end.
     1480           end case.
     1481           assign
     1482               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     1483               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     1484               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     1485               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     1486           .
     1487       end.
     1488       run test-temp-tables in this-procedure .
     1489   end.
     1490   end procedure.
     1491   procedure fbrrep-fill-for-fbr-actp :
     1492   do
     1493   on error undo, return error
     1494   :
     1495   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1496       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1497       define buffer buf_fbr-line          for ub.fbr-line.
     1498       run fbrrep-fill-qnty-and-prices in this-procedure (
     1499           input p-fbr-doc-doc-code
     1500       ).
     1501       for each buf_temp_fbrrep-goods
     1502       :
     1503           assign
     1504               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1505               buf_temp_fbrrep-goods.sum-cost-base     = 0
     1506               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1507               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1508               buf_temp_fbrrep-goods.cost-rubl     = 0
     1509               buf_temp_fbrrep-goods.cost-base     = 0
     1510               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1511               buf_temp_fbrrep-goods.vat-cost-base = 0
     1512           .
     1513           if buf_temp_fbrrep-goods.income-qnty = 0
     1514           or buf_temp_fbrrep-goods.write-off-qnty = 0
     1515           then do:
     1516               assign
     1517                   buf_temp_fbrrep-goods.deleted   = yes
     1518                   buf_temp_fbrrep-goods.fact-qnty = 0
     1519               .
     1520           end.
     1521           else do:
     1522               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     1523               then do:
     1524                   assign
     1525                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1526                   .
     1527                   for each buf_fbr-line no-lock
     1528                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1529                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1530                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1531                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1532                        and buf_fbr-line.trn-type  = 'при':U
     1533                   :
     1534                       assign
     1535                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1536                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1537                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1538                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1539                       .
     1540                   end.
     1541                   assign
     1542                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1543                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1544                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1545                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1546                   .
     1547               end.
     1548               else do:
     1549                   assign
     1550                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1551                   .
     1552                   for each buf_fbr-line no-lock
     1553                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1554                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1555                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1556                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1557                        and buf_fbr-line.trn-type  = 'спи':U
     1558                   :
     1559                       assign
     1560                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1561                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1562                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1563                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1564                       .
     1565                   end.
     1566                   assign
     1567                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1568                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1569                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1570                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1571                   .
     1572               end.
     1573           end.
     1574       end.
     1575       for each buf_temp_fbrrep-goods
     1576          where buf_temp_fbrrep-goods.deleted = yes
     1577       on error undo, return error
     1578       :
     1579           delete buf_temp_fbrrep-goods.
     1580       end.
     1581       run test-temp-tables in this-procedure .
     1582   end.
     1583   end procedure.
     1584   procedure fbrrep-fill-for-op-del :
     1585   do
     1586   on error undo, return error
     1587   :
     1588   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1589   define input parameter p-db-remote          as logical          no-undo.
     1590       define variable v-serv-code as character    no-undo.
     1591       define variable v-in-code   as character    no-undo.
     1592       define variable v-out-code  as character    no-undo.
     1593       define variable v-trn-qnty  as decimal       no-undo.
     1594       define variable v-sign      as decimal       no-undo.
     1595       define variable v-qnty      as decimal       no-undo.
     1596       define buffer buf_fbr-doc           for ub.fbr-doc.
     1597       define buffer buf_fbr-line          for ub.fbr-line.
     1598       define buffer buf_goods             for ub.goods .
     1599       define buffer buf_doc-line          for ub.doc-line .
     1600       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     1601       run fbrrep-fill-qnty-and-prices in this-procedure (
     1602           input p-fbr-doc-doc-code
     1603       ).
     1604       for each buf_temp_fbrrep-goods
     1605       on error undo, return error
     1606       :
     1607           if buf_temp_fbrrep-goods.income-qnty <> 0
     1608           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     1609           then do:
     1610               assign
     1611                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     1612               .
     1613               if v-qnty = 0
     1614               then do:
     1615                   find first buf_fbr-line no-lock
     1616                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1617                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     1618                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     1619                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     1620                          and buf_fbr-line.fact-qnty   <> 0
     1621                   no-error.
     1622                   if available buf_fbr-line
     1623                   then do:
     1624                       assign
     1625                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     1626                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     1627                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     1628                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     1629                       .
     1630                   end.
     1631                   else do:
     1632                       assign
     1633                           buf_temp_fbrrep-goods.cost-rubl     = 0
     1634                           buf_temp_fbrrep-goods.cost-base     = 0
     1635                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1636                           buf_temp_fbrrep-goods.vat-cost-base = 0
     1637                       .
     1638                   end.
     1639               end.
     1640               else do:
     1641                   assign
     1642                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     1643                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     1644                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     1645                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     1646                   .
     1647               end.
     1648           end.
     1649           else do:
     1650               assign
     1651                   buf_temp_fbrrep-goods.cost-rubl     = 0
     1652                   buf_temp_fbrrep-goods.cost-base     = 0
     1653                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1654                   buf_temp_fbrrep-goods.vat-cost-base = 0
     1655               .
     1656           end.
     1657       end.
     1658       for each buf_temp_fbrrep-goods
     1659       :
     1660           if buf_temp_fbrrep-goods.is-waste = yes
     1661           then do:
     1662               assign
     1663                   buf_temp_fbrrep-goods.deleted = yes
     1664               .
     1665           end.
     1666           else do:
     1667               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     1668               and buf_temp_fbrrep-goods.income-qnty <> 0
     1669               then do:
     1670                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     1671                   then do:
     1672                       assign
     1673                           buf_temp_fbrrep-goods.deleted = yes
     1674                       .
     1675                   end.
     1676                   else do:
     1677                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     1678                       then do:
     1679                           assign
     1680                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     1681                               buf_temp_fbrrep-goods.income-qnty       = 0
     1682                           .
     1683                       end.
     1684                       else do:
     1685                           assign
     1686                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     1687                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     1688                           .
     1689                       end.
     1690                   end.
     1691               end.
     1692           end.
     1693       end.
     1694       for each buf_temp_fbrrep-goods
     1695          where buf_temp_fbrrep-goods.deleted = yes
     1696       on error undo, return error
     1697       :
     1698           delete buf_temp_fbrrep-goods.
     1699       end.
     1700       run test-temp-tables in this-procedure .
     1701       find first buf_fbr-doc no-lock
     1702            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     1703       .
     1704       assign
     1705           v-out-code = p-fbr-doc-doc-code
     1706       .
     1707       run doc-code in this-procedure (
     1708             input  "pair"
     1709           , input  buf_fbr-doc.obj-type
     1710           , input  buf_fbr-doc.obj-code
     1711           , input  v-out-code
     1712           , output v-in-code
     1713       ) no-error.
     1714       if error-status:error
     1715       then do:
     1716           message
     1717                    vss-workfile vss-revision vss-description
     1718               skip "Ошибка вычисления номера приходной накладной."
     1719               skip return-value
     1720               skip trim(error-status :get-message(1))
     1721                    trim(error-status :get-message(2))
     1722                    trim(error-status :get-message(3))
     1723           view-as alert-box error.
     1724           undo, return error .
     1725       end.
     1726       run doc-code in this-procedure (
     1727             input  "trio"
     1728           , input  buf_fbr-doc.obj-type
     1729           , input  buf_fbr-doc.obj-code
     1730           , input  v-in-code
     1731           , output v-serv-code
     1732       ) no-error.
     1733       if error-status:error
     1734       then do:
     1735           message
     1736                    vss-workfile vss-revision vss-description
     1737               skip "Ошибка вычисления номера накладной расхода."
     1738               skip return-value
     1739               skip trim(error-status :get-message(1))
     1740                    trim(error-status :get-message(2))
     1741                    trim(error-status :get-message(3))
     1742           view-as alert-box error.
     1743           undo, return error .
     1744       end.
     1745       for each buf_temp_fbrrep-goods
     1746       on error undo, return error
     1747       :
     1748           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     1749           then do:
     1750               find first buf_doc-line no-lock
     1751                    where buf_doc-line.doc-code  = v-in-code
     1752                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1753                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1754                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1755               no-error.
     1756               if available buf_doc-line
     1757               then do:
     1758                   assign
     1759                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     1760                   .
     1761               end.
     1762               else do:
     1763                   assign
     1764                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1765                   .
     1766               end.
     1767           end.
     1768           else do:
     1769               if buf_temp_fbrrep-goods.is-not-office = no
     1770               then do:
     1771                   find first buf_doc-line no-lock
     1772                        where buf_doc-line.doc-code  = v-serv-code
     1773                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1774                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1775                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1776                   no-error.
     1777               end.
     1778               else do:
     1779                   find first buf_doc-line no-lock
     1780                        where buf_doc-line.doc-code  = v-out-code
     1781                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1782                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1783                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1784                   no-error.
     1785               end.
     1786               if available buf_doc-line
     1787               then do:
     1788                   assign
     1789                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     1790                   .
     1791               end.
     1792               else do:
     1793                   assign
     1794                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1795                   .
     1796               end.
     1797           end.
     1798           if available buf_doc-line
     1799           then do:
     1800               define variable v-void              as decimal       no-undo.
     1801               define variable v-fact-qnty         as decimal       no-undo.
     1802               define variable v-sum-base          as decimal       no-undo.
     1803               define variable v-sum-rubl          as decimal       no-undo.
     1804               define variable v-vat-base          as decimal       no-undo.
     1805               define variable v-vat-rubl          as decimal       no-undo.
     1806               define variable v-slt-base          as decimal       no-undo.
     1807               define variable v-slt-rubl          as decimal       no-undo.
     1808               define variable v-road-tax-base     as decimal       no-undo.
     1809               define variable v-road-tax-rubl     as decimal       no-undo.
     1810               define variable v-transport-base    as decimal       no-undo.
     1811               define variable v-transport-rubl    as decimal       no-undo.
     1812               define variable v-other-base        as decimal       no-undo.
     1813               define variable v-other-rubl        as decimal       no-undo.
     1814               define variable v-excise-base       as decimal       no-undo.
     1815               define variable v-excise-rubl       as decimal       no-undo.
     1816               run r-cost in this-procedure (
     1817                     input buf_doc-line.doc-code
     1818                   , input buf_doc-line.artic
     1819                   , input buf_doc-line.prod-type
     1820                   , input buf_doc-line.prod-code
     1821                   , output v-fact-qnty
     1822                   , output v-void
     1823                   , output v-void
     1824                   , output v-sum-base
     1825                   , output v-sum-rubl
     1826                   , output v-vat-base
     1827                   , output v-vat-rubl
     1828                   , output v-slt-base
     1829                   , output v-slt-rubl
     1830                   , output v-road-tax-base
     1831                   , output v-road-tax-rubl
     1832                   , output v-transport-base
     1833                   , output v-transport-rubl
     1834                   , output v-other-base
     1835                   , output v-other-rubl
     1836                   , output v-excise-base
     1837                   , output v-excise-rubl
     1838               ).
     1839               assign
     1840                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     1841               .
     1842               assign
     1843                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     1844                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     1845                   v-sum-rubl = v-sum-rubl   * v-sign
     1846                   v-sum-base = v-sum-base   * v-sign
     1847                   v-vat-rubl = v-vat-rubl   * v-sign
     1848                   v-vat-base = v-vat-base   * v-sign
     1849                   v-fact-qnty = v-fact-qnty * v-sign
     1850               .
     1851               output to "fbrrep.txt" append .
     1852               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     1853               output close.
     1854               assign
     1855                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     1856                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     1857                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     1858                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     1859               .
     1860               if buf_temp_fbrrep-goods.fact-qnty          = 0
     1861               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1862               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     1863               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1864               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1865               then do:
     1866                   assign
     1867                       buf_temp_fbrrep-goods.deleted = yes
     1868                   .
     1869               end.
     1870           end.
     1871       end.
     1872       for each buf_temp_fbrrep-goods
     1873          where buf_temp_fbrrep-goods.deleted = yes
     1874       on error undo, return error
     1875       :
     1876           delete buf_temp_fbrrep-goods.
     1877       end.
     1878       run test-temp-tables in this-procedure .
     1879   end.
     1880   end procedure.
     1881   procedure test-temp-tables :
     1882   do
     1883   on error undo, return error
     1884   :
     1885       define variable v-str   as character     no-undo.
     1886       assign
     1887           v-str = ""
     1888       .
     1889       for each temp_fbrrep-goods
     1890       :
     1891           assign
     1892               v-str = v-str
     1893                   + chr(10) + temp_fbrrep-goods.artic
     1894                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     1895                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     1896                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     1897                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     1898                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     1899                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     1900                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     1901           .
     1902       end.
     1903       output to "fbrrep.txt" append .
     1904       put unformatted skip(2) v-str.
     1905       output close.
     1906   end.
     1907   end procedure.
     1908   procedure fbrrep-test-fbrdoc-for-fact :
     1909   do
     1910   on error undo, return error
     1911   :
     1912   define output parameter p-have-error        as logical      no-undo.
     1913       define buffer buf_fbr-line          for ub.fbr-line.
     1914       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1915       for each buf_temp_fbrrep-goods
     1916       on error undo, return error
     1917       :
     1918       end.
     1919   end.
     1920   end procedure.
     1921   procedure fbrrep-fill-qnty-and-prices-gds :
     1922   do
     1923   on error undo, return error
     1924   :
     1925   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1926   define input parameter p-gds-code           as integer      no-undo.
     1927       define variable v-sign      as decimal       no-undo.
     1928       define buffer buf_fbr-line          for ub.fbr-line.
     1929       define buffer buf_goods             for ub.goods.
     1930       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1931       find first buf_goods no-lock
     1932            where buf_goods.gds-code = p-gds-code
     1933       .
     1934       find first buf_temp_fbrrep-goods
     1935            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     1936              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     1937              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     1938       use-index ar
     1939       no-error.
     1940       if available buf_temp_fbrrep-goods
     1941       then do:
     1942           delete buf_temp_fbrrep-goods.
     1943       end.
     1944       create buf_temp_fbrrep-goods.
     1945   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1947     (input  buf_goods.artic
     1948     ,input  buf_goods.prod-type
     1949     ,input  buf_goods.prod-code
     1950     ,input  'gds-goods=request':u
     1951     ,output buf_temp_fbrrep-goods.is-not-office
     1952     )  .
     1953       assign
     1954           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     1955           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     1956           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     1957           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     1958           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     1959           buf_temp_fbrrep-goods.is-waste             = no
     1960           buf_temp_fbrrep-goods.fact-qnty            = 0
     1961           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1962           buf_temp_fbrrep-goods.write-off-qnty       = 0
     1963           buf_temp_fbrrep-goods.income-qnty          = 0
     1964           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1965           buf_temp_fbrrep-goods.cost-rubl            = 0
     1966           buf_temp_fbrrep-goods.cost-base            = 0
     1967           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1968           buf_temp_fbrrep-goods.sum-cost-base        = 0
     1969           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1970           buf_temp_fbrrep-goods.vat-cost-base        = 0
     1971           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1972           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1973           buf_temp_fbrrep-goods.price-sale           = 0
     1974           buf_temp_fbrrep-goods.deleted              = no
     1975       .
     1976   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1978     (input  p-gds-code
     1979     ,output buf_temp_fbrrep-goods.unit-base
     1980     )  .
     1981       for each buf_fbr-line no-lock
     1982          where buf_fbr-line.prod-type = buf_goods.prod-type
     1983            and buf_fbr-line.prod-code = buf_goods.prod-code
     1984            and buf_fbr-line.artic     = buf_goods.artic
     1985            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1986       on error undo, return error
     1987       :
     1988           case buf_fbr-line.trn-type
     1989           :
     1990               when 'при':U
     1991               then do:
     1992                   assign
     1993                       v-sign                                          = 1
     1994                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     1995                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     1996                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     1997                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     1998                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     1999                   .
     2000                   if buf_fbr-line.rsrv-qnty <> ?
     2001                   then do:
     2002                       assign
     2003                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2004                       .
     2005                   end.
     2006               end.
     2007               when 'спи':U
     2008               then do:
     2009                   assign
     2010                       v-sign                                  = -1
     2011                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     2012                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     2013                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     2014                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     2015                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     2016                   .
