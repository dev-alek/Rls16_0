        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo.
        4   define input parameter p-fbr-doc-code   as character        no-undo.
        5   define input parameter p-store-rest     as logical          no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: fbrstore.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: str/fbrstore.p $":U .
       11   define variable vss-description as character no-undo initial "Создание документа внутреннего перемещения для ингредиентов со склада на кухню ресторана":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       78   procedure partslib-clear-temp-parts :
       79     define buffer buf_temp-parts for temp-parts .
       80     do
       81     on error undo, return error
       82     :
       83       for each buf_temp-parts
       84       on error undo, return error
       85       :
       86         delete buf_temp-parts .
       87       end.
       88     end.
       89   end procedure.
       90   procedure partslib-create-temp-parts :
       91     define parameter buffer buf_parts       for ub.parts .
       92     define parameter buffer buf_temp-parts  for temp-parts .
       93     define input  parameter p-goods-twounit as logical   no-undo .
       94     define variable v-base-part-code as character no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       if p-goods-twounit = true
       99       then do:
      100         assign
      101           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      102         .
      103       end.
      104       else do:
      105         assign
      106           v-base-part-code = buf_parts.part-code
      107         .
      108       end.
      109       find first buf_temp-parts exclusive-lock
      110         where buf_temp-parts.obj-type  = buf_parts.obj-type
      111           and buf_temp-parts.obj-code  = buf_parts.obj-code
      112           and buf_temp-parts.artic     = buf_parts.artic
      113           and buf_temp-parts.prod-type = buf_parts.prod-type
      114           and buf_temp-parts.prod-code = buf_parts.prod-code
      115           and buf_temp-parts.in-code   = buf_parts.in-code
      116           and buf_temp-parts.out-code  = 'free-zone':U
      117           and buf_temp-parts.part-code = v-base-part-code
      118         no-error.
      119       if not available buf_temp-parts
      120       then do:
      121         create buf_temp-parts .
      122         buffer-copy buf_parts to buf_temp-parts
      123         assign
      124           buf_temp-parts.out-code  = 'free-zone':U
      125           buf_temp-parts.part-code = v-base-part-code
      126           buf_temp-parts.rsrv-free = yes
      127           buf_temp-parts.status_   = no
      128           buf_temp-parts.qnty      = 0
      129           buf_temp-parts.fact-qnty = 0
      130           buf_temp-parts.real-qnty = 0
      131           buf_temp-parts.cli-qnty  = 0
      132         .
      133       end.
      134     end.
      135   end procedure.
      136   procedure partslib-init-temp-parts :
      137     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      138     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      139     define input parameter p-artic           like ub.parts.artic     no-undo .
      140     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      141     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      142     define buffer buf_parts      for ub.parts .
      143     define buffer buf_temp-parts for temp-parts .
      144     define variable v-goods-twounit    as logical   no-undo .
      145     do
      146     on error undo, return error
      147     :
      148   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      150     (input  p-artic
      151     ,input  p-prod-type
      152     ,input  p-prod-code
      153     ,input  'twounit=request':u
      154     ,output v-goods-twounit
      155     ) no-error .
      156       if error-status :error
      157       then do:
      158         message
      159           vss-workfile vss-revision vss-description skip
      160           vss-include-info0 skip
      161           "Ошибка при определении атрибута товара" skip
      162           "Артикул" p-artic p-prod-type p-prod-code skip
      163           "twounit=request" skip
      164           error-status :get-message(1) skip
      165           return-value skip
      166           view-as alert-box error .
      167         undo, return error return-value .
      168       end.
      169       run partslib-clear-temp-parts in this-procedure .
      170       for each buf_parts
      171         where buf_parts.obj-type  = p-obj-type
      172           and buf_parts.obj-code  = p-obj-code
      173           and buf_parts.artic     = p-artic
      174           and buf_parts.prod-type = p-prod-type
      175           and buf_parts.prod-code = p-prod-code
      176           and buf_parts.rsrv-free = yes
      177           and buf_parts.status_   = no
      178           and buf_parts.in-code   <> buf_parts.out-code
      179       on error undo, return error
      180       :
      181         run partslib-create-temp-parts in this-procedure
      182           (buffer buf_parts
      183           ,buffer buf_temp-parts
      184           ,input  v-goods-twounit
      185           ) .
      186         define variable v-parts-qnty          as decimal   no-undo .
      187         define variable v-parts-cli-qnty      as decimal   no-undo .
      188         define variable v-parts-free-qnty     as decimal   no-undo .
      189         define variable v-parts-free-cli-qnty as decimal   no-undo .
      190         if buf_parts.out-code = 'free-zone':U
      191         then do:
      192           assign
      193             v-parts-qnty          = buf_parts.qnty
      194             v-parts-cli-qnty      = buf_parts.cli-qnty
      195             v-parts-free-qnty     = buf_parts.qnty
      196             v-parts-free-cli-qnty = buf_parts.cli-qnty
      197           .
      198         end.
      199         else do:
      200           assign
      201             v-parts-qnty          = abs(buf_parts.qnty)
      202             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      203             v-parts-free-qnty     = 0
      204             v-parts-free-cli-qnty = 0
      205           .
      206         end.
      207         assign
      208           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      209           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      210           buf_temp-parts.real-qnty     = 0
      211           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      212           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      213           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      214         .
      215       end.
      216     end.
      217   end procedure.
      218   procedure partslib-init-temp-parts-by-factord :
      219     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      220     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      221     define input parameter p-artic              like ub.parts.artic     no-undo .
      222     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      223     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      224     define input parameter p-fact-order         as decimal   no-undo .
      225     define input parameter p-include-fact-order as logical   no-undo .
      226     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      227     define buffer buf_gds-obj  for ub.gds-obj .
      228     do
      229     on error undo, return error
      230     :
      231       do transaction
      232       on error undo, return error
      233       :
      234   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      236     (input  p-obj-type
      237     ,input  p-obj-code
      238     ,input  p-artic
      239     ,input  p-prod-type
      240     ,input  p-prod-code
      241     ,buffer buf_gds-obj
      242     ) no-error .
      243         if error-status :error
      244         then do:
      245           message
      246             vss-workfile vss-revision vss-description skip
      247             vss-include-info0 skip
      248             "Невозможно найти товар на объекте" skip
      249             "Объект" p-obj-type p-obj-code skip
      250             "Артикул" p-artic p-prod-type p-prod-code skip
      251             error-status :get-message(1) skip
      252             return-value skip
      253             view-as alert-box error .
      254           undo, return error .
      255         end.
      256         find current buf_gds-obj exclusive-lock .
      257       end.
      258       run partslib-init-temp-parts in this-procedure
      259         (input p-obj-type
      260         ,input p-obj-code
      261         ,input p-artic
      262         ,input p-prod-type
      263         ,input p-prod-code
      264         ) no-error .
      265       if error-status :error
      266       then do:
      267         message
      268           vss-workfile vss-revision vss-description skip
      269           vss-include-info0 skip
      270           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      271           "Объект" p-obj-type p-obj-code skip
      272           "Артикул" p-artic p-prod-type p-prod-code skip
      273           "p-fact-order" p-fact-order skip
      274           view-as alert-box error .
      275         undo, return error .
      276       end.
      277       if p-include-fact-order = true
      278       then do:
      279         assign
      280           p-fact-order = p-fact-order - 0.0000000001
      281         .
      282       end.
      283       define variable v-max-fact-order as character no-undo .
      284       run factord-max-fact-order in this-procedure
      285         (output v-max-fact-order
      286         ) no-error .
      287       if error-status :error
      288       then do:
      289         message
      290           vss-workfile vss-revision vss-description skip
      291           vss-include-info0 skip
      292           "Ошибка при вызове процедуры factord-max-fact-order" skip
      293           "Объект" p-obj-type p-obj-code skip
      294           "Артикул" p-artic p-prod-type p-prod-code skip
      295           "p-fact-order" p-fact-order skip
      296           view-as alert-box error .
      297         undo, return error .
      298       end.
      299       run partslib-update-by-factord in this-procedure
      300         (input p-obj-type
      301         ,input p-obj-code
      302         ,input p-artic
      303         ,input p-prod-type
      304         ,input p-prod-code
      305         ,input p-fact-order
      306         ,input v-max-fact-order
      307         ,input false
      308         ) no-error .
      309       if error-status :error
      310       then do:
      311         message
      312           vss-workfile vss-revision vss-description skip
      313           vss-include-info0 skip
      314           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      315           "Объект" p-obj-type p-obj-code skip
      316           "Артикул" p-artic p-prod-type p-prod-code skip
      317           "p-fact-order" p-fact-order skip
      318           "v-max-fact-order" v-max-fact-order skip
      319           view-as alert-box error .
      320         undo, return error .
      321       end.
      322     end.
      323   end procedure.
      324   procedure partslib-update-by-factord :
      325     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      326     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      327     define input parameter p-artic              like ub.parts.artic     no-undo .
      328     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      329     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      330     define input parameter p-start-fact-order   as decimal   no-undo .
      331     define input parameter p-end-fact-order     as decimal   no-undo .
      332     define input parameter p-lock-gds-obj       as logical   no-undo .
      333     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      334     define buffer buf_gds-obj  for ub.gds-obj .
      335     define buffer buf_doc-line for ub.doc-line .
      336     define variable v-total-parts-qnty as decimal   no-undo .
      337     define variable v-goods-gds-goods  as logical   no-undo .
      338     define variable v-goods-twounit    as logical   no-undo .
      339     do
      340     on error undo, return error
      341     :
      342       if p-start-fact-order > p-end-fact-order
      343       then do:
      344         message
      345           vss-workfile vss-revision vss-description skip
      346           vss-include-info0 skip
      347           "Ошибка задания входных параметров" skip
      348           "Начало интервала превышает конец интервала" skip
      349           "Объект" p-obj-type p-obj-code skip
      350           "Артикул" p-artic p-prod-type p-prod-code skip
      351           "p-start-fact-order" p-start-fact-order skip
      352           "p-end-fact-order"   p-end-fact-order skip
      353           view-as alert-box error .
      354         undo, return error .
      355       end.
      356       if p-lock-gds-obj = true
      357       then do:
      358         do transaction
      359         on error undo, return error
      360         :
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      363     (input  p-obj-type
      364     ,input  p-obj-code
      365     ,input  p-artic
      366     ,input  p-prod-type
      367     ,input  p-prod-code
      368     ,buffer buf_gds-obj
      369     ) no-error .
      370           if error-status :error
      371           then do:
      372             message
      373               vss-workfile vss-revision vss-description skip
      374               vss-include-info0 skip
      375               "Невозможно найти gds-obj" skip
      376               error-status :get-message(1) skip
      377               return-value skip
      378               view-as alert-box error .
      379             undo, return error .
      380           end.
      381           find current buf_gds-obj exclusive-lock .
      382         end.
      383       end.
      384   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      386     (input  p-artic
      387     ,input  p-prod-type
      388     ,input  p-prod-code
      389     ,input  'gds-goods=request':u
      390     ,output v-goods-gds-goods
      391     ) no-error .
      392       if error-status :error
      393       then do:
      394         message
      395           vss-workfile vss-revision vss-description skip
      396           vss-include-info0 skip
      397           "Ошибка при определении атрибута товара" skip
      398           "Артикул" p-artic p-prod-type p-prod-code skip
      399           "gds-goods=request" skip
      400           error-status :get-message(1) skip
      401           return-value skip
      402           view-as alert-box error .
      403         undo, return error return-value .
      404       end.
      405   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      407     (input  p-artic
      408     ,input  p-prod-type
      409     ,input  p-prod-code
      410     ,input  'twounit=request':u
      411     ,output v-goods-twounit
      412     ) no-error .
      413       if error-status :error
      414       then do:
      415         message
      416           vss-workfile vss-revision vss-description skip
      417           vss-include-info0 skip
      418           "Ошибка при определении атрибута товара" skip
      419           "Артикул" p-artic p-prod-type p-prod-code skip
      420           "twounit=request" skip
      421           error-status :get-message(1) skip
      422           return-value skip
      423           view-as alert-box error .
      424         undo, return error return-value .
      425       end.
      426       for each buf_doc-line no-lock
      427         where buf_doc-line.obj-type   = p-obj-type
      428           and buf_doc-line.obj-code   = p-obj-code
      429           and buf_doc-line.artic      = p-artic
      430           and buf_doc-line.prod-type  = p-prod-type
      431           and buf_doc-line.prod-code  = p-prod-code
      432           and buf_doc-line.status_    = 'факт':U
      433           and buf_doc-line.fact-order > p-start-fact-order
      434           and buf_doc-line.fact-order <= p-end-fact-order
      435       on error undo, return error
      436       :
      437         run partslib-process-document in this-procedure
      438           (input  buf_doc-line.doc-code
      439           ,input  p-obj-type
      440           ,input  p-obj-code
      441           ,input  p-artic
      442           ,input  p-prod-type
      443           ,input  p-prod-code
      444           ,input  v-goods-gds-goods
      445           ,input  v-goods-twounit
      446           ,output v-total-parts-qnty
      447           ) no-error .
      448         if error-status :error
      449         then do:
      450           message
      451             vss-workfile vss-revision vss-description skip
      452             vss-include-info0 skip
      453             "Ошибка при вызове процедуры partslib-process-document" skip
      454             "Документ" buf_doc-line.doc-code skip
      455             "Объект" p-obj-type p-obj-code skip
      456             "Артикул" p-artic p-prod-type p-prod-code skip
      457             "p-start-fact-order" p-start-fact-order skip
      458             "p-end-fact-order" p-end-fact-order skip
      459             error-status :get-message(1) skip
      460             return-value skip
      461             view-as alert-box error .
      462           undo, return error return-value .
      463         end.
      464       end.
      465     end.
      466   end procedure.
      467   procedure partslib-process-document :
      468     define input  parameter p-doc-code         as character no-undo .
      469     define input  parameter p-obj-type         as character no-undo .
      470     define input  parameter p-obj-code         as integer   no-undo .
      471     define input  parameter p-artic            as character no-undo .
      472     define input  parameter p-prod-type        as character no-undo .
      473     define input  parameter p-prod-code        as integer   no-undo .
      474     define input  parameter p-goods-gds-goods  as logical   no-undo .
      475     define input  parameter p-goods-twounit    as logical   no-undo .
      476     define output parameter p-total-parts-qnty as decimal   no-undo .
      477     define variable v-parts-sign as integer   no-undo .
      478     define buffer buf_trn-doc    for ub.trn-doc .
      479     define buffer buf_doc-line   for ub.doc-line .
      480     define buffer buf_parts      for ub.parts .
      481     define buffer buf_temp-parts for temp-parts .
      482     do
      483     on error undo, return error return-value
      484     :
      485       find first buf_trn-doc no-lock
      486         where buf_trn-doc.doc-code = p-doc-code
      487         no-error .
      488       if not available buf_trn-doc
      489       then do:
      490         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      491                                      ,p-doc-code
      492                                      ) .
      493       end.
      494       case buf_trn-doc.doc-type
      495       :
      496         when 'при':U or
      497         when 'возврат':U or
      498         when 'инв':U
      499         then do:
      500           assign
      501             v-parts-sign = -1
      502           .
      503         end.
      504         when 'рас':U or
      505         when 'спи':U
      506         then do:
      507           assign
      508             v-parts-sign = 1
      509           .
      510         end.
      511         otherwise do:
      512           undo, return error substitute("Неизвестный тип документа &1"
      513                                       ,buf_trn-doc.doc-type
      514                                       ) .
      515         end.
      516       end.
      517       find first buf_doc-line no-lock
      518         where buf_doc-line.doc-code  = p-doc-code
      519           and buf_doc-line.artic     = p-artic
      520           and buf_doc-line.prod-type = p-prod-type
      521           and buf_doc-line.prod-code = p-prod-code
      522         no-error .
      523       if not available buf_doc-line
      524       then do:
      525         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      526                                      ,p-doc-code
      527                                      ,artic
      528                                      ,prod-type
      529                                      ,prod-code
      530                                      ) .
      531       end.
      532       assign
      533         p-total-parts-qnty = 0
      534       .
      535       if p-goods-gds-goods = true
      536       then do:
      537         for each buf_parts no-lock
      538           where buf_parts.out-code  = p-doc-code
      539             and buf_parts.obj-type  = p-obj-type
      540             and buf_parts.obj-code  = p-obj-code
      541             and buf_parts.artic     = p-artic
      542             and buf_parts.prod-type = p-prod-type
      543             and buf_parts.prod-code = p-prod-code
      544         on error undo, return error
      545         :
      546           run partslib-create-temp-parts in this-procedure
      547             (buffer buf_parts
      548             ,buffer buf_temp-parts
      549             ,input  p-goods-twounit
      550             ) .
      551           assign
      552             p-total-parts-qnty        = p-total-parts-qnty
      553                                       + v-parts-sign * buf_parts.fact-qnty
      554             buf_temp-parts.qnty       = buf_temp-parts.qnty
      555                                       + v-parts-sign * buf_parts.fact-qnty
      556             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      557                                       + v-parts-sign * buf_parts.fact-qnty
      558             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      559                                       + v-parts-sign * buf_parts.cli-qnty
      560           .
      561           if buf_temp-parts.qnty = 0
      562           then do:
      563             delete buf_temp-parts .
      564           end.
      565         end.
      566       end.
      567       else do:
      568         assign
      569           p-total-parts-qnty = p-total-parts-qnty
      570                              + v-parts-sign * buf_doc-line.fact-qnty
      571         .
      572       end.
      573     end.
      574   end procedure.
      575   procedure partslib-init-temp-parts-by-date :
      576     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      577     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      578     define input parameter p-artic           like ub.parts.artic     no-undo .
      579     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      580     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      581     define input parameter p-fact-date       as date      no-undo .
      582     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      583     do
      584     on error undo, return error
      585     :
      586       define variable v-fact-order                as decimal   no-undo .
      587       define variable v-shift-end-fact-order      as decimal   no-undo .
      588       define variable v-day-end-fact-order        as decimal   no-undo .
      589       run factord in this-procedure
      590         (input  p-fact-date
      591         ,input  1
      592         ,input  1
      593         ,input  ?
      594         ,input  0
      595         ,input  false
      596         ,output v-fact-order
      597         ,output v-shift-end-fact-order
      598         ,output v-day-end-fact-order
      599         ) no-error .
      600       if error-status :error
      601       then do:
      602         message
      603           vss-workfile vss-revision vss-description skip
      604           vss-include-info0 skip
      605           "Ошибка при определении момента времени, на который требуется остаток" skip
      606           "Объект" p-obj-type p-obj-code skip
      607           "Артикул" p-artic p-prod-type p-prod-code skip
      608           "Дата" p-fact-date skip
      609           view-as alert-box error .
      610         undo, return error .
      611       end.
      612       run partslib-init-temp-parts-by-factord in this-procedure
      613         (input p-obj-type
      614         ,input p-obj-code
      615         ,input p-artic
      616         ,input p-prod-type
      617         ,input p-prod-code
      618         ,input v-day-end-fact-order
      619         ,input false
      620         ) no-error .
      621       if error-status :error
      622       then do:
      623         message
      624           vss-workfile vss-revision vss-description skip
      625           vss-include-info0 skip
      626           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      627           "Объект" p-obj-type p-obj-code skip
      628           "Артикул" p-artic p-prod-type p-prod-code skip
      629           "Дата" p-fact-date skip
      630           view-as alert-box error .
      631         undo, return error .
      632       end.
      633     end.
      634   end procedure.
      635   procedure partslib-calc-cost :
      636     define output parameter p-fact-qnty      as decimal   no-undo .
      637     define output parameter p-vat-pc         as decimal   no-undo .
      638     define output parameter p-slt-pc         as decimal   no-undo .
      639     define output parameter p-sum-base       as decimal   no-undo .
      640     define output parameter p-sum-rubl       as decimal   no-undo .
      641     define output parameter p-vat-base       as decimal   no-undo .
      642     define output parameter p-vat-rubl       as decimal   no-undo .
      643     define output parameter p-slt-base       as decimal   no-undo .
      644     define output parameter p-slt-rubl       as decimal   no-undo .
      645     define output parameter p-road-tax-base  as decimal   no-undo .
      646     define output parameter p-road-tax-rubl  as decimal   no-undo .
      647     define output parameter p-transport-base as decimal   no-undo .
      648     define output parameter p-transport-rubl as decimal   no-undo .
      649     define output parameter p-other-base     as decimal   no-undo .
      650     define output parameter p-other-rubl     as decimal   no-undo .
      651     define output parameter p-excise-base    as decimal   no-undo .
      652     define output parameter p-excise-rubl    as decimal   no-undo .
      653     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      654     do
      655     on error undo, return error return-value
      656     :
      657       define buffer buf_temp-parts for temp-parts .
      658       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      659       define buffer   in-vatp-parts    for ub.parts   .
      660       define buffer   in-vatp-doc      for ub.trn-doc .
      661       define buffer   in-vatp-goods    for ub.goods   .
      662       define buffer   in-vatp-sysconf  for ub.sysconf .
      663       define buffer   in-vatp_doc-attr for ub.doc-attr.
      664       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      665       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      666       define variable varinvprb                  as   character              no-undo.
      667       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      668       define variable cli-base-rate              as   decimal                no-undo.
      669       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      670       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      671       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      672       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      673       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      674       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      675       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      676       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      677       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      678       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      679       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      680       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      681       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      682       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      683       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      684       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      685       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      686       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      687       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      688       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      689       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      690       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      691       define variable varinvatp-envd             as   character              no-undo.
      692       define variable varinvatp-type             as   character              no-undo.
      693       for each buf_temp-parts
      694       on error undo, return error
      695       :
      696   assign
      697     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      698     price-base-with-tax-loc = buf_temp-parts.price-base
      699   .
      700   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      702     (output varinvprb
      703     )  .
      704     if buf_temp-parts.out-code = 'free-zone':U     or
      705        buf_temp-parts.out-code = 'out-zone':U   or
      706        buf_temp-parts.doc-type = 'акт':U then do:
      707       assign
      708         in-vatp-have-vat-slt = yes.
      709     end.
      710     else do:
      711       find first in-vatp_doc-attr no-lock
      712         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      713           and in-vatp_doc-attr.attr-code = 'envd':U
      714         no-error .
      715       if not available in-vatp_doc-attr then do:
      716         assign
      717           in-vatp-have-vat-slt = yes.
      718       end.
      719       else do:
      720            in-vatp-have-vat-slt = no.
      721       end.
      722     end.
      723     assign
      724      price-cli-with-tax-loc = buf_temp-parts.price-cli
      725      cli-base-rate          = buf_temp-parts.cli-base-rate.
      726     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      727              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      728     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      729             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      730             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      731             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      732             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      733             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      734             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      735       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      736     assign
      737       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      738     assign
      739       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      740       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      741       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      742       transport-cli-loc  = 0
      743       other-cli-loc      = 0
      744     .
      745   ASSIGN
      746             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      747       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      748   .
      749         assign
      750           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      751           p-vat-pc         = p-vat-pc         + vat-pc-loc
      752           p-slt-pc         = p-slt-pc         + slt-pc-loc
      753           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      754           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      755           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      756           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      757           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      758           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      759           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      760           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      761           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      762           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      763           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      764           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      765           p-excise-base    = p-excise-base    + 0
      766           p-excise-rubl    = p-excise-rubl    + 0
      767         .
      768       end.
      769       if p-fact-qnty      = ?
      770       or p-sum-base       = ?
      771       or p-sum-rubl       = ?
      772       or p-vat-base       = ?
      773       or p-vat-rubl       = ?
      774       or p-slt-base       = ?
      775       or p-slt-rubl       = ?
      776       or p-road-tax-base  = ?
      777       or p-road-tax-rubl  = ?
      778       or p-transport-base = ?
      779       or p-transport-rubl = ?
      780       or p-other-base     = ?
      781       or p-other-rubl     = ?
      782       or p-excise-base    = ?
      783       or p-excise-rubl    = ?
      784       then do:
      785         message
      786           vss-workfile vss-revision vss-description skip
      787           vss-include-info0 skip
      788           "Программа in-vatp.i вернула неопределенные значения" skip
      789           "p-fact-qnty"      p-fact-qnty      skip
      790           "p-sum-base"       p-sum-base       skip
      791           "p-sum-rubl"       p-sum-rubl       skip
      792           "p-vat-base"       p-vat-base       skip
      793           "p-vat-rubl"       p-vat-rubl       skip
      794           "p-slt-base"       p-slt-base       skip
      795           "p-slt-rubl"       p-slt-rubl       skip
      796           "p-road-tax-base"  p-road-tax-base  skip
      797           "p-road-tax-rubl"  p-road-tax-rubl  skip
      798           "p-transport-base" p-transport-base skip
      799           "p-transport-rubl" p-transport-rubl skip
      800           "p-other-base"     p-other-base     skip
      801           "p-other-rubl"     p-other-rubl     skip
      802           "p-excise-base"    p-excise-base    skip
      803           "p-excise-rubl"    p-excise-rubl    skip
      804           view-as alert-box error .
      805         undo, return error .
      806       end.
      807     end.
      808   end procedure.
      809   procedure fbrrest-get-free-qnty :
      810   do
      811   on error undo, return error
      812   :
      813   define input parameter p-obj-type       as character            no-undo.
      814   define input parameter p-obj-code       as integer              no-undo.
      815   define input parameter p-gds-code       as integer              no-undo.
      816   define input parameter p-autofbr        as logical              no-undo.
      817   define output parameter p-avail-qnty    as decimal              no-undo.
      818       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
      819       define variable v-free-qnty as decimal       no-undo.
      820       define buffer buf_goods         for ub.goods.
      821       define buffer buf_gds-obj       for ub.gds-obj.
      822       define buffer buf_temp-parts    for temp-parts.
      823       find first buf_goods no-lock
      824            where buf_goods.gds-code = p-gds-code
      825       .
      826       assign
      827           p-avail-qnty = 0
      828       .
      829       run partslib-init-temp-parts in this-procedure (
      830             input p-obj-type
      831           , input p-obj-code
      832           , input buf_goods.artic
      833           , input buf_goods.prod-type
      834           , input buf_goods.prod-code
      835       ).
      836       assign
      837           v-free-qnty = 0
      838       .
      839       for each buf_temp-parts
      840       on error undo, return error
      841       :
      842           if buf_temp-parts.qnty > 0
      843           then do:
      844               assign
      845                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
      846               .
      847           end.
      848       end.
      849       assign
      850           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
      851       .
      852   end.
      853   end procedure.
      854   procedure fbrrest-get-catering-object :
      855   do
      856   on error undo, return error
      857   :
      858   define input parameter p-obj-code            as integer      no-undo.
      859   define output parameter p-catering-obj-type  as character    no-undo.
      860   define output parameter p-catering-obj-code  as integer      no-undo.
      861       define buffer buf_shop              for ub.shop.
      862       find first buf_shop no-lock
      863            where buf_shop.obj-code = p-obj-code
      864       .
      865       assign
      866           p-catering-obj-type = buf_shop.kitchen-store-type
      867           p-catering-obj-code = buf_shop.kitchen-store-code
      868       .
      869   end.
      870   end procedure.
      871   define variable vss-include-info7 as character format "X(65)" no-undo
      872   initial "@(#)$Workfile$ $Revision$".
      873   define temp-table temp_fbrrep-goods no-undo
      874       field gds-code                      as integer
      875       field artic                         as character
      876       field prod-type                     as character
      877       field prod-code                     as integer
      878       field gds-name                      as character
      879       field is-not-office                 as logical
      880       field is-waste                      as logical
      881       field unit-base                     as character
      882       field fact-qnty                     as decimal
      883       field write-off-qnty                as decimal
      884       field write-off-rsrv-qnty           as decimal
      885       field sum-write-off-rsrv-rubl       as decimal
      886       field sum-write-off-rsrv-base       as decimal
      887       field sum-write-off-rsrv-vat-rubl   as decimal
      888       field sum-write-off-rsrv-vat-base   as decimal
      889       field cost-rubl                     as decimal
      890       field cost-base                     as decimal
      891       field sum-cost-rubl                 as decimal
      892       field sum-cost-base                 as decimal
      893       field sum-vat-cost-rubl             as decimal
      894       field sum-vat-cost-base             as decimal
      895       field vat-cost-rubl                 as decimal
      896       field vat-cost-base                 as decimal
      897       field income-qnty                   as decimal
      898       field income-rsrv-qnty              as decimal
      899       field cost-income-rubl              as decimal
      900       field cost-income-base              as decimal
      901       field sum-cost-income-rubl          as decimal
      902       field sum-cost-income-base          as decimal
      903       field sum-vat-cost-income-rubl      as decimal
      904       field sum-vat-cost-income-base      as decimal
      905       field vat-cost-income-rubl          as decimal
      906       field vat-cost-income-base          as decimal
      907       field price-sale                    as decimal
      908       field deleted                       as logical
      909       index pi is primary unique gds-code
      910       index ar is unique artic prod-type prod-code
      911       index dd deleted
      912       index ws is-waste
      913   .
      914   define variable vss-include-info8 as character format "X(65)" no-undo
      915   initial "@(#)$Workfile$ $Revision$".
      916   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   procedure r-cost :
      918     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      919     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      920     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      921     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      922     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      923     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      924     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      925     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      926     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      927     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      928     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      929     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      930     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      931     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      932     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      933     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      934     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      935     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      936     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      937     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      938     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      939     do
      940     on error undo, return error
      941     :
      942       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      943       define buffer   in-vatp-parts    for ub.parts   .
      944       define buffer   in-vatp-doc      for ub.trn-doc .
      945       define buffer   in-vatp-goods    for ub.goods   .
      946       define buffer   in-vatp-sysconf  for ub.sysconf .
      947       define buffer   in-vatp_doc-attr for ub.doc-attr.
      948       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      949       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      950       define variable varinvprb                  as   character              no-undo.
      951       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      952       define variable cli-base-rate              as   decimal                no-undo.
      953       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      954       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      955       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      956       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      957       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      958       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      959       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      960       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      961       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      962       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      963       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      964       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      965       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      966       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      967       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      968       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      969       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      970       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      971       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      972       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      973       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      974       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      975       define variable varinvatp-envd             as   character              no-undo.
      976       define variable varinvatp-type             as   character              no-undo.
      977       def var v-parts-fact-qnty as decimal   no-undo .
      978       define buffer buf_parts    for ub.parts    .
      979       define buffer buf_goods    for ub.goods    .
      980       define buffer buf_trn-doc  for ub.trn-doc  .
      981       define buffer buf_doc-line for ub.doc-line .
      982       find first buf_doc-line no-lock
      983         where buf_doc-line.doc-code  = v-doc-code
      984           and buf_doc-line.artic     = v-artic
      985           and buf_doc-line.prod-type = v-prod-type
      986           and buf_doc-line.prod-code = v-prod-code
      987         no-error .
      988       if not available buf_doc-line then do:
      989         message
      990           vss-workfile vss-revision vss-description skip
      991           vss-include-info9 skip
      992           "Ошибка задания входных параметров" skip
      993           "Не найдена строка документа"  skip
      994           "Документ" v-doc-code skip
      995           "Артикул" v-artic v-prod-type v-prod-code skip
      996           view-as alert-box error .
      997         return error .
      998       end.
      999       find first buf_trn-doc no-lock
     1000         where buf_trn-doc.doc-code = v-doc-code
     1001         no-error .
     1002       if not available buf_trn-doc then do:
     1003         message
     1004           vss-workfile vss-revision vss-description skip
     1005           vss-include-info9 skip
     1006           "Ошибка задания входных параметров" skip
     1007           "Не найден документ" skip
     1008           "Документ" v-doc-code skip
     1009           "Артикул" v-artic v-prod-type v-prod-code skip
     1010           view-as alert-box error .
     1011         undo, return error .
     1012       end.
     1013       find first buf_goods no-lock
     1014         where buf_goods.artic     = buf_doc-line.artic
     1015           and buf_goods.prod-type = buf_doc-line.prod-type
     1016           and buf_goods.prod-code = buf_doc-line.prod-code
     1017         no-error .
     1018       if not available buf_goods then do:
     1019         message
     1020           vss-workfile vss-revision vss-description skip
     1021           vss-include-info9 skip
     1022           "Ошибка задания входных параметров" skip
     1023           "Не найден товар" skip
     1024           "Документ" v-doc-code skip
     1025           "Артикул" v-artic v-prod-type v-prod-code skip
     1026           view-as alert-box error .
     1027         undo, return error .
     1028       end.
     1029       if buf_goods.gds-type = 'т':U then do:
     1030             for each buf_parts no-lock
     1031               where buf_parts.out-code  = buf_trn-doc.doc-code
     1032                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1033                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1034                 and buf_parts.artic     = buf_doc-line.artic
     1035                 and buf_parts.prod-type = buf_doc-line.prod-type
     1036                 and buf_parts.prod-code = buf_doc-line.prod-code
     1037             on error undo, return error
     1038             :
     1039   assign
     1040     price-rubl-with-tax-loc = buf_parts.price-rubl
     1041     price-base-with-tax-loc = buf_parts.price-base
     1042   .
     1043   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1045     (output varinvprb
     1046     )  .
     1047     if buf_parts.out-code = 'free-zone':U     or
     1048        buf_parts.out-code = 'out-zone':U   or
     1049        buf_parts.doc-type = 'акт':U then do:
     1050       assign
     1051         in-vatp-have-vat-slt = yes.
     1052     end.
     1053     else do:
     1054       find first in-vatp_doc-attr no-lock
     1055         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1056           and in-vatp_doc-attr.attr-code = 'envd':U
     1057         no-error .
     1058       if not available in-vatp_doc-attr then do:
     1059         assign
     1060           in-vatp-have-vat-slt = yes.
     1061       end.
     1062       else do:
     1063            in-vatp-have-vat-slt = no.
     1064       end.
     1065     end.
     1066     assign
     1067      price-cli-with-tax-loc = buf_parts.price-cli
     1068      cli-base-rate          = buf_parts.cli-base-rate.
     1069     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1070              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1071     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1072             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1073             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1074             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1075             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1076             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1077             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1078       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1079     assign
     1080       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1081     assign
     1082       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1083       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1084       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1085       transport-cli-loc  = 0
     1086       other-cli-loc      = 0
     1087     .
     1088   ASSIGN
     1089             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1090       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1091   .
     1092               assign
     1093                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1094                                       or buf_trn-doc.doc-type = 'возврат':U
     1095                                       or buf_trn-doc.doc-type = 'инв':U
     1096                                       then buf_parts.fact-qnty
     1097                                       else - buf_parts.fact-qnty
     1098                                      )
     1099               .
     1100               assign
     1101                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1102                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1103                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1104                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1105                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1106                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1107                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1108                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1109                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1110                 v-excise-base         =   0
     1111                 v-excise-rubl         =   0
     1112                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1113                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1114                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1115                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1116               .
     1117           end.
     1118   assign
     1119     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1120     price-base-with-tax-loc = buf_doc-line.price-base
     1121   .
     1122   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1124     (output varinvprb
     1125     )  .
     1126      find first in-vatp_doc-attr no-lock
     1127       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1128         and in-vatp_doc-attr.attr-code = 'envd':U
     1129       no-error .
     1130       if available in-vatp_doc-attr
     1131          then do:
     1132          assign
     1133            in-vatp-have-vat-slt = no.
     1134      end.
     1135      else do:
     1136        assign
     1137          in-vatp-have-vat-slt = yes.
     1138      end.
     1139      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1140                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1141                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1142      if (not buf_trn-doc.internal and
     1143              buf_trn-doc.doc-type = 'при':U) or
     1144         in-vatp-goods.gds-type = 'у':U then do:
     1145         if varinvprb = "base":u then do:
     1146           assign
     1147             road-tax-base-loc = buf_doc-line.road-tax
     1148             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1149         end.
     1150         else do:
     1151           ASSIGN
     1152             road-tax-rubl-loc = buf_doc-line.road-tax
     1153             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1154         end.
     1155         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1156         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1157         assign
     1158           road-tax-cli-loc = ?.
     1159         ASSIGN
     1160           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1161           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1162           transport-cli-loc  = 0
     1163           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1164           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1165           other-cli-loc      = 0
     1166           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1167           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1168                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1169               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1170         assign
     1171           vat-cli-loc            = ?
     1172           slt-cli-loc            = ?
     1173           price-cli-with-tax-loc = ?.
     1174      end.
     1175      else do:
     1176                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1177                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1178                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1179                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1180                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1181                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1182                            use-index out-code no-lock:
     1183             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1184                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
