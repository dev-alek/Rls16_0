     3248   procedure create-doc-line :
     3249   define input parameter p-doc-code       as character    no-undo.
     3250   define input parameter p-gds-code       as integer      no-undo.
     3251   define input parameter p-qnty           as decimal      no-undo.
     3252   define output parameter p-sum-base      as decimal      no-undo .
     3253   define output parameter p-sum-rubl      as decimal      no-undo .
     3254   define output parameter p-sum-vat-base  as decimal      no-undo .
     3255   define output parameter p-sum-vat-rubl  as decimal      no-undo .
     3256       define variable v-required-qnty     as decimal        no-undo.
     3257       define variable v-reserved-qnty     as decimal        no-undo.
     3258       define variable v-today             as date           no-undo.
     3259       define variable v-time              as integer        no-undo.
     3260       define variable v-sum-base          as decimal        no-undo.
     3261       define variable v-sum-rubl          as decimal        no-undo.
     3262       define variable v-vat-base          as decimal        no-undo.
     3263       define variable v-vat-rubl          as decimal        no-undo.
     3264       define variable v-vat-pc            as decimal        no-undo.
     3265       define variable v-host-code         as integer        no-undo.
     3266       define buffer buf_trn-doc       for trn-doc.
     3267       define buffer buf_doc-line      for doc-line.
     3268       define buffer buf_goods         for goods.
     3269       define buffer buf_gds-dtl       for gds-dtl.
     3270       define buffer buf_gds-prt       for gds-prt.
     3271   do
     3272   for buf_trn-doc
     3273     , buf_doc-line
     3274     , buf_goods
     3275     , buf_gds-dtl
     3276     , buf_gds-prt
     3277   on error undo, return error
     3278   :
     3279       find first buf_trn-doc no-lock
     3280            where buf_trn-doc.doc-code = p-doc-code
     3281       .
     3282       find first buf_goods no-lock
     3283            where buf_goods.gds-code = p-gds-code
     3284       .
     3285       create buf_doc-line.
     3286       assign
     3287           buf_doc-line.artic         = buf_goods.artic
     3288           buf_doc-line.prod-type     = buf_goods.prod-type
     3289           buf_doc-line.prod-code     = buf_goods.prod-code
     3290           buf_doc-line.obj-type      = buf_trn-doc.obj-type
     3291           buf_doc-line.obj-code      = buf_trn-doc.obj-code
     3292           buf_doc-line.doc-code      = buf_trn-doc.doc-code
     3293           buf_doc-line.prt-ok        = yes
     3294           buf_doc-line.prt-root      = buf_goods.prt-root
     3295           buf_doc-line.status_       = buf_trn-doc.status_
     3296           buf_doc-line.doc-qnty      = 0
     3297           buf_doc-line.cli-base-rate = 1
     3298           v-required-qnty            = round( p-qnty, 3 )
     3299           v-reserved-qnty            = 0
     3300       .
     3301       run fbrrsrv-rsrv-goods in this-procedure (
     3302             input parparentproc
     3303           , input recid( buf_goods )
     3304           , input recid( buf_doc-line )
     3305           , input v-required-qnty
     3306           , input no
     3307           , input 0
     3308           , input no
     3309           , input ""
     3310           , output v-reserved-qnty
     3311       ) no-error.
     3312       if error-status :error
     3313       then do:
     3314           if error-status :get-message(1) <> ""
     3315           or return-value <> "user-interrupt":U
     3316           then do:
     3317               message
     3318               vss-workfile vss-revision vss-description
     3319               skip "Ошибка резервирования товара."
     3320               skip return-value
     3321               skip trim(error-status :get-message(1))
     3322                   trim(error-status :get-message(2))
     3323                   trim(error-status :get-message(3))
     3324               view-as alert-box error.
     3325           end.
     3326           undo, return error return-value.
     3327       end.
     3328       if v-required-qnty <> v-reserved-qnty
     3329       then do:
     3330           message
     3331           "Невозможно зарезервировать товар."
     3332           skip(1)
     3333           skip "Товар:" buf_goods.artic buf_goods.gds-name
     3334           skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     3335           skip "Количество:" v-required-qnty
     3336           skip "Доступно количество:" v-reserved-qnty
     3337           view-as alert-box error.
     3338           undo, return error .
     3339       end.
     3340       run str/fbrcost.p (
     3341             input recid( buf_doc-line )
     3342           , input -1
     3343           , input v-required-qnty
     3344           , output v-sum-base
     3345           , output v-sum-rubl
     3346           , output v-vat-base
     3347           , output v-vat-rubl
     3348           , output v-vat-pc
     3349         ) .
     3350       run cur-time in this-procedure (
     3351             output v-today
     3352           , output v-time
     3353       ).
     3354   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3356     (input  buf_trn-doc.obj-type
     3357     ,input  buf_trn-doc.obj-code
     3358     ,output v-host-code
     3359     )  .
     3360   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3362     (input  buf_goods.gds-code
     3363     ,input  '1':U
     3364     ,input  ?
     3365     ,input  v-host-code
     3366     ,input  buf_trn-doc.obj-type
     3367     ,input  buf_trn-doc.obj-code
     3368     ,output v-vat-pc
     3369     )  .
     3370       find first buf_gds-prt no-lock
     3371            where buf_gds-prt.upper-code = buf_goods.prt-root
     3372       .
     3373       find first buf_gds-dtl exclusive-lock
     3374            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     3375              and buf_gds-dtl.artic     = buf_goods.artic
     3376              and buf_gds-dtl.prod-type = buf_goods.prod-type
     3377              and buf_gds-dtl.prod-code = buf_goods.prod-code
     3378              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     3379       .
     3380       assign
     3381           buf_doc-line.doc-qnty   = v-reserved-qnty
     3382           buf_doc-line.fact-qnty  = v-reserved-qnty
     3383           buf_gds-dtl.doc-qnty    = v-reserved-qnty
     3384           buf_gds-dtl.fact-qnty   = v-reserved-qnty
     3385           p-sum-base              = v-sum-base - v-vat-base
     3386           p-sum-rubl              = v-sum-rubl - v-vat-rubl
     3387           p-sum-vat-base          = v-vat-base
     3388           p-sum-vat-rubl          = v-vat-rubl
     3389       .
     3390       assign
     3391           buf_doc-line.price-cli  = v-sum-rubl / v-reserved-qnty
     3392           buf_doc-line.price-base = v-sum-base / v-reserved-qnty
     3393           buf_doc-line.price-rubl = v-sum-rubl / v-reserved-qnty
     3394           buf_doc-line.VAT-pc     = v-vat-pc
     3395       .
     3396   end.
     3397   end procedure.
