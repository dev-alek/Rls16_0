      703   procedure get-last-check-date-time :
      704       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      705       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      706       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      707       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      708       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      709       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      710       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      711       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      712       define variable v-character as character no-undo .
      713       define variable v-date      as date      no-undo .
      714       define variable v-decimal   as decimal   no-undo .
      715       define variable v-integer   as integer   no-undo .
      716       define variable v-logical   as logical   no-undo .
      717       define variable v-attr-type as character no-undo .
      718       define buffer buf_chk-doc     for ub.chk-doc.
      719       define buffer buf_c-cash-desk for ub.c-cash-desk.
      720       do
      721           on error undo, return error
      722           :
      723           run cd-attr-value in this-procedure (
      724               input g#db-num
      725               ,input p-obj-code
      726               ,input p-pos-type
      727               ,input p-cash-num
      728               ,input 'MAGIA-XML_operative':U
      729               ,input 'last-check-date-time':U
      730               ,output v-character
      731               ,output v-date
      732               ,output v-decimal
      733               ,output v-integer
      734               ,output v-logical
      735               ,output v-attr-type     ) no-error.
      736           if v-character = "":U
      737               or v-character = ?
      738               then
      739           do:
      740               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      741                   buf_c-cash-desk.db-num = g#db-num
      742                   AND buf_c-cash-desk.pos-type = p-pos-type
      743                   AND buf_c-cash-desk.cash-num = p-cash-num
      744                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      745                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      746               if available buf_c-cash-desk then
      747               do:
      748                   assign
      749                       p-date = buf_c-cash-desk.corr-date
      750                       p-time = buf_c-cash-desk.corr-time
      751                       .
      752               end.
      753               else
      754               do:
      755                   find first buf_chk-doc no-lock where
      756                       buf_chk-doc.obj-type = 'маг':U
      757                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      758                   if not available buf_chk-doc then
      759                   do:
      760                       return error.
      761                   end.
      762                   assign
      763                       p-date = buf_chk-doc.chk-date - 1
      764                       p-time = buf_chk-doc.chk-time
      765                       .
      766               end.
      767           end.
      768           else
      769           do:
      770               assign
      771                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      772           no-error .
      773               if error-status:error then return error .
      774           end.
      775       end.
      776   end procedure.
      777   procedure get-last-check-params :
      778       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      779       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      780       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      781       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      782       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      783       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      784       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      785       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      786       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      787       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      788       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      789       define variable v-character as character no-undo .
      790       define variable v-date      as date      no-undo .
      791       define variable v-decimal   as decimal   no-undo .
      792       define variable v-integer   as integer   no-undo .
      793       define variable v-logical   as logical   no-undo .
      794       define variable v-attr-type as character no-undo .
      795       define buffer buf_chk-doc     for ub.chk-doc.
      796       define buffer buf_c-cash-desk for ub.c-cash-desk.
      797       do
      798           on error undo, return error
      799           :
      800           run cd-attr-value in this-procedure (
      801               input g#db-num
      802               ,input p-obj-code
      803               ,input p-pos-type
      804               ,input p-cash-num
      805               ,input if p-pos-type eq 'IBM-XML':U
      806               then 'IBM-XML_operative':U
      807               else 'AUTOTANK_operative':U
      808               ,input if p-pos-type = 'IBM-XML':U
      809               then 'last-check-params':U
      810               else 'last-check-params':U
      811               ,output v-character
      812               ,output v-date
      813               ,output v-decimal
      814               ,output v-integer
      815               ,output v-logical
      816               ,output v-attr-type     ) no-error.
      817           if v-character = "":U
      818               or v-character = ?
      819               then
      820           do:
      821               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      822                   buf_c-cash-desk.db-num = g#db-num
      823                   AND buf_c-cash-desk.pos-type = p-pos-type
      824                   AND buf_c-cash-desk.cash-num = p-cash-num
      825                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      826                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      827               if available buf_c-cash-desk then
      828               do:
      829                   assign
      830                       p-date = buf_c-cash-desk.corr-date
      831                       p-time = buf_c-cash-desk.corr-time
      832                       .
      833               end.
      834               else
      835               do:
      836                   find first buf_chk-doc no-lock where
      837                       buf_chk-doc.obj-type = 'маг':U
      838                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      839                   if not available buf_chk-doc then
      840                   do:
      841                       return error.
      842                   end.
      843                   assign
      844                       p-date      = buf_chk-doc.chk-date - 1
      845                       p-time      = buf_chk-doc.chk-time
      846                       p-shift-num = buf_chk-doc.shift-num
      847                       p-z-count   = buf_chk-doc.z-number
      848                       p-chk-num   = buf_chk-doc.chk-num
      849                       .
      850               end.
      851           end.
      852           else
      853           do:
      854               assign
      855                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      856                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      857                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      858                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      859                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      860                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      861           no-error .
      862               if error-status:error then return error .
      863           end.
      864       end.
      865   end procedure.
      866   procedure get-last-report-params :
      867       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      868       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      869       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      870       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      871       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      872       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      873       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      874       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      875       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      876       define variable v-character as character no-undo .
      877       define variable v-date      as date      no-undo .
      878       define variable v-decimal   as decimal   no-undo .
      879       define variable v-integer   as integer   no-undo .
      880       define variable v-logical   as logical   no-undo .
      881       define variable v-date1     as character no-undo .
      882       define variable v-date2     as character no-undo .
      883       define variable v-attr-type as character no-undo .
      884       define buffer buf_chk-slip-head for ub.chk-slip-head.
      885       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      886       do
      887           on error undo, return error
      888           :
      889           run cd-attr-value in this-procedure (
      890               input g#db-num
      891               ,input p-obj-code
      892               ,input p-pos-type
      893               ,input p-cash-num
      894               ,input if p-pos-type eq 'IBM-XML':U
      895               then 'IBM-XML_operative':U
      896               else 'AUTOTANK_operative':U
      897               ,input if p-pos-type = 'IBM-XML':U
      898               then 'last-report-params':U
      899               else 'last-report-params':U
      900               ,output v-character
      901               ,output v-date
      902               ,output v-decimal
      903               ,output v-integer
      904               ,output v-logical
      905               ,output v-attr-type     ) no-error.
      906           if v-character = "":U
      907               or v-character = ?
      908               then
      909           do:
      910               find last buf_chk-slip-head no-lock where
      911                   buf_chk-slip-head.obj-code = p-obj-code
      912                   and buf_chk-slip-head.cash-num = p-cash-num
      913                   and buf_chk-slip-head.db-num = p-db-num
      914                   and buf_chk-slip-head.is-report = 1 no-error.
      915               if not available buf_chk-slip-head then
      916               do:
      917                   return error.
      918               end.
      919               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      920               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      921                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      922                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      923                   + " " + entry(1,v-date2,".") .
      924               assign
      925                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      926                   p-shift-num = buf_chk-slip-head.CashShiftNum
      927                   .
      928           end.
      929           else
      930           do:
      931               assign
      932                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      933                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      934                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      935           no-error .
      936               if error-status:error then return error .
      937           end.
      938       end.
      939   end procedure.
      940   procedure get-last-check-maria :
      941       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      942       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      943       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      944       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      945       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      946       define output parameter p-num-recs as integer no-undo .
      947       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      948       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      949       define output parameter p-p-num-recs as integer no-undo .
      950       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      951       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      952       define variable v-character as character no-undo .
      953       define variable v-date      as date      no-undo .
      954       define variable v-decimal   as decimal   no-undo .
      955       define variable v-integer   as integer   no-undo .
      956       define variable v-logical   as logical   no-undo .
      957       define variable v-attr-type as character no-undo .
      958       define buffer buf_chk-doc     for ub.chk-doc.
      959       define buffer buf_c-cash-desk for ub.c-cash-desk.
      960       do
      961           on error undo, return error
      962           :
      963           run cd-attr-value in this-procedure (
      964               input p-db-num
      965               ,input p-obj-code
      966               ,input 'MARIA':U
      967               ,input p-cash-num
      968               ,input 'MARIA_operative':U
      969               ,input 'last-check-maria':U
      970               ,output v-character
      971               ,output v-date
      972               ,output v-decimal
      973               ,output v-integer
      974               ,output v-logical
      975               ,output v-attr-type     ) no-error.
      976           if v-character = "":U
      977               or v-character = ?
      978               then
      979           do:
      980               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      981                   buf_c-cash-desk.db-num = p-db-num
      982                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      983                   AND buf_c-cash-desk.cash-num = p-cash-num
      984                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      985                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      986               if available buf_c-cash-desk then
      987               do:
      988                   assign
      989                       p-date   = buf_c-cash-desk.corr-date
      990                       p-p-date = buf_c-cash-desk.corr-date
      991                       .
      992               end.
      993               else
      994               do:
      995                   find first buf_chk-doc no-lock where
      996                       buf_chk-doc.obj-type = 'маг':U
      997                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      998                   if not available buf_chk-doc then
      999                   do:
     1000                       assign
     1001                           p-date       = 01/01/1990
     1002                           p-z-count    = 1
     1003                           p-num-recs   = 0
     1004                           p-p-date     = 01/01/1990
     1005                           p-p-z-count  = 1
     1006                           p-p-num-recs = 0
     1007                           .
     1008                   end.
     1009                   assign
     1010                       p-date       = buf_chk-doc.chk-date - 1
     1011                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
     1012                       p-num-recs   = 0
     1013                       p-p-date     = buf_chk-doc.chk-date - 1
     1014                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
     1015                       p-p-num-recs = 0
     1016                       .
     1017               end.
     1018           end.
     1019           else
     1020           do:
     1021               assign
     1022                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
     1023                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
     1024                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
     1025                         )
     1026                   p-z-count    = integer(entry(2, v-character, chr(32) ))
     1027                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
     1028                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
     1029                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
     1030                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
     1031                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
     1032                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1033                         )
     1034                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1035                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1036                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1037                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1038           no-error .
     1039               if error-status:error then return error .
     1040           end.
     1041       end.
     1042   end procedure.
     1043   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   define variable path as char no-undo.
     1045   define variable atr as char no-undo.
     1046   define variable file as char no-undo.
     1047   define variable adr as char no-undo.
     1048   def stream DirStream .
     1049   define variable in_ as char no-undo.
     1050   define variable spl as char no-undo.
     1051   define variable sav as char no-undo.
     1052   define variable out as char no-undo.
     1053   define variable out2 as character no-undo .
     1054   define variable v-remote as char no-undo.
     1055   define variable v-dir-remote as character no-undo .
     1056   define variable v-dir-remote-tmp as character no-undo .
     1057   define variable yestr as character no-undo .
     1058   define variable kass-list as char no-undo.
     1059   define variable cycle as logical no-undo.
     1060   def buffer for-cash-desk for ub.cash-desk.
     1061   define variable jj as int no-undo.
     1062   define variable v-lock-global as logical no-undo.
     1063   def frame a
     1064   path format "x(30)"
     1065   with view-as dialog-box side-labels
     1066   size 50 by 4.17 three-d title "Обработка файла ...".
     1067   define variable vss-include-info4 as character format "X(65)" no-undo
     1068   initial "@(#)$Workfile$ $Revision$".
     1069   define variable v-bgelib-bgefmt        as character         no-undo.
     1070   define variable v-bgelib-bgeflold      as character         no-undo.
     1071   define stream stmXMLOut.
     1072   define stream stmXMLLog.
     1073   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   procedure cur-time :
     1075      define output parameter p-today as date      no-undo .
     1076      define output parameter p-time  as integer   no-undo .
     1077     do
     1078     on error undo, return error
     1079     :
     1080       define variable v-date1 as date      no-undo .
     1081       define variable v-date2 as date      no-undo .
     1082       define variable v-time  as integer   no-undo .
     1083       assign
     1084         v-date1 = today
     1085         v-time  = time
     1086         v-date2 = today
     1087       .
     1088       if v-date1 <> v-date2
     1089       then do:
     1090         assign
     1091           v-date1 = today
     1092           v-time  = v-time
     1093         .
     1094       end.
     1095       assign
     1096         p-today = v-date1
     1097         p-time  = v-time
     1098       .
     1099     end.
     1100   end.
     1101   function cur-time-date returns character
     1102   :
     1103     return string(today, '99/99/9999':U) .
     1104   end.
     1105   function cur-time-mjd returns decimal
     1106   :
     1107     define variable v-date as date      no-undo .
     1108     define variable v-time as integer   no-undo .
     1109     run cur-time in this-procedure
     1110       (output v-date
     1111       ,output v-time
     1112       ) .
     1113     return integer(v-date) - 2400002 + (v-time / 86400) .
     1114   end.
     1115   function cur-time-get-ending-index returns integer
     1116   (input p-number as integer
     1117   )
     1118   :
     1119     if p-number < 0
     1120     or p-number = ?
     1121     then do:
     1122       return 1 .
     1123     end.
     1124     define variable v-rest as integer   no-undo .
     1125     assign
     1126       p-number = p-number modulo 100
     1127     .
     1128     if p-number < 20
     1129     then do:
     1130       assign
     1131         v-rest = p-number
     1132       .
     1133     end.
     1134     else do:
     1135       assign
     1136         v-rest = p-number modulo 10
     1137       .
     1138     end.
     1139     case v-rest :
     1140       when 1
     1141       then do:
     1142         return 2 .
     1143       end.
     1144       when 2 or
     1145       when 3 or
     1146       when 4
     1147       then do:
     1148         return 3 .
     1149       end.
     1150       otherwise do:
     1151         return 1 .
     1152       end.
     1153     end case .
     1154   end.
     1155   procedure cur-time-mjd-to-date :
     1156      define input  parameter i-mjd-diff as decimal no-undo.
     1157      define output parameter o-Date     as date    no-undo.
     1158      define output parameter o-Time     as integer no-undo.
     1159      define variable v-day-number as integer   no-undo .
     1160      if    i-mjd-diff < 0
     1161         or i-mjd-diff = ?
     1162      then do:
     1163         return "?" .
     1164      end.
     1165      assign
     1166         v-day-number = truncate(i-mjd-diff,0).
     1167         o-Date = date(v-day-number + 2400002).
     1168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1169     .
     1170   end.
     1171   function cur-time-mjd-to-string returns character
     1172   (input p-mjd-diff as decimal
     1173   )
     1174   :
     1175     define variable v-day-number as integer   no-undo .
     1176     define variable v-seconds    as integer   no-undo .
     1177     define variable v-hour       as integer   no-undo .
     1178     define variable v-min        as integer   no-undo .
     1179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1183     if p-mjd-diff < 0
     1184     or p-mjd-diff = ?
     1185     then do:
     1186       return "?" .
     1187     end.
     1188     assign
     1189       v-day-number = integer(truncate(p-mjd-diff,0))
     1190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1191     .
     1192     if v-seconds > 86400
     1193     then do:
     1194       assign
     1195         v-seconds = 86400 - 1
     1196       .
     1197     end.
     1198     if v-seconds < 0
     1199     then do:
     1200       assign
     1201         v-seconds = 0
     1202       .
     1203     end.
     1204     assign
     1205       v-hour = truncate(v-seconds / 3600, 0)
     1206     .
     1207     assign
     1208       v-seconds = v-seconds modulo 3600
     1209     .
     1210     assign
     1211       v-min = truncate(v-seconds / 60, 0)
     1212     .
     1213     assign
     1214       v-seconds = v-seconds modulo 60
     1215     .
     1216     return
     1217         (if v-day-number <> 0
     1218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1219           else ""
     1220         )
     1221       + (if v-day-number <> 0 or v-hour <> 0
     1222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1223           else ""
     1224         )
     1225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1227           else ""
     1228         )
     1229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1230       .
     1231   end.
     1232   function cur-time-string returns character
     1233   :
     1234     define variable v-date as date      no-undo .
     1235     define variable v-time as integer   no-undo .
     1236     run cur-time in this-procedure
     1237       (output v-date
     1238       ,output v-time
     1239       ) .
     1240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1241   end.
     1242   function cur-time-string-sec returns character
     1243   :
     1244     define variable v-date as date      no-undo .
     1245     define variable v-time as integer   no-undo .
     1246     run cur-time in this-procedure
     1247       (output v-date
     1248       ,output v-time
     1249       ) .
     1250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1251   end.
     1252   function cur-time-custom  returns character
     1253   (input p-prefix as character
     1254   ,input p-date-format as character
     1255   ,input p-delimiter as character
     1256   ,input p-time-format as character
     1257   ,input p-suffix as character
     1258   )
     1259   :
     1260     define variable v-date as date      no-undo .
     1261     define variable v-time as integer   no-undo .
     1262     run cur-time in this-procedure
     1263       (output v-date
     1264       ,output v-time
     1265       ) .
     1266     return
     1267       p-prefix
     1268       + string(v-date, p-date-format)
     1269       + p-delimiter
     1270       + string(v-time, p-time-format)
     1271       + p-suffix
     1272       .
     1273   end.
     1274   function cur-time-print  returns character
     1275   :
     1276     define variable v-date as date      no-undo .
     1277     define variable v-time as integer   no-undo .
     1278     run cur-time in this-procedure
     1279       (output v-date
     1280       ,output v-time
     1281       ) .
     1282     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1283   end.
     1284   function cur-time-datetime returns datetime
     1285   :
     1286     define variable v-char as character no-undo .
     1287     define variable v-datetime as datetime no-undo .
     1288     v-char = cur-time-string().
     1289     v-datetime = datetime(v-char).
     1290     return  v-datetime.
     1291   end.
     1292   function cur-time-string-msec returns character
     1293   :
     1294     define variable v-date as datetime  no-undo .
     1295     v-date = now.
     1296     return string(v-date) .
     1297   end.
     1298   define variable vss-include-info6 as character format "X(65)" no-undo
     1299   initial "@(#)$Workfile$ $Revision$".
     1300   procedure xmlchar-test :
     1301   define input parameter p-in-string          as character        no-undo.
     1302   define output parameter p-out-string-enc    as character        no-undo.
     1303   define output parameter p-out-string-dec    as character        no-undo.
     1304   do
     1305   on error undo, return error
     1306   :
     1307          run xmlchar-encode in this-procedure
     1308       (
     1309             input p-in-string
     1310           , output p-out-string-enc
     1311       ).
     1312          run xmlchar-decode in this-procedure
     1313       (
     1314             input p-out-string-enc
     1315           , output p-out-string-dec
     1316       ).
     1317   end.
     1318   end .
     1319   procedure xmlchar-encode :
     1320   define input parameter p-in-string      as character        no-undo.
     1321   define output parameter p-out-string    as character        no-undo.
     1322       define variable v-position      as integer      no-undo.
     1323       define variable v-current-char  as character    no-undo.
     1324   do
     1325   on error undo, return error
     1326   :
     1327       assign
     1328           p-out-string = "":U
     1329       .
     1330       case p-in-string
     1331       :
     1332           when ?
     1333           then do:
     1334               assign
     1335                   p-out-string = "?":U
     1336               .
     1337           end.
     1338           when "?":U
     1339           then do:
     1340               assign
     1341                   p-out-string = "&#63;":U
     1342               .
     1343           end.
     1344           otherwise do:
     1345               do v-position = 1 to length( p-in-string )
     1346               :
     1347                   assign
     1348                       v-current-char = substring( p-in-string, v-position, 1 )
     1349                   .
     1350                   case v-current-char
     1351                   :
     1352                       when "&":U
     1353                       then do:
     1354                           assign
     1355                               p-out-string = p-out-string + "&amp;":U
     1356                           .
     1357                       end.
     1358                       when ">":U
     1359                       then do:
     1360                           assign
     1361                               p-out-string = p-out-string + "&gt;":U
     1362                           .
     1363                       end.
     1364                       when "<":U
     1365                       then do:
     1366                           assign
     1367                               p-out-string = p-out-string + "&lt;":U
     1368                           .
     1369                       end.
     1370                       when "'":U
     1371                       then do:
     1372                           assign
     1373                               p-out-string = p-out-string + "&apos;":U
     1374                           .
     1375                       end.
     1376                       when '"':U
     1377                       then do:
     1378                           assign
     1379                               p-out-string = p-out-string + "&quot;":U
     1380                           .
     1381                       end.
     1382                       when chr(1)
     1383                       then do:
     1384                           assign
     1385                               p-out-string = p-out-string + "":U
     1386                           .
     1387                       end.
     1388                       when chr(2)
     1389                       then do:
     1390                           assign
     1391                               p-out-string = p-out-string + "":U
     1392                           .
     1393                       end.
     1394                       when chr(3)
     1395                       then do:
     1396                           assign
     1397                               p-out-string = p-out-string + "":U
     1398                           .
     1399                       end.
     1400                       when chr(4)
     1401                       then do:
     1402                           assign
     1403                               p-out-string = p-out-string + "":U
     1404                           .
     1405                       end.
     1406                       when chr(5)
     1407                       then do:
     1408                           assign
     1409                               p-out-string = p-out-string + "":U
     1410                           .
     1411                       end.
     1412                       when chr(6)
     1413                       then do:
     1414                           assign
     1415                               p-out-string = p-out-string + "":U
     1416                           .
     1417                       end.
     1418                       when chr(7)
     1419                       then do:
     1420                           assign
     1421                               p-out-string = p-out-string + "":U
     1422                           .
     1423                       end.
     1424                       when chr(8)
     1425                       then do:
     1426                           assign
     1427                               p-out-string = p-out-string + "":U
     1428                           .
     1429                       end.
     1430                       when chr(9)
     1431                       then do:
     1432                           assign
     1433                               p-out-string = p-out-string + "":U
     1434                           .
     1435                       end.
     1436                       when chr(29)
     1437                       then do:
     1438                           assign
     1439                               p-out-string = p-out-string + "":U
     1440                           .
     1441                       end.
     1442                       when chr(10)
     1443                       then do:
     1444                           assign
     1445                               p-out-string = p-out-string + "&#10;":U
     1446                           .
     1447                       end.
     1448                       when chr(13)
     1449                       then do:
     1450                           assign
     1451                               p-out-string = p-out-string + "&#13;":U
     1452                           .
     1453                       end.
     1454                       otherwise do:
     1455                           assign
     1456                               p-out-string = p-out-string + v-current-char
     1457                           .
     1458                       end.
     1459                   end case.
     1460               end.
     1461           end.
     1462       end case.
     1463   end.
     1464   end .
     1465   procedure xmlchar-encode-1c :
     1466   define input parameter p-in-string      as character        no-undo.
     1467   define output parameter p-out-string    as character        no-undo.
     1468       define variable v-position      as integer      no-undo.
     1469       define variable v-current-char  as character    no-undo.
     1470   do
     1471   on error undo, return error
     1472   :
     1473       assign
     1474           p-out-string = "":U
     1475       .
     1476       case p-in-string
     1477       :
     1478           when ?
     1479           then do:
     1480               assign
     1481                   p-out-string = "?":U
     1482               .
     1483           end.
     1484           otherwise do:
     1485               do v-position = 1 to length( p-in-string )
     1486               :
     1487                   assign
     1488                       v-current-char = substring( p-in-string, v-position, 1 )
     1489                   .
     1490                   case v-current-char
     1491                   :
     1492                       when chr(1)
     1493                       then do:
     1494                           assign
     1495                               p-out-string = p-out-string + " ":U
     1496                           .
     1497                       end.
     1498                       when chr(2)
     1499                       then do:
     1500                           assign
     1501                               p-out-string = p-out-string + " ":U
     1502                           .
     1503                       end.
     1504                       when chr(3)
     1505                       then do:
     1506                           assign
     1507                               p-out-string = p-out-string + " ":U
     1508                           .
     1509                       end.
     1510                       when chr(4)
     1511                       then do:
     1512                           assign
     1513                               p-out-string = p-out-string + " ":U
     1514                           .
     1515                       end.
     1516                       when chr(5)
     1517                       then do:
     1518                           assign
     1519                               p-out-string = p-out-string + " ":U
     1520                           .
     1521                       end.
     1522                       when chr(6)
     1523                       then do:
     1524                           assign
     1525                               p-out-string = p-out-string + " ":U
     1526                           .
     1527                       end.
     1528                       when chr(7)
     1529                       then do:
     1530                           assign
     1531                               p-out-string = p-out-string + " ":U
     1532                           .
     1533                       end.
     1534                       when chr(8)
     1535                       then do:
     1536                           assign
     1537                               p-out-string = p-out-string + " ":U
     1538                           .
     1539                       end.
     1540                       when chr(9)
     1541                       then do:
     1542                           assign
     1543                               p-out-string = p-out-string + " ":U
     1544                           .
     1545                       end.
     1546                       when chr(29)
     1547                       then do:
     1548                           assign
     1549                               p-out-string = p-out-string + " ":U
     1550                           .
     1551                       end.
     1552                       when chr(10)
     1553                       then do:
     1554                           assign
     1555                               p-out-string = p-out-string + " ":U
     1556                           .
     1557                       end.
     1558                       when chr(13)
     1559                       then do:
     1560                           assign
     1561                               p-out-string = p-out-string + " ":U
     1562                           .
     1563                       end.
     1564                       otherwise do:
     1565                           assign
     1566                               p-out-string = p-out-string + v-current-char
     1567                           .
     1568                       end.
     1569                   end case.
     1570               end.
     1571           end.
     1572       end case.
     1573   end.
     1574   end .
     1575   procedure xmlchar-decode :
     1576   define input parameter p-in-string      as character        no-undo.
     1577   define output parameter p-out-string    as character        no-undo.
     1578       define variable v-position      as integer      no-undo.
     1579       define variable v-last-position as integer      no-undo.
     1580       define variable v-temp-integer  as integer      no-undo.
     1581       define variable v-current-char  as character    no-undo.
     1582       define variable v-next-char     as character    no-undo.
     1583       define variable v-success       as logical      no-undo.
     1584   do
     1585   on error undo, return error
     1586   :
     1587       assign
     1588           p-out-string = "":U
     1589           v-position   = 0
     1590       .
     1591       replace-cycle:
     1592       do while yes
     1593       on error undo, return error
     1594       :
     1595           assign
     1596               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1597           .
     1598           if v-last-position <= v-position
     1599           then do:
     1600               if v-position = 0
     1601               then do:
     1602                   assign
     1603                       p-out-string = p-in-string
     1604                   .
     1605               end.
     1606               else do:
     1607                   assign
     1608                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1609                   .
     1610               end.
     1611               leave replace-cycle.
     1612           end.
     1613           else do:
     1614               assign
     1615                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1616                   v-position      = v-last-position
     1617                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1618               .
     1619               if v-current-char = "#":U
     1620               then do:
     1621                   assign
     1622                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1623                   .
     1624                   if v-last-position > 0
     1625                   then do:
     1626                       run xmlchar-read-integer in this-procedure
     1627                        (
     1628                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1629                           , output v-temp-integer
     1630                           , output v-success
     1631                       ).
     1632                       if v-success = yes
     1633                       and v-temp-integer >= 1
     1634                       and v-temp-integer <= 255
     1635                       then do:
     1636                           assign
     1637                               p-out-string = p-out-string + chr( v-temp-integer )
     1638                               v-position   = v-last-position + 1
     1639                           .
     1640                       end.
     1641                       else do:
     1642                           assign
     1643                               p-out-string = p-out-string + "&":U
     1644                               v-position   = v-position   + 1
     1645                           .
     1646                       end.
     1647                   end.
     1648                   else do:
     1649                       assign
     1650                           p-out-string = p-out-string + "&":U
     1651                           v-position   = v-position   + 1
     1652                       .
     1653                   end.
     1654               end.
     1655               else do:
     1656                   case substring( p-in-string, v-position + 1, 3 )
     1657                   :
     1658                       when "lt;":U
     1659                       then do:
     1660                           assign
     1661                               p-out-string = p-out-string + "<":U
     1662                               v-position   = v-position   + 3
     1663                           .
     1664                       end.
     1665                       when "gt;":U
     1666                       then do:
     1667                           assign
     1668                               p-out-string = p-out-string + ">":U
     1669                               v-position   = v-position   + 3
     1670                           .
     1671                       end.
     1672                       otherwise do:
     1673                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1674                           then do:
     1675                               assign
     1676                                   p-out-string = p-out-string + "&":U
     1677                                   v-position   = v-position   + 4
     1678                               .
     1679                           end.
     1680                           else do:
     1681                               case substring( p-in-string, v-position + 1, 5 )
     1682                               :
     1683                                   when "quot;":U
     1684                                   then do:
     1685                                       assign
     1686                                           p-out-string = p-out-string + '"':U
     1687                                           v-position   = v-position   + 5
     1688                                       .
     1689                                   end.
     1690                                   when "apos;":U
     1691                                   then do:
     1692                                       assign
     1693                                           p-out-string = p-out-string + "'":U
     1694                                           v-position   = v-position   + 5
     1695                                       .
     1696                                   end.
     1697                                   otherwise do:
     1698                                       assign
     1699                                           p-out-string = p-out-string + "&":U
     1700                                       .
     1701                                   end.
     1702                               end case.
     1703                           end.
     1704                       end.
     1705                   end case.
     1706               end.
     1707           end.
     1708       end.
     1709   end.
     1710   end .
     1711   procedure xmlchar-read-integer :
     1712   define input parameter p-input-string      as character        no-undo.
     1713   define output parameter p-output-integer   as integer          no-undo.
     1714   define output parameter p-success       as logical          no-undo.
     1715   do
     1716   on error undo, return error
     1717   :
     1718       assign
     1719           p-output-integer = integer( p-input-string )
     1720       no-error.
     1721       if error-status :error
     1722       then do:
     1723           assign
     1724               p-success           = no
     1725               p-output-integer    = 0
     1726           .
     1727       end.
     1728       else do:
     1729           assign
     1730               p-success           = yes
     1731           .
     1732       end.
     1733   end.
     1734   end.
     1735   define variable v-bgelib-bgeclall           as logical      no-undo.
     1736   define variable v-bgelib-bgedict            as logical      no-undo.
     1737   define temp-table temp_ext-doc-type no-undo
     1738       field edt-key               as integer
     1739       field ext-doc-type          as character
     1740       field ext-doc-type-label    as character
     1741       index pi is primary unique
     1742           edt-key
     1743   .
     1744   define temp-table temp_bgelib_goods no-undo
     1745       field gds-code as integer
     1746       index pi is primary unique
     1747           gds-code
     1748   .
     1749   define temp-table temp_bgelib_clients no-undo
     1750       field obj-type as character
     1751       field obj-code as integer
     1752       index pi is primary unique
     1753           obj-type
     1754           obj-code
     1755   .
     1756   define temp-table temp_bgelib_dis-card no-undo
     1757       field d-card as character
     1758       index pi is primary unique
     1759           d-card
     1760   .
     1761   define temp-table temp_bgelib_trn-doc no-undo
     1762       field doc-code as integer
     1763   .
     1764   procedure bgelib-tag-open:
     1765   do
     1766   on error undo, return error
     1767   :
     1768   define input parameter v-tag-level  as integer      no-undo.
     1769   define input parameter v-tag-name   as character    no-undo.
     1770   define input parameter v-tag-value  as character    no-undo.
     1771       put stream stmXMLOut unformatted
     1772           chr(10)
     1773           + fill(" ", 4 * v-tag-level)
     1774           + "<" + v-tag-name
     1775           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1776           + v-tag-value + ">"
     1777       .
     1778   end.
     1779   end procedure.
     1780   procedure bgelib-tag-put:
     1781   do
     1782   on error undo, return error
     1783   :
     1784   define input parameter v-tag-level      as integer      no-undo.
     1785   define input parameter v-tag-name       as character    no-undo.
     1786   define input parameter v-tag-value      as character    no-undo.
     1787   define input parameter v-empty-mode     as integer      no-undo.
     1788       v-tag-name = trim(v-tag-name).
     1789       if  v-empty-mode = 1
     1790       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1791       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1792       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1793       then do:
     1794           run xmlchar-encode in this-procedure (
     1795                 input v-tag-value
     1796               , output v-tag-value
     1797           ).
     1798           put stream stmXMLOut unformatted
     1799               chr(10) + fill(" ", 4 * v-tag-level)
     1800                           + '<' + v-tag-name + '>'
     1801                           + v-tag-value
     1802                           + '</' + v-tag-name + '>'
     1803           .
     1804       end.
     1805   end.
     1806   end procedure.
     1807   procedure bgelib-tag-close:
     1808   do
     1809   on error undo, return error
     1810   :
     1811   define input parameter v-tag-level as integer      no-undo.
     1812   define input parameter v-tag-name  as character    no-undo.
     1813       put stream stmXMLOut unformatted
     1814           chr(10)
     1815           + fill( " ", 4 * v-tag-level)
     1816           + '</' + v-tag-name + '>'
     1817       .
     1818   end.
     1819   end procedure.
     1820   procedure bgelib-write-log:
     1821   do
     1822   on error undo, return error
     1823   :
     1824   define input parameter v-filename   as character    no-undo.
     1825   define input parameter v-log-level  as integer      no-undo.
     1826   define input parameter v-out-string as character    no-undo.
     1827       output stream stmXMLLog to value( v-filename ) append.
     1828       put stream stmXMLLog unformatted
     1829           chr(10)
     1830       .
     1831       put stream stmXMLLog unformatted
     1832           ( if v-log-level = 0
     1833             or v-out-string = "&DLine"
     1834             or v-out-string = "&Line"
     1835             then ""
     1836             else cur-time-string-sec() + " " )
     1837       .
     1838       put stream stmXMLLog unformatted
     1839           ( if v-out-string = "&Line"
     1840             then fill( "-", 80 )
     1841             else if v-out-string = "&DLine"
     1842                  then fill( "=", 80 )
     1843                  else v-out-string )
     1844       .
     1845       output stream stmXMLLog close.
     1846   end.
     1847   end procedure.
     1848   procedure bgelib-write-edt:
     1849   do
     1850   on error undo, return error
     1851   :
     1852   define input parameter v-editor-handle    as handle       no-undo.
     1853   define input parameter v-log-level        as integer      no-undo.
     1854   define input parameter v-out-string       as character    no-undo.
     1855       if valid-handle ( v-editor-handle )
     1856       then do:
     1857           v-editor-handle :move-to-eof().
     1858           v-editor-handle :insert-string( ( if v-log-level = 0
     1859                                             or v-out-string = "&DLine"
     1860                                             or v-out-string = "&Line"
     1861                                             then ""
     1862                                             else cur-time-string-sec() + " "
     1863                                         ) ).
     1864           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1865                                             then fill( "-", 80 )
     1866                                             else if v-out-string = "&DLine" then fill("=", 80)
     1867                                             else fill( " ", v-log-level) + v-out-string
     1868                                         ) ).
     1869           v-editor-handle :insert-string( chr(10) ).
     1870       end.
     1871       process events.
     1872       output to 'bgescn.txt' append.
     1873           put unformatted
     1874               chr(10)
     1875               string( ( if v-log-level = 0
     1876                         or v-out-string = "&DLine"
     1877                         or v-out-string = "&Line"
     1878                         then ""
     1879                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1880                     ) )
     1881               string( ( if v-out-string = "&Line"
     1882                         then fill( "-", 80 )
     1883                         else if v-out-string = "&DLine"
     1884                              then fill( "=", 80 )
     1885                              else fill( " ", v-log-level ) + v-out-string
     1886                     ) )
     1887           .
     1888       output close.
     1889   end.
     1890   end procedure.
     1891   procedure bgelib-show-cnt:
     1892   do
     1893   on error undo, return error
     1894   :
     1895   define input parameter v-fillin-handle     as handle   no-undo.
     1896       if valid-handle( v-fillin-handle )
     1897       then do:
     1898           assign
     1899               v-fillin-handle :visible = true
     1900           .
     1901       end.
     1902   end.
     1903   end procedure.
     1904   procedure bgelib-hide-cnt:
     1905   do
     1906   on error undo, return error
     1907   :
     1908   define input parameter v-fillin-handle     as handle   no-undo.
     1909       if valid-handle( v-fillin-handle )
     1910       then do:
     1911           assign v-fillin-handle :visible = false.
     1912       end.
     1913   end.
     1914   end procedure.
     1915   procedure bgelib-write-cnt:
     1916   do
     1917   on error undo, return error
     1918   :
     1919   define input parameter v-fillin-handle    as handle       no-undo.
     1920   define input parameter v-fillin-string    as character    no-undo.
     1921       if valid-handle( v-fillin-handle )
     1922       then do:
     1923           assign
     1924               v-fillin-handle :SCREEN-value = v-fillin-string
     1925           .
     1926       end.
     1927   end.
     1928   end procedure.
     1929   procedure bgelib-write-header:
     1930   do
     1931   on error undo, return error
     1932   :
     1933   define input parameter p-first-file     as logical      no-undo.
     1934   define input parameter p-xml-file-name  as character    no-undo.
     1935   define input parameter p-list-file-name as character    no-undo.
     1936   define input parameter p-file-number    as integer      no-undo.
     1937   define input parameter p-have-prev      as logical      no-undo.
     1938   define input parameter p-prev-filename  as character    no-undo.
     1939   define input parameter p-obj-list       as character    no-undo.
     1940   define input parameter p-doc-type-list  as character    no-undo.
     1941   define input parameter p-parameter-list as character    no-undo.
     1942       define variable v-counter    as integer        no-undo.
     1943       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1944       put stream stmXMLOut unformatted
     1945           "<?xml version='1.0' encoding='windows-1251'?>"
     1946       .
     1947       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1948       run bgelib-tag-open( input 0, input "header", input "" ).
     1949       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1950       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1951       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1952       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1953       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1954       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1955       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1956       :
     1957           run bgelib-tag-put(
     1958                 input 1
     1959               , input entry( 2 * v-counter, p-parameter-list )
     1960               , input entry( 2 * v-counter + 1, p-parameter-list )
     1961               , input 0
     1962           ).
     1963       end.
     1964       run bgelib-tag-close( input 0, input "header" ).
     1965       output stream stmXMLOut close.
     1966       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1967       if p-first-file = yes
     1968       then do:
     1969           put stream stmXMLOut unformatted
     1970               "<?xml version='1.0' encoding='windows-1251'?>"
     1971           .
     1972           run bgelib-tag-open( input 0, input "export", input "" ).
     1973       end.
     1974       run bgelib-tag-open( input 1, input "file", input "" ).
     1975       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1976       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1977       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1978       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1979       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1980       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1981       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1982       :
     1983           run bgelib-tag-put(
     1984                 input 2
     1985               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1986               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1987               , input 0
     1988           ).
     1989       end.
     1990       run bgelib-tag-close( input 1, input "file" ).
     1991       output stream stmXMLOut close.
     1992   end.
     1993   end procedure.
     1994   procedure bgelib-write-footer:
     1995   do
     1996   on error undo, return error
     1997   :
     1998   define input parameter p-last-file      as logical      no-undo.
     1999   define input parameter p-xml-file-name  as character    no-undo.
     2000   define input parameter p-list-file-name as character    no-undo.
     2001   define input parameter p-have-next      as logical      no-undo.
     2002   define input parameter p-next-file-name as character    no-undo.
     2003       define variable v-error-num     as integer           no-undo.
     2004       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2005       if p-have-next = yes
     2006       then do:
     2007           run bgelib-tag-open( input 0, input "footer", "" ).
     2008           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2009           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2010           run bgelib-tag-close( input 0, input "footer" ).
     2011       end.
     2012       run bgelib-tag-close( input 0, input "root" ).
     2013       output stream stmXMLOut close.
     2014       run bge/os_copy.p (
     2015             input "M"
     2016           , input p-xml-file-name + "tmp"
     2017           , input p-xml-file-name + "xml"
     2018           , output v-error-num
     2019       ).
     2020       if p-last-file = yes
     2021       then do:
     2022           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2023               run bgelib-tag-close( input 0, input "export" ).
     2024           output stream stmXMLOut close.
     2025           run bge/os_copy.p (
     2026                 input "M"
     2027               , input p-list-file-name + "tmp"
     2028               , input p-list-file-name + "xml"
     2029               , output v-error-num
     2030           ).
     2031       end.
     2032   end.
     2033   end procedure.
     2034   procedure bgelib-filename :
     2035   do
     2036   on error undo, return error
     2037   :
     2038   define input parameter p-prefix             as character    no-undo.
     2039   define output parameter p-xml-file-name     as character    no-undo.
     2040   define output parameter p-log-file-name     as character    no-undo.
     2041   define output parameter p-list-file-name    as character    no-undo.
     2042       define variable v-home-dir  as character    no-undo.
     2043       define variable v-error-num as integer      no-undo.
     2044       get-key-value section "BGE" key "outdir" value v-home-dir.
     2045       if v-home-dir = ?
     2046       then do:
     2047           message
     2048             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2049             skip(1)
     2050             skip "Обратитесь к администратору."
     2051           view-as alert-box error.
     2052           undo, return error .
     2053       end.
     2054       run gbl/dir-cre.p (
     2055           input v-home-dir
     2056       ) no-error.
     2057       if error-status :error
     2058       then do:
     2059           message
     2060             skip "Неверно задан каталог экспорта."
     2061             skip(1)
     2062             skip "Обратитесь к администратору."
     2063           view-as alert-box error.
     2064           undo, return error .
     2065       end.
     2066       run bge/genfname.p (
     2067             input v-home-dir
     2068           , input p-prefix
     2069           , input ""
     2070           , input "xml"
     2071           , input "tmp"
     2072           , output p-xml-file-name
     2073       ).
     2074       assign
     2075           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2076           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2077           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2078       .
     2079   end.
     2080   end procedure.
     2081   procedure bgelib-read-config :
     2082   do
     2083   on error undo, return error
     2084   :
     2085   define variable v-par-type as character     no-undo.
     2086     define variable v-param-type      as character  no-undo .
     2087     define variable v-value-character as character  no-undo .
     2088     define variable v-value-date      as date       no-undo .
     2089     define variable v-value-decimal   as decimal    no-undo .
     2090     define variable v-value-integer   as integer    no-undo .
     2091     define variable v-value-logical   as logical    no-undo .
     2092     define variable v-tth             as handle     no-undo .
     2093       assign
     2094           v-bgelib-bgeclall = no
     2095           v-bgelib-bgedict  = no
     2096       .
     2097       run adm/shattri.p ( input "get":U
     2098                         , input  '':u
     2099                         , input  0
     2100                         , input  'bge-export':U
     2101                         , input  'bgeclall':U
     2102                         , output v-value-character
     2103                         , output v-value-date
     2104                         , output v-value-decimal
     2105                         , output v-value-integer
     2106                         , output v-value-logical
     2107                         , output v-param-type
     2108                         , input-output table-handle v-tth
     2109                         ) no-error .
     2110       if error-status :error
     2111       then do:
     2112         assign
     2113           v-bgelib-bgeclall = no
     2114         .
     2115       end.
     2116       else do:
     2117         assign
     2118           v-bgelib-bgeclall = v-value-logical
     2119         .
     2120       end.
     2121       delete object v-tth.
     2122       run adm/shattri.p ( input "get":U
     2123                         , input  '':u
     2124                         , input  0
     2125                         , input  'bge-export':U
     2126                         , input  'bgedict':U
     2127                         , output v-value-character
     2128                         , output v-value-date
     2129                         , output v-value-decimal
     2130                         , output v-value-integer
     2131                         , output v-value-logical
     2132                         , output v-param-type
     2133                         , input-output table-handle v-tth
     2134                         ) no-error .
     2135       if error-status :error
     2136       then do:
     2137         assign
     2138           v-bgelib-bgedict = no
     2139         .
     2140       end.
     2141       else do:
     2142         assign
     2143           v-bgelib-bgedict = v-value-logical
     2144         .
     2145       end.
     2146       delete object v-tth.
     2147       run adm/shattri.p ( input "get":U
     2148                         , input  '':u
     2149                         , input  0
     2150                         , input  'bge-export':U
     2151                         , input  'bgefmt':U
     2152                         , output v-value-character
     2153                         , output v-value-date
     2154                         , output v-value-decimal
     2155                         , output v-value-integer
     2156                         , output v-value-logical
     2157                         , output v-param-type
     2158                         , input-output table-handle v-tth
     2159                         ) no-error .
     2160       if error-status :error
     2161       then do:
     2162         assign
     2163           v-bgelib-bgefmt  = "xml":U
     2164         .
     2165       end.
     2166       else do:
     2167         assign
     2168           v-bgelib-bgefmt  = v-value-character
     2169         .
     2170       end.
     2171       delete object v-tth.
     2172       run adm/shattri.p ( input "get":U
     2173                         , input  '':u
     2174                         , input  0
     2175                         , input  'bge-export':U
     2176                         , input  'bgeflold':U
     2177                         , output v-value-character
     2178                         , output v-value-date
     2179                         , output v-value-decimal
     2180                         , output v-value-integer
     2181                         , output v-value-logical
     2182                         , output v-param-type
     2183                         , input-output table-handle v-tth
     2184                         ) no-error .
     2185       if error-status :error
     2186       then do:
     2187         assign
     2188           v-bgelib-bgeflold  = "old":U
     2189         .
     2190       end.
     2191       else do:
     2192         assign
     2193           v-bgelib-bgeflold  = v-value-character
     2194         .
     2195       end.
     2196       delete object v-tth.
     2197   end.
     2198   end procedure.
     2199   procedure bgelib-check-file-size :
     2200   do
     2201   on error undo, return error
     2202   :
     2203   define input parameter p-out-filename   as character    no-undo.
     2204   define output parameter p-is-big        as logical      no-undo.
     2205       define variable v-current-position    as integer        no-undo.
     2206       assign
     2207           v-current-position = seek( stmXMLOut )
     2208       .
     2209       if v-current-position / 1024 / 1024  >= 100
     2210       then do:
     2211           assign
     2212               p-is-big = yes
     2213           .
     2214       end.
     2215   end.
     2216   end procedure.
     2217   procedure bgelib-init-ext-doc-type :
     2218       define variable v-counter    as integer      no-undo.
     2219       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2220   do
     2221   for buf_temp_ext-doc-type
     2222   on error undo, return error
     2223   :
     2224       empty temp-table buf_temp_ext-doc-type.
     2225       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2226       :
     2227           create buf_temp_ext-doc-type.
     2228           assign
     2229               buf_temp_ext-doc-type.edt-key               = v-counter
     2230               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2231               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2232           .
     2233       end.
     2234   end.
     2235   end procedure.
     2236   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2237   define variable v-xml-file-name     as character            no-undo.
     2238   define variable v-xml-file-name-path as character            no-undo.
     2239   define variable v-log-file-name     as character            no-undo.
     2240   define variable v-locked            as logical              no-undo.
     2241   define variable v-log-string        as character            no-undo.
     2242   define variable v-oper-num          as integer              no-undo.
     2243   define variable v-obj-list          as character            no-undo.
     2244   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2245   DEF VAR intRep      AS INT NO-UNDO.
     2246   define variable hEDT             AS HANDLE NO-UNDO.
     2247   define variable hCNT             AS HANDLE NO-UNDO.
     2248   procedure xml-cd-write-header:
     2249   do
     2250   on error undo, return error
     2251   :
     2252   define input parameter p-xml-file-name       as character    no-undo.
     2253   define input parameter p-xml-file-name-path  as character    no-undo.
     2254   define input parameter p-doc-name            as character    no-undo.
     2255   define input parameter p-version             as character    no-undo.
     2256   define input parameter p-obj-list            as character    no-undo.
     2257   define input parameter p-correspondent       as character    no-undo .
     2258   define input parameter p-write-header        as logical      no-undo .
     2259   define variable OS-time as character no-undo .
     2260   define variable id as character no-undo .
     2261   define buffer buf_db for ub.db.
     2262   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2263   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2264   assign
     2265   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2266   .
     2267   run bgelib-tag-open in this-procedure (
     2268                                        1
     2269                                       ,p-doc-name
     2270                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2271                                         ).
     2272   if p-write-header then do:
     2273     run bgelib-tag-open(2, "Header","").
     2274     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2275     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2276     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2277     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2278     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2279     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2280     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2281     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2282     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2283     run bgelib-tag-close( 2, "Header" ).
     2284   end.
     2285   output stream stmXMLOut close.
     2286   end.
     2287   end procedure.
     2288   procedure xml-cd-write-footer:
     2289   do
     2290   on error undo, return error
     2291   :
     2292   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2293   define input parameter p-xml-file-name as character    no-undo.
     2294   define input parameter p-doc-name      as character    no-undo .
     2295   define variable v-error-num     as integer           no-undo.
     2296   define variable v-md5-signature as character no-undo .
     2297   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2298   run bgelib-tag-close( 0, p-doc-name ).
     2299   put stream stmXMLOut unformatted skip.
     2300   output stream stmXMLOut close.
     2301   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2302   if v-error-num > 0
     2303   then do:
     2304      return error.
     2305   end.
     2306   if opsys = "unix"
     2307   then do:
     2308       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2309   end.
     2310   end.
     2311   end procedure.
     2312   procedure xml-cd-filename :
     2313   do
     2314   on error undo, return error
     2315   :
     2316   define input parameter  p-out               as character no-undo .
     2317   define output parameter p-xml-file-name     as character    no-undo.
     2318   define output parameter p-xml-file-name-path   as character    no-undo.
     2319   define output parameter p-log-file-name     as character    no-undo.
     2320   define output parameter p-locked            as logical      no-undo.
     2321   define variable v-out as character     no-undo.
     2322   define variable loc#log as logical no-undo .
     2323   define variable BadFlag as logical no-undo .
     2324   define variable fq as integer no-undo .
     2325   define variable v-remote as character no-undo .
     2326   assign
     2327   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2328   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2329   p-log-file-name = p-out + "actions.log"
     2330   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2331   .
     2332   end.
     2333   end procedure.
     2334   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2335   define variable v-date-str as character no-undo .
     2336   assign
     2337   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2338                string(Month(p-date), "99":U) + "-":U +
     2339                string(DAY(p-date), "99":U).
     2340   return v-date-str.
     2341   END FUNCTION.
     2342   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2343   define variable v-date-str as character no-undo .
     2344   assign
     2345   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2346                string(Month(p-date), "99":U) + "-":U +
     2347                string(DAY(p-date), "99":U) + chr(32) +
     2348                string(p-time, "HH:MM:SS").
     2349   return v-date-str.
     2350   END FUNCTION.
     2351   function string-to-date returns date ( input p-string  as character):
     2352     define variable v-date as date no-undo .
     2353     assign
     2354     v-date = date(integer(substring(p-string, 4, 2))
     2355                   ,integer(substring(p-string, 1, 2))
     2356                   ,integer(substring(p-string, 7, 4))
     2357                  ) no-error .
     2358     if error-status:error then return ?.
     2359     return v-date.
     2360   END FUNCTION.
     2361   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2362   define variable v-time as integer no-undo init ?.
     2363   define variable v-dop1 as character no-undo .
     2364   define variable v-dop2 as character no-undo .
     2365   assign
     2366   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2367   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2368   no-error .
     2369   if error-status:error then return ?.
     2370   assign
     2371   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2372             integer(entry(2, v-dop2, ";":U)) * 60 +
     2373             integer(entry(3, v-dop2, ";":U)) no-error .
     2374   return v-time.
     2375   END FUNCTION.
     2376   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2377   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2378   procedure alienini-getkey :
     2379   define input parameter i-filename as char.
     2380   define input parameter i-section as char.
     2381   define input parameter i-key as char.
     2382   define output parameter o-value as char.
     2383   define variable EntryPointer as integer no-undo.
     2384   define variable mem1 as memptr no-undo.
     2385   define variable mem2 as memptr no-undo.
     2386   define variable mem1size as integer no-undo.
     2387   define variable mem2size as integer no-undo.
     2388   define variable ii       as integer    no-undo.
     2389   define variable cbReturnSize  as integer    no-undo.
     2390   assign
     2391   set-size(mem1)  = 4000
     2392   mem1size = 4000.
     2393   if i-key = "" then EntryPointer = 0.
     2394   else do:
     2395     assign
     2396     set-size(mem2) = 128
     2397     mem2size = 128
     2398     EntryPointer = get-pointer-value(mem2)
     2399     put-string(mem2, 1) = i-key.
     2400   end.
     2401   run getprivateprofilestringA
     2402                                 (i-section,
     2403                                  EntryPointer,
     2404                                  "",
     2405                                  get-pointer-value(mem1),
     2406                                  input mem1size,
     2407                                  i-filename,
     2408                                  output cbReturnSize).
     2409   do ii = 1 to cbReturnSize:
     2410     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     2411                  then o-value + ","
     2412                  else o-value + chr(get-byte(mem1, ii)).
     2413   end.
     2414     set-size(mem1) = 0.
     2415     set-size(mem2) = 0.
     2416   end procedure.
     2417   procedure alienini-putkey :
     2418   define input parameter i-filename as char.
     2419   define input parameter i-section as char.
     2420   define input parameter i-key as char.
     2421   define input parameter i-value as char.
     2422   define variable cbReturnSize as integer.
     2423   run writeprivateprofilestringA
     2424                                  (i-section,
     2425                                   i-key,
     2426                                   i-value,
     2427                                   i-filename,
     2428                                   output cbReturnSize ).
     2429   end procedure.
     2430   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     2431     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     2432     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     2433     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     2434     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     2435     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     2436     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     2437     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     2438   END PROCEDURE.
     2439   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     2440     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     2441     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     2442     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     2443     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     2444     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     2445   END PROCEDURE.
