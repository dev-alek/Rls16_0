     4791   _cash-desk:
     4792   FOR EACH ub.cash-desk NO-LOCK WHERE
     4793       ub.cash-desk.db-num = g#db-num and
     4794       ub.cash-desk.obj-code = p-obj-code AND
     4795       ub.cash-desk.cash-on
     4796       BREAK
     4797       By ub.cash-desk.pos-type
     4798       with frame a :
     4799       IF FIRST-OF(ub.cash-desk.pos-type) then
     4800       do:
     4801           v-index = index(p-other, ub.cash-desk.pos-type + '=').
     4802           if v-index > 0 then
     4803           do:
     4804               assign
     4805                   v-spec-command = substring(p-other, v-index)
     4806                   v-index        = index(v-spec-command , chr(4))
     4807                   v-spec-command = if v-index > 0
     4808                           then substring(v-spec-command , 1, v-index - 1)
     4809                           else v-spec-command
     4810                   v-spec-command = replace(v-spec-command, cash-desk.pos-type + '=', '':U)
     4811                   .
     4812           end.
     4813           else
     4814           do:
     4815               v-spec-command = '':U.
     4816           end.
     4817           CASE cash-desk.pos-type:
     4818               when 'IBM-XML':U then
     4819                   do:
     4820                       assign
     4821                           v-cd-prfx    = 'IBM-XML':U
     4822                           v-param-prfx = 'ibm':U
     4823                           .
     4824                   end.
     4825               when 'Autotank':U then
     4826                   do:
     4827                       assign
     4828                           v-cd-prfx    = 'autotank':U
     4829                           v-param-prfx = 'autotank':U
     4830                           .
     4831                   end.
     4832           END CASE.
     4833           CASE cash-desk.pos-type :
     4834               when 'IBM-XML':U
     4835               or
     4836               when 'Autotank':U
     4837               then
     4838                   do:
     4839                       run str/get-inis.p (
     4840                           input p-obj-type
     4841                           , input p-obj-code
     4842                           , input cash-desk.pos-type
     4843                           , input cash-desk.remote
     4844                           , input "get":U
     4845                           , output out
     4846                           , output out2
     4847                           , output in_
     4848                           , output spl
     4849                           , output sav
     4850                           , output v-remote
     4851                           )  no-error .
     4852                       if error-status:error then
     4853                       do:
     4854                           run write-log-and-file in p-log-handle (
     4855                               input 1
     4856                               , input log-file-name
     4857                               , input 1
     4858                               , input substitute(
     4859                               "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     4860                               , cash-desk.pos-type
     4861                               , p-obj-code
     4862                               , chr(10)
     4863                               , error-status:get-message(1)
     4864                               , return-value
     4865                               )).
     4866                           assign
     4867                               v-view-log = yes.
     4868                           if p-auto = 0 then do:
     4869   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4870   if v-view-log
     4871   and not g#news
     4872   and not g#auto
     4873   then do:
     4874     message
     4875     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     4876     "!!!Внимательно прочитайте Log-file!!"
     4877     view-as alert-box error .
     4878        define variable v-user-action22   as character no-undo .
     4879     define variable v-printed22       as logical   no-undo .
     4880     run gbl/prnfilen.w
     4881       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     4882       ,input  0
     4883       ,input  (string("./":U) + 'get-chkf.log')
     4884       ,input  7
     4885       ,output v-user-action22
     4886       ,output v-printed22
     4887       ) .
     4888   end.
     4889   if v-view-log = true
     4890   and (g#news
     4891   or g#auto)
     4892   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     4893   then do:
     4894      run cb_set-view-log in p-parent-handle ( input yes).
     4895   end.
     4896   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     4897     OS-DELETE value(string("./":U) + 'get-chkf.log').
     4898   end.
     4899                           return "error":U.                  end.
     4900             else undo,  return "error".
     4901                       end.
     4902                       if cash-desk.pos-type = 'MAGIA-XML':U then
     4903                       do:
     4904                           assign
     4905                               kassa-rub-code = 0
     4906                               ibmgroup       = no
     4907                               ibmspool       = "3"
     4908                               .
     4909                       end.
     4910                       else
     4911                       do:
     4912                           define variable v-effective-pos-type as character no-undo .
     4913                           v-effective-pos-type =  (if (cash-desk.pos-type = 'IBM':U
     4914                                         or
     4915                                         cash-desk.pos-type = 'Emulator-NKT-IBM':U)
     4916                                     then 'cd-type-ibm':U
     4917                                     else 'cd-type-IBM-XML':U
     4918                                     ).
     4919                           run adm/shattri.p (
     4920                               input "get":U
     4921                               ,input  p-obj-type
     4922                               ,input  p-obj-code
     4923                               ,input  v-effective-pos-type
     4924                               ,input  '':U
     4925                               ,output v-value-character
     4926                               ,output v-value-date
     4927                               ,output v-value-decimal
     4928                               ,output v-value-integer
     4929                               ,output v-value-logical
     4930                               ,output v-param-type
     4931                               ,INPUT-OUTPUT table-handle v-tth
     4932                               ) no-error .
     4933                           IF error-status:error then
     4934                           do:
     4935                               assign
     4936                                   v-mes = substitute(
     4937                                     "Не удалось получить настройки для  POS типа &1 для маг&2"
     4938                                     , cash-desk.pos-type
     4939                                     , p-obj-code).
     4940                               run write-log-and-file in p-log-handle (
     4941                                   input 1
     4942                                   , input log-file-name
     4943                                   , input 1
     4944                                   , input v-mes).
     4945                               v-view-log = yes.
     4946                               undo, return error v-mes.
     4947                           end.
     4948                           for each thbjattr_thbj-attr where
     4949                               thbjattr_thbj-attr.obj-type = p-obj-type
     4950                               and thbjattr_thbj-attr.obj-code = p-obj-code
     4951                               and thbjattr_thbj-attr.upper-prop-code =  v-effective-pos-type
     4952                               on error undo, return error :
     4953                               case thbjattr_thbj-attr.prop-code :
     4954                                   when 'ibmrubc':U then
     4955                                       do:
     4956                                           kassa-rub-code = thbjattr_thbj-attr.property-value-integer.
     4957                                       end.
     4958                                   when 'specgrp':U then
     4959                                       do:
     4960                                           specgrp = thbjattr_thbj-attr.property-value-character.
     4961                                       end.
     4962                                   when 'cash-pay-list':U then
     4963                                       do:
     4964                                       end.
     4965                               end case.
     4966                           end.
     4967                           if cash-desk.pos-type = 'IBM-XML':U
     4968                               and entry(1, v-spec-command) = "version" then
     4969                           do:
     4970                               define variable v-field-list as character no-undo .
     4971                               define variable v-value-list as character no-undo .
     4972                               define variable v-pos-type   as character no-undo .
     4973                               define variable v-cash-num   as integer   no-undo init ?.
     4974                               run gen-key-fv in this-procedure ( input replace(v-spec-command, "version" + chr(44), '')
     4975                                   ,output v-field-list
     4976                                   ,output v-value-list
     4977                                   ).
     4978                               assign
     4979                                   v-pos-type = entry(lookup("pos-type"
     4980                                         , v-field-list
     4981                                         , chr(3))
     4982                                   , v-value-list, chr(3))
     4983                                   v-cash-num = integer(entry(lookup("cash-num"
     4984                                                 , v-field-list
     4985                                                 , chr(3))
     4986                                           , v-value-list, chr(3))).
     4987                           end.
     4988                       end.
     4989                       assign
     4990                           var-found-not-remote = no
     4991                           .
     4992                       run str/get-chk-report.p(parparentproc,
     4993                           p-parent-handle,
     4994                           p-log-handle,
     4995                           log-file-name,
     4996                           p-obj-type,
     4997                           p-obj-code,
     4998                           output v-value-logical) no-error.
     4999                       if error-status:error then
     5000                       do:
     5001                           run write-log-and-file in p-log-handle (
     5002                               input 1
     5003                               , input log-file-name
     5004                               , input 1
     5005                               , input return-value).
     5006                       end.
     5007                   end.
     5008           end.
     5009       end.
     5010   end.
     5011   define variable v-save-file-name as character no-undo .
     5012   v-save-file-name = substitute("&1get-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     5013   if v-view-log and p-auto = 0 then
     5014   do:
     5015       message
     5016           "!!!При получении данных с касс произвошли ошибки!!!" skip
     5017           "По завершении сообщения об ошибках будут сохранены в файле" skip
     5018           v-save-file-name
     5019           view-as alert-box error .
     5020       define variable v-user-action as character no-undo .
     5021       define variable v-printed     as logical   no-undo .
     5022       run gbl/prnfilen.w
     5023           (input  "Ошибки, возникшие при получении данных с касс"
     5024           ,input  0
     5025           ,input  "./get-repf.log":U
     5026           ,input  7
     5027           ,output v-user-action
     5028           ,output v-printed
     5029           ) .
     5030   end.
     5031   run write-log-and-file in p-log-handle (
     5032       input 1
     5033       , input log-file-name
     5034       , input 1
     5035       , input substitute("&1", chr(10))
     5036       ).
     5037   OS-APPEND value(log-file-name) value(v-save-file-name).
     5038   OS-DELETE value(log-file-name).
     5039   if index (log-file-name, "get-repf.log") > 0 then .
     5040   else
     5041   do:
     5042       OS-APPEND value("get-repf.log") value(v-save-file-name).
     5043       OS-DELETE value("get-repf.log").
     5044   end.
