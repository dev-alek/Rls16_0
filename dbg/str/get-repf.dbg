     2505   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     2506   define variable v-is-closed-shift-journal as integer no-undo .
     2507   assign
     2508   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     2509                               +
     2510                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     2511                               +
     2512                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     2513   .
     2514   return v-is-closed-shift-journal.
     2515   END FUNCTION.
     2516   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     2517   define variable v-is-first-journal as logical no-undo .
     2518   assign
     2519   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     2520                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     2521                     or (p-journal-num =  integer(entry(1, '17':U)))
     2522                     or (p-journal-num = integer(entry(1, '16':U)))
     2523   .
     2524   return v-is-first-journal.
     2525   END FUNCTION.
     2526   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     2527   define variable v-is-petrol-journal as logical no-undo .
     2528   assign
     2529   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     2530   return v-is-petrol-journal.
     2531   END FUNCTION.
     2532   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     2533   define variable v-max-record-num as integer no-undo .
     2534   assign
     2535   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     2536                       then 1489
     2537                       else 2340).
     2538   return v-max-record-num.
     2539   END FUNCTION.
     2540   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     2541   define variable v-max-record-num as integer no-undo .
     2542   assign
     2543   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     2544                       then 1489 * num-entries('30,31,32,33':U)
     2545                       else 2340 * num-entries('17':U)).
     2546   return v-max-record-num.
     2547   END FUNCTION.
     2548   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     2549                                           ,input p-rec-no as integer):
     2550   define variable v-num-recs as integer no-undo .
     2551   if tekka-is-petrol-journal (p-journal-num) then do:
     2552     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     2553       assign
     2554       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     2555       .
     2556     end.
     2557     else do:
     2558       assign
     2559       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     2560       .
     2561     end.
     2562   end.
     2563   else do:
     2564     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     2565       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     2566         assign
     2567         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     2568         .
     2569       end.
     2570       else do:
     2571         assign
     2572         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     2573         .
     2574       end.
     2575     end.
     2576     else do:
     2577       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     2578         assign
     2579         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     2580         .
     2581       end.
     2582       else do:
     2583         assign
     2584         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     2585         .
     2586       end.
     2587     end.
     2588   end.
     2589   return v-num-recs.
     2590   END FUNCTION.
     2591   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     2592                                              ,input p-is-petrol as logical
     2593                                              ,input p-is-current as logical
     2594                                              ,output p-rec-no as decimal
     2595                                              ):
     2596   define variable v-obj-num0 as integer no-undo .
     2597   define variable v-obj-num as integer no-undo .
     2598   define variable v-obj-num2 as integer no-undo .
     2599   define variable p-num-recs2 as integer no-undo .
     2600   define variable p-rec-no2 as integer no-undo .
     2601   if p-is-petrol then do:
     2602     assign
     2603     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     2604     .
     2605     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     2606     then
     2607     assign
     2608     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     2609     p-rec-no = p-num-recs modulo 1489
     2610     .
     2611     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     2612     then
     2613     assign
     2614     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     2615     p-rec-no = p-num-recs modulo 1489
     2616     .
     2617   end.
     2618   else do:
     2619     assign
     2620     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     2621     p-num-recs = trunc(p-num-recs, 0)
     2622     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     2623     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     2624     .
     2625     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     2626     then
     2627     assign
     2628     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     2629     p-rec-no = p-num-recs modulo 2340
     2630     .
     2631     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     2632     then
     2633     assign
     2634     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     2635     p-rec-no = p-num-recs modulo 2340
     2636     .
     2637     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     2638     then
     2639     assign
     2640     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     2641     p-rec-no2 = p-num-recs2 modulo 2978
     2642     .
     2643     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     2644     then
     2645     assign
     2646     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     2647     p-rec-no2 = p-num-recs2 modulo 2978
     2648     .
     2649     assign
     2650     p-rec-no = p-rec-no + p-rec-no2 / 10000
     2651     .
     2652   end.
     2653   if v-obj-num = 0 then v-obj-num = 100.
     2654   return v-obj-num.
     2655   END FUNCTION.
     2656   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     2657   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     2658   if lookup (string(p-obj-num), '17':U) > 0 then do:
     2659      if p-is-ptrl then
     2660      return integer(entry(1, '26,27,28,29':U)).
     2661      if not p-is-ptrl then
     2662      return integer(entry(1, '16':U)).
     2663   end.
     2664   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     2665   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     2666   return 0.
     2667   END FUNCTION.
     2668   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     2669   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     2670   if lookup (string(p-obj-num), '17':U) > 0 then do:
     2671     if p-is-ptrl then
     2672     return integer(entry(1, '26,27,28,29':U)).
     2673     if not p-is-ptrl then
     2674     return integer(entry(1, '16':U)).
     2675   end.
     2676   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     2677   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     2678   return 0.
     2679   END FUNCTION.
     2680   PROCEDURE maria-put:
     2681   define parameter buffer buf_cash-desk for ub.cash-desk.
     2682   define input parameter p-out    as character no-undo .
     2683   define input parameter p-fname as character no-undo .
     2684   define input parameter p-by-record as logical no-undo .
     2685   define input parameter p-shift-fields as integer no-undo .
     2686   define input parameter p-binary as logical no-undo .
     2687   define input parameter p-obj-num as integer no-undo .
     2688   define input parameter p-max-records as integer no-undo .
     2689   define input parameter p-plu as integer no-undo .
     2690   define input parameter p-value as character no-undo .
     2691   define variable v-file-name as character no-undo .
     2692   define variable v-create as logical no-undo .
     2693   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2694   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     2695   output stream Dirstream
     2696   to value(v-file-name) append .
     2697   Put  stream Dirstream unformatted
     2698   p-plu
     2699   chr(3)
     2700   p-value
     2701   skip.
     2702   output stream Dirstream
     2703   close.
     2704   if not p-by-record then do:
     2705     find first buf_temp-tekka-tsk where
     2706               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     2707     if not available buf_temp-tekka-tsk then do:
     2708       v-create = yes.
     2709     end.
     2710   end.
     2711   else do:
     2712     find first buf_temp-tekka-tsk where
     2713               buf_temp-tekka-tsk.filename  = v-file-name
     2714           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     2715     if not available buf_temp-tekka-tsk
     2716     then do:
     2717       find first buf_temp-tekka-tsk where
     2718                 buf_temp-tekka-tsk.filename  = v-file-name
     2719             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     2720       if not available buf_temp-tekka-tsk
     2721       then do:
     2722         v-create = yes.
     2723       end.
     2724     end.
     2725   end.
     2726   if v-create then do:
     2727     create buf_temp-tekka-tsk.
     2728     assign
     2729     buf_temp-tekka-tsk.filename = v-file-name
     2730     buf_temp-tekka-tsk.range    = p-plu
     2731     buf_temp-tekka-tsk.obj-num = p-obj-num
     2732     buf_temp-tekka-tsk.obj-name = '':U
     2733     buf_temp-tekka-tsk.num-records = 0
     2734     buf_temp-tekka-tsk.max-records = p-max-records
     2735     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     2736     buf_temp-tekka-tsk.task-num = p-fname
     2737     buf_temp-tekka-tsk.by-record = p-by-record
     2738     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     2739     buf_temp-tekka-tsk.binary = p-binary
     2740     buf_temp-tekka-tsk.send-get = 'send'
     2741     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2742     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2743     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2744     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2745                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2746                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2747                                 then 'local'
     2748                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2749     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2750     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2751     buf_temp-tekka-tsk.waiting-sek = 30
     2752     buf_temp-tekka-tsk.min-plu     = p-plu
     2753     buf_temp-tekka-tsk.max-plu     = p-plu
     2754     .
     2755   end.
     2756   assign
     2757   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     2758   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     2759   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     2760   .
     2761   END PROCEDURE.
     2762   PROCEDURE maria-get:
     2763   define parameter buffer buf_cash-desk for ub.cash-desk.
     2764   define input parameter p-out    as character no-undo .
     2765   define input parameter p-fname as character no-undo .
     2766   define input parameter p-by-record as logical no-undo .
     2767   define input parameter p-obj-num as integer no-undo .
     2768   define input parameter p-num-fields as integer no-undo .
     2769   define input parameter p-max-records as integer no-undo .
     2770   define input parameter p-min-plu as integer no-undo .
     2771   define input parameter p-max-plu as integer no-undo .
     2772   define input parameter p-other as character no-undo .
     2773   define input parameter p-order-num as integer no-undo .
     2774   define variable v-file-name as character no-undo .
     2775   define variable v-secondary-obj-num as character no-undo .
     2776   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2777   if p-by-record then do:
     2778     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     2779   end.
     2780   else do:
     2781     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     2782   end.
     2783   find first buf_temp-tekka-tsk where
     2784             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     2785   if not available buf_temp-tekka-tsk then do:
     2786     create buf_temp-tekka-tsk.
     2787     assign
     2788     buf_temp-tekka-tsk.filename = v-file-name
     2789     buf_temp-tekka-tsk.obj-num = p-obj-num
     2790     buf_temp-tekka-tsk.obj-name = '':U
     2791     buf_temp-tekka-tsk.max-records = p-max-records
     2792     buf_temp-tekka-tsk.num-fields = p-num-fields
     2793     buf_temp-tekka-tsk.task-num = p-fname
     2794     buf_temp-tekka-tsk.by-record = p-by-record
     2795     buf_temp-tekka-tsk.send-get = 'get'
     2796     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2797     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2798     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2799     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2800                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2801                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2802                                   then 'local'
     2803                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2804     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2805     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2806     buf_temp-tekka-tsk.waiting-sek = 30
     2807     buf_temp-tekka-tsk.min-plu     = p-min-plu
     2808     buf_temp-tekka-tsk.max-plu     = p-max-plu
     2809     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     2810                                       and p-max-plu <> ?
     2811                                       then p-max-plu - p-min-plu + 1
     2812                                       else 0)
     2813     buf_temp-tekka-tsk.other-info = p-other
     2814     buf_temp-tekka-tsk.order-num = p-order-num
     2815     .
     2816     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     2817       assign
     2818       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     2819       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     2820       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     2821       no-error
     2822       .
     2823       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     2824     end.
     2825   end.
     2826   END PROCEDURE.
     2827   PROCEDURE maria-task:
     2828   define parameter buffer buf_cash-desk for ub.cash-desk.
     2829   define input parameter p-fname as character no-undo .
     2830   define input parameter p-obj-num-list as character no-undo .
     2831   define input parameter p-parameters as character no-undo .
     2832   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     2833   find first buf_temp-tekka-tsk where
     2834             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     2835   if not available buf_temp-tekka-tsk then do:
     2836     create buf_temp-tekka-tsk.
     2837     assign
     2838     buf_temp-tekka-tsk.filename = ''
     2839     buf_temp-tekka-tsk.range = 1
     2840     buf_temp-tekka-tsk.obj-num = 0
     2841     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     2842     buf_temp-tekka-tsk.task-num = p-fname
     2843     buf_temp-tekka-tsk.by-record = no
     2844     buf_temp-tekka-tsk.send-get = 'task'
     2845     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     2846     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     2847     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     2848     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     2849                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     2850                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     2851                                   then 'local'
     2852                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     2853     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     2854     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     2855     buf_temp-tekka-tsk.waiting-sek = 30
     2856     buf_temp-tekka-tsk.other-info = p-parameters
     2857     buf_temp-tekka-tsk.order-num = 0
     2858     .
     2859   end.
     2860   END PROCEDURE.
     2861   procedure tekkatsk-verify-schema :
     2862   define input parameter p-obj-list as character no-undo .
     2863   define input parameter p-dir-path as character no-undo .
     2864   define variable v-obj-num as integer no-undo .
     2865   define variable v-obj-name as character no-undo .
     2866   define variable v-num-records as integer no-undo .
     2867   define variable v-size_ as integer no-undo .
     2868   define variable v-value as character no-undo .
     2869   define variable ii as integer no-undo .
     2870   define variable jj as integer no-undo .
     2871   define variable ii-ibs as integer no-undo .
     2872   define variable ii-tekka as integer no-undo .
     2873   define variable v-result as character no-undo .
     2874   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     2875   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     2876     do
     2877     on error undo, return error
     2878     :
     2879        for each buf_temp-tekka-schema:
     2880          delete buf_temp-tekka-schema.
     2881        end.
     2882        input from value('tekkasch.d').
     2883        repeat :
     2884          create buf_temp-tekka-schema.
     2885          import buf_temp-tekka-schema.
     2886          assign
     2887          buf_temp-tekka-schema.host = 'IBS'
     2888          ii = ii + 1.
     2889          .
     2890        end.
     2891        input close.
     2892        ii-ibs = ii.
     2893         _ii:
     2894         do ii = 1 to 256:
     2895           if p-obj-list = "ALL"
     2896           or lookup(string(ii), p-obj-list) > 0 then do:
     2897             assign
     2898             v-obj-num = 0
     2899             v-obj-name = ''
     2900             v-num-records = 0
     2901             v-size_ = 0
     2902             .
     2903             run alienini-getkey in this-procedure (
     2904                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2905                                                     ,input ('obj' + string(ii, '999'))
     2906                                                     ,input 'oname'
     2907                                                     ,output v-value) no-error .
     2908             if v-value = ? then next _ii.
     2909             assign
     2910             v-obj-num = ii
     2911             v-obj-name = v-value
     2912             .
     2913             run alienini-getkey in this-procedure (
     2914                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2915                                                     ,input ('obj' + string(ii, '999'))
     2916                                                     ,input 'size'
     2917                                                     ,output v-value) no-error .
     2918             assign
     2919             v-num-records = integer(v-value) no-error  .
     2920             if error-status:error
     2921             or v-num-records = 0 then next _ii.
     2922             run alienini-getkey in this-procedure (
     2923                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2924                                                     ,input 'obj' + string(ii, '999')
     2925                                                     ,input 'f000'
     2926                                                     ,output v-value) no-error .
     2927             assign
     2928             v-size_ = integer(v-value) no-error  .
     2929             if error-status:error
     2930             or v-size_ = 0 then next _ii.
     2931             _jj:
     2932             do jj = 1 to 256:
     2933               run alienini-getkey in this-procedure (
     2934                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2935                                                       ,input 'obj' + string(ii, '999')
     2936                                                       ,input 'f' + string(jj, '999')
     2937                                                       ,output v-value) no-error .
     2938               if v-value = ? then next _ii.
     2939               create buf_temp-tekka-schema.
     2940               assign
     2941               buf_temp-tekka-schema.host = 'tekka'
     2942               buf_temp-tekka-schema.obj-num = v-obj-num
     2943               buf_temp-tekka-schema.obj-name = v-obj-name
     2944               buf_temp-tekka-schema.num-records = v-num-records
     2945               buf_temp-tekka-schema.size_ = v-size_
     2946               buf_temp-tekka-schema.field-num = jj
     2947               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2948               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2949                                                  then entry(2, entry(2, v-value, '#'), ':')
     2950                                                  else '':U)
     2951               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2952               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2953               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2954                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2955               no-error
     2956               .
     2957               if error-status:error then do:
     2958                 delete buf_temp-tekka-schema.
     2959                 next _jj.
     2960               end.
     2961               run alienini-getkey in this-procedure (
     2962                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2963                                                       ,input 'obj' + string(ii, '999') + 'name'
     2964                                                       ,input 'n' + string(jj, '999')
     2965                                                       ,output v-value) no-error .
     2966               if v-value <> ? then
     2967               buf_temp-tekka-schema.field-name = v-value.
     2968             end.
     2969           end.
     2970         end.
     2971         ii-tekka = ii - 1.
     2972        if p-obj-list <> 'ALL' then do:
     2973         if ii-tekka <> ii-ibs then do:
     2974           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2975                                   , ii-ibs
     2976                                   , ii-tekka).
     2977         end.
     2978        end.
     2979        for each buf_temp-tekka-schema where
     2980               buf_temp-tekka-schema.host = 'tekka':
     2981          find first buf2_temp-tekka-schema where
     2982                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2983                AND buf2_temp-tekka-schema.host = 'ibs'
     2984                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2985          if not available buf2_temp-tekka-schema then do:
     2986           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2987                                   , buf_temp-tekka-schema.field-num
     2988                                   , buf_temp-tekka-schema.obj-num).
     2989          end.
     2990          buffer-compare buf_temp-tekka-schema
     2991          to buf2_temp-tekka-schema
     2992          save result in v-result.
     2993          if v-result <> '':U then do:
     2994           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2995                                   , buf_temp-tekka-schema.field-num
     2996                                   , buf_temp-tekka-schema.obj-num).
     2997          end.
     2998        end.
     2999     end.
     3000   end procedure.
     3001   FUNCTION set-Sx returns character (input p-string as character):
     3002   return p-string.
     3003   END FUNCTION.
     3004   FUNCTION get-Sx returns character (input p-string  as character):
     3005   return p-string.
     3006   END FUNCTION.
     3007   FUNCTION set-B returns character (input p-string  as character):
     3008   return chr(integer(p-string)).
     3009   END FUNCTION.
     3010   FUNCTION get-B returns character (input p-string  as character):
     3011   return string(asc(p-string)).
     3012   END FUNCTION.
     3013   FUNCTION set-BF returns character (input p-string  as character):
     3014   define variable v-dopi as integer no-undo .
     3015   define variable ii as integer no-undo .
     3016   do ii = 1 to 8:
     3017     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3018   end.
     3019   return chr(v-dopi).
     3020   END FUNCTION.
     3021   FUNCTION get-BF returns character (input p-string  as character):
     3022   define variable v-dopi as integer no-undo .
     3023   define variable v-dops as character no-undo .
     3024   define variable ii as integer no-undo .
     3025   v-dopi = asc(p-string).
     3026   do ii = 8 to 1 BY -1:
     3027     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3028   end.
     3029   return v-dops.
     3030   END FUNCTION.
     3031   FUNCTION set-BN returns character (input p-string  as character
     3032                                     ,input p-bin-group as character):
     3033   define variable v-dopi as integer no-undo .
     3034   define variable ii as integer no-undo .
     3035   define variable jj as integer no-undo .
     3036   define variable v-grp-nums as integer no-undo .
     3037   define variable v-dopi2 as integer no-undo .
     3038   v-grp-nums = num-entries(p-bin-group).
     3039   do jj = 0 to v-grp-nums - 1:
     3040     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3041     do ii = 1 to 8:
     3042       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3043     end.
     3044   end.
     3045   return chr(v-dopi).
     3046   END FUNCTION.
     3047   FUNCTION get-BN returns character (input p-string  as character
     3048                                     ,input p-bin-group as character):
     3049   define variable v-dopi as integer no-undo .
     3050   define variable v-dops as character no-undo .
     3051   define variable v-grp-nums as integer no-undo .
     3052   define variable ii as integer no-undo .
     3053   define variable jj as integer no-undo .
     3054   v-dopi = asc(p-string).
     3055   v-grp-nums = num-entries(p-bin-group).
     3056   do jj = 1 to v-grp-nums:
     3057   do ii = 8 to 1 BY -1:
     3058     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3059   end.
     3060   end.
     3061   return v-dops.
     3062   END FUNCTION.
     3063   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3064   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3065   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066   procedure gen-key-rec :
     3067     define input  parameter p-tbl-name    as character no-undo.
     3068     define input  parameter p-bh_tbl-name as handle    no-undo.
     3069     define output parameter p-key-rec     as character no-undo.
     3070     do
     3071     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3072     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3073     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3074     :
     3075       define variable fh               as handle    no-undo .
     3076       define variable v-ok             as logical   no-undo .
     3077       define variable v-inform         as character no-undo .
     3078       define variable v-ind            as integer   no-undo .
     3079       define variable v-idx-field-qnty as integer   no-undo .
     3080       if p-tbl-name = ?
     3081         or p-tbl-name = "":U
     3082       then do:
     3083         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     3084       end.
     3085       if not p-bh_tbl-name:available then do:
     3086         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     3087       end.
     3088       assign
     3089         p-key-rec = p-tbl-name
     3090         v-inform  = p-bh_tbl-name:index-information(1)
     3091         v-ind     = 2
     3092       .
     3093       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3094       on error undo, return error
     3095       :
     3096         assign
     3097           v-inform = p-bh_tbl-name:index-information( v-ind )
     3098           v-ind    = v-ind + 1
     3099         .
     3100       end.
     3101       if v-inform = ?
     3102         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3103         or entry( 3, v-inform, ",":U ) <> "1":U
     3104       then do:
     3105         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     3106       end.
     3107       else do:
     3108         assign
     3109           v-idx-field-qnty = num-entries( v-inform ) - 4
     3110         .
     3111         if v-idx-field-qnty < 2 then do:
     3112           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     3113         end.
     3114         do v-ind = 1 to v-idx-field-qnty by 2
     3115         on error undo, return error
     3116         :
     3117           assign
     3118             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3119             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3120           .
     3121         end.
     3122       end.
     3123       if p-key-rec = ? then do:
     3124         assign
     3125           p-key-rec = "":U
     3126         .
     3127         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     3128       end.
     3129     end.
     3130     return.
     3131   end procedure.
     3132   procedure gen-where-keyr-tab :
     3133     define input  parameter i-tableSerach as character no-undo.
     3134     define input  parameter i-tablekey   as character  no-undo.
     3135     define input  parameter p-key-rec    as character  no-undo.
     3136     define input  parameter p-key-handle as handle     no-undo .
     3137     define input  parameter p-db-name    as character  no-undo .
     3138     define input  parameter p-tt-handle  as handle     no-undo .
     3139     define output parameter o-Where      as character  no-undo.
     3140     do
     3141     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3142     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3143     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3144     :
     3145       define variable v-full-tbl-name  as character no-undo .
     3146       define variable bh_tbl-name      as handle    no-undo .
     3147       define variable fh_key           as handle    no-undo .
     3148       define variable fh_search        as handle    no-undo .
     3149       define variable v-field-num      as integer   no-undo .
     3150       define variable v-count-fld      as integer   no-undo .
     3151       define variable v-inform         as character no-undo .
     3152       define variable v-ind            as integer   no-undo .
     3153       define variable v-idx-field-qnty as integer   no-undo .
     3154       define variable v-field-name     as character no-undo .
     3155       define variable v-field-val      as character no-undo .
     3156       define variable v-word-link      as character no-undo .
     3157       define variable vTable           as character no-undo.
     3158       define variable bh_tbl-key       as handle    no-undo .
     3159       assign
     3160         p-key-rec = trim( p-key-rec )
     3161       .
     3162       if p-key-handle <> ? then do:
     3163         if not valid-handle(p-key-handle)
     3164            or p-key-handle:type <> "buffer"
     3165         then do:
     3166           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     3167         end.
     3168         if num-entries( p-key-rec, chr(3) ) > 1
     3169           or p-key-rec = ?
     3170           or p-key-rec = "":U
     3171         then do:
     3172           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     3173         end.
     3174       end.
     3175       else do:
     3176         if p-key-rec = ?
     3177           or p-key-rec = "":U
     3178         then do:
     3179           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     3180         end.
     3181       end.
     3182       assign
     3183         vTable = entry( 1 , p-key-rec, chr(3) )
     3184       .
     3185       if p-tt-handle <> ?
     3186         and ( not valid-handle(p-tt-handle)
     3187               or p-tt-handle:type <> "buffer"
     3188             )
     3189       then do:
     3190         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     3191       end.
     3192       if p-tt-handle = ? then do:
     3193         assign
     3194           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3195         .
     3196         create buffer bh_tbl-name for table v-full-tbl-name .
     3197       end.
     3198       else do:
     3199         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3200       end.
     3201       assign
     3202         v-inform = bh_tbl-name:index-information(1)
     3203         v-ind    = 2
     3204       .
     3205       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3206       on error undo, return error
     3207       :
     3208         assign
     3209           v-inform = bh_tbl-name:index-information( v-ind )
     3210           v-ind    = v-ind + 1
     3211         .
     3212       end.
     3213       if v-inform = ?
     3214         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3215         or entry( 3, v-inform, ",":U ) <> "1":U
     3216       then do:
     3217         delete object bh_tbl-name no-error.
     3218         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     3219       end.
     3220       assign
     3221         v-idx-field-qnty = num-entries( v-inform ) - 4
     3222       .
     3223       if v-idx-field-qnty < 2 then do:
     3224         delete object bh_tbl-name no-error.
     3225         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     3226       end.
     3227       assign
     3228         o-where     = "where":U
     3229         v-word-link = "":U
     3230         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3231         v-count-fld = 0
     3232       .
     3233       if i-tablekey ne "" and i-tablekey ne ?
     3234       then do:
     3235         assign
     3236           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3237         .
     3238         create buffer bh_tbl-key for table v-full-tbl-name .
     3239       end.
     3240       if i-tableSerach ne "" and i-tableSerach ne ?
     3241       then do:
     3242         delete object bh_tbl-name no-error.
     3243         assign
     3244           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3245         .
     3246         create buffer bh_tbl-name for table v-full-tbl-name .
     3247       end.
     3248       block_where:
     3249       do v-ind = 1 to v-idx-field-qnty by 2
     3250       on error undo, return error
     3251       :
     3252         assign
     3253           v-count-fld = v-count-fld + 1
     3254         .
     3255         if p-key-handle = ?
     3256           and v-count-fld > v-field-num
     3257         then do:
     3258           leave block_where.
     3259         end.
     3260         define variable VfieldKeyTable as handle no-undo.
     3261         assign
     3262           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3263           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3264         .
     3265         if     bh_tbl-key ne ?
     3266         then do:
     3267            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3268            if VfieldKeyTable eq ?
     3269            then next block_where.
     3270         end.
     3271         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3272         then
     3273            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3274         else
     3275            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3276         if p-key-handle = ? then do:
     3277           assign
     3278             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3279           .
     3280         end.
     3281         else do:
     3282           assign
     3283             fh_key = p-key-handle:buffer-field( v-field-name )
     3284           .
     3285           if fh_key = ?
     3286             or not valid-handle( fh_key )
     3287           then do:
     3288             delete object bh_tbl-name.
     3289             if     bh_tbl-key ne ?
     3290             then
     3291                delete object bh_tbl-key.
     3292             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     3293           end.
     3294           assign
     3295             v-field-val = fh_key:buffer-value
     3296           .
     3297         end.
     3298         if fh_search:data-type ="character":U then do:
     3299           assign
     3300             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3301             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3302             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3303             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3304             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3305             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3306             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3307             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3308             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3309             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3310             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3311             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3312             v-field-val = substitute( '"&1"', v-field-val )
     3313           .
     3314         end.
     3315         assign
     3316           o-where = substitute( "&1 &2", o-where, v-field-val )
     3317         .
     3318         if v-word-link = "":U then do:
     3319           assign
     3320             v-word-link = "and":U
     3321           .
     3322         end.
     3323       end.
     3324       delete object bh_tbl-name.
     3325       if     bh_tbl-key ne ?
     3326       then
     3327          delete object bh_tbl-key.
     3328       if p-key-handle = ?
     3329         and v-count-fld <> v-field-num
     3330       then do:
     3331         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     3332       end.
     3333     end.
     3334   end procedure.
     3335   procedure gen-hn-keyr-tab :
     3336     define input  parameter i-tableSerach as character no-undo.
     3337     define input  parameter i-tablekey   as character no-undo.
     3338     define input  parameter p-key-rec    as character no-undo.
     3339     define input  parameter p-key-handle as handle    no-undo .
     3340     define input  parameter p-db-name    as character no-undo .
     3341     define input  parameter p-tt-handle  as handle    no-undo .
     3342     define input  parameter p-stts-lock  as integer   no-undo .
     3343     define output parameter o-hn         as handle    no-undo.
     3344     define variable v-full-tbl-name as character no-undo.
     3345     define variable v-where         as character no-undo.
     3346     define variable bh_tbl-name     as handle    no-undo.
     3347     define variable vTable          as character no-undo.
     3348     do
     3349     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3350     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3351     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3352         run gen-where-keyr-tab(i-tableSerach,
     3353                                i-tablekey,
     3354                                p-key-rec,
     3355                                p-key-handle,
     3356                                p-db-name,
     3357                                p-tt-handle,
     3358                                output v-where).
     3359         if i-tableSerach ne "" and i-tableSerach ne ?
     3360         then do:
     3361            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3362            create buffer bh_tbl-name for table v-full-tbl-name .
     3363         end.
     3364         else do:
     3365            if p-tt-handle = ? then do:
     3366               assign
     3367                  vTable = entry( 1 , p-key-rec, chr(3) )
     3368               .
     3369               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3370               create buffer bh_tbl-name for table v-full-tbl-name .
     3371            end.
     3372            else do:
     3373               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3374            end.
     3375         end.
     3376         if p-tt-handle = ? then do:
     3377            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3378         end.
     3379         else do:
     3380            bh_tbl-name:find-first( v-where ) no-error .
     3381         end.
     3382         o-hn = bh_tbl-name.
     3383      end.
     3384   end procedure.
     3385   procedure gen-hn-keyr :
     3386     define input  parameter p-key-rec    as character no-undo.
     3387     define input  parameter p-key-handle as handle    no-undo .
     3388     define input  parameter p-db-name    as character no-undo .
     3389     define input  parameter p-tt-handle  as handle    no-undo .
     3390     define input  parameter p-stts-lock  as integer   no-undo .
     3391     define output parameter o-hn         as handle    no-undo.
     3392     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3393   end.
     3394   procedure gen-row-keyr :
     3395     define input  parameter p-key-rec    as character no-undo.
     3396     define input  parameter p-key-handle as handle    no-undo .
     3397     define input  parameter p-db-name    as character no-undo .
     3398     define input  parameter p-tt-handle  as handle    no-undo .
     3399     define input  parameter p-stts-lock  as integer   no-undo .
     3400     define output parameter p-tbl-row    as rowid     no-undo.
     3401     define output parameter p-tbl-name   as character no-undo.
     3402     define variable vHn as handle no-undo.
     3403       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3404       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3405       p-tbl-name =  vHn:table.
     3406       delete object vHn no-error.
     3407     if p-tbl-row = ? then do:
     3408       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     3409     end.
     3410     else do:
     3411       return.
     3412     end.
     3413   end procedure.
     3414   procedure gen-key-fv :
     3415     define input  parameter p-key-rec    as character no-undo .
     3416     define output parameter p-field-list as character no-undo .
     3417     define output parameter p-value-list as character no-undo.
     3418     do
     3419     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3420     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3421     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3422     :
     3423       define variable v-full-tbl-name  as character no-undo .
     3424       define variable bh_tbl-name      as handle    no-undo .
     3425       define variable v-tbl-name       as character no-undo .
     3426       define variable v-field-num      as integer   no-undo .
     3427       define variable v-count-fld      as integer   no-undo .
     3428       define variable v-inform         as character no-undo .
     3429       define variable v-ind            as integer   no-undo .
     3430       define variable v-idx-field-qnty as integer   no-undo .
     3431       define variable v-delim-key      as character no-undo .
     3432       if p-key-rec = ?
     3433         or p-key-rec = "":U
     3434       then do:
     3435         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     3436       end.
     3437       assign
     3438         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3439         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3440       .
     3441       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3442       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     3443       assign
     3444         v-inform = bh_tbl-name:index-information(1)
     3445         v-ind    = 2
     3446       .
     3447       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3448       on error undo, return error
     3449       :
     3450         assign
     3451           v-inform = bh_tbl-name:index-information( v-ind )
     3452           v-ind    = v-ind + 1
     3453         .
     3454       end.
     3455       if v-inform = ?
     3456         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3457         or entry( 3, v-inform, ",":U ) <> "1":U
     3458       then do:
     3459         delete object bh_tbl-name no-error.
     3460         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     3461       end.
     3462       assign
     3463         v-idx-field-qnty = num-entries( v-inform ) - 4
     3464       .
     3465       if v-idx-field-qnty < 2 then do:
     3466         delete object bh_tbl-name no-error.
     3467         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     3468       end.
     3469       assign
     3470         p-field-list = "":U
     3471         p-value-list = "":U
     3472         v-delim-key  = "":U
     3473         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3474         v-count-fld  = 0
     3475       .
     3476       block_where:
     3477       do v-ind = 1 to v-idx-field-qnty by 2
     3478       on error undo, return error
     3479       :
     3480         assign
     3481           v-count-fld = v-count-fld + 1
     3482         .
     3483         if v-count-fld > v-field-num then do:
     3484           leave block_where.
     3485         end.
     3486         assign
     3487           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3488           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3489         .
     3490         if v-ind = 1 then do:
     3491           assign
     3492             v-delim-key = chr(3)
     3493           .
     3494         end.
     3495       end.
     3496       delete object bh_tbl-name.
     3497       if v-count-fld <> v-field-num then do:
     3498         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     3499       end.
     3500     end.
     3501   end procedure.
     3502   procedure gen-key-field :
     3503     define input  parameter p-table      as character no-undo .
     3504     define output parameter p-field-list as character no-undo .
     3505     do
     3506     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3507     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3508     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3509     :
     3510       define variable v-full-tbl-name  as character no-undo .
     3511       define variable bh_tbl-name      as handle    no-undo .
     3512       define variable v-tbl-name       as character no-undo .
     3513       define variable v-field-num      as integer   no-undo .
     3514       define variable v-count-fld      as integer   no-undo .
     3515       define variable v-inform         as character no-undo .
     3516       define variable v-ind            as integer   no-undo .
     3517       define variable v-idx-field-qnty as integer   no-undo .
     3518       define variable v-delim-key      as character no-undo .
     3519       if p-table = ?
     3520         or p-table = "":U
     3521       then do:
     3522         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     3523       end.
     3524       assign
     3525         v-tbl-name      = p-table
     3526         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3527       .
     3528       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3529       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     3530       assign
     3531         v-inform = bh_tbl-name:index-information(1)
     3532         v-ind    = 2
     3533       .
     3534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3535       on error undo, return error
     3536       :
     3537         assign
     3538           v-inform = bh_tbl-name:index-information( v-ind )
     3539           v-ind    = v-ind + 1
     3540         .
     3541       end.
     3542       if v-inform = ?
     3543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3544         or entry( 3, v-inform, ",":U ) <> "1":U
     3545       then do:
     3546         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     3547       end.
     3548       assign
     3549         v-idx-field-qnty = num-entries( v-inform ) - 4
     3550       .
     3551       if v-idx-field-qnty < 2 then do:
     3552         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     3553       end.
     3554       assign
     3555         p-field-list = "":U
     3556         v-delim-key  = "":U
     3557         v-count-fld  = 0
     3558       .
     3559       block_where:
     3560       do v-ind = 1 to v-idx-field-qnty by 2
     3561       on error undo, return error
     3562       :
     3563         assign
     3564           v-count-fld = v-count-fld + 1
     3565         .
     3566         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3567         if v-ind = 1 then do:
     3568           assign
     3569             v-delim-key = chr(3)
     3570           .
     3571         end.
     3572       end.
     3573       delete object bh_tbl-name.
     3574     end.
     3575   end procedure.
     3576   define variable vss-revision12    as character no-undo init "$Revision:$":U .
     3577   define variable vss-author12      as character no-undo init "$Author:$":U .
     3578   define variable vss-date12        as character no-undo init "$Date:$":U .
     3579   define variable vss-workfile12    as character no-undo init "$Workfile:$":U .
     3580   define variable vss-archive12     as character no-undo init "$Archive:$":U .
     3581   define variable vss-description12 as character no-undo init "Работа С сокетом".
     3582   procedure PutMesAsunc:
     3583       define input  parameter Itext as character no-undo.
     3584       define variable vflag as logical no-undo.
     3585       Publish "WriteLogAsunc" (Itext, yes)  .
     3586   end.
     3587   procedure PutMesAsuncNoTime:
     3588       define input  parameter Itext as character no-undo.
     3589       define variable vflag as logical no-undo.
     3590       Publish "WriteLogAsunc" (Itext,no)  .
     3591   end.
     3592   procedure PutStatAsunc:
     3593       define input  parameter Itext as character no-undo.
     3594       Publish "PutStatAsunc" (Itext,no) .
     3595        run
     3596       PutMesAsunc (itext).
     3597   end.
     3598   procedure PutStatAsuncNoTime:
     3599       define input  parameter Itext as character no-undo.
     3600       Publish "PutStatAsunc" (Itext,no)  .
     3601        run
     3602       PutMesAsuncNoTime (itext).
     3603   end.
     3604   procedure PutStatAsuncAdd:
     3605       define input  parameter Itext as character no-undo.
     3606       Publish "PutStatAsunc" (Itext,yes)  .
     3607   end.
     3608   procedure PutFileLogAsunc:
     3609       define input  parameter IFile as character no-undo.
     3610       Publish "PutFileLogAsunc" (ifile)  .
     3611   end.
     3612   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3613   define variable v-waitfram-action01         as character   no-undo .
     3614   define variable v-waitfram-action02         as character   no-undo .
     3615   define variable v-waitfram-action03         as character   no-undo .
     3616   define variable mWaitFramTextBeg            as character   no-undo.
     3617   define variable mWaitFramTextEnd            as character   no-undo.
     3618   define variable mWaitFramView               as logical     no-undo.
     3619   define variable mWaitProcEvent              as logical     no-undo init yes.
     3620   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3621   define variable mWaitFramStop               as logical     no-undo.
     3622   define variable mWaitFramStopUser           as logical     no-undo.
     3623   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3624   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3625   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3626   define button B-WaitFramStop auto-end-key
     3627        label "Стоп"
     3628        size 10 by 1 tooltip "Остоновить процесс".
     3629   define button B-viewProcInfo
     3630        label "Информация"
     3631        size 15 by 1 tooltip "Информация о процесс".
     3632   define frame waitfram
     3633     v-waitfram-action01 format "x(72)" no-label skip
     3634     v-waitfram-action02 format "x(72)" no-label skip
     3635     v-waitfram-action03 format "x(72)" no-label skip
     3636     B-viewProcInfo
     3637     B-WaitFramStop at row 4 col 30
     3638     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3639     .
     3640   define new global shared variable mBatchMode as logical no-undo init ?.
     3641   define variable mFramBachModHandle as handle no-undo.
     3642   mFramBachModHandle = frame waitfram:handle.
     3643   define variable mFameOldVis as logical no-undo.
     3644   define variable mVisCUrentVin as logical no-undo.
     3645   if session:batch-mode
     3646   then
     3647      mBatchMode = yes.
     3648   if mBatchMode = ? then do:
     3649     mVisCUrentVin = current-window:visible.
     3650     mFameOldVis = mFramBachModHandle:visible.
     3651     mFramBachModHandle:visible  = yes.
     3652     mBatchMode = mFramBachModHandle:visible ne yes.
     3653     mFramBachModHandle:visible = mFameOldVis.
     3654     current-window:visible = mVisCUrentVin.
     3655   end.
     3656    if  log-manager:logfile-name ne ?
     3657     then DO:
     3658         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3659         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3660         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3661     end.
     3662   on choose of B-WaitFramStop in frame waitfram
     3663   do:
     3664     mWaitFramStop = yes.
     3665     mWaitFramStopUser = yes.
     3666   end.
     3667   function waitfram-check-timeout returns logical():
     3668      define variable vtime as int64 no-undo.
     3669      if mWaitFramStopTimeOut
     3670      then
     3671         return yes.
     3672      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3673      if     mWaitFramTimeOut ne ?
     3674         and mWaitFramTimeOut ne 0
     3675         and mWaitFramTimeOut lt vtime
     3676      then do:
     3677         mWaitFramStopTimeOut = yes.
     3678      end.
     3679      return mWaitFramStopTimeOut.
     3680   end.
     3681   procedure waitfram-hide :
     3682     if not session:batch-mode
     3683     then do
     3684     on error undo, return error return-value
     3685     :
     3686       pause 0 before-hide .
     3687       if not mBatchMode then
     3688         hide frame waitfram .
     3689     if     not mWaitFramView
     3690        and mWaitProcEvent
     3691     then
     3692       process events .
     3693     end.
     3694   end procedure.
     3695   procedure waitfram-show :
     3696     define input  parameter p-message as character no-undo .
     3697     define variable v-left-margin as integer   no-undo .
     3698     if not session:batch-mode
     3699     then do
     3700     on error undo, return error return-value
     3701     :
     3702       if length(p-message) <= 70 then do:
     3703         assign
     3704           v-left-margin = integer((70 - length(p-message)) / 2)
     3705         .
     3706         assign
     3707           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3708         .
     3709         assign
     3710           v-waitfram-action01 = " "
     3711           v-waitfram-action02 = " "
     3712                                    + fill(" ", v-left-margin)
     3713                                    + p-message
     3714           v-waitfram-action03 = " "
     3715         .
     3716       end.
     3717       else do:
     3718         define variable vRindex1 as integer no-undo.
     3719         define variable vRindex2 as integer no-undo.
     3720         vRindex1 = r-index(p-message," ",70).
     3721         if vRindex1 = 0
     3722         then
     3723            vRindex1 = 70.
     3724         if length(p-message)  <= vRindex1 + 70 then do:
     3725           assign
     3726             v-waitfram-action01 = " "
     3727             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3728             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3729           .
     3730         end.
     3731         else do:
     3732           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3733           if vRindex2 <= vRindex1
     3734           then
     3735              vRindex2 = vRindex1 + 70.
     3736           assign
     3737             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3738             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3739             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3740           .
     3741         end.
     3742       end.
     3743       B-viewProcInfo:visible   in frame waitfram = no.
     3744       B-viewProcInfo:sensitive in frame waitfram = no.
     3745       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3746       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3747       if  (   mWaitFramView
     3748          or  mWaitProcEvent)
     3749          and not mBatchMode
     3750       then
     3751          display
     3752             v-waitfram-action01 skip
     3753             v-waitfram-action02 skip
     3754             v-waitfram-action03 skip
     3755          with frame waitfram .
     3756       if     mWaitFramView
     3757          then do:
     3758             if     mWaitFramInterval ne ?
     3759                and not mBatchMode
     3760             then
     3761                wait-for go of frame waitfram pause mWaitFramInterval.
     3762          end.
     3763          else
     3764             if     mWaitProcEvent
     3765                and not mBatchMode
     3766             then
     3767                process events .
     3768     end.
     3769   end procedure.
     3770      procedure waitfram-show-this:
     3771         define input  parameter iInterval as int64 no-undo.
     3772         define variable vtime as int64 no-undo.
     3773         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3774         mWaitFramInterval = iInterval.
     3775         run waitfram-show (substitute("&1&2 &3&4" ,
     3776                                       mWaitFramTextBeg ,
     3777                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3778                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3779                                       mWaitFramTextEnd
     3780                                      )
     3781                           ).
     3782      end.
     3783      procedure WaitFramRunPause:
     3784         define input  parameter iInterval as dec no-undo.
     3785         define variable vStart  as datetime-tz no-undo.
     3786         define variable vend    as datetime-tz no-undo.
     3787         define variable vint as int64 no-undo.
     3788         define variable vOk as logical no-undo.
     3789         vStart = now.
     3790         vend   = vStart.
     3791         publish "WaitFramPause" (iInterval,output vOk).
     3792         vend   =  now.
     3793         vint = vend - vStart.
     3794         vint = iInterval - vint / 1000.
     3795         if     not mWaitFramStop
     3796            and (   vint > 0
     3797                 or (    not vOk
     3798                     and iInterval eq ?
     3799                     )
     3800                 )
     3801         then
     3802            run waitfram-show-this (iInterval).
     3803         vend   =  now.
     3804         vint = vend - vStart.
     3805         vint = iInterval - vint / 1000.
     3806         if     not mWaitFramStop
     3807            and vint > 0
     3808         then do:
     3809            run gbl/pause.p (vint * 1000).
     3810         end.
     3811         if iInterval ne ?
     3812         then
     3813            publish "WaitFramStop".
     3814         waitfram-check-timeout().
     3815      end.
     3816      procedure WaitFramWaitFor:
     3817         define input  parameter iInterval as dec no-undo.
     3818         assign
     3819            mWaitFramStartProc   = now
     3820            mWaitFramStopUser    = no
     3821            mWaitFramStopTimeOut = no
     3822         .
     3823         block-wait:
     3824         do while not mWaitFramStop:
     3825            run WaitFramRunPause (iInterval).
     3826            if  waitfram-check-timeout()
     3827            then do:
     3828               leave block-wait.
     3829            end.
     3830         end.
     3831         run waitfram-hide.
     3832      end.
     3833   procedure waitfram-join :
     3834     define input  parameter p-line-1  as character no-undo .
     3835     define input  parameter p-line-2  as character no-undo .
     3836     define input  parameter p-line-3  as character no-undo .
     3837     define output parameter p-message as character no-undo .
     3838     do
     3839     on error undo, return error return-value
     3840     :
     3841       assign
     3842         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3843                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3844                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3845       .
     3846     end.
     3847   end procedure.
     3848   function waitfram-join-function returns character
     3849     (input p-line-1 as character
     3850     ,input p-line-2 as character
     3851     ,input p-line-3 as character
     3852     ).
     3853     define variable v-message as character no-undo .
     3854     run waitfram-join in this-procedure
     3855       (input  p-line-1
     3856       ,input  p-line-2
     3857       ,input  p-line-3
     3858       ,output v-message
     3859       ) .
     3860     return v-message .
     3861   end function .
     3862   define variable mHSocket       as handle      no-undo.
     3863   define variable mWebRespHead   as longchar    no-undo.
     3864   define variable mWebResp       as longchar    no-undo.
     3865   define variable mWebRespMptr   as memptr      no-undo.
     3866   define variable OerrMsg        as character   no-undo.
     3867   define variable mFileLogSocet  as character   no-undo.
     3868   define variable mReturnHttp    as logical     no-undo.
     3869   define variable mAddTimeOut    as logical     no-undo init yes.
     3870   define variable mSocetBegTime  as datetime-tz no-undo.
     3871   define variable mSocetEndTime  as dec         no-undo.
     3872   define variable mWriteRespFile as character   no-undo.
     3873   define variable mTypeResponse  as character   no-undo init "POST".
     3874   publish "getSocetLog" (output mFileLogSocet).
     3875   if
     3876      (   mFileLogSocet eq ""
     3877       or mFileLogSocet eq ?)
     3878      and session:debug-alert
     3879   then
     3880      mFileLogSocet = "socet.log".
     3881   procedure ConectSocet:
     3882      define input  parameter iHost       as character no-undo.
     3883      define input  parameter iPort       as character no-undo.
     3884      define input  parameter iUrl        as character no-undo.
     3885      define input  parameter iPostData   as longchar  no-undo.
     3886      define input  parameter iReturnType as character no-undo.
     3887      define input  parameter iTimeOut    as decimal   no-undo.
     3888      define input  parameter iSilent     as logical   no-undo.
     3889      define input  parameter iTextWait   as character no-undo.
     3890      mWaitFramTextBeg = iTextWait.
     3891      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     3892      if OerrMsg eq ""
     3893      then
     3894         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     3895      mSocetEndTime = (now - mSocetBegTime) / 1000.
     3896   end.
     3897   procedure SendReqSocet:
     3898      define input  parameter iHost            as character no-undo.
     3899      define input  parameter iPort            as character no-undo.
     3900      define input  parameter iUrl             as character no-undo.
     3901      define input  parameter iPostData        as longchar  no-undo.
     3902      define input  parameter iReturnType      as character no-undo.
     3903      define input  parameter iProcGetResponse as character no-undo.
     3904      mSocetBegTime = now.
     3905      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3906      assign
     3907         mWebResp         = ""
     3908         mWebResphead     = ""
     3909         OerrMsg          = ""
     3910         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     3911         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     3912      .
     3913      define variable vPostData as longchar                       no-undo.
     3914      if    iHost eq ""
     3915         or iHost eq ?
     3916      then do:
     3917         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     3918         run writeLogSocet in this-procedure (oErrMsg).
     3919         return oErrMsg.
     3920      end.
     3921      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3922      create socket mHSocket.
     3923      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     3924      if mHSocket:connected() = false
     3925      then do:
     3926         run waitfram-hide .
     3927         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     3928         run writeLogSocet in this-procedure (oErrMsg).
     3929         delete object mHSocket.
     3930         return oErrMsg.
     3931      end.
     3932      run waitfram-show ("Отправка данных").
     3933      mHSocket:set-read-response-procedure(iProcGetResponse).
     3934      run PostRequest (
     3935       input iUrl,
     3936       input iHost + ":" + iPort,
     3937       input iPostData
     3938       ).
     3939       run waitfram-hide .
     3940   end.
     3941   procedure WaitRespSocet:
     3942      define input  parameter iTimeOut   as decimal   no-undo.
     3943      define input  parameter iSilent    as logical   no-undo.
     3944      define input  parameter iTextWait  as character no-undo.
     3945      if    not valid-handle (mHSocket )
     3946      then do:
     3947         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     3948         return "End connected".
     3949      end.
     3950      if mHSocket:connected() = false
     3951      then do:
     3952         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     3953         oErrMsg = "Not connected".
     3954         return oErrMsg.
     3955      end.
     3956      mWaitFramView = if iSilent ne yes then yes else no.
     3957      mWaitFramTextBeg = iTextWait.
     3958      mWaitFramTimeOut = iTimeOut.
     3959      mWaitFramTextEnd = "".
     3960      mWaitFramStop = no.
     3961      if mAddTimeOut
     3962      then do:
     3963         mWaitFramTimeOut = 300.
     3964         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     3965      end.
     3966      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     3967      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     3968      run WaitFramWaitFor(1).
     3969      unsubscribe "WaitFramStop".
     3970      if mWaitFramStopUser
     3971      then do:
     3972         OerrMsg = substitute("Операция прервана пользователем." ).
     3973         run writeLogSocet in this-procedure (OerrMsg).
     3974      end.
     3975      else if mWaitFramStopTimeOut
     3976      then do:
     3977         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     3978         run writeLogSocet in this-procedure (OerrMsg).
     3979      end.
     3980      run waitfram-hide .
     3981      mHSocket:disconnect() no-error.
     3982      delete object mHSocket.
     3983   end.
     3984   procedure WaitRespTestStop:
     3985      if mWaitFramStopTimeOut
     3986      then
     3987         return.
     3988      if     (mWebResp ne ""
     3989          and mWebResp ne ?)
     3990      then do:
     3991         mWaitFramStop = yes.
     3992         return.
     3993      end.
     3994      else if mHSocket:connected() = false
     3995      then do:
     3996         mWaitFramStop = yes.
     3997         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     3998         oErrMsg = "Not connected".
     3999         return oErrMsg.
     4000      end.
     4001      wait-for read-response of mHSocket pause 0.001.
     4002   end.
     4003   procedure PostRequest:
     4004      define input parameter iPostUrl  as char.
     4005      define input parameter iPostHost as char.
     4006      define input parameter iPostData as longchar.
     4007      define variable vCRequest      as longchar.
     4008      define variable vMRequest       as memptr.
     4009      if iPostUrl ne ?
     4010      then do:
     4011         vCRequest =substitute(
     4012         '&5 /&2 HTTP/1.1&1'                                   +
     4013         'Host: &4&1'                                           +
     4014         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     4015         'Accept: */*&1' +
     4016         'Content-Type: text/xml&1'               +
     4017         'Content-Length: &3&1'                                  +
     4018         '&1'
     4019         ,
     4020         chr(13) + chr(10),
     4021         iPostUrl,
     4022         length(iPostData),
     4023         iPostHost,
     4024         mTypeResponse) + iPostData.
     4025      end.
     4026      else
     4027         vCRequest = iPostData.
     4028      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     4029      run writeLogSocet in this-procedure (vCRequest).
     4030      SET-SIZE(vMRequest)            = 0.
     4031      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     4032      SET-BYTE-ORDER(vMRequest)      = big-endian.
     4033      PUT-STRING(vMRequest,1)        = vCRequest .
     4034      if mHSocket:connected() = false then
     4035      do:
     4036         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     4037         oErrMsg = "Not connected".
     4038         delete object mHSocket no-error.
     4039         return oErrMsg.
     4040      end.
     4041      mHSocket:write(vMRequest, 1, length(vCRequest)).
     4042      run writeLogSocet in this-procedure ("Запрос отправлен.").
     4043   end procedure.
     4044   function hex-to-int returns integer (
     4045     input p-hex-code  as character  ).
     4046     define variable v-int-code as integer   no-undo .
     4047     define variable v-ind      as integer   no-undo .
     4048     define variable v-digit    as integer   no-undo .
     4049     define variable v-letter   as character no-undo .
     4050     do v-ind = 1 to length(p-hex-code)
     4051     :
     4052       assign
     4053         v-letter = caps(substring(p-hex-code, v-ind, 1))
     4054       .
     4055       assign
     4056         v-digit = index('123456789ABCDEF':u, v-letter)
     4057       .
     4058       assign
     4059         v-int-code = v-int-code * 16 + v-digit
     4060       .
     4061     end.
     4062     return v-int-code .
     4063   end function .
     4064   procedure getResponse:
     4065      define variable vFlagTag     as logical          no-undo init no.
     4066      define variable vResponse    as memptr           no-undo.
     4067      define variable vCnt         as int64            no-undo.
     4068      define variable vMessage     as longchar         no-undo.
     4069      define variable v-cont-length as int64 no-undo.
     4070      define variable vi           as integer no-undo.
     4071      define variable v-hd-line    as character no-undo.
     4072      define variable level        as integer no-undo initial 2.
     4073      repeat while program-name(level) <> ?:
     4074        if program-name(level) = program-name(1) then do:
     4075          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     4076          return "".
     4077        end.
     4078        level = level + 1.
     4079      end.
     4080      if mHSocket:connected() = false then
     4081      do:
     4082         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     4083         oErrMsg = "Not connected".
     4084         return oErrMsg.
     4085      end.
     4086      if mAddTimeOut
     4087      then do:
     4088         mWaitFramTimeOut = 1000.
     4089         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     4090      end.
     4091      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     4092      mWaitFramTextEnd = "Получаем ответ".
     4093      define variable vWaitProcEvent as logical no-undo.
     4094      vWaitProcEvent = mWaitProcEvent.
     4095      mWaitProcEvent = no.
     4096      run WaitFramRunPause (?).
     4097      define variable vByte as int64 no-undo.
     4098      define variable vNextMese as int64 no-undo init 100000.
     4099      define variable VFlag as logical no-undo init ? .
     4100      mWaitFramStop = no.
     4101      mWaitFramStopTimeOut = no.
     4102      block-wait:
     4103      do while mHSocket:get-bytes-available() > 0:
     4104         VFlag = no.
     4105         define variable vNumByte as integer no-undo.
     4106         vNumByte =   mHSocket:get-bytes-available().
     4107         if vNumByte > 30000 then vNumByte = 30000.
     4108         SET-SIZE(vResponse) = vNumByte + 1.
     4109         SET-BYTE-ORDER(vResponse) = big-endian.
     4110         mHSocket:read(vResponse,1,vNumByte).
     4111         vMessage = vMessage + GET-STRING(vResponse,1).
     4112         if  mReturnHTTp
     4113         then do:
     4114            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     4115            if vCnt > 0
     4116            then do:
     4117               mReturnHttp = no.
     4118               mWebResphead = substring (vMessage,1,vCnt).
     4119               vMessage     = substring (vMessage,vCnt + 4).
     4120               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     4121               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     4122                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     4123                  if  v-hd-line  begins "Content-Length"  then  do:
     4124                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     4125                  end.
     4126                  else if v-hd-line  begins "Transfer-Encoding"
     4127                  then do :
     4128                     define variable vChunked as logical no-undo.
     4129                     vchunked = index(v-hd-line,"chunked",19) > 0.
     4130                  end.
     4131               end.
     4132            end.
     4133         end.
     4134         vByte = vByte + vNumByte.
     4135         SET-SIZE(vResponse) = 0.
     4136         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     4137         then
     4138            leave block-wait.
     4139         if not mHSocket:get-bytes-available() > 0
     4140         then do:
     4141            VFlag = yes.
     4142            run WaitFramRunPause (?).
     4143            run gbl/pause.p (1000) .
     4144         end.
     4145         else if vByte > vNextMese
     4146         then do:
     4147            vNextMese = vNextMese + 100000.
     4148            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     4149            run WaitFramRunPause (?).
     4150         end.
     4151         if mWaitFramStopTimeOut
     4152         then do:
     4153            mWebResp = "".
     4154            leave block-wait.
     4155         end.
     4156      end.
     4157      if VFlag ne false
     4158      then
     4159         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     4160      mWaitFramStop = yes.
     4161      run writeLogSocet         in this-procedure ("Получен ответ").
     4162      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     4163      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     4164      run writeLogSocetOnlyText in this-procedure (vMessage).
     4165      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     4166      mHSocket:disconnect() no-error.
     4167      if v-cont-length > 0
     4168      then
     4169         mWebResp = substring (vMessage,1,v-cont-length).
     4170      else if vChunked
     4171      then do:
     4172         define variable vByteCopy as int64 no-undo init 1.
     4173         Block-Copy:
     4174         do while length(vMessage) > 0:
     4175            vByteCopy = 1.
     4176            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     4177            vByteCopy = vByteCopy +  vCnt + 2.
     4178            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     4179            if v-cont-length eq 0
     4180            then
     4181               leave Block-copy.
     4182            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     4183            vByteCopy = vByteCopy + v-cont-length + 2.
     4184            vMessage = substring  (vMessage,vByteCopy).
     4185         end.
     4186         run writeLogSocet         in this-procedure ("Заголовок").
     4187         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     4188         run writeLogSocet         in this-procedure ("Тело ответа").
     4189         run writeLogSocetOnlyText in this-procedure (mWebResp).
     4190        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     4191      end.
     4192      else
     4193         mWebResp = vMessage.
     4194      mWaitProcEvent = vWaitProcEvent.
     4195      mSocetEndTime = (now - mSocetBegTime) / 1000.
     4196      copy-lob mWebResp to mWebRespMptr.
     4197      if     mWriteRespFile ne ""
     4198         and mWriteRespFile ne ?
     4199      then
     4200           run gbl/fileapnd.p
     4201                ( mWriteRespFile
     4202                , mWebResp + chr(13) + chr(10)
     4203                ,input 10
     4204                ) no-error .
     4205   end procedure.
     4206   procedure writeLogSocet:
     4207      define input  parameter itext as longchar no-undo.
     4208      if mFileLogSocet eq "Async"
     4209      then
     4210         run PutMesAsunc(itext).
     4211      else if     mFileLogSocet ne ?
     4212              and mFileLogSocet ne ""
     4213      then do:
     4214         run gbl/fileapnd.p
     4215             ( mFileLogSocet
     4216             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     4217             ,input 10
     4218             ) no-error .
     4219         run writeLogSocetOnlyText(itext).
     4220         run gbl/fileapnd.p
     4221             ( mFileLogSocet
     4222             , substitute(" &1&2", chr(13) , chr(10))
     4223             ,input 10
     4224             ) no-error .
     4225      end.
     4226   end.
     4227   procedure writeLogSocetOnlyText:
     4228      define input  parameter itext as longchar no-undo.
     4229      if mFileLogSocet eq "Async"
     4230      then
     4231         run PutMesAsunc(itext).
     4232      else if     mFileLogSocet ne ?
     4233              and mFileLogSocet ne ""
     4234      then do:
     4235         if length(itext) > 32000
     4236         then
     4237            copy-lob
     4238      from object itext
     4239      to file mFileLogSocet append
     4240      no-error
     4241      .
     4242         else
     4243         run gbl/fileapnd.p
     4244             ( mFileLogSocet
     4245             , string(itext)
     4246             ,input 10
     4247             ) no-error .
     4248      end.
     4249   end.
     4250   procedure Disconect:
     4251      mHSocket:disconnect() no-error.
     4252      delete object mHSocket no-error.
     4253   end.
     4254   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     4255   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     4256   define variable p-obj-type        like ub.clients.obj-type no-undo .
     4257   define variable p-obj-code        like ub.clients.obj-code no-undo .
     4258   define variable p-remote          as integer   no-undo .
     4259   define variable p-auto            as integer   no-undo .
     4260   define variable p-shft-close      as integer   no-undo .
     4261   define variable p-other           as character no-undo .
     4262   define variable v-input-error     as logical   no-undo .
     4263   define variable v-view-log        as logical   no-undo .
     4264   define variable v-date            as date      no-undo.
     4265   define variable v-time            as integer   no-undo.
     4266   define variable v-today-date      as date      no-undo.
     4267   define variable v-today-time      as integer   no-undo.
     4268   define variable v-shift-num       as integer   no-undo .
     4269   define variable v-shift-name      as character no-undo.
     4270   define variable v-z-count         as integer   no-undo .
     4271   define variable v-chk-num         as integer   no-undo .
     4272   define variable v-mes             as character no-undo .
     4273   define variable v-param-prfx      as character no-undo .
     4274   define variable v-shift-date      as date      no-undo .
     4275   define variable l-shift-on        as logical   no-undo .
     4276   define variable v-esm             as character no-undo .
     4277   define variable v-shift-date-chr  as character no-undo .
     4278   define variable v-versiond        as decimal   no-undo .
     4279   define variable v-podbor          as logical   no-undo .
     4280   define variable log-file-name     as character no-undo .
     4281   define variable ii                as integer   no-undo .
     4282   define variable v-spec-command    as character no-undo .
     4283   define variable v-entry           as character no-undo .
     4284   define variable v-attr-value      as character no-undo .
     4285   define variable v-attr-type       as character no-undo .
     4286   define variable v-is-script       as logical   no-undo .
     4287   define variable imaria            as integer   no-undo .
     4288   define variable shift-maria       as integer   no-undo .
     4289   define variable v-p-spl           as character no-undo .
     4290   define variable v-spl-doc         as character no-undo .
     4291   define variable v-spl             as character no-undo .
     4292   define variable v-no-get-chk      as logical   no-undo .
     4293   define variable dflt-cd           as character no-undo .
     4294   define variable v-param-type      as character no-undo .
     4295   define variable v-value-character as character no-undo .
     4296   define variable v-value-date      as date      no-undo .
     4297   define variable v-value-decimal   as decimal   no-undo .
     4298   define variable v-value-integer   as INTEGER   no-undo .
     4299   define variable v-value-logical   AS LOGICAL   no-undo .
     4300   define variable v-tth             as handle    no-undo .
     4301   define variable vi                as integer   no-undo.
     4302   assign
     4303       v-tth = buffer thbjattr_thbj-attr:table-handle .
     4304   if num-entries(p-parameter, chr(4)) < 3
     4305       then
     4306   do:
     4307       assign
     4308           v-input-error = yes
     4309           v-esm         = "Неверное количество ENTRY в составном параметре"
     4310           .
     4311   end.
     4312   else
     4313   do:
     4314       assign
     4315           p-obj-type   = entry(1, p-parameter, chr(4))
     4316           p-obj-code   = integer(entry(2, p-parameter, chr(4)))
     4317           p-remote     = integer(entry(3, p-parameter, chr(4)))
     4318           p-auto       = if num-entries(p-parameter, chr(4)) >= 4
     4319                then integer(entry(4, p-parameter, chr(4)))
     4320                else 0
     4321           p-shft-close = if num-entries(p-parameter, chr(4)) >= 5
     4322                then integer(entry(5, p-parameter, chr(4)))
     4323                else 0
     4324     no-error .
     4325       if error-status:error then
     4326       do:
     4327           assign
     4328               v-esm         = error-status:get-message(1)
     4329               v-input-error = yes
     4330               .
     4331       end.
     4332       if num-entries(p-parameter, chr(4)) > 7 then
     4333       do:
     4334           p-other = p-parameter.
     4335           entry(1, p-other, chr(4)) = ''.
     4336           p-other = substring(p-other, 2).
     4337           entry(1, p-other, chr(4)) = ''.
     4338           p-other = substring(p-other, 2).
     4339           entry(1, p-other, chr(4)) = ''.
     4340           p-other = substring(p-other, 2).
     4341           entry(1, p-other, chr(4)) = ''.
     4342           p-other = substring(p-other, 2).
     4343           entry(1, p-other, chr(4)) = ''.
     4344           p-other = substring(p-other, 2).
     4345           entry(1, p-other, chr(4)) = ''.
     4346           p-other = substring(p-other, 2).
     4347           entry(1, p-other, chr(4)) = ''.
     4348           p-other = substring(p-other, 2).
     4349       end.
     4350       assign
     4351           v-podbor = (if p-auto = -1 then yes else no)
     4352           p-auto   = (if v-podbor then 0 else p-auto)
     4353           p-auto   = (if g#auto then 1 else 0)
     4354           .
     4355   end.
     4356   assign
     4357       log-file-name = (if p-auto = 0 then 'get-repf.log' else 'extgetcd.log').
     4358   if v-input-error = yes then
     4359   do:
     4360       run write-log-and-file in p-log-handle (
     4361           input 1
     4362           , input log-file-name
     4363           , input 1
     4364           , input substitute("Ошибка входных параметров &1:&2&3&4"
     4365           , p-parameter
     4366           , chr(10)
     4367           , v-esm
     4368           , return-value
     4369           )).
     4370       assign
     4371           v-view-log = yes.
     4372       if p-auto = 0 then do:
     4373   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4374   if v-view-log
     4375   and not g#news
     4376   and not g#auto
     4377   then do:
     4378     message
     4379     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     4380     "!!!Внимательно прочитайте Log-file!!"
     4381     view-as alert-box error .
     4382        define variable v-user-action15   as character no-undo .
     4383     define variable v-printed15       as logical   no-undo .
     4384     run gbl/prnfilen.w
     4385       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     4386       ,input  0
     4387       ,input  (string("./":U) + 'get-chkf.log')
     4388       ,input  7
     4389       ,output v-user-action15
     4390       ,output v-printed15
     4391       ) .
     4392   end.
     4393   if v-view-log = true
     4394   and (g#news
     4395   or g#auto)
     4396   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     4397   then do:
     4398      run cb_set-view-log in p-parent-handle ( input yes).
     4399   end.
     4400   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     4401     OS-DELETE value(string("./":U) + 'get-chkf.log').
     4402   end.
     4403                           return "error":U.                  end.
     4404   end.
     4405   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4406   define stream dirstream .
     4407   procedure waitp :
     4408   define input parameter p-auto as logical no-undo .
     4409   define input parameter fname           as character no-undo .
     4410   define input parameter mess            as character no-undo .
     4411   define input parameter btn-mess-start  as character no-undo .
     4412   define input parameter mess-auto-end   as character no-undo .
     4413   define input parameter btn-mess-end    as character no-undo .
     4414   define input parameter p-waiting       as integer   no-undo .
     4415   define variable v-start-time as int64   no-undo .
     4416   define variable v-exec-time as integer no-undo .
     4417   define variable v-exec-time0 as integer no-undo .
     4418   define variable v-file-name-del as character no-undo .
     4419   define variable v-dir-name as character no-undo .
     4420   define variable v-fn-add-mask as character no-undo .
     4421   define variable v-elapsed-time as integer no-undo .
     4422   define variable v-start-dir-watch-time as int64   no-undo .
     4423   define variable v-appear as logical no-undo .
     4424     do
     4425     on error undo, return error
     4426     :
     4427       if p-auto then do:
     4428         assign
     4429         v-file-name-del = entry(1, fname, chr(4))
     4430         v-dir-name      = (if num-entries(fname, chr(4)) = 3
     4431                           and v-file-name-del = "":U
     4432                           then entry(2, fname, chr(4))
     4433                           else "":U)
     4434         v-fn-add-mask = (if num-entries(fname, chr(4)) = 3
     4435                         and v-file-name-del = "":U
     4436                         then entry(3, fname, chr(4))
     4437                         else "":U)
     4438         v-fn-add-mask = (if v-dir-name <> "":U and v-fn-add-mask = "":U
     4439                         then "*.*"
     4440                         else v-fn-add-mask)
     4441         .
     4442         assign
     4443           v-start-time = etime
     4444         .
     4445         run show-counter in p-log-handle.
     4446         run write-counter in p-log-handle ( input btn-mess-start ).
     4447         run write-log-and-file in p-log-handle (
     4448               input 1
     4449             , input log-file-name
     4450             , input 1
     4451             , input mess).
     4452         do while true
     4453         :
     4454           assign
     4455             v-exec-time = (etime - v-start-time) / 1000
     4456           .
     4457           run show-counter in p-log-handle .
     4458           if v-exec-time0 <> v-exec-time then
     4459           run write-counter in p-log-handle (substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))).
     4460           assign
     4461           v-exec-time0 =  v-exec-time.
     4462           if v-exec-time >= p-waiting then do:
     4463             if v-file-name-del  <> ""
     4464             or v-dir-name <> "":u
     4465             then do:
     4466               run write-log-and-file in p-log-handle (
     4467                     input 1
     4468                   , input log-file-name
     4469                   , input 1
     4470                   , input substitute("&1"
     4471                                     , mess-auto-end
     4472                                     )).
     4473               run hide-counter in p-log-handle .
     4474               return .
     4475             end.
     4476             if v-dir-name = "":U then do:
     4477               run hide-counter in p-log-handle .
     4478               return .
     4479             end.
     4480           end.
     4481           if v-file-name-del <> "" then do:
     4482             if search(v-file-name-del) = ?
     4483             then do:
     4484               run hide-counter in p-log-handle .
     4485               return .
     4486             end.
     4487           end.
     4488           if v-dir-name <> "":U
     4489           and v-exec-time > minimum(p-waiting / 4, 15)
     4490           and (v-start-dir-watch-time = 0
     4491               or
     4492               (etime  - v-start-dir-watch-time) > v-elapsed-time * 10
     4493               )
     4494           then do:
     4495             assign
     4496             v-start-dir-watch-time = etime.
     4497             run proc-read-dir in this-procedure (
     4498                                                 input v-dir-name
     4499                                                 ,input v-fn-add-mask
     4500                                                 ,output v-elapsed-time
     4501                                                 ,output v-appear
     4502                                                 ) no-error .
     4503             if error-status:error then do:
     4504               return.
     4505             end.
     4506             if v-appear then return.
     4507           end.
     4508         end.
     4509       end.
     4510       else do:
     4511         run str/waitp.w (
     4512                      input fname
     4513                    , input mess
     4514                    , input btn-mess-start
     4515                    , input btn-mess-end
     4516                    , input p-waiting
     4517                     ) no-error .
     4518         if error-status:error then return error .
     4519       end.
     4520     end.
     4521   end procedure.
     4522   procedure waitpxml :
     4523   define input parameter p-auto as logical no-undo .
     4524   define input parameter fname-out       as character no-undo .
     4525   define input parameter fname-in        as character no-undo .
     4526   define input parameter mess            as character no-undo .
     4527   define input parameter btn-mess-start  as character no-undo .
     4528   define input parameter btn-mess-end    as character no-undo .
     4529   define input parameter mess-continue-waiting as character no-undo .
     4530   define input parameter p-waiting       as integer   no-undo .
     4531     define variable v-start-time as int64     no-undo .
     4532     define variable v-exec-time as integer no-undo .
     4533     define variable v-exec-time0 as integer no-undo .
     4534     define variable v-continue-waiting as logical no-undo .
     4535     do
     4536     on error undo, return error
     4537     :
     4538       if p-auto then do:
     4539         assign
     4540           v-start-time = etime
     4541         .
     4542         run show-counter in p-log-handle.
     4543         run write-counter in p-log-handle ( input btn-mess-start ).
     4544         run write-log-and-file in p-log-handle (
     4545               input 1
     4546             , input log-file-name
     4547             , input 1
     4548             , input mess).
     4549         do while true
     4550         :
     4551           assign
     4552             v-exec-time = (etime - v-start-time) / 1000
     4553           .
     4554           run show-counter in p-log-handle .
     4555           if v-exec-time0 <> v-exec-time then
     4556           run write-counter in p-log-handle (substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))).
     4557           assign
     4558           v-exec-time0 =  v-exec-time.
     4559           if v-exec-time >= p-waiting
     4560           and not v-continue-waiting
     4561           then do:
     4562             if fname-out <> "" then do:
     4563               run write-log-and-file in p-log-handle (
     4564                     input 1
     4565                   , input log-file-name
     4566                   , input 1
     4567                   , input substitute("------------------------- &1&1------------------------- &2"
     4568                                     , chr(10)
     4569                                     , (if p-auto then 'Касса не ответила.' else btn-mess-end)
     4570                                     )).
     4571               return .
     4572             end.
     4573             else do:
     4574               run hide-counter in p-log-handle .
     4575               return .
     4576             end.
     4577           end.
     4578           if fname-out <> "" then do:
     4579             if search(fname-out) = ?
     4580             then do:
     4581               run hide-counter in p-log-handle .
     4582               return .
     4583             end.
     4584             else do:
     4585               if search(fname-in) <> ? then do:
     4586                   assign
     4587                   v-continue-waiting = yes
     4588                   .
     4589               end.
     4590             end.
     4591           end.
     4592         end.
     4593       end.
     4594       else do:
     4595         run str/waitpxml.w (
     4596                      input fname-out
     4597                    , input fname-in
     4598                    , input mess
     4599                    , input btn-mess-start
     4600                    , input btn-mess-end
     4601                    , input mess-continue-waiting
     4602                    , input p-waiting
     4603                     ) no-error .
     4604         if error-status:error then return error .
     4605       end.
     4606     end.
     4607   end procedure.
     4608   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4609   PROCEDURE proc-read-dir :
     4610   DEFINE INPUT PARAMETER p-dir-name AS CHARACTER NO-UNDO.
     4611   DEFINE INPUT PARAMETER p-fn-add-mask AS CHARACTER NO-UNDO.
     4612   DEFINE output PARAMETER p-elapsed-time AS INTEGER NO-UNDO.
     4613   DEFINE output PARAMETER p-appear AS logical NO-UNDO.
     4614   define variable v-start-time as int64   no-undo.
     4615   define variable file as character no-undo.
     4616   define variable path as character no-undo.
     4617   define variable atr  as character no-undo.
     4618   define variable v-ext-split as integer   no-undo .
     4619   define variable v-ext-split-mask as integer   no-undo .
     4620   define variable v-file-name-no-ext as character no-undo .
     4621   define variable v-file-name-ext as character no-undo .
     4622   define variable v-mask-no-ext as character no-undo .
     4623   define variable v-mask-ext as character no-undo .
     4624   assign
     4625   v-start-time = etime.
     4626   input stream DirStream from os-dir (p-dir-name) .
     4627   REPEAT :
     4628     import stream DirStream file path atr.
     4629     if can-do( "f", atr )    then do:
     4630       if file matches p-fn-add-mask then do:
     4631         p-appear = yes.
     4632         leave.
     4633       end.
     4634       assign
     4635       v-ext-split = r-index(file, '.':u)
     4636       v-ext-split-mask = r-index(p-fn-add-mask, '.':u)
     4637       .
     4638       if v-ext-split > 0 then do:
     4639         assign
     4640           v-file-name-no-ext = substring(file, 1, v-ext-split - 1)
     4641           v-file-name-ext    = substring(file, v-ext-split + 1)
     4642         .
     4643       end.
     4644       else do:
     4645         assign
     4646           v-file-name-no-ext = file
     4647           v-file-name-ext    = ""
     4648         .
     4649       end.
     4650       if v-ext-split-mask > 0 then do:
     4651         assign
     4652           v-mask-no-ext = substring(p-fn-add-mask, 1, v-ext-split-mask - 1)
     4653           v-mask-ext    = substring(p-fn-add-mask, v-ext-split-mask + 1)
     4654         .
     4655       end.
     4656       else do:
     4657         assign
     4658           v-mask-no-ext = p-fn-add-mask
     4659           v-mask-ext    = ""
     4660         .
     4661       end.
     4662       if v-file-name-no-ext matches v-mask-no-ext
     4663       and v-file-name-ext matches v-mask-ext
     4664       then do:
     4665         p-appear = yes.
     4666         leave.
     4667       end.
     4668     end.
     4669   END.
     4670   assign
     4671   p-elapsed-time = etime - v-start-time.
     4672   END PROCEDURE.
     4673   DEFINE VARIABLE var-found-not-remote as logical   no-undo .
     4674   DEFINE VARIABLE var-spl-suffix       as character no-undo .
     4675   DEFINE VARIABLE var-spl-suffix-tmp   as character no-undo .
