        1   DEFINE input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE input parameter p-mode AS character NO-UNDO.
        3   DEFINE INPUT-OUTPUT parameter p-line-num AS integer NO-UNDO.
        4   DEFINE INPUT-OUTPUT parameter p-src-d-card AS character NO-UNDO.
        5   DEFINE INPUT-OUTPUT parameter p-discnt-type AS integer NO-UNDO.
        6   DEFINE INPUT-OUTPUT parameter p-discnt-id AS integer NO-UNDO.
        7   DEFINE INPUT-OUTPUT parameter p-kateg AS integer NO-UNDO.
        8   DEFINE OUTPUT parameter p-updated AS LOGICAL NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Форма задания параметров бонусов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   define new global shared variable g#library  as handle no-undo .
      324   define new global shared variable g#library2 as handle no-undo .
      325   procedure proc-alt-shift-f2:
      326     if not ibs.th.gbl.gbl-var:rcode
      327   then
      328     run gbl\inidebug.p .
      329   end.
      330   procedure proc-alt-shift-f3:
      331     run gbl/prvssinf.p
      332       ( input this-procedure
      333       ) .
      334   end.
      335   define variable v-inform-launched as logical no-undo initial false .
      336   procedure proc-alt-shift-f4:
      337     define variable v-action as character no-undo .
      338     if v-inform-launched = false then do:
      339       assign
      340         v-inform-launched = true
      341       .
      342       run gbl/d-inform.w
      343         (  input self
      344         ,  input this-procedure
      345         , output v-action
      346         ) no-error .
      347       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      348       assign
      349         v-inform-launched = false
      350       .
      351     end.
      352   end.
      353   procedure proc-alt-f1:
      354     run gbl/corrhelp.p
      355       (input this-procedure
      356       ) .
      357   end .
      358   on alt-shift-f2 anywhere do:
      359     run proc-alt-shift-f2.
      360   end.
      361   on alt-shift-f3 anywhere do:
      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   DEFINE BUTTON B-CURR
      371        IMAGE-UP FILE "btn-down-arrow":U
      372        IMAGE-DOWN FILE "btn-down-arrow":U
      373        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      374        LABEL ""
      375        SIZE 2.5 BY 1.07.
      376   DEFINE BUTTON B-exit AUTO-GO
      377        LABEL "&Ввод"
      378        SIZE 10 BY 1
      379        BGCOLOR 8 .
      380   DEFINE BUTTON B-Help
      381        LABEL "Помо&щь"
      382        SIZE 10 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON b-quit AUTO-END-KEY
      385        LABEL "&Отмена"
      386        SIZE 10 BY 1
      387        BGCOLOR 8 .
      388   DEFINE VARIABLE f-curr-abbr AS CHARACTER FORMAT "X(256)":U
      389         VIEW-AS TEXT
      390        SIZE 13.5 BY .67
      391        FGCOLOR 4  NO-UNDO.
      392   DEFINE VARIABLE f-discnt-id AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      393        LABEL "ID транзации (внешней системы)"
      394        VIEW-AS FILL-IN
      395        SIZE 10 BY 1 NO-UNDO.
      396   DEFINE VARIABLE f-discnt-type AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      397        LABEL "№ схемы начисления"
      398        VIEW-AS FILL-IN
      399        SIZE 10 BY 1 NO-UNDO.
      400   DEFINE VARIABLE f-kateg AS INTEGER FORMAT "->>9":U INITIAL 0
      401        LABEL "Код валюты начислений или -1"
      402        VIEW-AS FILL-IN
      403        SIZE 4 BY 1 NO-UNDO.
      404   DEFINE VARIABLE f-line-num AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
      405        LABEL "№ строки, после которой были начислены бонусы"
      406        VIEW-AS FILL-IN
      407        SIZE 4.5 BY 1 NO-UNDO.
      408   DEFINE VARIABLE f-src-d-card AS CHARACTER FORMAT "X(19)":U INITIAL "0"
      409        LABEL "№ карты для начисления"
      410        VIEW-AS FILL-IN
      411        SIZE 20 BY 1 NO-UNDO.
      412   DEFINE VARIABLE rs-curr-type AS LOGICAL
      413        VIEW-AS RADIO-SET VERTICAL
      414        RADIO-BUTTONS
      415             "Привязан к валюте", yes,
      416   "Не привязан к валюте", no
      417        SIZE 24.5 BY 1.87 NO-UNDO.
      418   DEFINE FRAME Dialog-Frame
      419        B-exit AT ROW 1 COL 1
      420        b-quit AT ROW 1 COL 11
      421        B-Help AT ROW 1 COL 54.9
      422        f-line-num AT ROW 2.87 COL 47 COLON-ALIGNED
      423        f-src-d-card AT ROW 4.2 COL 31.5 COLON-ALIGNED
      424        f-discnt-type AT ROW 5.27 COL 33 COLON-ALIGNED
      425        f-discnt-id AT ROW 6.33 COL 33 COLON-ALIGNED
      426        rs-curr-type AT ROW 7.67 COL 5 NO-LABEL
      427        f-kateg AT ROW 9.8 COL 41.5 COLON-ALIGNED
      428        B-CURR AT ROW 9.8 COL 48.5
      429        f-curr-abbr AT ROW 10.07 COL 51.5 COLON-ALIGNED NO-LABEL
      430        SPACE(0.09) SKIP(0.82)
      431       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      432            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      433            TITLE "Параметры начисленных бонусов"
      434            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      435   ASSIGN
      436          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      437          FRAME Dialog-Frame:HIDDEN           = TRUE.
      438   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      439   DO:
      440     APPLY "END-ERROR":U TO SELF.
      441   END.
      442   ON CHOOSE OF B-CURR IN FRAME Dialog-Frame
      443   DO:
      444       define variable rr as recid no-undo.
      445       DEFINE BUFFER buf_currency FOR ub.currency.
      446       rr = ? .
      447       run ref/currency.w (
      448                       input parparentproc
      449                     , input "b-sel"
      450                     , input-output rr ).
      451       if rr <> ? then do:
      452         FIND FIRST buf_currency WHERE
      453                   recid( buf_currency ) = rr NO-LOCK .
      454         DISPLAY
      455         buf_currency.curr-code @ f-kateg
      456         buf_currency.curr-abbr @ f-curr-abbr
      457         with frame Dialog-Frame .
      458       end.
      459   END.
      460   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      461   DO:
      462     IF p-mode = 'ДОБАВЛЕНИЕ':U
      463     OR p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      464       ASSIGN
      465       f-line-num
      466       f-src-d-card
      467       f-discnt-type
      468       f-discnt-id
      469       f-kateg.
      470     END.
      471     ASSIGN
      472     p-line-num = f-line-num
      473     p-src-d-card = f-src-d-card
      474     p-discnt-type = f-discnt-type
      475     p-discnt-id = f-discnt-id
      476     p-kateg = f-kateg
      477     p-updated = YES
      478     .
      479   END.
      480   ON ANY-PRINTABLE OF f-src-d-card IN FRAME Dialog-Frame
      481   DO:
      482       if (keyfunction(lastkey) lt "0" or
      483           keyfunction(lastkey) gt "9") and
      484           keyfunction(lastkey) ne "backspace"
      485       then
      486           return no-apply.
      487   END.
      488   ON VALUE-CHANGED OF rs-curr-type IN FRAME Dialog-Frame
      489   DO:
      490     ASSIGN
      491     rs-curr-type.
      492     CASE RS-CURR-TYPE:
      493       WHEN YES  THEN DO:
      494          ASSIGN
      495          F-KATEG = 0
      496          F-CURR-ABBR = "".
      497          ENABLE B-CURR
      498          WITH FRAME Dialog-Frame.
      499          DISPLAY
      500          F-KATEG
      501          F-CURR-ABBR
      502          WITH FRAME Dialog-Frame.
      503       END.
      504       WHEN NO THEN DO:
      505         ASSIGN
      506         F-KATEG = - 1
      507         F-CURR-ABBR = '':u.
      508         DISABLE B-CURR
      509         WITH FRAME Dialog-Frame.
      510         DISPLAY
      511         F-KATEG
      512         F-CURR-ABBR
      513         WITH FRAME Dialog-Frame.
      514       END.
      515     END CASE.
      516   END.
      517   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      518   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      519   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   on help of frame Dialog-Frame
      521   do:
      522     run gbl/app_help.p
      523       (input this-procedure :file-name
      524       ,input ''
      525       ,input ?
      526       ) no-error.
      527     if error-status :error then do:
      528       message
      529         "Ошибка при вызове помощи"
      530         error-status :get-message(1)
      531         view-as alert-box .
      532     end.
      533   end.
      534   run minbtn-set in this-procedure .
      535   on choose of b-help in frame Dialog-Frame
      536   do:
      537     apply "help":u to frame Dialog-Frame .
      538   end.
      539   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      540   procedure minbtn-set :
      541       do
      542           on error undo, return error return-value
      543           :
      544           define variable ii              as integer       no-undo .
      545           define variable fh              as widget-handle no-undo .
      546           define variable hh              as widget-handle no-undo .
      547           define variable v-h             as handle        extent 4 no-undo .
      548           define variable v-name-button   as character     no-undo .
      549           define variable v-help-old-x    as decimal       no-undo .
      550           define variable v-help-old-y    as decimal       no-undo .
      551           define variable v-help-old-size as decimal       no-undo .
      552           define variable v-frame-width   as decimal       no-undo .
      553           define variable jj              as integer       no-undo .
      554           do
      555               on error undo, return error
      556               :
      557               assign
      558                   v-frame-width = frame Dialog-Frame:width - 0.3
      559                   fh            = frame Dialog-Frame:first-child
      560                   hh            = fh:first-child
      561                   ii            = 1
      562                   .
      563               do while valid-handle(hh):
      564                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      565                   do:
      566                       case lc(hh:name) :
      567                           when "b-help" then
      568                               do:
      569                                   hh:load-image-up("cmp/b-help.bmp":u) .
      570                                   hh:load-image-down("cmp/b-help.bmp":u) .
      571                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      572                                   hh:TOOLTIP = "Помощь" .
      573                                   v-help-old-x = hh:column .
      574                                   v-help-old-y = hh:row    .
      575                                   v-help-old-size = hh:width .
      576                                   hh:width-chars = 2.5 .
      577                               end.
      578                           when "b-print" then
      579                               do:
      580                                   hh:load-image("cmp/b-print.bmp":u) .
      581                                   hh:TOOLTIP = "Печать" .
      582                                   v-h[ii] = hh:handle .
      583                                   ii = ii + 1 .
      584                                   hh:width-chars = 3 .
      585                               end.
      586                           when "b-history" or
      587                           when "b-hist" then
      588                               do:
      589                                   hh:load-image("cmp/b-hist.bmp":u) .
      590                                   hh:TOOLTIP = "История" .
      591                                   v-h[ii] = hh:handle .
      592                                   ii = ii + 1 .
      593                                   hh:width-chars = 3 .
      594                               end.
      595                           when "b-sch" then
      596                               do:
      597                                   hh:load-image("cmp/b-sch.bmp":u) .
      598                                   hh:TOOLTIP = "Установка Фильтра" .
      599                                   v-h[ii] = hh:handle .
      600                                   ii = ii + 1 .
      601                                   hh:width-chars = 3 .
      602                               end.
      603                           when "b-hist-user" then
      604                               do:
      605                                   hh:load-image("cmp/b-hist.bmp":u) .
      606                                   hh:TOOLTIP = "История пользователя" .
      607                                   ii = ii + 1 .
      608                               end.
      609                       end case.
      610                   end.
      611                   hh = hh:next-sibling.
      612               end.
      613               b-help:column = v-frame-width - b-help:width-chars.
      614               jj = 0.
      615               repeat ii = 4 to 1 by -1 :
      616                   if valid-handle (v-h[ii] ) then
      617                   do:
      618                       jj  = jj + 1 .
      619                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      620                       v-h[ii]:row    = v-help-old-y .
      621                   end.
      622               end.
      623           end.
      624       end.
      625   end procedure.
      626   MAIN-BLOCK:
      627   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      628      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      629     run Myenable in this-procedure .
      630     WAIT-FOR GO OF FRAME Dialog-Frame.
      631   END.
      632   RUN disable_UI.
      633   PROCEDURE disable_UI :
      634     HIDE FRAME Dialog-Frame.
      635   END PROCEDURE.
      636   PROCEDURE enable_UI :
      637     DISPLAY f-line-num f-src-d-card f-discnt-type f-discnt-id rs-curr-type f-kateg
      638             f-curr-abbr
      639         WITH FRAME Dialog-Frame.
      640     ENABLE B-exit b-quit B-Help f-line-num f-src-d-card f-discnt-type f-discnt-id
      641            rs-curr-type f-kateg B-CURR f-curr-abbr
      642         WITH FRAME Dialog-Frame.
      643     VIEW FRAME Dialog-Frame.
      644   END PROCEDURE.
      645   PROCEDURE MyEnable :
      646   define buffer BUF_CURRENCY for ub.currency.
      647   CASE p-mode :
      648     WHEN  'ДОБАВЛЕНИЕ':U THEN DO:
      649       ASSIGN
      650       rs-curr-type = YES
      651       f-kateg = 0
      652       .
      653     END.
      654     WHEN 'ПРОСМОТР':U
      655     OR
      656     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
      657         ASSIGN
      658         f-line-num = p-line-num
      659         f-src-d-card = p-SRC-d-card
      660         f-discnt-type = p-discnt-type
      661         f-discnt-id = p-discnt-id
      662         f-kateg = p-kateg
      663         .
      664     END.
      665   END CASE.
      666   FIND FIRST buf_currency NO-LOCK WHERE
      667           buf_currency.curr-code = f-kateg NO-ERROR.
      668   IF AVAILABLE buf_currency THEN DO:
      669     f-curr-abbr = buf_currency.curr-abbr.
      670   END.
      671   ELSE DO:
      672     f-curr-abbr = chr(63).
      673   END.
      674   DISPLAY
      675   f-line-num
      676   f-src-d-card
      677   f-discnt-type
      678   f-discnt-id
      679   rs-curr-type
      680   f-kateg
      681   f-curr-abbr
      682   WITH FRAME Dialog-Frame.
      683   ENABLE
      684   B-exit WHEN p-mode <> 'ПРОСМОТР':U
      685   b-quit
      686   B-Help
      687   f-line-num
      688   f-src-d-card
      689   f-discnt-type
      690   f-discnt-id
      691   rs-curr-type  WHEN p-mode <> 'ПРОСМОТР':U
      692   f-kateg
      693   B-curr WHEN p-mode <> 'ПРОСМОТР':U
      694   f-curr-abbr
      695   WITH FRAME Dialog-Frame.
      696   IF p-mode = 'ПРОСМОТР':U THEN DO:
      697     HIDE
      698     b-exit IN FRAME Dialog-Frame.
      699     ASSIGN
      700     b-quit:LABEL = "&Выход"
      701     b-quit:column = 1.
      702   END.
      703   VIEW FRAME Dialog-Frame.
      704   APPLY "VALUE-CHANGED" to rs-curr-type.
      705   END PROCEDURE.
