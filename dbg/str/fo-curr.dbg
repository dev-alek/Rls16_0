        1   define input parameter parParentProc   AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter par-host-code   as integer no-undo .
        3   define input-output parameter   p-sum-rubl      as decimal no-undo .
        4   define input-output parameter   p-sum-base      as decimal no-undo .
        5   define input-output parameter   p-sum-contr     as decimal no-undo .
        6   define  input         parameter p-basecode      as integer no-undo .
        7   define  input-output  parameter p-base-rate     as decimal no-undo .
        8   define  input-output  parameter p-base-scale    as integer no-undo .
        9   define  input         parameter p-contract-curr as integer no-undo .
       10   define  input-output  parameter p-contract-rate as decimal no-undo .
       11   define  input-output  parameter p-contract-scale as integer no-undo .
       12   define input parameter          p-val-pay as integer no-undo .
       13   define input parameter p-hide-rubl  as logical no-undo .
       14   define input parameter p-hide-base  as logical no-undo .
       15   define input parameter p-hide-contr as logical no-undo .
       16   define output parameter p-res as logical no-undo .
       17   def var vss-revision    as character no-undo init "$Revision$":U .
       18   def var vss-author      as character no-undo init "$Author$":U .
       19   def var vss-date        as character no-undo init "$Date$":U .
       20   def var vss-workfile    as character no-undo init "$Workfile$":U .
       21   def var vss-archive     as character no-undo init "$Archive$":U .
       22   def var vss-description as character no-undo init "Форма ввода и корректировки курсов ФО".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   procedure proc-alt-shift-f2:
       93     if not ibs.th.gbl.gbl-var:rcode
       94   then
       95     run gbl\inidebug.p .
       96   end.
       97   procedure proc-alt-shift-f3:
       98     run gbl/prvssinf.p
       99       ( input this-procedure
      100       ) .
      101   end.
      102   define variable v-inform-launched as logical no-undo initial false .
      103   procedure proc-alt-shift-f4:
      104     define variable v-action as character no-undo .
      105     if v-inform-launched = false then do:
      106       assign
      107         v-inform-launched = true
      108       .
      109       run gbl/d-inform.w
      110         (  input self
      111         ,  input this-procedure
      112         , output v-action
      113         ) no-error .
      114       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      115       assign
      116         v-inform-launched = false
      117       .
      118     end.
      119   end.
      120   procedure proc-alt-f1:
      121     run gbl/corrhelp.p
      122       (input this-procedure
      123       ) .
      124   end .
      125   on alt-shift-f2 anywhere do:
      126     run proc-alt-shift-f2.
      127   end.
      128   on alt-shift-f3 anywhere do:
      129     run proc-alt-shift-f3 in this-procedure .
      130   end.
      131   on alt-shift-f4 anywhere do:
      132     run proc-alt-shift-f4 in this-procedure.
      133   end.
      134   on alt-f1 anywhere do:
      135     run proc-alt-f1 in this-procedure .
      136   end.
      137   FUNCTION sel-abbr RETURNS CHARACTER
      138   ( p-curr-code as int )  FORWARD.
      139   DEFINE MENU POPUP-MENU-B-r-1
      140          MENU-ITEM m_rubl-base    LABEL "Пересчитать РУБ по курсу и сумме в &баз.вал."
      141          MENU-ITEM m_rubl-contr   LABEL "Пересчитать РУБ по курсу и сумме в вал.&договора".
      142   DEFINE BUTTON B-exit AUTO-GO
      143        LABEL "&Ввод"
      144        SIZE 10 BY 1
      145        BGCOLOR 8 .
      146   DEFINE BUTTON B-Help
      147        LABEL "Помо&щь"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON B-quit AUTO-END-KEY
      151        LABEL "&Отмена"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON B-r-1
      155        LABEL "Расчет"
      156        SIZE 10 BY 1 TOOLTIP "Пересчитать национальную валюту"
      157        BGCOLOR 8 .
      158   DEFINE BUTTON B-r-2
      159        LABEL "Расчет"
      160        SIZE 10 BY 1 TOOLTIP "Пересчитать сумму в Б.В. по курсу Б.В. и сумме в рублях"
      161        BGCOLOR 8 .
      162   DEFINE BUTTON B-r-3
      163        LABEL "Расчет"
      164        SIZE 10 BY 1 TOOLTIP "Пересчитать курс Б.В. по сумме Б.В. и сумме в рублях"
      165        BGCOLOR 8 .
      166   DEFINE BUTTON B-r-4
      167        LABEL "Расчет"
      168        SIZE 10 BY 1 TOOLTIP "Пересчитать сумму в вал.договора по курсу вал.договора и сумме в рублях"
      169        BGCOLOR 8 .
      170   DEFINE BUTTON B-r-5
      171        LABEL "Расчет"
      172        SIZE 10 BY 1 TOOLTIP "Пересчитать курс вал.договора по сумме в вал.договора и сумме в рублях"
      173        BGCOLOR 8 .
      174   DEFINE BUTTON r-curr-base
      175        IMAGE-UP FILE "btn-down-arrow":U
      176        IMAGE-DOWN FILE "btn-down-arrow":U
      177        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      178        LABEL ""
      179        SIZE 3 BY .88 TOOLTIP "Выбор из справочника валют".
      180   DEFINE BUTTON r-curr-contr
      181        IMAGE-UP FILE "btn-down-arrow":U
      182        IMAGE-DOWN FILE "btn-down-arrow":U
      183        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      184        LABEL ""
      185        SIZE 3 BY .88 TOOLTIP "Выбор из справочника валют".
      186   DEFINE VARIABLE FILL-IN-8 AS CHARACTER FORMAT "X(256)":U INITIAL "Старые значения"
      187         VIEW-AS TEXT
      188        SIZE 16 BY .67
      189        FGCOLOR 3  NO-UNDO.
      190   DEFINE VARIABLE loc_abbr-base AS CHARACTER FORMAT "X(12)":U
      191        LABEL "Баз.вал."
      192         VIEW-AS TEXT
      193        SIZE 5.38 BY .67 TOOLTIP "Базовая валюта"
      194        FGCOLOR 4  NO-UNDO.
      195   DEFINE VARIABLE loc_abbr-base-2 AS CHARACTER FORMAT "X(12)":U
      196         VIEW-AS TEXT
      197        SIZE 5.38 BY 1 TOOLTIP "Базовая валюта"
      198        FGCOLOR 4  NO-UNDO.
      199   DEFINE VARIABLE loc_abbr-contr AS CHARACTER FORMAT "X(12)":U
      200        LABEL "Валюта договора"
      201         VIEW-AS TEXT
      202        SIZE 5.13 BY .67 TOOLTIP "Валюта договора"
      203        FGCOLOR 4  NO-UNDO.
      204   DEFINE VARIABLE loc_abbr-contr-2 AS CHARACTER FORMAT "X(12)":U
      205         VIEW-AS TEXT
      206        SIZE 5.13 BY 1 TOOLTIP "Валюта договора"
      207        FGCOLOR 4  NO-UNDO.
      208   DEFINE VARIABLE loc_abbr-rubl AS CHARACTER FORMAT "X(12)":U INITIAL "РУБ"
      209         VIEW-AS TEXT
      210        SIZE 4.5 BY 1 TOOLTIP "Национальная валюта"
      211        FGCOLOR 4  NO-UNDO.
      212   DEFINE VARIABLE loc_abbr-rubl-2 AS CHARACTER FORMAT "X(20)":U INITIAL "Национальная валюта:"
      213         VIEW-AS TEXT
      214        SIZE 21.5 BY 1 TOOLTIP "Национальная валюта" NO-UNDO.
      215   DEFINE VARIABLE loc_abbr-rubl-5 AS CHARACTER FORMAT "X(20)":U INITIAL "Национальная валюта:"
      216         VIEW-AS TEXT
      217        SIZE 21.5 BY 1 TOOLTIP "Национальная валюта" NO-UNDO.
      218   DEFINE VARIABLE loc_abbr-rubl-6 AS CHARACTER FORMAT "X(12)":U INITIAL "РУБ"
      219         VIEW-AS TEXT
      220        SIZE 4.5 BY 1 TOOLTIP "Национальная валюта"
      221        FGCOLOR 4  NO-UNDO.
      222   DEFINE VARIABLE loc_abbr-rubl-7 AS CHARACTER FORMAT "X(12)":U INITIAL "Баз.вал.:"
      223         VIEW-AS TEXT
      224        SIZE 9.5 BY 1 NO-UNDO.
      225   DEFINE VARIABLE loc_abbr-rubl-8 AS CHARACTER FORMAT "X(12)":U INITIAL "Договор :"
      226         VIEW-AS TEXT
      227        SIZE 9.5 BY 1 NO-UNDO.
      228   DEFINE VARIABLE loc_base-rate AS DECIMAL FORMAT ">>,>>9.9999" INITIAL 0
      229        LABEL "Курс"
      230        VIEW-AS FILL-IN NATIVE
      231        SIZE 12 BY 1.
      232   DEFINE VARIABLE loc_base-rate-2 AS DECIMAL FORMAT ">>,>>9.9999" INITIAL 0
      233        VIEW-AS FILL-IN NATIVE
      234        SIZE 12 BY 1.
      235   DEFINE VARIABLE loc_base-scale AS INTEGER FORMAT ">,>>>,>>9" INITIAL 0
      236        VIEW-AS FILL-IN NATIVE
      237        SIZE 5 BY 1.
      238   DEFINE VARIABLE loc_base-scale-2 AS INTEGER FORMAT ">,>>>,>>9" INITIAL 0
      239        VIEW-AS FILL-IN NATIVE
      240        SIZE 5 BY 1.
      241   DEFINE VARIABLE loc_contract-rate AS DECIMAL FORMAT ">>,>>9.9999" INITIAL 0
      242        LABEL "Курс"
      243        VIEW-AS FILL-IN NATIVE
      244        SIZE 12 BY 1.
      245   DEFINE VARIABLE loc_contract-rate-2 AS DECIMAL FORMAT ">>,>>9.9999" INITIAL 0
      246        VIEW-AS FILL-IN NATIVE
      247        SIZE 12 BY 1.
      248   DEFINE VARIABLE loc_contract-scale AS INTEGER FORMAT ">,>>>,>>9" INITIAL 0
      249        VIEW-AS FILL-IN NATIVE
      250        SIZE 5 BY 1.
      251   DEFINE VARIABLE loc_contract-scale-2 AS INTEGER FORMAT ">,>>>,>>9" INITIAL 0
      252        VIEW-AS FILL-IN NATIVE
      253        SIZE 5 BY 1.
      254   DEFINE VARIABLE loc_sum-base LIKE fin-ob.sum-base
      255        LABEL "Сумма"
      256        VIEW-AS FILL-IN NATIVE
      257        SIZE 22 BY 1 NO-UNDO.
      258   DEFINE VARIABLE loc_sum-base-2 LIKE fin-ob.sum-base
      259        VIEW-AS FILL-IN NATIVE
      260        SIZE 22 BY 1 TOOLTIP "<<F5>> - пересчет курса баз.вал." NO-UNDO.
      261   DEFINE VARIABLE loc_sum-contract LIKE fin-ob.sum-contract
      262        LABEL "Сумма"
      263        VIEW-AS FILL-IN NATIVE
      264        SIZE 22 BY 1 NO-UNDO.
      265   DEFINE VARIABLE loc_sum-contract-2 LIKE fin-ob.sum-contract
      266        VIEW-AS FILL-IN NATIVE
      267        SIZE 22 BY 1 TOOLTIP "<<F5>> - пересчет курса валюты договора" NO-UNDO.
      268   DEFINE VARIABLE loc_sum-rubl LIKE fin-ob.sum-rubl
      269        VIEW-AS FILL-IN NATIVE
      270        SIZE 22 BY 1 NO-UNDO.
      271   DEFINE VARIABLE loc_sum-rubl-2 LIKE fin-ob.sum-rubl
      272        VIEW-AS FILL-IN NATIVE
      273        SIZE 22 BY 1 NO-UNDO.
      274   DEFINE RECTANGLE RECT-6
      275        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      276        SIZE 98.5 BY 9.
      277   DEFINE RECTANGLE RECT-7
      278        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      279        SIZE 98.5 BY 9.25.
      280   DEFINE FRAME Dialog-Frame
      281        B-exit AT ROW 1 COL 1
      282        B-quit AT ROW 1 COL 11
      283        B-Help AT ROW 1 COL 89.5
      284        loc_sum-rubl-2 AT ROW 4 COL 40.5 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      285        loc_base-rate-2 AT ROW 6 COL 22 COLON-ALIGNED NO-LABEL
      286        loc_base-scale-2 AT ROW 6 COL 34.5 COLON-ALIGNED NO-LABEL
      287        loc_sum-base-2 AT ROW 6 COL 40.5 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      288        loc_contract-rate-2 AT ROW 8 COL 22 COLON-ALIGNED NO-LABEL
      289        loc_contract-scale-2 AT ROW 8 COL 34.5 COLON-ALIGNED NO-LABEL
      290        loc_sum-contract-2 AT ROW 8 COL 40.5 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      291        loc_sum-rubl AT ROW 12.5 COL 38.5 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      292        B-r-1 AT ROW 12.5 COL 63
      293        loc_sum-base AT ROW 17.25 COL 10 COLON-ALIGNED
      294             LABEL "Сумма" FORMAT "->,>>>,>>>,>>>,>>9.99"
      295        B-r-2 AT ROW 17.25 COL 34.5
      296        loc_sum-contract AT ROW 17.25 COL 64 COLON-ALIGNED
      297             LABEL "Сумма" FORMAT "->,>>>,>>>,>>>,>>9.99"
      298        B-r-4 AT ROW 17.25 COL 88.5
      299        loc_base-rate AT ROW 18.25 COL 10 COLON-ALIGNED
      300        loc_base-scale AT ROW 18.25 COL 22.5 COLON-ALIGNED NO-LABEL
      301        r-curr-base AT ROW 18.25 COL 30.5
      302        B-r-3 AT ROW 18.25 COL 34.5
      303        loc_contract-rate AT ROW 18.25 COL 64 COLON-ALIGNED
      304        loc_contract-scale AT ROW 18.25 COL 76.5 COLON-ALIGNED NO-LABEL
      305        r-curr-contr AT ROW 18.25 COL 84.5
      306        B-r-5 AT ROW 18.25 COL 88.5
      307        FILL-IN-8 AT ROW 1.25 COL 36 COLON-ALIGNED NO-LABEL
      308        loc_abbr-rubl-5 AT ROW 4 COL 15.5 NO-LABEL
      309        loc_abbr-rubl-6 AT ROW 4 COL 37.5 NO-LABEL
      310        loc_abbr-rubl-7 AT ROW 6 COL 4 NO-LABEL
      311        loc_abbr-base-2 AT ROW 6 COL 17.5 NO-LABEL AUTO-RETURN
      312        loc_abbr-rubl-8 AT ROW 8 COL 4 NO-LABEL
      313        loc_abbr-contr-2 AT ROW 8.13 COL 17.5 NO-LABEL AUTO-RETURN
      314        loc_abbr-rubl-2 AT ROW 12.5 COL 13.5 NO-LABEL
      315        loc_abbr-rubl AT ROW 12.5 COL 35.5 NO-LABEL
      316        loc_abbr-base AT ROW 16.5 COL 2 AUTO-RETURN
      317        loc_abbr-contr AT ROW 16.5 COL 49 AUTO-RETURN
      318        RECT-6 AT ROW 2.25 COL 1
      319        RECT-7 AT ROW 11.25 COL 1
      320        SPACE(0.00) SKIP(0.16)
      321       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      322            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      323            TITLE "Расчет сумм и курсов ФО"
      324            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      325   ASSIGN
      326          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      327          FRAME Dialog-Frame:HIDDEN           = TRUE.
      328   ASSIGN
      329          B-r-1:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-B-r-1:HANDLE.
      330   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      331   DO:
      332     APPLY "END-ERROR":U TO SELF.
      333   END.
      334   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      335   DO:
      336   DEFINE VARIABLE v-rate-correct AS CHARACTER NO-UNDO.
      337   p-res = YES.
      338   run ver-summ in this-procedure (output v-rate-correct) no-error.
      339   if error-status:error then do:
      340     message "Ошибка при вызове процедуры rate-correct." skip
      341             return-value
      342             error-status:get-message(1)
      343             error-status:get-message(2)
      344     view-as alert-box error.
      345     return no-apply.
      346   end.
      347   CASE v-rate-correct:
      348       WHEN "base-rate":U THEN DO:
      349              message
      350             "Курс базовой валюты не согласован с суммой в базовой валюте и суммой в национальной валюте" skip
      351             "Сумма в базовой валюте: " loc_sum-base skip
      352             "Сумма в рублях: " loc_sum-rubl skip
      353             "Курс базовой валюты: " loc_base-rate skip
      354             "Шкала базовой валюты: " loc_base-scale
      355     view-as alert-box information.
      356           RETURN NO-apply.
      357       END.
      358       WHEN "contract-rate":U THEN DO:
      359           message
      360             "Курс валюты договора не согласован c суммой договора и суммой в национальной валюте" skip
      361             "Сумма в валюте договора: " loc_sum-contract skip
      362             "Сумма в рублях: " loc_sum-rubl skip
      363             "Курс валюты договора: " loc_contract-rate skip
      364             "Шкала валюты договора: " loc_contract-scale
      365   view-as alert-box information.
      366           return NO-apply.
      367     END.
      368   END CASE.
      369   if loc_sum-rubl = 0 or loc_sum-rubl = ? or
      370       loc_sum-base       = 0 or   loc_sum-base      = ? or
      371       loc_sum-contract   = 0 or   loc_sum-contract   = ? or
      372       loc_base-rate      = 0 or   loc_base-rate      = ? or
      373       loc_base-scale     = 0 or   loc_base-scale     = ? or
      374       loc_contract-rate  = 0 or   loc_contract-rate   = ? or
      375       loc_contract-scale = 0 or   loc_contract-scale  = ?
      376    then do:
      377       message "Ошибка при вводе сумм или курсов! "
      378       "Значение не должно равнятся 0 или ?"  view-as alert-box error .
      379               return NO-apply.
      380   end.
      381   if
      382       loc_base-rate      < 0   or
      383       loc_base-scale     < 0   or
      384       loc_contract-rate  < 0   or
      385       loc_contract-scale < 0
      386    then do:
      387       message "Ошибка при вводе курсов! "
      388       "Значение не должно быть меньше 0 "
      389       view-as alert-box error .
      390               return NO-apply.
      391   end.
      392   assign
      393      p-sum-rubl        =  loc_sum-rubl
      394      p-sum-base        =  loc_sum-base
      395      p-sum-contr       =  loc_sum-contract
      396      p-base-rate       =  loc_base-rate
      397      p-base-scale      =  loc_base-scale
      398      p-contract-rate   =  loc_contract-rate
      399      p-contract-scale  =  loc_contract-scale
      400   .
      401   END.
      402   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      403   DO:
      404     p-res = NO.
      405   END.
      406   ON CHOOSE OF B-r-1 IN FRAME Dialog-Frame
      407   DO:
      408       run gbl/pop-up.p (self:handle, no) no-error.
      409       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      410   END.
      411   ON CHOOSE OF B-r-2 IN FRAME Dialog-Frame
      412   DO:
      413       assign loc_sum-rubl
      414              loc_base-rate
      415              loc_base-scale
      416              .
      417      loc_sum-base  = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl  .
      418      display
      419         loc_sum-base         when loc_sum-base         :visible
      420         with frame Dialog-Frame  .
      421   END.
      422   ON CHOOSE OF B-r-3 IN FRAME Dialog-Frame
      423   DO:
      424      ASSIGN loc_sum-rubl
      425             loc_base-scale
      426             loc_sum-base
      427           .
      428       loc_base-rate = loc_sum-rubl / (loc_base-scale * loc_sum-base) .
      429       DISPLAY loc_base-rate  WITH FRAME Dialog-Frame  .
      430   END.
      431   ON CHOOSE OF B-r-4 IN FRAME Dialog-Frame
      432   DO:
      433       assign loc_sum-rubl
      434            loc_contract-rate
      435            loc_contract-scale
      436     .
      437    loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
      438      display
      439       loc_sum-contract         when loc_sum-contract         :visible
      440       with frame Dialog-Frame.
      441   END.
      442   ON CHOOSE OF B-r-5 IN FRAME Dialog-Frame
      443   DO:
      444     ASSIGN
      445         loc_sum-rubl
      446         loc_contract-scale
      447         loc_sum-contract
      448         .
      449     loc_contract-rate = loc_sum-rubl / (loc_contract-scale * loc_sum-contract) .
      450     DISPLAY loc_contract-rate  WITH FRAME Dialog-Frame.
      451   END.
      452   ON LEAVE OF loc_base-rate IN FRAME Dialog-Frame
      453   DO:
      454     APPLY "LEAVE":U TO loc_sum-base .
      455   END.
      456   ON return OF loc_base-rate IN FRAME Dialog-Frame
      457   DO:
      458       run next-focus in this-procedure  (input  loc_base-rate:handle ) .
      459     return no-apply .
      460   END.
      461   ON LEAVE OF loc_base-rate-2 IN FRAME Dialog-Frame
      462   OR "LEAVE" Of loc_base-scale
      463   OR "LEAVE" Of loc_contract-rate
      464   OR "LEAVE" Of loc_contract-scale
      465   DO:
      466     assign loc_base-rate loc_base-scale
      467     loc_contract-rate
      468     loc_contract-scale
      469     .
      470   END.
      471   ON return OF loc_base-rate-2 IN FRAME Dialog-Frame
      472   DO:
      473       run next-focus in this-procedure  (input  loc_base-rate-2:handle ) .
      474     return no-apply .
      475   END.
      476   ON LEAVE OF loc_base-scale IN FRAME Dialog-Frame
      477   DO:
      478     APPLY "LEAVE":U TO loc_sum-base .
      479   END.
      480   ON return OF loc_base-scale IN FRAME Dialog-Frame
      481   DO:
      482     run next-focus in this-procedure  (input  loc_base-scale:handle ) .
      483     return no-apply .
      484   END.
      485   ON return OF loc_base-scale-2 IN FRAME Dialog-Frame
      486   DO:
      487       run next-focus in this-procedure  (input  loc_base-scale-2:handle ) .
      488     return no-apply .
      489   END.
      490   ON LEAVE OF loc_contract-rate IN FRAME Dialog-Frame
      491   DO:
      492     APPLY "LEAVE":U TO loc_sum-contract .
      493   END.
      494   ON return OF loc_contract-rate IN FRAME Dialog-Frame
      495   DO:
      496       run next-focus in this-procedure  (input  loc_contract-rate:handle ) .
      497     return no-apply .
      498   END.
      499   ON return OF loc_contract-rate-2 IN FRAME Dialog-Frame
      500   DO:
      501       run next-focus in this-procedure  (input  loc_contract-rate-2:handle ) .
      502     return no-apply .
      503   END.
      504   ON LEAVE OF loc_contract-scale IN FRAME Dialog-Frame
      505   DO:
      506     APPLY "LEAVE":U TO loc_sum-contract .
      507   END.
      508   ON return OF loc_contract-scale IN FRAME Dialog-Frame
      509   DO:
      510       run next-focus in this-procedure  (input  loc_contract-scale:handle ) .
      511     return no-apply .
      512   END.
      513   ON return OF loc_contract-scale-2 IN FRAME Dialog-Frame
      514   DO:
      515       run next-focus in this-procedure  (input  loc_contract-scale-2:handle ) .
      516     return no-apply .
      517   END.
      518   ON LEAVE OF loc_sum-base IN FRAME Dialog-Frame
      519   DO:
      520       IF loc_sum-base:MODIFIED THEN ASSIGN loc_sum-base.
      521       IF loc_base-scale:MODIFIED THEN ASSIGN loc_base-scale.
      522       IF loc_base-rate:MODIFIED THEN ASSIGN loc_base-rate.
      523       IF p-contract-curr = p-basecode AND p-hide-contr = YES THEN DO:
      524     loc_sum-contract   = loc_sum-base.
      525     loc_contract-rate  = loc_base-rate.
      526     loc_contract-scale = loc_base-scale .
      527         DISPLAY
      528               loc_sum-contract
      529               loc_contract-rate
      530               loc_contract-scale
      531           with frame Dialog-Frame.
      532       END.
      533   END.
      534   ON return OF loc_sum-base IN FRAME Dialog-Frame
      535   DO:
      536       run next-focus in this-procedure  (input  loc_sum-base:handle ) .
      537     return no-apply .
      538   END.
      539   ON LEAVE OF loc_sum-base-2 IN FRAME Dialog-Frame
      540   DO:
      541   assign loc_sum-base
      542    loc_base-rate loc_base-scale
      543    loc_contract-rate loc_contract-scale
      544    .
      545     loc_sum-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-base .
      546     loc_sum-contract   = (  loc_contract-scale   / loc_contract-rate) * loc_sum-rubl .
      547      display
      548       loc_sum-base         when loc_sum-base         :visible
      549       loc_sum-rubl         when loc_sum-rubl         :visible
      550       loc_sum-contract     when loc_sum-contract     :visible
      551       with frame Dialog-Frame.
      552   END.
      553   ON return OF loc_sum-base-2 IN FRAME Dialog-Frame
      554   DO:
      555       run next-focus in this-procedure  (input  loc_sum-base-2:handle ) .
      556     return no-apply .
      557   END.
      558   ON LEAVE OF loc_sum-contract IN FRAME Dialog-Frame
      559   DO:
      560       IF loc_sum-contract:MODIFIED   THEN ASSIGN loc_sum-contract.
      561       IF loc_contract-rate:MODIFIED  THEN ASSIGN loc_contract-rate.
      562       IF loc_contract-scale:MODIFIED THEN ASSIGN loc_contract-scale.
      563   END.
      564   ON return OF loc_sum-contract IN FRAME Dialog-Frame
      565   DO:
      566       run next-focus in this-procedure  (input  loc_sum-contract:handle ) .
      567     return no-apply .
      568   END.
      569   ON LEAVE OF loc_sum-contract-2 IN FRAME Dialog-Frame
      570   DO:
      571    assign loc_sum-contract
      572    loc_base-rate loc_base-scale
      573    loc_contract-rate loc_contract-scale
      574    .
      575     loc_sum-rubl  =  ( loc_contract-rate  / loc_contract-scale) * loc_sum-contract .
      576     loc_sum-base   = (  loc_base-scale   / loc_base-rate) * loc_sum-rubl .
      577     display
      578     loc_sum-base           when loc_sum-base         :visible
      579     loc_sum-rubl           when loc_sum-rubl         :visible
      580     loc_sum-contract       when loc_sum-contract     :visible
      581     with frame Dialog-Frame.
      582    END.
      583   ON return OF loc_sum-contract-2 IN FRAME Dialog-Frame
      584   DO:
      585         run next-focus in this-procedure  (input  loc_sum-contract-2:handle ) .
      586     return no-apply .
      587   END.
      588   ON LEAVE OF loc_sum-rubl IN FRAME Dialog-Frame
      589   DO:
      590   IF loc_sum-rubl:MODIFIED THEN ASSIGN loc_sum-rubl.
      591   IF p-basecode = 0 THEN DO:
      592   loc_sum-base   = loc_sum-rubl.
      593   loc_base-rate  = 1           .
      594   loc_base-scale = 1           .
      595       DISPLAY
      596             loc_sum-base
      597             loc_base-rate
      598             loc_base-scale
      599         with frame Dialog-Frame.
      600     END.
      601     IF p-contract-curr = 0 THEN DO:
      602     loc_sum-contract   = loc_sum-rubl.
      603     loc_contract-rate  = 1           .
      604     loc_contract-scale = 1           .
      605         DISPLAY
      606               loc_sum-contract
      607               loc_contract-rate
      608               loc_contract-scale
      609           with frame Dialog-Frame.
      610       END.
      611   END.
      612   ON return OF loc_sum-rubl IN FRAME Dialog-Frame
      613   DO:
      614       run next-focus in this-procedure  (input  loc_sum-rubl:handle ) .
      615     return no-apply .
      616   END.
      617   ON LEAVE OF loc_sum-rubl-2 IN FRAME Dialog-Frame
      618   DO:
      619   assign loc_sum-rubl
      620    loc_base-rate loc_base-scale
      621    loc_contract-rate loc_contract-scale
      622    .
      623     loc_sum-base    = ( loc_base-scale  / loc_base-rate) * loc_sum-rubl .
      624     loc_sum-contract      = (  loc_contract-scale    / loc_contract-rate) * loc_sum-rubl .
      625     display
      626     loc_sum-base            when loc_sum-base         :visible
      627     loc_sum-contract        when loc_sum-contract     :visible
      628     with frame Dialog-Frame.
      629   END.
      630   ON return OF loc_sum-rubl-2 IN FRAME Dialog-Frame
      631   DO:
      632       run next-focus in this-procedure  (input  loc_sum-rubl-2:handle ) .
      633     return no-apply .
      634   END.
      635   ON CHOOSE OF MENU-ITEM m_rubl-base
      636   DO:
      637       assign  FRAME Dialog-Frame
      638              loc_sum-base
      639              loc_base-rate
      640              loc_base-scale
      641              .
      642     loc_sum-rubl    = ( loc_base-rate  / loc_base-scale) * loc_sum-base .
      643      display
      644       loc_sum-rubl         when loc_sum-rubl         :visible
      645      with frame Dialog-Frame.
      646     APPLY "LEAVE":U TO loc_sum-rubl .
      647   END.
      648   ON CHOOSE OF MENU-ITEM m_rubl-contr
      649   DO:
      650     assign FRAME Dialog-Frame  loc_sum-contract
      651              loc_contract-rate
      652              loc_contract-scale
      653              .
      654     loc_sum-rubl    = ( loc_contract-rate  / loc_contract-scale) * loc_sum-contract .
      655      display
      656       loc_sum-rubl         when loc_sum-rubl         :visible
      657      with frame Dialog-Frame.
      658      APPLY "LEAVE":U TO loc_sum-rubl .
      659   END.
      660   ON CHOOSE OF r-curr-base IN FRAME Dialog-Frame
      661   DO:
      662   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if lookup(self :type
      664            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      665            ) = 0
      666   then do:
      667     message
      668       "$Workfile$"
      669       "Указанному интерфейсному элементу фокус не может быть передан" skip
      670       "Интерфейсный элемент" self :name  skip
      671       "Тип" self :type  skip
      672       "Процедура" this-procedure :file-name skip
      673       view-as alert-box .
      674   end.
      675   else do:
      676     apply "entry":u to self  .
      677     if focus :handle <> self :handle  then do:
      678       return no-apply .
      679     end.
      680   end.
      681   define variable v-base-abbr like ub.currency.curr-abbr no-undo .
      682   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      684     (input  p-basecode
      685     ,input  today
      686     ,output loc_base-rate
      687     ,output loc_base-scale
      688     ,output v-base-abbr
      689     )  .
      690      display
      691      loc_base-rate
      692      loc_base-scale
      693      with frame Dialog-Frame.
      694   END.
      695   ON CHOOSE OF r-curr-contr IN FRAME Dialog-Frame
      696   DO:
      697   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   if lookup(self :type
      699            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      700            ) = 0
      701   then do:
      702     message
      703       "$Workfile$"
      704       "Указанному интерфейсному элементу фокус не может быть передан" skip
      705       "Интерфейсный элемент" self :name  skip
      706       "Тип" self :type  skip
      707       "Процедура" this-procedure :file-name skip
      708       view-as alert-box .
      709   end.
      710   else do:
      711     apply "entry":u to self  .
      712     if focus :handle <> self :handle  then do:
      713       return no-apply .
      714     end.
      715   end.
      716     define variable v-contract-abbr like ub.currency.curr-abbr no-undo .
      717   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      719     (input  p-contract-curr
      720     ,input  today
      721     ,output loc_contract-rate
      722     ,output loc_contract-scale
      723     ,output v-contract-abbr
      724     )  .
      725        display
      726        loc_contract-rate
      727        loc_contract-scale
      728        with frame Dialog-Frame.
      729   END.
      730   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      731   on help of frame Dialog-Frame
      732   do:
      733     run gbl/app_help.p
      734       (input this-procedure :file-name
      735       ,input ''
      736       ,input ?
      737       ) no-error.
      738     if error-status :error then do:
      739       message
      740         "Ошибка при вызове помощи"
      741         error-status :get-message(1)
      742         view-as alert-box .
      743     end.
      744   end.
      745   run minbtn-set in this-procedure .
      746   on choose of b-help in frame Dialog-Frame
      747   do:
      748     apply "help":u to frame Dialog-Frame .
      749   end.
      750   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751   procedure minbtn-set :
      752       do
      753           on error undo, return error return-value
      754           :
      755           define variable ii              as integer       no-undo .
      756           define variable fh              as widget-handle no-undo .
      757           define variable hh              as widget-handle no-undo .
      758           define variable v-h             as handle        extent 4 no-undo .
      759           define variable v-name-button   as character     no-undo .
      760           define variable v-help-old-x    as decimal       no-undo .
      761           define variable v-help-old-y    as decimal       no-undo .
      762           define variable v-help-old-size as decimal       no-undo .
      763           define variable v-frame-width   as decimal       no-undo .
      764           define variable jj              as integer       no-undo .
      765           do
      766               on error undo, return error
      767               :
      768               assign
      769                   v-frame-width = frame Dialog-Frame:width - 0.3
      770                   fh            = frame Dialog-Frame:first-child
      771                   hh            = fh:first-child
      772                   ii            = 1
      773                   .
      774               do while valid-handle(hh):
      775                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      776                   do:
      777                       case lc(hh:name) :
      778                           when "b-help" then
      779                               do:
      780                                   hh:load-image-up("cmp/b-help.bmp":u) .
      781                                   hh:load-image-down("cmp/b-help.bmp":u) .
      782                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      783                                   hh:TOOLTIP = "Помощь" .
      784                                   v-help-old-x = hh:column .
      785                                   v-help-old-y = hh:row    .
      786                                   v-help-old-size = hh:width .
      787                                   hh:width-chars = 2.5 .
      788                               end.
      789                           when "b-print" then
      790                               do:
      791                                   hh:load-image("cmp/b-print.bmp":u) .
      792                                   hh:TOOLTIP = "Печать" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-history" or
      798                           when "b-hist" then
      799                               do:
      800                                   hh:load-image("cmp/b-hist.bmp":u) .
      801                                   hh:TOOLTIP = "История" .
      802                                   v-h[ii] = hh:handle .
      803                                   ii = ii + 1 .
      804                                   hh:width-chars = 3 .
      805                               end.
      806                           when "b-sch" then
      807                               do:
      808                                   hh:load-image("cmp/b-sch.bmp":u) .
      809                                   hh:TOOLTIP = "Установка Фильтра" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-hist-user" then
      815                               do:
      816                                   hh:load-image("cmp/b-hist.bmp":u) .
      817                                   hh:TOOLTIP = "История пользователя" .
      818                                   ii = ii + 1 .
      819                               end.
      820                       end case.
      821                   end.
      822                   hh = hh:next-sibling.
      823               end.
      824               b-help:column = v-frame-width - b-help:width-chars.
      825               jj = 0.
      826               repeat ii = 4 to 1 by -1 :
      827                   if valid-handle (v-h[ii] ) then
      828                   do:
      829                       jj  = jj + 1 .
      830                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      831                       v-h[ii]:row    = v-help-old-y .
      832                   end.
      833               end.
      834           end.
      835       end.
      836   end procedure.
      837   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      838   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      839   ASSIGN B-r-1 :POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-B-r-1 :HANDLE.
      840   ASSIGN B-r-1 :MENU-MOUSE = 1.
      841   MAIN-BLOCK:
      842   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      843      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      844     run enable_my.
      845     wait-for go of frame Dialog-Frame focus loc_sum-rubl .
      846   END.
      847   run disable_ui.
      848   PROCEDURE disable_UI :
      849     HIDE FRAME Dialog-Frame.
      850   END PROCEDURE.
      851   PROCEDURE enable_my :
      852   assign
      853     loc_sum-rubl       = p-sum-rubl
      854     loc_sum-base       = p-sum-base
      855     loc_sum-contract      = p-sum-contr
      856     loc_sum-rubl-2        = p-sum-rubl
      857     loc_sum-base-2        = p-sum-base
      858     loc_sum-contract-2    = p-sum-contr
      859     loc_base-rate      = p-base-rate
      860     loc_base-scale     = p-base-scale
      861     loc_contract-rate  = p-contract-rate
      862     loc_contract-scale = p-contract-scale
      863     loc_base-rate-2      = p-base-rate
      864     loc_base-scale-2     = p-base-scale
      865     loc_contract-rate-2  = p-contract-rate
      866     loc_contract-scale-2 = p-contract-scale
      867     loc_abbr-base         = sel-abbr(p-basecode)
      868     loc_abbr-base-2       = sel-abbr(p-basecode)
      869     loc_abbr-contr        = sel-abbr(p-contract-curr)
      870     loc_abbr-contr-2      = sel-abbr(p-contract-curr)
      871   .
      872   MENU-ITEM m_rubl-base:sensitive IN MENU POPUP-MENU-B-r-1  = NOT p-hide-base .
      873   MENU-ITEM m_rubl-contr:sensitive IN MENU POPUP-MENU-B-r-1 = NOT p-hide-contr .
      874   DISPLAY loc_sum-rubl-2 loc_base-rate-2 loc_base-scale-2 loc_sum-base-2
      875             loc_contract-rate-2 loc_contract-scale-2 loc_sum-contract-2
      876             loc_sum-rubl loc_sum-base loc_sum-contract loc_base-rate
      877             loc_base-scale loc_contract-rate loc_contract-scale FILL-IN-8
      878             loc_abbr-rubl-5 loc_abbr-rubl-6 loc_abbr-rubl-7 loc_abbr-base-2
      879             loc_abbr-rubl-8 loc_abbr-contr-2 loc_abbr-rubl-2 loc_abbr-rubl
      880             loc_abbr-base
      881             loc_abbr-contr
      882         WITH FRAME Dialog-Frame.
      883     ENABLE B-exit B-quit B-Help
      884             B-r-1         when p-hide-rubl = false
      885             loc_sum-rubl  when p-hide-rubl = false
      886             B-r-2          when p-hide-base = false
      887             B-r-3          when p-hide-base = false
      888             loc_sum-base   when p-hide-base = false
      889             loc_base-rate  when p-hide-base = false
      890             loc_base-scale when p-hide-base = false
      891             r-curr-base    when p-hide-base = false
      892             B-r-4              when p-hide-contr = false
      893             B-r-5              when p-hide-contr = false
      894             loc_sum-contract   when p-hide-contr = false
      895             loc_contract-rate  when p-hide-contr = false
      896             loc_contract-scale when p-hide-contr = false
      897             r-curr-contr       when p-hide-contr = false
      898         WITH FRAME Dialog-Frame.
      899     VIEW FRAME Dialog-Frame.
      900   END PROCEDURE.
      901   PROCEDURE enable_UI :
      902     DISPLAY loc_sum-rubl-2 loc_base-rate-2 loc_base-scale-2 loc_sum-base-2
      903             loc_contract-rate-2 loc_contract-scale-2 loc_sum-contract-2
      904             loc_sum-rubl loc_sum-base loc_sum-contract loc_base-rate
      905             loc_base-scale loc_contract-rate loc_contract-scale FILL-IN-8
      906             loc_abbr-rubl-5 loc_abbr-rubl-6 loc_abbr-rubl-7 loc_abbr-base-2
      907             loc_abbr-rubl-8 loc_abbr-contr-2 loc_abbr-rubl-2 loc_abbr-rubl
      908             loc_abbr-base loc_abbr-contr
      909         WITH FRAME Dialog-Frame.
      910     ENABLE B-exit B-quit B-Help loc_sum-contract-2 B-r-1 B-r-2 loc_sum-contract
      911            B-r-4 r-curr-base B-r-3 r-curr-contr B-r-5 FILL-IN-8 loc_abbr-rubl-5
      912            loc_abbr-rubl-6 loc_abbr-rubl-7 loc_abbr-base-2 loc_abbr-rubl-8
      913            loc_abbr-contr-2 loc_abbr-rubl-2 loc_abbr-rubl loc_abbr-base
      914            loc_abbr-contr RECT-6 RECT-7
      915         WITH FRAME Dialog-Frame.
      916     VIEW FRAME Dialog-Frame.
      917   END PROCEDURE.
      918   PROCEDURE next-focus :
      919    do
      920    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      921    :
      922     define input parameter p-widget-handle as handle no-undo .
      923     define variable l-apply-entry as logical no-undo .
      924     assign
      925       l-apply-entry =   true
      926     .
      927     do with frame Dialog-Frame :
      928       if  loc_sum-rubl       :handle = p-widget-handle then do:
      929                                                            if loc_sum-base :sensitive then do:       apply "entry":u to loc_sum-base    .        return . end.
      930                                                            if loc_sum-contract :sensitive then do:       apply "entry":u to loc_sum-contract    .        return . end.
      931                                                            if B-exit     :sensitive then do:       apply "entry":u to B-exit     .        return . end.
      932                                                        end.
      933       if  loc_sum-base       :handle = p-widget-handle then do:
      934                                                               if loc_base-rate :sensitive then do:       apply "entry":u to loc_base-rate   .        return . end.
      935                                                               if loc_sum-contract :sensitive then do:       apply "entry":u to loc_sum-contract    .        return . end.
      936                                                               if B-exit     :sensitive then do:       apply "entry":u to B-exit     .        return . end.
      937                                                             end.
      938       if  loc_sum-contract   :handle = p-widget-handle then do:
      939                                                             if loc_contract-rate :sensitive then do:       apply "entry":u to loc_contract-rate   .        return . end.
      940                                                             if B-exit     :sensitive then do:       apply "entry":u to B-exit     .        return . end.
      941                                                             end.
      942       if  loc_base-rate    :handle = p-widget-handle then do:
      943           if loc_base-scale :sensitive then do:       apply "entry":u to loc_base-scale.  return . end.
      944       END.
      945       if loc_base-scale    :handle = p-widget-handle then do:
      946          if loc_sum-contract :sensitive then do:       apply "entry":u to loc_sum-contract.  return . end.
      947          if B-exit     :sensitive then do:       apply "entry":u to B-exit     .        return . end.
      948       END.
      949       if loc_contract-rate    :handle = p-widget-handle then do:
      950          if loc_contract-scale :sensitive then do:       apply "entry":u to loc_contract-scale.  return . end.
      951       END.
      952       if loc_contract-scale    :handle = p-widget-handle then do:
      953          if B-exit     :sensitive then do:       apply "entry":u to B-exit     .        return . end.
      954       END.
      955       end.
      956     end.
      957   END PROCEDURE.
      958   PROCEDURE ver-summ :
      959   DEFINE OUTPUT PARAMETER p-rate-correct AS CHARACTER NO-UNDO.
      960   IF abs( (loc_sum-rubl / loc_sum-base)  - (loc_base-rate / loc_base-scale)) > 0.0001  THEN DO:
      961       p-rate-correct = "base-rate":U.
      962       RETURN.
      963   END.
      964   IF abs( (loc_sum-rubl / loc_sum-contract) - (loc_contract-rate / loc_contract-scale )) > 0.0001 THEN DO:
      965       p-rate-correct = "contract-rate":U.
      966       RETURN.
      967   END.
      968   END PROCEDURE.
      969   FUNCTION sel-abbr RETURNS CHARACTER
      970   ( p-curr-code as int ) :
      971     define variable rr as character no-undo .
      972     find first currency no-lock where  currency.curr-code  = p-curr-code no-error.
      973     rr = currency.curr-abbr .
      974     RETURN rr.
      975   END FUNCTION.
