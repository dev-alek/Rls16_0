        1   block-level on error undo, throw.
        2   define input parameter p-doc-code as char no-undo.
        3   define input parameter p-file-name-err as char no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: chkwthcl.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/chkwthcl.p $":U .
        9   define variable vss-description as character no-undo init "Проверка партий при закрытии документа".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = p-doc-code
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-flag-doc-err  as logical      no-undo.
       83   define variable v-flag-doc-warning  as logical      no-undo.
       84   define buffer cls_wth-parts   for ub.wth-parts.
       85   define buffer cls_wth-doc     for ub.wth-doc.
       86   define buffer parent_wth-doc  for ub.wth-doc.
       87   define buffer buf_wth-parts   for ub.wth-parts.
       88   define buffer buf_wealth      for ub.wealth.
       89   define buffer buf_wth-ser     for ub.wth-ser.
       90   define stream str-err .
       91   define variable v-i    as integer      no-undo.
       92   DEFINE VARIABLE v-EndDate AS date NO-UNDO.
       93   DEFINE VARIABLE v-BegDate AS date NO-UNDO.
       94   mainBlock :
       95   do on error undo, return error
       96   :
       97     find first cls_wth-doc where cls_wth-doc.doc-code = p-doc-code
       98     exclusive-lock no-error.
       99     if error-status :error
      100     then do:
      101       message
      102         vss-workfile vss-revision vss-description skip
      103         "Ошибка задания входных параметров" skip
      104         "Не найден документ"  skip
      105         "Документ" p-doc-code skip
      106         view-as alert-box error .
      107       undo, return error return-value .
      108     end.
      109       assign
      110       v-flag-doc-err = no
      111     .
      112     if not g#news and search(p-file-name-err) <> ?
      113     then do:
      114       os-delete value(p-file-name-err).
      115     end.
      116     output stream str-err to value(p-file-name-err) append .
      117     for each cls_wth-parts no-lock where cls_wth-parts.out-code = p-doc-code
      118     , first buf_wealth no-lock  where buf_wealth.wth-code  = cls_wth-parts.wth-code
      119     , first buf_wth-ser no-lock where buf_wth-ser.ser-code = cls_wth-parts.ser-code
      120                                   and buf_wth-ser.db-num = cls_wth-parts.db-num  :
      121       if cls_wth-doc.ext-doc-type = 'ie':U
      122       or cls_wth-doc.ext-doc-type = 'ee':U
      123       or cls_wth-doc.ext-doc-type = 'xc':U
      124       then
      125       for each buf_wth-parts no-lock where buf_wth-parts.wth-code = cls_wth-parts.wth-code
      126                                        and buf_wth-parts.ser-code = cls_wth-parts.ser-code
      127                                        and buf_wth-parts.db-num   = cls_wth-parts.db-num
      128                                        and buf_wth-parts.out-code = 'free-zone':U
      129                                        and buf_wth-parts.fact-rangeFrom <= cls_wth-parts.fact-rangeTo
      130                                        and buf_wth-parts.fact-rangeTo >= cls_wth-parts.fact-rangeFrom
      131                                   :
      132           v-flag-doc-err = yes.
      133           put stream str-err unformatted
      134             substitute("В свободной зоне существуют МЦ &1 (код &2) серии &3 (код серии &4-&5) с номерами &6-&7"
      135                       ,buf_wealth.wth-name
      136                       ,buf_wth-parts.wth-code
      137                       ,buf_wth-ser.series
      138                       ,buf_wth-parts.ser-code
      139                       ,buf_wth-parts.db-num
      140                       ,(if buf_wth-parts.fact-rangeFrom > cls_wth-parts.fact-rangeFrom then buf_wth-parts.fact-rangeFrom else cls_wth-parts.fact-rangeFrom)
      141                       ,( if buf_wth-parts.fact-rangeTo > cls_wth-parts.fact-rangeTo then cls_wth-parts.fact-rangeTo else  buf_wth-parts.fact-rangeTo)
      142                       ) skip .
      143       end.
      144       if cls_wth-doc.ext-doc-type = 'ie':U
      145       or cls_wth-doc.ext-doc-type = 'ee':U
      146       or cls_wth-doc.ext-doc-type = 'xc':U
      147       then
      148       for each buf_wth-parts no-lock where buf_wth-parts.wth-code = cls_wth-parts.wth-code
      149                                        and buf_wth-parts.ser-code = cls_wth-parts.ser-code
      150                                        and buf_wth-parts.db-num   = cls_wth-parts.db-num
      151                                        and buf_wth-parts.out-code = 'cli-zone':U
      152                                        and buf_wth-parts.fact-rangeFrom <= cls_wth-parts.fact-rangeTo
      153                                        and buf_wth-parts.fact-rangeTo >= cls_wth-parts.fact-rangeFrom
      154                                   :
      155           v-flag-doc-err = yes.
      156           put stream str-err unformatted
      157             substitute("В зоне клиента существуют МЦ &1 (код &2) серии &3 (код серии &4-&5) с номерами &6-&7"
      158                       ,buf_wealth.wth-name
      159                       ,buf_wth-parts.wth-code
      160                       ,buf_wth-ser.series
      161                       ,buf_wth-parts.ser-code
      162                       ,buf_wth-parts.db-num
      163                       ,(if buf_wth-parts.fact-rangeFrom > cls_wth-parts.fact-rangeFrom then buf_wth-parts.fact-rangeFrom else cls_wth-parts.fact-rangeFrom)
      164                       ,( if buf_wth-parts.fact-rangeTo > cls_wth-parts.fact-rangeTo then cls_wth-parts.fact-rangeTo else  buf_wth-parts.fact-rangeTo)
      165                       ) skip .
      166       end.
      167       if cls_wth-doc.ext-doc-type = 'ie':U
      168       or cls_wth-doc.ext-doc-type = 'ee':U
      169       or cls_wth-doc.ext-doc-type = 'xc':U
      170       then
      171       for each buf_wth-parts no-lock where buf_wth-parts.wth-code = cls_wth-parts.wth-code
      172                                        and buf_wth-parts.ser-code = cls_wth-parts.ser-code
      173                                        and buf_wth-parts.db-num   = cls_wth-parts.db-num
      174                                        and buf_wth-parts.in-code  = cls_wth-parts.in-code
      175                                        and buf_wth-parts.out-code = 'put-zone':U
      176                                        and buf_wth-parts.fact-rangeFrom <= cls_wth-parts.fact-rangeTo
      177                                        and buf_wth-parts.fact-rangeTo >= cls_wth-parts.fact-rangeFrom
      178                                   :
      179           v-flag-doc-err = yes.
      180           put stream str-err unformatted
      181             substitute("В зоне погашения существуют МЦ &1 (код &2) серии &3 (код серии &4-&5) с номерами &6-&7"
      182                       ,buf_wealth.wth-name
      183                       ,buf_wth-parts.wth-code
      184                       ,buf_wth-ser.series
      185                       ,buf_wth-parts.ser-code
      186                       ,buf_wth-parts.db-num
      187                       ,(if buf_wth-parts.fact-rangeFrom > cls_wth-parts.fact-rangeFrom then buf_wth-parts.fact-rangeFrom else cls_wth-parts.fact-rangeFrom)
      188                       ,( if buf_wth-parts.fact-rangeTo > cls_wth-parts.fact-rangeTo then cls_wth-parts.fact-rangeTo else  buf_wth-parts.fact-rangeTo)
      189                       ) skip .
      190       end.
      191       if cls_wth-doc.ext-doc-type = 'ie':U
      192       or cls_wth-doc.ext-doc-type = 'ee':U
      193       or cls_wth-doc.ext-doc-type = 'xc':U
      194       then
      195       for each buf_wth-parts no-lock where buf_wth-parts.wth-code = cls_wth-parts.wth-code
      196                                        and buf_wth-parts.ser-code = cls_wth-parts.ser-code
      197                                        and buf_wth-parts.db-num   = cls_wth-parts.db-num
      198                                        and buf_wth-parts.out-code = 'out-zone':U
      199                                        and buf_wth-parts.fact-rangeFrom <= cls_wth-parts.fact-rangeTo
      200                                        and buf_wth-parts.fact-rangeTo >= cls_wth-parts.fact-rangeFrom
      201                                   :
      202           v-flag-doc-warning = yes.
      203           put stream str-err unformatted
      204             substitute("В зоне уничтожения существуют МЦ &1 (код &2) серии &3 (код серии &4-&5) с номерами &6-&7"
      205                       ,buf_wealth.wth-name
      206                       ,buf_wth-parts.wth-code
      207                       ,buf_wth-ser.series
      208                       ,buf_wth-parts.ser-code
      209                       ,buf_wth-parts.db-num
      210                       ,(if buf_wth-parts.fact-rangeFrom > cls_wth-parts.fact-rangeFrom then buf_wth-parts.fact-rangeFrom else cls_wth-parts.fact-rangeFrom)
      211                       ,(if buf_wth-parts.fact-rangeTo > cls_wth-parts.fact-rangeTo then cls_wth-parts.fact-rangeTo else  buf_wth-parts.fact-rangeTo)
      212                       ) skip .
      213       end.
      214       if cls_wth-parts.ext-doc-type = 'ee':U  or
      215       (cls_wth-parts.ext-doc-type  = 'xc':U and cls_wth-parts.type  = 'обмен':U ) then do:
      216           if buf_wth-ser.chk-bdt = 2 and buf_wth-ser.beg-dt <> ? then v-BegDate = buf_wth-ser.beg-dt.
      217           else  v-BegDate = cls_wth-parts.beg-dt.
      218           if buf_wth-ser.chk-edt = 2 and buf_wth-ser.end-dt <> ? then v-EndDate = buf_wth-ser.end-dt.
      219           else  v-EndDate = cls_wth-parts.end-dt.
      220         if (v-BegDate = ? and not buf_wth-ser.chk-bdt = 1)  or (v-EndDate = ? and not buf_wth-ser.chk-edt = 1)  then do:
      221             v-flag-doc-err = yes.
      222                 put stream str-err unformatted
      223                 substitute("Не указан срок действия партии МЦ &1 (код &2) серии &3 (код серии &4-&5) диапазон &6-&7"
      224                         ,buf_wealth.wth-name
      225                         ,cls_wth-parts.wth-code
      226                         ,buf_wth-ser.series
      227                         ,cls_wth-parts.ser-code
      228                         ,cls_wth-parts.db-num
      229                         ,cls_wth-parts.fact-rangeFrom
      230                         ,cls_wth-parts.fact-rangeTo
      231                         ) skip .
      232         end.
      233         if not (v-BegDate = ? or v-EndDate = ?) and v-BegDate > v-EndDate   then do:
      234             v-flag-doc-err = yes.
      235                 put stream str-err unformatted
      236                 substitute("Не верно указан срок действия партии МЦ &1 (код &2) серии &3 (код серии &4-&5) диапазон &6-&7 период с &8 по &9"
      237                         ,buf_wealth.wth-name
      238                         ,cls_wth-parts.wth-code
      239                         ,buf_wth-ser.series
      240                         ,cls_wth-parts.ser-code
      241                         ,cls_wth-parts.db-num
      242                         ,cls_wth-parts.fact-rangeFrom
      243                         ,cls_wth-parts.fact-rangeTo
      244                         ,v-BegDate
      245                         ,v-EndDate
      246                         ) skip .
      247         end.
      248         if cls_wth-parts.price-rubl = 0 OR cls_wth-parts.price-rubl = ? then do:
      249             v-flag-doc-err = yes.
      250                 put stream str-err unformatted
      251                 substitute("Не указана цена. Партия МЦ &1 (код &2) серии &3 (код серии &4-&5) диапазон &6-&7"
      252                         ,buf_wealth.wth-name
      253                         ,cls_wth-parts.wth-code
      254                         ,buf_wth-ser.series
      255                         ,cls_wth-parts.ser-code
      256                         ,cls_wth-parts.db-num
      257                         ,cls_wth-parts.fact-rangeFrom
      258                         ,cls_wth-parts.fact-rangeTo
      259                         ) skip .
      260         end.
      261         if cls_wth-doc.ext-doc-type = 'ee':U   and
      262            cls_wth-doc.fact-date >  cls_wth-parts.end-dt then do:
      263             v-flag-doc-err = yes.
      264                 put stream str-err unformatted
      265                 substitute("Срок годности партии меньше даты закрытия документа. Партия МЦ &1 (код &2) серии &3  диапазон &4-&5, срок годности &6-&7. Дата документа: &8"
      266                         ,buf_wealth.wth-name
      267                         ,cls_wth-parts.wth-code
      268                         ,buf_wth-ser.series
      269                         ,cls_wth-parts.fact-rangeFrom
      270                         ,cls_wth-parts.fact-rangeTo
      271                         ,cls_wth-parts.beg-dt
      272                         ,cls_wth-parts.end-dt
      273                         ,cls_wth-doc.fact-date
      274                         ) skip .
      275         end.
      276       end.
      277       if  cls_wth-doc.is-back-date = yes then do:
      278         find first parent_wth-doc no-lock where  parent_wth-doc.doc-code = cls_wth-parts.doc-code
      279         no-error.
      280         if available parent_wth-doc
      281         and  parent_wth-doc.fact-date > cls_wth-doc.fact-date then do:
      282             v-flag-doc-err = yes.
      283             put stream str-err unformatted
      284             substitute("Документ, породивший партию, закрыт более поздней датой (дата закрытия: &8). Партия МЦ &1 (код &2) серии &3 (код серии &4-&5) диапазон &6-&7."
      285                     ,buf_wealth.wth-name
      286                     ,cls_wth-parts.wth-code
      287                     ,buf_wth-ser.series
      288                     ,cls_wth-parts.ser-code
      289                     ,cls_wth-parts.db-num
      290                     ,cls_wth-parts.fact-rangeFrom
      291                     ,cls_wth-parts.fact-rangeTo
      292                     ,parent_wth-doc.fact-date
      293                     ) skip .
      294         end.
      295       end.
      296     end.
      297     if v-flag-doc-err then return error .
      298     else  os-delete value(p-file-name-err).
      299     if v-flag-doc-warning then return 'warning'.
      300   end.
