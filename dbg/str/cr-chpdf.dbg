        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo    .
        3   define input  parameter p-recid       as recid no-undo     .
        4   define input  parameter p-action      as character no-undo .
        5   define input  parameter p-trn-doc     as character no-undo .
        6   define input  parameter p-ask-pr      as logical   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: cr-chpdf.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/cr-chpdf.p $":U .
       12   define variable vss-description as character no-undo init "Cоздание ДНЦ-детей по Кустовому ТПЛ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83     define variable v-cntxt-db-num        as integer   no-undo .
       84     define variable v-cntxt-userid        as character no-undo .
       85     define variable v-cntxt-level         as character no-undo .
       86     define variable v-cntxt-host-code-obj as integer   no-undo .
       87     define variable v-cntxt-obj-type      as character no-undo .
       88     define variable v-cntxt-obj-code      as integer   no-undo .
       89     define variable v-cntxt-db-num-obj    as integer   no-undo .
       90     define variable v-cntxt-is-admin      as logical   no-undo .
       91   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92     run mainmenu_getcntxt in parparentproc
       93       (output v-cntxt-db-num
       94       ,output v-cntxt-userid
       95       ,output v-cntxt-level
       96       ,output v-cntxt-host-code-obj
       97       ,output v-cntxt-obj-type
       98       ,output v-cntxt-obj-code
       99       ,output v-cntxt-db-num-obj
      100       ,output v-cntxt-is-admin
      101       ) .
      102   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define temp-table x_obj-group no-undo like ub.clients  .
      104   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      105   procedure metod-gop-obj :
      106     do
      107     on error undo, return error return-value
      108     :
      109   define input  parameter p-cntxt-db-num as integer   no-undo .
      110   define input  parameter p-gop-id       as integer   no-undo .
      111   define input  parameter p-gop-db-num   as integer   no-undo .
      112   define buffer buf1_clients for ub.clients  .
      113   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      114   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      115   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      116   for each  x_obj-group : delete x_obj-group. end.
      117   if p-gop-id = 0 or p-gop-id = ?  then do:
      118      if p-cntxt-db-num = 0  then do:
      119           for each buf1_clients no-lock where
      120                   (buf1_clients.obj-type = 'маг':U  or
      121                    buf1_clients.obj-type = 'скл':U  )
      122                   and
      123                   buf1_clients.db-num >= 0  and
      124                   buf1_clients.stts = 0
      125                   :
      126             create x_obj-group .
      127             assign
      128               x_obj-group.obj-code   = buf1_clients.obj-code
      129               x_obj-group.obj-type   = buf1_clients.obj-type
      130               x_obj-group.obj-name   = buf1_clients.obj-name
      131               x_obj-group.db-num     = buf1_clients.db-num
      132             .
      133           end.
      134      end.
      135      else do:
      136           for each buf1_clients no-lock where
      137                   (buf1_clients.obj-type = 'маг':U  or
      138                    buf1_clients.obj-type = 'скл':U  ) and
      139                    buf1_clients.db-num = p-cntxt-db-num  and
      140                    buf1_clients.stts = 0
      141                   :
      142             create x_obj-group .
      143             assign
      144               x_obj-group.obj-code   = buf1_clients.obj-code
      145               x_obj-group.obj-type   = buf1_clients.obj-type
      146               x_obj-group.obj-name   = buf1_clients.obj-name
      147               x_obj-group.db-num     = buf1_clients.db-num
      148             .
      149           end.
      150      end.
      151   end.
      152   else do:
      153         for each buf_db-grp-obj-price  where
      154                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      155                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      156                 buf_db-grp-obj-price.stts = 0  no-lock :
      157           for each buf1_clients no-lock where
      158                  (buf1_clients.obj-type = 'маг':U  or
      159                   buf1_clients.obj-type = 'скл':U  ) and
      160                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      161                   buf1_clients.stts = 0
      162                   :
      163             create x_obj-group .
      164             assign
      165               x_obj-group.obj-code   = buf1_clients.obj-code
      166               x_obj-group.obj-type   = buf1_clients.obj-type
      167               x_obj-group.obj-name   = buf1_clients.obj-name
      168               x_obj-group.db-num     = buf1_clients.db-num
      169             .
      170           end.
      171         end.
      172       for each buf_host-grp-obj-price where
      173               buf_host-grp-obj-price.gop-id     = p-gop-id and
      174               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      175               buf_host-grp-obj-price.stts = 0
      176               no-lock :
      177         for each buf1_clients no-lock where
      178                (buf1_clients.obj-type = 'маг':U  or
      179                 buf1_clients.obj-type = 'скл':U  ) and
      180                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      181                 buf1_clients.stts = 0
      182                 :
      183             find first x_obj-group no-lock  where
      184                       x_obj-group.obj-code   = buf1_clients.obj-code and
      185                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      186             if not available  x_obj-group then   create x_obj-group .
      187             assign
      188               x_obj-group.obj-code   = buf1_clients.obj-code
      189               x_obj-group.obj-type   = buf1_clients.obj-type
      190               x_obj-group.obj-name   = buf1_clients.obj-name
      191               x_obj-group.db-num     = buf1_clients.db-num
      192             .
      193         end.
      194       end.
      195       for each buf_obj-grp-obj-price where
      196               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      197               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      198               buf_obj-grp-obj-price.stts = 0
      199               no-lock :
      200         for each buf1_clients no-lock where
      201                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      202                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      203                   buf1_clients.stts     = 0
      204                   :
      205             find first  x_obj-group no-lock  where
      206                         x_obj-group.obj-code   = buf1_clients.obj-code and
      207                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      208             if not available  x_obj-group then   create x_obj-group .
      209             assign
      210               x_obj-group.obj-code   = buf1_clients.obj-code
      211               x_obj-group.obj-type   = buf1_clients.obj-type
      212               x_obj-group.obj-name   = buf1_clients.obj-name
      213               x_obj-group.db-num     = buf1_clients.db-num
      214             .
      215         end.
      216       end.
      217   end.
      218   end.
      219   end procedure.
      220   procedure metod-obj-in-gop :
      221   define input  parameter p-curr-db-num as integer   no-undo .
      222   define input  parameter p-obj-type as character no-undo .
      223   define input  parameter p-obj-code as integer   no-undo .
      224   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      225     do
      226     on error undo, return error return-value
      227     :
      228       empty temp-table x_grp-obj-price.
      229       for each buf_grp-obj-price where
      230                buf_grp-obj-price.stts = 0
      231                no-lock :
      232                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      233                  for each x_obj-group where
      234                           x_obj-group.obj-type = p-obj-type and
      235                           x_obj-group.obj-code = p-obj-code :
      236                       create  x_grp-obj-price.
      237                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      238                  end.
      239       end.
      240     end.
      241   end procedure.
      242   procedure metod-delobj-usr :
      243   define input  parameter p-pdf-id  as integer   no-undo .
      244   define input  parameter p-pdf-db  as integer   no-undo .
      245   define input  parameter p-plt-id  as integer   no-undo .
      246   define input  parameter p-plt-db-num as integer   no-undo .
      247   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      248     do
      249     on error undo, return error return-value
      250     :
      251   for each buf_price-doc-forming-attr no-lock  where
      252            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      253            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      254            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      255            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      256            buf_price-doc-forming-attr.attr-code begins "obj" :
      257      for each x_obj-group  where
      258               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      259               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      260        delete x_obj-group.
      261      end.
      262   end.
      263     if not can-find (first x_obj-group) then do:
      264        return "nullobj" .
      265     end.
      266   end.
      267   end procedure.
      268   procedure metod-obj-pdf :
      269   define input  parameter p-cntxt-db-num as integer   no-undo .
      270   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      271   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      272   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      273   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      274   define buffer buf_price-list-type for ub.price-list-type  .
      275   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      276     do
      277     on error undo, return error return-value
      278     :
      279    for each  x_obj-group : delete x_obj-group. end.
      280    find first buf_price-list-type no-lock where
      281               buf_price-list-type.plt-id = p-plt-id and
      282               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      283   if error-status :error then return error return-value .
      284    find first buf_price-doc-forming no-lock where
      285               buf_price-doc-forming.plt-id     = p-plt-id and
      286               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      287               buf_price-doc-forming.pdf-id     = p-pdf-id and
      288               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      289               no-error .
      290   if error-status :error then return error return-value .
      291     run metod-gop-obj in this-procedure (
      292         p-cntxt-db-num,
      293         buf_price-list-type.gop-id ,
      294         buf_price-list-type.gop-db-num
      295         ) no-error .
      296     run metod-delobj-usr in this-procedure (
      297       buf_price-doc-forming.pdf-id ,
      298       buf_price-doc-forming.pdf-db ,
      299       buf_price-doc-forming.plt-id ,
      300       buf_price-doc-forming.plt-db-num
      301       ) no-error .
      302     end.
      303   end procedure.
      304   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   define variable v-waitfram-action01         as character   no-undo .
      306   define variable v-waitfram-action02         as character   no-undo .
      307   define variable v-waitfram-action03         as character   no-undo .
      308   define variable mWaitFramTextBeg            as character   no-undo.
      309   define variable mWaitFramTextEnd            as character   no-undo.
      310   define variable mWaitFramView               as logical     no-undo.
      311   define variable mWaitProcEvent              as logical     no-undo init yes.
      312   define variable mWaitFramInterval           as integer     no-undo init 1 .
      313   define variable mWaitFramStop               as logical     no-undo.
      314   define variable mWaitFramStopUser           as logical     no-undo.
      315   define variable mWaitFramStopTimeOut        as logical     no-undo.
      316   define variable mWaitFramStartProc          as datetime-tz no-undo.
      317   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      318   define button B-WaitFramStop auto-end-key
      319        label "Стоп"
      320        size 10 by 1 tooltip "Остоновить процесс".
      321   define button B-viewProcInfo
      322        label "Информация"
      323        size 15 by 1 tooltip "Информация о процесс".
      324   define frame waitfram
      325     v-waitfram-action01 format "x(72)" no-label skip
      326     v-waitfram-action02 format "x(72)" no-label skip
      327     v-waitfram-action03 format "x(72)" no-label skip
      328     B-viewProcInfo
      329     B-WaitFramStop at row 4 col 30
      330     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      331     .
      332   define new global shared variable mBatchMode as logical no-undo init ?.
      333   define variable mFramBachModHandle as handle no-undo.
      334   mFramBachModHandle = frame waitfram:handle.
      335   define variable mFameOldVis as logical no-undo.
      336   define variable mVisCUrentVin as logical no-undo.
      337   if session:batch-mode
      338   then
      339      mBatchMode = yes.
      340   if mBatchMode = ? then do:
      341     mVisCUrentVin = current-window:visible.
      342     mFameOldVis = mFramBachModHandle:visible.
      343     mFramBachModHandle:visible  = yes.
      344     mBatchMode = mFramBachModHandle:visible ne yes.
      345     mFramBachModHandle:visible = mFameOldVis.
      346     current-window:visible = mVisCUrentVin.
      347   end.
      348    if  log-manager:logfile-name ne ?
      349     then DO:
      350         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      351         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      352         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      353     end.
      354   on choose of B-WaitFramStop in frame waitfram
      355   do:
      356     mWaitFramStop = yes.
      357     mWaitFramStopUser = yes.
      358   end.
      359   function waitfram-check-timeout returns logical():
      360      define variable vtime as int64 no-undo.
      361      if mWaitFramStopTimeOut
      362      then
      363         return yes.
      364      vtime = ( now - mWaitFramStartProc ) / 1000 .
      365      if     mWaitFramTimeOut ne ?
      366         and mWaitFramTimeOut ne 0
      367         and mWaitFramTimeOut lt vtime
      368      then do:
      369         mWaitFramStopTimeOut = yes.
      370      end.
      371      return mWaitFramStopTimeOut.
      372   end.
      373   procedure waitfram-hide :
      374     if not session:batch-mode
      375     then do
      376     on error undo, return error return-value
      377     :
      378       pause 0 before-hide .
      379       if not mBatchMode then
      380         hide frame waitfram .
      381     if     not mWaitFramView
      382        and mWaitProcEvent
      383     then
      384       process events .
      385     end.
      386   end procedure.
      387   procedure waitfram-show :
      388     define input  parameter p-message as character no-undo .
      389     define variable v-left-margin as integer   no-undo .
      390     if not session:batch-mode
      391     then do
      392     on error undo, return error return-value
      393     :
      394       if length(p-message) <= 70 then do:
      395         assign
      396           v-left-margin = integer((70 - length(p-message)) / 2)
      397         .
      398         assign
      399           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      400         .
      401         assign
      402           v-waitfram-action01 = " "
      403           v-waitfram-action02 = " "
      404                                    + fill(" ", v-left-margin)
      405                                    + p-message
      406           v-waitfram-action03 = " "
      407         .
      408       end.
      409       else do:
      410         define variable vRindex1 as integer no-undo.
      411         define variable vRindex2 as integer no-undo.
      412         vRindex1 = r-index(p-message," ",70).
      413         if vRindex1 = 0
      414         then
      415            vRindex1 = 70.
      416         if length(p-message)  <= vRindex1 + 70 then do:
      417           assign
      418             v-waitfram-action01 = " "
      419             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      420             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      421           .
      422         end.
      423         else do:
      424           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      425           if vRindex2 <= vRindex1
      426           then
      427              vRindex2 = vRindex1 + 70.
      428           assign
      429             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      430             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      431             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      432           .
      433         end.
      434       end.
      435       B-viewProcInfo:visible   in frame waitfram = no.
      436       B-viewProcInfo:sensitive in frame waitfram = no.
      437       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      439       if  (   mWaitFramView
      440          or  mWaitProcEvent)
      441          and not mBatchMode
      442       then
      443          display
      444             v-waitfram-action01 skip
      445             v-waitfram-action02 skip
      446             v-waitfram-action03 skip
      447          with frame waitfram .
      448       if     mWaitFramView
      449          then do:
      450             if     mWaitFramInterval ne ?
      451                and not mBatchMode
      452             then
      453                wait-for go of frame waitfram pause mWaitFramInterval.
      454          end.
      455          else
      456             if     mWaitProcEvent
      457                and not mBatchMode
      458             then
      459                process events .
      460     end.
      461   end procedure.
      462      procedure waitfram-show-this:
      463         define input  parameter iInterval as int64 no-undo.
      464         define variable vtime as int64 no-undo.
      465         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      466         mWaitFramInterval = iInterval.
      467         run waitfram-show (substitute("&1&2 &3&4" ,
      468                                       mWaitFramTextBeg ,
      469                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      470                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      471                                       mWaitFramTextEnd
      472                                      )
      473                           ).
      474      end.
      475      procedure WaitFramRunPause:
      476         define input  parameter iInterval as dec no-undo.
      477         define variable vStart  as datetime-tz no-undo.
      478         define variable vend    as datetime-tz no-undo.
      479         define variable vint as int64 no-undo.
      480         define variable vOk as logical no-undo.
      481         vStart = now.
      482         vend   = vStart.
      483         publish "WaitFramPause" (iInterval,output vOk).
      484         vend   =  now.
      485         vint = vend - vStart.
      486         vint = iInterval - vint / 1000.
      487         if     not mWaitFramStop
      488            and (   vint > 0
      489                 or (    not vOk
      490                     and iInterval eq ?
      491                     )
      492                 )
      493         then
      494            run waitfram-show-this (iInterval).
      495         vend   =  now.
      496         vint = vend - vStart.
      497         vint = iInterval - vint / 1000.
      498         if     not mWaitFramStop
      499            and vint > 0
      500         then do:
      501            run gbl/pause.p (vint * 1000).
      502         end.
      503         if iInterval ne ?
      504         then
      505            publish "WaitFramStop".
      506         waitfram-check-timeout().
      507      end.
      508      procedure WaitFramWaitFor:
      509         define input  parameter iInterval as dec no-undo.
      510         assign
      511            mWaitFramStartProc   = now
      512            mWaitFramStopUser    = no
      513            mWaitFramStopTimeOut = no
      514         .
      515         block-wait:
      516         do while not mWaitFramStop:
      517            run WaitFramRunPause (iInterval).
      518            if  waitfram-check-timeout()
      519            then do:
      520               leave block-wait.
      521            end.
      522         end.
      523         run waitfram-hide.
      524      end.
      525   procedure waitfram-join :
      526     define input  parameter p-line-1  as character no-undo .
      527     define input  parameter p-line-2  as character no-undo .
      528     define input  parameter p-line-3  as character no-undo .
      529     define output parameter p-message as character no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       assign
      534         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      536                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      537       .
      538     end.
      539   end procedure.
      540   function waitfram-join-function returns character
      541     (input p-line-1 as character
      542     ,input p-line-2 as character
      543     ,input p-line-3 as character
      544     ).
      545     define variable v-message as character no-undo .
      546     run waitfram-join in this-procedure
      547       (input  p-line-1
      548       ,input  p-line-2
      549       ,input  p-line-3
      550       ,output v-message
      551       ) .
      552     return v-message .
      553   end function .
