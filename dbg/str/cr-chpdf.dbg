      764   run waitfram-hide in this-procedure  .
      765   procedure new-price :
      766   define input  parameter  p-increase-pc      as decimal   no-undo .
      767   define input  parameter  p-round-method     as character no-undo .
      768   define input  parameter  p-round-base       as decimal   no-undo .
      769   define input  parameter  p-price-calc-doc   as decimal   no-undo .
      770   define input  parameter  p-price-calc-rubl  as decimal   no-undo .
      771   define input  parameter  p-price-calc-base  as decimal   no-undo .
      772   define output parameter  p-price-sale-doc   as decimal   no-undo .
      773   define output parameter  p-price-sale-rubl  as decimal   no-undo .
      774   define output parameter  p-price-sale-base  as decimal   no-undo .
      775     do
      776     on error undo, return error return-value
      777     :
      778      p-price-sale-doc   = p-price-calc-doc  * ( 1 + ( p-increase-pc / 100 )) .
      779      p-price-sale-rubl  = p-price-calc-rubl * ( 1 + ( p-increase-pc / 100 )) .
      780      p-price-sale-base  = p-price-calc-base * ( 1 + ( p-increase-pc / 100 )) .
      781   case p-round-method :
      782     when '9-окончание':U then do:
      783       if p-price-sale-doc < 29 then do:
      784         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
      785           assign
      786             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
      787           .
      788         end.
      789       end.
      790       else do:
      791         if (p-price-sale-doc modulo 10) < 3 then do:
      792           assign
      793             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
      794                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
      795                   - 1 ) * 10
      796                 + 9
      797           .
      798         end.
      799         else do:
      800           assign
      801             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
      802                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
      803                   ) * 10
      804                 + 9
      805           .
      806         end.
      807         assign
      808           p-price-sale-doc = round (p-price-sale-doc, 0)
      809         .
      810       end.
      811     end.
      812     when '9-99окончание':U then do:
      813       if p-price-sale-doc < p-round-base then do:
      814         assign
      815           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
      816         .
      817       end.
      818       else do:
      819         assign
      820           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
      821         .
      822       end.
      823     end.
      824     when 'Без-дробных':U then do:
      825       assign
      826         p-price-sale-doc = round (p-price-sale-doc, 0)
      827       .
      828     end.
      829     when 'Произвольно':U then do:
      830       if p-round-base <> 0 then do:
      831         assign
      832           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
      833         .
      834         if p-price-sale-doc = 0 then do:
      835           assign
      836             p-price-sale-doc = p-round-base
      837           .
      838         end.
      839       end.
      840     end.
      841     when 'Вверх':U then do:
      842       if p-round-base <> 0 then do:
      843         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
      844           assign
      845             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
      846           .
      847         end.
      848       end.
      849       if p-price-sale-doc = 0 then do:
      850         assign
      851           p-price-sale-doc = p-round-base
      852         .
      853       end.
      854     end.
      855     when 'Коэффициент':U then do:
      856       if p-round-base <> 0 then do:
      857         assign
      858           p-price-sale-doc = p-price-sale-doc * p-round-base
      859         .
      860       end.
      861     end.
      862     when 'Отключено':U then do:
      863     end.
      864     otherwise do:
      865       message
      866         vss-workfile vss-revision vss-description skip
      867         "Неизвестный метод округления продажной цены" skip
      868         "round-method" p-round-method skip
      869         "round-base"   p-round-base   skip
      870         "price"        p-price-sale-doc             skip
      871         view-as alert-box error .
      872     end.
      873   end.
      874   case p-round-method :
      875     when '9-окончание':U then do:
      876       if p-price-sale-rubl < 29 then do:
      877         if (p-price-sale-rubl - truncate (p-price-sale-rubl, 0)) <> 0 then do:
      878           assign
      879             p-price-sale-rubl = truncate (p-price-sale-rubl, 0) + 1
      880           .
      881         end.
      882       end.
      883       else do:
      884         if (p-price-sale-rubl modulo 10) < 3 then do:
      885           assign
      886             p-price-sale-rubl = (p-price-sale-rubl - (p-price-sale-rubl modulo 100))
      887                 + ( truncate (((p-price-sale-rubl modulo 100) / 10), 0)
      888                   - 1 ) * 10
      889                 + 9
      890           .
      891         end.
      892         else do:
      893           assign
      894             p-price-sale-rubl = (p-price-sale-rubl - (p-price-sale-rubl modulo 100))
