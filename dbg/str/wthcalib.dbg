        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: wthcalib.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: str/wthcalib.p $":U .
        7   define variable vss-description as character no-undo initial "Библиотека процедур для работы с атрибутами документа МЦ":U.
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure wthcattr-sprcli :
       67   define input parameter parparentproc  as widget-handle no-undo.
       68   define input parameter p-mode  as character no-undo.
       69   define input-output parameter p-value as character no-undo .
       70   define output parameter p-setted as logical no-undo .
       71     DEFINE VARIABLE v-value as character no-undo .
       72     define variable v-cli-type as character no-undo .
       73     define variable v-cli-code as integer no-undo .
       74     define buffer buf_clients   for ub.clients.
       75     define variable v_rid as character no-undo.
       76     define variable ref-rec as recid no-undo .
       77     do
       78     on error undo, return error
       79     :
       80         v-value = p-value.
       81      if p-value <> '':U then do:
       82       assign
       83       v-cli-type = substring(p-value, 1, 3)
       84       v-cli-code = integer(substring(p-value, 4))
       85       no-error.
       86       if error-status:error then do:
       87         assign
       88         v-cli-type = '':U
       89         v-cli-code = 0
       90         .
       91       end.
       92      end.
       93      FIND FIRST buf_clients NO-LOCK WHERE
       94               buf_clients.obj-type = v-cli-type AND
       95               buf_clients.obj-code = v-cli-code  NO-ERROR.
       96      IF available(buf_clients) then do:
       97       run ref/cli-all.w (
       98                   input parparentproc
       99                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      100                  ,input v-cli-type
      101                  ,input 'все':U
      102                  ,input 'все':U
      103                  ,input RECID( buf_clients )
      104                  ,input ",,,,,,NO"
      105                  ,input ?
      106                  ,OUTPUT v_rid ).
      107     END.
      108     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      109       run ref/cli-all.w (
      110                    input parparentproc
      111                   ,INPUT "b-sel":U
      112                  ,input  v-cli-type
      113                  ,input 'все':U
      114                  ,input 'текущие':U
      115                  ,input ?
      116                  ,input ",,,,,,NO"
      117                  ,input ?
      118                  ,OUTPUT v_rid ).
      119     END.
      120     else do:
      121       message
      122       if p-value = "":U then 'Атрибут не задан!'
      123       else substitute('Не найден клиент &1',p-value)
      124       view-as alert-box warning.
      125     end.
      126     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      127       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      128       IF ERROR-STATUS:ERROR THEN DO:
      129           RETURN NO-APPLY.
      130       END.
      131       FIND FIRST buf_clients NO-LOCK WHERE
      132                  RECID( buf_clients ) = ref-rec NO-ERROR.
      133       IF AVAIL buf_clients THEN DO:
      134         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      135       end.
      136     end.
      137     if v-value <> p-value then do:
      138       p-value = v-value.
      139       p-setted = yes.
      140     end.
      141     end.
      142   end procedure.
      143     define new global shared variable g#wthcalib as handle no-undo.
      144   if valid-handle( g#wthcalib ) and g#wthcalib <> this-procedure :handle then do:
      145     message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 0 ) vss-description skip( 1 )
      146             "wthcalib.p: попытка повторной загрузки библиотеки" skip( 1 )
      147             g#wthcalib                     skip( 0 )
      148             g#wthcalib     :type           skip( 0 )
      149             g#wthcalib     :file-name      skip( 0 )
      150             valid-handle( g#wthcalib     ) skip( 0 )
      151             this-procedure :handle         skip( 0 )
      152             this-procedure :type           skip( 0 )
      153             this-procedure :file-name      skip( 0 )
      154             valid-handle( this-procedure ) skip( 0 )
      155     view-as alert-box error title " О Ш И Б К А  ! ! ! ".
      156     undo, return error "wthcalib.p: попытка повторной загрузки библиотеки".
      157   end.
      158   else do:
      159     assign
      160       g#wthcalib = this-procedure :handle
      161     .
      162   end.
      163   on delete of this-procedure do:
      164     assign
      165       g#wthcalib = ?
      166     .
      167   end.
      168   procedure wthcalib_wthat-val :
      169     define  input parameter p-doc-code like ub.wth-doc-attr.doc-code   no-undo.
      170     define  input parameter p-code     like ub.wth-doc-attr.attr-code  no-undo.
      171     define output parameter p-value    like ub.wth-doc-attr.attr-value no-undo.
      172     define output parameter p-type     as   character              no-undo.
      173     define buffer buf_wth-doc-attr for ub.wth-doc-attr.
      174     define variable v-format         as character no-undo.
      175     define variable v-fillin_width   as integer   no-undo.
      176     define variable v-fillin_height  as integer   no-undo.
      177     define variable v-label          as character no-undo.
      178     define variable v-user-can-edit  as logical   no-undo.
      179     define variable v-output-display as logical   no-undo.
      180     define variable v-other          as character no-undo.
      181     do on error undo, return error return-value :
      182   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input p-code ,
      183                          output p-type ,
      184                          output v-format ,
      185                          output v-fillin_width ,
      186                          output v-fillin_height ,
      187                          output v-label ,
      188                          output v-user-can-edit ,
      189                          output v-output-display ,
      190                          output v-other ) no-error .
      191       if error-status :error then do: undo, return error return-value. end.
      192       find first buf_wth-doc-attr no-lock where
      193                  buf_wth-doc-attr.doc-code  = p-doc-code and
      194                  buf_wth-doc-attr.attr-code = p-code     no-error.
      195       assign p-value = ( if available buf_wth-doc-attr then buf_wth-doc-attr.attr-value else
      196                        ( if p-type = 'L':U then "no":U else "":U ) ).
      197     end.
      198   end procedure.
      199   procedure wthcalib_wthat-wrt :
      200     define input parameter p-doc-code like ub.wth-doc-attr.doc-code   no-undo.
      201     define input parameter p-code     like ub.wth-doc-attr.attr-code  no-undo.
      202     define input parameter p-value    like ub.wth-doc-attr.attr-value no-undo.
      203     define buffer buf_wth-doc-attr for ub.wth-doc-attr.
      204     define variable v-type           as character no-undo.
      205     define variable v-format         as character no-undo.
      206     define variable v-fillin_width   as integer   no-undo.
      207     define variable v-fillin_height  as integer   no-undo.
      208     define variable v-label          as character no-undo.
      209     define variable v-user-can-edit  as logical   no-undo.
      210     define variable v-output-display as logical   no-undo.
      211     define variable v-other          as character no-undo.
      212     do on error undo, return error return-value :
      213   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input p-code ,
      214                          output v-type ,
      215                          output v-format ,
      216                          output v-fillin_width ,
      217                          output v-fillin_height ,
      218                          output v-label ,
      219                          output v-user-can-edit ,
      220                          output v-output-display ,
      221                          output v-other ) no-error .
      222       if error-status :error then do: undo, return error return-value. end.
      223       find first buf_wth-doc-attr exclusive-lock where
      224                  buf_wth-doc-attr.doc-code  = p-doc-code and
      225                  buf_wth-doc-attr.attr-code = p-code     no-error.
      226       if not available buf_wth-doc-attr then do:
      227         create buf_wth-doc-attr.
      228         assign buf_wth-doc-attr.doc-code  = p-doc-code
      229                buf_wth-doc-attr.attr-code = p-code.
      230       end.
      231       assign buf_wth-doc-attr.attr-value = p-value.
      232     end.
      233   end procedure.
      234   procedure wthcalib_wthat-xst :
      235     define  input parameter p-doc-code like ub.wth-doc-attr.doc-code  no-undo.
      236     define  input parameter p-code     like ub.wth-doc-attr.attr-code no-undo.
      237     define output parameter p-exist    as   logical               no-undo.
      238     define buffer buf_wth-doc-attr for ub.wth-doc-attr.
      239     define variable v-type           as character no-undo.
      240     define variable v-format         as character no-undo.
      241     define variable v-fillin_width   as integer   no-undo.
      242     define variable v-fillin_height  as integer   no-undo.
      243     define variable v-label          as character no-undo.
      244     define variable v-user-can-edit  as logical   no-undo.
      245     define variable v-output-display as logical   no-undo.
      246     define variable v-other          as character no-undo.
      247     do on error undo, return error return-value :
      248   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input p-code ,
      249                          output v-type ,
      250                          output v-format ,
      251                          output v-fillin_width ,
      252                          output v-fillin_height ,
      253                          output v-label ,
      254                          output v-user-can-edit ,
      255                          output v-output-display ,
      256                          output v-other ) no-error .
      257       if error-status :error then do: undo, return error return-value. end.
      258       find first buf_wth-doc-attr no-lock where
      259                  buf_wth-doc-attr.doc-code  = p-doc-code and
      260                  buf_wth-doc-attr.attr-code = p-code     no-error.
      261       if available buf_wth-doc-attr then do: p-exist = yes. end.
      262     end.
      263   end procedure.
      264   procedure wthcalib_wthat-del:
      265     define  input parameter p-doc-code like ub.wth-doc-attr.doc-code  no-undo.
      266     define  input parameter p-code     like ub.wth-doc-attr.attr-code no-undo.
      267     define output parameter p-deleted  as   logical               no-undo.
      268     define buffer buf_wth-doc-attr for ub.wth-doc-attr.
      269     define variable v-type           as character no-undo.
      270     define variable v-format         as character no-undo.
      271     define variable v-fillin_width   as integer   no-undo.
      272     define variable v-fillin_height  as integer   no-undo.
      273     define variable v-label          as character no-undo.
      274     define variable v-user-can-edit  as logical   no-undo.
      275     define variable v-output-display as logical   no-undo.
      276     define variable v-other          as character no-undo.
      277     do on error undo, return error return-value :
      278   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input p-code ,
      279                          output v-type ,
      280                          output v-format ,
      281                          output v-fillin_width ,
      282                          output v-fillin_height ,
      283                          output v-label ,
      284                          output v-user-can-edit ,
      285                          output v-output-display ,
      286                          output v-other ) no-error .
      287       if error-status :error then do: undo, return error return-value. end.
      288       find first buf_wth-doc-attr exclusive-lock where
      289                  buf_wth-doc-attr.doc-code  = p-doc-code and
      290                  buf_wth-doc-attr.attr-code = p-code     no-error no-wait.
      291       if not available buf_wth-doc-attr then do:
      292         assign p-deleted = no.
      293       end.
      294       else do:
      295         assign buf_wth-doc-attr.attr-value = '':U.
      296              assign p-deleted = yes.
      297       end.
      298     end.
      299   end procedure.
      300   procedure wthcalib_wthat-cod :
      301     define  input parameter p-code           as character no-undo.
      302     define output parameter p-type           as character no-undo.
      303     define output parameter p-format         as character no-undo.
      304     define output parameter p-fillin_width   as integer   no-undo.
      305     define output parameter p-fillin_height  as integer   no-undo.
      306     define output parameter p-label          as character no-undo.
      307     define output parameter p-user-can-edit  as logical   no-undo.
      308     define output parameter p-output-display as logical   no-undo.
      309     define output parameter p-other          as character no-undo.
      310     do on error undo, return error return-value :
      311       case p-code :
      312               when 'wthdsf':U then do:     assign p-label          = "Дата счета-фактуры"            p-type           = 'T':U            p-format         = "99/99/9999"            p-fillin_width   = 11            p-fillin_height  = 1            p-label          = "Дата счета-фактуры"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      313               when 'wthnsf':U then do:     assign p-label          = "Номер счета-фактуры"            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Номер счета-фактуры"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      314               when 'wthproxy':U then do:     assign p-label          = "Доверенность"            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Доверенность"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      315               when 'wthpaydoc':U then do:     assign p-label          = "Платежно-расчетный документ "            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Платежно-расчетный документ "            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      316               when 'wthreceiver':U then do:     assign p-label          = "Мат. ответственное лицо контрагента"            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Мат. ответственное лицо контрагента"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      317               when 'wthreason':U then do:     assign p-label          = "Основание"            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Основание"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws':u .   end.
      318               when 'wthconsignee':U then do:     assign p-label          = "Грузополучатель"            p-type           = 'C':U            p-format         = "x(70)"            p-fillin_width   = 71            p-fillin_height  = 1            p-label          = "Грузополучатель"            p-user-can-edit  = true            p-output-display = true            p-other          = 'nws/spr=wthcattr-sprcli':u .   end.
      319         otherwise do:
      320           undo, return error substitute( 'неизвестный атрибут документа "&1"', p-code ).
      321         end.
      322       end case.
      323     end.
      324   end procedure.
      325   procedure wthcalib_wthat-oth :
      326     define input parameter p-doc-code as character no-undo.
      327     define input parameter p-code     as character no-undo.
      328     define input parameter p-value    as character no-undo.
      329     define variable v-type           as character no-undo.
      330     define variable v-format         as character no-undo.
      331     define variable v-fillin_width   as integer   no-undo.
      332     define variable v-fillin_height  as integer   no-undo.
      333     define variable v-label          as character no-undo.
      334     define variable v-user-can-edit  as logical   no-undo.
      335     define variable v-output-display as logical   no-undo.
      336     define variable v-other          as character no-undo.
      337     define buffer buf_wth-doc-attr for ub.wth-doc-attr.
      338     define buffer bf_wth-doc   for ub.wth-doc.
      339     do on error undo, return error return-value :
      340   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-cod in g#wthcalib (  input p-code ,
      341                          output v-type ,
      342                          output v-format ,
      343                          output v-fillin_width ,
      344                          output v-fillin_height ,
      345                          output v-label ,
      346                          output v-user-can-edit ,
      347                          output v-output-display ,
      348                          output v-other )  .
      349       if lookup( "nws":U, v-other,chr(47) ) > 0 then do:
      350         find first bf_wth-doc no-lock where
      351                    bf_wth-doc.doc-code = p-doc-code  no-error.
      352         if available bf_wth-doc and bf_wth-doc.status_ = 'факт':U then do:
      353           find first buf_wth-doc-attr no-lock where
      354                      buf_wth-doc-attr.doc-code  = p-doc-code and
      355                      buf_wth-doc-attr.attr-code = p-code     no-error.
      356           run str/callnews.p ( input "wth-doc-attr", input ( buffer buf_wth-doc-attr :handle ) ) no-error.
      357           if error-status :error then do:
      358             message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      359                     "Невозможно маршрутизировать wth-doc-attr для отправки в новости" skip( 0 )
      360                     "Документ:" '"' + bf_wth-doc.doc-code    + '"' skip( 0 )
      361                     "Атрибут:"  '"' + buf_wth-doc-attr.attr-code + '"' skip( 0 )
      362                     error-status :get-message( 1 ) skip( 0 )
      363                     error-status :get-message( 2 ) skip( 0 )
      364                     error-status :get-message( 3 ) skip( 0 )
      365                     "return-value = " return-value skip( 0 )
      366             view-as alert-box error.
      367             undo, return error return-value.
      368           end.
      369         end.
      370       end.
      371     end.
      372   end procedure.
