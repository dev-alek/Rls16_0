        1   define input  parameter p-artic as character no-undo .
        2   define input  parameter p-prod  as character no-undo .
        3   define input  parameter p-NAME  as character no-undo .
        4   define input  parameter p-gtd as character   no-undo .
        5   define input-output parameter p-add-gtd   as character   no-undo .
        6   define output parameter p-res   as logical   no-undo .
        7   def var vss-revision    as character no-undo init "$Revision$":u .
        8   def var vss-author      as character no-undo init "$Author$":u .
        9   def var vss-date        as character no-undo init "$Date$":u .
       10   def var vss-workfile    as character no-undo init "$Workfile$":u .
       11   def var vss-archive     as character no-undo init "$Archive$":u .
       12   def var vss-description as character no-undo init "Изменение дополнения к ГТД" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   assign p-res = no .
      113   DEFINE BUTTON b-exit AUTO-GO
      114        LABEL "&Ввод"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON b-help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-quit AUTO-END-KEY
      122        LABEL "&Отмена"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE VARIABLE FILL-1 AS CHARACTER FORMAT "X(256)":U
      126        LABEL "Артикул"
      127         VIEW-AS TEXT
      128        SIZE 13 BY .67 NO-UNDO.
      129   DEFINE VARIABLE FILL-2 AS CHARACTER FORMAT "X(256)":U
      130        LABEL "Производитель"
      131         VIEW-AS TEXT
      132        SIZE 17 BY .67 NO-UNDO.
      133   DEFINE VARIABLE FILL-3 AS CHARACTER FORMAT "X(256)":U
      134        LABEL "Наименование"
      135         VIEW-AS TEXT
      136        SIZE 41 BY .67 NO-UNDO.
      137   DEFINE VARIABLE FILL-4 AS CHARACTER FORMAT "X(256)":U
      138        LABEL "ГТД накладной"
      139         VIEW-AS TEXT
      140        SIZE 37.5 BY .67 NO-UNDO.
      141   DEFINE VARIABLE FILL-5 AS CHARACTER FORMAT "X(15)":U
      142        LABEL "Дополнение к ГТД товара"
      143        VIEW-AS FILL-IN
      144        SIZE 28.5 BY 1 NO-UNDO.
      145   DEFINE FRAME Dialog-Frame
      146        b-exit AT ROW 1 COL 1
      147        b-quit AT ROW 1 COL 11
      148        b-help AT ROW 1 COL 41
      149        FILL-5 AT ROW 5.5 COL 1.5
      150        FILL-1 AT ROW 2.21 COL 9 COLON-ALIGNED
      151        FILL-2 AT ROW 2.21 COL 25
      152        FILL-3 AT ROW 3.42 COL 14 COLON-ALIGNED
      153        FILL-4 AT ROW 4.5 COL 15 COLON-ALIGNED
      154        SPACE(2.50) SKIP(1.63)
      155       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      156            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      157            TITLE "Дополнение к ГТД товара"
      158            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      159   ASSIGN
      160          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      161          FRAME Dialog-Frame:HIDDEN           = TRUE.
      162   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      163   DO:
      164     APPLY "END-ERROR":U TO SELF.
      165   END.
      166   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      167   DO:
      168     assign FILL-5 .
      169     assign
      170       p-add-gtd = FILL-5
      171       p-res   = yes .
      172     .
      173   END.
      174   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   on help of frame Dialog-Frame
      176   do:
      177     run gbl/app_help.p
      178       (input this-procedure :file-name
      179       ,input ''
      180       ,input ?
      181       ) no-error.
      182     if error-status :error then do:
      183       message
      184         "Ошибка при вызове помощи"
      185         error-status :get-message(1)
      186         view-as alert-box .
      187     end.
      188   end.
      189   run minbtn-set in this-procedure .
      190   on choose of b-help in frame Dialog-Frame
      191   do:
      192     apply "help":u to frame Dialog-Frame .
      193   end.
      194   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   procedure minbtn-set :
      196       do
      197           on error undo, return error return-value
      198           :
      199           define variable ii              as integer       no-undo .
      200           define variable fh              as widget-handle no-undo .
      201           define variable hh              as widget-handle no-undo .
      202           define variable v-h             as handle        extent 4 no-undo .
      203           define variable v-name-button   as character     no-undo .
      204           define variable v-help-old-x    as decimal       no-undo .
      205           define variable v-help-old-y    as decimal       no-undo .
      206           define variable v-help-old-size as decimal       no-undo .
      207           define variable v-frame-width   as decimal       no-undo .
      208           define variable jj              as integer       no-undo .
      209           do
      210               on error undo, return error
      211               :
      212               assign
      213                   v-frame-width = frame Dialog-Frame:width - 0.3
      214                   fh            = frame Dialog-Frame:first-child
      215                   hh            = fh:first-child
      216                   ii            = 1
      217                   .
      218               do while valid-handle(hh):
      219                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      220                   do:
      221                       case lc(hh:name) :
      222                           when "b-help" then
      223                               do:
      224                                   hh:load-image-up("cmp/b-help.bmp":u) .
      225                                   hh:load-image-down("cmp/b-help.bmp":u) .
      226                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      227                                   hh:TOOLTIP = "Помощь" .
      228                                   v-help-old-x = hh:column .
      229                                   v-help-old-y = hh:row    .
      230                                   v-help-old-size = hh:width .
      231                                   hh:width-chars = 2.5 .
      232                               end.
      233                           when "b-print" then
      234                               do:
      235                                   hh:load-image("cmp/b-print.bmp":u) .
      236                                   hh:TOOLTIP = "Печать" .
      237                                   v-h[ii] = hh:handle .
      238                                   ii = ii + 1 .
      239                                   hh:width-chars = 3 .
      240                               end.
      241                           when "b-history" or
      242                           when "b-hist" then
      243                               do:
      244                                   hh:load-image("cmp/b-hist.bmp":u) .
      245                                   hh:TOOLTIP = "История" .
      246                                   v-h[ii] = hh:handle .
      247                                   ii = ii + 1 .
      248                                   hh:width-chars = 3 .
      249                               end.
      250                           when "b-sch" then
      251                               do:
      252                                   hh:load-image("cmp/b-sch.bmp":u) .
      253                                   hh:TOOLTIP = "Установка Фильтра" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-hist-user" then
      259                               do:
      260                                   hh:load-image("cmp/b-hist.bmp":u) .
      261                                   hh:TOOLTIP = "История пользователя" .
      262                                   ii = ii + 1 .
      263                               end.
      264                       end case.
      265                   end.
      266                   hh = hh:next-sibling.
      267               end.
      268               b-help:column = v-frame-width - b-help:width-chars.
      269               jj = 0.
      270               repeat ii = 4 to 1 by -1 :
      271                   if valid-handle (v-h[ii] ) then
      272                   do:
      273                       jj  = jj + 1 .
      274                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      275                       v-h[ii]:row    = v-help-old-y .
      276                   end.
      277               end.
      278           end.
      279       end.
      280   end procedure.
      281   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      282   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      283   MAIN-BLOCK:
      284   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      285      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      286     assign
      287        FILL-1     = p-artic
      288        FILL-2     = p-prod
      289        FILL-3     = p-NAME
      290        FILL-4     = p-gtd
      291        FILL-5     = p-add-gtd
      292     .
      293     RUN enable_UI.
      294     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS FILL-5 .
      295   END.
      296   RUN disable_UI.
      297   PROCEDURE disable_UI :
      298     HIDE FRAME Dialog-Frame.
      299   END PROCEDURE.
      300   PROCEDURE enable_UI :
      301     DISPLAY FILL-5 FILL-1 FILL-2 FILL-3 FILL-4
      302         WITH FRAME Dialog-Frame.
      303     ENABLE b-exit b-quit b-help FILL-5 FILL-1 FILL-2 FILL-3 FILL-4
      304         WITH FRAME Dialog-Frame.
      305     VIEW FRAME Dialog-Frame.
      306   END PROCEDURE.
