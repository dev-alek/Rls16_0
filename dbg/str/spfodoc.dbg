        1   def var vss-revision    as character no-undo init "$Revision$":U .
        2   def var vss-author      as character no-undo init "$Author$":U .
        3   def var vss-date        as character no-undo init "$Date$":U .
        4   def var vss-workfile    as character no-undo init "$Workfile$":U .
        5   def var vss-archive     as character no-undo init "$Archive$":U .
        6   def var vss-description as character no-undo init " Экран предфинобязательств по документу   ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define   shared variable g#auto as logical no-undo.
       68   define   shared variable g#news as logical no-undo.
       69   define   shared variable g#oxml as logical no-undo.
       70   define   shared variable g#esys as logical no-undo.
       71   define   shared variable g#news-source-db as integer no-undo.
       72   define   shared variable g#esys-source-esys as integer no-undo.
       73   define   shared variable g#db-num as integer   no-undo .
       74   define   shared variable g#userid as character no-undo .
       75   define   shared variable g#passwd as character no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   DEFINE INPUT PARAMETER pardoc-code LIKE ub.trn-doc.doc-code NO-UNDO.
      122   DEFINE TEMP-TABLE tt-fo-before NO-UNDO LIKE ub.fin-ob-before
      123   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      124   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      125   DEFINE BUFFER bf_fin-ob-before FOR ub.fin-ob-before.
      126   DEFINE BUFFER bf_fin-gds-part  FOR ub.fin-gds-part.
      127   DEFINE BUFFER bf_parts         FOR ub.parts.
      128   DEFINE BUFFER bf_trn-doc       FOR ub.trn-doc.
      129   define buffer bf_goods         for ub.goods.
      130   DEFINE BUTTON b-exit AUTO-GO
      131        LABEL "&Выход"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-help
      135        LABEL "&Помощь"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE QUERY b-ob FOR
      139         tt-fo-before SCROLLING.
      140   DEFINE QUERY b-parts FOR
      141         bf_fin-gds-part,
      142         bf_goods,
      143         bf_parts SCROLLING.
      144   DEFINE BROWSE b-ob
      145     QUERY b-ob DISPLAY
      146         tt-fo-before.prn-doc-code  COLUMN-LABEL "Предфиноб."
      147     tt-fo-before.sum-base      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      148     tt-fo-before.sum-base-trn  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      149     tt-fo-before.sum-rubl      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      150     tt-fo-before.sum-rubl-trn  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      151     tt-fo-before.contract-code COLUMN-LABEL "Договор"
      152     tt-fo-before.doc-code      COLUMN-LABEL "Вн. код. фин. обяз."
      153     tt-fo-before.before-code   COLUMN-LABEL "Вн. код. предфин. обяз."
      154     tt-fo-before.trn-doc-code COLUMN-LABEL "Скл. док-т"
      155     tt-fo-before.trn-doc-code-orig COLUMN-LABEL "Прих. скл. док-т"
      156       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 9
      157            TITLE "Предфинобязательства" ROW-HEIGHT-CHARS .67.
      158   DEFINE BROWSE b-parts
      159     QUERY b-parts DISPLAY
      160         bf_parts.in-code COLUMN-LABEL "Прих. накл."
      161    bf_parts.part-code COLUMN-LABEL "Код партии"
      162    bf_parts.fact-qnty COLUMN-LABEL "Факт кол-во"
      163    bf_parts.price-base COLUMN-LABEL "Цена (вал)"
      164    bf_parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      165       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 9
      166            TITLE "Партии по предфинобязательству" ROW-HEIGHT-CHARS .67.
      167   DEFINE FRAME Dialog-Frame
      168        b-exit AT ROW 1 COL 1
      169        b-help AT ROW 1 COL 11.5
      170        b-ob AT ROW 2.25 COL 1
      171        b-parts AT ROW 11.5 COL 1
      172        SPACE(0.00) SKIP(0.50)
      173       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      174            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      175            TITLE "Предфинобязательства на которые повлиял данный складской документ"
      176            DEFAULT-BUTTON b-exit.
      177   ASSIGN
      178          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      179          FRAME Dialog-Frame:HIDDEN           = TRUE.
      180   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      181   DO:
      182     APPLY "END-ERROR":U TO SELF.
      183   END.
      184   ON VALUE-CHANGED OF b-ob IN FRAME Dialog-Frame
      185   DO:
      186     RUN open-parts-query IN THIS-PROCEDURE.
      187   END.
      188   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      189   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      190   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   on help of frame Dialog-Frame
      192   do:
      193     run gbl/app_help.p
      194       (input this-procedure :file-name
      195       ,input ''
      196       ,input ?
      197       ) no-error.
      198     if error-status :error then do:
      199       message
      200         "Ошибка при вызове помощи"
      201         error-status :get-message(1)
      202         view-as alert-box .
      203     end.
      204   end.
      205   run minbtn-set in this-procedure .
      206   on choose of b-help in frame Dialog-Frame
      207   do:
      208     apply "help":u to frame Dialog-Frame .
      209   end.
      210   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   procedure minbtn-set :
      212       do
      213           on error undo, return error return-value
      214           :
      215           define variable ii              as integer       no-undo .
      216           define variable fh              as widget-handle no-undo .
      217           define variable hh              as widget-handle no-undo .
      218           define variable v-h             as handle        extent 4 no-undo .
      219           define variable v-name-button   as character     no-undo .
      220           define variable v-help-old-x    as decimal       no-undo .
      221           define variable v-help-old-y    as decimal       no-undo .
      222           define variable v-help-old-size as decimal       no-undo .
      223           define variable v-frame-width   as decimal       no-undo .
      224           define variable jj              as integer       no-undo .
      225           do
      226               on error undo, return error
      227               :
      228               assign
      229                   v-frame-width = frame Dialog-Frame:width - 0.3
      230                   fh            = frame Dialog-Frame:first-child
      231                   hh            = fh:first-child
      232                   ii            = 1
      233                   .
      234               do while valid-handle(hh):
      235                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      236                   do:
      237                       case lc(hh:name) :
      238                           when "b-help" then
      239                               do:
      240                                   hh:load-image-up("cmp/b-help.bmp":u) .
      241                                   hh:load-image-down("cmp/b-help.bmp":u) .
      242                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      243                                   hh:TOOLTIP = "Помощь" .
      244                                   v-help-old-x = hh:column .
      245                                   v-help-old-y = hh:row    .
      246                                   v-help-old-size = hh:width .
      247                                   hh:width-chars = 2.5 .
      248                               end.
      249                           when "b-print" then
      250                               do:
      251                                   hh:load-image("cmp/b-print.bmp":u) .
      252                                   hh:TOOLTIP = "Печать" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-history" or
      258                           when "b-hist" then
      259                               do:
      260                                   hh:load-image("cmp/b-hist.bmp":u) .
      261                                   hh:TOOLTIP = "История" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-sch" then
      267                               do:
      268                                   hh:load-image("cmp/b-sch.bmp":u) .
      269                                   hh:TOOLTIP = "Установка Фильтра" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-hist-user" then
      275                               do:
      276                                   hh:load-image("cmp/b-hist.bmp":u) .
      277                                   hh:TOOLTIP = "История пользователя" .
      278                                   ii = ii + 1 .
      279                               end.
      280                       end case.
      281                   end.
      282                   hh = hh:next-sibling.
      283               end.
      284               b-help:column = v-frame-width - b-help:width-chars.
      285               jj = 0.
      286               repeat ii = 4 to 1 by -1 :
      287                   if valid-handle (v-h[ii] ) then
      288                   do:
      289                       jj  = jj + 1 .
      290                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      291                       v-h[ii]:row    = v-help-old-y .
      292                   end.
      293               end.
      294           end.
      295       end.
      296   end procedure.
      297   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      298   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      299   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      300   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      301   define variable v-diasize-current-frame-width  as decimal   no-undo .
      302   define variable v-diasize-current-frame-height as decimal   no-undo .
      303   define variable v-diasize-change-size          as logical   no-undo .
      304   define variable v-diasize-resize-button        as handle    no-undo .
      305   define variable v-diasize-wndmax               as logical   no-undo .
      306   define variable v-diasize-wndstore             as logical   no-undo .
      307   define variable v-diasize-proc-name            as character no-undo .
      308   define variable v-diasize-browse-handle        as handle    no-undo .
      309   define variable v-diasize-browse-number        as integer   no-undo .
      310   define variable v-diasize-need-full-display    as logical   no-undo init false .
      311   define temp-table temp-diasize-handle no-undo
      312     field handle-value  as handle
      313     field save-position as decimal
      314     index xpk is primary unique handle-value
      315     .
      316   define temp-table temp-browse-handle no-undo
      317     field browse-type   as character
      318     field browse-number as integer
      319     field browse-handle as handle
      320     field original-size as decimal
      321     index xpk is primary unique browse-type browse-number
      322     index xie browse-type browse-handle
      323   .
      324   procedure diasize_change-height :
      325     define input  parameter p-change-value  as decimal   no-undo .
      326     define input  parameter p-move-resize   as logical   no-undo .
      327     define variable v-field-group-handle    as handle    no-undo .
      328     define variable v-object-handle         as handle    no-undo .
      329     define variable v-frame-height          as decimal   no-undo .
      330     define variable v-frame-virtual-height  as decimal   no-undo .
      331     define variable v-browse-height         as decimal   no-undo .
      332     define variable v-window-height         as decimal   no-undo .
      333     define variable v-window-virtual-height as decimal   no-undo .
      334     define variable v-change-sign           as integer   no-undo .
      335     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      336     define buffer buf_temp-browse-handle  for temp-browse-handle .
      337     if p-change-value > 0
      338     then do:
      339       if frame Dialog-Frame :height + p-change-value
      340           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      341       then do:
      342         assign
      343           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      344                           - (frame Dialog-Frame :height-chars)
      345         .
      346         if p-change-value <= 0
      347         then do:
      348           run diasize_position-resize-button in this-procedure .
      349           return .
      350         end.
      351       end.
      352     end.
      353     if p-change-value < 0
      354     then do:
      355       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      356       then do:
      357         assign
      358           p-change-value = v-diasize-orig-frame-height
      359                          - (frame Dialog-Frame :height-chars)
      360         .
      361         if p-change-value >= 0
      362         then do:
      363           run diasize_position-resize-button in this-procedure .
      364           return .
      365         end.
      366       end.
      367     end.
      368     if p-change-value >= 0
      369     then do:
      370       assign
      371         v-change-sign = 1
      372       .
      373     end.
      374     else do:
      375       assign
      376         v-change-sign = -1
      377       .
      378     end.
      379     assign
      380       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      381     .
      382     if p-change-value = 0
      383     then do:
      384       run diasize_position-resize-button in this-procedure .
      385       return .
      386     end.
      387     move_block:
      388     do
      389     on error undo move_block, retry move_block
      390     :
      391       if retry
      392       then do:
      393         do
      394         on error undo move_block, leave move_block
      395         :
      396           if p-change-value > 0
      397           then do:
      398             for each buf_temp-diasize-handle
      399             on error undo, next
      400             :
      401               assign
      402                 v-object-handle = buf_temp-diasize-handle.handle-value
      403               .
      404               if v-object-handle <> v-diasize-resize-button
      405               then do:
      406                 assign
      407                   v-object-handle :row = buf_temp-diasize-handle.save-position
      408                 .
      409               end.
      410             end.
      411             assign
      412               v-diasize-browse-handle :height = v-browse-height
      413             .
      414             for each buf_temp-browse-handle
      415               where buf_temp-browse-handle.browse-type = 'height':u
      416             on error undo, next
      417             :
      418               assign
      419                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      420               .
      421             end.
      422             assign
      423               frame Dialog-Frame :height = v-frame-height
      424             .
      425             if frame Dialog-Frame :scrollable = true
      426             then do:
      427               assign
      428                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      429               .
      430             end.
      431             run diasize_position-resize-button in this-procedure .
      432           end.
      433           else do:
      434             if frame Dialog-Frame :scrollable = true
      435             then do:
      436               assign
      437                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      438               .
      439             end.
      440             assign
      441               frame Dialog-Frame :height = v-frame-height
      442             .
      443             assign
      444               v-diasize-browse-handle :height = v-browse-height
      445             .
      446             for each buf_temp-browse-handle
      447               where buf_temp-browse-handle.browse-type = 'height':u
      448             on error undo, next
      449             :
      450               assign
      451                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      452               .
      453             end.
      454             for each buf_temp-diasize-handle
      455             on error undo, next
      456             :
      457               assign
      458                 v-object-handle = buf_temp-diasize-handle.handle-value
      459               .
      460               if v-object-handle <> v-diasize-resize-button
      461               then do:
      462                 assign
      463                   v-object-handle :row = buf_temp-diasize-handle.save-position
      464                 .
      465               end.
      466             end.
      467             run diasize_position-resize-button in this-procedure .
      468           end.
      469           assign
      470             v-diasize-change-size = false
      471           .
      472           leave move_block .
      473         end.
      474       end.
      475       assign
      476         v-diasize-need-full-display = true
      477       .
      478       if v-diasize-change-size = false
      479       then do:
      480         assign
      481           v-diasize-change-size = true
      482         .
      483       end.
      484       else do:
      485         return .
      486       end.
      487       assign
      488         v-frame-height = frame Dialog-Frame :height
      489         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      490         v-browse-height = v-diasize-browse-handle :height
      491       .
      492       for each buf_temp-browse-handle
      493         where buf_temp-browse-handle.browse-type = 'height':u
      494       :
      495         assign
      496           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      497         .
      498       end.
      499       for each buf_temp-diasize-handle
      500       :
      501         delete buf_temp-diasize-handle .
      502       end.
      503       assign
      504         v-field-group-handle = frame Dialog-Frame :first-child
      505       .
      506       do while valid-handle(v-field-group-handle)
      507       :
      508         assign
      509           v-object-handle = v-field-group-handle :first-child
      510         .
      511         do while valid-handle(v-object-handle)
      512         :
      513           if  v-object-handle <> v-diasize-browse-handle :handle
      514           and can-query(v-object-handle, "row")
      515           and can-query(v-object-handle, "height")
      516           and ( v-object-handle :row > v-diasize-browse-handle :row )
      517           then do:
      518             find first buf_temp-browse-handle
      519               where buf_temp-browse-handle.browse-type   = 'height':u
      520                 and buf_temp-browse-handle.browse-handle = v-object-handle
      521               no-error .
      522             if available buf_temp-browse-handle
      523             then do:
      524             end.
      525             else do:
      526               create buf_temp-diasize-handle .
      527               assign
      528                 buf_temp-diasize-handle.handle-value  = v-object-handle
      529                 buf_temp-diasize-handle.save-position = v-object-handle :row
      530               .
      531             end.
      532           end.
      533           assign
      534             v-object-handle = v-object-handle :next-sibling
      535           .
      536         end.
      537         assign
      538           v-field-group-handle = v-field-group-handle :next-sibling
      539         .
      540       end.
      541       do with frame Dialog-Frame
      542       :
      543         hide v-diasize-resize-button .
      544         assign
      545           v-diasize-resize-button :row    = 1
      546           v-diasize-resize-button :column = 1
      547         .
      548       end.
      549       if p-change-value > 0
      550       then do:
      551         if frame Dialog-Frame :scrollable = true
      552         then do:
      553           assign
      554             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      555             no-error .
      556           if error-status :error
      557           or error-status :get-message(1) <> ""
      558           then do:
      559             undo move_block, retry move_block .
      560           end.
      561         end.
      562         assign
      563           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      564           no-error .
      565         if error-status :error
      566         or error-status :get-message(1) <> ""
      567         then do:
      568           undo move_block, retry move_block .
      569         end.
      570         assign
      571           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      572           no-error .
      573         if error-status :error
      574         or error-status :get-message(1) <> ""
      575         then do:
      576           undo move_block, retry move_block .
      577         end.
      578         for each buf_temp-browse-handle
      579           where buf_temp-browse-handle.browse-type = 'height':u
      580         on error undo move_block, retry move_block
      581         :
      582           assign
      583             buf_temp-browse-handle.browse-handle :height
      584               = buf_temp-browse-handle.browse-handle :height + p-change-value
      585             no-error .
      586           if error-status :error
      587           or error-status :get-message(1) <> ""
      588           then do:
      589             undo move_block, retry move_block .
      590           end.
      591         end.
      592         for each buf_temp-diasize-handle
      593         on error undo move_block, retry move_block
      594         :
      595           assign
      596             v-object-handle = buf_temp-diasize-handle.handle-value
      597           .
      598           if v-object-handle <> v-diasize-resize-button
      599           then do:
      600             assign
      601               v-object-handle :row = v-object-handle :row + p-change-value
      602               no-error .
      603             if error-status :error
      604             or error-status :get-message(1) <> ""
      605             then do:
      606               undo move_block, retry move_block .
      607             end.
      608           end.
      609         end.
      610       end.
      611       else do:
      612         for each buf_temp-diasize-handle
      613         on error undo move_block, retry move_block
      614         :
      615           assign
      616             v-object-handle = buf_temp-diasize-handle.handle-value
      617           .
      618           if v-object-handle <> v-diasize-resize-button
      619           then do:
      620             assign
      621               v-object-handle :row = v-object-handle :row + p-change-value
      622               no-error .
      623             if error-status :error
      624             or error-status :get-message(1) <> ""
      625             then do:
      626               undo move_block, retry move_block .
      627             end.
      628           end.
      629         end.
      630         assign
      631           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      632           no-error .
      633         if error-status :error
      634         or error-status :get-message(1) <> ""
      635         then do:
      636           undo move_block, retry move_block .
      637         end.
      638         for each buf_temp-browse-handle
      639           where buf_temp-browse-handle.browse-type = 'height':u
      640         on error undo move_block, retry move_block
      641         :
      642           assign
      643             buf_temp-browse-handle.browse-handle :height
      644               = buf_temp-browse-handle.browse-handle :height + p-change-value
      645             no-error .
      646           if error-status :error
      647           or error-status :get-message(1) <> ""
      648           then do:
      649             undo move_block, retry move_block .
      650           end.
      651         end.
      652         assign
      653           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      654           no-error .
      655         if error-status :error
      656         or error-status :get-message(1) <> ""
      657         then do:
      658           undo move_block, retry move_block .
      659         end.
      660         if frame Dialog-Frame :scrollable = true
      661         then do:
      662           assign
      663             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      664             no-error .
      665           if error-status :error
      666           or error-status :get-message(1) <> ""
      667           then do:
      668             undo move_block, retry move_block .
      669           end.
      670         end.
      671       end.
      672       if p-move-resize = true
      673       then do:
      674         run diasize_position-resize-button in this-procedure .
      675       end.
      676       if v-diasize-wndstore = true
      677       then do:
      678         if connected("ub") = true
      679         then do:
      680           define variable v-cntxt-db-num        as integer   no-undo .
      681           define variable v-cntxt-userid        as character no-undo .
      682           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      683                                             , OUTPUT v-cntxt-userid
      684                                             ) .
      685           run gbl/wndsizew.p
      686             (input  v-cntxt-db-num
      687             ,input  v-cntxt-userid
      688             ,input  v-diasize-proc-name
      689             ,input  'height':u
      690             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      691             ) .
      692         end.
      693       end.
      694     end.
      695     assign
      696       v-diasize-change-size = false
      697     .
      698   end procedure.
      699   procedure diasize_set-height :
      700     define input  parameter p-new-height  as decimal   no-undo .
      701     define input  parameter p-move-resize as logical   no-undo .
      702     do
      703     on error undo, return error return-value
      704     :
      705       run diasize_change-height in this-procedure
      706         (input  (p-new-height - frame Dialog-Frame :height)
      707         ,input  p-move-resize
      708         ) .
      709     end.
      710   end procedure.
      711   procedure diasize_change-width :
      712     define input  parameter p-change-value as decimal   no-undo .
      713     define input  parameter p-move-resize  as logical   no-undo .
      714     define variable v-field-group-handle   as handle    no-undo .
      715     define variable v-object-handle        as handle    no-undo .
      716     define variable v-frame-width          as decimal   no-undo .
      717     define variable v-frame-virtual-width  as decimal   no-undo .
      718     define variable v-browse-width         as decimal   no-undo .
      719     define variable v-window-width         as decimal   no-undo .
      720     define variable v-window-virtual-width as decimal   no-undo .
      721     define variable v-change-sign          as integer   no-undo .
      722     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      723     define buffer buf_temp-browse-handle  for temp-browse-handle .
      724     if p-change-value > 0
      725     then do:
      726       if frame Dialog-Frame :width + p-change-value >
      727           session :width-chars
      728       then do:
      729         assign
      730           p-change-value = session :width-chars - frame Dialog-Frame :width
      731         .
      732         if p-change-value <= 0
      733         then do:
      734           run diasize_position-resize-button in this-procedure .
      735           return .
      736         end.
      737       end.
      738     end.
      739     if p-change-value < 0
      740     then do:
      741       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      742       then do:
      743         assign
      744           p-change-value = v-diasize-orig-frame-width
      745                          - frame Dialog-Frame :width
      746         .
      747         if p-change-value >= 0
      748         then do:
      749           run diasize_position-resize-button in this-procedure .
      750           return .
      751         end.
      752       end.
      753     end.
      754     if p-change-value >= 0
      755     then do:
      756       assign
      757         v-change-sign = 1
      758       .
      759     end.
      760     else do:
      761       assign
      762         v-change-sign = -1
      763       .
      764     end.
      765     assign
      766       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      767     .
      768     if p-change-value = 0
      769     then do:
      770       run diasize_position-resize-button in this-procedure .
      771       return .
      772     end.
      773     move_block:
      774     do
      775     on error undo move_block, leave move_block
      776     :
      777       if retry
      778       then do:
      779         do
      780         on error undo move_block, leave move_block
      781         :
      782           if p-change-value > 0
      783           then do:
      784             for each buf_temp-diasize-handle
      785             on error undo, next
      786             :
      787               assign
      788                 v-object-handle = buf_temp-diasize-handle.handle-value
      789               .
      790               if v-object-handle <> v-diasize-resize-button
      791               then do:
      792                 assign
      793                   v-object-handle :col = buf_temp-diasize-handle.save-position
      794                 .
      795               end.
      796             end.
      797             assign
      798               v-diasize-browse-handle :width = v-browse-width
      799             .
      800             for each buf_temp-browse-handle
      801               where buf_temp-browse-handle.browse-type = 'width':u
      802             on error undo, next
      803             :
      804               assign
      805                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      806               .
      807             end.
      808             assign
      809               frame Dialog-Frame :width = v-frame-width
      810             .
      811             if frame Dialog-Frame :scrollable = true
      812             then do:
      813               assign
      814                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      815               .
      816             end.
      817             run diasize_position-resize-button in this-procedure .
      818           end.
      819           else do:
      820             if frame Dialog-Frame :scrollable = true
      821             then do:
      822               assign
      823                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      824               .
      825             end.
      826             assign
      827               frame Dialog-Frame :width = v-frame-width
      828             .
      829             for each buf_temp-browse-handle
      830               where buf_temp-browse-handle.browse-type = 'width':u
      831             on error undo, next
      832             :
      833               assign
      834                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      835               .
      836             end.
      837             assign
      838               v-diasize-browse-handle :width = v-browse-width
      839             .
      840             for each buf_temp-diasize-handle
      841             on error undo, next
      842             :
      843               assign
      844                 v-object-handle = buf_temp-diasize-handle.handle-value
      845               .
      846               if v-object-handle <> v-diasize-resize-button
      847               then do:
      848                 assign
      849                   v-object-handle :col = buf_temp-diasize-handle.save-position
      850                 .
      851               end.
      852             end.
      853             run diasize_position-resize-button in this-procedure .
      854           end.
      855           assign
      856             v-diasize-change-size = false
      857           .
      858           leave move_block .
      859         end.
      860       end.
      861       assign
      862         v-diasize-need-full-display = true
      863       .
      864       if v-diasize-change-size = false
      865       then do:
      866         assign
      867           v-diasize-change-size = true
      868         .
      869       end.
      870       else do:
      871         return .
      872       end.
      873       assign
      874         v-frame-width = frame Dialog-Frame :width
      875         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      876         v-browse-width = v-diasize-browse-handle :width
      877       .
      878       for each buf_temp-browse-handle
      879         where buf_temp-browse-handle.browse-type = 'width':u
      880       :
      881         assign
      882           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      883         .
      884       end.
      885       for each buf_temp-diasize-handle
      886       :
      887         delete buf_temp-diasize-handle .
      888       end.
      889       assign
      890         v-field-group-handle = frame Dialog-Frame :first-child
      891       .
      892       do while valid-handle(v-field-group-handle)
      893       :
      894         assign
      895           v-object-handle = v-field-group-handle :first-child
      896         .
      897         do while valid-handle(v-object-handle)
      898         :
      899           if  v-object-handle <> v-diasize-browse-handle :handle
      900           and v-object-handle <> v-diasize-resize-button
      901           and can-query(v-object-handle, "row")
      902           and can-query(v-object-handle, "height")
      903           and ( v-object-handle :col + v-object-handle :width
      904                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      905               )
      906           then do:
      907             find first buf_temp-browse-handle
      908               where buf_temp-browse-handle.browse-type   = 'width':u
      909                 and buf_temp-browse-handle.browse-handle = v-object-handle
      910               no-error .
      911             if available buf_temp-browse-handle
      912             then do:
      913             end.
      914             else do:
      915               create buf_temp-diasize-handle .
      916               assign
      917                 buf_temp-diasize-handle.handle-value  = v-object-handle
      918                 buf_temp-diasize-handle.save-position = v-object-handle :col
      919               .
      920             end.
      921           end.
      922           assign
      923             v-object-handle = v-object-handle :next-sibling
      924           .
      925         end.
      926         assign
      927           v-field-group-handle = v-field-group-handle :next-sibling
      928         .
      929       end.
      930       do with frame Dialog-Frame
      931       :
      932         hide v-diasize-resize-button .
      933         v-diasize-resize-button :row = 1.
      934         v-diasize-resize-button :column = 1.
      935       end.
      936       if p-change-value > 0
      937       then do:
      938         if frame Dialog-Frame :scrollable = true
      939         then do:
      940           assign
      941             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      942             no-error .
      943           if error-status :error
      944           or error-status :get-message(1) <> ""
      945           then do:
      946             undo move_block, retry move_block.
      947           end.
      948         end.
      949         assign
      950           frame Dialog-Frame :width = v-frame-width + p-change-value
      951           no-error .
      952         if error-status :error
      953         or error-status :get-message(1) <> ""
      954         then do:
      955           undo move_block, retry move_block.
      956         end.
      957         assign
      958           v-diasize-browse-handle :width = v-browse-width + p-change-value
      959         no-error .
      960         if error-status :error
      961         or error-status :get-message(1) <> ""
      962         then do:
      963           undo move_block, retry move_block.
      964         end.
      965         for each buf_temp-browse-handle
      966           where buf_temp-browse-handle.browse-type = 'width':u
      967         on error undo move_block, retry move_block
      968         :
      969           assign
      970             buf_temp-browse-handle.browse-handle :width
      971               = buf_temp-browse-handle.browse-handle :width + p-change-value
      972             no-error .
      973           if error-status :error
      974           or error-status :get-message(1) <> ""
      975           then do:
      976             undo move_block, retry move_block .
      977           end.
      978         end.
      979         for each buf_temp-diasize-handle
      980         on error undo move_block, retry move_block
      981         :
      982           assign
      983             v-object-handle = buf_temp-diasize-handle.handle-value
      984           .
      985           if v-object-handle <> v-diasize-resize-button
      986           then do:
      987             assign
      988               v-object-handle :col = v-object-handle :col + p-change-value
      989               no-error .
      990             if error-status :error
      991             or error-status :get-message(1) <> ""
      992             then do:
      993               undo move_block, retry move_block .
      994             end.
      995           end.
      996         end.
      997       end.
      998       else do:
      999         for each buf_temp-diasize-handle
     1000         on error undo move_block, retry move_block
     1001         :
     1002           assign
     1003             v-object-handle = buf_temp-diasize-handle.handle-value
     1004           .
     1005           if v-object-handle <> v-diasize-resize-button
     1006           then do:
     1007             assign
     1008               v-object-handle :col = v-object-handle :col + p-change-value
     1009               no-error .
     1010             if error-status :error
     1011             or error-status :get-message(1) <> ""
     1012             then do:
     1013               undo move_block, retry move_block .
     1014             end.
     1015           end.
     1016         end.
     1017         for each buf_temp-browse-handle
     1018           where buf_temp-browse-handle.browse-type = 'width':u
     1019         on error undo move_block, retry move_block
     1020         :
     1021           assign
     1022             buf_temp-browse-handle.browse-handle :width
     1023               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1024             no-error .
     1025           if error-status :error
     1026           or error-status :get-message(1) <> ""
     1027           then do:
     1028             undo move_block, retry move_block .
     1029           end.
     1030         end.
     1031         assign
     1032           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1033           no-error .
     1034         if error-status :error
     1035         or error-status :get-message(1) <> ""
     1036         then do:
     1037           undo move_block, retry move_block.
     1038         end.
     1039         assign
     1040           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1041         no-error .
     1042         if error-status :error
     1043         or error-status :get-message(1) <> ""
     1044         then do:
     1045           undo move_block, retry move_block.
     1046         end.
     1047         if frame Dialog-Frame :scrollable = true
     1048         then do:
     1049           assign
     1050             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1051           no-error .
     1052           if error-status :error
     1053           or error-status :get-message(1) <> ""
     1054           then do:
     1055             undo move_block, retry move_block.
     1056           end.
     1057         end.
     1058       end.
     1059       if p-move-resize
     1060       then do:
     1061         run diasize_position-resize-button in this-procedure .
     1062       end.
     1063       if v-diasize-wndstore = true
     1064       then do:
     1065         if connected("ub") = true
     1066         then do:
     1067           define variable v-cntxt-db-num        as integer   no-undo .
     1068           define variable v-cntxt-userid        as character no-undo .
     1069           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1070                                             , OUTPUT v-cntxt-userid
     1071                                             ) .
     1072           run gbl/wndsizew.p
     1073             (input  v-cntxt-db-num
     1074             ,input  v-cntxt-userid
     1075             ,input  v-diasize-proc-name
     1076             ,input  'width':u
     1077             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1078             ) .
     1079         end.
     1080       end.
     1081     end.
     1082     assign
     1083       v-diasize-change-size = false
     1084     .
     1085   end procedure.
     1086   procedure diasize_set-width :
     1087     define input  parameter p-new-width  as decimal   no-undo .
     1088     define input  parameter p-move-resize as logical   no-undo .
     1089     do
     1090     on error undo, return error return-value
     1091     :
     1092       run diasize_change-width in this-procedure
     1093         (input  (p-new-width - frame Dialog-Frame :width)
     1094         ,input  p-move-resize
     1095         ) .
     1096     end.
     1097   end procedure.
     1098   procedure diasize_position-resize-button :
     1099     do with frame Dialog-Frame
     1100     :
     1101       hide v-diasize-resize-button .
     1102       assign
     1103         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1104                     - 1
     1105                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1106         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1107                     - 1
     1108                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1109       .
     1110       view v-diasize-resize-button .
     1111     end.
     1112   end procedure.
     1113   on alt-right anywhere
     1114   do:
     1115     run diasize_change-width in this-procedure
     1116       (input 1
     1117       ,input true
     1118       ) .
     1119     return no-apply .
     1120   end.
     1121   on alt-left anywhere
     1122   do:
     1123     run diasize_change-width in this-procedure
     1124       (input -1
     1125       ,input true
     1126       ) .
     1127     return no-apply .
     1128   end.
     1129   on alt-down anywhere
     1130   do:
     1131     run diasize_change-height in this-procedure
     1132       (input 1
     1133       ,input true
     1134       ) .
     1135     return no-apply .
     1136   end.
     1137   on alt-up anywhere
     1138   do:
     1139     run diasize_change-height in this-procedure
     1140       (input -1
     1141       ,input true
     1142       ) .
     1143     return no-apply .
     1144   end.
     1145   on alt-enter of frame Dialog-Frame
     1146   do:
     1147     run diasize_maximize in this-procedure
     1148       (input  ?
     1149       ).
     1150     return no-apply .
     1151   end.
     1152   procedure diasize_end-move :
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156       define variable v-row-delta as decimal   no-undo .
     1157       define variable v-col-delta as decimal   no-undo .
     1158       define variable v-new-row as decimal   no-undo .
     1159       define variable v-new-col as decimal   no-undo .
     1160       assign
     1161         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1162         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1163       .
     1164       assign
     1165         v-row-delta = v-new-row - frame Dialog-Frame :height
     1166         v-col-delta = v-new-col - frame Dialog-Frame :width
     1167       .
     1168       run diasize_change-height in this-procedure
     1169         (input v-row-delta
     1170         ,input true
     1171         ) .
     1172       run diasize_change-width in this-procedure
     1173         (input v-col-delta
     1174         ,input true
     1175         ) .
     1176     end.
     1177   end procedure.
     1178   procedure diasize_maximize :
     1179     define input  parameter p-action as logical   no-undo .
     1180     do
     1181     on error undo, return error return-value
     1182     :
     1183       if p-action = ?
     1184       then do:
     1185         if v-diasize-need-maximize = true
     1186         then do:
     1187           assign
     1188             p-action = true
     1189           .
     1190         end.
     1191         else do:
     1192           assign
     1193             p-action = false
     1194           .
     1195         end.
     1196       end.
     1197       if p-action = true
     1198       then do:
     1199         run diasize_change-height in this-procedure
     1200           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1201               - frame Dialog-Frame :height-chars
     1202           ,input true
     1203           ) .
     1204         run diasize_change-width in this-procedure
     1205           (input session :width-chars
     1206               - frame Dialog-Frame :width-chars
     1207           ,input true
     1208           ) .
     1209         assign
     1210           v-diasize-need-maximize = false
     1211         .
     1212       end.
     1213       else do:
     1214         run diasize_change-width in this-procedure
     1215           (input v-diasize-orig-frame-width
     1216               - frame Dialog-Frame :width-chars
     1217           ,input true
     1218           ) .
     1219         run diasize_change-height in this-procedure
     1220           (input v-diasize-orig-frame-height
     1221               - frame Dialog-Frame :height-chars
     1222           ,input true
     1223           ) .
     1224         assign
     1225           v-diasize-need-maximize = true
     1226         .
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure diasize_restore-orig-size :
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       assign
     1235         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1236         v-diasize-current-frame-height = frame Dialog-Frame :height
     1237       .
     1238       run diasize_set-height in this-procedure
     1239         (input  v-diasize-orig-frame-height
     1240         ,input  true
     1241         ) .
     1242       run diasize_set-width in this-procedure
     1243         (input  v-diasize-orig-frame-width
     1244         ,input  true
     1245         ) .
     1246     end.
     1247   end procedure.
     1248   procedure diasize_restore-current-size :
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       run diasize_set-height in this-procedure
     1253         (input  v-diasize-current-frame-height
     1254         ,input  true
     1255         ) .
     1256       run diasize_set-width in this-procedure
     1257         (input  v-diasize-current-frame-width
     1258         ,input  true
     1259         ) .
     1260     end.
     1261   end procedure.
     1262   procedure diasize_set-browse-handle :
     1263     define input  parameter p-browse-handle as handle   no-undo .
     1264     define buffer buf_temp-browse-handle for temp-browse-handle .
     1265     do
     1266     on error undo, return error return-value
     1267     :
     1268       assign
     1269         v-diasize-browse-handle = p-browse-handle
     1270       .
     1271       for each buf_temp-browse-handle
     1272       on error undo, return error return-value
     1273       :
     1274         delete buf_temp-browse-handle .
     1275       end.
     1276     end.
     1277   end procedure.
     1278   procedure diasize_add_browse :
     1279     define input  parameter p-browse-type   as character no-undo .
     1280     define input  parameter p-browse-handle as handle    no-undo .
     1281     define buffer buf_temp-browse-handle for temp-browse-handle .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       assign
     1286         v-diasize-browse-number = v-diasize-browse-number + 1
     1287       .
     1288       create buf_temp-browse-handle .
     1289       assign
     1290         buf_temp-browse-handle.browse-type   = p-browse-type
     1291         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1292         buf_temp-browse-handle.browse-handle = p-browse-handle
     1293       .
     1294     end.
     1295   end procedure.
     1296   procedure diasize_init :
     1297     define variable v-default-value    as logical   no-undo .
     1298     define variable v-restore-saved    as logical   no-undo .
     1299     define variable v-resize-value-str as character no-undo .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       do with frame Dialog-Frame
     1304       :
     1305         assign
     1306           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1307           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1308           v-diasize-browse-handle     = browse b-ob :handle
     1309         .
     1310         create button v-diasize-resize-button
     1311         assign
     1312           parent        = frame Dialog-Frame :first-child
     1313           label         = "s"
     1314           height-pixels = 16
     1315           width-pixels  = 16
     1316           visible       = true
     1317           sensitive     = true
     1318           movable       = true
     1319           triggers:
     1320             on end-move persistent run diasize_end-move in this-procedure .
     1321           end triggers.
     1322         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1323         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1324         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1325         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1326         assign
     1327           v-diasize-wndmax = false
     1328         .
     1329         if connected("ub") = true
     1330         then do:
     1331           define variable v-cntxt-db-num        as integer   no-undo .
     1332           define variable v-cntxt-userid        as character no-undo .
     1333           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1334                                             , OUTPUT v-cntxt-userid
     1335                                             ) .
     1336           run gbl/wndpar_r.p
     1337             (input  v-cntxt-db-num
     1338             ,input  v-cntxt-userid
     1339             ,input  'wndmax':U
     1340             ,output v-diasize-wndmax
     1341             ,output v-default-value
     1342             ) .
     1343         end.
     1344         assign
     1345           v-diasize-wndstore = false
     1346         .
     1347         if connected("ub") = true
     1348         then do:
     1349           run gbl/wndpar_r.p
     1350             (input  v-cntxt-db-num
     1351             ,input  v-cntxt-userid
     1352             ,input  'wndstore':U
     1353             ,output v-diasize-wndstore
     1354             ,output v-default-value
     1355             ) .
     1356         end.
     1357         assign
     1358           v-diasize-proc-name = entry(1, program-name(2), '.')
     1359         .
     1360         if v-diasize-wndstore = true
     1361         then do:
     1362           assign
     1363             v-restore-saved = false
     1364           .
     1365           if connected("ub") = true
     1366           then do:
     1367             run gbl/wndsizer.p
     1368               (input  v-cntxt-db-num
     1369               ,input  v-cntxt-userid
     1370               ,input  v-diasize-proc-name
     1371               ,input  'height':u
     1372               ,output v-resize-value-str
     1373               ) .
     1374             if v-resize-value-str <> '':U
     1375             then do:
     1376               run diasize_change-height in this-procedure
     1377                 (input  integer(v-resize-value-str)
     1378                 ,input  true
     1379                 ) .
     1380               assign
     1381                 v-restore-saved = true
     1382               .
     1383             end.
     1384           end.
     1385           if connected("ub") = true
     1386           then do:
     1387             run gbl/wndsizer.p
     1388               (input  v-cntxt-db-num
     1389               ,input  v-cntxt-userid
     1390               ,input  v-diasize-proc-name
     1391               ,input  'width':u
     1392               ,output v-resize-value-str
     1393               ) .
     1394             if v-resize-value-str <> '':U
     1395             then do:
     1396               run diasize_change-width in this-procedure
     1397                 (input  integer(v-resize-value-str)
     1398                 ,input  true
     1399                 ) .
     1400               assign
     1401                 v-restore-saved = true
     1402               .
     1403             end.
     1404           end.
     1405           if v-restore-saved <> true
     1406           then do:
     1407             if v-diasize-wndmax = true
     1408             then do:
     1409               run diasize_maximize in this-procedure
     1410                 (input  true
     1411                 ) .
     1412             end.
     1413           end.
     1414         end.
     1415         else do:
     1416           if v-diasize-wndmax = true
     1417           then do:
     1418             run diasize_maximize in this-procedure
     1419               (input  true
     1420               ) .
     1421           end.
     1422         end.
     1423       end.
     1424     end.
     1425   end procedure.
     1426   procedure diasize_need-full-display :
     1427     define output parameter p-need-full-display as logical   no-undo .
     1428     do
     1429     on error undo, return error return-value
     1430     :
     1431       assign
     1432         p-need-full-display = v-diasize-need-full-display
     1433       .
     1434       assign
     1435         v-diasize-need-full-display = false
     1436       .
     1437     end.
     1438   end procedure.
     1439   procedure get-context :
     1440      define output parameter p-db-num as integer          no-undo.
     1441      define output parameter p-user-id as character        no-undo.
     1442      define variable v-login               as character    no-undo.
     1443      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1444      define buffer buf_user-login  for ub.user-login .
     1445      do
     1446      on error undo, return error
     1447      :
     1448            FIND FIRST buf_sys-ctrl no-lock.
     1449            ASSIGN
     1450               v-login = USERID("ub")
     1451               p-db-num = buf_sys-ctrl.db-num
     1452            .
     1453            FIND FIRST buf_user-login
     1454                 WHERE buf_user-login.db-num = p-db-num
     1455                   AND buf_user-login.user-login = v-login
     1456                 no-lock
     1457                 no-error
     1458                 .
     1459            IF AVAILABLE buf_user-login
     1460            THEN DO:
     1461               assign
     1462                  p-user-id = buf_user-login.user-id
     1463               .
     1464            END.
     1465      end.
     1466   end procedure.
     1467       run diasize_init in this-procedure .
     1468   MAIN-BLOCK:
     1469   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1470      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1471     FIND FIRST bf_trn-doc WHERE bf_trn-doc.doc-code = pardoc-code NO-LOCK.
     1472     RUN cr-tt-fo-before IN THIS-PROCEDURE.
     1473     ASSIGN FRAME
     1474     Dialog-Frame:TITLE = "Предфинобязательства по складскому документу " + pardoc-code.
     1475     assign
     1476     tt-fo-before.sum-rubl:label in browse b-ob        = "Общая сумма (руб)"
     1477     tt-fo-before.sum-rubl-trn:label in browse b-ob    = "Сумма по док. (руб)"
     1478     bf_parts.price-rubl:label in browse  b-parts      = "Цена (руб)"
     1479     .
     1480     RUN enable_UI.
     1481     RUN open-parts-query IN THIS-PROCEDURE.
     1482     WAIT-FOR GO OF FRAME Dialog-Frame.
     1483   END.
     1484   RUN disable_UI.
     1485   PROCEDURE cr-tt-fo-before :
     1486   if bf_trn-doc.ext-doc-type = 'ie':U then do:
     1487     for each bf_fin-ob-before where bf_fin-ob-before.host-code         = bf_trn-doc.host-code and
     1488                                     bf_fin-ob-before.trn-doc-code-orig = bf_trn-doc.doc-code  NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1489       create tt-fo-before.
     1490       buffer-copy bf_fin-ob-before to tt-fo-before.
     1491       assign
     1492         tt-fo-before.sum-base-trn = tt-fo-before.sum-base-trn + bf_fin-ob-before.sum-base
     1493         tt-fo-before.sum-rubl-trn = tt-fo-before.sum-rubl-trn + bf_fin-ob-before.sum-rubl
     1494       .
     1495     end.
     1496   end.
     1497   else do:
     1498     for each bf_fin-gds-part where bf_fin-gds-part.obj-type = bf_trn-doc.obj-type and
     1499                                    bf_fin-gds-part.obj-code = bf_trn-doc.obj-code and
     1500                                    bf_fin-gds-part.out-code = bf_trn-doc.doc-code no-lock on error undo, return error return-value :
     1501         find first bf_fin-ob-before where bf_fin-ob-before.host-code   = bf_fin-gds-part.host-code   and
     1502                                           bf_fin-ob-before.before-code = bf_fin-gds-part.fin-ob-code no-lock no-error.
     1503         if available bf_fin-ob-before then do:
     1504           find first tt-fo-before where tt-fo-before.host-code         = bf_fin-ob-before.host-code         and
     1505                                         tt-fo-before.trn-doc-code-orig = bf_fin-ob-before.trn-doc-code-orig and
     1506                                         tt-fo-before.contract-code     = bf_fin-ob-before.contract-code     no-error.
     1507           if not available tt-fo-before then do:
     1508             create tt-fo-before.
     1509             buffer-copy bf_fin-ob-before to tt-fo-before.
     1510           end.
     1511           assign
     1512             tt-fo-before.sum-base-trn = tt-fo-before.sum-base-trn + bf_fin-gds-part.sum-base
     1513             tt-fo-before.sum-rubl-trn = tt-fo-before.sum-rubl-trn + bf_fin-gds-part.sum-rubl
     1514           .
     1515        end.
     1516     end.
     1517   end.
     1518   END PROCEDURE.
     1519   PROCEDURE disable_UI :
     1520     HIDE FRAME Dialog-Frame.
     1521   END PROCEDURE.
     1522   PROCEDURE enable_UI :
     1523     ENABLE b-exit b-help b-ob b-parts
     1524         WITH FRAME Dialog-Frame.
     1525     VIEW FRAME Dialog-Frame.
     1526     OPEN QUERY b-ob FOR EACH tt-fo-before.
     1527   END PROCEDURE.
     1528   PROCEDURE open-parts-query :
     1529   IF AVAILABLE tt-fo-before THEN DO:
     1530       OPEN QUERY b-parts
     1531           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code   = tt-fo-before.host-code    AND
     1532                                          bf_fin-gds-part.fin-ob-code = tt-fo-before.before-code  AND
     1533                                          bf_fin-gds-part.out-code    = tt-fo-before.trn-doc-code NO-LOCK,
     1534           first bf_goods where bf_goods.gds-code  = bf_fin-gds-part.gds-code no-lock,
     1535           FIRST bf_parts WHERE bf_parts.obj-type  = bf_fin-gds-part.obj-type AND
     1536                                bf_parts.obj-code  = bf_fin-gds-part.obj-code AND
     1537                                bf_parts.artic     = bf_goods.artic AND
     1538                                bf_parts.prod-type = bf_goods.prod-type AND
     1539                                bf_parts.prod-code = bf_goods.prod-code AND
     1540                                bf_parts.in-code   = bf_fin-gds-part.in-code AND
     1541                                bf_parts.out-code  = bf_fin-gds-part.out-code AND
     1542                                bf_parts.part-code = bf_fin-gds-part.part-code NO-LOCK.
     1543       DISPLAY b-parts WITH FRAME Dialog-Frame.
     1544   END.
     1545   END PROCEDURE.
