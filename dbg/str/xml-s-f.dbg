      247         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'unit-base', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-line.unit-base))) + v-suffix ) .
      248         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'schet-fact-line') + chr(10))).
      249   end.
      250     if paroutput-file = ?  or paroutput-file = "" then do:
      251       run write-string in this-procedure (input '</root>':u + chr(10)).
      252     end.
      253     else do:
      254       if p-last-document then  run write-string in this-procedure (input '</root>':u + chr(10)).
      255     end.
      256     output stream contr-out close.
      257     if paroutput-file = ?  or paroutput-file = "" then do:
      258       if search ("./" + "f":U + string(p-doc-code) + ".xml") <> ? then do:
      259         os-delete value ("./" + "f":U + string(p-doc-code) + ".xml").
      260       end.
      261       os-copy value ("./" + "f":U + string(p-doc-code) + ".tmp") value ("./" + "f":U + string(p-doc-code) + ".xml").
      262       os-delete value ("./" + "f":U +  string(p-doc-code) + ".tmp").
      263       run gbl/filename.p (
      264                     input "./" + "f":U + string(p-doc-code) + ".xml"
      265                     ,output paroutput-file
      266                     ,output v-path
      267                     ,output v-file-name
      268                     ,output v-file-name-no-ext
      269                     ,output v-file-name-ext
      270                     ) no-error .
      271     end.
      272     procedure write-string :
      273       define input parameter parstring as character no-undo.
      274       put stream contr-out unformatted parstring.
      275     end.
