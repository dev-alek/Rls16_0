        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER parparentproc        AS WIDGET-HANDLE        NO-UNDO.
        3   define input parameter p-host-code   like ub.schet-fact-doc.host-code no-undo .
        4   define input parameter p-doc-code    like ub.schet-fact-doc.doc-code no-undo.
        5   define input-output parameter paroutput-file    as   character           no-undo.
        6   define input parameter p-first-document  as logical no-undo .
        7   define input parameter p-last-document   as logical no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: xml-s-f.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/xml-s-f.p $":U .
       13   define variable vss-description as character no-undo init "Выгрузка счета-фактуры в формате xml".
       14   define variable varr-b  as character no-undo.
       15   define variable vartype as character no-undo.
       16   define variable v-full-path        as character no-undo .
       17   define variable v-path             as character no-undo .
       18   define variable v-file-name        as character no-undo .
       19   define variable v-file-name-no-ext as character no-undo .
       20   define variable v-file-name-ext    as character no-undo .
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   function xml-doc_replacespecsymbols returns char (input sinput as char).
       81     assign
       82       sinput = replace(sinput, '&', "&#038;")
       83       sinput = replace(sinput, '"', "&#034;")
       84       sinput = replace(sinput, '<', "&#060;")
       85       sinput = replace(sinput, '>', "&#062;")
       86       sinput = replace(sinput, chr(10), "&#010;")
       87     .
       88     return sinput.
       89   end function.
       90   define variable vss-include-info1 as character format "X(65)" no-undo
       91   initial "@(#)$Workfile$".
       92     define buffer buf_schet-fact-doc  for ub.schet-fact-doc.
       93     define buffer buf_schet-fact-line for ub.schet-fact-line.
       94     define variable g#db-num as integer   no-undo .
       95     run get-db-num  in parParentProc ( output g#db-num ).
       96     define stream contr-out.
       97     if paroutput-file = ?  or paroutput-file = "" then do:
       98       output stream contr-out to value ("./" + "f":U + string(p-doc-code) + ".tmp").
       99       run write-string in this-procedure (input '<?xml version="1.0" encoding="windows-1251"?>':u + chr(10) + '<root>':u + chr(10) ).
      100     end.
      101     else do:
      102       if p-first-document then do:
      103         output stream contr-out to value (paroutput-file).
      104         run write-string in this-procedure (input '<?xml version="1.0" encoding="windows-1251"?>':u + chr(10) + '<root>':u + chr(10) ).
      105       end.
      106       else do:
      107         output stream contr-out to value(paroutput-file) append.
      108       end.
      109     end.
      110     find first buf_schet-fact-doc no-lock
      111       where buf_schet-fact-doc.host-code = p-host-code
      112         AND buf_schet-fact-doc.doc-code  = p-doc-code
      113     no-error .
      114     if not available buf_schet-fact-doc then do:
      115       return error substitute ("Не найден счет-фактура: фирма &1 номер &2", p-host-code, p-doc-code).
      116     end.
      117   define variable vss-include-info2 as character format "X(65)" no-undo
      118   initial "@(#)$Workfile$".
      119     define variable v-prefix as character no-undo .
      120     define variable v-suffix as character no-undo .
      121       assign
      122         v-prefix = "    "
      123         v-suffix = chr(10)
      124       .
      125   run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'header') + chr(10)) ) .
      126   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fileName', xml-doc_ReplaceSpecSymbols(string(string( "f":U + string(p-doc-code) + ".xml")))) + v-suffix ) .
      127   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fileNumber', xml-doc_ReplaceSpecSymbols(string(string(1)))) + v-suffix ) .
      128   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'HostList', xml-doc_ReplaceSpecSymbols(string(string(p-host-code)))) + v-suffix ) .
      129   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'docName', xml-doc_ReplaceSpecSymbols(string("schet-fact"))) + v-suffix ) .
      130   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'version', xml-doc_ReplaceSpecSymbols(string("15.0 " + replace( vss-revision + vss-date, "$", " " )))) + v-suffix ) .
      131   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'exportDate', xml-doc_ReplaceSpecSymbols(string(string( today,          "99/99/9999" )))) + v-suffix ) .
      132   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'exportTime', xml-doc_ReplaceSpecSymbols(string(string( time,           "HH:MM:SS"   )))) + v-suffix ) .
      133   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'baseNum', xml-doc_ReplaceSpecSymbols(string(g#db-num))) + v-suffix ) .
      134   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'DateFrom', xml-doc_ReplaceSpecSymbols(string(""))) + v-suffix ) .
      135   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'DateTo', xml-doc_ReplaceSpecSymbols(string(""))) + v-suffix ) .
      136   run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'header') + chr(10))).
      137   run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'schet-fact-doc') + chr(10)) ) .
      138   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'doc-code', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-doc.doc-code))) + v-suffix ) .
      139   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'doc-date', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-doc.doc-date, '99.99.9999':U))) + v-suffix ) .
      140   if buf_schet-fact-doc.pay-date <> ? then do:
