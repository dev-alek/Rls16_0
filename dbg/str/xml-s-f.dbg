      180   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'sum-VAT-20-rubl', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-doc.sum-VAT-20-rubl))) + v-suffix ) .
