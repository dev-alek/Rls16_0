      232         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'VAT-pc', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-line.VAT-pc))) + v-suffix ) .
      233         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'ext-doc-type', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-line.ext-doc-type))) + v-suffix ) .
      234         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fact-order', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-line.fact-order))) + v-suffix ) .
      235         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'status_', xml-doc_ReplaceSpecSymbols(string(buf_schet-fact-line.status_))) + v-suffix ) .
