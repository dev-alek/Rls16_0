      200   FUNCTION get-curr RETURNS CHARACTER
      201     (buffer loc-wealth for ub.wealth ) :
      202   define buffer buf_currency for ub.currency.
      203   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      204   return loc-wealth.unit-base.
      205   FIND FIRST buf_currency no-lock where
      206             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      207   if avail buf_currency then
      208     RETURN buf_currency.curr-abbr.
      209   else return "".
      210   END FUNCTION.
      211   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   procedure cur-time :
      213      define output parameter p-today as date      no-undo .
      214      define output parameter p-time  as integer   no-undo .
      215     do
      216     on error undo, return error
      217     :
      218       define variable v-date1 as date      no-undo .
      219       define variable v-date2 as date      no-undo .
      220       define variable v-time  as integer   no-undo .
      221       assign
      222         v-date1 = today
      223         v-time  = time
      224         v-date2 = today
      225       .
      226       if v-date1 <> v-date2
      227       then do:
      228         assign
      229           v-date1 = today
      230           v-time  = v-time
      231         .
      232       end.
      233       assign
      234         p-today = v-date1
      235         p-time  = v-time
      236       .
      237     end.
      238   end.
      239   function cur-time-date returns character
      240   :
      241     return string(today, '99/99/9999':U) .
      242   end.
      243   function cur-time-mjd returns decimal
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return integer(v-date) - 2400002 + (v-time / 86400) .
      252   end.
      253   function cur-time-get-ending-index returns integer
      254   (input p-number as integer
      255   )
      256   :
      257     if p-number < 0
      258     or p-number = ?
      259     then do:
      260       return 1 .
      261     end.
      262     define variable v-rest as integer   no-undo .
      263     assign
      264       p-number = p-number modulo 100
      265     .
      266     if p-number < 20
      267     then do:
      268       assign
      269         v-rest = p-number
      270       .
      271     end.
      272     else do:
      273       assign
      274         v-rest = p-number modulo 10
      275       .
      276     end.
      277     case v-rest :
      278       when 1
      279       then do:
      280         return 2 .
      281       end.
      282       when 2 or
      283       when 3 or
      284       when 4
      285       then do:
      286         return 3 .
      287       end.
      288       otherwise do:
      289         return 1 .
      290       end.
      291     end case .
      292   end.
      293   procedure cur-time-mjd-to-date :
      294      define input  parameter i-mjd-diff as decimal no-undo.
      295      define output parameter o-Date     as date    no-undo.
      296      define output parameter o-Time     as integer no-undo.
      297      define variable v-day-number as integer   no-undo .
      298      if    i-mjd-diff < 0
      299         or i-mjd-diff = ?
      300      then do:
      301         return "?" .
      302      end.
      303      assign
      304         v-day-number = truncate(i-mjd-diff,0).
      305         o-Date = date(v-day-number + 2400002).
      306         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      307     .
      308   end.
      309   function cur-time-mjd-to-string returns character
      310   (input p-mjd-diff as decimal
      311   )
      312   :
      313     define variable v-day-number as integer   no-undo .
      314     define variable v-seconds    as integer   no-undo .
      315     define variable v-hour       as integer   no-undo .
      316     define variable v-min        as integer   no-undo .
      317     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      318     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      319     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      320     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      321     if p-mjd-diff < 0
      322     or p-mjd-diff = ?
      323     then do:
      324       return "?" .
      325     end.
      326     assign
      327       v-day-number = integer(truncate(p-mjd-diff,0))
      328       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      329     .
      330     if v-seconds > 86400
      331     then do:
      332       assign
      333         v-seconds = 86400 - 1
      334       .
      335     end.
      336     if v-seconds < 0
      337     then do:
      338       assign
      339         v-seconds = 0
      340       .
      341     end.
      342     assign
      343       v-hour = truncate(v-seconds / 3600, 0)
      344     .
      345     assign
      346       v-seconds = v-seconds modulo 3600
      347     .
      348     assign
      349       v-min = truncate(v-seconds / 60, 0)
      350     .
      351     assign
      352       v-seconds = v-seconds modulo 60
      353     .
      354     return
      355         (if v-day-number <> 0
      356           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      357           else ""
      358         )
      359       + (if v-day-number <> 0 or v-hour <> 0
      360           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      361           else ""
      362         )
      363       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      364           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      365           else ""
      366         )
      367       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      368       .
      369   end.
      370   function cur-time-string returns character
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      379   end.
      380   function cur-time-string-sec returns character
      381   :
      382     define variable v-date as date      no-undo .
      383     define variable v-time as integer   no-undo .
      384     run cur-time in this-procedure
      385       (output v-date
      386       ,output v-time
      387       ) .
      388     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      389   end.
      390   function cur-time-custom  returns character
      391   (input p-prefix as character
      392   ,input p-date-format as character
      393   ,input p-delimiter as character
      394   ,input p-time-format as character
      395   ,input p-suffix as character
      396   )
      397   :
      398     define variable v-date as date      no-undo .
      399     define variable v-time as integer   no-undo .
      400     run cur-time in this-procedure
      401       (output v-date
      402       ,output v-time
      403       ) .
      404     return
      405       p-prefix
      406       + string(v-date, p-date-format)
      407       + p-delimiter
      408       + string(v-time, p-time-format)
      409       + p-suffix
      410       .
      411   end.
      412   function cur-time-print  returns character
      413   :
      414     define variable v-date as date      no-undo .
      415     define variable v-time as integer   no-undo .
      416     run cur-time in this-procedure
      417       (output v-date
      418       ,output v-time
      419       ) .
      420     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      421   end.
      422   function cur-time-datetime returns datetime
      423   :
      424     define variable v-char as character no-undo .
      425     define variable v-datetime as datetime no-undo .
      426     v-char = cur-time-string().
      427     v-datetime = datetime(v-char).
      428     return  v-datetime.
      429   end.
      430   function cur-time-string-msec returns character
      431   :
      432     define variable v-date as datetime  no-undo .
      433     v-date = now.
      434     return string(v-date) .
      435   end.
      436   DEFINE VARIABLE var-entry as character no-undo .
      437   DEFINE VARIABLE loc#log as logical no-undo .
      438   DEFINE VARIABLE calc-line-bef-sum as decimal no-undo .
      439   DEFINE VARIABLE calc-line-aft-sum as decimal no-undo .
      440   DEFINE VARIABLE v-today as date no-undo .
      441   DEFINE VARIABLE v-time as integer no-undo .
      442   define buffer buf_wth-doc for ub.wth-doc .
      443   define buffer buf_wth-line for ub.wth-line .
      444   define buffer inv_wth-doc for ub.wth-doc.
      445   define buffer check_chk-doc for ub.chk-doc .
      446   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
      447     message
      448     vss-workfile vss-revision vss-description skip
      449     "Неверный параметр вызова par-mode" par-mode
      450     view-as alert-box ERROR.
      451     return error '':U.
      452   end.
      453   FIND FIRST buf_wth-doc EXCLUSIVE-LOCK WHERE
      454              buf_wth-doc.doc-code = pardoc-code No-ERROR No-WAIT.
      455   IF LOCKED buf_wth-doc then do:
      456     message vss-workfile vss-revision vss-description skip
      457             "Запись документа МЦ" pardoc-code "занята"
      458             "добавление/изменение строки невозможно"
      459     view-as alert-box error .
      460   end.
      461   IF NOT available buf_wth-doc then do:
      462     message vss-workfile vss-revision vss-description skip
      463             "Не найден документ МЦ" pardoc-code
      464     view-as alert-box error .
      465   end.
      466   if buf_wth-doc.status_ = 'факт':U then do:
      467     message
      468     vss-workfile vss-revision vss-description skip
      469     "Документ МЦ имеет статус" buf_wth-doc.status_
      470    "добавление/изменение строки невозможно"
      471     view-as alert-box ERROR.
      472     return error '':U.
      473   end.
      474   if buf_wth-doc.status_ = 'разрешен':U and
      475   par-mode = 'ДОБАВЛЕНИЕ':U then dO:
      476     message
      477     vss-workfile vss-revision vss-description skip
      478     "Документ МЦ имеет статус" buf_wth-doc.status_
      479     "добавление строки невозможно"
      480     view-as alert-box ERROR.
      481     return error '':U.
      482   end.
      483   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      484     par-rid = ?.
      485     if  parline-exist = yes then do:
      486       FIND FIRST ub.wth-line No-LOCK WHERE
      487                 ub.wth-line.doc-code = pardoc-code AND
      488                 ub.wth-line.wth-code = parwth-code AND
      489                 ub.wth-line.w-p-code = parw-p-code No-ERROR.
      490       if available ub.wth-line then do:
      491         par-rid = recid(ub.wth-line).
      492         assign
      493         parfact-sum = parfact-sum + ub.wth-line.fact-sum
      494         .
      495       end.
      496     end.
      497   end.
      498   run trg/wth-lnv2.p (
      499                   input pardoc-code,
      500                   input buf_wth-doc.host-code,
      501                   input buf_wth-doc.obj-type,
      502                   input buf_wth-doc.obj-code,
      503                   input buf_wth-doc.cli-type,
      504                   input buf_wth-doc.cli-code,
      505                   input buf_wth-doc.auto-fill,
      506                   input buf_wth-doc.borned,
      507                   input par-rid,
      508                   input parwth-code,
      509                   input parw-p-code ) no-error.
      510   if error-status:error then return error return-value.
      511   FIND FIRST buf_wth-line NO-LOCK WHERE
      512             buf_wth-line.obj-type    = buf_wth-doc.obj-type   AND
      513             buf_wth-line.obj-code    = buf_wth-doc.obj-code   AND
      514             buf_wth-line.w-p-code    = parw-p-code   AND
      515             buf_wth-line.shift-date  = buf_wth-doc.shift-date AND
      516             buf_wth-line.shift-num   = buf_wth-doc.shift-num  AND
      517             buf_wth-line.wth-code    = parwth-code   AND
      518             buf_wth-line.status_    <> 'факт':U           AND
      519             RECID( buf_wth-line )   <>  par-rid  NO-ERROR.
      520   IF AVAIL buf_wth-line THEN DO:
      521     FIND FIRST inv_wth-doc NO-LOCK WHERE
      522                 inv_wth-doc.doc-code = buf_wth-line.doc-code No-ERROR.
      523     IF inv_wth-doc.doc-type = 'инв':U THEN DO:
      524       FIND FIRST check_chk-doc No-LOCK WHERE
      525                 check_chk-doc.out-code = inv_wth-doc.doc-code NO-ERROR.
      526       if avail check_chk-doc and string(check_chk-doc.chk-type) = '4':U then.
      527       else do:
      528         MESSAGE
      529         "Материальная ценность" parwth-code "есть в незакрытой инвентаризации"
      530         buf_wth-line.doc-code "по м/х" parw-p-code "!" SKIP
      531         "Невозможно добавить в документ!"
      532         VIEW-AS ALERT-BOX ERROR.
      533         var-entry = "wth-code":U.
      534         RETURN ERROR var-entry.
      535       end.
      536     END.
      537   END.
      538   DO ON ERROR UNDO, return '':U
      539      On STOP UNDO, return '':U:
      540     if par-mode = 'ДОБАВЛЕНИЕ':U and par-rid = ? then do:
      541       run cur-time in this-procedure(output v-today, output v-time).
      542   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   CREATE wth-line.
      544   ASSIGN
      545     wth-line.doc-code     = buf_wth-doc.doc-code
      546     wth-line.w-p-code     = parw-p-code
      547     wth-line.obj-type     = buf_wth-doc.obj-type
      548     wth-line.obj-code     = buf_wth-doc.obj-code
      549     wth-line.shift-date   = buf_wth-doc.shift-date
      550     wth-line.shift-num    = buf_wth-doc.shift-num
      551     wth-line.shift-name   = buf_wth-doc.shift-name
      552     wth-line.creid        = g#userid
      553     wth-line.credate      = v-today
      554   .
      555       assign par-rid = recid(ub.wth-line).
      556     end.
      557     else do:
      558       FIND FIRST ub.wth-line EXCLUSIVE-LOCK WHERE
      559                 recid(ub.wth-line) = par-rid No-WAIT No-ERROR.
      560       if locked ub.wth-line then do:
      561         message "Строка документа МЦ занят"
      562         view-as alert-box error .
      563         return error '':U.
      564       end.
      565       if not avail ub.wth-line then do:
      566         message "Не найдена строка документа МЦ"
      567         view-as alert-box error .
      568         return error '':U.
      569       end.
      570       if buf_wth-doc.status_ = 'разрешен':U and
      571         (ub.wth-line.doc-code <> pardoc-code OR
      572         ub.wth-line.wth-code <> parwth-code OR
      573         ub.wth-line.w-p-code <> parw-p-code OR
      574         ub.wth-line.fact-sum <> parfact-sum ) then dO:
      575         message
      576         vss-workfile vss-revision vss-description skip
      577         "Документ МЦ имеет статус" buf_wth-doc.status_
      578         "изменения невозможны"
      579         view-as alert-box ERROR.
      580         return error '':U.
      581       end.
      582     end.
      583     run wth-lib_cur-stock-place in this-procedure (
      584                                                     input  buf_wth-doc.obj-type
      585                                                    ,input  buf_wth-doc.obj-code
      586                                                    ,input  parw-p-code
      587                                                    ,input parwth-code
      588                                                    ,output calc-line-bef-sum
      589                                                    ) no-error.
      590     if error-status:error then
      591     return error return-value.
      592     assign
      593     ub.wth-line.doc-code = pardoc-code
      594     ub.wth-line.wth-code = parwth-code
      595     ub.wth-line.w-p-code = parw-p-code
      596     buf_wth-doc.bef-sum = buf_wth-doc.bef-sum - ub.wth-line.bef-sum + calc-line-bef-sum
      597     ub.wth-line.bef-sum = calc-line-bef-sum
      598     calc-line-aft-sum = calc-line-bef-sum + parfact-sum
      599     buf_wth-doc.aft-sum = buf_wth-doc.aft-sum - ub.wth-line.aft-sum + calc-line-aft-sum
      600     ub.wth-line.aft-sum = calc-line-aft-sum
      601     buf_wth-doc.fact-sum = buf_wth-doc.fact-sum - ub.wth-line.fact-sum + parfact-sum
      602     ub.wth-line.fact-sum = parfact-sum
      603     .
      604   END.
      605   return '':U.
