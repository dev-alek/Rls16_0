      561           and buf_doc-line-attr.gds-code  = p-gds-code
      562           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      563         no-error .
