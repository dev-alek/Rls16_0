      374   procedure lineattr-delete :
      375     do
      376     on error undo, return error return-value
      377     :
      378       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      379       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      380       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      381       define output parameter p-deleted  as logical no-undo.
      382       define buffer buf_doc-line-attr for ub.doc-line-attr .
      383       def var v-type           as character no-undo .
      384       def var v-format         as character no-undo .
      385       def var v-fillin_width   as integer   no-undo .
      386       def var v-fillin_height  as integer   no-undo .
      387       def var v-label          as character no-undo .
      388       def var v-user-can-edit  as logical   no-undo .
      389       def var v-output-display as logical   no-undo .
      390       def var v-other          as character no-undo .
      391       run lineattr-code in this-procedure
      392         (input  p-code
      393         ,output v-type
      394         ,output v-format
      395         ,output v-fillin_width
      396         ,output v-fillin_height
      397         ,output v-label
      398         ,output v-user-can-edit
      399         ,output v-output-display
      400         ,output v-other
      401         ) no-error .
      402       if error-status :error then do:
      403         undo, return error return-value .
      404       end.
      405       find first buf_doc-line-attr exclusive-lock
      406         where buf_doc-line-attr.doc-code  = p-doc-code
      407           and buf_doc-line-attr.gds-code  = p-gds-code
      408           and buf_doc-line-attr.attr-code = p-code
      409         no-error NO-WAIT.
      410       if not available buf_doc-line-attr then do:
      411         p-deleted = no.
      412       end.
      413       else do:
      414         delete buf_doc-line-attr.
      415         p-deleted = yes.
      416       end.
      417     end.
      418   end procedure.
      419   procedure lineattr-code :
      420     do on error undo, return error return-value
      421     :
      422       define input  parameter p-code           as character no-undo .
      423       define output parameter p-type           as character no-undo .
      424       define output parameter p-format         as character no-undo .
      425       define output parameter p-fillin_width   as integer   no-undo .
      426       define output parameter p-fillin_height  as integer   no-undo .
      427       define output parameter p-label          as character no-undo .
      428       define output parameter p-user-can-edit  as logical   no-undo .
      429       define output parameter p-output-display as logical   no-undo .
      430       define output parameter p-other          as character no-undo .
      431       case p-code :
      432               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      433               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      434               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      435               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      436               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      437               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      438               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      439               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      440               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      441               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      442               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      443         otherwise do:
      444           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      445         end.
      446       end.
      447     end.
      448   end procedure.
      449   procedure lineattr-value-flora-gds :
      450     do
      451     on error undo, return error return-value
      452     :
      453       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      454       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      455       define input  parameter p-prt-code    as integer   no-undo .
      456       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      457       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      458       define output parameter p-value       as    decimal   no-undo .
      459       define buffer buf_doc-line-attr for ub.doc-line-attr .
      460       find first buf_doc-line-attr no-lock
      461         where buf_doc-line-attr.doc-code  = p-doc-code
      462           and buf_doc-line-attr.gds-code  = p-gds-code
      463           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      464         no-error .
      465       if avail buf_doc-line-attr then do:
      466         assign
      467           p-value = decimal( buf_doc-line-attr.attr-value)
      468         .
      469       end.
      470       else do:
      471         assign
      472           p-value = 0
      473         .
      474       end.
      475     end.
      476   end procedure.
      477   procedure lineattr-write-flora-gds :
      478     do
      479     on error undo, return error return-value
      480     :
      481       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      482       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      483       define input parameter p-prt-code    as integer   no-undo .
      484       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      485       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      486       define input parameter p-value    as decimal   no-undo .
      487       define buffer buf_doc-line-attr for ub.doc-line-attr .
      488       find first buf_doc-line-attr exclusive-lock
      489         where buf_doc-line-attr.doc-code  = p-doc-code
      490           and buf_doc-line-attr.gds-code  = p-gds-code
      491           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      492         no-error .
      493       if not available buf_doc-line-attr then do:
      494         create buf_doc-line-attr .
      495         assign
      496           buf_doc-line-attr.doc-code  = p-doc-code
      497           buf_doc-line-attr.gds-code  = p-gds-code
      498           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      499         .
      500       end.
      501       assign
      502         buf_doc-line-attr.attr-value = string( p-value )
      503       .
      504     end.
      505   end procedure.
      506   procedure lineattr-delete-flora-gds :
      507     do
      508     on error undo, return error return-value
      509     :
      510       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      511       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      512       define input  parameter p-prt-code    as integer   no-undo .
      513       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      514       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      515       define output parameter p-deleted  as logical no-undo.
      516       define buffer buf_doc-line-attr for ub.doc-line-attr .
      517       find first buf_doc-line-attr exclusive-lock
      518         where buf_doc-line-attr.doc-code  = p-doc-code
      519           and buf_doc-line-attr.gds-code  = p-gds-code
      520           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      521         no-error NO-WAIT.
      522       if not available buf_doc-line-attr then do:
      523         p-deleted = no.
      524       end.
      525       else do:
      526         delete buf_doc-line-attr.
      527         p-deleted = yes.
      528       end.
      529     end.
      530   end procedure.
      531   procedure lineattr-delete-flora-all :
      532     do
      533     on error undo, return error return-value
      534     :
      535       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      536       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      537       define input  parameter p-prt-code    as integer   no-undo .
      538       define buffer buf_doc-line-attr for ub.doc-line-attr .
      539       for each buf_doc-line-attr exclusive-lock
      540         where buf_doc-line-attr.doc-code  = p-doc-code
      541           and buf_doc-line-attr.gds-code  = p-gds-code
      542           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      543        :
      544         delete buf_doc-line-attr.
      545       end.
      546    end.
      547   end procedure.
      548   procedure lineattr-exist-flora-gds :
