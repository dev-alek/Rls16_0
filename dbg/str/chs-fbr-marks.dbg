      858   procedure xmlchar-test :
      859   define input parameter p-in-string          as character        no-undo.
      860   define output parameter p-out-string-enc    as character        no-undo.
      861   define output parameter p-out-string-dec    as character        no-undo.
      862   do
      863   on error undo, return error
      864   :
      865          run xmlchar-encode in this-procedure
      866       (
      867             input p-in-string
      868           , output p-out-string-enc
      869       ).
      870          run xmlchar-decode in this-procedure
      871       (
      872             input p-out-string-enc
      873           , output p-out-string-dec
      874       ).
      875   end.
      876   end .
      877   procedure xmlchar-encode :
      878   define input parameter p-in-string      as character        no-undo.
      879   define output parameter p-out-string    as character        no-undo.
      880       define variable v-position      as integer      no-undo.
      881       define variable v-current-char  as character    no-undo.
      882   do
      883   on error undo, return error
      884   :
      885       assign
      886           p-out-string = "":U
      887       .
      888       case p-in-string
      889       :
      890           when ?
      891           then do:
      892               assign
      893                   p-out-string = "?":U
      894               .
      895           end.
      896           when "?":U
      897           then do:
      898               assign
      899                   p-out-string = "&#63;":U
      900               .
      901           end.
      902           otherwise do:
      903               do v-position = 1 to length( p-in-string )
      904               :
      905                   assign
      906                       v-current-char = substring( p-in-string, v-position, 1 )
      907                   .
      908                   case v-current-char
      909                   :
      910                       when "&":U
      911                       then do:
      912                           assign
      913                               p-out-string = p-out-string + "&amp;":U
      914                           .
      915                       end.
      916                       when ">":U
      917                       then do:
      918                           assign
      919                               p-out-string = p-out-string + "&gt;":U
      920                           .
      921                       end.
      922                       when "<":U
      923                       then do:
      924                           assign
      925                               p-out-string = p-out-string + "&lt;":U
      926                           .
      927                       end.
      928                       when "'":U
      929                       then do:
      930                           assign
      931                               p-out-string = p-out-string + "&apos;":U
      932                           .
      933                       end.
      934                       when '"':U
      935                       then do:
      936                           assign
      937                               p-out-string = p-out-string + "&quot;":U
      938                           .
      939                       end.
      940                       when chr(1)
      941                       then do:
      942                           assign
      943                               p-out-string = p-out-string + "":U
      944                           .
      945                       end.
      946                       when chr(2)
      947                       then do:
      948                           assign
      949                               p-out-string = p-out-string + "":U
      950                           .
      951                       end.
      952                       when chr(3)
      953                       then do:
      954                           assign
      955                               p-out-string = p-out-string + "":U
      956                           .
      957                       end.
      958                       when chr(4)
      959                       then do:
      960                           assign
      961                               p-out-string = p-out-string + "":U
      962                           .
      963                       end.
      964                       when chr(5)
      965                       then do:
      966                           assign
      967                               p-out-string = p-out-string + "":U
      968                           .
      969                       end.
      970                       when chr(6)
      971                       then do:
      972                           assign
      973                               p-out-string = p-out-string + "":U
      974                           .
      975                       end.
      976                       when chr(7)
      977                       then do:
      978                           assign
      979                               p-out-string = p-out-string + "":U
      980                           .
      981                       end.
      982                       when chr(8)
      983                       then do:
      984                           assign
      985                               p-out-string = p-out-string + "":U
      986                           .
      987                       end.
      988                       when chr(9)
      989                       then do:
      990                           assign
      991                               p-out-string = p-out-string + "":U
      992                           .
      993                       end.
      994                       when chr(29)
      995                       then do:
      996                           assign
      997                               p-out-string = p-out-string + "":U
      998                           .
      999                       end.
     1000                       when chr(10)
     1001                       then do:
     1002                           assign
     1003                               p-out-string = p-out-string + "&#10;":U
     1004                           .
     1005                       end.
     1006                       when chr(13)
     1007                       then do:
     1008                           assign
     1009                               p-out-string = p-out-string + "&#13;":U
     1010                           .
     1011                       end.
     1012                       otherwise do:
     1013                           assign
     1014                               p-out-string = p-out-string + v-current-char
     1015                           .
     1016                       end.
     1017                   end case.
     1018               end.
     1019           end.
     1020       end case.
     1021   end.
     1022   end .
     1023   procedure xmlchar-encode-1c :
     1024   define input parameter p-in-string      as character        no-undo.
     1025   define output parameter p-out-string    as character        no-undo.
     1026       define variable v-position      as integer      no-undo.
     1027       define variable v-current-char  as character    no-undo.
     1028   do
     1029   on error undo, return error
     1030   :
     1031       assign
     1032           p-out-string = "":U
     1033       .
     1034       case p-in-string
     1035       :
     1036           when ?
     1037           then do:
     1038               assign
     1039                   p-out-string = "?":U
     1040               .
     1041           end.
     1042           otherwise do:
     1043               do v-position = 1 to length( p-in-string )
     1044               :
     1045                   assign
     1046                       v-current-char = substring( p-in-string, v-position, 1 )
     1047                   .
     1048                   case v-current-char
     1049                   :
     1050                       when chr(1)
     1051                       then do:
     1052                           assign
     1053                               p-out-string = p-out-string + " ":U
     1054                           .
     1055                       end.
     1056                       when chr(2)
     1057                       then do:
     1058                           assign
     1059                               p-out-string = p-out-string + " ":U
     1060                           .
     1061                       end.
     1062                       when chr(3)
     1063                       then do:
     1064                           assign
     1065                               p-out-string = p-out-string + " ":U
     1066                           .
     1067                       end.
     1068                       when chr(4)
     1069                       then do:
     1070                           assign
     1071                               p-out-string = p-out-string + " ":U
     1072                           .
     1073                       end.
     1074                       when chr(5)
     1075                       then do:
     1076                           assign
     1077                               p-out-string = p-out-string + " ":U
     1078                           .
     1079                       end.
     1080                       when chr(6)
     1081                       then do:
     1082                           assign
     1083                               p-out-string = p-out-string + " ":U
     1084                           .
     1085                       end.
     1086                       when chr(7)
     1087                       then do:
     1088                           assign
     1089                               p-out-string = p-out-string + " ":U
     1090                           .
     1091                       end.
     1092                       when chr(8)
     1093                       then do:
     1094                           assign
     1095                               p-out-string = p-out-string + " ":U
     1096                           .
     1097                       end.
     1098                       when chr(9)
     1099                       then do:
     1100                           assign
     1101                               p-out-string = p-out-string + " ":U
     1102                           .
     1103                       end.
     1104                       when chr(29)
     1105                       then do:
     1106                           assign
     1107                               p-out-string = p-out-string + " ":U
     1108                           .
     1109                       end.
     1110                       when chr(10)
     1111                       then do:
     1112                           assign
     1113                               p-out-string = p-out-string + " ":U
     1114                           .
     1115                       end.
     1116                       when chr(13)
     1117                       then do:
     1118                           assign
     1119                               p-out-string = p-out-string + " ":U
     1120                           .
     1121                       end.
     1122                       otherwise do:
     1123                           assign
     1124                               p-out-string = p-out-string + v-current-char
     1125                           .
     1126                       end.
     1127                   end case.
     1128               end.
     1129           end.
     1130       end case.
     1131   end.
     1132   end .
     1133   procedure xmlchar-decode :
     1134   define input parameter p-in-string      as character        no-undo.
     1135   define output parameter p-out-string    as character        no-undo.
     1136       define variable v-position      as integer      no-undo.
     1137       define variable v-last-position as integer      no-undo.
     1138       define variable v-temp-integer  as integer      no-undo.
     1139       define variable v-current-char  as character    no-undo.
     1140       define variable v-next-char     as character    no-undo.
     1141       define variable v-success       as logical      no-undo.
     1142   do
     1143   on error undo, return error
     1144   :
     1145       assign
     1146           p-out-string = "":U
     1147           v-position   = 0
     1148       .
     1149       replace-cycle:
     1150       do while yes
     1151       on error undo, return error
     1152       :
     1153           assign
     1154               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1155           .
     1156           if v-last-position <= v-position
     1157           then do:
     1158               if v-position = 0
     1159               then do:
     1160                   assign
     1161                       p-out-string = p-in-string
     1162                   .
     1163               end.
     1164               else do:
     1165                   assign
     1166                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1167                   .
     1168               end.
     1169               leave replace-cycle.
     1170           end.
     1171           else do:
     1172               assign
     1173                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1174                   v-position      = v-last-position
     1175                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1176               .
     1177               if v-current-char = "#":U
     1178               then do:
     1179                   assign
     1180                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1181                   .
     1182                   if v-last-position > 0
     1183                   then do:
     1184                       run xmlchar-read-integer in this-procedure
     1185                        (
     1186                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1187                           , output v-temp-integer
     1188                           , output v-success
     1189                       ).
     1190                       if v-success = yes
     1191                       and v-temp-integer >= 1
     1192                       and v-temp-integer <= 255
     1193                       then do:
     1194                           assign
     1195                               p-out-string = p-out-string + chr( v-temp-integer )
     1196                               v-position   = v-last-position + 1
     1197                           .
     1198                       end.
     1199                       else do:
     1200                           assign
     1201                               p-out-string = p-out-string + "&":U
     1202                               v-position   = v-position   + 1
     1203                           .
     1204                       end.
     1205                   end.
     1206                   else do:
     1207                       assign
     1208                           p-out-string = p-out-string + "&":U
     1209                           v-position   = v-position   + 1
     1210                       .
     1211                   end.
     1212               end.
     1213               else do:
     1214                   case substring( p-in-string, v-position + 1, 3 )
     1215                   :
     1216                       when "lt;":U
     1217                       then do:
     1218                           assign
     1219                               p-out-string = p-out-string + "<":U
     1220                               v-position   = v-position   + 3
     1221                           .
     1222                       end.
     1223                       when "gt;":U
     1224                       then do:
     1225                           assign
     1226                               p-out-string = p-out-string + ">":U
     1227                               v-position   = v-position   + 3
     1228                           .
     1229                       end.
     1230                       otherwise do:
     1231                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1232                           then do:
     1233                               assign
     1234                                   p-out-string = p-out-string + "&":U
     1235                                   v-position   = v-position   + 4
     1236                               .
     1237                           end.
     1238                           else do:
     1239                               case substring( p-in-string, v-position + 1, 5 )
     1240                               :
     1241                                   when "quot;":U
     1242                                   then do:
     1243                                       assign
     1244                                           p-out-string = p-out-string + '"':U
     1245                                           v-position   = v-position   + 5
     1246                                       .
     1247                                   end.
     1248                                   when "apos;":U
     1249                                   then do:
     1250                                       assign
     1251                                           p-out-string = p-out-string + "'":U
     1252                                           v-position   = v-position   + 5
     1253                                       .
     1254                                   end.
     1255                                   otherwise do:
     1256                                       assign
     1257                                           p-out-string = p-out-string + "&":U
     1258                                       .
     1259                                   end.
     1260                               end case.
     1261                           end.
     1262                       end.
     1263                   end case.
     1264               end.
     1265           end.
     1266       end.
     1267   end.
     1268   end .
     1269   procedure xmlchar-read-integer :
     1270   define input parameter p-input-string      as character        no-undo.
     1271   define output parameter p-output-integer   as integer          no-undo.
     1272   define output parameter p-success       as logical          no-undo.
     1273   do
     1274   on error undo, return error
     1275   :
     1276       assign
     1277           p-output-integer = integer( p-input-string )
     1278       no-error.
     1279       if error-status :error
     1280       then do:
     1281           assign
     1282               p-success           = no
     1283               p-output-integer    = 0
     1284           .
     1285       end.
     1286       else do:
     1287           assign
     1288               p-success           = yes
     1289           .
     1290       end.
     1291   end.
     1292   end.
     1293   define new global shared variable g#attr-lib  as handle no-undo .
     1294   define variable v-attr-lib-variable as handle no-undo .
     1295   define variable mMRCCode  as logical    no-undo.
     1296   define variable mTypeMark as character  no-undo.
     1297   function IS-NeedMark returns logical
     1298   ( input ib-code as integer  ,
     1299     input ib-str as character ):
     1300      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1301      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1302                                    and buf_prod-bc-attr.b-str  eq ib-str
     1303                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1304        no-lock no-error.
     1305      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1306   end.
     1307   function repTegforDm return char
     1308   (iDM as char ):
     1309       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1310       define variable vteg as character no-undo.
     1311       define variable oDM as character no-undo.
     1312       define variable vi as integer no-undo.
     1313       oDM = iDm.
     1314       do vi = 1 to num-entries(vTeglist):
     1315          vTeg = entry(vi,vTeglist).
     1316          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1317       end.
     1318       return oDM.
     1319   end.
     1320   function repSpecSimbforDm return char
     1321   (iDM as char ):
     1322       define variable oDM as character no-undo.
     1323     run
     1324       xmlchar-decode(iDM, output oDM).
     1325     return repTegforDm (oDM).
     1326   end.
     1327   function CheckGtin return logical
     1328   (iGtin as char):
     1329      define variable bar_code as character no-undo.
     1330      define variable vGtin as logical no-undo init "yes".
     1331      if length(iGtin) eq 14
     1332      then do:
     1333         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1334         run str/chk-sum.p
     1335          (input-output bar_code ) no-error .
     1336         if iGtin ne  bar_code
     1337         then
     1338            vGtin = no.
     1339      end.
     1340      else
     1341         vGtin = no.
     1342      return vgtin.
     1343   end.
     1344   function repSpecSimbforXlm return char
     1345   (iDM as char ):
     1346       iDM = replace(iDM,chr(29),"").
     1347       return iDM.
     1348   end.
     1349   function getGtinByDM return char
     1350   (IDM as char):
     1351      define variable VTXT as char no-undo.
     1352      define variable vGtin as char no-undo.
     1353      vTXt = IdM.
     1354      vGtin = IDM.
     1355      if    length(vtxt) > 14
     1356      then do:
     1357         if   vtxt begins "(01)"
     1358                or vtxt begins "(02)"
     1359         then
     1360            vGtin = substring(vtxt,5,14).
     1361         else if   (vtxt begins "01"
     1362                or vtxt begins "02" )
     1363                and (   (    substring(iDm,17,2) eq "21"
     1364                         and length(vtxt) >= 21)
     1365                     or substring(iDm,17,2) eq "37"
     1366                     or substring(iDm,17,4) eq "(37)" )
     1367         then do:
     1368            vGtin = substring(vtxt,3,14).
     1369            if not checkGtin(vGtin)
     1370            then
     1371               vGtin = substring(vtxt,1,14).
     1372         end.
     1373         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1374             or length(vtxt) eq 14 + 7 + 4
     1375             or length(vtxt) eq 14 + 7
     1376         then
     1377            vGtin = substring(vtxt,1,14).
     1378      end.
     1379      if not checkGtin(vGtin)
     1380      then
     1381         vGtin = "".
     1382      return vgtin.
     1383   end.
     1384   function getGdsCodeByGtin return int
     1385   (iGtin as char):
     1386      define buffer prod-bc  for ub.prod-bc.
     1387      define buffer bar-code for ub.bar-code.
     1388      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1389      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1390      return if avail bar-code then bar-code.gds-code else ?.
     1391   end.
     1392   function getQntyCodeByGtin return decimal
     1393   (iGtin as char):
     1394      define buffer prod-bc  for ub.prod-bc.
     1395      define buffer bar-code for ub.bar-code.
     1396      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1397      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1398      return if avail bar-code then bar-code.cli-base-rate else ?.
     1399   end.
     1400   function getGdsCodeByDM return int
     1401   (iDm as char):
     1402      define variable vGtin as char no-undo.
     1403      define buffer prod-bc for ub.prod-bc.
     1404      vGtin  = getGtinByDM (IDM ).
     1405      return getGdsCodeByGtin (vGtin).
     1406   end.
     1407   function ChekTypeMarkByGds return logical
     1408   (iGds-code as integer ):
     1409      define buffer goods-attr for ub.goods-attr.
     1410      find first goods-attr where goods-attr.gds-code   = iGds-code
     1411                              and goods-attr.attr-code  = 'mark-type':U
     1412      no-lock no-error.
     1413      if available goods-attr
     1414      then do:
     1415         mTypeMark = goods-attr.attr-value.
     1416         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1417           .
     1418      end.
     1419      else
     1420         return no.
     1421   end.
     1422   function ChekTypeMarkByDm return logical
     1423   (iDM as char ):
     1424      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1425   end.
     1426   function ChekTypeMarkByGtin return logical
     1427   (iGtin as char ):
     1428      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1429   end.
     1430   function GetNextElement return character
     1431     (input iAllTeg        as logical
     1432     ,output oteg          as character
     1433     ,output otegval       as character
     1434     ,input-output pstr    as character
     1435      ):
     1436        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1437        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1438        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1439        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1440        define variable vTeg as character no-undo.
     1441        define variable vLength as integer no-undo.
     1442        define variable vi as integer no-undo.
     1443        define variable vj as integer no-undo.
     1444        define buffer code for ub.code.
     1445        find first code where Code.parent eq "MarkType"
     1446                          and Code.CodeValue   eq mTypeMark
     1447                          no-lock no-error.
     1448        if     available code
     1449           and Code.misc1 ne ""
     1450           and Code.misc1 ne ?
     1451        then do:
     1452           integer (Code.misc1) no-error.
     1453           if not error-status:error
     1454           then
     1455             entry (4,vlistleng) = Code.misc1.
     1456        end.
     1457        if iAllTeg
     1458        then
     1459           assign
     1460              vlistElem     = vlistElem    + vlistElemDop
     1461              vlistleng     = vlistleng    + vlistlengDop
     1462           .
     1463        else if mMRCCode
     1464        then
     1465           assign
     1466              vlistElem     = vlistElem    + ",(8005),8005"
     1467              vlistleng     = vlistleng    + ",000006,0006"
     1468           .
     1469       block-elem:
     1470       do vi = 1 to num-entries(vlistElem):
     1471          vTeg = entry(vi,vlistElem).
     1472          if pstr begins vTeg
     1473          then do:
     1474             if    vTeg eq "21"
     1475             then
     1476                vLength = index(pstr,chr(29)) - 2 no-error.
     1477             if vLength  <= 0
     1478             then
     1479                vLength = int(entry(vi,vlistleng)).
     1480             otegval = substring (pstr,length(vteg) + 1, vLength).
     1481             oteg = replace(replace(vteg,")",""),"(","").
     1482             vTeg = vteg + otegval.
     1483             otegval = replace(otegval,chr(29),"").
     1484             oteg = replace(replace(oteg,")",""),"(","").
     1485             pstr = substring (pstr,length(vTeg)+ 1).
     1486             vTeg = replace(vTeg,chr(29),"").
     1487             leave block-elem.
     1488          end.
     1489          else
     1490             vTeg = "".
     1491       end.
     1492       return vteg.
     1493   end.
     1494   function GetCodeIdent return character
     1495   (iDm as char):
     1496      define variable Velement   as character no-undo init "first".
     1497      define variable oCodeIdent as character no-undo.
     1498      define variable vteg as character no-undo.
     1499      define variable vtegval as character no-undo.
     1500      define variable vGtin as character no-undo.
     1501      define buffer marking for ub.marking.
     1502      for first marking no-lock where
     1503                marking.mark eq iDm
     1504            and marking.unit-ext = "LEVEL2"
     1505      :
     1506        return iDm.
     1507      end.
     1508      vGtin  = getGtinByDM (iDm ).
     1509      ChekTypeMarkByDm(idm).
     1510      if iDm begins 'tech_':U
     1511      then
     1512         oCodeIdent = iDm.
     1513      else if length(iDm) < 21
     1514      then do:
     1515         find first marking where marking.mark eq idm
     1516         no-lock no-error.
     1517         oCodeIdent = if available marking then marking.mark else  ?.
     1518      end.
     1519      else if     length(iDm) eq 29
     1520         and not iDm begins "01"
     1521         and not iDm begins "02"
     1522      then
     1523         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1524      else  if     length(iDm) >= 24
     1525               and (  iDm begins "01"
     1526                   or iDm begins "02")
     1527               and  substring(iDm,17,2) ne "21"
     1528      then do:
     1529         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1530                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1531         then
     1532            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1533         else
     1534            oCodeIdent = iDM.
     1535      end.
     1536      else  if     (   length(iDm) eq 25
     1537                    or length(iDm) eq 21)
     1538               and (not iDm begins "01"
     1539               and  not iDm begins "02")
     1540      then
     1541         oCodeIdent = substring(iDm,1,21).
     1542      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1543      then
     1544         oCodeIdent = substring(iDm,1,21).
     1545      else do while Velement ne "" and idm ne "":
     1546         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1547         oCodeIdent = oCodeIdent + Velement.
     1548      end.
     1549      return oCodeIdent.
     1550   end.
     1551   function GetTegCod return character
     1552   (icodeIdent as char, iTeg as char):
     1553      define variable Velement   as character no-undo init "first".
     1554      define variable oTeg as character no-undo init ?.
     1555      define variable vteg as character no-undo.
     1556      define variable vtegval as character no-undo.
     1557      if     ((length(icodeIdent) eq 21
     1558         and not icodeIdent begins "01"
     1559         and not icodeIdent begins "02")
     1560         or
     1561             ( length(icodeIdent) eq 25
     1562               and not icodeIdent begins "01"
     1563               and not icodeIdent begins "02"))
     1564      then do:
     1565         if iTeg eq "01" or iTeg eq "02"
     1566         then
     1567            oTeg = substring(icodeIdent,1,21).
     1568         else  if  iTeg eq "21"
     1569         then
     1570            oTeg = substring(icodeIdent,15,7).
     1571      end.
     1572      else do:
     1573         ChekTypeMarkByDm(icodeIdent).
     1574         block-teg:
     1575            do while Velement ne "" and icodeIdent ne "":
     1576            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1577            if    Velement begins iTeg
     1578               or Velement begins "(" + iTeg + ")"
     1579            then do:
     1580               oTeg = vtegval.
     1581               leave block-teg.
     1582            end.
     1583         end.
     1584      end.
     1585      return oTeg.
     1586   end.
     1587   function isOAD return logical
     1588   (icodeIdent as character):
     1589      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1590   end.
     1591   function isMark return logical
     1592   (icodeIdent as character):
     1593      define buffer buf_marking for ub.marking.
     1594      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1595             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1596   end.
     1597   function addBracketForCode return character
     1598   (icodeIdent as char):
     1599      define variable Velement   as character no-undo init "first".
     1600      define variable oTeg as character no-undo.
     1601      define variable vteg as character no-undo.
     1602      define variable vtegval as character no-undo.
     1603      define buffer marking for ub.marking.
     1604      find first marking no-lock where
     1605                 marking.mark begins icodeIdent no-error.
     1606      if    not ChekTypeMarkByDm(icodeIdent)
     1607         or length(icodeIdent) le 24
     1608         or (avail marking and marking.unit-ext = "LEVEL2")
     1609      then
     1610         oTeg = icodeIdent.
     1611      else do:
     1612         if (  icodeIdent begins "01"
     1613            or icodeIdent begins "02"
     1614            ) and CheckGtin(substring (icodeIdent,3,14))
     1615            and substring (icodeIdent,17,2) eq "21"
     1616         then do:
     1617            mMRCCode = yes.
     1618            ChekTypeMarkByDm(icodeIdent).
     1619            block-teg:
     1620            do while Velement ne "" and icodeIdent ne "":
     1621               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1622               if vteg ne ""
     1623               then
     1624                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1625            end.
     1626            mMRCCode = no.
     1627         end.
     1628         else do:
     1629            oTeg = icodeIdent.
     1630         end.
     1631      end.
     1632      return oTeg.
     1633   end.
     1634   function getlevelByCodId return int
     1635   (iCode as char):
     1636      define variable vLength as int no-undo.
     1637      define variable vLevel  as int no-undo.
     1638      if not ChekTypeMarkByDM (icode) then return ?.
     1639      vLength = length(iCode).
     1640      if    vLength eq 18
     1641         or vLength eq 20
     1642      then
     1643         Vlevel = 4.
     1644      else if vLength eq 21
     1645      then
     1646         Vlevel = 1.
     1647      else if vLength eq 25
     1648      then do:
     1649         if  iCode begins "01"
     1650         then
     1651            Vlevel = 3.
     1652         else
     1653            Vlevel = 1.
     1654      end.
     1655      else if     vLength >= 26
     1656              and vLength <= 46
     1657      then do:
     1658         if    substring(iCode,17,2) eq "11"
     1659            or substring(iCode,17,2) eq "13"
     1660            or (    substring(iCode,17,2) eq "21"
     1661                and vLength >= 33
     1662                and substring(iCode,26,4) ne "8005")
     1663         then
     1664            Vlevel = 4.
     1665         else if    vLength eq 31
     1666                 or vLength eq 38
     1667                 or vLength eq 39
     1668                 or vLength eq 45
     1669         then
     1670            Vlevel = 1.
     1671         else if    vLength eq 35
     1672                 or vLength eq 43
     1673         then
     1674            Vlevel = 3.
     1675         else
     1676            Vlevel = ?.
     1677      end.
     1678      else
     1679         Vlevel = ?.
     1680      return Vlevel.
     1681   end.
     1682   function getLevelMotpBycodid return character
     1683   (iDm as char):
     1684      define variable vLevel as integer no-undo.
     1685      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1686      vLevel = getlevelByCodId(iDm).
     1687      if    vLevel eq ?
     1688         or vLevel < 1
     1689         or vLevel > 6
     1690      then
     1691         return ?.
     1692      else
     1693         return entry(vlevel,vList).
     1694   end.
     1695   function getLevelUTDByLevelMotp return character
     1696   (iUnit as char):
     1697      define variable vLevel as integer no-undo.
     1698      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1699      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1700      vLevel = lookup(iUnit,vListMOTP).
     1701      if    vLevel eq ?
     1702         or vLevel < 1
     1703         or vLevel > 4
     1704      then
     1705         return ?.
     1706      else
     1707         return entry(vlevel,vListutd).
     1708   end.
     1709   function getLevelMotpByDM return character
     1710   (iDm as char):
     1711      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1712   end.
     1713   function getLevelUTDByCodId return character
     1714   (iDm as char):
     1715      define variable vLevel as integer no-undo.
     1716      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1717      vLevel = getlevelByCodId(iDm).
     1718      if    vLevel eq ?
     1719         or vLevel < 1
     1720         or vLevel > 4
     1721      then
     1722         return ?.
     1723      else
     1724         return entry(vlevel,vList).
     1725   end.
     1726   function getLevelUTDByDM return character
     1727   (iDm as char):
     1728      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1729   end.
     1730   define variable mNotMarkQnty as logical no-undo.
     1731   function getQntyUTDByCodId return decimal
     1732   (iDM as char):
     1733      define variable vLevel as integer no-undo.
     1734      define variable vList as character no-undo init "1,5,10,500".
     1735      define variable vGtin as character no-undo.
     1736      define variable vqnty as decimal no-undo init ?.
     1737      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1738      if vqnty eq ?
     1739      then do:
     1740         if not mNotMarkQnty
     1741         then do:
     1742            define buffer marking for ub.marking.
     1743            define variable vCodident as character no-undo.
     1744            vCodident = GetCodeIdent(idm).
     1745            find first marking where marking.mark begins vCodident no-lock no-error.
     1746            if     available marking
     1747               and marking.box-qnty ne ?
     1748            then
     1749               return marking.box-qnty.
     1750         end.
     1751         vGtin = getGtinByDm(iDM).
     1752         if ChekTypeMarkByGtin (vGtin)
     1753         then do:
     1754            vLevel = getlevelByCodId(iDM).
     1755            if     vLevel >= 1
     1756               and vLevel <= 4
     1757            then
     1758               vqnty = int(entry(vlevel,vList)).
     1759         end.
     1760         else
     1761            vqnty = getQntyCodeByGtin(vgtin).
     1762      end.
     1763      return vqnty.
     1764   end.
     1765   function getQntyUTDByDM return decimal
     1766   (iDm as char):
     1767      define variable vDM as character no-undo.
     1768      if     length (iDm) ne 25
     1769         and length (iDm) ne 29
     1770         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1771      then
     1772         vDM = substring (iDm,1,length (iDm) - 6 ).
     1773      else
     1774         vDM = substring (iDm,1,length (iDm) - 4 ).
     1775      return getQntyUTDByCodId(vDM).
     1776   end.
     1777   function getMRC4 return decimal
     1778   (iMRC as char):
     1779      define variable oMrc     as decimal no-undo init ?.
     1780      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1781      define variable vi       as integer no-undo.
     1782      define variable vfound   as integer no-undo.
     1783      define variable vposStart   as integer no-undo.
     1784      do:
     1785      OMRc = 0.
     1786      do vi = 1 to 4:
     1787         define variable vsimb as character no-undo.
     1788         vsimb = substring(iMRC,vi,1).
     1789         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1790         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1791         if vfound > 0
     1792         then
     1793            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1794         end.
     1795         OMRc = OMRc / 100.
     1796      end.
     1797      return OMRc.
     1798   end.
     1799   function getMRCByDM return decimal
     1800   (iDm as char):
     1801      define variable vMRC     as character no-undo.
     1802      define variable oMrc     as decimal no-undo init ?.
     1803      define variable Velement as character no-undo init "empty".
     1804      define variable vteg as character no-undo.
     1805      define variable vtegval as character no-undo.
     1806      if    length(idm) eq 14 + 7 + 4 + 4
     1807         or length(idm) eq 14 + 7 + 4
     1808      then do:
     1809         vMRC = substring(idm,22,4).
     1810         omrc = getMRC4(vMRC).
     1811      end.
     1812      else do:
     1813          ChekTypeMarkByDm(iDm).
     1814          block-mrc:
     1815          do while Velement ne "" and idm ne "":
     1816             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1817             if Velement begins "8005"
     1818             then do:
     1819                vMRC = substring(Velement,5,6).
     1820                leave block-mrc.
     1821             end.
     1822             else if Velement begins "(8005)"
     1823             then do:
     1824                vMRC = substring(Velement,7,6).
     1825                leave block-mrc.
     1826             end.
     1827          end.
     1828          if vMRC ne ""
     1829          then
     1830             OMRc = dec(vmrc) / 100 no-error.
     1831      end.
     1832      return OMRc.
     1833   end.
     1834   function MoveDate return Date
     1835   (idate as date,
     1836    iMonth as int64):
     1837      define variable vMonth   as int64 no-undo.
     1838      define variable vYear    as int64 no-undo.
     1839      define variable vDateNew as date  no-undo.
     1840       define variable vDay     as int64 no-undo.
     1841       vMonth = month(iDate) + iMonth.
     1842       vYear =  year(iDate).
     1843       if vMonth <= 0
     1844       then assign
     1845          vMonth = vMonth + 12
     1846           vYear  = vYear - 1
     1847       .
     1848       else if vMonth > 12
     1849       then assign
     1850          vMonth = vMonth - 12
     1851           vYear  = vYear + 1
     1852       .
     1853       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1854       do while error-status:error eq yes:
     1855          VDay = vDay + 1.
     1856          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1857       end.
     1858       if VDay > 0
     1859       then
     1860          vDateNew + 1.
     1861       return vDateNew.
     1862   end.
     1863   procedure checkEMRC:
     1864   define input  parameter iDm as character no-undo.
     1865   define output parameter vok as logical   no-undo init yes.
     1866      define variable v-value-emrc as character no-undo.
     1867      define variable v-type-emrc  as character no-undo.
     1868      define variable vDateIso     as character no-undo.
     1869      define variable vMRC         as decimal no-undo.
     1870      define variable vqnty        as decimal no-undo.
     1871      define variable vPrice       as decimal no-undo.
     1872      define variable vparent      as character no-undo.
     1873      define variable vgds-code    as integer no-undo.
     1874      define buffer code for ub.code.
     1875      vMRC = getMRCByDM(iDm).
     1876      if vMRC > 0
     1877      then do:
     1878         vgds-code = getGdsCodeByDM(iDm).
     1879         vqnty     = getQntyUTDByDM(iDm).
     1880               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1881            (
     1882             input   vgds-code
     1883            ,input   'emrc-type':U
     1884            ,output   v-value-emrc
     1885            ,output   v-type-emrc
     1886          ) no-error.
     1887          if     v-value-emrc ne ""
     1888             and v-value-emrc ne ?
     1889          then do:
     1890             vDateIso = iso-date(today).
     1891             vPrice = vMRC / vqnty.
     1892             vparent ="emc" + chr(4) + v-value-emrc.
     1893             find last code where Code.parent      eq vparent
     1894                              and Code.code        le vDateIso
     1895                              and code.status_  eq 0
     1896             no-lock no-error.
     1897             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1898             then
     1899                vOk = true .
     1900             else do:
     1901                 define variable vText      as character no-undo.
     1902                 define variable vDate      as date no-undo.
     1903                 define variable vDateLast  as character no-undo.
     1904                 define variable vDateFirst as character no-undo.
     1905                 define variable vDate3     as date no-undo.
     1906                 vdate = date(code.misc1).
     1907                 vDateLast = code.misc1.
     1908                 vDate3 = MoveDate(today, - 3 ).
     1909                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1910                                      string(vDate3  , "99/99/9999"),
     1911                                      string(vDate   , "99/99/9999")
     1912                                      ).
     1913                 vdateIso = iso-date(vdate3).
     1914                 find last code  where Code.parent      eq vparent
     1915                                   and Code.code        le vDateIso
     1916                                   and code.status_  eq 0 no-lock no-error.
     1917                 if available code
     1918                 then
     1919                    vDateIso = code.code.
     1920                 vDateFirst = vDateIso.
     1921                 vDateLast = iso-date(vdate).
     1922                 define variable vGood as logical no-undo.
     1923                 define variable vDateSale as date no-undo.
     1924                 define buffer bcode for code.
     1925                 for last code where Code.parent   eq vparent
     1926                                 and code.status_  eq 0
     1927                                 and code.code     < vDateLast
     1928                                 and code.code     >= vDateFirst
     1929                 no-lock:
     1930                    find first bcode where bCode.parent   eq vparent
     1931                                       and bcode.status_  eq 0
     1932                                       and bcode.code     > code.code no-lock no-error.
     1933                    if available bcode
     1934                    then do:
     1935                       if vPrice < dec(Code.CodeValue)
     1936                       then
     1937                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1938                                                     chr(10),
     1939                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1940                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1941                                                     ).
     1942                       else do:
     1943                          vGood = yes.
     1944                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1945                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1946                                                     chr(10),
     1947                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1948                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1949                                                     string(         vDateSale            ,"99/99/9999"),
     1950                                                     string(vDateSale - today)
     1951                                                     ).
     1952                       end.
     1953                    end.
     1954                 end.
     1955                 if vgood
     1956                 then do:
     1957                    define variable choice as integer no-undo .
     1958                    run gbl/d-askw.w (input "Уточнение"
     1959                           ,input  vText
     1960                           ,input "|"
     1961                           ,input "Принять|Вернуть"
     1962                           ,input "Принять данный товар|Вернуть товар постащику"
     1963                           ,input 1
     1964                           ,input 2
     1965                           ,output choice) no-error.
     1966                    vok = choice eq 1.
     1967                 end.
     1968                 else
     1969                    vok =false.
     1970             end.
     1971          end.
     1972      end.
     1973   end.
     1974   function addGs2Mark return character
     1975   (iMark as char):
     1976      define variable vDM   as character no-undo.
     1977      define variable vIdx  as integer   no-undo.
     1978      if index(iMark,chr(29),1) > 0
     1979      then return iMark.
     1980      if substring(iMark,26,4) = "8005" then
     1981      do:
     1982        vIdx = index(iMark,"93",26 + 4 + 5).
     1983        if vIdx > 1 then do:
     1984          vDM = substitute("&1&4&2&4&3",
     1985                           substring(iMark,1,25),
     1986                           substring(iMark,26,vIdx - 25 - 1),
     1987                           substring(iMark,vIdx),
     1988                           chr(29)) no-error.
     1989          vIdx = index(vDm,"240",vIdx + 4).
     1990          if vIdx > 0 then
     1991          do:
     1992            vDM = substitute("&1&3&2",
     1993                             substring(vDm,1,vIdx - 1),
     1994                             substring(vDm,vIdx),
     1995                             chr(29)) no-error.
     1996          end.
     1997        end.
     1998        else
     1999          vDM = substitute("&1&3&2",
     2000                           substring(iMark,1,25),
     2001                           substring(iMark,26),
     2002                           chr(29)) no-error.
     2003      end.
     2004      else if substring(iMark,32,2) = "91" then
     2005      do:
     2006        vIdx = index(iMark,"92",32).
     2007        if vIdx > 1 then
     2008          vDM = substitute("&1&4&2&4&3",
     2009                           substring(iMark,1,31),
     2010                           substring(iMark,32,vIdx - 31 - 1),
     2011                           substring(iMark,vIdx),
     2012                           chr(29)) no-error.
     2013        else
     2014          vDM = substitute("&1&3&2",
     2015                           substring(iMark,1,31),
     2016                           substring(iMark,32),
     2017                           chr(29)) no-error.
     2018      end.
     2019      else if substring(iMark,39,2) = "91" then
     2020      do:
     2021        vIdx = index(iMark,"92",38).
     2022        if vIdx > 1 then
     2023          vDM = substitute("&1&4&2&4&3",
     2024                           substring(iMark,1,38),
     2025                           substring(iMark,39,vIdx - 38 - 1),
     2026                           substring(iMark,vIdx),
     2027                           chr(29)) no-error.
     2028        else
     2029          vDM = substitute("&1&3&2",
     2030                           substring(iMark,1,38),
     2031                           substring(iMark,39),
     2032                           chr(29)) no-error.
     2033      end.
     2034      else if substring(iMark,25,2) = "93" then
     2035      do:
     2036        vIdx = index(iMark,"92",25).
     2037        if vIdx > 1 then
     2038          vDM = substitute("&1&4&2&4&3",
     2039                           substring(iMark,1,24),
     2040                           substring(iMark,25,vIdx - 24 - 1),
     2041                           substring(iMark,vIdx),
     2042                           chr(29)) no-error.
     2043        else
     2044          vIdx = index(iMark,"3103",25).
     2045          if vIdx > 0 then
     2046          vDM = substitute("&1&4&2&4&3",
     2047                           substring(iMark,1,24),
     2048                           substring(iMark,25,vIdx - 24 - 1),
     2049                           substring(iMark,vIdx),
     2050                           chr(29)) no-error.
     2051          else
     2052            vDM = substitute("&1&3&2",
     2053                             substring(iMark,1,24),
     2054                             substring(iMark,25),
     2055                             chr(29)) no-error.
     2056      end.
     2057      else if substring(iMark,32,2) = "93" then
     2058      do:
     2059        vDM = substitute("&1&3&2",
     2060              substring(iMark,1,31),
     2061              substring(iMark,32),
     2062              chr(29)) no-error.
     2063      end.
     2064      return if vDM <> "" then vDm else iMark.
     2065   end.
     2066   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2067   function func-get-name-from-ext-type   returns char
     2068     ( p-ext-type as character   ,
     2069       p-caps     as logical ).
     2070   define variable v-ext-name as character no-undo .
     2071   run get-name-from-ext-type in this-procedure (
     2072       input p-ext-type  ,
     2073       input p-caps  ,
     2074       output v-ext-name )
     2075       no-error .
     2076       if error-status :error then do:
     2077          assign
     2078            v-ext-name = p-ext-type
     2079          .
     2080       end.
     2081    return (v-ext-name) .
     2082   end.
     2083   procedure get-name-from-ext-type :
     2084    do
     2085    on error undo, return error return-value
     2086    :
     2087   define input  parameter p-ext-type as character no-undo .
     2088   define input  parameter p-caps     as logical no-undo   .
     2089   define output parameter p-ext-name as character no-undo .
     2090   define variable v-num as integer no-undo .
     2091     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     2092       message
     2093         vss-include-info7 skip
     2094         "Неправильно задано значение входящего параметра! "
     2095         "Нет такого типа документов " p-ext-type
     2096         view-as alert-box error .
     2097         undo, return error .
     2098     end.
     2099     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     2100     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     2101     if p-caps  = true then do :
     2102        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     2103     end .
     2104     end.
     2105   end procedure.
     2106   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2107     define variable v-cntxt-db-num        as integer   no-undo .
     2108     define variable v-cntxt-userid        as character no-undo .
     2109     define variable v-cntxt-level         as character no-undo .
     2110     define variable v-cntxt-host-code-obj as integer   no-undo .
     2111     define variable v-cntxt-obj-type      as character no-undo .
     2112     define variable v-cntxt-obj-code      as integer   no-undo .
     2113     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2114     define variable v-cntxt-is-admin      as logical   no-undo .
     2115   define temp-table tt-mark no-undo
     2116     field alcmark as character.
     2117   define input  parameter parparentproc         as handle              no-undo .
     2118   define input  parameter p-doc-code            as character           no-undo .
     2119   define input  parameter p-qnty                as integer             no-undo .
     2120   define input  parameter p-inv-handle          as handle              no-undo .
     2121   define variable iLang           as integer   no-undo.
     2122   define variable p-value-logical as logical no-undo.
     2123   define variable p-value-character  as character no-undo.
     2124   define variable p-value-date       as date no-undo.
     2125   define variable p-value-decimal    as decimal no-undo.
     2126   define variable p-value-integer    as integer no-undo.
     2127   define variable p-param-type       as character no-undo.
     2128   define variable v-tth as handle no-undo .
     2129   define variable v-alc-code      as character no-undo .
     2130   define variable v-proc-name-err as character no-undo initial 'impmark.txt'.
     2131   define variable l-error         as logical   no-undo.
     2132   define variable is-impfile      as logical   no-undo.
     2133   define variable v-user-action   as character no-undo.
     2134   define variable v-printed       as logical   no-undo.
     2135   define variable v-mark-short     as character no-undo.
     2136   define buffer t_doc        for ub.fbr-doc .
     2137   define buffer bf_fbr-doc   for ub.fbr-doc .
     2138   define buffer buf_marking  for ub.marking .
     2139   define buffer buf_marking-lines  for ub.marking-lines .
     2140   define buffer bf_fbr-line  for ub.fbr-line.
     2141   define buffer buf_recipe   for ub.recipe .
     2142   define buffer bf_bar-code  for ub.bar-code.
     2143   define variable v-timedelay  as integer   no-undo.
     2144   define variable v-scan-str as character no-undo.
     2145   define stream str-err .
     2146   define stream in-stream.
     2147   DEFINE BUTTON b-cancel
     2148        LABEL "&Отмена"
     2149        SIZE 10 BY 1
     2150        BGCOLOR 8 .
     2151   DEFINE BUTTON b-exit AUTO-GO
     2152        LABEL "&Ввод"
     2153        SIZE 10 BY 1
     2154        BGCOLOR 8 .
     2155   DEFINE BUTTON B_mark
     2156        LABEL "Все марки"
     2157        SIZE 15 BY 1.13.
     2158   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
     2159        VIEW-AS FILL-IN
     2160        SIZE 83 BY 1
     2161        FGCOLOR 12  NO-UNDO.
     2162   DEFINE VARIABLE qnty-mark AS INTEGER FORMAT ">>>>>>>9":U
     2163        LABEL "Кол-во марок"
     2164        VIEW-AS FILL-IN
     2165        SIZE 9 BY 1
     2166        FGCOLOR 9  NO-UNDO.
     2167   DEFINE VARIABLE qnty-scan AS INTEGER FORMAT ">>>>>>>9":U
     2168        LABEL "Кол-во просканированных"
     2169        VIEW-AS FILL-IN
     2170        SIZE 9 BY 1
     2171        FGCOLOR 10  NO-UNDO.
     2172   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     2173        LABEL "Марка"
     2174        VIEW-AS FILL-IN
     2175        SIZE 76 BY 1 NO-UNDO.
     2176   DEFINE FRAME Dialog-Frame
     2177        b-exit AT ROW 1 COL 1
     2178        b-cancel AT ROW 1 COL 11.5
     2179        B_mark AT ROW 1 COL 72.38 WIDGET-ID 80
     2180        v-mark AT ROW 3 COL 7.5 COLON-ALIGNED
     2181        f-msg AT ROW 4.38 COL 2.13 NO-LABEL WIDGET-ID 82
     2182        qnty-mark AT ROW 5.5 COL 40 COLON-ALIGNED WIDGET-ID 88
     2183        qnty-scan AT ROW 5.5 COL 74.5 COLON-ALIGNED WIDGET-ID 84
     2184        SPACE(1.87) SKIP(0.12)
     2185       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2186            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2187            TITLE "Сканирование марок"
     2188            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
     2189   ASSIGN
     2190          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2191          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2192   ON any-printable OF b-cancel IN FRAME Dialog-Frame
     2193   do:
     2194     run proc-any-key.
     2195   end.
     2196   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2197   DO:
     2198       run save_update .
     2199   END.
     2200   ON return OF b-exit IN FRAME Dialog-Frame
     2201   DO:
     2202       run save_update .
     2203   END.
     2204   ON any-printable OF B_mark IN FRAME Dialog-Frame
     2205   do:
     2206     run proc-any-key.
     2207   end.
     2208   ON CHOOSE OF B_mark IN FRAME Dialog-Frame
     2209   DO:
     2210     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     2211     define buffer buf_marking for ub.marking.
     2212     if available (t_doc) then do:
     2213         for each ub.marking-attr no-lock where
     2214               ub.marking-attr.attr-value = t_doc.doc-code
     2215           and (ub.marking-attr.attr-code = "fbr-doc" or ub.marking-attr.attr-code = "fbr-doc-scan"):
     2216         for each ub.marking-lines no-lock where
     2217           ub.marking-lines.obj-type = t_doc.obj-type
     2218           and ub.marking-lines.obj-code = t_doc.obj-code
     2219           and ub.marking-lines.out-code = 'free-zone':U
     2220           and ub.marking-lines.mark = ub.marking-attr.mark
     2221           :
     2222           find first ub.marking no-lock where ub.marking.mark = ub.marking-lines.mark and ub.marking.sts <> ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB no-error.
     2223           if available (ub.marking)
     2224             then
     2225           do:
     2226             create tt-marking-lines.
     2227             buffer-copy ub.marking-lines to tt-marking-lines.
     2228             tt-marking-lines.sts = ub.marking.sts.
     2229             tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking.sts).
     2230             tt-marking-lines.sts-utd = ub.marking-lines.sts.
     2231             tt-marking-lines.stts-utd = objSrv:Env:Marking:Sts:Mark:Checked_:Label_.
     2232             tt-marking-lines.box-qnty = ub.marking.box-qnty .
     2233             tt-marking-lines.unit = ub.marking.unit .
     2234             tt-marking-lines.unit-ext = ub.marking.unit-ext .
     2235             if ub.marking-attr.attr-code = "fbr-doc-scan"
     2236               then tt-marking-lines.doc-level = 1.
     2237               else tt-marking-lines.doc-level = 2.
     2238             tt-marking-lines.mark-parent = ub.marking.mark-parent.
     2239             tt-marking-lines.out-code = t_doc.doc-code.
     2240           end.
     2241         end.
     2242       end.
     2243       for each ub.utd no-lock where
     2244               ub.utd.doc-code = t_doc.doc-code
     2245           :
     2246         for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = ub.utd.db-num and buf_utd-marking-lines.doc-id = ub.utd.doc-id and buf_utd-marking-lines.mark <> "",
     2247           each buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark:
     2248           find first ub.goods where buf_marking.gds-code = ub.goods.gds-code.
     2249           create tt-marking-lines .
     2250           assign
     2251             tt-marking-lines.gds-name    = ub.goods.gds-name
     2252             tt-marking-lines.stts-utd    = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_utd-marking-lines.sts)
     2253             tt-marking-lines.stts        = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)
     2254             tt-marking-lines.mark        = buf_marking.mark
     2255             tt-marking-lines.mark-parent = buf_marking.mark-parent
     2256             tt-marking-lines.gds-code    = buf_utd-marking-lines.gds-code
     2257             tt-marking-lines.sts         = buf_marking.sts
     2258             tt-marking-lines.sts-utd     = buf_utd-marking-lines.sts
     2259             tt-marking-lines.unit        = buf_marking.unit
     2260             tt-marking-lines.unit-ext    = buf_marking.unit-ext
     2261             tt-marking-lines.box-qnty    = buf_marking.box-qnty
     2262             tt-marking-lines.LineNum     = buf_utd-marking-lines.LineNum
     2263             tt-marking-lines.db-num      = buf_utd-marking-lines.db-num
     2264             tt-marking-lines.doc-id      = buf_utd-marking-lines.doc-id
     2265             tt-marking-lines.doc-level   = buf_utd-marking-lines.doc-level
     2266             .
     2267         end.
     2268       end.
     2269       if available (tt-marking-lines) then
     2270       do:
     2271         run str/mark_browse.w (input parparentproc,
     2272           input-output table tt-marking-lines by-reference,
     2273           input 'ПРОСМОТР':U,
     2274           input "Марки по документу: " + t_doc.doc-code,
     2275           input "0",
     2276           input ""
     2277           )  .
     2278       end.
     2279       for each tt-marking-lines:
     2280         delete tt-marking-lines.
     2281       end.
     2282     end.
     2283   END.
     2284   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     2285   DO:
     2286       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     2287       run adm/shattri.p (
     2288                  input "get":U
     2289                  ,input  v-cntxt-obj-type
     2290                  ,input  v-cntxt-obj-code
     2291                  ,input  'marking':U
     2292                  ,input  'rus-key':U
     2293                  ,output p-value-character
     2294                  ,output p-value-date
     2295                  ,output p-value-decimal
     2296                  ,output p-value-integer
     2297                  ,output p-value-logical
     2298                  ,output p-param-type
     2299                  ,input-output table-handle v-tth
     2300                  ) no-error .
     2301       IF p-value-logical = yes THEN  iLang = 68748313.
     2302       run ActivateKeyboardLayout (input iLang, input 0).
     2303     END.
     2304   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     2305   DO:
     2306       assign frame Dialog-Frame v-mark .
     2307   END.
     2308   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     2309   DO:
     2310       run save_update .
     2311   END.
     2312   ON return OF v-mark IN FRAME Dialog-Frame
     2313   DO:
     2314       run save_update .
     2315   END.
     2316   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2317     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2318   MAIN-BLOCK:
     2319   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2320     :
     2321     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     2322         run adm/shattri.p (
     2323                  input "get":U
     2324                  ,input  v-cntxt-obj-type
     2325                  ,input  v-cntxt-obj-code
     2326                  ,input  'marking':U
     2327                  ,input  'rus-key':U
     2328                  ,output p-value-character
     2329                  ,output p-value-date
     2330                  ,output p-value-decimal
     2331                  ,output p-value-integer
     2332                  ,output p-value-logical
     2333                  ,output p-param-type
     2334                  ,input-output table-handle v-tth
     2335                  ) no-error .
     2336         IF p-value-logical = yes THEN  iLang = 68748313.
     2337     run ActivateKeyboardLayout (input iLang, input 0).
     2338     RUN enable_UI.
     2339     apply "entry" to v-mark in FRAME Dialog-Frame.
     2340     find first t_doc no-lock where t_doc.doc-code = p-doc-code no-error .
     2341     find first trn-doc exclusive-lock where trn-doc.doc-code = p-doc-code no-error .
     2342     hide b-cancel in frame Dialog-Frame.
     2343     qnty-mark = p-qnty .
     2344     enable v-mark with frame Dialog-Frame.
     2345     WAIT-FOR GO OF FRAME Dialog-Frame.
     2346   END.
     2347   RUN disable_UI.
     2348   PROCEDURE ActivateKeyboardLayout external "user32":
     2349   define input parameter P1 as LONG.
     2350      define input parameter P2 as LONG.
     2351   END PROCEDURE.
     2352   PROCEDURE CrCheckMark :
     2353   define variable v-error      as logical   no-undo init no.
     2354     define variable l-error      as logical   no-undo init no.
     2355     define variable v-error-lang as logical   no-undo init no.
     2356     define variable ii           as integer   no-undo .
     2357     define variable chg-qnty     as integer   no-undo .
     2358     assign
     2359       v-mark = v-mark:screen-value in frame Dialog-Frame.
     2360     if v-mark = ""
     2361       then return.
     2362     define variable vcodident as character no-undo.
     2363     v-mark-short = GetCodeIdent(v-mark).
     2364     if v-mark-short = "" or v-mark-short = ?
     2365     then do:
     2366       run dispmessage ("Марка не распознана.").
     2367       return.
     2368     end.
     2369     find first ub.marking-attr no-lock where (ub.marking-attr.attr-code = "fbr-doc" or ub.marking-attr.attr-code = "fbr-doc-scan") and (ub.marking-attr.mark begins v-mark-short) no-error.
     2370     if available (ub.marking-attr)
     2371     then do:
     2372       run dispmessage ("Марка находится в производстве - " + ub.marking-attr.attr-value).
     2373       return.
     2374     end.
     2375     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     2376     if not available (buf_marking)
     2377     then do:
     2378       run dispmessage ("Марка не найдена в системе.").
     2379       return.
     2380     end.
     2381     find first buf_marking-lines where (buf_marking-lines.mark begins v-mark-short)
     2382       and buf_marking-lines.out-code = 'free-zone':U no-error.
     2383     if buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     2384     then do:
     2385       run dispmessage ("Упаковка разгруппирована.").
     2386       return.
     2387     end.
     2388     if available (buf_marking-lines)
     2389     then do:
     2390       find first ub.goods no-lock where ub.goods.gds-code = buf_marking-lines.gds-code no-error.
     2391       find first bf_fbr-line no-lock where bf_fbr-line.doc-code = p-doc-code
     2392         and bf_fbr-line.artic = ub.goods.artic
     2393         and bf_fbr-line.prod-type = ub.goods.prod-type
     2394         and bf_fbr-line.prod-code = ub.goods.prod-code no-error.
     2395       if not available (bf_fbr-line)
     2396       then do:
     2397         run dispmessage (substitute ("Нет накладной линии с товаром &1 &2 к марке &3.", string (ub.goods.gds-code), ub.goods.gds-name, buf_marking-lines.mark)).
     2398         return.
     2399       end.
     2400       create ub.marking-attr.
     2401       ub.marking-attr.mark = buf_marking.mark.
     2402       ub.marking-attr.attr-code = "fbr-doc-scan".
     2403       ub.marking-attr.attr-value = p-doc-code.
     2404       def var rec as recid no-undo.
     2405       rec = recid (bf_fbr-line).
     2406       release bf_fbr-line.
     2407       ObjSrv:Lib:MarkingTree:UnGroupMark(buf_marking.mark).
     2408       if ObjSrv:Lib:MarkingTree:LevelDown(buf_marking.mark)
     2409       then do:
     2410         ObjSrv:Lib:MarkingTree:LockInvChildeMark(buf_marking.mark, p-doc-code).
     2411       end.
     2412       run go-line in p-inv-handle (input rec).
     2413       f-msg:screen-value in frame Dialog-Frame = v-mark-short .
     2414       f-msg:fgcolor in frame Dialog-Frame = 2.
     2415       qnty-scan = qnty-scan + buf_marking.box-qnty .
     2416     end.
     2417     else do:
     2418       run dispmessage ("Марка не числится на остатках. Статус марки - " + ObjSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)).
     2419     end.
     2420   end.
     2421   PROCEDURE disable_UI :
     2422     HIDE FRAME Dialog-Frame.
     2423   END PROCEDURE.
     2424   PROCEDURE dispmessage :
     2425   define input parameter p-str as character no-undo.
     2426     f-msg:fgcolor in frame Dialog-Frame = 12.
     2427     if is-impfile
     2428       then
     2429     do:
     2430       put stream str-err unformatted
     2431         p-str
     2432         skip.
     2433       l-error = yes .
     2434     end.
     2435     else
     2436     do:
     2437       display p-str @ f-msg with frame Dialog-Frame.
     2438     end.
     2439   END PROCEDURE.
     2440   PROCEDURE enable_UI :
     2441     DISPLAY v-mark f-msg qnty-mark qnty-scan
     2442         WITH FRAME Dialog-Frame.
     2443     ENABLE b-exit b-cancel B_mark v-mark
     2444         WITH FRAME Dialog-Frame.
     2445     VIEW FRAME Dialog-Frame.
     2446   END PROCEDURE.
     2447   PROCEDURE LoadKeyboardLayoutA external "user32":
     2448   define input  parameter P1 as char.
     2449      define input  parameter P2 as LONG.
     2450      define return parameter pret as LONG.
     2451   end procedure.
     2452   PROCEDURE proc-any-key :
     2453   if not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t_doc.obj-type, t_doc.obj-code):IsManual
     2454     then
     2455       if v-scan-str = ""
     2456         then v-timedelay = etime.
     2457         else
     2458           if etime - v-timedelay > 700
     2459             then v-scan-str = "".
     2460     v-scan-str = v-scan-str + last-event:label.
     2461   end.
     2462   PROCEDURE proc-choose-file :
     2463     if search (v-proc-name-err) <> ? then
     2464     do:
     2465       os-delete value(v-proc-name-err).
     2466     end.
     2467     DEFINE VARIABLE vCh AS CHARACTER NO-UNDO.
     2468     DEFINE VARIABLE vLg AS LOGICAL   NO-UNDO.
     2469     def    var      ii  as int.
     2470     SYSTEM-DIALOG GET-FILE vCh
     2471       MUST-EXIST
     2472       TITLE "Выбор файла"
     2473       USE-FILENAME UPDATE vLg.
     2474     IF vCh <> "" THEN
     2475     DO:
     2476       output stream str-err to value(v-proc-name-err)  APPEND .
     2477       input stream in-stream from value(search (vCh)).
     2478       rpt_:
     2479       REPEAT WITH FRAME Dialog-Frame:
     2480         import stream in-stream v-mark.
     2481         v-mark:screen-value = v-mark.
     2482         run save_update.
     2483       END.
     2484       INPUT CLOSE.
     2485       output stream str-err close.
     2486       message substitute ("Не все марки были загружены") view-as alert-box.
     2487       if l-error then
     2488       do:
     2489         if search (v-proc-name-err) <> ? then
     2490         do:
     2491           run gbl/prnfilen.w
     2492             (input  substitute ("Не все марки были загружены")
     2493             ,input  0
     2494             ,input  v-proc-name-err
     2495             ,input  7
     2496             ,output v-user-action
     2497             ,output v-printed
     2498             ).
     2499         end.
     2500       end.
     2501       else
     2502       do:
     2503         message substitute("Импорт акцизных марок завершен успешно.")
     2504           view-as alert-box.
     2505       end.
     2506     END.
     2507     else os-delete value(v-proc-name-err).
     2508   END PROCEDURE.
     2509   PROCEDURE save_update :
     2510   define variable v-error      as logical   no-undo init no.
     2511     define variable l-error      as logical   no-undo init no.
     2512     define variable v-error-lang as logical   no-undo init no.
     2513     define variable ii           as integer   no-undo .
     2514     define variable chg-qnty     as integer   no-undo .
     2515     do trans:
     2516       f-msg:screen-value in frame Dialog-Frame = "" .
     2517       if v-mark:screen-value in frame Dialog-Frame = ""
     2518       then do:
     2519         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     2520         v-scan-str = "".
     2521       end.
     2522       assign
     2523         v-mark = v-mark:screen-value in frame Dialog-Frame.
     2524       if v-mark = ""
     2525         then return.
     2526       run CrCheckMark.
     2527       v-mark = "".
     2528       v-mark:screen-value in frame Dialog-Frame = "".
     2529       v-mark-short = "".
     2530     end.
     2531   end procedure.
