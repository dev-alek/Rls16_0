      352         ,output v-type
      353         ,output v-format
      354         ,output v-fillin_width
      355         ,output v-fillin_height
      356         ,output v-label
      357         ,output v-user-can-edit
      358         ,output v-output-display
      359         ,output v-other
      360         ) no-error .
      361       if error-status :error then do:
      362         undo, return error return-value .
      363       end.
      364       find first buf_doc-line-attr no-lock
      365         where buf_doc-line-attr.doc-code  = p-doc-code
      366           and buf_doc-line-attr.gds-code = p-gds-code
      367           and buf_doc-line-attr.attr-code = p-code
      368         no-error .
