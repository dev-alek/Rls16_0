      571   procedure lineattr-write-add-line-cli :
      572   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      573   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      574   define input  parameter p-cli-type      as character no-undo .
      575   define input  parameter p-cli-code      as integer   no-undo .
      576   define input  parameter p-contract-code as integer   no-undo .
      577   define input  parameter p-host-code     as integer   no-undo .
      578   define input  parameter p-exch-code     as integer   no-undo .
      579   define input  parameter p-exch-rate     as decimal   no-undo .
      580   define input  parameter p-exch-scale    as integer   no-undo .
      581   define input  parameter p-sum-cli       as decimal   no-undo .
      582   define input  parameter p-sum-vat       as decimal   no-undo .
      583   define buffer buf_doc-line-attr for ub.doc-line-attr .
      584     do
      585     on error undo, return error return-value
      586     :
      587       find first buf_doc-line-attr exclusive-lock
      588         where buf_doc-line-attr.doc-code  = p-doc-code
      589           and buf_doc-line-attr.gds-code  = p-gds-code
      590           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      591                                             chr(4) + p-cli-type +
      592                                             chr(4) + string(p-cli-code) +
      593                                             chr(4) + string(p-contract-code) +
      594                                             chr(4) + string(p-host-code)
      595         no-error .
      596       if not available buf_doc-line-attr then do:
      597         create buf_doc-line-attr .
      598         assign
      599           buf_doc-line-attr.doc-code  = p-doc-code
      600           buf_doc-line-attr.gds-code  = p-gds-code
      601           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      602                                         chr(4) + p-cli-type +
      603                                         chr(4) + string(p-cli-code) +
      604                                         chr(4) + string(p-contract-code) +
      605                                         chr(4) + string(p-host-code)
      606         .
      607       end.
      608       assign
      609         buf_doc-line-attr.attr-value =
      610         string(p-exch-code)  + chr(4) +
      611         string(p-exch-rate)  + chr(4) +
      612         string(p-exch-scale) + chr(4) +
      613         string(p-sum-cli)    + chr(4) +
      614         string(p-sum-vat)
      615         .
      616     end.
      617   end procedure.
      618   procedure lineattr-value-add-line-cli :
      619   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      620   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      621   define input   parameter p-cli-type      as character no-undo .
      622   define input   parameter p-cli-code      as integer   no-undo .
      623   define input   parameter p-contract-code as integer   no-undo .
      624   define input   parameter p-host-code     as integer   no-undo .
      625   define output  parameter p-exch-code     as integer   no-undo .
      626   define output  parameter p-exch-rate     as decimal   no-undo .
      627   define output  parameter p-exch-scale    as integer   no-undo .
      628   define output  parameter p-sum-cli       as decimal   no-undo .
      629   define output  parameter p-sum-vat       as decimal   no-undo .
      630   define buffer buf_doc-line-attr for ub.doc-line-attr .
      631     do
      632     on error undo, return error return-value
      633     :
      634       find first buf_doc-line-attr exclusive-lock
      635         where buf_doc-line-attr.doc-code  = p-doc-code
      636           and buf_doc-line-attr.gds-code  = p-gds-code
      637           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      638                                             chr(4) + p-cli-type +
      639                                             chr(4) + string(p-cli-code) +
      640                                             chr(4) + string(p-contract-code) +
      641                                             chr(4) + string(p-host-code)
      642         no-error .
      643       if available buf_doc-line-attr then do:
      644        assign
      645           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      646           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      647           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      648           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      649           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      650          .
      651        end.
      652     end.
      653   end procedure.
      654   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      655     define variable v-code as character no-undo .
      656     define variable v-type as character no-undo .
      657     define variable v-gds-code as integer   no-undo .
      658   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      660     (input  local-doc-line.artic
      661     ,input  local-doc-line.prod-type
      662     ,input  local-doc-line.prod-code
      663     ,output v-gds-code
      664     )  .
      665     run lineattr-value (
      666         input   local-doc-line.doc-code ,
      667         input   v-gds-code              ,
      668         input   'reason-code':U ,
      669         output  v-code                  ,
      670         output  v-type ) .
      671     find first ub.trn-reason no-lock where
      672                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      673     if not available ub.trn-reason then do:
      674        return "" .
      675     end.
      676     else do:
      677        return ub.trn-reason.reason-name .
      678     end.
      679   end function.
      680   procedure lineattr-value-parts :
      681     do
      682     on error undo, return error return-value
      683     :
      684       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      685       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      686       define input  parameter p-part-code   as character no-undo .
      687       define input  parameter p_in-code     as character no-undo .
      688       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      689       define output parameter p-value       as    decimal   no-undo .
      690       define buffer buf_doc-line-attr for ub.doc-line-attr .
      691       find first buf_doc-line-attr no-lock
      692         where buf_doc-line-attr.doc-code  = p-doc-code
      693           and buf_doc-line-attr.gds-code  = p-gds-code
      694           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      695         no-error .
      696       if avail buf_doc-line-attr then do:
      697         assign
      698           p-value = decimal( buf_doc-line-attr.attr-value)
      699         .
      700       end.
      701       else do:
      702         assign
      703           p-value = 0
      704         .
      705       end.
      706     end.
      707   end procedure.
      708   procedure lineattr-write-parts :
      709     do
      710     on error undo, return error return-value
      711     :
      712       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      713       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      714       define input parameter p-part-code  as character no-undo .
      715       define input parameter p_in-code    as character no-undo .
      716       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      717       define input parameter p-value      as decimal   no-undo .
      718       define buffer buf_doc-line-attr for ub.doc-line-attr .
      719       find first buf_doc-line-attr exclusive-lock
      720         where buf_doc-line-attr.doc-code  = p-doc-code
      721           and buf_doc-line-attr.gds-code  = p-gds-code
      722           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      723         no-error .
      724       if not available buf_doc-line-attr then do:
      725         create buf_doc-line-attr .
      726         assign
      727           buf_doc-line-attr.doc-code  = p-doc-code
      728           buf_doc-line-attr.gds-code  = p-gds-code
      729           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      730         .
      731       end.
      732       assign
      733         buf_doc-line-attr.attr-value = string( p-value )
      734       .
      735     end.
      736   end procedure.
