     4834         MESSAGE "Ошибка при пересчете части в рублях." SKIP
     4835                 RETURN-VALUE
     4836         VIEW-AS ALERT-BOX ERROR.
     4837         ASSIGN
     4838           varsum-cli   = varmemsum-cli
     4839           varprice-cli = varmem-price-cli.
     4840       END.
     4841     END.
