     6003             vat-pc-loc         = (if varvat-pc         = ? then 0 else varvat-pc)
     6004             slt-pc-loc         = (if varslt-pc         = ? then 0 else varslt-pc).
     6005             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6006       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6007     assign
     6008       exch-rate-cli-loc = (varprice-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if varvat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if varslt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / varprice-cli .
     6009     assign
     6010       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6011       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6012       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6013       transport-cli-loc  = 0
     6014       other-cli-loc      = 0
     6015     .
     6016   ASSIGN
     6017             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6018       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6019   .
     6020     assign
     6021       varprice-rubl-slt = slt-rubl-loc
     6022       varprice-base-slt = slt-base-loc
     6023       varsum-rubl-slt   = varprice-rubl-slt * varfact-qnty
     6024       varsum-base-slt   = varprice-base-slt * varfact-qnty
     6025       varprice-rubl-vat = vat-rubl-loc
     6026       varprice-base-vat = vat-base-loc
     6027       varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     6028       varsum-base-vat   = varprice-base-vat * varfact-qnty.
     6029     display varprice-base           varsum-base
     6030             varprice-base-vat       varsum-base-vat varprice-rubl-vat varsum-rubl-vat
     6031             varprice-base-slt       varsum-base-slt varprice-rubl-slt varsum-rubl-slt
     6032             varprice-base-road-tax  when paris-road-tax varsum-base-road-tax when paris-road-tax
     6033             varprice-base-transport varsum-base-transport
     6034             varprice-base-other     varsum-base-other
     6035     with frame Dialog-Frame.
     6036   END PROCEDURE.
     6037   PROCEDURE proc-calc-baseeqcli :
     6038   assign
     6039       varprice-base           = (varprice-cli + varprice-cli-road-tax + (if varvat-type <> 'в т. ч.':U then varprice-cli-vat else 0) + (if varslt-type <> 'в т. ч.':U then varprice-cli-slt else 0)) / varcli-base-rate + varprice-base-transport + varprice-base-other
     6040       varsum-base             = varprice-base           * varfact-qnty
     6041       varprice-base-road-tax  = varprice-cli-road-tax   * varcli-base-rate
     6042       varsum-base-road-tax    = varprice-base-road-tax  * varfact-qnty
