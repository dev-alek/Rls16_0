     4027       varmem-slt-pc         = varslt-pc
     4028      .
     4029     assign frame Dialog-Frame
     4030       varprice-base-slt.
     4031     assign
     4032       varsum-base-slt   = varprice-base-slt * varfact-qnty
     4033       varprice-rubl-slt = varprice-base-slt * varbase-rate / varbase-scale
     4034       varsum-rubl-slt   = varprice-rubl-slt * varfact-qnty
     4035       varprice-cli-slt  = varprice-rubl-slt / varexch-rate * varexch-scale * varcli-base-rate
     4036       varsum-cli-slt    = varprice-rubl-slt / varexch-rate * varexch-scale * varfact-qnty
     4037       varslt-pc         = (varprice-base-slt / (varprice-base - varprice-base-other - varprice-base-transport - varprice-base-road-tax - varprice-base-slt)) * 100
     4038     .
     4039     run chg-slt-pc in this-procedure no-error.
     4040     if error-status:error then do:
     4041       message "Ошибка при изменении процента НП." skip
     4042               return-value skip
     4043               error-status:get-message(1)
     4044       view-as alert-box.
     4045       assign
     4046        varprice-rubl-slt = varmem-price-rubl-slt
     4047        varsum-rubl-slt   = varmem-sum-rubl-slt
     4048        varprice-base-slt = varmem-price-base-slt
     4049        varsum-base-slt   = varmem-sum-base-slt
     4050        varprice-cli-slt  = varmem-price-cli-slt
     4051        varsum-cli-slt    = varmem-sum-cli-slt
     4052        varslt-pc         = varmem-slt-pc
     4053        .
     4054       display varprice-rubl-slt varsum-rubl-slt varprice-base-slt varsum-base-slt varprice-cli-slt varsum-cli-slt varslt-pc with frame Dialog-Frame.
     4055     end.
     4056     display varslt-pc with frame Dialog-Frame.
     4057   end.
     4058   END.
