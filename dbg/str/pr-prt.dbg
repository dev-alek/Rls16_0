     3893   END.
     3894   ON LEAVE OF varprice-base IN FRAME Dialog-Frame
     3895   DO:
     3896   if input frame Dialog-Frame varprice-base <> varprice-base then do:
     3897     assign
     3898       frame Dialog-Frame varprice-base.
     3899     assign varsum-base = varprice-base / varfact-qnty.
     3900     display varsum-base with frame Dialog-Frame.
     3901   end.
     3902   END.
     3903   ON return OF varprice-base IN FRAME Dialog-Frame
     3904   DO:
     3905     return no-apply.
     3906   END.
     3907   ON ENTRY OF varprice-base-other IN FRAME Dialog-Frame
     3908   DO:
     3909     run rate-correct (output varrate-correct) no-error.                             if error-status:error then do:                               message "Ошибка при вызове процедуры rate-correct." skip                                       return-value                                       error-status:get-message(1)                                       error-status:get-message(2)                               view-as alert-box error.                               return no-apply.                             end.                             if varrate-correct = no then do:                               message "Курс в партии не согласован с рублевой и валютной ценой." skip                                       "Рублевая цена: "         varprice-rubl skip                                       "Цена в базовой валюте: " varprice-base skip                                       "Курс базовой валюты: "   varbase-rate  skip                                       "Шкала базовой валюты: "  varbase-scale                                    view-as alert-box information.                               if b-calc-rate:sensitive then do:                                 apply "entry" to b-calc-rate.                              end.                               else do:                                 if b-calc-exch-rate:sensitive then do:                                   apply "entry" to b-calc-exch-rate.                                 end.                                 else do:                                   apply "entry" to varprice-cli.                                end.                               end.                               return no-apply.                             end.
     3910     run rate-exch-correct (output varrate-exch-correct) no-error.                                  if error-status:error then do:                                    message "Ошибка при вызове процедуры rate-exch-correct." skip                                            return-value                                            error-status:get-message(1)                                            error-status:get-message(2)                                    view-as alert-box error.                                    return no-apply.                                  end.                                  if varrate-exch-correct = no then do:                                    message "Курс в партии не согласован с рублевой и ценой в валюте поставщика (договора)." skip                                            "Рублевая цена: "            varprice-rubl    skip                                            "Цена в валюте поставщика: " varprice-cli     skip                                            "Единица поставщика: "       varcli-base-rate skip                                            "Курс валюты поставщика: "   varexch-rate     skip                                            "Шкала валюты поставщика: "  varexch-scale                                    view-as alert-box information.                                    if b-calc-exch-rate:sensitive then do:                                      apply "entry" to b-calc-exch-rate.                                   end.                                    else do:                                      apply "entry" to varprice-cli.                                    end.                                    return no-apply.                                  end.
     3911   END.
     3912   ON LEAVE OF varprice-base-other IN FRAME Dialog-Frame
     3913   DO:
     3914   define variable varmem-price-rubl-other like varprice-rubl-other no-undo.
     3915   define variable varmem-sum-rubl-other   like varsum-rubl-other   no-undo.
     3916   define variable varmem-price-base-other like varprice-base-other no-undo.
     3917   define variable varmem-sum-base-other   like varsum-base-other   no-undo.
     3918   if input frame Dialog-Frame varprice-base-other <> varprice-base-other then do:
     3919     assign
     3920       varmem-price-rubl-other = varprice-rubl-other
     3921       varmem-sum-rubl-other   = varsum-rubl-other
     3922       varmem-price-base-other = varprice-base-other
     3923       varmem-sum-base-other   = varsum-base-other
     3924     .
     3925     assign frame Dialog-Frame varprice-base-other.
     3926     assign
     3927       varprice-rubl-other = varprice-base-other * varbase-rate / varbase-scale
     3928       varsum-rubl-other   = varprice-rubl-other * varfact-qnty
     3929       varsum-base-other   = varprice-base-other * varfact-qnty
     3930       .
     3931     run chg-abs in this-procedure no-error.
     3932     if error-status:error then do:
     3933       message "Ошибка при установке абсолютных налогов."  skip
     3934               return-value skip
     3935               error-status:get-message(1) skip
     3936               error-status:get-message(2)
     3937       view-as alert-box error.
     3938       assign
     3939         varprice-rubl-other = varmem-price-rubl-other
     3940         varsum-rubl-other   = varmem-sum-rubl-other
     3941         varprice-base-other = varmem-price-base-other
     3942         varsum-base-other   = varmem-sum-base-other
     3943       .
     3944     end.
     3945   end.
     3946   display varprice-rubl-other varsum-rubl-other varprice-base-other varsum-base-other with frame Dialog-Frame.
     3947   END.
