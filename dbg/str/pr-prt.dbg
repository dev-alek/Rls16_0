     6439     .
     6440   assign
     6441     price-rubl-with-tax-loc = varprice-rubl
     6442     price-base-with-tax-loc = varprice-base
     6443   .
     6444   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6446     (output varinvprb
     6447     )  .
     6448     if varout-code = 'free-zone':U     or
     6449        varout-code = 'out-zone':U   or
     6450        vardoc-type = 'акт':U then do:
     6451       assign
     6452         in-vatp-have-vat-slt = yes.
     6453     end.
     6454     else do:
     6455       find first in-vatp_doc-attr no-lock
     6456         where in-vatp_doc-attr.doc-code  = varout-code
     6457           and in-vatp_doc-attr.attr-code = 'envd':U
     6458         no-error .
     6459       if not available in-vatp_doc-attr then do:
     6460         assign
     6461           in-vatp-have-vat-slt = yes.
     6462       end.
     6463       else do:
     6464            in-vatp-have-vat-slt = no.
     6465       end.
     6466     end.
     6467     assign
     6468      price-cli-with-tax-loc = varprice-cli
     6469      cli-base-rate          = varcli-base-rate.
     6470     ASSIGN   road-tax-base-loc  = (if varroad-tax-base  = ? then 0 else varroad-tax-base)
     6471              road-tax-rubl-loc  = (if varroad-tax-rubl  = ? then 0 else varroad-tax-rubl).
     6472     ASSIGN  transport-base-loc = (if vartransport-base = ? then 0 else vartransport-base)
     6473             transport-rubl-loc = (if vartransport-rubl = ? then 0 else vartransport-rubl)
     6474             other-base-loc     = (if varother-base     = ? then 0 else varother-base)
     6475             other-rubl-loc     = (if varother-rubl     = ? then 0 else varother-rubl)
     6476             vat-pc-loc         = (if varvat-pc         = ? then 0 else varvat-pc)
     6477             slt-pc-loc         = (if varslt-pc         = ? then 0 else varslt-pc).
     6478             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6479       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6480     assign
     6481       exch-rate-cli-loc = (varprice-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if varvat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if varslt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / varprice-cli .
     6482     assign
     6483       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6484       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6485       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6486       transport-cli-loc  = 0
     6487       other-cli-loc      = 0
     6488     .
     6489   ASSIGN
     6490             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6491       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6492   .
     6493     assign
     6494       varprice-rubl-slt = slt-rubl-loc
     6495       varprice-base-slt = slt-base-loc
     6496       varsum-rubl-slt   = varprice-rubl-slt * varfact-qnty
     6497       varsum-base-slt   = varprice-base-slt * varfact-qnty
     6498       varprice-rubl-vat = vat-rubl-loc
     6499       varprice-base-vat = vat-base-loc
     6500       varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     6501       varsum-base-vat   = varprice-base-vat * varfact-qnty.
     6502     display varprice-rubl           varsum-rubl
     6503             varprice-base-vat       varsum-base-vat varprice-rubl-vat varsum-rubl-vat
     6504             varprice-base-slt       varsum-base-slt varprice-rubl-slt varsum-rubl-slt
     6505             varprice-rubl-road-tax  when paris-road-tax varsum-rubl-road-tax when paris-road-tax
     6506             varprice-rubl-transport varsum-rubl-transport
     6507             varprice-rubl-other     varsum-rubl-other
     6508     with frame Dialog-Frame.
     6509   END PROCEDURE.
     6510   PROCEDURE proc-calc-rubl-cli :
     6511   assign
     6512       varprice-rubl           = (varprice-cli + varprice-cli-road-tax + (if varvat-type <> 'в т. ч.':U then varprice-cli-vat else 0) + (if varslt-type <> 'в т. ч.':U then varprice-cli-slt else 0)) / varcli-base-rate * varexch-rate / varexch-scale + varprice-rubl-transport + varprice-rubl-other
     6513       varsum-rubl             = varprice-rubl           * varfact-qnty
     6514       varprice-rubl-road-tax  = varprice-cli-road-tax / varcli-base-rate * varexch-rate / varexch-scale
     6515       varsum-rubl-road-tax    = varprice-rubl-road-tax  * varfact-qnty
     6516     .
     6517     assign
     6518       varroad-tax-rubl  = varprice-rubl-road-tax
     6519       vartransport-rubl = varprice-rubl-transport
     6520       varother-rubl     = varprice-rubl-other
     6521       varroad-tax-base  = varprice-base-road-tax
     6522       vartransport-base = varprice-base-transport
     6523       varother-base     = varprice-base-other
     6524       varroad-tax-cli   = varprice-cli-road-tax
     6525   .
     6526   assign
     6527     price-rubl-with-tax-loc = varprice-rubl
     6528     price-base-with-tax-loc = varprice-base
     6529   .
     6530   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6532     (output varinvprb
     6533     )  .
     6534     if varout-code = 'free-zone':U     or
     6535        varout-code = 'out-zone':U   or
     6536        vardoc-type = 'акт':U then do:
     6537       assign
     6538         in-vatp-have-vat-slt = yes.
     6539     end.
     6540     else do:
     6541       find first in-vatp_doc-attr no-lock
     6542         where in-vatp_doc-attr.doc-code  = varout-code
     6543           and in-vatp_doc-attr.attr-code = 'envd':U
     6544         no-error .
     6545       if not available in-vatp_doc-attr then do:
     6546         assign
     6547           in-vatp-have-vat-slt = yes.
     6548       end.
     6549       else do:
     6550            in-vatp-have-vat-slt = no.
     6551       end.
     6552     end.
     6553     assign
     6554      price-cli-with-tax-loc = varprice-cli
     6555      cli-base-rate          = varcli-base-rate.
     6556     ASSIGN   road-tax-base-loc  = (if varroad-tax-base  = ? then 0 else varroad-tax-base)
     6557              road-tax-rubl-loc  = (if varroad-tax-rubl  = ? then 0 else varroad-tax-rubl).
     6558     ASSIGN  transport-base-loc = (if vartransport-base = ? then 0 else vartransport-base)
     6559             transport-rubl-loc = (if vartransport-rubl = ? then 0 else vartransport-rubl)
     6560             other-base-loc     = (if varother-base     = ? then 0 else varother-base)
     6561             other-rubl-loc     = (if varother-rubl     = ? then 0 else varother-rubl)
     6562             vat-pc-loc         = (if varvat-pc         = ? then 0 else varvat-pc)
     6563             slt-pc-loc         = (if varslt-pc         = ? then 0 else varslt-pc).
     6564             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6565       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6566     assign
     6567       exch-rate-cli-loc = (varprice-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if varvat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if varslt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / varprice-cli .
     6568     assign
     6569       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6570       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6571       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6572       transport-cli-loc  = 0
     6573       other-cli-loc      = 0
     6574     .
     6575   ASSIGN
     6576             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6577       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6578   .
     6579     assign
     6580       varprice-rubl-slt = slt-rubl-loc
     6581       varprice-base-slt = slt-base-loc
     6582       varprice-cli-slt  = slt-cli-loc
     6583       varsum-rubl-slt   = varprice-rubl-slt * varfact-qnty
     6584       varsum-base-slt   = varprice-base-slt * varfact-qnty
     6585       varsum-cli-slt    = varprice-cli-slt  * varfact-qnty / varcli-base-rate
     6586       varprice-rubl-vat = vat-rubl-loc
     6587       varprice-base-vat = vat-base-loc
     6588       varprice-cli-vat  = vat-cli-loc
     6589       varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     6590       varsum-base-vat   = varprice-base-vat * varfact-qnty
     6591       varsum-cli-vat    = varprice-cli-vat  * varfact-qnty / varcli-base-rate.
     6592     display varprice-rubl           varsum-rubl
     6593             varprice-base-vat       varsum-base-vat
     6594             varprice-rubl-vat       varsum-rubl-vat
     6595             varprice-cli-vat        varsum-cli-vat
     6596             varprice-base-slt       varsum-base-slt
     6597             varprice-rubl-slt       varsum-rubl-slt
     6598             varprice-cli-slt        varsum-cli-slt
     6599             varprice-rubl-road-tax  when paris-road-tax
     6600             varsum-rubl-road-tax    when paris-road-tax
     6601             varprice-rubl-transport varsum-rubl-transport
     6602             varprice-rubl-other     varsum-rubl-other
     6603     with frame Dialog-Frame.
     6604   END PROCEDURE.
     6605   PROCEDURE rate-correct :
     6606   define output parameter parrate-correct as logical no-undo.
     6607   if varprice-rubl  = varprice-base * varbase-rate / varbase-scale or
     6608      varprice-base = varprice-rubl / varbase-rate * varbase-scale or
     6609      varbase-rate = varprice-rubl / varprice-base *  varbase-scale then do:
     6610      assign parrate-correct = true.
     6611   end.
     6612   else do:
     6613     assign parrate-correct = false.
     6614   end.
     6615   END PROCEDURE.
     6616   PROCEDURE rate-exch-correct :
     6617   define output parameter parrate-exch-correct as logical no-undo.
     6618   if (varprice-rubl - varprice-rubl-road-tax - varprice-rubl-transport - varprice-rubl-other - (if varvat-type <> 'в т. ч.':U then varprice-rubl-vat else 0) - (if varslt-type <> 'в т. ч.':U then varprice-rubl-slt else 0)) = varprice-cli / varcli-base-rate * varexch-rate / varexch-scale         or
     6619      (varprice-cli / varcli-base-rate)  = (varprice-rubl - varprice-rubl-road-tax - varprice-rubl-transport - varprice-rubl-other - (if varvat-type <> 'в т. ч.':U then varprice-rubl-vat else 0) - (if varslt-type <> 'в т. ч.':U then varprice-rubl-slt else 0)) / varexch-rate * varexch-scale      or
     6620      (varexch-rate / varexch-scale)     = (varprice-rubl - varprice-rubl-road-tax - varprice-rubl-transport - varprice-rubl-other - (if varvat-type <> 'в т. ч.':U then varprice-rubl-vat else 0) - (if varslt-type <> 'в т. ч.':U then varprice-rubl-slt else 0)) / (varprice-cli / varcli-base-rate) then do:
     6621      assign parrate-exch-correct = true.
     6622   end.
     6623   else do:
     6624     assign parrate-exch-correct = false.
     6625   end.
     6626   END PROCEDURE.
     6627   PROCEDURE start-state :
     6628   define buffer bf-supp_parts   for ub.parts.
     6629   define buffer bf-supp_clients for ub.clients.
     6630   define variable varhost-code        like ub.clients.obj-code no-undo.
     6631   define variable varhave-parts       as   logical             no-undo.
     6632   define variable varno-recalc-vat-pc like ub.parts.vat-pc     no-undo.
     6633   define variable varno-recalc-slt-pc like ub.parts.slt-pc     no-undo.
     6634   define variable varcount            as   integer             no-undo.
     6635   do on error undo, return error return-value :
     6636   assign
     6637     varno-recalc-vat-pc = ?
     6638     varno-recalc-slt-pc = ?.
     6639   find first bf_goods where bf_goods.gds-code = pargds-code no-lock no-error.
     6640   if not available bf_goods then do:
     6641     return error substitute ("Не найден товар с внутренним кодом &1.", pargds-code).
     6642   end.
     6643   assign
     6644     varartic     = bf_goods.artic
     6645     varprod-type = bf_goods.prod-type
     6646     varprod-code = bf_goods.prod-code
     6647     vargds-name  = bf_goods.gds-name.
     6648   find first bf-cur-obj_clients where bf-cur-obj_clients.obj-type = parobj-type and
     6649                                       bf-cur-obj_clients.obj-code = parobj-code no-lock no-error.
     6650   if not available bf-cur-obj_clients then do:
     6651     return error substitute ("Не найден объект &1 &2.", parobj-type, parobj-code).
     6652   end.
     6653   if bf-cur-obj_clients.obj-type <> 'маг':U  and
     6654      bf-cur-obj_clients.obj-type <> 'скл':U then do:
     6655     return error substitute ("Объект &1 &2 не является складом или магазином.", bf-cur-obj_clients.obj-type, bf-cur-obj_clients.obj-code).
     6656   end.
     6657   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6659     (input  bf-cur-obj_clients.obj-type
     6660     ,input  bf-cur-obj_clients.obj-code
     6661     ,output varhost-code
     6662     )  .
     6663   assign
     6664     varobj-type = bf-cur-obj_clients.obj-type
     6665     varobj-code = bf-cur-obj_clients.obj-code
     6666     varobj-name = bf-cur-obj_clients.obj-name.
     6667   find first bf-supp_clients where bf-supp_clients.obj-type = parcli-type and
     6668                                    bf-supp_clients.obj-code = parcli-code no-lock no-error.
     6669   if not available bf-supp_clients then do:
     6670     return error substitute ("Не найден контрагент &1 &2.", parcli-type, parcli-code).
     6671   end.
     6672   assign
     6673     varsupp-type = bf-supp_clients.obj-type
     6674     varsupp-code = bf-supp_clients.obj-code
     6675     varsupp-name = bf-supp_clients.obj-name.
     6676   if parmode = "part":u then do:
     6677     find first bf_parts where bf_parts.obj-type  = varobj-type  and
     6678                               bf_parts.obj-code  = varobj-code  and
     6679                               bf_parts.artic     = varartic     and
     6680                               bf_parts.prod-type = varprod-type and
     6681                               bf_parts.prod-code = varprod-code and
     6682                               bf_parts.in-code   = parin-code   and
     6683                               bf_parts.out-code  = parout-code  and
     6684                               bf_parts.part-code = parpart-code no-lock no-error.
     6685     if not available bf_parts then do:
     6686       return error substitute ("Не найдена партия. Объект &1 &2. Товар &3 &4 &5. Порожд. накл. &6. Накл. &7. Код партии &8.",
     6687                                varobj-type,
     6688                                varobj-code,
     6689                                varartic,
     6690                                varprod-type,
     6691                                varprod-code,
     6692                                parin-code,
     6693                                parout-code,
     6694                                parpart-code).
     6695     end.
     6696     assign
     6697       varin-code   = parin-code
     6698       varpart-code = parpart-code
     6699       varfact-qnty = bf_parts.fact-qnty.
     6700     find first bf_parts-attr where bf_parts-attr.in-code   = varin-code        and
     6701                                    bf_parts-attr.gds-code  = bf_goods.gds-code and
     6702                                    bf_parts-attr.part-code = varpart-code      no-lock no-error.
     6703     if available bf_parts-attr then do:
     6704       assign
     6705         varincome-in-code = bf_parts-attr.income-in-code.
     6706     end.
     6707     else do:
     6708       assign
     6709         varincome-in-code = varin-code.
     6710     end.
     6711   end.
     6712   assign
     6713     varcur-base-rate  = parbase-rate
     6714     varcur-base-scale = parbase-scale.
     6715   assign
     6716     varcur-exch-rate  = parexch-rate
     6717     varcur-exch-scale = parexch-scale.
     6718   if parmode = "goods":u or parmode = "parts":u then do:
     6719     assign
     6720       varfact-qnty  = 0
     6721       varhave-parts = no.
     6722     for each tt-clcparts on error undo, return error return-value :
     6723       delete tt-clcparts.
     6724     end.
     6725     assign
     6726       varcount = 1.
     6727     for each tt-chs-parts on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) :
     6728       if varcount = 1 then do:
     6729         assign
     6730           varno-recalc-vat-pc = tt-chs-parts.vat-pc
     6731           varno-recalc-slt-pc = tt-chs-parts.slt-pc.
     6732       end.
     6733       else do:
     6734         if tt-chs-parts.vat-pc <> varno-recalc-vat-pc then do:
     6735           assign
     6736             varno-recalc-vat-pc = ?.
     6737         end.
     6738         if tt-chs-parts.slt-pc <> varno-recalc-slt-pc then do:
     6739           assign
     6740             varno-recalc-slt-pc = ?.
     6741         end.
     6742       end.
     6743       create tt-clcparts.
     6744       buffer-copy tt-chs-parts to tt-clcparts.
     6745       assign varhave-parts = yes.
     6746     end.
     6747     if varhave-parts = no then do:
     6748       return error substitute ("В свободной зоне нет партий по товару с внутренним кодом &1 от поставщика &2 &3.",
     6749                                pargds-code,
     6750                                parcli-type,
     6751                                parcli-code).
     6752     end.
     6753     find first tt-clcparts no-error.
     6754     if available tt-clcparts then do:
     6755       run clcprtsl_calc-ttable in this-procedure (
     6756                                                 input no,
     6757                                                 input no,
     6758                                                 input 0,
     6759                                                 input 0 ,
     6760                                                 input 0,
     6761                                                 input 0,
     6762                                                 input 0,
     6763                                                 input 0,
     6764                                                 input 0,
     6765                                                 input ?,
     6766                                                 input 0,
     6767                                                 input 0,
     6768                                                 input 0,
     6769                                                 input 0,
     6770                                                 input 0,
     6771                                                 input 0 ) no-error.
     6772       if error-status:error then do:
     6773         return error substitute ("Ошибка <&1> при обсчете свободной зоны по товару.", return-value).
     6774       end.
     6775     end.
     6776     else do:
     6777       return error substitute ("По товару &1 &2 &3 нет свободной зоны от данного поставщика на объекте &4 &5. Изменять нечего.",
     6778                                varartic,
     6779                                varprod-type,
     6780                                varprod-code,
     6781                                varobj-type,
     6782                                varobj-code).
     6783     end.
     6784     FIND FIRST tt-chs-parts.
     6785     FIND FIRST tt-chs-parts-another WHERE tt-chs-parts-another.purch-code <> tt-chs-parts.purch-code NO-ERROR.
     6786     IF AVAILABLE tt-chs-parts-another THEN DO:
     6787       ASSIGN
     6788         varold-purch-code-name = "разные".
     6789     END.
     6790     ELSE DO:
     6791           ASSIGN
     6792         varold-purch-code-name = entry (lookup (string(tt-chs-parts.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     6793     END.
     6794   end.
     6795   else do:
     6796     for each tt-clcparts on error undo, return error return-value :
     6797       delete tt-clcparts.
     6798     end.
     6799     create tt-clcparts.
     6800     buffer-copy bf_parts to tt-clcparts.
     6801     assign
     6802       varno-recalc-vat-pc = tt-clcparts.vat-pc
     6803       varno-recalc-slt-pc = tt-clcparts.slt-pc.
     6804     run clcprtsl_calc-parts in this-procedure (
     6805      input recid(tt-clcparts),
     6806      input no,
     6807      input no,
     6808      input 0,
     6809      input 0,
     6810      input 0,
     6811      input 0,
     6812      input 0,
     6813      input 0,
     6814      input 0,
     6815      input ?,
     6816      input 0,
     6817      input 0,
     6818      input 0,
     6819      input 0,
     6820      input 0,
     6821      input 0) no-error.
     6822     if error-status:error then do:
     6823       return error substitute ("Ошибка <&1> при обсчете партии по товару.", return-value).
     6824     end.
     6825     for each tt-allsum-line on error undo, return error return-value :
     6826       delete tt-allsum-line.
     6827     end.
     6828     for each tt-allsum on error undo, return error return-value :
     6829       create tt-allsum-line.
     6830       buffer-copy tt-allsum to tt-allsum-line.
     6831     end.
     6832       ASSIGN
     6833       varold-purch-code-name = entry (lookup (string(bf_parts.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     6834   end.
     6835   find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = 'основная_сумма':U no-error.
     6836   if error-status:error then do:
     6837     return error substitute ("Не найдена запись по типу &1 для товара &2 &3 &4.", 'основная_сумма':U, varartic, varprod-type, varprod-code).
     6838   end.
     6839   assign
     6840      varfact-qnty                = bf_tt-allsum-line.fact-qnty
     6841      varcli-base-rate            = parcli-base-rate
     6842      varvat-type                 = parvat-type
     6843      varslt-type                 = parslt-type
     6844      varold-sum-base             = bf_tt-allsum-line.sum-dsc-base-acc
     6845      varold-price-base           = bf_tt-allsum-line.sum-dsc-base-acc / varfact-qnty
     6846      varold-sum-rubl             = bf_tt-allsum-line.sum-dsc-rubl-acc
     6847      varold-price-rubl           = bf_tt-allsum-line.sum-dsc-rubl-acc / varfact-qnty
     6848      varold-sum-cli              = bf_tt-allsum-line.sum-dsc-cli-acc
     6849      varold-price-cli            = (bf_tt-allsum-line.sum-dsc-cli-acc - bf_tt-allsum-line.road-tax-cli-acc - (if varvat-type <> 'в т. ч.':U then bf_tt-allsum-line.vat-cli-acc else 0) - (if varslt-type <> 'в т. ч.':U then bf_tt-allsum-line.slt-cli-acc else 0)) / varfact-qnty * varcli-base-rate
     6850      varold-base-rate            = (if varold-price-rubl / varold-price-base = ? then 1 else varold-price-rubl / varold-price-base)
     6851      varsum-base                 = varold-sum-base
     6852      varprice-base               = varold-price-base
     6853      varsum-rubl                 = varold-sum-rubl
     6854      varprice-rubl               = varold-price-rubl
     6855      varsum-cli                  = varold-sum-cli
     6856      varprice-cli                = varold-price-cli
     6857      varbase-rate                = varold-base-rate
     6858      varbase-scale               = 1
     6859      varold-sum-base-slt         = bf_tt-allsum-line.slt-base-acc
     6860      varold-price-base-slt       = bf_tt-allsum-line.slt-base-acc / varfact-qnty
     6861      varold-sum-rubl-slt         = bf_tt-allsum-line.slt-rubl-acc
     6862      varold-price-rubl-slt       = bf_tt-allsum-line.slt-rubl-acc / varfact-qnty
     6863      varold-sum-cli-slt          = bf_tt-allsum-line.slt-cli-acc
     6864      varold-price-cli-slt        = bf_tt-allsum-line.slt-cli-acc / varfact-qnty * varcli-base-rate
     6865      varold-slt-pc               = (if varno-recalc-slt-pc <> ? then varno-recalc-slt-pc else (varold-sum-rubl-slt / (varold-sum-rubl - varold-sum-rubl-slt) * 100))
     6866      varsum-base-slt             = varold-sum-base-slt
     6867      varprice-base-slt           = varold-price-base-slt
     6868      varsum-rubl-slt             = varold-sum-rubl-slt
     6869      varprice-rubl-slt           = varold-price-rubl-slt
     6870      varsum-cli-slt              = varold-sum-cli-slt
     6871      varprice-cli-slt            = varold-price-cli-slt
     6872      varslt-pc                   = varold-slt-pc
     6873      varold-sum-base-vat         = bf_tt-allsum-line.vat-base-acc
     6874      varold-price-base-vat       = bf_tt-allsum-line.vat-base-acc / varfact-qnty
     6875      varold-sum-rubl-vat         = bf_tt-allsum-line.vat-rubl-acc
     6876      varold-price-rubl-vat       = bf_tt-allsum-line.vat-rubl-acc / varfact-qnty
     6877      varold-sum-cli-vat          = bf_tt-allsum-line.vat-cli-acc
     6878      varold-price-cli-vat        = bf_tt-allsum-line.vat-cli-acc / varfact-qnty * varcli-base-rate
     6879      varold-vat-pc               = (if varno-recalc-vat-pc <> ? then varno-recalc-vat-pc else (varold-sum-rubl-vat / (varold-sum-rubl - varold-sum-rubl-slt - varold-sum-rubl-vat) * 100))
     6880      varsum-base-vat             = varold-sum-base-vat
     6881      varprice-base-vat           = varold-price-base-vat
     6882      varsum-rubl-vat             = varold-sum-rubl-vat
     6883      varprice-rubl-vat           = varold-price-rubl-vat
     6884      varsum-cli-vat              = varold-sum-cli-vat
     6885      varprice-cli-vat            = varold-price-cli-vat
     6886      varvat-pc                   = varold-vat-pc
     6887      varold-sum-base-road-tax    = bf_tt-allsum-line.road-tax-base-acc
     6888      varold-price-base-road-tax  = bf_tt-allsum-line.road-tax-base-acc / varfact-qnty
     6889      varold-sum-rubl-road-tax    = bf_tt-allsum-line.road-tax-rubl-acc
     6890      varold-price-rubl-road-tax  = bf_tt-allsum-line.road-tax-rubl-acc / varfact-qnty
     6891      varold-sum-cli-road-tax     = bf_tt-allsum-line.road-tax-cli-acc
     6892      varold-price-cli-road-tax   = bf_tt-allsum-line.road-tax-cli-acc / varfact-qnty * varcli-base-rate
     6893      varsum-base-road-tax        = varold-sum-base-road-tax
     6894      varprice-base-road-tax      = varold-price-base-road-tax
     6895      varsum-rubl-road-tax        = varold-sum-rubl-road-tax
     6896      varprice-rubl-road-tax      = varold-price-rubl-road-tax
     6897      varsum-cli-road-tax         = varold-sum-cli-road-tax
     6898      varprice-cli-road-tax       = varold-price-cli-road-tax
     6899      varold-sum-base-transport   = bf_tt-allsum-line.transport-base-acc
     6900      varold-price-base-transport = bf_tt-allsum-line.transport-base-acc / varfact-qnty
     6901      varold-sum-rubl-transport   = bf_tt-allsum-line.transport-rubl-acc
     6902      varold-price-rubl-transport = bf_tt-allsum-line.transport-rubl-acc / varfact-qnty
     6903      varsum-base-transport       = varold-sum-base-transport
     6904      varprice-base-transport     = varold-price-base-transport
     6905      varsum-rubl-transport       = varold-sum-rubl-transport
     6906      varprice-rubl-transport     = varold-price-rubl-transport
     6907      varold-sum-base-other       = bf_tt-allsum-line.other-base-acc
     6908      varold-price-base-other     = bf_tt-allsum-line.other-base-acc / varfact-qnty
     6909      varold-sum-rubl-other       = bf_tt-allsum-line.other-rubl-acc
     6910      varold-price-rubl-other     = bf_tt-allsum-line.other-rubl-acc / varfact-qnty
     6911      varsum-base-other           = varold-sum-base-other
     6912      varprice-base-other         = varold-price-base-other
     6913      varsum-rubl-other           = varold-sum-rubl-other
     6914      varprice-rubl-other         = varold-price-rubl-other
     6915      varold-exch-rate            = (if (varold-sum-rubl - varold-sum-rubl-transport - varold-sum-rubl-other - varold-sum-rubl-road-tax) / varold-sum-cli = ? then 1 else (varold-sum-rubl - varold-sum-rubl-transport - varold-sum-rubl-other - varold-sum-rubl-road-tax) / varold-sum-cli)
     6916      varexch-rate                = varold-exch-rate
     6917      varexch-scale               = 1
     6918     .
     6919   end.
     6920   end procedure.
     6921   PROCEDURE state-cur-exch-rate :
     6922   do on error undo, return error return-value:
     6923    assign
     6924      varexch-rate  = varcur-exch-rate
     6925      varexch-scale = varcur-exch-scale.
     6926    display varexch-rate varexch-scale with frame Dialog-Frame.
     6927   end.
     6928   END PROCEDURE.
     6929   PROCEDURE state-cur-rate :
     6930   do on error undo, return error return-value:
     6931    assign
     6932      varbase-rate  = varcur-base-rate
     6933      varbase-scale = varcur-base-scale.
     6934    display varbase-rate varbase-scale with frame Dialog-Frame.
     6935   end.
     6936   END PROCEDURE.
