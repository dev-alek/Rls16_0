     3600   ASSIGN
     3601          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3602          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3603   ON return OF FRAME Dialog-Frame
     3604   DO:
     3605     return no-apply.
     3606   END.
     3607   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3608   DO:
     3609     APPLY "END-ERROR":U TO SELF.
     3610   END.
     3611   ON CHOOSE OF b-calc-base-t-rubl IN FRAME Dialog-Frame
     3612   DO:
     3613     run proc-calc-base-rubl in THIS-PROCEDURE NO-ERROR.
     3614     IF ERROR-STATUS:ERROR THEN DO:
     3615       MESSAGE "Ошибка при пересчете значений в базовой валюте." SKIP
     3616               RETURN-VALUE SKIP
     3617               ERROR-STATUS:GET-MESSAGE(1) SKIP
     3618       VIEW-AS ALERT-BOX ERROR.
     3619       RETURN NO-APPLY.
     3620     END.
     3621   END.
     3622   ON CHOOSE OF b-calc-cli-t-rubl IN FRAME Dialog-Frame
     3623   DO:
     3624     run proc-calc-cli-rubl in THIS-PROCEDURE NO-ERROR.
     3625     IF ERROR-STATUS:ERROR THEN DO:
     3626        MESSAGE "Ошибка при пересчете значений в валюте клиента." SKIP
     3627                RETURN-VALUE SKIP
     3628                ERROR-STATUS:GET-MESSAGE(1) SKIP
     3629        VIEW-AS ALERT-BOX ERROR.
     3630        RETURN NO-APPLY.
     3631      END.
     3632   END.
     3633   ON CHOOSE OF b-calc-exch-rate IN FRAME Dialog-Frame
     3634   DO:
     3635     run proc-calc-exch-rate in this-procedure no-error.
     3636     if error-status:error then do:
     3637       message "Ошибка при пересчете курса валюты поставщика." skip
     3638               return-value skip
     3639               error-status:get-message(1)
     3640       view-as alert-box error.
     3641       return no-apply.
     3642     end.
     3643   END.
     3644   ON CHOOSE OF b-calc-rate IN FRAME Dialog-Frame
     3645   DO:
     3646     run proc-calc-rate in THIS-PROCEDURE NO-ERROR.
     3647     IF ERROR-STATUS:ERROR THEN DO:
     3648       MESSAGE "Ошибка при расчете по новому курсу базовой валюты." SKIP
     3649               RETURN-VALUE SKIP
     3650               ERROR-STATUS:GET-MESSAGE(1) SKIP
     3651               ERROR-STATUS:GET-MESSAGE(2)
     3652       VIEW-AS ALERT-BOX ERROR.
     3653       RETURN NO-APPLY.
     3654     END.
     3655   END.
     3656   ON CHOOSE OF b-calc-rubl-t-base IN FRAME Dialog-Frame
     3657   DO:
     3658     run proc-calc-rubl-base in THIS-PROCEDURE NO-ERROR.
     3659     IF ERROR-STATUS:ERROR THEN DO:
     3660       MESSAGE "Ошибка при пересчете значений в рублях." SKIP
     3661               RETURN-VALUE SKIP
     3662               ERROR-STATUS:GET-MESSAGE(1) SKIP
     3663       VIEW-AS ALERT-BOX ERROR.
     3664       RETURN NO-APPLY.
     3665     END.
     3666   if varexcheqrubl then do:
     3667     run proc-calc-cli-rubl in THIS-PROCEDURE NO-ERROR.
     3668     IF ERROR-STATUS:ERROR THEN DO:
     3669        MESSAGE "Ошибка при пересчете значений в валюте." SKIP
     3670                RETURN-VALUE SKIP
     3671                ERROR-STATUS:GET-MESSAGE(1) SKIP
     3672        VIEW-AS ALERT-BOX ERROR.
     3673        RETURN NO-APPLY.
     3674     END.
     3675   END.
     3676   END.
     3677   ON CHOOSE OF b-calc-rubl-t-cli IN FRAME Dialog-Frame
     3678   DO:
     3679   run proc-calc-rubl-cli in THIS-PROCEDURE NO-ERROR.
     3680   IF ERROR-STATUS:ERROR THEN DO:
     3681      MESSAGE "Ошибка при пересчете значений в рублях." SKIP
     3682              RETURN-VALUE SKIP
     3683              ERROR-STATUS:GET-MESSAGE(1) SKIP
     3684      VIEW-AS ALERT-BOX ERROR.
     3685      RETURN NO-APPLY.
     3686   END.
     3687   if varbaseeqrubl then do:
     3688     run proc-calc-base-rubl in THIS-PROCEDURE NO-ERROR.
     3689     IF ERROR-STATUS:ERROR THEN DO:
     3690        MESSAGE "Ошибка при пересчете значений в валюте." SKIP
     3691                RETURN-VALUE SKIP
     3692                ERROR-STATUS:GET-MESSAGE(1) SKIP
     3693        VIEW-AS ALERT-BOX ERROR.
     3694        RETURN NO-APPLY.
     3695     END.
     3696   end.
     3697   END.
     3698   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     3699   DO:
     3700     assign
     3701       paris-ok = false.
     3702     apply "go" to frame Dialog-Frame.
     3703   END.
     3704   ON CHOOSE OF b-cur-exch-rate IN FRAME Dialog-Frame
     3705   DO:
     3706     run state-cur-exch-rate in this-procedure no-error.
     3707     if error-status:error then do:
     3708       message "Ошибка при установке текущего курса." skip
     3709               return-value skip
     3710               error-status:get-message(1) skip
     3711               error-status:get-message(2)
     3712        view-as alert-box.
     3713     end.
     3714   END.
     3715   ON CHOOSE OF b-cur-rate IN FRAME Dialog-Frame
     3716   DO:
     3717     run state-cur-rate in this-procedure no-error.
     3718     if error-status:error then do:
     3719       message "Ошибка при установке текущего курса." skip
     3720               return-value skip
     3721               error-status:get-message(1) skip
     3722               error-status:get-message(2)
     3723        view-as alert-box.
     3724     end.
     3725   END.
     3726   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     3727   DO:
     3728     run rate-correct (output varrate-correct) no-error.                             if error-status:error then do:                               message "Ошибка при вызове процедуры rate-correct." skip                                       return-value                                       error-status:get-message(1)                                       error-status:get-message(2)                               view-as alert-box error.                               return no-apply.                             end.                             if varrate-correct = no then do:                               message "Курс в партии не согласован с рублевой и валютной ценой." skip                                       "Рублевая цена: "         varprice-rubl skip                                       "Цена в базовой валюте: " varprice-base skip                                       "Курс базовой валюты: "   varbase-rate  skip                                       "Шкала базовой валюты: "  varbase-scale                                    view-as alert-box information.                               if b-calc-rate:sensitive then do:                                 apply "entry" to b-calc-rate.                              end.                               else do:                                 if b-calc-exch-rate:sensitive then do:                                   apply "entry" to b-calc-exch-rate.                                 end.                                 else do:                                   apply "entry" to varprice-cli.                                end.                               end.                               return no-apply.                             end.
     3729     run rate-exch-correct (output varrate-exch-correct) no-error.                                  if error-status:error then do:                                    message "Ошибка при вызове процедуры rate-exch-correct." skip                                            return-value                                            error-status:get-message(1)                                            error-status:get-message(2)                                    view-as alert-box error.                                    return no-apply.                                  end.                                  if varrate-exch-correct = no then do:                                    message "Курс в партии не согласован с рублевой и ценой в валюте поставщика (договора)." skip                                            "Рублевая цена: "            varprice-rubl    skip                                            "Цена в валюте поставщика: " varprice-cli     skip                                            "Единица поставщика: "       varcli-base-rate skip                                            "Курс валюты поставщика: "   varexch-rate     skip                                            "Шкала валюты поставщика: "  varexch-scale                                    view-as alert-box information.                                    if b-calc-exch-rate:sensitive then do:                                      apply "entry" to b-calc-exch-rate.                                   end.                                    else do:                                      apply "entry" to varprice-cli.                                    end.                                    return no-apply.                                  end.
     3730     if round(varbase-rate           , 4) <> input frame Dialog-Frame varbase-rate             then apply "leave" to varbase-rate            in frame Dialog-Frame.
     3731     if       varbase-scale               <> input frame Dialog-Frame varbase-scale            then apply "leave" to varbase-scale           in frame Dialog-Frame.
     3732     if varprice-base           <> input frame Dialog-Frame varprice-base            then apply "leave" to varprice-base           in frame Dialog-Frame.
     3733     if varsum-base             <> input frame Dialog-Frame varsum-base              then apply "leave" to varsum-base             in frame Dialog-Frame.
     3734     if varprice-rubl           <> input frame Dialog-Frame varprice-rubl            then apply "leave" to varprice-rubl           in frame Dialog-Frame.
     3735     if varsum-rubl             <> input frame Dialog-Frame varsum-rubl              then apply "leave" to varsum-rubl             in frame Dialog-Frame.
     3736     if varprice-cli            <> input frame Dialog-Frame varprice-cli             then apply "leave" to varprice-cli            in frame Dialog-Frame.
     3737     if varsum-cli              <> input frame Dialog-Frame varsum-cli               then apply "leave" to varsum-cli              in frame Dialog-Frame.
     3738     if round (varvat-pc, 2)    <> input frame Dialog-Frame varvat-pc                then apply "leave" to varvat-pc               in frame Dialog-Frame.
     3739     if varprice-base-vat       <> input frame Dialog-Frame varprice-base-vat        then apply "leave" to varprice-base-vat       in frame Dialog-Frame.
     3740     if varsum-base-vat         <> input frame Dialog-Frame varsum-base-vat          then apply "leave" to varsum-base-vat         in frame Dialog-Frame.
     3741     if varprice-rubl-vat       <> input frame Dialog-Frame varprice-rubl-vat        then apply "leave" to varprice-rubl-vat       in frame Dialog-Frame.
     3742     if varsum-rubl-vat         <> input frame Dialog-Frame varsum-rubl-vat          then apply "leave" to varsum-rubl-vat         in frame Dialog-Frame.
     3743     if varprice-cli-vat        <> input frame Dialog-Frame varprice-cli-vat         then apply "leave" to varprice-cli-vat        in frame Dialog-Frame.
     3744     if varsum-cli-vat          <> input frame Dialog-Frame varsum-cli-vat           then apply "leave" to varsum-cli-vat          in frame Dialog-Frame.
     3745     if round(varslt-pc, 2)     <> input frame Dialog-Frame varslt-pc                then apply "leave" to varslt-pc               in frame Dialog-Frame.
     3746     if varprice-base-slt       <> input frame Dialog-Frame varprice-base-slt        then apply "leave" to varprice-base-slt       in frame Dialog-Frame.
     3747     if varsum-base-slt         <> input frame Dialog-Frame varsum-base-slt          then apply "leave" to varsum-base-slt         in frame Dialog-Frame.
     3748     if varprice-rubl-slt       <> input frame Dialog-Frame varprice-rubl-slt        then apply "leave" to varprice-rubl-slt       in frame Dialog-Frame.
     3749     if varsum-rubl-slt         <> input frame Dialog-Frame varsum-rubl-slt          then apply "leave" to varsum-rubl-slt         in frame Dialog-Frame.
     3750     if varprice-cli-slt        <> input frame Dialog-Frame varprice-cli-slt         then apply "leave" to varprice-cli-slt        in frame Dialog-Frame.
     3751     if varsum-cli-slt          <> input frame Dialog-Frame varsum-cli-slt           then apply "leave" to varsum-cli-slt          in frame Dialog-Frame.
     3752     if varprice-base-road-tax  <> input frame Dialog-Frame varprice-base-road-tax   then apply "leave" to varprice-base-road-tax  in frame Dialog-Frame.
     3753     if varsum-base-road-tax    <> input frame Dialog-Frame varsum-base-road-tax     then apply "leave" to varsum-base-road-tax    in frame Dialog-Frame.
     3754     if varprice-rubl-road-tax  <> input frame Dialog-Frame varprice-rubl-road-tax   then apply "leave" to varprice-rubl-road-tax  in frame Dialog-Frame.
     3755     if varsum-rubl-road-tax    <> input frame Dialog-Frame varsum-rubl-road-tax     then apply "leave" to varsum-rubl-road-tax    in frame Dialog-Frame.
     3756     if varprice-cli-road-tax   <> input frame Dialog-Frame varprice-cli-road-tax    then apply "leave" to varprice-cli-road-tax   in frame Dialog-Frame.
     3757     if varsum-cli-road-tax     <> input frame Dialog-Frame varsum-cli-road-tax      then apply "leave" to varsum-cli-road-tax     in frame Dialog-Frame.
     3758     if varprice-base-transport <> input frame Dialog-Frame varprice-base-transport  then apply "leave" to varprice-base-transport in frame Dialog-Frame.
     3759     if varsum-base-transport   <> input frame Dialog-Frame varsum-base-transport    then apply "leave" to varsum-base-transport   in frame Dialog-Frame.
     3760     if varprice-rubl-transport <> input frame Dialog-Frame varprice-rubl-transport  then apply "leave" to varprice-rubl-transport in frame Dialog-Frame.
     3761     if varsum-rubl-transport   <> input frame Dialog-Frame varsum-rubl-transport    then apply "leave" to varsum-rubl-transport   in frame Dialog-Frame.
     3762     if varprice-base-other     <> input frame Dialog-Frame varprice-base-other      then apply "leave" to varprice-base-other     in frame Dialog-Frame.
     3763     if varsum-base-other       <> input frame Dialog-Frame varsum-base-other        then apply "leave" to varsum-base-other       in frame Dialog-Frame.
     3764     if varprice-rubl-other     <> input frame Dialog-Frame varprice-rubl-other      then apply "leave" to varprice-rubl-other     in frame Dialog-Frame.
     3765     if varsum-rubl-other       <> input frame Dialog-Frame varsum-rubl-other        then apply "leave" to varsum-rubl-other       in frame Dialog-Frame.
     3766     IF varpurch-code-name      <> INPUT FRAME Dialog-Frame varpurch-code-name       THEN APPLY "leave" TO varpurch-code-name      IN FRAME Dialog-Frame.
     3767     if varbase-rate            < 0                      or varbase-rate         = ?  then do: message "Неверный курс базовой валюты: "                                                varbase-rate            view-as alert-box. apply "entry" to varbase-rate            in frame Dialog-Frame. return no-apply. end.
     3768     if varbase-scale           < 0                      or varbase-scale        = ?  then do: message "Неверная шкала курса базовой валюты: "                                         varbase-scale           view-as alert-box. apply "entry" to varbase-scale           in frame Dialog-Frame. return no-apply. end.
     3769     if varprice-base           < 0                      or varprice-base        = ?  then do: message "Неверная цена в базовой валюте: "                                              varprice-base           view-as alert-box. apply "entry" to varprice-base           in frame Dialog-Frame. return no-apply. end.
     3770     if varsum-base             < 0                      or varsum-base          = ?  then do: message "Неверная сумма в базовой валюте: "                                             varsum-base             view-as alert-box. apply "entry" to varsum-base             in frame Dialog-Frame. return no-apply. end.
     3771     if varprice-rubl           < 0                      or varprice-rubl        = ?  then do: message "Неверная цена в рублях "                                                       varprice-rubl           view-as alert-box. apply "entry" to varprice-rubl           in frame Dialog-Frame. return no-apply. end.
     3772     if varsum-rubl             < 0                      or varsum-rubl          = ?  then do: message "Неверная сумма в рублях: "                                                     varsum-rubl             view-as alert-box. apply "entry" to varsum-rubl             in frame Dialog-Frame. return no-apply. end.
     3773     if varprice-cli            < 0                      or varprice-cli         = ?  then do: message "Неверная цена в валюте поставщика "                                            varprice-cli            view-as alert-box. apply "entry" to varprice-cli            in frame Dialog-Frame. return no-apply. end.
     3774     if varsum-cli              < 0                      or varsum-cli           = ?  then do: message "Неверная сумма в валюте поставщика: "                                          varsum-cli              view-as alert-box. apply "entry" to varsum-cli              in frame Dialog-Frame. return no-apply. end.
     3775     if varvat-pc               < 0 or varvat-pc > 100.0 or varvat-pc            = ?  then do: message "Неверный процент НДС: "                                                        varvat-pc               view-as alert-box. apply "entry" to varvat-pc               in frame Dialog-Frame. return no-apply. end.
     3776     if varprice-base-vat       < 0                      or varprice-base-vat    = ?  then do: message "Неверная ценовая компонента НДС в базовой валюте: "                            varprice-base-vat       view-as alert-box. apply "entry" to varprice-base-vat       in frame Dialog-Frame. return no-apply. end.
     3777     if varsum-base-vat         < 0                      or varsum-base-vat      = ?  then do: message "Неверная сумма НДС в базовой валюте: "                                         varsum-base-vat         view-as alert-box. apply "entry" to varsum-base-vat         in frame Dialog-Frame. return no-apply. end.
     3778     if varprice-rubl-vat       < 0                      or varprice-rubl-vat    = ?  then do: message "Неверная ценовая компонента НДС в рублях: "                                    varprice-rubl-vat       view-as alert-box. apply "entry" to varprice-rubl-vat       in frame Dialog-Frame. return no-apply. end.
     3779     if varsum-rubl-vat         < 0                      or varsum-rubl-vat      = ?  then do: message "Неверная сумма НДС в рублях: "                                                 varsum-rubl-vat         view-as alert-box. apply "entry" to varsum-rubl-vat         in frame Dialog-Frame. return no-apply. end.
     3780     if varprice-cli-vat        < 0                      or varprice-cli-vat     = ?  then do: message "Неверная ценовая компонента НДС в валюте поставщика: "                         varprice-cli-vat        view-as alert-box. apply "entry" to varprice-cli-vat        in frame Dialog-Frame. return no-apply. end.
     3781     if varsum-cli-vat          < 0                      or varsum-cli-vat       = ?  then do: message "Неверная сумма НДС в валюте поставщика: "                                      varsum-cli-vat          view-as alert-box. apply "entry" to varsum-cli-vat          in frame Dialog-Frame. return no-apply. end.
     3782     if varslt-pc               < 0 or varslt-pc > 100.0 or varslt-pc            = ?  then do: message "Неверный процент НП: "                                                         varslt-pc               view-as alert-box. apply "entry" to varslt-pc               in frame Dialog-Frame. return no-apply. end.
     3783     if varprice-base-slt       < 0                      or varprice-base-slt    = ?  then do: message "Неверная ценовая компонента НП в базовой валюте: "                             varprice-base-slt       view-as alert-box. apply "entry" to varprice-base-slt       in frame Dialog-Frame. return no-apply. end.
     3784     if varsum-base-slt         < 0                      or varsum-base-slt      = ?  then do: message "Неверная сумма НП в базовой валюте: "                                          varsum-base-slt         view-as alert-box. apply "entry" to varsum-base-slt         in frame Dialog-Frame. return no-apply. end.
     3785     if varprice-rubl-slt       < 0                      or varprice-rubl-slt    = ?  then do: message "Неверная ценовая компонента НП в рублях: "                                     varprice-rubl-slt       view-as alert-box. apply "entry" to varprice-rubl-slt       in frame Dialog-Frame. return no-apply. end.
