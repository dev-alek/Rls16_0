       59   define variable vss-revision    as character no-undo init "$Revision$":U .
       60   define variable vss-author      as character no-undo init "$Author$":U .
       61   define variable vss-date        as character no-undo init "$Date$":U .
       62   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       63   define variable vss-archive     as character no-undo init "$Archive$":U .
       64   define variable vss-description as character no-undo init "Общий экран изменения цен".
       65   procedure vss-get-info :
       66     define output parameter p-vss-revision    like vss-revision    no-undo .
       67     define output parameter p-vss-author      like vss-author      no-undo .
       68     define output parameter p-vss-date        like vss-date        no-undo .
       69     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       70     define output parameter p-vss-archive     like vss-archive     no-undo .
       71     define output parameter p-vss-description like vss-description no-undo .
       72     assign
       73       p-vss-revision    = vss-revision
       74       p-vss-author      = vss-author
       75       p-vss-date        = vss-date
       76       p-vss-workfile    = vss-workfile
       77       p-vss-archive     = vss-archive
       78       p-vss-description = vss-description
       79     .
       80   end procedure.
       81   procedure vss-get-parameters :
       82     define output parameter p-vss-parameters as character no-undo .
       83   end procedure.
       84   define new global shared variable g#vssrevis-logger as handle    no-undo .
       85   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       86   define variable v-vssrevis-logger                   as handle    no-undo .
       87   procedure vss-logevent :
       88     define input  parameter p-extra-paramters as character no-undo .
       89     define variable v-vssrevis-parameters as character no-undo .
       90     do
       91     on error undo, return error return-value
       92     :
       93       if  valid-handle(v-vssrevis-logger)
       94       and v-vssrevis-logger :get-signature("logevent") <> ""
       95       then do:
       96         run vss-get-parameters in this-procedure
       97           (output v-vssrevis-parameters
       98           ).
       99         run logevent in v-vssrevis-logger
      100           (input vss-workfile
      101           ,input vss-revision
      102           ,input v-vssrevis-parameters
      103           ,input p-extra-paramters
      104           ).
      105       end.
      106     end.
      107   end procedure.
      108   assign
      109     v-vssrevis-logger = g#vssrevis-logger
      110   .
      111   if  valid-handle(v-vssrevis-logger)
      112   and v-vssrevis-logger :get-signature("logevent") <> ""
      113   then do:
      114     assign
      115       v-vssrevis-logevent = true
      116     .
      117     run vss-logevent in this-procedure (input vss-description) .
      118   end.
      119   define new global shared variable g#language as character no-undo .
      120   if g#language <> '' and g#language <> 'rus':U then do:
      121     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      122   end.
      123   procedure proc-alt-shift-f2:
      124     if not ibs.th.gbl.gbl-var:rcode
      125   then
      126     run gbl\inidebug.p .
      127   end.
      128   procedure proc-alt-shift-f3:
      129     run gbl/prvssinf.p
      130       ( input this-procedure
      131       ) .
      132   end.
      133   define variable v-inform-launched as logical no-undo initial false .
      134   procedure proc-alt-shift-f4:
      135     define variable v-action as character no-undo .
      136     if v-inform-launched = false then do:
      137       assign
      138         v-inform-launched = true
      139       .
      140       run gbl/d-inform.w
      141         (  input self
      142         ,  input this-procedure
      143         , output v-action
      144         ) no-error .
      145       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      146       assign
      147         v-inform-launched = false
      148       .
      149     end.
      150   end.
      151   procedure proc-alt-f1:
      152     run gbl/corrhelp.p
      153       (input this-procedure
      154       ) .
      155   end .
      156   on alt-shift-f2 anywhere do:
      157     run proc-alt-shift-f2.
      158   end.
      159   on alt-shift-f3 anywhere do:
      160     run proc-alt-shift-f3 in this-procedure .
      161   end.
      162   on alt-shift-f4 anywhere do:
      163     run proc-alt-shift-f4 in this-procedure.
      164   end.
      165   on alt-f1 anywhere do:
      166     run proc-alt-f1 in this-procedure .
      167   end.
