      845     varslt-rubl-docovpcl      = 0
      846     varvat-rubl-docovpcl      = 0
      847     varvatcons-rubl-docovpcl  = 0
      848     vardsc-rubl-docovpcl      = 0.
      849   assign
      850     varis-one-gds-dtlcl = no.
