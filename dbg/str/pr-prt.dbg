     5222   DO:
     5223   if input frame Dialog-Frame varsum-rubl-vat <> varsum-rubl-vat then do:
     5224     if (input frame Dialog-Frame varsum-rubl-vat / (varsum-rubl - varsum-rubl-other - varsum-rubl-transport - varsum-rubl-road-tax - varsum-rubl-slt - varsum-rubl-vat)) * 100 < 0   or
     5225        (input frame Dialog-Frame varsum-rubl-vat / (varsum-rubl - varsum-rubl-other - varsum-rubl-transport - varsum-rubl-road-tax - varsum-rubl-slt - varsum-rubl-vat)) * 100 > 100 then do:
     5226        message "При такой сумовой компоненте НДС получится неверный процент НДС: " (input frame Dialog-Frame varsum-rubl-vat / (varsum-rubl - varsum-rubl-other - varsum-rubl-transport - varsum-rubl-road-tax - varsum-rubl-slt - varsum-rubl-vat)) * 100 < 0 " ."
     5227        view-as alert-box.
     5228        return no-apply.
     5229     end.
     5230     run calc-sum-rubl-vat in this-procedure.
     5231   end.
     5232   END.
     5233   ON return OF varsum-rubl-vat IN FRAME Dialog-Frame
     5234   DO:
     5235     return no-apply.
     5236   END.
     5237   ON ENTRY OF varvat-pc IN FRAME Dialog-Frame
     5238   DO:
     5239     run rate-correct (output varrate-correct) no-error.                             if error-status:error then do:                               message "Ошибка при вызове процедуры rate-correct." skip                                       return-value                                       error-status:get-message(1)                                       error-status:get-message(2)                               view-as alert-box error.                               return no-apply.                             end.                             if varrate-correct = no then do:                               message "Курс в партии не согласован с рублевой и валютной ценой." skip                                       "Рублевая цена: "         varprice-rubl skip                                       "Цена в базовой валюте: " varprice-base skip                                       "Курс базовой валюты: "   varbase-rate  skip                                       "Шкала базовой валюты: "  varbase-scale                                    view-as alert-box information.                               if b-calc-rate:sensitive then do:                                 apply "entry" to b-calc-rate.                              end.                               else do:                                 if b-calc-exch-rate:sensitive then do:                                   apply "entry" to b-calc-exch-rate.                                 end.                                 else do:                                   apply "entry" to varprice-cli.                                end.                               end.                               return no-apply.                             end.
     5240     run rate-exch-correct (output varrate-exch-correct) no-error.                                  if error-status:error then do:                                    message "Ошибка при вызове процедуры rate-exch-correct." skip                                            return-value                                            error-status:get-message(1)                                            error-status:get-message(2)                                    view-as alert-box error.                                    return no-apply.                                  end.                                  if varrate-exch-correct = no then do:                                    message "Курс в партии не согласован с рублевой и ценой в валюте поставщика (договора)." skip                                            "Рублевая цена: "            varprice-rubl    skip                                            "Цена в валюте поставщика: " varprice-cli     skip                                            "Единица поставщика: "       varcli-base-rate skip                                            "Курс валюты поставщика: "   varexch-rate     skip                                            "Шкала валюты поставщика: "  varexch-scale                                    view-as alert-box information.                                    if b-calc-exch-rate:sensitive then do:                                      apply "entry" to b-calc-exch-rate.                                   end.                                    else do:                                      apply "entry" to varprice-cli.                                    end.                                    return no-apply.                                  end.
     5241   END.
     5242   ON LEAVE OF varvat-pc IN FRAME Dialog-Frame
     5243   DO:
     5244   if input frame Dialog-Frame varvat-pc <> round (varvat-pc, 2) then do:
