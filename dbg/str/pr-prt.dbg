      556       define variable price-rubl-with-tax-lococur    like ub.doc-line.price-rubl no-undo.
      557       define variable price-base-with-tax-lococur    like ub.doc-line.price-base no-undo.
      558       define variable price-cli-with-tax-lococur     like ub.doc-line.price-cli  no-undo.
      559       define variable price-rubl-without-tax-lococur like ub.doc-line.price-rubl no-undo.
      560       define variable price-base-without-tax-lococur like ub.doc-line.price-base no-undo.
      561       define variable price-cli-without-tax-lococur  like ub.doc-line.price-base no-undo.
      562       define variable vat-base-lococur               like ub.doc-line.price-base no-undo.
      563       define variable vat-rubl-lococur               like ub.doc-line.price-rubl no-undo.
      564       define variable vat-cli-lococur                like ub.doc-line.price-rubl no-undo.
      565       define variable slt-base-lococur               like ub.doc-line.price-base no-undo.
      566       define variable slt-rubl-lococur               like ub.doc-line.price-rubl no-undo.
      567       define variable slt-cli-lococur                like ub.doc-line.price-rubl no-undo.
      568       define variable road-tax-base-lococur          like ub.doc-line.road-tax   no-undo.
      569       define variable road-tax-rubl-lococur          like ub.doc-line.road-tax   no-undo.
      570       define variable road-tax-cli-lococur           like ub.doc-line.road-tax   no-undo.
      571       define variable transport-base-lococur         like ub.doc-line.price-base no-undo.
      572       define variable transport-rubl-lococur         like ub.doc-line.price-rubl no-undo.
      573       define variable transport-cli-lococur          like ub.doc-line.price-rubl no-undo.
      574       define variable other-base-lococur             like ub.doc-line.price-base no-undo.
      575       define variable other-rubl-lococur             like ub.doc-line.price-rubl no-undo.
      576       define variable other-cli-lococur              like ub.doc-line.price-rubl no-undo.
      577       define variable exch-rate-cli-lococur          like ub.trn-doc.exch-rate   no-undo.
      578       define variable varinvatp-envdocur             as   character              no-undo.
      579       define variable varinvatp-typeocur             as   character              no-undo.
      580   do on error undo, return error return-value :
      581   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      582   for each bf_tt-allsum on error undo, return error return-value :
      583     delete bf_tt-allsum.
      584   end.
      585   assign
      586     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      587     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      588   .
      589   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      591     (output varinvprbcl
      592     )  .
      593     if cl_tt-clcparts.out-code = 'free-zone':U     or
      594        cl_tt-clcparts.out-code = 'out-zone':U   or
      595        cl_tt-clcparts.doc-type = 'акт':U then do:
      596       assign
      597         in-vatp-have-vat-sltcl = yes.
      598     end.
      599     else do:
      600       find first in-vatp_doc-attrcl no-lock
      601         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      602           and in-vatp_doc-attrcl.attr-code = 'envd':U
      603         no-error .
      604       if not available in-vatp_doc-attrcl then do:
      605         assign
      606           in-vatp-have-vat-sltcl = yes.
      607       end.
      608       else do:
      609            in-vatp-have-vat-sltcl = no.
      610       end.
      611     end.
      612     assign
      613      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      614      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      615     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      616              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      617     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      618             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      619             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      620             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      621             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      622             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      623             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      624       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      625     assign
      626       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      627     assign
      628       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      629       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      630       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      631       transport-cli-loccl  = 0
      632       other-cli-loccl      = 0
      633     .
      634   ASSIGN
      635             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      636       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      637   .
      638   if paris-doc then do:
      639     assign
      640       parartic     = cl_tt-clcparts.artic
      641       parprod-type = cl_tt-clcparts.prod-type
      642       parprod-code = cl_tt-clcparts.prod-code
      643       pardoc-type  = cl_tt-clcparts.doc-type
      644       pardoc-code  = cl_tt-clcparts.out-code
      645       parobj-type  = cl_tt-clcparts.obj-type
      646       parobj-code  = cl_tt-clcparts.obj-code.
      647   if parext-doc-type = 'ot':U or
      648      parext-doc-type = ?                 then do:
      649     assign
      650      out-vatp-have-vat-sltcl = yes.
      651   end.
      652   else do:
      653     find first out-vatp_doc-attrcl no-lock
      654       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      655         and out-vatp_doc-attrcl.attr-code = 'envd':U
