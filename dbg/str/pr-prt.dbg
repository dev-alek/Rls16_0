     6395       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6396   .
     6397     assign
     6398       varprice-rubl-slt = slt-rubl-loc
     6399       varprice-base-slt = slt-base-loc
     6400       varprice-cli-slt  = slt-cli-loc
     6401       varsum-rubl-slt   = varprice-rubl-slt * varfact-qnty
     6402       varsum-base-slt   = varprice-base-slt * varfact-qnty
     6403       varsum-cli-slt    = varprice-cli-slt  * varfact-qnty / varcli-base-rate
     6404       varprice-rubl-vat = vat-rubl-loc
     6405       varprice-base-vat = vat-base-loc
     6406       varprice-cli-vat  = vat-cli-loc
     6407       varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     6408       varsum-base-vat   = varprice-base-vat * varfact-qnty
     6409       varsum-cli-vat    = varprice-cli-vat  * varfact-qnty / varcli-base-rate.
     6410     display varprice-base-vat       varsum-base-vat
     6411             varprice-rubl-vat       varsum-rubl-vat
     6412             varprice-cli-vat        varsum-cli-vat
     6413             varprice-base-slt       varsum-base-slt
     6414             varprice-rubl-slt       varsum-rubl-slt
     6415             varprice-cli-slt        varsum-cli-slt
     6416             varprice-base-road-tax  when paris-road-tax
     6417             varsum-base-road-tax    when paris-road-tax
     6418             varprice-base-transport varsum-base-transport
     6419             varprice-base-other     varsum-base-other
     6420     with frame Dialog-Frame.
     6421   END PROCEDURE.
     6422   PROCEDURE proc-calc-rubl-base :
     6423   assign
     6424       varprice-rubl           = varprice-base           * varbase-rate / varbase-scale
     6425       varsum-rubl             = varprice-rubl           * varfact-qnty
     6426       varprice-rubl-road-tax  = varprice-base-road-tax  * varbase-rate / varbase-scale
     6427       varsum-rubl-road-tax    = varprice-rubl-road-tax  * varfact-qnty
     6428       varprice-rubl-transport = varprice-base-transport * varbase-rate / varbase-scale
     6429       varsum-rubl-transport   = varprice-rubl-transport * varfact-qnty
     6430       varprice-rubl-other     = varprice-base-other     * varbase-rate / varbase-scale
     6431       varsum-rubl-other       = varprice-rubl-other     * varfact-qnty.
     6432     assign
     6433       varroad-tax-rubl  = varprice-rubl-road-tax
     6434       vartransport-rubl = varprice-rubl-transport
     6435       varother-rubl     = varprice-rubl-other
     6436       varroad-tax-base  = varprice-base-road-tax
     6437       vartransport-base = varprice-base-transport
