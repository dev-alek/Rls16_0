     4804   if (input frame Dialog-Frame varsum-base-vat / (varsum-base - varsum-base-other - varsum-base-transport - varsum-base-road-tax - varsum-base-slt - varsum-base-vat)) * 100 < 0   or
     4805      (input frame Dialog-Frame varsum-base-vat / (varsum-base - varsum-base-other - varsum-base-transport - varsum-base-road-tax - varsum-base-slt - varsum-base-vat)) * 100 > 100 then do:
     4806      message "При такой сумовой компоненте НДС получится неверный процент НДС: " (input frame Dialog-Frame varsum-base-vat / (varsum-base - varsum-base-other - varsum-base-transport - varsum-base-road-tax - varsum-base-slt - varsum-base-vat)) * 100 " ."
     4807      view-as alert-box.
