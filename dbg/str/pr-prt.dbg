     2193   end procedure.
     2194   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2195   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2196   procedure partslib-clear-temp-parts :
     2197     define buffer buf_temp-parts for temp-parts .
     2198     do
     2199     on error undo, return error
     2200     :
     2201       for each buf_temp-parts
     2202       on error undo, return error
     2203       :
     2204         delete buf_temp-parts .
     2205       end.
     2206     end.
     2207   end procedure.
     2208   procedure partslib-create-temp-parts :
     2209     define parameter buffer buf_parts       for ub.parts .
     2210     define parameter buffer buf_temp-parts  for temp-parts .
     2211     define input  parameter p-goods-twounit as logical   no-undo .
     2212     define variable v-base-part-code as character no-undo .
     2213     do
     2214     on error undo, return error
     2215     :
     2216       if p-goods-twounit = true
     2217       then do:
     2218         assign
     2219           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2220         .
     2221       end.
     2222       else do:
     2223         assign
     2224           v-base-part-code = buf_parts.part-code
     2225         .
     2226       end.
     2227       find first buf_temp-parts exclusive-lock
     2228         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2229           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2230           and buf_temp-parts.artic     = buf_parts.artic
     2231           and buf_temp-parts.prod-type = buf_parts.prod-type
     2232           and buf_temp-parts.prod-code = buf_parts.prod-code
     2233           and buf_temp-parts.in-code   = buf_parts.in-code
     2234           and buf_temp-parts.out-code  = 'free-zone':U
     2235           and buf_temp-parts.part-code = v-base-part-code
     2236         no-error.
     2237       if not available buf_temp-parts
     2238       then do:
     2239         create buf_temp-parts .
     2240         buffer-copy buf_parts to buf_temp-parts
     2241         assign
     2242           buf_temp-parts.out-code  = 'free-zone':U
     2243           buf_temp-parts.part-code = v-base-part-code
     2244           buf_temp-parts.rsrv-free = yes
     2245           buf_temp-parts.status_   = no
     2246           buf_temp-parts.qnty      = 0
     2247           buf_temp-parts.fact-qnty = 0
     2248           buf_temp-parts.real-qnty = 0
     2249           buf_temp-parts.cli-qnty  = 0
     2250         .
     2251       end.
     2252     end.
     2253   end procedure.
     2254   procedure partslib-init-temp-parts :
     2255     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2256     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2257     define input parameter p-artic           like ub.parts.artic     no-undo .
     2258     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2259     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2260     define buffer buf_parts      for ub.parts .
     2261     define buffer buf_temp-parts for temp-parts .
     2262     define variable v-goods-twounit    as logical   no-undo .
     2263     do
     2264     on error undo, return error
     2265     :
     2266   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2267   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2268     (input  p-artic
     2269     ,input  p-prod-type
     2270     ,input  p-prod-code
     2271     ,input  'twounit=request':u
     2272     ,output v-goods-twounit
     2273     ) no-error .
     2274       if error-status :error
     2275       then do:
     2276         message
     2277           vss-workfile vss-revision vss-description skip
     2278           vss-include-info14 skip
     2279           "Ошибка при определении атрибута товара" skip
     2280           "Артикул" p-artic p-prod-type p-prod-code skip
     2281           "twounit=request" skip
     2282           error-status :get-message(1) skip
     2283           return-value skip
     2284           view-as alert-box error .
     2285         undo, return error return-value .
     2286       end.
     2287       run partslib-clear-temp-parts in this-procedure .
     2288       for each buf_parts
     2289         where buf_parts.obj-type  = p-obj-type
     2290           and buf_parts.obj-code  = p-obj-code
     2291           and buf_parts.artic     = p-artic
     2292           and buf_parts.prod-type = p-prod-type
     2293           and buf_parts.prod-code = p-prod-code
     2294           and buf_parts.rsrv-free = yes
     2295           and buf_parts.status_   = no
     2296           and buf_parts.in-code   <> buf_parts.out-code
     2297       on error undo, return error
     2298       :
     2299         run partslib-create-temp-parts in this-procedure
     2300           (buffer buf_parts
     2301           ,buffer buf_temp-parts
     2302           ,input  v-goods-twounit
     2303           ) .
     2304         define variable v-parts-qnty          as decimal   no-undo .
     2305         define variable v-parts-cli-qnty      as decimal   no-undo .
     2306         define variable v-parts-free-qnty     as decimal   no-undo .
     2307         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2308         if buf_parts.out-code = 'free-zone':U
     2309         then do:
     2310           assign
     2311             v-parts-qnty          = buf_parts.qnty
     2312             v-parts-cli-qnty      = buf_parts.cli-qnty
     2313             v-parts-free-qnty     = buf_parts.qnty
     2314             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2315           .
     2316         end.
     2317         else do:
     2318           assign
     2319             v-parts-qnty          = abs(buf_parts.qnty)
     2320             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2321             v-parts-free-qnty     = 0
     2322             v-parts-free-cli-qnty = 0
     2323           .
     2324         end.
     2325         assign
     2326           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2327           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2328           buf_temp-parts.real-qnty     = 0
     2329           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2330           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2331           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2332         .
     2333       end.
     2334     end.
     2335   end procedure.
     2336   procedure partslib-init-temp-parts-by-factord :
     2337     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2338     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2339     define input parameter p-artic              like ub.parts.artic     no-undo .
     2340     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2341     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2342     define input parameter p-fact-order         as decimal   no-undo .
     2343     define input parameter p-include-fact-order as logical   no-undo .
     2344     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2345     define buffer buf_gds-obj  for ub.gds-obj .
     2346     do
     2347     on error undo, return error
     2348     :
     2349       do transaction
     2350       on error undo, return error
     2351       :
     2352   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2354     (input  p-obj-type
     2355     ,input  p-obj-code
     2356     ,input  p-artic
     2357     ,input  p-prod-type
     2358     ,input  p-prod-code
     2359     ,buffer buf_gds-obj
     2360     ) no-error .
     2361         if error-status :error
     2362         then do:
     2363           message
     2364             vss-workfile vss-revision vss-description skip
     2365             vss-include-info14 skip
     2366             "Невозможно найти товар на объекте" skip
     2367             "Объект" p-obj-type p-obj-code skip
     2368             "Артикул" p-artic p-prod-type p-prod-code skip
     2369             error-status :get-message(1) skip
     2370             return-value skip
     2371             view-as alert-box error .
     2372           undo, return error .
     2373         end.
     2374         find current buf_gds-obj exclusive-lock .
     2375       end.
     2376       run partslib-init-temp-parts in this-procedure
     2377         (input p-obj-type
     2378         ,input p-obj-code
     2379         ,input p-artic
     2380         ,input p-prod-type
     2381         ,input p-prod-code
     2382         ) no-error .
     2383       if error-status :error
     2384       then do:
     2385         message
     2386           vss-workfile vss-revision vss-description skip
     2387           vss-include-info14 skip
     2388           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     2389           "Объект" p-obj-type p-obj-code skip
     2390           "Артикул" p-artic p-prod-type p-prod-code skip
     2391           "p-fact-order" p-fact-order skip
     2392           view-as alert-box error .
     2393         undo, return error .
     2394       end.
     2395       if p-include-fact-order = true
     2396       then do:
     2397         assign
     2398           p-fact-order = p-fact-order - 0.0000000001
     2399         .
     2400       end.
     2401       define variable v-max-fact-order as character no-undo .
     2402       run factord-max-fact-order in this-procedure
     2403         (output v-max-fact-order
     2404         ) no-error .
     2405       if error-status :error
     2406       then do:
     2407         message
     2408           vss-workfile vss-revision vss-description skip
     2409           vss-include-info14 skip
     2410           "Ошибка при вызове процедуры factord-max-fact-order" skip
     2411           "Объект" p-obj-type p-obj-code skip
     2412           "Артикул" p-artic p-prod-type p-prod-code skip
     2413           "p-fact-order" p-fact-order skip
     2414           view-as alert-box error .
     2415         undo, return error .
     2416       end.
     2417       run partslib-update-by-factord in this-procedure
     2418         (input p-obj-type
     2419         ,input p-obj-code
     2420         ,input p-artic
     2421         ,input p-prod-type
     2422         ,input p-prod-code
     2423         ,input p-fact-order
     2424         ,input v-max-fact-order
     2425         ,input false
     2426         ) no-error .
     2427       if error-status :error
     2428       then do:
     2429         message
     2430           vss-workfile vss-revision vss-description skip
     2431           vss-include-info14 skip
     2432           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     2433           "Объект" p-obj-type p-obj-code skip
     2434           "Артикул" p-artic p-prod-type p-prod-code skip
     2435           "p-fact-order" p-fact-order skip
     2436           "v-max-fact-order" v-max-fact-order skip
     2437           view-as alert-box error .
     2438         undo, return error .
     2439       end.
     2440     end.
     2441   end procedure.
     2442   procedure partslib-update-by-factord :
     2443     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2444     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2445     define input parameter p-artic              like ub.parts.artic     no-undo .
     2446     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2447     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2448     define input parameter p-start-fact-order   as decimal   no-undo .
     2449     define input parameter p-end-fact-order     as decimal   no-undo .
     2450     define input parameter p-lock-gds-obj       as logical   no-undo .
     2451     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2452     define buffer buf_gds-obj  for ub.gds-obj .
     2453     define buffer buf_doc-line for ub.doc-line .
     2454     define variable v-total-parts-qnty as decimal   no-undo .
     2455     define variable v-goods-gds-goods  as logical   no-undo .
     2456     define variable v-goods-twounit    as logical   no-undo .
     2457     do
     2458     on error undo, return error
     2459     :
     2460       if p-start-fact-order > p-end-fact-order
     2461       then do:
     2462         message
     2463           vss-workfile vss-revision vss-description skip
     2464           vss-include-info14 skip
     2465           "Ошибка задания входных параметров" skip
     2466           "Начало интервала превышает конец интервала" skip
     2467           "Объект" p-obj-type p-obj-code skip
     2468           "Артикул" p-artic p-prod-type p-prod-code skip
     2469           "p-start-fact-order" p-start-fact-order skip
     2470           "p-end-fact-order"   p-end-fact-order skip
     2471           view-as alert-box error .
     2472         undo, return error .
     2473       end.
     2474       if p-lock-gds-obj = true
     2475       then do:
     2476         do transaction
     2477         on error undo, return error
     2478         :
     2479   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2481     (input  p-obj-type
     2482     ,input  p-obj-code
     2483     ,input  p-artic
     2484     ,input  p-prod-type
     2485     ,input  p-prod-code
     2486     ,buffer buf_gds-obj
     2487     ) no-error .
     2488           if error-status :error
     2489           then do:
     2490             message
     2491               vss-workfile vss-revision vss-description skip
     2492               vss-include-info14 skip
     2493               "Невозможно найти gds-obj" skip
     2494               error-status :get-message(1) skip
     2495               return-value skip
     2496               view-as alert-box error .
     2497             undo, return error .
     2498           end.
     2499           find current buf_gds-obj exclusive-lock .
     2500         end.
     2501       end.
     2502   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2504     (input  p-artic
     2505     ,input  p-prod-type
     2506     ,input  p-prod-code
     2507     ,input  'gds-goods=request':u
     2508     ,output v-goods-gds-goods
     2509     ) no-error .
     2510       if error-status :error
     2511       then do:
     2512         message
     2513           vss-workfile vss-revision vss-description skip
     2514           vss-include-info14 skip
     2515           "Ошибка при определении атрибута товара" skip
     2516           "Артикул" p-artic p-prod-type p-prod-code skip
     2517           "gds-goods=request" skip
     2518           error-status :get-message(1) skip
     2519           return-value skip
     2520           view-as alert-box error .
     2521         undo, return error return-value .
     2522       end.
     2523   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2525     (input  p-artic
     2526     ,input  p-prod-type
     2527     ,input  p-prod-code
     2528     ,input  'twounit=request':u
     2529     ,output v-goods-twounit
     2530     ) no-error .
     2531       if error-status :error
     2532       then do:
     2533         message
     2534           vss-workfile vss-revision vss-description skip
     2535           vss-include-info14 skip
     2536           "Ошибка при определении атрибута товара" skip
     2537           "Артикул" p-artic p-prod-type p-prod-code skip
     2538           "twounit=request" skip
     2539           error-status :get-message(1) skip
     2540           return-value skip
     2541           view-as alert-box error .
     2542         undo, return error return-value .
     2543       end.
     2544       for each buf_doc-line no-lock
     2545         where buf_doc-line.obj-type   = p-obj-type
     2546           and buf_doc-line.obj-code   = p-obj-code
     2547           and buf_doc-line.artic      = p-artic
     2548           and buf_doc-line.prod-type  = p-prod-type
     2549           and buf_doc-line.prod-code  = p-prod-code
     2550           and buf_doc-line.status_    = 'факт':U
     2551           and buf_doc-line.fact-order > p-start-fact-order
     2552           and buf_doc-line.fact-order <= p-end-fact-order
     2553       on error undo, return error
     2554       :
     2555         run partslib-process-document in this-procedure
     2556           (input  buf_doc-line.doc-code
     2557           ,input  p-obj-type
     2558           ,input  p-obj-code
     2559           ,input  p-artic
     2560           ,input  p-prod-type
     2561           ,input  p-prod-code
     2562           ,input  v-goods-gds-goods
     2563           ,input  v-goods-twounit
     2564           ,output v-total-parts-qnty
     2565           ) no-error .
     2566         if error-status :error
     2567         then do:
     2568           message
     2569             vss-workfile vss-revision vss-description skip
     2570             vss-include-info14 skip
     2571             "Ошибка при вызове процедуры partslib-process-document" skip
     2572             "Документ" buf_doc-line.doc-code skip
     2573             "Объект" p-obj-type p-obj-code skip
     2574             "Артикул" p-artic p-prod-type p-prod-code skip
     2575             "p-start-fact-order" p-start-fact-order skip
     2576             "p-end-fact-order" p-end-fact-order skip
     2577             error-status :get-message(1) skip
     2578             return-value skip
     2579             view-as alert-box error .
     2580           undo, return error return-value .
     2581         end.
     2582       end.
     2583     end.
     2584   end procedure.
     2585   procedure partslib-process-document :
     2586     define input  parameter p-doc-code         as character no-undo .
     2587     define input  parameter p-obj-type         as character no-undo .
     2588     define input  parameter p-obj-code         as integer   no-undo .
     2589     define input  parameter p-artic            as character no-undo .
     2590     define input  parameter p-prod-type        as character no-undo .
     2591     define input  parameter p-prod-code        as integer   no-undo .
     2592     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2593     define input  parameter p-goods-twounit    as logical   no-undo .
     2594     define output parameter p-total-parts-qnty as decimal   no-undo .
     2595     define variable v-parts-sign as integer   no-undo .
     2596     define buffer buf_trn-doc    for ub.trn-doc .
     2597     define buffer buf_doc-line   for ub.doc-line .
     2598     define buffer buf_parts      for ub.parts .
     2599     define buffer buf_temp-parts for temp-parts .
     2600     do
     2601     on error undo, return error return-value
     2602     :
     2603       find first buf_trn-doc no-lock
     2604         where buf_trn-doc.doc-code = p-doc-code
     2605         no-error .
     2606       if not available buf_trn-doc
     2607       then do:
     2608         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2609                                      ,p-doc-code
     2610                                      ) .
     2611       end.
     2612       case buf_trn-doc.doc-type
     2613       :
     2614         when 'при':U or
     2615         when 'возврат':U or
     2616         when 'инв':U
     2617         then do:
     2618           assign
     2619             v-parts-sign = -1
     2620           .
     2621         end.
     2622         when 'рас':U or
     2623         when 'спи':U
     2624         then do:
     2625           assign
     2626             v-parts-sign = 1
     2627           .
     2628         end.
     2629         otherwise do:
     2630           undo, return error substitute("Неизвестный тип документа &1"
     2631                                       ,buf_trn-doc.doc-type
     2632                                       ) .
     2633         end.
     2634       end.
     2635       find first buf_doc-line no-lock
     2636         where buf_doc-line.doc-code  = p-doc-code
     2637           and buf_doc-line.artic     = p-artic
     2638           and buf_doc-line.prod-type = p-prod-type
     2639           and buf_doc-line.prod-code = p-prod-code
     2640         no-error .
     2641       if not available buf_doc-line
     2642       then do:
     2643         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2644                                      ,p-doc-code
     2645                                      ,artic
     2646                                      ,prod-type
     2647                                      ,prod-code
     2648                                      ) .
     2649       end.
     2650       assign
     2651         p-total-parts-qnty = 0
     2652       .
     2653       if p-goods-gds-goods = true
     2654       then do:
     2655         for each buf_parts no-lock
     2656           where buf_parts.out-code  = p-doc-code
     2657             and buf_parts.obj-type  = p-obj-type
     2658             and buf_parts.obj-code  = p-obj-code
     2659             and buf_parts.artic     = p-artic
     2660             and buf_parts.prod-type = p-prod-type
     2661             and buf_parts.prod-code = p-prod-code
     2662         on error undo, return error
     2663         :
     2664           run partslib-create-temp-parts in this-procedure
     2665             (buffer buf_parts
     2666             ,buffer buf_temp-parts
     2667             ,input  p-goods-twounit
     2668             ) .
     2669           assign
     2670             p-total-parts-qnty        = p-total-parts-qnty
     2671                                       + v-parts-sign * buf_parts.fact-qnty
     2672             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2673                                       + v-parts-sign * buf_parts.fact-qnty
     2674             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2675                                       + v-parts-sign * buf_parts.fact-qnty
     2676             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2677                                       + v-parts-sign * buf_parts.cli-qnty
     2678           .
     2679           if buf_temp-parts.qnty = 0
     2680           then do:
     2681             delete buf_temp-parts .
     2682           end.
     2683         end.
     2684       end.
     2685       else do:
     2686         assign
     2687           p-total-parts-qnty = p-total-parts-qnty
     2688                              + v-parts-sign * buf_doc-line.fact-qnty
     2689         .
     2690       end.
     2691     end.
     2692   end procedure.
     2693   procedure partslib-init-temp-parts-by-date :
     2694     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2695     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2696     define input parameter p-artic           like ub.parts.artic     no-undo .
     2697     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2698     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2699     define input parameter p-fact-date       as date      no-undo .
     2700     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2701     do
     2702     on error undo, return error
     2703     :
     2704       define variable v-fact-order                as decimal   no-undo .
     2705       define variable v-shift-end-fact-order      as decimal   no-undo .
     2706       define variable v-day-end-fact-order        as decimal   no-undo .
     2707       run factord in this-procedure
     2708         (input  p-fact-date
     2709         ,input  1
     2710         ,input  1
     2711         ,input  ?
     2712         ,input  0
     2713         ,input  false
     2714         ,output v-fact-order
     2715         ,output v-shift-end-fact-order
     2716         ,output v-day-end-fact-order
     2717         ) no-error .
     2718       if error-status :error
     2719       then do:
     2720         message
     2721           vss-workfile vss-revision vss-description skip
     2722           vss-include-info14 skip
     2723           "Ошибка при определении момента времени, на который требуется остаток" skip
     2724           "Объект" p-obj-type p-obj-code skip
     2725           "Артикул" p-artic p-prod-type p-prod-code skip
     2726           "Дата" p-fact-date skip
     2727           view-as alert-box error .
     2728         undo, return error .
     2729       end.
     2730       run partslib-init-temp-parts-by-factord in this-procedure
     2731         (input p-obj-type
     2732         ,input p-obj-code
     2733         ,input p-artic
     2734         ,input p-prod-type
     2735         ,input p-prod-code
     2736         ,input v-day-end-fact-order
     2737         ,input false
     2738         ) no-error .
     2739       if error-status :error
     2740       then do:
     2741         message
     2742           vss-workfile vss-revision vss-description skip
     2743           vss-include-info14 skip
     2744           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2745           "Объект" p-obj-type p-obj-code skip
     2746           "Артикул" p-artic p-prod-type p-prod-code skip
     2747           "Дата" p-fact-date skip
     2748           view-as alert-box error .
     2749         undo, return error .
     2750       end.
     2751     end.
     2752   end procedure.
     2753   procedure partslib-calc-cost :
     2754     define output parameter p-fact-qnty      as decimal   no-undo .
     2755     define output parameter p-vat-pc         as decimal   no-undo .
     2756     define output parameter p-slt-pc         as decimal   no-undo .
     2757     define output parameter p-sum-base       as decimal   no-undo .
     2758     define output parameter p-sum-rubl       as decimal   no-undo .
     2759     define output parameter p-vat-base       as decimal   no-undo .
     2760     define output parameter p-vat-rubl       as decimal   no-undo .
     2761     define output parameter p-slt-base       as decimal   no-undo .
     2762     define output parameter p-slt-rubl       as decimal   no-undo .
     2763     define output parameter p-road-tax-base  as decimal   no-undo .
     2764     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2765     define output parameter p-transport-base as decimal   no-undo .
     2766     define output parameter p-transport-rubl as decimal   no-undo .
     2767     define output parameter p-other-base     as decimal   no-undo .
     2768     define output parameter p-other-rubl     as decimal   no-undo .
     2769     define output parameter p-excise-base    as decimal   no-undo .
     2770     define output parameter p-excise-rubl    as decimal   no-undo .
     2771     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2772     do
     2773     on error undo, return error return-value
     2774     :
     2775       define buffer buf_temp-parts for temp-parts .
     2776       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2777       define buffer   in-vatp-parts    for ub.parts   .
     2778       define buffer   in-vatp-doc      for ub.trn-doc .
     2779       define buffer   in-vatp-goods    for ub.goods   .
     2780       define buffer   in-vatp-sysconf  for ub.sysconf .
     2781       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2782       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2783       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2784       define variable varinvprb                  as   character              no-undo.
     2785       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2786       define variable cli-base-rate              as   decimal                no-undo.
     2787       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2788       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2789       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2790       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2791       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2792       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2793       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2794       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2795       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2796       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2797       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2798       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2799       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2800       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2801       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2802       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2803       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2804       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2805       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2806       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2807       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2808       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2809       define variable varinvatp-envd             as   character              no-undo.
     2810       define variable varinvatp-type             as   character              no-undo.
     2811       for each buf_temp-parts
     2812       on error undo, return error
     2813       :
     2814   assign
     2815     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2816     price-base-with-tax-loc = buf_temp-parts.price-base
     2817   .
     2818   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2819   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2820     (output varinvprb
     2821     )  .
     2822     if buf_temp-parts.out-code = 'free-zone':U     or
     2823        buf_temp-parts.out-code = 'out-zone':U   or
     2824        buf_temp-parts.doc-type = 'акт':U then do:
     2825       assign
     2826         in-vatp-have-vat-slt = yes.
     2827     end.
     2828     else do:
     2829       find first in-vatp_doc-attr no-lock
     2830         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2831           and in-vatp_doc-attr.attr-code = 'envd':U
     2832         no-error .
     2833       if not available in-vatp_doc-attr then do:
     2834         assign
     2835           in-vatp-have-vat-slt = yes.
     2836       end.
     2837       else do:
     2838            in-vatp-have-vat-slt = no.
     2839       end.
     2840     end.
     2841     assign
     2842      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2843      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2844     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2845              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2846     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2847             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2848             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2849             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2850             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2851             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2852             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2853       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2854     assign
     2855       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2856     assign
     2857       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2858       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2859       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2860       transport-cli-loc  = 0
     2861       other-cli-loc      = 0
     2862     .
     2863   ASSIGN
     2864             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2865       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2866   .
     2867         assign
     2868           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2869           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2870           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2871           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2872           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2873           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2874           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2875           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2876           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2877           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2878           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2879           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2880           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2881           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2882           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2883           p-excise-base    = p-excise-base    + 0
     2884           p-excise-rubl    = p-excise-rubl    + 0
     2885         .
     2886       end.
     2887       if p-fact-qnty      = ?
     2888       or p-sum-base       = ?
     2889       or p-sum-rubl       = ?
     2890       or p-vat-base       = ?
     2891       or p-vat-rubl       = ?
     2892       or p-slt-base       = ?
     2893       or p-slt-rubl       = ?
     2894       or p-road-tax-base  = ?
     2895       or p-road-tax-rubl  = ?
     2896       or p-transport-base = ?
     2897       or p-transport-rubl = ?
     2898       or p-other-base     = ?
     2899       or p-other-rubl     = ?
     2900       or p-excise-base    = ?
     2901       or p-excise-rubl    = ?
     2902       then do:
     2903         message
     2904           vss-workfile vss-revision vss-description skip
     2905           vss-include-info14 skip
     2906           "Программа in-vatp.i вернула неопределенные значения" skip
     2907           "p-fact-qnty"      p-fact-qnty      skip
     2908           "p-sum-base"       p-sum-base       skip
     2909           "p-sum-rubl"       p-sum-rubl       skip
     2910           "p-vat-base"       p-vat-base       skip
     2911           "p-vat-rubl"       p-vat-rubl       skip
     2912           "p-slt-base"       p-slt-base       skip
     2913           "p-slt-rubl"       p-slt-rubl       skip
     2914           "p-road-tax-base"  p-road-tax-base  skip
     2915           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2916           "p-transport-base" p-transport-base skip
     2917           "p-transport-rubl" p-transport-rubl skip
     2918           "p-other-base"     p-other-base     skip
     2919           "p-other-rubl"     p-other-rubl     skip
     2920           "p-excise-base"    p-excise-base    skip
     2921           "p-excise-rubl"    p-excise-rubl    skip
     2922           view-as alert-box error .
     2923         undo, return error .
     2924       end.
     2925     end.
     2926   end procedure.
     2927   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2928   procedure tax-name:
     2929   define input  parameter pardef-tax  as character           no-undo.
     2930   define output parameter parname-tax as character initial ? no-undo.
     2931   define buffer bf_tax for ub.tax.
     2932   do on error undo, return error :
     2933      case pardef-tax:
     2934         when 'vat':U then do:
     2935                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     2936         end.
     2937         when 'slt':U then do:
     2938                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     2939         end.
     2940         when 'rdt':U then do:
     2941                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     2942         end.
     2943         when 'exc':U then do:
     2944                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     2945         end.
     2946         otherwise do:
     2947            return error "Задан неверный параметр " + pardef-tax + " .".
     2948         end.
     2949      end case.
     2950   end.
     2951   end procedure.
