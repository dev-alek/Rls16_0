     1283     bf_tt-allsum.other-cli-acc        = (if other-cli-loccl / cli-base-ratecl       = ? then 0 else other-cli-loccl     / cli-base-ratecl  * cl_tt-clcparts.fact-qnty).
     1284   create bfs_tt-allsum.
     1285   assign
     1286     bfs_tt-allsum.sum-type = 'основная_сумма_со_знаком':U.
     1287   if pardoc-type = 'инв':U or
