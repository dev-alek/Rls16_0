     5949   PROCEDURE proc-calc-base-rubl :
     5950   assign
     5951       varprice-base           = varprice-rubl           / varbase-rate * varbase-scale
     5952       varsum-base             = varprice-base           * varfact-qnty
     5953       varprice-base-road-tax  = varprice-rubl-road-tax  / varbase-rate * varbase-scale
     5954       varsum-base-road-tax    = varprice-base-road-tax  * varfact-qnty
     5955       varprice-base-transport = varprice-rubl-transport / varbase-rate * varbase-scale
     5956       varsum-base-transport   = varprice-base-transport * varfact-qnty
     5957       varprice-base-other     = varprice-rubl-other     / varbase-rate * varbase-scale
     5958       varsum-base-other       = varprice-base-other     * varfact-qnty.
     5959     assign
     5960       varroad-tax-rubl  = varprice-rubl-road-tax
     5961       vartransport-rubl = varprice-rubl-transport
     5962       varother-rubl     = varprice-rubl-other
     5963       varroad-tax-base  = varprice-base-road-tax
     5964       vartransport-base = varprice-base-transport
     5965       varother-base     = varprice-base-other
     5966     .
     5967   assign
     5968     price-rubl-with-tax-loc = varprice-rubl
     5969     price-base-with-tax-loc = varprice-base
     5970   .
     5971   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5972   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5973     (output varinvprb
     5974     )  .
     5975     if varout-code = 'free-zone':U     or
     5976        varout-code = 'out-zone':U   or
     5977        vardoc-type = 'акт':U then do:
     5978       assign
     5979         in-vatp-have-vat-slt = yes.
     5980     end.
     5981     else do:
     5982       find first in-vatp_doc-attr no-lock
     5983         where in-vatp_doc-attr.doc-code  = varout-code
     5984           and in-vatp_doc-attr.attr-code = 'envd':U
     5985         no-error .
     5986       if not available in-vatp_doc-attr then do:
     5987         assign
     5988           in-vatp-have-vat-slt = yes.
     5989       end.
     5990       else do:
     5991            in-vatp-have-vat-slt = no.
     5992       end.
     5993     end.
     5994     assign
     5995      price-cli-with-tax-loc = varprice-cli
     5996      cli-base-rate          = varcli-base-rate.
     5997     ASSIGN   road-tax-base-loc  = (if varroad-tax-base  = ? then 0 else varroad-tax-base)
     5998              road-tax-rubl-loc  = (if varroad-tax-rubl  = ? then 0 else varroad-tax-rubl).
     5999     ASSIGN  transport-base-loc = (if vartransport-base = ? then 0 else vartransport-base)
     6000             transport-rubl-loc = (if vartransport-rubl = ? then 0 else vartransport-rubl)
     6001             other-base-loc     = (if varother-base     = ? then 0 else varother-base)
