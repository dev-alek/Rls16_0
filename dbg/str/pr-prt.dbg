     4824       varmem-price-cli = varprice-cli.
     4825     assign frame Dialog-Frame varsum-cli.
     4826     assign varprice-cli = varsum-cli / varfact-qnty * varcli-base-rate -
     4827                           varprice-cli-road-tax -
     4828                           (if varvat-type <> 'в т. ч.':U then varprice-cli-vat else 0) -
     4829                           (if varslt-type <> 'в т. ч.':U then varprice-cli-slt else 0).
     4830     display varprice-cli with frame Dialog-Frame.
