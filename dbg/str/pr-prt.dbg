     3991         varsum-rubl-road-tax   = varmem-sum-rubl-road-tax
     3992         varprice-base-road-tax = varmem-price-base-road-tax
     3993         varsum-base-road-tax   = varmem-sum-base-road-tax
     3994         varprice-cli-road-tax  = varmem-price-cli-road-tax
     3995         varsum-cli-road-tax    = varmem-sum-cli-road-tax
     3996       .
