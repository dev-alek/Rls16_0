     5287   procedure minbtn-set :
     5288       do
     5289           on error undo, return error return-value
     5290           :
     5291           define variable ii              as integer       no-undo .
     5292           define variable fh              as widget-handle no-undo .
     5293           define variable hh              as widget-handle no-undo .
     5294           define variable v-h             as handle        extent 4 no-undo .
     5295           define variable v-name-button   as character     no-undo .
     5296           define variable v-help-old-x    as decimal       no-undo .
     5297           define variable v-help-old-y    as decimal       no-undo .
     5298           define variable v-help-old-size as decimal       no-undo .
     5299           define variable v-frame-width   as decimal       no-undo .
     5300           define variable jj              as integer       no-undo .
     5301           do
     5302               on error undo, return error
     5303               :
     5304               assign
     5305                   v-frame-width = frame Dialog-Frame:width - 0.3
     5306                   fh            = frame Dialog-Frame:first-child
     5307                   hh            = fh:first-child
     5308                   ii            = 1
     5309                   .
     5310               do while valid-handle(hh):
     5311                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5312                   do:
     5313                       case lc(hh:name) :
     5314                           when "b-help" then
     5315                               do:
     5316                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5317                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5318                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5319                                   hh:TOOLTIP = "Помощь" .
     5320                                   v-help-old-x = hh:column .
     5321                                   v-help-old-y = hh:row    .
     5322                                   v-help-old-size = hh:width .
     5323                                   hh:width-chars = 2.5 .
     5324                               end.
     5325                           when "b-print" then
     5326                               do:
     5327                                   hh:load-image("cmp/b-print.bmp":u) .
     5328                                   hh:TOOLTIP = "Печать" .
     5329                                   v-h[ii] = hh:handle .
     5330                                   ii = ii + 1 .
     5331                                   hh:width-chars = 3 .
     5332                               end.
     5333                           when "b-history" or
     5334                           when "b-hist" then
     5335                               do:
     5336                                   hh:load-image("cmp/b-hist.bmp":u) .
     5337                                   hh:TOOLTIP = "История" .
     5338                                   v-h[ii] = hh:handle .
     5339                                   ii = ii + 1 .
     5340                                   hh:width-chars = 3 .
     5341                               end.
     5342                           when "b-sch" then
     5343                               do:
     5344                                   hh:load-image("cmp/b-sch.bmp":u) .
     5345                                   hh:TOOLTIP = "Установка Фильтра" .
     5346                                   v-h[ii] = hh:handle .
     5347                                   ii = ii + 1 .
     5348                                   hh:width-chars = 3 .
     5349                               end.
     5350                           when "b-hist-user" then
     5351                               do:
     5352                                   hh:load-image("cmp/b-hist.bmp":u) .
     5353                                   hh:TOOLTIP = "История пользователя" .
     5354                                   ii = ii + 1 .
     5355                               end.
     5356                       end case.
     5357                   end.
     5358                   hh = hh:next-sibling.
     5359               end.
     5360               b-help:column = v-frame-width - b-help:width-chars.
     5361               jj = 0.
     5362               repeat ii = 4 to 1 by -1 :
     5363                   if valid-handle (v-h[ii] ) then
     5364                   do:
     5365                       jj  = jj + 1 .
     5366                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5367                       v-h[ii]:row    = v-help-old-y .
     5368                   end.
     5369               end.
     5370           end.
     5371       end.
     5372   end procedure.
     5373   run start-state in this-procedure no-error.
     5374   if error-status:error then do:
     5375     message
     5376     "Ошибка при начальной установке сумм." skip
     5377     return-value skip
     5378     error-status:get-message(1)
     5379     view-as alert-box error.
     5380     return error.
     5381   end.
     5382   MAIN-BLOCK:
     5383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
