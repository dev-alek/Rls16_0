     1927             assign
     1928               varlastcur-base     = varprice-sale
     1929               varlastcur-road-tax = varroad-tax
     1930               varlastcur-excise   = varexcise
     1931               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1932               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1933               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1934               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1935             .
     1936         end.
     1937       end.
     1938       if varcur-fact-qnty = 0 then do:
     1939         assign
     1940           varcur-base      = varlastcur-base
     1941           varcur-road-tax  = varlastcur-road-tax
     1942           varcur-excise    = varlastcur-excise
     1943         .
     1944       end.
     1945       else do:
     1946         assign
     1947           varcur-base      = varcur-base      / varcur-fact-qnty
     1948           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1949           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1950         .
     1951       end.
     1952       if varcur-vat-pc = ?
