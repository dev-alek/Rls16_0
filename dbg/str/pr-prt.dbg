     1537       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     1538       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     1539       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     1540       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     1541       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     1542       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     1543       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     1544       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     1545       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     1546       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     1547       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     1548       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     1549       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     1550       .
     1551     assign
     1552       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1553       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1554       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1555       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1556       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1557       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1558       bfsacc_tt-allsum.vat-base-doc        = 0
     1559       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1560       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1561       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1562       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1563       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1564       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1565       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1566       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1567       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1568       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1569       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1570       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1571       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1572       bfsacc_tt-allsum.vat-base-cur        = 0
     1573       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1574       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1575       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1576       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1577       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1578       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1579       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1580       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1581       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1582       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1583       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1584       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1585       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1586       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1587       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1588       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1589       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1590       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1591       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1592       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1593       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1594       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1595       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1596       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1597       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1598       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1599       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1600       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1601       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1602       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1603       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1604       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1605       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1606       .
     1607   end.
     1608   otherwise do:
     1609     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1610                              cl_tt-clcparts.purch-code,
     1611                              cl_tt-clcparts.part-code,
     1612                              cl_tt-clcparts.out-code,
     1613                              cl_tt-clcparts.in-code,
     1614                              cl_tt-clcparts.artic,
     1615                              cl_tt-clcparts.prod-type,
     1616                              cl_tt-clcparts.prod-code).
     1617   end.
     1618   end case.
     1619   end.
     1620   end procedure.
     1621   procedure clcprtsl_calc-line :
     1622   define input  parameter parrec-line as recid no-undo.
     1623   define variable v-tax-date         as   date                     no-undo.
     1624   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1625   define variable varr-b             as   character                no-undo.
     1626   define variable varr-btype         as   character                no-undo.
     1627   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1628   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1629   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1630   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1631   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1632   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1633   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1634   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1635   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1636   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1637   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1638   define variable varexcise          like ub.price-list.excise     no-undo.
     1639   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1640   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1641   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1642   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1643   define variable v-varsum           as decimal                  no-undo.
     1644   define variable varprice-salef as decimal   no-undo .
     1645   define buffer bf_trn-doc             for ub.trn-doc.
     1646   define buffer bf_doc-line            for ub.doc-line.
     1647   define buffer bf_gds-dtl             for ub.gds-dtl.
     1648   define buffer bf_goods               for ub.goods.
     1649   define buffer bf_parts               for ub.parts.
     1650   define buffer bf_sysconf             for ub.sysconf.
     1651   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1652   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1653   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1654   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1655   define buffer buf_parts        for ub.parts.
     1656   v-calcbypart = no.
     1657   do on error undo, return error return-value :
     1658   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1660     (output varr-b
     1661     )  .
     1662     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1663     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1664     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1665                               bf_goods.prod-type = bf_doc-line.prod-type and
     1666                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1667     if bf_trn-doc.fact-date <> ?        then do:
     1668       assign v-tax-date = bf_trn-doc.fact-date.
     1669     end.
     1670     else do:
     1671       assign v-tax-date = ?.
     1672     end.
     1673   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1675     (input  bf_goods.gds-code
     1676     ,input  '1':U
     1677     ,input  v-tax-date
     1678     ,input  bf_trn-doc.host-code
     1679     ,input  bf_trn-doc.obj-type
     1680     ,input  bf_trn-doc.obj-code
     1681     ,output v-vat-pc
     1682     ) no-error .
     1683     if error-status :error
     1684     or v-vat-pc = ? then do:
     1685        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1686     end.
     1687     if bf_goods.gds-type = 'у':U or
     1688        bf_trn-doc.status_ = 'запрос':U then do:
     1689       for each bf_tt-allsum-line
     1690       on error undo, return error return-value
     1691        :
     1692         delete bf_tt-allsum-line.
     1693       end.
     1694       create bf_tt-allsum-line.
     1695       assign
     1696        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1697       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1698                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1699                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1700                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1701         assign
     1702           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1703           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1704           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1705           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1706           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1707           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1708           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1709           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1710           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1711           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1712           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1713           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1714           bf_tt-allsum-line.vat-cli-acc          =  ?
     1715           .
     1716       end.
     1717       assign
     1718         bf_tt-allsum-line.cli-qnty             =  ?
     1719         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1720         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1721         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1722         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1723         bf_tt-allsum-line.road-tax-base-doc    =  0
     1724         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1725         bf_tt-allsum-line.excise-base-doc      =  0
     1726         bf_tt-allsum-line.excise-rubl-doc      =  0
     1727         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
