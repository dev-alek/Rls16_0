     5511   RUN disable_UI.
     5512   PROCEDURE calc-price-base-vat :
     5513   assign frame Dialog-Frame
     5514      varprice-base-vat.
     5515   assign
     5516     varsum-base-vat   = varprice-base-vat * varfact-qnty
     5517     varprice-rubl-vat = varprice-base-vat * varbase-rate / varbase-scale
     5518     varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5519     varprice-cli-vat  = varprice-rubl-vat / varexch-rate * varexch-scale / varcli-base-rate
     5520     varsum-cli-vat    = varprice-rubl-vat / varexch-rate * varexch-scale * varfact-qnty
     5521     varvat-pc         = (varprice-base-vat / (varprice-base - varother-base - vartransport-base - varroad-tax-base - varprice-base-slt - varprice-base-vat)) * 100
     5522     .
     5523   display varsum-base-vat varprice-rubl-vat varsum-rubl-vat varprice-cli-vat varsum-cli-vat varvat-pc with frame Dialog-Frame.
     5524   END PROCEDURE.
     5525   PROCEDURE calc-price-cli-vat :
     5526   assign frame Dialog-Frame
     5527      varprice-cli-vat.
     5528   assign
     5529     varsum-cli-vat    = varprice-cli-vat * varfact-qnty / varcli-base-rate
     5530     varprice-rubl-vat = varprice-cli-vat / varcli-base-rate * varexch-rate / varexch-scale
     5531     varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5532     varprice-base-vat = varprice-rubl-vat / varbase-rate * varbase-scale
     5533     varsum-base-vat   = varprice-base-vat * varfact-qnty
     5534     varvat-pc         = varprice-cli-vat / (varprice-cli + (if varvat-type <> 'в т. ч.':U then varprice-cli-vat else 0) + (if varslt-type <> 'в т. ч.':U then varprice-cli-slt else 0) - varprice-cli-slt - varprice-cli-vat) * 100
     5535     .
     5536   display varsum-cli-vat varprice-rubl-vat varsum-rubl-vat varprice-base-vat varsum-base-vat varvat-pc with frame Dialog-Frame.
     5537   END PROCEDURE.
     5538   PROCEDURE calc-price-rubl-vat :
     5539   assign frame Dialog-Frame
     5540      varprice-rubl-vat.
     5541   assign
     5542     varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5543     varprice-base-vat = varprice-rubl-vat / varbase-rate * varbase-scale
     5544     varsum-base-vat   = varprice-base-vat * varfact-qnty
     5545     varprice-cli-vat  = varprice-rubl-vat / varexch-rate * varexch-scale / varcli-base-rate
     5546     varsum-cli-vat    = varprice-rubl-vat / varexch-rate * varexch-scale * varfact-qnty
     5547     varvat-pc         = (varprice-rubl-vat / (varprice-rubl - varprice-rubl-other - varprice-rubl-transport - varprice-rubl-road-tax - varprice-rubl-slt - varprice-rubl-vat)) * 100
     5548     .
     5549   display varsum-rubl-vat varprice-base-vat varsum-base-vat varprice-cli-vat varsum-cli-vat varvat-pc with frame Dialog-Frame.
     5550   END PROCEDURE.
     5551   PROCEDURE calc-sum-base-vat :
     5552   assign frame Dialog-Frame
     5553      varsum-base-vat.
     5554   assign
     5555     varprice-base-vat = varprice-base-vat / varfact-qnty
     5556     varprice-rubl-vat = varprice-base-vat * varbase-rate / varbase-scale
     5557     varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5558     varprice-cli-vat  = varprice-rubl-vat / varexch-rate * varexch-scale / varcli-base-rate
     5559     varsum-cli-vat    = varprice-rubl-vat / varexch-rate * varexch-scale * varfact-qnty
     5560     varvat-pc         = (varsum-base-vat / (varsum-base - varsum-base-other - varsum-base-transport - varsum-base-road-tax - varsum-base-slt - varsum-base-vat)) * 100
     5561     .
     5562   display varprice-base-vat varprice-rubl-vat varsum-rubl-vat varprice-cli-vat varsum-cli-vat varvat-pc with frame Dialog-Frame.
     5563   END PROCEDURE.
     5564   PROCEDURE calc-sum-cli-vat :
     5565   assign frame Dialog-Frame
     5566      varsum-cli-vat.
     5567     assign
     5568      varprice-cli-vat  = varsum-cli-vat / varfact-qnty * varcli-base-rate
     5569      varprice-rubl-vat = varprice-cli-vat / varcli-base-rate * varexch-rate / varexch-scale
     5570      varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5571      varprice-base-vat = varprice-rubl-vat / varbase-rate * varbase-scale
     5572      varsum-base-vat   = varprice-base-vat * varfact-qnty
     5573      varvat-pc         = varsum-cli-vat / (varsum-cli - varsum-cli-road-tax - varsum-cli-slt - varsum-cli-vat) * 100
     5574     .
     5575     display varprice-cli-vat varprice-rubl-vat varsum-rubl-vat varprice-base-vat varsum-base-vat varvat-pc with frame Dialog-Frame.
     5576   END PROCEDURE.
     5577   PROCEDURE calc-sum-rubl-vat :
     5578   assign frame Dialog-Frame
     5579      varsum-rubl-vat.
     5580     assign
     5581      varprice-rubl-vat = varsum-rubl-vat / varfact-qnty
     5582      varprice-base-vat = varprice-rubl-vat / varbase-rate * varbase-scale
     5583      varsum-base-vat   = varsum-rubl-vat / varbase-rate * varbase-scale
     5584      varprice-cli-vat  = varprice-rubl-vat / varexch-rate * varexch-scale / varcli-base-rate
     5585      varsum-cli-vat    = varprice-rubl-vat / varexch-rate * varexch-scale * varfact-qnty
