     5866             transport-rubl-loc = (if vartransport-rubl = ? then 0 else vartransport-rubl)
     5867             other-base-loc     = (if varother-base     = ? then 0 else varother-base)
     5868             other-rubl-loc     = (if varother-rubl     = ? then 0 else varother-rubl)
     5869             vat-pc-loc         = (if varvat-pc         = ? then 0 else varvat-pc)
     5870             slt-pc-loc         = (if varslt-pc         = ? then 0 else varslt-pc).
     5871             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5872       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5873     assign
     5874       exch-rate-cli-loc = (varprice-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if varvat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if varslt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / varprice-cli .
     5875     assign
     5876       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     5877       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     5878       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     5879       transport-cli-loc  = 0
     5880       other-cli-loc      = 0
     5881     .
     5882   ASSIGN
     5883             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5884       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5885   .
     5886   assign
     5887     varprice-rubl-vat = vat-rubl-loc
     5888     varprice-base-vat = vat-base-loc
     5889     varprice-cli-vat  = vat-cli-loc
     5890     varsum-rubl-vat   = varprice-rubl-vat * varfact-qnty
     5891     varsum-base-vat   = varprice-base-vat * varfact-qnty
     5892     varsum-cli-vat    = varprice-cli-vat  / varcli-base-rate * varfact-qnty.
     5893   display varprice-rubl-vat varprice-base-vat varprice-cli-vat
     5894           varsum-rubl-vat   varsum-base-vat   varsum-cli-vat   with frame Dialog-Frame.
     5895   END PROCEDURE.
     5896   PROCEDURE disable_UI :
     5897     HIDE FRAME Dialog-Frame.
     5898   END PROCEDURE.
