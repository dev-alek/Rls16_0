     2090             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2091             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2092             .
     2093   end.
     2094      run clcprtsl_calc-parts in this-procedure (
     2095        input recid(bf_tt-clcparts),
     2096        input paris-doc,
     2097        input paris-cur,
     2098        input parroad-tax,
