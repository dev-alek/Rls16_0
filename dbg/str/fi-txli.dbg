      488   DEFINE FRAME Dialog-Frame
      489        B-Help AT ROW 1 COL 89
      490        B-exit AT ROW 1.04 COL 1
      491        b-quit AT ROW 1.04 COL 11
      492        f-all-sum-doc AT ROW 2.88 COL 23.25 COLON-ALIGNED
      493        f-sum-doc AT ROW 4.08 COL 23.63 COLON-ALIGNED
      494        T-with-slt AT ROW 5.54 COL 25.38
      495        f-slt-pc AT ROW 5.54 COL 45 COLON-ALIGNED
      496        f-sum-slt AT ROW 5.54 COL 73.63 COLON-ALIGNED
      497        T-sltpc AT ROW 5.58 COL 38.75
      498        T-sltsum AT ROW 5.58 COL 62.5
      499        T-with-vat AT ROW 6.79 COL 25.38
      500        f-vat-pc AT ROW 6.79 COL 45 COLON-ALIGNED
      501        f-sum-vat AT ROW 6.79 COL 73.63 COLON-ALIGNED
      502        T-vatpc AT ROW 6.83 COL 38.75
      503        T-vatsum AT ROW 6.83 COL 62.5
      504        f-curr-abbr AT ROW 2.92 COL 54.63 COLON-ALIGNED NO-LABEL
      505        F-curr-code AT ROW 2.96 COL 49.5 COLON-ALIGNED
      506        SPACE(43.74) SKIP(5.69)
      507       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      508            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      509            TITLE "Налоги"
      510            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      511   ASSIGN
      512          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      513          FRAME Dialog-Frame:HIDDEN           = TRUE.
      514   ON GO OF FRAME Dialog-Frame
      515   DO:
      516     run check-sums in this-procedure no-error.
      517     if error-status:error then return no-apply.
      518   END.
      519   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      520   DO:
      521     APPLY "END-ERROR":U TO SELF.
      522   END.
      523   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      524   DO:
      525     assign frame Dialog-Frame
      526     T-with-slt
      527     T-with-vat
      528     .
      529     if f-slt-pc:sensitive then  assign frame Dialog-Frame     f-slt-pc.
      530     if f-vat-pc:sensitive then  assign frame Dialog-Frame     f-vat-pc.
      531     if f-sum-vat:sensitive then  assign frame Dialog-Frame    f-sum-vat.
      532     if f-sum-slt:sensitive then  assign frame Dialog-Frame    f-sum-slt.
      533   assign
      534     p-res = true
      535     p-slt-pc              = f-slt-pc
      536     p-sum-line-doc        = f-sum-doc
      537     p-sum-vat-line-doc    = f-sum-vat
      538     p-sum-slt-line-doc    = f-sum-slt
      539     p-vat-pc              = f-vat-pc
      540     p-with-slt            = T-with-slt
      541     p-with-vat            =  T-with-vat
      542   .
      543   apply "window-close" to self.
      544   return .
      545   END.
      546   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      547   DO:
      548    p-res = false  .
      549   END.
      550   ON LEAVE OF f-slt-pc IN FRAME Dialog-Frame
      551   DO:
      552     assign
      553     f-slt-pc.
      554     run recalc-sums in this-procedure("slt-pc":U).
      555     run recalc-sums in this-procedure("sum-doc":U).
      556   END.
      557   ON return OF f-slt-pc IN FRAME Dialog-Frame
      558   DO:
      559     run next-focus in this-procedure  (input  f-slt-pc:handle ) .
      560     return no-apply .
      561   END.
      562   ON LEAVE OF f-sum-doc IN FRAME Dialog-Frame
      563   DO:
      564     if f-sum-doc:modified = true then do:
      565         assign
      566           f-sum-doc
      567         .
      568         if abs(p-sum-doc) < abs(f-sum-doc) then do:
      569             message "Сумма налогов в том числе больше чем общая сумма документа" p-sum-doc .
      570             return no-apply.
      571         end.
      572     end.
      573     run recalc-sums in this-procedure("sum-doc":U).
      574   END.
      575   ON return OF f-sum-doc IN FRAME Dialog-Frame
      576   DO:
      577     run next-focus in this-procedure  (input  f-sum-doc:handle ) .
      578     return no-apply .
      579   END.
      580   ON LEAVE OF f-sum-slt IN FRAME Dialog-Frame
      581   DO:
      582       assign
      583     f-sum-slt.
      584     run recalc-sums in this-procedure("sum-slt":U).
      585     run recalc-sums in this-procedure("sum-doc":U).
      586   END.
      587   ON return OF f-sum-slt IN FRAME Dialog-Frame
      588   DO:
      589     run next-focus in this-procedure  (input  f-sum-slt:handle ) .
      590     return no-apply .
      591   END.
      592   ON LEAVE OF f-sum-vat IN FRAME Dialog-Frame
      593   DO:
      594     assign
      595     f-sum-vat.
      596     run recalc-sums in this-procedure("sum-vat":U).
      597       run recalc-sums in this-procedure("sum-doc":U).
      598   END.
      599   ON return OF f-sum-vat IN FRAME Dialog-Frame
      600   DO:
      601     run next-focus in this-procedure  (input  f-sum-vat:handle ) .
      602     return no-apply .
      603   END.
      604   ON LEAVE OF f-vat-pc IN FRAME Dialog-Frame
      605   DO:
      606       assign
      607     f-vat-pc.
      608     run recalc-sums in this-procedure("vat-pc":U).
      609     run recalc-sums in this-procedure("sum-doc":U).
      610   END.
      611   ON return OF f-vat-pc IN FRAME Dialog-Frame
      612   DO:
      613     run next-focus in this-procedure  (input  f-vat-pc:handle ) .
      614     return no-apply .
      615   END.
      616   ON VALUE-CHANGED OF T-sltpc IN FRAME Dialog-Frame
      617   DO:
      618   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   if lookup(self :type
      620            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      621            ) = 0
      622   then do:
      623     message
      624       "$Workfile$"
      625       "Указанному интерфейсному элементу фокус не может быть передан" skip
      626       "Интерфейсный элемент" self :name  skip
      627       "Тип" self :type  skip
      628       "Процедура" this-procedure :file-name skip
      629       view-as alert-box .
      630   end.
      631   else do:
      632     apply "entry":u to self  .
      633     if focus :handle <> self :handle  then do:
      634       return no-apply .
      635     end.
      636   end.
      637     assign
      638     t-sltpc.
      639     run disable-enable in this-procedure("slt-pc":U).
      640   END.
      641   ON VALUE-CHANGED OF T-sltsum IN FRAME Dialog-Frame
      642   DO:
