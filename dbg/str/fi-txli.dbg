        1   DEFINE BUFFER locked_c-fin-ob FOR c-fin-ob.
        2   DEFINE BUFFER locked_fin-ob FOR fin-ob.
        3   DEFINE TEMP-TABLE tt-fin-ob-tax NO-UNDO LIKE fin-ob-tax.
        4   DEFINE TEMP-TABLE tt0-fin-ob-tax NO-UNDO LIKE fin-ob-tax.
        5   DEFINE BUFFER X_clients-host FOR clients.
        6   DEFINE BUFFER X_sysconf FOR sysconf.
        7   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        9   define input parameter p-mode as character no-undo.
       10   define input parameter p-host-code like ub.fin-ob.host-code no-undo.
       11   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo.
       12   define input parameter p-doc-type as character no-undo .
