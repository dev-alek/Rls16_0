      644   if lookup(self :type
      645            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      646            ) = 0
      647   then do:
      648     message
      649       "$Workfile$"
      650       "Указанному интерфейсному элементу фокус не может быть передан" skip
      651       "Интерфейсный элемент" self :name  skip
      652       "Тип" self :type  skip
