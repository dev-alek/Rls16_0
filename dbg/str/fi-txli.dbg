       26   DEFINE INPUT PARAMETER TABLE FOR tt-fin-ob-tax .
       27   define input parameter p-recid as recid no-undo .
       28   define input parameter p-chip-num like ub.c-fin-ob.chip-num no-undo .
       29   define output parameter p-res as logical no-undo .
       30   def var vss-revision    as character no-undo init "$Revision$":U .
       31   def var vss-author      as character no-undo init "$Author$":U .
       32   def var vss-date        as character no-undo init "$Date$":U .
       33   def var vss-workfile    as character no-undo init "$Workfile$":U .
       34   def var vss-archive     as character no-undo init "$Archive$":U .
       35   def var vss-description as character no-undo init "Налоги для финобязательства".
       36   procedure vss-get-info :
       37     define output parameter p-vss-revision    like vss-revision    no-undo .
       38     define output parameter p-vss-author      like vss-author      no-undo .
       39     define output parameter p-vss-date        like vss-date        no-undo .
       40     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       41     define output parameter p-vss-archive     like vss-archive     no-undo .
       42     define output parameter p-vss-description like vss-description no-undo .
       43     assign
       44       p-vss-revision    = vss-revision
       45       p-vss-author      = vss-author
       46       p-vss-date        = vss-date
       47       p-vss-workfile    = vss-workfile
       48       p-vss-archive     = vss-archive
       49       p-vss-description = vss-description
       50     .
       51   end procedure.
       52   procedure vss-get-parameters :
       53     define output parameter p-vss-parameters as character no-undo .
       54   end procedure.
       55   define new global shared variable g#vssrevis-logger as handle    no-undo .
       56   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       57   define variable v-vssrevis-logger                   as handle    no-undo .
       58   procedure vss-logevent :
       59     define input  parameter p-extra-paramters as character no-undo .
       60     define variable v-vssrevis-parameters as character no-undo .
       61     do
       62     on error undo, return error return-value
       63     :
       64       if  valid-handle(v-vssrevis-logger)
       65       and v-vssrevis-logger :get-signature("logevent") <> ""
       66       then do:
       67         run vss-get-parameters in this-procedure
       68           (output v-vssrevis-parameters
       69           ).
       70         run logevent in v-vssrevis-logger
       71           (input vss-workfile
       72           ,input vss-revision
       73           ,input v-vssrevis-parameters
       74           ,input p-extra-paramters
       75           ).
       76       end.
       77     end.
       78   end procedure.
       79   assign
       80     v-vssrevis-logger = g#vssrevis-logger
       81   .
       82   if  valid-handle(v-vssrevis-logger)
       83   and v-vssrevis-logger :get-signature("logevent") <> ""
       84   then do:
       85     assign
       86       v-vssrevis-logevent = true
       87     .
       88     run vss-logevent in this-procedure (input vss-description) .
       89   end.
       90   define variable v-db-num like ub.db.db-num no-undo.
       91   define variable v-base-code like ub.sysconf.host-code no-undo.
       92   define variable v-add-chg as character no-undo.
       93   define variable v-fin-vat-pc like ub.sysconf.fin-vat-pc no-undo.
       94   define variable v-fin-slt-pc like ub.sysconf.fin-slt-pc no-undo.
       95   define variable v-rest-sum-doc like ub.fin-ob-tax.sum-line-doc no-undo.
       96   define variable last-line like ub.fin-ob-tax.line-num no-undo.
       97   define variable v-change-tab-order as character no-undo .
       98   define buffer X_curr_sysconf for ub.sysconf.
       99   define buffer X_currency for ub.currency.
      100   define buffer X_contract for ub.contract.
      101   define new global shared variable g#language as character no-undo .
      102   if g#language <> '' and g#language <> 'rus':U then do:
      103     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      104   end.
      105   define new global shared variable g#library  as handle no-undo .
      106   define new global shared variable g#library2 as handle no-undo .
      107   define   shared variable g#auto as logical no-undo.
      108   define   shared variable g#news as logical no-undo.
      109   define   shared variable g#oxml as logical no-undo.
      110   define   shared variable g#esys as logical no-undo.
      111   define   shared variable g#news-source-db as integer no-undo.
      112   define   shared variable g#esys-source-esys as integer no-undo.
      113   define   shared variable g#db-num as integer   no-undo .
      114   define   shared variable g#userid as character no-undo .
      115   define   shared variable g#passwd as character no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable v-waitfram-action01         as character   no-undo .
      118   define variable v-waitfram-action02         as character   no-undo .
      119   define variable v-waitfram-action03         as character   no-undo .
      120   define variable mWaitFramTextBeg            as character   no-undo.
      121   define variable mWaitFramTextEnd            as character   no-undo.
      122   define variable mWaitFramView               as logical     no-undo.
      123   define variable mWaitProcEvent              as logical     no-undo init yes.
      124   define variable mWaitFramInterval           as integer     no-undo init 1 .
      125   define variable mWaitFramStop               as logical     no-undo.
      126   define variable mWaitFramStopUser           as logical     no-undo.
      127   define variable mWaitFramStopTimeOut        as logical     no-undo.
      128   define variable mWaitFramStartProc          as datetime-tz no-undo.
      129   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      130   define button B-WaitFramStop auto-end-key
      131        label "Стоп"
      132        size 10 by 1 tooltip "Остоновить процесс".
      133   define button B-viewProcInfo
      134        label "Информация"
      135        size 15 by 1 tooltip "Информация о процесс".
      136   define frame waitfram
      137     v-waitfram-action01 format "x(72)" no-label skip
      138     v-waitfram-action02 format "x(72)" no-label skip
      139     v-waitfram-action03 format "x(72)" no-label skip
      140     B-viewProcInfo
      141     B-WaitFramStop at row 4 col 30
      142     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      143     .
      144   define new global shared variable mBatchMode as logical no-undo init ?.
      145   define variable mFramBachModHandle as handle no-undo.
      146   mFramBachModHandle = frame waitfram:handle.
      147   define variable mFameOldVis as logical no-undo.
      148   define variable mVisCUrentVin as logical no-undo.
      149   if session:batch-mode
      150   then
      151      mBatchMode = yes.
      152   if mBatchMode = ? then do:
      153     mVisCUrentVin = current-window:visible.
      154     mFameOldVis = mFramBachModHandle:visible.
      155     mFramBachModHandle:visible  = yes.
      156     mBatchMode = mFramBachModHandle:visible ne yes.
      157     mFramBachModHandle:visible = mFameOldVis.
      158     current-window:visible = mVisCUrentVin.
      159   end.
      160    if  log-manager:logfile-name ne ?
      161     then DO:
      162         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      163         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      164         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      165     end.
      166   on choose of B-WaitFramStop in frame waitfram
      167   do:
      168     mWaitFramStop = yes.
      169     mWaitFramStopUser = yes.
      170   end.
      171   function waitfram-check-timeout returns logical():
      172      define variable vtime as int64 no-undo.
      173      if mWaitFramStopTimeOut
      174      then
      175         return yes.
      176      vtime = ( now - mWaitFramStartProc ) / 1000 .
      177      if     mWaitFramTimeOut ne ?
      178         and mWaitFramTimeOut ne 0
      179         and mWaitFramTimeOut lt vtime
      180      then do:
      181         mWaitFramStopTimeOut = yes.
      182      end.
      183      return mWaitFramStopTimeOut.
      184   end.
      185   procedure waitfram-hide :
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       pause 0 before-hide .
      191       if not mBatchMode then
      192         hide frame waitfram .
      193     if     not mWaitFramView
      194        and mWaitProcEvent
      195     then
      196       process events .
      197     end.
      198   end procedure.
      199   procedure waitfram-show :
      200     define input  parameter p-message as character no-undo .
      201     define variable v-left-margin as integer   no-undo .
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       if length(p-message) <= 70 then do:
      207         assign
      208           v-left-margin = integer((70 - length(p-message)) / 2)
      209         .
      210         assign
      211           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      212         .
      213         assign
      214           v-waitfram-action01 = " "
      215           v-waitfram-action02 = " "
      216                                    + fill(" ", v-left-margin)
      217                                    + p-message
      218           v-waitfram-action03 = " "
      219         .
      220       end.
      221       else do:
      222         define variable vRindex1 as integer no-undo.
      223         define variable vRindex2 as integer no-undo.
      224         vRindex1 = r-index(p-message," ",70).
      225         if vRindex1 = 0
      226         then
      227            vRindex1 = 70.
      228         if length(p-message)  <= vRindex1 + 70 then do:
      229           assign
      230             v-waitfram-action01 = " "
      231             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      232             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      233           .
      234         end.
      235         else do:
      236           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      237           if vRindex2 <= vRindex1
      238           then
      239              vRindex2 = vRindex1 + 70.
      240           assign
      241             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      244           .
      245         end.
      246       end.
      247       B-viewProcInfo:visible   in frame waitfram = no.
      248       B-viewProcInfo:sensitive in frame waitfram = no.
      249       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      251       if  (   mWaitFramView
      252          or  mWaitProcEvent)
      253          and not mBatchMode
      254       then
      255          display
      256             v-waitfram-action01 skip
      257             v-waitfram-action02 skip
      258             v-waitfram-action03 skip
      259          with frame waitfram .
      260       if     mWaitFramView
      261          then do:
      262             if     mWaitFramInterval ne ?
      263                and not mBatchMode
      264             then
      265                wait-for go of frame waitfram pause mWaitFramInterval.
      266          end.
      267          else
      268             if     mWaitProcEvent
      269                and not mBatchMode
      270             then
      271                process events .
      272     end.
      273   end procedure.
      274      procedure waitfram-show-this:
      275         define input  parameter iInterval as int64 no-undo.
      276         define variable vtime as int64 no-undo.
      277         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      278         mWaitFramInterval = iInterval.
      279         run waitfram-show (substitute("&1&2 &3&4" ,
      280                                       mWaitFramTextBeg ,
      281                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      282                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      283                                       mWaitFramTextEnd
      284                                      )
      285                           ).
      286      end.
      287      procedure WaitFramRunPause:
      288         define input  parameter iInterval as dec no-undo.
      289         define variable vStart  as datetime-tz no-undo.
      290         define variable vend    as datetime-tz no-undo.
      291         define variable vint as int64 no-undo.
      292         define variable vOk as logical no-undo.
      293         vStart = now.
      294         vend   = vStart.
      295         publish "WaitFramPause" (iInterval,output vOk).
      296         vend   =  now.
      297         vint = vend - vStart.
      298         vint = iInterval - vint / 1000.
      299         if     not mWaitFramStop
      300            and (   vint > 0
      301                 or (    not vOk
      302                     and iInterval eq ?
      303                     )
      304                 )
      305         then
      306            run waitfram-show-this (iInterval).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and vint > 0
      312         then do:
      313            run gbl/pause.p (vint * 1000).
      314         end.
      315         if iInterval ne ?
      316         then
      317            publish "WaitFramStop".
      318         waitfram-check-timeout().
      319      end.
      320      procedure WaitFramWaitFor:
      321         define input  parameter iInterval as dec no-undo.
      322         assign
      323            mWaitFramStartProc   = now
      324            mWaitFramStopUser    = no
      325            mWaitFramStopTimeOut = no
      326         .
      327         block-wait:
      328         do while not mWaitFramStop:
      329            run WaitFramRunPause (iInterval).
      330            if  waitfram-check-timeout()
      331            then do:
      332               leave block-wait.
      333            end.
      334         end.
      335         run waitfram-hide.
      336      end.
      337   procedure waitfram-join :
      338     define input  parameter p-line-1  as character no-undo .
      339     define input  parameter p-line-2  as character no-undo .
      340     define input  parameter p-line-3  as character no-undo .
      341     define output parameter p-message as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       assign
      346         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      348                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      349       .
      350     end.
      351   end procedure.
      352   function waitfram-join-function returns character
      353     (input p-line-1 as character
      354     ,input p-line-2 as character
      355     ,input p-line-3 as character
      356     ).
      357     define variable v-message as character no-undo .
      358     run waitfram-join in this-procedure
      359       (input  p-line-1
      360       ,input  p-line-2
      361       ,input  p-line-3
      362       ,output v-message
      363       ) .
      364     return v-message .
      365   end function .
      366   procedure proc-alt-shift-f2:
      367     if not ibs.th.gbl.gbl-var:rcode
      368   then
      369     run gbl\inidebug.p .
      370   end.
      371   procedure proc-alt-shift-f3:
      372     run gbl/prvssinf.p
      373       ( input this-procedure
      374       ) .
      375   end.
      376   define variable v-inform-launched as logical no-undo initial false .
      377   procedure proc-alt-shift-f4:
      378     define variable v-action as character no-undo .
      379     if v-inform-launched = false then do:
      380       assign
      381         v-inform-launched = true
      382       .
      383       run gbl/d-inform.w
      384         (  input self
      385         ,  input this-procedure
      386         , output v-action
      387         ) no-error .
      388       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      389       assign
      390         v-inform-launched = false
      391       .
      392     end.
      393   end.
      394   procedure proc-alt-f1:
      395     run gbl/corrhelp.p
      396       (input this-procedure
      397       ) .
      398   end .
      399   on alt-shift-f2 anywhere do:
      400     run proc-alt-shift-f2.
      401   end.
      402   on alt-shift-f3 anywhere do:
      403     run proc-alt-shift-f3 in this-procedure .
      404   end.
      405   on alt-shift-f4 anywhere do:
      406     run proc-alt-shift-f4 in this-procedure.
      407   end.
      408   on alt-f1 anywhere do:
      409     run proc-alt-f1 in this-procedure .
      410   end.
      411   define temp-table tt-fix no-undo
