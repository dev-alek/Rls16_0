      689     run disable-enable in this-procedure("vat-pc":U).
      690   END.
      691   ON VALUE-CHANGED OF T-vatsum IN FRAME Dialog-Frame
      692   DO:
      693   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   if lookup(self :type
      695            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      696            ) = 0
      697   then do:
      698     message
      699       "$Workfile$"
      700       "Указанному интерфейсному элементу фокус не может быть передан" skip
      701       "Интерфейсный элемент" self :name  skip
      702       "Тип" self :type  skip
      703       "Процедура" this-procedure :file-name skip
      704       view-as alert-box .
      705   end.
      706   else do:
      707     apply "entry":u to self  .
      708     if focus :handle <> self :handle  then do:
      709       return no-apply .
      710     end.
      711   end.
      712     assign
      713     t-vatsum.
      714     run disable-enable in this-procedure("vat-sum":U).
      715   END.
      716   ON VALUE-CHANGED OF T-with-slt IN FRAME Dialog-Frame
      717   DO:
      718     assign
      719     t-with-slt.
      720     run with-without in this-procedure ("slt":U, t-with-slt).
      721     run recalc-sums in this-procedure("sum-doc":U).
      722   END.
      723   ON VALUE-CHANGED OF T-with-vat IN FRAME Dialog-Frame
      724   DO:
      725     assign
      726     t-with-vat.
      727     run with-without in this-procedure ("vat":U, t-with-vat).
      728       run recalc-sums in this-procedure("sum-doc":U).
      729   END.
      730   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      731   on help of frame Dialog-Frame
      732   do:
      733     run gbl/app_help.p
      734       (input this-procedure :file-name
      735       ,input ''
      736       ,input ?
      737       ) no-error.
      738     if error-status :error then do:
      739       message
      740         "Ошибка при вызове помощи"
      741         error-status :get-message(1)
      742         view-as alert-box .
      743     end.
      744   end.
      745   run minbtn-set in this-procedure .
      746   on choose of b-help in frame Dialog-Frame
      747   do:
      748     apply "help":u to frame Dialog-Frame .
      749   end.
      750   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751   procedure minbtn-set :
      752       do
      753           on error undo, return error return-value
      754           :
      755           define variable ii              as integer       no-undo .
      756           define variable fh              as widget-handle no-undo .
      757           define variable hh              as widget-handle no-undo .
      758           define variable v-h             as handle        extent 4 no-undo .
      759           define variable v-name-button   as character     no-undo .
      760           define variable v-help-old-x    as decimal       no-undo .
      761           define variable v-help-old-y    as decimal       no-undo .
      762           define variable v-help-old-size as decimal       no-undo .
      763           define variable v-frame-width   as decimal       no-undo .
      764           define variable jj              as integer       no-undo .
      765           do
      766               on error undo, return error
      767               :
      768               assign
      769                   v-frame-width = frame Dialog-Frame:width - 0.3
      770                   fh            = frame Dialog-Frame:first-child
      771                   hh            = fh:first-child
      772                   ii            = 1
      773                   .
      774               do while valid-handle(hh):
      775                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      776                   do:
      777                       case lc(hh:name) :
      778                           when "b-help" then
      779                               do:
      780                                   hh:load-image-up("cmp/b-help.bmp":u) .
      781                                   hh:load-image-down("cmp/b-help.bmp":u) .
      782                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      783                                   hh:TOOLTIP = "Помощь" .
      784                                   v-help-old-x = hh:column .
      785                                   v-help-old-y = hh:row    .
      786                                   v-help-old-size = hh:width .
      787                                   hh:width-chars = 2.5 .
      788                               end.
      789                           when "b-print" then
      790                               do:
      791                                   hh:load-image("cmp/b-print.bmp":u) .
      792                                   hh:TOOLTIP = "Печать" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-history" or
      798                           when "b-hist" then
      799                               do:
      800                                   hh:load-image("cmp/b-hist.bmp":u) .
      801                                   hh:TOOLTIP = "История" .
      802                                   v-h[ii] = hh:handle .
      803                                   ii = ii + 1 .
      804                                   hh:width-chars = 3 .
      805                               end.
      806                           when "b-sch" then
      807                               do:
      808                                   hh:load-image("cmp/b-sch.bmp":u) .
      809                                   hh:TOOLTIP = "Установка Фильтра" .
      810                                   v-h[ii] = hh:handle .
      811                                   ii = ii + 1 .
      812                                   hh:width-chars = 3 .
      813                               end.
      814                           when "b-hist-user" then
      815                               do:
      816                                   hh:load-image("cmp/b-hist.bmp":u) .
      817                                   hh:TOOLTIP = "История пользователя" .
      818                                   ii = ii + 1 .
      819                               end.
      820                       end case.
      821                   end.
      822                   hh = hh:next-sibling.
      823               end.
      824               b-help:column = v-frame-width - b-help:width-chars.
      825               jj = 0.
      826               repeat ii = 4 to 1 by -1 :
      827                   if valid-handle (v-h[ii] ) then
      828                   do:
      829                       jj  = jj + 1 .
      830                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      831                       v-h[ii]:row    = v-help-old-y .
      832                   end.
      833               end.
      834           end.
      835       end.
      836   end procedure.
      837   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      838   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      839   MAIN-BLOCK:
      840   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      841      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      842     if p-mode <> 'ИЗМЕНЕНИЕ':U
      843     and p-mode <> 'ПРОСМОТР':U
      844     and p-mode <> 'ДОБАВЛЕНИЕ':U
      845     and p-mode <> ('ПРОСМОТР':U + chr(4) + "history":U)
      846     then do:
      847       message
      848       vss-workfile vss-revision vss-description skip
      849       "Неверное значение параметров вызова p-mode"  p-mode
      850       view-as alert-box ERROR.
      851       undo, return error.
      852     end.
      853   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      855     (output v-db-num
      856     )  .
      857   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      859     (input  p-host-code
      860     ,output v-base-code
      861     )  .
      862       find first X_curr_sysconf no-lock where
      863                       X_curr_sysconf.host-code = p-curr-host-code.
      864       find first X_sysconf no-lock where
      865                     X_sysconf.host-code = p-host-code.
      866      assign
      867       v-fin-vat-pc = X_sysconf.fin-vat-pc
      868       v-fin-slt-pc = X_sysconf.fin-slt-pc
      869       .
      870       find first X_clients-host no-lock where
      871                 X_clients-host.obj-type = 'орг':U
      872             AND X_clients-host.obj-code = p-host-code.
      873     if p-doc-type = 'рас':U then do:
      874         if LOOKUP('ПРОСМОТР':U , p-mode, chr(4)) = 0
      875           then do:
      876           if X_curr_sysconf.host-code <> p-host-code
      877           or (v-db-num <> X_sysconf.firm-db-num)
      878           then do:
      879             message
      880             vss-workfile vss-revision vss-description skip
      881             "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code skip
      882             X_sysconf.firm-db-num
      883             v-db-num
      884             view-as alert-box ERROR.
      885             undo, return error.
      886           end.
      887         end.
      888     end.
      889     if p-mode = ('ПРОСМОТР':U + chr(4) + "history":U)
      890     then do:
      891     end.
      892     else do:
      893       run get-rest-sum in this-procedure(output v-rest-sum-doc).
      894       run proc-b-add-chg in this-procedure ( p-mode) .
      895     end.
      896     find first X_currency no-lock where
      897                  X_currency.curr-code = p-curr-code.
      898     run myenable.
      899     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS f-sum-doc.
      900   END.
      901   run disable_ui.
      902   PROCEDURE check-sums :
      903   END PROCEDURE.
      904   PROCEDURE disable-enable :
      905   define input parameter p-main-widget as character no-undo.
      906   CASE p-main-widget:
      907     when "vat-sum" then do:
      908       assign
      909           T-vatpc = no.
      910           enable
      911             t-vatpc
      912             f-sum-vat
      913             with frame Dialog-Frame.
      914           disable
      915             t-vatsum
      916             f-vat-pc
      917             with frame Dialog-Frame.
      918     end.
      919       when "slt-sum" then do:
      920         assign
      921           T-sltpc = no.
      922           enable
      923             t-sltpc
      924             f-sum-slt
      925             with frame Dialog-Frame.
      926           disable
      927               t-sltsum
      928               f-slt-pc
      929               with frame Dialog-Frame.
      930     end.
      931     when "vat-pc" then do:
      932       assign
      933           T-vatsum = no.
      934           enable
      935             t-vatsum
      936             f-vat-pc
      937             with frame Dialog-Frame.
      938           disable
      939           t-vatpc
      940           f-sum-vat
      941           with frame Dialog-Frame.
      942     end.
      943     when "slt-pc" then do:
      944           assign
      945           T-sltsum = no.
      946           enable
      947           t-sltsum
      948           f-slt-pc
      949           with frame Dialog-Frame.
      950           disable
      951           t-sltpc
      952           f-sum-slt
      953           with frame Dialog-Frame.
      954     end.
      955   END CASE.
      956   display
      957   T-sltpc
      958   T-sltsum
      959   T-vatpc
      960   T-vatsum
      961   with frame Dialog-Frame.
      962   END PROCEDURE.
      963   PROCEDURE disable_UI :
      964     HIDE FRAME Dialog-Frame.
      965   END PROCEDURE.
      966   PROCEDURE enable_UI :
      967     DISPLAY f-all-sum-doc f-sum-doc T-with-slt f-slt-pc f-sum-slt T-sltpc T-sltsum
      968             T-with-vat f-vat-pc f-sum-vat T-vatpc T-vatsum f-curr-abbr F-curr-code
      969         WITH FRAME Dialog-Frame.
      970     ENABLE B-Help B-exit b-quit f-sum-doc T-with-slt f-slt-pc T-sltpc T-with-vat
      971            f-vat-pc T-vatpc F-curr-code
      972         WITH FRAME Dialog-Frame.
      973     VIEW FRAME Dialog-Frame.
      974   END PROCEDURE.
      975   PROCEDURE fill-tables :
      976   define buffer buf_fin-ob-tax for ub.fin-ob-tax.
      977   define buffer buf_c-fin-ob-tax for ub.c-fin-ob-tax.
      978   define buffer buf_tt-fin-ob-tax for tt-fin-ob-tax.
      979   do on error undo, return error:
      980     if p-mode = 'ПРОСМОТР':U + chr(4) + "History":U then do:
      981     end.
      982     else do:
      983     end.
      984     run get-rest-sum in this-procedure ( output v-rest-sum-doc).
      985   end.
      986   END PROCEDURE.
      987   PROCEDURE get-rest-sum :
      988   define output parameter p-rest-sum like ub.fin-ob-tax.sum-line-doc no-undo.
      989   define buffer buf_tt-fin-ob-tax for tt-fin-ob-tax.
      990   for each buf_tt-fin-ob-tax  where  recid(buf_tt-fin-ob-tax) <> p-recid :
      991       assign
      992       p-rest-sum = p-rest-sum + buf_tt-fin-ob-tax.sum-line-doc
      993       .
      994   end.
      995   assign
      996   p-rest-sum = p-sum-doc - p-rest-sum
      997   .
      998   if p-rest-sum < 0 then do : p-rest-sum = 0.
      999   end.
     1000   END PROCEDURE.
     1001   PROCEDURE Myenable :
     1002   assign
     1003   frame Dialog-Frame:title = frame Dialog-Frame:title + " фирма " + x_clients-host.obj-name + "  - " + caps(p-mode)
     1004   b-quit:label = (if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then "&Выход" else b-quit:label)
     1005   t-with-slt = yes
     1006   t-with-vat = yes
     1007   t-sltpc = yes
     1008   t-vatpc = yes
     1009   t-sltsum = no
     1010   t-vatsum = no
     1011   .
     1012   DISPLAY
     1013   p-sum-doc @ f-all-sum-doc
     1014   p-curr-code @ f-curr-code
     1015   X_currency.curr-abbr @ f-curr-abbr
     1016   WITH FRAME Dialog-Frame.
     1017   ENABLE
     1018   b-quit
     1019   B-exit when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     1020   B-Help
     1021   WITH FRAME Dialog-Frame.
     1022   if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then do:
     1023     hide
     1024     b-exit
     1025     in frame Dialog-Frame .
     1026   end.
     1027   VIEW FRAME Dialog-Frame.
     1028   END PROCEDURE.
     1029   PROCEDURE next-focus :
     1030   do
     1031    on error undo, return error return-value
     1032    :
     1033     define input parameter p-widget-handle as handle no-undo .
     1034     define variable l-apply-entry as logical no-undo .
     1035     assign
     1036       l-apply-entry =   true
     1037     .
     1038        do with frame Dialog-Frame :
     1039             if  f-sum-doc          :handle = p-widget-handle then do:
     1040                 if f-slt-pc  :sensitive then do: apply "entry":u to f-slt-pc  .  return . end.
     1041                 if f-sum-slt :sensitive then do: apply "entry":u to f-sum-slt .  return . end.
     1042                 if f-vat-pc  :sensitive then do: apply "entry":u to f-vat-pc  .  return . end.
     1043                 if f-sum-vat :sensitive then do: apply "entry":u to f-sum-vat .  return . end.
     1044                 if B-exit    :sensitive then do: apply "entry":u to B-exit    .  return . end.
     1045             end.
     1046             if  f-slt-pc           :handle = p-widget-handle then do:
     1047               if f-sum-slt :sensitive then do: apply "entry":u to f-sum-slt .  return . end.
     1048               if f-vat-pc  :sensitive then do: apply "entry":u to f-vat-pc  .  return . end.
     1049               if f-sum-vat :sensitive then do: apply "entry":u to f-sum-vat .  return . end.
     1050               if B-exit    :sensitive then do: apply "entry":u to B-exit    .  return . end.
     1051             end.
     1052             if  f-sum-slt          :handle = p-widget-handle then do:
     1053                 if f-vat-pc  :sensitive then do: apply "entry":u to f-vat-pc  .  return . end.
     1054                 if f-sum-vat :sensitive then do: apply "entry":u to f-sum-vat .  return . end.
     1055                 if B-exit    :sensitive then do: apply "entry":u to B-exit    .  return . end.
     1056             end.
     1057             if  f-vat-pc           :handle = p-widget-handle then do:
     1058                 if f-sum-vat :sensitive then do: apply "entry":u to f-sum-vat .  return . end.
     1059                 if B-exit    :sensitive then do: apply "entry":u to B-exit    .  return . end.
     1060             end.
     1061             if  f-sum-vat          :handle = p-widget-handle then do:
     1062                 if B-exit    :sensitive then do: apply "entry":u to B-exit    .  return . end.
     1063             end.
     1064       end.
     1065     end.
     1066   END PROCEDURE.
     1067   PROCEDURE proc-b-add-chg :
     1068   define input parameter p-mode as character no-undo.
     1069   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1070       assign
     1071       f-slt-pc     =  p-slt-pc
     1072       f-sum-doc    =  p-sum-line-doc
     1073       f-sum-vat    =  p-sum-vat-line-doc
     1074       f-sum-slt    =  p-sum-slt-line-doc
     1075       f-vat-pc     =  p-vat-pc
     1076       T-with-slt   =  p-with-slt
     1077       T-with-vat   =  p-with-vat
     1078       .
     1079   end.
     1080   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1081       assign
     1082       f-vat-pc     = v-fin-vat-pc
     1083       f-slt-pc     = v-fin-slt-pc
     1084       f-sum-doc    = v-rest-sum-doc
     1085       T-with-slt   = yes
     1086       T-with-vat   = yes
     1087       f-sum-slt    = f-sum-doc * f-slt-pc / ( 100 + f-slt-pc)
     1088       f-sum-vat    = (f-sum-doc -  f-sum-slt ) * f-vat-pc / ( 100 + f-vat-pc)
     1089       .
     1090   end.
     1091   display
     1092   f-slt-pc
     1093   f-sum-doc
     1094   f-sum-vat
     1095   f-sum-slt
     1096   f-vat-pc
     1097   T-sltpc
     1098   T-sltsum
     1099   T-vatpc
     1100   T-vatsum
     1101   T-with-slt
     1102   T-with-vat
     1103   with frame Dialog-Frame.
     1104   disable
     1105   b-exit
     1106   t-sltpc
     1107   t-vatpc
     1108   with frame Dialog-Frame.
     1109   enable
     1110   f-sum-doc
     1111   f-vat-pc   when T-with-vat = true
     1112   f-slt-pc   when T-with-slt = true
     1113   T-sltsum   when T-with-slt = true
     1114   T-vatsum   when T-with-vat = true
     1115   T-with-slt
     1116   T-with-vat
     1117   with frame Dialog-Frame.
     1118   APPLY "ENTRY" to f-sum-doc.
     1119   END PROCEDURE.
     1120   PROCEDURE recalc-sums :
     1121   define input parameter p-main-widget as character no-undo.
     1122   define variable v-line-num like ub.fin-ob-tax.line-num no-undo.
     1123   define buffer buf_tt-fin-ob-tax for tt-fin-ob-tax.
     1124   case v-add-chg:
     1125     when 'ИЗМЕНЕНИЕ':U then do:
     1126       assign
     1127       v-line-num = tt-fin-ob-tax.line-num
     1128       .
     1129     end.
     1130     when 'ДОБАВЛЕНИЕ':U then do:
     1131       assign
     1132       v-line-num = last-line
     1133       .
     1134     end.
     1135    END CASE.
     1136   CASE p-main-widget :
     1137       when "sum-doc":U then do:
     1138         assign
     1139         f-sum-slt = f-sum-doc * f-slt-pc / ( 100 + f-slt-pc)
     1140         f-sum-vat =  (f-sum-doc - f-sum-slt ) * f-vat-pc / ( 100 + f-vat-pc)
     1141         .
     1142       end.
     1143       when "slt-pc":U then do:
     1144         assign
     1145         f-sum-slt = f-sum-doc * f-slt-pc / ( 100 + f-slt-pc)
     1146         .
     1147       end.
     1148       when "vat-pc":U then do:
     1149         assign
     1150         f-sum-vat =  (f-sum-doc - f-sum-slt ) * f-vat-pc / ( 100 + f-vat-pc)
     1151         .
     1152       end.
     1153       when "sum-slt":U then do:
     1154         assign
     1155         f-slt-pc = f-sum-slt / (f-sum-doc - f-sum-slt ) * 100
     1156         f-sum-vat =  (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     1157         .
     1158       end.
     1159       when "sum-vat":U then do:
     1160         assign
     1161         f-vat-pc = f-sum-vat / (f-sum-doc - f-sum-slt - f-sum-vat ) * 100
     1162         .
     1163       end.
     1164   END CASE.
     1165   if abs( f-sum-vat + f-sum-slt) >= abs( f-sum-doc)  then do:
     1166     message
     1167     "Сумма налогов больше налогооблагаемой суммы + налоги!"
     1168     view-as alert-box error .
     1169     return error.
     1170   end.
     1171   display
     1172   f-slt-pc
     1173   f-sum-doc
     1174   f-sum-vat
     1175   f-sum-slt
     1176   f-vat-pc
     1177   with frame Dialog-Frame.
     1178   END PROCEDURE.
     1179   PROCEDURE with-without :
     1180   define input parameter p-widget as character no-undo.
     1181   define input parameter p-on as logical no-undo.
     1182   CASE p-widget:
     1183     when "slt":U then do:
     1184       CASE p-on:
     1185         when yes then do:
     1186           assign
     1187             f-slt-pc     = v-fin-slt-pc
     1188             T-with-slt   = yes
     1189             f-sum-slt    = f-sum-doc * f-slt-pc / 100
     1190             T-sltsum = false
     1191             t-sltpc  = true
     1192           .
     1193           display
     1194             f-slt-pc
     1195             f-sum-slt
     1196             t-with-slt
     1197             T-sltsum
     1198             t-sltpc
     1199           with frame Dialog-Frame.
     1200           enable
     1201             f-slt-pc
     1202             T-sltsum
     1203           with frame Dialog-Frame.
     1204           disable
     1205             f-sum-slt
     1206             t-sltpc
     1207           with frame Dialog-Frame.
     1208         end.
     1209         when no then do:
     1210           assign
     1211           f-slt-pc = 0
     1212           .
     1213           display
     1214           f-slt-pc
     1215           with frame Dialog-Frame.
     1216           apply "LEAVE" to f-slt-pc.
     1217           disable
     1218           f-slt-pc
     1219           f-sum-slt
     1220           T-sltpc
     1221           T-sltsum
     1222           with frame Dialog-Frame.
     1223         end.
     1224       END CASE.
     1225     end.
     1226     when "vat":U then do:
     1227       CASE p-on:
     1228         when yes then do:
     1229           assign
     1230           f-vat-pc     = v-fin-vat-pc
     1231           T-with-vat   = yes
     1232           f-sum-vat    = (f-sum-doc - f-sum-slt) * f-vat-pc / 100
     1233           T-vatsum = false
     1234           t-vatpc  = true
     1235           .
     1236           display
     1237           f-vat-pc
     1238           f-sum-vat
     1239           t-with-vat
     1240           T-vatsum
     1241           t-vatpc
     1242           with frame Dialog-Frame.
     1243           enable
     1244           f-vat-pc
     1245           T-vatsum
     1246           with frame Dialog-Frame.
     1247           disable
     1248           f-sum-vat
     1249           t-vatpc
     1250           with frame Dialog-Frame.
     1251         end.
     1252         when no then do:
     1253           assign
     1254           f-vat-pc = 0
     1255           .
     1256           display
     1257           f-vat-pc
     1258           with frame Dialog-Frame.
     1259           apply "LEAVE" to f-vat-pc.
     1260           disable
     1261           f-vat-pc
     1262           f-sum-vat
     1263           T-vatpc
     1264           T-vatsum
     1265           with frame Dialog-Frame.
     1266         end.
     1267       END CASE.
     1268     end.
     1269   END CASE.
     1270   END PROCEDURE.
