     1428             .
     1429           end.
     1430         end.
     1431       end.
     1432     end.
     1433     else do:
     1434       if buf_contract.pay-nal = yes then do:
     1435         if buf_contract.doc-type = 'при':U then do:
     1436           if tt-fin-doc.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рко':U .
