        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter p-host-code    as integer   no-undo .
        4   define input  parameter p-ri as recid no-undo .
        5   define variable  vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        6   define variable  vss-author      as character no-undo init "$Author: expertek $":u .
        7   define variable  vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        8   define variable  vss-workfile    as character no-undo init "$Workfile: payfoavt.p $":u .
        9   define variable  vss-archive     as character no-undo init "$Archive: str/payfoavt.p $":u .
       10   define variable  vss-description as character no-undo init "Автомат. оплата фин. обязательств" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   procedure gen-b-code :
      299     define input  parameter type-code like ub.code-range.range-type no-undo .
      300     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      301     do
      302     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      303     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      304     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      305     :
      306       define buffer buf_thbj-attr     for ub.thbj-attr .
      307       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      308       define buffer buf_code-range for ub.code-range .
      309       define variable l-code         as   integer              no-undo .
      310       define variable v-db-num       like ub.db.db-num         no-undo .
      311       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      312       if type-code = 'sslc':U
      313       or type-code = 'ssgb':U
      314       then do:
      315         message
      316           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      317           "Обратитесь к администратору системы."
      318           view-as alert-box error .
      319         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      320       end.
      321       run trg/getpcode.p ( input  type-code
      322                      ,output cfg-param-code
      323                     ).
      324       run get-next-seq( input  type-code,
      325                         output l-code
      326                       ).
      327       find first buf_sys-ctrl no-lock.
      328       if type-code = 'sclc':U
      329       or type-code = 'pglc':U
      330       then do:
      331         assign
      332           v-db-num = 0
      333         .
      334       end.
      335       else do:
      336         assign
      337           v-db-num = buf_sys-ctrl.db-num
      338         .
      339       end.
      340       find first buf_code-range no-lock
      341         where buf_code-range.db-num     = v-db-num
      342           and buf_code-range.range-type = type-code
      343           and buf_code-range.stts       = "a"
      344         use-index stts
      345         no-error .
      346       if available buf_code-range
      347          and l-code <= buf_code-range.last-code
      348          and l-code >= buf_code-range.first-code then do:
      349         assign
      350           p-b-code = l-code
      351         .
      352       end.
      353       else do:
      354         if available buf_code-range
      355            and l-code < buf_code-range.last-code then do:
      356           message
      357             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      358             "Обратитесь к администратору системы."
      359             view-as alert-box error .
      360           undo, return error "sequence":U .
      361         end.
      362         do transaction
      363         on error undo, return error
      364         :
      365           find first buf_thbj-attr exclusive-lock
      366             where buf_thbj-attr.upper-prop-code = 'code-range':U
      367               and buf_thbj-attr.prop-code = cfg-param-code
      368               and buf_thbj-attr.obj-type   = 'БД':U
      369               and buf_thbj-attr.obj-code   = v-db-num
      370             no-error .
      371           if not available buf_thbj-attr then do:
      372             find first buf_thbj-attr exclusive-lock
      373               where buf_thbj-attr.upper-prop-code = 'code-range':U
      374                 and buf_thbj-attr.prop-code = cfg-param-code
      375                 and buf_thbj-attr.obj-type   = ''
      376                 and buf_thbj-attr.obj-code   = 0
      377               no-error .
      378             if not available buf_thbj-attr then do:
      379               if not locked buf_thbj-attr then do:
      380                 message
      381                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      382                   "Обратитесь к администратору системы."
      383                   view-as alert-box error .
      384               end.
      385               undo, return error "config":U .
      386             end.
      387           end.
      388           run get-next-seq( input type-code,
      389                             output l-code
      390                           ).
      391           find first buf_code-range
      392             where buf_code-range.db-num     = v-db-num
      393               and buf_code-range.range-type = type-code
      394               and buf_code-range.stts       = "a"
      395             use-index stts
      396             no-error .
      397           if available buf_code-range
      398           and l-code <= buf_code-range.last-code
      399           and l-code >= buf_code-range.first-code
      400           then do:
      401             assign
      402               p-b-code = l-code
      403             .
      404           end.
      405           else do:
      406             if available buf_code-range then do:
      407               assign
      408                 buf_code-range.stts = "u"
      409               .
      410             end.
      411             find first buf_code-range
      412               where buf_code-range.db-num     = v-db-num
      413                 and buf_code-range.range-type = type-code
      414                 and buf_code-range.stts       = "f"
      415               use-index stts
      416               no-error .
      417             if not available buf_code-range then do:
      418               message
      419                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      420                 "Обратитесь к администратору системы"
      421                 view-as alert-box error .
      422               undo, return error "code-range":U .
      423             end.
      424             assign
      425               buf_code-range.stts           = "a"
      426             .
      427             if buf_code-range.first-code = 1 then do:
      428               run set-seq-cr( input type-code,
      429                               input buf_code-range.first-code
      430                             ).
      431               assign
      432                 p-b-code = 1
      433               .
      434             end.
      435             else do:
      436               run set-seq-cr( input type-code,
      437                               input ( buf_code-range.first-code - 1 )
      438                             ).
      439               run get-next-seq( input type-code,
      440                                 output p-b-code
      441                               ).
      442             end.
      443           end.
      444         end.
      445       end.
      446     end.
      447   end procedure.
      448   procedure get-next-seq :
      449     define input  parameter type-code like ub.code-range.range-type no-undo .
      450     define output parameter next-seq  as   integer                  no-undo .
      451     do
      452     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      453     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      455     :
      456       case type-code:
      457         when 'bcgb':U then do:
      458           assign
      459             next-seq = next-value(s-bcgb-code, ub)
      460           .
      461         end.
      462         when 'scgb':U then do:
      463           assign
      464             next-seq = next-value(s-scgb-code, ub)
      465           .
      466         end.
      467         when 'sclc':U then do:
      468           assign
      469             next-seq = next-value(s-sclc-code, ub)
      470           .
      471         end.
      472         when 'pglc':U then do:
      473           assign
      474             next-seq = next-value(s-pglc-code, ub)
      475           .
      476         end.
      477         when 'dcgb':U then do:
      478           assign
      479             next-seq = next-value(s-dcgb-code, ub)
      480           .
      481         end.
      482         when 'ctgb':U then do:
      483           assign
      484             next-seq = next-value(s-ctgb-code, ub)
      485           .
      486         end.
      487         when 'drgb':U then do:
      488           assign
      489             next-seq = next-value(s-drgb-code, ub)
      490           .
      491         end.
      492         when 'fmgb':U then do:
      493           assign
      494             next-seq = next-value(s-fmgb-code, ub)
      495           .
      496         end.
      497         when 'pngb':U then do:
      498           assign
      499             next-seq = next-value(s-pngb-code, ub)
      500           .
      501         end.
      502         when 'cagb':U then do:
      503           assign
      504             next-seq = next-value(s-cagb-code, ub)
      505           .
      506         end.
      507         when 'fdgb':U then do:
      508           assign
      509             next-seq = next-value(s-fin-doc, ub)
      510           .
      511         end.
      512       end case.
      513     end.
      514   end procedure.
      515   procedure set-seq-cr :
      516     define input parameter type-code like ub.code-range.range-type no-undo .
      517     define input parameter set-val   like ub.code-range.first-code no-undo .
      518     do
      519     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      520     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      521     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      522     :
      523       case type-code:
      524         when 'bcgb':U then do:
      525           assign
      526             current-value(s-bcgb-code, ub) = set-val
      527           .
      528         end.
      529         when 'scgb':U then do:
      530           assign
      531             current-value(s-scgb-code, ub) = set-val
      532           .
      533         end.
      534         when 'sclc':U then do:
      535           assign
      536             current-value(s-sclc-code, ub) = set-val
      537           .
      538         end.
      539         when 'pglc':U then do:
      540           assign
      541             current-value(s-pglc-code, ub) = set-val
      542           .
      543         end.
      544         when 'dcgb':U then do:
      545           assign
      546             current-value(s-dcgb-code, ub) = set-val
      547           .
      548         end.
      549         when 'ctgb':U then do:
      550           assign
      551             current-value(s-ctgb-code, ub) = set-val
      552           .
      553         end.
      554         when 'drgb':U then do:
      555           assign
      556             current-value(s-drgb-code, ub) = set-val
      557           .
      558         end.
      559         when 'fmgb':U then do:
      560           assign
      561             current-value(s-fmgb-code, ub) = set-val
      562           .
      563         end.
      564         when 'pngb':U then do:
      565           assign
      566             current-value(s-pngb-code, ub) = set-val
      567           .
      568         end.
      569         when 'cagb':U then do:
      570           assign
      571             current-value(s-cagb-code, ub) = set-val
      572           .
      573         end.
      574         when 'fdgb':U then do:
      575           assign
      576             current-value(s-fin-doc, ub) = set-val
      577           .
      578         end.
      579       end case.
      580     end.
      581   end procedure.
      582   procedure new-bcod-gen-code-range :
      583     do
      584     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      585     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      586     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      587     :
      588       define input parameter p-db-num  like ub.db.db-num             no-undo .
      589       define input parameter type-code like ub.code-range.range-type no-undo .
      590       define buffer buf_code-range      for ub.code-range .
      591       define buffer last_code-range     for ub.code-range .
      592       define buffer last-1_code-range   for ub.code-range .
      593       define buffer last-2_code-range   for ub.code-range .
      594       define buffer last-3_code-range   for ub.code-range .
      595       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      596       define variable conf-par       as character no-undo .
      597       define variable par-type       as character no-undo .
      598       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      599       define variable v-cre-cdrg as logical   no-undo .
      600       define variable v-cre-str  as character no-undo .
      601       define variable v-cr1      as integer no-undo .
      602       define variable v-cr2      as integer no-undo .
      603       define variable v-cr3      as integer no-undo .
      604       define variable v-cmax     as integer no-undo .
      605       find first buf_sys-ctrl no-lock .
      606       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      607         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      608                                       ,vss-workfile
      609                                       ,vss-revision
      610                                       ,vss-description
      611                                       ,chr(10)
      612                                       , p-db-num
      613                                      ).
      614       end.
      615       run trg/getpcode.p ( input  type-code
      616                      ,output cfg-param-code
      617                     ).
      618       for each buf_code-range
      619         where buf_code-range.db-num     = -1
      620           and buf_code-range.range-type = type-code
      621           and buf_code-range.stts       = "f"
      622       by buf_code-range.first-code
      623       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      624       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      625       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      626       :
      627         assign
      628           buf_code-range.db-num = p-db-num
      629         .
      630         return .
      631       end.
      632       assign
      633         v-cre-cdrg = TRUE
      634       .
      635       case type-code:
      636         when 'sclc':U
      637         or when 'scgb':U
      638         or when 'pglc':U
      639         then do:
      640           find last last-1_code-range no-lock
      641             where last-1_code-range.range-type = 'sclc':U
      642             no-error .
      643           if available last-1_code-range then do:
      644             v-cr1 = last-1_code-range.last-code.
      645           end.
      646           find last last-2_code-range no-lock
      647             where last-2_code-range.range-type = 'scgb':U
      648             no-error .
      649           if available last-2_code-range then do:
      650             v-cr2 = last-2_code-range.last-code.
      651             end.
      652           find last last-3_code-range no-lock
      653             where last-3_code-range.range-type = 'pglc':U
      654             no-error .
      655           if available last-3_code-range then do:
      656             v-cr3 = last-3_code-range.last-code.
      657           end.
      658           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      659           .
      660           if v-cmax = v-cr1  then do:
      661               find last last_code-range no-lock
      662                 where recid( last_code-range ) = recid( last-1_code-range )
      663                 .
      664             end.
      665           if v-cmax = v-cr2  then do:
      666               find last last_code-range no-lock
      667                 where recid( last_code-range ) = recid( last-2_code-range )
      668                 .
      669             end.
      670           if v-cmax = v-cr3  then do:
      671             find last last_code-range no-lock
      672               where recid( last_code-range ) = recid( last-3_code-range )
      673               .
      674           end.
      675           if last_code-range.last-code + 1 > 99999 then do:
      676             assign
      677               v-cre-cdrg = FALSE
      678             .
      679           end.
      680         end.
      681         when 'bcgb':U
      682         or when 'sslc':U
      683         or when 'ssgb':U
      684         then do:
      685           find last last-1_code-range no-lock
      686             where last-1_code-range.range-type = 'sslc':U
      687             no-error .
      688           if available last-1_code-range then do:
      689             v-cr1 = last-1_code-range.last-code.
      690           end.
      691           find last last-2_code-range no-lock
      692             where last-2_code-range.range-type = 'bcgb':U
      693             no-error .
      694           if available last-2_code-range then do:
      695             v-cr2 = last-2_code-range.last-code.
      696             end.
      697           find last last-3_code-range no-lock
      698             where last-3_code-range.range-type = 'ssgb':U
      699             no-error .
      700           if available last-3_code-range then do:
      701             v-cr3 = last-3_code-range.last-code.
      702           end.
      703           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      704           .
      705           if v-cmax = v-cr1  then do:
      706               find last last_code-range no-lock
      707                 where recid( last_code-range ) = recid( last-1_code-range )
      708                 .
      709             end.
      710           if v-cmax = v-cr2  then do:
      711               find last last_code-range no-lock
      712                 where recid( last_code-range ) = recid( last-2_code-range )
      713                 .
      714             end.
      715           if v-cmax = v-cr3  then do:
      716             find last last_code-range no-lock
      717               where recid( last_code-range ) = recid( last-3_code-range )
      718               .
      719           end.
      720         end.
      721         otherwise do:
      722           find last last_code-range no-lock
      723             where last_code-range.range-type = type-code
      724             no-error .
      725         end.
      726       end case.
      727       if not available last_code-range then do:
      728         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      729                                       ,vss-workfile
      730                                       ,vss-revision
      731                                       ,vss-description
      732                                       , chr(10)
      733                                       , type-code
      734                                      ) .
      735       end.
      736       define variable v-mes2 as character no-undo .
      737       define variable v-param-type2 as character no-undo .
      738       define variable v-value-character2 as INTEGER no-undo .
      739       define variable v-value-date2 as date no-undo .
      740       define variable v-value-decimal2 as decimal no-undo .
      741       define variable v-value-integer2 AS integer no-undo .
      742       define variable v-value-logical2 AS LOGICAL no-undo .
      743       define variable v-tth2 as handle no-undo .
      744       run adm/shattri.p (
      745           input "get":U
      746           ,input  'БД':U
      747           ,input  p-db-num
      748           ,input  'code-range':U
      749           ,input  cfg-param-code
      750           ,output v-value-character2
      751           ,output v-value-date2
      752           ,output v-value-decimal2
      753           ,output v-value-integer2
      754           ,output v-value-logical2
      755           ,output v-param-type2
      756           ,INPUT-OUTPUT table-handle v-tth2
      757           ) no-error .
      758       if error-status :error then do:
      759         delete object v-tth2.
      760         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      761                            , error-status:get-message(1)
      762                            , chr(10)
      763                            , return-value ).
      764         undo, return error v-mes2.
      765       end.
      766       delete object v-tth2.
      767       if v-cre-cdrg = TRUE then do:
      768         create buf_code-range .
      769         assign
      770           buf_code-range.db-num     = p-db-num
      771           buf_code-range.range-type = type-code
      772           buf_code-range.stts       = "f"
      773           buf_code-range.first-code = last_code-range.last-code + 1
      774           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      775           v-cre-str = "Свободный диапазон успешно создан"
      776         .
      777       end.
      778       else do:
      779         assign
      780           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      781                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      782         .
      783       end.
      784     end.
      785     return v-cre-str .
      786   end procedure.
      787   procedure gen-new-code-range-if-neces :
      788     define input parameter v-db-num           like ub.db.db-num             no-undo .
      789     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      790     define input parameter v-cur-code         as   integer                  no-undo .
      791     define input parameter v-g#news           as   logical                  no-undo .
      792     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      793     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      794     do
      795     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      796     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      797     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      798     :
      799       define variable l-code-range-exist as logical   no-undo init false .
      800       define variable v-db-for-send      as character no-undo .
      801       define buffer buf_code-range  for ub.code-range .
      802       define buffer buf1_code-range for ub.code-range .
      803       define buffer buf_db          for ub.db .
      804       find first buf_code-range
      805         where buf_code-range.range-type = v-range-type
      806           and buf_code-range.last-code >= v-cur-code
      807         use-index last-codei
      808         no-error .
      809       if
      810       (
      811          available buf_code-range
      812          and
      813         (buf_code-range.db-num = v-db-num
      814           and
      815         buf_code-range.first-code <= v-cur-code
      816         )
      817       or
      818         (
      819           v-range-type = 'drgb':U
      820           AND
      821           v-cur-code = 0
      822         )
      823      )
      824      then do:
      825         assign
      826           l-code-range-exist = true
      827         .
      828         if v-g#news
      829         and buf_code-range.stts = "f" then do:
      830           assign
      831             buf_code-range.stts = "u"
      832           .
      833         end.
      834       end.
      835       if not l-code-range-exist
      836          and v-g#news-source-db <> 0
      837       then do:
      838         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      839                                       ,vss-workfile
      840                                       ,vss-revision
      841                                       ,vss-description
      842                                       ,chr(10)
      843                                       ,v-db-num
      844                                       ,v-range-type
      845                                       ,v-cur-code
      846                                      ).
      847       end.
      848       if (not l-code-range-exist
      849           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      850          )
      851       and ( not can-find (first buf1_code-range no-lock
      852                           where buf1_code-range.db-num = v-db-num
      853                             and buf1_code-range.range-type = v-range-type
      854                             and buf1_code-range.stts = "f"
      855                          )
      856           )
      857       then do:
      858         if v-g#db-num = 0 then do:
      859           run new-bcod-gen-code-range in this-procedure
      860             (input v-db-num,
      861              input v-range-type
      862             ) no-error .
      863           if error-status :error then do:
      864             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      865                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      866                                           ,v-db-num
      867                                           ,v-range-type
      868                                           ,v-cur-code
      869                                           ,chr(10)
      870                                           ,error-status:get-message(1)
      871                                           ,return-value
      872                                          ).
      873           end.
      874         end.
      875         else do:
      876           if v-range-type = 'sclc':U
      877           or v-range-type = 'pglc':U
      878           then do:
      879             assign
      880               v-db-for-send = "":U
      881             .
      882             if v-g#db-num = 0 then do:
      883               for each buf_db no-lock
      884                 where buf_db.db-num > 0
      885                   and buf_db.db-num <> v-g#news-source-db
      886               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      887               :
      888                 assign
      889                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      890                 .
      891               end.
      892               assign
      893                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      894               .
      895             end.
      896             else do:
      897               if not v-g#news then do:
      898                 assign
      899                   v-db-for-send = "0":U
      900                 .
      901               end.
      902             end.
      903             run nws/cr-route.p ( input 'send-cmd':U
      904                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      905                                  "code-range":U + chr(1) +
      906                                  (if v-range-type = 'sclc':U
      907                                   then string( current-value(s-sclc-code, ub))
      908                                   else string( current-value(s-pglc-code, ub))
      909                                   ) + chr(1) +
      910                                   v-range-type)
      911                           ,input ?
      912                           ,input v-db-for-send
      913                           ) no-error .
      914             if error-status :error then do:
      915               undo, return error return-value.
      916             end.
      917           end.
      918         end.
      919       end.
      920     end.
      921   end procedure.
      922   procedure cre-loc-sc-code-range :
      923     define input parameter v-cur-code as integer no-undo .
      924   define input parameter p-cdrg-type as character no-undo .
      925     do
      926     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      927     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      928     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      929     :
      930       define buffer buf_code-range for ub.code-range .
      931       find first buf_code-range
      932            where buf_code-range.range-type = p-cdrg-type
      933              and buf_code-range.first-code >= v-cur-code
      934            no-error .
      935       if not available buf_code-range then do:
      936         run new-bcod-gen-code-range in this-procedure
      937           ( input 0,
      938             input p-cdrg-type
      939           ) no-error .
      940         if error-status :error then do:
      941           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      942                                          + "Код &2&1&3 &4"
      943                                         , chr(10)
      944                                         , v-cur-code
      945                                         , error-status:get-message(1)
      946                                         , return-value
      947                                        ) .
      948         end.
      949       end.
      950     end.
      951   end procedure.
      952   procedure mark-used-if-need :
      953   define input parameter p-cur-code as integer no-undo .
      954   define input parameter p-range-type like ub.code-range.range-type no-undo .
      955   define input parameter p-db-num like ub.code-range.db-num no-undo .
      956     do
      957     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      958     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      959     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      960     :
      961       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      962       define buffer buf_code-range for ub.code-range .
      963       assign
      964       v-db-num = if p-range-type = 'sclc':U
      965                  then 0
      966                  else p-db-num
      967       .
      968   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   define buffer locK-batchprocess3 for ub.batchprocess.
      970   run gbl/lock-prc.p
      971       (input 'lscc':U
      972       ,input 0
      973       ,input 0
      974       ,input 0
      975       ,input ""
      976       ,input ""
      977       ,input ""
      978       ,input (
      979               ",,,Вкл/выкл лок. вес. кодов"
      980              )
      981       ,input true
      982       ,buffer lock-batchprocess3
      983       ) no-error .
      984     if error-status :error then do:
      985       message
      986         vss-workfile vss-revision vss-description skip
      987         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      988         view-as alert-box error .
      989       undo, return error .
      990     end.
      991       find first buf_code-range
      992            where buf_code-range.range-type = p-range-type
      993              and buf_code-range.first-code >= p-cur-code
      994              and buf_code-range.last-code <= p-cur-code
      995              and buf_code-range.db-num = v-db-num
      996            no-error .
      997       if not available buf_code-range then do:
      998         message
      999           vss-workfile vss-revision vss-description skip
     1000           "Ошибка при создании поиске диапазона" skip
     1001           "База данных" p-db-num skip
     1002           "Код" p-cur-code skip
     1003           "Тип" p-range-type
     1004           error-status :get-message(1) skip
     1005           return-value skip
     1006           view-as alert-box error .
     1007         undo, return error .
     1008       end.
     1009       if buf_code-range.stts = "f":U then do:
     1010         assign
     1011         buf_code-range.stts = "u":U
     1012         .
     1013       end.
     1014     end.
     1015   end procedure.
     1016   do
     1017   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1018   :
     1019     DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
     1020     DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
     1021     DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax
     1022       INDEX pi1 vat-pc slt-pc with-vat with-slt
     1023     .
     1024     define temp-table tt0-payment no-undo like ub.payment.
     1025     define buffer b_fin-ob for ub.fin-ob .
     1026     define buffer buf_contract for ub.contract .
     1027     define buffer b1_fin-schet for ub.fin-schet .
     1028     define buffer b2_fin-schet for ub.fin-schet .
     1029   define variable vss-include-info4 as character format "X(65)" no-undo
     1030   initial "@(#)$Workfile$ $Revision$".
     1031   PROCEDURE StrTax :
     1032     do
     1033     on error undo, return error return-value
     1034     :
     1035       define input-output parameter str as character no-undo .
     1036       assign str = " В т.ч.: "  .
     1037       for each tt0-fin-doc-tax :
     1038         if tt0-fin-doc-tax.with-vat = no then next.
     1039         if str <> " В т.ч.: " then str = str + "," .
     1040         if tt-fin-doc.curr-code = 0 then
     1041           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1042         else
     1043           assign str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     1044       end.
     1045       if str = " В т.ч.: " then assign str = "" .
     1046     end.
     1047   END PROCEDURE.
     1048   PROCEDURE InvertCli :
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052         define variable payer-bank-name    like ub.fin-doc.payer-bank-name  .
     1053         define variable payer-bank-city    like ub.fin-doc.payer-bank-city  .
     1054         define variable payer-bik          like ub.fin-doc.payer-bik        .
     1055         define variable payer-c-schet      like ub.fin-doc.payer-c-schet    .
     1056         define variable payer-code         like ub.fin-doc.payer-code       .
     1057         define variable payer-code-schet   like ub.fin-doc.payer-code-schet .
     1058         define variable payer-inn          like ub.fin-doc.payer-inn        .
     1059         define variable payer-kpp          like ub.fin-doc.payer-kpp        .
     1060         define variable payer-name         like ub.fin-doc.payer-name       .
     1061         define variable payer-okpo         like ub.fin-doc.payer-okpo       .
     1062         define variable payer-passport     like ub.fin-doc.payer-passport   .
     1063         define variable payer-r-schet      like ub.fin-doc.payer-r-schet    .
     1064         define variable payer-type         like ub.fin-doc.payer-type       .
     1065         assign
     1066           tt-fin-doc.sum-rubl  = - tt-fin-doc.sum-rubl
     1067           tt-fin-doc.sum-base  = - tt-fin-doc.sum-base
     1068           tt-fin-doc.sum-doc   = - tt-fin-doc.sum-doc
     1069           tt-fin-doc.sum-contr = - tt-fin-doc.sum-contr
     1070           payer-bank-name      = tt-fin-doc.payer-bank-name
     1071           payer-bank-city      = tt-fin-doc.payer-bank-city
     1072           payer-bik            = tt-fin-doc.payer-bik
     1073           payer-c-schet        = tt-fin-doc.payer-c-schet
     1074           payer-code           = tt-fin-doc.payer-code
     1075           payer-code-schet     = tt-fin-doc.payer-code-schet
     1076           payer-inn            = tt-fin-doc.payer-inn
     1077           payer-kpp            = tt-fin-doc.payer-kpp
     1078           payer-name           = tt-fin-doc.payer-name
     1079           payer-okpo           = tt-fin-doc.payer-okpo
     1080           payer-passport       = tt-fin-doc.payer-passport
     1081           payer-r-schet        = tt-fin-doc.payer-r-schet
     1082           payer-type           = tt-fin-doc.payer-type
     1083           tt-fin-doc.payer-bank-name    = tt-fin-doc.receiver-bank-name
     1084           tt-fin-doc.payer-bank-city    = tt-fin-doc.receiver-bank-city
     1085           tt-fin-doc.payer-bik          = tt-fin-doc.receiver-bik
     1086           tt-fin-doc.payer-c-schet      = tt-fin-doc.receiver-c-schet
     1087           tt-fin-doc.payer-code         = tt-fin-doc.receiver-code
     1088           tt-fin-doc.payer-code-schet   = tt-fin-doc.receiver-code-schet
     1089           tt-fin-doc.payer-inn          = tt-fin-doc.receiver-inn
     1090           tt-fin-doc.payer-kpp          = tt-fin-doc.receiver-kpp
     1091           tt-fin-doc.payer-name         = tt-fin-doc.receiver-name
     1092           tt-fin-doc.payer-okpo         = tt-fin-doc.receiver-okpo
     1093           tt-fin-doc.payer-passport     = tt-fin-doc.receiver-passport
     1094           tt-fin-doc.payer-r-schet      = tt-fin-doc.receiver-r-schet
     1095           tt-fin-doc.payer-type         = tt-fin-doc.receiver-type
     1096           tt-fin-doc.receiver-bank-name =  payer-bank-name
     1097           tt-fin-doc.receiver-bank-city =  payer-bank-city
     1098           tt-fin-doc.receiver-bik       =  payer-bik
     1099           tt-fin-doc.receiver-c-schet   =  payer-c-schet
     1100           tt-fin-doc.receiver-code      =  payer-code
     1101           tt-fin-doc.receiver-code-schet = payer-code-schet
     1102           tt-fin-doc.receiver-inn       =  payer-inn
     1103           tt-fin-doc.receiver-kpp       =  payer-kpp
     1104           tt-fin-doc.receiver-name      =  payer-name
     1105           tt-fin-doc.receiver-okpo      =  payer-okpo
     1106           tt-fin-doc.receiver-passport  =  payer-passport
     1107           tt-fin-doc.receiver-r-schet   =  payer-r-schet
     1108           tt-fin-doc.receiver-type      =  payer-type
     1109         .
     1110         for each  tt0-fin-doc-tax no-lock :
     1111           assign
     1112             tt0-fin-doc-tax.sum-line-doc       = - tt0-fin-doc-tax.sum-line-doc
     1113             tt0-fin-doc-tax.sum-vat-line-doc   = - tt0-fin-doc-tax.sum-vat-line-doc
     1114             tt0-fin-doc-tax.sum-slt-line-doc   = - tt0-fin-doc-tax.sum-slt-line-doc
     1115             tt0-fin-doc-tax.sum-line-rubl      = - tt0-fin-doc-tax.sum-line-rubl
     1116             tt0-fin-doc-tax.sum-vat-line-rubl  = - tt0-fin-doc-tax.sum-vat-line-rubl
     1117             tt0-fin-doc-tax.sum-slt-line-rubl  = - tt0-fin-doc-tax.sum-slt-line-rubl
     1118             tt0-fin-doc-tax.sum-line-base      = - tt0-fin-doc-tax.sum-line-base
     1119             tt0-fin-doc-tax.sum-vat-line-base  = - tt0-fin-doc-tax.sum-vat-line-base
     1120             tt0-fin-doc-tax.sum-slt-line-base  = - tt0-fin-doc-tax.sum-slt-line-base
     1121             tt0-fin-doc-tax.sum-line-contr     = - tt0-fin-doc-tax.sum-line-contr
     1122             tt0-fin-doc-tax.sum-vat-line-contr = - tt0-fin-doc-tax.sum-vat-line-contr
     1123             tt0-fin-doc-tax.sum-slt-line-contr = - tt0-fin-doc-tax.sum-slt-line-contr
     1124           .
     1125         end.
     1126     end.
     1127   END PROCEDURE.
     1128   PROCEDURE CheckCli :
     1129     do
     1130     on error undo, return error return-value
     1131     :
     1132       if tt-fin-doc.payer-code = p-host-code and tt-fin-doc.payer-type = 'орг':U then do:
     1133         assign
     1134           tt-fin-doc.payer-bik        = buf_contract.own-bik
     1135           tt-fin-doc.payer-code-schet = buf_contract.own-code-schet
     1136           tt-fin-doc.payer-inn        = buf_contract.own-inn
     1137           tt-fin-doc.payer-kpp        = buf_contract.own-kpp
     1138         .
     1139         if tt-fin-doc.receiver-code = buf_contract.cli-code and tt-fin-doc.receiver-type = buf_contract.cli-type then do:
     1140           assign
     1141             tt-fin-doc.receiver-bik        = buf_contract.cli-bik
     1142             tt-fin-doc.receiver-code-schet = buf_contract.cli-code-schet
     1143             tt-fin-doc.receiver-inn        = buf_contract.cli-inn
     1144             tt-fin-doc.receiver-kpp        = buf_contract.cli-kpp
     1145           .
     1146         end.
     1147         else do:
     1148           if tt-fin-doc.receiver-code = buf_contract.posr-code and tt-fin-doc.receiver-type = buf_contract.posr-type then do:
     1149             assign
     1150               tt-fin-doc.receiver-bik        = buf_contract.posr-bik
     1151               tt-fin-doc.receiver-code-schet = buf_contract.posr-code-schet
     1152               tt-fin-doc.receiver-inn        = buf_contract.posr-inn
     1153               tt-fin-doc.receiver-kpp        = buf_contract.posr-kpp
     1154             .
     1155           end.
     1156           else do:
     1157             assign
     1158               tt-fin-doc.receiver-bik        = buf_contract.agnt-bik
     1159               tt-fin-doc.receiver-code-schet = buf_contract.agnt-code-schet
     1160               tt-fin-doc.receiver-inn        = buf_contract.agnt-inn
     1161               tt-fin-doc.receiver-kpp        = buf_contract.agnt-kpp
     1162             .
     1163           end.
     1164         end.
     1165       end.
     1166       else do:
     1167         if tt-fin-doc.receiver-code = p-host-code and tt-fin-doc.receiver-type = 'орг':U then do:
     1168           assign
     1169             tt-fin-doc.receiver-bik        = buf_contract.own-bik
     1170             tt-fin-doc.receiver-code-schet = buf_contract.own-code-schet
     1171             tt-fin-doc.receiver-inn        = buf_contract.own-inn
     1172             tt-fin-doc.receiver-kpp        = buf_contract.own-kpp
     1173           .
     1174           if tt-fin-doc.payer-code = buf_contract.cli-code and tt-fin-doc.payer-type = buf_contract.cli-type then do:
     1175             assign
     1176               tt-fin-doc.payer-bik        = buf_contract.cli-bik
     1177               tt-fin-doc.payer-code-schet = buf_contract.cli-code-schet
     1178               tt-fin-doc.payer-inn        = buf_contract.cli-inn
     1179               tt-fin-doc.payer-kpp        = buf_contract.cli-kpp
     1180             .
     1181           end.
     1182           else do:
     1183             if tt-fin-doc.payer-code = buf_contract.posr-code and tt-fin-doc.payer-type = buf_contract.posr-type then do:
     1184               assign
     1185                 tt-fin-doc.payer-bik        = buf_contract.posr-bik
     1186                 tt-fin-doc.payer-code-schet = buf_contract.posr-code-schet
     1187                 tt-fin-doc.payer-inn        = buf_contract.posr-inn
     1188                 tt-fin-doc.payer-kpp        = buf_contract.posr-kpp
     1189               .
     1190             end.
     1191             else do:
     1192               assign
     1193                 tt-fin-doc.payer-bik        = buf_contract.agnt-bik
     1194                 tt-fin-doc.payer-code-schet = buf_contract.agnt-code-schet
     1195                 tt-fin-doc.payer-inn        = buf_contract.agnt-inn
     1196                 tt-fin-doc.payer-kpp        = buf_contract.agnt-kpp
     1197               .
     1198             end.
     1199           end.
     1200         end.
     1201         else return error .
     1202       end.
     1203     end.
     1204   END PROCEDURE.
     1205   PROCEDURE UchetCode :
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       case tt-fin-doc.fin-doc-type :
     1210         when 'пко':U then do:
     1211           assign
     1212             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-cash
     1213             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-cash
     1214             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-cash
     1215             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-cash
     1216           .
     1217         end.
     1218         when 'рко':U then do:
     1219           assign
     1220             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-cash
     1221             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-cash
     1222             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-cash
     1223             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-cash
     1224           .
     1225         end.
     1226         when 'ппп':U then do:
     1227           assign
     1228             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in
     1229             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in
     1230             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in
     1231           .
     1232         end.
     1233         when 'рпп':U then do:
     1234           assign
     1235             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out
     1236             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out
     1237             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out
     1238           .
     1239         end.
     1240         when 'апп':U then do:
     1241           assign
     1242             tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-payoff
     1243             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-payoff
     1244             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-payoff
     1245             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-payoff
     1246           .
     1247         end.
     1248         when 'апр':U then do:
     1249           assign
     1250             tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-payoff
     1251             tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-payoff
     1252             tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-payoff
     1253             tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-payoff
     1254           .
     1255         end.
     1256       end.
     1257       find first ub.fin-code-cel-nazn no-lock where ub.fin-code-cel-nazn.host-code = p-host-code and ub.fin-code-cel-nazn.fin-code = tt-fin-doc.cel-nazn-code no-error .
     1258       if available ub.fin-code-cel-nazn then assign tt-fin-doc.cel-nazn-value = ub.fin-code-cel-nazn.code-value .
     1259       find first ub.fin-code-an-uchet no-lock where ub.fin-code-an-uchet.host-code = p-host-code and ub.fin-code-an-uchet.fin-code = tt-fin-doc.an-uchet-code no-error .
     1260       if available ub.fin-code-an-uchet then assign tt-fin-doc.an-uchet-value = ub.fin-code-an-uchet.code-value .
     1261       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc no-error .
     1262       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     1263       find first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.host-code = p-host-code and ub.fin-code-cor-acc.fin-code = tt-fin-doc.cor-acc1 no-error .
     1264       if available ub.fin-code-cor-acc then assign tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     1265     end.
     1266   END PROCEDURE.
     1267   PROCEDURE FindBank :
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271     find first b1_fin-schet no-lock where b1_fin-schet.host-code = p-host-code and b1_fin-schet.code-schet = tt-fin-doc.receiver-code-schet no-error .
     1272     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b1_fin-schet.code-bank no-error .
     1273     if available b1_fin-schet then
     1274     assign
     1275       tt-fin-doc.receiver-bank-name  = ub.fin-bank.bank-name
     1276       tt-fin-doc.receiver-bank-city  = ub.fin-bank.bank-city
     1277       tt-fin-doc.receiver-c-schet    = b1_fin-schet.c-schet
     1278       tt-fin-doc.receiver-r-schet    = b1_fin-schet.r-schet
     1279     .
     1280     find first b2_fin-schet no-lock where b2_fin-schet.host-code = p-host-code and b2_fin-schet.code-schet = tt-fin-doc.payer-code-schet no-error .
     1281     find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = b2_fin-schet.code-bank no-error .
     1282     if available b2_fin-schet then
     1283     assign
     1284       tt-fin-doc.payer-bank-name  = ub.fin-bank.bank-name
     1285       tt-fin-doc.payer-bank-city  = ub.fin-bank.bank-city
     1286       tt-fin-doc.payer-c-schet    = b2_fin-schet.c-schet
     1287       tt-fin-doc.payer-r-schet    = b2_fin-schet.r-schet
     1288     .
     1289     end.
     1290   END PROCEDURE.
     1291     define variable line as integer initial 1 no-undo .
     1292     define variable v-curr-r-b as integer   no-undo .
     1293     define variable curr-rc    as character no-undo .
     1294     define variable sss    as character no-undo .
     1295     define variable p-sys-time  as character no-undo .
     1296     define variable v-fd-code as integer no-undo .
     1297   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1299     (input  p-host-code
     1300     ,output v-curr-r-b
     1301     )  .
     1302     find first b_fin-ob no-lock     where recid(b_fin-ob) = p-ri .
     1303     find first ub.sysconf no-lock      where ub.sysconf.host-code = p-host-code .
     1304     find first ub.firm no-lock         where ub.firm.firm-code    = p-host-code .
     1305     find first buf_contract no-lock where buf_contract.host-code = p-host-code and buf_contract.contract-code = b_fin-ob.contract-code no-error .
     1306     run gen-b-code in this-procedure ( input 'fdgb':U
     1307                                     , output v-fd-code) no-error .
     1308     if error-status:error then do:
     1309       define variable v-mess as character no-undo .
     1310       v-mess = substitute("Ошибка при генерации внутреннего номера фин. док-та:&1&2&1&3"
     1311                                   , chr(10)
     1312                                   , error-status:get-message(1)
     1313                                   , return-value ).
     1314       undo, return error v-mess.
     1315     end.
     1316     create tt-fin-doc .
     1317     assign
     1318       tt-fin-doc.host-code       = p-host-code
     1319       tt-fin-doc.fin-doc-code    = v-fd-code
     1320       tt-fin-doc.base-rate       = b_fin-ob.base-rate
     1321       tt-fin-doc.base-scale      = b_fin-ob.base-scale
     1322       tt-fin-doc.contract-code   = b_fin-ob.contract-code
     1323       tt-fin-doc.contract-curr   = b_fin-ob.contract-curr
     1324       tt-fin-doc.contract-rate   = b_fin-ob.contract-rate
     1325       tt-fin-doc.contract-scale  = b_fin-ob.contract-scale
     1326       tt-fin-doc.curr-code       = b_fin-ob.curr-code
     1327       tt-fin-doc.obj-code        = b_fin-ob.obj-code
     1328       tt-fin-doc.obj-type        = b_fin-ob.obj-type
     1329       tt-fin-doc.doc-date        = today
     1330       tt-fin-doc.exch-rate       = b_fin-ob.exch-rate
     1331       tt-fin-doc.exch-scale      = b_fin-ob.exch-scale
     1332       tt-fin-doc.PS              = ""
     1333       tt-fin-doc.ocher-pl        = "6"
     1334       tt-fin-doc.stat-pl         = ""
     1335       tt-fin-doc.naznach-plat    = "Оплата по договору № " + buf_contract.contract-prn-code + " от " + string( buf_contract.contract-date,"99/99/9999")
     1336       tt-fin-doc.payer-name      = b_fin-ob.payer-name
     1337       tt-fin-doc.payer-code      = b_fin-ob.payer-code
     1338       tt-fin-doc.payer-type      = b_fin-ob.payer-type
     1339       tt-fin-doc.receiver-code   = b_fin-ob.receiver-code
     1340       tt-fin-doc.receiver-name   = b_fin-ob.receiver-name
     1341       tt-fin-doc.receiver-type   = b_fin-ob.receiver-type
     1342       tt-fin-doc.prn-doc-code    = string(tt-fin-doc.fin-doc-code)
     1343       tt-fin-doc.sum-doc         = b_fin-ob.sum-doc
     1344       tt-fin-doc.sum-base        = b_fin-ob.sum-base
     1345       tt-fin-doc.sum-rubl        = b_fin-ob.sum-rubl
     1346       tt-fin-doc.sum-contr       = b_fin-ob.sum-contract
     1347     .
     1348     for each ub.fin-ob-tax no-lock where ub.fin-ob-tax.host-code = p-host-code and ub.fin-ob-tax.doc-code = b_fin-ob.doc-code :
     1349       create tt0-fin-doc-tax .
     1350       BUFFER-COPY ub.fin-ob-tax TO tt0-fin-doc-tax .
     1351       assign
     1352         tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     1353         tt0-fin-doc-tax.line-num = line
     1354         line = line + 1
     1355         tt0-fin-doc-tax.sum-line-doc       =  ROUND( tt0-fin-doc-tax.sum-line-doc      , 2)
     1356         tt0-fin-doc-tax.sum-vat-line-doc   =  ROUND( tt0-fin-doc-tax.sum-vat-line-doc  , 2)
     1357         tt0-fin-doc-tax.sum-line-rubl      =  ROUND( tt0-fin-doc-tax.sum-line-rubl     , 2)
     1358         tt0-fin-doc-tax.sum-vat-line-rubl  =  ROUND( tt0-fin-doc-tax.sum-vat-line-rubl , 2)
     1359         tt0-fin-doc-tax.sum-line-base      =  ROUND( tt0-fin-doc-tax.sum-line-base     , 2)
     1360         tt0-fin-doc-tax.sum-vat-line-base  =  ROUND( tt0-fin-doc-tax.sum-vat-line-base , 2)
     1361         tt0-fin-doc-tax.sum-line-contr     =  tt0-fin-doc-tax.sum-line-contr
     1362         tt0-fin-doc-tax.sum-vat-line-contr =  tt0-fin-doc-tax.sum-vat-line-contr
     1363       .
     1364     end.
     1365     run CheckCli no-error .
     1366     if error-status:error then do:
     1367       return error string("Несоответствие плательщика или получателя договору!. Вн.н. договора " + string(b_fin-ob.contract-code) + " ,вн.н. фин.об. " + string(b_fin-ob.doc-code)) .
     1368     end.
     1369     run FindBank .
     1370     if buf_contract.pay-nal = no  then do:
     1371       if available b1_fin-schet and available b2_fin-schet then do: if b1_fin-schet.curr-code <> b2_fin-schet.curr-code then return error "Валюта счета плательщика отличается от валюты счета получателя." . end.
     1372       else  return error string("Не найден счет плательщика или счет получателя. Вн.н. договора " + string(b_fin-ob.contract-code) + " ,вн.н. фин.об. " + string(b_fin-ob.doc-code))  .
     1373       if buf_contract.doc-type = 'при':U then do:
     1374         if tt-fin-doc.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'рпп':U .
     1375         else                           assign tt-fin-doc.fin-doc-type = 'ппп':U .
     1376       end.
     1377       else do:
     1378         if tt-fin-doc.sum-contr > 0 then assign tt-fin-doc.fin-doc-type = 'ппп':U .
     1379         else                           assign tt-fin-doc.fin-doc-type = 'рпп':U .
     1380       end.
     1381       find first ub.currency no-lock where ub.currency.curr-code = b2_fin-schet.curr-code .
     1382       assign tt-fin-doc.curr-code = b2_fin-schet.curr-code .
     1383       case b2_fin-schet.curr-code :
     1384         when 0 then do:
     1385           assign tt-fin-doc.sum-doc = tt-fin-doc.sum-rubl .
     1386           for each tt0-fin-doc-tax no-lock :
     1387             assign
     1388               tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-rubl
     1389               tt0-fin-doc-tax.sum-vat-line-doc   = tt0-fin-doc-tax.sum-vat-line-rubl
     1390               tt0-fin-doc-tax.sum-slt-line-doc   = tt0-fin-doc-tax.sum-slt-line-rubl
     1391             .
     1392           end.
     1393         end.
     1394         when v-curr-r-b then do:
     1395           assign tt-fin-doc.sum-doc = tt-fin-doc.sum-base .
     1396           for each tt0-fin-doc-tax no-lock :
     1397             assign
     1398               tt0-fin-doc-tax.sum-line-doc       = tt0-fin-doc-tax.sum-line-base
