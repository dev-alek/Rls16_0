     1469         tt-fin-doc.payer-sign2        = ub.sysconf.snr-accnt
     1470         tt-fin-doc.payer-sign3        = ub.sysconf.cashier
     1471       .
     1472       run InvertCli .
     1473     end.
     1474     else
     1475       assign
