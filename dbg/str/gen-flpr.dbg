     3433   var-fin-calc = sysconf.fin-calc   .
     3434   run make-temp-obj-firm.
     3435   if p-trn-doc = ? then assign
     3436                          v-type-trn-doc = 'ie,ep,':U + 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U
     3437                          v-sign-list    = '1,-1,':U + '1,1,-1,-1,1,1,1,':U + '1,1,1,1,':U
     3438                          .
     3439   if p-trn-doc = 1 then assign
     3440                          v-type-trn-doc = 'ie,ep,':U + 'vt,ap,mp,vp,':U
     3441                          v-shot-type-trn-doc = 'при':U
     3442                          v-sign-list    = '1,-1,':U + '1,1,1,1,':U
     3443                          .
     3444   if p-trn-doc = 2 then assign
     3445                         v-type-trn-doc = 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U
     3446                         v-shot-type-trn-doc = 'рас':U
