     4648                   buf2_trn-doc.need-expfo      = 0
     4649                   buf2_trn-doc.need-incorexpfo = 1
     4650                 .
     4651               end.
     4652           end.
     4653           else do:
     4654               assign
     4655                 buf2_trn-doc.cr-expfo   = true
     4656                 buf2_trn-doc.cr-incorexpfo = true
     4657                 buf2_trn-doc.expfo-date = today
     4658               .
     4659               if buf2_trn-doc.need-expfo = 2 then do:
     4660                 assign
     4661                   buf2_trn-doc.need-expfo      = 1
     4662                   buf2_trn-doc.need-incfo      = 0
     4663                   buf2_trn-doc.need-incorexpfo = 1
     4664                 .
     4665               end.
     4666           end.
     4667          end.
     4668          else do:
     4669             message vss-workfile vss-revision vss-description skip
     4670                    "Ошибка test " skip
     4671                     skip
     4672                     error-status :get-message(1) skip
     4673                     return-value skip
     4674                     view-as alert-box error
     4675             .
     4676          end.
     4677         if p-nalog = 1 then
     4678             run make-fin-parts (input p-doc-code, input 2) .
     4679          else
     4680             run make-fin-parts-VAT (input p-doc-code, input v-pc) .
     4681     end.
