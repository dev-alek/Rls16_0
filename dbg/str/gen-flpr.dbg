        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "процедура генерации Фин Об по заданным параметрам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable v-waitfram-action01         as character   no-undo .
      124   define variable v-waitfram-action02         as character   no-undo .
      125   define variable v-waitfram-action03         as character   no-undo .
      126   define variable mWaitFramTextBeg            as character   no-undo.
      127   define variable mWaitFramTextEnd            as character   no-undo.
      128   define variable mWaitFramView               as logical     no-undo.
      129   define variable mWaitProcEvent              as logical     no-undo init yes.
      130   define variable mWaitFramInterval           as integer     no-undo init 1 .
      131   define variable mWaitFramStop               as logical     no-undo.
      132   define variable mWaitFramStopUser           as logical     no-undo.
      133   define variable mWaitFramStopTimeOut        as logical     no-undo.
      134   define variable mWaitFramStartProc          as datetime-tz no-undo.
      135   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      136   define button B-WaitFramStop auto-end-key
      137        label "Стоп"
      138        size 10 by 1 tooltip "Остоновить процесс".
      139   define button B-viewProcInfo
      140        label "Информация"
      141        size 15 by 1 tooltip "Информация о процесс".
      142   define frame waitfram
      143     v-waitfram-action01 format "x(72)" no-label skip
      144     v-waitfram-action02 format "x(72)" no-label skip
      145     v-waitfram-action03 format "x(72)" no-label skip
      146     B-viewProcInfo
      147     B-WaitFramStop at row 4 col 30
      148     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      149     .
      150   define new global shared variable mBatchMode as logical no-undo init ?.
      151   define variable mFramBachModHandle as handle no-undo.
      152   mFramBachModHandle = frame waitfram:handle.
      153   define variable mFameOldVis as logical no-undo.
      154   define variable mVisCUrentVin as logical no-undo.
      155   if session:batch-mode
      156   then
      157      mBatchMode = yes.
      158   if mBatchMode = ? then do:
      159     mVisCUrentVin = current-window:visible.
      160     mFameOldVis = mFramBachModHandle:visible.
      161     mFramBachModHandle:visible  = yes.
      162     mBatchMode = mFramBachModHandle:visible ne yes.
      163     mFramBachModHandle:visible = mFameOldVis.
      164     current-window:visible = mVisCUrentVin.
      165   end.
      166    if  log-manager:logfile-name ne ?
      167     then DO:
      168         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      169         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      170         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      171     end.
      172   on choose of B-WaitFramStop in frame waitfram
      173   do:
      174     mWaitFramStop = yes.
      175     mWaitFramStopUser = yes.
      176   end.
      177   function waitfram-check-timeout returns logical():
      178      define variable vtime as int64 no-undo.
      179      if mWaitFramStopTimeOut
      180      then
      181         return yes.
      182      vtime = ( now - mWaitFramStartProc ) / 1000 .
      183      if     mWaitFramTimeOut ne ?
      184         and mWaitFramTimeOut ne 0
      185         and mWaitFramTimeOut lt vtime
      186      then do:
      187         mWaitFramStopTimeOut = yes.
      188      end.
      189      return mWaitFramStopTimeOut.
      190   end.
      191   procedure waitfram-hide :
      192     if not session:batch-mode
      193     then do
      194     on error undo, return error return-value
      195     :
      196       pause 0 before-hide .
      197       if not mBatchMode then
      198         hide frame waitfram .
      199     if     not mWaitFramView
      200        and mWaitProcEvent
      201     then
      202       process events .
      203     end.
      204   end procedure.
      205   procedure waitfram-show :
      206     define input  parameter p-message as character no-undo .
      207     define variable v-left-margin as integer   no-undo .
      208     if not session:batch-mode
      209     then do
      210     on error undo, return error return-value
      211     :
      212       if length(p-message) <= 70 then do:
      213         assign
      214           v-left-margin = integer((70 - length(p-message)) / 2)
      215         .
      216         assign
      217           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      218         .
      219         assign
      220           v-waitfram-action01 = " "
      221           v-waitfram-action02 = " "
      222                                    + fill(" ", v-left-margin)
      223                                    + p-message
      224           v-waitfram-action03 = " "
      225         .
      226       end.
      227       else do:
      228         define variable vRindex1 as integer no-undo.
      229         define variable vRindex2 as integer no-undo.
      230         vRindex1 = r-index(p-message," ",70).
      231         if vRindex1 = 0
      232         then
      233            vRindex1 = 70.
      234         if length(p-message)  <= vRindex1 + 70 then do:
      235           assign
      236             v-waitfram-action01 = " "
      237             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      238             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      239           .
      240         end.
      241         else do:
      242           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      243           if vRindex2 <= vRindex1
      244           then
      245              vRindex2 = vRindex1 + 70.
      246           assign
      247             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      250           .
      251         end.
      252       end.
      253       B-viewProcInfo:visible   in frame waitfram = no.
      254       B-viewProcInfo:sensitive in frame waitfram = no.
      255       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      256       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      257       if  (   mWaitFramView
      258          or  mWaitProcEvent)
      259          and not mBatchMode
      260       then
      261          display
      262             v-waitfram-action01 skip
      263             v-waitfram-action02 skip
      264             v-waitfram-action03 skip
      265          with frame waitfram .
      266       if     mWaitFramView
      267          then do:
      268             if     mWaitFramInterval ne ?
      269                and not mBatchMode
      270             then
      271                wait-for go of frame waitfram pause mWaitFramInterval.
      272          end.
      273          else
      274             if     mWaitProcEvent
      275                and not mBatchMode
      276             then
      277                process events .
      278     end.
      279   end procedure.
      280      procedure waitfram-show-this:
      281         define input  parameter iInterval as int64 no-undo.
      282         define variable vtime as int64 no-undo.
      283         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      284         mWaitFramInterval = iInterval.
      285         run waitfram-show (substitute("&1&2 &3&4" ,
      286                                       mWaitFramTextBeg ,
      287                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      288                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      289                                       mWaitFramTextEnd
      290                                      )
      291                           ).
      292      end.
      293      procedure WaitFramRunPause:
      294         define input  parameter iInterval as dec no-undo.
      295         define variable vStart  as datetime-tz no-undo.
      296         define variable vend    as datetime-tz no-undo.
      297         define variable vint as int64 no-undo.
      298         define variable vOk as logical no-undo.
      299         vStart = now.
      300         vend   = vStart.
      301         publish "WaitFramPause" (iInterval,output vOk).
      302         vend   =  now.
      303         vint = vend - vStart.
      304         vint = iInterval - vint / 1000.
      305         if     not mWaitFramStop
      306            and (   vint > 0
      307                 or (    not vOk
      308                     and iInterval eq ?
      309                     )
      310                 )
      311         then
      312            run waitfram-show-this (iInterval).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and vint > 0
      318         then do:
      319            run gbl/pause.p (vint * 1000).
      320         end.
      321         if iInterval ne ?
      322         then
      323            publish "WaitFramStop".
      324         waitfram-check-timeout().
      325      end.
      326      procedure WaitFramWaitFor:
      327         define input  parameter iInterval as dec no-undo.
      328         assign
      329            mWaitFramStartProc   = now
      330            mWaitFramStopUser    = no
      331            mWaitFramStopTimeOut = no
      332         .
      333         block-wait:
      334         do while not mWaitFramStop:
      335            run WaitFramRunPause (iInterval).
      336            if  waitfram-check-timeout()
      337            then do:
      338               leave block-wait.
      339            end.
      340         end.
      341         run waitfram-hide.
      342      end.
      343   procedure waitfram-join :
      344     define input  parameter p-line-1  as character no-undo .
      345     define input  parameter p-line-2  as character no-undo .
      346     define input  parameter p-line-3  as character no-undo .
      347     define output parameter p-message as character no-undo .
      348     do
      349     on error undo, return error return-value
      350     :
      351       assign
      352         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      353                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      354                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      355       .
      356     end.
      357   end procedure.
      358   function waitfram-join-function returns character
      359     (input p-line-1 as character
      360     ,input p-line-2 as character
      361     ,input p-line-3 as character
      362     ).
      363     define variable v-message as character no-undo .
      364     run waitfram-join in this-procedure
      365       (input  p-line-1
      366       ,input  p-line-2
      367       ,input  p-line-3
      368       ,output v-message
      369       ) .
      370     return v-message .
      371   end function .
      372   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   procedure cur-time :
      374      define output parameter p-today as date      no-undo .
      375      define output parameter p-time  as integer   no-undo .
      376     do
      377     on error undo, return error
      378     :
      379       define variable v-date1 as date      no-undo .
      380       define variable v-date2 as date      no-undo .
      381       define variable v-time  as integer   no-undo .
      382       assign
      383         v-date1 = today
      384         v-time  = time
      385         v-date2 = today
      386       .
      387       if v-date1 <> v-date2
      388       then do:
      389         assign
      390           v-date1 = today
      391           v-time  = v-time
      392         .
      393       end.
      394       assign
      395         p-today = v-date1
      396         p-time  = v-time
      397       .
      398     end.
      399   end.
      400   function cur-time-date returns character
      401   :
      402     return string(today, '99/99/9999':U) .
      403   end.
      404   function cur-time-mjd returns decimal
      405   :
      406     define variable v-date as date      no-undo .
      407     define variable v-time as integer   no-undo .
      408     run cur-time in this-procedure
      409       (output v-date
      410       ,output v-time
      411       ) .
      412     return integer(v-date) - 2400002 + (v-time / 86400) .
      413   end.
      414   function cur-time-get-ending-index returns integer
      415   (input p-number as integer
      416   )
      417   :
      418     if p-number < 0
      419     or p-number = ?
      420     then do:
      421       return 1 .
      422     end.
      423     define variable v-rest as integer   no-undo .
      424     assign
      425       p-number = p-number modulo 100
      426     .
      427     if p-number < 20
      428     then do:
      429       assign
      430         v-rest = p-number
      431       .
      432     end.
      433     else do:
      434       assign
      435         v-rest = p-number modulo 10
      436       .
      437     end.
      438     case v-rest :
      439       when 1
      440       then do:
      441         return 2 .
      442       end.
      443       when 2 or
      444       when 3 or
      445       when 4
      446       then do:
      447         return 3 .
      448       end.
      449       otherwise do:
      450         return 1 .
      451       end.
      452     end case .
      453   end.
      454   procedure cur-time-mjd-to-date :
      455      define input  parameter i-mjd-diff as decimal no-undo.
      456      define output parameter o-Date     as date    no-undo.
      457      define output parameter o-Time     as integer no-undo.
      458      define variable v-day-number as integer   no-undo .
      459      if    i-mjd-diff < 0
      460         or i-mjd-diff = ?
      461      then do:
      462         return "?" .
      463      end.
      464      assign
      465         v-day-number = truncate(i-mjd-diff,0).
      466         o-Date = date(v-day-number + 2400002).
      467         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      468     .
      469   end.
      470   function cur-time-mjd-to-string returns character
      471   (input p-mjd-diff as decimal
      472   )
      473   :
      474     define variable v-day-number as integer   no-undo .
      475     define variable v-seconds    as integer   no-undo .
      476     define variable v-hour       as integer   no-undo .
      477     define variable v-min        as integer   no-undo .
      478     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      479     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      480     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      481     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      482     if p-mjd-diff < 0
      483     or p-mjd-diff = ?
      484     then do:
      485       return "?" .
      486     end.
      487     assign
      488       v-day-number = integer(truncate(p-mjd-diff,0))
      489       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      490     .
      491     if v-seconds > 86400
      492     then do:
      493       assign
      494         v-seconds = 86400 - 1
      495       .
      496     end.
      497     if v-seconds < 0
      498     then do:
      499       assign
      500         v-seconds = 0
      501       .
      502     end.
      503     assign
      504       v-hour = truncate(v-seconds / 3600, 0)
      505     .
      506     assign
      507       v-seconds = v-seconds modulo 3600
      508     .
      509     assign
      510       v-min = truncate(v-seconds / 60, 0)
      511     .
      512     assign
      513       v-seconds = v-seconds modulo 60
      514     .
      515     return
      516         (if v-day-number <> 0
      517           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      518           else ""
      519         )
      520       + (if v-day-number <> 0 or v-hour <> 0
      521           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      525           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      526           else ""
      527         )
      528       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      529       .
      530   end.
      531   function cur-time-string returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      540   end.
      541   function cur-time-string-sec returns character
      542   :
      543     define variable v-date as date      no-undo .
      544     define variable v-time as integer   no-undo .
      545     run cur-time in this-procedure
      546       (output v-date
      547       ,output v-time
      548       ) .
      549     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      550   end.
      551   function cur-time-custom  returns character
      552   (input p-prefix as character
      553   ,input p-date-format as character
      554   ,input p-delimiter as character
      555   ,input p-time-format as character
      556   ,input p-suffix as character
      557   )
      558   :
      559     define variable v-date as date      no-undo .
      560     define variable v-time as integer   no-undo .
      561     run cur-time in this-procedure
      562       (output v-date
      563       ,output v-time
      564       ) .
      565     return
      566       p-prefix
      567       + string(v-date, p-date-format)
      568       + p-delimiter
      569       + string(v-time, p-time-format)
      570       + p-suffix
      571       .
      572   end.
      573   function cur-time-print  returns character
      574   :
      575     define variable v-date as date      no-undo .
      576     define variable v-time as integer   no-undo .
      577     run cur-time in this-procedure
      578       (output v-date
      579       ,output v-time
      580       ) .
      581     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      582   end.
      583   function cur-time-datetime returns datetime
      584   :
      585     define variable v-char as character no-undo .
      586     define variable v-datetime as datetime no-undo .
      587     v-char = cur-time-string().
      588     v-datetime = datetime(v-char).
      589     return  v-datetime.
      590   end.
      591   function cur-time-string-msec returns character
      592   :
      593     define variable v-date as datetime  no-undo .
      594     v-date = now.
      595     return string(v-date) .
      596   end.
      597   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   define buffer buf_file for ub.fin-ob .
      599   procedure current-db :
      600    do
      601    on error undo, return error return-value
      602    :
      603   define input parameter  p-host-code as integer no-undo .
      604   define input parameter  c-host-code as integer no-undo .
      605   define output parameter ret         as logical no-undo .
      606   define buffer current_sysconf for ub.sysconf.
      607   define variable v-current-db as integer no-undo .
      608   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      609   if error-status :error then return error .
      610      v-current-db = current_sysconf.firm-db-num .
      611      ret = true .
      612   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      613   if not( ub.sysconf.firm-db-num = v-current-db or
      614           ub.sysconf.firm-db-num = 0 )
      615     then do:
      616     ret = false .
      617     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      618     return .
      619   end.
      620    end.
      621   end procedure.
      622   procedure ver-db :
      623    do
      624    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      625    :
      626   define input parameter  c-host-code as integer no-undo .
      627   define input parameter  par-ver-db  as integer no-undo .
      628   define input parameter  p-mess as logical no-undo .
      629   define output parameter ret         as logical no-undo .
      630   define buffer current_sysconf for ub.sysconf.
      631   define variable v-current-db as integer no-undo .
      632   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      633   if error-status :error then return error .
      634      v-current-db = current_sysconf.firm-db-num .
      635      ret = true .
      636   if not( par-ver-db = v-current-db or
      637           par-ver-db = 0 )
      638     then do:
      639     ret = false .
      640     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      641     return .
      642   end.
      643    end.
      644   end procedure.
      645   procedure fin-ob-code :
      646    do
      647    on error undo, return error return-value
      648    :
      649     define input  parameter p-db-num as integer no-undo .
      650     define output parameter p-fin-ob-code  as character no-undo .
      651     if p-db-num = 0 then
      652         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
      653         else
      654         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
      655    end.
      656   end procedure.
