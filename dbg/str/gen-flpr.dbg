     3796                        then do:
     3797                               run make-bfo ( input var-sum-rublb ,
     3798                                              input var-sum-baseb ,
     3799                                              input var-sum-contractb,
     3800                                              input buf_parts-attr.income-in-code)
     3801                                              no-error .
     3802                               if error-status :error then
     3803                               do:
     3804                                   message vss-workfile vss-revision vss-description skip
     3805                                          "Ошибка  " skip
     3806                                           skip
     3807                                           error-status :get-message(1) skip
     3808                                           return-value skip
     3809                                           view-as alert-box error
     3810                                   .
     3811                                   col-bfo = col-bfo - 1.
     3812                                   p-res = p-res + chr(10) + error-status :get-message(1) .
     3813                               end.
     3814                               var-sum-rublb = 0 .
     3815                               var-sum-baseb = 0 .
     3816                               var-sum-contractb = 0 .
     3817                     end.
     3818               end.
     3819               if last-of(buf_parts.contract-code) or (p-nalog = 2 and last-of(buf_parts.vat-pc)) then do:
     3820                  var-sum-rublb = 0 .
     3821                  var-sum-baseb = 0 .
     3822                  var-sum-contractb = 0 .
     3823                     if buf_contract.usl-opl <> 'По реализации части приход. накладной':U then do:
     3824                         if p-cons = 1 then do:
     3825                               run make-tt-fo ( input var-sum-rubl ,
     3826                                                input var-sum-base ,
     3827                                                input var-sum-contract ,
     3828                                                input buf_parts.vat-pc
     3829                                                ) no-error .
     3830                               if error-status :error then do:
     3831                                   message vss-workfile vss-revision vss-description skip
     3832                                         "test3" error-status :get-message(1)
     3833                                          error-status :error
     3834                                          error-status :get-message(1) skip
     3835                                          return-value skip
     3836                                          view-as alert-box error
     3837                                  .
