     3756            if lookup ( buf_trn-doc.ext-doc-type , 'vt,ap,mp,vp,':U ) = 0  and
     3757                 (
     3758                  ( lookup(buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0 and
     3759                       v-flag-po = false )
     3760                     or
     3761                     ( lookup(buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) = 0 and
     3762                       v-flag-ex = false )
     3763                       )
     3764            then do:
     3765                 run ver-type-purch (output v-ok ).
     3766                 if v-ok = true then do:
     3767                   if buf_contract.usl-opl = 'По реализации части приход. накладной':U
     3768                       then
     3769                           assign
     3770                             var-sum-rublb     = var-sum-rublb     + (v-sign) * abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )  * (-1)
     3771                             var-sum-contractb = var-sum-contractb + (v-sign) * abs(tt-allsum.sum-dsc-cli-acc                                                                )  * (-1)
     3772                             var-sum-baseb     = var-sum-baseb     + (v-sign) * abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )  * (-1)
     3773                           .
     3774                       else
