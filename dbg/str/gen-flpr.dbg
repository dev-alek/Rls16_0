     4557           for each tt-trn-code  where
     4558               tt-trn-code.contract-code = buf_contract.contract-code  and
     4559               tt-trn-code.host-code     = par-host-code
     4560               break by tt-trn-code.fact-date DESCENDING
     4561               on error undo, return error
     4562               :
     4563               min-date = tt-trn-code.fact-date.
     4564           end.
     4565               if  min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     4566                   then n-pay-date = n-doc-date .
     4567                   else n-pay-date = min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     4568     run fin-ob-code (input g#db-num , output p-doc-code) .
     4569     run create-fin-liab (
