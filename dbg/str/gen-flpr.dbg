     3426      end.
     3427      else do:
     3428       p-usl-opl =  'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)'  .
     3429      end.
     3430   run waitfram-show("Ждите...").
     3431   define variable var-fin-calc as integer no-undo .
