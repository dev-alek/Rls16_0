     3448                         .
     3449   define buffer buf_p_fin-ob-trn for fin-ob-trn.
     3450   if p-trn-doc <> ?  then do:
     3451       for each temp-obj-firm on error undo, return error :
     3452           if p-trn-doc = 1  then do:
     3453              for each buf_trn-doc no-lock where
     3454                   buf_trn-doc.is-del     = true                   and
     3455                   buf_trn-doc.obj-type   = temp-obj-firm.obj-type and
     3456                   buf_trn-doc.obj-code   = temp-obj-firm.obj-code and
     3457                   buf_trn-doc.status_    = 'факт':U                and
     3458                   buf_trn-doc.fact-date <= p-date-end             and
     3459                   buf_trn-doc.host-code  = par-host-code          and
     3460                   buf_trn-doc.need-incfo = 1                      and
     3461                   buf_trn-doc.cr-incfo   = false                  and
     3462                   lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0
     3463                   ,
     3464                   first buf_p_fin-ob-trn no-lock where
     3465                         buf_p_fin-ob-trn.trn-doc-code = buf_trn-doc.doc-code
     3466                         break by buf_trn-doc.ext-doc-type
     3467                         on error undo, return error
     3468                         :
     3469                         run proc-body-corr-acc.
     3470                         run proc-body .
     3471              end.
     3472           end.
     3473           if p-trn-doc = 2  then do:
     3474              for each buf_trn-doc no-lock where
     3475                   buf_trn-doc.is-del     = true                   and
     3476                   buf_trn-doc.obj-type   = temp-obj-firm.obj-type and
     3477                   buf_trn-doc.obj-code   = temp-obj-firm.obj-code and
     3478                   buf_trn-doc.status_    = 'факт':U                and
     3479                   buf_trn-doc.fact-date <= p-date-end             and
     3480                   buf_trn-doc.host-code  = par-host-code          and
     3481                   buf_trn-doc.need-expfo = 1                      and
     3482                   buf_trn-doc.cr-expfo   = false                  and
     3483                   lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0
     3484                   ,
     3485                   first buf_p_fin-ob-trn no-lock where
     3486                         buf_p_fin-ob-trn.trn-doc-code = buf_trn-doc.doc-code
     3487                         break by buf_trn-doc.ext-doc-type
     3488                         on error undo, return error
     3489                         :
     3490                         run proc-body-corr-acc.
     3491                         run proc-body .
     3492              end.
     3493           end.
     3494       end.
     3495    end.
     3496    else do:
     3497       p-usl-opl = 'По факту поставки,Отсрочка платежа (по поставке)' + "," + 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' .
     3498       for each tt-trn-doc  no-lock  where
     3499           tt-trn-doc.is-del     = true and
     3500           lookup(tt-trn-doc.ext-doc-type , v-type-trn-doc) > 0
     3501           and    tt-trn-doc.status_    = 'факт':U
     3502           break by tt-trn-doc.ext-doc-type
     3503           on error undo, return error
     3504           :
     3505           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-trn-doc.doc-code no-error .
     3506           find first buf_p_fin-ob-trn no-lock where   buf_p_fin-ob-trn.trn-doc-code = buf_trn-doc.doc-code  no-error .
     3507           if available buf_trn-doc and
     3508              available buf_p_fin-ob-trn  then  do:
     3509                   run proc-body-corr-acc .
     3510                   run proc-body .
     3511           end.
     3512       end.
     3513    end.
     3514     if p-cons = 1  then do:
     3515        var-sum-rubl =  0 .
     3516        var-sum-base     =  0 .
     3517        var-sum-contract =  0 .
     3518        col-contract =  0 .
     3519        if var-fin-calc = 1  then do:
     3520           for each temp-obj-firm
     3521               on error undo, return error :
     3522                 var-sum-rubl =  0 .
     3523                 var-sum-base     =  0 .
     3524                 var-sum-contract =  0 .
     3525                 col-contract =  0 .
     3526                      for each tt-fin-ob where
     3527                               tt-fin-ob.obj-code =  temp-obj-firm.obj-code and
     3528                               tt-fin-ob.obj-type =  temp-obj-firm.obj-type
     3529                               ,
     3530                         first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     3531                                                           buf_contract.host-code     = par-host-code           and
     3532                                                           buf_contract.usl-opl       <> 'По реализации части приход. накладной':U
     3533                               break by tt-fin-ob.contract-code
     3534                                     by tt-fin-ob.pc
     3535                               on error undo, return error :
     3536                               var-sum-rubl = var-sum-rubl         + tt-fin-ob.sum-rubl.
     3537                               var-sum-base     = var-sum-base     + tt-fin-ob.sum-base.
     3538                               var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract .
     3539                               if last-of(tt-fin-ob.contract-code)  or (p-nalog = 2 and last-of(tt-fin-ob.pc))  then do:
     3540                                   col-contract = col-contract + 1 .
     3541                                   if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show( "Объединение по договорам : " + string( col-contract )) .
     3542                                   run make-s-fo-obj (
     3543                                         input var-sum-rubl,
     3544                                         input var-sum-base,
     3545                                         input var-sum-contract,
     3546                                         input temp-obj-firm.obj-type ,
     3547                                         input temp-obj-firm.obj-code,
     3548                                         input tt-fin-ob.pc    )
     3549                                         no-error .
     3550                                       if error-status :error then do:
     3551                                         col-fo = col-fo - 1.
     3552                                         p-res = p-res + chr(10) + error-status :get-message(1) .
     3553                                       end.
     3554                                   var-sum-rubl =  0 .
     3555                                   var-sum-base =  0 .
     3556                                   var-sum-contract =  0 .
     3557                               end.
     3558                      end.
     3559           end.
     3560        end.
     3561        else do:
     3562             for each tt-fin-ob  ,
     3563                 first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     3564                                                   buf_contract.host-code     = par-host-code           and
     3565                                                   buf_contract.usl-opl       <> 'По реализации части приход. накладной':U
     3566                       break by tt-fin-ob.contract-code
     3567                             by tt-fin-ob.pc
     3568                       on error undo, return error :
     3569                       var-sum-rubl = var-sum-rubl + tt-fin-ob.sum-rubl.
     3570                       var-sum-base = var-sum-base + tt-fin-ob.sum-base.
     3571                       var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract.
     3572                       if last-of(tt-fin-ob.contract-code)  or (p-nalog = 2 and last-of(tt-fin-ob.pc))  then do:
     3573                           col-contract = col-contract + 1 .
     3574                           if ( col-contract  modulo temp1 = 0 ) and ( col-contract >= temp1 ) then run waitfram-show( "Объединение по договорам : " + string( col-contract )) .
     3575                           run make-s-fo ( input var-sum-rubl, input var-sum-base , input var-sum-contract , input tt-fin-ob.pc ) no-error .
     3576                               if error-status :error then do:
     3577                                 col-fo = col-fo - 1.
     3578                                 p-res = p-res + chr(10) + error-status :get-message(1) .
     3579                               end.
     3580                           var-sum-rubl =  0 .
     3581                           var-sum-base     =  0 .
     3582                           var-sum-contract =  0 .
     3583                       end.
     3584               end.
     3585        end.
     3586     end.
     3587   run waitfram-hide.
     3588   if col-fo    < 0 then col-fo    = 0 .
     3589   if col-bfo   < 0 then col-bfo   = 0 .
     3590   p-res = p-res  + chr(10)   +  chr(10)   +
     3591          "Генерация завершена: " + cur-time-string()  + chr(10) +
     3592          "за период до " + string( p-date-end,"99/99/9999")  + chr(10) +
     3593          " Создано финансовых обязательств :" + string(col-fo) + chr(10) +
     3594          " Создано ПредФинанОбязательств   :" + string(col-bfo) + chr(10) +  chr(10) +
     3595          "Просмотрено накладных            :" + string(col-trn)           + chr(10) +
     3596          "Просмотрено договоров            :" + string(col-contract)
     3597          .
     3598   return .
     3599   procedure proc-body :
     3600    do
     3601    on error undo, return error return-value
     3602    :
     3603   define variable sum-gds-code as decimal no-undo .
     3604   define buffer buf_minus-parts for c-parts.
     3605   define variable v-flag-po as logical no-undo .
     3606   define variable v-flag-ex as logical no-undo .
     3607   define variable v-may-be as logical   no-undo .
     3608   if buf_trn-doc.ext-doc-type = 'ap':U then return.
     3609   if buf_trn-doc.is-del     = false                     then return.
     3610   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_doc-fogn in g#libofarh (
     3611    input 'del'
     3612   ,input 'рас':U
     3613   ,input buf_trn-doc.doc-code
     3614   ,input g#db-num
     3615   ,output v-may-be
     3616   )
     3617   .
     3618   if v-may-be = false then do:
     3619      p-res = p-res + chr(10) + substitute("По документу &1 нельзя создавать ФО в этой БД" , buf_trn-doc.doc-code ) .
     3620      return .
     3621   end.
     3622   assign
     3623     v-flag-po = ( if buf_trn-doc.cr-incfo = true then true else false )
     3624     v-flag-ex = ( if buf_trn-doc.cr-expfo = true then true else false )
     3625     col-trn = col-trn + 1
     3626     .
     3627   define variable v-num-pl as integer no-undo .
