     4689           )
     4690       .
     4691    end.
     4692   end procedure.
     4693   procedure make-temp-obj-firm :
     4694    do
     4695    on error undo, return error return-value
     4696    :
     4697    define buffer buf_shop for shop .
     4698    define buffer buf_store for store .
     4699   for each temp-obj-firm : delete temp-obj-firm. end.
     4700       for each buf_shop no-lock where buf_shop.host-code = par-host-code  on error undo, return error :
     4701           create temp-obj-firm.
     4702           assign
     4703             temp-obj-firm.obj-code = buf_shop.obj-code
     4704             temp-obj-firm.obj-type = 'маг':U
     4705           .
     4706       end.
     4707       for each buf_store no-lock where buf_store.host-code = par-host-code  on error undo, return error :
     4708           create temp-obj-firm.
     4709           assign
     4710             temp-obj-firm.obj-code = buf_store.obj-code
     4711             temp-obj-firm.obj-type = 'скл':U
     4712           .
     4713       end.
     4714    end.
     4715   end procedure.
     4716   procedure make-bfo :
     4717    do
     4718    on error undo, return error return-value
     4719    :
     4720   define input parameter v-sum-rubl as decimal no-undo .
     4721   define input parameter v-sum-base as decimal no-undo .
     4722   define input parameter v-sum-contract as decimal no-undo .
