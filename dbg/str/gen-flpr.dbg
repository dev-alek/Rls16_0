     4942                 buf_fin-ob-trn.host-code      = par-host-code
     4943                 buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     4944                 buf_fin-ob-trn.sum-tax-rubl   = n-sum-tax-rubl
     4945                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     4946                 buf_fin-ob-trn.is-corr        = true
     4947               .
     4948               end.
     4949                   find first buf3_trn-doc  exclusive-lock  where buf3_trn-doc.doc-code = buf_trn-doc.doc-code no-error .
     4950                   if available buf3_trn-doc then do:
     4951                       assign
     4952                         buf3_trn-doc.cr-expfo      = true
     4953                         buf3_trn-doc.cr-incorexpfo = true
     4954                         buf3_trn-doc.expfo-date    = today
     4955                        .
