     4985   end procedure.
     4986   procedure make-tax-before :
     4987    do
     4988    on error undo, return error return-value
     4989    :
     4990   define input parameter p-doc-code as character no-undo .
     4991   define input parameter p-host-code as integer no-undo .
     4992   define buffer buf_fin-gds-part for  fin-gds-part .
     4993   define buffer buf_fin-ob-tax-before   for  fin-ob-tax-before .
     4994   define buffer buf_fin-ob-before       for  fin-ob-before     .
     4995   define variable v-line    as integer no-undo .
     4996   define variable v-sum     as decimal no-undo .
     4997   define variable v-tax-sum as decimal no-undo .
     4998   define variable v-tax-sum-rubl as decimal no-undo .
     4999   define variable v-tax-sum-base as decimal no-undo .
     5000   define variable v-tax-sum-contr as decimal no-undo .
     5001   define variable v-tax-sum-doc  as decimal no-undo .
     5002   for each buf_fin-ob-before  exclusive-lock  where  buf_fin-ob-before.host-code   = p-host-code and
     5003                                                      buf_fin-ob-before.before-code = p-doc-code
     5004                                                      on error undo, return error :
     5005       v-tax-sum-rubl = 0 .
     5006       v-tax-sum-base = 0 .
     5007       v-tax-sum-contr = 0 .
     5008       v-tax-sum-doc  = 0 .
     5009       v-sum  = 0 .
     5010       v-line = 0 .
     5011       for each buf_fin-gds-part no-lock where
     5012                buf_fin-gds-part.host-code   = buf_fin-ob-before.host-code and
     5013                buf_fin-gds-part.fin-ob-code = buf_fin-ob-before.before-code
     5014                break  by buf_fin-gds-part.SLT-pc
     5015                       by buf_fin-gds-part.SLT-type
     5016                       by buf_fin-gds-part.vat-pc
     5017                       by buf_fin-gds-part.vat-type
     5018                       by buf_fin-gds-part.gds-code
     5019                on error undo, return error :
     5020                v-sum = v-sum + buf_fin-gds-part.sum-rubl .
     5021                if last-of(buf_fin-gds-part.gds-code) then do:
     5022                   v-line = v-line + 1.
     5023                   create buf_fin-ob-tax-before.
     5024                   assign
     5025                       buf_fin-ob-tax-before.before-code        = buf_fin-ob-before.before-code
     5026                       buf_fin-ob-tax-before.host-code          = buf_fin-ob-before.host-code
     5027                       buf_fin-ob-tax-before.line-num           = v-line
     5028                       buf_fin-ob-tax-before.slt-pc             = buf_fin-gds-part.slt-pc
     5029                       buf_fin-ob-tax-before.vat-pc             = buf_fin-gds-part.vat-pc
     5030                       buf_fin-ob-tax-before.with-slt           = true
     5031                       buf_fin-ob-tax-before.with-vat           = true
     5032                       buf_fin-ob-tax-before.sum-line-rubl      = v-sum
     5033                       buf_fin-ob-tax-before.sum-slt-line-rubl  = buf_fin-ob-tax-before.slt-PC *    buf_fin-ob-tax-before.sum-line-rubl  / ( 100 + buf_fin-ob-tax-before.slt-PC )
     5034                       buf_fin-ob-tax-before.sum-vat-line-rubl  = buf_fin-ob-tax-before.vat-PC * (( buf_fin-ob-tax-before.sum-line-rubl  -         buf_fin-ob-tax-before.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax-before.vat-PC))
     5035                       buf_fin-ob-tax-before.sum-line-base       = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-line-rubl
     5036                       buf_fin-ob-tax-before.sum-line-doc        = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-line-rubl
     5037                       buf_fin-ob-tax-before.sum-line-contr      = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-line-rubl
     5038                       buf_fin-ob-tax-before.sum-slt-line-base    = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-slt-line-rubl
     5039                       buf_fin-ob-tax-before.sum-slt-line-doc     = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-slt-line-rubl
     5040                       buf_fin-ob-tax-before.sum-slt-line-contr   = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-slt-line-rubl
     5041                       buf_fin-ob-tax-before.sum-vat-line-base    = ( buf_fin-ob-before.base-scale     / buf_fin-ob-before.base-rate)     * buf_fin-ob-tax-before.sum-vat-line-rubl
     5042                       buf_fin-ob-tax-before.sum-vat-line-doc     = ( buf_fin-ob-before.exch-scale     / buf_fin-ob-before.exch-rate)     * buf_fin-ob-tax-before.sum-vat-line-rubl
     5043                       buf_fin-ob-tax-before.sum-vat-line-contr   = ( buf_fin-ob-before.contract-scale / buf_fin-ob-before.contract-rate) * buf_fin-ob-tax-before.sum-vat-line-rubl
     5044                       .
     5045                   assign
     5046                       buf_fin-ob-tax-before.with-slt-orig                = buf_fin-ob-tax-before.with-slt
     5047                       buf_fin-ob-tax-before.slt-pc-orig                  = buf_fin-ob-tax-before.slt-pc
     5048                       buf_fin-ob-tax-before.vat-pc-orig                  = buf_fin-ob-tax-before.vat-pc
     5049                       buf_fin-ob-tax-before.sum-slt-line-doc-orig        = buf_fin-ob-tax-before.sum-slt-line-doc
     5050                       buf_fin-ob-tax-before.sum-slt-line-base-orig       = buf_fin-ob-tax-before.sum-slt-line-base
     5051                       buf_fin-ob-tax-before.sum-slt-line-contr-orig      = buf_fin-ob-tax-before.sum-slt-line-contr
     5052                       buf_fin-ob-tax-before.sum-slt-line-rubl-orig       = buf_fin-ob-tax-before.sum-slt-line-rubl
     5053                       buf_fin-ob-tax-before.with-vat-orig                = buf_fin-ob-tax-before.with-vat
     5054                       buf_fin-ob-tax-before.sum-vat-line-doc-orig        = buf_fin-ob-tax-before.sum-vat-line-doc
     5055                       buf_fin-ob-tax-before.sum-vat-line-base-orig       = buf_fin-ob-tax-before.sum-vat-line-base
     5056                       buf_fin-ob-tax-before.sum-vat-line-contr-orig      = buf_fin-ob-tax-before.sum-vat-line-contr
     5057                       buf_fin-ob-tax-before.sum-vat-line-rubl-orig       = buf_fin-ob-tax-before.sum-vat-line-rubl
     5058                   .
     5059                   assign
     5060                       v-tax-sum-rubl                    = v-tax-sum-rubl + buf_fin-ob-tax-before.sum-slt-line-rubl   + buf_fin-ob-tax-before.sum-vat-line-rubl
     5061                       v-tax-sum-base                    = v-tax-sum-base + buf_fin-ob-tax-before.sum-slt-line-base   + buf_fin-ob-tax-before.sum-vat-line-base
     5062                       v-tax-sum-contr                   = v-tax-sum-contr + buf_fin-ob-tax-before.sum-slt-line-contr + buf_fin-ob-tax-before.sum-vat-line-contr
     5063                       v-tax-sum-doc                     = v-tax-sum-doc + buf_fin-ob-tax-before.sum-slt-line-doc     + buf_fin-ob-tax-before.sum-vat-line-doc
     5064                   .
     5065                   v-sum  = 0 .
     5066                 end.
     5067       end.
     5068       buf_fin-ob-before.sum-tax-doc   = v-tax-sum-doc .
     5069       buf_fin-ob-before.sum-tax-rubl  = v-tax-sum-rubl .
     5070       buf_fin-ob-before.sum-tax-base  = v-tax-sum-base .
     5071       buf_fin-ob-before.sum-tax-contract = v-tax-sum-contr .
     5072       v-tax-sum-rubl = 0 .
     5073       v-tax-sum-base = 0 .
     5074       v-tax-sum-contr = 0 .
     5075       v-tax-sum-doc  = 0 .
     5076   end.
     5077    end.
     5078   end procedure.
     5079   procedure make-fo-corr :
     5080    do
     5081    on error undo, return error return-value
     5082    :
     5083   define input parameter v-sum-rubl as decimal no-undo .
     5084   define input parameter v-sum-base as decimal no-undo .
     5085   define input parameter v-sum-contract as decimal no-undo .
     5086    define variable pfo as logical no-undo .
