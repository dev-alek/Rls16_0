     3846                                           input var-sum-base ,
     3847                                           input var-sum-contract
     3848                                           ) no-error .
     3849                             if error-status :error then  do:
     3850                                col-fo = col-fo - 1.
     3851                                p-res = p-res + chr(10) + error-status :get-message(1) .
     3852                             end.
     3853                             var-sum-rubl = 0 .
     3854                             var-sum-base = 0 .
     3855                             var-sum-contract = 0 .
     3856                         end.
     3857                     end.
     3858               end.
     3859         end.
     3860    end.
     3861   end procedure.
     3862   procedure proc-body-corr-acc :
     3863    do
     3864    on error undo, return error return-value
     3865    :
     3866   define variable sum-gds-code as decimal no-undo .
     3867   define buffer buf_minus-parts for c-parts.
     3868   define variable v-flag-po as logical no-undo .
     3869   define variable v-flag-ex as logical no-undo .
     3870   define variable v-may-be as logical   no-undo .
     3871   if buf_trn-doc.ext-doc-type <> 'ap':U then return.
     3872   if buf_trn-doc.is-del     = false                     then return.
     3873   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_doc-fogn in g#libofarh (
     3874    input 'del'
     3875   ,input 'рас':U
     3876   ,input buf_trn-doc.doc-code
     3877   ,input g#db-num
     3878   ,output v-may-be
     3879   )
     3880   .
     3881   if v-may-be = false then do:
     3882      p-res = p-res + chr(10) + substitute("По документу &1 нельзя создавать ФО в этой БД" , buf_trn-doc.doc-code ) .
     3883      return .
     3884   end.
     3885   assign
     3886     v-flag-po = ( if buf_trn-doc.cr-incfo = true then true else false )
     3887     v-flag-ex = ( if buf_trn-doc.cr-expfo = true then true else false )
     3888   .
     3889          col-trn = col-trn + 1 .
     3890   var-sum-rubl = 0 .
     3891   var-sum-base = 0 .
     3892   var-sum-contract = 0 .
     3893         if ( col-trn  modulo temp1 = 0 ) and ( col-trn >= temp1 ) then run waitfram-show( "Обработано накладных : " + string( col-trn )) .
     3894         for each buf_parts no-lock where buf_parts.out-code  = buf_trn-doc.doc-code   and
     3895                                          buf_parts.in-code   <> buf_trn-doc.doc-code   and
     3896                                          buf_parts.host-code = buf_trn-doc.host-code  and
     3897                                          buf_parts.obj-type  = buf_trn-doc.obj-type   and
     3898                                          buf_parts.obj-code  = buf_trn-doc.obj-code   and
     3899                                          buf_parts.fact-qnty < 0  ,
     3900                 first buf_contract no-lock where buf_contract.contract-code = buf_parts.contract-code and
     3901                                                  buf_contract.host-code     = buf_parts.host-code     and
     3902                                                  lookup(buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0    and
     3903                                                  v-flag-po = false
     3904                 break
     3905                       by buf_parts.contract-code
     3906                       by buf_parts.vat-pc
     3907                       on error undo, return error  :
     3908                 Run clc-price.
     3909                 find first buf_goods no-lock where buf_goods.artic     = buf_parts.artic      and
     3910                                                   buf_goods.prod-type = buf_parts.prod-type  and
     3911                                                   buf_goods.prod-code = buf_parts.prod-code .
     3912                 find first buf_parts-attr no-lock where buf_parts-attr.in-code   = buf_parts.in-code   and
     3913                                                    buf_parts-attr.part-code = buf_parts.part-code and
     3914                                                    buf_parts-attr.gds-code  = buf_goods.gds-code .
     3915                     assign
     3916                             var-sum-rubl     = var-sum-rubl     +  abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )
     3917                             var-sum-contract = var-sum-contract +  abs(tt-allsum.sum-dsc-cli-acc                                                                )
     3918                             var-sum-base     = var-sum-base     +  abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )
     3919                     .
     3920                     create temp-parts.
     3921                     BUFFER-COPY buf_parts to temp-parts
     3922                     assign
     3923                       temp-parts.cli-qnty       =  (-1) * abs( buf_parts.cli-qnty)    * (-1)
     3924                       temp-parts.fact-qnty      =  (-1) * abs( buf_parts.fact-qnty)   * (-1)
     3925                       temp-parts.qnty           =  (-1) * abs( buf_parts.qnty     )   * (-1)
     3926                       temp-parts.gds-code       =  buf_goods.gds-code
     3927                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     3928                       var-income-in-code        =  buf_parts-attr.income-in-code
     3929                     .
     3930               if last-of(buf_parts.contract-code) or (p-nalog = 2 and last-of(buf_parts.vat-pc)) then do:
     3931                 run make-fo-corr ( input var-sum-rubl ,
     3932                                        input var-sum-base ,
     3933                                        input var-sum-contract )
     3934                                        no-error .
     3935                 if error-status :error then p-res = p-res + chr(10) + error-status :get-message(1) .
     3936                 var-sum-rubl = 0 .
     3937                 var-sum-rublb = 0 .
     3938                 var-sum-base      = 0 .
     3939                 var-sum-baseb     = 0 .
     3940                 var-sum-contract  = 0 .
     3941                 var-sum-contractb = 0 .
     3942               end.
     3943         end.
     3944   var-sum-rubl  = 0 .
     3945   var-sum-rublb = 0 .
     3946   var-sum-base      = 0 .
     3947   var-sum-baseb     = 0 .
     3948   var-sum-contract  = 0 .
     3949   var-sum-contractb = 0 .
     3950         for each buf_parts no-lock where buf_parts.out-code  = buf_trn-doc.doc-code   and
     3951                                          buf_parts.in-code   = buf_trn-doc.doc-code   and
     3952                                          buf_parts.host-code = buf_trn-doc.host-code  and
     3953                                          buf_parts.obj-type  = buf_trn-doc.obj-type   and
     3954                                          buf_parts.obj-code  = buf_trn-doc.obj-code   and
     3955                                          buf_parts.fact-qnty >= 0     ,
     3956                 first buf_goods no-lock where buf_goods.artic     = buf_parts.artic      and
     3957                                               buf_goods.prod-type = buf_parts.prod-type  and
     3958                                               buf_goods.prod-code = buf_parts.prod-code ,
     3959                 first buf_contract no-lock where buf_contract.contract-code = buf_parts.contract-code and
     3960                                                  buf_contract.host-code     = buf_parts.host-code     and
     3961                                                  lookup(buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0 and
     3962                                                  v-flag-po = false
     3963                 break
     3964                       by buf_parts.contract-code
     3965                       by buf_parts.vat-pc
     3966                       on error undo, return error :
