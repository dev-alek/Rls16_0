     2963     (input  bf_trn-doc.obj-type
     2964     ,input  bf_trn-doc.obj-code
     2965     ,input  varb-code
     2966     ,input  0
     2967     ,input  bf_trn-doc.fact-order
     2968     ,output vardoc-num
     2969     ,output varprice-sale
     2970     ,output varroad-tax
     2971     ,output varexcise
     2972     )  .
     2973             if varprice-sale = ?
     2974             then do:
     2975               assign
     2976                 varprice-sale = 0
     2977                 varroad-tax   = 0
     2978                 varexcise     = 0
     2979               .
     2980             end.
     2981             assign
     2982               varlastcur-base     = varprice-sale
     2983               varlastcur-road-tax = varroad-tax
     2984               varlastcur-excise   = varexcise
     2985               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2986               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2987               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2988               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2989             .
     2990         end.
     2991       end.
     2992       if varcur-fact-qnty = 0 then do:
     2993         assign
     2994           varcur-base      = varlastcur-base
     2995           varcur-road-tax  = varlastcur-road-tax
     2996           varcur-excise    = varlastcur-excise
     2997         .
     2998       end.
     2999       else do:
     3000         assign
     3001           varcur-base      = varcur-base      / varcur-fact-qnty
     3002           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3003           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3004         .
     3005       end.
     3006       if varcur-vat-pc = ?
     3007       then do:
     3008         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3009       end.
