     4613       input  n-sum-tax-contract    ,
     4614       input  "Корректирующее ФО "  ,
     4615       output p-ri )
     4616       no-error .
     4617     col-fo = col-fo + 1.
     4618     for each tt-trn-code  where
     4619         tt-trn-code.contract-code = buf_contract.contract-code  and
     4620         tt-trn-code.host-code     = par-host-code
     4621         on error undo, return error :
     4622           find first  buf_fin-ob-trn no-lock  where
     4623                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     4624                 buf_fin-ob-trn.host-code      = par-host-code  and
     4625                 buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code  no-error .
     4626                 if not available  buf_fin-ob-trn then  do:
