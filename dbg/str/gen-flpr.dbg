      933   define variable var-doc             as decimal no-undo .
      934   define variable var-doc-slt         as decimal no-undo .
      935   define variable var-doc-vat         as decimal no-undo .
      936   define variable v-basecode as integer no-undo .
      937   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      939     (input  p-host-code
      940     ,output v-basecode
      941     )  .
      942   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      943                                               buf_fin-ob.doc-code  = p-doc-code
      944                                               on error undo, return error :
      945      assign
      946       v-tax-sum-rubl  = 0
      947       v-tax-sum-base  = 0
      948       v-tax-sum-contr = 0
      949       v-tax-sum-doc   = 0
      950       v-sum           = 0
      951       v-sum-rubl      = 0
      952       v-sum-base      = 0
      953       v-sum-contract  = 0
      954       v-sum-vat       = 0
      955       v-sum-rubl-vat  = 0
      956       v-sum-base-vat  = 0
      957       v-sum-contract-vat  = 0
      958       v-sum-slt           = 0
      959       v-sum-rubl-slt      = 0
      960       v-sum-base-slt      = 0
      961       v-sum-contract-slt  = 0
      962       v-line = 0
      963       .
      964       for each buf_fin-gds-part no-lock where
      965                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      966                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      967                break  by buf_fin-gds-part.SLT-pc
      968                       by buf_fin-gds-part.vat-pc
      969                on error undo, return error :
      970                 case buf_fin-ob.curr-code:
      971                   when 0 then do :
      972                   assign
      973                   var-doc      =  buf_fin-gds-part.sum-rubl
      974                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
      975                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
      976                   .
      977                   end.
      978                   when v-basecode then do :
      979                   assign
      980                   var-doc      =  buf_fin-gds-part.sum-base
      981                   var-doc-slt  =  buf_fin-gds-part.slt-base
      982                   var-doc-vat  =  buf_fin-gds-part.vat-base
      983                   .
      984                   end.
      985                   when buf_fin-ob.contract-curr then do :
      986                   assign
      987                   var-doc      =  buf_fin-gds-part.sum-contract
      988                   var-doc-slt  =  buf_fin-gds-part.slt-contract
      989                   var-doc-vat  =  buf_fin-gds-part.vat-contract
      990                   .
      991                   end.
      992                 end case.
      993                assign
      994                  v-sum           = v-sum          + var-doc
      995                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
      996                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
      997                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
      998                  v-sum-slt           = v-sum-slt          + var-doc-slt
      999                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     1000                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     1001                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     1002                  v-sum-vat           = v-sum-vat          + var-doc-vat
     1003                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     1004                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     1005                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     1006                .
     1007                if last-of(buf_fin-gds-part.vat-pc) then do:
     1008                   v-line = v-line + 1.
     1009                   create buf_fin-ob-tax.
     1010                   assign
     1011                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1012                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1013                       buf_fin-ob-tax.line-num           = v-line
     1014                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1015                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1016                       buf_fin-ob-tax.with-slt           = true
     1017                       buf_fin-ob-tax.with-vat           = true
     1018                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     1019                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     1020                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     1021                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     1022                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     1023                       buf_fin-ob-tax.sum-line-doc        = v-sum
     1024                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     1025                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     1026                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     1027                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     1028                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     1029                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     1030                       .
     1031                       assign
     1032                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1033                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1034                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1035                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1036                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1037                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1038                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1039                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1040                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1041                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1042                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1043                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1044                       .
     1045                       assign
     1046                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     1047                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     1048                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     1049                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     1050                       .
     1051                       assign
     1052                       v-sum  = 0
     1053                       v-sum-rubl      = 0
     1054                       v-sum-base      = 0
     1055                       v-sum-contract  = 0
     1056                       v-sum-slt           =0
     1057                       v-sum-rubl-slt      =0
     1058                       v-sum-base-slt      =0
     1059                       v-sum-contract-slt  =0
     1060                       v-sum-vat           =0
     1061                       v-sum-rubl-vat      =0
     1062                       v-sum-base-vat      =0
     1063                       v-sum-contract-vat  =0
     1064                       .
     1065                 end.
     1066       end.
     1067       assign
     1068         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     1069         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     1070         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     1071         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     1072         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     1073         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     1074         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     1075         buf_fin-ob.base-scale       = 1
     1076         buf_fin-ob.exch-scale       = 1
     1077         buf_fin-ob.contract-scale   = 1
     1078       .
     1079       assign
     1080       v-tax-sum-rubl  = 0
     1081       v-tax-sum-base  = 0
     1082       v-tax-sum-contr = 0
     1083       v-tax-sum-doc   = 0
     1084       v-sum-vat          = 0
     1085       v-sum-rubl-vat     = 0
     1086       v-sum-base-vat     = 0
     1087       v-sum-contract-vat    = 0
     1088       v-sum-slt          = 0
     1089       v-sum-rubl-slt     = 0
     1090       v-sum-base-slt     = 0
     1091       v-sum-contract-slt    = 0
     1092       .
     1093   end.
     1094    end.
     1095   end procedure.
     1096   procedure update-fin-ob_obj :
     1097    do
     1098    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1099    :
     1100   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1101   define input parameter p-host-code as integer no-undo .
     1102   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1103   define buffer buf_fin-ob       for  ub.fin-ob     .
     1104   define variable v-obj-code as integer no-undo init 0 .
     1105   define variable v-obj-type as character no-undo init "" .
     1106   define variable var-fin-calc as integer no-undo .
     1107   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     1108   var-fin-calc = ub.sysconf.fin-calc   .
     1109   if var-fin-calc = 0 then return.
     1110   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1111                                               buf_fin-ob.doc-code = p-doc-code
     1112                                               on error undo, return error :
     1113       for each buf_fin-gds-part no-lock where
     1114                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1115                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1116                on error undo, return error :
     1117             assign
     1118                v-obj-code  =  buf_fin-gds-part.obj-code
     1119                v-obj-type  =  buf_fin-gds-part.obj-type
     1120                .
     1121              leave.
     1122       end.
     1123       assign
     1124         buf_fin-ob.obj-code  =   v-obj-code
     1125         buf_fin-ob.obj-type  =   v-obj-type
     1126       .
     1127   end.
     1128    end.
     1129   end procedure.
     1130   procedure make-tax-rubl :
     1131    do
     1132    on error undo, return error return-value
     1133    :
     1134   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     1135   define input parameter p-host-code as integer no-undo .
     1136   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1137   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1138   define buffer buf_fin-ob       for  ub.fin-ob     .
     1139   define variable v-line    as integer no-undo .
     1140   define variable v-sum         as decimal no-undo .
     1141   define variable v-tax-sum       as decimal no-undo .
     1142   define variable v-tax-sum-rubl  as decimal no-undo .
     1143   define variable v-tax-sum-base  as decimal no-undo .
     1144   define variable v-tax-sum-contr as decimal no-undo .
     1145   define variable v-tax-sum-doc   as decimal no-undo .
     1146   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1147                                               buf_fin-ob.doc-code = p-doc-code
     1148                                               on error undo, return error :
     1149      assign
     1150       v-tax-sum-rubl = 0
     1151       v-tax-sum-base = 0
     1152       v-tax-sum-contr = 0
     1153       v-tax-sum-doc  = 0
     1154       v-sum          = 0
     1155       v-line = 0
     1156       .
     1157       for each buf_fin-gds-part no-lock where
     1158                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1159                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1160                break  by buf_fin-gds-part.SLT-pc
     1161                       by buf_fin-gds-part.vat-pc
     1162                on error undo, return error :
     1163                assign
     1164                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     1165                .
     1166                if last-of(buf_fin-gds-part.vat-pc) then do:
     1167                   v-line = v-line + 1.
     1168                   create buf_fin-ob-tax.
     1169                   assign
     1170                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1171                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1172                       buf_fin-ob-tax.line-num           = v-line
     1173                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1174                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1175                       buf_fin-ob-tax.with-slt           = true
     1176                       buf_fin-ob-tax.with-vat           = true
     1177                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     1178                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     1179                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     1180                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     1181                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     1182                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     1183                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1184                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1185                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     1186                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1187                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1188                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     1189                       .
     1190                       assign
     1191                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1192                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1193                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1194                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1195                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1196                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1197                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1198                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1199                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1200                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1201                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1202                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1203                       .
     1204                       assign
     1205                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     1206                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     1207                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     1208                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     1209                       .
     1210                       v-sum  = 0 .
     1211                 end.
     1212       end.
     1213       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     1214       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     1215       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     1216       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     1217       v-tax-sum-rubl  = 0 .
     1218       v-tax-sum-base  = 0 .
     1219       v-tax-sum-contr = 0 .
     1220       v-tax-sum-doc   = 0 .
     1221   end.
     1222    end.
     1223   end procedure.
     1224   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   define new global shared variable g#lib-trn  as handle no-undo .
     1226   define new global shared variable g#lib-trn2 as handle no-undo .
     1227   define new global shared variable g#lib-trn3 as handle no-undo .
     1228   define new global shared variable g#lib-trn4 as handle no-undo .
     1229   define temp-table tt-allsum-line      no-undo
     1230   field sum-type           as   character
     1231   field fact-qnty          like ub.doc-line.fact-qnty
     1232   field cli-qnty           like ub.doc-line.cli-qnty
     1233   field sum-dsc-base-doc   like ub.doc-line.price-base
     1234   field sum-dsc-rubl-doc   like ub.doc-line.price-base
     1235   field dsc-base-doc       like ub.doc-line.price-base
     1236   field dsc-rubl-doc       like ub.doc-line.price-base
     1237   field vat-base-doc       like ub.doc-line.price-base
     1238   field vat-rubl-doc       like ub.doc-line.price-base
     1239   field vat-base-buyer-doc like ub.doc-line.price-base
     1240   field vat-rubl-buyer-doc like ub.doc-line.price-base
     1241   field slt-base-doc       like ub.doc-line.price-base
     1242   field slt-rubl-doc       like ub.doc-line.price-base
     1243   field road-tax-base-doc  like ub.doc-line.price-base
     1244   field road-tax-rubl-doc  like ub.doc-line.price-base
     1245   field excise-base-doc    like ub.doc-line.price-base
     1246   field excise-rubl-doc    like ub.doc-line.price-base
     1247   field sum-dsc-base-acc   like ub.doc-line.price-base
     1248   field sum-dsc-rubl-acc   like ub.doc-line.price-base
     1249   field sum-dsc-cli-acc    like ub.doc-line.price-cli
     1250   field dsc-base-acc       like ub.doc-line.price-base
     1251   field dsc-rubl-acc       like ub.doc-line.price-base
     1252   field dsc-cli-acc        like ub.doc-line.price-cli
     1253   field vat-base-acc       like ub.doc-line.price-base
     1254   field vat-rubl-acc       like ub.doc-line.price-base
     1255   field vat-cli-acc        like ub.doc-line.price-cli
     1256   field slt-base-acc       like ub.doc-line.price-base
     1257   field slt-rubl-acc       like ub.doc-line.price-base
     1258   field slt-cli-acc        like ub.doc-line.price-cli
     1259   field road-tax-base-acc  like ub.doc-line.price-base
     1260   field road-tax-rubl-acc  like ub.doc-line.price-base
     1261   field road-tax-cli-acc   like ub.doc-line.price-cli
     1262   field excise-base-acc    like ub.doc-line.price-base
     1263   field excise-rubl-acc    like ub.doc-line.price-base
     1264   field excise-cli-acc     like ub.doc-line.price-cli
     1265   field transport-base-acc like ub.doc-line.price-base
     1266   field transport-rubl-acc like ub.doc-line.price-base
     1267   field transport-cli-acc  like ub.doc-line.price-cli
     1268   field other-base-acc     like ub.doc-line.price-base
     1269   field other-rubl-acc     like ub.doc-line.price-base
     1270   field other-cli-acc      like ub.doc-line.price-cli
     1271   field sum-dsc-base-cur   like ub.doc-line.price-base
     1272   field sum-dsc-rubl-cur   like ub.doc-line.price-base
     1273   field dsc-base-cur       like ub.doc-line.price-base
     1274   field dsc-rubl-cur       like ub.doc-line.price-base
     1275   field vat-base-cur       like ub.doc-line.price-base
     1276   field vat-rubl-cur       like ub.doc-line.price-base
     1277   field vat-base-buyer-cur like ub.doc-line.price-base
     1278   field vat-rubl-buyer-cur like ub.doc-line.price-base
     1279   field slt-base-cur       like ub.doc-line.price-base
     1280   field slt-rubl-cur       like ub.doc-line.price-base
     1281   field road-tax-base-cur  like ub.doc-line.price-base
     1282   field road-tax-rubl-cur  like ub.doc-line.price-base
     1283   field excise-base-cur    like ub.doc-line.price-base
     1284   field excise-rubl-cur    like ub.doc-line.price-base
     1285   index sum-type is primary unique sum-type.
     1286   .
     1287   define temp-table tt-allsum no-undo
     1288   field sum-type           as   character
     1289   field fact-qnty             as decimal
     1290   field cli-qnty              as decimal
     1291   field sum-dsc-base-doc      as decimal
     1292   field sum-dsc-rubl-doc      as decimal
     1293   field dsc-base-doc          as decimal
     1294   field dsc-rubl-doc          as decimal
