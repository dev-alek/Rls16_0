     4628               assign
     4629                 buf_fin-ob-trn.doc-code       = p-doc-code
     4630                 buf_fin-ob-trn.host-code      = par-host-code
     4631                 buf_fin-ob-trn.sum-rubl       = tt-trn-code.sum-rubl
     4632                 buf_fin-ob-trn.sum-tax-rubl   = 0
     4633                 buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code
     4634                 buf_fin-ob-trn.is-corr        = true
     4635               .
     4636               end.
     4637         find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = tt-trn-code.doc-code no-error .
     4638         if available buf2_trn-doc then do:
     4639           if lookup( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)'  ) > 0 then do:
     4640               assign
