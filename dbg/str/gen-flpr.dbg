     5697   procedure ver-prc :
     5698    do
     5699    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5700    :
     5701   define input parameter p-fo-code  like ub.fin-ob.doc-code no-undo .
     5702   define output parameter p-GT as logical no-undo .
     5703   define buffer bufv_fin-ob-before for fin-ob-before.
     5704   define buffer bufv_contract for contract.
     5705   define buffer buf_incom-trn-doc for trn-doc.
     5706   define variable v-message-text as character no-undo .
     5707   define variable v-proc-contr as decimal no-undo .
     5708   define variable v-sum-pn as decimal no-undo .
     5709   define variable v-sum-ras as decimal no-undo .
     5710       for each bufv_fin-ob-before  exclusive-lock   where
     5711                bufv_fin-ob-before.doc-code     =  p-fo-code and
     5712                bufv_fin-ob-before.host-code    =  par-host-code
     5713                   break
     5714                   by bufv_fin-ob-before.doc-code
     5715                   on error undo, return error
     5716                   :
     5717           if first-of (bufv_fin-ob-before.doc-code) then do:
     5718             find first bufv_contract no-lock where bufv_contract.contract-code = bufv_fin-ob-before.contract-code no-error .
     5719             if available bufv_contract then v-proc-contr = bufv_contract.srok-opl .
     5720                                       else do:
     5721                                           v-proc-contr = 0 .
     5722                                           v-message-text =  v-message-text + chr(10)  + error-status :get-message(1) + " Вн.№ договора " + string(bufv_fin-ob-before.contract-code) .
     5723                                       end.
     5724             run sum-in-parts (
     5725                 input  bufv_fin-ob-before.trn-doc-code-orig ,
     5726                 input  bufv_fin-ob-before.contract-code ,
     5727                 output v-sum-pn
     5728                 ) .
     5729             v-sum-ras = 0 .
     5730           end.
     5731           bufv_fin-ob-before.status_ = 'авто':U .
     5732           v-sum-ras = v-sum-ras + bufv_fin-ob-before.sum-rubl .
     5733           if last-of (bufv_fin-ob-before.doc-code) then do:
     5734                 if ( 100 * v-sum-ras / v-sum-pn ) >=  v-proc-contr  then do:
     5735                     p-GT = false  .
     5736                 end.
     5737                 else do:
     5738                     p-GT = true  .
     5739                 end.
     5740           end.
     5741       end.
     5742    end.
     5743   end procedure.
     5744   procedure sum-in-parts :
     5745    do
     5746    on error undo, return error return-value
     5747    :
     5748   define input parameter  p-doc-code as character no-undo .
     5749   define input parameter  p-contract-code as integer no-undo .
     5750   define output parameter p-sum-pn  as decimal init 0 no-undo .
     5751   define buffer bufi_parts for parts.
     5752   define buffer bufi_trn-doc for trn-doc.
     5753   define buffer bufi_c-parts for c-parts.
     5754   define buffer bufi_c-trn-doc for c-trn-doc.
     5755   find first bufi_trn-doc no-lock where bufi_trn-doc.doc-code = p-doc-code no-error .
     5756   if available bufi_trn-doc then do:
     5757         for each bufi_parts no-lock where
     5758                 bufi_parts.contract-code = p-contract-code and
     5759                 bufi_parts.out-code      = bufi_trn-doc.doc-code and
     5760                 bufi_parts.obj-code      = bufi_trn-doc.obj-code and
     5761                 bufi_parts.obj-type      = bufi_trn-doc.obj-type and
     5762                 bufi_parts.host-code     = bufi_trn-doc.host-code
     5763             on error undo, return error :
     5764             p-sum-pn = p-sum-pn +  ( bufi_parts.fact-qnty * bufi_parts.price-rubl)  .
     5765         end.
     5766   end.
     5767   else do:
     5768     find first bufi_c-trn-doc no-lock where bufi_c-trn-doc.doc-code = p-doc-code no-error .
     5769         if available bufi_c-trn-doc then do:
     5770             for each bufi_c-parts no-lock where
     5771                       bufi_c-parts.contract-code = p-contract-code and
     5772                       bufi_c-parts.out-code      = bufi_c-trn-doc.doc-code and
     5773                       bufi_c-parts.obj-code      = bufi_c-trn-doc.obj-code and
     5774                       bufi_c-parts.obj-type      = bufi_c-trn-doc.obj-type and
     5775                       bufi_c-parts.host-code     = bufi_c-trn-doc.host-code
     5776                 on error undo, return error :
     5777                 p-sum-pn = p-sum-pn +  ( bufi_c-parts.fact-qnty * bufi_c-parts.price-rubl)  .
     5778             end.
     5779       end.
     5780   end.
     5781    end.
     5782   end procedure.
     5783   procedure make-s-fo-obj :
     5784    do
     5785    on error undo, return error return-value
     5786    :
     5787   define input parameter v-sum-rubl as decimal no-undo .
     5788   define input parameter v-sum-base as decimal no-undo .
     5789   define input parameter v-sum-contract as decimal no-undo .
     5790   define input parameter p-obj-type as character no-undo  .
     5791   define input parameter p-obj-code as integer no-undo    .
     5792   define input parameter v-pc       as decimal   no-undo .
     5793   v-pc = if p-nalog = 1 then 0 else v-pc.
     5794    define variable pfo as logical no-undo .
     5795    pfo = false  .
     5796   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5797   define variable p-ri       as recid   no-undo .
     5798   define variable p-doc-code             like         ub.fin-ob.doc-code         no-undo .
     5799   define variable n-doc-date             like         ub.fin-ob.doc-date         no-undo .
     5800   define variable n-doc-type             like     ub.fin-ob.doc-type             no-undo .
     5801   define variable n-payer-name           like         ub.fin-ob.payer-name       no-undo .
     5802   define variable n-receiver-name        like         ub.fin-ob.receiver-name    no-undo .
     5803   define variable n-curr-code            like         ub.fin-ob.curr-code        no-undo .
     5804   define variable n-sum-doc              like         ub.fin-ob.sum-doc          no-undo .
     5805   define variable n-user-db-num-doc      like         ub.fin-ob.user-db-num-doc  no-undo .
     5806   define variable n-user-name-doc        like         ub.fin-ob.user-name-doc    no-undo .
     5807   define variable n-base-rate            like         ub.fin-ob.base-rate        no-undo .
     5808   define variable n-base-scale           like         ub.fin-ob.base-scale       no-undo .
     5809   define variable n-receiver-code        like         ub.fin-ob.receiver-code    no-undo .
     5810   define variable n-receiver-type        like         ub.fin-ob.receiver-type    no-undo .
     5811   define variable n-contract-code        like         ub.fin-ob.contract-code    no-undo .
     5812   define variable n-exch-rate            like         ub.fin-ob.exch-rate        no-undo .
