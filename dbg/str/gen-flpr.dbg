     3777                                   var-sum-contract = var-sum-contract + (v-sign) * abs(tt-allsum.sum-dsc-cli-acc                                                                )   * (-1)
     3778                                   var-sum-base     = var-sum-base     + (v-sign) * abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )  * (-1)
     3779                           .
     3780                     create temp-parts.
