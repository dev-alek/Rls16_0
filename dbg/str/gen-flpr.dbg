     4586       input  n-exch-scale          ,
     4587       input  n-contract-curr       ,
     4588       input  n-contract-rate       ,
     4589       input  n-contract-scale      ,
     4590       input  n-fact-date           ,
     4591       input  n-fact-order          ,
     4592       input  par-host-code         ,
     4593       input  n-payer-code          ,
     4594       input  n-payer-type          ,
     4595       input  n-pay-date            ,
     4596       input  string(p-doc-code)    ,
     4597       input  'авто':U            ,
