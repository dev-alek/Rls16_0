     5638                 new_fin-gds-part.slt-contract-orig   = -1 * buf-sm_fin-gds-part.slt-contract-orig
     5639                 new_fin-gds-part.slt-contract        = -1 * buf-sm_fin-gds-part.slt-contract
     5640                 new_fin-gds-part.slt-rubl-orig  = -1 * buf-sm_fin-gds-part.slt-rubl-orig
