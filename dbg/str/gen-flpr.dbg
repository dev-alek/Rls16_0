     3782                     assign
     3783                       temp-parts.cli-qnty       = v-sign * abs(buf_parts.cli-qnty)  * (-1)
     3784                       temp-parts.fact-qnty      = v-sign * abs(buf_parts.fact-qnty) * (-1)
     3785                       temp-parts.qnty           = v-sign * abs(buf_parts.qnty)      * (-1)
     3786                       temp-parts.gds-code       = buf_goods.gds-code
     3787                       temp-parts.income-in-code = buf_parts-attr.income-in-code
     3788                       var-income-in-code        = buf_parts-attr.income-in-code
     3789                     .
     3790                 end.
     3791            end.
     3792          end.
     3793               if last-of ( buf_parts-attr.income-in-code ) then do:
     3794                     if buf_contract.usl-opl = 'По реализации части приход. накладной':U  and
