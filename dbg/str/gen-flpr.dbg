     3102   procedure clcprtsl_calc-ttable :
     3103   define input parameter paris-doc           as   logical                 no-undo.
     3104   define input parameter paris-cur           as   logical                 no-undo.
     3105   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3106   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3107   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3108   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3109   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3110   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3111   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3112   define input parameter parr-b              as   character               no-undo.
     3113   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3114   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3115   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3116   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3117   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3118   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3119   define buffer bf_tt-allsum      for tt-allsum.
     3120   define buffer bf_tt-clcparts    for tt-clcparts.
     3121   define buffer bf_tt-allsum-line for tt-allsum-line.
     3122   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3123   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3124   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3125   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3126   define variable varexcise          like ub.price-list.excise     no-undo.
     3127   do on error undo, return error return-value :
     3128   for each bf_tt-allsum-line
     3129   on error undo, return error return-value
     3130    :
     3131     delete bf_tt-allsum-line.
     3132   end.
     3133   for each bf_tt-allsum
     3134   on error undo, return error return-value
     3135   :
     3136     delete bf_tt-allsum.
     3137   end.
     3138   for each bf_tt-clcparts
     3139   on error undo, return error return-value
     3140   :
     3141   if v-calcbypart then do:
     3142             assign
     3143             parcur-base =   bf_tt-clcparts.part-cur-base
     3144             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3145             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3146             .
     3147   end.
     3148      run clcprtsl_calc-parts in this-procedure (
     3149        input recid(bf_tt-clcparts),
