     5670                 new_fin-ob-tax.sum-line-rubl-orig      = -1 *  buf-sm_fin-ob-tax.sum-line-rubl-orig
     5671                 new_fin-ob-tax.sum-line-rubl           = -1 *  buf-sm_fin-ob-tax.sum-line-rubl
