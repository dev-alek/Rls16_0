     5815   define variable n-contract-rate        like         ub.fin-ob.contract-rate    no-undo .
     5816   define variable n-contract-scale       like         ub.fin-ob.contract-scale   no-undo .
     5817   define variable n-fact-date            like         ub.fin-ob.fact-date        no-undo .
     5818   define variable n-fact-order           like         ub.fin-ob.fact-order       no-undo .
     5819   define variable n-payer-code           like         ub.fin-ob.payer-code       no-undo .
     5820   define variable n-payer-type           like         ub.fin-ob.payer-type       no-undo .
     5821   define variable n-pay-date             like         ub.fin-ob.pay-date         no-undo .
     5822   define variable n-prn-doc-code         like         ub.fin-ob.prn-doc-code     no-undo .
     5823   define variable n-sum-base-orig        like         ub.fin-ob.sum-base-orig    no-undo .
     5824   define variable n-sum-base             like         ub.fin-ob.sum-base         no-undo .
     5825   define variable n-sum-doc-orig         like         ub.fin-ob.sum-doc-orig     no-undo .
     5826   define variable n-sum-rubl-orig        like         ub.fin-ob.sum-rubl-orig    no-undo .
     5827   define variable n-sum-rubl             like         ub.fin-ob.sum-rubl         no-undo .
     5828   define variable n-sum-contract         like         ub.fin-ob.sum-contract     no-undo .
     5829   define variable n-trn-doc-code         like         ub.fin-ob.trn-doc-code     no-undo .
     5830   define variable n-trn-doc-code-orig    like         ub.fin-ob.trn-doc-code     no-undo .
     5831   define variable n-user-db-num-fact     like         ub.fin-ob.user-db-num-fact no-undo .
     5832   define variable n-user-db-num-pay      like         ub.fin-ob.user-db-num-pay  no-undo .
     5833   define variable n-user-name-fact       like         ub.fin-ob.user-name-fact   no-undo .
     5834   define variable n-user-name-pay        like         ub.fin-ob.user-name-pay    no-undo .
     5835   define variable n-in-type              like         ub.fin-ob.in-type          no-undo .
     5836   define variable n-sum-tax-base         like         ub.fin-ob.sum-tax-base     no-undo .
     5837   define variable n-sum-tax-doc          like         ub.fin-ob.sum-tax-doc      no-undo .
     5838   define variable n-sum-tax-rubl         like         ub.fin-ob.sum-tax-rubl     no-undo .
     5839   define variable n-sum-tax-contract     like         ub.fin-ob.sum-tax-contract no-undo .
     5840   define variable n-obj-code             like         ub.fin-ob.obj-code       no-undo .
     5841   define variable n-obj-type             like         ub.fin-ob.obj-type       no-undo .
     5842   define variable col-part   as integer   no-undo .
     5843   define variable n-abbr-doc as character no-undo .
     5844   define variable v-date-pay as date      no-undo .
     5845   define variable var-date as date no-undo .
     5846   if not available buf_contract then return .
     5847   if not can-find (first temp-parts no-lock ) then return .
     5848   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5850     (input  par-host-code
     5851     ,input  today
     5852     ,output n-base-rate
     5853     ,output n-base-scale
     5854     )  .
     5855     n-curr-code          = buf_contract.curr-code.
     5856   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5858     (input  n-curr-code
     5859     ,input  today
     5860     ,output n-exch-rate
     5861     ,output n-exch-scale
     5862     ,output n-abbr-doc
     5863     )  .
     5864   assign
     5865     n-doc-type            =  'рас':U
     5866     n-receiver-code       =  buf_contract.cli-code
     5867     n-receiver-type       =  buf_contract.cli-type
     5868     n-receiver-name       =  buf_contract.cli-name
     5869     n-payer-code          =  par-host-code
     5870     n-payer-type          =  'орг':U
     5871     n-payer-name          =  buf_contract.own-name
     5872   .
     5873    if lookup ( buf_contract.usl-opl , "По факту поставки,По факту реализации,По реализации части приход. накладной") > 0
     5874      then v-date-pay = today  .
     5875      else dO:
     5876           if p-cons = 2 and available   buf_trn-doc then do:
     5877               var-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     5878               if var-date < today then var-date = today.
     5879               v-date-pay = var-date.
     5880           end.
     5881      end.
     5882    if p-cons = 2 then do:
     5883         if available   buf_trn-doc
     5884            then
     5885            assign
     5886              n-trn-doc-code       =  buf_trn-doc.doc-code
     5887            .
     5888            else  n-trn-doc-code       = ?   .
     5889        end.
     5890        else do:
     5891          if pfo = true and available   buf_trn-doc
     5892            then  assign
     5893              n-trn-doc-code       =  buf_trn-doc.doc-code
     5894            .
     5895            else  n-trn-doc-code      = ?   .
     5896        end.
     5897   assign
     5898     n-user-db-num-doc    = g#db-num
     5899     n-user-name-doc      = g#userid
     5900     n-contract-code      = buf_contract.contract-code
     5901     n-contract-curr      = n-curr-code
     5902     n-contract-rate      = n-exch-rate
     5903     n-contract-scale     = n-exch-scale
     5904     n-pay-date           = v-date-pay
     5905     n-sum-rubl-orig      = v-sum-rubl
     5906     n-sum-base-orig      =     v-sum-base
     5907     n-sum-contract       =    v-sum-contract
     5908     n-sum-base           = n-sum-base-orig
     5909     n-sum-doc-orig       = n-sum-contract
     5910     n-sum-doc            = n-sum-contract
     5911     n-sum-rubl           = n-sum-rubl-orig
     5912     n-trn-doc-code-orig  = if available  buf_parts-attr then buf_parts-attr.income-in-code else  ?
     5913     n-in-type            = 0
     5914     n-sum-tax-base       = 0
     5915     n-sum-tax-doc        = 0
     5916     n-sum-tax-rubl       = 0
     5917     n-sum-tax-contract   = 0
     5918     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     5919    .
     5920   define variable min-date as date no-undo .
     5921   define variable max-date as date no-undo .
     5922           for each tt-trn-code  where
     5923               tt-trn-code.contract-code = buf_contract.contract-code  and
     5924               tt-trn-code.host-code     = par-host-code and
     5925               tt-trn-code.pc            = v-pc          and
     5926               tt-trn-code.obj-type      = p-obj-type    and
     5927               tt-trn-code.obj-code      = p-obj-code
     5928               break by tt-trn-code.fact-date DESCENDING
     5929               on error undo, return error
     5930               :
     5931               min-date = tt-trn-code.fact-date.
     5932           end.
     5933               if  min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     5934                   then n-pay-date = n-doc-date .
     5935                   else n-pay-date = min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     5936     run fin-ob-code (input g#db-num , output p-doc-code) .
     5937     run create-fin-liab (
     5938       input  yes                   ,
     5939       input  p-doc-code            ,
     5940       input  n-doc-date ,
     5941       input  n-doc-type            ,
     5942       input  n-payer-name          ,
     5943       input  n-receiver-name       ,
     5944       input  n-curr-code           ,
     5945       input  n-sum-doc             ,
     5946       input  n-user-db-num-doc     ,
     5947       input  n-user-name-doc       ,
     5948       input  n-base-rate           ,
     5949       input  n-base-scale          ,
     5950       input  n-receiver-code       ,
     5951       input  n-receiver-type       ,
     5952       input  n-contract-code       ,
     5953       input  n-exch-rate           ,
     5954       input  n-exch-scale          ,
     5955       input  n-contract-curr       ,
     5956       input  n-contract-rate       ,
     5957       input  n-contract-scale      ,
     5958       input  n-fact-date           ,
     5959       input  n-fact-order          ,
     5960       input  par-host-code         ,
     5961       input  n-payer-code          ,
     5962       input  n-payer-type          ,
     5963       input  n-pay-date            ,
     5964       input  string(p-doc-code)    ,
     5965       input  'авто':U            ,
     5966       input  n-sum-base-orig       ,
     5967       input  n-sum-base            ,
     5968       input  n-sum-doc-orig        ,
     5969       input  n-sum-rubl-orig       ,
     5970       input  n-sum-rubl            ,
     5971       input  n-sum-contract        ,
     5972       input  n-trn-doc-code        ,
     5973       input  n-user-db-num-fact    ,
     5974       input  n-user-db-num-pay     ,
     5975       input  n-user-name-fact      ,
     5976       input  n-user-name-pay       ,
     5977       input  n-in-type             ,
     5978       input  n-sum-tax-base        ,
     5979       input  n-sum-tax-doc         ,
     5980       input  n-sum-tax-rubl        ,
     5981       input  n-sum-tax-contract    ,
     5982       input  "Корректирующее ФО "  ,
     5983       output p-ri )
     5984       no-error .
     5985     col-fo = col-fo + 1.
     5986     for each tt-trn-code  where
     5987         tt-trn-code.contract-code = buf_contract.contract-code  and
     5988         tt-trn-code.obj-type      = p-obj-type    and
     5989         tt-trn-code.pc            = v-pc          and
     5990         tt-trn-code.obj-code      = p-obj-code    and
     5991         tt-trn-code.host-code     = par-host-code
     5992         on error undo, return error :
     5993         create buf_fin-ob-trn.
     5994         assign
     5995           buf_fin-ob-trn.doc-code       = p-doc-code
     5996           buf_fin-ob-trn.host-code      = par-host-code
     5997           buf_fin-ob-trn.sum-rubl       = tt-trn-code.sum-rubl
     5998           buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code
     5999           buf_fin-ob-trn.is-corr        = true
     6000         .
     6001         find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = tt-trn-code.doc-code no-error .
     6002         if available buf2_trn-doc then do:
     6003           if lookup( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)'  ) > 0 then do:
     6004               assign
     6005                 buf2_trn-doc.cr-incfo   = true
     6006                 buf2_trn-doc.cr-incorexpfo = true
     6007                 buf2_trn-doc.incfo-date = today
     6008               .
     6009               if buf2_trn-doc.need-incfo = 2 then do:
     6010                 assign
     6011                   buf2_trn-doc.need-incfo      = 1
     6012                   buf2_trn-doc.need-expfo      = 0
     6013                   buf2_trn-doc.need-incorexpfo = 1
     6014                 .
     6015               end.
     6016           end.
     6017           else do:
     6018               assign
     6019                 buf2_trn-doc.cr-expfo   = true
     6020                 buf2_trn-doc.cr-incorexpfo = true
     6021                 buf2_trn-doc.expfo-date = today
     6022               .
     6023               if buf2_trn-doc.need-expfo = 2 then do:
     6024                 assign
     6025                   buf2_trn-doc.need-expfo      = 1
     6026                   buf2_trn-doc.need-incfo      = 0
     6027                   buf2_trn-doc.need-incorexpfo = 1
     6028                 .
     6029               end.
     6030           end.
     6031          end.
     6032          else do:
     6033             message vss-workfile vss-revision vss-description skip
     6034                    "Ошибка test " skip
     6035                     skip
     6036                     error-status :get-message(1) skip
     6037                     return-value skip
     6038                     view-as alert-box error
     6039             .
     6040          end.
     6041          if p-nalog = 1 then
     6042             run make-fin-parts (input p-doc-code, input 2) .
     6043          else
     6044             run make-fin-parts-VAT (input p-doc-code, input v-pc) .
     6045     end.
     6046     run make-tax (
     6047           input p-doc-code ,
     6048           input par-host-code
     6049           )                .
     6050     run update-fin-ob_obj (
     6051           input p-doc-code ,
     6052           input par-host-code
     6053           )
     6054       .
     6055    end.
     6056   end procedure.
     6057   procedure clc-price :
     6058    do
     6059    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6060    :
     6061   for each tt-clcparts
     6062       on error undo, return error :
     6063       delete tt-clcparts .
     6064   end.
     6065   BUFFER-COPY buf_parts to tt-clcparts .
     6066   run clcprtsl_calc-parts
     6067   (
     6068     input recid(tt-clcparts) ,
     6069     input varis-doc          ,
     6070     input varis-cur          ,
     6071     input varroad-tax        ,
     6072     input varexcise          ,
     6073     input varvat-pc          ,
     6074     input varcons-vat-pc     ,
     6075     input varslt-pc          ,
     6076     input varbase-rate       ,
     6077     input varbase-scale      ,
     6078     input varr-b             ,
     6079     input varcur-base        ,
     6080     input varcurroad-tax     ,
     6081     input varcurexcise       ,
     6082     input varcurvat-pc       ,
     6083     input varcurcons-vat-pc  ,
     6084     input varcurslt-pc
     6085     ) no-error
     6086     .
     6087     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) + return-value .
     6088        find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error .
     6089     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) .
     6090    end.
     6091   end procedure.
     6092   procedure clc-price-tmp :
     6093    do
     6094    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6095    :
     6096   for each tt-clcparts
     6097       on error undo, return error :
     6098       delete tt-clcparts .
     6099   end.
     6100   BUFFER-COPY temp-parts to tt-clcparts .
     6101   run clcprtsl_calc-parts
     6102   (
     6103     input recid(tt-clcparts) ,
     6104     input varis-doc          ,
     6105     input varis-cur          ,
     6106     input varroad-tax        ,
     6107     input varexcise          ,
     6108     input varvat-pc          ,
     6109     input varcons-vat-pc     ,
     6110     input varslt-pc          ,
     6111     input varbase-rate       ,
     6112     input varbase-scale      ,
     6113     input varr-b             ,
     6114     input varcur-base        ,
     6115     input varcurroad-tax     ,
     6116     input varcurexcise       ,
     6117     input varcurvat-pc       ,
     6118     input varcurcons-vat-pc  ,
     6119     input varcurslt-pc
     6120     ) no-error
     6121     .
     6122     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) + return-value .
     6123        find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error .
     6124     if error-status :error then  p-res = p-res + chr(10) + error-status :get-message(1) .
     6125    end.
     6126   end procedure.
     6127   procedure make-fin-parts :
     6128    do
     6129    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6130    :
     6131   define input parameter p-doc-code as character no-undo .
     6132   define input parameter p-type as integer no-undo .
     6133   define variable col-part   as integer   no-undo .
     6134     for each temp-parts no-lock  where
     6135              temp-parts.contract-code = buf_contract.contract-code and
     6136              ((p-type = 1) or
     6137              ( p-type = 2 and temp-parts.out-code      = buf_fin-ob-trn.trn-doc-code))
     6138              on error undo, return error :
     6139                   if not can-find (first buf_fin-gds-part no-lock where
     6140                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     6141                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     6142                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     6143                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     6144                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     6145                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     6146                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     6147                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     6148                   then do:
     6149                       col-part = col-part + 1.
     6150                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show( "Создано партий : " + string( col-part )) .
     6151                         run clc-price-tmp .
     6152                         create buf_fin-gds-part.
     6153                         buffer-copy temp-parts to buf_fin-gds-part
     6154                         assign
     6155                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     6156                           buf_fin-gds-part.status_dop         = 'авто':U
     6157                           buf_fin-gds-part.user-db-num        = g#db-num
     6158                           buf_fin-gds-part.user-name          = g#userid
     6159                           buf_fin-gds-part.doc-qnty           = temp-parts.qnty
     6160                           buf_fin-gds-part.sum-rubl-orig      = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6161                           buf_fin-gds-part.sum-rubl           = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6162                           buf_fin-gds-part.sum-base-orig      = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6163                           buf_fin-gds-part.sum-base           = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6164                           buf_fin-gds-part.sum-contract-orig  = tt-allsum.sum-dsc-cli-acc
     6165                           buf_fin-gds-part.sum-contract       = tt-allsum.sum-dsc-cli-acc
     6166                           buf_fin-gds-part.other-rubl-orig    = tt-allsum.other-rubl-acc
     6167                           buf_fin-gds-part.road-tax-rubl-orig = tt-allsum.road-tax-rubl-acc
     6168                           buf_fin-gds-part.transport-rubl-orig= tt-allsum.transport-rubl-acc
     6169                           buf_fin-gds-part.other-base-orig    = tt-allsum.other-base-acc
     6170                           buf_fin-gds-part.road-tax-base-orig = tt-allsum.road-tax-base-acc
     6171                           buf_fin-gds-part.transport-base-orig= tt-allsum.transport-base-acc
     6172                           buf_fin-gds-part.other-contract-orig     = tt-allsum.other-cli-acc
     6173                           buf_fin-gds-part.road-tax-contract-orig  = tt-allsum.road-tax-cli-acc
     6174                           buf_fin-gds-part.transport-contract-orig = tt-allsum.transport-cli-acc
     6175                           buf_fin-gds-part.vat-rubl-orig      = tt-allsum.vat-rubl-acc
     6176                           buf_fin-gds-part.vat-rubl           = tt-allsum.vat-rubl-acc
     6177                           buf_fin-gds-part.slt-rubl-orig      = tt-allsum.slt-rubl-acc
     6178                           buf_fin-gds-part.slt-rubl           = tt-allsum.slt-rubl-acc
     6179                           buf_fin-gds-part.vat-base-orig      = tt-allsum.vat-base-acc
     6180                           buf_fin-gds-part.vat-base           = tt-allsum.vat-base-acc
     6181                           buf_fin-gds-part.slt-base-orig      = tt-allsum.slt-base-acc
     6182                           buf_fin-gds-part.slt-base           = tt-allsum.slt-base-acc
     6183                           buf_fin-gds-part.vat-contract-orig  = tt-allsum.vat-cli-acc
     6184                           buf_fin-gds-part.vat-contract       = tt-allsum.vat-cli-acc
     6185                           buf_fin-gds-part.slt-contract-orig  = tt-allsum.slt-cli-acc
     6186                           buf_fin-gds-part.slt-contract       = tt-allsum.slt-cli-acc
     6187                         .
     6188                   end.
     6189               end.
     6190    end.
     6191   end procedure.
     6192   procedure ver-type-purch :
     6193   do
     6194   on error undo, return error return-value
     6195   :
     6196    define output parameter p-ok as logical   no-undo .
     6197    p-ok = true .
     6198     if buf_trn-doc.ext-doc-type   = 'pc':U then do:
     6199       p-ok = false   .
     6200       if  buf_contract.contract-type = 'Ответственного хранения':U and
     6201           buf_parts.purch-code       = 3 then p-ok = true .
     6202     end.
     6203   end.
     6204   end procedure.
     6205   procedure ver-purch-resp-store :
     6206   do
     6207   on error undo, return error return-value
     6208   :
     6209    define output parameter p-ok as logical   no-undo .
     6210    p-ok = true .
     6211     if buf_trn-doc.ext-doc-type   <> 'pc':U then do:
     6212       if  buf_contract.contract-type = 'Ответственного хранения':U and
     6213           buf_parts.purch-code      <> 3  then p-ok = false  .
     6214     end.
     6215   end.
     6216   end procedure.
     6217   procedure make-fin-parts-VAT :
     6218    do
     6219    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6220    :
     6221   define input parameter p-doc-code as character no-undo .
     6222   define input  parameter v-pc as decimal   no-undo .
     6223   if var-fin-calc <> 1  then find first temp-obj-firm no-error .
     6224   define variable col-part   as integer   no-undo .
     6225     for each temp-parts no-lock  where
     6226              temp-parts.contract-code = buf_contract.contract-code and
     6227              temp-parts.VAT-pc = v-pc and
     6228              ( var-fin-calc <> 1  or (
     6229              temp-parts.obj-type = temp-obj-firm.obj-type  and
     6230              temp-parts.obj-code = temp-obj-firm.obj-code ))
     6231              on error undo, return error :
     6232                   if not can-find (first buf_fin-gds-part no-lock where
     6233                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     6234                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     6235                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     6236                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     6237                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     6238                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     6239                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     6240                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     6241                   then do:
     6242                       col-part = col-part + 1.
     6243                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show( "Создано партий : " + string( col-part )) .
     6244                         run clc-price-tmp .
     6245                         create buf_fin-gds-part.
     6246                         buffer-copy temp-parts to buf_fin-gds-part
     6247                         assign
     6248                           buf_fin-gds-part.fin-ob-code        = p-doc-code
     6249                           buf_fin-gds-part.status_dop         = 'авто':U
     6250                           buf_fin-gds-part.user-db-num        = g#db-num
     6251                           buf_fin-gds-part.user-name          = g#userid
     6252                           buf_fin-gds-part.doc-qnty           = temp-parts.qnty
     6253                           buf_fin-gds-part.sum-rubl-orig      = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6254                           buf_fin-gds-part.sum-rubl           = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     6255                           buf_fin-gds-part.sum-base-orig      = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6256                           buf_fin-gds-part.sum-base           = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     6257                           buf_fin-gds-part.sum-contract-orig  = tt-allsum.sum-dsc-cli-acc
     6258                           buf_fin-gds-part.sum-contract       = tt-allsum.sum-dsc-cli-acc
     6259                           buf_fin-gds-part.other-rubl-orig    = tt-allsum.other-rubl-acc
     6260                           buf_fin-gds-part.road-tax-rubl-orig = tt-allsum.road-tax-rubl-acc
     6261                           buf_fin-gds-part.transport-rubl-orig= tt-allsum.transport-rubl-acc
     6262                           buf_fin-gds-part.other-base-orig    = tt-allsum.other-base-acc
     6263                           buf_fin-gds-part.road-tax-base-orig = tt-allsum.road-tax-base-acc
     6264                           buf_fin-gds-part.transport-base-orig= tt-allsum.transport-base-acc
     6265                           buf_fin-gds-part.other-contract-orig     = tt-allsum.other-cli-acc
     6266                           buf_fin-gds-part.road-tax-contract-orig  = tt-allsum.road-tax-cli-acc
     6267                           buf_fin-gds-part.transport-contract-orig = tt-allsum.transport-cli-acc
     6268                           buf_fin-gds-part.vat-rubl-orig      = tt-allsum.vat-rubl-acc
     6269                           buf_fin-gds-part.vat-rubl           = tt-allsum.vat-rubl-acc
     6270                           buf_fin-gds-part.slt-rubl-orig      = tt-allsum.slt-rubl-acc
     6271                           buf_fin-gds-part.slt-rubl           = tt-allsum.slt-rubl-acc
     6272                           buf_fin-gds-part.vat-base-orig      = tt-allsum.vat-base-acc
     6273                           buf_fin-gds-part.vat-base           = tt-allsum.vat-base-acc
     6274                           buf_fin-gds-part.slt-base-orig      = tt-allsum.slt-base-acc
     6275                           buf_fin-gds-part.slt-base           = tt-allsum.slt-base-acc
     6276                           buf_fin-gds-part.vat-contract-orig  = tt-allsum.vat-cli-acc
     6277                           buf_fin-gds-part.vat-contract       = tt-allsum.vat-cli-acc
     6278                           buf_fin-gds-part.slt-contract-orig  = tt-allsum.slt-cli-acc
     6279                           buf_fin-gds-part.slt-contract       = tt-allsum.slt-cli-acc
     6280                         .
     6281                   end.
     6282               end.
     6283    end.
     6284   end procedure.
