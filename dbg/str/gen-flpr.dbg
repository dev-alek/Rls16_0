     3634   if ( col-trn  modulo temp1 = 0 ) and ( col-trn >= temp1 ) then run waitfram-show( "Обработано накладных : " + string( col-trn )) .
     3635         for each buf_parts no-lock where buf_parts.out-code  = buf_trn-doc.doc-code   and
     3636                                          buf_parts.host-code = buf_trn-doc.host-code  and
