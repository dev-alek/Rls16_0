     3968                 find first buf_parts-attr no-lock where buf_parts-attr.in-code   = buf_parts.in-code   and
     3969                                                    buf_parts-attr.part-code = buf_parts.part-code and
     3970                                                    buf_parts-attr.gds-code  = buf_goods.gds-code .
     3971                     assign
     3972                       var-sum-rubl     = var-sum-rubl     +  abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )   * (-1)
     3973                       var-sum-contract = var-sum-contract +  abs(tt-allsum.sum-dsc-cli-acc                                                                )    * (-1)
     3974                       var-sum-base     = var-sum-base     +  abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )   * (-1)
     3975                     .
     3976                     create temp-parts.
     3977                     BUFFER-COPY buf_parts to temp-parts
     3978                     assign
     3979                       temp-parts.cli-qnty       =  abs( buf_parts.cli-qnty  )     * (-1)
     3980                       temp-parts.fact-qnty      =  abs( buf_parts.fact-qnty )     * (-1)
     3981                       temp-parts.qnty           =  abs( buf_parts.qnty      )     * (-1)
     3982                       temp-parts.gds-code       =  buf_goods.gds-code
     3983                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     3984                       var-income-in-code        =  buf_parts-attr.income-in-code
     3985                     .
     3986               if last-of(buf_parts.contract-code) or (p-nalog = 2 and last-of(buf_parts.vat-pc)) then do:
     3987                 run make-fo-corr (  input var-sum-rubl ,
     3988                                         input var-sum-base ,
     3989                                         input var-sum-contract ) no-error .
     3990                 if error-status :error then p-res = p-res + chr(10) + error-status :get-message(1) .
     3991                 var-sum-rubl = 0 .
     3992                 var-sum-rublb = 0 .
     3993                 var-sum-base      = 0 .
     3994                 var-sum-baseb     = 0 .
     3995                 var-sum-contract  = 0 .
     3996                 var-sum-contractb = 0 .
     3997               end.
     3998         end.
     3999    end.
     4000   end procedure.
