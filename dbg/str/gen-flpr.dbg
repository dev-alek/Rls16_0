     5646                 new_fin-gds-part.sum-rubl-orig  = -1 * buf-sm_fin-gds-part.sum-rubl-orig
     5647                 new_fin-gds-part.sum-rubl       = -1 * buf-sm_fin-gds-part.sum-rubl
