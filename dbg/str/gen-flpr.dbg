     4853     n-contract-curr      = n-curr-code
     4854     n-contract-rate      = n-exch-rate
     4855     n-contract-scale     = n-exch-scale
     4856     n-pay-date           = v-date-pay
     4857     n-sum-rubl-orig      = v-sum-rubl
     4858     n-sum-base-orig      =     v-sum-base
     4859     n-sum-contract       =    v-sum-contract
     4860     n-sum-base           = n-sum-base-orig
     4861     n-sum-doc-orig       = n-sum-contract
     4862     n-sum-doc            = n-sum-contract
     4863     n-sum-rubl           = n-sum-rubl-orig
     4864     n-trn-doc-code-orig  = if available  buf_parts-attr then buf_parts-attr.income-in-code else  ?
     4865     n-in-type            = 0
     4866     n-sum-tax-base       = 0
     4867     n-sum-tax-doc        = 0
     4868     n-sum-tax-rubl       = 0
     4869     n-sum-tax-contract   = 0
     4870     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     4871    .
     4872     run fin-ob-code (input g#db-num , output p-doc-code) .
     4873     run create-fin-ob-before (
     4874       input yes                    ,
     4875       input  p-doc-code            ,
     4876       input  v-doc-code-fo         ,
     4877       input  n-doc-date ,
     4878       input  n-doc-type            ,
     4879       input  n-payer-name          ,
     4880       input  n-receiver-name       ,
     4881       input  n-curr-code           ,
     4882       input  n-sum-doc             ,
     4883       input  n-user-db-num-doc     ,
     4884       input  n-user-name-doc       ,
     4885       input  n-base-rate           ,
     4886       input  n-base-scale          ,
     4887       input  n-receiver-code       ,
     4888       input  n-receiver-type       ,
     4889       input  n-contract-code       ,
     4890       input  n-exch-rate           ,
     4891       input  n-exch-scale          ,
     4892       input  n-contract-curr       ,
     4893       input  n-contract-rate       ,
     4894       input  n-contract-scale      ,
     4895       input  n-fact-date           ,
     4896       input  n-fact-order          ,
     4897       input  par-host-code         ,
     4898       input  n-payer-code          ,
     4899       input  n-payer-type          ,
     4900       input  n-pay-date            ,
     4901       input  string(p-doc-code)    ,
     4902       input  'авто':U            ,
     4903       input  n-sum-base-orig       ,
     4904       input  n-sum-base            ,
     4905       input  n-sum-doc-orig        ,
     4906       input  n-sum-rubl-orig       ,
     4907       input  n-sum-rubl            ,
     4908       input  n-sum-contract        ,
     4909       input  n-trn-doc-code        ,
     4910       input  n-trn-doc-code-orig   ,
     4911       input  n-user-db-num-fact    ,
     4912       input  n-user-db-num-pay      ,
     4913       input  n-user-name-fact       ,
     4914       input  n-user-name-pay        ,
     4915       input  n-in-type              ,
     4916       input  n-sum-tax-base         ,
     4917       input  n-sum-tax-doc          ,
     4918       input  n-sum-tax-rubl         ,
     4919       input  n-sum-tax-contract     ,
     4920       input "Корректирующее ПФО"  ,
     4921       output p-ri )
     4922       no-error .
     4923       if error-status :error then
     4924       message vss-workfile vss-revision vss-description skip
     4925               "Ошибка  " skip
     4926               skip
     4927               error-status :get-message(1) skip
     4928               return-value skip
     4929               view-as alert-box error
     4930       .
     4931           col-bfo = col-bfo + 1.
     4932           col-contract = col-contract + 1 .
     4933              find first  buf_fin-ob-trn no-lock  where
     4934                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     4935                 buf_fin-ob-trn.host-code      = par-host-code  and
     4936                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     4937                 no-error .
