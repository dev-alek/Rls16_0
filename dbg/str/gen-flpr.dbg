     3643                                                    buf_parts-attr.part-code = buf_parts.part-code and
     3644                                                    buf_parts-attr.gds-code  = buf_goods.gds-code ,
     3645                 first buf_contract no-lock where buf_contract.contract-code = buf_parts.contract-code and
     3646                                                  buf_contract.host-code     = buf_parts.host-code     and
     3647                                                  lookup(buf_contract.usl-opl , p-usl-opl ) > 0  and
     3648                               ((
     3649                               lookup ( buf_contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0 and
     3650                               lookup ( buf_trn-doc.ext-doc-type , 'ie,ep,':U  ) > 0
     3651                               ) OR
     3652                               ( lookup ( buf_contract.usl-opl , 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' ) > 0   and
     3653                                 lookup ( buf_trn-doc.ext-doc-type , 'ee,es,re,rs,we,wm,pc,':U + 'vt,ap,mp,vp,':U ) > 0
     3654                                 ) )
     3655                 break
     3656                       by buf_parts.contract-code
     3657                       by buf_parts.vat-pc
     3658                       by buf_parts-attr.income-in-code
     3659                       on error undo, return error :
     3660             run ver-purch-resp-store (output  v-ok ).
     3661             if v-ok = true then do:
     3662            Run clc-price.
     3663            if lookup ( buf_trn-doc.ext-doc-type , 'vt,ap,mp,vp,':U ) > 0 then do:
     3664                find first c-doc-attr no-lock where
     3665                           c-doc-attr.doc-code  = buf_trn-doc.doc-code and
     3666                           c-doc-attr.attr-code = 'olsuppcntr':U no-error .
     3667                   if available c-doc-attr then do:
     3668                      if  c-doc-attr.attr-value = "yes" then next .
     3669                   end.
     3670                 if
     3671                     ( lookup(buf_contract.usl-opl , 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' ) > 0 and
     3672                       buf_parts.fact-qnty <= 0 and
     3673                       v-flag-ex = false
     3674                       )
     3675                  then do:
     3676                     if buf_trn-doc.ext-doc-type <> 'vp':U then do:
     3677                     if buf_contract.usl-opl = 'По реализации части приход. накладной':U
     3678                       then  assign
     3679                             var-sum-rublb     = var-sum-rublb     + abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) ) * (-1)
     3680                             var-sum-contractb = var-sum-contractb + abs(tt-allsum.sum-dsc-cli-acc                                                                )  * (-1)
     3681                             var-sum-baseb     = var-sum-baseb     + abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) ) * (-1)
     3682                             .
     3683                       else
     3684                           assign
     3685                                   var-sum-rubl     = var-sum-rubl     + abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)  ) * (-1)
     3686                                   var-sum-contract = var-sum-contract + abs(tt-allsum.sum-dsc-cli-acc                                                                )  * (-1)
     3687                                   var-sum-base     = var-sum-base     + abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)  ) * (-1)
     3688                           .
     3689                     create temp-parts.
     3690                     BUFFER-COPY buf_parts to temp-parts
     3691                     assign
     3692                       temp-parts.cli-qnty       =  abs( buf_parts.cli-qnty  ) * (-1)
     3693                       temp-parts.fact-qnty      =  abs( buf_parts.fact-qnty ) * (-1)
     3694                       temp-parts.qnty           =  abs( buf_parts.qnty      ) * (-1)
     3695                       temp-parts.gds-code       =  buf_goods.gds-code
     3696                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     3697                       var-income-in-code        =  buf_parts-attr.income-in-code
     3698                     .
     3699                 end.
     3700                     else do:
     3701                       if buf_contract.usl-opl = 'По реализации части приход. накладной':U then
     3702                               assign
     3703                                 var-sum-rublb     = var-sum-rublb     +  abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )  * (-1)
     3704                                 var-sum-contractb = var-sum-contractb +  abs(tt-allsum.sum-dsc-cli-acc                                                                )  * (-1)
     3705                                 var-sum-baseb     = var-sum-baseb     +  abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )  * (-1)
     3706                               .
