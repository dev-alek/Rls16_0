     2658       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2659       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2660       .
     2661   end.
     2662   otherwise do:
     2663     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2664                              cl_tt-clcparts.purch-code,
     2665                              cl_tt-clcparts.part-code,
     2666                              cl_tt-clcparts.out-code,
     2667                              cl_tt-clcparts.in-code,
     2668                              cl_tt-clcparts.artic,
     2669                              cl_tt-clcparts.prod-type,
     2670                              cl_tt-clcparts.prod-code).
     2671   end.
     2672   end case.
     2673   end.
     2674   end procedure.
     2675   procedure clcprtsl_calc-line :
     2676   define input  parameter parrec-line as recid no-undo.
     2677   define variable v-tax-date         as   date                     no-undo.
     2678   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2679   define variable varr-b             as   character                no-undo.
     2680   define variable varr-btype         as   character                no-undo.
     2681   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2682   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2683   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2684   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2685   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2686   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2687   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2688   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2689   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2690   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2691   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2692   define variable varexcise          like ub.price-list.excise     no-undo.
     2693   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2694   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2695   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2696   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2697   define variable v-varsum           as decimal                  no-undo.
     2698   define variable varprice-salef as decimal   no-undo .
     2699   define buffer bf_trn-doc             for ub.trn-doc.
     2700   define buffer bf_doc-line            for ub.doc-line.
     2701   define buffer bf_gds-dtl             for ub.gds-dtl.
     2702   define buffer bf_goods               for ub.goods.
     2703   define buffer bf_parts               for ub.parts.
     2704   define buffer bf_sysconf             for ub.sysconf.
     2705   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2706   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2707   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2708   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2709   define buffer buf_parts        for ub.parts.
     2710   v-calcbypart = no.
     2711   do on error undo, return error return-value :
     2712   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2714     (output varr-b
     2715     )  .
     2716     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2717     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2718     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2719                               bf_goods.prod-type = bf_doc-line.prod-type and
     2720                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2721     if bf_trn-doc.fact-date <> ?        then do:
     2722       assign v-tax-date = bf_trn-doc.fact-date.
     2723     end.
     2724     else do:
     2725       assign v-tax-date = ?.
     2726     end.
     2727   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2729     (input  bf_goods.gds-code
     2730     ,input  '1':U
     2731     ,input  v-tax-date
     2732     ,input  bf_trn-doc.host-code
     2733     ,input  bf_trn-doc.obj-type
     2734     ,input  bf_trn-doc.obj-code
     2735     ,output v-vat-pc
     2736     ) no-error .
     2737     if error-status :error
     2738     or v-vat-pc = ? then do:
     2739        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2740     end.
     2741     if bf_goods.gds-type = 'у':U or
     2742        bf_trn-doc.status_ = 'запрос':U then do:
     2743       for each bf_tt-allsum-line
     2744       on error undo, return error return-value
     2745        :
     2746         delete bf_tt-allsum-line.
     2747       end.
     2748       create bf_tt-allsum-line.
     2749       assign
     2750        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2751       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2752                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2753                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2754                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2755         assign
     2756           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2757           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2758           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2759           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2760           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2761           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2762           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2763           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2764           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2765           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2766           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2767           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2768           bf_tt-allsum-line.vat-cli-acc          =  ?
     2769           .
     2770       end.
     2771       assign
     2772         bf_tt-allsum-line.cli-qnty             =  ?
     2773         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2774         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2775         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2776         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2777         bf_tt-allsum-line.road-tax-base-doc    =  0
     2778         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2779         bf_tt-allsum-line.excise-base-doc      =  0
     2780         bf_tt-allsum-line.excise-rubl-doc      =  0
     2781         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2782         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2783         bf_tt-allsum-line.dsc-base-cur         =  0
     2784         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2785         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2786         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2787         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2788         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2789         bf_tt-allsum-line.road-tax-base-cur    =  0
     2790         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2791         bf_tt-allsum-line.excise-base-cur      =  0
     2792         bf_tt-allsum-line.excise-rubl-cur      =  0
     2793         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2794         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2795         bf_tt-allsum-line.dsc-base-acc         =  0
     2796         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2797         bf_tt-allsum-line.dsc-cli-acc          =  0
     2798         bf_tt-allsum-line.slt-base-acc         =  0
     2799         bf_tt-allsum-line.slt-rubl-acc         =  0
     2800         bf_tt-allsum-line.slt-cli-acc          =  0
     2801         bf_tt-allsum-line.road-tax-base-acc    =  0
     2802         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2803         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2804         bf_tt-allsum-line.excise-base-acc      =  0
     2805         bf_tt-allsum-line.excise-rubl-acc      =  0
     2806         bf_tt-allsum-line.excise-cli-acc       =  0
     2807         bf_tt-allsum-line.transport-base-acc   =  0
     2808         bf_tt-allsum-line.transport-rubl-acc   =  0
     2809         bf_tt-allsum-line.transport-cli-acc    =  0
     2810         bf_tt-allsum-line.other-base-acc       =  0
     2811         bf_tt-allsum-line.other-rubl-acc       =  0
     2812         bf_tt-allsum-line.other-cli-acc        =  0
     2813         .
     2814       create bfs_tt-allsum-line.
     2815       assign
     2816       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2817       if bf_trn-doc.doc-type = 'инв':U or
     2818          bf_trn-doc.doc-type = 'при':U    or
     2819          bf_trn-doc.doc-type = 'возврат':U    then do:
     2820          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2821       end.
     2822       else do:
     2823         assign
     2824           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2825           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2826           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2827           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2828           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2829           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2830           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2831           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2832           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2833           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2834           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2835           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2836           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2837           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2838           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2839           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2840           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2841           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2842           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2843           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2844           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2845           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2846           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2847           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2848           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2849           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2850           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2851           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2852           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2853           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2854           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2855           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2856           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2857           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2858           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2859           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2860           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2861           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2862           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2863           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2864           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2865           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2866           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     2867           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     2868           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     2869           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     2870           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     2871           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     2872           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     2873           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     2874           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     2875           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
     2876           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
     2877           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     2878           .
     2879       end.
     2880       create bfo_tt-allsum-line.
     2881       assign
     2882         bfo_tt-allsum-line.sum-type = 'сумма_по_услуге':U.
     2883       buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfo_tt-allsum-line.
     2884       create bfos_tt-allsum-line.
     2885       assign
     2886         bfos_tt-allsum-line.sum-type = 'сумма_по_услуге_со_знаком':U.
     2887       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     2888     end.
     2889     else do:
     2890       assign
     2891         varlastcur-base      = 0
     2892         varlastcur-road-tax  = 0
     2893         varlastcur-excise    = 0
     2894         varcur-base          = 0
     2895         varcur-road-tax      = 0
     2896         varcur-excise        = 0
     2897         varcur-vat-pc        = 0
     2898         varcur-slt-pc        = 0
     2899         varcur-fact-qnty     = 0
     2900       .
     2901   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2902     (input  bf_goods.gds-code
     2903     ,input  ?
     2904     ,output varb-code
     2905     )  .
     2906   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
