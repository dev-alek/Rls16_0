     3717                           temp-parts.fact-qnty      =  abs( buf_parts.fact-qnty )  * (-1)
     3718                           temp-parts.qnty           =  abs( buf_parts.qnty      )  * (-1)
     3719                           temp-parts.gds-code       =  buf_goods.gds-code
     3720                           temp-parts.income-in-code =  buf_parts-attr.income-in-code
     3721                           var-income-in-code        =  buf_parts-attr.income-in-code
     3722                         .
     3723                     end.
     3724                 end.
     3725                 if
     3726                     ( lookup(buf_contract.usl-opl , 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' ) > 0 and
     3727                       buf_parts.fact-qnty > 0 and
     3728                       v-flag-ex = false )
     3729                  then do:
     3730                    if buf_trn-doc.ext-doc-type <> 'vp':U then do:
     3731                    if buf_contract.usl-opl = 'По реализации части приход. накладной':U then
     3732                           assign
     3733                             var-sum-rublb     = var-sum-rublb     +  abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )
     3734                             var-sum-contractb = var-sum-contractb +  abs(tt-allsum.sum-dsc-cli-acc                                                                )
     3735                             var-sum-baseb     = var-sum-baseb     +  abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )
     3736                           .
     3737                       else
     3738                           assign
     3739                                   var-sum-rubl     = var-sum-rubl     + abs(tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc) )
     3740                                   var-sum-contract = var-sum-contract + abs(tt-allsum.sum-dsc-cli-acc                                                                )
     3741                                   var-sum-base     = var-sum-base     + abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )
     3742                           .
     3743                     create temp-parts .
     3744                     BUFFER-COPY buf_parts to temp-parts
     3745                     assign
     3746                       temp-parts.cli-qnty       =  (-1) * abs( buf_parts.cli-qnty  ) * (-1)
     3747                       temp-parts.fact-qnty      =  (-1) * abs( buf_parts.fact-qnty ) * (-1)
     3748                       temp-parts.qnty           =  (-1) * abs( buf_parts.qnty      ) * (-1)
     3749                       temp-parts.gds-code       =  buf_goods.gds-code
     3750                       temp-parts.income-in-code =  buf_parts-attr.income-in-code
     3751                       var-income-in-code        =  buf_parts-attr.income-in-code
