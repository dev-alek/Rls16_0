     5666                 new_fin-ob-tax.sum-line-contr-orig     = -1 *  buf-sm_fin-ob-tax.sum-line-contr-orig
     5667                 new_fin-ob-tax.sum-line-contr          = -1 *  buf-sm_fin-ob-tax.sum-line-contr
     5668                 new_fin-ob-tax.sum-line-doc-orig       = -1 *  buf-sm_fin-ob-tax.sum-line-doc-orig
