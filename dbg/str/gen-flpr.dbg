     3710                                       var-sum-contract = var-sum-contract + abs(tt-allsum.sum-dsc-cli-acc                                                                )  * (-1)
     3711                                       var-sum-base     = var-sum-base     + abs(tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc) )  * (-1)
     3712                               .
     3713                         create temp-parts .
     3714                         BUFFER-COPY buf_parts to temp-parts
     3715                         assign
