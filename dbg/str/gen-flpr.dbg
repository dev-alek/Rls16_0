      918   define variable v-sum-base          as decimal no-undo .
      919   define variable v-sum-contract      as decimal no-undo .
      920   define variable v-sum-slt           as decimal no-undo .
      921   define variable v-sum-rubl-slt      as decimal no-undo .
      922   define variable v-sum-base-slt      as decimal no-undo .
      923   define variable v-sum-contract-slt  as decimal no-undo .
      924   define variable v-sum-vat           as decimal no-undo .
      925   define variable v-sum-rubl-vat      as decimal no-undo .
      926   define variable v-sum-base-vat      as decimal no-undo .
