     2381   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2382   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2383   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2384   procedure gen-key-rec :
     2385     define input  parameter p-tbl-name    as character no-undo.
     2386     define input  parameter p-bh_tbl-name as handle    no-undo.
     2387     define output parameter p-key-rec     as character no-undo.
     2388     do
     2389     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2390     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2391     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2392     :
     2393       define variable fh               as handle    no-undo .
     2394       define variable v-ok             as logical   no-undo .
     2395       define variable v-inform         as character no-undo .
     2396       define variable v-ind            as integer   no-undo .
     2397       define variable v-idx-field-qnty as integer   no-undo .
     2398       if p-tbl-name = ?
     2399         or p-tbl-name = "":U
     2400       then do:
     2401         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     2402       end.
     2403       if not p-bh_tbl-name:available then do:
     2404         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     2405       end.
     2406       assign
     2407         p-key-rec = p-tbl-name
     2408         v-inform  = p-bh_tbl-name:index-information(1)
     2409         v-ind     = 2
     2410       .
     2411       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2412       on error undo, return error
     2413       :
     2414         assign
     2415           v-inform = p-bh_tbl-name:index-information( v-ind )
     2416           v-ind    = v-ind + 1
     2417         .
     2418       end.
     2419       if v-inform = ?
     2420         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2421         or entry( 3, v-inform, ",":U ) <> "1":U
     2422       then do:
     2423         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     2424       end.
     2425       else do:
     2426         assign
     2427           v-idx-field-qnty = num-entries( v-inform ) - 4
     2428         .
     2429         if v-idx-field-qnty < 2 then do:
     2430           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     2431         end.
     2432         do v-ind = 1 to v-idx-field-qnty by 2
     2433         on error undo, return error
     2434         :
     2435           assign
     2436             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2437             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2438           .
     2439         end.
     2440       end.
     2441       if p-key-rec = ? then do:
     2442         assign
     2443           p-key-rec = "":U
     2444         .
     2445         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     2446       end.
     2447     end.
     2448     return.
     2449   end procedure.
     2450   procedure gen-where-keyr-tab :
     2451     define input  parameter i-tableSerach as character no-undo.
     2452     define input  parameter i-tablekey   as character  no-undo.
     2453     define input  parameter p-key-rec    as character  no-undo.
     2454     define input  parameter p-key-handle as handle     no-undo .
     2455     define input  parameter p-db-name    as character  no-undo .
     2456     define input  parameter p-tt-handle  as handle     no-undo .
     2457     define output parameter o-Where      as character  no-undo.
     2458     do
     2459     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2460     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2461     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2462     :
     2463       define variable v-full-tbl-name  as character no-undo .
     2464       define variable bh_tbl-name      as handle    no-undo .
     2465       define variable fh_key           as handle    no-undo .
     2466       define variable fh_search        as handle    no-undo .
     2467       define variable v-field-num      as integer   no-undo .
     2468       define variable v-count-fld      as integer   no-undo .
     2469       define variable v-inform         as character no-undo .
     2470       define variable v-ind            as integer   no-undo .
     2471       define variable v-idx-field-qnty as integer   no-undo .
     2472       define variable v-field-name     as character no-undo .
     2473       define variable v-field-val      as character no-undo .
     2474       define variable v-word-link      as character no-undo .
     2475       define variable vTable           as character no-undo.
     2476       define variable bh_tbl-key       as handle    no-undo .
     2477       assign
     2478         p-key-rec = trim( p-key-rec )
     2479       .
     2480       if p-key-handle <> ? then do:
     2481         if not valid-handle(p-key-handle)
     2482            or p-key-handle:type <> "buffer"
     2483         then do:
     2484           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     2485         end.
     2486         if num-entries( p-key-rec, chr(3) ) > 1
     2487           or p-key-rec = ?
     2488           or p-key-rec = "":U
     2489         then do:
     2490           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     2491         end.
     2492       end.
     2493       else do:
     2494         if p-key-rec = ?
     2495           or p-key-rec = "":U
     2496         then do:
     2497           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     2498         end.
     2499       end.
     2500       assign
     2501         vTable = entry( 1 , p-key-rec, chr(3) )
     2502       .
     2503       if p-tt-handle <> ?
     2504         and ( not valid-handle(p-tt-handle)
     2505               or p-tt-handle:type <> "buffer"
     2506             )
     2507       then do:
     2508         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     2509       end.
     2510       if p-tt-handle = ? then do:
     2511         assign
     2512           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2513         .
     2514         create buffer bh_tbl-name for table v-full-tbl-name .
     2515       end.
     2516       else do:
     2517         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2518       end.
     2519       assign
     2520         v-inform = bh_tbl-name:index-information(1)
     2521         v-ind    = 2
     2522       .
     2523       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2524       on error undo, return error
     2525       :
     2526         assign
     2527           v-inform = bh_tbl-name:index-information( v-ind )
     2528           v-ind    = v-ind + 1
     2529         .
     2530       end.
     2531       if v-inform = ?
     2532         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2533         or entry( 3, v-inform, ",":U ) <> "1":U
     2534       then do:
     2535         delete object bh_tbl-name no-error.
     2536         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     2537       end.
     2538       assign
     2539         v-idx-field-qnty = num-entries( v-inform ) - 4
     2540       .
     2541       if v-idx-field-qnty < 2 then do:
     2542         delete object bh_tbl-name no-error.
     2543         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     2544       end.
     2545       assign
     2546         o-where     = "where":U
     2547         v-word-link = "":U
     2548         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2549         v-count-fld = 0
     2550       .
     2551       if i-tablekey ne "" and i-tablekey ne ?
     2552       then do:
     2553         assign
     2554           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2555         .
     2556         create buffer bh_tbl-key for table v-full-tbl-name .
     2557       end.
     2558       if i-tableSerach ne "" and i-tableSerach ne ?
     2559       then do:
     2560         delete object bh_tbl-name no-error.
     2561         assign
     2562           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2563         .
     2564         create buffer bh_tbl-name for table v-full-tbl-name .
     2565       end.
     2566       block_where:
     2567       do v-ind = 1 to v-idx-field-qnty by 2
     2568       on error undo, return error
     2569       :
     2570         assign
     2571           v-count-fld = v-count-fld + 1
     2572         .
     2573         if p-key-handle = ?
     2574           and v-count-fld > v-field-num
     2575         then do:
     2576           leave block_where.
     2577         end.
     2578         define variable VfieldKeyTable as handle no-undo.
     2579         assign
     2580           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2581           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2582         .
     2583         if     bh_tbl-key ne ?
     2584         then do:
     2585            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2586            if VfieldKeyTable eq ?
     2587            then next block_where.
     2588         end.
     2589         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2590         then
     2591            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2592         else
     2593            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2594         if p-key-handle = ? then do:
     2595           assign
     2596             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2597           .
     2598         end.
     2599         else do:
     2600           assign
     2601             fh_key = p-key-handle:buffer-field( v-field-name )
     2602           .
     2603           if fh_key = ?
     2604             or not valid-handle( fh_key )
     2605           then do:
     2606             delete object bh_tbl-name.
     2607             if     bh_tbl-key ne ?
     2608             then
     2609                delete object bh_tbl-key.
     2610             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     2611           end.
     2612           assign
     2613             v-field-val = fh_key:buffer-value
     2614           .
     2615         end.
     2616         if fh_search:data-type ="character":U then do:
     2617           assign
     2618             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2619             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2620             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2621             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2622             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2623             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2624             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2625             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2626             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2627             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2628             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2629             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2630             v-field-val = substitute( '"&1"', v-field-val )
     2631           .
     2632         end.
     2633         assign
     2634           o-where = substitute( "&1 &2", o-where, v-field-val )
     2635         .
     2636         if v-word-link = "":U then do:
     2637           assign
     2638             v-word-link = "and":U
     2639           .
     2640         end.
     2641       end.
     2642       delete object bh_tbl-name.
     2643       if     bh_tbl-key ne ?
     2644       then
     2645          delete object bh_tbl-key.
     2646       if p-key-handle = ?
     2647         and v-count-fld <> v-field-num
     2648       then do:
     2649         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     2650       end.
     2651     end.
     2652   end procedure.
     2653   procedure gen-hn-keyr-tab :
     2654     define input  parameter i-tableSerach as character no-undo.
     2655     define input  parameter i-tablekey   as character no-undo.
     2656     define input  parameter p-key-rec    as character no-undo.
     2657     define input  parameter p-key-handle as handle    no-undo .
     2658     define input  parameter p-db-name    as character no-undo .
     2659     define input  parameter p-tt-handle  as handle    no-undo .
     2660     define input  parameter p-stts-lock  as integer   no-undo .
     2661     define output parameter o-hn         as handle    no-undo.
     2662     define variable v-full-tbl-name as character no-undo.
     2663     define variable v-where         as character no-undo.
     2664     define variable bh_tbl-name     as handle    no-undo.
     2665     define variable vTable          as character no-undo.
     2666     do
     2667     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2668     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2669     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2670         run gen-where-keyr-tab(i-tableSerach,
     2671                                i-tablekey,
     2672                                p-key-rec,
     2673                                p-key-handle,
     2674                                p-db-name,
     2675                                p-tt-handle,
     2676                                output v-where).
     2677         if i-tableSerach ne "" and i-tableSerach ne ?
     2678         then do:
     2679            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2680            create buffer bh_tbl-name for table v-full-tbl-name .
     2681         end.
     2682         else do:
     2683            if p-tt-handle = ? then do:
     2684               assign
     2685                  vTable = entry( 1 , p-key-rec, chr(3) )
     2686               .
     2687               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2688               create buffer bh_tbl-name for table v-full-tbl-name .
     2689            end.
     2690            else do:
     2691               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2692            end.
     2693         end.
     2694         if p-tt-handle = ? then do:
     2695            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2696         end.
     2697         else do:
     2698            bh_tbl-name:find-first( v-where ) no-error .
     2699         end.
     2700         o-hn = bh_tbl-name.
     2701      end.
     2702   end procedure.
     2703   procedure gen-hn-keyr :
     2704     define input  parameter p-key-rec    as character no-undo.
     2705     define input  parameter p-key-handle as handle    no-undo .
     2706     define input  parameter p-db-name    as character no-undo .
     2707     define input  parameter p-tt-handle  as handle    no-undo .
     2708     define input  parameter p-stts-lock  as integer   no-undo .
     2709     define output parameter o-hn         as handle    no-undo.
     2710     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2711   end.
     2712   procedure gen-row-keyr :
     2713     define input  parameter p-key-rec    as character no-undo.
     2714     define input  parameter p-key-handle as handle    no-undo .
     2715     define input  parameter p-db-name    as character no-undo .
     2716     define input  parameter p-tt-handle  as handle    no-undo .
     2717     define input  parameter p-stts-lock  as integer   no-undo .
     2718     define output parameter p-tbl-row    as rowid     no-undo.
     2719     define output parameter p-tbl-name   as character no-undo.
     2720     define variable vHn as handle no-undo.
     2721       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2722       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2723       p-tbl-name =  vHn:table.
     2724       delete object vHn no-error.
     2725     if p-tbl-row = ? then do:
     2726       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     2727     end.
     2728     else do:
     2729       return.
     2730     end.
     2731   end procedure.
     2732   procedure gen-key-fv :
     2733     define input  parameter p-key-rec    as character no-undo .
     2734     define output parameter p-field-list as character no-undo .
     2735     define output parameter p-value-list as character no-undo.
     2736     do
     2737     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2738     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2739     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2740     :
     2741       define variable v-full-tbl-name  as character no-undo .
     2742       define variable bh_tbl-name      as handle    no-undo .
     2743       define variable v-tbl-name       as character no-undo .
     2744       define variable v-field-num      as integer   no-undo .
     2745       define variable v-count-fld      as integer   no-undo .
     2746       define variable v-inform         as character no-undo .
     2747       define variable v-ind            as integer   no-undo .
     2748       define variable v-idx-field-qnty as integer   no-undo .
     2749       define variable v-delim-key      as character no-undo .
     2750       if p-key-rec = ?
     2751         or p-key-rec = "":U
     2752       then do:
     2753         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     2754       end.
     2755       assign
     2756         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2757         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2758       .
     2759       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2760       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     2761       assign
     2762         v-inform = bh_tbl-name:index-information(1)
     2763         v-ind    = 2
     2764       .
     2765       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2766       on error undo, return error
     2767       :
     2768         assign
     2769           v-inform = bh_tbl-name:index-information( v-ind )
     2770           v-ind    = v-ind + 1
     2771         .
     2772       end.
     2773       if v-inform = ?
     2774         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2775         or entry( 3, v-inform, ",":U ) <> "1":U
     2776       then do:
     2777         delete object bh_tbl-name no-error.
     2778         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     2779       end.
     2780       assign
     2781         v-idx-field-qnty = num-entries( v-inform ) - 4
     2782       .
     2783       if v-idx-field-qnty < 2 then do:
     2784         delete object bh_tbl-name no-error.
     2785         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     2786       end.
     2787       assign
     2788         p-field-list = "":U
     2789         p-value-list = "":U
     2790         v-delim-key  = "":U
     2791         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2792         v-count-fld  = 0
     2793       .
     2794       block_where:
     2795       do v-ind = 1 to v-idx-field-qnty by 2
     2796       on error undo, return error
     2797       :
     2798         assign
     2799           v-count-fld = v-count-fld + 1
     2800         .
     2801         if v-count-fld > v-field-num then do:
     2802           leave block_where.
     2803         end.
     2804         assign
     2805           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2806           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2807         .
     2808         if v-ind = 1 then do:
     2809           assign
     2810             v-delim-key = chr(3)
     2811           .
     2812         end.
     2813       end.
     2814       delete object bh_tbl-name.
     2815       if v-count-fld <> v-field-num then do:
     2816         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     2817       end.
     2818     end.
     2819   end procedure.
     2820   procedure gen-key-field :
     2821     define input  parameter p-table      as character no-undo .
     2822     define output parameter p-field-list as character no-undo .
     2823     do
     2824     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2825     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2826     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2827     :
     2828       define variable v-full-tbl-name  as character no-undo .
     2829       define variable bh_tbl-name      as handle    no-undo .
     2830       define variable v-tbl-name       as character no-undo .
     2831       define variable v-field-num      as integer   no-undo .
     2832       define variable v-count-fld      as integer   no-undo .
     2833       define variable v-inform         as character no-undo .
     2834       define variable v-ind            as integer   no-undo .
     2835       define variable v-idx-field-qnty as integer   no-undo .
     2836       define variable v-delim-key      as character no-undo .
     2837       if p-table = ?
     2838         or p-table = "":U
     2839       then do:
     2840         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     2841       end.
     2842       assign
     2843         v-tbl-name      = p-table
     2844         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2845       .
     2846       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2847       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     2848       assign
     2849         v-inform = bh_tbl-name:index-information(1)
     2850         v-ind    = 2
     2851       .
     2852       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2853       on error undo, return error
     2854       :
     2855         assign
     2856           v-inform = bh_tbl-name:index-information( v-ind )
     2857           v-ind    = v-ind + 1
     2858         .
     2859       end.
     2860       if v-inform = ?
     2861         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2862         or entry( 3, v-inform, ",":U ) <> "1":U
     2863       then do:
     2864         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     2865       end.
     2866       assign
     2867         v-idx-field-qnty = num-entries( v-inform ) - 4
     2868       .
     2869       if v-idx-field-qnty < 2 then do:
     2870         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     2871       end.
     2872       assign
     2873         p-field-list = "":U
     2874         v-delim-key  = "":U
     2875         v-count-fld  = 0
     2876       .
     2877       block_where:
     2878       do v-ind = 1 to v-idx-field-qnty by 2
     2879       on error undo, return error
     2880       :
     2881         assign
     2882           v-count-fld = v-count-fld + 1
     2883         .
     2884         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2885         if v-ind = 1 then do:
     2886           assign
     2887             v-delim-key = chr(3)
     2888           .
     2889         end.
     2890       end.
     2891       delete object bh_tbl-name.
     2892     end.
     2893   end procedure.
     2894   function AddUtdErrForTab returns logical
     2895   (idb-num         as integer ,
     2896    idoc-id         as integer ,
     2897    iTab            as character,
     2898    iObj            as handle ,
     2899    iCheckType      as character,
     2900    iCodeErr        as character,
     2901    iCheckObj       as character ):
     2902      define buffer utd-err for utd-err.
     2903      define buffer utd for utd.
     2904      find first utd where utd.db-num     eq idb-num
     2905                       and utd.doc-id     eq idoc-id
     2906                       and utd.Direction  eq 'Outbound'
     2907      no-lock no-error.
     2908      if available utd
     2909      then
     2910         return no.
     2911      define variable vRecKey as character no-undo.
     2912            run gen-key-rec (input iTab,
     2913                             input  iObj,
     2914                             output vRecKey).
     2915      find first utd-err where utd-err.db-num     eq idb-num
     2916                           and utd-err.doc-id     eq idoc-id
     2917                           and utd-err.CheckType  eq iCheckType
     2918                           and utd-err.CodeErr    eq iCodeErr
     2919                           and utd-err.CheckObj   eq iCheckObj
     2920      exclusive-lock no-error.
     2921      if not available utd-err
     2922      then do:
     2923         create utd-err.
     2924         assign
     2925            utd-err.db-num         = idb-num
     2926            utd-err.doc-id         = idoc-id
     2927            utd-err.CheckType      = iCheckType
     2928            utd-err.CodeErr        = iCodeErr
     2929            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2930            utd-err.reckey         = vRecKey
     2931            utd-err.qnty           = 1
     2932         .
     2933      end.
     2934      else
     2935         utd-err.qnty = utd-err.qnty + 1.
     2936      return utd-err.qnty eq 1.
     2937   end.
     2938   function AddUtdErr returns logical
     2939   (idb-num         as integer ,
     2940    idoc-id         as integer ,
     2941    iObj            as handle ,
     2942    iCheckType      as character,
     2943    iCodeErr        as character,
     2944    iCheckObj       as character ):
     2945      AddUtdErrForTab
     2946         (idb-num,
     2947          idoc-id,
     2948          iObj:table,
     2949          iObj,
     2950          iCheckType,
     2951          iCodeErr,
     2952          iCheckObj).
     2953   end.
     2954   function ClearUtdErrTypeCode returns logical
     2955   (idb-num         as integer,
     2956    idoc-id         as integer ,
     2957    iCheckType      as character,
     2958    iCodeErr        as character
     2959    ):
     2960      define buffer utd-err for utd-err.
     2961      if    iCheckType eq "*"
     2962         or iCheckType eq ?
     2963      then do:
     2964         if     iCodeErr ne ?
     2965            and iCodeErr ne "*"
     2966         then
     2967            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2968            view-as alert-box.
     2969         else
     2970         for each utd-err where utd-err.db-num  eq idb-num
     2971                            and utd-err.doc-id  eq idoc-id
     2972         exclusive-lock:
     2973            delete utd-err.
     2974         end.
     2975      end.
     2976      else do:
     2977         if    iCodeErr eq ?
     2978            or iCodeErr eq "*"
     2979         then do:
     2980            for each utd-err where utd-err.db-num     eq idb-num
     2981                               and utd-err.doc-id     eq idoc-id
     2982                               and utd-err.CheckType  eq iCheckType
     2983            exclusive-lock:
     2984               delete utd-err.
     2985            end.
     2986         end.
     2987         else do:
     2988            for each utd-err where utd-err.db-num     eq idb-num
     2989                               and utd-err.doc-id     eq idoc-id
     2990                               and utd-err.CheckType  eq iCheckType
     2991                               and ub.utd-err.CodeErr eq iCodeErr
     2992            exclusive-lock:
     2993               delete utd-err.
     2994            end.
     2995         end.
     2996      end.
     2997   end.
     2998   function ClearUtdErr returns logical
     2999   (idb-num         as integer,
     3000    idoc-id         as integer ,
     3001    iCheckType      as character
     3002    ):
     3003      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3004   end.
     3005   function GetMesError returns character
     3006   (itxt as character,
     3007    iobj as character ):
     3008    define variable vi as integer no-undo.
     3009    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3010       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3011    end.
     3012    return itxt.
     3013   end.
     3014   function GetTextErrorType returns character
     3015   (iCheckType as character,
     3016    iCodeErr   as character,
     3017    iChechObj  as character,
     3018    iType      as character  ):
     3019      define buffer code    for code.
     3020      define variable vError as character no-undo.
     3021      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3022                        and code.code   eq iCodeErr
     3023      no-lock no-error.
     3024      if available code
     3025      then do:
     3026         define variable vType as integer no-undo.
     3027         if code.misc3 eq "error"
     3028         then
     3029            vType = 0.
     3030         else if code.misc3 eq "warning"
     3031         then
     3032            vType = 1.
     3033         else if code.misc3 eq "Hiden"
     3034         then
     3035            vType = 2.
     3036         else
     3037            vtype = int(code.misc3) no-error.
     3038         case itype:
     3039            when "error"
     3040            then do:
     3041               if vtype eq 0
     3042               then
     3043                  vError = GetMesError(Code.CodeValue,iChechObj).
     3044            end.
     3045            when "warning"
     3046            then do:
     3047               if vtype <= 1
     3048               then
     3049                  vError = GetMesError(Code.CodeValue,iChechObj).
     3050            end.
     3051            otherwise do:
     3052               vError = GetMesError(Code.CodeValue,iChechObj).
     3053            end.
     3054         end.
     3055      end.
     3056      else
     3057         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3058      return vError.
     3059   end.
     3060   function GetTypeError returns integer
     3061   (iCheckType as character,
     3062    iCodeErr   as character):
     3063      define buffer code    for code.
     3064      define variable vType as integer no-undo.
     3065      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3066                        and code.code   eq iCodeErr
     3067      no-lock no-error.
     3068      if     not available code
     3069         and code.misc3 eq "error"
     3070      then
     3071         vType = 0.
     3072      else if code.misc3 eq "warning"
     3073      then
     3074         vType = 1.
     3075      else if code.misc3 eq "Hiden"
     3076      then
     3077         vType = 2.
     3078      else
     3079         vtype = int(code.misc3) no-error.
     3080      return vtype.
     3081   end.
     3082   function GetTextError returns character
     3083   (iCheckType as character,
     3084    iCodeErr   as character,
     3085    iChechObj  as character ):
     3086      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3087   end.
     3088   function GetErrForUtdStr returns character
     3089   (idb-num     as integer ,
     3090    idoc-id     as integer ,
     3091    iCheckType  as character
     3092    ):
     3093      define buffer utd-err for utd-err.
     3094      define buffer code    for code.
     3095      define variable vHQry as handle no-undo.
     3096      define variable vError as longchar no-undo.
     3097      define variable vErrorOne as longchar  no-undo.
     3098      define variable oError as character no-undo.
     3099      create query vHQry.
     3100      vHQry:set-buffers(buffer utd-err:handle).
     3101      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3102                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3103                               + if    iCheckType eq "*"
     3104                                    or iCheckType eq ?
     3105                                 then       ""
     3106                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3107      vHQry:query-open().
     3108      vHQry:get-first().
     3109      QRY-BLOCK:
     3110      repeat while not vHQry:query-off-end:
     3111         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3112         if     vErrorOne ne ""
     3113            and vErrorOne ne ?
     3114         then
     3115            vError = vError + ", " + vErrorOne.
     3116         vHQry:get-next().
     3117      end.
     3118      oError = substring(vError,3,4002).
     3119      return oError.
     3120   end.
     3121   function GetErrJsonForUtd returns character
     3122   (idb-num         as integer ,
     3123    idoc-id         as integer ,
     3124    iCheckType      as character
     3125    ):
     3126      define buffer utd-err for utd-err.
     3127      define variable vHQry as handle no-undo.
     3128      define variable vError as longchar no-undo.
     3129      define variable oError as character no-undo.
     3130      create query vHQry.
     3131      define variable vi as integer no-undo.
     3132      vHQry:set-buffers(buffer utd-err:handle).
     3133      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3134                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3135                               + if    iCheckType eq "*"
     3136                                    or iCheckType eq ?
     3137                                 then       ""
     3138                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3139      vHQry:query-open().
     3140      vHQry:get-first().
     3141      QRY-BLOCK:
     3142      repeat while not vHQry:query-off-end:
     3143         define variable vErrorOne as character no-undo.
     3144         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3145         if     vErrorOne ne ?
     3146            and vErrorOne ne ""
     3147         then do:
     3148            vi = vi + 1.
     3149            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3150                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3151                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3152         end.
     3153         vHQry:get-next().
     3154      end.
     3155      for first utd where utd.db-num eq idb-num
     3156                      and utd.doc-id eq idoc-id
     3157                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3158      no-lock,
     3159         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3160                                  and utd-marking-lines.doc-id eq idoc-id
     3161                                  and utd-marking-lines.doc-level eq 1
     3162      no-lock,
     3163         first marking where marking.mark eq utd-marking-lines.mark
     3164                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3165      no-lock:
     3166         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3167         if     vErrorOne ne ?
     3168            and vErrorOne ne ""
     3169         then do:
     3170            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3171                            + '","ОбъектОш":"' + marking.mark
     3172                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3173         end.
     3174      end.
     3175      if vError ne ""
     3176      then
     3177         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3178      return oError.
     3179   end.
     3180   function GetErrJsonForUtdReturn returns character
     3181   (idb-num         as integer ,
     3182    idoc-id         as integer ,
     3183    iCheckType      as character
     3184    ):
     3185      define buffer utd-err for utd-err.
     3186      define variable vHQry as handle no-undo.
     3187      define variable vError as longchar no-undo.
     3188      define variable oError as character no-undo.
     3189      define variable vi as integer no-undo.
     3190      create query vHQry.
     3191      vHQry:set-buffers(buffer utd-err:handle).
     3192      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3193                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3194                               + if    iCheckType eq "*"
     3195                                    or iCheckType eq ?
     3196                                 then       ""
     3197                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3198      vHQry:query-open().
     3199      vHQry:get-first().
     3200      QRY-BLOCK:
     3201      repeat while not vHQry:query-off-end:
     3202         define variable vErrorOne as character no-undo.
     3203         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3204         if     vErrorOne ne ?
     3205            and vErrorOne ne ""
     3206         then do:
     3207            vi = vi + 1.
     3208            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3209                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3210                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3211         end.
     3212         vHQry:get-next().
     3213      end.
     3214      if vError ne ""
     3215      then
     3216         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3217      return oError.
     3218   end.
     3219   function GetCodeTextError returns character
     3220   (iCheckType as character,
     3221    iCodeErr   as character,
     3222    iChechObj  as character,
     3223    output oCode as character,
     3224    output ovalue as character ):
     3225      define buffer code    for code.
     3226      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3227                        and code.code   eq iCodeErr
     3228      no-lock no-error.
     3229      if     available code
     3230      then do:
     3231         define variable vi as integer no-undo init ?.
     3232         vi = int(Code.misc3) no-error.
     3233         if    code.misc3 ne "error"
     3234            and vi ne 0
     3235         then
     3236            oCode = ?.
     3237         else if     Code.misc1 ne ?
     3238                 and Code.misc1 ne ""
     3239         then
     3240            assign
     3241               oCode  = GetMesError(Code.misc1,iChechObj)
     3242               ovalue = GetMesError(Code.misc2,iChechObj)
     3243            .
     3244      end.
     3245      return if oCode eq ""
     3246             then ""
     3247             else (oCode + "_" + ovalue).
     3248   end.
     3249   define temp-table TT-err no-undo
     3250     field code_ as character
     3251     field text_ as character
     3252   index code_ code_.
     3253   function GetErrTxtForUtd returns character
     3254   (idb-num         as integer ,
     3255    idoc-id         as integer ,
     3256    iCheckType      as character
     3257    ):
     3258      define buffer utd-err for utd-err.
     3259      define variable vHQry as handle no-undo.
     3260      define variable oError as character no-undo.
     3261      create query vHQry.
     3262      define variable vi as integer no-undo.
     3263      for each tt-err :
     3264         delete tt-err.
     3265      end.
     3266      vHQry:set-buffers(buffer utd-err:handle).
     3267      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3268                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3269                               + if    iCheckType eq "*"
     3270                                    or iCheckType eq ?
     3271                                 then       ""
     3272                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3273      vHQry:query-open().
     3274      vHQry:get-first().
     3275      define variable vcode as character no-undo.
     3276      define variable vvalue as character no-undo.
     3277      QRY-BLOCK:
     3278      repeat while not vHQry:query-off-end:
     3279         vi = vi + 1.
     3280         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3281         if vcode ne ?
     3282         then do:
     3283            find first tt-err where tt-err.code eq vcode
     3284            no-error.
     3285            if not available tt-err
     3286            then do:
     3287               create tt-err.
     3288               assign
     3289                  tt-err.code_ = vcode
     3290                  tt-err.text_ = vvalue
     3291               .
     3292            end.
     3293            else
     3294               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3295         end.
     3296         vHQry:get-next().
     3297      end.
     3298     find first utd where utd.db-num eq idb-num
     3299                         and utd.doc-id eq idoc-id
     3300         no-lock.
     3301      define buffer cancel_utd-lines for utd-lines.
     3302      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3303                                  and cancel_utd-lines.doc-id eq idoc-id
     3304      no-lock:
     3305         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3306         then do:
     3307            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3308                                        and utd-marking-lines.doc-id eq idoc-id
     3309                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3310            no-lock,
     3311               first marking where marking.mark eq utd-marking-lines.mark
     3312                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3313            no-lock:
     3314               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3315               find first tt-err where tt-err.code eq vcode
     3316               no-error.
     3317               if not available tt-err
     3318               then do:
     3319                  create tt-err.
     3320                  assign
     3321                     tt-err.code_ = vcode
     3322                     tt-err.text_ = vvalue
     3323                  .
     3324               end.
     3325               else
     3326                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3327            end.
     3328         end.
     3329         else do:
     3330            define variable vqnty as decimal no-undo.
     3331            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3332            if vqnty eq ? then vqnty = 0.
     3333            if vqnty ne cancel_utd-lines.Quantity
     3334            then do:
     3335               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3336               find first tt-err where tt-err.code eq vcode
     3337               no-error.
     3338               if not available tt-err
     3339               then do:
     3340                  create tt-err.
     3341                  assign
     3342                     tt-err.code_ = vcode
     3343                     tt-err.text_ = vvalue
     3344                  .
     3345               end.
     3346               else
     3347                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3348            end.
     3349         end.
     3350      end.
     3351      for each tt-err:
     3352         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3353      end.
     3354      return oError.
     3355   end.
     3356   define variable mFormatErr as character no-undo init "text".
     3357   function GetErrForUtd returns character
     3358   (idb-num         as integer ,
     3359    idoc-id         as integer ,
     3360    iType           as character
     3361    ):
     3362      if mFormatErr eq "text"
     3363      then
     3364         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3365      else do:
     3366         if itype eq "return"
     3367         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3368         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3369      end.
     3370   end.
     3371   function GetErrComText returns longchar
     3372   (icomment as character,
     3373    itext    as longchar ):
     3374       define variable vText as longchar no-undo.
     3375      if mFormatErr eq "text"
     3376      then do:
     3377         if icomment ne ""
     3378         then
     3379            icomment = substitute("comment:|&1|",icomment).
     3380         vText = icomment + itext.
     3381      end.
     3382      else do:
     3383         icomment = if icomment begins  '"'
     3384                    then icomment
     3385                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3386         vText = icomment + "," + itext.
     3387         vText = "~{" + trim(vText,",") + "~}".
     3388      end.
     3389      return vText.
     3390   end.
     3391   function CheckTypeForMarkLineType returns logical
     3392   (iObj            as handle,
     3393    iCheckType      as character,
     3394    iCodeErr        as character ,
     3395    iTypeErr        as character ):
     3396      define variable vRecKey-markLine as character no-undo.
     3397      define variable vGoodMark        as logical no-undo.
     3398      define variable vdb-num          as integer no-undo.
     3399      define variable vdoc-id          as integer no-undo.
     3400      define variable vlinenum         as integer no-undo.
     3401      define variable vErrorOne as character no-undo.
     3402      define buffer buf_utd-err for utd-err.
     3403      run gen-key-rec (input "utd-marking-lines",
     3404                       input  iObj,
     3405                       output vRecKey-markLine).
     3406      vGoodMark = yes.
     3407      vdb-num = iObj::db-num.
     3408      vdoc-id = iObj::doc-id.
     3409      vlinenum = iObj::linenum.
     3410      block-mark-err:
     3411      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3412                               and buf_utd-err.db-num = vdb-num
     3413                               and buf_utd-err.reckey = vRecKey-markLine
     3414                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3415                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3416      no-lock:
     3417         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3418         if     vErrorOne ne ?
     3419            and vErrorOne ne ""
     3420         then do:
     3421            vGoodMark = no.
     3422            leave block-mark-err.
     3423         end.
     3424      end.
     3425      return not vGoodMark.
     3426   end.
     3427   function CheckErrForMarkLineType returns logical
     3428   (iObj            as handle,
     3429    iType           as character  ):
     3430      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3431   end.
     3432   function CheckErrForMarkLine returns logical
     3433   (iObj            as handle):
     3434      return CheckErrForMarkLineType(iObj,"*").
     3435   end.
     3436   function CheckErrForLineTypeCode returns logical
     3437   (iObj                 as handle,
     3438    iCheckType           as character,
     3439    iCodeErr             as character,
     3440    iTypeErr             as character,
     3441    iOneErr              as logical):
     3442      define variable vRecKey-line     as character no-undo.
     3443      define buffer buf_utd-err for utd-err.
     3444      define variable vUtdlineError as logical no-undo.
     3445      define variable vErrorOne as character no-undo.
     3446            run gen-key-rec (input "utd-lines",
     3447                             input  iObj,
     3448                             output vRecKey-line).
     3449         define variable vdb-num as integer no-undo.
     3450         define variable vdoc-id as integer no-undo.
     3451         define variable vlinenum as integer no-undo.
     3452         vdb-num = iObj::db-num.
     3453         vdoc-id = iObj::doc-id.
     3454         vlinenum = iObj::linenum.
     3455         block-err:
     3456         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3457                                  and buf_utd-err.db-num = vdb-num
     3458                                  and buf_utd-err.reckey = vRecKey-line
     3459                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3460                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3461         no-lock:
     3462            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3463            if     vErrorOne ne ?
     3464               and vErrorOne ne ""
     3465            then do:
     3466               vUtdlineError = yes.
     3467               leave block-err.
     3468            end.
     3469         end.
     3470         if  not vUtdlineError
     3471         then do:
     3472            define variable vGoodMark as logical no-undo.
     3473            vGoodMark = yes.
     3474            block-line-err:
     3475            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3476                                         and utd-marking-lines.doc-id  eq vdoc-id
     3477                                         and utd-marking-lines.LineNum eq vLineNum
     3478            no-lock:
     3479               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3480               if     vGoodMark
     3481                  and iOneErr eq no
     3482               then
     3483                  leave block-line-err.
     3484               if     iOneErr = yes
     3485                  and not vGoodMark
     3486               then
     3487                  leave block-line-err.
     3488            end.
     3489            vUtdlineError = not vGoodMark.
     3490         end.
     3491      return vUtdlineError.
     3492   end.
     3493   function getErrForLineType returns character
     3494   (iObj            as handle,
     3495    iType           as character  ):
     3496      define variable vRecKey-line     as character no-undo.
     3497      define buffer buf_utd-err for utd-err.
     3498      define variable vUtdlineError as logical no-undo.
     3499      define variable vErrorOne as character no-undo.
     3500      define variable oError as character no-undo.
     3501            run gen-key-rec (input "utd-lines",
     3502                             input  iObj,
     3503                             output vRecKey-line).
     3504         define variable vdb-num as integer no-undo.
     3505         define variable vdoc-id as integer no-undo.
     3506         define variable vlinenum as integer no-undo.
     3507         vdb-num = iObj::db-num.
     3508         vdoc-id = iObj::doc-id.
     3509         vlinenum = iObj::linenum.
     3510         block-err:
     3511         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3512                                  and buf_utd-err.db-num = vdb-num
     3513                                  and buf_utd-err.reckey = vRecKey-line
     3514                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3515         no-lock:
     3516            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3517            if     vErrorOne ne ?
     3518               and vErrorOne ne ""
     3519            then do:
     3520               oError = oError + vErrorOne + " ".
     3521            end.
     3522         end.
     3523      return oError.
     3524   end.
     3525   function CheckErrForLineType returns logical
     3526   (iObj            as handle,
     3527    iType           as character  ):
     3528       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3529   end.
     3530   function CheckErrForLine returns logical
     3531   (iObj            as handle):
     3532      return CheckErrForLineType(iobj,"*").
     3533   end.
     3534   function CheckErrForUtd returns logical
     3535   (idb-num         as integer ,
     3536    idoc-id         as integer ):
     3537      for each utd-lines where utd-lines.db-num eq idb-num
     3538                           and utd-lines.doc-id eq idoc-id
     3539      no-lock :
     3540         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3541         then
     3542            return no.
     3543      end.
     3544      return yes.
     3545   end.
     3546   function CheckMarkUtd-28rel return logical
     3547    (input idb-num as integer,
     3548    input idoc-id as integer):
     3549    define buffer utd                   for utd.
     3550    define buffer utd-lines             for utd-lines.
     3551    define buffer utd-marking-lines     for utd-marking-lines.
     3552    define variable v-par-type as character no-undo.
     3553    define variable vgdsNoMark as logical no-undo.
     3554    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3555      define variable v-par-val  as character no-undo.
     3556      find first utd where utd.db-num eq idb-num
     3557                       and utd.doc-id eq idoc-id
     3558      no-lock no-error.
     3559      if available utd
     3560      then do:
     3561         if     utd.obj-code ne ?
     3562            and utd.obj-type ne ?
     3563         then do:
     3564            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3565            Block-utd-lines:
     3566            for each utd-lines where utd-lines.db-num eq idb-num
     3567                                 and utd-lines.doc-id eq idoc-id
     3568            no-lock:
     3569               if     utd-lines.gds-code ne ?
     3570                  and utd-lines.gds-code ne 0
     3571               then do:
     3572                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3573                       ( utd-lines.gds-code,
     3574                         'mark-type':U,
     3575                          output v-par-val,
     3576                          output v-par-type
     3577                       ).
     3578                  if     EDOParSec:IsEdo
     3579                     and EDOParSec:GetIsEDOForType(v-par-val)
     3580                  then do:
     3581                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3582                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3583                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3584                                                    and length(utd-marking-lines.mark) > 13
     3585                     no-lock no-error.
     3586                     if     avail utd-marking-lines
     3587                        and not CheckErrForLine(buffer utd-lines:handle)
     3588                     then
     3589                        leave Block-utd-lines.
     3590                  end.
     3591                  else
     3592                     vgdsNoMark = yes.
     3593               end.
     3594            end.
     3595            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3596            if vgdsNoMark then return available utd-lines . else return yes .
     3597         end.
     3598      end.
     3599      return yes.
     3600   end.
     3601   function CheckMarkUtd return logical
     3602    (input idb-num  as integer,
     3603     input idoc-id  as integer):
     3604     define buffer utd-lines             for ub.utd-lines.
     3605     block-line:
     3606     for each utd-lines where utd-lines.db-num eq idb-num
     3607                          and utd-lines.doc-id eq idoc-id
     3608     no-lock:
     3609        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3610        then
     3611           leave block-line.
     3612     end.
     3613     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3614     return available utd-lines.
     3615   end.
     3616   function CheckNotMarkUtd return logical
     3617    (input idb-num  as integer,
     3618     input idoc-id  as integer):
     3619     define buffer utd-lines             for ub.utd-lines.
     3620     for each utd-lines where utd-lines.db-num eq idb-num
     3621                          and utd-lines.doc-id eq idoc-id
     3622     no-lock:
     3623        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3624        then
     3625           return yes.
     3626     end.
     3627     return no.
     3628   end.
     3629   function CheckMarkUtdLine return logical
     3630    (input idb-num  as integer,
     3631     input idoc-id  as integer,
     3632     input iLineNum as integer):
     3633    define buffer utd                   for utd.
     3634    define buffer utd-lines             for utd-lines.
     3635    define buffer utd-marking-lines     for utd-marking-lines.
     3636    define variable v-par-type as character no-undo.
     3637    define variable vMarking        as logical no-undo.
     3638    define variable vArtic          as logical no-undo.
     3639    define variable vTransitional   as logical no-undo.
     3640    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3641      define variable v-par-val  as character no-undo.
     3642      find first utd where utd.db-num eq idb-num
     3643                       and utd.doc-id eq idoc-id
     3644      no-lock no-error.
     3645      if available utd
     3646      then do:
     3647         if     utd.obj-code ne ?
     3648            and utd.obj-type ne ?
     3649         then do:
     3650            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3651            Block-utd-lines:
     3652            for each utd-lines where utd-lines.db-num   eq idb-num
     3653                                 and utd-lines.doc-id   eq idoc-id
     3654                                 and utd-lines.LineNum  eq iLineNum
     3655            no-lock:
     3656               if     utd-lines.gds-code ne ?
     3657                  and utd-lines.gds-code ne 0
     3658               then do:
     3659                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3660                       ( utd-lines.gds-code,
     3661                         'mark-type':U,
     3662                          output v-par-val,
     3663                          output v-par-type
     3664                       ).
     3665                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3666                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3667                  if vMarking
     3668                  then do:
     3669                     block-marking:
     3670                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3671                                                    and utd-marking-lines.doc-id   eq idoc-id
     3672                                                    and utd-marking-lines.LineNum  eq iLineNum
     3673                                                    and length(utd-marking-lines.mark) > 13
     3674                     no-lock:
     3675                        if isOAD(utd-marking-lines.mark)
     3676                        then do:
     3677                           assign
     3678                              vArtic   = yes
     3679                              vMarking = no
     3680                           .
     3681                           leave block-marking.
     3682                        end.
     3683                     end.
     3684                  end.
     3685                  if vArtic
     3686                  then do:
     3687                     block-artic:
     3688                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3689                                                    and utd-marking-lines.doc-id   eq idoc-id
     3690                                                    and utd-marking-lines.LineNum  eq iLineNum
     3691                                                    and length(utd-marking-lines.mark) > 13
     3692                     no-lock:
     3693                        if isMark(utd-marking-lines.mark)
     3694                        then do:
     3695                           assign
     3696                              vArtic   = no
     3697                              vMarking = yes
     3698                           .
     3699                           leave block-artic.
     3700                        end.
     3701                     end.
     3702                  end.
     3703                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3704                  if vTransitional
     3705                  then do:
     3706                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3707                                                    and utd-marking-lines.doc-id   eq idoc-id
     3708                                                    and utd-marking-lines.LineNum  eq iLineNum
     3709                                                    and length(utd-marking-lines.mark) > 13
     3710                     no-lock no-error.
     3711                     if not available utd-marking-lines
     3712                     then assign
     3713                        vMarking = no
     3714                        vArtic   = no
     3715                     .
     3716                  end.
     3717               end.
     3718               else
     3719                  assign
     3720                     vMarking      = yes
     3721                     vArtic        = no
     3722                     vTransitional = no
     3723                  .
     3724               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3725               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3726               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3727            end.
     3728         end.
     3729      end.
     3730      return vMarking or vArtic.
     3731   end.
     3732   function getMarkUtdLine return logical
     3733    (input  idb-num  as integer,
     3734     input  idoc-id  as integer,
     3735     input  iLineNum as integer,
     3736     output oMarking        as logical,
     3737     output oArtic          as logical,
     3738     output oTransitional   as logical):
     3739     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3740     oArtic        = not oMarking
     3741            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3742     oTransitional = (oMarking or oArtic)
     3743            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3744   end.
     3745   function CheckMarking return logical
     3746    (input idb-num as integer,
     3747    input idoc-id as integer,
     3748    input iTypeErr as character ):
     3749     define variable vMarkutd as logical no-undo.
     3750     define variable vCrErr   as logical no-undo.
     3751     define buffer utd-lines         for utd-lines.
     3752     define buffer utd-marking-lines for utd-marking-lines.
     3753     define buffer marking           for marking.
     3754     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3755      block-line:
     3756      for each utd-lines where utd-lines.db-num eq idb-num
     3757                           and utd-lines.doc-id eq idoc-id
     3758      no-lock:
     3759         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3760         then do:
     3761            for each utd-marking-lines
     3762                     where utd-marking-lines.db-num  = utd-lines.db-num
     3763                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3764                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3765            no-lock:
     3766               if isMark(utd-marking-lines.mark)
     3767               then do:
     3768                  find first marking where marking.mark eq utd-marking-lines.mark
     3769                  no-lock no-error.
     3770                  if not available marking
     3771                  then do:
     3772                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3773                     vCrErr = yes.
     3774                     next block-line.
     3775                  end.
     3776               end.
     3777            end.
     3778         end.
     3779      end.
     3780      return vCrErr.
     3781   end.
     3782   function CheckMarkForType return logical
     3783    (input idb-num   as integer,
     3784     input idoc-id   as integer):
     3785      define variable vMarking        as logical no-undo.
     3786      define variable vArtic          as logical no-undo.
     3787      define variable vTransitional   as logical no-undo.
     3788      define buffer utd-lines         for utd-lines.
     3789      define buffer utd-marking-lines for utd-marking-lines.
     3790      block-line:
     3791      for each utd-lines where utd-lines.db-num eq idb-num
     3792                           and utd-lines.doc-id eq idoc-id
     3793      no-lock:
     3794         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3795                          output vMarking         , output vArtic          , output vTransitional).
     3796         for each utd-marking-lines
     3797                     where utd-marking-lines.db-num  = utd-lines.db-num
     3798                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3799                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3800         no-lock:
     3801            if length(utd-marking-lines.mark) < 14
     3802            then do:
     3803               if (vMarking or vArtic) and not vTransitional
     3804               then
     3805                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3806            end.
     3807            else if not isMark(utd-marking-lines.mark)
     3808            then do:
     3809               if vMarking
     3810               then
     3811                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3812            end.
     3813            else do:
     3814            end.
     3815         end.
     3816      end.
     3817   end.
     3818   function WeighedProd return logical
     3819      ( input p-gds-code as integer) :
     3820      define variable v-par-val  as character no-undo.
     3821      define variable v-par-type as character no-undo.
     3822              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3823               ( p-gds-code,
     3824                 'weighed-gds':U,
     3825                  output v-par-val,
     3826                  output v-par-type
     3827               ).
     3828      return logical(v-par-val).
     3829   end.
     3830   function WghProdVariable return logical
     3831       (input p-obj-type as char,
     3832        input p-obj-code as integer,
     3833        input p-gds-code as integer) :
     3834      define variable v-wgh-val  as character no-undo.
     3835      define variable v-par-val  as character no-undo.
     3836      define variable v-par-type as character no-undo.
     3837      define variable vMarking        as logical no-undo.
     3838      define variable vArtic          as logical no-undo.
     3839      define variable vTransitional   as logical no-undo.
     3840      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3841         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3842           ( p-gds-code,
     3843             'weighed-gds':U,
     3844              output v-wgh-val,
     3845              output v-par-type
     3846           ).
     3847       if logical(v-wgh-val) = yes then do:
     3848           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3849               ( p-gds-code,
     3850                 'mark-type':U,
     3851                  output v-par-val,
     3852                  output v-par-type
     3853               ).
     3854           if v-par-val <> "" then do:
     3855               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3856               assign
     3857                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3858                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3859                  .
     3860           end.
     3861      end.
     3862      if v-wgh-val > "" and (vMarking or vArtic)
     3863      then return yes.
     3864      else return no.
     3865   end.
     3866   function MarkWeight return decimal
     3867      ( input p-mark as character) :
     3868      define buffer  buf_marking-attr for  ub.marking-attr.
     3869      define variable vMarkWeight as decimal no-undo.
     3870      vMarkWeight = 0.
     3871      if p-mark <> "" and p-mark <> ?
     3872      then do:
     3873          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3874                                        and buf_marking-attr.attr-code eq "weight"
     3875             no-lock no-error.
     3876          if not available buf_marking-attr
     3877          then do :
     3878            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3879                                          and buf_marking-attr.attr-code eq "weight"
     3880               no-lock no-error.
     3881          end .
     3882          if avail buf_marking-attr
     3883          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3884      end.
     3885      return vMarkWeight.
     3886   end.
     3887   define input parameter parparentproc as handle no-undo .
     3888   define input parameter p-goods-recid as recid no-undo .
     3889   define output parameter table for tt-marking-lines .
     3890   define variable iLang           as integer   no-undo.
     3891   define variable p-value-logical as logical no-undo.
     3892   define variable p-value-character  as character no-undo.
     3893   define variable p-value-date       as date no-undo.
     3894   define variable p-value-decimal    as decimal no-undo.
     3895   define variable p-value-integer    as integer no-undo.
     3896   define variable p-param-type       as character no-undo.
     3897   define variable v-tth as handle no-undo .
     3898   define variable v-alc-code      as character no-undo .
     3899   define variable v-proc-name-err as character no-undo initial 'impmark.txt'.
     3900   define variable l-error         as logical   no-undo.
     3901   define variable v-user-action   as character no-undo.
     3902   define variable v-printed       as logical   no-undo.
     3903   define variable v-mark-short     as character no-undo.
     3904   define buffer t_doc        for ub.fbr-doc .
     3905   define buffer buf_fbr-doc   for ub.fbr-doc .
     3906   define buffer buf_marking  for ub.marking .
     3907   define buffer buf_marking-lines  for ub.marking-lines .
     3908   define buffer buf_recipe   for ub.recipe .
     3909   define buffer buf_bar-code  for ub.bar-code.
     3910   define buffer buf_goods for ub.goods .
     3911   define buffer buf_gds-obj for ub.gds-obj .
     3912   define variable v-timedelay  as integer   no-undo.
     3913   define variable v-scan-str as character no-undo.
     3914   define variable v-num-str as integer no-undo .
     3915   define variable v-manual as logical no-undo .
     3916   define variable marking    as class ibs.th.skt.ControlledClients.marking.
     3917   define variable v-free-qnty as decimal no-undo .
     3918   define variable v-doc-qnty as decimal no-undo .
     3919   define variable v-scan-qnty as decimal no-undo .
     3920   define variable v-status-message as character no-undo .
     3921   define variable v-mark-weight as decimal no-undo .
     3922   define variable v-isweighed as logical no-undo .
     3923   define stream str-err .
     3924   define stream in-stream.
     3925   DEFINE BUTTON b-exit AUTO-GO
     3926        LABEL "&Выход"
     3927        SIZE 10 BY 1
     3928        BGCOLOR 8 .
     3929   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
     3930        VIEW-AS FILL-IN
     3931        SIZE 84 BY 1 NO-UNDO.
     3932   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     3933        LABEL "Марка"
     3934        VIEW-AS FILL-IN
     3935        SIZE 76 BY 1 NO-UNDO.
     3936   DEFINE FRAME Dialog-Frame
     3937        b-exit AT ROW 1 COL 2
     3938        v-mark AT ROW 2.38 COL 2.2
     3939        f-msg AT ROW 3.71 COL 2 NO-LABEL WIDGET-ID 92
     3940        SPACE(1.39) SKIP(0.57)
     3941       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3942            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3943            TITLE "Ввод марок для производства"
     3944            DEFAULT-BUTTON b-exit.
     3945   ASSIGN
     3946          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3947          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3948   ASSIGN
     3949          f-msg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3950   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3951   do:
     3952   end.
     3953   ON any-printable OF v-mark IN FRAME Dialog-Frame
     3954   do:
     3955     run proc-any-key.
     3956   end.
     3957   ON ENTRY OF v-mark IN FRAME Dialog-Frame
     3958   DO:
     3959       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     3960       run adm/shattri.p (
     3961                  input "get":U
     3962                  ,input  v-cntxt-obj-type
     3963                  ,input  v-cntxt-obj-code
     3964                  ,input  'marking':U
     3965                  ,input  'rus-key':U
     3966                  ,output p-value-character
     3967                  ,output p-value-date
     3968                  ,output p-value-decimal
     3969                  ,output p-value-integer
     3970                  ,output p-value-logical
     3971                  ,output p-param-type
     3972                  ,input-output table-handle v-tth
     3973                  ) no-error .
     3974       IF p-value-logical = yes THEN  iLang = 68748313.
     3975       run ActivateKeyboardLayout (input iLang, input 0).
     3976     END.
     3977   ON LEAVE OF v-mark IN FRAME Dialog-Frame
     3978   DO:
     3979       assign frame Dialog-Frame v-mark .
     3980   END.
     3981   ON MOUSE-SELECT-DBLCLICK OF v-mark IN FRAME Dialog-Frame
     3982   DO:
     3983       run save_update .
     3984   END.
     3985   ON return OF v-mark IN FRAME Dialog-Frame
     3986   DO:
     3987       run save_update .
     3988   END.
     3989   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3990     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3991   MAIN-BLOCK:
     3992   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3993   :
     3994     define variable v-GTIN as character no-undo .
     3995     define variable v-GTIN-qnty as decimal no-undo .
     3996   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3997     run mainmenu_getcntxt in parparentproc
     3998       (output v-cntxt-db-num
     3999       ,output v-cntxt-userid
     4000       ,output v-cntxt-level
     4001       ,output v-cntxt-host-code-obj
     4002       ,output v-cntxt-obj-type
     4003       ,output v-cntxt-obj-code
     4004       ,output v-cntxt-db-num-obj
     4005       ,output v-cntxt-is-admin
     4006       ) .
     4007     assign v-num-str = 0 .
     4008     marking = new ibs.th.skt.ControlledClients.marking() .
     4009     find first buf_goods no-lock where recid(buf_goods) = p-goods-recid .
     4010     if not available buf_goods
     4011     then do :
     4012       return error .
     4013     end .
     4014     assign v-scan-qnty = 0 .
     4015     run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     4016     run adm/shattri.p (
     4017              input "get":U
     4018              ,input  v-cntxt-obj-type
     4019              ,input  v-cntxt-obj-code
     4020              ,input  'marking':U
     4021              ,input  'rus-key':U
     4022              ,output p-value-character
     4023              ,output p-value-date
     4024              ,output p-value-decimal
     4025              ,output p-value-integer
     4026              ,output p-value-logical
     4027              ,output p-param-type
     4028              ,input-output table-handle v-tth
     4029              ) no-error .
     4030     IF p-value-logical = yes THEN  iLang = 68748313.
     4031     run ActivateKeyboardLayout (input iLang, input 0).
     4032     RUN enable_UI.
     4033     v-status-message = "Просканировано: " + string(v-scan-qnty) .
     4034     run dispmessage (v-status-message).
     4035     apply "entry" to v-mark in FRAME Dialog-Frame.
     4036     enable v-mark with frame Dialog-Frame.
     4037     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsManual
     4038     then v-manual = yes.
     4039     else do:
     4040       v-manual = no .
     4041       v-mark:READ-ONLY IN FRAME Dialog-Frame = TRUE .
     4042     end.
     4043     WAIT-FOR GO OF FRAME Dialog-Frame.
     4044   END.
     4045   RUN disable_UI.
     4046   PROCEDURE ActivateKeyboardLayout external "user32" :
     4047   define input parameter P1 as LONG.
     4048      define input parameter P2 as LONG.
     4049   END PROCEDURE.
     4050   PROCEDURE CrCheckMark :
     4051     define buffer buf_recipe for ub.recipe .
     4052     define buffer buf_recipe-gds for ub.recipe-gds .
     4053     define buffer buf_marking-child for ub.marking .
     4054     define buffer buf_marking-parent for ub.marking .
     4055     define buffer buf2_goods for ub.goods .
     4056     define variable v-par-type as character no-undo.
     4057     define variable v-par-val  as character no-undo.
     4058     define variable v-gds-code as integer no-undo .
     4059     define variable v-num-recipes as integer no-undo .
     4060     define variable v-GTIN as character no-undo .
     4061     define variable v-GTIN-qnty as decimal no-undo .
     4062     define variable v-mark-child-qnty as decimal no-undo .
     4063     define variable v-old-sts as integer no-undo .
     4064     define variable v-recipe-code like ub.recipe.recipe-code no-undo .
     4065     define variable v-ingr-gds-code as integer no-undo .
     4066     define variable v-GisMTcheckStatus as integer no-undo .
     4067     define variable v-is-off-line as logical no-undo .
     4068     assign
     4069       v-mark = v-mark:screen-value in frame Dialog-Frame.
     4070     if v-mark = ""
     4071       then return.
     4072     v-mark-short = GetCodeIdent(v-mark).
     4073     if v-mark-short = "" or v-mark-short = ?
     4074     then do:
     4075       message ("Неизвестный формат марки. Отсканируйте другую марку.")
     4076       view-as alert-box .
     4077       return.
     4078     end.
     4079     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     4080     if available buf_marking
     4081     then do :
     4082       v-GTIN = getGtinByDM(buf_marking.mark) .
     4083     end .
     4084     else do :
     4085       v-GTIN = getGtinByDM(v-mark) .
     4086     end .
     4087     v-gds-code = getGdsCodeByGtin(v-GTIN) .
     4088     v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     4089     if v-gds-code = ?
     4090     then do :
     4091       message ("Товар не найден. Отсканируйте другую марку.")
     4092       view-as alert-box .
     4093       return.
     4094     end .
     4095     find first buf2_goods no-lock where buf2_goods.gds-code = v-gds-code no-error .
     4096     if not available buf2_goods
     4097     then do :
     4098       message ("Товар не найден. Отсканируйте другую марку.")
     4099       view-as alert-box .
     4100       return.
     4101     end .
     4102     if buf_goods.gds-code <> buf2_goods.gds-code
     4103     then do :
     4104       message ("Марка принадлежит другому товару.")
     4105       view-as alert-box .
     4106       return.
     4107     end .
     4108     if v-GTIN-qnty = ?
     4109     or v-GTIN-qnty <= 0.0
     4110     then do :
     4111       message ("Не установлен коэффициент для упаковки.")
     4112       view-as alert-box .
     4113       return.
     4114     end .
     4115     if available buf_marking
     4116     then do :
     4117       if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     4118       then do :
     4119         if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4120         or buf_marking.sts = objSrv:Env:Marking:Sts:Mark:ReservedFromProduction:KeyIntDB
     4121         then do :
     4122           message (substitute("КМ в статусе <&1>, марка не может быть добавлена повторно", objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)))
     4123           view-as alert-box .
     4124         end .
     4125         else do :
     4126           message  substitute("КМ в статусе <&1>, марка не может быть использована в производство", objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts))
     4127           view-as alert-box .
     4128         end .
     4129         return.
     4130       end .
     4131     end .
     4132     else do :
     4133       message ("Марка не найдена в БД, товар не может быть добавлен в производство")
     4134       view-as alert-box .
     4135       return.
     4136     end .
     4137     v-isweighed = WghProdVariable(v-cntxt-obj-type, v-cntxt-obj-code, buf_goods.gds-code) .
     4138     if v-isweighed
     4139     then do :
     4140       v-mark-weight = MarkWeight(buf_marking.mark) .
     4141       if v-mark-weight = 0
     4142       or v-mark-weight = ?
     4143       then do :
     4144         message ("Марка не может быть добавлена, т.к. в БД отсутствует ее вес.")
     4145         view-as alert-box .
     4146         return.
     4147       end .
     4148     end .
     4149     find first tt-marking-lines where buf_marking.mark begins tt-marking-lines.mark no-error.
     4150     if available tt-marking-lines
     4151     then do :
     4152       message ("Марка добавлена в документ ранее.")
     4153       view-as alert-box .
     4154       return.
     4155     end .
     4156     if integer(v-GTIN-qnty) <> 1
     4157     then do :
     4158       message "Просканирована групповая упаковка, возврат в оборот групповых упаковок невозможен. Необходимо сканировать потребительские упаковки"
     4159       view-as alert-box .
     4160       return.
     4161     end .
     4162     find current buf_marking exclusive-lock no-error .
     4163     if locked buf_marking
     4164     then do :
     4165       message ("Марка не может быть добавлена, т.к. с ней работает другой пользователь")
     4166       view-as alert-box .
     4167       return.
     4168     end .
     4169     assign
     4170       buf_marking.sts = objSrv:Env:Marking:Sts:Mark:ReservedFromProduction:KeyIntDB
     4171     .
     4172     create tt-marking-lines .
     4173     assign
     4174       tt-marking-lines.mark = buf_marking.mark
     4175       tt-marking-lines.gds-code = buf_goods.gds-code
     4176       tt-marking-lines.gds-name = buf_goods.gds-name
     4177       tt-marking-lines.obj-type = v-cntxt-obj-type
     4178       tt-marking-lines.obj-code = v-cntxt-obj-code
     4179       tt-marking-lines.box-qnty = v-GTIN-qnty when not v-isweighed
     4180       tt-marking-lines.box-qnty = v-mark-weight when v-isweighed
     4181       tt-marking-lines.doc-level = 1
     4182     .
     4183     for first buf_marking-parent exclusive-lock where buf_marking-parent.mark = buf_marking.mark-parent
     4184                                                   and buf_marking.mark-parent > ""
     4185     :
     4186       assign buf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4187     end .
     4188     if v-isweighed
     4189     then do :
     4190       assign v-scan-qnty = v-scan-qnty + v-mark-weight .
     4191     end .
     4192     else do :
     4193       assign v-scan-qnty = v-scan-qnty + integer(v-GTIN-qnty) .
     4194     end .
     4195   end.
     4196   PROCEDURE disable_UI :
     4197     HIDE FRAME Dialog-Frame.
     4198   END PROCEDURE.
     4199   PROCEDURE dispmessage :
     4200   define input parameter p-str as character no-undo.
     4201     f-msg:fgcolor in frame Dialog-Frame = 12.
     4202     do:
     4203       display p-str @ f-msg with frame Dialog-Frame.
     4204     end.
     4205   END PROCEDURE.
     4206   PROCEDURE enable_UI :
     4207     DISPLAY v-mark f-msg
     4208         WITH FRAME Dialog-Frame.
     4209     ENABLE b-exit v-mark
     4210         WITH FRAME Dialog-Frame.
     4211     VIEW FRAME Dialog-Frame.
     4212   END PROCEDURE.
     4213   PROCEDURE LoadKeyboardLayoutA external "user32" :
     4214   define input  parameter P1 as char.
     4215     define input  parameter P2 as LONG.
     4216     define return parameter pret as LONG.
     4217   end procedure.
     4218   PROCEDURE proc-any-key :
     4219   if not v-manual
     4220       then
     4221       if v-scan-str = ""
     4222         then etime(yes).
     4223       else
     4224         if etime > 700
     4225           then v-scan-str = "".
     4226     v-scan-str = v-scan-str + last-event:label.
     4227   end.
     4228   PROCEDURE save_update :
     4229   define variable v-error      as logical   no-undo init no.
     4230     define variable l-error      as logical   no-undo init no.
     4231     define variable v-error-lang as logical   no-undo init no.
     4232     define variable ii           as integer   no-undo .
     4233     define variable chg-qnty     as integer   no-undo .
     4234     do trans:
     4235       f-msg:screen-value in frame Dialog-Frame = "" .
     4236       if v-mark:screen-value in frame Dialog-Frame = ""
     4237       then do:
     4238         v-mark:screen-value in frame Dialog-Frame = v-scan-str.
     4239         v-scan-str = "".
     4240       end.
     4241       assign
     4242         v-mark = v-mark:screen-value in frame Dialog-Frame.
     4243       if v-mark = ""
     4244         then return.
     4245       run CrCheckMark.
     4246       v-mark = "".
     4247       v-mark:screen-value in frame Dialog-Frame = "".
     4248       v-mark-short = "".
     4249       v-status-message = "Просканировано: " + string(v-scan-qnty) .
     4250       run dispmessage (v-status-message).
     4251     end.
     4252   end procedure.
