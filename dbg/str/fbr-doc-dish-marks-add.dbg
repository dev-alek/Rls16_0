      742   procedure xmlchar-test :
      743   define input parameter p-in-string          as character        no-undo.
      744   define output parameter p-out-string-enc    as character        no-undo.
      745   define output parameter p-out-string-dec    as character        no-undo.
      746   do
      747   on error undo, return error
      748   :
      749          run xmlchar-encode in this-procedure
      750       (
      751             input p-in-string
      752           , output p-out-string-enc
      753       ).
      754          run xmlchar-decode in this-procedure
      755       (
      756             input p-out-string-enc
      757           , output p-out-string-dec
      758       ).
      759   end.
      760   end .
      761   procedure xmlchar-encode :
      762   define input parameter p-in-string      as character        no-undo.
      763   define output parameter p-out-string    as character        no-undo.
      764       define variable v-position      as integer      no-undo.
      765       define variable v-current-char  as character    no-undo.
      766   do
      767   on error undo, return error
      768   :
      769       assign
      770           p-out-string = "":U
      771       .
      772       case p-in-string
      773       :
      774           when ?
      775           then do:
      776               assign
      777                   p-out-string = "?":U
      778               .
      779           end.
      780           when "?":U
      781           then do:
      782               assign
      783                   p-out-string = "&#63;":U
      784               .
      785           end.
      786           otherwise do:
      787               do v-position = 1 to length( p-in-string )
      788               :
      789                   assign
      790                       v-current-char = substring( p-in-string, v-position, 1 )
      791                   .
      792                   case v-current-char
      793                   :
      794                       when "&":U
      795                       then do:
      796                           assign
      797                               p-out-string = p-out-string + "&amp;":U
      798                           .
      799                       end.
      800                       when ">":U
      801                       then do:
      802                           assign
      803                               p-out-string = p-out-string + "&gt;":U
      804                           .
      805                       end.
      806                       when "<":U
      807                       then do:
      808                           assign
      809                               p-out-string = p-out-string + "&lt;":U
      810                           .
      811                       end.
      812                       when "'":U
      813                       then do:
      814                           assign
      815                               p-out-string = p-out-string + "&apos;":U
      816                           .
      817                       end.
      818                       when '"':U
      819                       then do:
      820                           assign
      821                               p-out-string = p-out-string + "&quot;":U
      822                           .
      823                       end.
      824                       when chr(1)
      825                       then do:
      826                           assign
      827                               p-out-string = p-out-string + "":U
      828                           .
      829                       end.
      830                       when chr(2)
      831                       then do:
      832                           assign
      833                               p-out-string = p-out-string + "":U
      834                           .
      835                       end.
      836                       when chr(3)
      837                       then do:
      838                           assign
      839                               p-out-string = p-out-string + "":U
      840                           .
      841                       end.
      842                       when chr(4)
      843                       then do:
      844                           assign
      845                               p-out-string = p-out-string + "":U
      846                           .
      847                       end.
      848                       when chr(5)
      849                       then do:
      850                           assign
      851                               p-out-string = p-out-string + "":U
      852                           .
      853                       end.
      854                       when chr(6)
      855                       then do:
      856                           assign
      857                               p-out-string = p-out-string + "":U
      858                           .
      859                       end.
      860                       when chr(7)
      861                       then do:
      862                           assign
      863                               p-out-string = p-out-string + "":U
      864                           .
      865                       end.
      866                       when chr(8)
      867                       then do:
      868                           assign
      869                               p-out-string = p-out-string + "":U
      870                           .
      871                       end.
      872                       when chr(9)
      873                       then do:
      874                           assign
      875                               p-out-string = p-out-string + "":U
      876                           .
      877                       end.
      878                       when chr(29)
      879                       then do:
      880                           assign
      881                               p-out-string = p-out-string + "":U
      882                           .
      883                       end.
      884                       when chr(10)
      885                       then do:
      886                           assign
      887                               p-out-string = p-out-string + "&#10;":U
      888                           .
      889                       end.
      890                       when chr(13)
      891                       then do:
      892                           assign
      893                               p-out-string = p-out-string + "&#13;":U
      894                           .
      895                       end.
      896                       otherwise do:
      897                           assign
      898                               p-out-string = p-out-string + v-current-char
      899                           .
      900                       end.
      901                   end case.
      902               end.
      903           end.
      904       end case.
      905   end.
      906   end .
