     1007                           assign
     1008                               p-out-string = p-out-string + v-current-char
     1009                           .
     1010                       end.
     1011                   end case.
     1012               end.
     1013           end.
     1014       end case.
     1015   end.
     1016   end .
     1017   procedure xmlchar-decode :
     1018   define input parameter p-in-string      as character        no-undo.
     1019   define output parameter p-out-string    as character        no-undo.
     1020       define variable v-position      as integer      no-undo.
     1021       define variable v-last-position as integer      no-undo.
     1022       define variable v-temp-integer  as integer      no-undo.
     1023       define variable v-current-char  as character    no-undo.
     1024       define variable v-next-char     as character    no-undo.
     1025       define variable v-success       as logical      no-undo.
     1026   do
     1027   on error undo, return error
     1028   :
     1029       assign
     1030           p-out-string = "":U
     1031           v-position   = 0
     1032       .
     1033       replace-cycle:
     1034       do while yes
     1035       on error undo, return error
     1036       :
     1037           assign
     1038               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1039           .
     1040           if v-last-position <= v-position
     1041           then do:
     1042               if v-position = 0
     1043               then do:
     1044                   assign
     1045                       p-out-string = p-in-string
     1046                   .
     1047               end.
     1048               else do:
     1049                   assign
     1050                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1051                   .
     1052               end.
     1053               leave replace-cycle.
     1054           end.
     1055           else do:
     1056               assign
     1057                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1058                   v-position      = v-last-position
     1059                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1060               .
     1061               if v-current-char = "#":U
     1062               then do:
     1063                   assign
     1064                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1065                   .
     1066                   if v-last-position > 0
     1067                   then do:
     1068                       run xmlchar-read-integer in this-procedure
     1069                        (
     1070                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1071                           , output v-temp-integer
     1072                           , output v-success
     1073                       ).
     1074                       if v-success = yes
     1075                       and v-temp-integer >= 1
     1076                       and v-temp-integer <= 255
     1077                       then do:
     1078                           assign
     1079                               p-out-string = p-out-string + chr( v-temp-integer )
     1080                               v-position   = v-last-position + 1
     1081                           .
     1082                       end.
     1083                       else do:
     1084                           assign
     1085                               p-out-string = p-out-string + "&":U
     1086                               v-position   = v-position   + 1
     1087                           .
     1088                       end.
     1089                   end.
     1090                   else do:
     1091                       assign
     1092                           p-out-string = p-out-string + "&":U
     1093                           v-position   = v-position   + 1
     1094                       .
     1095                   end.
     1096               end.
     1097               else do:
     1098                   case substring( p-in-string, v-position + 1, 3 )
     1099                   :
     1100                       when "lt;":U
     1101                       then do:
     1102                           assign
     1103                               p-out-string = p-out-string + "<":U
     1104                               v-position   = v-position   + 3
     1105                           .
     1106                       end.
     1107                       when "gt;":U
     1108                       then do:
     1109                           assign
     1110                               p-out-string = p-out-string + ">":U
     1111                               v-position   = v-position   + 3
     1112                           .
     1113                       end.
     1114                       otherwise do:
     1115                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1116                           then do:
     1117                               assign
     1118                                   p-out-string = p-out-string + "&":U
     1119                                   v-position   = v-position   + 4
     1120                               .
     1121                           end.
     1122                           else do:
     1123                               case substring( p-in-string, v-position + 1, 5 )
     1124                               :
     1125                                   when "quot;":U
     1126                                   then do:
     1127                                       assign
     1128                                           p-out-string = p-out-string + '"':U
     1129                                           v-position   = v-position   + 5
     1130                                       .
     1131                                   end.
     1132                                   when "apos;":U
     1133                                   then do:
     1134                                       assign
     1135                                           p-out-string = p-out-string + "'":U
     1136                                           v-position   = v-position   + 5
     1137                                       .
     1138                                   end.
     1139                                   otherwise do:
     1140                                       assign
     1141                                           p-out-string = p-out-string + "&":U
     1142                                       .
     1143                                   end.
     1144                               end case.
     1145                           end.
     1146                       end.
     1147                   end case.
     1148               end.
     1149           end.
     1150       end.
     1151   end.
     1152   end .
     1153   procedure xmlchar-read-integer :
     1154   define input parameter p-input-string      as character        no-undo.
     1155   define output parameter p-output-integer   as integer          no-undo.
     1156   define output parameter p-success       as logical          no-undo.
     1157   do
     1158   on error undo, return error
     1159   :
     1160       assign
     1161           p-output-integer = integer( p-input-string )
     1162       no-error.
     1163       if error-status :error
     1164       then do:
     1165           assign
     1166               p-success           = no
     1167               p-output-integer    = 0
     1168           .
     1169       end.
     1170       else do:
     1171           assign
     1172               p-success           = yes
     1173           .
     1174       end.
     1175   end.
     1176   end.
     1177   define variable mMRCCode  as logical    no-undo.
     1178   define variable mTypeMark as character  no-undo.
     1179   function IS-NeedMark returns logical
     1180   ( input ib-code as integer  ,
     1181     input ib-str as character ):
     1182      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1183      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1184                                    and buf_prod-bc-attr.b-str  eq ib-str
     1185                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1186        no-lock no-error.
     1187      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1188   end.
     1189   function repTegforDm return char
     1190   (iDM as char ):
     1191       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1192       define variable vteg as character no-undo.
     1193       define variable oDM as character no-undo.
     1194       define variable vi as integer no-undo.
     1195       oDM = iDm.
     1196       do vi = 1 to num-entries(vTeglist):
     1197          vTeg = entry(vi,vTeglist).
     1198          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1199       end.
     1200       return oDM.
     1201   end.
     1202   function repSpecSimbforDm return char
     1203   (iDM as char ):
     1204       define variable oDM as character no-undo.
     1205     run
     1206       xmlchar-decode(iDM, output oDM).
     1207     return repTegforDm (oDM).
     1208   end.
     1209   function CheckGtin return logical
     1210   (iGtin as char):
     1211      define variable bar_code as character no-undo.
     1212      define variable vGtin as logical no-undo init "yes".
     1213      if length(iGtin) eq 14
     1214      then do:
     1215         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1216         run str/chk-sum.p
     1217          (input-output bar_code ) no-error .
     1218         if iGtin ne  bar_code
     1219         then
     1220            vGtin = no.
     1221      end.
     1222      else
     1223         vGtin = no.
     1224      return vgtin.
     1225   end.
     1226   function repSpecSimbforXlm return char
     1227   (iDM as char ):
     1228       iDM = replace(iDM,chr(29),"").
     1229       return iDM.
     1230   end.
     1231   function getGtinByDM return char
     1232   (IDM as char):
     1233      define variable VTXT as char no-undo.
     1234      define variable vGtin as char no-undo.
     1235      vTXt = IdM.
     1236      vGtin = IDM.
     1237      if    length(vtxt) > 14
     1238      then do:
     1239         if   vtxt begins "(01)"
     1240                or vtxt begins "(02)"
     1241         then
     1242            vGtin = substring(vtxt,5,14).
     1243         else if   (vtxt begins "01"
     1244                or vtxt begins "02" )
     1245                and (   (    substring(iDm,17,2) eq "21"
     1246                         and length(vtxt) >= 21)
     1247                     or substring(iDm,17,2) eq "37"
     1248                     or substring(iDm,17,4) eq "(37)" )
     1249         then do:
     1250            vGtin = substring(vtxt,3,14).
     1251            if not checkGtin(vGtin)
     1252            then
     1253               vGtin = substring(vtxt,1,14).
     1254         end.
     1255         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1256             or length(vtxt) eq 14 + 7 + 4
     1257             or length(vtxt) eq 14 + 7
     1258         then
     1259            vGtin = substring(vtxt,1,14).
     1260      end.
     1261      if not checkGtin(vGtin)
     1262      then
     1263         vGtin = "".
     1264      return vgtin.
     1265   end.
     1266   function getGdsCodeByGtin return int
     1267   (iGtin as char):
     1268      define buffer prod-bc  for ub.prod-bc.
     1269      define buffer bar-code for ub.bar-code.
     1270      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1271      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1272      return if avail bar-code then bar-code.gds-code else ?.
     1273   end.
     1274   function getQntyCodeByGtin return decimal
     1275   (iGtin as char):
     1276      define buffer prod-bc  for ub.prod-bc.
     1277      define buffer bar-code for ub.bar-code.
     1278      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1279      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1280      return if avail bar-code then bar-code.cli-base-rate else ?.
     1281   end.
     1282   function getGdsCodeByDM return int
     1283   (iDm as char):
     1284      define variable vGtin as char no-undo.
     1285      define buffer prod-bc for ub.prod-bc.
     1286      vGtin  = getGtinByDM (IDM ).
     1287      return getGdsCodeByGtin (vGtin).
     1288   end.
     1289   function ChekTypeMarkByGds return logical
     1290   (iGds-code as integer ):
     1291      define buffer goods-attr for ub.goods-attr.
     1292      find first goods-attr where goods-attr.gds-code   = iGds-code
     1293                              and goods-attr.attr-code  = 'mark-type':U
     1294      no-lock no-error.
     1295      if available goods-attr
     1296      then do:
     1297         mTypeMark = goods-attr.attr-value.
     1298         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1299           .
     1300      end.
     1301      else
     1302         return no.
     1303   end.
     1304   function ChekTypeMarkByDm return logical
     1305   (iDM as char ):
     1306      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1307   end.
     1308   function ChekTypeMarkByGtin return logical
     1309   (iGtin as char ):
     1310      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1311   end.
     1312   function GetNextElement return character
     1313     (input iAllTeg        as logical
     1314     ,output oteg          as character
     1315     ,output otegval       as character
     1316     ,input-output pstr    as character
     1317      ):
     1318        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1319        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1320        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1321        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1322        define variable vTeg as character no-undo.
     1323        define variable vLength as integer no-undo.
     1324        define variable vi as integer no-undo.
     1325        define variable vj as integer no-undo.
     1326        define buffer code for ub.code.
     1327        find first code where Code.parent eq "MarkType"
     1328                          and Code.CodeValue   eq mTypeMark
     1329                          no-lock no-error.
     1330        if     available code
     1331           and Code.misc1 ne ""
     1332           and Code.misc1 ne ?
     1333        then do:
     1334           integer (Code.misc1) no-error.
     1335           if not error-status:error
     1336           then
     1337             entry (4,vlistleng) = Code.misc1.
     1338        end.
     1339        if iAllTeg
     1340        then
     1341           assign
     1342              vlistElem     = vlistElem    + vlistElemDop
     1343              vlistleng     = vlistleng    + vlistlengDop
     1344           .
     1345        else if mMRCCode
     1346        then
     1347           assign
     1348              vlistElem     = vlistElem    + ",(8005),8005"
     1349              vlistleng     = vlistleng    + ",000006,0006"
     1350           .
     1351       block-elem:
     1352       do vi = 1 to num-entries(vlistElem):
     1353          vTeg = entry(vi,vlistElem).
     1354          if pstr begins vTeg
     1355          then do:
     1356             if    vTeg eq "21"
     1357             then
     1358                vLength = index(pstr,chr(29)) - 2 no-error.
     1359             if vLength  <= 0
     1360             then
     1361                vLength = int(entry(vi,vlistleng)).
     1362             otegval = substring (pstr,length(vteg) + 1, vLength).
     1363             oteg = replace(replace(vteg,")",""),"(","").
     1364             vTeg = vteg + otegval.
     1365             otegval = replace(otegval,chr(29),"").
     1366             oteg = replace(replace(oteg,")",""),"(","").
     1367             pstr = substring (pstr,length(vTeg)+ 1).
     1368             vTeg = replace(vTeg,chr(29),"").
     1369             leave block-elem.
     1370          end.
     1371          else
     1372             vTeg = "".
     1373       end.
     1374       return vteg.
     1375   end.
     1376   function GetCodeIdent return character
     1377   (iDm as char):
     1378      define variable Velement   as character no-undo init "first".
     1379      define variable oCodeIdent as character no-undo.
     1380      define variable vteg as character no-undo.
     1381      define variable vtegval as character no-undo.
     1382      define variable vGtin as character no-undo.
     1383      define buffer marking for ub.marking.
     1384      for first marking no-lock where
     1385                marking.mark eq iDm
     1386            and marking.unit-ext = "LEVEL2"
     1387      :
     1388        return iDm.
     1389      end.
     1390      vGtin  = getGtinByDM (iDm ).
     1391      ChekTypeMarkByDm(idm).
     1392      if iDm begins 'tech_':U
     1393      then
     1394         oCodeIdent = iDm.
     1395      else if length(iDm) < 21
     1396      then do:
     1397         find first marking where marking.mark eq idm
     1398         no-lock no-error.
     1399         oCodeIdent = if available marking then marking.mark else  ?.
     1400      end.
     1401      else if     length(iDm) eq 29
     1402         and not iDm begins "01"
     1403         and not iDm begins "02"
     1404      then
     1405         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1406      else  if     length(iDm) >= 24
     1407               and (  iDm begins "01"
     1408                   or iDm begins "02")
     1409               and  substring(iDm,17,2) ne "21"
     1410      then do:
     1411         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1412                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1413         then
     1414            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1415         else
     1416            oCodeIdent = iDM.
     1417      end.
     1418      else  if     (   length(iDm) eq 25
     1419                    or length(iDm) eq 21)
     1420               and (not iDm begins "01"
     1421               and  not iDm begins "02")
     1422      then
     1423         oCodeIdent = substring(iDm,1,21).
     1424      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1425      then
     1426         oCodeIdent = substring(iDm,1,21).
     1427      else do while Velement ne "" and idm ne "":
     1428         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1429         oCodeIdent = oCodeIdent + Velement.
     1430      end.
     1431      return oCodeIdent.
     1432   end.
     1433   function GetTegCod return character
     1434   (icodeIdent as char, iTeg as char):
     1435      define variable Velement   as character no-undo init "first".
     1436      define variable oTeg as character no-undo init ?.
     1437      define variable vteg as character no-undo.
     1438      define variable vtegval as character no-undo.
     1439      if     ((length(icodeIdent) eq 21
     1440         and not icodeIdent begins "01"
     1441         and not icodeIdent begins "02")
     1442         or
     1443             ( length(icodeIdent) eq 25
     1444               and not icodeIdent begins "01"
     1445               and not icodeIdent begins "02"))
     1446      then do:
     1447         if iTeg eq "01" or iTeg eq "02"
     1448         then
     1449            oTeg = substring(icodeIdent,1,21).
     1450         else  if  iTeg eq "21"
     1451         then
     1452            oTeg = substring(icodeIdent,15,7).
     1453      end.
     1454      else do:
     1455         ChekTypeMarkByDm(icodeIdent).
     1456         block-teg:
     1457            do while Velement ne "" and icodeIdent ne "":
     1458            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1459            if    Velement begins iTeg
     1460               or Velement begins "(" + iTeg + ")"
     1461            then do:
     1462               oTeg = vtegval.
     1463               leave block-teg.
     1464            end.
     1465         end.
     1466      end.
     1467      return oTeg.
     1468   end.
     1469   function isOAD return logical
     1470   (icodeIdent as character):
     1471      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1472   end.
     1473   function isMark return logical
     1474   (icodeIdent as character):
     1475      define buffer buf_marking for ub.marking.
     1476      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1477             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1478   end.
     1479   function addBracketForCode return character
     1480   (icodeIdent as char):
     1481      define variable Velement   as character no-undo init "first".
     1482      define variable oTeg as character no-undo.
     1483      define variable vteg as character no-undo.
     1484      define variable vtegval as character no-undo.
     1485      define buffer marking for ub.marking.
     1486      find first marking no-lock where
     1487                 marking.mark begins icodeIdent no-error.
     1488      if    not ChekTypeMarkByDm(icodeIdent)
     1489         or length(icodeIdent) le 24
     1490         or (avail marking and marking.unit-ext = "LEVEL2")
     1491      then
     1492         oTeg = icodeIdent.
     1493      else do:
     1494         if (  icodeIdent begins "01"
     1495            or icodeIdent begins "02"
     1496            ) and CheckGtin(substring (icodeIdent,3,14))
     1497            and substring (icodeIdent,17,2) eq "21"
     1498         then do:
     1499            mMRCCode = yes.
     1500            ChekTypeMarkByDm(icodeIdent).
     1501            block-teg:
     1502            do while Velement ne "" and icodeIdent ne "":
     1503               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1504               if vteg ne ""
     1505               then
     1506                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1507            end.
     1508            mMRCCode = no.
     1509         end.
     1510         else do:
     1511            oTeg = icodeIdent.
     1512         end.
     1513      end.
     1514      return oTeg.
     1515   end.
     1516   function getlevelByCodId return int
     1517   (iCode as char):
     1518      define variable vLength as int no-undo.
     1519      define variable vLevel  as int no-undo.
     1520      if not ChekTypeMarkByDM (icode) then return ?.
     1521      vLength = length(iCode).
     1522      if    vLength eq 18
     1523         or vLength eq 20
     1524      then
     1525         Vlevel = 4.
     1526      else if vLength eq 21
     1527      then
     1528         Vlevel = 1.
     1529      else if vLength eq 25
     1530      then do:
     1531         if  iCode begins "01"
     1532         then
     1533            Vlevel = 3.
     1534         else
     1535            Vlevel = 1.
     1536      end.
     1537      else if     vLength >= 26
     1538              and vLength <= 46
     1539      then do:
     1540         if    substring(iCode,17,2) eq "11"
     1541            or substring(iCode,17,2) eq "13"
     1542            or (    substring(iCode,17,2) eq "21"
     1543                and vLength >= 33
     1544                and substring(iCode,26,4) ne "8005")
     1545         then
     1546            Vlevel = 4.
     1547         else if    vLength eq 31
     1548                 or vLength eq 38
     1549                 or vLength eq 39
     1550                 or vLength eq 45
     1551         then
     1552            Vlevel = 1.
     1553         else if    vLength eq 35
     1554                 or vLength eq 43
     1555         then
     1556            Vlevel = 3.
     1557         else
     1558            Vlevel = ?.
     1559      end.
     1560      else
     1561         Vlevel = ?.
     1562      return Vlevel.
     1563   end.
     1564   function getLevelMotpBycodid return character
     1565   (iDm as char):
     1566      define variable vLevel as integer no-undo.
     1567      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1568      vLevel = getlevelByCodId(iDm).
     1569      if    vLevel eq ?
     1570         or vLevel < 1
     1571         or vLevel > 6
     1572      then
     1573         return ?.
     1574      else
     1575         return entry(vlevel,vList).
     1576   end.
     1577   function getLevelUTDByLevelMotp return character
     1578   (iUnit as char):
     1579      define variable vLevel as integer no-undo.
     1580      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1581      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1582      vLevel = lookup(iUnit,vListMOTP).
     1583      if    vLevel eq ?
     1584         or vLevel < 1
     1585         or vLevel > 4
     1586      then
     1587         return ?.
     1588      else
     1589         return entry(vlevel,vListutd).
     1590   end.
     1591   function getLevelMotpByDM return character
     1592   (iDm as char):
     1593      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1594   end.
     1595   function getLevelUTDByCodId return character
     1596   (iDm as char):
     1597      define variable vLevel as integer no-undo.
     1598      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1599      vLevel = getlevelByCodId(iDm).
     1600      if    vLevel eq ?
     1601         or vLevel < 1
     1602         or vLevel > 4
     1603      then
     1604         return ?.
     1605      else
     1606         return entry(vlevel,vList).
     1607   end.
     1608   function getLevelUTDByDM return character
     1609   (iDm as char):
     1610      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1611   end.
     1612   define variable mNotMarkQnty as logical no-undo.
     1613   function getQntyUTDByCodId return decimal
     1614   (iDM as char):
     1615      define variable vLevel as integer no-undo.
     1616      define variable vList as character no-undo init "1,5,10,500".
     1617      define variable vGtin as character no-undo.
     1618      define variable vqnty as decimal no-undo init ?.
     1619      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1620      if vqnty eq ?
     1621      then do:
     1622         if not mNotMarkQnty
     1623         then do:
     1624            define buffer marking for ub.marking.
     1625            define variable vCodident as character no-undo.
     1626            vCodident = GetCodeIdent(idm).
     1627            find first marking where marking.mark begins vCodident no-lock no-error.
     1628            if     available marking
     1629               and marking.box-qnty ne ?
     1630            then
     1631               return marking.box-qnty.
     1632         end.
     1633         vGtin = getGtinByDm(iDM).
     1634         if ChekTypeMarkByGtin (vGtin)
     1635         then do:
     1636            vLevel = getlevelByCodId(iDM).
     1637            if     vLevel >= 1
     1638               and vLevel <= 4
     1639            then
     1640               vqnty = int(entry(vlevel,vList)).
     1641         end.
     1642         else
     1643            vqnty = getQntyCodeByGtin(vgtin).
     1644      end.
     1645      return vqnty.
     1646   end.
     1647   function getQntyUTDByDM return decimal
     1648   (iDm as char):
     1649      define variable vDM as character no-undo.
     1650      if     length (iDm) ne 25
     1651         and length (iDm) ne 29
     1652         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1653      then
     1654         vDM = substring (iDm,1,length (iDm) - 6 ).
     1655      else
     1656         vDM = substring (iDm,1,length (iDm) - 4 ).
     1657      return getQntyUTDByCodId(vDM).
     1658   end.
     1659   function getMRC4 return decimal
     1660   (iMRC as char):
     1661      define variable oMrc     as decimal no-undo init ?.
     1662      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1663      define variable vi       as integer no-undo.
     1664      define variable vfound   as integer no-undo.
     1665      define variable vposStart   as integer no-undo.
     1666      do:
     1667      OMRc = 0.
     1668      do vi = 1 to 4:
     1669         define variable vsimb as character no-undo.
     1670         vsimb = substring(iMRC,vi,1).
     1671         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1672         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1673         if vfound > 0
     1674         then
     1675            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1676         end.
     1677         OMRc = OMRc / 100.
     1678      end.
     1679      return OMRc.
     1680   end.
     1681   function getMRCByDM return decimal
     1682   (iDm as char):
     1683      define variable vMRC     as character no-undo.
     1684      define variable oMrc     as decimal no-undo init ?.
     1685      define variable Velement as character no-undo init "empty".
     1686      define variable vteg as character no-undo.
     1687      define variable vtegval as character no-undo.
     1688      if    length(idm) eq 14 + 7 + 4 + 4
     1689         or length(idm) eq 14 + 7 + 4
     1690      then do:
     1691         vMRC = substring(idm,22,4).
     1692         omrc = getMRC4(vMRC).
     1693      end.
     1694      else do:
     1695          ChekTypeMarkByDm(iDm).
     1696          block-mrc:
     1697          do while Velement ne "" and idm ne "":
     1698             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1699             if Velement begins "8005"
     1700             then do:
     1701                vMRC = substring(Velement,5,6).
     1702                leave block-mrc.
     1703             end.
     1704             else if Velement begins "(8005)"
     1705             then do:
     1706                vMRC = substring(Velement,7,6).
     1707                leave block-mrc.
     1708             end.
     1709          end.
     1710          if vMRC ne ""
     1711          then
     1712             OMRc = dec(vmrc) / 100 no-error.
     1713      end.
     1714      return OMRc.
     1715   end.
     1716   function MoveDate return Date
     1717   (idate as date,
     1718    iMonth as int64):
     1719      define variable vMonth   as int64 no-undo.
     1720      define variable vYear    as int64 no-undo.
     1721      define variable vDateNew as date  no-undo.
     1722       define variable vDay     as int64 no-undo.
     1723       vMonth = month(iDate) + iMonth.
     1724       vYear =  year(iDate).
     1725       if vMonth <= 0
     1726       then assign
     1727          vMonth = vMonth + 12
     1728           vYear  = vYear - 1
     1729       .
     1730       else if vMonth > 12
     1731       then assign
     1732          vMonth = vMonth - 12
     1733           vYear  = vYear + 1
     1734       .
     1735       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1736       do while error-status:error eq yes:
     1737          VDay = vDay + 1.
     1738          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1739       end.
     1740       if VDay > 0
     1741       then
     1742          vDateNew + 1.
     1743       return vDateNew.
     1744   end.
     1745   procedure checkEMRC:
     1746   define input  parameter iDm as character no-undo.
     1747   define output parameter vok as logical   no-undo init yes.
     1748      define variable v-value-emrc as character no-undo.
     1749      define variable v-type-emrc  as character no-undo.
     1750      define variable vDateIso     as character no-undo.
     1751      define variable vMRC         as decimal no-undo.
     1752      define variable vqnty        as decimal no-undo.
     1753      define variable vPrice       as decimal no-undo.
     1754      define variable vparent      as character no-undo.
     1755      define variable vgds-code    as integer no-undo.
     1756      define buffer code for ub.code.
     1757      vMRC = getMRCByDM(iDm).
     1758      if vMRC > 0
     1759      then do:
     1760         vgds-code = getGdsCodeByDM(iDm).
     1761         vqnty     = getQntyUTDByDM(iDm).
     1762               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1763            (
     1764             input   vgds-code
     1765            ,input   'emrc-type':U
     1766            ,output   v-value-emrc
     1767            ,output   v-type-emrc
     1768          ) no-error.
     1769          if     v-value-emrc ne ""
     1770             and v-value-emrc ne ?
     1771          then do:
     1772             vDateIso = iso-date(today).
     1773             vPrice = vMRC / vqnty.
     1774             vparent ="emc" + chr(4) + v-value-emrc.
     1775             find last code where Code.parent      eq vparent
     1776                              and Code.code        le vDateIso
     1777                              and code.status_  eq 0
     1778             no-lock no-error.
     1779             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1780             then
     1781                vOk = true .
     1782             else do:
     1783                 define variable vText      as character no-undo.
     1784                 define variable vDate      as date no-undo.
     1785                 define variable vDateLast  as character no-undo.
     1786                 define variable vDateFirst as character no-undo.
     1787                 define variable vDate3     as date no-undo.
     1788                 vdate = date(code.misc1).
     1789                 vDateLast = code.misc1.
     1790                 vDate3 = MoveDate(today, - 3 ).
     1791                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1792                                      string(vDate3  , "99/99/9999"),
     1793                                      string(vDate   , "99/99/9999")
     1794                                      ).
     1795                 vdateIso = iso-date(vdate3).
     1796                 find last code  where Code.parent      eq vparent
     1797                                   and Code.code        le vDateIso
     1798                                   and code.status_  eq 0 no-lock no-error.
     1799                 if available code
     1800                 then
     1801                    vDateIso = code.code.
     1802                 vDateFirst = vDateIso.
     1803                 vDateLast = iso-date(vdate).
     1804                 define variable vGood as logical no-undo.
     1805                 define variable vDateSale as date no-undo.
     1806                 define buffer bcode for code.
     1807                 for last code where Code.parent   eq vparent
     1808                                 and code.status_  eq 0
     1809                                 and code.code     < vDateLast
     1810                                 and code.code     >= vDateFirst
     1811                 no-lock:
     1812                    find first bcode where bCode.parent   eq vparent
     1813                                       and bcode.status_  eq 0
     1814                                       and bcode.code     > code.code no-lock no-error.
     1815                    if available bcode
     1816                    then do:
     1817                       if vPrice < dec(Code.CodeValue)
     1818                       then
     1819                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1820                                                     chr(10),
     1821                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1822                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1823                                                     ).
     1824                       else do:
     1825                          vGood = yes.
     1826                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1827                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1828                                                     chr(10),
     1829                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1830                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1831                                                     string(         vDateSale            ,"99/99/9999"),
     1832                                                     string(vDateSale - today)
     1833                                                     ).
     1834                       end.
     1835                    end.
     1836                 end.
     1837                 if vgood
     1838                 then do:
     1839                    define variable choice as integer no-undo .
     1840                    run gbl/d-askw.w (input "Уточнение"
     1841                           ,input  vText
     1842                           ,input "|"
     1843                           ,input "Принять|Вернуть"
     1844                           ,input "Принять данный товар|Вернуть товар постащику"
     1845                           ,input 1
     1846                           ,input 2
     1847                           ,output choice) no-error.
     1848                    vok = choice eq 1.
     1849                 end.
     1850                 else
     1851                    vok =false.
     1852             end.
     1853          end.
     1854      end.
     1855   end.
     1856   function addGs2Mark return character
     1857   (iMark as char):
     1858      define variable vDM   as character no-undo.
     1859      define variable vIdx  as integer   no-undo.
     1860      if index(iMark,chr(29),1) > 0
     1861      then return iMark.
     1862      if substring(iMark,26,4) = "8005" then
     1863      do:
     1864        vIdx = index(iMark,"93",26 + 4 + 5).
     1865        if vIdx > 1 then do:
     1866          vDM = substitute("&1&4&2&4&3",
     1867                           substring(iMark,1,25),
     1868                           substring(iMark,26,vIdx - 25 - 1),
     1869                           substring(iMark,vIdx),
     1870                           chr(29)) no-error.
     1871          vIdx = index(vDm,"240",vIdx + 4).
     1872          if vIdx > 0 then
     1873          do:
     1874            vDM = substitute("&1&3&2",
     1875                             substring(vDm,1,vIdx - 1),
     1876                             substring(vDm,vIdx),
     1877                             chr(29)) no-error.
     1878          end.
     1879        end.
     1880        else
     1881          vDM = substitute("&1&3&2",
     1882                           substring(iMark,1,25),
     1883                           substring(iMark,26),
     1884                           chr(29)) no-error.
     1885      end.
     1886      else if substring(iMark,32,2) = "91" then
     1887      do:
     1888        vIdx = index(iMark,"92",32).
     1889        if vIdx > 1 then
     1890          vDM = substitute("&1&4&2&4&3",
     1891                           substring(iMark,1,31),
     1892                           substring(iMark,32,vIdx - 31 - 1),
     1893                           substring(iMark,vIdx),
     1894                           chr(29)) no-error.
     1895        else
     1896          vDM = substitute("&1&3&2",
     1897                           substring(iMark,1,31),
     1898                           substring(iMark,32),
     1899                           chr(29)) no-error.
     1900      end.
     1901      else if substring(iMark,39,2) = "91" then
     1902      do:
     1903        vIdx = index(iMark,"92",38).
     1904        if vIdx > 1 then
     1905          vDM = substitute("&1&4&2&4&3",
     1906                           substring(iMark,1,38),
     1907                           substring(iMark,39,vIdx - 38 - 1),
     1908                           substring(iMark,vIdx),
     1909                           chr(29)) no-error.
     1910        else
     1911          vDM = substitute("&1&3&2",
     1912                           substring(iMark,1,38),
     1913                           substring(iMark,39),
     1914                           chr(29)) no-error.
     1915      end.
     1916      else if substring(iMark,25,2) = "93" then
     1917      do:
     1918        vIdx = index(iMark,"92",25).
     1919        if vIdx > 1 then
     1920          vDM = substitute("&1&4&2&4&3",
     1921                           substring(iMark,1,24),
     1922                           substring(iMark,25,vIdx - 24 - 1),
     1923                           substring(iMark,vIdx),
     1924                           chr(29)) no-error.
     1925        else
     1926          vIdx = index(iMark,"3103",25).
     1927          if vIdx > 0 then
     1928          vDM = substitute("&1&4&2&4&3",
     1929                           substring(iMark,1,24),
     1930                           substring(iMark,25,vIdx - 24 - 1),
     1931                           substring(iMark,vIdx),
     1932                           chr(29)) no-error.
     1933          else
     1934            vDM = substitute("&1&3&2",
     1935                             substring(iMark,1,24),
     1936                             substring(iMark,25),
     1937                             chr(29)) no-error.
     1938      end.
     1939      else if substring(iMark,32,2) = "93" then
     1940      do:
     1941        vDM = substitute("&1&3&2",
     1942              substring(iMark,1,31),
     1943              substring(iMark,32),
     1944              chr(29)) no-error.
     1945      end.
     1946      return if vDM <> "" then vDm else iMark.
     1947   end.
     1948   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1949   define variable v-waitfram-action01         as character   no-undo .
     1950   define variable v-waitfram-action02         as character   no-undo .
     1951   define variable v-waitfram-action03         as character   no-undo .
     1952   define variable mWaitFramTextBeg            as character   no-undo.
     1953   define variable mWaitFramTextEnd            as character   no-undo.
     1954   define variable mWaitFramView               as logical     no-undo.
     1955   define variable mWaitProcEvent              as logical     no-undo init yes.
     1956   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1957   define variable mWaitFramStop               as logical     no-undo.
     1958   define variable mWaitFramStopUser           as logical     no-undo.
     1959   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1960   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1961   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1962   define button B-WaitFramStop auto-end-key
     1963        label "Стоп"
     1964        size 10 by 1 tooltip "Остоновить процесс".
     1965   define button B-viewProcInfo
     1966        label "Информация"
     1967        size 15 by 1 tooltip "Информация о процесс".
     1968   define frame waitfram
     1969     v-waitfram-action01 format "x(72)" no-label skip
     1970     v-waitfram-action02 format "x(72)" no-label skip
     1971     v-waitfram-action03 format "x(72)" no-label skip
     1972     B-viewProcInfo
     1973     B-WaitFramStop at row 4 col 30
     1974     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1975     .
     1976   define new global shared variable mBatchMode as logical no-undo init ?.
     1977   define variable mFramBachModHandle as handle no-undo.
     1978   mFramBachModHandle = frame waitfram:handle.
     1979   define variable mFameOldVis as logical no-undo.
     1980   define variable mVisCUrentVin as logical no-undo.
     1981   if session:batch-mode
     1982   then
     1983      mBatchMode = yes.
     1984   if mBatchMode = ? then do:
     1985     mVisCUrentVin = current-window:visible.
     1986     mFameOldVis = mFramBachModHandle:visible.
     1987     mFramBachModHandle:visible  = yes.
     1988     mBatchMode = mFramBachModHandle:visible ne yes.
     1989     mFramBachModHandle:visible = mFameOldVis.
     1990     current-window:visible = mVisCUrentVin.
     1991   end.
     1992    if  log-manager:logfile-name ne ?
     1993     then DO:
     1994         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1995         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1996         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1997     end.
     1998   on choose of B-WaitFramStop in frame waitfram
     1999   do:
     2000     mWaitFramStop = yes.
     2001     mWaitFramStopUser = yes.
     2002   end.
     2003   function waitfram-check-timeout returns logical():
     2004      define variable vtime as int64 no-undo.
     2005      if mWaitFramStopTimeOut
     2006      then
     2007         return yes.
     2008      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2009      if     mWaitFramTimeOut ne ?
     2010         and mWaitFramTimeOut ne 0
     2011         and mWaitFramTimeOut lt vtime
     2012      then do:
     2013         mWaitFramStopTimeOut = yes.
     2014      end.
     2015      return mWaitFramStopTimeOut.
     2016   end.
     2017   procedure waitfram-hide :
     2018     if not session:batch-mode
     2019     then do
     2020     on error undo, return error return-value
     2021     :
     2022       pause 0 before-hide .
     2023       if not mBatchMode then
     2024         hide frame waitfram .
     2025     end.
     2026   end procedure.
     2027   procedure waitfram-show :
     2028     define input  parameter p-message as character no-undo .
     2029     define variable v-left-margin as integer   no-undo .
     2030     if not session:batch-mode
     2031     then do
     2032     on error undo, return error return-value
     2033     :
     2034       if length(p-message) <= 70 then do:
     2035         assign
     2036           v-left-margin = integer((70 - length(p-message)) / 2)
     2037         .
     2038         assign
     2039           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2040         .
     2041         assign
     2042           v-waitfram-action01 = " "
     2043           v-waitfram-action02 = " "
     2044                                    + fill(" ", v-left-margin)
     2045                                    + p-message
     2046           v-waitfram-action03 = " "
     2047         .
     2048       end.
     2049       else do:
     2050         define variable vRindex1 as integer no-undo.
     2051         define variable vRindex2 as integer no-undo.
     2052         vRindex1 = r-index(p-message," ",70).
     2053         if vRindex1 = 0
     2054         then
     2055            vRindex1 = 70.
     2056         if length(p-message)  <= vRindex1 + 70 then do:
     2057           assign
     2058             v-waitfram-action01 = " "
     2059             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2060             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2061           .
     2062         end.
     2063         else do:
     2064           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2065           if vRindex2 <= vRindex1
     2066           then
     2067              vRindex2 = vRindex1 + 70.
     2068           assign
     2069             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2070             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2071             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2072           .
     2073         end.
     2074       end.
     2075       B-viewProcInfo:visible   in frame waitfram = no.
     2076       B-viewProcInfo:sensitive in frame waitfram = no.
     2077       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2078       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2079       if  (   mWaitFramView
     2080          or  mWaitProcEvent)
     2081          and not mBatchMode
     2082       then
     2083          display
     2084             v-waitfram-action01 skip
     2085             v-waitfram-action02 skip
     2086             v-waitfram-action03 skip
     2087          with frame waitfram .
     2088     end.
     2089   end procedure.
     2090      procedure waitfram-show-this:
     2091         define input  parameter iInterval as int64 no-undo.
     2092         define variable vtime as int64 no-undo.
     2093         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2094         mWaitFramInterval = iInterval.
     2095         run waitfram-show (substitute("&1&2 &3&4" ,
     2096                                       mWaitFramTextBeg ,
     2097                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2098                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2099                                       mWaitFramTextEnd
     2100                                      )
     2101                           ).
     2102      end.
     2103      procedure WaitFramRunPause:
     2104         define input  parameter iInterval as dec no-undo.
     2105         define variable vStart  as datetime-tz no-undo.
     2106         define variable vend    as datetime-tz no-undo.
     2107         define variable vint as int64 no-undo.
     2108         define variable vOk as logical no-undo.
     2109         vStart = now.
     2110         vend   = vStart.
     2111         publish "WaitFramPause" (iInterval,output vOk).
     2112         vend   =  now.
     2113         vint = vend - vStart.
     2114         vint = iInterval - vint / 1000.
     2115         if     not mWaitFramStop
     2116            and (   vint > 0
     2117                 or (    not vOk
     2118                     and iInterval eq ?
     2119                     )
     2120                 )
     2121         then
     2122            run waitfram-show-this (iInterval).
     2123         vend   =  now.
     2124         vint = vend - vStart.
     2125         vint = iInterval - vint / 1000.
     2126         if     not mWaitFramStop
     2127            and vint > 0
     2128         then do:
     2129            run gbl/pause.p (vint * 1000).
     2130         end.
     2131         if iInterval ne ?
     2132         then
     2133            publish "WaitFramStop".
     2134         waitfram-check-timeout().
     2135      end.
     2136      procedure WaitFramWaitFor:
     2137         define input  parameter iInterval as dec no-undo.
     2138         assign
     2139            mWaitFramStartProc   = now
     2140            mWaitFramStopUser    = no
     2141            mWaitFramStopTimeOut = no
     2142         .
     2143         block-wait:
     2144         do while not mWaitFramStop:
     2145            run WaitFramRunPause (iInterval).
     2146            if  waitfram-check-timeout()
     2147            then do:
     2148               leave block-wait.
     2149            end.
     2150         end.
     2151         run waitfram-hide.
     2152      end.
     2153   procedure waitfram-join :
     2154     define input  parameter p-line-1  as character no-undo .
     2155     define input  parameter p-line-2  as character no-undo .
     2156     define input  parameter p-line-3  as character no-undo .
     2157     define output parameter p-message as character no-undo .
     2158     do
     2159     on error undo, return error return-value
     2160     :
     2161       assign
     2162         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2163                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2164                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2165       .
     2166     end.
     2167   end procedure.
     2168   function waitfram-join-function returns character
     2169     (input p-line-1 as character
     2170     ,input p-line-2 as character
     2171     ,input p-line-3 as character
     2172     ).
     2173     define variable v-message as character no-undo .
     2174     run waitfram-join in this-procedure
     2175       (input  p-line-1
     2176       ,input  p-line-2
     2177       ,input  p-line-3
     2178       ,output v-message
     2179       ) .
     2180     return v-message .
     2181   end function .
     2182   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2183     define variable v-cntxt-db-num        as integer   no-undo .
     2184     define variable v-cntxt-userid        as character no-undo .
     2185     define variable v-cntxt-level         as character no-undo .
     2186     define variable v-cntxt-host-code-obj as integer   no-undo .
     2187     define variable v-cntxt-obj-type      as character no-undo .
     2188     define variable v-cntxt-obj-code      as integer   no-undo .
     2189     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2190     define variable v-cntxt-is-admin      as logical   no-undo .
     2191   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2192   function getattrUtdex returns char
     2193   (idb-num   as integer,
     2194    idoc-id   as integer,
     2195    iattrcode as character,
     2196    iExValue  as character  ):
     2197      define buffer utd-attr for utd-attr.
     2198      find first utd-attr where utd-attr.db-num eq idb-num
     2199                            and utd-attr.doc-id eq idoc-id
     2200                            and utd-attr.attr-code eq iattrcode
     2201      no-lock no-error.
     2202      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2203   end.
     2204   function getattrUtd returns char
     2205   (idb-num   as integer,
     2206    idoc-id   as integer,
     2207    iattrcode as character ):
     2208     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2209   end.
     2210   function setattrUtd returns logical
     2211   (idb-num   as integer,
     2212    idoc-id   as integer,
     2213    iattrcode as character,
     2214    iattrval  as character ):
     2215      define buffer utd-attr for utd-attr.
     2216      find first utd-attr where utd-attr.db-num eq idb-num
     2217                            and utd-attr.doc-id eq idoc-id
     2218                            and utd-attr.attr-code eq iattrcode
     2219      no-lock no-error.
     2220      if not available utd-attr
     2221      then do:
     2222         create utd-attr.
     2223         assign
     2224            utd-attr.db-num    = idb-num
     2225            utd-attr.doc-id    = idoc-id
     2226            utd-attr.attr-code = iattrcode
     2227            utd-attr.attr-value = iattrval
     2228         .
     2229      end.
     2230      else do:
     2231         if utd-attr.attr-value ne iattrval
     2232         then do:
     2233            find current utd-attr exclusive-lock no-error.
     2234            if available utd-attr
     2235            then
     2236               utd-attr.attr-value = iattrval.
     2237         end.
     2238      end.
     2239      release utd-attr.
     2240   end.
     2241   function GetAttrUtdlinesEx returns char
     2242   (idb-num   as integer,
     2243    idoc-id   as integer,
     2244    ilinenum  as integer,
     2245    iattrcode as character,
     2246    iExValue  as character  ):
     2247      define buffer utd-lines-attr for utd-lines-attr.
     2248      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2249                                  and utd-lines-attr.doc-id    eq idoc-id
     2250                                  and utd-lines-attr.lineNum   eq ilineNum
     2251                                  and utd-lines-attr.attr-code eq iattrcode
     2252      no-lock no-error.
     2253      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2254   end.
     2255   function GetAttrUtdlines returns char
     2256   (idb-num   as integer,
     2257    idoc-id   as integer,
     2258    ilinenum  as integer,
     2259    iattrcode as character ):
     2260      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2261   end.
     2262   function setattrUtdlines returns logical
     2263   (idb-num   as integer,
     2264    idoc-id   as integer,
     2265    ilinenum  as integer,
     2266    iattrcode as character,
     2267    iattrval  as character ):
     2268      define buffer utd-lines-attr for utd-lines-attr.
     2269      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2270                                  and utd-lines-attr.doc-id    eq idoc-id
     2271                                  and utd-lines-attr.lineNum   eq ilineNum
     2272                                  and utd-lines-attr.attr-code eq iattrcode
     2273      no-lock no-error.
     2274      if not available utd-lines-attr
     2275      then do:
     2276         if iattrval ne ?
     2277            and iattrval ne ""
     2278         then do:
     2279            create utd-lines-attr.
     2280            assign
     2281               utd-lines-attr.db-num    = idb-num
     2282               utd-lines-attr.doc-id    = idoc-id
     2283               utd-lines-attr.lineNum   = ilineNum
     2284               utd-lines-attr.attr-code = iattrcode
     2285               utd-lines-attr.attr-value = iattrval
     2286            .
     2287         end.
     2288      end.
     2289      else do:
     2290         if utd-lines-attr.attr-value ne iattrval
     2291         then do:
     2292            find current utd-lines-attr exclusive-lock no-error.
     2293            if available utd-lines-attr
     2294            then do:
     2295               if    iattrval eq ?
     2296                  or iattrval eq ""
     2297               then do:
     2298                  delete utd-lines-attr.
     2299               end.
     2300               else do:
     2301                  utd-lines-attr.attr-value = iattrval.
     2302               end.
     2303            end.
     2304         end.
     2305      end.
     2306      release utd-lines-attr.
     2307   end.
