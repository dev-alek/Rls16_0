     1389               assign
     1390                   v-frame-width = frame fr-D-doc-line-0:width - 0.3
     1391                   fh            = frame fr-D-doc-line-0:first-child
     1392                   hh            = fh:first-child
     1393                   ii            = 1
     1394                   .
     1395               do while valid-handle(hh):
     1396                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1397                   do:
     1398                       case lc(hh:name) :
     1399                           when "b-help" then
     1400                               do:
     1401                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1402                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1403                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1404                                   hh:TOOLTIP = "Помощь" .
     1405                                   v-help-old-x = hh:column .
     1406                                   v-help-old-y = hh:row    .
     1407                                   v-help-old-size = hh:width .
     1408                                   hh:width-chars = 2.5 .
     1409                               end.
     1410                           when "b-print" then
     1411                               do:
     1412                                   hh:load-image("cmp/b-print.bmp":u) .
     1413                                   hh:TOOLTIP = "Печать" .
     1414                                   v-h[ii] = hh:handle .
     1415                                   ii = ii + 1 .
     1416                                   hh:width-chars = 3 .
     1417                               end.
     1418                           when "b-history" or
     1419                           when "b-hist" then
     1420                               do:
     1421                                   hh:load-image("cmp/b-hist.bmp":u) .
     1422                                   hh:TOOLTIP = "История" .
     1423                                   v-h[ii] = hh:handle .
     1424                                   ii = ii + 1 .
     1425                                   hh:width-chars = 3 .
     1426                               end.
     1427                           when "b-sch" then
     1428                               do:
     1429                                   hh:load-image("cmp/b-sch.bmp":u) .
     1430                                   hh:TOOLTIP = "Установка Фильтра" .
     1431                                   v-h[ii] = hh:handle .
     1432                                   ii = ii + 1 .
     1433                                   hh:width-chars = 3 .
     1434                               end.
     1435                           when "b-hist-user" then
     1436                               do:
     1437                                   hh:load-image("cmp/b-hist.bmp":u) .
     1438                                   hh:TOOLTIP = "История пользователя" .
     1439                                   ii = ii + 1 .
     1440                               end.
     1441                       end case.
     1442                   end.
     1443                   hh = hh:next-sibling.
     1444               end.
     1445               b-help:column = v-frame-width - b-help:width-chars.
     1446               jj = 0.
     1447               repeat ii = 4 to 1 by -1 :
     1448                   if valid-handle (v-h[ii] ) then
     1449                   do:
     1450                       jj  = jj + 1 .
     1451                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1452                       v-h[ii]:row    = v-help-old-y .
     1453                   end.
     1454               end.
     1455           end.
     1456       end.
     1457   end procedure.
     1458   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1459   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1460   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1461   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1462   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1463   define variable v-diasize-current-frame-height as decimal   no-undo .
     1464   define variable v-diasize-change-size          as logical   no-undo .
     1465   define variable v-diasize-resize-button        as handle    no-undo .
     1466   define variable v-diasize-wndmax               as logical   no-undo .
     1467   define variable v-diasize-wndstore             as logical   no-undo .
     1468   define variable v-diasize-proc-name            as character no-undo .
     1469   define variable v-diasize-browse-handle        as handle    no-undo .
     1470   define variable v-diasize-browse-number        as integer   no-undo .
     1471   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1472   define temp-table temp-diasize-handle no-undo
     1473     field handle-value  as handle
     1474     field save-position as decimal
     1475     index xpk is primary unique handle-value
     1476     .
     1477   define temp-table temp-browse-handle no-undo
     1478     field browse-type   as character
     1479     field browse-number as integer
     1480     field browse-handle as handle
     1481     field original-size as decimal
     1482     index xpk is primary unique browse-type browse-number
     1483     index xie browse-type browse-handle
     1484   .
     1485   procedure diasize_change-height :
     1486     define input  parameter p-change-value  as decimal   no-undo .
     1487     define input  parameter p-move-resize   as logical   no-undo .
     1488     define variable v-field-group-handle    as handle    no-undo .
     1489     define variable v-object-handle         as handle    no-undo .
     1490     define variable v-frame-height          as decimal   no-undo .
     1491     define variable v-frame-virtual-height  as decimal   no-undo .
     1492     define variable v-browse-height         as decimal   no-undo .
     1493     define variable v-window-height         as decimal   no-undo .
     1494     define variable v-window-virtual-height as decimal   no-undo .
     1495     define variable v-change-sign           as integer   no-undo .
     1496     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1497     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1498     if p-change-value > 0
     1499     then do:
     1500       if frame fr-D-doc-line-0 :height + p-change-value
     1501           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1502       then do:
     1503         assign
     1504           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1505                           - (frame fr-D-doc-line-0 :height-chars)
     1506         .
     1507         if p-change-value <= 0
     1508         then do:
     1509           run diasize_position-resize-button in this-procedure .
     1510           return .
     1511         end.
     1512       end.
     1513     end.
     1514     if p-change-value < 0
     1515     then do:
     1516       if frame fr-D-doc-line-0 :height + p-change-value < v-diasize-orig-frame-height
     1517       then do:
     1518         assign
     1519           p-change-value = v-diasize-orig-frame-height
     1520                          - (frame fr-D-doc-line-0 :height-chars)
     1521         .
     1522         if p-change-value >= 0
     1523         then do:
     1524           run diasize_position-resize-button in this-procedure .
     1525           return .
     1526         end.
     1527       end.
     1528     end.
     1529     if p-change-value >= 0
     1530     then do:
     1531       assign
     1532         v-change-sign = 1
     1533       .
     1534     end.
     1535     else do:
     1536       assign
     1537         v-change-sign = -1
     1538       .
     1539     end.
     1540     assign
     1541       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1542     .
     1543     if p-change-value = 0
     1544     then do:
     1545       run diasize_position-resize-button in this-procedure .
     1546       return .
     1547     end.
     1548     move_block:
     1549     do
     1550     on error undo move_block, retry move_block
     1551     :
     1552       if retry
     1553       then do:
     1554         do
     1555         on error undo move_block, leave move_block
     1556         :
     1557           if p-change-value > 0
     1558           then do:
     1559             for each buf_temp-diasize-handle
     1560             on error undo, next
     1561             :
     1562               assign
     1563                 v-object-handle = buf_temp-diasize-handle.handle-value
     1564               .
     1565               if v-object-handle <> v-diasize-resize-button
     1566               then do:
     1567                 assign
     1568                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1569                 .
     1570               end.
     1571             end.
     1572             assign
     1573               v-diasize-browse-handle :height = v-browse-height
     1574             .
     1575             for each buf_temp-browse-handle
     1576               where buf_temp-browse-handle.browse-type = 'height':u
     1577             on error undo, next
     1578             :
     1579               assign
     1580                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1581               .
     1582             end.
     1583             assign
     1584               frame fr-D-doc-line-0 :height = v-frame-height
     1585             .
     1586             if frame fr-D-doc-line-0 :scrollable = true
     1587             then do:
     1588               assign
     1589                 frame fr-D-doc-line-0 :virtual-height = v-frame-virtual-height
     1590               .
     1591             end.
     1592             run diasize_position-resize-button in this-procedure .
     1593           end.
     1594           else do:
     1595             if frame fr-D-doc-line-0 :scrollable = true
     1596             then do:
     1597               assign
     1598                 frame fr-D-doc-line-0 :virtual-height = v-frame-virtual-height
     1599               .
     1600             end.
     1601             assign
     1602               frame fr-D-doc-line-0 :height = v-frame-height
     1603             .
     1604             assign
     1605               v-diasize-browse-handle :height = v-browse-height
     1606             .
     1607             for each buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type = 'height':u
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1613               .
     1614             end.
     1615             for each buf_temp-diasize-handle
     1616             on error undo, next
     1617             :
     1618               assign
     1619                 v-object-handle = buf_temp-diasize-handle.handle-value
     1620               .
     1621               if v-object-handle <> v-diasize-resize-button
     1622               then do:
     1623                 assign
     1624                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1625                 .
     1626               end.
     1627             end.
     1628             run diasize_position-resize-button in this-procedure .
     1629           end.
     1630           assign
     1631             v-diasize-change-size = false
     1632           .
     1633           leave move_block .
     1634         end.
     1635       end.
     1636       assign
     1637         v-diasize-need-full-display = true
     1638       .
     1639       if v-diasize-change-size = false
     1640       then do:
     1641         assign
     1642           v-diasize-change-size = true
     1643         .
     1644       end.
     1645       else do:
     1646         return .
     1647       end.
     1648       assign
     1649         v-frame-height = frame fr-D-doc-line-0 :height
     1650         v-frame-virtual-height = frame fr-D-doc-line-0 :virtual-height
     1651         v-browse-height = v-diasize-browse-handle :height
     1652       .
     1653       for each buf_temp-browse-handle
     1654         where buf_temp-browse-handle.browse-type = 'height':u
     1655       :
     1656         assign
     1657           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1658         .
     1659       end.
     1660       for each buf_temp-diasize-handle
     1661       :
     1662         delete buf_temp-diasize-handle .
     1663       end.
     1664       assign
     1665         v-field-group-handle = frame fr-D-doc-line-0 :first-child
     1666       .
     1667       do while valid-handle(v-field-group-handle)
     1668       :
     1669         assign
     1670           v-object-handle = v-field-group-handle :first-child
     1671         .
     1672         do while valid-handle(v-object-handle)
     1673         :
     1674           if  v-object-handle <> v-diasize-browse-handle :handle
     1675           and can-query(v-object-handle, "row")
     1676           and can-query(v-object-handle, "height")
     1677           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1678           then do:
     1679             find first buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type   = 'height':u
     1681                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1682               no-error .
     1683             if available buf_temp-browse-handle
     1684             then do:
     1685             end.
     1686             else do:
     1687               create buf_temp-diasize-handle .
     1688               assign
     1689                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1690                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1691               .
     1692             end.
     1693           end.
     1694           assign
     1695             v-object-handle = v-object-handle :next-sibling
     1696           .
     1697         end.
     1698         assign
     1699           v-field-group-handle = v-field-group-handle :next-sibling
     1700         .
     1701       end.
     1702       do with frame fr-D-doc-line-0
     1703       :
     1704         hide v-diasize-resize-button .
     1705         assign
     1706           v-diasize-resize-button :row    = 1
     1707           v-diasize-resize-button :column = 1
     1708         .
     1709       end.
     1710       if p-change-value > 0
     1711       then do:
     1712         if frame fr-D-doc-line-0 :scrollable = true
     1713         then do:
     1714           assign
     1715             frame fr-D-doc-line-0 :virtual-height = frame fr-D-doc-line-0 :virtual-height + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723         assign
     1724           frame fr-D-doc-line-0 :height = frame fr-D-doc-line-0 :height + p-change-value
     1725           no-error .
     1726         if error-status :error
     1727         or error-status :get-message(1) <> ""
     1728         then do:
     1729           undo move_block, retry move_block .
     1730         end.
     1731         assign
     1732           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1733           no-error .
     1734         if error-status :error
     1735         or error-status :get-message(1) <> ""
     1736         then do:
     1737           undo move_block, retry move_block .
     1738         end.
     1739         for each buf_temp-browse-handle
     1740           where buf_temp-browse-handle.browse-type = 'height':u
     1741         on error undo move_block, retry move_block
     1742         :
     1743           assign
     1744             buf_temp-browse-handle.browse-handle :height
     1745               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1746             no-error .
     1747           if error-status :error
     1748           or error-status :get-message(1) <> ""
     1749           then do:
     1750             undo move_block, retry move_block .
     1751           end.
     1752         end.
     1753         for each buf_temp-diasize-handle
     1754         on error undo move_block, retry move_block
     1755         :
     1756           assign
     1757             v-object-handle = buf_temp-diasize-handle.handle-value
     1758           .
     1759           if v-object-handle <> v-diasize-resize-button
     1760           then do:
     1761             assign
     1762               v-object-handle :row = v-object-handle :row + p-change-value
     1763               no-error .
     1764             if error-status :error
     1765             or error-status :get-message(1) <> ""
     1766             then do:
     1767               undo move_block, retry move_block .
     1768             end.
     1769           end.
     1770         end.
     1771       end.
     1772       else do:
     1773         for each buf_temp-diasize-handle
     1774         on error undo move_block, retry move_block
     1775         :
     1776           assign
     1777             v-object-handle = buf_temp-diasize-handle.handle-value
     1778           .
     1779           if v-object-handle <> v-diasize-resize-button
     1780           then do:
     1781             assign
     1782               v-object-handle :row = v-object-handle :row + p-change-value
     1783               no-error .
     1784             if error-status :error
     1785             or error-status :get-message(1) <> ""
     1786             then do:
     1787               undo move_block, retry move_block .
     1788             end.
     1789           end.
     1790         end.
     1791         assign
     1792           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1793           no-error .
     1794         if error-status :error
     1795         or error-status :get-message(1) <> ""
     1796         then do:
     1797           undo move_block, retry move_block .
     1798         end.
     1799         for each buf_temp-browse-handle
     1800           where buf_temp-browse-handle.browse-type = 'height':u
     1801         on error undo move_block, retry move_block
     1802         :
     1803           assign
     1804             buf_temp-browse-handle.browse-handle :height
     1805               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1806             no-error .
     1807           if error-status :error
     1808           or error-status :get-message(1) <> ""
     1809           then do:
     1810             undo move_block, retry move_block .
     1811           end.
     1812         end.
     1813         assign
     1814           frame fr-D-doc-line-0 :height = frame fr-D-doc-line-0 :height + p-change-value
     1815           no-error .
     1816         if error-status :error
     1817         or error-status :get-message(1) <> ""
     1818         then do:
     1819           undo move_block, retry move_block .
     1820         end.
     1821         if frame fr-D-doc-line-0 :scrollable = true
     1822         then do:
     1823           assign
     1824             frame fr-D-doc-line-0 :virtual-height = frame fr-D-doc-line-0 :virtual-height + p-change-value
     1825             no-error .
     1826           if error-status :error
     1827           or error-status :get-message(1) <> ""
     1828           then do:
     1829             undo move_block, retry move_block .
     1830           end.
     1831         end.
     1832       end.
     1833       if p-move-resize = true
     1834       then do:
     1835         run diasize_position-resize-button in this-procedure .
     1836       end.
     1837       if v-diasize-wndstore = true
     1838       then do:
     1839         if connected("ub") = true
     1840         then do:
     1841           define variable v-cntxt-db-num        as integer   no-undo .
     1842           define variable v-cntxt-userid        as character no-undo .
     1843           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1844                                             , OUTPUT v-cntxt-userid
     1845                                             ) .
     1846           run gbl/wndsizew.p
     1847             (input  v-cntxt-db-num
     1848             ,input  v-cntxt-userid
     1849             ,input  v-diasize-proc-name
     1850             ,input  'height':u
     1851             ,input  string(frame fr-D-doc-line-0 :height - v-diasize-orig-frame-height)
     1852             ) .
     1853         end.
     1854       end.
     1855     end.
     1856     assign
     1857       v-diasize-change-size = false
     1858     .
     1859   end procedure.
     1860   procedure diasize_set-height :
     1861     define input  parameter p-new-height  as decimal   no-undo .
     1862     define input  parameter p-move-resize as logical   no-undo .
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       run diasize_change-height in this-procedure
     1867         (input  (p-new-height - frame fr-D-doc-line-0 :height)
     1868         ,input  p-move-resize
     1869         ) .
     1870     end.
     1871   end procedure.
     1872   procedure diasize_change-width :
     1873     define input  parameter p-change-value as decimal   no-undo .
     1874     define input  parameter p-move-resize  as logical   no-undo .
     1875     define variable v-field-group-handle   as handle    no-undo .
     1876     define variable v-object-handle        as handle    no-undo .
     1877     define variable v-frame-width          as decimal   no-undo .
     1878     define variable v-frame-virtual-width  as decimal   no-undo .
     1879     define variable v-browse-width         as decimal   no-undo .
     1880     define variable v-window-width         as decimal   no-undo .
     1881     define variable v-window-virtual-width as decimal   no-undo .
     1882     define variable v-change-sign          as integer   no-undo .
     1883     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1884     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1885     if p-change-value > 0
     1886     then do:
     1887       if frame fr-D-doc-line-0 :width + p-change-value >
     1888           session :width-chars
     1889       then do:
     1890         assign
     1891           p-change-value = session :width-chars - frame fr-D-doc-line-0 :width
     1892         .
     1893         if p-change-value <= 0
     1894         then do:
     1895           run diasize_position-resize-button in this-procedure .
     1896           return .
     1897         end.
     1898       end.
     1899     end.
     1900     if p-change-value < 0
     1901     then do:
     1902       if frame fr-D-doc-line-0 :width + p-change-value < v-diasize-orig-frame-width
     1903       then do:
     1904         assign
     1905           p-change-value = v-diasize-orig-frame-width
     1906                          - frame fr-D-doc-line-0 :width
     1907         .
     1908         if p-change-value >= 0
     1909         then do:
     1910           run diasize_position-resize-button in this-procedure .
     1911           return .
     1912         end.
     1913       end.
     1914     end.
     1915     if p-change-value >= 0
     1916     then do:
     1917       assign
     1918         v-change-sign = 1
     1919       .
     1920     end.
     1921     else do:
     1922       assign
     1923         v-change-sign = -1
     1924       .
     1925     end.
     1926     assign
     1927       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1928     .
     1929     if p-change-value = 0
     1930     then do:
     1931       run diasize_position-resize-button in this-procedure .
     1932       return .
     1933     end.
     1934     move_block:
     1935     do
     1936     on error undo move_block, leave move_block
     1937     :
     1938       if retry
     1939       then do:
     1940         do
     1941         on error undo move_block, leave move_block
     1942         :
     1943           if p-change-value > 0
     1944           then do:
     1945             for each buf_temp-diasize-handle
     1946             on error undo, next
     1947             :
     1948               assign
     1949                 v-object-handle = buf_temp-diasize-handle.handle-value
     1950               .
     1951               if v-object-handle <> v-diasize-resize-button
     1952               then do:
     1953                 assign
     1954                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1955                 .
     1956               end.
     1957             end.
     1958             assign
     1959               v-diasize-browse-handle :width = v-browse-width
     1960             .
     1961             for each buf_temp-browse-handle
     1962               where buf_temp-browse-handle.browse-type = 'width':u
     1963             on error undo, next
     1964             :
     1965               assign
     1966                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1967               .
     1968             end.
     1969             assign
     1970               frame fr-D-doc-line-0 :width = v-frame-width
     1971             .
     1972             if frame fr-D-doc-line-0 :scrollable = true
     1973             then do:
     1974               assign
     1975                 frame fr-D-doc-line-0 :virtual-width = v-frame-virtual-width
     1976               .
     1977             end.
     1978             run diasize_position-resize-button in this-procedure .
     1979           end.
     1980           else do:
     1981             if frame fr-D-doc-line-0 :scrollable = true
     1982             then do:
     1983               assign
     1984                 frame fr-D-doc-line-0 :virtual-width = v-frame-virtual-width
     1985               .
     1986             end.
     1987             assign
     1988               frame fr-D-doc-line-0 :width = v-frame-width
     1989             .
     1990             for each buf_temp-browse-handle
     1991               where buf_temp-browse-handle.browse-type = 'width':u
     1992             on error undo, next
     1993             :
     1994               assign
     1995                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1996               .
     1997             end.
     1998             assign
     1999               v-diasize-browse-handle :width = v-browse-width
     2000             .
     2001             for each buf_temp-diasize-handle
     2002             on error undo, next
     2003             :
     2004               assign
     2005                 v-object-handle = buf_temp-diasize-handle.handle-value
     2006               .
     2007               if v-object-handle <> v-diasize-resize-button
     2008               then do:
     2009                 assign
     2010                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2011                 .
     2012               end.
     2013             end.
     2014             run diasize_position-resize-button in this-procedure .
     2015           end.
     2016           assign
     2017             v-diasize-change-size = false
     2018           .
     2019           leave move_block .
     2020         end.
     2021       end.
     2022       assign
     2023         v-diasize-need-full-display = true
     2024       .
     2025       if v-diasize-change-size = false
     2026       then do:
     2027         assign
     2028           v-diasize-change-size = true
     2029         .
     2030       end.
     2031       else do:
     2032         return .
     2033       end.
     2034       assign
     2035         v-frame-width = frame fr-D-doc-line-0 :width
     2036         v-frame-virtual-width = frame fr-D-doc-line-0 :virtual-width
     2037         v-browse-width = v-diasize-browse-handle :width
     2038       .
     2039       for each buf_temp-browse-handle
     2040         where buf_temp-browse-handle.browse-type = 'width':u
     2041       :
     2042         assign
     2043           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2044         .
     2045       end.
     2046       for each buf_temp-diasize-handle
     2047       :
     2048         delete buf_temp-diasize-handle .
     2049       end.
     2050       assign
     2051         v-field-group-handle = frame fr-D-doc-line-0 :first-child
     2052       .
     2053       do while valid-handle(v-field-group-handle)
     2054       :
     2055         assign
     2056           v-object-handle = v-field-group-handle :first-child
     2057         .
     2058         do while valid-handle(v-object-handle)
     2059         :
     2060           if  v-object-handle <> v-diasize-browse-handle :handle
     2061           and v-object-handle <> v-diasize-resize-button
     2062           and can-query(v-object-handle, "row")
     2063           and can-query(v-object-handle, "height")
     2064           and ( v-object-handle :col + v-object-handle :width
     2065                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2066               )
     2067           then do:
     2068             find first buf_temp-browse-handle
     2069               where buf_temp-browse-handle.browse-type   = 'width':u
     2070                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2071               no-error .
     2072             if available buf_temp-browse-handle
     2073             then do:
     2074             end.
     2075             else do:
     2076               create buf_temp-diasize-handle .
     2077               assign
     2078                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2079                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2080               .
     2081             end.
     2082           end.
     2083           assign
     2084             v-object-handle = v-object-handle :next-sibling
     2085           .
     2086         end.
     2087         assign
     2088           v-field-group-handle = v-field-group-handle :next-sibling
     2089         .
     2090       end.
     2091       do with frame fr-D-doc-line-0
     2092       :
     2093         hide v-diasize-resize-button .
     2094         v-diasize-resize-button :row = 1.
     2095         v-diasize-resize-button :column = 1.
     2096       end.
     2097       if p-change-value > 0
     2098       then do:
     2099         if frame fr-D-doc-line-0 :scrollable = true
     2100         then do:
     2101           assign
     2102             frame fr-D-doc-line-0 :virtual-width = frame fr-D-doc-line-0 :virtual-width + p-change-value
     2103             no-error .
     2104           if error-status :error
     2105           or error-status :get-message(1) <> ""
     2106           then do:
     2107             undo move_block, retry move_block.
     2108           end.
     2109         end.
     2110         assign
     2111           frame fr-D-doc-line-0 :width = v-frame-width + p-change-value
     2112           no-error .
     2113         if error-status :error
     2114         or error-status :get-message(1) <> ""
     2115         then do:
     2116           undo move_block, retry move_block.
     2117         end.
     2118         assign
     2119           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2120         no-error .
     2121         if error-status :error
     2122         or error-status :get-message(1) <> ""
     2123         then do:
     2124           undo move_block, retry move_block.
     2125         end.
     2126         for each buf_temp-browse-handle
     2127           where buf_temp-browse-handle.browse-type = 'width':u
     2128         on error undo move_block, retry move_block
     2129         :
     2130           assign
     2131             buf_temp-browse-handle.browse-handle :width
     2132               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2133             no-error .
     2134           if error-status :error
     2135           or error-status :get-message(1) <> ""
     2136           then do:
     2137             undo move_block, retry move_block .
     2138           end.
     2139         end.
     2140         for each buf_temp-diasize-handle
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             v-object-handle = buf_temp-diasize-handle.handle-value
     2145           .
     2146           if v-object-handle <> v-diasize-resize-button
     2147           then do:
     2148             assign
     2149               v-object-handle :col = v-object-handle :col + p-change-value
     2150               no-error .
     2151             if error-status :error
     2152             or error-status :get-message(1) <> ""
     2153             then do:
     2154               undo move_block, retry move_block .
     2155             end.
     2156           end.
     2157         end.
     2158       end.
     2159       else do:
     2160         for each buf_temp-diasize-handle
     2161         on error undo move_block, retry move_block
     2162         :
     2163           assign
     2164             v-object-handle = buf_temp-diasize-handle.handle-value
     2165           .
     2166           if v-object-handle <> v-diasize-resize-button
     2167           then do:
     2168             assign
     2169               v-object-handle :col = v-object-handle :col + p-change-value
     2170               no-error .
     2171             if error-status :error
     2172             or error-status :get-message(1) <> ""
     2173             then do:
     2174               undo move_block, retry move_block .
     2175             end.
     2176           end.
     2177         end.
     2178         for each buf_temp-browse-handle
     2179           where buf_temp-browse-handle.browse-type = 'width':u
     2180         on error undo move_block, retry move_block
     2181         :
     2182           assign
     2183             buf_temp-browse-handle.browse-handle :width
     2184               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2185             no-error .
     2186           if error-status :error
     2187           or error-status :get-message(1) <> ""
     2188           then do:
     2189             undo move_block, retry move_block .
     2190           end.
     2191         end.
     2192         assign
     2193           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2194           no-error .
     2195         if error-status :error
     2196         or error-status :get-message(1) <> ""
     2197         then do:
     2198           undo move_block, retry move_block.
     2199         end.
     2200         assign
     2201           frame fr-D-doc-line-0 :width = frame fr-D-doc-line-0 :width + p-change-value
     2202         no-error .
     2203         if error-status :error
     2204         or error-status :get-message(1) <> ""
     2205         then do:
     2206           undo move_block, retry move_block.
     2207         end.
     2208         if frame fr-D-doc-line-0 :scrollable = true
     2209         then do:
     2210           assign
     2211             frame fr-D-doc-line-0 :virtual-width = frame fr-D-doc-line-0 :virtual-width + p-change-value
     2212           no-error .
     2213           if error-status :error
     2214           or error-status :get-message(1) <> ""
     2215           then do:
     2216             undo move_block, retry move_block.
     2217           end.
     2218         end.
     2219       end.
     2220       if p-move-resize
     2221       then do:
     2222         run diasize_position-resize-button in this-procedure .
     2223       end.
     2224       if v-diasize-wndstore = true
     2225       then do:
     2226         if connected("ub") = true
     2227         then do:
     2228           define variable v-cntxt-db-num        as integer   no-undo .
     2229           define variable v-cntxt-userid        as character no-undo .
     2230           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2231                                             , OUTPUT v-cntxt-userid
     2232                                             ) .
     2233           run gbl/wndsizew.p
     2234             (input  v-cntxt-db-num
     2235             ,input  v-cntxt-userid
     2236             ,input  v-diasize-proc-name
     2237             ,input  'width':u
     2238             ,input  string(frame fr-D-doc-line-0 :width - v-diasize-orig-frame-width)
     2239             ) .
     2240         end.
     2241       end.
     2242     end.
     2243     assign
     2244       v-diasize-change-size = false
     2245     .
     2246   end procedure.
     2247   procedure diasize_set-width :
     2248     define input  parameter p-new-width  as decimal   no-undo .
     2249     define input  parameter p-move-resize as logical   no-undo .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       run diasize_change-width in this-procedure
     2254         (input  (p-new-width - frame fr-D-doc-line-0 :width)
     2255         ,input  p-move-resize
     2256         ) .
     2257     end.
     2258   end procedure.
     2259   procedure diasize_position-resize-button :
     2260     do with frame fr-D-doc-line-0
     2261     :
     2262       hide v-diasize-resize-button .
     2263       assign
     2264         v-diasize-resize-button :row = frame fr-D-doc-line-0 :height - v-diasize-resize-button :height
     2265                     - 1
     2266                     - (frame fr-D-doc-line-0 :border-bottom-pixels / session :pixels-per-row)
     2267         v-diasize-resize-button :col = frame fr-D-doc-line-0 :width - v-diasize-resize-button :width
     2268                     - 1
     2269                     - (frame fr-D-doc-line-0 :border-right-pixels / session :pixels-per-column)
     2270       .
     2271       view v-diasize-resize-button .
     2272     end.
     2273   end procedure.
     2274   on alt-right anywhere
     2275   do:
     2276     run diasize_change-width in this-procedure
     2277       (input 1
     2278       ,input true
     2279       ) .
     2280     return no-apply .
     2281   end.
     2282   on alt-left anywhere
     2283   do:
     2284     run diasize_change-width in this-procedure
     2285       (input -1
     2286       ,input true
     2287       ) .
     2288     return no-apply .
     2289   end.
     2290   on alt-down anywhere
     2291   do:
     2292     run diasize_change-height in this-procedure
     2293       (input 1
     2294       ,input true
     2295       ) .
     2296     return no-apply .
     2297   end.
     2298   on alt-up anywhere
     2299   do:
     2300     run diasize_change-height in this-procedure
     2301       (input -1
     2302       ,input true
     2303       ) .
     2304     return no-apply .
     2305   end.
     2306   on alt-enter of frame fr-D-doc-line-0
     2307   do:
     2308     run diasize_maximize in this-procedure
     2309       (input  ?
     2310       ).
     2311     return no-apply .
     2312   end.
     2313   procedure diasize_end-move :
     2314     do
     2315     on error undo, return error return-value
     2316     :
     2317       define variable v-row-delta as decimal   no-undo .
     2318       define variable v-col-delta as decimal   no-undo .
     2319       define variable v-new-row as decimal   no-undo .
     2320       define variable v-new-col as decimal   no-undo .
     2321       assign
     2322         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2323         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2324       .
     2325       assign
     2326         v-row-delta = v-new-row - frame fr-D-doc-line-0 :height
     2327         v-col-delta = v-new-col - frame fr-D-doc-line-0 :width
     2328       .
     2329       run diasize_change-height in this-procedure
     2330         (input v-row-delta
     2331         ,input true
     2332         ) .
     2333       run diasize_change-width in this-procedure
     2334         (input v-col-delta
     2335         ,input true
     2336         ) .
     2337     end.
     2338   end procedure.
     2339   procedure diasize_maximize :
     2340     define input  parameter p-action as logical   no-undo .
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       if p-action = ?
     2345       then do:
     2346         if v-diasize-need-maximize = true
     2347         then do:
     2348           assign
     2349             p-action = true
     2350           .
     2351         end.
     2352         else do:
     2353           assign
     2354             p-action = false
     2355           .
     2356         end.
     2357       end.
     2358       if p-action = true
     2359       then do:
     2360         run diasize_change-height in this-procedure
     2361           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2362               - frame fr-D-doc-line-0 :height-chars
     2363           ,input true
     2364           ) .
     2365         run diasize_change-width in this-procedure
     2366           (input session :width-chars
     2367               - frame fr-D-doc-line-0 :width-chars
     2368           ,input true
     2369           ) .
     2370         assign
     2371           v-diasize-need-maximize = false
     2372         .
     2373       end.
     2374       else do:
     2375         run diasize_change-width in this-procedure
     2376           (input v-diasize-orig-frame-width
     2377               - frame fr-D-doc-line-0 :width-chars
     2378           ,input true
     2379           ) .
     2380         run diasize_change-height in this-procedure
     2381           (input v-diasize-orig-frame-height
     2382               - frame fr-D-doc-line-0 :height-chars
     2383           ,input true
     2384           ) .
     2385         assign
     2386           v-diasize-need-maximize = true
     2387         .
     2388       end.
     2389     end.
     2390   end procedure.
     2391   procedure diasize_restore-orig-size :
     2392     do
     2393     on error undo, return error return-value
     2394     :
     2395       assign
     2396         v-diasize-current-frame-width  = frame fr-D-doc-line-0 :width
     2397         v-diasize-current-frame-height = frame fr-D-doc-line-0 :height
     2398       .
     2399       run diasize_set-height in this-procedure
     2400         (input  v-diasize-orig-frame-height
     2401         ,input  true
     2402         ) .
     2403       run diasize_set-width in this-procedure
     2404         (input  v-diasize-orig-frame-width
     2405         ,input  true
     2406         ) .
     2407     end.
     2408   end procedure.
     2409   procedure diasize_restore-current-size :
     2410     do
     2411     on error undo, return error return-value
     2412     :
     2413       run diasize_set-height in this-procedure
     2414         (input  v-diasize-current-frame-height
     2415         ,input  true
     2416         ) .
     2417       run diasize_set-width in this-procedure
     2418         (input  v-diasize-current-frame-width
     2419         ,input  true
     2420         ) .
     2421     end.
     2422   end procedure.
     2423   procedure diasize_set-browse-handle :
     2424     define input  parameter p-browse-handle as handle   no-undo .
     2425     define buffer buf_temp-browse-handle for temp-browse-handle .
     2426     do
     2427     on error undo, return error return-value
     2428     :
     2429       assign
     2430         v-diasize-browse-handle = p-browse-handle
     2431       .
     2432       for each buf_temp-browse-handle
     2433       on error undo, return error return-value
     2434       :
     2435         delete buf_temp-browse-handle .
     2436       end.
     2437     end.
     2438   end procedure.
     2439   procedure diasize_add_browse :
     2440     define input  parameter p-browse-type   as character no-undo .
     2441     define input  parameter p-browse-handle as handle    no-undo .
     2442     define buffer buf_temp-browse-handle for temp-browse-handle .
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       assign
     2447         v-diasize-browse-number = v-diasize-browse-number + 1
     2448       .
     2449       create buf_temp-browse-handle .
     2450       assign
     2451         buf_temp-browse-handle.browse-type   = p-browse-type
     2452         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2453         buf_temp-browse-handle.browse-handle = p-browse-handle
     2454       .
     2455     end.
     2456   end procedure.
     2457   procedure diasize_init :
     2458     define variable v-default-value    as logical   no-undo .
     2459     define variable v-restore-saved    as logical   no-undo .
     2460     define variable v-resize-value-str as character no-undo .
     2461     do
     2462     on error undo, return error return-value
     2463     :
     2464       do with frame fr-D-doc-line-0
     2465       :
     2466         assign
     2467           v-diasize-orig-frame-height = frame fr-D-doc-line-0 :height
     2468           v-diasize-orig-frame-width  = frame fr-D-doc-line-0 :width
     2469           v-diasize-browse-handle     = browse br-doc-lines :handle
     2470         .
     2471         create button v-diasize-resize-button
     2472         assign
     2473           parent        = frame fr-D-doc-line-0 :first-child
     2474           label         = "s"
     2475           height-pixels = 16
     2476           width-pixels  = 16
     2477           visible       = true
     2478           sensitive     = true
     2479           movable       = true
     2480           triggers:
     2481             on end-move persistent run diasize_end-move in this-procedure .
     2482           end triggers.
     2483         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2484         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2485         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2486         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2487         assign
     2488           v-diasize-wndmax = false
     2489         .
     2490         if connected("ub") = true
     2491         then do:
     2492           define variable v-cntxt-db-num        as integer   no-undo .
     2493           define variable v-cntxt-userid        as character no-undo .
     2494           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2495                                             , OUTPUT v-cntxt-userid
     2496                                             ) .
     2497           run gbl/wndpar_r.p
     2498             (input  v-cntxt-db-num
     2499             ,input  v-cntxt-userid
     2500             ,input  'wndmax':U
     2501             ,output v-diasize-wndmax
     2502             ,output v-default-value
     2503             ) .
     2504         end.
     2505         assign
     2506           v-diasize-wndstore = false
     2507         .
     2508         if connected("ub") = true
     2509         then do:
     2510           run gbl/wndpar_r.p
     2511             (input  v-cntxt-db-num
     2512             ,input  v-cntxt-userid
     2513             ,input  'wndstore':U
     2514             ,output v-diasize-wndstore
     2515             ,output v-default-value
     2516             ) .
     2517         end.
     2518         assign
     2519           v-diasize-proc-name = entry(1, program-name(2), '.')
     2520         .
     2521         if v-diasize-wndstore = true
     2522         then do:
     2523           assign
     2524             v-restore-saved = false
     2525           .
     2526           if connected("ub") = true
     2527           then do:
     2528             run gbl/wndsizer.p
     2529               (input  v-cntxt-db-num
     2530               ,input  v-cntxt-userid
     2531               ,input  v-diasize-proc-name
     2532               ,input  'height':u
     2533               ,output v-resize-value-str
     2534               ) .
     2535             if v-resize-value-str <> '':U
     2536             then do:
     2537               run diasize_change-height in this-procedure
     2538                 (input  integer(v-resize-value-str)
     2539                 ,input  true
     2540                 ) .
     2541               assign
     2542                 v-restore-saved = true
     2543               .
     2544             end.
     2545           end.
     2546           if connected("ub") = true
     2547           then do:
     2548             run gbl/wndsizer.p
     2549               (input  v-cntxt-db-num
     2550               ,input  v-cntxt-userid
     2551               ,input  v-diasize-proc-name
     2552               ,input  'width':u
     2553               ,output v-resize-value-str
     2554               ) .
     2555             if v-resize-value-str <> '':U
     2556             then do:
     2557               run diasize_change-width in this-procedure
     2558                 (input  integer(v-resize-value-str)
     2559                 ,input  true
     2560                 ) .
     2561               assign
     2562                 v-restore-saved = true
     2563               .
     2564             end.
     2565           end.
     2566           if v-restore-saved <> true
     2567           then do:
     2568             if v-diasize-wndmax = true
     2569             then do:
     2570               run diasize_maximize in this-procedure
     2571                 (input  true
     2572                 ) .
     2573             end.
     2574           end.
     2575         end.
     2576         else do:
     2577           if v-diasize-wndmax = true
     2578           then do:
     2579             run diasize_maximize in this-procedure
     2580               (input  true
     2581               ) .
     2582           end.
     2583         end.
     2584       end.
     2585     end.
     2586   end procedure.
     2587   procedure diasize_need-full-display :
     2588     define output parameter p-need-full-display as logical   no-undo .
     2589     do
     2590     on error undo, return error return-value
     2591     :
     2592       assign
     2593         p-need-full-display = v-diasize-need-full-display
     2594       .
     2595       assign
     2596         v-diasize-need-full-display = false
     2597       .
     2598     end.
     2599   end procedure.
     2600   procedure get-context :
     2601      define output parameter p-db-num as integer          no-undo.
     2602      define output parameter p-user-id as character        no-undo.
     2603      define variable v-login               as character    no-undo.
     2604      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2605      define buffer buf_user-login  for ub.user-login .
     2606      do
     2607      on error undo, return error
     2608      :
     2609            FIND FIRST buf_sys-ctrl no-lock.
     2610            ASSIGN
     2611               v-login = USERID("ub")
     2612               p-db-num = buf_sys-ctrl.db-num
     2613            .
     2614            FIND FIRST buf_user-login
     2615                 WHERE buf_user-login.db-num = p-db-num
     2616                   AND buf_user-login.user-login = v-login
     2617                 no-lock
     2618                 no-error
     2619                 .
     2620            IF AVAILABLE buf_user-login
     2621            THEN DO:
     2622               assign
     2623                  p-user-id = buf_user-login.user-id
     2624               .
     2625            END.
     2626      end.
     2627   end procedure.
     2628       run diasize_init in this-procedure .
     2629   Main-Block:
     2630   do on error   undo Main-Block, leave Main-Block
     2631      on end-key undo Main-Block, leave Main-Block :
     2632   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2634     (output varr-b
     2635     )  .
     2636     if lookup( p-mode, 'все,obj,gds,doc,one':U ) = 0 then do:
     2637       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2638               "Неверное значение параметра вызова p-mode:" p-mode
     2639       view-as alert-box error.
     2640       return.
     2641     end.
     2642     if p-mode = 'obj':U or
     2643        p-mode = 'gds':U then do:
     2644       find first buf_sch_hist no-lock where
     2645                  buf_sch_hist.obj-type = p-prod-type and
     2646                  buf_sch_hist.obj-code = p-prod-code no-error.
     2647       if not available buf_sch_hist then do:
     2648       end.
     2649     end.
     2650     if p-mode = 'gds':U then do:
     2651       find first buf_sch_hist no-lock where
     2652                  buf_sch_hist.obj-type  = p-obj-type  and
     2653                  buf_sch_hist.obj-code  = p-obj-code  and
     2654                  buf_sch_hist.artic     = p-artic     and
     2655                  buf_sch_hist.prod-type = p-prod-type and
     2656                  buf_sch_hist.prod-code = p-prod-code no-error.
     2657       if not available buf_sch_hist then do:
     2658       end.
     2659     end.
     2660     if p-mode = 'doc':U or
     2661        p-mode = 'one':U then do:
     2662       find first buf_sch_hist no-lock where
     2663                  buf_sch_hist.doc-code = p-doc-code no-error.
     2664       if not available buf_sch_hist then do:
     2665       end.
     2666     end.
     2667     if p-mode = 'one':U then do:
     2668       find first buf_sch_hist no-lock where
     2669                  buf_sch_hist.doc-code  = p-doc-code  and
     2670                  buf_sch_hist.artic     = p-artic     and
     2671                  buf_sch_hist.prod-type = p-prod-type and
     2672                  buf_sch_hist.prod-code = p-prod-code no-error.
     2673       if not available buf_sch_hist then do:
     2674       end.
     2675     end.
     2676     if p-rid-list <> "":U then do:
     2677       find first buf_sch_hist no-lock where recid( buf_sch_hist ) = integer( entry( 1, p-rid-list ) ) no-error.
     2678       if not available buf_sch_hist then do:
     2679       end.
     2680       else do:
     2681         assign doc-rec = recid( buf_sch_hist ).
     2682       end.
     2683     end.
     2684     define buffer buf_goods for ub.goods .
     2685     enable  b-mark when lookup( "b-mark":U, p-bttns ) > 0 or p-bttns = "*"
     2686             b-sel  when lookup( "b-sel":U,  p-bttns ) > 0 or p-bttns = "*"
     2687             b-sch b-help b-quit  sch-doc    sch-gds
     2688             b-Dtls br-doc-lines br-changes
     2689             b-petrol
     2690     with frame fr-D-doc-line-0.
     2691         if not can-find ( first ub.c-gds-dtl no-lock where
     2692                                 ub.c-gds-dtl.doc-code  = p-doc-code
     2693                                 ) then
     2694            disable b-Dtls with frame fr-D-doc-line-0 .
     2695         if not can-find ( first ub.c-inv-line no-lock where
     2696                                 ub.c-inv-line.doc-code  = p-doc-code
     2697                                 ) then
     2698            disable b-Petrol with frame fr-D-doc-line-0 .
     2699     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2700     hide mark-num in frame fr-D-doc-line-0.
     2701     hide  sch-num in frame fr-D-doc-line-0.
     2702     if p-rid-list <> "":U then do: reposition br-doc-lines to recid doc-rec no-error. end.
     2703     br-doc-lines :set-repositioned-row( 5, "CONDITIONAL" ).
     2704     wait-for go of frame fr-D-doc-line-0.
     2705   end.
     2706   hide frame fr-D-doc-line-0 no-pause.
     2707   procedure OpenBr :
     2708     define input parameter p-open-query     as logical   no-undo.
     2709     define input parameter p-find-next      as logical   no-undo.
     2710     define input parameter p-find-condition as character no-undo.
     2711     define variable l-query-was-opened as logical   no-undo.
     2712     define variable title0             as character no-undo.
     2713     define variable sort-column-phrase as character no-undo.
     2714     define variable p-proc-hand as handle no-undo.
     2715     run WaitFram-Show in this-procedure ( input "Ждите..." ).
     2716     assign title0 = "История" + chr(32).
     2717     assign p-proc-hand = this-procedure :handle.
     2718     define variable l-open-query as logical no-undo.
     2719     assign filter-point = filter-point0 + " - " + p-mode.
     2720     case p-mode :
     2721       when 'все':U  then do:
     2722         assign frame fr-D-doc-line-0 :title = title0 + "строк документов".
     2723   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2724   define variable  l-disable-where-18  as logical   no-undo .
     2725   define variable  l-filter-open-18    as logical   .
     2726   define variable  flt-rec-18       as recid     no-undo .
     2727   define variable  filter-name-18      as character no-undo .
     2728   define variable  where-phrase-18     as character no-undo .
     2729   define variable  sort-phrase-18      as character no-undo .
     2730   define variable  where-phrase-rus-18 as character no-undo .
     2731   define variable  sort-phrase-rus-18  as character no-undo .
     2732     run waitfram-show in this-procedure
     2733       (input "ЖДИТЕ ..."
     2734       ).
     2735   run gbl/flt-get.p
     2736     (input filter-point
     2737     ,output flt-rec-18
     2738     ,output filter-name-18
     2739     ,output where-phrase-18
     2740     ,output sort-phrase-18
     2741     ,output where-phrase-rus-18
     2742     ,output sort-phrase-rus-18
     2743     ).
     2744   if p-open-query then do:
     2745       run set-filter-name in this-procedure
     2746         (INPUT filter-name-18
     2747         ) no-error .
     2748     assign
     2749       l-filter-open-18 = false
     2750     .
     2751     if flt-rec-18 <> ?
     2752       or sort-column-phrase > ""
     2753     then do:
     2754       define variable  parameter-2-18 as character no-undo .
     2755       define variable  parameter-3-18 as character no-undo .
     2756       define variable  parameter-4-18 as character no-undo .
     2757       define variable  parameter-5-18 as character no-undo .
     2758       define variable  parameter-6-18 as character no-undo .
     2759       define variable  parameter-7-18 as character no-undo .
     2760         assign
     2761         parameter-3-18 =
     2762                                 "FOR EACH buf_history"
     2763         parameter-4-18 =
     2764           (
     2765             if (" true " + " " + where-phrase-18) <> ""
     2766             then  'true'  + " " + where-phrase-18
     2767             else "true"
     2768           )
     2769         parameter-5-18 = (" " + "" + " " + "")
     2770         parameter-6-18 = if sort-phrase-18 = ''
     2771                              then
     2772           (
     2773           " " + "  " +
     2774             " " + sort-column-phrase +
     2775           " " + "  "
     2776           )
     2777                              else
     2778           (
     2779           " " + "  " +
     2780             " " + sort-column-phrase +
     2781           " " + sort-phrase-18
     2782           )
     2783         parameter-7-18 =
     2784           " indexed-reposition  "
     2785       .
     2786       do
     2787       on stop undo, leave
     2788       on error undo, leave
     2789       :
     2790         assign
     2791           l-disable-where-18 =
     2792             (" true " + " " + where-phrase-18 = "")
     2793         .
     2794         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2795                             ,input query br-doc-lines:handle
     2796                             ,input parameter-3-18
     2797                             ,input parameter-4-18
     2798                             ,input parameter-5-18
     2799                             ,input parameter-6-18
     2800                             ,input parameter-7-18
     2801                             )
     2802         .
     2803         assign
     2804           l-filter-open-18 = true
     2805         .
     2806       end.
     2807       if l-filter-open-18 = false then do:
     2808         message
     2809           "Ошибка при фильтрации / сортировке" skip
     2810           "Будут показаны записи без учета фильтра" skip
     2811           view-as alert-box .
     2812       end.
     2813       else do:
     2814           assign
     2815             l-query-was-opened = true
     2816           .
     2817       end.
     2818     end.
     2819     if l-filter-open-18 = false then do:
     2820       open query br-doc-lines for each buf_history
     2821         where  true
     2822         indexed-reposition
     2823     .
     2824         assign
     2825           l-query-was-opened = true
     2826         .
     2827     end.
     2828   end.
     2829   else do:
     2830     assign
     2831       doc-rec = recid( buf_history )
     2832     .
     2833     do
     2834     on stop undo, leave
     2835     on error undo, leave
     2836     :
     2837       if query br-doc-lines:handle:get-buffer-handle(1) = (buffer buf_history:handle) then do:
     2838         assign
     2839         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2840         parameter-4-18 =
     2841           "where ":u +  'true'  + " ":u + where-phrase-18 + " ":u + p-find-condition + " " + ""
     2842         parameter-5-18 = "  "
     2843       .
     2844         run fltopend_fltfindd in this-procedure  (
     2845                             input this-procedure:handle
     2846                             ,input query br-doc-lines:handle
     2847                             ,input rowid(buf_history)
     2848                             ,input logical(parameter-2-18)
     2849                             ,input no-lock
     2850                             ,input (buffer buf_history:handle)
     2851                             ,input parameter-4-18
     2852                             ,input parameter-5-18
     2853                             ) no-error.
     2854         .
     2855         assign
     2856           doc-rec = integer(return-value)
     2857           v-fltopend-rowid[1] = ?
     2858         .
     2859       end.
     2860       else do:
     2861         assign
     2862         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     2863         parameter-3-18 =  "FOR EACH buf_history"
     2864         parameter-4-18 =
     2865           (
     2866             if (" true " + " " + where-phrase-18) <> ""
     2867             then  'true'  + " " + where-phrase-18
     2868             else "true"
     2869           )
     2870         parameter-5-18 = (" " + "" + " " + "" + " " + p-find-condition)
     2871         parameter-6-18 = if sort-phrase-18 = ''
     2872                              then
     2873           (
     2874           " " + "  " +
     2875             " " + sort-column-phrase +
     2876           " " + "  "
     2877           )
     2878                              else
