     3599           "where ":u +                            substitute( '                           buf_history.doc-code  = &1&2&1 and                           buf_history.artic     = &1&3&1 and                           buf_history.prod-type = &1&4&1 and                           buf_history.prod-code = &5 '                           , chr(34)                           , p-doc-code                            , p-artic                               , p-prod-type                           , p-prod-code                           )                           + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3600         parameter-5-26 = "  "
     3601       .
     3602         run fltopend_fltfindd in this-procedure  (
     3603                             input this-procedure:handle
     3604                             ,input query br-doc-lines:handle
     3605                             ,input rowid(buf_history)
     3606                             ,input logical(parameter-2-26)
     3607                             ,input no-lock
     3608                             ,input (buffer buf_history:handle)
     3609                             ,input parameter-4-26
     3610                             ,input parameter-5-26
     3611                             ) no-error.
     3612         .
     3613         assign
     3614           doc-rec = integer(return-value)
     3615           v-fltopend-rowid[1] = ?
     3616         .
     3617       end.
     3618       else do:
     3619         assign
     3620         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3621         parameter-3-26 =  "FOR EACH buf_history"
     3622         parameter-4-26 =
     3623           (
     3624             if ("                           buf_history.doc-code  = p-doc-code  and                           buf_history.artic     = p-artic     and                           buf_history.prod-type = p-prod-type and                           buf_history.prod-code = p-prod-code                         " + " " + where-phrase-26) <> ""
     3625             then                            substitute( '                           buf_history.doc-code  = &1&2&1 and                           buf_history.artic     = &1&3&1 and                           buf_history.prod-type = &1&4&1 and                           buf_history.prod-code = &5 '                           , chr(34)                           , p-doc-code                            , p-artic                               , p-prod-type                           , p-prod-code                           )                           + " " + where-phrase-26
     3626             else "true"
     3627           )
     3628         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3629         parameter-6-26 = if sort-phrase-26 = ''
     3630                              then
     3631           (
     3632           " " + "  " +
     3633             " " + sort-column-phrase +
     3634           " " + "  "
     3635           )
     3636                              else
     3637           (
     3638           " " + "  " +
     3639             " " + sort-column-phrase +
     3640           " " + sort-phrase-26
     3641           )
     3642         parameter-7-26 =
     3643           " indexed-reposition  "
     3644       .
     3645         run fltopend_fltfindq in this-procedure  (
     3646                             input this-procedure:handle
     3647                             ,input query br-doc-lines:handle
     3648                             ,input logical(parameter-2-26)
     3649                             ,input no-lock
     3650                             ,input parameter-3-26
     3651                             ,input parameter-4-26
     3652                             ,input parameter-5-26
     3653                             ,input parameter-6-26
     3654                             ,input parameter-7-26
     3655                             ,output v-fltopend-rowid
     3656                             ) no-error.
     3657         .
     3658         doc-rec = ?.
     3659       end.
     3660       assign
     3661         l-query-was-opened = true
     3662       .
     3663     end.
     3664   end.
     3665     run waitfram-hide in this-procedure .
     3666       end.
     3667     end case.
     3668     if p-open-query <> yes then do: reposition br-doc-lines to recid doc-rec no-error. end.
     3669     run WaitFram-Hide in this-procedure.
     3670     apply "VALUE-CHANGED":U to br-doc-lines in frame fr-D-doc-line-0.
     3671     apply "ENTRY":U         to br-doc-lines in frame fr-D-doc-line-0.
     3672   end procedure.
     3673   procedure proc-filter :
     3674     assign tbl      = 'c-doc-line'
     3675            join-tbl = 'buf_history'
     3676            fld      = '':U
     3677            lab      = '':U
     3678            spr      = '':U
     3679            dim      = '0'.
     3680     run fltfield-add in this-procedure ( input 'fact-qnty',      input 'Факт кол-во',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3681     run fltfield-add in this-procedure ( input 'price-rubl',     input 'Цена (руб)',   input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3682     run fltfield-add in this-procedure ( input 'price-base',     input 'Цена (баз.вал)',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3683     run fltfield-add in this-procedure ( input 'price-cli',      input 'Цена пост. (вал)',     input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3684     run fltfield-add in this-procedure ( input 'unit-cli',       input 'Ед.изм.пост-ка',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3685     run fltfield-add in this-procedure ( input 'cli-qnty',       input 'По ТТН',               input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3686     run fltfield-add in this-procedure ( input 'doc-qnty',       input 'Кол-во по док-ту',     input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3687     run fltfield-add in this-procedure ( input 'obj-type',       input 'Тип объекта',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3688     run fltfield-add in this-procedure ( input 'obj-code',       input 'Код объекта учета',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3689     run fltfield-add in this-procedure ( input 'obj-type*obj-code',         input 'Объект',               input 'cli':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3690     run fltfield-add in this-procedure ( input 'prod-type',      input 'Тип производителя',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3691     run fltfield-add in this-procedure ( input 'prod-code',      input 'Код производителя',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3692     run fltfield-add in this-procedure ( input 'prod-type*prod-code',        input 'Производитель',        input 'cli':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3693     run fltfield-add in this-procedure ( input 'artic',          input 'Артикул',              input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3694     run fltfield-add in this-procedure ( input 'doc-code',       input 'Номер',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3695     run fltfield-add in this-procedure ( input 'cli-base-rate',  input 'Коэффициент',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3696     run fltfield-add in this-procedure ( input 'prt-root',       input 'root',                 input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3697     run fltfield-add in this-procedure ( input 'prt-OK',         input 'Шкала',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3698     run fltfield-add in this-procedure ( input 'VAT-pc',         input 'НДС',                  input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3699     run fltfield-add in this-procedure ( input 'status_',        input 'Статус',               input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3700     run fltfield-add in this-procedure ( input 'SLT-pc',         input 'Налог с продаж',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3701     run fltfield-add in this-procedure ( input 'line-num',       input 'Номер',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3702     run fltfield-add in this-procedure ( input 'wt-brutto',      input 'Вес брутто',           input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3703     run fltfield-add in this-procedure ( input 'num-place',      input 'Количество мест',      input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3704     run fltfield-add in this-procedure ( input 'road-tax',       input 'Дорожный налог',       input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3705     run fltfield-add in this-procedure ( input 'excise',         input 'Акциз',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3706     run fltfield-add in this-procedure ( input 'doc-density',    input 'Плотность',            input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3707     run fltfield-add in this-procedure ( input 'temperature',    input 'Температура',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3708     run fltfield-add in this-procedure ( input 'transport-base', input 'Трансп.(б.в.)',        input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3709     run fltfield-add in this-procedure ( input 'transport-rubl', input 'Трансп.(руб)', input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3710     run fltfield-add in this-procedure ( input 'other-base',     input 'Прочие (б.в.)',        input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3711     run fltfield-add in this-procedure ( input 'other-rubl',     input 'Прочие (руб)', input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3712     run fltfield-add in this-procedure ( input 'ext-doc-type',   input 'Расш.тип',             input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3713     run fltfield-add in this-procedure ( input 'fact-order',     input 'Факт-ордер',           input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3714     run fltfield-add in this-procedure ( input 'chip-num',       input 'Щепка',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3715     run fltfield-add in this-procedure ( input 'cons-vat-pc',    input 'НДС конс',             input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3716     run fltfield-add in this-procedure ( input 'cons-slt-pc',    input 'НП конс',              input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3717     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     3718        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     3719        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     3720       message "Неверная настройка на фильтры!" view-as alert-box error.
     3721       return no-apply.
     3722     end.
     3723     Filter-Block:
     3724     do on error   undo Filter-Block, leave Filter-Block
     3725        on end-key undo Filter-Block, leave Filter-Block :
     3726       run gbl/filter.w ( input ParParentProc,
     3727                      input filter-point,
     3728                      input tbl,
     3729                      input join-tbl,
     3730                      input fld,
     3731                      input lab,
     3732                      input spr,
     3733                      input dim            ).
     3734       if return-value = 'undo':U then do:
     3735         apply "ENTRY":U to browse br-doc-lines.
     3736         return no-apply.
     3737       end.
     3738       assign mark-num = 0
     3739              sch-num  = 0.
     3740       hide   mark-num in frame fr-D-doc-line-0.
     3741       hide   sch-num  in frame fr-D-doc-line-0.
     3742       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3743       assign b-sch :tooltip in frame fr-D-doc-line-0 = "Установить/снять фильтр".
     3744     end.
     3745   end procedure.
     3746   procedure proc-view-changes :
     3747     define buffer new_hist for ub.c-doc-line.
     3748     define buffer buf_srch for ub.doc-line.
     3749     define variable v-chg-fields as character no-undo.
     3750     define variable v-old-fields as character no-undo.
     3751     define variable v-new-fields as character no-undo.
     3752     define variable jj           as integer   no-undo.
     3753     for each temp-changes :
     3754       delete temp-changes.
     3755     end.
     3756     if not available buf_history then do:
     3757       run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     3758       return.
     3759     end.
     3760     find first new_hist no-lock where
     3761                new_hist.doc-code  = buf_history.doc-code  and
     3762                new_hist.artic     = buf_history.artic     and
     3763                new_hist.prod-type = buf_history.prod-type and
     3764                new_hist.prod-code = buf_history.prod-code and
     3765                new_hist.chip-num  > buf_history.chip-num  no-error.
     3766     if not available new_hist then do:
     3767       find first buf_srch no-lock where
     3768                  buf_srch.doc-code  = buf_history.doc-code  and
     3769                  buf_srch.artic     = buf_history.artic     and
     3770                  buf_srch.prod-type = buf_history.prod-type and
     3771                  buf_srch.prod-code = buf_history.prod-code no-error.
     3772       if not available buf_srch then do: return error. end.
     3773       buffer-compare buf_srch                 to buf_history save result in v-chg-fields.
     3774     end.
     3775     else do:
     3776       buffer-compare new_hist except chip-num to buf_history save result in v-chg-fields.
     3777     end.
     3778     do jj = 1 to num-entries( v-chg-fields ) :
     3779       case entry( jj, v-chg-fields ) :
     3780                     when "prod-type":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-type":U            temp-changes.l_name = "Тип производит."            temp-changes.v_old  = string( buf_history.prod-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-type )                                                          else string( buf_srch.prod-type ) ).   end.
     3781                     when "prod-code":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-code":U            temp-changes.l_name = "Код производит."            temp-changes.v_old  = string( buf_history.prod-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-code )                                                          else string( buf_srch.prod-code ) ).   end.
     3782                     when "artic":U then do:     create temp-changes.     assign temp-changes.f_name = "artic":U            temp-changes.l_name = "Артикул"            temp-changes.v_old  = string( buf_history.artic )            temp-changes.v_new  = ( if available new_hist then string( new_hist.artic )                                                          else string( buf_srch.artic ) ).   end.
     3783                     when "obj-type":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-type":U            temp-changes.l_name = "Тип объекта"            temp-changes.v_old  = string( buf_history.obj-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-type )                                                          else string( buf_srch.obj-type ) ).   end.
     3784                     when "obj-code":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-code":U            temp-changes.l_name = "Код объекта"            temp-changes.v_old  = string( buf_history.obj-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-code )                                                          else string( buf_srch.obj-code ) ).   end.
     3785                     when "cli-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "cli-qnty":U            temp-changes.l_name = "По ТТН"            temp-changes.v_old  = string( buf_history.cli-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.cli-qnty )                                                          else string( buf_srch.cli-qnty ) ).   end.
     3786                     when "fact-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "fact-qnty":U            temp-changes.l_name = "Факт количество"            temp-changes.v_old  = string( buf_history.fact-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.fact-qnty )                                                          else string( buf_srch.fact-qnty ) ).   end.
     3787                     when "doc-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-qnty":U            temp-changes.l_name = "Кол-во по док."            temp-changes.v_old  = string( buf_history.doc-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-qnty )                                                          else string( buf_srch.doc-qnty ) ).   end.
     3788                     when "doc-code":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-code":U            temp-changes.l_name = "Номер накладной"            temp-changes.v_old  = string( buf_history.doc-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-code )                                                          else string( buf_srch.doc-code ) ).   end.
     3789                     when "price-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "price-rubl":U            temp-changes.l_name = "Цена (руб)"            temp-changes.v_old  = string( buf_history.price-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.price-rubl )                                                          else string( buf_srch.price-rubl ) ).   end.
     3790                     when "price-base":U then do:     create temp-changes.     assign temp-changes.f_name = "price-base":U            temp-changes.l_name = "Цена (баз.вал.)"            temp-changes.v_old  = string( buf_history.price-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.price-base )                                                          else string( buf_srch.price-base ) ).   end.
     3791                     when "price-cli":U then do:     create temp-changes.     assign temp-changes.f_name = "price-cli":U            temp-changes.l_name = "Цена пост.(б.в)"            temp-changes.v_old  = string( buf_history.price-cli )            temp-changes.v_new  = ( if available new_hist then string( new_hist.price-cli )                                                          else string( buf_srch.price-cli ) ).   end.
     3792                     when "unit-cli":U then do:     create temp-changes.     assign temp-changes.f_name = "unit-cli":U            temp-changes.l_name = "Ед.изм.пост-ка"            temp-changes.v_old  = string( buf_history.unit-cli )            temp-changes.v_new  = ( if available new_hist then string( new_hist.unit-cli )                                                          else string( buf_srch.unit-cli ) ).   end.
     3793                     when "cli-base-rate":U then do:     create temp-changes.     assign temp-changes.f_name = "cli-base-rate":U            temp-changes.l_name = "Коэффициент"            temp-changes.v_old  = string( buf_history.cli-base-rate )            temp-changes.v_new  = ( if available new_hist then string( new_hist.cli-base-rate )                                                          else string( buf_srch.cli-base-rate ) ).   end.
     3794                     when "prt-root":U then do:     create temp-changes.     assign temp-changes.f_name = "prt-root":U            temp-changes.l_name = "Корень"            temp-changes.v_old  = string( buf_history.prt-root )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prt-root )                                                          else string( buf_srch.prt-root ) ).   end.
     3795                     when "prt-OK":U then do:     create temp-changes.     assign temp-changes.f_name = "prt-OK":U            temp-changes.l_name = "Шкала"            temp-changes.v_old  = string( buf_history.prt-OK )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prt-OK )                                                          else string( buf_srch.prt-OK ) ).   end.
     3796                     when "VAT-pc":U then do:     create temp-changes.     assign temp-changes.f_name = "VAT-pc":U            temp-changes.l_name = "НДС"            temp-changes.v_old  = string( buf_history.VAT-pc )            temp-changes.v_new  = ( if available new_hist then string( new_hist.VAT-pc )                                                          else string( buf_srch.VAT-pc ) ).   end.
     3797                     when "status_":U then do:     create temp-changes.     assign temp-changes.f_name = "status_":U            temp-changes.l_name = "Статус"            temp-changes.v_old  = string( buf_history.status_ )            temp-changes.v_new  = ( if available new_hist then string( new_hist.status_ )                                                          else string( buf_srch.status_ ) ).   end.
     3798                     when "SLT-pc":U then do:     create temp-changes.     assign temp-changes.f_name = "SLT-pc":U            temp-changes.l_name = "Налог с продаж"            temp-changes.v_old  = string( buf_history.SLT-pc )            temp-changes.v_new  = ( if available new_hist then string( new_hist.SLT-pc )                                                          else string( buf_srch.SLT-pc ) ).   end.
     3799                     when "line-num":U then do:     create temp-changes.     assign temp-changes.f_name = "line-num":U            temp-changes.l_name = "Номер"            temp-changes.v_old  = string( buf_history.line-num )            temp-changes.v_new  = ( if available new_hist then string( new_hist.line-num )                                                          else string( buf_srch.line-num ) ).   end.
     3800                     when "wt-brutto":U then do:     create temp-changes.     assign temp-changes.f_name = "wt-brutto":U            temp-changes.l_name = "Вес брутто"            temp-changes.v_old  = string( buf_history.wt-brutto )            temp-changes.v_new  = ( if available new_hist then string( new_hist.wt-brutto )                                                          else string( buf_srch.wt-brutto ) ).   end.
     3801                     when "num-place":U then do:     create temp-changes.     assign temp-changes.f_name = "num-place":U            temp-changes.l_name = "Кол-во мест"            temp-changes.v_old  = string( buf_history.num-place )            temp-changes.v_new  = ( if available new_hist then string( new_hist.num-place )                                                          else string( buf_srch.num-place ) ).   end.
     3802                     when "road-tax":U then do:     create temp-changes.     assign temp-changes.f_name = "road-tax":U            temp-changes.l_name = "Дор. налог"            temp-changes.v_old  = string( buf_history.road-tax )            temp-changes.v_new  = ( if available new_hist then string( new_hist.road-tax )                                                          else string( buf_srch.road-tax ) ).   end.
     3803                     when "excise":U then do:     create temp-changes.     assign temp-changes.f_name = "excise":U            temp-changes.l_name = "Акциз"            temp-changes.v_old  = string( buf_history.excise )            temp-changes.v_new  = ( if available new_hist then string( new_hist.excise )                                                          else string( buf_srch.excise ) ).   end.
     3804                     when "doc-density":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-density":U            temp-changes.l_name = "Плотность"            temp-changes.v_old  = string( buf_history.doc-density )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-density )                                                          else string( buf_srch.doc-density ) ).   end.
     3805                     when "temperature":U then do:     create temp-changes.     assign temp-changes.f_name = "temperature":U            temp-changes.l_name = "Температура"            temp-changes.v_old  = string( buf_history.temperature )            temp-changes.v_new  = ( if available new_hist then string( new_hist.temperature )                                                          else string( buf_srch.temperature ) ).   end.
     3806                     when "transport-base":U then do:     create temp-changes.     assign temp-changes.f_name = "transport-base":U            temp-changes.l_name = "Трансп.(б.в.)"            temp-changes.v_old  = string( buf_history.transport-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.transport-base )                                                          else string( buf_srch.transport-base ) ).   end.
     3807                     when "transport-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "transport-rubl":U            temp-changes.l_name = "Трансп.(руб)"            temp-changes.v_old  = string( buf_history.transport-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.transport-rubl )                                                          else string( buf_srch.transport-rubl ) ).   end.
     3808                     when "other-base":U then do:     create temp-changes.     assign temp-changes.f_name = "other-base":U            temp-changes.l_name = "Прочие (б.в.)"            temp-changes.v_old  = string( buf_history.other-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.other-base )                                                          else string( buf_srch.other-base ) ).   end.
     3809                     when "other-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "other-rubl":U            temp-changes.l_name = "Прочие (руб)"            temp-changes.v_old  = string( buf_history.other-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.other-rubl )                                                          else string( buf_srch.other-rubl ) ).   end.
     3810                     when "ext-doc-type":U then do:     create temp-changes.     assign temp-changes.f_name = "ext-doc-type":U            temp-changes.l_name = "Расш.тип"            temp-changes.v_old  = string( buf_history.ext-doc-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.ext-doc-type )                                                          else string( buf_srch.ext-doc-type ) ).   end.
     3811                     when "fact-order":U then do:     create temp-changes.     assign temp-changes.f_name = "fact-order":U            temp-changes.l_name = "Факт-ордер"            temp-changes.v_old  = string( buf_history.fact-order )            temp-changes.v_new  = ( if available new_hist then string( new_hist.fact-order )                                                          else string( buf_srch.fact-order ) ).   end.
     3812                     when "cons-vat-pc":U then do:     create temp-changes.     assign temp-changes.f_name = "cons-vat-pc":U            temp-changes.l_name = "НДС конс"            temp-changes.v_old  = string( buf_history.cons-vat-pc )            temp-changes.v_new  = ( if available new_hist then string( new_hist.cons-vat-pc )                                                          else string( buf_srch.cons-vat-pc ) ).   end.
     3813                     when "cons-slt-pc":U then do:     create temp-changes.     assign temp-changes.f_name = "cons-slt-pc":U            temp-changes.l_name = "НП конс"            temp-changes.v_old  = string( buf_history.cons-slt-pc )            temp-changes.v_new  = ( if available new_hist then string( new_hist.cons-slt-pc )                                                          else string( buf_srch.cons-slt-pc ) ).   end.
     3814       end case.
     3815     end.
     3816     run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     3817   end procedure.
     3818   procedure OpenChanges :
     3819     define input parameter p-open-query     as logical   no-undo.
     3820     define input parameter p-find-next      as logical   no-undo.
     3821     define input parameter p-find-condition as character no-undo.
     3822     define variable l-query-was-opened as logical   no-undo.
     3823     define variable sort-change-phrase as character no-undo.
     3824     define variable l-open-query       as logical   no-undo.
     3825     define variable p-proc-hand        as handle    no-undo.
     3826     ASSIGN p-proc-hand = this-procedure :handle.
     3827      open query br-changes for each buf_changes .
     3828     if p-open-query <> yes then do: reposition br-doc-lines to recid doc-rec no-error. end.
     3829     run WaitFram-Hide in this-procedure.
     3830   end procedure.
     3831   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3832   procedure set-filter-name :
     3833   define input parameter p-filter-name as character no-undo .
     3834     do with frame fr-D-doc-line-0:
     3835       if p-filter-name > "" then do:
     3836         assign
     3837           frame fr-D-doc-line-0:title
     3838             = frame fr-D-doc-line-0:title + "   ФИЛЬТР: " + p-filter-name.
     3839         .
     3840         assign
     3841           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3842         .
     3843       end.
     3844       else do:
     3845         assign
     3846           b-sch :tooltip = ""
     3847         .
     3848       end.
     3849     end.
     3850   end procedure.
     3851   procedure proc-find-doc :
     3852     define input parameter p-next as logical   no-undo.
     3853     define input parameter p-code as character no-undo.
     3854     assign p-code = replace( p-code, chr(34), chr(34) + chr(34) )
     3855            p-code = replace( p-code, chr(39), chr(39) + chr(39) )
     3856            p-code = chr(34) + p-code + chr(34).
     3857     run OpenBr in this-procedure ( input no,
     3858                                    input p-next,
     3859                                    input substitute( " and buf_history.doc-code begins &1 ", p-code ) ).
     3860     if doc-rec <> ? then do:
     3861       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     3862       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     3863       assign  sch-num = sch-num + 1.
     3864       display sch-num with frame fr-D-doc-line-0.
     3865     end.
     3866     else do:
     3867       assign  sch-num = 0.
     3868       hide    sch-num in frame fr-D-doc-line-0.
     3869     end.
     3870     apply "ENTRY":U to sch-doc in frame fr-D-doc-line-0.
     3871   end procedure.
     3872   procedure proc-find-gds :
     3873     define input parameter p-next  as logical   no-undo.
     3874     define input parameter p-artic as character no-undo.
     3875     assign p-artic = replace( p-artic, chr(34), chr(34) + chr(34) )
     3876            p-artic = replace( p-artic, chr(39), chr(39) + chr(39) )
     3877            p-artic = chr(34) + p-artic + chr(34).
     3878     run OpenBr in this-procedure ( input no,
     3879                                    input p-next,
     3880                                    input substitute( " and buf_history.artic begins &1 ", p-artic ) ).
     3881     if doc-rec <> ? then do:
     3882       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     3883       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     3884       assign  sch-num = sch-num + 1.
     3885       display sch-num with frame fr-D-doc-line-0.
     3886     end.
     3887     else do:
     3888       assign  sch-num = 0.
     3889       hide    sch-num in frame fr-D-doc-line-0.
     3890     end.
     3891     apply "ENTRY":U to sch-gds in frame fr-D-doc-line-0.
     3892   end procedure.
     3893   procedure get-mark-string :
     3894     define        parameter buffer loc-buf for ub.c-doc-line.
     3895     define output parameter        p-sign  as  character no-undo.
     3896     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3897   end procedure.
     3898   procedure get-obj-short-name :
     3899     define  input parameter p-type as character no-undo.
     3900     define  input parameter p-code as integer   no-undo.
     3901     define output parameter p-name as character no-undo.
     3902     assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     3903   end procedure.
     3904   procedure get-obj-full-name :
     3905     define  input parameter p-type as character no-undo.
     3906     define  input parameter p-code as integer   no-undo.
     3907     define output parameter p-name as character no-undo.
     3908     define buffer buf_clients for ub.clients.
     3909     find buf_clients no-lock where
     3910          buf_clients.obj-type = p-type and
     3911          buf_clients.obj-code = p-code no-error.
     3912     assign p-name = ( if available buf_clients then buf_clients.obj-name else "":U ).
     3913   end procedure.
     3914   procedure get-goods-name :
     3915     define        parameter buffer loc-buf for ub.c-doc-line.
     3916     define output parameter        p-name  as  character no-undo.
     3917     define buffer buf_goods for ub.goods.
     3918     find first buf_goods no-lock where
     3919                buf_goods.artic     = loc-buf.artic     and
     3920                buf_goods.prod-type = loc-buf.prod-type and
     3921                buf_goods.prod-code = loc-buf.prod-code no-error.
     3922     assign p-name = ( if available buf_goods then buf_goods.gds-name else "":U ).
     3923   end procedure.
     3924   procedure get-gds-eng-name :
     3925     define        parameter buffer loc-buf for ub.c-doc-line.
     3926     define output parameter        p-name  as  character no-undo.
     3927     define buffer buf_goods for ub.goods.
     3928     find first buf_goods no-lock where
     3929                buf_goods.artic     = loc-buf.artic     and
     3930                buf_goods.prod-type = loc-buf.prod-type and
     3931                buf_goods.prod-code = loc-buf.prod-code no-error.
     3932     assign p-name = ( if available buf_goods then buf_goods.engl-name else "":U ).
     3933   end procedure.
     3934   procedure get-gds-unit-base :
     3935     define        parameter buffer loc-buf for ub.c-doc-line.
     3936     define output parameter        p-name  as  character no-undo.
     3937     define buffer buf_goods for ub.goods.
     3938     find first buf_goods no-lock where
     3939                buf_goods.artic     = loc-buf.artic     and
     3940                buf_goods.prod-type = loc-buf.prod-type and
     3941                buf_goods.prod-code = loc-buf.prod-code no-error.
     3942     assign p-name = ( if available buf_goods then buf_goods.unit-base else "":U ).
     3943   end procedure.
     3944   procedure get-sale-price :
     3945     define        parameter buffer loc-buf for ub.c-doc-line.
     3946     define output parameter        p-price as  decimal no-undo initial 0.
     3947     define buffer buf_gds-dtl for ub.c-gds-dtl.
     3948     for each buf_gds-dtl no-lock where
     3949              buf_gds-dtl.chip-num  = loc-buf.chip-num  and
     3950              buf_gds-dtl.doc-code  = loc-buf.doc-code  and
     3951              buf_gds-dtl.artic     = loc-buf.artic     and
     3952              buf_gds-dtl.prod-type = loc-buf.prod-type and
     3953              buf_gds-dtl.prod-code = loc-buf.prod-code :
     3954       assign p-price = p-price + ( if varr-b = "rubl":U then buf_gds-dtl.price-rubl else buf_gds-dtl.price-base ).
     3955     end.
     3956   end procedure.
     3957   procedure get-per-cent :
     3958     define        parameter buffer loc-buf for ub.c-doc-line.
     3959     define output parameter        p-prc   as  decimal no-undo initial 0.
     3960     define variable d_price as decimal no-undo initial 0.
     3961     assign d_price = ( if varr-b = 'rubl':U then loc-buf.price-rubl else loc-buf.price-base )
     3962            p-prc   = ( sale-price( buffer buf_history ) - d_price ) * 100 / d_price.
     3963   end procedure.
     3964   procedure get-gds-scale :
     3965     define        parameter buffer loc-buf for ub.c-doc-line.
     3966     define output parameter        p-scale as  character no-undo.
     3967     define buffer buf_goods   for ub.goods.
     3968     define buffer buf_gds-prt for ub.gds-prt.
     3969     define buffer buf_gds-dtl for ub.c-gds-dtl.
     3970     find first buf_goods no-lock where
     3971                buf_goods.artic     = loc-buf.artic     and
     3972                buf_goods.prod-type = loc-buf.prod-type and
     3973                buf_goods.prod-code = loc-buf.prod-code no-error.
     3974     if available buf_goods then do:
     3975       find first buf_gds-prt no-lock where
     3976                  buf_gds-prt.upper-code = buf_goods.prt-root no-error.
     3977       if available buf_gds-prt then do:
     3978         assign p-scale = ( if buf_gds-prt.node-name = '_Пустая шкала':U then '-' else
     3979                          ( if can-find( first buf_gds-dtl no-lock where
     3980                                               buf_gds-dtl.doc-code  = loc-buf.doc-code      and
     3981                                               buf_gds-dtl.artic     = loc-buf.artic         and
     3982                                               buf_gds-dtl.prod-type = loc-buf.prod-type     and
     3983                                               buf_gds-dtl.prod-code = loc-buf.prod-code     and
     3984                                               buf_gds-dtl.prt-code  = buf_gds-prt.node-code and
     3985                                               buf_gds-dtl.chip-num  = loc-buf.chip-num )
     3986                            then '--------------------' else buf_gds-prt.node-name ) ).
     3987       end.
     3988     end.
     3989   end procedure.
     3990   procedure get-ext-type :
     3991     define  input parameter p-type as character no-undo.
     3992     define output parameter p-name as character no-undo.
     3993     define variable jndex as integer no-undo.
     3994     assign jndex  = lookup( p-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ).
     3995     assign p-name = ( if jndex = 0 then "":U else entry( jndex, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) ).
     3996   end procedure.
