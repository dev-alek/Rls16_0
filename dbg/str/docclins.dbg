     2882           " " + sort-phrase-18
     2883           )
     2884         parameter-7-18 =
     2885           " indexed-reposition  "
     2886       .
     2887         run fltopend_fltfindq in this-procedure  (
     2888                             input this-procedure:handle
     2889                             ,input query br-doc-lines:handle
     2890                             ,input logical(parameter-2-18)
     2891                             ,input no-lock
     2892                             ,input parameter-3-18
     2893                             ,input parameter-4-18
     2894                             ,input parameter-5-18
     2895                             ,input parameter-6-18
     2896                             ,input parameter-7-18
     2897                             ,output v-fltopend-rowid
     2898                             ) no-error.
     2899         .
     2900         doc-rec = ?.
     2901       end.
     2902       assign
     2903         l-query-was-opened = true
     2904       .
     2905     end.
     2906   end.
     2907     run waitfram-hide in this-procedure .
     2908       end.
     2909       when 'obj':U then do:
     2910         assign frame fr-D-doc-line-0 :title = title0 +
     2911           substitute( 'строк документов по объекту &1 &2 "&3"',
     2912                       p-obj-type, p-obj-code, obj-name( p-obj-type, p-obj-code ) ).
