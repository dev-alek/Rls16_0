        1   define input        parameter ParParentProc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-obj-type    as character     no-undo.
        5   define input        parameter p-obj-code    as integer       no-undo.
        6   define input        parameter p-doc-code    as character     no-undo.
        7   define input        parameter p-artic       as character     no-undo.
        8   define input        parameter p-prod-type   as character     no-undo.
        9   define input        parameter p-prod-code   as integer       no-undo.
       10   define input-output parameter p-rid-list    as character     no-undo.
       11   define variable vss-revision    as character no-undo initial "$Revision$":U.
       12   define variable vss-author      as character no-undo initial "$Author$":U.
       13   define variable vss-date        as character no-undo initial "$Date$":U.
       14   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       15   define variable vss-archive     as character no-undo initial "$Archive$":U.
       16   define variable vss-description as character no-undo initial "История строк документов":U.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable c-point  as character no-undo .
      124   define variable tbl      as character no-undo .
      125   define variable join-tbl as character no-undo .
      126   define variable fld      as character no-undo .
      127   define variable lab      as character no-undo .
      128   define variable spr      as character no-undo .
      129   define variable dim      as character no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable v-waitfram-action01         as character   no-undo .
      132   define variable v-waitfram-action02         as character   no-undo .
      133   define variable v-waitfram-action03         as character   no-undo .
      134   define variable mWaitFramTextBeg            as character   no-undo.
      135   define variable mWaitFramTextEnd            as character   no-undo.
      136   define variable mWaitFramView               as logical     no-undo.
      137   define variable mWaitProcEvent              as logical     no-undo init yes.
      138   define variable mWaitFramInterval           as integer     no-undo init 1 .
      139   define variable mWaitFramStop               as logical     no-undo.
      140   define variable mWaitFramStopUser           as logical     no-undo.
      141   define variable mWaitFramStopTimeOut        as logical     no-undo.
      142   define variable mWaitFramStartProc          as datetime-tz no-undo.
      143   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      144   define button B-WaitFramStop auto-end-key
      145        label "Стоп"
      146        size 10 by 1 tooltip "Остоновить процесс".
      147   define button B-viewProcInfo
      148        label "Информация"
      149        size 15 by 1 tooltip "Информация о процесс".
      150   define frame waitfram
      151     v-waitfram-action01 format "x(72)" no-label skip
      152     v-waitfram-action02 format "x(72)" no-label skip
      153     v-waitfram-action03 format "x(72)" no-label skip
      154     B-viewProcInfo
      155     B-WaitFramStop at row 4 col 30
      156     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      157     .
      158   define new global shared variable mBatchMode as logical no-undo init ?.
      159   define variable mFramBachModHandle as handle no-undo.
      160   mFramBachModHandle = frame waitfram:handle.
      161   define variable mFameOldVis as logical no-undo.
      162   define variable mVisCUrentVin as logical no-undo.
      163   if session:batch-mode
      164   then
      165      mBatchMode = yes.
      166   if mBatchMode = ? then do:
      167     mVisCUrentVin = current-window:visible.
      168     mFameOldVis = mFramBachModHandle:visible.
      169     mFramBachModHandle:visible  = yes.
      170     mBatchMode = mFramBachModHandle:visible ne yes.
      171     mFramBachModHandle:visible = mFameOldVis.
      172     current-window:visible = mVisCUrentVin.
      173   end.
      174    if  log-manager:logfile-name ne ?
      175     then DO:
      176         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      177         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      178         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      179     end.
      180   on choose of B-WaitFramStop in frame waitfram
      181   do:
      182     mWaitFramStop = yes.
      183     mWaitFramStopUser = yes.
      184   end.
      185   function waitfram-check-timeout returns logical():
      186      define variable vtime as int64 no-undo.
      187      if mWaitFramStopTimeOut
      188      then
      189         return yes.
      190      vtime = ( now - mWaitFramStartProc ) / 1000 .
      191      if     mWaitFramTimeOut ne ?
      192         and mWaitFramTimeOut ne 0
      193         and mWaitFramTimeOut lt vtime
      194      then do:
      195         mWaitFramStopTimeOut = yes.
      196      end.
      197      return mWaitFramStopTimeOut.
      198   end.
      199   procedure waitfram-hide :
      200     if not session:batch-mode
      201     then do
      202     on error undo, return error return-value
      203     :
      204       pause 0 before-hide .
      205       if not mBatchMode then
      206         hide frame waitfram .
      207     if     not mWaitFramView
      208        and mWaitProcEvent
      209     then
      210       process events .
      211     end.
      212   end procedure.
      213   procedure waitfram-show :
      214     define input  parameter p-message as character no-undo .
      215     define variable v-left-margin as integer   no-undo .
      216     if not session:batch-mode
      217     then do
      218     on error undo, return error return-value
      219     :
      220       if length(p-message) <= 70 then do:
      221         assign
      222           v-left-margin = integer((70 - length(p-message)) / 2)
      223         .
      224         assign
      225           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      226         .
      227         assign
      228           v-waitfram-action01 = " "
      229           v-waitfram-action02 = " "
      230                                    + fill(" ", v-left-margin)
      231                                    + p-message
      232           v-waitfram-action03 = " "
      233         .
      234       end.
      235       else do:
      236         define variable vRindex1 as integer no-undo.
      237         define variable vRindex2 as integer no-undo.
      238         vRindex1 = r-index(p-message," ",70).
      239         if vRindex1 = 0
      240         then
      241            vRindex1 = 70.
      242         if length(p-message)  <= vRindex1 + 70 then do:
      243           assign
      244             v-waitfram-action01 = " "
      245             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      246             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      247           .
      248         end.
      249         else do:
      250           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      251           if vRindex2 <= vRindex1
      252           then
      253              vRindex2 = vRindex1 + 70.
      254           assign
      255             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      256             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      257             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      258           .
      259         end.
      260       end.
      261       B-viewProcInfo:visible   in frame waitfram = no.
      262       B-viewProcInfo:sensitive in frame waitfram = no.
      263       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       if  (   mWaitFramView
      266          or  mWaitProcEvent)
      267          and not mBatchMode
      268       then
      269          display
      270             v-waitfram-action01 skip
      271             v-waitfram-action02 skip
      272             v-waitfram-action03 skip
      273          with frame waitfram .
      274       if     mWaitFramView
      275          then do:
      276             if     mWaitFramInterval ne ?
      277                and not mBatchMode
      278             then
      279                wait-for go of frame waitfram pause mWaitFramInterval.
      280          end.
      281          else
      282             if     mWaitProcEvent
      283                and not mBatchMode
      284             then
      285                process events .
      286     end.
      287   end procedure.
      288      procedure waitfram-show-this:
      289         define input  parameter iInterval as int64 no-undo.
      290         define variable vtime as int64 no-undo.
      291         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      292         mWaitFramInterval = iInterval.
      293         run waitfram-show (substitute("&1&2 &3&4" ,
      294                                       mWaitFramTextBeg ,
      295                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      296                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      297                                       mWaitFramTextEnd
      298                                      )
      299                           ).
      300      end.
      301      procedure WaitFramRunPause:
      302         define input  parameter iInterval as dec no-undo.
      303         define variable vStart  as datetime-tz no-undo.
      304         define variable vend    as datetime-tz no-undo.
      305         define variable vint as int64 no-undo.
      306         define variable vOk as logical no-undo.
      307         vStart = now.
      308         vend   = vStart.
      309         publish "WaitFramPause" (iInterval,output vOk).
      310         vend   =  now.
      311         vint = vend - vStart.
      312         vint = iInterval - vint / 1000.
      313         if     not mWaitFramStop
      314            and (   vint > 0
      315                 or (    not vOk
      316                     and iInterval eq ?
      317                     )
      318                 )
      319         then
      320            run waitfram-show-this (iInterval).
      321         vend   =  now.
      322         vint = vend - vStart.
      323         vint = iInterval - vint / 1000.
      324         if     not mWaitFramStop
      325            and vint > 0
      326         then do:
      327            run gbl/pause.p (vint * 1000).
      328         end.
      329         if iInterval ne ?
      330         then
      331            publish "WaitFramStop".
      332         waitfram-check-timeout().
      333      end.
      334      procedure WaitFramWaitFor:
      335         define input  parameter iInterval as dec no-undo.
      336         assign
      337            mWaitFramStartProc   = now
      338            mWaitFramStopUser    = no
      339            mWaitFramStopTimeOut = no
      340         .
      341         block-wait:
      342         do while not mWaitFramStop:
      343            run WaitFramRunPause (iInterval).
      344            if  waitfram-check-timeout()
      345            then do:
      346               leave block-wait.
      347            end.
      348         end.
      349         run waitfram-hide.
      350      end.
      351   procedure waitfram-join :
      352     define input  parameter p-line-1  as character no-undo .
      353     define input  parameter p-line-2  as character no-undo .
      354     define input  parameter p-line-3  as character no-undo .
      355     define output parameter p-message as character no-undo .
      356     do
      357     on error undo, return error return-value
      358     :
      359       assign
      360         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      363       .
      364     end.
      365   end procedure.
      366   function waitfram-join-function returns character
      367     (input p-line-1 as character
      368     ,input p-line-2 as character
      369     ,input p-line-3 as character
      370     ).
      371     define variable v-message as character no-undo .
      372     run waitfram-join in this-procedure
      373       (input  p-line-1
      374       ,input  p-line-2
      375       ,input  p-line-3
      376       ,output v-message
      377       ) .
      378     return v-message .
      379   end function .
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure fltfield-clear :
      382     define output parameter loc-fld as character no-undo.
      383     define output parameter loc-lab as character no-undo .
      384     define output parameter loc-spr as character no-undo .
      385     define output parameter loc-dim as character no-undo .
      386     assign
      387       loc-fld = ""
      388       loc-lab = ""
      389       loc-spr = ""
      390       loc-dim = "0"
      391     .
      392   end procedure .
      393   procedure fltfield-add :
      394     define input        parameter par-fld as character no-undo.
      395     define input        parameter par-lab as character no-undo .
      396     define input        parameter par-spr as character no-undo .
      397     define input-output parameter loc-fld as character no-undo.
      398     define input-output parameter loc-lab as character no-undo .
      399     define input-output parameter loc-spr as character no-undo .
      400     define input-output parameter loc-dim as character no-undo .
      401     do
      402     on error undo, return error
      403     :
      404       assign
      405       loc-fld = if loc-dim = '0'
      406                 then par-fld
      407                 else (loc-fld + chr(44) + par-fld)
      408       loc-lab = if loc-dim = '0'
      409                 then par-lab
      410                 else (loc-lab + chr(44) + par-lab)
      411       loc-spr = if loc-dim = '0'
      412                 then par-spr
      413                 else (loc-spr + chr(44) + par-spr)
      414       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      415                 string(integer(if num-entries(loc-dim) > 1
      416                               then entry(2, loc-dim)
      417                               else entry(1, loc-dim)
      418                               ) + 1)
      419       no-error
      420       .
      421     end.
      422   end procedure.
      423   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      424   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      425     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      426     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      427     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      428   END FUNCTION.
      429   PROCEDURE conv-rec-to-char :
      430     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      431     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      432     DO ON ERROR UNDO, RETURN ERROR :
      433       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      434     END.
      435   END PROCEDURE.
      436   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   define NEW SHARED temp-table temp-changes no-undo
      438   field f_name as character
      439   field l_name as character
      440   field v_old as character
      441   field v_new as character
      442   field t_name as character
      443   field num_ as integer
      444   field uniq-key-rec as character
      445   field action as integer
      446   field fNotChange as logical
      447   index pi is unique primary
      448   num_
      449   t_name
      450   f_name
      451   index
      452   Chan
      453   fnotChange
      454   t_name
      455   f_name
      456   index imain uniq-key-rec
      457   .
      458   FUNCTION get-all-fields returns character (p-file-name as character ):
      459   define variable v-dop as character no-undo .
      460     find first _file no-lock where _file._file-name = p-file-name no-error .
      461     if not available _file then return "":U.
      462     for each _field no-lock where
      463              _field._file-recid = recid(_file) :
      464       assign
      465       v-dop = v-dop + _field._field-name + chr(44)
      466       .
      467     end.
      468     return trim(v-dop).
      469   END FUNCTION.
      470   PROCEDURE proc-full-temp-changes :
      471     define input  parameter p-hst-handle as handle    no-undo .
      472     define input  parameter p-main-table as character no-undo .
      473     define input  parameter p-field-list as character no-undo .
      474     define input  parameter p-label-form as character no-undo .
      475     define variable h-new-buf         as handle    no-undo .
      476     define variable h-main-buf        as handle    no-undo .
      477     define variable h-for-comp        as handle    no-undo .
      478     define variable v-inform          as character no-undo .
      479     define variable v-ind             as integer   no-undo .
      480     define variable v-idx-field-qnty  as integer   no-undo .
      481     define variable v-num-entries     as integer   no-undo .
      482     define variable fh                as handle    no-undo .
      483     define variable fh-main           as handle    no-undo .
      484     define variable fh-old            as handle    no-undo .
      485     define variable fh-new            as handle    no-undo .
      486     define variable v-field-name      as character no-undo .
      487     define variable v-field-lvl       as character no-undo .
      488     define variable v-field-form      as character no-undo .
      489     define variable v-search-exp      as character no-undo .
      490     define variable v-srch-main       as character no-undo .
      491     define variable v-word-link       as character no-undo .
      492     define variable v-av-chip-num     as logical   no-undo .
      493     define variable v-main-pi-fld-lst as character no-undo .
      494     define variable v-main-fld-lst    as character no-undo .
      495     define variable v-delim-list      as character no-undo .
      496     define variable v-label           as character no-undo .
      497     define variable v-old-value       as character no-undo case-sensitive.
      498     define variable v-new-value       as character no-undo case-sensitive.
      499     define variable v-chg-fields as character no-undo.
      500     for each temp-changes:
      501       delete temp-changes.
      502     end.
      503     if not p-hst-handle:available then do:
      504       return .
      505     end.
      506     create buffer h-new-buf  for table p-hst-handle .
      507     create buffer h-main-buf for table p-main-table .
      508     assign
      509       v-inform = h-main-buf:index-information(1)
      510       v-ind    = 2
      511     .
      512     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      513     on error undo, return error
      514     :
      515       assign
      516         v-inform = h-main-buf:index-information( v-ind )
      517         v-ind    = v-ind + 1
      518       .
      519     end.
      520     if v-inform = ?
      521       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      522       or entry( 3, v-inform, ",":U ) <> "1":U
      523     then do:
      524       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      525     end.
      526     assign
      527       v-idx-field-qnty = num-entries( v-inform ) - 4
      528     .
      529     if v-idx-field-qnty < 2 then do:
      530       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      531     end.
      532     assign
      533       v-srch-main   = "where":U
      534       v-word-link   = "":U
      535       v-av-chip-num = false
      536       v-delim-list  = "":U
      537     .
      538     do v-ind = 1 to v-idx-field-qnty by 2
      539     on error undo, return error
      540     :
      541       assign
      542         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      543         fh                = p-hst-handle:buffer-field( v-field-name )
      544         fh-main           = h-main-buf:buffer-field( v-field-name )
      545         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      546         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      547       .
      548       if fh:data-type ="character":U then do:
      549         assign
      550           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      551         .
      552       end.
      553       else do:
      554         assign
      555           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      556         .
      557       end.
      558       if v-delim-list = "":U then do:
      559         assign
      560           v-delim-list = ",":U
      561         .
      562       end.
      563       if v-word-link = "":U then do:
      564         assign
      565           v-word-link = "and":U
      566         .
      567       end.
      568     end.
      569     assign
      570       v-delim-list  = "":U
      571     .
      572     do v-ind = 1 to h-main-buf:num-fields
      573     on error undo, return error
      574     :
      575       assign
      576         fh-main      = h-main-buf:buffer-field( v-ind )
      577         v-field-name = fh-main:name
      578       .
      579         assign
      580           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      581         .
      582         if v-delim-list = "":U then do:
      583           assign
      584             v-delim-list = ",":U
      585           .
      586         end.
      587     end.
      588     assign
      589       v-inform = p-hst-handle:index-information(1)
      590       v-ind    = 2
      591     .
      592     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      593     on error undo, return error
      594     :
      595       assign
      596         v-inform = p-hst-handle:index-information( v-ind )
      597         v-ind    = v-ind + 1
      598       .
      599     end.
      600     if v-inform = ?
      601       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      602       or entry( 3, v-inform, ",":U ) <> "1":U
      603     then do:
      604       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      605     end.
      606     assign
      607       v-idx-field-qnty = num-entries( v-inform ) - 4
      608     .
      609     if v-idx-field-qnty < 2 then do:
      610       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      611     end.
      612     assign
      613       v-search-exp  = "where":U
      614       v-word-link   = "":U
      615       v-av-chip-num = false
      616     .
      617     do v-ind = 1 to v-idx-field-qnty by 2
      618     on error undo, return error
      619     :
      620       assign
      621         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      622         fh           = p-hst-handle:buffer-field( v-field-name )
      623         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      624       .
      625       if v-field-name = "chip-num":U then do:
      626         assign
      627           v-search-exp  = substitute( "&1 >", v-search-exp )
      628           v-av-chip-num = true
      629         .
      630       end.
      631       else do:
      632         assign
      633           v-search-exp = substitute( "&1 =", v-search-exp )
      634         .
      635       end.
      636       if fh:data-type ="character":U then do:
      637         assign
      638           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      639         .
      640       end.
      641       else do:
      642         assign
      643           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      644         .
      645       end.
      646       if v-word-link = "":U then do:
      647         assign
      648           v-word-link = "and":U
      649         .
      650       end.
      651     end.
      652     if v-av-chip-num = false then do:
      653       message
      654         vss-workfile vss-revision vss-description skip
      655         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      656         "Использование данной процедуры невозможно!" skip
      657         view-as alert-box error .
      658       return error .
      659     end.
      660     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      661     if not h-new-buf:available then do:
      662       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      663       if not h-main-buf:available then do:
      664         assign
      665           h-for-comp = ?
      666         .
      667       end.
      668       else do:
      669         assign
      670           h-for-comp = h-main-buf
      671         .
      672       end.
      673     end.
      674     else do:
      675       assign
      676         h-for-comp = h-new-buf
      677       .
      678     end.
      679     assign
      680       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      681     .
      682     do v-ind = 1 to v-num-entries
      683     on error undo, return error return-value
      684     :
      685       assign
      686         v-field-name = entry( v-ind, v-main-fld-lst )
      687         fh-old       = p-hst-handle:buffer-field( v-field-name )
      688         v-old-value  = fh-old:buffer-value()
      689         v-label      = trim( fh-old:label )
      690       .
      691       if ( trim( p-field-list ) <> "":U
      692            and lookup( v-field-name, p-field-list ) > 0
      693          )
      694          or trim( p-field-list ) = "":U
      695       then do:
      696         if h-for-comp <> ? then do:
      697           assign
      698             fh-new      = h-for-comp:buffer-field( v-field-name )
      699             v-new-value = fh-new:buffer-value()
      700           .
      701         end.
      702         else do:
      703           assign
      704             v-new-value = "":U
      705           .
      706         end.
      707         if v-old-value <> v-new-value
      708         then do:
      709           create temp-changes.
      710           assign
      711             temp-changes.t_name = p-main-table
      712             temp-changes.f_name = v-field-name
      713             temp-changes.l_name = replace( v-label, "&":U, "":U )
      714             temp-changes.v_old  = trim( v-old-value )
      715             temp-changes.v_new  = trim( v-new-value )
      716             temp-changes.num_   = 0
      717             temp-changes.fNotChange = v-old-value eq v-new-value
      718           .
      719         end.
      720       end.
      721     end.
      722     assign
      723       v-num-entries = num-entries( p-label-form, chr(8) )
      724     .
      725     do v-ind = 1 to v-num-entries
      726     on error undo, return error return-value
      727     :
      728       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      729         assign
      730           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      731           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      732           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      733         .
      734         find first temp-changes
      735           where temp-changes.f_name = v-field-name
      736           no-error .
      737         if available temp-changes then do:
      738           if trim( v-field-lvl ) <> "":U then do:
      739             assign
      740               temp-changes.l_name = v-field-lvl
      741             .
      742           end.
      743           if trim( v-field-form ) <> "":U then do:
      744             assign
      745               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      746             .
      747             if h-for-comp <> ? then do:
      748               assign
      749                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      750               .
      751             end.
      752           end.
      753         end.
      754       end.
      755       else do:
      756         message
      757           vss-workfile vss-revision vss-description skip
      758           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      759           substitute( "список для поля '&1': '&2'"
      760                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      761                       ,entry( v-ind, p-label-form, chr(8) )
      762                     ) skip
      763           substitute( "полный список: &2", p-label-form ) skip
      764           view-as alert-box error .
      765       end.
      766     end.
      767     delete object h-new-buf .
      768     delete object h-main-buf .
      769   END PROCEDURE.
      770   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      772   procedure fltopend_fltopend :
      773   define input parameter p-parent-handle as handle no-undo .
      774   define input parameter p-qh as handle no-undo .
      775   define input parameter p-flt-open-open-query  as character no-undo .
      776   define input parameter p-where-cond as character no-undo .
      777   define input parameter p-use-indFIRST-query-tail as character no-undo .
      778   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      779   define input parameter p-indexed-reposition as character no-undo .
      780     do
      781     on error undo, return error
      782     :
      783   define variable v-prepare-string as character no-undo .
      784   define variable glog as logical no-undo .
      785   assign
      786   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      787                      p-where-cond + chr(32)  +
      788                      p-use-indFIRST-query-tail + chr(32) +
      789                      p-use-ind-sort-clmn-by + chr(32) +
      790                      p-indexed-reposition
      791   .
      792   assign
      793   glog = p-qh:query-prepare(v-prepare-string) no-error .
      794   if not glog
      795   or error-status:error then do:
      796     message error-status:get-message(1) view-as alert-box .
      797     undo, return error .
      798   end.
      799   assign
      800   glog = p-qh:query-open no-error .
      801   if not glog
      802   or error-status:error then do:
      803     message error-status:get-message(1) view-as alert-box .
      804     undo, return error .
      805   end.
      806     end.
      807   end procedure.
      808   procedure fltopend_fltfindd :
      809   define input parameter p-parent-handle as handle no-undo .
      810   define input parameter p-qh as handle no-undo .
      811   define input parameter p-rowid as rowid no-undo .
      812   define input parameter p-next as logical no-undo .
      813   define input parameter p-lock as integer no-undo .
      814   define input parameter p-bh as handle no-undo .
      815   define input parameter p-where-cond as character no-undo .
      816   define input parameter p-use-index-phrase as character no-undo .
      817   define variable glog as logical no-undo .
      818   define variable v-qh as handle no-undo .
      819   define variable v-bh as handle no-undo .
      820   define variable v-recid as recid no-undo .
      821   define variable v-prepare-string as character no-undo .
      822   do
      823   on error undo, return error
      824   on stop undo, return error
      825   :
      826     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      827     create buffer v-bh for table p-bh buffer-name p-bh:name.
      828     create query v-qh.
      829     v-qh:set-buffers(v-bh).
      830     v-prepare-string = substitute("for each &1 &2 &3"
      831                                     ,v-bh:name
      832                                     ,p-where-cond
      833                                     ,p-use-index-phrase).
      834     glog = v-qh:query-prepare(v-prepare-string) no-error.
      835     if not glog then do:
      836       delete object v-qh.
      837       delete object v-bh.
      838       undo, return error .
      839     end.
      840     glog = v-qh:query-open no-error .
      841     if not glog then do:
      842       delete object v-qh.
      843       delete object v-bh.
      844       undo, return error .
      845     end.
      846     if p-next then do:
      847       v-qh:reposition-to-rowid(p-rowid) no-error .
      848       glog = v-qh:get-next( p-lock) no-error .
      849       glog = v-qh:get-next( p-lock) no-error .
      850       if not glog or v-qh:query-off-end = yes then do:
      851         glog = v-qh:get-first( p-lock) no-error .
      852       end.
      853     end.
      854     else do:
      855       glog = v-qh:get-first( p-lock) no-error .
      856     end.
      857     v-recid = v-bh:recid no-error .
      858     delete object v-qh.
      859     delete object v-bh.
      860     return string(v-recid) .
      861   end.
      862   end procedure.
      863   procedure fltopend_fltfindq :
      864   define input parameter p-parent-handle as handle no-undo .
      865   define input parameter p-qh as handle no-undo .
      866   define input parameter p-next as logical no-undo .
      867   define input parameter p-lock as integer no-undo .
      868   define input parameter p-flt-open-open-query  as character no-undo .
      869   define input parameter p-where-cond as character no-undo .
      870   define input parameter p-use-indFIRST-query-tail as character no-undo .
      871   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      872   define input parameter p-indexed-reposition as character no-undo .
      873   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      874   define variable glog as logical no-undo .
      875   define variable v-qh as handle no-undo .
      876   define variable v-bh as handle no-undo extent 18.
      877   define variable v-rowid as rowid no-undo extent 18.
      878   define variable v-ii as integer no-undo .
      879   define variable v-prepare-string as character no-undo .
      880   do
      881   on error undo, return error
      882   on stop undo, return error
      883   :
      884     create query v-qh.
      885     do v-ii = 1 to p-qh:num-buffers:
      886       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      887       assign
      888       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      889       no-error.
      890       v-qh:add-buffer(v-bh[v-ii]).
      891     end.
      892     assign
      893     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      894                       p-where-cond + chr(32)  +
      895                       p-use-indFIRST-query-tail + chr(32) +
      896                       p-use-ind-sort-clmn-by + chr(32) +
      897                       p-indexed-reposition
      898     .
      899     glog = v-qh:query-prepare( v-prepare-string) no-error .
      900     if not glog then do:
      901       delete object v-qh.
      902       do v-ii = 1 to p-qh:num-buffers:
      903         delete object v-bh[v-ii].
      904       end.
      905       undo, return error .
      906     end.
      907     glog = v-qh:query-open no-error .
      908     if not glog then do:
      909       delete object v-qh.
      910       do v-ii = 1 to p-qh:num-buffers:
      911         delete object v-bh[v-ii].
      912       end.
      913       undo, return error .
      914     end.
      915     if p-next then do:
      916       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      917       glog = v-qh:get-next( p-lock) no-error .
      918       glog = v-qh:get-next( p-lock) no-error .
      919       if not glog or v-qh:query-off-end = yes then do:
      920         glog = v-qh:get-first( p-lock) no-error .
      921       end.
      922     end.
      923     else do:
      924       glog = v-qh:get-first( p-lock) no-error .
      925     end.
      926     do v-ii = 1 to p-qh:num-buffers:
      927       assign
      928       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      929       no-error.
      930     end.
      931     delete object v-qh.
      932     do v-ii = 1 to p-qh:num-buffers:
      933       delete object v-bh[v-ii].
      934     end.
      935   end.
      936   end procedure.
      937   define new shared buffer buf_changes  for temp-changes.
      938   define new shared buffer buf_history  for ub.c-doc-line.
      939   define            buffer buf_sch_hist for ub.c-doc-line.
      940   define            buffer buf_source   for ub.doc-line.
      941   define            buffer buf_object   for ub.clients.
      942   define variable varr-b           as character no-undo.
      943   define variable filter-point     as character no-undo initial 'История изменения строк документов':U.
      944   define variable filter-point0    as character no-undo initial 'История изменения строк документов':U.
      945   define variable sort-change-name as character no-undo.
      946   define variable sort-column-name as character no-undo.
      947   define variable sch-field        as character no-undo.
      948   define variable FoundRec         as recid     no-undo.
      949   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      950   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      951   define variable p-host-code      as integer   no-undo.
      952   define variable doc-rec          as recid     no-undo.
      953   function mark-string returns character ( buffer loc-buf for ub.c-doc-line ) :
      954     define variable v_mark-sign as character no-undo.
      955     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      956     return ( v_mark-sign ).
      957   end function.
      958   function obj-short returns character ( input i-type as character, input i-code as integer ) :
      959     define variable v_obj-name as character no-undo.
      960     run get-obj-short-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      961     return ( v_obj-name ).
      962   end function.
      963   function obj-name returns character ( input i-type as character, input i-code as integer ) :
      964     define variable v_obj-name as character no-undo.
      965     run get-obj-full-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      966     return ( v_obj-name ).
      967   end function.
      968   function gds-name returns character ( buffer loc-buf for ub.c-doc-line ) :
      969     define variable v_gds-name as character no-undo.
      970     run get-goods-name in this-procedure ( buffer loc-buf, output v_gds-name ).
      971     return ( v_gds-name ).
      972   end function.
      973   function eng-name returns character ( buffer loc-buf for ub.c-doc-line ) :
      974     define variable v_gds-name as character no-undo.
      975     run get-gds-eng-name in this-procedure ( buffer loc-buf, output v_gds-name ).
      976     return ( v_gds-name ).
      977   end function.
      978   function unit-base returns character ( buffer loc-buf for ub.c-doc-line ) :
      979     define variable v_unit-base as character no-undo.
      980     run get-gds-unit-base in this-procedure ( buffer loc-buf, output v_unit-base ).
      981     return ( v_unit-base ).
      982   end function.
      983   function sale-price returns decimal ( buffer loc-buf for ub.c-doc-line ) :
      984     define variable d_price as decimal no-undo.
      985     run get-sale-price in this-procedure ( buffer loc-buf, output d_price ).
      986     return ( d_price ).
      987   end function.
      988   function per-cent returns decimal ( buffer loc-buf for ub.c-doc-line ) :
      989     define variable d_prc as decimal no-undo.
      990     run get-per-cent in this-procedure ( buffer loc-buf, output d_prc ).
      991     return ( d_prc ).
      992   end function.
      993   function scala returns character ( buffer loc-buf for ub.c-doc-line ) :
      994     define variable v_scala as character no-undo.
      995     run get-gds-scale in this-procedure ( buffer loc-buf, output v_scala ).
      996     return ( v_scala ).
      997   end function.
      998   function ext-type returns character ( input i-type as character ) :
      999     define variable v_ext-type as character no-undo.
     1000     run get-ext-type in this-procedure ( input i-type, output v_ext-type ) no-error.
     1001     return ( if error-status :error or v_ext-type = ? then "":U else v_ext-type ).
     1002   end function.
     1003   define button b-help   label "Помо&щь"    size-chars  10    by 1.00 default.
     1004   define button b-mark   label "&*"         size-chars  3     by 1.00 default.
     1005   define button b-quit   label "Вы&ход"     size-chars  10    by 1.00 default auto-end-key.
     1006   define button b-Dtls   label "При&знаки"  size-chars  10 by 1.00 default.
     1007   define button b-sch    label "&Фильтр"    size-chars  10 by 1.00 default.
     1008   define button b-sel    label "Вы&бор"     size-chars  10 by 1.00 default auto-go.
     1009   define button b-petrol label "Топли&во"       size-chars  10 by 1.00 default .
     1010   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
     1011   define variable sch-doc  as character no-undo view-as fill-in size-chars 16.00 by 1.00 format "x(16)":U.
     1012   define variable sch-gds  as character no-undo view-as fill-in size-chars 16.00 by 1.00 format "x(16)":U.
     1013   define variable sch-num  as integer   no-undo view-as fill-in size-chars  4.50 by 1.00 format ">>>":U.
     1014   define new shared query br-doc-lines for buf_history scrolling.
     1015   define new shared query   br-changes   for buf_changes scrolling.
     1016   define browse br-doc-lines query br-doc-lines display
     1017     mark-string( buffer buf_history )  column-label '*'  format 'x(1)':U
     1018     buf_history.doc-code  column-label 'Накладная'  format "x(16)":U
     1019     buf_history.line-num  column-label 'П/П'  format "->>>9":U
     1020     buf_history.prt-OK  column-label 'Ш'  format "+/-":U
