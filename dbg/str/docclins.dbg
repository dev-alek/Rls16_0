     1371   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   procedure minbtn-set :
     1373       do
     1374           on error undo, return error return-value
     1375           :
     1376           define variable ii              as integer       no-undo .
     1377           define variable fh              as widget-handle no-undo .
