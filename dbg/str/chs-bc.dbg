      270             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      271             .
      272         end.
      273       end case.
      274     end.
      275   define variable b-c-g   AS int              NO-UNDO.
      276   define variable conf-par as char no-undo.
      277   define variable par-type as char no-undo.
      278   define variable varPlace AS LOG NO-UNDO.
      279   DEFINE BUTTON b-exit
      280        LABEL "&Ввод ":L
      281        SIZE 9.75 BY 1.15.
      282   DEFINE BUTTON b-quit AUTO-END-KEY
      283        LABEL "&Отмена":L
      284        SIZE 9.75 BY 1.15.
      285   DEFINE BUTTON b-help
      286        LABEL "Помо&щь":L
      287        SIZE 9.75 BY 1.15.
      288   DEFINE FRAME d-chs-bc
      289     add-scan VIEW-AS TOGGLE-BOX LABEL "Копировать кол-во со сканера"
      290     bar-str LABEL "КОД" AT ROW 2 COL 10 COLON-ALIGNED SKIP
      291     b-exit AT ROW 4 COL 2.5
      292     b-quit AT ROW 4 COL 12.5
      293     b-help AT ROW 4 COL 22.5
      294     SPACE(0) SKIP(0.38)
      295     WITH VIEW-AS DIALOG-BOX
      296            SIDE-LABELS THREE-D SCROLLABLE
      297            TITLE "Строка":L
      298            DEFAULT-BUTTON b-quit.
      299   ASSIGN FRAME d-chs-bc:SCROLLABLE = FALSE.
      300   def var mess as char no-undo.
      301   procedure check-code:
      302   define input parameter parbar-str AS char no-undo.
      303   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      304   define input parameter parqnty    as dec no-undo.
      305   define input  parameter parg#doc-prt as logical no-undo.
      306   define input  parameter parscales-pref as character no-undo.
      307   define input  parameter parpgscales-pref as character no-undo.
      308   define output parameter parplace   as log initial no no-undo.
      309   define output parameter parb-c     as int no-undo.
      310   define output parameter parrate    as dec no-undo.
      311   define variable varresult   as character       no-undo.
      312   define variable vartype-bc  as character       no-undo.
      313   define variable varweight   as decimal         no-undo.
      314   def buffer b-bar-code for ub.bar-code.
      315   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      316   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      317   (
      318    input  parparentproc
      319   ,input  parbar-str
      320   ,input  parprice
      321   ,input  v-cntxt-obj-type
      322   ,input  v-cntxt-obj-code
      323   ,input  yes
      324   ,input  no
      325   ,input  parscales-pref
      326   ,input  parpgscales-pref
      327   ,output varresult
      328   ,output vartype-bc
      329   ,output varweight
      330   ,buffer ub.bar-code
      331   ,buffer ub.prod-bc
      332   ,buffer ub.place
      333   ) no-error.
      334   if error-status:error then do:
      335     return error "Ошибка при разборе бар-кода: " + parbar-str.
      336   end.
      337   if not available bar-code THEN DO:
      338      if add-sens = ? and available place
      339      then DO: parPlace = YES. RETURN. END.
      340      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      341   END.
      342   else do:
      343       assign  parb-c  = bar-code.b-code
      344               parrate = bar-code.cli-base-rate.
      345       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      346       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      347       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      348       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      349          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      350          RETURN ERROR "Ссылка не на подробный признак.".
      351       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      352            bar-code.node-code <> gds-prt.node-code then do:
      353         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      354         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      355                         and bar-code.node-code = gds-prt.node-code
      356                         and bar-code.in-code   = b-bar-code.in-code
      357                         and bar-code.part-code = b-bar-code.part-code
      358                         and bar-code.unit-cli  = ub.goods.unit-base
      359                           no-lock.
      360         parb-c = bar-code.b-code.
      361         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      362       end.
      363   end.
      364   RETURN.
      365   END PROCEDURE.
      366   ON LEAVE OF add-scan IN FRAME d-chs-bc DO:
      367      ASSIGN FRAME d-chs-bc add-scan.
      368   END.
      369   ON CHOOSE OF b-quit IN FRAME d-chs-bc  DO:
      370      ASSIGN
      371      b-c = ?
      372      rate = ?.
      373   END.
      374   on end-error, stop of frame d-chs-bc do:
      375      apply "choose" to b-quit in frame d-chs-bc.
      376      return no-apply.
      377   end.
      378   ON return, MOUSE-SELECT-DBLCLICK OF bar-str IN FRAME d-chs-bc DO:
      379   apply "choose" to b-exit in frame d-chs-bc.
      380   return no-apply.
      381   END.
      382   ON CHOOSE OF b-exit IN FRAME d-chs-bc DO:
      383   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
