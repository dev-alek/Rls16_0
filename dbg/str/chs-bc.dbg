      406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      407     (input  'scpgpref':u
      408     ,input  '':u
      409     ,input  '':u
      410     ,input  0
      411     ,input  '':u
      412     ,input  '':u
      413     ,input  '':u
      414     ,input  no
      415     ,output varpgscales-pref
      416     ,output varpgscales-pref-type4
      417     ) no-error .
      418   if varpgscales-pref = ? then do:
      419     assign
      420     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      421   end.
      422      IF INPUT FRAME d-chs-bc bar-str = "" THEN DO:
      423         MESSAGE "Введите бар-код."
      424           VIEW-AS ALERT-BOX INFO BUTTONS OK.
      425         RETURN NO-APPLY.
      426      END.
      427      if not-term ne ? then DO:
      428         ASSIGN bar-str.
      429         RUN check-code in this-procedure ( input bar-str
      430                                           ,input 0
      431                                           ,input 1
      432                                           ,input  v-cntxp-doc-prt
      433                                           ,input varscales-pref
      434                                           ,input varpgscales-pref
      435                                           ,output varPlace
      436                                           ,output b-c-g
      437                                           ,output rate) NO-ERROR.
      438         IF RETURN-VALUE = "Ссылка не на подробный признак." AND not-term THEN
      439            RUN check-code  in this-procedure ( input bar-str
      440                                               ,input 0
      441                                               ,input 1
      442                                               ,input NO
      443                                               ,input varscales-pref
      444                                               ,input varpgscales-pref
      445                                               ,output varPlace
      446                                               ,output b-c-g
      447                                               ,output rate) NO-ERROR.
      448            IF ERROR-STATUS:ERROR THEN DO:
      449            IF RETURN-VALUE <> "" THEN DO:
      450               MESSAGE RETURN-VALUE
      451               VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      452            END.
      453            ELSE DO:
      454               MESSAGE "Ошибка из процедуры проверки бар-кода."
      455               VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      456            END.
      457            RETURN NO-APPLY.
      458         END.
      459         IF RETURN-VALUE <> ""      AND
      460            RETURN-VALUE <> "PLACE" THEN DO:
      461              MESSAGE RETURN-VALUE
      462                 VIEW-AS ALERT-BOX INFORMATION BUTTONS OK.
      463         END.
      464         assign ret-mode = return-value.
      465         b-c = string(b-c-g).
      466      END.
      467      ELSE b-c = INPUT FRAME d-chs-bc bar-str.
      468      APPLY "go" TO FRAME d-chs-bc.
      469   END.
      470   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-chs-bc:PARENT eq ?
      471   THEN FRAME d-chs-bc:PARENT = ACTIVE-WINDOW.
      472   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   on help of frame d-chs-bc
      474   do:
      475     run gbl/app_help.p
      476       (input this-procedure :file-name
      477       ,input ''
      478       ,input ?
      479       ) no-error.
      480     if error-status :error then do:
      481       message
      482         "Ошибка при вызове помощи"
      483         error-status :get-message(1)
      484         view-as alert-box .
      485     end.
      486   end.
      487   run minbtn-set in this-procedure .
      488   on choose of b-help in frame d-chs-bc
      489   do:
      490     apply "help":u to frame d-chs-bc .
      491   end.
      492   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   procedure minbtn-set :
      494       do
      495           on error undo, return error return-value
      496           :
      497           define variable ii              as integer       no-undo .
      498           define variable fh              as widget-handle no-undo .
      499           define variable hh              as widget-handle no-undo .
      500           define variable v-h             as handle        extent 4 no-undo .
      501           define variable v-name-button   as character     no-undo .
      502           define variable v-help-old-x    as decimal       no-undo .
      503           define variable v-help-old-y    as decimal       no-undo .
      504           define variable v-help-old-size as decimal       no-undo .
      505           define variable v-frame-width   as decimal       no-undo .
      506           define variable jj              as integer       no-undo .
      507           do
      508               on error undo, return error
      509               :
      510               assign
      511                   v-frame-width = frame d-chs-bc:width - 0.3
      512                   fh            = frame d-chs-bc:first-child
      513                   hh            = fh:first-child
      514                   ii            = 1
      515                   .
      516               do while valid-handle(hh):
      517                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      518                   do:
      519                       case lc(hh:name) :
      520                           when "b-help" then
      521                               do:
      522                                   hh:load-image-up("cmp/b-help.bmp":u) .
      523                                   hh:load-image-down("cmp/b-help.bmp":u) .
      524                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      525                                   hh:TOOLTIP = "Помощь" .
      526                                   v-help-old-x = hh:column .
      527                                   v-help-old-y = hh:row    .
      528                                   v-help-old-size = hh:width .
      529                                   hh:width-chars = 2.5 .
      530                               end.
      531                           when "b-print" then
      532                               do:
      533                                   hh:load-image("cmp/b-print.bmp":u) .
      534                                   hh:TOOLTIP = "Печать" .
      535                                   v-h[ii] = hh:handle .
      536                                   ii = ii + 1 .
      537                                   hh:width-chars = 3 .
      538                               end.
      539                           when "b-history" or
      540                           when "b-hist" then
      541                               do:
      542                                   hh:load-image("cmp/b-hist.bmp":u) .
      543                                   hh:TOOLTIP = "История" .
      544                                   v-h[ii] = hh:handle .
      545                                   ii = ii + 1 .
      546                                   hh:width-chars = 3 .
      547                               end.
      548                           when "b-sch" then
      549                               do:
      550                                   hh:load-image("cmp/b-sch.bmp":u) .
      551                                   hh:TOOLTIP = "Установка Фильтра" .
      552                                   v-h[ii] = hh:handle .
      553                                   ii = ii + 1 .
      554                                   hh:width-chars = 3 .
      555                               end.
      556                           when "b-hist-user" then
      557                               do:
      558                                   hh:load-image("cmp/b-hist.bmp":u) .
      559                                   hh:TOOLTIP = "История пользователя" .
      560                                   ii = ii + 1 .
      561                               end.
      562                       end case.
      563                   end.
      564                   hh = hh:next-sibling.
      565               end.
      566               b-help:column = v-frame-width - b-help:width-chars.
      567               jj = 0.
      568               repeat ii = 4 to 1 by -1 :
      569                   if valid-handle (v-h[ii] ) then
      570                   do:
      571                       jj  = jj + 1 .
      572                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      573                       v-h[ii]:row    = v-help-old-y .
      574                   end.
      575               end.
      576           end.
      577       end.
      578   end procedure.
      579   ON WINDOW-CLOSE OF FRAME d-chs-bc APPLY "END-ERROR":U TO SELF.
      580   MAIN-BLOCK:
      581   DO ON ERROR   UNDO MAIN-BLOCK, return
      582      ON END-KEY UNDO MAIN-BLOCK, return:
      583   frame d-chs-bc:title = f-title.
      584   DISPLAY bar-str add-scan WITH FRAME d-chs-bc.
      585   IF in-add THEN ENABLE add-scan WITH FRAME d-chs-bc.
      586   ELSE HIDE add-scan IN FRAME d-chs-bc.
      587   ENABLE bar-str b-help b-quit b-exit WITH FRAME d-chs-bc.
      588   WAIT-FOR GO OF FRAME d-chs-bc focus bar-str.
      589   END.
      590   RUN disable_UI.
      591   PROCEDURE disable_UI :
      592     HIDE FRAME d-chs-bc.
      593   END PROCEDURE.
