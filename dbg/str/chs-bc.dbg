      206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      207     (input  'is-prt'
      208     ,input  0
      209     ,input  ''
      210     ,input  0
      211     ,input  ''
      212     ,input  ''
      213     ,input  ''
      214     ,input  yes
      215     ,output v-cntxp-conf-par
      216     ,output v-cntxp-par-type
      217     ) no-error .
      218       case v-cntxp-obj-type :
      219         when 'скл':U then do:
      220           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      221           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      222           assign
      223             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      224             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      225             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      226             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      227             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      228             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      229             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      230             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      231             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      232             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      233             v-cntxp-load-time       = bf-cntxp_store.load-time
      234             v-cntxp-holidays        = bf-cntxp_store.holidays
      235             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      236             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      237             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      238             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      239             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      240             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      241             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      242             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      243             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      244             .
      245         end.
      246         when 'маг':U then do:
      247           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      248           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      249           assign
