      255             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      256             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      257             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      258             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      259             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      260             v-cntxp-load-time       = bf-cntxp_shop.load-time
      261             v-cntxp-holidays        = bf-cntxp_shop.holidays
