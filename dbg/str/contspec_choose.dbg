     3703   FUNCTION f-bonus RETURNS DECIMAL
     3704     ( input par-recid as recid ) :
     3705     define buffer buf_contract-specif for ub.contract-specif  .
     3706     define variable v-bonus as decimal no-undo .
     3707     find first buf_contract-specif no-lock where
     3708       recid(buf_contract-specif) = par-recid no-error .
     3709     if error-status :error then return 0.0 .
     3710     v-bonus = 0.0 .
     3711     run read-bonus in this-procedure
     3712       ( buf_contract-specif.contract-num,
     3713       buf_contract-specif.host-code ,
     3714       buf_contract-specif.gds-code ,
     3715       output v-bonus
     3716       ) no-error .
     3717     return v-bonus .
     3718   END FUNCTION.
     3719   FUNCTION f-prc-min RETURNS DECIMAL
     3720     ( input par-recid as recid ) :
     3721     define buffer buf_contract-specif for ub.contract-specif  .
     3722     define variable v-prc-min as decimal no-undo .
     3723     find first buf_contract-specif no-lock where
     3724       recid(buf_contract-specif) = par-recid no-error .
     3725     if error-status :error then return 0.0 .
     3726     v-prc-min = 0.0 .
     3727     run read-prc-min in this-procedure
     3728       ( buf_contract-specif.contract-num,
     3729       buf_contract-specif.host-code ,
     3730       buf_contract-specif.gds-code ,
     3731       output v-prc-min
     3732       ) no-error .
     3733     return v-prc-min .
     3734   END FUNCTION.
     3735   FUNCTION get-b-code RETURNS CHARACTER
     3736     ( input gds-code as integer ) :
     3737     define variable ret    as character no-undo .
     3738     define variable b-code as integer   no-undo .
     3739     assign
     3740       ret = "" .
     3741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3742     (input  gds-code
     3743     ,input  ?
     3744     ,output b-code
     3745     ) no-error .
     3746     if error-status :error then
     3747     do:
     3748     end.
     3749     else assign ret = string(b-code) .
     3750     RETURN ret .
     3751   END FUNCTION.
     3752   FUNCTION get-ext-artic RETURNS CHARACTER
     3753     ( input p-recid as recid ) :
     3754     define variable ret as character no-undo .
     3755     define buffer bf_contract-specif for ub.contract-specif  .
     3756     define buffer bf_contract        for ub.contract  .
     3757     define buffer bf_ext-artic       for ub.ext-artic  .
     3758     define buffer bf_goods           for ub.goods  .
     3759     assign
     3760       ret = "" .
     3761     find first tt_contract-specif no-lock  where recid(tt_contract-specif)  =  p-recid no-error .
     3762     if error-status :error then
     3763     do:
     3764       message
     3765         vss-workfile vss-revision vss-description skip
     3766         error-status :get-message(1) skip
     3767         return-value skip
     3768         ""
     3769         view-as alert-box error
     3770         .
     3771     end.
     3772     find first bf_ext-artic where bf_ext-artic.gds-code   = tt_contract-specif.gds-code
     3773       and bf_ext-artic.status_    <> 'удал':U
     3774       no-error .
     3775     if error-status :error then
     3776     do:
     3777       ret = ''  .
     3778     end.
     3779     else
     3780     do:
     3781       assign
     3782         ret = string(bf_ext-artic.gds-code)
     3783         .
     3784       if ret = ? then ret = "".
     3785     end.
     3786     RETURN ret .
     3787   END FUNCTION.
     3788   FUNCTION get-gds-name RETURNS CHARACTER
     3789     ( input p-gds-code as integer ) :
     3790     define variable ret as character no-undo .
     3791     define buffer bf_goods for ub.goods  .
     3792     assign
     3793       ret = "" .
     3794     find first bf_goods no-lock where
     3795       bf_goods.gds-code = p-gds-code no-error  .
     3796     if error-status :error then
     3797     do:
     3798     end.
     3799     else assign ret = bf_goods.gds-name  .
     3800     RETURN ret .
     3801   END FUNCTION.
     3802   FUNCTION get-grp RETURNS CHARACTER
     3803     ( input gds-code as integer ) :
     3804     define buffer buf_goods for ub.goods.
     3805     find first buf_goods no-lock where buf_goods.gds-code = gds-code .
     3806     RETURN buf_goods.grp-name .
     3807   END FUNCTION.
