       29   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       30   define input  parameter bttns          as char      no-undo .
       31   define input  parameter ref-mode       as character no-undo .
       32   define input  parameter p-host-code    as integer   no-undo .
       33   define input  parameter p-doc-num      as character   no-undo .
       34   define input  parameter recid_client   as integer no-undo .
