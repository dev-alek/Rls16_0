     1025   procedure uf-get :
     1026     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1027     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1028     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1029     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1030     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1031     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1032     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1033     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1034     do
     1035     on error undo, return error
     1036     :
     1037       define buffer buf_usr-flt for ubflt.usr-flt .
     1038       define variable v-use-List_     as logical   no-undo .
     1039       define variable v-type-List_     as character no-undo .
     1040       define variable v-format-List_   as character no-undo .
     1041       define variable v-use-Naim      as logical   no-undo .
     1042       define variable v-type-Naim      as character no-undo .
     1043       define variable v-format-Naim    as character no-undo .
     1044       define variable v-use-print-graft as logical   no-undo .
     1045       define variable v-use-sort-gr     as logical   no-undo .
     1046       define variable v-use-type-price  as logical   no-undo .
     1047       define variable v-use-type-val    as logical   no-undo .
     1048       define variable v-label          as character no-undo .
     1049       define variable v-tooltip        as character no-undo .
     1050       define variable v-user-can-edit  as logical   no-undo .
     1051       define variable v-output-display as logical   no-undo .
     1052       define variable v-other          as character no-undo .
     1053       run uf-name in this-procedure
     1054          (input  entry(1, p-code, chr(4))
     1055         ,output v-use-List_
     1056         ,output v-type-List_
     1057         ,output v-format-List_
     1058         ,output v-use-Naim
     1059         ,output v-type-Naim
     1060         ,output v-format-Naim
     1061         ,output v-use-print-graft
     1062         ,output v-use-sort-gr
     1063         ,output v-use-type-price
     1064         ,output v-use-type-val
     1065         ,output v-label
     1066         ,output v-tooltip
     1067         ,output v-user-can-edit
     1068         ,output v-output-display
     1069         ,output v-other
     1070         ) no-error .
     1071       if error-status :error then do:
     1072         undo, return error return-value .
     1073       end.
     1074       find first buf_usr-flt no-lock where
     1075                  buf_usr-flt.Call-point     = p-code AND
     1076                  buf_usr-flt.user-name       = p-user-name
     1077         no-error .
     1078       if avail buf_usr-flt then do:
     1079         assign
     1080         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1081         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1082         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1083         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1084         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1085         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1086         .
     1087       end.
     1088       else do:
     1089         assign
     1090         p-List_        = (if v-use-List_       then "":U                    else ?)
     1091         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1092         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1093         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1094         p-type-price   = (if v-use-type-price  then no                      else ?)
     1095         p-type-val     = (if v-use-List_       then no                      else ?)
     1096         .
     1097       end.
     1098     end.
     1099   end procedure.
     1100   procedure uf-set :
     1101     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1102     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1103     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1104     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1105     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1106     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1107     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1108     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1109     do
     1110     on error undo, return error
     1111     :
     1112       define buffer buf_usr-flt for ubflt.usr-flt .
     1113       define variable v-use-List_     as logical   no-undo .
     1114       define variable v-type-List_     as character no-undo .
     1115       define variable v-format-List_   as character no-undo .
     1116       define variable v-use-Naim      as logical   no-undo .
     1117       define variable v-type-Naim      as character no-undo .
     1118       define variable v-format-Naim    as character no-undo .
     1119       define variable v-use-print-graft as logical   no-undo .
     1120       define variable v-use-sort-gr   as logical   no-undo .
     1121       define variable v-use-type-price as logical   no-undo .
     1122       define variable v-use-type-val  as logical   no-undo .
     1123       define variable v-tooltip        as character no-undo .
     1124       define variable v-label          as character no-undo .
     1125       define variable v-user-can-edit  as logical   no-undo .
     1126       define variable v-output-display as logical   no-undo .
     1127       define variable v-other          as character no-undo .
     1128       run uf-name in this-procedure
     1129         (input  entry(1, p-code, chr(4))
     1130         ,output v-use-List_
     1131         ,output v-type-List_
     1132         ,output v-format-List_
     1133         ,output v-use-Naim
     1134         ,output v-type-Naim
     1135         ,output v-format-Naim
     1136         ,output v-use-print-graft
     1137         ,output v-use-sort-gr
     1138         ,output v-use-type-price
     1139         ,output v-use-type-val
     1140         ,output v-label
     1141         ,output v-tooltip
     1142         ,output v-user-can-edit
     1143         ,output v-output-display
     1144         ,output v-other
     1145         ) no-error .
     1146       if error-status :error then do:
     1147         undo, return error return-value .
     1148       end.
     1149       find first buf_usr-flt where
     1150                  buf_usr-flt.Call-point     = p-code AND
     1151                  buf_usr-flt.user-name       = p-user-name
     1152         no-error .
     1153       if not avail buf_usr-flt then do:
     1154           create buf_usr-flt .
     1155           assign
     1156           buf_usr-flt.call-point = p-code
     1157           buf_usr-flt.user-name  = p-user-name
     1158           .
     1159       end.
     1160       if avail buf_usr-flt then do:
     1161        assign
     1162        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1163        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1164        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1165        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1166        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1167        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1168       .
     1169       release buf_usr-flt.
     1170       end.
     1171       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1172     end.
     1173   end procedure.
     1174   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175     define variable v-cntxt-db-num        as integer   no-undo .
     1176     define variable v-cntxt-userid        as character no-undo .
     1177     define variable v-cntxt-level         as character no-undo .
     1178     define variable v-cntxt-host-code-obj as integer   no-undo .
     1179     define variable v-cntxt-obj-type      as character no-undo .
     1180     define variable v-cntxt-obj-code      as integer   no-undo .
     1181     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1182     define variable v-cntxt-is-admin      as logical   no-undo .
     1183   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1185   procedure fltopend_fltopend :
     1186   define input parameter p-parent-handle as handle no-undo .
     1187   define input parameter p-qh as handle no-undo .
     1188   define input parameter p-flt-open-open-query  as character no-undo .
     1189   define input parameter p-where-cond as character no-undo .
     1190   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1191   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1192   define input parameter p-indexed-reposition as character no-undo .
     1193     do
     1194     on error undo, return error
     1195     :
     1196   define variable v-prepare-string as character no-undo .
     1197   define variable glog as logical no-undo .
     1198   assign
     1199   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1200                      p-where-cond + chr(32)  +
     1201                      p-use-indFIRST-query-tail + chr(32) +
     1202                      p-use-ind-sort-clmn-by + chr(32) +
     1203                      p-indexed-reposition
     1204   .
     1205   assign
     1206   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1207   if not glog
     1208   or error-status:error then do:
     1209     message error-status:get-message(1) view-as alert-box .
     1210     undo, return error .
     1211   end.
     1212   assign
     1213   glog = p-qh:query-open no-error .
     1214   if not glog
     1215   or error-status:error then do:
     1216     message error-status:get-message(1) view-as alert-box .
     1217     undo, return error .
     1218   end.
     1219     end.
     1220   end procedure.
     1221   procedure fltopend_fltfindd :
     1222   define input parameter p-parent-handle as handle no-undo .
     1223   define input parameter p-qh as handle no-undo .
     1224   define input parameter p-rowid as rowid no-undo .
     1225   define input parameter p-next as logical no-undo .
     1226   define input parameter p-lock as integer no-undo .
     1227   define input parameter p-bh as handle no-undo .
     1228   define input parameter p-where-cond as character no-undo .
     1229   define input parameter p-use-index-phrase as character no-undo .
     1230   define variable glog as logical no-undo .
     1231   define variable v-qh as handle no-undo .
     1232   define variable v-bh as handle no-undo .
     1233   define variable v-recid as recid no-undo .
     1234   define variable v-prepare-string as character no-undo .
     1235   do
     1236   on error undo, return error
     1237   on stop undo, return error
     1238   :
     1239     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1240     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1241     create query v-qh.
     1242     v-qh:set-buffers(v-bh).
     1243     v-prepare-string = substitute("for each &1 &2 &3"
     1244                                     ,v-bh:name
     1245                                     ,p-where-cond
     1246                                     ,p-use-index-phrase).
     1247     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1248     if not glog then do:
     1249       delete object v-qh.
     1250       delete object v-bh.
     1251       undo, return error .
     1252     end.
     1253     glog = v-qh:query-open no-error .
     1254     if not glog then do:
     1255       delete object v-qh.
     1256       delete object v-bh.
     1257       undo, return error .
     1258     end.
     1259     if p-next then do:
     1260       v-qh:reposition-to-rowid(p-rowid) no-error .
     1261       glog = v-qh:get-next( p-lock) no-error .
     1262       glog = v-qh:get-next( p-lock) no-error .
     1263       if not glog or v-qh:query-off-end = yes then do:
     1264         glog = v-qh:get-first( p-lock) no-error .
     1265       end.
     1266     end.
     1267     else do:
     1268       glog = v-qh:get-first( p-lock) no-error .
     1269     end.
     1270     v-recid = v-bh:recid no-error .
     1271     delete object v-qh.
     1272     delete object v-bh.
     1273     return string(v-recid) .
     1274   end.
     1275   end procedure.
     1276   procedure fltopend_fltfindq :
     1277   define input parameter p-parent-handle as handle no-undo .
     1278   define input parameter p-qh as handle no-undo .
     1279   define input parameter p-next as logical no-undo .
     1280   define input parameter p-lock as integer no-undo .
     1281   define input parameter p-flt-open-open-query  as character no-undo .
     1282   define input parameter p-where-cond as character no-undo .
     1283   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1284   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1285   define input parameter p-indexed-reposition as character no-undo .
     1286   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1287   define variable glog as logical no-undo .
     1288   define variable v-qh as handle no-undo .
     1289   define variable v-bh as handle no-undo extent 18.
     1290   define variable v-rowid as rowid no-undo extent 18.
     1291   define variable v-ii as integer no-undo .
     1292   define variable v-prepare-string as character no-undo .
     1293   do
     1294   on error undo, return error
     1295   on stop undo, return error
     1296   :
     1297     create query v-qh.
     1298     do v-ii = 1 to p-qh:num-buffers:
     1299       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1300       assign
     1301       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1302       no-error.
     1303       v-qh:add-buffer(v-bh[v-ii]).
     1304     end.
     1305     assign
     1306     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1307                       p-where-cond + chr(32)  +
     1308                       p-use-indFIRST-query-tail + chr(32) +
     1309                       p-use-ind-sort-clmn-by + chr(32) +
     1310                       p-indexed-reposition
     1311     .
     1312     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1313     if not glog then do:
     1314       delete object v-qh.
     1315       do v-ii = 1 to p-qh:num-buffers:
     1316         delete object v-bh[v-ii].
     1317       end.
     1318       undo, return error .
     1319     end.
     1320     glog = v-qh:query-open no-error .
     1321     if not glog then do:
     1322       delete object v-qh.
     1323       do v-ii = 1 to p-qh:num-buffers:
     1324         delete object v-bh[v-ii].
     1325       end.
     1326       undo, return error .
     1327     end.
     1328     if p-next then do:
     1329       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1330       glog = v-qh:get-next( p-lock) no-error .
     1331       glog = v-qh:get-next( p-lock) no-error .
     1332       if not glog or v-qh:query-off-end = yes then do:
     1333         glog = v-qh:get-first( p-lock) no-error .
     1334       end.
     1335     end.
     1336     else do:
     1337       glog = v-qh:get-first( p-lock) no-error .
     1338     end.
     1339     do v-ii = 1 to p-qh:num-buffers:
     1340       assign
     1341       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1342       no-error.
     1343     end.
     1344     delete object v-qh.
     1345     do v-ii = 1 to p-qh:num-buffers:
     1346       delete object v-bh[v-ii].
     1347     end.
     1348   end.
     1349   end procedure.
