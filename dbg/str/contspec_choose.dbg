     1637     B-mark AT ROW 1 COL 11
     1638     b-sel AT ROW 1 COL 20
     1639     B-Help AT ROW 1 COL 97.88
     1640     B-allmark AT ROW 2 COL 11
     1641     B-unmark AT ROW 2 COL 14.13
     1642     RADIO-find AT ROW 3.38 COL 12 NO-LABEL
     1643     sch-str AT ROW 3.38 COL 54.5 COLON-ALIGNED NO-LABEL
     1644     spec-List AT ROW 4.54 COL 1
     1645     mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1646     "Поиск по" VIEW-AS TEXT
     1647     SIZE 9 BY 1 AT ROW 3.38 COL 1
     1648     FGCOLOR 4
     1649     SPACE(91.37) SKIP(18.95)
     1650     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1651     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1652     TITLE "Товарная спецификация к договору"
     1653     DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
     1654   ASSIGN
     1655     FRAME Dialog-Frame:SCROLLABLE = FALSE
     1656     FRAME Dialog-Frame:HIDDEN     = TRUE.
     1657   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1658     DO:
     1659       APPLY "END-ERROR":U TO SELF.
     1660     END.
     1661   ON CHOOSE OF B-allmark IN FRAME Dialog-Frame
     1662     DO:
     1663       define variable loc#log as logical no-undo .
     1664       if available tt_contract-specif then
     1665       do:
     1666         v-rid-list = "" .
     1667         for each tt_contract-specif no-lock:
     1668   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   define variable v-str-recid17 as character no-undo .
     1670   define variable v-num-entry17 as integer   no-undo .
     1671   assign
     1672     v-str-recid17 = trim( string( recid( tt_contract-specif ) , "->>>>>>>>>>>9":U ) )
     1673     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1674   .
     1675   if v-num-entry17 > 0 then do:
     1676     assign
     1677       entry( v-num-entry17, v-rid-list ) = "":U
     1678       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1679     .
     1680   end.
     1681   else do:
     1682     assign
     1683       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1684     .
     1685   end.
     1686           loc#log = spec-List:refresh() .
     1687         end.
     1688       end.
     1689       if num-entries( v-rid-list ) <> 0 then
     1690       do:
     1691         display
     1692           num-entries( v-rid-list ) @ mark-num
     1693           with frame Dialog-Frame.
     1694       end.
     1695     END.
     1696   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1697     DO:
     1698       define variable loc#log as logical no-undo .
     1699       if available tt_contract-specif then
     1700       do:
     1701   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   define variable v-str-recid19 as character no-undo .
     1703   define variable v-num-entry19 as integer   no-undo .
     1704   assign
     1705     v-str-recid19 = trim( string( recid( tt_contract-specif ) , "->>>>>>>>>>>9":U ) )
     1706     v-num-entry19 = lookup( v-str-recid19 , v-rid-list )
     1707   .
     1708   if v-num-entry19 > 0 then do:
     1709     assign
     1710       entry( v-num-entry19, v-rid-list ) = "":U
     1711       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1712     .
     1713   end.
     1714   else do:
     1715     assign
     1716       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     1717     .
     1718   end.
     1719         row_spec = rowid(tt_contract-specif).
     1720         loc#log = spec-List:refresh() .
     1721         reposition spec-List to rowid row_spec.
     1722         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     1723         do:
     1724           loc#log = spec-List:select-next-row ().
     1725           apply "VALUE-CHANGED" to spec-List in frame Dialog-Frame.
     1726         end.
     1727         if num-entries( v-rid-list ) = 0 then
     1728         do:
     1729           hide mark-num in frame Dialog-Frame.
     1730         end.
     1731         else
     1732         do:
     1733           display
     1734             num-entries( v-rid-list ) @ mark-num
     1735             with frame Dialog-Frame.
     1736         end.
     1737       end.
     1738       apply "entry" to spec-List in frame Dialog-Frame.
     1739     END.
     1740   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1741     DO:
     1742       find first temp-conn no-error.
     1743       if available temp-conn then
     1744       do:
     1745         run gbl/markqwa.p ( input b-sel:sensitive, input string(temp-conn.ri)) no-error.
     1746         if error-status:error then
     1747         do:
     1748           apply "entry" to spec-List .
     1749           return no-apply.
     1750         end.
     1751       end.
     1752     END.
     1753   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1754     DO:
     1755       define variable kk as integer no-undo .
     1756       define buffer buf_goods for ub.goods .
     1757       define variable ii as integer no-undo .
     1758       empty temp-table gds-list .
     1759       if ( v-rid-list = "" ) and ( available tt_contract-specif ) then
     1760       do:
     1761         find first buf_goods no-lock where buf_goods.gds-code = tt_contract-specif.gds-code no-error .
     1762         if available (buf_goods) then
     1763         do:
     1764           for first buf_contract-specif no-lock where buf_contract-specif.contract-num = tt_contract-specif.contract-num and buf_contract-specif.gds-code = tt_contract-specif.gds-code:
     1765             find first ub.contract no-lock where ub.contract.contract-code = buf_contract-specif.contract-num and ub.contract.status_ = 'тек':U no-error .
     1766             create gds-list .
     1767             buffer-copy buf_goods to gds-list .
     1768             gds-list.contract = ub.contract.contract-prn-code .
     1769             gds-list.contract-code = ub.contract.contract-code .
     1770           end.
     1771         end.
     1772       end.
     1773       else
     1774       do:
     1775         if v-rid-list <> "" then
     1776         do:
     1777           do kk = 1 to num-entries (v-rid-list):
     1778             find first tt_contract-specif where recid (tt_contract-specif) = integer(entry (kk,v-rid-list,",")) no-error .
     1779             if available (tt_contract-specif) then
     1780             do:
     1781               find first buf_goods no-lock where buf_goods.gds-code = tt_contract-specif.gds-code no-error .
     1782               if available (buf_goods) then
     1783               do:
     1784                     find first ub.contract no-lock where ub.contract.contract-code = tt_contract-specif.contract-num no-error .
     1785                     find first gds-list where gds-list.gds-code = buf_goods.gds-code and gds-list.contract = ub.contract.contract-prn-code no-error .
     1786                     if not available (gds-list) then
     1787                     do:
     1788                       create gds-list .
     1789                       buffer-copy buf_goods to gds-list .
     1790                       gds-list.contract = ub.contract.contract-prn-code .
     1791                       gds-list.contract-code = ub.contract.contract-code .
     1792                     end.
     1793                   end.
     1794               end.
     1795             end.
     1796         end.
     1797       end.
     1798     END.
     1799   ON CHOOSE OF B-unmark IN FRAME Dialog-Frame
     1800     DO:
     1801       define variable loc#log as logical no-undo .
     1802       v-rid-list = "" .
     1803       loc#log = spec-List:refresh() .
     1804       hide mark-num in frame Dialog-Frame.
     1805     END.
     1806   ON VALUE-CHANGED OF RADIO-find IN FRAME Dialog-Frame
     1807     DO:
     1808       assign RADIO-find .
     1809       if sch-str <> "" then
     1810       do:
     1811         run proc-find-code in this-procedure ( input no, input sch-str) no-error.
     1812         if error-status:error then return no-apply.
     1813       end.
     1814     END.
     1815   ON CTRL-J OF sch-str IN FRAME Dialog-Frame
     1816     DO:
     1817       assign sch-str .
     1818       assign RADIO-find .
     1819       run proc-find-code in this-procedure ( input yes, input sch-str) no-error.
     1820       if error-status:error then return no-apply.
     1821     END.
     1822   ON RETURN OF sch-str IN FRAME Dialog-Frame
     1823     DO:
     1824       assign sch-str .
     1825       assign RADIO-find .
     1826       run proc-find-code in this-procedure ( input no, input sch-str) no-error.
     1827       if error-status:error then return no-apply.
     1828     END.
     1829   ON RETURN OF spec-List IN FRAME Dialog-Frame
     1830     or MOUSE-SELECT-DBLCLICK OF spec-List IN FRAME Dialog-Frame
     1831     DO:
     1832       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     1833     END.
     1834   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   on help of frame Dialog-Frame
     1836   do:
     1837     run gbl/app_help.p
     1838       (input this-procedure :file-name
     1839       ,input ''
     1840       ,input ?
     1841       ) no-error.
     1842     if error-status :error then do:
     1843       message
     1844         "Ошибка при вызове помощи"
     1845         error-status :get-message(1)
     1846         view-as alert-box .
     1847     end.
     1848   end.
     1849   run minbtn-set in this-procedure .
     1850   on choose of b-help in frame Dialog-Frame
     1851   do:
     1852     apply "help":u to frame Dialog-Frame .
     1853   end.
     1854   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   procedure minbtn-set :
     1856       do
     1857           on error undo, return error return-value
     1858           :
     1859           define variable ii              as integer       no-undo .
     1860           define variable fh              as widget-handle no-undo .
     1861           define variable hh              as widget-handle no-undo .
     1862           define variable v-h             as handle        extent 4 no-undo .
     1863           define variable v-name-button   as character     no-undo .
     1864           define variable v-help-old-x    as decimal       no-undo .
     1865           define variable v-help-old-y    as decimal       no-undo .
     1866           define variable v-help-old-size as decimal       no-undo .
     1867           define variable v-frame-width   as decimal       no-undo .
     1868           define variable jj              as integer       no-undo .
     1869           do
     1870               on error undo, return error
     1871               :
     1872               assign
     1873                   v-frame-width = frame Dialog-Frame:width - 0.3
     1874                   fh            = frame Dialog-Frame:first-child
     1875                   hh            = fh:first-child
     1876                   ii            = 1
     1877                   .
     1878               do while valid-handle(hh):
     1879                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1880                   do:
     1881                       case lc(hh:name) :
     1882                           when "b-help" then
     1883                               do:
     1884                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1885                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1886                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1887                                   hh:TOOLTIP = "Помощь" .
     1888                                   v-help-old-x = hh:column .
     1889                                   v-help-old-y = hh:row    .
     1890                                   v-help-old-size = hh:width .
     1891                                   hh:width-chars = 2.5 .
     1892                               end.
     1893                           when "b-print" then
     1894                               do:
     1895                                   hh:load-image("cmp/b-print.bmp":u) .
     1896                                   hh:TOOLTIP = "Печать" .
     1897                                   v-h[ii] = hh:handle .
     1898                                   ii = ii + 1 .
     1899                                   hh:width-chars = 3 .
     1900                               end.
     1901                           when "b-history" or
     1902                           when "b-hist" then
     1903                               do:
     1904                                   hh:load-image("cmp/b-hist.bmp":u) .
     1905                                   hh:TOOLTIP = "История" .
     1906                                   v-h[ii] = hh:handle .
     1907                                   ii = ii + 1 .
     1908                                   hh:width-chars = 3 .
     1909                               end.
     1910                           when "b-sch" then
     1911                               do:
     1912                                   hh:load-image("cmp/b-sch.bmp":u) .
     1913                                   hh:TOOLTIP = "Установка Фильтра" .
     1914                                   v-h[ii] = hh:handle .
     1915                                   ii = ii + 1 .
     1916                                   hh:width-chars = 3 .
     1917                               end.
     1918                           when "b-hist-user" then
     1919                               do:
     1920                                   hh:load-image("cmp/b-hist.bmp":u) .
     1921                                   hh:TOOLTIP = "История пользователя" .
     1922                                   ii = ii + 1 .
     1923                               end.
     1924                       end case.
     1925                   end.
     1926                   hh = hh:next-sibling.
     1927               end.
     1928               b-help:column = v-frame-width - b-help:width-chars.
     1929               jj = 0.
     1930               repeat ii = 4 to 1 by -1 :
     1931                   if valid-handle (v-h[ii] ) then
     1932                   do:
     1933                       jj  = jj + 1 .
     1934                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1935                       v-h[ii]:row    = v-help-old-y .
     1936                   end.
     1937               end.
     1938           end.
     1939       end.
     1940   end procedure.
     1941   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1942   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1943   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1944   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1945   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1946   define variable v-diasize-current-frame-height as decimal   no-undo .
     1947   define variable v-diasize-change-size          as logical   no-undo .
     1948   define variable v-diasize-resize-button        as handle    no-undo .
     1949   define variable v-diasize-wndmax               as logical   no-undo .
     1950   define variable v-diasize-wndstore             as logical   no-undo .
     1951   define variable v-diasize-proc-name            as character no-undo .
     1952   define variable v-diasize-browse-handle        as handle    no-undo .
     1953   define variable v-diasize-browse-number        as integer   no-undo .
     1954   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1955   define temp-table temp-diasize-handle no-undo
     1956     field handle-value  as handle
     1957     field save-position as decimal
     1958     index xpk is primary unique handle-value
     1959     .
     1960   define temp-table temp-browse-handle no-undo
     1961     field browse-type   as character
     1962     field browse-number as integer
     1963     field browse-handle as handle
     1964     field original-size as decimal
     1965     index xpk is primary unique browse-type browse-number
     1966     index xie browse-type browse-handle
     1967   .
     1968   procedure diasize_change-height :
     1969     define input  parameter p-change-value  as decimal   no-undo .
     1970     define input  parameter p-move-resize   as logical   no-undo .
     1971     define variable v-field-group-handle    as handle    no-undo .
     1972     define variable v-object-handle         as handle    no-undo .
     1973     define variable v-frame-height          as decimal   no-undo .
     1974     define variable v-frame-virtual-height  as decimal   no-undo .
     1975     define variable v-browse-height         as decimal   no-undo .
     1976     define variable v-window-height         as decimal   no-undo .
     1977     define variable v-window-virtual-height as decimal   no-undo .
     1978     define variable v-change-sign           as integer   no-undo .
     1979     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1980     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1981     if p-change-value > 0
     1982     then do:
     1983       if frame Dialog-Frame :height + p-change-value
     1984           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1985       then do:
     1986         assign
     1987           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1988                           - (frame Dialog-Frame :height-chars)
     1989         .
     1990         if p-change-value <= 0
     1991         then do:
     1992           run diasize_position-resize-button in this-procedure .
     1993           return .
     1994         end.
     1995       end.
     1996     end.
     1997     if p-change-value < 0
     1998     then do:
     1999       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2000       then do:
     2001         assign
     2002           p-change-value = v-diasize-orig-frame-height
     2003                          - (frame Dialog-Frame :height-chars)
     2004         .
     2005         if p-change-value >= 0
     2006         then do:
     2007           run diasize_position-resize-button in this-procedure .
     2008           return .
     2009         end.
     2010       end.
     2011     end.
     2012     if p-change-value >= 0
     2013     then do:
     2014       assign
     2015         v-change-sign = 1
     2016       .
     2017     end.
     2018     else do:
     2019       assign
     2020         v-change-sign = -1
     2021       .
     2022     end.
     2023     assign
     2024       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2025     .
     2026     if p-change-value = 0
     2027     then do:
     2028       run diasize_position-resize-button in this-procedure .
     2029       return .
     2030     end.
     2031     move_block:
     2032     do
     2033     on error undo move_block, retry move_block
     2034     :
     2035       if retry
     2036       then do:
     2037         do
     2038         on error undo move_block, leave move_block
     2039         :
     2040           if p-change-value > 0
     2041           then do:
     2042             for each buf_temp-diasize-handle
     2043             on error undo, next
     2044             :
     2045               assign
     2046                 v-object-handle = buf_temp-diasize-handle.handle-value
     2047               .
     2048               if v-object-handle <> v-diasize-resize-button
     2049               then do:
     2050                 assign
     2051                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2052                 .
     2053               end.
     2054             end.
     2055             assign
     2056               v-diasize-browse-handle :height = v-browse-height
     2057             .
     2058             for each buf_temp-browse-handle
     2059               where buf_temp-browse-handle.browse-type = 'height':u
     2060             on error undo, next
     2061             :
     2062               assign
     2063                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2064               .
     2065             end.
     2066             assign
     2067               frame Dialog-Frame :height = v-frame-height
     2068             .
     2069             if frame Dialog-Frame :scrollable = true
     2070             then do:
     2071               assign
     2072                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2073               .
     2074             end.
     2075             run diasize_position-resize-button in this-procedure .
     2076           end.
     2077           else do:
     2078             if frame Dialog-Frame :scrollable = true
     2079             then do:
     2080               assign
     2081                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2082               .
     2083             end.
     2084             assign
     2085               frame Dialog-Frame :height = v-frame-height
     2086             .
     2087             assign
     2088               v-diasize-browse-handle :height = v-browse-height
     2089             .
     2090             for each buf_temp-browse-handle
     2091               where buf_temp-browse-handle.browse-type = 'height':u
     2092             on error undo, next
     2093             :
     2094               assign
     2095                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2096               .
     2097             end.
     2098             for each buf_temp-diasize-handle
     2099             on error undo, next
     2100             :
     2101               assign
     2102                 v-object-handle = buf_temp-diasize-handle.handle-value
     2103               .
     2104               if v-object-handle <> v-diasize-resize-button
     2105               then do:
     2106                 assign
     2107                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2108                 .
     2109               end.
     2110             end.
     2111             run diasize_position-resize-button in this-procedure .
     2112           end.
     2113           assign
     2114             v-diasize-change-size = false
     2115           .
     2116           leave move_block .
     2117         end.
     2118       end.
     2119       assign
     2120         v-diasize-need-full-display = true
     2121       .
     2122       if v-diasize-change-size = false
     2123       then do:
     2124         assign
     2125           v-diasize-change-size = true
     2126         .
     2127       end.
     2128       else do:
     2129         return .
     2130       end.
     2131       assign
     2132         v-frame-height = frame Dialog-Frame :height
     2133         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2134         v-browse-height = v-diasize-browse-handle :height
     2135       .
     2136       for each buf_temp-browse-handle
     2137         where buf_temp-browse-handle.browse-type = 'height':u
     2138       :
     2139         assign
     2140           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2141         .
     2142       end.
     2143       for each buf_temp-diasize-handle
     2144       :
     2145         delete buf_temp-diasize-handle .
     2146       end.
     2147       assign
     2148         v-field-group-handle = frame Dialog-Frame :first-child
     2149       .
     2150       do while valid-handle(v-field-group-handle)
     2151       :
     2152         assign
     2153           v-object-handle = v-field-group-handle :first-child
     2154         .
     2155         do while valid-handle(v-object-handle)
     2156         :
     2157           if  v-object-handle <> v-diasize-browse-handle :handle
     2158           and can-query(v-object-handle, "row")
     2159           and can-query(v-object-handle, "height")
     2160           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2161           then do:
     2162             find first buf_temp-browse-handle
     2163               where buf_temp-browse-handle.browse-type   = 'height':u
     2164                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2165               no-error .
     2166             if available buf_temp-browse-handle
     2167             then do:
     2168             end.
     2169             else do:
     2170               create buf_temp-diasize-handle .
     2171               assign
     2172                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2173                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2174               .
     2175             end.
     2176           end.
     2177           assign
     2178             v-object-handle = v-object-handle :next-sibling
     2179           .
     2180         end.
     2181         assign
     2182           v-field-group-handle = v-field-group-handle :next-sibling
     2183         .
     2184       end.
     2185       do with frame Dialog-Frame
     2186       :
     2187         hide v-diasize-resize-button .
     2188         assign
     2189           v-diasize-resize-button :row    = 1
     2190           v-diasize-resize-button :column = 1
     2191         .
     2192       end.
     2193       if p-change-value > 0
     2194       then do:
     2195         if frame Dialog-Frame :scrollable = true
     2196         then do:
     2197           assign
     2198             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2199             no-error .
     2200           if error-status :error
     2201           or error-status :get-message(1) <> ""
     2202           then do:
     2203             undo move_block, retry move_block .
     2204           end.
     2205         end.
     2206         assign
     2207           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2208           no-error .
     2209         if error-status :error
     2210         or error-status :get-message(1) <> ""
     2211         then do:
     2212           undo move_block, retry move_block .
     2213         end.
     2214         assign
     2215           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2216           no-error .
     2217         if error-status :error
     2218         or error-status :get-message(1) <> ""
     2219         then do:
     2220           undo move_block, retry move_block .
     2221         end.
     2222         for each buf_temp-browse-handle
     2223           where buf_temp-browse-handle.browse-type = 'height':u
     2224         on error undo move_block, retry move_block
     2225         :
     2226           assign
     2227             buf_temp-browse-handle.browse-handle :height
     2228               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2229             no-error .
     2230           if error-status :error
     2231           or error-status :get-message(1) <> ""
     2232           then do:
     2233             undo move_block, retry move_block .
     2234           end.
     2235         end.
     2236         for each buf_temp-diasize-handle
     2237         on error undo move_block, retry move_block
     2238         :
     2239           assign
     2240             v-object-handle = buf_temp-diasize-handle.handle-value
     2241           .
     2242           if v-object-handle <> v-diasize-resize-button
     2243           then do:
     2244             assign
     2245               v-object-handle :row = v-object-handle :row + p-change-value
     2246               no-error .
     2247             if error-status :error
     2248             or error-status :get-message(1) <> ""
     2249             then do:
     2250               undo move_block, retry move_block .
     2251             end.
     2252           end.
     2253         end.
     2254       end.
     2255       else do:
     2256         for each buf_temp-diasize-handle
     2257         on error undo move_block, retry move_block
     2258         :
     2259           assign
     2260             v-object-handle = buf_temp-diasize-handle.handle-value
     2261           .
     2262           if v-object-handle <> v-diasize-resize-button
     2263           then do:
     2264             assign
     2265               v-object-handle :row = v-object-handle :row + p-change-value
     2266               no-error .
     2267             if error-status :error
     2268             or error-status :get-message(1) <> ""
     2269             then do:
     2270               undo move_block, retry move_block .
     2271             end.
     2272           end.
     2273         end.
     2274         assign
     2275           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2276           no-error .
     2277         if error-status :error
     2278         or error-status :get-message(1) <> ""
     2279         then do:
     2280           undo move_block, retry move_block .
     2281         end.
     2282         for each buf_temp-browse-handle
     2283           where buf_temp-browse-handle.browse-type = 'height':u
     2284         on error undo move_block, retry move_block
     2285         :
     2286           assign
     2287             buf_temp-browse-handle.browse-handle :height
     2288               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2289             no-error .
     2290           if error-status :error
     2291           or error-status :get-message(1) <> ""
     2292           then do:
     2293             undo move_block, retry move_block .
     2294           end.
     2295         end.
     2296         assign
     2297           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2298           no-error .
     2299         if error-status :error
     2300         or error-status :get-message(1) <> ""
     2301         then do:
     2302           undo move_block, retry move_block .
     2303         end.
     2304         if frame Dialog-Frame :scrollable = true
     2305         then do:
     2306           assign
     2307             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2308             no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block .
     2313           end.
     2314         end.
     2315       end.
     2316       if p-move-resize = true
     2317       then do:
     2318         run diasize_position-resize-button in this-procedure .
     2319       end.
     2320       if v-diasize-wndstore = true
     2321       then do:
     2322         if connected("ub") = true
     2323         then do:
     2324           define variable v-cntxt-db-num        as integer   no-undo .
     2325           define variable v-cntxt-userid        as character no-undo .
     2326           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2327                                             , OUTPUT v-cntxt-userid
     2328                                             ) .
     2329           run gbl/wndsizew.p
     2330             (input  v-cntxt-db-num
     2331             ,input  v-cntxt-userid
     2332             ,input  v-diasize-proc-name
     2333             ,input  'height':u
     2334             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2335             ) .
     2336         end.
     2337       end.
     2338     end.
     2339     assign
     2340       v-diasize-change-size = false
     2341     .
     2342   end procedure.
     2343   procedure diasize_set-height :
     2344     define input  parameter p-new-height  as decimal   no-undo .
     2345     define input  parameter p-move-resize as logical   no-undo .
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       run diasize_change-height in this-procedure
     2350         (input  (p-new-height - frame Dialog-Frame :height)
     2351         ,input  p-move-resize
     2352         ) .
     2353     end.
     2354   end procedure.
     2355   procedure diasize_change-width :
     2356     define input  parameter p-change-value as decimal   no-undo .
     2357     define input  parameter p-move-resize  as logical   no-undo .
     2358     define variable v-field-group-handle   as handle    no-undo .
     2359     define variable v-object-handle        as handle    no-undo .
     2360     define variable v-frame-width          as decimal   no-undo .
     2361     define variable v-frame-virtual-width  as decimal   no-undo .
     2362     define variable v-browse-width         as decimal   no-undo .
     2363     define variable v-window-width         as decimal   no-undo .
     2364     define variable v-window-virtual-width as decimal   no-undo .
     2365     define variable v-change-sign          as integer   no-undo .
     2366     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2367     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2368     if p-change-value > 0
     2369     then do:
     2370       if frame Dialog-Frame :width + p-change-value >
     2371           session :width-chars
     2372       then do:
     2373         assign
     2374           p-change-value = session :width-chars - frame Dialog-Frame :width
     2375         .
     2376         if p-change-value <= 0
     2377         then do:
     2378           run diasize_position-resize-button in this-procedure .
     2379           return .
     2380         end.
     2381       end.
     2382     end.
     2383     if p-change-value < 0
     2384     then do:
     2385       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2386       then do:
     2387         assign
     2388           p-change-value = v-diasize-orig-frame-width
     2389                          - frame Dialog-Frame :width
     2390         .
     2391         if p-change-value >= 0
     2392         then do:
     2393           run diasize_position-resize-button in this-procedure .
     2394           return .
     2395         end.
     2396       end.
     2397     end.
     2398     if p-change-value >= 0
     2399     then do:
     2400       assign
     2401         v-change-sign = 1
     2402       .
     2403     end.
     2404     else do:
     2405       assign
     2406         v-change-sign = -1
     2407       .
     2408     end.
     2409     assign
     2410       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2411     .
     2412     if p-change-value = 0
     2413     then do:
     2414       run diasize_position-resize-button in this-procedure .
     2415       return .
     2416     end.
     2417     move_block:
     2418     do
     2419     on error undo move_block, leave move_block
     2420     :
     2421       if retry
     2422       then do:
     2423         do
     2424         on error undo move_block, leave move_block
     2425         :
     2426           if p-change-value > 0
     2427           then do:
     2428             for each buf_temp-diasize-handle
     2429             on error undo, next
     2430             :
     2431               assign
     2432                 v-object-handle = buf_temp-diasize-handle.handle-value
     2433               .
     2434               if v-object-handle <> v-diasize-resize-button
     2435               then do:
     2436                 assign
     2437                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2438                 .
     2439               end.
     2440             end.
     2441             assign
     2442               v-diasize-browse-handle :width = v-browse-width
     2443             .
     2444             for each buf_temp-browse-handle
     2445               where buf_temp-browse-handle.browse-type = 'width':u
     2446             on error undo, next
     2447             :
     2448               assign
     2449                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2450               .
     2451             end.
     2452             assign
     2453               frame Dialog-Frame :width = v-frame-width
     2454             .
     2455             if frame Dialog-Frame :scrollable = true
     2456             then do:
     2457               assign
     2458                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2459               .
     2460             end.
     2461             run diasize_position-resize-button in this-procedure .
     2462           end.
     2463           else do:
     2464             if frame Dialog-Frame :scrollable = true
     2465             then do:
     2466               assign
     2467                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2468               .
     2469             end.
     2470             assign
     2471               frame Dialog-Frame :width = v-frame-width
     2472             .
     2473             for each buf_temp-browse-handle
     2474               where buf_temp-browse-handle.browse-type = 'width':u
     2475             on error undo, next
     2476             :
     2477               assign
     2478                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2479               .
     2480             end.
     2481             assign
     2482               v-diasize-browse-handle :width = v-browse-width
     2483             .
     2484             for each buf_temp-diasize-handle
     2485             on error undo, next
     2486             :
     2487               assign
     2488                 v-object-handle = buf_temp-diasize-handle.handle-value
     2489               .
     2490               if v-object-handle <> v-diasize-resize-button
     2491               then do:
     2492                 assign
     2493                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2494                 .
     2495               end.
     2496             end.
     2497             run diasize_position-resize-button in this-procedure .
     2498           end.
     2499           assign
     2500             v-diasize-change-size = false
     2501           .
     2502           leave move_block .
     2503         end.
     2504       end.
     2505       assign
     2506         v-diasize-need-full-display = true
     2507       .
     2508       if v-diasize-change-size = false
     2509       then do:
     2510         assign
     2511           v-diasize-change-size = true
     2512         .
     2513       end.
     2514       else do:
     2515         return .
     2516       end.
     2517       assign
     2518         v-frame-width = frame Dialog-Frame :width
     2519         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2520         v-browse-width = v-diasize-browse-handle :width
     2521       .
     2522       for each buf_temp-browse-handle
     2523         where buf_temp-browse-handle.browse-type = 'width':u
     2524       :
     2525         assign
     2526           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2527         .
     2528       end.
     2529       for each buf_temp-diasize-handle
     2530       :
     2531         delete buf_temp-diasize-handle .
     2532       end.
     2533       assign
     2534         v-field-group-handle = frame Dialog-Frame :first-child
     2535       .
     2536       do while valid-handle(v-field-group-handle)
     2537       :
     2538         assign
     2539           v-object-handle = v-field-group-handle :first-child
     2540         .
     2541         do while valid-handle(v-object-handle)
     2542         :
     2543           if  v-object-handle <> v-diasize-browse-handle :handle
     2544           and v-object-handle <> v-diasize-resize-button
     2545           and can-query(v-object-handle, "row")
     2546           and can-query(v-object-handle, "height")
     2547           and ( v-object-handle :col + v-object-handle :width
     2548                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2549               )
     2550           then do:
     2551             find first buf_temp-browse-handle
     2552               where buf_temp-browse-handle.browse-type   = 'width':u
     2553                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2554               no-error .
     2555             if available buf_temp-browse-handle
     2556             then do:
     2557             end.
     2558             else do:
     2559               create buf_temp-diasize-handle .
     2560               assign
     2561                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2562                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2563               .
     2564             end.
     2565           end.
     2566           assign
     2567             v-object-handle = v-object-handle :next-sibling
     2568           .
     2569         end.
     2570         assign
     2571           v-field-group-handle = v-field-group-handle :next-sibling
     2572         .
     2573       end.
     2574       do with frame Dialog-Frame
     2575       :
     2576         hide v-diasize-resize-button .
     2577         v-diasize-resize-button :row = 1.
     2578         v-diasize-resize-button :column = 1.
     2579       end.
     2580       if p-change-value > 0
     2581       then do:
     2582         if frame Dialog-Frame :scrollable = true
     2583         then do:
     2584           assign
     2585             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2586             no-error .
     2587           if error-status :error
     2588           or error-status :get-message(1) <> ""
     2589           then do:
     2590             undo move_block, retry move_block.
     2591           end.
     2592         end.
     2593         assign
     2594           frame Dialog-Frame :width = v-frame-width + p-change-value
     2595           no-error .
     2596         if error-status :error
     2597         or error-status :get-message(1) <> ""
     2598         then do:
     2599           undo move_block, retry move_block.
     2600         end.
     2601         assign
     2602           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2603         no-error .
     2604         if error-status :error
     2605         or error-status :get-message(1) <> ""
     2606         then do:
     2607           undo move_block, retry move_block.
     2608         end.
     2609         for each buf_temp-browse-handle
     2610           where buf_temp-browse-handle.browse-type = 'width':u
     2611         on error undo move_block, retry move_block
     2612         :
     2613           assign
     2614             buf_temp-browse-handle.browse-handle :width
     2615               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2616             no-error .
     2617           if error-status :error
     2618           or error-status :get-message(1) <> ""
     2619           then do:
     2620             undo move_block, retry move_block .
     2621           end.
     2622         end.
     2623         for each buf_temp-diasize-handle
     2624         on error undo move_block, retry move_block
     2625         :
     2626           assign
     2627             v-object-handle = buf_temp-diasize-handle.handle-value
     2628           .
     2629           if v-object-handle <> v-diasize-resize-button
     2630           then do:
     2631             assign
     2632               v-object-handle :col = v-object-handle :col + p-change-value
     2633               no-error .
     2634             if error-status :error
     2635             or error-status :get-message(1) <> ""
     2636             then do:
     2637               undo move_block, retry move_block .
     2638             end.
     2639           end.
     2640         end.
     2641       end.
     2642       else do:
     2643         for each buf_temp-diasize-handle
     2644         on error undo move_block, retry move_block
     2645         :
     2646           assign
     2647             v-object-handle = buf_temp-diasize-handle.handle-value
     2648           .
     2649           if v-object-handle <> v-diasize-resize-button
     2650           then do:
     2651             assign
     2652               v-object-handle :col = v-object-handle :col + p-change-value
     2653               no-error .
     2654             if error-status :error
     2655             or error-status :get-message(1) <> ""
     2656             then do:
     2657               undo move_block, retry move_block .
     2658             end.
     2659           end.
     2660         end.
     2661         for each buf_temp-browse-handle
     2662           where buf_temp-browse-handle.browse-type = 'width':u
     2663         on error undo move_block, retry move_block
     2664         :
     2665           assign
     2666             buf_temp-browse-handle.browse-handle :width
     2667               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2668             no-error .
     2669           if error-status :error
     2670           or error-status :get-message(1) <> ""
     2671           then do:
     2672             undo move_block, retry move_block .
     2673           end.
     2674         end.
     2675         assign
     2676           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2677           no-error .
     2678         if error-status :error
     2679         or error-status :get-message(1) <> ""
     2680         then do:
     2681           undo move_block, retry move_block.
     2682         end.
     2683         assign
     2684           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2685         no-error .
     2686         if error-status :error
     2687         or error-status :get-message(1) <> ""
     2688         then do:
     2689           undo move_block, retry move_block.
     2690         end.
     2691         if frame Dialog-Frame :scrollable = true
     2692         then do:
     2693           assign
     2694             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2695           no-error .
     2696           if error-status :error
     2697           or error-status :get-message(1) <> ""
     2698           then do:
     2699             undo move_block, retry move_block.
     2700           end.
     2701         end.
     2702       end.
     2703       if p-move-resize
     2704       then do:
     2705         run diasize_position-resize-button in this-procedure .
     2706       end.
     2707       if v-diasize-wndstore = true
     2708       then do:
     2709         if connected("ub") = true
     2710         then do:
     2711           define variable v-cntxt-db-num        as integer   no-undo .
     2712           define variable v-cntxt-userid        as character no-undo .
     2713           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2714                                             , OUTPUT v-cntxt-userid
     2715                                             ) .
     2716           run gbl/wndsizew.p
     2717             (input  v-cntxt-db-num
     2718             ,input  v-cntxt-userid
     2719             ,input  v-diasize-proc-name
     2720             ,input  'width':u
     2721             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2722             ) .
     2723         end.
     2724       end.
     2725     end.
     2726     assign
     2727       v-diasize-change-size = false
     2728     .
     2729   end procedure.
     2730   procedure diasize_set-width :
     2731     define input  parameter p-new-width  as decimal   no-undo .
     2732     define input  parameter p-move-resize as logical   no-undo .
     2733     do
     2734     on error undo, return error return-value
     2735     :
     2736       run diasize_change-width in this-procedure
     2737         (input  (p-new-width - frame Dialog-Frame :width)
     2738         ,input  p-move-resize
     2739         ) .
     2740     end.
     2741   end procedure.
     2742   procedure diasize_position-resize-button :
     2743     do with frame Dialog-Frame
     2744     :
     2745       hide v-diasize-resize-button .
     2746       assign
     2747         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2748                     - 1
     2749                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2750         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2751                     - 1
     2752                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2753       .
     2754       view v-diasize-resize-button .
     2755     end.
     2756   end procedure.
     2757   on alt-right anywhere
     2758   do:
     2759     run diasize_change-width in this-procedure
     2760       (input 1
     2761       ,input true
     2762       ) .
     2763     return no-apply .
     2764   end.
     2765   on alt-left anywhere
     2766   do:
     2767     run diasize_change-width in this-procedure
     2768       (input -1
     2769       ,input true
     2770       ) .
     2771     return no-apply .
     2772   end.
     2773   on alt-down anywhere
     2774   do:
     2775     run diasize_change-height in this-procedure
     2776       (input 1
     2777       ,input true
     2778       ) .
     2779     return no-apply .
     2780   end.
     2781   on alt-up anywhere
     2782   do:
     2783     run diasize_change-height in this-procedure
     2784       (input -1
     2785       ,input true
     2786       ) .
     2787     return no-apply .
     2788   end.
     2789   on alt-enter of frame Dialog-Frame
     2790   do:
     2791     run diasize_maximize in this-procedure
     2792       (input  ?
     2793       ).
     2794     return no-apply .
     2795   end.
     2796   procedure diasize_end-move :
     2797     do
     2798     on error undo, return error return-value
     2799     :
     2800       define variable v-row-delta as decimal   no-undo .
     2801       define variable v-col-delta as decimal   no-undo .
     2802       define variable v-new-row as decimal   no-undo .
     2803       define variable v-new-col as decimal   no-undo .
     2804       assign
     2805         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2806         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2807       .
     2808       assign
     2809         v-row-delta = v-new-row - frame Dialog-Frame :height
     2810         v-col-delta = v-new-col - frame Dialog-Frame :width
     2811       .
     2812       run diasize_change-height in this-procedure
     2813         (input v-row-delta
     2814         ,input true
     2815         ) .
     2816       run diasize_change-width in this-procedure
     2817         (input v-col-delta
     2818         ,input true
     2819         ) .
     2820     end.
     2821   end procedure.
     2822   procedure diasize_maximize :
     2823     define input  parameter p-action as logical   no-undo .
     2824     do
     2825     on error undo, return error return-value
     2826     :
     2827       if p-action = ?
     2828       then do:
     2829         if v-diasize-need-maximize = true
     2830         then do:
     2831           assign
     2832             p-action = true
     2833           .
     2834         end.
     2835         else do:
     2836           assign
     2837             p-action = false
     2838           .
     2839         end.
     2840       end.
     2841       if p-action = true
     2842       then do:
     2843         run diasize_change-height in this-procedure
     2844           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2845               - frame Dialog-Frame :height-chars
     2846           ,input true
     2847           ) .
     2848         run diasize_change-width in this-procedure
     2849           (input session :width-chars
     2850               - frame Dialog-Frame :width-chars
     2851           ,input true
     2852           ) .
     2853         assign
     2854           v-diasize-need-maximize = false
     2855         .
     2856       end.
     2857       else do:
     2858         run diasize_change-width in this-procedure
     2859           (input v-diasize-orig-frame-width
     2860               - frame Dialog-Frame :width-chars
     2861           ,input true
     2862           ) .
     2863         run diasize_change-height in this-procedure
     2864           (input v-diasize-orig-frame-height
     2865               - frame Dialog-Frame :height-chars
     2866           ,input true
     2867           ) .
     2868         assign
     2869           v-diasize-need-maximize = true
     2870         .
     2871       end.
     2872     end.
     2873   end procedure.
     2874   procedure diasize_restore-orig-size :
     2875     do
     2876     on error undo, return error return-value
     2877     :
     2878       assign
     2879         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2880         v-diasize-current-frame-height = frame Dialog-Frame :height
     2881       .
     2882       run diasize_set-height in this-procedure
     2883         (input  v-diasize-orig-frame-height
     2884         ,input  true
     2885         ) .
     2886       run diasize_set-width in this-procedure
     2887         (input  v-diasize-orig-frame-width
     2888         ,input  true
     2889         ) .
     2890     end.
     2891   end procedure.
     2892   procedure diasize_restore-current-size :
     2893     do
     2894     on error undo, return error return-value
     2895     :
     2896       run diasize_set-height in this-procedure
     2897         (input  v-diasize-current-frame-height
     2898         ,input  true
     2899         ) .
     2900       run diasize_set-width in this-procedure
     2901         (input  v-diasize-current-frame-width
     2902         ,input  true
     2903         ) .
     2904     end.
     2905   end procedure.
     2906   procedure diasize_set-browse-handle :
     2907     define input  parameter p-browse-handle as handle   no-undo .
     2908     define buffer buf_temp-browse-handle for temp-browse-handle .
     2909     do
     2910     on error undo, return error return-value
     2911     :
     2912       assign
     2913         v-diasize-browse-handle = p-browse-handle
     2914       .
     2915       for each buf_temp-browse-handle
     2916       on error undo, return error return-value
     2917       :
     2918         delete buf_temp-browse-handle .
     2919       end.
     2920     end.
     2921   end procedure.
     2922   procedure diasize_add_browse :
     2923     define input  parameter p-browse-type   as character no-undo .
     2924     define input  parameter p-browse-handle as handle    no-undo .
     2925     define buffer buf_temp-browse-handle for temp-browse-handle .
     2926     do
     2927     on error undo, return error return-value
     2928     :
     2929       assign
     2930         v-diasize-browse-number = v-diasize-browse-number + 1
     2931       .
     2932       create buf_temp-browse-handle .
     2933       assign
     2934         buf_temp-browse-handle.browse-type   = p-browse-type
     2935         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2936         buf_temp-browse-handle.browse-handle = p-browse-handle
     2937       .
     2938     end.
     2939   end procedure.
     2940   procedure diasize_init :
     2941     define variable v-default-value    as logical   no-undo .
     2942     define variable v-restore-saved    as logical   no-undo .
     2943     define variable v-resize-value-str as character no-undo .
     2944     do
     2945     on error undo, return error return-value
     2946     :
     2947       do with frame Dialog-Frame
     2948       :
     2949         assign
     2950           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2951           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2952           v-diasize-browse-handle     = browse spec-List :handle
     2953         .
     2954         create button v-diasize-resize-button
     2955         assign
     2956           parent        = frame Dialog-Frame :first-child
     2957           label         = "s"
     2958           height-pixels = 16
     2959           width-pixels  = 16
     2960           visible       = true
     2961           sensitive     = true
     2962           movable       = true
     2963           triggers:
     2964             on end-move persistent run diasize_end-move in this-procedure .
     2965           end triggers.
     2966         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2967         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2968         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2969         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2970         assign
     2971           v-diasize-wndmax = false
     2972         .
     2973         if connected("ub") = true
     2974         then do:
     2975           define variable v-cntxt-db-num        as integer   no-undo .
     2976           define variable v-cntxt-userid        as character no-undo .
     2977           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2978                                             , OUTPUT v-cntxt-userid
     2979                                             ) .
     2980           run gbl/wndpar_r.p
     2981             (input  v-cntxt-db-num
     2982             ,input  v-cntxt-userid
     2983             ,input  'wndmax':U
     2984             ,output v-diasize-wndmax
     2985             ,output v-default-value
     2986             ) .
     2987         end.
     2988         assign
     2989           v-diasize-wndstore = false
     2990         .
     2991         if connected("ub") = true
     2992         then do:
     2993           run gbl/wndpar_r.p
     2994             (input  v-cntxt-db-num
     2995             ,input  v-cntxt-userid
     2996             ,input  'wndstore':U
     2997             ,output v-diasize-wndstore
     2998             ,output v-default-value
     2999             ) .
     3000         end.
     3001         assign
     3002           v-diasize-proc-name = entry(1, program-name(2), '.')
     3003         .
     3004         if v-diasize-wndstore = true
     3005         then do:
     3006           assign
     3007             v-restore-saved = false
     3008           .
     3009           if connected("ub") = true
     3010           then do:
     3011             run gbl/wndsizer.p
     3012               (input  v-cntxt-db-num
     3013               ,input  v-cntxt-userid
     3014               ,input  v-diasize-proc-name
     3015               ,input  'height':u
     3016               ,output v-resize-value-str
     3017               ) .
     3018             if v-resize-value-str <> '':U
     3019             then do:
     3020               run diasize_change-height in this-procedure
     3021                 (input  integer(v-resize-value-str)
     3022                 ,input  true
     3023                 ) .
     3024               assign
     3025                 v-restore-saved = true
     3026               .
     3027             end.
     3028           end.
     3029           if connected("ub") = true
     3030           then do:
     3031             run gbl/wndsizer.p
     3032               (input  v-cntxt-db-num
     3033               ,input  v-cntxt-userid
     3034               ,input  v-diasize-proc-name
     3035               ,input  'width':u
     3036               ,output v-resize-value-str
     3037               ) .
     3038             if v-resize-value-str <> '':U
     3039             then do:
     3040               run diasize_change-width in this-procedure
     3041                 (input  integer(v-resize-value-str)
     3042                 ,input  true
     3043                 ) .
     3044               assign
     3045                 v-restore-saved = true
     3046               .
     3047             end.
     3048           end.
     3049           if v-restore-saved <> true
     3050           then do:
     3051             if v-diasize-wndmax = true
     3052             then do:
     3053               run diasize_maximize in this-procedure
     3054                 (input  true
     3055                 ) .
     3056             end.
     3057           end.
     3058         end.
     3059         else do:
     3060           if v-diasize-wndmax = true
     3061           then do:
     3062             run diasize_maximize in this-procedure
     3063               (input  true
     3064               ) .
     3065           end.
     3066         end.
     3067       end.
     3068     end.
     3069   end procedure.
     3070   procedure diasize_need-full-display :
     3071     define output parameter p-need-full-display as logical   no-undo .
     3072     do
     3073     on error undo, return error return-value
     3074     :
     3075       assign
     3076         p-need-full-display = v-diasize-need-full-display
     3077       .
     3078       assign
     3079         v-diasize-need-full-display = false
     3080       .
     3081     end.
     3082   end procedure.
     3083   procedure get-context :
     3084      define output parameter p-db-num as integer          no-undo.
     3085      define output parameter p-user-id as character        no-undo.
     3086      define variable v-login               as character    no-undo.
     3087      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3088      define buffer buf_user-login  for ub.user-login .
     3089      do
     3090      on error undo, return error
     3091      :
     3092            FIND FIRST buf_sys-ctrl no-lock.
     3093            ASSIGN
     3094               v-login = USERID("ub")
     3095               p-db-num = buf_sys-ctrl.db-num
     3096            .
     3097            FIND FIRST buf_user-login
     3098                 WHERE buf_user-login.db-num = p-db-num
     3099                   AND buf_user-login.user-login = v-login
     3100                 no-lock
     3101                 no-error
     3102                 .
     3103            IF AVAILABLE buf_user-login
     3104            THEN DO:
     3105               assign
     3106                  p-user-id = buf_user-login.user-id
     3107               .
     3108            END.
     3109      end.
     3110   end procedure.
     3111       run diasize_init in this-procedure .
     3112   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3113     run mainmenu_getcntxt in parparentproc
     3114       (output v-cntxt-db-num
     3115       ,output v-cntxt-userid
     3116       ,output v-cntxt-level
     3117       ,output v-cntxt-host-code-obj
     3118       ,output v-cntxt-obj-type
     3119       ,output v-cntxt-obj-code
     3120       ,output v-cntxt-db-num-obj
     3121       ,output v-cntxt-is-admin
     3122       ) .
     3123   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3124   on f5 of frame Dialog-Frame anywhere
     3125   do:
     3126     run OpenBr  in this-procedure ( input yes, input no, input '':U).
     3127       apply "VALUE-CHANGED" to spec-List.
     3128   end.
     3129   on F9 of frame Dialog-Frame anywhere
     3130     do:
     3131       if not available buf_contract-specif then  return no-apply.
     3132       find first ub.goods no-lock where ub.goods.gds-code = buf_contract-specif.gds-code .
     3133       gds-rec = recid (ub.goods) .
     3134       run ref/gds-form.w
     3135         (input  parParentProc
     3136         ,input  'ПРОСМОТР':U
     3137         ,input  v-cntxt-obj-type
     3138         ,input  v-cntxt-obj-code
     3139         ,input ?
     3140         ,input-output gds-rec
     3141         ).
     3142       apply "entry" to spec-List in frame Dialog-Frame.
     3143       return no-apply.
     3144     end.
     3145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3146     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3147   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3148   do:
     3149     spec-List :SET-REPOSITIONED-ROW(16, "CONDITIONAL") .
     3150   end.
     3151   MAIN-BLOCK:
     3152   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3153     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3154     assign
     3155       spec-List:num-locked-columns            = 1
     3156       tt_contract-specif.artic:read-only in browse spec-List = yes
     3157       .
     3158     find first ub.clients no-lock where
     3159       ub.clients.obj-type = 'орг':U
     3160       and ub.clients.obj-code = p-host-code .
     3161     assign
     3162       frame Dialog-Frame:title = substitute(" Фирма: (&1) &2 Товарная спецификация к договорам"
     3163                                                     ,p-host-code
     3164                                                     ,ub.clients.obj-name).
     3165     run init-browse-p  in this-procedure  no-error .
     3166     run myenable in this-procedure no-error .
     3167     if error-status:error then  return .
     3168     OPEN QUERY spec-List FOR EACH tt_contract-specif NO-LOCK indexed-reposition.
     3169     WAIT-FOR GO OF FRAME Dialog-Frame.
     3170   END.
     3171   run disable_ui in this-procedure .
     3172   PROCEDURE disable_UI :
     3173     HIDE FRAME Dialog-Frame.
     3174   END PROCEDURE.
     3175   PROCEDURE enable_UI :
     3176     DISPLAY RADIO-find sch-str mark-num
     3177       WITH FRAME Dialog-Frame.
     3178     ENABLE b-quit B-mark b-sel B-Help B-allmark B-unmark RADIO-find sch-str
     3179       spec-List mark-num
     3180       WITH FRAME Dialog-Frame.
     3181     VIEW FRAME Dialog-Frame.
     3182   END PROCEDURE.
     3183   PROCEDURE init-browse-p :
     3184     define buffer buf_contract-specif for ub.contract-specif .
     3185     define buffer buf_trn-doc         for ub.trn-doc .
     3186     define buffer buf_clients         for ub.clients .
     3187     define buffer buf_doc-line        for ub.doc-line .
     3188     define buffer buf_goods           for ub.goods .
     3189     define variable ii as integer no-undo .
     3190     empty temp-table tt_contract-specif .
     3191     if p-doc-num <> "" then
     3192     do:
     3193       do ii = 1 to num-entries (p-doc-num):
     3194         for each ub.contract-specif no-lock where ub.contract-specif.contract-num = integer(entry(ii,p-doc-num,",")):
     3195           find first tt_contract-specif where tt_contract-specif.gds-code = ub.contract-specif.gds-code no-error .
     3196           if not available (tt_contract-specif) then
     3197           do:
     3198             create tt_contract-specif .
     3199             buffer-copy ub.contract-specif to tt_contract-specif .
     3200           end.
     3201           else tt_contract-specif.qnty = tt_contract-specif.qnty + ub.contract-specif.qnty .
     3202         end.
     3203       end.
     3204     end.
     3205     else
     3206     do:
     3207       find first buf_clients no-lock where recid(buf_clients) = recid_client no-error .
     3208       if available (buf_clients) then
     3209       do:
     3210         for each buf_trn-doc no-lock where buf_trn-doc.obj-code = v-cntxt-obj-code and
     3211           buf_trn-doc.obj-type = v-cntxt-obj-type and
     3212           buf_trn-doc.cli-code = buf_clients.obj-code and
     3213           buf_trn-doc.cli-type = buf_clients.obj-type and
     3214           buf_trn-doc.ext-doc-type = 'ie':U and
     3215           buf_trn-doc.status_ = 'факт':U:
     3216           for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code and
     3217             buf_doc-line.obj-code = buf_trn-doc.obj-code and
     3218             buf_doc-line.obj-type = buf_trn-doc.obj-type,
     3219             first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and
     3220             buf_goods.prod-code = buf_doc-line.prod-code and
     3221             buf_goods.prod-type = buf_doc-line.prod-type:
     3222             find first tt_contract-specif where tt_contract-specif.gds-code = buf_goods.gds-code no-error .
     3223             if not available (tt_contract-specif) then
     3224             do:
     3225               create tt_contract-specif .
     3226               assign
     3227                 tt_contract-specif.gds-code  = buf_goods.gds-code
     3228                 tt_contract-specif.artic     = buf_goods.artic
     3229                 tt_contract-specif.prod-code = buf_goods.prod-code
     3230                 tt_contract-specif.prod-type = buf_goods.prod-type
     3231                 tt_contract-specif.gds-name  = buf_goods.gds-name
     3232                 tt_contract-specif.unit-base = buf_goods.unit-base
     3233                 .
     3234             end.
     3235           end.
     3236         end.
     3237       end.
     3238     end.
     3239   END PROCEDURE.
     3240   PROCEDURE MyEnable :
     3241     DISPLAY
     3242       sch-str
     3243       RADIO-find
     3244       mark-num
     3245       WITH FRAME Dialog-Frame .
     3246     ENABLE
     3247       b-quit
     3248       B-mark
     3249       when (lookup("B-mark":U, bttns) > 0)
     3250       B-unmark
     3251       when (lookup("B-mark":U, bttns) > 0)
     3252       B-allmark
     3253       when (lookup("B-mark":U, bttns) > 0)
     3254       b-sel
     3255       when (lookup("b-sel":U, bttns) > 0)
     3256       B-Help
     3257       sch-str
     3258       RADIO-find
     3259       spec-List
     3260       mark-num
     3261       WITH FRAME Dialog-Frame .
     3262     VIEW FRAME Dialog-Frame .
     3263   END PROCEDURE.
     3264   PROCEDURE OpenBr :
     3265     define input  parameter p-open-query     as logical   no-undo .
     3266     define input  parameter p-find-next      as logical   no-undo .
     3267     define input  parameter p-find-condition as character no-undo .
     3268     define variable l-query-was-opened as logical no-undo .
     3269     define variable sort-column-phrase as character no-undo .
     3270     case sort-column-name :
     3271       when "" then
     3272         assign
     3273           sort-column-phrase = ""  .
     3274       otherwise
     3275       assign
     3276         sort-column-phrase = "by " + sort-column-name .
     3277     end case.
     3278     define variable l-open-query as logical no-undo .
     3279     filter-point = filter-point0 .
     3280     IF AVAILABLE tt_contract-specif THEN
     3281     DO:
     3282       ASSIGN
     3283         v-doc-rec = recid (tt_contract-specif) .
     3284     END.
     3285   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3286   define variable  l-disable-where-27  as logical   no-undo .
     3287   define variable  l-filter-open-27    as logical   .
     3288   define variable  flt-rec-27       as recid     no-undo .
     3289   define variable  filter-name-27      as character no-undo .
     3290   define variable  where-phrase-27     as character no-undo .
     3291   define variable  sort-phrase-27      as character no-undo .
     3292   define variable  where-phrase-rus-27 as character no-undo .
     3293   define variable  sort-phrase-rus-27  as character no-undo .
     3294     run waitfram-show in this-procedure
     3295       (input "ЖДИТЕ ..."
     3296       ).
     3297   run gbl/flt-get.p
     3298     (input filter-point
     3299     ,output flt-rec-27
     3300     ,output filter-name-27
     3301     ,output where-phrase-27
     3302     ,output sort-phrase-27
     3303     ,output where-phrase-rus-27
     3304     ,output sort-phrase-rus-27
     3305     ).
     3306   if p-open-query then do:
     3307     assign
     3308       l-filter-open-27 = false
     3309     .
     3310     if flt-rec-27 <> ?
     3311       or sort-column-phrase > ""
     3312     then do:
     3313       define variable  parameter-2-27 as character no-undo .
     3314       define variable  parameter-3-27 as character no-undo .
     3315       define variable  parameter-4-27 as character no-undo .
     3316       define variable  parameter-5-27 as character no-undo .
     3317       define variable  parameter-6-27 as character no-undo .
     3318       define variable  parameter-7-27 as character no-undo .
     3319         assign
     3320         parameter-3-27 =
     3321                                 "FOR EACH tt_contract-specif"
     3322         parameter-4-27 =
     3323           (
     3324             if (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-27) <> ""
     3325             then  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " " + where-phrase-27
     3326             else "true"
     3327           )
     3328         parameter-5-27 = (" " + "" + " " + "")
     3329         parameter-6-27 = if sort-phrase-27 = ''
     3330                              then
     3331           (
     3332           " " + "  " +
     3333             " " + sort-column-phrase +
     3334           " " + " "
     3335           )
     3336                              else
     3337           (
     3338           " " + "  " +
     3339             " " + sort-column-phrase +
     3340           " " + sort-phrase-27
     3341           )
     3342         parameter-7-27 =
     3343           "   "
     3344       .
     3345       do
     3346       on stop undo, leave
     3347       on error undo, leave
     3348       :
     3349         assign
     3350           l-disable-where-27 =
     3351             (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-27 = "")
     3352         .
     3353         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3354                             ,input query spec-List:handle
     3355                             ,input parameter-3-27
     3356                             ,input parameter-4-27
     3357                             ,input parameter-5-27
     3358                             ,input parameter-6-27
     3359                             ,input parameter-7-27
     3360                             )
     3361         .
     3362         assign
     3363           l-filter-open-27 = true
     3364         .
     3365       end.
     3366       if l-filter-open-27 = false then do:
     3367         message
     3368           "Ошибка при фильтрации / сортировке" skip
     3369           "Будут показаны записи без учета фильтра" skip
     3370           view-as alert-box .
     3371       end.
     3372       else do:
     3373           assign
     3374             l-query-was-opened = true
     3375           .
     3376       end.
     3377     end.
     3378     if l-filter-open-27 = false then do:
     3379       OPEN QUERY spec-List FOR EACH tt_contract-specif NO-LOCK
     3380         where  tt_contract-specif.host-code = p-host-code
     3381     .
     3382         assign
     3383           l-query-was-opened = true
     3384         .
     3385     end.
     3386   end.
     3387   else do:
     3388     assign
     3389       v-doc-rec = recid( tt_contract-specif )
     3390     .
     3391     do
     3392     on stop undo, leave
     3393     on error undo, leave
     3394     :
     3395       if query spec-List:handle:get-buffer-handle(1) = (buffer tt_contract-specif:handle) then do:
     3396         assign
     3397         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3398         parameter-4-27 =
     3399           "where ":u +  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3400         parameter-5-27 = "  "
     3401       .
     3402         run fltopend_fltfindd in this-procedure  (
     3403                             input this-procedure:handle
     3404                             ,input query spec-List:handle
     3405                             ,input rowid(tt_contract-specif)
     3406                             ,input logical(parameter-2-27)
     3407                             ,input no-lock
     3408                             ,input (buffer tt_contract-specif:handle)
     3409                             ,input parameter-4-27
     3410                             ,input parameter-5-27
     3411                             ) no-error.
     3412         .
     3413         assign
     3414           v-doc-rec = integer(return-value)
     3415           v-fltopend-rowid[1] = ?
     3416         .
     3417       end.
     3418       else do:
     3419         assign
     3420         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3421         parameter-3-27 =  "FOR EACH tt_contract-specif"
     3422         parameter-4-27 =
     3423           (
     3424             if (" tt_contract-specif.host-code = p-host-code " + " " + where-phrase-27) <> ""
     3425             then  substitute(' tt_contract-specif.host-code = &1 ', p-host-code )  + " " + where-phrase-27
     3426             else "true"
     3427           )
     3428         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3429         parameter-6-27 = if sort-phrase-27 = ''
     3430                              then
     3431           (
     3432           " " + "  " +
     3433             " " + sort-column-phrase +
     3434           " " + " "
     3435           )
     3436                              else
     3437           (
     3438           " " + "  " +
     3439             " " + sort-column-phrase +
     3440           " " + sort-phrase-27
     3441           )
     3442         parameter-7-27 =
     3443           "   "
     3444       .
     3445         run fltopend_fltfindq in this-procedure  (
     3446                             input this-procedure:handle
     3447                             ,input query spec-List:handle
     3448                             ,input logical(parameter-2-27)
     3449                             ,input no-lock
     3450                             ,input parameter-3-27
     3451                             ,input parameter-4-27
     3452                             ,input parameter-5-27
     3453                             ,input parameter-6-27
     3454                             ,input parameter-7-27
     3455                             ,output v-fltopend-rowid
     3456                             ) no-error.
     3457         .
     3458         v-doc-rec = ?.
     3459       end.
     3460       assign
     3461         l-query-was-opened = true
     3462       .
     3463     end.
     3464   end.
     3465     run waitfram-hide in this-procedure .
     3466     IF v-doc-rec <> ? THEN
     3467     DO:
     3468       REPOSITION spec-List to RECID v-doc-rec NO-ERROR.
     3469     END.
     3470     APPLY
     3471       "entry" to spec-List in frame Dialog-Frame.
     3472   END PROCEDURE.
     3473   PROCEDURE proc-add-ass :
     3474     define buffer bb_contract-specif for ub.contract-specif  .
     3475     define variable v-ass-m    as logical   no-undo init false .
     3476     define variable v-log      as logical   no-undo .
     3477     define variable p-rid-list as character no-undo .
     3478     if not can-find( first temp-conn) then
     3479     do:
     3480       message "Не выделено ни одного товара !" view-as alert-box .
     3481       return .
     3482     end.
     3483     if v-cntxt-db-num <> 0 then
     3484     do :
     3485       if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U) and
     3486         ub.assortment-matrix.db-num = v-cntxt-db-num )  then v-ass-m = true  .
     3487     end.
     3488     else
     3489     do:
     3490       if can-find ( first ub.assortment-matrix no-lock where  ub.assortment-matrix.asmt-status = integer ('0':U))  then v-ass-m = true  .
     3491     end.
     3492     if v-ass-m = false  then return .
     3493   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3494   do:
     3495     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3496       (input  v-cntxt-db-num
     3497       ,input  v-cntxt-userid
     3498       ,input  0
     3499       ,input  'actn_assort-matr-gds_add-def':U
     3500       ,input  'global':U
     3501       ,input  0
     3502       ,input  '':U
     3503       ,input  0
     3504       ,input  0
     3505       ,input  0
     3506       ,input  0
     3507       ,input  true
     3508       ,output v-log
     3509       )  .
     3510   end.
     3511     if not v-log then return  .
     3512     message "Добавить выбранные товары спецификации в Ассортиментные матрицы ?"
     3513       "Если ДА , укажите в какие."
     3514       view-as alert-box question
     3515       buttons yes-no
     3516       update v-okk as logical
     3517       .
     3518     if not v-okk then return .
     3519     run ref/assmatr.w (
     3520       input parParentProc
     3521       ,input "b-sel,b-mark"
     3522       ,input v-cntxt-obj-type
     3523       ,input v-cntxt-obj-code
     3524       ,input ?
     3525       ,input ?
     3526       ,input-output p-rid-list
     3527       ) no-error  .
     3528     if error-status :error then message
     3529         vss-workfile vss-revision vss-description skip
     3530         error-status :get-message(1) skip
     3531         return-value skip
     3532         ""
     3533         view-as alert-box error
     3534         .
     3535     run waitfram-show in this-procedure ( input "Добавление в Ассортиментные матрицы")  .
     3536     for each temp-conn,
     3537       first bb_contract-specif no-lock  where
     3538       recid(bb_contract-specif) = temp-conn.ri :
     3539       run add-assmatr in this-procedure ( input bb_contract-specif.gds-code
     3540         ,input p-rid-list) .
     3541     end.
     3542     run waitfram-hide in this-procedure .
     3543   END PROCEDURE.
     3544   PROCEDURE proc-export-excel :
     3545     run str/diallog.w (
     3546       input parParentProc
     3547       , input this-procedure
     3548       , input ("utl/thbjrumr.w":U + chr(4)
     3549       + chr(4)
     3550       + string(2)       + chr(4)
     3551       )
     3552       , input ('edoc':U + chr(4) +
     3553       'excel-export_specif':U + chr(4) +
     3554       string(buf_contract.contract-code)
     3555       )
     3556       , input no
     3557       , input ""
     3558       , input substitute("Экспорт спецификации в EXCEL") ) no-error .
     3559   END PROCEDURE.
     3560   PROCEDURE proc-export-text :
     3561     run str/diallog.w (
     3562       input parParentProc
     3563       , input this-procedure
     3564       , input ("utl/thbjrumr.w":U + chr(4)
     3565       + chr(4)
     3566       + string(2)       + chr(4)
     3567       )
     3568       , input ('edoc':U + chr(4) +
     3569       'text-export_specif':U + chr(4) +
     3570       string(buf_contract.contract-code)
     3571       )
     3572       , input no
     3573       , input "&Стоп"
     3574       , input substitute("Экспорт спецификации в текстовый файл") ) no-error .
     3575   END PROCEDURE.
     3576   PROCEDURE proc-find-code :
     3577     define input parameter p-next as logical no-undo.
     3578     define input parameter p-code as character no-undo .
     3579     define buffer buf_contract-specif for tt_contract-specif .
     3580     define variable row_spec as rowid   no-undo .
     3581     define variable loc#log  as logical no-undo .
     3582     assign
     3583       p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     3584     case RADIO-find :
     3585       when 1 then
     3586         do:
     3587           find first buf_contract-specif no-lock where string(buf_contract-specif.gds-code) begins p-code no-error .
     3588           if not available (buf_contract-specif) then message "Не найден код начинающийся с " + p-code
     3589               view-as alert-box.
     3590           if available buf_contract-specif then
     3591           do:
     3592             row_spec = rowid(buf_contract-specif).
     3593             loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     3594             reposition spec-List to rowid row_spec.
     3595           end.
     3596           apply "entry" to spec-List in frame Dialog-Frame.
     3597         end.
     3598       when 2 then
     3599         do:
     3600           find first buf_contract-specif no-lock where string(buf_contract-specif.artic) begins p-code no-error .
     3601           if not available (buf_contract-specif) then message "Не найден артикул начинающийся с " + p-code
     3602               view-as alert-box.
     3603           if available buf_contract-specif then
     3604           do:
     3605             row_spec = rowid(buf_contract-specif).
     3606             loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     3607             reposition spec-List to rowid row_spec.
     3608           end.
     3609           apply "entry" to spec-List in frame Dialog-Frame.
     3610         end.
     3611       when 3 then
     3612         do:
     3613           find first buf_contract-specif no-lock where string(buf_contract-specif.gds-name) begins p-code no-error .
     3614           if not available (buf_contract-specif) then message "Не найден товар начинающийся с " + p-code
     3615               view-as alert-box.
     3616           if available buf_contract-specif then
     3617           do:
     3618             row_spec = rowid(buf_contract-specif).
     3619             loc#log = spec-List:select-next-row () in frame Dialog-Frame.
     3620             reposition spec-List to rowid row_spec.
     3621           end.
     3622           apply "entry" to spec-List in frame Dialog-Frame.
     3623         end.
     3624       when 4 then
     3625         do:
     3626         end.
     3627     end.
     3628   END PROCEDURE.
