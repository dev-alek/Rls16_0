       36   define variable vss-revision    as character no-undo init "$Revision$":u .
       37   define variable vss-author      as character no-undo init "$Author$":u .
       38   define variable vss-date        as character no-undo init "$Date$":u .
       39   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       40   define variable vss-archive     as character no-undo init "$Archive$":u .
