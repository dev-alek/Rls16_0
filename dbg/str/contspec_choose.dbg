     1620        tt_contract-specif.cli-base-rate    COLUMN-LABEL '*'
     1621        tt_contract-specif.sum-cli   COLUMN-LABEL 'Сумма'
     1622        tt_contract-specif.vat-pc   COLUMN-LABEL 'НДС' Format ">>9.9"
     1623        tt_contract-specif.vat-type   COLUMN-LABEL 'тип!НДС'
     1624        tt_contract-specif.income-qnty   COLUMN-LABEL 'Принято'
