       42   procedure vss-get-info :
       43     define output parameter p-vss-revision    like vss-revision    no-undo .
       44     define output parameter p-vss-author      like vss-author      no-undo .
       45     define output parameter p-vss-date        like vss-date        no-undo .
       46     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       47     define output parameter p-vss-archive     like vss-archive     no-undo .
       48     define output parameter p-vss-description like vss-description no-undo .
       49     assign
       50       p-vss-revision    = vss-revision
       51       p-vss-author      = vss-author
       52       p-vss-date        = vss-date
       53       p-vss-workfile    = vss-workfile
       54       p-vss-archive     = vss-archive
       55       p-vss-description = vss-description
       56     .
       57   end procedure.
       58   procedure vss-get-parameters :
       59     define output parameter p-vss-parameters as character no-undo .
       60   end procedure.
       61   define new global shared variable g#vssrevis-logger as handle    no-undo .
       62   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       63   define variable v-vssrevis-logger                   as handle    no-undo .
       64   procedure vss-logevent :
       65     define input  parameter p-extra-paramters as character no-undo .
       66     define variable v-vssrevis-parameters as character no-undo .
       67     do
       68     on error undo, return error return-value
       69     :
       70       if  valid-handle(v-vssrevis-logger)
       71       and v-vssrevis-logger :get-signature("logevent") <> ""
       72       then do:
       73         run vss-get-parameters in this-procedure
       74           (output v-vssrevis-parameters
       75           ).
       76         run logevent in v-vssrevis-logger
       77           (input vss-workfile
       78           ,input vss-revision
       79           ,input v-vssrevis-parameters
       80           ,input p-extra-paramters
       81           ).
       82       end.
       83     end.
       84   end procedure.
       85   assign
       86     v-vssrevis-logger = g#vssrevis-logger
       87   .
       88   if  valid-handle(v-vssrevis-logger)
       89   and v-vssrevis-logger :get-signature("logevent") <> ""
       90   then do:
       91     assign
       92       v-vssrevis-logevent = true
       93     .
       94     run vss-logevent in this-procedure (input vss-description) .
       95   end.
       96   define new global shared variable g#language as character no-undo .
       97   if g#language <> '' and g#language <> 'rus':U then do:
       98     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       99   end.
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   define variable v-waitfram-action01         as character   no-undo .
      102   define variable v-waitfram-action02         as character   no-undo .
      103   define variable v-waitfram-action03         as character   no-undo .
      104   define variable mWaitFramTextBeg            as character   no-undo.
      105   define variable mWaitFramTextEnd            as character   no-undo.
      106   define variable mWaitFramView               as logical     no-undo.
      107   define variable mWaitProcEvent              as logical     no-undo init yes.
      108   define variable mWaitFramInterval           as integer     no-undo init 1 .
      109   define variable mWaitFramStop               as logical     no-undo.
      110   define variable mWaitFramStopUser           as logical     no-undo.
      111   define variable mWaitFramStopTimeOut        as logical     no-undo.
      112   define variable mWaitFramStartProc          as datetime-tz no-undo.
      113   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      114   define button B-WaitFramStop auto-end-key
      115        label "Стоп"
      116        size 10 by 1 tooltip "Остоновить процесс".
      117   define button B-viewProcInfo
      118        label "Информация"
      119        size 15 by 1 tooltip "Информация о процесс".
      120   define frame waitfram
      121     v-waitfram-action01 format "x(72)" no-label skip
      122     v-waitfram-action02 format "x(72)" no-label skip
      123     v-waitfram-action03 format "x(72)" no-label skip
      124     B-viewProcInfo
      125     B-WaitFramStop at row 4 col 30
      126     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      127     .
      128   define new global shared variable mBatchMode as logical no-undo init ?.
      129   define variable mFramBachModHandle as handle no-undo.
      130   mFramBachModHandle = frame waitfram:handle.
      131   define variable mFameOldVis as logical no-undo.
      132   define variable mVisCUrentVin as logical no-undo.
      133   if session:batch-mode
      134   then
      135      mBatchMode = yes.
      136   if mBatchMode = ? then do:
      137     mVisCUrentVin = current-window:visible.
      138     mFameOldVis = mFramBachModHandle:visible.
      139     mFramBachModHandle:visible  = yes.
      140     mBatchMode = mFramBachModHandle:visible ne yes.
      141     mFramBachModHandle:visible = mFameOldVis.
      142     current-window:visible = mVisCUrentVin.
      143   end.
      144    if  log-manager:logfile-name ne ?
      145     then DO:
      146         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      147         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      148         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      149     end.
      150   on choose of B-WaitFramStop in frame waitfram
      151   do:
      152     mWaitFramStop = yes.
      153     mWaitFramStopUser = yes.
      154   end.
      155   function waitfram-check-timeout returns logical():
      156      define variable vtime as int64 no-undo.
      157      if mWaitFramStopTimeOut
      158      then
      159         return yes.
      160      vtime = ( now - mWaitFramStartProc ) / 1000 .
      161      if     mWaitFramTimeOut ne ?
      162         and mWaitFramTimeOut ne 0
      163         and mWaitFramTimeOut lt vtime
      164      then do:
      165         mWaitFramStopTimeOut = yes.
      166      end.
      167      return mWaitFramStopTimeOut.
      168   end.
      169   procedure waitfram-hide :
      170     if not session:batch-mode
      171     then do
      172     on error undo, return error return-value
      173     :
      174       pause 0 before-hide .
      175       if not mBatchMode then
      176         hide frame waitfram .
      177     if     not mWaitFramView
      178        and mWaitProcEvent
      179     then
      180       process events .
      181     end.
      182   end procedure.
      183   procedure waitfram-show :
      184     define input  parameter p-message as character no-undo .
      185     define variable v-left-margin as integer   no-undo .
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       if length(p-message) <= 70 then do:
      191         assign
      192           v-left-margin = integer((70 - length(p-message)) / 2)
      193         .
      194         assign
      195           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      196         .
      197         assign
      198           v-waitfram-action01 = " "
      199           v-waitfram-action02 = " "
      200                                    + fill(" ", v-left-margin)
      201                                    + p-message
      202           v-waitfram-action03 = " "
      203         .
      204       end.
      205       else do:
      206         define variable vRindex1 as integer no-undo.
      207         define variable vRindex2 as integer no-undo.
      208         vRindex1 = r-index(p-message," ",70).
      209         if vRindex1 = 0
      210         then
      211            vRindex1 = 70.
      212         if length(p-message)  <= vRindex1 + 70 then do:
      213           assign
      214             v-waitfram-action01 = " "
      215             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      216             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      217           .
      218         end.
      219         else do:
      220           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      221           if vRindex2 <= vRindex1
      222           then
      223              vRindex2 = vRindex1 + 70.
      224           assign
      225             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      226             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      227             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      228           .
      229         end.
      230       end.
      231       B-viewProcInfo:visible   in frame waitfram = no.
      232       B-viewProcInfo:sensitive in frame waitfram = no.
      233       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      235       if  (   mWaitFramView
      236          or  mWaitProcEvent)
      237          and not mBatchMode
      238       then
      239          display
      240             v-waitfram-action01 skip
      241             v-waitfram-action02 skip
      242             v-waitfram-action03 skip
      243          with frame waitfram .
      244       if     mWaitFramView
      245          then do:
      246             if     mWaitFramInterval ne ?
      247                and not mBatchMode
      248             then
      249                wait-for go of frame waitfram pause mWaitFramInterval.
      250          end.
      251          else
      252             if     mWaitProcEvent
      253                and not mBatchMode
      254             then
      255                process events .
      256     end.
      257   end procedure.
      258      procedure waitfram-show-this:
      259         define input  parameter iInterval as int64 no-undo.
      260         define variable vtime as int64 no-undo.
      261         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      262         mWaitFramInterval = iInterval.
      263         run waitfram-show (substitute("&1&2 &3&4" ,
      264                                       mWaitFramTextBeg ,
      265                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      266                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      267                                       mWaitFramTextEnd
      268                                      )
      269                           ).
      270      end.
      271      procedure WaitFramRunPause:
      272         define input  parameter iInterval as dec no-undo.
      273         define variable vStart  as datetime-tz no-undo.
      274         define variable vend    as datetime-tz no-undo.
      275         define variable vint as int64 no-undo.
      276         define variable vOk as logical no-undo.
      277         vStart = now.
      278         vend   = vStart.
      279         publish "WaitFramPause" (iInterval,output vOk).
      280         vend   =  now.
      281         vint = vend - vStart.
      282         vint = iInterval - vint / 1000.
      283         if     not mWaitFramStop
      284            and (   vint > 0
      285                 or (    not vOk
      286                     and iInterval eq ?
      287                     )
      288                 )
      289         then
      290            run waitfram-show-this (iInterval).
      291         vend   =  now.
      292         vint = vend - vStart.
      293         vint = iInterval - vint / 1000.
      294         if     not mWaitFramStop
      295            and vint > 0
      296         then do:
      297            run gbl/pause.p (vint * 1000).
      298         end.
      299         if iInterval ne ?
      300         then
      301            publish "WaitFramStop".
      302         waitfram-check-timeout().
      303      end.
      304      procedure WaitFramWaitFor:
      305         define input  parameter iInterval as dec no-undo.
      306         assign
      307            mWaitFramStartProc   = now
      308            mWaitFramStopUser    = no
      309            mWaitFramStopTimeOut = no
      310         .
      311         block-wait:
      312         do while not mWaitFramStop:
      313            run WaitFramRunPause (iInterval).
      314            if  waitfram-check-timeout()
      315            then do:
      316               leave block-wait.
      317            end.
      318         end.
      319         run waitfram-hide.
      320      end.
      321   procedure waitfram-join :
      322     define input  parameter p-line-1  as character no-undo .
      323     define input  parameter p-line-2  as character no-undo .
      324     define input  parameter p-line-3  as character no-undo .
      325     define output parameter p-message as character no-undo .
      326     do
      327     on error undo, return error return-value
      328     :
      329       assign
      330         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      332                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      333       .
      334     end.
      335   end procedure.
      336   function waitfram-join-function returns character
      337     (input p-line-1 as character
      338     ,input p-line-2 as character
      339     ,input p-line-3 as character
      340     ).
      341     define variable v-message as character no-undo .
      342     run waitfram-join in this-procedure
      343       (input  p-line-1
      344       ,input  p-line-2
      345       ,input  p-line-3
      346       ,output v-message
      347       ) .
      348     return v-message .
      349   end function .
      350   define new global shared variable g#library  as handle no-undo .
      351   define new global shared variable g#library2 as handle no-undo .
      352   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   procedure cur-time :
      354      define output parameter p-today as date      no-undo .
      355      define output parameter p-time  as integer   no-undo .
      356     do
      357     on error undo, return error
      358     :
      359       define variable v-date1 as date      no-undo .
      360       define variable v-date2 as date      no-undo .
      361       define variable v-time  as integer   no-undo .
      362       assign
      363         v-date1 = today
      364         v-time  = time
      365         v-date2 = today
      366       .
      367       if v-date1 <> v-date2
      368       then do:
      369         assign
      370           v-date1 = today
      371           v-time  = v-time
      372         .
      373       end.
      374       assign
      375         p-today = v-date1
      376         p-time  = v-time
      377       .
      378     end.
      379   end.
      380   function cur-time-date returns character
      381   :
      382     return string(today, '99/99/9999':U) .
      383   end.
      384   function cur-time-mjd returns decimal
      385   :
      386     define variable v-date as date      no-undo .
      387     define variable v-time as integer   no-undo .
      388     run cur-time in this-procedure
      389       (output v-date
      390       ,output v-time
      391       ) .
      392     return integer(v-date) - 2400002 + (v-time / 86400) .
      393   end.
      394   function cur-time-get-ending-index returns integer
      395   (input p-number as integer
      396   )
      397   :
      398     if p-number < 0
      399     or p-number = ?
      400     then do:
      401       return 1 .
      402     end.
      403     define variable v-rest as integer   no-undo .
      404     assign
      405       p-number = p-number modulo 100
      406     .
      407     if p-number < 20
      408     then do:
      409       assign
      410         v-rest = p-number
      411       .
      412     end.
      413     else do:
      414       assign
      415         v-rest = p-number modulo 10
      416       .
      417     end.
      418     case v-rest :
      419       when 1
      420       then do:
      421         return 2 .
      422       end.
      423       when 2 or
      424       when 3 or
      425       when 4
      426       then do:
      427         return 3 .
      428       end.
      429       otherwise do:
      430         return 1 .
      431       end.
      432     end case .
      433   end.
      434   procedure cur-time-mjd-to-date :
      435      define input  parameter i-mjd-diff as decimal no-undo.
      436      define output parameter o-Date     as date    no-undo.
      437      define output parameter o-Time     as integer no-undo.
      438      define variable v-day-number as integer   no-undo .
      439      if    i-mjd-diff < 0
      440         or i-mjd-diff = ?
      441      then do:
      442         return "?" .
      443      end.
      444      assign
      445         v-day-number = truncate(i-mjd-diff,0).
      446         o-Date = date(v-day-number + 2400002).
      447         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      448     .
      449   end.
      450   function cur-time-mjd-to-string returns character
      451   (input p-mjd-diff as decimal
      452   )
      453   :
      454     define variable v-day-number as integer   no-undo .
      455     define variable v-seconds    as integer   no-undo .
      456     define variable v-hour       as integer   no-undo .
      457     define variable v-min        as integer   no-undo .
      458     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      459     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      460     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      461     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      462     if p-mjd-diff < 0
      463     or p-mjd-diff = ?
      464     then do:
      465       return "?" .
      466     end.
      467     assign
      468       v-day-number = integer(truncate(p-mjd-diff,0))
      469       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      470     .
      471     if v-seconds > 86400
      472     then do:
      473       assign
      474         v-seconds = 86400 - 1
      475       .
      476     end.
      477     if v-seconds < 0
      478     then do:
      479       assign
      480         v-seconds = 0
      481       .
      482     end.
      483     assign
      484       v-hour = truncate(v-seconds / 3600, 0)
      485     .
      486     assign
      487       v-seconds = v-seconds modulo 3600
      488     .
      489     assign
      490       v-min = truncate(v-seconds / 60, 0)
      491     .
      492     assign
      493       v-seconds = v-seconds modulo 60
      494     .
      495     return
      496         (if v-day-number <> 0
      497           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      498           else ""
      499         )
      500       + (if v-day-number <> 0 or v-hour <> 0
      501           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      502           else ""
      503         )
      504       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      505           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      506           else ""
      507         )
      508       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      509       .
      510   end.
      511   function cur-time-string returns character
      512   :
      513     define variable v-date as date      no-undo .
      514     define variable v-time as integer   no-undo .
      515     run cur-time in this-procedure
      516       (output v-date
      517       ,output v-time
      518       ) .
      519     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      520   end.
      521   function cur-time-string-sec returns character
      522   :
      523     define variable v-date as date      no-undo .
      524     define variable v-time as integer   no-undo .
      525     run cur-time in this-procedure
      526       (output v-date
      527       ,output v-time
      528       ) .
      529     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      530   end.
      531   function cur-time-custom  returns character
      532   (input p-prefix as character
      533   ,input p-date-format as character
      534   ,input p-delimiter as character
      535   ,input p-time-format as character
      536   ,input p-suffix as character
      537   )
      538   :
      539     define variable v-date as date      no-undo .
      540     define variable v-time as integer   no-undo .
      541     run cur-time in this-procedure
      542       (output v-date
      543       ,output v-time
      544       ) .
      545     return
      546       p-prefix
      547       + string(v-date, p-date-format)
      548       + p-delimiter
      549       + string(v-time, p-time-format)
      550       + p-suffix
      551       .
      552   end.
      553   function cur-time-print  returns character
      554   :
      555     define variable v-date as date      no-undo .
      556     define variable v-time as integer   no-undo .
      557     run cur-time in this-procedure
      558       (output v-date
      559       ,output v-time
      560       ) .
      561     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      562   end.
      563   function cur-time-datetime returns datetime
      564   :
      565     define variable v-char as character no-undo .
      566     define variable v-datetime as datetime no-undo .
      567     v-char = cur-time-string().
      568     v-datetime = datetime(v-char).
      569     return  v-datetime.
      570   end.
      571   function cur-time-string-msec returns character
      572   :
      573     define variable v-date as datetime  no-undo .
      574     v-date = now.
      575     return string(v-date) .
      576   end.
      577   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      579   define  shared variable RepPathName        as character no-undo .
      580   define  shared variable PrintRubl          as logical   no-undo .
      581   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   define  stream PrnLibStream.
      583   procedure prn-lib-prn-file :
      584     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      585     define input parameter p-DIsabledoptions as integer no-undo .
      586     define variable v-report-name as character no-undo .
      587     define variable v-user-action as character no-undo .
      588     define variable v-printed     as logical   no-undo .
      589     define variable v-exist       as logical   no-undo .
      590     do
      591       on error undo, return error
      592       :
      593       run prn-lib-get-report-name  in this-procedure (
      594         input parParentProc
      595         ,output v-report-name
      596         ).
      597   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      599     (input  v-report-name
      600     ,input  2
      601     ,output v-exist
      602     )  .
      603       if NOT v-exist then
      604       DO:
      605         Message
      606           "Нет заданий на печать ! "
      607           view-as alert-box .
      608         Return  .
      609       End.
      610       run gbl/prnfilen.w
      611         (input  ""
      612         ,input  p-DisabledOptions
      613         ,input  string(v-report-name )
      614         ,input  7
      615         ,output v-user-action
      616         ,output v-printed
      617         ) .
      618       if v-printed then
      619       do:
      620         return "YES" .
      621       end.
      622       else
      623       do:
      624         return "NO" .
      625       end.
      626     end.
      627   end procedure.
      628   procedure prn-lib-open-stream :
      629     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      630     define input parameter p-page-size    as integer no-undo .
      631     define input parameter p-is-stream    as logical no-undo .
      632     define input parameter p-append       as logical no-undo .
      633     define variable v-report-name as character no-undo .
      634     do
      635       on error undo, return error
      636       :
      637       run prn-lib-get-report-name  in this-procedure (
      638         input parParentProc
      639         ,output v-report-name
      640         ).
      641       if p-is-stream then
      642       do:
      643         if p-append then
      644         do:
      645           output stream PrnLibStream to value( v-report-name )
      646             page-size value(p-page-size) append .
      647         end.
      648         if not p-append then
      649         do:
      650           output stream PrnLibStream to value( v-report-name )
      651             page-size value(p-page-size) .
      652         end.
      653       end.
      654       if not p-is-stream then
      655       do:
      656         if p-append then
      657         do:
      658           output to value( v-report-name )
      659             page-size value(p-page-size) append .
      660         end.
      661         if not p-append then
      662         do:
      663           output to value( v-report-name )
      664             page-size value(p-page-size) .
      665         end.
      666       end.
      667     end.
      668   end procedure.
      669   procedure prn-lib-open-exp :
      670     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      671     define input parameter p-is-stream    as logical no-undo .
      672     define input parameter p-is-append    as logical no-undo .
      673     define output parameter p-ReportFileName as char init "report" no-undo.
      674     define output parameter p-process as logical no-undo .
      675     define variable glog as logical no-undo .
      676     do
      677       on error undo, return error
      678       :
      679       SYSTEM-DIALOG GET-FILE p-ReportFileName
      680         TITLE      "Укажите путь"
      681         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      682         ASK-OVERWRITE
      683         CREATE-TEST-FILE
      684         SAVE-AS
      685         USE-FILENAME
      686         DEFAULT-EXTENSION "txt"
      687         UPDATE glog
      688         .
      689       if not glog then  return.
      690       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      691       if p-is-stream then
      692       do:
      693         if p-is-append then
      694         do:
      695           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      696         end.
      697         else
      698         do:
      699           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      700         end.
      701       end.
      702       else
      703       do:
      704         if p-is-append then
      705         do:
      706           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      707         end.
      708         else
      709         do:
      710           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      711         end.
      712       end.
      713       p-process = yes.
      714     end.
      715   end procedure.
      716   procedure prn-lib-get-report-name :
      717     define input parameter parParentProc  as widget-handle no-undo.
      718     define output parameter p-report-name as character no-undo .
      719     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      720   end procedure.
      721   procedure prn-lib-reportviewer-report-name :
      722     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      723     define input parameter p-report-name-html as character no-undo .
      724     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      725   end procedure.
      726   procedure prn-lib-reportviewer :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-report-name-html as character no-undo .
      729     define input parameter p-param        as character no-undo .
      730     define variable v-excel           as character no-undo init 'TRUE' .
      731     define variable v-value-character as character no-undo .
      732     define variable v-value-integer   as character no-undo .
      733     define variable v-value-date      as date      no-undo .
      734     define variable v-value-decimal   as decimal   no-undo .
      735     define variable rep-excel         as logical   no-undo .
      736     define variable excel-string      as character no-undo .
      737     define variable v-param-type      as character no-undo .
      738     define variable v-tth             as handle    no-undo .
      739     run adm/shattri.p (
      740       input "get":U
      741       ,input  ""
      742       ,input  0
      743       ,input  'report-glob':U
      744       ,input  'rep-excel':U
      745       ,output v-value-character
      746       ,output v-value-date
      747       ,output v-value-decimal
      748       ,output v-value-integer
      749       ,output rep-excel
      750       ,output v-param-type
      751       ,INPUT-OUTPUT table-handle v-tth
      752       )  .
      753     if rep-excel then v-excel = "TRUE" .
      754     else v-excel = "FALSE" .
      755     if p-param eq ""
      756     then
      757        p-param = "EXCEL:" + v-excel.
      758     else
      759        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      760     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      761   end procedure.
      762   define new global shared variable g#libbcrcn as handle no-undo .
      763   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   procedure integerm :
      765     define input  parameter p-string      as character no-undo .
      766     define input  parameter p-allow-sign  as logical   no-undo .
      767     define input  parameter p-allow-comma as logical   no-undo .
      768     define output parameter p-value       as integer   no-undo .
      769     define output parameter p-data-valid  as logical   no-undo .
      770     define output parameter p-message     as character no-undo .
      771     define variable v-replace-string as character no-undo .
      772     do
      773     on error undo, return error return-value
      774     :
      775       if p-string = ?
      776       then do:
      777         assign
      778           p-value      = ?
      779           p-data-valid = false
      780           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      781         .
      782         return .
      783       end.
      784       if p-string = ""
      785       then do:
      786         assign
      787           p-value      = ?
      788           p-data-valid = false
      789           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      790         .
      791         return .
      792       end.
      793       assign
      794         p-value = integer(p-string) no-error
      795       .
      796       if error-status :error = true
      797       then do:
      798         assign
      799           p-value      = ?
      800           p-data-valid = false
      801           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      802                                    ,p-string
      803                                    )
      804         .
      805         return .
      806       end.
      807       if index(p-string, ' ':u) > 0
      808       then do:
      809         assign
      810           p-value      = ?
      811           p-data-valid = false
      812           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      813                                    + "Строка содержит символы пробела"
      814                                    ,p-string
      815                                    )
      816         .
      817         return .
      818       end.
      819       assign
      820         v-replace-string = p-string
      821         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      822         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      823         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      824         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      825         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      826         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      827         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      828         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      829         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      830       .
      831       if p-allow-sign = true
      832       then do:
      833         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      834         then do:
      835           assign
      836             v-replace-string = substring(v-replace-string, 2)
      837           .
      838         end.
      839       end.
      840       else do:
      841         if substring(v-replace-string, 1, 1) = '+':u
      842         then do:
      843           assign
      844             p-value      = ?
      845             p-data-valid = false
      846             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      847                                     + "Задан параметр недопустимости знака челого числа. "
      848                                     + "Строка содержит символ плюс. "
      849                                     ,p-string
      850                                     )
      851           .
      852           return .
      853         end.
      854         if substring(v-replace-string, 1, 1) = '-':u
      855         then do:
      856           assign
      857             p-value      = ?
      858             p-data-valid = false
      859             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      860                                     + "Задан параметр недопустимости знака челого числа. "
      861                                     + "Строка содержит символ минус. "
      862                                     ,p-string
      863                                     )
      864           .
      865           return .
      866         end.
      867       end.
      868       if p-allow-comma = true
      869       then do:
      870         assign
      871           v-replace-string = replace(v-replace-string, ',', '')
      872         .
      873       end.
      874       else do:
      875         if index(v-replace-string, ',') > 0
      876         then do:
      877           assign
      878             p-value      = ?
      879             p-data-valid = false
      880             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      881                                     + "Задан параметр недопустимости знака разделителя тысяч."
      882                                     + "Строка содержит знак разделителя тысяч. "
      883                                     ,p-string
      884                                     )
      885           .
      886           return .
      887         end.
      888       end.
      889       if index(p-string, '.') > 0
      890       then do:
      891         assign
      892           p-value      = ?
      893           p-data-valid = false
      894           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      895                                    + "Строка содержит знак десятичной точки"
      896                                    ,p-string
      897                                    )
      898         .
      899         return .
      900       end.
      901       if v-replace-string <> fill('9', length(v-replace-string))
      902       then do:
      903         assign
      904           p-value      = ?
      905           p-data-valid = false
      906           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      907                                    + "Встречены символы, недопустимые для целого числа '&2'"
      908                                    ,p-string
      909                                    ,replace(v-replace-string, '9', '')
      910                                    )
      911         .
      912         return .
      913       end.
      914       assign
      915         p-data-valid = true
      916         p-message    = ""
      917       .
      918     end.
      919   end procedure.
      920   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      922   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      923   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      924   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      925   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      926   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      927   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      928   procedure uf-name :
      929     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      930     define output parameter p-use-List_     as logical   no-undo .
      931     define output parameter p-type-List_     as character no-undo .
      932     define output parameter p-format-List_   as character no-undo .
      933     define output parameter p-use-Naim      as logical   no-undo .
      934     define output parameter p-type-Naim      as character no-undo .
      935     define output parameter p-format-Naim    as character no-undo .
      936     define output parameter p-use-print-graft as logical   no-undo .
      937     define output parameter p-use-sort-gr   as logical   no-undo .
      938     define output parameter p-use-type-price as logical   no-undo .
      939     define output parameter p-use-type-val  as logical   no-undo .
      940     define output parameter p-label          as character no-undo .
      941     define output parameter p-tooltip        as character no-undo .
      942     define output parameter p-user-can-edit  as logical   no-undo .
      943     define output parameter p-output-display as logical   no-undo .
      944     define output parameter p-other          as character no-undo .
      945     do
      946     on error undo, return error
      947     :
      948       case p-code :
      949               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      950               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      951               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      952               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      953               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      954               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      955               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      956               when 'findocs-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника платежей"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника платежей"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      957               when 'fin-obi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
