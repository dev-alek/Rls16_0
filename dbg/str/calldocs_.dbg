        1   define input  parameter iDocCode like ub.trn-doc.doc-code no-undo.
        2   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        3   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define buffer c-trn-doc for ub.c-trn-doc.
        9   DEFINE BUFFER X_c-obj-hist FOR c-trn-doc.
       10   DEFINE BUFFER find_c-obj-hist FOR c-trn-doc.
       11   DEFINE BUFFER X_curr-sysconf FOR sysconf.
       12   DEFINE BUFFER X_db FOR db.
       13   DEFINE BUFFER X_sysconf FOR sysconf.
       14   define input     parameter parParentProc  as widget-handle no-undo.
       15   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       16   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       17   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       18   define input parameter bttns  as char   no-undo .
       19   define input parameter p-mode  as char   no-undo .
       20   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       21   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       22   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       23   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       24   define input parameter p-chip-num  as int64 no-undo.
       25   define input-output param p-rid-list    as  char no-undo .
       26   if iDocCode <> ? then
       27   do:
       28     find first c-trn-doc no-lock where
       29                c-trn-doc.doc-code = iDocCode no-error.
       30     if not avail c-trn-doc then
       31     do:
       32       message "Документ не найден." view-as alert-box.
       33       return.
       34     end.
       35   end.
       36   run str/calldocs.w ( input  parparentproc,
       37                        input  if p-mode = "one" then "doc" else 'объект':U,
       38                        input  "",
       39                        input  "",
       40                        input  ?,
       41                        input  no,
       42                        input  "":U,
       43                        input  if iDocCode <> ? then iDocCode else "":U,
       44                        input  ?,
       45                        input  if avail trn-doc then recid(trn-doc) else ?,
       46                        input  p-curr-obj-type,
       47                        input  p-curr-obj-code,
       48                        output p-rid-list ).
