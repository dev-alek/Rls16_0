        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code           as character no-undo .
        3   define input  parameter p-gds-code           as integer   no-undo .
        4   define input  parameter p-update-doc         as logical   no-undo .
        5   define output parameter p-sort-mode          as integer   no-undo .
        6   define output parameter p-filter-mode        as integer   no-undo .
        7   define output parameter p-can-create-gds-dtl as logical   no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile: prt-mode.p $":U .
       12   define variable vss-archive     as character no-undo initial "$Archive: str/prt-mode.p $":U .
       13   define variable vss-description as character no-undo initial "Значение сортировки по умолчанию для интерфейса редактирования признаков".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2|&3':u,p-doc-code,p-gds-code,p-update-doc)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-root-node    as integer   no-undo .
       87   define variable v-empty-scale  as logical   no-undo .
       88   define variable v-to-doc-prt   as logical   no-undo .
       89   define variable v-from-doc-prt as logical   no-undo .
       90   define buffer buf_trn-doc for ub.trn-doc .
       91   do
       92   on error undo, return error return-value
       93   :
       94     find first buf_trn-doc no-lock
       95       where buf_trn-doc.doc-code = p-doc-code
       96       no-error .
       97     if not available buf_trn-doc
       98     then do:
       99       message
      100         vss-workfile vss-revision vss-description skip
      101         "Ошибка задания входных параметров" skip
      102         "Не найден документ" skip
      103         "Документ" p-doc-code skip
      104         view-as alert-box error .
      105       undo, return error return-value .
      106     end.
      107     if p-update-doc = true
      108     then do:
      109       assign
      110         p-can-create-gds-dtl = true
      111       .
      112     end.
      113     else do:
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
      116     (input  p-gds-code
      117     ,output v-root-node
      118     ) no-error .
      119       if error-status :error
      120       then do:
      121         message
      122           vss-workfile vss-revision vss-description skip
      123           "Ошибка при определении корневого признака товара" skip
      124           "Код товара" p-gds-code skip
      125           error-status :get-message(1) skip
      126           return-value skip
      127           view-as alert-box error .
      128         undo, return error return-value .
      129       end.
      130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      131     (input  v-root-node
      132     ,input  'empty-scale=request':u
      133     ,output v-empty-scale
      134     ) no-error .
      135       if error-status :error
      136       then do:
      137         message
      138           vss-workfile vss-revision vss-description skip
      139           "Ошибка при определении атрибута признака" skip
      140           "Код товара" p-gds-code skip
      141           "Признак" v-root-node skip
      142           "Запрашивался атрибут" "empty-scale=request" skip
      143           error-status :get-message(1) skip
      144           return-value skip
      145           view-as alert-box error .
      146         undo, return error return-value .
      147       end.
      148       if v-empty-scale <> true
      149       then do:
      150         if  buf_trn-doc.ext-doc-type = 'iv':U
      151         or  buf_trn-doc.ext-doc-type = 'rv':U
      152         or  ( ( buf_trn-doc.ext-doc-type = 'ie':U
      153                 or
      154                 buf_trn-doc.ext-doc-type = 're':U
      155               )
      156               and
      157               ( ( buf_trn-doc.hold-doc-code-child  <> '':u
      158                   and
      159                   buf_trn-doc.hold-doc-code-child  <> 'no-hold':u
      160                 )
      161                 or
      162                 ( buf_trn-doc.hold-doc-code-parent <> '':u
      163                   and
      164                   buf_trn-doc.hold-doc-code-parent <> 'no-hold':u
      165                 )
      166               )
      167             )
      168         then do:
      169   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      171     (input  buf_trn-doc.obj-type
      172     ,input  buf_trn-doc.obj-code
      173     ,input  'doc-prt=request':u
      174     ,output v-to-doc-prt
      175     ) no-error .
      176           if error-status:error then do:
      177             message
      178               vss-workfile vss-revision vss-description skip
      179               "Ошибка при определении атрибута объекта" skip
      180               "Документ" buf_trn-doc.doc-code skip
      181               "Объект на который производится перемещения" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
      182               "Атрибут" 'doc-prt=request':u skip
      183               error-status:get-message(1) skip
      184               return-value skip
      185               view-as alert-box error .
      186             undo, return error .
      187           end.
      188   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      190     (input  buf_trn-doc.cli-type
      191     ,input  buf_trn-doc.cli-code
      192     ,input  'doc-prt=request':u
      193     ,output v-from-doc-prt
      194     ) no-error .
      195           if error-status :error then do:
      196             message
      197               vss-workfile vss-revision vss-description skip
      198               "Ошибка при определении атрибута объекта" skip
      199               "Документ" buf_trn-doc.doc-code skip
      200               "Объект с которого производится перемещение" buf_trn-doc.cli-type buf_trn-doc.cli-code skip
      201               "Атрибут" 'doc-prt=request':u skip
      202               error-status :get-message(1) skip
      203               return-value skip
      204               view-as alert-box error .
      205             undo, return error .
      206           end.
      207           if  v-to-doc-prt   = true
      208           and v-from-doc-prt <> true
      209           then do:
      210             assign
      211               p-can-create-gds-dtl = true
      212             .
      213           end.
      214           else do:
      215             assign
      216               p-can-create-gds-dtl = false
      217             .
      218           end.
      219         end.
      220         else do:
      221           assign
      222             p-can-create-gds-dtl = false
      223           .
      224         end.
      225       end.
      226       else do:
      227         assign
      228           p-can-create-gds-dtl = false
      229         .
      230       end.
      231     end.
      232     if p-can-create-gds-dtl = true
      233     then do:
      234       assign
      235         p-sort-mode   = 2
      236         p-filter-mode = 3
      237       .
      238     end.
      239     else do:
      240       assign
      241         p-sort-mode   = 2
      242         p-filter-mode = 4
      243       .
      244     end.
      245   end.
