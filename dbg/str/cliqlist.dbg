     7163         view-as alert-box question buttons OK-Cancel update glog.
     7164         if not glog then do:
     7165           run Myenable in this-procedure .
     7166           return error.
     7167         end.
     7168         system-dialog get-file f-name
     7169         filters "Списки клиентов *.cli" "*.cli"
     7170         title "Выберите файл списка"
     7171         INITIAL-DIR "."
     7172         return-to-start-dir
     7173         must-exist
     7174         update glog
     7175         default-extension "cli".
     7176         if not glog then do:
     7177           run MyEnable in this-procedure .
     7178           return error.
     7179         end.
     7180         run create-cli-list-hist in this-procedure (
     7181                                               input 'ДОБАВЛЕНИЕ':U
     7182                                             , input-output v-seq
     7183                                             , input 0
     7184                                             , input '':U
     7185                                             , input substitute("Все клиенты из сохраненного в файле списка клиентов &1 &2", f-name, stat-line(rs-status))
     7186                                             , input tot-lns
     7187                                             , input rs-list-method
     7188                                             , input rs-status
     7189                                             , input f-name
     7190                                             , input '':U
     7191                                             , input ?
     7192                                             ).
     7193       end.
     7194       when "clob-data" then do:
     7195         glog = yes.
     7196         message "Все клиенты из ранее сохраненного в БД списка"
     7197         skip stat-line(rs-status)
     7198         view-as alert-box question buttons OK-Cancel update glog.
     7199         if not glog then do:
     7200           run Myenable in this-procedure.
     7201           return error.
     7202         end.
     7203         run ref/clobbnds.w ( input parparentproc
     7204                             ,input this-procedure:handle
     7205                             ,input 'b-sel'
     7206                             ,input "uniq-key-rec"
     7207                             ,input ""
     7208                             ,input 'list':U
     7209                             ,input 'cli-list'
     7210                             ,input -1
     7211                             ,input-output v-rid-list) no-error.
     7212         if v-rid-list = '' then do:
     7213           run Myenable in this-procedure.
     7214           return error.
     7215         end.
     7216         find first buf_clob-bind no-lock where
     7217                   recid(buf_clob-bind) = integer(v-rid-list) .
     7218         run gen-key-rec in this-procedure ( input 'clob-bind':U
     7219                                             ,input (buffer buf_clob-bind:handle)
     7220                                             ,output v-uniq-key-rec).
     7221         run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7222                                             , input-output v-seq
     7223                                             , input 0
     7224                                             , input '':U
     7225                                             , input substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, stat-line(rs-status))
     7226                                             , input tot-lns
     7227                                             , input rs-list-method
     7228                                             , input rs-status
     7229                                             , input v-uniq-key-rec
     7230                                             , input '':U
     7231                                             , input ?
     7232                                             ).
     7233       end.
     7234       WHEN "FILTER" THEN DO:
     7235         run trig-filter in this-procedure no-error.
     7236         if error-status:error then do:
     7237           run MyEnable in this-procedure .
     7238           return error.
     7239         end.
     7240       END.
     7241     end case.
     7242     if tot-lns <> 0 then do:
     7243       run get-operation in this-procedure ( input dsp-rs, output v-operation).
     7244       CASE v-operation:
     7245         when 1 then do:
     7246           run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7247         end.
     7248         when 2 then do:
     7249           run proc-b-del in this-procedure ( input no, input ?, input rs-list-method, input rs-status ) no-error  .
     7250         end.
     7251         when 3 then do:
     7252           run proc-b-rest in this-procedure ( input no, input ?, input rs-list-method, input rs-status) no-error  .
     7253         end.
     7254         otherwise do:
     7255           assign
     7256           dsp-rs = "":U.
     7257           run MyEnable in this-procedure .
     7258           return error.
     7259         end.
     7260       END CASE.
     7261     end.
     7262     assign
     7263     rs-list-method =  temp-list.fvalue
     7264       .
     7265     find last buf_cli-list-hist no-lock where
     7266               buf_cli-list-hist.id = (v-seq - 1)
     7267         and  buf_cli-list-hist.line = 0 no-error .
     7268     DISPLAY
     7269     (if available buf_cli-list-hist
     7270     then buf_cli-list-hist.des
     7271     else '') @ dsp-rs
     7272     with frame Dialog-Frame.
     7273     if tot-lns = 0
     7274     then do:
     7275       run proc-b-add in this-procedure ( input no, input ?, input rs-list-method, input rs-status)  .
     7276     end.
     7277   end.
     7278   END PROCEDURE.
     7279   PROCEDURE rs-do :
     7280   define input parameter p-from-macro as logical no-undo .
     7281   define input parameter p-step as logical no-undo .
     7282   define input parameter rs-list-method as character no-undo .
     7283   define input parameter rs-status as character no-undo .
     7284   define input parameter line-mode as character no-undo .
     7285   define input parameter p-id      as integer no-undo .
     7286   define variable grp-path like ub.goods.grp-name no-undo.
     7287   define variable imp-ART like ub.goods.ARTIC no-undo.
     7288   define variable scan-qnty as dec no-undo.
     7289   define variable imp-type like ub.goods.prod-type no-undo.
     7290   define variable imp-code like ub.goods.prod-code no-undo.
     7291   define variable v-report-num as integer no-undo .
     7292   define variable glog as logical no-undo .
     7293   define variable v-rowid   as rowid no-undo .
     7294   define variable v-tbl-name as character no-undo .
     7295   define variable v-obj-type as character  no-undo.
     7296   define variable v-obj-code as integer    no-undo.
     7297   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7298   define variable v-sum-1 as decimal no-undo .
     7299   define variable v-sum-2 as decimal no-undo .
     7300   define variable v-cashier-role-string as character no-undo .
     7301   define variable v-seller-role-string as character no-undo .
     7302   DEFINE VARIABLE v-today as date no-undo .
     7303   DEFINE VARIABLE v-time as integer no-undo .
     7304   define buffer buf_cli-list-hist for cli-list-hist.
     7305   do
     7306   on error undo, return error return-value
     7307   :
     7308   assign
     7309   lns-cnt = 0
     7310   lns-ignore = 0
     7311   v-num-add  = 0
     7312   v-num-ignored = 0
     7313   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7314   .
     7315   run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     7316   if session:set-wait-state( "COMPILER" )  then .
     7317   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7318   case rs-list-method:
     7319     when "cli-grp" then do:
     7320       for each buf_cli-list-hist where
     7321                buf_cli-list-hist.id = p-id
     7322           and  buf_cli-list-hist.item_ <> '':U:
     7323         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7324         grp-path = "".
     7325         find first ub.cli-grp no-lock where rowid(ub.cli-grp) = v-rowid.
     7326         grp-path = ''.
     7327         run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     7328         for each ub.clients no-lock where ub.clients.grp-name begins grp-path:
     7329           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7330         end.
     7331         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7332       end.
     7333     end.
     7334     when "cli"  then do:
     7335       for each buf_cli-list-hist where
     7336                buf_cli-list-hist.id = p-id
     7337           and  buf_cli-list-hist.item_ <> '':U:
     7338         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7339         find first ub.clients no-lock where rowid(ub.clients) = v-rowid.
     7340         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7341         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7342       end.
     7343     end.
     7344     when "prod" then do:
     7345       find first buf_cli-list-hist where
     7346                  buf_cli-list-hist.id = p-id .
     7347       for each ub.clients where ub.clients.is-prod = yes no-lock:
     7348         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7349       end.
     7350       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7351     end.
     7352     when "sup-gds" then do:
     7353       find first buf_cli-list-hist where
     7354                  buf_cli-list-hist.id = p-id .
     7355         for each ub.clients where ub.clients.sup-gds = yes no-lock:
     7356         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7357       end.
     7358       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7359     end.
     7360     when "sup-cons" then do:
     7361       find first buf_cli-list-hist where
     7362                  buf_cli-list-hist.id = p-id .
     7363       for each ub.clients where ub.clients.sup-cons = yes no-lock:
     7364         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7365       end.
     7366       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7367     end.
     7368     when "buy-gds" then do:
     7369       find first buf_cli-list-hist where
     7370                  buf_cli-list-hist.id = p-id .
     7371       for each ub.clients where ub.clients.buy-gds = yes no-lock:
     7372         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7373       end.
     7374       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7375     end.
     7376     when "buy-cons" then do:
     7377       find first buf_cli-list-hist where
     7378                  buf_cli-list-hist.id = p-id .
     7379       for each ub.clients where ub.clients.buy-cons = yes no-lock:
     7380         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7381       end.
     7382       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7383     end.
     7384     when "buy-serv" then do:
     7385       find first buf_cli-list-hist where
     7386                  buf_cli-list-hist.id = p-id .
     7387       for each ub.clients where ub.clients.buy-serv = yes no-lock:
     7388         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7389       end.
     7390       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7391     end.
     7392     when "dis-card" then do:
     7393       find first buf_cli-list-hist where
     7394                  buf_cli-list-hist.id = p-id .
     7395       for each ub.clients no-lock,
     7396           first ub.dis-card no-lock where
     7397                 ub.dis-card.cli-type = ub.clients.obj-type AND
     7398                 ub.dis-card.cli-code = ub.clients.obj-code:
     7399         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7400       end.
     7401       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7402     end.
     7403     when "cashiers" then do:
     7404       if v-cntxt-db-num <> 0 then do:
     7405         v-cashier-role-string = gbclcode-get-work-place  (
     7406                                                     input 'C':U
     7407                                                   ,input 'db':U
     7408                                                   ,input v-cntxt-db-num
     7409                                                   ,input 0
     7410                                                   ,input '':U
     7411                                                   ,input 0  ).
     7412       end.
     7413       run cur-time in this-procedure ( output v-today, output v-time).
     7414       find first buf_cli-list-hist where
     7415                  buf_cli-list-hist.id = p-id .
     7416       for each ub.staff no-lock where
     7417               ub.staff.role = 'C':U
     7418           and ub.staff.role-leve = 'db':U
     7419           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7420           and ub.staff.date-end >= v-today,
     7421          first ub.clients no-lock where
     7422                 ub.clients.obj-type = 'чел':U AND
     7423                 ub.clients.obj-code = staff.psn-code:
     7424         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7425       end.
     7426       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7427     end.
     7428     when "sellers" then do:
     7429       if v-cntxt-db-num <> 0  then do:
     7430         v-cashier-role-string = gbclcode-get-work-place  (
     7431                                                     input 'C':U
     7432                                                   ,input 'db':U
     7433                                                   ,input v-cntxt-db-num
     7434                                                   ,input 0
     7435                                                   ,input '':U
     7436                                                   ,input 0  ).
     7437       end.
     7438       run cur-time in this-procedure ( output v-today, output v-time).
     7439       find first buf_cli-list-hist where
     7440                  buf_cli-list-hist.id = p-id .
     7441       for each ub.staff no-lock where
     7442               ub.staff.role =  'S':U
     7443           and ub.staff.role-leve = 'db':U
     7444           and (v-cntxt-db-num = 0 or ub.staff.work-place = v-cashier-role-string)
     7445           and ub.staff.date-end >= v-today,
     7446               first ub.clients no-lock where
     7447                 ub.clients.obj-type = 'чел':U AND
     7448                 ub.clients.obj-code = ub.staff.psn-code:
     7449         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7450       end.
     7451       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7452     end.
     7453     when "firm" then do:
     7454       find first buf_cli-list-hist where
     7455                  buf_cli-list-hist.id = p-id .
     7456       for each ub.clients where ub.clients.obj-type = 'орг':U no-lock:
     7457         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7458       end.
     7459       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7460     end.
     7461     when "person" then do:
     7462       find first buf_cli-list-hist where
     7463                  buf_cli-list-hist.id = p-id .
     7464       for each ub.clients where ub.clients.obj-type = 'чел':U no-lock:
     7465         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7466       end.
     7467       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7468     end.
     7469     when "shop" then do:
     7470       find first buf_cli-list-hist where
     7471                  buf_cli-list-hist.id = p-id .
     7472       for each ub.clients where ub.clients.obj-type = 'маг':U no-lock:
     7473         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7474       end.
     7475       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7476     end.
     7477     when "store" then do:
     7478       find first buf_cli-list-hist where
     7479                  buf_cli-list-hist.id = p-id .
     7480       for each ub.clients where ub.clients.obj-type = 'скл':U no-lock:
     7481         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7482       end.
     7483       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7484     end.
     7485    when "waybill" then do:
     7486      for each buf_cli-list-hist where
     7487               buf_cli-list-hist.id = p-id
     7488         and  buf_cli-list-hist.item_ <> '':U:
     7489         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7490         find first ub.trn-doc no-lock where
     7491                   rowid(ub.trn-doc) = v-rowid no-error.
     7492         if available ub.trn-doc then do:
     7493           FIND FIRST ub.clients No-LOCK WHERE
     7494                     ub.clients.obj-type = ub.trn-doc.cli-type AND
     7495                     ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     7496           if avail ub.clients then
     7497           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7498         end.
     7499         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7500       end.
     7501    end.
     7502    when "attr" or when "attr-val" then do:
     7503       find first buf_cli-list-hist where
     7504                buf_cli-list-hist.id = p-id
     7505            AND buf_cli-list-hist.item_ <> '':U no-error .
     7506       assign
     7507       v-obj-type = entry(1, buf_cli-list-hist.item_, chr(3))
     7508       v-obj-code = integer(entry(2, buf_cli-list-hist.item_, chr(3)))
     7509       v-attr-code = entry(3, buf_cli-list-hist.item_, chr(3))
     7510       vvalue = (if rs-list-method = "attr" then '':U else entry(4, buf_cli-list-hist.item_, chr(3)))
     7511       no-error
     7512       .
     7513       if error-status:error then do:
     7514       end.
     7515       else do:
     7516         for each ub.clients no-lock,
     7517           first ub.clients-attr No-LOCK WHERE
     7518                 ub.clients-attr.obj-type = ub.clients.obj-type AND
     7519                 ub.clients-attr.obj-code = ub.clients.obj-code AND
     7520                ub.clients-attr.attr-code = v-attr-code
     7521           :
     7522           if rs-list-method = "attr-val" then do:
     7523             run clntattr-value in this-procedure (
     7524                               input ub.clients.obj-type
     7525                              ,input ub.clients.obj-code
     7526                              ,input v-attr-code
     7527                              ,output vvalue1
     7528                              ,output vtype1).
     7529             if vvalue1 <> vvalue then NEXT.
     7530           end.
     7531           run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7532         end.
     7533         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7534       end.
     7535     end.
     7536     when "grp-buy"  then do:
     7537       for each buf_cli-list-hist where
     7538                buf_cli-list-hist.id = p-id
     7539           and  buf_cli-list-hist.item_ <> '':U:
     7540         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_cli-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     7541         grp-path = "".
     7542         find first ub.buyer-group no-lock where rowid(ub.buyer-group) = v-rowid.
     7543         for each ub.clients no-lock,
     7544             first ub.buyer-in-buyer-group No-LOCK WHERE
     7545                   ub.buyer-in-buyer-group.stts         = 0
     7546               and ub.buyer-in-buyer-group.bbg-obj-type = ub.clients.obj-type
     7547               and ub.buyer-in-buyer-group.bbg-obj-code = ub.clients.obj-code
     7548               and ub.buyer-in-buyer-group.bgr-id       = ub.buyer-group.bgr-id
     7549               and ub.buyer-in-buyer-group.bgr-db-num   = ub.buyer-group.bgr-db-num:
     7550           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7551         end.
     7552         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7553       end.
     7554     end.
     7555     when "turnov-buy"  then do:
     7556       find first buf_cli-list-hist where
     7557                  buf_cli-list-hist.id = p-id
     7558           and    buf_cli-list-hist.item_ <> '':U.
     7559       assign
     7560       v-sum-1 = decimal(entry(1, buf_cli-list-hist.item_, chr(3)))
     7561       v-sum-2 = decimal(entry(2, buf_cli-list-hist.item_, chr(3)))
     7562       no-error
     7563       .
     7564       if error-status:error then do:
     7565       end.
     7566       else do:
     7567         run str/two-sum.w (  input  'calc'
     7568                         ,input-output v-sum-1
     7569                         ,input-output v-sum-2
     7570                         ,output table temp-list-buyer
     7571                     ) .
     7572         if not can-find(first temp-list-buyer) then return.
     7573         for each temp-list-buyer,
     7574             first clients no-lock where
     7575                 clients.obj-type = temp-list-buyer.obj-type
     7576             and clients.obj-code = temp-list-buyer.obj-code:
     7577           run ex-CLI in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7578         end.
     7579         empty temp-table temp-list-buyer.
     7580         assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7581       end.
     7582     end.
     7583     when "doc-list"
     7584     or
     7585     when "gds-list"
     7586     or
     7587     when "file"
     7588     or
     7589     when "clob-data"
     7590     then do:
     7591       run proc-file-list-methods in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id).
     7592     end.
     7593     when "deleted" then do:
     7594       find first buf_cli-list-hist where
     7595                  buf_cli-list-hist.id = p-id .
     7596       for each clients where clients.stts <> 0 no-lock:
     7597         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7598       end.
     7599       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7600     end.
     7601     when "filter" then do:
     7602       define variable v-filter-var as character no-undo .
     7603       find first buf_cli-list-hist where
     7604                buf_cli-list-hist.id = p-id
     7605            AND buf_cli-list-hist.item_ <> '':U .
     7606       run proc-write-filter-expression-var in this-procedure ( input buf_cli-list-hist.item_, output v-filter-var ).
     7607       run gbl/cli-fill.p (
     7608                        input "Формирование списка по фильтру (без учета сортировки)"
     7609                      , input rs-list-method
     7610                      , input rs-status
     7611                      , input line-mode
     7612                      , input v-filter-var
     7613                      , output lns-cnt
     7614                      , output line-rec
     7615                      )  .
     7616        assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7617     end.
     7618     when "all" then do:
     7619       find first buf_cli-list-hist where
     7620                  buf_cli-list-hist.id = p-id .
     7621       for each clients no-lock:
     7622         run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     7623       end.
     7624       assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7625     end.
     7626   END CASE.
     7627   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     7628   if session:set-wait-state( "" )  then .
     7629   case line-mode :
     7630     when 'ДОБАВЛЕНИЕ':U then do:
     7631       tot-lns = tot-lns + lns-cnt.
     7632     end.
     7633     when 'удаление':U then do:
     7634       tot-lns = tot-lns - lns-cnt.
     7635     end.
     7636   end.
     7637   if line-mode <> 'ОСТАВИТЬ':U then
     7638     run Myenable in this-procedure .
     7639   end.
     7640   END PROCEDURE.
     7641   PROCEDURE trig-attr :
     7642   define input parameter rs-list-method as character no-undo .
     7643   define variable ii as integer no-undo.
     7644   define variable glog as logical no-undo .
     7645   DEFINE VARIABLE vattr-codes          as character           no-undo.
     7646   DEFINE VARIABLE vattr-labels         as character           no-undo.
     7647   DEFINE VARIABLE vtooltip             as character           no-undo.
     7648   DEFINE VARIABLE vlabel               as character           no-undo .
     7649   DEFINE VARIABLE vtype                as character           no-undo .
     7650   DEFINE VARIABLE vformat              as character           no-undo .
     7651   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
     7652   DEFINE VARIABLE voutput-display      as logical             no-undo .
     7653   DEFINE VARIABLE vother               as character           no-undo .
     7654   DEFINE VARIABLE v-ref-list           as character           no-undo .
     7655   DEFINE VARIABLE jj                   as integer             no-undo .
     7656   DEFINE VARIABLE v-spr                as character           no-undo .
     7657   DEFINE VARIABLE v-spr-param          as character           no-undo .
     7658   DEFINE VARIABLE v-setted             as logical             no-undo .
     7659   define variable v-init               as character           no-undo .
     7660   define variable v-item               as character           no-undo .
     7661   DEFINE VARIABLE v-attr-code          as character           no-undo .
     7662   assign
     7663   ref-list = ""
     7664   vattr-codes = ""
     7665   vattr-labels = ""
     7666   vvalue = ""
     7667   .
     7668   DO ii = 1 to num-entries('doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U):
     7669       run clntattr-code in this-procedure (
     7670                                            input entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7671                                           ,output vtype
     7672                                           ,output vformat
     7673                                           ,output vlabel
     7674                                           ,output vuser-can-edit
     7675                                           ,output voutput-display
     7676                                           ,output vother) no-error.
     7677       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
     7678           assign
     7679           vattr-codes = vattr-codes + chr(4) + entry(ii, 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U)
     7680           vattr-labels = vattr-labels + chr(4) + vlabel
     7681           .
     7682       end.
     7683   end.
     7684   run gbl/d-list.w (
     7685                      input "b-sel":U
     7686                     ,input "Выберите атрибут"
     7687                     ,input vattr-codes
     7688                     ,input vattr-labels
     7689                     ,input chr(4)
     7690                     ,input "":U
     7691                     ,output v-attr-code).
     7692   if v-attr-code = "" then do:
     7693     return error.
     7694   end.
     7695   glog = yes.
     7696   if rs-list-method = "attr" then do:
     7697       run clntattr-tooltip in this-procedure ( input v-attr-code,
     7698                            output vtooltip,
     7699                            output vlabel).
     7700       message "Все клиенты с установленным атрибутом " + vlabel
     7701               view-as alert-box question buttons OK-Cancel update glog.
     7702       if not glog then do:
     7703         return error.
     7704       end.
     7705       assign
     7706       dsp-rs = substitute("ВСЕ клиенты с установленным атрибутом &1: &2", vlabel, stat-line(rs-status))
     7707       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code
     7708       .
     7709   end.
     7710   else do:
     7711       run clntattr-code in this-procedure (
     7712                                             input v-attr-code
     7713                                           ,output vtype
     7714                                           ,output vformat
     7715                                           ,output vlabel
     7716                                           ,output vuser-can-edit
     7717                                           ,output voutput-display
     7718                                           ,output vother).
     7719       run gbl/d-prompt.w (
     7720         'title=':u + "Значение атрибута клиента" + '\':u
     7721       + 'text1=':u + vlabel + '\':u
     7722       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     7723       + 'type=' + vtype + '\':u
     7724       + 'fillin_row=2\':u
     7725       + 'fillin_col=4\':u
     7726       + 'fillin_width=20\':u
     7727       + 'fillin_height=1\':u
     7728       + 'max-chars=70\':u
     7729       + 'readonly=no\':u
     7730       , input-output vvalue
     7731       ).
     7732       if return-value = 'false':U then do:
     7733         return error.
     7734       end.
     7735       message ("Все клиенты с атрибутом " + vlabel + " = ":U + vvalue)
     7736               view-as alert-box question buttons OK-Cancel update glog.
     7737       if not glog then do:
     7738         return error.
     7739       end.
     7740       assign
     7741       dsp-rs = substitute("Все клиенты с атрибутом &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
     7742       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code + chr(3) + vvalue
     7743       .
     7744   end.
     7745   v-no-hist = 0.
     7746   run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     7747                                       , input-output v-seq
     7748                                       , input 0
     7749                                       , input '':U
     7750                                       , input dsp-rs
     7751                                       , input tot-lns
     7752                                       , input rs-list-method
     7753                                       , input rs-status
     7754                                       , input v-item
     7755                                       , input '':U
     7756                                       , input ?
     7757                                       ).
     7758   END PROCEDURE.
     7759   PROCEDURE trig-filter :
     7760   define variable glog as logical no-undo .
     7761   define variable v-flt-rec as recid no-undo .
     7762   define variable v-filter-name as character no-undo .
     7763   define variable where-phrase as character no-undo .
     7764   define variable sort-phrase as character no-undo .
     7765   define variable where-phrase-rus as character no-undo .
     7766   define variable sort-phrase-rus as character no-undo .
     7767   glog = yes.
     7768   message
     7769   "Все клиенты, выбранные в соответствии с заданным фильтром  (без учета сортировки)."
     7770    view-as alert-box question buttons OK-Cancel update glog.
     7771   if not glog then do:
     7772     return error.
     7773   end.
     7774   assign
     7775   c-point = "cli-list" + chr(4) + "Список клиентов" + chr(4) + "no"
     7776   .
     7777    assign
     7778       tbl = 'clients'
     7779       join-tbl = ''
     7780       fld = ""
     7781       lab = ""
     7782       spr = ""
     7783       dim = '0'
     7784       .
     7785       run fltfield-add in this-procedure('obj-type*obj-code', 'Клиент', 'cli',
     7786                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7787       run fltfield-add in this-procedure('obj-type', 'Тип', '',
     7788                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7789       run fltfield-add in this-procedure('obj-code', 'Код', '',
     7790                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7791       run fltfield-add in this-procedure ('obj-name', 'Название', '',
     7792                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7793       run fltfield-add in this-procedure('stts', 'Статус', '',
     7794                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7795       run fltfield-add in this-procedure('is-prod', 'Производитель', '',
     7796                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7797       run fltfield-add in this-procedure('grp-name', 'Название группы', 'cligrp',
     7798                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7799       run fltfield-add in this-procedure('sup-gds', 'Поставщик товаров', '',
     7800                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7801       run fltfield-add in this-procedure('sup-cons', 'Консигнант', '',
     7802                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7803       run fltfield-add in this-procedure('buy-gds', 'Покупатель товаров', '',
     7804                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7805       run fltfield-add in this-procedure('buy-cons', 'Покупатель консигнационных товаров', '',
     7806                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7807       run fltfield-add in this-procedure('buy-serv', 'Покупатель услуг', '',
     7808                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7809       run fltfield-add in this-procedure('lim-kr', 'Лимит кредита', '',
     7810                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7811       run fltfield-add in this-procedure('PS', 'Примечание', '',
     7812                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7813       run fltfield-add in this-procedure('db-num', 'Номер БД', '',
     7814                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     7815   run gbl/filter.w ( input parparentproc
     7816                    , input c-point
     7817                    , input tbl
     7818                    , input join-tbl
     7819                    , input fld
     7820                    , input lab
     7821                    , input spr
     7822                    , input dim).
     7823   run gbl/flt-get.p (
     7824                    input  c-point
     7825                   ,output v-flt-rec
     7826                   ,output v-filter-name
     7827                   ,output where-phrase
     7828                   ,output sort-phrase
     7829                   ,output where-phrase-rus
     7830                   ,output sort-phrase-rus  ).
     7831   if v-flt-rec = ? then do:
     7832     run MyENable in this-procedure .
     7833     return error.
     7834   end.
     7835   else do:
     7836     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     7837     run create-cli-list-hist in this-procedure (
     7838                                           input 'ДОБАВЛЕНИЕ':U
     7839                                         , input-output v-seq
     7840                                         , input 0
     7841                                         , input '':U
     7842                                         , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     7843                                         , input tot-lns
     7844                                         , input rs-list-method
     7845                                         , input rs-status
     7846                                         , input ubflt.filter.where-ysl
     7847                                         , input '':U
     7848                                         , input ?
     7849                                         ).
     7850   end.
     7851   END PROCEDURE.
     7852   PROCEDURE trig-grp-buy :
     7853   define variable glog as logical no-undo .
     7854   define variable ii as integer no-undo.
     7855   define variable v-ref-list as character no-undo .
     7856   define variable v-recs as integer no-undo.
     7857   define variable v-ref-rec as recid no-undo .
     7858   define variable v-temp-seq as integer no-undo .
     7859   define variable v-line as integer no-undo .
     7860   define variable v-item as character no-undo .
     7861   define variable v-tbl-name as character no-undo .
     7862   define variable v-bh as handle no-undo .
     7863   define variable v-tot-lns as integer no-undo .
     7864   define buffer buf_buyer-group for ub.buyer-group.
     7865   glog = yes.
     7866   message "Все покупатели по группе."
     7867   skip stat-line(rs-status)
     7868   view-as alert-box question buttons OK-Cancel update glog.
     7869   if not glog then do:
     7870     return error.
     7871   end.
     7872   run ref/gr-bupr.w (
     7873        input parparentproc
     7874       ,input "b-sel":U
     7875       ,input-output v-ref-list )
     7876       .
     7877   if v-ref-list = "" then do:
     7878     return error.
     7879   end.
     7880   v-recs = num-entries (v-ref-list) .
     7881   do num-rec = 0 to v-recs:
     7882     if v-recs = 1 then do:
     7883       num-rec = 1 .
     7884     end.
     7885     if num-rec > 0 then do:
     7886       v-ref-rec = integer (entry (num-rec, v-ref-list)).
     7887       find first buf_buyer-group no-lock where recid (buf_buyer-group) = v-ref-rec no-error .
     7888     end.
     7889     if v-recs = 1 then do:
     7890       assign
     7891       v-temp-seq = v-seq
     7892       v-line     = 0
     7893       dsp-rs = substitute("Из группы покупателей :&1 &2", buf_buyer-group.name, stat-line(rs-status))
     7894       v-item     = '':U
     7895       v-tbl-name = 'buyer-group':U
     7896       v-bh       = buffer buf_buyer-group:handle
     7897       v-tot-lns = tot-lns
     7898       .
     7899     end.
     7900     else do:
     7901       if num-rec = 0 then do:
     7902         assign
     7903         v-temp-seq = v-seq
     7904         v-line     = 0
     7905         dsp-rs = substitute("Из групп покупателей : &1", stat-line(rs-status))
     7906         v-item     = '':U
     7907         v-tbl-name = '':U
     7908         v-bh       = ?
     7909         v-tot-lns = tot-lns
     7910         .
     7911       end.
     7912       else do:
     7913         assign
     7914         v-temp-seq = v-seq - 1
     7915         v-line     = num-rec
     7916         dsp-rs = substitute("&1", buf_buyer-group.name)
     7917         v-item     = '':U
     7918         v-tbl-name = 'buyer-group':U
     7919         v-bh       = buffer buf_buyer-group:handle
     7920         v-tot-lns = tot-lns + num-rec
     7921         .
     7922       end.
     7923     end.
     7924     v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7925     run create-cli-list-hist in this-procedure (
     7926                                           input 'ДОБАВЛЕНИЕ':U
     7927                                         , input-output v-temp-seq
     7928                                         , input v-line
     7929                                         , input '':U
     7930                                         , input dsp-rs
     7931                                         , input v-tot-lns
     7932                                         , input rs-list-method
     7933                                         , input rs-status
     7934                                         , input v-item
     7935                                         , input v-tbl-name
     7936                                         , input v-bh
     7937                                         ).
     7938     if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7939   end.
     7940   END PROCEDURE.
     7941   PROCEDURE trig-turnov-buy :
     7942   define variable glog as logical no-undo .
     7943   define variable ii as integer no-undo.
     7944   define variable v-ref-list as character no-undo .
     7945   define variable v-sum-1 as decimal   no-undo .
     7946   define variable v-sum-2 as decimal   no-undo .
     7947   for each temp-list-buyer :
     7948     delete temp-list-buyer.
     7949   end.
     7950   run str/two-sum.w (  input 'sums'
     7951                   ,input-output v-sum-1
     7952                   ,input-output v-sum-2
     7953                   ,output table temp-list-buyer
     7954                   ) .
     7955   if v-sum-2 = ?  then do:
     7956     return error.
     7957   end.
     7958   glog = yes.
     7959   message
     7960   "Все покупатели c оборотом в интервале " skip
     7961   v-sum-1 " " v-sum-2 skip
     7962   view-as alert-box question buttons OK-Cancel update glog.
     7963   if not glog then do:
     7964     return error.
     7965   end.
     7966   run create-cli-list-hist in this-procedure (
     7967                   input 'ДОБАВЛЕНИЕ':U
     7968                 , input-output v-seq
     7969                 , input 0
     7970                 , input '':U
     7971                 , input substitute ('Все покупатели c оборотом в интервале с &1 по &2: &3'
     7972                                     , v-sum-1
     7973                                     , v-sum-2
     7974                                     , stat-line(rs-status))
     7975                 , input tot-lns
     7976                 , input rs-list-method
     7977                 , input rs-status
     7978                 , input (string(v-sum-1) + chr(3) + string(v-sum-2))
     7979                 , input ""
     7980                 , input ?
     7981                 ).
     7982   END PROCEDURE.
     7983   PROCEDURE write-hist :
     7984   define input parameter p-from-macro as logical no-undo .
     7985   define input parameter rs-list-method as character no-undo .
     7986   define input parameter rs-status as character no-undo .
     7987   define input parameter line-mode as character no-undo .
     7988   define variable v-ii as integer no-undo .
     7989   define variable v-temp-seq as integer no-undo .
     7990   if rs-list-method = "single" then do:
     7991     if v-no-hist < 0 then do:
     7992       run create-cli-list-hist in this-procedure (
     7993                                             input 'ДОБАВЛЕНИЕ':U
     7994                                           , input-output v-seq
     7995                                           , input 0
     7996                                           , input get-hist-mode(line-mode)
     7997                                           , input substitute("КЛИЕНТ &1&2 ", cli-list.obj-type, cli-list.obj-code)
     7998                                           , input tot-lns
     7999                                           , input rs-list-method
     8000                                           , input rs-status
     8001                                           , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8002                                           , input '':U
     8003                                           , input ?
     8004                                           ).
     8005     end.
     8006     else do:
     8007       v-temp-seq = v-seq - 1.
     8008       do v-ii = 0 to v-no-hist:
     8009         run create-cli-list-hist in this-procedure ( input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8010                                             , input-output v-temp-seq
     8011                                             , input v-ii
     8012                                             , input get-hist-mode(line-mode)
     8013                                             , input substitute("КЛИЕНТ &12", cli-list.obj-type, cli-list.obj-code)
     8014                                             , input tot-lns
     8015                                             , input '':U
     8016                                             , input '':U
     8017                                             , input ('clients':U + chr(3) + cli-list.obj-type + chr(3) + string(cli-list.obj-code))
     8018                                             , input '':U
     8019                                             , input ?
     8020                                             ).
     8021       end.
     8022     end.
     8023   end.
     8024   else do:
     8025     v-temp-seq = v-seq - 1.
     8026     do v-ii = 0 to v-no-hist:
     8027       run create-cli-list-hist in this-procedure (
     8028                                             input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8029                                           , input-output  v-temp-seq
     8030                                           , input v-ii
     8031                                           , input get-hist-mode(line-mode)
     8032                                           , input '':U
     8033                                           , input tot-lns
     8034                                           , input rs-list-method
     8035                                           , input '':U
     8036                                           , input '':U
     8037                                           , input '':U
     8038                                           , input ?
     8039                                           ).
     8040     end.
     8041   end.
     8042   END PROCEDURE.
     8043   FUNCTION is-cashierc RETURNS CHARACTER
     8044   ( input loc-type as character, input loc-code as integer ) :
     8045     if loc-type <> 'чел':U
     8046     then return "".
     8047     return string( gbclcode-is-psn-role ( input 'C':U, input loc-code, input ?)).
     8048   END FUNCTION.
     8049   FUNCTION is-dis-cardc RETURNS CHARACTER
     8050   ( input loc-type as character, input loc-code as integer ) :
     8051     FIND ub.dis-card No-LOCK WHERE
     8052          ub.dis-card.cli-type = loc-type AND
     8053          ub.dis-card.cli-code = loc-code No-ERROR.
     8054     if avail ub.dis-card then return ub.dis-card.d-card.
     8055     else do:
     8056       if AMBIGUOUS dis-card then do:
     8057           return "............":U.
     8058       end.
     8059       else return "".
     8060     end.
     8061   END FUNCTION.
     8062   FUNCTION is-sellerc RETURNS CHARACTER
     8063   ( input loc-type as character, input loc-code as integer ) :
     8064     if loc-type <> 'чел':U
     8065     then return "".
     8066     return string( gbclcode-is-psn-role ( input 'S':U, input loc-code, input ?)).
     8067   END FUNCTION.
     8068   FUNCTION stat-line RETURNS CHARACTER
     8069     ( input p-status-chr as character ) :
     8070   DEFINE VARIABLE var-stat-line as character no-undo .
     8071   CASE p-status-chr:
     8072     when 'все':U then do:
     8073       assign
     8074       var-stat-line = "(текущие и удаленные клиенты)"
     8075       .
     8076     end.
     8077     when 'текущие':U then do:
     8078       assign
     8079       var-stat-line = "(текущие клиенты)"
     8080       .
     8081     end.
     8082     when 'удаленные':U then do:
     8083       assign
     8084       var-stat-line = "(удаленные клиенты)"
     8085       .
     8086     end.
     8087   END CASE.
     8088   return var-stat-line .
     8089   END FUNCTION.
