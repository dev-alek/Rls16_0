     6932         run str/all-docs.w (input parparentproc
     6933                       ,input (if v-docs-all
     6934                               then ?
     6935                               else v-cntxt-host-code-obj)
     6936                       ,input (if v-docs-all
     6937                               then ?
     6938                               else v-cntxt-obj-type)
