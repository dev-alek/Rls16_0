     2941        SIZE 20 BY 1 TOOLTIP "Добавить в список клиентов 1 строку".
     2942   DEFINE BUTTON B-clear-macro
     2943        IMAGE-UP FILE "cmp/fstop.bmp":U
     2944        IMAGE-DOWN FILE "cmp/fstopi.bmp":U
     2945        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     2946        LABEL "&[ ]"
     2947        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     2948   DEFINE BUTTON B-clr
     2949        LABEL "Очи&стить"
     2950        SIZE 10 BY 1 TOOLTIP "Удалить из списка всех клиентов".
     2951   DEFINE BUTTON B-del
     2952        LABEL "&-Удал. строку"
     2953        SIZE 20 BY 1 TOOLTIP "Удаленить из списка клиентов текукую строку".
     2954   DEFINE BUTTON B-exit AUTO-GO
     2955        LABEL "&Выход"
     2956        SIZE 10 BY 1 TOOLTIP "Выход из списка клиентов (передача списка другой программе)"
     2957        BGCOLOR 8 .
     2958   DEFINE BUTTON B-Help
     2959        LABEL "Помо&щь"
     2960        SIZE 10 BY 1
     2961        BGCOLOR 8 .
     2962   DEFINE BUTTON B-hist
     2963        LABEL "Ис&тория"
     2964        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     2965   DEFINE BUTTON B-lkp
     2966        LABEL "&Просмотр"
     2967        SIZE 10 BY 1 TOOLTIP "Просмотр описания текущего клиента".
     2968   DEFINE BUTTON B-macro
     2969        IMAGE-UP FILE "cmp/run.bmp":U
     2970        IMAGE-DOWN FILE "cmp/runi.bmp":U
     2971        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     2972        LABEL "&>"
     2973        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     2974   DEFINE BUTTON B-print
     2975        LABEL "Пе&чать"
     2976        SIZE 10 BY 1.
     2977   DEFINE BUTTON B-record
     2978        IMAGE-UP FILE "cmp/record.bmp":U
     2979        IMAGE-DOWN FILE "cmp/recordi.bmp":U
     2980        IMAGE-INSENSITIVE FILE "cmp/recordi.bmp":U
     2981        LABEL "&o"
     2982        SIZE 4 BY 1.25 TOOLTIP "Запись макроса формирования истории".
     2983   DEFINE BUTTON B-rest
     2984        LABEL "&Оставить"
     2985        SIZE 20 BY 1 TOOLTIP "Оставить в списке только текущую строку".
     2986   DEFINE BUTTON B-save
     2987        LABEL "Со&хр/Вып."
     2988        SIZE 10 BY 1 TOOLTIP "Сохр. список клиентов в текст.файле, EXCEL; операции над списком".
     2989   DEFINE BUTTON B-stop
     2990        IMAGE-UP FILE "cmp/stop.bmp":U
     2991        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     2992        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     2993        LABEL "&[ ]"
     2994        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     2995   DEFINE VARIABLE ed-notes AS CHARACTER
     2996        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2997        SIZE 75.63 BY 1.54 NO-UNDO.
     2998   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     2999         VIEW-AS TEXT
     3000        SIZE 75.5 BY 1 TOOLTIP "Строка текущего состояния списка"
     3001        FGCOLOR 4  NO-UNDO.
     3002   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     3003         VIEW-AS TEXT
     3004        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     3005        FGCOLOR 4  NO-UNDO.
     3006   DEFINE VARIABLE NameOrCode AS CHARACTER FORMAT "X(256)":U
     3007        VIEW-AS FILL-IN
     3008        SIZE 40.13 BY 1 NO-UNDO.
     3009   DEFINE VARIABLE n-c AS CHARACTER INITIAL "1"
     3010        VIEW-AS RADIO-SET HORIZONTAL
     3011        RADIO-BUTTONS
     3012             "Название", "1",
     3013   "Код", "2"
     3014        SIZE 23 BY .79 NO-UNDO.
     3015   DEFINE VARIABLE RS-Status AS CHARACTER
     3016        VIEW-AS RADIO-SET HORIZONTAL
     3017        RADIO-BUTTONS
     3018             "Item 1", "1",
     3019   "Item 2", "2",
     3020   "Item 3", "3"
     3021        SIZE 36.13 BY .75 NO-UNDO.
     3022   DEFINE QUERY BR-list FOR
     3023         cli-list SCROLLING.
     3024   DEFINE QUERY br-option FOR
     3025         temp-list SCROLLING.
     3026   DEFINE BROWSE BR-list
     3027     QUERY BR-list NO-LOCK DISPLAY
     3028         cli-list.obj-type
     3029         cli-list.obj-code
     3030         IF (cli-list.stts = 0) THEN (cli-list.obj-name)
     3031   ELSE (substring (cli-list.obj-name, 1, 25) +
     3032         FILL(chr(32), 25 -
     3033         LENGTH(substring (cli-list.obj-name, 1, 25)) ) +       '---  УДАЛЕН  ---':U) COLUMN-LABEL "Название" FORMAT "x(40)"
     3034         cli-list.grp-name FORMAT "X(60)"
     3035         cli-list.is-prod COLUMN-LABEL "Пр-ль" FORMAT "+/"
     3036         cli-list.sup-gds COLUMN-LABEL "Пост-к/т" FORMAT "+/"
     3037         cli-list.sup-cons COLUMN-LABEL "Пост-к/к" FORMAT "+/"
     3038         cli-list.buy-gds COLUMN-LABEL "Пок-ль/т" FORMAT "+/"
     3039         cli-list.buy-cons COLUMN-LABEL "Пок-ль/к" FORMAT "+/"
     3040         cli-list.buy-serv COLUMN-LABEL "Пок-ль/у" FORMAT "+/"
     3041         is-dis-cardc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Дисконтная карта" FORMAT "X(16)"
     3042         is-cashierc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Кассир" FORMAT "X(6)"
     3043         cli-list.db-num
     3044         is-sellerc(cli-list.obj-type, cli-list.obj-code) COLUMN-LABEL "Прод-ц" FORMAT "X(6)"
     3045       WITH NO-ROW-MARKERS SEPARATORS SIZE 79 BY 15.13.
     3046   DEFINE BROWSE BR-option
     3047     QUERY br-option DISPLAY
     3048         temp-list.fname format "X(40)"
     3049       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 29 BY 21 TOOLTIP "Условие для выбора клиентов, которые будут добавлены/удалены/оставле".
     3050   DEFINE FRAME Dialog-Frame
     3051        dsp-rs AT ROW 1 COL 1 NO-LABEL
     3052        br-option AT ROW 2 COL 80
     3053        B-exit AT ROW 2 COL 1
     3054        B-save AT ROW 2 COL 11
     3055        B-print AT ROW 2 COL 21
     3056        B-hist AT ROW 2 COL 31
     3057        B-lkp AT ROW 2 COL 41
     3058        B-clr AT ROW 2 COL 51
     3059        B-Help AT ROW 1 COL 61
     3060        B-add AT ROW 3 COL 11
     3061        B-del AT ROW 3 COL 31
     3062        B-rest AT ROW 3 COL 51
     3063        B-macro AT ROW 3 COL 71
     3064        B-stop AT ROW 3 COL 75
     3065        B-clear-macro AT ROW 3 COL 75
     3066        B-record AT ROW 3 COL 75
     3067        NameOrCode AT ROW 4.04 COL 34 COLON-ALIGNED NO-LABEL
     3068        n-c AT ROW 4.08 COL 2.38 NO-LABEL
     3069        RS-Status AT ROW 5 COL 3.25 NO-LABEL
     3070        f-tot-lns AT ROW 5 COL 66 COLON-ALIGNED NO-LABEL
     3071        BR-list AT ROW 6 COL 1.13
     3072        ed-notes AT ROW 21.38 COL 1 NO-LABEL
     3073        SPACE(23.00) SKIP(0.15)
     3074       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3075            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3076            TITLE "Список клиентов"
     3077            DEFAULT-BUTTON B-exit.
     3078   ASSIGN
     3079          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3080          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3081   ASSIGN
     3082          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     3083   ASSIGN
     3084          B-macro:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-play:HANDLE.
     3085   ASSIGN
     3086          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     3087   ASSIGN
     3088          ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3089   on GO of frame Dialog-Frame do:
     3090     define variable glog as logical no-undo .
     3091   end.
     3092   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3093   DO:
     3094     APPLY "END-ERROR":U TO SELF.
     3095   END.
     3096   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     3097   DO:
     3098   define variable glog as logical no-undo .
     3099   define buffer buf-cli-list-hist for cli-list-hist.
     3100   glog = no.
     3101   message
     3102   "Удаление всех строк списка. Вы уверены ?"
     3103   view-as alert-box question buttons OK-Cancel update glog.
     3104   if not glog then return no-apply.
     3105   if session:set-wait-state( "COMPILER" )  then .
     3106   for each cli-list:
     3107     delete cli-list.
     3108   end.
     3109   if session:set-wait-state( "" )  then .
     3110   tot-lns = 0.
     3111   v-seq = 1.
     3112   for each buf-cli-list-hist:
     3113     delete buf-cli-list-hist.
     3114   end.
     3115   run create-cli-list-hist in this-procedure (
     3116                                          input 'ДОБАВЛЕНИЕ':U
     3117                                        , input-output v-seq
     3118                                        , input 0
     3119                                        , input '0':U
     3120                                        , input "# Список карт очищен."
     3121                                        , input 0
     3122                                        , input "clear"
     3123                                        , input '':U
     3124                                        , input '':U
     3125                                        , input '':U
     3126                                        , input ?
     3127                                        ).
     3128   ed-notes:screen-value = ''.
     3129   display
     3130   tot-lns @ f-tot-lns
     3131   with frame Dialog-Frame.
     3132   run MyEnable in this-procedure .
     3133   END.
     3134   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     3135   DO:
     3136   define buffer buf_cli-list-hist for cli-list-hist.
     3137   run prn-lib-open-stream  in this-procedure (
     3138                                                input parParentProc
     3139                                               ,input 43
     3140                                               ,input yes
     3141                                               ,input no
     3142                                               ).
     3143   find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     3144   PUT  STREAM PrnLibStream unformatted
     3145   SPACE(25) "История создания списка клиентов "
     3146   (if available buf_cli-list-hist
     3147   then buf_cli-list-hist.des
     3148   else "БЕЗЫМЯННЫЙ") skip(0)
     3149   space(25) cur-time-print() skip(1)
     3150   .
     3151   put stream PrnLibStream unformatted
     3152   string("№", "X(9)") chr(32)
     3153   string("Действие", "X(9)") chr(32)
     3154   string("записей", "X(9)") chr(32)
     3155   string(" = итого", "X(12)") chr(32)
     3156   string("Множество", "X(155)")
     3157   skip(0)
     3158   fill('-':U, 9) chr(32)
     3159   fill('-':U, 9) chr(32)
     3160   fill('-':U, 9) chr(32)
     3161   fill('-':U, 12) chr(32)
     3162   fill('-':U, 155)
     3163   skip(0)
     3164   .
     3165   for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     3166   by buf_cli-list-hist.id
     3167   :
     3168     put stream PrnLibStream unformatted
     3169     (if buf_cli-list-hist.line = 0
     3170      then string(buf_cli-list-hist.id, ">>>>>>>>9")
     3171      else fill(chr(32) , 9)
     3172     )  chr(32)
     3173     (if buf_cli-list-hist.item_ <> '':U
     3174      then string(buf_cli-list-hist.hist-mode, "X(8)")
     3175      else fill( chr(32), 8)) chr(32)
     3176     string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     3177     string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     3178     string(buf_cli-list-hist.des, "X(155)") skip.
     3179   end.
     3180   output stream prnlibstream close.
     3181   run prn-lib-prn-file in this-procedure (
     3182                                             input parParentProc
     3183                                             ,input 8
     3184                                             ).
     3185   apply "entry" to br-list in frame Dialog-Frame.
     3186   END.
     3187   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     3188   DO:
     3189     if not available cli-list then do:
     3190     message "Неправильно выбран клиент."
     3191             view-as alert-box error.
     3192     return no-apply.
     3193   end.
     3194    run ref/showcli.p (
     3195                input parparentproc
     3196               ,input cli-list.obj-type
     3197               ,input cli-list.obj-code
     3198               ).
     3199    apply "entry" to br-list in frame Dialog-Frame.
     3200   END.
     3201   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     3202   DO:
     3203   define variable v-frame-width as integer no-undo.
     3204   if print-option = "" then do:
     3205       run gbl/pop-up.p ( input self:handle, input no) no-error.
     3206   end.
     3207   if print-option = "artic":U then do:
     3208     run str/cliartpr.p ( input parparentproc
     3209                    ,output v-frame-width ) no-error.
     3210   end.
     3211   else do:
     3212     run str/clil-prn.p ( input parparentproc
     3213                    ,input print-option
     3214                    ,output v-Frame-Width) no-error.
     3215   end.
     3216   print-option = "".
     3217   if v-frame-width <= 198 then do:
     3218     run prn-lib-prn-file in this-procedure (
     3219                                               input parParentProc
     3220                                               ,input (if v-frame-width <= 136 then 0 else 8)
     3221                                               ).
     3222   end.
     3223   else do:
     3224     run prn-lib-prn-file in this-procedure (
     3225                                               input parParentProc
     3226                                               ,input (if v-frame-width <= 255 then 1 else 20)
     3227                                               ).
     3228   end.
     3229   make-excel = no.
     3230   apply "entry" to br-list in frame Dialog-Frame.
     3231   END.
     3232   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     3233   DO:
     3234     if save-option = "" then do:
     3235          run gbl/pop-up.p ( input self:handle, input no) no-error.
     3236      end.
     3237      run proc-b-save in this-procedure ( input save-option) no-error.
     3238      if error-status:error then return no-apply.
     3239   END.
     3240   ON VALUE-CHANGED OF BR-list IN FRAME Dialog-Frame
     3241   DO:
     3242       if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     3243   END.
     3244   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     3245   DO:
     3246     assign
     3247     Rs-list-method = temp-list.fvalue
     3248     .
     3249     run proc-vc-rs-list-method in this-procedure no-error .
     3250     if error-status:error then return no-apply.
     3251   END.
     3252   ON CHOOSE OF MENU-ITEM m_art-print
     3253   DO:
     3254     assign
     3255     print-option = "artic":U.
     3256     apply "choose" to b-print in frame Dialog-Frame.
     3257   END.
     3258   ON CHOOSE OF MENU-ITEM m_cli-save
     3259   DO:
     3260     assign
     3261     save-option = "cli-list":U.
     3262     apply "choose" to b-save in frame Dialog-Frame.
     3263   END.
     3264   ON CHOOSE OF MENU-ITEM m_cli-save-db
     3265   DO:
     3266     assign
     3267     save-option = "cli-list-db":U.
     3268     apply "choose" to b-save in frame Dialog-Frame.
     3269   END.
     3270   ON CHOOSE OF MENU-ITEM m-macros-save  DO:
     3271   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3272   if lookup(b-save :type in frame Dialog-Frame
     3273            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3274            ) = 0
     3275   then do:
     3276     message
     3277       "$Workfile$"
     3278       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3279       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3280       "Тип" self :type in frame Dialog-Frame skip
     3281       "Процедура" this-procedure :file-name skip
     3282       view-as alert-box .
     3283   end.
     3284   else do:
     3285     apply "entry":u to b-save in frame Dialog-Frame .
     3286     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3287       return no-apply .
     3288     end.
     3289   end.
     3290   run proc-macros in this-procedure no-error .
     3291   if error-status:error then return no-apply.
     3292   END.
     3293   ON CHOOSE OF MENU-ITEM m-macros-save-db
     3294   DO:
     3295     assign
     3296     save-option = "cli-list-macros-db":U.
     3297     apply "choose" to b-save in frame Dialog-Frame.
     3298   END.
     3299   ON CHOOSE OF MENU-ITEM m_main-print
     3300   DO:
     3301     assign
     3302     print-option = "main":U.
     3303     apply "choose" to b-print in frame Dialog-Frame.
     3304   END.
     3305   ON CHOOSE OF MENU-ITEM m-rum  DO:
     3306   define variable glog as logical no-undo .
     3307   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3308   if lookup(b-save :type in frame Dialog-Frame
     3309            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3310            ) = 0
     3311   then do:
     3312     message
     3313       "$Workfile$"
     3314       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3315       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3316       "Тип" self :type in frame Dialog-Frame skip
     3317       "Процедура" this-procedure :file-name skip
     3318       view-as alert-box .
     3319   end.
     3320   else do:
     3321     apply "entry":u to b-save in frame Dialog-Frame .
     3322     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3323       return no-apply .
     3324     end.
     3325   end.
     3326   run str/diallog.w (
     3327         input parParentProc
     3328       , input this-procedure
     3329       , input "utl/thbjrumr.w":U
     3330       , input 'clients':U + chr(4) +
     3331               ('batchwork-export':U + chr(44) + 'batchwork-routing':U)
     3332       , input no
     3333       , input "&Стоп"
     3334       , input substitute("Операции над списком клиентов") ) .
     3335   END.
     3336   ON CHOOSE OF MENU-ITEM m_sel-print
     3337   DO:
     3338     assign
     3339     print-option = "extended":U.
     3340     apply "choose" to b-print in frame Dialog-Frame.
     3341   END.
     3342   ON CHOOSE OF MENU-ITEM m-title-save
     3343   DO:
     3344   define variable v-value as character no-undo .
     3345     run gbl/d-prompt.w (
     3346         'title=':u + "Введите ИМЯ СПИСКА КАРТ" + '\':u
     3347       + 'format=' + "X(60)" + '\':u
     3348       + 'type=' + 'C':U + '\':u
     3349       + 'fillin_row=2\':u
     3350       + 'fillin_col=4\':u
     3351       + 'fillin_width=60\':u
     3352       + 'fillin_height=1\':u
     3353       + 'max-chars=60\':u
     3354       + 'readonly=no\':u
     3355       , input-output v-value
     3356       ).
     3357   if return-value = 'false':u then return NO-apply.
     3358   run create-cli-list-hist in this-procedure (
     3359                                          input 'title'
     3360                                        , input-output v-seq
     3361                                        , input 0
     3362                                        , input 'N':U
     3363                                        , input v-value
     3364                                        , input tot-lns
     3365                                        , input "title"
     3366                                        , input '':U
     3367                                        , input '':U
     3368                                        , input '':U
     3369                                        , input ?
     3370                                        ).
     3371   assign
     3372   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1", v-value).
     3373   END.
     3374   ON CHOOSE OF MENU-ITEM m_xls-save
     3375   DO:
     3376     assign
     3377     save-option = "excel":U.
     3378     apply "choose" to b-save in frame Dialog-Frame.
     3379   END.
     3380   ON VALUE-CHANGED OF n-c IN FRAME Dialog-Frame
     3381   DO:
     3382       define variable loc#log as logical no-undo.
     3383       if can-do( 'код':U, n-c ) then do:
     3384           assign
     3385               NameOrCode:width-chars = 10
     3386               NameOrCode:format = "x(9)" .
     3387       end.
     3388       else do:
     3389           assign
     3390               NameOrCode:width-chars = 34.63
     3391               NameOrCode:format = "X(40)" .
     3392       end.
     3393       if nameorcode:visible in frame Dialog-Frame then
     3394       apply "entry" to NameOrCode in frame Dialog-Frame .
     3395   END.
     3396   ON CTRL-J OF NameOrCode IN FRAME Dialog-Frame
     3397   DO:
     3398     assign
     3399     n-c
     3400     nameorcode.
     3401     run proc-find-nameorcode in this-procedure no-error.
     3402     if error-status:error then do:
     3403       return no-apply.
     3404     end.
     3405   END.
     3406   ON RETURN OF NameOrCode IN FRAME Dialog-Frame
     3407   DO:
     3408     assign
     3409     n-c
     3410     nameorcode.
     3411     run proc-find-nameorcode in this-procedure no-error.
     3412     if error-status:error then do:
     3413       return no-apply.
     3414     end.
     3415   END.
     3416   ON VALUE-CHANGED OF RS-Status IN FRAME Dialog-Frame
     3417   DO:
     3418     assign
     3419     RS-status.
     3420   END.
     3421   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3422   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3423     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3424     return no-apply.
     3425   end.
     3426   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3427   on F3 of frame Dialog-Frame anywhere do:
     3428     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     3429     return no-apply.
     3430   end.
     3431   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3432   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3433     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3434     return no-apply.
     3435   end.
     3436   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3437   on F8 of frame Dialog-Frame anywhere do:
     3438     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3439     return no-apply.
     3440   end.
     3441   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-list IN FRAME Dialog-Frame DO:
     3442       apply "choose" to b-lkp in frame Dialog-Frame.
     3443   END.
     3444   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3445   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3446   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3447   on help of frame Dialog-Frame
     3448   do:
     3449     run gbl/app_help.p
     3450       (input this-procedure :file-name
     3451       ,input ''
     3452       ,input ?
     3453       ) no-error.
     3454     if error-status :error then do:
     3455       message
     3456         "Ошибка при вызове помощи"
     3457         error-status :get-message(1)
     3458         view-as alert-box .
     3459     end.
     3460   end.
     3461   run minbtn-set in this-procedure .
     3462   on choose of b-help in frame Dialog-Frame
     3463   do:
     3464     apply "help":u to frame Dialog-Frame .
     3465   end.
     3466   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   procedure minbtn-set :
     3468       do
     3469           on error undo, return error return-value
     3470           :
     3471           define variable ii              as integer       no-undo .
     3472           define variable fh              as widget-handle no-undo .
     3473           define variable hh              as widget-handle no-undo .
     3474           define variable v-h             as handle        extent 4 no-undo .
     3475           define variable v-name-button   as character     no-undo .
     3476           define variable v-help-old-x    as decimal       no-undo .
     3477           define variable v-help-old-y    as decimal       no-undo .
     3478           define variable v-help-old-size as decimal       no-undo .
     3479           define variable v-frame-width   as decimal       no-undo .
     3480           define variable jj              as integer       no-undo .
     3481           do
     3482               on error undo, return error
     3483               :
     3484               assign
     3485                   v-frame-width = frame Dialog-Frame:width - 0.3
     3486                   fh            = frame Dialog-Frame:first-child
     3487                   hh            = fh:first-child
     3488                   ii            = 1
     3489                   .
     3490               do while valid-handle(hh):
     3491                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3492                   do:
     3493                       case lc(hh:name) :
     3494                           when "b-help" then
     3495                               do:
     3496                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3497                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3498                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3499                                   hh:TOOLTIP = "Помощь" .
     3500                                   v-help-old-x = hh:column .
     3501                                   v-help-old-y = hh:row    .
     3502                                   v-help-old-size = hh:width .
     3503                                   hh:width-chars = 2.5 .
     3504                               end.
     3505                           when "b-print" then
     3506                               do:
     3507                                   hh:load-image("cmp/b-print.bmp":u) .
     3508                                   hh:TOOLTIP = "Печать" .
     3509                                   v-h[ii] = hh:handle .
     3510                                   ii = ii + 1 .
     3511                                   hh:width-chars = 3 .
     3512                               end.
     3513                           when "b-history" or
     3514                           when "b-hist" then
     3515                               do:
     3516                                   hh:load-image("cmp/b-hist.bmp":u) .
     3517                                   hh:TOOLTIP = "История" .
     3518                                   v-h[ii] = hh:handle .
     3519                                   ii = ii + 1 .
     3520                                   hh:width-chars = 3 .
     3521                               end.
     3522                           when "b-sch" then
     3523                               do:
     3524                                   hh:load-image("cmp/b-sch.bmp":u) .
     3525                                   hh:TOOLTIP = "Установка Фильтра" .
     3526                                   v-h[ii] = hh:handle .
     3527                                   ii = ii + 1 .
     3528                                   hh:width-chars = 3 .
     3529                               end.
     3530                           when "b-hist-user" then
     3531                               do:
     3532                                   hh:load-image("cmp/b-hist.bmp":u) .
     3533                                   hh:TOOLTIP = "История пользователя" .
     3534                                   ii = ii + 1 .
     3535                               end.
     3536                       end case.
     3537                   end.
     3538                   hh = hh:next-sibling.
     3539               end.
     3540               b-help:column = v-frame-width - b-help:width-chars.
     3541               jj = 0.
     3542               repeat ii = 4 to 1 by -1 :
     3543                   if valid-handle (v-h[ii] ) then
     3544                   do:
     3545                       jj  = jj + 1 .
     3546                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3547                       v-h[ii]:row    = v-help-old-y .
     3548                   end.
     3549               end.
     3550           end.
     3551       end.
     3552   end procedure.
     3553   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3554   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3555   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3556   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3557   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3558   define variable v-diasize-current-frame-height as decimal   no-undo .
     3559   define variable v-diasize-change-size          as logical   no-undo .
     3560   define variable v-diasize-resize-button        as handle    no-undo .
     3561   define variable v-diasize-wndmax               as logical   no-undo .
     3562   define variable v-diasize-wndstore             as logical   no-undo .
     3563   define variable v-diasize-proc-name            as character no-undo .
     3564   define variable v-diasize-browse-handle        as handle    no-undo .
     3565   define variable v-diasize-browse-number        as integer   no-undo .
     3566   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3567   define temp-table temp-diasize-handle no-undo
     3568     field handle-value  as handle
     3569     field save-position as decimal
     3570     index xpk is primary unique handle-value
     3571     .
     3572   define temp-table temp-browse-handle no-undo
     3573     field browse-type   as character
     3574     field browse-number as integer
     3575     field browse-handle as handle
     3576     field original-size as decimal
     3577     index xpk is primary unique browse-type browse-number
     3578     index xie browse-type browse-handle
     3579   .
     3580   procedure diasize_change-height :
     3581     define input  parameter p-change-value  as decimal   no-undo .
     3582     define input  parameter p-move-resize   as logical   no-undo .
     3583     define variable v-field-group-handle    as handle    no-undo .
     3584     define variable v-object-handle         as handle    no-undo .
     3585     define variable v-frame-height          as decimal   no-undo .
     3586     define variable v-frame-virtual-height  as decimal   no-undo .
     3587     define variable v-browse-height         as decimal   no-undo .
     3588     define variable v-window-height         as decimal   no-undo .
     3589     define variable v-window-virtual-height as decimal   no-undo .
     3590     define variable v-change-sign           as integer   no-undo .
     3591     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3592     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3593     if p-change-value > 0
     3594     then do:
     3595       if frame Dialog-Frame :height + p-change-value
     3596           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3597       then do:
     3598         assign
     3599           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3600                           - (frame Dialog-Frame :height-chars)
     3601         .
     3602         if p-change-value <= 0
     3603         then do:
     3604           run diasize_position-resize-button in this-procedure .
     3605           return .
     3606         end.
     3607       end.
     3608     end.
     3609     if p-change-value < 0
     3610     then do:
     3611       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3612       then do:
     3613         assign
     3614           p-change-value = v-diasize-orig-frame-height
     3615                          - (frame Dialog-Frame :height-chars)
     3616         .
     3617         if p-change-value >= 0
     3618         then do:
     3619           run diasize_position-resize-button in this-procedure .
     3620           return .
     3621         end.
     3622       end.
     3623     end.
     3624     if p-change-value >= 0
     3625     then do:
     3626       assign
     3627         v-change-sign = 1
     3628       .
     3629     end.
     3630     else do:
     3631       assign
     3632         v-change-sign = -1
     3633       .
     3634     end.
     3635     assign
     3636       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3637     .
     3638     if p-change-value = 0
     3639     then do:
     3640       run diasize_position-resize-button in this-procedure .
     3641       return .
     3642     end.
     3643     move_block:
     3644     do
     3645     on error undo move_block, retry move_block
     3646     :
     3647       if retry
     3648       then do:
     3649         do
     3650         on error undo move_block, leave move_block
     3651         :
     3652           if p-change-value > 0
     3653           then do:
     3654             for each buf_temp-diasize-handle
     3655             on error undo, next
     3656             :
     3657               assign
     3658                 v-object-handle = buf_temp-diasize-handle.handle-value
     3659               .
     3660               if v-object-handle <> v-diasize-resize-button
     3661               then do:
     3662                 assign
     3663                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3664                 .
     3665               end.
     3666             end.
     3667             assign
     3668               v-diasize-browse-handle :height = v-browse-height
     3669             .
     3670             for each buf_temp-browse-handle
     3671               where buf_temp-browse-handle.browse-type = 'height':u
     3672             on error undo, next
     3673             :
     3674               assign
     3675                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3676               .
     3677             end.
     3678             assign
     3679               frame Dialog-Frame :height = v-frame-height
     3680             .
     3681             if frame Dialog-Frame :scrollable = true
     3682             then do:
     3683               assign
     3684                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3685               .
     3686             end.
     3687             run diasize_position-resize-button in this-procedure .
     3688           end.
     3689           else do:
     3690             if frame Dialog-Frame :scrollable = true
     3691             then do:
     3692               assign
     3693                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3694               .
     3695             end.
     3696             assign
     3697               frame Dialog-Frame :height = v-frame-height
     3698             .
     3699             assign
     3700               v-diasize-browse-handle :height = v-browse-height
     3701             .
     3702             for each buf_temp-browse-handle
     3703               where buf_temp-browse-handle.browse-type = 'height':u
     3704             on error undo, next
     3705             :
     3706               assign
     3707                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3708               .
     3709             end.
     3710             for each buf_temp-diasize-handle
     3711             on error undo, next
     3712             :
     3713               assign
     3714                 v-object-handle = buf_temp-diasize-handle.handle-value
     3715               .
     3716               if v-object-handle <> v-diasize-resize-button
     3717               then do:
     3718                 assign
     3719                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3720                 .
     3721               end.
     3722             end.
     3723             run diasize_position-resize-button in this-procedure .
     3724           end.
     3725           assign
     3726             v-diasize-change-size = false
     3727           .
     3728           leave move_block .
     3729         end.
     3730       end.
     3731       assign
     3732         v-diasize-need-full-display = true
     3733       .
     3734       if v-diasize-change-size = false
     3735       then do:
     3736         assign
     3737           v-diasize-change-size = true
     3738         .
     3739       end.
     3740       else do:
     3741         return .
     3742       end.
     3743       assign
     3744         v-frame-height = frame Dialog-Frame :height
     3745         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3746         v-browse-height = v-diasize-browse-handle :height
     3747       .
     3748       for each buf_temp-browse-handle
     3749         where buf_temp-browse-handle.browse-type = 'height':u
     3750       :
     3751         assign
     3752           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3753         .
     3754       end.
     3755       for each buf_temp-diasize-handle
     3756       :
     3757         delete buf_temp-diasize-handle .
     3758       end.
     3759       assign
     3760         v-field-group-handle = frame Dialog-Frame :first-child
     3761       .
     3762       do while valid-handle(v-field-group-handle)
     3763       :
     3764         assign
     3765           v-object-handle = v-field-group-handle :first-child
     3766         .
     3767         do while valid-handle(v-object-handle)
     3768         :
     3769           if  v-object-handle <> v-diasize-browse-handle :handle
     3770           and can-query(v-object-handle, "row")
     3771           and can-query(v-object-handle, "height")
     3772           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3773           then do:
     3774             find first buf_temp-browse-handle
     3775               where buf_temp-browse-handle.browse-type   = 'height':u
     3776                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3777               no-error .
     3778             if available buf_temp-browse-handle
     3779             then do:
     3780             end.
     3781             else do:
     3782               create buf_temp-diasize-handle .
     3783               assign
     3784                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3785                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3786               .
     3787             end.
     3788           end.
     3789           assign
     3790             v-object-handle = v-object-handle :next-sibling
     3791           .
     3792         end.
     3793         assign
     3794           v-field-group-handle = v-field-group-handle :next-sibling
     3795         .
     3796       end.
     3797       do with frame Dialog-Frame
     3798       :
     3799         hide v-diasize-resize-button .
     3800         assign
     3801           v-diasize-resize-button :row    = 1
     3802           v-diasize-resize-button :column = 1
     3803         .
     3804       end.
     3805       if p-change-value > 0
     3806       then do:
     3807         if frame Dialog-Frame :scrollable = true
     3808         then do:
     3809           assign
     3810             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3811             no-error .
     3812           if error-status :error
     3813           or error-status :get-message(1) <> ""
     3814           then do:
     3815             undo move_block, retry move_block .
     3816           end.
     3817         end.
     3818         assign
     3819           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3820           no-error .
     3821         if error-status :error
     3822         or error-status :get-message(1) <> ""
     3823         then do:
     3824           undo move_block, retry move_block .
     3825         end.
     3826         assign
     3827           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3828           no-error .
     3829         if error-status :error
     3830         or error-status :get-message(1) <> ""
     3831         then do:
     3832           undo move_block, retry move_block .
     3833         end.
     3834         for each buf_temp-browse-handle
     3835           where buf_temp-browse-handle.browse-type = 'height':u
     3836         on error undo move_block, retry move_block
     3837         :
     3838           assign
     3839             buf_temp-browse-handle.browse-handle :height
     3840               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3841             no-error .
     3842           if error-status :error
     3843           or error-status :get-message(1) <> ""
     3844           then do:
     3845             undo move_block, retry move_block .
     3846           end.
     3847         end.
     3848         for each buf_temp-diasize-handle
     3849         on error undo move_block, retry move_block
     3850         :
     3851           assign
     3852             v-object-handle = buf_temp-diasize-handle.handle-value
     3853           .
     3854           if v-object-handle <> v-diasize-resize-button
     3855           then do:
     3856             assign
     3857               v-object-handle :row = v-object-handle :row + p-change-value
     3858               no-error .
     3859             if error-status :error
     3860             or error-status :get-message(1) <> ""
     3861             then do:
     3862               undo move_block, retry move_block .
     3863             end.
     3864           end.
     3865         end.
     3866       end.
     3867       else do:
     3868         for each buf_temp-diasize-handle
     3869         on error undo move_block, retry move_block
     3870         :
     3871           assign
     3872             v-object-handle = buf_temp-diasize-handle.handle-value
     3873           .
     3874           if v-object-handle <> v-diasize-resize-button
     3875           then do:
     3876             assign
     3877               v-object-handle :row = v-object-handle :row + p-change-value
     3878               no-error .
     3879             if error-status :error
     3880             or error-status :get-message(1) <> ""
     3881             then do:
     3882               undo move_block, retry move_block .
     3883             end.
     3884           end.
     3885         end.
     3886         assign
     3887           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3888           no-error .
     3889         if error-status :error
     3890         or error-status :get-message(1) <> ""
     3891         then do:
     3892           undo move_block, retry move_block .
     3893         end.
     3894         for each buf_temp-browse-handle
     3895           where buf_temp-browse-handle.browse-type = 'height':u
     3896         on error undo move_block, retry move_block
     3897         :
     3898           assign
     3899             buf_temp-browse-handle.browse-handle :height
     3900               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3901             no-error .
     3902           if error-status :error
     3903           or error-status :get-message(1) <> ""
     3904           then do:
     3905             undo move_block, retry move_block .
     3906           end.
     3907         end.
     3908         assign
     3909           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3910           no-error .
     3911         if error-status :error
     3912         or error-status :get-message(1) <> ""
     3913         then do:
     3914           undo move_block, retry move_block .
     3915         end.
     3916         if frame Dialog-Frame :scrollable = true
     3917         then do:
     3918           assign
     3919             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3920             no-error .
     3921           if error-status :error
     3922           or error-status :get-message(1) <> ""
     3923           then do:
     3924             undo move_block, retry move_block .
     3925           end.
     3926         end.
     3927       end.
     3928       if p-move-resize = true
     3929       then do:
     3930         run diasize_position-resize-button in this-procedure .
     3931       end.
     3932       if v-diasize-wndstore = true
     3933       then do:
     3934         if connected("ub") = true
     3935         then do:
     3936           define variable v-cntxt-db-num        as integer   no-undo .
     3937           define variable v-cntxt-userid        as character no-undo .
     3938           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3939                                             , OUTPUT v-cntxt-userid
     3940                                             ) .
     3941           run gbl/wndsizew.p
     3942             (input  v-cntxt-db-num
     3943             ,input  v-cntxt-userid
     3944             ,input  v-diasize-proc-name
     3945             ,input  'height':u
     3946             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3947             ) .
     3948         end.
     3949       end.
     3950     end.
     3951     assign
     3952       v-diasize-change-size = false
     3953     .
     3954   end procedure.
     3955   procedure diasize_set-height :
     3956     define input  parameter p-new-height  as decimal   no-undo .
     3957     define input  parameter p-move-resize as logical   no-undo .
     3958     do
     3959     on error undo, return error return-value
     3960     :
     3961       run diasize_change-height in this-procedure
     3962         (input  (p-new-height - frame Dialog-Frame :height)
     3963         ,input  p-move-resize
     3964         ) .
     3965     end.
     3966   end procedure.
     3967   procedure diasize_change-width :
     3968     define input  parameter p-change-value as decimal   no-undo .
     3969     define input  parameter p-move-resize  as logical   no-undo .
     3970     define variable v-field-group-handle   as handle    no-undo .
     3971     define variable v-object-handle        as handle    no-undo .
     3972     define variable v-frame-width          as decimal   no-undo .
     3973     define variable v-frame-virtual-width  as decimal   no-undo .
     3974     define variable v-browse-width         as decimal   no-undo .
     3975     define variable v-window-width         as decimal   no-undo .
     3976     define variable v-window-virtual-width as decimal   no-undo .
     3977     define variable v-change-sign          as integer   no-undo .
     3978     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3979     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3980     if p-change-value > 0
     3981     then do:
     3982       if frame Dialog-Frame :width + p-change-value >
     3983           session :width-chars
     3984       then do:
     3985         assign
     3986           p-change-value = session :width-chars - frame Dialog-Frame :width
     3987         .
     3988         if p-change-value <= 0
     3989         then do:
     3990           run diasize_position-resize-button in this-procedure .
     3991           return .
     3992         end.
     3993       end.
     3994     end.
     3995     if p-change-value < 0
     3996     then do:
     3997       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3998       then do:
     3999         assign
     4000           p-change-value = v-diasize-orig-frame-width
     4001                          - frame Dialog-Frame :width
     4002         .
     4003         if p-change-value >= 0
     4004         then do:
     4005           run diasize_position-resize-button in this-procedure .
     4006           return .
     4007         end.
     4008       end.
     4009     end.
     4010     if p-change-value >= 0
     4011     then do:
     4012       assign
     4013         v-change-sign = 1
     4014       .
     4015     end.
     4016     else do:
     4017       assign
     4018         v-change-sign = -1
     4019       .
     4020     end.
     4021     assign
     4022       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4023     .
     4024     if p-change-value = 0
     4025     then do:
     4026       run diasize_position-resize-button in this-procedure .
     4027       return .
     4028     end.
     4029     move_block:
     4030     do
     4031     on error undo move_block, leave move_block
     4032     :
     4033       if retry
     4034       then do:
     4035         do
     4036         on error undo move_block, leave move_block
     4037         :
     4038           if p-change-value > 0
     4039           then do:
     4040             for each buf_temp-diasize-handle
     4041             on error undo, next
     4042             :
     4043               assign
     4044                 v-object-handle = buf_temp-diasize-handle.handle-value
     4045               .
     4046               if v-object-handle <> v-diasize-resize-button
     4047               then do:
     4048                 assign
     4049                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4050                 .
     4051               end.
     4052             end.
     4053             assign
     4054               v-diasize-browse-handle :width = v-browse-width
     4055             .
     4056             for each buf_temp-browse-handle
     4057               where buf_temp-browse-handle.browse-type = 'width':u
     4058             on error undo, next
     4059             :
     4060               assign
     4061                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4062               .
     4063             end.
     4064             assign
     4065               frame Dialog-Frame :width = v-frame-width
     4066             .
     4067             if frame Dialog-Frame :scrollable = true
     4068             then do:
     4069               assign
     4070                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4071               .
     4072             end.
     4073             run diasize_position-resize-button in this-procedure .
     4074           end.
     4075           else do:
     4076             if frame Dialog-Frame :scrollable = true
     4077             then do:
     4078               assign
     4079                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4080               .
     4081             end.
     4082             assign
     4083               frame Dialog-Frame :width = v-frame-width
     4084             .
     4085             for each buf_temp-browse-handle
     4086               where buf_temp-browse-handle.browse-type = 'width':u
     4087             on error undo, next
     4088             :
     4089               assign
     4090                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4091               .
     4092             end.
     4093             assign
     4094               v-diasize-browse-handle :width = v-browse-width
     4095             .
     4096             for each buf_temp-diasize-handle
     4097             on error undo, next
     4098             :
     4099               assign
     4100                 v-object-handle = buf_temp-diasize-handle.handle-value
     4101               .
     4102               if v-object-handle <> v-diasize-resize-button
     4103               then do:
     4104                 assign
     4105                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4106                 .
     4107               end.
     4108             end.
     4109             run diasize_position-resize-button in this-procedure .
     4110           end.
     4111           assign
     4112             v-diasize-change-size = false
     4113           .
     4114           leave move_block .
     4115         end.
     4116       end.
     4117       assign
     4118         v-diasize-need-full-display = true
     4119       .
     4120       if v-diasize-change-size = false
     4121       then do:
     4122         assign
     4123           v-diasize-change-size = true
     4124         .
     4125       end.
     4126       else do:
     4127         return .
     4128       end.
     4129       assign
     4130         v-frame-width = frame Dialog-Frame :width
     4131         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4132         v-browse-width = v-diasize-browse-handle :width
     4133       .
     4134       for each buf_temp-browse-handle
     4135         where buf_temp-browse-handle.browse-type = 'width':u
     4136       :
     4137         assign
     4138           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4139         .
     4140       end.
     4141       for each buf_temp-diasize-handle
     4142       :
     4143         delete buf_temp-diasize-handle .
     4144       end.
     4145       assign
     4146         v-field-group-handle = frame Dialog-Frame :first-child
     4147       .
     4148       do while valid-handle(v-field-group-handle)
     4149       :
     4150         assign
     4151           v-object-handle = v-field-group-handle :first-child
     4152         .
     4153         do while valid-handle(v-object-handle)
     4154         :
     4155           if  v-object-handle <> v-diasize-browse-handle :handle
     4156           and v-object-handle <> v-diasize-resize-button
     4157           and can-query(v-object-handle, "row")
     4158           and can-query(v-object-handle, "height")
     4159           and ( v-object-handle :col + v-object-handle :width
     4160                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4161               )
     4162           then do:
     4163             find first buf_temp-browse-handle
     4164               where buf_temp-browse-handle.browse-type   = 'width':u
     4165                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4166               no-error .
     4167             if available buf_temp-browse-handle
     4168             then do:
     4169             end.
     4170             else do:
     4171               create buf_temp-diasize-handle .
     4172               assign
     4173                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4174                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4175               .
     4176             end.
     4177           end.
     4178           assign
     4179             v-object-handle = v-object-handle :next-sibling
     4180           .
     4181         end.
     4182         assign
     4183           v-field-group-handle = v-field-group-handle :next-sibling
     4184         .
     4185       end.
     4186       do with frame Dialog-Frame
     4187       :
     4188         hide v-diasize-resize-button .
     4189         v-diasize-resize-button :row = 1.
     4190         v-diasize-resize-button :column = 1.
     4191       end.
     4192       if p-change-value > 0
     4193       then do:
     4194         if frame Dialog-Frame :scrollable = true
     4195         then do:
     4196           assign
     4197             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4198             no-error .
     4199           if error-status :error
     4200           or error-status :get-message(1) <> ""
     4201           then do:
     4202             undo move_block, retry move_block.
     4203           end.
     4204         end.
     4205         assign
     4206           frame Dialog-Frame :width = v-frame-width + p-change-value
     4207           no-error .
     4208         if error-status :error
     4209         or error-status :get-message(1) <> ""
     4210         then do:
     4211           undo move_block, retry move_block.
     4212         end.
     4213         assign
     4214           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4215         no-error .
     4216         if error-status :error
     4217         or error-status :get-message(1) <> ""
     4218         then do:
     4219           undo move_block, retry move_block.
     4220         end.
     4221         for each buf_temp-browse-handle
     4222           where buf_temp-browse-handle.browse-type = 'width':u
     4223         on error undo move_block, retry move_block
     4224         :
     4225           assign
     4226             buf_temp-browse-handle.browse-handle :width
     4227               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4228             no-error .
     4229           if error-status :error
     4230           or error-status :get-message(1) <> ""
     4231           then do:
     4232             undo move_block, retry move_block .
     4233           end.
     4234         end.
     4235         for each buf_temp-diasize-handle
     4236         on error undo move_block, retry move_block
     4237         :
     4238           assign
     4239             v-object-handle = buf_temp-diasize-handle.handle-value
     4240           .
     4241           if v-object-handle <> v-diasize-resize-button
     4242           then do:
     4243             assign
     4244               v-object-handle :col = v-object-handle :col + p-change-value
     4245               no-error .
     4246             if error-status :error
     4247             or error-status :get-message(1) <> ""
     4248             then do:
     4249               undo move_block, retry move_block .
     4250             end.
     4251           end.
     4252         end.
     4253       end.
     4254       else do:
     4255         for each buf_temp-diasize-handle
     4256         on error undo move_block, retry move_block
     4257         :
     4258           assign
     4259             v-object-handle = buf_temp-diasize-handle.handle-value
     4260           .
     4261           if v-object-handle <> v-diasize-resize-button
     4262           then do:
     4263             assign
     4264               v-object-handle :col = v-object-handle :col + p-change-value
     4265               no-error .
     4266             if error-status :error
     4267             or error-status :get-message(1) <> ""
     4268             then do:
     4269               undo move_block, retry move_block .
     4270             end.
     4271           end.
     4272         end.
     4273         for each buf_temp-browse-handle
     4274           where buf_temp-browse-handle.browse-type = 'width':u
     4275         on error undo move_block, retry move_block
     4276         :
     4277           assign
     4278             buf_temp-browse-handle.browse-handle :width
     4279               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4280             no-error .
     4281           if error-status :error
     4282           or error-status :get-message(1) <> ""
     4283           then do:
     4284             undo move_block, retry move_block .
     4285           end.
     4286         end.
     4287         assign
     4288           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4289           no-error .
     4290         if error-status :error
     4291         or error-status :get-message(1) <> ""
     4292         then do:
     4293           undo move_block, retry move_block.
     4294         end.
     4295         assign
     4296           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4297         no-error .
     4298         if error-status :error
     4299         or error-status :get-message(1) <> ""
     4300         then do:
     4301           undo move_block, retry move_block.
     4302         end.
     4303         if frame Dialog-Frame :scrollable = true
     4304         then do:
     4305           assign
     4306             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4307           no-error .
     4308           if error-status :error
     4309           or error-status :get-message(1) <> ""
     4310           then do:
     4311             undo move_block, retry move_block.
     4312           end.
     4313         end.
     4314       end.
     4315       if p-move-resize
     4316       then do:
     4317         run diasize_position-resize-button in this-procedure .
     4318       end.
     4319       if v-diasize-wndstore = true
     4320       then do:
     4321         if connected("ub") = true
     4322         then do:
     4323           define variable v-cntxt-db-num        as integer   no-undo .
     4324           define variable v-cntxt-userid        as character no-undo .
     4325           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4326                                             , OUTPUT v-cntxt-userid
     4327                                             ) .
     4328           run gbl/wndsizew.p
     4329             (input  v-cntxt-db-num
     4330             ,input  v-cntxt-userid
     4331             ,input  v-diasize-proc-name
     4332             ,input  'width':u
     4333             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4334             ) .
     4335         end.
     4336       end.
     4337     end.
     4338     assign
     4339       v-diasize-change-size = false
     4340     .
     4341   end procedure.
     4342   procedure diasize_set-width :
     4343     define input  parameter p-new-width  as decimal   no-undo .
     4344     define input  parameter p-move-resize as logical   no-undo .
     4345     do
     4346     on error undo, return error return-value
     4347     :
     4348       run diasize_change-width in this-procedure
     4349         (input  (p-new-width - frame Dialog-Frame :width)
     4350         ,input  p-move-resize
     4351         ) .
     4352     end.
     4353   end procedure.
     4354   procedure diasize_position-resize-button :
     4355     do with frame Dialog-Frame
     4356     :
     4357       hide v-diasize-resize-button .
     4358       assign
     4359         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4360                     - 1
     4361                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4362         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4363                     - 1
     4364                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4365       .
     4366       view v-diasize-resize-button .
     4367     end.
     4368   end procedure.
     4369   on alt-right anywhere
     4370   do:
     4371     run diasize_change-width in this-procedure
     4372       (input 1
     4373       ,input true
     4374       ) .
     4375     return no-apply .
     4376   end.
     4377   on alt-left anywhere
     4378   do:
     4379     run diasize_change-width in this-procedure
     4380       (input -1
     4381       ,input true
     4382       ) .
     4383     return no-apply .
     4384   end.
     4385   on alt-down anywhere
     4386   do:
     4387     run diasize_change-height in this-procedure
     4388       (input 1
     4389       ,input true
     4390       ) .
     4391     return no-apply .
     4392   end.
     4393   on alt-up anywhere
     4394   do:
     4395     run diasize_change-height in this-procedure
     4396       (input -1
     4397       ,input true
     4398       ) .
     4399     return no-apply .
     4400   end.
     4401   on alt-enter of frame Dialog-Frame
     4402   do:
     4403     run diasize_maximize in this-procedure
     4404       (input  ?
     4405       ).
     4406     return no-apply .
     4407   end.
     4408   procedure diasize_end-move :
     4409     do
     4410     on error undo, return error return-value
     4411     :
     4412       define variable v-row-delta as decimal   no-undo .
     4413       define variable v-col-delta as decimal   no-undo .
     4414       define variable v-new-row as decimal   no-undo .
     4415       define variable v-new-col as decimal   no-undo .
     4416       assign
     4417         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4418         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4419       .
     4420       assign
     4421         v-row-delta = v-new-row - frame Dialog-Frame :height
     4422         v-col-delta = v-new-col - frame Dialog-Frame :width
     4423       .
     4424       run diasize_change-height in this-procedure
     4425         (input v-row-delta
     4426         ,input true
     4427         ) .
     4428       run diasize_change-width in this-procedure
     4429         (input v-col-delta
     4430         ,input true
     4431         ) .
     4432     end.
     4433   end procedure.
     4434   procedure diasize_maximize :
     4435     define input  parameter p-action as logical   no-undo .
     4436     do
     4437     on error undo, return error return-value
     4438     :
     4439       if p-action = ?
     4440       then do:
     4441         if v-diasize-need-maximize = true
     4442         then do:
     4443           assign
     4444             p-action = true
     4445           .
     4446         end.
     4447         else do:
     4448           assign
     4449             p-action = false
     4450           .
     4451         end.
     4452       end.
     4453       if p-action = true
     4454       then do:
     4455         run diasize_change-height in this-procedure
     4456           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4457               - frame Dialog-Frame :height-chars
     4458           ,input true
     4459           ) .
     4460         run diasize_change-width in this-procedure
     4461           (input session :width-chars
     4462               - frame Dialog-Frame :width-chars
     4463           ,input true
     4464           ) .
     4465         assign
     4466           v-diasize-need-maximize = false
     4467         .
     4468       end.
     4469       else do:
     4470         run diasize_change-width in this-procedure
     4471           (input v-diasize-orig-frame-width
     4472               - frame Dialog-Frame :width-chars
     4473           ,input true
     4474           ) .
     4475         run diasize_change-height in this-procedure
     4476           (input v-diasize-orig-frame-height
     4477               - frame Dialog-Frame :height-chars
     4478           ,input true
     4479           ) .
     4480         assign
     4481           v-diasize-need-maximize = true
     4482         .
     4483       end.
     4484     end.
     4485   end procedure.
     4486   procedure diasize_restore-orig-size :
     4487     do
     4488     on error undo, return error return-value
     4489     :
     4490       assign
     4491         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4492         v-diasize-current-frame-height = frame Dialog-Frame :height
     4493       .
     4494       run diasize_set-height in this-procedure
     4495         (input  v-diasize-orig-frame-height
     4496         ,input  true
     4497         ) .
     4498       run diasize_set-width in this-procedure
     4499         (input  v-diasize-orig-frame-width
     4500         ,input  true
     4501         ) .
     4502     end.
     4503   end procedure.
     4504   procedure diasize_restore-current-size :
     4505     do
     4506     on error undo, return error return-value
     4507     :
     4508       run diasize_set-height in this-procedure
     4509         (input  v-diasize-current-frame-height
     4510         ,input  true
     4511         ) .
     4512       run diasize_set-width in this-procedure
     4513         (input  v-diasize-current-frame-width
     4514         ,input  true
     4515         ) .
     4516     end.
     4517   end procedure.
     4518   procedure diasize_set-browse-handle :
     4519     define input  parameter p-browse-handle as handle   no-undo .
     4520     define buffer buf_temp-browse-handle for temp-browse-handle .
     4521     do
     4522     on error undo, return error return-value
     4523     :
     4524       assign
     4525         v-diasize-browse-handle = p-browse-handle
     4526       .
     4527       for each buf_temp-browse-handle
     4528       on error undo, return error return-value
     4529       :
     4530         delete buf_temp-browse-handle .
     4531       end.
     4532     end.
     4533   end procedure.
     4534   procedure diasize_add_browse :
     4535     define input  parameter p-browse-type   as character no-undo .
     4536     define input  parameter p-browse-handle as handle    no-undo .
     4537     define buffer buf_temp-browse-handle for temp-browse-handle .
     4538     do
     4539     on error undo, return error return-value
     4540     :
     4541       assign
     4542         v-diasize-browse-number = v-diasize-browse-number + 1
     4543       .
     4544       create buf_temp-browse-handle .
     4545       assign
     4546         buf_temp-browse-handle.browse-type   = p-browse-type
     4547         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4548         buf_temp-browse-handle.browse-handle = p-browse-handle
     4549       .
     4550     end.
     4551   end procedure.
     4552   procedure diasize_init :
     4553     define variable v-default-value    as logical   no-undo .
     4554     define variable v-restore-saved    as logical   no-undo .
     4555     define variable v-resize-value-str as character no-undo .
     4556     do
     4557     on error undo, return error return-value
     4558     :
     4559       do with frame Dialog-Frame
     4560       :
     4561         assign
     4562           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4563           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4564           v-diasize-browse-handle     = browse br-list :handle
     4565         .
     4566         create button v-diasize-resize-button
     4567         assign
     4568           parent        = frame Dialog-Frame :first-child
     4569           label         = "s"
     4570           height-pixels = 16
     4571           width-pixels  = 16
     4572           visible       = true
     4573           sensitive     = true
     4574           movable       = true
     4575           triggers:
     4576             on end-move persistent run diasize_end-move in this-procedure .
     4577           end triggers.
     4578         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4579         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4580         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4581         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4582         assign
     4583           v-diasize-wndmax = false
     4584         .
     4585         if connected("ub") = true
     4586         then do:
     4587           define variable v-cntxt-db-num        as integer   no-undo .
     4588           define variable v-cntxt-userid        as character no-undo .
     4589           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4590                                             , OUTPUT v-cntxt-userid
     4591                                             ) .
     4592           run gbl/wndpar_r.p
     4593             (input  v-cntxt-db-num
     4594             ,input  v-cntxt-userid
     4595             ,input  'wndmax':U
     4596             ,output v-diasize-wndmax
     4597             ,output v-default-value
     4598             ) .
     4599         end.
     4600         assign
     4601           v-diasize-wndstore = false
     4602         .
     4603         if connected("ub") = true
     4604         then do:
     4605           run gbl/wndpar_r.p
     4606             (input  v-cntxt-db-num
     4607             ,input  v-cntxt-userid
     4608             ,input  'wndstore':U
     4609             ,output v-diasize-wndstore
     4610             ,output v-default-value
     4611             ) .
     4612         end.
     4613         assign
     4614           v-diasize-proc-name = entry(1, program-name(2), '.')
     4615         .
     4616         if v-diasize-wndstore = true
     4617         then do:
     4618           assign
     4619             v-restore-saved = false
     4620           .
     4621           if connected("ub") = true
     4622           then do:
     4623             run gbl/wndsizer.p
     4624               (input  v-cntxt-db-num
     4625               ,input  v-cntxt-userid
     4626               ,input  v-diasize-proc-name
     4627               ,input  'height':u
     4628               ,output v-resize-value-str
     4629               ) .
     4630             if v-resize-value-str <> '':U
     4631             then do:
     4632               run diasize_change-height in this-procedure
     4633                 (input  integer(v-resize-value-str)
     4634                 ,input  true
     4635                 ) .
     4636               assign
     4637                 v-restore-saved = true
     4638               .
     4639             end.
     4640           end.
     4641           if connected("ub") = true
     4642           then do:
     4643             run gbl/wndsizer.p
     4644               (input  v-cntxt-db-num
     4645               ,input  v-cntxt-userid
     4646               ,input  v-diasize-proc-name
     4647               ,input  'width':u
     4648               ,output v-resize-value-str
     4649               ) .
     4650             if v-resize-value-str <> '':U
     4651             then do:
     4652               run diasize_change-width in this-procedure
     4653                 (input  integer(v-resize-value-str)
     4654                 ,input  true
     4655                 ) .
     4656               assign
     4657                 v-restore-saved = true
     4658               .
     4659             end.
     4660           end.
     4661           if v-restore-saved <> true
     4662           then do:
     4663             if v-diasize-wndmax = true
     4664             then do:
     4665               run diasize_maximize in this-procedure
     4666                 (input  true
     4667                 ) .
     4668             end.
     4669           end.
     4670         end.
     4671         else do:
     4672           if v-diasize-wndmax = true
     4673           then do:
     4674             run diasize_maximize in this-procedure
     4675               (input  true
     4676               ) .
     4677           end.
     4678         end.
     4679       end.
     4680     end.
     4681   end procedure.
     4682   procedure diasize_need-full-display :
     4683     define output parameter p-need-full-display as logical   no-undo .
     4684     do
     4685     on error undo, return error return-value
     4686     :
     4687       assign
     4688         p-need-full-display = v-diasize-need-full-display
     4689       .
     4690       assign
     4691         v-diasize-need-full-display = false
     4692       .
     4693     end.
     4694   end procedure.
     4695   procedure get-context :
     4696      define output parameter p-db-num as integer          no-undo.
     4697      define output parameter p-user-id as character        no-undo.
     4698      define variable v-login               as character    no-undo.
     4699      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4700      define buffer buf_user-login  for ub.user-login .
     4701      do
     4702      on error undo, return error
     4703      :
     4704            FIND FIRST buf_sys-ctrl no-lock.
     4705            ASSIGN
     4706               v-login = USERID("ub")
     4707               p-db-num = buf_sys-ctrl.db-num
     4708            .
     4709            FIND FIRST buf_user-login
     4710                 WHERE buf_user-login.db-num = p-db-num
     4711                   AND buf_user-login.user-login = v-login
     4712                 no-lock
     4713                 no-error
     4714                 .
     4715            IF AVAILABLE buf_user-login
     4716            THEN DO:
     4717               assign
     4718                  p-user-id = buf_user-login.user-id
     4719               .
     4720            END.
     4721      end.
     4722   end procedure.
     4723   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4724   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4725   define variable v-no-context as logical no-undo .
     4726   define variable v-user-obj-type as character no-undo .
     4727   define variable v-user-obj-code as integer no-undo .
     4728   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     4729                                            , input p-no-context as logical ):
     4730   define variable v-uniq-key-rec as character no-undo .
     4731   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     4732     v-uniq-key-rec = 'clients':U + chr(3) +
     4733                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     4734                     entry(5, p-uniq-key-rec, chr(3)).
     4735   end.
     4736   else do:
     4737     v-uniq-key-rec = p-uniq-key-rec.
     4738     case entry(1, p-uniq-key-rec, chr(3)):
     4739        when 'user-obj':U then do:
     4740          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     4741          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     4742        end.
     4743     end case.
     4744   end.
     4745   return v-uniq-key-rec.
     4746   end function.
     4747   procedure find-user-obj-rowid :
     4748   define input parameter p-rowid as rowid no-undo .
     4749   define input parameter p-no-context as logical no-undo .
     4750   define output parameter p-user-obj-type as character no-undo .
     4751   define output parameter p-user-obj-code as integer no-undo .
     4752   define buffer user-obj_clients for ub.clients.
     4753   define buffer user-obj_user-obj for ub.user-obj .
     4754   if p-no-context then do:
     4755     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     4756     assign
     4757     p-user-obj-type = user-obj_clients.obj-type
     4758     p-user-obj-code = user-obj_clients.obj-code.
     4759   end.
     4760   else do:
     4761     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     4762     if not available user-obj_user-obj then do:
     4763       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     4764     end.
     4765     assign
     4766     p-user-obj-type = user-obj_user-obj.obj-type
     4767     p-user-obj-code = user-obj_user-obj.obj-code.
     4768   end.
     4769   end procedure.
     4770   define variable an-listp-start-macro-id as integer no-undo init ?.
     4771   define variable an-listp-end-macro-id as integer no-undo  init ?.
     4772   define variable an-listp-macros-label-id as integer   no-undo .
     4773   define variable v-macro-is-running as logical no-undo .
     4774   define variable v-current-step as integer no-undo .
     4775   define variable v-expand as logical no-undo .
     4776   define variable v-downed as character no-undo .
     4777   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4778   define     temp-table keep-macro-list-hist no-undo
     4779   field list-table as character
     4780   field id as integer
     4781   field line as integer
     4782   field hist-mode as character
     4783   field des as character
     4784   field num-recs as integer
     4785   field option_ as character
     4786   field item_ as character
     4787   field status_ as character
     4788   field num-add as integer
     4789   field num-ignored as integer
     4790   field done as logical
     4791   field err_ as logical
     4792   field err-mes as character
     4793   index pi is primary
     4794   id
     4795   line
     4796   index isdone
     4797   done
     4798   .
     4799   procedure assign-nums :
     4800   define input-output parameter p-num-add as integer no-undo .
     4801   define input-output parameter p-num-rec as integer no-undo .
     4802   define input-output parameter p-num-ignored as integer no-undo .
     4803   define input parameter p-line-mode as character no-undo .
     4804   assign
     4805   p-num-add  = lns-cnt - v-num-add
     4806   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     4807                             then (tot-lns + p-num-add)
     4808                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     4809   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     4810   p-num-ignored = lns-ignore  - v-num-ignored
     4811   v-num-add             = lns-cnt
     4812   v-num-ignored         = lns-ignore
     4813   .
     4814   END PROCEDURE.
     4815   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     4816   or INSERT-MODE of br-list
     4817   DO:
     4818   define variable glog as logical no-undo .
     4819   define buffer buf-cli-list-hist for cli-list-hist.
     4820   define buffer buf_macro-list-hist for macro-list-hist.
     4821   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     4822    if p-keep-query then do:
     4823       glog = no.
     4824       message "Реинициализация списка. Вы уверены ?"
     4825               view-as alert-box question buttons OK-Cancel update glog.
     4826       if not glog then return no-apply.
     4827       if session:set-wait-state( "COMPILER" )  then .
     4828       for each cli-list:
     4829         delete cli-list.
     4830       end.
     4831       if session:set-wait-state( "" )  then .
     4832       tot-lns = 0.
     4833       v-seq = 1.
     4834       for each buf-cli-list-hist:
     4835         delete buf-cli-list-hist.
     4836       end.
     4837      for each buf_keep-macro-list-hist:
     4838        create buf_macro-list-hist.
     4839      end.
     4840      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     4841      run create-cli-list-hist in this-procedure (
     4842                                             input 'ДОБАВЛЕНИЕ':U
     4843                                           , input-output v-seq
     4844                                           , input 0
     4845                                           , input '0':U
     4846                                           , input "# Реинициализация списка."
     4847                                           , input 0
     4848                                           , input "init"
     4849                                           , input '':U
     4850                                           , input '':U
     4851                                           , input '':U
     4852                                           , input ?
     4853                                           ).
     4854       display
     4855       tot-lns @ f-tot-lns
     4856       with frame Dialog-Frame.
     4857       run MyEnable in this-procedure .
     4858    end.
     4859    else do:
     4860      assign rs-list-method = "single".
     4861      run proc-b-add in this-procedure(input no
     4862                                     ,input ?
     4863                                     ,input rs-list-method
     4864                                     ,input rs-status)  no-error .
     4865     if error-status:error then return no-apply.
     4866   end.
     4867   END.
     4868   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     4869   or DELETE-CHARACTER of br-list
     4870   DO:
     4871     if not available cli-list then return no-apply.
     4872     assign rs-list-method = "single".
     4873       run proc-b-del in this-procedure(
     4874                                                  input no
     4875                                                 ,input ?
     4876                                                 ,input rs-list-method
     4877                                                 ,input rs-status) no-error .
     4878     if error-status:error then return no-apply.
     4879   END.
     4880   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     4881   DO:
     4882   if not available cli-list then return no-apply.
     4883     assign rs-list-method = "single".
     4884    run proc-b-rest in this-procedure(
     4885                                                   input no
     4886                                                  ,input ?
     4887                                                  ,input rs-list-method
     4888                                                  ,input rs-status) no-error .
     4889     if error-status:error then return no-apply.
     4890   END.
     4891   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     4892     assign
     4893     macro-play-option = 'file':U.
     4894     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     4895   end.
     4896   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     4897     assign
     4898     macro-play-option = 'lob':U.
     4899     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     4900   end.
     4901   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     4902   DO:
     4903   if macro-play-option = '':U then do:
     4904         run gbl/pop-up.p ( input self:handle, input no) no-error.
     4905   end.
     4906   if macro-play-option = '':U then return no-apply.
     4907   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     4908   if error-status:error then return no-apply.
     4909   END.
     4910   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     4911   DO:
     4912   define variable glog as logical no-undo .
     4913   message
     4914   "Начать запись макроса формирования списка?"
     4915   view-as alert-box QUESTION buttons yes-no update glog.
     4916   if not glog then return no-apply.
     4917   assign
     4918   an-listp-start-macro-id = v-seq
     4919   an-listp-end-macro-id = ?
     4920   .
     4921     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     4922     menu-item m-macro-lob:sensitive in menu m-play = no.
     4923   disable
     4924   b-record with frame Dialog-Frame .
     4925   hide
     4926   b-record
     4927   b-macro
     4928   in frame Dialog-Frame .
     4929   enable
     4930   b-stop with frame Dialog-Frame .
     4931   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4932                                       , input-output v-seq
     4933                                       , input 0
     4934                                       , input 'o':U
     4935                                       , input "Начата запись макроса формирования списка"
     4936                                       , input tot-lns
     4937                                       , input 'macro':U
     4938                                       , input '':U
     4939                                       , input '':U
     4940                                       , input '':U
     4941                                       , input ?
     4942                                       ).
     4943   END.
     4944   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     4945   DO:
     4946   define variable glog as logical no-undo .
     4947   define variable v-id as integer no-undo .
     4948   define buffer buf_cli-list-hist for cli-list-hist.
     4949   message
     4950   "Закончить запись макроса формирования списка?"
     4951   view-as alert-box QUESTION buttons yes-no update glog.
     4952   if not glog then return no-apply.
     4953   assign
     4954   an-listp-end-macro-id = v-seq.
     4955   disable
     4956   b-stop with frame Dialog-Frame .
     4957   hide
     4958   b-stop in frame Dialog-Frame .
     4959   enable
     4960   b-record
     4961   b-macro
     4962   with frame Dialog-Frame .
     4963   run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4964                                       , input-output v-seq
     4965                                       , input 0
     4966                                       , input '[]':U
     4967                                       , input "Закончена запись макроса формирования списка"
     4968                                       , input tot-lns
     4969                                       , input 'macro':U
     4970                                       , input '':U
     4971                                       , input '':U
     4972                                       , input '':U
     4973                                       , input ?
     4974                                       ).
     4975   for each macro-list-hist:
     4976     delete macro-list-hist.
     4977   end.
     4978   for each buf_cli-list-hist where
     4979           buf_cli-list-hist.id >=  an-listp-start-macro-id
     4980     and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     4981     create macro-list-hist.
     4982     buffer-copy buf_cli-list-hist
     4983     except id num-recs num-add num-ignored
     4984     to macro-list-hist
     4985     assign
     4986     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4987     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4988     .
     4989   end.
     4990   END.
     4991   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     4992   DO:
     4993   disable
     4994   b-clear-macro with frame Dialog-Frame .
     4995   assign
     4996   an-listp-start-macro-id = ?
     4997   an-listp-end-macro-id = ?
     4998   an-listp-macros-label-id = 0
     4999   .
     5000   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5001   for each macro-list-hist:
     5002     delete macro-list-hist.
     5003   end.
     5004   hide
     5005   b-clear-macro in frame Dialog-Frame .
     5006   enable
     5007   b-record
     5008   b-macro
     5009   with frame Dialog-Frame .
     5010   END.
     5011   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5012   DO:
     5013     assign
     5014     Rs-list-method = temp-list.fvalue
     5015     .
     5016     run proc-vc-rs-list-method in this-procedure no-error .
     5017     if error-status:error then return no-apply.
     5018   END.
     5019   PROCEDURE get-operation :
     5020   define input parameter p-message as character no-undo .
     5021   define output parameter p-operation as integer no-undo .
     5022     do
     5023     on error undo, return error
     5024     :
     5025       run gbl/d-askw.w (
     5026                     input "Выбор операции над заданным списком"
     5027                    ,input (p-message + chr(10) +
     5028                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5029                    ,input "|"
     5030                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5031                            "Удалить" + "|" +
     5032                            "Оставить" + "|" +
     5033                            "Отказ")
     5034                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5035                           "Удалить полученный список из уже имеющегося" + "|" +
     5036                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5037                           "Ничего не делать")
     5038                    ,input  (if p-keep-query then 2 else 1)
     5039                    ,input  4
     5040                    ,output p-operation).
     5041      if p-operation = 4 then do:
     5042         return error .
     5043      end.
     5044     end.
     5045   END PROCEDURE.
     5046   PROCEDURE proc-fill-temp-list :
     5047     define variable v-index               as integer   no-undo .
     5048     define variable v-num-entries-options as integer   no-undo .
     5049     do
     5050     on error undo, return error
     5051     :
     5052       assign
     5053         v-num-entries-options = num-entries("Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all")
     5054       .
     5055       do v-index = 1 to v-num-entries-options by 2
     5056       :
     5057         create temp-list.
     5058         assign
     5059           temp-list.fname  = trim(entry(v-index
     5060                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5061                                        )
     5062                                  ,chr(32)
     5063                                  )
     5064           temp-list.fvalue = trim(entry(v-index + 1
     5065                                        ,"Текущая строка,single,                              Клиент,cli,                                          Группа клиентов,cli-grp,                             Группа покупателей,grp-buy,                          Оборот покупателя с - по,turnov-buy,                 Все производители,prod,                              Все поставщики товаров,sup-gds,                      Все консигнанты,sup-cons,                            Все покупатели товаров,buy-gds,                      Все покупатели конс. товаров,buy-cons,               Все покупатели услуг,buy-serv,                       Все влад-цы диск.карт,dis-card,                      Все кассиры,cashiers,                                Все продавцы,sellers,                                Все  организации,firm,                               Все физ.лица,person,                                 Все магазины,shop,                                   Все склады,store,                                    Контрагенты по док-там,waybill,                      С установл. атрибутом,attr,                          С атрибутом = ,attr-val,                             Произ-ли товаров списка,gds-list,                    Контрагенты док-тов списка,doc-list,                 Удаленные,deleted,                                   Файл,file,                                           Хранимый в БД список,clob-data,                        Фильтр,filter,                                       Все клиенты,all"
     5066                                        )
     5067                                  ,chr(32)
     5068                                  )
     5069           temp-list.id     = v-index
     5070         .
     5071       end.
     5072     end.
     5073   END PROCEDURE.
     5074   procedure proc-b-macro :
     5075   define input parameter p-option as character no-undo .
     5076   define variable glog as logical no-undo .
     5077   define variable v-id as integer no-undo .
     5078   define variable v-result as character no-undo .
     5079   define variable v-des as character no-undo .
     5080   define variable v-hist-mode as character no-undo .
     5081   define variable v-file as logical no-undo .
     5082   define variable v-full-path        as character no-undo .
     5083   define variable v-path             as character no-undo .
     5084   define variable v-file-name        as character no-undo .
     5085   define variable v-file-name-no-ext as character no-undo .
     5086   define variable v-file-name-ext    as character no-undo .
     5087   define variable v-rid-list as character no-undo .
     5088   define variable v-ok as logical no-undo .
     5089   define buffer buf_cli-list-hist for cli-list-hist.
     5090   define buffer buf_clob-bind for ub.clob-bind.
     5091   define buffer buf_clob-data for ub.clob-data.
     5092   do
     5093   on error undo, return error
     5094   :
     5095     if v-macro-is-running then do:
     5096     end.
     5097     else do:
     5098       glog = yes.
     5099       if an-listp-start-macro-id >= 1 then do:
     5100         case p-option:
     5101           when "file" then do:
     5102         message
     5103         "Согласно командам формирования списка из записанного макроса"
     5104         view-as alert-box question buttons OK-Cancel update glog.
     5105           end.
     5106           when "lob" then do:
     5107             message
     5108             "Нелья!"
     5109             view-as alert-box question buttons OK-Cancel update glog.
     5110             run MyEnable in this-procedure .
     5111             return error.
     5112           end.
     5113         end case.
     5114         if not glog then do:
     5115           run MyEnable in this-procedure .
     5116           return error.
     5117         end.
     5118         if an-listp-end-macro-id = ? then do:
     5119           assign
     5120           an-listp-end-macro-id  = v-seq.
     5121           for each macro-list-hist:
     5122             delete macro-list-hist.
     5123           end.
     5124           for each buf_cli-list-hist where
     5125                   buf_cli-list-hist.id >=  an-listp-start-macro-id
     5126             and  buf_cli-list-hist.id <=  an-listp-end-macro-id:
     5127             create macro-list-hist.
     5128             buffer-copy buf_cli-list-hist
     5129             except id num-recs num-add num-ignored
     5130             to macro-list-hist
     5131             assign
     5132             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5133             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5134             macro-list-hist.done = no
     5135             .
     5136           end.
     5137         end.
     5138         else do:
     5139           find last macro-list-hist no-error.
     5140           if available macro-list-hist then do:
     5141             v-id = macro-list-hist.id.
     5142           end.
     5143         end.
     5144       end.
     5145       else do:
     5146         case p-option:
     5147           when "file" then do:
     5148         message
     5149         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     5150         view-as alert-box question buttons OK-Cancel update glog.
     5151         if not glog then do:
     5152           run MyEnable in this-procedure .
     5153           return error.
     5154         end.
     5155         system-dialog get-file f-name
     5156           filters "Макрос формирования списка *.clm" "*.clm"
     5157           title "Выберите файл макроса"
     5158           INITIAL-DIR "."
     5159           return-to-start-dir
     5160           must-exist
     5161           update glog
     5162           default-extension "clm".
     5163         if not glog then do:
     5164           run MyEnable in this-procedure .
     5165           return error.
     5166         end.
     5167           end.
     5168           when "lob" then do:
     5169             message
     5170             "Согласно командам формирования списка из макроса, сохраненного в БД"
     5171             view-as alert-box question buttons OK-Cancel update glog.
     5172             if not glog then do:
     5173               run MyEnable in this-procedure .
     5174               return error.
     5175             end.
     5176             run ref/clobbnds.w ( input parparentproc
     5177                                 ,input this-procedure:handle
     5178                                 ,input 'b-sel'
     5179                                 ,input "uniq-key-rec"
     5180                                 ,input ""
     5181                                 ,input 'list-macro':U
     5182                                 ,input 'cli-list'
     5183                                 ,input -1
     5184                                 ,input-output v-rid-list) no-error.
     5185             if v-rid-list = '' then do:
     5186               run MyEnable in this-procedure.
     5187               return error.
     5188             end.
     5189             find first buf_clob-bind no-lock where
     5190                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     5191             if not available buf_clob-bind then do:
     5192               message
     5193               "Не найдена ссылка на макрос, сохраненный в БД!"
     5194               view-as alert-box error .
     5195               run MyEnable in this-procedure .
     5196               return error.
     5197             end.
     5198             find first buf_clob-data no-lock where
     5199                       buf_clob-data.db-num = buf_clob-bind.db-num
     5200                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     5201             if not available buf_clob-data then do:
     5202               message
     5203               "Не найдена ссылка на макрос, сохраненный в БД!"
     5204               view-as alert-box error .
     5205               run MyEnable in this-procedure .
     5206               return error.
     5207             end.
     5208             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     5209               message
     5210               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     5211                         , buf_clob-data.db-num
     5212                         , chr(10))
     5213              view-as alert-box question buttons yes-no update v-ok.
     5214              if not v-ok then do:
     5215                 run MyEnable in this-procedure .
     5216                 return error.
     5217              end.
     5218             end.
     5219             run gbl/_tmpfile.p ( input ""
     5220                           ,input "tmp"
     5221                           ,output v-file-name) .
     5222             copy-lob from object buf_clob-data.cdata
     5223             to file f-name.
     5224             run gbl/filename.p
     5225               (input  v-file-name
     5226               ,output f-name
     5227               ,output v-path
     5228               ,output v-file-name
     5229               ,output v-file-name-no-ext
     5230               ,output v-file-name-ext
     5231               ) no-error .
     5232             if error-status:error then do:
     5233             end.
     5234           end.
     5235         end case.
     5236         for each macro-list-hist:
     5237           delete macro-list-hist.
     5238         end.
     5239         input stream sout from value (f-name).
     5240         _macro:
     5241         repeat:
     5242           create macro-list-hist.
     5243           import stream sout macro-list-hist no-error.
     5244           if error-status:error then do:
     5245               undo _macro, next _macro.
     5246           end.
     5247           assign
     5248           macro-list-hist.num-rec = 0
     5249           macro-list-hist.num-add = 0
     5250           macro-list-hist.num-ignored = 0
     5251           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5252           macro-list-hist.done = no
     5253           .
     5254         end.
     5255         find first macro-list-hist where
     5256                 macro-list-hist.id = 0.
     5257         delete macro-list-hist.
     5258         input stream sout close.
     5259         If p-option = "lob" then do:
     5260          os-delete value(f-name).
     5261         end.
     5262         v-file = yes.
     5263       end.
     5264       an-listp-macros-label-id = v-seq.
     5265       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5266                                           , input-output v-seq
     5267                                           , input 0
     5268                                           , input '>':U
     5269                                           , input (if v-file
     5270                                                   then substitute("Файл макроса : &1", f-name)
     5271                                                   else substitute("Записанный макрос")
     5272                                                   )
     5273                                           , input tot-lns
     5274                                           , input 'macro':U
     5275                                           , input '':U
     5276                                           , input (if v-file then f-name else '':U)
     5277                                           , input '':U
     5278                                           , input ?
     5279                                           ).
     5280     end.
     5281     disable
     5282     b-record
     5283     b-macro
     5284     with frame Dialog-Frame .
     5285     hide
     5286     b-record in frame Dialog-Frame .
     5287     enable
     5288     b-clear-macro with frame Dialog-Frame .
     5289     v-macro-is-running = yes.
     5290     run str/listmcro.w (input parparentproc
     5291                   ,input this-procedure:handle
     5292                  ,input "Макрос формирования списка клиентов" + chr(4) + "clm"
     5293                   ,input "b-play,b-step"
     5294                   ,input-output v-current-step
     5295                   ,input v-id
     5296                   ,output v-result) no-error .
     5297     if error-status:error
     5298     or v-result = "b-stop"
     5299     or v-result = 'end':U
     5300     then do:
     5301       for each macro-list-hist:
     5302         delete macro-list-hist.
     5303       end.
     5304       assign
     5305       an-listp-start-macro-id = ?
     5306       an-listp-end-macro-id = ?
     5307       an-listp-macros-label-id = 0
     5308       .
     5309       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     5310       menu-item m-macro-lob:sensitive in menu m-play = yes.
     5311       if v-result = 'b-stop' then do:
     5312         assign
     5313         v-hist-mode = '[]':U
     5314         v-des = "Выполнение макроса прекращено пользователем"
     5315         .
     5316         hide
     5317         b-clear-macro
     5318         b-stop
     5319         in frame Dialog-Frame .
     5320         enable
     5321         b-record
     5322         with frame Dialog-Frame .
     5323       end.
     5324       if v-result = 'end' then do:
     5325         assign
     5326         v-hist-mode = '<':U
     5327         v-des = "Выполнение макроса завершено"
     5328         .
     5329         hide
     5330         b-clear-macro
     5331         b-stop
     5332         in frame Dialog-Frame .
     5333         enable
     5334         b-record
     5335         with frame Dialog-Frame .
     5336       end.
     5337       if error-status:error then do:
     5338         assign
     5339         v-hist-mode = 'E':U
     5340         v-des = "Выполнение макроса прекращено из-за ошибки"
     5341         .
     5342       end.
     5343       run create-cli-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5344                                           , input-output v-seq
     5345                                           , input 0
     5346                                           , input v-hist-mode
     5347                                           , input v-des
     5348                                           , input tot-lns
     5349                                           , input 'macro':U
     5350                                           , input '':U
     5351                                           , input f-name
     5352                                           , input '':U
     5353                                           , input ?
     5354                                           ) no-error .
     5355       assign
     5356       v-macro-is-running = no
     5357       v-current-step = 0
     5358       .
     5359     end.
     5360     enable
     5361     b-macro
     5362     with frame Dialog-Frame .
     5363   end.
     5364   end procedure.
     5365   procedure proc-create-macro-list-hist :
     5366   define input parameter p-list-table as character no-undo .
     5367   define input parameter p-id as integer           no-undo .
     5368   define input parameter p-line as integer         no-undo .
     5369   define input parameter p-hist-mode as character  no-undo .
     5370   define input parameter p-des as character        no-undo .
     5371   define input parameter p-option_ as character    no-undo .
     5372   define input parameter p-item_ as character      no-undo .
     5373   define input parameter p-status_ as character    no-undo .
     5374   define buffer buf_macro-list-hist for macro-list-hist.
     5375   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5376     do
     5377     on error undo, return error return-value
     5378     :
     5379       create buf_macro-list-hist.
     5380       assign
     5381       buf_macro-list-hist.list-table = p-list-table
     5382       buf_macro-list-hist.id         = p-id
     5383       buf_macro-list-hist.line       = p-line
     5384       buf_macro-list-hist.hist-mode  = p-hist-mode
     5385       buf_macro-list-hist.des        = p-des
     5386       buf_macro-list-hist.option_    = p-option_
     5387       buf_macro-list-hist.item_      = p-item_
     5388       buf_macro-list-hist.status_    = p-status_
     5389       .
     5390       if p-keep-query then do:
     5391         create buf_keep-macro-list-hist.
     5392         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     5393       end.
     5394     end.
     5395   end procedure.
     5396   procedure proc-macro-play :
     5397   define input parameter p-id as integer no-undo .
     5398   define input parameter p-step as logical no-undo .
     5399   define input parameter p-max-id as integer no-undo .
     5400   define variable v-id as integer no-undo .
     5401   define variable v-rowid   as rowid no-undo .
     5402   define variable v-tbl-name as character no-undo .
     5403   define variable v-old-seq as integer no-undo .
     5404   define variable v-current-id as integer no-undo .
     5405   define variable v-temp-seq as integer no-undo .
     5406   define variable v-rs-do-error as logical no-undo .
     5407   define  buffer buf_macro-list-hist for macro-list-hist.
     5408   define  buffer buf_cli-list-hist for cli-list-hist.
     5409   do
     5410   on error undo, return error return-value
     5411   :
     5412     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     5413       assign
     5414       v-current-id = v-current-id + 1
     5415       v-id = macro-list-hist.id.
     5416       CASE entry(1, macro-list-hist.option_, chr(4)):
     5417         when 'macro':U
     5418         or
     5419         when 'title':U
     5420         or
     5421         when 'start':U
     5422         then do:
     5423         end.
     5424         when 'clear':U then do:
     5425           for each cli-list:
     5426             delete cli-list.
     5427           end.
     5428           for each cli-list-hist where cli-list-hist.id > an-listp-macros-label-id:
     5429             delete cli-list-hist.
     5430           end.
     5431           tot-lns = 0.
     5432           v-seq = an-listp-macros-label-id + 1.
     5433           v-no-hist = 0.
     5434           create buf_cli-list-hist.
     5435           buffer-copy macro-list-hist
     5436           to buf_cli-list-hist
     5437           assign buf_cli-list-hist.id = v-seq
     5438           v-temp-seq = v-seq
     5439           v-seq = v-seq + 1
     5440           v-no-hist = v-no-hist + 1
     5441           .
     5442           run MyEnable in this-procedure .
     5443         end.
     5444         when 'single' then do:
     5445            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     5446                                                 ,input ?
     5447                                                 ,input 'ub'
     5448                                                 ,input ?
     5449                                                 ,input no-lock
     5450                                                 ,output v-rowid
     5451                                                 ,output v-tbl-name) no-error .
     5452           if not error-status:error then do:
     5453             CASE macro-list-hist.hist-mode:
     5454               when '+':U then do:
     5455                 run proc-b-add in this-procedure(input yes
     5456                                                 ,input v-rowid
     5457                                                 ,input macro-list-hist.option_
     5458                                                 ,input macro-list-hist.status_) no-error .
     5459               end.
     5460               when '-':U then do:
     5461                 run proc-b-del in this-procedure(input yes
     5462                                                 ,input v-rowid
     5463                                                 ,input macro-list-hist.option_
     5464                                                 ,input macro-list-hist.status_) no-error .
     5465               end.
     5466               when '*':U then do:
     5467                 run proc-b-rest in this-procedure(input yes
     5468                                                  ,input v-rowid
     5469                                                  ,input macro-list-hist.option_
     5470                                                  ,input macro-list-hist.status_) no-error .
     5471               end.
     5472             END.
     5473             if error-status:error then do:
     5474                 return ("error" + chr(4) + return-value) .
     5475             end.
     5476             find first  buf_cli-list-hist where
     5477                     buf_cli-list-hist.id = v-seq - 1 no-error .
     5478             if available buf_cli-list-hist then
     5479             assign
     5480             macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5481             macro-list-hist.num-add = buf_cli-list-hist.num-add
     5482             macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5483             .
     5484           end.
     5485           else do:
     5486             return ("error" + chr(4) + return-value).
     5487           end.
     5488         end.
     5489         otherwise do:
     5490           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     5491           or lookup(macro-list-hist.option_, '':U) > 0
     5492           then do:
     5493             if macro-list-hist.line = 0 then do:
     5494               v-no-hist = 0.
     5495               for each buf_macro-list-hist where
     5496                       buf_macro-list-hist.id = v-id:
     5497                 create buf_cli-list-hist.
     5498                 buffer-copy buf_macro-list-hist
     5499                 except id  num-recs num-add num-ignored done
     5500                 to buf_cli-list-hist
     5501                 assign
     5502                 buf_cli-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     5503                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     5504                 v-seq = (if buf_macro-list-hist.line = 0
     5505                         then (v-seq + 1)
     5506                         else v-seq)
     5507                 v-no-hist = v-no-hist + 1
     5508                 .
     5509               end.
     5510               if v-no-hist = 1 then v-no-hist = 0.
     5511               run rs-do in this-procedure (input yes
     5512                                         , input p-step
     5513                                         , input macro-list-hist.option_
     5514                                         , input macro-list-hist.status_
     5515                                         , input get-line-mode(macro-list-hist.hist-mode)
     5516                                         , input v-temp-seq
     5517                                         ) no-error .
     5518               if error-status:error then do:
     5519                 assign
     5520                 v-rs-do-error = yes.
     5521               end.
     5522               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     5523                 run proc-b-rest-2 in this-procedure .
     5524                 run MyEnable in this-procedure .
     5525               end.
     5526               for each buf_cli-list-hist where
     5527                       buf_cli-list-hist.id = v-temp-seq,
     5528                  first buf_macro-list-hist where
     5529                       buf_macro-list-hist.id = v-id
     5530                   AND buf_macro-list-hist.line = buf_cli-list-hist.line:
     5531                  assign
     5532                  buf_macro-list-hist.num-recs = buf_cli-list-hist.num-recs
     5533                  buf_macro-list-hist.num-add = buf_cli-list-hist.num-add
     5534                  buf_macro-list-hist.num-ignored = buf_cli-list-hist.num-ignored
     5535                  .
     5536               end.
     5537               if v-rs-do-error then do:
     5538                 run MyEnable in this-procedure .
     5539                 return ("error" + chr(4) + return-value).
     5540               end.
     5541               v-id = macro-list-hist.id.
     5542             end.
     5543           end.
     5544         end.
     5545       END CASE.
     5546     end.
     5547   end.
     5548   end procedure.
     5549   procedure proc-b-rest-2 :
     5550     do
     5551     on error undo, return error
     5552     :
     5553       for each cli-list:
     5554         if cli-list.to-del = ? then do:
     5555           assign
     5556           cli-list.to-del = no
     5557           .
     5558         end.
     5559         else do:
     5560           delete cli-list.
     5561         end.
     5562       end.
     5563       tot-lns = lns-cnt.
     5564     end.
     5565   end procedure.
     5566   PROCEDURE proc-expand :
     5567   define input parameter p-shift as integer no-undo .
     5568   define input parameter p-from as integer no-undo .
     5569   define input parameter p-to as integer no-undo .
     5570   define input parameter p-forcer-name as character no-undo .
     5571   define variable fh as widget-handle no-undo .
     5572   define variable hh as widget-handle no-undo .
     5573   define variable lh as widget-handle no-undo .
     5574   define variable ii as INTEGER no-undo .
     5575   ASSIGN
     5576   fh = frame Dialog-Frame:first-child
     5577   hh = fh:first-child
     5578   .
     5579   CASE v-expand:
     5580     WHEN YES THEN DO:
     5581       ASSIGN
     5582       v-expand = NO.
     5583       DO ii = 1 TO NUM-ENTRIES(v-downed):
     5584         ASSIGN
     5585         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     5586         hh:ROW          = (hh:ROW - p-shift).
     5587         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     5588       END.
     5589     END.
     5590     WHEN NO THEN DO:
     5591       v-expand = YES.
     5592       v-downed = ''.
     5593       _do:
     5594       do while valid-handle(hh):
     5595         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     5596          AND hh:ROW >= p-from
     5597          AND hh:ROW <= p-to
     5598          and lookup(hh:name, p-forcer-name) = 0
     5599          THEN DO:
     5600           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     5601           hh:ROW          = (hh:ROW + p-shift).
     5602           ASSIGN
     5603           v-downed = v-downed + chr(44) + STRING(hh).
     5604           IF hh:TYPE = "fill-in"
     5605           AND valid-handle(hh:side-label-handle) THEN dO:
     5606             assign
     5607             lh = hh:SIDE-LABEL-HANDLE
     5608             lh:ROW = lh:ROW + p-shift
     5609             v-downed = v-downed + chr(44) + STRING(lh)
     5610             .
     5611            END.
     5612          END.
     5613          hh = hh:next-sibling.
     5614       END.
     5615       v-downed = trim(v-downed, chr(44)).
     5616     END.
     5617   END CASE.
     5618   END PROCEDURE.
     5619   if lookup(bttns, "hide") = 0 then do:
     5620   run diasize_add_browse in this-procedure
     5621     (input  'height':u
     5622     ,input  browse BR-option :handle
     5623     ) .
     5624   run diasize_init in this-procedure .
     5625   end.
     5626   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5627   PROCEDURE ex-cli :
     5628   define input parameter rs-list-method as character no-undo .
     5629   define input parameter rs-status as character no-undo .
     5630   define input parameter line-mode as character no-undo .
     5631   if rs-list-method = "single":U or
     5632     (ub.clients.stts = 0  and rs-status <> 'удаленные':U) or
     5633     (ub.clients.stts <> 0 and rs-status <> 'текущие':U) then do:
     5634     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     5635       find first cli-list where
     5636                  cli-list.obj-type = ub.clients.obj-type AND
     5637                  cli-list.obj-code = ub.clients.obj-code no-error.
     5638       if available cli-list then do:
     5639         if line-mode = 'удаление':U then do:
     5640           lns-cnt = lns-cnt + 1.
     5641           delete cli-list.
     5642         end.
     5643         else do:
     5644           if cli-list.to-del = ? then .
     5645           else do:
     5646              lns-cnt = lns-cnt + 1.
     5647              cli-list.to-del = ?.
     5648           end.
     5649         end.
     5650       end.
     5651     end.
     5652     else
     5653       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     5654   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5655   find cli-list
     5656     where cli-list.obj-type = clients.obj-type
     5657       and cli-list.obj-code = clients.obj-code
     5658     no-error .
     5659   if available cli-list then do:
     5660     assign
     5661       cli-list.to-del = no
     5662     .
     5663   end.
     5664   else do:
     5665     create cli-list .
     5666     buffer-copy clients to cli-list
     5667     assign
     5668       cli-list.to-del = no
     5669     .
     5670     assign
     5671       lns-cnt = lns-cnt + 1
     5672       line-rec = recid (cli-list)
     5673     .
     5674   end.
     5675       end.
     5676     if lns-cnt modulo 25 = 0 then
     5677     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     5678   end.
     5679   else
     5680   assign
     5681   lns-ignore = lns-ignore + 1
     5682   .
     5683   end.
     5684   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5685   do:
     5686     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5687   end.
     5688   MAIN-BLOCK:
     5689   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5690      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5691     if lookup("automain", parparentproc:file-name, ".") > 0 then do:
     5692       v-no-context = yes.
     5693     end.
     5694     else do:
     5695   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5696     run mainmenu_getcntxt in parparentproc
     5697       (output v-cntxt-db-num
     5698       ,output v-cntxt-userid
     5699       ,output v-cntxt-level
     5700       ,output v-cntxt-host-code-obj
     5701       ,output v-cntxt-obj-type
     5702       ,output v-cntxt-obj-code
     5703       ,output v-cntxt-db-num-obj
     5704       ,output v-cntxt-is-admin
     5705       ) .
     5706     end.
     5707   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5708   do:
     5709     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5710       (input  v-cntxt-db-num
     5711       ,input  v-cntxt-userid
     5712       ,input  0
     5713       ,input  'actn_documents_all':U
     5714       ,input  'global':U
     5715       ,input  0
     5716       ,input  '':U
     5717       ,input  0
     5718       ,input  0
     5719       ,input  0
     5720       ,input  0
     5721       ,input  false
     5722       ,output v-docs-all
     5723       )  .
     5724   end.
     5725   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5726   do:
     5727     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5728       (input  v-cntxt-db-num
     5729       ,input  v-cntxt-userid
     5730       ,input  0
     5731       ,input  'actn_documents_company':U
     5732       ,input  'firm':U
     5733       ,input  v-cntxt-host-code-obj
     5734       ,input  '':U
     5735       ,input  0
     5736       ,input  0
     5737       ,input  0
     5738       ,input  0
     5739       ,input  false
     5740       ,output v-docs-cmp
     5741       )  .
     5742   end.
     5743     run get-report-num in parparentproc ( output g#report-num ).
     5744       assign
     5745       line-rec = ?
     5746       .
     5747       assign
     5748       n-c:radio-buttons in frame Dialog-Frame =
     5749       "Название" + chr(44) + 'название':U + chr(44) +
     5750                       "Код" + chr(44) + 'код':U
     5751       RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     5752                                 "Все!" + chr(44) + 'все':U + chr(44) +
     5753                                 "Удаленные-" + chr(44) + 'удаленные':U
     5754       RS-status = 'текущие':U
     5755       .
     5756     ASSIGN b-save:MENU-MOUSE = 1.
     5757     ASSIGN b-print:MENU-MOUSE = 1.
     5758     assign b-macro:menu-mouse = 1.
     5759     run proc-fill-temp-list in this-procedure .
     5760     run request-create-macro-list-hist  in p-parent-handle ( input this-procedure:handle).
     5761     run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5762     if lookup(bttns, "hide") > 0 then do:
     5763       return.
     5764     end.
     5765     RUN Myenable in this-procedure .
     5766     APPLY "VALUE-CHANGED" to n-c.
     5767     WAIT-FOR GO OF FRAME Dialog-Frame.
     5768   END.
     5769   RUN disable_UI in this-procedure .
     5770   procedure cb_fill-lob-res-list :
     5771   define input  parameter p-full-path as character no-undo .
     5772   output to value (p-full-path).
     5773   for each cli-list:
     5774     export
     5775     cli-list.obj-type
     5776     cli-list.obj-code.
     5777   end.
     5778   output close.
     5779   end procedure.
     5780   procedure cb_fill-lob-res-list-macro :
     5781   define input  parameter p-full-path as character no-undo .
     5782   define buffer buf_cli-list-hist for cli-list-hist.
     5783   output to value (p-full-path).
     5784   for each buf_cli-list-hist:
     5785       export
     5786       buf_cli-list-hist.
     5787   end.
     5788   output close.
     5789   end procedure.
     5790   procedure cb_get-next-cli-by-obj-type-code :
     5791   define input parameter p-obj-type as character no-undo .
     5792   define input parameter p-obj-code as integer no-undo .
     5793   define input parameter p-bh as handle no-undo .
     5794   define buffer buf_cli-list for cli-list.
     5795   find first buf_cli-list no-lock where
     5796             (buf_cli-list.obj-type = p-obj-type
     5797        and  buf_cli-list.obj-code = p-obj-code) no-error.
     5798   find next buf_cli-list use-index obj no-error.
     5799   if available buf_cli-list then do:
     5800     p-bh:buffer-create().
     5801     p-bh:buffer-copy(buffer buf_cli-list:handle).
     5802   end.
     5803   else do:
     5804   end.
     5805   end procedure.
     5806   PROCEDURE disable_UI :
     5807     HIDE FRAME Dialog-Frame.
     5808   END PROCEDURE.
     5809   PROCEDURE enable_UI :
     5810     DISPLAY dsp-rs NameOrCode n-c RS-Status ed-notes f-tot-lns
     5811         WITH FRAME Dialog-Frame.
     5812     ENABLE dsp-rs B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     5813            B-del B-rest B-macro B-stop B-clear-macro B-record NameOrCode
     5814            n-c RS-Status BR-list ed-notes f-tot-lns
     5815         WITH FRAME Dialog-Frame.
     5816     VIEW FRAME Dialog-Frame.
     5817     OPEN QUERY BR-list FOR EACH cli-list NO-LOCK INDEXED-REPOSITION.     open query br-option for each temp-list no-lock .
     5818   END PROCEDURE.
     5819   procedure m_cli-save-db-proc :
     5820   define variable v-rid-list as character no-undo .
     5821   run ref/clobbnds.w ( input parparentproc
     5822                       ,input this-procedure:handle
     5823                       ,input 'b-add'
     5824                       ,input "uniq-key-rec"
     5825                       ,input 'ИЗМЕНЕНИЕ':U
     5826                       ,input 'list':U
     5827                       ,input 'cli-list'
     5828                       ,input -1
     5829                       ,input-output v-rid-list) no-error.
     5830   end procedure.
     5831   procedure m-macros-save-db-proc :
     5832   define variable v-rid-list as character no-undo .
     5833   run ref/clobbnds.w ( input parparentproc
     5834                       ,input this-procedure:handle
     5835                       ,input 'b-add'
     5836                       ,input "uniq-key-rec"
     5837                       ,input 'ИЗМЕНЕНИЕ':U
     5838                       ,input 'list-macro':U
     5839                       ,input 'cli-list'
     5840                       ,input -1
     5841                       ,input-output v-rid-list) no-error.
     5842   end procedure.
     5843   PROCEDURE MyEnable :
     5844   define variable v-start as logical no-undo .
     5845   define variable v-recid0 as recid no-undo .
     5846   define buffer buf_temp-list for temp-list.
     5847   define buffer buf_cli-list-hist for cli-list-hist.
     5848   find first buf_cli-list-hist where buf_cli-list-hist.id = 0 no-error.
     5849   if available buf_cli-list-hist then
     5850   assign
     5851   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1",  string(buf_cli-list-hist.des, "X(60)"))
     5852   .
     5853   br-option:column-scrolling in frame Dialog-Frame  = no.
     5854   assign
     5855   frame Dialog-Frame:title = p-title
     5856   .
     5857   if tot-lns = ? then do:
     5858     v-start = yes.
     5859     for each l-cli-list :
     5860       accumulate l-cli-list.obj-code (count).
     5861     end.
     5862     tot-lns = (accum count l-cli-list.obj-code).
     5863     if tot-lns > 0 then do:
     5864       find last  buf_cli-list-hist no-error .
     5865       v-seq = (if available buf_cli-list-hist then buf_cli-list-hist.id else 0)  + 1.
     5866       run create-cli-list-hist in this-procedure (
     5867                                               input 'ДОБАВЛЕНИЕ':U
     5868                                             , input-output v-seq
     5869                                             , input 0
     5870                                             , input 'S':U
     5871                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     5872                                             , input tot-lns
     5873                                             , input "start":U
     5874                                             , input '':U
     5875                                             , input '':U
     5876                                             , input '':U
     5877                                             , input ?
     5878                                             ).
     5879     end.
     5880     else do:
     5881       line-mode = 'ДОБАВЛЕНИЕ':U.
     5882       for each buf_cli-list-hist:
     5883         delete buf_cli-list-hist.
     5884       end.
     5885       v-seq = 1.
     5886       run create-cli-list-hist in this-procedure ( input 'ДОБАВЛЕНИЕ':U
     5887                                             , input-output v-seq
     5888                                             , input 0
     5889                                             , input '':U
     5890                                             , input "# Исходный список клиентов пуст."
     5891                                             , input tot-lns
     5892                                             , input 'start':U
     5893                                             , input '':U
     5894                                             , input '':U
     5895                                             , input '':U
     5896                                             , input ?
     5897                                             ).
     5898     end.
     5899   end.
     5900   assign
     5901   nameorcode = ""
     5902   RS-list-method = "single".
     5903   find first buf_temp-list no-lock where
     5904               buf_temp-list.fvalue = "single".
     5905   assign
     5906   v-recid0 = recid(buf_temp-list).
     5907   open query br-option for each temp-list no-lock .
     5908   if v-seq > 1 then
     5909   find last buf_cli-list-hist no-lock where
     5910             buf_cli-list-hist.id = (v-seq - 1)
     5911         and  buf_cli-list-hist.line = 0 no-error .
     5912   DISPLAY br-option
     5913   (if available buf_cli-list-hist
     5914   then buf_cli-list-hist.des
     5915   else '') @ dsp-rs
     5916   RS-Status WITH FRAME Dialog-Frame.
     5917   ENABLE
     5918   b-macro  when v-start
     5919   b-record when v-start
     5920   b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     5921   assign
     5922   b-add:label = "Исходн.сп."
     5923   .
     5924   if v-start then do:
     5925     hide
     5926     b-stop
     5927     b-clear-macro
     5928     in frame Dialog-Frame.
     5929   end.
     5930   v-start = no.
     5931   hide nameorcode in frame Dialog-Frame .
     5932   reposition br-option to recid v-recid0.
     5933   if tot-lns > 0 then
     5934     ENABLE
     5935     b-print
     5936     b-rest
     5937     b-save
     5938     b-del
     5939     b-lkp
     5940     b-clr
     5941     n-c
     5942     nameorcode
     5943     WITH FRAME Dialog-Frame.
     5944   else do:
     5945     DISABLE b-print b-rest b-save b-del b-lkp b-clr n-c nameorcode WITH FRAME Dialog-Frame.
     5946   end.
     5947   if tot-lns = ? or tot-lns = 0 then do:
     5948     hide nameorcode in frame Dialog-Frame .
     5949   end.
     5950   VIEW FRAME Dialog-Frame.
     5951   run openbr in this-procedure .
     5952       if line-rec <> ? then
     5953     reposition br-list to recid line-rec no-error.
     5954   if avail cli-list then do:     assign ed-notes = cli-list.ps.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     5955   END PROCEDURE.
     5956   PROCEDURE Openbr :
     5957   Open query br-list
     5958   for each cli-list No-LOCK indexed-reposition.
     5959   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     5960   END PROCEDURE.
     5961   PROCEDURE proc-b-add :
     5962   define input parameter p-from-macro as logical no-undo .
     5963   define input parameter p-rowid as rowid no-undo .
     5964   define input parameter rs-list-method as character no-undo .
     5965   define input parameter rs-status as character no-undo .
     5966   line-mode = 'ДОБАВЛЕНИЕ':U.
     5967   if rs-list-method = "single" then do:
     5968     v-no-hist = - 1.
     5969     if p-from-macro then do:
     5970       find ub.clients where rowid(ub.clients) = p-rowid no-lock no-error .
     5971     end.
     5972     else do:
     5973     run ref/cli-all.w (
     5974                         input parparentproc
     5975                       , input "b-sel,b-add"
     5976                       , input ?
     5977                       , input ?
     5978                       , input ?
     5979                       , input ?
     5980                       , input ?
     5981                       , input ?
     5982                       , output ref-list).
     5983       apply "entry" to br-list in frame Dialog-Frame.
     5984       if ref-list = "" then return error.
     5985       find ub.clients where recid (ub.clients) = integer (ref-list) no-lock.
     5986     end.
     5987     if available ub.clients then do:
     5988       run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     5989       tot-lns = tot-lns + 1.
     5990       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     5991     end.
     5992     else do:
     5993       return error "Нет в БД такого клиента".
     5994     end.
     5995     run Myenable in this-procedure .
     5996   end.
     5997   else do:
     5998       run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     5999   end.
     6000   END PROCEDURE.
     6001   PROCEDURE proc-b-del :
     6002   define input parameter p-from-macro as logical no-undo .
     6003   define input parameter p-rowid as rowid no-undo .
     6004   define input parameter rs-list-method as character no-undo .
     6005   define input parameter rs-status as character no-undo .
     6006   define variable rep-rec as recid no-undo .
     6007   define variable glog as logical no-undo .
     6008   line-mode = 'удаление':U.
     6009   if rs-list-method = "single" then do:
     6010     v-no-hist = - 1.
     6011     if p-from-macro then do:
     6012       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6013       if not available ub.clients then return error "Нет в БД такой клиента".
     6014       find first cli-list where
     6015                cli-list.obj-type = ub.clients.obj-type
     6016            AND cli-list.obj-code = ub.clients.obj-code no-error.
     6017     end.
     6018     if available cli-list then do:
     6019       line-rec = recid (cli-list).
     6020       get next br-list.
     6021       if available cli-list then rep-rec = recid (cli-list).
     6022       else do:
     6023         reposition br-list to recid line-rec no-error.
     6024         get prev br-list.
     6025         if available cli-list then rep-rec = recid (cli-list).
     6026       end.
     6027       reposition br-list to recid line-rec no-error.
     6028       tot-lns = tot-lns - 1.
     6029       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6030       delete cli-list.
     6031       line-rec = rep-rec.
     6032       run Myenable in this-procedure .
     6033     end.
     6034   end.
     6035   else do:
     6036     glog = no.
     6037     message "Удалить клиентов из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     6038             view-as alert-box question buttons OK-Cancel update glog.
     6039     if not glog then
     6040       return error.
     6041     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6042   end.
     6043   END PROCEDURE.
     6044   PROCEDURE proc-b-rest :
     6045   define input parameter p-from-macro as logical no-undo .
     6046   define input parameter p-rowid as rowid no-undo .
     6047   define input parameter rs-list-method as character no-undo .
     6048   define input parameter rs-status as character no-undo .
     6049   define variable glog as logical no-undo .
     6050   define buffer buf_cli-list-hist for cli-list-hist.
     6051   line-mode = 'ОСТАВИТЬ':U.
     6052   if rs-list-method = "single" then do:
     6053     v-no-hist = - 1.
     6054     if p-from-macro then do:
     6055       find first ub.clients where rowid(ub.clients) = p-rowid no-error.
     6056       if not available ub.clients then return error substitute("Нет в БД такого клиента").
     6057       find first cli-list where
     6058                 cli-list.obj-type = ub.clients.obj-type
     6059             AND cli-list.obj-code = ub.clients.obj-code no-error.
     6060     end.
     6061     if available cli-list then do:
     6062       if p-from-macro then do:
     6063          glog = yes.
     6064       end.
     6065       else do:
     6066         glog = no.
     6067         message
     6068         "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6069         view-as alert-box question buttons OK-Cancel update glog.
     6070         if not glog then return no-apply.
     6071       end.
     6072       line-rec = recid (cli-list).
     6073       v-seq = 1.
     6074       for each buf_cli-list-hist:
     6075         delete buf_cli-list-hist.
     6076       end.
     6077       run write-hist in this-procedure ( input p-from-macro, input rs-list-method, input rs-status, input line-mode).
     6078       for each cli-list:
     6079         if line-rec <> recid (cli-list) then delete cli-list.
     6080       end.
     6081       tot-lns = 1.
     6082       run Myenable in this-procedure .
     6083     end.
     6084     else do:
     6085       return error substitute("Нет в списке такой клиента").
     6086     end.
     6087   end.
     6088   else do:
     6089     if not p-from-macro then do:
     6090       glog = no.
     6091       message
     6092       "Оставить клиентов в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕХ ОСТАЛЬНЫХ ?   Вы уверены ?"
     6093       view-as alert-box question buttons OK-Cancel update glog.
     6094       if not glog then
     6095         return no-apply.
     6096     end.
     6097     assign
     6098     lns-cnt = 0
     6099     lns-ignore = 0
     6100     .
     6101     run rs-do in this-procedure ( input no, input no, input rs-list-method, input rs-status, input line-mode, input (v-seq - 1)).
     6102     for each cli-list:
     6103       if cli-list.to-del = ? then do:
     6104         assign
     6105         cli-list.to-del = no
     6106         .
     6107       end.
     6108       else do:
     6109         delete cli-list.
     6110       end.
     6111     end.
     6112     tot-lns = lns-cnt.
     6113     run Myenable in this-procedure .
     6114     message
     6115     "Оставлено строк :" lns-cnt skip(0)
     6116     string(if lns-ignore <> 0
     6117     then ("Проигнорировано строк :" + string(lns-ignore))
     6118     else "":U)
     6119     .
     6120   end.
     6121   END PROCEDURE.
     6122   procedure proc-file-list-methods :
     6123   define input parameter p-from-macro as logical no-undo .
     6124   define input parameter rs-list-method as character no-undo .
     6125   define input parameter rs-status as character no-undo .
     6126   define input parameter line-mode as character no-undo .
     6127   define input parameter p-id      as integer no-undo .
     6128   define variable ss as character no-undo .
     6129   define variable imp-type like ub.goods.prod-type no-undo.
     6130   define variable imp-code like ub.goods.prod-code no-undo.
     6131   define variable imp-art like ub.goods.artic no-undo.
     6132   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     6133   define variable imp-doc-type as character no-undo.
     6134   define variable v-full-path        as character no-undo .
     6135   define variable v-path             as character no-undo .
     6136   define variable v-file-name        as character no-undo .
     6137   define variable v-file-name-no-ext as character no-undo .
     6138   define variable v-file-name-ext    as character no-undo .
     6139   define variable v-tbl-row          as rowid no-undo .
     6140   define variable v-tbl-name         as character no-undo .
     6141   define buffer buf_cli-list-hist for cli-list-hist.
     6142   define buffer buf_clob-data for ub.clob-data.
     6143   define buffer buf_clob-bind for ub.clob-bind.
     6144   do
     6145   on error undo, return error
     6146   :
     6147     find first buf_cli-list-hist where
     6148             buf_cli-list-hist.id = p-id
     6149         AND buf_cli-list-hist.item_ <> '':U .
     6150   if rs-list-method = "clob-data" then do:
     6151     run gen-row-keyr in this-procedure (
     6152      input  buf_cli-list-hist.item_
     6153     ,input  ?
     6154     ,input  "ub"
     6155     ,input  ?
     6156     ,input NO-LOCK
     6157     ,output v-tbl-row
     6158     ,output v-tbl-name  ) no-error.
     6159     if error-status :error then do:
     6160       message
     6161       "Ошибка при поиске хранимого файла"
     6162       view-as alert-box error.
     6163       return error.
     6164     end.
     6165     find first buf_clob-bind no-lock where
     6166               rowid(buf_clob-bind) = v-tbl-row .
     6167     find first buf_clob-data no-lock where
     6168               buf_clob-data.db-num = buf_clob-bind.db-num
     6169           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6170     if error-status :error then do:
     6171       message
     6172       "Ошибка при пополучении хранимого файла"
     6173       view-as alert-box error.
     6174       return error.
     6175     end.
     6176     run gbl/_tmpfile.p ( input ""
     6177                   ,input "tmp"
     6178                   ,output v-file-name) .
     6179     copy-lob from object buf_clob-data.cdata
     6180     to file v-file-name.
     6181   end.
     6182     run gbl/filename.p (
     6183      input  (if rs-list-method = "clob-data" then v-file-name else buf_cli-list-hist.item_  )
     6184     ,output v-full-path
     6185     ,output v-path
     6186     ,output v-file-name
     6187     ,output v-file-name-no-ext
     6188     ,output v-file-name-ext
     6189     ) no-error .
     6190     if error-status:error then do:
     6191     end.
     6192     else do:
     6193       input stream sout from value (v-full-path).
     6194       CASE rs-list-method:
     6195         when "doc-list" then do:
     6196           repeat:
     6197             import stream sout imp-doc-code imp-doc-type no-error.
     6198             if imp-doc-type <>  'переоценка':U then do:
     6199               find first ub.trn-doc no-lock where
     6200                         ub.trn-doc.doc-code = imp-doc-code No-error.
     6201               if available ub.trn-doc  then do:
     6202                 find first ub.clients no-lock where
     6203                           ub.clients.obj-type = ub.trn-doc.cli-type
     6204                       AND ub.clients.obj-code = ub.trn-doc.cli-code no-error.
     6205                  if available ub.clients then
     6206                  run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6207               end.
     6208             end.
     6209           end.
     6210         end.
     6211         when "file"
     6212         or
     6213         when "clob-data"
     6214         then do:
     6215           repeat:
     6216             import stream sout imp-type imp-code no-error.
     6217             find clients where
     6218                 clients.obj-type = imp-type and
     6219                 CLIENTS.OBJ-code = imp-code
     6220                 no-lock no-error.
     6221             if available CLIENTS then do:
     6222               run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6223             end.
     6224           end.
     6225           if rs-list-method = "clob-data" then do:
     6226             os-delete value(v-full-path) .
     6227           end.
     6228         end.
     6229         when "gds-list" then do:
     6230           repeat:
     6231             import stream sout imp-type imp-code imp-art no-error.
     6232             find ub.goods where ub.goods.prod-type = imp-type
     6233                       and ub.goods.prod-code = imp-code
     6234                       and ub.goods.artic     = imp-art no-lock no-error.
     6235             if available ub.goods then do:
     6236               find first ub.clients no-lock where
     6237                         ub.clients.obj-type = ub.goods.prod-type
     6238                     AND ub.clients.obj-code = ub.goods.prod-code no-error.
     6239               if available ub.clients then do:
     6240                 run ex-cli in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     6241               end.
     6242             end.
     6243           end.
     6244         end.
     6245       end CASE.
     6246     end.
     6247     input stream sout close.
     6248     assign                                                           buf_cli-list-hist.num-add  = lns-cnt - v-num-add                       buf_cli-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_cli-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_cli-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     6249   end.
     6250   end procedure.
     6251   PROCEDURE proc-b-save :
     6252   define input parameter loc-save-option as character no-undo.
     6253   define variable v-frame-width as integer no-undo.
     6254   define variable glog as logical no-undo .
     6255   define variable v-rid-list as character no-undo .
     6256   case loc-save-option:
     6257     when "cli-list":U then do:
     6258       assign
     6259       f-name = "default.cli"
     6260       glog = yes
     6261       .
     6262       system-dialog get-file f-name
     6263       filters "Списки клиентов *.cli" "*.cli"
     6264       ask-overwrite
     6265       save-as
     6266       use-filename
     6267       update glog
     6268       default-extension "cli".
     6269       if not glog then do:
     6270         apply "entry" to br-list in frame Dialog-Frame.
     6271         return no-apply.
     6272       end.
     6273       output to value (f-name).
     6274       for each cli-list:
     6275         export
     6276         cli-list.obj-type
     6277         cli-list.obj-code
     6278         .
     6279       end.
     6280       output close.
     6281     end.
     6282     when "cli-list-macros-db" then do:
     6283       run m-macros-save-db-proc in this-procedure .
     6284     END.
     6285     when "cli-list-db" then do:
     6286       run m_cli-save-db-proc in this-procedure .
     6287     end.
     6288     when "excel":U then do:
     6289       do on stop  undo, return no-apply
     6290           on error undo, return no-apply
     6291           on quit  undo, return no-apply
     6292       :
     6293         run str/clil-prn.p (
     6294                          input parparentproc
     6295                         ,input "excel":U
     6296                         ,output v-Frame-Width) no-error.
     6297         run waitfram-hide in this-procedure .
     6298       end.
     6299     end.
     6300   end case.
     6301   END PROCEDURE.
     6302   PROCEDURE proc-find-nameorcode :
     6303   case n-c:
     6304     when 'название':U then do:
     6305       if last-event:label = "Ctrl-J" then
     6306           find next l-cli-list no-lock where
     6307                      l-cli-list.obj-name begins nameorcode no-error.
     6308       else
     6309           find first l-cli-list no-lock where
     6310                      l-cli-list.obj-name begins nameorcode no-error.
     6311     end.
     6312     when 'код':U then do:
     6313       if last-event:label = "Ctrl-J" then
     6314           find next l-cli-list no-lock where
     6315                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6316       else
     6317           find first l-cli-list no-lock where
     6318                      l-cli-list.obj-code = integer(nameorcode) no-error.
     6319     end.
     6320   end case.
     6321   if available l-cli-list then do:
     6322     line-rec = recid (l-cli-list).
     6323     reposition br-list to recid line-rec no-error.
     6324     apply "value-changed" to br-list in frame Dialog-Frame.
     6325   end.
     6326   else do:
     6327     message
     6328     "Строка не найдена."
     6329     view-as alert-box error.
     6330   end.
     6331   END PROCEDURE.
     6332   procedure proc-macros :
     6333   define variable glog as logical no-undo .
     6334   define variable v-option as integer no-undo .
     6335   define buffer buf_cli-list-hist for cli-list-hist.
     6336   define buffer buf_macro-list-hist for macro-list-hist.
     6337   if can-find(first macro-list-hist) then do:
     6338     run gbl/d-askw.w ( input "Сохранение макроса"
     6339                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6340                   ,input "|"
     6341                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6342                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6343                   ,input 1
     6344                   ,input 3
     6345                   ,output v-option).
     6346     if v-option = 3 then return no-apply.
     6347     v-option = 1.
     6348   end.
     6349   else do:
     6350     message
     6351     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6352     view-as alert-box question buttons yes-no update glog.
     6353     v-option = 2.
     6354     if not glog then do:
     6355       return no-apply.
     6356     end.
     6357   end.
     6358     do
     6359     on error undo, return error
     6360     :
     6361     assign
     6362       f-name = "default.clm"
     6363       glog = yes
     6364       .
     6365     system-dialog get-file f-name
     6366       filters "Макрос создания списка клиентов *.clm" "*.clm"
     6367       ask-overwrite
     6368       save-as
     6369       use-filename
     6370       update glog
     6371       default-extension "clm".
     6372     if not glog then do:
     6373       apply "entry" to br-list in frame Dialog-Frame.
     6374       return no-apply.
     6375     end.
     6376     run waitfram-show in this-procedure ( input "Сохранение макроса формирования списка клиентов.    ЖДИТЕ...").
     6377     output stream PrnLibStream to value (f-name).
     6378     case v-option:
     6379       when 1 then do:
     6380         for each buf_macro-list-hist:
     6381           export stream PrnLibStream
     6382           buf_macro-list-hist.
     6383         end.
     6384       end.
     6385       when 2 then do:
     6386     for each buf_cli-list-hist:
     6387         export stream PrnLibStream
     6388         buf_cli-list-hist.
     6389     end.
     6390       end.
     6391     end case.
     6392     output stream PrnLibStream close.
     6393     run waitfram-hide in this-procedure .
     6394     end.
     6395   end procedure.
     6396   PROCEDURE proc-vc-rs-list-method :
     6397   define variable v-operation as integer no-undo .
     6398   define variable ii as integer no-undo.
     6399   define variable glog as logical no-undo .
     6400   define variable v-recs as integer no-undo .
     6401   define variable v-line as integer no-undo .
     6402   define variable v-item as character no-undo .
     6403   define variable v-tbl-name as character no-undo .
     6404   define variable v-bh as handle no-undo .
     6405   define variable v-tot-lns as integer no-undo .
     6406   define variable v-temp-seq as integer no-undo .
     6407   define variable v-message as character no-undo .
     6408   define variable grp-path as character no-undo .
     6409   define variable v-input-output as character no-undo .
     6410   define variable v-ref-rec as recid no-undo .
     6411   define variable v-grp-rec as recid no-undo .
     6412   define variable v-rid-list as character no-undo .
     6413   define variable v-uniq-key-rec as character no-undo .
     6414   define variable f-name as char init "default.cli" no-undo.
     6415   define buffer buf_clob-bind for ub.clob-bind.
     6416   define buffer buf_cli-list-hist for cli-list-hist.
     6417   v-no-hist = - 1.
     6418   if  rs-list-method = "single" then
     6419   run Myenable in this-procedure .
     6420   else do:
     6421      v-no-hist = 0.
     6422     case rs-list-method:
     6423       when "all" then do:
     6424         glog = yes.
     6425         message "Все клиенты из справочника клиентов"
     6426         skip stat-line(rs-status)
     6427         view-as alert-box question buttons OK-Cancel update glog.
     6428         if not glog then do:
     6429           run MyEnable in this-procedure .
     6430           return error.
     6431         end.
     6432         v-no-hist = 1.
     6433         run create-cli-list-hist in this-procedure (
     6434                                               input 'ДОБАВЛЕНИЕ':U
     6435                                             , input-output v-seq
     6436                                             , input 0
     6437                                             , input '':U
     6438                                             , input substitute('Все клиенты &1', stat-line(rs-status))
     6439                                             , input tot-lns
     6440                                             , input rs-list-method
     6441                                             , input rs-status
     6442                                             , input 'all':U
     6443                                             , input '':U
     6444                                             , input ?
     6445                                             ).
     6446       end.
     6447       when "cli"
     6448       or
     6449       WHEN "cli-grp" then do:
     6450         if rs-list-method = "cli-grp" then do:
     6451           glog = yes.
     6452           message "1 или несколько групп клиентов"
     6453           skip stat-line(rs-status)
     6454           view-as alert-box question buttons OK-Cancel update glog.
     6455           if not glog then do:
     6456             run MyEnable in this-procedure .
     6457             return error.
     6458           end.
     6459           GRP-list = "".
     6460           ref-list = "".
     6461           run ref/cli-grps.w ( input parparentproc
     6462                              , input "b-sel,b-mark"
     6463                              , input-output grp-list).
     6464         end.
     6465         else do:
     6466           glog = yes.
     6467           message "1 или несколько произвольных клиентов из справочника."
     6468           skip stat-line(rs-status)
     6469           view-as alert-box question buttons OK-Cancel update glog.
     6470           if not glog then do:
     6471             run MyEnable in this-procedure .
     6472             return error.
     6473           end.
     6474           run ref/cli-all.w ( input parparentproc
     6475                           , input "b-sel,b-mark,b-add"
     6476                           , input ?
     6477                           , input ?
     6478                           , input ?
     6479                           , input ?
     6480                           , input ?
     6481                           , input ?
     6482                           , output ref-list).
     6483           grp-list = ?.
     6484         end.
     6485         if grp-list <> ? and
     6486         grp-list <> "" then do:
     6487           v-recs = num-entries (grp-list).
     6488           do num-rec = 0 to v-recs:
     6489             if v-recs = 1 then do:
     6490               num-rec = 1 .
     6491             end.
     6492             if num-rec > 0 then do:
     6493               v-grp-rec = integer (entry (num-rec, grp-list)).
     6494               find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     6495               run cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output grp-path).
     6496             end.
     6497             if v-recs = 1 then do:
     6498               assign
     6499               v-temp-seq = v-seq
     6500               v-line     = 0
     6501               dsp-rs = substitute("Группа клиентов &1 &2", grp-path, stat-line(rs-status))
     6502               v-item     = '':U
     6503               v-tbl-name = 'cli-grp':U
     6504               v-bh       = buffer cli-grp:handle
     6505               v-tot-lns = tot-lns
     6506               .
     6507             end.
     6508             else do:
     6509               if num-rec = 0 then do:
     6510                 assign
     6511                 v-temp-seq = v-seq
     6512                 v-line     = 0
     6513                 dsp-rs = substitute("Группы клиентов: &1", stat-line(rs-status))
     6514                 v-item     = '':U
     6515                 v-tbl-name = '':U
     6516                 v-bh       = ?
     6517                 v-tot-lns = tot-lns
     6518                 .
     6519               end.
     6520               else do:
     6521                 assign
     6522                 v-temp-seq = v-seq - 1
     6523                 v-line     = num-rec
     6524                 dsp-rs = substitute("&1", grp-path)
     6525                 v-item     = '':U
     6526                 v-tbl-name = 'cli-grp':U
     6527                 v-bh       = buffer cli-grp:handle
     6528                 v-tot-lns = tot-lns + num-rec
     6529                 .
     6530               end.
     6531             end.
     6532             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     6533             run create-cli-list-hist in this-procedure (
     6534                                                   input 'ДОБАВЛЕНИЕ':U
     6535                                                 , input-output v-temp-seq
     6536                                                 , input v-line
     6537                                                 , input '':U
     6538                                                 , input dsp-rs
     6539                                                 , input v-tot-lns
     6540                                                 , input rs-list-method
     6541                                                 , input rs-status
     6542                                                 , input v-item
     6543                                                 , input v-tbl-name
     6544                                                 , input v-bh
     6545                                                 ).
     6546             if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     6547           end.
     6548         end.
     6549         else if ref-list <> "" and  ref-list <> ? then do:
     6550           v-recs = num-entries (ref-list) .
     6551           do num-rec = 0 to v-recs:
     6552             if v-recs = 1 then do:
     6553               num-rec = 1 .
     6554             end.
     6555             if num-rec > 0 then do:
     6556               v-ref-rec = integer (entry (num-rec, ref-list)).
     6557               find ub.clients where recid (ub.clients) = v-ref-rec no-lock.
     6558             end.
     6559             if v-recs = 1 then do:
     6560               assign
     6561               v-temp-seq = v-seq
     6562               v-line     = 0
     6563               dsp-rs = substitute("Клиент :&1 &2", ub.clients.obj-name, stat-line(rs-status))
     6564               v-item     = '':U
     6565               v-tbl-name = 'clients':U
     6566               v-bh       = buffer ub.clients:handle
     6567               v-tot-lns = tot-lns
     6568               .
     6569             end.
     6570             else do:
     6571               if num-rec = 0 then do:
     6572                 assign
     6573                 v-temp-seq = v-seq
     6574                 v-line     = 0
     6575                 dsp-rs = substitute("Клиент : &1", stat-line(rs-status))
     6576                 v-item     = '':U
     6577                 v-tbl-name = '':U
     6578                 v-bh       = ?
     6579                 v-tot-lns = tot-lns
     6580                 .
     6581               end.
     6582               else do:
     6583                 assign
     6584                 v-temp-seq = v-seq - 1
     6585                 v-line     = num-rec
     6586                 dsp-rs = substitute("&1", clients.obj-name)
     6587                 v-item     = '':U
     6588                 v-tbl-name = 'clients':U
     6589                 v-bh       = buffer clients:handle
     6590                 v-tot-lns = tot-lns + num-rec
     6591                 .
     6592               end.
     6593             end.
     6594             v-no-hist = (if num-rec = 1 then 0 else num-rec).
     6595             run create-cli-list-hist in this-procedure (
     6596                                                   input 'ДОБАВЛЕНИЕ':U
     6597                                                 , input-output v-temp-seq
     6598                                                 , input v-line
     6599                                                 , input '':U
     6600                                                 , input dsp-rs
