     6945                                     then 'фирма':U
     6946                                     else 'объект':U)
     6947                               )
     6948                        ,input ?
     6949                        ,input ?
     6950                        ,input ?
     6951                        ,input ?
     6952                        ,input "b-sel,b-mark"
     6953                        ,input ?
     6954                        ,input ?
     6955                        ,input ?
     6956                        ,output ref-list).
     6957         if ref-list = "" then do:
     6958           run MyEnable in this-procedure .
     6959           return error.
     6960         end.
     6961         v-recs = num-entries(ref-list).
     6962         do num-rec = 0 to v-recs:
     6963           if v-recs = 1 then do:
     6964             num-rec = 1 .
     6965           end.
     6966           if num-rec > 0 then do:
     6967             v-ref-rec = integer (entry (num-rec, ref-list)).
     6968             find ub.trn-doc where recid (ub.trn-doc) = v-ref-rec no-lock.
     6969           end.
     6970           if v-recs = 1 then do:
     6971             assign
     6972             v-temp-seq = v-seq
     6973             v-line     = 0
     6974             dsp-rs = substitute("Контрагенты по документу : &1 &2 &3 &4 № &5 от &6 &7"
     6975                                 , ub.trn-doc.doc-type
     6976                                 , ub.trn-doc.status_
     6977                                 , ub.trn-doc.obj-type
     6978                                 , ub.trn-doc.obj-code
     6979                                 , ub.trn-doc.doc-code
     6980                                 , string (ub.trn-doc.doc-date, '99/99/9999')
     6981                                 , stat-line(rs-status)
     6982                                 )
     6983             v-item     = '':U
     6984             v-tbl-name = 'trn-doc':U
     6985             v-bh       = buffer ub.trn-doc:handle
     6986             v-tot-lns = tot-lns
     6987             .
     6988           end.
     6989           else do:
     6990             if num-rec = 0 then do:
     6991               assign
     6992               v-temp-seq = v-seq
     6993               v-line     = 0
     6994               dsp-rs = substitute("Контрагенты по документам : &1", stat-line(rs-status))
     6995               v-item     = '':U
     6996               v-tbl-name = '':U
     6997               v-bh       = ?
     6998               v-tot-lns = tot-lns
     6999               .
     7000             end.
     7001             else do:
     7002               assign
     7003               v-temp-seq = v-seq - 1
     7004               v-line     = num-rec
     7005               dsp-rs = substitute("&1 &2 &3 &4 № &5 от &6"
     7006                                   , ub.trn-doc.doc-type
     7007                                   , ub.trn-doc.status_
     7008                                   , ub.trn-doc.obj-type
     7009                                   , ub.trn-doc.obj-code
     7010                                   , ub.trn-doc.doc-code
     7011                                   , string (ub.trn-doc.doc-date, '99/99/9999')
     7012                                   )
     7013               v-item     = '':U
     7014               v-tbl-name = 'trn-doc':U
     7015               v-bh       = buffer ub.trn-doc:handle
     7016               v-tot-lns = tot-lns + num-rec
     7017               .
     7018             end.
     7019           end.
