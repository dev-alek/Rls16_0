      663                    and buf_right_temp_actntw_items.itmType     = cb-type
      664           :
      665               assign
      666                   buf_right_temp_actntw_items.selRight = yes
      667               .
      668           end.
      669       end.
      670       else do:
      671           for each buf_right_temp_actntw_items
