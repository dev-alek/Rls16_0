     1366     .
     1367   end procedure.
     1368   procedure diasize_set-height :
     1369     define input  parameter p-new-height  as decimal   no-undo .
     1370     define input  parameter p-move-resize as logical   no-undo .
     1371     do
     1372     on error undo, return error return-value
     1373     :
     1374       run diasize_change-height in this-procedure
     1375         (input  (p-new-height - frame Dialog-Frame :height)
     1376         ,input  p-move-resize
     1377         ) .
     1378     end.
     1379   end procedure.
     1380   procedure diasize_change-width :
     1381     define input  parameter p-change-value as decimal   no-undo .
     1382     define input  parameter p-move-resize  as logical   no-undo .
     1383     define variable v-field-group-handle   as handle    no-undo .
     1384     define variable v-object-handle        as handle    no-undo .
     1385     define variable v-frame-width          as decimal   no-undo .
     1386     define variable v-frame-virtual-width  as decimal   no-undo .
     1387     define variable v-browse-width         as decimal   no-undo .
     1388     define variable v-window-width         as decimal   no-undo .
     1389     define variable v-window-virtual-width as decimal   no-undo .
     1390     define variable v-change-sign          as integer   no-undo .
     1391     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1392     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1393     if p-change-value > 0
     1394     then do:
     1395       if frame Dialog-Frame :width + p-change-value >
     1396           session :width-chars
     1397       then do:
     1398         assign
     1399           p-change-value = session :width-chars - frame Dialog-Frame :width
     1400         .
     1401         if p-change-value <= 0
     1402         then do:
     1403           run diasize_position-resize-button in this-procedure .
     1404           return .
     1405         end.
     1406       end.
     1407     end.
     1408     if p-change-value < 0
     1409     then do:
     1410       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1411       then do:
     1412         assign
     1413           p-change-value = v-diasize-orig-frame-width
     1414                          - frame Dialog-Frame :width
     1415         .
     1416         if p-change-value >= 0
     1417         then do:
     1418           run diasize_position-resize-button in this-procedure .
     1419           return .
     1420         end.
     1421       end.
     1422     end.
     1423     if p-change-value >= 0
     1424     then do:
     1425       assign
     1426         v-change-sign = 1
     1427       .
     1428     end.
     1429     else do:
     1430       assign
     1431         v-change-sign = -1
     1432       .
     1433     end.
     1434     assign
     1435       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1436     .
     1437     if p-change-value = 0
     1438     then do:
     1439       run diasize_position-resize-button in this-procedure .
     1440       return .
     1441     end.
     1442     move_block:
     1443     do
     1444     on error undo move_block, leave move_block
     1445     :
     1446       if retry
     1447       then do:
     1448         do
