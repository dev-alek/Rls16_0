     1184           and can-query(v-object-handle, "height")
     1185           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1186           then do:
     1187             find first buf_temp-browse-handle
     1188               where buf_temp-browse-handle.browse-type   = 'height':u
     1189                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1190               no-error .
     1191             if available buf_temp-browse-handle
     1192             then do:
     1193             end.
     1194             else do:
     1195               create buf_temp-diasize-handle .
     1196               assign
     1197                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1198                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1199               .
     1200             end.
     1201           end.
     1202           assign
     1203             v-object-handle = v-object-handle :next-sibling
     1204           .
     1205         end.
     1206         assign
     1207           v-field-group-handle = v-field-group-handle :next-sibling
     1208         .
     1209       end.
     1210       do with frame Dialog-Frame
     1211       :
     1212         hide v-diasize-resize-button .
