     1148       then do:
     1149         assign
     1150           v-diasize-change-size = true
     1151         .
     1152       end.
     1153       else do:
     1154         return .
     1155       end.
     1156       assign
     1157         v-frame-height = frame Dialog-Frame :height
     1158         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1159         v-browse-height = v-diasize-browse-handle :height
     1160       .
     1161       for each buf_temp-browse-handle
     1162         where buf_temp-browse-handle.browse-type = 'height':u
     1163       :
     1164         assign
