     1577               where buf_temp-browse-handle.browse-type   = 'width':u
     1578                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1579               no-error .
     1580             if available buf_temp-browse-handle
     1581             then do:
     1582             end.
     1583             else do:
     1584               create buf_temp-diasize-handle .
     1585               assign
     1586                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1587                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1588               .
     1589             end.
     1590           end.
     1591           assign
     1592             v-object-handle = v-object-handle :next-sibling
     1593           .
     1594         end.
     1595         assign
     1596           v-field-group-handle = v-field-group-handle :next-sibling
     1597         .
     1598       end.
     1599       do with frame Dialog-Frame
     1600       :
     1601         hide v-diasize-resize-button .
     1602         v-diasize-resize-button :row = 1.
     1603         v-diasize-resize-button :column = 1.
     1604       end.
     1605       if p-change-value > 0
     1606       then do:
