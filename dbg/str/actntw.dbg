     1243         or error-status :get-message(1) <> ""
     1244         then do:
     1245           undo move_block, retry move_block .
     1246         end.
     1247         for each buf_temp-browse-handle
     1248           where buf_temp-browse-handle.browse-type = 'height':u
     1249         on error undo move_block, retry move_block
     1250         :
     1251           assign
     1252             buf_temp-browse-handle.browse-handle :height
     1253               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1254             no-error .
