     1729       then do:
     1730         run diasize_position-resize-button in this-procedure .
     1731       end.
     1732       if v-diasize-wndstore = true
     1733       then do:
     1734         if connected("ub") = true
     1735         then do:
     1736           define variable v-cntxt-db-num        as integer   no-undo .
     1737           define variable v-cntxt-userid        as character no-undo .
     1738           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1739                                             , OUTPUT v-cntxt-userid
     1740                                             ) .
     1741           run gbl/wndsizew.p
     1742             (input  v-cntxt-db-num
     1743             ,input  v-cntxt-userid
     1744             ,input  v-diasize-proc-name
     1745             ,input  'width':u
     1746             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1747             ) .
     1748         end.
     1749       end.
     1750     end.
     1751     assign
     1752       v-diasize-change-size = false
     1753     .
     1754   end procedure.
     1755   procedure diasize_set-width :
     1756     define input  parameter p-new-width  as decimal   no-undo .
     1757     define input  parameter p-move-resize as logical   no-undo .
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761       run diasize_change-width in this-procedure
     1762         (input  (p-new-width - frame Dialog-Frame :width)
     1763         ,input  p-move-resize
     1764         ) .
     1765     end.
     1766   end procedure.
     1767   procedure diasize_position-resize-button :
     1768     do with frame Dialog-Frame
     1769     :
     1770       hide v-diasize-resize-button .
     1771       assign
     1772         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1773                     - 1
     1774                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1775         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1776                     - 1
     1777                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1778       .
     1779       view v-diasize-resize-button .
     1780     end.
     1781   end procedure.
     1782   on alt-right anywhere
     1783   do:
     1784     run diasize_change-width in this-procedure
     1785       (input 1
     1786       ,input true
     1787       ) .
     1788     return no-apply .
     1789   end.
     1790   on alt-left anywhere
     1791   do:
     1792     run diasize_change-width in this-procedure
     1793       (input -1
     1794       ,input true
     1795       ) .
     1796     return no-apply .
     1797   end.
     1798   on alt-down anywhere
     1799   do:
     1800     run diasize_change-height in this-procedure
     1801       (input 1
     1802       ,input true
     1803       ) .
     1804     return no-apply .
     1805   end.
     1806   on alt-up anywhere
     1807   do:
     1808     run diasize_change-height in this-procedure
     1809       (input -1
     1810       ,input true
     1811       ) .
     1812     return no-apply .
     1813   end.
     1814   on alt-enter of frame Dialog-Frame
     1815   do:
     1816     run diasize_maximize in this-procedure
     1817       (input  ?
     1818       ).
     1819     return no-apply .
     1820   end.
     1821   procedure diasize_end-move :
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       define variable v-row-delta as decimal   no-undo .
     1826       define variable v-col-delta as decimal   no-undo .
     1827       define variable v-new-row as decimal   no-undo .
     1828       define variable v-new-col as decimal   no-undo .
     1829       assign
     1830         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1831         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1832       .
     1833       assign
     1834         v-row-delta = v-new-row - frame Dialog-Frame :height
     1835         v-col-delta = v-new-col - frame Dialog-Frame :width
     1836       .
     1837       run diasize_change-height in this-procedure
     1838         (input v-row-delta
     1839         ,input true
     1840         ) .
     1841       run diasize_change-width in this-procedure
     1842         (input v-col-delta
     1843         ,input true
     1844         ) .
     1845     end.
     1846   end procedure.
     1847   procedure diasize_maximize :
     1848     define input  parameter p-action as logical   no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       if p-action = ?
     1853       then do:
     1854         if v-diasize-need-maximize = true
     1855         then do:
     1856           assign
     1857             p-action = true
     1858           .
     1859         end.
     1860         else do:
     1861           assign
     1862             p-action = false
     1863           .
     1864         end.
     1865       end.
     1866       if p-action = true
     1867       then do:
     1868         run diasize_change-height in this-procedure
     1869           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1870               - frame Dialog-Frame :height-chars
     1871           ,input true
     1872           ) .
     1873         run diasize_change-width in this-procedure
     1874           (input session :width-chars
     1875               - frame Dialog-Frame :width-chars
     1876           ,input true
     1877           ) .
     1878         assign
     1879           v-diasize-need-maximize = false
     1880         .
     1881       end.
     1882       else do:
     1883         run diasize_change-width in this-procedure
     1884           (input v-diasize-orig-frame-width
     1885               - frame Dialog-Frame :width-chars
     1886           ,input true
     1887           ) .
     1888         run diasize_change-height in this-procedure
     1889           (input v-diasize-orig-frame-height
     1890               - frame Dialog-Frame :height-chars
     1891           ,input true
     1892           ) .
     1893         assign
     1894           v-diasize-need-maximize = true
     1895         .
     1896       end.
     1897     end.
     1898   end procedure.
     1899   procedure diasize_restore-orig-size :
     1900     do
     1901     on error undo, return error return-value
     1902     :
     1903       assign
     1904         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1905         v-diasize-current-frame-height = frame Dialog-Frame :height
     1906       .
     1907       run diasize_set-height in this-procedure
     1908         (input  v-diasize-orig-frame-height
     1909         ,input  true
     1910         ) .
     1911       run diasize_set-width in this-procedure
     1912         (input  v-diasize-orig-frame-width
     1913         ,input  true
     1914         ) .
     1915     end.
     1916   end procedure.
     1917   procedure diasize_restore-current-size :
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       run diasize_set-height in this-procedure
     1922         (input  v-diasize-current-frame-height
     1923         ,input  true
     1924         ) .
     1925       run diasize_set-width in this-procedure
     1926         (input  v-diasize-current-frame-width
     1927         ,input  true
     1928         ) .
     1929     end.
     1930   end procedure.
     1931   procedure diasize_set-browse-handle :
     1932     define input  parameter p-browse-handle as handle   no-undo .
     1933     define buffer buf_temp-browse-handle for temp-browse-handle .
     1934     do
     1935     on error undo, return error return-value
     1936     :
     1937       assign
     1938         v-diasize-browse-handle = p-browse-handle
     1939       .
     1940       for each buf_temp-browse-handle
     1941       on error undo, return error return-value
     1942       :
     1943         delete buf_temp-browse-handle .
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure diasize_add_browse :
     1948     define input  parameter p-browse-type   as character no-undo .
     1949     define input  parameter p-browse-handle as handle    no-undo .
     1950     define buffer buf_temp-browse-handle for temp-browse-handle .
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       assign
     1955         v-diasize-browse-number = v-diasize-browse-number + 1
     1956       .
     1957       create buf_temp-browse-handle .
     1958       assign
     1959         buf_temp-browse-handle.browse-type   = p-browse-type
     1960         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1961         buf_temp-browse-handle.browse-handle = p-browse-handle
     1962       .
     1963     end.
     1964   end procedure.
     1965   procedure diasize_init :
     1966     define variable v-default-value    as logical   no-undo .
     1967     define variable v-restore-saved    as logical   no-undo .
     1968     define variable v-resize-value-str as character no-undo .
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       do with frame Dialog-Frame
     1973       :
     1974         assign
     1975           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1976           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1977           v-diasize-browse-handle     = browse br-table-left :handle
     1978         .
     1979         create button v-diasize-resize-button
     1980         assign
     1981           parent        = frame Dialog-Frame :first-child
     1982           label         = "s"
     1983           height-pixels = 16
     1984           width-pixels  = 16
     1985           visible       = true
     1986           sensitive     = true
     1987           movable       = true
     1988           triggers:
     1989             on end-move persistent run diasize_end-move in this-procedure .
     1990           end triggers.
     1991         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1992         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1993         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1994         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1995         assign
     1996           v-diasize-wndmax = false
     1997         .
     1998         if connected("ub") = true
     1999         then do:
     2000           define variable v-cntxt-db-num        as integer   no-undo .
     2001           define variable v-cntxt-userid        as character no-undo .
     2002           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2003                                             , OUTPUT v-cntxt-userid
     2004                                             ) .
     2005           run gbl/wndpar_r.p
     2006             (input  v-cntxt-db-num
     2007             ,input  v-cntxt-userid
     2008             ,input  'wndmax':U
     2009             ,output v-diasize-wndmax
     2010             ,output v-default-value
     2011             ) .
     2012         end.
     2013         assign
     2014           v-diasize-wndstore = false
     2015         .
     2016         if connected("ub") = true
     2017         then do:
     2018           run gbl/wndpar_r.p
     2019             (input  v-cntxt-db-num
     2020             ,input  v-cntxt-userid
     2021             ,input  'wndstore':U
     2022             ,output v-diasize-wndstore
     2023             ,output v-default-value
     2024             ) .
     2025         end.
     2026         assign
     2027           v-diasize-proc-name = entry(1, program-name(2), '.')
     2028         .
     2029         if v-diasize-wndstore = true
     2030         then do:
     2031           assign
     2032             v-restore-saved = false
     2033           .
     2034           if connected("ub") = true
     2035           then do:
     2036             run gbl/wndsizer.p
     2037               (input  v-cntxt-db-num
     2038               ,input  v-cntxt-userid
     2039               ,input  v-diasize-proc-name
     2040               ,input  'height':u
     2041               ,output v-resize-value-str
     2042               ) .
     2043             if v-resize-value-str <> '':U
     2044             then do:
     2045               run diasize_change-height in this-procedure
     2046                 (input  integer(v-resize-value-str)
     2047                 ,input  true
     2048                 ) .
     2049               assign
     2050                 v-restore-saved = true
     2051               .
     2052             end.
     2053           end.
     2054           if connected("ub") = true
     2055           then do:
     2056             run gbl/wndsizer.p
     2057               (input  v-cntxt-db-num
     2058               ,input  v-cntxt-userid
     2059               ,input  v-diasize-proc-name
     2060               ,input  'width':u
     2061               ,output v-resize-value-str
     2062               ) .
     2063             if v-resize-value-str <> '':U
     2064             then do:
     2065               run diasize_change-width in this-procedure
     2066                 (input  integer(v-resize-value-str)
     2067                 ,input  true
     2068                 ) .
     2069               assign
     2070                 v-restore-saved = true
     2071               .
     2072             end.
     2073           end.
     2074           if v-restore-saved <> true
     2075           then do:
     2076             if v-diasize-wndmax = true
     2077             then do:
     2078               run diasize_maximize in this-procedure
     2079                 (input  true
     2080                 ) .
     2081             end.
     2082           end.
     2083         end.
     2084         else do:
     2085           if v-diasize-wndmax = true
     2086           then do:
     2087             run diasize_maximize in this-procedure
     2088               (input  true
     2089               ) .
     2090           end.
     2091         end.
     2092       end.
     2093     end.
     2094   end procedure.
     2095   procedure diasize_need-full-display :
     2096     define output parameter p-need-full-display as logical   no-undo .
     2097     do
     2098     on error undo, return error return-value
     2099     :
     2100       assign
     2101         p-need-full-display = v-diasize-need-full-display
     2102       .
     2103       assign
     2104         v-diasize-need-full-display = false
     2105       .
     2106     end.
     2107   end procedure.
     2108   procedure get-context :
     2109      define output parameter p-db-num as integer          no-undo.
     2110      define output parameter p-user-id as character        no-undo.
     2111      define variable v-login               as character    no-undo.
     2112      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2113      define buffer buf_user-login  for ub.user-login .
     2114      do
     2115      on error undo, return error
     2116      :
     2117            FIND FIRST buf_sys-ctrl no-lock.
     2118            ASSIGN
     2119               v-login = USERID("ub")
     2120               p-db-num = buf_sys-ctrl.db-num
     2121            .
     2122            FIND FIRST buf_user-login
     2123                 WHERE buf_user-login.db-num = p-db-num
     2124                   AND buf_user-login.user-login = v-login
     2125                 no-lock
     2126                 no-error
     2127                 .
     2128            IF AVAILABLE buf_user-login
     2129            THEN DO:
     2130               assign
     2131                  p-user-id = buf_user-login.user-id
     2132               .
     2133            END.
     2134      end.
     2135   end procedure.
     2136       run diasize_init in this-procedure .
     2137   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2138   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2139   MAIN-BLOCK:
     2140   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2141      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2142       run init-fields in this-procedure.
     2143       RUN enable_UI.
     2144       run ui-disable-all in this-procedure.
     2145       run ui-enable in this-procedure.
     2146       apply "value-changed" to br-table-left.
     2147       apply "entry" to br-table-left.
     2148     WAIT-FOR GO OF FRAME Dialog-Frame.
     2149   END.
     2150   RUN disable_UI.
     2151   PROCEDURE assign-export-table :
     2152   define output parameter p-changed   as logical          no-undo.
     2153       define variable v-counter    as integer      no-undo.
     2154       define buffer buf_temp_actntw_itemsSelected    for temp_actntw_itemsSelected.
     2155       define buffer buf_temp_actntw_items            for temp_actntw_items.
     2156   do
     2157   for buf_temp_actntw_items
     2158     , buf_temp_actntw_itemsSelected
     2159   on error undo, return error
     2160   :
     2161       assign
     2162           p-changed = no
     2163       .
     2164       check-selected-table:
     2165       for each buf_temp_actntw_itemsSelected no-lock
     2166       on error undo, return error
     2167       :
     2168           find first buf_temp_actntw_items
     2169                where buf_temp_actntw_items.itm-key = buf_temp_actntw_itemsSelected.itm-key
     2170           .
     2171           if buf_temp_actntw_items.itmSelected = no
     2172           then do:
     2173               assign
     2174                   p-changed = yes
     2175               .
     2176               undo check-selected-table, leave check-selected-table.
     2177           end.
     2178       end.
     2179       if p-changed = no
     2180       then do:
     2181           check-items-table:
     2182           for each buf_temp_actntw_items
     2183              where buf_temp_actntw_items.itmSelected = yes
     2184           on error undo, return error
     2185           :
     2186               find first buf_temp_actntw_itemsSelected
     2187                    where buf_temp_actntw_itemsSelected.itm-key = buf_temp_actntw_items.itm-key
     2188               no-error.
     2189               if not available buf_temp_actntw_itemsSelected
     2190               then do:
     2191                   assign
     2192                       p-changed = yes
     2193                   .
     2194                   undo check-items-table, leave check-items-table.
     2195               end.
     2196           end.
     2197       end.
     2198       IF v-change-goods = TRUE
     2199       THEN DO:
     2200         assign
     2201            p-changed = yes
     2202         .
     2203       END.
     2204       IF p-changed = yes
     2205       then do:
     2206           empty temp-table
     2207               buf_temp_actntw_itemsSelected
     2208           .
     2209           for each buf_temp_actntw_items
     2210              where buf_temp_actntw_items.itmSelected = yes
     2211           on error undo, return error
     2212           :
     2213               assign
     2214                   v-counter = v-counter + 1
     2215               .
     2216               create buf_temp_actntw_itemsSelected.
     2217               assign
     2218                   buf_temp_actntw_itemsSelected.its-key    = v-counter
     2219                   buf_temp_actntw_itemsSelected.itm-key    = buf_temp_actntw_items.itm-key
     2220                   buf_temp_actntw_itemsSelected.itmExtKey  = buf_temp_actntw_items.itmExtKey
     2221                   buf_temp_actntw_itemsSelected.itmGdsList = buf_temp_actntw_items.itmGdsList
     2222                   buf_temp_actntw_itemsSelected.itmGds     = buf_temp_actntw_items.itmGds
     2223                   buf_temp_actntw_itemsSelected.itmGrpList = buf_temp_actntw_items.itmGrpList
     2224                   buf_temp_actntw_itemsSelected.itmGrp     = buf_temp_actntw_items.itmGrp
     2225               .
     2226           end.
     2227       end.
     2228   end.
     2229   END PROCEDURE.
     2230   PROCEDURE change-properties :
     2231   define input parameter p-id     as integer          no-undo.
     2232   do
     2233   on error undo, return error
     2234   :
     2235   end.
     2236   END PROCEDURE.
     2237   PROCEDURE check-data :
     2238   do
     2239   on error undo, return error
     2240   :
     2241   end.
     2242   END PROCEDURE.
     2243   PROCEDURE disable_UI :
     2244     HIDE FRAME Dialog-Frame.
     2245   END PROCEDURE.
     2246   PROCEDURE enable_UI :
     2247     DISPLAY cb-type fi-filter tb-filter ed-desc-not-sel ed-desc-sel
     2248         WITH FRAME Dialog-Frame.
     2249     ENABLE b-exit b-cancel cb-type bt-properties b-help bt-filter tb-filter
     2250            b-goods b-gds-grp br-table-right br-table-left bt-select-type
     2251            bt-deselect-type ed-desc-not-sel ed-desc-sel
     2252         WITH FRAME Dialog-Frame.
     2253     VIEW FRAME Dialog-Frame.
     2254     run local-open-query-left in this-procedure .    run local-open-query-right in this-procedure .
     2255   END PROCEDURE.
     2256   PROCEDURE init-fields :
     2257       define variable v-counter    as integer      no-undo.
     2258       define buffer buf_temp_actntw_items     for temp_actntw_items.
     2259       define buffer buf_temp_actntw_itemsSelected     for temp_actntw_itemsSelected.
     2260   do
     2261   for buf_temp_actntw_items
     2262     , buf_temp_actntw_itemsSelected
     2263   on error undo, return error
     2264   :
     2265       if p-title <> "":U
     2266       then do:
     2267           assign
     2268               frame Dialog-Frame :title = p-title
     2269           .
     2270       end.
     2271       assign
     2272           cb-type :list-items = "< Все >"
     2273       .
     2274       for each buf_temp_actntw_items
     2275       break by buf_temp_actntw_items.itmType
     2276       :
     2277           if first-of( buf_temp_actntw_items.itmType )
     2278           then do:
     2279               assign
     2280                   cb-type :list-items = substitute( "&1&2&3"
     2281                                       , cb-type :list-items
     2282                                       , ( if cb-type :list-items = "":U
     2283                                           then "":U
     2284                                           else ",":U )
     2285                                       , buf_temp_actntw_items.itmType
     2286                                       )
     2287               .
     2288           end.
     2289       end.
     2290       assign
     2291           cb-type = "< Все >"
     2292       .
     2293       for each buf_temp_actntw_items
     2294          where buf_temp_actntw_items.itmSelected = yes
     2295       :
     2296           assign
     2297               v-counter = v-counter + 1
     2298           .
     2299           create buf_temp_actntw_itemsSelected.
     2300           assign
     2301               buf_temp_actntw_itemsSelected.its-key    = v-counter
     2302               buf_temp_actntw_itemsSelected.itm-key    = buf_temp_actntw_items.itm-key
     2303               buf_temp_actntw_itemsSelected.itmExtKey  = buf_temp_actntw_items.itmExtKey
     2304               buf_temp_actntw_itemsSelected.itmGdsList = buf_temp_actntw_items.itmGdsList
     2305               buf_temp_actntw_itemsSelected.itmGds     = buf_temp_actntw_items.itmGds
     2306               buf_temp_actntw_itemsSelected.itmGrpList = buf_temp_actntw_items.itmGrpList
     2307               buf_temp_actntw_itemsSelected.itmGrp     = buf_temp_actntw_items.itmGrp
     2308           .
     2309       end.
     2310   end.
     2311   END PROCEDURE.
     2312   PROCEDURE local-open-query-left :
     2313       if cb-type = "< Все >"
     2314       then do:
     2315           open query br-table-left
     2316               for each buf_left_temp_actntw_items no-lock
     2317               where buf_left_temp_actntw_items.itmSelected = yes
     2318           by buf_left_temp_actntw_items.itmType
     2319           by buf_left_temp_actntw_items.itmName
     2320           .
     2321       end.
     2322       else do:
     2323           open query br-table-left
     2324               for each buf_left_temp_actntw_items no-lock
     2325                  where buf_left_temp_actntw_items.itmSelected = yes
     2326                    and buf_left_temp_actntw_items.itmType     = cb-type
     2327           by buf_left_temp_actntw_items.itmType
     2328           by buf_left_temp_actntw_items.itmName
     2329           .
     2330       end.
     2331    END PROCEDURE.
     2332   PROCEDURE local-open-query-right :
     2333   do
     2334   with frame Dialog-Frame
     2335   on error undo, return error
     2336   :
     2337       if fi-filter = "":U
     2338       or tb-filter = no
     2339       then do:
     2340           if cb-type = "< Все >"
     2341           then do:
     2342               open query br-table-right
     2343                   for each buf_right_temp_actntw_items no-lock
     2344                   by buf_right_temp_actntw_items.itmType
     2345                   by buf_right_temp_actntw_items.itmName
     2346               .
     2347           end.
     2348           else do:
     2349               open query br-table-right
     2350                   for each buf_right_temp_actntw_items no-lock
     2351                      where buf_right_temp_actntw_items.itmType = cb-type
     2352                   by buf_right_temp_actntw_items.itmName
     2353               .
     2354           end.
     2355           assign
     2356               fi-filter :bgcolor = GREY_COLOR
     2357               bt-filter :bgcolor = GREY_COLOR
     2358           .
     2359       end.
     2360       else do:
     2361           if cb-type = "< Все >"
     2362           then do:
     2363               open query br-table-right
     2364                   for each buf_right_temp_actntw_items no-lock
     2365                   where index( buf_right_temp_actntw_items.itmName, fi-filter ) <> 0
     2366                   by buf_right_temp_actntw_items.itmType
     2367                   by buf_right_temp_actntw_items.itmName
     2368               .
     2369           end.
     2370           else do:
     2371               open query br-table-right
     2372                   for each buf_right_temp_actntw_items no-lock
     2373                      where buf_right_temp_actntw_items.itmType = cb-type
     2374                        and index( buf_right_temp_actntw_items.itmName, fi-filter ) <> 0
     2375                   by buf_right_temp_actntw_items.itmName
     2376               .
     2377           end.
     2378           assign
     2379               fi-filter :bgcolor = RED_COLOR
     2380               bt-filter :bgcolor = RED_COLOR
     2381           .
     2382       end.
     2383   end.
     2384   END PROCEDURE.
     2385   PROCEDURE select-and-move-down :
     2386   define input parameter p-browse-handle  as handle           no-undo.
     2387   define input parameter p-query-handle   as handle           no-undo.
     2388       define variable v-focused-row       as integer  no-undo.
     2389       define variable v-repositioned-row  as integer  no-undo.
     2390   do
     2391   with frame Dialog-Frame
     2392   on error undo, return error
     2393   :
     2394           assign
     2395               v-focused-row      = p-browse-handle :focused-row
     2396               v-repositioned-row = p-query-handle  :current-result-row
     2397           .
     2398           p-query-handle :get-next ().
     2399           if p-query-handle :query-off-end = no
     2400           then do:
     2401               if v-focused-row > p-browse-handle :height - 2
     2402               then do:
     2403                   assign
     2404                       v-repositioned-row  = v-repositioned-row + 1
     2405                   .
     2406               end.
     2407               else do:
     2408                   assign
     2409                       v-focused-row       = v-focused-row + 1
     2410                       v-repositioned-row  = v-repositioned-row + 1
     2411                   .
     2412               end.
     2413               p-browse-handle :set-repositioned-row( v-focused-row, "ALWAYS").
     2414               p-query-handle  :reposition-to-row( v-repositioned-row ).
     2415           end.
     2416   end.
     2417   END PROCEDURE.
     2418   PROCEDURE ui-disable-all :
     2419   do
     2420   with frame Dialog-Frame
     2421   on error undo, return error
     2422   :
     2423       disable
     2424           all
     2425           except
     2426               b-exit
     2427               b-help
     2428               br-table-left
     2429               br-table-right
     2430       .
     2431   end.
     2432   END PROCEDURE.
     2433   PROCEDURE ui-enable :
     2434   do
     2435   with frame Dialog-Frame
     2436   on error undo, return error
     2437   :
     2438       enable
     2439           bt-filter
     2440           fi-filter
     2441           cb-type
     2442       .
     2443       if p-mode = 1
     2444       then do:
     2445           enable
     2446               b-cancel
     2447               b-help
     2448               bt-sel-sel
     2449               bt-sel-sel-all
     2450               bt-sel-desel-all
     2451               bt-sel-reverse
     2452               bt-not-sel-sel
     2453               bt-not-sel-desel-all
     2454               bt-not-sel-all
     2455               bt-not-sel-reverse
     2456               ed-desc-not-sel
     2457               ed-desc-sel
     2458               bt-select-type
     2459               bt-deselect-type
     2460           .
     2461       end.
     2462       if p-mode = 0
     2463       then do:
     2464           hide
     2465               b-cancel
     2466           .
     2467           assign
     2468               b-exit :label = "В&ыход"
     2469           .
     2470       end.
     2471       if p-runfilename <> "":U
     2472       then do:
     2473           assign
     2474               bt-properties :visible      = yes
     2475               bt-properties :sensitive    = yes
     2476           .
     2477           if p-runfilelabel <> "":U
     2478           then do:
     2479               assign
     2480                   bt-properties :label = p-runfilelabel
     2481               .
     2482           end.
     2483       end.
     2484       else do:
     2485           assign
     2486               bt-properties :visible      = no
     2487           .
     2488       end.
     2489   end.
     2490   END PROCEDURE.
