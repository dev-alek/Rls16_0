        1   define variable vss-include-info0 as character format "X(65)" no-undo
        2   initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp_actntw_items no-undo
        4       field itm-key       as integer
        5       field itmExtKey     as character
        6       field itmType       as character
        7       field itmName       as character
        8       field itmDesc       as character
        9       field itmGdsList    as character
       10       field itmGds        as logical
       11       field itmGrpList    as character
       12       field itmGrp        as logical
       13       field itmSelected   as logical
       14       field selLeft       as logical
       15       field selRight      as logical
       16       index pi is primary unique
       17           itm-key
       18       index ie
       19           itmExtKey
       20       index tp
       21           itmType
       22           itmName
       23       index sel
       24           itmSelected
       25   .
       26   define temp-table temp_actntw_itemsSelected no-undo
       27       field its-key       as integer
       28       field itm-key       as integer
       29       field itmExtKey     as character
       30       field itmGdsList    as character
       31       field itmGds        as logical
       32       field itmGrpList    as character
       33       field itmGrp        as logical
       34       index pi is primary unique
       35           its-key
       36       index im
       37           itm-key
       38   .
       39   define variable v-actntw0-itm-key    as integer      no-undo.
       40   procedure actntw_clear :
       41       define buffer buf_temp_actntw_items        for temp_actntw_items.
       42   do
       43   for buf_temp_actntw_items
       44   on error undo, return error
       45   :
       46       empty temp-table buf_temp_actntw_items.
       47   end.
       48   end procedure.
       49   procedure actntw_add-item :
       50   define input parameter p-ext-key   as character        no-undo.
       51   define input parameter p-item-type as character        no-undo.
       52   define input parameter p-item-name as character        no-undo.
       53   define input parameter p-item-desc as character        no-undo.
       54   define input parameter p-selected  as logical          no-undo.
       55   define input parameter p-gds       as logical          no-undo.
       56   define input parameter p-grp       as logical          no-undo.
       57   define input parameter p-list      as character        no-undo.
       58       define buffer buf_temp_actntw_items        for temp_actntw_items.
       59   do
       60   for buf_temp_actntw_items
       61   on error undo, return error
       62   :
       63       assign
       64           v-actntw0-itm-key = v-actntw0-itm-key + 1
       65       .
       66       create temp_actntw_items.
       67       assign
       68           temp_actntw_items.itm-key      = v-actntw0-itm-key
       69           temp_actntw_items.itmExtKey    = p-ext-key
       70           temp_actntw_items.itmType      = p-item-type
       71           temp_actntw_items.itmName      = p-item-name
       72           temp_actntw_items.itmDesc      = p-item-desc
       73           temp_actntw_items.itmSelected  = p-selected
       74           temp_actntw_items.selLeft      = no
       75           temp_actntw_items.selRight     = no
       76           temp_actntw_items.itmGds       = p-gds
       77           temp_actntw_items.itmGrp       = p-grp
       78           temp_actntw_items.itmGdsList   = IF p-gds THEN p-list ELSE "":U
       79           temp_actntw_items.itmGrpList   = IF p-grp THEN p-list ELSE "":U
       80       .
       81   end.
       82   end procedure.
       83   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
       84   define input parameter p-mode               as integer          no-undo.
       85   define input parameter p-title              as character        no-undo.
       86   define input parameter p-runfilename        as character        no-undo.
       87   define input parameter p-runfilelabel       as character        no-undo.
       88   define input parameter table for temp_actntw_items .
       89   define input parameter p-head-code          as integer          no-undo.
       90   define input parameter p-role-code          as integer          no-undo.
       91   define output parameter table for temp_actntw_itemsSelected .
       92   define output parameter p-changed           as logical          no-undo.
       93   define output parameter p-accepted          as logical          no-undo.
       94   define variable vss-revision    as character no-undo init "$Revision$":U .
       95   define variable vss-author      as character no-undo init "$Author$":U .
       96   define variable vss-date        as character no-undo init "$Date$":U .
       97   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       98   define variable vss-archive     as character no-undo init "$Archive$":U .
       99   define variable vss-description as character no-undo init "Двухоконный интерфейс для выбора из небольшого количества записей".
      100   procedure vss-get-info :
      101     define output parameter p-vss-revision    like vss-revision    no-undo .
      102     define output parameter p-vss-author      like vss-author      no-undo .
      103     define output parameter p-vss-date        like vss-date        no-undo .
      104     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      105     define output parameter p-vss-archive     like vss-archive     no-undo .
      106     define output parameter p-vss-description like vss-description no-undo .
      107     assign
      108       p-vss-revision    = vss-revision
      109       p-vss-author      = vss-author
      110       p-vss-date        = vss-date
      111       p-vss-workfile    = vss-workfile
      112       p-vss-archive     = vss-archive
      113       p-vss-description = vss-description
      114     .
      115   end procedure.
      116   procedure vss-get-parameters :
      117     define output parameter p-vss-parameters as character no-undo .
      118   end procedure.
      119   define new global shared variable g#vssrevis-logger as handle    no-undo .
      120   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      121   define variable v-vssrevis-logger                   as handle    no-undo .
      122   procedure vss-logevent :
      123     define input  parameter p-extra-paramters as character no-undo .
      124     define variable v-vssrevis-parameters as character no-undo .
      125     do
      126     on error undo, return error return-value
      127     :
      128       if  valid-handle(v-vssrevis-logger)
      129       and v-vssrevis-logger :get-signature("logevent") <> ""
      130       then do:
      131         run vss-get-parameters in this-procedure
      132           (output v-vssrevis-parameters
      133           ).
      134         run logevent in v-vssrevis-logger
      135           (input vss-workfile
      136           ,input vss-revision
      137           ,input v-vssrevis-parameters
      138           ,input p-extra-paramters
      139           ).
      140       end.
      141     end.
      142   end procedure.
      143   assign
      144     v-vssrevis-logger = g#vssrevis-logger
      145   .
      146   if  valid-handle(v-vssrevis-logger)
      147   and v-vssrevis-logger :get-signature("logevent") <> ""
      148   then do:
      149     assign
      150       v-vssrevis-logevent = true
      151     .
      152     run vss-logevent in this-procedure (input vss-description) .
      153   end.
      154   define new global shared variable g#language as character no-undo .
      155   if g#language <> '' and g#language <> 'rus':U then do:
      156     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      157   end.
      158   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      160   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      161   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      162   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      163   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      164   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      165   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      166   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      167   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      168   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      169   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      170   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      171   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      172   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      173   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      174   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      175   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      176   procedure proc-alt-shift-f2:
      177     if not ibs.th.gbl.gbl-var:rcode
      178   then
      179     run gbl\inidebug.p .
      180   end.
      181   procedure proc-alt-shift-f3:
      182     run gbl/prvssinf.p
      183       ( input this-procedure
      184       ) .
      185   end.
      186   define variable v-inform-launched as logical no-undo initial false .
      187   procedure proc-alt-shift-f4:
      188     define variable v-action as character no-undo .
      189     if v-inform-launched = false then do:
      190       assign
      191         v-inform-launched = true
      192       .
      193       run gbl/d-inform.w
      194         (  input self
      195         ,  input this-procedure
      196         , output v-action
      197         ) no-error .
      198       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      199       assign
      200         v-inform-launched = false
      201       .
      202     end.
      203   end.
      204   procedure proc-alt-f1:
      205     run gbl/corrhelp.p
      206       (input this-procedure
      207       ) .
      208   end .
      209   on alt-shift-f2 anywhere do:
      210     run proc-alt-shift-f2.
      211   end.
      212   on alt-shift-f3 anywhere do:
      213     run proc-alt-shift-f3 in this-procedure .
      214   end.
      215   on alt-shift-f4 anywhere do:
      216     run proc-alt-shift-f4 in this-procedure.
      217   end.
      218   on alt-f1 anywhere do:
      219     run proc-alt-f1 in this-procedure .
      220   end.
      221       define variable v-actntw-close-enabled    as logical      no-undo.
      222       define variable v-gds-list                as character    no-undo.
      223       define variable v-change-goods            as logical      no-undo.
      224       define buffer buf_right_temp_actntw_items             for temp_actntw_items.
      225       define buffer buf_left_temp_actntw_items              for temp_actntw_items.
      226       define buffer buf_temp_actntw_itemsSelected           for temp_actntw_itemsSelected.
      227   DEFINE BUTTON b-cancel AUTO-END-KEY DEFAULT
      228        LABEL "&Отмена"
      229        SIZE 10 BY 1
      230        BGCOLOR 8 .
      231   DEFINE BUTTON b-exit AUTO-GO
      232        LABEL "&Ввод"
      233        SIZE 10 BY 1
      234        BGCOLOR 8 .
      235   DEFINE BUTTON b-gds-grp
      236        LABEL "Группы"
      237        SIZE 10 BY 1 TOOLTIP "Группы товаров, с которыми разрешает работать данное право".
      238   DEFINE BUTTON b-goods
      239        LABEL "Товары"
      240        SIZE 10 BY 1 TOOLTIP "Товары, с которыми разрешает работать данное право".
      241   DEFINE BUTTON b-help
      242        LABEL "Помощ&ь"
      243        SIZE 10 BY 1
      244        BGCOLOR 8 .
      245   DEFINE BUTTON bt-deselect-type
      246        LABEL "<--"
      247        SIZE 4.25 BY 1.
      248   DEFINE BUTTON bt-filter DEFAULT
      249        LABEL "&ФПоиск"
      250        SIZE 10 BY 1 TOOLTIP "Поиск с фильтром строки во всех текстовых полях"
      251        BGCOLOR 8 .
      252   DEFINE BUTTON bt-not-sel-all
      253        LABEL "+"
      254        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      255   DEFINE BUTTON bt-not-sel-desel-all
      256        LABEL "-"
      257        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      258   DEFINE BUTTON bt-not-sel-reverse
      259        LABEL "/"
      260        SIZE 3 BY 1 TOOLTIP "Инвертировать выбор".
      261   DEFINE BUTTON bt-not-sel-sel
      262        LABEL "*"
      263        SIZE 3 BY 1 TOOLTIP "Выбрать".
      264   DEFINE BUTTON bt-properties DEFAULT
      265        LABEL "&Свойства"
      266        SIZE 15 BY 1
      267        BGCOLOR 8 .
      268   DEFINE BUTTON bt-sel-desel-all
      269        LABEL "-"
      270        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      271   DEFINE BUTTON bt-sel-reverse
      272        LABEL "/"
      273        SIZE 3 BY 1 TOOLTIP "Инвертировать выбор".
      274   DEFINE BUTTON bt-sel-sel
      275        LABEL "*"
      276        SIZE 3 BY 1 TOOLTIP "Выбрать".
      277   DEFINE BUTTON bt-sel-sel-all
      278        LABEL "+"
      279        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      280   DEFINE BUTTON bt-select-type
      281        LABEL "-->"
      282        SIZE 4.25 BY 1.
      283   DEFINE VARIABLE cb-type AS CHARACTER FORMAT "X(256)":U
      284        LABEL "Тема"
      285        VIEW-AS COMBO-BOX INNER-LINES 15
      286        LIST-ITEMS "Item 1"
      287        DROP-DOWN-LIST
      288        SIZE 30 BY 1 NO-UNDO.
      289   DEFINE VARIABLE ed-desc-not-sel AS CHARACTER
      290        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      291        SIZE 45.63 BY 1.63
      292        FGCOLOR 4  NO-UNDO.
      293   DEFINE VARIABLE ed-desc-sel AS CHARACTER
      294        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      295        SIZE 45.63 BY 1.63
      296        FGCOLOR 4  NO-UNDO.
      297   DEFINE VARIABLE fi-filter AS CHARACTER FORMAT "X(256)":U
      298        VIEW-AS FILL-IN
      299        SIZE 19.25 BY 1 NO-UNDO.
      300   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
      301        LABEL ""
      302        VIEW-AS TOGGLE-BOX
      303        SIZE 2.63 BY .79 TOOLTIP "Снятие поиска с фильтром" NO-UNDO.
      304   DEFINE QUERY br-table-left FOR
      305         buf_left_temp_actntw_items SCROLLING.
      306   DEFINE QUERY br-table-right FOR
      307         buf_right_temp_actntw_items SCROLLING.
      308   DEFINE BROWSE br-table-left
      309     QUERY br-table-left NO-LOCK DISPLAY
      310         buf_left_temp_actntw_items.selLeft  column-label " *" format " */  "
      311             buf_left_temp_actntw_items.itmType column-label " Тема" format "X(15)"
      312             buf_left_temp_actntw_items.itmName column-label " Имя права" format "X(40)"
      313       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.63 BY 18.5 ROW-HEIGHT-CHARS .67.
      314   DEFINE BROWSE br-table-right
      315     QUERY br-table-right NO-LOCK DISPLAY
      316         buf_right_temp_actntw_items.selRight column-label " *" format " */  "
      317             buf_right_temp_actntw_items.itmType column-label " Тема" format "X(15)"
      318             buf_right_temp_actntw_items.itmName column-label " Имя права" format "X(40)"
      319       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.63 BY 18.5 ROW-HEIGHT-CHARS .67.
      320   DEFINE FRAME Dialog-Frame
      321        b-exit AT ROW 1 COL 2 NO-TAB-STOP
      322        b-cancel AT ROW 1 COL 12 NO-TAB-STOP
      323        cb-type AT ROW 1 COL 37 COLON-ALIGNED WIDGET-ID 2
      324        bt-properties AT ROW 1 COL 66.63 NO-TAB-STOP
      325        b-help AT ROW 1 COL 89 NO-TAB-STOP
      326        bt-not-sel-sel AT ROW 2.25 COL 2 NO-TAB-STOP
      327        bt-not-sel-all AT ROW 2.25 COL 5 NO-TAB-STOP
      328        bt-not-sel-desel-all AT ROW 2.25 COL 8 NO-TAB-STOP
      329        bt-not-sel-reverse AT ROW 2.25 COL 11 NO-TAB-STOP
      330        bt-filter AT ROW 2.25 COL 14.63 NO-TAB-STOP
      331        fi-filter AT ROW 2.25 COL 22.75 COLON-ALIGNED NO-LABEL
      332        tb-filter AT ROW 2.25 COL 44.63
      333        bt-sel-sel AT ROW 2.25 COL 53 NO-TAB-STOP
      334        bt-sel-sel-all AT ROW 2.25 COL 56 NO-TAB-STOP
      335        bt-sel-desel-all AT ROW 2.25 COL 59 NO-TAB-STOP
      336        bt-sel-reverse AT ROW 2.25 COL 62 NO-TAB-STOP
      337        b-goods AT ROW 2.25 COL 78.5 WIDGET-ID 4
      338        b-gds-grp AT ROW 2.25 COL 88.5 WIDGET-ID 6
      339        br-table-right AT ROW 3.25 COL 2
      340        br-table-left AT ROW 3.25 COL 53
      341        bt-select-type AT ROW 10.5 COL 48 NO-TAB-STOP
      342        bt-deselect-type AT ROW 11.5 COL 48 NO-TAB-STOP
      343        ed-desc-not-sel AT ROW 22 COL 2 NO-LABEL NO-TAB-STOP
      344        ed-desc-sel AT ROW 22 COL 53 NO-LABEL NO-TAB-STOP
      345        SPACE(0.99) SKIP(0.11)
      346       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      347            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      348            TITLE "Выбор из списка"
      349            CANCEL-BUTTON b-cancel.
      350   ASSIGN
      351          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      352          FRAME Dialog-Frame:HIDDEN           = TRUE.
      353   ASSIGN
      354          bt-filter:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      355   ASSIGN
      356          bt-properties:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      357   ASSIGN
      358          ed-desc-not-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      359   ASSIGN
      360          ed-desc-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      361   ASSIGN
      362          fi-filter:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      363   ON GO OF FRAME Dialog-Frame
      364   DO:
      365       if v-actntw-close-enabled = no
      366       then do:
      367           undo, return no-apply.
      368       end.
      369       else do:
      370           run check-data in this-procedure.
      371           run assign-export-table in this-procedure (
      372                 output p-changed
      373           ).
      374           assign
      375               p-accepted = yes
      376           .
      377       end.
      378   END.
      379   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      380   DO:
      381       APPLY "END-ERROR":U TO SELF.
      382   END.
      383   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      384   DO:
      385       assign
      386           v-actntw-close-enabled  = yes
      387           p-accepted              = no
      388       .
      389   END.
      390   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      391   or F2 of frame Dialog-Frame anywhere
      392   DO:
      393   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   if lookup(self :type
      395            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      396            ) = 0
      397   then do:
      398     message
      399       "$Workfile$"
      400       "Указанному интерфейсному элементу фокус не может быть передан" skip
      401       "Интерфейсный элемент" self :name  skip
      402       "Тип" self :type  skip
      403       "Процедура" this-procedure :file-name skip
      404       view-as alert-box .
      405   end.
      406   else do:
      407     apply "entry":u to self  .
      408     if focus :handle <> self :handle  then do:
      409       return no-apply .
      410     end.
      411   end.
      412       assign
      413           v-actntw-close-enabled = yes
      414       .
      415   END.
      416   ON CHOOSE OF b-gds-grp IN FRAME Dialog-Frame
      417   DO:
      418     define variable v-ok    as logical      no-undo.
      419     IF AVAILABLE buf_left_temp_actntw_items
      420     AND buf_left_temp_actntw_items.itmGrp
      421     THEN DO:
      422         assign
      423            v-gds-list = buf_left_temp_actntw_items.itmGrpList
      424         .
      425         run adm/actngrpg.w (
      426           INPUT p-mainmenu-handle
      427               , INPUT p-head-code
      428               , INPUT p-role-code
      429               , INPUT INTEGER(buf_left_temp_actntw_items.itmExtKey)
      430               , INPUT-OUTPUT v-gds-list
      431               , OUTPUT v-ok
      432         ) .
      433         IF  v-ok
      434         AND buf_left_temp_actntw_items.itmGrpList <> v-gds-list
      435         THEN DO:
      436            assign
      437               v-change-goods                         = TRUE
      438               buf_left_temp_actntw_items.itmGrpList  = v-gds-list
      439            .
      440         end.
      441     END.
      442   END.
      443   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      444   DO:
      445     define variable v-ok    as logical      no-undo.
      446     IF AVAILABLE buf_left_temp_actntw_items
      447     AND buf_left_temp_actntw_items.itmGds
      448     THEN DO:
      449         assign
      450            v-gds-list = buf_left_temp_actntw_items.itmGdsList
      451         .
      452         run adm/actngdgr.w (
      453             INPUT p-mainmenu-handle
      454           , INPUT p-head-code
      455           , INPUT p-role-code
      456           , INPUT INTEGER(buf_left_temp_actntw_items.itmExtKey)
      457           , INPUT-OUTPUT v-gds-list
      458           , OUTPUT v-ok
      459         ) .
      460         IF  v-ok
      461         AND buf_left_temp_actntw_items.itmGdsList <> v-gds-list
      462         THEN DO:
      463            assign
      464               v-change-goods                         = TRUE
      465               buf_left_temp_actntw_items.itmGdsList  = v-gds-list
      466            .
      467         end.
      468     END.
      469   END.
      470   ON MOUSE-SELECT-CLICK OF br-table-left IN FRAME Dialog-Frame
      471   or insert-mode of br-table-left in frame dialog-frame
      472   or " " of br-table-left in frame dialog-frame
      473   DO:
      474       if p-mode = 1
      475       then do:
      476           if available buf_left_temp_actntw_items
      477           and buf_left_temp_actntw_items.itmSelected = yes
      478           then do:
      479               assign
      480                   buf_left_temp_actntw_items.selLeft = not( buf_left_temp_actntw_items.selLeft )
      481               .
      482               display
      483                   selLeft
      484               with browse br-table-left .
      485               apply "entry" to br-table-left.
      486           end.
      487       end.
      488   END.
      489   ON VALUE-CHANGED OF br-table-left IN FRAME Dialog-Frame
      490   or entry of br-table-left IN FRAME Dialog-Frame
      491   or entry of br-table-right IN FRAME Dialog-Frame
      492   or value-changed of br-table-right IN FRAME Dialog-Frame
      493   DO:
      494       if available buf_left_temp_actntw_items
      495       then do:
      496           assign
      497               ed-desc-sel = buf_left_temp_actntw_items.itmDesc
      498               br-table-left :tooltip = buf_left_temp_actntw_items.itmName
      499           .
      500           IF buf_left_temp_actntw_items.itmGds THEN DO:
      501              ENABLE
      502                  b-goods
      503              with frame Dialog-Frame .
      504           END.
      505           ELSE DO:
      506               DISABLE
      507                   b-goods
      508               with frame Dialog-Frame .
      509           END.
      510           IF buf_left_temp_actntw_items.itmGrp THEN DO:
      511              ENABLE
      512                  b-gds-grp
      513              with frame Dialog-Frame .
      514           END.
      515           ELSE DO:
      516               DISABLE
      517                   b-gds-grp
      518               with frame Dialog-Frame .
      519           END.
      520       end.
      521       else do:
      522           assign
      523               ed-desc-sel = "":U
      524           .
      525       end.
      526       if available buf_right_temp_actntw_items
      527       then do:
      528           assign
      529               ed-desc-not-sel = buf_right_temp_actntw_items.itmDesc
      530               br-table-right :tooltip = buf_right_temp_actntw_items.itmName
      531           .
      532       end.
      533       else do:
      534           assign
      535               ed-desc-not-sel = "":U
      536           .
      537       end.
      538       display
      539           ed-desc-sel
      540           ed-desc-not-sel
      541       with frame Dialog-Frame.
      542   END.
      543   ON MOUSE-SELECT-CLICK OF br-table-right IN FRAME Dialog-Frame
      544   or insert-mode of br-table-right in frame dialog-frame
      545   or " " of br-table-right in frame dialog-frame
      546   DO:
