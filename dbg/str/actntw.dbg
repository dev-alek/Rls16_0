      859   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      860   on help of frame Dialog-Frame
      861   do:
      862     run gbl/app_help.p
      863       (input this-procedure :file-name
      864       ,input ''
      865       ,input ?
      866       ) no-error.
      867     if error-status :error then do:
      868       message
      869         "Ошибка при вызове помощи"
      870         error-status :get-message(1)
      871         view-as alert-box .
      872     end.
      873   end.
      874   run minbtn-set in this-procedure .
      875   on choose of b-help in frame Dialog-Frame
      876   do:
      877     apply "help":u to frame Dialog-Frame .
      878   end.
      879   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   procedure minbtn-set :
      881       do
      882           on error undo, return error return-value
      883           :
      884           define variable ii              as integer       no-undo .
      885           define variable fh              as widget-handle no-undo .
      886           define variable hh              as widget-handle no-undo .
      887           define variable v-h             as handle        extent 4 no-undo .
      888           define variable v-name-button   as character     no-undo .
      889           define variable v-help-old-x    as decimal       no-undo .
      890           define variable v-help-old-y    as decimal       no-undo .
      891           define variable v-help-old-size as decimal       no-undo .
      892           define variable v-frame-width   as decimal       no-undo .
      893           define variable jj              as integer       no-undo .
      894           do
      895               on error undo, return error
      896               :
      897               assign
      898                   v-frame-width = frame Dialog-Frame:width - 0.3
      899                   fh            = frame Dialog-Frame:first-child
      900                   hh            = fh:first-child
      901                   ii            = 1
      902                   .
      903               do while valid-handle(hh):
      904                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      905                   do:
      906                       case lc(hh:name) :
      907                           when "b-help" then
      908                               do:
      909                                   hh:load-image-up("cmp/b-help.bmp":u) .
      910                                   hh:load-image-down("cmp/b-help.bmp":u) .
      911                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      912                                   hh:TOOLTIP = "Помощь" .
      913                                   v-help-old-x = hh:column .
      914                                   v-help-old-y = hh:row    .
      915                                   v-help-old-size = hh:width .
      916                                   hh:width-chars = 2.5 .
      917                               end.
      918                           when "b-print" then
      919                               do:
      920                                   hh:load-image("cmp/b-print.bmp":u) .
      921                                   hh:TOOLTIP = "Печать" .
      922                                   v-h[ii] = hh:handle .
      923                                   ii = ii + 1 .
      924                                   hh:width-chars = 3 .
      925                               end.
      926                           when "b-history" or
      927                           when "b-hist" then
      928                               do:
      929                                   hh:load-image("cmp/b-hist.bmp":u) .
      930                                   hh:TOOLTIP = "История" .
      931                                   v-h[ii] = hh:handle .
      932                                   ii = ii + 1 .
      933                                   hh:width-chars = 3 .
      934                               end.
      935                           when "b-sch" then
      936                               do:
      937                                   hh:load-image("cmp/b-sch.bmp":u) .
      938                                   hh:TOOLTIP = "Установка Фильтра" .
      939                                   v-h[ii] = hh:handle .
      940                                   ii = ii + 1 .
      941                                   hh:width-chars = 3 .
      942                               end.
      943                           when "b-hist-user" then
      944                               do:
      945                                   hh:load-image("cmp/b-hist.bmp":u) .
      946                                   hh:TOOLTIP = "История пользователя" .
      947                                   ii = ii + 1 .
      948                               end.
      949                       end case.
      950                   end.
      951                   hh = hh:next-sibling.
      952               end.
      953               b-help:column = v-frame-width - b-help:width-chars.
      954               jj = 0.
      955               repeat ii = 4 to 1 by -1 :
      956                   if valid-handle (v-h[ii] ) then
      957                   do:
      958                       jj  = jj + 1 .
      959                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      960                       v-h[ii]:row    = v-help-old-y .
      961                   end.
      962               end.
      963           end.
      964       end.
      965   end procedure.
      966   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      967   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      968   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      969   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      970   define variable v-diasize-current-frame-width  as decimal   no-undo .
      971   define variable v-diasize-current-frame-height as decimal   no-undo .
      972   define variable v-diasize-change-size          as logical   no-undo .
      973   define variable v-diasize-resize-button        as handle    no-undo .
      974   define variable v-diasize-wndmax               as logical   no-undo .
      975   define variable v-diasize-wndstore             as logical   no-undo .
      976   define variable v-diasize-proc-name            as character no-undo .
      977   define variable v-diasize-browse-handle        as handle    no-undo .
      978   define variable v-diasize-browse-number        as integer   no-undo .
      979   define variable v-diasize-need-full-display    as logical   no-undo init false .
      980   define temp-table temp-diasize-handle no-undo
      981     field handle-value  as handle
      982     field save-position as decimal
      983     index xpk is primary unique handle-value
      984     .
      985   define temp-table temp-browse-handle no-undo
      986     field browse-type   as character
      987     field browse-number as integer
      988     field browse-handle as handle
      989     field original-size as decimal
      990     index xpk is primary unique browse-type browse-number
      991     index xie browse-type browse-handle
      992   .
      993   procedure diasize_change-height :
      994     define input  parameter p-change-value  as decimal   no-undo .
      995     define input  parameter p-move-resize   as logical   no-undo .
      996     define variable v-field-group-handle    as handle    no-undo .
      997     define variable v-object-handle         as handle    no-undo .
      998     define variable v-frame-height          as decimal   no-undo .
      999     define variable v-frame-virtual-height  as decimal   no-undo .
     1000     define variable v-browse-height         as decimal   no-undo .
     1001     define variable v-window-height         as decimal   no-undo .
     1002     define variable v-window-virtual-height as decimal   no-undo .
     1003     define variable v-change-sign           as integer   no-undo .
     1004     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1005     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1006     if p-change-value > 0
     1007     then do:
     1008       if frame Dialog-Frame :height + p-change-value
     1009           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1010       then do:
     1011         assign
     1012           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1013                           - (frame Dialog-Frame :height-chars)
     1014         .
     1015         if p-change-value <= 0
     1016         then do:
     1017           run diasize_position-resize-button in this-procedure .
     1018           return .
     1019         end.
     1020       end.
     1021     end.
     1022     if p-change-value < 0
     1023     then do:
     1024       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1025       then do:
     1026         assign
     1027           p-change-value = v-diasize-orig-frame-height
     1028                          - (frame Dialog-Frame :height-chars)
     1029         .
     1030         if p-change-value >= 0
     1031         then do:
     1032           run diasize_position-resize-button in this-procedure .
     1033           return .
     1034         end.
     1035       end.
     1036     end.
     1037     if p-change-value >= 0
     1038     then do:
     1039       assign
     1040         v-change-sign = 1
     1041       .
     1042     end.
     1043     else do:
     1044       assign
     1045         v-change-sign = -1
     1046       .
     1047     end.
     1048     assign
     1049       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1050     .
     1051     if p-change-value = 0
     1052     then do:
     1053       run diasize_position-resize-button in this-procedure .
     1054       return .
     1055     end.
     1056     move_block:
     1057     do
     1058     on error undo move_block, retry move_block
     1059     :
     1060       if retry
     1061       then do:
     1062         do
     1063         on error undo move_block, leave move_block
     1064         :
     1065           if p-change-value > 0
     1066           then do:
     1067             for each buf_temp-diasize-handle
     1068             on error undo, next
     1069             :
     1070               assign
     1071                 v-object-handle = buf_temp-diasize-handle.handle-value
     1072               .
     1073               if v-object-handle <> v-diasize-resize-button
     1074               then do:
     1075                 assign
     1076                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1077                 .
     1078               end.
     1079             end.
     1080             assign
     1081               v-diasize-browse-handle :height = v-browse-height
     1082             .
     1083             for each buf_temp-browse-handle
     1084               where buf_temp-browse-handle.browse-type = 'height':u
     1085             on error undo, next
     1086             :
     1087               assign
     1088                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1089               .
     1090             end.
     1091             assign
     1092               frame Dialog-Frame :height = v-frame-height
     1093             .
     1094             if frame Dialog-Frame :scrollable = true
     1095             then do:
     1096               assign
     1097                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1098               .
     1099             end.
     1100             run diasize_position-resize-button in this-procedure .
     1101           end.
     1102           else do:
     1103             if frame Dialog-Frame :scrollable = true
     1104             then do:
     1105               assign
     1106                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1107               .
     1108             end.
     1109             assign
     1110               frame Dialog-Frame :height = v-frame-height
     1111             .
     1112             assign
     1113               v-diasize-browse-handle :height = v-browse-height
     1114             .
     1115             for each buf_temp-browse-handle
     1116               where buf_temp-browse-handle.browse-type = 'height':u
     1117             on error undo, next
     1118             :
     1119               assign
     1120                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1121               .
     1122             end.
     1123             for each buf_temp-diasize-handle
     1124             on error undo, next
     1125             :
     1126               assign
     1127                 v-object-handle = buf_temp-diasize-handle.handle-value
     1128               .
     1129               if v-object-handle <> v-diasize-resize-button
     1130               then do:
     1131                 assign
