      608               fi-filter = v-new-filter
      609           .
      610           if fi-filter = "":U
      611           then do:
      612               assign
      613                   tb-filter               = no
      614                   tb-filter :sensitive    = no
      615               .
      616           end.
      617           else do:
      618               assign
      619                   tb-filter               = yes
      620                   tb-filter :sensitive    = yes
      621               .
      622           end.
