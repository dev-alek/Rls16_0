      645           end.
      646           else do:
      647               for each buf_right_temp_actntw_items
      648                  where buf_right_temp_actntw_items.itmSelected = no
      649                   and index( buf_right_temp_actntw_items.itmName, fi-filter ) <> 0
      650               :
