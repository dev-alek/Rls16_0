     1214           v-diasize-resize-button :row    = 1
     1215           v-diasize-resize-button :column = 1
     1216         .
     1217       end.
     1218       if p-change-value > 0
     1219       then do:
     1220         if frame Dialog-Frame :scrollable = true
     1221         then do:
     1222           assign
     1223             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1224             no-error .
     1225           if error-status :error
     1226           or error-status :get-message(1) <> ""
     1227           then do:
     1228             undo move_block, retry move_block .
     1229           end.
     1230         end.
     1231         assign
     1232           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1233           no-error .
     1234         if error-status :error
     1235         or error-status :get-message(1) <> ""
     1236         then do:
     1237           undo move_block, retry move_block .
     1238         end.
     1239         assign
     1240           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1241           no-error .
