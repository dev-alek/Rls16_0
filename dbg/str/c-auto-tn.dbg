        1   DEFINE BUFFER X_c-auto-tank FOR c-auto-tank.
        2   DEFINE BUFFER X_auto-tank FOR auto-tank.
        3   DEFINE INPUT PARAMETER parParentProc AS HANDLE NO-UNDO .
        4   define input parameter bttns         as character no-undo .
        5   define input parameter p-mode        as character no-undo .
        6   define input parameter p-auto-num    as character no-undo .
        7   define input-output param p-rid-list    as  char no-undo .
        8   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
        9   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       10   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       11   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       12   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       13   define variable vss-description AS CHAR NO-UNDO INIT "Список истории автоцистерн":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   FUNCTION mark-string RETURNS CHARACTER
       76     ( input p-recid as recid, input mark-list as character  ) :
       77     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
       78   END FUNCTION.
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   function usrfulnf returns character ( input p-user-id as character):
       81   define variable v-user-name as character no-undo .
       82   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
       84     (input  p-user-id
       85     ,output v-user-name
       86     ) no-error .
       87   if error-status:error
       88   or v-user-name = ""
       89   then do:
       90     return p-user-id.
       91   end.
       92   else do:
       93     return v-user-name.
       94   end.
       95   end function.
       96   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
       97   define variable sort-column-name as character no-undo .
       98   define variable v-db-num LIKE ub.db.db-num no-undo.
       99   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  temp-table temp-changes no-undo
      101   field f_name as character
      102   field l_name as character
      103   field v_old as character
      104   field v_new as character
      105   field t_name as character
      106   field num_ as integer
      107   field uniq-key-rec as character
      108   field action as integer
      109   field fNotChange as logical
      110   index pi is unique primary
      111   num_
      112   t_name
      113   f_name
      114   index
      115   Chan
      116   fnotChange
      117   t_name
      118   f_name
      119   index imain uniq-key-rec
      120   .
      121   FUNCTION get-all-fields returns character (p-file-name as character ):
      122   define variable v-dop as character no-undo .
      123     find first _file no-lock where _file._file-name = p-file-name no-error .
      124     if not available _file then return "":U.
      125     for each _field no-lock where
      126              _field._file-recid = recid(_file) :
      127       assign
      128       v-dop = v-dop + _field._field-name + chr(44)
      129       .
      130     end.
      131     return trim(v-dop).
      132   END FUNCTION.
      133   PROCEDURE proc-full-temp-changes :
      134     define input  parameter p-hst-handle as handle    no-undo .
      135     define input  parameter p-main-table as character no-undo .
      136     define input  parameter p-field-list as character no-undo .
      137     define input  parameter p-label-form as character no-undo .
      138     define variable h-new-buf         as handle    no-undo .
      139     define variable h-main-buf        as handle    no-undo .
      140     define variable h-for-comp        as handle    no-undo .
      141     define variable v-inform          as character no-undo .
      142     define variable v-ind             as integer   no-undo .
      143     define variable v-idx-field-qnty  as integer   no-undo .
      144     define variable v-num-entries     as integer   no-undo .
      145     define variable fh                as handle    no-undo .
      146     define variable fh-main           as handle    no-undo .
      147     define variable fh-old            as handle    no-undo .
      148     define variable fh-new            as handle    no-undo .
      149     define variable v-field-name      as character no-undo .
      150     define variable v-field-lvl       as character no-undo .
      151     define variable v-field-form      as character no-undo .
      152     define variable v-search-exp      as character no-undo .
      153     define variable v-srch-main       as character no-undo .
      154     define variable v-word-link       as character no-undo .
      155     define variable v-av-chip-num     as logical   no-undo .
      156     define variable v-main-pi-fld-lst as character no-undo .
      157     define variable v-main-fld-lst    as character no-undo .
      158     define variable v-delim-list      as character no-undo .
      159     define variable v-label           as character no-undo .
      160     define variable v-old-value       as character no-undo case-sensitive.
      161     define variable v-new-value       as character no-undo case-sensitive.
      162     define variable v-chg-fields as character no-undo.
      163     for each temp-changes:
      164       delete temp-changes.
      165     end.
      166     if not p-hst-handle:available then do:
      167       return .
      168     end.
      169     create buffer h-new-buf  for table p-hst-handle .
      170     create buffer h-main-buf for table p-main-table .
      171     assign
      172       v-inform = h-main-buf:index-information(1)
      173       v-ind    = 2
      174     .
      175     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      176     on error undo, return error
      177     :
      178       assign
      179         v-inform = h-main-buf:index-information( v-ind )
      180         v-ind    = v-ind + 1
      181       .
      182     end.
      183     if v-inform = ?
      184       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      185       or entry( 3, v-inform, ",":U ) <> "1":U
      186     then do:
      187       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      188     end.
      189     assign
      190       v-idx-field-qnty = num-entries( v-inform ) - 4
      191     .
      192     if v-idx-field-qnty < 2 then do:
      193       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      194     end.
      195     assign
      196       v-srch-main   = "where":U
      197       v-word-link   = "":U
      198       v-av-chip-num = false
      199       v-delim-list  = "":U
      200     .
      201     do v-ind = 1 to v-idx-field-qnty by 2
      202     on error undo, return error
      203     :
      204       assign
      205         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      206         fh                = p-hst-handle:buffer-field( v-field-name )
      207         fh-main           = h-main-buf:buffer-field( v-field-name )
      208         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      209         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      210       .
      211       if fh:data-type ="character":U then do:
      212         assign
      213           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      214         .
      215       end.
      216       else do:
      217         assign
      218           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      219         .
      220       end.
      221       if v-delim-list = "":U then do:
      222         assign
      223           v-delim-list = ",":U
      224         .
      225       end.
      226       if v-word-link = "":U then do:
      227         assign
      228           v-word-link = "and":U
      229         .
      230       end.
      231     end.
      232     assign
      233       v-delim-list  = "":U
      234     .
      235     do v-ind = 1 to h-main-buf:num-fields
      236     on error undo, return error
      237     :
      238       assign
      239         fh-main      = h-main-buf:buffer-field( v-ind )
      240         v-field-name = fh-main:name
      241       .
      242         assign
      243           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      244         .
      245         if v-delim-list = "":U then do:
      246           assign
      247             v-delim-list = ",":U
      248           .
      249         end.
      250     end.
      251     assign
      252       v-inform = p-hst-handle:index-information(1)
      253       v-ind    = 2
      254     .
      255     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      256     on error undo, return error
      257     :
      258       assign
      259         v-inform = p-hst-handle:index-information( v-ind )
      260         v-ind    = v-ind + 1
      261       .
      262     end.
      263     if v-inform = ?
      264       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      265       or entry( 3, v-inform, ",":U ) <> "1":U
      266     then do:
      267       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      268     end.
      269     assign
      270       v-idx-field-qnty = num-entries( v-inform ) - 4
      271     .
      272     if v-idx-field-qnty < 2 then do:
      273       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      274     end.
      275     assign
      276       v-search-exp  = "where":U
      277       v-word-link   = "":U
      278       v-av-chip-num = false
      279     .
      280     do v-ind = 1 to v-idx-field-qnty by 2
      281     on error undo, return error
      282     :
      283       assign
      284         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      285         fh           = p-hst-handle:buffer-field( v-field-name )
      286         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      287       .
      288       if v-field-name = "chip-num":U then do:
      289         assign
      290           v-search-exp  = substitute( "&1 >", v-search-exp )
      291           v-av-chip-num = true
      292         .
      293       end.
      294       else do:
      295         assign
      296           v-search-exp = substitute( "&1 =", v-search-exp )
      297         .
      298       end.
      299       if fh:data-type ="character":U then do:
      300         assign
      301           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      302         .
      303       end.
      304       else do:
      305         assign
      306           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      307         .
      308       end.
      309       if v-word-link = "":U then do:
      310         assign
      311           v-word-link = "and":U
      312         .
      313       end.
      314     end.
      315     if v-av-chip-num = false then do:
      316       message
      317         vss-workfile vss-revision vss-description skip
      318         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      319         "Использование данной процедуры невозможно!" skip
      320         view-as alert-box error .
      321       return error .
      322     end.
      323     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      324     if not h-new-buf:available then do:
      325       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      326       if not h-main-buf:available then do:
      327         assign
      328           h-for-comp = ?
      329         .
      330       end.
      331       else do:
      332         assign
      333           h-for-comp = h-main-buf
      334         .
      335       end.
      336     end.
      337     else do:
      338       assign
      339         h-for-comp = h-new-buf
      340       .
      341     end.
      342     assign
      343       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      344     .
      345     do v-ind = 1 to v-num-entries
      346     on error undo, return error return-value
      347     :
      348       assign
      349         v-field-name = entry( v-ind, v-main-fld-lst )
      350         fh-old       = p-hst-handle:buffer-field( v-field-name )
      351         v-old-value  = fh-old:buffer-value()
      352         v-label      = trim( fh-old:label )
      353       .
      354       if ( trim( p-field-list ) <> "":U
      355            and lookup( v-field-name, p-field-list ) > 0
      356          )
      357          or trim( p-field-list ) = "":U
      358       then do:
      359         if h-for-comp <> ? then do:
      360           assign
      361             fh-new      = h-for-comp:buffer-field( v-field-name )
      362             v-new-value = fh-new:buffer-value()
      363           .
      364         end.
      365         else do:
      366           assign
      367             v-new-value = "":U
      368           .
      369         end.
      370         if v-old-value <> v-new-value
      371         then do:
      372           create temp-changes.
      373           assign
      374             temp-changes.t_name = p-main-table
      375             temp-changes.f_name = v-field-name
      376             temp-changes.l_name = replace( v-label, "&":U, "":U )
      377             temp-changes.v_old  = trim( v-old-value )
      378             temp-changes.v_new  = trim( v-new-value )
      379             temp-changes.num_   = 0
      380             temp-changes.fNotChange = v-old-value eq v-new-value
      381           .
      382         end.
      383       end.
      384     end.
      385     assign
      386       v-num-entries = num-entries( p-label-form, chr(8) )
      387     .
      388     do v-ind = 1 to v-num-entries
      389     on error undo, return error return-value
      390     :
      391       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      392         assign
      393           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      394           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      395           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      396         .
      397         find first temp-changes
      398           where temp-changes.f_name = v-field-name
      399           no-error .
      400         if available temp-changes then do:
      401           if trim( v-field-lvl ) <> "":U then do:
      402             assign
      403               temp-changes.l_name = v-field-lvl
      404             .
      405           end.
      406           if trim( v-field-form ) <> "":U then do:
      407             assign
      408               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      409             .
      410             if h-for-comp <> ? then do:
      411               assign
      412                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      413               .
      414             end.
      415           end.
      416         end.
      417       end.
      418       else do:
      419         message
      420           vss-workfile vss-revision vss-description skip
      421           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      422           substitute( "список для поля '&1': '&2'"
      423                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      424                       ,entry( v-ind, p-label-form, chr(8) )
      425                     ) skip
      426           substitute( "полный список: &2", p-label-form ) skip
      427           view-as alert-box error .
      428       end.
      429     end.
      430     delete object h-new-buf .
      431     delete object h-main-buf .
      432   END PROCEDURE.
      433   DEFINE BUTTON B-Help
      434        LABEL "Помо&щь"
      435        SIZE 3 BY 1
      436        BGCOLOR 8 .
      437   DEFINE BUTTON B-mark
      438        LABEL "&*"
      439        SIZE 3 BY 1.
      440   DEFINE BUTTON b-quit AUTO-END-KEY
      441        LABEL "&Выход"
      442        SIZE 10 BY 1
      443        BGCOLOR 8 .
      444   DEFINE BUTTON B-sel AUTO-GO
      445        LABEL "Вы&бор"
      446        SIZE 10 BY 1.
      447   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      448         VIEW-AS TEXT
      449        SIZE 6 BY 1
      450        FGCOLOR 4  NO-UNDO.
      451   DEFINE QUERY BR-changes FOR
      452         temp-changes SCROLLING.
      453   DEFINE QUERY br-wp FOR
      454         X_c-auto-tank SCROLLING.
      455   DEFINE BROWSE BR-changes
      456     QUERY BR-changes DISPLAY
      457   temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
      458   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
      459   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
      460       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.05.
      461   DEFINE BROWSE br-wp
      462     QUERY br-wp NO-LOCK DISPLAY
      463         mark-string(recid(X_c-auto-tank), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      464         usrfulnf(X_c-auto-tank.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
      465         X_c-auto-tank.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
      466         string(X_c-auto-tank.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
      467         entry(1, X_c-auto-tank.auto-num, "#") column-label "Номер!машины" format "x(11)"
      468         (  if index(X_c-auto-tank.auto-num, "#") > 0 then entry(2, X_c-auto-tank.auto-num, "#") else ""  ) column-label "Секция" format "x(6)"
      469         X_c-auto-tank.brutto-qnty
      470         X_c-auto-tank.name
      471         X_c-auto-tank.status_
      472         X_c-auto-tank.PS
      473         X_c-auto-tank.tank-type
      474         X_c-auto-tank.plomb-type
      475         X_c-auto-tank.cli-type
      476         X_c-auto-tank.cli-code
      477       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.24 FIT-LAST-COLUMN.
      478   DEFINE FRAME Dialog-Frame
      479        b-quit AT ROW 1 COL 1
      480        B-mark AT ROW 1 COL 11
      481        B-sel AT ROW 1 COL 21
      482        B-Help AT ROW 1 COL 95
      483        br-wp AT ROW 3 COL 1
      484        BR-changes AT ROW 13 COL 1
      485        mark-num AT ROW 1 COL 12.6 COLON-ALIGNED NO-LABEL
      486        SPACE(78.52) SKIP(20.05)
      487       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      488            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      489            TITLE "История изменения автотранспорта"
      490            CANCEL-BUTTON b-quit.
      491   ASSIGN
      492          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      493          FRAME Dialog-Frame:HIDDEN           = TRUE.
      494   ASSIGN
      495          br-wp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
      496          br-wp:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE
      497          br-wp:COLUMN-MOVABLE IN FRAME Dialog-Frame         = TRUE.
      498   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      499   DO:
      500     APPLY "END-ERROR":U TO SELF.
      501   END.
      502   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      503   DO:
      504     define variable loc#log as logical no-undo .
      505     if available X_c-auto-tank then do:
      506   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   define variable v-str-recid5 as character no-undo .
      508   define variable v-num-entry5 as integer   no-undo .
      509   assign
      510     v-str-recid5 = trim( string( recid( X_c-auto-tank ) , "->>>>>>>>>>>9":U ) )
      511     v-num-entry5 = lookup( v-str-recid5 , p-rid-list )
      512   .
      513   if v-num-entry5 > 0 then do:
      514     assign
      515       entry( v-num-entry5, p-rid-list ) = "":U
      516       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      517     .
      518   end.
      519   else do:
      520     assign
      521       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      522     .
      523   end.
      524       loc#log = br-wp:refresh() .
      525       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      526           loc#log = br-wp:select-next-row ().
      527           apply "VALUE-CHANGED" to br-wp in frame Dialog-Frame.
      528       end.
      529       if num-entries( p-rid-list ) = 0
      530       then
      531           hide mark-num in frame Dialog-Frame.
      532       else
      533           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      534     end.
      535     apply "entry" to br-wp in frame Dialog-Frame.
      536   END.
      537   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      538   DO:
      539       if ( available X_c-auto-tank ) then do:
      540       if  ( p-rid-list = "" ) or b-mark:sensitive = no
      541       then
      542       p-rid-list = string( recid( X_c-auto-tank ) ) .
      543     end.
      544   END.
      545   ON RETURN OF br-wp IN FRAME Dialog-Frame
      546   or MOUSE-SELECT-DBLCLICK OF br-wp IN FRAME Dialog-Frame
      547       DO:
      548       run proc-br-wp no-error.
      549     if error-status:error then return no-apply.
      550   END.
      551   ON VALUE-CHANGED OF br-wp IN FRAME Dialog-Frame
      552   DO:
      553     run proc-view-changes in this-procedure no-error.
      554   END.
      555   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      556   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      557   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   on help of frame Dialog-Frame
      559   do:
      560     run gbl/app_help.p
      561       (input this-procedure :file-name
      562       ,input ''
      563       ,input ?
      564       ) no-error.
      565     if error-status :error then do:
      566       message
      567         "Ошибка при вызове помощи"
      568         error-status :get-message(1)
      569         view-as alert-box .
      570     end.
      571   end.
      572   run minbtn-set in this-procedure .
      573   on choose of b-help in frame Dialog-Frame
      574   do:
      575     apply "help":u to frame Dialog-Frame .
      576   end.
      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure minbtn-set :
      579       do
      580           on error undo, return error return-value
      581           :
      582           define variable ii              as integer       no-undo .
      583           define variable fh              as widget-handle no-undo .
      584           define variable hh              as widget-handle no-undo .
      585           define variable v-h             as handle        extent 4 no-undo .
      586           define variable v-name-button   as character     no-undo .
      587           define variable v-help-old-x    as decimal       no-undo .
      588           define variable v-help-old-y    as decimal       no-undo .
      589           define variable v-help-old-size as decimal       no-undo .
      590           define variable v-frame-width   as decimal       no-undo .
      591           define variable jj              as integer       no-undo .
      592           do
      593               on error undo, return error
      594               :
      595               assign
      596                   v-frame-width = frame Dialog-Frame:width - 0.3
      597                   fh            = frame Dialog-Frame:first-child
      598                   hh            = fh:first-child
      599                   ii            = 1
      600                   .
      601               do while valid-handle(hh):
      602                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      603                   do:
      604                       case lc(hh:name) :
      605                           when "b-help" then
      606                               do:
      607                                   hh:load-image-up("cmp/b-help.bmp":u) .
      608                                   hh:load-image-down("cmp/b-help.bmp":u) .
      609                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      610                                   hh:TOOLTIP = "Помощь" .
      611                                   v-help-old-x = hh:column .
      612                                   v-help-old-y = hh:row    .
      613                                   v-help-old-size = hh:width .
      614                                   hh:width-chars = 2.5 .
      615                               end.
      616                           when "b-print" then
      617                               do:
      618                                   hh:load-image("cmp/b-print.bmp":u) .
      619                                   hh:TOOLTIP = "Печать" .
      620                                   v-h[ii] = hh:handle .
      621                                   ii = ii + 1 .
      622                                   hh:width-chars = 3 .
      623                               end.
      624                           when "b-history" or
      625                           when "b-hist" then
      626                               do:
      627                                   hh:load-image("cmp/b-hist.bmp":u) .
      628                                   hh:TOOLTIP = "История" .
      629                                   v-h[ii] = hh:handle .
      630                                   ii = ii + 1 .
      631                                   hh:width-chars = 3 .
      632                               end.
      633                           when "b-sch" then
      634                               do:
      635                                   hh:load-image("cmp/b-sch.bmp":u) .
      636                                   hh:TOOLTIP = "Установка Фильтра" .
      637                                   v-h[ii] = hh:handle .
      638                                   ii = ii + 1 .
      639                                   hh:width-chars = 3 .
      640                               end.
      641                           when "b-hist-user" then
      642                               do:
      643                                   hh:load-image("cmp/b-hist.bmp":u) .
      644                                   hh:TOOLTIP = "История пользователя" .
      645                                   ii = ii + 1 .
      646                               end.
      647                       end case.
      648                   end.
      649                   hh = hh:next-sibling.
      650               end.
      651               b-help:column = v-frame-width - b-help:width-chars.
      652               jj = 0.
      653               repeat ii = 4 to 1 by -1 :
      654                   if valid-handle (v-h[ii] ) then
      655                   do:
      656                       jj  = jj + 1 .
      657                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      658                       v-h[ii]:row    = v-help-old-y .
      659                   end.
      660               end.
      661           end.
      662       end.
      663   end procedure.
      664   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      665   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      666   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      667   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      668   define variable v-diasize-current-frame-width  as decimal   no-undo .
      669   define variable v-diasize-current-frame-height as decimal   no-undo .
      670   define variable v-diasize-change-size          as logical   no-undo .
      671   define variable v-diasize-resize-button        as handle    no-undo .
      672   define variable v-diasize-wndmax               as logical   no-undo .
      673   define variable v-diasize-wndstore             as logical   no-undo .
      674   define variable v-diasize-proc-name            as character no-undo .
      675   define variable v-diasize-browse-handle        as handle    no-undo .
      676   define variable v-diasize-browse-number        as integer   no-undo .
      677   define variable v-diasize-need-full-display    as logical   no-undo init false .
      678   define temp-table temp-diasize-handle no-undo
      679     field handle-value  as handle
      680     field save-position as decimal
      681     index xpk is primary unique handle-value
      682     .
      683   define temp-table temp-browse-handle no-undo
      684     field browse-type   as character
      685     field browse-number as integer
      686     field browse-handle as handle
      687     field original-size as decimal
      688     index xpk is primary unique browse-type browse-number
      689     index xie browse-type browse-handle
      690   .
      691   procedure diasize_change-height :
      692     define input  parameter p-change-value  as decimal   no-undo .
      693     define input  parameter p-move-resize   as logical   no-undo .
      694     define variable v-field-group-handle    as handle    no-undo .
      695     define variable v-object-handle         as handle    no-undo .
      696     define variable v-frame-height          as decimal   no-undo .
      697     define variable v-frame-virtual-height  as decimal   no-undo .
      698     define variable v-browse-height         as decimal   no-undo .
      699     define variable v-window-height         as decimal   no-undo .
      700     define variable v-window-virtual-height as decimal   no-undo .
      701     define variable v-change-sign           as integer   no-undo .
      702     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      703     define buffer buf_temp-browse-handle  for temp-browse-handle .
      704     if p-change-value > 0
      705     then do:
      706       if frame Dialog-Frame :height + p-change-value
      707           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      708       then do:
      709         assign
      710           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      711                           - (frame Dialog-Frame :height-chars)
      712         .
      713         if p-change-value <= 0
      714         then do:
      715           run diasize_position-resize-button in this-procedure .
      716           return .
      717         end.
      718       end.
      719     end.
      720     if p-change-value < 0
      721     then do:
      722       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      723       then do:
      724         assign
      725           p-change-value = v-diasize-orig-frame-height
      726                          - (frame Dialog-Frame :height-chars)
      727         .
      728         if p-change-value >= 0
      729         then do:
      730           run diasize_position-resize-button in this-procedure .
      731           return .
      732         end.
      733       end.
      734     end.
      735     if p-change-value >= 0
      736     then do:
      737       assign
      738         v-change-sign = 1
      739       .
      740     end.
      741     else do:
      742       assign
      743         v-change-sign = -1
      744       .
      745     end.
      746     assign
      747       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      748     .
      749     if p-change-value = 0
      750     then do:
      751       run diasize_position-resize-button in this-procedure .
      752       return .
      753     end.
      754     move_block:
      755     do
      756     on error undo move_block, retry move_block
      757     :
      758       if retry
      759       then do:
      760         do
      761         on error undo move_block, leave move_block
      762         :
      763           if p-change-value > 0
      764           then do:
      765             for each buf_temp-diasize-handle
      766             on error undo, next
      767             :
      768               assign
      769                 v-object-handle = buf_temp-diasize-handle.handle-value
      770               .
      771               if v-object-handle <> v-diasize-resize-button
      772               then do:
      773                 assign
      774                   v-object-handle :row = buf_temp-diasize-handle.save-position
      775                 .
      776               end.
      777             end.
      778             assign
      779               v-diasize-browse-handle :height = v-browse-height
      780             .
      781             for each buf_temp-browse-handle
      782               where buf_temp-browse-handle.browse-type = 'height':u
      783             on error undo, next
      784             :
      785               assign
      786                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      787               .
      788             end.
      789             assign
      790               frame Dialog-Frame :height = v-frame-height
      791             .
      792             if frame Dialog-Frame :scrollable = true
      793             then do:
      794               assign
      795                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      796               .
      797             end.
      798             run diasize_position-resize-button in this-procedure .
      799           end.
      800           else do:
      801             if frame Dialog-Frame :scrollable = true
      802             then do:
      803               assign
      804                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      805               .
      806             end.
      807             assign
      808               frame Dialog-Frame :height = v-frame-height
      809             .
      810             assign
      811               v-diasize-browse-handle :height = v-browse-height
      812             .
      813             for each buf_temp-browse-handle
      814               where buf_temp-browse-handle.browse-type = 'height':u
      815             on error undo, next
      816             :
      817               assign
      818                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      819               .
      820             end.
      821             for each buf_temp-diasize-handle
      822             on error undo, next
      823             :
      824               assign
      825                 v-object-handle = buf_temp-diasize-handle.handle-value
      826               .
      827               if v-object-handle <> v-diasize-resize-button
      828               then do:
      829                 assign
      830                   v-object-handle :row = buf_temp-diasize-handle.save-position
      831                 .
      832               end.
      833             end.
      834             run diasize_position-resize-button in this-procedure .
      835           end.
      836           assign
      837             v-diasize-change-size = false
      838           .
      839           leave move_block .
      840         end.
      841       end.
      842       assign
      843         v-diasize-need-full-display = true
      844       .
      845       if v-diasize-change-size = false
      846       then do:
      847         assign
      848           v-diasize-change-size = true
      849         .
      850       end.
      851       else do:
      852         return .
      853       end.
      854       assign
      855         v-frame-height = frame Dialog-Frame :height
      856         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      857         v-browse-height = v-diasize-browse-handle :height
      858       .
      859       for each buf_temp-browse-handle
      860         where buf_temp-browse-handle.browse-type = 'height':u
      861       :
      862         assign
      863           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      864         .
      865       end.
      866       for each buf_temp-diasize-handle
      867       :
      868         delete buf_temp-diasize-handle .
      869       end.
      870       assign
      871         v-field-group-handle = frame Dialog-Frame :first-child
      872       .
      873       do while valid-handle(v-field-group-handle)
      874       :
      875         assign
      876           v-object-handle = v-field-group-handle :first-child
      877         .
      878         do while valid-handle(v-object-handle)
      879         :
      880           if  v-object-handle <> v-diasize-browse-handle :handle
      881           and can-query(v-object-handle, "row")
      882           and can-query(v-object-handle, "height")
      883           and ( v-object-handle :row > v-diasize-browse-handle :row )
      884           then do:
      885             find first buf_temp-browse-handle
      886               where buf_temp-browse-handle.browse-type   = 'height':u
      887                 and buf_temp-browse-handle.browse-handle = v-object-handle
      888               no-error .
      889             if available buf_temp-browse-handle
      890             then do:
      891             end.
      892             else do:
      893               create buf_temp-diasize-handle .
      894               assign
      895                 buf_temp-diasize-handle.handle-value  = v-object-handle
      896                 buf_temp-diasize-handle.save-position = v-object-handle :row
      897               .
      898             end.
      899           end.
      900           assign
      901             v-object-handle = v-object-handle :next-sibling
      902           .
      903         end.
      904         assign
      905           v-field-group-handle = v-field-group-handle :next-sibling
      906         .
      907       end.
      908       do with frame Dialog-Frame
      909       :
      910         hide v-diasize-resize-button .
      911         assign
      912           v-diasize-resize-button :row    = 1
      913           v-diasize-resize-button :column = 1
      914         .
      915       end.
      916       if p-change-value > 0
      917       then do:
      918         if frame Dialog-Frame :scrollable = true
      919         then do:
      920           assign
      921             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      922             no-error .
      923           if error-status :error
      924           or error-status :get-message(1) <> ""
      925           then do:
      926             undo move_block, retry move_block .
      927           end.
      928         end.
      929         assign
      930           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      931           no-error .
      932         if error-status :error
      933         or error-status :get-message(1) <> ""
      934         then do:
      935           undo move_block, retry move_block .
      936         end.
      937         assign
      938           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      939           no-error .
      940         if error-status :error
      941         or error-status :get-message(1) <> ""
      942         then do:
      943           undo move_block, retry move_block .
      944         end.
      945         for each buf_temp-browse-handle
      946           where buf_temp-browse-handle.browse-type = 'height':u
      947         on error undo move_block, retry move_block
      948         :
      949           assign
      950             buf_temp-browse-handle.browse-handle :height
      951               = buf_temp-browse-handle.browse-handle :height + p-change-value
      952             no-error .
      953           if error-status :error
      954           or error-status :get-message(1) <> ""
      955           then do:
      956             undo move_block, retry move_block .
      957           end.
      958         end.
      959         for each buf_temp-diasize-handle
      960         on error undo move_block, retry move_block
      961         :
      962           assign
      963             v-object-handle = buf_temp-diasize-handle.handle-value
      964           .
      965           if v-object-handle <> v-diasize-resize-button
      966           then do:
      967             assign
      968               v-object-handle :row = v-object-handle :row + p-change-value
      969               no-error .
      970             if error-status :error
      971             or error-status :get-message(1) <> ""
      972             then do:
      973               undo move_block, retry move_block .
      974             end.
      975           end.
      976         end.
      977       end.
      978       else do:
      979         for each buf_temp-diasize-handle
      980         on error undo move_block, retry move_block
      981         :
      982           assign
      983             v-object-handle = buf_temp-diasize-handle.handle-value
      984           .
      985           if v-object-handle <> v-diasize-resize-button
      986           then do:
      987             assign
      988               v-object-handle :row = v-object-handle :row + p-change-value
      989               no-error .
      990             if error-status :error
      991             or error-status :get-message(1) <> ""
      992             then do:
      993               undo move_block, retry move_block .
      994             end.
      995           end.
      996         end.
      997         assign
      998           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      999           no-error .
     1000         if error-status :error
     1001         or error-status :get-message(1) <> ""
     1002         then do:
     1003           undo move_block, retry move_block .
     1004         end.
     1005         for each buf_temp-browse-handle
     1006           where buf_temp-browse-handle.browse-type = 'height':u
     1007         on error undo move_block, retry move_block
     1008         :
     1009           assign
     1010             buf_temp-browse-handle.browse-handle :height
     1011               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1012             no-error .
     1013           if error-status :error
     1014           or error-status :get-message(1) <> ""
     1015           then do:
     1016             undo move_block, retry move_block .
     1017           end.
     1018         end.
     1019         assign
     1020           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1021           no-error .
     1022         if error-status :error
     1023         or error-status :get-message(1) <> ""
     1024         then do:
     1025           undo move_block, retry move_block .
     1026         end.
     1027         if frame Dialog-Frame :scrollable = true
     1028         then do:
     1029           assign
     1030             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1031             no-error .
     1032           if error-status :error
     1033           or error-status :get-message(1) <> ""
     1034           then do:
     1035             undo move_block, retry move_block .
     1036           end.
     1037         end.
     1038       end.
     1039       if p-move-resize = true
     1040       then do:
     1041         run diasize_position-resize-button in this-procedure .
     1042       end.
     1043       if v-diasize-wndstore = true
     1044       then do:
     1045         if connected("ub") = true
     1046         then do:
     1047           define variable v-cntxt-db-num        as integer   no-undo .
     1048           define variable v-cntxt-userid        as character no-undo .
     1049           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1050                                             , OUTPUT v-cntxt-userid
     1051                                             ) .
     1052           run gbl/wndsizew.p
     1053             (input  v-cntxt-db-num
     1054             ,input  v-cntxt-userid
     1055             ,input  v-diasize-proc-name
     1056             ,input  'height':u
     1057             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1058             ) .
     1059         end.
     1060       end.
     1061     end.
     1062     assign
     1063       v-diasize-change-size = false
     1064     .
     1065   end procedure.
     1066   procedure diasize_set-height :
     1067     define input  parameter p-new-height  as decimal   no-undo .
     1068     define input  parameter p-move-resize as logical   no-undo .
     1069     do
     1070     on error undo, return error return-value
     1071     :
     1072       run diasize_change-height in this-procedure
     1073         (input  (p-new-height - frame Dialog-Frame :height)
     1074         ,input  p-move-resize
     1075         ) .
     1076     end.
     1077   end procedure.
     1078   procedure diasize_change-width :
     1079     define input  parameter p-change-value as decimal   no-undo .
     1080     define input  parameter p-move-resize  as logical   no-undo .
     1081     define variable v-field-group-handle   as handle    no-undo .
     1082     define variable v-object-handle        as handle    no-undo .
     1083     define variable v-frame-width          as decimal   no-undo .
     1084     define variable v-frame-virtual-width  as decimal   no-undo .
     1085     define variable v-browse-width         as decimal   no-undo .
     1086     define variable v-window-width         as decimal   no-undo .
     1087     define variable v-window-virtual-width as decimal   no-undo .
     1088     define variable v-change-sign          as integer   no-undo .
     1089     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1090     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1091     if p-change-value > 0
     1092     then do:
     1093       if frame Dialog-Frame :width + p-change-value >
     1094           session :width-chars
     1095       then do:
     1096         assign
     1097           p-change-value = session :width-chars - frame Dialog-Frame :width
     1098         .
     1099         if p-change-value <= 0
     1100         then do:
     1101           run diasize_position-resize-button in this-procedure .
     1102           return .
     1103         end.
     1104       end.
     1105     end.
     1106     if p-change-value < 0
     1107     then do:
     1108       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1109       then do:
     1110         assign
     1111           p-change-value = v-diasize-orig-frame-width
     1112                          - frame Dialog-Frame :width
     1113         .
     1114         if p-change-value >= 0
     1115         then do:
     1116           run diasize_position-resize-button in this-procedure .
     1117           return .
     1118         end.
     1119       end.
     1120     end.
     1121     if p-change-value >= 0
     1122     then do:
     1123       assign
     1124         v-change-sign = 1
     1125       .
     1126     end.
     1127     else do:
     1128       assign
     1129         v-change-sign = -1
     1130       .
     1131     end.
     1132     assign
     1133       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1134     .
     1135     if p-change-value = 0
     1136     then do:
     1137       run diasize_position-resize-button in this-procedure .
     1138       return .
     1139     end.
     1140     move_block:
     1141     do
     1142     on error undo move_block, leave move_block
     1143     :
     1144       if retry
     1145       then do:
     1146         do
     1147         on error undo move_block, leave move_block
     1148         :
     1149           if p-change-value > 0
     1150           then do:
     1151             for each buf_temp-diasize-handle
     1152             on error undo, next
     1153             :
     1154               assign
     1155                 v-object-handle = buf_temp-diasize-handle.handle-value
     1156               .
     1157               if v-object-handle <> v-diasize-resize-button
     1158               then do:
     1159                 assign
     1160                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1161                 .
     1162               end.
     1163             end.
     1164             assign
     1165               v-diasize-browse-handle :width = v-browse-width
     1166             .
     1167             for each buf_temp-browse-handle
     1168               where buf_temp-browse-handle.browse-type = 'width':u
     1169             on error undo, next
     1170             :
     1171               assign
     1172                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1173               .
     1174             end.
     1175             assign
     1176               frame Dialog-Frame :width = v-frame-width
     1177             .
     1178             if frame Dialog-Frame :scrollable = true
     1179             then do:
     1180               assign
     1181                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1182               .
     1183             end.
     1184             run diasize_position-resize-button in this-procedure .
     1185           end.
     1186           else do:
     1187             if frame Dialog-Frame :scrollable = true
     1188             then do:
     1189               assign
     1190                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1191               .
     1192             end.
     1193             assign
     1194               frame Dialog-Frame :width = v-frame-width
     1195             .
     1196             for each buf_temp-browse-handle
     1197               where buf_temp-browse-handle.browse-type = 'width':u
     1198             on error undo, next
     1199             :
     1200               assign
     1201                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1202               .
     1203             end.
     1204             assign
     1205               v-diasize-browse-handle :width = v-browse-width
     1206             .
     1207             for each buf_temp-diasize-handle
     1208             on error undo, next
     1209             :
     1210               assign
     1211                 v-object-handle = buf_temp-diasize-handle.handle-value
     1212               .
     1213               if v-object-handle <> v-diasize-resize-button
     1214               then do:
     1215                 assign
     1216                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1217                 .
     1218               end.
     1219             end.
     1220             run diasize_position-resize-button in this-procedure .
     1221           end.
     1222           assign
     1223             v-diasize-change-size = false
     1224           .
     1225           leave move_block .
     1226         end.
     1227       end.
     1228       assign
     1229         v-diasize-need-full-display = true
     1230       .
     1231       if v-diasize-change-size = false
     1232       then do:
     1233         assign
     1234           v-diasize-change-size = true
     1235         .
     1236       end.
     1237       else do:
     1238         return .
     1239       end.
     1240       assign
     1241         v-frame-width = frame Dialog-Frame :width
     1242         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1243         v-browse-width = v-diasize-browse-handle :width
     1244       .
     1245       for each buf_temp-browse-handle
     1246         where buf_temp-browse-handle.browse-type = 'width':u
     1247       :
     1248         assign
     1249           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1250         .
     1251       end.
     1252       for each buf_temp-diasize-handle
     1253       :
     1254         delete buf_temp-diasize-handle .
     1255       end.
     1256       assign
     1257         v-field-group-handle = frame Dialog-Frame :first-child
     1258       .
     1259       do while valid-handle(v-field-group-handle)
     1260       :
     1261         assign
     1262           v-object-handle = v-field-group-handle :first-child
     1263         .
     1264         do while valid-handle(v-object-handle)
     1265         :
     1266           if  v-object-handle <> v-diasize-browse-handle :handle
     1267           and v-object-handle <> v-diasize-resize-button
     1268           and can-query(v-object-handle, "row")
     1269           and can-query(v-object-handle, "height")
     1270           and ( v-object-handle :col + v-object-handle :width
     1271                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1272               )
     1273           then do:
     1274             find first buf_temp-browse-handle
     1275               where buf_temp-browse-handle.browse-type   = 'width':u
     1276                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1277               no-error .
     1278             if available buf_temp-browse-handle
     1279             then do:
     1280             end.
     1281             else do:
     1282               create buf_temp-diasize-handle .
     1283               assign
     1284                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1285                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1286               .
     1287             end.
     1288           end.
     1289           assign
     1290             v-object-handle = v-object-handle :next-sibling
     1291           .
     1292         end.
     1293         assign
     1294           v-field-group-handle = v-field-group-handle :next-sibling
     1295         .
     1296       end.
     1297       do with frame Dialog-Frame
     1298       :
     1299         hide v-diasize-resize-button .
     1300         v-diasize-resize-button :row = 1.
     1301         v-diasize-resize-button :column = 1.
     1302       end.
     1303       if p-change-value > 0
     1304       then do:
     1305         if frame Dialog-Frame :scrollable = true
     1306         then do:
     1307           assign
     1308             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1309             no-error .
     1310           if error-status :error
     1311           or error-status :get-message(1) <> ""
     1312           then do:
     1313             undo move_block, retry move_block.
     1314           end.
     1315         end.
     1316         assign
     1317           frame Dialog-Frame :width = v-frame-width + p-change-value
     1318           no-error .
     1319         if error-status :error
     1320         or error-status :get-message(1) <> ""
     1321         then do:
     1322           undo move_block, retry move_block.
     1323         end.
     1324         assign
     1325           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1326         no-error .
     1327         if error-status :error
     1328         or error-status :get-message(1) <> ""
     1329         then do:
     1330           undo move_block, retry move_block.
     1331         end.
     1332         for each buf_temp-browse-handle
     1333           where buf_temp-browse-handle.browse-type = 'width':u
     1334         on error undo move_block, retry move_block
     1335         :
     1336           assign
     1337             buf_temp-browse-handle.browse-handle :width
     1338               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1339             no-error .
     1340           if error-status :error
     1341           or error-status :get-message(1) <> ""
     1342           then do:
     1343             undo move_block, retry move_block .
     1344           end.
     1345         end.
     1346         for each buf_temp-diasize-handle
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             v-object-handle = buf_temp-diasize-handle.handle-value
     1351           .
     1352           if v-object-handle <> v-diasize-resize-button
     1353           then do:
     1354             assign
     1355               v-object-handle :col = v-object-handle :col + p-change-value
     1356               no-error .
     1357             if error-status :error
     1358             or error-status :get-message(1) <> ""
     1359             then do:
     1360               undo move_block, retry move_block .
     1361             end.
     1362           end.
     1363         end.
     1364       end.
     1365       else do:
     1366         for each buf_temp-diasize-handle
     1367         on error undo move_block, retry move_block
     1368         :
     1369           assign
     1370             v-object-handle = buf_temp-diasize-handle.handle-value
     1371           .
     1372           if v-object-handle <> v-diasize-resize-button
     1373           then do:
     1374             assign
     1375               v-object-handle :col = v-object-handle :col + p-change-value
     1376               no-error .
     1377             if error-status :error
     1378             or error-status :get-message(1) <> ""
     1379             then do:
     1380               undo move_block, retry move_block .
     1381             end.
     1382           end.
     1383         end.
     1384         for each buf_temp-browse-handle
     1385           where buf_temp-browse-handle.browse-type = 'width':u
     1386         on error undo move_block, retry move_block
     1387         :
     1388           assign
     1389             buf_temp-browse-handle.browse-handle :width
     1390               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1391             no-error .
     1392           if error-status :error
     1393           or error-status :get-message(1) <> ""
     1394           then do:
     1395             undo move_block, retry move_block .
     1396           end.
     1397         end.
     1398         assign
     1399           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1400           no-error .
     1401         if error-status :error
     1402         or error-status :get-message(1) <> ""
     1403         then do:
     1404           undo move_block, retry move_block.
     1405         end.
     1406         assign
     1407           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1408         no-error .
     1409         if error-status :error
     1410         or error-status :get-message(1) <> ""
     1411         then do:
     1412           undo move_block, retry move_block.
     1413         end.
     1414         if frame Dialog-Frame :scrollable = true
     1415         then do:
     1416           assign
     1417             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1418           no-error .
     1419           if error-status :error
     1420           or error-status :get-message(1) <> ""
     1421           then do:
     1422             undo move_block, retry move_block.
     1423           end.
     1424         end.
     1425       end.
     1426       if p-move-resize
     1427       then do:
     1428         run diasize_position-resize-button in this-procedure .
     1429       end.
     1430       if v-diasize-wndstore = true
     1431       then do:
     1432         if connected("ub") = true
     1433         then do:
     1434           define variable v-cntxt-db-num        as integer   no-undo .
     1435           define variable v-cntxt-userid        as character no-undo .
     1436           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1437                                             , OUTPUT v-cntxt-userid
     1438                                             ) .
     1439           run gbl/wndsizew.p
     1440             (input  v-cntxt-db-num
     1441             ,input  v-cntxt-userid
     1442             ,input  v-diasize-proc-name
     1443             ,input  'width':u
     1444             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1445             ) .
     1446         end.
     1447       end.
     1448     end.
     1449     assign
     1450       v-diasize-change-size = false
     1451     .
     1452   end procedure.
     1453   procedure diasize_set-width :
     1454     define input  parameter p-new-width  as decimal   no-undo .
     1455     define input  parameter p-move-resize as logical   no-undo .
     1456     do
     1457     on error undo, return error return-value
     1458     :
     1459       run diasize_change-width in this-procedure
     1460         (input  (p-new-width - frame Dialog-Frame :width)
     1461         ,input  p-move-resize
     1462         ) .
     1463     end.
     1464   end procedure.
     1465   procedure diasize_position-resize-button :
     1466     do with frame Dialog-Frame
     1467     :
     1468       hide v-diasize-resize-button .
     1469       assign
     1470         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1471                     - 1
     1472                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1473         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1474                     - 1
     1475                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1476       .
     1477       view v-diasize-resize-button .
     1478     end.
     1479   end procedure.
     1480   on alt-right anywhere
     1481   do:
     1482     run diasize_change-width in this-procedure
     1483       (input 1
     1484       ,input true
     1485       ) .
     1486     return no-apply .
     1487   end.
     1488   on alt-left anywhere
     1489   do:
     1490     run diasize_change-width in this-procedure
     1491       (input -1
     1492       ,input true
     1493       ) .
     1494     return no-apply .
     1495   end.
     1496   on alt-down anywhere
     1497   do:
     1498     run diasize_change-height in this-procedure
     1499       (input 1
     1500       ,input true
     1501       ) .
     1502     return no-apply .
     1503   end.
     1504   on alt-up anywhere
     1505   do:
     1506     run diasize_change-height in this-procedure
     1507       (input -1
     1508       ,input true
     1509       ) .
     1510     return no-apply .
     1511   end.
     1512   on alt-enter of frame Dialog-Frame
     1513   do:
     1514     run diasize_maximize in this-procedure
     1515       (input  ?
     1516       ).
     1517     return no-apply .
     1518   end.
     1519   procedure diasize_end-move :
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523       define variable v-row-delta as decimal   no-undo .
     1524       define variable v-col-delta as decimal   no-undo .
     1525       define variable v-new-row as decimal   no-undo .
     1526       define variable v-new-col as decimal   no-undo .
     1527       assign
     1528         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1529         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1530       .
     1531       assign
     1532         v-row-delta = v-new-row - frame Dialog-Frame :height
     1533         v-col-delta = v-new-col - frame Dialog-Frame :width
     1534       .
     1535       run diasize_change-height in this-procedure
     1536         (input v-row-delta
     1537         ,input true
     1538         ) .
     1539       run diasize_change-width in this-procedure
     1540         (input v-col-delta
     1541         ,input true
     1542         ) .
     1543     end.
     1544   end procedure.
     1545   procedure diasize_maximize :
     1546     define input  parameter p-action as logical   no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       if p-action = ?
     1551       then do:
     1552         if v-diasize-need-maximize = true
     1553         then do:
     1554           assign
     1555             p-action = true
     1556           .
     1557         end.
     1558         else do:
     1559           assign
     1560             p-action = false
     1561           .
     1562         end.
     1563       end.
     1564       if p-action = true
     1565       then do:
     1566         run diasize_change-height in this-procedure
     1567           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1568               - frame Dialog-Frame :height-chars
     1569           ,input true
     1570           ) .
     1571         run diasize_change-width in this-procedure
     1572           (input session :width-chars
     1573               - frame Dialog-Frame :width-chars
     1574           ,input true
     1575           ) .
     1576         assign
     1577           v-diasize-need-maximize = false
     1578         .
     1579       end.
     1580       else do:
     1581         run diasize_change-width in this-procedure
     1582           (input v-diasize-orig-frame-width
     1583               - frame Dialog-Frame :width-chars
     1584           ,input true
     1585           ) .
     1586         run diasize_change-height in this-procedure
     1587           (input v-diasize-orig-frame-height
     1588               - frame Dialog-Frame :height-chars
     1589           ,input true
     1590           ) .
     1591         assign
     1592           v-diasize-need-maximize = true
     1593         .
     1594       end.
     1595     end.
     1596   end procedure.
     1597   procedure diasize_restore-orig-size :
     1598     do
     1599     on error undo, return error return-value
     1600     :
     1601       assign
     1602         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1603         v-diasize-current-frame-height = frame Dialog-Frame :height
     1604       .
     1605       run diasize_set-height in this-procedure
     1606         (input  v-diasize-orig-frame-height
     1607         ,input  true
     1608         ) .
     1609       run diasize_set-width in this-procedure
     1610         (input  v-diasize-orig-frame-width
     1611         ,input  true
     1612         ) .
     1613     end.
     1614   end procedure.
     1615   procedure diasize_restore-current-size :
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619       run diasize_set-height in this-procedure
     1620         (input  v-diasize-current-frame-height
     1621         ,input  true
     1622         ) .
     1623       run diasize_set-width in this-procedure
     1624         (input  v-diasize-current-frame-width
     1625         ,input  true
     1626         ) .
     1627     end.
     1628   end procedure.
     1629   procedure diasize_set-browse-handle :
     1630     define input  parameter p-browse-handle as handle   no-undo .
     1631     define buffer buf_temp-browse-handle for temp-browse-handle .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       assign
     1636         v-diasize-browse-handle = p-browse-handle
     1637       .
     1638       for each buf_temp-browse-handle
     1639       on error undo, return error return-value
     1640       :
     1641         delete buf_temp-browse-handle .
     1642       end.
     1643     end.
     1644   end procedure.
     1645   procedure diasize_add_browse :
     1646     define input  parameter p-browse-type   as character no-undo .
     1647     define input  parameter p-browse-handle as handle    no-undo .
     1648     define buffer buf_temp-browse-handle for temp-browse-handle .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       assign
     1653         v-diasize-browse-number = v-diasize-browse-number + 1
     1654       .
     1655       create buf_temp-browse-handle .
     1656       assign
     1657         buf_temp-browse-handle.browse-type   = p-browse-type
     1658         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1659         buf_temp-browse-handle.browse-handle = p-browse-handle
     1660       .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_init :
     1664     define variable v-default-value    as logical   no-undo .
     1665     define variable v-restore-saved    as logical   no-undo .
     1666     define variable v-resize-value-str as character no-undo .
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       do with frame Dialog-Frame
     1671       :
     1672         assign
     1673           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1674           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1675           v-diasize-browse-handle     = browse br-wp :handle
     1676         .
     1677         create button v-diasize-resize-button
     1678         assign
     1679           parent        = frame Dialog-Frame :first-child
     1680           label         = "s"
     1681           height-pixels = 16
     1682           width-pixels  = 16
     1683           visible       = true
     1684           sensitive     = true
     1685           movable       = true
     1686           triggers:
     1687             on end-move persistent run diasize_end-move in this-procedure .
     1688           end triggers.
     1689         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1690         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1691         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1692         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1693         assign
     1694           v-diasize-wndmax = false
     1695         .
     1696         if connected("ub") = true
     1697         then do:
     1698           define variable v-cntxt-db-num        as integer   no-undo .
     1699           define variable v-cntxt-userid        as character no-undo .
     1700           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1701                                             , OUTPUT v-cntxt-userid
     1702                                             ) .
     1703           run gbl/wndpar_r.p
     1704             (input  v-cntxt-db-num
     1705             ,input  v-cntxt-userid
     1706             ,input  'wndmax':U
     1707             ,output v-diasize-wndmax
     1708             ,output v-default-value
     1709             ) .
     1710         end.
     1711         assign
     1712           v-diasize-wndstore = false
     1713         .
     1714         if connected("ub") = true
     1715         then do:
     1716           run gbl/wndpar_r.p
     1717             (input  v-cntxt-db-num
     1718             ,input  v-cntxt-userid
     1719             ,input  'wndstore':U
     1720             ,output v-diasize-wndstore
     1721             ,output v-default-value
     1722             ) .
     1723         end.
     1724         assign
     1725           v-diasize-proc-name = entry(1, program-name(2), '.')
     1726         .
     1727         if v-diasize-wndstore = true
     1728         then do:
     1729           assign
     1730             v-restore-saved = false
     1731           .
     1732           if connected("ub") = true
     1733           then do:
     1734             run gbl/wndsizer.p
     1735               (input  v-cntxt-db-num
     1736               ,input  v-cntxt-userid
     1737               ,input  v-diasize-proc-name
     1738               ,input  'height':u
     1739               ,output v-resize-value-str
     1740               ) .
     1741             if v-resize-value-str <> '':U
     1742             then do:
     1743               run diasize_change-height in this-procedure
     1744                 (input  integer(v-resize-value-str)
     1745                 ,input  true
     1746                 ) .
     1747               assign
     1748                 v-restore-saved = true
     1749               .
     1750             end.
     1751           end.
     1752           if connected("ub") = true
     1753           then do:
     1754             run gbl/wndsizer.p
     1755               (input  v-cntxt-db-num
     1756               ,input  v-cntxt-userid
     1757               ,input  v-diasize-proc-name
     1758               ,input  'width':u
     1759               ,output v-resize-value-str
     1760               ) .
     1761             if v-resize-value-str <> '':U
     1762             then do:
     1763               run diasize_change-width in this-procedure
     1764                 (input  integer(v-resize-value-str)
     1765                 ,input  true
     1766                 ) .
     1767               assign
     1768                 v-restore-saved = true
     1769               .
     1770             end.
     1771           end.
     1772           if v-restore-saved <> true
     1773           then do:
     1774             if v-diasize-wndmax = true
     1775             then do:
     1776               run diasize_maximize in this-procedure
     1777                 (input  true
     1778                 ) .
     1779             end.
     1780           end.
     1781         end.
     1782         else do:
     1783           if v-diasize-wndmax = true
     1784           then do:
     1785             run diasize_maximize in this-procedure
     1786               (input  true
     1787               ) .
     1788           end.
     1789         end.
     1790       end.
     1791     end.
     1792   end procedure.
     1793   procedure diasize_need-full-display :
     1794     define output parameter p-need-full-display as logical   no-undo .
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       assign
     1799         p-need-full-display = v-diasize-need-full-display
     1800       .
     1801       assign
     1802         v-diasize-need-full-display = false
     1803       .
     1804     end.
     1805   end procedure.
     1806   procedure get-context :
     1807      define output parameter p-db-num as integer          no-undo.
     1808      define output parameter p-user-id as character        no-undo.
     1809      define variable v-login               as character    no-undo.
     1810      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1811      define buffer buf_user-login  for ub.user-login .
     1812      do
     1813      on error undo, return error
     1814      :
     1815            FIND FIRST buf_sys-ctrl no-lock.
     1816            ASSIGN
     1817               v-login = USERID("ub")
     1818               p-db-num = buf_sys-ctrl.db-num
     1819            .
     1820            FIND FIRST buf_user-login
     1821                 WHERE buf_user-login.db-num = p-db-num
     1822                   AND buf_user-login.user-login = v-login
     1823                 no-lock
     1824                 no-error
     1825                 .
     1826            IF AVAILABLE buf_user-login
     1827            THEN DO:
     1828               assign
     1829                  p-user-id = buf_user-login.user-id
     1830               .
     1831            END.
     1832      end.
     1833   end procedure.
     1834   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   on f5 of frame Dialog-Frame anywhere
     1836   do:
     1837       v-doc-rec = recid(X_c-auto-tank).
     1838       run openbr in this-procedure.
     1839       reposition br-wp to recid v-doc-rec no-error.
     1840       apply 'value-changed' to br-wp.
     1841       apply "VALUE-CHANGED" to BR-changes.
     1842   end.
     1843   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1844   do:
     1845     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1846   end.
     1847   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1848   on INS of frame Dialog-Frame anywhere do:
     1849     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1850     return no-apply.
     1851   end.
     1852   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   on F2 of frame Dialog-Frame anywhere do:
     1854     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1855     return no-apply.
     1856   end.
     1857   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1858   on F2 of frame Dialog-Frame anywhere do:
     1859     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1860     return no-apply.
     1861   end.
     1862   MAIN-BLOCK:
     1863   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1864      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1865    if LOOKUP(p-mode, 'one':U, chr(4)) = 0 then dO:
     1866       message
     1867       vss-workfile vss-revision vss-description skip
     1868       "Неверное значение параметров вызова p-mode"
     1869       p-mode
     1870       view-as alert-box ERROR.
     1871       return error .
     1872    end.
     1873    if p-mode = "one":U then do:
     1874      find first X_c-auto-tank no-lock
     1875           where X_c-auto-tank.auto-num begins p-auto-num
     1876            and ( X_c-auto-tank.auto-num = p-auto-num or
     1877                  X_c-auto-tank.auto-num begins (p-auto-num + "#") )
     1878      no-error.
     1879       if not available X_c-auto-tank then do:
     1880           message
     1881           vss-workfile vss-revision vss-description skip
     1882           "Неверное значение параметра вызова p-auto-num"
     1883           p-auto-num
     1884           view-as alert-box ERROR.
     1885           return.
     1886       end.
     1887     end.
     1888     RUN MyEnable.
     1889     RUn OpenBR.
     1890     HIDE mark-num in frame Dialog-Frame .
     1891     if v-doc-rec <> ? then
     1892     REPOSITION br-wp to recid v-doc-rec No-ERROR.
     1893    run diasize_add_browse in this-procedure
     1894       (input  'width':u
     1895       ,input  browse br-changes :handle
     1896       ) .
     1897    run diasize_init in this-procedure .
     1898   WAIT-FOR GO OF FRAME Dialog-Frame.
     1899   END.
     1900   RUN disable_UI.
     1901   PROCEDURE disable_UI :
     1902     HIDE FRAME Dialog-Frame.
     1903   END PROCEDURE.
     1904   PROCEDURE enable_UI :
     1905     DISPLAY mark-num
     1906         WITH FRAME Dialog-Frame.
     1907     ENABLE b-quit B-mark B-sel B-Help br-wp BR-changes mark-num
     1908         WITH FRAME Dialog-Frame.
     1909     VIEW FRAME Dialog-Frame.
     1910     OPEN QUERY br-wp FOR EACH X_c-auto-tank NO-LOCK INDEXED-REPOSITION.
     1911   END PROCEDURE.
     1912   PROCEDURE MyEnable :
     1913   assign
     1914   temp-changes.l_name:resizable in browse br-changes = true
     1915   temp-changes.v_old:resizable in browse br-changes = true
     1916   temp-changes.v_new:resizable in browse br-changes = true
     1917   temp-changes.l_name:width in browse br-changes = 30
     1918   temp-changes.v_old:width in browse br-changes = 40
     1919   temp-changes.v_new:width in browse br-changes = 40
     1920   .
     1921   DISPLAY mark-num
     1922   WITH FRAME Dialog-Frame.
     1923   ENABLE
     1924   b-quit
     1925   B-mark when LOOKUP("b-mark":U, bttns) > 0
     1926   B-sel when LOOKUP("b-sel":U, bttns) > 0
     1927   B-Help
     1928   br-wp mark-num
     1929   br-changes
     1930   with FRAME Dialog-Frame.
     1931   VIEW FRAME Dialog-Frame.
     1932   END PROCEDURE.
     1933   PROCEDURE OpenBr :
     1934   OPEN QUERY br-wp FOR EACH X_c-auto-tank NO-LOCK
     1935           where X_c-auto-tank.auto-num begins p-auto-num
     1936            and ( X_c-auto-tank.auto-num = p-auto-num or
     1937                  X_c-auto-tank.auto-num begins (p-auto-num + "#") )
     1938    by X_c-auto-tank.chip-num descending
     1939                                 INDEXED-REPOSITION.
     1940   APPLY "VALUE-CHANGED" TO br-wp in frame Dialog-Frame.
     1941   APPLY "ENTRY" TO br-wp.
     1942   END PROCEDURE.
     1943   PROCEDURE proc-br-wp :
     1944   END PROCEDURE.
     1945   PROCEDURE proc-view-changes :
     1946   define variable v-s-old as character no-undo .
     1947   define variable v-s-new as character no-undo .
     1948   define variable v-n-old as integer no-undo .
     1949   define variable v-n-new as integer no-undo .
     1950   define buffer buf_temp-changes for temp-changes .
     1951     if available X_c-auto-tank then do:
     1952   // if
     1953   define variable v-label-param as character no-undo .
     1954   v-label-param =   "auto-num" + chr(4) + "Номер машины" + chr(4) + ""
     1955    + chr(8) + "brutto-qnty"  + chr(4) + "Вместимость" + chr(4) + ""
     1956    + chr(8) + "name" + chr(4) + "Название" + chr(4) + ""
     1957    + chr(8) + "status_"  + chr(4) + "Статус" + chr(4) + ""
     1958    + chr(8) + "PS" + chr(4) + "Примечание" + chr(4) + ""
     1959    + chr(8) + "tank-type" + chr(4) + "Тип автотранспорта" + chr(4) + ""
     1960    + chr(8) + "plomb-type" + chr(4) + "Тип пломбировки" + chr(4) + ""
     1961    + chr(8) + "cli-type" + chr(4) + "тип поставщика" + chr(4) + ""
     1962    + chr(8) + "cli-code" + chr(4) + "Код поставщика" + chr(4) + ""
     1963   .
     1964    run proc-full-temp-changes in this-procedure (
     1965                                                input  buffer X_c-auto-tank:handle
     1966                                               ,input  'auto-tank':U
     1967                                               ,input  "auto-num,brutto-qnty,name,status_,PS,tank-type,plomb-type,cli-type,cli-code"
     1968                                               ,input  v-label-param).
     1969       if can-find (first temp-changes) and ( index(X_c-auto-tank.auto-num, "#") > 0 ) then do:
     1970         find first buf_temp-changes where buf_temp-changes.f_name = "name" no-error .
     1971         if available buf_temp-changes then do :
     1972           assign
     1973             v-s-old = ENTRY(1, buf_temp-changes.v_old, chr(4))
     1974             v-s-new = ENTRY(1, buf_temp-changes.v_new, chr(4))
     1975           .
     1976           if (v-s-old > "") or (v-s-new > "") then do:
     1977             create temp-changes.
     1978             assign
     1979               temp-changes.t_name = 'auto-tank':U
     1980               temp-changes.f_name = "name#1"
     1981               temp-changes.l_name = "Min ур.взлива(мм)"
     1982               temp-changes.v_old  = v-s-old
     1983               temp-changes.v_new  = v-s-new
     1984               temp-changes.num_   = 0
     1985             .
     1986           end .
     1987           assign
     1988             v-n-old = num-entries(buf_temp-changes.v_old, chr(4))
     1989             v-n-new = num-entries(buf_temp-changes.v_new, chr(4))
     1990           .
     1991           assign
     1992             v-s-old = if v-n-old > 1 then ENTRY(2, buf_temp-changes.v_old, chr(4)) else ""
     1993             v-s-new = if v-n-new > 1 then ENTRY(2, buf_temp-changes.v_new, chr(4)) else ""
     1994           .
     1995           if (v-s-old > "") or (v-s-new > "") then do:
     1996             create temp-changes.
     1997             assign
     1998               temp-changes.t_name = 'auto-tank':U
     1999               temp-changes.f_name = "name#2"
     2000               temp-changes.l_name = "Max ур.взлива(мм)"
     2001               temp-changes.v_old  = v-s-old
     2002               temp-changes.v_new  = v-s-new
     2003               temp-changes.num_   = 0
     2004             .
     2005           end .
     2006           assign
     2007             v-s-old = if v-n-old > 2 then ENTRY(3, buf_temp-changes.v_old, chr(4)) else ""
     2008             v-s-new = if v-n-new > 2 then ENTRY(3, buf_temp-changes.v_new, chr(4)) else ""
     2009           .
     2010           if (v-s-old > "") or (v-s-new > "") then do:
     2011             create temp-changes.
     2012             assign
     2013               temp-changes.t_name = 'auto-tank':U
     2014               temp-changes.f_name = "name#3"
     2015               temp-changes.l_name = "Диаметр горловины(мм)"
     2016               temp-changes.v_old  = v-s-old
     2017               temp-changes.v_new  = v-s-new
     2018               temp-changes.num_   = 0
     2019             .
     2020           end .
     2021           delete buf_temp-changes .
     2022         end .
     2023       end .
     2024     end .
     2025     else do :
     2026       empty temp-table temp-changes .
     2027     end .
     2028   Open QUery br-changes for each temp-changes.
     2029   END PROCEDURE.
