    10901     if available cash-dis-rule then do:
    10902       find first cash-dis-time-rule no-lock where
    10903                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10904       assign
    10905       std-disc-dec = - cash-dis-rule.discnt-value
    10906       std-disc-reason = 0
    10907       no-error
    10908       .
    10909       if available cash-dis-time-rule then do:
    10910         assign
    10911         std-disc-lim = cash-dis-time-rule.date-to
    10912         .
    10913         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
    10914         assign
    10915         std-disc-dec = 0
    10916         std-disc-reason = 0
    10917         .
    10918         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10919         assign
    10920         std-disc-dec = 0
    10921         std-disc-reason = 0
    10922         .
    10923       end.
    10924     end.
    10925   end.
    10926   if cash-gds.wd > 1 then do:
    10927     find first cash-dis-rule no-lock where
