     8387         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8388         and cash-dis-rule.is-term = yes
     8389       :
     8390         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8391                                             ,input 'маг':U
     8392                                             ,input i-obj-code
     8393                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8394                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8395                                             ,input ?
     8396                                             ,output v-disc-price-sale
     8397                                             ,output v-pdf-id
     8398                                             ,output v-pdf-db-num ) no-error.
     8399         if error-status:error
     8400         or v-disc-price-sale = 0
     8401         or v-disc-price-sale = ?
     8402         then do:
     8403         end.
     8404         else do:
     8405           find first  cash-gds-discnt where
     8406                     cash-gds-discnt.b-code = cash-gds.b-code
     8407                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8408                   and cash-gds-discnt.obj-type = parobj-type
     8409                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8410           if not available cash-gds-discnt then do:
     8411             find first  cash-gds-discnt where
     8412                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8413             if not available cash-gds-discnt then do:
     8414               create cash-gds-discnt.
     8415               assign
     8416               cash-gds-discnt.crf = crgd + 1.
     8417             end.
     8418             crgd = crgd + 1.
     8419             assign
     8420             cash-gds-discnt.b-code = cash-gds.b-code
     8421             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8422             cash-gds-discnt.obj-type = parobj-type
     8423             cash-gds-discnt.obj-code = parobj-code
     8424             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8425             release cash-gds-discnt.
     8426           end.
     8427         end.
     8428       end.
     8429     end.
     8430   end.
     8431   END PROCEDURE.
