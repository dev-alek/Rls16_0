     8267      no-error .
     8268      if cash-gds.is-gas then do:
     8269        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     8270      end.
     8271   end.
     8272      run gds-attr-value in this-procedure  (
     8273                                             input cash-gds.gds-code
     8274                                            ,input 'ban-bonus':U
     8275                                            ,output v-ban-bonus
     8276                                            ,output v-type) no-error.
     8277     assign
     8278      cash-gds.wd = int(logical(v-ban-bonus))
     8279      no-error .
     8280   if how-temp-disc = 'temp-disc':U then do:
     8281     case temp-discnt-method_:
     8282       when "" then do:
     8283       end.
     8284       when "bar-code.b-code" then do:
