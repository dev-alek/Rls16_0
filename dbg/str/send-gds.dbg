     3348   procedure xml-cd-write-header:
     3349   do
     3350   on error undo, return error
     3351   :
     3352   define input parameter p-xml-file-name       as character    no-undo.
     3353   define input parameter p-xml-file-name-path  as character    no-undo.
     3354   define input parameter p-doc-name            as character    no-undo.
     3355   define input parameter p-version             as character    no-undo.
     3356   define input parameter p-obj-list            as character    no-undo.
     3357   define input parameter p-correspondent       as character    no-undo .
     3358   define input parameter p-write-header        as logical      no-undo .
     3359   define variable OS-time as character no-undo .
     3360   define variable id as character no-undo .
     3361   define buffer buf_db for ub.db.
     3362   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3363   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3364   assign
     3365   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3366   .
     3367   run bgelib-tag-open in this-procedure (
     3368                                        1
     3369                                       ,p-doc-name
     3370                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3371                                         ).
     3372   if p-write-header then do:
     3373     run bgelib-tag-open(2, "Header","").
     3374     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3375     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3376     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3377     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3378     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3379     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3380     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3381     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3382     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3383     run bgelib-tag-close( 2, "Header" ).
     3384   end.
     3385   output stream stmXMLOut close.
     3386   end.
     3387   end procedure.
     3388   procedure xml-cd-write-footer:
     3389   do
     3390   on error undo, return error
     3391   :
     3392   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3393   define input parameter p-xml-file-name as character    no-undo.
     3394   define input parameter p-doc-name      as character    no-undo .
     3395   define variable v-error-num     as integer           no-undo.
     3396   define variable v-md5-signature as character no-undo .
     3397   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3398   run bgelib-tag-close( 0, p-doc-name ).
     3399   put stream stmXMLOut unformatted skip.
     3400   output stream stmXMLOut close.
     3401   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3402   if v-error-num > 0
     3403   then do:
     3404      return error.
     3405   end.
     3406   if opsys = "unix"
     3407   then do:
     3408       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3409   end.
     3410   end.
     3411   end procedure.
     3412   procedure xml-cd-filename :
     3413   do
     3414   on error undo, return error
     3415   :
     3416   define input parameter  p-out               as character no-undo .
     3417   define output parameter p-xml-file-name     as character    no-undo.
     3418   define output parameter p-xml-file-name-path   as character    no-undo.
     3419   define output parameter p-log-file-name     as character    no-undo.
     3420   define output parameter p-locked            as logical      no-undo.
     3421   define variable v-out as character     no-undo.
     3422   define variable loc#log as logical no-undo .
     3423   define variable BadFlag as logical no-undo .
     3424   define variable fq as integer no-undo .
     3425   define variable v-remote as character no-undo .
     3426   assign
     3427   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3428   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3429   p-log-file-name = p-out + "actions.log"
     3430   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3431   .
     3432   end.
     3433   end procedure.
     3434   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3435   define variable v-date-str as character no-undo .
     3436   assign
     3437   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3438                string(Month(p-date), "99":U) + "-":U +
     3439                string(DAY(p-date), "99":U).
     3440   return v-date-str.
     3441   END FUNCTION.
     3442   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3443   define variable v-date-str as character no-undo .
     3444   assign
     3445   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3446                string(Month(p-date), "99":U) + "-":U +
     3447                string(DAY(p-date), "99":U) + chr(32) +
     3448                string(p-time, "HH:MM:SS").
     3449   return v-date-str.
     3450   END FUNCTION.
     3451   function string-to-date returns date ( input p-string  as character):
     3452     define variable v-date as date no-undo .
     3453     assign
     3454     v-date = date(integer(substring(p-string, 4, 2))
     3455                   ,integer(substring(p-string, 1, 2))
     3456                   ,integer(substring(p-string, 7, 4))
     3457                  ) no-error .
     3458     if error-status:error then return ?.
     3459     return v-date.
     3460   END FUNCTION.
     3461   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3462   define variable v-time as integer no-undo init ?.
     3463   define variable v-dop1 as character no-undo .
     3464   define variable v-dop2 as character no-undo .
     3465   assign
     3466   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3467   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3468   no-error .
     3469   if error-status:error then return ?.
     3470   assign
     3471   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3472             integer(entry(2, v-dop2, ";":U)) * 60 +
     3473             integer(entry(3, v-dop2, ";":U)) no-error .
     3474   return v-time.
     3475   END FUNCTION.
     3476   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3477   procedure gdcstcod_cst-code :
     3478     define input  parameter p-obj-type  as character no-undo .
     3479     define input  parameter p-obj-code  as integer   no-undo .
     3480     define input  parameter p-gds-code  as integer   no-undo .
     3481     define input  parameter p-in-code   as character no-undo .
     3482     define input  parameter p-part-code as character no-undo .
     3483     define output parameter p-cst-code  as character no-undo .
     3484     define buffer buf_goods for ub.goods .
     3485     define buffer buf_parts for ub.parts .
     3486     do
     3487     on error undo, return error return-value
     3488     :
     3489       assign
     3490         p-cst-code = ''
     3491       .
     3492       find first buf_goods no-lock
     3493         where buf_goods.gds-code = p-gds-code
     3494         no-error .
     3495       if not available buf_goods
     3496       then do:
     3497         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3498       end.
     3499       if p-in-code = ?
     3500       then do:
     3501         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3502       end.
     3503       if p-part-code = ?
     3504       then do:
     3505         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3506       end.
     3507       if p-in-code = '':u
     3508       then do:
     3509         find first buf_parts no-lock
     3510           where buf_parts.obj-type  = p-obj-type
     3511             and buf_parts.obj-code  = p-obj-code
     3512             and buf_parts.artic     = buf_goods.artic
     3513             and buf_parts.prod-type = buf_goods.prod-type
     3514             and buf_parts.prod-code = buf_goods.prod-code
     3515             and buf_parts.out-code  = 'free-zone':U
     3516             and buf_parts.status_   = false
     3517           no-error .
     3518         if available buf_parts
     3519         then do:
     3520           assign
     3521             p-cst-code = buf_parts.cst-code
     3522           .
     3523         end.
     3524       end.
     3525       else do:
     3526         find first buf_parts no-lock
     3527           where buf_parts.obj-type  = p-obj-type
     3528             and buf_parts.obj-code  = p-obj-code
     3529             and buf_parts.artic     = buf_goods.artic
     3530             and buf_parts.prod-type = buf_goods.prod-type
     3531             and buf_parts.prod-code = buf_goods.prod-code
     3532             and buf_parts.out-code  = 'free-zone':U
     3533             and buf_parts.in-code   = p-in-code
     3534             and buf_parts.part-code = p-part-code
     3535           no-error .
     3536         if available buf_parts
     3537         then do:
     3538           assign
     3539             p-cst-code = buf_parts.cst-code
     3540           .
     3541         end.
     3542       end.
     3543     end.
     3544   end procedure.
