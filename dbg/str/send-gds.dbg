    10453         .
    10454       end.
    10455       else do:
    10456         assign
    10457         v-delim = chr(32)
    10458         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10459         .
    10460       end.
    10461       if cash-gds.b-str = "" then do:
    10462         assign
    10463         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10464         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10465         or cash-gds.unit-base <> cash-gds.unit-cli
    10466         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10467         then
    10468         do:
    10469           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10470               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10471             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10472             iBM2-short = bar_code.
    10473             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10474           END.
    10475           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10476               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10477             IBM-good-code-2 = b_code.
    10478           end.
    10479         end.
    10480       end.
    10481       else do:
    10482         IBm-good-code =
    10483         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10484           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10485            or
    10486            cash-gds.bc-on-type = 'pglc':U)
    10487         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10488         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10489       end.
    10490     end.
    10491   end procedure.
    10492   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10493   procedure ncr-gdsc :
