     5067   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5068   PROCEDURE cd-mrkt_plu-marketer :
     5069   define input parameter p-silence as logical no-undo .
     5070   define parameter buffer buf_cash-desk for ub.cash-desk.
     5071   define input parameter p-id as character no-undo .
     5072   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     5073   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     5074   define input parameter p-loc-ean as logical no-undo .
     5075   define input parameter p-is-petrolium as logical no-undo .
     5076   define input parameter p-extra as character no-undo .
     5077   define variable v-tot-gds as integer no-undo .
     5078   define variable v-max-gds as integer no-undo .
     5079   define variable v-petrol-start as integer no-undo .
     5080   define variable v-petrol-range as integer no-undo .
     5081   DEFINE VARIABLE v-today as date no-undo .
     5082   DEFINE VARIABLE v-time as integer no-undo .
     5083   define variable v-plu-type as character no-undo .
     5084   define variable v-int as integer no-undo .
     5085   define buffer  buf_cd-plu for ub.cd-plu.
     5086   define buffer  loc_cd-plu for ub.cd-plu.
     5087   define variable  ii as integer no-undo.
     5088   define variable v-mes as character no-undo .
     5089   _main:
     5090   DO ON ERROR undo, leave on stop undo, leave:
     5091     if buf_cash-desk.pos-type <> 'MARIA':U
     5092     or buf_cash-desk.cash-num <> 0 then do:
     5093       assign
     5094       v-mes =
     5095       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5096                 , buf_cash-desk.pos-type).
     5097       if not p-silence then
     5098       message
     5099       v-mes
     5100       view-as alert-box error .
     5101       return error v-mes.
     5102     end.
     5103     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     5104                                     ,input 'MARIA_operative':U
     5105                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5106                                           and p-is-petrolium
     5107                                           then 'tot-petrol':U
     5108                                           else 'tot-gds':U)
     5109                                     , output v-mes).
     5110     if v-tot-gds = ? then undo _main, return error v-mes.
     5111     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     5112                                     ,input 'MARIA_general':U
     5113                                     ,input 'max-gds':U
     5114                                     ,output v-mes).
     5115     if v-max-gds = ? then undo _main, return error v-mes.
     5116     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     5117                                          ,input 'petrolium-range':U
     5118                                          ,input 'petrolium-range':U
     5119                                          ,output v-mes).
     5120     if v-petrol-range = ? then undo _main, return error v-mes.
     5121     if buf_cash-desk.pos-type = 'MARIA':U then do:
     5122       assign
     5123       v-petrol-start = 1
     5124       v-max-gds = (if p-is-petrolium
     5125                    then v-petrol-range
     5126                    else v-max-gds)
     5127       v-plu-type = (if p-is-petrolium
     5128                  then 'топ':U
     5129                  else '':U)
     5130       .
     5131       if p-is-petrolium then do:
     5132         if p-id = '':U then do:
     5133           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     5134                               "Невозможно привязать к кассе типа &3"
     5135                               , p-b-str
     5136                               , chr(10)
     5137                               , 'MARIA':U).
     5138           if not p-silence then
     5139           message
     5140           v-mes
     5141           view-as alert-box error .
     5142           return error v-mes.
     5143         end.
     5144         assign
     5145         v-int = integer(p-id)
     5146         no-error
     5147         .
     5148         if error-status:error
     5149         or v-int > v-petrol-range then do:
     5150           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     5151                               "в диапазоны номеров резервуаров для кассы типа &4"
     5152                               , p-id
     5153                               , p-b-str
     5154                               , chr(10)
     5155                               , 'MARIA':U).
     5156           if not p-silence then
     5157           message
     5158           v-mes
     5159           view-as alert-box error .
     5160           return error v-mes.
     5161         end.
     5162       end.
     5163     end.
     5164     if buf_cash-desk.pos-type = 'MARIA':U
     5165     and p-is-petrolium then do:
     5166       find first loc_cd-plu where
     5167                loc_cd-plu.obj-type = 'маг':U
     5168            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     5169            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     5170            and loc_cd-plu.plu-type = 'топ':U
     5171      no-error .
     5172      if available loc_cd-plu then do:
     5173        if loc_cd-plu.b-code = p-b-code
     5174        and loc_cd-plu.b-str = p-b-str then do:
     5175           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     5176                               , p-id
     5177                               , p-b-str
     5178                               , chr(10)
     5179                               ).
     5180           if not p-silence then
     5181           message
     5182           v-mes
     5183           view-as alert-box WARNING .
     5184           return v-mes.
     5185        end.
     5186        else do:
     5187           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     5188                               "нельзя его привязать к топливу &2&3"
     5189                               , p-id
     5190                               , loc_cd-plu.b-str
     5191                               , chr(10)
     5192                               , p-b-str).
     5193           if not p-silence then
     5194           message
     5195           v-mes
     5196           view-as alert-box error .
     5197           return error v-mes.
     5198        end.
     5199      end.
     5200      ii = v-int.
     5201     end.
     5202     else do:
     5203       DO ii = (if p-is-petrolium
     5204               then v-petrol-start
     5205               else (if buf_cash-desk.pos-type = 'MARIA':U
     5206                    then 1
     5207                    else (if v-petrol-start = 1
     5208                           then (v-petrol-range + 1)
     5209                           else 1)
     5210                   )
     5211               )
     5212         to v-max-gds :
     5213         if not can-find (loc_cd-plu where
     5214                         loc_cd-plu.obj-type = 'маг':U
     5215                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     5216                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     5217                      and loc_cd-plu.plu-type = v-plu-type
     5218                      and loc_cd-plu.plu-code = ii
     5219                       )
     5220         then LEAVE .
     5221       END .
     5222     end.
     5223     if ii > v-max-gds then do:
     5224         if not p-silence then
     5225         message
     5226         substitute("Превышено максимально допустимое количество &5 &1" +
     5227                   "для касс &2 &3&4"
     5228                   , chr(10)
     5229                   , v-max-gds
     5230                   , 'маг':U
     5231                   , buf_cash-desk.obj-code
     5232                   , (if p-is-petrolium then "топлив" else "товаров")
     5233                   )
     5234         view-as alert-box ERROR .
     5235         undo, return error "max-gds":U.
     5236     end.
     5237     DO ii = (if p-is-petrolium
     5238              then v-petrol-start
     5239              else (if v-petrol-start = 1
     5240                    then (v-petrol-range + 1)
     5241                    else 1)
     5242              )
     5243        to v-max-gds :
     5244       if not can-find (loc_cd-plu where
     5245                         loc_cd-plu.obj-type = 'маг':U
     5246                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     5247                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     5248                      and loc_cd-plu.plu-type = v-plu-type
     5249                      and loc_cd-plu.plu-code = ii
     5250                      )
     5251       then LEAVE .
     5252     END .
     5253     if ii > v-max-gds then do:
     5254         if not p-silence then
     5255         message
     5256         substitute("Превышено максимально допустимое количество &5 &1" +
     5257                   "для касс &2 &3&4"
     5258                   , chr(10)
     5259                   , v-max-gds
     5260                   , 'маг':U
     5261                   , buf_cash-desk.obj-code
     5262                   , (if p-is-petrolium then "топлив" else "товаров")
     5263                   )
     5264         view-as alert-box ERROR .
     5265         undo, return error "max-gds":U.
     5266     end.
     5267     run cur-time in this-procedure ( output v-today, output v-time).
     5268     create buf_cd-plu.
     5269     assign
     5270     buf_cd-plu.b-code = p-b-code
     5271     buf_cd-plu.b-str = p-b-str
     5272     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5273                                         then buf_cash-desk.addr-path
     5274                                         else "U":U)
     5275     buf_cd-plu.to-send = yes
     5276     buf_cd-plu.charkey_one = "":U
     5277     buf_cd-plu.to-del = no
     5278     buf_cd-plu.plu-code = ii
     5279     buf_cd-plu.obj-type = 'маг':U
     5280     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     5281     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     5282     buf_cd-plu.plu-type = v-plu-type
     5283     buf_cd-plu.logkey_one = p-loc-ean
     5284     buf_cd-plu.key#_one = integer(p-extra)
     5285     .
     5286     run cd-attr-write  in this-procedure (
     5287                                           input   buf_cash-desk.db-num
     5288                                           ,input  buf_cash-desk.obj-code
     5289                                           ,input  buf_cash-desk.pos-type
     5290                                           ,input  buf_cash-desk.cash-num
     5291                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     5292                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     5293                                                 and p-is-petrolium
     5294                                                 then 'tot-petrol':U
     5295                                                 else 'tot-gds':U)
     5296                                           ,input ''
     5297                                           ,input ?
     5298                                           ,input 0.0
     5299                                           ,input  (v-tot-gds + 1)
     5300                                           ,input no
     5301                                          ) no-error .
     5302     if error-status:error then do:
     5303       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     5304                          ,buf_cash-desk.cash-num
     5305                          , 'маг':U
     5306                          ,buf_cash-desk.obj-code
     5307                          , chr(10)
     5308                          , error-status:get-message(1)
     5309                          , return-value
     5310                          ).
     5311       if not p-silence then
     5312       message
     5313       v-mes
     5314       view-as alert-box error .
     5315       undo _main, return error v-mes.
     5316     end.
     5317     run cd-attr-write  in this-procedure (
     5318                                           input   buf_cash-desk.db-num
     5319                                           ,input  buf_cash-desk.obj-code
     5320                                           ,input  buf_cash-desk.pos-type
     5321                                           ,input  buf_cash-desk.cash-num
     5322                                           ,input  'MARIA_operative':U
     5323                                           ,input  'to-send':U
     5324                                           ,input ''
     5325                                           ,input ?
     5326                                           ,input 0.0
     5327                                           ,input 0
     5328                                           ,input yes
     5329                                          ) no-error .
     5330     if error-status:error then do:
     5331       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5332                          ,buf_cash-desk.cash-num
     5333                          , 'маг':U
     5334                          ,buf_cash-desk.obj-code
     5335                          , chr(10)
     5336                          , error-status:get-message(1)
     5337                          , return-value
     5338                          ).
     5339       if not p-silence then
     5340       message
     5341       v-mes
     5342       view-as alert-box error .
     5343       undo _main, return error v-mes.
     5344     end.
     5345     return "":U.
     5346   end.
     5347   END PROCEDURE.
     5348   procedure cd-mrkt_update-marketer :
     5349   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5350   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5351   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5352   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5353   define input parameter p-is-petrolium as logical no-undo .
     5354   define variable v-to-send as logical no-undo .
     5355   define variable v-tot-gds as integer no-undo .
     5356   define variable v-max-plu as integer no-undo .
     5357   define buffer buf_cd-plu for ub.cd-plu.
     5358   define variable v-plu-type as character no-undo .
     5359     do
     5360     on error undo, return error
     5361     :
     5362       v-to-send = no.
     5363       v-tot-gds = 0.
     5364       assign
     5365       v-plu-type = (if p-is-petrolium
     5366                     then  'топ':U
     5367                     else '':U
     5368                 )
     5369       .
     5370       FOR EACH buf_cd-plu WHERE
     5371              buf_cd-plu.obj-type = 'маг':U
     5372         and  buf_cd-plu.obj-code = p-obj-code
     5373         and  buf_cd-plu.pos-type = p-pos-type
     5374         and  buf_cd-plu.plu-type = v-plu-type
     5375             :
     5376         if  buf_cd-plu.to-del
     5377         or  buf_cd-plu.to-send then do:
     5378           assign
     5379           v-to-send = yes.
     5380         end.
     5381         assign
     5382         v-tot-gds = v-tot-gds + 1.
     5383       end.
     5384       run cd-attr-write  in this-procedure (
     5385                                               input   p-db-num
     5386                                               ,input  p-obj-code
     5387                                               ,input  p-pos-type
     5388                                               ,input  p-cash-num
     5389                                               ,input  'MARIA_operative':U
     5390                                               ,input  (if p-pos-type = 'MARIA':U
     5391                                                        and p-is-petrolium
     5392                                                        then  'tot-petrol':U
     5393                                                        else 'tot-gds':U)
     5394                                               ,input ''
     5395                                               ,input ?
     5396                                               ,input 0.0
     5397                                               ,input v-tot-gds
     5398                                               ,input no
     5399                                                                                           ) no-error .
     5400       if error-status:error then do:
     5401           UNDO, RETURN ERROR RETURN-VALUE.
     5402       END.
     5403       run cd-attr-write  in this-procedure (
     5404                                               input   p-db-num
     5405                                               ,input  p-obj-code
     5406                                               ,input  p-pos-type
     5407                                               ,input  p-cash-num
     5408                                               ,input  'MARIA_operative':U
     5409                                               ,input  (if p-pos-type = 'MARIA':U
     5410                                                        and p-is-petrolium
     5411                                                        then  'petrol-to-send':U
     5412                                                        else 'to-send':U)
     5413                                               ,input ''
     5414                                               ,input ?
     5415                                               ,input 0.0
     5416                                               ,input 0
     5417                                               ,input v-to-send
     5418                                               ) no-error .
     5419       if error-status:error then do:
     5420           UNDO, RETURN ERROR RETURN-VALUE.
     5421       END.
     5422       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5423                buf_cd-plu.obj-type = 'маг':U
     5424            and buf_cd-plu.obj-code = p-obj-code
     5425            and buf_cd-plu.pos-type = p-pos-type
     5426            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5427       if available buf_cd-plu then do:
     5428         if v-max-plu < buf_cd-plu.plu-code
     5429         then
     5430         v-max-plu = buf_cd-plu.plu-code .
     5431       end.
     5432       else do:
     5433         v-max-plu = 0.
     5434       end.
     5435       run cd-attr-write  in this-procedure (
     5436                                             input   p-db-num
     5437                                             ,input  p-obj-code
     5438                                             ,input  p-pos-type
     5439                                             ,input  p-cash-num
     5440                                             ,input  'MARIA_operative':U
     5441                                             ,input  (if p-pos-type = 'MARIA':U
     5442                                                     and p-is-petrolium
     5443                                                     then 'max-petrol-plu':U
     5444                                                     else 'max-plu':U)
     5445                                               ,input ''
     5446                                               ,input ?
     5447                                               ,input 0.0
     5448                                               ,input v-max-plu
     5449                                               ,input no
     5450                                             ) no-error .
     5451       if error-status:error then do:
     5452           UNDO, RETURN ERROR RETURN-VALUE.
     5453       END.
     5454     end.
     5455   end procedure.
     5456   PROCEDURE cd-mrkt_clu-marketer :
     5457   define input parameter p-silence as logical no-undo .
     5458   define parameter buffer buf_cash-desk for ub.cash-desk.
     5459   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5460   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5461   define variable v-tot-cli as integer no-undo .
     5462   define variable v-max-cli as integer no-undo .
     5463   DEFINE VARIABLE v-today as date no-undo .
     5464   DEFINE VARIABLE v-time as integer no-undo .
     5465   define buffer  buf_cd-clu for ub.cd-clu.
     5466   define buffer  loc_cd-clu for ub.cd-clu.
     5467   define variable  ii as integer no-undo.
     5468   define variable v-mes as character no-undo .
     5469   _main:
     5470   DO ON ERROR undo, leave on stop undo, leave:
     5471     if buf_cash-desk.pos-type <> 'MARIA':U
     5472     or buf_cash-desk.cash-num <> 0 then do:
     5473       assign
     5474       v-mes =
     5475       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5476                 , buf_cash-desk.pos-type).
     5477       if not p-silence then
     5478       message
     5479       v-mes
     5480       view-as alert-box error .
     5481       return error v-mes.
     5482     end.
     5483     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5484                                     ,input 'MARIA_operative':U
     5485                                     ,input 'tot-cli':U
     5486                                     ,output v-mes).
     5487     if v-tot-cli = ? then undo _main, return error v-mes.
     5488     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5489                                     ,input 'MARIA_general':U
     5490                                     ,input 'max-cli':U
     5491                                     , output v-mes).
     5492     if v-max-cli = ? then undo _main, return error v-mes.
     5493     DO ii = 1
     5494        to v-max-cli :
     5495       if not can-find (loc_cd-clu where
     5496                       loc_cd-clu.obj-type = 'маг':U
     5497                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5498                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5499                   and loc_cd-clu.clu-type = '':U
     5500                   and loc_cd-clu.clu-code = ii
     5501                      )
     5502       then LEAVE .
     5503     END .
     5504     if ii > v-max-cli then do:
     5505         if not p-silence then
     5506         message
     5507         substitute("Превышено максимально допустимое количество клиентов &1" +
     5508                   "для касс &2 &3&4"
     5509                   , chr(10)
     5510                   , v-max-cli
     5511                   , 'маг':U
     5512                   , buf_cash-desk.obj-code
     5513                   )
     5514         view-as alert-box ERROR .
     5515         undo, return error "max-cli":U.
     5516     end.
     5517     run cur-time in this-procedure ( output v-today, output v-time).
     5518     create buf_cd-clu.
     5519     assign
     5520     buf_cd-clu.cli-code = p-obj-code
     5521     buf_cd-clu.cli-type = p-obj-type
     5522     buf_cd-clu.obj-type = 'маг':U
     5523     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5524     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5525     buf_cd-clu.clu-type = '':U
     5526     buf_cd-clu.to-send = yes
     5527     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5528                               then buf_cash-desk.addr-path
     5529                               else "U":U)
     5530     buf_cd-clu.clu-code = ii
     5531     .
     5532     run cd-attr-write  in this-procedure (
     5533                                           input   buf_cash-desk.db-num
     5534                                           ,input  buf_cash-desk.obj-code
     5535                                           ,input  buf_cash-desk.pos-type
     5536                                           ,input  buf_cash-desk.cash-num
     5537                                           ,input  'MARIA_operative':U
     5538                                           ,input  'tot-cli':U
     5539                                           ,input ''
     5540                                           ,input ?
     5541                                           ,input 0.0
     5542                                           ,input  (v-tot-cli + 1)
     5543                                           ,input no
     5544                                          ) no-error .
     5545     if error-status:error then do:
     5546       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5547                          ,buf_cash-desk.cash-num
     5548                          , 'маг':U
     5549                          ,buf_cash-desk.obj-code
     5550                          , chr(10)
     5551                          , error-status:get-message(1)
     5552                          , return-value
     5553                          ).
     5554       if not p-silence then
     5555       message
     5556       v-mes
     5557       view-as alert-box error .
     5558       undo _main, return error v-mes.
     5559     end.
     5560     run cd-attr-write  in this-procedure (
     5561                                           input   buf_cash-desk.db-num
     5562                                           ,input  buf_cash-desk.obj-code
     5563                                           ,input  buf_cash-desk.pos-type
     5564                                           ,input  buf_cash-desk.cash-num
     5565                                           ,input  'MARIA_operative':U
     5566                                           ,input  'cli-to-send':U
     5567                                           ,input ''
     5568                                           ,input ?
     5569                                           ,input 0.0
     5570                                           ,input 0
     5571                                           ,input yes
     5572                                          ) no-error .
     5573     if error-status:error then do:
     5574       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5575                          ,buf_cash-desk.cash-num
     5576                          , 'маг':U
     5577                          ,buf_cash-desk.obj-code
     5578                          , chr(10)
     5579                          , error-status:get-message(1)
     5580                          , return-value
     5581                          ).
     5582       if not p-silence then
     5583       message
     5584       v-mes
     5585       view-as alert-box error .
     5586       undo _main, return error v-mes.
     5587     end.
     5588     return "":U.
     5589   end.
     5590   END PROCEDURE.
     5591   procedure cd-mrkt_update-marketer-cli :
     5592   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5593   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5594   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5595   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5596   define variable v-cli-to-send as logical no-undo .
     5597   define variable v-tot-cli as integer no-undo .
     5598   define variable v-max-clu as integer no-undo .
     5599   define buffer buf_cd-clu for ub.cd-clu.
     5600   do
     5601   on error undo, return error return-value
     5602   :
     5603     v-cli-to-send = no.
     5604     v-tot-cli = 0.
     5605     FOR EACH buf_cd-clu WHERE
     5606           buf_cd-clu.obj-type = 'маг':U
     5607       and buf_cd-clu.obj-code =  p-obj-code
     5608       and buf_cd-clu.pos-type =  p-pos-type
     5609       and buf_cd-clu.clu-type =  '':U
     5610       :
     5611       if buf_cd-clu.to-del = yes then do:
     5612         assign
     5613         v-cli-to-send = yes.
     5614       end.
     5615       assign
     5616       v-tot-cli = v-tot-cli + 1.
     5617     end.
     5618     run cd-attr-write  in this-procedure (
     5619                                             input   p-db-num
     5620                                             ,input  p-obj-code
     5621                                             ,input  p-pos-type
     5622                                             ,input  p-cash-num
     5623                                             ,input  'MARIA_operative':U
     5624                                             ,input  'tot-cli':U
     5625                                             ,input ''
     5626                                             ,input ?
     5627                                             ,input 0.0
     5628                                             ,input v-tot-cli
     5629                                             ,input no
     5630                                             ) no-error .
     5631     if error-status:error then do:
     5632         UNDO, RETURN ERROR RETURN-VALUE.
     5633     END.
     5634     run cd-attr-write  in this-procedure (
     5635                                             input   p-db-num
     5636                                             ,input  p-obj-code
     5637                                             ,input  p-pos-type
     5638                                             ,input  p-cash-num
     5639                                             ,input  'MARIA_operative':U
     5640                                             ,input  'cli-to-send':U
     5641                                             ,input ''
     5642                                             ,input ?
     5643                                             ,input 0.0
     5644                                             ,input 0
     5645                                             ,input v-cli-to-send
     5646                                             ) no-error .
     5647     if error-status:error then do:
     5648         UNDO, RETURN ERROR RETURN-VALUE.
     5649     END.
     5650     FIND LAST buf_cd-clu WHERE
     5651             buf_cd-clu.obj-type = 'маг':U
     5652         and buf_cd-clu.obj-code = p-obj-code
     5653         and buf_cd-clu.pos-type = p-pos-type
     5654         and buf_cd-clu.clu-type = '':U
     5655         NO-LOCK use-index pi no-error .
     5656     if available buf_cd-clu then do:
     5657       if v-max-clu < buf_cd-clu.clu-code
     5658       then
     5659       v-max-clu = buf_cd-clu.clu-code.
     5660     end.
     5661     else do:
     5662       v-max-clu = 0.
     5663     end.
     5664     run cd-attr-write  in this-procedure (
     5665                                           input   p-db-num
     5666                                           ,input  p-obj-code
     5667                                           ,input  p-pos-type
     5668                                           ,input  p-cash-num
     5669                                           ,input  'MARIA_operative':U
     5670                                           ,input  'max-clu':U
     5671                                           ,input ''
     5672                                           ,input ?
     5673                                           ,input 0.0
     5674                                           ,input v-max-clu
     5675                                           ,input no
     5676                                           ) no-error .
     5677     if error-status:error then do:
     5678         UNDO, RETURN ERROR RETURN-VALUE.
     5679     END.
     5680   end.
     5681   end procedure.
     5682   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
