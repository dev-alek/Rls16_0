      363   define variable v-cntxt-db-num        as integer   no-undo .
      364   define variable v-cntxt-userid        as character no-undo .
      365   define variable i-obj-code like ub.clients.obj-code no-undo.
      366   define variable p-batch as logical no-undo .
      367   define variable action     as   character no-undo init "U".
      368   define variable p-other    as character no-undo .
      369   define variable onecash    as int no-undo .
      370   assign
      371   i-obj-code = integer(entry(1, p-parameter, chr(4)))
      372   p-batch  = (if entry(2, p-parameter, chr(4)) = "yes"
      373               then yes
      374               else (if entry(2, p-parameter, chr(4)) = "no"
      375                     then no
      376                     else ?)
      377              )
      378   p-other = (if num-entries(p-parameter, chr(4)) > 2
      379              then entry(3, p-parameter, chr(4))
      380              else "":U)
      381   no-error
      382   .
      383   if error-status:error or p-batch = ? then return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      384   if num-entries(p-parameter, chr(4)) > 3
      385      and entry(4, p-parameter, chr(4)) ne ""
      386   then
      387      onecash = int (entry(4, p-parameter, chr(4))) no-error.
      388   if not g#news
      389   and not g#auto then do:
      390   run get-userid in parparentproc ( output v-cntxt-userid) .
      391   run get-db-num in parparentproc ( output v-cntxt-db-num) .
      392   end.
      393   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define shared temp-table gds-list no-undo like ub.goods
      395     field qnty   as decimal
      396     field to-del as logical
      397     field order-num as integer
      398     field to-sel as logical
      399     field promo-code as character
      400     field ActionId  as int64
      401     field db-num as integer
      402     index art  is primary unique artic prod-type prod-code
      403     index code is         unique gds-code
      404     index oi order-num
      405     index isel to-sel
      406     .
      407   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   define  shared  temp-table gds-list-hist no-undo
      409   field list-table as character
      410   field id as integer
      411   field line as integer
      412   field hist-mode as character
      413   field des as character
      414   field num-recs as integer
      415   field option_ as character
      416   field item_ as character
      417   field status_ as character
      418   field num-add as integer
      419   field num-ignored as integer
      420   field done as logical
      421   field err_ as logical
      422   field err-mes as character
      423   index pi is primary
      424   id
      425   line
      426   index isdone
      427   done
      428   .
      429   define variable v-production-only as logical init false.
      430   for each gds-list :
      431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
      432     (input  gds-list.gds-code
      433     ,input  'production-only=request':u
      434     ,output v-production-only
      435     ) no-error .
      436     if error-status :error
      437     then do:
      438       assign v-production-only = no .
      439     end.
      440     if v-production-only
      441     then do :
      442       delete gds-list .
      443     end .
      444   end .
      445   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      446   def new shared var bc-frmt as character no-undo .
      447   def new shared var bc-pfx  as character no-undo .
      448   def var bc-par-type as character no-undo .
      449       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      450       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      451           do:
      452               message "Не задан или не верно задан ТИП собственного бар-кода!"
      453                   view-as alert-box ERROR TITLE "".
      454               return error.
      455           end.
      456       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      457       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      458           do:
      459               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      460                   view-as alert-box ERROR TITLE "".
      461               return error.
      462           end.
      463   PROCEDURE gen-bc:
      464     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      465     def output parameter full-b-code     as character init ""    no-undo .
      466   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467     define variable tmp-str4  as character no-undo.
      468     define variable tmp-num4  as character no-undo.
      469     define variable i4        as integer   no-undo.
      470     define variable sum4      as integer   no-undo.
      471     define variable len-code4 as integer   no-undo.
      472     define variable varcont4  as logical   initial yes no-undo.
      473     CASE bc-frmt :
      474       WHEN "EAN13" THEN do:
      475         assign
      476           tmp-str4 = string( internal-b-code, "999999999999" )
      477         .
      478       end.
      479       WHEN "EAN8" THEN do:
      480         assign
      481           tmp-str4 = string( internal-b-code, "9999999" )
      482         .
      483       end.
      484       OTHERWISE DO:
      485           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      486           view-as alert-box error.
      487           return error.
      488       END.
      489     END CASE.
      490     if varcont4 = yes then do:
      491       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      492       then do:
      493         message
      494           "Невозможно сформировать бар-код" SKIP
      495           "для товара с кодом: " internal-b-code
      496           view-as alert-box error title "подрезание кода".
      497         return error.
      498       end.
      499       else do:
      500         assign
      501           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      502           len-code4    = length( full-b-code )
      503         .
      504         define variable v-sum-char4 as character no-undo .
      505         assign
      506           sum4 = 0
      507         .
      508         do i4 = 1 to len-code4 by 2
      509         :
      510           assign
      511             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      512           .
      513           if v-sum-char4 < "0"
      514           or v-sum-char4 > "9"
      515           then do:
      516             message
      517               "Невозможно сформировать бар-код" skip
      518               "для товара с кодом: " internal-b-code skip
      519               view-as alert-box error title "подсчет контрольной суммы".
      520             return error.
      521           end.
      522           assign
      523             sum4 = sum4 + integer(v-sum-char4)
      524           .
      525         end.
      526         if varcont4 = yes then do:
      527           assign
      528             sum4 = sum4 * 3
      529           .
      530           do i4 = 2 to len-code4 by 2
      531           :
      532             assign
      533               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      534             .
      535             if v-sum-char4 < "0"
      536             or v-sum-char4 > "9"
      537             then do:
      538               message
      539                 "Невозможно сформировать бар-код" skip
      540                 "для товара с кодом: " internal-b-code skip
      541                 view-as alert-box error title "подсчет контрольной суммы".
      542               return error.
      543             end.
      544             assign
      545               sum4 = sum4 + integer(v-sum-char4)
      546             .
      547           end.
      548           if varcont4 = yes then do:
      549              if sum4 mod 10 = 0 then do:
      550                assign
      551                  full-b-code = full-b-code + '0'
      552                .
      553              end.
      554              else do:
      555                assign
      556                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      557                .
      558              end.
      559           end.
      560         end.
      561       end.
      562     end.
      563   END PROCEDURE.
      564   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
