     8295             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     8296         if available buf_temp-dis-gds-rule then do:
     8297             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     8298         end.
     8299       end.
     8300       otherwise do:
