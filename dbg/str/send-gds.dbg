    10932     end.
    10933   end.
    10934   if cash-gds.wd = 1 then do:
    10935      wd-option = 1.
    10936   end.
    10937   if cash-gds.wgd > 0 then do:
    10938     find first cash-dis-rule no-lock where
    10939               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
    10940     if available cash-dis-rule then  do:
    10941       assign
    10942       wgd-option = integer(cash-dis-rule.discnt-value).
    10943     end.
    10944   end.
    10945   if cash-gds.temp-discnt-rule <> 0 then do:
    10946     assign
    10947     temp-disc-dec = 0
    10948     .
    10949     find first cash-dis-rule no-lock where
    10950               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
    10951     if available cash-dis-rule
    10952              and cash-dis-rule.is-term = yes then do:
    10953       if cash-dis-rule.time-rule-num > 0 then do:
    10954         find first cash-dis-time-rule no-lock where
    10955                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10956         if available cash-dis-time-rule
    10957         and cash-dis-time-rule.templ-rl-root = 50001
    10958             or
    10959             (
    10960              (
    10961               (cash-dis-time-rule.date-from < today)
    10962               or
    10963               (cash-dis-time-rule.date-from = 12/31/1989)
    10964              )
    10965             and
    10966             (
    10967              (cash-dis-time-rule.date-to >= today)
    10968              or
    10969              (cash-dis-time-rule.date-to = 12/31/1989)
    10970             )
    10971            ) then do:
    10972            temp-disc-dec = ?.
    10973         end.
    10974         else do:
    10975           assign
    10976           temp-disc-dec = 0
    10977           .
    10978         end.
    10979       end.
    10980       else do:
    10981         temp-disc-dec = ?.
    10982       end.
    10983       if temp-disc-dec = ? then do:
    10984         case cash-dis-rule.value-type:
    10985           when integer('1':U) then do:
    10986         assign
    10987         temp-disc-dec = - cash-dis-rule.discnt-value
    10988         .
    10989       end.
    10990           when integer('11':U) then do:
    10991             find first cash-gds-discnt where
    10992                       cash-gds-discnt.b-code = cash-gds.b-code
    10993                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    10994                   and cash-gds-discnt.obj-type = 'маг':U
    10995                   and cash-gds-discnt.obj-code = i-obj-code
    10996                   no-error.
    10997             if available cash-gds-discnt then do:
    10998               assign
    10999               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
    11000               .
    11001             end.
    11002             else do:
    11003              assign
    11004               temp-disc-dec = 0.
    11005             end.
    11006           end.
    11007           otherwise do:
    11008             temp-disc-dec = 0.
    11009           end.
    11010         end case.
    11011       end.
    11012     end.
    11013   end.
    11014   CASE pos-type:
    11015     when 'MAGIA-XML':U
