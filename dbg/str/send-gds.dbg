    16580               v-is-weight = false
    16581             .
    16582             find buf_goods where buf_goods.gds-code = buf_dis-gds-rule.gds-code no-lock no-error.
    16583             if avail buf_goods then do:
    16584                 find buf_units where buf_units.unit-name = buf_goods.unit-base no-lock no-error.
    16585                 if avail buf_units then do:
