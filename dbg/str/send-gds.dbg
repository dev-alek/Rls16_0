    13736                      AND cash-ncr-save-param.cd-line = substring(ss, 1, 24))
    13737         then do:
    13738           put stream plucash unformatted
    13739           ss skip.
    13740           next _rr.
    13741         end.
    13742         find first buf_cash-ncr-dis-kat no-lock where
    13743                   buf_cash-ncr-dis-kat.dis-kat = - 1
