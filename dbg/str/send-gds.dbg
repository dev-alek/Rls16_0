     6435   procedure fact-order-mpl :
     6436     do
     6437     on error undo, return error return-value
     6438     :
     6439   define input  parameter p-doc-date as date     no-undo .
     6440   define input  parameter p-obj-type as character no-undo .
     6441   define input  parameter p-obj-code as integer   no-undo .
     6442   define output parameter p-fact-order as decimal   no-undo .
     6443   define variable v-fact-date            as date    no-undo .
     6444   define variable v-fact-time            as integer no-undo .
     6445   define variable v-fact-order           as decimal no-undo .
     6446   define variable v-shift-end-fact-order as decimal no-undo .
     6447   define variable v-day-end-fact-order   as decimal no-undo .
     6448   define variable l-shift-on as logical no-undo .
     6449   define variable l-date as date      no-undo .
     6450   define variable l-time as integer   no-undo .
     6451   define variable shift-date as date      no-undo .
     6452   define variable shift-num  as integer   no-undo .
     6453   define variable shift-name as character no-undo .
     6454   define variable max-fact-order as decimal   no-undo .
     6455   define buffer buf_global-state for ub.global-state  .
     6456   find first buf_global-state no-lock no-error .
     6457   if not available buf_global-state then do:
     6458      message
     6459        "Не заданы параметры ценообразования!"
     6460        view-as alert-box error
     6461      .
     6462      return error return-value .
     6463   end.
     6464     run cur-time in this-procedure
     6465     ( output v-fact-date ,
     6466       output v-fact-time  ).
     6467   if p-doc-date = ? then do:
     6468   if buf_global-state.pl-use-sys-date-time  = true then do:
     6469         run factord in this-procedure
     6470           (input  v-fact-date
     6471           ,input  v-fact-time
     6472           ,input  v-fact-time
     6473           ,input  ?
     6474           ,input  ?
     6475           ,input  false
     6476           ,output v-fact-order
     6477           ,output v-shift-end-fact-order
     6478           ,output v-day-end-fact-order
     6479           ) no-error .
     6480         if error-status :error
     6481         or v-fact-order = ?
     6482         or v-fact-order = 0 then do:
     6483           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6484         end.
     6485         p-fact-order = v-fact-order .
     6486   end.
     6487   else do:
     6488   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6490     (input  p-obj-type
     6491     ,input  p-obj-code
     6492     ,input  'shift-on=request'
     6493     ,output l-shift-on
     6494     ) no-error .
     6495         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6496         if p-doc-date <> ? then do:
     6497         end.
     6498          run gbl/factdate.p
     6499          ( input        p-obj-type  ,
     6500            input        p-obj-code  ,
     6501            input-output v-fact-date ,
     6502            input-output v-fact-time ,
     6503            input-output shift-date      ,
     6504            input-output shift-num       ,
     6505            input-output shift-name      ,
     6506            input        yes
     6507            ) no-error .
     6508         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6509         run factord in this-procedure
     6510           (input  v-fact-date
     6511           ,input  v-fact-time
     6512           ,input  v-fact-time
     6513           ,input  shift-date
     6514           ,input  shift-num
     6515           ,input  l-shift-on
     6516           ,output v-fact-order
     6517           ,output v-shift-end-fact-order
     6518           ,output v-day-end-fact-order
     6519           ) no-error .
     6520         if error-status :error
     6521         or v-fact-order = ?
     6522         or v-fact-order = 0 then do:
     6523           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6524         end.
     6525         p-fact-order = v-fact-order .
     6526   end.
     6527   end.
     6528   else do:
     6529          run gbl/factdate.p
     6530          ( input        p-obj-type  ,
     6531            input        p-obj-code  ,
     6532            input-output v-fact-date ,
     6533            input-output v-fact-time ,
     6534            input-output shift-date      ,
     6535            input-output shift-num       ,
     6536            input-output shift-name      ,
     6537            input        yes
     6538            ) no-error .
     6539         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6540         v-fact-date = p-doc-date .
     6541         run factord in this-procedure
     6542           (input  v-fact-date
     6543           ,input  v-fact-time
     6544           ,input  v-fact-time
     6545           ,input  shift-date
     6546           ,input  shift-num
     6547           ,input  l-shift-on
     6548           ,output v-fact-order
     6549           ,output v-shift-end-fact-order
     6550           ,output v-day-end-fact-order
     6551           ) no-error .
     6552         if error-status :error
     6553         or v-fact-order = ?
     6554         or v-fact-order = 0 then do:
     6555           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6556         end.
     6557         p-fact-order = v-fact-order .
     6558   end.
     6559     end.
     6560   end procedure.
     6561   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     6562   field sale-qnty as decimal
     6563   field sale-sum  as decimal
     6564   field sale-tnv  as decimal
     6565   field price-sale-base as decimal
     6566   field price-sale-rubl as decimal
     6567   field road-tax-base   as decimal
     6568   field road-tax-rubl   as decimal
