     3582   procedure alienini-getkey :
     3583   define input parameter i-filename as char.
     3584   define input parameter i-section as char.
     3585   define input parameter i-key as char.
     3586   define output parameter o-value as char.
     3587   define variable EntryPointer as integer no-undo.
     3588   define variable mem1 as memptr no-undo.
     3589   define variable mem2 as memptr no-undo.
     3590   define variable mem1size as integer no-undo.
     3591   define variable mem2size as integer no-undo.
     3592   define variable ii       as integer    no-undo.
     3593   define variable cbReturnSize  as integer    no-undo.
     3594   assign
     3595   set-size(mem1)  = 4000
     3596   mem1size = 4000.
     3597   if i-key = "" then EntryPointer = 0.
     3598   else do:
     3599     assign
     3600     set-size(mem2) = 128
     3601     mem2size = 128
     3602     EntryPointer = get-pointer-value(mem2)
     3603     put-string(mem2, 1) = i-key.
     3604   end.
     3605   run getprivateprofilestringA
     3606                                 (i-section,
     3607                                  EntryPointer,
     3608                                  "",
     3609                                  get-pointer-value(mem1),
     3610                                  input mem1size,
     3611                                  i-filename,
     3612                                  output cbReturnSize).
     3613   do ii = 1 to cbReturnSize:
     3614     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3615                  then o-value + ","
     3616                  else o-value + chr(get-byte(mem1, ii)).
     3617   end.
     3618     set-size(mem1) = 0.
     3619     set-size(mem2) = 0.
     3620   end procedure.
     3621   procedure alienini-putkey :
     3622   define input parameter i-filename as char.
     3623   define input parameter i-section as char.
     3624   define input parameter i-key as char.
     3625   define input parameter i-value as char.
     3626   define variable cbReturnSize as integer.
     3627   run writeprivateprofilestringA
     3628                                  (i-section,
     3629                                   i-key,
     3630                                   i-value,
     3631                                   i-filename,
     3632                                   output cbReturnSize ).
     3633   end procedure.
     3634   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3635     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3636     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3637     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3638     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3639     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3640     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3641     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3642   END PROCEDURE.
     3643   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3644     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3645     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3646     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3647     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3648     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3649   END PROCEDURE.
