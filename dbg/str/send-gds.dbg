    13953       delete temp-tekka-tsk.
    13954     end.
    13955     run write-log-and-file in p-log-handle (
    13956           input 1
    13957         , input log-file-name
    13958         , input 1
    13959         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    13960                              ,for-cash-desk.cash-num
    13961                              ,chr(10)
    13962                              ,return-value
    13963                           )
    13964                                           ).
    13965     assign
    13966     v-view-log = yes
    13967     .
    13968       for each temp-cd-plu:
    13969         delete temp-cd-plu.
    13970       end.
    13971     return "error":U.
