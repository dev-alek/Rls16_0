    11698           run bgelib-tag-put in this-procedure ( input 3, input "IMarkAlc" ,    input string(bb_goods.proof), input 1 ).
    11699           run bgelib-tag-close in this-procedure ( input 2, input "ItemMarkCode").
    11700       end.
    11701   for each buf_cash-gds no-lock where
    11702             buf_cash-gds.main-prt-b-code = cash-gds.main-prt-b-code
    11703         AND buf_cash-gds.obj-type = 'маг':U
    11704         AND buf_cash-gds.obj-code = abs(i-obj-code)
    11705             :
    11706      if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0 and buf_cash-gds.b-str = "" and ub.shop.cd-sc-base  then NEXT.
    11707      if (ub.shop.cd-loc-base = no and buf_cash-gds.is-main-code = yes) then next.
    11708      v-IBCType = 0 .
    11709      if v-mark then do:
    11710          find first buf_prod-bc no-lock where buf_prod-bc.b-code = buf_cash-gds.b-code and buf_prod-bc.bc-on-type = 'GTIN':U
    11711                                           and buf_prod-bc.b-str = buf_cash-gds.b-str no-error .
    11712          if available (buf_prod-bc) then do:
    11713          v-IBCType = 2 .
    11714          end.
    11715          else do:
    11716          find first buf_prod-bc-attr no-lock where buf_prod-bc-attr.b-code = buf_cash-gds.b-code
    11717                                 and buf_prod-bc-attr.b-str = buf_cash-gds.b-str
    11718                                 and buf_prod-bc-attr.attr-code = 'mark':U
    11719                                 no-error .
    11720          if available (buf_prod-bc-attr) and buf_prod-bc-attr.attr-value = "yes" then
    11721            v-IBCType = 1 .
    11722        end.
    11723      end.
    11724     if v-mark and buf_cash-gds.b-str = "" then v-IBCType = 1 .
    11725     find first ub.prod-bc no-lock where ub.prod-bc.b-str = buf_cash-gds.b-str and ub.prod-bc.b-str <> "" and ub.prod-bc.bc-on-type = 'GTIN':U
    11726     no-error .
    11727     define variable vBarCode1 as int no-undo.
    11728     define variable vBarCode2 as int no-undo.
    11729     if available (ub.prod-bc) then do:
    11730       if cash-gds.cli-base-rate eq 1
    11731       then do:
    11732          v-i-cli-qnty = 999999999.
    11733          for each buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11734                                     and buf_bar-code_cl.cli-base-rate ne cash-gds.cli-base-rate
    11735          no-lock:
    11736            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    11737            if v-i-cli-qnty =  buf_bar-code_cl.cli-base-rate
    11738            then
    11739               vBarCode1 = buf_bar-code_cl.b-code.
    11740          end.
    11741          if vaction = "D" and
    11742             v-i-cli-qnty = 999999999
    11743          then do:
    11744             assign
    11745                v-i-cli-qnty = cash-gds.cli-base-rate
    11746                vBarCode1 = cash-gds.main-prt-b-code
    11747                .
    11748          end.
    11749       end.
    11750       else do:
    11751          v-i-cli-qnty = 999999999.
    11752          for first buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    11753                                     and buf_bar-code_cl.cli-base-rate eq 1
