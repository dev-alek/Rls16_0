     8373             cash-gds-discnt.obj-type = parobj-type
     8374             cash-gds-discnt.obj-code = parobj-code
     8375             cash-gds-discnt.discnt-value = v-disc-price-sale
     8376             .
     8377             release cash-gds-discnt.
