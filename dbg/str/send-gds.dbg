     1813   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1814   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1816   procedure disrules-fill-properties:
     1817   define input  parameter p-templ-rl-root as integer   no-undo .
     1818   define buffer buf_drt-prop for ub.drt-prop.
     1819   define buffer buf_temp-drt-prop for temp-drt-prop.
     1820   do
     1821   on error undo, return error return-value
     1822   :
     1823     for each buf_temp-drt-prop:
     1824       delete buf_temp-drt-prop.
     1825     end.
     1826     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1827       create buf_temp-drt-prop.
     1828       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1829     end.
     1830   end.
     1831   end procedure.
     1832   ~
     1833   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1834   procedure discfgru-check :
     1835   define input parameter p-table-name as character no-undo .
     1836   define input parameter p-templ-rl-root as integer no-undo .
     1837   define input parameter p-time-templ-rl-root as integer no-undo .
     1838   define input parameter p-pos-type as character no-undo .
     1839   define output parameter p-disnct-role as character no-undo .
     1840   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1841     do
     1842     on error undo, return error return-value
     1843     :
     1844       find first buf_dis-cfg-rule no-lock where
     1845               buf_dis-cfg-rule.table-name = p-table-name
     1846           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1847           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1848           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1849       if not available buf_dis-cfg-rule
     1850       or p-pos-type = "":U
     1851       then do:
     1852          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1853                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1854                                  , p-templ-rl-root
     1855                                  , (if p-time-templ-rl-root = ?
     1856                                     then '':U
     1857                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1858                                     )
     1859                                  ).
     1860       end.
     1861       assign
     1862       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1863       .
     1864     end.
     1865   end procedure.
     1866   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   FUNCTION get-region RETURNS CHARACTER
     1868     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1869     define variable par-region as character no-undo.
     1870     if parhost-code = 0 and
     1871          parobj-type = "":U and
     1872          parobj-code = 0 then do:
     1873          par-region = "Глобально".
     1874          return par-region.
     1875       end.
     1876       if parobj-type = 'орг':U then do:
     1877          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1878          return par-region.
     1879       end.
     1880       if parobj-type = 'регион':U
     1881       then do:
     1882          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1883          return par-region.
     1884       end.
     1885       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1886       return par-region.
     1887   END FUNCTION.
     1888   FUNCTION get-objregion RETURNS CHARACTER
     1889     (  input parobj-type as character, input parobj-code as integer ) :
     1890     define variable par-region as character no-undo.
     1891     if  parobj-type = "":U and
     1892         parobj-code = 0
     1893     then do:
     1894        par-region = "Глобально".
     1895     end.
     1896     else if parobj-type = 'орг':U
     1897     then do:
     1898        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1899     end.
     1900     else if parobj-type = 'регион':U
     1901     then do:
     1902        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1903     end.
     1904     else
     1905        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1906     return par-region.
     1907   END FUNCTION.
     1908   procedure disgdsru-name :
     1909   define buffer buf_dis-rule for ub.dis-rule.
     1910   do
     1911     on error undo, return error
     1912     :
     1913     define input  parameter p-templ-rl-root  as integer no-undo .
     1914     define output parameter p-label          as character no-undo .
     1915     find first buf_dis-rule no-lock where
     1916               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1917     if available buf_dis-rule
     1918     then do:
     1919       if buf_dis-rule.rule-num > 0 then
     1920       p-label = buf_dis-rule.des.
     1921     end.
     1922     else do:
     1923       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1924     end.
     1925   end.
     1926   end procedure.
     1927   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
