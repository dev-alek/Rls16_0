    11106                               )
    11107                                 ).
    11108       assign
    11109       v-view-log = yes
    11110       .
    11111   end.
    11112   if v-out-code <> 0
    11113   or v-is-modificator
    11114   then do:
    11115     run bgelib-tag-open in this-procedure ( input 2, input "Item", input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U":U then "ADD" else "DEL":U), OS2-time, cash-gds.b-code)).
    11116     run bgelib-tag-put in this-procedure ( input 3, input "ItemName"       , input trim(second-name, chr(32)), input 1 ).
    11117     run bgelib-tag-put in this-procedure ( input 3, input "ItemAltName"    , input trim(chk_name, chr(34)), input 1 ).
    11118     run bgelib-tag-put in this-procedure ( input 3, input "ItemMainPrice"  , input string(0), input 1 ).
