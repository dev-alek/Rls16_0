     1936   end function.
     1937   procedure disgdsru-write :
     1938     do
     1939     on error undo, return error
     1940     :
     1941       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1942       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1943       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1944       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1945       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1946       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1947       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1948       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1949       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1950       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1951       define buffer buf_dis-rule for ub.dis-rule.
     1952       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1953       define variable v-label          as character no-undo .
     1954       define variable v-discnt-role as character no-undo .
     1955       run discfgru-check in this-procedure (
     1956                                             input 'dis-gds-rule':U
     1957                                            ,input p-templ-rl-root
     1958                                            ,input p-time-templ-rl-root
     1959                                            ,input p-pos-type
     1960                                            ,output v-discnt-role
     1961                                             ) no-error .
     1962       if error-status :error then do:
     1963         undo, return error return-value .
     1964       end.
     1965       if p-discnt-role = ? then do:
     1966         p-discnt-role = v-discnt-role.
     1967       end.
     1968       if p-discnt-role <> v-discnt-role then do:
     1969         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1970                                 ,p-gds-code
     1971                                 ,p-obj-type
     1972                                 ,p-obj-code
     1973                                 ,p-pos-type
     1974                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1975                                 ,chr(10)
     1976                                 ,p-templ-rl-root
     1977                                 ,p-rule-num).
     1978       end.
     1979       if p-pos-type = ? then do:
     1980   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1981   define variable v-param-type23 as character no-undo .
     1982   define variable v-value-date23 as date no-undo .
     1983   define variable v-value-decimal23 as decimal no-undo .
     1984   define variable v-value-integer23 as INTEGER no-undo .
     1985   define variable v-value-logical23 AS LOGICAL no-undo .
     1986   define variable v-tth23 as handle no-undo .
     1987   run adm/shattri.p (
     1988       input "get":U
     1989       ,input  p-obj-type
     1990       ,input  p-obj-code
     1991       ,input  'cd-sending':U
     1992       ,input  'dflt-cd':U
     1993       ,output p-pos-type
     1994       ,output v-value-date23
     1995       ,output v-value-decimal23
     1996       ,output v-value-integer23
     1997       ,output v-value-logical23
     1998       ,output v-param-type23
     1999       ,INPUT-OUTPUT table-handle v-tth23
     2000       )  .
     2001   delete object v-tth23 no-error.
     2002       end.
     2003       find first buf_dis-rule no-lock where
     2004                 buf_dis-rule.rule-num = p-rule-num no-error.
     2005       if not available buf_Dis-rule then do:
     2006         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     2007                                 ,p-gds-code
     2008                                 ,p-obj-type
     2009                                 ,p-obj-code
     2010                                 ,p-pos-type
     2011                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2012                                 ,chr(10)
     2013                                 ,p-rule-num).
     2014       end.
     2015       if buf_dis-rule.root <> yes then do:
     2016         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     2017                                 ,p-gds-code
     2018                                 ,p-obj-type
     2019                                 ,p-obj-code
     2020                                 ,p-pos-type
     2021                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2022                                 ,chr(10)
     2023                                 ,p-rule-num).
     2024       end.
     2025       if not (p-obj-type = buf_dis-rule.obj-type
     2026           and p-obj-code = buf_dis-rule.obj-code)
     2027       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     2028                and
     2029                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     2030        then do:
     2031         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     2032                                 ,p-gds-code
     2033                                 ,p-obj-type
     2034                                 ,p-obj-code
     2035                                 ,p-pos-type
     2036                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2037                                 ,chr(10)
     2038                                 ) +
     2039                             substitute("Правило скидки &1 определено для &2&3" +
     2040                                        "а привязка к товару для &4"
     2041                                        ,buf_dis-rule.rule-num
     2042                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     2043                                        ,chr(10)
     2044                                        ,get-objregion( p-obj-type, p-obj-code)
     2045                                        ))
     2046                                 .
     2047       end.
     2048       find first buf_dis-gds-rule exclusive-lock where
     2049                  buf_dis-gds-rule.gds-code  = p-gds-code
     2050              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     2051              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     2052              AND buf_dis-gds-rule.pos-type  = p-pos-type
     2053              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     2054              and buf_dis-gds-rule.nonunique = p-nonunique
     2055              no-error .
     2056       if not available buf_dis-gds-rule then do:
     2057         find first buf_dis-gds-rule exclusive-lock where
     2058                   buf_dis-gds-rule.gds-code  = p-gds-code
     2059               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     2060               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     2061               AND buf_dis-gds-rule.pos-type  = p-pos-type
     2062               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     2063               no-error .
     2064         if available buf_Dis-gds-rule then do:
     2065           if p-nonunique = ''
     2066           and available buf_dis-gds-rule
     2067           then do:
     2068             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     2069                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2070                                      , p-gds-code
     2071                                      , buf_Dis-rule.obj-type
     2072                                      , buf_Dis-rule.obj-code
     2073                                      , p-nonunique
     2074                                     ).
     2075           end.
     2076           if available buf_dis-gds-rule
     2077           and buf_dis-gds-rule.nonunique = ''
     2078           and p-nonunique <> ''then do:
     2079             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     2080                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     2081                                      , p-gds-code
     2082                                      , buf_Dis-rule.obj-type
     2083                                      , buf_Dis-rule.obj-code
     2084                                     ).
     2085           end.
     2086         end.
     2087         create buf_dis-gds-rule .
     2088         assign
     2089         buf_dis-gds-rule.gds-code  = p-gds-code
     2090         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
