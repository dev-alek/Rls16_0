     8325   cash-gds.ean-rz = ''
     8326   cash-gds.code-short = ''
     8327   .
     8328   run ibm-gdsc in this-procedure (input no
     8329                                 , output cash-gds.ean-lz
     8330                                 , output cash-gds.ean-rz
     8331                                 , output cash-gds.code-short
     8332                                 ) no-error .
     8333   if new-good then new-good = not new-good.
     8334   if action = "U" then do:
     8335     if cash-gds.kat-discnt-rule <> 0
     8336     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8337     then do:
     8338       for each cash-dis-rule no-lock where
