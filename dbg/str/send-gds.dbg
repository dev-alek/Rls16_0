    13977                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    13978                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    13979                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    13980                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
