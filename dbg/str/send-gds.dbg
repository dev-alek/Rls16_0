    11546           run bgelib-tag-put in this-procedure ( input 4, input "ITDValue" , input string(temp-disc-dec), input 1 ).
    11547           if temp-disc-start <> ? then
    11548           run bgelib-tag-put in this-procedure ( input 4, input "ITDBeg" , input Xml-CD-DateTimetoString(temp-disc-start, temp-disc-time-start), input 1 ).
    11549           if temp-disc-end <> ? then
    11550           run bgelib-tag-put in this-procedure ( input 4, input "ITDEnd" , input Xml-CD-DateTimetoString(temp-disc-end, temp-disc-time-end), input 1 ).
    11551           run bgelib-tag-put in this-procedure ( input 4, input "ITDReason" , input string(temp-disc-reason), input 1 ).
    11552           run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
    11553         end.
    11554       end.
    11555     end.
    11556     else do:
    11557         run bgelib-tag-open in this-procedure ( input 3, input "ItemTimeDisc", input "" ).
    11558         run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
    11559     end.
    11560     if cash-gds.qnty-discnt-rule <> 0 then do:
    11561       for each cash-dis-rule no-lock where
    11562               cash-dis-rule.upper-rule-num = cash-gds.qnty-discnt-rule
    11563         :
    11564         run bgelib-tag-open in this-procedure ( input 3, input "ItemQtyDisc", input "" ).
