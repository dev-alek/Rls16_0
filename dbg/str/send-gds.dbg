      705   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      707                                                                     input  orders as integer):
      708   define variable  round-m-sum as decimal no-undo.
      709   if orders >= 0 then
      710   round-m-sum = round(mysum,orders).
      711   else
      712   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      713   return round-m-sum.
      714   END FUNCTION.
      715   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   procedure factord :
      717     define input  parameter p-fact-date            as date    no-undo .
      718     define input  parameter p-fact-time            as integer no-undo .
      719     define input  parameter p-fact-num             as integer no-undo .
      720     define input  parameter p-shift-date           as date    no-undo .
      721     define input  parameter p-shift-num            as integer no-undo .
      722     define input  parameter p-shift-on             as logical no-undo .
      723     define output parameter p-fact-order           as decimal no-undo .
      724     define output parameter p-shift-end-fact-order as decimal no-undo .
      725     define output parameter p-day-end-fact-order   as decimal no-undo .
      726     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      727     if p-fact-date = ?
      728     then do:
      729       return error "Не указана фактическая дата" .
      730     end.
      731     define variable v-fact-date-num as integer no-undo .
      732     assign
      733       v-fact-date-num = integer(p-fact-date)
      734     .
      735     if p-fact-num = ?
      736     or p-fact-num = 0
      737     then do:
      738       return error "Не задан p-fact-num " + string(p-fact-num) .
      739     end.
      740     if p-fact-num < 0
      741     then do:
      742       return error "Отрицательный fact-num " + string(p-fact-num) .
      743     end.
      744     if p-fact-num >= 100000000
      745     then do:
      746       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      747     end.
      748     if p-shift-on = true
      749     then do:
      750       if p-shift-date = ?
      751       then do:
      752         return error "Не задана дата смены" .
      753       end.
      754       if p-shift-num = ?
      755       or p-shift-num = 0
      756       then do:
      757         return error "Не задан номер смены" .
      758       end.
      759     end.
      760     else do:
      761       assign
      762         p-shift-date = p-fact-date
      763         p-shift-num  = 24
      764       .
      765     end.
      766     define variable v-shift-offset as integer no-undo .
      767     if p-shift-date = p-fact-date
      768     then do:
      769       assign
      770         v-shift-offset = 1
      771       .
      772     end.
      773     if p-shift-date < p-fact-date
      774     then do:
      775       assign
      776         v-shift-offset = 0
      777       .
      778     end.
      779     if p-shift-date > p-fact-date
      780     then do:
      781       message
      782         vss-workfile vss-revision vss-description skip
      783         "Неправильная дата закрытия смены" skip
      784         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      785         view-as alert-box error .
      786       undo, return error
      787         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      788           ,string(p-fact-date, '99/99/9999':U)
      789           ,string(p-shift-date, '99/99/9999':U)
      790           )
      791       .
      792     end.
      793     if p-shift-num < 1
      794     or p-shift-num > 24
      795     then do:
      796       message
      797         vss-workfile vss-revision vss-description skip
      798         "Неправильный номер смены" skip
      799         "p-shift-num" p-shift-num skip
      800         view-as alert-box error .
      801       undo, return error return-value .
      802     end.
      803     assign
      804       p-fact-order           = v-fact-date-num
      805                              + v-shift-offset * 0.5
      806                              + p-shift-num    * 0.02 - 0.01
      807                              + p-fact-num     * 0.0000000001
      808       p-shift-end-fact-order = v-fact-date-num
      809                              + v-shift-offset * 0.5
      810                              + p-shift-num    * 0.02
      811       p-day-end-fact-order   = v-fact-date-num
      812                              + 0.99
      813     .
      814     if p-fact-order           <= v-fact-date-num
      815     or p-shift-end-fact-order <= v-fact-date-num
      816     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      817     or p-shift-end-fact-order >= p-day-end-fact-order
      818     then do:
      819       message
      820         vss-workfile vss-revision vss-description skip
      821         "Внутренняя ошибка при генерации фактического номера" skip
      822         "p-fact-date"            p-fact-date            skip
      823         "p-fact-time"            p-fact-time            skip
      824         "p-fact-num"             p-fact-num             skip
      825         "p-shift-date"           p-shift-date           skip
      826         "p-shift-num"            p-shift-num            skip
      827         "p-shift-on"             p-shift-on             skip
      828         "p-shift-end-fact-order" p-shift-end-fact-order skip
      829         "p-day-end-fact-order"   p-day-end-fact-order   skip
      830         "v-fact-date-num"        v-fact-date-num        skip
      831         view-as alert-box error .
      832       undo, return error return-value .
      833     end.
      834   end procedure.
      835   procedure day-begin-fact-order :
      836     define input  parameter p-fact-date            as date    no-undo .
      837     define output parameter p-day-begin-fact-order as decimal no-undo .
      838     do
      839     on error undo, return error return-value
      840     :
      841       if p-fact-date = ?
      842       then do:
      843         assign
      844           p-day-begin-fact-order = 0
      845         .
      846       end.
      847       else do:
      848         assign
      849           p-day-begin-fact-order = integer(p-fact-date)
      850         .
      851       end.
      852     end.
      853   end procedure.
      854   procedure factord-max-fact-order :
      855     define output parameter p-max-fact-order as decimal   no-undo .
      856     do
      857     on error undo, return error return-value
      858     :
      859       run day-begin-fact-order in this-procedure
      860         (input  date(1, 1, 5000)
      861         ,output p-max-fact-order
      862         ) .
      863     end.
      864   end procedure.
      865   procedure factord-cut-archive :
      866     define input  parameter p-obj-type             as character no-undo .
      867     define input  parameter p-obj-code             as integer   no-undo .
      868     define input  parameter p-fact-date            as date      no-undo .
      869     define output parameter p-shift-on             as logical   no-undo .
      870     define output parameter p-shift-date           as date      no-undo .
      871     define output parameter p-shift-num            as integer   no-undo .
      872     define output parameter p-day-end-fact-order   as decimal   no-undo .
      873     define output parameter p-shift-end-fact-order as decimal   no-undo .
      874     define variable v-fact-order as decimal   no-undo .
      875     define buffer buf_shift-obj for ub.shift-obj .
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,input  'shift-on=request'
      884     ,output p-shift-on
      885     ) no-error .
      886       if error-status :error
      887       then do:
      888         message
      889           vss-workfile vss-revision vss-description skip
      890           "Ошибка при определении атрибута объекта" skip
      891           "Объект" p-obj-type p-obj-code skip
      892           error-status :get-message(1) skip
      893           return-value skip
      894           view-as alert-box error .
      895         undo, return error return-value .
      896       end.
      897       if p-shift-on = false
      898       then do:
      899         assign
      900           p-shift-date               = ?
      901           p-shift-num                = 0
      902         .
      903       end.
      904       else do:
      905         find first buf_shift-obj share-lock
      906           where buf_shift-obj.obj-type   = p-obj-type
      907             and buf_shift-obj.obj-code   = p-obj-code
      908             and buf_shift-obj.shift-date > p-fact-date
      909           use-index pi
      910           no-error .
      911         if not available buf_shift-obj
      912         or buf_shift-obj.status_ <> 'зкр':U
      913         then do:
      914           message
      915             vss-workfile vss-revision vss-description skip
      916             "Невозможно вычислить последнюю смену" skip
      917             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      918             "Объект" p-obj-type p-obj-code skip
      919             "Дата" p-fact-date skip
      920             view-as alert-box error .
      921           undo, return error return-value .
      922         end.
      923         find last buf_shift-obj share-lock
      924           where buf_shift-obj.obj-type = p-obj-type
      925             and buf_shift-obj.obj-code = p-obj-code
      926             and buf_shift-obj.shift-date <= p-fact-date
      927           use-index pi
      928           no-error .
      929         if available buf_shift-obj
      930         then do:
      931           if  buf_shift-obj.status_ = 'зкр':U
      932           then do:
      933             assign
      934               p-shift-date = buf_shift-obj.shift-date
      935               p-shift-num  = buf_shift-obj.shift-num
      936             .
      937           end.
      938           else do:
      939             message
      940               vss-workfile vss-revision vss-description skip
      941               "Невозможно вычислить последнюю смену" skip
      942               "Статус смены отличен от статуса" 'зкр':U skip
      943               "Объект" p-obj-type p-obj-code skip
      944               "Дата" p-fact-date skip
      945               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      946               view-as alert-box error .
      947             undo, return error return-value .
      948           end.
      949         end.
      950         else do:
      951           assign
      952             p-shift-date = p-fact-date - 1
      953             p-shift-num  = 1
      954           .
      955         end.
      956       end.
      957       run factord in this-procedure
      958         (input  p-fact-date
      959         ,input  1
      960         ,input  1
      961         ,input  p-shift-date
      962         ,input  p-shift-num
      963         ,input  p-shift-on
      964         ,output v-fact-order
      965         ,output p-shift-end-fact-order
      966         ,output p-day-end-fact-order
      967         ) no-error .
      968       if error-status :error
      969       then do:
      970         message
      971           vss-workfile vss-revision vss-description skip
      972           "Ошибка при вызове процедуры factord"
      973           error-status :get-message(1) skip
      974           return-value skip
      975           view-as alert-box error .
      976         undo, return error return-value .
      977       end.
      978     end.
      979   end procedure.
      980   procedure factord-lock-shift :
      981     define input  parameter p-obj-type  as character no-undo .
      982     define input  parameter p-obj-code  as integer   no-undo .
      983     define input  parameter p-fact-date as date      no-undo .
      984     define parameter buffer buf_shift-obj for ub.shift-obj .
      985     define variable v-shift-on      as logical   no-undo .
      986     define variable v-extra-message as character no-undo .
      987     define variable v-error as character no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      993     (input  p-obj-type
      994     ,input  p-obj-code
      995     ,input  'shift-on=request'
      996     ,output v-shift-on
      997     ) no-error .
      998       if error-status :error
      999       then do:
     1000         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1001         undo, return error v-error .
     1002       end.
     1003       if v-shift-on = true
     1004       then do:
     1005         find first buf_shift-obj share-lock
     1006           where buf_shift-obj.obj-type   = p-obj-type
     1007             and buf_shift-obj.obj-code   = p-obj-code
     1008             and buf_shift-obj.shift-date > p-fact-date
     1009           use-index pi
     1010           no-error .
     1011         if not available buf_shift-obj
     1012         or buf_shift-obj.status_ <> 'зкр':U
     1013         then do:
     1014           find last buf_shift-obj
     1015             where buf_shift-obj.obj-type = p-obj-type
     1016               and buf_shift-obj.obj-code = p-obj-code
     1017               and buf_shift-obj.status_  = 'зкр':U
     1018             use-index stts
     1019             no-error .
     1020           if available buf_shift-obj
     1021           then do:
     1022             assign
     1023               v-extra-message =
     1024                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1025                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1026                               )
     1027             .
     1028           end.
     1029           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1030           undo, return error v-error .
     1031         end.
     1032       end.
     1033     end.
     1034   end procedure.
     1035   procedure factord-end-day :
     1036     define input  parameter p-fact-date            as date    no-undo .
     1037     define output parameter p-day-end-fact-order   as decimal no-undo .
     1038     do
     1039     on error undo, return error return-value
     1040     :
     1041       if p-fact-date = ?
     1042       then do:
     1043         return error "Не указана фактическая дата" .
     1044       end.
     1045       assign
     1046         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1047       .
     1048     end.
     1049   end procedure.
     1050   procedure factord-to-date :
     1051     define input  parameter p-fact-order as decimal no-undo .
     1052     define output parameter p-fact-date  as date    no-undo .
     1053     define variable v-ref-date  as date      no-undo .
     1054     define variable v-ref-delta as integer   no-undo .
     1055     do
     1056     on error undo, return error return-value
     1057     :
     1058       if p-fact-order = ?
     1059       or p-fact-order = 0
     1060       then do:
     1061         return error "Не указан fact-order" .
     1062       end.
     1063       assign
     1064         v-ref-date  = date(1, 1, 2000)
     1065       .
     1066       assign
     1067         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1068       .
     1069       assign
     1070         p-fact-date = v-ref-date + v-ref-delta
     1071       .
     1072     end.
     1073   end procedure.
     1074   procedure factord-to-fact-num :
     1075     define input  parameter p-fact-order as decimal no-undo .
     1076     define output parameter p-fact-num   as integer no-undo .
     1077     define variable v-fact-order-trunc as decimal no-undo .
     1078     do
     1079     on error undo, return error return-value
     1080     :
     1081       if p-fact-order = ?
     1082       or p-fact-order = 0
     1083       then do:
     1084         return error "Не указан fact-order" .
     1085       end.
     1086       assign
     1087        v-fact-order-trunc = truncate(p-fact-order, 2)
     1088       .
     1089       assign
     1090         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1091       .
     1092     end.
     1093   end procedure.
     1094   procedure factord-to-shift-num :
     1095     define input  parameter p-fact-order as decimal no-undo .
     1096     define output parameter p-shift-num   as integer no-undo .
     1097     define variable  p-shift-numd  as decimal   no-undo .
     1098     define variable v-fact-order-trunc as decimal no-undo .
     1099     do
     1100     on error undo, return error return-value
     1101     :
     1102       if p-fact-order = ?
     1103       or p-fact-order = 0
     1104       then do:
     1105         return error "Не указан fact-order" .
     1106       end.
     1107       assign
     1108        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1109       .
     1110       if v-fact-order-trunc < 0.5 then do:
     1111         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1112       end.
     1113       assign
     1114         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1115         .
     1116        assign
     1117         p-shift-num = truncate (p-shift-numd , 0)
     1118       .
     1119     end.
     1120   end procedure.
     1121   define new global shared variable g#lib-trn  as handle no-undo .
     1122   define new global shared variable g#lib-trn2 as handle no-undo .
     1123   define new global shared variable g#lib-trn3 as handle no-undo .
     1124   define new global shared variable g#lib-trn4 as handle no-undo .
     1125   define temp-table  tt-tax no-undo
     1126     field tax-code    like ub.tax.tax-code
     1127     field individual  like ub.tax.individual
     1128     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
     1129     field rate-code   like ub.tax-rate.rate-code
     1130     field rate-name   like ub.tax-rate.rate-name format "x(12)"
     1131     field tax-type    like ub.tax.tax-type
     1132     field rate-value  like ub.tax-rate-value.rate-value
     1133     field tax-rate-gds-rc  as recid
     1134     field to-cashdesk like ub.tax.to-cashdesk
     1135     index tax-code is unique primary tax-code
     1136     .
     1137   procedure tax-val :
     1138     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
     1139     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
     1140     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
     1141     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
     1142     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
     1143     define input  parameter       parunits-type like ub.units.type         no-undo.
     1144     define input  parameter       parrec-id     as recid                   no-undo.
     1145     define input  parameter       paris-log     as logical                 no-undo.
     1146     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
     1147     define input  parameter       vattaxcdvalue as integer                 no-undo.
     1148     define input  parameter       exctaxcdvalue as integer                 no-undo.
     1149     define input  parameter       only-check    as logical                 no-undo.
     1150     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
     1151     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
     1152     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
     1153     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
     1154     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
     1155     define output parameter       parerr-mes    as character               no-undo.
     1156     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1161   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1162   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1163   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1164   define variable gp-excise     like ub.price-list.excise     no-undo.
     1165   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1166   define variable gp-fact-order as decimal   no-undo .
     1167   define variable gp-price-sale-parts as decimal   no-undo .
     1168       define buffer buf_tax          for ub.tax .
     1169       define buffer buf_tax-rate     for ub.tax-rate .
     1170       define buffer buf_tax-units    for ub.tax-units .
     1171       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
     1172       define buffer buf_goods        for ub.goods .
     1173       define buffer buf_bar-code     for ub.bar-code .
     1174       define buffer buf_prod-bc      for ub.prod-bc .
     1175       define buffer buf_units        for ub.units .
     1176       define buffer buf_shop         for ub.shop .
     1177       define buffer buf_store        for ub.store .
     1178       define buffer buf_gds-prt      for ub.gds-prt .
     1179       define buffer buf_tt-tax       for tt-tax .
     1180       define variable varrate-value    as decimal   initial ? no-undo.
     1181       define variable pr-list-recid    as recid     initial ? no-undo.
     1182       define variable varmes           as character no-undo.
     1183       define variable varfactorrtvalue as char      initial ? no-undo.
     1184       define variable varfactorrttype  as char      initial ? no-undo.
     1185       define variable is-petrolium     as logical no-undo.
     1186       define variable is-pieces        as logical no-undo.
     1187       define variable vargds-code      like ub.goods.gds-code no-undo.
     1188       define variable pargds-code      like ub.goods.gds-code no-undo.
     1189       define variable var-fact-order   as decimal no-undo .
     1190       define variable currate-code     like buf_tax-rate.rate-code no-undo .
     1191       define variable currate-name     like buf_tax-rate.rate-name no-undo .
     1192       define variable currate-gds-rc   as recid no-undo .
     1193       define variable v-today          as date no-undo .
     1194       define variable v-time           as integer no-undo .
     1195       for each buf_tt-tax:
     1196         delete buf_tt-tax.
     1197       end.
     1198       run cur-time in this-procedure(output v-today, output v-time).
     1199       run factord-end-day in this-procedure (input v-today, output var-fact-order).
     1200       if parartic     = ?
     1201       or parprod-type = ?
     1202       or parprod-code = ?
     1203       or parunit-base = ?
     1204       then do:
     1205         find first buf_goods no-lock
     1206           where recid(buf_goods) = parrec-id
     1207           no-error .
     1208       end.
     1209       else do:
     1210         find first buf_goods no-lock
     1211           where buf_goods.artic = parartic
     1212             and buf_goods.prod-type = parprod-type
     1213             and buf_goods.prod-code = parprod-code
     1214           no-error .
     1215       end.
     1216       if not available buf_goods then do:
     1217         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
     1218         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1219       end.
     1220       assign
     1221         parartic     = buf_goods.artic
     1222         parprod-type = buf_goods.prod-type
     1223         parprod-code = buf_goods.prod-code
     1224         parunit-base = buf_goods.unit-base
     1225         pargds-code  = buf_goods.gds-code
     1226       .
     1227       if parunits-type = ?
     1228       then do:
     1229         find buf_units no-lock
     1230           where buf_units.unit-name = parunit-base
     1231           no-error .
     1232         if not available buf_units then do:
     1233           assign
     1234             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
     1235           .
     1236           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1237         end.
     1238         assign
     1239           parunits-type = buf_units.type
     1240         .
     1241       end.
     1242       if parhost-code = ?
     1243       or parhost-code = 0
     1244       then do:
     1245   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1247     (input  parobj-type
     1248     ,input  abs(parobj-code)
     1249     ,output parhost-code
     1250     ) no-error .
     1251         if error-status :error then do:
     1252           assign
     1253             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
     1254               ,string(parobj-type)
     1255               ,string(parobj-code)
     1256               ) + chr(10)
     1257           .
     1258           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1259         end.
     1260       end.
     1261       assign
     1262         vargds-code = buf_goods.gds-code
     1263       .
     1264       for each buf_tax-units no-lock
     1265         where LOOKUP(buf_tax-units.type, parunits-type) > 0
     1266       ,first buf_tax no-lock
     1267         where buf_tax.tax-code = buf_tax-units.tax-code
     1268       :
     1269         find first buf_tt-tax where
     1270                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
     1271         if not available buf_tt-tax then do:
     1272           create buf_tt-tax .
     1273         end.
     1274         assign
     1275           buf_tt-tax.tax-code = buf_tax.tax-code
     1276         .
     1277         if buf_tax.individual = false then do:
     1278           assign
     1279             currate-gds-rc = ?
     1280           .
     1281           _tax-rate-gds:
     1282           for each buf_tax-rate-gds no-lock where
     1283                   buf_tax-rate-gds.gds-code = pargds-code and
     1284                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
     1285           first buf_tax-rate where
     1286                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
     1287                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
     1288           by buf_tax-rate-gds.host-code
     1289           by buf_tax-rate-gds.obj-type
     1290           by buf_tax-rate-gds.obj-code
     1291           by buf_tax-rate-gds.fact-order
     1292           :
     1293             if buf_tax-rate-gds.fact-order > var-fact-order then do:
     1294               next _tax-rate-gds.
     1295             end.
     1296             if buf_tax-rate-gds.host-code = 0 or
     1297               ((buf_tax-rate-gds.host-code = parhost-code) or
     1298               (buf_tax-rate-gds.obj-type = parobj-type AND
     1299               buf_tax-rate-gds.obj-code = parobj-code))
     1300             then do:
     1301               assign
     1302               currate-code = buf_tax-rate.rate-code
     1303               currate-name = buf_tax-rate.rate-name
     1304               currate-gds-rc = recid(buf_tax-rate)
     1305               .
     1306             end.
     1307             else do:
     1308               next _tax-rate-gds.
     1309             end.
     1310           end.
     1311           if currate-gds-rc = ? then do:
     1312             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
     1313                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1314                             chr(10).
     1315             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1316           end.
     1317         end.
     1318         assign
     1319           buf_tt-tax.rate-code   = currate-code
     1320           buf_tt-tax.individual  = buf_tax.individual
     1321           buf_tt-tax.tax-name    = buf_tax.tax-name
     1322           buf_tt-tax.rate-name   = currate-name
     1323           buf_tt-tax.tax-type    = buf_tax.tax-type
     1324           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
     1325           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
     1326         .
     1327       end.
     1328       if parprice-sale = ?
     1329       or parexcise     = ?
     1330       or parroad-tax   = ?
     1331       then do:
     1332         if parnode-code = ? then do:
     1333             FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1334             parnode-code = buf_gds-prt.node-code.
     1335         end.
     1336   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   gp-fact-order = 0 .
     1338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1339     (input  vargds-code
     1340     ,input  parnode-code
     1341     ,output gp-b-code
     1342     ) no-error .
     1343   if error-status:error then do:
     1344     message
     1345       error-status :get-message(1) skip
     1346       return-value skip
     1347       view-as alert-box error .
     1348     return error.
     1349   end.
     1350   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1352     (input  parobj-type
     1353     ,input  parobj-code
     1354     ,input  gp-b-code
     1355     ,input  0
     1356     ,input  gp-fact-order
     1357     ,output gp-doc-num
     1358     ,output gp-price-sale
     1359     ,output gp-road-tax
     1360     ,output gp-excise
     1361     ) no-error .
     1362   if error-status:error then do:
     1363     return error.
     1364   end.
     1365   gp-price-sale-parts = gp-price-sale.
     1366   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1368     (input  parobj-type
     1369     ,input  parobj-code
     1370     ,input  gp-b-code
     1371     ,input  0
     1372     ,input  gp-fact-order
     1373     ,output gp-doc-num
     1374     ,output gp-price-sale-parts
     1375     ,output gp-road-tax
     1376     ,output gp-excise
     1377     ) no-error .
     1378   if error-status:error then do:
     1379     return error.
     1380   end.
     1381   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1382       gp-price-sale = gp-price-sale-parts.
     1383    end.
     1384         assign
     1385           parprice-sale = gp-price-sale
     1386           parexcise     = gp-excise
     1387           parroad-tax   = gp-road-tax
     1388         .
     1389       end.
     1390       if only-check then do:
     1391         return .
     1392       end.
     1393       for each buf_tt-tax no-lock
     1394       on error undo, return error
     1395       :
     1396         if buf_tt-tax.tax-rate-gds-rc = ? then NEXT.
     1397         if not buf_tt-tax.individual then do:
     1398   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1400     (input  ?
     1401     ,input  buf_tt-tax.tax-code
     1402     ,input  buf_tt-tax.rate-code
     1403     ,input  ?
     1404     ,input  parhost-code
     1405     ,input  parobj-type
     1406     ,input  parobj-code
     1407     ,output varrate-value
     1408     ) no-error .
     1409           if error-status:error or varrate-value = ? then do:
     1410             assign varmes = "Не найдена величина ставки налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name + " " + string(buf_tt-tax.rate-code) +
     1411                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1412                             " фирма: " + string(parhost-code) +
     1413                             " объект: " + parobj-type + " " + string(parobj-code) + chr(10).
     1414             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1415           end.
     1416           assign
     1417           buf_tt-tax.rate-value  = varrate-value
     1418           .
     1419         end.
     1420         else do:
     1421           if not avail buf_gds-prt then
     1422           FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1423   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1424     (
     1425        input buf_goods.artic
     1426     ,  input buf_goods.prod-type
     1427     ,  input buf_goods.prod-code
     1428     , output is-petrolium
     1429     , output is-pieces
     1430     ) no-error.
     1431           if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U then do:
     1432             find FIRST buf_prod-bc where
     1433                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1434                         buf_prod-bc.bc-on = yes no-lock no-error.
     1435             if not available buf_prod-bc then do:
     1436               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1437                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1438               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1439             end.
     1440           end.
     1441           else do:
     1442             find buf_bar-code where
     1443                   buf_bar-code.gds-code  = vargds-code     and
     1444                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1445                   buf_bar-code.part-code = ""           and
     1446                   buf_bar-code.in-code   = ""           and
     1447                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1448             if not available buf_bar-code then do:
     1449               assign varmes = "Не найден бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1450                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1451               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1452             end.
     1453           end.
     1454           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1455             ASSIGN
     1456             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1457                                   then integer(buf_prod-bc.b-str)
     1458                                   else buf_bar-code.b-code
     1459             buf_tt-tax.rate-value  = parroad-tax
     1460             buf_tt-tax.tax-rate-gds-rc  = ?
     1461             NO-ERROR.
     1462           end.
     1463           if buf_tt-tax.tax-code = exctaxcdvalue then do:
     1464             ASSIGN
     1465             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1466                                   then integer(buf_prod-bc.b-str)
     1467                                   else buf_bar-code.b-code
     1468             buf_tt-tax.rate-value  = parexcise
     1469             buf_tt-tax.tax-rate-gds-rc  = ?
     1470             NO-ERROR.
     1471           end.
     1472         end.
     1473       end.
     1474     end.
     1475   end procedure.
