     6716     ,output v-host-code
     6717     )  .
     6718   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6719   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6720     (input  v-host-code
     6721     ,input  to-day
     6722     ,output v-base-rate0
     6723     ,output v-base-scale0
     6724     )  .
     6725     v-cli-oborot-ALL  = 0 .
     6726     for each buf_turnover-buyer-main no-lock  where
     6727              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6728              buf_turnover-buyer-main.cli-code = p-cli-code
     6729              :
     6730              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6731     end.
     6732   for each buf_price-all no-lock where
     6733            buf_price-all.obj-type = p-obj-type and
     6734            buf_price-all.obj-code = p-obj-code and
     6735            buf_price-all.gds-code = buf_goods.gds-code and
     6736            buf_price-all.status_  = 'акт':U  and
     6737          ( p-only-b-code = false   or
     6738          ( buf_price-all.b-code = p-main-b-code or
     6739            buf_price-all.b-code = p-b-code))    and
     6740           ( p-only-b-code = true  or
     6741             buf_price-all.b-code = p-b-code)
     6742             and
     6743             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6744           ( buf_price-all.fact-order-sys-to = ? or
     6745             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6746           :
     6747            v-interv   = "" .
     6748            v-grp-name = "" .
     6749            v-pay-name = "" .
     6750            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6751            if buf_price-all.bgr-id > 0 then do:
     6752               find first buf_buyer-group no-lock where
     6753                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6754                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6755               if available buf_buyer-group then do:
     6756                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6757                  find first buf_buyer-in-buyer-group no-lock where
     6758                             buf_buyer-in-buyer-group.stts         = 0 and
     6759                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6760                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6761                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6762                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6763                             no-error .
     6764                             if not available buf_buyer-in-buyer-group then do:
     6765                                v-grp-name = "".
     6766                                next.
     6767                             end.
     6768                             v-grp-name = buf_buyer-group.name .
     6769                  end.
     6770               end.
     6771               else do:
     6772                    v-grp-name = "".
     6773                    next.
     6774               end.
     6775            end.
     6776            if buf_price-all.tog-id > 0 then do:
     6777               find first buf_turnover-group no-lock where
     6778                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6779                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6780               if available buf_turnover-group then do:
     6781                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6782                     v-cli-oborot = v-cli-oborot-all  .
     6783                     find first buf1_tnv-in-turnover-group no-lock where
     6784                                buf1_tnv-in-turnover-group.stts       =  0     and
     6785                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6786                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6787                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6788                     find first buf2_tnv-in-turnover-group no-lock where
     6789                                buf2_tnv-in-turnover-group.stts       =  0     and
     6790                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6791                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6792                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6793                     if not (available buf1_tnv-in-turnover-group and
     6794                             available buf2_tnv-in-turnover-group ) then do:
     6795                             v-grp-name = "".
     6796                             next .
     6797                     end.
     6798                     v-grp-name = buf_turnover-group.name.
     6799                  end.
     6800               end.
     6801               else do:
     6802                    v-grp-name = "".
     6803                    next.
     6804               end.
     6805            end.
     6806            if buf_price-all.plt-fix-cource-crc-base = true then
     6807               assign
     6808                 v-base-rate  = buf_price-all.pdf-base-rate
     6809                 v-base-scale = buf_price-all.pdf-base-scale
     6810               .
     6811               else
     6812               assign
     6813                 v-base-rate  = v-base-rate0
     6814                 v-base-scale = v-base-scale0
     6815               .
     6816            if buf_price-all.plt-fix-cource-crc-doc = true then
     6817               assign
     6818                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6819                 v-exch-scale = buf_price-all.pdf-exch-scale
     6820               .
     6821               else do:
     6822   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6824     (input  buf_price-all.curr-code
     6825     ,input  to-day
     6826     ,output v-exch-rate0
     6827     ,output v-exch-scale0
     6828     ,output v-curr-abbr
     6829     )  .
     6830               assign
     6831                 v-exch-rate  = v-exch-rate0
     6832                 v-exch-scale = v-exch-scale0
     6833                 .
     6834              end.
     6835              v-date-1 = date ( "" )  .
     6836              if buf_price-all.fact-order-sys-from > 0 then do:
     6837                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6838                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6839                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6840              end.
     6841              v-date-2 =  date ( "" )  .
     6842              if buf_price-all.fact-order-sys-to > 0 then do:
     6843                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6844                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6845                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6846              end.
     6847              if buf_price-all.qnty-from <> ? then do :
     6848                 if not (
     6849                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6850                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6851                 ) then do:
     6852                        v-interv = "".
     6853                        next.
     6854                 end.
     6855                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6856              end.
     6857              if buf_price-all.sum-from <> ? then do :
     6858                 if not (
     6859                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6860                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6861                 ) then do:
     6862                    v-interv = "".
     6863                    next.
     6864                 end.
     6865                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6866              end.
     6867              if buf_price-all.turnover-from <> ? then do :
     6868                 if not (
     6869                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6870                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6871                 ) then do:
     6872                    v-interv = "".
     6873                    next.
     6874                 end.
     6875                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6876              end.
     6877              if buf_price-all.use-pay-type = 1 then do :
     6878                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6879                    v-pay-name = "" .
     6880                    next.
     6881                  end.
     6882                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6883              end.
     6884              if buf_price-all.use-cash-pay = 1 then do :
     6885                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6886                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6887                   v-pay-name = "" .
     6888                   next.
     6889                 end.
     6890                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6891              end.
     6892             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6893             create tt_price-all .
     6894             buffer-copy buf_price-all to tt_price-all
     6895             assign
     6896               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6897               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6898               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6899               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6900               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6901               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6902               tt_price-all.price-sale     = buf_price-all.price-sale
     6903               tt_price-all.road-tax       = buf_price-all.road-tax
     6904               tt_price-all.excise         = buf_price-all.excise
     6905               tt_price-all.pdf-exch-rate   = v-exch-rate
     6906               tt_price-all.pdf-exch-scale  = v-exch-scale
     6907               tt_price-all.pdf-base-rate   = v-base-rate
     6908               tt_price-all.pdf-base-scale  = v-base-scale
     6909               tt_price-all.grp-name        = v-grp-name
     6910               tt_price-all.date-1          = v-date-1
     6911               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6912               tt_price-all.time-1          = buf_price-all.start-sys-time
     6913               tt_price-all.date-2          = v-date-2
     6914               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6915               tt_price-all.time-2          = buf_price-all.end-sys-time
     6916               tt_price-all.interv-name     = v-interv
     6917               tt_price-all.pay-name        = v-pay-name
     6918               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6919             .
     6920   end.
     6921   define variable vt-plt-id as integer   no-undo .
     6922   define variable vt-plt-db as integer   no-undo .
     6923   define variable vt-pdf-id as integer   no-undo .
     6924   define variable vt-pdf-db as integer   no-undo .
     6925   define buffer neos_price-all for tt_price-all  .
     6926   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6927       if available tt_price-all then do:
     6928        assign
     6929          vt-plt-id = tt_price-all.plt-id
     6930          vt-plt-db = tt_price-all.plt-db-num
     6931          vt-pdf-id = tt_price-all.pdf-id
     6932          vt-pdf-db = tt_price-all.pdf-db
     6933        .
     6934        if tt_price-all.b-code = p-b-code then do:
     6935             assign
     6936               p-plt-id           = tt_price-all.plt-id
     6937               p-plt-db-num       = tt_price-all.plt-db-num
     6938               p-pdf-id           = tt_price-all.pdf-id
     6939               p-pdf-db-num       = tt_price-all.pdf-db
     6940               p-sale-price-base  = tt_price-all.price-sale-base
     6941               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6942               p-road-tax-base    = tt_price-all.road-tax-base
     6943               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6944               p-excise-base      = tt_price-all.excise-base
     6945               p-excise-rubl      = tt_price-all.excise-rubl
     6946               .
     6947        end.
     6948        else do:
     6949          find first neos_price-all where
     6950                     neos_price-all.b-code     = p-b-code  and
     6951                     neos_price-all.plt-id     = vt-plt-id and
     6952                     neos_price-all.plt-db-num = vt-plt-db and
     6953                     neos_price-all.pdf-id     = vt-pdf-id and
     6954                     neos_price-all.pdf-db     = vt-pdf-db
     6955                     use-index pi no-error .
     6956            if available neos_price-all then do:
     6957             assign
     6958               p-plt-id           = tt_price-all.plt-id
     6959               p-plt-db-num       = tt_price-all.plt-db-num
     6960               p-pdf-id           = tt_price-all.pdf-id
     6961               p-pdf-db-num       = tt_price-all.pdf-db
     6962               p-sale-price-base  = neos_price-all.price-sale-base
     6963               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6964               p-road-tax-base    = neos_price-all.road-tax-base
     6965               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6966               p-excise-base      = neos_price-all.excise-base
     6967               p-excise-rubl      = neos_price-all.excise-rubl
     6968               .
     6969            end.
     6970            else do:
     6971                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6972                 if error-status :error    then do:
     6973                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6974                   return error return-value .
     6975                 end.
     6976             assign
     6977               p-plt-id           = tt_price-all.plt-id
     6978               p-plt-db-num       = tt_price-all.plt-db-num
     6979               p-pdf-id           = tt_price-all.pdf-id
     6980               p-pdf-db-num       = tt_price-all.pdf-db
     6981               p-sale-price-base  = tt_price-all.price-sale-base
     6982               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6983               p-road-tax-base    = tt_price-all.road-tax-base
     6984               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6985               p-excise-base      = tt_price-all.excise-base
     6986               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6987               .
     6988            end.
     6989        end.
     6990     end.
     6991   end.
     6992   end procedure.
     6993   procedure mpl-tpl-auto :
     6994   define input  parameter p-b-code     as integer   no-undo .
     6995   define input  parameter p-obj-type   as character no-undo .
     6996   define input  parameter p-obj-code   as integer   no-undo .
     6997   define input  parameter p-plt-id     as integer   no-undo .
     6998   define input  parameter p-plt-db-num as integer   no-undo .
     6999   define input  parameter p-fact-order as decimal   no-undo .
     7000   define output parameter p-sale-price as decimal   no-undo .
     7001   define output parameter p-pdf-id     as integer   no-undo .
     7002   define output parameter p-pdf-db-num as integer   no-undo .
     7003     do
     7004     on error undo, return error return-value
     7005     :
     7006   if p-fact-order = ? then do:
     7007     run fact-order-mpl (
     7008         input   today       ,
     7009         input   p-obj-type  ,
     7010         input   p-obj-code  ,
     7011         output  p-fact-order ) .
     7012   end.
     7013   assign
     7014     p-pdf-id      = ?
     7015     p-pdf-db-num  = ?
     7016     p-sale-price  = ?
     7017   .
     7018   define buffer buf_bar-code for ub.bar-code  .
     7019   define buffer buf_goods for ub.goods  .
     7020   find first buf_bar-code no-lock where
     7021              buf_bar-code.b-code = p-b-code
     7022              no-error .
     7023   if error-status :error then return error return-value .
     7024   find first buf_goods no-lock where
     7025              buf_goods.gds-code = buf_bar-code.gds-code
     7026              no-error .
     7027   if error-status :error then return error return-value .
     7028   define variable v-main-b-code as integer   no-undo .
     7029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7030     (input  buf_goods.gds-code
     7031     ,input  ?
     7032     ,output v-main-b-code
     7033     )  .
     7034   define buffer buf_price-all for ub.price-all  .
     7035   for each tt_price-all : delete tt_price-all. end.
     7036       for each buf_price-all no-lock where
     7037               buf_price-all.plt-id     = p-plt-id                 and
     7038               buf_price-all.plt-db-num = p-plt-db-num             and
     7039               buf_price-all.obj-type   = p-obj-type               and
     7040               buf_price-all.obj-code   = p-obj-code               and
     7041               buf_price-all.gds-code   = buf_goods.gds-code       and
     7042             ( buf_price-all.b-code = v-main-b-code or
     7043               buf_price-all.b-code = p-b-code)    and
     7044               buf_price-all.status_    = 'акт':U         and
     7045               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     7046             ( buf_price-all.fact-order-sys-to = ? or
     7047               buf_price-all.fact-order-sys-to >=  p-fact-order)
     7048               :
     7049                 create tt_price-all .
     7050                 buffer-copy buf_price-all to tt_price-all
     7051                 assign
     7052                   tt_price-all.price-sale  = buf_price-all.price-sale
     7053                 .
     7054       end.
     7055   define variable vt-plt-id as integer   no-undo .
     7056   define variable vt-plt-db as integer   no-undo .
     7057   define variable vt-pdf-id as integer   no-undo .
     7058   define variable vt-pdf-db as integer   no-undo .
     7059   define buffer neos_price-all for tt_price-all  .
     7060   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     7061       if available tt_price-all then do:
     7062        assign
     7063          vt-plt-id = tt_price-all.plt-id
     7064          vt-plt-db = tt_price-all.plt-db-num
     7065          vt-pdf-id = tt_price-all.pdf-id
     7066          vt-pdf-db = tt_price-all.pdf-db
     7067        .
     7068        if tt_price-all.b-code = p-b-code then do:
     7069             assign
     7070               p-plt-id           = tt_price-all.plt-id
     7071               p-plt-db-num       = tt_price-all.plt-db-num
     7072               p-pdf-id           = tt_price-all.pdf-id
     7073               p-pdf-db-num       = tt_price-all.pdf-db
     7074               p-sale-price       = tt_price-all.price-sale
     7075               .
     7076        end.
     7077        else do:
     7078          find first neos_price-all where
     7079                     neos_price-all.b-code     = p-b-code  and
     7080                     neos_price-all.plt-id     = vt-plt-id and
     7081                     neos_price-all.plt-db-num = vt-plt-db and
     7082                     neos_price-all.pdf-id     = vt-pdf-id and
     7083                     neos_price-all.pdf-db     = vt-pdf-db
     7084                     use-index pi no-error .
     7085            if available neos_price-all then do:
     7086             assign
     7087               p-plt-id           = tt_price-all.plt-id
     7088               p-plt-db-num       = tt_price-all.plt-db-num
     7089               p-pdf-id           = tt_price-all.pdf-id
     7090               p-pdf-db-num       = tt_price-all.pdf-db
     7091               p-sale-price       = neos_price-all.price-sale
     7092               .
     7093            end.
     7094            else do:
     7095           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     7096           if error-status :error    then do:
     7097              message "Не найден бар-код" p-b-code view-as alert-box error .
     7098              return error return-value .
     7099           end.
     7100             assign
     7101               p-plt-id           = tt_price-all.plt-id
     7102               p-plt-db-num       = tt_price-all.plt-db-num
     7103               p-pdf-id           = tt_price-all.pdf-id
     7104               p-pdf-db-num       = tt_price-all.pdf-db
     7105               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     7106               .
     7107            end.
     7108        end.
     7109     end.
     7110     end.
     7111   end procedure.
