    11771                  and v-i-cli eq 2
    11772                  and cash-gds.cli-base-rate eq 1  )
    11773               or (   v-i-cli-qnty eq 999999999
    11774                  and v-i-cli eq 1
    11775                  and cash-gds.cli-base-rate ne 1  )
