     7303   procedure grp-obj-notcorr-value :
     7304   do
     7305   on error undo, return error
     7306   :
     7307   define input parameter p-node-code             as integer      no-undo.
     7308   define input parameter p-obj-type              as character    no-undo.
     7309   define input parameter p-obj-code              as integer      no-undo.
     7310   define output parameter p-notcorr              as character    no-undo init ?.
     7311   define output parameter p-range-notcorr     as integer      no-undo.
     7312   define output parameter p-exists-notcorr    as logical      no-undo.
     7313   define variable v-host-code as integer      no-undo.
     7314   DEFINE VARIABLE v-found as logical no-undo .
     7315   DEFINE VARIABLE v-exists as logical no-undo .
     7316   DEFINE VARIABLE v-range as integer no-undo .
     7317   DEFINE VARIABLE jj as integer no-undo .
     7318   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     7319   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     7320   define buffer buf_gds-grp for ub.gds-grp.
     7321   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7322   find first buf_gds-grp no-lock where
     7323              buf_gds-grp.node-code = p-node-code no-error .
     7324   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7325     message
     7326       vss-workfile vss-revision vss-description
     7327       skip "Не удалось найти группу товаров с кодом" p-node-code
     7328       view-as alert-box error .
     7329     undo, return error .
     7330   end.
     7331   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7333     (input  p-obj-type
     7334     ,input  p-obj-code
     7335     ,output v-host-code
     7336     ) no-error .
     7337   if error-status :error
     7338   then do:
     7339       message
     7340         vss-workfile vss-revision vss-description
     7341         skip "Не удалось найти фирму объекта"
     7342         skip p-obj-type p-obj-code
     7343         skip return-value
     7344         skip trim(error-status :get-message(1))
     7345       view-as alert-box error.
     7346       undo, return error .
     7347   end.
     7348   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7349   do while v-found = no and jj < 2:
     7350     if v-range <> 3 then do:
     7351       find first buf_gds-grp-obj no-lock
     7352           where buf_gds-grp-obj.node-code = p-node-code
     7353             and buf_gds-grp-obj.host-code = v-host-code
     7354             and buf_gds-grp-obj.obj-type  = p-obj-type
     7355             and buf_gds-grp-obj.obj-code  = p-obj-code
     7356       no-error .
     7357     end.
     7358     if v-range = 3 or not available buf_gds-grp-obj
     7359     then do:
     7360        if v-range <> 2 then do:
     7361           find first buf_gds-grp-obj no-lock
     7362               where buf_gds-grp-obj.node-code = p-node-code
     7363                 and buf_gds-grp-obj.host-code = v-host-code
     7364                 and buf_gds-grp-obj.obj-type  = ""
     7365                 and buf_gds-grp-obj.obj-code  = 0
     7366           no-error .
     7367         end.
     7368         if v-range = 2 or not available buf_gds-grp-obj
     7369         then do:
     7370             if v-range <> 1 then do:
     7371               find first buf_gds-grp-obj no-lock
     7372                   where buf_gds-grp-obj.node-code = p-node-code
     7373                   and buf_gds-grp-obj.host-code = 0
     7374                   and buf_gds-grp-obj.obj-type  = ""
     7375                   and buf_gds-grp-obj.obj-code  = 0
     7376               no-error .
     7377             end.
     7378             if v-range = 1 or not available buf_gds-grp-obj
     7379             then do:
     7380                 assign
     7381                     v-exists = no
     7382                 .
     7383             end.
     7384             else do:
     7385                 assign
     7386                     v-exists = yes
     7387                     v-range = 1
     7388                 .
     7389             end.
     7390         end.
     7391         else do:
     7392             assign
     7393                 v-exists = yes
     7394                 v-range  = 2
     7395             .
     7396         end.
     7397     end.
     7398     else do:
     7399         assign
     7400             v-exists = yes
     7401             v-range  = 3
     7402         .
     7403     end.
     7404     if available buf_gds-grp-obj
     7405     then do:
     7406       find first buf_gds-grp-obj-attr no-lock
     7407         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7408           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7409           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7410           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7411           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7412         no-error .
     7413       if available buf_gds-grp-obj-attr then do:
     7414         assign
     7415           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7416         .
     7417       end.
     7418       else do:
     7419         assign
     7420           v-notcorr-value = ?
     7421         .
     7422       end.
     7423       assign
     7424       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7425                           then yes
     7426                           else p-exists-notcorr)
     7427       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7428                         then v-range
     7429                         else p-range-notcorr
     7430       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7431                         then v-notcorr-value
     7432                         else p-notcorr
     7433       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7434       jj = jj + 1
     7435       .
     7436     end.
     7437     else do:
     7438       assign
     7439       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7440       jj = jj + 1
     7441       .
     7442     end.
     7443   end.
     7444   end.
     7445   end procedure.
