    16749         buf_dis-rule.key#_one v-char-delim-1
    16750         "3,MAPKA,"
    16751         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    16752         "0" v-char-delim-1
    16753         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    16754         "0" v-char-delim-1
    16755         v-char-1
    16756         v-char-21
    16757         "9,0,0,"
    16758         trim(string(buf_dis-rule.tot-sum * 100,">>>>>>>>>9")) v-char-delim-1
    16759         v-char-3
    16760         v-char-41
    16761         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    16762         v-char-5
    16763          v-char-delim-2
    16764         v-char-61 v-char-71 skip.
