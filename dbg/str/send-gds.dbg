    12727                                                   caps(string(chk_name,'x(20)'))
    12728                                                   string(( cash-gds.price-sale * 100 ) ,'99999999') .
    12729                     put unformatted '0000000000000000000000000000000'
    12730                     string(action, "X(1)") '0000000000000'.
    12731                     put skip.
    12732                 end.
    12733             end.
    12734             else do:
    12735               put unformatted ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12736                                         '00101' caps( string( chk_name, 'x(20)' ) )
    12737                                       string( ( cash-gds.price-sale * 100 ) ,'99999999') .
    12738               put unformatted '0000000000000000000000000000000'
    12739               string(action, "X(1)") '0000000000000'.
    12740               put skip.
    12741             end.
    12742           end.
    12743         end.
    12744       when 'NCR-GM':U
    12745       or when 'NCR-AS@R':U
    12746       then do:
    12747   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12748   define variable ncr-disc-string as character no-undo .
    12749   if nam-artc then
    12750   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    12751   else  do:
    12752     chk_name = "" .
    12753     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
    12754       chk_name = chk_name + entry( ff, cash-gds.gds-name, '"' ) .
    12755     END .
    12756     if chk_name = "" then
    12757     chk_name = cash-gds.gds-name .
    12758     chk_name = chk_name + cash-gds.f-name .
    12759   end.
    12760   if (cash-gds.unit-base <> cash-gds.unit-cli) and
    12761      cash-gds.cli-base-rate <> 1 then
    12762   assign
    12763   chk_name = string(substr(chk_name, 1, 19 - length(string(cash-gds.cli-base-rate))) + "*" + string( cash-gds.cli-base-rate ), "x(20)" ).
    12764   else
    12765   chk_name = string(chk_name, "X(20)").
    12766   assign
    12767   ncrdsc = "0":U
    12768   conf-par = "":U
    12769   par-type ="":U
    12770   .
    12771   if std-disc-dec <> 0
    12772   or pos-type = 'NCR-AS@R':U
    12773   then do:
    12774     do ff = 1 to num-entries(ncrgmdsc, ";":U):
    12775       assign
    12776       par-type = entry(ff, ncrgmdsc , ";":U)
    12777       conf-par = entry(2, par-type, "=":U)
    12778       no-error
    12779       .
    12780       if error-status:error then do:
    12781         LEAVE.
    12782       end.
    12783       if conf-par  = string( - std-disc-dec) then do:
    12784         ncrdsc =  entry(1, par-type, "=").
    12785         LEAVE.
    12786       end.
    12787     end.
    12788   end.
    12789   assign
    12790   IBM-good-code = "":U
    12791   is-sc = no
    12792   .
    12793   run ncr-gdsc in this-procedure (output IBM-good-code
    12794                                 , output IBM-good-code-2
    12795                                 , output is-sc
    12796                                 , output taracode-bc
    12797                                 ) no-error .
    12798   if IBM-good-code = "":U then
    12799   assign
    12800   IBM-good-code= IBM-good-code-2
    12801   .
    12802   assign
    12803   conf-par =  ncr-d-rank(ncrdrank, cash-gds.qnty-discnt-rule,  cash-gds.temp-discnt-rule, cash-gds.date-discnt-rule )
    12804   .
    12805   do2:
    12806   do while IBm-good-code <> "":U:
    12807     if action = "D":U then do:
    12808       put stream IBMStream unformatted
    12809       fill(chr(32), 3)
    12810       IBM-good-code
    12811       "-":U
    12812       fill(chr(32), 61)
    12813       chr(10)
    12814       .
    12815     end.
    12816     else do:
    12817       if conf-par = "T":U then do:
    12818         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12819       end.
    12820       if conf-par = "D":U then do:
    12821         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12822       end.
    12823       if conf-par = "X":U then do:
    12824          ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12825       end.
    12826       if ncr-disc-string = '':U then
    12827       conf-par = chr(32) .
    12828       put stream IBMStream unformatted
    12829       fill(chr(32), 3)
    12830       IBM-good-code
    12831       string(if cash-gds.grp-code = 0 then 1 else cash-gds.grp-code , "9999":U)
    12832       (if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12833       or (is-sc
    12834       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12835       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    12836       then "2":U
    12837       else "0":U)
    12838       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    12839        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    12840        or is-sc
    12841        then "1":U
    12842        else "0":U)
    12843         (if pos-type = 'NCR-GM':U or
    12844         wd-option = 0
    12845         then   ncrdsc
    12846         else '0':U)
    12847        (if cash-gds.vat-code = ? or
    12848        cash-gds.vat-code > 7 then
    12849        "0"
    12850        else string(cash-gds.vat-code, "9"))
    12851       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12852       or (is-sc
    12853       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12854       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    12855       and  (cash-gds.taracode  <> '':u
    12856            or taracode-bc <> '')
    12857       then (if taracode-bc <> ''
    12858             then taracode-bc
    12859             else cash-gds.taracode)
    12860       else '00'
    12861       )
    12862       (if cash-gds.unit-cli begins "№"
    12863        then substring(cash-gds.unit-cli, 2, 2)
    12864        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    12865       "0010":U
    12866       "0000":U
    12867       chk_name
    12868       fill(chr(32), 4)
    12869       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12870       fill(chr(32), 8)
    12871       conf-par
    12872       replace(string( cash-gds.price-sale, "999999.99")
    12873              , ".":U, "":U
    12874              )
    12875       chr(10)
    12876       .
    12877       if pos-type = 'NCR-AS@R':U
    12878       and ncrdsc <> '0':U
    12879       and wd-option > 0
    12880       and cash-gds.std-discnt-rule > 0
    12881       then do:
    12882         run create-ncr-kat-discnt in this-procedure (
    12883                                                     input string(cash-gds.gds-code)
    12884                                                     ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12885                                                     ,input chk_name
    12886                                                     ,input (if action = 'D':U then 0 else cash-gds.std-discnt-rule)
    12887                                                     ,input ?
    12888                                                     ,input 'time-rule-num':U
    12889                                                     ,input ?
    12890                                                     ) no-error .
    12891       end.
    12892       ncr-disc-string = '':U.
    12893       if conf-par = "T":U then do:
    12894         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12895         if ncr-disc-string <> '':U then
    12896         PUT stream IBMstream unformatted
    12897         chr(32)
    12898         "T":U
    12899         chr(32)
    12900         IBM-good-code
    12901         chr(32)
    12902         chr(32)
    12903         ncr-disc-string
    12904         chr(10)
    12905         .
    12906       end.
    12907       if conf-par = "D":U then do:
    12908         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12909         if ncr-disc-string <> '':U then
    12910         PUT stream IBMstream unformatted
    12911         chr(32)
    12912         "D":U
    12913         chr(32)
    12914         IBM-good-code
    12915         chr(32)
    12916         chr(32)
    12917         ncr-disc-string
    12918         chr(10)
    12919         .
    12920       end.
    12921       if conf-par = "X":U then do:
    12922         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12923         if ncr-disc-string <> '':U then
    12924         PUT stream IBMstream unformatted
    12925         chr(32)
    12926         "X":U
    12927         chr(32)
    12928         IBm-good-code
    12929         chr(32)
    12930         chr(32)
    12931         ncr-disc-string
    12932         chr(10)
    12933         .
    12934       end.
    12935     end.
    12936     if pos-type = 'NCR-AS@R':U
    12937     and cash-gds.kat-discnt-rule <> 0
    12938     then do:
    12939       case how-pcnt-kat :
    12940         when 'pcnt-kat-pdf':U then do:
    12941             v-kat-discnt = cash-gds.price-sale.
    12942           end.
    12943         otherwise do:
    12944           v-kat-discnt = ?.
    12945         end.
    12946       end case.
    12947       run create-ncr-kat-discnt in this-procedure (
    12948                                                    input string(cash-gds.gds-code)
    12949                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12950                                                   ,input chk_name
    12951                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12952                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12953                                                   ,input 'time-rule-num':U
    12954                                                   ,input v-kat-discnt
    12955                                                   ) no-error .
    12956       if error-status:error then do:
    12957       end.
    12958     end.
    12959     if IBM-good-code = IBM-good-code-2 then leave do2.
    12960     assign
    12961     IBM-good-code = IBM-good-code-2
    12962     .
    12963   end.
    12964       end.
    12965     END CASE .
    12966   END PROCEDURE .
    12967   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12968   PROCEDURE   for-cash-cycle:
    12969   DEFINE VARIABLE fname-list as character no-undo .
    12970   DEFINE VARIABLE out-list as character no-undo .
    12971   DEFINE VARIABLE var-file-num as integer no-undo .
    12972   DEFINE VARIABLE v-dir-remote as character no-undo .
    12973   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
    12974   define variable v-plu as character no-undo .
    12975   define variable v-pl-code as integer no-undo .
    12976   define variable ss  as character no-undo .
    12977   define variable ss0  as character no-undo .
    12978   define variable v-temp-kat-file as character no-undo .
    12979   define variable v-kat-file as character no-undo .
    12980   define variable v-kat-file-save as character no-undo .
    12981   define variable v-updated-subject-dis-kat as logical no-undo .
    12982   define variable v-next as logical no-undo .
    12983   define variable v-cd-subject-code as character no-undo .
    12984   define variable v-cd-disc-string as character no-undo .
    12985   define variable v-versiond as decimal no-undo .
    12986   define variable v-maria-discnt-value as character no-undo .
    12987   define variable v-ii as integer no-undo .
    12988   define variable v-dop as character no-undo .
    12989   define variable v-gds-rule-num as integer no-undo .
    12990   define variable v-maria-rule-num as integer no-undo .
    12991   define buffer for-cash-desk for ub.cash-desk.
    12992   define buffer buf_cd-plu for ub.cd-plu.
    12993   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
    12994   define buffer buf_cash-gds for cash-gds.
    12995   define buffer buf_dis-rule for ub.dis-rule.
    12996   define buffer buf_place for ub.place.
    12997   define buffer buf_pl-gds for ub.pl-gds.
    12998   FOR EACH for-cash-desk NO-LOCK WHERE
    12999           for-cash-desk.db-num = g#db-num AND
    13000           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    13001           for-cash-desk.obj-code = i-obj-code AND
    13002    for-cash-desk.cash-on  = yes
    13003       BREAK
    13004       BY for-cash-desk.db-num
    13005       BY for-cash-desk.obj-code
    13006       BY for-cash-desk.pos-type
    13007       BY for-cash-desk.cash-on
    13008       BY for-cash-desk.cash-num
    13009       :
    13010     if LOOKUP(ub.cash-desk.pos-type,
    13011               ('NCR-GM':U + chr(44) +
    13012                'IBM-XML':U + chr(44) +
    13013                'MAGIA-XML':U + chr(44) +
    13014                'NCR-AS@R':U  + chr(44) +
    13015                'Autotank':U
    13016                  )) > 0
    13017     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    13018     if LOOKUP(ub.cash-desk.pos-type,
    13019               'MARIA':U
    13020                  ) > 0 then do:
    13021       if for-cash-desk.autonomy = integer('2':U) then do:
    13022         assign
    13023         v-cd-list-update = for-cash-desk.addr-path
    13024         v-cd-list-delete = for-cash-desk.addr-path
    13025         .
    13026         NEXT.
    13027       end.
    13028       else do:
    13029         if v-cd-list-update = '':U then nExt.
    13030       end.
    13031     end.
    13032     run write-log-and-file in p-log-handle (
    13033           input 1
    13034         , input log-file-name
    13035         , input 1
    13036         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
    13037                           )
    13038                                           ).
    13039   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13040   case for-cash-desk.pos-type:
    13041       when 'IBM-XML':U or when 'Autotank':U
    13042         or
    13043       when 'InfoKiosk':U
    13044         or
    13045       when 'Autotank':U
    13046     then do:
    13047   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13048   run xml-cd-filename in this-procedure (
    13049         input out
    13050       , output v-xml-file-name
    13051       , output v-xml-file-name-path
    13052       , output v-log-file-name
    13053       , output v-locked
    13054   ).
    13055   run write-log-and-file in p-log-handle (
    13056         input 1
    13057       , input log-file-name
    13058       , input 1
    13059       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    13060                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    13061                         )
    13062                                         ).
    13063   run write-log-and-file in p-log-handle (
    13064         input 1
    13065       , input log-file-name
    13066       , input 1
    13067       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
    13068                                         ).
    13069   assign
    13070   v-obj-list = 'маг':U + string(i-obj-code)
    13071   .
    13072   run xml-cd-write-header in this-procedure (
    13073         input v-xml-file-name
    13074       , input v-xml-file-name-path
    13075       , input 'data'
    13076       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    13077       , input v-obj-list
    13078       , input (
    13079                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    13080                   then (if for-cash-desk.autonomy = integer('0':U)
    13081                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    13082                         else ("КМ"   )
    13083                         )
    13084                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    13085                   )
    13086               )
    13087       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    13088   ).
    13089   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    13090   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    13091     end.
    13092     when 'MAGIA-XML':U then do:
    13093   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13094   run xml-cd-filename in this-procedure (
    13095         input out
    13096       , output v-xml-file-name
    13097       , output v-xml-file-name-path
    13098       , output v-log-file-name
    13099       , output v-locked
    13100   ).
    13101   run write-log-and-file in p-log-handle (
    13102         input 1
    13103       , input log-file-name
    13104       , input 1
    13105       , input substitute( ("'Пересылка данных по товарам'" + " &1")
    13106                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
    13107                         )
    13108                                         ).
    13109   run write-log-and-file in p-log-handle (
    13110         input 1
    13111       , input log-file-name
    13112       , input 1
    13113       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
    13114                                         ).
    13115   assign
    13116   v-obj-list = 'маг':U + string(i-obj-code)
    13117   .
    13118   run xml-cd-write-header in this-procedure (
    13119         input v-xml-file-name
    13120       , input v-xml-file-name-path
    13121       , input 'data'
    13122       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    13123       , input v-obj-list
    13124       , input (
    13125                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    13126                   then (if for-cash-desk.autonomy = integer('0':U)
    13127                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
    13128                         else ("КМ"   )
    13129                         )
    13130                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
    13131                   )
    13132               )
    13133       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    13134   ).
    13135   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    13136   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    13137     end.
    13138     when 'IBM':U
    13139     then do:
    13140   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13141   if for-cash-desk.cash-os = ""
    13142   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    13143   then NEXT.
    13144   assign
    13145   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
    13146               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
    13147   Cash-DOS = NOT CASH-OS2
    13148   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
    13149   v-dir-remote-tmp = v-remote + "tmp":U
    13150   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
    13151   .
    13152   if for-cash-desk.remote = 1 then do:
    13153     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
    13154       if error-status:error then do:
    13155         run write-log-and-file in p-log-handle (
    13156               input 1
    13157             , input log-file-name
    13158             , input 1
    13159             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    13160                               "и/или попытка его создания не удалась"
    13161                               ,v-dir-remote-tmp
    13162                               ,for-cash-desk.cash-num
    13163                               ,chr(10)
    13164                               )
    13165                                               ).
    13166         NEXT.
    13167     end.
    13168     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
    13169       if error-status:error then do:
    13170         run write-log-and-file in p-log-handle (
    13171               input 1
    13172             , input log-file-name
    13173             , input 1
    13174             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
    13175                               "и/или попытка его создания не удалась"
    13176                               ,v-dir-remote
    13177                               ,for-cash-desk.cash-num
    13178                               ,chr(10)
    13179                               )
    13180                                               ).
    13181         NEXT.
    13182       end.
    13183   end.
    13184   output stream IBMStream
    13185   to value( (if for-cash-desk.remote = 1
    13186               then (v-dir-remote-tmp + chr(47) + "fl":U)
    13187               else out) + fname + '.dat' ) convert target "ibm866".
    13188   OS2-time =       ( if Cash-OS2 then
    13189                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
    13190                         else "" )
    13191   .
    13192     end.
    13193     when 'OMRON-NEW':U then do:
    13194   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13195   assign
    13196   v-versiond = decimal(for-cash-desk.version)
    13197   no-error .
    13198   if error-status:error
    13199   or v-versiond < 0 then do:
    13200     run write-log-and-file in p-log-handle (
    13201           input 1
