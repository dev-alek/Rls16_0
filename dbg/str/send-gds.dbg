    14891                                 , 'маг':U
    14892                                 , abs(i-obj-code)).
    14893     end.
    14894     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    14895       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    14896                               and ub.curr-shop.obj-type = 'маг':U
    14897                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    14898                               use-index pi NO-ERROR.
