    15016   _do26:
    15017   do vdr-26 = 1 to 3:
    15018     CASE vdr-26:
    15019       when 1 then do:
    15020         assign
    15021         vc-obj-code = ub.shop.obj-code
    15022         vc-obj-type = 'маг':U
    15023         vc-host-code = ub.shop.host-code
    15024         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    15025         .
    15026       end.
    15027       when 2 then do:
    15028         assign
    15029         vc-obj-code = 0
    15030         vc-obj-type = '':U
    15031         vc-host-code = ub.shop.host-code
    15032         vc-region    = substitute("Фирма &1&2", vc-host-code)
    15033         .
    15034       end.
    15035       when 3 then do:
    15036         assign
    15037         vc-obj-code = 0
    15038         vc-obj-type = '':U
    15039         vc-host-code = 0
    15040         vc-region    = "Глобально"
    15041         .
    15042       end.
    15043     END CASE.
    15044     find ub.dis-rule no-lock where
    15045                   ub.dis-rule.upper-rule-num = 26
    15046               and ub.dis-rule.host-code = vc-host-code
    15047               AND ub.dis-rule.obj-type = vc-obj-type
    15048               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    15049     if available ub.dis-rule then LEAVE _do26.
    15050   end.
    15051   if available ub.dis-rule then do:
    15052     for each buf_dis-rule no-lock where
    15053             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    15054       assign
    15055       ncrgmdsc = ncrgmdsc + (if ncrgmdsc = "":U then "":U else ";") +
    15056                   string(buf_dis-rule.dis-kat) + "=":U +
    15057                   string(buf_dis-rule.discnt-value).
    15058     end.
    15059   end.
    15060   run adm/shattri.p (
    15061           input "get":U
    15062           ,input  'маг':U
    15063           ,input  ub.cash-desk.obj-code
    15064           ,input  (if ub.cash-desk.pos-type = 'NCR-GM':U then 'cd-type-NCR-GM':U else 'cd-type-NCR-AS-R':U)
    15065           ,input  (if ub.cash-desk.pos-type = 'NCR-GM':U
    15066                   then 'ncrdrank':U
    15067                   else 'ncrdrank':U)
