    10698           sum87 = 0
    10699         .
    10700         do i87 = 1 to len-code87 by 2
    10701         :
    10702           assign
    10703             v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10704           .
    10705           if v-sum-char87 < "0"
    10706           or v-sum-char87 > "9"
    10707           then do:
    10708             message
    10709               "Невозможно сформировать бар-код" skip
    10710               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10711               view-as alert-box error title "подсчет контрольной суммы".
    10712             return error.
    10713           end.
    10714           assign
    10715             sum87 = sum87 + integer(v-sum-char87)
    10716           .
    10717         end.
    10718         if varcont87 = yes then do:
    10719           assign
    10720             sum87 = sum87 * 3
    10721           .
    10722           do i87 = 2 to len-code87 by 2
    10723           :
    10724             assign
    10725               v-sum-char87 = substr(IBm-good-code, len-code87 - i87 + 1, 1)
    10726             .
    10727             if v-sum-char87 < "0"
    10728             or v-sum-char87 > "9"
    10729             then do:
    10730               message
    10731                 "Невозможно сформировать бар-код" skip
    10732                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10733                 view-as alert-box error title "подсчет контрольной суммы".
    10734               return error.
    10735             end.
    10736             assign
    10737               sum87 = sum87 + integer(v-sum-char87)
    10738             .
    10739           end.
    10740           if varcont87 = yes then do:
    10741              if sum87 mod 10 = 0 then do:
    10742                assign
    10743                  IBm-good-code = IBm-good-code + '0'
    10744                .
    10745              end.
    10746              else do:
    10747                assign
    10748                  IBm-good-code = IBm-good-code + string(10 - sum87 mod 10)
    10749                .
    10750              end.
    10751           end.
    10752         end.
    10753       end.
    10754     end.
    10755             end.
    10756           end.
    10757         end.
    10758       end.
    10759       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10760       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
    10761             or
    10762             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
    10763       then do:
    10764           run bc-oattr_value in this-procedure ( input cash-gds.b-code
    10765                                               ,input 'taracode-bc':U
    10766                                               ,input 'маг':U
    10767                                               ,input i-obj-code
    10768                                               ,output v-taracode-bc
    10769                                               ,output v-type) no-error.
    10770           if not error-status:error
    10771           and v-taracode-bc <> '' then do:
    10772             is-sc = yes.
    10773             p-taracode-bc = v-taracode-bc.
    10774           end.
    10775       end.
    10776     end.
    10777   end procedure.
    10778   procedure finish-send :
    10779     do
    10780     on error undo, return error
    10781     :
    10782       if p-batch then do:
    10783         if v-view-log then
    10784         run set-view-log in p-log-handle(yes).
    10785       end.
    10786       else do:
    10787   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10788   if v-view-log
    10789   and not g#news
    10790   and not g#auto
    10791   then do:
    10792     message
    10793     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10794     "!!!Внимательно прочитайте Log-file!!"
    10795     view-as alert-box error .
    10796        define variable v-user-action89   as character no-undo .
    10797     define variable v-printed89       as logical   no-undo .
    10798     run gbl/prnfilen.w
    10799       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10800       ,input  0
    10801       ,input  (string("./":U) + log-file-name)
    10802       ,input  7
    10803       ,output v-user-action89
    10804       ,output v-printed89
    10805       ) .
    10806   end.
    10807   if v-view-log = true
    10808   and (g#news
    10809   or g#auto)
    10810   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10811   then do:
    10812      run cb_set-view-log in p-parent-handle ( input yes).
    10813   end.
    10814       end.
    10815       define variable v-save-file-name as character no-undo .
    10816       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10817       OS-APPEND value(log-file-name) value(v-save-file-name).
    10818       OS-DELETE value(log-file-name).
    10819     end.
    10820   end procedure.
    10821   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
    10822   PROCEDURE putc-gds.
    10823   define parameter buffer buf_cash-desk for ub.cash-desk.
