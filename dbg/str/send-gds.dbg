     8342                                             ,input 'маг':U
     8343                                             ,input i-obj-code
     8344                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8345                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8346                                             ,input ?
     8347                                             ,output v-disc-price-sale
     8348                                             ,output v-pdf-id
     8349                                             ,output v-pdf-db-num ) no-error.
     8350         if error-status:error
     8351         or v-disc-price-sale = 0
     8352         or v-disc-price-sale = ?
     8353         then do:
     8354         end.
     8355         else do:
     8356           find first  cash-gds-discnt where
     8357                     cash-gds-discnt.b-code = cash-gds.b-code
     8358                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8359                   and cash-gds-discnt.obj-type = parobj-type
     8360                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8361           if not available cash-gds-discnt then do:
     8362             find first  cash-gds-discnt where
     8363                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8364             if not available cash-gds-discnt then do:
     8365               create cash-gds-discnt.
     8366               assign
     8367               cash-gds-discnt.crf = crgd + 1.
     8368             end.
     8369             crgd = crgd + 1.
     8370             assign
     8371             cash-gds-discnt.b-code = cash-gds.b-code
