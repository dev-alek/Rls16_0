     4983     define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     4984     define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     4985     define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     4986     define input parameter p-ucode     like ub.cash-desk-attr.upper-attr-code  no-undo .
     4987     define input parameter p-code     like ub.cash-desk-attr.attr-code  no-undo .
     4988     define input parameter p-value as character no-undo .
     4989     define input parameter p-mode  as character no-undo .
     4990     define output parameter p-correct     as logical no-undo .
     4991     define output parameter p-error-code  as character no-undo .
     4992     do
     4993     on error undo, return error return-value
     4994     :
     4995           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr_check-marketer in g#attr-lib
     4996         (input  p-db-num
     4997         ,input  p-obj-code
     4998         ,input  p-pos-type
     4999         ,input  p-cash-num
     5000         ,input  p-ucode
     5001         ,input  p-code
     5002         ,input  p-value
     5003         ,input  p-mode
     5004         ,output p-correct
     5005         ,output p-error-code
     5006         ) no-error .
     5007       if error-status :error
     5008       then do:
     5009         undo, return error return-value .
     5010       end.
     5011     end.
     5012   end procedure.
     5013   procedure cd-attr-manual-edit :
