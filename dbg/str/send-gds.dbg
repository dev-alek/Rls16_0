     7544   DEFINE VARIABLE how-temp-disc                as character         no-undo .
     7545   DEFINE VARIABLE how-pcnt-kat                 as character         no-undo .
     7546   DEFINE VARIABLE discnt-to-send               as character         no-undo .
     7547   define variable v-is-restaurant              as logical no-undo .
     7548   define variable cd-vat                       as integer           no-undo .
