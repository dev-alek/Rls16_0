    14607         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    14608                              ,for-cash-desk.cash-num
    14609                              ,chr(10)
    14610                              ,return-value
    14611                           )
    14612                                           ).
    14613     assign
    14614     v-view-log = yes
    14615     .
    14616       for each temp-cd-plu:
    14617         delete temp-cd-plu.
    14618       end.
    14619     return "error":U.
    14620   end.
    14621   else do:
    14622     for each temp-cd-plu,
    14623         first buf_cd-plu where
    14624                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    14625                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    14626                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    14627                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    14628                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    14629       if temp-cd-plu.to-del = yes
    14630       and v-del-mrkt-gds
    14631       then do:
    14632         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    14633           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    14634           assign
    14635           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    14636           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    14637           .
    14638         end.
    14639         if buf_cd-plu.charkey_one = '':U then do:
    14640           delete buf_cd-plu.
    14641           NEXT.
    14642         end.
    14643       end.
    14644       if temp-cd-plu.charkey_two = "":U
    14645       then
    14646       assign
    14647       buf_cd-plu.charkey_two = "":U
    14648       buf_cd-plu.to-send = no
    14649       .
    14650       delete temp-cd-plu.
    14651     end.
    14652   end.
    14653   end.
    14654   run cd-mrkt_update-marketer in this-procedure (
    14655                                                   input for-cash-desk.db-num
    14656                                                   ,input for-cash-desk.obj-code
    14657                                                   ,input for-cash-desk.pos-type
    14658                                                   ,input for-cash-desk.cash-num
    14659                                                   ,input no
    14660                                                 )  .
    14661       end.
    14662     end.
    14663   END CASE.
    14664   END .
