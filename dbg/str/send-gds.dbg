    11495                 find first cash-gds-discnt where
    11496                           cash-gds-discnt.b-code = cash-gds.b-code
    11497                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    11498                       and cash-gds-discnt.obj-type = 'маг':U
    11499                       and cash-gds-discnt.obj-code = i-obj-code
    11500                       no-error.
    11501                 if available cash-gds-discnt then do:
    11502                   assign
    11503                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
    11504                   .
    11505                 end.
    11506                 else do:
    11507                   assign
    11508                   temp-disc-dec = 0.
    11509                 end.
    11510               end.
    11511               otherwise do:
    11512                 temp-disc-dec = 0.
    11513               end.
    11514             end case.
    11515           end.
    11516           assign
    11517           temp-disc-reason = 0
    11518           temp-disc-weekday = 0
    11519           no-error
    11520           .
    11521           assign
    11522           temp-disc-start = cash-dis-time-rule.date-from
    11523           temp-disc-end   = cash-dis-time-rule.date-to
    11524           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
    11525           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
    11526           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
    11527                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
    11528                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
    11529                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
    11530                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
    11531                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
    11532                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
    11533           .
    11534           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
    11535           assign
    11536           temp-disc-dec = 0
    11537           temp-disc-reason = 0
    11538           temp-disc-weekday = 0
    11539           temp-disc-time-start = 0
    11540           temp-disc-time-end = 0
    11541           temp-disc-start = 12/31/1989
    11542           temp-disc-end = 12/31/9999
    11543           .
