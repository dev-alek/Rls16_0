     2173   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2174   procedure cur-time :
     2175      define output parameter p-today as date      no-undo .
     2176      define output parameter p-time  as integer   no-undo .
     2177     do
     2178     on error undo, return error
     2179     :
     2180       define variable v-date1 as date      no-undo .
     2181       define variable v-date2 as date      no-undo .
     2182       define variable v-time  as integer   no-undo .
     2183       assign
     2184         v-date1 = today
     2185         v-time  = time
     2186         v-date2 = today
     2187       .
     2188       if v-date1 <> v-date2
     2189       then do:
     2190         assign
     2191           v-date1 = today
     2192           v-time  = v-time
     2193         .
     2194       end.
     2195       assign
     2196         p-today = v-date1
     2197         p-time  = v-time
     2198       .
     2199     end.
     2200   end.
     2201   function cur-time-date returns character
     2202   :
     2203     return string(today, '99/99/9999':U) .
     2204   end.
     2205   function cur-time-mjd returns decimal
     2206   :
     2207     define variable v-date as date      no-undo .
     2208     define variable v-time as integer   no-undo .
     2209     run cur-time in this-procedure
     2210       (output v-date
     2211       ,output v-time
     2212       ) .
     2213     return integer(v-date) - 2400002 + (v-time / 86400) .
     2214   end.
     2215   function cur-time-get-ending-index returns integer
     2216   (input p-number as integer
     2217   )
     2218   :
     2219     if p-number < 0
     2220     or p-number = ?
     2221     then do:
     2222       return 1 .
     2223     end.
     2224     define variable v-rest as integer   no-undo .
     2225     assign
     2226       p-number = p-number modulo 100
     2227     .
     2228     if p-number < 20
     2229     then do:
     2230       assign
     2231         v-rest = p-number
     2232       .
     2233     end.
     2234     else do:
     2235       assign
     2236         v-rest = p-number modulo 10
     2237       .
     2238     end.
     2239     case v-rest :
     2240       when 1
     2241       then do:
     2242         return 2 .
     2243       end.
     2244       when 2 or
     2245       when 3 or
     2246       when 4
     2247       then do:
     2248         return 3 .
     2249       end.
     2250       otherwise do:
     2251         return 1 .
     2252       end.
     2253     end case .
     2254   end.
     2255   procedure cur-time-mjd-to-date :
     2256      define input  parameter i-mjd-diff as decimal no-undo.
     2257      define output parameter o-Date     as date    no-undo.
     2258      define output parameter o-Time     as integer no-undo.
     2259      define variable v-day-number as integer   no-undo .
     2260      if    i-mjd-diff < 0
     2261         or i-mjd-diff = ?
     2262      then do:
     2263         return "?" .
     2264      end.
     2265      assign
     2266         v-day-number = truncate(i-mjd-diff,0).
     2267         o-Date = date(v-day-number + 2400002).
     2268         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2269     .
     2270   end.
     2271   function cur-time-mjd-to-string returns character
     2272   (input p-mjd-diff as decimal
     2273   )
     2274   :
     2275     define variable v-day-number as integer   no-undo .
     2276     define variable v-seconds    as integer   no-undo .
     2277     define variable v-hour       as integer   no-undo .
     2278     define variable v-min        as integer   no-undo .
     2279     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2280     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2281     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2282     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2283     if p-mjd-diff < 0
     2284     or p-mjd-diff = ?
     2285     then do:
     2286       return "?" .
     2287     end.
     2288     assign
     2289       v-day-number = integer(truncate(p-mjd-diff,0))
     2290       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2291     .
     2292     if v-seconds > 86400
     2293     then do:
     2294       assign
     2295         v-seconds = 86400 - 1
     2296       .
     2297     end.
     2298     if v-seconds < 0
     2299     then do:
     2300       assign
     2301         v-seconds = 0
     2302       .
     2303     end.
     2304     assign
     2305       v-hour = truncate(v-seconds / 3600, 0)
     2306     .
     2307     assign
     2308       v-seconds = v-seconds modulo 3600
     2309     .
     2310     assign
     2311       v-min = truncate(v-seconds / 60, 0)
     2312     .
     2313     assign
     2314       v-seconds = v-seconds modulo 60
     2315     .
     2316     return
     2317         (if v-day-number <> 0
     2318           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2319           else ""
     2320         )
     2321       + (if v-day-number <> 0 or v-hour <> 0
     2322           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2323           else ""
     2324         )
     2325       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2326           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2327           else ""
     2328         )
     2329       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2330       .
     2331   end.
     2332   function cur-time-string returns character
     2333   :
     2334     define variable v-date as date      no-undo .
     2335     define variable v-time as integer   no-undo .
     2336     run cur-time in this-procedure
     2337       (output v-date
     2338       ,output v-time
     2339       ) .
     2340     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2341   end.
     2342   function cur-time-string-sec returns character
     2343   :
     2344     define variable v-date as date      no-undo .
     2345     define variable v-time as integer   no-undo .
     2346     run cur-time in this-procedure
     2347       (output v-date
     2348       ,output v-time
     2349       ) .
     2350     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2351   end.
     2352   function cur-time-custom  returns character
     2353   (input p-prefix as character
     2354   ,input p-date-format as character
     2355   ,input p-delimiter as character
     2356   ,input p-time-format as character
     2357   ,input p-suffix as character
     2358   )
     2359   :
     2360     define variable v-date as date      no-undo .
     2361     define variable v-time as integer   no-undo .
     2362     run cur-time in this-procedure
     2363       (output v-date
     2364       ,output v-time
     2365       ) .
     2366     return
     2367       p-prefix
     2368       + string(v-date, p-date-format)
     2369       + p-delimiter
     2370       + string(v-time, p-time-format)
     2371       + p-suffix
     2372       .
     2373   end.
     2374   function cur-time-print  returns character
     2375   :
     2376     define variable v-date as date      no-undo .
     2377     define variable v-time as integer   no-undo .
     2378     run cur-time in this-procedure
     2379       (output v-date
     2380       ,output v-time
     2381       ) .
     2382     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2383   end.
     2384   function cur-time-datetime returns datetime
     2385   :
     2386     define variable v-char as character no-undo .
     2387     define variable v-datetime as datetime no-undo .
     2388     v-char = cur-time-string().
     2389     v-datetime = datetime(v-char).
     2390     return  v-datetime.
     2391   end.
     2392   function cur-time-string-msec returns character
     2393   :
     2394     define variable v-date as datetime  no-undo .
     2395     v-date = now.
     2396     return string(v-date) .
     2397   end.
     2398   define variable vss-include-info26 as character format "X(65)" no-undo
     2399   initial "@(#)$Workfile$ $Revision$".
     2400   procedure xmlchar-test :
     2401   define input parameter p-in-string          as character        no-undo.
     2402   define output parameter p-out-string-enc    as character        no-undo.
     2403   define output parameter p-out-string-dec    as character        no-undo.
     2404   do
     2405   on error undo, return error
     2406   :
     2407          run xmlchar-encode in this-procedure
     2408       (
     2409             input p-in-string
     2410           , output p-out-string-enc
     2411       ).
     2412          run xmlchar-decode in this-procedure
     2413       (
     2414             input p-out-string-enc
     2415           , output p-out-string-dec
     2416       ).
     2417   end.
     2418   end .
     2419   procedure xmlchar-encode :
     2420   define input parameter p-in-string      as character        no-undo.
     2421   define output parameter p-out-string    as character        no-undo.
     2422       define variable v-position      as integer      no-undo.
     2423       define variable v-current-char  as character    no-undo.
     2424   do
     2425   on error undo, return error
     2426   :
     2427       assign
     2428           p-out-string = "":U
     2429       .
     2430       case p-in-string
     2431       :
     2432           when ?
     2433           then do:
     2434               assign
     2435                   p-out-string = "?":U
     2436               .
     2437           end.
     2438           when "?":U
     2439           then do:
     2440               assign
     2441                   p-out-string = "&#63;":U
     2442               .
     2443           end.
     2444           otherwise do:
     2445               do v-position = 1 to length( p-in-string )
     2446               :
     2447                   assign
     2448                       v-current-char = substring( p-in-string, v-position, 1 )
     2449                   .
     2450                   case v-current-char
     2451                   :
     2452                       when "&":U
     2453                       then do:
     2454                           assign
     2455                               p-out-string = p-out-string + "&amp;":U
     2456                           .
     2457                       end.
     2458                       when ">":U
     2459                       then do:
     2460                           assign
     2461                               p-out-string = p-out-string + "&gt;":U
     2462                           .
     2463                       end.
     2464                       when "<":U
     2465                       then do:
     2466                           assign
     2467                               p-out-string = p-out-string + "&lt;":U
     2468                           .
     2469                       end.
     2470                       when "'":U
     2471                       then do:
     2472                           assign
     2473                               p-out-string = p-out-string + "&apos;":U
     2474                           .
     2475                       end.
     2476                       when '"':U
     2477                       then do:
     2478                           assign
     2479                               p-out-string = p-out-string + "&quot;":U
     2480                           .
     2481                       end.
     2482                       when chr(1)
     2483                       then do:
     2484                           assign
     2485                               p-out-string = p-out-string + "":U
     2486                           .
     2487                       end.
     2488                       when chr(2)
     2489                       then do:
     2490                           assign
     2491                               p-out-string = p-out-string + "":U
     2492                           .
     2493                       end.
     2494                       when chr(3)
     2495                       then do:
     2496                           assign
     2497                               p-out-string = p-out-string + "":U
     2498                           .
     2499                       end.
     2500                       when chr(4)
     2501                       then do:
     2502                           assign
     2503                               p-out-string = p-out-string + "":U
     2504                           .
     2505                       end.
     2506                       when chr(5)
     2507                       then do:
     2508                           assign
     2509                               p-out-string = p-out-string + "":U
     2510                           .
     2511                       end.
     2512                       when chr(6)
     2513                       then do:
     2514                           assign
     2515                               p-out-string = p-out-string + "":U
     2516                           .
     2517                       end.
     2518                       when chr(7)
     2519                       then do:
     2520                           assign
     2521                               p-out-string = p-out-string + "":U
     2522                           .
     2523                       end.
     2524                       when chr(8)
     2525                       then do:
     2526                           assign
     2527                               p-out-string = p-out-string + "":U
     2528                           .
     2529                       end.
     2530                       when chr(9)
     2531                       then do:
     2532                           assign
     2533                               p-out-string = p-out-string + "":U
     2534                           .
     2535                       end.
     2536                       when chr(29)
     2537                       then do:
     2538                           assign
     2539                               p-out-string = p-out-string + "":U
     2540                           .
     2541                       end.
     2542                       when chr(10)
     2543                       then do:
     2544                           assign
     2545                               p-out-string = p-out-string + "&#10;":U
     2546                           .
     2547                       end.
     2548                       when chr(13)
     2549                       then do:
     2550                           assign
     2551                               p-out-string = p-out-string + "&#13;":U
     2552                           .
     2553                       end.
     2554                       otherwise do:
     2555                           assign
     2556                               p-out-string = p-out-string + v-current-char
     2557                           .
     2558                       end.
     2559                   end case.
     2560               end.
     2561           end.
     2562       end case.
     2563   end.
     2564   end .
