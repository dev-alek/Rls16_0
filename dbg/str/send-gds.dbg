     8311                       , input loc-goods.gds-code
     8312                       , input loc-goods.artic
     8313                       , input loc-goods.engl-name
     8314                       , input loc-bar-code.in-code
     8315                       , input loc-bar-code.part-code
     8316                       , input parobj-type
     8317                       , input parobj-code
     8318                       , input loc-goods.alpha1
     8319                       , output v-gtd
