    16803    output stream IBMStream close .
    16804   end procedure .
    16805   procedure get-thbj-rule :
    16806   define input  parameter p-obj-type as character no-undo .
    16807   define input  parameter p-obj-code as integer no-undo .
    16808   define input  parameter p-host-code as integer no-undo .
    16809   define input  parameter p-discnt-role as character no-undo .
    16810   define input  parameter p-pos-type as character   no-undo .
    16811   define input  parameter p-reg-list as character no-undo .
    16812   define parameter buffer  buf_dis-thbj-rule for ub.dis-thbj-rule.
    16813   define variable v-region-type as character no-undo .
    16814   define variable v-region-code as integer   no-undo .
    16815   define variable v-region-host as integer   no-undo .
    16816   define variable v-region-ii as integer   no-undo .
    16817   _v-region-ii:
    16818   do v-region-ii = 1 to 3:
    16819     if lookup(string(v-region-ii), p-reg-list) = 0 then next _v-region-ii.
    16820     case v-region-ii:
    16821       when 1 then do:
    16822         assign
    16823         v-region-type = p-obj-type
    16824         v-region-code = p-obj-code
    16825         v-region-host = p-host-code
    16826         .
    16827       end.
    16828       when 2 then do:
    16829         assign
    16830         v-region-type = ''
    16831         v-region-code = 0
    16832         v-region-host = p-host-code
    16833         .
    16834       end.
    16835       when 3 then do:
    16836         assign
    16837         v-region-type = ''
    16838         v-region-code = 0
    16839         v-region-host = 0
    16840         .
    16841       end.
    16842     end case.
    16843     find first buf_dis-thbj-rule no-lock where
    16844               buf_dis-thbj-rule.obj-type = v-region-type
    16845           and buf_dis-thbj-rule.obj-code = v-region-code
    16846           and buf_dis-thbj-rule.host-code = v-region-host
    16847           and buf_dis-thbj-rule.discnt-role = p-discnt-role
    16848           and buf_dis-thbj-rule.pos-type = p-pos-type no-error.
    16849     if available buf_dis-thbj-rule then do:
    16850       find first buf_dis-rule no-lock where
    16851                 buf_Dis-rule.rule-num = buf_dis-thbj-rule.templ-rl-root no-error.
    16852       if available buf_dis-rule then do:
    16853         run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num
    16854                                               , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    16855       end.
    16856       leave _v-region-ii.
    16857     end.
    16858   end.
    16859   END PROCEDURE.
