     7554   define buffer buf_currency for ub.currency.
     7555   define buffer buf_producer for ub.clients.
     7556   define buffer buf_dis-rule for ub.dis-rule.
     7557   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     7558   def var vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7559   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7560   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7561   procedure create-dis-rule :
     7562   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7563   define input parameter p-tree as logical no-undo .
     7564   define buffer buf_dis-rule for ub.dis-rule.
     7565   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7566   define buffer term_dis-rule for ub.dis-rule.
     7567   define buffer term_dis-time-rule for ub.dis-time-rule.
     7568   define buffer root_cash-dis-rule for cash-dis-rule.
     7569   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7570   define buffer term_cash-dis-rule for cash-dis-rule.
     7571   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7572     do
     7573     on error undo, return error
     7574     :
     7575       find first root_cash-dis-rule no-lock where                                                         ~
     7576                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7577       if not available root_cash-dis-rule then do:
     7578         find first buf_dis-rule no-lock where
     7579                   buf_dis-rule.rule-num = p-rule-num no-error.
     7580         if available buf_dis-rule then do:
     7581           if buf_dis-rule.time-rule-num <> 0 then do:
     7582             find first buf_dis-time-rule no-lock where
     7583                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7584           end.
     7585           create root_cash-dis-rule.
     7586           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7587           if available buf_dis-time-rule then do:
     7588             find first root_cash-dis-time-rule no-lock where
     7589                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7590             if not available root_cash-dis-time-rule then do:
     7591               create root_cash-dis-time-rule.
     7592               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7593             end.
     7594           end.
     7595           else do:
     7596             assign
     7597             root_cash-dis-rule.time-rule-num = 0.
     7598           end.
     7599           if buf_dis-rule.uniq-field <> "":U then do:
     7600             for each term_dis-rule no-lock where
     7601                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7602               if term_dis-rule.time-rule-num <> 0 then do:
     7603                 find first term_dis-time-rule no-lock where
     7604                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7605               end.
     7606               create term_cash-dis-rule.
     7607               buffer-copy term_dis-rule to term_cash-dis-rule.
     7608               if term_dis-rule.time-rule-num = 0
     7609               or available term_dis-time-rule
     7610               or root_cash-dis-rule.time-rule-num = 0
     7611               then do:
     7612                 if available term_dis-time-rule then do:
     7613                   find first term_cash-dis-time-rule no-lock where
     7614                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7615                   if not available term_cash-dis-time-rule then do:
     7616                     create term_cash-dis-time-rule.
     7617                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7618                   end.
     7619                 end.
     7620               end.
     7621             end.
     7622           end.
     7623         end.
     7624       end.
     7625     end.
     7626   end procedure.
     7627   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7628   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7629   function ncr-amnt-disc returns character (
     7630     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7631   define variable v-result as character no-undo .
     7632   define variable ii as integer no-undo .
     7633   define variable v-entry as character no-undo extent 3.
     7634   for each cash-dis-rule  no-lock where
     7635         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7636     assign
     7637     ii = ii + 1
     7638     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7639                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7640     .
     7641   end.
     7642   if v-entry[2] = "":U then
     7643   assign
     7644   v-entry[2] = v-entry[1]
     7645   .
     7646   if v-entry[3] = "":U then
     7647   assign
     7648   v-entry[3] = v-entry[2]
     7649   .
     7650   assign
     7651   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7652   .
     7653   return v-result.
     7654   END FUNCTION.
     7655   function ncr-date-disc returns character (
     7656     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7657   define variable v-result as character no-undo .
     7658   define variable ii as integer no-undo .
     7659   define variable v-entry as character no-undo extent 3.
     7660   for each cash-dis-rule  no-lock where
     7661         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7662       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7663     assign
     7664     ii = ii + 1
     7665     v-entry[ii] =
     7666                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7667                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7668                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7669                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7670                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7671                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7672                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7673   end.
     7674   if v-entry[2] = "":U then
     7675   assign
     7676   v-entry[2] = v-entry[1]
     7677   .
     7678   if v-entry[3] = "":U then
     7679   assign
     7680   v-entry[3] = v-entry[2]
     7681   .
     7682   assign
     7683   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7684   .
     7685   return v-result.
     7686   END FUNCTION.
     7687   function ncr-temp-disc returns character (
     7688     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7689   define variable v-result as character no-undo .
     7690   define variable ii as integer no-undo .
     7691   define variable v-entry as character no-undo extent 3.
     7692   define variable v-dec as decimal no-undo .
     7693   define variable v-disc-price-sale as decimal no-undo .
     7694   define variable v-pdf-id as integer no-undo .
     7695   define variable v-pdf-db-num as integer no-undo .
     7696   define buffer buf_cash-dis-rule for cash-dis-rule.
     7697   find first buf_cash-dis-rule where
     7698            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7699   if not available buf_cash-dis-rule then return "":U.
     7700   if buf_cash-dis-rule.templ-rl-root <> 29
     7701   and buf_cash-dis-rule.templ-rl-root <> 86
     7702   then do:
     7703     assign
     7704     v-entry[1] =
     7705     "000"                                                   +
     7706     "0"                                                     +
     7707     "0000"                                                  +
     7708     "2359"                                                     +
     7709      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7710      .
     7711   end.
     7712   else do:
     7713     for each cash-dis-rule  no-lock where
     7714           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7715         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7716       case cash-dis-rule.value-type:
     7717         when integer('1':U) then do:
     7718           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7719         end.
     7720         when integer('12':U) then do:
     7721           find first cash-gds-discnt where
     7722                     cash-gds-discnt.b-code = cash-gds.b-code
     7723                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7724                 and cash-gds-discnt.obj-type = 'маг':U
     7725                 and cash-gds-discnt.obj-code = i-obj-code
     7726                 no-error.
     7727           if not available cash-gds-discnt then do:
     7728             v-dec = cash-gds.price-sale.
     7729           end.
     7730           else do:
     7731             assign
     7732             v-dec = cash-gds-discnt.discnt-value
     7733             .
     7734           end.
     7735         end.
     7736         otherwise do:
     7737           v-dec = cash-gds.price-sale.
     7738         end.
     7739       end case.
     7740       assign
     7741       ii = ii + 1
     7742       v-entry[ii] =
     7743                     "000"                                                   +
     7744                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7745                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7746                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7747                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7748                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7749                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7750                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7751                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7752                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7753                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7754                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7755       .
     7756   if ii = 3 then leave.
     7757     end.
     7758   end.
     7759   if v-entry[2] = "":U then
     7760   assign
     7761   v-entry[2] = v-entry[1]
     7762   .
     7763   if v-entry[3] = "":U then
     7764   assign
     7765   v-entry[3] = v-entry[2]
     7766   .
     7767   assign
     7768   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7769   .
     7770   return v-result.
     7771   END FUNCTION.
     7772   function ncr-d-rank returns character (
     7773     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7774   define variable v-result as character no-undo .
     7775   define variable ii as integer no-undo .
     7776   do ii = 1 to length(p-d-rank):
     7777     CASE substr(p-d-rank, ii, 1):
     7778       when "X":U then do:
     7779         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7780       end.
     7781       when "T":U then do:
     7782         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7783       end.
     7784       when "D":U then do:
     7785         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7786       end.
     7787     END CASE.
     7788     if v-result <> "":U then LEAVE.
     7789   end.
     7790   if v-result = "":U then v-result = chr(32).
     7791   return v-result.
     7792   END FUNCTION.
     7793   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7794       define variable v-upper-code as int no-undo.
     7795       define variable v-value as character no-undo.
     7796       define variable v-type as character no-undo.
     7797       define buffer lc_gds-grp for ub.gds-grp.
     7798       define buffer lc_goods for ub.goods.
     7799      if p-gds-code <> 0 then do:
     7800       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7801       v-upper-code = lc_goods.grp-code.
     7802       do while v-upper-code > 0 :
     7803           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7804           run ggoattr-value(
     7805             input lc_gds-grp.node-code,
     7806             input 0,
     7807             input "",
     7808             input 0,
     7809             input 'ban-sales-via-cd':U,
     7810             output v-value,
     7811             output v-type
     7812           ).
     7813          if v-value = "yes" then
     7814             return true.
     7815          else
     7816          do:
     7817             run ggoattr-value(
     7818                input lc_gds-grp.node-code,
     7819                input shop.host-code,
     7820                input "",
     7821                input 0,
     7822                input 'ban-sales-via-cd':U,
     7823                output v-value,
     7824                output v-type
     7825                ).
     7826             if v-value = "yes" then
     7827                return true.
     7828             else
     7829             do:
     7830                run ggoattr-value(
     7831                   input lc_gds-grp.node-code,
     7832                   input shop.host-code,
     7833                   input 'маг':U,
     7834                   input i-obj-code,
     7835                   input 'ban-sales-via-cd':U,
     7836                   output v-value,
     7837                   output v-type
     7838                   ).
     7839                if v-value = "yes" then
     7840                   return true.
     7841                else v-upper-code = lc_gds-grp.upper-code.
     7842             end .
     7843          end.
     7844         end.
     7845       end.
     7846   end.
     7847   FUNCTION convert-tax-code returns integer
     7848                                             ( input p-rate-code as integer
     7849                                              ,input p-cdtaxlst  as character
     7850                                             ) :
     7851   define variable jj as integer no-undo .
     7852     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7853       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7854         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7855       end.
     7856     end.
     7857   END FUNCTION.
     7858   FUNCTION convert-maria-tax-code returns character
     7859                                             ( input p-vat-rate-code as integer
     7860                                              ,input p-slt-rate-code as integer
     7861                                              ,input p-cdtaxlst  as character
     7862                                             ) :
     7863   define variable jj as integer no-undo .
     7864   define variable aa as character no-undo extent 8.
     7865   define variable v-return-value as character no-undo .
     7866     do jj = 1 to 8:
     7867       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7868         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7869           aa[jj] = '1'.
     7870         end.
     7871         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7872           aa[jj] = '1'.
     7873         end.
     7874       end.
     7875       if aa[jj] = '':U then aa[jj] = '0'.
     7876       v-return-value = aa[jj] + v-return-value.
     7877     end.
     7878   return v-return-value.
     7879   END FUNCTION.
     7880   FUNCTION convert-maria-tax-code-2 returns integer
     7881                                             ( input p-rate-code as integer
     7882                                              ,input p-cdtaxlst  as character
     7883                                             ) :
     7884   define variable jj as integer no-undo .
     7885   define variable v-return-value as integer no-undo .
     7886     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7887       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7888         return jj.
     7889       end.
     7890     end.
     7891   return 0.
     7892   END FUNCTION.
