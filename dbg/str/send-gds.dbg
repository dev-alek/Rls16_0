    11687     if v-attr-egais = 1 then do:
    11688           run bgelib-tag-open in this-procedure ( input 2, input "ItemMarkCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    11689                                             ,"ADD":U, OS2-time,cash-gds.b-code)).
    11690           find first buf_alc-type-gds where buf_alc-type-gds.gds-code = cash-gds.gds-code no-lock no-error.
    11691           find first buf_alc-type where buf_alc-type.alc-type-inner-code = buf_alc-type-gds.alc-type-inner-code no-lock no-error.
    11692           if available buf_alc-type then do:
    11693             run bgelib-tag-put in this-procedure ( input 3, input "IMarkCode" , input string(buf_alc-type.alc-type-code), input 1 ).
    11694           end.
