    16790         "0" v-char-delim-1
    16791         v-char-1
    16792         v-char-21
    16793         "4,1,0,"
    16794         "1" v-char-delim-1
    16795         v-char-3
    16796         v-char-42
    16797         "0" v-char-delim-1
    16798         v-char-5
    16799          v-char-delim-2
    16800         v-char-62 v-char-72 v-char-8 v-char-9 skip.
