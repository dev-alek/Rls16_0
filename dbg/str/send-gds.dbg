     8215                            and loc-bar-code.in-code = ""
     8216                            and loc-bar-code.part-code = ""
     8217                            and cash-gds.unit-base = cash-gds.unit-cli
     8218                            then yes
     8219                            else no)
     8220   cash-gds.obj-type = parobj-type
     8221   cash-gds.obj-code = parobj-code
     8222   .
     8223   assign
     8224   cash-gds.gds-name1 =   name-2cdf(
     8225                         input name-2cd
     8226                       , input yes
     8227                       , input cod-pcod
     8228                       , input cash-gds.b-code
     8229                       , input loc-goods.gds-code
     8230                       , input loc-goods.artic
     8231                       , input loc-goods.engl-name
     8232                       , input loc-bar-code.in-code
     8233                       , input loc-bar-code.part-code
     8234                       , input parobj-type
     8235                       , input parobj-code
     8236                       , input loc-goods.alpha1
     8237                       , output v-gtd
     8238                       )
     8239   cash-gds.gtd   = v-gtd
     8240   .
     8241   vKKT = 255.
     8242   find first b-code where
