    11674       if available buf_goods-attr then
    11675       do:
    11676         run bgelib-tag-put in this-procedure ( input 4, input "ItemCommodityCode" , input string( buf_goods-attr.attr-value), input 1 ).
    11677       end.
    11678   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
