     4580   procedure cd-attr-value :
     4581     define input  parameter p-db-num    like ub.cash-desk-attr.db-num        no-undo .
     4582     define input  parameter p-obj-code  like ub.cash-desk-attr.obj-code      no-undo .
     4583     define input  parameter p-pos-type  like ub.cash-desk-attr.pos-type      no-undo .
     4584     define input  parameter p-cash-num  like ub.cash-desk-attr.cash-num      no-undo .
     4585     define input  parameter p-ucode     like ub.cash-desk-attr.upper-attr-code      no-undo .
     4586     define input  parameter p-code      like ub.cash-desk-attr.attr-code      no-undo .
     4587     define output parameter p-character like ub.cash-desk-attr.attr-value-character    no-undo .
     4588     define output parameter p-date      like ub.cash-desk-attr.attr-value-date         no-undo .
