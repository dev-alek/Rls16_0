     2675   procedure xmlchar-decode :
     2676   define input parameter p-in-string      as character        no-undo.
     2677   define output parameter p-out-string    as character        no-undo.
     2678       define variable v-position      as integer      no-undo.
     2679       define variable v-last-position as integer      no-undo.
     2680       define variable v-temp-integer  as integer      no-undo.
     2681       define variable v-current-char  as character    no-undo.
     2682       define variable v-next-char     as character    no-undo.
     2683       define variable v-success       as logical      no-undo.
     2684   do
     2685   on error undo, return error
     2686   :
     2687       assign
     2688           p-out-string = "":U
     2689           v-position   = 0
     2690       .
     2691       replace-cycle:
     2692       do while yes
     2693       on error undo, return error
     2694       :
     2695           assign
     2696               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2697           .
     2698           if v-last-position <= v-position
     2699           then do:
     2700               if v-position = 0
     2701               then do:
     2702                   assign
     2703                       p-out-string = p-in-string
     2704                   .
     2705               end.
     2706               else do:
     2707                   assign
     2708                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2709                   .
     2710               end.
     2711               leave replace-cycle.
     2712           end.
     2713           else do:
     2714               assign
     2715                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2716                   v-position      = v-last-position
     2717                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2718               .
     2719               if v-current-char = "#":U
     2720               then do:
     2721                   assign
     2722                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2723                   .
     2724                   if v-last-position > 0
     2725                   then do:
     2726                       run xmlchar-read-integer in this-procedure
     2727                        (
     2728                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2729                           , output v-temp-integer
     2730                           , output v-success
     2731                       ).
     2732                       if v-success = yes
     2733                       and v-temp-integer >= 1
     2734                       and v-temp-integer <= 255
     2735                       then do:
     2736                           assign
     2737                               p-out-string = p-out-string + chr( v-temp-integer )
     2738                               v-position   = v-last-position + 1
     2739                           .
     2740                       end.
     2741                       else do:
     2742                           assign
     2743                               p-out-string = p-out-string + "&":U
     2744                               v-position   = v-position   + 1
     2745                           .
     2746                       end.
     2747                   end.
     2748                   else do:
     2749                       assign
     2750                           p-out-string = p-out-string + "&":U
     2751                           v-position   = v-position   + 1
     2752                       .
     2753                   end.
     2754               end.
     2755               else do:
     2756                   case substring( p-in-string, v-position + 1, 3 )
     2757                   :
     2758                       when "lt;":U
     2759                       then do:
     2760                           assign
     2761                               p-out-string = p-out-string + "<":U
     2762                               v-position   = v-position   + 3
     2763                           .
     2764                       end.
     2765                       when "gt;":U
     2766                       then do:
     2767                           assign
     2768                               p-out-string = p-out-string + ">":U
     2769                               v-position   = v-position   + 3
     2770                           .
     2771                       end.
     2772                       otherwise do:
     2773                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2774                           then do:
     2775                               assign
     2776                                   p-out-string = p-out-string + "&":U
     2777                                   v-position   = v-position   + 4
     2778                               .
     2779                           end.
     2780                           else do:
     2781                               case substring( p-in-string, v-position + 1, 5 )
     2782                               :
     2783                                   when "quot;":U
     2784                                   then do:
     2785                                       assign
     2786                                           p-out-string = p-out-string + '"':U
     2787                                           v-position   = v-position   + 5
     2788                                       .
     2789                                   end.
     2790                                   when "apos;":U
     2791                                   then do:
     2792                                       assign
     2793                                           p-out-string = p-out-string + "'":U
     2794                                           v-position   = v-position   + 5
     2795                                       .
     2796                                   end.
     2797                                   otherwise do:
     2798                                       assign
     2799                                           p-out-string = p-out-string + "&":U
     2800                                       .
     2801                                   end.
     2802                               end case.
     2803                           end.
     2804                       end.
     2805                   end case.
     2806               end.
     2807           end.
     2808       end.
     2809   end.
     2810   end .
     2811   procedure xmlchar-read-integer :
     2812   define input parameter p-input-string      as character        no-undo.
     2813   define output parameter p-output-integer   as integer          no-undo.
     2814   define output parameter p-success       as logical          no-undo.
     2815   do
     2816   on error undo, return error
     2817   :
     2818       assign
     2819           p-output-integer = integer( p-input-string )
     2820       no-error.
     2821       if error-status :error
     2822       then do:
     2823           assign
     2824               p-success           = no
     2825               p-output-integer    = 0
     2826           .
     2827       end.
     2828       else do:
     2829           assign
     2830               p-success           = yes
     2831           .
     2832       end.
     2833   end.
     2834   end.
     2835   define variable v-bgelib-bgeclall           as logical      no-undo.
     2836   define variable v-bgelib-bgedict            as logical      no-undo.
     2837   define temp-table temp_ext-doc-type no-undo
     2838       field edt-key               as integer
     2839       field ext-doc-type          as character
     2840       field ext-doc-type-label    as character
     2841       index pi is primary unique
     2842           edt-key
     2843   .
     2844   define temp-table temp_bgelib_goods no-undo
     2845       field gds-code as integer
     2846       index pi is primary unique
     2847           gds-code
     2848   .
     2849   define temp-table temp_bgelib_clients no-undo
     2850       field obj-type as character
     2851       field obj-code as integer
     2852       index pi is primary unique
     2853           obj-type
     2854           obj-code
     2855   .
     2856   define temp-table temp_bgelib_dis-card no-undo
     2857       field d-card as character
     2858       index pi is primary unique
     2859           d-card
     2860   .
     2861   define temp-table temp_bgelib_trn-doc no-undo
     2862       field doc-code as integer
     2863   .
     2864   procedure bgelib-tag-open:
     2865   do
     2866   on error undo, return error
     2867   :
     2868   define input parameter v-tag-level  as integer      no-undo.
     2869   define input parameter v-tag-name   as character    no-undo.
     2870   define input parameter v-tag-value  as character    no-undo.
     2871       put stream stmXMLOut unformatted
     2872           chr(10)
     2873           + fill(" ", 4 * v-tag-level)
     2874           + "<" + v-tag-name
     2875           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2876           + v-tag-value + ">"
     2877       .
     2878   end.
     2879   end procedure.
     2880   procedure bgelib-tag-put:
     2881   do
     2882   on error undo, return error
     2883   :
     2884   define input parameter v-tag-level      as integer      no-undo.
     2885   define input parameter v-tag-name       as character    no-undo.
     2886   define input parameter v-tag-value      as character    no-undo.
     2887   define input parameter v-empty-mode     as integer      no-undo.
     2888       v-tag-name = trim(v-tag-name).
     2889       if  v-empty-mode = 1
     2890       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2891       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2892       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2893       then do:
     2894           run xmlchar-encode in this-procedure (
     2895                 input v-tag-value
     2896               , output v-tag-value
     2897           ).
     2898           put stream stmXMLOut unformatted
     2899               chr(10) + fill(" ", 4 * v-tag-level)
     2900                           + '<' + v-tag-name + '>'
     2901                           + v-tag-value
     2902                           + '</' + v-tag-name + '>'
     2903           .
     2904       end.
     2905   end.
     2906   end procedure.
     2907   procedure bgelib-tag-close:
     2908   do
     2909   on error undo, return error
     2910   :
     2911   define input parameter v-tag-level as integer      no-undo.
     2912   define input parameter v-tag-name  as character    no-undo.
     2913       put stream stmXMLOut unformatted
     2914           chr(10)
     2915           + fill( " ", 4 * v-tag-level)
     2916           + '</' + v-tag-name + '>'
     2917       .
     2918   end.
     2919   end procedure.
     2920   procedure bgelib-write-log:
     2921   do
     2922   on error undo, return error
     2923   :
     2924   define input parameter v-filename   as character    no-undo.
     2925   define input parameter v-log-level  as integer      no-undo.
     2926   define input parameter v-out-string as character    no-undo.
     2927       output stream stmXMLLog to value( v-filename ) append.
     2928       put stream stmXMLLog unformatted
     2929           chr(10)
     2930       .
     2931       put stream stmXMLLog unformatted
     2932           ( if v-log-level = 0
     2933             or v-out-string = "&DLine"
     2934             or v-out-string = "&Line"
     2935             then ""
     2936             else cur-time-string-sec() + " " )
     2937       .
     2938       put stream stmXMLLog unformatted
     2939           ( if v-out-string = "&Line"
     2940             then fill( "-", 80 )
     2941             else if v-out-string = "&DLine"
     2942                  then fill( "=", 80 )
     2943                  else v-out-string )
     2944       .
     2945       output stream stmXMLLog close.
     2946   end.
     2947   end procedure.
     2948   procedure bgelib-write-edt:
     2949   do
     2950   on error undo, return error
     2951   :
     2952   define input parameter v-editor-handle    as handle       no-undo.
     2953   define input parameter v-log-level        as integer      no-undo.
     2954   define input parameter v-out-string       as character    no-undo.
     2955       if valid-handle ( v-editor-handle )
     2956       then do:
     2957           v-editor-handle :move-to-eof().
     2958           v-editor-handle :insert-string( ( if v-log-level = 0
     2959                                             or v-out-string = "&DLine"
     2960                                             or v-out-string = "&Line"
     2961                                             then ""
     2962                                             else cur-time-string-sec() + " "
     2963                                         ) ).
     2964           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2965                                             then fill( "-", 80 )
     2966                                             else if v-out-string = "&DLine" then fill("=", 80)
     2967                                             else fill( " ", v-log-level) + v-out-string
     2968                                         ) ).
     2969           v-editor-handle :insert-string( chr(10) ).
     2970       end.
     2971       process events.
     2972       output to 'bgescn.txt' append.
     2973           put unformatted
     2974               chr(10)
     2975               string( ( if v-log-level = 0
     2976                         or v-out-string = "&DLine"
     2977                         or v-out-string = "&Line"
     2978                         then ""
     2979                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2980                     ) )
     2981               string( ( if v-out-string = "&Line"
     2982                         then fill( "-", 80 )
     2983                         else if v-out-string = "&DLine"
     2984                              then fill( "=", 80 )
     2985                              else fill( " ", v-log-level ) + v-out-string
     2986                     ) )
     2987           .
     2988       output close.
     2989   end.
     2990   end procedure.
     2991   procedure bgelib-show-cnt:
     2992   do
     2993   on error undo, return error
     2994   :
     2995   define input parameter v-fillin-handle     as handle   no-undo.
     2996       if valid-handle( v-fillin-handle )
     2997       then do:
     2998           assign
     2999               v-fillin-handle :visible = true
     3000           .
     3001       end.
     3002   end.
     3003   end procedure.
     3004   procedure bgelib-hide-cnt:
     3005   do
     3006   on error undo, return error
     3007   :
     3008   define input parameter v-fillin-handle     as handle   no-undo.
     3009       if valid-handle( v-fillin-handle )
     3010       then do:
     3011           assign v-fillin-handle :visible = false.
     3012       end.
     3013   end.
     3014   end procedure.
     3015   procedure bgelib-write-cnt:
     3016   do
     3017   on error undo, return error
     3018   :
     3019   define input parameter v-fillin-handle    as handle       no-undo.
     3020   define input parameter v-fillin-string    as character    no-undo.
     3021       if valid-handle( v-fillin-handle )
     3022       then do:
     3023           assign
     3024               v-fillin-handle :SCREEN-value = v-fillin-string
     3025           .
     3026       end.
     3027   end.
     3028   end procedure.
     3029   procedure bgelib-write-header:
     3030   do
     3031   on error undo, return error
     3032   :
     3033   define input parameter p-first-file     as logical      no-undo.
     3034   define input parameter p-xml-file-name  as character    no-undo.
     3035   define input parameter p-list-file-name as character    no-undo.
     3036   define input parameter p-file-number    as integer      no-undo.
     3037   define input parameter p-have-prev      as logical      no-undo.
     3038   define input parameter p-prev-filename  as character    no-undo.
     3039   define input parameter p-obj-list       as character    no-undo.
     3040   define input parameter p-doc-type-list  as character    no-undo.
     3041   define input parameter p-parameter-list as character    no-undo.
     3042       define variable v-counter    as integer        no-undo.
     3043       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3044       put stream stmXMLOut unformatted
     3045           "<?xml version='1.0' encoding='windows-1251'?>"
     3046       .
     3047       run bgelib-tag-open( input 0, input "root"  , input "" ).
     3048       run bgelib-tag-open( input 0, input "header", input "" ).
     3049       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     3050       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     3051       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     3052       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     3053       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     3054       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     3055       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3056       :
     3057           run bgelib-tag-put(
     3058                 input 1
     3059               , input entry( 2 * v-counter, p-parameter-list )
     3060               , input entry( 2 * v-counter + 1, p-parameter-list )
     3061               , input 0
     3062           ).
     3063       end.
     3064       run bgelib-tag-close( input 0, input "header" ).
     3065       output stream stmXMLOut close.
     3066       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3067       if p-first-file = yes
     3068       then do:
     3069           put stream stmXMLOut unformatted
     3070               "<?xml version='1.0' encoding='windows-1251'?>"
     3071           .
     3072           run bgelib-tag-open( input 0, input "export", input "" ).
     3073       end.
     3074       run bgelib-tag-open( input 1, input "file", input "" ).
     3075       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     3076       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     3077       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     3078       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     3079       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     3080       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     3081       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3082       :
     3083           run bgelib-tag-put(
     3084                 input 2
     3085               , input trim(entry( 2 * v-counter, p-parameter-list ))
     3086               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     3087               , input 0
     3088           ).
     3089       end.
     3090       run bgelib-tag-close( input 1, input "file" ).
     3091       output stream stmXMLOut close.
     3092   end.
     3093   end procedure.
     3094   procedure bgelib-write-footer:
     3095   do
     3096   on error undo, return error
     3097   :
     3098   define input parameter p-last-file      as logical      no-undo.
     3099   define input parameter p-xml-file-name  as character    no-undo.
     3100   define input parameter p-list-file-name as character    no-undo.
     3101   define input parameter p-have-next      as logical      no-undo.
     3102   define input parameter p-next-file-name as character    no-undo.
     3103       define variable v-error-num     as integer           no-undo.
     3104       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3105       if p-have-next = yes
     3106       then do:
     3107           run bgelib-tag-open( input 0, input "footer", "" ).
     3108           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     3109           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     3110           run bgelib-tag-close( input 0, input "footer" ).
     3111       end.
     3112       run bgelib-tag-close( input 0, input "root" ).
     3113       output stream stmXMLOut close.
     3114       run bge/os_copy.p (
     3115             input "M"
     3116           , input p-xml-file-name + "tmp"
     3117           , input p-xml-file-name + "xml"
     3118           , output v-error-num
     3119       ).
     3120       if p-last-file = yes
     3121       then do:
     3122           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3123               run bgelib-tag-close( input 0, input "export" ).
     3124           output stream stmXMLOut close.
     3125           run bge/os_copy.p (
     3126                 input "M"
     3127               , input p-list-file-name + "tmp"
     3128               , input p-list-file-name + "xml"
     3129               , output v-error-num
     3130           ).
     3131       end.
     3132   end.
     3133   end procedure.
     3134   procedure bgelib-filename :
     3135   do
     3136   on error undo, return error
     3137   :
     3138   define input parameter p-prefix             as character    no-undo.
     3139   define output parameter p-xml-file-name     as character    no-undo.
     3140   define output parameter p-log-file-name     as character    no-undo.
     3141   define output parameter p-list-file-name    as character    no-undo.
     3142       define variable v-home-dir  as character    no-undo.
     3143       define variable v-error-num as integer      no-undo.
     3144       get-key-value section "BGE" key "outdir" value v-home-dir.
     3145       if v-home-dir = ?
     3146       then do:
     3147           message
     3148             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3149             skip(1)
     3150             skip "Обратитесь к администратору."
     3151           view-as alert-box error.
     3152           undo, return error .
     3153       end.
     3154       run gbl/dir-cre.p (
     3155           input v-home-dir
     3156       ) no-error.
     3157       if error-status :error
     3158       then do:
     3159           message
     3160             skip "Неверно задан каталог экспорта."
     3161             skip(1)
     3162             skip "Обратитесь к администратору."
     3163           view-as alert-box error.
     3164           undo, return error .
     3165       end.
     3166       run bge/genfname.p (
     3167             input v-home-dir
     3168           , input p-prefix
     3169           , input ""
     3170           , input "xml"
     3171           , input "tmp"
     3172           , output p-xml-file-name
     3173       ).
     3174       assign
     3175           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     3176           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     3177           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     3178       .
     3179   end.
     3180   end procedure.
     3181   procedure bgelib-read-config :
     3182   do
     3183   on error undo, return error
     3184   :
     3185   define variable v-par-type as character     no-undo.
     3186     define variable v-param-type      as character  no-undo .
     3187     define variable v-value-character as character  no-undo .
     3188     define variable v-value-date      as date       no-undo .
     3189     define variable v-value-decimal   as decimal    no-undo .
     3190     define variable v-value-integer   as integer    no-undo .
     3191     define variable v-value-logical   as logical    no-undo .
     3192     define variable v-tth             as handle     no-undo .
     3193       assign
     3194           v-bgelib-bgeclall = no
     3195           v-bgelib-bgedict  = no
     3196       .
     3197       run adm/shattri.p ( input "get":U
     3198                         , input  '':u
     3199                         , input  0
     3200                         , input  'bge-export':U
     3201                         , input  'bgeclall':U
     3202                         , output v-value-character
     3203                         , output v-value-date
     3204                         , output v-value-decimal
     3205                         , output v-value-integer
     3206                         , output v-value-logical
     3207                         , output v-param-type
     3208                         , input-output table-handle v-tth
     3209                         ) no-error .
     3210       if error-status :error
     3211       then do:
     3212         assign
     3213           v-bgelib-bgeclall = no
     3214         .
     3215       end.
     3216       else do:
     3217         assign
     3218           v-bgelib-bgeclall = v-value-logical
     3219         .
     3220       end.
     3221       delete object v-tth.
     3222       run adm/shattri.p ( input "get":U
     3223                         , input  '':u
     3224                         , input  0
     3225                         , input  'bge-export':U
     3226                         , input  'bgedict':U
     3227                         , output v-value-character
     3228                         , output v-value-date
     3229                         , output v-value-decimal
     3230                         , output v-value-integer
     3231                         , output v-value-logical
     3232                         , output v-param-type
     3233                         , input-output table-handle v-tth
     3234                         ) no-error .
     3235       if error-status :error
     3236       then do:
     3237         assign
     3238           v-bgelib-bgedict = no
     3239         .
     3240       end.
     3241       else do:
     3242         assign
     3243           v-bgelib-bgedict = v-value-logical
     3244         .
     3245       end.
     3246       delete object v-tth.
     3247       run adm/shattri.p ( input "get":U
     3248                         , input  '':u
     3249                         , input  0
     3250                         , input  'bge-export':U
     3251                         , input  'bgefmt':U
     3252                         , output v-value-character
     3253                         , output v-value-date
     3254                         , output v-value-decimal
     3255                         , output v-value-integer
     3256                         , output v-value-logical
     3257                         , output v-param-type
     3258                         , input-output table-handle v-tth
     3259                         ) no-error .
     3260       if error-status :error
     3261       then do:
     3262         assign
     3263           v-bgelib-bgefmt  = "xml":U
     3264         .
     3265       end.
     3266       else do:
     3267         assign
     3268           v-bgelib-bgefmt  = v-value-character
     3269         .
     3270       end.
     3271       delete object v-tth.
     3272       run adm/shattri.p ( input "get":U
     3273                         , input  '':u
     3274                         , input  0
     3275                         , input  'bge-export':U
     3276                         , input  'bgeflold':U
     3277                         , output v-value-character
     3278                         , output v-value-date
     3279                         , output v-value-decimal
     3280                         , output v-value-integer
     3281                         , output v-value-logical
     3282                         , output v-param-type
     3283                         , input-output table-handle v-tth
     3284                         ) no-error .
     3285       if error-status :error
     3286       then do:
     3287         assign
     3288           v-bgelib-bgeflold  = "old":U
     3289         .
     3290       end.
     3291       else do:
     3292         assign
     3293           v-bgelib-bgeflold  = v-value-character
     3294         .
     3295       end.
     3296       delete object v-tth.
     3297   end.
     3298   end procedure.
     3299   procedure bgelib-check-file-size :
     3300   do
     3301   on error undo, return error
     3302   :
     3303   define input parameter p-out-filename   as character    no-undo.
     3304   define output parameter p-is-big        as logical      no-undo.
     3305       define variable v-current-position    as integer        no-undo.
     3306       assign
     3307           v-current-position = seek( stmXMLOut )
     3308       .
     3309       if v-current-position / 1024 / 1024  >= 100
     3310       then do:
     3311           assign
     3312               p-is-big = yes
     3313           .
     3314       end.
     3315   end.
     3316   end procedure.
     3317   procedure bgelib-init-ext-doc-type :
     3318       define variable v-counter    as integer      no-undo.
     3319       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     3320   do
     3321   for buf_temp_ext-doc-type
     3322   on error undo, return error
     3323   :
     3324       empty temp-table buf_temp_ext-doc-type.
     3325       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3326       :
     3327           create buf_temp_ext-doc-type.
     3328           assign
     3329               buf_temp_ext-doc-type.edt-key               = v-counter
     3330               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3331               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3332           .
     3333       end.
     3334   end.
     3335   end procedure.
     3336   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3337   define variable v-xml-file-name     as character            no-undo.
     3338   define variable v-xml-file-name-path as character            no-undo.
     3339   define variable v-log-file-name     as character            no-undo.
     3340   define variable v-locked            as logical              no-undo.
     3341   define variable v-log-string        as character            no-undo.
     3342   define variable v-oper-num          as integer              no-undo.
     3343   define variable v-obj-list          as character            no-undo.
     3344   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
