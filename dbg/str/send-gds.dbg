    16555                 (( chk_dis-gds-rule.obj-type = 'орг':U  and chk_dis-gds-rule.obj-code = i-host-code ) or
    16556                  ( chk_dis-gds-rule.obj-type = 'маг':U and chk_dis-gds-rule.obj-code = i-obj-code  )) no-error .
    16557              if avail chk_dis-gds-rule then next _buf_dis-gds-rule .
    16558          end.
    16559          if buf_dis-gds-rule.obj-type = 'орг':U and buf_dis-gds-rule.obj-code = i-host-code then do:
    16560              find first chk_dis-gds-rule no-lock
    16561              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    16562                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
