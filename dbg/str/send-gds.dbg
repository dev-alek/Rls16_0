     2099       ASSIGN
     2100       buf_dis-gds-rule.rule-num = p-rule-num
     2101       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     2102       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     2103       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     2104       buf_dis-gds-rule.nonunique = p-nonunique
     2105       no-error.
     2106     end.
     2107   end procedure.
     2108   PROCEDURE cmp-disgdsru-write :
     2109   do
     2110   on error undo, return error
     2111   :
     2112     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     2113     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     2114     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     2115     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     2116     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     2117     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     2118     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     2119     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     2120     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     2121     define variable v-rule-label          as character no-undo .
     2122     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     2123     define buffer buf_dis-rule     for ub.dis-rule.
     2124     run disgdsru-name in this-procedure (
     2125                                         input  p-templ-rl-root
     2126                                         ,output v-rule-label
     2127                                         ) no-error .
     2128     if error-status :error then do:
     2129       undo, return error return-value .
     2130     end.
     2131     find first buf_tt0-dis-gds-rule exclusive-lock where
     2132                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2133             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2134             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2135             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2136             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2137             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2138             no-error .
     2139     if not available buf_tt0-dis-gds-rule then do:
     2140       create buf_tt0-dis-gds-rule .
     2141       assign
     2142       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2143       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2144       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2145       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2146       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2147       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2148       no-error
     2149       .
     2150     end.
     2151     find first buf_dis-rule no-lock where
     2152               buf_dis-rule.rule-num = p-rule-num.
     2153     ASSIGN
     2154     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2155     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     2156     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     2157     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2158     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2159     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     2160     no-error.
     2161     release buf_tt0-dis-gds-rule no-error .
     2162     if error-status:error then do:
     2163       undo, return error return-value .
     2164     end.
     2165   end.
     2166   END PROCEDURE.
     2167   define variable vss-include-info24 as character format "X(65)" no-undo
     2168   initial "@(#)$Workfile$ $Revision$".
     2169   define variable v-bgelib-bgefmt        as character         no-undo.
