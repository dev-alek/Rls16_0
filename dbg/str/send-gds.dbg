    16549         :
    16550          if buf_dis-gds-rule.obj-type = "" and buf_dis-gds-rule.obj-code = 0 then do:
    16551              find first chk_dis-gds-rule no-lock
    16552              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    16553                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
