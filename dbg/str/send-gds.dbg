    16058   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    16059     (input  par-obj-type
    16060     ,input  par-obj-code
    16061     ,output loc-host-code
    16062     )  .
    16063       find first loc-dis-gds-rule where
    16064                 loc-dis-gds-rule.gds-code = par-gds-code
    16065             and loc-dis-gds-rule.pos-type = dflt-cd
    16066             and loc-dis-gds-rule.obj-type = 'орг':U
    16067             and loc-dis-gds-rule.obj-code = loc-host-code
    16068             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    16069       if available loc-dis-gds-rule then do:
    16070         par-wgd-rule = loc-dis-gds-rule.rule-num.
    16071       end.
    16072       find first loc-dis-gds-rule where
    16073                 loc-dis-gds-rule.gds-code = par-gds-code
    16074             and loc-dis-gds-rule.pos-type = dflt-cd
    16075             and loc-dis-gds-rule.obj-type = 'орг':U
    16076             and loc-dis-gds-rule.obj-code = loc-host-code
    16077             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    16078       if available loc-dis-gds-rule then do:
