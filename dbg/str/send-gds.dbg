    13922     end.
    13923     if temp-tekka-tsk.is-script then do:
    13924       v-is-script117 = yes.
    13925     end.
    13926     delete temp-tekka-tsk.
    13927   end.
    13928   output stream IBMStream
    13929   close.
    13930   run write-log-and-file in p-log-handle (
    13931         input 1
    13932       , input log-file-name
    13933       , input 1
    13934       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
    13935                           , (out + fname)
    13936                           , chr(10)
    13937                           , (out + fname + '.tsk')
    13938                           )
    13939                                          ).
    13940   run str/runtekka.p (
    13941                        input parparentproc
