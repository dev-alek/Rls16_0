    10516             IBM-good-code-2 = b_code.
    10517           end.
    10518         end.
    10519       end.
    10520       else do:
    10521         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10522         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10523                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10524                              or
    10525                              cash-gds.bc-on-type = 'pglc':U)
    10526                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10527                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10528                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10529          if action <> "D":U then do:
    10530           is-sc = no.
    10531           find first request_prod-bc no-lock where
    10532                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10533           if not avail request_prod-bc then do :
    10534             if mask_s-c <> "" then do :
    10535               iii_ :
    10536               do iii = 1 to num-entries(mask_s-c) :
    10537                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10538                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10539                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10540                   if available request_prod-bc then leave iii_ .
    10541                 end.
    10542               end.
    10543             end.
    10544           end.
    10545           if avail request_prod-bc then do :
    10546             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10547   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
