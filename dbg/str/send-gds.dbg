     7937   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7938   PROCEDURE asc-gds.
     7939   DEFINE parameter buffer loc-goods for gds-list.
     7940   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7941   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7942   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
