    11598           case cash-dis-rule.value-type:
    11599             when integer('2':U) then do:
    11600               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(2), input 1 ).
    11601               run bgelib-tag-put in this-procedure ( input 4, input "IDCValue", input string(- cash-dis-rule.discnt-value * cash-gds.cli-base-rate),  input 1 ).
    11602             end.
