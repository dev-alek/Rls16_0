    16589                           v-is-weight = true
    16590                         .
    16591                     end.
    16592                 end.
    16593             end.
    16594             _bdr-attr:
    16595       for each  buf_dis-gds-rule-attr WHERE
    16596                buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
    16597            AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
    16598            AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
    16599            AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
    16600            AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
    16601            and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
    16602                     :
    16603              assign
    16604        v-upd = entry(2,buf_dis-gds-rule-attr.attr-value,",")
    16605                v-ean13 = entry(1,buf_dis-gds-rule-attr.attr-value,",")
    16606        .
    16607              if v-is-weight and length(v-ean13) = 5 then do:
    16608                  def var ncrsc-pfx as char no-undo init "23":U .
    16609                  def var ncrsc-frmt as char no-undo init "EAN13" .
    16610                  assign v-tmpchar = "" .
    16611   define variable vss-include-info143 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16612     define variable tmp-str143  as character no-undo.
    16613     define variable tmp-num143  as character no-undo.
    16614     define variable i143        as integer   no-undo.
    16615     define variable sum143      as integer   no-undo.
    16616     define variable len-code143 as integer   no-undo.
    16617     define variable varcont143  as logical   initial yes no-undo.
    16618     CASE ncrsc-frmt :
    16619       WHEN "EAN13" THEN do:
    16620         assign
    16621           tmp-str143 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "999999999999" )
    16622         .
    16623       end.
    16624       WHEN "EAN8" THEN do:
    16625         assign
    16626           tmp-str143 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "9999999" )
    16627         .
    16628       end.
    16629       OTHERWISE DO:
    16630           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    16631           view-as alert-box error.
    16632           return error.
    16633       END.
    16634     END CASE.
    16635     if varcont143 = yes then do:
    16636       if integer( substring( tmp-str143, 1, length( ncrsc-pfx ) ) ) <> 0
    16637       then do:
    16638         message
    16639           "Невозможно сформировать бар-код" SKIP
    16640           "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U)
    16641           view-as alert-box error title "подрезание кода".
    16642         return error.
    16643       end.
    16644       else do:
    16645         assign
    16646           v-tmpchar = ncrsc-pfx + substring( tmp-str143, length( ncrsc-pfx ) + 1, length( tmp-str143 ) - length( ncrsc-pfx ) )
    16647           len-code143    = length( v-tmpchar )
    16648         .
    16649         define variable v-sum-char143 as character no-undo .
    16650         assign
    16651           sum143 = 0
    16652         .
    16653         do i143 = 1 to len-code143 by 2
    16654         :
    16655           assign
    16656             v-sum-char143 = substr(v-tmpchar, len-code143 - i143 + 1, 1)
    16657           .
    16658           if v-sum-char143 < "0"
    16659           or v-sum-char143 > "9"
    16660           then do:
    16661             message
    16662               "Невозможно сформировать бар-код" skip
    16663               "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    16664               view-as alert-box error title "подсчет контрольной суммы".
    16665             return error.
    16666           end.
    16667           assign
    16668             sum143 = sum143 + integer(v-sum-char143)
    16669           .
    16670         end.
    16671         if varcont143 = yes then do:
    16672           assign
    16673             sum143 = sum143 * 3
    16674           .
    16675           do i143 = 2 to len-code143 by 2
    16676           :
    16677             assign
    16678               v-sum-char143 = substr(v-tmpchar, len-code143 - i143 + 1, 1)
    16679             .
    16680             if v-sum-char143 < "0"
    16681             or v-sum-char143 > "9"
    16682             then do:
    16683               message
    16684                 "Невозможно сформировать бар-код" skip
    16685                 "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    16686                 view-as alert-box error title "подсчет контрольной суммы".
    16687               return error.
    16688             end.
    16689             assign
    16690               sum143 = sum143 + integer(v-sum-char143)
    16691             .
    16692           end.
    16693           if varcont143 = yes then do:
    16694              if sum143 mod 10 = 0 then do:
    16695                assign
    16696                  v-tmpchar = v-tmpchar + '0'
    16697                .
    16698              end.
    16699              else do:
    16700                assign
    16701                  v-tmpchar = v-tmpchar + string(10 - sum143 mod 10)
    16702                .
    16703              end.
    16704           end.
    16705         end.
    16706       end.
    16707     end.
    16708                  if not v-tmpchar = "":U then assign v-ean13 = v-tmpchar .
    16709              end.
    16710              if v-ean13 begins "20" and length(v-ean13) = 13 then next _bdr-attr .
    16711        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    16712         buf_dis-gds-rule-attr.attr-code v-char-delim-1
    16713         "3,MAPKA,"
    16714         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    16715         "0" v-char-delim-1
    16716         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    16717         "0" v-char-delim-1
    16718         v-char-1
    16719         v-char-2
    16720         trim(string(buf_dis-rule.doc-qnty,'>>>>9')) v-char-delim-1
    16721         v-char-3
    16722               v-ean13 v-char-delim-2
    16723         v-char-4
    16724         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    16725         v-char-5
    16726               v-ean13 v-char-delim-2
    16727         v-char-6 v-char-7 skip.
    16728       end.
    16729      end.
    16730    end.
    16731    for each buf_dis-thbj-rule no-lock where buf_dis-thbj-rule.templ-rl-root = 90
    16732                      and buf_dis-thbj-rule.pos-type = 'NCR-AS@R':U,
    16733       first buf_dis-rule no-lock where
    16734           buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
    16735       and buf_dis-rule.sts = integer('0':U),
    16736       first buf_dis-time-rule no-lock
    16737         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    16738           and buf_dis-time-rule.date-to >= v-today
    16739         :
