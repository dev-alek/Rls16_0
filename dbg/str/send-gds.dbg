     7986       for-price = ?.
     7987   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7989     (input  'маг':U
     7990     ,input  ub.shop.obj-code
     7991     ,input  loc-bar-code.b-code
     7992     ,input  main-b-code
     7993     ,input  0
     7994     ,output v-doc-num
     7995     ,output for-price
     7996     ,output for-road
     7997     ,output for-excise
     7998     ) no-error .
     7999       if error-status:error then do:
     8000           if g#news
     8001           or g#auto
     8002           or g#esys
     8003           then return error.
     8004           else do:
     8005               error-status:error = no.
     8006               message "Ошибка при определении цены на товар "
     8007                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     8008               view-as alert-box ERROR.
     8009               return.
     8010           end.
     8011       end.
     8012       if return-value = "error" then do:
     8013           if for-price = ? then do:
     8014             return.
     8015           end.
     8016           if not g#news
     8017           and not g#auto
     8018           and not g#esys
     8019           then
     8020           message prichina view-as alert-box ERROR.
     8021           return error.
     8022       end.
     8023       else if (for-price = ? or for-price = 0) then do:
     8024         if v-is-restaurant and v-is-null-price  then do:
     8025           assign
     8026           for-price = 0.
     8027         end.
     8028         else do:
     8029           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     8030                                                  ,input 'null-price':U
     8031                                                  ,output v-gds-null-price
     8032                                                  ,output v-type) no-error.
     8033           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     8034           return "NEXT".
     8035         end.
     8036       end.
     8037     end.
     8038     else do:
     8039           for-price = 0.
     8040     end.
     8041   for-price = round-m( for-price , rnd-znak ).
     8042   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     8043   start-paket = no.
     8044   if not avail cash-gds then do:
     8045   create cash-gds.
     8046   error-status:error = false.
     8047   end.
     8048   cash-gds.crf = cr + 1.
     8049   cr = cr + 1.
     8050   if loc-bar-code.in-code <> ''
     8051   or loc-bar-code.part-code <> ''
