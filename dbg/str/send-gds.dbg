     5895   procedure gds-attr_gds-ptrl-densities :
     5896     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     5897     define input-output  parameter p-value as character no-undo .
     5898     define output parameter p-setted      as logical no-undo .
     5899     do
