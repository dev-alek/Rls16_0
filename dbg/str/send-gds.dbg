    14005   end.
    14006   run cd-mrkt_update-marketer in this-procedure (
    14007                                                   input for-cash-desk.db-num
    14008                                                   ,input for-cash-desk.obj-code
    14009                                                   ,input for-cash-desk.pos-type
    14010                                                   ,input for-cash-desk.cash-num
    14011                                                   ,input no
    14012                                                 )  .
    14013       if
    14014   v-del-mrkt-gds
    14015       then do:
    14016   define variable vss-include-info118 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14017   define variable vss-include-info119 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14018   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
    14019       v-record = fill( chr(63) + chr(4), 7).
    14020   define variable v-marketer-action as character no-undo .
    14021   FOR EACH buf_cd-plu where
    14022           buf_cd-plu.obj-type = 'маг':U
    14023       and buf_cd-plu.obj-code = abs(i-obj-code)
    14024       and buf_cd-plu.pos-type = 'MARIA':U
    14025       and buf_cd-plu.plu-type = '':U :
    14026     if buf_cd-plu.to-del then do:
    14027       create temp-cd-plu.
    14028       buffer-copy buf_cd-plu
    14029       to temp-cd-plu
    14030       .
    14031       assign
    14032       v-plu = TRIM(string( buf_cd-plu.plu-code, "X(40)":U ))
    14033       v-marketer-action = 'd'
    14034       .
    14035   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14036   assign
    14037   v-plu = substring(v-plu, length(v-plu) - 4 + 1)
    14038   .
    14039   if v-marketer-action <> 'd'
    14040   and available cash-gds
    14041   and (cash-gds.grp-code > 99
    14042   or cash-gds.price-sale * 100 >  999999999.0)
    14043   then do:
    14044       if cash-gds.grp-code > 99 then
    14045       run write-log-and-file in p-log-handle (
    14046             input 1
    14047           , input log-file-name
    14048           , input 1
    14049           , input substitute("!!!Товар &1 не может быть передан на кассу &2 &3&4 - № группы на кассе &5 > 99!&6" +
    14050                               "пропускается...."
    14051                               , cash-gds.gds-code
    14052                               , for-cash-desk.pos-type
    14053                               , 'маг':U
    14054                               , i-obj-code
    14055                               , cash-gds.grp-code
    14056                               , chr(10)
    14057                               )
    14058                                 ).
    14059       if cash-gds.price-sale * 100 >  999999999.0 then
    14060       run write-log-and-file in p-log-handle (
    14061             input 1
    14062           , input log-file-name
    14063           , input 1
    14064           , input substitute("!!!Товар &1 не может быть передан на кассу &2 &3&4 - цена &5 > 999999999!&6" +
    14065                               "пропускается...."
    14066                               , cash-gds.gds-code
    14067                               , for-cash-desk.pos-type
    14068                               , 'маг':U
    14069                               , i-obj-code
    14070                               , cash-gds.price-sale
    14071                               , chr(10)
    14072                               )
    14073                                 ).
    14074       v-view-log = yes.
    14075   end.
    14076   else do:
    14077     if (v-marketer-action <> 'd'
