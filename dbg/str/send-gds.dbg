    15825   define variable vss-include-info139 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15826   PROCEDURE putc-13.
    15827   define parameter buffer buf_cash-desk for ub.cash-desk.
    15828   define input parameter pos-type as char no-undo.
    15829   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    15830   define input parameter p-call-from-goods as logical no-undo .
    15831   define variable ii as integer no-undo .
    15832   define variable v-rate-code like ub.tax-rate.rate-code no-undo .
    15833   define variable v-envd as LOGICAL no-undo .
    15834   define variable v-plu as integer no-undo .
    15835   define buffer buf_tax-rate for ub.tax-rate.
    15836   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
    15837   if cash-txr.rate-value = ?
    15838   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
    15839   then do:
    15840       run write-log-and-file in p-log-handle (
    15841             input 1
    15842           , input log-file-name
    15843           , input 1
    15844           , input substitute( "!!!Для маг &1 ставка налога &2 НЕ ОПРЕДЕЛЕНА"
    15845                               ,buf_cash-desk.obj-code
    15846                               ,cash-txr.rate-code
    15847                             )
    15848                                             ).
    15849       v-view-log = yes.
    15850       return '':U .
    15851   end.
    15852   CASE pos-type:
    15853     when 'IBM':U then do:
    15854      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
    15855         PUT stream IBMstream unformatted
    15856         '13 "'
    15857         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15858         then "D"
    15859         else string( action, "x(1)" )
    15860         '" '
    15861         cash-txr.tax-code format "9"
    15862         ' '
    15863         cash-txr.rate-code
    15864         ' '
    15865         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15866         (if cash-txr.rate-value = ?
    15867           then 0
    15868           else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15869         chr(10).
    15870       end.
    15871       else do:
    15872         _do:
    15873         do ii = 1 to num-entries(cdtaxlst, ";":U):
    15874           assign
    15875           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
    15876           no-error .
    15877           if error-status:error then do:
    15878             message
    15879             "Неверное значение настроечного параметра cdtaxlst" cdtaxlst
    15880             view-as alert-box error .
    15881             return error .
    15882           end.
    15883           find first buf_tax-rate no-lock where
    15884                     buf_tax-rate.rate-code = v-rate-code no-error .
    15885           if not available buf_tax-rate then do:
    15886             run write-log-and-file in p-log-handle (
    15887                   input 1
    15888                 , input log-file-name
    15889                 , input 1
    15890                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
    15891                                     ,buf_cash-desk.obj-code
    15892                                     ,v-rate-code
    15893                                     ,buf_Cash-desk.pos-type
    15894                                   )
    15895                                                   ).
    15896             v-view-log = yes.
    15897             return error .
    15898           end.
    15899           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
    15900             PUT stream IBMstream unformatted
    15901             '13 "'
    15902             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15903             then "D"
    15904             else string( action, "x(1)" )
    15905             '" '
    15906             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
    15907             ' '
    15908             cash-txr.rate-code
    15909             ' '
    15910             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15911             (if cash-txr.rate-value = ?
    15912             then 0
    15913             else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15914             chr(10).
    15915           end.
    15916         end.
    15917       end.
    15918     end.
    15919     when 'IBM-XML':U then do:
    15920         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
    15921                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
    15922                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
    15923          if AVAILABLE buf_tax-rate-attr then do:
    15924              v-envd = yes .
    15925          end.
    15926          else v-envd = no .
    15927       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15928                                             , input "":U).
    15929       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15930                                             , input string(cash-txr.rate-code), input 1 ).
    15931       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15932                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15933       if v-envd then do:
    15934       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15935                                             , input string(-1), input 1 ).
    15936       end.
    15937       else do:
    15938       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15939                                             , input string(if cash-txr.rate-value = ?
    15940                                                            then 0
    15941                                                            else cash-txr.rate-value), input 1 ).
    15942       end.
    15943       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15944                                             , input string(1), input 1 ).
    15945       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15946     end.
    15947     when 'MAGIA-XML':U then do:
    15948       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15949                                             , input "":U).
    15950       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15951                                             , input string(cash-txr.rate-code), input 1 ).
    15952       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15953                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15954       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15955                                             , input string(if cash-txr.rate-value = ?
    15956                                                            then 0
    15957                                                            else cash-txr.rate-value), input 1 ).
    15958       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15959                                             , input string(1), input 1 ).
    15960       run bgelib-tag-put in this-procedure ( input 4, input "TCLock"
    15961                                             , input string(if cash-txr.news-action
    15962                                                            OR cash-txr.status_ <> 'тек':U
    15963                                                            then 1
    15964                                                            else 0), input 1 ).
    15965       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15966     end.
    15967     when 'MARIA':U then do:
    15968     end.
    15969   END CASE .
    15970   END PROCEDURE .
    15971   procedure get-o-attr :
    15972   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    15973   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    15974   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    15975   define output parameter par-std-discnt-rule as integer no-undo .
    15976   define output parameter par-temp-disc-rule as integer no-undo .
    15977   define output parameter par-temp-disc-method as character no-undo .
    15978   define output parameter par-wd-rule as integer no-undo .
    15979   define output parameter par-fp as logical no-undo .
    15980   define output parameter par-grp-code as integer no-undo init 1.
    15981   define output parameter par-petrol-purse as logical no-undo .
    15982   define output parameter par-need-auth as logical no-undo .
    15983   define output parameter par-qnty-discnt-rule as integer no-undo .
    15984   define output parameter par-kat-discnt-rule as integer no-undo .
    15985   define output parameter par-kat-discnt-method as character no-undo .
    15986   define output parameter par-date-discnt-rule as integer no-undo .
    15987   define output parameter par-abs-discnt-rule as integer no-undo .
    15988   define output parameter par-tot-discnt-rule as integer no-undo .
    15989   define output parameter par-wgd-rule as integer no-undo .
    15990   define output parameter par-taracode as character no-undo .
    15991   define buffer loc-gds-obj-attr for ub.gds-obj-attr.
    15992   define buffer loc-dis-gds-rule for ub.dis-gds-rule.
    15993   define buffer buf_dis-rule for ub.dis-rule.
    15994   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
    15995   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    15996     do
    15997     on error undo, return error
    15998     :
    15999       for each  loc-gds-obj-attr No-LOCK  where
    16000                 loc-gds-obj-attr.gds-code = par-gds-code AND
    16001                 loc-gds-obj-attr.obj-code = par-obj-code AND
    16002                 loc-gds-obj-attr.obj-type = par-obj-type :
    16003         CASE loc-gds-obj-attr.attr-code:
    16004           when 'free-price':U  then do:
    16005             assign
    16006             par-fp =  if loc-gds-obj-attr.attr-value = "yes"
    16007                       then yes
    16008                       else no
    16009             .
    16010           end.
    16011           when 'sum-grp':U then do:
    16012             assign
    16013             par-grp-code =  integer(loc-gds-obj-attr.attr-value) no-error
    16014             .
    16015           end.
    16016           when 'petrol-purse':U then do:
    16017             assign
    16018             par-petrol-purse =  if loc-gds-obj-attr.attr-value = "yes"
    16019                                 then yes
    16020                                 else no
    16021             .
    16022           end.
    16023           when 'need-auth':U then do:
    16024             assign
    16025             par-need-auth =  if loc-gds-obj-attr.attr-value = "yes"
    16026                                 then yes
    16027                                 else no
    16028             .
    16029           end.
    16030           when 'taracode':U  then do:
    16031             assign
    16032             par-taracode = loc-gds-obj-attr.attr-value no-error
    16033             .
    16034           end.
    16035         END CASE.
    16036       end.
    16037       define variable v-par-log as logical no-undo .
    16038      find first loc-dis-gds-rule where
    16039                 loc-dis-gds-rule.gds-code = par-gds-code
    16040             and loc-dis-gds-rule.pos-type = dflt-cd
    16041             and loc-dis-gds-rule.obj-type = ''
    16042             and loc-dis-gds-rule.obj-code = 0
    16043             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    16044       if available loc-dis-gds-rule then do:
    16045         par-wgd-rule = loc-dis-gds-rule.rule-num.
    16046       end.
    16047       find first loc-dis-gds-rule where
    16048                 loc-dis-gds-rule.gds-code = par-gds-code
    16049             and loc-dis-gds-rule.pos-type = dflt-cd
    16050             and loc-dis-gds-rule.obj-type = ''
    16051             and loc-dis-gds-rule.obj-code = 0
