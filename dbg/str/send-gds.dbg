     8053     find first main-prt-bar-code no-lock where
     8054               main-prt-bar-code.gds-code = loc-goods.gds-code
     8055           and main-prt-bar-code.node-code = loc-bar-code.node-code
     8056           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     8057           and main-prt-bar-code.part-code = ''
     8058           and main-prt-bar-code.in-code = '' no-error.
     8059     if available main-prt-bar-code then do:
     8060       v-main-prt-b-code = main-prt-bar-code.b-code.
     8061     end.
     8062   end.
     8063   else do:
     8064     v-main-prt-b-code = loc-bar-code.b-code.
     8065   end.
     8066   find first tt-tax no-lock where
     8067              tt-tax.tax-code = vattaxcd no-error .
     8068   do iii = 1 to num-entries(mask_s-c) :
     8069     assign
     8070       v-mask-full  = trim(entry(iii, mask_s-c))
     8071       v-mask-short = entry(1, v-mask-full, "*")
     8072       loc-prod-bc  = trim(loc-prod-bc)
     8073     .
     8074     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     8075       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     8076   end.
     8077   define variable vBc-on as logical no-undo.
     8078   if loc-prod-bc ne ?
     8079   then do:
     8080       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     8081                            and prod-bc.b-str  eq loc-prod-bc
