     3709   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3710   define variable v-is-closed-shift-journal as integer no-undo .
     3711   assign
     3712   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3713                               +
     3714                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3715                               +
     3716                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3717   .
     3718   return v-is-closed-shift-journal.
     3719   END FUNCTION.
     3720   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3721   define variable v-is-first-journal as logical no-undo .
     3722   assign
     3723   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3724                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3725                     or (p-journal-num =  integer(entry(1, '17':U)))
     3726                     or (p-journal-num = integer(entry(1, '16':U)))
     3727   .
     3728   return v-is-first-journal.
     3729   END FUNCTION.
     3730   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3731   define variable v-is-petrol-journal as logical no-undo .
     3732   assign
     3733   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3734   return v-is-petrol-journal.
     3735   END FUNCTION.
     3736   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3737   define variable v-max-record-num as integer no-undo .
     3738   assign
     3739   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3740                       then 1489
     3741                       else 2340).
     3742   return v-max-record-num.
     3743   END FUNCTION.
     3744   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3745   define variable v-max-record-num as integer no-undo .
     3746   assign
     3747   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3748                       then 1489 * num-entries('30,31,32,33':U)
     3749                       else 2340 * num-entries('17':U)).
     3750   return v-max-record-num.
     3751   END FUNCTION.
     3752   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3753                                           ,input p-rec-no as integer):
     3754   define variable v-num-recs as integer no-undo .
     3755   if tekka-is-petrol-journal (p-journal-num) then do:
     3756     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3757       assign
     3758       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3759       .
     3760     end.
     3761     else do:
     3762       assign
     3763       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3764       .
     3765     end.
     3766   end.
     3767   else do:
     3768     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3769       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3770         assign
     3771         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3772         .
     3773       end.
     3774       else do:
     3775         assign
     3776         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3777         .
     3778       end.
     3779     end.
     3780     else do:
     3781       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3782         assign
     3783         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3784         .
     3785       end.
     3786       else do:
     3787         assign
     3788         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3789         .
     3790       end.
     3791     end.
     3792   end.
     3793   return v-num-recs.
     3794   END FUNCTION.
     3795   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3796                                              ,input p-is-petrol as logical
     3797                                              ,input p-is-current as logical
     3798                                              ,output p-rec-no as decimal
     3799                                              ):
     3800   define variable v-obj-num0 as integer no-undo .
     3801   define variable v-obj-num as integer no-undo .
     3802   define variable v-obj-num2 as integer no-undo .
     3803   define variable p-num-recs2 as integer no-undo .
     3804   define variable p-rec-no2 as integer no-undo .
     3805   if p-is-petrol then do:
     3806     assign
     3807     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3808     .
     3809     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3810     then
     3811     assign
     3812     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3813     p-rec-no = p-num-recs modulo 1489
     3814     .
     3815     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3816     then
     3817     assign
     3818     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3819     p-rec-no = p-num-recs modulo 1489
     3820     .
     3821   end.
     3822   else do:
     3823     assign
     3824     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3825     p-num-recs = trunc(p-num-recs, 0)
     3826     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3827     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3828     .
     3829     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3830     then
     3831     assign
     3832     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3833     p-rec-no = p-num-recs modulo 2340
     3834     .
     3835     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3836     then
     3837     assign
     3838     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3839     p-rec-no = p-num-recs modulo 2340
     3840     .
     3841     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3842     then
     3843     assign
     3844     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3845     p-rec-no2 = p-num-recs2 modulo 2978
     3846     .
     3847     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3848     then
     3849     assign
     3850     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3851     p-rec-no2 = p-num-recs2 modulo 2978
     3852     .
     3853     assign
     3854     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3855     .
     3856   end.
     3857   if v-obj-num = 0 then v-obj-num = 100.
     3858   return v-obj-num.
     3859   END FUNCTION.
     3860   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3861   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3862   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3863      if p-is-ptrl then
     3864      return integer(entry(1, '26,27,28,29':U)).
     3865      if not p-is-ptrl then
     3866      return integer(entry(1, '16':U)).
     3867   end.
     3868   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3869   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3870   return 0.
     3871   END FUNCTION.
     3872   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3873   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3874   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3875     if p-is-ptrl then
     3876     return integer(entry(1, '26,27,28,29':U)).
     3877     if not p-is-ptrl then
     3878     return integer(entry(1, '16':U)).
     3879   end.
     3880   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3881   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3882   return 0.
     3883   END FUNCTION.
     3884   PROCEDURE maria-put:
     3885   define parameter buffer buf_cash-desk for ub.cash-desk.
     3886   define input parameter p-out    as character no-undo .
     3887   define input parameter p-fname as character no-undo .
     3888   define input parameter p-by-record as logical no-undo .
     3889   define input parameter p-shift-fields as integer no-undo .
     3890   define input parameter p-binary as logical no-undo .
     3891   define input parameter p-obj-num as integer no-undo .
     3892   define input parameter p-max-records as integer no-undo .
     3893   define input parameter p-plu as integer no-undo .
     3894   define input parameter p-value as character no-undo .
     3895   define variable v-file-name as character no-undo .
     3896   define variable v-create as logical no-undo .
     3897   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3898   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3899   output stream IBMSTREAM
     3900   to value(v-file-name) append .
     3901   Put  stream IBMSTREAM unformatted
     3902   p-plu
     3903   chr(3)
     3904   p-value
     3905   skip.
     3906   output stream IBMSTREAM
     3907   close.
     3908   if not p-by-record then do:
     3909     find first buf_temp-tekka-tsk where
     3910               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3911     if not available buf_temp-tekka-tsk then do:
     3912       v-create = yes.
     3913     end.
     3914   end.
     3915   else do:
     3916     find first buf_temp-tekka-tsk where
     3917               buf_temp-tekka-tsk.filename  = v-file-name
     3918           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3919     if not available buf_temp-tekka-tsk
     3920     then do:
     3921       find first buf_temp-tekka-tsk where
     3922                 buf_temp-tekka-tsk.filename  = v-file-name
     3923             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3924       if not available buf_temp-tekka-tsk
     3925       then do:
     3926         v-create = yes.
     3927       end.
     3928     end.
     3929   end.
     3930   if v-create then do:
     3931     create buf_temp-tekka-tsk.
     3932     assign
     3933     buf_temp-tekka-tsk.filename = v-file-name
     3934     buf_temp-tekka-tsk.range    = p-plu
     3935     buf_temp-tekka-tsk.obj-num = p-obj-num
     3936     buf_temp-tekka-tsk.obj-name = '':U
     3937     buf_temp-tekka-tsk.num-records = 0
     3938     buf_temp-tekka-tsk.max-records = p-max-records
     3939     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3940     buf_temp-tekka-tsk.task-num = p-fname
     3941     buf_temp-tekka-tsk.by-record = p-by-record
     3942     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3943     buf_temp-tekka-tsk.binary = p-binary
     3944     buf_temp-tekka-tsk.send-get = 'send'
     3945     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3946     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3947     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3948     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3949                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3950                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3951                                 then 'local'
     3952                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3953     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3954     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3955     buf_temp-tekka-tsk.waiting-sek = 30
     3956     buf_temp-tekka-tsk.min-plu     = p-plu
     3957     buf_temp-tekka-tsk.max-plu     = p-plu
     3958     .
     3959   end.
     3960   assign
     3961   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3962   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3963   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3964   .
     3965   END PROCEDURE.
     3966   PROCEDURE maria-get:
     3967   define parameter buffer buf_cash-desk for ub.cash-desk.
     3968   define input parameter p-out    as character no-undo .
     3969   define input parameter p-fname as character no-undo .
     3970   define input parameter p-by-record as logical no-undo .
     3971   define input parameter p-obj-num as integer no-undo .
     3972   define input parameter p-num-fields as integer no-undo .
     3973   define input parameter p-max-records as integer no-undo .
     3974   define input parameter p-min-plu as integer no-undo .
     3975   define input parameter p-max-plu as integer no-undo .
     3976   define input parameter p-other as character no-undo .
     3977   define input parameter p-order-num as integer no-undo .
     3978   define variable v-file-name as character no-undo .
     3979   define variable v-secondary-obj-num as character no-undo .
     3980   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3981   if p-by-record then do:
     3982     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3983   end.
     3984   else do:
     3985     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3986   end.
     3987   find first buf_temp-tekka-tsk where
     3988             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3989   if not available buf_temp-tekka-tsk then do:
     3990     create buf_temp-tekka-tsk.
     3991     assign
     3992     buf_temp-tekka-tsk.filename = v-file-name
     3993     buf_temp-tekka-tsk.obj-num = p-obj-num
     3994     buf_temp-tekka-tsk.obj-name = '':U
     3995     buf_temp-tekka-tsk.max-records = p-max-records
     3996     buf_temp-tekka-tsk.num-fields = p-num-fields
     3997     buf_temp-tekka-tsk.task-num = p-fname
     3998     buf_temp-tekka-tsk.by-record = p-by-record
     3999     buf_temp-tekka-tsk.send-get = 'get'
     4000     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     4001     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     4002     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     4003     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     4004                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     4005                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     4006                                   then 'local'
     4007                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     4008     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     4009     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     4010     buf_temp-tekka-tsk.waiting-sek = 30
     4011     buf_temp-tekka-tsk.min-plu     = p-min-plu
     4012     buf_temp-tekka-tsk.max-plu     = p-max-plu
     4013     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     4014                                       and p-max-plu <> ?
     4015                                       then p-max-plu - p-min-plu + 1
     4016                                       else 0)
     4017     buf_temp-tekka-tsk.other-info = p-other
     4018     buf_temp-tekka-tsk.order-num = p-order-num
     4019     .
     4020     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     4021       assign
     4022       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     4023       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     4024       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     4025       no-error
     4026       .
     4027       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     4028     end.
     4029   end.
     4030   END PROCEDURE.
     4031   PROCEDURE maria-task:
     4032   define parameter buffer buf_cash-desk for ub.cash-desk.
     4033   define input parameter p-fname as character no-undo .
     4034   define input parameter p-obj-num-list as character no-undo .
     4035   define input parameter p-parameters as character no-undo .
     4036   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     4037   find first buf_temp-tekka-tsk where
     4038             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     4039   if not available buf_temp-tekka-tsk then do:
     4040     create buf_temp-tekka-tsk.
     4041     assign
     4042     buf_temp-tekka-tsk.filename = ''
     4043     buf_temp-tekka-tsk.range = 1
     4044     buf_temp-tekka-tsk.obj-num = 0
     4045     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     4046     buf_temp-tekka-tsk.task-num = p-fname
     4047     buf_temp-tekka-tsk.by-record = no
     4048     buf_temp-tekka-tsk.send-get = 'task'
     4049     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     4050     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     4051     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     4052     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     4053                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     4054                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     4055                                   then 'local'
     4056                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     4057     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     4058     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     4059     buf_temp-tekka-tsk.waiting-sek = 30
     4060     buf_temp-tekka-tsk.other-info = p-parameters
     4061     buf_temp-tekka-tsk.order-num = 0
     4062     .
     4063   end.
     4064   END PROCEDURE.
     4065   procedure tekkatsk-verify-schema :
     4066   define input parameter p-obj-list as character no-undo .
     4067   define input parameter p-dir-path as character no-undo .
     4068   define variable v-obj-num as integer no-undo .
     4069   define variable v-obj-name as character no-undo .
     4070   define variable v-num-records as integer no-undo .
     4071   define variable v-size_ as integer no-undo .
     4072   define variable v-value as character no-undo .
     4073   define variable ii as integer no-undo .
     4074   define variable jj as integer no-undo .
     4075   define variable ii-ibs as integer no-undo .
     4076   define variable ii-tekka as integer no-undo .
     4077   define variable v-result as character no-undo .
     4078   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     4079   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     4080     do
     4081     on error undo, return error
     4082     :
     4083        for each buf_temp-tekka-schema:
     4084          delete buf_temp-tekka-schema.
     4085        end.
     4086        input from value('tekkasch.d').
     4087        repeat :
     4088          create buf_temp-tekka-schema.
     4089          import buf_temp-tekka-schema.
     4090          assign
     4091          buf_temp-tekka-schema.host = 'IBS'
     4092          ii = ii + 1.
     4093          .
     4094        end.
     4095        input close.
     4096        ii-ibs = ii.
     4097         _ii:
     4098         do ii = 1 to 256:
     4099           if p-obj-list = "ALL"
     4100           or lookup(string(ii), p-obj-list) > 0 then do:
     4101             assign
     4102             v-obj-num = 0
     4103             v-obj-name = ''
     4104             v-num-records = 0
     4105             v-size_ = 0
     4106             .
     4107             run alienini-getkey in this-procedure (
     4108                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4109                                                     ,input ('obj' + string(ii, '999'))
     4110                                                     ,input 'oname'
     4111                                                     ,output v-value) no-error .
     4112             if v-value = ? then next _ii.
     4113             assign
     4114             v-obj-num = ii
     4115             v-obj-name = v-value
     4116             .
     4117             run alienini-getkey in this-procedure (
     4118                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4119                                                     ,input ('obj' + string(ii, '999'))
     4120                                                     ,input 'size'
     4121                                                     ,output v-value) no-error .
     4122             assign
     4123             v-num-records = integer(v-value) no-error  .
     4124             if error-status:error
     4125             or v-num-records = 0 then next _ii.
     4126             run alienini-getkey in this-procedure (
     4127                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4128                                                     ,input 'obj' + string(ii, '999')
     4129                                                     ,input 'f000'
     4130                                                     ,output v-value) no-error .
     4131             assign
     4132             v-size_ = integer(v-value) no-error  .
     4133             if error-status:error
     4134             or v-size_ = 0 then next _ii.
     4135             _jj:
     4136             do jj = 1 to 256:
     4137               run alienini-getkey in this-procedure (
     4138                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4139                                                       ,input 'obj' + string(ii, '999')
     4140                                                       ,input 'f' + string(jj, '999')
     4141                                                       ,output v-value) no-error .
     4142               if v-value = ? then next _ii.
     4143               create buf_temp-tekka-schema.
     4144               assign
     4145               buf_temp-tekka-schema.host = 'tekka'
     4146               buf_temp-tekka-schema.obj-num = v-obj-num
     4147               buf_temp-tekka-schema.obj-name = v-obj-name
     4148               buf_temp-tekka-schema.num-records = v-num-records
     4149               buf_temp-tekka-schema.size_ = v-size_
     4150               buf_temp-tekka-schema.field-num = jj
     4151               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     4152               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     4153                                                  then entry(2, entry(2, v-value, '#'), ':')
     4154                                                  else '':U)
     4155               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     4156               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     4157               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     4158                                                           , 'C,I,I,I,D,D,D,D,D':U)
     4159               no-error
     4160               .
     4161               if error-status:error then do:
     4162                 delete buf_temp-tekka-schema.
     4163                 next _jj.
     4164               end.
     4165               run alienini-getkey in this-procedure (
     4166                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     4167                                                       ,input 'obj' + string(ii, '999') + 'name'
     4168                                                       ,input 'n' + string(jj, '999')
     4169                                                       ,output v-value) no-error .
     4170               if v-value <> ? then
     4171               buf_temp-tekka-schema.field-name = v-value.
     4172             end.
     4173           end.
     4174         end.
     4175         ii-tekka = ii - 1.
     4176        if p-obj-list <> 'ALL' then do:
     4177         if ii-tekka <> ii-ibs then do:
     4178           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     4179                                   , ii-ibs
     4180                                   , ii-tekka).
     4181         end.
     4182        end.
     4183        for each buf_temp-tekka-schema where
     4184               buf_temp-tekka-schema.host = 'tekka':
     4185          find first buf2_temp-tekka-schema where
     4186                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     4187                AND buf2_temp-tekka-schema.host = 'ibs'
     4188                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     4189          if not available buf2_temp-tekka-schema then do:
     4190           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     4191                                   , buf_temp-tekka-schema.field-num
     4192                                   , buf_temp-tekka-schema.obj-num).
     4193          end.
     4194          buffer-compare buf_temp-tekka-schema
     4195          to buf2_temp-tekka-schema
     4196          save result in v-result.
     4197          if v-result <> '':U then do:
     4198           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     4199                                   , buf_temp-tekka-schema.field-num
     4200                                   , buf_temp-tekka-schema.obj-num).
     4201          end.
     4202        end.
     4203     end.
     4204   end procedure.
     4205   FUNCTION set-Sx returns character (input p-string as character):
     4206   return p-string.
     4207   END FUNCTION.
     4208   FUNCTION get-Sx returns character (input p-string  as character):
     4209   return p-string.
     4210   END FUNCTION.
     4211   FUNCTION set-B returns character (input p-string  as character):
     4212   return chr(integer(p-string)).
     4213   END FUNCTION.
     4214   FUNCTION get-B returns character (input p-string  as character):
     4215   return string(asc(p-string)).
     4216   END FUNCTION.
     4217   FUNCTION set-BF returns character (input p-string  as character):
     4218   define variable v-dopi as integer no-undo .
     4219   define variable ii as integer no-undo .
     4220   do ii = 1 to 8:
     4221     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     4222   end.
     4223   return chr(v-dopi).
     4224   END FUNCTION.
     4225   FUNCTION get-BF returns character (input p-string  as character):
     4226   define variable v-dopi as integer no-undo .
     4227   define variable v-dops as character no-undo .
     4228   define variable ii as integer no-undo .
     4229   v-dopi = asc(p-string).
     4230   do ii = 8 to 1 BY -1:
     4231     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     4232   end.
     4233   return v-dops.
     4234   END FUNCTION.
     4235   FUNCTION set-BN returns character (input p-string  as character
     4236                                     ,input p-bin-group as character):
     4237   define variable v-dopi as integer no-undo .
     4238   define variable ii as integer no-undo .
     4239   define variable jj as integer no-undo .
     4240   define variable v-grp-nums as integer no-undo .
     4241   define variable v-dopi2 as integer no-undo .
     4242   v-grp-nums = num-entries(p-bin-group).
     4243   do jj = 0 to v-grp-nums - 1:
     4244     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     4245     do ii = 1 to 8:
     4246       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     4247     end.
     4248   end.
     4249   return chr(v-dopi).
     4250   END FUNCTION.
     4251   FUNCTION get-BN returns character (input p-string  as character
     4252                                     ,input p-bin-group as character):
     4253   define variable v-dopi as integer no-undo .
     4254   define variable v-dops as character no-undo .
     4255   define variable v-grp-nums as integer no-undo .
     4256   define variable ii as integer no-undo .
     4257   define variable jj as integer no-undo .
     4258   v-dopi = asc(p-string).
     4259   v-grp-nums = num-entries(p-bin-group).
     4260   do jj = 1 to v-grp-nums:
     4261   do ii = 8 to 1 BY -1:
     4262     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     4263   end.
     4264   end.
     4265   return v-dops.
     4266   END FUNCTION.
     4267   procedure fill-temp-cd :
     4268   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     4269   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     4270   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     4271   define input parameter p-clear-table as logical no-undo .
     4272   define buffer buf_temp-cd for temp-cd.
     4273   define buffer buf_cash-desk for ub.cash-desk.
     4274     do
     4275     on error undo, return error
     4276     :
     4277        if p-clear-table  then do:
     4278          for each buf_temp-cd:
     4279            delete buf_temp-cd.
     4280          end.
     4281        end.
     4282        for each buf_cash-desk no-lock where
     4283               buf_cash-desk.db-num = p-db-num
     4284           AND buf_cash-desk.obj-code = p-obj-code
     4285           and buf_cash-desk.cash-on  = yes
     4286        BREAK by buf_cash-desk.pos-type:
     4287          if first-of(buf_cash-desk.pos-type) then do:
     4288            create buf_temp-cd.
     4289            buffer-copy buf_cash-desk to buf_temp-cd.
     4290          end.
     4291        end.
     4292     end.
     4293   end procedure.
     4294   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4295   FUNCTION name-2cdf returns character
     4296                      (  input p-name-2cd as character
     4297                       , input p-mode as logical
     4298                       , input p-cod-pcod as logical
     4299                       , input p-b-code  as integer
     4300                       , input p-gds-code as integer
     4301                       , input p-artic   as character
     4302                       , input p-engl-name  as character
     4303                       , input p-in-code as character
     4304                       , input p-part-code as character
     4305                       , input p-obj-type as character
     4306                       , input p-obj-code as integer
     4307                       , input p-alpha1 as character
     4308                       , output p-gtd as character
     4309                       ) :
     4310   define variable v-name-2cd as character no-undo .
     4311   define variable v-dop-alt-name as character no-undo.
     4312   define variable v-type as character no-undo.
     4313   define buffer buf_parts for ub.parts.
     4314   define buffer buf_code for ub.code.
     4315   if not p-mode and p-name-2cd = "PLU":U then do:
     4316     return "PLU кассы":U.
     4317   end.
     4318   if not p-mode then do:
     4319     if p-name-2cd <> "GTD":U
     4320     and  p-name-2cd <> "alpha1|gtd":U
     4321     then do:
     4322     assign
     4323     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4324   end.
     4325   end.
     4326   if p-part-code = "":U or p-cod-pcod = no then do:
     4327     run gdsoattr-value in this-procedure (
     4328       'dt-seasons':U,
     4329       p-gds-code,
     4330       p-obj-type,
     4331       p-obj-code,
     4332       output v-dop-alt-name,
     4333       output v-type
     4334     ) no-error.
     4335     if v-dop-alt-name <> "" then do:
     4336       find first buf_code where
     4337                  buf_code.parent = "DTSeasons"
     4338              and buf_code.code   = v-dop-alt-name
     4339            no-lock no-error.
     4340       if available buf_code then
     4341         assign
     4342           p-engl-name = ""
     4343           v-dop-alt-name =  buf_code.misc1
     4344         .
     4345     end.
     4346     else do:
     4347       run gdsoattr-value in this-procedure
     4348                           ( input  'dop-alt-name-o':U
     4349                            ,input  p-gds-code
     4350                            ,input  p-obj-type
     4351                            ,input  p-obj-code
     4352                            ,output v-dop-alt-name
     4353                            ,output v-type
     4354                           ) no-error .
     4355     end.
     4356     CASE p-name-2cd:
     4357       when "name" then do:
     4358         if p-mode then return p-engl-name + v-dop-alt-name.
     4359         return "Англ. название".
     4360       end.
     4361       when "code":U then do:
     4362         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4363         return "Лок. код товара"  .
     4364       end.
     4365       when "GTD":U
     4366       or
     4367       when "name-GTD":U
     4368       or
     4369       when "code-GTD":U
     4370       or
     4371       when "alpha1|gtd":U
     4372       or
     4373       when "name-alpha1|gtd":U
     4374       or
     4375       when "code-alpha1|gtd":U
     4376       then do:
     4377         if p-mode then do:
     4378           run gdcstcod_cst-code  in this-procedure (
     4379                                                       input  p-obj-type
     4380                                                       ,input  p-obj-code
     4381                                                       ,input  p-gds-code
     4382                                                       ,input  p-in-code
     4383                                                       ,input  p-part-code
     4384                                                       ,output p-gtd
     4385                                                       ) no-error .
     4386         end.
     4387         if p-name-2cd = "name-gtd":U then do:
     4388           if p-mode then return p-engl-name  + v-dop-alt-name.
     4389           return "Англ. название".
     4390         end.
     4391         if p-name-2cd = "name-alpha1|gtd":U then do:
     4392           if p-mode then return p-engl-name  + v-dop-alt-name.
     4393           return "Англ. название".
     4394         end.
     4395         if p-name-2cd = "code-GTD":U then do:
     4396           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4397           return "Лок. код товара"  .
     4398         end.
     4399         if p-name-2cd = "code-alpha1|gtd":U then do:
     4400           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4401           return "Лок. код товара"  .
     4402         end.
     4403         if p-mode then do:
     4404           if p-name-2cd = "GTD" then  return p-gtd.
     4405           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4406         end.
     4407         if p-name-2cd = "GTD" then  return "Код ГТД".
     4408         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4409       end.
     4410     END CASE.
     4411   end.
     4412   else do:
     4413     if p-name-2cd = "name-gtd":U
     4414     or p-name-2cd = "code-GTD":U
     4415     or p-name-2cd = "name-alpha1|GTD":U
     4416     or p-name-2cd = "code-alpha1|GTD":U
     4417     or p-name-2cd = "alpha1|GTD":U
     4418     then do:
     4419       if p-mode then do:
     4420         run gdcstcod_cst-code  in this-procedure (
     4421                                                      input  p-obj-type
     4422                                                     ,input  p-obj-code
     4423                                                     ,input  p-gds-code
     4424                                                     ,input  p-in-code
     4425                                                     ,input  p-part-code
     4426                                                     ,output p-gtd
     4427                                                     ) no-error .
     4428       end.
     4429       else do:
     4430         if p-name-2cd = "gtd":U then
     4431         p-gtd = "Код ГТД".
     4432         if p-name-2cd = "alpha1|Gtd":U then
     4433         p-gtd = "Страна|Код ГТД".
     4434       end.
     4435     end.
     4436     if p-mode then  return p-part-code.
     4437     return "Код партии".
     4438   end.
     4439   END FUNCTION.
     4440   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4441                                            ,input p-nam-2str as logical
     4442                                            ,input p-nam-artc as logical
     4443                                            ,input p-unit-cli-type as character
     4444                                            ,input p-unit-base as character
     4445                                            ,input p-unit-cli as character
     4446                                            ,input p-cli-base-rate as decimal
     4447                                            ,input p-artic as character
     4448                                            ,input p-f-name as character
     4449                                            ,input p-gds-name as character
     4450                                            ,input p-gds-name1 as character
     4451                                            ,output p-second-name as character):
     4452   define variable v-length as integer no-undo .
     4453   define variable nam-2str-shift as integer no-undo .
     4454   define variable chk_name as character no-undo .
     4455   assign
     4456   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4457   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4458   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4459               then 5
     4460               else v-length)
     4461   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4462   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4463   .
     4464   if p-nam-artc then do:
     4465     assign
     4466     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4467       .
     4468   end.
     4469   else  do:
     4470     assign
     4471     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4472     .
     4473   end.
     4474   if p-unit-base <> p-unit-cli then do:
     4475     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4476     assign
     4477     chk_name = string(substr(chk_name
     4478                               ,1
     4479                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4480                       "*":U +
     4481                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4482   end.
     4483   else do:
     4484     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4485   end.
     4486   if p-nam-2str then do:
     4487     assign
     4488     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4489     chk_name = substr(chk_name, 1, v-length)
     4490     .
     4491   end.
     4492   else do:
     4493     assign
     4494     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4495     p-second-name =   (chr(34) +
     4496                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4497                       + chr(34) )
     4498     .
     4499   end.
     4500   return chk_name.
     4501   end function.
     4502   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4503   procedure disrules-get-interface-form :
     4504   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4505   define output parameter p-form-name as character no-undo .
     4506   define buffer buf_temp-drt-prop for temp-drt-prop.
     4507   define buffer buf_drt-prop for ub.drt-prop.
     4508   find first buf_temp-drt-prop where
     4509             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4510         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4511         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4512   if not available buf_temp-drt-prop then do:
     4513     find first buf_drt-prop where
     4514               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4515           and buf_drt-prop.upper-prop-code = "InputForm"
     4516           and buf_drt-prop.prop-code = "FormName" no-error.
     4517     if available buf_drt-prop then do:
     4518       p-form-name = buf_drt-prop.property-value.
     4519     end.
     4520     else do:
     4521       p-form-name = "ref/dis-ruli.w".
     4522     end.
     4523   end.
     4524   else do:
     4525     p-form-name = buf_temp-drt-prop.property-value.
     4526   end.
     4527   end procedure.
     4528   ~
     4529   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4530   procedure cd-attr-code :
