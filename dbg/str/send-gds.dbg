    13943                       ,input p-log-handle
    13944                       ,input out
    13945                       ,input out
    13946                       ,input fname
    13947                       ,input v-remote
    13948                       ,input v-is-script117
    13949                       ) no-error .
    13950   if error-status:error then do:
    13951     for each temp-tekka-tsk:
