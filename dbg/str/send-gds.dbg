     6576   field time-2 as int
     6577   field grp-name as char
     6578   field interv-name as char
     6579   field pay-name as char
     6580   field unit-cli as char
     6581   index pi
     6582   plt-priority DESCENDING
     6583   fact-order DESCENDING
     6584   qnty-from asc
     6585   sum-from asc
     6586   turnover-from asc
     6587   date-1 DESCENDING
     6588   time-1 DESCENDING
     6589   date-2 DESCENDING
     6590   time-2 DESCENDING
     6591   type-price DESCENDING
     6592   .
     6593   procedure mpl-autoprice :
     6594   define input  parameter p-only-b-code as logical   no-undo .
     6595   define input  parameter p-cli-type    as character no-undo .
     6596   define input  parameter p-cli-code    as integer   no-undo .
     6597   define input  parameter p-main-b-code as integer   no-undo .
     6598   define input  parameter p-b-code      as integer   no-undo .
     6599   define input  parameter p-obj-type    as character no-undo .
     6600   define input  parameter p-obj-code    as integer   no-undo .
     6601   define input  parameter p-qnty-doc    as decimal   no-undo .
     6602   define input  parameter p-sum-doc     as decimal   no-undo .
     6603   define input  parameter p-vid-pay        as character no-undo .
     6604   define input  parameter p-cash-pay-type  as character no-undo .
     6605   define input  parameter p-fact-order  as decimal   no-undo .
     6606   define output parameter p-plt-id          as integer   no-undo .
     6607   define output parameter p-plt-db-num      as integer   no-undo .
     6608   define output parameter p-pdf-id          as integer   no-undo .
     6609   define output parameter p-pdf-db-num      as integer   no-undo .
     6610   define output parameter p-sale-price-base as decimal   no-undo .
     6611   define output parameter p-sale-price-rubl as decimal   no-undo .
     6612   define output parameter p-road-tax-base as decimal   no-undo .
     6613   define output parameter p-road-tax-rubl as decimal   no-undo .
     6614   define output parameter p-excise-base   as decimal   no-undo .
     6615   define output parameter p-excise-rubl   as decimal   no-undo .
     6616   define variable v-cli-oborot-ALL as decimal   no-undo .
     6617   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6618   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6619   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6620   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6621   define buffer buf_price-all              for ub.price-all  .
     6622   define buffer buf_goods                  for ub.goods      .
     6623   define buffer buf_global-state           for ub.global-state  .
     6624   define buffer buf_buyer-group            for ub.buyer-group  .
     6625   define buffer buf_turnover-group         for ub.turnover-group  .
     6626   define buffer buf_main-code              for ub.bar-code  .
     6627   define buffer buf_bar-code               for ub.bar-code  .
     6628   define buffer buf_pay-type               for ub.pay-type  .
     6629   define buffer buf_cash-pay               for ub.cash-pay  .
     6630   define variable to-day          as date      no-undo .
     6631   define variable v-base-rate0    as decimal   no-undo .
     6632   define variable v-base-scale0   as decimal   no-undo .
     6633   define variable v-exch-rate0    as decimal   no-undo .
     6634   define variable v-exch-scale0   as decimal   no-undo .
     6635   define variable v-base-rate     as decimal   no-undo .
     6636   define variable v-base-scale    as decimal   no-undo .
     6637   define variable v-exch-rate     as decimal   no-undo .
     6638   define variable v-exch-scale    as decimal   no-undo .
     6639   define variable v-host-code     as integer   no-undo .
     6640   define variable v-curr-abbr     as character no-undo .
     6641   define variable v-grp-name      as character no-undo .
     6642   define variable v-date-1        as date      no-undo .
     6643   define variable v-date-2        as date      no-undo .
     6644   define variable v-interv        as character no-undo .
     6645   define variable v-pay-name      as character no-undo .
     6646   define variable v-cli-oborot    as decimal   no-undo .
     6647   define variable v-trn-pay-code  as integer   no-undo .
     6648   define variable v-cash-pay-curr as integer   no-undo .
     6649   define variable v-cash-pay-code as integer   no-undo .
     6650   do
     6651   on error undo, return error return-value
     6652   :
     6653   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6654   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6655   if p-fact-order = ? then do:
     6656     run fact-order-mpl (
     6657         input   today       ,
     6658         input   p-obj-type  ,
     6659         input   p-obj-code  ,
     6660         output  p-fact-order ).
     6661   end.
     6662   if p-vid-pay <> "" then do:
     6663      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6664      if available buf_pay-type
     6665         then v-trn-pay-code = buf_pay-type.obj-code.
     6666         else v-trn-pay-code =  0.
     6667   end.
     6668   else v-trn-pay-code = 0 .
     6669   if p-cash-pay-type <> "" then do:
     6670      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6671      if available buf_pay-type
     6672         then
     6673           assign
     6674             v-cash-pay-curr = buf_cash-pay.curr-code
     6675             v-cash-pay-code = buf_cash-pay.cdpay-code
     6676           .
     6677         else
     6678           assign
     6679             v-cash-pay-curr = 0
     6680             v-cash-pay-code = 0
     6681             .
     6682   end.
     6683   else
     6684     assign
     6685       v-cash-pay-curr = 0
     6686       v-cash-pay-code = 0
     6687       .
     6688   for each tt_price-all  : delete tt_price-all . end.
     6689   assign
     6690     p-plt-id             = ?
     6691     p-plt-db-num         = ?
     6692     p-pdf-id             = ?
     6693     p-pdf-db-num         = ?
     6694     p-sale-price-base    = ?
     6695     p-sale-price-rubl    = ?
     6696     v-cli-oborot         = 0
     6697   .
     6698   find first buf_global-state no-lock no-error .
     6699   if not available buf_global-state then do:
     6700      message
     6701        "Не заданы параметры ценообразования!"
     6702        view-as alert-box error
     6703      .
     6704      return error return-value .
     6705   end.
