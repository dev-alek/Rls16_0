    13807                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    13808                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    13809                 and crf <= cr-ncr-dis-kat
    13810           by buf_cash-ncr-dis-kat.cd-subject-code
    13811           by buf_cash-ncr-dis-kat.cd-disc-string
    13812           :
    13813             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    13814             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    13815               leave  _for_rr2.
    13816             end.
    13817             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    13818               v-updated-subject-dis-kat = yes.
    13819             end.
    13820             find first  cash-ncr-save-param no-lock where
    13821                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    13822                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    13823                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    13824             if available cash-ncr-save-param then do:
    13825               put stream plucash unformatted
    13826               cash-ncr-save-param.cd-line
    13827               cash-ncr-save-param.cd-other
    13828               skip.
    13829               v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7)
    13830                                  .
    13831               NEXT _for_rr2.
    13832             end.
    13833             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    13834           end.
