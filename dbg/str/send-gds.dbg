    13774         end.
    13775         input stream bar from value(v-kat-file) convert source "ibm866" .
    13776         assign
    13777         ss0 = ''
    13778         ss = '':U
    13779         v-cd-subject-code = '':U
    13780         v-cd-disc-string  = '':U
    13781         v-next = no
    13782         v-updated-subject-dis-kat = no
    13783         .
    13784         output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    13785         _rr2:
    13786         repeat:
    13787           import stream bar unformatted ss.
    13788           assign
    13789           v-next = no
    13790           v-updated-subject-dis-kat = no
    13791           v-cd-subject-code = substring(ss, 1, 16)
    13792           v-cd-disc-string =  substring(ss, 17, 7)
    13793           .
    13794           if not ss begins fill(chr(32), 2 )
    13795           then do:
    13796             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
    13797               put stream plucash unformatted
    13798               ss skip.
    13799               ss0 = v-cd-subject-code.
