    11612               find first cash-gds-discnt where
    11613                         cash-gds-discnt.b-code = cash-gds.b-code
    11614                     and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    11615                   and cash-gds-discnt.obj-type = 'маг':U
    11616                   and cash-gds-discnt.obj-code = i-obj-code
    11617                     no-error.
    11618               if available cash-gds-discnt then do:
    11619                 assign
    11620                 v-kat-discnt = cash-gds-discnt.discnt-value
    11621                 .
    11622               end.
    11623               else do:
    11624                 v-kat-discnt = cash-gds.price-sale.
