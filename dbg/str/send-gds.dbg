    16575             ( buf_dis-gds-rule.obj-type = 'орг':U  and buf_dis-gds-rule.obj-code = i-host-code) or
    16576             ( buf_dis-gds-rule.obj-type = 'маг':U and buf_dis-gds-rule.obj-code = i-obj-code))
    16577          then do:
