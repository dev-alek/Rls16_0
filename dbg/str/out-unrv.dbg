      135   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
      137     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
      138     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
      139     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
      140     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
      141     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
      142     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
      143     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
      144     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
      145     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
      146     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      147     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
      148     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
      149     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
      150     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      151     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      152     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      153     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      154     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      155     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      156     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      157     define variable v-cntxp-conf-par        as   character                no-undo.
      158     define variable v-cntxp-par-type        as   character                no-undo.
      159     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      160     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      161     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      162     define variable v-cntxp-db-num          as integer   no-undo .
      163     define variable v-cntxp-userid          as character no-undo .
      164     define variable v-cntxp-level           as character no-undo .
      165     define variable v-cntxp-db-num-obj      as integer   no-undo .
      166     define variable v-cntxp-is-admin        as logical   no-undo .
      167     define buffer bf-cntxp_store for ub.store.
      168     define buffer bf-cntxp_shop  for ub.shop.
      169     define buffer bf-cntxp_sysconf for ub.sysconf.
      170   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171     run mainmenu_getcntxt in parparentproc
      172       (output v-cntxp-db-num
      173       ,output v-cntxp-userid
      174       ,output v-cntxp-level
      175       ,output v-cntxp-curr-host-code
      176       ,output v-cntxp-obj-type
      177       ,output v-cntxp-obj-code
      178       ,output v-cntxp-db-num-obj
      179       ,output v-cntxp-is-admin
      180       ) .
      181     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      182        v-cntxp-obj-code <> 0 then do:
      183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      184     (input  'is-prt'
      185     ,input  0
      186     ,input  ''
      187     ,input  0
      188     ,input  ''
      189     ,input  ''
      190     ,input  ''
      191     ,input  yes
      192     ,output v-cntxp-conf-par
      193     ,output v-cntxp-par-type
      194     ) no-error .
      195       case v-cntxp-obj-type :
      196         when 'скл':U then do:
      197           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      198           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      199           assign
      200             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      201             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      202             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      203             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      204             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      205             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      206             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      207             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      208             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      209             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      210             v-cntxp-load-time       = bf-cntxp_store.load-time
      211             v-cntxp-holidays        = bf-cntxp_store.holidays
      212             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      213             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      214             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      215             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      216             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      217             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      218             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      219             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      220             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      221             .
      222         end.
      223         when 'маг':U then do:
      224           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      225           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      226           assign
      227             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      228             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      229             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      230             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      231             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      232             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      233             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      234             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      235             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      236             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      237             v-cntxp-load-time       = bf-cntxp_shop.load-time
      238             v-cntxp-holidays        = bf-cntxp_shop.holidays
      239             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      240             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      241             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      242             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      243             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      244             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      245             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      246             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      247             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      248             .
      249         end.
      250       end case.
      251     end.
      252   DEFINE BUTTON b-help
      253        LABEL "Помо&щь":L
      254        SIZE 10 BY 1.
      255   DEFINE BUTTON b-quit AUTO-END-KEY
      256        LABEL "&Отмена":L
      257        SIZE 10 BY 1.
      258   DEFINE BUTTON b-save AUTO-GO
      259        LABEL "&Ввод":L
      260        SIZE 10 BY 1.
      261   DEFINE BUTTON b-unrv AUTO-GO
      262        LABEL "С&нять":L
      263        SIZE 10 BY 1.
      264   DEFINE VARIABLE period AS INTEGER FORMAT "->9":U INITIAL 0
      265        LABEL "С&рок резерва (дней)"
      266        VIEW-AS FILL-IN
      267        SIZE 5 BY 1 NO-UNDO.
      268   DEFINE FRAME d-out-unrv
      269       b-save AT ROW 1 COL 1
      270     b-quit AT ROW 1 COL 11
      271     trn-doc.doc-date AT ROW 2 COL 25 COLON-ALIGNED LABEL "Дата с&чета" VIEW-AS FILL-IN SIZE 9.25 BY 1
      272     period AT ROW 4 COL 25 COLON-ALIGNED
      273     trn-doc.rsrv-date AT ROW 5.5 COL 25 COLON-ALIGNED LABEL "Дата снятия ре&зерва" VIEW-AS FILL-IN SIZE 9.25 BY 1
      274     b-unrv AT ROW 1 COL 21
      275     b-help AT ROW 1 COL 31
      276     SPACE(1.76) SKIP(0.85)
      277     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      278     DEFAULT-BUTTON b-save.
      279   ASSIGN FRAME d-out-unrv:SCROLLABLE       = FALSE.
      280   ON CHOOSE OF b-save IN FRAME d-out-unrv
      281   DO:
      282   define variable v-today as date      no-undo.
      283   if trn-doc.status_ = 'разрешен':U then do:
      284   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      286     (input  v-cntxt-obj-type
      287     ,input  v-cntxt-obj-code
      288     ,output v-today
      289     )  .
      290     if input frame d-out-unrv trn-doc.rsrv-date < v-today then do:
      291       varlog = yes.
      292       message "Нельзя назначать отгрузку раньше, чем сегодня."
      293                       skip (2) "Исправить дату ?"
      294                       view-as alert-box question buttons OK-Cancel update varlog.
      295       if not varlog then return no-apply.
      296       disp v-today @ trn-doc.rsrv-date with frame d-out-unrv.
      297     end.
      298     varlog = yes.
      299     do while can-do (v-cntxp-holidays, string (weekday (input frame d-out-unrv trn-doc.rsrv-date))) :
      300       if varlog then do:
      301         message "Отгрузка попадает на выходной." skip (2) "Переместить ее на рабочий день ?"
      302                         view-as alert-box question buttons Yes-No update varlog.
      303         if not varlog then leave.
      304         varlog = no.
      305       end.
      306       disp input frame d-out-unrv trn-doc.rsrv-date + 1 @ trn-doc.rsrv-date with frame d-out-unrv.
      307     end.
      308   end.
      309   assign trn-doc.rsrv-date = input frame d-out-unrv trn-doc.rsrv-date.
      310   END.
      311   ON CHOOSE OF b-unrv IN FRAME d-out-unrv
      312   DO:
      313   varlog = yes.
      314   message "Снятие резервов по накладной №" trn-doc.doc-code "Продолжать ?"
      315                   view-as alert-box question buttons OK-Cancel update varlog.
      316   if not varlog then return no-apply.
      317   run str/unrv-out.p (parparentproc, trn-doc.doc-code) no-error.
      318   if error-status:error then return no-apply.
      319      message "Резервирование по накладной №" trn-doc.doc-code "отменено." skip (2)
      320              "Накладная переведена в ЗАПРОС.".
      321   END.
      322   ON LEAVE OF trn-doc.rsrv-date IN FRAME d-out-unrv
      323   DO:
      324   disp input frame d-out-unrv trn-doc.rsrv-date - trn-doc.doc-date @ period with frame d-out-unrv.
      325   END.
      326   ON return, LEAVE OF period IN FRAME d-out-unrv
      327   DO:
      328   disp trn-doc.doc-date + input frame d-out-unrv period @ trn-doc.rsrv-date with frame d-out-unrv.
      329   END.
      330   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   on help of frame d-out-unrv
      332   do:
      333     run gbl/app_help.p
      334       (input this-procedure :file-name
      335       ,input ''
      336       ,input ?
      337       ) no-error.
      338     if error-status :error then do:
      339       message
      340         "Ошибка при вызове помощи"
      341         error-status :get-message(1)
      342         view-as alert-box .
      343     end.
      344   end.
      345   run minbtn-set in this-procedure .
      346   on choose of b-help in frame d-out-unrv
      347   do:
      348     apply "help":u to frame d-out-unrv .
      349   end.
      350   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   procedure minbtn-set :
      352       do
      353           on error undo, return error return-value
      354           :
      355           define variable ii              as integer       no-undo .
      356           define variable fh              as widget-handle no-undo .
      357           define variable hh              as widget-handle no-undo .
      358           define variable v-h             as handle        extent 4 no-undo .
      359           define variable v-name-button   as character     no-undo .
      360           define variable v-help-old-x    as decimal       no-undo .
      361           define variable v-help-old-y    as decimal       no-undo .
      362           define variable v-help-old-size as decimal       no-undo .
      363           define variable v-frame-width   as decimal       no-undo .
      364           define variable jj              as integer       no-undo .
      365           do
      366               on error undo, return error
      367               :
      368               assign
      369                   v-frame-width = frame d-out-unrv:width - 0.3
      370                   fh            = frame d-out-unrv:first-child
      371                   hh            = fh:first-child
      372                   ii            = 1
      373                   .
      374               do while valid-handle(hh):
      375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      376                   do:
      377                       case lc(hh:name) :
      378                           when "b-help" then
      379                               do:
      380                                   hh:load-image-up("cmp/b-help.bmp":u) .
      381                                   hh:load-image-down("cmp/b-help.bmp":u) .
      382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      383                                   hh:TOOLTIP = "Помощь" .
      384                                   v-help-old-x = hh:column .
      385                                   v-help-old-y = hh:row    .
      386                                   v-help-old-size = hh:width .
      387                                   hh:width-chars = 2.5 .
      388                               end.
      389                           when "b-print" then
      390                               do:
      391                                   hh:load-image("cmp/b-print.bmp":u) .
      392                                   hh:TOOLTIP = "Печать" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-history" or
      398                           when "b-hist" then
      399                               do:
      400                                   hh:load-image("cmp/b-hist.bmp":u) .
      401                                   hh:TOOLTIP = "История" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-sch" then
      407                               do:
      408                                   hh:load-image("cmp/b-sch.bmp":u) .
      409                                   hh:TOOLTIP = "Установка Фильтра" .
      410                                   v-h[ii] = hh:handle .
      411                                   ii = ii + 1 .
      412                                   hh:width-chars = 3 .
      413                               end.
      414                           when "b-hist-user" then
      415                               do:
      416                                   hh:load-image("cmp/b-hist.bmp":u) .
      417                                   hh:TOOLTIP = "История пользователя" .
      418                                   ii = ii + 1 .
      419                               end.
      420                       end case.
      421                   end.
      422                   hh = hh:next-sibling.
      423               end.
      424               b-help:column = v-frame-width - b-help:width-chars.
      425               jj = 0.
      426               repeat ii = 4 to 1 by -1 :
      427                   if valid-handle (v-h[ii] ) then
      428                   do:
      429                       jj  = jj + 1 .
      430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      431                       v-h[ii]:row    = v-help-old-y .
      432                   end.
      433               end.
      434           end.
      435       end.
      436   end procedure.
      437   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-out-unrv:PARENT eq ?
      438   THEN FRAME d-out-unrv:PARENT = ACTIVE-WINDOW.
      439   ON WINDOW-CLOSE OF FRAME d-out-unrv APPLY "END-ERROR":U TO SELF.
      440   MAIN-BLOCK:
      441   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      442      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      443      ON stop UNDO MAIN-BLOCK, return:
      444     find trn-doc where trn-doc.doc-code = pardoc-code exclusive.
      445     period = integer (trn-doc.rsrv-date) - integer (trn-doc.doc-date).
      446     if trn-doc.status_ = 'разрешен':U then do:
      447       if not can-do ('рас,спи':U, trn-doc.doc-type) then do:
      448         message "Снять резервы или изменить дату отгрузки по данному документу нельзя.".
      449         return.
      450       end.
      451       case trn-doc.doc-type
      452       :
      453         when 'рас':U
      454         then do:
      455   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   do:
      457     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      458       (input  v-cntxt-db-num
      459       ,input  v-cntxt-userid
      460       ,input  0
      461       ,input  'actn_expense_shipping':U
      462       ,input  'object':U
      463       ,input  trn-doc.host-code
      464       ,input  trn-doc.obj-type
      465       ,input  trn-doc.obj-code
      466       ,input  0
      467       ,input  0
      468       ,input  0
      469       ,input  true
      470       ,output varlog
      471       )  .
      472   end.
      473         end.
      474         when 'спи':U
      475         then do:
      476   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   do:
      478     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      479       (input  v-cntxt-db-num
      480       ,input  v-cntxt-userid
      481       ,input  0
      482       ,input  'actn_write-off_shipping':U
      483       ,input  'object':U
      484       ,input  trn-doc.host-code
      485       ,input  trn-doc.obj-type
      486       ,input  trn-doc.obj-code
      487       ,input  0
      488       ,input  0
      489       ,input  0
      490       ,input  true
      491       ,output varlog
      492       )  .
      493   end.
      494         end.
      495         otherwise do:
      496           message
      497             vss-workfile vss-revision vss-description skip
      498             "Неизвестный тип документа" skip
      499             "Тип документа" trn-doc.doc-type skip
      500             "Код документа" trn-doc.doc-code skip
      501             view-as alert-box error .
      502           undo, return error return-value .
      503         end.
      504       end case .
      505       if not varlog then return.
      506       if trn-doc.flag_ = no then do:
      507         message "Документ уже отпечатан в набор. Изменение даты отгрузки невозможно.".
      508         return.
      509       end.
      510       if v-cntxt-db-num-obj <> v-cntxt-db-num then do:
      511         message "Изменение даты отгрузки возможно только на базе данных объекта : " v-cntxt-db-num-obj.
      512         return.
      513       end.
      514       frame d-out-unrv:title = "Накладная № " + trn-doc.doc-code + ".     ОТГРУЗКА".
      515       period:label = "С&рок отгрузки (дней)".
      516       trn-doc.rsrv-date:label = "Дата отгру&зки".
      517     end.
      518     else do:
      519       if not can-do ( 'рас,спи,возврат':U, trn-doc.doc-type) or
      520        (trn-doc.internal and trn-doc.doc-type <> 'рас':U) or
      521        trn-doc.status_ <> 'накл':U then do:
      522         message "Снять резервы или изменить дату отгрузки по данному документу нельзя.".
      523         return.
      524       end.
      525       case trn-doc.doc-type
      526       :
      527         when 'рас':U
      528         then do:
      529   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      530   do:
      531     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      532       (input  v-cntxt-db-num
      533       ,input  v-cntxt-userid
      534       ,input  0
      535       ,input  'actn_expense_rsrv-dtl-action-reserv':U
      536       ,input  'object':U
      537       ,input  trn-doc.host-code
      538       ,input  trn-doc.obj-type
      539       ,input  trn-doc.obj-code
      540       ,input  0
      541       ,input  0
      542       ,input  0
      543       ,input  true
      544       ,output varlog
      545       )  .
      546   end.
      547         end.
      548         when 'спи':U
      549         then do:
      550   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   do:
      552     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      553       (input  v-cntxt-db-num
      554       ,input  v-cntxt-userid
      555       ,input  0
      556       ,input  'actn_write-off_rsrv-dtl-action-reserv':U
      557       ,input  'object':U
      558       ,input  trn-doc.host-code
      559       ,input  trn-doc.obj-type
      560       ,input  trn-doc.obj-code
      561       ,input  0
      562       ,input  0
      563       ,input  0
      564       ,input  true
      565       ,output varlog
      566       )  .
      567   end.
      568         end.
      569         when 'возврат':U
      570         then do:
      571   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   do:
      573     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      574       (input  v-cntxt-db-num
      575       ,input  v-cntxt-userid
      576       ,input  0
      577       ,input  'actn_return_rsrv-dtl-action-reserv':U
      578       ,input  'object':U
      579       ,input  trn-doc.host-code
      580       ,input  trn-doc.obj-type
      581       ,input  trn-doc.obj-code
      582       ,input  0
      583       ,input  0
      584       ,input  0
      585       ,input  true
      586       ,output varlog
      587       )  .
      588   end.
      589         end.
      590         otherwise do:
      591           message
      592             vss-workfile vss-revision vss-description skip
      593             "Неизвестный тип документа" skip
      594             "Тип документа" trn-doc.doc-type skip
      595             "Код документа" trn-doc.doc-code skip
      596             view-as alert-box error .
      597           undo, return error return-value .
      598         end.
      599       end case .
      600       if not varlog then return.
      601       if v-cntxt-db-num-obj <> v-cntxt-db-num then do:
      602         message "Резервы можно снимать только на активной стороне.".
      603         return.
      604       end.
      605       frame d-out-unrv:title = "Накладная № " + trn-doc.doc-code + ".     РЕЗЕРВ".
      606       ENABLE b-unrv WITH FRAME d-out-unrv.
      607     end.
      608     DISPLAY period trn-doc.doc-date trn-doc.rsrv-date WITH FRAME d-out-unrv.
      609     ENABLE period trn-doc.rsrv-date b-quit b-save b-help WITH FRAME d-out-unrv.
      610     WAIT-FOR GO OF FRAME d-out-unrv focus trn-doc.rsrv-date.
      611   END.
      612   RUN disable_UI.
      613   PROCEDURE disable_UI :
      614     HIDE FRAME d-out-unrv.
      615   END PROCEDURE.
