     1084   buf_c-price-doc.out-code  COLUMN-LABEL "ПН"
     1085   buf_c-price-doc.sys-date  COLUMN-LABEL "Дата !корректировки"
     1086   STRING(buf_c-price-doc.sys-time-int, "HH:MM")  FORMAT "x(6)" @ buf_c-price-doc.sys-time-int COLUMN-LABEL "Время!корр."
     1087   buf_c-price-doc.corr-date  COLUMN-LABEL "Дата!изменения"    LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1088   STRING(buf_c-price-doc.corr-time, "HH:MM")  FORMAT "x(6)" @ buf_c-price-doc.corr-time COLUMN-LABEL "Время!изменения" LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1089   buf_c-price-doc.corr-man   COLUMN-LABEL "Кто менял"    LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1090   usrfulnf(buf_c-price-doc.corr-man)   COLUMN-LABEL "Кто менял!ФИО"    LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1091   buf_c-price-doc.corr-user-db-num COLUMN-LABEL "В !БД"  FORMAT ">>>>>9"  LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1092       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 90 BY 10.04.
     1093   DEFINE FRAME Dialog-Frame
     1094        B-Cancel AT ROW 1 COL 1
     1095        B-sch AT ROW 1 COL 20
     1096        B-Help AT ROW 1 COL 81.5
     1097        BR-docs AT ROW 2.21 COL 1.25
     1098        BR-changes AT ROW 12.5 COL 1
     1099        SPACE(0.00) SKIP(0.01)
     1100       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1101            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1102            TITLE "История заказа"
     1103            CANCEL-BUTTON B-Cancel.
     1104   ASSIGN
     1105          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1106          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1107   ASSIGN
     1108          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2
     1109          BR-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1110   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1111   DO:
     1112     APPLY "END-ERROR":U TO SELF.
     1113   END.
     1114   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1115   DO:
     1116     run proc-b-sch in this-procedure no-error.
     1117     if not available buf_c-price-doc then run OpenBr (yes, no, '':U).
     1118   END.
     1119   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1120   DO:
     1121   if available buf_c-price-doc then do:
     1122     run proc-view-changes in this-procedure no-error.
     1123   end.
     1124   END.
     1125   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1126   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1127   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   on help of frame Dialog-Frame
     1129   do:
     1130     run gbl/app_help.p
     1131       (input this-procedure :file-name
     1132       ,input ''
     1133       ,input ?
     1134       ) no-error.
     1135     if error-status :error then do:
     1136       message
     1137         "Ошибка при вызове помощи"
     1138         error-status :get-message(1)
     1139         view-as alert-box .
     1140     end.
     1141   end.
     1142   run minbtn-set in this-procedure .
     1143   on choose of b-help in frame Dialog-Frame
     1144   do:
     1145     apply "help":u to frame Dialog-Frame .
     1146   end.
     1147   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   procedure minbtn-set :
     1149       do
     1150           on error undo, return error return-value
     1151           :
     1152           define variable ii              as integer       no-undo .
     1153           define variable fh              as widget-handle no-undo .
     1154           define variable hh              as widget-handle no-undo .
     1155           define variable v-h             as handle        extent 4 no-undo .
     1156           define variable v-name-button   as character     no-undo .
     1157           define variable v-help-old-x    as decimal       no-undo .
     1158           define variable v-help-old-y    as decimal       no-undo .
     1159           define variable v-help-old-size as decimal       no-undo .
     1160           define variable v-frame-width   as decimal       no-undo .
     1161           define variable jj              as integer       no-undo .
     1162           do
     1163               on error undo, return error
     1164               :
     1165               assign
     1166                   v-frame-width = frame Dialog-Frame:width - 0.3
     1167                   fh            = frame Dialog-Frame:first-child
     1168                   hh            = fh:first-child
     1169                   ii            = 1
     1170                   .
     1171               do while valid-handle(hh):
     1172                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1173                   do:
     1174                       case lc(hh:name) :
     1175                           when "b-help" then
     1176                               do:
     1177                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1178                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1179                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1180                                   hh:TOOLTIP = "Помощь" .
     1181                                   v-help-old-x = hh:column .
     1182                                   v-help-old-y = hh:row    .
     1183                                   v-help-old-size = hh:width .
     1184                                   hh:width-chars = 2.5 .
     1185                               end.
     1186                           when "b-print" then
     1187                               do:
     1188                                   hh:load-image("cmp/b-print.bmp":u) .
     1189                                   hh:TOOLTIP = "Печать" .
     1190                                   v-h[ii] = hh:handle .
     1191                                   ii = ii + 1 .
     1192                                   hh:width-chars = 3 .
     1193                               end.
     1194                           when "b-history" or
     1195                           when "b-hist" then
     1196                               do:
     1197                                   hh:load-image("cmp/b-hist.bmp":u) .
     1198                                   hh:TOOLTIP = "История" .
     1199                                   v-h[ii] = hh:handle .
     1200                                   ii = ii + 1 .
     1201                                   hh:width-chars = 3 .
     1202                               end.
     1203                           when "b-sch" then
     1204                               do:
     1205                                   hh:load-image("cmp/b-sch.bmp":u) .
     1206                                   hh:TOOLTIP = "Установка Фильтра" .
     1207                                   v-h[ii] = hh:handle .
     1208                                   ii = ii + 1 .
     1209                                   hh:width-chars = 3 .
     1210                               end.
     1211                           when "b-hist-user" then
     1212                               do:
     1213                                   hh:load-image("cmp/b-hist.bmp":u) .
     1214                                   hh:TOOLTIP = "История пользователя" .
     1215                                   ii = ii + 1 .
     1216                               end.
     1217                       end case.
     1218                   end.
     1219                   hh = hh:next-sibling.
     1220               end.
     1221               b-help:column = v-frame-width - b-help:width-chars.
     1222               jj = 0.
     1223               repeat ii = 4 to 1 by -1 :
     1224                   if valid-handle (v-h[ii] ) then
     1225                   do:
     1226                       jj  = jj + 1 .
     1227                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1228                       v-h[ii]:row    = v-help-old-y .
     1229                   end.
     1230               end.
     1231           end.
     1232       end.
     1233   end procedure.
     1234   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1235   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1236   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1237   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1238   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1239   define variable v-diasize-current-frame-height as decimal   no-undo .
     1240   define variable v-diasize-change-size          as logical   no-undo .
     1241   define variable v-diasize-resize-button        as handle    no-undo .
     1242   define variable v-diasize-wndmax               as logical   no-undo .
     1243   define variable v-diasize-wndstore             as logical   no-undo .
     1244   define variable v-diasize-proc-name            as character no-undo .
     1245   define variable v-diasize-browse-handle        as handle    no-undo .
     1246   define variable v-diasize-browse-number        as integer   no-undo .
     1247   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1248   define temp-table temp-diasize-handle no-undo
     1249     field handle-value  as handle
     1250     field save-position as decimal
     1251     index xpk is primary unique handle-value
     1252     .
     1253   define temp-table temp-browse-handle no-undo
     1254     field browse-type   as character
     1255     field browse-number as integer
     1256     field browse-handle as handle
     1257     field original-size as decimal
     1258     index xpk is primary unique browse-type browse-number
     1259     index xie browse-type browse-handle
     1260   .
     1261   procedure diasize_change-height :
     1262     define input  parameter p-change-value  as decimal   no-undo .
     1263     define input  parameter p-move-resize   as logical   no-undo .
     1264     define variable v-field-group-handle    as handle    no-undo .
     1265     define variable v-object-handle         as handle    no-undo .
     1266     define variable v-frame-height          as decimal   no-undo .
     1267     define variable v-frame-virtual-height  as decimal   no-undo .
     1268     define variable v-browse-height         as decimal   no-undo .
     1269     define variable v-window-height         as decimal   no-undo .
     1270     define variable v-window-virtual-height as decimal   no-undo .
     1271     define variable v-change-sign           as integer   no-undo .
     1272     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1273     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1274     if p-change-value > 0
     1275     then do:
     1276       if frame Dialog-Frame :height + p-change-value
     1277           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1278       then do:
     1279         assign
     1280           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1281                           - (frame Dialog-Frame :height-chars)
     1282         .
     1283         if p-change-value <= 0
     1284         then do:
     1285           run diasize_position-resize-button in this-procedure .
     1286           return .
     1287         end.
     1288       end.
     1289     end.
     1290     if p-change-value < 0
     1291     then do:
     1292       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1293       then do:
     1294         assign
     1295           p-change-value = v-diasize-orig-frame-height
     1296                          - (frame Dialog-Frame :height-chars)
     1297         .
     1298         if p-change-value >= 0
     1299         then do:
     1300           run diasize_position-resize-button in this-procedure .
     1301           return .
     1302         end.
     1303       end.
     1304     end.
     1305     if p-change-value >= 0
     1306     then do:
     1307       assign
     1308         v-change-sign = 1
     1309       .
     1310     end.
     1311     else do:
     1312       assign
     1313         v-change-sign = -1
     1314       .
     1315     end.
     1316     assign
     1317       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1318     .
     1319     if p-change-value = 0
     1320     then do:
     1321       run diasize_position-resize-button in this-procedure .
     1322       return .
     1323     end.
     1324     move_block:
     1325     do
     1326     on error undo move_block, retry move_block
     1327     :
     1328       if retry
     1329       then do:
     1330         do
     1331         on error undo move_block, leave move_block
     1332         :
     1333           if p-change-value > 0
     1334           then do:
     1335             for each buf_temp-diasize-handle
     1336             on error undo, next
     1337             :
     1338               assign
     1339                 v-object-handle = buf_temp-diasize-handle.handle-value
     1340               .
     1341               if v-object-handle <> v-diasize-resize-button
     1342               then do:
     1343                 assign
     1344                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1345                 .
     1346               end.
     1347             end.
     1348             assign
     1349               v-diasize-browse-handle :height = v-browse-height
     1350             .
     1351             for each buf_temp-browse-handle
     1352               where buf_temp-browse-handle.browse-type = 'height':u
     1353             on error undo, next
     1354             :
     1355               assign
     1356                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1357               .
     1358             end.
     1359             assign
     1360               frame Dialog-Frame :height = v-frame-height
     1361             .
     1362             if frame Dialog-Frame :scrollable = true
     1363             then do:
     1364               assign
     1365                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1366               .
     1367             end.
     1368             run diasize_position-resize-button in this-procedure .
     1369           end.
     1370           else do:
     1371             if frame Dialog-Frame :scrollable = true
     1372             then do:
     1373               assign
     1374                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1375               .
     1376             end.
     1377             assign
     1378               frame Dialog-Frame :height = v-frame-height
     1379             .
     1380             assign
     1381               v-diasize-browse-handle :height = v-browse-height
     1382             .
     1383             for each buf_temp-browse-handle
     1384               where buf_temp-browse-handle.browse-type = 'height':u
     1385             on error undo, next
     1386             :
     1387               assign
     1388                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1389               .
     1390             end.
     1391             for each buf_temp-diasize-handle
     1392             on error undo, next
     1393             :
     1394               assign
     1395                 v-object-handle = buf_temp-diasize-handle.handle-value
     1396               .
     1397               if v-object-handle <> v-diasize-resize-button
     1398               then do:
     1399                 assign
     1400                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1401                 .
     1402               end.
     1403             end.
     1404             run diasize_position-resize-button in this-procedure .
     1405           end.
     1406           assign
     1407             v-diasize-change-size = false
     1408           .
     1409           leave move_block .
     1410         end.
     1411       end.
     1412       assign
     1413         v-diasize-need-full-display = true
     1414       .
     1415       if v-diasize-change-size = false
     1416       then do:
     1417         assign
     1418           v-diasize-change-size = true
     1419         .
     1420       end.
     1421       else do:
     1422         return .
     1423       end.
     1424       assign
     1425         v-frame-height = frame Dialog-Frame :height
     1426         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1427         v-browse-height = v-diasize-browse-handle :height
     1428       .
     1429       for each buf_temp-browse-handle
     1430         where buf_temp-browse-handle.browse-type = 'height':u
     1431       :
     1432         assign
     1433           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1434         .
     1435       end.
     1436       for each buf_temp-diasize-handle
     1437       :
     1438         delete buf_temp-diasize-handle .
     1439       end.
     1440       assign
     1441         v-field-group-handle = frame Dialog-Frame :first-child
     1442       .
     1443       do while valid-handle(v-field-group-handle)
     1444       :
     1445         assign
     1446           v-object-handle = v-field-group-handle :first-child
     1447         .
     1448         do while valid-handle(v-object-handle)
     1449         :
     1450           if  v-object-handle <> v-diasize-browse-handle :handle
     1451           and can-query(v-object-handle, "row")
     1452           and can-query(v-object-handle, "height")
     1453           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1454           then do:
     1455             find first buf_temp-browse-handle
     1456               where buf_temp-browse-handle.browse-type   = 'height':u
     1457                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1458               no-error .
     1459             if available buf_temp-browse-handle
     1460             then do:
     1461             end.
     1462             else do:
     1463               create buf_temp-diasize-handle .
     1464               assign
     1465                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1466                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1467               .
     1468             end.
     1469           end.
     1470           assign
     1471             v-object-handle = v-object-handle :next-sibling
     1472           .
     1473         end.
     1474         assign
     1475           v-field-group-handle = v-field-group-handle :next-sibling
     1476         .
     1477       end.
     1478       do with frame Dialog-Frame
     1479       :
     1480         hide v-diasize-resize-button .
     1481         assign
     1482           v-diasize-resize-button :row    = 1
     1483           v-diasize-resize-button :column = 1
     1484         .
     1485       end.
     1486       if p-change-value > 0
     1487       then do:
     1488         if frame Dialog-Frame :scrollable = true
     1489         then do:
     1490           assign
     1491             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1492             no-error .
     1493           if error-status :error
     1494           or error-status :get-message(1) <> ""
     1495           then do:
     1496             undo move_block, retry move_block .
     1497           end.
     1498         end.
     1499         assign
     1500           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1501           no-error .
     1502         if error-status :error
     1503         or error-status :get-message(1) <> ""
     1504         then do:
     1505           undo move_block, retry move_block .
     1506         end.
     1507         assign
     1508           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1509           no-error .
     1510         if error-status :error
     1511         or error-status :get-message(1) <> ""
     1512         then do:
     1513           undo move_block, retry move_block .
     1514         end.
     1515         for each buf_temp-browse-handle
     1516           where buf_temp-browse-handle.browse-type = 'height':u
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             buf_temp-browse-handle.browse-handle :height
     1521               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529         for each buf_temp-diasize-handle
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             v-object-handle = buf_temp-diasize-handle.handle-value
     1534           .
     1535           if v-object-handle <> v-diasize-resize-button
     1536           then do:
     1537             assign
     1538               v-object-handle :row = v-object-handle :row + p-change-value
     1539               no-error .
     1540             if error-status :error
     1541             or error-status :get-message(1) <> ""
     1542             then do:
     1543               undo move_block, retry move_block .
     1544             end.
     1545           end.
     1546         end.
     1547       end.
     1548       else do:
     1549         for each buf_temp-diasize-handle
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             v-object-handle = buf_temp-diasize-handle.handle-value
     1554           .
     1555           if v-object-handle <> v-diasize-resize-button
     1556           then do:
     1557             assign
     1558               v-object-handle :row = v-object-handle :row + p-change-value
     1559               no-error .
     1560             if error-status :error
     1561             or error-status :get-message(1) <> ""
     1562             then do:
     1563               undo move_block, retry move_block .
     1564             end.
     1565           end.
     1566         end.
     1567         assign
     1568           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1569           no-error .
     1570         if error-status :error
     1571         or error-status :get-message(1) <> ""
     1572         then do:
     1573           undo move_block, retry move_block .
     1574         end.
     1575         for each buf_temp-browse-handle
     1576           where buf_temp-browse-handle.browse-type = 'height':u
     1577         on error undo move_block, retry move_block
     1578         :
     1579           assign
     1580             buf_temp-browse-handle.browse-handle :height
     1581               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1582             no-error .
     1583           if error-status :error
     1584           or error-status :get-message(1) <> ""
     1585           then do:
     1586             undo move_block, retry move_block .
     1587           end.
     1588         end.
     1589         assign
     1590           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1591           no-error .
     1592         if error-status :error
     1593         or error-status :get-message(1) <> ""
     1594         then do:
     1595           undo move_block, retry move_block .
     1596         end.
     1597         if frame Dialog-Frame :scrollable = true
     1598         then do:
     1599           assign
     1600             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1601             no-error .
     1602           if error-status :error
     1603           or error-status :get-message(1) <> ""
     1604           then do:
     1605             undo move_block, retry move_block .
     1606           end.
     1607         end.
     1608       end.
     1609       if p-move-resize = true
     1610       then do:
     1611         run diasize_position-resize-button in this-procedure .
     1612       end.
     1613       if v-diasize-wndstore = true
     1614       then do:
     1615         if connected("ub") = true
     1616         then do:
     1617           define variable v-cntxt-db-num        as integer   no-undo .
     1618           define variable v-cntxt-userid        as character no-undo .
     1619           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1620                                             , OUTPUT v-cntxt-userid
     1621                                             ) .
     1622           run gbl/wndsizew.p
     1623             (input  v-cntxt-db-num
     1624             ,input  v-cntxt-userid
     1625             ,input  v-diasize-proc-name
     1626             ,input  'height':u
     1627             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1628             ) .
     1629         end.
     1630       end.
     1631     end.
     1632     assign
     1633       v-diasize-change-size = false
     1634     .
     1635   end procedure.
     1636   procedure diasize_set-height :
     1637     define input  parameter p-new-height  as decimal   no-undo .
     1638     define input  parameter p-move-resize as logical   no-undo .
     1639     do
     1640     on error undo, return error return-value
     1641     :
     1642       run diasize_change-height in this-procedure
     1643         (input  (p-new-height - frame Dialog-Frame :height)
     1644         ,input  p-move-resize
     1645         ) .
     1646     end.
     1647   end procedure.
     1648   procedure diasize_change-width :
     1649     define input  parameter p-change-value as decimal   no-undo .
     1650     define input  parameter p-move-resize  as logical   no-undo .
     1651     define variable v-field-group-handle   as handle    no-undo .
     1652     define variable v-object-handle        as handle    no-undo .
     1653     define variable v-frame-width          as decimal   no-undo .
     1654     define variable v-frame-virtual-width  as decimal   no-undo .
     1655     define variable v-browse-width         as decimal   no-undo .
     1656     define variable v-window-width         as decimal   no-undo .
     1657     define variable v-window-virtual-width as decimal   no-undo .
     1658     define variable v-change-sign          as integer   no-undo .
     1659     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1660     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1661     if p-change-value > 0
     1662     then do:
     1663       if frame Dialog-Frame :width + p-change-value >
     1664           session :width-chars
     1665       then do:
     1666         assign
     1667           p-change-value = session :width-chars - frame Dialog-Frame :width
     1668         .
     1669         if p-change-value <= 0
     1670         then do:
     1671           run diasize_position-resize-button in this-procedure .
     1672           return .
     1673         end.
     1674       end.
     1675     end.
     1676     if p-change-value < 0
     1677     then do:
     1678       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1679       then do:
     1680         assign
     1681           p-change-value = v-diasize-orig-frame-width
     1682                          - frame Dialog-Frame :width
     1683         .
     1684         if p-change-value >= 0
     1685         then do:
     1686           run diasize_position-resize-button in this-procedure .
     1687           return .
     1688         end.
     1689       end.
     1690     end.
     1691     if p-change-value >= 0
     1692     then do:
     1693       assign
     1694         v-change-sign = 1
     1695       .
     1696     end.
     1697     else do:
     1698       assign
     1699         v-change-sign = -1
     1700       .
     1701     end.
     1702     assign
     1703       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1704     .
     1705     if p-change-value = 0
     1706     then do:
     1707       run diasize_position-resize-button in this-procedure .
     1708       return .
     1709     end.
     1710     move_block:
     1711     do
     1712     on error undo move_block, leave move_block
     1713     :
     1714       if retry
     1715       then do:
     1716         do
     1717         on error undo move_block, leave move_block
     1718         :
     1719           if p-change-value > 0
     1720           then do:
     1721             for each buf_temp-diasize-handle
     1722             on error undo, next
     1723             :
     1724               assign
     1725                 v-object-handle = buf_temp-diasize-handle.handle-value
     1726               .
     1727               if v-object-handle <> v-diasize-resize-button
     1728               then do:
     1729                 assign
     1730                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1731                 .
     1732               end.
     1733             end.
     1734             assign
     1735               v-diasize-browse-handle :width = v-browse-width
     1736             .
     1737             for each buf_temp-browse-handle
     1738               where buf_temp-browse-handle.browse-type = 'width':u
     1739             on error undo, next
     1740             :
     1741               assign
     1742                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1743               .
     1744             end.
     1745             assign
     1746               frame Dialog-Frame :width = v-frame-width
     1747             .
     1748             if frame Dialog-Frame :scrollable = true
     1749             then do:
     1750               assign
     1751                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1752               .
     1753             end.
     1754             run diasize_position-resize-button in this-procedure .
     1755           end.
     1756           else do:
     1757             if frame Dialog-Frame :scrollable = true
     1758             then do:
     1759               assign
     1760                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1761               .
     1762             end.
     1763             assign
     1764               frame Dialog-Frame :width = v-frame-width
     1765             .
     1766             for each buf_temp-browse-handle
     1767               where buf_temp-browse-handle.browse-type = 'width':u
     1768             on error undo, next
     1769             :
     1770               assign
     1771                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1772               .
     1773             end.
     1774             assign
     1775               v-diasize-browse-handle :width = v-browse-width
     1776             .
     1777             for each buf_temp-diasize-handle
     1778             on error undo, next
     1779             :
     1780               assign
     1781                 v-object-handle = buf_temp-diasize-handle.handle-value
     1782               .
     1783               if v-object-handle <> v-diasize-resize-button
     1784               then do:
     1785                 assign
     1786                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1787                 .
     1788               end.
     1789             end.
     1790             run diasize_position-resize-button in this-procedure .
     1791           end.
     1792           assign
     1793             v-diasize-change-size = false
     1794           .
     1795           leave move_block .
     1796         end.
     1797       end.
     1798       assign
     1799         v-diasize-need-full-display = true
     1800       .
     1801       if v-diasize-change-size = false
     1802       then do:
     1803         assign
     1804           v-diasize-change-size = true
     1805         .
     1806       end.
     1807       else do:
     1808         return .
     1809       end.
     1810       assign
     1811         v-frame-width = frame Dialog-Frame :width
     1812         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1813         v-browse-width = v-diasize-browse-handle :width
     1814       .
     1815       for each buf_temp-browse-handle
     1816         where buf_temp-browse-handle.browse-type = 'width':u
     1817       :
     1818         assign
     1819           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1820         .
     1821       end.
     1822       for each buf_temp-diasize-handle
     1823       :
     1824         delete buf_temp-diasize-handle .
     1825       end.
     1826       assign
     1827         v-field-group-handle = frame Dialog-Frame :first-child
     1828       .
     1829       do while valid-handle(v-field-group-handle)
     1830       :
     1831         assign
     1832           v-object-handle = v-field-group-handle :first-child
     1833         .
     1834         do while valid-handle(v-object-handle)
     1835         :
     1836           if  v-object-handle <> v-diasize-browse-handle :handle
     1837           and v-object-handle <> v-diasize-resize-button
     1838           and can-query(v-object-handle, "row")
     1839           and can-query(v-object-handle, "height")
     1840           and ( v-object-handle :col + v-object-handle :width
     1841                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1842               )
     1843           then do:
     1844             find first buf_temp-browse-handle
     1845               where buf_temp-browse-handle.browse-type   = 'width':u
     1846                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1847               no-error .
     1848             if available buf_temp-browse-handle
     1849             then do:
     1850             end.
     1851             else do:
     1852               create buf_temp-diasize-handle .
     1853               assign
     1854                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1855                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1856               .
     1857             end.
     1858           end.
     1859           assign
     1860             v-object-handle = v-object-handle :next-sibling
     1861           .
     1862         end.
     1863         assign
     1864           v-field-group-handle = v-field-group-handle :next-sibling
     1865         .
     1866       end.
     1867       do with frame Dialog-Frame
     1868       :
     1869         hide v-diasize-resize-button .
     1870         v-diasize-resize-button :row = 1.
     1871         v-diasize-resize-button :column = 1.
     1872       end.
     1873       if p-change-value > 0
     1874       then do:
     1875         if frame Dialog-Frame :scrollable = true
     1876         then do:
     1877           assign
     1878             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1879             no-error .
     1880           if error-status :error
     1881           or error-status :get-message(1) <> ""
     1882           then do:
     1883             undo move_block, retry move_block.
     1884           end.
     1885         end.
     1886         assign
     1887           frame Dialog-Frame :width = v-frame-width + p-change-value
     1888           no-error .
     1889         if error-status :error
     1890         or error-status :get-message(1) <> ""
     1891         then do:
     1892           undo move_block, retry move_block.
     1893         end.
     1894         assign
     1895           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1896         no-error .
     1897         if error-status :error
     1898         or error-status :get-message(1) <> ""
     1899         then do:
     1900           undo move_block, retry move_block.
     1901         end.
     1902         for each buf_temp-browse-handle
     1903           where buf_temp-browse-handle.browse-type = 'width':u
     1904         on error undo move_block, retry move_block
     1905         :
     1906           assign
     1907             buf_temp-browse-handle.browse-handle :width
     1908               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1909             no-error .
     1910           if error-status :error
     1911           or error-status :get-message(1) <> ""
     1912           then do:
     1913             undo move_block, retry move_block .
     1914           end.
     1915         end.
     1916         for each buf_temp-diasize-handle
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             v-object-handle = buf_temp-diasize-handle.handle-value
     1921           .
     1922           if v-object-handle <> v-diasize-resize-button
     1923           then do:
     1924             assign
     1925               v-object-handle :col = v-object-handle :col + p-change-value
     1926               no-error .
     1927             if error-status :error
     1928             or error-status :get-message(1) <> ""
     1929             then do:
     1930               undo move_block, retry move_block .
     1931             end.
     1932           end.
     1933         end.
     1934       end.
     1935       else do:
     1936         for each buf_temp-diasize-handle
     1937         on error undo move_block, retry move_block
     1938         :
     1939           assign
     1940             v-object-handle = buf_temp-diasize-handle.handle-value
     1941           .
     1942           if v-object-handle <> v-diasize-resize-button
     1943           then do:
     1944             assign
     1945               v-object-handle :col = v-object-handle :col + p-change-value
     1946               no-error .
     1947             if error-status :error
     1948             or error-status :get-message(1) <> ""
     1949             then do:
     1950               undo move_block, retry move_block .
     1951             end.
     1952           end.
     1953         end.
     1954         for each buf_temp-browse-handle
     1955           where buf_temp-browse-handle.browse-type = 'width':u
     1956         on error undo move_block, retry move_block
     1957         :
     1958           assign
     1959             buf_temp-browse-handle.browse-handle :width
     1960               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1961             no-error .
     1962           if error-status :error
     1963           or error-status :get-message(1) <> ""
     1964           then do:
     1965             undo move_block, retry move_block .
     1966           end.
     1967         end.
     1968         assign
     1969           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1970           no-error .
     1971         if error-status :error
     1972         or error-status :get-message(1) <> ""
     1973         then do:
     1974           undo move_block, retry move_block.
     1975         end.
     1976         assign
     1977           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1978         no-error .
     1979         if error-status :error
     1980         or error-status :get-message(1) <> ""
     1981         then do:
     1982           undo move_block, retry move_block.
     1983         end.
     1984         if frame Dialog-Frame :scrollable = true
     1985         then do:
     1986           assign
     1987             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1988           no-error .
     1989           if error-status :error
     1990           or error-status :get-message(1) <> ""
     1991           then do:
     1992             undo move_block, retry move_block.
     1993           end.
     1994         end.
     1995       end.
     1996       if p-move-resize
     1997       then do:
     1998         run diasize_position-resize-button in this-procedure .
     1999       end.
     2000       if v-diasize-wndstore = true
     2001       then do:
     2002         if connected("ub") = true
     2003         then do:
     2004           define variable v-cntxt-db-num        as integer   no-undo .
     2005           define variable v-cntxt-userid        as character no-undo .
     2006           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2007                                             , OUTPUT v-cntxt-userid
     2008                                             ) .
     2009           run gbl/wndsizew.p
     2010             (input  v-cntxt-db-num
     2011             ,input  v-cntxt-userid
     2012             ,input  v-diasize-proc-name
     2013             ,input  'width':u
     2014             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2015             ) .
     2016         end.
     2017       end.
     2018     end.
     2019     assign
     2020       v-diasize-change-size = false
     2021     .
     2022   end procedure.
     2023   procedure diasize_set-width :
     2024     define input  parameter p-new-width  as decimal   no-undo .
     2025     define input  parameter p-move-resize as logical   no-undo .
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       run diasize_change-width in this-procedure
     2030         (input  (p-new-width - frame Dialog-Frame :width)
     2031         ,input  p-move-resize
     2032         ) .
     2033     end.
     2034   end procedure.
     2035   procedure diasize_position-resize-button :
     2036     do with frame Dialog-Frame
     2037     :
     2038       hide v-diasize-resize-button .
     2039       assign
     2040         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2041                     - 1
     2042                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2043         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2044                     - 1
     2045                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2046       .
     2047       view v-diasize-resize-button .
     2048     end.
     2049   end procedure.
     2050   on alt-right anywhere
     2051   do:
     2052     run diasize_change-width in this-procedure
     2053       (input 1
     2054       ,input true
     2055       ) .
     2056     return no-apply .
     2057   end.
     2058   on alt-left anywhere
     2059   do:
     2060     run diasize_change-width in this-procedure
     2061       (input -1
     2062       ,input true
     2063       ) .
     2064     return no-apply .
     2065   end.
     2066   on alt-down anywhere
     2067   do:
     2068     run diasize_change-height in this-procedure
     2069       (input 1
     2070       ,input true
     2071       ) .
     2072     return no-apply .
     2073   end.
     2074   on alt-up anywhere
     2075   do:
     2076     run diasize_change-height in this-procedure
     2077       (input -1
     2078       ,input true
     2079       ) .
     2080     return no-apply .
     2081   end.
     2082   on alt-enter of frame Dialog-Frame
     2083   do:
     2084     run diasize_maximize in this-procedure
     2085       (input  ?
     2086       ).
     2087     return no-apply .
     2088   end.
     2089   procedure diasize_end-move :
     2090     do
     2091     on error undo, return error return-value
     2092     :
     2093       define variable v-row-delta as decimal   no-undo .
     2094       define variable v-col-delta as decimal   no-undo .
     2095       define variable v-new-row as decimal   no-undo .
     2096       define variable v-new-col as decimal   no-undo .
     2097       assign
     2098         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2099         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2100       .
     2101       assign
     2102         v-row-delta = v-new-row - frame Dialog-Frame :height
     2103         v-col-delta = v-new-col - frame Dialog-Frame :width
     2104       .
     2105       run diasize_change-height in this-procedure
     2106         (input v-row-delta
     2107         ,input true
     2108         ) .
     2109       run diasize_change-width in this-procedure
     2110         (input v-col-delta
     2111         ,input true
     2112         ) .
     2113     end.
     2114   end procedure.
     2115   procedure diasize_maximize :
     2116     define input  parameter p-action as logical   no-undo .
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       if p-action = ?
     2121       then do:
     2122         if v-diasize-need-maximize = true
     2123         then do:
     2124           assign
     2125             p-action = true
     2126           .
     2127         end.
     2128         else do:
     2129           assign
     2130             p-action = false
     2131           .
     2132         end.
     2133       end.
     2134       if p-action = true
     2135       then do:
     2136         run diasize_change-height in this-procedure
     2137           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2138               - frame Dialog-Frame :height-chars
     2139           ,input true
     2140           ) .
     2141         run diasize_change-width in this-procedure
     2142           (input session :width-chars
     2143               - frame Dialog-Frame :width-chars
     2144           ,input true
     2145           ) .
     2146         assign
     2147           v-diasize-need-maximize = false
     2148         .
     2149       end.
     2150       else do:
     2151         run diasize_change-width in this-procedure
     2152           (input v-diasize-orig-frame-width
     2153               - frame Dialog-Frame :width-chars
     2154           ,input true
     2155           ) .
     2156         run diasize_change-height in this-procedure
     2157           (input v-diasize-orig-frame-height
     2158               - frame Dialog-Frame :height-chars
     2159           ,input true
     2160           ) .
     2161         assign
     2162           v-diasize-need-maximize = true
     2163         .
     2164       end.
     2165     end.
     2166   end procedure.
     2167   procedure diasize_restore-orig-size :
     2168     do
     2169     on error undo, return error return-value
     2170     :
     2171       assign
     2172         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2173         v-diasize-current-frame-height = frame Dialog-Frame :height
     2174       .
     2175       run diasize_set-height in this-procedure
     2176         (input  v-diasize-orig-frame-height
     2177         ,input  true
     2178         ) .
     2179       run diasize_set-width in this-procedure
     2180         (input  v-diasize-orig-frame-width
     2181         ,input  true
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_restore-current-size :
     2186     do
     2187     on error undo, return error return-value
     2188     :
     2189       run diasize_set-height in this-procedure
     2190         (input  v-diasize-current-frame-height
     2191         ,input  true
     2192         ) .
     2193       run diasize_set-width in this-procedure
     2194         (input  v-diasize-current-frame-width
     2195         ,input  true
     2196         ) .
     2197     end.
     2198   end procedure.
     2199   procedure diasize_set-browse-handle :
     2200     define input  parameter p-browse-handle as handle   no-undo .
     2201     define buffer buf_temp-browse-handle for temp-browse-handle .
     2202     do
     2203     on error undo, return error return-value
     2204     :
     2205       assign
     2206         v-diasize-browse-handle = p-browse-handle
     2207       .
     2208       for each buf_temp-browse-handle
     2209       on error undo, return error return-value
     2210       :
     2211         delete buf_temp-browse-handle .
     2212       end.
     2213     end.
     2214   end procedure.
     2215   procedure diasize_add_browse :
     2216     define input  parameter p-browse-type   as character no-undo .
     2217     define input  parameter p-browse-handle as handle    no-undo .
     2218     define buffer buf_temp-browse-handle for temp-browse-handle .
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       assign
     2223         v-diasize-browse-number = v-diasize-browse-number + 1
     2224       .
     2225       create buf_temp-browse-handle .
     2226       assign
     2227         buf_temp-browse-handle.browse-type   = p-browse-type
     2228         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2229         buf_temp-browse-handle.browse-handle = p-browse-handle
     2230       .
     2231     end.
     2232   end procedure.
     2233   procedure diasize_init :
     2234     define variable v-default-value    as logical   no-undo .
     2235     define variable v-restore-saved    as logical   no-undo .
     2236     define variable v-resize-value-str as character no-undo .
     2237     do
     2238     on error undo, return error return-value
     2239     :
     2240       do with frame Dialog-Frame
     2241       :
     2242         assign
     2243           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2244           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2245           v-diasize-browse-handle     = browse BR-changes :handle
     2246         .
     2247         create button v-diasize-resize-button
     2248         assign
     2249           parent        = frame Dialog-Frame :first-child
     2250           label         = "s"
     2251           height-pixels = 16
     2252           width-pixels  = 16
     2253           visible       = true
     2254           sensitive     = true
     2255           movable       = true
     2256           triggers:
     2257             on end-move persistent run diasize_end-move in this-procedure .
     2258           end triggers.
     2259         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2260         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2261         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2262         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2263         assign
     2264           v-diasize-wndmax = false
     2265         .
     2266         if connected("ub") = true
     2267         then do:
     2268           define variable v-cntxt-db-num        as integer   no-undo .
     2269           define variable v-cntxt-userid        as character no-undo .
     2270           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2271                                             , OUTPUT v-cntxt-userid
     2272                                             ) .
     2273           run gbl/wndpar_r.p
     2274             (input  v-cntxt-db-num
     2275             ,input  v-cntxt-userid
     2276             ,input  'wndmax':U
     2277             ,output v-diasize-wndmax
     2278             ,output v-default-value
     2279             ) .
     2280         end.
     2281         assign
     2282           v-diasize-wndstore = false
     2283         .
     2284         if connected("ub") = true
     2285         then do:
     2286           run gbl/wndpar_r.p
     2287             (input  v-cntxt-db-num
     2288             ,input  v-cntxt-userid
     2289             ,input  'wndstore':U
     2290             ,output v-diasize-wndstore
     2291             ,output v-default-value
     2292             ) .
     2293         end.
     2294         assign
     2295           v-diasize-proc-name = entry(1, program-name(2), '.')
     2296         .
     2297         if v-diasize-wndstore = true
     2298         then do:
     2299           assign
     2300             v-restore-saved = false
     2301           .
     2302           if connected("ub") = true
     2303           then do:
     2304             run gbl/wndsizer.p
     2305               (input  v-cntxt-db-num
     2306               ,input  v-cntxt-userid
     2307               ,input  v-diasize-proc-name
     2308               ,input  'height':u
     2309               ,output v-resize-value-str
     2310               ) .
     2311             if v-resize-value-str <> '':U
     2312             then do:
     2313               run diasize_change-height in this-procedure
     2314                 (input  integer(v-resize-value-str)
     2315                 ,input  true
     2316                 ) .
     2317               assign
     2318                 v-restore-saved = true
     2319               .
     2320             end.
     2321           end.
     2322           if connected("ub") = true
     2323           then do:
     2324             run gbl/wndsizer.p
     2325               (input  v-cntxt-db-num
     2326               ,input  v-cntxt-userid
     2327               ,input  v-diasize-proc-name
     2328               ,input  'width':u
     2329               ,output v-resize-value-str
     2330               ) .
     2331             if v-resize-value-str <> '':U
     2332             then do:
     2333               run diasize_change-width in this-procedure
     2334                 (input  integer(v-resize-value-str)
     2335                 ,input  true
     2336                 ) .
     2337               assign
     2338                 v-restore-saved = true
     2339               .
     2340             end.
     2341           end.
     2342           if v-restore-saved <> true
     2343           then do:
     2344             if v-diasize-wndmax = true
     2345             then do:
     2346               run diasize_maximize in this-procedure
     2347                 (input  true
     2348                 ) .
     2349             end.
     2350           end.
     2351         end.
     2352         else do:
     2353           if v-diasize-wndmax = true
     2354           then do:
     2355             run diasize_maximize in this-procedure
     2356               (input  true
     2357               ) .
     2358           end.
     2359         end.
     2360       end.
     2361     end.
     2362   end procedure.
     2363   procedure diasize_need-full-display :
     2364     define output parameter p-need-full-display as logical   no-undo .
     2365     do
     2366     on error undo, return error return-value
     2367     :
     2368       assign
     2369         p-need-full-display = v-diasize-need-full-display
     2370       .
     2371       assign
     2372         v-diasize-need-full-display = false
     2373       .
     2374     end.
     2375   end procedure.
     2376   procedure get-context :
     2377      define output parameter p-db-num as integer          no-undo.
     2378      define output parameter p-user-id as character        no-undo.
     2379      define variable v-login               as character    no-undo.
     2380      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2381      define buffer buf_user-login  for ub.user-login .
     2382      do
     2383      on error undo, return error
     2384      :
     2385            FIND FIRST buf_sys-ctrl no-lock.
     2386            ASSIGN
     2387               v-login = USERID("ub")
     2388               p-db-num = buf_sys-ctrl.db-num
     2389            .
     2390            FIND FIRST buf_user-login
     2391                 WHERE buf_user-login.db-num = p-db-num
     2392                   AND buf_user-login.user-login = v-login
     2393                 no-lock
     2394                 no-error
     2395                 .
     2396            IF AVAILABLE buf_user-login
     2397            THEN DO:
     2398               assign
     2399                  p-user-id = buf_user-login.user-id
     2400               .
     2401            END.
     2402      end.
     2403   end procedure.
     2404       run diasize_init in this-procedure .
     2405   MAIN-BLOCK:
     2406   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2407      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2408   define variable p-file-label as character no-undo .
     2409   temp-changes.l_name:RESIZABLE in browse BR-changes = true .
     2410   temp-changes.v_old:RESIZABLE  in browse BR-changes = true .
     2411   temp-changes.v_new:RESIZABLE  in browse BR-changes = true .
     2412   define buffer buf_clients for  ub.clients .
     2413     run my-enable_ui.
     2414     run openbr (yes, no, '':u).
     2415     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2416     wait-for go of frame Dialog-Frame.
     2417   END.
     2418   run disable_ui.
     2419   PROCEDURE disable_UI :
     2420     HIDE FRAME Dialog-Frame.
     2421   END PROCEDURE.
     2422   PROCEDURE enable_UI :
     2423     ENABLE B-Cancel B-Help BR-docs BR-changes
     2424         WITH FRAME Dialog-Frame.
     2425     VIEW FRAME Dialog-Frame.
     2426     OPEN QUERY BR-docs FOR EACH buf_c-price-doc no-lock.
     2427   END PROCEDURE.
     2428   PROCEDURE my-enable_UI :
     2429   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2431     (input  par-host-code
     2432     ,output p-base-code
     2433     )  .
     2434     ENABLE B-Cancel
     2435            B-sch
     2436            B-Help
     2437            BR-docs
     2438            BR-changes
     2439         WITH FRAME Dialog-Frame.
     2440     VIEW FRAME Dialog-Frame.
     2441   END PROCEDURE.
     2442   PROCEDURE OpenBr :
     2443   define input  parameter p-open-query     as logical   no-undo .
     2444   define input  parameter p-find-next      as logical   no-undo .
     2445   define input  parameter p-find-condition as character no-undo .
     2446   def var l-query-was-opened as logical no-undo .
     2447   define variable title0 as character no-undo.
     2448   title0 = caps(p-file-label) + chr(32).
     2449   def var sort-column-phrase as character no-undo .
     2450   case sort-column-name :
     2451     when "" then do:
     2452       assign
     2453         sort-column-phrase = ""
     2454       .
     2455     end.
     2456     otherwise do:
     2457       assign
     2458         sort-column-phrase = "by " + sort-column-name
     2459       .
     2460     end.
     2461   end case.
     2462   define variable l-open-query as logical   no-undo .
     2463          find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     2464          if not available buf_clients then return .
     2465          filter-point = filter-point0 .
     2466          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + " Код фирмы " +  string(par-host-code).
     2467   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   define variable  l-disable-where-16  as logical   no-undo .
     2469   define variable  l-filter-open-16    as logical   .
     2470   define variable  flt-rec-16       as recid     no-undo .
     2471   define variable  filter-name-16      as character no-undo .
     2472   define variable  where-phrase-16     as character no-undo .
     2473   define variable  sort-phrase-16      as character no-undo .
     2474   define variable  where-phrase-rus-16 as character no-undo .
     2475   define variable  sort-phrase-rus-16  as character no-undo .
     2476   run gbl/flt-get.p
     2477     (input filter-point
     2478     ,output flt-rec-16
     2479     ,output filter-name-16
     2480     ,output where-phrase-16
     2481     ,output sort-phrase-16
     2482     ,output where-phrase-rus-16
     2483     ,output sort-phrase-rus-16
     2484     ).
     2485   if p-open-query then do:
     2486       run set-filter-name in this-procedure
     2487         (INPUT filter-name-16
     2488         ) no-error .
     2489     assign
     2490       l-filter-open-16 = false
     2491     .
     2492     if flt-rec-16 <> ?
     2493       or sort-column-phrase > ""
     2494     then do:
     2495       define variable  parameter-2-16 as character no-undo .
     2496       define variable  parameter-3-16 as character no-undo .
     2497       define variable  parameter-4-16 as character no-undo .
     2498       define variable  parameter-5-16 as character no-undo .
     2499       define variable  parameter-6-16 as character no-undo .
     2500       define variable  parameter-7-16 as character no-undo .
     2501         assign
     2502         parameter-3-16 =
     2503                                 "FOR EACH BUF_c-price-doc"
     2504         parameter-4-16 =
     2505           (
     2506             if (" buf_c-price-doc.doc-num = par-doc-num  " + " " + where-phrase-16) <> ""
     2507             then  substitute(' buf_c-price-doc.doc-num =  &1 '  , chr(34) , par-doc-num )  + " " + where-phrase-16
     2508             else "true"
     2509           )
     2510         parameter-5-16 = (" " + "" + " " + "")
     2511         parameter-6-16 = if sort-phrase-16 = ''
     2512                              then
     2513           (
     2514           " " + "  " +
     2515             " " + sort-column-phrase +
     2516           " " + "  "
     2517           )
     2518                              else
     2519           (
     2520           " " + "  " +
     2521             " " + sort-column-phrase +
     2522           " " + sort-phrase-16
     2523           )
     2524         parameter-7-16 =
     2525           " indexed-reposition  "
     2526       .
     2527       do
     2528       on stop undo, leave
     2529       on error undo, leave
     2530       :
     2531         assign
     2532           l-disable-where-16 =
     2533             (" buf_c-price-doc.doc-num = par-doc-num  " + " " + where-phrase-16 = "")
     2534         .
     2535         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2536                             ,input query br-docs:handle
     2537                             ,input parameter-3-16
     2538                             ,input parameter-4-16
     2539                             ,input parameter-5-16
     2540                             ,input parameter-6-16
     2541                             ,input parameter-7-16
     2542                             )
     2543         .
     2544         assign
     2545           l-filter-open-16 = true
     2546         .
     2547       end.
     2548       if l-filter-open-16 = false then do:
     2549         message
     2550           "Ошибка при фильтрации / сортировке" skip
     2551           "Будут показаны записи без учета фильтра" skip
     2552           view-as alert-box .
     2553       end.
     2554       else do:
     2555           assign
     2556             l-query-was-opened = true
     2557           .
     2558       end.
     2559     end.
     2560     if l-filter-open-16 = false then do:
     2561       OPEN QUERY br-docs FOR EACH buf_c-price-doc
     2562         where  buf_c-price-doc.doc-num = par-doc-num
     2563         indexed-reposition
     2564     .
     2565         assign
     2566           l-query-was-opened = true
     2567         .
     2568     end.
     2569   end.
     2570   else do:
     2571     assign
     2572       doc-rec = recid( buf_c-price-doc )
     2573     .
     2574     do
     2575     on stop undo, leave
     2576     on error undo, leave
     2577     :
     2578       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-price-doc:handle) then do:
     2579         assign
     2580         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2581         parameter-4-16 =
     2582           "where ":u +  substitute(' buf_c-price-doc.doc-num =  &1 '  , chr(34) , par-doc-num )  + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     2583         parameter-5-16 = "  "
     2584       .
     2585         run fltopend_fltfindd in this-procedure  (
     2586                             input this-procedure:handle
     2587                             ,input query br-docs:handle
     2588                             ,input rowid(buf_c-price-doc)
     2589                             ,input logical(parameter-2-16)
     2590                             ,input no-lock
     2591                             ,input (buffer buf_c-price-doc:handle)
     2592                             ,input parameter-4-16
     2593                             ,input parameter-5-16
     2594                             ) no-error.
     2595         .
     2596         assign
     2597           doc-rec = integer(return-value)
     2598           v-fltopend-rowid[1] = ?
     2599         .
     2600       end.
     2601       else do:
     2602         assign
     2603         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2604         parameter-3-16 =  "FOR EACH BUF_c-price-doc"
     2605         parameter-4-16 =
     2606           (
     2607             if (" buf_c-price-doc.doc-num = par-doc-num  " + " " + where-phrase-16) <> ""
     2608             then  substitute(' buf_c-price-doc.doc-num =  &1 '  , chr(34) , par-doc-num )  + " " + where-phrase-16
     2609             else "true"
     2610           )
     2611         parameter-5-16 = (" " + "" + " " + "" + " " + p-find-condition)
     2612         parameter-6-16 = if sort-phrase-16 = ''
     2613                              then
     2614           (
     2615           " " + "  " +
     2616             " " + sort-column-phrase +
     2617           " " + "  "
     2618           )
     2619                              else
     2620           (
     2621           " " + "  " +
     2622             " " + sort-column-phrase +
     2623           " " + sort-phrase-16
     2624           )
     2625         parameter-7-16 =
     2626           " indexed-reposition  "
     2627       .
     2628         run fltopend_fltfindq in this-procedure  (
     2629                             input this-procedure:handle
     2630                             ,input query br-docs:handle
     2631                             ,input logical(parameter-2-16)
     2632                             ,input no-lock
     2633                             ,input parameter-3-16
     2634                             ,input parameter-4-16
     2635                             ,input parameter-5-16
     2636                             ,input parameter-6-16
     2637                             ,input parameter-7-16
     2638                             ,output v-fltopend-rowid
     2639                             ) no-error.
     2640         .
     2641         doc-rec = ?.
     2642       end.
     2643       assign
     2644         l-query-was-opened = true
     2645       .
     2646     end.
     2647   end.
     2648   if not p-open-query then
     2649   REPOSITION br-docs to recid doc-rec No-ERROR.
     2650   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2651   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     2652   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2653   APPLY "ENTRY" TO br-docs.
     2654   END PROCEDURE.
     2655   PROCEDURE proc-b-sch :
     2656   assign
     2657     tbl = 'c-price-doc'
     2658     join-tbl = 'buf_c-price-doc'
     2659     fld = ""
     2660     lab = ""
     2661     spr = ""
     2662     dim = '0'
     2663     .
     2664   run fltfield-add in this-procedure('doc-num', 'Внутр.№', '',
     2665   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2666   run fltfield-add in this-procedure('status_', 'Статус', '',
     2667   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2668   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     2669   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2670   Filter-Block:
     2671   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2672       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2673       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2674     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2675     run openbr ( yes, no, '':u).
     2676   END.
     2677   END PROCEDURE.
     2678   PROCEDURE proc-find-code :
     2679   define input parameter par-next as logical no-undo.
     2680   define input parameter pardoc-num as char no-undo.
     2681   END PROCEDURE.
     2682   PROCEDURE proc-view-changes :
     2683   define buffer new_c-price-doc for ub.c-price-doc.
     2684   define buffer current_price-doc for ub.price-doc.
     2685   define variable v-chg-fields as character no-undo.
     2686   define variable v-old-fields as character no-undo.
     2687   define variable v-new-fields as character no-undo.
     2688   define variable ii as integer no-undo.
     2689   for each temp-changes:
     2690       delete temp-changes.
     2691   END.
     2692   if not available buf_c-price-doc then do:
     2693     Open QUery br-changes for each temp-changes.
     2694     return.
     2695   end.
     2696   find first new_c-price-doc no-lock where
     2697              new_c-price-doc.doc-num  = buf_c-price-doc.doc-num and
     2698              new_c-price-doc.chip-num  > buf_c-price-doc.chip-num no-error.
     2699   if not available new_c-price-doc then do:
     2700           find first current_price-doc no-lock where
     2701                      current_price-doc.doc-num  = buf_c-price-doc.doc-num no-error.
     2702               if not available current_price-doc then do:
     2703               return error.
     2704           end.
     2705           buffer-compare current_price-doc  to buf_c-price-doc
     2706           save result in v-chg-fields.
     2707   end.
     2708   else do:
     2709       buffer-compare new_c-price-doc except chip-num corr-date corr-time corr-man corr-user-db-num to buf_c-price-doc
     2710       save result in v-chg-fields.
     2711   end.
     2712   if num-entries(v-chg-fields) > 0 then do:
     2713   define variable v-1 as integer   no-undo .
     2714   v-1 = num-entries(v-chg-fields) .
     2715   do ii = 1 to v-1 :
     2716   CASE entry(ii, v-chg-fields):
     2717   when "doc-num":U then do:     create temp-changes.       assign         temp-changes.f_name = "doc-num":U         temp-changes.l_name = "Номер"         temp-changes.v_old = string(buf_c-price-doc.doc-num)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.doc-num)                                  else string(current_price-doc.doc-num))       .   end.
     2718   when "host-code":U then do:     create temp-changes.       assign         temp-changes.f_name = "host-code":U         temp-changes.l_name = "Код фирмы"         temp-changes.v_old = string(buf_c-price-doc.host-code)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.host-code)                                  else string(current_price-doc.host-code))       .   end.
     2719   when "status_":U then do:     create temp-changes.       assign         temp-changes.f_name = "status_":U         temp-changes.l_name = "Статус"         temp-changes.v_old = string(buf_c-price-doc.status_)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.status_)                                  else string(current_price-doc.status_))       .   end.
     2720   when "PS":U then do:     create temp-changes.       assign         temp-changes.f_name = "PS":U         temp-changes.l_name = "Примечание"         temp-changes.v_old = string(buf_c-price-doc.PS)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.PS)                                  else string(current_price-doc.PS))       .   end.
     2721   when "base-rate":U then do:     create temp-changes.       assign         temp-changes.f_name = "base-rate":U         temp-changes.l_name = "Курс"         temp-changes.v_old = string(buf_c-price-doc.base-rate)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.base-rate)                                  else string(current_price-doc.base-rate))       .   end.
     2722   when "base-scale":U then do:     create temp-changes.       assign         temp-changes.f_name = "base-scale":U         temp-changes.l_name = "Масш-б"         temp-changes.v_old = string(buf_c-price-doc.base-scale)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.base-scale)                                  else string(current_price-doc.base-scale))       .   end.
     2723   when "doc-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "doc-date":U         temp-changes.l_name = "Дата документа"         temp-changes.v_old = string(buf_c-price-doc.doc-date)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.doc-date)                                  else string(current_price-doc.doc-date))       .   end.
     2724   when "fact-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "fact-date":U         temp-changes.l_name = "Дата факт"         temp-changes.v_old = string(buf_c-price-doc.fact-date)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.fact-date)                                  else string(current_price-doc.fact-date))       .   end.
     2725   when "fact-num":U then do:     create temp-changes.       assign         temp-changes.f_name = "fact-num":U         temp-changes.l_name = "Номер факт"         temp-changes.v_old = string(buf_c-price-doc.fact-num)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.fact-num)                                  else string(current_price-doc.fact-num))       .   end.
     2726   when "fact-order":U then do:     create temp-changes.       assign         temp-changes.f_name = "fact-order":U         temp-changes.l_name = "Номер факт-ордер"         temp-changes.v_old = string(buf_c-price-doc.fact-order)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.fact-order)                                  else string(current_price-doc.fact-order))       .   end.
     2727   when "fact-time":U then do:     create temp-changes.       assign         temp-changes.f_name = "fact-time":U         temp-changes.l_name = "Время факт закрытия"         temp-changes.v_old = string(buf_c-price-doc.fact-time)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.fact-time)                                  else string(current_price-doc.fact-time))       .   end.
     2728   when "obj-code":U then do:     create temp-changes.       assign         temp-changes.f_name = "obj-code":U         temp-changes.l_name = "Код Объекта"         temp-changes.v_old = string(buf_c-price-doc.obj-code)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.obj-code)                                  else string(current_price-doc.obj-code))       .   end.
     2729   when "obj-type":U then do:     create temp-changes.       assign         temp-changes.f_name = "obj-type":U         temp-changes.l_name = "Тип Объекта"         temp-changes.v_old = string(buf_c-price-doc.obj-type)         temp-changes.v_new = (if available new_c-price-doc                                  then string(new_c-price-doc.obj-type)                                  else string(current_price-doc.obj-type))       .   end.
     2730   END CASE.
     2731   end.
     2732   end.
     2733   define buffer old_c-price-list for ub.c-price-list  .
     2734   for each ub.c-price-list where
     2735            ub.c-price-list.doc-num = buf_c-price-doc.doc-num and
     2736            ub.c-price-list.chip-num = buf_c-price-doc.chip-num
     2737            :
     2738        find last old_c-price-list no-lock where
     2739            old_c-price-list.doc-num   = ub.c-price-list.doc-num  and
     2740            old_c-price-list.artic      = ub.c-price-list.artic     and
     2741            old_c-price-list.prod-type  = ub.c-price-list.prod-type and
     2742            old_c-price-list.prod-code  = ub.c-price-list.prod-code and
     2743            old_c-price-list.chip-num   < buf_c-price-doc.chip-num
     2744            use-index pi no-error .
     2745            if available old_c-price-list then do:
     2746                 buffer-compare ub.c-price-list to old_c-price-list
     2747                 save result in v-chg-fields.
     2748            end.
     2749   define variable v-2 as integer   no-undo .
     2750   v-2 = num-entries(v-chg-fields) .
     2751           do ii = 1 to v-2 :
     2752               CASE entry(ii, v-chg-fields):
     2753                                             when "doc-qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-price-list.line-num ) + "doc-qnty":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-price-list.line-num ) + " " + "Количество"         temp-changes.v_new = string(ub.c-price-list.doc-qnty)         temp-changes.v_old =  (if available old_c-price-list                                  then string(old_c-price-list.doc-qnty)                                  else "")       .   end.
     2754                                             when "price-sale":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-price-list.line-num ) + "price-sale":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-price-list.line-num ) + " " + "Цена продажи"         temp-changes.v_new = string(ub.c-price-list.price-sale)         temp-changes.v_old =  (if available old_c-price-list                                  then string(old_c-price-list.price-sale)                                  else "")       .   end.
     2755               end case.
     2756           end.
     2757   end.
     2758   Open QUery br-changes for each temp-changes.
     2759   END PROCEDURE.
     2760   PROCEDURE set-filter-name :
     2761   define input parameter p-filter-name as character no-undo .
     2762     do with frame Dialog-Frame:
     2763       if p-filter-name > "" then do:
     2764         assign
     2765           frame Dialog-Frame:title
     2766             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2767         .
     2768         assign
     2769           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2770         .
     2771       end.
     2772       else do:
     2773         assign
     2774           b-sch :TOOLTIP = ""
     2775         .
     2776       end.
     2777     end.
     2778   END PROCEDURE.
