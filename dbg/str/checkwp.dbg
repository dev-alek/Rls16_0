      489   procedure prn-lib-reportviewer :
      490     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      491     define input parameter p-report-name-html as character no-undo .
      492     define input parameter p-param        as character no-undo .
      493     define variable v-excel           as character no-undo init 'TRUE' .
      494     define variable v-value-character as character no-undo .
      495     define variable v-value-integer   as character no-undo .
      496     define variable v-value-date      as date      no-undo .
      497     define variable v-value-decimal   as decimal   no-undo .
      498     define variable rep-excel         as logical   no-undo .
      499     define variable excel-string      as character no-undo .
      500     define variable v-param-type      as character no-undo .
      501     define variable v-tth             as handle    no-undo .
      502     run adm/shattri.p (
      503       input "get":U
      504       ,input  ""
      505       ,input  0
      506       ,input  'report-glob':U
      507       ,input  'rep-excel':U
      508       ,output v-value-character
      509       ,output v-value-date
      510       ,output v-value-decimal
      511       ,output v-value-integer
      512       ,output rep-excel
      513       ,output v-param-type
      514       ,INPUT-OUTPUT table-handle v-tth
      515       )  .
      516     if rep-excel then v-excel = "TRUE" .
      517     else v-excel = "FALSE" .
      518     if p-param eq ""
      519     then
      520        p-param = "EXCEL:" + v-excel.
      521     else
      522        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      523     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      524   end procedure.
