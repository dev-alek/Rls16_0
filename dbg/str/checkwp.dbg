      559   cash-pay.wth-code COLUMN-LABEL "Код МЦ"
      560   wealth.wth-name COLUMn-LABEL "МЦ" format "X(20)"
      561   chk-pay.tot-sum COLUMN-LABEL "Сумма в вал. платежа"
      562   chk-pay.cash-rate COLUMN-LABEL "Курс валюты"
      563   with width 232 down stream-io use-text    .
      564   run prn-lib-open-stream  in this-procedure (
      565                                                input parParentProc
      566                                               ,input 43
      567                                               ,input yes
      568                                               ,input no
      569                                               ).
      570   VIEW  STREAM PrnLibStream FRAME BottomFrame .
      571   FIND FIRST chk-doc NO-LOCK WHERE chk-doc.doc-code = pardoc-code NO-ERROR.
      572   IF NOT avail chk-doc then return.
      573   Line = fill("-", 141).
      574   date_string = cur-time-print() .
      575   PUT STREAM PrnLibStream UNFORMATTED
      576   line skip(0)
      577   date_string skip(0)
      578   "Чек N "
      579   chk-doc.doc-code SPace(1)
      580   "Магазин N " string(chk-doc.obj-code, ">>>>9") space(1)
      581   "Дата: " string(chk-doc.chk-date, "99/99/9999") space(1)
      582   "Время: " string(chk-doc.chk-time, "HH:MM") space(1)
      583   "Дата смены: " string(chk-doc.shift-date, "99/99/9999") space(1)
      584   "Номер смены: " shift-name-no-err(buffer chk-doc) format "X(6)" space(1)
      585    skip(0)
      586   "Касса N" string(chk-doc.pay-desk, ">>>>9") space(1)
      587   "Номер по кассе " string(chk-doc.chk-num, "9999999") space(1)
      588   "Кассир: " string(chk-doc.cashier, ">>>>9") space(1)
      589   skip(0)
      590   .
      591   FORM with FRAME PAY-Frame  .
      592   PUT STREAM PrnLibStream
      593   SKIP(1)
      594   "ОПЛАТЫ ПО ЧЕКУ:" skip(0)
      595   .
      596   FOR EACH chk-pay No-LOCK WHERE
      597            chk-pay.doc-code = chk-doc.doc-code :
      598       FIND FIRST currency No-LOCK WHERE
      599                  currency.curr-code = chk-pay.curr-code NO-ERROR.
      600       FIND FIRST cash-pay No-LOCK WHERE
      601                 cash-pay.cdpay-code = chk-pay.pay-code AND
      602                 cash-pay.curr-code = chk-pay.curr-code No-ERROR.
      603       if available cash-pay then do:
      604         if cash-pay.wth-code > 0 then do:
      605           FIND FIRST wealth No-LOCK WHERE
      606                      wealth.wth-code = cash-pay.wth-code No-ERROR.
      607         end.
      608         else release wealth.
      609       end.
      610       else release wealth.
      611       DISPLAY STREAM PrnLibStream
      612       chk-pay.curr-code
      613       if avail currency then currency.curr-name else "НЕОПОЗНАННАЯ ВАЛЮТА" @ currency.curr-name
      614       chk-pay.pay-code
      615       if avail cash-pay then cash-pay.obj-name else "НЕОПОЗНАННАЯ ОПЛАТА" @ cash-pay.obj-name
      616       if avail cash-pay then cash-pay.wth-code else ? @ cash-pay.wth-code
      617       if avail wealth then wealth.wth-name else "НЕОПОЗНАННАЯ МЦ" @ wealth.wth-name
      618       chk-pay.tot-sum
      619       chk-pay.cash-rate
      620       WITH FRAME Pay-Frame.
      621       DOWN STREAM PrnLibStream
      622       WITH FRAME Pay-Frame.
      623   END.
      624   UNDERLINE STREAM PrnLibStream
      625   chk-pay.curr-code
      626   currency.curr-name
      627   chk-pay.pay-code
      628   cash-pay.obj-name
      629   cash-pay.wth-code
      630   wealth.wth-name
      631   chk-pay.tot-sum
      632   chk-pay.cash-rate
      633   WITH FRAME Pay-Frame.
      634   DOWN STREAM PrnLibStream
      635   WITH FRAME Pay-Frame.
      636   HIDE  STREAM PrnLibStream FRAME Pay-Frame.
      637   HIDE  STREAM PrnLibStream FRAME Bottom-Frame.
      638   output  STREAM PrnLibStream CLOSE.
      639   run prn-lib-prn-file in this-procedure (
      640                                             input parParentProc
      641                                             ,input 8
      642                                             ).
