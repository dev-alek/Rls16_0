     3417       apply "ctrl-f":U to sch-fact in frame fr-D-rvs-doc-0 .
     3418     END.
     3419   Main-Block:
     3420   do on error   undo Main-Block, leave Main-Block
     3421      on end-key undo Main-Block, leave Main-Block :
     3422      p-host-code = v-cntxt-host-code-obj.
     3423     if lookup( p-mode, 'все,one':U ) = 0 then do:
     3424       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     3425               "Неверное значение параметра вызова p-mode:" p-mode
     3426       view-as alert-box error.
     3427       return.
     3428     end.
     3429     if p-mode = 'one':U then do:
     3430       find first buf_source no-lock where buf_source.rvs-code = p-rvs-code no-error.
     3431       if not available buf_source then do:
     3432         message vss-workfile SKIP vss-revision SKIP vss-date SKIP( 1 ) vss-description SKIP( 1 )
     3433                 'Неверное значение параметра вызова p-rvs-code: "' + p-rvs-code + '"'
     3434         view-as alert-box error.
     3435         return.
     3436       end.
     3437     end.
     3438     if p-rid-list <> "":U then do:
     3439       find first buf_sch_hist no-lock where recid( buf_sch_hist ) = integer( entry( 1, p-rid-list ) ) no-error.
     3440       if not available buf_sch_hist then do:
     3441         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     3442                 'Неверное значение параметра вызова p-rid-list: "' + p-rid-list + '".'
     3443         view-as alert-box error.
     3444         return error.
     3445       end.
     3446       else do:
     3447         assign doc-rec = recid( buf_sch_hist ).
     3448       end.
     3449     end.
     3450     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     3451             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     3452             b-sch b-help Btn_Exit b-lkp br-rvs-docs br-changes sch-code sch-date sch-fact
     3453     with frame fr-D-rvs-doc-0.
     3454     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3455     hide mark-num in frame fr-D-rvs-doc-0.
     3456     hide  sch-num in frame fr-D-rvs-doc-0.
     3457     if p-rid-list <> "":U then do: reposition br-rvs-docs to recid doc-rec no-error. end.
     3458     br-rvs-docs :set-repositioned-row( 5, "CONDITIONAL" ).
     3459     wait-for go of frame fr-D-rvs-doc-0.
     3460   end.
     3461   hide frame fr-D-rvs-doc-0 no-pause.
     3462   procedure OpenBr :
     3463     define input parameter p-open-query     as logical   no-undo.
     3464     define input parameter p-find-next      as logical   no-undo.
     3465     define input parameter p-find-condition as character no-undo.
     3466     define variable l-query-was-opened as logical   no-undo.
     3467     define variable title0             as character no-undo.
     3468     define variable sort-column-phrase as character no-undo.
     3469     define variable p-proc-hand as handle no-undo.
     3470     run WaitFram-Show in this-procedure ( input "Ждите..." ).
     3471     assign title0 = "Список истории изменения" + chr(32).
     3472     assign p-proc-hand = this-procedure :handle.
     3473     case sort-column-name :
     3474       when "":U then do: assign sort-column-phrase = "":U. end.
     3475       otherwise      do: assign sort-column-phrase = "by " + sort-column-name. end.
     3476     end case.
     3477     define variable l-open-query as logical no-undo.
     3478     assign filter-point = filter-point0 + " - " + p-mode.
     3479     case p-mode :
     3480       when 'все':U  then do:
     3481         assign frame fr-D-rvs-doc-0 :title = title0 + "сверок".
     3482   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3483   define variable  l-disable-where-28  as logical   no-undo .
     3484   define variable  l-filter-open-28    as logical   .
     3485   define variable  flt-rec-28       as recid     no-undo .
     3486   define variable  filter-name-28      as character no-undo .
     3487   define variable  where-phrase-28     as character no-undo .
     3488   define variable  sort-phrase-28      as character no-undo .
     3489   define variable  where-phrase-rus-28 as character no-undo .
     3490   define variable  sort-phrase-rus-28  as character no-undo .
     3491     run waitfram-show in this-procedure
     3492       (input "ЖДИТЕ ..."
     3493       ).
     3494   run gbl/flt-get.p
     3495     (input filter-point
     3496     ,output flt-rec-28
     3497     ,output filter-name-28
     3498     ,output where-phrase-28
     3499     ,output sort-phrase-28
     3500     ,output where-phrase-rus-28
     3501     ,output sort-phrase-rus-28
     3502     ).
     3503   if p-open-query then do:
     3504       run set-filter-name in this-procedure
     3505         (INPUT filter-name-28
     3506         ) no-error .
     3507     assign
     3508       l-filter-open-28 = false
     3509     .
     3510     if flt-rec-28 <> ?
     3511       or sort-column-phrase > ""
     3512     then do:
     3513       define variable  parameter-2-28 as character no-undo .
     3514       define variable  parameter-3-28 as character no-undo .
     3515       define variable  parameter-4-28 as character no-undo .
     3516       define variable  parameter-5-28 as character no-undo .
     3517       define variable  parameter-6-28 as character no-undo .
     3518       define variable  parameter-7-28 as character no-undo .
     3519         assign
     3520         parameter-3-28 =
     3521                                 "for each buf_c-rvs-doc no-lock"
     3522         parameter-4-28 =
     3523           (
     3524             if ("                           buf_c-rvs-doc.host-code = p-host-code                         " + " " + where-phrase-28) <> ""
     3525             then  substitute('buf_c-rvs-doc.host-code = &1', p-host-code ) + " " + where-phrase-28
     3526             else "true"
     3527           )
     3528         parameter-5-28 = (" " + "" + " " + "")
     3529         parameter-6-28 = if sort-phrase-28 = ''
     3530                              then
     3531           (
     3532           " " + "  " +
     3533             " " + sort-column-phrase +
     3534           " " + "  "
     3535           )
     3536                              else
     3537           (
     3538           " " + "  " +
     3539             " " + sort-column-phrase +
     3540           " " + sort-phrase-28
     3541           )
     3542         parameter-7-28 =
     3543           " indexed-reposition  "
     3544       .
     3545       do
     3546       on stop undo, leave
     3547       on error undo, leave
     3548       :
     3549         assign
     3550           l-disable-where-28 =
     3551             ("                           buf_c-rvs-doc.host-code = p-host-code                         " + " " + where-phrase-28 = "")
     3552         .
     3553         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3554                             ,input query br-rvs-docs :handle
     3555                             ,input parameter-3-28
     3556                             ,input parameter-4-28
     3557                             ,input parameter-5-28
     3558                             ,input parameter-6-28
     3559                             ,input parameter-7-28
     3560                             )
     3561         .
     3562         assign
     3563           l-filter-open-28 = true
     3564         .
     3565       end.
     3566       if l-filter-open-28 = false then do:
     3567         message
     3568           "Ошибка при фильтрации / сортировке" skip
     3569           "Будут показаны записи без учета фильтра" skip
     3570           view-as alert-box .
     3571       end.
     3572       else do:
     3573           assign
     3574             l-query-was-opened = true
     3575           .
     3576       end.
     3577     end.
     3578     if l-filter-open-28 = false then do:
     3579       open query br-rvs-docs for each buf_c-rvs-doc
     3580         where                            buf_c-rvs-doc.host-code = p-host-code
     3581         indexed-reposition
     3582     .
     3583         assign
     3584           l-query-was-opened = true
     3585         .
     3586     end.
     3587   end.
     3588   else do:
     3589     assign
     3590       doc-rec = recid( buf_c-rvs-doc )
     3591     .
     3592     do
     3593     on stop undo, leave
     3594     on error undo, leave
     3595     :
     3596       if query br-rvs-docs :handle:get-buffer-handle(1) = (buffer buf_c-rvs-doc:handle) then do:
     3597         assign
     3598         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3599         parameter-4-28 =
     3600           "where ":u +  substitute('buf_c-rvs-doc.host-code = &1', p-host-code ) + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3601         parameter-5-28 = "  "
     3602       .
     3603         run fltopend_fltfindd in this-procedure  (
     3604                             input this-procedure:handle
     3605                             ,input query br-rvs-docs :handle
     3606                             ,input rowid(buf_c-rvs-doc)
     3607                             ,input logical(parameter-2-28)
     3608                             ,input no-lock
     3609                             ,input (buffer buf_c-rvs-doc:handle)
     3610                             ,input parameter-4-28
     3611                             ,input parameter-5-28
     3612                             ) no-error.
     3613         .
     3614         assign
     3615           doc-rec = integer(return-value)
     3616           v-fltopend-rowid[1] = ?
     3617         .
     3618       end.
     3619       else do:
     3620         assign
     3621         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3622         parameter-3-28 =  "for each buf_c-rvs-doc no-lock"
