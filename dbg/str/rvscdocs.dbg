     1278   on choose of b-lkp in frame fr-D-rvs-doc-0 do:
     1279     define buffer buf_doc for ub.c-rvs-doc.
     1280   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281   if lookup(self :type
     1282            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1283            ) = 0
