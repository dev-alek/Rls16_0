     1505   end.
     1506   run minbtn-set in this-procedure .
     1507   on choose of b-help in frame fr-D-rvs-doc-0
     1508   do:
     1509     apply "help":u to frame fr-D-rvs-doc-0 .
     1510   end.
     1511   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   procedure minbtn-set :
     1513       do
     1514           on error undo, return error return-value
     1515           :
     1516           define variable ii              as integer       no-undo .
     1517           define variable fh              as widget-handle no-undo .
     1518           define variable hh              as widget-handle no-undo .
     1519           define variable v-h             as handle        extent 4 no-undo .
     1520           define variable v-name-button   as character     no-undo .
     1521           define variable v-help-old-x    as decimal       no-undo .
     1522           define variable v-help-old-y    as decimal       no-undo .
     1523           define variable v-help-old-size as decimal       no-undo .
     1524           define variable v-frame-width   as decimal       no-undo .
     1525           define variable jj              as integer       no-undo .
     1526           do
     1527               on error undo, return error
     1528               :
     1529               assign
     1530                   v-frame-width = frame fr-D-rvs-doc-0:width - 0.3
     1531                   fh            = frame fr-D-rvs-doc-0:first-child
     1532                   hh            = fh:first-child
     1533                   ii            = 1
     1534                   .
     1535               do while valid-handle(hh):
     1536                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1537                   do:
     1538                       case lc(hh:name) :
     1539                           when "b-help" then
     1540                               do:
     1541                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1542                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1543                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1544                                   hh:TOOLTIP = "Помощь" .
     1545                                   v-help-old-x = hh:column .
     1546                                   v-help-old-y = hh:row    .
     1547                                   v-help-old-size = hh:width .
     1548                                   hh:width-chars = 2.5 .
     1549                               end.
     1550                           when "b-print" then
     1551                               do:
     1552                                   hh:load-image("cmp/b-print.bmp":u) .
     1553                                   hh:TOOLTIP = "Печать" .
     1554                                   v-h[ii] = hh:handle .
     1555                                   ii = ii + 1 .
     1556                                   hh:width-chars = 3 .
     1557                               end.
     1558                           when "b-history" or
     1559                           when "b-hist" then
     1560                               do:
     1561                                   hh:load-image("cmp/b-hist.bmp":u) .
     1562                                   hh:TOOLTIP = "История" .
     1563                                   v-h[ii] = hh:handle .
     1564                                   ii = ii + 1 .
     1565                                   hh:width-chars = 3 .
     1566                               end.
     1567                           when "b-sch" then
     1568                               do:
     1569                                   hh:load-image("cmp/b-sch.bmp":u) .
     1570                                   hh:TOOLTIP = "Установка Фильтра" .
     1571                                   v-h[ii] = hh:handle .
     1572                                   ii = ii + 1 .
     1573                                   hh:width-chars = 3 .
     1574                               end.
     1575                           when "b-hist-user" then
     1576                               do:
     1577                                   hh:load-image("cmp/b-hist.bmp":u) .
     1578                                   hh:TOOLTIP = "История пользователя" .
     1579                                   ii = ii + 1 .
     1580                               end.
     1581                       end case.
     1582                   end.
     1583                   hh = hh:next-sibling.
     1584               end.
     1585               b-help:column = v-frame-width - b-help:width-chars.
     1586               jj = 0.
     1587               repeat ii = 4 to 1 by -1 :
     1588                   if valid-handle (v-h[ii] ) then
     1589                   do:
     1590                       jj  = jj + 1 .
     1591                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1592                       v-h[ii]:row    = v-help-old-y .
     1593                   end.
     1594               end.
     1595           end.
     1596       end.
     1597   end procedure.
     1598   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1599   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1600   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1601   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1602   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1603   define variable v-diasize-current-frame-height as decimal   no-undo .
     1604   define variable v-diasize-change-size          as logical   no-undo .
     1605   define variable v-diasize-resize-button        as handle    no-undo .
     1606   define variable v-diasize-wndmax               as logical   no-undo .
     1607   define variable v-diasize-wndstore             as logical   no-undo .
     1608   define variable v-diasize-proc-name            as character no-undo .
     1609   define variable v-diasize-browse-handle        as handle    no-undo .
     1610   define variable v-diasize-browse-number        as integer   no-undo .
     1611   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1612   define temp-table temp-diasize-handle no-undo
     1613     field handle-value  as handle
     1614     field save-position as decimal
     1615     index xpk is primary unique handle-value
     1616     .
     1617   define temp-table temp-browse-handle no-undo
     1618     field browse-type   as character
     1619     field browse-number as integer
     1620     field browse-handle as handle
     1621     field original-size as decimal
     1622     index xpk is primary unique browse-type browse-number
     1623     index xie browse-type browse-handle
     1624   .
     1625   procedure diasize_change-height :
     1626     define input  parameter p-change-value  as decimal   no-undo .
     1627     define input  parameter p-move-resize   as logical   no-undo .
     1628     define variable v-field-group-handle    as handle    no-undo .
     1629     define variable v-object-handle         as handle    no-undo .
     1630     define variable v-frame-height          as decimal   no-undo .
     1631     define variable v-frame-virtual-height  as decimal   no-undo .
     1632     define variable v-browse-height         as decimal   no-undo .
     1633     define variable v-window-height         as decimal   no-undo .
     1634     define variable v-window-virtual-height as decimal   no-undo .
     1635     define variable v-change-sign           as integer   no-undo .
     1636     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1637     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1638     if p-change-value > 0
     1639     then do:
     1640       if frame fr-D-rvs-doc-0 :height + p-change-value
     1641           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1642       then do:
     1643         assign
     1644           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1645                           - (frame fr-D-rvs-doc-0 :height-chars)
     1646         .
     1647         if p-change-value <= 0
     1648         then do:
     1649           run diasize_position-resize-button in this-procedure .
     1650           return .
     1651         end.
     1652       end.
     1653     end.
     1654     if p-change-value < 0
     1655     then do:
     1656       if frame fr-D-rvs-doc-0 :height + p-change-value < v-diasize-orig-frame-height
     1657       then do:
     1658         assign
     1659           p-change-value = v-diasize-orig-frame-height
     1660                          - (frame fr-D-rvs-doc-0 :height-chars)
     1661         .
     1662         if p-change-value >= 0
     1663         then do:
     1664           run diasize_position-resize-button in this-procedure .
     1665           return .
     1666         end.
     1667       end.
     1668     end.
     1669     if p-change-value >= 0
     1670     then do:
     1671       assign
     1672         v-change-sign = 1
     1673       .
     1674     end.
     1675     else do:
     1676       assign
     1677         v-change-sign = -1
     1678       .
     1679     end.
     1680     assign
     1681       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1682     .
     1683     if p-change-value = 0
     1684     then do:
     1685       run diasize_position-resize-button in this-procedure .
     1686       return .
     1687     end.
     1688     move_block:
     1689     do
     1690     on error undo move_block, retry move_block
     1691     :
     1692       if retry
     1693       then do:
     1694         do
     1695         on error undo move_block, leave move_block
     1696         :
     1697           if p-change-value > 0
     1698           then do:
     1699             for each buf_temp-diasize-handle
     1700             on error undo, next
     1701             :
     1702               assign
     1703                 v-object-handle = buf_temp-diasize-handle.handle-value
     1704               .
     1705               if v-object-handle <> v-diasize-resize-button
     1706               then do:
     1707                 assign
     1708                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1709                 .
     1710               end.
     1711             end.
     1712             assign
     1713               v-diasize-browse-handle :height = v-browse-height
     1714             .
     1715             for each buf_temp-browse-handle
     1716               where buf_temp-browse-handle.browse-type = 'height':u
     1717             on error undo, next
     1718             :
     1719               assign
     1720                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1721               .
     1722             end.
     1723             assign
     1724               frame fr-D-rvs-doc-0 :height = v-frame-height
     1725             .
     1726             if frame fr-D-rvs-doc-0 :scrollable = true
     1727             then do:
     1728               assign
     1729                 frame fr-D-rvs-doc-0 :virtual-height = v-frame-virtual-height
     1730               .
     1731             end.
     1732             run diasize_position-resize-button in this-procedure .
     1733           end.
     1734           else do:
     1735             if frame fr-D-rvs-doc-0 :scrollable = true
     1736             then do:
     1737               assign
     1738                 frame fr-D-rvs-doc-0 :virtual-height = v-frame-virtual-height
     1739               .
     1740             end.
     1741             assign
     1742               frame fr-D-rvs-doc-0 :height = v-frame-height
     1743             .
     1744             assign
     1745               v-diasize-browse-handle :height = v-browse-height
     1746             .
     1747             for each buf_temp-browse-handle
     1748               where buf_temp-browse-handle.browse-type = 'height':u
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1753               .
     1754             end.
     1755             for each buf_temp-diasize-handle
     1756             on error undo, next
     1757             :
     1758               assign
     1759                 v-object-handle = buf_temp-diasize-handle.handle-value
     1760               .
     1761               if v-object-handle <> v-diasize-resize-button
     1762               then do:
     1763                 assign
     1764                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1765                 .
     1766               end.
     1767             end.
     1768             run diasize_position-resize-button in this-procedure .
     1769           end.
     1770           assign
     1771             v-diasize-change-size = false
     1772           .
     1773           leave move_block .
     1774         end.
     1775       end.
     1776       assign
     1777         v-diasize-need-full-display = true
     1778       .
     1779       if v-diasize-change-size = false
     1780       then do:
     1781         assign
     1782           v-diasize-change-size = true
     1783         .
     1784       end.
     1785       else do:
     1786         return .
     1787       end.
     1788       assign
     1789         v-frame-height = frame fr-D-rvs-doc-0 :height
     1790         v-frame-virtual-height = frame fr-D-rvs-doc-0 :virtual-height
     1791         v-browse-height = v-diasize-browse-handle :height
     1792       .
     1793       for each buf_temp-browse-handle
     1794         where buf_temp-browse-handle.browse-type = 'height':u
     1795       :
     1796         assign
     1797           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1798         .
     1799       end.
     1800       for each buf_temp-diasize-handle
     1801       :
     1802         delete buf_temp-diasize-handle .
     1803       end.
     1804       assign
     1805         v-field-group-handle = frame fr-D-rvs-doc-0 :first-child
     1806       .
     1807       do while valid-handle(v-field-group-handle)
     1808       :
     1809         assign
     1810           v-object-handle = v-field-group-handle :first-child
     1811         .
     1812         do while valid-handle(v-object-handle)
     1813         :
     1814           if  v-object-handle <> v-diasize-browse-handle :handle
     1815           and can-query(v-object-handle, "row")
     1816           and can-query(v-object-handle, "height")
     1817           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1818           then do:
     1819             find first buf_temp-browse-handle
     1820               where buf_temp-browse-handle.browse-type   = 'height':u
     1821                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1822               no-error .
     1823             if available buf_temp-browse-handle
     1824             then do:
     1825             end.
     1826             else do:
     1827               create buf_temp-diasize-handle .
     1828               assign
     1829                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1830                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1831               .
     1832             end.
     1833           end.
     1834           assign
     1835             v-object-handle = v-object-handle :next-sibling
     1836           .
     1837         end.
     1838         assign
     1839           v-field-group-handle = v-field-group-handle :next-sibling
     1840         .
     1841       end.
     1842       do with frame fr-D-rvs-doc-0
     1843       :
     1844         hide v-diasize-resize-button .
     1845         assign
     1846           v-diasize-resize-button :row    = 1
     1847           v-diasize-resize-button :column = 1
     1848         .
     1849       end.
     1850       if p-change-value > 0
     1851       then do:
     1852         if frame fr-D-rvs-doc-0 :scrollable = true
     1853         then do:
     1854           assign
     1855             frame fr-D-rvs-doc-0 :virtual-height = frame fr-D-rvs-doc-0 :virtual-height + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block .
     1861           end.
     1862         end.
     1863         assign
     1864           frame fr-D-rvs-doc-0 :height = frame fr-D-rvs-doc-0 :height + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block .
     1870         end.
     1871         assign
     1872           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1873           no-error .
     1874         if error-status :error
     1875         or error-status :get-message(1) <> ""
     1876         then do:
     1877           undo move_block, retry move_block .
     1878         end.
     1879         for each buf_temp-browse-handle
     1880           where buf_temp-browse-handle.browse-type = 'height':u
     1881         on error undo move_block, retry move_block
     1882         :
     1883           assign
     1884             buf_temp-browse-handle.browse-handle :height
     1885               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1886             no-error .
     1887           if error-status :error
     1888           or error-status :get-message(1) <> ""
     1889           then do:
     1890             undo move_block, retry move_block .
     1891           end.
     1892         end.
     1893         for each buf_temp-diasize-handle
     1894         on error undo move_block, retry move_block
     1895         :
     1896           assign
     1897             v-object-handle = buf_temp-diasize-handle.handle-value
     1898           .
     1899           if v-object-handle <> v-diasize-resize-button
     1900           then do:
     1901             assign
     1902               v-object-handle :row = v-object-handle :row + p-change-value
     1903               no-error .
     1904             if error-status :error
     1905             or error-status :get-message(1) <> ""
     1906             then do:
     1907               undo move_block, retry move_block .
     1908             end.
     1909           end.
     1910         end.
     1911       end.
     1912       else do:
     1913         for each buf_temp-diasize-handle
     1914         on error undo move_block, retry move_block
     1915         :
     1916           assign
     1917             v-object-handle = buf_temp-diasize-handle.handle-value
     1918           .
