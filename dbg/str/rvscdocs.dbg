      451   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      453   procedure fltopend_fltopend :
      454   define input parameter p-parent-handle as handle no-undo .
      455   define input parameter p-qh as handle no-undo .
      456   define input parameter p-flt-open-open-query  as character no-undo .
      457   define input parameter p-where-cond as character no-undo .
      458   define input parameter p-use-indFIRST-query-tail as character no-undo .
      459   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      460   define input parameter p-indexed-reposition as character no-undo .
      461     do
      462     on error undo, return error
      463     :
      464   define variable v-prepare-string as character no-undo .
      465   define variable glog as logical no-undo .
      466   assign
      467   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      468                      p-where-cond + chr(32)  +
      469                      p-use-indFIRST-query-tail + chr(32) +
      470                      p-use-ind-sort-clmn-by + chr(32) +
      471                      p-indexed-reposition
      472   .
      473   assign
      474   glog = p-qh:query-prepare(v-prepare-string) no-error .
      475   if not glog
      476   or error-status:error then do:
      477     message error-status:get-message(1) view-as alert-box .
      478     undo, return error .
      479   end.
      480   assign
      481   glog = p-qh:query-open no-error .
      482   if not glog
      483   or error-status:error then do:
      484     message error-status:get-message(1) view-as alert-box .
      485     undo, return error .
      486   end.
      487     end.
      488   end procedure.
      489   procedure fltopend_fltfindd :
      490   define input parameter p-parent-handle as handle no-undo .
      491   define input parameter p-qh as handle no-undo .
      492   define input parameter p-rowid as rowid no-undo .
      493   define input parameter p-next as logical no-undo .
      494   define input parameter p-lock as integer no-undo .
      495   define input parameter p-bh as handle no-undo .
      496   define input parameter p-where-cond as character no-undo .
      497   define input parameter p-use-index-phrase as character no-undo .
      498   define variable glog as logical no-undo .
      499   define variable v-qh as handle no-undo .
      500   define variable v-bh as handle no-undo .
      501   define variable v-recid as recid no-undo .
      502   define variable v-prepare-string as character no-undo .
      503   do
      504   on error undo, return error
      505   on stop undo, return error
      506   :
      507     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      508     create buffer v-bh for table p-bh buffer-name p-bh:name.
      509     create query v-qh.
      510     v-qh:set-buffers(v-bh).
      511     v-prepare-string = substitute("for each &1 &2 &3"
      512                                     ,v-bh:name
      513                                     ,p-where-cond
      514                                     ,p-use-index-phrase).
      515     glog = v-qh:query-prepare(v-prepare-string) no-error.
      516     if not glog then do:
      517       delete object v-qh.
      518       delete object v-bh.
      519       undo, return error .
      520     end.
      521     glog = v-qh:query-open no-error .
      522     if not glog then do:
      523       delete object v-qh.
      524       delete object v-bh.
      525       undo, return error .
      526     end.
      527     if p-next then do:
      528       v-qh:reposition-to-rowid(p-rowid) no-error .
      529       glog = v-qh:get-next( p-lock) no-error .
      530       glog = v-qh:get-next( p-lock) no-error .
      531       if not glog or v-qh:query-off-end = yes then do:
      532         glog = v-qh:get-first( p-lock) no-error .
      533       end.
      534     end.
      535     else do:
      536       glog = v-qh:get-first( p-lock) no-error .
      537     end.
      538     v-recid = v-bh:recid no-error .
      539     delete object v-qh.
      540     delete object v-bh.
      541     return string(v-recid) .
      542   end.
      543   end procedure.
      544   procedure fltopend_fltfindq :
      545   define input parameter p-parent-handle as handle no-undo .
      546   define input parameter p-qh as handle no-undo .
      547   define input parameter p-next as logical no-undo .
      548   define input parameter p-lock as integer no-undo .
      549   define input parameter p-flt-open-open-query  as character no-undo .
      550   define input parameter p-where-cond as character no-undo .
      551   define input parameter p-use-indFIRST-query-tail as character no-undo .
      552   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      553   define input parameter p-indexed-reposition as character no-undo .
      554   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      555   define variable glog as logical no-undo .
      556   define variable v-qh as handle no-undo .
      557   define variable v-bh as handle no-undo extent 18.
      558   define variable v-rowid as rowid no-undo extent 18.
      559   define variable v-ii as integer no-undo .
      560   define variable v-prepare-string as character no-undo .
      561   do
      562   on error undo, return error
      563   on stop undo, return error
      564   :
      565     create query v-qh.
      566     do v-ii = 1 to p-qh:num-buffers:
      567       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      568       assign
      569       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      570       no-error.
      571       v-qh:add-buffer(v-bh[v-ii]).
      572     end.
      573     assign
      574     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      575                       p-where-cond + chr(32)  +
      576                       p-use-indFIRST-query-tail + chr(32) +
      577                       p-use-ind-sort-clmn-by + chr(32) +
      578                       p-indexed-reposition
      579     .
      580     glog = v-qh:query-prepare( v-prepare-string) no-error .
      581     if not glog then do:
      582       delete object v-qh.
      583       do v-ii = 1 to p-qh:num-buffers:
      584         delete object v-bh[v-ii].
      585       end.
      586       undo, return error .
      587     end.
      588     glog = v-qh:query-open no-error .
      589     if not glog then do:
      590       delete object v-qh.
      591       do v-ii = 1 to p-qh:num-buffers:
      592         delete object v-bh[v-ii].
      593       end.
      594       undo, return error .
      595     end.
      596     if p-next then do:
      597       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      598       glog = v-qh:get-next( p-lock) no-error .
      599       glog = v-qh:get-next( p-lock) no-error .
      600       if not glog or v-qh:query-off-end = yes then do:
      601         glog = v-qh:get-first( p-lock) no-error .
      602       end.
      603     end.
      604     else do:
      605       glog = v-qh:get-first( p-lock) no-error .
      606     end.
      607     do v-ii = 1 to p-qh:num-buffers:
      608       assign
      609       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      610       no-error.
      611     end.
      612     delete object v-qh.
      613     do v-ii = 1 to p-qh:num-buffers:
      614       delete object v-bh[v-ii].
      615     end.
      616   end.
      617   end procedure.
      618   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   define   temp-table temp-changes no-undo
      620   field f_name as character
      621   field l_name as character
      622   field v_old as character
      623   field v_new as character
      624   field t_name as character
      625   field num_ as integer
      626   field uniq-key-rec as character
      627   field action as integer
      628   field fNotChange as logical
      629   index pi is unique primary
      630   num_
      631   t_name
      632   f_name
      633   index
      634   Chan
      635   fnotChange
      636   t_name
      637   f_name
      638   index imain uniq-key-rec
      639   .
      640   FUNCTION get-all-fields returns character (p-file-name as character ):
      641   define variable v-dop as character no-undo .
      642     find first _file no-lock where _file._file-name = p-file-name no-error .
      643     if not available _file then return "":U.
      644     for each _field no-lock where
      645              _field._file-recid = recid(_file) :
      646       assign
      647       v-dop = v-dop + _field._field-name + chr(44)
      648       .
      649     end.
      650     return trim(v-dop).
      651   END FUNCTION.
      652   PROCEDURE proc-full-temp-changes :
      653     define input  parameter p-act-create as logical   no-undo .
      654     define input  parameter p-act-delete as logical   no-undo .
      655     define input  parameter p-hst-handle as handle    no-undo .
      656     define input  parameter p-main-table as character no-undo .
      657     define input  parameter p-field-list as character no-undo .
      658     define input  parameter p-label-form as character no-undo .
      659     define variable h-new-buf         as handle    no-undo .
      660     define variable h-main-buf        as handle    no-undo .
      661     define variable h-for-comp        as handle    no-undo .
      662     define variable v-inform          as character no-undo .
      663     define variable v-ind             as integer   no-undo .
      664     define variable v-idx-field-qnty  as integer   no-undo .
      665     define variable v-num-entries     as integer   no-undo .
      666     define variable fh                as handle    no-undo .
      667     define variable fh-main           as handle    no-undo .
      668     define variable fh-old            as handle    no-undo .
      669     define variable fh-new            as handle    no-undo .
      670     define variable v-field-name      as character no-undo .
      671     define variable v-field-lvl       as character no-undo .
      672     define variable v-field-form      as character no-undo .
      673     define variable v-search-exp      as character no-undo .
      674     define variable v-srch-main       as character no-undo .
      675     define variable v-word-link       as character no-undo .
      676     define variable v-av-chip-num     as logical   no-undo .
      677     define variable v-main-pi-fld-lst as character no-undo .
      678     define variable v-main-fld-lst    as character no-undo .
      679     define variable v-delim-list      as character no-undo .
      680     define variable v-label           as character no-undo .
      681     define variable v-old-value       as character no-undo case-sensitive.
      682     define variable v-new-value       as character no-undo case-sensitive.
      683     define variable v-chg-fields as character no-undo.
      684     for each temp-changes:
      685       delete temp-changes.
      686     end.
      687     if not p-hst-handle:available then do:
      688       return .
      689     end.
      690     create buffer h-new-buf  for table p-hst-handle .
      691     create buffer h-main-buf for table p-main-table .
      692     assign
      693       v-inform = h-main-buf:index-information(1)
      694       v-ind    = 2
      695     .
      696     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      697     on error undo, return error
      698     :
      699       assign
      700         v-inform = h-main-buf:index-information( v-ind )
      701         v-ind    = v-ind + 1
      702       .
      703     end.
      704     if v-inform = ?
      705       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      706       or entry( 3, v-inform, ",":U ) <> "1":U
      707     then do:
      708       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      709     end.
      710     assign
      711       v-idx-field-qnty = num-entries( v-inform ) - 4
      712     .
      713     if v-idx-field-qnty < 2 then do:
      714       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      715     end.
      716     assign
      717       v-srch-main   = "where":U
      718       v-word-link   = "":U
      719       v-av-chip-num = false
      720       v-delim-list  = "":U
      721     .
      722     do v-ind = 1 to v-idx-field-qnty by 2
      723     on error undo, return error
      724     :
      725       assign
      726         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      727         fh                = p-hst-handle:buffer-field( v-field-name )
      728         fh-main           = h-main-buf:buffer-field( v-field-name )
      729         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      730         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      731       .
      732       if fh:data-type ="character":U then do:
      733         assign
      734           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      735         .
      736       end.
      737       else do:
      738         assign
      739           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      740         .
      741       end.
      742       if v-delim-list = "":U then do:
      743         assign
      744           v-delim-list = ",":U
      745         .
      746       end.
      747       if v-word-link = "":U then do:
      748         assign
      749           v-word-link = "and":U
      750         .
      751       end.
      752     end.
      753     assign
      754       v-delim-list  = "":U
      755     .
      756     do v-ind = 1 to h-main-buf:num-fields
      757     on error undo, return error
      758     :
      759       assign
      760         fh-main      = h-main-buf:buffer-field( v-ind )
      761         v-field-name = fh-main:name
      762       .
      763         assign
      764           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      765         .
      766         if v-delim-list = "":U then do:
      767           assign
      768             v-delim-list = ",":U
      769           .
      770         end.
      771     end.
      772     assign
      773       v-inform = p-hst-handle:index-information(1)
      774       v-ind    = 2
      775     .
      776     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      777     on error undo, return error
      778     :
      779       assign
      780         v-inform = p-hst-handle:index-information( v-ind )
      781         v-ind    = v-ind + 1
      782       .
      783     end.
      784     if v-inform = ?
      785       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      786       or entry( 3, v-inform, ",":U ) <> "1":U
      787     then do:
      788       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      789     end.
      790     assign
      791       v-idx-field-qnty = num-entries( v-inform ) - 4
      792     .
      793     if v-idx-field-qnty < 2 then do:
      794       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      795     end.
      796     assign
      797       v-search-exp  = "where":U
      798       v-word-link   = "":U
      799       v-av-chip-num = false
      800     .
      801     do v-ind = 1 to v-idx-field-qnty by 2
      802     on error undo, return error
      803     :
      804       assign
      805         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      806         fh           = p-hst-handle:buffer-field( v-field-name )
      807         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      808       .
      809       if v-field-name = "chip-num":U then do:
      810         assign
      811           v-search-exp  = substitute( "&1 >", v-search-exp )
      812           v-av-chip-num = true
      813         .
      814       end.
      815       else do:
      816         assign
      817           v-search-exp = substitute( "&1 =", v-search-exp )
      818         .
      819       end.
      820       if fh:data-type ="character":U then do:
      821         assign
      822           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      823         .
      824       end.
      825       else do:
      826         assign
      827           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      828         .
      829       end.
      830       if v-word-link = "":U then do:
      831         assign
      832           v-word-link = "and":U
      833         .
      834       end.
      835     end.
      836     if v-av-chip-num = false then do:
      837       message
      838         vss-workfile vss-revision vss-description skip
      839         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      840         "Использование данной процедуры невозможно!" skip
      841         view-as alert-box error .
      842       return error .
      843     end.
      844     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      845     if not h-new-buf:available then do:
      846       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      847       if not h-main-buf:available then do:
      848         assign
      849           h-for-comp = ?
      850         .
      851       end.
      852       else do:
      853         assign
      854           h-for-comp = h-main-buf
      855         .
      856       end.
      857     end.
      858     else do:
      859       assign
      860         h-for-comp = h-new-buf
      861       .
      862     end.
      863     assign
      864       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      865     .
      866     do v-ind = 1 to v-num-entries
      867     on error undo, return error return-value
      868     :
      869       assign
      870         v-field-name = entry( v-ind, v-main-fld-lst )
      871         fh-old       = p-hst-handle:buffer-field( v-field-name )
      872         v-old-value  = fh-old:buffer-value()
      873         v-label      = trim( fh-old:label )
      874       .
      875       if ( trim( p-field-list ) <> "":U
      876            and lookup( v-field-name, p-field-list ) > 0
      877          )
      878          or trim( p-field-list ) = "":U
      879       then do:
      880         if h-for-comp <> ? then do:
      881           assign
      882             fh-new      = h-for-comp:buffer-field( v-field-name )
      883             v-new-value = fh-new:buffer-value()
      884           .
      885         end.
      886         else do:
      887           assign
      888             v-new-value = "":U
      889           .
      890         end.
      891           if p-act-create = true then do:
      892             assign
      893               v-old-value = "":U
      894             .
      895           end.
      896           if p-act-delete = true then do:
      897             assign
      898               v-new-value = "":U
      899             .
      900           end.
      901         if v-old-value <> v-new-value
      902         then do:
      903           create temp-changes.
      904           assign
      905             temp-changes.t_name = p-main-table
      906             temp-changes.f_name = v-field-name
      907             temp-changes.l_name = replace( v-label, "&":U, "":U )
      908             temp-changes.v_old  = trim( v-old-value )
      909             temp-changes.v_new  = trim( v-new-value )
      910             temp-changes.num_   = 0
      911             temp-changes.fNotChange = v-old-value eq v-new-value
      912           .
      913         end.
      914       end.
      915     end.
      916     assign
      917       v-num-entries = num-entries( p-label-form, chr(8) )
      918     .
      919     do v-ind = 1 to v-num-entries
      920     on error undo, return error return-value
      921     :
      922       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      923         assign
      924           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      925           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      926           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      927         .
      928         find first temp-changes
      929           where temp-changes.f_name = v-field-name
      930           no-error .
      931         if available temp-changes then do:
      932           if trim( v-field-lvl ) <> "":U then do:
      933             assign
      934               temp-changes.l_name = v-field-lvl
      935             .
      936           end.
      937           if trim( v-field-form ) <> "":U then do:
      938             assign
      939               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      940             .
      941             if h-for-comp <> ? then do:
      942               assign
      943                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      944               .
      945             end.
      946           end.
      947         end.
      948       end.
      949       else do:
      950         message
      951           vss-workfile vss-revision vss-description skip
      952           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      953           substitute( "список для поля '&1': '&2'"
      954                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      955                       ,entry( v-ind, p-label-form, chr(8) )
      956                     ) skip
      957           substitute( "полный список: &2", p-label-form ) skip
      958           view-as alert-box error .
      959       end.
      960     end.
      961     delete object h-new-buf .
      962     delete object h-main-buf .
      963   END PROCEDURE.
      964   define buffer buf_changes  for temp-changes.
      965   define buffer buf_c-rvs-doc  for ub.c-rvs-doc.
      966   define buffer buf_sch_hist for ub.c-rvs-doc.
      967   define buffer buf_source   for ub.c-rvs-doc.
      968   define variable filter-point     as character no-undo.
      969   define variable filter-point0    as character no-undo.
      970   define variable sort-change-name as character no-undo.
      971   define variable sort-column-name as character no-undo.
      972   define variable sch-field        as character no-undo.
      973   define variable FoundRec         as recid     no-undo.
      974   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      975   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      976   define variable doc-rec          as recid     no-undo.
      977   define variable p-host-code      as integer   no-undo.
      978   assign
      979     filter-point  = vss-description
      980     filter-point0 = vss-description
      981   .
      982   function mark-string returns character ( buffer loc-buf for ub.c-rvs-doc ) :
      983     define variable v_mark-sign as character no-undo.
      984     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      985     return ( v_mark-sign ).
      986   end function.
      987   function ShowAction returns character ( input i-act as integer ) :
      988     define variable v_act as character no-undo.
      989     run get-action-name in this-procedure ( input i-act, output v_act ).
      990     return ( v_act ).
      991   end function.
      992   function obj-name returns character ( input i-type as character, input i-code as integer ) :
      993     define variable v_obj-name as character no-undo.
      994     run get-obj-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      995     return ( v_obj-name ).
      996   end function.
      997   define button b-help   label "Помо&щь"   size-chars 10.00 by 1.00 default.
      998   define button b-mark   label "&*"        size-chars  3.00 by 1.00 default.
      999   define button   Btn_Exit    label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
     1000   define button b-lkp   label "&Просмотр" size-chars 10.00 by 1.00 default.
     1001   define button b-sch label "&Фильтр"   size-chars 10.00 by 1.00 default.
     1002   define button b-sel label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
     1003   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
     1004   define variable sch-code as character no-undo view-as fill-in size-chars 17.50 by 1.00 format "x(16)":U.
     1005   define variable sch-date as date      no-undo view-as fill-in size-chars 11.50 by 1.00 format "99/99/9999":U.
     1006   define variable sch-fact as date      no-undo view-as fill-in size-chars 11.50 by 1.00 format "99/99/9999":U.
     1007   define variable sch-num  as integer   no-undo view-as fill-in size-chars  5.00 by 1.00 format ">>>":U.
     1008   define query br-rvs-docs for buf_c-rvs-doc scrolling.
     1009   define query br-changes for buf_changes scrolling.
     1010   define browse br-rvs-docs query br-rvs-docs display
     1011     mark-string(buffer buf_c-rvs-doc )  column-label '*'  format 'x(1)':U
     1012     substring(buf_c-rvs-doc.rvs-type,1,9)  column-label ' Tип '  format 'x(9)':U
     1013     buf_c-rvs-doc.is-full  column-label ' '  format 'п/ ':U
     1014     buf_c-rvs-doc.status_  column-label 'Стат'  format 'x(5)':U
     1015     buf_c-rvs-doc.rvs-code  column-label 'Документ'  format 'x(12)':U
     1016     buf_c-rvs-doc.doc-date  column-label 'Дата док'  format '99/99/99':U
     1017     buf_c-rvs-doc.fact-date  column-label 'Дата факт'  format '99/99/99':U
     1018     string(buf_c-rvs-doc.fact-time,'HH:MM:SS':U)  column-label 'Время факт'  format 'x(8)':U
     1019     buf_c-rvs-doc.out-code  column-label 'Документ'  format 'x(14)':U
