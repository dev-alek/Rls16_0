     2964      run sort-brbr-rvs-docs
     2965        (input (if available buf_c-rvs-doc
     2966                then recid(buf_c-rvs-doc)
     2967                else ?
     2968               )
     2969        ).
     2970      assign re-querybr-rvs-docs = no.
     2971   end.
     2972   end.
