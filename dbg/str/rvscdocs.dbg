     1929           end.
     1930         end.
     1931         assign
     1932           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1933           no-error .
     1934         if error-status :error
     1935         or error-status :get-message(1) <> ""
     1936         then do:
     1937           undo move_block, retry move_block .
     1938         end.
     1939         for each buf_temp-browse-handle
     1940           where buf_temp-browse-handle.browse-type = 'height':u
     1941         on error undo move_block, retry move_block
     1942         :
     1943           assign
     1944             buf_temp-browse-handle.browse-handle :height
     1945               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1946             no-error .
