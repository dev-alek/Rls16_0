     3914     run fltfield-add in this-procedure ( input 'meas-mh-qnty',           input 'Измеренный оборот',                       input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3915     run fltfield-add in this-procedure ( input 'state-mh-qnty',          input 'Факт оборот',                             input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3916     run fltfield-add in this-procedure ( input 'brutto-tc-qnty',         input 'Измер. брутто(tc)',                       input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3917     run fltfield-add in this-procedure ( input 'state-brutto-tc-qnty',   input 'Факт брутто(tc)',                         input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3918     run fltfield-add in this-procedure ( input 'measure-tc-qnty',        input 'Измер. остаток(tc)',                      input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3919     run fltfield-add in this-procedure ( input 'state-measure-tc-qnty',  input 'Факт остаток(tc)',                        input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3920     run fltfield-add in this-procedure ( input 'corr-doc-code',          input 'Номер',                                   input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3921     run fltfield-add in this-procedure ( input 'corr-date',              input 'Дата последней коррекции',                input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3922     run fltfield-add in this-procedure ( input 'corr-shift-date',        input 'Дата смены удаления',                     input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3923     run fltfield-add in this-procedure ( input 'corr-shift-num',         input 'Порядок смены удаления',                  input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3924     run fltfield-add in this-procedure ( input 'corr-shift-name',        input 'Номер смены удаления',                    input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3925     run fltfield-add in this-procedure ( input 'corr-user-name',         input 'Изменил',                                 input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3926     run fltfield-add in this-procedure ( input 'is-corr',                input 'Документ корректировался в статусе факт', input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3927     run fltfield-add in this-procedure ( input 'is-del',                 input 'Документ удаляется в статусе факт',       input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3928     run fltfield-add in this-procedure ( input 'user-db-num',            input 'Номер БД',                                input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3929     run fltfield-add in this-procedure ( input 'user-name',              input 'Имя',                                     input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3930     run fltfield-add in this-procedure ( input 'sys-date',               input 'Дата',                                    input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3931     run fltfield-add in this-procedure ( input 'sys-time',               input 'Время',                                   input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3932     run fltfield-add in this-procedure ( input 'sys-time-int',           input 'Время в секундах',                        input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3933     run fltfield-add in this-procedure ( input 'chip-num',               input 'Щепка',                                   input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3934     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     3935        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     3936        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     3937       message "Неверная настройка на фильтры!" view-as alert-box error.
     3938       return no-apply.
     3939     end.
     3940     Filter-Block:
     3941     do on error   undo Filter-Block, leave Filter-Block
     3942        on end-key undo Filter-Block, leave Filter-Block :
     3943       run gbl/filter.w ( input parparentproc,
     3944                      input filter-point,
     3945                      input tbl,
     3946                      input join-tbl,
     3947                      input fld,
     3948                      input lab,
     3949                      input spr,
     3950                      input dim            ).
     3951       if return-value = 'undo':U then do:
     3952         apply "ENTRY":U to browse br-rvs-docs.
     3953         return no-apply.
     3954       end.
     3955       assign mark-num = 0
     3956              sch-num  = 0.
     3957       hide   mark-num in frame fr-D-rvs-doc-0.
     3958       hide   sch-num  in frame fr-D-rvs-doc-0.
     3959       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3960       assign b-sch :tooltip in frame fr-D-rvs-doc-0 = "Установить/снять фильтр".
     3961     end.
     3962   end procedure.
     3963   procedure proc-view-changes :
     3964     define buffer new_hist for ub.c-rvs-doc.
     3965     define buffer buf_srch for ub.rvs-doc.
     3966     define variable v-chg-fields as character no-undo.
     3967     define variable v-old-fields as character no-undo.
     3968     define variable v-new-fields as character no-undo.
     3969     define variable jj           as integer   no-undo.
     3970     for each temp-changes :
     3971       delete temp-changes.
     3972     end.
     3973     if not available buf_c-rvs-doc then do:
     3974       open query br-changes for each buf_changes .
     3975       return.
     3976     end.
     3977     run proc-full-temp-changes in this-procedure
     3978       ( input (buf_c-rvs-doc.action = 1 )
     3979        ,input (buf_c-rvs-doc.action = 99 )
     3980        ,input (buffer buf_c-rvs-doc:handle)
     3981        ,input 'c-rvs-doc':U
     3982        ,input "~
     3983   rvs-code,obj-type,obj-code,status_,rvs-type,out-code,fact-order,wrkr,agnt,boss,shift-num,~
     3984   shift-name,shift-date,fact-date,fact-time,creid,doc-date,host-code,PS,brutto-qnty,state-brutto-qnty,measure-qnty,state-measure-qnty,level-total,level-water,~
     3985   level-petrol,state-level-total,state-level-water,state-level-petrol,system-qnty,system-cli-qnty,brutto-cli-qnty,add-qnty,system-cli-avrg-qnty,~
     3986   state-brutto-cli-qnty,measure-cli-qnty,meas-am-qnty,state-am-qnty,meas-cf-qnty,state-cf-qnty,state-measure-cli-qnty,is-full,state-add-qnty,~
     3987   meas-mh-qnty,state-mh-qnty,brutto-tc-qnty,state-brutto-tc-qnty,measure-tc-qnty,state-measure-tc-qnty,corr-doc-code,corr-date,corr-shift-date,~
     3988   corr-shift-num,corr-shift-name,corr-user-name,is-corr,is-del,user-db-num,user-name,sys-date,sys-time~
     3989   ":U
     3990        ,input "~
     3991   ":U
     3992       ) no-error.
     3993     open query br-changes for each buf_changes .
     3994   end procedure.
     3995   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3996   procedure set-filter-name :
     3997   define input parameter p-filter-name as character no-undo .
     3998     do with frame fr-D-rvs-doc-0:
     3999       if p-filter-name > "" then do:
     4000         assign
     4001           frame fr-D-rvs-doc-0:title
     4002             = frame fr-D-rvs-doc-0:title + "   ФИЛЬТР: " + p-filter-name.
     4003         .
     4004         assign
     4005           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     4006         .
     4007       end.
     4008       else do:
     4009         assign
     4010           b-sch :tooltip = ""
     4011         .
     4012       end.
     4013     end.
     4014   end procedure.
     4015   procedure get-mark-string :
     4016     define        parameter buffer loc-buf for ub.c-rvs-doc.
     4017     define output parameter        p-sign  as  character no-undo.
     4018     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     4019   end procedure.
     4020   procedure get-action-name :
     4021     define  input parameter p-code as integer   no-undo.
     4022     define output parameter p-name as character no-undo.
     4023     define variable v_code  as character no-undo.
     4024     define variable j_entry as integer   no-undo.
     4025     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     4026     assign v_code  = Int2Char( p-code ).
     4027     assign j_entry = lookup(   v_code, p-act-codes ).
     4028     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     4029   end procedure.
     4030   procedure proc-find-code :
     4031     define input parameter p-next as logical   no-undo.
     4032     define input parameter p-code as character no-undo.
     4033     assign p-code = replace( p-code, chr(34), chr(34) + chr(34) )
     4034            p-code = replace( p-code, chr(39), chr(39) + chr(39) )
     4035            p-code = chr(34) + p-code + chr(34).
     4036     run OpenBr in this-procedure ( input no,
     4037                                    input p-next,
     4038                                    input substitute( " and buf_c-rvs-doc.rvs-code begins &1 ", p-code ) ).
     4039     if doc-rec <> ? then do:
     4040       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     4041       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     4042       assign  sch-num = sch-num + 1.
     4043       display sch-num with frame fr-D-rvs-doc-0.
     4044     end.
     4045     else do:
     4046       assign  sch-num = 0.
     4047       hide    sch-num in frame fr-D-rvs-doc-0.
     4048     end.
     4049     apply "ENTRY":U to sch-code in frame fr-D-rvs-doc-0.
     4050   end procedure.
     4051   procedure proc-find-date :
     4052     define input parameter p-next as logical no-undo.
     4053     define input parameter p-date as date    no-undo.
     4054     define variable v_date as character no-undo.
     4055     define variable v_dlmt as character no-undo.
     4056     assign v_dlmt = substring( string( p-date ), 3, 1 ).
     4057     assign v_date = string( day( p-date ), "99":U   ) + v_dlmt
     4058                     + string( month( p-date ), "99":U   ) + v_dlmt
     4059                     + string( year( p-date ), "9999":U ).
     4060     run OpenBr in this-procedure
     4061       ( input no
     4062        ,input p-next
     4063        ,input substitute( " and buf_c-rvs-doc.doc-date = &1 ", v_date )
     4064       ).
     4065     if doc-rec <> ? and doc-rec <> 0 then do:
     4066       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     4067       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     4068       assign  sch-num = sch-num + 1.
     4069       display sch-num with frame fr-D-rvs-doc-0.
     4070     end.
     4071     else do:
     4072       assign  sch-num = 0.
     4073       hide    sch-num   in frame fr-D-rvs-doc-0.
     4074     end.
     4075     apply "ENTRY":U to sch-date in frame fr-D-rvs-doc-0.
     4076   end procedure.
     4077   procedure proc-find-fact :
     4078     define input parameter p-next as logical no-undo.
     4079     define input parameter p-date as date    no-undo.
     4080     define variable v_date as character no-undo.
     4081     define variable v_dlmt as character no-undo.
     4082     assign v_dlmt = substring( string( p-date ), 3, 1 ).
     4083     assign v_date = string( day( p-date ), "99":U   ) + v_dlmt
     4084                     + string( month( p-date ), "99":U   ) + v_dlmt
     4085                     + string( year( p-date ), "9999":U ).
     4086     run OpenBr in this-procedure
     4087       ( input no
     4088        ,input p-next
     4089        ,input substitute( " and buf_c-rvs-doc.fact-date = &1 ", v_date )
     4090       ).
     4091     if doc-rec <> ? and doc-rec <> 0 then do:
     4092       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     4093       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     4094       assign  sch-num = sch-num + 1.
     4095       display sch-num with frame fr-D-rvs-doc-0.
     4096     end.
     4097     else do:
     4098       assign  sch-num = 0.
     4099       hide    sch-num   in frame fr-D-rvs-doc-0.
     4100     end.
     4101     apply "ENTRY":U to sch-fact in frame fr-D-rvs-doc-0.
     4102   end procedure.
     4103   procedure get-obj-name :
     4104     define  input parameter p-type as character no-undo.
     4105     define  input parameter p-code as integer   no-undo.
     4106     define output parameter p-name as character no-undo.
     4107     assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     4108   end procedure.
