     1312               'Просмотр невозможен!'
     1313       view-as alert-box.
     1314       return no-apply.
     1315     end.
     1316     run str/rvscdoca.w ( input parparentproc, input 'ПРОСМОТР':U, input-output doc-rec ).
     1317     reposition br-rvs-docs to recid doc-rec no-error.
     1318     if error-status :error then do: reposition br-rvs-docs to row 1 no-error. end.
     1319     apply "ENTRY":U         to br-rvs-docs in frame fr-D-rvs-doc-0.
     1320     apply "VALUE-CHANGED":U to br-rvs-docs in frame fr-D-rvs-doc-0.
     1321   end.
