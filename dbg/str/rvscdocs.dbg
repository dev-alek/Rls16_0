     1300       message "Неправильно выбрана сверка." view-as alert-box error.
     1301       return no-apply.
     1302     end.
     1303     else do:
     1304       assign doc-rec = recid( buf_c-rvs-doc ).
     1305     end.
     1306     find first buf_doc no-lock where
     1307                buf_doc.rvs-code  = buf_c-rvs-doc.rvs-code  and
     1308                buf_doc.chip-num <> buf_c-rvs-doc.chip-num  and
     1309                recid( buf_doc ) <> recid( buf_c-rvs-doc )  no-error.
     1310     if not available buf_doc then do:
