     1967           or error-status :get-message(1) <> ""
     1968           then do:
     1969             undo move_block, retry move_block .
     1970           end.
     1971         end.
     1972       end.
     1973       if p-move-resize = true
     1974       then do:
     1975         run diasize_position-resize-button in this-procedure .
     1976       end.
     1977       if v-diasize-wndstore = true
     1978       then do:
     1979         if connected("ub") = true
     1980         then do:
     1981           define variable v-cntxt-db-num        as integer   no-undo .
     1982           define variable v-cntxt-userid        as character no-undo .
     1983           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1984                                             , OUTPUT v-cntxt-userid
     1985                                             ) .
     1986           run gbl/wndsizew.p
     1987             (input  v-cntxt-db-num
     1988             ,input  v-cntxt-userid
     1989             ,input  v-diasize-proc-name
     1990             ,input  'height':u
     1991             ,input  string(frame fr-D-rvs-doc-0 :height - v-diasize-orig-frame-height)
     1992             ) .
     1993         end.
     1994       end.
     1995     end.
     1996     assign
     1997       v-diasize-change-size = false
     1998     .
     1999   end procedure.
     2000   procedure diasize_set-height :
     2001     define input  parameter p-new-height  as decimal   no-undo .
     2002     define input  parameter p-move-resize as logical   no-undo .
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       run diasize_change-height in this-procedure
     2007         (input  (p-new-height - frame fr-D-rvs-doc-0 :height)
     2008         ,input  p-move-resize
     2009         ) .
     2010     end.
     2011   end procedure.
     2012   procedure diasize_change-width :
     2013     define input  parameter p-change-value as decimal   no-undo .
     2014     define input  parameter p-move-resize  as logical   no-undo .
     2015     define variable v-field-group-handle   as handle    no-undo .
     2016     define variable v-object-handle        as handle    no-undo .
     2017     define variable v-frame-width          as decimal   no-undo .
     2018     define variable v-frame-virtual-width  as decimal   no-undo .
     2019     define variable v-browse-width         as decimal   no-undo .
     2020     define variable v-window-width         as decimal   no-undo .
     2021     define variable v-window-virtual-width as decimal   no-undo .
     2022     define variable v-change-sign          as integer   no-undo .
     2023     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2024     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2025     if p-change-value > 0
     2026     then do:
     2027       if frame fr-D-rvs-doc-0 :width + p-change-value >
     2028           session :width-chars
     2029       then do:
     2030         assign
     2031           p-change-value = session :width-chars - frame fr-D-rvs-doc-0 :width
     2032         .
     2033         if p-change-value <= 0
     2034         then do:
     2035           run diasize_position-resize-button in this-procedure .
     2036           return .
     2037         end.
     2038       end.
     2039     end.
     2040     if p-change-value < 0
     2041     then do:
     2042       if frame fr-D-rvs-doc-0 :width + p-change-value < v-diasize-orig-frame-width
     2043       then do:
     2044         assign
     2045           p-change-value = v-diasize-orig-frame-width
     2046                          - frame fr-D-rvs-doc-0 :width
     2047         .
     2048         if p-change-value >= 0
     2049         then do:
     2050           run diasize_position-resize-button in this-procedure .
     2051           return .
     2052         end.
     2053       end.
     2054     end.
     2055     if p-change-value >= 0
     2056     then do:
     2057       assign
     2058         v-change-sign = 1
     2059       .
     2060     end.
     2061     else do:
     2062       assign
     2063         v-change-sign = -1
     2064       .
     2065     end.
     2066     assign
     2067       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2068     .
     2069     if p-change-value = 0
     2070     then do:
     2071       run diasize_position-resize-button in this-procedure .
     2072       return .
     2073     end.
     2074     move_block:
     2075     do
     2076     on error undo move_block, leave move_block
     2077     :
     2078       if retry
     2079       then do:
     2080         do
     2081         on error undo move_block, leave move_block
     2082         :
     2083           if p-change-value > 0
     2084           then do:
     2085             for each buf_temp-diasize-handle
     2086             on error undo, next
     2087             :
     2088               assign
     2089                 v-object-handle = buf_temp-diasize-handle.handle-value
     2090               .
     2091               if v-object-handle <> v-diasize-resize-button
     2092               then do:
     2093                 assign
     2094                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2095                 .
     2096               end.
     2097             end.
     2098             assign
     2099               v-diasize-browse-handle :width = v-browse-width
     2100             .
     2101             for each buf_temp-browse-handle
     2102               where buf_temp-browse-handle.browse-type = 'width':u
     2103             on error undo, next
     2104             :
     2105               assign
     2106                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2107               .
     2108             end.
     2109             assign
     2110               frame fr-D-rvs-doc-0 :width = v-frame-width
     2111             .
     2112             if frame fr-D-rvs-doc-0 :scrollable = true
     2113             then do:
     2114               assign
     2115                 frame fr-D-rvs-doc-0 :virtual-width = v-frame-virtual-width
     2116               .
     2117             end.
     2118             run diasize_position-resize-button in this-procedure .
     2119           end.
     2120           else do:
     2121             if frame fr-D-rvs-doc-0 :scrollable = true
     2122             then do:
     2123               assign
     2124                 frame fr-D-rvs-doc-0 :virtual-width = v-frame-virtual-width
     2125               .
     2126             end.
     2127             assign
     2128               frame fr-D-rvs-doc-0 :width = v-frame-width
     2129             .
     2130             for each buf_temp-browse-handle
     2131               where buf_temp-browse-handle.browse-type = 'width':u
     2132             on error undo, next
     2133             :
     2134               assign
     2135                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2136               .
     2137             end.
     2138             assign
     2139               v-diasize-browse-handle :width = v-browse-width
     2140             .
     2141             for each buf_temp-diasize-handle
     2142             on error undo, next
     2143             :
     2144               assign
     2145                 v-object-handle = buf_temp-diasize-handle.handle-value
     2146               .
     2147               if v-object-handle <> v-diasize-resize-button
     2148               then do:
     2149                 assign
     2150                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2151                 .
     2152               end.
     2153             end.
     2154             run diasize_position-resize-button in this-procedure .
     2155           end.
     2156           assign
     2157             v-diasize-change-size = false
     2158           .
     2159           leave move_block .
     2160         end.
     2161       end.
     2162       assign
     2163         v-diasize-need-full-display = true
     2164       .
     2165       if v-diasize-change-size = false
     2166       then do:
     2167         assign
     2168           v-diasize-change-size = true
     2169         .
     2170       end.
     2171       else do:
     2172         return .
     2173       end.
     2174       assign
     2175         v-frame-width = frame fr-D-rvs-doc-0 :width
     2176         v-frame-virtual-width = frame fr-D-rvs-doc-0 :virtual-width
     2177         v-browse-width = v-diasize-browse-handle :width
     2178       .
     2179       for each buf_temp-browse-handle
     2180         where buf_temp-browse-handle.browse-type = 'width':u
     2181       :
     2182         assign
     2183           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2184         .
     2185       end.
     2186       for each buf_temp-diasize-handle
     2187       :
     2188         delete buf_temp-diasize-handle .
     2189       end.
     2190       assign
     2191         v-field-group-handle = frame fr-D-rvs-doc-0 :first-child
     2192       .
     2193       do while valid-handle(v-field-group-handle)
     2194       :
     2195         assign
     2196           v-object-handle = v-field-group-handle :first-child
     2197         .
     2198         do while valid-handle(v-object-handle)
     2199         :
     2200           if  v-object-handle <> v-diasize-browse-handle :handle
     2201           and v-object-handle <> v-diasize-resize-button
     2202           and can-query(v-object-handle, "row")
     2203           and can-query(v-object-handle, "height")
     2204           and ( v-object-handle :col + v-object-handle :width
     2205                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2206               )
     2207           then do:
     2208             find first buf_temp-browse-handle
     2209               where buf_temp-browse-handle.browse-type   = 'width':u
     2210                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2211               no-error .
     2212             if available buf_temp-browse-handle
     2213             then do:
     2214             end.
     2215             else do:
     2216               create buf_temp-diasize-handle .
     2217               assign
     2218                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2219                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2220               .
     2221             end.
     2222           end.
     2223           assign
     2224             v-object-handle = v-object-handle :next-sibling
     2225           .
     2226         end.
     2227         assign
     2228           v-field-group-handle = v-field-group-handle :next-sibling
     2229         .
     2230       end.
     2231       do with frame fr-D-rvs-doc-0
     2232       :
     2233         hide v-diasize-resize-button .
     2234         v-diasize-resize-button :row = 1.
     2235         v-diasize-resize-button :column = 1.
     2236       end.
     2237       if p-change-value > 0
     2238       then do:
     2239         if frame fr-D-rvs-doc-0 :scrollable = true
     2240         then do:
     2241           assign
     2242             frame fr-D-rvs-doc-0 :virtual-width = frame fr-D-rvs-doc-0 :virtual-width + p-change-value
     2243             no-error .
     2244           if error-status :error
     2245           or error-status :get-message(1) <> ""
     2246           then do:
     2247             undo move_block, retry move_block.
     2248           end.
     2249         end.
     2250         assign
     2251           frame fr-D-rvs-doc-0 :width = v-frame-width + p-change-value
     2252           no-error .
     2253         if error-status :error
     2254         or error-status :get-message(1) <> ""
     2255         then do:
     2256           undo move_block, retry move_block.
     2257         end.
     2258         assign
     2259           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2260         no-error .
     2261         if error-status :error
     2262         or error-status :get-message(1) <> ""
     2263         then do:
     2264           undo move_block, retry move_block.
     2265         end.
     2266         for each buf_temp-browse-handle
     2267           where buf_temp-browse-handle.browse-type = 'width':u
     2268         on error undo move_block, retry move_block
     2269         :
     2270           assign
     2271             buf_temp-browse-handle.browse-handle :width
     2272               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2273             no-error .
     2274           if error-status :error
     2275           or error-status :get-message(1) <> ""
     2276           then do:
     2277             undo move_block, retry move_block .
     2278           end.
     2279         end.
     2280         for each buf_temp-diasize-handle
     2281         on error undo move_block, retry move_block
     2282         :
     2283           assign
     2284             v-object-handle = buf_temp-diasize-handle.handle-value
     2285           .
     2286           if v-object-handle <> v-diasize-resize-button
     2287           then do:
     2288             assign
     2289               v-object-handle :col = v-object-handle :col + p-change-value
     2290               no-error .
     2291             if error-status :error
     2292             or error-status :get-message(1) <> ""
     2293             then do:
     2294               undo move_block, retry move_block .
     2295             end.
     2296           end.
     2297         end.
     2298       end.
     2299       else do:
     2300         for each buf_temp-diasize-handle
     2301         on error undo move_block, retry move_block
     2302         :
     2303           assign
     2304             v-object-handle = buf_temp-diasize-handle.handle-value
     2305           .
     2306           if v-object-handle <> v-diasize-resize-button
     2307           then do:
     2308             assign
     2309               v-object-handle :col = v-object-handle :col + p-change-value
     2310               no-error .
     2311             if error-status :error
     2312             or error-status :get-message(1) <> ""
     2313             then do:
     2314               undo move_block, retry move_block .
     2315             end.
     2316           end.
     2317         end.
     2318         for each buf_temp-browse-handle
     2319           where buf_temp-browse-handle.browse-type = 'width':u
     2320         on error undo move_block, retry move_block
     2321         :
     2322           assign
     2323             buf_temp-browse-handle.browse-handle :width
     2324               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2325             no-error .
     2326           if error-status :error
     2327           or error-status :get-message(1) <> ""
     2328           then do:
     2329             undo move_block, retry move_block .
     2330           end.
     2331         end.
     2332         assign
     2333           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2334           no-error .
     2335         if error-status :error
     2336         or error-status :get-message(1) <> ""
     2337         then do:
     2338           undo move_block, retry move_block.
     2339         end.
     2340         assign
     2341           frame fr-D-rvs-doc-0 :width = frame fr-D-rvs-doc-0 :width + p-change-value
     2342         no-error .
     2343         if error-status :error
     2344         or error-status :get-message(1) <> ""
     2345         then do:
     2346           undo move_block, retry move_block.
     2347         end.
     2348         if frame fr-D-rvs-doc-0 :scrollable = true
     2349         then do:
     2350           assign
     2351             frame fr-D-rvs-doc-0 :virtual-width = frame fr-D-rvs-doc-0 :virtual-width + p-change-value
     2352           no-error .
     2353           if error-status :error
     2354           or error-status :get-message(1) <> ""
     2355           then do:
     2356             undo move_block, retry move_block.
     2357           end.
     2358         end.
     2359       end.
     2360       if p-move-resize
     2361       then do:
     2362         run diasize_position-resize-button in this-procedure .
     2363       end.
     2364       if v-diasize-wndstore = true
     2365       then do:
     2366         if connected("ub") = true
     2367         then do:
     2368           define variable v-cntxt-db-num        as integer   no-undo .
     2369           define variable v-cntxt-userid        as character no-undo .
     2370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2371                                             , OUTPUT v-cntxt-userid
     2372                                             ) .
     2373           run gbl/wndsizew.p
     2374             (input  v-cntxt-db-num
     2375             ,input  v-cntxt-userid
     2376             ,input  v-diasize-proc-name
     2377             ,input  'width':u
     2378             ,input  string(frame fr-D-rvs-doc-0 :width - v-diasize-orig-frame-width)
     2379             ) .
     2380         end.
     2381       end.
     2382     end.
     2383     assign
     2384       v-diasize-change-size = false
     2385     .
     2386   end procedure.
     2387   procedure diasize_set-width :
     2388     define input  parameter p-new-width  as decimal   no-undo .
     2389     define input  parameter p-move-resize as logical   no-undo .
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       run diasize_change-width in this-procedure
     2394         (input  (p-new-width - frame fr-D-rvs-doc-0 :width)
     2395         ,input  p-move-resize
     2396         ) .
     2397     end.
     2398   end procedure.
     2399   procedure diasize_position-resize-button :
     2400     do with frame fr-D-rvs-doc-0
     2401     :
     2402       hide v-diasize-resize-button .
     2403       assign
     2404         v-diasize-resize-button :row = frame fr-D-rvs-doc-0 :height - v-diasize-resize-button :height
     2405                     - 1
     2406                     - (frame fr-D-rvs-doc-0 :border-bottom-pixels / session :pixels-per-row)
     2407         v-diasize-resize-button :col = frame fr-D-rvs-doc-0 :width - v-diasize-resize-button :width
     2408                     - 1
     2409                     - (frame fr-D-rvs-doc-0 :border-right-pixels / session :pixels-per-column)
     2410       .
     2411       view v-diasize-resize-button .
     2412     end.
     2413   end procedure.
     2414   on alt-right anywhere
     2415   do:
     2416     run diasize_change-width in this-procedure
     2417       (input 1
     2418       ,input true
     2419       ) .
     2420     return no-apply .
     2421   end.
     2422   on alt-left anywhere
     2423   do:
     2424     run diasize_change-width in this-procedure
     2425       (input -1
     2426       ,input true
     2427       ) .
     2428     return no-apply .
     2429   end.
     2430   on alt-down anywhere
     2431   do:
     2432     run diasize_change-height in this-procedure
     2433       (input 1
     2434       ,input true
     2435       ) .
     2436     return no-apply .
     2437   end.
     2438   on alt-up anywhere
     2439   do:
     2440     run diasize_change-height in this-procedure
     2441       (input -1
     2442       ,input true
     2443       ) .
     2444     return no-apply .
     2445   end.
     2446   on alt-enter of frame fr-D-rvs-doc-0
     2447   do:
     2448     run diasize_maximize in this-procedure
     2449       (input  ?
     2450       ).
     2451     return no-apply .
     2452   end.
     2453   procedure diasize_end-move :
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       define variable v-row-delta as decimal   no-undo .
     2458       define variable v-col-delta as decimal   no-undo .
     2459       define variable v-new-row as decimal   no-undo .
     2460       define variable v-new-col as decimal   no-undo .
     2461       assign
     2462         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2463         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2464       .
     2465       assign
     2466         v-row-delta = v-new-row - frame fr-D-rvs-doc-0 :height
     2467         v-col-delta = v-new-col - frame fr-D-rvs-doc-0 :width
     2468       .
     2469       run diasize_change-height in this-procedure
     2470         (input v-row-delta
     2471         ,input true
     2472         ) .
     2473       run diasize_change-width in this-procedure
     2474         (input v-col-delta
     2475         ,input true
     2476         ) .
     2477     end.
     2478   end procedure.
     2479   procedure diasize_maximize :
     2480     define input  parameter p-action as logical   no-undo .
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       if p-action = ?
     2485       then do:
     2486         if v-diasize-need-maximize = true
     2487         then do:
     2488           assign
     2489             p-action = true
     2490           .
     2491         end.
     2492         else do:
     2493           assign
     2494             p-action = false
     2495           .
     2496         end.
     2497       end.
     2498       if p-action = true
     2499       then do:
     2500         run diasize_change-height in this-procedure
     2501           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2502               - frame fr-D-rvs-doc-0 :height-chars
     2503           ,input true
     2504           ) .
     2505         run diasize_change-width in this-procedure
     2506           (input session :width-chars
     2507               - frame fr-D-rvs-doc-0 :width-chars
     2508           ,input true
     2509           ) .
     2510         assign
     2511           v-diasize-need-maximize = false
     2512         .
     2513       end.
     2514       else do:
     2515         run diasize_change-width in this-procedure
     2516           (input v-diasize-orig-frame-width
     2517               - frame fr-D-rvs-doc-0 :width-chars
     2518           ,input true
     2519           ) .
     2520         run diasize_change-height in this-procedure
     2521           (input v-diasize-orig-frame-height
     2522               - frame fr-D-rvs-doc-0 :height-chars
     2523           ,input true
     2524           ) .
     2525         assign
     2526           v-diasize-need-maximize = true
     2527         .
     2528       end.
     2529     end.
     2530   end procedure.
     2531   procedure diasize_restore-orig-size :
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       assign
     2536         v-diasize-current-frame-width  = frame fr-D-rvs-doc-0 :width
     2537         v-diasize-current-frame-height = frame fr-D-rvs-doc-0 :height
     2538       .
     2539       run diasize_set-height in this-procedure
     2540         (input  v-diasize-orig-frame-height
     2541         ,input  true
     2542         ) .
     2543       run diasize_set-width in this-procedure
     2544         (input  v-diasize-orig-frame-width
     2545         ,input  true
     2546         ) .
     2547     end.
     2548   end procedure.
     2549   procedure diasize_restore-current-size :
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553       run diasize_set-height in this-procedure
     2554         (input  v-diasize-current-frame-height
     2555         ,input  true
     2556         ) .
     2557       run diasize_set-width in this-procedure
     2558         (input  v-diasize-current-frame-width
     2559         ,input  true
     2560         ) .
     2561     end.
     2562   end procedure.
     2563   procedure diasize_set-browse-handle :
     2564     define input  parameter p-browse-handle as handle   no-undo .
     2565     define buffer buf_temp-browse-handle for temp-browse-handle .
     2566     do
     2567     on error undo, return error return-value
     2568     :
     2569       assign
     2570         v-diasize-browse-handle = p-browse-handle
     2571       .
     2572       for each buf_temp-browse-handle
     2573       on error undo, return error return-value
     2574       :
     2575         delete buf_temp-browse-handle .
     2576       end.
     2577     end.
     2578   end procedure.
     2579   procedure diasize_add_browse :
     2580     define input  parameter p-browse-type   as character no-undo .
     2581     define input  parameter p-browse-handle as handle    no-undo .
     2582     define buffer buf_temp-browse-handle for temp-browse-handle .
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       assign
     2587         v-diasize-browse-number = v-diasize-browse-number + 1
     2588       .
     2589       create buf_temp-browse-handle .
     2590       assign
     2591         buf_temp-browse-handle.browse-type   = p-browse-type
     2592         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2593         buf_temp-browse-handle.browse-handle = p-browse-handle
     2594       .
     2595     end.
     2596   end procedure.
     2597   procedure diasize_init :
     2598     define variable v-default-value    as logical   no-undo .
     2599     define variable v-restore-saved    as logical   no-undo .
     2600     define variable v-resize-value-str as character no-undo .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       do with frame fr-D-rvs-doc-0
     2605       :
     2606         assign
     2607           v-diasize-orig-frame-height = frame fr-D-rvs-doc-0 :height
     2608           v-diasize-orig-frame-width  = frame fr-D-rvs-doc-0 :width
     2609           v-diasize-browse-handle     = browse br-rvs-docs :handle
     2610         .
     2611         create button v-diasize-resize-button
     2612         assign
     2613           parent        = frame fr-D-rvs-doc-0 :first-child
     2614           label         = "s"
     2615           height-pixels = 16
     2616           width-pixels  = 16
     2617           visible       = true
     2618           sensitive     = true
     2619           movable       = true
     2620           triggers:
     2621             on end-move persistent run diasize_end-move in this-procedure .
     2622           end triggers.
     2623         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2624         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2625         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2626         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2627         assign
     2628           v-diasize-wndmax = false
     2629         .
     2630         if connected("ub") = true
     2631         then do:
     2632           define variable v-cntxt-db-num        as integer   no-undo .
     2633           define variable v-cntxt-userid        as character no-undo .
     2634           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2635                                             , OUTPUT v-cntxt-userid
     2636                                             ) .
     2637           run gbl/wndpar_r.p
     2638             (input  v-cntxt-db-num
     2639             ,input  v-cntxt-userid
     2640             ,input  'wndmax':U
     2641             ,output v-diasize-wndmax
     2642             ,output v-default-value
     2643             ) .
     2644         end.
     2645         assign
     2646           v-diasize-wndstore = false
     2647         .
     2648         if connected("ub") = true
     2649         then do:
     2650           run gbl/wndpar_r.p
     2651             (input  v-cntxt-db-num
     2652             ,input  v-cntxt-userid
     2653             ,input  'wndstore':U
     2654             ,output v-diasize-wndstore
     2655             ,output v-default-value
     2656             ) .
     2657         end.
     2658         assign
     2659           v-diasize-proc-name = entry(1, program-name(2), '.')
     2660         .
     2661         if v-diasize-wndstore = true
     2662         then do:
     2663           assign
     2664             v-restore-saved = false
     2665           .
     2666           if connected("ub") = true
     2667           then do:
     2668             run gbl/wndsizer.p
     2669               (input  v-cntxt-db-num
     2670               ,input  v-cntxt-userid
     2671               ,input  v-diasize-proc-name
     2672               ,input  'height':u
     2673               ,output v-resize-value-str
     2674               ) .
     2675             if v-resize-value-str <> '':U
     2676             then do:
     2677               run diasize_change-height in this-procedure
     2678                 (input  integer(v-resize-value-str)
     2679                 ,input  true
     2680                 ) .
     2681               assign
     2682                 v-restore-saved = true
     2683               .
     2684             end.
     2685           end.
     2686           if connected("ub") = true
     2687           then do:
     2688             run gbl/wndsizer.p
     2689               (input  v-cntxt-db-num
     2690               ,input  v-cntxt-userid
     2691               ,input  v-diasize-proc-name
     2692               ,input  'width':u
     2693               ,output v-resize-value-str
     2694               ) .
     2695             if v-resize-value-str <> '':U
     2696             then do:
     2697               run diasize_change-width in this-procedure
     2698                 (input  integer(v-resize-value-str)
     2699                 ,input  true
     2700                 ) .
     2701               assign
     2702                 v-restore-saved = true
     2703               .
     2704             end.
     2705           end.
     2706           if v-restore-saved <> true
     2707           then do:
     2708             if v-diasize-wndmax = true
     2709             then do:
     2710               run diasize_maximize in this-procedure
     2711                 (input  true
     2712                 ) .
     2713             end.
     2714           end.
     2715         end.
     2716         else do:
     2717           if v-diasize-wndmax = true
     2718           then do:
     2719             run diasize_maximize in this-procedure
     2720               (input  true
     2721               ) .
     2722           end.
     2723         end.
     2724       end.
     2725     end.
     2726   end procedure.
     2727   procedure diasize_need-full-display :
     2728     define output parameter p-need-full-display as logical   no-undo .
     2729     do
     2730     on error undo, return error return-value
     2731     :
     2732       assign
     2733         p-need-full-display = v-diasize-need-full-display
     2734       .
     2735       assign
     2736         v-diasize-need-full-display = false
     2737       .
     2738     end.
     2739   end procedure.
     2740   procedure get-context :
     2741      define output parameter p-db-num as integer          no-undo.
     2742      define output parameter p-user-id as character        no-undo.
     2743      define variable v-login               as character    no-undo.
     2744      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2745      define buffer buf_user-login  for ub.user-login .
     2746      do
     2747      on error undo, return error
     2748      :
     2749            FIND FIRST buf_sys-ctrl no-lock.
     2750            ASSIGN
     2751               v-login = USERID("ub")
     2752               p-db-num = buf_sys-ctrl.db-num
     2753            .
     2754            FIND FIRST buf_user-login
     2755                 WHERE buf_user-login.db-num = p-db-num
     2756                   AND buf_user-login.user-login = v-login
     2757                 no-lock
     2758                 no-error
     2759                 .
     2760            IF AVAILABLE buf_user-login
     2761            THEN DO:
     2762               assign
     2763                  p-user-id = buf_user-login.user-id
     2764               .
     2765            END.
     2766      end.
     2767   end procedure.
     2768       run diasize_init in this-procedure .
     2769   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   DEF VAR cur-clmn-numbr-rvs-docs as INT EXTENT 44 no-undo.
     2771   DEF VAR varmvibr-rvs-docs       as INT no-undo.
     2772   DEF VAR varmvjbr-rvs-docs       as INT no-undo.
     2773   DEF VAR varmvkbr-rvs-docs       as INT no-undo.
     2774   DEF VAR varmvlbr-rvs-docs       as INT no-undo.
     2775   DEF VAR move-elementbr-rvs-docs as INT no-undo.
     2776   def var jjbr-rvs-docs           as int no-undo.
     2777   do varmvibr-rvs-docs = 1 to EXTENT(cur-clmn-numbr-rvs-docs):
     2778     ASSIGN cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = varmvibr-rvs-docs.
     2779   END.
     2780   RUN start-mv-clmnbr-rvs-docs.
     2781   PROCEDURE start-mv-clmnbr-rvs-docs:
     2782   def var old-session as logical no-undo.
     2783      old-session = SESSION:IMMEDIATE-DISPLAY.
     2784      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2785      SESSION:IMMEDIATE-DISPLAY = old-session.
     2786   END.
     2787   ON ctrl-cursor-right OF BROWSE br-rvs-docs do:
     2788     RUN re-move-clmnbr-rvs-docs ( 5, 44).
     2789   END.
     2790   ON ctrl-cursor-left OF BROWSE br-rvs-docs do:
     2791     RUN re-move-clmnbr-rvs-docs (44, 5).
     2792   END.
     2793   PROCEDURE re-move-clmnbr-rvs-docs:
     2794     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2795     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2796     DO varmvibr-rvs-docs = 1 TO EXTENT(cur-clmn-numbr-rvs-docs):
     2797       if cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = source-column THEN cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = -1.
     2798     END.
     2799     if br-rvs-docs:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rvs-doc-0 then.
     2800     if source-column > target-column THEN
     2801     DO varmvjbr-rvs-docs = source-column - 1 to target-column BY -1:
     2802       DO varmvibr-rvs-docs = 1 TO EXTENT(cur-clmn-numbr-rvs-docs):
     2803           if cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = varmvjbr-rvs-docs THEN DO:
     2804             cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] + 1.
     2805           END.
     2806       END.
     2807     END.
     2808     ELSE
     2809     DO varmvjbr-rvs-docs = source-column + 1 to target-column:
     2810       DO varmvibr-rvs-docs = 1 TO EXTENT(cur-clmn-numbr-rvs-docs):
     2811         if cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = varmvjbr-rvs-docs THEN DO:
     2812           cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] - 1.
     2813         END.
     2814       END.
     2815     END.
     2816     DO varmvibr-rvs-docs = 1 TO EXTENT(cur-clmn-numbr-rvs-docs):
     2817       if cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = -1 THEN cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = target-column.
     2818     END.
     2819   END PROCEDURE.
     2820   PROCEDURE ch-clmnbr-rvs-docs:
     2821     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2822     if cur-clmn-loc <= 5 then do:
     2823       return .
     2824     end.
     2825     DO varmvibr-rvs-docs = 1 TO EXTENT(cur-clmn-numbr-rvs-docs):
     2826       if cur-clmn-numbr-rvs-docs[varmvibr-rvs-docs] = cur-clmn-loc THEN move-elementbr-rvs-docs = varmvibr-rvs-docs.
     2827     END.
     2828     RUN re-move-clmnbr-rvs-docs (cur-clmn-loc, 5).
     2829   END PROCEDURE.
     2830   PROCEDURE mv-brw-defaultbr-rvs-docs:
     2831   def var old-session as logical no-undo.
     2832     old-session = SESSION:IMMEDIATE-DISPLAY.
     2833     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2834     do varmvlbr-rvs-docs = 5 to EXTENT(cur-clmn-numbr-rvs-docs):
     2835       RUN re-move-clmnbr-rvs-docs (cur-clmn-numbr-rvs-docs[varmvlbr-rvs-docs], varmvlbr-rvs-docs).
     2836     END.
     2837     RUN start-mv-clmnbr-rvs-docs.
     2838     SESSION:IMMEDIATE-DISPLAY = old-session.
     2839   END PROCEDURE.
     2840   .
     2841   def var sort-labelbr-rvs-docs   as character no-undo .
     2842   def var sort-clmnbr-rvs-docs    as handle    no-undo .
     2843   def var cur-clmnbr-rvs-docs     as handle    no-undo .
     2844   def var cur-clmn-locbr-rvs-docs as integer   no-undo .
     2845   def var re-querybr-rvs-docs     as logical   initial no no-undo .
     2846   on start-search, ctrl-o of br-rvs-docs in frame fr-D-rvs-doc-0 do:
     2847      run sort-brbr-rvs-docs
     2848        (input (if available buf_c-rvs-doc
     2849                then recid(buf_c-rvs-doc)
     2850                else ?
     2851               )
     2852        ).
     2853   end.
     2854   PROCEDURE sort-brbr-rvs-docs :
     2855     define input parameter p-recid as recid no-undo .
     2856     if re-querybr-rvs-docs = no then do:
     2857       assign
     2858          cur-clmnbr-rvs-docs = br-rvs-docs:current-column in frame fr-D-rvs-doc-0
     2859       .
     2860       if sort-clmnbr-rvs-docs <> ? then sort-clmnbr-rvs-docs:column-fgcolor = 0.
     2861       if cur-clmnbr-rvs-docs = sort-clmnbr-rvs-docs then do:
     2862         assign
     2863            sort-labelbr-rvs-docs = ""
     2864            sort-clmnbr-rvs-docs = ?
     2865         .
     2866        end.
     2867        else do:
     2868          assign
     2869            sort-labelbr-rvs-docs = cur-clmnbr-rvs-docs:label
     2870            sort-clmnbr-rvs-docs  = cur-clmnbr-rvs-docs
     2871            sort-clmnbr-rvs-docs:column-fgcolor = 4
     2872          .
     2873        end.
     2874      end.
     2875     assign
     2876       cur-clmn-locbr-rvs-docs = 1
     2877     .
     2878     def var column-handle as handle no-undo .
     2879     column-handle = br-rvs-docs:first-column.
     2880     do while valid-handle(column-handle) :
     2881       if column-handle = cur-clmnbr-rvs-docs then do:
     2882         leave .
     2883       end.
     2884       column-handle = column-handle:NEXT-COLUMN.
     2885       assign
     2886         cur-clmn-locbr-rvs-docs = cur-clmn-locbr-rvs-docs + 1
     2887       .
     2888     end.
     2889     case sort-labelbr-rvs-docs:
     2890           when '*'  then DO:    assign       sort-column-name = "mark-string(buffer buf_c-rvs-doc )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2891           when ' Tип '  then DO:    assign       sort-column-name = "substring(buf_c-rvs-doc.rvs-type,1,9)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2892           when ' '  then DO:    assign       sort-column-name = "buf_c-rvs-doc.is-full"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2893           when 'Стат'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.status_"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2894           when 'Документ'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.rvs-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2895           when 'Дата док'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.doc-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2896           when 'Дата факт'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.fact-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2897           when 'Время факт'  then DO:    assign       sort-column-name = "string(buf_c-rvs-doc.fact-time,'HH:MM:SS':U)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2898           when 'Документ'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.out-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2899           when 'Смена'  then DO:    assign       sort-column-name = "substring(string(buf_c-rvs-doc.shift-date),1,5)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2900           when '№'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.shift-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2901           when 'Факт остаток'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-measure-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2902           when 'Измер. остаток'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.measure-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2903           when 'Факт брутто'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-brutto-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2904           when 'Измер. брутто'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.brutto-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2905           when 'Учет'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.system-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2906           when 'Учет (ед.пост.)'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.system-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2907           when 'Учет по!сред. плотности'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.system-cli-avrg-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2908           when 'Измер.!(ед. пост.)'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.measure-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2909           when 'Факт!(ед. пост.)'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-measure-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2910           when 'Измер. брутто! (ед.пост)'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.brutto-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2911           when 'Факт брутто!(ед.пост.)'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-brutto-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2912           when 'Измер. оборот'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.meas-mh-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2913           when 'Факт оборот'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-mh-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2914           when 'Измер. сумма!оборота'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.meas-am-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2915           when 'Факт сумма!оборота'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-am-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2916           when 'Измер.!кол-во наливов'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.meas-cf-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2917           when 'Факт!кол-во наливов'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-cf-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2918           when 'Измер.!уровень топлива'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.level-petrol"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2919           when 'Факт!уровень топлива'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-level-petrol"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2920           when 'Измер.!общий уровень'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.level-total"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2921           when 'Факт!общий уровень'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-level-total"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2922           when 'Измер.!уровень воды'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.level-water"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2923           when 'Факт!уровень воды'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.state-level-water"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2924           when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-name&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), buf_c-rvs-doc.obj-type, buf_c-rvs-doc.obj-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2925           when 'Изменил'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.corr-user-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2926           when 'Дата'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2927           when 'Время'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.sys-time"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2928           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2929           when 'Смена'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.corr-shift-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2930           when 'Дата смены'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.corr-shift-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2931           when 'Документ'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.corr-doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2932           when 'Имя'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.user-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2933           when 'БД'  then DO:    assign       sort-column-name = "buf_c-rvs-doc.user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2934       otherwise do:
     2935         assign
     2936           sort-column-name = ""
     2937         .
     2938         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2939           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-rvs-docs') then do:
     2940             run mv-brw-defaultbr-rvs-docs.
     2941           end.
     2942         if sort-labelbr-rvs-docs <> "" then do:
     2943           assign
     2944             cur-clmnbr-rvs-docs:column-fgcolor = 0
     2945           .
     2946         end.
     2947         assign
     2948           cur-clmn-locbr-rvs-docs = ?
     2949         .
     2950       end.
     2951     end case.
     2952     if p-recid <> ? then do:
     2953       reposition br-rvs-docs to recid p-recid no-error.
     2954       apply "value-changed" to br-rvs-docs in frame fr-D-rvs-doc-0.
     2955     end.
     2956     apply "entry" to br-rvs-docs in frame fr-D-rvs-doc-0.
     2957   END PROCEDURE.
     2958   procedure re-open-query-srt-clmnbr-rvs-docs:
     2959   if cur-clmnbr-rvs-docs = ? then do:
