        1   define input        parameter parparentproc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-rvs-code    as character     no-undo.
        5   define input-output parameter p-rid-list    as character     no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision$":U.
        7   define variable vss-author      as character no-undo initial "$Author$":U.
        8   define variable vss-date        as character no-undo initial "$Date$":U.
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       10   define variable vss-archive     as character no-undo initial "$Archive$":U.
       11   define variable vss-description as character no-undo initial "Список истории изменения сверок":U.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable c-point  as character no-undo .
      117   define variable tbl      as character no-undo .
      118   define variable join-tbl as character no-undo .
      119   define variable fld      as character no-undo .
      120   define variable lab      as character no-undo .
      121   define variable spr      as character no-undo .
      122   define variable dim      as character no-undo .
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable v-waitfram-action01         as character   no-undo .
      125   define variable v-waitfram-action02         as character   no-undo .
      126   define variable v-waitfram-action03         as character   no-undo .
      127   define variable mWaitFramTextBeg            as character   no-undo.
      128   define variable mWaitFramTextEnd            as character   no-undo.
      129   define variable mWaitFramView               as logical     no-undo.
      130   define variable mWaitProcEvent              as logical     no-undo init yes.
      131   define variable mWaitFramInterval           as integer     no-undo init 1 .
      132   define variable mWaitFramStop               as logical     no-undo.
      133   define variable mWaitFramStopUser           as logical     no-undo.
      134   define variable mWaitFramStopTimeOut        as logical     no-undo.
      135   define variable mWaitFramStartProc          as datetime-tz no-undo.
      136   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      137   define button B-WaitFramStop auto-end-key
      138        label "Стоп"
      139        size 10 by 1 tooltip "Остоновить процесс".
      140   define button B-viewProcInfo
      141        label "Информация"
      142        size 15 by 1 tooltip "Информация о процесс".
      143   define frame waitfram
      144     v-waitfram-action01 format "x(72)" no-label skip
      145     v-waitfram-action02 format "x(72)" no-label skip
      146     v-waitfram-action03 format "x(72)" no-label skip
      147     B-viewProcInfo
      148     B-WaitFramStop at row 4 col 30
      149     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      150     .
      151   define new global shared variable mBatchMode as logical no-undo init ?.
      152   define variable mFramBachModHandle as handle no-undo.
      153   mFramBachModHandle = frame waitfram:handle.
      154   define variable mFameOldVis as logical no-undo.
      155   define variable mVisCUrentVin as logical no-undo.
      156   if session:batch-mode
      157   then
      158      mBatchMode = yes.
      159   if mBatchMode = ? then do:
      160     mVisCUrentVin = current-window:visible.
      161     mFameOldVis = mFramBachModHandle:visible.
      162     mFramBachModHandle:visible  = yes.
      163     mBatchMode = mFramBachModHandle:visible ne yes.
      164     mFramBachModHandle:visible = mFameOldVis.
      165     current-window:visible = mVisCUrentVin.
      166   end.
      167    if  log-manager:logfile-name ne ?
      168     then DO:
      169         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      170         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      171         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      172     end.
      173   on choose of B-WaitFramStop in frame waitfram
      174   do:
      175     mWaitFramStop = yes.
      176     mWaitFramStopUser = yes.
      177   end.
      178   function waitfram-check-timeout returns logical():
      179      define variable vtime as int64 no-undo.
      180      if mWaitFramStopTimeOut
      181      then
      182         return yes.
      183      vtime = ( now - mWaitFramStartProc ) / 1000 .
      184      if     mWaitFramTimeOut ne ?
      185         and mWaitFramTimeOut ne 0
      186         and mWaitFramTimeOut lt vtime
      187      then do:
      188         mWaitFramStopTimeOut = yes.
      189      end.
      190      return mWaitFramStopTimeOut.
      191   end.
      192   procedure waitfram-hide :
      193     if not session:batch-mode
      194     then do
      195     on error undo, return error return-value
      196     :
      197       pause 0 before-hide .
      198       if not mBatchMode then
      199         hide frame waitfram .
      200     if     not mWaitFramView
      201        and mWaitProcEvent
      202     then
      203       process events .
      204     end.
      205   end procedure.
      206   procedure waitfram-show :
      207     define input  parameter p-message as character no-undo .
      208     define variable v-left-margin as integer   no-undo .
      209     if not session:batch-mode
      210     then do
      211     on error undo, return error return-value
      212     :
      213       if length(p-message) <= 70 then do:
      214         assign
      215           v-left-margin = integer((70 - length(p-message)) / 2)
      216         .
      217         assign
      218           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      219         .
      220         assign
      221           v-waitfram-action01 = " "
      222           v-waitfram-action02 = " "
      223                                    + fill(" ", v-left-margin)
      224                                    + p-message
      225           v-waitfram-action03 = " "
      226         .
      227       end.
      228       else do:
      229         define variable vRindex1 as integer no-undo.
      230         define variable vRindex2 as integer no-undo.
      231         vRindex1 = r-index(p-message," ",70).
      232         if vRindex1 = 0
      233         then
      234            vRindex1 = 70.
      235         if length(p-message)  <= vRindex1 + 70 then do:
      236           assign
      237             v-waitfram-action01 = " "
      238             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      240           .
      241         end.
      242         else do:
      243           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      244           if vRindex2 <= vRindex1
      245           then
      246              vRindex2 = vRindex1 + 70.
      247           assign
      248             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      250             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      251           .
      252         end.
      253       end.
      254       B-viewProcInfo:visible   in frame waitfram = no.
      255       B-viewProcInfo:sensitive in frame waitfram = no.
      256       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      257       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       if  (   mWaitFramView
      259          or  mWaitProcEvent)
      260          and not mBatchMode
      261       then
      262          display
      263             v-waitfram-action01 skip
      264             v-waitfram-action02 skip
      265             v-waitfram-action03 skip
      266          with frame waitfram .
      267       if     mWaitFramView
      268          then do:
      269             if     mWaitFramInterval ne ?
      270                and not mBatchMode
      271             then
      272                wait-for go of frame waitfram pause mWaitFramInterval.
      273          end.
      274          else
      275             if     mWaitProcEvent
      276                and not mBatchMode
      277             then
      278                process events .
      279     end.
      280   end procedure.
      281      procedure waitfram-show-this:
      282         define input  parameter iInterval as int64 no-undo.
      283         define variable vtime as int64 no-undo.
      284         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      285         mWaitFramInterval = iInterval.
      286         run waitfram-show (substitute("&1&2 &3&4" ,
      287                                       mWaitFramTextBeg ,
      288                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      289                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      290                                       mWaitFramTextEnd
      291                                      )
      292                           ).
      293      end.
      294      procedure WaitFramRunPause:
      295         define input  parameter iInterval as dec no-undo.
      296         define variable vStart  as datetime-tz no-undo.
      297         define variable vend    as datetime-tz no-undo.
      298         define variable vint as int64 no-undo.
      299         define variable vOk as logical no-undo.
      300         vStart = now.
      301         vend   = vStart.
      302         publish "WaitFramPause" (iInterval,output vOk).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and (   vint > 0
      308                 or (    not vOk
      309                     and iInterval eq ?
      310                     )
      311                 )
      312         then
      313            run waitfram-show-this (iInterval).
      314         vend   =  now.
      315         vint = vend - vStart.
      316         vint = iInterval - vint / 1000.
      317         if     not mWaitFramStop
      318            and vint > 0
      319         then do:
      320            run gbl/pause.p (vint * 1000).
      321         end.
      322         if iInterval ne ?
      323         then
      324            publish "WaitFramStop".
      325         waitfram-check-timeout().
      326      end.
      327      procedure WaitFramWaitFor:
      328         define input  parameter iInterval as dec no-undo.
      329         assign
      330            mWaitFramStartProc   = now
      331            mWaitFramStopUser    = no
      332            mWaitFramStopTimeOut = no
      333         .
      334         block-wait:
      335         do while not mWaitFramStop:
      336            run WaitFramRunPause (iInterval).
      337            if  waitfram-check-timeout()
      338            then do:
      339               leave block-wait.
      340            end.
      341         end.
      342         run waitfram-hide.
      343      end.
      344   procedure waitfram-join :
      345     define input  parameter p-line-1  as character no-undo .
      346     define input  parameter p-line-2  as character no-undo .
      347     define input  parameter p-line-3  as character no-undo .
      348     define output parameter p-message as character no-undo .
      349     do
      350     on error undo, return error return-value
      351     :
      352       assign
      353         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      354                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      356       .
      357     end.
      358   end procedure.
      359   function waitfram-join-function returns character
      360     (input p-line-1 as character
      361     ,input p-line-2 as character
      362     ,input p-line-3 as character
      363     ).
      364     define variable v-message as character no-undo .
      365     run waitfram-join in this-procedure
      366       (input  p-line-1
      367       ,input  p-line-2
      368       ,input  p-line-3
      369       ,output v-message
      370       ) .
      371     return v-message .
      372   end function .
      373   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   procedure fltfield-clear :
      375     define output parameter loc-fld as character no-undo.
      376     define output parameter loc-lab as character no-undo .
      377     define output parameter loc-spr as character no-undo .
      378     define output parameter loc-dim as character no-undo .
      379     assign
      380       loc-fld = ""
      381       loc-lab = ""
      382       loc-spr = ""
      383       loc-dim = "0"
      384     .
      385   end procedure .
      386   procedure fltfield-add :
      387     define input        parameter par-fld as character no-undo.
      388     define input        parameter par-lab as character no-undo .
      389     define input        parameter par-spr as character no-undo .
      390     define input-output parameter loc-fld as character no-undo.
      391     define input-output parameter loc-lab as character no-undo .
      392     define input-output parameter loc-spr as character no-undo .
      393     define input-output parameter loc-dim as character no-undo .
      394     do
      395     on error undo, return error
      396     :
      397       assign
      398       loc-fld = if loc-dim = '0'
      399                 then par-fld
      400                 else (loc-fld + chr(44) + par-fld)
      401       loc-lab = if loc-dim = '0'
      402                 then par-lab
      403                 else (loc-lab + chr(44) + par-lab)
      404       loc-spr = if loc-dim = '0'
      405                 then par-spr
      406                 else (loc-spr + chr(44) + par-spr)
      407       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      408                 string(integer(if num-entries(loc-dim) > 1
      409                               then entry(2, loc-dim)
      410                               else entry(1, loc-dim)
      411                               ) + 1)
      412       no-error
      413       .
      414     end.
      415   end procedure.
      416   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      417   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      418     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      419     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      420     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      421   END FUNCTION.
      422   PROCEDURE conv-rec-to-char :
      423     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      424     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      425     DO ON ERROR UNDO, RETURN ERROR :
      426       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      427     END.
      428   END PROCEDURE.
      429   define new global shared variable g#library  as handle no-undo .
      430   define new global shared variable g#library2 as handle no-undo .
      431   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432     define variable v-cntxt-db-num        as integer   no-undo .
      433     define variable v-cntxt-userid        as character no-undo .
      434     define variable v-cntxt-level         as character no-undo .
      435     define variable v-cntxt-host-code-obj as integer   no-undo .
      436     define variable v-cntxt-obj-type      as character no-undo .
      437     define variable v-cntxt-obj-code      as integer   no-undo .
      438     define variable v-cntxt-db-num-obj    as integer   no-undo .
      439     define variable v-cntxt-is-admin      as logical   no-undo .
      440   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441     run mainmenu_getcntxt in parparentproc
      442       (output v-cntxt-db-num
      443       ,output v-cntxt-userid
      444       ,output v-cntxt-level
      445       ,output v-cntxt-host-code-obj
      446       ,output v-cntxt-obj-type
