     1948           or error-status :get-message(1) <> ""
     1949           then do:
     1950             undo move_block, retry move_block .
     1951           end.
     1952         end.
     1953         assign
     1954           frame fr-D-rvs-doc-0 :height = frame fr-D-rvs-doc-0 :height + p-change-value
     1955           no-error .
