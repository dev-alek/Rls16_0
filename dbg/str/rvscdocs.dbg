     3910     run fltfield-add in this-procedure ( input 'state-cf-qnty',          input 'Факт кол-во наливов за смену',            input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3911     run fltfield-add in this-procedure ( input 'state-measure-cli-qnty', input 'Факт (ед.пост.)',                         input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3912     run fltfield-add in this-procedure ( input 'is-full',                input 'Полный',                                  input '':U,   input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
