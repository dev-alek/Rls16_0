      543   define VARIABLE p-report-id         as character no-undo .
      544   define variable v-file-name-rep-htm as character no-undo .
      545   FIND FIRST chk-doc NO-LOCK WHERE chk-doc.doc-code = cdoc NO-ERROR.
      546   IF NOT avail chk-doc then return.
      547   FOR EACH chk-pay No-LOCK where chk-pay.doc-code = chk-doc.doc-code:
      548      assign
      549         accum-pay-r-b = accum-pay-r-b +
      550                 (if v-curr-r-b = 'base':U
      551                   then chk-pay.tot-base
      552                   else chk-pay.tot-rubl)
      553         .
      554   END.
      555   if NOT chk-doc.d-card = "" then
      556   do:
      557      FIND FIRST dis-card NO-LOCK WHERE dis-card.d-card = chk-doc.d-card NO-ERROR.
      558      IF avail dis-card then
      559      do:
      560         FIND FIRST clients where clients.obj-type = dis-card.cli-type AND
      561            clients.obj-code = dis-card.cli-code No-ERROR.
      562      END.
      563   end.
      564         assign
      565           v-arc = search( "exe/qrgen.exe":U )
      566           .
      567         if v-arc = ? then
      568         do:
      569           message "Не найдена программа qrgen.exe"
      570           view-as alert-box.
      571            return error .
      572         end.
      573         define variable v-date as character no-undo .
      574         v-date = "20" + entry(3,string(chk-doc.chk-date),"/") + entry(2,string(chk-doc.chk-date),"/") + entry(1,string(chk-doc.chk-date),"/").
      575         v-fix = "t=" + v-date + "T" + replace(string(chk-doc.chk-time,"HH:MM"),":","") + "&i=" + string(chk-doc.chk-num) + "&n=" + string(chk-doc.chk-type) .
      576         os-command silent value (v-arc + ' -size=128 -content="' + v-fix + '"' + ' -filename="' + string(session :temp-directory) + 'qr-code_fix"') .
      577         v-fix-png = string(session :temp-directory) + "qr-code_fix" + ".png" .
      578   find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "sbprrn" and
      579                                             buf_chk-pay-attr.doc-code = chk-doc.doc-code
      580                                             and buf_chk-pay-attr.attr-value <> "" no-error .
      581   if available (buf_chk-pay-attr) then do:
      582         os-command silent value (v-arc + ' -size=128 -content="' + buf_chk-pay-attr.attr-value + '"' + ' -filename="' + string(session :temp-directory) + 'qr-code_sbprrn"') .
      583         v-attr-sbprrn = string(session :temp-directory) + "qr-code_sbprrn" + ".png" .
      584   end.
      585   find first buf_chk-pay-attr no-lock where (buf_chk-pay-attr.attr-code = "RRN" or buf_chk-pay-attr.attr-code = "cpdoc") and
      586                                             buf_chk-pay-attr.doc-code = chk-doc.doc-code
      587                                             and buf_chk-pay-attr.attr-value <> "" no-error .
      588   if available (buf_chk-pay-attr) then do:
      589         os-command silent value (v-arc + ' -size=128 -content="' + buf_chk-pay-attr.attr-value + '"' + ' -filename="' + string(session :temp-directory) + 'qr-code_rrn"') .
      590         v-attr-rnn = string(session :temp-directory) + "qr-code_rrn" + ".png" .
      591   end.
      592   date_string = cur-time-print() .
      593   run get-report-num (output p-report-id).
      594   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      595   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      596   put stream OutStr-html unformatted
      597      "<!DOCTYPE HTML>" skip
      598      ' <html>' skip
      599      '  <head>' skip
      600      '   <meta charset="utf-8">' skip
      601      '    <style type="text/css">' skip
      602      '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      603      '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      604      '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      605      '   </style>' skip
      606      '  </head>' skip
      607      .
      608   put stream OutStr-html unformatted
      609      '<body>' skip
      610      '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      611      '<thead>' skip
      612      .
      613   put stream OutStr-html unformatted
      614      '<tr class="set_columns">' skip
      615      '<td style="width: 20px;"></td>' skip
      616      '<td style="width: 15px;"></td>' skip
      617      '<td style="width: 20px;"></td>' skip
      618      '<td style="width: 30px;"></td>' skip
      619      '<td style="width: 40px;"></td>' skip
      620      '<td style="width: 40px;"></td>' skip
      621      '<td style="width: 40px;"></td>' skip
      622      '<td style="width: 120px;"></td>' skip
      623      '<td style="width: 40px;"></td>' skip
      624      '<td style="width: 60px;"></td>' skip
      625      '<td style="width: 40px;"></td>' skip
      626      '<td style="width: 40px;"></td>' skip
      627      '<td style="width: 40px;"></td>' skip
      628      '<td style="width: 40px;"></td>' skip
      629      '<td style="width: 40px;"></td>' skip
      630      '<td style="width: 20px;"></td>' skip
      631      '<td style="width: 20px;"></td>' skip
      632      '<td style="width: 40px;"></td>' skip
      633      '<td style="width: 40px;"></td>' skip
      634      '<td style="width: 40px;"></td>' skip
      635      '<td style="width: 60px;"></td>' skip
      636      '<td style="width: 60px;"></td>' skip
      637      '<td style="width: 80px;"></td>' skip
      638      '<td style="width: 40px;"></td>' skip
      639      '</tr>' skip
      640      .
      641   put stream OutStr-html unformatted
      642      '<TR>'skip
      643      '<TD colspan="14" style="font-weight: bold;">' + string(date_string) + '</TD>' skip
      644      '<TD colspan="4" style="text-align: center;">Для поиска чека на кассе</TD>' skip
      645      '<TD colspan="3" style="text-align: center;">RRN</TD>' skip
      646      '<TD colspan="3" style="text-align: center;">SBPRRN</TD>' skip
      647      '</TR>' skip
      648      '<TR>'skip
      649      '<TD colspan="14" style="font-weight: bold;">Чек N ' + string(chk-doc.doc-code) + ' Магазин N ' + string(chk-doc.obj-code) + ' Дата: ' + string(chk-doc.chk-date, "99/99/9999") + ' Время: ' + string(chk-doc.chk-time, "HH:MM") + ' Дата смены: ' + string(chk-doc.shift-date, "99/99/9999") + ' Номер смены: ' + shift-name-no-err(buffer chk-doc) + '</TD>' skip
      650      .
      651        if search(v-fix-png) <> ? then
      652     do:
      653       put stream OutStr-html unformatted
      654         '<TD text_wrap="true" rowspan="5" colspan="4" style="text-align: center;"><img src="' + string(v-fix-png)+ '" width="130" height="130" alt=""/></TD>' skip
      655         .
      656     end.
      657     else
      658     do:
      659       put stream OutStr-html unformatted
      660         '<TD rowspan="5" colspan="4"></TD>' skip
      661         .
      662     end.
      663        if search(v-attr-rnn) <> ? then
      664     do:
      665       put stream OutStr-html unformatted
      666         '<TD text_wrap="true" rowspan="5" colspan="3" style="text-align: center;"><img src="' + string(v-attr-rnn)+ '" width="130" height="130" alt=""/></TD>' skip
      667         .
      668     end.
      669     else
      670     do:
      671       put stream OutStr-html unformatted
      672         '<TD rowspan="5" colspan="3"></TD>' skip
      673         .
      674     end.
      675        if search(v-attr-sbprrn) <> ? then
      676     do:
      677       put stream OutStr-html unformatted
      678         '<TD text_wrap="true" rowspan="5" colspan="3" style="text-align: center;"><img src="' + string(v-attr-sbprrn)+ '" width="130" height="130" alt=""/></TD>' skip
      679         .
      680     end.
      681     else
      682     do:
      683       put stream OutStr-html unformatted
      684         '<TD rowspan="5" colspan="3"></TD>' skip
      685         .
      686     end.
      687   put stream OutStr-html unformatted
      688      '</TR>' skip
      689      '<TR>'skip
      690      '<TD colspan="14" style="font-weight: bold;">Касса N ' + string(chk-doc.pay-desk) + ' Номер по кассе ' + string(chk-doc.chk-num) + ' Кассир: ' + if chk-doc.cashier <> ? then string(chk-doc.cashier) else "" + ' Продавец: ' + if chk-doc.sales-man <> ? then string(chk-doc.sales-man) else "" + '</TD>' skip
      691      '</TR>' skip
      692      .
      693   if NOT chk-doc.d-card = "" then
      694   do:
      695      if available (clients) then
      696      do:
      697         put stream OutStr-html unformatted
      698            '<TR>'skip
      699            '<TD colspan="14" style="font-weight: bold;">Дисконтная карта №: ' + string(chk-doc.d-card) + ' Клиент: ' + string(clients.obj-name) + ' Сумма товарная: ' + string(chk-doc.tot-doc,"->>>,>>>,>>9.99") + '</TD>'
      700            '</TR>' skip
      701            .
      702      end.
      703      else
      704      do:
      705         put stream OutStr-html unformatted
      706            '<TR>'skip
      707            '<TD colspan="14" style="font-weight: bold;">Дисконтная карта №: ' + string(chk-doc.d-card) + ' Сумма товарная: ' + string(chk-doc.tot-doc,"->>>,>>>,>>9.99") + '</TD>'
      708            '</TR>' skip
      709            .
      710      end.
      711   end.
      712   if chk-doc.sub-discnt <> 0 then
      713   do:
      714      put stream OutStr-html unformatted
      715         '<TR>'skip
      716         '<TD colspan="14" text_wrap="true" style="text-align: left; font-weight: bold;">Скидка общая: ' + string((chk-doc.discnt),"->>>>>>>>>>>9.99") + ' Списание: ' + string(chk-doc.sub-discnt, "->>>,>>>,>>9.99") + ' Процент скидки: ' + string((if chk-doc.tot-doc = 0 then 0 else ( chk-doc.discnt / chk-doc.tot-doc * 100 ) ), "->9.99%") + '</TD>' skip
      717         '</TR>' skip
      718         .
      719   end.
      720   else
      721   do:
      722      put stream OutStr-html unformatted
      723         '<TR>'skip
      724         '<TD colspan="14" text_wrap="true" style="text-align: left; font-weight: bold;">Скидка общая: ' + string((chk-doc.discnt),"->>>>>>>>>>>9.99") + ' Списание: ' + string(chk-doc.sub-discnt, "->>>,>>>,>>9.99") + ' Процент скидки: ' + string((if chk-doc.tot-doc = 0 then 0 else ( chk-doc.discnt / chk-doc.tot-doc * 100 ) ), "->9.99%") + '</TD>' skip
      725         '</TR>' skip
      726         .
      727   end.
      728   put stream OutStr-html unformatted
      729      '<TR>'skip
      730      '<TD colspan="14" style="font-weight: bold;">Сумма нетто: ' + string(chk-doc.netto, "->>>,>>>,>>9.99") + ' Сумма оплат: ' + string(ACCUM-pay-r-b, "->>>,>>>,>>9.99") + '</TD>' skip
      731      '</TR>' skip
      732      '<TR>'skip
      733      '<TD colspan="14" style="font-weight: bold;">ТОВАРЫ ПО ЧЕКУ:</TD>' skip
      734      '</TR>' skip
      735      '<TR height: 14px;>'skip
      736      '<TD colspan="14" style="font-weight: bold; border-bottom: 1px solid black;"></TD>' skip
      737      '</TR>' skip
      738      .
      739   put stream OutStr-html unformatted
      740      '<TR>' skip
      741      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">NN</TD>' skip
      742      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Код</TD>' skip
      743      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Артикул</TD>' skip
      744      '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight: bold; background-color: silver; border-top: 1px solid black;">Название/</TD>' skip
      745      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Ош</TD>' skip
      746      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Код в спул-файле</TD>' skip
      747      '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver; border-top 1px solid black;">ТРК</TD>' skip
      748      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Количество</TD>' skip
      749      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Изм</TD>' skip
      750      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Цена</TD>' skip
      751      '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Скидка</TD>' skip
      752      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">% ск</TD>' skip
      753      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Цена нетто</TD>' skip
      754      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Сумма по строке</TD>' skip
      755      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Дорожный налог</TD>' skip
      756      '<TD text_wrap="true" rowspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Спи</TD>' skip
      757      '</TR>'skip
      758      '<TR>'skip
      759      '<TD text_wrap="true" colspan="2" rowspan="2" style="text-align: center; font-weight: bold; background-color: silver; border-bottom: 1px solid black;">Производитель</TD>' skip
      760      '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Пист</TD>' skip
      761      '</TR>'skip
      762      '<TR>'skip
      763      '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver; border-bottom: 1px solid black;">Рез</TD>' skip
      764      '</TR>'skip
      765      .
      766   FOR EACH chk-gds No-LOCK where
      767      chk-gds.doc-code = chk-doc.doc-code
      768      by abs(CHk-gds.line-num ):
      769      FIND FIRST bar-code No-LOCK WHERE bar-code.b-code = chk-gds.b-code NO-ERROR.
      770      IF AVAIL bar-code then
      771      do:
      772         FIND FIRST goods NO-LOCK WHERE
      773            goods.gds-code = bar-code.gds-code NO-ERROR.
      774         FIND FIRST  clients NO-LOCK WHERE
      775            clients.obj-type = goods.prod-type AND
      776            clients.obj-code = goods.prod-code NO-ERROR.
      777         FIND FIRST gds-prt No-LOCK where gds-prt.upper-code = goods.prt-root NO-ERROR.
      778      end.
      779      assign
      780         fgds-discnt-pc = (chk-gds.discnt / (chk-gds.price-base + chk-gds.price-service) * 100)
      781         for-gds-sum    = (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty
      782         for-gds-price  = chk-gds.price-base + chk-gds.price-service - chk-gds.discnt
      783         .
      784      put stream OutStr-html unformatted
      785         '<TR>' skip
      786         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; border: 1px solid black;">' + string(chk-gds.line-num) + '</TD>' skip
      787         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; border: 1px solid black;">' + string(chk-gds.b-code) + '</TD>' skip
      788         '<TD text_wrap="true" colspan="2" style="text-align: center; border-top: 1px solid black; border-right: 1px solid black;">' + if avail bar-code then goods.artic + '</TD>' else "" + '</td>' skip
      789         '<TD text_wrap="true" colspan="2" style="text-align: center; border-top: 1px solid black; border-right: 1px solid black;">' + if avail bar-code then goods.gds-name + '</TD>' else "" + '</td>' skip
      790         '<TD text_wrap="true" rowspan="3" style="text-align: center; border: 1px solid black;">' + if chk-gds.is-error then "yes" + '</TD>' else "no" + '</TD>' skip
      791         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: center; border: 1px solid black;">' + string(chk-gds.src-code) + '</TD>' skip
      792         '<TD text_wrap="true" style="text-align: center; border-top: 1px solid black;">' + string(chk-gds.pump) + '</TD>' skip
      793         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-gds.doc-qnty,"->>>>>>>>>>>9.999") + '</TD>' skip
      794         '<TD text_wrap="true" rowspan="3" style="text-align: center; border: 1px solid black;">' + if avail bar-code then string(bar-code.unit-cli) + '</TD>' else "" + '</TD>' skip
      795         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: right; border: 1px solid black;">' + string((chk-gds.price-base + chk-gds.price-service),"->>>>>>>>>>>9.99") + '</TD>' skip
      796         '<TD text_wrap="true" colspan="2" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-gds.discnt,"->>>>>>>>>>>9.99") + '</TD>' skip
      797         '<TD text_wrap="true" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(fgds-discnt-pc,"->>>>>>>>>>>9.99") + '</TD>' skip
      798         '<TD text_wrap="true" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(for-gds-price,"->>>>>>>>>>>9.99") + '</TD>' skip
      799         '<TD text_wrap="true" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(for-gds-sum,"->>>>>>>>>>>9.99") + '</TD>' skip
      800         '<TD text_wrap="true" rowspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-gds.road-tax,"->>>>>>>>>>>9.99") + '</TD>' skip
      801         '<TD text_wrap="true" rowspan="3" style="text-align: right; border: 1px solid black;">' + if chk-gds.write-off-code <> ? and chk-gds.write-off-code <> 0 then "yes" + '</TD>' else "no" + '</TD>' skip
      802         '</TR>'skip
      803         '<TR>' skip
      804         .
      805         if avail bar-code then do:
      806            put stream OutStr-html unformatted
      807         '<TD text_wrap="true" colspan="2" rowspan="2" style="text-align: center; border-bottom: 1px solid black; border-right: 1px solid black;">' + IF ub.gds-prt.node-name <> '_Пустая шкала':U then string(gds-prt.f-name) + '</TD>' else "" + '</td>' skip .
      808         end.
      809         else do:
      810            put stream OutStr-html unformatted
      811         '<TD text_wrap="true" colspan="2" rowspan="2" style="text-align: center; border-bottom: 1px solid black; border-right: 1px solid black;"></TD>'
      812         .
      813         end.
      814         put stream OutStr-html unformatted
      815       '<TD text_wrap="true" colspan="2" rowspan="2" style="text-align: center; border-bottom: 1px solid black; border-right: 1px solid black;">' + if avail bar-code then clients.obj-name + '</TD>' else "" + '</td>' skip
      816       '<TD text_wrap="true" style="text-align: center;">' +  if chk-gds.nozzle-code <> 0 then string(chk-gds.nozzle-code) + '</TD>' else "" + '</TD>' skip
      817       '</TR>' skip
      818       '<TR>' skip
      819       '<TD text_wrap="true" style="text-align: center; border-bottom: 1px solid black;">' + if chk-gds.loc1 <> "" then string(chk-gds.loc1) + '</TD>' else "" + '</TD>' skip
      820       '</TR>' skip
      821         .
      822   assign
      823   itog-doc-qnty = itog-doc-qnty + chk-gds.doc-qnty
      824   itog-price-service = itog-price-service + ((chk-gds.price-base + chk-gds.price-service) * chk-gds.doc-qnty)
      825   itog-discnt = itog-discnt + (chk-gds.discnt * chk-gds.doc-qnty)
      826   itog-gds-sum = itog-gds-sum + ((chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty)
      827   .
      828   END.
      829   put stream OutStr-html unformatted
      830      '<TR>' skip
      831      '<TD text_wrap="true" colspan="12" style="font-weight: bold; text-align: right;"></TD>' skip
      832      '<TD text_wrap="true" colspan="2" style="font-weight: bold; text-align: right;">' + string(itog-doc-qnty,"->>>>>>>>>>>9.999") + '</TD>' skip
      833      '<TD text_wrap="true"></TD>' skip
      834      '<TD text_wrap="true" colspan="2" style="font-weight: bold; text-align: right;">' + string(itog-price-service,"->>>>>>>>>>>9.99") + '</TD>' skip
      835      '<TD text_wrap="true" colspan="2" style="font-weight: bold; text-align: right;">' + string(itog-discnt,"->>>>>>>>>>>9.99") + '</TD>' skip
      836      '<TD text_wrap="true" style="font-weight: bold; text-align: right;">' + string((itog-discnt / (itog-price-service * 100)),"->>>>>>>>>>>9.99") + '</TD>' skip
      837      '<TD text_wrap="true"></TD>' skip
      838      '<TD text_wrap="true" style="font-weight: bold; text-align: right;">' + string(itog-gds-sum,"->>>>>>>>>>>9.99") + '</TD>' skip
      839      '<TD text_wrap="true" colspan="2"></TD>' skip
      840      '</TR>'skip
      841      .
      842   put stream OutStr-html unformatted
      843      '<TR>'skip
      844      '<TD text_wrap="true" colspan="18" style="font-weight: bold;">ОПЛАТЫ ПО ЧЕКУ</TD>' skip
      845      '<TD colspan="6"></TD>' skip
      846      '</TR>'skip
      847      '<TR height: 14px;>'skip
      848      '<TD colspan="18" style="font-weight: bold;"></TD>' skip
      849      '<TD colspan="6" style="font-weight: bold; 0px solid white;"></TD>' skip
      850      '</TR>' skip
      851      '<TR>' skip
      852      '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">NN</TD>' skip
      853      '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Код. вал</TD>' skip
      854      '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Валюта</TD>' skip
      855      '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Код платежа</TD>' skip
      856      '<TD text_wrap="true" colspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Платеж</TD>' skip
      857      '<TD text_wrap="true" colspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Сумма в вал. платежа</TD>' skip
      858      '<TD text_wrap="true" colspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Сумма в баз.вал</TD>' skip
      859      '<TD text_wrap="true" colspan="3" style="text-align: center; font-weight: bold; background-color: silver; border: 1px solid black;">Сумма в рублях</TD>' skip
      860      '<TD text_wrap="true" style="border-top: 0px solid white;"></TD>' skip .
      861      put stream OutStr-html unformatted
      862      '<TD text_wrap="true" colspan="4" style="border-top: 0px solid white;"></TD>' skip
      863      '</TR>'skip
      864      .
      865   FOR EACH chk-pay No-LOCK WHERE
      866      chk-pay.doc-code = chk-doc.doc-code
      867      by CHk-pay.line-num :
      868      FIND FIRST currency No-LOCK WHERE currency.curr-code = chk-pay.curr-code NO-ERROR.
      869      FIND FIRST cash-pay No-LOCK WHERE
      870         cash-pay.cdpay-code = chk-pay.pay-code AND
      871         cash-pay.curr-code = chk-pay.curr-code No-ERROR.
      872      assign
      873         itog-tot-sum = itog-tot-sum + chk-pay.tot-sum
      874         itog-tot-base = itog-tot-base + chk-pay.tot-base
      875         itog-tot-rubl = itog-tot-rubl + chk-pay.tot-rubl
      876         .
      877      put stream OutStr-html unformatted
      878         '<TR>' skip
      879         '<TD text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(chk-pay.line-num) + '</TD>' skip
      880         '<TD text_wrap="true" colspan="2" style="text-align: center; border: 1px solid black;">' + string(chk-pay.curr-code) + '</TD>' skip
      881         '<TD text_wrap="true" colspan="2" style="text-align: center; border: 1px solid black;">' + if available (currency) then currency.curr-name + '</TD>' else "НЕОПОЗНАННАЯ ВАЛЮТА" + '</TD>' skip
      882         '<TD text_wrap="true" colspan="2" style="text-align: center; border: 1px solid black;">' + string(chk-pay.pay-code) + '</TD>' skip
      883         '<TD text_wrap="true" colspan="3" style="text-align: center; border: 1px solid black;">' + if available (cash-pay) then cash-pay.obj-name + '</TD>' else "НЕОПОЗНАННАЯ ОПЛАТА" + '</TD>' skip
      884         '<TD text_wrap="true" colspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-pay.tot-sum,"->>>>>>>>>>>9.99") + '</TD>' skip
      885         '<TD text_wrap="true" colspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-pay.tot-base,"->>>>>>>>>>>9.99") + '</TD>' skip
      886         '<TD text_wrap="true" colspan="3" style="text-align: right; border: 1px solid black;">' + string(chk-pay.tot-rubl,"->>>>>>>>>>>9.99") + '</TD>' skip
      887         '<TD text_wrap="true"></TD>' skip
      888         '<TD text_wrap="true" colspan="4"></TD>' skip
      889         '</TR>'skip
      890         .
      891   END.
      892   define variable NumberFN as character no-undo .
      893   define variable FiscalDocNumber as character no-undo .
      894   define variable FiscalDocSign as character no-undo .
      895   find first chk-doc-attr where chk-doc-attr.attr-code = 'CHNumberFN' and chk-doc-attr.doc-code = chk-doc.doc-code no-lock no-error.
      896   IF AVAILABLE chk-doc-attr THEN DO:
      897   NumberFN = chk-doc-attr.attr-value.
      898   end.
      899   find first chk-doc-attr where chk-doc-attr.attr-code = 'CHFiscalDocNumber' and chk-doc-attr.doc-code = chk-doc.doc-code no-lock no-error.
      900   IF AVAILABLE chk-doc-attr THEN DO:
      901   FiscalDocNumber = chk-doc-attr.attr-value.
      902   end.
      903   find first chk-doc-attr where chk-doc-attr.attr-code = 'CHFiscalDocSign' and chk-doc-attr.doc-code = chk-doc.doc-code no-lock no-error.
      904   IF AVAILABLE chk-doc-attr THEN DO:
      905   FiscalDocSign = chk-doc-attr.attr-value.
      906   end.
      907   put stream OutStr-html unformatted
      908      '<TR>' skip
      909      '<TD text_wrap="true" colspan="10" style="text-align: right; font-weight: bold;"></TD>' skip
      910      '<TD text_wrap="true" colspan="3" style="text-align: right; font-weight: bold;">' + string(itog-tot-sum,"->>>>>>>>>>>9.99") + '</TD>' skip
      911      '<TD text_wrap="true" colspan="3" style="text-align: right; font-weight: bold;">' + string(itog-tot-base,"->>>>>>>>>>>9.99") + '</TD>' skip
      912      '<TD text_wrap="true" colspan="3" style="text-align: right; font-weight: bold;">' + string(itog-tot-rubl,"->>>>>>>>>>>9.99") + '</TD>' skip
      913      '<TD text_wrap="true"></TD>' skip
      914      '<TD text_wrap="true" colspan="4"></TD>' skip
      915      '</TR>'skip
      916      '<TR>' skip
      917      '<TD text_wrap="true" colspan="18" style="font-weight: bold;"> ФИСКАЛЬНЫЕ ДАННЫЕ </TD>' skip
      918      '</TR>' skip
      919      '<TR>' skip
      920      '<TD ><BR></TD>' skip
      921      '</TR>' skip
      922      '<TR>' skip
      923      '<TD text_wrap="true" colspan="2"> ФН </TD>' skip
      924      '<TD text_wrap="true" colspan="10">' NumberFN '</TD>' skip
      925      '</TR>' skip
      926      '<TR>' skip
      927      '<TD text_wrap="true" colspan="2"> ФД </TD>' skip
      928      '<TD text_wrap="true" colspan="10">' FiscalDocNumber '</TD>' skip
      929      '</TR>' skip
      930      '<TR>' skip
      931      '<TD text_wrap="true" colspan="2"> ФПД </TD>' skip
      932      '<TD text_wrap="true" colspan="10">' FiscalDocSign '</TD>' skip
      933      '</TR>'skip
      934      '</thead>' skip
      935      '</table>' skip
      936      '</body>' skip
      937      '</html>' skip
      938      .
      939   output stream OutStr-html close.
      940   run prn-lib-reportviewer-report-name in this-procedure (
      941      input this-procedure
      942      ,input v-file-name-rep-htm
      943      ) no-error.
      944   if error-status:error then
      945   do:
      946      message return-value view-as alert-box.
      947      return .
      948   end.
      949   PROCEDURE get-report-num :
      950       define output parameter p-report-num as integer no-undo .
      951       do
      952           on error undo, return error return-value
      953           :
      954           run gbl/getrpnum.p (output p-report-num).
      955       end.
      956   END PROCEDURE.
