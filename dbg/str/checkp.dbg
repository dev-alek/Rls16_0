        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   DEFINE INPUT PARAMETER cdoc like chk-doc.doc-code.
        4   define variable vss-revision    as character no-undo init "$Revision: 55e470c22f96, 3463, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
        6   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:34 $":U .
