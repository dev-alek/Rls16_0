      504   function fnc-convert-dot-to-colon returns character
      505       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      506   function fnc-convert-dot-to-colon returns character
      507   (input p-data as decimal, input p-accur as character, input p-num as integer):
      508       define variable result as character no-undo.
      509       define variable v-str-result as character no-undo.
      510       if p-data = ? then p-data = 0 .
      511       p-data = round(p-data, p-num).
      512       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      513       return v-str-result.
      514   END FUNCTION.
