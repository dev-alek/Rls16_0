        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle    no-undo.
        3   define input  parameter p-doc-code    as character no-undo .
        4   define input  parameter p-artic       as character no-undo .
        5   define input  parameter p-prod-type   as character no-undo .
        6   define input  parameter p-prod-code   as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: inv-lkp.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/inv-lkp.p $":U .
       12   define variable vss-description as character no-undo init "Просмотр строки инвентаризации".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define buffer buf_doc-line for ub.doc-line .
       72   define buffer buf_goods    for ub.goods .
       73   define buffer buf_units    for ub.units .
       74   define buffer buf_gds-prt  for ub.gds-prt .
       75   define buffer buf_trn-doc  for ub.trn-doc .
       76   define variable varprt-rec as recid no-undo.
       77   do
       78   on error undo, return error return-value
       79   :
       80     find first buf_doc-line no-lock
       81       where buf_doc-line.doc-code  = p-doc-code
       82         and buf_doc-line.artic     = p-artic
       83         and buf_doc-line.prod-type = p-prod-type
       84         and buf_doc-line.prod-code = p-prod-code
       85       no-error .
       86     if not available buf_doc-line
       87     then do:
       88       message
       89         vss-workfile vss-revision vss-description skip
       90         "Ошибка при задании входных параметров" skip
       91         "Не найдена строка документа" skip
       92         "Документ" p-doc-code skip
       93         "Артикул" p-artic p-prod-type p-prod-code skip
       94         view-as alert-box error .
       95       undo, return error return-value .
       96     end.
       97     find first buf_trn-doc no-lock
       98       where buf_trn-doc.doc-code = buf_doc-line.doc-code
       99       .
      100     find buf_goods no-lock
      101       where buf_goods.artic     = buf_doc-line.artic
      102         and buf_goods.prod-type = buf_doc-line.prod-type
      103         and buf_goods.prod-code = buf_doc-line.prod-code
      104       .
      105     find first buf_units no-lock
      106       where buf_units.unit-name = buf_goods.unit-base
      107       .
      108     find buf_gds-prt no-lock
      109       where buf_gds-prt.upper-code = buf_goods.prt-root
      110       .
      111     if lookup('2ед':U, buf_units.type) > 0
      112     then do:
      113       run str/parts-l.w
      114         (input  parparentproc
      115         ,input  buf_trn-doc.obj-type
      116         ,input  buf_trn-doc.obj-code
      117         ,input  buf_goods.gds-code
      118         ,input  buf_doc-line.doc-code
      119         ,input  'ПРОСМОТР':U
      120         ,input  'документ':U
      121         ,input  'текущий':U
      122         ,input  'документ':U
      123         ,output varprt-rec
      124         ) .
      125     end.
      126     else do:
      127       if buf_gds-prt.node-name = '_Пустая шкала':U
      128       then do:
      129         run str/inv-prt.w
      130           (input  parparentproc
      131           ,input  recid(buf_trn-doc)
      132           ,input  recid(buf_doc-line)
      133           ,input  recid(buf_goods)
      134           ,input  'ПРОСМОТР':U
      135           ,input  recid(buf_gds-prt)
      136           ,input  'корн':U
      137           ).
      138       end.
      139       else do:
      140         run str/inv-p.p
      141           (input  parparentproc
      142           ,input  recid(buf_trn-doc)
      143           ,input  recid(buf_doc-line)
      144           ,input  recid(buf_goods)
      145           ,input  'ПРОСМОТР':U
      146           ).
      147       end.
      148     end.
      149   end.
