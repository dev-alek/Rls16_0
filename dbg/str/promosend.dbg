        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Толкач пересылки промоакций на кассу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable p-pos-type    as character no-undo .
       91   define variable p-obj-type    like ub.clients.obj-type no-undo .
       92   define variable p-obj-code    like ub.clients.obj-code no-undo .
       93   define variable action        as char      no-undo .
       94   define variable recid-list    as character no-undo .
       95   define var      choice        as integer   no-undo.
       96   define var      rid-list      as char      no-undo.
       97   define variable glog          as logical   no-undo .
       98   define variable log-file-name as character no-undo init "send-cd.txt":U .
       99   define variable v-view-log as logical no-undo .
      100   define variable v-host-code like ub.sysconf.host-code no-undo .
      101   define variable vSubs as class ibs.th.ref.promo.promoactionsubs no-undo .
      102   assign
      103      p-pos-type = entry(1, p-parameter, chr(4))
      104      p-obj-type = entry(2, p-parameter, chr(4))
      105      p-obj-code = integer(entry(3, p-parameter, chr(4)))
      106      action     = entry(4, p-parameter, chr(4))
      107      recid-list = entry(5, p-parameter, chr(4))
      108   no-error .
      109   if error-status:error then do:
      110     run write-log-and-file in p-log-handle (
      111           input 1
      112         , input log-file-name
      113         , input 1
      114         , input substitute("Ошибка входных параметров &1:&2&3"
      115                            , p-parameter
      116                            , chr(10)
      117                            , error-status:get-message(1)
      118                            )).
      119     v-view-log = yes.
      120     undo, return error .
      121   end .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      124     (input  p-obj-type
      125     ,input  p-obj-code
      126     ,output v-host-code
      127     )  .
      128   CASE p-pos-type:
      129     when 'IBM-XML':U
      130     then do:
      131       FIND FIRST ub.cash-desk NO-LOCK WHERE
      132                 ub.cash-desk.db-num = g#db-num AND
      133                 ub.cash-desk.pos-type = 'IBM-XML':U
      134                 No-error.
      135       IF not avail(ub.cash-desk) then do:
      136           run write-log-and-file in p-log-handle (
      137                 input 1
      138               , input log-file-name
      139               , input 1
      140               , input substitute( "!!!&1 промоакции реализуются только для POS &2"
      141                                   , (if action = "U" then "Передача" else "Удаление")
      142                                   , 'IBM-XML':U
      143                                 )
      144                                                 ).
      145         return.
      146       end.
      147       if action = "U"
      148       then do:
      149       end.
      150       else do:
      151       end.
      152     end.
      153   END CASE.
      154   if recid-list = "" then do:
      155   run gbl/d-askw.w (input "Выбор промоакций для пересылки",
      156               input ( (if action = "U"
      157                         then "Переслать на кассу"
      158                         else "Удалить из кассы" ) + chr(10) +
      159                                 "информацию о промоакциях"
      160                                 ),
      161               input "|",
      162               input "Все|Выборочно|Отказ от пересылки",
      163               input "||",
      164               input 1,
      165               input 3,
      166               output choice).
      167   CASE choice:
      168      when 1 then
      169         do:
      170         end.
      171      when 2 then
      172         do:
      173       run ref/promo.p (input parparentproc,yes,output vSubs) no-error.
      174       if not valid-object (vSubs) then return.
      175         end.
      176      when 3 then
      177         do:
      178            return.
      179         end.
      180   END CASE.
      181   end.
      182   else do:
      183   define variable v-promo-stor as class ibs.th.gbl.storage.promoactionstorage no-undo .
      184   def var ii as integer no-undo .
      185   v-promo-stor = new ibs.th.gbl.storage.promoactionstorage().
      186   do ii = 0 to num-entries(recid-list,chr(44)):
      187   for each ub.PromoAction no-lock where recid(ub.PromoAction) = integer(entry(ii,recid-list,chr(44))):
      188      v-promo-stor:getpromoactionsubs(input-output vSubs,ub.PromoAction.db-num,ub.PromoAction.id, p-obj-code).
      189   end.
      190   end.
      191   end.
      192   CASE p-pos-type:
      193     when  'IBM-XML':U
      194     then do:
      195       run str/send-promo.p (
      196                       input parparentproc
      197                      ,input p-parent-handle
      198                      ,input p-log-handle
      199                      ,input p-obj-code
      200                      ,input action
      201                      ,input (if not valid-object (vSubs) and recid-list = ""
      202                              then 0
      203                              else 1)
      204                     , input vSubs
      205                     , input log-file-name
      206                     , input-output v-view-log
      207                     ) no-error .
      208     end.
      209   end CASE.
      210     finally :
      211       run write-log-and-file in p-log-handle (
      212           input 1
      213         , input log-file-name
      214         , input 1
      215         , input substitute("&1", chr(10))
      216       ).
      217       define variable v-save-file-name as character no-undo .
      218       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
      219       OS-APPEND value(log-file-name) value(v-save-file-name).
      220       OS-DELETE value(log-file-name).
      221     end finally .
