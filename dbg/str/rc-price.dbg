        1   block-level on error undo, throw.
        2   define input parameter parrecdoc-line as recid no-undo.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#lib-trn  as handle no-undo .
        8   define new global shared variable g#lib-trn2 as handle no-undo .
        9   define new global shared variable g#lib-trn3 as handle no-undo .
       10   define new global shared variable g#lib-trn4 as handle no-undo .
       11   define variable varprice-cli                like ub.doc-line.price-rubl no-undo.
       12   define variable varprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
       13   define variable varprice-road-tax           like ub.doc-line.price-rubl no-undo.
       14   define variable varprice-other-exp          like ub.doc-line.price-rubl no-undo.
       15   define variable varprice-transport-exp      like ub.doc-line.price-rubl no-undo.
       16   define variable varprice-without-abs        like ub.doc-line.price-rubl no-undo.
       17   define variable varprice-slt                like ub.doc-line.price-rubl no-undo.
       18   define variable varprice-no-slt             like ub.doc-line.price-rubl no-undo.
       19   define variable varprice-vat                like ub.doc-line.price-rubl no-undo.
       20   define variable varprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
       21   define variable varprice-rubl               like ub.doc-line.price-rubl no-undo.
       22   define variable varprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
       23   define variable varprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
       24   define variable varprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
       25   define variable varprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
       26   define variable varprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
       27   define variable varprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
       28   define variable varprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
       29   define variable varprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
       30   define variable varprice-base               like ub.doc-line.price-base no-undo.
       31   define variable varprice-road-tax-base      like ub.doc-line.price-base no-undo.
       32   define variable varprice-other-exp-base     like ub.doc-line.price-base no-undo.
       33   define variable varprice-transport-exp-base like ub.doc-line.price-base no-undo.
       34   define variable varprice-without-abs-base   like ub.doc-line.price-base no-undo.
       35   define variable varprice-slt-base           like ub.doc-line.price-base no-undo.
       36   define variable varprice-no-slt-base        like ub.doc-line.price-base no-undo.
       37   define variable varprice-vat-base           like ub.doc-line.price-base no-undo.
       38   define variable varprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
       39   define buffer t-doc for trn-doc.
       40   find first doc-line where recid(doc-line) = parrecdoc-line.
       41   find first t-doc where t-doc.doc-code = doc-line.doc-code.
       42   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
       43     (
       44      input   t-doc.doc-code
       45     ,input   t-doc.base-rate
       46     ,input   t-doc.base-scale
       47     ,input   t-doc.exch-rate
       48     ,input   t-doc.exch-scale
       49     ,input   t-doc.vat-type
       50     ,input   t-doc.slt-type
       51     ,input   doc-line.artic
       52     ,input   doc-line.prod-type
       53     ,input   doc-line.prod-code
       54     ,input   doc-line.price-cli
       55     ,input   doc-line.cli-base-rate
       56     ,input   doc-line.price-rubl
       57     ,input   doc-line.vat-pc
       58     ,input   doc-line.slt-pc
       59     ,input   doc-line.road-tax
       60     ,input   doc-line.transport-rubl
       61     ,input   doc-line.other-rubl
       62     ,output  varprice-cli
       63     ,output  varprice-cli-unit-base
       64     ,output  varprice-road-tax
       65     ,output  varprice-other-exp
       66     ,output  varprice-transport-exp
       67     ,output  varprice-without-abs
       68     ,output  varprice-slt
       69     ,output  varprice-no-slt
       70     ,output  varprice-vat
       71     ,output  varprice-no-vat-slt
       72     ,output  varprice-rubl
       73     ,output  varprice-road-tax-rubl
       74     ,output  varprice-other-exp-rubl
       75     ,output  varprice-transport-exp-rubl
       76     ,output  varprice-without-abs-rubl
       77     ,output  varprice-slt-rubl
       78     ,output  varprice-no-slt-rubl
       79     ,output  varprice-vat-rubl
       80     ,output  varprice-no-vat-slt-rubl
       81     ,output  varprice-base
       82     ,output  varprice-road-tax-base
       83     ,output  varprice-other-exp-base
       84     ,output  varprice-transport-exp-base
       85     ,output  varprice-without-abs-base
       86     ,output  varprice-slt-base
       87     ,output  varprice-no-slt-base
       88     ,output  varprice-vat-base
       89     ,output  varprice-no-vat-slt-base
       90     ) no-error.
       91   if error-status:error then do:
       92     return error "Ошибка при пересчете линии документа".
       93   end.
       94   assign doc-line.price-cli  = varprice-cli
       95          doc-line.price-base = varprice-base
       96          doc-line.price-rubl = varprice-rubl.
