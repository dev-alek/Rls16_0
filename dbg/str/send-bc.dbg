     7604   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7605   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7606   DEFINE parameter buffer loc-price-list for ub.price-list.
     7607   DEFINE parameter buffer loc-units for ub.units.
     7608   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7609   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7610   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7611   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7612   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7613   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7614   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7615   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7616   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7617   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7618   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7619   define variable v-disc-price-sale as decimal no-undo .
     7620   define variable v-pdf-id as integer no-undo .
     7621   define variable v-pdf-db-num as integer no-undo .
     7622   define variable v-oss as character no-undo.
