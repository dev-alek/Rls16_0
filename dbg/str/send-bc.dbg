     8084             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8085             cash-gds-discnt.obj-type = parobj-type
     8086             cash-gds-discnt.obj-code = parobj-code
     8087             cash-gds-discnt.discnt-value = v-disc-price-sale.
