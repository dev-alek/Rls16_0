     3016   procedure xml-cd-write-header:
     3017   do
     3018   on error undo, return error
     3019   :
     3020   define input parameter p-xml-file-name       as character    no-undo.
     3021   define input parameter p-xml-file-name-path  as character    no-undo.
     3022   define input parameter p-doc-name            as character    no-undo.
     3023   define input parameter p-version             as character    no-undo.
     3024   define input parameter p-obj-list            as character    no-undo.
     3025   define input parameter p-correspondent       as character    no-undo .
     3026   define input parameter p-write-header        as logical      no-undo .
     3027   define variable OS-time as character no-undo .
     3028   define variable id as character no-undo .
     3029   define buffer buf_db for ub.db.
     3030   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3031   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3032   assign
     3033   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3034   .
     3035   run bgelib-tag-open in this-procedure (
     3036                                        1
     3037                                       ,p-doc-name
     3038                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3039                                         ).
     3040   if p-write-header then do:
     3041     run bgelib-tag-open(2, "Header","").
     3042     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3043     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3044     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3045     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3046     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3047     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3048     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3049     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3050     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3051     run bgelib-tag-close( 2, "Header" ).
     3052   end.
     3053   output stream stmXMLOut close.
     3054   end.
     3055   end procedure.
     3056   procedure xml-cd-write-footer:
     3057   do
     3058   on error undo, return error
     3059   :
     3060   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3061   define input parameter p-xml-file-name as character    no-undo.
     3062   define input parameter p-doc-name      as character    no-undo .
     3063   define variable v-error-num     as integer           no-undo.
     3064   define variable v-md5-signature as character no-undo .
     3065   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3066   run bgelib-tag-close( 0, p-doc-name ).
     3067   put stream stmXMLOut unformatted skip.
     3068   output stream stmXMLOut close.
     3069   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3070   if v-error-num > 0
     3071   then do:
     3072      return error.
     3073   end.
     3074   if opsys = "unix"
     3075   then do:
     3076       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3077   end.
     3078   end.
     3079   end procedure.
     3080   procedure xml-cd-filename :
     3081   do
     3082   on error undo, return error
     3083   :
     3084   define input parameter  p-out               as character no-undo .
     3085   define output parameter p-xml-file-name     as character    no-undo.
     3086   define output parameter p-xml-file-name-path   as character    no-undo.
     3087   define output parameter p-log-file-name     as character    no-undo.
     3088   define output parameter p-locked            as logical      no-undo.
     3089   define variable v-out as character     no-undo.
     3090   define variable loc#log as logical no-undo .
     3091   define variable BadFlag as logical no-undo .
     3092   define variable fq as integer no-undo .
     3093   define variable v-remote as character no-undo .
     3094   assign
     3095   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3096   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3097   p-log-file-name = p-out + "actions.log"
     3098   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3099   .
     3100   end.
     3101   end procedure.
     3102   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3103   define variable v-date-str as character no-undo .
     3104   assign
     3105   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3106                string(Month(p-date), "99":U) + "-":U +
     3107                string(DAY(p-date), "99":U).
     3108   return v-date-str.
     3109   END FUNCTION.
     3110   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3111   define variable v-date-str as character no-undo .
     3112   assign
     3113   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3114                string(Month(p-date), "99":U) + "-":U +
     3115                string(DAY(p-date), "99":U) + chr(32) +
     3116                string(p-time, "HH:MM:SS").
     3117   return v-date-str.
     3118   END FUNCTION.
     3119   function string-to-date returns date ( input p-string  as character):
     3120     define variable v-date as date no-undo .
     3121     assign
     3122     v-date = date(integer(substring(p-string, 4, 2))
     3123                   ,integer(substring(p-string, 1, 2))
     3124                   ,integer(substring(p-string, 7, 4))
     3125                  ) no-error .
     3126     if error-status:error then return ?.
     3127     return v-date.
     3128   END FUNCTION.
     3129   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3130   define variable v-time as integer no-undo init ?.
     3131   define variable v-dop1 as character no-undo .
     3132   define variable v-dop2 as character no-undo .
     3133   assign
     3134   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3135   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3136   no-error .
     3137   if error-status:error then return ?.
     3138   assign
     3139   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3140             integer(entry(2, v-dop2, ";":U)) * 60 +
     3141             integer(entry(3, v-dop2, ";":U)) no-error .
     3142   return v-time.
     3143   END FUNCTION.
     3144   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3145   procedure gdcstcod_cst-code :
     3146     define input  parameter p-obj-type  as character no-undo .
     3147     define input  parameter p-obj-code  as integer   no-undo .
     3148     define input  parameter p-gds-code  as integer   no-undo .
     3149     define input  parameter p-in-code   as character no-undo .
     3150     define input  parameter p-part-code as character no-undo .
     3151     define output parameter p-cst-code  as character no-undo .
     3152     define buffer buf_goods for ub.goods .
     3153     define buffer buf_parts for ub.parts .
     3154     do
     3155     on error undo, return error return-value
     3156     :
     3157       assign
     3158         p-cst-code = ''
     3159       .
     3160       find first buf_goods no-lock
     3161         where buf_goods.gds-code = p-gds-code
     3162         no-error .
     3163       if not available buf_goods
     3164       then do:
     3165         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3166       end.
     3167       if p-in-code = ?
     3168       then do:
     3169         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3170       end.
     3171       if p-part-code = ?
     3172       then do:
     3173         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3174       end.
     3175       if p-in-code = '':u
     3176       then do:
     3177         find first buf_parts no-lock
     3178           where buf_parts.obj-type  = p-obj-type
     3179             and buf_parts.obj-code  = p-obj-code
     3180             and buf_parts.artic     = buf_goods.artic
     3181             and buf_parts.prod-type = buf_goods.prod-type
     3182             and buf_parts.prod-code = buf_goods.prod-code
     3183             and buf_parts.out-code  = 'free-zone':U
     3184             and buf_parts.status_   = false
     3185           no-error .
     3186         if available buf_parts
     3187         then do:
     3188           assign
     3189             p-cst-code = buf_parts.cst-code
     3190           .
     3191         end.
     3192       end.
     3193       else do:
     3194         find first buf_parts no-lock
     3195           where buf_parts.obj-type  = p-obj-type
     3196             and buf_parts.obj-code  = p-obj-code
     3197             and buf_parts.artic     = buf_goods.artic
     3198             and buf_parts.prod-type = buf_goods.prod-type
     3199             and buf_parts.prod-code = buf_goods.prod-code
     3200             and buf_parts.out-code  = 'free-zone':U
     3201             and buf_parts.in-code   = p-in-code
     3202             and buf_parts.part-code = p-part-code
     3203           no-error .
     3204         if available buf_parts
     3205         then do:
     3206           assign
     3207             p-cst-code = buf_parts.cst-code
     3208           .
     3209         end.
     3210       end.
     3211     end.
     3212   end procedure.
