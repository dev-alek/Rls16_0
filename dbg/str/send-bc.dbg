     6103   procedure fact-order-mpl :
     6104     do
     6105     on error undo, return error return-value
     6106     :
     6107   define input  parameter p-doc-date as date     no-undo .
     6108   define input  parameter p-obj-type as character no-undo .
     6109   define input  parameter p-obj-code as integer   no-undo .
     6110   define output parameter p-fact-order as decimal   no-undo .
     6111   define variable v-fact-date            as date    no-undo .
     6112   define variable v-fact-time            as integer no-undo .
     6113   define variable v-fact-order           as decimal no-undo .
     6114   define variable v-shift-end-fact-order as decimal no-undo .
     6115   define variable v-day-end-fact-order   as decimal no-undo .
     6116   define variable l-shift-on as logical no-undo .
     6117   define variable l-date as date      no-undo .
     6118   define variable l-time as integer   no-undo .
     6119   define variable shift-date as date      no-undo .
     6120   define variable shift-num  as integer   no-undo .
     6121   define variable shift-name as character no-undo .
     6122   define variable max-fact-order as decimal   no-undo .
     6123   define buffer buf_global-state for ub.global-state  .
     6124   find first buf_global-state no-lock no-error .
     6125   if not available buf_global-state then do:
     6126      message
     6127        "Не заданы параметры ценообразования!"
     6128        view-as alert-box error
     6129      .
     6130      return error return-value .
     6131   end.
     6132     run cur-time in this-procedure
     6133     ( output v-fact-date ,
     6134       output v-fact-time  ).
     6135   if p-doc-date = ? then do:
     6136   if buf_global-state.pl-use-sys-date-time  = true then do:
     6137         run factord in this-procedure
     6138           (input  v-fact-date
     6139           ,input  v-fact-time
     6140           ,input  v-fact-time
     6141           ,input  ?
     6142           ,input  ?
     6143           ,input  false
     6144           ,output v-fact-order
     6145           ,output v-shift-end-fact-order
     6146           ,output v-day-end-fact-order
     6147           ) no-error .
     6148         if error-status :error
     6149         or v-fact-order = ?
     6150         or v-fact-order = 0 then do:
     6151           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6152         end.
     6153         p-fact-order = v-fact-order .
     6154   end.
     6155   else do:
     6156   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6158     (input  p-obj-type
     6159     ,input  p-obj-code
     6160     ,input  'shift-on=request'
     6161     ,output l-shift-on
     6162     ) no-error .
     6163         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6164         if p-doc-date <> ? then do:
     6165         end.
     6166          run gbl/factdate.p
     6167          ( input        p-obj-type  ,
     6168            input        p-obj-code  ,
     6169            input-output v-fact-date ,
     6170            input-output v-fact-time ,
     6171            input-output shift-date      ,
     6172            input-output shift-num       ,
     6173            input-output shift-name      ,
     6174            input        yes
     6175            ) no-error .
     6176         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6177         run factord in this-procedure
     6178           (input  v-fact-date
     6179           ,input  v-fact-time
     6180           ,input  v-fact-time
     6181           ,input  shift-date
     6182           ,input  shift-num
     6183           ,input  l-shift-on
     6184           ,output v-fact-order
     6185           ,output v-shift-end-fact-order
     6186           ,output v-day-end-fact-order
     6187           ) no-error .
     6188         if error-status :error
     6189         or v-fact-order = ?
     6190         or v-fact-order = 0 then do:
     6191           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6192         end.
     6193         p-fact-order = v-fact-order .
     6194   end.
     6195   end.
     6196   else do:
     6197          run gbl/factdate.p
     6198          ( input        p-obj-type  ,
     6199            input        p-obj-code  ,
     6200            input-output v-fact-date ,
     6201            input-output v-fact-time ,
     6202            input-output shift-date      ,
     6203            input-output shift-num       ,
     6204            input-output shift-name      ,
     6205            input        yes
     6206            ) no-error .
     6207         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6208         v-fact-date = p-doc-date .
     6209         run factord in this-procedure
     6210           (input  v-fact-date
     6211           ,input  v-fact-time
     6212           ,input  v-fact-time
     6213           ,input  shift-date
     6214           ,input  shift-num
     6215           ,input  l-shift-on
     6216           ,output v-fact-order
     6217           ,output v-shift-end-fact-order
     6218           ,output v-day-end-fact-order
     6219           ) no-error .
     6220         if error-status :error
     6221         or v-fact-order = ?
     6222         or v-fact-order = 0 then do:
     6223           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6224         end.
     6225         p-fact-order = v-fact-order .
     6226   end.
     6227     end.
     6228   end procedure.
