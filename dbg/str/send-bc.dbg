     2086   end .
     2087   procedure xmlchar-encode :
     2088   define input parameter p-in-string      as character        no-undo.
     2089   define output parameter p-out-string    as character        no-undo.
     2090       define variable v-position      as integer      no-undo.
     2091       define variable v-current-char  as character    no-undo.
     2092   do
     2093   on error undo, return error
     2094   :
     2095       assign
     2096           p-out-string = "":U
     2097       .
     2098       case p-in-string
     2099       :
     2100           when ?
     2101           then do:
     2102               assign
     2103                   p-out-string = "?":U
     2104               .
     2105           end.
     2106           when "?":U
     2107           then do:
     2108               assign
     2109                   p-out-string = "&#63;":U
     2110               .
     2111           end.
     2112           otherwise do:
     2113               do v-position = 1 to length( p-in-string )
     2114               :
     2115                   assign
     2116                       v-current-char = substring( p-in-string, v-position, 1 )
     2117                   .
     2118                   case v-current-char
     2119                   :
     2120                       when "&":U
     2121                       then do:
     2122                           assign
     2123                               p-out-string = p-out-string + "&amp;":U
     2124                           .
     2125                       end.
     2126                       when ">":U
     2127                       then do:
     2128                           assign
     2129                               p-out-string = p-out-string + "&gt;":U
     2130                           .
     2131                       end.
     2132                       when "<":U
     2133                       then do:
     2134                           assign
     2135                               p-out-string = p-out-string + "&lt;":U
     2136                           .
     2137                       end.
     2138                       when "'":U
     2139                       then do:
     2140                           assign
     2141                               p-out-string = p-out-string + "&apos;":U
     2142                           .
     2143                       end.
     2144                       when '"':U
     2145                       then do:
     2146                           assign
     2147                               p-out-string = p-out-string + "&quot;":U
     2148                           .
     2149                       end.
     2150                       when chr(1)
     2151                       then do:
     2152                           assign
     2153                               p-out-string = p-out-string + "":U
     2154                           .
     2155                       end.
     2156                       when chr(2)
     2157                       then do:
     2158                           assign
     2159                               p-out-string = p-out-string + "":U
     2160                           .
     2161                       end.
     2162                       when chr(3)
     2163                       then do:
     2164                           assign
     2165                               p-out-string = p-out-string + "":U
     2166                           .
     2167                       end.
     2168                       when chr(4)
     2169                       then do:
     2170                           assign
     2171                               p-out-string = p-out-string + "":U
     2172                           .
     2173                       end.
     2174                       when chr(5)
     2175                       then do:
     2176                           assign
     2177                               p-out-string = p-out-string + "":U
     2178                           .
     2179                       end.
     2180                       when chr(6)
     2181                       then do:
     2182                           assign
     2183                               p-out-string = p-out-string + "":U
     2184                           .
     2185                       end.
     2186                       when chr(7)
     2187                       then do:
     2188                           assign
     2189                               p-out-string = p-out-string + "":U
     2190                           .
     2191                       end.
     2192                       when chr(8)
     2193                       then do:
     2194                           assign
     2195                               p-out-string = p-out-string + "":U
     2196                           .
     2197                       end.
     2198                       when chr(9)
     2199                       then do:
     2200                           assign
     2201                               p-out-string = p-out-string + "":U
     2202                           .
     2203                       end.
     2204                       when chr(29)
     2205                       then do:
     2206                           assign
     2207                               p-out-string = p-out-string + "":U
     2208                           .
     2209                       end.
     2210                       when chr(10)
     2211                       then do:
     2212                           assign
     2213                               p-out-string = p-out-string + "&#10;":U
     2214                           .
     2215                       end.
     2216                       when chr(13)
     2217                       then do:
     2218                           assign
     2219                               p-out-string = p-out-string + "&#13;":U
     2220                           .
     2221                       end.
     2222                       otherwise do:
     2223                           assign
     2224                               p-out-string = p-out-string + v-current-char
     2225                           .
     2226                       end.
     2227                   end case.
     2228               end.
     2229           end.
     2230       end case.
     2231   end.
     2232   end .
     2233   procedure xmlchar-encode-1c :
     2234   define input parameter p-in-string      as character        no-undo.
     2235   define output parameter p-out-string    as character        no-undo.
     2236       define variable v-position      as integer      no-undo.
     2237       define variable v-current-char  as character    no-undo.
     2238   do
     2239   on error undo, return error
     2240   :
     2241       assign
     2242           p-out-string = "":U
     2243       .
     2244       case p-in-string
     2245       :
     2246           when ?
     2247           then do:
     2248               assign
     2249                   p-out-string = "?":U
     2250               .
     2251           end.
     2252           otherwise do:
     2253               do v-position = 1 to length( p-in-string )
     2254               :
     2255                   assign
     2256                       v-current-char = substring( p-in-string, v-position, 1 )
     2257                   .
     2258                   case v-current-char
     2259                   :
     2260                       when chr(1)
     2261                       then do:
     2262                           assign
     2263                               p-out-string = p-out-string + " ":U
     2264                           .
     2265                       end.
     2266                       when chr(2)
     2267                       then do:
     2268                           assign
     2269                               p-out-string = p-out-string + " ":U
     2270                           .
     2271                       end.
     2272                       when chr(3)
     2273                       then do:
     2274                           assign
     2275                               p-out-string = p-out-string + " ":U
     2276                           .
     2277                       end.
     2278                       when chr(4)
     2279                       then do:
     2280                           assign
     2281                               p-out-string = p-out-string + " ":U
     2282                           .
     2283                       end.
     2284                       when chr(5)
     2285                       then do:
     2286                           assign
     2287                               p-out-string = p-out-string + " ":U
     2288                           .
     2289                       end.
     2290                       when chr(6)
     2291                       then do:
     2292                           assign
     2293                               p-out-string = p-out-string + " ":U
     2294                           .
     2295                       end.
     2296                       when chr(7)
     2297                       then do:
     2298                           assign
     2299                               p-out-string = p-out-string + " ":U
     2300                           .
     2301                       end.
     2302                       when chr(8)
     2303                       then do:
     2304                           assign
     2305                               p-out-string = p-out-string + " ":U
     2306                           .
     2307                       end.
     2308                       when chr(9)
     2309                       then do:
     2310                           assign
     2311                               p-out-string = p-out-string + " ":U
     2312                           .
     2313                       end.
     2314                       when chr(29)
     2315                       then do:
     2316                           assign
     2317                               p-out-string = p-out-string + " ":U
     2318                           .
     2319                       end.
     2320                       when chr(10)
     2321                       then do:
     2322                           assign
     2323                               p-out-string = p-out-string + " ":U
     2324                           .
     2325                       end.
     2326                       when chr(13)
     2327                       then do:
     2328                           assign
     2329                               p-out-string = p-out-string + " ":U
     2330                           .
     2331                       end.
     2332                       otherwise do:
     2333                           assign
     2334                               p-out-string = p-out-string + v-current-char
     2335                           .
     2336                       end.
     2337                   end case.
     2338               end.
     2339           end.
     2340       end case.
     2341   end.
     2342   end .
     2343   procedure xmlchar-decode :
     2344   define input parameter p-in-string      as character        no-undo.
     2345   define output parameter p-out-string    as character        no-undo.
     2346       define variable v-position      as integer      no-undo.
     2347       define variable v-last-position as integer      no-undo.
     2348       define variable v-temp-integer  as integer      no-undo.
     2349       define variable v-current-char  as character    no-undo.
     2350       define variable v-next-char     as character    no-undo.
     2351       define variable v-success       as logical      no-undo.
     2352   do
     2353   on error undo, return error
     2354   :
     2355       assign
     2356           p-out-string = "":U
     2357           v-position   = 0
     2358       .
     2359       replace-cycle:
     2360       do while yes
     2361       on error undo, return error
     2362       :
     2363           assign
     2364               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2365           .
     2366           if v-last-position <= v-position
     2367           then do:
     2368               if v-position = 0
     2369               then do:
     2370                   assign
     2371                       p-out-string = p-in-string
     2372                   .
     2373               end.
     2374               else do:
     2375                   assign
     2376                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2377                   .
     2378               end.
     2379               leave replace-cycle.
     2380           end.
     2381           else do:
     2382               assign
     2383                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2384                   v-position      = v-last-position
     2385                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2386               .
     2387               if v-current-char = "#":U
     2388               then do:
     2389                   assign
     2390                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2391                   .
     2392                   if v-last-position > 0
     2393                   then do:
     2394                       run xmlchar-read-integer in this-procedure
     2395                        (
     2396                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2397                           , output v-temp-integer
     2398                           , output v-success
     2399                       ).
     2400                       if v-success = yes
     2401                       and v-temp-integer >= 1
     2402                       and v-temp-integer <= 255
     2403                       then do:
     2404                           assign
     2405                               p-out-string = p-out-string + chr( v-temp-integer )
     2406                               v-position   = v-last-position + 1
     2407                           .
     2408                       end.
     2409                       else do:
     2410                           assign
     2411                               p-out-string = p-out-string + "&":U
     2412                               v-position   = v-position   + 1
     2413                           .
     2414                       end.
     2415                   end.
     2416                   else do:
     2417                       assign
     2418                           p-out-string = p-out-string + "&":U
     2419                           v-position   = v-position   + 1
     2420                       .
     2421                   end.
     2422               end.
     2423               else do:
     2424                   case substring( p-in-string, v-position + 1, 3 )
     2425                   :
     2426                       when "lt;":U
     2427                       then do:
     2428                           assign
     2429                               p-out-string = p-out-string + "<":U
     2430                               v-position   = v-position   + 3
     2431                           .
     2432                       end.
     2433                       when "gt;":U
     2434                       then do:
     2435                           assign
     2436                               p-out-string = p-out-string + ">":U
     2437                               v-position   = v-position   + 3
     2438                           .
     2439                       end.
     2440                       otherwise do:
     2441                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2442                           then do:
     2443                               assign
     2444                                   p-out-string = p-out-string + "&":U
     2445                                   v-position   = v-position   + 4
     2446                               .
     2447                           end.
     2448                           else do:
     2449                               case substring( p-in-string, v-position + 1, 5 )
     2450                               :
     2451                                   when "quot;":U
     2452                                   then do:
     2453                                       assign
     2454                                           p-out-string = p-out-string + '"':U
     2455                                           v-position   = v-position   + 5
     2456                                       .
     2457                                   end.
     2458                                   when "apos;":U
     2459                                   then do:
     2460                                       assign
     2461                                           p-out-string = p-out-string + "'":U
     2462                                           v-position   = v-position   + 5
     2463                                       .
     2464                                   end.
     2465                                   otherwise do:
     2466                                       assign
     2467                                           p-out-string = p-out-string + "&":U
     2468                                       .
     2469                                   end.
     2470                               end case.
     2471                           end.
     2472                       end.
     2473                   end case.
     2474               end.
     2475           end.
     2476       end.
     2477   end.
     2478   end .
     2479   procedure xmlchar-read-integer :
     2480   define input parameter p-input-string      as character        no-undo.
     2481   define output parameter p-output-integer   as integer          no-undo.
     2482   define output parameter p-success       as logical          no-undo.
     2483   do
     2484   on error undo, return error
     2485   :
     2486       assign
     2487           p-output-integer = integer( p-input-string )
     2488       no-error.
     2489       if error-status :error
     2490       then do:
     2491           assign
     2492               p-success           = no
     2493               p-output-integer    = 0
     2494           .
     2495       end.
     2496       else do:
     2497           assign
     2498               p-success           = yes
     2499           .
     2500       end.
     2501   end.
     2502   end.
     2503   define variable v-bgelib-bgeclall           as logical      no-undo.
     2504   define variable v-bgelib-bgedict            as logical      no-undo.
     2505   define temp-table temp_ext-doc-type no-undo
     2506       field edt-key               as integer
     2507       field ext-doc-type          as character
     2508       field ext-doc-type-label    as character
     2509       index pi is primary unique
     2510           edt-key
     2511   .
     2512   define temp-table temp_bgelib_goods no-undo
     2513       field gds-code as integer
     2514       index pi is primary unique
     2515           gds-code
     2516   .
     2517   define temp-table temp_bgelib_clients no-undo
     2518       field obj-type as character
     2519       field obj-code as integer
     2520       index pi is primary unique
     2521           obj-type
     2522           obj-code
     2523   .
     2524   define temp-table temp_bgelib_dis-card no-undo
     2525       field d-card as character
     2526       index pi is primary unique
     2527           d-card
     2528   .
     2529   define temp-table temp_bgelib_trn-doc no-undo
     2530       field doc-code as integer
     2531   .
     2532   procedure bgelib-tag-open:
     2533   do
     2534   on error undo, return error
     2535   :
     2536   define input parameter v-tag-level  as integer      no-undo.
     2537   define input parameter v-tag-name   as character    no-undo.
     2538   define input parameter v-tag-value  as character    no-undo.
     2539       put stream stmXMLOut unformatted
     2540           chr(10)
     2541           + fill(" ", 4 * v-tag-level)
     2542           + "<" + v-tag-name
     2543           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2544           + v-tag-value + ">"
     2545       .
     2546   end.
     2547   end procedure.
     2548   procedure bgelib-tag-put:
     2549   do
     2550   on error undo, return error
     2551   :
     2552   define input parameter v-tag-level      as integer      no-undo.
     2553   define input parameter v-tag-name       as character    no-undo.
     2554   define input parameter v-tag-value      as character    no-undo.
     2555   define input parameter v-empty-mode     as integer      no-undo.
     2556       v-tag-name = trim(v-tag-name).
     2557       if  v-empty-mode = 1
     2558       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2559       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2560       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2561       then do:
     2562           run xmlchar-encode in this-procedure (
     2563                 input v-tag-value
     2564               , output v-tag-value
     2565           ).
     2566           put stream stmXMLOut unformatted
     2567               chr(10) + fill(" ", 4 * v-tag-level)
     2568                           + '<' + v-tag-name + '>'
     2569                           + v-tag-value
     2570                           + '</' + v-tag-name + '>'
     2571           .
     2572       end.
     2573   end.
     2574   end procedure.
     2575   procedure bgelib-tag-close:
     2576   do
     2577   on error undo, return error
     2578   :
     2579   define input parameter v-tag-level as integer      no-undo.
     2580   define input parameter v-tag-name  as character    no-undo.
     2581       put stream stmXMLOut unformatted
     2582           chr(10)
     2583           + fill( " ", 4 * v-tag-level)
     2584           + '</' + v-tag-name + '>'
     2585       .
     2586   end.
     2587   end procedure.
     2588   procedure bgelib-write-log:
     2589   do
     2590   on error undo, return error
     2591   :
     2592   define input parameter v-filename   as character    no-undo.
     2593   define input parameter v-log-level  as integer      no-undo.
     2594   define input parameter v-out-string as character    no-undo.
     2595       output stream stmXMLLog to value( v-filename ) append.
     2596       put stream stmXMLLog unformatted
     2597           chr(10)
     2598       .
     2599       put stream stmXMLLog unformatted
     2600           ( if v-log-level = 0
     2601             or v-out-string = "&DLine"
     2602             or v-out-string = "&Line"
     2603             then ""
     2604             else cur-time-string-sec() + " " )
     2605       .
     2606       put stream stmXMLLog unformatted
     2607           ( if v-out-string = "&Line"
     2608             then fill( "-", 80 )
     2609             else if v-out-string = "&DLine"
     2610                  then fill( "=", 80 )
     2611                  else v-out-string )
     2612       .
     2613       output stream stmXMLLog close.
     2614   end.
     2615   end procedure.
     2616   procedure bgelib-write-edt:
     2617   do
     2618   on error undo, return error
     2619   :
     2620   define input parameter v-editor-handle    as handle       no-undo.
     2621   define input parameter v-log-level        as integer      no-undo.
     2622   define input parameter v-out-string       as character    no-undo.
     2623       if valid-handle ( v-editor-handle )
     2624       then do:
     2625           v-editor-handle :move-to-eof().
     2626           v-editor-handle :insert-string( ( if v-log-level = 0
     2627                                             or v-out-string = "&DLine"
     2628                                             or v-out-string = "&Line"
     2629                                             then ""
     2630                                             else cur-time-string-sec() + " "
     2631                                         ) ).
     2632           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2633                                             then fill( "-", 80 )
     2634                                             else if v-out-string = "&DLine" then fill("=", 80)
     2635                                             else fill( " ", v-log-level) + v-out-string
     2636                                         ) ).
     2637           v-editor-handle :insert-string( chr(10) ).
     2638       end.
     2639       process events.
     2640       output to 'bgescn.txt' append.
     2641           put unformatted
     2642               chr(10)
     2643               string( ( if v-log-level = 0
     2644                         or v-out-string = "&DLine"
     2645                         or v-out-string = "&Line"
     2646                         then ""
     2647                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2648                     ) )
     2649               string( ( if v-out-string = "&Line"
     2650                         then fill( "-", 80 )
     2651                         else if v-out-string = "&DLine"
     2652                              then fill( "=", 80 )
     2653                              else fill( " ", v-log-level ) + v-out-string
     2654                     ) )
     2655           .
     2656       output close.
     2657   end.
     2658   end procedure.
     2659   procedure bgelib-show-cnt:
     2660   do
     2661   on error undo, return error
     2662   :
     2663   define input parameter v-fillin-handle     as handle   no-undo.
     2664       if valid-handle( v-fillin-handle )
     2665       then do:
     2666           assign
     2667               v-fillin-handle :visible = true
     2668           .
     2669       end.
     2670   end.
     2671   end procedure.
     2672   procedure bgelib-hide-cnt:
     2673   do
     2674   on error undo, return error
     2675   :
     2676   define input parameter v-fillin-handle     as handle   no-undo.
     2677       if valid-handle( v-fillin-handle )
     2678       then do:
     2679           assign v-fillin-handle :visible = false.
     2680       end.
     2681   end.
     2682   end procedure.
     2683   procedure bgelib-write-cnt:
     2684   do
     2685   on error undo, return error
     2686   :
     2687   define input parameter v-fillin-handle    as handle       no-undo.
     2688   define input parameter v-fillin-string    as character    no-undo.
     2689       if valid-handle( v-fillin-handle )
     2690       then do:
     2691           assign
     2692               v-fillin-handle :SCREEN-value = v-fillin-string
     2693           .
     2694       end.
     2695   end.
     2696   end procedure.
     2697   procedure bgelib-write-header:
     2698   do
     2699   on error undo, return error
     2700   :
     2701   define input parameter p-first-file     as logical      no-undo.
     2702   define input parameter p-xml-file-name  as character    no-undo.
     2703   define input parameter p-list-file-name as character    no-undo.
     2704   define input parameter p-file-number    as integer      no-undo.
     2705   define input parameter p-have-prev      as logical      no-undo.
     2706   define input parameter p-prev-filename  as character    no-undo.
     2707   define input parameter p-obj-list       as character    no-undo.
     2708   define input parameter p-doc-type-list  as character    no-undo.
     2709   define input parameter p-parameter-list as character    no-undo.
     2710       define variable v-counter    as integer        no-undo.
     2711       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2712       put stream stmXMLOut unformatted
     2713           "<?xml version='1.0' encoding='windows-1251'?>"
     2714       .
     2715       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2716       run bgelib-tag-open( input 0, input "header", input "" ).
     2717       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2718       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2719       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2720       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2721       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2722       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2723       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2724       :
     2725           run bgelib-tag-put(
     2726                 input 1
     2727               , input entry( 2 * v-counter, p-parameter-list )
     2728               , input entry( 2 * v-counter + 1, p-parameter-list )
     2729               , input 0
     2730           ).
     2731       end.
     2732       run bgelib-tag-close( input 0, input "header" ).
     2733       output stream stmXMLOut close.
     2734       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2735       if p-first-file = yes
     2736       then do:
     2737           put stream stmXMLOut unformatted
     2738               "<?xml version='1.0' encoding='windows-1251'?>"
     2739           .
     2740           run bgelib-tag-open( input 0, input "export", input "" ).
     2741       end.
     2742       run bgelib-tag-open( input 1, input "file", input "" ).
     2743       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2744       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2745       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2746       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2747       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2748       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2749       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2750       :
     2751           run bgelib-tag-put(
     2752                 input 2
     2753               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2754               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2755               , input 0
     2756           ).
     2757       end.
     2758       run bgelib-tag-close( input 1, input "file" ).
     2759       output stream stmXMLOut close.
     2760   end.
     2761   end procedure.
     2762   procedure bgelib-write-footer:
     2763   do
     2764   on error undo, return error
     2765   :
     2766   define input parameter p-last-file      as logical      no-undo.
     2767   define input parameter p-xml-file-name  as character    no-undo.
     2768   define input parameter p-list-file-name as character    no-undo.
     2769   define input parameter p-have-next      as logical      no-undo.
     2770   define input parameter p-next-file-name as character    no-undo.
     2771       define variable v-error-num     as integer           no-undo.
     2772       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2773       if p-have-next = yes
     2774       then do:
     2775           run bgelib-tag-open( input 0, input "footer", "" ).
     2776           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2777           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2778           run bgelib-tag-close( input 0, input "footer" ).
     2779       end.
     2780       run bgelib-tag-close( input 0, input "root" ).
     2781       output stream stmXMLOut close.
     2782       run bge/os_copy.p (
     2783             input "M"
     2784           , input p-xml-file-name + "tmp"
     2785           , input p-xml-file-name + "xml"
     2786           , output v-error-num
     2787       ).
     2788       if p-last-file = yes
     2789       then do:
     2790           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2791               run bgelib-tag-close( input 0, input "export" ).
     2792           output stream stmXMLOut close.
     2793           run bge/os_copy.p (
     2794                 input "M"
     2795               , input p-list-file-name + "tmp"
     2796               , input p-list-file-name + "xml"
     2797               , output v-error-num
     2798           ).
     2799       end.
     2800   end.
     2801   end procedure.
     2802   procedure bgelib-filename :
     2803   do
     2804   on error undo, return error
     2805   :
     2806   define input parameter p-prefix             as character    no-undo.
     2807   define output parameter p-xml-file-name     as character    no-undo.
     2808   define output parameter p-log-file-name     as character    no-undo.
     2809   define output parameter p-list-file-name    as character    no-undo.
     2810       define variable v-home-dir  as character    no-undo.
     2811       define variable v-error-num as integer      no-undo.
     2812       get-key-value section "BGE" key "outdir" value v-home-dir.
     2813       if v-home-dir = ?
     2814       then do:
     2815           message
     2816             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2817             skip(1)
     2818             skip "Обратитесь к администратору."
     2819           view-as alert-box error.
     2820           undo, return error .
     2821       end.
     2822       run gbl/dir-cre.p (
     2823           input v-home-dir
     2824       ) no-error.
     2825       if error-status :error
     2826       then do:
     2827           message
     2828             skip "Неверно задан каталог экспорта."
     2829             skip(1)
     2830             skip "Обратитесь к администратору."
     2831           view-as alert-box error.
     2832           undo, return error .
     2833       end.
     2834       run bge/genfname.p (
     2835             input v-home-dir
     2836           , input p-prefix
     2837           , input ""
     2838           , input "xml"
     2839           , input "tmp"
     2840           , output p-xml-file-name
     2841       ).
     2842       assign
     2843           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2844           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2845           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2846       .
     2847   end.
     2848   end procedure.
     2849   procedure bgelib-read-config :
     2850   do
     2851   on error undo, return error
     2852   :
     2853   define variable v-par-type as character     no-undo.
     2854     define variable v-param-type      as character  no-undo .
     2855     define variable v-value-character as character  no-undo .
     2856     define variable v-value-date      as date       no-undo .
     2857     define variable v-value-decimal   as decimal    no-undo .
     2858     define variable v-value-integer   as integer    no-undo .
     2859     define variable v-value-logical   as logical    no-undo .
     2860     define variable v-tth             as handle     no-undo .
     2861       assign
     2862           v-bgelib-bgeclall = no
     2863           v-bgelib-bgedict  = no
     2864       .
     2865       run adm/shattri.p ( input "get":U
     2866                         , input  '':u
     2867                         , input  0
     2868                         , input  'bge-export':U
     2869                         , input  'bgeclall':U
     2870                         , output v-value-character
     2871                         , output v-value-date
     2872                         , output v-value-decimal
     2873                         , output v-value-integer
     2874                         , output v-value-logical
     2875                         , output v-param-type
     2876                         , input-output table-handle v-tth
     2877                         ) no-error .
     2878       if error-status :error
     2879       then do:
     2880         assign
     2881           v-bgelib-bgeclall = no
     2882         .
     2883       end.
     2884       else do:
     2885         assign
     2886           v-bgelib-bgeclall = v-value-logical
     2887         .
     2888       end.
     2889       delete object v-tth.
     2890       run adm/shattri.p ( input "get":U
     2891                         , input  '':u
     2892                         , input  0
     2893                         , input  'bge-export':U
     2894                         , input  'bgedict':U
     2895                         , output v-value-character
     2896                         , output v-value-date
     2897                         , output v-value-decimal
     2898                         , output v-value-integer
     2899                         , output v-value-logical
     2900                         , output v-param-type
     2901                         , input-output table-handle v-tth
     2902                         ) no-error .
     2903       if error-status :error
     2904       then do:
     2905         assign
     2906           v-bgelib-bgedict = no
     2907         .
     2908       end.
     2909       else do:
     2910         assign
     2911           v-bgelib-bgedict = v-value-logical
     2912         .
     2913       end.
     2914       delete object v-tth.
     2915       run adm/shattri.p ( input "get":U
     2916                         , input  '':u
     2917                         , input  0
     2918                         , input  'bge-export':U
     2919                         , input  'bgefmt':U
     2920                         , output v-value-character
     2921                         , output v-value-date
     2922                         , output v-value-decimal
     2923                         , output v-value-integer
     2924                         , output v-value-logical
     2925                         , output v-param-type
     2926                         , input-output table-handle v-tth
     2927                         ) no-error .
     2928       if error-status :error
     2929       then do:
     2930         assign
     2931           v-bgelib-bgefmt  = "xml":U
     2932         .
     2933       end.
     2934       else do:
     2935         assign
     2936           v-bgelib-bgefmt  = v-value-character
     2937         .
     2938       end.
     2939       delete object v-tth.
     2940       run adm/shattri.p ( input "get":U
     2941                         , input  '':u
     2942                         , input  0
     2943                         , input  'bge-export':U
     2944                         , input  'bgeflold':U
     2945                         , output v-value-character
     2946                         , output v-value-date
     2947                         , output v-value-decimal
     2948                         , output v-value-integer
     2949                         , output v-value-logical
     2950                         , output v-param-type
     2951                         , input-output table-handle v-tth
     2952                         ) no-error .
     2953       if error-status :error
     2954       then do:
     2955         assign
     2956           v-bgelib-bgeflold  = "old":U
     2957         .
     2958       end.
     2959       else do:
     2960         assign
     2961           v-bgelib-bgeflold  = v-value-character
     2962         .
     2963       end.
     2964       delete object v-tth.
     2965   end.
     2966   end procedure.
     2967   procedure bgelib-check-file-size :
     2968   do
     2969   on error undo, return error
     2970   :
     2971   define input parameter p-out-filename   as character    no-undo.
     2972   define output parameter p-is-big        as logical      no-undo.
     2973       define variable v-current-position    as integer        no-undo.
     2974       assign
     2975           v-current-position = seek( stmXMLOut )
     2976       .
     2977       if v-current-position / 1024 / 1024  >= 100
     2978       then do:
     2979           assign
     2980               p-is-big = yes
     2981           .
     2982       end.
     2983   end.
     2984   end procedure.
     2985   procedure bgelib-init-ext-doc-type :
     2986       define variable v-counter    as integer      no-undo.
     2987       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2988   do
     2989   for buf_temp_ext-doc-type
     2990   on error undo, return error
     2991   :
     2992       empty temp-table buf_temp_ext-doc-type.
     2993       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2994       :
     2995           create buf_temp_ext-doc-type.
     2996           assign
     2997               buf_temp_ext-doc-type.edt-key               = v-counter
     2998               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2999               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3000           .
     3001       end.
     3002   end.
     3003   end procedure.
     3004   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3005   define variable v-xml-file-name     as character            no-undo.
     3006   define variable v-xml-file-name-path as character            no-undo.
     3007   define variable v-log-file-name     as character            no-undo.
     3008   define variable v-locked            as logical              no-undo.
     3009   define variable v-log-string        as character            no-undo.
     3010   define variable v-oper-num          as integer              no-undo.
     3011   define variable v-obj-list          as character            no-undo.
     3012   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
