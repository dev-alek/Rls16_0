     6315   define variable v-trn-pay-code  as integer   no-undo .
     6316   define variable v-cash-pay-curr as integer   no-undo .
     6317   define variable v-cash-pay-code as integer   no-undo .
     6318   do
     6319   on error undo, return error return-value
     6320   :
     6321   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6322   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6323   if p-fact-order = ? then do:
     6324     run fact-order-mpl (
     6325         input   today       ,
     6326         input   p-obj-type  ,
     6327         input   p-obj-code  ,
     6328         output  p-fact-order ).
     6329   end.
     6330   if p-vid-pay <> "" then do:
     6331      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6332      if available buf_pay-type
     6333         then v-trn-pay-code = buf_pay-type.obj-code.
     6334         else v-trn-pay-code =  0.
     6335   end.
     6336   else v-trn-pay-code = 0 .
     6337   if p-cash-pay-type <> "" then do:
     6338      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6339      if available buf_pay-type
     6340         then
     6341           assign
     6342             v-cash-pay-curr = buf_cash-pay.curr-code
     6343             v-cash-pay-code = buf_cash-pay.cdpay-code
     6344           .
     6345         else
     6346           assign
     6347             v-cash-pay-curr = 0
     6348             v-cash-pay-code = 0
     6349             .
     6350   end.
     6351   else
     6352     assign
     6353       v-cash-pay-curr = 0
     6354       v-cash-pay-code = 0
     6355       .
     6356   for each tt_price-all  : delete tt_price-all . end.
     6357   assign
     6358     p-plt-id             = ?
     6359     p-plt-db-num         = ?
     6360     p-pdf-id             = ?
     6361     p-pdf-db-num         = ?
     6362     p-sale-price-base    = ?
     6363     p-sale-price-rubl    = ?
     6364     v-cli-oborot         = 0
     6365   .
     6366   find first buf_global-state no-lock no-error .
     6367   if not available buf_global-state then do:
     6368      message
     6369        "Не заданы параметры ценообразования!"
     6370        view-as alert-box error
     6371      .
     6372      return error return-value .
     6373   end.
     6374   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6376     (input  p-obj-type
     6377     ,input  p-obj-code
     6378     ,output to-day
     6379     )  .
     6380   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6382     (input  p-obj-type
     6383     ,input  p-obj-code
     6384     ,output v-host-code
     6385     )  .
     6386   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6388     (input  v-host-code
     6389     ,input  to-day
     6390     ,output v-base-rate0
     6391     ,output v-base-scale0
     6392     )  .
     6393     v-cli-oborot-ALL  = 0 .
     6394     for each buf_turnover-buyer-main no-lock  where
     6395              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6396              buf_turnover-buyer-main.cli-code = p-cli-code
     6397              :
     6398              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6399     end.
     6400   for each buf_price-all no-lock where
     6401            buf_price-all.obj-type = p-obj-type and
     6402            buf_price-all.obj-code = p-obj-code and
     6403            buf_price-all.gds-code = buf_goods.gds-code and
     6404            buf_price-all.status_  = 'акт':U  and
     6405          ( p-only-b-code = false   or
     6406          ( buf_price-all.b-code = p-main-b-code or
     6407            buf_price-all.b-code = p-b-code))    and
     6408           ( p-only-b-code = true  or
     6409             buf_price-all.b-code = p-b-code)
     6410             and
     6411             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6412           ( buf_price-all.fact-order-sys-to = ? or
     6413             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6414           :
     6415            v-interv   = "" .
     6416            v-grp-name = "" .
     6417            v-pay-name = "" .
     6418            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6419            if buf_price-all.bgr-id > 0 then do:
     6420               find first buf_buyer-group no-lock where
     6421                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6422                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6423               if available buf_buyer-group then do:
     6424                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6425                  find first buf_buyer-in-buyer-group no-lock where
     6426                             buf_buyer-in-buyer-group.stts         = 0 and
     6427                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6428                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6429                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6430                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6431                             no-error .
     6432                             if not available buf_buyer-in-buyer-group then do:
     6433                                v-grp-name = "".
     6434                                next.
     6435                             end.
     6436                             v-grp-name = buf_buyer-group.name .
     6437                  end.
     6438               end.
     6439               else do:
     6440                    v-grp-name = "".
     6441                    next.
     6442               end.
     6443            end.
     6444            if buf_price-all.tog-id > 0 then do:
     6445               find first buf_turnover-group no-lock where
     6446                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6447                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6448               if available buf_turnover-group then do:
     6449                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6450                     v-cli-oborot = v-cli-oborot-all  .
     6451                     find first buf1_tnv-in-turnover-group no-lock where
     6452                                buf1_tnv-in-turnover-group.stts       =  0     and
     6453                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6454                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6455                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6456                     find first buf2_tnv-in-turnover-group no-lock where
     6457                                buf2_tnv-in-turnover-group.stts       =  0     and
     6458                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6459                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6460                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6461                     if not (available buf1_tnv-in-turnover-group and
     6462                             available buf2_tnv-in-turnover-group ) then do:
     6463                             v-grp-name = "".
     6464                             next .
     6465                     end.
     6466                     v-grp-name = buf_turnover-group.name.
     6467                  end.
     6468               end.
     6469               else do:
     6470                    v-grp-name = "".
     6471                    next.
     6472               end.
     6473            end.
     6474            if buf_price-all.plt-fix-cource-crc-base = true then
     6475               assign
     6476                 v-base-rate  = buf_price-all.pdf-base-rate
     6477                 v-base-scale = buf_price-all.pdf-base-scale
     6478               .
     6479               else
     6480               assign
     6481                 v-base-rate  = v-base-rate0
     6482                 v-base-scale = v-base-scale0
     6483               .
     6484            if buf_price-all.plt-fix-cource-crc-doc = true then
     6485               assign
     6486                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6487                 v-exch-scale = buf_price-all.pdf-exch-scale
     6488               .
     6489               else do:
     6490   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6492     (input  buf_price-all.curr-code
     6493     ,input  to-day
     6494     ,output v-exch-rate0
     6495     ,output v-exch-scale0
     6496     ,output v-curr-abbr
     6497     )  .
     6498               assign
     6499                 v-exch-rate  = v-exch-rate0
     6500                 v-exch-scale = v-exch-scale0
     6501                 .
     6502              end.
     6503              v-date-1 = date ( "" )  .
     6504              if buf_price-all.fact-order-sys-from > 0 then do:
     6505                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6506                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6507                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6508              end.
     6509              v-date-2 =  date ( "" )  .
     6510              if buf_price-all.fact-order-sys-to > 0 then do:
     6511                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6512                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6513                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6514              end.
     6515              if buf_price-all.qnty-from <> ? then do :
     6516                 if not (
     6517                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6518                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6519                 ) then do:
     6520                        v-interv = "".
     6521                        next.
     6522                 end.
     6523                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6524              end.
     6525              if buf_price-all.sum-from <> ? then do :
     6526                 if not (
     6527                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6528                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6529                 ) then do:
     6530                    v-interv = "".
     6531                    next.
     6532                 end.
     6533                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6534              end.
     6535              if buf_price-all.turnover-from <> ? then do :
     6536                 if not (
     6537                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6538                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6539                 ) then do:
     6540                    v-interv = "".
     6541                    next.
     6542                 end.
     6543                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6544              end.
     6545              if buf_price-all.use-pay-type = 1 then do :
     6546                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6547                    v-pay-name = "" .
     6548                    next.
     6549                  end.
     6550                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6551              end.
     6552              if buf_price-all.use-cash-pay = 1 then do :
     6553                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6554                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6555                   v-pay-name = "" .
     6556                   next.
     6557                 end.
     6558                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6559              end.
     6560             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6561             create tt_price-all .
     6562             buffer-copy buf_price-all to tt_price-all
     6563             assign
     6564               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6565               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6566               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6567               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6568               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6569               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6570               tt_price-all.price-sale     = buf_price-all.price-sale
     6571               tt_price-all.road-tax       = buf_price-all.road-tax
     6572               tt_price-all.excise         = buf_price-all.excise
     6573               tt_price-all.pdf-exch-rate   = v-exch-rate
     6574               tt_price-all.pdf-exch-scale  = v-exch-scale
     6575               tt_price-all.pdf-base-rate   = v-base-rate
     6576               tt_price-all.pdf-base-scale  = v-base-scale
     6577               tt_price-all.grp-name        = v-grp-name
     6578               tt_price-all.date-1          = v-date-1
     6579               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6580               tt_price-all.time-1          = buf_price-all.start-sys-time
     6581               tt_price-all.date-2          = v-date-2
     6582               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6583               tt_price-all.time-2          = buf_price-all.end-sys-time
     6584               tt_price-all.interv-name     = v-interv
     6585               tt_price-all.pay-name        = v-pay-name
     6586               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6587             .
     6588   end.
     6589   define variable vt-plt-id as integer   no-undo .
     6590   define variable vt-plt-db as integer   no-undo .
     6591   define variable vt-pdf-id as integer   no-undo .
     6592   define variable vt-pdf-db as integer   no-undo .
     6593   define buffer neos_price-all for tt_price-all  .
     6594   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6595       if available tt_price-all then do:
     6596        assign
     6597          vt-plt-id = tt_price-all.plt-id
     6598          vt-plt-db = tt_price-all.plt-db-num
     6599          vt-pdf-id = tt_price-all.pdf-id
     6600          vt-pdf-db = tt_price-all.pdf-db
     6601        .
     6602        if tt_price-all.b-code = p-b-code then do:
     6603             assign
     6604               p-plt-id           = tt_price-all.plt-id
     6605               p-plt-db-num       = tt_price-all.plt-db-num
     6606               p-pdf-id           = tt_price-all.pdf-id
     6607               p-pdf-db-num       = tt_price-all.pdf-db
     6608               p-sale-price-base  = tt_price-all.price-sale-base
     6609               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6610               p-road-tax-base    = tt_price-all.road-tax-base
     6611               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6612               p-excise-base      = tt_price-all.excise-base
     6613               p-excise-rubl      = tt_price-all.excise-rubl
     6614               .
     6615        end.
     6616        else do:
     6617          find first neos_price-all where
     6618                     neos_price-all.b-code     = p-b-code  and
     6619                     neos_price-all.plt-id     = vt-plt-id and
     6620                     neos_price-all.plt-db-num = vt-plt-db and
     6621                     neos_price-all.pdf-id     = vt-pdf-id and
     6622                     neos_price-all.pdf-db     = vt-pdf-db
     6623                     use-index pi no-error .
     6624            if available neos_price-all then do:
     6625             assign
     6626               p-plt-id           = tt_price-all.plt-id
     6627               p-plt-db-num       = tt_price-all.plt-db-num
     6628               p-pdf-id           = tt_price-all.pdf-id
     6629               p-pdf-db-num       = tt_price-all.pdf-db
     6630               p-sale-price-base  = neos_price-all.price-sale-base
     6631               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6632               p-road-tax-base    = neos_price-all.road-tax-base
     6633               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6634               p-excise-base      = neos_price-all.excise-base
     6635               p-excise-rubl      = neos_price-all.excise-rubl
     6636               .
     6637            end.
     6638            else do:
     6639                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6640                 if error-status :error    then do:
     6641                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6642                   return error return-value .
     6643                 end.
     6644             assign
     6645               p-plt-id           = tt_price-all.plt-id
     6646               p-plt-db-num       = tt_price-all.plt-db-num
     6647               p-pdf-id           = tt_price-all.pdf-id
     6648               p-pdf-db-num       = tt_price-all.pdf-db
     6649               p-sale-price-base  = tt_price-all.price-sale-base
     6650               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6651               p-road-tax-base    = tt_price-all.road-tax-base
     6652               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6653               p-excise-base      = tt_price-all.excise-base
     6654               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6655               .
     6656            end.
     6657        end.
     6658     end.
     6659   end.
     6660   end procedure.
     6661   procedure mpl-tpl-auto :
     6662   define input  parameter p-b-code     as integer   no-undo .
     6663   define input  parameter p-obj-type   as character no-undo .
     6664   define input  parameter p-obj-code   as integer   no-undo .
     6665   define input  parameter p-plt-id     as integer   no-undo .
     6666   define input  parameter p-plt-db-num as integer   no-undo .
     6667   define input  parameter p-fact-order as decimal   no-undo .
     6668   define output parameter p-sale-price as decimal   no-undo .
     6669   define output parameter p-pdf-id     as integer   no-undo .
     6670   define output parameter p-pdf-db-num as integer   no-undo .
     6671     do
     6672     on error undo, return error return-value
     6673     :
     6674   if p-fact-order = ? then do:
     6675     run fact-order-mpl (
     6676         input   today       ,
     6677         input   p-obj-type  ,
     6678         input   p-obj-code  ,
     6679         output  p-fact-order ) .
     6680   end.
     6681   assign
     6682     p-pdf-id      = ?
     6683     p-pdf-db-num  = ?
     6684     p-sale-price  = ?
     6685   .
     6686   define buffer buf_bar-code for ub.bar-code  .
     6687   define buffer buf_goods for ub.goods  .
     6688   find first buf_bar-code no-lock where
     6689              buf_bar-code.b-code = p-b-code
     6690              no-error .
     6691   if error-status :error then return error return-value .
     6692   find first buf_goods no-lock where
     6693              buf_goods.gds-code = buf_bar-code.gds-code
     6694              no-error .
     6695   if error-status :error then return error return-value .
     6696   define variable v-main-b-code as integer   no-undo .
     6697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6698     (input  buf_goods.gds-code
     6699     ,input  ?
     6700     ,output v-main-b-code
     6701     )  .
     6702   define buffer buf_price-all for ub.price-all  .
     6703   for each tt_price-all : delete tt_price-all. end.
     6704       for each buf_price-all no-lock where
     6705               buf_price-all.plt-id     = p-plt-id                 and
     6706               buf_price-all.plt-db-num = p-plt-db-num             and
     6707               buf_price-all.obj-type   = p-obj-type               and
     6708               buf_price-all.obj-code   = p-obj-code               and
     6709               buf_price-all.gds-code   = buf_goods.gds-code       and
     6710             ( buf_price-all.b-code = v-main-b-code or
     6711               buf_price-all.b-code = p-b-code)    and
     6712               buf_price-all.status_    = 'акт':U         and
     6713               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6714             ( buf_price-all.fact-order-sys-to = ? or
     6715               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6716               :
     6717                 create tt_price-all .
     6718                 buffer-copy buf_price-all to tt_price-all
     6719                 assign
     6720                   tt_price-all.price-sale  = buf_price-all.price-sale
     6721                 .
     6722       end.
     6723   define variable vt-plt-id as integer   no-undo .
     6724   define variable vt-plt-db as integer   no-undo .
     6725   define variable vt-pdf-id as integer   no-undo .
     6726   define variable vt-pdf-db as integer   no-undo .
     6727   define buffer neos_price-all for tt_price-all  .
     6728   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6729       if available tt_price-all then do:
     6730        assign
     6731          vt-plt-id = tt_price-all.plt-id
     6732          vt-plt-db = tt_price-all.plt-db-num
     6733          vt-pdf-id = tt_price-all.pdf-id
     6734          vt-pdf-db = tt_price-all.pdf-db
     6735        .
     6736        if tt_price-all.b-code = p-b-code then do:
     6737             assign
     6738               p-plt-id           = tt_price-all.plt-id
     6739               p-plt-db-num       = tt_price-all.plt-db-num
     6740               p-pdf-id           = tt_price-all.pdf-id
     6741               p-pdf-db-num       = tt_price-all.pdf-db
     6742               p-sale-price       = tt_price-all.price-sale
     6743               .
     6744        end.
     6745        else do:
     6746          find first neos_price-all where
     6747                     neos_price-all.b-code     = p-b-code  and
     6748                     neos_price-all.plt-id     = vt-plt-id and
     6749                     neos_price-all.plt-db-num = vt-plt-db and
     6750                     neos_price-all.pdf-id     = vt-pdf-id and
     6751                     neos_price-all.pdf-db     = vt-pdf-db
     6752                     use-index pi no-error .
     6753            if available neos_price-all then do:
     6754             assign
     6755               p-plt-id           = tt_price-all.plt-id
     6756               p-plt-db-num       = tt_price-all.plt-db-num
     6757               p-pdf-id           = tt_price-all.pdf-id
     6758               p-pdf-db-num       = tt_price-all.pdf-db
     6759               p-sale-price       = neos_price-all.price-sale
     6760               .
     6761            end.
     6762            else do:
     6763           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6764           if error-status :error    then do:
     6765              message "Не найден бар-код" p-b-code view-as alert-box error .
     6766              return error return-value .
     6767           end.
     6768             assign
     6769               p-plt-id           = tt_price-all.plt-id
     6770               p-plt-db-num       = tt_price-all.plt-db-num
     6771               p-pdf-id           = tt_price-all.pdf-id
     6772               p-pdf-db-num       = tt_price-all.pdf-db
     6773               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6774               .
     6775            end.
     6776        end.
     6777     end.
     6778     end.
     6779   end procedure.
