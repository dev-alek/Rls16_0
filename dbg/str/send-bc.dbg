     9718     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9719            and buf_goods-attr.attr-code = "IS18Plus"
     9720            and buf_goods-attr.attr-value = "1"
     9721            no-lock no-error.
     9722     if available buf_goods-attr then do:
     9723         run bgelib-tag-put in this-procedure ( input 4, input "IS18Plus", input 1, input 1 ).
     9724     end.
     9725     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9726            and buf_goods-attr.attr-code = "loyalty-gift"
     9727            and buf_goods-attr.attr-value = "1"
     9728            no-lock no-error.
     9729     if available buf_goods-attr then do:
     9730         run bgelib-tag-put in this-procedure ( input 4, input "ItemLoyaltyGift", input 1, input 1 ).
     9731     end.
     9732     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "alcohol-prod" no-lock no-error.
     9733     if available buf_goods-attr then do:
     9734     v-attr-egais = 1.
     9735     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "mark" no-lock no-error.
     9736       if available buf_goods-attr and buf_goods-attr.attr-value = "no" then  do:
     9737         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisNoPDF", input 1, input 1 ).
     9738       end.
     9739       if available buf_goods-attr and buf_goods-attr.attr-value = "yes" then  do:
     9740         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisPDF"      , input 1, input 1 ).
     9741       end.
     9742       if not available buf_goods-attr then do:
     9743         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisNoPDF", input 1, input 1 ).
     9744       end.
     9745     end.
     9746     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9747                                 and buf_goods-attr.attr-code = "time-coock"
     9748                                 and buf_goods-attr.attr-value = "yes" no-lock no-error.
     9749     if available buf_goods-attr then do:
     9750         run bgelib-tag-put in this-procedure ( input 4, input "ISCookStumped", input 1, input 1 ).
     9751     end.
     9752         run bgelib-tag-close in this-procedure ( input 3, input "ItemStatus").
     9753     end.
     9754     if cash-gds.temp-discnt-rule <> 0 then do:
     9755       find first cash-dis-rule no-lock where
     9756                 cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9757       if available cash-dis-rule then do:
     9758         for each buf_cash-dis-rule no-lock where
     9759                 (cash-dis-rule.is-term = yes
     9760                 and buf_cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     9761               or
     9762               buf_cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule,
     9763           first cash-dis-time-rule no-lock where
     9764                     cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num:
     9765           if buf_cash-dis-rule.is-term
     9766           and buf_cash-dis-rule.root then do:
     9767           end.
     9768           else do:
     9769             case buf_cash-dis-rule.value-type:
     9770               when integer('1':U) then do:
     9771                 assign
     9772                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
     9773                 .
     9774               end.
     9775               when integer('11':U) then do:
     9776                 find first cash-gds-discnt where
     9777                           cash-gds-discnt.b-code = cash-gds.b-code
     9778                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
     9779                       and cash-gds-discnt.obj-type = 'маг':U
     9780                       and cash-gds-discnt.obj-code = i-obj-code
     9781                       no-error.
     9782                 if available cash-gds-discnt then do:
     9783                   assign
     9784                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
     9785                   .
     9786                 end.
     9787                 else do:
     9788                   assign
     9789                   temp-disc-dec = 0.
     9790                 end.
     9791               end.
     9792               otherwise do:
     9793                 temp-disc-dec = 0.
     9794               end.
     9795             end case.
     9796           end.
     9797           assign
     9798           temp-disc-reason = 0
     9799           temp-disc-weekday = 0
     9800           no-error
     9801           .
     9802           assign
     9803           temp-disc-start = cash-dis-time-rule.date-from
     9804           temp-disc-end   = cash-dis-time-rule.date-to
     9805           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
     9806           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
     9807           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
     9808                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
     9809                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
     9810                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
     9811                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
     9812                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
     9813                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
     9814           .
     9815           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
     9816           assign
     9817           temp-disc-dec = 0
     9818           temp-disc-reason = 0
     9819           temp-disc-weekday = 0
     9820           temp-disc-time-start = 0
     9821           temp-disc-time-end = 0
     9822           temp-disc-start = 12/31/1989
     9823           temp-disc-end = 12/31/9999
     9824           .
     9825           run bgelib-tag-open in this-procedure ( input 3, input "ItemTimeDisc", input "" ).
     9826           run bgelib-tag-put in this-procedure ( input 4, input "ITDEvery"     , input string(temp-disc-weekday), input 1 ).
     9827           run bgelib-tag-put in this-procedure ( input 4, input "ITDValue" , input string(temp-disc-dec), input 1 ).
     9828           if temp-disc-start <> ? then
     9829           run bgelib-tag-put in this-procedure ( input 4, input "ITDBeg" , input Xml-CD-DateTimetoString(temp-disc-start, temp-disc-time-start), input 1 ).
     9830           if temp-disc-end <> ? then
     9831           run bgelib-tag-put in this-procedure ( input 4, input "ITDEnd" , input Xml-CD-DateTimetoString(temp-disc-end, temp-disc-time-end), input 1 ).
     9832           run bgelib-tag-put in this-procedure ( input 4, input "ITDReason" , input string(temp-disc-reason), input 1 ).
     9833           run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
     9834         end.
     9835       end.
     9836     end.
     9837     else do:
     9838         run bgelib-tag-open in this-procedure ( input 3, input "ItemTimeDisc", input "" ).
     9839         run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
     9840     end.
     9841     if cash-gds.qnty-discnt-rule <> 0 then do:
     9842       for each cash-dis-rule no-lock where
     9843               cash-dis-rule.upper-rule-num = cash-gds.qnty-discnt-rule
     9844         :
     9845         run bgelib-tag-open in this-procedure ( input 3, input "ItemQtyDisc", input "" ).
     9846         run bgelib-tag-put in this-procedure ( input 4, input "IQty", input string(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate), input 1 ).
     9847         run bgelib-tag-put in this-procedure ( input 4, input "IQPercent" , input string(- cash-dis-rule.discnt-value),  input 1 ).
     9848         if v-version-dec >= 1.09 then do:
     9849             run bgelib-tag-put in this-procedure ( input 4, input "IQType"
     9850                                                 , input string(if cash-dis-rule.value-type = integer('2':U)
     9851                                                                 then 1
     9852                                                                 else 0)
     9853                                                   , input 1 ).
     9854             run bgelib-tag-put in this-procedure ( input 4, input "IQPayRestriction"
     9855                                                  , input string(if cash-dis-rule.templ-rl-root = 73
     9856                                                                 or cash-dis-rule.templ-rl-root = 74
     9857                                                                 then cash-dis-rule.key#_one
     9858                                                                 else 0
     9859                                                                 ),  input 1 ).
     9860         end.
     9861         run bgelib-tag-close in this-procedure ( input 3, input "ItemQtyDisc").
     9862       end.
     9863     end.
     9864     else do:
     9865       run bgelib-tag-open in this-procedure ( input 3, input "ItemQtyDisc", input "" ).
     9866       run bgelib-tag-close in this-procedure ( input 3, input "ItemQtyDisc").
     9867     end.
     9868     if cash-gds.kat-discnt-rule <> 0  then do:
     9869       for each cash-dis-rule no-lock where
     9870               cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule   :
     9871         run bgelib-tag-open in this-procedure ( input 3, input "ItemDisCat", input "" ).
     9872         run bgelib-tag-put in this-procedure ( input 4, input "IDCCat" ,  input string(cash-dis-rule.dis-kat), input 1 ).
     9873         if cash-dis-rule.templ-rl-root = 34 then do:
     9874           run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(5), input 1 ).
     9875           run bgelib-tag-put in this-procedure ( input 4, input "IDCLimit", input string(- cash-dis-rule.discnt-value),  input 1 ).
     9876           run bgelib-tag-put in this-procedure ( input 4, input "IDCFactor", input string(cash-dis-rule.tot-sum),  input 1 ).
     9877         end.
     9878         else do:
     9879           case cash-dis-rule.value-type:
     9880             when integer('2':U) then do:
     9881               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(2), input 1 ).
     9882               run bgelib-tag-put in this-procedure ( input 4, input "IDCValue", input string(- cash-dis-rule.discnt-value * cash-gds.cli-base-rate),  input 1 ).
     9883             end.
     9884             when integer('1':U) then do:
     9885               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(1), input 1 ).
     9886               run bgelib-tag-put in this-procedure ( input 4, input "IDCPercent", input string(- cash-dis-rule.discnt-value),  input 1 ).
     9887             end.
     9888             when integer('3':U) then do:
     9889               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
     9890               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(cash-dis-rule.discnt-value),  input 1 ).
     9891             end.
     9892             when integer('12':U) then do:
     9893               find first cash-gds-discnt where
     9894                         cash-gds-discnt.b-code = cash-gds.b-code
     9895                     and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9896                   and cash-gds-discnt.obj-type = 'маг':U
     9897                   and cash-gds-discnt.obj-code = i-obj-code
     9898                     no-error.
     9899               if available cash-gds-discnt then do:
     9900                 assign
     9901                 v-kat-discnt = cash-gds-discnt.discnt-value
     9902                 .
     9903               end.
     9904               else do:
     9905                 v-kat-discnt = cash-gds.price-sale.
     9906               end.
     9907               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
     9908               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(v-kat-discnt),  input 1 ).
     9909             end.
     9910           end case.
     9911         end.
     9912         run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
     9913       end.
     9914     end.
     9915     else do:
     9916       run bgelib-tag-open in this-procedure ( input 3, input "ItemDisCat", input "" ).
     9917       run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
     9918     end.
     9919   if pos-type <> 'InfoKiosk':U then do:
     9920         if tax-cass
     9921         AND vaction = "U" then do:
     9922           do i-entry = 1 to num-entries(cash-gds.tax-string, chr(32)):
     9923             if entry(i-entry, cash-gds.tax-string, chr(32)) <> "":U then do:
     9924               run bgelib-tag-open in this-procedure ( input 3, input "ItemTax", input "" ).
     9925               run bgelib-tag-put in this-procedure ( input 4, input "ITCode"  , input entry(i-entry, cash-gds.tax-string, chr(32)), input 1 ).
     9926               run bgelib-tag-close in this-procedure ( input 3, input "ItemTax").
     9927             end.
     9928           end.
     9929         end.
     9930       end.
     9931   end.
     9932   run gds-attr-value in this-procedure (
     9933                                    input cash-gds.gds-code
     9934                                   ,input 'emrc-type':U
     9935                                   ,output v-attr-emrc
     9936                                   ,output v-attr-type) no-error.
     9937   run bgelib-tag-put in this-procedure ( input 3, input "Item_EMRC"  , input v-attr-emrc , input 1 ).
     9938   vGdsTabak = if vaction = "D" then yes else no.
     9939   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9940                 and buf_goods-attr.attr-code  = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" no-error .
     9941       if available (buf_goods-attr)
     9942          and MarkType:GetKeyIntDB(buf_goods-attr.attr-value) > 0
     9943       then do:
     9944         run bgelib-tag-put in this-procedure ( input 3, input "ItemDataMatrixType"  , input string(MarkType:GetKeyIntDB(buf_goods-attr.attr-value)) , input 1 ).
     9945         v-mark = yes .
     9946         if buf_goods-attr.attr-value eq MarkType:tabak:NameProp
     9947         then do:
     9948            vGdsTabak = yes.
     9949         end.
     9950       end.
     9951       else do:
     9952         run bgelib-tag-put in this-procedure ( input 3, input "ItemDataMatrixType"  , input "0", input 1 ).
     9953       end.
     9954       find FIRST buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "gds-CommodityCode" no-error.
     9955       if available buf_goods-attr then
     9956       do:
     9957         run bgelib-tag-put in this-procedure ( input 4, input "ItemCommodityCode" , input string( buf_goods-attr.attr-value), input 1 ).
     9958       end.
     9959   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9960                 and buf_goods-attr.attr-code  = 'oper-serv-idd':U no-error.
     9961     if available buf_goods-attr then do:
     9962               run bgelib-tag-put in this-procedure ( input 3, input "ItemOSPayAgent"  , input string(buf_goods-attr.attr-value), input 1 ).
     9963     end.
     9964     else do:
     9965               run bgelib-tag-put in this-procedure ( input 3, input "ItemOSPayAgent"  , input "0", input 1 ).
     9966     end.
     9967   run bgelib-tag-close in this-procedure ( input 2, input "Item").
     9968     if v-attr-egais = 1 then do:
     9969           run bgelib-tag-open in this-procedure ( input 2, input "ItemMarkCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     9970                                             ,"ADD":U, OS2-time,cash-gds.b-code)).
     9971           find first buf_alc-type-gds where buf_alc-type-gds.gds-code = cash-gds.gds-code no-lock no-error.
     9972           find first buf_alc-type where buf_alc-type.alc-type-inner-code = buf_alc-type-gds.alc-type-inner-code no-lock no-error.
     9973           if available buf_alc-type then do:
     9974             run bgelib-tag-put in this-procedure ( input 3, input "IMarkCode" , input string(buf_alc-type.alc-type-code), input 1 ).
     9975           end.
     9976           find first bb_goods where bb_goods.gds-code = cash-gds.gds-code no-lock no-error .
     9977           run bgelib-tag-put in this-procedure ( input 3, input "IMarkVolume" , input string(bb_goods.ms-base), input 1 ).
     9978           run bgelib-tag-put in this-procedure ( input 3, input "IMarkQnty" , input string(cash-gds.cli-base-rate), input 1 ).
     9979           run bgelib-tag-put in this-procedure ( input 3, input "IMarkAlc" ,    input string(bb_goods.proof), input 1 ).
     9980           run bgelib-tag-close in this-procedure ( input 2, input "ItemMarkCode").
     9981       end.
     9982   for each buf_cash-gds no-lock where
     9983             buf_cash-gds.b-code = cash-gds.b-code
     9984         AND buf_cash-gds.obj-type = 'маг':U
     9985         AND buf_cash-gds.obj-code = abs(i-obj-code)
     9986             :
     9987      if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0 and buf_cash-gds.b-str = "" and ub.shop.cd-sc-base  then NEXT.
     9988      if (ub.shop.cd-loc-base = no and buf_cash-gds.is-main-code = yes) then next.
     9989      v-IBCType = 0 .
     9990      if v-mark then do:
     9991          find first buf_prod-bc no-lock where buf_prod-bc.b-code = buf_cash-gds.b-code and buf_prod-bc.bc-on-type = 'GTIN':U
     9992                                           and buf_prod-bc.b-str = buf_cash-gds.b-str no-error .
     9993          if available (buf_prod-bc) then do:
     9994          v-IBCType = 2 .
     9995          end.
     9996          else do:
     9997          find first buf_prod-bc-attr no-lock where buf_prod-bc-attr.b-code = buf_cash-gds.b-code
     9998                                 and buf_prod-bc-attr.b-str = buf_cash-gds.b-str
     9999                                 and buf_prod-bc-attr.attr-code = 'mark':U
    10000                                 no-error .
    10001          if available (buf_prod-bc-attr) and buf_prod-bc-attr.attr-value = "yes" then
    10002            v-IBCType = 1 .
    10003        end.
    10004      end.
    10005     if v-mark and buf_cash-gds.b-str = "" then v-IBCType = 1 .
    10006     find first ub.prod-bc no-lock where ub.prod-bc.b-str = buf_cash-gds.b-str and ub.prod-bc.b-str <> "" and ub.prod-bc.bc-on-type = 'GTIN':U
    10007     no-error .
    10008     define variable vBarCode1 as int no-undo.
    10009     define variable vBarCode2 as int no-undo.
    10010     if available (ub.prod-bc) then do:
    10011       if cash-gds.cli-base-rate eq 1
    10012       then do:
    10013          v-i-cli-qnty = 999999999.
    10014          for each buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    10015                                     and buf_bar-code_cl.cli-base-rate ne cash-gds.cli-base-rate
    10016          no-lock:
    10017            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    10018            if v-i-cli-qnty =  buf_bar-code_cl.cli-base-rate
    10019            then
    10020               vBarCode1 = buf_bar-code_cl.b-code.
    10021          end.
    10022          if vaction = "D" and
    10023             v-i-cli-qnty = 999999999
    10024          then do:
    10025             assign
    10026                v-i-cli-qnty = cash-gds.cli-base-rate
    10027                vBarCode1 = cash-gds.main-prt-b-code
    10028                .
    10029          end.
    10030       end.
    10031       else do:
    10032          v-i-cli-qnty = 999999999.
    10033          for first buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    10034                                     and buf_bar-code_cl.cli-base-rate eq 1
    10035          no-lock:
    10036            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    10037            vBarCode2 = buf_bar-code_cl.b-code.
    10038          end.
    10039          if vaction = "D" and
    10040             v-i-cli-qnty = 999999999
    10041          then do:
    10042             assign
    10043                v-i-cli-qnty = cash-gds.cli-base-rate
    10044                vBarCode2 = cash-gds.main-prt-b-code
    10045                .
    10046          end.
    10047       end.
    10048       if vGdsTabak then do:
    10049          block-cli:
    10050          do v-i-cli = 1 to 2:
    10051            if (      v-i-cli-qnty eq 999999999
    10052                  and v-i-cli eq 2
    10053                  and cash-gds.cli-base-rate eq 1  )
    10054               or (   v-i-cli-qnty eq 999999999
    10055                  and v-i-cli eq 1
    10056                  and cash-gds.cli-base-rate ne 1  )
    10057            then
    10058               next block-cli.
    10059            v-cli-base = string (v-i-cli,"99").
    10060            run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    10061                                                , (if vaction = "U"
    10062                                                   then (if buf_cash-gds.bc-on eq yes then "ADD":U else "DEL":U)
    10063                                                   else "DEL":U)
    10064                                                 , OS2-time
    10065                                                , string(v-cli-base + buf_cash-gds.b-str))).
    10066            run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
    10067                                                 , input string( if v-i-cli eq 1 and cash-gds.cli-base-rate ne 1
    10068                                                                  then vBarCode2
    10069                                                                  else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
    10070                                                                  then vBarCode1
    10071                                                                  else cash-gds.main-prt-b-code )
    10072                                                 , input 1 ).
    10073            if vaction = 'U':U then do:
    10074              run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
    10075                                                  , input string(cash-gds.producer-int), input 1 ).
    10076              run bgelib-tag-put in this-procedure ( input 3, input "IBCIngredient"
    10077                                                  , input trim(string( cash-gds.ingredient, "X(40)")), input 1 ).
    10078              if cash-gds.gtd <> "":U then
    10079              run bgelib-tag-put in this-procedure ( input 3, input "IBCGTD"
    10080                                                  , input trim(string( cash-gds.gtd, "X(40)")), input 1 ).
    10081              find first country no-lock where country.alpha1 = cash-gds.alpha1 no-error.
    10082              if available country then
    10083              run bgelib-tag-put in this-procedure ( input 3, input "IBCCountry"
    10084                                                  , input country.short-name, input 1 ).
    10085              run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
    10086                                                   , input string( if v-i-cli eq 1 and cash-gds.cli-base-rate ne 1
    10087                                                       then cash-gds.price-sale / cash-gds.cli-base-rate
    10088                                                       else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
    10089                                                            then cash-gds.price-sale * v-i-cli-qnty
    10090                                                            else cash-gds.price-sale )
