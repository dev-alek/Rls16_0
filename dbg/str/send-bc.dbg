    12054          if ncr-save-param <> 'no':U then do:                                                     if search(v-kat-file-save) <> ? then do:                                               input stream bar from value(v-kat-file-save) convert source "ibm866" .                 repeat:                                                                                  import stream bar unformatted ss.                                                      find first cash-ncr-save-param where                                                            cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat                                 AND cash-ncr-save-param.cd-line = substring(ss, 1, 24) no-error.                  if not available cash-ncr-save-param then do:                                            create cash-ncr-save-param.                                                            assign                                                                                 cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat                                     cash-ncr-save-param.cd-line = substring(ss, 1, 24)                                     cash-ncr-save-param.cd-other = substring(ss, 25)                                       .                                                                                    end.                                                                                 end.                                                                                   input stream bar close .                                                               end.                                                                                   else do:                                                                               end.                                                                                 end.
    12055         end.
    12056         input stream bar from value(v-kat-file) convert source "ibm866" .
    12057         assign
    12058         ss0 = ''
    12059         ss = '':U
    12060         v-cd-subject-code = '':U
    12061         v-cd-disc-string  = '':U
    12062         v-next = no
    12063         v-updated-subject-dis-kat = no
    12064         .
    12065         output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    12066         _rr2:
    12067         repeat:
    12068           import stream bar unformatted ss.
    12069           assign
    12070           v-next = no
    12071           v-updated-subject-dis-kat = no
    12072           v-cd-subject-code = substring(ss, 1, 16)
    12073           v-cd-disc-string =  substring(ss, 17, 7)
    12074           .
    12075           if not ss begins fill(chr(32), 2 )
    12076           then do:
    12077             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
    12078               put stream plucash unformatted
    12079               ss skip.
    12080               ss0 = v-cd-subject-code.
    12081               NEXT _rr2.
    12082             end.
    12083             v-next = yes.
    12084           end.
    12085           _for_rr2:
    12086           for each  buf_cash-ncr-dis-kat no-lock where
    12087                     buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12088                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    12089                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    12090                 and crf <= cr-ncr-dis-kat
    12091           by buf_cash-ncr-dis-kat.cd-subject-code
    12092           by buf_cash-ncr-dis-kat.cd-disc-string
    12093           :
    12094             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12095             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    12096               leave  _for_rr2.
    12097             end.
    12098             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    12099               v-updated-subject-dis-kat = yes.
    12100             end.
    12101             find first  cash-ncr-save-param no-lock where
    12102                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    12103                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    12104                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    12105             if available cash-ncr-save-param then do:
    12106               put stream plucash unformatted
    12107               cash-ncr-save-param.cd-line
    12108               cash-ncr-save-param.cd-other
    12109               skip.
    12110               v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7)
    12111                                  .
    12112               NEXT _for_rr2.
    12113             end.
    12114             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    12115           end.
    12116           if v-next then do:
    12117             ss0 = v-cd-subject-code.
    12118             put stream plucash unformatted
    12119             ss skip.
    12120             NEXT _rr2.
    12121           end.
    12122           if not v-updated-subject-dis-kat then do:
    12123             find first buf_cash-ncr-dis-kat no-lock where
    12124                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12125                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
    12126             if not available buf_cash-ncr-dis-kat then do:
    12127               put stream plucash unformatted
    12128               ss skip.
    12129             end.
    12130           end.
    12131           ss0 = v-cd-subject-code.
    12132         end.
    12133         input stream bar close.
    12134         _for_rr3:
    12135         for each  buf_cash-ncr-dis-kat no-lock where
    12136                   buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12137               AND buf_cash-ncr-dis-kat.cd-subject-code >= v-cd-subject-code
    12138               and crf <= cr-ncr-dis-kat
    12139         by buf_cash-ncr-dis-kat.cd-subject-code
    12140         by buf_cash-ncr-dis-kat.cd-disc-string
    12141         :
    12142             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12143             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) <= v-cd-disc-string then do:
    12144               next  _for_rr3.
