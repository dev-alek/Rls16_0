     1481   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1483   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1484   procedure disrules-fill-properties:
     1485   define input  parameter p-templ-rl-root as integer   no-undo .
     1486   define buffer buf_drt-prop for ub.drt-prop.
     1487   define buffer buf_temp-drt-prop for temp-drt-prop.
     1488   do
     1489   on error undo, return error return-value
     1490   :
     1491     for each buf_temp-drt-prop:
     1492       delete buf_temp-drt-prop.
     1493     end.
     1494     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1495       create buf_temp-drt-prop.
     1496       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1497     end.
     1498   end.
     1499   end procedure.
     1500   ~
     1501   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   procedure discfgru-check :
     1503   define input parameter p-table-name as character no-undo .
     1504   define input parameter p-templ-rl-root as integer no-undo .
     1505   define input parameter p-time-templ-rl-root as integer no-undo .
     1506   define input parameter p-pos-type as character no-undo .
     1507   define output parameter p-disnct-role as character no-undo .
     1508   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       find first buf_dis-cfg-rule no-lock where
     1513               buf_dis-cfg-rule.table-name = p-table-name
     1514           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1515           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1516           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1517       if not available buf_dis-cfg-rule
     1518       or p-pos-type = "":U
     1519       then do:
     1520          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1521                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1522                                  , p-templ-rl-root
     1523                                  , (if p-time-templ-rl-root = ?
     1524                                     then '':U
     1525                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1526                                     )
     1527                                  ).
     1528       end.
     1529       assign
     1530       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1531       .
     1532     end.
     1533   end procedure.
     1534   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   FUNCTION get-region RETURNS CHARACTER
     1536     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1537     define variable par-region as character no-undo.
     1538     if parhost-code = 0 and
     1539          parobj-type = "":U and
     1540          parobj-code = 0 then do:
     1541          par-region = "Глобально".
     1542          return par-region.
     1543       end.
     1544       if parobj-type = 'орг':U then do:
     1545          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1546          return par-region.
     1547       end.
     1548       if parobj-type = 'регион':U
     1549       then do:
     1550          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1551          return par-region.
     1552       end.
     1553       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1554       return par-region.
     1555   END FUNCTION.
     1556   FUNCTION get-objregion RETURNS CHARACTER
     1557     (  input parobj-type as character, input parobj-code as integer ) :
     1558     define variable par-region as character no-undo.
     1559     if  parobj-type = "":U and
     1560         parobj-code = 0
     1561     then do:
     1562        par-region = "Глобально".
     1563     end.
     1564     else if parobj-type = 'орг':U
     1565     then do:
     1566        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1567     end.
     1568     else if parobj-type = 'регион':U
     1569     then do:
     1570        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1571     end.
     1572     else
     1573        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1574     return par-region.
     1575   END FUNCTION.
     1576   procedure disgdsru-name :
     1577   define buffer buf_dis-rule for ub.dis-rule.
     1578   do
     1579     on error undo, return error
     1580     :
     1581     define input  parameter p-templ-rl-root  as integer no-undo .
     1582     define output parameter p-label          as character no-undo .
     1583     find first buf_dis-rule no-lock where
     1584               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1585     if available buf_dis-rule
     1586     then do:
     1587       if buf_dis-rule.rule-num > 0 then
     1588       p-label = buf_dis-rule.des.
     1589     end.
     1590     else do:
     1591       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1592     end.
     1593   end.
     1594   end procedure.
     1595   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1596   define variable v-rule-label as character no-undo .
     1597   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1598                                        ,output v-rule-label) no-error.
     1599   return v-rule-label.
     1600   end function.
     1601   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1602   define variable v-rule-label as character no-undo .
     1603   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1604   end function.
     1605   procedure disgdsru-write :
     1606     do
     1607     on error undo, return error
     1608     :
     1609       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1610       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1611       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1612       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1613       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1614       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1615       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1616       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1617       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1618       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1619       define buffer buf_dis-rule for ub.dis-rule.
     1620       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1621       define variable v-label          as character no-undo .
     1622       define variable v-discnt-role as character no-undo .
     1623       run discfgru-check in this-procedure (
     1624                                             input 'dis-gds-rule':U
     1625                                            ,input p-templ-rl-root
     1626                                            ,input p-time-templ-rl-root
     1627                                            ,input p-pos-type
     1628                                            ,output v-discnt-role
     1629                                             ) no-error .
     1630       if error-status :error then do:
     1631         undo, return error return-value .
     1632       end.
     1633       if p-discnt-role = ? then do:
     1634         p-discnt-role = v-discnt-role.
     1635       end.
     1636       if p-discnt-role <> v-discnt-role then do:
     1637         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1638                                 ,p-gds-code
     1639                                 ,p-obj-type
     1640                                 ,p-obj-code
     1641                                 ,p-pos-type
     1642                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1643                                 ,chr(10)
     1644                                 ,p-templ-rl-root
     1645                                 ,p-rule-num).
     1646       end.
     1647       if p-pos-type = ? then do:
     1648   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   define variable v-param-type22 as character no-undo .
     1650   define variable v-value-date22 as date no-undo .
     1651   define variable v-value-decimal22 as decimal no-undo .
     1652   define variable v-value-integer22 as INTEGER no-undo .
     1653   define variable v-value-logical22 AS LOGICAL no-undo .
     1654   define variable v-tth22 as handle no-undo .
     1655   run adm/shattri.p (
     1656       input "get":U
     1657       ,input  p-obj-type
     1658       ,input  p-obj-code
     1659       ,input  'cd-sending':U
     1660       ,input  'dflt-cd':U
     1661       ,output p-pos-type
     1662       ,output v-value-date22
     1663       ,output v-value-decimal22
     1664       ,output v-value-integer22
     1665       ,output v-value-logical22
     1666       ,output v-param-type22
     1667       ,INPUT-OUTPUT table-handle v-tth22
     1668       )  .
     1669   delete object v-tth22 no-error.
     1670       end.
     1671       find first buf_dis-rule no-lock where
     1672                 buf_dis-rule.rule-num = p-rule-num no-error.
     1673       if not available buf_Dis-rule then do:
     1674         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1675                                 ,p-gds-code
     1676                                 ,p-obj-type
     1677                                 ,p-obj-code
     1678                                 ,p-pos-type
     1679                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1680                                 ,chr(10)
     1681                                 ,p-rule-num).
     1682       end.
     1683       if buf_dis-rule.root <> yes then do:
     1684         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1685                                 ,p-gds-code
     1686                                 ,p-obj-type
     1687                                 ,p-obj-code
     1688                                 ,p-pos-type
     1689                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1690                                 ,chr(10)
     1691                                 ,p-rule-num).
     1692       end.
     1693       if not (p-obj-type = buf_dis-rule.obj-type
     1694           and p-obj-code = buf_dis-rule.obj-code)
     1695       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1696                and
     1697                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1698        then do:
     1699         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1700                                 ,p-gds-code
     1701                                 ,p-obj-type
     1702                                 ,p-obj-code
     1703                                 ,p-pos-type
     1704                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1705                                 ,chr(10)
     1706                                 ) +
     1707                             substitute("Правило скидки &1 определено для &2&3" +
     1708                                        "а привязка к товару для &4"
     1709                                        ,buf_dis-rule.rule-num
     1710                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1711                                        ,chr(10)
     1712                                        ,get-objregion( p-obj-type, p-obj-code)
     1713                                        ))
     1714                                 .
     1715       end.
     1716       find first buf_dis-gds-rule exclusive-lock where
     1717                  buf_dis-gds-rule.gds-code  = p-gds-code
     1718              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1719              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1720              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1721              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1722              and buf_dis-gds-rule.nonunique = p-nonunique
     1723              no-error .
     1724       if not available buf_dis-gds-rule then do:
     1725         find first buf_dis-gds-rule exclusive-lock where
     1726                   buf_dis-gds-rule.gds-code  = p-gds-code
     1727               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1728               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1729               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1730               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1731               no-error .
     1732         if available buf_Dis-gds-rule then do:
     1733           if p-nonunique = ''
     1734           and available buf_dis-gds-rule
     1735           then do:
     1736             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1737                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1738                                      , p-gds-code
     1739                                      , buf_Dis-rule.obj-type
     1740                                      , buf_Dis-rule.obj-code
     1741                                      , p-nonunique
     1742                                     ).
     1743           end.
     1744           if available buf_dis-gds-rule
     1745           and buf_dis-gds-rule.nonunique = ''
     1746           and p-nonunique <> ''then do:
     1747             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1748                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1749                                      , p-gds-code
     1750                                      , buf_Dis-rule.obj-type
     1751                                      , buf_Dis-rule.obj-code
     1752                                     ).
     1753           end.
     1754         end.
     1755         create buf_dis-gds-rule .
     1756         assign
     1757         buf_dis-gds-rule.gds-code  = p-gds-code
     1758         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1759         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1760         buf_dis-gds-rule.pos-type = p-pos-type
     1761         buf_dis-gds-rule.discnt-role = v-discnt-role
     1762         buf_dis-gds-rule.rule-num = p-rule-num
     1763         buf_dis-gds-rule.nonunique = p-nonunique
     1764         no-error
     1765         .
     1766       end.
     1767       ASSIGN
     1768       buf_dis-gds-rule.rule-num = p-rule-num
     1769       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1770       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1771       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1772       buf_dis-gds-rule.nonunique = p-nonunique
     1773       no-error.
     1774     end.
     1775   end procedure.
     1776   PROCEDURE cmp-disgdsru-write :
     1777   do
     1778   on error undo, return error
     1779   :
     1780     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1781     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1782     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1783     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1784     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1785     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1786     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1787     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1788     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1789     define variable v-rule-label          as character no-undo .
     1790     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1791     define buffer buf_dis-rule     for ub.dis-rule.
     1792     run disgdsru-name in this-procedure (
     1793                                         input  p-templ-rl-root
     1794                                         ,output v-rule-label
     1795                                         ) no-error .
     1796     if error-status :error then do:
     1797       undo, return error return-value .
     1798     end.
     1799     find first buf_tt0-dis-gds-rule exclusive-lock where
     1800                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1801             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1802             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1803             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1804             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1805             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1806             no-error .
     1807     if not available buf_tt0-dis-gds-rule then do:
     1808       create buf_tt0-dis-gds-rule .
     1809       assign
     1810       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1811       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1812       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1813       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1814       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1815       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1816       no-error
     1817       .
     1818     end.
     1819     find first buf_dis-rule no-lock where
     1820               buf_dis-rule.rule-num = p-rule-num.
     1821     ASSIGN
     1822     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1823     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1824     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1825     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1826     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1827     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1828     no-error.
     1829     release buf_tt0-dis-gds-rule no-error .
     1830     if error-status:error then do:
     1831       undo, return error return-value .
     1832     end.
     1833   end.
     1834   END PROCEDURE.
     1835   define variable vss-include-info23 as character format "X(65)" no-undo
     1836   initial "@(#)$Workfile$ $Revision$".
     1837   define variable v-bgelib-bgefmt        as character         no-undo.
     1838   define variable v-bgelib-bgeflold      as character         no-undo.
     1839   define stream stmXMLOut.
     1840   define stream stmXMLLog.
     1841   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1842   procedure cur-time :
     1843      define output parameter p-today as date      no-undo .
     1844      define output parameter p-time  as integer   no-undo .
     1845     do
     1846     on error undo, return error
     1847     :
     1848       define variable v-date1 as date      no-undo .
     1849       define variable v-date2 as date      no-undo .
     1850       define variable v-time  as integer   no-undo .
     1851       assign
     1852         v-date1 = today
     1853         v-time  = time
     1854         v-date2 = today
     1855       .
     1856       if v-date1 <> v-date2
     1857       then do:
     1858         assign
     1859           v-date1 = today
     1860           v-time  = v-time
     1861         .
     1862       end.
     1863       assign
     1864         p-today = v-date1
     1865         p-time  = v-time
     1866       .
     1867     end.
     1868   end.
     1869   function cur-time-date returns character
     1870   :
     1871     return string(today, '99/99/9999':U) .
     1872   end.
     1873   function cur-time-mjd returns decimal
     1874   :
     1875     define variable v-date as date      no-undo .
     1876     define variable v-time as integer   no-undo .
     1877     run cur-time in this-procedure
     1878       (output v-date
     1879       ,output v-time
     1880       ) .
     1881     return integer(v-date) - 2400002 + (v-time / 86400) .
     1882   end.
     1883   function cur-time-get-ending-index returns integer
     1884   (input p-number as integer
     1885   )
     1886   :
     1887     if p-number < 0
     1888     or p-number = ?
     1889     then do:
     1890       return 1 .
     1891     end.
     1892     define variable v-rest as integer   no-undo .
     1893     assign
     1894       p-number = p-number modulo 100
     1895     .
     1896     if p-number < 20
     1897     then do:
     1898       assign
     1899         v-rest = p-number
     1900       .
     1901     end.
     1902     else do:
     1903       assign
     1904         v-rest = p-number modulo 10
     1905       .
     1906     end.
     1907     case v-rest :
     1908       when 1
     1909       then do:
     1910         return 2 .
     1911       end.
     1912       when 2 or
     1913       when 3 or
     1914       when 4
     1915       then do:
     1916         return 3 .
     1917       end.
     1918       otherwise do:
     1919         return 1 .
     1920       end.
     1921     end case .
     1922   end.
     1923   procedure cur-time-mjd-to-date :
     1924      define input  parameter i-mjd-diff as decimal no-undo.
     1925      define output parameter o-Date     as date    no-undo.
     1926      define output parameter o-Time     as integer no-undo.
     1927      define variable v-day-number as integer   no-undo .
     1928      if    i-mjd-diff < 0
     1929         or i-mjd-diff = ?
     1930      then do:
     1931         return "?" .
     1932      end.
     1933      assign
     1934         v-day-number = truncate(i-mjd-diff,0).
     1935         o-Date = date(v-day-number + 2400002).
     1936         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1937     .
     1938   end.
     1939   function cur-time-mjd-to-string returns character
     1940   (input p-mjd-diff as decimal
     1941   )
     1942   :
     1943     define variable v-day-number as integer   no-undo .
     1944     define variable v-seconds    as integer   no-undo .
     1945     define variable v-hour       as integer   no-undo .
     1946     define variable v-min        as integer   no-undo .
     1947     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1948     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1949     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1950     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1951     if p-mjd-diff < 0
     1952     or p-mjd-diff = ?
     1953     then do:
     1954       return "?" .
     1955     end.
     1956     assign
     1957       v-day-number = integer(truncate(p-mjd-diff,0))
     1958       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1959     .
     1960     if v-seconds > 86400
     1961     then do:
     1962       assign
     1963         v-seconds = 86400 - 1
     1964       .
     1965     end.
     1966     if v-seconds < 0
     1967     then do:
     1968       assign
     1969         v-seconds = 0
     1970       .
     1971     end.
     1972     assign
     1973       v-hour = truncate(v-seconds / 3600, 0)
     1974     .
     1975     assign
     1976       v-seconds = v-seconds modulo 3600
     1977     .
     1978     assign
     1979       v-min = truncate(v-seconds / 60, 0)
     1980     .
     1981     assign
     1982       v-seconds = v-seconds modulo 60
     1983     .
     1984     return
     1985         (if v-day-number <> 0
     1986           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1987           else ""
     1988         )
     1989       + (if v-day-number <> 0 or v-hour <> 0
     1990           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1991           else ""
     1992         )
     1993       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1994           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1995           else ""
     1996         )
     1997       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1998       .
     1999   end.
     2000   function cur-time-string returns character
     2001   :
     2002     define variable v-date as date      no-undo .
     2003     define variable v-time as integer   no-undo .
     2004     run cur-time in this-procedure
     2005       (output v-date
     2006       ,output v-time
     2007       ) .
     2008     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2009   end.
     2010   function cur-time-string-sec returns character
     2011   :
     2012     define variable v-date as date      no-undo .
     2013     define variable v-time as integer   no-undo .
     2014     run cur-time in this-procedure
     2015       (output v-date
     2016       ,output v-time
     2017       ) .
     2018     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2019   end.
     2020   function cur-time-custom  returns character
     2021   (input p-prefix as character
     2022   ,input p-date-format as character
     2023   ,input p-delimiter as character
     2024   ,input p-time-format as character
     2025   ,input p-suffix as character
     2026   )
     2027   :
     2028     define variable v-date as date      no-undo .
     2029     define variable v-time as integer   no-undo .
     2030     run cur-time in this-procedure
     2031       (output v-date
     2032       ,output v-time
     2033       ) .
     2034     return
     2035       p-prefix
     2036       + string(v-date, p-date-format)
     2037       + p-delimiter
     2038       + string(v-time, p-time-format)
     2039       + p-suffix
     2040       .
     2041   end.
     2042   function cur-time-print  returns character
     2043   :
     2044     define variable v-date as date      no-undo .
     2045     define variable v-time as integer   no-undo .
     2046     run cur-time in this-procedure
     2047       (output v-date
     2048       ,output v-time
     2049       ) .
     2050     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2051   end.
     2052   function cur-time-datetime returns datetime
     2053   :
     2054     define variable v-char as character no-undo .
     2055     define variable v-datetime as datetime no-undo .
     2056     v-char = cur-time-string().
     2057     v-datetime = datetime(v-char).
     2058     return  v-datetime.
     2059   end.
     2060   function cur-time-string-msec returns character
     2061   :
     2062     define variable v-date as datetime  no-undo .
     2063     v-date = now.
     2064     return string(v-date) .
     2065   end.
     2066   define variable vss-include-info25 as character format "X(65)" no-undo
     2067   initial "@(#)$Workfile$ $Revision$".
     2068   procedure xmlchar-test :
     2069   define input parameter p-in-string          as character        no-undo.
     2070   define output parameter p-out-string-enc    as character        no-undo.
     2071   define output parameter p-out-string-dec    as character        no-undo.
     2072   do
     2073   on error undo, return error
     2074   :
     2075          run xmlchar-encode in this-procedure
     2076       (
     2077             input p-in-string
     2078           , output p-out-string-enc
     2079       ).
     2080          run xmlchar-decode in this-procedure
     2081       (
     2082             input p-out-string-enc
     2083           , output p-out-string-dec
     2084       ).
