     8575                       tax-string = tax-string + " " + (if tt-tax.individual
     8576                                                 then (if tt-tax.rate-value <> 0
     8577                                                           then string(tt-tax.rate-code + txfixnum)
     8578                                                           else "")
     8579                                                 else string(tt-tax.rate-code)).
     8580                   end.
