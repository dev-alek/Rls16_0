     8366   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8367   PROCEDURE term-prt.
     8368   DEFINE var incode like ub.bar-code.in-code no-undo.
     8369   DEFINE var partcode like ub.bar-code.part-code no-undo.
     8370   DEFINE var unitcli like ub.bar-code.unit-cli no-undo.
     8371   DEFINE var clibaserate like ub.bar-code.cli-base-rate no-undo.
     8372   DEFINE var dpcnt  as decimal no-undo.
     8373   DEFINE var nodecode like ub.bar-code.node-code no-undo.
     8374   def buffer b-g-p for ub.gds-prt.
     8375   def buffer b-units for ub.units.
     8376   FIND FIRST ub.goods WHERE
     8377              ub.goods.gds-code = b-bc.gds-code NO-LOCK .
     8378   if v-is-restaurant then do:
     8379     find first buf_fbr-gds-obj no-lock where
     8380                 buf_fbr-gds-obj.obj-type = 'маг':U
     8381             AND buf_fbr-gds-obj.obj-code = i-obj-code
     8382             AND buf_fbr-gds-obj.gds-code = ub.goods.gds-code no-error .
     8383     if     available buf_fbr-gds-obj
     8384        and not buf_fbr-gds-obj.is-cd
     8385     then
     8386        return .
     8387   end.
     8388   FIND FIRST b-units No-LOCK WHERE
     8389              b-units.unit-name = b-bc.unit-cli NO-ERROR.
     8390   assign
     8391   incode = b-bc.in-code
     8392   partcode = b-bc.part-code
     8393   unitcli = b-bc.unit-cli
     8394   clibaserate = b-bc.cli-base-rate
     8395   nodecode = b-bc.node-code
     8396   .
     8397   assign                 new-good = yes                 temp-discnt-rule_ = 0                 temp-discnt-method_ = ''                 petrol-trk = no                 tax-string = ""                 std-discnt-rule_ = 0                 for-wd = 0                 for-fp = no                 cashparts = no                 for-grp-code = 1                 for-petrol-purse = no                 qnty-discnt-rule_ = 0                 kat-discnt-rule_ = 0                 kat-discnt-method_ = ''                 date-discnt-rule_ = 0                 for-producer = "":U                 main-b-code = 0                 for-taracode = '00'                 abs-discnt-rule_ = 0                 for-wgd = 0                 . empty temp-table temp-dis-gds-rule. run cur-time in this-procedure(output v-today, output v-time).
     8398   run get-prt-and-unit in this-procedure (
     8399                                           input ub.goods.prt-root
     8400                                           ,input ub.goods.unit-base
     8401                                           ,output l-empty-scale
     8402                                           ) .                                            .
     8403   run get-gds-obj-fields in this-procedure(                                                  buffer ub.gds-obj                                                 ,input yes                                                 ,input ub.goods.gds-code                                                 ,input i-obj-code                                                 ,input 'маг':U                                                 ,output for-fact-qnty                                                 ,output cashparts                                                 ,output v-is-null-price                                                 ,output v-is-menu                                                 ,output v-is-semi-finished                                                 ,output v-is-modificator                                                 ,output v-fbr-grp-code                                                 ,output v-fbr-obj-code                                                 ) no-error .       if error-status:error then do:         run write-log-and-file in p-log-handle (                 input 1                                                                              , input log-file-name                                                                  , input 1                                                                              , input substitute("!!!Ошибка при получении характеристик товара &1 &2&3 на объекте"                                      , ub.gds-obj.artic                                                               , ub.gds-obj.prod-type                                                           , ub.gds-obj.prod-code                                                           )                                                                                         ).                                                            assign                                                                                  v-view-log = yes                                                                        .      end.
     8404   if not avail ub.gds-obj then NEXT.
     8405   FIND FIRST b-g-p where b-g-p.node-code = nodecode NO-LOCK No-ERROR.
     8406   if not avail b-g-p then do:
     8407     if not g#news then do:
     8408       message "Не найден узел шкалы для бар-кода"
     8409               b-bc.b-code
     8410       view-as alert-box ERROR.
     8411       return error.
     8412     end.
     8413     else return error.
     8414   end.
     8415   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8416     if action = "U" then do:
     8417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8418     (input  ub.goods.gds-code
     8419     ,input  ?
     8420     ,output main-b-code
     8421     ) no-error .
     8422         find first buf_producer no-lock where
     8423                    buf_producer.obj-type = ub.goods.prod-type
     8424                AND buf_producer.obj-code = ub.goods.prod-code no-error .
