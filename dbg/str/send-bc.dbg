    13289   _do26:
    13290   do vdr-26 = 1 to 3:
    13291     CASE vdr-26:
    13292       when 1 then do:
    13293         assign
    13294         vc-obj-code = ub.shop.obj-code
    13295         vc-obj-type = 'маг':U
    13296         vc-host-code = ub.shop.host-code
    13297         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    13298         .
    13299       end.
    13300       when 2 then do:
    13301         assign
    13302         vc-obj-code = 0
    13303         vc-obj-type = '':U
    13304         vc-host-code = ub.shop.host-code
    13305         vc-region    = substitute("Фирма &1&2", vc-host-code)
    13306         .
    13307       end.
    13308       when 3 then do:
    13309         assign
    13310         vc-obj-code = 0
    13311         vc-obj-type = '':U
    13312         vc-host-code = 0
    13313         vc-region    = "Глобально"
    13314         .
    13315       end.
    13316     END CASE.
    13317     find ub.dis-rule no-lock where
    13318                   ub.dis-rule.upper-rule-num = 26
    13319               and ub.dis-rule.host-code = vc-host-code
    13320               AND ub.dis-rule.obj-type = vc-obj-type
    13321               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    13322     if available ub.dis-rule then LEAVE _do26.
    13323   end.
    13324   if available ub.dis-rule then do:
    13325     for each buf_dis-rule no-lock where
    13326             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    13327       assign
