     8582               else do:
     8583               tax-string = tax-string + " " + (if tt-tax.individual
     8584                                                 then (if tt-tax.rate-value <> 0
     8585                                                           then string(tt-tax.rate-code + txfixnum)
     8586                                                           else "")
     8587                                                 else string(tt-tax.rate-code)).
     8588               end.
     8589               if tt-tax.individual and tt-tax.rate-value <> 0 then do:
     8590                 FIND FIRST cash-txr where
     8591                           cash-txr.tax-code = tt-tax.tax-code
     8592                       and cash-txr.host-code = ub.shop.host-code
     8593                       and cash-txr.obj-type = 'маг':U
     8594                       and cash-txr.obj-code = ub.shop.obj-code
     8595                       and cash-txr.status_  = 'тек':U
