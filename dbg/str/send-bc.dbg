     3250   procedure alienini-getkey :
     3251   define input parameter i-filename as char.
     3252   define input parameter i-section as char.
     3253   define input parameter i-key as char.
     3254   define output parameter o-value as char.
     3255   define variable EntryPointer as integer no-undo.
     3256   define variable mem1 as memptr no-undo.
     3257   define variable mem2 as memptr no-undo.
     3258   define variable mem1size as integer no-undo.
     3259   define variable mem2size as integer no-undo.
     3260   define variable ii       as integer    no-undo.
     3261   define variable cbReturnSize  as integer    no-undo.
     3262   assign
     3263   set-size(mem1)  = 4000
     3264   mem1size = 4000.
     3265   if i-key = "" then EntryPointer = 0.
     3266   else do:
     3267     assign
     3268     set-size(mem2) = 128
     3269     mem2size = 128
     3270     EntryPointer = get-pointer-value(mem2)
     3271     put-string(mem2, 1) = i-key.
     3272   end.
     3273   run getprivateprofilestringA
     3274                                 (i-section,
     3275                                  EntryPointer,
     3276                                  "",
     3277                                  get-pointer-value(mem1),
     3278                                  input mem1size,
     3279                                  i-filename,
     3280                                  output cbReturnSize).
     3281   do ii = 1 to cbReturnSize:
     3282     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3283                  then o-value + ","
     3284                  else o-value + chr(get-byte(mem1, ii)).
     3285   end.
     3286     set-size(mem1) = 0.
     3287     set-size(mem2) = 0.
     3288   end procedure.
     3289   procedure alienini-putkey :
     3290   define input parameter i-filename as char.
     3291   define input parameter i-section as char.
     3292   define input parameter i-key as char.
     3293   define input parameter i-value as char.
     3294   define variable cbReturnSize as integer.
     3295   run writeprivateprofilestringA
     3296                                  (i-section,
     3297                                   i-key,
     3298                                   i-value,
     3299                                   i-filename,
     3300                                   output cbReturnSize ).
     3301   end procedure.
     3302   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3303     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3304     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3305     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3306     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3307     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3308     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3309     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3310   END PROCEDURE.
     3311   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3312     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3313     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3314     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3315     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3316     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3317   END PROCEDURE.
     3318   define   temp-table temp-tekka-tsk no-undo
     3319   field filename      as character
     3320   field obj-num       as integer
     3321   field obj-name      as character
     3322   field num-records   as integer
     3323   field max-records   as integer
     3324   field min-plu       as integer
     3325   field max-plu       as integer
     3326   field num-fields    as integer
     3327   field task-num      as character
     3328   field by-record     as logical
     3329   field send-get      as character
     3330   field cash-num      as integer
     3331   field cash-num-char as character
     3332   field port-num      as character
     3333   field way           as character
     3334   field is-script     as logical
     3335   field pswd          as character
     3336   field waiting-sek   as integer
     3337   field other-info    as character
     3338   field order-num     as integer
     3339   field secondary     as integer
     3340   field shift-fields  as integer
     3341   field binary        as logical
     3342   field range         as integer
     3343   index pi is unique primary
     3344   filename
     3345   range
     3346   index lpi
     3347   filename
     3348   min-plu
     3349   index gpi
     3350   filename
     3351   max-plu
     3352   index iorder
     3353   order-num
     3354   .
     3355   define   temp-table temp-tekka-schema no-undo
     3356   field obj-num as integer
     3357   field obj-name as character
     3358   field field-num as integer
     3359   field field-name as character
     3360   field num-records as integer
     3361   field size_ as integer
     3362   field host as character
     3363   field progress-type as character
     3364   field custom-type as character
     3365   field start-pos as integer
     3366   field end-pos as integer
     3367   field bin-group as character
     3368   index pi is unique primary
     3369   host obj-num field-num
     3370   .
     3371   define temp-table temp-tekka-record no-undo
     3372   field obj-num as integer
     3373   field plu as integer
     3374   field body as character
     3375   field shift as integer
     3376   index pi is unique primary obj-num plu.
     3377   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3378   define variable v-is-closed-shift-journal as integer no-undo .
     3379   assign
     3380   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3381                               +
     3382                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3383                               +
     3384                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3385   .
     3386   return v-is-closed-shift-journal.
     3387   END FUNCTION.
     3388   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3389   define variable v-is-first-journal as logical no-undo .
     3390   assign
     3391   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3392                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3393                     or (p-journal-num =  integer(entry(1, '17':U)))
     3394                     or (p-journal-num = integer(entry(1, '16':U)))
     3395   .
     3396   return v-is-first-journal.
     3397   END FUNCTION.
     3398   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3399   define variable v-is-petrol-journal as logical no-undo .
     3400   assign
     3401   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3402   return v-is-petrol-journal.
     3403   END FUNCTION.
     3404   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3405   define variable v-max-record-num as integer no-undo .
     3406   assign
     3407   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3408                       then 1489
     3409                       else 2340).
     3410   return v-max-record-num.
     3411   END FUNCTION.
     3412   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3413   define variable v-max-record-num as integer no-undo .
     3414   assign
     3415   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3416                       then 1489 * num-entries('30,31,32,33':U)
     3417                       else 2340 * num-entries('17':U)).
     3418   return v-max-record-num.
     3419   END FUNCTION.
     3420   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3421                                           ,input p-rec-no as integer):
     3422   define variable v-num-recs as integer no-undo .
     3423   if tekka-is-petrol-journal (p-journal-num) then do:
     3424     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3425       assign
     3426       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3427       .
     3428     end.
     3429     else do:
     3430       assign
     3431       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3432       .
     3433     end.
     3434   end.
     3435   else do:
     3436     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3437       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3438         assign
     3439         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3440         .
     3441       end.
     3442       else do:
     3443         assign
     3444         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3445         .
     3446       end.
     3447     end.
     3448     else do:
     3449       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3450         assign
     3451         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3452         .
     3453       end.
     3454       else do:
     3455         assign
     3456         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3457         .
     3458       end.
     3459     end.
     3460   end.
     3461   return v-num-recs.
     3462   END FUNCTION.
     3463   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3464                                              ,input p-is-petrol as logical
     3465                                              ,input p-is-current as logical
     3466                                              ,output p-rec-no as decimal
     3467                                              ):
     3468   define variable v-obj-num0 as integer no-undo .
     3469   define variable v-obj-num as integer no-undo .
     3470   define variable v-obj-num2 as integer no-undo .
     3471   define variable p-num-recs2 as integer no-undo .
     3472   define variable p-rec-no2 as integer no-undo .
     3473   if p-is-petrol then do:
     3474     assign
     3475     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3476     .
     3477     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3478     then
     3479     assign
     3480     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3481     p-rec-no = p-num-recs modulo 1489
     3482     .
     3483     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3484     then
     3485     assign
     3486     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3487     p-rec-no = p-num-recs modulo 1489
     3488     .
     3489   end.
     3490   else do:
     3491     assign
     3492     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3493     p-num-recs = trunc(p-num-recs, 0)
     3494     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3495     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3496     .
     3497     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3498     then
     3499     assign
     3500     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3501     p-rec-no = p-num-recs modulo 2340
     3502     .
     3503     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3504     then
     3505     assign
     3506     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3507     p-rec-no = p-num-recs modulo 2340
     3508     .
     3509     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3510     then
     3511     assign
     3512     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3513     p-rec-no2 = p-num-recs2 modulo 2978
     3514     .
     3515     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3516     then
     3517     assign
     3518     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3519     p-rec-no2 = p-num-recs2 modulo 2978
     3520     .
     3521     assign
     3522     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3523     .
     3524   end.
     3525   if v-obj-num = 0 then v-obj-num = 100.
     3526   return v-obj-num.
     3527   END FUNCTION.
     3528   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3529   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3530   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3531      if p-is-ptrl then
     3532      return integer(entry(1, '26,27,28,29':U)).
     3533      if not p-is-ptrl then
     3534      return integer(entry(1, '16':U)).
     3535   end.
     3536   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3537   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3538   return 0.
     3539   END FUNCTION.
     3540   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3541   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3542   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3543     if p-is-ptrl then
     3544     return integer(entry(1, '26,27,28,29':U)).
     3545     if not p-is-ptrl then
     3546     return integer(entry(1, '16':U)).
     3547   end.
     3548   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3549   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3550   return 0.
     3551   END FUNCTION.
     3552   PROCEDURE maria-put:
     3553   define parameter buffer buf_cash-desk for ub.cash-desk.
     3554   define input parameter p-out    as character no-undo .
     3555   define input parameter p-fname as character no-undo .
     3556   define input parameter p-by-record as logical no-undo .
     3557   define input parameter p-shift-fields as integer no-undo .
     3558   define input parameter p-binary as logical no-undo .
     3559   define input parameter p-obj-num as integer no-undo .
     3560   define input parameter p-max-records as integer no-undo .
     3561   define input parameter p-plu as integer no-undo .
     3562   define input parameter p-value as character no-undo .
     3563   define variable v-file-name as character no-undo .
     3564   define variable v-create as logical no-undo .
     3565   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3566   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3567   output stream IBMSTREAM
     3568   to value(v-file-name) append .
     3569   Put  stream IBMSTREAM unformatted
     3570   p-plu
     3571   chr(3)
     3572   p-value
     3573   skip.
     3574   output stream IBMSTREAM
     3575   close.
     3576   if not p-by-record then do:
     3577     find first buf_temp-tekka-tsk where
     3578               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3579     if not available buf_temp-tekka-tsk then do:
     3580       v-create = yes.
     3581     end.
     3582   end.
     3583   else do:
     3584     find first buf_temp-tekka-tsk where
     3585               buf_temp-tekka-tsk.filename  = v-file-name
     3586           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3587     if not available buf_temp-tekka-tsk
     3588     then do:
     3589       find first buf_temp-tekka-tsk where
     3590                 buf_temp-tekka-tsk.filename  = v-file-name
     3591             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3592       if not available buf_temp-tekka-tsk
     3593       then do:
     3594         v-create = yes.
     3595       end.
     3596     end.
     3597   end.
     3598   if v-create then do:
     3599     create buf_temp-tekka-tsk.
     3600     assign
     3601     buf_temp-tekka-tsk.filename = v-file-name
     3602     buf_temp-tekka-tsk.range    = p-plu
     3603     buf_temp-tekka-tsk.obj-num = p-obj-num
     3604     buf_temp-tekka-tsk.obj-name = '':U
     3605     buf_temp-tekka-tsk.num-records = 0
     3606     buf_temp-tekka-tsk.max-records = p-max-records
     3607     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3608     buf_temp-tekka-tsk.task-num = p-fname
     3609     buf_temp-tekka-tsk.by-record = p-by-record
     3610     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3611     buf_temp-tekka-tsk.binary = p-binary
     3612     buf_temp-tekka-tsk.send-get = 'send'
     3613     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3614     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3615     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3616     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3617                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3618                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3619                                 then 'local'
     3620                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3621     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3622     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3623     buf_temp-tekka-tsk.waiting-sek = 30
     3624     buf_temp-tekka-tsk.min-plu     = p-plu
     3625     buf_temp-tekka-tsk.max-plu     = p-plu
     3626     .
     3627   end.
     3628   assign
     3629   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3630   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3631   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3632   .
     3633   END PROCEDURE.
     3634   PROCEDURE maria-get:
     3635   define parameter buffer buf_cash-desk for ub.cash-desk.
     3636   define input parameter p-out    as character no-undo .
     3637   define input parameter p-fname as character no-undo .
     3638   define input parameter p-by-record as logical no-undo .
     3639   define input parameter p-obj-num as integer no-undo .
     3640   define input parameter p-num-fields as integer no-undo .
     3641   define input parameter p-max-records as integer no-undo .
     3642   define input parameter p-min-plu as integer no-undo .
     3643   define input parameter p-max-plu as integer no-undo .
     3644   define input parameter p-other as character no-undo .
     3645   define input parameter p-order-num as integer no-undo .
     3646   define variable v-file-name as character no-undo .
     3647   define variable v-secondary-obj-num as character no-undo .
     3648   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3649   if p-by-record then do:
     3650     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3651   end.
     3652   else do:
     3653     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3654   end.
     3655   find first buf_temp-tekka-tsk where
     3656             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3657   if not available buf_temp-tekka-tsk then do:
     3658     create buf_temp-tekka-tsk.
     3659     assign
     3660     buf_temp-tekka-tsk.filename = v-file-name
     3661     buf_temp-tekka-tsk.obj-num = p-obj-num
     3662     buf_temp-tekka-tsk.obj-name = '':U
     3663     buf_temp-tekka-tsk.max-records = p-max-records
     3664     buf_temp-tekka-tsk.num-fields = p-num-fields
     3665     buf_temp-tekka-tsk.task-num = p-fname
     3666     buf_temp-tekka-tsk.by-record = p-by-record
     3667     buf_temp-tekka-tsk.send-get = 'get'
     3668     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3669     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3670     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3671     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3672                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3673                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3674                                   then 'local'
     3675                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3676     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3677     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3678     buf_temp-tekka-tsk.waiting-sek = 30
     3679     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3680     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3681     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3682                                       and p-max-plu <> ?
     3683                                       then p-max-plu - p-min-plu + 1
     3684                                       else 0)
     3685     buf_temp-tekka-tsk.other-info = p-other
     3686     buf_temp-tekka-tsk.order-num = p-order-num
     3687     .
     3688     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3689       assign
     3690       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3691       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3692       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3693       no-error
     3694       .
     3695       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3696     end.
     3697   end.
     3698   END PROCEDURE.
     3699   PROCEDURE maria-task:
     3700   define parameter buffer buf_cash-desk for ub.cash-desk.
     3701   define input parameter p-fname as character no-undo .
     3702   define input parameter p-obj-num-list as character no-undo .
     3703   define input parameter p-parameters as character no-undo .
     3704   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3705   find first buf_temp-tekka-tsk where
     3706             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3707   if not available buf_temp-tekka-tsk then do:
     3708     create buf_temp-tekka-tsk.
     3709     assign
     3710     buf_temp-tekka-tsk.filename = ''
     3711     buf_temp-tekka-tsk.range = 1
     3712     buf_temp-tekka-tsk.obj-num = 0
     3713     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3714     buf_temp-tekka-tsk.task-num = p-fname
     3715     buf_temp-tekka-tsk.by-record = no
     3716     buf_temp-tekka-tsk.send-get = 'task'
     3717     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3718     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3719     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3720     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3721                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3722                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3723                                   then 'local'
     3724                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3725     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3726     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3727     buf_temp-tekka-tsk.waiting-sek = 30
     3728     buf_temp-tekka-tsk.other-info = p-parameters
     3729     buf_temp-tekka-tsk.order-num = 0
     3730     .
     3731   end.
     3732   END PROCEDURE.
     3733   procedure tekkatsk-verify-schema :
     3734   define input parameter p-obj-list as character no-undo .
     3735   define input parameter p-dir-path as character no-undo .
     3736   define variable v-obj-num as integer no-undo .
     3737   define variable v-obj-name as character no-undo .
     3738   define variable v-num-records as integer no-undo .
     3739   define variable v-size_ as integer no-undo .
     3740   define variable v-value as character no-undo .
     3741   define variable ii as integer no-undo .
     3742   define variable jj as integer no-undo .
     3743   define variable ii-ibs as integer no-undo .
     3744   define variable ii-tekka as integer no-undo .
     3745   define variable v-result as character no-undo .
     3746   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3747   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3748     do
     3749     on error undo, return error
     3750     :
     3751        for each buf_temp-tekka-schema:
     3752          delete buf_temp-tekka-schema.
     3753        end.
     3754        input from value('tekkasch.d').
     3755        repeat :
     3756          create buf_temp-tekka-schema.
     3757          import buf_temp-tekka-schema.
     3758          assign
     3759          buf_temp-tekka-schema.host = 'IBS'
     3760          ii = ii + 1.
     3761          .
     3762        end.
     3763        input close.
     3764        ii-ibs = ii.
     3765         _ii:
     3766         do ii = 1 to 256:
     3767           if p-obj-list = "ALL"
     3768           or lookup(string(ii), p-obj-list) > 0 then do:
     3769             assign
     3770             v-obj-num = 0
     3771             v-obj-name = ''
     3772             v-num-records = 0
     3773             v-size_ = 0
     3774             .
     3775             run alienini-getkey in this-procedure (
     3776                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3777                                                     ,input ('obj' + string(ii, '999'))
     3778                                                     ,input 'oname'
     3779                                                     ,output v-value) no-error .
     3780             if v-value = ? then next _ii.
     3781             assign
     3782             v-obj-num = ii
     3783             v-obj-name = v-value
     3784             .
     3785             run alienini-getkey in this-procedure (
     3786                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3787                                                     ,input ('obj' + string(ii, '999'))
     3788                                                     ,input 'size'
     3789                                                     ,output v-value) no-error .
     3790             assign
     3791             v-num-records = integer(v-value) no-error  .
     3792             if error-status:error
     3793             or v-num-records = 0 then next _ii.
     3794             run alienini-getkey in this-procedure (
     3795                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3796                                                     ,input 'obj' + string(ii, '999')
     3797                                                     ,input 'f000'
     3798                                                     ,output v-value) no-error .
     3799             assign
     3800             v-size_ = integer(v-value) no-error  .
     3801             if error-status:error
     3802             or v-size_ = 0 then next _ii.
     3803             _jj:
     3804             do jj = 1 to 256:
     3805               run alienini-getkey in this-procedure (
     3806                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3807                                                       ,input 'obj' + string(ii, '999')
     3808                                                       ,input 'f' + string(jj, '999')
     3809                                                       ,output v-value) no-error .
     3810               if v-value = ? then next _ii.
     3811               create buf_temp-tekka-schema.
     3812               assign
     3813               buf_temp-tekka-schema.host = 'tekka'
     3814               buf_temp-tekka-schema.obj-num = v-obj-num
     3815               buf_temp-tekka-schema.obj-name = v-obj-name
     3816               buf_temp-tekka-schema.num-records = v-num-records
     3817               buf_temp-tekka-schema.size_ = v-size_
     3818               buf_temp-tekka-schema.field-num = jj
     3819               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3820               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3821                                                  then entry(2, entry(2, v-value, '#'), ':')
     3822                                                  else '':U)
     3823               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3824               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3825               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3826                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3827               no-error
     3828               .
     3829               if error-status:error then do:
     3830                 delete buf_temp-tekka-schema.
     3831                 next _jj.
     3832               end.
     3833               run alienini-getkey in this-procedure (
     3834                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3835                                                       ,input 'obj' + string(ii, '999') + 'name'
     3836                                                       ,input 'n' + string(jj, '999')
     3837                                                       ,output v-value) no-error .
     3838               if v-value <> ? then
     3839               buf_temp-tekka-schema.field-name = v-value.
     3840             end.
     3841           end.
     3842         end.
     3843         ii-tekka = ii - 1.
     3844        if p-obj-list <> 'ALL' then do:
     3845         if ii-tekka <> ii-ibs then do:
     3846           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3847                                   , ii-ibs
     3848                                   , ii-tekka).
     3849         end.
     3850        end.
     3851        for each buf_temp-tekka-schema where
     3852               buf_temp-tekka-schema.host = 'tekka':
     3853          find first buf2_temp-tekka-schema where
     3854                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3855                AND buf2_temp-tekka-schema.host = 'ibs'
     3856                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3857          if not available buf2_temp-tekka-schema then do:
     3858           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3859                                   , buf_temp-tekka-schema.field-num
     3860                                   , buf_temp-tekka-schema.obj-num).
     3861          end.
     3862          buffer-compare buf_temp-tekka-schema
     3863          to buf2_temp-tekka-schema
     3864          save result in v-result.
     3865          if v-result <> '':U then do:
     3866           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3867                                   , buf_temp-tekka-schema.field-num
     3868                                   , buf_temp-tekka-schema.obj-num).
     3869          end.
     3870        end.
     3871     end.
     3872   end procedure.
     3873   FUNCTION set-Sx returns character (input p-string as character):
     3874   return p-string.
     3875   END FUNCTION.
     3876   FUNCTION get-Sx returns character (input p-string  as character):
     3877   return p-string.
     3878   END FUNCTION.
     3879   FUNCTION set-B returns character (input p-string  as character):
     3880   return chr(integer(p-string)).
     3881   END FUNCTION.
     3882   FUNCTION get-B returns character (input p-string  as character):
     3883   return string(asc(p-string)).
     3884   END FUNCTION.
     3885   FUNCTION set-BF returns character (input p-string  as character):
     3886   define variable v-dopi as integer no-undo .
     3887   define variable ii as integer no-undo .
     3888   do ii = 1 to 8:
     3889     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3890   end.
     3891   return chr(v-dopi).
     3892   END FUNCTION.
     3893   FUNCTION get-BF returns character (input p-string  as character):
     3894   define variable v-dopi as integer no-undo .
     3895   define variable v-dops as character no-undo .
     3896   define variable ii as integer no-undo .
     3897   v-dopi = asc(p-string).
     3898   do ii = 8 to 1 BY -1:
     3899     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3900   end.
     3901   return v-dops.
     3902   END FUNCTION.
     3903   FUNCTION set-BN returns character (input p-string  as character
     3904                                     ,input p-bin-group as character):
     3905   define variable v-dopi as integer no-undo .
     3906   define variable ii as integer no-undo .
     3907   define variable jj as integer no-undo .
     3908   define variable v-grp-nums as integer no-undo .
     3909   define variable v-dopi2 as integer no-undo .
     3910   v-grp-nums = num-entries(p-bin-group).
     3911   do jj = 0 to v-grp-nums - 1:
     3912     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3913     do ii = 1 to 8:
     3914       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3915     end.
     3916   end.
     3917   return chr(v-dopi).
     3918   END FUNCTION.
     3919   FUNCTION get-BN returns character (input p-string  as character
     3920                                     ,input p-bin-group as character):
     3921   define variable v-dopi as integer no-undo .
     3922   define variable v-dops as character no-undo .
     3923   define variable v-grp-nums as integer no-undo .
     3924   define variable ii as integer no-undo .
     3925   define variable jj as integer no-undo .
     3926   v-dopi = asc(p-string).
     3927   v-grp-nums = num-entries(p-bin-group).
     3928   do jj = 1 to v-grp-nums:
     3929   do ii = 8 to 1 BY -1:
     3930     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3931   end.
     3932   end.
     3933   return v-dops.
     3934   END FUNCTION.
     3935   procedure fill-temp-cd :
     3936   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3937   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3938   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3939   define input parameter p-clear-table as logical no-undo .
     3940   define buffer buf_temp-cd for temp-cd.
     3941   define buffer buf_cash-desk for ub.cash-desk.
     3942     do
     3943     on error undo, return error
     3944     :
     3945        if p-clear-table  then do:
     3946          for each buf_temp-cd:
     3947            delete buf_temp-cd.
     3948          end.
     3949        end.
     3950        for each buf_cash-desk no-lock where
     3951               buf_cash-desk.db-num = p-db-num
     3952           AND buf_cash-desk.obj-code = p-obj-code
     3953           and buf_cash-desk.cash-on  = yes
     3954        BREAK by buf_cash-desk.pos-type:
     3955          if first-of(buf_cash-desk.pos-type) then do:
     3956            create buf_temp-cd.
     3957            buffer-copy buf_cash-desk to buf_temp-cd.
     3958          end.
     3959        end.
     3960     end.
     3961   end procedure.
     3962   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3963   FUNCTION name-2cdf returns character
     3964                      (  input p-name-2cd as character
     3965                       , input p-mode as logical
     3966                       , input p-cod-pcod as logical
     3967                       , input p-b-code  as integer
     3968                       , input p-gds-code as integer
     3969                       , input p-artic   as character
     3970                       , input p-engl-name  as character
     3971                       , input p-in-code as character
     3972                       , input p-part-code as character
     3973                       , input p-obj-type as character
     3974                       , input p-obj-code as integer
     3975                       , input p-alpha1 as character
     3976                       , output p-gtd as character
     3977                       ) :
     3978   define variable v-name-2cd as character no-undo .
     3979   define variable v-dop-alt-name as character no-undo.
     3980   define variable v-type as character no-undo.
     3981   define buffer buf_parts for ub.parts.
     3982   define buffer buf_code for ub.code.
     3983   if not p-mode and p-name-2cd = "PLU":U then do:
     3984     return "PLU кассы":U.
     3985   end.
     3986   if not p-mode then do:
     3987     if p-name-2cd <> "GTD":U
     3988     and  p-name-2cd <> "alpha1|gtd":U
     3989     then do:
     3990     assign
     3991     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     3992   end.
     3993   end.
     3994   if p-part-code = "":U or p-cod-pcod = no then do:
     3995     run gdsoattr-value in this-procedure (
     3996       'dt-seasons':U,
     3997       p-gds-code,
     3998       p-obj-type,
     3999       p-obj-code,
     4000       output v-dop-alt-name,
     4001       output v-type
     4002     ) no-error.
     4003     if v-dop-alt-name <> "" then do:
     4004       find first buf_code where
     4005                  buf_code.parent = "DTSeasons"
     4006              and buf_code.code   = v-dop-alt-name
     4007            no-lock no-error.
     4008       if available buf_code then
     4009         assign
     4010           p-engl-name = ""
     4011           v-dop-alt-name =  buf_code.misc1
     4012         .
     4013     end.
     4014     else do:
     4015       run gdsoattr-value in this-procedure
     4016                           ( input  'dop-alt-name-o':U
     4017                            ,input  p-gds-code
     4018                            ,input  p-obj-type
     4019                            ,input  p-obj-code
     4020                            ,output v-dop-alt-name
     4021                            ,output v-type
     4022                           ) no-error .
     4023     end.
     4024     CASE p-name-2cd:
     4025       when "name" then do:
     4026         if p-mode then return p-engl-name + v-dop-alt-name.
     4027         return "Англ. название".
     4028       end.
     4029       when "code":U then do:
     4030         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4031         return "Лок. код товара"  .
     4032       end.
     4033       when "GTD":U
     4034       or
     4035       when "name-GTD":U
     4036       or
     4037       when "code-GTD":U
     4038       or
     4039       when "alpha1|gtd":U
     4040       or
     4041       when "name-alpha1|gtd":U
     4042       or
     4043       when "code-alpha1|gtd":U
     4044       then do:
     4045         if p-mode then do:
     4046           run gdcstcod_cst-code  in this-procedure (
     4047                                                       input  p-obj-type
     4048                                                       ,input  p-obj-code
     4049                                                       ,input  p-gds-code
     4050                                                       ,input  p-in-code
     4051                                                       ,input  p-part-code
     4052                                                       ,output p-gtd
     4053                                                       ) no-error .
     4054         end.
     4055         if p-name-2cd = "name-gtd":U then do:
     4056           if p-mode then return p-engl-name  + v-dop-alt-name.
     4057           return "Англ. название".
     4058         end.
     4059         if p-name-2cd = "name-alpha1|gtd":U then do:
     4060           if p-mode then return p-engl-name  + v-dop-alt-name.
     4061           return "Англ. название".
     4062         end.
     4063         if p-name-2cd = "code-GTD":U then do:
     4064           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4065           return "Лок. код товара"  .
     4066         end.
     4067         if p-name-2cd = "code-alpha1|gtd":U then do:
     4068           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4069           return "Лок. код товара"  .
     4070         end.
     4071         if p-mode then do:
     4072           if p-name-2cd = "GTD" then  return p-gtd.
     4073           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4074         end.
     4075         if p-name-2cd = "GTD" then  return "Код ГТД".
     4076         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4077       end.
     4078     END CASE.
     4079   end.
     4080   else do:
     4081     if p-name-2cd = "name-gtd":U
     4082     or p-name-2cd = "code-GTD":U
     4083     or p-name-2cd = "name-alpha1|GTD":U
     4084     or p-name-2cd = "code-alpha1|GTD":U
     4085     or p-name-2cd = "alpha1|GTD":U
     4086     then do:
     4087       if p-mode then do:
     4088         run gdcstcod_cst-code  in this-procedure (
     4089                                                      input  p-obj-type
     4090                                                     ,input  p-obj-code
     4091                                                     ,input  p-gds-code
     4092                                                     ,input  p-in-code
     4093                                                     ,input  p-part-code
     4094                                                     ,output p-gtd
     4095                                                     ) no-error .
     4096       end.
     4097       else do:
     4098         if p-name-2cd = "gtd":U then
     4099         p-gtd = "Код ГТД".
     4100         if p-name-2cd = "alpha1|Gtd":U then
     4101         p-gtd = "Страна|Код ГТД".
     4102       end.
     4103     end.
     4104     if p-mode then  return p-part-code.
     4105     return "Код партии".
     4106   end.
     4107   END FUNCTION.
     4108   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4109                                            ,input p-nam-2str as logical
     4110                                            ,input p-nam-artc as logical
     4111                                            ,input p-unit-cli-type as character
     4112                                            ,input p-unit-base as character
     4113                                            ,input p-unit-cli as character
     4114                                            ,input p-cli-base-rate as decimal
     4115                                            ,input p-artic as character
     4116                                            ,input p-f-name as character
     4117                                            ,input p-gds-name as character
     4118                                            ,input p-gds-name1 as character
     4119                                            ,output p-second-name as character):
     4120   define variable v-length as integer no-undo .
     4121   define variable nam-2str-shift as integer no-undo .
     4122   define variable chk_name as character no-undo .
     4123   assign
     4124   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4125   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4126   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4127               then 5
     4128               else v-length)
     4129   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4130   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4131   .
     4132   if p-nam-artc then do:
     4133     assign
     4134     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4135       .
     4136   end.
     4137   else  do:
     4138     assign
     4139     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4140     .
     4141   end.
     4142   if p-unit-base <> p-unit-cli then do:
     4143     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4144     assign
     4145     chk_name = string(substr(chk_name
     4146                               ,1
     4147                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4148                       "*":U +
     4149                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4150   end.
     4151   else do:
     4152     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4153   end.
     4154   if p-nam-2str then do:
     4155     assign
     4156     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4157     chk_name = substr(chk_name, 1, v-length)
     4158     .
     4159   end.
     4160   else do:
     4161     assign
     4162     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4163     p-second-name =   (chr(34) +
     4164                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4165                       + chr(34) )
     4166     .
     4167   end.
     4168   return chk_name.
     4169   end function.
     4170   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4171   procedure disrules-get-interface-form :
     4172   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4173   define output parameter p-form-name as character no-undo .
     4174   define buffer buf_temp-drt-prop for temp-drt-prop.
     4175   define buffer buf_drt-prop for ub.drt-prop.
     4176   find first buf_temp-drt-prop where
     4177             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4178         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4179         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4180   if not available buf_temp-drt-prop then do:
     4181     find first buf_drt-prop where
     4182               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4183           and buf_drt-prop.upper-prop-code = "InputForm"
     4184           and buf_drt-prop.prop-code = "FormName" no-error.
     4185     if available buf_drt-prop then do:
     4186       p-form-name = buf_drt-prop.property-value.
     4187     end.
     4188     else do:
     4189       p-form-name = "ref/dis-ruli.w".
     4190     end.
     4191   end.
     4192   else do:
     4193     p-form-name = buf_temp-drt-prop.property-value.
     4194   end.
     4195   end procedure.
