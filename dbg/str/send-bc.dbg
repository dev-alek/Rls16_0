     6971   procedure grp-obj-notcorr-value :
     6972   do
     6973   on error undo, return error
     6974   :
     6975   define input parameter p-node-code             as integer      no-undo.
     6976   define input parameter p-obj-type              as character    no-undo.
     6977   define input parameter p-obj-code              as integer      no-undo.
     6978   define output parameter p-notcorr              as character    no-undo init ?.
     6979   define output parameter p-range-notcorr     as integer      no-undo.
     6980   define output parameter p-exists-notcorr    as logical      no-undo.
     6981   define variable v-host-code as integer      no-undo.
     6982   DEFINE VARIABLE v-found as logical no-undo .
     6983   DEFINE VARIABLE v-exists as logical no-undo .
     6984   DEFINE VARIABLE v-range as integer no-undo .
     6985   DEFINE VARIABLE jj as integer no-undo .
     6986   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6987   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6988   define buffer buf_gds-grp for ub.gds-grp.
     6989   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     6990   find first buf_gds-grp no-lock where
     6991              buf_gds-grp.node-code = p-node-code no-error .
     6992   if not avail buf_gds-grp and p-node-code <> 0 then do:
     6993     message
     6994       vss-workfile vss-revision vss-description
     6995       skip "Не удалось найти группу товаров с кодом" p-node-code
     6996       view-as alert-box error .
     6997     undo, return error .
     6998   end.
     6999   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7001     (input  p-obj-type
     7002     ,input  p-obj-code
     7003     ,output v-host-code
     7004     ) no-error .
     7005   if error-status :error
     7006   then do:
     7007       message
     7008         vss-workfile vss-revision vss-description
     7009         skip "Не удалось найти фирму объекта"
     7010         skip p-obj-type p-obj-code
     7011         skip return-value
     7012         skip trim(error-status :get-message(1))
     7013       view-as alert-box error.
     7014       undo, return error .
     7015   end.
     7016   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7017   do while v-found = no and jj < 2:
     7018     if v-range <> 3 then do:
     7019       find first buf_gds-grp-obj no-lock
     7020           where buf_gds-grp-obj.node-code = p-node-code
     7021             and buf_gds-grp-obj.host-code = v-host-code
     7022             and buf_gds-grp-obj.obj-type  = p-obj-type
     7023             and buf_gds-grp-obj.obj-code  = p-obj-code
     7024       no-error .
     7025     end.
     7026     if v-range = 3 or not available buf_gds-grp-obj
     7027     then do:
     7028        if v-range <> 2 then do:
     7029           find first buf_gds-grp-obj no-lock
     7030               where buf_gds-grp-obj.node-code = p-node-code
     7031                 and buf_gds-grp-obj.host-code = v-host-code
     7032                 and buf_gds-grp-obj.obj-type  = ""
     7033                 and buf_gds-grp-obj.obj-code  = 0
     7034           no-error .
     7035         end.
     7036         if v-range = 2 or not available buf_gds-grp-obj
     7037         then do:
     7038             if v-range <> 1 then do:
     7039               find first buf_gds-grp-obj no-lock
     7040                   where buf_gds-grp-obj.node-code = p-node-code
     7041                   and buf_gds-grp-obj.host-code = 0
     7042                   and buf_gds-grp-obj.obj-type  = ""
     7043                   and buf_gds-grp-obj.obj-code  = 0
     7044               no-error .
     7045             end.
     7046             if v-range = 1 or not available buf_gds-grp-obj
     7047             then do:
     7048                 assign
     7049                     v-exists = no
     7050                 .
     7051             end.
     7052             else do:
     7053                 assign
     7054                     v-exists = yes
     7055                     v-range = 1
     7056                 .
     7057             end.
     7058         end.
     7059         else do:
     7060             assign
     7061                 v-exists = yes
     7062                 v-range  = 2
     7063             .
     7064         end.
     7065     end.
     7066     else do:
     7067         assign
     7068             v-exists = yes
     7069             v-range  = 3
     7070         .
     7071     end.
     7072     if available buf_gds-grp-obj
     7073     then do:
     7074       find first buf_gds-grp-obj-attr no-lock
     7075         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7076           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7077           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7078           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7079           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7080         no-error .
     7081       if available buf_gds-grp-obj-attr then do:
     7082         assign
     7083           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7084         .
     7085       end.
     7086       else do:
     7087         assign
     7088           v-notcorr-value = ?
     7089         .
     7090       end.
     7091       assign
     7092       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7093                           then yes
     7094                           else p-exists-notcorr)
     7095       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7096                         then v-range
     7097                         else p-range-notcorr
     7098       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7099                         then v-notcorr-value
     7100                         else p-notcorr
     7101       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7102       jj = jj + 1
     7103       .
     7104     end.
     7105     else do:
     7106       assign
     7107       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7108       jj = jj + 1
     7109       .
     7110     end.
     7111   end.
     7112   end.
     7113   end procedure.
