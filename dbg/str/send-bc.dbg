      371   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      373                                                                     input  orders as integer):
      374   define variable  round-m-sum as decimal no-undo.
      375   if orders >= 0 then
      376   round-m-sum = round(mysum,orders).
      377   else
      378   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      379   return round-m-sum.
      380   END FUNCTION.
      381   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   procedure factord :
      383     define input  parameter p-fact-date            as date    no-undo .
      384     define input  parameter p-fact-time            as integer no-undo .
      385     define input  parameter p-fact-num             as integer no-undo .
      386     define input  parameter p-shift-date           as date    no-undo .
      387     define input  parameter p-shift-num            as integer no-undo .
      388     define input  parameter p-shift-on             as logical no-undo .
      389     define output parameter p-fact-order           as decimal no-undo .
      390     define output parameter p-shift-end-fact-order as decimal no-undo .
      391     define output parameter p-day-end-fact-order   as decimal no-undo .
      392     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      393     if p-fact-date = ?
      394     then do:
      395       return error "Не указана фактическая дата" .
      396     end.
      397     define variable v-fact-date-num as integer no-undo .
      398     assign
      399       v-fact-date-num = integer(p-fact-date)
      400     .
      401     if p-fact-num = ?
      402     or p-fact-num = 0
      403     then do:
      404       return error "Не задан p-fact-num " + string(p-fact-num) .
      405     end.
      406     if p-fact-num < 0
      407     then do:
      408       return error "Отрицательный fact-num " + string(p-fact-num) .
      409     end.
      410     if p-fact-num >= 100000000
      411     then do:
      412       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      413     end.
      414     if p-shift-on = true
      415     then do:
      416       if p-shift-date = ?
      417       then do:
      418         return error "Не задана дата смены" .
      419       end.
      420       if p-shift-num = ?
      421       or p-shift-num = 0
      422       then do:
      423         return error "Не задан номер смены" .
      424       end.
      425     end.
      426     else do:
      427       assign
      428         p-shift-date = p-fact-date
      429         p-shift-num  = 24
      430       .
      431     end.
      432     define variable v-shift-offset as integer no-undo .
      433     if p-shift-date = p-fact-date
      434     then do:
      435       assign
      436         v-shift-offset = 1
      437       .
      438     end.
      439     if p-shift-date < p-fact-date
      440     then do:
      441       assign
      442         v-shift-offset = 0
      443       .
      444     end.
      445     if p-shift-date > p-fact-date
      446     then do:
      447       message
      448         vss-workfile vss-revision vss-description skip
      449         "Неправильная дата закрытия смены" skip
      450         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      451         view-as alert-box error .
      452       undo, return error
      453         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      454           ,string(p-fact-date, '99/99/9999':U)
      455           ,string(p-shift-date, '99/99/9999':U)
      456           )
      457       .
      458     end.
      459     if p-shift-num < 1
      460     or p-shift-num > 24
      461     then do:
      462       message
      463         vss-workfile vss-revision vss-description skip
      464         "Неправильный номер смены" skip
      465         "p-shift-num" p-shift-num skip
      466         view-as alert-box error .
      467       undo, return error return-value .
      468     end.
      469     assign
      470       p-fact-order           = v-fact-date-num
      471                              + v-shift-offset * 0.5
      472                              + p-shift-num    * 0.02 - 0.01
      473                              + p-fact-num     * 0.0000000001
      474       p-shift-end-fact-order = v-fact-date-num
      475                              + v-shift-offset * 0.5
      476                              + p-shift-num    * 0.02
      477       p-day-end-fact-order   = v-fact-date-num
      478                              + 0.99
      479     .
      480     if p-fact-order           <= v-fact-date-num
      481     or p-shift-end-fact-order <= v-fact-date-num
      482     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      483     or p-shift-end-fact-order >= p-day-end-fact-order
      484     then do:
      485       message
      486         vss-workfile vss-revision vss-description skip
      487         "Внутренняя ошибка при генерации фактического номера" skip
      488         "p-fact-date"            p-fact-date            skip
      489         "p-fact-time"            p-fact-time            skip
      490         "p-fact-num"             p-fact-num             skip
      491         "p-shift-date"           p-shift-date           skip
      492         "p-shift-num"            p-shift-num            skip
      493         "p-shift-on"             p-shift-on             skip
      494         "p-shift-end-fact-order" p-shift-end-fact-order skip
      495         "p-day-end-fact-order"   p-day-end-fact-order   skip
      496         "v-fact-date-num"        v-fact-date-num        skip
      497         view-as alert-box error .
      498       undo, return error return-value .
      499     end.
      500   end procedure.
      501   procedure day-begin-fact-order :
      502     define input  parameter p-fact-date            as date    no-undo .
      503     define output parameter p-day-begin-fact-order as decimal no-undo .
      504     do
      505     on error undo, return error return-value
      506     :
      507       if p-fact-date = ?
      508       then do:
      509         assign
      510           p-day-begin-fact-order = 0
      511         .
      512       end.
      513       else do:
      514         assign
      515           p-day-begin-fact-order = integer(p-fact-date)
      516         .
      517       end.
      518     end.
      519   end procedure.
      520   procedure factord-max-fact-order :
      521     define output parameter p-max-fact-order as decimal   no-undo .
      522     do
      523     on error undo, return error return-value
      524     :
      525       run day-begin-fact-order in this-procedure
      526         (input  date(1, 1, 5000)
      527         ,output p-max-fact-order
      528         ) .
      529     end.
      530   end procedure.
      531   procedure factord-cut-archive :
      532     define input  parameter p-obj-type             as character no-undo .
      533     define input  parameter p-obj-code             as integer   no-undo .
      534     define input  parameter p-fact-date            as date      no-undo .
      535     define output parameter p-shift-on             as logical   no-undo .
      536     define output parameter p-shift-date           as date      no-undo .
      537     define output parameter p-shift-num            as integer   no-undo .
      538     define output parameter p-day-end-fact-order   as decimal   no-undo .
      539     define output parameter p-shift-end-fact-order as decimal   no-undo .
      540     define variable v-fact-order as decimal   no-undo .
      541     define buffer buf_shift-obj for ub.shift-obj .
      542     do
      543     on error undo, return error return-value
      544     :
      545   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      547     (input  p-obj-type
      548     ,input  p-obj-code
      549     ,input  'shift-on=request'
      550     ,output p-shift-on
      551     ) no-error .
      552       if error-status :error
      553       then do:
      554         message
      555           vss-workfile vss-revision vss-description skip
      556           "Ошибка при определении атрибута объекта" skip
      557           "Объект" p-obj-type p-obj-code skip
      558           error-status :get-message(1) skip
      559           return-value skip
      560           view-as alert-box error .
      561         undo, return error return-value .
      562       end.
      563       if p-shift-on = false
      564       then do:
      565         assign
      566           p-shift-date               = ?
      567           p-shift-num                = 0
      568         .
      569       end.
      570       else do:
      571         find first buf_shift-obj share-lock
      572           where buf_shift-obj.obj-type   = p-obj-type
      573             and buf_shift-obj.obj-code   = p-obj-code
      574             and buf_shift-obj.shift-date > p-fact-date
      575           use-index pi
      576           no-error .
      577         if not available buf_shift-obj
      578         or buf_shift-obj.status_ <> 'зкр':U
      579         then do:
      580           message
      581             vss-workfile vss-revision vss-description skip
      582             "Невозможно вычислить последнюю смену" skip
      583             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      584             "Объект" p-obj-type p-obj-code skip
      585             "Дата" p-fact-date skip
      586             view-as alert-box error .
      587           undo, return error return-value .
      588         end.
      589         find last buf_shift-obj share-lock
      590           where buf_shift-obj.obj-type = p-obj-type
      591             and buf_shift-obj.obj-code = p-obj-code
      592             and buf_shift-obj.shift-date <= p-fact-date
      593           use-index pi
      594           no-error .
      595         if available buf_shift-obj
      596         then do:
      597           if  buf_shift-obj.status_ = 'зкр':U
      598           then do:
      599             assign
      600               p-shift-date = buf_shift-obj.shift-date
      601               p-shift-num  = buf_shift-obj.shift-num
      602             .
      603           end.
      604           else do:
      605             message
      606               vss-workfile vss-revision vss-description skip
      607               "Невозможно вычислить последнюю смену" skip
      608               "Статус смены отличен от статуса" 'зкр':U skip
      609               "Объект" p-obj-type p-obj-code skip
      610               "Дата" p-fact-date skip
      611               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      612               view-as alert-box error .
      613             undo, return error return-value .
      614           end.
      615         end.
      616         else do:
      617           assign
      618             p-shift-date = p-fact-date - 1
      619             p-shift-num  = 1
      620           .
      621         end.
      622       end.
      623       run factord in this-procedure
      624         (input  p-fact-date
      625         ,input  1
      626         ,input  1
      627         ,input  p-shift-date
      628         ,input  p-shift-num
      629         ,input  p-shift-on
      630         ,output v-fact-order
      631         ,output p-shift-end-fact-order
      632         ,output p-day-end-fact-order
      633         ) no-error .
      634       if error-status :error
      635       then do:
      636         message
      637           vss-workfile vss-revision vss-description skip
      638           "Ошибка при вызове процедуры factord"
      639           error-status :get-message(1) skip
      640           return-value skip
      641           view-as alert-box error .
      642         undo, return error return-value .
      643       end.
      644     end.
      645   end procedure.
      646   procedure factord-lock-shift :
      647     define input  parameter p-obj-type  as character no-undo .
      648     define input  parameter p-obj-code  as integer   no-undo .
      649     define input  parameter p-fact-date as date      no-undo .
      650     define parameter buffer buf_shift-obj for ub.shift-obj .
      651     define variable v-shift-on      as logical   no-undo .
      652     define variable v-extra-message as character no-undo .
      653     define variable v-error as character no-undo .
      654     do
      655     on error undo, return error return-value
      656     :
      657   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      659     (input  p-obj-type
      660     ,input  p-obj-code
      661     ,input  'shift-on=request'
      662     ,output v-shift-on
      663     ) no-error .
      664       if error-status :error
      665       then do:
      666         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      667         undo, return error v-error .
      668       end.
      669       if v-shift-on = true
      670       then do:
      671         find first buf_shift-obj share-lock
      672           where buf_shift-obj.obj-type   = p-obj-type
      673             and buf_shift-obj.obj-code   = p-obj-code
      674             and buf_shift-obj.shift-date > p-fact-date
      675           use-index pi
      676           no-error .
      677         if not available buf_shift-obj
      678         or buf_shift-obj.status_ <> 'зкр':U
      679         then do:
      680           find last buf_shift-obj
      681             where buf_shift-obj.obj-type = p-obj-type
      682               and buf_shift-obj.obj-code = p-obj-code
      683               and buf_shift-obj.status_  = 'зкр':U
      684             use-index stts
      685             no-error .
      686           if available buf_shift-obj
      687           then do:
      688             assign
      689               v-extra-message =
      690                     substitute("Дата начала последеней закрытой смены на объекте &1"
      691                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      692                               )
      693             .
      694           end.
      695           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      696           undo, return error v-error .
      697         end.
      698       end.
      699     end.
      700   end procedure.
      701   procedure factord-end-day :
      702     define input  parameter p-fact-date            as date    no-undo .
      703     define output parameter p-day-end-fact-order   as decimal no-undo .
      704     do
      705     on error undo, return error return-value
      706     :
      707       if p-fact-date = ?
      708       then do:
      709         return error "Не указана фактическая дата" .
      710       end.
      711       assign
      712         p-day-end-fact-order = integer(p-fact-date) + 0.99
      713       .
      714     end.
      715   end procedure.
      716   procedure factord-to-date :
      717     define input  parameter p-fact-order as decimal no-undo .
      718     define output parameter p-fact-date  as date    no-undo .
      719     define variable v-ref-date  as date      no-undo .
      720     define variable v-ref-delta as integer   no-undo .
      721     do
      722     on error undo, return error return-value
      723     :
      724       if p-fact-order = ?
      725       or p-fact-order = 0
      726       then do:
      727         return error "Не указан fact-order" .
      728       end.
      729       assign
      730         v-ref-date  = date(1, 1, 2000)
      731       .
      732       assign
      733         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      734       .
      735       assign
      736         p-fact-date = v-ref-date + v-ref-delta
      737       .
      738     end.
      739   end procedure.
      740   procedure factord-to-fact-num :
      741     define input  parameter p-fact-order as decimal no-undo .
      742     define output parameter p-fact-num   as integer no-undo .
      743     define variable v-fact-order-trunc as decimal no-undo .
      744     do
      745     on error undo, return error return-value
      746     :
      747       if p-fact-order = ?
      748       or p-fact-order = 0
      749       then do:
      750         return error "Не указан fact-order" .
      751       end.
      752       assign
      753        v-fact-order-trunc = truncate(p-fact-order, 2)
      754       .
      755       assign
      756         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      757       .
      758     end.
      759   end procedure.
      760   procedure factord-to-shift-num :
      761     define input  parameter p-fact-order as decimal no-undo .
      762     define output parameter p-shift-num   as integer no-undo .
      763     define variable  p-shift-numd  as decimal   no-undo .
      764     define variable v-fact-order-trunc as decimal no-undo .
      765     do
      766     on error undo, return error return-value
      767     :
      768       if p-fact-order = ?
      769       or p-fact-order = 0
      770       then do:
      771         return error "Не указан fact-order" .
      772       end.
      773       assign
      774        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      775       .
      776       if v-fact-order-trunc < 0.5 then do:
      777         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      778       end.
      779       assign
      780         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      781         .
      782        assign
      783         p-shift-num = truncate (p-shift-numd , 0)
      784       .
      785     end.
      786   end procedure.
      787   define new global shared variable g#lib-trn  as handle no-undo .
      788   define new global shared variable g#lib-trn2 as handle no-undo .
      789   define new global shared variable g#lib-trn3 as handle no-undo .
      790   define new global shared variable g#lib-trn4 as handle no-undo .
      791   define temp-table  tt-tax no-undo
      792     field tax-code    like ub.tax.tax-code
      793     field individual  like ub.tax.individual
      794     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      795     field rate-code   like ub.tax-rate.rate-code
      796     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      797     field tax-type    like ub.tax.tax-type
      798     field rate-value  like ub.tax-rate-value.rate-value
      799     field tax-rate-gds-rc  as recid
      800     field to-cashdesk like ub.tax.to-cashdesk
      801     index tax-code is unique primary tax-code
      802     .
      803   procedure tax-val :
      804     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      805     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      806     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      807     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      808     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      809     define input  parameter       parunits-type like ub.units.type         no-undo.
      810     define input  parameter       parrec-id     as recid                   no-undo.
      811     define input  parameter       paris-log     as logical                 no-undo.
      812     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      813     define input  parameter       vattaxcdvalue as integer                 no-undo.
      814     define input  parameter       exctaxcdvalue as integer                 no-undo.
      815     define input  parameter       only-check    as logical                 no-undo.
      816     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      817     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      818     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      819     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      820     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      821     define output parameter       parerr-mes    as character               no-undo.
      822     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      823     do
      824     on error undo, return error return-value
      825     :
      826   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      828   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      829   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      830   define variable gp-excise     like ub.price-list.excise     no-undo.
      831   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      832   define variable gp-fact-order as decimal   no-undo .
      833   define variable gp-price-sale-parts as decimal   no-undo .
      834       define buffer buf_tax          for ub.tax .
      835       define buffer buf_tax-rate     for ub.tax-rate .
      836       define buffer buf_tax-units    for ub.tax-units .
      837       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      838       define buffer buf_goods        for ub.goods .
      839       define buffer buf_bar-code     for ub.bar-code .
      840       define buffer buf_prod-bc      for ub.prod-bc .
      841       define buffer buf_units        for ub.units .
      842       define buffer buf_shop         for ub.shop .
      843       define buffer buf_store        for ub.store .
      844       define buffer buf_gds-prt      for ub.gds-prt .
      845       define buffer buf_tt-tax       for tt-tax .
      846       define variable varrate-value    as decimal   initial ? no-undo.
      847       define variable pr-list-recid    as recid     initial ? no-undo.
      848       define variable varmes           as character no-undo.
      849       define variable varfactorrtvalue as char      initial ? no-undo.
      850       define variable varfactorrttype  as char      initial ? no-undo.
      851       define variable is-petrolium     as logical no-undo.
      852       define variable is-pieces        as logical no-undo.
      853       define variable vargds-code      like ub.goods.gds-code no-undo.
      854       define variable pargds-code      like ub.goods.gds-code no-undo.
      855       define variable var-fact-order   as decimal no-undo .
      856       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      857       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      858       define variable currate-gds-rc   as recid no-undo .
      859       define variable v-today          as date no-undo .
      860       define variable v-time           as integer no-undo .
      861       for each buf_tt-tax:
      862         delete buf_tt-tax.
      863       end.
      864       run cur-time in this-procedure(output v-today, output v-time).
      865       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      866       if parartic     = ?
      867       or parprod-type = ?
      868       or parprod-code = ?
      869       or parunit-base = ?
      870       then do:
      871         find first buf_goods no-lock
      872           where recid(buf_goods) = parrec-id
      873           no-error .
      874       end.
      875       else do:
      876         find first buf_goods no-lock
      877           where buf_goods.artic = parartic
      878             and buf_goods.prod-type = parprod-type
      879             and buf_goods.prod-code = parprod-code
      880           no-error .
      881       end.
      882       if not available buf_goods then do:
      883         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      884         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      885       end.
      886       assign
      887         parartic     = buf_goods.artic
      888         parprod-type = buf_goods.prod-type
      889         parprod-code = buf_goods.prod-code
      890         parunit-base = buf_goods.unit-base
      891         pargds-code  = buf_goods.gds-code
      892       .
      893       if parunits-type = ?
      894       then do:
      895         find buf_units no-lock
      896           where buf_units.unit-name = parunit-base
      897           no-error .
      898         if not available buf_units then do:
      899           assign
      900             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      901           .
      902           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      903         end.
      904         assign
      905           parunits-type = buf_units.type
      906         .
      907       end.
      908       if parhost-code = ?
      909       or parhost-code = 0
      910       then do:
      911   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      913     (input  parobj-type
      914     ,input  abs(parobj-code)
      915     ,output parhost-code
      916     ) no-error .
      917         if error-status :error then do:
      918           assign
      919             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      920               ,string(parobj-type)
      921               ,string(parobj-code)
      922               ) + chr(10)
      923           .
      924           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      925         end.
      926       end.
      927       assign
      928         vargds-code = buf_goods.gds-code
      929       .
      930       for each buf_tax-units no-lock
      931         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      932       ,first buf_tax no-lock
      933         where buf_tax.tax-code = buf_tax-units.tax-code
      934       :
      935         find first buf_tt-tax where
      936                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      937         if not available buf_tt-tax then do:
      938           create buf_tt-tax .
      939         end.
      940         assign
      941           buf_tt-tax.tax-code = buf_tax.tax-code
      942         .
      943         if buf_tax.individual = false then do:
      944           assign
      945             currate-gds-rc = ?
      946           .
      947           _tax-rate-gds:
      948           for each buf_tax-rate-gds no-lock where
      949                   buf_tax-rate-gds.gds-code = pargds-code and
      950                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      951           first buf_tax-rate where
      952                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      953                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      954           by buf_tax-rate-gds.host-code
      955           by buf_tax-rate-gds.obj-type
      956           by buf_tax-rate-gds.obj-code
      957           by buf_tax-rate-gds.fact-order
      958           :
      959             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      960               next _tax-rate-gds.
      961             end.
      962             if buf_tax-rate-gds.host-code = 0 or
      963               ((buf_tax-rate-gds.host-code = parhost-code) or
      964               (buf_tax-rate-gds.obj-type = parobj-type AND
      965               buf_tax-rate-gds.obj-code = parobj-code))
      966             then do:
      967               assign
      968               currate-code = buf_tax-rate.rate-code
      969               currate-name = buf_tax-rate.rate-name
      970               currate-gds-rc = recid(buf_tax-rate)
      971               .
      972             end.
      973             else do:
      974               next _tax-rate-gds.
      975             end.
      976           end.
      977           if currate-gds-rc = ? then do:
      978             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      979                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      980                             chr(10).
      981             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      982           end.
      983         end.
      984         assign
      985           buf_tt-tax.rate-code   = currate-code
      986           buf_tt-tax.individual  = buf_tax.individual
      987           buf_tt-tax.tax-name    = buf_tax.tax-name
      988           buf_tt-tax.rate-name   = currate-name
      989           buf_tt-tax.tax-type    = buf_tax.tax-type
      990           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
      991           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
      992         .
      993       end.
