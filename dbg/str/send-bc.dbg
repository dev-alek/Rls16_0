    12899       end.
    12900     return "error":U.
    12901   end.
    12902   else do:
    12903     for each temp-cd-plu,
    12904         first buf_cd-plu where
    12905                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    12906                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    12907                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    12908                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    12909                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    12910       if temp-cd-plu.to-del = yes
    12911       and v-del-mrkt-gds
    12912       then do:
    12913         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    12914           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    12915           assign
    12916           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    12917           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    12918           .
    12919         end.
    12920         if buf_cd-plu.charkey_one = '':U then do:
    12921           delete buf_cd-plu.
    12922           NEXT.
    12923         end.
    12924       end.
    12925       if temp-cd-plu.charkey_two = "":U
    12926       then
    12927       assign
    12928       buf_cd-plu.charkey_two = "":U
    12929       buf_cd-plu.to-send = no
    12930       .
    12931       delete temp-cd-plu.
    12932     end.
    12933   end.
    12934   end.
