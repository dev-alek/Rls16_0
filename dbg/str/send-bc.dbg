     4583           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-periodic-tasks in g#attr-lib
     4584         (input  p-db-num
     4585         ,input  p-obj-code
     4586         ,input  p-pos-type
     4587         ,input  p-cash-num
     4588         ,input-output p-value
     4589         ,output p-setted
     4590         ) no-error .
     4591       if error-status :error
     4592       then do:
     4593         undo, return error return-value .
     4594       end.
     4595     end.
     4596   end procedure.
