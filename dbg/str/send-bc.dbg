    14811       first buf_dis-time-rule no-lock
    14812         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    14813       and buf_dis-time-rule.date-to >= v-today
    14814         :
    14815          if buf_dis-gds-rule.obj-type = "" and buf_dis-gds-rule.obj-code = 0 then do:
    14816              find first chk_dis-gds-rule no-lock
    14817              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    14818                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
    14819                    chk_dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type and
    14820                 (( chk_dis-gds-rule.obj-type = 'орг':U  and chk_dis-gds-rule.obj-code = i-host-code ) or
    14821                  ( chk_dis-gds-rule.obj-type = 'маг':U and chk_dis-gds-rule.obj-code = i-obj-code  )) no-error .
    14822              if avail chk_dis-gds-rule then next _buf_dis-gds-rule .
    14823          end.
    14824          if buf_dis-gds-rule.obj-type = 'орг':U and buf_dis-gds-rule.obj-code = i-host-code then do:
    14825              find first chk_dis-gds-rule no-lock
    14826              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    14827                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
    14828                    chk_dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type and
    14829                    chk_dis-gds-rule.obj-type = 'маг':U and
    14830                    chk_dis-gds-rule.obj-code = i-obj-code no-error .
    14831              if avail chk_dis-gds-rule then next _buf_dis-gds-rule .
    14832          end.
    14833          find first buf_gds-obj no-lock
    14834          where buf_gds-obj.gds-code = buf_dis-gds-rule.gds-code
    14835            and buf_gds-obj.obj-type = 'маг':U
    14836            and buf_gds-obj.obj-code = i-obj-code
    14837          no-error.
    14838          if avail buf_gds-obj and
    14839            (( buf_dis-gds-rule.obj-type = ""      and buf_dis-gds-rule.obj-code = 0) or
    14840             ( buf_dis-gds-rule.obj-type = 'орг':U  and buf_dis-gds-rule.obj-code = i-host-code) or
    14841             ( buf_dis-gds-rule.obj-type = 'маг':U and buf_dis-gds-rule.obj-code = i-obj-code))
    14842          then do:
    14843             assign
    14844               v-char-2 = "0,0,0,0,0,0,"
    14845               v-is-weight = false
    14846             .
    14847             find buf_goods where buf_goods.gds-code = buf_dis-gds-rule.gds-code no-lock no-error.
    14848             if avail buf_goods then do:
    14849                 find buf_units where buf_units.unit-name = buf_goods.unit-base no-lock no-error.
    14850                 if avail buf_units then do:
    14851                     if lookup ('вес':U, buf_units.type) > 0 then do:
    14852                         assign
    14853                           v-char-2    = "0,0,0,2,0,0,"
    14854                           v-is-weight = true
    14855                         .
    14856                     end.
    14857                 end.
    14858             end.
    14859             _bdr-attr:
    14860       for each  buf_dis-gds-rule-attr WHERE
    14861                buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
    14862            AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
    14863            AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
    14864            AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
    14865            AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
    14866            and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
    14867                     :
    14868              assign
    14869        v-upd = entry(2,buf_dis-gds-rule-attr.attr-value,",")
    14870                v-ean13 = entry(1,buf_dis-gds-rule-attr.attr-value,",")
    14871        .
    14872              if v-is-weight and length(v-ean13) = 5 then do:
    14873                  def var ncrsc-pfx as char no-undo init "23":U .
    14874                  def var ncrsc-frmt as char no-undo init "EAN13" .
    14875                  assign v-tmpchar = "" .
    14876   define variable vss-include-info123 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14877     define variable tmp-str123  as character no-undo.
    14878     define variable tmp-num123  as character no-undo.
    14879     define variable i123        as integer   no-undo.
    14880     define variable sum123      as integer   no-undo.
    14881     define variable len-code123 as integer   no-undo.
    14882     define variable varcont123  as logical   initial yes no-undo.
    14883     CASE ncrsc-frmt :
    14884       WHEN "EAN13" THEN do:
    14885         assign
    14886           tmp-str123 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "999999999999" )
    14887         .
    14888       end.
    14889       WHEN "EAN8" THEN do:
    14890         assign
    14891           tmp-str123 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "9999999" )
    14892         .
    14893       end.
    14894       OTHERWISE DO:
    14895           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    14896           view-as alert-box error.
    14897           return error.
    14898       END.
    14899     END CASE.
    14900     if varcont123 = yes then do:
    14901       if integer( substring( tmp-str123, 1, length( ncrsc-pfx ) ) ) <> 0
    14902       then do:
    14903         message
    14904           "Невозможно сформировать бар-код" SKIP
    14905           "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U)
    14906           view-as alert-box error title "подрезание кода".
    14907         return error.
    14908       end.
    14909       else do:
    14910         assign
    14911           v-tmpchar = ncrsc-pfx + substring( tmp-str123, length( ncrsc-pfx ) + 1, length( tmp-str123 ) - length( ncrsc-pfx ) )
    14912           len-code123    = length( v-tmpchar )
    14913         .
    14914         define variable v-sum-char123 as character no-undo .
    14915         assign
    14916           sum123 = 0
    14917         .
    14918         do i123 = 1 to len-code123 by 2
    14919         :
    14920           assign
    14921             v-sum-char123 = substr(v-tmpchar, len-code123 - i123 + 1, 1)
    14922           .
    14923           if v-sum-char123 < "0"
    14924           or v-sum-char123 > "9"
    14925           then do:
    14926             message
    14927               "Невозможно сформировать бар-код" skip
    14928               "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    14929               view-as alert-box error title "подсчет контрольной суммы".
    14930             return error.
    14931           end.
    14932           assign
    14933             sum123 = sum123 + integer(v-sum-char123)
    14934           .
    14935         end.
    14936         if varcont123 = yes then do:
    14937           assign
    14938             sum123 = sum123 * 3
    14939           .
    14940           do i123 = 2 to len-code123 by 2
    14941           :
    14942             assign
    14943               v-sum-char123 = substr(v-tmpchar, len-code123 - i123 + 1, 1)
    14944             .
    14945             if v-sum-char123 < "0"
    14946             or v-sum-char123 > "9"
    14947             then do:
    14948               message
    14949                 "Невозможно сформировать бар-код" skip
    14950                 "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    14951                 view-as alert-box error title "подсчет контрольной суммы".
    14952               return error.
    14953             end.
    14954             assign
    14955               sum123 = sum123 + integer(v-sum-char123)
    14956             .
    14957           end.
    14958           if varcont123 = yes then do:
    14959              if sum123 mod 10 = 0 then do:
    14960                assign
    14961                  v-tmpchar = v-tmpchar + '0'
    14962                .
    14963              end.
    14964              else do:
    14965                assign
    14966                  v-tmpchar = v-tmpchar + string(10 - sum123 mod 10)
    14967                .
    14968              end.
    14969           end.
    14970         end.
    14971       end.
    14972     end.
    14973                  if not v-tmpchar = "":U then assign v-ean13 = v-tmpchar .
    14974              end.
    14975              if v-ean13 begins "20" and length(v-ean13) = 13 then next _bdr-attr .
    14976        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    14977         buf_dis-gds-rule-attr.attr-code v-char-delim-1
    14978         "3,MAPKA,"
    14979         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    14980         "0" v-char-delim-1
    14981         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    14982         "0" v-char-delim-1
    14983         v-char-1
    14984         v-char-2
    14985         trim(string(buf_dis-rule.doc-qnty,'>>>>9')) v-char-delim-1
    14986         v-char-3
    14987               v-ean13 v-char-delim-2
    14988         v-char-4
    14989         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    14990         v-char-5
    14991               v-ean13 v-char-delim-2
    14992         v-char-6 v-char-7 skip.
    14993       end.
    14994      end.
    14995    end.
    14996    for each buf_dis-thbj-rule no-lock where buf_dis-thbj-rule.templ-rl-root = 90
    14997                      and buf_dis-thbj-rule.pos-type = 'NCR-AS@R':U,
    14998       first buf_dis-rule no-lock where
    14999           buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
    15000       and buf_dis-rule.sts = integer('0':U),
    15001       first buf_dis-time-rule no-lock
    15002         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    15003           and buf_dis-time-rule.date-to >= v-today
    15004         :
    15005      if (buf_dis-thbj-rule.obj-type = "" and
    15006          buf_dis-thbj-rule.obj-code = 0) or
    15007         (buf_dis-thbj-rule.obj-type = 'орг':U and
    15008          buf_dis-thbj-rule.obj-code = i-host-code) or
    15009         (buf_dis-thbj-rule.obj-type = 'маг':U and
    15010          buf_dis-thbj-rule.obj-code = i-obj-code)
    15011      then
    15012      do:
    15013        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    15014         buf_dis-rule.key#_one v-char-delim-1
    15015         "3,MAPKA,"
    15016         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    15017         "0" v-char-delim-1
    15018         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    15019         "0" v-char-delim-1
    15020         v-char-1
    15021         v-char-21
    15022         "9,0,0,"
    15023         trim(string(buf_dis-rule.tot-sum * 100,">>>>>>>>>9")) v-char-delim-1
    15024         v-char-3
    15025         v-char-41
    15026         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    15027         v-char-5
    15028          v-char-delim-2
    15029         v-char-61 v-char-71 skip.
    15030      end.
    15031    end.
    15032    for each buf_dis-thbj-rule no-lock where buf_dis-thbj-rule.templ-rl-root = 92
    15033                      and buf_dis-thbj-rule.pos-type = 'NCR-AS@R':U,
    15034       first buf_dis-rule no-lock where
    15035           buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
    15036       and buf_dis-rule.sts = integer('0':U),
    15037       first buf_dis-time-rule no-lock
    15038         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    15039           and buf_dis-time-rule.date-to >= v-today
    15040         :
    15041      if (buf_dis-thbj-rule.obj-type = "" and
    15042          buf_dis-thbj-rule.obj-code = 0) or
    15043         (buf_dis-thbj-rule.obj-type = 'орг':U and
    15044          buf_dis-thbj-rule.obj-code = i-host-code) or
    15045         (buf_dis-thbj-rule.obj-type = 'маг':U and
    15046          buf_dis-thbj-rule.obj-code = i-obj-code)
    15047      then
    15048      do:
    15049        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    15050         buf_dis-rule.key#_one v-char-delim-1
    15051         "4,MAPKA,"
    15052         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    15053         "0" v-char-delim-1
    15054         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    15055         "0" v-char-delim-1
    15056         v-char-1
    15057         v-char-21
    15058         "4,1,0,"
    15059         "1" v-char-delim-1
    15060         v-char-3
    15061         v-char-42
    15062         "0" v-char-delim-1
    15063         v-char-5
    15064          v-char-delim-2
    15065         v-char-62 v-char-72 v-char-8 v-char-9 skip.
    15066      end.
    15067    end.
    15068    output stream IBMStream close .
    15069   end procedure .
    15070   procedure get-thbj-rule :
    15071   define input  parameter p-obj-type as character no-undo .
    15072   define input  parameter p-obj-code as integer no-undo .
    15073   define input  parameter p-host-code as integer no-undo .
    15074   define input  parameter p-discnt-role as character no-undo .
    15075   define input  parameter p-pos-type as character   no-undo .
    15076   define input  parameter p-reg-list as character no-undo .
    15077   define parameter buffer  buf_dis-thbj-rule for ub.dis-thbj-rule.
    15078   define variable v-region-type as character no-undo .
    15079   define variable v-region-code as integer   no-undo .
    15080   define variable v-region-host as integer   no-undo .
    15081   define variable v-region-ii as integer   no-undo .
    15082   _v-region-ii:
    15083   do v-region-ii = 1 to 3:
    15084     if lookup(string(v-region-ii), p-reg-list) = 0 then next _v-region-ii.
    15085     case v-region-ii:
    15086       when 1 then do:
    15087         assign
    15088         v-region-type = p-obj-type
    15089         v-region-code = p-obj-code
    15090         v-region-host = p-host-code
    15091         .
    15092       end.
    15093       when 2 then do:
    15094         assign
    15095         v-region-type = ''
    15096         v-region-code = 0
    15097         v-region-host = p-host-code
    15098         .
    15099       end.
    15100       when 3 then do:
    15101         assign
    15102         v-region-type = ''
    15103         v-region-code = 0
    15104         v-region-host = 0
    15105         .
    15106       end.
    15107     end case.
    15108     find first buf_dis-thbj-rule no-lock where
    15109               buf_dis-thbj-rule.obj-type = v-region-type
    15110           and buf_dis-thbj-rule.obj-code = v-region-code
    15111           and buf_dis-thbj-rule.host-code = v-region-host
    15112           and buf_dis-thbj-rule.discnt-role = p-discnt-role
    15113           and buf_dis-thbj-rule.pos-type = p-pos-type no-error.
    15114     if available buf_dis-thbj-rule then do:
    15115       find first buf_dis-rule no-lock where
    15116                 buf_Dis-rule.rule-num = buf_dis-thbj-rule.templ-rl-root no-error.
    15117       if available buf_dis-rule then do:
    15118         run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num
    15119                                               , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    15120       end.
    15121       leave _v-region-ii.
    15122     end.
    15123   end.
    15124   END PROCEDURE.
