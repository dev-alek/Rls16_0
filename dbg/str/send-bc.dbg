     8597                 if not available cash-txr then do:
     8598                   FIND FIRST cash-txr where cash-txr.crf = (cr-txr + 1) No-ERROR.
     8599                   start-paket-txr = no.
     8600                   if not avail cash-txr then
     8601                   create cash-txr.
     8602                   cash-txr.crf = cr-txr + 1.
     8603                   cr-txr = cr-txr + 1.
     8604                   BUFFER-COPY tt-tax USING tax-code rate-code tax-type rate-value
     8605                                       TO  cash-txr
