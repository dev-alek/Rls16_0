     7226   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7227   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7228   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7229   procedure create-dis-rule :
     7230   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7231   define input parameter p-tree as logical no-undo .
     7232   define buffer buf_dis-rule for ub.dis-rule.
     7233   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7234   define buffer term_dis-rule for ub.dis-rule.
     7235   define buffer term_dis-time-rule for ub.dis-time-rule.
     7236   define buffer root_cash-dis-rule for cash-dis-rule.
     7237   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7238   define buffer term_cash-dis-rule for cash-dis-rule.
     7239   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7240     do
     7241     on error undo, return error
     7242     :
     7243       find first root_cash-dis-rule no-lock where                                                         ~
     7244                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7245       if not available root_cash-dis-rule then do:
     7246         find first buf_dis-rule no-lock where
     7247                   buf_dis-rule.rule-num = p-rule-num no-error.
     7248         if available buf_dis-rule then do:
     7249           if buf_dis-rule.time-rule-num <> 0 then do:
     7250             find first buf_dis-time-rule no-lock where
     7251                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7252           end.
     7253           create root_cash-dis-rule.
     7254           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7255           if available buf_dis-time-rule then do:
     7256             find first root_cash-dis-time-rule no-lock where
     7257                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7258             if not available root_cash-dis-time-rule then do:
     7259               create root_cash-dis-time-rule.
     7260               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7261             end.
     7262           end.
     7263           else do:
     7264             assign
     7265             root_cash-dis-rule.time-rule-num = 0.
     7266           end.
     7267           if buf_dis-rule.uniq-field <> "":U then do:
     7268             for each term_dis-rule no-lock where
     7269                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7270               if term_dis-rule.time-rule-num <> 0 then do:
     7271                 find first term_dis-time-rule no-lock where
     7272                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7273               end.
     7274               create term_cash-dis-rule.
     7275               buffer-copy term_dis-rule to term_cash-dis-rule.
     7276               if term_dis-rule.time-rule-num = 0
     7277               or available term_dis-time-rule
     7278               or root_cash-dis-rule.time-rule-num = 0
     7279               then do:
     7280                 if available term_dis-time-rule then do:
     7281                   find first term_cash-dis-time-rule no-lock where
     7282                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7283                   if not available term_cash-dis-time-rule then do:
     7284                     create term_cash-dis-time-rule.
     7285                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7286                   end.
     7287                 end.
     7288               end.
     7289             end.
     7290           end.
     7291         end.
     7292       end.
     7293     end.
     7294   end procedure.
     7295   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7296   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7297   function ncr-amnt-disc returns character (
     7298     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7299   define variable v-result as character no-undo .
     7300   define variable ii as integer no-undo .
     7301   define variable v-entry as character no-undo extent 3.
     7302   for each cash-dis-rule  no-lock where
     7303         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7304     assign
     7305     ii = ii + 1
     7306     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7307                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7308     .
     7309   end.
     7310   if v-entry[2] = "":U then
     7311   assign
     7312   v-entry[2] = v-entry[1]
     7313   .
     7314   if v-entry[3] = "":U then
     7315   assign
     7316   v-entry[3] = v-entry[2]
     7317   .
     7318   assign
     7319   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7320   .
     7321   return v-result.
     7322   END FUNCTION.
     7323   function ncr-date-disc returns character (
     7324     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7325   define variable v-result as character no-undo .
     7326   define variable ii as integer no-undo .
     7327   define variable v-entry as character no-undo extent 3.
     7328   for each cash-dis-rule  no-lock where
     7329         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7330       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7331     assign
     7332     ii = ii + 1
     7333     v-entry[ii] =
     7334                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7335                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7336                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7337                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7338                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7339                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7340                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7341   end.
     7342   if v-entry[2] = "":U then
     7343   assign
     7344   v-entry[2] = v-entry[1]
     7345   .
     7346   if v-entry[3] = "":U then
     7347   assign
     7348   v-entry[3] = v-entry[2]
     7349   .
     7350   assign
     7351   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7352   .
     7353   return v-result.
     7354   END FUNCTION.
     7355   function ncr-temp-disc returns character (
     7356     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7357   define variable v-result as character no-undo .
     7358   define variable ii as integer no-undo .
     7359   define variable v-entry as character no-undo extent 3.
     7360   define variable v-dec as decimal no-undo .
     7361   define variable v-disc-price-sale as decimal no-undo .
     7362   define variable v-pdf-id as integer no-undo .
     7363   define variable v-pdf-db-num as integer no-undo .
     7364   define buffer buf_cash-dis-rule for cash-dis-rule.
     7365   find first buf_cash-dis-rule where
     7366            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7367   if not available buf_cash-dis-rule then return "":U.
     7368   if buf_cash-dis-rule.templ-rl-root <> 29
     7369   and buf_cash-dis-rule.templ-rl-root <> 86
     7370   then do:
     7371     assign
     7372     v-entry[1] =
     7373     "000"                                                   +
     7374     "0"                                                     +
     7375     "0000"                                                  +
     7376     "2359"                                                     +
     7377      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7378      .
     7379   end.
     7380   else do:
     7381     for each cash-dis-rule  no-lock where
     7382           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7383         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7384       case cash-dis-rule.value-type:
     7385         when integer('1':U) then do:
     7386           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7387         end.
     7388         when integer('12':U) then do:
     7389           find first cash-gds-discnt where
     7390                     cash-gds-discnt.b-code = cash-gds.b-code
     7391                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7392                 and cash-gds-discnt.obj-type = 'маг':U
     7393                 and cash-gds-discnt.obj-code = i-obj-code
     7394                 no-error.
     7395           if not available cash-gds-discnt then do:
     7396             v-dec = cash-gds.price-sale.
     7397           end.
     7398           else do:
     7399             assign
     7400             v-dec = cash-gds-discnt.discnt-value
     7401             .
     7402           end.
     7403         end.
     7404         otherwise do:
     7405           v-dec = cash-gds.price-sale.
     7406         end.
     7407       end case.
     7408       assign
     7409       ii = ii + 1
     7410       v-entry[ii] =
     7411                     "000"                                                   +
     7412                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7413                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7414                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7415                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7416                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7417                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7418                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7419                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7420                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7421                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7422                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7423       .
     7424   if ii = 3 then leave.
     7425     end.
     7426   end.
     7427   if v-entry[2] = "":U then
     7428   assign
     7429   v-entry[2] = v-entry[1]
     7430   .
     7431   if v-entry[3] = "":U then
     7432   assign
     7433   v-entry[3] = v-entry[2]
     7434   .
     7435   assign
     7436   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7437   .
     7438   return v-result.
     7439   END FUNCTION.
     7440   function ncr-d-rank returns character (
     7441     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7442   define variable v-result as character no-undo .
     7443   define variable ii as integer no-undo .
     7444   do ii = 1 to length(p-d-rank):
     7445     CASE substr(p-d-rank, ii, 1):
     7446       when "X":U then do:
     7447         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7448       end.
     7449       when "T":U then do:
     7450         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7451       end.
     7452       when "D":U then do:
     7453         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7454       end.
     7455     END CASE.
     7456     if v-result <> "":U then LEAVE.
     7457   end.
     7458   if v-result = "":U then v-result = chr(32).
     7459   return v-result.
     7460   END FUNCTION.
     7461   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7462       define variable v-upper-code as int no-undo.
     7463       define variable v-value as character no-undo.
     7464       define variable v-type as character no-undo.
     7465       define buffer lc_gds-grp for ub.gds-grp.
     7466       define buffer lc_goods for ub.goods.
     7467      if p-gds-code <> 0 then do:
     7468       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7469       v-upper-code = lc_goods.grp-code.
     7470       do while v-upper-code > 0 :
     7471           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7472           run ggoattr-value(
     7473             input lc_gds-grp.node-code,
     7474             input 0,
     7475             input "",
     7476             input 0,
     7477             input 'ban-sales-via-cd':U,
     7478             output v-value,
     7479             output v-type
     7480           ).
     7481          if v-value = "yes" then
     7482             return true.
     7483          else
     7484          do:
     7485             run ggoattr-value(
     7486                input lc_gds-grp.node-code,
     7487                input shop.host-code,
     7488                input "",
     7489                input 0,
     7490                input 'ban-sales-via-cd':U,
     7491                output v-value,
     7492                output v-type
     7493                ).
     7494             if v-value = "yes" then
     7495                return true.
     7496             else
     7497             do:
     7498                run ggoattr-value(
     7499                   input lc_gds-grp.node-code,
     7500                   input shop.host-code,
     7501                   input 'маг':U,
     7502                   input i-obj-code,
     7503                   input 'ban-sales-via-cd':U,
     7504                   output v-value,
     7505                   output v-type
     7506                   ).
     7507                if v-value = "yes" then
     7508                   return true.
     7509                else v-upper-code = lc_gds-grp.upper-code.
     7510             end .
     7511          end.
     7512         end.
     7513       end.
     7514   end.
     7515   FUNCTION convert-tax-code returns integer
     7516                                             ( input p-rate-code as integer
     7517                                              ,input p-cdtaxlst  as character
     7518                                             ) :
     7519   define variable jj as integer no-undo .
     7520     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7521       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7522         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7523       end.
     7524     end.
     7525   END FUNCTION.
     7526   FUNCTION convert-maria-tax-code returns character
     7527                                             ( input p-vat-rate-code as integer
     7528                                              ,input p-slt-rate-code as integer
     7529                                              ,input p-cdtaxlst  as character
     7530                                             ) :
     7531   define variable jj as integer no-undo .
     7532   define variable aa as character no-undo extent 8.
     7533   define variable v-return-value as character no-undo .
     7534     do jj = 1 to 8:
     7535       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7536         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7537           aa[jj] = '1'.
     7538         end.
     7539         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7540           aa[jj] = '1'.
     7541         end.
     7542       end.
     7543       if aa[jj] = '':U then aa[jj] = '0'.
     7544       v-return-value = aa[jj] + v-return-value.
     7545     end.
     7546   return v-return-value.
     7547   END FUNCTION.
     7548   FUNCTION convert-maria-tax-code-2 returns integer
     7549                                             ( input p-rate-code as integer
     7550                                              ,input p-cdtaxlst  as character
     7551                                             ) :
     7552   define variable jj as integer no-undo .
     7553   define variable v-return-value as integer no-undo .
     7554     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7555       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7556         return jj.
     7557       end.
     7558     end.
     7559   return 0.
     7560   END FUNCTION.
