    14091   PROCEDURE putc-13.
    14092   define parameter buffer buf_cash-desk for ub.cash-desk.
    14093   define input parameter pos-type as char no-undo.
    14094   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    14095   define input parameter p-call-from-goods as logical no-undo .
    14096   define variable ii as integer no-undo .
    14097   define variable v-rate-code like ub.tax-rate.rate-code no-undo .
    14098   define variable v-envd as LOGICAL no-undo .
    14099   define variable v-plu as integer no-undo .
    14100   define buffer buf_tax-rate for ub.tax-rate.
    14101   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
    14102   if cash-txr.rate-value = ?
    14103   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
    14104   then do:
    14105       run write-log-and-file in p-log-handle (
    14106             input 1
    14107           , input log-file-name
    14108           , input 1
    14109           , input substitute( "!!!Для маг &1 ставка налога &2 НЕ ОПРЕДЕЛЕНА"
    14110                               ,buf_cash-desk.obj-code
    14111                               ,cash-txr.rate-code
    14112                             )
    14113                                             ).
    14114       v-view-log = yes.
    14115       return '':U .
    14116   end.
    14117   CASE pos-type:
    14118     when 'IBM':U then do:
    14119      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
    14120         PUT stream IBMstream unformatted
    14121         '13 "'
    14122         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    14123         then "D"
    14124         else string( action, "x(1)" )
    14125         '" '
    14126         cash-txr.tax-code format "9"
    14127         ' '
    14128         cash-txr.rate-code
    14129         ' '
    14130         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    14131         (if cash-txr.rate-value = ?
    14132           then 0
    14133           else cash-txr.rate-value) format ">>>>>>>>>9.99"
    14134         chr(10).
    14135       end.
    14136       else do:
    14137         _do:
    14138         do ii = 1 to num-entries(cdtaxlst, ";":U):
    14139           assign
    14140           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
    14141           no-error .
    14142           if error-status:error then do:
    14143             message
    14144             "Неверное значение настроечного параметра cdtaxlst" cdtaxlst
    14145             view-as alert-box error .
    14146             return error .
    14147           end.
    14148           find first buf_tax-rate no-lock where
    14149                     buf_tax-rate.rate-code = v-rate-code no-error .
    14150           if not available buf_tax-rate then do:
    14151             run write-log-and-file in p-log-handle (
    14152                   input 1
    14153                 , input log-file-name
    14154                 , input 1
    14155                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
    14156                                     ,buf_cash-desk.obj-code
    14157                                     ,v-rate-code
    14158                                     ,buf_Cash-desk.pos-type
    14159                                   )
    14160                                                   ).
    14161             v-view-log = yes.
    14162             return error .
    14163           end.
    14164           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
    14165             PUT stream IBMstream unformatted
    14166             '13 "'
    14167             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    14168             then "D"
    14169             else string( action, "x(1)" )
    14170             '" '
    14171             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
    14172             ' '
    14173             cash-txr.rate-code
    14174             ' '
    14175             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    14176             (if cash-txr.rate-value = ?
    14177             then 0
    14178             else cash-txr.rate-value) format ">>>>>>>>>9.99"
    14179             chr(10).
    14180           end.
    14181         end.
    14182       end.
    14183     end.
    14184     when 'IBM-XML':U then do:
    14185         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
    14186                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
    14187                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
    14188          if AVAILABLE buf_tax-rate-attr then do:
    14189              v-envd = yes .
    14190          end.
    14191          else v-envd = no .
    14192       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    14193                                             , input "":U).
    14194       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    14195                                             , input string(cash-txr.rate-code), input 1 ).
    14196       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    14197                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    14198       if v-envd then do:
    14199       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14200                                             , input string(-1), input 1 ).
    14201       end.
    14202       else do:
    14203       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14204                                             , input string(if cash-txr.rate-value = ?
    14205                                                            then 0
    14206                                                            else cash-txr.rate-value), input 1 ).
    14207       end.
    14208       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    14209                                             , input string(1), input 1 ).
    14210       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    14211     end.
    14212     when 'MAGIA-XML':U then do:
    14213       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    14214                                             , input "":U).
    14215       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    14216                                             , input string(cash-txr.rate-code), input 1 ).
    14217       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    14218                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    14219       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14220                                             , input string(if cash-txr.rate-value = ?
    14221                                                            then 0
    14222                                                            else cash-txr.rate-value), input 1 ).
    14223       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    14224                                             , input string(1), input 1 ).
    14225       run bgelib-tag-put in this-procedure ( input 4, input "TCLock"
    14226                                             , input string(if cash-txr.news-action
    14227                                                            OR cash-txr.status_ <> 'тек':U
    14228                                                            then 1
    14229                                                            else 0), input 1 ).
    14230       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    14231     end.
    14232     when 'MARIA':U then do:
    14233     end.
    14234   END CASE .
    14235   END PROCEDURE .
    14236   procedure get-o-attr :
    14237   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    14238   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    14239   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    14240   define output parameter par-std-discnt-rule as integer no-undo .
    14241   define output parameter par-temp-disc-rule as integer no-undo .
    14242   define output parameter par-temp-disc-method as character no-undo .
    14243   define output parameter par-wd-rule as integer no-undo .
    14244   define output parameter par-fp as logical no-undo .
    14245   define output parameter par-grp-code as integer no-undo init 1.
    14246   define output parameter par-petrol-purse as logical no-undo .
    14247   define output parameter par-need-auth as logical no-undo .
    14248   define output parameter par-qnty-discnt-rule as integer no-undo .
    14249   define output parameter par-kat-discnt-rule as integer no-undo .
    14250   define output parameter par-kat-discnt-method as character no-undo .
    14251   define output parameter par-date-discnt-rule as integer no-undo .
    14252   define output parameter par-abs-discnt-rule as integer no-undo .
    14253   define output parameter par-tot-discnt-rule as integer no-undo .
    14254   define output parameter par-wgd-rule as integer no-undo .
    14255   define output parameter par-taracode as character no-undo .
    14256   define buffer loc-gds-obj-attr for ub.gds-obj-attr.
    14257   define buffer loc-dis-gds-rule for ub.dis-gds-rule.
    14258   define buffer buf_dis-rule for ub.dis-rule.
    14259   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
    14260   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    14261     do
    14262     on error undo, return error
    14263     :
    14264       for each  loc-gds-obj-attr No-LOCK  where
    14265                 loc-gds-obj-attr.gds-code = par-gds-code AND
    14266                 loc-gds-obj-attr.obj-code = par-obj-code AND
    14267                 loc-gds-obj-attr.obj-type = par-obj-type :
    14268         CASE loc-gds-obj-attr.attr-code:
    14269           when 'free-price':U  then do:
    14270             assign
    14271             par-fp =  if loc-gds-obj-attr.attr-value = "yes"
    14272                       then yes
    14273                       else no
    14274             .
    14275           end.
    14276           when 'sum-grp':U then do:
    14277             assign
    14278             par-grp-code =  integer(loc-gds-obj-attr.attr-value) no-error
    14279             .
    14280           end.
    14281           when 'petrol-purse':U then do:
    14282             assign
    14283             par-petrol-purse =  if loc-gds-obj-attr.attr-value = "yes"
    14284                                 then yes
    14285                                 else no
    14286             .
    14287           end.
    14288           when 'need-auth':U then do:
    14289             assign
    14290             par-need-auth =  if loc-gds-obj-attr.attr-value = "yes"
    14291                                 then yes
    14292                                 else no
    14293             .
    14294           end.
    14295           when 'taracode':U  then do:
    14296             assign
    14297             par-taracode = loc-gds-obj-attr.attr-value no-error
    14298             .
    14299           end.
    14300         END CASE.
    14301       end.
    14302       define variable v-par-log as logical no-undo .
    14303      find first loc-dis-gds-rule where
    14304                 loc-dis-gds-rule.gds-code = par-gds-code
    14305             and loc-dis-gds-rule.pos-type = dflt-cd
    14306             and loc-dis-gds-rule.obj-type = ''
    14307             and loc-dis-gds-rule.obj-code = 0
    14308             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    14309       if available loc-dis-gds-rule then do:
    14310         par-wgd-rule = loc-dis-gds-rule.rule-num.
    14311       end.
    14312       find first loc-dis-gds-rule where
    14313                 loc-dis-gds-rule.gds-code = par-gds-code
    14314             and loc-dis-gds-rule.pos-type = dflt-cd
    14315             and loc-dis-gds-rule.obj-type = ''
    14316             and loc-dis-gds-rule.obj-code = 0
    14317             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    14318       if available loc-dis-gds-rule then do:
    14319         par-wd-rule = loc-dis-gds-rule.rule-num.
    14320       end.
    14321       define variable loc-host-code as integer no-undo .
    14322   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    14324     (input  par-obj-type
    14325     ,input  par-obj-code
    14326     ,output loc-host-code
    14327     )  .
    14328       find first loc-dis-gds-rule where
    14329                 loc-dis-gds-rule.gds-code = par-gds-code
    14330             and loc-dis-gds-rule.pos-type = dflt-cd
    14331             and loc-dis-gds-rule.obj-type = 'орг':U
    14332             and loc-dis-gds-rule.obj-code = loc-host-code
    14333             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    14334       if available loc-dis-gds-rule then do:
    14335         par-wgd-rule = loc-dis-gds-rule.rule-num.
    14336       end.
    14337       find first loc-dis-gds-rule where
    14338                 loc-dis-gds-rule.gds-code = par-gds-code
    14339             and loc-dis-gds-rule.pos-type = dflt-cd
    14340             and loc-dis-gds-rule.obj-type = 'орг':U
    14341             and loc-dis-gds-rule.obj-code = loc-host-code
    14342             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    14343       if available loc-dis-gds-rule then do:
    14344         par-wd-rule = loc-dis-gds-rule.rule-num.
    14345       end.
    14346       if par-wd-rule > 0 then do:
    14347         find first buf_dis-rule no-lock where
    14348                   buf_Dis-rule.rule-num = par-wd-rule no-error.
    14349         if available buf_dis-rule then do:
    14350           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    14351                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14352         end.
    14353       end.
    14354       if par-wgd-rule > 0 then do:
    14355         find first buf_dis-rule no-lock where
    14356                   buf_Dis-rule.rule-num = par-wgd-rule no-error.
    14357         if available buf_dis-rule then do:
    14358           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    14359                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14360         end.
    14361       end.
    14362       for each  loc-dis-gds-rule No-LOCK  where
    14363                 loc-dis-gds-rule.gds-code = par-gds-code
    14364            AND  loc-dis-gds-rule.obj-code = par-obj-code
    14365            AND  loc-dis-gds-rule.obj-type = par-obj-type
    14366            and  loc-dis-gds-rule.pos-type = dflt-cd :
    14367         CASE loc-dis-gds-rule.discnt-role:
    14368           when 'std-disc':U then do:
    14369             assign
    14370             par-std-discnt-rule = loc-dis-gds-rule.rule-num
    14371             .
    14372           end.
    14373           when 'temp-disc':U then do:
    14374             if loc-dis-gds-rule.nonunique = ''
    14375             then do:
    14376             assign
    14377             par-temp-disc-rule = loc-dis-gds-rule.rule-num
    14378             .
    14379           end.
    14380             else do:
    14381               if par-temp-disc-method = '' then do:
    14382                 find first buf_dis-cfg-rule no-lock where
    14383                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    14384                       and buf_dis-cfg-rule.pos-type = dflt-cd
    14385                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    14386                 assign
    14387                 par-temp-disc-method = (if available buf_dis-cfg-rule
    14388                                         then buf_dis-cfg-rule.nonunique
    14389                                         else chr(63))
    14390                 .
    14391               end.
    14392               create buf_temp-dis-gds-rule.
    14393               buffer-copy
    14394               loc-dis-gds-rule
    14395               to
    14396               buf_temp-dis-gds-rule
    14397               .
    14398               release buf_temp-dis-gds-rule.
    14399             end.
    14400           end.
    14401           when 'pcnt-kat':U then do:
    14402             if loc-dis-gds-rule.nonunique = ''
    14403             then do:
    14404               assign
    14405               par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    14406               .
    14407             end.
    14408             else do:
    14409               if par-kat-discnt-method = '' then do:
    14410                 find first buf_dis-cfg-rule no-lock where
    14411                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    14412                       and buf_dis-cfg-rule.pos-type = dflt-cd
    14413                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    14414                 assign
    14415                 par-kat-discnt-method = (if available buf_dis-cfg-rule
    14416                                         then buf_dis-cfg-rule.nonunique
    14417                                         else chr(63))
    14418                 .
    14419               end.
    14420               create buf_temp-dis-gds-rule.
    14421               buffer-copy
    14422               loc-dis-gds-rule
    14423               to
    14424               buf_temp-dis-gds-rule
    14425               .
    14426               release buf_temp-dis-gds-rule.
    14427             end.
    14428           end.
    14429           when 'pcnt-date':U then do:
    14430             assign
    14431             par-date-discnt-rule = loc-dis-gds-rule.rule-num
    14432             .
    14433           end.
    14434           when 'without-disc':U then do:
    14435             assign
    14436             par-wd-rule =  loc-dis-gds-rule.rule-num
    14437             .
    14438           end.
    14439           when 'without-gds-disc':U then do:
    14440             assign
    14441             par-wgd-rule =  loc-dis-gds-rule.rule-num
    14442             .
    14443           end.
    14444           when 'pcnt-qnty':U then do:
    14445             assign
    14446             par-qnty-discnt-rule = loc-dis-gds-rule.rule-num
    14447             .
    14448           end.
    14449           when 'pcnt-kat':U  then do:
    14450             assign
    14451             par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    14452             .
    14453           end.
    14454           when 'abs-disc':U  then do:
    14455             assign
    14456             par-abs-discnt-rule = loc-dis-gds-rule.rule-num
    14457             .
    14458           end.
    14459           when 'pcnt-tot':U  then do:
    14460             assign
    14461             par-tot-discnt-rule = loc-dis-gds-rule.rule-num
    14462             .
    14463           end.
    14464         END CASE.
    14465         find first buf_dis-rule no-lock where
    14466                   buf_Dis-rule.rule-num = loc-dis-gds-rule.templ-rl-root no-error.
    14467         if available buf_dis-rule then do:
    14468           run create-dis-rule in this-procedure ( input loc-dis-gds-rule.rule-num
    14469                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14470         end.
    14471       end.
    14472     end.
    14473   end procedure.
    14474   procedure get-gds-obj-fields :
    14475   define parameter buffer buf_gds-obj for ub.gds-obj .
    14476   define input parameter par-find-buffer as logical no-undo .
    14477   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    14478   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    14479   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    14480   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
    14481   define output parameter par-cash-parts as logical no-undo .
    14482   define output parameter p-is-null-price              like ub.fbr-gds-obj.is-null-price  no-undo .
    14483   define output parameter p-is-menu                    like ub.fbr-gds-obj.is-menu no-undo .
    14484   define output parameter p-is-semi-finished           like ub.fbr-gds-obj.is-semi-finished no-undo .
    14485   define output parameter p-is-modificator             like ub.fbr-gds-obj.is-semi-finished no-undo .
    14486   define output parameter p-fbr-grp-code               like ub.fbr-gds-grp.node-code no-undo .
    14487   define output parameter p-fbr-obj-code               like ub.fbr-gds-obj.fbr-obj-code no-undo .
    14488     do
    14489     on error undo, return error
    14490     :
    14491       if par-find-buffer then do:
    14492         find first buf_gds-obj no-lock where
    14493                   buf_gds-obj.gds-code = par-gds-code AND
    14494                   buf_gds-obj.obj-type = par-obj-type AND
    14495                   buf_gds-obj.obj-code = par-obj-code no-error .
    14496       end.
    14497       if not avail buf_gds-obj
    14498       and ub.shop.is-catering = no
    14499       then do:
    14500         return.
    14501       end.
    14502       assign
    14503       par-fact-qnty = (if available buf_gds-obj
    14504                        then buf_gds-obj.fact-qnty
    14505                        else 0)
    14506       .
    14507       assign
    14508       par-cash-parts = (if available buf_gds-obj
    14509                         then buf_gds-obj.cash-parts
    14510                         else no)
    14511       .
    14512       if available buf_fbr-gds-obj then do:
    14513         assign
    14514         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
    14515         p-is-menu           =  buf_fbr-gds-obj.is-menu
    14516         p-is-semi-finished  =  buf_fbr-gds-obj.is-semi-finished
    14517         p-is-modificator    =  buf_fbr-gds-obj.is-modificator
    14518         p-fbr-grp-code      =  buf_fbr-gds-obj.fbr-grp-code
    14519         p-fbr-obj-code      =  buf_fbr-gds-obj.fbr-obj-code
    14520         .
    14521       end.
    14522     end.
    14523   end procedure.
    14524   procedure get-prt-and-unit :
    14525   define input parameter par-prt-root like ub.goods.prt-root no-undo .
    14526   define input parameter par-unit-base like ub.goods.unit-base no-undo .
    14527   define output parameter par-empty-scale as logical no-undo .
    14528     do
    14529     on error undo, return error
    14530     :
    14531       FIND FIRST ub.gds-prt where
    14532                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
    14533       assign
    14534       par-empty-scale = NOT (ub.shop.doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
    14535       .
    14536       FIND FIRST ub.units WHERE
    14537                  ub.units.unit-name = par-unit-base NO-LOCK .
    14538     end.
    14539   end procedure.
    14540   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14541   procedure create-ncr-kat-discnt :
    14542   define input parameter p-subject-code as character no-undo .
    14543   define input parameter p-cd-subject-code as character no-undo .
    14544   define input parameter p-subject-name as character no-undo .
    14545   define input parameter p-dis-rule-num like ub.dis-rule.rule-num no-undo .
    14546   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
    14547   define input parameter p-tree as character no-undo .
    14548   define input parameter p-discnt as decimal no-undo .
    14549   define variable v-dis-rule-num as integer no-undo .
    14550   define variable v-tree as logical no-undo init yes.
    14551   define variable v-discnt as decimal no-undo .
    14552   define variable v-dis-kat as integer   no-undo .
    14553   define buffer buf_cash-dis-rule for cash-dis-rule.
    14554   define buffer buf_cash-dis-time-rule for cash-dis-time-rule.
    14555   define buffer slave_cash-dis-rule for cash-dis-rule.
    14556     do
    14557     on error undo, return error
    14558     :
    14559       v-discnt = p-discnt.
    14560       if p-dis-rule-num > 0 then do:
    14561         find first buf_cash-dis-rule no-lock where
    14562                   buf_cash-dis-rule.rule-num = p-dis-rule-num no-error.
    14563         if not available buf_cash-dis-rule
    14564         or (buf_cash-dis-rule.templ-rl-root <> p-templ-rl-root
    14565            and
    14566            p-templ-rl-root <> ?)
    14567         then do:
    14568           return error .
    14569         end.
    14570         if p-templ-rl-root = ? then do:
    14571           p-templ-rl-root = buf_cash-dis-rule.templ-rl-root.
    14572         end.
    14573         if buf_cash-dis-rule.uniq-field = ''
    14574         or buf_cash-dis-rule.is-term
    14575         then do:
    14576           v-tree = no.
    14577           v-dis-rule-num = buf_cash-dis-rule.upper-rule-num.
    14578         end.
    14579         if buf_cash-dis-rule.time-rule-num > 0 then do:
    14580           find first buf_cash-dis-time-rule no-lock where
    14581                   buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    14582           if not available buf_cash-dis-time-rule then do:
    14583             return error .
    14584           end.
    14585           release buf_cash-dis-time-rule.
    14586         end.
    14587           _buf-cash-dis-rule:
    14588           for each buf_cash-dis-rule no-lock where
    14589                   buf_cash-dis-rule.upper-rule-num = (if v-tree then p-dis-rule-num else v-dis-rule-num):
    14590             if not v-tree then do:
    14591               find first slave_cash-dis-rule no-lock where
    14592                   slave_cash-dis-rule.rule-num = v-dis-rule-num .
    14593               assign v-dis-kat = slave_cash-dis-rule.dis-kat .
    14594               if buf_cash-dis-rule.rule-num <> p-dis-rule-num then next _buf-cash-dis-rule.
    14595             end.
    14596             else
    14597              do:
    14598                assign v-dis-kat = buf_cash-dis-rule.dis-kat .
    14599              end .
    14600             if buf_cash-dis-rule.time-rule-num > 0 then do:
    14601               find first buf_cash-dis-time-rule no-lock where
    14602                         buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    14603               if not available buf_cash-dis-time-rule then next _buf-cash-dis-rule.
    14604             end.
    14605             FIND FIRST cash-ncr-dis-kat where
    14606                     cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    14607             if not avail cash-ncr-dis-kat then do:
    14608               create cash-ncr-dis-kat.
    14609               error-status:error = false.
    14610             end.
    14611             cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    14612             cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    14613             if buf_cash-dis-rule.value-type = integer('12':U) then do:
    14614               find first cash-gds-discnt where
    14615                         cash-gds-discnt.b-code = integer(p-subject-code)
    14616                     and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    14617                     and cash-gds-discnt.obj-type = 'маг':U
    14618                     and cash-gds-discnt.obj-code = i-obj-code
    14619                     no-error.
    14620               if available cash-gds-discnt then do:
    14621                 assign
    14622                 v-discnt = cash-gds-discnt.discnt-value
    14623                 .
    14624               end.
    14625               else do:
    14626                 v-discnt = p-discnt.
    14627               end.
    14628             end.
    14629             assign
    14630             cash-ncr-dis-kat.subject-code  =  p-subject-code
    14631             cash-ncr-dis-kat.cd-subject-code  =  p-cd-subject-code
    14632             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20)
    14633             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20) +
    14634                                                ( if length(p-subject-name) < 20 then fill( chr(32) , 20 - length(p-subject-name) ) else '' )
    14635             cash-ncr-dis-kat.dis-kat =  (if v-dis-kat < 0 then 0 else v-dis-kat)
    14636             cash-ncr-dis-kat.rule-num = buf_cash-dis-rule.rule-num
    14637             cash-ncr-dis-kat.time-rule-num = buf_cash-dis-rule.time-rule-num
    14638             cash-ncr-dis-kat.cd-disc-string   = "****":U  +
    14639                                             (if buf_cash-dis-rule.templ-rl-root = 89
    14640                                              then '80'
    14641                                              else (if buf_cash-dis-rule.discnt-value > 0
    14642                                                    then '80':U
    14643                                                    else '00':U)
    14644                                              )
    14645             .
    14646             if p-tree = 'time-rule-num':U then do:
    14647               if available buf_cash-dis-time-rule
    14648               and buf_cash-dis-time-rule.value-type <> '0':U
    14649               then do:
    14650                 assign
    14651                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    14652                                               (if buf_cash-dis-time-rule.value-type = '2':U
    14653                                                 then
    14654                                                 ("D":U + substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 9, 2) +
    14655                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 4, 2) +
    14656                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 1, 2) +
    14657                                                         "-":U +
    14658                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 9, 2) +
    14659                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 4, 2) +
    14660                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 1, 2)
    14661                                                 )
    14662                                                 else
    14663                                                 ("T00":U +
    14664                                                           (if buf_cash-dis-time-rule.week-day-0  then "0" else "":U) +
    14665                                                           (if buf_cash-dis-time-rule.week-day-1  then "2" else "":U) +
    14666                                                           (if buf_cash-dis-time-rule.week-day-2  then "3" else "":U) +
    14667                                                           (if buf_cash-dis-time-rule.week-day-3  then "4" else "":U) +
    14668                                                           (if buf_cash-dis-time-rule.week-day-4  then "5" else "":U) +
    14669                                                           (if buf_cash-dis-time-rule.week-day-5  then "6" else "":U) +
    14670                                                           (if buf_cash-dis-time-rule.week-day-6  then "7" else "":U) +
    14671                                                           (if buf_cash-dis-time-rule.week-day-7  then "1" else "":U) +
    14672                                                         chr(47) +
    14673                                                         replace(string(buf_cash-dis-time-rule.time-from, "HH:MM"), ':':U, '':U) + "-":U +
    14674                                                         replace(string(buf_cash-dis-time-rule.time-to, "HH:MM"), ':':U, '':U)
    14675                                                 )
    14676                                               )
    14677                 .
    14678               end.
    14679               else do:
    14680                 assign
    14681                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string + "D000101-991231":U
    14682                 .
    14683               end.
    14684             end.
    14685             if p-tree = 'tot-sum':U then do:
    14686               assign
    14687               cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    14688               '>' + replace(string(round(buf_cash-dis-rule.tot-sum, 2), '99999999999.99'), '.':u , '':U)
    14689               .
    14690             end.
    14691             assign
    14692             cash-ncr-dis-kat.cd-other =   fill(chr(32), 10) +  "xx ":U +
    14693                                           (if buf_cash-dis-rule.value-type = integer('12':U)
    14694                                            or buf_cash-dis-rule.value-type = integer('3':U)
    14695                                           then "=":U
    14696                                           else "%":U) +
    14697                                           replace(string(abs(if v-discnt <> ? then v-discnt else buf_cash-dis-rule.discnt-value),"9999999.9"), '.':U, '':U)
    14698             .
    14699           end.
    14700       end.
    14701       else do:
    14702         FIND FIRST cash-ncr-dis-kat where
    14703                 cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    14704         if not avail cash-ncr-dis-kat then do:
    14705         create cash-ncr-dis-kat.
    14706         error-status:error = false.
    14707         end.
    14708         cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    14709         cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    14710         assign
    14711         cash-ncr-dis-kat.subject-code  = p-subject-code
    14712         cash-ncr-dis-kat.cd-subject-code  = p-cd-subject-code
    14713         cash-ncr-dis-kat.cd-subject-name  = p-subject-name
    14714         cash-ncr-dis-kat.dis-kat =  - 1
    14715         cash-ncr-dis-kat.rule-num = 0
    14716         cash-ncr-dis-kat.time-rule-num = 0
    14717         .
    14718       end.
    14719     end.
    14720   end procedure.
    14721   procedure output-ncr-bonus:
    14722   define input parameter i-host-code as integer no-undo .
    14723   define input parameter i-obj-code  as integer no-undo .
    14724   define input parameter out         as character no-undo .
    14725   define output parameter fname      as character no-undo .
    14726   def var v-found as log no-undo .
    14727   def var v-upd   as char no-undo .
    14728   def var v-ver   as char no-undo .
    14729   def var v-char-delim-1  as char initial ',' no-undo .
    14730   def var v-char-delim-2  as char initial ';' no-undo .
    14731   def var v-char-1        as char no-undo .
    14732   def var v-char-2        as char no-undo .
    14733   def var v-char-21       as char no-undo .
    14734   def var v-char-3        as char no-undo .
    14735   def var v-char-4        as char no-undo .
    14736   def var v-char-41       as char no-undo .
    14737   def var v-char-42       as char no-undo .
    14738   def var v-char-5        as char no-undo .
    14739   def var v-char-6        as char no-undo .
    14740   def var v-char-61       as char no-undo .
