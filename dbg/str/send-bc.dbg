      111   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   def new shared var bc-frmt as character no-undo .
      113   def new shared var bc-pfx  as character no-undo .
      114   def var bc-par-type as character no-undo .
      115       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      116       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      117           do:
      118               message "Не задан или не верно задан ТИП собственного бар-кода!"
      119                   view-as alert-box ERROR TITLE "".
      120               return error.
      121           end.
      122       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      123       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      124           do:
      125               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      126                   view-as alert-box ERROR TITLE "".
      127               return error.
      128           end.
      129   PROCEDURE gen-bc:
      130     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      131     def output parameter full-b-code     as character init ""    no-undo .
      132   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133     define variable tmp-str3  as character no-undo.
      134     define variable tmp-num3  as character no-undo.
      135     define variable i3        as integer   no-undo.
      136     define variable sum3      as integer   no-undo.
      137     define variable len-code3 as integer   no-undo.
      138     define variable varcont3  as logical   initial yes no-undo.
      139     CASE bc-frmt :
      140       WHEN "EAN13" THEN do:
      141         assign
      142           tmp-str3 = string( internal-b-code, "999999999999" )
      143         .
      144       end.
      145       WHEN "EAN8" THEN do:
      146         assign
      147           tmp-str3 = string( internal-b-code, "9999999" )
      148         .
      149       end.
      150       OTHERWISE DO:
      151           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      152           view-as alert-box error.
      153           return error.
      154       END.
      155     END CASE.
      156     if varcont3 = yes then do:
      157       if integer( substring( tmp-str3, 1, length( bc-pfx ) ) ) <> 0
      158       then do:
      159         message
      160           "Невозможно сформировать бар-код" SKIP
      161           "для товара с кодом: " internal-b-code
      162           view-as alert-box error title "подрезание кода".
      163         return error.
      164       end.
      165       else do:
      166         assign
      167           full-b-code = bc-pfx + substring( tmp-str3, length( bc-pfx ) + 1, length( tmp-str3 ) - length( bc-pfx ) )
      168           len-code3    = length( full-b-code )
      169         .
      170         define variable v-sum-char3 as character no-undo .
      171         assign
      172           sum3 = 0
      173         .
      174         do i3 = 1 to len-code3 by 2
      175         :
      176           assign
      177             v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      178           .
      179           if v-sum-char3 < "0"
      180           or v-sum-char3 > "9"
      181           then do:
      182             message
      183               "Невозможно сформировать бар-код" skip
      184               "для товара с кодом: " internal-b-code skip
      185               view-as alert-box error title "подсчет контрольной суммы".
      186             return error.
      187           end.
      188           assign
      189             sum3 = sum3 + integer(v-sum-char3)
      190           .
      191         end.
      192         if varcont3 = yes then do:
      193           assign
      194             sum3 = sum3 * 3
      195           .
      196           do i3 = 2 to len-code3 by 2
      197           :
      198             assign
      199               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      200             .
      201             if v-sum-char3 < "0"
      202             or v-sum-char3 > "9"
      203             then do:
      204               message
      205                 "Невозможно сформировать бар-код" skip
      206                 "для товара с кодом: " internal-b-code skip
      207                 view-as alert-box error title "подсчет контрольной суммы".
      208               return error.
      209             end.
      210             assign
      211               sum3 = sum3 + integer(v-sum-char3)
      212             .
      213           end.
      214           if varcont3 = yes then do:
      215              if sum3 mod 10 = 0 then do:
      216                assign
      217                  full-b-code = full-b-code + '0'
      218                .
      219              end.
      220              else do:
      221                assign
      222                  full-b-code = full-b-code + string(10 - sum3 mod 10)
      223                .
      224              end.
      225           end.
      226         end.
      227       end.
      228     end.
      229   END PROCEDURE.
