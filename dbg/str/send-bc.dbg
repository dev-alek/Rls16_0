    12235     end.
    12236     run write-log-and-file in p-log-handle (
    12237           input 1
    12238         , input log-file-name
    12239         , input 1
    12240         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
