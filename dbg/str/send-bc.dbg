     8011                                             ,output v-pdf-id
     8012                                             ,output v-pdf-db-num ) no-error.
     8013         if error-status:error
     8014         or v-disc-price-sale = 0
     8015         or v-disc-price-sale = ?
     8016         then do:
     8017         end.
     8018         else do:
     8019           find first  cash-gds-discnt where
     8020                     cash-gds-discnt.b-code = cash-gds.b-code
     8021                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8022                   and cash-gds-discnt.obj-type = parobj-type
     8023                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8024           if not available cash-gds-discnt then do:
     8025             find first  cash-gds-discnt where
     8026                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8027             if not available cash-gds-discnt then do:
     8028               create cash-gds-discnt.
     8029               assign
     8030               cash-gds-discnt.crf = crgd + 1.
     8031             end.
     8032             crgd = crgd + 1.
     8033             assign
     8034             cash-gds-discnt.b-code = cash-gds.b-code
     8035             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8036             cash-gds-discnt.obj-type = parobj-type
     8037             cash-gds-discnt.obj-code = parobj-code
     8038             cash-gds-discnt.discnt-value = v-disc-price-sale
     8039             .
     8040             release cash-gds-discnt.
     8041           end.
     8042         end.
     8043       end.
     8044     end.
     8045     if cash-gds.temp-discnt-rule <> 0
     8046     and how-temp-disc = 'temp-disc-pdf':U
     8047     then do:
     8048       for each cash-dis-rule no-lock where
     8049             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8050         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8051         and cash-dis-rule.is-term = yes
     8052       :
     8053         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8054                                             ,input 'маг':U
     8055                                             ,input i-obj-code
     8056                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8057                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8058                                             ,input ?
     8059                                             ,output v-disc-price-sale
     8060                                             ,output v-pdf-id
     8061                                             ,output v-pdf-db-num ) no-error.
     8062         if error-status:error
     8063         or v-disc-price-sale = 0
     8064         or v-disc-price-sale = ?
     8065         then do:
     8066         end.
     8067         else do:
     8068           find first  cash-gds-discnt where
     8069                     cash-gds-discnt.b-code = cash-gds.b-code
     8070                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8071                   and cash-gds-discnt.obj-type = parobj-type
     8072                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8073           if not available cash-gds-discnt then do:
     8074             find first  cash-gds-discnt where
     8075                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8076             if not available cash-gds-discnt then do:
     8077               create cash-gds-discnt.
     8078               assign
