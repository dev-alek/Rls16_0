     8607                                       cash-txr.rc = recid(ub.goods)
     8608                                       cash-txr.host-code = ub.shop.host-code
     8609                                       cash-txr.obj-type = 'маг':U
     8610                                       cash-txr.obj-code = i-obj-code
     8611                                       cash-txr.status_ = 'тек':U
     8612                                       .
     8613                   cash-txr.rate-code = cash-txr.rate-code + txfixnum.
     8614                 end.
     8615               end.
     8616             END.
     8617         end.
     8618     end.
     8619     if LOOKUP('топ':U, ub.units.type) > 0 and
