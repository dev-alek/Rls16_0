     4735   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4736   PROCEDURE cd-mrkt_plu-marketer :
     4737   define input parameter p-silence as logical no-undo .
     4738   define parameter buffer buf_cash-desk for ub.cash-desk.
     4739   define input parameter p-id as character no-undo .
     4740   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4741   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4742   define input parameter p-loc-ean as logical no-undo .
     4743   define input parameter p-is-petrolium as logical no-undo .
     4744   define input parameter p-extra as character no-undo .
     4745   define variable v-tot-gds as integer no-undo .
     4746   define variable v-max-gds as integer no-undo .
     4747   define variable v-petrol-start as integer no-undo .
     4748   define variable v-petrol-range as integer no-undo .
     4749   DEFINE VARIABLE v-today as date no-undo .
     4750   DEFINE VARIABLE v-time as integer no-undo .
     4751   define variable v-plu-type as character no-undo .
     4752   define variable v-int as integer no-undo .
     4753   define buffer  buf_cd-plu for ub.cd-plu.
     4754   define buffer  loc_cd-plu for ub.cd-plu.
     4755   define variable  ii as integer no-undo.
     4756   define variable v-mes as character no-undo .
     4757   _main:
     4758   DO ON ERROR undo, leave on stop undo, leave:
     4759     if buf_cash-desk.pos-type <> 'MARIA':U
     4760     or buf_cash-desk.cash-num <> 0 then do:
     4761       assign
     4762       v-mes =
     4763       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4764                 , buf_cash-desk.pos-type).
     4765       if not p-silence then
     4766       message
     4767       v-mes
     4768       view-as alert-box error .
     4769       return error v-mes.
     4770     end.
     4771     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4772                                     ,input 'MARIA_operative':U
     4773                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4774                                           and p-is-petrolium
     4775                                           then 'tot-petrol':U
     4776                                           else 'tot-gds':U)
     4777                                     , output v-mes).
     4778     if v-tot-gds = ? then undo _main, return error v-mes.
     4779     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4780                                     ,input 'MARIA_general':U
     4781                                     ,input 'max-gds':U
     4782                                     ,output v-mes).
     4783     if v-max-gds = ? then undo _main, return error v-mes.
     4784     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4785                                          ,input 'petrolium-range':U
     4786                                          ,input 'petrolium-range':U
     4787                                          ,output v-mes).
     4788     if v-petrol-range = ? then undo _main, return error v-mes.
     4789     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4790       assign
     4791       v-petrol-start = 1
     4792       v-max-gds = (if p-is-petrolium
     4793                    then v-petrol-range
     4794                    else v-max-gds)
     4795       v-plu-type = (if p-is-petrolium
     4796                  then 'топ':U
     4797                  else '':U)
     4798       .
     4799       if p-is-petrolium then do:
     4800         if p-id = '':U then do:
     4801           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4802                               "Невозможно привязать к кассе типа &3"
     4803                               , p-b-str
     4804                               , chr(10)
     4805                               , 'MARIA':U).
     4806           if not p-silence then
     4807           message
     4808           v-mes
     4809           view-as alert-box error .
     4810           return error v-mes.
     4811         end.
     4812         assign
     4813         v-int = integer(p-id)
     4814         no-error
     4815         .
     4816         if error-status:error
     4817         or v-int > v-petrol-range then do:
     4818           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4819                               "в диапазоны номеров резервуаров для кассы типа &4"
     4820                               , p-id
     4821                               , p-b-str
     4822                               , chr(10)
     4823                               , 'MARIA':U).
     4824           if not p-silence then
     4825           message
     4826           v-mes
     4827           view-as alert-box error .
     4828           return error v-mes.
     4829         end.
     4830       end.
     4831     end.
     4832     if buf_cash-desk.pos-type = 'MARIA':U
     4833     and p-is-petrolium then do:
     4834       find first loc_cd-plu where
     4835                loc_cd-plu.obj-type = 'маг':U
     4836            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4837            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4838            and loc_cd-plu.plu-type = 'топ':U
     4839      no-error .
     4840      if available loc_cd-plu then do:
     4841        if loc_cd-plu.b-code = p-b-code
     4842        and loc_cd-plu.b-str = p-b-str then do:
     4843           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4844                               , p-id
     4845                               , p-b-str
     4846                               , chr(10)
     4847                               ).
     4848           if not p-silence then
     4849           message
     4850           v-mes
     4851           view-as alert-box WARNING .
     4852           return v-mes.
     4853        end.
     4854        else do:
     4855           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4856                               "нельзя его привязать к топливу &2&3"
     4857                               , p-id
     4858                               , loc_cd-plu.b-str
     4859                               , chr(10)
     4860                               , p-b-str).
     4861           if not p-silence then
     4862           message
     4863           v-mes
     4864           view-as alert-box error .
     4865           return error v-mes.
     4866        end.
     4867      end.
     4868      ii = v-int.
     4869     end.
     4870     else do:
     4871       DO ii = (if p-is-petrolium
     4872               then v-petrol-start
     4873               else (if buf_cash-desk.pos-type = 'MARIA':U
     4874                    then 1
     4875                    else (if v-petrol-start = 1
     4876                           then (v-petrol-range + 1)
     4877                           else 1)
     4878                   )
     4879               )
     4880         to v-max-gds :
     4881         if not can-find (loc_cd-plu where
     4882                         loc_cd-plu.obj-type = 'маг':U
     4883                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4884                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4885                      and loc_cd-plu.plu-type = v-plu-type
     4886                      and loc_cd-plu.plu-code = ii
     4887                       )
     4888         then LEAVE .
     4889       END .
     4890     end.
     4891     if ii > v-max-gds then do:
     4892         if not p-silence then
     4893         message
     4894         substitute("Превышено максимально допустимое количество &5 &1" +
     4895                   "для касс &2 &3&4"
     4896                   , chr(10)
     4897                   , v-max-gds
     4898                   , 'маг':U
     4899                   , buf_cash-desk.obj-code
     4900                   , (if p-is-petrolium then "топлив" else "товаров")
     4901                   )
     4902         view-as alert-box ERROR .
     4903         undo, return error "max-gds":U.
     4904     end.
     4905     DO ii = (if p-is-petrolium
     4906              then v-petrol-start
     4907              else (if v-petrol-start = 1
     4908                    then (v-petrol-range + 1)
     4909                    else 1)
     4910              )
     4911        to v-max-gds :
     4912       if not can-find (loc_cd-plu where
     4913                         loc_cd-plu.obj-type = 'маг':U
     4914                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4915                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4916                      and loc_cd-plu.plu-type = v-plu-type
     4917                      and loc_cd-plu.plu-code = ii
     4918                      )
     4919       then LEAVE .
     4920     END .
     4921     if ii > v-max-gds then do:
     4922         if not p-silence then
     4923         message
     4924         substitute("Превышено максимально допустимое количество &5 &1" +
     4925                   "для касс &2 &3&4"
     4926                   , chr(10)
     4927                   , v-max-gds
     4928                   , 'маг':U
     4929                   , buf_cash-desk.obj-code
     4930                   , (if p-is-petrolium then "топлив" else "товаров")
     4931                   )
     4932         view-as alert-box ERROR .
     4933         undo, return error "max-gds":U.
     4934     end.
     4935     run cur-time in this-procedure ( output v-today, output v-time).
     4936     create buf_cd-plu.
     4937     assign
     4938     buf_cd-plu.b-code = p-b-code
     4939     buf_cd-plu.b-str = p-b-str
     4940     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4941                                         then buf_cash-desk.addr-path
     4942                                         else "U":U)
     4943     buf_cd-plu.to-send = yes
     4944     buf_cd-plu.charkey_one = "":U
     4945     buf_cd-plu.to-del = no
     4946     buf_cd-plu.plu-code = ii
     4947     buf_cd-plu.obj-type = 'маг':U
     4948     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4949     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4950     buf_cd-plu.plu-type = v-plu-type
     4951     buf_cd-plu.logkey_one = p-loc-ean
     4952     buf_cd-plu.key#_one = integer(p-extra)
     4953     .
     4954     run cd-attr-write  in this-procedure (
     4955                                           input   buf_cash-desk.db-num
     4956                                           ,input  buf_cash-desk.obj-code
     4957                                           ,input  buf_cash-desk.pos-type
     4958                                           ,input  buf_cash-desk.cash-num
     4959                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4960                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4961                                                 and p-is-petrolium
     4962                                                 then 'tot-petrol':U
     4963                                                 else 'tot-gds':U)
     4964                                           ,input ''
     4965                                           ,input ?
     4966                                           ,input 0.0
     4967                                           ,input  (v-tot-gds + 1)
     4968                                           ,input no
     4969                                          ) no-error .
     4970     if error-status:error then do:
     4971       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4972                          ,buf_cash-desk.cash-num
     4973                          , 'маг':U
     4974                          ,buf_cash-desk.obj-code
     4975                          , chr(10)
     4976                          , error-status:get-message(1)
     4977                          , return-value
     4978                          ).
     4979       if not p-silence then
     4980       message
     4981       v-mes
     4982       view-as alert-box error .
     4983       undo _main, return error v-mes.
     4984     end.
     4985     run cd-attr-write  in this-procedure (
     4986                                           input   buf_cash-desk.db-num
     4987                                           ,input  buf_cash-desk.obj-code
     4988                                           ,input  buf_cash-desk.pos-type
     4989                                           ,input  buf_cash-desk.cash-num
     4990                                           ,input  'MARIA_operative':U
     4991                                           ,input  'to-send':U
     4992                                           ,input ''
     4993                                           ,input ?
     4994                                           ,input 0.0
     4995                                           ,input 0
     4996                                           ,input yes
     4997                                          ) no-error .
     4998     if error-status:error then do:
     4999       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5000                          ,buf_cash-desk.cash-num
     5001                          , 'маг':U
     5002                          ,buf_cash-desk.obj-code
     5003                          , chr(10)
     5004                          , error-status:get-message(1)
     5005                          , return-value
     5006                          ).
     5007       if not p-silence then
     5008       message
     5009       v-mes
     5010       view-as alert-box error .
     5011       undo _main, return error v-mes.
     5012     end.
     5013     return "":U.
     5014   end.
     5015   END PROCEDURE.
     5016   procedure cd-mrkt_update-marketer :
     5017   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5018   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5019   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5020   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5021   define input parameter p-is-petrolium as logical no-undo .
     5022   define variable v-to-send as logical no-undo .
     5023   define variable v-tot-gds as integer no-undo .
     5024   define variable v-max-plu as integer no-undo .
     5025   define buffer buf_cd-plu for ub.cd-plu.
     5026   define variable v-plu-type as character no-undo .
     5027     do
     5028     on error undo, return error
     5029     :
     5030       v-to-send = no.
     5031       v-tot-gds = 0.
     5032       assign
     5033       v-plu-type = (if p-is-petrolium
     5034                     then  'топ':U
     5035                     else '':U
     5036                 )
     5037       .
     5038       FOR EACH buf_cd-plu WHERE
     5039              buf_cd-plu.obj-type = 'маг':U
     5040         and  buf_cd-plu.obj-code = p-obj-code
     5041         and  buf_cd-plu.pos-type = p-pos-type
     5042         and  buf_cd-plu.plu-type = v-plu-type
     5043             :
     5044         if  buf_cd-plu.to-del
     5045         or  buf_cd-plu.to-send then do:
     5046           assign
     5047           v-to-send = yes.
     5048         end.
     5049         assign
     5050         v-tot-gds = v-tot-gds + 1.
     5051       end.
     5052       run cd-attr-write  in this-procedure (
     5053                                               input   p-db-num
     5054                                               ,input  p-obj-code
     5055                                               ,input  p-pos-type
     5056                                               ,input  p-cash-num
     5057                                               ,input  'MARIA_operative':U
     5058                                               ,input  (if p-pos-type = 'MARIA':U
     5059                                                        and p-is-petrolium
     5060                                                        then  'tot-petrol':U
     5061                                                        else 'tot-gds':U)
     5062                                               ,input ''
     5063                                               ,input ?
     5064                                               ,input 0.0
     5065                                               ,input v-tot-gds
     5066                                               ,input no
     5067                                                                                           ) no-error .
     5068       if error-status:error then do:
     5069           UNDO, RETURN ERROR RETURN-VALUE.
     5070       END.
     5071       run cd-attr-write  in this-procedure (
     5072                                               input   p-db-num
     5073                                               ,input  p-obj-code
     5074                                               ,input  p-pos-type
     5075                                               ,input  p-cash-num
     5076                                               ,input  'MARIA_operative':U
     5077                                               ,input  (if p-pos-type = 'MARIA':U
     5078                                                        and p-is-petrolium
     5079                                                        then  'petrol-to-send':U
     5080                                                        else 'to-send':U)
     5081                                               ,input ''
     5082                                               ,input ?
     5083                                               ,input 0.0
     5084                                               ,input 0
     5085                                               ,input v-to-send
     5086                                               ) no-error .
     5087       if error-status:error then do:
     5088           UNDO, RETURN ERROR RETURN-VALUE.
     5089       END.
     5090       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5091                buf_cd-plu.obj-type = 'маг':U
     5092            and buf_cd-plu.obj-code = p-obj-code
     5093            and buf_cd-plu.pos-type = p-pos-type
     5094            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5095       if available buf_cd-plu then do:
     5096         if v-max-plu < buf_cd-plu.plu-code
     5097         then
     5098         v-max-plu = buf_cd-plu.plu-code .
     5099       end.
     5100       else do:
     5101         v-max-plu = 0.
     5102       end.
     5103       run cd-attr-write  in this-procedure (
     5104                                             input   p-db-num
     5105                                             ,input  p-obj-code
     5106                                             ,input  p-pos-type
     5107                                             ,input  p-cash-num
     5108                                             ,input  'MARIA_operative':U
     5109                                             ,input  (if p-pos-type = 'MARIA':U
     5110                                                     and p-is-petrolium
     5111                                                     then 'max-petrol-plu':U
     5112                                                     else 'max-plu':U)
     5113                                               ,input ''
     5114                                               ,input ?
     5115                                               ,input 0.0
     5116                                               ,input v-max-plu
     5117                                               ,input no
     5118                                             ) no-error .
     5119       if error-status:error then do:
     5120           UNDO, RETURN ERROR RETURN-VALUE.
     5121       END.
     5122     end.
     5123   end procedure.
     5124   PROCEDURE cd-mrkt_clu-marketer :
     5125   define input parameter p-silence as logical no-undo .
     5126   define parameter buffer buf_cash-desk for ub.cash-desk.
     5127   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5128   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5129   define variable v-tot-cli as integer no-undo .
     5130   define variable v-max-cli as integer no-undo .
     5131   DEFINE VARIABLE v-today as date no-undo .
     5132   DEFINE VARIABLE v-time as integer no-undo .
     5133   define buffer  buf_cd-clu for ub.cd-clu.
     5134   define buffer  loc_cd-clu for ub.cd-clu.
     5135   define variable  ii as integer no-undo.
     5136   define variable v-mes as character no-undo .
     5137   _main:
     5138   DO ON ERROR undo, leave on stop undo, leave:
     5139     if buf_cash-desk.pos-type <> 'MARIA':U
     5140     or buf_cash-desk.cash-num <> 0 then do:
     5141       assign
     5142       v-mes =
     5143       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5144                 , buf_cash-desk.pos-type).
     5145       if not p-silence then
     5146       message
     5147       v-mes
     5148       view-as alert-box error .
     5149       return error v-mes.
     5150     end.
     5151     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5152                                     ,input 'MARIA_operative':U
     5153                                     ,input 'tot-cli':U
     5154                                     ,output v-mes).
     5155     if v-tot-cli = ? then undo _main, return error v-mes.
     5156     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5157                                     ,input 'MARIA_general':U
     5158                                     ,input 'max-cli':U
     5159                                     , output v-mes).
     5160     if v-max-cli = ? then undo _main, return error v-mes.
     5161     DO ii = 1
     5162        to v-max-cli :
     5163       if not can-find (loc_cd-clu where
     5164                       loc_cd-clu.obj-type = 'маг':U
     5165                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5166                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5167                   and loc_cd-clu.clu-type = '':U
     5168                   and loc_cd-clu.clu-code = ii
     5169                      )
     5170       then LEAVE .
     5171     END .
     5172     if ii > v-max-cli then do:
     5173         if not p-silence then
     5174         message
     5175         substitute("Превышено максимально допустимое количество клиентов &1" +
     5176                   "для касс &2 &3&4"
     5177                   , chr(10)
     5178                   , v-max-cli
     5179                   , 'маг':U
     5180                   , buf_cash-desk.obj-code
     5181                   )
     5182         view-as alert-box ERROR .
     5183         undo, return error "max-cli":U.
     5184     end.
     5185     run cur-time in this-procedure ( output v-today, output v-time).
     5186     create buf_cd-clu.
     5187     assign
     5188     buf_cd-clu.cli-code = p-obj-code
     5189     buf_cd-clu.cli-type = p-obj-type
     5190     buf_cd-clu.obj-type = 'маг':U
     5191     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5192     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5193     buf_cd-clu.clu-type = '':U
     5194     buf_cd-clu.to-send = yes
     5195     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5196                               then buf_cash-desk.addr-path
     5197                               else "U":U)
     5198     buf_cd-clu.clu-code = ii
     5199     .
     5200     run cd-attr-write  in this-procedure (
     5201                                           input   buf_cash-desk.db-num
     5202                                           ,input  buf_cash-desk.obj-code
     5203                                           ,input  buf_cash-desk.pos-type
     5204                                           ,input  buf_cash-desk.cash-num
     5205                                           ,input  'MARIA_operative':U
     5206                                           ,input  'tot-cli':U
     5207                                           ,input ''
     5208                                           ,input ?
     5209                                           ,input 0.0
     5210                                           ,input  (v-tot-cli + 1)
     5211                                           ,input no
     5212                                          ) no-error .
     5213     if error-status:error then do:
     5214       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5215                          ,buf_cash-desk.cash-num
     5216                          , 'маг':U
     5217                          ,buf_cash-desk.obj-code
     5218                          , chr(10)
     5219                          , error-status:get-message(1)
     5220                          , return-value
     5221                          ).
     5222       if not p-silence then
     5223       message
     5224       v-mes
     5225       view-as alert-box error .
     5226       undo _main, return error v-mes.
     5227     end.
     5228     run cd-attr-write  in this-procedure (
     5229                                           input   buf_cash-desk.db-num
     5230                                           ,input  buf_cash-desk.obj-code
     5231                                           ,input  buf_cash-desk.pos-type
     5232                                           ,input  buf_cash-desk.cash-num
     5233                                           ,input  'MARIA_operative':U
     5234                                           ,input  'cli-to-send':U
     5235                                           ,input ''
     5236                                           ,input ?
     5237                                           ,input 0.0
     5238                                           ,input 0
     5239                                           ,input yes
     5240                                          ) no-error .
     5241     if error-status:error then do:
     5242       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5243                          ,buf_cash-desk.cash-num
     5244                          , 'маг':U
     5245                          ,buf_cash-desk.obj-code
     5246                          , chr(10)
     5247                          , error-status:get-message(1)
     5248                          , return-value
     5249                          ).
     5250       if not p-silence then
     5251       message
     5252       v-mes
     5253       view-as alert-box error .
     5254       undo _main, return error v-mes.
     5255     end.
     5256     return "":U.
     5257   end.
     5258   END PROCEDURE.
     5259   procedure cd-mrkt_update-marketer-cli :
     5260   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5261   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5262   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5263   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5264   define variable v-cli-to-send as logical no-undo .
     5265   define variable v-tot-cli as integer no-undo .
     5266   define variable v-max-clu as integer no-undo .
     5267   define buffer buf_cd-clu for ub.cd-clu.
     5268   do
     5269   on error undo, return error return-value
     5270   :
     5271     v-cli-to-send = no.
     5272     v-tot-cli = 0.
     5273     FOR EACH buf_cd-clu WHERE
     5274           buf_cd-clu.obj-type = 'маг':U
     5275       and buf_cd-clu.obj-code =  p-obj-code
     5276       and buf_cd-clu.pos-type =  p-pos-type
     5277       and buf_cd-clu.clu-type =  '':U
     5278       :
     5279       if buf_cd-clu.to-del = yes then do:
     5280         assign
     5281         v-cli-to-send = yes.
     5282       end.
     5283       assign
     5284       v-tot-cli = v-tot-cli + 1.
     5285     end.
     5286     run cd-attr-write  in this-procedure (
     5287                                             input   p-db-num
     5288                                             ,input  p-obj-code
     5289                                             ,input  p-pos-type
     5290                                             ,input  p-cash-num
     5291                                             ,input  'MARIA_operative':U
     5292                                             ,input  'tot-cli':U
     5293                                             ,input ''
     5294                                             ,input ?
     5295                                             ,input 0.0
     5296                                             ,input v-tot-cli
     5297                                             ,input no
     5298                                             ) no-error .
     5299     if error-status:error then do:
     5300         UNDO, RETURN ERROR RETURN-VALUE.
     5301     END.
     5302     run cd-attr-write  in this-procedure (
     5303                                             input   p-db-num
     5304                                             ,input  p-obj-code
     5305                                             ,input  p-pos-type
     5306                                             ,input  p-cash-num
     5307                                             ,input  'MARIA_operative':U
     5308                                             ,input  'cli-to-send':U
     5309                                             ,input ''
     5310                                             ,input ?
     5311                                             ,input 0.0
     5312                                             ,input 0
     5313                                             ,input v-cli-to-send
     5314                                             ) no-error .
     5315     if error-status:error then do:
     5316         UNDO, RETURN ERROR RETURN-VALUE.
     5317     END.
     5318     FIND LAST buf_cd-clu WHERE
     5319             buf_cd-clu.obj-type = 'маг':U
     5320         and buf_cd-clu.obj-code = p-obj-code
     5321         and buf_cd-clu.pos-type = p-pos-type
     5322         and buf_cd-clu.clu-type = '':U
     5323         NO-LOCK use-index pi no-error .
     5324     if available buf_cd-clu then do:
     5325       if v-max-clu < buf_cd-clu.clu-code
     5326       then
     5327       v-max-clu = buf_cd-clu.clu-code.
     5328     end.
     5329     else do:
     5330       v-max-clu = 0.
     5331     end.
     5332     run cd-attr-write  in this-procedure (
     5333                                           input   p-db-num
     5334                                           ,input  p-obj-code
     5335                                           ,input  p-pos-type
     5336                                           ,input  p-cash-num
     5337                                           ,input  'MARIA_operative':U
     5338                                           ,input  'max-clu':U
     5339                                           ,input ''
     5340                                           ,input ?
     5341                                           ,input 0.0
     5342                                           ,input v-max-clu
     5343                                           ,input no
     5344                                           ) no-error .
     5345     if error-status:error then do:
     5346         UNDO, RETURN ERROR RETURN-VALUE.
     5347     END.
     5348   end.
     5349   end procedure.
     5350   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
