     8740   run finish-send in this-procedure no-error .
     8741   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8742   procedure ibm-gdsc :
     8743   define input  parameter p-zeros         as logical no-undo .
     8744   define output parameter IBM-good-code as character no-undo .
     8745   define output parameter IBM-good-code-2 as character no-undo .
     8746   define output parameter IBM2-short      as character no-undo .
     8747   define variable v-delim as character no-undo .
     8748   define variable v-format-str-16 as character no-undo .
     8749     do
     8750     on error undo, return error
     8751     :
     8752       if p-zeros then do:
     8753         assign
     8754         v-delim = '0'
     8755         v-format-str-16 =  "9999999999999999"
     8756         .
     8757       end.
     8758       else do:
     8759         assign
     8760         v-delim = chr(32)
     8761         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
     8762         .
     8763       end.
     8764       if cash-gds.b-str = "" then do:
     8765         assign
     8766         b_code = string( cash-gds.b-code, v-format-str-16 ) .
     8767         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
     8768         or cash-gds.unit-base <> cash-gds.unit-cli
     8769         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
     8770         then
     8771         do:
     8772           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8773               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8774             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8775             iBM2-short = bar_code.
     8776             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
     8777           END.
     8778           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8779               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8780             IBM-good-code-2 = b_code.
     8781           end.
     8782         end.
     8783       end.
     8784       else do:
     8785         IBm-good-code =
     8786         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8787           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8788            or
     8789            cash-gds.bc-on-type = 'pglc':U)
     8790         then string( decimal( cash-gds.b-str ), v-format-str-16)
     8791         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
     8792       end.
     8793     end.
     8794   end procedure.
     8795   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8796   procedure ncr-gdsc :
     8797   define output parameter IBM-good-code as character no-undo .
     8798   define output parameter IBM-good-code-2 as character no-undo .
     8799   define output parameter is-sc as logical no-undo .
     8800   define output parameter p-taracode-bc as character no-undo .
     8801   define variable v-taracode-bc as character no-undo .
     8802   define variable v-type as character no-undo .
     8803   define variable v-bc-buf as character no-undo .
     8804   define variable iii as integer no-undo .
     8805     do
     8806     on error undo, return error
     8807     :
     8808       if cash-gds.b-str = "" then do:
     8809         assign
     8810         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
     8811         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
     8812           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8813               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8814             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8815             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
     8816           end.
     8817           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8818               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8819             IBM-good-code-2 = b_code.
     8820           end.
     8821         end.
     8822       end.
     8823       else do:
     8824         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
     8825         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8826                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8827                              or
     8828                              cash-gds.bc-on-type = 'pglc':U)
     8829                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
     8830                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
     8831                                       trim( cash-gds.b-str ), "9999999999999" ) ).
     8832          if action <> "D":U then do:
     8833           is-sc = no.
     8834           find first request_prod-bc no-lock where
     8835                     request_prod-bc.b-str = cash-gds.b-str no-error .
     8836           if not avail request_prod-bc then do :
     8837             if mask_s-c <> "" then do :
     8838               iii_ :
     8839               do iii = 1 to num-entries(mask_s-c) :
     8840                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
     8841                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
     8842                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
     8843                   if available request_prod-bc then leave iii_ .
     8844                 end.
     8845               end.
     8846             end.
     8847           end.
     8848           if avail request_prod-bc then do :
     8849             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
     8850   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     8852     (buffer request_prod-bc
     8853     ,input  'scaleable=request'
     8854     ,output is-sc
     8855     ) no-error .
     8856             end.
     8857             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8858                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8859                then do:
     8860   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8861     define variable tmp-str66  as character no-undo.
     8862     define variable tmp-num66  as character no-undo.
     8863     define variable i66        as integer   no-undo.
     8864     define variable sum66      as integer   no-undo.
     8865     define variable len-code66 as integer   no-undo.
     8866     define variable varcont66  as logical   initial yes no-undo.
     8867     CASE ncrsc-frmt :
     8868       WHEN "EAN13" THEN do:
     8869         assign
     8870           tmp-str66 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
     8871         .
     8872       end.
     8873       WHEN "EAN8" THEN do:
     8874         assign
     8875           tmp-str66 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
     8876         .
     8877       end.
     8878       OTHERWISE DO:
     8879           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
     8880           view-as alert-box error.
     8881           return error.
     8882       END.
     8883     END CASE.
     8884     if varcont66 = yes then do:
     8885       if integer( substring( tmp-str66, 1, length( ncrsc-pfx ) ) ) <> 0
     8886       then do:
     8887         message
     8888           "Невозможно сформировать бар-код" SKIP
     8889           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
     8890           view-as alert-box error title "подрезание кода".
     8891         return error.
     8892       end.
     8893       else do:
     8894         assign
     8895           IBm-good-code = ncrsc-pfx + substring( tmp-str66, length( ncrsc-pfx ) + 1, length( tmp-str66 ) - length( ncrsc-pfx ) )
     8896           len-code66    = length( IBm-good-code )
     8897         .
     8898         define variable v-sum-char66 as character no-undo .
     8899         assign
     8900           sum66 = 0
     8901         .
     8902         do i66 = 1 to len-code66 by 2
     8903         :
     8904           assign
     8905             v-sum-char66 = substr(IBm-good-code, len-code66 - i66 + 1, 1)
     8906           .
     8907           if v-sum-char66 < "0"
     8908           or v-sum-char66 > "9"
     8909           then do:
     8910             message
     8911               "Невозможно сформировать бар-код" skip
     8912               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     8913               view-as alert-box error title "подсчет контрольной суммы".
     8914             return error.
     8915           end.
     8916           assign
     8917             sum66 = sum66 + integer(v-sum-char66)
     8918           .
     8919         end.
     8920         if varcont66 = yes then do:
     8921           assign
     8922             sum66 = sum66 * 3
     8923           .
     8924           do i66 = 2 to len-code66 by 2
     8925           :
     8926             assign
     8927               v-sum-char66 = substr(IBm-good-code, len-code66 - i66 + 1, 1)
     8928             .
     8929             if v-sum-char66 < "0"
     8930             or v-sum-char66 > "9"
     8931             then do:
     8932               message
     8933                 "Невозможно сформировать бар-код" skip
     8934                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     8935                 view-as alert-box error title "подсчет контрольной суммы".
     8936               return error.
     8937             end.
     8938             assign
     8939               sum66 = sum66 + integer(v-sum-char66)
     8940             .
     8941           end.
     8942           if varcont66 = yes then do:
     8943              if sum66 mod 10 = 0 then do:
     8944                assign
     8945                  IBm-good-code = IBm-good-code + '0'
     8946                .
     8947              end.
     8948              else do:
     8949                assign
     8950                  IBm-good-code = IBm-good-code + string(10 - sum66 mod 10)
     8951                .
     8952              end.
     8953           end.
     8954         end.
     8955       end.
     8956     end.
     8957             end.
     8958             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8959                cash-gds.bc-on-type = 'pglc':U
     8960                then do:
     8961   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8962     define variable tmp-str67  as character no-undo.
     8963     define variable tmp-num67  as character no-undo.
     8964     define variable i67        as integer   no-undo.
     8965     define variable sum67      as integer   no-undo.
     8966     define variable len-code67 as integer   no-undo.
     8967     define variable varcont67  as logical   initial yes no-undo.
     8968     CASE ncrpg-frmt :
     8969       WHEN "EAN13" THEN do:
     8970         assign
     8971           tmp-str67 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
     8972         .
     8973       end.
     8974       WHEN "EAN8" THEN do:
     8975         assign
     8976           tmp-str67 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
     8977         .
     8978       end.
     8979       OTHERWISE DO:
     8980           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrpg-frmt " ."
     8981           view-as alert-box error.
     8982           return error.
     8983       END.
     8984     END CASE.
     8985     if varcont67 = yes then do:
     8986       if integer( substring( tmp-str67, 1, length( ncrpg-pfx ) ) ) <> 0
     8987       then do:
     8988         message
     8989           "Невозможно сформировать бар-код" SKIP
     8990           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
     8991           view-as alert-box error title "подрезание кода".
     8992         return error.
     8993       end.
     8994       else do:
     8995         assign
     8996           IBm-good-code = ncrpg-pfx + substring( tmp-str67, length( ncrpg-pfx ) + 1, length( tmp-str67 ) - length( ncrpg-pfx ) )
     8997           len-code67    = length( IBm-good-code )
     8998         .
     8999         define variable v-sum-char67 as character no-undo .
     9000         assign
     9001           sum67 = 0
     9002         .
     9003         do i67 = 1 to len-code67 by 2
     9004         :
     9005           assign
     9006             v-sum-char67 = substr(IBm-good-code, len-code67 - i67 + 1, 1)
     9007           .
     9008           if v-sum-char67 < "0"
     9009           or v-sum-char67 > "9"
     9010           then do:
     9011             message
     9012               "Невозможно сформировать бар-код" skip
     9013               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     9014               view-as alert-box error title "подсчет контрольной суммы".
     9015             return error.
     9016           end.
     9017           assign
     9018             sum67 = sum67 + integer(v-sum-char67)
     9019           .
     9020         end.
     9021         if varcont67 = yes then do:
     9022           assign
     9023             sum67 = sum67 * 3
     9024           .
     9025           do i67 = 2 to len-code67 by 2
     9026           :
     9027             assign
     9028               v-sum-char67 = substr(IBm-good-code, len-code67 - i67 + 1, 1)
     9029             .
     9030             if v-sum-char67 < "0"
     9031             or v-sum-char67 > "9"
     9032             then do:
     9033               message
     9034                 "Невозможно сформировать бар-код" skip
     9035                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     9036                 view-as alert-box error title "подсчет контрольной суммы".
     9037               return error.
     9038             end.
     9039             assign
     9040               sum67 = sum67 + integer(v-sum-char67)
     9041             .
     9042           end.
     9043           if varcont67 = yes then do:
     9044              if sum67 mod 10 = 0 then do:
     9045                assign
     9046                  IBm-good-code = IBm-good-code + '0'
     9047                .
     9048              end.
     9049              else do:
     9050                assign
     9051                  IBm-good-code = IBm-good-code + string(10 - sum67 mod 10)
     9052                .
     9053              end.
     9054           end.
     9055         end.
     9056       end.
     9057     end.
     9058             end.
     9059           end.
     9060         end.
     9061       end.
     9062       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     9063       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
     9064             or
     9065             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
     9066       then do:
     9067           run bc-oattr_value in this-procedure ( input cash-gds.b-code
     9068                                               ,input 'taracode-bc':U
     9069                                               ,input 'маг':U
     9070                                               ,input i-obj-code
     9071                                               ,output v-taracode-bc
     9072                                               ,output v-type) no-error.
     9073           if not error-status:error
     9074           and v-taracode-bc <> '' then do:
     9075             is-sc = yes.
     9076             p-taracode-bc = v-taracode-bc.
     9077           end.
     9078       end.
     9079     end.
     9080   end procedure.
     9081   procedure finish-send :
     9082     do
     9083     on error undo, return error
     9084     :
     9085   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9086   if v-view-log
     9087   and not g#news
     9088   and not g#auto
     9089   then do:
     9090     message
     9091     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     9092     "!!!Внимательно прочитайте Log-file!!"
     9093     view-as alert-box error .
     9094        define variable v-user-action69   as character no-undo .
     9095     define variable v-printed69       as logical   no-undo .
     9096     run gbl/prnfilen.w
     9097       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     9098       ,input  0
     9099       ,input  (string("./":U) + log-file-name)
     9100       ,input  7
     9101       ,output v-user-action69
     9102       ,output v-printed69
     9103       ) .
     9104   end.
     9105   if v-view-log = true
     9106   and (g#news
     9107   or g#auto)
     9108   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     9109   then do:
     9110      run cb_set-view-log in p-parent-handle ( input yes).
     9111   end.
     9112       define variable v-save-file-name as character no-undo .
     9113       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     9114       OS-APPEND value(log-file-name) value(v-save-file-name).
     9115       OS-DELETE value(log-file-name).
     9116     end.
     9117   end procedure.
     9118   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
     9119   PROCEDURE putc-gds.
     9120   define parameter buffer buf_cash-desk for ub.cash-desk.
     9121   define input parameter pos-type as char no-undo.
     9122   define input parameter p-version like ub.cash-desk.version no-undo .
     9123   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     9124   define variable ff  as  int     no-undo.
     9125   define variable gg  as  int     no-undo.
     9126   DEFINE VARIABLE second-name as character no-undo.
     9127   define variable nam-2str-shift as integer no-undo .
     9128   define variable v-length as integer no-undo .
     9129   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
     9130   define variable std-disc-dec as decimal no-undo .
     9131   define variable std-disc-reason as integer no-undo .
     9132   define variable std-disc-lim as date no-undo .
     9133   define variable temp-disc-dec as decimal no-undo .
     9134   define variable temp-disc-reason as integer no-undo .
     9135   define variable temp-disc-start as date no-undo .
     9136   define variable temp-disc-end as date no-undo .
     9137   define variable temp-disc-time-start as integer no-undo .
     9138   define variable temp-disc-time-end as integer no-undo .
     9139   define variable temp-disc-weekday as integer no-undo .
     9140   define variable v-version-dec as decimal no-undo .
     9141   define variable v-kat-num as integer no-undo .
     9142   define variable v-kat-discnt as decimal no-undo .
     9143   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
     9144   define variable IBM2-short as character no-undo .
     9145   define variable v-what-find as character no-undo .
     9146   define variable v-plu as character no-undo .
     9147   define variable v-pl-code as integer no-undo .
     9148   define variable v-marketer-action as character no-undo .
     9149   define variable v-versiond as decimal no-undo .
     9150   define variable v-b-code-to-find as logical no-undo .
     9151   define variable v-maria-discnt-value as character no-undo .
     9152   define variable v-ii as integer no-undo .
     9153   define variable v-dop as character no-undo .
     9154   define variable v-gds-rule-num as integer no-undo .
     9155   define variable v-maria-rule-num as integer no-undo .
     9156   define variable v-discreteness as character no-undo .
     9157   define variable wd-option as integer no-undo .
     9158   define variable wgd-option as integer no-undo .
     9159   define variable v-type as logical   no-undo .
     9160   define variable  s as char no-undo.
     9161   define variable articul as char no-undo.
     9162   define variable v-disc-price-sale as decimal no-undo .
     9163   define variable v-pdf-id as integer no-undo .
     9164   define variable v-pdf-db-num as integer no-undo .
     9165   define buffer buf_cash-dis-rule for cash-dis-rule .
     9166   define buffer buf_cd-plu for ub.cd-plu.
     9167   define buffer buf_dis-rule for ub.dis-rule.
     9168   define buffer buf_place for ub.place.
     9169   define buffer buf_pl-gds for ub.pl-gds.
     9170   define buffer bcash-gds for cash-gds.
     9171   define buffer buf_cash-desk-attr for cash-desk-attr.
     9172   define variable vcash-desk-stndart as logical no-undo init yes.
     9173   assign
     9174   v-version-dec = decimal(p-version)
     9175   no-error .
     9176   if buf_cash-desk.autonomy = integer('2':U)
     9177   then do:
     9178      vcash-desk-stndart = no.
     9179   end.
     9180     if buf_cash-desk.device-kind = 2 then vcash-desk-stndart = no.
     9181   define variable is-petrol   as logical   no-undo.
     9182   define variable is-pieces   as logical   no-undo.
     9183   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9184     (
     9185        input cash-gds.artic
     9186     ,  input ?
     9187     ,  input cash-gds.gds-code
     9188     , output is-petrol
     9189     , output is-pieces
     9190     ) NO-ERROR.
     9191   if     not vcash-desk-stndart
     9192      and not is-petrol
     9193   then
     9194      return.
     9195   if cash-gds.std-discnt-rule > 0 then do:
     9196     find first cash-dis-rule no-lock where
     9197               cash-dis-rule.rule-num =  cash-gds.std-discnt-rule no-error .
     9198     if available cash-dis-rule then do:
     9199       find first cash-dis-time-rule no-lock where
     9200                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9201       assign
     9202       std-disc-dec = - cash-dis-rule.discnt-value
     9203       std-disc-reason = 0
     9204       no-error
     9205       .
     9206       if available cash-dis-time-rule then do:
     9207         assign
     9208         std-disc-lim = cash-dis-time-rule.date-to
     9209         .
     9210         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
     9211         assign
     9212         std-disc-dec = 0
     9213         std-disc-reason = 0
     9214         .
     9215         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
     9216         assign
     9217         std-disc-dec = 0
     9218         std-disc-reason = 0
     9219         .
     9220       end.
     9221     end.
     9222   end.
     9223   if cash-gds.wd > 1 then do:
     9224     find first cash-dis-rule no-lock where
     9225               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
     9226     if available cash-dis-rule then  do:
     9227       assign
     9228       wd-option = integer(cash-dis-rule.discnt-value).
     9229     end.
     9230   end.
     9231   if cash-gds.wd = 1 then do:
     9232      wd-option = 1.
     9233   end.
     9234   if cash-gds.wgd > 0 then do:
     9235     find first cash-dis-rule no-lock where
     9236               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
     9237     if available cash-dis-rule then  do:
     9238       assign
     9239       wgd-option = integer(cash-dis-rule.discnt-value).
     9240     end.
     9241   end.
     9242   if cash-gds.temp-discnt-rule <> 0 then do:
     9243     assign
     9244     temp-disc-dec = 0
     9245     .
     9246     find first cash-dis-rule no-lock where
     9247               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9248     if available cash-dis-rule
     9249              and cash-dis-rule.is-term = yes then do:
     9250       if cash-dis-rule.time-rule-num > 0 then do:
     9251         find first cash-dis-time-rule no-lock where
     9252                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9253         if available cash-dis-time-rule
     9254         and cash-dis-time-rule.templ-rl-root = 50001
     9255             or
     9256             (
     9257              (
     9258               (cash-dis-time-rule.date-from < today)
     9259               or
     9260               (cash-dis-time-rule.date-from = 12/31/1989)
     9261              )
     9262             and
     9263             (
     9264              (cash-dis-time-rule.date-to >= today)
     9265              or
     9266              (cash-dis-time-rule.date-to = 12/31/1989)
     9267             )
     9268            ) then do:
     9269            temp-disc-dec = ?.
     9270         end.
     9271         else do:
     9272           assign
     9273           temp-disc-dec = 0
     9274           .
     9275         end.
     9276       end.
     9277       else do:
     9278         temp-disc-dec = ?.
     9279       end.
     9280       if temp-disc-dec = ? then do:
     9281         case cash-dis-rule.value-type:
     9282           when integer('1':U) then do:
     9283         assign
     9284         temp-disc-dec = - cash-dis-rule.discnt-value
     9285         .
     9286       end.
     9287           when integer('11':U) then do:
     9288             find first cash-gds-discnt where
     9289                       cash-gds-discnt.b-code = cash-gds.b-code
     9290                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9291                   and cash-gds-discnt.obj-type = 'маг':U
     9292                   and cash-gds-discnt.obj-code = i-obj-code
     9293                   no-error.
     9294             if available cash-gds-discnt then do:
     9295               assign
     9296               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
     9297               .
     9298             end.
     9299             else do:
     9300              assign
     9301               temp-disc-dec = 0.
     9302             end.
     9303           end.
     9304           otherwise do:
     9305             temp-disc-dec = 0.
     9306           end.
     9307         end case.
     9308       end.
     9309     end.
     9310   end.
     9311   CASE pos-type:
     9312     when 'MAGIA-XML':U
     9313     then do:
     9314       if cash-gds.b-str <> "":U then do:
     9315         return.
     9316       end.
     9317       assign
     9318       chk_name = replace(cash-gds.gds-name, chr(34), "":U) + cash-gds.f-name
     9319       .
     9320       if cash-gds.unit-base <> cash-gds.unit-cli then
     9321       assign
     9322       chk_name = string(substr(chk_name, 1, max(33, 50 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))) +
     9323                         "*":U +
     9324                         trim(string( cash-gds.cli-base-rate ), chr(32)), "x(50)":U ).
     9325       else
     9326       chk_name = string(chk_name, "X(50)":U).
     9327       assign
     9328       second-name = replace(cash-gds.gds-namelong, chr(39), "":U)
     9329       second-name =   (chr(34) +
     9330                         TRIM(CAPS(string( replace(second-name, chr(34), "":U), "X(40)":U )))
     9331                         + chr(34) )
     9332       .
     9333       if cash-gds.unit-base <> cash-gds.unit-cli then
     9334       assign
     9335       second-name = string(substr(second-name, 1, max(23, 40 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))  ) +
     9336                         "*":U +
     9337                         trim(string(cash-gds.cli-base-rate), chr(32)), "x(40)":U ).
     9338       else
     9339       second-name = string(second-name, "X(40)":U).
     9340       if tax-cass AND cash-gds.new-good then do:
     9341           for each cash-txr No-LOCK WHERE
     9342                     cash-txr.rc = cash-gds.rc AND
     9343                     cash-txr.host-code = ub.shop.host-code AND
     9344                     cash-txr.obj-type = 'маг':U AND
     9345                     cash-txr.obj-code = ub.shop.obj-code:
     9346             run putc-13(buffer buf_cash-desk
     9347                       , input pos-type
     9348                       , input p-cash-os
     9349                       , input yes
     9350                       ).
     9351           end.
     9352       end.
     9353   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9354   define variable mi-entry as integer no-undo .
     9355   define variable v-out-code like ub.fbr-gds-grp.out-code no-undo .
     9356   define variable v-out-code-0 like ub.fbr-gds-grp.out-code no-undo .
     9357   define variable v-global-code like ub.fbr-gds-grp.global-code no-undo .
     9358   define variable v-xml-vat like ub.tax-rate-value.rate-value no-undo .
     9359   define variable v-xml-slt like ub.tax-rate-value.rate-value no-undo .
     9360   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     9361   define buffer buf_tax-rate for ub.tax-rate.
     9362   find first buf_fbr-gds-grp no-lock where
     9363              buf_fbr-gds-grp.obj-type = 'маг':U
     9364          AND buf_fbr-gds-grp.obj-code = i-obj-code
     9365         AND buf_fbr-gds-grp.node-code = cash-gds.fbr-grp-code no-error .
     9366   if avail buf_Fbr-gds-grp then do:
     9367     assign
     9368     v-out-code = buf_fbr-gds-grp.out-code
     9369     v-global-code = buf_fbr-gds-grp.global-code
     9370     .
     9371   end.
     9372   else do:
     9373     assign
     9374     v-global-code = cash-gds.fbr-grp-code-0
     9375     .
     9376   end.
