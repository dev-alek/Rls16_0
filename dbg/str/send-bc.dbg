    12017                      AND cash-ncr-save-param.cd-line = substring(ss, 1, 24))
    12018         then do:
    12019           put stream plucash unformatted
    12020           ss skip.
    12021           next _rr.
    12022         end.
    12023         find first buf_cash-ncr-dis-kat no-lock where
    12024                   buf_cash-ncr-dis-kat.dis-kat = - 1
    12025               AND buf_cash-ncr-dis-kat.cd-subject-code = substring(ss, 1, 16) no-error.
