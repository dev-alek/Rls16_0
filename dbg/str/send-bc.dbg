     7625   define variable v-ban-bonus as character no-undo .
     7626   define variable v-ptrl-as-good as character no-undo .
     7627   define variable v-type as character no-undo .
     7628   define variable disc-b-code as integer no-undo .
     7629   define variable v-main-prt-b-code as integer no-undo .
     7630   define variable IBM-good-code as character no-undo .
     7631   define variable IBM-good-code-2 as character no-undo .
     7632   define variable IBM2-short      as character no-undo .
     7633   define variable v-gds-null-price as character no-undo .
     7634   define variable iii as integer no-undo .
     7635   define variable v-mask-full as character no-undo .
     7636   define variable v-mask-short as character no-undo .
     7637   define variable vKKT as integer no-undo.
     7638   define variable attrValue as character no-undo.
     7639   define variable attrType  as character no-undo.
     7640   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7641   define buffer buf_price-list for ub.price-list.
     7642   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7643   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7644   define buffer main-prt-bar-code  for ub.bar-code.
     7645   define buffer buf_goods-attr for goods-attr.
     7646   define buffer b-code for code.
     7647   if action = "U" then do:
     7648     if loc-bar-code.stts = Integer('79':U) then return.
     7649       for-price = ?.
     7650   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7651   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7652     (input  'маг':U
     7653     ,input  ub.shop.obj-code
     7654     ,input  loc-bar-code.b-code
     7655     ,input  main-b-code
     7656     ,input  0
     7657     ,output v-doc-num
     7658     ,output for-price
     7659     ,output for-road
     7660     ,output for-excise
     7661     ) no-error .
     7662       if error-status:error then do:
     7663           if g#news
     7664           or g#auto
     7665           or g#esys
     7666           then return error.
     7667           else do:
     7668               error-status:error = no.
     7669               message "Ошибка при определении цены на товар "
     7670                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7671               view-as alert-box ERROR.
     7672               return.
     7673           end.
     7674       end.
     7675       if return-value = "error" then do:
     7676           if for-price = ? then do:
     7677             return.
     7678           end.
     7679           if not g#news
     7680           and not g#auto
     7681           and not g#esys
     7682           then
     7683           message prichina view-as alert-box ERROR.
     7684           return error.
     7685       end.
     7686       else if (for-price = ? or for-price = 0) then do:
     7687         if v-is-restaurant and v-is-null-price  then do:
     7688           assign
     7689           for-price = 0.
     7690         end.
     7691         else do:
     7692           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7693                                                  ,input 'null-price':U
     7694                                                  ,output v-gds-null-price
     7695                                                  ,output v-type) no-error.
     7696           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7697           return "NEXT".
     7698         end.
     7699       end.
     7700     end.
     7701     else do:
     7702           for-price = 0.
     7703     end.
     7704   for-price = round-m( for-price , rnd-znak ).
     7705   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7706   start-paket = no.
     7707   if not avail cash-gds then do:
     7708   create cash-gds.
     7709   error-status:error = false.
     7710   end.
     7711   cash-gds.crf = cr + 1.
     7712   cr = cr + 1.
     7713   if loc-bar-code.in-code <> ''
     7714   or loc-bar-code.part-code <> ''
     7715   then do:
     7716     find first main-prt-bar-code no-lock where
     7717               main-prt-bar-code.gds-code = loc-goods.gds-code
     7718           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7719           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7720           and main-prt-bar-code.part-code = ''
     7721           and main-prt-bar-code.in-code = '' no-error.
     7722     if available main-prt-bar-code then do:
     7723       v-main-prt-b-code = main-prt-bar-code.b-code.
     7724     end.
     7725   end.
     7726   else do:
     7727     v-main-prt-b-code = loc-bar-code.b-code.
     7728   end.
     7729   find first tt-tax no-lock where
     7730              tt-tax.tax-code = vattaxcd no-error .
     7731   do iii = 1 to num-entries(mask_s-c) :
     7732     assign
     7733       v-mask-full  = trim(entry(iii, mask_s-c))
     7734       v-mask-short = entry(1, v-mask-full, "*")
     7735       loc-prod-bc  = trim(loc-prod-bc)
     7736     .
     7737     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7738       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7739   end.
     7740   define variable vBc-on as logical no-undo.
     7741   if loc-prod-bc ne ?
     7742   then do:
     7743       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7744                            and prod-bc.b-str  eq loc-prod-bc
     7745                            no-lock no-error.
     7746       if available prod-bc
     7747       then
     7748          vBc-on = prod-bc.bc-on.
     7749       else
     7750          vBc-on = yes.
     7751   end.
     7752   else
     7753      vBc-on = yes.
     7754   run gdsoattr-value in this-procedure (
     7755     'dt-seasons':U,
     7756     loc-goods.gds-code,
     7757     parobj-type,
     7758     parobj-code,
     7759     output attrValue,
     7760     output attrType
     7761   ) no-error.
     7762   if attrValue <> "" then do:
     7763     find first b-code where
     7764                b-code.parent = "DTSeasons"
     7765            and b-code.code   = attrValue
     7766          no-lock no-error.
     7767     v-main-prt-b-code = integer(b-code.code).
     7768   end.
     7769   else release b-code.
     7770   assign
     7771   cash-gds.gds-code = loc-goods.gds-code
     7772   cash-gds.artic = loc-goods.artic
     7773   cash-gds.b-code = loc-bar-code.b-code
     7774   cash-gds.main-prt-b-code = v-main-prt-b-code
     7775   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7776   cash-gds.bc-on-type = loc-bc-on-type
     7777   cash-gds.bc-on = vBc-on
     7778   cash-gds.unit-cli = loc-bar-code.unit-cli
     7779   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7780   cash-gds.std-discnt-rule = std-discnt-rule_
     7781   cash-gds.gds-namelong = loc-goods.gds-name
     7782   cash-gds.gds-name = IF nam-2str
     7783                       then if available b-code then b-code.codename else loc-goods.gds-name
     7784                       else (
     7785                             IF nam-artc
     7786                             then loc-goods.artic
     7787                             else if available b-code
     7788                                  then b-code.codename
     7789                                  else (if loc-goods.chk-name <> ""
     7790                                        then loc-goods.chk-name
     7791                                        else loc-goods.gds-name)
     7792                            )
     7793   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7794   cash-gds.unit-base = loc-goods.unit-base
     7795   cash-gds.grp-code = for-grp-code
     7796   cash-gds.fp = for-fp
     7797   cash-gds.ingredient = loc-goods.struct
     7798   cash-gds.producer = for-producer
     7799   cash-gds.producer-int = for-producer-int
     7800   cash-gds.alpha1     = loc-goods.alpha1.
     7801     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7802                                            ,input 'office-type':U
     7803                                            ,output v-oss
     7804                                            ,output v-type) no-error.
     7805   cash-gds.office-type = v-oss.
     7806     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7807                                            ,input 'type-method-calc':U
     7808                                            ,output v-oss
     7809                                            ,output v-type) no-error.
     7810   if v-oss <> "" then
     7811     assign
     7812       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7813       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7814     .
     7815   else
     7816     assign
     7817       cash-gds.CalculationMethod = 0
     7818       cash-gds.CalculationMethodRestr = 0
     7819     .
     7820   assign
     7821   cash-gds.fact-qnty = for-fact-qnty
     7822   cash-gds.okei = loc-bc-units-okei
     7823   cash-gds.kat-discnt-method = kat-discnt-method_
     7824   cash-gds.temp-discnt-method = temp-discnt-method_
     7825   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7826                                then  kat-discnt-rule_pdf
     7827                                else  kat-discnt-rule_)
     7828   cash-gds.date-discnt-rule = date-discnt-rule_
     7829   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7830   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7831   cash-gds.wgd-rule = for-wgd
     7832   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7833                           then 1
     7834                           else 0)
     7835   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7836                        or for-petrol-purse
     7837                        then (cash-gds.gds-stat + 8)
     7838                        else cash-gds.gds-stat)
     7839   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7840                       then (cash-gds.gds-stat + 16)
     7841                       else cash-gds.gds-stat
     7842   cash-gds.gds-stat = if cash-gds.fp
     7843                       then (cash-gds.gds-stat + 2)
     7844                       else cash-gds.gds-stat
     7845   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7846                       then (cash-gds.gds-stat + 128)
     7847                       else cash-gds.gds-stat
     7848   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7849   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7850                                then temp-discnt-rule_pdf
     7851                                else temp-discnt-rule_)
     7852   cash-gds.wd-rule = for-wd
     7853   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7854   cash-gds.need-auth = (if need-auth then 1 else 0)
     7855   cash-gds.price-sale =  for-price
     7856   cash-gds.unit-type = loc-units.type
     7857   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7858   cash-gds.tax-string = tax-string
     7859   cash-gds.new-good = new-good
     7860   cash-gds.rc = recid(loc-goods)
     7861   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7862   cash-gds.vat-pc = (if avail tt-tax
     7863                      then tt-tax.rate-value
     7864                      else 0)
     7865   cash-gds.vat-code = (if avail tt-tax
     7866                        then tt-tax.rate-code
     7867                        else ?)
     7868   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7869   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7870   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7871   cash-gds.fbr-grp-code = v-fbr-grp-code
     7872   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7873   cash-gds.DepartID = v-fbr-obj-code
     7874   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7875   cash-gds.node-code = loc-bar-code.node-code
     7876   cash-gds.taracode = for-taracode
     7877   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7878                            and loc-bar-code.in-code = ""
     7879                            and loc-bar-code.part-code = ""
     7880                            and cash-gds.unit-base = cash-gds.unit-cli
     7881                            then yes
     7882                            else no)
     7883   cash-gds.obj-type = parobj-type
     7884   cash-gds.obj-code = parobj-code
     7885   .
     7886   assign
     7887   cash-gds.gds-name1 =   name-2cdf(
     7888                         input name-2cd
     7889                       , input yes
     7890                       , input cod-pcod
     7891                       , input cash-gds.b-code
     7892                       , input loc-goods.gds-code
     7893                       , input loc-goods.artic
     7894                       , input loc-goods.engl-name
     7895                       , input loc-bar-code.in-code
     7896                       , input loc-bar-code.part-code
     7897                       , input parobj-type
     7898                       , input parobj-code
     7899                       , input loc-goods.alpha1
     7900                       , output v-gtd
     7901                       )
     7902   cash-gds.gtd   = v-gtd
     7903   .
     7904   vKKT = 255.
     7905   find first b-code where
     7906              b-code.parent  = "okei-kkt"
     7907          and b-code.code    = string(cash-gds.okei)
     7908          and b-code.status_ = 0
     7909   no-lock no-error.
     7910   if avail b-code then
     7911      vKKT = integer(b-code.CodeName) no-error.
     7912   if error-status:error then vKKT = 255.
     7913   cash-gds.kkt = vKKT.
     7914   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7915      run gds-attr-value in this-procedure  (
     7916                                             input cash-gds.gds-code
     7917                                            ,input 'fuel-type':U
     7918                                            ,output v-is-gas
     7919                                            ,output v-type) no-error.
     7920      run gds-attr-value in this-procedure  (
     7921                                             input cash-gds.gds-code
     7922                                            ,input 'ptrl-as-good':U
     7923                                            ,output v-ptrl-as-good
     7924                                            ,output v-type) no-error.
     7925      assign
     7926      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7927      no-error .
     7928      assign
     7929      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7930      no-error .
     7931      if cash-gds.is-gas then do:
     7932        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7933      end.
     7934   end.
     7935      run gds-attr-value in this-procedure  (
     7936                                             input cash-gds.gds-code
     7937                                            ,input 'ban-bonus':U
     7938                                            ,output v-ban-bonus
     7939                                            ,output v-type) no-error.
     7940     assign
     7941      cash-gds.wd = int(logical(v-ban-bonus))
     7942      no-error .
     7943   if how-temp-disc = 'temp-disc':U then do:
     7944     case temp-discnt-method_:
     7945       when "" then do:
     7946       end.
     7947       when "bar-code.b-code" then do:
     7948         if loc-bar-code.in-code <> ''
     7949         or loc-bar-code.part-code <> ''
     7950         then do:
     7951           disc-b-code = cash-gds.main-prt-b-code.
     7952         end.
     7953         else do:
     7954           disc-b-code = cash-gds.b-code.
     7955         end.
     7956         find first buf_temp-dis-gds-rule where
     7957                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7958             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7959         if available buf_temp-dis-gds-rule then do:
     7960             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7961         end.
     7962       end.
     7963       otherwise do:
     7964         cash-gds.temp-discnt-rule = 0.
     7965       end.
     7966     end.
     7967   end.
     7968   assign
     7969   cash-gds.gds-name1 =   name-2cdf(
     7970                         input name-2cd
     7971                       , input yes
     7972                       , input cod-pcod
     7973                       , input cash-gds.b-code
     7974                       , input loc-goods.gds-code
     7975                       , input loc-goods.artic
     7976                       , input loc-goods.engl-name
     7977                       , input loc-bar-code.in-code
     7978                       , input loc-bar-code.part-code
     7979                       , input parobj-type
     7980                       , input parobj-code
     7981                       , input loc-goods.alpha1
     7982                       , output v-gtd
     7983                       )
     7984   cash-gds.gtd   = v-gtd
     7985   .
