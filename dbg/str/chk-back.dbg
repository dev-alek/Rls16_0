      946     define variable v-attr-value as character no-undo .
      947     define variable v-attr-type  as character no-undo .
      948     define variable v-ask-sysadm-passwd as logical   no-undo .
      949     assign
      950       v-ask-sysadm-passwd = false
      951     .
      952     define variable v-arh-detail-date as date      no-undo .
      953     run clntattr-value in this-procedure
      954       (input  buf_trn-doc.obj-type
      955       ,input  buf_trn-doc.obj-code
      956       ,input  'arh-detail':U
      957       ,output v-attr-value
      958       ,output v-attr-type
      959       ) .
      960     if v-attr-type = 'T':U
      961     then do:
      962       assign
      963         v-arh-detail-date = date(v-attr-value)
      964       .
      965     end.
      966     if  v-arh-detail-date <> ?
      967     and p-fact-date < v-arh-detail-date
      968     then do:
      969       message
      970         "Дата закрытия документа более ранняя, чем дата начала подробного складского архива по товарам" skip
      971         "Документ не может быть закрыт указанной датой" skip
