      898       (input 'ahsp':U
      899       ,input buf_trn-doc.obj-code
      900       ,input 0
      901       ,input 0
      902       ,input buf_trn-doc.obj-type
      903       ,input ""
      904       ,input ""
      905       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
      906       ,input true
