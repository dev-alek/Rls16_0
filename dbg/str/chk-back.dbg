      653   define buffer buf_trn-doc for ub.trn-doc .
      654   define variable v-cur-date          as date      no-undo .
      655   define variable v-value-character   as character no-undo .
      656   define variable v-date-close-period as date      no-undo .
      657   define variable v-value-decimal     as decimal   no-undo .
      658   define variable v-value-integer     as integer   no-undo .
      659   define variable v-value-logical     as logical   no-undo .
      660   define variable v-value-type        as character no-undo .
      661   do
      662   on error undo, return error return-value
      663   :
      664     find first buf_trn-doc exclusive-lock
      665       where buf_trn-doc.doc-code = p-doc-code
      666       no-error .
      667     if not available buf_trn-doc
      668     then do:
      669       message
      670         vss-workfile vss-revision vss-description skip
      671         "Ошибка задания входных параметров" skip
      672         "Не найден документ" skip
      673         "Документ" p-doc-code skip
      674         "Дата" p-fact-date skip
      675         view-as alert-box error .
      676       undo, return error return-value .
      677     end.
      678     if p-fact-date = ?
      679     then do:
      680       message
      681         vss-workfile vss-revision vss-description skip
      682         "Ошибка задания входных параметров" skip
      683         "Не указана дата закрытия документа"
      684         "Документ" p-doc-code skip
      685         "Дата" p-fact-date skip
      686         view-as alert-box error .
      687       undo, return error return-value .
      688     end.
      689     for each thbjattr_thbj-attr:
      690       delete thbjattr_thbj-attr.
      691     end.
      692     run adm/shattri.p (
      693         input "get":U
      694         ,input buf_trn-doc.obj-type
      695         ,input buf_trn-doc.obj-code
      696         ,input 'nakl_par':U
      697         ,input  "date-close-period"
      698         ,output v-value-character
      699         ,output v-date-close-period
      700         ,output v-value-decimal
      701         ,output v-value-integer
      702         ,output v-value-logical
      703         ,output v-value-type
      704         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      705         ) no-error .
      706         if error-status :error then v-date-close-period = date('').
      707         if v-date-close-period <> date('') then do:
      708             if  p-fact-date < v-date-close-period
      709             then do:
      710               return error substitute(
      711                 "Дата закрытия документа &1 более ранняя, чем дата закрытия периода &2
      712                 Дата закрытия документа &3 &2
      713                 Дата закрытия периода &4
      714                 Объект &5 &6     " ,
      715                 buf_trn-doc.doc-code  ,
      716                 chr(10)  ,
      717                 string ( p-fact-date        , "99/99/9999") ,
      718                 string ( v-date-close-period, "99/99/9999") ,
      719                 buf_trn-doc.obj-type ,
      720                 buf_trn-doc.obj-code
      721                 ) .
      722             end.
      723         end.
      724     if buf_trn-doc.cli-type = 'маг':U or buf_trn-doc.cli-type = 'скл':U  then do:
      725         for each thbjattr_thbj-attr:
      726           delete thbjattr_thbj-attr.
      727         end.
      728         run adm/shattri.p (
      729             input "get":U
      730             ,input buf_trn-doc.cli-type
      731             ,input buf_trn-doc.cli-code
      732             ,input 'nakl_par':U
      733             ,input  "date-close-period"
      734             ,output v-value-character
      735             ,output v-date-close-period
      736             ,output v-value-decimal
      737             ,output v-value-integer
      738             ,output v-value-logical
      739             ,output v-value-type
      740             ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      741             ) no-error .
      742             if error-status :error then v-date-close-period = date('').
      743             if v-date-close-period <> date('') then do:
      744                 if  p-fact-date < v-date-close-period
      745                 then do:
      746                   return error substitute(
      747                     "Дата закрытия документа &1 более ранняя, чем дата закрытия периода &2
      748                     Дата закрытия документа &3 &2
      749                     Дата закрытия периода &4
      750                     Объект &5 &6     " ,
      751                     buf_trn-doc.doc-code  ,
      752                     chr(10)  ,
      753                     string ( p-fact-date        , "99/99/9999") ,
      754                     string ( v-date-close-period, "99/99/9999") ,
      755                     buf_trn-doc.cli-type ,
      756                     buf_trn-doc.cli-code
      757                     ) .
      758                 end.
      759             end.
      760     end.
      761     if buf_trn-doc.hold-obj-type = 'маг':U or buf_trn-doc.hold-obj-type = 'скл':U  then do:
      762         for each thbjattr_thbj-attr:
      763           delete thbjattr_thbj-attr.
      764         end.
      765         run adm/shattri.p (
      766             input "get":U
      767             ,input buf_trn-doc.hold-obj-type
      768             ,input buf_trn-doc.hold-obj-code
      769             ,input 'nakl_par':U
      770             ,input  "date-close-period"
      771             ,output v-value-character
      772             ,output v-date-close-period
      773             ,output v-value-decimal
      774             ,output v-value-integer
      775             ,output v-value-logical
      776             ,output v-value-type
      777             ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      778             ) no-error .
      779             if error-status :error then v-date-close-period = date('').
      780         if v-date-close-period <> date('') then do:
      781         if  p-fact-date < v-date-close-period
      782         then do:
      783           return error substitute(
      784             "Дата закрытия документа &1 более ранняя, чем дата закрытия периода &2
      785             Дата закрытия документа  &3 &2
      786             Дата закрытия периода    &4 &2
      787             Объект &5 &6 "
      788             ,
      789             buf_trn-doc.doc-code  ,
      790             chr(10)  ,
      791             string ( p-fact-date, "99/99/9999") ,
      792             string ( v-date-close-period,   "99/99/9999") ,
      793                       buf_trn-doc.hold-obj-type ,
      794                       buf_trn-doc.hold-obj-code  ) .
      795         end.
      796     end.
      797     end.
      798   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      800     (input  buf_trn-doc.obj-type
      801     ,input  buf_trn-doc.obj-code
      802     ,output v-cur-date
      803     ) no-error .
      804     if error-status :error
      805     then do:
      806       message
      807         vss-workfile vss-revision vss-description skip
      808         "Ошибка при определении текущей даты на объекте" skip
      809         view-as alert-box error .
      810       undo, return error return-value .
      811     end.
      812     if p-fact-date > v-cur-date
      813     then do:
      814       message
      815         "Нельзя закрыть документ будующим числом" skip
      816         "Документ" p-doc-code  skip
      817         "Дата закрытия документа" p-fact-date skip
      818         "Сегодня" v-cur-date skip
      819         view-as alert-box error .
      820       undo, return error return-value .
      821     end.
      822     if p-fact-date = v-cur-date
      823     or buf_trn-doc.ext-doc-type = 'io':U
      824     then do:
      825       return .
      826     end.
      827     if  p-fact-date < v-cur-date
      828     and p-fact-date > v-cur-date - 15
      829     then do:
      830       define variable v-ok as logical   no-undo .
      831       message
      832         "Фактическая дата документа отличается от текущей даты на объекте" skip
      833         "Это может привести к перерасчету складских архивов за" v-cur-date - p-fact-date "дней" skip
      834         "Документ" p-doc-code  skip
      835         "Дата закрытия документа" p-fact-date skip
      836         "Сегодня" v-cur-date skip
      837         "Продолжить?" skip
      838         view-as alert-box question buttons yes-no update v-ok .
      839       if v-ok <> true
      840       then do:
      841         undo, return error "Документ не был закрыт".
      842       end.
      843     end.
      844     if p-fact-date <= v-cur-date - 15
      845     then do:
      846       message
      847         "ВНИМАНИЕ!!!" skip
      848         "Фактическая дата документа отличается от текущей даты на объекте" skip
      849         "Количество дней, за которые будут перерассчитаны складские архивы" v-cur-date - p-fact-date skip
      850         "" skip
      851         "Такой перерасчет может занять много времени, в течение которого нельзя будет получить отчеты по объекту" skip
      852         "Документ" p-doc-code  skip
      853         "Дата закрытия документа" p-fact-date skip
      854         "Сегодня" v-cur-date skip
      855         "Продолжить?" skip
      856         view-as alert-box question buttons yes-no update v-ok .
      857       if v-ok <> true
      858       then do:
      859         undo, return error "Документ не был закрыт".
      860       end.
      861       define variable v-permit as logical   no-undo .
      862       run gbl/authoriz.p
      863         (input  "Разрешение на закрытие документа с датой более 15 дней назад"
      864         ,output v-permit
      865         ) .
      866       if v-permit <> true
      867       then do:
      868         undo, return error "Документ не был закрыт".
      869       end.
      870     end.
      871     define buffer calc-arh-lock_batchprocess for ub.batchprocess .
      872     run gbl/lock-prc.p
      873       (input 'btpr':U
      874       ,input buf_trn-doc.obj-code
      875       ,input 0
      876       ,input 0
      877       ,input buf_trn-doc.obj-type
      878       ,input ""
      879       ,input ""
      880       ,input "Объект,,, ,,,Расчет складского архива по товарам"
      881       ,input true
      882       ,buffer calc-arh-lock_batchprocess
      883       ) no-error .
      884     if error-status :error
      885     then do:
      886       message
      887         vss-workfile vss-revision vss-description skip
      888         "В данный момент рассчитывается складской архив по товарам" skip
      889         "Невозможно закрыть документ задним числом" skip
      890         "Документ" p-doc-code  skip
      891         "Дата закрытия документа" p-fact-date skip
      892         "Сегодня" v-cur-date skip
      893         view-as alert-box error .
      894       undo, return error "Документ не был закрыт" .
      895     end.
