        1   DEF TEMP-TABLE tt-gds NO-UNDO
        2       FIELD gds-code LIKE ub.goods.gds-code.
        3   DEFINE INPUT parameter parparentproc as widget-handle no-undo .
        4   DEFINE INPUT-OUTPUT PARAMETER TABLE FOR tt-gds .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Диалог выбора товара".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new shared temp-table gds-list no-undo like ub.goods
       71     field qnty   as decimal
       72     field to-del as logical
       73     field order-num as integer
       74     field to-sel as logical
       75     field promo-code as character
       76     field ActionId  as int64
       77     field db-num as integer
       78     index art  is primary unique artic prod-type prod-code
       79     index code is         unique gds-code
       80     index oi order-num
       81     index isel to-sel
       82     .
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  new shared  temp-table gds-list-hist no-undo
       85   field list-table as character
       86   field id as integer
       87   field line as integer
       88   field hist-mode as character
       89   field des as character
       90   field num-recs as integer
       91   field option_ as character
       92   field item_ as character
       93   field status_ as character
       94   field num-add as integer
       95   field num-ignored as integer
       96   field done as logical
       97   field err_ as logical
       98   field err-mes as character
       99   index pi is primary
      100   id
      101   line
      102   index isdone
      103   done
      104   .
      105   define new global shared variable g#library  as handle no-undo .
      106   define new global shared variable g#library2 as handle no-undo .
      107   procedure proc-alt-shift-f2:
      108     if not ibs.th.gbl.gbl-var:rcode
      109   then
      110     run gbl\inidebug.p .
      111   end.
      112   procedure proc-alt-shift-f3:
      113     run gbl/prvssinf.p
      114       ( input this-procedure
      115       ) .
      116   end.
      117   define variable v-inform-launched as logical no-undo initial false .
      118   procedure proc-alt-shift-f4:
      119     define variable v-action as character no-undo .
      120     if v-inform-launched = false then do:
      121       assign
      122         v-inform-launched = true
      123       .
      124       run gbl/d-inform.w
      125         (  input self
      126         ,  input this-procedure
      127         , output v-action
      128         ) no-error .
      129       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      130       assign
      131         v-inform-launched = false
      132       .
      133     end.
      134   end.
      135   procedure proc-alt-f1:
      136     run gbl/corrhelp.p
      137       (input this-procedure
      138       ) .
      139   end .
      140   on alt-shift-f2 anywhere do:
      141     run proc-alt-shift-f2.
      142   end.
      143   on alt-shift-f3 anywhere do:
      144     run proc-alt-shift-f3 in this-procedure .
      145   end.
      146   on alt-shift-f4 anywhere do:
      147     run proc-alt-shift-f4 in this-procedure.
      148   end.
      149   on alt-f1 anywhere do:
      150     run proc-alt-f1 in this-procedure .
      151   end.
      152   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure grp-attr-name :
      154   do
      155     on error undo, return error
      156     :
      157     define input  parameter p-code           as character no-undo .
      158     define output parameter p-type           as character no-undo .
      159     define output parameter p-format         as character no-undo .
      160     define output parameter p-label          as character no-undo .
      161     define output parameter p-user-can-edit  as logical   no-undo .
      162     define output parameter p-output-display as logical   no-undo .
      163     define output parameter p-other          as character no-undo .
      164       case p-code :
      165               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      166         otherwise do:
      167           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      168         end.
      169       end.
      170     end.
      171   end procedure.
      172   procedure grp-attr-tooltip :
      173   do
      174     on error undo, return error
      175     :
      176       define input  parameter p-code    as character no-undo .
      177       define output parameter p-tooltip as character no-undo .
      178       define output parameter p-label   as character no-undo .
      179       case p-code :
      180               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      181         otherwise do:
      182               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      183         end.
      184       end.
      185     end.
      186   end procedure.
      187   procedure grp-attr-value :
      188   do
      189   on error undo, return error
      190   :
      191   define input  parameter p-node-code   as integer    no-undo.
      192   define input  parameter p-code        as character  no-undo.
      193   define input  parameter p-host-code   as integer    no-undo.
      194   define input  parameter p-obj-type    as character  no-undo.
      195   define input  parameter p-obj-code    as integer    no-undo.
      196   define output parameter p-value       as character  no-undo.
      197   define output parameter p-type        as character  no-undo.
      198       define variable v-format         as character no-undo .
      199       define variable v-label          as character no-undo .
      200       define variable v-user-can-edit  as logical   no-undo .
      201       define variable v-output-display as logical   no-undo .
      202       define variable v-other          as character no-undo .
      203       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      204       run grp-attr-name in this-procedure (
      205             input  p-code
      206           , output p-type
      207           , output v-format
      208           , output v-label
      209           , output v-user-can-edit
      210           , output v-output-display
      211           , output v-other
      212       ) no-error .
      213       if error-status :error
      214       then do:
      215           undo, return error return-value .
      216       end.
      217       find first buf_gds-grp-attr no-lock
      218            where buf_gds-grp-attr.node-code = p-node-code
      219              and buf_gds-grp-attr.attr-code = p-code
      220              and buf_gds-grp-attr.host-code = p-host-code
      221              and buf_gds-grp-attr.obj-type  = p-obj-type
      222              and buf_gds-grp-attr.obj-code  = p-obj-code
      223       no-error .
      224       if available buf_gds-grp-attr
      225       then do:
      226           assign
      227               p-value = buf_gds-grp-attr.attr-value
      228           .
      229       end.
      230       else do:
      231           assign
      232               p-value = if p-type = 'L':U then "no":U else ""
      233           .
      234       end.
      235   end.
      236   end procedure.
      237   procedure grp-attr-write :
      238   do
      239   on error undo, return error
      240   :
      241   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      242   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      243   define input parameter p-host-code  as integer                          no-undo.
      244   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      245   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      246   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      247       define variable v-type              as character                no-undo.
      248       define variable v-format            as character                no-undo.
      249       define variable v-label             as character                no-undo.
      250       define variable v-user-can-edit     as logical                  no-undo.
      251       define variable v-output-display    as logical                  no-undo.
      252       define variable v-other             as character                no-undo.
      253       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      254       run grp-attr-name in this-procedure (
      255                         input  p-code
      256                       , output v-type
      257                       , output v-format
      258                       , output v-label
      259                       , output v-user-can-edit
      260                       , output v-output-display
      261                       , output v-other
      262       ) no-error.
      263       if error-status :error
      264       then do:
      265           undo, return error return-value.
      266       end.
      267       find first buf_gds-grp-attr exclusive-lock
      268            where buf_gds-grp-attr.node-code  = p-node-code
      269              and buf_gds-grp-attr.attr-code  = p-code
      270              and buf_gds-grp-attr.host-code  = p-host-code
      271              and buf_gds-grp-attr.obj-type   = p-obj-type
      272              and buf_gds-grp-attr.obj-code   = p-obj-code
      273       no-error.
      274       if not available buf_gds-grp-attr
      275       then do:
      276           create buf_gds-grp-attr.
      277           assign
      278                   buf_gds-grp-attr.node-code  = p-node-code
      279                   buf_gds-grp-attr.attr-code  = p-code
      280                   buf_gds-grp-attr.host-code  = p-host-code
      281                   buf_gds-grp-attr.obj-type   = p-obj-type
      282                   buf_gds-grp-attr.obj-code   = p-obj-code
      283                   buf_gds-grp-attr.attr-value = p-value
      284           .
      285       end.
      286       else do:
      287           assign
      288               buf_gds-grp-attr.attr-value = p-value
      289           .
      290       end.
      291   end.
      292   end procedure.
      293   procedure grp-attr-delete :
      294   do
      295   on error undo, return error
      296   :
      297   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      298   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      299   define input parameter p-host-code  as integer                      no-undo.
      300   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      301   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      302   define output parameter p-deleted   as logical                      no-undo.
      303       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      304       define variable v-type              as character                no-undo.
      305       define variable v-format            as character                no-undo.
      306       define variable v-label             as character                no-undo.
      307       define variable v-user-can-edit     as logical                  no-undo.
      308       define variable v-output-display    as logical                  no-undo.
      309       define variable v-other             as character                no-undo.
      310       run grp-attr-name in this-procedure
      311       ( input  p-code
      312       , output v-type
      313       , output v-format
      314       , output v-label
      315       , output v-user-can-edit
      316       , output v-output-display
      317       , output v-other
      318       ) no-error .
      319       if error-status :error then do:
      320           undo, return error return-value .
      321       end.
      322       find first buf_gds-grp-attr exclusive-lock
      323            where buf_gds-grp-attr.node-code  = p-node-code
      324              and buf_gds-grp-attr.attr-code  = p-code
      325              and buf_gds-grp-attr.host-code  = p-host-code
      326              and buf_gds-grp-attr.obj-type   = p-obj-type
      327              and buf_gds-grp-attr.obj-code   = p-obj-code
      328       no-error.
      329       if not available buf_gds-grp-attr
      330       then do:
      331           assign
      332               p-deleted = no
      333           .
      334       end.
      335       else do:
      336          delete buf_gds-grp-attr.
      337          assign
      338               p-deleted = yes
      339           .
      340       end.
      341   end.
      342   end procedure.
      343   procedure grp-attr-news :
      344   do
      345   on error undo, return error
      346   :
      347       define input  parameter p-code           as character no-undo .
      348       define output parameter p-news           as logical   no-undo .
      349       case p-code :
      350               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      351         otherwise do:
      352           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      353         end.
      354       end.
      355   end.
      356   end procedure.
      357   procedure grp-attr-obj-value :
      358   do
      359   on error undo, return error
      360   :
      361   define input parameter p-node-code as integer      no-undo.
      362   define input parameter p-obj-type  as character    no-undo.
      363   define input parameter p-obj-code  as integer      no-undo.
      364   define input parameter p-attr-code as character    no-undo .
      365   define output parameter p-attr-value     as character   no-undo.
      366   define output parameter p-range     as integer      no-undo.
      367   define output parameter p-exists    as logical      no-undo.
      368   define variable v-host-code as integer      no-undo.
      369   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      371     (input  p-obj-type
      372     ,input  p-obj-code
      373     ,output v-host-code
      374     ) no-error .
      375   if error-status :error
      376   then do:
      377       message
      378         vss-workfile vss-revision vss-description
      379         skip "Не удалось найти фирму объекта"
      380         skip p-obj-type p-obj-code
      381         skip return-value
      382         skip trim(error-status :get-message(1))
      383              trim(error-status :get-message(2))
      384              trim(error-status :get-message(3))
      385              trim(error-status :get-message(4))
      386              trim(error-status :get-message(5))
      387       view-as alert-box error.
      388       undo, return error .
      389   end.
      390   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      391   find first buf_gds-grp-attr no-lock
      392        where buf_gds-grp-attr.node-code = p-node-code
      393          and buf_gds-grp-attr.attr-code = p-attr-code
      394          and buf_gds-grp-attr.host-code = v-host-code
      395          and buf_gds-grp-attr.obj-type  = p-obj-type
      396          and buf_gds-grp-attr.obj-code  = p-obj-code
      397   no-error .
      398   if not available buf_gds-grp-attr
      399   then do:
      400       find first buf_gds-grp-attr no-lock
      401            where buf_gds-grp-attr.node-code = p-node-code
      402              and buf_gds-grp-attr.attr-code = p-attr-code
      403              and buf_gds-grp-attr.host-code = v-host-code
      404              and buf_gds-grp-attr.obj-type  = ""
      405              and buf_gds-grp-attr.obj-code  = 0
      406       no-error .
      407       if not available buf_gds-grp-attr
      408       then do:
      409           find first buf_gds-grp-attr no-lock
      410               where buf_gds-grp-attr.node-code = p-node-code
      411               and buf_gds-grp-attr.attr-code = p-attr-code
      412               and buf_gds-grp-attr.host-code = 0
      413               and buf_gds-grp-attr.obj-type  = ""
      414               and buf_gds-grp-attr.obj-code  = 0
      415           no-error .
      416           if not available buf_gds-grp-attr
      417           then do:
      418               assign
      419                   p-exists = no
      420               .
      421           end.
      422           else do:
      423               assign
      424                   p-exists = yes
      425                   p-range  = 1
      426               .
      427           end.
      428       end.
      429       else do:
      430           assign
      431               p-exists = yes
      432               p-range  = 2
      433           .
      434       end.
      435   end.
      436   else do:
      437       assign
      438           p-exists = yes
      439           p-range  = 3
      440       .
      441   end.
      442   if available buf_gds-grp-attr
      443   then do:
      444     assign
      445     p-attr-value = buf_gds-grp-attr.attr-value
      446     .
      447   end.
      448   end.
      449   end procedure.
      450   procedure ver-gds-grp-nabor :
      451   do
      452   on error undo, return error return-value
      453   :
      454   define input  parameter p-gds-code as integer   no-undo .
      455   define output parameter p-nabor as logical   no-undo .
      456   define buffer buf_goods for ub.goods.
      457   p-nabor = false .
      458   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      459   if error-status :error then return error .
      460   define variable v-value       as character  no-undo.
      461   define variable v-type        as character  no-undo.
      462     run grp-attr-value (
      463        input   buf_goods.grp-code
      464       ,input   'gds-grp-nabor':U
      465       ,input   0
      466       ,input   ""
      467       ,input   0
      468       ,output  v-value
      469       ,output  v-type       ) no-error .
      470       if error-status :error then return error .
      471     if v-value = "yes" then p-nabor = true  .
      472   end.
      473   end procedure.
      474   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475     define variable v-cntxt-db-num        as integer   no-undo .
      476     define variable v-cntxt-userid        as character no-undo .
      477     define variable v-cntxt-level         as character no-undo .
      478     define variable v-cntxt-host-code-obj as integer   no-undo .
      479     define variable v-cntxt-obj-type      as character no-undo .
      480     define variable v-cntxt-obj-code      as integer   no-undo .
      481     define variable v-cntxt-db-num-obj    as integer   no-undo .
      482     define variable v-cntxt-is-admin      as logical   no-undo .
      483   DEFINE BUFFER gds-b FOR ub.goods.
      484   DEFINE BUFFER g-producer FOR ub.clients.
      485   DEF VAR ref-list AS CHAR.
      486   DEFINE BUTTON B-gds
      487        IMAGE-UP FILE "btn-down-arrow":U
      488        IMAGE-DOWN FILE "btn-down-arrow":U
