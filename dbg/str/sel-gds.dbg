      492        BGCOLOR 8 FGCOLOR 0 .
      493   DEFINE BUTTON b-help
      494        LABEL "Помо&щь"
      495        SIZE 10 BY 1
      496        BGCOLOR 8 .
      497   DEFINE BUTTON B-list
      498        IMAGE-UP FILE "btn-down-arrow":U
      499        IMAGE-DOWN FILE "btn-down-arrow":U
      500        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      501        LABEL "":L
      502        SIZE 3.13 BY 1.04 TOOLTIP "Выбор товара из списка"
      503        BGCOLOR 8 FGCOLOR 0 .
      504   DEFINE BUTTON b-quit AUTO-END-KEY
      505        LABEL "&Отмена"
      506        SIZE 10 BY 1
      507        BGCOLOR 8 .
      508   DEFINE BUTTON b-sel AUTO-GO
      509        LABEL "&Ввод"
      510        SIZE 10 BY 1
      511        BGCOLOR 8 .
      512   DEFINE VARIABLE Fartic AS CHARACTER FORMAT "X(256)":U
      513        LABEL "Артикул"
      514        VIEW-AS FILL-IN
      515        SIZE 22 BY 1 NO-UNDO.
      516   DEFINE VARIABLE Fprod-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      517        LABEL "Производитель"
      518        VIEW-AS FILL-IN
      519        SIZE 14.5 BY 1 NO-UNDO.
      520   DEFINE VARIABLE Fprod-type AS CHARACTER FORMAT "X(256)":U
      521        VIEW-AS FILL-IN
      522        SIZE 5.5 BY 1 NO-UNDO.
      523   DEFINE FRAME Dialog-Frame
      524        Fartic AT ROW 1.5 COL 16 COLON-ALIGNED WIDGET-ID 2
      525        B-gds AT ROW 1.5 COL 40.5 WIDGET-ID 8
      526        B-list AT ROW 1.5 COL 43.5 WIDGET-ID 10
      527        Fprod-code AT ROW 2.5 COL 16 COLON-ALIGNED WIDGET-ID 4
      528        Fprod-type AT ROW 2.5 COL 32.5 COLON-ALIGNED NO-LABEL WIDGET-ID 6
      529        b-sel AT ROW 4.75 COL 14
      530        b-quit AT ROW 4.75 COL 28.5
      531        b-help AT ROW 5 COL 39
      532        SPACE(0.37) SKIP(0.24)
      533       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      534            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      535            TITLE "Выбор товара"
      536            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-quit WIDGET-ID 100.
      537   ASSIGN
      538          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      539          FRAME Dialog-Frame:HIDDEN           = TRUE.
      540   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      541   DO:
      542     APPLY "END-ERROR":U TO SELF.
      543   END.
      544   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
      545   DO:
      546   define variable v-stat as character no-undo init ?.
      547   define variable v-list as character no-undo init ?.
      548   define variable v-prod-type like ub.clients.obj-type no-undo .
      549   define variable v-prod-code like ub.clients.obj-code no-undo .
      550   if can-find (ub.clients where ub.clients.obj-type = input frame Dialog-Frame  Fprod-type
      551                                    and ub.clients.obj-code = input frame Dialog-Frame Fprod-code no-lock) then do:
      552     find g-producer where
      553          g-producer.obj-type = input frame Dialog-Frame Fprod-type
      554      and g-producer.obj-code = input frame Dialog-Frame Fprod-code no-lock.
      555     v-list = "производитель".
      556   end.
      557   else
      558   v-list = 'все':U.
      559   v-stat = 'текущие':U.
      560   run ref/gds-ref.p
      561     ( input parparentproc
      562       ,input "b-sel,b-mark,b-add"
      563       ,input v-stat
      564       ,input v-list
      565       ,INPUT ?
      566     ,input ?
      567     ,input ?
      568     ,input (if available g-producer then g-producer.obj-type else ?)
      569     ,input (if available g-producer then g-producer.obj-code else ?)
      570     ,input ?
      571     ,input ?
      572     ,input ?
      573     ,output ref-list).
      574   IF ref-list > "" THEN FOR FIRST ub.goods WHERE recid(ub.goods) = INTEGER(ENTRY(1,ref-list)) NO-LOCK:
      575       Fartic:SCREEN-VALUE = ub.goods.artic.
      576       Fprod-code:SCREEN-VALUE = string(ub.goods.prod-code).
      577       Fprod-type:SCREEN-VALUE = ub.goods.prod-type.
      578   END.
      579   END.
      580   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      581   OR HELP OF FRAME Dialog-Frame
      582   DO:
      583     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\str\sel-gds.w" VIEW-AS ALERT-BOX INFORMATION.
      584   END.
      585   ON CHOOSE OF B-list IN FRAME Dialog-Frame
      586   DO:
      587   define variable v-f as logical   no-undo init false .
      588   define variable v-erase-ass as logical   no-undo .
      589   define variable v-host-code like ub.sysconf.host-code no-undo .
      590   DEF VAR ref-list AS CHAR.
      591   run str/gds-list.w (
      592                        input parparentproc
      593                      , input ?
      594                      , input ?
      595                      , input ?).
      596   ref-list = ''.
      597   v-f = false  .
      598   FOR FIRST gds-list NO-LOCK:
      599       Fartic:SCREEN-VALUE = gds-list.artic.
      600       Fprod-code:SCREEN-VALUE = string(gds-list.prod-code).
      601       Fprod-type:SCREEN-VALUE = gds-list.prod-type.
      602   END.
      603   END.
      604   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      605   DO:
      606     EMPTY TEMP-TABLE tt-gds.
      607   END.
      608   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      609   DO:
      610   ASSIGN FRAME Dialog-Frame Fartic Fprod-code Fprod-type.
      611   IF Fartic > '' THEN.
      612   ELSE DO:
      613       MESSAGE 'Не указан Артикул!' VIEW-AS ALERT-BOX.
      614       apply "entry" to Fartic.
      615       RETURN NO-APPLY.
      616   END.
      617   find first ub.goods where ub.goods.artic  = Fartic no-lock no-error.
      618   if not available ub.goods then do:
      619     message "Неправильный Артикул - такого товара нет." VIEW-AS ALERT-BOX.
      620     apply "entry" to Fartic.
      621     RETURN NO-APPLY.
      622   end.
      623   find first gds-b where gds-b.artic  = Fartic
      624                      and recid (gds-b) <> recid (goods)
      625                      and gds-b.stts = 0 no-lock no-error.
      626   if Fprod-code <> 0 then do:
      627     find first ub.goods where ub.goods.prod-code   = Fprod-code
      628                        and  ub.goods.artic      = Fartic no-lock no-error.
      629     if not available ub.goods then do:
      630       message "Неправильный Код производителя - такого товара нет." VIEW-AS ALERT-BOX.
      631       apply "entry" to Fprod-code in frame Dialog-Frame.
      632       RETURN  NO-APPLY.
      633     end.
      634     find first gds-b where gds-b.artic     = Fartic
      635                        and gds-b.prod-code = Fprod-code
      636                        and recid (gds-b) <> recid (ub.goods)
      637                        and gds-b.stts = 0 no-lock no-error.
      638   end.
      639   else do:
      640     if available gds-b then do:
      641       if available g-producer then
      642         find ub.goods where ub.goods.prod-type = g-producer.obj-type
      643                              and  ub.goods.prod-code = g-producer.obj-code
      644                              and  ub.goods.artic          = Fartic no-lock no-error.
      645       if not available g-producer or (available g-producer and not available ub.goods) then do:
      646         message "С артикулом :" Fartic
      647                         "несколько товаров." skip (2)
      648                         "Укажите Производителя или выберите товар из справочника." VIEW-AS ALERT-BOX.
      649         apply "entry" to Fprod-code in frame Dialog-Frame.
      650         RETURN  NO-APPLY.
      651       end.
      652     end.
      653   end.
      654   if Fprod-code <> 0  and
      655      Fprod-type <> "" then do:
      656      find goods where goods.prod-type = Fprod-type and
      657                      goods.prod-code = Fprod-code and
      658                      goods.artic     = Fartic no-lock no-error.
      659      if not available goods then do:
      660       message "Неправильный Тип производителя - такого товара нет." VIEW-AS ALERT-BOX.
      661       apply "entry" to Fprod-type in frame Dialog-Frame.
      662       RETURN  NO-APPLY.
      663      end.
      664   end.
      665   else do:
      666     if available gds-b then do:
      667       if available g-producer then
      668         find goods where goods.prod-type = g-producer.obj-type and
      669                          goods.prod-code = g-producer.obj-code and
      670                          goods.artic     = Fartic no-lock no-error.
      671       if not available g-producer or (available g-producer and not available goods) then do:
      672         message "С артикулом :" Fartic
      673                         "несколько товаров." skip (2)
      674                         "Укажите Производителя или выберите товар из справочника." VIEW-AS ALERT-BOX.
      675         apply "entry" to Fprod-type in frame Dialog-Frame.
      676         RETURN  NO-APPLY.
      677       end.
      678     end.
      679   end.
      680   IF NOT AVAILABLE goods THEN DO:
      681       MESSAGE 'Не выбран товар!'VIEW-AS ALERT-BOX.
      682       APPLY 'entry':U TO Fartic.
      683       RETURN  NO-APPLY.
      684   END.
      685   EMPTY TEMP-TABLE tt-gds.
      686   CREATE tt-gds.
      687   tt-gds.gds-code = goods.gds-code.
      688   RELEASE tt-gds.
      689   END.
      690   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      691   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      692   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   on help of frame Dialog-Frame
      694   do:
      695     run gbl/app_help.p
      696       (input this-procedure :file-name
      697       ,input ''
      698       ,input ?
      699       ) no-error.
      700     if error-status :error then do:
      701       message
      702         "Ошибка при вызове помощи"
      703         error-status :get-message(1)
      704         view-as alert-box .
      705     end.
      706   end.
      707   run minbtn-set in this-procedure .
      708   on choose of b-help in frame Dialog-Frame
      709   do:
      710     apply "help":u to frame Dialog-Frame .
      711   end.
      712   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   procedure minbtn-set :
      714       do
      715           on error undo, return error return-value
      716           :
      717           define variable ii              as integer       no-undo .
      718           define variable fh              as widget-handle no-undo .
      719           define variable hh              as widget-handle no-undo .
      720           define variable v-h             as handle        extent 4 no-undo .
      721           define variable v-name-button   as character     no-undo .
      722           define variable v-help-old-x    as decimal       no-undo .
      723           define variable v-help-old-y    as decimal       no-undo .
      724           define variable v-help-old-size as decimal       no-undo .
      725           define variable v-frame-width   as decimal       no-undo .
      726           define variable jj              as integer       no-undo .
      727           do
      728               on error undo, return error
      729               :
      730               assign
      731                   v-frame-width = frame Dialog-Frame:width - 0.3
      732                   fh            = frame Dialog-Frame:first-child
      733                   hh            = fh:first-child
      734                   ii            = 1
      735                   .
      736               do while valid-handle(hh):
      737                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      738                   do:
      739                       case lc(hh:name) :
      740                           when "b-help" then
      741                               do:
      742                                   hh:load-image-up("cmp/b-help.bmp":u) .
      743                                   hh:load-image-down("cmp/b-help.bmp":u) .
      744                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      745                                   hh:TOOLTIP = "Помощь" .
      746                                   v-help-old-x = hh:column .
      747                                   v-help-old-y = hh:row    .
      748                                   v-help-old-size = hh:width .
      749                                   hh:width-chars = 2.5 .
      750                               end.
      751                           when "b-print" then
      752                               do:
      753                                   hh:load-image("cmp/b-print.bmp":u) .
      754                                   hh:TOOLTIP = "Печать" .
      755                                   v-h[ii] = hh:handle .
      756                                   ii = ii + 1 .
      757                                   hh:width-chars = 3 .
      758                               end.
      759                           when "b-history" or
      760                           when "b-hist" then
      761                               do:
      762                                   hh:load-image("cmp/b-hist.bmp":u) .
      763                                   hh:TOOLTIP = "История" .
      764                                   v-h[ii] = hh:handle .
      765                                   ii = ii + 1 .
      766                                   hh:width-chars = 3 .
      767                               end.
      768                           when "b-sch" then
      769                               do:
      770                                   hh:load-image("cmp/b-sch.bmp":u) .
      771                                   hh:TOOLTIP = "Установка Фильтра" .
      772                                   v-h[ii] = hh:handle .
      773                                   ii = ii + 1 .
      774                                   hh:width-chars = 3 .
      775                               end.
      776                           when "b-hist-user" then
      777                               do:
      778                                   hh:load-image("cmp/b-hist.bmp":u) .
      779                                   hh:TOOLTIP = "История пользователя" .
      780                                   ii = ii + 1 .
      781                               end.
      782                       end case.
      783                   end.
      784                   hh = hh:next-sibling.
      785               end.
      786               b-help:column = v-frame-width - b-help:width-chars.
      787               jj = 0.
      788               repeat ii = 4 to 1 by -1 :
      789                   if valid-handle (v-h[ii] ) then
      790                   do:
      791                       jj  = jj + 1 .
      792                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      793                       v-h[ii]:row    = v-help-old-y .
      794                   end.
      795               end.
      796           end.
      797       end.
      798   end procedure.
      799   MAIN-BLOCK:
      800   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      801      ON ENDKEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      802     RUN enable_UI.
      803     RUN MyEnable.
      804     WAIT-FOR GO OF FRAME Dialog-Frame.
      805   END.
      806   RUN disable_UI.
      807   PROCEDURE disable_UI :
      808     HIDE FRAME Dialog-Frame.
      809   END PROCEDURE.
      810   PROCEDURE enable_UI PRIVATE :
      811     DISPLAY Fartic Fprod-code Fprod-type
      812         WITH FRAME Dialog-Frame.
      813     ENABLE Fartic B-gds B-list Fprod-code Fprod-type b-sel b-quit b-help
      814         WITH FRAME Dialog-Frame.
      815     VIEW FRAME Dialog-Frame.
      816   END PROCEDURE.
      817   PROCEDURE MyEnable :
      818     FOR FIRST tt-gds, FIRST ub.goods NO-LOCK WHERE ub.goods.gds-code = tt-gds.gds-CODE:
      819         DISP
      820             ub.goods.artic @ fArtic
      821             ub.goods.prod-code @ fprod-code
      822             ub.goods.prod-type @ fprod-type
      823         WITH FRAME Dialog-Frame.
      824     END.
      825   END PROCEDURE.
