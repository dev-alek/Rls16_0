     1100       define buffer buf_trn-doc  for ub.trn-doc  .
     1101       define buffer buf_doc-line for ub.doc-line .
     1102       find first buf_doc-line no-lock
     1103         where buf_doc-line.doc-code  = v-doc-code
     1104           and buf_doc-line.artic     = v-artic
     1105           and buf_doc-line.prod-type = v-prod-type
     1106           and buf_doc-line.prod-code = v-prod-code
     1107         no-error .
     1108       if not available buf_doc-line then do:
     1109         message
     1110           vss-workfile vss-revision vss-description skip
     1111           vss-include-info25 skip
     1112           "Ошибка задания входных параметров" skip
     1113           "Не найдена строка документа"  skip
     1114           "Документ" v-doc-code skip
     1115           "Артикул" v-artic v-prod-type v-prod-code skip
     1116           view-as alert-box error .
     1117         return error .
     1118       end.
     1119       find first buf_trn-doc no-lock
     1120         where buf_trn-doc.doc-code = v-doc-code
     1121         no-error .
     1122       if not available buf_trn-doc then do:
     1123         message
     1124           vss-workfile vss-revision vss-description skip
     1125           vss-include-info25 skip
     1126           "Ошибка задания входных параметров" skip
     1127           "Не найден документ" skip
     1128           "Документ" v-doc-code skip
     1129           "Артикул" v-artic v-prod-type v-prod-code skip
     1130           view-as alert-box error .
     1131         undo, return error .
     1132       end.
     1133       find first buf_goods no-lock
     1134         where buf_goods.artic     = buf_doc-line.artic
     1135           and buf_goods.prod-type = buf_doc-line.prod-type
     1136           and buf_goods.prod-code = buf_doc-line.prod-code
     1137         no-error .
     1138       if not available buf_goods then do:
     1139         message
     1140           vss-workfile vss-revision vss-description skip
     1141           vss-include-info25 skip
     1142           "Ошибка задания входных параметров" skip
     1143           "Не найден товар" skip
     1144           "Документ" v-doc-code skip
     1145           "Артикул" v-artic v-prod-type v-prod-code skip
     1146           view-as alert-box error .
     1147         undo, return error .
     1148       end.
     1149       if buf_goods.gds-type = 'т':U then do:
     1150             for each buf_parts no-lock
     1151               where buf_parts.out-code  = buf_trn-doc.doc-code
     1152                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1153                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1154                 and buf_parts.artic     = buf_doc-line.artic
     1155                 and buf_parts.prod-type = buf_doc-line.prod-type
     1156                 and buf_parts.prod-code = buf_doc-line.prod-code
     1157             on error undo, return error
     1158             :
     1159   assign
     1160     price-rubl-with-tax-loc = buf_parts.price-rubl
     1161     price-base-with-tax-loc = buf_parts.price-base
     1162   .
     1163   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1165     (output varinvprb
     1166     )  .
     1167     if buf_parts.out-code = 'free-zone':U     or
     1168        buf_parts.out-code = 'out-zone':U   or
     1169        buf_parts.doc-type = 'акт':U then do:
     1170       assign
     1171         in-vatp-have-vat-slt = yes.
     1172     end.
     1173     else do:
     1174       find first in-vatp_doc-attr no-lock
     1175         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1176           and in-vatp_doc-attr.attr-code = 'envd':U
     1177         no-error .
     1178       if not available in-vatp_doc-attr then do:
     1179         assign
     1180           in-vatp-have-vat-slt = yes.
     1181       end.
     1182       else do:
     1183            in-vatp-have-vat-slt = no.
     1184       end.
     1185     end.
     1186     assign
     1187      price-cli-with-tax-loc = buf_parts.price-cli
     1188      cli-base-rate          = buf_parts.cli-base-rate.
     1189     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1190              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1191     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1192             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1193             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1194             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1195             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1196             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1197             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1198       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1199     assign
     1200       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1201     assign
     1202       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1203       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1204       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1205       transport-cli-loc  = 0
     1206       other-cli-loc      = 0
     1207     .
     1208   ASSIGN
     1209             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1210       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1211   .
     1212               assign
     1213                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1214                                       or buf_trn-doc.doc-type = 'возврат':U
     1215                                       or buf_trn-doc.doc-type = 'инв':U
     1216                                       then buf_parts.fact-qnty
     1217                                       else - buf_parts.fact-qnty
     1218                                      )
     1219               .
     1220               assign
     1221                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1222                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1223                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1224                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1225                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1226                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1227                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1228                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1229                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1230                 v-excise-base         =   0
     1231                 v-excise-rubl         =   0
     1232                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1233                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1234                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1235                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1236               .
     1237           end.
     1238   assign
     1239     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1240     price-base-with-tax-loc = buf_doc-line.price-base
     1241   .
     1242   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1243   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1244     (output varinvprb
     1245     )  .
     1246      find first in-vatp_doc-attr no-lock
     1247       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1248         and in-vatp_doc-attr.attr-code = 'envd':U
     1249       no-error .
     1250       if available in-vatp_doc-attr
     1251          then do:
     1252          assign
     1253            in-vatp-have-vat-slt = no.
     1254      end.
     1255      else do:
     1256        assign
     1257          in-vatp-have-vat-slt = yes.
     1258      end.
     1259      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1260                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1261                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1262      if (not buf_trn-doc.internal and
     1263              buf_trn-doc.doc-type = 'при':U) or
     1264         in-vatp-goods.gds-type = 'у':U then do:
     1265         if varinvprb = "base":u then do:
     1266           assign
     1267             road-tax-base-loc = buf_doc-line.road-tax
     1268             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1269         end.
     1270         else do:
     1271           ASSIGN
     1272             road-tax-rubl-loc = buf_doc-line.road-tax
     1273             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1274         end.
     1275         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1276         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1277         assign
     1278           road-tax-cli-loc = ?.
     1279         ASSIGN
     1280           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1281           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1282           transport-cli-loc  = 0
     1283           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1284           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1285           other-cli-loc      = 0
     1286           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
