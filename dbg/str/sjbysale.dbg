     1042     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1043     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1044     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1045     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1046     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1047     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1048     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1049     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1050     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1051     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1052     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1053     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1054     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1055     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1056     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1057     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1058     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1059     do
     1060     on error undo, return error
     1061     :
     1062       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1063       define buffer   in-vatp-parts    for ub.parts   .
     1064       define buffer   in-vatp-doc      for ub.trn-doc .
     1065       define buffer   in-vatp-goods    for ub.goods   .
     1066       define buffer   in-vatp-sysconf  for ub.sysconf .
     1067       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1068       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1069       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1070       define variable varinvprb                  as   character              no-undo.
     1071       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1072       define variable cli-base-rate              as   decimal                no-undo.
     1073       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1074       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1075       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1076       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1077       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1078       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1079       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1080       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1081       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1082       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1083       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1084       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1085       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1086       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1087       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1088       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1089       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1090       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1091       define variable other-base-loc             like ub.doc-line.price-base no-undo.
