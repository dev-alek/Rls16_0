     1020   INDEX p1 IS PRIMARY   b-code ASCENDING
     1021                         obj-price ASCENDING
     1022                         discnt ASCENDING
     1023                         dop-rowid
     1024   INDEX p2              is-out DESCENDING
     1025                         b-code ASCENDING
     1026                         obj-price ASCENDING
     1027                         discnt DESCENDING
     1028   .
