     1034   define variable vss-include-info24 as character format "X(65)" no-undo
     1035   initial "@(#)$Workfile$ $Revision$".
     1036   def var vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   procedure r-cost :
     1038     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1039     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1040     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
