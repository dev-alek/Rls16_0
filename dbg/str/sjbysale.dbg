      869   procedure OpenForExcel :
      870      define variable v-ch#ExcelApplication as com-handle no-undo .
      871      define variable v-ch#Workbook         as com-handle no-undo .
      872      define variable v-ch#Worksheet        as com-handle no-undo .
      873      os-delete value( string( session:temp-directory ) +
      874                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      875      os-delete value( string( session:temp-directory ) +
      876                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      877      os-delete value( string( session:temp-directory ) +
      878                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      879      if Make-Excel
      880      then do:
      881         output stream ForExcel to value( string( session:temp-directory +
      882                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      883         assign
      884            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      885            number-list = 1
      886         .
      887         if make-excel-com
      888         then do:
      889   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if valid-handle(ch#WorkSheet) then
      891   RELEASE OBJECT ch#WorkSheet no-error.
      892   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   if valid-handle(ch#Workbook) then
      894   RELEASE OBJECT ch#Workbook no-error.
      895   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   if valid-handle(ch#ExcelApplication) then
      897   RELEASE OBJECT ch#ExcelApplication no-error.
      898            create "Excel.Application" ch#excelApplication connect no-error.
      899            if error-status:error
      900            then do :
      901           create "Excel.Application" ch#excelApplication no-error.
      902       if error-status :error then do:
      903           message
      904           "Ошибка при запуске Excel" skip
      905           error-status :get-message(1) skip
      906           view-as alert-box error .
      907           undo, return error .
      908       end.
      909            end.
      910            assign
      911               num#str#  = 0.
      912               v-ch#excelApplication  = ch#excelApplication.
      913               v-ch#excelApplication:Interactive = false.
      914               v-ch#excelApplication:ScreenUpdating = false.
      915               v-ch#excelApplication:Visible = false.
      916               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      917               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      918               v-ch#Worksheet = ch#WorkSheet.
      919               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      920               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      921               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      922               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      923            no-error .
      924            if error-status:error
      925            then do:
      926               Make-Excel-com = false .
      927               Make-Excel = false .
      928               output Stream  ForExcel close.
      929               os-delete value( string( session:temp-directory ) +
      930                              "rpt" + string( g#report-num ) + ".txt":U ) .
      931               os-delete value( string( session:temp-directory ) +
      932                              "rpt" + string( g#report-num ) + ".frm":U ) .
      933               return.
      934            end.
      935         end.
      936      end.
      937   end.
      938   procedure CloseForExcel :
      939      define variable ii as integer no-undo .
      940      define variable vsheet-num as integer no-undo.
      941      if Make-Excel
      942      then  do:
      943         output Stream  ForExcel close.
      944         os-delete value( string( session:temp-directory ) +
      945                                "rpt" + string( g#report-num ) + ".txt":U ) .
      946         os-delete value( string( session:temp-directory ) +
      947                                "rpt" + string( g#report-num ) + ".frm":U ) .
      948         define buffer buf_sheetf for sheetf.
      949         find last buf_sheetf no-error .
      950         if available buf_sheetf
      951         then
      952            vsheet-num = buf_sheetf.sheet-num.
      953         if vsheet-num > 1
      954         then do:
      955            do ii = 2 to vsheet-num:
      956               os-delete value( string( session:temp-directory ) +
      957                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      958            end.
      959         end.
      960   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   if valid-handle(ch#WorkSheet) then
      962   RELEASE OBJECT ch#WorkSheet no-error.
      963   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   if valid-handle(ch#Workbook) then
      965   RELEASE OBJECT ch#Workbook no-error.
      966   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   if valid-handle(ch#ExcelApplication) then
      968   RELEASE OBJECT ch#ExcelApplication no-error.
      969      end.
      970   end.
      971   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      972   function breakstr returns character ( input        for-name    as character,
      973                                         input        line-length as integer,
      974                                         input-output line1       as character,
      975                                         input-output line2       as character ) :
      976     define variable ii as integer no-undo.
      977     if length( for-name ) > line-length then do:
      978       assign ii    = 1
      979              line1 = "":u
      980              line2 = "":u.
      981       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      982         assign line1 =       substring( for-name, 1, line-length     )
      983                line2 = trim( substring( for-name,    line-length + 1 ) ).
      984       end.                                                     else do:
      985         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      986           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      987                  ii    = ii    + 1.
      988           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      989             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      990           end.
      991         end.
      992         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      993       end.
      994     end.                                else do:
      995       assign line1 = for-name
      996              line2 = "":u.
      997     end.
      998     return ( line1 ).
      999   end function.
     1000   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   define temp-table sj-goods no-undo
