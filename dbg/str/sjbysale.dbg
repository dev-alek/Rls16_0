     1438                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1439                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1440                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1441                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1442                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1443                         .
     1444         end.
     1445         ASSIGN
     1446           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1447           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1448           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1449           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1450           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1451           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1452                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1453           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1454                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1455           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1456           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1457           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1458         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1459         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1460         if transport-base-loc = ? then transport-base-loc = 0.
     1461         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1462         if other-base-loc     = ? then other-base-loc     = 0.
     1463         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1464         assign
     1465           transport-cli-loc      = 0
     1466           other-cli-loc          = 0
     1467           road-tax-cli-loc       = ?
     1468           vat-cli-loc            = ?
     1469           slt-cli-loc            = ?
     1470           price-cli-with-tax-loc = ?.
     1471      end.
     1472   ASSIGN
     1473             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1474       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1475   .
     1476             assign
     1477               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1478               v-vat-pc              = vat-pc-loc
     1479               v-slt-pc              = slt-pc-loc
     1480               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1481               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1482               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1483               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1484               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1485               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1486               v-road-tax-base       =  0
     1487               v-road-tax-rubl       =  0
     1488               v-excise-base         =  0
     1489               v-excise-rubl         =  0
     1490               v-transport-base      =  0
     1491               v-transport-rubl      =  0
     1492               v-other-base          =  0
     1493               v-other-rubl          =  0
     1494             .
     1495       end.
     1496     end.
     1497   end procedure.
     1498   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   procedure cur-time :
     1500      define output parameter p-today as date      no-undo .
     1501      define output parameter p-time  as integer   no-undo .
     1502     do
     1503     on error undo, return error
     1504     :
     1505       define variable v-date1 as date      no-undo .
     1506       define variable v-date2 as date      no-undo .
     1507       define variable v-time  as integer   no-undo .
     1508       assign
     1509         v-date1 = today
     1510         v-time  = time
     1511         v-date2 = today
     1512       .
     1513       if v-date1 <> v-date2
     1514       then do:
     1515         assign
     1516           v-date1 = today
     1517           v-time  = v-time
     1518         .
     1519       end.
     1520       assign
     1521         p-today = v-date1
     1522         p-time  = v-time
     1523       .
     1524     end.
     1525   end.
     1526   function cur-time-date returns character
     1527   :
     1528     return string(today, '99/99/9999':U) .
     1529   end.
     1530   function cur-time-mjd returns decimal
     1531   :
     1532     define variable v-date as date      no-undo .
     1533     define variable v-time as integer   no-undo .
     1534     run cur-time in this-procedure
     1535       (output v-date
     1536       ,output v-time
     1537       ) .
     1538     return integer(v-date) - 2400002 + (v-time / 86400) .
     1539   end.
     1540   function cur-time-get-ending-index returns integer
     1541   (input p-number as integer
     1542   )
     1543   :
     1544     if p-number < 0
     1545     or p-number = ?
     1546     then do:
     1547       return 1 .
     1548     end.
     1549     define variable v-rest as integer   no-undo .
     1550     assign
     1551       p-number = p-number modulo 100
     1552     .
     1553     if p-number < 20
     1554     then do:
     1555       assign
     1556         v-rest = p-number
     1557       .
     1558     end.
     1559     else do:
     1560       assign
     1561         v-rest = p-number modulo 10
     1562       .
     1563     end.
     1564     case v-rest :
     1565       when 1
     1566       then do:
     1567         return 2 .
     1568       end.
     1569       when 2 or
     1570       when 3 or
     1571       when 4
     1572       then do:
     1573         return 3 .
     1574       end.
     1575       otherwise do:
     1576         return 1 .
     1577       end.
     1578     end case .
     1579   end.
     1580   procedure cur-time-mjd-to-date :
     1581      define input  parameter i-mjd-diff as decimal no-undo.
     1582      define output parameter o-Date     as date    no-undo.
     1583      define output parameter o-Time     as integer no-undo.
     1584      define variable v-day-number as integer   no-undo .
     1585      if    i-mjd-diff < 0
     1586         or i-mjd-diff = ?
     1587      then do:
     1588         return "?" .
     1589      end.
     1590      assign
     1591         v-day-number = truncate(i-mjd-diff,0).
     1592         o-Date = date(v-day-number + 2400002).
     1593         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1594     .
     1595   end.
     1596   function cur-time-mjd-to-string returns character
     1597   (input p-mjd-diff as decimal
     1598   )
     1599   :
     1600     define variable v-day-number as integer   no-undo .
     1601     define variable v-seconds    as integer   no-undo .
     1602     define variable v-hour       as integer   no-undo .
     1603     define variable v-min        as integer   no-undo .
     1604     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1605     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1606     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1607     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1608     if p-mjd-diff < 0
     1609     or p-mjd-diff = ?
     1610     then do:
     1611       return "?" .
     1612     end.
     1613     assign
     1614       v-day-number = integer(truncate(p-mjd-diff,0))
     1615       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1616     .
     1617     if v-seconds > 86400
     1618     then do:
     1619       assign
     1620         v-seconds = 86400 - 1
     1621       .
     1622     end.
     1623     if v-seconds < 0
     1624     then do:
     1625       assign
     1626         v-seconds = 0
     1627       .
     1628     end.
     1629     assign
     1630       v-hour = truncate(v-seconds / 3600, 0)
     1631     .
     1632     assign
     1633       v-seconds = v-seconds modulo 3600
     1634     .
     1635     assign
     1636       v-min = truncate(v-seconds / 60, 0)
     1637     .
     1638     assign
     1639       v-seconds = v-seconds modulo 60
     1640     .
     1641     return
     1642         (if v-day-number <> 0
     1643           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1644           else ""
     1645         )
     1646       + (if v-day-number <> 0 or v-hour <> 0
     1647           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1648           else ""
     1649         )
     1650       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1651           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1652           else ""
     1653         )
     1654       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1655       .
     1656   end.
     1657   function cur-time-string returns character
     1658   :
     1659     define variable v-date as date      no-undo .
     1660     define variable v-time as integer   no-undo .
     1661     run cur-time in this-procedure
     1662       (output v-date
     1663       ,output v-time
     1664       ) .
     1665     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1666   end.
     1667   function cur-time-string-sec returns character
     1668   :
     1669     define variable v-date as date      no-undo .
     1670     define variable v-time as integer   no-undo .
     1671     run cur-time in this-procedure
     1672       (output v-date
     1673       ,output v-time
     1674       ) .
     1675     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1676   end.
     1677   function cur-time-custom  returns character
     1678   (input p-prefix as character
     1679   ,input p-date-format as character
     1680   ,input p-delimiter as character
     1681   ,input p-time-format as character
     1682   ,input p-suffix as character
     1683   )
     1684   :
     1685     define variable v-date as date      no-undo .
     1686     define variable v-time as integer   no-undo .
     1687     run cur-time in this-procedure
     1688       (output v-date
     1689       ,output v-time
     1690       ) .
     1691     return
     1692       p-prefix
     1693       + string(v-date, p-date-format)
     1694       + p-delimiter
     1695       + string(v-time, p-time-format)
     1696       + p-suffix
     1697       .
     1698   end.
     1699   function cur-time-print  returns character
     1700   :
     1701     define variable v-date as date      no-undo .
     1702     define variable v-time as integer   no-undo .
     1703     run cur-time in this-procedure
     1704       (output v-date
     1705       ,output v-time
     1706       ) .
     1707     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1708   end.
     1709   function cur-time-datetime returns datetime
     1710   :
     1711     define variable v-char as character no-undo .
     1712     define variable v-datetime as datetime no-undo .
     1713     v-char = cur-time-string().
     1714     v-datetime = datetime(v-char).
     1715     return  v-datetime.
     1716   end.
     1717   function cur-time-string-msec returns character
     1718   :
     1719     define variable v-date as datetime  no-undo .
     1720     v-date = now.
     1721     return string(v-date) .
     1722   end.
     1723   define variable l-col-type         as character no-undo .
     1724   define variable l-col-pos          as integer no-undo .
     1725   define variable l-col-len          as integer no-undo .
     1726   define variable l-col-format       as character no-undo .
     1727   define variable l-col-lable        as character no-undo .
     1728   define variable v-dec-sep          as character no-undo init ? .
     1729   define variable v-th-sep           as character no-undo init ? .
     1730   define variable v-r-col-num        as integer no-undo .
     1731   define variable v-reg-replace      as logical no-undo .
     1732   define variable v-date-col-format  as character no-undo .
     1733   DEFINE VARIABLE last-col-num as integer no-undo.
     1734   run gbl/getlocal.p (
     1735                     output v-dec-sep
     1736                    ,output v-th-sep
     1737                    ,output v-sdate
     1738                    ,output v-shortdate
     1739                    ) no-error .
     1740   assign
     1741   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1742                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1743   .
     1744     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1745                                               INPUT p-dec-sep AS CHARACTER  ) :
     1746       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1747       IF TRIM( p-string ) = "0"                    OR
     1748          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1749          TRIM( p-string ) =       p-dec-sep + "00" OR
     1750          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1751          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1752                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1753       RETURN ( TRIM( v-string ) ).
     1754     END FUNCTION.
     1755   FUNCTION reg-output returns character( input p-string as character
     1756                                         ,input p-private-data as character
     1757                                         ,input p-replace as logical
     1758                                         ,input p-supress as logical
     1759                                         ,input p-dec-sep as character
     1760                                         ,input p-th-sep as character
     1761                                         ):
     1762   DEFINE VARIABLE v-reg-output as character no-undo .
     1763   DEFINE VARIABLE v-data-type as character no-undo .
     1764   DEFINE VARIABLE v-progress-format as character no-undo .
     1765   assign
     1766   v-progress-format = entry(1, p-private-data, chr(4))
     1767   v-data-type = entry(2, p-private-data, chr(4))
     1768   .
     1769   if p-string = ? then return chr(63).
     1770   if (v-data-type = "INTEGER"
     1771       OR v-data-type = "DECIMAL" ) THEN DO:
     1772     IF p-replace THEN DO:
     1773       assign
     1774         v-reg-output = replace( p-string
     1775                                         ,chr(44)
     1776                                         ,"":U
     1777                                       )
     1778         v-reg-output = trim(v-reg-output)
     1779       .
     1780     END.
     1781     else do:
     1782       v-reg-output = p-string.
     1783     end.
     1784     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1785     return v-reg-output.
     1786   end.
     1787     return p-string.
     1788   END FUNCTION.
     1789   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790   define variable v-waitfram-action01         as character   no-undo .
     1791   define variable v-waitfram-action02         as character   no-undo .
     1792   define variable v-waitfram-action03         as character   no-undo .
     1793   define variable mWaitFramTextBeg            as character   no-undo.
     1794   define variable mWaitFramTextEnd            as character   no-undo.
     1795   define variable mWaitFramView               as logical     no-undo.
     1796   define variable mWaitProcEvent              as logical     no-undo init yes.
     1797   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1798   define variable mWaitFramStop               as logical     no-undo.
     1799   define variable mWaitFramStopUser           as logical     no-undo.
     1800   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1801   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1802   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1803   define button B-WaitFramStop auto-end-key
     1804        label "Стоп"
     1805        size 10 by 1 tooltip "Остоновить процесс".
     1806   define button B-viewProcInfo
     1807        label "Информация"
     1808        size 15 by 1 tooltip "Информация о процесс".
     1809   define frame waitfram
     1810     v-waitfram-action01 format "x(72)" no-label skip
     1811     v-waitfram-action02 format "x(72)" no-label skip
     1812     v-waitfram-action03 format "x(72)" no-label skip
     1813     B-viewProcInfo
     1814     B-WaitFramStop at row 4 col 30
     1815     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1816     .
     1817   define new global shared variable mBatchMode as logical no-undo init ?.
     1818   define variable mFramBachModHandle as handle no-undo.
     1819   mFramBachModHandle = frame waitfram:handle.
     1820   define variable mFameOldVis as logical no-undo.
     1821   define variable mVisCUrentVin as logical no-undo.
     1822   if session:batch-mode
     1823   then
     1824      mBatchMode = yes.
     1825   if mBatchMode = ? then do:
     1826     mVisCUrentVin = current-window:visible.
     1827     mFameOldVis = mFramBachModHandle:visible.
     1828     mFramBachModHandle:visible  = yes.
     1829     mBatchMode = mFramBachModHandle:visible ne yes.
     1830     mFramBachModHandle:visible = mFameOldVis.
     1831     current-window:visible = mVisCUrentVin.
     1832   end.
     1833    if  log-manager:logfile-name ne ?
     1834     then DO:
     1835         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1836         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1837         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1838     end.
     1839   on choose of B-WaitFramStop in frame waitfram
     1840   do:
     1841     mWaitFramStop = yes.
     1842     mWaitFramStopUser = yes.
     1843   end.
     1844   function waitfram-check-timeout returns logical():
     1845      define variable vtime as int64 no-undo.
     1846      if mWaitFramStopTimeOut
     1847      then
     1848         return yes.
     1849      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1850      if     mWaitFramTimeOut ne ?
     1851         and mWaitFramTimeOut ne 0
     1852         and mWaitFramTimeOut lt vtime
     1853      then do:
     1854         mWaitFramStopTimeOut = yes.
     1855      end.
     1856      return mWaitFramStopTimeOut.
     1857   end.
     1858   procedure waitfram-hide :
     1859     if not session:batch-mode
     1860     then do
     1861     on error undo, return error return-value
     1862     :
     1863       pause 0 before-hide .
     1864       if not mBatchMode then
     1865         hide frame waitfram .
     1866     if     not mWaitFramView
     1867        and mWaitProcEvent
     1868     then
     1869       process events .
     1870     end.
     1871   end procedure.
     1872   procedure waitfram-show :
     1873     define input  parameter p-message as character no-undo .
     1874     define variable v-left-margin as integer   no-undo .
     1875     if not session:batch-mode
     1876     then do
     1877     on error undo, return error return-value
     1878     :
     1879       if length(p-message) <= 70 then do:
     1880         assign
     1881           v-left-margin = integer((70 - length(p-message)) / 2)
     1882         .
     1883         assign
     1884           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1885         .
     1886         assign
     1887           v-waitfram-action01 = " "
     1888           v-waitfram-action02 = " "
     1889                                    + fill(" ", v-left-margin)
     1890                                    + p-message
     1891           v-waitfram-action03 = " "
     1892         .
     1893       end.
     1894       else do:
     1895         define variable vRindex1 as integer no-undo.
     1896         define variable vRindex2 as integer no-undo.
     1897         vRindex1 = r-index(p-message," ",70).
     1898         if vRindex1 = 0
     1899         then
     1900            vRindex1 = 70.
     1901         if length(p-message)  <= vRindex1 + 70 then do:
     1902           assign
     1903             v-waitfram-action01 = " "
     1904             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1905             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1906           .
     1907         end.
     1908         else do:
     1909           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1910           if vRindex2 <= vRindex1
     1911           then
     1912              vRindex2 = vRindex1 + 70.
     1913           assign
     1914             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1915             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1916             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1917           .
     1918         end.
     1919       end.
     1920       B-viewProcInfo:visible   in frame waitfram = no.
     1921       B-viewProcInfo:sensitive in frame waitfram = no.
     1922       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1923       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1924       if  (   mWaitFramView
     1925          or  mWaitProcEvent)
     1926          and not mBatchMode
     1927       then
     1928          display
     1929             v-waitfram-action01 skip
     1930             v-waitfram-action02 skip
     1931             v-waitfram-action03 skip
     1932          with frame waitfram .
     1933       if     mWaitFramView
     1934          then do:
     1935             if     mWaitFramInterval ne ?
     1936                and not mBatchMode
     1937             then
     1938                wait-for go of frame waitfram pause mWaitFramInterval.
     1939          end.
     1940          else
     1941             if     mWaitProcEvent
     1942                and not mBatchMode
     1943             then
     1944                process events .
     1945     end.
     1946   end procedure.
     1947      procedure waitfram-show-this:
     1948         define input  parameter iInterval as int64 no-undo.
     1949         define variable vtime as int64 no-undo.
     1950         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1951         mWaitFramInterval = iInterval.
     1952         run waitfram-show (substitute("&1&2 &3&4" ,
     1953                                       mWaitFramTextBeg ,
     1954                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1955                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1956                                       mWaitFramTextEnd
     1957                                      )
     1958                           ).
     1959      end.
     1960      procedure WaitFramRunPause:
     1961         define input  parameter iInterval as dec no-undo.
     1962         define variable vStart  as datetime-tz no-undo.
     1963         define variable vend    as datetime-tz no-undo.
     1964         define variable vint as int64 no-undo.
     1965         define variable vOk as logical no-undo.
     1966         vStart = now.
     1967         vend   = vStart.
     1968         publish "WaitFramPause" (iInterval,output vOk).
     1969         vend   =  now.
     1970         vint = vend - vStart.
     1971         vint = iInterval - vint / 1000.
     1972         if     not mWaitFramStop
     1973            and (   vint > 0
     1974                 or (    not vOk
     1975                     and iInterval eq ?
     1976                     )
     1977                 )
     1978         then
     1979            run waitfram-show-this (iInterval).
     1980         vend   =  now.
     1981         vint = vend - vStart.
     1982         vint = iInterval - vint / 1000.
     1983         if     not mWaitFramStop
     1984            and vint > 0
     1985         then do:
     1986            run gbl/pause.p (vint * 1000).
     1987         end.
     1988         if iInterval ne ?
     1989         then
     1990            publish "WaitFramStop".
     1991         waitfram-check-timeout().
     1992      end.
     1993      procedure WaitFramWaitFor:
     1994         define input  parameter iInterval as dec no-undo.
     1995         assign
     1996            mWaitFramStartProc   = now
     1997            mWaitFramStopUser    = no
     1998            mWaitFramStopTimeOut = no
     1999         .
     2000         block-wait:
     2001         do while not mWaitFramStop:
     2002            run WaitFramRunPause (iInterval).
     2003            if  waitfram-check-timeout()
     2004            then do:
     2005               leave block-wait.
     2006            end.
     2007         end.
     2008         run waitfram-hide.
     2009      end.
     2010   procedure waitfram-join :
     2011     define input  parameter p-line-1  as character no-undo .
     2012     define input  parameter p-line-2  as character no-undo .
     2013     define input  parameter p-line-3  as character no-undo .
     2014     define output parameter p-message as character no-undo .
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       assign
     2019         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2020                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2021                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2022       .
     2023     end.
     2024   end procedure.
     2025   function waitfram-join-function returns character
     2026     (input p-line-1 as character
     2027     ,input p-line-2 as character
     2028     ,input p-line-3 as character
     2029     ).
     2030     define variable v-message as character no-undo .
     2031     run waitfram-join in this-procedure
     2032       (input  p-line-1
     2033       ,input  p-line-2
     2034       ,input  p-line-3
     2035       ,output v-message
     2036       ) .
     2037     return v-message .
     2038   end function .
