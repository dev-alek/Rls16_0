     3466     run prn-lib-open-stream  in this-procedure (
     3467                                                  input parParentProc
     3468                                                 ,input 43
     3469                                                 ,input yes
     3470                                                 ,input no
     3471                                                 ).
     3472     if Make-Excel then
     3473     RUN OpenForExcel in this-procedure .
     3474     run waitfram-show in this-procedure ( input "Ждите...").
     3475     run rep/extitle.p ( input 1).
     3476     FORM with FRAME Doc .
     3477     FORM HEADER
     3478     Line format "X(60)" AT 1 SKIP
     3479     string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     3480     with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3481     VIEW stream PrnLibStream FRAME NBottomFrame .
     3482     PUT stream PrnLibStream UNFORMATTED
     3483     Reportname
     3484     SKIP(1).
     3485     IF v-curr-r-b = 'rubl':U  AND
     3486      base-code = 0 then do:
     3487     end.
     3488     else do:
     3489       PUT stream PrnLibStream UNFORMATTED
     3490       "Курсы валют на дату/время последнего чека" chr(32)
     3491       "(":U
     3492       string(last-date, "99/99/9999") chr(32)
     3493       string(last-time, "HH:MM")
     3494       "):":U
     3495       skip
     3496       .
     3497       if Make-Excel then  put   stream ForExcel unformatted
     3498       "Курсы валют на дату/время последнего чека" chr(32)
     3499       "(":U
     3500       string(last-date, "99/99/9999") chr(32)
     3501       string(last-time, "HH:MM")
     3502       "):":U CHR(9)
     3503       skip
     3504       .
     3505       FOR EACH buf_currency No-LOCK where
     3506               buf_currency.curr-code > 0 :
     3507         FIND LAST buf_curr-shop WHERE
     3508                   buf_curr-shop.obj-type = buf_inkas.obj-type
     3509               AND buf_curr-shop.obj-code = buf_inkas.obj-code
     3510               AND buf_curr-shop.curr-code = buf_currency.curr-code
     3511               AND ( ( buf_curr-shop.exch-date = last-date
     3512                       AND
     3513                       buf_curr-shop.exch-time <= last-time )
     3514                       OR  buf_curr-shop.exch-date < last-date ) NO-ERROR .
     3515         if available buf_curr-shop then do:
     3516           PUT stream PrnLibStream unformatted
     3517           buf_currency.curr-abbr chr(32) "-":U chr(32)
     3518           buf_curr-shop.exch-rate chr(32)
     3519           "за" chr(32) buf_curr-shop.exch-scale
     3520           skip.
     3521           if Make-Excel then  put   stream ForExcel unformatted
     3522           buf_currency.curr-abbr CHR(9)
     3523           CHR(9)
     3524           string(buf_curr-shop.exch-rate) CHR(9)
     3525           "за" chr(32) buf_curr-shop.exch-scale
     3526           skip.
     3527         end.
     3528       END.
     3529       if Make-Excel then  put   stream ForExcel unformatted
     3530       skip(2).
     3531     end.
     3532     display STREAM PrnLibStream with frame top-Frame .
     3533     FOR EACH sj-goods
     3534     use-index p2
     3535     BREAK
     3536     BY sj-goods.is-out DESCENDING :
     3537       assign
     3538       namebuf1 = breakstr(sj-goods.name, 18, input-output namebuf1, input-output  namebuf2)
     3539       prodbuf1 = trim( breakstr(sj-goods.prod-name, 15, input-output prodbuf1, input-output prodbuf2), '"' )
     3540       .
     3541     if use-column[1]
     3542     then  C-for-b-code:screen-value = string(sj-goods.b-code, entry(1, c-for-b-code:private-data, chr(4))).
     3543     if use-column[2]
     3544     then  C-for-artic:screen-value = string(sj-goods.artic, entry(1, c-for-artic:private-data, chr(4))).
     3545     if use-column[3]
     3546     then  C-for-name:screen-value = string(namebuf1, entry(1, c-for-name:private-data, chr(4))).
     3547     if use-column[4]
     3548     then  C-for-prod-name:screen-value = string(prodbuf1, entry(1, c-for-prod-name:private-data, chr(4))).
     3549     if use-column[5]
     3550     then  C-for-qnty:screen-value = string(sj-goods.qnty, entry(1, c-for-qnty:private-data, chr(4))).
     3551     if use-column[6]
     3552     then  C-for-qnty-2:screen-value = string(sj-goods.qnty-2, entry(1, c-for-qnty-2:private-data, chr(4))).
     3553     if use-column[7]
     3554     then  C-for-obj-price:screen-value = string(sj-goods.obj-price, entry(1, c-for-obj-price:private-data, chr(4))).
     3555     if use-column[8]
     3556     then  C-for-brutto-sum:screen-value = string(sj-goods.brutto-sum, entry(1, c-for-brutto-sum:private-data, chr(4))).
     3557       if sj-goods.discnt-sum <> 0 then do:
     3558     if use-column[9]
     3559     then  C-for-discnt-sum:screen-value = string(sj-goods.discnt-sum, entry(1, c-for-discnt-sum:private-data, chr(4))).
     3560       end.
     3561       if sj-goods.discnt-sum <> 0 then do:
     3562     if use-column[10]
     3563     then  C-for-pcnt:screen-value = string(sj-goods.pcnt, entry(1, c-for-pcnt:private-data, chr(4))).
     3564       end.
     3565     if use-column[11]
     3566     then  C-for-netto-sum:screen-value = string(sj-goods.netto-sum, entry(1, c-for-netto-sum:private-data, chr(4))).
     3567     if use-column[12]
     3568     then  C-for-SLT-pc:screen-value = string(sj-goods.SLT-pc, entry(1, c-for-SLT-pc:private-data, chr(4))).
     3569     if use-column[13]
     3570     then  C-for-uchet-sum:screen-value = string(sj-goods.uchet-sum, entry(1, c-for-uchet-sum:private-data, chr(4))).
     3571       DISPLAY stream  PrnLibStream with frame Doc.                                      DOWN 1 stream PrnLibStream with frame Doc.
     3572       if Make-Excel then  put   stream ForExcel unformatted
     3573     if use-column[1]
     3574     then (reg-output(
     3575                       string(sj-goods.b-code, entry(1, c-for-b-code:private-data, chr(4)))
     3576                      ,c-for-b-code:private-data
     3577                      ,v-reg-replace
     3578                      ,no
