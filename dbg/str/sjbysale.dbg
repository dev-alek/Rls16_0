      150   procedure create_obj-list :
      151      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      152      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      153      do
      154      on error undo, return error return-value
      155      :
      156         define buffer cli-obj for ub.clients .
      157         define variable p-var as integer no-undo .
      158         define buffer buf_obj-list for obj-list .
      159         find last buf_obj-list  use-index pi no-error .
      160         if available buf_obj-list
      161         then
      162            p-var = buf_obj-list.obj-id + 1.
      163         else
      164            p-var = 1.
      165         find first cli-obj where
      166                   cli-obj.obj-type = p-obj-type
      167               and cli-obj.obj-code = p-obj-code
      168         no-lock no-error.
      169         if available cli-obj
      170         then do:
      171            create buf_obj-list.
      172            assign
      173               buf_obj-list.obj-id   = p-var
      174               buf_obj-list.obj-code = cli-obj.obj-code
      175               buf_obj-list.obj-type = cli-obj.obj-type
      176               buf_obj-list.obj-name = cli-obj.obj-name
      177               buf_obj-list.db-num   = cli-obj.db-num
      178            .
      179         end.
      180      end.
      181   end.
