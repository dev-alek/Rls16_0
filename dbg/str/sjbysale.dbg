     2207               ub.chk-doc.out-code = buf_inkas.inkas-code,
     2208         EACH ub.chk-gds WHERE
     2209               ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOCK,
     2210         FIRST ub.bar-code WHERE
     2211               ub.bar-code.b-code = ub.chk-gds.b-code NO-LOCK,
     2212         FIRST ub.goods WHERE
     2213               ub.goods.gds-code = ub.bar-code.gds-code
     2214       by ub.chk-doc.obj-type
     2215       by ub.chk-doc.obj-code
     2216           by ub.chk-gds.b-code
     2217       by ub.chk-doc.chk-date
     2218       by ub.chk-doc.chk-time:
     2219         v-doc-code = '':U.
     2220         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2221         if num-entries(ub.chk-gds.line-type, chr(4)) > 1 then do:
     2222           find first buf_sale-doc no-lock where
     2223                     buf_sale-doc.inkas-code = buf_inkas.inkas-code
     2224                 and buf_sale-doc.doc-kind = entry(1, entry(2, ub.chk-gds.line-type, chr(4))) no-error .
     2225           if available buf_sale-doc then do:
     2226             assign
     2227             v-doc-code = buf_sale-doc.doc-code.
     2228           end.
     2229         end.
     2230         if v-doc-code = '':U then do:
     2231           if chk-doc.netto >= 0 then
     2232           v-doc-code = tdoc-code.
     2233           else
     2234           v-doc-code = ret-doc-code.
     2235         end.
     2236         assign
     2237         last-date = ub.chk-doc.chk-date
     2238         last-time = ub.chk-doc.chk-time
     2239         .
     2240         FIND FIRST ub.gds-dtl WHERE
     2241                   ub.gds-dtl.doc-code = v-doc-code AND
     2242                   ub.gds-dtl.artic = ub.goods.artic AND
     2243                   ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2244                   ub.gds-dtl.prod-code = ub.goods.prod-code AND
     2245                   ub.gds-dtl.prt-code = ub.bar-code.node-code NO-LOCK NO-ERROR .
     2246         if NOT available ub.gds-dtl then
     2247         assign
     2248         s-price = ub.chk-gds.price-base .
     2249         FIND  FIRST ub.doc-line WHERE
     2250                     ub.doc-line.doc-code = ub.gds-dtl.doc-code AND
     2251                     ub.doc-line.prod-type = ub.gds-dtl.prod-type AND
     2252                     ub.doc-line.prod-code = ub.gds-dtl.prod-code  AND
     2253                     ub.doc-line.artic = ub.gds-dtl.artic NO-LOCK NO-ERROR.
     2254         IF avail ub.gds-dtl then
     2255         assign
     2256         s-price = (if v-curr-r-b = 'base':U
     2257                    then ub.gds-dtl.price-base
     2258                    else ub.gds-dtl.price-rubl).
     2259         assign
     2260         cur-discnt = ub.chk-gds.discnt + ( s-price - chk-gds.price-base )
     2261         wo-sum = (if ub.chk-gds.write-off-code > 0 then 1 else - 1) *
     2262                  ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt)
     2263         .
     2264         .
     2265         if ptwounit then do:
     2266           FIND FIRSt ub.units No-LOCK WHERE
     2267                     ub.units.unit-name = ub.goods.unit-base No-ERROR.
     2268           if avail ub.units and (LOOKUP('2ед':U, ub.units.type) > 0 OR
     2269                               LOOKUP('доп':U, ub.units.type) > 0) then twounit-good = yes.
     2270           else twounit-good = no.
     2271         end.
     2272         FIND FIRST sj-goods WHERE
     2273                   sj-goods.b-code = ub.bar-code.b-code AND
     2274                   sj-goods.obj-price = s-price AND
     2275                   sj-goods.discnt = cur-discnt AND
     2276                   sj-goods.is-out = (lookup(string(ub.chk-doc.chk-type), '1,69,14,15,16,36':U) > 0
     2277                                     or
     2278                                     ((ub.chk-doc.chk-type = ? or chk-doc.chk-type = 0)
     2279                                       and ub.chk-doc.netto >= 0)
     2280                                     )
     2281                                       NO-ERROR .
     2282         if NOT available sj-goods or twounit-good then do:
     2283           FIND FIRST ub.clients WHERE
     2284                     ub.clients.obj-type = ub.goods.prod-type AND
     2285                     ub.clients.obj-code = ub.goods.prod-code NO-LOCK .
     2286   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2288     (input  ub.goods.gds-code
     2289     ,input  '1':U
     2290     ,input  ub.chk-doc.shift-date
     2291     ,input  buf_inkas.host-code
     2292     ,input  buf_inkas.obj-type
     2293     ,input  buf_inkas.obj-code
     2294     ,output vat-value
     2295     ) no-error .
     2296   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2298     (input  ub.goods.gds-code
     2299     ,input  '2':U
     2300     ,input  ub.chk-doc.shift-date
     2301     ,input  buf_inkas.host-code
     2302     ,input  buf_inkas.obj-type
     2303     ,input  buf_inkas.obj-code
     2304     ,output slt-value
     2305     ) no-error .
     2306           CREATE sj-goods.
     2307           assign
     2308           sj-goods.b-code = ub.bar-code.b-code
     2309           sj-goods.artic = ub.goods.artic
     2310           sj-goods.name = ub.goods.gds-name
     2311           sj-goods.prod-name = trim( ub.clients.obj-name, '"' )
     2312           sj-goods.obj-price = s-price
     2313           sj-goods.discnt = cur-discnt
     2314           sj-goods.VAT-pc = IF available(ub.doc-line) then ub.doc-line.VAT-pc else vat-value
     2315           sj-goods.SLT-pc = IF available(ub.doc-line) then ub.doc-line.SLT-pc else SLT-value
     2316           sj-goods.dop-rowid = IF twounit-good then rowid(ub.chk-gds) else sj-goods.dop-rowid
     2317           .
     2318           if available doc-line then do:
     2319             run r-cost in this-procedure (
     2320                                          input ub.doc-line.doc-code
     2321                                         ,input ub.goods.artic
     2322                                         ,input ub.goods.prod-type
     2323                                         ,input ub.goods.prod-code
     2324                                         ,output v-fact-qnty
     2325                                         ,output v-vat-pc
     2326                                         ,output v-slt-pc
     2327                                         ,output v-sum-base
     2328                                         ,output v-sum-rubl
     2329                                         ,output v-vat-base
     2330                                         ,output v-vat-rubl
     2331                                         ,output v-slt-base
     2332                                         ,output v-slt-rubl
     2333                                         ,output v-road-tax-base
     2334                                         ,output v-road-tax-rubl
     2335                                         ,output v-transport-base
     2336                                         ,output v-transport-rubl
     2337                                         ,output v-other-base
     2338                                         ,output v-other-rubl
     2339                                         ,output v-excise-base
     2340                                         ,output v-excise-rubl
     2341                                         ).
     2342             assign
     2343             v-uchet-price = (if v-curr-r-b = 'base':U
     2344                              then v-sum-base
     2345                              else v-sum-rubl)
     2346                              / v-fact-qnty
     2347             .
     2348           end.
     2349           else do:
     2350             assign
     2351             v-uchet-price = 0
     2352             .
     2353           end.
     2354         end.
     2355         assign
     2356         sj-goods.qnty = sj-goods.qnty + ub.chk-gds.doc-qnty
     2357         sj-goods.uchet-sum = sj-goods.uchet-sum + ub.chk-gds.doc-qnty * v-uchet-price
     2358         sj-goods.qnty-2 = IF twounit-good
     2359                           then (IF lookup('2ед':U, units.type) > 0
     2360                                 then (if ub.chk-gds.doc-qnty >= 0 then 1 else - 1 )
     2361                                 else goods.wt-cart * (if ub.chk-gds.doc-qnty >= 0 then 1 else - 1 )
     2362                               )
     2363                           else 0
     2364         sj-goods.brutto-sum = sj-goods.brutto-sum + ( ub.chk-gds.doc-qnty * s-price )
     2365         sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * ub.chk-gds.doc-qnty )
     2366         sj-goods.netto-sum = sj-goods.brutto-sum - sj-goods.discnt-sum
     2367         sj-goods.write-off-sum = sj-goods.write-off-sum + wo-sum
     2368         sj-goods.pcnt = round( ( sj-goods.discnt-sum / sj-goods.brutto-sum ) * 100, 1 )
     2369         sj-goods.is-out = (lookup( string(ub.chk-doc.chk-type), '1,69,14,15,16,36':U) > 0
     2370                            OR ((ub.chk-doc.chk-type = ?
     2371                                or
     2372                                ub.chk-doc.chk-type = 0)
     2373                                and
     2374                                ub.chk-doc.netto >= 0 ))
     2375         .
     2376         FIND FIRST d-slt-vat where d-slt-vat.SLT-pc = sj-goods.SLT-pc NO-LOCK NO-ERROR.
     2377         IF NOT AVAILABLE d-slt-vat then do:
     2378               create d-slt-vat.
     2379               assign d-slt-vat.SLT-pc = sj-goods.SLT-pc.
     2380         end.
     2381         assign
     2382         d-slt-vat.SLT-r-b-brutto =  d-slt-vat.SLT-r-b-brutto +  ub.chk-gds.doc-qnty * (s-price - cur-discnt) .
     2383         ACCUMULATE ub.chk-doc.doc-code ( COUNT ) .
     2384         if ( ( ACCUM COUNT ub.chk-doc.doc-code ) modulo 10 ) = 0 AND
     2385               ( ACCUM COUNT ub.chk-doc.doc-code ) >= 10 then
     2386         run waitfram-show in this-procedure ( input "Обработано строк чеков : " + string( ACCUM COUNT ub.chk-doc.doc-code ) ) .
     2387     END.
     2388     assign
     2389     date_string = cur-time-print() .
     2390     .
     2391     for each d-slt-vat:
     2392             ACCUMULATE d-slt-vat.slt-pc (COUNT).
     2393     end.
     2394     run waitfram-hide in this-procedure .
