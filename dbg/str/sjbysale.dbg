      580   define  stream PrnLibStream.
      581   procedure prn-lib-prn-file :
      582     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      583     define input parameter p-DIsabledoptions as integer no-undo .
      584     define variable v-report-name as character no-undo .
      585     define variable v-user-action as character no-undo .
      586     define variable v-printed     as logical   no-undo .
      587     define variable v-exist       as logical   no-undo .
      588     do
      589       on error undo, return error
      590       :
      591       run prn-lib-get-report-name  in this-procedure (
      592         input parParentProc
      593         ,output v-report-name
      594         ).
      595   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      597     (input  v-report-name
      598     ,input  2
      599     ,output v-exist
      600     )  .
      601       if NOT v-exist then
      602       DO:
      603         Message
      604           "Нет заданий на печать ! "
      605           view-as alert-box .
      606         Return  .
      607       End.
      608       run gbl/prnfilen.w
      609         (input  ""
      610         ,input  p-DisabledOptions
      611         ,input  string(v-report-name )
      612         ,input  7
      613         ,output v-user-action
      614         ,output v-printed
      615         ) .
      616       if v-printed then
      617       do:
      618         return "YES" .
      619       end.
      620       else
      621       do:
      622         return "NO" .
      623       end.
      624     end.
      625   end procedure.
      626   procedure prn-lib-open-stream :
      627     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      628     define input parameter p-page-size    as integer no-undo .
      629     define input parameter p-is-stream    as logical no-undo .
      630     define input parameter p-append       as logical no-undo .
      631     define variable v-report-name as character no-undo .
      632     do
      633       on error undo, return error
      634       :
      635       run prn-lib-get-report-name  in this-procedure (
      636         input parParentProc
      637         ,output v-report-name
      638         ).
      639       if p-is-stream then
      640       do:
      641         if p-append then
      642         do:
      643           output stream PrnLibStream to value( v-report-name )
      644             page-size value(p-page-size) append .
      645         end.
      646         if not p-append then
      647         do:
      648           output stream PrnLibStream to value( v-report-name )
      649             page-size value(p-page-size) .
      650         end.
      651       end.
      652       if not p-is-stream then
      653       do:
      654         if p-append then
      655         do:
      656           output to value( v-report-name )
      657             page-size value(p-page-size) append .
      658         end.
      659         if not p-append then
      660         do:
      661           output to value( v-report-name )
      662             page-size value(p-page-size) .
      663         end.
      664       end.
      665     end.
      666   end procedure.
      667   procedure prn-lib-open-exp :
      668     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      669     define input parameter p-is-stream    as logical no-undo .
      670     define input parameter p-is-append    as logical no-undo .
      671     define output parameter p-ReportFileName as char init "report" no-undo.
      672     define output parameter p-process as logical no-undo .
      673     define variable glog as logical no-undo .
      674     do
      675       on error undo, return error
      676       :
      677       SYSTEM-DIALOG GET-FILE p-ReportFileName
      678         TITLE      "Укажите путь"
      679         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      680         ASK-OVERWRITE
      681         CREATE-TEST-FILE
      682         SAVE-AS
      683         USE-FILENAME
      684         DEFAULT-EXTENSION "txt"
      685         UPDATE glog
      686         .
      687       if not glog then  return.
      688       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      689       if p-is-stream then
      690       do:
      691         if p-is-append then
      692         do:
      693           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      694         end.
      695         else
      696         do:
      697           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      698         end.
      699       end.
      700       else
      701       do:
      702         if p-is-append then
      703         do:
      704           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      705         end.
      706         else
      707         do:
      708           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      709         end.
      710       end.
      711       p-process = yes.
      712     end.
      713   end procedure.
      714   procedure prn-lib-get-report-name :
      715     define input parameter parParentProc  as widget-handle no-undo.
      716     define output parameter p-report-name as character no-undo .
      717     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      718   end procedure.
      719   procedure prn-lib-reportviewer-report-name :
      720     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      721     define input parameter p-report-name-html as character no-undo .
      722     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      723   end procedure.
      724   procedure prn-lib-reportviewer :
      725     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      726     define input parameter p-report-name-html as character no-undo .
      727     define input parameter p-param        as character no-undo .
      728     define variable v-excel           as character no-undo init 'TRUE' .
      729     define variable v-value-character as character no-undo .
      730     define variable v-value-integer   as character no-undo .
      731     define variable v-value-date      as date      no-undo .
      732     define variable v-value-decimal   as decimal   no-undo .
      733     define variable rep-excel         as logical   no-undo .
      734     define variable excel-string      as character no-undo .
      735     define variable v-param-type      as character no-undo .
      736     define variable v-tth             as handle    no-undo .
      737     run adm/shattri.p (
      738       input "get":U
      739       ,input  ""
      740       ,input  0
      741       ,input  'report-glob':U
      742       ,input  'rep-excel':U
      743       ,output v-value-character
      744       ,output v-value-date
      745       ,output v-value-decimal
      746       ,output v-value-integer
      747       ,output rep-excel
      748       ,output v-param-type
      749       ,INPUT-OUTPUT table-handle v-tth
      750       )  .
      751     if rep-excel then v-excel = "TRUE" .
      752     else v-excel = "FALSE" .
      753     if p-param eq ""
      754     then
      755        p-param = "EXCEL:" + v-excel.
      756     else
      757        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      758     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      759   end procedure.
      760   my-handle = parparentproc.
