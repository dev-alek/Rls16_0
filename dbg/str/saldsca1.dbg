      814   define  stream PrnLibStream.
      815   procedure prn-lib-prn-file :
      816     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      817     define input parameter p-DIsabledoptions as integer no-undo .
      818     define variable v-report-name as character no-undo .
      819     define variable v-user-action as character no-undo .
      820     define variable v-printed     as logical   no-undo .
      821     define variable v-exist       as logical   no-undo .
      822     do
      823       on error undo, return error
      824       :
      825       run prn-lib-get-report-name  in this-procedure (
      826         input parParentProc
      827         ,output v-report-name
      828         ).
      829   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      831     (input  v-report-name
      832     ,input  2
      833     ,output v-exist
      834     )  .
      835       if NOT v-exist then
      836       DO:
      837         Message
      838           "Нет заданий на печать ! "
      839           view-as alert-box .
      840         Return  .
      841       End.
      842       run gbl/prnfilen.w
      843         (input  ""
      844         ,input  p-DisabledOptions
      845         ,input  string(v-report-name )
      846         ,input  7
      847         ,output v-user-action
      848         ,output v-printed
      849         ) .
      850       if v-printed then
      851       do:
      852         return "YES" .
      853       end.
      854       else
      855       do:
      856         return "NO" .
      857       end.
      858     end.
      859   end procedure.
      860   procedure prn-lib-open-stream :
      861     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      862     define input parameter p-page-size    as integer no-undo .
      863     define input parameter p-is-stream    as logical no-undo .
      864     define input parameter p-append       as logical no-undo .
      865     define variable v-report-name as character no-undo .
      866     do
      867       on error undo, return error
      868       :
      869       run prn-lib-get-report-name  in this-procedure (
      870         input parParentProc
      871         ,output v-report-name
      872         ).
      873       if p-is-stream then
      874       do:
      875         if p-append then
      876         do:
      877           output stream PrnLibStream to value( v-report-name )
      878             page-size value(p-page-size) append .
      879         end.
      880         if not p-append then
      881         do:
      882           output stream PrnLibStream to value( v-report-name )
      883             page-size value(p-page-size) .
      884         end.
      885       end.
      886       if not p-is-stream then
      887       do:
      888         if p-append then
      889         do:
      890           output to value( v-report-name )
      891             page-size value(p-page-size) append .
      892         end.
      893         if not p-append then
      894         do:
      895           output to value( v-report-name )
      896             page-size value(p-page-size) .
      897         end.
      898       end.
      899     end.
      900   end procedure.
      901   procedure prn-lib-open-exp :
      902     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      903     define input parameter p-is-stream    as logical no-undo .
      904     define input parameter p-is-append    as logical no-undo .
      905     define output parameter p-ReportFileName as char init "report" no-undo.
      906     define output parameter p-process as logical no-undo .
      907     define variable glog as logical no-undo .
      908     do
      909       on error undo, return error
      910       :
      911       SYSTEM-DIALOG GET-FILE p-ReportFileName
      912         TITLE      "Укажите путь"
      913         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      914         ASK-OVERWRITE
      915         CREATE-TEST-FILE
      916         SAVE-AS
      917         USE-FILENAME
      918         DEFAULT-EXTENSION "txt"
      919         UPDATE glog
      920         .
      921       if not glog then  return.
      922       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      923       if p-is-stream then
      924       do:
      925         if p-is-append then
      926         do:
      927           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      928         end.
      929         else
      930         do:
      931           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      932         end.
      933       end.
      934       else
      935       do:
      936         if p-is-append then
      937         do:
      938           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      939         end.
      940         else
      941         do:
      942           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      943         end.
      944       end.
      945       p-process = yes.
      946     end.
      947   end procedure.
      948   procedure prn-lib-get-report-name :
      949     define input parameter parParentProc  as widget-handle no-undo.
      950     define output parameter p-report-name as character no-undo .
      951     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      952   end procedure.
      953   procedure prn-lib-reportviewer-report-name :
      954     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      955     define input parameter p-report-name-html as character no-undo .
      956     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      957   end procedure.
      958   procedure prn-lib-reportviewer :
      959     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      960     define input parameter p-report-name-html as character no-undo .
      961     define input parameter p-param        as character no-undo .
      962     define variable v-excel           as character no-undo init 'TRUE' .
      963     define variable v-value-character as character no-undo .
      964     define variable v-value-integer   as character no-undo .
      965     define variable v-value-date      as date      no-undo .
      966     define variable v-value-decimal   as decimal   no-undo .
      967     define variable rep-excel         as logical   no-undo .
      968     define variable excel-string      as character no-undo .
      969     define variable v-param-type      as character no-undo .
      970     define variable v-tth             as handle    no-undo .
      971     run adm/shattri.p (
      972       input "get":U
      973       ,input  ""
      974       ,input  0
      975       ,input  'report-glob':U
      976       ,input  'rep-excel':U
      977       ,output v-value-character
      978       ,output v-value-date
      979       ,output v-value-decimal
      980       ,output v-value-integer
      981       ,output rep-excel
      982       ,output v-param-type
      983       ,INPUT-OUTPUT table-handle v-tth
      984       )  .
      985     if rep-excel then v-excel = "TRUE" .
      986     else v-excel = "FALSE" .
      987     if p-param eq ""
      988     then
      989        p-param = "EXCEL:" + v-excel.
      990     else
      991        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      992     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      993   end procedure.
      994   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   define variable v-waitfram-action01         as character   no-undo .
      996   define variable v-waitfram-action02         as character   no-undo .
      997   define variable v-waitfram-action03         as character   no-undo .
      998   define variable mWaitFramTextBeg            as character   no-undo.
      999   define variable mWaitFramTextEnd            as character   no-undo.
     1000   define variable mWaitFramView               as logical     no-undo.
     1001   define variable mWaitProcEvent              as logical     no-undo init yes.
     1002   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1003   define variable mWaitFramStop               as logical     no-undo.
     1004   define variable mWaitFramStopUser           as logical     no-undo.
     1005   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1006   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1007   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1008   define button B-WaitFramStop auto-end-key
     1009        label "Стоп"
     1010        size 10 by 1 tooltip "Остоновить процесс".
     1011   define button B-viewProcInfo
     1012        label "Информация"
     1013        size 15 by 1 tooltip "Информация о процесс".
     1014   define frame waitfram
     1015     v-waitfram-action01 format "x(72)" no-label skip
     1016     v-waitfram-action02 format "x(72)" no-label skip
     1017     v-waitfram-action03 format "x(72)" no-label skip
     1018     B-viewProcInfo
     1019     B-WaitFramStop at row 4 col 30
     1020     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1021     .
     1022   define new global shared variable mBatchMode as logical no-undo init ?.
     1023   define variable mFramBachModHandle as handle no-undo.
     1024   mFramBachModHandle = frame waitfram:handle.
     1025   define variable mFameOldVis as logical no-undo.
     1026   define variable mVisCUrentVin as logical no-undo.
     1027   if session:batch-mode
     1028   then
     1029      mBatchMode = yes.
     1030   if mBatchMode = ? then do:
     1031     mVisCUrentVin = current-window:visible.
     1032     mFameOldVis = mFramBachModHandle:visible.
     1033     mFramBachModHandle:visible  = yes.
     1034     mBatchMode = mFramBachModHandle:visible ne yes.
     1035     mFramBachModHandle:visible = mFameOldVis.
     1036     current-window:visible = mVisCUrentVin.
     1037   end.
     1038    if  log-manager:logfile-name ne ?
     1039     then DO:
     1040         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1041         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1042         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1043     end.
     1044   on choose of B-WaitFramStop in frame waitfram
     1045   do:
     1046     mWaitFramStop = yes.
     1047     mWaitFramStopUser = yes.
     1048   end.
     1049   function waitfram-check-timeout returns logical():
     1050      define variable vtime as int64 no-undo.
     1051      if mWaitFramStopTimeOut
     1052      then
     1053         return yes.
     1054      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1055      if     mWaitFramTimeOut ne ?
     1056         and mWaitFramTimeOut ne 0
     1057         and mWaitFramTimeOut lt vtime
     1058      then do:
     1059         mWaitFramStopTimeOut = yes.
     1060      end.
     1061      return mWaitFramStopTimeOut.
     1062   end.
     1063   procedure waitfram-hide :
     1064     if not session:batch-mode
     1065     then do
     1066     on error undo, return error return-value
     1067     :
     1068       pause 0 before-hide .
     1069       if not mBatchMode then
     1070         hide frame waitfram .
     1071     if     not mWaitFramView
     1072        and mWaitProcEvent
     1073     then
     1074       process events .
     1075     end.
     1076   end procedure.
     1077   procedure waitfram-show :
     1078     define input  parameter p-message as character no-undo .
     1079     define variable v-left-margin as integer   no-undo .
     1080     if not session:batch-mode
     1081     then do
     1082     on error undo, return error return-value
     1083     :
     1084       if length(p-message) <= 70 then do:
     1085         assign
     1086           v-left-margin = integer((70 - length(p-message)) / 2)
     1087         .
     1088         assign
     1089           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1090         .
     1091         assign
     1092           v-waitfram-action01 = " "
     1093           v-waitfram-action02 = " "
     1094                                    + fill(" ", v-left-margin)
     1095                                    + p-message
     1096           v-waitfram-action03 = " "
     1097         .
     1098       end.
     1099       else do:
     1100         define variable vRindex1 as integer no-undo.
     1101         define variable vRindex2 as integer no-undo.
     1102         vRindex1 = r-index(p-message," ",70).
     1103         if vRindex1 = 0
     1104         then
     1105            vRindex1 = 70.
     1106         if length(p-message)  <= vRindex1 + 70 then do:
     1107           assign
     1108             v-waitfram-action01 = " "
     1109             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1110             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1111           .
     1112         end.
     1113         else do:
     1114           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1115           if vRindex2 <= vRindex1
     1116           then
     1117              vRindex2 = vRindex1 + 70.
     1118           assign
     1119             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1120             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1121             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1122           .
     1123         end.
     1124       end.
     1125       B-viewProcInfo:visible   in frame waitfram = no.
     1126       B-viewProcInfo:sensitive in frame waitfram = no.
     1127       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1128       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1129       if  (   mWaitFramView
     1130          or  mWaitProcEvent)
     1131          and not mBatchMode
     1132       then
     1133          display
     1134             v-waitfram-action01 skip
     1135             v-waitfram-action02 skip
     1136             v-waitfram-action03 skip
     1137          with frame waitfram .
     1138       if     mWaitFramView
     1139          then do:
     1140             if     mWaitFramInterval ne ?
     1141                and not mBatchMode
     1142             then
     1143                wait-for go of frame waitfram pause mWaitFramInterval.
     1144          end.
     1145          else
     1146             if     mWaitProcEvent
     1147                and not mBatchMode
     1148             then
     1149                process events .
     1150     end.
     1151   end procedure.
     1152      procedure waitfram-show-this:
     1153         define input  parameter iInterval as int64 no-undo.
     1154         define variable vtime as int64 no-undo.
     1155         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1156         mWaitFramInterval = iInterval.
     1157         run waitfram-show (substitute("&1&2 &3&4" ,
     1158                                       mWaitFramTextBeg ,
     1159                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1160                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1161                                       mWaitFramTextEnd
     1162                                      )
     1163                           ).
     1164      end.
     1165      procedure WaitFramRunPause:
     1166         define input  parameter iInterval as dec no-undo.
     1167         define variable vStart  as datetime-tz no-undo.
     1168         define variable vend    as datetime-tz no-undo.
     1169         define variable vint as int64 no-undo.
     1170         define variable vOk as logical no-undo.
     1171         vStart = now.
     1172         vend   = vStart.
     1173         publish "WaitFramPause" (iInterval,output vOk).
     1174         vend   =  now.
     1175         vint = vend - vStart.
     1176         vint = iInterval - vint / 1000.
     1177         if     not mWaitFramStop
     1178            and (   vint > 0
     1179                 or (    not vOk
     1180                     and iInterval eq ?
     1181                     )
     1182                 )
     1183         then
     1184            run waitfram-show-this (iInterval).
     1185         vend   =  now.
     1186         vint = vend - vStart.
     1187         vint = iInterval - vint / 1000.
     1188         if     not mWaitFramStop
     1189            and vint > 0
     1190         then do:
     1191            run gbl/pause.p (vint * 1000).
     1192         end.
     1193         if iInterval ne ?
     1194         then
     1195            publish "WaitFramStop".
     1196         waitfram-check-timeout().
     1197      end.
     1198      procedure WaitFramWaitFor:
     1199         define input  parameter iInterval as dec no-undo.
     1200         assign
     1201            mWaitFramStartProc   = now
     1202            mWaitFramStopUser    = no
     1203            mWaitFramStopTimeOut = no
     1204         .
     1205         block-wait:
     1206         do while not mWaitFramStop:
     1207            run WaitFramRunPause (iInterval).
     1208            if  waitfram-check-timeout()
     1209            then do:
     1210               leave block-wait.
     1211            end.
     1212         end.
     1213         run waitfram-hide.
     1214      end.
     1215   procedure waitfram-join :
     1216     define input  parameter p-line-1  as character no-undo .
     1217     define input  parameter p-line-2  as character no-undo .
     1218     define input  parameter p-line-3  as character no-undo .
     1219     define output parameter p-message as character no-undo .
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       assign
     1224         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1225                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1226                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1227       .
     1228     end.
     1229   end procedure.
     1230   function waitfram-join-function returns character
     1231     (input p-line-1 as character
     1232     ,input p-line-2 as character
     1233     ,input p-line-3 as character
     1234     ).
     1235     define variable v-message as character no-undo .
     1236     run waitfram-join in this-procedure
     1237       (input  p-line-1
     1238       ,input  p-line-2
     1239       ,input  p-line-3
     1240       ,output v-message
     1241       ) .
     1242     return v-message .
     1243   end function .
     1244   define variable g#report-num as integer no-undo .
     1245   procedure OpenForExcel :
     1246      define variable v-ch#ExcelApplication as com-handle no-undo .
     1247      define variable v-ch#Workbook         as com-handle no-undo .
     1248      define variable v-ch#Worksheet        as com-handle no-undo .
     1249      os-delete value( string( session:temp-directory ) +
     1250                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1251      os-delete value( string( session:temp-directory ) +
     1252                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1253      os-delete value( string( session:temp-directory ) +
     1254                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1255      if Make-Excel
     1256      then do:
     1257         output stream ForExcel to value( string( session:temp-directory +
     1258                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1259         assign
     1260            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1261            number-list = 1
     1262         .
     1263         if make-excel-com
     1264         then do:
     1265   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   if valid-handle(ch#WorkSheet) then
     1267   RELEASE OBJECT ch#WorkSheet no-error.
     1268   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   if valid-handle(ch#Workbook) then
     1270   RELEASE OBJECT ch#Workbook no-error.
     1271   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   if valid-handle(ch#ExcelApplication) then
     1273   RELEASE OBJECT ch#ExcelApplication no-error.
     1274            create "Excel.Application" ch#excelApplication connect no-error.
     1275            if error-status:error
     1276            then do :
     1277           create "Excel.Application" ch#excelApplication no-error.
     1278       if error-status :error then do:
     1279           message
     1280           "Ошибка при запуске Excel" skip
     1281           error-status :get-message(1) skip
     1282           view-as alert-box error .
     1283           undo, return error .
     1284       end.
     1285            end.
     1286            assign
     1287               num#str#  = 0.
     1288               v-ch#excelApplication  = ch#excelApplication.
     1289               v-ch#excelApplication:Interactive = false.
     1290               v-ch#excelApplication:ScreenUpdating = false.
     1291               v-ch#excelApplication:Visible = false.
     1292               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1293               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1294               v-ch#Worksheet = ch#WorkSheet.
     1295               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1296               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1297               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1298               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1299            no-error .
     1300            if error-status:error
     1301            then do:
     1302               Make-Excel-com = false .
     1303               Make-Excel = false .
     1304               output Stream  ForExcel close.
     1305               os-delete value( string( session:temp-directory ) +
     1306                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1307               os-delete value( string( session:temp-directory ) +
     1308                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1309               return.
     1310            end.
     1311         end.
     1312      end.
     1313   end.
     1314   procedure CloseForExcel :
     1315      define variable ii as integer no-undo .
     1316      define variable vsheet-num as integer no-undo.
     1317      if Make-Excel
     1318      then  do:
     1319         output Stream  ForExcel close.
     1320         os-delete value( string( session:temp-directory ) +
     1321                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1322         os-delete value( string( session:temp-directory ) +
     1323                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1324         define buffer buf_sheetf for sheetf.
     1325         find last buf_sheetf no-error .
     1326         if available buf_sheetf
     1327         then
     1328            vsheet-num = buf_sheetf.sheet-num.
     1329         if vsheet-num > 1
     1330         then do:
     1331            do ii = 2 to vsheet-num:
     1332               os-delete value( string( session:temp-directory ) +
     1333                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1334            end.
     1335         end.
     1336   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   if valid-handle(ch#WorkSheet) then
     1338   RELEASE OBJECT ch#WorkSheet no-error.
     1339   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   if valid-handle(ch#Workbook) then
     1341   RELEASE OBJECT ch#Workbook no-error.
     1342   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   if valid-handle(ch#ExcelApplication) then
     1344   RELEASE OBJECT ch#ExcelApplication no-error.
     1345      end.
     1346   end.
     1347   DEFINE VARIABLE Line                as character                    no-undo .
     1348   define variable v-ov-base           as decimal no-undo .
     1349   define variable v-ov-rubl           as decimal no-undo .
     1350   define variable v-num as integer no-undo .
     1351   define variable v-str as character no-undo extent 7.
     1352   define variable ii as integer no-undo .
     1353   define variable jj as integer no-undo .
     1354   define variable v-curr-r-b as character no-undo .
     1355   define variable v-r-b-abbr as character no-undo .
     1356   define variable g#quest-print as logical no-undo .
     1357   define variable g#log as logical no-undo .
     1358   define variable max-sections as integer no-undo .
     1359   define variable strbuf as character no-undo .
     1360   define variable v-col-delim as character no-undo .
     1361   define variable v-section-delim as character no-undo .
     1362   define variable accum-b-code-qnty as decimal no-undo .
     1363   define variable accum-b-code-sum as decimal no-undo .
     1364   define variable accum-qnty as decimal no-undo .
     1365   define variable accum-sum as decimal no-undo .
     1366   define variable accum-sum-doc as decimal no-undo .
     1367   define variable date_string  as character no-undo .
     1368   define temp-table temp-chk-gds no-undo
     1369   field b-code     like ub.chk-gds.b-code
     1370   field price-base like ub.chk-gds.price-base
     1371   field doc-qnty   like ub.chk-gds.doc-qnty
     1372   field line-num   like ub.chk-gds.line-num
     1373   field is-out     as integer
     1374   field doc-price  like ub.gds-dtl.price-rubl
     1375   field doc-discnt like ub.gds-dtl.discnt-rubl
     1376   field gds-code   like ub.goods.gds-code
     1377   field sum-base   as decimal
     1378   field discnt-base as decimal
     1379   index pi is unique primary
     1380   b-code
     1381   is-out
     1382   price-base
     1383   index iline is unique
     1384   b-code
     1385   is-out
     1386   line-num
     1387   index iout
     1388   is-out descending
     1389   .
     1390   define buffer buf_inkas for ub.inkas .
     1391   define buffer buf_shop for ub.shop.
     1392   define buffer buf_clients for ub.clients.
     1393   define buffer buf_temp-chk-gds for temp-chk-gds.
     1394   define buffer buf_goods for ub.goods.
     1395   do
     1396   on error undo, return error
     1397   :
     1398     if not valid-handle(my-handle) then do:
     1399       assign
     1400       my-handle = parparentproc.
     1401     end.
     1402   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1404     (output v-curr-r-b
     1405     )  .
     1406     find first buf_inkas no-lock where
     1407                 buf_inkas.inkas-code = p-inkas-code no-error .
     1408     if NOT available buf_inkas then do:
     1409       message
     1410       vss-workfile vss-revision vss-description skip
     1411       "Неправильный выбор кассового отчета."
     1412       view-as alert-box WARNING .
     1413       return error .
     1414     end.
     1415   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     1417     (input  buf_inkas.host-code
     1418     ,output v-r-b-abbr
     1419     )  .
     1420     find first buf_shop no-lock where
     1421               buf_shop.obj-code = buf_inkas.obj-code no-error .
     1422     if not available buf_shop then do:
     1423       message
     1424       vss-workfile vss-revision vss-description skip
     1425       "Не найден объект для кассового отчета." p-inkas-code
     1426       view-as alert-box WARNING .
     1427       return error .
     1428     end.
     1429     find first buf_clients no-lock where
     1430               buf_clients.obj-type = 'маг':U
     1431           AND buf_clients.obj-code = buf_shop.obj-code no-error .
     1432     run calculate-discnt in this-procedure (
     1433                                              input v-curr-r-b
     1434                                            , input buf_inkas.inkas-code
     1435                                            , output v-ov-base
     1436                                            , output v-ov-rubl) no-error .
     1437     if error-status:error then do:
     1438       message
     1439       vss-workfile vss-revision vss-description skip
     1440       "Ошибка при подсчете скидок по переоценке для кассового отчета." p-inkas-code skip
     1441       error-status:get-message(1) skip
     1442       return-value
     1443       view-as alert-box WARNING .
     1444       undo, return error .
     1445     end.
     1446     assign
     1447     v-col-delim = chr(32)
     1448     v-section-delim = "|":U
     1449     make-excel = yes
     1450     reportname = "Отчет по скидкам, возникшим в результате разницы в документе продажи и чеках"
     1451     str1       = substitute("Отчет о продаже &1 &2&3"
     1452                              , buf_inkas.inkas-code
     1453                              , buf_inkas.obj-type
     1454                              , buf_inkas.obj-code)
     1455     .
     1456     run get-report-num  in parParentProc(output g#report-num).
     1457     run prn-lib-open-stream  in this-procedure (
     1458                                                 input parParentProc
     1459                                                 ,input 43
     1460                                                 ,input yes
     1461                                                 ,input no
     1462                                                 ).
     1463     RUN OpenForExcel in this-procedure .
     1464     assign
     1465     StrBuf =              string( "Артикул", "X(16)" ) +
     1466              v-col-delim + string( "Бар-код", "X(9)" ) +
     1467              v-col-delim + string( "Название товара", "X(39)" )
     1468     sheetf.Excel-COlumn-Lable = string( "   Артикул", "X(16)" ) + chr(44) +
     1469                                 string( "Бар-код", "X(9)" ) + chr(44) +
     1470                                 string( "     Название товара", "X(39)" ) + chr(44)
     1471     sheetf.sizes = "16" + chr(44) +
     1472                    "9"  + chr(44) +
     1473                    "39"  + chr(44)
     1474     p-frame-width = 16 + 9 + 39
     1475     .
     1476     do ii = 1 to max-sections:
     1477       assign
     1478       StrBuf = StrBuf + v-section-delim + string( "Цена в чеке", "X(11)" ) +
     1479               v-col-delim + string( "К-во в чеке", "X(11)" ) +
     1480               v-col-delim + string( "Сумма по чеку", "X(16)" )
     1481       sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable +
     1482                                   string( "Цена в чеке", "X(11)" ) + chr(44) +
     1483                                   string( "Кол-во в чеке", "X(11)" ) + chr(44) +
     1484                                   string( "Сумма по чеку", "X(16)" ) + chr(44)
     1485       sheetf.sizes = sheetf.sizes +
     1486                                       "11" + chr(44) +
     1487                                       "11"  + chr(44) +
     1488                                       "16"  + chr(44)
     1489       p-frame-width = p-frame-width + 11 + 11 + 16
     1490       .
     1491     end.
     1492     assign
     1493     StrBuf = StrBuf + v-section-delim + string( "Кол-во ИТОГО", "X(16)" ) +
     1494             v-col-delim + string( "Сумма по чекам", "X(19)" ) +
     1495             v-col-delim + string( "Сумма по докум-ту", "X(19)" ) +
     1496             v-col-delim + string( "Разница", "X(19)" )
     1497     sheetf.Excel-COlumn-Lable = sheetf.Excel-COlumn-Lable +
     1498                                 string( "Кол-во ИТОГО", "X(16)" ) + chr(44) +
     1499                                 string( "Сумма по чекам", "X(19)" ) + chr(44) +
     1500                                 string( "Сумма по док-ту", "X(19)" ) + chr(44) +
     1501                                 string( "Разница", "X(19)" )
     1502     sheetf.sizes = sheetf.sizes +
     1503                                     "16"  + chr(44) +
     1504                                     "19"  + chr(44) +
     1505                                     "19"  + chr(44) +
     1506                                     "19"
     1507     p-frame-width = p-frame-width + 16 + 19  + 19  + 19
     1508     sheetf.colformat = sheetf.colformat + chr(4) + "1=@"
     1509     Sheetf.Bas-FIle = "exe/saldsca1.bas"
     1510     .
     1511     run rep/extitle.p (1).
     1512     Sheetf.Bas-Params = string(max-sections) + chr(4) + string(Sheetf.Excel-Row-Heder).
     1513     Line = fill("-", 198).
     1514     date_string = cur-time-print() .
     1515     Put stream PrnLibstream unformatted
     1516     reportname skip
     1517     str1
     1518      skip(1)
     1519      date_string AT 5 format "X(35)"
     1520      skip(1)
     1521      .
     1522     Put stream PrnLibStream unformatted StrBuf SKIP .
     1523     put stream Prnlibstream unformatted                                                  fill( "-", 16)                                       v-col-delim fill( "-", 9)                                    v-col-delim fill( "-", 39)                                   .                                                                         do ii = 1 to max-sections:                                                  put stream Prnlibstream unformatted                                       v-section-delim fill( "-", 11)                             v-col-delim fill( "-", 11)                                       v-col-delim fill( "-", 16)                                        .                                                                       end.                                                                      put stream Prnlibstream unformatted                                       v-section-delim fill( "-" , 16)                            v-col-delim fill( "-" , 19)                                 v-col-delim fill( "-" , 19)                                 v-col-delim fill( "-" , 19)                                 skip.
     1524     _temp-chk-gds:
     1525     for each temp-chk-gds where
     1526     by temp-chk-gds.is-out descending
     1527     by temp-chk-gds.b-code
     1528     by temp-chk-gds.line-num
     1529     :
     1530       if temp-chk-gds.line-num = 1  then do:
     1531         find first buf_goods no-lock where
     1532                   buf_goods.gds-code = temp-chk-gds.b-code.
     1533         Put stream Prnlibstream  unformatted
     1534                    buf_goods.artic format "X(16)"
     1535         v-col-delim temp-chk-gds.b-code format ">>>>>>>>9"
     1536         v-col-delim buf_goods.gds-name format "X(39)"
     1537         .
     1538         if Make-Excel then  put   stream ForExcel unformatted
     1539         (chr(4) + buf_goods.artic) format "X(16)" CHR(9)
     1540         temp-chk-gds.b-code format ">>>>>>>>9" CHR(9)
     1541         buf_goods.gds-name format "X(39)" CHR(9)
     1542         .
     1543         assign
     1544         accum-b-code-qnty = 0
     1545         accum-b-code-sum = 0
     1546         ii = 0
     1547         .
     1548         for each buf_temp-chk-gds no-lock where
     1549                 buf_temp-chk-gds.is-out = temp-chk-gds.is-out
     1550             AND buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     1551         by buf_temp-chk-gds.price-base:
     1552           assign
     1553           ii = ii + 1
     1554           accum-b-code-qnty = accum-b-code-qnty + buf_temp-chk-gds.doc-qnty
     1555           accum-b-code-sum = accum-b-code-sum + buf_temp-chk-gds.sum-base
     1556           accum-qnty = accum-qnty + buf_temp-chk-gds.doc-qnty
     1557           accum-sum = accum-sum + buf_temp-chk-gds.sum-base
     1558           .
     1559           put stream Prnlibstream unformatted
     1560           v-section-delim buf_temp-chk-gds.price-base format  ">>>,>>9.999"
     1561           v-col-delim  buf_temp-chk-gds.doc-qnty   format ">>>,>>9.999"
     1562           v-col-delim (buf_temp-chk-gds.doc-qnty * buf_temp-chk-gds.price-base)  format "->>>,>>>,>>9.999"
     1563           .
     1564           if Make-Excel then  put   stream ForExcel unformatted
     1565           buf_temp-chk-gds.price-base          CHR(9)
     1566           buf_temp-chk-gds.doc-qnty            CHR(9)
     1567           (buf_temp-chk-gds.doc-qnty * buf_temp-chk-gds.price-base)   CHR(9)
     1568           .
     1569         end.
     1570         if ii < max-sections then do:
     1571           do jj = 1 to (max-sections - ii):
     1572             put stream Prnlibstream
     1573             v-section-delim fill(chr(32),  11)
     1574             v-col-delim fill(chr(32),  11)
     1575             fill(chr(32),  16)
     1576             .
     1577             if Make-Excel then  put   stream ForExcel unformatted
     1578             CHR(9)
     1579             CHR(9)
     1580             CHR(9)
     1581             .
     1582           end.
     1583         end.
     1584         put stream Prnlibstream unformatted
     1585         v-section-delim accum-b-code-qnty  format "->>>,>>>,>>9.999"
     1586         v-col-delim accum-b-code-sum  format "->>,>>>,>>>,>>9.999"
     1587         v-col-delim temp-chk-gds.doc-price * accum-b-code-qnty format "->>,>>>,>>>,>>9.999"
     1588         v-col-delim  (temp-chk-gds.doc-price * accum-b-code-qnty - accum-b-code-sum) format "->>,>>>,>>>,>>9.999"
     1589         skip
     1590         .
     1591         if Make-Excel then  put   stream ForExcel unformatted
     1592         accum-b-code-qnty  CHR(9)
     1593         accum-b-code-sum  CHR(9)
     1594         temp-chk-gds.doc-price * accum-b-code-qnty CHR(9)
     1595         (temp-chk-gds.doc-price * accum-b-code-qnty - accum-b-code-sum) CHR(9)
     1596         skip.
     1597         accum-sum-doc = accum-sum-doc + (temp-chk-gds.doc-price * accum-b-code-qnty).
     1598       end.
     1599       else do:
     1600         NEXT _temp-chk-gds.
     1601       end.
     1602     end.
     1603     put stream Prnlibstream unformatted                                                  fill( "_", 16)                                       v-col-delim fill( "_", 9)                                    v-col-delim fill( "_", 39)                                   .                                                                         do ii = 1 to max-sections:                                                  put stream Prnlibstream unformatted                                       v-section-delim fill( "_", 11)                             v-col-delim fill( "_", 11)                                       v-col-delim fill( "_", 16)                                        .                                                                       end.                                                                      put stream Prnlibstream unformatted                                       v-section-delim fill( "_" , 16)                            v-col-delim fill( "_" , 19)                                 v-col-delim fill( "_" , 19)                                 v-col-delim fill( "_" , 19)                                 skip.
     1604     put stream Prnlibstream unformatted
     1605                 fill( chr(32), 16)
     1606     v-col-delim fill( chr(32), 9)
     1607     v-col-delim fill( chr(32), 39)
     1608     .
     1609     if Make-Excel then  put   stream ForExcel unformatted
     1610     CHR(9)
     1611     CHR(9)
     1612     CHR(9)
     1613     .
     1614     do ii = 1 to max-sections:
     1615       put stream Prnlibstream unformatted
     1616       v-section-delim  fill( chr(32), 11)
     1617       v-col-delim      fill( chr(32), 11)
     1618       v-col-delim      fill( chr(32), 16)
     1619       .
     1620       if Make-Excel then  put   stream ForExcel unformatted
     1621       CHR(9)
     1622       CHR(9)
     1623       CHR(9)
     1624       .
     1625     end.
     1626     put stream Prnlibstream unformatted
     1627     v-section-delim fill( chr(32) , 16)
     1628     v-col-delim accum-sum                    format "->>,>>>,>>>,>>9.999"
     1629     v-col-delim accum-sum-doc                format "->>,>>>,>>>,>>9.999"
     1630     v-col-delim (accum-sum-doc -  accum-sum) format "->>,>>>,>>>,>>9.999"
     1631     skip
     1632     .
     1633     if Make-Excel then  put   stream ForExcel unformatted
     1634     CHR(9)
     1635     accum-sum CHR(9)
     1636     accum-sum-doc CHR(9)
     1637     (accum-sum-doc -  accum-sum) skip.
     1638     output  STREAM PrnLibStream CLOSE.
     1639     if Make-Excel then output stream ForExcel close.
     1640     run prn-lib-prn-file in this-procedure (
     1641                                              input parParentProc
     1642                                             ,input (if p-frame-width <= 198 then 8 else 9)
     1643                                             ).
     1644   end.
     1645   procedure calculate-discnt :
     1646   define input parameter p-curr-r-b as character no-undo .
     1647   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1648   define output parameter p-ov-base as decimal no-undo .
     1649   define output parameter p-ov-rubl as decimal no-undo .
     1650   define variable v-b-code like ub.bar-code.b-code no-undo .
     1651   define variable v-gds-code like ub.goods.gds-code no-undo .
     1652   define variable v-doc-num         like ub.price-doc.doc-num     no-undo.
     1653   define variable v-ras-price like ub.gds-dtl.price-rubl no-undo .
     1654   define variable v-ras-discnt like ub.gds-dtl.discnt-rubl no-undo .
     1655   define variable v-voz-price like ub.gds-dtl.price-rubl no-undo .
     1656   define variable v-voz-discnt like ub.gds-dtl.discnt-rubl no-undo .
     1657   define variable v-is-out    as integer no-undo .
     1658   define buffer buf_trn for ub.trn-doc.
     1659   define buffer buf_ret for ub.trn-doc.
     1660   define buffer buf_doc-line for ub.doc-line.
     1661   define buffer buf_gds-dtl for ub.gds-dtl.
     1662   define buffer buf_chk-gds for ub.chk-gds.
     1663   define buffer buf_chk-doc for ub.chk-doc.
     1664   define buffer buf_goods  for ub.goods.
     1665   define buffer buf_bar-code  for ub.bar-code.
     1666     do
     1667     on error undo, return error
     1668     :
     1669       for each temp-chk-gds:
     1670         delete temp-chk-gds.
     1671       end.
     1672       find first buf_trn no-lock where
     1673                 buf_trn.doc-code = p-inkas-code no-error .
     1674       if not available buf_trn then do:
     1675         undo, return error substitute("Не найдена расходная часть для кассового отчета &1", p-inkas-code).
     1676       end.
     1677       find first buf_ret no-lock where
     1678               buf_ret.doc-code = buf_trn.out-code no-error .
     1679       run waitfram-show in this-procedure ("Ждите..." ).
     1680       _chk-gds:
     1681       FOR EACH buf_chk-gds No-LOCK WHERE
     1682              buf_chk-gds.out-code = p-inkas-code,
     1683           FIRST buf_chk-doc NO-LOCK where
     1684                 buf_chk-doc.doc-code = buf_chk-gds.doc-code,
     1685           FIRST buf_bar-code No-LOCK WHERE
     1686                 buf_bar-code.b-code = buf_chk-gds.b-code,
     1687           FIRST buf_goods NO-LOCK WHERE buf_goods.gds-code = buf_bar-code.gds-code
     1688       BREAK
     1689       BY buf_chk-gds.b-code:
     1690         run waitfram-show in this-procedure (string("Ждите ... Обработка товара " +
     1691                                     string(buf_chk-gds.b-code, "9999999999")
     1692                             )         ).
     1693         IF FIRST-OF(buf_chk-gds.b-code) then do:
     1694           FIND FIRST buf_gds-dtl WHERE
     1695                     buf_gds-dtl.doc-code = buf_trn.doc-code
     1696                 AND buf_gds-dtl.artic = buf_goods.artic
     1697                 AND buf_gds-dtl.prod-type = buf_goods.prod-type
     1698                 AND buf_gds-dtl.prod-code = buf_goods.prod-code
     1699                 AND buf_gds-dtl.prt-code = buf_bar-code.node-code no-error.
     1700           if available buf_gds-dtl then do:
     1701             assign
     1702             v-ras-price = (if v-curr-r-b = 'rubl':U
     1703                            then buf_gds-dtl.price-rubl
     1704                            else buf_gds-dtl.price-base)
     1705             v-ras-discnt = (if v-curr-r-b = 'rubl':U
     1706                            then buf_gds-dtl.discnt-rubl
     1707                            else buf_gds-dtl.discnt-base).
     1708           end.
     1709           if available buf_ret then do:
     1710             FIND FIRST buf_gds-dtl WHERE
     1711                       buf_gds-dtl.doc-code = buf_ret.doc-code
     1712                   AND buf_gds-dtl.artic = buf_goods.artic
     1713                   AND buf_gds-dtl.prod-type = buf_goods.prod-type
     1714                   AND buf_gds-dtl.prod-code = buf_goods.prod-code
     1715                   AND buf_gds-dtl.prt-code = buf_bar-code.node-code no-error.
     1716             if available buf_gds-dtl then do:
     1717               assign
     1718               v-voz-price = (if v-curr-r-b = 'rubl':U
     1719                             then buf_gds-dtl.price-rubl
     1720                             else buf_gds-dtl.price-base)
     1721               v-voz-discnt = (if v-curr-r-b = 'rubl':U
     1722                             then buf_gds-dtl.discnt-rubl
     1723                             else buf_gds-dtl.discnt-base).
     1724             end.
     1725           end.
     1726         END.
     1727         CASE buf_chk-doc.chk-type:
     1728           when integer('1':U)
     1729           or when integer('69':U)
     1730           then do:
     1731             if abs(buf_chk-gds.price-base - v-ras-price) < 0.005 then NEXT _chk-gds.
     1732             v-is-out = 1.
     1733           end.
     1734           when integer('6':U)
     1735           or
     1736           when integer('96':U)
     1737           then do:
     1738             if abs(buf_chk-gds.price-base - v-voz-price) < 0.005 then NEXT _chk-gds.
     1739             v-is-out = - 1.
     1740           end.
     1741           otherwise do:
     1742             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1743             if buf_chk-doc.netto >= 0 then do:
     1744               if abs(buf_chk-gds.price-base - v-ras-price) < 0.005 then NEXT _chk-gds.
     1745               v-is-out = 1.
     1746             end.
     1747             if buf_chk-doc.netto < 0 then do:
     1748               if abs(buf_chk-gds.price-base - v-voz-price) < 0.005 then NEXT _chk-gds.
     1749               v-is-out = - 1.
     1750             end.
     1751           end.
     1752         END CASE.
     1753         find first temp-chk-gds where
     1754                   temp-chk-gds.b-code = buf_chk-gds.b-code
     1755               AND temp-chk-gds.is-out = v-is-out
     1756               AND temp-chk-gds.price-base = buf_chk-gds.price-base use-index pi no-error.
     1757         if not available temp-chk-gds then do:
     1758           find last buf_temp-chk-gds no-lock where
     1759                     buf_temp-chk-gds.b-code = buf_chk-gds.b-code
     1760                 AND buf_temp-chk-gds.is-out = v-is-out  use-index iline no-error .
     1761           create temp-chk-gds.
     1762           buffer-copy buf_chk-gds
     1763           except doc-code to
     1764           temp-chk-gds
     1765           assign
     1766           temp-chk-gds.price-base = buf_chk-gds.price-base
     1767           temp-chk-gds.sum-base = buf_chk-gds.doc-qnty * buf_chk-gds.price-base
     1768           temp-chk-gds.discnt-base = buf_chk-gds.doc-qnty * buf_chk-gds.discnt
     1769           temp-chk-gds.line-num = (if not available buf_temp-chk-gds then 1 else buf_temp-chk-gds.line-num + 1)
     1770           temp-chk-gds.is-out   = v-is-out
     1771           temp-chk-gds.doc-price = (if v-is-out = 1 then v-ras-price else v-voz-price)
     1772           temp-chk-gds.doc-discnt = (if v-is-out = 1 then v-ras-discnt else v-voz-discnt)
     1773           temp-chk-gds.gds-code = buf_goods.gds-code
     1774           max-sections = maximum(temp-chk-gds.line-num, max-sections)
     1775           .
     1776         end.
     1777         else do:
     1778           assign
     1779           temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + buf_chk-gds.doc-qnty
     1780           temp-chk-gds.sum-base = temp-chk-gds.sum-base +
     1781                                       buf_chk-gds.doc-qnty * buf_chk-gds.price-base
     1782           temp-chk-gds.discnt-base = temp-chk-gds.discnt-base +
     1783                                          buf_chk-gds.doc-qnty * buf_chk-gds.discnt
     1784           .
     1785         end.
     1786       end.
     1787       run waitfram-hide in this-procedure .
     1788       output to jj.txt.
     1789       for each temp-chk-gds:
     1790       export temp-chk-gds.
     1791       end.
     1792       output close.
     1793     end.
     1794   end procedure.
