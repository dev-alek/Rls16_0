      369   procedure create_obj-list :
      370      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      371      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      372      do
      373      on error undo, return error return-value
      374      :
      375         define buffer cli-obj for ub.clients .
      376         define variable p-var as integer no-undo .
      377         define buffer buf_obj-list for obj-list .
      378         find last buf_obj-list  use-index pi no-error .
      379         if available buf_obj-list
      380         then
      381            p-var = buf_obj-list.obj-id + 1.
      382         else
      383            p-var = 1.
      384         find first cli-obj where
      385                   cli-obj.obj-type = p-obj-type
      386               and cli-obj.obj-code = p-obj-code
      387         no-lock no-error.
      388         if available cli-obj
      389         then do:
      390            create buf_obj-list.
      391            assign
      392               buf_obj-list.obj-id   = p-var
      393               buf_obj-list.obj-code = cli-obj.obj-code
      394               buf_obj-list.obj-type = cli-obj.obj-type
      395               buf_obj-list.obj-name = cli-obj.obj-name
      396               buf_obj-list.db-num   = cli-obj.db-num
      397            .
      398         end.
      399      end.
      400   end.
