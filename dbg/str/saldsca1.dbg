        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
        4   define output parameter p-frame-width as integer no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: saldsca1.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: str/saldsca1.p $":U .
