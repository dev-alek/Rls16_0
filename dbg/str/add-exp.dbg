      367   procedure lineattr-delete-flora-all :
      368     do
      369     on error undo, return error return-value
      370     :
      371       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      372       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      373       define input  parameter p-prt-code    as integer   no-undo .
      374       define buffer buf_doc-line-attr for ub.doc-line-attr .
      375       for each buf_doc-line-attr exclusive-lock
      376         where buf_doc-line-attr.doc-code  = p-doc-code
      377           and buf_doc-line-attr.gds-code  = p-gds-code
      378           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      379        :
      380         delete buf_doc-line-attr.
      381       end.
      382    end.
      383   end procedure.
      384   procedure lineattr-exist-flora-gds :
      385     do
      386     on error undo, return error return-value
      387     :
      388       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      389       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      390       define input  parameter p-prt-code    as integer   no-undo .
      391       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      392       define output parameter p-exist as logical   no-undo .
      393       define buffer buf_doc-line-attr for ub.doc-line-attr .
      394       p-exist = false .
      395       find first buf_doc-line-attr no-lock
      396         where buf_doc-line-attr.doc-code  = p-doc-code
      397           and buf_doc-line-attr.gds-code  = p-gds-code
      398           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      399         no-error .
      400       if avail buf_doc-line-attr then do:
      401         assign
      402          p-exist = true
      403         .
      404       end.
      405     end.
      406   end procedure.
      407   procedure lineattr-write-add-line-cli :
      408   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      409   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      410   define input  parameter p-cli-type      as character no-undo .
      411   define input  parameter p-cli-code      as integer   no-undo .
      412   define input  parameter p-contract-code as integer   no-undo .
      413   define input  parameter p-host-code     as integer   no-undo .
      414   define input  parameter p-exch-code     as integer   no-undo .
      415   define input  parameter p-exch-rate     as decimal   no-undo .
      416   define input  parameter p-exch-scale    as integer   no-undo .
      417   define input  parameter p-sum-cli       as decimal   no-undo .
      418   define input  parameter p-sum-vat       as decimal   no-undo .
      419   define buffer buf_doc-line-attr for ub.doc-line-attr .
      420     do
      421     on error undo, return error return-value
      422     :
      423       find first buf_doc-line-attr exclusive-lock
      424         where buf_doc-line-attr.doc-code  = p-doc-code
      425           and buf_doc-line-attr.gds-code  = p-gds-code
      426           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      427                                             chr(4) + p-cli-type +
      428                                             chr(4) + string(p-cli-code) +
      429                                             chr(4) + string(p-contract-code) +
      430                                             chr(4) + string(p-host-code)
      431         no-error .
      432       if not available buf_doc-line-attr then do:
      433         create buf_doc-line-attr .
      434         assign
      435           buf_doc-line-attr.doc-code  = p-doc-code
      436           buf_doc-line-attr.gds-code  = p-gds-code
      437           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      438                                         chr(4) + p-cli-type +
      439                                         chr(4) + string(p-cli-code) +
      440                                         chr(4) + string(p-contract-code) +
      441                                         chr(4) + string(p-host-code)
      442         .
      443       end.
      444       assign
      445         buf_doc-line-attr.attr-value =
      446         string(p-exch-code)  + chr(4) +
      447         string(p-exch-rate)  + chr(4) +
      448         string(p-exch-scale) + chr(4) +
      449         string(p-sum-cli)    + chr(4) +
      450         string(p-sum-vat)
      451         .
      452     end.
      453   end procedure.
      454   procedure lineattr-value-add-line-cli :
      455   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      456   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      457   define input   parameter p-cli-type      as character no-undo .
      458   define input   parameter p-cli-code      as integer   no-undo .
      459   define input   parameter p-contract-code as integer   no-undo .
      460   define input   parameter p-host-code     as integer   no-undo .
      461   define output  parameter p-exch-code     as integer   no-undo .
      462   define output  parameter p-exch-rate     as decimal   no-undo .
      463   define output  parameter p-exch-scale    as integer   no-undo .
      464   define output  parameter p-sum-cli       as decimal   no-undo .
      465   define output  parameter p-sum-vat       as decimal   no-undo .
      466   define buffer buf_doc-line-attr for ub.doc-line-attr .
      467     do
      468     on error undo, return error return-value
      469     :
      470       find first buf_doc-line-attr exclusive-lock
      471         where buf_doc-line-attr.doc-code  = p-doc-code
      472           and buf_doc-line-attr.gds-code  = p-gds-code
      473           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      474                                             chr(4) + p-cli-type +
      475                                             chr(4) + string(p-cli-code) +
      476                                             chr(4) + string(p-contract-code) +
      477                                             chr(4) + string(p-host-code)
      478         no-error .
      479       if available buf_doc-line-attr then do:
      480        assign
      481           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      482           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      483           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      484           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      485           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      486          .
      487        end.
      488     end.
      489   end procedure.
      490   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      491     define variable v-code as character no-undo .
      492     define variable v-type as character no-undo .
      493     define variable v-gds-code as integer   no-undo .
      494   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      496     (input  local-doc-line.artic
      497     ,input  local-doc-line.prod-type
      498     ,input  local-doc-line.prod-code
      499     ,output v-gds-code
      500     )  .
      501     run lineattr-value (
      502         input   local-doc-line.doc-code ,
      503         input   v-gds-code              ,
      504         input   'reason-code':U ,
      505         output  v-code                  ,
      506         output  v-type ) .
      507     find first ub.trn-reason no-lock where
      508                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      509     if not available ub.trn-reason then do:
      510        return "" .
      511     end.
      512     else do:
      513        return ub.trn-reason.reason-name .
      514     end.
      515   end function.
      516   procedure lineattr-value-parts :
      517     do
      518     on error undo, return error return-value
      519     :
      520       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      521       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      522       define input  parameter p-part-code   as character no-undo .
      523       define input  parameter p_in-code     as character no-undo .
      524       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      525       define output parameter p-value       as    decimal   no-undo .
      526       define buffer buf_doc-line-attr for ub.doc-line-attr .
      527       find first buf_doc-line-attr no-lock
      528         where buf_doc-line-attr.doc-code  = p-doc-code
      529           and buf_doc-line-attr.gds-code  = p-gds-code
      530           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      531         no-error .
      532       if avail buf_doc-line-attr then do:
      533         assign
      534           p-value = decimal( buf_doc-line-attr.attr-value)
      535         .
      536       end.
      537       else do:
      538         assign
      539           p-value = 0
      540         .
      541       end.
      542     end.
      543   end procedure.
      544   procedure lineattr-write-parts :
      545     do
      546     on error undo, return error return-value
      547     :
      548       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      549       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      550       define input parameter p-part-code  as character no-undo .
      551       define input parameter p_in-code    as character no-undo .
      552       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      553       define input parameter p-value      as decimal   no-undo .
      554       define buffer buf_doc-line-attr for ub.doc-line-attr .
      555       find first buf_doc-line-attr exclusive-lock
      556         where buf_doc-line-attr.doc-code  = p-doc-code
      557           and buf_doc-line-attr.gds-code  = p-gds-code
      558           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      559         no-error .
      560       if not available buf_doc-line-attr then do:
      561         create buf_doc-line-attr .
      562         assign
      563           buf_doc-line-attr.doc-code  = p-doc-code
      564           buf_doc-line-attr.gds-code  = p-gds-code
      565           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      566         .
      567       end.
      568       assign
      569         buf_doc-line-attr.attr-value = string( p-value )
      570       .
      571     end.
      572   end procedure.
      573   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      575   define  shared variable RepPathName        as character no-undo .
      576   define  shared variable PrintRubl          as logical   no-undo .
      577   define input parameter parparentproc AS WIDGET-HANDLE        NO-UNDO.
      578   define input parameter pardoc-code   like ub.trn-doc.doc-code   no-undo.
      579   define input parameter partot-other  like ub.trn-doc.tot-transp  no-undo.
      580   define input parameter partot-transp like ub.trn-doc.tot-transp no-undo.
      581   define variable v-insalepr as logical   no-undo .
      582   define variable varhost-code like ub.trn-doc.obj-code no-undo.
      583   define variable v-method as character no-undo .
      584   define variable varvalue as character no-undo .
      585   define variable vartype  as character no-undo .
      586   define variable  partot-other-base  like ub.trn-doc.tot-transp  no-undo.
      587   define variable  partot-transp-base like ub.trn-doc.tot-transp no-undo.
      588   define variable  partot-other-rubl  like ub.trn-doc.tot-transp  no-undo.
      589   define variable  partot-transp-rubl like ub.trn-doc.tot-transp no-undo.
      590   define variable v-ves     as decimal   no-undo  init 0.
      591   define variable v-wt-base as decimal   no-undo init 0 .
      592   define variable g#report-num as integer   no-undo .
      593   define stream  errStream  .
      594   define variable v-old-other as character no-undo .
      595   define variable v-old-other-type as character no-undo .
      596   define variable v-old-other-rubl as decimal   no-undo .
      597   define variable v-old-other-base as decimal   no-undo .
      598   define variable v-old-tr-rubl as decimal   no-undo .
      599   define variable v-old-tr-base as decimal   no-undo .
      600   run get-report-num   in parParentProc ( output g#report-num ) .
      601   define variable v-exis as logical no-undo .
      602   define variable v-txt as character no-undo .
      603   find first ub.trn-doc where ub.trn-doc.doc-code = pardoc-code no-lock no-error.
      604   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      606     (input  ub.trn-doc.obj-type
      607     ,input  ub.trn-doc.obj-code
      608     ,output varhost-code
      609     )  .
      610   if not available ub.trn-doc then do:
      611      message "Не найден документ с кодом: " pardoc-code
      612      view-as alert-box.
      613      return error.
      614   end.
      615   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
      616                           input 'm_inc':U ,
      617                          output varvalue ,
      618                          output vartype )  .
      619      if int(varvalue) > 0 then do:
      620        assign
      621          v-method = varvalue.
      622      end.
      623      else do:
      624        assign
      625          v-method = "1".
      626      end.
      627   if v-method = "4" then do:
      628   output stream errStream to value( string( session:temp-directory +
      629                                        "rpt" + string( g#report-num ) ) )
      630                                        page-size 62 .
      631       v-exis = false .
      632      for each ub.doc-line no-lock where ub.doc-line.doc-code = pardoc-code :
      633          find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
      634                                 ub.goods.prod-type = ub.doc-line.prod-type and
      635                                 ub.goods.prod-code = ub.doc-line.prod-code no-lock.
      636          find first ub.units no-lock where ub.units.unit-name = ub.goods.unit-base  .
      637          if  ub.units.type = 'вес':U then do:
      638              v-wt-base = ub.doc-line.fact-qnty.
      639          end.
      640          else do:
      641            v-wt-base = ub.goods.wt-base * ub.doc-line.fact-qnty.
      642            if v-wt-base = ? or v-wt-base = 0 then do:
      643               Put  stream  errStream
      644                            ub.goods.artic " " ub.goods.gds-code " " ub.goods.gds-name  skip .
      645               v-exis = true.
      646            end.
      647          end.
      648          v-ves =  v-ves + v-wt-base  .
      649      end.
      650       if v-exis = true then do:
      651           define variable v-user-action   as character no-undo .
      652           define variable v-printed       as logical no-undo .
      653             message
      654             "Обнаружены товары без проставленного веса за штуку ! " skip
      655             "Вы можете просмотреть и распечатать их список . "      skip
      656             "Редактирование веса в карточке товара . "      skip
      657             view-as alert-box error .
      658         Output stream errStream   close .
      659           run gbl/prnfilen.w
      660             (input  "Товары без веса"
      661             ,input  0
      662             ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      663             ,input 7
      664             ,output v-user-action
      665             ,output v-printed
      666             ) .
      667             if not ( lookup( ' экран':L, v-user-action ,";")  > 0 or
      668                       lookup( ' принтер':L, v-user-action ,";")  > 0  ) then do:
      669                         message "Внимание , вы не просмотрели список товаров ! "  .
      670                       end.
      671             return error.
      672       end.
      673   end.
      674   if partot-other  = ? then partot-other  = 0.
      675   if partot-transp = ? then partot-transp = 0.
      676   assign
      677     partot-other-rubl  =  partot-other
      678     partot-transp-rubl =  partot-transp
      679     partot-other-base  =  partot-other-rubl   * ub.trn-doc.base-scale / ub.trn-doc.base-rate
      680     partot-transp-base =  partot-transp-rubl  * ub.trn-doc.base-scale / ub.trn-doc.base-rate
      681     .
      682   tr:
      683   do transaction
      684      ON ERROR   UNDO tr, LEAVE
      685      ON END-KEY UNDO tr, LEAVE
      686      ON STOP    UNDO tr , LEAVE :
      687      for each ub.doc-line
      688        where ub.doc-line.doc-code = pardoc-code
      689      :
      690          find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
      691                                 ub.goods.prod-type = ub.doc-line.prod-type and
      692                                 ub.goods.prod-code = ub.doc-line.prod-code no-lock.
      693          find first ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
      694   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      696     (input  ub.doc-line.obj-type
      697     ,input  ub.doc-line.obj-code
      698     ,input  ub.doc-line.artic
      699     ,input  ub.doc-line.prod-type
      700     ,input  ub.doc-line.prod-code
      701     ,input  'insalepr=request':U
      702     ,output v-insalepr
      703     )  .
      704          if v-insalepr = true then do:
      705             undo tr, return error "В накладной " + string(ub.doc-line.doc-code) + " имеется товар " + string(ub.goods.artic) + " "
      706                                   + string(ub.goods.prod-type) + " " + string(ub.goods.prod-code) + " принимаемый по продажной цене." +
      707                                   " Недопустимы транспортные и прочие расходы.".
      708          end.
      709          if ub.doc-line.transport-rubl = ? then ub.doc-line.transport-rubl = 0.
      710          if ub.doc-line.transport-base = ? then ub.doc-line.transport-base = 0.
      711          if ub.doc-line.other-rubl     = ? then ub.doc-line.other-rubl     = 0.
      712          if ub.doc-line.other-base     = ? then ub.doc-line.other-base     = 0.
      713          if ub.units.type = 'вес':U then do:
      714              v-wt-base = ub.doc-line.fact-qnty.
      715          end.
      716          else do:
      717            v-wt-base = ub.goods.wt-base * ub.doc-line.fact-qnty.
      718           end.
      719           run lineattr-value in this-procedure (
      720               ub.doc-line.doc-code ,
      721               ub.goods.gds-code    ,
      722               'old_other-ras':U ,
      723               output v-old-other       ,
      724               output v-old-other-type
      725               ) no-error .
      726           if error-status :error then do:
      727             v-old-other-rubl = 0 .
      728             v-old-other-base = 0 .
      729             v-old-tr-rubl    = 0 .
      730             v-old-tr-base    = 0 .
      731           end.
      732           else do:
      733             v-old-other-rubl = decimal ( entry ( 1 , v-old-other,chr(4) )) no-error .
      734             v-old-other-base = decimal ( entry ( 2 , v-old-other,chr(4) )) no-error .
      735             v-old-other-rubl = decimal ( entry ( 3 , v-old-other,chr(4) )) no-error .
      736             v-old-other-base = decimal ( entry ( 4 , v-old-other,chr(4) )) no-error .
      737           end.
      738           ub.doc-line.other-rubl = ub.doc-line.other-rubl - v-old-other-rubl .
      739           ub.doc-line.other-base = ub.doc-line.other-base - v-old-other-base .
      740           ub.doc-line.transport-rubl = ub.doc-line.transport-rubl - v-old-tr-rubl .
      741           ub.doc-line.transport-base = ub.doc-line.transport-base - v-old-tr-base .
      742     case v-method :
      743     when "1"  then do:
      744                ub.doc-line.price-rubl     = ub.doc-line.price-rubl - ub.doc-line.transport-rubl - ub.doc-line.other-rubl .
      745                ub.doc-line.price-base     = ub.doc-line.price-base - ub.doc-line.transport-base - ub.doc-line.other-base .
      746                ub.doc-line.transport-base = ub.doc-line.price-base * partot-transp / ub.trn-doc.tot-sale              .
      747                ub.doc-line.transport-rubl = ub.doc-line.price-rubl * partot-transp / ub.trn-doc.tot-sale              .
      748                ub.doc-line.other-base     = ub.doc-line.price-base * partot-other  / ub.trn-doc.tot-sale              .
      749                ub.doc-line.other-rubl     = ub.doc-line.price-rubl * partot-other  / ub.trn-doc.tot-sale              .
      750                ub.doc-line.price-rubl     = ub.doc-line.price-rubl + ub.doc-line.transport-rubl + ub.doc-line.other-rubl .
      751                ub.doc-line.price-base     = ub.doc-line.price-base + ub.doc-line.transport-base + ub.doc-line.other-base.
      752     end.
      753     when "2"  then do:
      754                ub.doc-line.price-rubl     =  ub.doc-line.price-rubl - ub.doc-line.transport-rubl - ub.doc-line.other-rubl .
      755                ub.doc-line.price-base     =  ub.doc-line.price-base - ub.doc-line.transport-base - ub.doc-line.other-base .
      756                ub.doc-line.transport-base = (ub.doc-line.fact-qnty * partot-transp-base / ub.trn-doc.fact-qnty ) / ub.doc-line.fact-qnty .
      757                ub.doc-line.transport-rubl = (ub.doc-line.fact-qnty * partot-transp-rubl / ub.trn-doc.fact-qnty ) / ub.doc-line.fact-qnty .
      758                ub.doc-line.other-base     = (ub.doc-line.fact-qnty * partot-other-base  / ub.trn-doc.fact-qnty ) / ub.doc-line.fact-qnty .
      759                ub.doc-line.other-rubl     = (ub.doc-line.fact-qnty * partot-other-rubl  / ub.trn-doc.fact-qnty ) / ub.doc-line.fact-qnty .
      760                ub.doc-line.price-rubl     =  ub.doc-line.price-rubl + ub.doc-line.transport-rubl + ub.doc-line.other-rubl .
      761                ub.doc-line.price-base     =  ub.doc-line.price-base + ub.doc-line.transport-base + ub.doc-line.other-base .
      762     end.
      763     when "3"  then do:
      764          assign
      765                ub.doc-line.price-rubl     = ub.doc-line.price-rubl - ub.doc-line.transport-rubl - ub.doc-line.other-rubl
      766                ub.doc-line.price-base     = ub.doc-line.price-base - ub.doc-line.transport-base - ub.doc-line.other-base
      767                ub.doc-line.transport-base = (ub.doc-line.cli-qnty * partot-transp-base / ub.trn-doc.cli-qnty ) / ub.doc-line.fact-qnty
      768                ub.doc-line.transport-rubl = (ub.doc-line.cli-qnty * partot-transp-rubl / ub.trn-doc.cli-qnty ) / ub.doc-line.fact-qnty
      769                ub.doc-line.other-base     = (ub.doc-line.cli-qnty * partot-other-base  / ub.trn-doc.cli-qnty ) / ub.doc-line.fact-qnty
      770                ub.doc-line.other-rubl     = (ub.doc-line.cli-qnty * partot-other-rubl  / ub.trn-doc.cli-qnty ) / ub.doc-line.fact-qnty
      771                ub.doc-line.price-rubl     = ub.doc-line.price-rubl + ub.doc-line.transport-rubl + ub.doc-line.other-rubl
      772                ub.doc-line.price-base     = ub.doc-line.price-base + ub.doc-line.transport-base + ub.doc-line.other-base.
      773     end.
      774     when "4"  then do:
      775          assign
      776                ub.doc-line.price-rubl     = ub.doc-line.price-rubl - ub.doc-line.transport-rubl - ub.doc-line.other-rubl
      777                ub.doc-line.price-base     = ub.doc-line.price-base - ub.doc-line.transport-base - ub.doc-line.other-base
      778                ub.doc-line.transport-base = (v-wt-base *  partot-transp-base / v-ves ) / ub.doc-line.fact-qnty
      779                ub.doc-line.transport-rubl = (v-wt-base *  partot-transp-rubl / v-ves ) / ub.doc-line.fact-qnty
      780                ub.doc-line.other-base     = (v-wt-base *  partot-other-base  / v-ves ) / ub.doc-line.fact-qnty
      781                ub.doc-line.other-rubl     = (v-wt-base *  partot-other-rubl  / v-ves ) / ub.doc-line.fact-qnty
      782                ub.doc-line.price-rubl     = ub.doc-line.price-rubl + ub.doc-line.transport-rubl + ub.doc-line.other-rubl
      783                ub.doc-line.price-base     = ub.doc-line.price-base + ub.doc-line.transport-base + ub.doc-line.other-base.
      784     end.
      785     end case.
      786     run lineattr-write in this-procedure (
      787         ub.doc-line.doc-code ,
      788         ub.goods.gds-code    ,
      789         'old_other-ras':U ,
      790         string(ub.doc-line.other-rubl ) + chr(4) + string(ub.doc-line.other-base ) + chr(4) +
      791         string(ub.doc-line.transport-rubl ) + chr(4) + string(ub.doc-line.transport-base )
      792         ) no-error .
      793         if error-status :error then
      794         message
      795           vss-workfile vss-revision vss-description skip
      796           error-status :get-message(1) skip
      797           return-value skip
      798           "Ошибка "
      799           view-as alert-box error
      800         .
      801          run trg/partsupd.p
      802            (input parparentproc
      803            ,input ub.trn-doc.doc-code
      804            ,input ub.trn-doc.obj-type
      805            ,input ub.trn-doc.obj-code
      806            ,input ub.doc-line.artic
      807            ,input ub.doc-line.prod-type
      808            ,input ub.doc-line.prod-code
      809            ,input true
      810            ,input ""
      811            ) no-error.
      812         if error-status:error then do:
      813            undo tr, return error "Ошибка при редактировании партий.".
      814         end.
      815      end.
      816      run gbl/calc-trn.p (input parparentproc, input recid(ub.trn-doc)) no-error.
      817      if error-status:error then undo tr, return error.
      818   end.
