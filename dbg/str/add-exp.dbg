        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: add-exp.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/add-exp.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define new global shared variable g#trdcalib as handle no-undo.
       70   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure lineattr-value :
       72     do
       73     on error undo, return error return-value
       74     :
       75       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       76       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       77       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       78       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       79       define output parameter p-type     as character no-undo .
       80       define buffer buf_doc-line-attr for ub.doc-line-attr .
       81       def var v-format         as character no-undo .
       82       def var v-fillin_width   as integer   no-undo .
       83       def var v-fillin_height  as integer   no-undo .
       84       def var v-label          as character no-undo .
       85       def var v-user-can-edit  as logical   no-undo .
       86       def var v-output-display as logical   no-undo .
       87       def var v-other          as character no-undo .
       88       run lineattr-code in this-procedure
       89         (input  p-code
       90         ,output p-type
       91         ,output v-format
       92         ,output v-fillin_width
       93         ,output v-fillin_height
       94         ,output v-label
       95         ,output v-user-can-edit
       96         ,output v-output-display
       97         ,output v-other
       98         ) no-error .
       99       if error-status :error then do:
      100         undo, return error return-value .
      101       end.
      102       find first buf_doc-line-attr no-lock
      103         where buf_doc-line-attr.doc-code  = p-doc-code
      104           and buf_doc-line-attr.gds-code  = p-gds-code
      105           and buf_doc-line-attr.attr-code = p-code
      106         no-error .
      107       if avail buf_doc-line-attr then do:
      108         assign
      109           p-value =  buf_doc-line-attr.attr-value
      110         .
      111       end.
      112       else do:
      113         assign
      114           p-value = if p-type = 'L':U then "no":U else ""
      115         .
      116       end.
      117     end.
      118   end procedure.
      119   procedure lineattr-write :
      120     do
      121     on error undo, return error return-value
      122     :
      123       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      124       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      125       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      126       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      127       define buffer buf_doc-line-attr for ub.doc-line-attr .
      128       def var v-type           as character no-undo .
      129       def var v-format         as character no-undo .
      130       def var v-fillin_width   as integer   no-undo .
      131       def var v-fillin_height  as integer   no-undo .
      132       def var v-label          as character no-undo .
      133       def var v-user-can-edit  as logical   no-undo .
      134       def var v-output-display as logical   no-undo .
      135       def var v-other          as character no-undo .
      136       run lineattr-code in this-procedure
      137         (input  p-code
      138         ,output v-type
      139         ,output v-format
      140         ,output v-fillin_width
      141         ,output v-fillin_height
      142         ,output v-label
      143         ,output v-user-can-edit
      144         ,output v-output-display
      145         ,output v-other
      146         ) no-error .
      147       if error-status :error then do:
      148         undo, return error return-value .
      149       end.
      150       find first buf_doc-line-attr exclusive-lock
      151         where buf_doc-line-attr.doc-code  = p-doc-code
      152           and buf_doc-line-attr.gds-code  = p-gds-code
      153           and buf_doc-line-attr.attr-code = p-code
      154         no-error .
      155       if not available buf_doc-line-attr then do:
      156         create buf_doc-line-attr .
      157         assign
      158           buf_doc-line-attr.doc-code  = p-doc-code
      159           buf_doc-line-attr.gds-code = p-gds-code
      160           buf_doc-line-attr.attr-code = p-code
      161         .
      162       end.
      163       assign
      164         buf_doc-line-attr.attr-value = p-value
      165       .
      166        release buf_doc-line-attr.
      167     end.
      168   end procedure.
      169   procedure lineattr-exist :
      170     do
      171     on error undo, return error return-value
      172     :
      173       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      174       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      175       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      176       define output parameter p-exist   as logical  no-undo .
      177       define buffer buf_doc-line-attr for ub.doc-line-attr .
      178       def var v-type           as character no-undo .
      179       def var v-format         as character no-undo .
      180       def var v-fillin_width   as integer   no-undo .
      181       def var v-fillin_height  as integer   no-undo .
      182       def var v-label          as character no-undo .
      183       def var v-user-can-edit  as logical   no-undo .
      184       def var v-output-display as logical   no-undo .
      185       def var v-other          as character no-undo .
      186       run lineattr-code in this-procedure
      187         (input  p-code
      188         ,output v-type
      189         ,output v-format
      190         ,output v-fillin_width
      191         ,output v-fillin_height
      192         ,output v-label
      193         ,output v-user-can-edit
      194         ,output v-output-display
      195         ,output v-other
      196         ) no-error .
      197       if error-status :error then do:
      198         undo, return error return-value .
      199       end.
      200       find first buf_doc-line-attr no-lock
      201         where buf_doc-line-attr.doc-code  = p-doc-code
      202           and buf_doc-line-attr.gds-code = p-gds-code
      203           and buf_doc-line-attr.attr-code = p-code
      204         no-error .
      205       if  available buf_doc-line-attr then do:
      206         p-exist = yes.
      207       end.
      208     end.
      209   end procedure.
      210   procedure lineattr-delete :
      211     do
      212     on error undo, return error return-value
      213     :
      214       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      215       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      216       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      217       define output parameter p-deleted  as logical no-undo.
      218       define buffer buf_doc-line-attr for ub.doc-line-attr .
      219       def var v-type           as character no-undo .
      220       def var v-format         as character no-undo .
      221       def var v-fillin_width   as integer   no-undo .
      222       def var v-fillin_height  as integer   no-undo .
      223       def var v-label          as character no-undo .
      224       def var v-user-can-edit  as logical   no-undo .
      225       def var v-output-display as logical   no-undo .
      226       def var v-other          as character no-undo .
      227       run lineattr-code in this-procedure
      228         (input  p-code
      229         ,output v-type
      230         ,output v-format
      231         ,output v-fillin_width
      232         ,output v-fillin_height
      233         ,output v-label
      234         ,output v-user-can-edit
      235         ,output v-output-display
      236         ,output v-other
      237         ) no-error .
      238       if error-status :error then do:
      239         undo, return error return-value .
      240       end.
      241       find first buf_doc-line-attr exclusive-lock
      242         where buf_doc-line-attr.doc-code  = p-doc-code
      243           and buf_doc-line-attr.gds-code  = p-gds-code
      244           and buf_doc-line-attr.attr-code = p-code
      245         no-error NO-WAIT.
      246       if not available buf_doc-line-attr then do:
      247         p-deleted = no.
      248       end.
      249       else do:
      250         delete buf_doc-line-attr.
      251         p-deleted = yes.
      252       end.
      253     end.
      254   end procedure.
      255   procedure lineattr-code :
      256     do on error undo, return error return-value
      257     :
      258       define input  parameter p-code           as character no-undo .
      259       define output parameter p-type           as character no-undo .
      260       define output parameter p-format         as character no-undo .
      261       define output parameter p-fillin_width   as integer   no-undo .
      262       define output parameter p-fillin_height  as integer   no-undo .
      263       define output parameter p-label          as character no-undo .
      264       define output parameter p-user-can-edit  as logical   no-undo .
      265       define output parameter p-output-display as logical   no-undo .
      266       define output parameter p-other          as character no-undo .
      267       case p-code :
      268               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      269               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      270               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      271               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      272               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      273               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      274               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      275               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      276               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      277               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      278               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      279         otherwise do:
      280           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      281         end.
      282       end.
      283     end.
      284   end procedure.
      285   procedure lineattr-value-flora-gds :
      286     do
      287     on error undo, return error return-value
      288     :
      289       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      290       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      291       define input  parameter p-prt-code    as integer   no-undo .
      292       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      293       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      294       define output parameter p-value       as    decimal   no-undo .
      295       define buffer buf_doc-line-attr for ub.doc-line-attr .
      296       find first buf_doc-line-attr no-lock
      297         where buf_doc-line-attr.doc-code  = p-doc-code
      298           and buf_doc-line-attr.gds-code  = p-gds-code
      299           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      300         no-error .
      301       if avail buf_doc-line-attr then do:
      302         assign
      303           p-value = decimal( buf_doc-line-attr.attr-value)
      304         .
      305       end.
      306       else do:
      307         assign
      308           p-value = 0
      309         .
      310       end.
      311     end.
      312   end procedure.
      313   procedure lineattr-write-flora-gds :
      314     do
      315     on error undo, return error return-value
      316     :
      317       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      318       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      319       define input parameter p-prt-code    as integer   no-undo .
      320       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      321       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      322       define input parameter p-value    as decimal   no-undo .
      323       define buffer buf_doc-line-attr for ub.doc-line-attr .
      324       find first buf_doc-line-attr exclusive-lock
      325         where buf_doc-line-attr.doc-code  = p-doc-code
      326           and buf_doc-line-attr.gds-code  = p-gds-code
      327           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      328         no-error .
      329       if not available buf_doc-line-attr then do:
      330         create buf_doc-line-attr .
      331         assign
      332           buf_doc-line-attr.doc-code  = p-doc-code
      333           buf_doc-line-attr.gds-code  = p-gds-code
      334           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      335         .
      336       end.
      337       assign
      338         buf_doc-line-attr.attr-value = string( p-value )
      339       .
      340     end.
      341   end procedure.
      342   procedure lineattr-delete-flora-gds :
      343     do
      344     on error undo, return error return-value
      345     :
      346       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      347       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      348       define input  parameter p-prt-code    as integer   no-undo .
      349       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      350       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      351       define output parameter p-deleted  as logical no-undo.
      352       define buffer buf_doc-line-attr for ub.doc-line-attr .
      353       find first buf_doc-line-attr exclusive-lock
      354         where buf_doc-line-attr.doc-code  = p-doc-code
      355           and buf_doc-line-attr.gds-code  = p-gds-code
      356           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      357         no-error NO-WAIT.
      358       if not available buf_doc-line-attr then do:
      359         p-deleted = no.
      360       end.
      361       else do:
      362         delete buf_doc-line-attr.
      363         p-deleted = yes.
