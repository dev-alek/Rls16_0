        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Экран финансовых обязательств по удаленному документу".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   DEFINE INPUT PARAMETER pardoc-code LIKE ub.c-trn-doc.doc-code NO-UNDO.
      111   define input parameter parchip-num like ub.c-trn-doc.chip-num no-undo.
      112   DEFINE TEMP-TABLE tt-fo-before NO-UNDO LIKE ub.fin-ob-before
      113   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      114   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      115   DEFINE BUFFER bf_fin-ob-before   FOR ub.fin-ob-before.
      116   DEFINE BUFFER bf_fin-gds-part  FOR ub.fin-gds-part.
      117   DEFINE BUFFER bf_c-parts         FOR ub.c-parts.
      118   DEFINE BUFFER bf_c-trn-doc       FOR ub.c-trn-doc.
      119   define buffer bf_goods           for ub.goods.
      120   DEFINE BUTTON b-exit AUTO-GO
      121        LABEL "&Выход"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON b-help
      125        LABEL "Помо&щь"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE QUERY b-ob FOR
      129         tt-fo-before SCROLLING.
      130   DEFINE QUERY b-parts FOR
      131         bf_fin-gds-part,
      132         bf_goods,
      133         bf_c-parts SCROLLING.
      134   DEFINE BROWSE b-ob
      135     QUERY b-ob DISPLAY
      136         tt-fo-before.prn-doc-code  COLUMN-LABEL "Предфиноб."
      137     tt-fo-before.sum-base      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      138     tt-fo-before.sum-base-trn  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      139     tt-fo-before.sum-rubl      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      140     tt-fo-before.sum-rubl-trn  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      141     tt-fo-before.contract-code COLUMN-LABEL "Договор"
      142     tt-fo-before.doc-code      COLUMN-LABEL "Вн. код. фин. обяз."
      143     tt-fo-before.before-code   COLUMN-LABEL "Вн. код. предфин. обяз."
      144       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 9
      145            TITLE "Предфинобязательства" ROW-HEIGHT-CHARS .67.
      146   DEFINE BROWSE b-parts
      147     QUERY b-parts DISPLAY
      148         bf_c-parts.in-code COLUMN-LABEL "Прих. накл."
      149    bf_c-parts.part-code COLUMN-LABEL "Код партии"
      150    bf_c-parts.fact-qnty COLUMN-LABEL "Факт кол-во"
      151    bf_c-parts.price-base COLUMN-LABEL "Цена (вал)"
      152    bf_c-parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      153       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 9
      154            TITLE "Партии по предфинобязательству" ROW-HEIGHT-CHARS .67.
      155   DEFINE FRAME Dialog-Frame
      156        b-exit AT ROW 1 COL 1
      157        b-help AT ROW 1 COL 11
      158        b-ob AT ROW 2.25 COL 1
      159        b-parts AT ROW 11.5 COL 1
      160        SPACE(0.00) SKIP(0.50)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Предфинобязательства на которые повлиял данный удаленный складской документ"
      164            DEFAULT-BUTTON b-exit.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON VALUE-CHANGED OF b-ob IN FRAME Dialog-Frame
      173   DO:
      174     RUN open-parts-query IN THIS-PROCEDURE.
      175   END.
      176   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      177   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      178   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   on help of frame Dialog-Frame
      180   do:
      181     run gbl/app_help.p
      182       (input this-procedure :file-name
      183       ,input ''
      184       ,input ?
      185       ) no-error.
      186     if error-status :error then do:
      187       message
      188         "Ошибка при вызове помощи"
      189         error-status :get-message(1)
      190         view-as alert-box .
      191     end.
      192   end.
      193   run minbtn-set in this-procedure .
      194   on choose of b-help in frame Dialog-Frame
      195   do:
      196     apply "help":u to frame Dialog-Frame .
      197   end.
      198   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   procedure minbtn-set :
      200       do
      201           on error undo, return error return-value
      202           :
      203           define variable ii              as integer       no-undo .
      204           define variable fh              as widget-handle no-undo .
      205           define variable hh              as widget-handle no-undo .
      206           define variable v-h             as handle        extent 4 no-undo .
      207           define variable v-name-button   as character     no-undo .
      208           define variable v-help-old-x    as decimal       no-undo .
      209           define variable v-help-old-y    as decimal       no-undo .
      210           define variable v-help-old-size as decimal       no-undo .
      211           define variable v-frame-width   as decimal       no-undo .
      212           define variable jj              as integer       no-undo .
      213           do
      214               on error undo, return error
      215               :
      216               assign
      217                   v-frame-width = frame Dialog-Frame:width - 0.3
      218                   fh            = frame Dialog-Frame:first-child
      219                   hh            = fh:first-child
      220                   ii            = 1
      221                   .
      222               do while valid-handle(hh):
      223                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      224                   do:
      225                       case lc(hh:name) :
      226                           when "b-help" then
      227                               do:
      228                                   hh:load-image-up("cmp/b-help.bmp":u) .
      229                                   hh:load-image-down("cmp/b-help.bmp":u) .
      230                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      231                                   hh:TOOLTIP = "Помощь" .
      232                                   v-help-old-x = hh:column .
      233                                   v-help-old-y = hh:row    .
      234                                   v-help-old-size = hh:width .
      235                                   hh:width-chars = 2.5 .
      236                               end.
      237                           when "b-print" then
      238                               do:
      239                                   hh:load-image("cmp/b-print.bmp":u) .
      240                                   hh:TOOLTIP = "Печать" .
      241                                   v-h[ii] = hh:handle .
      242                                   ii = ii + 1 .
      243                                   hh:width-chars = 3 .
      244                               end.
      245                           when "b-history" or
      246                           when "b-hist" then
      247                               do:
      248                                   hh:load-image("cmp/b-hist.bmp":u) .
      249                                   hh:TOOLTIP = "История" .
      250                                   v-h[ii] = hh:handle .
      251                                   ii = ii + 1 .
      252                                   hh:width-chars = 3 .
      253                               end.
      254                           when "b-sch" then
      255                               do:
      256                                   hh:load-image("cmp/b-sch.bmp":u) .
      257                                   hh:TOOLTIP = "Установка Фильтра" .
      258                                   v-h[ii] = hh:handle .
      259                                   ii = ii + 1 .
      260                                   hh:width-chars = 3 .
      261                               end.
      262                           when "b-hist-user" then
      263                               do:
      264                                   hh:load-image("cmp/b-hist.bmp":u) .
      265                                   hh:TOOLTIP = "История пользователя" .
      266                                   ii = ii + 1 .
      267                               end.
      268                       end case.
      269                   end.
      270                   hh = hh:next-sibling.
      271               end.
      272               b-help:column = v-frame-width - b-help:width-chars.
      273               jj = 0.
      274               repeat ii = 4 to 1 by -1 :
      275                   if valid-handle (v-h[ii] ) then
      276                   do:
      277                       jj  = jj + 1 .
      278                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      279                       v-h[ii]:row    = v-help-old-y .
      280                   end.
      281               end.
      282           end.
      283       end.
      284   end procedure.
      285   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      286   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      287   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      288   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      289   define variable v-diasize-current-frame-width  as decimal   no-undo .
      290   define variable v-diasize-current-frame-height as decimal   no-undo .
      291   define variable v-diasize-change-size          as logical   no-undo .
      292   define variable v-diasize-resize-button        as handle    no-undo .
      293   define variable v-diasize-wndmax               as logical   no-undo .
      294   define variable v-diasize-wndstore             as logical   no-undo .
      295   define variable v-diasize-proc-name            as character no-undo .
      296   define variable v-diasize-browse-handle        as handle    no-undo .
      297   define variable v-diasize-browse-number        as integer   no-undo .
      298   define variable v-diasize-need-full-display    as logical   no-undo init false .
      299   define temp-table temp-diasize-handle no-undo
      300     field handle-value  as handle
      301     field save-position as decimal
      302     index xpk is primary unique handle-value
      303     .
      304   define temp-table temp-browse-handle no-undo
      305     field browse-type   as character
      306     field browse-number as integer
      307     field browse-handle as handle
      308     field original-size as decimal
      309     index xpk is primary unique browse-type browse-number
      310     index xie browse-type browse-handle
      311   .
      312   procedure diasize_change-height :
      313     define input  parameter p-change-value  as decimal   no-undo .
      314     define input  parameter p-move-resize   as logical   no-undo .
      315     define variable v-field-group-handle    as handle    no-undo .
      316     define variable v-object-handle         as handle    no-undo .
      317     define variable v-frame-height          as decimal   no-undo .
      318     define variable v-frame-virtual-height  as decimal   no-undo .
      319     define variable v-browse-height         as decimal   no-undo .
      320     define variable v-window-height         as decimal   no-undo .
      321     define variable v-window-virtual-height as decimal   no-undo .
      322     define variable v-change-sign           as integer   no-undo .
      323     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      324     define buffer buf_temp-browse-handle  for temp-browse-handle .
      325     if p-change-value > 0
      326     then do:
      327       if frame Dialog-Frame :height + p-change-value
      328           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      329       then do:
      330         assign
      331           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      332                           - (frame Dialog-Frame :height-chars)
      333         .
      334         if p-change-value <= 0
      335         then do:
      336           run diasize_position-resize-button in this-procedure .
      337           return .
      338         end.
      339       end.
      340     end.
      341     if p-change-value < 0
      342     then do:
      343       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      344       then do:
      345         assign
      346           p-change-value = v-diasize-orig-frame-height
      347                          - (frame Dialog-Frame :height-chars)
      348         .
      349         if p-change-value >= 0
      350         then do:
      351           run diasize_position-resize-button in this-procedure .
      352           return .
      353         end.
      354       end.
      355     end.
      356     if p-change-value >= 0
      357     then do:
      358       assign
      359         v-change-sign = 1
      360       .
      361     end.
      362     else do:
      363       assign
      364         v-change-sign = -1
      365       .
      366     end.
      367     assign
      368       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      369     .
      370     if p-change-value = 0
      371     then do:
      372       run diasize_position-resize-button in this-procedure .
      373       return .
      374     end.
      375     move_block:
      376     do
      377     on error undo move_block, retry move_block
      378     :
      379       if retry
      380       then do:
      381         do
      382         on error undo move_block, leave move_block
      383         :
      384           if p-change-value > 0
      385           then do:
      386             for each buf_temp-diasize-handle
      387             on error undo, next
      388             :
      389               assign
      390                 v-object-handle = buf_temp-diasize-handle.handle-value
      391               .
      392               if v-object-handle <> v-diasize-resize-button
      393               then do:
      394                 assign
      395                   v-object-handle :row = buf_temp-diasize-handle.save-position
      396                 .
      397               end.
      398             end.
      399             assign
      400               v-diasize-browse-handle :height = v-browse-height
      401             .
      402             for each buf_temp-browse-handle
      403               where buf_temp-browse-handle.browse-type = 'height':u
      404             on error undo, next
      405             :
      406               assign
      407                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      408               .
      409             end.
      410             assign
      411               frame Dialog-Frame :height = v-frame-height
      412             .
      413             if frame Dialog-Frame :scrollable = true
      414             then do:
      415               assign
      416                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      417               .
      418             end.
      419             run diasize_position-resize-button in this-procedure .
      420           end.
      421           else do:
      422             if frame Dialog-Frame :scrollable = true
      423             then do:
      424               assign
      425                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      426               .
      427             end.
      428             assign
      429               frame Dialog-Frame :height = v-frame-height
      430             .
      431             assign
      432               v-diasize-browse-handle :height = v-browse-height
      433             .
      434             for each buf_temp-browse-handle
      435               where buf_temp-browse-handle.browse-type = 'height':u
      436             on error undo, next
      437             :
      438               assign
      439                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      440               .
      441             end.
      442             for each buf_temp-diasize-handle
      443             on error undo, next
      444             :
      445               assign
      446                 v-object-handle = buf_temp-diasize-handle.handle-value
      447               .
      448               if v-object-handle <> v-diasize-resize-button
      449               then do:
      450                 assign
      451                   v-object-handle :row = buf_temp-diasize-handle.save-position
      452                 .
      453               end.
      454             end.
      455             run diasize_position-resize-button in this-procedure .
      456           end.
      457           assign
      458             v-diasize-change-size = false
      459           .
      460           leave move_block .
      461         end.
      462       end.
      463       assign
      464         v-diasize-need-full-display = true
      465       .
      466       if v-diasize-change-size = false
      467       then do:
      468         assign
      469           v-diasize-change-size = true
      470         .
      471       end.
      472       else do:
      473         return .
      474       end.
      475       assign
      476         v-frame-height = frame Dialog-Frame :height
      477         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      478         v-browse-height = v-diasize-browse-handle :height
      479       .
      480       for each buf_temp-browse-handle
      481         where buf_temp-browse-handle.browse-type = 'height':u
      482       :
      483         assign
      484           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      485         .
      486       end.
      487       for each buf_temp-diasize-handle
      488       :
      489         delete buf_temp-diasize-handle .
      490       end.
      491       assign
      492         v-field-group-handle = frame Dialog-Frame :first-child
      493       .
      494       do while valid-handle(v-field-group-handle)
      495       :
      496         assign
      497           v-object-handle = v-field-group-handle :first-child
      498         .
      499         do while valid-handle(v-object-handle)
      500         :
      501           if  v-object-handle <> v-diasize-browse-handle :handle
      502           and can-query(v-object-handle, "row")
      503           and can-query(v-object-handle, "height")
      504           and ( v-object-handle :row > v-diasize-browse-handle :row )
      505           then do:
      506             find first buf_temp-browse-handle
      507               where buf_temp-browse-handle.browse-type   = 'height':u
      508                 and buf_temp-browse-handle.browse-handle = v-object-handle
      509               no-error .
      510             if available buf_temp-browse-handle
      511             then do:
      512             end.
      513             else do:
      514               create buf_temp-diasize-handle .
      515               assign
      516                 buf_temp-diasize-handle.handle-value  = v-object-handle
      517                 buf_temp-diasize-handle.save-position = v-object-handle :row
      518               .
      519             end.
      520           end.
      521           assign
      522             v-object-handle = v-object-handle :next-sibling
      523           .
      524         end.
      525         assign
      526           v-field-group-handle = v-field-group-handle :next-sibling
      527         .
      528       end.
      529       do with frame Dialog-Frame
      530       :
      531         hide v-diasize-resize-button .
      532         assign
      533           v-diasize-resize-button :row    = 1
      534           v-diasize-resize-button :column = 1
      535         .
      536       end.
      537       if p-change-value > 0
      538       then do:
      539         if frame Dialog-Frame :scrollable = true
      540         then do:
      541           assign
      542             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      543             no-error .
      544           if error-status :error
      545           or error-status :get-message(1) <> ""
      546           then do:
      547             undo move_block, retry move_block .
      548           end.
      549         end.
      550         assign
      551           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      552           no-error .
      553         if error-status :error
      554         or error-status :get-message(1) <> ""
      555         then do:
      556           undo move_block, retry move_block .
      557         end.
      558         assign
      559           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      560           no-error .
      561         if error-status :error
      562         or error-status :get-message(1) <> ""
      563         then do:
      564           undo move_block, retry move_block .
      565         end.
      566         for each buf_temp-browse-handle
      567           where buf_temp-browse-handle.browse-type = 'height':u
      568         on error undo move_block, retry move_block
      569         :
      570           assign
      571             buf_temp-browse-handle.browse-handle :height
      572               = buf_temp-browse-handle.browse-handle :height + p-change-value
      573             no-error .
      574           if error-status :error
      575           or error-status :get-message(1) <> ""
      576           then do:
      577             undo move_block, retry move_block .
      578           end.
      579         end.
      580         for each buf_temp-diasize-handle
      581         on error undo move_block, retry move_block
      582         :
      583           assign
      584             v-object-handle = buf_temp-diasize-handle.handle-value
      585           .
      586           if v-object-handle <> v-diasize-resize-button
      587           then do:
      588             assign
      589               v-object-handle :row = v-object-handle :row + p-change-value
      590               no-error .
      591             if error-status :error
      592             or error-status :get-message(1) <> ""
      593             then do:
      594               undo move_block, retry move_block .
      595             end.
      596           end.
      597         end.
      598       end.
      599       else do:
      600         for each buf_temp-diasize-handle
      601         on error undo move_block, retry move_block
      602         :
      603           assign
      604             v-object-handle = buf_temp-diasize-handle.handle-value
      605           .
      606           if v-object-handle <> v-diasize-resize-button
      607           then do:
      608             assign
      609               v-object-handle :row = v-object-handle :row + p-change-value
      610               no-error .
      611             if error-status :error
      612             or error-status :get-message(1) <> ""
      613             then do:
      614               undo move_block, retry move_block .
      615             end.
      616           end.
      617         end.
      618         assign
      619           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      620           no-error .
      621         if error-status :error
      622         or error-status :get-message(1) <> ""
      623         then do:
      624           undo move_block, retry move_block .
      625         end.
      626         for each buf_temp-browse-handle
      627           where buf_temp-browse-handle.browse-type = 'height':u
      628         on error undo move_block, retry move_block
      629         :
      630           assign
      631             buf_temp-browse-handle.browse-handle :height
      632               = buf_temp-browse-handle.browse-handle :height + p-change-value
      633             no-error .
      634           if error-status :error
      635           or error-status :get-message(1) <> ""
      636           then do:
      637             undo move_block, retry move_block .
      638           end.
      639         end.
      640         assign
      641           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      642           no-error .
      643         if error-status :error
      644         or error-status :get-message(1) <> ""
      645         then do:
      646           undo move_block, retry move_block .
      647         end.
      648         if frame Dialog-Frame :scrollable = true
      649         then do:
      650           assign
      651             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      652             no-error .
      653           if error-status :error
      654           or error-status :get-message(1) <> ""
      655           then do:
      656             undo move_block, retry move_block .
      657           end.
      658         end.
      659       end.
      660       if p-move-resize = true
      661       then do:
      662         run diasize_position-resize-button in this-procedure .
      663       end.
      664       if v-diasize-wndstore = true
      665       then do:
      666         if connected("ub") = true
      667         then do:
      668           define variable v-cntxt-db-num        as integer   no-undo .
      669           define variable v-cntxt-userid        as character no-undo .
      670           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      671                                             , OUTPUT v-cntxt-userid
      672                                             ) .
      673           run gbl/wndsizew.p
      674             (input  v-cntxt-db-num
      675             ,input  v-cntxt-userid
      676             ,input  v-diasize-proc-name
      677             ,input  'height':u
      678             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      679             ) .
      680         end.
      681       end.
      682     end.
      683     assign
      684       v-diasize-change-size = false
      685     .
      686   end procedure.
      687   procedure diasize_set-height :
      688     define input  parameter p-new-height  as decimal   no-undo .
      689     define input  parameter p-move-resize as logical   no-undo .
      690     do
      691     on error undo, return error return-value
      692     :
      693       run diasize_change-height in this-procedure
      694         (input  (p-new-height - frame Dialog-Frame :height)
      695         ,input  p-move-resize
      696         ) .
      697     end.
      698   end procedure.
      699   procedure diasize_change-width :
      700     define input  parameter p-change-value as decimal   no-undo .
      701     define input  parameter p-move-resize  as logical   no-undo .
      702     define variable v-field-group-handle   as handle    no-undo .
      703     define variable v-object-handle        as handle    no-undo .
      704     define variable v-frame-width          as decimal   no-undo .
      705     define variable v-frame-virtual-width  as decimal   no-undo .
      706     define variable v-browse-width         as decimal   no-undo .
      707     define variable v-window-width         as decimal   no-undo .
      708     define variable v-window-virtual-width as decimal   no-undo .
      709     define variable v-change-sign          as integer   no-undo .
      710     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      711     define buffer buf_temp-browse-handle  for temp-browse-handle .
      712     if p-change-value > 0
      713     then do:
      714       if frame Dialog-Frame :width + p-change-value >
      715           session :width-chars
      716       then do:
      717         assign
      718           p-change-value = session :width-chars - frame Dialog-Frame :width
      719         .
      720         if p-change-value <= 0
      721         then do:
      722           run diasize_position-resize-button in this-procedure .
      723           return .
      724         end.
      725       end.
      726     end.
      727     if p-change-value < 0
      728     then do:
      729       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      730       then do:
      731         assign
      732           p-change-value = v-diasize-orig-frame-width
      733                          - frame Dialog-Frame :width
      734         .
      735         if p-change-value >= 0
      736         then do:
      737           run diasize_position-resize-button in this-procedure .
      738           return .
      739         end.
      740       end.
      741     end.
      742     if p-change-value >= 0
      743     then do:
      744       assign
      745         v-change-sign = 1
      746       .
      747     end.
      748     else do:
      749       assign
      750         v-change-sign = -1
      751       .
      752     end.
      753     assign
      754       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      755     .
      756     if p-change-value = 0
      757     then do:
      758       run diasize_position-resize-button in this-procedure .
      759       return .
      760     end.
      761     move_block:
      762     do
      763     on error undo move_block, leave move_block
      764     :
      765       if retry
      766       then do:
      767         do
      768         on error undo move_block, leave move_block
      769         :
      770           if p-change-value > 0
      771           then do:
      772             for each buf_temp-diasize-handle
      773             on error undo, next
      774             :
      775               assign
      776                 v-object-handle = buf_temp-diasize-handle.handle-value
      777               .
      778               if v-object-handle <> v-diasize-resize-button
      779               then do:
      780                 assign
      781                   v-object-handle :col = buf_temp-diasize-handle.save-position
      782                 .
      783               end.
      784             end.
      785             assign
      786               v-diasize-browse-handle :width = v-browse-width
      787             .
      788             for each buf_temp-browse-handle
      789               where buf_temp-browse-handle.browse-type = 'width':u
      790             on error undo, next
      791             :
      792               assign
      793                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      794               .
      795             end.
      796             assign
      797               frame Dialog-Frame :width = v-frame-width
      798             .
      799             if frame Dialog-Frame :scrollable = true
      800             then do:
      801               assign
      802                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      803               .
      804             end.
      805             run diasize_position-resize-button in this-procedure .
      806           end.
      807           else do:
      808             if frame Dialog-Frame :scrollable = true
      809             then do:
      810               assign
      811                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      812               .
      813             end.
      814             assign
      815               frame Dialog-Frame :width = v-frame-width
      816             .
      817             for each buf_temp-browse-handle
      818               where buf_temp-browse-handle.browse-type = 'width':u
      819             on error undo, next
      820             :
      821               assign
      822                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      823               .
      824             end.
      825             assign
      826               v-diasize-browse-handle :width = v-browse-width
      827             .
      828             for each buf_temp-diasize-handle
      829             on error undo, next
      830             :
      831               assign
      832                 v-object-handle = buf_temp-diasize-handle.handle-value
      833               .
      834               if v-object-handle <> v-diasize-resize-button
      835               then do:
      836                 assign
      837                   v-object-handle :col = buf_temp-diasize-handle.save-position
      838                 .
      839               end.
      840             end.
      841             run diasize_position-resize-button in this-procedure .
      842           end.
      843           assign
      844             v-diasize-change-size = false
      845           .
      846           leave move_block .
      847         end.
      848       end.
      849       assign
      850         v-diasize-need-full-display = true
      851       .
      852       if v-diasize-change-size = false
      853       then do:
      854         assign
      855           v-diasize-change-size = true
      856         .
      857       end.
      858       else do:
      859         return .
      860       end.
      861       assign
      862         v-frame-width = frame Dialog-Frame :width
      863         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      864         v-browse-width = v-diasize-browse-handle :width
      865       .
      866       for each buf_temp-browse-handle
      867         where buf_temp-browse-handle.browse-type = 'width':u
      868       :
      869         assign
      870           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      871         .
      872       end.
      873       for each buf_temp-diasize-handle
      874       :
      875         delete buf_temp-diasize-handle .
      876       end.
      877       assign
      878         v-field-group-handle = frame Dialog-Frame :first-child
      879       .
      880       do while valid-handle(v-field-group-handle)
      881       :
      882         assign
      883           v-object-handle = v-field-group-handle :first-child
      884         .
      885         do while valid-handle(v-object-handle)
      886         :
      887           if  v-object-handle <> v-diasize-browse-handle :handle
      888           and v-object-handle <> v-diasize-resize-button
      889           and can-query(v-object-handle, "row")
      890           and can-query(v-object-handle, "height")
      891           and ( v-object-handle :col + v-object-handle :width
      892                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      893               )
      894           then do:
      895             find first buf_temp-browse-handle
      896               where buf_temp-browse-handle.browse-type   = 'width':u
      897                 and buf_temp-browse-handle.browse-handle = v-object-handle
      898               no-error .
      899             if available buf_temp-browse-handle
      900             then do:
      901             end.
      902             else do:
      903               create buf_temp-diasize-handle .
      904               assign
      905                 buf_temp-diasize-handle.handle-value  = v-object-handle
      906                 buf_temp-diasize-handle.save-position = v-object-handle :col
      907               .
      908             end.
      909           end.
      910           assign
      911             v-object-handle = v-object-handle :next-sibling
      912           .
      913         end.
      914         assign
      915           v-field-group-handle = v-field-group-handle :next-sibling
      916         .
      917       end.
      918       do with frame Dialog-Frame
      919       :
      920         hide v-diasize-resize-button .
      921         v-diasize-resize-button :row = 1.
      922         v-diasize-resize-button :column = 1.
      923       end.
      924       if p-change-value > 0
      925       then do:
      926         if frame Dialog-Frame :scrollable = true
      927         then do:
      928           assign
      929             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      930             no-error .
      931           if error-status :error
      932           or error-status :get-message(1) <> ""
      933           then do:
      934             undo move_block, retry move_block.
      935           end.
      936         end.
      937         assign
      938           frame Dialog-Frame :width = v-frame-width + p-change-value
      939           no-error .
      940         if error-status :error
      941         or error-status :get-message(1) <> ""
      942         then do:
      943           undo move_block, retry move_block.
      944         end.
      945         assign
      946           v-diasize-browse-handle :width = v-browse-width + p-change-value
      947         no-error .
      948         if error-status :error
      949         or error-status :get-message(1) <> ""
      950         then do:
      951           undo move_block, retry move_block.
      952         end.
      953         for each buf_temp-browse-handle
      954           where buf_temp-browse-handle.browse-type = 'width':u
      955         on error undo move_block, retry move_block
      956         :
      957           assign
      958             buf_temp-browse-handle.browse-handle :width
      959               = buf_temp-browse-handle.browse-handle :width + p-change-value
      960             no-error .
      961           if error-status :error
      962           or error-status :get-message(1) <> ""
      963           then do:
      964             undo move_block, retry move_block .
      965           end.
      966         end.
      967         for each buf_temp-diasize-handle
      968         on error undo move_block, retry move_block
      969         :
      970           assign
      971             v-object-handle = buf_temp-diasize-handle.handle-value
      972           .
      973           if v-object-handle <> v-diasize-resize-button
      974           then do:
      975             assign
      976               v-object-handle :col = v-object-handle :col + p-change-value
      977               no-error .
      978             if error-status :error
      979             or error-status :get-message(1) <> ""
      980             then do:
      981               undo move_block, retry move_block .
      982             end.
      983           end.
      984         end.
      985       end.
      986       else do:
      987         for each buf_temp-diasize-handle
      988         on error undo move_block, retry move_block
      989         :
      990           assign
      991             v-object-handle = buf_temp-diasize-handle.handle-value
      992           .
      993           if v-object-handle <> v-diasize-resize-button
      994           then do:
      995             assign
      996               v-object-handle :col = v-object-handle :col + p-change-value
      997               no-error .
      998             if error-status :error
      999             or error-status :get-message(1) <> ""
     1000             then do:
     1001               undo move_block, retry move_block .
     1002             end.
     1003           end.
     1004         end.
     1005         for each buf_temp-browse-handle
     1006           where buf_temp-browse-handle.browse-type = 'width':u
     1007         on error undo move_block, retry move_block
     1008         :
     1009           assign
     1010             buf_temp-browse-handle.browse-handle :width
     1011               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1012             no-error .
     1013           if error-status :error
     1014           or error-status :get-message(1) <> ""
     1015           then do:
     1016             undo move_block, retry move_block .
     1017           end.
     1018         end.
     1019         assign
     1020           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1021           no-error .
     1022         if error-status :error
     1023         or error-status :get-message(1) <> ""
     1024         then do:
     1025           undo move_block, retry move_block.
     1026         end.
     1027         assign
     1028           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1029         no-error .
     1030         if error-status :error
     1031         or error-status :get-message(1) <> ""
     1032         then do:
     1033           undo move_block, retry move_block.
     1034         end.
     1035         if frame Dialog-Frame :scrollable = true
     1036         then do:
     1037           assign
     1038             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1039           no-error .
     1040           if error-status :error
     1041           or error-status :get-message(1) <> ""
     1042           then do:
     1043             undo move_block, retry move_block.
     1044           end.
     1045         end.
     1046       end.
     1047       if p-move-resize
     1048       then do:
     1049         run diasize_position-resize-button in this-procedure .
     1050       end.
     1051       if v-diasize-wndstore = true
     1052       then do:
     1053         if connected("ub") = true
     1054         then do:
     1055           define variable v-cntxt-db-num        as integer   no-undo .
     1056           define variable v-cntxt-userid        as character no-undo .
     1057           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1058                                             , OUTPUT v-cntxt-userid
     1059                                             ) .
     1060           run gbl/wndsizew.p
     1061             (input  v-cntxt-db-num
     1062             ,input  v-cntxt-userid
     1063             ,input  v-diasize-proc-name
     1064             ,input  'width':u
     1065             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1066             ) .
     1067         end.
     1068       end.
     1069     end.
     1070     assign
     1071       v-diasize-change-size = false
     1072     .
     1073   end procedure.
     1074   procedure diasize_set-width :
     1075     define input  parameter p-new-width  as decimal   no-undo .
     1076     define input  parameter p-move-resize as logical   no-undo .
     1077     do
     1078     on error undo, return error return-value
     1079     :
     1080       run diasize_change-width in this-procedure
     1081         (input  (p-new-width - frame Dialog-Frame :width)
     1082         ,input  p-move-resize
     1083         ) .
     1084     end.
     1085   end procedure.
     1086   procedure diasize_position-resize-button :
     1087     do with frame Dialog-Frame
     1088     :
     1089       hide v-diasize-resize-button .
     1090       assign
     1091         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1092                     - 1
     1093                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1094         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1095                     - 1
     1096                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1097       .
     1098       view v-diasize-resize-button .
     1099     end.
     1100   end procedure.
     1101   on alt-right anywhere
     1102   do:
     1103     run diasize_change-width in this-procedure
     1104       (input 1
     1105       ,input true
     1106       ) .
     1107     return no-apply .
     1108   end.
     1109   on alt-left anywhere
     1110   do:
     1111     run diasize_change-width in this-procedure
     1112       (input -1
     1113       ,input true
     1114       ) .
     1115     return no-apply .
     1116   end.
     1117   on alt-down anywhere
     1118   do:
     1119     run diasize_change-height in this-procedure
     1120       (input 1
     1121       ,input true
     1122       ) .
     1123     return no-apply .
     1124   end.
     1125   on alt-up anywhere
     1126   do:
     1127     run diasize_change-height in this-procedure
     1128       (input -1
     1129       ,input true
     1130       ) .
     1131     return no-apply .
     1132   end.
     1133   on alt-enter of frame Dialog-Frame
     1134   do:
     1135     run diasize_maximize in this-procedure
     1136       (input  ?
     1137       ).
     1138     return no-apply .
     1139   end.
     1140   procedure diasize_end-move :
     1141     do
     1142     on error undo, return error return-value
     1143     :
     1144       define variable v-row-delta as decimal   no-undo .
     1145       define variable v-col-delta as decimal   no-undo .
     1146       define variable v-new-row as decimal   no-undo .
     1147       define variable v-new-col as decimal   no-undo .
     1148       assign
     1149         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1150         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1151       .
     1152       assign
     1153         v-row-delta = v-new-row - frame Dialog-Frame :height
     1154         v-col-delta = v-new-col - frame Dialog-Frame :width
     1155       .
     1156       run diasize_change-height in this-procedure
     1157         (input v-row-delta
     1158         ,input true
     1159         ) .
     1160       run diasize_change-width in this-procedure
     1161         (input v-col-delta
     1162         ,input true
     1163         ) .
     1164     end.
     1165   end procedure.
     1166   procedure diasize_maximize :
     1167     define input  parameter p-action as logical   no-undo .
     1168     do
     1169     on error undo, return error return-value
     1170     :
     1171       if p-action = ?
     1172       then do:
     1173         if v-diasize-need-maximize = true
     1174         then do:
     1175           assign
     1176             p-action = true
     1177           .
     1178         end.
     1179         else do:
     1180           assign
     1181             p-action = false
     1182           .
     1183         end.
     1184       end.
     1185       if p-action = true
     1186       then do:
     1187         run diasize_change-height in this-procedure
     1188           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1189               - frame Dialog-Frame :height-chars
     1190           ,input true
     1191           ) .
     1192         run diasize_change-width in this-procedure
     1193           (input session :width-chars
     1194               - frame Dialog-Frame :width-chars
     1195           ,input true
     1196           ) .
     1197         assign
     1198           v-diasize-need-maximize = false
     1199         .
     1200       end.
     1201       else do:
     1202         run diasize_change-width in this-procedure
     1203           (input v-diasize-orig-frame-width
     1204               - frame Dialog-Frame :width-chars
     1205           ,input true
     1206           ) .
     1207         run diasize_change-height in this-procedure
     1208           (input v-diasize-orig-frame-height
     1209               - frame Dialog-Frame :height-chars
     1210           ,input true
     1211           ) .
     1212         assign
     1213           v-diasize-need-maximize = true
     1214         .
     1215       end.
     1216     end.
     1217   end procedure.
     1218   procedure diasize_restore-orig-size :
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       assign
     1223         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1224         v-diasize-current-frame-height = frame Dialog-Frame :height
     1225       .
     1226       run diasize_set-height in this-procedure
     1227         (input  v-diasize-orig-frame-height
     1228         ,input  true
     1229         ) .
     1230       run diasize_set-width in this-procedure
     1231         (input  v-diasize-orig-frame-width
     1232         ,input  true
     1233         ) .
     1234     end.
     1235   end procedure.
     1236   procedure diasize_restore-current-size :
     1237     do
     1238     on error undo, return error return-value
     1239     :
     1240       run diasize_set-height in this-procedure
     1241         (input  v-diasize-current-frame-height
     1242         ,input  true
     1243         ) .
     1244       run diasize_set-width in this-procedure
     1245         (input  v-diasize-current-frame-width
     1246         ,input  true
     1247         ) .
     1248     end.
     1249   end procedure.
     1250   procedure diasize_set-browse-handle :
     1251     define input  parameter p-browse-handle as handle   no-undo .
     1252     define buffer buf_temp-browse-handle for temp-browse-handle .
     1253     do
     1254     on error undo, return error return-value
     1255     :
     1256       assign
     1257         v-diasize-browse-handle = p-browse-handle
     1258       .
     1259       for each buf_temp-browse-handle
     1260       on error undo, return error return-value
     1261       :
     1262         delete buf_temp-browse-handle .
     1263       end.
     1264     end.
     1265   end procedure.
     1266   procedure diasize_add_browse :
     1267     define input  parameter p-browse-type   as character no-undo .
     1268     define input  parameter p-browse-handle as handle    no-undo .
     1269     define buffer buf_temp-browse-handle for temp-browse-handle .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       assign
     1274         v-diasize-browse-number = v-diasize-browse-number + 1
     1275       .
     1276       create buf_temp-browse-handle .
     1277       assign
     1278         buf_temp-browse-handle.browse-type   = p-browse-type
     1279         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1280         buf_temp-browse-handle.browse-handle = p-browse-handle
     1281       .
     1282     end.
     1283   end procedure.
     1284   procedure diasize_init :
     1285     define variable v-default-value    as logical   no-undo .
     1286     define variable v-restore-saved    as logical   no-undo .
     1287     define variable v-resize-value-str as character no-undo .
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       do with frame Dialog-Frame
     1292       :
     1293         assign
     1294           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1295           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1296           v-diasize-browse-handle     = browse b-ob :handle
     1297         .
     1298         create button v-diasize-resize-button
     1299         assign
     1300           parent        = frame Dialog-Frame :first-child
     1301           label         = "s"
     1302           height-pixels = 16
     1303           width-pixels  = 16
     1304           visible       = true
     1305           sensitive     = true
     1306           movable       = true
     1307           triggers:
     1308             on end-move persistent run diasize_end-move in this-procedure .
     1309           end triggers.
     1310         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1311         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1312         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1313         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1314         assign
     1315           v-diasize-wndmax = false
     1316         .
     1317         if connected("ub") = true
     1318         then do:
     1319           define variable v-cntxt-db-num        as integer   no-undo .
     1320           define variable v-cntxt-userid        as character no-undo .
     1321           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1322                                             , OUTPUT v-cntxt-userid
     1323                                             ) .
     1324           run gbl/wndpar_r.p
     1325             (input  v-cntxt-db-num
     1326             ,input  v-cntxt-userid
     1327             ,input  'wndmax':U
     1328             ,output v-diasize-wndmax
     1329             ,output v-default-value
     1330             ) .
     1331         end.
     1332         assign
     1333           v-diasize-wndstore = false
     1334         .
     1335         if connected("ub") = true
     1336         then do:
     1337           run gbl/wndpar_r.p
     1338             (input  v-cntxt-db-num
     1339             ,input  v-cntxt-userid
     1340             ,input  'wndstore':U
     1341             ,output v-diasize-wndstore
     1342             ,output v-default-value
     1343             ) .
     1344         end.
     1345         assign
     1346           v-diasize-proc-name = entry(1, program-name(2), '.')
     1347         .
     1348         if v-diasize-wndstore = true
     1349         then do:
     1350           assign
     1351             v-restore-saved = false
     1352           .
     1353           if connected("ub") = true
     1354           then do:
     1355             run gbl/wndsizer.p
     1356               (input  v-cntxt-db-num
     1357               ,input  v-cntxt-userid
     1358               ,input  v-diasize-proc-name
     1359               ,input  'height':u
     1360               ,output v-resize-value-str
     1361               ) .
     1362             if v-resize-value-str <> '':U
     1363             then do:
     1364               run diasize_change-height in this-procedure
     1365                 (input  integer(v-resize-value-str)
     1366                 ,input  true
     1367                 ) .
     1368               assign
     1369                 v-restore-saved = true
     1370               .
     1371             end.
     1372           end.
     1373           if connected("ub") = true
     1374           then do:
     1375             run gbl/wndsizer.p
     1376               (input  v-cntxt-db-num
     1377               ,input  v-cntxt-userid
     1378               ,input  v-diasize-proc-name
     1379               ,input  'width':u
     1380               ,output v-resize-value-str
     1381               ) .
     1382             if v-resize-value-str <> '':U
     1383             then do:
     1384               run diasize_change-width in this-procedure
     1385                 (input  integer(v-resize-value-str)
     1386                 ,input  true
     1387                 ) .
     1388               assign
     1389                 v-restore-saved = true
     1390               .
     1391             end.
     1392           end.
     1393           if v-restore-saved <> true
     1394           then do:
     1395             if v-diasize-wndmax = true
     1396             then do:
     1397               run diasize_maximize in this-procedure
     1398                 (input  true
     1399                 ) .
     1400             end.
     1401           end.
     1402         end.
     1403         else do:
     1404           if v-diasize-wndmax = true
     1405           then do:
     1406             run diasize_maximize in this-procedure
     1407               (input  true
     1408               ) .
     1409           end.
     1410         end.
     1411       end.
     1412     end.
     1413   end procedure.
     1414   procedure diasize_need-full-display :
     1415     define output parameter p-need-full-display as logical   no-undo .
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       assign
     1420         p-need-full-display = v-diasize-need-full-display
     1421       .
     1422       assign
     1423         v-diasize-need-full-display = false
     1424       .
     1425     end.
     1426   end procedure.
     1427   procedure get-context :
     1428      define output parameter p-db-num as integer          no-undo.
     1429      define output parameter p-user-id as character        no-undo.
     1430      define variable v-login               as character    no-undo.
     1431      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1432      define buffer buf_user-login  for ub.user-login .
     1433      do
     1434      on error undo, return error
     1435      :
     1436            FIND FIRST buf_sys-ctrl no-lock.
     1437            ASSIGN
     1438               v-login = USERID("ub")
     1439               p-db-num = buf_sys-ctrl.db-num
     1440            .
     1441            FIND FIRST buf_user-login
     1442                 WHERE buf_user-login.db-num = p-db-num
     1443                   AND buf_user-login.user-login = v-login
     1444                 no-lock
     1445                 no-error
     1446                 .
     1447            IF AVAILABLE buf_user-login
     1448            THEN DO:
     1449               assign
     1450                  p-user-id = buf_user-login.user-id
     1451               .
     1452            END.
     1453      end.
     1454   end procedure.
     1455       run diasize_init in this-procedure .
     1456   MAIN-BLOCK:
     1457   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1458      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1459     FIND FIRST bf_c-trn-doc WHERE bf_c-trn-doc.doc-code = pardoc-code and
     1460                                   bf_c-trn-doc.chip-num = parchip-num NO-LOCK.
     1461     RUN cr-tt-fo-before IN THIS-PROCEDURE.
     1462     ASSIGN FRAME
     1463     Dialog-Frame:TITLE = "Предфинобязательства по удаленному складскому документу " + pardoc-code.
     1464     assign
     1465     tt-fo-before.sum-rubl:label in browse b-ob       = "Общая сумма (руб)"
     1466     tt-fo-before.sum-rubl-trn:label in browse b-ob   = "Сумма по док. (руб)"
     1467     bf_c-parts.price-rubl:label in browse b-parts    = "Цена (руб)"
     1468     .
     1469     RUN enable_UI.
     1470     RUN open-parts-query IN THIS-PROCEDURE.
     1471     WAIT-FOR GO OF FRAME Dialog-Frame.
     1472   END.
     1473   RUN disable_UI.
     1474   PROCEDURE cr-tt-fo-before :
     1475   FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.obj-type = bf_c-trn-doc.obj-type AND
     1476                                    bf_fin-gds-part.obj-code = bf_c-trn-doc.obj-code AND
     1477                                    bf_fin-gds-part.out-code = bf_c-trn-doc.doc-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1478       FIND FIRST bf_fin-ob-before WHERE bf_fin-ob-before.host-code = bf_fin-gds-part.host-code   AND
     1479                                         bf_fin-ob-before.before-code  = bf_fin-gds-part.fin-ob-code NO-LOCK no-error.
     1480       if available bf_fin-ob-before then do:
     1481         FIND FIRST tt-fo-before WHERE tt-fo-before.host-code = bf_fin-ob-before.host-code AND
     1482                                       tt-fo-before.doc-code  = bf_fin-ob-before.doc-code  NO-ERROR.
     1483         if not available tt-fo-before then do:
     1484           create tt-fo-before.
     1485           buffer-copy bf_fin-ob-before to tt-fo-before.
     1486         end.
     1487         ASSIGN
     1488           tt-fo-before.sum-base-trn = tt-fo-before.sum-base-trn + bf_fin-gds-part.sum-base
     1489           tt-fo-before.sum-rubl-trn = tt-fo-before.sum-rubl-trn + bf_fin-gds-part.sum-rubl
     1490         .
     1491      end.
     1492   END.
     1493   END PROCEDURE.
     1494   PROCEDURE disable_UI :
     1495     HIDE FRAME Dialog-Frame.
     1496   END PROCEDURE.
     1497   PROCEDURE enable_UI :
     1498     ENABLE b-exit b-help b-ob b-parts
     1499         WITH FRAME Dialog-Frame.
     1500     VIEW FRAME Dialog-Frame.
     1501     OPEN QUERY b-ob FOR EACH tt-fo-before.
     1502   END PROCEDURE.
     1503   PROCEDURE open-parts-query :
     1504   IF AVAILABLE tt-fo-before THEN DO:
     1505       OPEN QUERY b-parts
     1506           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code   = tt-fo-before.host-code   and
     1507                                            bf_fin-gds-part.fin-ob-code = tt-fo-before.before-code  and
     1508                                            bf_fin-gds-part.out-code    = pardoc-code            no-lock,
     1509           first bf_goods where bf_goods.gds-code = bf_fin-gds-part.gds-code no-lock,
     1510           FIRST bf_c-parts WHERE bf_c-parts.obj-type  = bf_fin-gds-part.obj-type AND
     1511                                  bf_c-parts.obj-code  = bf_fin-gds-part.obj-code AND
     1512                                  bf_c-parts.artic     = bf_goods.artic AND
     1513                                  bf_c-parts.prod-type = bf_goods.prod-type AND
     1514                                  bf_c-parts.prod-code = bf_goods.prod-code AND
     1515                                  bf_c-parts.in-code   = bf_fin-gds-part.in-code AND
     1516                                  bf_c-parts.out-code  = bf_fin-gds-part.out-code AND
     1517                                  bf_c-parts.chip-num  = parchip-num  and
     1518                                  bf_c-parts.part-code = bf_fin-gds-part.part-code NO-LOCK.
     1519       DISPLAY b-parts WITH FRAME Dialog-Frame.
     1520   END.
     1521   END PROCEDURE.
