        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter par-recid as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: 770d6d87d9f3, 729, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Tue Jul 26 10:34:43 2016 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: vtrecalc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/vtrecalc.p $":U .
        9   define variable vss-description as character no-undo init "Пересчет последующих инвентаризаций".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       72   procedure partslib-clear-temp-parts :
       73     define buffer buf_temp-parts for temp-parts .
       74     do
       75     on error undo, return error
       76     :
       77       for each buf_temp-parts
       78       on error undo, return error
       79       :
       80         delete buf_temp-parts .
       81       end.
       82     end.
       83   end procedure.
       84   procedure partslib-create-temp-parts :
       85     define parameter buffer buf_parts       for ub.parts .
       86     define parameter buffer buf_temp-parts  for temp-parts .
       87     define input  parameter p-goods-twounit as logical   no-undo .
       88     define variable v-base-part-code as character no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       if p-goods-twounit = true
       93       then do:
       94         assign
       95           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
       96         .
       97       end.
       98       else do:
       99         assign
      100           v-base-part-code = buf_parts.part-code
      101         .
      102       end.
      103       find first buf_temp-parts exclusive-lock
      104         where buf_temp-parts.obj-type  = buf_parts.obj-type
      105           and buf_temp-parts.obj-code  = buf_parts.obj-code
      106           and buf_temp-parts.artic     = buf_parts.artic
      107           and buf_temp-parts.prod-type = buf_parts.prod-type
      108           and buf_temp-parts.prod-code = buf_parts.prod-code
      109           and buf_temp-parts.in-code   = buf_parts.in-code
      110           and buf_temp-parts.out-code  = 'free-zone':U
      111           and buf_temp-parts.part-code = v-base-part-code
      112         no-error.
      113       if not available buf_temp-parts
      114       then do:
      115         create buf_temp-parts .
      116         buffer-copy buf_parts to buf_temp-parts
      117         assign
      118           buf_temp-parts.out-code  = 'free-zone':U
      119           buf_temp-parts.part-code = v-base-part-code
      120           buf_temp-parts.rsrv-free = yes
      121           buf_temp-parts.status_   = no
      122           buf_temp-parts.qnty      = 0
      123           buf_temp-parts.fact-qnty = 0
      124           buf_temp-parts.real-qnty = 0
      125           buf_temp-parts.cli-qnty  = 0
      126         .
      127       end.
      128     end.
      129   end procedure.
      130   procedure partslib-init-temp-parts :
      131     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      132     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      133     define input parameter p-artic           like ub.parts.artic     no-undo .
      134     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      135     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      136     define buffer buf_parts      for ub.parts .
      137     define buffer buf_temp-parts for temp-parts .
      138     define variable v-goods-twounit    as logical   no-undo .
      139     do
      140     on error undo, return error
      141     :
      142   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      144     (input  p-artic
      145     ,input  p-prod-type
      146     ,input  p-prod-code
      147     ,input  'twounit=request':u
      148     ,output v-goods-twounit
      149     ) no-error .
      150       if error-status :error
      151       then do:
      152         message
      153           vss-workfile vss-revision vss-description skip
      154           vss-include-info0 skip
      155           "Ошибка при определении атрибута товара" skip
      156           "Артикул" p-artic p-prod-type p-prod-code skip
      157           "twounit=request" skip
      158           error-status :get-message(1) skip
      159           return-value skip
      160           view-as alert-box error .
      161         undo, return error return-value .
      162       end.
      163       run partslib-clear-temp-parts in this-procedure .
      164       for each buf_parts
      165         where buf_parts.obj-type  = p-obj-type
      166           and buf_parts.obj-code  = p-obj-code
      167           and buf_parts.artic     = p-artic
      168           and buf_parts.prod-type = p-prod-type
      169           and buf_parts.prod-code = p-prod-code
      170           and buf_parts.rsrv-free = yes
      171           and buf_parts.status_   = no
      172           and buf_parts.in-code   <> buf_parts.out-code
      173       on error undo, return error
      174       :
      175         run partslib-create-temp-parts in this-procedure
      176           (buffer buf_parts
      177           ,buffer buf_temp-parts
      178           ,input  v-goods-twounit
      179           ) .
      180         define variable v-parts-qnty          as decimal   no-undo .
      181         define variable v-parts-cli-qnty      as decimal   no-undo .
      182         define variable v-parts-free-qnty     as decimal   no-undo .
      183         define variable v-parts-free-cli-qnty as decimal   no-undo .
      184         if buf_parts.out-code = 'free-zone':U
      185         then do:
      186           assign
      187             v-parts-qnty          = buf_parts.qnty
      188             v-parts-cli-qnty      = buf_parts.cli-qnty
      189             v-parts-free-qnty     = buf_parts.qnty
      190             v-parts-free-cli-qnty = buf_parts.cli-qnty
      191           .
      192         end.
      193         else do:
      194           assign
      195             v-parts-qnty          = abs(buf_parts.qnty)
      196             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      197             v-parts-free-qnty     = 0
      198             v-parts-free-cli-qnty = 0
      199           .
      200         end.
      201         assign
      202           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      203           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      204           buf_temp-parts.real-qnty     = 0
      205           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      206           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      207           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      208         .
      209       end.
      210     end.
      211   end procedure.
      212   procedure partslib-init-temp-parts-by-factord :
      213     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      214     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      215     define input parameter p-artic              like ub.parts.artic     no-undo .
      216     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      217     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      218     define input parameter p-fact-order         as decimal   no-undo .
      219     define input parameter p-include-fact-order as logical   no-undo .
      220     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      221     define buffer buf_gds-obj  for ub.gds-obj .
      222     do
      223     on error undo, return error
      224     :
      225       do transaction
      226       on error undo, return error
      227       :
      228   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      230     (input  p-obj-type
      231     ,input  p-obj-code
      232     ,input  p-artic
      233     ,input  p-prod-type
      234     ,input  p-prod-code
      235     ,buffer buf_gds-obj
      236     ) no-error .
      237         if error-status :error
      238         then do:
      239           message
      240             vss-workfile vss-revision vss-description skip
      241             vss-include-info0 skip
      242             "Невозможно найти товар на объекте" skip
      243             "Объект" p-obj-type p-obj-code skip
      244             "Артикул" p-artic p-prod-type p-prod-code skip
      245             error-status :get-message(1) skip
      246             return-value skip
      247             view-as alert-box error .
      248           undo, return error .
      249         end.
      250         find current buf_gds-obj exclusive-lock .
      251       end.
      252       run partslib-init-temp-parts in this-procedure
      253         (input p-obj-type
      254         ,input p-obj-code
      255         ,input p-artic
      256         ,input p-prod-type
      257         ,input p-prod-code
      258         ) no-error .
      259       if error-status :error
      260       then do:
      261         message
      262           vss-workfile vss-revision vss-description skip
      263           vss-include-info0 skip
      264           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      265           "Объект" p-obj-type p-obj-code skip
      266           "Артикул" p-artic p-prod-type p-prod-code skip
      267           "p-fact-order" p-fact-order skip
      268           view-as alert-box error .
      269         undo, return error .
      270       end.
      271       if p-include-fact-order = true
      272       then do:
      273         assign
      274           p-fact-order = p-fact-order - 0.0000000001
      275         .
      276       end.
      277       define variable v-max-fact-order as character no-undo .
      278       run factord-max-fact-order in this-procedure
      279         (output v-max-fact-order
      280         ) no-error .
      281       if error-status :error
      282       then do:
      283         message
      284           vss-workfile vss-revision vss-description skip
      285           vss-include-info0 skip
      286           "Ошибка при вызове процедуры factord-max-fact-order" skip
      287           "Объект" p-obj-type p-obj-code skip
      288           "Артикул" p-artic p-prod-type p-prod-code skip
      289           "p-fact-order" p-fact-order skip
      290           view-as alert-box error .
      291         undo, return error .
      292       end.
      293       run partslib-update-by-factord in this-procedure
      294         (input p-obj-type
      295         ,input p-obj-code
      296         ,input p-artic
      297         ,input p-prod-type
      298         ,input p-prod-code
      299         ,input p-fact-order
      300         ,input v-max-fact-order
      301         ,input false
      302         ) no-error .
      303       if error-status :error
      304       then do:
      305         message
      306           vss-workfile vss-revision vss-description skip
      307           vss-include-info0 skip
      308           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      309           "Объект" p-obj-type p-obj-code skip
      310           "Артикул" p-artic p-prod-type p-prod-code skip
      311           "p-fact-order" p-fact-order skip
      312           "v-max-fact-order" v-max-fact-order skip
      313           view-as alert-box error .
      314         undo, return error .
      315       end.
      316     end.
      317   end procedure.
      318   procedure partslib-update-by-factord :
      319     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      320     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      321     define input parameter p-artic              like ub.parts.artic     no-undo .
      322     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      323     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      324     define input parameter p-start-fact-order   as decimal   no-undo .
      325     define input parameter p-end-fact-order     as decimal   no-undo .
      326     define input parameter p-lock-gds-obj       as logical   no-undo .
      327     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      328     define buffer buf_gds-obj  for ub.gds-obj .
      329     define buffer buf_doc-line for ub.doc-line .
      330     define variable v-total-parts-qnty as decimal   no-undo .
      331     define variable v-goods-gds-goods  as logical   no-undo .
      332     define variable v-goods-twounit    as logical   no-undo .
      333     do
      334     on error undo, return error
      335     :
      336       if p-start-fact-order > p-end-fact-order
      337       then do:
      338         message
      339           vss-workfile vss-revision vss-description skip
      340           vss-include-info0 skip
      341           "Ошибка задания входных параметров" skip
      342           "Начало интервала превышает конец интервала" skip
      343           "Объект" p-obj-type p-obj-code skip
      344           "Артикул" p-artic p-prod-type p-prod-code skip
      345           "p-start-fact-order" p-start-fact-order skip
      346           "p-end-fact-order"   p-end-fact-order skip
      347           view-as alert-box error .
      348         undo, return error .
      349       end.
      350       if p-lock-gds-obj = true
      351       then do:
      352         do transaction
      353         on error undo, return error
      354         :
      355   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      357     (input  p-obj-type
      358     ,input  p-obj-code
      359     ,input  p-artic
      360     ,input  p-prod-type
      361     ,input  p-prod-code
      362     ,buffer buf_gds-obj
      363     ) no-error .
      364           if error-status :error
      365           then do:
      366             message
      367               vss-workfile vss-revision vss-description skip
      368               vss-include-info0 skip
      369               "Невозможно найти gds-obj" skip
      370               error-status :get-message(1) skip
      371               return-value skip
      372               view-as alert-box error .
      373             undo, return error .
      374           end.
      375           find current buf_gds-obj exclusive-lock .
      376         end.
      377       end.
      378   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      380     (input  p-artic
      381     ,input  p-prod-type
      382     ,input  p-prod-code
      383     ,input  'gds-goods=request':u
      384     ,output v-goods-gds-goods
      385     ) no-error .
      386       if error-status :error
      387       then do:
      388         message
      389           vss-workfile vss-revision vss-description skip
      390           vss-include-info0 skip
      391           "Ошибка при определении атрибута товара" skip
      392           "Артикул" p-artic p-prod-type p-prod-code skip
      393           "gds-goods=request" skip
      394           error-status :get-message(1) skip
      395           return-value skip
      396           view-as alert-box error .
      397         undo, return error return-value .
      398       end.
      399   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      401     (input  p-artic
      402     ,input  p-prod-type
      403     ,input  p-prod-code
      404     ,input  'twounit=request':u
      405     ,output v-goods-twounit
      406     ) no-error .
      407       if error-status :error
      408       then do:
      409         message
      410           vss-workfile vss-revision vss-description skip
      411           vss-include-info0 skip
      412           "Ошибка при определении атрибута товара" skip
      413           "Артикул" p-artic p-prod-type p-prod-code skip
      414           "twounit=request" skip
      415           error-status :get-message(1) skip
      416           return-value skip
      417           view-as alert-box error .
      418         undo, return error return-value .
      419       end.
      420       for each buf_doc-line no-lock
      421         where buf_doc-line.obj-type   = p-obj-type
      422           and buf_doc-line.obj-code   = p-obj-code
      423           and buf_doc-line.artic      = p-artic
      424           and buf_doc-line.prod-type  = p-prod-type
      425           and buf_doc-line.prod-code  = p-prod-code
      426           and buf_doc-line.status_    = 'факт':U
      427           and buf_doc-line.fact-order > p-start-fact-order
      428           and buf_doc-line.fact-order <= p-end-fact-order
      429       on error undo, return error
      430       :
      431         run partslib-process-document in this-procedure
      432           (input  buf_doc-line.doc-code
      433           ,input  p-obj-type
      434           ,input  p-obj-code
      435           ,input  p-artic
      436           ,input  p-prod-type
      437           ,input  p-prod-code
      438           ,input  v-goods-gds-goods
      439           ,input  v-goods-twounit
      440           ,output v-total-parts-qnty
      441           ) no-error .
      442         if error-status :error
      443         then do:
      444           message
      445             vss-workfile vss-revision vss-description skip
      446             vss-include-info0 skip
      447             "Ошибка при вызове процедуры partslib-process-document" skip
      448             "Документ" buf_doc-line.doc-code skip
      449             "Объект" p-obj-type p-obj-code skip
      450             "Артикул" p-artic p-prod-type p-prod-code skip
      451             "p-start-fact-order" p-start-fact-order skip
      452             "p-end-fact-order" p-end-fact-order skip
      453             error-status :get-message(1) skip
      454             return-value skip
      455             view-as alert-box error .
      456           undo, return error return-value .
      457         end.
      458       end.
      459     end.
      460   end procedure.
      461   procedure partslib-process-document :
      462     define input  parameter p-doc-code         as character no-undo .
      463     define input  parameter p-obj-type         as character no-undo .
      464     define input  parameter p-obj-code         as integer   no-undo .
      465     define input  parameter p-artic            as character no-undo .
      466     define input  parameter p-prod-type        as character no-undo .
      467     define input  parameter p-prod-code        as integer   no-undo .
      468     define input  parameter p-goods-gds-goods  as logical   no-undo .
      469     define input  parameter p-goods-twounit    as logical   no-undo .
      470     define output parameter p-total-parts-qnty as decimal   no-undo .
      471     define variable v-parts-sign as integer   no-undo .
      472     define buffer buf_trn-doc    for ub.trn-doc .
      473     define buffer buf_doc-line   for ub.doc-line .
      474     define buffer buf_parts      for ub.parts .
      475     define buffer buf_temp-parts for temp-parts .
      476     do
      477     on error undo, return error return-value
      478     :
      479       find first buf_trn-doc no-lock
      480         where buf_trn-doc.doc-code = p-doc-code
      481         no-error .
      482       if not available buf_trn-doc
      483       then do:
      484         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      485                                      ,p-doc-code
      486                                      ) .
      487       end.
      488       case buf_trn-doc.doc-type
      489       :
      490         when 'при':U or
      491         when 'возврат':U or
      492         when 'инв':U
      493         then do:
      494           assign
      495             v-parts-sign = -1
      496           .
      497         end.
      498         when 'рас':U or
      499         when 'спи':U
      500         then do:
      501           assign
      502             v-parts-sign = 1
      503           .
      504         end.
      505         otherwise do:
      506           undo, return error substitute("Неизвестный тип документа &1"
      507                                       ,buf_trn-doc.doc-type
      508                                       ) .
      509         end.
      510       end.
      511       find first buf_doc-line no-lock
      512         where buf_doc-line.doc-code  = p-doc-code
      513           and buf_doc-line.artic     = p-artic
      514           and buf_doc-line.prod-type = p-prod-type
      515           and buf_doc-line.prod-code = p-prod-code
      516         no-error .
      517       if not available buf_doc-line
      518       then do:
      519         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      520                                      ,p-doc-code
      521                                      ,artic
      522                                      ,prod-type
      523                                      ,prod-code
      524                                      ) .
      525       end.
      526       assign
      527         p-total-parts-qnty = 0
      528       .
      529       if p-goods-gds-goods = true
      530       then do:
      531         for each buf_parts no-lock
      532           where buf_parts.out-code  = p-doc-code
      533             and buf_parts.obj-type  = p-obj-type
      534             and buf_parts.obj-code  = p-obj-code
      535             and buf_parts.artic     = p-artic
      536             and buf_parts.prod-type = p-prod-type
      537             and buf_parts.prod-code = p-prod-code
      538         on error undo, return error
      539         :
      540           run partslib-create-temp-parts in this-procedure
      541             (buffer buf_parts
      542             ,buffer buf_temp-parts
      543             ,input  p-goods-twounit
      544             ) .
      545           assign
      546             p-total-parts-qnty        = p-total-parts-qnty
      547                                       + v-parts-sign * buf_parts.fact-qnty
      548             buf_temp-parts.qnty       = buf_temp-parts.qnty
      549                                       + v-parts-sign * buf_parts.fact-qnty
      550             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      551                                       + v-parts-sign * buf_parts.fact-qnty
      552             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      553                                       + v-parts-sign * buf_parts.cli-qnty
      554           .
      555           if buf_temp-parts.qnty = 0
      556           then do:
      557             delete buf_temp-parts .
      558           end.
      559         end.
      560       end.
      561       else do:
      562         assign
      563           p-total-parts-qnty = p-total-parts-qnty
      564                              + v-parts-sign * buf_doc-line.fact-qnty
      565         .
      566       end.
      567     end.
      568   end procedure.
      569   procedure partslib-init-temp-parts-by-date :
      570     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      571     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      572     define input parameter p-artic           like ub.parts.artic     no-undo .
      573     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      574     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      575     define input parameter p-fact-date       as date      no-undo .
      576     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      577     do
      578     on error undo, return error
      579     :
      580       define variable v-fact-order                as decimal   no-undo .
      581       define variable v-shift-end-fact-order      as decimal   no-undo .
      582       define variable v-day-end-fact-order        as decimal   no-undo .
      583       run factord in this-procedure
      584         (input  p-fact-date
      585         ,input  1
      586         ,input  1
      587         ,input  ?
      588         ,input  0
      589         ,input  false
      590         ,output v-fact-order
      591         ,output v-shift-end-fact-order
      592         ,output v-day-end-fact-order
      593         ) no-error .
      594       if error-status :error
      595       then do:
      596         message
      597           vss-workfile vss-revision vss-description skip
      598           vss-include-info0 skip
      599           "Ошибка при определении момента времени, на который требуется остаток" skip
      600           "Объект" p-obj-type p-obj-code skip
      601           "Артикул" p-artic p-prod-type p-prod-code skip
      602           "Дата" p-fact-date skip
      603           view-as alert-box error .
      604         undo, return error .
      605       end.
      606       run partslib-init-temp-parts-by-factord in this-procedure
      607         (input p-obj-type
      608         ,input p-obj-code
      609         ,input p-artic
      610         ,input p-prod-type
      611         ,input p-prod-code
      612         ,input v-day-end-fact-order
      613         ,input false
      614         ) no-error .
      615       if error-status :error
      616       then do:
      617         message
      618           vss-workfile vss-revision vss-description skip
      619           vss-include-info0 skip
      620           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      621           "Объект" p-obj-type p-obj-code skip
      622           "Артикул" p-artic p-prod-type p-prod-code skip
      623           "Дата" p-fact-date skip
      624           view-as alert-box error .
      625         undo, return error .
      626       end.
      627     end.
      628   end procedure.
      629   procedure partslib-calc-cost :
      630     define output parameter p-fact-qnty      as decimal   no-undo .
      631     define output parameter p-vat-pc         as decimal   no-undo .
      632     define output parameter p-slt-pc         as decimal   no-undo .
      633     define output parameter p-sum-base       as decimal   no-undo .
      634     define output parameter p-sum-rubl       as decimal   no-undo .
      635     define output parameter p-vat-base       as decimal   no-undo .
      636     define output parameter p-vat-rubl       as decimal   no-undo .
      637     define output parameter p-slt-base       as decimal   no-undo .
      638     define output parameter p-slt-rubl       as decimal   no-undo .
      639     define output parameter p-road-tax-base  as decimal   no-undo .
      640     define output parameter p-road-tax-rubl  as decimal   no-undo .
      641     define output parameter p-transport-base as decimal   no-undo .
      642     define output parameter p-transport-rubl as decimal   no-undo .
      643     define output parameter p-other-base     as decimal   no-undo .
      644     define output parameter p-other-rubl     as decimal   no-undo .
      645     define output parameter p-excise-base    as decimal   no-undo .
      646     define output parameter p-excise-rubl    as decimal   no-undo .
      647     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      648     do
      649     on error undo, return error return-value
      650     :
      651       define buffer buf_temp-parts for temp-parts .
      652       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      653       define buffer   in-vatp-parts    for ub.parts   .
      654       define buffer   in-vatp-doc      for ub.trn-doc .
      655       define buffer   in-vatp-goods    for ub.goods   .
      656       define buffer   in-vatp-sysconf  for ub.sysconf .
      657       define buffer   in-vatp_doc-attr for ub.doc-attr.
      658       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      659       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      660       define variable varinvprb                  as   character              no-undo.
      661       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      662       define variable cli-base-rate              as   decimal                no-undo.
      663       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      664       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      665       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      666       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      667       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      668       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      669       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      670       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      671       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      672       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      673       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      674       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      675       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      676       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      677       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      678       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      679       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      680       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      681       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      682       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      683       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      684       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      685       define variable varinvatp-envd             as   character              no-undo.
      686       define variable varinvatp-type             as   character              no-undo.
      687       for each buf_temp-parts
      688       on error undo, return error
      689       :
      690   assign
      691     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      692     price-base-with-tax-loc = buf_temp-parts.price-base
      693   .
      694   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      696     (output varinvprb
      697     )  .
      698     if buf_temp-parts.out-code = 'free-zone':U     or
      699        buf_temp-parts.out-code = 'out-zone':U   or
      700        buf_temp-parts.doc-type = 'акт':U then do:
      701       assign
      702         in-vatp-have-vat-slt = yes.
      703     end.
      704     else do:
      705       find first in-vatp_doc-attr no-lock
      706         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      707           and in-vatp_doc-attr.attr-code = 'envd':U
      708         no-error .
      709       if not available in-vatp_doc-attr then do:
      710         assign
      711           in-vatp-have-vat-slt = yes.
      712       end.
      713       else do:
      714            in-vatp-have-vat-slt = no.
      715       end.
      716     end.
      717     assign
      718      price-cli-with-tax-loc = buf_temp-parts.price-cli
      719      cli-base-rate          = buf_temp-parts.cli-base-rate.
      720     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      721              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      722     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      723             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      724             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      725             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      726             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      727             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      728             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      729       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      730     assign
      731       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      732     assign
      733       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      734       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      735       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      736       transport-cli-loc  = 0
      737       other-cli-loc      = 0
      738     .
      739   ASSIGN
      740             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      741       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      742   .
      743         assign
      744           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      745           p-vat-pc         = p-vat-pc         + vat-pc-loc
      746           p-slt-pc         = p-slt-pc         + slt-pc-loc
      747           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      748           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      749           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      750           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      751           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      752           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      753           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      754           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      755           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      756           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      757           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      758           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      759           p-excise-base    = p-excise-base    + 0
      760           p-excise-rubl    = p-excise-rubl    + 0
      761         .
      762       end.
      763       if p-fact-qnty      = ?
      764       or p-sum-base       = ?
      765       or p-sum-rubl       = ?
      766       or p-vat-base       = ?
      767       or p-vat-rubl       = ?
      768       or p-slt-base       = ?
      769       or p-slt-rubl       = ?
      770       or p-road-tax-base  = ?
      771       or p-road-tax-rubl  = ?
      772       or p-transport-base = ?
      773       or p-transport-rubl = ?
      774       or p-other-base     = ?
      775       or p-other-rubl     = ?
      776       or p-excise-base    = ?
      777       or p-excise-rubl    = ?
      778       then do:
      779         message
      780           vss-workfile vss-revision vss-description skip
      781           vss-include-info0 skip
      782           "Программа in-vatp.i вернула неопределенные значения" skip
      783           "p-fact-qnty"      p-fact-qnty      skip
      784           "p-sum-base"       p-sum-base       skip
      785           "p-sum-rubl"       p-sum-rubl       skip
      786           "p-vat-base"       p-vat-base       skip
      787           "p-vat-rubl"       p-vat-rubl       skip
      788           "p-slt-base"       p-slt-base       skip
      789           "p-slt-rubl"       p-slt-rubl       skip
      790           "p-road-tax-base"  p-road-tax-base  skip
      791           "p-road-tax-rubl"  p-road-tax-rubl  skip
      792           "p-transport-base" p-transport-base skip
      793           "p-transport-rubl" p-transport-rubl skip
      794           "p-other-base"     p-other-base     skip
      795           "p-other-rubl"     p-other-rubl     skip
      796           "p-excise-base"    p-excise-base    skip
      797           "p-excise-rubl"    p-excise-rubl    skip
      798           view-as alert-box error .
      799         undo, return error .
      800       end.
      801     end.
      802   end procedure.
      803   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
      805   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
      806   procedure prdoclib-process-goods :
      807     define input  parameter p-obj-type          as character no-undo .
      808     define input  parameter p-obj-code          as integer   no-undo .
      809     define input  parameter p-artic             as character no-undo .
      810     define input  parameter p-prod-type         as character no-undo .
      811     define input  parameter p-prod-code         as integer   no-undo .
      812     define input  parameter p-check-price-list  as logical   no-undo .
      813     define input  parameter p-check-price-parts as logical   no-undo .
      814     define input  parameter p-doc-num           as character no-undo .
      815     define input  parameter p-fact-date         as date      no-undo .
      816     define input  parameter p-corr-user-db-num  as integer   no-undo .
      817     define input  parameter p-corr-user-name    as character no-undo .
      818     define input  parameter p-corr-date         as date      no-undo .
      819     define input  parameter p-corr-time         as integer   no-undo .
      820     define input  parameter p-corr-time-str     as character no-undo .
      821     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
      822     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
      823     define buffer buf_gds-obj      for ub.gds-obj .
      824     define buffer buf_prt-obj      for ub.prt-obj .
      825     define buffer buf_price-list   for ub.price-list .
      826     define buffer buf_bar-code     for ub.bar-code .
      827     define buffer buf_temp-prt-obj for temp-prt-obj .
      828     define variable v-gds-code             like ub.goods.gds-code    no-undo .
      829     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
      830     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
      831     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
      832     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
      833     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
      834     define variable v-price-sale  like ub.price-list.price-sale no-undo .
      835     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
      836     define variable v-excise      like ub.price-list.excise     no-undo .
      837     do
      838     on error undo, return error return-value
      839     :
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
