     1264   end procedure.
     1265   procedure prdoclib-clear-temp-prt-obj :
     1266     define buffer buf_temp-prt-obj for temp-prt-obj .
     1267     do
     1268     on error undo, return error return-value
     1269     :
     1270       for each buf_temp-prt-obj
     1271       on error undo, return error return-value
     1272       :
     1273         delete buf_temp-prt-obj .
     1274       end.
     1275     end.
     1276   end procedure.
     1277   procedure prdoclib-create-temp-prt-obj :
     1278     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1279     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1280     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1281     define buffer buf_gds-prt for ub.gds-prt .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       find first buf_temp-prt-obj
     1286         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1287         no-error .
     1288       if not available buf_temp-prt-obj
     1289       then do:
     1290         create buf_temp-prt-obj .
     1291         assign
     1292           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1293           buf_temp-prt-obj.price-sale       = ?
     1294           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1295           buf_temp-prt-obj.price-list-qnty  = ?
     1296           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1297           buf_temp-prt-obj.price-list-recid = ?
     1298         .
     1299         find first buf_gds-prt no-lock
     1300           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1301           .
     1302         assign
     1303           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1304         .
     1305         if buf_temp-prt-obj.is-term
     1306         then do:
     1307           assign
     1308             buf_temp-prt-obj.price-sale = p-root-price-sale
     1309           .
     1310         end.
     1311       end.
     1312     end.
     1313   end procedure.
     1314   procedure prdoclib-temp-prt-obj-by-prt-root :
     1315     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1316     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1317     define buffer buf_gds-prt for ub.gds-prt .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       find first buf_temp-prt-obj
     1322         where buf_temp-prt-obj.prt-code = p-prt-code
     1323         no-error .
     1324       if not available buf_temp-prt-obj
     1325       then do:
     1326         create buf_temp-prt-obj .
     1327         assign
     1328           buf_temp-prt-obj.prt-code         = p-prt-code
     1329           buf_temp-prt-obj.price-sale       = ?
     1330           buf_temp-prt-obj.fact-qnty        = 0
     1331           buf_temp-prt-obj.price-list-qnty  = ?
     1332           buf_temp-prt-obj.prt-obj-recid    = ?
     1333           buf_temp-prt-obj.price-list-recid = ?
     1334         .
     1335         find first buf_gds-prt no-lock
     1336           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1337           .
     1338         assign
     1339           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1340         .
     1341         if buf_temp-prt-obj.is-term
     1342         then do:
     1343           assign
     1344             buf_temp-prt-obj.price-sale = 0
     1345           .
     1346         end.
     1347       end.
     1348     end.
     1349   end procedure.
     1350   procedure prdoclib-init-temp-prt-obj :
     1351     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1352     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1353     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1354     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1355     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1356     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1357     define buffer buf_prt-obj      for ub.prt-obj .
     1358     define buffer buf_temp-prt-obj for temp-prt-obj .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       run prdoclib-clear-temp-prt-obj in this-procedure .
     1363       for each buf_prt-obj
     1364         where buf_prt-obj.obj-type  = p-obj-type
     1365           and buf_prt-obj.obj-code  = p-obj-code
     1366           and buf_prt-obj.artic     = p-artic
     1367           and buf_prt-obj.prod-type = p-prod-type
     1368           and buf_prt-obj.prod-code = p-prod-code
     1369       on error undo, return error return-value
     1370       :
     1371         run prdoclib-create-temp-prt-obj in this-procedure
     1372           (input  p-root-price-sale
     1373           ,buffer buf_prt-obj
     1374           ,buffer buf_temp-prt-obj
     1375           ).
     1376       end.
     1377     end.
     1378   end procedure.
     1379   procedure prdoclib-calc-fact-sale :
     1380     define input  parameter p-price-list-recid   as recid     no-undo .
     1381     define output parameter p-fact-qnty          as decimal   no-undo .
     1382     define output parameter p-cur-base           as decimal   no-undo .
     1383     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1384     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1385     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1386     define output parameter p-cur-excise-base    as decimal   no-undo .
     1387     define buffer buf_main_price-list for ub.price-list .
     1388     define buffer buf_price-list      for ub.price-list .
     1389     define buffer buf_goods           for ub.goods .
     1390     define buffer buf_gds-obj         for ub.gds-obj .
     1391     define buffer buf_bar-code        for ub.bar-code .
     1392     define variable l-empty-scale   as logical   no-undo .
     1393     do
     1394     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1395     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1396     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1397     :
     1398       find first buf_main_price-list no-lock
     1399         where recid(buf_main_price-list) = p-price-list-recid
     1400         no-error .
     1401       if not available buf_main_price-list
     1402       then do:
     1403         message
     1404           vss-workfile vss-revision vss-description skip
     1405           vss-include-info7 skip
     1406           "Ошибка задания входных параметров" skip
     1407           "Не найдена строка переоценки" skip
     1408           "Код записи (recid)" p-price-list-recid skip
     1409           view-as alert-box error .
     1410         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1411       end.
     1412       if buf_main_price-list.main-price <> true
     1413       then do:
     1414         message
     1415           vss-workfile vss-revision vss-description skip
     1416           vss-include-info7 skip
     1417           "Ошибка задания входных параметров" skip
     1418           "Строка переоценки не является основной" skip
     1419           "Код записи (recid)" p-price-list-recid skip
     1420           "Переоценка" buf_main_price-list.doc-num skip
     1421           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1422           "Бар-код" buf_main_price-list.b-code skip
     1423           view-as alert-box error .
     1424         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1425       end.
     1426       find first buf_goods no-lock
     1427         where buf_goods.artic     = buf_main_price-list.artic
     1428           and buf_goods.prod-type = buf_main_price-list.prod-type
     1429           and buf_goods.prod-code = buf_main_price-list.prod-code
     1430         no-error .
     1431       if not available buf_goods
     1432       then do:
     1433         message
     1434           vss-workfile vss-revision vss-description skip
     1435           vss-include-info7 skip
     1436           "Не найден товар" skip
     1437           "Переоценка" buf_main_price-list.doc-num skip
     1438           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1439           view-as alert-box error .
     1440         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1441       end.
     1442   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1444     (input  buf_main_price-list.artic
     1445     ,input  buf_main_price-list.prod-type
     1446     ,input  buf_main_price-list.prod-code
     1447     ,input  'empty-scale=request':u
     1448     ,output l-empty-scale
     1449     ) no-error .
     1450       if error-status :error
     1451       then do:
     1452         message
     1453           vss-workfile vss-revision vss-description skip
     1454           vss-include-info7 skip
     1455           "Ошибка при определении атрибута товара" skip
     1456           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1457           'empty-scale=request':u skip
     1458           error-status :get-message(1) skip
     1459           return-value skip
     1460           view-as alert-box error .
     1461         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1462       end.
     1463       find first buf_gds-obj no-lock
     1464         where buf_gds-obj.gds-code = buf_goods.gds-code
     1465           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1466           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1467         no-error .
     1468         if not available buf_gds-obj then do:
     1469   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1471     (input  buf_main_price-list.obj-type
     1472     ,input  buf_main_price-list.obj-code
     1473     ,input  buf_goods.artic
     1474     ,input  buf_goods.prod-type
     1475     ,input  buf_goods.prod-code
     1476     ,buffer buf_gds-obj
     1477     ) no-error .
     1478           if error-status :error then do:
     1479              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1480           end.
     1481         end.
     1482       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1483       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1484       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1485       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1486       define variable vat-base-sale-prl               as decimal   no-undo .
     1487       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1488       define variable vat-base-buyer-prl              as decimal   no-undo .
     1489       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1490       define variable slt-base-sale-prl               as decimal   no-undo .
     1491       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1492       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1493       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1494       define variable excise-base-sale-prl            as decimal   no-undo .
     1495       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1496       define variable discnt-base-sale-prl            as decimal   no-undo .
     1497       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1498       if buf_main_price-list.doc-qnty <> 0
     1499       then do:
     1500         run prl-vat in this-procedure
     1501           (input  recid(buf_main_price-list)
     1502           ,output price-rubl-with-tax-sale-prl
     1503           ,output price-base-with-tax-sale-prl
     1504           ,output price-rubl-without-tax-sale-prl
     1505           ,output price-base-without-tax-sale-prl
     1506           ,output vat-base-sale-prl
     1507           ,output vat-rubl-sale-prl
     1508           ,output vat-base-buyer-prl
     1509           ,output vat-rubl-buyer-prl
     1510           ,output slt-base-sale-prl
     1511           ,output slt-rubl-sale-prl
     1512           ,output road-tax-base-sale-prl
     1513           ,output road-tax-rubl-sale-prl
     1514           ,output excise-base-sale-prl
     1515           ,output excise-rubl-sale-prl
     1516           ,output discnt-base-sale-prl
     1517           ,output discnt-rubl-sale-prl
     1518           ) no-error .
     1519         if error-status :error
     1520         then do:
     1521           message
     1522             vss-workfile vss-revision vss-description skip
     1523             vss-include-info7 skip
     1524             "Ошибка при вызове процеды prl-vat" skip
     1525             "Документ" buf_main_price-list.doc-num skip
     1526             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1527             error-status :get-message(1) skip
     1528             return-value skip
     1529             view-as alert-box error .
     1530           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1531         end.
     1532       end.
     1533       else do:
     1534         assign
     1535           price-rubl-with-tax-sale-prl    = 0
     1536           price-base-with-tax-sale-prl    = 0
     1537           price-rubl-without-tax-sale-prl = 0
     1538           price-base-without-tax-sale-prl = 0
     1539           vat-base-sale-prl               = 0
     1540           vat-rubl-sale-prl               = 0
     1541           vat-base-buyer-prl              = 0
     1542           vat-rubl-buyer-prl              = 0
     1543           slt-base-sale-prl               = 0
     1544           slt-rubl-sale-prl               = 0
     1545           road-tax-base-sale-prl          = 0
     1546           road-tax-rubl-sale-prl          = 0
     1547           excise-base-sale-prl            = 0
     1548           excise-rubl-sale-prl            = 0
     1549           discnt-base-sale-prl            = 0
     1550           discnt-rubl-sale-prl            = 0
     1551         .
     1552       end.
     1553       define variable v-curr-r-b as character no-undo .
     1554   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1556     (output v-curr-r-b
     1557     )  .
     1558       if v-curr-r-b = 'base':U
     1559       then do:
     1560         assign
     1561           p-fact-qnty         = buf_main_price-list.doc-qnty
     1562           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1563           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1564           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1565           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1566           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1567         .
     1568       end.
     1569       else do:
     1570         assign
     1571           p-fact-qnty         = buf_main_price-list.doc-qnty
     1572           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1573           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1574           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1575           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1576           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1577         .
     1578       end.
     1579         define variable v-unit-base like ub.goods.unit-base no-undo .
     1580   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1582     (input  buf_goods.gds-code
     1583     ,output v-unit-base
     1584     ) no-error .
     1585         if error-status :error
     1586         then do:
     1587           message
     1588             vss-workfile vss-revision vss-description skip
     1589             vss-include-info7 skip
     1590             "Ошибка при определении базовой единицы измерения товара" skip
     1591             "Код товара" buf_goods.gds-code skip
     1592             error-status :get-message(1) skip
     1593             return-value skip
     1594             view-as alert-box error .
     1595           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1596         end.
     1597         for each buf_price-list no-lock
     1598           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1599             and buf_price-list.main-price = false
     1600             and buf_price-list.artic      = buf_main_price-list.artic
     1601             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1602             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1603         :
     1604           if buf_price-list.doc-qnty = ?
     1605           then do:
     1606             find first buf_bar-code no-lock
     1607               where buf_bar-code.b-code = buf_price-list.b-code
     1608               no-error .
     1609             if available buf_bar-code
     1610             and buf_bar-code.unit-cli = v-unit-base
     1611             then do:
     1612               message
     1613                 vss-workfile vss-revision vss-description skip
     1614                 vss-include-info7 skip
     1615                 "Ошибка при закрытии переоценки" skip
     1616                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1617                 "Переоценка" buf_main_price-list.doc-num skip
     1618                 "Бар-код" buf_price-list.b-code skip
     1619                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1620                 "Количество" buf_price-list.doc-qnty skip
     1621                 "Основная единица измерения" v-unit-base skip
     1622                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1623                 view-as alert-box error .
     1624               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1625             end.
     1626             next .
     1627           end.
     1628           if not can-find
     1629             (first buf_bar-code
     1630             where buf_bar-code.b-code = buf_price-list.b-code
     1631             )
     1632           then do:
     1633             message
     1634               vss-workfile vss-revision vss-description skip
     1635               vss-include-info7 skip
     1636               "В переоценке задан несуществующий бар-код" skip
     1637               "Переоценка" buf_price-list.doc-num skip
     1638               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1639               "Бар-код" buf_price-list.b-code skip
     1640               view-as alert-box error .
     1641             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1642           end.
     1643           if buf_price-list.doc-qnty <> 0
     1644           then do:
     1645             run prl-vat in this-procedure
     1646               (input  recid(buf_price-list)
     1647               ,output price-rubl-with-tax-sale-prl
     1648               ,output price-base-with-tax-sale-prl
     1649               ,output price-rubl-without-tax-sale-prl
     1650               ,output price-base-without-tax-sale-prl
     1651               ,output vat-base-sale-prl
     1652               ,output vat-rubl-sale-prl
     1653               ,output vat-base-buyer-prl
     1654               ,output vat-rubl-buyer-prl
     1655               ,output slt-base-sale-prl
     1656               ,output slt-rubl-sale-prl
     1657               ,output road-tax-base-sale-prl
     1658               ,output road-tax-rubl-sale-prl
     1659               ,output excise-base-sale-prl
     1660               ,output excise-rubl-sale-prl
     1661               ,output discnt-base-sale-prl
     1662               ,output discnt-rubl-sale-prl
     1663               ) no-error .
     1664             if error-status :error
     1665             then do:
     1666               message
     1667                 vss-workfile vss-revision vss-description skip
     1668                 vss-include-info7 skip
     1669                 "Ошибка при вызове процеды prl-vat" skip
     1670                 "Документ" buf_price-list.doc-num skip
     1671                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1672                 error-status :get-message(1) skip
     1673                 return-value skip
     1674                 view-as alert-box error .
     1675               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1676             end.
     1677           end.
     1678           else do:
     1679             assign
     1680               price-rubl-with-tax-sale-prl    = 0
     1681               price-base-with-tax-sale-prl    = 0
     1682               price-rubl-without-tax-sale-prl = 0
     1683               price-base-without-tax-sale-prl = 0
     1684               vat-base-sale-prl               = 0
     1685               vat-rubl-sale-prl               = 0
     1686               vat-base-buyer-prl              = 0
     1687               vat-rubl-buyer-prl              = 0
     1688               slt-base-sale-prl               = 0
     1689               slt-rubl-sale-prl               = 0
     1690               road-tax-base-sale-prl          = 0
     1691               road-tax-rubl-sale-prl          = 0
     1692               excise-base-sale-prl            = 0
     1693               excise-rubl-sale-prl            = 0
     1694               discnt-base-sale-prl            = 0
     1695               discnt-rubl-sale-prl            = 0
     1696             .
     1697           end.
     1698           if v-curr-r-b = 'base':U
     1699           then do:
     1700             assign
     1701               p-fact-qnty         = p-fact-qnty
     1702                                   + buf_price-list.doc-qnty
     1703               p-cur-base          = p-cur-base
     1704                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1705               p-cur-VAT-base      = p-cur-VAT-base
     1706                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1707               p-cur-SLT-base      = p-cur-SLT-base
     1708                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1709               p-cur-road-tax-base = p-cur-road-tax-base
     1710                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1711               p-cur-excise-base   = p-cur-excise-base
     1712                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1713             .
     1714           end.
     1715           else do:
     1716             assign
     1717               p-fact-qnty         = p-fact-qnty
     1718                                   + buf_price-list.doc-qnty
     1719               p-cur-base          = p-cur-base
     1720                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1721               p-cur-VAT-base      = p-cur-VAT-base
     1722                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1723               p-cur-SLT-base      = p-cur-SLT-base
     1724                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1725               p-cur-road-tax-base = p-cur-road-tax-base
     1726                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1727               p-cur-excise-base   = p-cur-excise-base
     1728                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1729             .
     1730           end.
     1731         end.
     1732     end.
     1733   end procedure.
     1734   procedure prdoclib-calc-prc :
     1735     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1736     define input  parameter p-cons-pay        as   integer                no-undo.
     1737     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1738     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1739     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1740     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1741     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1742     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1743     do
     1744     on error undo, return error return-value
     1745     :
     1746       define buffer buf_price-doc       for ub.price-doc .
     1747       define buffer buf_price-list      for ub.price-list .
     1748       define buffer buf_parts           for ub.parts .
     1749       define variable v-ov-qnty     as decimal   no-undo .
     1750       define variable v-ov-base     as decimal   no-undo .
     1751       define variable v-ov-VAT-base as decimal   no-undo .
     1752       define variable v-ov-SLT-base as decimal   no-undo .
     1753       define variable v-cons-qnty   as decimal   no-undo .
     1754       define variable v-prch-qnty   as decimal   no-undo .
     1755       define variable v-cons-mult   as decimal   no-undo .
     1756       define variable v-prch-mult   as decimal   no-undo .
     1757       find first buf_price-doc no-lock
     1758         where recid(buf_price-doc) = p-price-doc-recid
     1759         no-error .
     1760       if not available buf_price-doc
     1761       then do:
     1762         message
     1763           vss-workfile vss-revision vss-description skip
     1764           vss-include-info7 skip
     1765           "Ошибка задания входных параметров" skip
     1766           "Не найден документ переоценки" skip
     1767           "Код записи (recid)" p-price-doc-recid skip
     1768           view-as alert-box error .
     1769         undo, return error .
     1770       end.
     1771       for each buf_price-list no-lock
     1772         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1773           and buf_price-list.main-price = true
     1774       on error undo, return error return-value
     1775       :
     1776         run prdoclib-calc-ov
     1777           (input recid(buf_price-list)
     1778           ,output v-ov-qnty
     1779           ,output v-ov-base
     1780           ,output v-ov-VAT-base
     1781           ,output v-ov-SLT-base
     1782           ) no-error .
     1783         if error-status :error
     1784         then do:
     1785           if error-status :get-message(1) <> ""
     1786           then do:
     1787             message
     1788               vss-workfile vss-revision vss-description skip
     1789               vss-include-info7 skip
     1790               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1791               error-status :get-message(1) skip
     1792               return-value skip
     1793               view-as alert-box error .
     1794           end.
     1795           undo, return error return-value .
     1796         end.
     1797         assign
     1798           v-cons-qnty = 0
     1799           v-prch-qnty = 0
     1800         .
     1801         for each buf_parts no-lock
     1802           where buf_parts.out-code  = buf_price-list.doc-num
     1803             and buf_parts.obj-type  = buf_price-list.obj-type
     1804             and buf_parts.obj-code  = buf_price-list.obj-code
     1805             and buf_parts.artic     = buf_price-list.artic
     1806             and buf_parts.prod-type = buf_price-list.prod-type
     1807             and buf_parts.prod-code = buf_price-list.prod-code
     1808         on error undo, return error return-value
     1809         :
     1810           if buf_parts.pay-code = p-cons-pay
     1811           then do:
     1812             assign
     1813               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1814             .
     1815           end.
     1816           else do:
     1817             assign
     1818               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1819             .
     1820           end.
     1821         end.
     1822         if (v-cons-qnty + v-prch-qnty) = 0
     1823         then do:
     1824           assign
     1825             v-cons-mult = 0
     1826             v-prch-mult = 1
     1827           .
     1828         end.
     1829         else do:
     1830           assign
     1831             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1832             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1833           .
     1834         end.
     1835         assign
     1836           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1837           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1838           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1839           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1840           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1841           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1842         .
     1843       end.
     1844     end.
     1845   end procedure.
     1846   procedure prdoclib-calc-ov :
     1847     define input  parameter p-price-list-recid as recid     no-undo .
     1848     define output parameter p-fact-qnty        as decimal   no-undo .
     1849     define output parameter p-ov-base          as decimal   no-undo .
     1850     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1851     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       define buffer buf_main_price-list    for ub.price-list .
     1856       define buffer buf_prev_price-list    for ub.price-list .
     1857       define buffer buf_special_price-list for ub.price-list .
     1858       define buffer buf_goods              for ub.goods .
     1859       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1860       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1861       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1862       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1863       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1864       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1865       define variable v-prev-price-list-recid as   recid                  no-undo.
     1866       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1867       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1868       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1869       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1870       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1871       find first buf_main_price-list no-lock
     1872         where recid(buf_main_price-list) = p-price-list-recid
     1873         no-error .
     1874       if not available buf_main_price-list
     1875       then do:
     1876         message
     1877           vss-workfile vss-revision vss-description skip
     1878           vss-include-info7 skip
     1879           "Ошибка задания входных параметров" skip
     1880           "Не найдена строка переоценки" skip
     1881           "Код записи (recid)" p-price-list-recid skip
     1882           view-as alert-box error .
     1883         undo, return error .
     1884       end.
     1885       if buf_main_price-list.main-price <> true
     1886       then do:
     1887         message
     1888           vss-workfile vss-revision vss-description skip
     1889           vss-include-info7 skip
     1890           "Ошибка задания входных параметров" skip
     1891           "Строка переоценки не является основной" skip
     1892           "Код записи (recid)" p-price-list-recid skip
     1893           "Переоценка" buf_main_price-list.doc-num skip
     1894           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1895           "Бар-код" buf_main_price-list.b-code skip
     1896           view-as alert-box error .
     1897         undo, return error .
     1898       end.
     1899       run prdoclib-calc-fact-sale in this-procedure
     1900         (input  recid(buf_main_price-list)
     1901         ,output v-fact-qnty
     1902         ,output v-cur-base
     1903         ,output v-cur-VAT-base
     1904         ,output v-cur-SLT-base
     1905         ,output v-cur-road-tax-base
     1906         ,output v-cur-excise-base
     1907         ) no-error.
     1908       if error-status :error
     1909       then do:
     1910         message
     1911           vss-workfile vss-revision vss-description skip
     1912           vss-include-info7 skip
     1913           "Ошибка при расчете сумм переоценки." skip
     1914           "Документ переоценки" buf_main_price-list.doc-num skip
     1915           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1916           error-status :get-message(1) skip
     1917           return-value skip
     1918           view-as alert-box error .
     1919         undo, return error .
     1920       end.
     1921   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1923     (input  buf_main_price-list.obj-type
     1924     ,input  buf_main_price-list.obj-code
     1925     ,input  buf_main_price-list.b-code
     1926     ,input  buf_main_price-list.b-code
     1927     ,input  buf_main_price-list.fact-order
     1928     ,output v-prev-price-list-recid
     1929     ,output v-prev-cli-base-rate
     1930     ) no-error .
     1931       if error-status :error
     1932       then do:
     1933         message
     1934           vss-workfile vss-revision vss-description skip
     1935           vss-include-info7 skip
     1936           "Ошибка при поиске предыдущей переоценки." skip
     1937           "Документ переоценки " buf_main_price-list.doc-num skip
     1938           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1939           error-status :get-message(1) skip
     1940           return-value skip
     1941           view-as alert-box error .
     1942         undo, return error .
     1943       end.
     1944       if v-prev-price-list-recid <> ?
     1945       then do:
     1946         find first buf_prev_price-list no-lock
     1947           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1948           .
     1949         find first buf_special_price-list no-lock
     1950           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1951             and buf_special_price-list.main-price = false
     1952             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1953             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1954             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1955             and buf_special_price-list.doc-qnty   <> ?
     1956           no-error .
     1957         if available buf_special_price-list
     1958         then do:
     1959           message
     1960             "Товар имеет специальные цены на признаки" skip
     1961             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1962             "Переоценка" buf_prev_price-list.doc-num skip
     1963             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1964             view-as alert-box error .
     1965           undo, return error .
     1966         end.
     1967         find first buf_goods no-lock
     1968           where buf_goods.artic     = buf_main_price-list.artic
     1969             and buf_goods.prod-type = buf_main_price-list.prod-type
     1970             and buf_goods.prod-code = buf_main_price-list.prod-code
     1971           no-error .
     1972         if not available buf_goods
     1973         then do:
     1974           message
     1975             vss-workfile vss-revision vss-description skip
     1976             vss-include-info7 skip
     1977             "Не найден товар" skip
     1978             "Переоценка" buf_main_price-list.doc-num skip
     1979             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1980             view-as alert-box error .
     1981           undo, return error .
     1982         end.
     1983         if buf_prev_price-list.vat-pc = ?
     1984         or buf_prev_price-list.slt-pc = ?
     1985         then do:
     1986           message
     1987             "В переоценке не заданы налоги товара" skip
     1988             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1989             "Переоценка" buf_prev_price-list.doc-num skip
     1990             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1991             "НДС" buf_prev_price-list.vat-pc skip
     1992             "НП" buf_prev_price-list.slt-pc skip
     1993             view-as alert-box error .
     1994           undo, return error return-value .
     1995         end.
     1996         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1997         assign
     1998           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1999         .
     2000         assign
     2001           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2002           v-prev-cur-VAT-base = v-fact-qnty
     2003                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2004                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2005           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2006         .
     2007         assign
     2008           p-fact-qnty   = v-fact-qnty
     2009           p-ov-base     = v-cur-base     - v-prev-cur-base
     2010           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2011           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2012         .
     2013       end.
     2014       else do:
     2015         assign
     2016           v-prev-cur-base     = 0
     2017           v-prev-cur-VAT-base = 0
     2018           v-prev-cur-SLT-base = 0
     2019           .
     2020         assign
     2021           p-fact-qnty   = v-fact-qnty
     2022           p-ov-base     = v-cur-base     - v-prev-cur-base
     2023           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2024           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2025         .
     2026       end.
     2027     end.
     2028   end procedure.
     2029   procedure prdoclib-init-prt-obj-by-factord :
     2030     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2031     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2032     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2033     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2034     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2035     define input parameter p-fact-order         as decimal   no-undo .
     2036     define input parameter p-include-fact-order as logical   no-undo .
     2037     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2038     define buffer buf_gds-obj      for ub.gds-obj .
     2039     define buffer buf_doc-line     for ub.doc-line .
     2040     define buffer buf_temp-prt-obj for temp-prt-obj .
     2041     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045       do transaction
     2046       on error undo, return error return-value
     2047       :
     2048   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2050     (input  p-obj-type
     2051     ,input  p-obj-code
     2052     ,input  p-artic
     2053     ,input  p-prod-type
     2054     ,input  p-prod-code
     2055     ,buffer buf_gds-obj
     2056     ) no-error .
     2057         if error-status :error
     2058         then do:
     2059           message
     2060             vss-workfile vss-revision vss-description skip
     2061             vss-include-info7 skip
     2062             "Невозможно найти gds-obj" skip
     2063             error-status :get-message(1) skip
     2064             return-value skip
     2065             view-as alert-box error .
     2066           undo, return error .
     2067         end.
     2068         find current buf_gds-obj exclusive-lock .
     2069       end.
     2070       run prdoclib-init-temp-prt-obj in this-procedure
     2071         (input p-obj-type
     2072         ,input p-obj-code
     2073         ,input p-artic
     2074         ,input p-prod-type
     2075         ,input p-prod-code
     2076         ,input 0
     2077         ) .
     2078       for each buf_temp-prt-obj
     2079         where buf_temp-prt-obj.is-term <> true
     2080       on error undo, return error return-value
     2081       :
     2082         delete buf_temp-prt-obj .
     2083       end.
     2084       if p-include-fact-order = true
     2085       then do:
     2086         assign
     2087          p-fact-order = p-fact-order - 0.0000000001
     2088         .
     2089       end.
     2090       for each buf_doc-line no-lock
     2091         where buf_doc-line.obj-type   = p-obj-type
     2092           and buf_doc-line.obj-code   = p-obj-code
     2093           and buf_doc-line.artic      = p-artic
     2094           and buf_doc-line.prod-type  = p-prod-type
     2095           and buf_doc-line.prod-code  = p-prod-code
     2096           and buf_doc-line.status_    = 'факт':U
     2097           and buf_doc-line.fact-order >= p-fact-order
     2098       on error undo, return error return-value
     2099       :
     2100         run prdoclib-process-document in this-procedure
     2101           (input  buf_doc-line.doc-code
     2102           ,input  p-obj-type
     2103           ,input  p-obj-code
     2104           ,input  p-artic
     2105           ,input  p-prod-type
     2106           ,input  p-prod-code
     2107           ,output v-total-gds-dtl-qnty
     2108           ) .
     2109       end.
     2110     end.
     2111   end procedure.
     2112   procedure prdoclib-process-document :
     2113     define input  parameter p-doc-code           as character no-undo .
     2114     define input  parameter p-obj-type           as character no-undo .
     2115     define input  parameter p-obj-code           as integer   no-undo .
     2116     define input  parameter p-artic              as character no-undo .
     2117     define input  parameter p-prod-type          as character no-undo .
     2118     define input  parameter p-prod-code          as integer   no-undo .
     2119     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2120     define buffer buf_trn-doc      for ub.trn-doc .
     2121     define buffer buf_gds-dtl      for ub.gds-dtl .
     2122     define buffer buf_temp-prt-obj for temp-prt-obj .
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       find first buf_trn-doc no-lock
     2127         where buf_trn-doc.doc-code = p-doc-code
     2128         no-error .
     2129       if not available buf_trn-doc then do:
     2130         message
     2131           vss-workfile vss-revision vss-description skip
     2132           vss-include-info7 skip
     2133           "Ошибка при поиске документа" skip
     2134           "Документ" p-doc-code skip
     2135           "Объект" p-obj-type p-obj-code skip
     2136           "Артикул" p-artic p-prod-type p-prod-code skip
     2137           view-as alert-box error .
     2138         undo, return error .
     2139       end.
     2140       assign
     2141         p-total-gds-dtl-qnty = 0
     2142       .
     2143       for each buf_gds-dtl no-lock
     2144         where buf_gds-dtl.doc-code  = p-doc-code
     2145           and buf_gds-dtl.artic     = p-artic
     2146           and buf_gds-dtl.prod-type = p-prod-type
     2147           and buf_gds-dtl.prod-code = p-prod-code
     2148       on error undo, return error
     2149       :
     2150         define variable v-term-node as integer   no-undo .
     2151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2152     (input  buf_gds-dtl.prt-code
     2153     ,output v-term-node
     2154     )  .
     2155         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2156           (input  v-term-node
     2157           ,buffer buf_temp-prt-obj
     2158           ) .
     2159         if buf_temp-prt-obj.is-term <> true then do:
     2160           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2161                                        ,buf_gds-dtl.prt-code
     2162                                        ) .
     2163         end.
     2164         case buf_trn-doc.doc-type :
     2165           when 'при':U or
     2166           when 'возврат':U
     2167           then do:
     2168             assign
     2169               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2170                                           - buf_gds-dtl.fact-qnty
     2171               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2172                                           - buf_gds-dtl.fact-qnty
     2173             .
     2174           end.
     2175           when 'рас':U or
     2176           when 'спи':U
     2177           then do:
     2178             assign
     2179               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2180                                           + buf_gds-dtl.fact-qnty
     2181               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2182                                           + buf_gds-dtl.fact-qnty
     2183             .
     2184           end.
     2185           when 'инв':U
     2186           then do:
     2187             assign
     2188               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2189                                           - buf_gds-dtl.doc-qnty
     2190               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2191                                           - buf_gds-dtl.doc-qnty
     2192             .
     2193           end.
     2194           otherwise do:
     2195             undo, return error substitute("Неизвестный тип документа &1"
     2196                                          ,buf_trn-doc.doc-type
     2197                                          ) .
     2198           end.
     2199         end.
     2200       end.
     2201     end.
     2202   end procedure.
     2203   procedure prdoclib-prc-pl-document :
     2204     define input  parameter p-doc-code              as character no-undo .
     2205     define input  parameter p-obj-type              as character no-undo .
     2206     define input  parameter p-obj-code              as integer   no-undo .
     2207     define input  parameter p-gds-code              as integer   no-undo .
     2208     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2209     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2210     do
     2211     on error undo, return error return-value
     2212     :
     2213       define buffer buf_trn-doc      for ub.trn-doc .
     2214       define buffer buf_doc-pl       for ub.doc-pl .
     2215       define buffer buf_temp-pl-gds for temp-pl-gds .
     2216       define variable v-sign as decimal   no-undo .
     2217       find first buf_trn-doc no-lock
     2218         where buf_trn-doc.doc-code = p-doc-code
     2219         no-error .
     2220       if not available buf_trn-doc then do:
     2221         message
     2222           vss-workfile vss-revision vss-description skip
     2223           vss-include-info7 skip
     2224           "Ошибка при поиске документа" skip
     2225           "Документ" p-doc-code skip
     2226           "Объект" p-obj-type p-obj-code skip
     2227           "Товар" p-gds-code skip
     2228           view-as alert-box error .
     2229         undo, return error .
     2230       end.
     2231       assign
     2232         p-total-pl-gds-qnty     = 0
     2233         p-total-pl-gds-cli-qnty = 0
     2234       .
     2235       for each buf_doc-pl no-lock
     2236         where buf_doc-pl.out-code  = p-doc-code
     2237           and buf_doc-pl.gds-code  = p-gds-code
     2238       on error undo, return error return-value
     2239       :
     2240         find first buf_temp-pl-gds
     2241           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2242             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2243             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2244           .
     2245         case buf_trn-doc.doc-type :
     2246           when 'при':U
     2247           or when 'возврат':U
     2248           or when 'инв':U
     2249           then do:
     2250             assign
     2251               v-sign = -1.0
     2252             .
     2253           end.
     2254           when 'рас':U or
     2255           when 'спи':U
     2256           then do:
     2257             assign
     2258               v-sign = 1.0
     2259             .
     2260           end.
     2261           otherwise do:
     2262             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2263           end.
     2264         end case.
     2265         assign
     2266           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2267           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2268           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2269           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2270         .
     2271       end.
     2272     end.
     2273   end procedure.
     2274   procedure prdoclib-init-prt-obj-by-date :
     2275     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2276     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2277     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2278     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2279     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2280     define input parameter p-fact-date  as date      no-undo .
     2281     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2282     do
     2283     on error undo, return error return-value
     2284     :
     2285       define variable v-fact-order                as decimal   no-undo .
     2286       define variable v-shift-end-fact-order      as decimal   no-undo .
     2287       define variable v-day-end-fact-order        as decimal   no-undo .
     2288       run factord in this-procedure
     2289         (input  p-fact-date
     2290         ,input  1
     2291         ,input  1
     2292         ,input  ?
     2293         ,input  0
     2294         ,input  false
     2295         ,output v-fact-order
     2296         ,output v-shift-end-fact-order
     2297         ,output v-day-end-fact-order
     2298         ) no-error .
     2299       if error-status :error
     2300       then do:
     2301         message
     2302           vss-workfile vss-revision vss-description skip
     2303           vss-include-info7 skip
     2304           "Ошибка при определении момента времени, на который требуется остаток" skip
     2305           "Объект" p-obj-type p-obj-code skip
     2306           "Артикул" p-artic p-prod-type p-prod-code skip
     2307           "Дата" p-fact-date skip
     2308           view-as alert-box error .
     2309         undo, return error .
     2310       end.
     2311       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2312         (input p-obj-type
     2313         ,input p-obj-code
     2314         ,input p-artic
     2315         ,input p-prod-type
     2316         ,input p-prod-code
     2317         ,input v-day-end-fact-order
     2318         ,input false
     2319         ) no-error .
     2320       if error-status :error
     2321       then do:
     2322         message
     2323           vss-workfile vss-revision vss-description skip
     2324           vss-include-info7 skip
     2325           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2326           "Объект" p-obj-type p-obj-code skip
     2327           "Артикул" p-artic p-prod-type p-prod-code skip
     2328           "Дата" p-fact-date skip
     2329           view-as alert-box error .
     2330         undo, return error .
     2331       end.
     2332     end.
     2333   end procedure.
     2334   procedure prdoclib-calc-temp-fact-sale :
     2335     define input  parameter p-obj-type           as character no-undo .
     2336     define input  parameter p-obj-code           as integer   no-undo .
     2337     define input  parameter p-gds-code           as integer   no-undo .
     2338     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2339     define input  parameter p-curr-r-b           as character no-undo .
     2340     define output parameter p-fact-qnty          as decimal   no-undo .
     2341     define output parameter p-cur-base           as decimal   no-undo .
     2342     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2343     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2344     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2345     define output parameter p-cur-excise-base    as decimal   no-undo .
     2346     define buffer buf_temp-prt-obj for temp-prt-obj .
     2347     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2348     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2349     define variable parrecid-prl        as recid     no-undo .
     2350     define variable v-fact-qnty         as decimal   no-undo .
     2351     define variable v-cur-base          as decimal   no-undo .
     2352     define variable v-cur-VAT-base      as decimal   no-undo .
     2353     define variable v-cur-SLT-base      as decimal   no-undo .
     2354     define variable v-cur-road-tax-base as decimal   no-undo .
     2355     define variable v-cur-excise-base   as decimal   no-undo .
     2356     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2357     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2358     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2359     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2360     define variable vat-base-sale-prl               as decimal   no-undo .
     2361     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2362     define variable vat-base-buyer-prl              as decimal   no-undo .
     2363     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2364     define variable slt-base-sale-prl               as decimal   no-undo .
     2365     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2366     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2367     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2368     define variable excise-base-sale-prl            as decimal   no-undo .
     2369     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2370     define variable discnt-base-sale-prl            as decimal   no-undo .
     2371     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       for each buf_temp-prt-obj no-lock
     2376       on error undo, return error return-value
     2377       :
     2378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2379     (input  p-gds-code
     2380     ,input  buf_temp-prt-obj.prt-code
     2381     ,output v-prt-b-code
     2382     ) no-error .
     2383         if error-status :error
     2384         then do:
     2385           message
     2386             vss-workfile vss-revision vss-description skip
     2387             "Ошибка при определении бар-кода признака" skip
     2388             "Код товара"   p-gds-code skip
     2389             "Код признака" buf_temp-prt-obj.prt-code skip
     2390             error-status :get-message(1) skip
     2391             return-value skip
     2392             view-as alert-box error .
     2393           undo, return error .
     2394         end.
     2395   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2397     (input  p-obj-type
     2398     ,input  p-obj-code
     2399     ,input  v-prt-b-code
     2400     ,input  0
     2401     ,input  p-day-end-fact-order
     2402     ,output parrecid-prl
     2403     ,output v-cli-base-rate
     2404     ) no-error .
     2405         if error-status :error
     2406         then do:
     2407           message
     2408             vss-workfile vss-revision vss-description skip
     2409             "Ошибка при определении цены бар-кода" skip
     2410             "Объект" p-obj-type p-obj-code skip
     2411             "Бар-код" v-prt-b-code skip
     2412             "fact-order" p-day-end-fact-order skip
     2413             error-status :get-message(1) skip
     2414             return-value skip
     2415             view-as alert-box error .
     2416           undo, return error .
     2417         end.
     2418         if parrecid-prl <> ?
     2419         then do:
     2420           run prl-vat in this-procedure
     2421             (input  parrecid-prl
     2422             ,output price-rubl-with-tax-sale-prl
     2423             ,output price-base-with-tax-sale-prl
     2424             ,output price-rubl-without-tax-sale-prl
     2425             ,output price-base-without-tax-sale-prl
     2426             ,output vat-base-sale-prl
     2427             ,output vat-rubl-sale-prl
     2428             ,output vat-base-buyer-prl
     2429             ,output vat-rubl-buyer-prl
     2430             ,output slt-base-sale-prl
     2431             ,output slt-rubl-sale-prl
     2432             ,output road-tax-base-sale-prl
     2433             ,output road-tax-rubl-sale-prl
     2434             ,output excise-base-sale-prl
     2435             ,output excise-rubl-sale-prl
     2436             ,output discnt-base-sale-prl
     2437             ,output discnt-rubl-sale-prl
     2438             ) no-error .
     2439           if error-status :error
     2440           then do:
     2441             message
     2442               vss-workfile vss-revision vss-description skip
     2443               "Ошибка при вызове процеды prl-vat" skip
     2444               "Объект" p-obj-type p-obj-code skip
     2445               "Код товара" p-gds-code skip
     2446               "Указатель на запись переоценки" parrecid-prl skip
     2447               error-status :get-message(1) skip
     2448               return-value skip
     2449               view-as alert-box error .
     2450             undo, return error .
     2451           end.
     2452         end.
     2453         else do:
     2454           assign
     2455             price-rubl-with-tax-sale-prl    = 0
     2456             price-base-with-tax-sale-prl    = 0
     2457             price-rubl-without-tax-sale-prl = 0
     2458             price-base-without-tax-sale-prl = 0
     2459             vat-base-sale-prl               = 0
     2460             vat-rubl-sale-prl               = 0
     2461             slt-base-sale-prl               = 0
     2462             slt-rubl-sale-prl               = 0
     2463             road-tax-base-sale-prl          = 0
     2464             road-tax-rubl-sale-prl          = 0
     2465             excise-base-sale-prl            = 0
     2466             excise-rubl-sale-prl            = 0
     2467             discnt-base-sale-prl            = 0
     2468             discnt-rubl-sale-prl            = 0
     2469           .
     2470         end.
     2471         assign
     2472           v-fact-qnty         = v-fact-qnty
     2473                               + buf_temp-prt-obj.fact-qnty
     2474           v-cur-base          = v-cur-base
     2475                               + (if p-curr-r-b = 'base':U
     2476                                   then price-base-with-tax-sale-prl
     2477                                   else price-rubl-with-tax-sale-prl
     2478                                 )
     2479                               * buf_temp-prt-obj.fact-qnty
     2480           v-cur-VAT-base      = v-cur-VAT-base
     2481                               + (if p-curr-r-b = 'base':U
     2482                                   then vat-base-sale-prl
     2483                                   else vat-rubl-sale-prl
     2484                                 )
     2485                               * buf_temp-prt-obj.fact-qnty
     2486           v-cur-SLT-base      = v-cur-SLT-base
     2487                               + (if p-curr-r-b = 'base':U
     2488                                   then slt-base-sale-prl
     2489                                   else slt-rubl-sale-prl
     2490                                 )
     2491                               * buf_temp-prt-obj.fact-qnty
     2492           v-cur-road-tax-base = v-cur-road-tax-base
     2493                               + (if p-curr-r-b = 'base':U
     2494                                   then road-tax-base-sale-prl
     2495                                   else road-tax-rubl-sale-prl
     2496                                 )
     2497                               * buf_temp-prt-obj.fact-qnty
     2498           v-cur-excise-base   = v-cur-excise-base
     2499                               + (if p-curr-r-b = 'base':U
     2500                                   then excise-base-sale-prl
     2501                                   else excise-rubl-sale-prl
     2502                                 )
     2503                               * buf_temp-prt-obj.fact-qnty
     2504         .
     2505       end.
     2506       assign
     2507         p-fact-qnty         = v-fact-qnty
     2508         p-cur-base          = v-cur-base
     2509         p-cur-VAT-base      = v-cur-VAT-base
     2510         p-cur-SLT-base      = v-cur-SLT-base
     2511         p-cur-road-tax-base = v-cur-road-tax-base
     2512         p-cur-excise-base   = v-cur-excise-base
     2513       .
     2514     end.
     2515   end procedure.
     2516   procedure prdoclib-clear-temp-pl-gds :
     2517     define buffer buf_temp-pl-gds for temp-pl-gds .
     2518     do
     2519     on error undo, return error return-value
     2520     :
     2521       for each buf_temp-pl-gds
     2522       on error undo, return error return-value
     2523       :
     2524         delete buf_temp-pl-gds .
     2525       end.
     2526     end.
     2527   end procedure.
     2528   procedure prdoclib-init-temp-pl-gds :
     2529     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2530     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2531     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2532     define buffer buf_pl-gds      for ub.pl-gds .
     2533     define buffer buf_temp-pl-gds for temp-pl-gds .
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537       run prdoclib-clear-temp-pl-gds in this-procedure .
     2538       for each buf_pl-gds
     2539         where buf_pl-gds.obj-type = p-obj-type
     2540           and buf_pl-gds.obj-code = p-obj-code
     2541           and buf_pl-gds.gds-code = p-gds-code
     2542       on error undo, return error return-value
     2543       :
     2544         create buf_temp-pl-gds .
     2545         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure prdoclib-init-pl-gds-by-factord :
     2550     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2551     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2552     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2553     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2554     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2555     define input parameter p-fact-order         as decimal   no-undo .
     2556     define input parameter p-include-fact-order as logical   no-undo .
     2557     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2558     define buffer buf_goods       for ub.goods .
     2559     define buffer buf_gds-obj     for ub.gds-obj .
     2560     define buffer buf_doc-line    for ub.doc-line .
     2561     define buffer buf_temp-pl-gds for temp-pl-gds .
     2562     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2563     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2564     do
     2565     on error undo, return error return-value
     2566     :
     2567       do transaction
     2568       on error undo, return error return-value
     2569       :
     2570   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2572     (input  p-obj-type
     2573     ,input  p-obj-code
     2574     ,input  p-artic
     2575     ,input  p-prod-type
     2576     ,input  p-prod-code
     2577     ,buffer buf_gds-obj
     2578     ) no-error .
     2579         if error-status :error
     2580         then do:
     2581           message
     2582             vss-workfile vss-revision vss-description skip
     2583             vss-include-info7 skip
     2584             "Невозможно найти gds-obj" skip
     2585             error-status :get-message(1) skip
     2586             return-value skip
     2587             view-as alert-box error .
     2588           undo, return error return-value .
     2589         end.
     2590         find current buf_gds-obj exclusive-lock .
     2591       end.
     2592       find first buf_goods no-lock
     2593         where buf_goods.artic     = p-artic
     2594           and buf_goods.prod-type = p-prod-type
     2595           and buf_goods.prod-code = p-prod-code
     2596         .
     2597       run prdoclib-init-temp-pl-gds in this-procedure
     2598         (input p-obj-type
     2599         ,input p-obj-code
     2600         ,input buf_goods.gds-code
     2601         ) .
     2602       if p-include-fact-order = true
     2603       then do:
     2604         assign
     2605          p-fact-order = p-fact-order - 0.0000000001
     2606         .
     2607       end.
     2608       for each buf_doc-line no-lock
     2609         where buf_doc-line.obj-type   = p-obj-type
     2610           and buf_doc-line.obj-code   = p-obj-code
     2611           and buf_doc-line.artic      = p-artic
     2612           and buf_doc-line.prod-type  = p-prod-type
     2613           and buf_doc-line.prod-code  = p-prod-code
     2614           and buf_doc-line.status_    = 'факт':U
     2615           and buf_doc-line.fact-order >= p-fact-order
     2616       on error undo, return error return-value
     2617       :
     2618         run prdoclib-prc-pl-document in this-procedure
     2619           ( input  buf_doc-line.doc-code
     2620            ,input  p-obj-type
     2621            ,input  p-obj-code
     2622            ,input  buf_goods.gds-code
     2623            ,output v-total-pl-gds-qnty
     2624            ,output v-total-pl-gds-cli-qnty
     2625           ) .
     2626       end.
     2627     end.
     2628   end procedure.
     2629   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2630   procedure factord :
     2631     define input  parameter p-fact-date            as date    no-undo .
     2632     define input  parameter p-fact-time            as integer no-undo .
     2633     define input  parameter p-fact-num             as integer no-undo .
     2634     define input  parameter p-shift-date           as date    no-undo .
     2635     define input  parameter p-shift-num            as integer no-undo .
     2636     define input  parameter p-shift-on             as logical no-undo .
     2637     define output parameter p-fact-order           as decimal no-undo .
     2638     define output parameter p-shift-end-fact-order as decimal no-undo .
     2639     define output parameter p-day-end-fact-order   as decimal no-undo .
     2640     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2641     if p-fact-date = ?
     2642     then do:
     2643       return error "Не указана фактическая дата" .
     2644     end.
     2645     define variable v-fact-date-num as integer no-undo .
     2646     assign
     2647       v-fact-date-num = integer(p-fact-date)
     2648     .
     2649     if p-fact-num = ?
     2650     or p-fact-num = 0
     2651     then do:
     2652       return error "Не задан p-fact-num " + string(p-fact-num) .
     2653     end.
     2654     if p-fact-num < 0
     2655     then do:
     2656       return error "Отрицательный fact-num " + string(p-fact-num) .
     2657     end.
     2658     if p-fact-num >= 100000000
     2659     then do:
     2660       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2661     end.
     2662     if p-shift-on = true
     2663     then do:
     2664       if p-shift-date = ?
     2665       then do:
     2666         return error "Не задана дата смены" .
     2667       end.
     2668       if p-shift-num = ?
     2669       or p-shift-num = 0
     2670       then do:
     2671         return error "Не задан номер смены" .
     2672       end.
     2673     end.
     2674     else do:
     2675       assign
     2676         p-shift-date = p-fact-date
     2677         p-shift-num  = 24
     2678       .
     2679     end.
     2680     define variable v-shift-offset as integer no-undo .
     2681     if p-shift-date = p-fact-date
     2682     then do:
     2683       assign
     2684         v-shift-offset = 1
     2685       .
     2686     end.
     2687     if p-shift-date < p-fact-date
     2688     then do:
     2689       assign
     2690         v-shift-offset = 0
     2691       .
     2692     end.
     2693     if p-shift-date > p-fact-date
     2694     then do:
     2695       message
     2696         vss-workfile vss-revision vss-description skip
     2697         "Неправильная дата закрытия смены" skip
     2698         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2699         view-as alert-box error .
     2700       undo, return error
     2701         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2702           ,string(p-fact-date, '99/99/9999':U)
     2703           ,string(p-shift-date, '99/99/9999':U)
     2704           )
     2705       .
     2706     end.
     2707     if p-shift-num < 1
     2708     or p-shift-num > 24
     2709     then do:
     2710       message
     2711         vss-workfile vss-revision vss-description skip
     2712         "Неправильный номер смены" skip
     2713         "p-shift-num" p-shift-num skip
     2714         view-as alert-box error .
     2715       undo, return error return-value .
     2716     end.
     2717     assign
     2718       p-fact-order           = v-fact-date-num
     2719                              + v-shift-offset * 0.5
     2720                              + p-shift-num    * 0.02 - 0.01
     2721                              + p-fact-num     * 0.0000000001
     2722       p-shift-end-fact-order = v-fact-date-num
     2723                              + v-shift-offset * 0.5
     2724                              + p-shift-num    * 0.02
     2725       p-day-end-fact-order   = v-fact-date-num
     2726                              + 0.99
     2727     .
     2728     if p-fact-order           <= v-fact-date-num
     2729     or p-shift-end-fact-order <= v-fact-date-num
     2730     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2731     or p-shift-end-fact-order >= p-day-end-fact-order
     2732     then do:
     2733       message
     2734         vss-workfile vss-revision vss-description skip
     2735         "Внутренняя ошибка при генерации фактического номера" skip
     2736         "p-fact-date"            p-fact-date            skip
     2737         "p-fact-time"            p-fact-time            skip
     2738         "p-fact-num"             p-fact-num             skip
     2739         "p-shift-date"           p-shift-date           skip
     2740         "p-shift-num"            p-shift-num            skip
     2741         "p-shift-on"             p-shift-on             skip
     2742         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2743         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2744         "v-fact-date-num"        v-fact-date-num        skip
     2745         view-as alert-box error .
     2746       undo, return error return-value .
     2747     end.
     2748   end procedure.
     2749   procedure day-begin-fact-order :
     2750     define input  parameter p-fact-date            as date    no-undo .
     2751     define output parameter p-day-begin-fact-order as decimal no-undo .
     2752     do
     2753     on error undo, return error return-value
     2754     :
     2755       if p-fact-date = ?
     2756       then do:
     2757         assign
     2758           p-day-begin-fact-order = 0
     2759         .
     2760       end.
     2761       else do:
     2762         assign
     2763           p-day-begin-fact-order = integer(p-fact-date)
     2764         .
     2765       end.
     2766     end.
     2767   end procedure.
     2768   procedure factord-max-fact-order :
     2769     define output parameter p-max-fact-order as decimal   no-undo .
     2770     do
     2771     on error undo, return error return-value
     2772     :
     2773       run day-begin-fact-order in this-procedure
     2774         (input  date(1, 1, 5000)
     2775         ,output p-max-fact-order
     2776         ) .
     2777     end.
     2778   end procedure.
     2779   procedure factord-cut-archive :
     2780     define input  parameter p-obj-type             as character no-undo .
     2781     define input  parameter p-obj-code             as integer   no-undo .
     2782     define input  parameter p-fact-date            as date      no-undo .
     2783     define output parameter p-shift-on             as logical   no-undo .
     2784     define output parameter p-shift-date           as date      no-undo .
     2785     define output parameter p-shift-num            as integer   no-undo .
     2786     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2787     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2788     define variable v-fact-order as decimal   no-undo .
     2789     define buffer buf_shift-obj for ub.shift-obj .
     2790     do
     2791     on error undo, return error return-value
     2792     :
     2793   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2795     (input  p-obj-type
     2796     ,input  p-obj-code
     2797     ,input  'shift-on=request'
     2798     ,output p-shift-on
     2799     ) no-error .
     2800       if error-status :error
     2801       then do:
     2802         message
     2803           vss-workfile vss-revision vss-description skip
     2804           "Ошибка при определении атрибута объекта" skip
     2805           "Объект" p-obj-type p-obj-code skip
     2806           error-status :get-message(1) skip
     2807           return-value skip
     2808           view-as alert-box error .
     2809         undo, return error return-value .
     2810       end.
     2811       if p-shift-on = false
     2812       then do:
     2813         assign
     2814           p-shift-date               = ?
     2815           p-shift-num                = 0
     2816         .
     2817       end.
     2818       else do:
     2819         find first buf_shift-obj share-lock
     2820           where buf_shift-obj.obj-type   = p-obj-type
     2821             and buf_shift-obj.obj-code   = p-obj-code
     2822             and buf_shift-obj.shift-date > p-fact-date
     2823           use-index pi
     2824           no-error .
     2825         if not available buf_shift-obj
     2826         or buf_shift-obj.status_ <> 'зкр':U
     2827         then do:
     2828           message
     2829             vss-workfile vss-revision vss-description skip
     2830             "Невозможно вычислить последнюю смену" skip
     2831             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2832             "Объект" p-obj-type p-obj-code skip
     2833             "Дата" p-fact-date skip
     2834             view-as alert-box error .
     2835           undo, return error return-value .
     2836         end.
     2837         find last buf_shift-obj share-lock
     2838           where buf_shift-obj.obj-type = p-obj-type
     2839             and buf_shift-obj.obj-code = p-obj-code
     2840             and buf_shift-obj.shift-date <= p-fact-date
     2841           use-index pi
     2842           no-error .
     2843         if available buf_shift-obj
     2844         then do:
     2845           if  buf_shift-obj.status_ = 'зкр':U
     2846           then do:
     2847             assign
     2848               p-shift-date = buf_shift-obj.shift-date
     2849               p-shift-num  = buf_shift-obj.shift-num
     2850             .
     2851           end.
     2852           else do:
     2853             message
     2854               vss-workfile vss-revision vss-description skip
     2855               "Невозможно вычислить последнюю смену" skip
     2856               "Статус смены отличен от статуса" 'зкр':U skip
     2857               "Объект" p-obj-type p-obj-code skip
     2858               "Дата" p-fact-date skip
     2859               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2860               view-as alert-box error .
     2861             undo, return error return-value .
     2862           end.
     2863         end.
     2864         else do:
     2865           assign
     2866             p-shift-date = p-fact-date - 1
     2867             p-shift-num  = 1
     2868           .
     2869         end.
     2870       end.
     2871       run factord in this-procedure
     2872         (input  p-fact-date
     2873         ,input  1
     2874         ,input  1
     2875         ,input  p-shift-date
     2876         ,input  p-shift-num
     2877         ,input  p-shift-on
     2878         ,output v-fact-order
     2879         ,output p-shift-end-fact-order
     2880         ,output p-day-end-fact-order
     2881         ) no-error .
     2882       if error-status :error
     2883       then do:
     2884         message
     2885           vss-workfile vss-revision vss-description skip
     2886           "Ошибка при вызове процедуры factord"
     2887           error-status :get-message(1) skip
     2888           return-value skip
     2889           view-as alert-box error .
     2890         undo, return error return-value .
     2891       end.
     2892     end.
     2893   end procedure.
     2894   procedure factord-lock-shift :
     2895     define input  parameter p-obj-type  as character no-undo .
     2896     define input  parameter p-obj-code  as integer   no-undo .
     2897     define input  parameter p-fact-date as date      no-undo .
     2898     define parameter buffer buf_shift-obj for ub.shift-obj .
     2899     define variable v-shift-on      as logical   no-undo .
     2900     define variable v-extra-message as character no-undo .
     2901     define variable v-error as character no-undo .
     2902     do
     2903     on error undo, return error return-value
     2904     :
     2905   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2907     (input  p-obj-type
     2908     ,input  p-obj-code
     2909     ,input  'shift-on=request'
     2910     ,output v-shift-on
     2911     ) no-error .
     2912       if error-status :error
     2913       then do:
     2914         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2915         undo, return error v-error .
     2916       end.
     2917       if v-shift-on = true
     2918       then do:
     2919         find first buf_shift-obj share-lock
     2920           where buf_shift-obj.obj-type   = p-obj-type
     2921             and buf_shift-obj.obj-code   = p-obj-code
     2922             and buf_shift-obj.shift-date > p-fact-date
     2923           use-index pi
     2924           no-error .
     2925         if not available buf_shift-obj
     2926         or buf_shift-obj.status_ <> 'зкр':U
     2927         then do:
     2928           find last buf_shift-obj
     2929             where buf_shift-obj.obj-type = p-obj-type
     2930               and buf_shift-obj.obj-code = p-obj-code
     2931               and buf_shift-obj.status_  = 'зкр':U
     2932             use-index stts
     2933             no-error .
     2934           if available buf_shift-obj
     2935           then do:
     2936             assign
     2937               v-extra-message =
     2938                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2939                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2940                               )
     2941             .
     2942           end.
     2943           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2944           undo, return error v-error .
     2945         end.
     2946       end.
     2947     end.
     2948   end procedure.
     2949   procedure factord-end-day :
     2950     define input  parameter p-fact-date            as date    no-undo .
     2951     define output parameter p-day-end-fact-order   as decimal no-undo .
     2952     do
     2953     on error undo, return error return-value
     2954     :
     2955       if p-fact-date = ?
     2956       then do:
     2957         return error "Не указана фактическая дата" .
     2958       end.
     2959       assign
     2960         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2961       .
     2962     end.
     2963   end procedure.
     2964   procedure factord-to-date :
     2965     define input  parameter p-fact-order as decimal no-undo .
     2966     define output parameter p-fact-date  as date    no-undo .
     2967     define variable v-ref-date  as date      no-undo .
     2968     define variable v-ref-delta as integer   no-undo .
     2969     do
     2970     on error undo, return error return-value
     2971     :
     2972       if p-fact-order = ?
     2973       or p-fact-order = 0
     2974       then do:
     2975         return error "Не указан fact-order" .
     2976       end.
     2977       assign
     2978         v-ref-date  = date(1, 1, 2000)
     2979       .
     2980       assign
     2981         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2982       .
     2983       assign
     2984         p-fact-date = v-ref-date + v-ref-delta
     2985       .
     2986     end.
     2987   end procedure.
     2988   procedure factord-to-fact-num :
     2989     define input  parameter p-fact-order as decimal no-undo .
     2990     define output parameter p-fact-num   as integer no-undo .
     2991     define variable v-fact-order-trunc as decimal no-undo .
     2992     do
     2993     on error undo, return error return-value
     2994     :
     2995       if p-fact-order = ?
     2996       or p-fact-order = 0
     2997       then do:
     2998         return error "Не указан fact-order" .
     2999       end.
     3000       assign
     3001        v-fact-order-trunc = truncate(p-fact-order, 2)
     3002       .
     3003       assign
     3004         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3005       .
     3006     end.
     3007   end procedure.
     3008   procedure factord-to-shift-num :
     3009     define input  parameter p-fact-order as decimal no-undo .
     3010     define output parameter p-shift-num   as integer no-undo .
     3011     define variable  p-shift-numd  as decimal   no-undo .
     3012     define variable v-fact-order-trunc as decimal no-undo .
     3013     do
     3014     on error undo, return error return-value
     3015     :
     3016       if p-fact-order = ?
     3017       or p-fact-order = 0
     3018       then do:
     3019         return error "Не указан fact-order" .
     3020       end.
     3021       assign
     3022        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3023       .
     3024       if v-fact-order-trunc < 0.5 then do:
     3025         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3026       end.
     3027       assign
     3028         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3029         .
     3030        assign
     3031         p-shift-num = truncate (p-shift-numd , 0)
     3032       .
     3033     end.
     3034   end procedure.
     3035   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3036   define variable v-waitfram-action01         as character   no-undo .
     3037   define variable v-waitfram-action02         as character   no-undo .
     3038   define variable v-waitfram-action03         as character   no-undo .
     3039   define variable mWaitFramTextBeg            as character   no-undo.
     3040   define variable mWaitFramTextEnd            as character   no-undo.
     3041   define variable mWaitFramView               as logical     no-undo.
     3042   define variable mWaitProcEvent              as logical     no-undo init yes.
     3043   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3044   define variable mWaitFramStop               as logical     no-undo.
     3045   define variable mWaitFramStopUser           as logical     no-undo.
     3046   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3047   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3048   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3049   define button B-WaitFramStop auto-end-key
     3050        label "Стоп"
     3051        size 10 by 1 tooltip "Остоновить процесс".
     3052   define button B-viewProcInfo
     3053        label "Информация"
     3054        size 15 by 1 tooltip "Информация о процесс".
     3055   define frame waitfram
     3056     v-waitfram-action01 format "x(72)" no-label skip
     3057     v-waitfram-action02 format "x(72)" no-label skip
     3058     v-waitfram-action03 format "x(72)" no-label skip
     3059     B-viewProcInfo
     3060     B-WaitFramStop at row 4 col 30
     3061     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3062     .
     3063   define new global shared variable mBatchMode as logical no-undo init ?.
     3064   define variable mFramBachModHandle as handle no-undo.
     3065   mFramBachModHandle = frame waitfram:handle.
     3066   define variable mFameOldVis as logical no-undo.
     3067   define variable mVisCUrentVin as logical no-undo.
     3068   if session:batch-mode
     3069   then
     3070      mBatchMode = yes.
     3071   if mBatchMode = ? then do:
     3072     mVisCUrentVin = current-window:visible.
     3073     mFameOldVis = mFramBachModHandle:visible.
     3074     mFramBachModHandle:visible  = yes.
     3075     mBatchMode = mFramBachModHandle:visible ne yes.
     3076     mFramBachModHandle:visible = mFameOldVis.
     3077     current-window:visible = mVisCUrentVin.
     3078   end.
     3079    if  log-manager:logfile-name ne ?
     3080     then DO:
     3081         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3082         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3083         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3084     end.
     3085   on choose of B-WaitFramStop in frame waitfram
     3086   do:
     3087     mWaitFramStop = yes.
     3088     mWaitFramStopUser = yes.
     3089   end.
     3090   function waitfram-check-timeout returns logical():
     3091      define variable vtime as int64 no-undo.
     3092      if mWaitFramStopTimeOut
     3093      then
     3094         return yes.
     3095      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3096      if     mWaitFramTimeOut ne ?
     3097         and mWaitFramTimeOut ne 0
     3098         and mWaitFramTimeOut lt vtime
     3099      then do:
     3100         mWaitFramStopTimeOut = yes.
     3101      end.
     3102      return mWaitFramStopTimeOut.
     3103   end.
     3104   procedure waitfram-hide :
     3105     if not session:batch-mode
     3106     then do
     3107     on error undo, return error return-value
     3108     :
     3109       pause 0 before-hide .
     3110       if not mBatchMode then
     3111         hide frame waitfram .
     3112     if     not mWaitFramView
     3113        and mWaitProcEvent
     3114     then
     3115       process events .
     3116     end.
     3117   end procedure.
     3118   procedure waitfram-show :
     3119     define input  parameter p-message as character no-undo .
     3120     define variable v-left-margin as integer   no-undo .
     3121     if not session:batch-mode
     3122     then do
     3123     on error undo, return error return-value
     3124     :
     3125       if length(p-message) <= 70 then do:
     3126         assign
     3127           v-left-margin = integer((70 - length(p-message)) / 2)
     3128         .
     3129         assign
     3130           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3131         .
     3132         assign
     3133           v-waitfram-action01 = " "
     3134           v-waitfram-action02 = " "
     3135                                    + fill(" ", v-left-margin)
     3136                                    + p-message
     3137           v-waitfram-action03 = " "
     3138         .
     3139       end.
     3140       else do:
     3141         define variable vRindex1 as integer no-undo.
     3142         define variable vRindex2 as integer no-undo.
     3143         vRindex1 = r-index(p-message," ",70).
     3144         if vRindex1 = 0
     3145         then
     3146            vRindex1 = 70.
     3147         if length(p-message)  <= vRindex1 + 70 then do:
     3148           assign
     3149             v-waitfram-action01 = " "
     3150             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3151             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3152           .
     3153         end.
     3154         else do:
     3155           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3156           if vRindex2 <= vRindex1
     3157           then
     3158              vRindex2 = vRindex1 + 70.
     3159           assign
     3160             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3161             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3162             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3163           .
     3164         end.
     3165       end.
     3166       B-viewProcInfo:visible   in frame waitfram = no.
     3167       B-viewProcInfo:sensitive in frame waitfram = no.
     3168       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3169       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3170       if  (   mWaitFramView
     3171          or  mWaitProcEvent)
     3172          and not mBatchMode
     3173       then
     3174          display
     3175             v-waitfram-action01 skip
     3176             v-waitfram-action02 skip
     3177             v-waitfram-action03 skip
     3178          with frame waitfram .
     3179       if     mWaitFramView
     3180          then do:
     3181             if     mWaitFramInterval ne ?
     3182                and not mBatchMode
     3183             then
     3184                wait-for go of frame waitfram pause mWaitFramInterval.
     3185          end.
     3186          else
     3187             if     mWaitProcEvent
     3188                and not mBatchMode
     3189             then
     3190                process events .
     3191     end.
     3192   end procedure.
     3193      procedure waitfram-show-this:
     3194         define input  parameter iInterval as int64 no-undo.
     3195         define variable vtime as int64 no-undo.
     3196         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3197         mWaitFramInterval = iInterval.
     3198         run waitfram-show (substitute("&1&2 &3&4" ,
     3199                                       mWaitFramTextBeg ,
     3200                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3201                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3202                                       mWaitFramTextEnd
     3203                                      )
     3204                           ).
     3205      end.
     3206      procedure WaitFramRunPause:
     3207         define input  parameter iInterval as dec no-undo.
     3208         define variable vStart  as datetime-tz no-undo.
     3209         define variable vend    as datetime-tz no-undo.
     3210         define variable vint as int64 no-undo.
     3211         define variable vOk as logical no-undo.
     3212         vStart = now.
     3213         vend   = vStart.
     3214         publish "WaitFramPause" (iInterval,output vOk).
     3215         vend   =  now.
     3216         vint = vend - vStart.
     3217         vint = iInterval - vint / 1000.
     3218         if     not mWaitFramStop
     3219            and (   vint > 0
     3220                 or (    not vOk
     3221                     and iInterval eq ?
     3222                     )
     3223                 )
     3224         then
     3225            run waitfram-show-this (iInterval).
     3226         vend   =  now.
     3227         vint = vend - vStart.
     3228         vint = iInterval - vint / 1000.
     3229         if     not mWaitFramStop
     3230            and vint > 0
     3231         then do:
     3232            run gbl/pause.p (vint * 1000).
     3233         end.
     3234         if iInterval ne ?
     3235         then
     3236            publish "WaitFramStop".
     3237         waitfram-check-timeout().
     3238      end.
     3239      procedure WaitFramWaitFor:
     3240         define input  parameter iInterval as dec no-undo.
     3241         assign
     3242            mWaitFramStartProc   = now
     3243            mWaitFramStopUser    = no
     3244            mWaitFramStopTimeOut = no
     3245         .
     3246         block-wait:
     3247         do while not mWaitFramStop:
     3248            run WaitFramRunPause (iInterval).
     3249            if  waitfram-check-timeout()
     3250            then do:
     3251               leave block-wait.
     3252            end.
     3253         end.
     3254         run waitfram-hide.
     3255      end.
     3256   procedure waitfram-join :
     3257     define input  parameter p-line-1  as character no-undo .
     3258     define input  parameter p-line-2  as character no-undo .
     3259     define input  parameter p-line-3  as character no-undo .
     3260     define output parameter p-message as character no-undo .
     3261     do
     3262     on error undo, return error return-value
     3263     :
     3264       assign
     3265         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3266                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3267                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3268       .
     3269     end.
     3270   end procedure.
     3271   function waitfram-join-function returns character
     3272     (input p-line-1 as character
     3273     ,input p-line-2 as character
     3274     ,input p-line-3 as character
     3275     ).
     3276     define variable v-message as character no-undo .
     3277     run waitfram-join in this-procedure
     3278       (input  p-line-1
     3279       ,input  p-line-2
     3280       ,input  p-line-3
     3281       ,output v-message
     3282       ) .
     3283     return v-message .
     3284   end function .
     3285   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3286   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     3287   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     3288   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     3289   define variable gp-excise     like ub.price-list.excise     no-undo.
     3290   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     3291   define variable gp-fact-order as decimal   no-undo .
     3292   define variable gp-price-sale-parts as decimal   no-undo .
     3293   define buffer inv_trn-doc   for ub.trn-doc  .
     3294   define buffer inv_doc-line  for ub.doc-line .
     3295   define buffer next_trn-doc  for ub.trn-doc  .
     3296   define buffer next_doc-line for ub.doc-line .
     3297   define temp-table temp-tt no-undo
     3298   field doc-code   as character
     3299   field fact-order as decimal
     3300   field fact-date  as date
     3301   index pi1
     3302         fact-order
     3303         doc-code
     3304   .
     3305   define temp-table temp-tt-goods no-undo
     3306   field doc-code  as character
     3307   field artic     as character
     3308   field prod-type as character
     3309   field prod-code as integer
     3310   index pi1
     3311         doc-code
     3312         artic
     3313         prod-type
     3314         prod-code
     3315   .
     3316   define variable v-fact-order-end as decimal   no-undo .
     3317   find first  inv_trn-doc no-lock where
     3318        recid (inv_trn-doc) = par-recid no-error .
     3319   run waitfram-show in this-procedure ( "Проверка последующих инвентаризаций") .
     3320   for each temp-tt : delete temp-tt . end.
     3321   define variable all-invent as character no-undo .
     3322   define variable x-inv as character no-undo .
     3323   define variable i as integer   no-undo .
     3324   define variable nei as integer   no-undo .
     3325   all-invent = 'vt':U               + "," +
     3326                'vp':U          + "," +
     3327                'ap':U
     3328                .
     3329   nei = num-entries( all-invent ).
     3330   repeat  i =  1 to nei :
     3331   x-inv = entry ( i , all-invent ) .
     3332   for each inv_doc-line no-lock where
     3333            inv_doc-line.doc-code = inv_trn-doc.doc-code :
     3334           for each next_doc-line exclusive-lock where
     3335                    next_doc-line.obj-type  = inv_doc-line.obj-type and
     3336                    next_doc-line.obj-code  = inv_doc-line.obj-code and
     3337                    next_doc-line.artic     = inv_doc-line.artic and
     3338                    next_doc-line.prod-type = inv_doc-line.prod-type and
     3339                    next_doc-line.prod-code = inv_doc-line.prod-code and
     3340                    next_doc-line.status_      = 'факт':U and
     3341                    next_doc-line.ext-doc-type = x-inv and
     3342                    next_doc-line.fact-order   > inv_trn-doc.fact-order ,
     3343               first next_trn-doc exclusive-lock where
     3344                     next_trn-doc.doc-code     = next_doc-line.doc-code  and
     3345                     next_trn-doc.fact-date   >= inv_trn-doc.fact-date and
     3346                     next_trn-doc.status_      = 'факт':U
     3347                     :
     3348                     find first temp-tt where
     3349                                temp-tt.doc-code   = next_trn-doc.doc-code   and
     3350                                temp-tt.fact-order = next_trn-doc.fact-order
     3351                                no-error .
     3352                               if not available temp-tt then do:
     3353                                   create temp-tt.
     3354                                   assign
     3355                                     temp-tt.doc-code   = next_trn-doc.doc-code
     3356                                     temp-tt.fact-order = next_trn-doc.fact-order
     3357                                     temp-tt.fact-date = next_trn-doc.fact-date
     3358                                   .
     3359                               end.
     3360                               create temp-tt-goods.
     3361                               assign
     3362                                 temp-tt-goods.doc-code   = next_trn-doc.doc-code
     3363                                 temp-tt-goods.artic      = next_doc-line.artic
     3364                                 temp-tt-goods.prod-type  = next_doc-line.prod-type
     3365                                 temp-tt-goods.prod-code  = next_doc-line.prod-code
     3366                               .
     3367           end.
     3368   end.
     3369   end.
     3370   define variable v-param-value as character no-undo .
     3371   define variable v-param-type  as character no-undo .
     3372   find first  temp-tt  no-error .
     3373   if available temp-tt then do:
     3374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3375     (input  'inv-fix'
     3376     ,input  0
     3377     ,input  '':U
     3378     ,input  0
     3379     ,input  '':U
     3380     ,input  '':U
     3381     ,input  '':U
     3382     ,input  no
     3383     ,output v-param-value
     3384     ,output v-param-type
     3385     ) no-error .
     3386      if error-status :error  then v-param-value = "no" .
     3387      else do:
     3388        if v-param-value <> "yes" then v-param-value = "no" .
     3389      end.
     3390      if v-param-value = "no" then
     3391         return error substitute ( "Документ нельзя закрыть или удалить , так как существует инвентаризация после него &1 &3 (&2) установлен параметр inv-fix=&4"  ,temp-tt.doc-code , temp-tt.fact-order , temp-tt.fact-date  , v-param-value ) .
     3392   end.
     3393   for each temp-tt by temp-tt.fact-order :
     3394       run waitfram-show  in this-procedure
     3395         (input substitute(" Пересчет документа инвентаризации &1  " , temp-tt.doc-code )).
     3396       run proc-recalc in this-procedure ( temp-tt.doc-code  ) .
     3397   end.
     3398   run waitfram-hide in this-procedure .
     3399   procedure proc-recalc :
     3400   define input  parameter p-doc-code as character no-undo .
     3401   define buffer buf_trn-doc for ub.trn-doc  .
     3402     do
     3403     on error undo, return error return-value
     3404     :
     3405     find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = p-doc-code no-error .
     3406     if error-status :error then message
     3407       vss-workfile vss-revision vss-description skip
     3408       error-status :get-message(1) skip
     3409       return-value skip
     3410       "Ошибка поиска"
     3411       view-as alert-box error
     3412     .
     3413       v-fact-order-end =  buf_trn-doc.fact-order.
     3414       for each temp-tt-goods where temp-tt-goods.doc-code = p-doc-code :
     3415          run proc-recalc-line in this-procedure
     3416              ( temp-tt-goods.doc-code  ,
     3417                temp-tt-goods.artic     ,
     3418                temp-tt-goods.prod-type ,
     3419                temp-tt-goods.prod-code
     3420              ).
     3421       end.
     3422       run gbl/calc-trn.p (input parparentproc, input recid(buf_trn-doc)) no-error .
     3423       if error-status :error then
     3424       message
     3425         vss-workfile vss-revision vss-description skip
     3426         error-status :get-message(1) skip
     3427         return-value skip
     3428         "Ошибка gbl/calc-trn.p"
     3429         view-as alert-box error
     3430       .
     3431        run str/clcsumga.p ( input buf_trn-doc.doc-code ) no-error  .
     3432        if error-status :error then
     3433        message
     3434          vss-workfile vss-revision vss-description skip
     3435          error-status :get-message(1) skip
     3436          return-value skip
     3437          "Ошибка str/clcsumga.p"
     3438          view-as alert-box error
     3439        .
     3440     run str/trn-hist.p
     3441       ( buffer buf_trn-doc ,
     3442         input  buf_trn-doc.obj-type ,
     3443         input  buf_trn-doc.obj-code ,
     3444         input  "Пересчет инв."
     3445       ) no-error .
     3446       buf_trn-doc.ps = trim(buf_trn-doc.ps) + substitute(" Пересчитана по накладной № &1 ", inv_trn-doc.doc-code ).
     3447     end.
     3448   end procedure.
     3449   procedure proc-recalc-line :
     3450   define input  parameter p-doc-code  as character no-undo .
     3451   define input  parameter p-artic     as character no-undo .
     3452   define input  parameter p-prod-type as character no-undo .
     3453   define input  parameter p-prod-code as integer   no-undo .
     3454   define buffer buf_doc-line for ub.doc-line  .
     3455   define buffer buf_gds-dtl  for ub.gds-dtl .
     3456     do
     3457     on error undo, return error return-value
     3458     :
     3459   find first buf_doc-line exclusive-lock where
     3460         buf_doc-line.doc-code  = p-doc-code  and
     3461         buf_doc-line.artic     = p-artic     and
     3462         buf_doc-line.prod-type = p-prod-type and
     3463         buf_doc-line.prod-code = p-prod-code no-error .
     3464         if error-status :error then message
     3465           vss-workfile vss-revision vss-description skip
     3466           error-status :get-message(1) skip
     3467           return-value skip
     3468           ""
     3469           view-as alert-box error
     3470         .
     3471    run doc-qnty-by-factord in this-procedure (
     3472         input  buf_doc-line.obj-type ,
     3473         input  buf_doc-line.obj-code ,
     3474         input  buf_doc-line.artic    ,
     3475         input  buf_doc-line.prod-type,
     3476         input  buf_doc-line.prod-code,
     3477         input   v-fact-order-end     ,
     3478         output  buf_doc-line.doc-qnty ) .
     3479      for each buf_gds-dtl exclusive-lock where
     3480               buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     3481               buf_gds-dtl.artic     = buf_doc-line.artic     and
     3482               buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     3483               buf_gds-dtl.prod-code = buf_doc-line.prod-code  :
     3484         run doc-qnty-by-factord-prt in this-procedure (
     3485             input   buf_doc-line.obj-type ,
     3486             input   buf_doc-line.obj-code ,
     3487             input   buf_doc-line.artic    ,
     3488             input   buf_doc-line.prod-type,
     3489             input   buf_doc-line.prod-code,
     3490             input   buf_gds-dtl.prt-code  ,
     3491             input   v-fact-order-end  ,
     3492             output  buf_gds-dtl.fact-qnty  ).
     3493       end.
     3494     end.
     3495   end procedure.
     3496   procedure def-factorder :
     3497   define input  parameter par-recid     as recid no-undo .
     3498   define output parameter v-fact-order-end as decimal   no-undo .
     3499   define variable v-shift-on  as logical   no-undo .
     3500   define variable v-shift-end-fact-order as decimal   no-undo .
     3501   define variable v-day-end-fact-order   as decimal   no-undo .
     3502   define buffer buf_trn-doc for ub.trn-doc  .
     3503     do
     3504     on error undo, return error return-value
     3505     :
     3506   find first buf_trn-doc no-lock  where recid(buf_trn-doc) =  par-recid no-error .
     3507   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3509     (input  buf_trn-doc.obj-type
     3510     ,input  buf_trn-doc.obj-code
     3511     ,input  'shift-on=request'
     3512     ,output v-shift-on
     3513     ) no-error .
     3514       if error-status :error then do:
     3515         message
     3516             vss-workfile vss-revision vss-description
     3517             skip "Ошибка при запросе, включены ли смены"
     3518             skip error-status :get-message(1)
     3519             skip return-value
     3520         view-as alert-box error .
     3521         undo, return error .
     3522       end.
     3523           run factord in this-procedure (
     3524                 input  buf_trn-doc.fact-date
     3525               , input  buf_trn-doc.fact-time
     3526               , input  buf_trn-doc.fact-time
     3527               , input  buf_trn-doc.shift-date
     3528               , input  buf_trn-doc.shift-num
     3529               , input  v-shift-on
     3530               , output v-fact-order-end
     3531               , output v-shift-end-fact-order
     3532               , output v-day-end-fact-order
     3533           ) no-error .
     3534        if v-shift-on = true then  v-fact-order-end = v-shift-end-fact-order .
     3535                             else  v-fact-order-end = v-day-end-fact-order .
     3536     end.
     3537   end procedure.
     3538   procedure doc-qnty-by-factord-prt :
     3539   define input  parameter par-obj-type  like ub.doc-line.obj-type  no-undo .
     3540   define input  parameter par-obj-code  like ub.doc-line.obj-code  no-undo .
     3541   define input  parameter par-artic     like ub.doc-line.artic     no-undo .
     3542   define input  parameter par-prod-type like ub.doc-line.prod-type no-undo .
     3543   define input  parameter par-prod-code like ub.doc-line.prod-code no-undo .
     3544   define input  parameter par-prt-code  like ub.prt-obj.prt-code no-undo .
     3545   define input  parameter par-fact-order-end as decimal   no-undo .
     3546   define output parameter v-doc-qnty    as decimal   no-undo .
     3547     do
     3548     on error undo, return error return-value
     3549     :
     3550   v-doc-qnty = 0 .
     3551     run prdoclib-init-prt-obj-by-factord in this-procedure
     3552       ( input par-obj-type,
     3553         input par-obj-code,
     3554         input par-artic,
     3555         input par-prod-type,
     3556         input par-prod-code,
     3557         input par-fact-order-end,
     3558         input false ) .
     3559         v-doc-qnty =  0 .
     3560         for each temp-prt-obj where temp-prt-obj.prt-code  = par-prt-code :
     3561           v-doc-qnty = v-doc-qnty +  temp-prt-obj.fact-qnty .
     3562         end.
     3563   end.
     3564   end procedure.
     3565   procedure doc-qnty-by-factord :
     3566   define input  parameter par-obj-type  like ub.doc-line.obj-type  no-undo .
     3567   define input  parameter par-obj-code  like ub.doc-line.obj-code  no-undo .
     3568   define input  parameter par-artic     like ub.doc-line.artic     no-undo .
     3569   define input  parameter par-prod-type like ub.doc-line.prod-type no-undo .
     3570   define input  parameter par-prod-code like ub.doc-line.prod-code no-undo .
     3571   define input  parameter par-fact-order-end       as decimal   no-undo .
     3572   define output parameter v-doc-qnty    as decimal   no-undo .
     3573     do
     3574     on error undo, return error return-value
     3575     :
     3576     for each temp-parts : delete  temp-parts.  end.
     3577     run partslib-init-temp-parts-by-factord in this-procedure
     3578       ( input par-obj-type  ,
     3579         input par-obj-code  ,
     3580         input par-artic     ,
     3581         input par-prod-type ,
     3582         input par-prod-code ,
     3583         input par-fact-order-end ,
     3584         input false ) .
     3585     end.
     3586   v-doc-qnty = 0 .
     3587   for each temp-parts:
     3588     v-doc-qnty =  v-doc-qnty + temp-parts.fact-qnty .
     3589   end.
     3590   end procedure.
