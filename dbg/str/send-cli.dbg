     6095         .
     6096       end.
     6097       when 8 then do:
     6098         cash-cli-attr.account-type = buf_dis-card-property.property-value-integer.
     6099       end.
     6100       when  3 then do:
     6101         cash-cli-attr.dc-limit-type = buf_dis-card-property.property-value-character.
     6102       end.
     6103       when 4 then do:
