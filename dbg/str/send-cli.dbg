     3023   procedure alienini-getkey :
     3024   define input parameter i-filename as char.
     3025   define input parameter i-section as char.
     3026   define input parameter i-key as char.
     3027   define output parameter o-value as char.
     3028   define variable EntryPointer as integer no-undo.
     3029   define variable mem1 as memptr no-undo.
     3030   define variable mem2 as memptr no-undo.
     3031   define variable mem1size as integer no-undo.
     3032   define variable mem2size as integer no-undo.
     3033   define variable ii       as integer    no-undo.
     3034   define variable cbReturnSize  as integer    no-undo.
     3035   assign
     3036   set-size(mem1)  = 4000
     3037   mem1size = 4000.
     3038   if i-key = "" then EntryPointer = 0.
     3039   else do:
     3040     assign
     3041     set-size(mem2) = 128
     3042     mem2size = 128
     3043     EntryPointer = get-pointer-value(mem2)
     3044     put-string(mem2, 1) = i-key.
     3045   end.
     3046   run getprivateprofilestringA
     3047                                 (i-section,
     3048                                  EntryPointer,
     3049                                  "",
     3050                                  get-pointer-value(mem1),
     3051                                  input mem1size,
     3052                                  i-filename,
     3053                                  output cbReturnSize).
     3054   do ii = 1 to cbReturnSize:
     3055     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3056                  then o-value + ","
     3057                  else o-value + chr(get-byte(mem1, ii)).
     3058   end.
     3059     set-size(mem1) = 0.
     3060     set-size(mem2) = 0.
     3061   end procedure.
     3062   procedure alienini-putkey :
     3063   define input parameter i-filename as char.
     3064   define input parameter i-section as char.
     3065   define input parameter i-key as char.
     3066   define input parameter i-value as char.
     3067   define variable cbReturnSize as integer.
     3068   run writeprivateprofilestringA
     3069                                  (i-section,
     3070                                   i-key,
     3071                                   i-value,
     3072                                   i-filename,
     3073                                   output cbReturnSize ).
     3074   end procedure.
     3075   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3076     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3077     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3078     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3079     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3080     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3081     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3082     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3083   END PROCEDURE.
     3084   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3085     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3086     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3087     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3088     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3089     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3090   END PROCEDURE.
     3091   define   temp-table temp-tekka-tsk no-undo
     3092   field filename      as character
     3093   field obj-num       as integer
     3094   field obj-name      as character
     3095   field num-records   as integer
     3096   field max-records   as integer
     3097   field min-plu       as integer
     3098   field max-plu       as integer
     3099   field num-fields    as integer
     3100   field task-num      as character
     3101   field by-record     as logical
     3102   field send-get      as character
     3103   field cash-num      as integer
     3104   field cash-num-char as character
     3105   field port-num      as character
     3106   field way           as character
     3107   field is-script     as logical
     3108   field pswd          as character
     3109   field waiting-sek   as integer
     3110   field other-info    as character
     3111   field order-num     as integer
     3112   field secondary     as integer
     3113   field shift-fields  as integer
     3114   field binary        as logical
     3115   field range         as integer
     3116   index pi is unique primary
     3117   filename
     3118   range
     3119   index lpi
     3120   filename
     3121   min-plu
     3122   index gpi
     3123   filename
     3124   max-plu
     3125   index iorder
     3126   order-num
     3127   .
     3128   define   temp-table temp-tekka-schema no-undo
     3129   field obj-num as integer
     3130   field obj-name as character
     3131   field field-num as integer
     3132   field field-name as character
     3133   field num-records as integer
     3134   field size_ as integer
     3135   field host as character
     3136   field progress-type as character
     3137   field custom-type as character
     3138   field start-pos as integer
     3139   field end-pos as integer
     3140   field bin-group as character
     3141   index pi is unique primary
     3142   host obj-num field-num
     3143   .
     3144   define temp-table temp-tekka-record no-undo
     3145   field obj-num as integer
     3146   field plu as integer
     3147   field body as character
     3148   field shift as integer
     3149   index pi is unique primary obj-num plu.
     3150   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3151   define variable v-is-closed-shift-journal as integer no-undo .
     3152   assign
     3153   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3154                               +
     3155                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3156                               +
     3157                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3158   .
     3159   return v-is-closed-shift-journal.
     3160   END FUNCTION.
     3161   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3162   define variable v-is-first-journal as logical no-undo .
     3163   assign
     3164   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3165                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3166                     or (p-journal-num =  integer(entry(1, '17':U)))
     3167                     or (p-journal-num = integer(entry(1, '16':U)))
     3168   .
     3169   return v-is-first-journal.
     3170   END FUNCTION.
     3171   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3172   define variable v-is-petrol-journal as logical no-undo .
     3173   assign
     3174   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3175   return v-is-petrol-journal.
     3176   END FUNCTION.
     3177   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3178   define variable v-max-record-num as integer no-undo .
     3179   assign
     3180   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3181                       then 1489
     3182                       else 2340).
     3183   return v-max-record-num.
     3184   END FUNCTION.
     3185   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3186   define variable v-max-record-num as integer no-undo .
     3187   assign
     3188   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3189                       then 1489 * num-entries('30,31,32,33':U)
     3190                       else 2340 * num-entries('17':U)).
     3191   return v-max-record-num.
     3192   END FUNCTION.
     3193   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3194                                           ,input p-rec-no as integer):
     3195   define variable v-num-recs as integer no-undo .
     3196   if tekka-is-petrol-journal (p-journal-num) then do:
     3197     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3198       assign
     3199       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3200       .
     3201     end.
     3202     else do:
     3203       assign
     3204       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3205       .
     3206     end.
     3207   end.
     3208   else do:
     3209     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3210       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3211         assign
     3212         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3213         .
     3214       end.
     3215       else do:
     3216         assign
     3217         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3218         .
     3219       end.
     3220     end.
     3221     else do:
     3222       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3223         assign
     3224         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3225         .
     3226       end.
     3227       else do:
     3228         assign
     3229         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3230         .
     3231       end.
     3232     end.
     3233   end.
     3234   return v-num-recs.
     3235   END FUNCTION.
     3236   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3237                                              ,input p-is-petrol as logical
     3238                                              ,input p-is-current as logical
     3239                                              ,output p-rec-no as decimal
     3240                                              ):
     3241   define variable v-obj-num0 as integer no-undo .
     3242   define variable v-obj-num as integer no-undo .
     3243   define variable v-obj-num2 as integer no-undo .
     3244   define variable p-num-recs2 as integer no-undo .
     3245   define variable p-rec-no2 as integer no-undo .
     3246   if p-is-petrol then do:
     3247     assign
     3248     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3249     .
     3250     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3251     then
     3252     assign
     3253     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3254     p-rec-no = p-num-recs modulo 1489
     3255     .
     3256     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3257     then
     3258     assign
     3259     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3260     p-rec-no = p-num-recs modulo 1489
     3261     .
     3262   end.
     3263   else do:
     3264     assign
     3265     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3266     p-num-recs = trunc(p-num-recs, 0)
     3267     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3268     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3269     .
     3270     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3271     then
     3272     assign
     3273     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3274     p-rec-no = p-num-recs modulo 2340
     3275     .
     3276     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3277     then
     3278     assign
     3279     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3280     p-rec-no = p-num-recs modulo 2340
     3281     .
     3282     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3283     then
     3284     assign
     3285     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3286     p-rec-no2 = p-num-recs2 modulo 2978
     3287     .
     3288     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3289     then
     3290     assign
     3291     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3292     p-rec-no2 = p-num-recs2 modulo 2978
     3293     .
     3294     assign
     3295     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3296     .
     3297   end.
     3298   if v-obj-num = 0 then v-obj-num = 100.
     3299   return v-obj-num.
     3300   END FUNCTION.
     3301   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3302   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3303   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3304      if p-is-ptrl then
     3305      return integer(entry(1, '26,27,28,29':U)).
     3306      if not p-is-ptrl then
     3307      return integer(entry(1, '16':U)).
     3308   end.
     3309   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3310   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3311   return 0.
     3312   END FUNCTION.
     3313   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3314   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3315   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3316     if p-is-ptrl then
     3317     return integer(entry(1, '26,27,28,29':U)).
     3318     if not p-is-ptrl then
     3319     return integer(entry(1, '16':U)).
     3320   end.
     3321   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3322   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3323   return 0.
     3324   END FUNCTION.
     3325   PROCEDURE maria-put:
     3326   define parameter buffer buf_cash-desk for ub.cash-desk.
     3327   define input parameter p-out    as character no-undo .
     3328   define input parameter p-fname as character no-undo .
     3329   define input parameter p-by-record as logical no-undo .
     3330   define input parameter p-shift-fields as integer no-undo .
     3331   define input parameter p-binary as logical no-undo .
     3332   define input parameter p-obj-num as integer no-undo .
     3333   define input parameter p-max-records as integer no-undo .
     3334   define input parameter p-plu as integer no-undo .
     3335   define input parameter p-value as character no-undo .
     3336   define variable v-file-name as character no-undo .
     3337   define variable v-create as logical no-undo .
     3338   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3339   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3340   output stream IBMSTREAM
     3341   to value(v-file-name) append .
     3342   Put  stream IBMSTREAM unformatted
     3343   p-plu
     3344   chr(3)
     3345   p-value
     3346   skip.
     3347   output stream IBMSTREAM
     3348   close.
     3349   if not p-by-record then do:
     3350     find first buf_temp-tekka-tsk where
     3351               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3352     if not available buf_temp-tekka-tsk then do:
     3353       v-create = yes.
     3354     end.
     3355   end.
     3356   else do:
     3357     find first buf_temp-tekka-tsk where
     3358               buf_temp-tekka-tsk.filename  = v-file-name
     3359           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3360     if not available buf_temp-tekka-tsk
     3361     then do:
     3362       find first buf_temp-tekka-tsk where
     3363                 buf_temp-tekka-tsk.filename  = v-file-name
     3364             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3365       if not available buf_temp-tekka-tsk
     3366       then do:
     3367         v-create = yes.
     3368       end.
     3369     end.
     3370   end.
     3371   if v-create then do:
     3372     create buf_temp-tekka-tsk.
     3373     assign
     3374     buf_temp-tekka-tsk.filename = v-file-name
     3375     buf_temp-tekka-tsk.range    = p-plu
     3376     buf_temp-tekka-tsk.obj-num = p-obj-num
     3377     buf_temp-tekka-tsk.obj-name = '':U
     3378     buf_temp-tekka-tsk.num-records = 0
     3379     buf_temp-tekka-tsk.max-records = p-max-records
     3380     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3381     buf_temp-tekka-tsk.task-num = p-fname
     3382     buf_temp-tekka-tsk.by-record = p-by-record
     3383     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3384     buf_temp-tekka-tsk.binary = p-binary
     3385     buf_temp-tekka-tsk.send-get = 'send'
     3386     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3387     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3388     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3389     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3390                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3391                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3392                                 then 'local'
     3393                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3394     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3395     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3396     buf_temp-tekka-tsk.waiting-sek = 30
     3397     buf_temp-tekka-tsk.min-plu     = p-plu
     3398     buf_temp-tekka-tsk.max-plu     = p-plu
     3399     .
     3400   end.
     3401   assign
     3402   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3403   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3404   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3405   .
     3406   END PROCEDURE.
     3407   PROCEDURE maria-get:
     3408   define parameter buffer buf_cash-desk for ub.cash-desk.
     3409   define input parameter p-out    as character no-undo .
     3410   define input parameter p-fname as character no-undo .
     3411   define input parameter p-by-record as logical no-undo .
     3412   define input parameter p-obj-num as integer no-undo .
     3413   define input parameter p-num-fields as integer no-undo .
     3414   define input parameter p-max-records as integer no-undo .
     3415   define input parameter p-min-plu as integer no-undo .
     3416   define input parameter p-max-plu as integer no-undo .
     3417   define input parameter p-other as character no-undo .
     3418   define input parameter p-order-num as integer no-undo .
     3419   define variable v-file-name as character no-undo .
     3420   define variable v-secondary-obj-num as character no-undo .
     3421   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3422   if p-by-record then do:
     3423     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3424   end.
     3425   else do:
     3426     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3427   end.
     3428   find first buf_temp-tekka-tsk where
     3429             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3430   if not available buf_temp-tekka-tsk then do:
     3431     create buf_temp-tekka-tsk.
     3432     assign
     3433     buf_temp-tekka-tsk.filename = v-file-name
     3434     buf_temp-tekka-tsk.obj-num = p-obj-num
     3435     buf_temp-tekka-tsk.obj-name = '':U
     3436     buf_temp-tekka-tsk.max-records = p-max-records
     3437     buf_temp-tekka-tsk.num-fields = p-num-fields
     3438     buf_temp-tekka-tsk.task-num = p-fname
     3439     buf_temp-tekka-tsk.by-record = p-by-record
     3440     buf_temp-tekka-tsk.send-get = 'get'
     3441     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3442     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3443     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3444     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3445                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3446                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3447                                   then 'local'
     3448                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3449     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3450     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3451     buf_temp-tekka-tsk.waiting-sek = 30
     3452     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3453     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3454     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3455                                       and p-max-plu <> ?
     3456                                       then p-max-plu - p-min-plu + 1
     3457                                       else 0)
     3458     buf_temp-tekka-tsk.other-info = p-other
     3459     buf_temp-tekka-tsk.order-num = p-order-num
     3460     .
     3461     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3462       assign
     3463       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3464       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3465       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3466       no-error
     3467       .
     3468       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3469     end.
     3470   end.
     3471   END PROCEDURE.
     3472   PROCEDURE maria-task:
     3473   define parameter buffer buf_cash-desk for ub.cash-desk.
     3474   define input parameter p-fname as character no-undo .
     3475   define input parameter p-obj-num-list as character no-undo .
     3476   define input parameter p-parameters as character no-undo .
     3477   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3478   find first buf_temp-tekka-tsk where
     3479             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3480   if not available buf_temp-tekka-tsk then do:
     3481     create buf_temp-tekka-tsk.
     3482     assign
     3483     buf_temp-tekka-tsk.filename = ''
     3484     buf_temp-tekka-tsk.range = 1
     3485     buf_temp-tekka-tsk.obj-num = 0
     3486     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3487     buf_temp-tekka-tsk.task-num = p-fname
     3488     buf_temp-tekka-tsk.by-record = no
     3489     buf_temp-tekka-tsk.send-get = 'task'
     3490     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3491     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3492     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3493     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3494                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3495                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3496                                   then 'local'
     3497                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3498     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3499     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3500     buf_temp-tekka-tsk.waiting-sek = 30
     3501     buf_temp-tekka-tsk.other-info = p-parameters
     3502     buf_temp-tekka-tsk.order-num = 0
     3503     .
     3504   end.
     3505   END PROCEDURE.
     3506   procedure tekkatsk-verify-schema :
     3507   define input parameter p-obj-list as character no-undo .
     3508   define input parameter p-dir-path as character no-undo .
     3509   define variable v-obj-num as integer no-undo .
     3510   define variable v-obj-name as character no-undo .
     3511   define variable v-num-records as integer no-undo .
     3512   define variable v-size_ as integer no-undo .
     3513   define variable v-value as character no-undo .
     3514   define variable ii as integer no-undo .
     3515   define variable jj as integer no-undo .
     3516   define variable ii-ibs as integer no-undo .
     3517   define variable ii-tekka as integer no-undo .
     3518   define variable v-result as character no-undo .
     3519   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3520   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3521     do
     3522     on error undo, return error
     3523     :
     3524        for each buf_temp-tekka-schema:
     3525          delete buf_temp-tekka-schema.
     3526        end.
     3527        input from value('tekkasch.d').
     3528        repeat :
     3529          create buf_temp-tekka-schema.
     3530          import buf_temp-tekka-schema.
     3531          assign
     3532          buf_temp-tekka-schema.host = 'IBS'
     3533          ii = ii + 1.
     3534          .
     3535        end.
     3536        input close.
     3537        ii-ibs = ii.
     3538         _ii:
     3539         do ii = 1 to 256:
     3540           if p-obj-list = "ALL"
     3541           or lookup(string(ii), p-obj-list) > 0 then do:
     3542             assign
     3543             v-obj-num = 0
     3544             v-obj-name = ''
     3545             v-num-records = 0
     3546             v-size_ = 0
     3547             .
     3548             run alienini-getkey in this-procedure (
     3549                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3550                                                     ,input ('obj' + string(ii, '999'))
     3551                                                     ,input 'oname'
     3552                                                     ,output v-value) no-error .
     3553             if v-value = ? then next _ii.
     3554             assign
     3555             v-obj-num = ii
     3556             v-obj-name = v-value
     3557             .
     3558             run alienini-getkey in this-procedure (
     3559                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3560                                                     ,input ('obj' + string(ii, '999'))
     3561                                                     ,input 'size'
     3562                                                     ,output v-value) no-error .
     3563             assign
     3564             v-num-records = integer(v-value) no-error  .
     3565             if error-status:error
     3566             or v-num-records = 0 then next _ii.
     3567             run alienini-getkey in this-procedure (
     3568                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3569                                                     ,input 'obj' + string(ii, '999')
     3570                                                     ,input 'f000'
     3571                                                     ,output v-value) no-error .
     3572             assign
     3573             v-size_ = integer(v-value) no-error  .
     3574             if error-status:error
     3575             or v-size_ = 0 then next _ii.
     3576             _jj:
     3577             do jj = 1 to 256:
     3578               run alienini-getkey in this-procedure (
     3579                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3580                                                       ,input 'obj' + string(ii, '999')
     3581                                                       ,input 'f' + string(jj, '999')
     3582                                                       ,output v-value) no-error .
     3583               if v-value = ? then next _ii.
     3584               create buf_temp-tekka-schema.
     3585               assign
     3586               buf_temp-tekka-schema.host = 'tekka'
     3587               buf_temp-tekka-schema.obj-num = v-obj-num
     3588               buf_temp-tekka-schema.obj-name = v-obj-name
     3589               buf_temp-tekka-schema.num-records = v-num-records
     3590               buf_temp-tekka-schema.size_ = v-size_
     3591               buf_temp-tekka-schema.field-num = jj
     3592               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3593               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3594                                                  then entry(2, entry(2, v-value, '#'), ':')
     3595                                                  else '':U)
     3596               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3597               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3598               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3599                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3600               no-error
     3601               .
     3602               if error-status:error then do:
     3603                 delete buf_temp-tekka-schema.
     3604                 next _jj.
     3605               end.
     3606               run alienini-getkey in this-procedure (
     3607                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3608                                                       ,input 'obj' + string(ii, '999') + 'name'
     3609                                                       ,input 'n' + string(jj, '999')
     3610                                                       ,output v-value) no-error .
     3611               if v-value <> ? then
     3612               buf_temp-tekka-schema.field-name = v-value.
     3613             end.
     3614           end.
     3615         end.
     3616         ii-tekka = ii - 1.
     3617        if p-obj-list <> 'ALL' then do:
     3618         if ii-tekka <> ii-ibs then do:
     3619           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3620                                   , ii-ibs
     3621                                   , ii-tekka).
     3622         end.
     3623        end.
     3624        for each buf_temp-tekka-schema where
     3625               buf_temp-tekka-schema.host = 'tekka':
     3626          find first buf2_temp-tekka-schema where
     3627                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3628                AND buf2_temp-tekka-schema.host = 'ibs'
     3629                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3630          if not available buf2_temp-tekka-schema then do:
     3631           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3632                                   , buf_temp-tekka-schema.field-num
     3633                                   , buf_temp-tekka-schema.obj-num).
     3634          end.
     3635          buffer-compare buf_temp-tekka-schema
     3636          to buf2_temp-tekka-schema
     3637          save result in v-result.
     3638          if v-result <> '':U then do:
     3639           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3640                                   , buf_temp-tekka-schema.field-num
     3641                                   , buf_temp-tekka-schema.obj-num).
     3642          end.
     3643        end.
     3644     end.
     3645   end procedure.
     3646   FUNCTION set-Sx returns character (input p-string as character):
     3647   return p-string.
     3648   END FUNCTION.
     3649   FUNCTION get-Sx returns character (input p-string  as character):
     3650   return p-string.
     3651   END FUNCTION.
     3652   FUNCTION set-B returns character (input p-string  as character):
     3653   return chr(integer(p-string)).
     3654   END FUNCTION.
     3655   FUNCTION get-B returns character (input p-string  as character):
     3656   return string(asc(p-string)).
     3657   END FUNCTION.
     3658   FUNCTION set-BF returns character (input p-string  as character):
     3659   define variable v-dopi as integer no-undo .
     3660   define variable ii as integer no-undo .
     3661   do ii = 1 to 8:
     3662     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3663   end.
     3664   return chr(v-dopi).
     3665   END FUNCTION.
     3666   FUNCTION get-BF returns character (input p-string  as character):
     3667   define variable v-dopi as integer no-undo .
     3668   define variable v-dops as character no-undo .
     3669   define variable ii as integer no-undo .
     3670   v-dopi = asc(p-string).
     3671   do ii = 8 to 1 BY -1:
     3672     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3673   end.
     3674   return v-dops.
     3675   END FUNCTION.
     3676   FUNCTION set-BN returns character (input p-string  as character
     3677                                     ,input p-bin-group as character):
     3678   define variable v-dopi as integer no-undo .
     3679   define variable ii as integer no-undo .
     3680   define variable jj as integer no-undo .
     3681   define variable v-grp-nums as integer no-undo .
     3682   define variable v-dopi2 as integer no-undo .
     3683   v-grp-nums = num-entries(p-bin-group).
     3684   do jj = 0 to v-grp-nums - 1:
     3685     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3686     do ii = 1 to 8:
     3687       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3688     end.
     3689   end.
     3690   return chr(v-dopi).
     3691   END FUNCTION.
     3692   FUNCTION get-BN returns character (input p-string  as character
     3693                                     ,input p-bin-group as character):
     3694   define variable v-dopi as integer no-undo .
     3695   define variable v-dops as character no-undo .
     3696   define variable v-grp-nums as integer no-undo .
     3697   define variable ii as integer no-undo .
     3698   define variable jj as integer no-undo .
     3699   v-dopi = asc(p-string).
     3700   v-grp-nums = num-entries(p-bin-group).
     3701   do jj = 1 to v-grp-nums:
     3702   do ii = 8 to 1 BY -1:
     3703     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3704   end.
     3705   end.
     3706   return v-dops.
     3707   END FUNCTION.
     3708   procedure fill-temp-cd :
     3709   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3710   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3711   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3712   define input parameter p-clear-table as logical no-undo .
     3713   define buffer buf_temp-cd for temp-cd.
     3714   define buffer buf_cash-desk for ub.cash-desk.
     3715     do
     3716     on error undo, return error
     3717     :
     3718        if p-clear-table  then do:
     3719          for each buf_temp-cd:
     3720            delete buf_temp-cd.
     3721          end.
     3722        end.
     3723        for each buf_cash-desk no-lock where
     3724               buf_cash-desk.db-num = p-db-num
     3725           AND buf_cash-desk.obj-code = p-obj-code
     3726           and buf_cash-desk.cash-on  = yes
     3727        BREAK by buf_cash-desk.pos-type:
     3728          if first-of(buf_cash-desk.pos-type) then do:
     3729            create buf_temp-cd.
     3730            buffer-copy buf_cash-desk to buf_temp-cd.
     3731          end.
     3732        end.
     3733     end.
     3734   end procedure.
     3735   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3736   function windows-date-format returns character ( input p-date  as date, input p-format as character ):
     3737   define variable v-string-date as character no-undo .
     3738   CASE p-format:
     3739     when "dd.mm.yyyy":U
     3740     or
     3741     when "dd.mm.yy":U
     3742     or
     3743     when "dd/mm/yy":U
     3744     then do:
     3745       assign
     3746       p-format = replace(p-format, "dd", "99")
     3747       p-format = replace(p-format, "mm", "99")
     3748       p-format = replace(p-format, "yy", "99")
     3749       v-string-date = string(p-date, p-format)
     3750       .
     3751     end.
     3752     when "d.m.yy":U then do:
     3753       ASSIGN
     3754       v-string-date = string(day(p-date), ">9") + string(month(p-date), ">9") +
     3755                       substring(string(p-date, "99/99/99"), 7, 2)
     3756       .
     3757     end.
     3758     when "yyyy-mm-dd":U then do:
     3759       ASSIGN
     3760       v-string-date = string(year(p-date), "9999") + "-":U + string(month(p-date), "99") + string(day(p-date), "99")
     3761       .
     3762     end.
     3763   END CASE.
     3764   return v-string-date.
     3765   END FUNCTION.
     3766   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3767   define new global shared variable g#attr-lib  as handle no-undo .
     3768   define variable v-attr-lib-variable as handle no-undo .
     3769   procedure clntattr-code :
     3770     define input  parameter p-code           as character no-undo .
     3771     define output parameter p-type           as character no-undo .
     3772     define output parameter p-format         as character no-undo .
     3773     define output parameter p-label          as character no-undo .
     3774     define output parameter p-user-can-edit  as logical   no-undo .
     3775     define output parameter p-output-display as logical   no-undo .
     3776     define output parameter p-other          as character no-undo .
     3777     do
     3778     on error undo, return error return-value
     3779     :
     3780           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     3781         (input  p-code
     3782         ,output p-type
     3783         ,output p-format
     3784         ,output p-label
     3785         ,output p-user-can-edit
     3786         ,output p-output-display
     3787         ,output p-other
     3788         ) no-error .
     3789       if error-status :error
     3790       then do:
     3791         undo, return error return-value .
     3792       end.
     3793     end.
     3794   end procedure.
     3795   procedure clntattr-tooltip :
     3796     define input  parameter p-code    as character no-undo .
     3797     define output parameter p-tooltip as character no-undo .
     3798     define output parameter p-label   as character no-undo .
     3799     do
     3800     on error undo, return error return-value
     3801     :
     3802           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
     3803         (input  p-code
     3804         ,output p-tooltip
     3805         ,output p-label
     3806         ) no-error .
     3807       if error-status :error
     3808       then do:
     3809         undo, return error return-value .
     3810       end.
     3811     end.
