     6308   define variable v-dc-rule-num as integer no-undo .
     6309   define variable v-maria-rule-num as integer no-undo .
     6310   define variable v-magia-kat-pcnt as integer no-undo .
     6311   define buffer buf_cash-pay for ub.cash-pay.
     6312   define buffer buf_currency for ub.currency.
     6313   define buffer buf_cd-clu for ub.cd-clu.
     6314   define buffer buf_dis-rule for ub.dis-rule.
     6315   define buffer root_cash-dis-rule for cash-dis-rule.
     6316   if cash-cli.d-pcnt >= 100  then do:
     6317     return error
     6318     substitute("Карта &1:неверный процент скидки по карте &2"
     6319                 ,  cash-cli.d-card
     6320                 , cash-cli.d-pcnt
     6321                 ).
     6322   end.
     6323   if cash-cli.d-pcnt-byshop then do:
     6324     v-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     6325                        , input cash-cli.emitent-host-code
     6326                        , input cash-cli.type
     6327                        , input ub.sysconf.host-code
     6328                        , input 'маг':U
     6329                        , input (if g#news
     6330                                 or g#esys
     6331                                 then buf_cash-desk.obj-code
     6332                                 else i-obj-code)
     6333                        , input 1
     6334                        , input cash-cli.d-pcnt
     6335                        , input cash-cli.cash-d-pcnt
     6336                        , input cash-cli.kat-pcnt), "%)(i ")).
     6337     v-cash-d-pcnt = decimal(trim(get-dpcn ( input cash-cli.d-card
     6338                        , input cash-cli.emitent-host-code
     6339                        , input cash-cli.type
     6340                        , input ub.sysconf.host-code
     6341                        , input 'маг':U
     6342                        , input (if g#news
     6343                                 or g#esys
     6344                                 then buf_cash-desk.obj-code
     6345                                 else i-obj-code)
     6346                        , input 1
     6347                        , input cash-cli.d-pcnt
     6348                        , input cash-cli.cash-d-pcnt
     6349                        , input cash-cli.kat-pcnt), "%)(i ")).
     6350     v-categ = integer(trim(get-dpcn ( input cash-cli.d-card
     6351                        , input cash-cli.emitent-host-code
     6352                        , input cash-cli.type
     6353                        , input ub.sysconf.host-code
     6354                        , input 'маг':U
     6355                        , input (if g#news
     6356                                 or g#esys
     6357                                 then buf_cash-desk.obj-code
     6358                                 else i-obj-code)
     6359                        , input 1
     6360                        , input cash-cli.d-pcnt
     6361                        , input cash-cli.cash-d-pcnt
     6362                        , input cash-cli.kat-pcnt), "%)(i ")).
     6363   end.
     6364   CASE pos-type:
     6365     when 'IBM':U
     6366     or
     6367     when 'Emulator-NKT-IBM':U
     6368     then do:
     6369       if pos-type = 'Emulator-NKT-IBM':U then
     6370       v-version-dec = 0.
     6371       else
     6372       assign
     6373       v-version-dec = decimal(p-version) no-error .
     6374       if v-version-dec >= 4.4
     6375       then do:
     6376         PUT stream IBMstream unformatted
     6377         '19' chr(32)
     6378         '"'  (if g#news or g#esys or run-from = "O":U or run-from = "E":U
     6379                 then
     6380                 (if cash-cli.cli-status_  = 0 then "U":U
     6381                 else "D":U)
     6382                 else string( action, "x(1)" )
     6383                 ) '"' chr(32)
     6384         chr(34)
     6385         string( fill( chr(32) , 16 - length( trim(string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code ) ) ) )
     6386               + string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code)
     6387               )
     6388         chr(34)
     6389         chr(32)
     6390         chr(34) caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(40)" ) )   chr(34)   chr(32)
     6391         chr(34) caps( string( cash-cli.cli-city , "x(20)" ) )   chr(34)  chr(32)
     6392         chr(34) caps( string( cash-cli.cli-adr , "x(40)" ) ) chr(34) chr(32)
     6393          string( cash-cli.kat-pcnt, ">>>9" ) chr(32)
     6394         chr(34) string(cash-cli.cli-inn, "X(20)") chr(34) chr(32)
     6395         chr(34) string(cash-cli.kpp, "X(25)") chr(34) chr(32)
     6396         string(cash-cli.h-ka, ">>>>>9") chr(32)
     6397         (if  cash-cli.mask-card
     6398         then string( cash-cli.lim-kr, ">>>>>>>>9.99" )
     6399         else string( 0, ">>>>>>>>9.99" )
     6400         ) chr(32)
     6401        (if  cash-cli.mask-card
     6402         then string(cash-cli.current-saldo, "->>>>>>>>9.99" )
     6403         else string( 0 , "->>>>>>>>9.99" )
     6404         ) chr(32)
     6405         (if cash-cli.mask-card
     6406         then string( if cash-cli.d-pcnt-byshop
     6407                     then (- v-d-pcnt)
     6408                     else ( - cash-cli.d-pcnt ) , "->>9.99" )
     6409         else string( 0 , "->>9.99" )
     6410         )
     6411         chr(32)
     6412         Os2-time
     6413         chr(10).
     6414         if not cash-cli.mask-card then do:
     6415           PUT stream IBMstream unformatted
     6416           '21' chr(32)
     6417           '"'  (if g#news or g#esys or run-from = "O":U or run-from = "E":U
     6418                   then
     6419                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6420                   else "D":U)
     6421                   else string( action, "x(1)" )
     6422                   ) '"' chr(32)
     6423           chr(34)
     6424           string( fill( " ", 19 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     6425           chr(34)
     6426           chr(32)
     6427           chr(34)
     6428           string( fill( chr(32) , 16 - length( trim(string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code ) ) ) )
     6429                 + string((if cash-cli.cli-type = 'орг':U then 1 else 0) * 1000000000 + cash-cli.cli-code)
