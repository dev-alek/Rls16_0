     5961   cash-cli.cash-d-pcnt = ub.dis-card.cash-d-pcnt
     5962   cash-cli.d-pcnt-method = ub.dis-card.d-pcnt-method
     5963   cash-cli.status_ = ub.dis-card.status_
     5964   cash-cli.d-card = ub.dis-card.d-card
     5965   cash-cli.issue-code = ub.dis-card.issue-code
     5966   cash-cli.issue-date = ub.dis-card.issue-date
     5967   cash-cli.type = ub.dis-card.type
     5968   cash-cli.emitent-host-code = ub.dis-card.emitent-host-code
     5969   cash-cli.d-pcnt-byshop = ub.dis-card-type.d-pcnt-byshop
     5970   cash-cli.cli-status_ = ub.clients.stts
     5971   cash-cli.card-media = ub.dis-card-type.card-media
     5972   cash-cli.credit-card = ub.dis-card.credit-card
     5973   cash-cli.debet-card = ub.dis-card.debet-card
     5974   cash-cli.staff-card = ub.dis-card.staff-card
     5975   cash-cli.cli-message = ub.dis-card.cli-message
     5976   cash-cli.fiscal-pay = (if cash-cli.debet-card
     5977                           or cash-cli.credit-card
