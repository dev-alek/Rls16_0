     6033                             then (substr(trim( ub.person.name1 ),1,1) + ".")
     6034                             else "":U
     6035                             ) + chr(4) +
     6036                             (if ub.person.name2 <> "":U
     6037                             and ub.person.name2 <> ?
     6038                             then  (substr(trim( ub.person.name2 ),1,1) + ".")
     6039                             else "":U
     6040                             )
