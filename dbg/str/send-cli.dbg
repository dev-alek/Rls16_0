     8343       ,INPUT-OUTPUT table-handle v-tth70
     8344       ) no-error .
     8345   delete object v-tth70 no-error.
     8346   case ub.cash-desk.pos-type:
     8347       when 'IBM-XML':U or when 'Autotank':U
     8348         or
     8349       when 'MAGIA-XML':U
     8350     then do:
     8351   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8352   run str/get-inis.p (
     8353                   input 'маг':U
     8354                 , input ub.cash-desk.obj-code
