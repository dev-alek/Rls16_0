     4591     define output parameter p-send-param     as logical no-undo .
     4592     do
     4593     on error undo, return error return-value
     4594     :
     4595           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-send-param in g#attr-lib
     4596         (input  p-ucode
     4597         ,input  p-code
     4598         ,output p-send-param
     4599         ) no-error .
     4600       if error-status :error
     4601       then do:
     4602         undo, return error return-value .
     4603       end.
     4604     end.
     4605   end procedure.
     4606   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4607   PROCEDURE cd-mrkt_plu-marketer :
     4608   define input parameter p-silence as logical no-undo .
     4609   define parameter buffer buf_cash-desk for ub.cash-desk.
     4610   define input parameter p-id as character no-undo .
     4611   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4612   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4613   define input parameter p-loc-ean as logical no-undo .
     4614   define input parameter p-is-petrolium as logical no-undo .
     4615   define input parameter p-extra as character no-undo .
     4616   define variable v-tot-gds as integer no-undo .
     4617   define variable v-max-gds as integer no-undo .
     4618   define variable v-petrol-start as integer no-undo .
     4619   define variable v-petrol-range as integer no-undo .
     4620   DEFINE VARIABLE v-today as date no-undo .
     4621   DEFINE VARIABLE v-time as integer no-undo .
     4622   define variable v-plu-type as character no-undo .
     4623   define variable v-int as integer no-undo .
     4624   define buffer  buf_cd-plu for ub.cd-plu.
     4625   define buffer  loc_cd-plu for ub.cd-plu.
     4626   define variable  ii as integer no-undo.
     4627   define variable v-mes as character no-undo .
     4628   _main:
     4629   DO ON ERROR undo, leave on stop undo, leave:
     4630     if buf_cash-desk.pos-type <> 'MARIA':U
     4631     or buf_cash-desk.cash-num <> 0 then do:
     4632       assign
     4633       v-mes =
     4634       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4635                 , buf_cash-desk.pos-type).
     4636       if not p-silence then
     4637       message
     4638       v-mes
     4639       view-as alert-box error .
     4640       return error v-mes.
     4641     end.
     4642     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4643                                     ,input 'MARIA_operative':U
     4644                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4645                                           and p-is-petrolium
     4646                                           then 'tot-petrol':U
     4647                                           else 'tot-gds':U)
     4648                                     , output v-mes).
     4649     if v-tot-gds = ? then undo _main, return error v-mes.
     4650     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4651                                     ,input 'MARIA_general':U
     4652                                     ,input 'max-gds':U
     4653                                     ,output v-mes).
     4654     if v-max-gds = ? then undo _main, return error v-mes.
     4655     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4656                                          ,input 'petrolium-range':U
     4657                                          ,input 'petrolium-range':U
     4658                                          ,output v-mes).
     4659     if v-petrol-range = ? then undo _main, return error v-mes.
     4660     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4661       assign
     4662       v-petrol-start = 1
     4663       v-max-gds = (if p-is-petrolium
     4664                    then v-petrol-range
     4665                    else v-max-gds)
     4666       v-plu-type = (if p-is-petrolium
     4667                  then 'топ':U
     4668                  else '':U)
     4669       .
     4670       if p-is-petrolium then do:
     4671         if p-id = '':U then do:
     4672           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4673                               "Невозможно привязать к кассе типа &3"
     4674                               , p-b-str
     4675                               , chr(10)
     4676                               , 'MARIA':U).
     4677           if not p-silence then
     4678           message
     4679           v-mes
     4680           view-as alert-box error .
     4681           return error v-mes.
     4682         end.
     4683         assign
     4684         v-int = integer(p-id)
     4685         no-error
     4686         .
     4687         if error-status:error
     4688         or v-int > v-petrol-range then do:
     4689           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4690                               "в диапазоны номеров резервуаров для кассы типа &4"
     4691                               , p-id
     4692                               , p-b-str
     4693                               , chr(10)
     4694                               , 'MARIA':U).
     4695           if not p-silence then
     4696           message
     4697           v-mes
     4698           view-as alert-box error .
     4699           return error v-mes.
     4700         end.
     4701       end.
     4702     end.
     4703     if buf_cash-desk.pos-type = 'MARIA':U
     4704     and p-is-petrolium then do:
     4705       find first loc_cd-plu where
     4706                loc_cd-plu.obj-type = 'маг':U
     4707            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4708            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4709            and loc_cd-plu.plu-type = 'топ':U
     4710      no-error .
     4711      if available loc_cd-plu then do:
     4712        if loc_cd-plu.b-code = p-b-code
     4713        and loc_cd-plu.b-str = p-b-str then do:
     4714           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4715                               , p-id
     4716                               , p-b-str
     4717                               , chr(10)
     4718                               ).
     4719           if not p-silence then
     4720           message
     4721           v-mes
     4722           view-as alert-box WARNING .
     4723           return v-mes.
     4724        end.
     4725        else do:
     4726           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4727                               "нельзя его привязать к топливу &2&3"
     4728                               , p-id
     4729                               , loc_cd-plu.b-str
     4730                               , chr(10)
     4731                               , p-b-str).
     4732           if not p-silence then
     4733           message
     4734           v-mes
     4735           view-as alert-box error .
     4736           return error v-mes.
     4737        end.
     4738      end.
     4739      ii = v-int.
     4740     end.
     4741     else do:
     4742       DO ii = (if p-is-petrolium
     4743               then v-petrol-start
     4744               else (if buf_cash-desk.pos-type = 'MARIA':U
     4745                    then 1
     4746                    else (if v-petrol-start = 1
     4747                           then (v-petrol-range + 1)
     4748                           else 1)
     4749                   )
     4750               )
     4751         to v-max-gds :
     4752         if not can-find (loc_cd-plu where
     4753                         loc_cd-plu.obj-type = 'маг':U
     4754                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4755                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4756                      and loc_cd-plu.plu-type = v-plu-type
     4757                      and loc_cd-plu.plu-code = ii
     4758                       )
     4759         then LEAVE .
     4760       END .
     4761     end.
     4762     if ii > v-max-gds then do:
     4763         if not p-silence then
     4764         message
     4765         substitute("Превышено максимально допустимое количество &5 &1" +
     4766                   "для касс &2 &3&4"
     4767                   , chr(10)
     4768                   , v-max-gds
     4769                   , 'маг':U
     4770                   , buf_cash-desk.obj-code
     4771                   , (if p-is-petrolium then "топлив" else "товаров")
     4772                   )
     4773         view-as alert-box ERROR .
     4774         undo, return error "max-gds":U.
     4775     end.
     4776     DO ii = (if p-is-petrolium
     4777              then v-petrol-start
     4778              else (if v-petrol-start = 1
     4779                    then (v-petrol-range + 1)
     4780                    else 1)
     4781              )
     4782        to v-max-gds :
     4783       if not can-find (loc_cd-plu where
     4784                         loc_cd-plu.obj-type = 'маг':U
     4785                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4786                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4787                      and loc_cd-plu.plu-type = v-plu-type
     4788                      and loc_cd-plu.plu-code = ii
     4789                      )
     4790       then LEAVE .
     4791     END .
     4792     if ii > v-max-gds then do:
     4793         if not p-silence then
     4794         message
     4795         substitute("Превышено максимально допустимое количество &5 &1" +
     4796                   "для касс &2 &3&4"
     4797                   , chr(10)
     4798                   , v-max-gds
     4799                   , 'маг':U
     4800                   , buf_cash-desk.obj-code
     4801                   , (if p-is-petrolium then "топлив" else "товаров")
     4802                   )
     4803         view-as alert-box ERROR .
     4804         undo, return error "max-gds":U.
     4805     end.
     4806     run cur-time in this-procedure ( output v-today, output v-time).
     4807     create buf_cd-plu.
     4808     assign
     4809     buf_cd-plu.b-code = p-b-code
     4810     buf_cd-plu.b-str = p-b-str
     4811     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4812                                         then buf_cash-desk.addr-path
     4813                                         else "U":U)
     4814     buf_cd-plu.to-send = yes
     4815     buf_cd-plu.charkey_one = "":U
     4816     buf_cd-plu.to-del = no
     4817     buf_cd-plu.plu-code = ii
     4818     buf_cd-plu.obj-type = 'маг':U
     4819     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4820     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4821     buf_cd-plu.plu-type = v-plu-type
     4822     buf_cd-plu.logkey_one = p-loc-ean
     4823     buf_cd-plu.key#_one = integer(p-extra)
     4824     .
     4825     run cd-attr-write  in this-procedure (
     4826                                           input   buf_cash-desk.db-num
     4827                                           ,input  buf_cash-desk.obj-code
     4828                                           ,input  buf_cash-desk.pos-type
     4829                                           ,input  buf_cash-desk.cash-num
     4830                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4831                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4832                                                 and p-is-petrolium
     4833                                                 then 'tot-petrol':U
     4834                                                 else 'tot-gds':U)
     4835                                           ,input ''
     4836                                           ,input ?
     4837                                           ,input 0.0
     4838                                           ,input  (v-tot-gds + 1)
     4839                                           ,input no
     4840                                          ) no-error .
     4841     if error-status:error then do:
     4842       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4843                          ,buf_cash-desk.cash-num
     4844                          , 'маг':U
     4845                          ,buf_cash-desk.obj-code
     4846                          , chr(10)
     4847                          , error-status:get-message(1)
     4848                          , return-value
     4849                          ).
     4850       if not p-silence then
     4851       message
     4852       v-mes
     4853       view-as alert-box error .
     4854       undo _main, return error v-mes.
     4855     end.
     4856     run cd-attr-write  in this-procedure (
     4857                                           input   buf_cash-desk.db-num
     4858                                           ,input  buf_cash-desk.obj-code
     4859                                           ,input  buf_cash-desk.pos-type
     4860                                           ,input  buf_cash-desk.cash-num
     4861                                           ,input  'MARIA_operative':U
     4862                                           ,input  'to-send':U
     4863                                           ,input ''
     4864                                           ,input ?
     4865                                           ,input 0.0
     4866                                           ,input 0
     4867                                           ,input yes
     4868                                          ) no-error .
     4869     if error-status:error then do:
     4870       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     4871                          ,buf_cash-desk.cash-num
     4872                          , 'маг':U
     4873                          ,buf_cash-desk.obj-code
     4874                          , chr(10)
     4875                          , error-status:get-message(1)
     4876                          , return-value
     4877                          ).
     4878       if not p-silence then
     4879       message
     4880       v-mes
     4881       view-as alert-box error .
     4882       undo _main, return error v-mes.
     4883     end.
     4884     return "":U.
     4885   end.
     4886   END PROCEDURE.
     4887   procedure cd-mrkt_update-marketer :
     4888   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     4889   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     4890   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     4891   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     4892   define input parameter p-is-petrolium as logical no-undo .
     4893   define variable v-to-send as logical no-undo .
     4894   define variable v-tot-gds as integer no-undo .
     4895   define variable v-max-plu as integer no-undo .
     4896   define buffer buf_cd-plu for ub.cd-plu.
     4897   define variable v-plu-type as character no-undo .
     4898     do
     4899     on error undo, return error
     4900     :
     4901       v-to-send = no.
     4902       v-tot-gds = 0.
     4903       assign
     4904       v-plu-type = (if p-is-petrolium
     4905                     then  'топ':U
     4906                     else '':U
     4907                 )
     4908       .
     4909       FOR EACH buf_cd-plu WHERE
     4910              buf_cd-plu.obj-type = 'маг':U
     4911         and  buf_cd-plu.obj-code = p-obj-code
     4912         and  buf_cd-plu.pos-type = p-pos-type
     4913         and  buf_cd-plu.plu-type = v-plu-type
     4914             :
     4915         if  buf_cd-plu.to-del
     4916         or  buf_cd-plu.to-send then do:
     4917           assign
     4918           v-to-send = yes.
     4919         end.
     4920         assign
     4921         v-tot-gds = v-tot-gds + 1.
     4922       end.
     4923       run cd-attr-write  in this-procedure (
     4924                                               input   p-db-num
     4925                                               ,input  p-obj-code
     4926                                               ,input  p-pos-type
     4927                                               ,input  p-cash-num
     4928                                               ,input  'MARIA_operative':U
     4929                                               ,input  (if p-pos-type = 'MARIA':U
     4930                                                        and p-is-petrolium
     4931                                                        then  'tot-petrol':U
     4932                                                        else 'tot-gds':U)
     4933                                               ,input ''
     4934                                               ,input ?
     4935                                               ,input 0.0
     4936                                               ,input v-tot-gds
     4937                                               ,input no
     4938                                                                                           ) no-error .
     4939       if error-status:error then do:
     4940           UNDO, RETURN ERROR RETURN-VALUE.
     4941       END.
     4942       run cd-attr-write  in this-procedure (
     4943                                               input   p-db-num
     4944                                               ,input  p-obj-code
     4945                                               ,input  p-pos-type
     4946                                               ,input  p-cash-num
     4947                                               ,input  'MARIA_operative':U
     4948                                               ,input  (if p-pos-type = 'MARIA':U
     4949                                                        and p-is-petrolium
     4950                                                        then  'petrol-to-send':U
     4951                                                        else 'to-send':U)
     4952                                               ,input ''
     4953                                               ,input ?
     4954                                               ,input 0.0
     4955                                               ,input 0
     4956                                               ,input v-to-send
     4957                                               ) no-error .
     4958       if error-status:error then do:
     4959           UNDO, RETURN ERROR RETURN-VALUE.
     4960       END.
     4961       FIND LAST buf_cd-plu NO-LOCK  WHERE
     4962                buf_cd-plu.obj-type = 'маг':U
     4963            and buf_cd-plu.obj-code = p-obj-code
     4964            and buf_cd-plu.pos-type = p-pos-type
     4965            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     4966       if available buf_cd-plu then do:
     4967         if v-max-plu < buf_cd-plu.plu-code
     4968         then
     4969         v-max-plu = buf_cd-plu.plu-code .
     4970       end.
     4971       else do:
     4972         v-max-plu = 0.
     4973       end.
     4974       run cd-attr-write  in this-procedure (
     4975                                             input   p-db-num
     4976                                             ,input  p-obj-code
     4977                                             ,input  p-pos-type
     4978                                             ,input  p-cash-num
     4979                                             ,input  'MARIA_operative':U
     4980                                             ,input  (if p-pos-type = 'MARIA':U
     4981                                                     and p-is-petrolium
     4982                                                     then 'max-petrol-plu':U
     4983                                                     else 'max-plu':U)
     4984                                               ,input ''
     4985                                               ,input ?
     4986                                               ,input 0.0
     4987                                               ,input v-max-plu
     4988                                               ,input no
     4989                                             ) no-error .
     4990       if error-status:error then do:
     4991           UNDO, RETURN ERROR RETURN-VALUE.
     4992       END.
     4993     end.
     4994   end procedure.
     4995   PROCEDURE cd-mrkt_clu-marketer :
     4996   define input parameter p-silence as logical no-undo .
     4997   define parameter buffer buf_cash-desk for ub.cash-desk.
     4998   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     4999   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5000   define variable v-tot-cli as integer no-undo .
     5001   define variable v-max-cli as integer no-undo .
     5002   DEFINE VARIABLE v-today as date no-undo .
     5003   DEFINE VARIABLE v-time as integer no-undo .
     5004   define buffer  buf_cd-clu for ub.cd-clu.
     5005   define buffer  loc_cd-clu for ub.cd-clu.
     5006   define variable  ii as integer no-undo.
     5007   define variable v-mes as character no-undo .
     5008   _main:
     5009   DO ON ERROR undo, leave on stop undo, leave:
     5010     if buf_cash-desk.pos-type <> 'MARIA':U
     5011     or buf_cash-desk.cash-num <> 0 then do:
     5012       assign
     5013       v-mes =
     5014       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5015                 , buf_cash-desk.pos-type).
     5016       if not p-silence then
     5017       message
     5018       v-mes
     5019       view-as alert-box error .
     5020       return error v-mes.
     5021     end.
     5022     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5023                                     ,input 'MARIA_operative':U
     5024                                     ,input 'tot-cli':U
     5025                                     ,output v-mes).
     5026     if v-tot-cli = ? then undo _main, return error v-mes.
     5027     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5028                                     ,input 'MARIA_general':U
     5029                                     ,input 'max-cli':U
     5030                                     , output v-mes).
     5031     if v-max-cli = ? then undo _main, return error v-mes.
     5032     DO ii = 1
     5033        to v-max-cli :
     5034       if not can-find (loc_cd-clu where
     5035                       loc_cd-clu.obj-type = 'маг':U
     5036                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5037                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5038                   and loc_cd-clu.clu-type = '':U
     5039                   and loc_cd-clu.clu-code = ii
     5040                      )
     5041       then LEAVE .
     5042     END .
     5043     if ii > v-max-cli then do:
     5044         if not p-silence then
     5045         message
     5046         substitute("Превышено максимально допустимое количество клиентов &1" +
     5047                   "для касс &2 &3&4"
     5048                   , chr(10)
     5049                   , v-max-cli
     5050                   , 'маг':U
     5051                   , buf_cash-desk.obj-code
     5052                   )
     5053         view-as alert-box ERROR .
     5054         undo, return error "max-cli":U.
     5055     end.
     5056     run cur-time in this-procedure ( output v-today, output v-time).
     5057     create buf_cd-clu.
     5058     assign
     5059     buf_cd-clu.cli-code = p-obj-code
     5060     buf_cd-clu.cli-type = p-obj-type
     5061     buf_cd-clu.obj-type = 'маг':U
     5062     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5063     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5064     buf_cd-clu.clu-type = '':U
     5065     buf_cd-clu.to-send = yes
     5066     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5067                               then buf_cash-desk.addr-path
     5068                               else "U":U)
     5069     buf_cd-clu.clu-code = ii
     5070     .
     5071     run cd-attr-write  in this-procedure (
     5072                                           input   buf_cash-desk.db-num
     5073                                           ,input  buf_cash-desk.obj-code
     5074                                           ,input  buf_cash-desk.pos-type
     5075                                           ,input  buf_cash-desk.cash-num
     5076                                           ,input  'MARIA_operative':U
     5077                                           ,input  'tot-cli':U
     5078                                           ,input ''
     5079                                           ,input ?
     5080                                           ,input 0.0
     5081                                           ,input  (v-tot-cli + 1)
     5082                                           ,input no
     5083                                          ) no-error .
     5084     if error-status:error then do:
     5085       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5086                          ,buf_cash-desk.cash-num
     5087                          , 'маг':U
     5088                          ,buf_cash-desk.obj-code
     5089                          , chr(10)
     5090                          , error-status:get-message(1)
     5091                          , return-value
     5092                          ).
     5093       if not p-silence then
     5094       message
     5095       v-mes
     5096       view-as alert-box error .
     5097       undo _main, return error v-mes.
     5098     end.
     5099     run cd-attr-write  in this-procedure (
     5100                                           input   buf_cash-desk.db-num
     5101                                           ,input  buf_cash-desk.obj-code
     5102                                           ,input  buf_cash-desk.pos-type
     5103                                           ,input  buf_cash-desk.cash-num
     5104                                           ,input  'MARIA_operative':U
     5105                                           ,input  'cli-to-send':U
     5106                                           ,input ''
     5107                                           ,input ?
     5108                                           ,input 0.0
     5109                                           ,input 0
     5110                                           ,input yes
     5111                                          ) no-error .
     5112     if error-status:error then do:
     5113       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5114                          ,buf_cash-desk.cash-num
     5115                          , 'маг':U
     5116                          ,buf_cash-desk.obj-code
     5117                          , chr(10)
     5118                          , error-status:get-message(1)
     5119                          , return-value
     5120                          ).
     5121       if not p-silence then
     5122       message
     5123       v-mes
     5124       view-as alert-box error .
     5125       undo _main, return error v-mes.
     5126     end.
     5127     return "":U.
     5128   end.
     5129   END PROCEDURE.
     5130   procedure cd-mrkt_update-marketer-cli :
     5131   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5132   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5133   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5134   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5135   define variable v-cli-to-send as logical no-undo .
     5136   define variable v-tot-cli as integer no-undo .
     5137   define variable v-max-clu as integer no-undo .
     5138   define buffer buf_cd-clu for ub.cd-clu.
     5139   do
     5140   on error undo, return error return-value
     5141   :
     5142     v-cli-to-send = no.
     5143     v-tot-cli = 0.
     5144     FOR EACH buf_cd-clu WHERE
     5145           buf_cd-clu.obj-type = 'маг':U
     5146       and buf_cd-clu.obj-code =  p-obj-code
     5147       and buf_cd-clu.pos-type =  p-pos-type
     5148       and buf_cd-clu.clu-type =  '':U
     5149       :
     5150       if buf_cd-clu.to-del = yes then do:
     5151         assign
     5152         v-cli-to-send = yes.
     5153       end.
     5154       assign
     5155       v-tot-cli = v-tot-cli + 1.
     5156     end.
     5157     run cd-attr-write  in this-procedure (
     5158                                             input   p-db-num
     5159                                             ,input  p-obj-code
     5160                                             ,input  p-pos-type
     5161                                             ,input  p-cash-num
     5162                                             ,input  'MARIA_operative':U
     5163                                             ,input  'tot-cli':U
     5164                                             ,input ''
     5165                                             ,input ?
     5166                                             ,input 0.0
     5167                                             ,input v-tot-cli
     5168                                             ,input no
     5169                                             ) no-error .
     5170     if error-status:error then do:
     5171         UNDO, RETURN ERROR RETURN-VALUE.
     5172     END.
     5173     run cd-attr-write  in this-procedure (
     5174                                             input   p-db-num
     5175                                             ,input  p-obj-code
     5176                                             ,input  p-pos-type
     5177                                             ,input  p-cash-num
     5178                                             ,input  'MARIA_operative':U
     5179                                             ,input  'cli-to-send':U
     5180                                             ,input ''
     5181                                             ,input ?
     5182                                             ,input 0.0
     5183                                             ,input 0
     5184                                             ,input v-cli-to-send
     5185                                             ) no-error .
     5186     if error-status:error then do:
     5187         UNDO, RETURN ERROR RETURN-VALUE.
     5188     END.
     5189     FIND LAST buf_cd-clu WHERE
     5190             buf_cd-clu.obj-type = 'маг':U
     5191         and buf_cd-clu.obj-code = p-obj-code
     5192         and buf_cd-clu.pos-type = p-pos-type
     5193         and buf_cd-clu.clu-type = '':U
     5194         NO-LOCK use-index pi no-error .
     5195     if available buf_cd-clu then do:
     5196       if v-max-clu < buf_cd-clu.clu-code
     5197       then
     5198       v-max-clu = buf_cd-clu.clu-code.
     5199     end.
     5200     else do:
     5201       v-max-clu = 0.
     5202     end.
     5203     run cd-attr-write  in this-procedure (
     5204                                           input   p-db-num
     5205                                           ,input  p-obj-code
     5206                                           ,input  p-pos-type
     5207                                           ,input  p-cash-num
     5208                                           ,input  'MARIA_operative':U
     5209                                           ,input  'max-clu':U
     5210                                           ,input ''
     5211                                           ,input ?
     5212                                           ,input 0.0
     5213                                           ,input v-max-clu
     5214                                           ,input no
     5215                                           ) no-error .
     5216     if error-status:error then do:
     5217         UNDO, RETURN ERROR RETURN-VALUE.
     5218     END.
     5219   end.
     5220   end procedure.
     5221   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5222   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5223   define temp-table temp-dis-card-type no-undo like ub.dis-card-type.
     5224   procedure get-cd-sumid :
     5225   define input parameter p-emitent-host-code as integer no-undo .
     5226   define input parameter p-type as character no-undo .
     5227   define input parameter p-obj-type as character no-undo .
     5228   define input parameter p-obj-code as integer no-undo .
     5229   define input parameter p-host-code as integer no-undo .
     5230   define output parameter p-sum-id-value as character no-undo .
     5231   define output parameter p-sum-id-output as logical no-undo .
     5232   define variable v-param-type as character no-undo .
     5233   define variable v-value-character as character no-undo .
     5234   define variable v-value-date as date no-undo .
     5235   define variable v-value-decimal as decimal no-undo .
     5236   define variable v-value-integer as INTEGER no-undo .
     5237   define variable v-value-logical AS LOGICAL no-undo .
     5238   define variable v-tth as handle no-undo .
     5239   define variable v-dt-code as integer no-undo .
     5240   define variable v-dtm-code as integer no-undo .
     5241   define variable v-caller-id as character no-undo .
     5242   define variable v-node-code as integer no-undo .
     5243   define variable v-node-value-type as character no-undo .
     5244   define variable v-value-field-name as character no-undo .
     5245   define variable v-storage-place as character no-undo .
     5246   define variable v-current-sum-id1 as character no-undo .
     5247   define variable v-current-sum-id2 as character no-undo .
     5248   DEFINE VARIABLE v-today as date no-undo .
     5249   DEFINE VARIABLE v-time as integer no-undo .
     5250   define variable v-ii as integer no-undo .
     5251   define buffer buf_prop-ref for ub.prop-ref.
     5252   define buffer buf_prop-map for ub.prop-map.
     5253   define buffer buf_temp-dis-card-type for temp-dis-card-type.
     5254   define buffer buf_dis-card-type for ub.dis-card-type.
     5255   do
     5256   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5257   :
     5258     find first buf_temp-dis-card-type no-lock where
     5259               buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     5260           and buf_temp-dis-card-type.type = p-type
     5261           and buf_temp-dis-card-type.obj-type = p-obj-type
     5262           and buf_temp-dis-card-type.obj-code = p-obj-code no-error .
     5263     if not available buf_temp-dis-card-type then do:
     5264       find first buf_dis-card-type no-lock where
     5265                 buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5266             and buf_dis-card-type.type = p-type
     5267             and buf_dis-card-type.obj-type = p-obj-type
     5268             and buf_dis-card-type.obj-code = p-obj-code no-error .
     5269       if not available buf_Dis-card-type then do:
     5270         find first buf_dis-card-type no-lock where
     5271                   buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5272               and buf_dis-card-type.type = p-type
     5273               and buf_dis-card-type.host-code = p-host-code no-error .
     5274         if not available buf_Dis-card-type
     5275         and p-emitent-host-code = 0 then do:
     5276           find first buf_dis-card-type no-lock where
     5277                     buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5278                 and buf_dis-card-type.type = p-type
     5279                 and buf_dis-card-type.host-code = 0 no-error .
     5280         end.
     5281       end.
     5282       if available buf_dis-card-type then do:
     5283         find first buf_temp-dis-card-type where
     5284                     buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     5285                 and buf_temp-dis-card-type.type = p-type
     5286                 and buf_temp-dis-card-type.host-code = 0 no-error .
     5287         if not available buf_temp-dis-card-type then do:
     5288           create buf_temp-dis-card-type.
     5289           buffer-copy buf_dis-card-type to
     5290           buf_temp-dis-card-type.
     5291         end.
     5292       end.
     5293     end.
     5294     if available buf_temp-dis-card-type then do:
     5295       assign
     5296       v-sum-id-value = buf_temp-dis-card-type.custom-sent
     5297       p-sum-id-output = not (v-sum-id-value = fill(chr(63), num-entries(v-sum-id-value)))
     5298       .
     5299     end.
     5300     if p-sum-id-output then do:
     5301       do v-ii = 1 to num-entries(v-sum-id-value):
     5302         assign
     5303         v-value-character = entry(v-ii, v-sum-id-value)
     5304         v-storage-place = entry(1, v-value-character, chr(4))
     5305         v-dtm-code = integer(entry(2, v-value-character, chr(4)))
     5306         v-sum-id   = entry(3, v-value-character, chr(4))
     5307         v-caller-id = entry(4, v-value-character, chr(4))
     5308         v-node-code = integer(entry(5, v-value-character, chr(4)))
     5309         no-error .
     5310         if error-status:error then do:
     5311           assign
     5312           p-sum-id-value = chr(63)
     5313           p-sum-id-output = no
     5314           .
     5315           return.
     5316         end.
     5317         else do:
     5318           run cur-time in this-procedure ( output v-today, output v-time).
     5319           _prop-ref:
     5320           for each buf_prop-ref no-lock where
     5321                   buf_prop-ref.dtm-code = v-dtm-code
     5322               and buf_prop-ref.caller_id = v-caller-id,
     5323               first buf_prop-map no-lock where
     5324                     buf_prop-map.dtm-code = v-dtm-code
     5325                 and buf_prop-map.node-code = v-node-code
     5326           by buf_prop-ref.dtm-code
     5327           by buf_prop-ref.sum-id:
     5328             assign
     5329             p-sum-id-value = substitute("&2&1&3&1&4&1&5"
     5330                                         , chr(4)
     5331                                         ,v-storage-place
     5332                                         ,buf_prop-ref.dt-code
     5333                                         ,v-node-code
     5334                                         ,buf_prop-map.node-name).
     5335             if buf_prop-ref.ref-type = 'period':U then do:
     5336               v-current-sum-id1 = entry(1, buf_prop-ref.sum-id, "-":U) + "-" + dct-algo-Date-to-String(v-today).
     5337               v-current-sum-id2 = dct-algo-Date-to-String(v-today) + "-" + entry(2, buf_prop-ref.sum-id, "-":U).
     5338               if v-current-sum-id1 <= buf_prop-ref.sum-id
     5339               and v-current-sum-id2 >= buf_prop-ref.sum-id
     5340               then do:
     5341                 leave _prop-ref.
     5342               end.
     5343             end.
     5344             else do:
     5345               if buf_prop-ref.sum-id = v-sum-id then leave _prop-ref.
     5346             end.
     5347           end.
     5348           if not available buf_prop-ref then do:
     5349             assign
     5350             p-sum-id-value = chr(63)
     5351             p-sum-id-output = no
     5352             .
     5353           end.
     5354         end.
     5355       end.
     5356     end.
     5357   end.
     5358   end procedure.
     5359   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5360   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5361   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
     5362   define variable v-date-str as character no-undo .
     5363   assign
     5364   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     5365                string(Month(p-date), "99":U) + chr(47) +
     5366                string(DAY(p-date), "99":U).
     5367   return v-date-str.
     5368   END FUNCTION.
     5369   function propreft-string-to-date returns date ( input p-string  as character):
     5370     define variable v-date as date no-undo .
     5371     assign
     5372     v-date = date(integer(substring(p-string, 6, 2))
     5373                   ,integer(substring(p-string, 9, 2))
     5374                   ,integer(substring(p-string, 1, 4))
     5375                  ) no-error .
     5376     if error-status:error then return ?.
     5377     return v-date.
     5378   END FUNCTION.
     5379   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
     5380   define variable v-date-str as character no-undo .
     5381   assign
     5382   v-date-str = substitute("petrol-&1", p-gds-code).
     5383   return v-date-str.
     5384   END FUNCTION.
     5385   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
     5386   define variable v-gds-code as integer no-undo .
     5387   assign
     5388   v-gds-code = integer(entry(2, p-string, "-")) no-error.
     5389   return v-gds-code.
     5390   END FUNCTION.
     5391   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5392   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5393   FUNCTION get-dpcn RETURNS CHARACTER (
     5394        input p-d-card as character
     5395       ,input p-emitent-host-code as integer
     5396       ,input p-type as character
     5397       ,input parhost-code as integer
     5398       ,input parobj-type as character
     5399       ,input parobj-code as integer
     5400       ,input p-node-code as integer
     5401       ,input p-d-pcnt as decimal
     5402       ,input p-cash-d-pcnt as decimal
     5403       ,input p-category as integer
     5404       ) :
     5405   define buffer buf_dis-card-type for ub.dis-card-type.
     5406   define variable loc-d-v as decimal no-undo init ?.
     5407   define variable v-discnt-role as character no-undo .
     5408   define buffer buf_dis-card-property for ub.dis-card-property.
     5409   find first buf_dis-card-type no-lock where
     5410             buf_dis-card-type.type = p-type
     5411         and buf_dis-card-type.emitent-host-code = p-emitent-host-code
     5412         and buf_dis-card-type.host-code = 0
     5413         and buf_dis-card-type.obj-type = '':U
     5414         and buf_dis-card-type.obj-code = 0 no-error.
     5415   if available buf_dis-card-type then do:
     5416     case p-node-code:
     5417       when 1 then do:
     5418         assign
     5419         v-discnt-role = 'def-pcnt':U .
     5420       end.
     5421       when 2 then do:
     5422         assign
     5423         v-discnt-role = 'def-cash-pcnt':U.
     5424       end.
     5425       when 3 then do:
     5426         assign
     5427         v-discnt-role = 'def-categ':U.
     5428       end.
     5429     end case.
     5430     if buf_dis-card-type.d-pcnt-byshop then do:
     5431      find first buf_dis-card-property no-lock where
     5432                buf_dis-card-property.d-card = p-d-card
     5433            and buf_dis-card-property.dtm-code = 26
     5434            and buf_dis-card-property.host-code = parhost-code
     5435            and buf_dis-card-property.obj-type = parobj-type
     5436            and buf_dis-card-property.obj-code = parobj-code
     5437            and buf_dis-card-property.node-code = p-node-code no-error.
     5438      if available buf_dis-card-property then do:
     5439        if v-discnt-role = 'def-categ':U then do:
     5440          assign
     5441          loc-d-v = buf_dis-card-property.property-value-integer.
     5442        end.
     5443        else do:
     5444          assign
     5445          loc-d-v = buf_dis-card-property.property-value-decimal.
     5446        end.
     5447      end.
     5448      if loc-d-v = ? then do:
     5449   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5451     (
     5452      input  p-type
     5453     ,input  p-emitent-host-code
     5454     ,input  parhost-code
     5455     ,input  parobj-type
     5456     ,input  parobj-code
     5457     ,input  v-discnt-role
     5458     ,output loc-d-v
     5459     ) no-error .
     5460       end.
     5461       if loc-d-v = ? then do:
     5462         find first buf_dis-card-property no-lock where
     5463                   buf_dis-card-property.d-card = p-d-card
     5464               and buf_dis-card-property.dtm-code = 26
     5465               and buf_dis-card-property.host-code = parhost-code
     5466               and buf_dis-card-property.obj-type = ''
     5467               and buf_dis-card-property.obj-code = 0
     5468               and buf_dis-card-property.node-code = p-node-code no-error.
     5469         if available buf_dis-card-property then do:
     5470           if v-discnt-role = 'def-categ':U then do:
     5471             assign
     5472             loc-d-v = buf_dis-card-property.property-value-integer.
     5473           end.
     5474           else do:
     5475             assign
     5476             loc-d-v = buf_dis-card-property.property-value-decimal.
     5477           end.
     5478         end.
     5479       end.
     5480       if loc-d-v = ? then do:
     5481   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5483     (
     5484      input  p-type
     5485     ,input  p-emitent-host-code
     5486     ,input  parhost-code
     5487     ,input  ''
     5488     ,input  0
     5489     ,input  v-discnt-role
     5490     ,output loc-d-v
     5491     ) no-error .
     5492       end.
     5493       if loc-d-v = ? then do:
     5494         case v-discnt-role:
     5495           when 'def-categ':U then do:
     5496             loc-d-v = p-category.
     5497           end.
     5498           when 'def-pcnt':U then do:
     5499             loc-d-v = p-d-pcnt.
     5500           end.
     5501           when 'def-cash-pcnt':U then do:
     5502             loc-d-v = p-cash-d-pcnt.
     5503           end.
     5504         end case.
     5505       end.
     5506       if v-discnt-role = 'def-categ':U then do:
     5507         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     5508       end.
     5509       else do:
     5510         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     5511       end.
     5512     end.
     5513   end.
     5514   else do:
     5515    return "ОШИБКА-НЕТ ТИПА".
     5516   end.
     5517   case v-discnt-role:
     5518     when 'def-categ':U then do:
     5519        loc-d-v = p-category.
     5520        return string(loc-d-v, ">>>9").
     5521     end.
     5522     when 'def-pcnt':U then do:
     5523       loc-d-v = p-d-pcnt.
     5524       return string(loc-d-v, "->9.99%").
     5525     end.
     5526     when 'def-cash-pcnt':U then do:
     5527       loc-d-v = p-cash-d-pcnt.
     5528       return string(loc-d-v, "->9.99%").
     5529     end.
     5530   end case.
     5531   END FUNCTION.
     5532   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     5533   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5534   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     5535   procedure disrules-fill-properties:
     5536   define input  parameter p-templ-rl-root as integer   no-undo .
     5537   define buffer buf_drt-prop for ub.drt-prop.
     5538   define buffer buf_temp-drt-prop for temp-drt-prop.
     5539   do
     5540   on error undo, return error return-value
     5541   :
     5542     for each buf_temp-drt-prop:
     5543       delete buf_temp-drt-prop.
     5544     end.
     5545     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     5546       create buf_temp-drt-prop.
     5547       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     5548     end.
     5549   end.
     5550   end procedure.
     5551   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     5552   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     5553   procedure create-dis-rule :
     5554   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     5555   define input parameter p-tree as logical no-undo .
     5556   define buffer buf_dis-rule for ub.dis-rule.
     5557   define buffer buf_dis-time-rule for ub.dis-time-rule.
     5558   define buffer term_dis-rule for ub.dis-rule.
     5559   define buffer term_dis-time-rule for ub.dis-time-rule.
     5560   define buffer root_cash-dis-rule for cash-dis-rule.
     5561   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     5562   define buffer term_cash-dis-rule for cash-dis-rule.
     5563   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     5564     do
     5565     on error undo, return error
     5566     :
     5567       find first root_cash-dis-rule no-lock where                                                         ~
     5568                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     5569       if not available root_cash-dis-rule then do:
     5570         find first buf_dis-rule no-lock where
     5571                   buf_dis-rule.rule-num = p-rule-num no-error.
     5572         if available buf_dis-rule then do:
     5573           if buf_dis-rule.time-rule-num <> 0 then do:
     5574             find first buf_dis-time-rule no-lock where
     5575                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     5576           end.
     5577           create root_cash-dis-rule.
     5578           buffer-copy buf_dis-rule to root_cash-dis-rule.
     5579           if available buf_dis-time-rule then do:
     5580             find first root_cash-dis-time-rule no-lock where
     5581                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     5582             if not available root_cash-dis-time-rule then do:
     5583               create root_cash-dis-time-rule.
     5584               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     5585             end.
     5586           end.
     5587           else do:
     5588             assign
     5589             root_cash-dis-rule.time-rule-num = 0.
     5590           end.
     5591           if buf_dis-rule.uniq-field <> "":U then do:
     5592             for each term_dis-rule no-lock where
     5593                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     5594               if term_dis-rule.time-rule-num <> 0 then do:
     5595                 find first term_dis-time-rule no-lock where
     5596                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     5597               end.
     5598               create term_cash-dis-rule.
     5599               buffer-copy term_dis-rule to term_cash-dis-rule.
     5600               if term_dis-rule.time-rule-num = 0
     5601               or available term_dis-time-rule
     5602               or root_cash-dis-rule.time-rule-num = 0
     5603               then do:
     5604                 if available term_dis-time-rule then do:
     5605                   find first term_cash-dis-time-rule no-lock where
     5606                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     5607                   if not available term_cash-dis-time-rule then do:
     5608                     create term_cash-dis-time-rule.
     5609                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     5610                   end.
     5611                 end.
     5612               end.
     5613             end.
     5614           end.
     5615         end.
     5616       end.
     5617     end.
     5618   end procedure.
     5619   define variable ii as integer no-undo.
     5620   define variable conf-attr as character no-undo.
     5621   define variable conf-par as character no-undo.
     5622   define variable par-type as character no-undo.
     5623   DEFINE VARIABLE ind as integer no-undo .
     5624   DEFINE VARIABLE v-type as character no-undo .
     5625   define variable alllstcs as logical no-undo init no.
     5626   define variable v-curr-r-b as character no-undo .
     5627   define variable v-date-format as character no-undo .
     5628   define variable v-del-mrkt-cli as logical        no-undo .
     5629   define variable v-record as character no-undo .
     5630   define variable dr-list as character no-undo .
     5631   define variable drdcrank as character no-undo .
     5632   define variable v-magia-kat-codes-rule as integer no-undo .
     5633   define buffer for-shop for ub.shop.
     5634   define buffer for-clients for ub.clients.
     5635   define buffer lock-batchprocess for ub.batchprocess .
     5636   define buffer buf_cash-desk for ub.cash-desk.
     5637   define variable run-from as char no-undo.
     5638   define variable v-num as integer no-undo.
     5639   DEFINE VARIABLE var-report-num as integer no-undo .
     5640   DEFINE VARIABLE v-date as date no-undo .
     5641   DEFINE VARIABLE v-time as integer no-undo .
     5642   assign
     5643   i-obj-code = integer(entry(1, p-parameter, chr(4)))
     5644   action = entry(2, p-parameter, chr(4))
     5645   multiple-shops = (if entry(3, p-parameter, chr(4)) = "yes":U
     5646                    then yes
     5647                    else (if entry(3, p-parameter, chr(4)) = "no":U
     5648                          then no
     5649                          else ?)
     5650                    )
     5651   p-batch = (if entry(4, p-parameter, chr(4)) = "yes":U
     5652                    then yes
     5653                    else (if entry(4, p-parameter, chr(4)) = "no":U
     5654                          then no
     5655                          else ?)
     5656                    )
     5657   p-other = (if num-entries(p-parameter, chr(4)) >= 5
     5658             then entry(5, p-parameter, chr(4))
     5659             else '':U)
     5660   no-error
     5661   .
     5662   if error-status:error
     5663   or multiple-shops = ?
     5664   or p-batch = ?
     5665   then
     5666   return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5667   assign
     5668   v-del-mrkt-cli = lookup("del-mrkt-cli":U, p-other) > 0
     5669   .
     5670   run fill-temp-cd in this-procedure ( input g#db-num, input 'маг':U, input i-obj-code, input yes).
     5671   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5672   define variable v-param-type35 as character no-undo .
     5673   define variable v-value-character35 as date no-undo .
     5674   define variable v-value-date35 as date no-undo .
     5675   define variable v-value-decimal35 as decimal no-undo .
     5676   define variable v-value-integer35 as INTEGER no-undo .
     5677   define variable v-value-logical35 AS LOGICAL no-undo .
     5678   define variable v-tth35 as handle no-undo .
     5679   define variable cdpcknum as integer no-undo init 200.
     5680   run adm/shattri.p (
     5681       input "get":U
     5682       ,input  'маг':U
     5683       ,input  i-obj-code
     5684       ,input  'cd-sending':U
     5685       ,input  'cdpcknum':U
     5686       ,output v-value-character35
     5687       ,output v-value-date35
     5688       ,output v-value-decimal35
     5689       ,output cdpcknum
     5690       ,output v-value-logical35
     5691       ,output v-param-type35
     5692       ,INPUT-OUTPUT table-handle v-tth35
     5693       )  .
     5694   delete object v-tth35.
     5695   define variable p-obj-type as character no-undo.
     5696   p-obj-type = 'маг':U.
     5697   run adm/shattri.p (
     5698       input "get":U
     5699       ,input  'маг':U
     5700       ,input  i-obj-code
     5701       ,input  'cd-sending':U
     5702       ,input  'alllstcs':U
     5703       ,output v-value-character
     5704       ,output v-value-date
     5705       ,output v-value-decimal
     5706       ,output v-value-integer
     5707       ,output v-value-logical
     5708       ,output v-param-type
     5709       ,INPUT-OUTPUT table-handle v-tth
     5710       ) no-error .
     5711   IF not error-status:error
     5712   then do:
     5713     delete object v-tth.
     5714     alllstcs = v-value-logical.
     5715   end.
     5716   else do:
     5717     delete object v-tth.
     5718     return error return-value .
     5719   end.
     5720   assign
     5721   var-report-num = dynamic-next-value( "next-report":U, "ubflt":U)
     5722   .
     5723   FIND ub.shop WHERE ub.shop.obj-code = i-obj-code NO-LOCK .
     5724   FIND ub.sysconf WHERE ub.sysconf.host-code = ub.shop.host-code NO-LOCK .
     5725   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5727     (output v-curr-r-b
     5728     )  .
     5729   if action = "S":U then
     5730   assign
     5731   run-from = "S":U
     5732   action = "U":U.
     5733   if action = "O":U then
     5734   assign
     5735   run-from = "O":U
     5736   action = "U":U.
     5737   if action = "E":U then
     5738   assign
     5739   run-from = "E":U
     5740   action = "U":U.
     5741   if can-find(first cash-desk No-LOCK WHERE
     5742                     cash-desk.db-num = g#db-num and
     5743                     cash-desk.obj-code = i-obj-code AND
     5744                     cash-desk.cash-on = yes AND
     5745                     cash-desk.pos-type = 'IPC-Servis+':U) then do:
     5746     _lock-cli:
     5747     DO while ind < 100 :
     5748     run gbl/lock-prc.p
     5749         (input 'pcd2':U
     5750         ,input i-obj-code
     5751         ,input 0
     5752         ,input 0
     5753         ,input 'маг':U
     5754         ,input ""
     5755         ,input ""
     5756         ,input (
     5757                 "Код объекта" + ",,," +
     5758                 "Тип объекта" +  ",,,Передача диск. карт"
     5759               )
     5760         ,input no
     5761         ,buffer lock-batchprocess
     5762         ) no-error .
     5763       if not error-status:error then do:
     5764         leave _lock-cli.
     5765       end.
     5766     run write-log-and-file in p-log-handle (
     5767           input 1
     5768         , input log-file-name
     5769         , input 1
     5770         , input substitute( "Объект &1: Файл для выгрузки данных ЗАНЯТ - Ждите", i-obj-code
     5771                           )
     5772                                           ).
     5773       pause 1.
     5774     end.
     5775   end.
     5776   if can-find(first cash-desk No-LOCK WHERE
     5777                     cash-desk.db-num = g#db-num and
     5778                     cash-desk.obj-code = i-obj-code AND
     5779                     cash-desk.cash-on = yes AND
     5780                     cash-desk.pos-type = 'MAGIA-XML':U) then do:
     5781     find first buf_dis-thbj-rule no-lock where
     5782               buf_dis-thbj-rule.obj-type = ''
     5783            and buf_dis-thbj-rule.obj-code = 0
     5784            and buf_dis-thbj-rule.pos-type = 'MAGIA-XML':U
     5785            and buf_dis-thbj-rule.discnt-role = 'kateg-codes':U no-error .
     5786     if available buf_dis-thbj-rule then do:
     5787       v-magia-kat-codes-rule = buf_dis-thbj-rule.rule-num.
     5788       run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num, yes) no-error .
     5789     end.
     5790   end.
     5791   if v-del-mrkt-cli then do:
     5792     for each cash-cli:
     5793   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5794   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     5795   IF can-find( first temp-cd where temp-cd.pos-type = 'MARIA':U) then do:
     5796     for each buf_dis-dc-rule no-lock where
     5797               buf_dis-dc-rule.d-card = cash-cli.d-card
     5798           and buf_dis-dc-rule.host-code = ub.sysconf.host-code
     5799           and buf_dis-dc-rule.obj-type = 'маг':U
     5800           and buf_dis-dc-rule.obj-code = i-obj-code:
     5801       if buf_dis-dc-rule.discnt-role = 'debet-pay-pcnt-disc':U
     5802       or buf_dis-dc-rule.discnt-role = 'debet-pay-abs-disc':U
     5803       or buf_dis-dc-rule.discnt-role = 'debet-pay-qnty-disc':U
     5804       or buf_dis-dc-rule.discnt-role = 'debet-pay-sum-disc':U
     5805       or buf_dis-dc-rule.discnt-role = 'debet-pay-free-disc':U  then do:
     5806         assign
     5807         cash-cli.dcr-debet-pay = buf_dis-dc-rule.rule-num
     5808         no-error
     5809         .
     5810         leave.
     5811       end.
     5812     end.
     5813     for each buf_dis-dc-rule no-lock where
     5814               buf_dis-dc-rule.d-card = cash-cli.d-card
     5815           and buf_dis-dc-rule.host-code = ub.sysconf.host-code
     5816           and buf_dis-dc-rule.obj-type = 'маг':U
     5817           and buf_dis-dc-rule.obj-code = i-obj-code:
     5818       if buf_dis-dc-rule.discnt-role = 'credit-pay-pcnt-disc':U
     5819       or buf_dis-dc-rule.discnt-role = 'credit-pay-abs-disc':U
     5820       or buf_dis-dc-rule.discnt-role = 'credit-pay-qnty-disc':U
     5821       or buf_dis-dc-rule.discnt-role = 'credit-pay-sum-disc':U
     5822       or buf_dis-dc-rule.discnt-role = 'credit-pay-free-disc':U  then do:
     5823         assign
     5824         cash-cli.dcr-credit-pay = buf_dis-dc-rule.rule-num
     5825         no-error
     5826         .
     5827       end.
     5828     end.
     5829   end.
     5830     end.
     5831     find last cash-cli use-index pi no-error .
     5832     if available cash-cli then do:
     5833       cr = cash-cli.crf + 1.
     5834     end.
     5835   end.
     5836   if g#news
     5837   or g#esys
     5838   OR run-from = "S":U
     5839   or run-from = "O":U
     5840   or run-from = "E":U
     5841   then do:
     5842     FOR EACH dc-list NO-LOCK,
     5843         FIRST dis-card no-lock where
     5844               dis-card.d-card = dc-list.d-card,
     5845         first clients no-lock where
     5846               clients.obj-type = dis-card.cli-type
     5847           AND  clients.obj-code = dis-card.cli-code,
     5848         FIRST ub.dis-card-type No-LOCK WHERE
     5849               ub.dis-card-type.type = dis-card.type AND
     5850               ub.dis-card-type.emitent-host-code = dis-card.emitent-host-code AND
     5851               ub.dis-card-type.host-code = 0 AND
     5852               ub.dis-card-type.obj-type = "":U AND
     5853               ub.dis-card-type.obj-code = 0 :
     5854       if dis-card.emitent-host-code <> 0 and
     5855         dis-card.emitent-host-code <> ub.shop.host-code then NEXT.
     5856       ii = ii + 1.
     5857   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5858   FIND FIRST cash-cli where cash-cli.crf = (cr + 1) No-ERROR.
     5859   start-paket = no.
     5860   if not avail cash-cli then
     5861   create cash-cli.
     5862   else do:
     5863     assign
     5864     cash-cli.cli-adr   = ""
     5865     cash-cli.cli-adr2  = ""
     5866     cash-cli.director  = ""
     5867     cash-cli.engl-name = ""
     5868     cash-cli.telex     = "":U
     5869     cash-cli.phone1-note  = "":U
     5870     cash-cli.post-addr1 = "":U
     5871     cash-cli.post-addr2 = "":U
     5872     cash-cli.phone1  = "":U
     5873     cash-cli.post-box  = ""
     5874     cash-cli.valid-date = 12/31/9999
     5875     cash-cli.property-value-chr[1] = '':U
     5876     cash-cli.property-value-chr[2] = '':U
     5877     cash-cli.property-value-chr[3] = '':U
     5878     cash-cli.property-value-chr[4] = '':U
     5879     cash-cli.dcr-pcnt        = 0
     5880     cash-cli.dcr-abs         = 0
     5881     cash-cli.dcr-pcnt-qnty   = 0
     5882     cash-cli.dcr-pcnt-tot    = 0
     5883     cash-cli.ef-format       = 0
     5884     cash-cli.ef-access-key   = ""
     5885     cash-cli.has-attrs       = no
     5886     cash-cli.has-attrs-lim   = no
     5887     .
     5888   end.
     5889   error-status:error = false.
     5890   cash-cli.crf = cr + 1.
     5891   cr = cr + 1.
     5892   if ub.clients.obj-type = 'орг':U then do:
     5893     FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code .
     5894     assign
     5895     cash-cli.cli-type = 'орг':U
     5896     cash-cli.cli-code = ub.clients.obj-code
     5897     cash-cli.cli-city = ub.firm.city
     5898     cash-cli.cli-adr = trim( ub.firm.addres1 )
     5899     cash-cli.cli-adr2 = trim( ub.firm.addres2 )
     5900     cash-cli.director = trim( ub.firm.director )
     5901     cash-cli.e-mail = trim( ub.firm.e-mail )
     5902     cash-cli.engl-name = trim( ub.firm.engl-name)
     5903     cash-cli.fax     = trim( ub.firm.fax)
     5904     cash-cli.telex     = trim( ub.firm.telex)
     5905     cash-cli.position  = trim( ub.firm.head-position)
     5906     cash-cli.is-pboul  = ub.firm.is-pboul
     5907     cash-cli.okonh     = trim(ub.firm.okonh)
     5908     cash-cli.okpo      = trim(ub.firm.okpo)
     5909     cash-cli.phone1-note  = trim(ub.firm.phone1-note)
     5910     cash-cli.post-addr1 = trim( ub.firm.post-addr1 )
     5911     cash-cli.post-addr2 = trim( ub.firm.post-addr2 )
     5912     cash-cli.cli-inn = trim(ub.firm.inn)
     5913     cash-cli.cli-phone = trim(ub.firm.phone)
     5914     cash-cli.cli-ind = ub.firm.ind
     5915     cash-cli.justface = 1
