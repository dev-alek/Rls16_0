     8263       then do:
     8264         if lookup(string(for-cash-desk.cash-num), buf_cd-clu.charkey_one) > 0 then do:
     8265           entry(lookup(string(for-cash-desk.cash-num), buf_cd-clu.charkey_one)  ,  buf_cd-clu.charkey_one) = '':U.
     8266           assign
     8267           buf_cd-clu.charkey_one = replace(buf_cd-clu.charkey_one, chr(44) + chr(44), chr(44))
     8268           .
     8269         end.
     8270         if buf_cd-clu.charkey_one = '':U then do:
     8271           delete buf_cd-clu.
     8272           NEXT.
     8273         end.
     8274       end.
     8275       if temp-cd-clu.charkey_two = "":U
     8276       then
     8277       assign
     8278       buf_cd-clu.charkey_two = "":U
     8279       buf_cd-clu.to-send = no
     8280       .
     8281       delete temp-cd-clu.
     8282     end.
     8283   end.
     8284   end.
     8285   run cd-mrkt_update-marketer-cli in this-procedure (
     8286                                                   input for-cash-desk.db-num
     8287                                                   ,input for-cash-desk.obj-code
     8288                                                   ,input for-cash-desk.pos-type
     8289                                                   ,input for-cash-desk.cash-num
     8290                                                 )  .
     8291       end.
     8292     end.
     8293   END CASE.
     8294   END .
     8295   END PROCEDURE.
     8296   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8297   PROCEDURE SENDING:
     8298   DEFINE VARIABLE fq as integer no-undo .
     8299   define variable glog as logical no-undo .
     8300   if can-find(first cash-desk No-LOCK WHERE
     8301                     cash-desk.db-num = g#db-num and
     8302                     cash-desk.obj-code = i-obj-code AND
     8303                     cash-desk.cash-on = yes AND
     8304                     cash-desk.pos-type = 'MAGIA-XML':U) then do:
     8305     find first buf_dis-thbj-rule no-lock where
     8306               buf_dis-thbj-rule.obj-type = ''
     8307            and buf_dis-thbj-rule.obj-code = 0
     8308            and buf_dis-thbj-rule.pos-type = 'MAGIA-XML':U
     8309            and buf_dis-thbj-rule.discnt-role = 'kateg-codes':U no-error .
     8310     if available buf_dis-thbj-rule then do:
     8311       v-magia-kat-codes-rule = buf_dis-thbj-rule.rule-num.
     8312       run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num, yes) no-error .
     8313     end.
     8314   end.
     8315   FOR EACH ub.cash-desk NO-LOCK WHERE
     8316           ub.cash-desk.db-num = g#db-num AND
     8317            ub.cash-desk.obj-code = i-obj-code AND
     8318           ub.cash-desk.cash-on
     8319   BREAK
     8320   By ub.cash-desk.pos-type :
