       82   define variable action as character no-undo.
       83   define variable multiple-shops as logical no-undo.
       84   define variable p-batch as logical no-undo .
       85   define variable p-other as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
