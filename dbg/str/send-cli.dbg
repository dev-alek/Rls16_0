     6298   define variable v-date as date      no-undo.
     6299   define variable v-time  as integer   no-undo.
     6300   define variable v-full-number like ub.dis-card.d-card no-undo .
     6301   define variable v-cli-mask like ub.dis-card-mask.cli-mask no-undo .
     6302   define variable v-versiond as decimal no-undo .
     6303   define variable v-clu as integer no-undo .
