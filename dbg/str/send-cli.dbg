     8357                 , input "send":U
     8358                 , output out
     8359                 , output out2
     8360                 , output in_
     8361                 , output spl
     8362                 , output sav
     8363                 , output v-remote
     8364                 )  no-error .
     8365   if error-status:error then do:
     8366     run write-log-and-file in p-log-handle (
     8367           input 1
     8368         , input log-file-name
     8369         , input 1
     8370         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     8371                             , ub.cash-desk.pos-type
     8372                             , ub.cash-desk.obj-code
     8373                             , chr(10)
     8374                             , error-status:get-message(1)
     8375                             , return-value )).
     8376     assign
     8377     v-view-log = yes.
     8378     return error.
     8379   end.
     8380   if ub.cash-desk.pos-type = 'IBM-XML':U
     8381   or ub.cash-desk.pos-type = 'Autotank':U
     8382   then do:
     8383     file-info:file-name = (out  + "undelivered").
     8384     if file-info:FULL-PATHNAME <> ? then do:
     8385       run str/rsndxibm.p ( input parparentproc
     8386                           ,input p-parent-handle
     8387                           ,input p-log-handle
     8388                           ,input out  + "undelivered" ) no-error.
     8389     end.
     8390   end.
     8391     end.
