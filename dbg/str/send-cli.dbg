      220   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   define variable v-disprop-menu-section-num as integer no-undo .
      223   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure gen-key-rec :
      226     define input  parameter p-tbl-name    as character no-undo.
      227     define input  parameter p-bh_tbl-name as handle    no-undo.
      228     define output parameter p-key-rec     as character no-undo.
      229     do
      230     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      231     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      232     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      233     :
      234       define variable fh               as handle    no-undo .
      235       define variable v-ok             as logical   no-undo .
      236       define variable v-inform         as character no-undo .
      237       define variable v-ind            as integer   no-undo .
      238       define variable v-idx-field-qnty as integer   no-undo .
      239       if p-tbl-name = ?
      240         or p-tbl-name = "":U
      241       then do:
      242         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      243       end.
      244       if not p-bh_tbl-name:available then do:
      245         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      246       end.
      247       assign
      248         p-key-rec = p-tbl-name
      249         v-inform  = p-bh_tbl-name:index-information(1)
      250         v-ind     = 2
      251       .
      252       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      253       on error undo, return error
      254       :
      255         assign
      256           v-inform = p-bh_tbl-name:index-information( v-ind )
      257           v-ind    = v-ind + 1
      258         .
      259       end.
      260       if v-inform = ?
      261         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      262         or entry( 3, v-inform, ",":U ) <> "1":U
      263       then do:
      264         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      265       end.
      266       else do:
      267         assign
      268           v-idx-field-qnty = num-entries( v-inform ) - 4
      269         .
      270         if v-idx-field-qnty < 2 then do:
      271           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      272         end.
      273         do v-ind = 1 to v-idx-field-qnty by 2
      274         on error undo, return error
      275         :
      276           assign
      277             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      278             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      279           .
      280         end.
      281       end.
      282       if p-key-rec = ? then do:
      283         assign
      284           p-key-rec = "":U
      285         .
      286         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      287       end.
      288     end.
      289     return.
      290   end procedure.
      291   procedure gen-where-keyr-tab :
      292     define input  parameter i-tableSerach as character no-undo.
      293     define input  parameter i-tablekey   as character  no-undo.
      294     define input  parameter p-key-rec    as character  no-undo.
      295     define input  parameter p-key-handle as handle     no-undo .
      296     define input  parameter p-db-name    as character  no-undo .
      297     define input  parameter p-tt-handle  as handle     no-undo .
      298     define output parameter o-Where      as character  no-undo.
      299     do
      300     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      301     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      302     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      303     :
      304       define variable v-full-tbl-name  as character no-undo .
      305       define variable bh_tbl-name      as handle    no-undo .
      306       define variable fh_key           as handle    no-undo .
      307       define variable fh_search        as handle    no-undo .
      308       define variable v-field-num      as integer   no-undo .
      309       define variable v-count-fld      as integer   no-undo .
      310       define variable v-inform         as character no-undo .
      311       define variable v-ind            as integer   no-undo .
      312       define variable v-idx-field-qnty as integer   no-undo .
      313       define variable v-field-name     as character no-undo .
      314       define variable v-field-val      as character no-undo .
      315       define variable v-word-link      as character no-undo .
      316       define variable vTable           as character no-undo.
      317       define variable bh_tbl-key       as handle    no-undo .
      318       assign
      319         p-key-rec = trim( p-key-rec )
      320       .
      321       if p-key-handle <> ? then do:
      322         if not valid-handle(p-key-handle)
      323            or p-key-handle:type <> "buffer"
      324         then do:
      325           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      326         end.
      327         if num-entries( p-key-rec, chr(3) ) > 1
      328           or p-key-rec = ?
      329           or p-key-rec = "":U
      330         then do:
      331           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      332         end.
      333       end.
      334       else do:
      335         if p-key-rec = ?
      336           or p-key-rec = "":U
      337         then do:
      338           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      339         end.
      340       end.
      341       assign
      342         vTable = entry( 1 , p-key-rec, chr(3) )
      343       .
      344       if p-tt-handle <> ?
      345         and ( not valid-handle(p-tt-handle)
      346               or p-tt-handle:type <> "buffer"
      347             )
      348       then do:
      349         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      350       end.
      351       if p-tt-handle = ? then do:
      352         assign
      353           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      354         .
      355         create buffer bh_tbl-name for table v-full-tbl-name .
      356       end.
      357       else do:
      358         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      359       end.
      360       assign
      361         v-inform = bh_tbl-name:index-information(1)
      362         v-ind    = 2
      363       .
      364       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      365       on error undo, return error
      366       :
      367         assign
      368           v-inform = bh_tbl-name:index-information( v-ind )
      369           v-ind    = v-ind + 1
      370         .
      371       end.
      372       if v-inform = ?
      373         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      374         or entry( 3, v-inform, ",":U ) <> "1":U
      375       then do:
      376         delete object bh_tbl-name no-error.
      377         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      378       end.
      379       assign
      380         v-idx-field-qnty = num-entries( v-inform ) - 4
      381       .
      382       if v-idx-field-qnty < 2 then do:
      383         delete object bh_tbl-name no-error.
      384         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      385       end.
      386       assign
      387         o-where     = "where":U
      388         v-word-link = "":U
      389         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      390         v-count-fld = 0
      391       .
      392       if i-tablekey ne "" and i-tablekey ne ?
      393       then do:
      394         assign
      395           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      396         .
      397         create buffer bh_tbl-key for table v-full-tbl-name .
      398       end.
      399       if i-tableSerach ne "" and i-tableSerach ne ?
      400       then do:
      401         delete object bh_tbl-name no-error.
      402         assign
      403           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      404         .
      405         create buffer bh_tbl-name for table v-full-tbl-name .
      406       end.
      407       block_where:
      408       do v-ind = 1 to v-idx-field-qnty by 2
      409       on error undo, return error
      410       :
      411         assign
      412           v-count-fld = v-count-fld + 1
      413         .
      414         if p-key-handle = ?
      415           and v-count-fld > v-field-num
      416         then do:
      417           leave block_where.
      418         end.
      419         define variable VfieldKeyTable as handle no-undo.
      420         assign
      421           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      422           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      423         .
      424         if     bh_tbl-key ne ?
      425         then do:
      426            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      427            if VfieldKeyTable eq ?
      428            then next block_where.
      429         end.
      430         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      431         then
      432            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      433         else
      434            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      435         if p-key-handle = ? then do:
      436           assign
      437             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      438           .
      439         end.
      440         else do:
      441           assign
      442             fh_key = p-key-handle:buffer-field( v-field-name )
      443           .
      444           if fh_key = ?
      445             or not valid-handle( fh_key )
      446           then do:
      447             delete object bh_tbl-name.
      448             if     bh_tbl-key ne ?
      449             then
      450                delete object bh_tbl-key.
      451             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      452           end.
      453           assign
      454             v-field-val = fh_key:buffer-value
      455           .
      456         end.
      457         if fh_search:data-type ="character":U then do:
      458           assign
      459             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      460             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      461             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      462             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      463             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      464             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      465             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      466             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      467             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      468             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      469             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      470             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      471             v-field-val = substitute( '"&1"', v-field-val )
      472           .
      473         end.
      474         assign
      475           o-where = substitute( "&1 &2", o-where, v-field-val )
      476         .
      477         if v-word-link = "":U then do:
      478           assign
      479             v-word-link = "and":U
      480           .
      481         end.
      482       end.
      483       delete object bh_tbl-name.
      484       if     bh_tbl-key ne ?
      485       then
      486          delete object bh_tbl-key.
      487       if p-key-handle = ?
      488         and v-count-fld <> v-field-num
      489       then do:
      490         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      491       end.
      492     end.
      493   end procedure.
      494   procedure gen-hn-keyr-tab :
      495     define input  parameter i-tableSerach as character no-undo.
      496     define input  parameter i-tablekey   as character no-undo.
      497     define input  parameter p-key-rec    as character no-undo.
      498     define input  parameter p-key-handle as handle    no-undo .
      499     define input  parameter p-db-name    as character no-undo .
      500     define input  parameter p-tt-handle  as handle    no-undo .
      501     define input  parameter p-stts-lock  as integer   no-undo .
      502     define output parameter o-hn         as handle    no-undo.
      503     define variable v-full-tbl-name as character no-undo.
      504     define variable v-where         as character no-undo.
      505     define variable bh_tbl-name     as handle    no-undo.
      506     define variable vTable          as character no-undo.
      507     do
      508     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      509     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      510     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      511         run gen-where-keyr-tab(i-tableSerach,
      512                                i-tablekey,
      513                                p-key-rec,
      514                                p-key-handle,
      515                                p-db-name,
      516                                p-tt-handle,
      517                                output v-where).
      518         if i-tableSerach ne "" and i-tableSerach ne ?
      519         then do:
      520            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      521            create buffer bh_tbl-name for table v-full-tbl-name .
      522         end.
      523         else do:
      524            if p-tt-handle = ? then do:
      525               assign
      526                  vTable = entry( 1 , p-key-rec, chr(3) )
      527               .
      528               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      529               create buffer bh_tbl-name for table v-full-tbl-name .
      530            end.
      531            else do:
      532               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      533            end.
      534         end.
      535         if p-tt-handle = ? then do:
      536            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      537         end.
      538         else do:
      539            bh_tbl-name:find-first( v-where ) no-error .
      540         end.
      541         o-hn = bh_tbl-name.
      542      end.
      543   end procedure.
      544   procedure gen-hn-keyr :
      545     define input  parameter p-key-rec    as character no-undo.
      546     define input  parameter p-key-handle as handle    no-undo .
      547     define input  parameter p-db-name    as character no-undo .
      548     define input  parameter p-tt-handle  as handle    no-undo .
      549     define input  parameter p-stts-lock  as integer   no-undo .
      550     define output parameter o-hn         as handle    no-undo.
      551     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      552   end.
      553   procedure gen-row-keyr :
      554     define input  parameter p-key-rec    as character no-undo.
      555     define input  parameter p-key-handle as handle    no-undo .
      556     define input  parameter p-db-name    as character no-undo .
      557     define input  parameter p-tt-handle  as handle    no-undo .
      558     define input  parameter p-stts-lock  as integer   no-undo .
      559     define output parameter p-tbl-row    as rowid     no-undo.
      560     define output parameter p-tbl-name   as character no-undo.
      561     define variable vHn as handle no-undo.
      562       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      563       p-tbl-row = if vHn:available then vHn:rowid else ?.
      564       p-tbl-name =  vHn:table.
      565       delete object vHn no-error.
      566     if p-tbl-row = ? then do:
      567       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      568     end.
      569     else do:
      570       return.
      571     end.
      572   end procedure.
      573   procedure gen-key-fv :
      574     define input  parameter p-key-rec    as character no-undo .
      575     define output parameter p-field-list as character no-undo .
      576     define output parameter p-value-list as character no-undo.
      577     do
      578     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      579     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      580     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      581     :
      582       define variable v-full-tbl-name  as character no-undo .
      583       define variable bh_tbl-name      as handle    no-undo .
      584       define variable v-tbl-name       as character no-undo .
      585       define variable v-field-num      as integer   no-undo .
      586       define variable v-count-fld      as integer   no-undo .
      587       define variable v-inform         as character no-undo .
      588       define variable v-ind            as integer   no-undo .
      589       define variable v-idx-field-qnty as integer   no-undo .
      590       define variable v-delim-key      as character no-undo .
      591       if p-key-rec = ?
      592         or p-key-rec = "":U
      593       then do:
      594         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      595       end.
      596       assign
      597         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      598         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      599       .
      600       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      601       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      602       assign
      603         v-inform = bh_tbl-name:index-information(1)
      604         v-ind    = 2
      605       .
      606       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      607       on error undo, return error
      608       :
      609         assign
      610           v-inform = bh_tbl-name:index-information( v-ind )
      611           v-ind    = v-ind + 1
      612         .
      613       end.
      614       if v-inform = ?
      615         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      616         or entry( 3, v-inform, ",":U ) <> "1":U
      617       then do:
      618         delete object bh_tbl-name no-error.
      619         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      620       end.
      621       assign
      622         v-idx-field-qnty = num-entries( v-inform ) - 4
      623       .
      624       if v-idx-field-qnty < 2 then do:
      625         delete object bh_tbl-name no-error.
      626         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      627       end.
      628       assign
      629         p-field-list = "":U
      630         p-value-list = "":U
      631         v-delim-key  = "":U
      632         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      633         v-count-fld  = 0
      634       .
      635       block_where:
      636       do v-ind = 1 to v-idx-field-qnty by 2
      637       on error undo, return error
      638       :
      639         assign
      640           v-count-fld = v-count-fld + 1
      641         .
      642         if v-count-fld > v-field-num then do:
      643           leave block_where.
      644         end.
      645         assign
      646           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      647           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      648         .
      649         if v-ind = 1 then do:
      650           assign
      651             v-delim-key = chr(3)
      652           .
      653         end.
      654       end.
      655       delete object bh_tbl-name.
      656       if v-count-fld <> v-field-num then do:
      657         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      658       end.
      659     end.
      660   end procedure.
      661   procedure gen-key-field :
      662     define input  parameter p-table      as character no-undo .
      663     define output parameter p-field-list as character no-undo .
      664     do
      665     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      666     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      667     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      668     :
      669       define variable v-full-tbl-name  as character no-undo .
      670       define variable bh_tbl-name      as handle    no-undo .
      671       define variable v-tbl-name       as character no-undo .
      672       define variable v-field-num      as integer   no-undo .
      673       define variable v-count-fld      as integer   no-undo .
      674       define variable v-inform         as character no-undo .
      675       define variable v-ind            as integer   no-undo .
      676       define variable v-idx-field-qnty as integer   no-undo .
      677       define variable v-delim-key      as character no-undo .
      678       if p-table = ?
      679         or p-table = "":U
      680       then do:
      681         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
      682       end.
      683       assign
      684         v-tbl-name      = p-table
      685         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      686       .
      687       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      688       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
      689       assign
      690         v-inform = bh_tbl-name:index-information(1)
      691         v-ind    = 2
      692       .
      693       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      694       on error undo, return error
      695       :
      696         assign
      697           v-inform = bh_tbl-name:index-information( v-ind )
      698           v-ind    = v-ind + 1
      699         .
      700       end.
      701       if v-inform = ?
      702         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      703         or entry( 3, v-inform, ",":U ) <> "1":U
      704       then do:
      705         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      706       end.
      707       assign
      708         v-idx-field-qnty = num-entries( v-inform ) - 4
      709       .
      710       if v-idx-field-qnty < 2 then do:
      711         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      712       end.
      713       assign
      714         p-field-list = "":U
      715         v-delim-key  = "":U
      716         v-count-fld  = 0
      717       .
      718       block_where:
      719       do v-ind = 1 to v-idx-field-qnty by 2
      720       on error undo, return error
      721       :
      722         assign
      723           v-count-fld = v-count-fld + 1
      724         .
      725         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      726         if v-ind = 1 then do:
      727           assign
      728             v-delim-key = chr(3)
      729           .
      730         end.
      731       end.
      732       delete object bh_tbl-name.
      733     end.
      734   end procedure.
      735   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   define new global shared variable g#lib-nws as handle no-undo .
      737   procedure disproph_write-dis-card-property-proc  :
      738   define parameter buffer buf_dis-card-property for ub.dis-card-property .
      739   define parameter buffer buf_dis-card for ub.dis-card.
      740   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
      741   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
      742   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
      743   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
      744   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
      745   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
      746   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
      747   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
      748   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
      749   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
      750   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
      751   define input parameter p-action      as integer no-undo .
      752   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      753   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      754   define input-output parameter p-chip-num as integer no-undo .
      755   define input-output parameter p-corr-date as date no-undo .
      756   define input-output parameter p-corr-time as integer no-undo .
      757   define variable v-date as date      no-undo.
      758   define variable v-time  as integer   no-undo.
      759   define variable v-uniq-key-rec as character no-undo .
      760   define variable v-send as integer no-undo .
      761   define buffer buf_c-dc-hist for ub.c-dc-hist.
      762   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      763     main-block:
      764     do
      765     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      766     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      767     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      768     :
      769       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
      770         message
      771           vss-workfile vss-revision vss-description skip
      772           "Ошибка задания входных параметров" skip
      773           "Не определена запись СВОЙСТВА ДК" skip
      774           view-as alert-box error .
      775         undo, return error .
      776       end.
      777     v-send = integer('0':U).
      778     if not p-action = integer('1':U) then do:
      779       if available buf_dis-card then do:
      780         if g#news then do:
      781   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      783     (input  g#db-num
      784     ,input  'dis-card-property':U
      785     ,input  0
      786     ,input  '':U
      787     ,input  0
      788     ,input  buf_dis-card.type
      789     ,input  '':U
      790     ,input  '':U
      791     ,input  buf_dis-card.emitent-host-code
      792     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      793     ,input  0
      794     ,input  'nws-to-hist'
      795     ,output v-send
      796     ) no-error .
      797         end.
      798         else do:
      799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      801     (input  g#db-num
      802     ,input  'dis-card-property':U
      803     ,input  0
      804     ,input  '':U
      805     ,input  0
      806     ,input  buf_dis-card.type
      807     ,input  '':U
      808     ,input  '':U
      809     ,input  buf_dis-card.emitent-host-code
      810     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
      811     ,input  0
      812     ,input  'hist-from-prim'
      813     ,output v-send
      814     ) no-error .
      815         end.
      816       end.
      817     end.
      818     if v-send >= 0 then do:
      819       run cur-time in this-procedure(output v-date, output v-time).
      820       if p-action = integer('1':U) then do:
      821         create buf_c-dis-card-property.
      822         assign
      823         buf_c-dis-card-property.d-card            = p-d-card
      824         buf_c-dis-card-property.card-num          = p-card-num
      825         buf_c-dis-card-property.host-code         = p-host-code
      826         buf_c-dis-card-property.obj-type          = p-obj-type
      827         buf_c-dis-card-property.obj-code          = p-obj-code
      828         buf_c-dis-card-property.dt-code           = p-dt-code
      829         buf_c-dis-card-property.node-code         = p-node-code
      830         buf_c-dis-card-property.dtm-code         = p-dtm-code
      831         buf_c-dis-card-property.main-card         = p-main-card
      832         buf_c-dis-card-property.first-main-card   = p-first-main-card
      833         buf_c-dis-card-property.first-card        = p-first-card
      834         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
      835                                                      then next-value (s-dc-chip, ub)
      836                                                      else p-chip-num)
      837         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
      838                                                      then v-time
      839                                                      else p-corr-time)
      840         buf_c-dis-card-property.corr-user-db-num  = g#db-num
      841         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
      842         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
      843                                                      then v-date
      844                                                      else p-corr-date)
      845         .
      846       end.
      847       else do:
      848         create buf_c-dis-card-property.
      849         buffer-copy buf_dis-card-property to buf_c-dis-card-property
      850         assign
      851         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
      852         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
      853         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
      854         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
      855         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
      856         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
      857         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
      858         buf_c-dis-card-property.obj-type          = p-obj-type
      859         buf_c-dis-card-property.obj-code          = p-obj-code
      860         buf_c-dis-card-property.node-code         = p-node-code
      861         buf_c-dis-card-property.dtm-code         = p-dtm-code
      862         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
      863                                                       then next-value (s-dc-chip, ub)
      864                                                       else p-chip-num)
      865         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
      866                                                       then v-time
      867                                                       else p-corr-time)
      868         buf_c-dis-card-property.corr-user-db-num   = g#db-num
      869               buf_c-dis-card-property.corr-user-name    = (if g#news
      870                                                      then (chr(4) +  'СПН':U)
      871                                                      else (if g#esys
      872                                                            then (chr(4) +  'ВС':U)
      873                                                            else g#userid
      874                                                            )
      875                                                      )
      876         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
      877                                                       then v-date
      878                                                       else p-corr-date)
      879         .
      880         run gen-key-rec in this-procedure (
      881                                             input 'dis-card-property':U
      882                                           ,input buffer buf_dis-card-property:handle
      883                                           ,output v-uniq-key-rec).
      884       end.
      885       if p-chip-num = 0   then do:
      886         create buf_c-dc-hist.
      887         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
      888         assign
      889         buf_c-dc-hist.action =  p-action
      890         buf_c-dc-hist.subject = 'dis-card-property':U
      891         buf_c-dc-hist.is-news = g#news
      892         buf_c-dc-hist.source-type = p-source-type
      893         buf_c-dc-hist.source-ref = p-source-ref
      894         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
      895         .
      896       end.
      897       assign
      898       p-chip-num = buf_c-dis-card-property.chip-num
      899       p-corr-date = buf_c-dis-card-property.corr-date
      900       p-corr-time = buf_c-dis-card-property.corr-time
      901       .
      902       run disproph_send-nws in this-procedure (
      903                                                 buffer buf_c-dis-card-property
      904                                                ,buffer buf_c-dc-hist
      905                                                ,buffer buf_dis-card
      906                                                 ).
      907       end.
      908     end.
      909   end procedure.
      910   procedure disproph_send-nws :
      911   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
      912   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
      913   define parameter buffer buf_Dis-card for ub.dis-card.
      914   define variable v-dh-hn as integer no-undo .
      915   main-block:
      916   do
      917   on error undo, return error return-value
      918   :
      919     if g#news
      920     and g#db-num > 0
      921     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
      922     then return.
      923     if g#db-num = 0
      924     or (g#news
      925         and g#db-num > 0
      926         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
      927         )
      928     then do:
      929       if not available buf_dis-card then do:
      930         find first buf_dis-card no-lock where
      931                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
      932       end.
      933       if not available buf_dis-card then do:
      934         assign
      935         v-dh-hn = integer('0':U).
      936       end.
      937       else do:
      938   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      940     (input  g#db-num
      941     ,input  'dis-card-property':U
      942     ,input  0
      943     ,input  '':U
      944     ,input  0
      945     ,input  buf_dis-card.type
      946     ,input  '':U
      947     ,input  '':U
      948     ,input  buf_dis-card.emitent-host-code
      949     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
      950     ,input  0
      951     ,input  'hist-to-nws'
      952     ,output v-dh-hn
      953     ) no-error .
      954       end.
      955       if v-dh-hn >= 0 then do:
      956         run str/callnews.p (
      957           input 'c-dis-card-property':U
      958           ,input (buffer buf_c-dis-card-property:handle)
      959           ) no-error .
      960         if error-status:error then do:
      961           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      962         end.
      963         if available buf_c-dc-hist then do:
      964           run str/callnews.p (
      965             input 'c-dc-hist':U
      966             ,input (buffer buf_c-dc-hist:handle)
      967             ) no-error .
      968           if error-status:error then do:
      969             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      970           end.
      971         end.
      972       end.
      973     end.
      974   end.
      975   end procedure.
      976   procedure discprop-node-code :
      977   define input parameter p-dtm-code as integer no-undo .
      978   define input parameter p-node-code as integer no-undo .
      979   define output parameter p-data-type as character no-undo .
      980   define output parameter p-format as character no-undo .
      981   define output parameter p-label as character no-undo .
      982   define output parameter p-range as integer no-undo .
      983   define output parameter p-rw-option as character no-undo .
      984   define buffer buf_prop-map for ub.prop-map.
      985   define buffer buf_prop-head for ub.prop-head.
      986   do
      987   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      988   :
      989   find first buf_prop-head no-lock where
      990             buf_prop-head.dtm-code = p-dtm-code no-error .
      991   if available buf_prop-head then do:
      992     if p-node-code > 0 then do:
      993       find first buf_prop-map no-lock where
      994                 buf_prop-map.dtm-code = p-dtm-code
      995             and buf_prop-map.node-code = p-node-code no-error .
      996       if available buf_prop-map then do:
      997         assign
      998         p-data-type = buf_prop-map.node-value-type
      999         p-format = buf_prop-map.node-format
     1000         p-label = buf_prop-map.node-label
     1001         p-rw-option = buf_prop-map.rw-option
     1002         .
     1003       end.
     1004     end.
     1005     if buf_prop-head.storage-place  = "":U
     1006     and buf_prop-head.storage-place-host  > "":U
     1007     and buf_prop-head.storage-place-obj  > "":U then do:
     1008       p-range =  12.
     1009     end.
     1010     if buf_prop-head.storage-place  > "":U
     1011     and buf_prop-head.storage-place-host  > "":U
     1012     and buf_prop-head.storage-place-obj  > "":U then do:
     1013       p-range =  3.
     1014     end.
     1015     if buf_prop-head.storage-place  > "":U
     1016     and buf_prop-head.storage-place-host  > "":U
     1017     and buf_prop-head.storage-place-obj  = "":U then do:
     1018       p-range =  2.
     1019     end.
     1020     if buf_prop-head.storage-place  = "":U
     1021     and buf_prop-head.storage-place-host  > "":U
     1022     and buf_prop-head.storage-place-obj  = "":U then do:
     1023       p-range =  1.
     1024     end.
     1025     if buf_prop-head.storage-place  > "":U
     1026     and buf_prop-head.storage-place-host  = "":U
     1027     and buf_prop-head.storage-place-obj  = "":U then do:
     1028       p-range =  0.
     1029     end.
     1030   end.
     1031   end.
     1032   end procedure.
     1033   procedure discprop-initial:
     1034   define input parameter p-dtm-code as integer no-undo .
     1035   define input parameter p-node-code as integer no-undo .
     1036   define output parameter p-init-value-character as character no-undo .
     1037   define output parameter p-init-value-date as date no-undo .
     1038   define output parameter p-init-value-decimal as decimal no-undo .
     1039   define output parameter p-init-value-integer as integer no-undo .
     1040   define output parameter p-init-value-logical as logical no-undo .
     1041   define buffer buf_prop-map for ub.prop-map.
     1042   find first buf_prop-map no-lock where
     1043             buf_prop-map.dtm-code = p-dtm-code
     1044         and buf_prop-map.node-code = p-node-code no-error.
     1045   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1046                                                               , p-node-code
     1047                                                               , p-dtm-code).
     1048   assign
     1049   p-init-value-character = buf_prop-map.init-value-character
     1050   p-init-value-date = buf_prop-map.init-value-date
     1051   p-init-value-decimal = buf_prop-map.init-value-decimal
     1052   p-init-value-integer = buf_prop-map.init-value-integer
     1053   p-init-value-logical = buf_prop-map.init-value-logical
     1054   .
     1055   end procedure.
     1056   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1057   define buffer buf_attr-prop for ub.attr-prop.
     1058   find first buf_attr-prop no-lock where
     1059             buf_attr-prop.table-name = 'dis-card-property':U
     1060         and buf_attr-prop.templ-rl-root = p-dtm-code
     1061         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1062         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1063   if not available buf_attr-prop
     1064   or logical(buf_attr-prop.property-value) = no then do:
     1065     return no.
     1066   end.
     1067   return yes.
     1068   end function.
     1069   procedure discprop-edit :
     1070   define input parameter p-dtm-code-node-name as character no-undo .
     1071   define output parameter p-edit-menu-section-num as integer no-undo .
     1072   define buffer buf_attr-prop for ub.attr-prop.
     1073   do
     1074   on error undo, return error return-value
     1075   :
     1076     find first buf_attr-prop no-lock where
     1077             buf_attr-prop.table-name = 'dis-card-property':U
     1078        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1079        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1080        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1081     if available buf_attr-prop then do:
     1082       assign
     1083       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1084     end.
     1085   end.
     1086   end procedure.
     1087   procedure discprop-node-name :
     1088   define input parameter p-dtm-code-node-name as character no-undo .
     1089   define output parameter p-tool-tip as character no-undo .
     1090   define output parameter p-node-label as character no-undo .
     1091   define buffer buf_prop-map for ub.prop-map.
     1092   define buffer buf_prop-head for ub.prop-head.
     1093   do
     1094   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1095   :
     1096     find first buf_prop-head no-lock where
     1097               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1098     assign
     1099     p-tool-tip   = if available buf_prop-head
     1100                    then buf_prop-head.prop-des
     1101                    else entry(1, p-dtm-code-node-name, chr(4) )
     1102     p-node-label = (if available buf_prop-head
     1103                     then buf_prop-head.prop-label
     1104                     else '':U)
     1105     .
     1106     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1107       find first buf_prop-map no-lock where
     1108                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1109           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1110       if available buf_prop-map then do:
     1111         assign
     1112         p-tool-tip   = buf_prop-map.node-description
     1113         p-node-label = (if available buf_prop-head
     1114                         then buf_prop-head.prop-label
     1115                         else '':U) + ":" + buf_prop-map.node-label
     1116         .
     1117       end.
     1118     end.
     1119   end.
     1120   end procedure.
     1121   procedure discprop-write :
     1122   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1123   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1124   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1125   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1126   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1127   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1128   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1129   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1130   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1131   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1132   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1133   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1134   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1135   define input parameter p-source-type     as character no-undo .
     1136   define input parameter p-source-ref      as character no-undo .
     1137   define input-output parameter p-chip-num as integer no-undo .
     1138   define input-output parameter p-corr-date as date no-undo .
     1139   define input-output parameter p-corr-time as integer no-undo .
     1140   do
     1141   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1142   :
     1143     define buffer buf_dis-card-property for ub.dis-card-property .
     1144     define buffer buf_dis-card for ub.dis-card.
     1145     define buffer buf_prop-ref for ub.prop-ref.
     1146     define variable v-data-type      as character no-undo .
     1147     define variable v-data-type-1    as character no-undo .
     1148     define variable v-format         as character no-undo .
     1149     define variable v-label          as character no-undo .
     1150     define variable v-range          as integer   no-undo .
     1151     define variable v-rw-option      as character no-undo .
     1152     run discprop-node-code in this-procedure
     1153       (
     1154        input  p-dtm-code
     1155       ,input  p-node-code
     1156       ,output v-data-type
     1157       ,output v-format
     1158       ,output v-label
     1159       ,output v-range
     1160       ,output v-rw-option
     1161       ) no-error .
     1162     if error-status :error then do:
     1163       undo, return error return-value .
     1164     end.
     1165     v-data-type-1 = entry(1, v-data-type).
     1166     if p-dt-code = ? then do:
     1167       find buf_prop-ref no-lock where
     1168           buf_prop-ref.dtm-code = p-dtm-code
     1169       and buf_prop-ref.sum-id = p-sum-id no-error.
     1170       if not available buf_prop-ref then do:
     1171         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1172                                       ,p-dtm-code
     1173                                       ,p-sum-id).
     1174       end.
     1175       assign
     1176       p-dt-code = buf_prop-ref.dt-code.
     1177     end.
     1178     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1179       undo, return error "Нельзя редактировать свойство в данной БД".
     1180     end.
     1181     run discprop-check in this-procedure (
     1182                                             input v-range
     1183                                           ,input p-d-card
     1184                                           ,input p-host-code
     1185                                           ,input p-obj-type
     1186                                           ,input p-obj-code
     1187                                           ,input p-dtm-code
     1188                                           ,input p-node-code
     1189                                           ,input p-dt-code
     1190                                         ) no-error .
     1191     if error-status:error then undo,  return error return-value .
     1192     find first buf_dis-card-property exclusive-lock
     1193       where buf_dis-card-property.d-card    = p-d-card
     1194         and buf_dis-card-property.host-code = p-host-code
     1195         and buf_dis-card-property.obj-type  = p-obj-type
     1196         and buf_dis-card-property.obj-code  = p-obj-code
     1197         and buf_dis-card-property.dt-code = p-dt-code
     1198         and buf_dis-card-property.node-code = p-node-code
     1199       no-error .
     1200       find first buf_dis-card no-lock where
     1201                   buf_dis-card.d-card = p-d-card.
     1202     if not available buf_dis-card-property then do:
     1203       create buf_dis-card-property .
     1204       assign
     1205         buf_dis-card-property.d-card    = p-d-card
     1206         buf_dis-card-property.host-code = p-host-code
     1207         buf_dis-card-property.obj-type  = p-obj-type
     1208         buf_dis-card-property.obj-code  = p-obj-code
     1209         buf_dis-card-property.dt-code = p-dt-code
     1210         buf_dis-card-property.node-code = p-node-code
     1211         buf_dis-card-property.dtm-code = p-dtm-code
     1212         buf_dis-card-property.sum-id   = p-sum-id
     1213         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1214         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1215         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1216         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1217       .
     1218     end.
     1219     else do:
     1220       if (v-data-type-1 = 'character':U
     1221       and buf_dis-card-property.property-value-character = p-value-character)
     1222       or  (v-data-type-1 = 'date':U
     1223           and buf_dis-card-property.property-value-date = p-value-date)
     1224       or  (v-data-type-1 = 'decimal':U
     1225           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1226       or  (v-data-type-1 = 'integer':U
     1227           and buf_dis-card-property.property-value-integer = p-value-integer)
     1228       or  (v-data-type-1 = 'logical':U
     1229           and buf_dis-card-property.property-value-logical = p-value-logical)
     1230       then return.
     1231     end.
     1232     run disproph_write-dis-card-property-proc  in this-procedure (
     1233             buffer buf_dis-card-property
     1234             ,buffer Buf_dis-card
     1235             ,input p-d-card
     1236             ,input p-dt-code
     1237             ,input p-host-code
     1238             ,input p-obj-type
     1239             ,input p-obj-code
     1240             ,input p-dtm-code
     1241             ,input buf_dis-card.card-num
     1242             ,input buf_dis-card.main-card
     1243             ,input buf_dis-card.first-card
     1244             ,input buf_dis-card.first-main-card
     1245             ,input p-node-code
     1246             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1247             ,input p-source-type
     1248             ,input p-source-ref
     1249             ,input-output p-chip-num
     1250             ,input-output p-corr-date
     1251             ,input-output p-corr-time
     1252             ).
     1253     assign
     1254     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1255                                                       then p-value-character
     1256                                                       else buf_dis-card-property.property-value-character)
     1257     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1258                                                       then p-value-date
     1259                                                       else buf_dis-card-property.property-value-date)
     1260     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1261                                                       then p-value-decimal
     1262                                                       else buf_dis-card-property.property-value-decimal)
     1263     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1264                                                       then p-value-integer
     1265                                                       else buf_dis-card-property.property-value-integer)
     1266     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1267                                                       then p-value-logical
     1268                                                       else buf_dis-card-property.property-value-logical)
     1269     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1270     .
     1271     release buf_dis-card-property no-error .
     1272     if error-status:error then do:
     1273       return error return-value .
     1274     end.
     1275   end.
     1276   end procedure.
     1277   procedure discprop-delete :
     1278   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1279   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1280   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1281   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1282   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1283   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1284   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1285   define input parameter p-source-type as character no-undo .
     1286   define input parameter p-source-ref as character no-undo .
     1287   define output parameter p-deleted  as logical no-undo.
     1288   define input-output parameter p-chip-num as integer no-undo .
     1289   define input-output parameter p-corr-date as date no-undo .
     1290   define input-output parameter p-corr-time as integer no-undo .
     1291   do
     1292   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1293   :
     1294   define buffer buf_dis-card-property for ub.dis-card-property .
     1295   define buffer buf_dis-card for ub.dis-card.
     1296   define variable v-data-type      as character no-undo .
     1297   define variable v-format         as character no-undo .
     1298   define variable v-label          as character no-undo .
     1299   define variable v-range          as integer   no-undo .
     1300   define variable v-rw-option      as character   no-undo .
     1301     run discprop-node-code in this-procedure
     1302       (input  p-dtm-code
     1303       ,input  p-node-code
     1304       ,output v-data-type
     1305       ,output v-format
     1306       ,output v-label
     1307       ,output v-range
     1308       ,output v-rw-option
     1309       ) no-error .
     1310     if error-status :error then do:
     1311       undo, return error return-value .
     1312     end.
     1313     find first buf_dis-card-property exclusive-lock
     1314       where buf_dis-card-property.d-card    = p-d-card
     1315         and buf_dis-card-property.host-code = p-host-code
     1316         and buf_dis-card-property.obj-type  = p-obj-type
     1317         and buf_dis-card-property.obj-code  = p-obj-code
     1318         and buf_dis-card-property.dt-code = p-dt-code
     1319         and buf_dis-card-property.node-code = p-node-code
     1320       no-error NO-WAIT.
     1321     if not available buf_dis-card-property then do:
     1322       p-deleted = no.
     1323     end.
     1324     else do:
     1325       run disproph_write-dis-card-property-proc  in this-procedure (
     1326            buffer buf_dis-card-property
     1327           ,buffer buf_dis-card
     1328           ,input buf_dis-card-property.d-card
     1329           ,input buf_dis-card-property.dt-code
     1330           ,input buf_dis-card-property.host-code
     1331           ,input buf_dis-card-property.obj-type
     1332           ,input buf_dis-card-property.obj-code
     1333           ,input buf_dis-card-property.dtm-code
     1334           ,input buf_dis-card-property.card-num
     1335           ,input buf_dis-card-property.main-card
     1336           ,input buf_dis-card-property.first-card
     1337           ,input buf_dis-card-property.first-main-card
     1338           ,input buf_dis-card-property.node-code
     1339           ,input integer('99':U)
     1340           ,input p-source-type
     1341           ,input p-source-ref
     1342           ,input-output p-chip-num
     1343           ,input-output p-corr-date
     1344           ,input-output p-corr-time
     1345            ).
     1346       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1347       delete buf_dis-card-property no-error .
     1348       if error-status:error then do:
     1349         return error return-value.
     1350       end.
     1351       p-deleted = yes.
     1352     end.
     1353   end.
     1354   end procedure.
     1355   procedure discprop-check :
     1356   define input parameter p-range  as integer no-undo .
     1357   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1358   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1359   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1360   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1361   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1362   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1363   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1364   define variable v-message as character no-undo .
     1365   define buffer buf_sysconf for ub.sysconf.
     1366   define buffer buf_clients for ub.clients.
     1367   define buffer buf_dis-card for ub.dis-card.
     1368   define buffer buf_attr-prop for ub.attr-prop.
     1369   do
     1370   on error undo, return error return-value
     1371   :
     1372     if p-host-code > 0 then do:
     1373       FIND FIRST buf_sysconf No-LOCK WHERE
     1374                 buf_sysconf.host-code = p-host-code No-ERROR.
     1375       IF NOT AVAIL buf_sysconf THEN DO:
     1376         v-message = substitute("Не найдена фирма &1", p-host-code).
     1377         RETURN ERROR v-message.
     1378       END.
     1379     end.
     1380     if p-obj-type <> "":U or
     1381         p-obj-code <> 0 then do:
     1382       find first buf_clients No-LOCK WHERE
     1383                 buf_clients.obj-type = p-obj-type AND
     1384                 buf_clients.obj-code = p-obj-code no-error .
     1385       if not available buf_clients then do:
     1386         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1387         RETURN ERROR v-message.
     1388       end.
     1389     end.
     1390     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1391       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1392                               , p-obj-type
     1393                               , p-obj-code
     1394                               , p-host-code).
     1395       RETURN ERROR v-message.
     1396     end.
     1397     if p-d-card <> "":U then do:
     1398       find first buf_dis-card No-LOCK WHERE
     1399                   buf_dis-card.d-card = p-d-card No-ERROR.
     1400       if not avail buf_dis-card then do:
     1401         v-message =substitute("Не найдена ДК").
     1402         return error  v-message.
     1403       end.
     1404       if buf_dis-card.emitent-host-code <> 0
     1405       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1406         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1407         return error v-message.
     1408       end.
     1409       if buf_dis-card.emitent-host-code = 0
     1410       and p-range = 1
     1411       and p-host-code <> 0 then do:
     1412         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1413                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1414                                 , chr(10)
     1415                               ).
     1416         return error v-message.
     1417       end.
     1418     end.
     1419   end.
     1420   end procedure.
     1421   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   define variable dcard-algo-field-name as character no-undo extent 3 init [
     1423    'd-pcnt':U
     1424   ,'cash-d-pcnt':U
     1425   ,'pcnt-kat':U].
     1426   define variable algo-field-abbr as character no-undo extent 3 init [
     1427    'ITEM%':U
     1428   ,'TOTAL%':U
     1429   ,'CATEG':U].
     1430   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     1431   define variable v-date-str as character no-undo .
     1432   assign
     1433   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     1434                string(Month(p-date), "99":U) + chr(47) +
     1435                string(DAY(p-date), "99":U).
     1436   return v-date-str.
     1437   END FUNCTION.
     1438   function dct-algo-string-to-date returns date ( input p-string  as character):
     1439     define variable v-date as date no-undo .
     1440     assign
     1441     v-date = date(integer(substring(p-string, 6, 2))
     1442                   ,integer(substring(p-string, 9, 2))
     1443                   ,integer(substring(p-string, 1, 4))
     1444                  ) no-error .
     1445     if error-status:error then return ?.
     1446     return v-date.
     1447   END FUNCTION.
     1448   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     1449   define buffer buf_prop-ref for ub.prop-ref.
     1450   find first buf_prop-ref no-lock where
     1451             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     1452   if not available buf_prop-ref then do:
     1453     return chr(63).
     1454   end.
     1455   return buf_prop-ref.sum-id.
     1456   END FUNCTION.
     1457   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     1458   define variable v-des as character no-undo .
     1459   define buffer buf_prop-ref for ub.prop-ref.
     1460   define buffer buf_prop-head for ub.prop-head.
     1461   find first buf_prop-ref no-lock where
     1462             buf_prop-ref.dt-code = p-dt-code no-error.
     1463   if not available buf_prop-ref then do:
     1464     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1465   end.
     1466   find first buf_prop-head no-lock where
     1467           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     1468   if not available buf_prop-head then do:
     1469     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     1470   end.
     1471   assign
     1472   v-des = substitute("&1  &2 &3"
     1473                     , buf_prop-head.prop-name
     1474                     , buf_prop-ref.sum-id
     1475                     , buf_prop-ref.caller_id).
     1476   return v-des.
     1477   end FUNCTION.
     1478   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     1479                                                               ,input p-dt-code as integer
     1480                                                               ,input p-node-code as integer
     1481                                                               ):
     1482   define variable v-des as character no-undo .
     1483   define buffer buf_prop-ref for ub.prop-ref.
     1484   define buffer buf_prop-head for ub.prop-head.
     1485   define buffer buf_prop-map for ub.prop-map.
     1486   find first buf_prop-ref no-lock where
     1487             buf_prop-ref.dt-code = p-dt-code no-error.
     1488   if not available buf_prop-ref then do:
     1489     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     1490   end.
     1491   find first buf_prop-head no-lock where
     1492           buf_prop-head.dtm-code = p-dtm-code no-error.
     1493   if not available buf_prop-head then do:
     1494     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     1495   end.
     1496   find first buf_prop-map no-lock where
     1497           buf_prop-map.dtm-code = p-dtm-code
     1498       and buf_prop-map.node-code = p-node-code no-error .
     1499   if not available buf_prop-map then do:
     1500     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     1501                       , p-dt-code
     1502                       , buf_prop-head.prop-label
     1503                       , p-node-code).
     1504   end.
     1505   assign
     1506   v-des = substitute("&1.&2 &3 &4"
     1507                     , buf_prop-head.prop-label
     1508                     , buf_prop-map.node-label
     1509                     , buf_prop-ref.sum-id
     1510                     , buf_prop-ref.caller_id).
     1511   return v-des.
     1512   end FUNCTION.
     1513   function dct-algo-get-prev-sum-id RETURNS integer (
     1514                                                       input p-dt-code as integer
     1515                                                      ):
     1516   define variable v-dtm-code as integer no-undo .
     1517   define variable v-sum-id as character no-undo .
     1518   define variable v-caller-id as character no-undo .
     1519   define buffer buf_prop-ref for ub.prop-ref.
     1520   find first buf_prop-ref no-lock where
     1521           buf_prop-ref.dt-code = p-dt-code no-error.
     1522   if not available buf_prop-ref then return ?.
     1523   assign
     1524   v-dtm-code = buf_prop-ref.dtm-code
     1525   v-sum-id = buf_prop-ref.sum-id.
     1526   v-caller-id = buf_prop-ref.caller_id.
     1527   find last buf_prop-ref no-lock where
     1528             buf_prop-ref.dtm-code = v-dtm-code
     1529        and  buf_prop-ref.sum-id < v-sum-id
     1530        and  buf_prop-ref.caller_id = v-caller-id
     1531        no-error.
     1532   if available buf_prop-ref then return buf_prop-ref.dt-code.
     1533   return -1 .
     1534   END FUNCTION.
     1535   FUNCTION dct-algo-get_dcproperty-value returns logical (
     1536                                                             input p-prop-name as character
     1537                                                           , input p-d-card    as character
     1538                                                           , input p-host-code as integer
     1539                                                           , input p-obj-type  as character
     1540                                                           , input p-obj-code  as integer
     1541                                                           , output p-value-character as character
     1542                                                           , output p-value-date   as date
     1543                                                           , output p-value-integer as integer
     1544                                                           , output p-value-decimal as decimal
     1545                                                           , output p-value-logical as logical):
     1546     return no.
     1547   END FUNCTION.
     1548   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     1549                                                             input p-d-card    as character
     1550                                                           , input p-emitent-host-code as integer
     1551                                                           , input p-type as character
     1552                                                           , input p-host-code as integer
     1553                                                           , input p-obj-type  as character
     1554                                                           , input p-obj-code  as integer
     1555                                                           , output p-value-chr as character):
     1556   define variable v-dt-code as integer no-undo .
     1557   define variable v-node-code as integer no-undo .
     1558   define variable v-field-name as character no-undo .
     1559   define variable v-storage-place as character no-undo .
     1560   define variable v-sum-id-value as character no-undo .
     1561   define variable v-sum-id-output as logical no-undo .
     1562   define variable v-value-chr as character no-undo .
     1563   define variable v-ii as integer no-undo .
     1564   define buffer buf_dis-card-property for ub.dis-card-property.
     1565   define buffer buf_dis-host for ub.dis-host.
     1566   define buffer buf_dis-obj for ub.dis-obj.
     1567   run get-cd-sumid in this-procedure (
     1568                                         input p-emitent-host-code
     1569                                        ,input p-type
     1570                                        ,input p-host-code
     1571                                        ,input p-obj-type
     1572                                        ,input p-obj-code
     1573                                        ,output v-sum-id-value
     1574                                        ,output v-sum-id-output
     1575                                       ) no-error.
     1576   if not v-sum-id-output then do:
     1577     return no.
     1578   end.
     1579   do v-ii = 1 to num-entries(v-sum-id-value):
     1580     assign
     1581     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     1582     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     1583     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     1584     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     1585     no-error .
     1586     if not error-status:error then do:
     1587       case v-storage-place:
     1588         when 'dis-card-property':U then do:
     1589           find first buf_dis-card-property no-lock where
     1590                     buf_dis-card-property.d-card = p-d-card
     1591               and  buf_dis-card-property.host-code = p-host-code
     1592               and  buf_dis-card-property.obj-type = p-obj-type
     1593               and  buf_dis-card-property.obj-code = p-obj-code
     1594               and  buf_dis-card-property.dt-code = v-dt-code
     1595               and  buf_dis-card-property.node-code = v-node-code no-error .
     1596           if available buf_dis-card-property then do:
     1597             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     1598           end.
     1599           else do:
     1600             v-value-chr = chr(63).
     1601           end.
     1602         end.
     1603         when 'dis-obj':U then do:
     1604           find first buf_dis-obj no-lock where
     1605                     buf_dis-obj.d-card = p-d-card
     1606               and  buf_dis-obj.obj-type = p-obj-type
     1607               and  buf_dis-obj.obj-code = p-obj-code
     1608               and  buf_dis-obj.dt-code = v-dt-code no-error .
     1609           if available buf_dis-obj then do:
     1610             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     1611           end.
     1612           else do:
     1613             v-value-chr = chr(63).
     1614           end.
     1615         end.
     1616         when 'dis-host':U then do:
     1617           find first buf_dis-host no-lock where
     1618                     buf_dis-host.d-card = p-d-card
     1619               and  buf_dis-host.host-code = p-host-code
     1620               and  buf_dis-host.dt-code = v-dt-code no-error .
     1621           if available buf_dis-host then do:
     1622             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     1623           end.
     1624           else do:
     1625             v-value-chr = chr(63).
     1626           end.
     1627         end.
     1628       end.
     1629     end.
     1630     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     1631   end.
     1632   END FUNCTION.
     1633   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     1634     ( INPUT p-custom-sent as character ) :
     1635   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1636   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1637   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1638   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1639   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1640   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     1641   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1642   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     1643   assign
     1644   v-storage-place = entry(1, p-custom-sent, chr(4))
     1645   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     1646   v-sum-id   = entry(3, p-custom-sent, chr(4))
     1647   v-caller-id = entry(4, p-custom-sent, chr(4))
     1648   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     1649   no-error .
     1650   IF ERROR-STATUS:ERROR THEN DO:
     1651     MESSAGE
     1652     "Не могу разобрать строку, описывающую итог"
     1653      VIEW-AS ALERT-BOX WARNING.
     1654     RETURN chr(63).
     1655   END.
     1656   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1657             buf_prop-ref.dtm-code = v-dtm-code
     1658        AND  buf_prop-ref.sum-id = v-sum-id
     1659        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1660   IF NOT AVAILABLE buf_prop-ref THEN DO:
     1661     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1662               buf_prop-ref.dtm-code = v-dtm-code
     1663         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1664     IF NOT AVAILABLE buf_prop-ref THEN DO:
     1665         MESSAGE
     1666         "Не могу разобрать строку, описывающую итог"
     1667          VIEW-AS ALERT-BOX WARNING.
     1668         RETURN chr(63).
     1669      end.
     1670   end.
     1671   ASSIGN
     1672   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     1673                                                          ,buf_prop-ref.dt-code
     1674                                                          ,v-node-code).
     1675   RETURN v-sum-id-description.
     1676   END FUNCTION.
     1677   define variable vss-include-info12 as character format "X(65)" no-undo
     1678   initial "@(#)$Workfile$ $Revision$".
     1679   define variable v-bgelib-bgefmt        as character         no-undo.
     1680   define variable v-bgelib-bgeflold      as character         no-undo.
     1681   define stream stmXMLOut.
     1682   define stream stmXMLLog.
     1683   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   procedure cur-time :
     1685      define output parameter p-today as date      no-undo .
     1686      define output parameter p-time  as integer   no-undo .
     1687     do
     1688     on error undo, return error
     1689     :
     1690       define variable v-date1 as date      no-undo .
     1691       define variable v-date2 as date      no-undo .
     1692       define variable v-time  as integer   no-undo .
     1693       assign
     1694         v-date1 = today
     1695         v-time  = time
     1696         v-date2 = today
     1697       .
     1698       if v-date1 <> v-date2
     1699       then do:
     1700         assign
     1701           v-date1 = today
     1702           v-time  = v-time
     1703         .
     1704       end.
     1705       assign
     1706         p-today = v-date1
     1707         p-time  = v-time
     1708       .
     1709     end.
     1710   end.
     1711   function cur-time-date returns character
     1712   :
     1713     return string(today, '99/99/9999':U) .
     1714   end.
     1715   function cur-time-mjd returns decimal
     1716   :
     1717     define variable v-date as date      no-undo .
     1718     define variable v-time as integer   no-undo .
     1719     run cur-time in this-procedure
     1720       (output v-date
     1721       ,output v-time
     1722       ) .
     1723     return integer(v-date) - 2400002 + (v-time / 86400) .
     1724   end.
     1725   function cur-time-get-ending-index returns integer
     1726   (input p-number as integer
     1727   )
     1728   :
     1729     if p-number < 0
     1730     or p-number = ?
     1731     then do:
     1732       return 1 .
     1733     end.
     1734     define variable v-rest as integer   no-undo .
     1735     assign
     1736       p-number = p-number modulo 100
     1737     .
     1738     if p-number < 20
     1739     then do:
     1740       assign
     1741         v-rest = p-number
     1742       .
     1743     end.
     1744     else do:
     1745       assign
     1746         v-rest = p-number modulo 10
     1747       .
     1748     end.
     1749     case v-rest :
     1750       when 1
     1751       then do:
     1752         return 2 .
     1753       end.
     1754       when 2 or
     1755       when 3 or
     1756       when 4
     1757       then do:
     1758         return 3 .
     1759       end.
     1760       otherwise do:
     1761         return 1 .
     1762       end.
     1763     end case .
     1764   end.
     1765   procedure cur-time-mjd-to-date :
     1766      define input  parameter i-mjd-diff as decimal no-undo.
     1767      define output parameter o-Date     as date    no-undo.
     1768      define output parameter o-Time     as integer no-undo.
     1769      define variable v-day-number as integer   no-undo .
     1770      if    i-mjd-diff < 0
     1771         or i-mjd-diff = ?
     1772      then do:
     1773         return "?" .
     1774      end.
     1775      assign
     1776         v-day-number = truncate(i-mjd-diff,0).
     1777         o-Date = date(v-day-number + 2400002).
     1778         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1779     .
     1780   end.
     1781   function cur-time-mjd-to-string returns character
     1782   (input p-mjd-diff as decimal
     1783   )
     1784   :
     1785     define variable v-day-number as integer   no-undo .
     1786     define variable v-seconds    as integer   no-undo .
     1787     define variable v-hour       as integer   no-undo .
     1788     define variable v-min        as integer   no-undo .
     1789     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1790     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1791     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1792     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1793     if p-mjd-diff < 0
     1794     or p-mjd-diff = ?
     1795     then do:
     1796       return "?" .
     1797     end.
     1798     assign
     1799       v-day-number = integer(truncate(p-mjd-diff,0))
     1800       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1801     .
     1802     if v-seconds > 86400
     1803     then do:
     1804       assign
     1805         v-seconds = 86400 - 1
     1806       .
     1807     end.
     1808     if v-seconds < 0
     1809     then do:
     1810       assign
     1811         v-seconds = 0
     1812       .
     1813     end.
     1814     assign
     1815       v-hour = truncate(v-seconds / 3600, 0)
     1816     .
     1817     assign
     1818       v-seconds = v-seconds modulo 3600
     1819     .
     1820     assign
     1821       v-min = truncate(v-seconds / 60, 0)
     1822     .
     1823     assign
     1824       v-seconds = v-seconds modulo 60
     1825     .
     1826     return
     1827         (if v-day-number <> 0
     1828           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1829           else ""
     1830         )
     1831       + (if v-day-number <> 0 or v-hour <> 0
     1832           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1833           else ""
     1834         )
     1835       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1836           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1837           else ""
     1838         )
     1839       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1840       .
     1841   end.
     1842   function cur-time-string returns character
     1843   :
     1844     define variable v-date as date      no-undo .
     1845     define variable v-time as integer   no-undo .
     1846     run cur-time in this-procedure
     1847       (output v-date
     1848       ,output v-time
     1849       ) .
     1850     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1851   end.
     1852   function cur-time-string-sec returns character
     1853   :
     1854     define variable v-date as date      no-undo .
     1855     define variable v-time as integer   no-undo .
     1856     run cur-time in this-procedure
     1857       (output v-date
     1858       ,output v-time
     1859       ) .
     1860     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1861   end.
     1862   function cur-time-custom  returns character
     1863   (input p-prefix as character
     1864   ,input p-date-format as character
     1865   ,input p-delimiter as character
     1866   ,input p-time-format as character
     1867   ,input p-suffix as character
     1868   )
     1869   :
     1870     define variable v-date as date      no-undo .
     1871     define variable v-time as integer   no-undo .
     1872     run cur-time in this-procedure
     1873       (output v-date
     1874       ,output v-time
     1875       ) .
     1876     return
     1877       p-prefix
     1878       + string(v-date, p-date-format)
     1879       + p-delimiter
     1880       + string(v-time, p-time-format)
     1881       + p-suffix
     1882       .
     1883   end.
     1884   function cur-time-print  returns character
     1885   :
     1886     define variable v-date as date      no-undo .
     1887     define variable v-time as integer   no-undo .
     1888     run cur-time in this-procedure
     1889       (output v-date
     1890       ,output v-time
     1891       ) .
     1892     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1893   end.
     1894   function cur-time-datetime returns datetime
     1895   :
     1896     define variable v-char as character no-undo .
     1897     define variable v-datetime as datetime no-undo .
     1898     v-char = cur-time-string().
     1899     v-datetime = datetime(v-char).
     1900     return  v-datetime.
     1901   end.
     1902   function cur-time-string-msec returns character
     1903   :
     1904     define variable v-date as datetime  no-undo .
     1905     v-date = now.
     1906     return string(v-date) .
     1907   end.
     1908   define variable vss-include-info14 as character format "X(65)" no-undo
     1909   initial "@(#)$Workfile$ $Revision$".
     1910   procedure xmlchar-test :
     1911   define input parameter p-in-string          as character        no-undo.
     1912   define output parameter p-out-string-enc    as character        no-undo.
     1913   define output parameter p-out-string-dec    as character        no-undo.
     1914   do
     1915   on error undo, return error
     1916   :
     1917          run xmlchar-encode in this-procedure
     1918       (
     1919             input p-in-string
     1920           , output p-out-string-enc
     1921       ).
     1922          run xmlchar-decode in this-procedure
     1923       (
     1924             input p-out-string-enc
     1925           , output p-out-string-dec
     1926       ).
     1927   end.
     1928   end .
     1929   procedure xmlchar-encode :
     1930   define input parameter p-in-string      as character        no-undo.
     1931   define output parameter p-out-string    as character        no-undo.
     1932       define variable v-position      as integer      no-undo.
     1933       define variable v-current-char  as character    no-undo.
     1934   do
     1935   on error undo, return error
     1936   :
     1937       assign
     1938           p-out-string = "":U
     1939       .
     1940       case p-in-string
     1941       :
     1942           when ?
     1943           then do:
     1944               assign
     1945                   p-out-string = "?":U
     1946               .
     1947           end.
     1948           when "?":U
     1949           then do:
     1950               assign
     1951                   p-out-string = "&#63;":U
     1952               .
     1953           end.
     1954           otherwise do:
     1955               do v-position = 1 to length( p-in-string )
     1956               :
     1957                   assign
     1958                       v-current-char = substring( p-in-string, v-position, 1 )
     1959                   .
     1960                   case v-current-char
     1961                   :
     1962                       when "&":U
     1963                       then do:
     1964                           assign
     1965                               p-out-string = p-out-string + "&amp;":U
     1966                           .
     1967                       end.
     1968                       when ">":U
     1969                       then do:
     1970                           assign
     1971                               p-out-string = p-out-string + "&gt;":U
     1972                           .
     1973                       end.
     1974                       when "<":U
     1975                       then do:
     1976                           assign
     1977                               p-out-string = p-out-string + "&lt;":U
     1978                           .
     1979                       end.
     1980                       when "'":U
     1981                       then do:
     1982                           assign
     1983                               p-out-string = p-out-string + "&apos;":U
     1984                           .
     1985                       end.
     1986                       when '"':U
     1987                       then do:
     1988                           assign
     1989                               p-out-string = p-out-string + "&quot;":U
     1990                           .
     1991                       end.
     1992                       when chr(1)
     1993                       then do:
     1994                           assign
     1995                               p-out-string = p-out-string + "":U
     1996                           .
     1997                       end.
     1998                       when chr(2)
     1999                       then do:
     2000                           assign
     2001                               p-out-string = p-out-string + "":U
     2002                           .
     2003                       end.
     2004                       when chr(3)
     2005                       then do:
     2006                           assign
     2007                               p-out-string = p-out-string + "":U
     2008                           .
     2009                       end.
     2010                       when chr(4)
     2011                       then do:
     2012                           assign
     2013                               p-out-string = p-out-string + "":U
     2014                           .
     2015                       end.
     2016                       when chr(5)
     2017                       then do:
     2018                           assign
     2019                               p-out-string = p-out-string + "":U
     2020                           .
     2021                       end.
     2022                       when chr(6)
     2023                       then do:
     2024                           assign
     2025                               p-out-string = p-out-string + "":U
     2026                           .
     2027                       end.
     2028                       when chr(7)
     2029                       then do:
     2030                           assign
     2031                               p-out-string = p-out-string + "":U
     2032                           .
     2033                       end.
     2034                       when chr(8)
     2035                       then do:
     2036                           assign
     2037                               p-out-string = p-out-string + "":U
     2038                           .
     2039                       end.
     2040                       when chr(9)
     2041                       then do:
     2042                           assign
     2043                               p-out-string = p-out-string + "":U
     2044                           .
     2045                       end.
     2046                       when chr(29)
     2047                       then do:
     2048                           assign
     2049                               p-out-string = p-out-string + "":U
     2050                           .
     2051                       end.
     2052                       when chr(10)
     2053                       then do:
     2054                           assign
     2055                               p-out-string = p-out-string + "&#10;":U
     2056                           .
     2057                       end.
     2058                       when chr(13)
     2059                       then do:
     2060                           assign
     2061                               p-out-string = p-out-string + "&#13;":U
     2062                           .
     2063                       end.
     2064                       otherwise do:
     2065                           assign
     2066                               p-out-string = p-out-string + v-current-char
     2067                           .
     2068                       end.
     2069                   end case.
     2070               end.
     2071           end.
     2072       end case.
     2073   end.
     2074   end .
     2075   procedure xmlchar-encode-1c :
     2076   define input parameter p-in-string      as character        no-undo.
     2077   define output parameter p-out-string    as character        no-undo.
     2078       define variable v-position      as integer      no-undo.
     2079       define variable v-current-char  as character    no-undo.
     2080   do
     2081   on error undo, return error
     2082   :
     2083       assign
     2084           p-out-string = "":U
     2085       .
     2086       case p-in-string
     2087       :
     2088           when ?
     2089           then do:
     2090               assign
     2091                   p-out-string = "?":U
     2092               .
     2093           end.
     2094           otherwise do:
     2095               do v-position = 1 to length( p-in-string )
     2096               :
     2097                   assign
     2098                       v-current-char = substring( p-in-string, v-position, 1 )
     2099                   .
     2100                   case v-current-char
     2101                   :
     2102                       when chr(1)
