     2373   .
     2374   procedure bgelib-tag-open:
     2375   do
     2376   on error undo, return error
     2377   :
     2378   define input parameter v-tag-level  as integer      no-undo.
     2379   define input parameter v-tag-name   as character    no-undo.
     2380   define input parameter v-tag-value  as character    no-undo.
     2381       put stream stmXMLOut unformatted
     2382           chr(10)
     2383           + fill(" ", 4 * v-tag-level)
     2384           + "<" + v-tag-name
     2385           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2386           + v-tag-value + ">"
     2387       .
     2388   end.
     2389   end procedure.
     2390   procedure bgelib-tag-put:
     2391   do
     2392   on error undo, return error
     2393   :
     2394   define input parameter v-tag-level      as integer      no-undo.
     2395   define input parameter v-tag-name       as character    no-undo.
     2396   define input parameter v-tag-value      as character    no-undo.
     2397   define input parameter v-empty-mode     as integer      no-undo.
     2398       v-tag-name = trim(v-tag-name).
     2399       if  v-empty-mode = 1
     2400       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2401       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2402       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2403       then do:
     2404           run xmlchar-encode in this-procedure (
     2405                 input v-tag-value
     2406               , output v-tag-value
     2407           ).
     2408           put stream stmXMLOut unformatted
     2409               chr(10) + fill(" ", 4 * v-tag-level)
     2410                           + '<' + v-tag-name + '>'
     2411                           + v-tag-value
     2412                           + '</' + v-tag-name + '>'
     2413           .
     2414       end.
     2415   end.
     2416   end procedure.
     2417   procedure bgelib-tag-close:
     2418   do
     2419   on error undo, return error
     2420   :
     2421   define input parameter v-tag-level as integer      no-undo.
     2422   define input parameter v-tag-name  as character    no-undo.
     2423       put stream stmXMLOut unformatted
     2424           chr(10)
     2425           + fill( " ", 4 * v-tag-level)
     2426           + '</' + v-tag-name + '>'
     2427       .
     2428   end.
     2429   end procedure.
     2430   procedure bgelib-write-log:
     2431   do
     2432   on error undo, return error
     2433   :
     2434   define input parameter v-filename   as character    no-undo.
     2435   define input parameter v-log-level  as integer      no-undo.
     2436   define input parameter v-out-string as character    no-undo.
     2437       output stream stmXMLLog to value( v-filename ) append.
     2438       put stream stmXMLLog unformatted
     2439           chr(10)
     2440       .
     2441       put stream stmXMLLog unformatted
     2442           ( if v-log-level = 0
     2443             or v-out-string = "&DLine"
     2444             or v-out-string = "&Line"
     2445             then ""
     2446             else cur-time-string-sec() + " " )
     2447       .
     2448       put stream stmXMLLog unformatted
     2449           ( if v-out-string = "&Line"
     2450             then fill( "-", 80 )
     2451             else if v-out-string = "&DLine"
     2452                  then fill( "=", 80 )
     2453                  else v-out-string )
     2454       .
     2455       output stream stmXMLLog close.
     2456   end.
     2457   end procedure.
     2458   procedure bgelib-write-edt:
     2459   do
     2460   on error undo, return error
     2461   :
     2462   define input parameter v-editor-handle    as handle       no-undo.
     2463   define input parameter v-log-level        as integer      no-undo.
     2464   define input parameter v-out-string       as character    no-undo.
     2465       if valid-handle ( v-editor-handle )
     2466       then do:
     2467           v-editor-handle :move-to-eof().
     2468           v-editor-handle :insert-string( ( if v-log-level = 0
     2469                                             or v-out-string = "&DLine"
     2470                                             or v-out-string = "&Line"
     2471                                             then ""
     2472                                             else cur-time-string-sec() + " "
     2473                                         ) ).
     2474           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2475                                             then fill( "-", 80 )
     2476                                             else if v-out-string = "&DLine" then fill("=", 80)
     2477                                             else fill( " ", v-log-level) + v-out-string
     2478                                         ) ).
     2479           v-editor-handle :insert-string( chr(10) ).
     2480       end.
     2481       process events.
     2482       output to 'bgescn.txt' append.
     2483           put unformatted
     2484               chr(10)
     2485               string( ( if v-log-level = 0
     2486                         or v-out-string = "&DLine"
     2487                         or v-out-string = "&Line"
     2488                         then ""
     2489                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2490                     ) )
     2491               string( ( if v-out-string = "&Line"
     2492                         then fill( "-", 80 )
     2493                         else if v-out-string = "&DLine"
     2494                              then fill( "=", 80 )
     2495                              else fill( " ", v-log-level ) + v-out-string
     2496                     ) )
     2497           .
     2498       output close.
     2499   end.
     2500   end procedure.
     2501   procedure bgelib-show-cnt:
     2502   do
     2503   on error undo, return error
     2504   :
     2505   define input parameter v-fillin-handle     as handle   no-undo.
     2506       if valid-handle( v-fillin-handle )
     2507       then do:
     2508           assign
     2509               v-fillin-handle :visible = true
     2510           .
     2511       end.
     2512   end.
     2513   end procedure.
     2514   procedure bgelib-hide-cnt:
     2515   do
     2516   on error undo, return error
     2517   :
     2518   define input parameter v-fillin-handle     as handle   no-undo.
     2519       if valid-handle( v-fillin-handle )
     2520       then do:
     2521           assign v-fillin-handle :visible = false.
     2522       end.
     2523   end.
     2524   end procedure.
     2525   procedure bgelib-write-cnt:
     2526   do
     2527   on error undo, return error
     2528   :
     2529   define input parameter v-fillin-handle    as handle       no-undo.
     2530   define input parameter v-fillin-string    as character    no-undo.
     2531       if valid-handle( v-fillin-handle )
     2532       then do:
     2533           assign
     2534               v-fillin-handle :SCREEN-value = v-fillin-string
     2535           .
     2536       end.
     2537   end.
     2538   end procedure.
     2539   procedure bgelib-write-header:
     2540   do
     2541   on error undo, return error
     2542   :
     2543   define input parameter p-first-file     as logical      no-undo.
     2544   define input parameter p-xml-file-name  as character    no-undo.
     2545   define input parameter p-list-file-name as character    no-undo.
     2546   define input parameter p-file-number    as integer      no-undo.
     2547   define input parameter p-have-prev      as logical      no-undo.
     2548   define input parameter p-prev-filename  as character    no-undo.
     2549   define input parameter p-obj-list       as character    no-undo.
     2550   define input parameter p-doc-type-list  as character    no-undo.
     2551   define input parameter p-parameter-list as character    no-undo.
     2552       define variable v-counter    as integer        no-undo.
     2553       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2554       put stream stmXMLOut unformatted
     2555           "<?xml version='1.0' encoding='windows-1251'?>"
     2556       .
     2557       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2558       run bgelib-tag-open( input 0, input "header", input "" ).
     2559       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2560       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2561       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2562       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2563       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2564       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2565       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2566       :
     2567           run bgelib-tag-put(
     2568                 input 1
     2569               , input entry( 2 * v-counter, p-parameter-list )
     2570               , input entry( 2 * v-counter + 1, p-parameter-list )
     2571               , input 0
     2572           ).
     2573       end.
     2574       run bgelib-tag-close( input 0, input "header" ).
     2575       output stream stmXMLOut close.
     2576       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2577       if p-first-file = yes
     2578       then do:
     2579           put stream stmXMLOut unformatted
     2580               "<?xml version='1.0' encoding='windows-1251'?>"
     2581           .
     2582           run bgelib-tag-open( input 0, input "export", input "" ).
     2583       end.
     2584       run bgelib-tag-open( input 1, input "file", input "" ).
     2585       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2586       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2587       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2588       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2589       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2590       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2591       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2592       :
     2593           run bgelib-tag-put(
     2594                 input 2
     2595               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2596               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2597               , input 0
     2598           ).
     2599       end.
     2600       run bgelib-tag-close( input 1, input "file" ).
     2601       output stream stmXMLOut close.
     2602   end.
     2603   end procedure.
     2604   procedure bgelib-write-footer:
     2605   do
     2606   on error undo, return error
     2607   :
     2608   define input parameter p-last-file      as logical      no-undo.
     2609   define input parameter p-xml-file-name  as character    no-undo.
     2610   define input parameter p-list-file-name as character    no-undo.
     2611   define input parameter p-have-next      as logical      no-undo.
     2612   define input parameter p-next-file-name as character    no-undo.
     2613       define variable v-error-num     as integer           no-undo.
     2614       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2615       if p-have-next = yes
     2616       then do:
     2617           run bgelib-tag-open( input 0, input "footer", "" ).
     2618           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2619           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2620           run bgelib-tag-close( input 0, input "footer" ).
     2621       end.
     2622       run bgelib-tag-close( input 0, input "root" ).
     2623       output stream stmXMLOut close.
     2624       run bge/os_copy.p (
     2625             input "M"
     2626           , input p-xml-file-name + "tmp"
     2627           , input p-xml-file-name + "xml"
     2628           , output v-error-num
     2629       ).
     2630       if p-last-file = yes
     2631       then do:
     2632           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2633               run bgelib-tag-close( input 0, input "export" ).
     2634           output stream stmXMLOut close.
     2635           run bge/os_copy.p (
     2636                 input "M"
     2637               , input p-list-file-name + "tmp"
     2638               , input p-list-file-name + "xml"
     2639               , output v-error-num
     2640           ).
     2641       end.
     2642   end.
     2643   end procedure.
     2644   procedure bgelib-filename :
     2645   do
     2646   on error undo, return error
     2647   :
     2648   define input parameter p-prefix             as character    no-undo.
     2649   define output parameter p-xml-file-name     as character    no-undo.
     2650   define output parameter p-log-file-name     as character    no-undo.
     2651   define output parameter p-list-file-name    as character    no-undo.
     2652       define variable v-home-dir  as character    no-undo.
     2653       define variable v-error-num as integer      no-undo.
     2654       get-key-value section "BGE" key "outdir" value v-home-dir.
     2655       if v-home-dir = ?
     2656       then do:
     2657           message
     2658             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2659             skip(1)
     2660             skip "Обратитесь к администратору."
     2661           view-as alert-box error.
     2662           undo, return error .
     2663       end.
     2664       run gbl/dir-cre.p (
     2665           input v-home-dir
     2666       ) no-error.
     2667       if error-status :error
     2668       then do:
     2669           message
     2670             skip "Неверно задан каталог экспорта."
     2671             skip(1)
     2672             skip "Обратитесь к администратору."
     2673           view-as alert-box error.
     2674           undo, return error .
     2675       end.
     2676       run bge/genfname.p (
     2677             input v-home-dir
     2678           , input p-prefix
     2679           , input ""
     2680           , input "xml"
     2681           , input "tmp"
     2682           , output p-xml-file-name
     2683       ).
     2684       assign
     2685           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2686           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2687           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2688       .
     2689   end.
     2690   end procedure.
     2691   procedure bgelib-read-config :
     2692   do
     2693   on error undo, return error
     2694   :
     2695   define variable v-par-type as character     no-undo.
     2696     define variable v-param-type      as character  no-undo .
     2697     define variable v-value-character as character  no-undo .
     2698     define variable v-value-date      as date       no-undo .
     2699     define variable v-value-decimal   as decimal    no-undo .
     2700     define variable v-value-integer   as integer    no-undo .
     2701     define variable v-value-logical   as logical    no-undo .
     2702     define variable v-tth             as handle     no-undo .
     2703       assign
     2704           v-bgelib-bgeclall = no
     2705           v-bgelib-bgedict  = no
     2706       .
     2707       run adm/shattri.p ( input "get":U
     2708                         , input  '':u
     2709                         , input  0
     2710                         , input  'bge-export':U
     2711                         , input  'bgeclall':U
     2712                         , output v-value-character
     2713                         , output v-value-date
     2714                         , output v-value-decimal
     2715                         , output v-value-integer
     2716                         , output v-value-logical
     2717                         , output v-param-type
     2718                         , input-output table-handle v-tth
     2719                         ) no-error .
     2720       if error-status :error
     2721       then do:
     2722         assign
     2723           v-bgelib-bgeclall = no
     2724         .
     2725       end.
     2726       else do:
     2727         assign
     2728           v-bgelib-bgeclall = v-value-logical
     2729         .
     2730       end.
     2731       delete object v-tth.
     2732       run adm/shattri.p ( input "get":U
     2733                         , input  '':u
     2734                         , input  0
     2735                         , input  'bge-export':U
     2736                         , input  'bgedict':U
     2737                         , output v-value-character
     2738                         , output v-value-date
     2739                         , output v-value-decimal
     2740                         , output v-value-integer
     2741                         , output v-value-logical
     2742                         , output v-param-type
     2743                         , input-output table-handle v-tth
     2744                         ) no-error .
     2745       if error-status :error
     2746       then do:
     2747         assign
     2748           v-bgelib-bgedict = no
     2749         .
     2750       end.
     2751       else do:
     2752         assign
     2753           v-bgelib-bgedict = v-value-logical
     2754         .
     2755       end.
     2756       delete object v-tth.
     2757       run adm/shattri.p ( input "get":U
     2758                         , input  '':u
     2759                         , input  0
     2760                         , input  'bge-export':U
     2761                         , input  'bgefmt':U
     2762                         , output v-value-character
     2763                         , output v-value-date
     2764                         , output v-value-decimal
     2765                         , output v-value-integer
     2766                         , output v-value-logical
     2767                         , output v-param-type
     2768                         , input-output table-handle v-tth
     2769                         ) no-error .
     2770       if error-status :error
     2771       then do:
     2772         assign
     2773           v-bgelib-bgefmt  = "xml":U
     2774         .
     2775       end.
     2776       else do:
     2777         assign
     2778           v-bgelib-bgefmt  = v-value-character
     2779         .
     2780       end.
     2781       delete object v-tth.
     2782       run adm/shattri.p ( input "get":U
     2783                         , input  '':u
     2784                         , input  0
     2785                         , input  'bge-export':U
     2786                         , input  'bgeflold':U
     2787                         , output v-value-character
     2788                         , output v-value-date
     2789                         , output v-value-decimal
     2790                         , output v-value-integer
     2791                         , output v-value-logical
     2792                         , output v-param-type
     2793                         , input-output table-handle v-tth
     2794                         ) no-error .
     2795       if error-status :error
     2796       then do:
     2797         assign
     2798           v-bgelib-bgeflold  = "old":U
     2799         .
     2800       end.
     2801       else do:
     2802         assign
     2803           v-bgelib-bgeflold  = v-value-character
     2804         .
     2805       end.
     2806       delete object v-tth.
     2807   end.
     2808   end procedure.
     2809   procedure bgelib-check-file-size :
     2810   do
     2811   on error undo, return error
     2812   :
     2813   define input parameter p-out-filename   as character    no-undo.
     2814   define output parameter p-is-big        as logical      no-undo.
     2815       define variable v-current-position    as integer        no-undo.
     2816       assign
     2817           v-current-position = seek( stmXMLOut )
     2818       .
     2819       if v-current-position / 1024 / 1024  >= 100
     2820       then do:
     2821           assign
     2822               p-is-big = yes
     2823           .
     2824       end.
     2825   end.
     2826   end procedure.
     2827   procedure bgelib-init-ext-doc-type :
     2828       define variable v-counter    as integer      no-undo.
     2829       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2830   do
     2831   for buf_temp_ext-doc-type
     2832   on error undo, return error
     2833   :
     2834       empty temp-table buf_temp_ext-doc-type.
     2835       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2836       :
     2837           create buf_temp_ext-doc-type.
     2838           assign
     2839               buf_temp_ext-doc-type.edt-key               = v-counter
     2840               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2841               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2842           .
     2843       end.
     2844   end.
     2845   end procedure.
     2846   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2847   define variable v-xml-file-name     as character            no-undo.
     2848   define variable v-xml-file-name-path as character            no-undo.
     2849   define variable v-log-file-name     as character            no-undo.
     2850   define variable v-locked            as logical              no-undo.
     2851   define variable v-log-string        as character            no-undo.
     2852   define variable v-oper-num          as integer              no-undo.
     2853   define variable v-obj-list          as character            no-undo.
     2854   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2855   DEF VAR intRep      AS INT NO-UNDO.
     2856   define variable hEDT             AS HANDLE NO-UNDO.
     2857   define variable hCNT             AS HANDLE NO-UNDO.
     2858   procedure xml-cd-write-header:
     2859   do
     2860   on error undo, return error
     2861   :
     2862   define input parameter p-xml-file-name       as character    no-undo.
     2863   define input parameter p-xml-file-name-path  as character    no-undo.
     2864   define input parameter p-doc-name            as character    no-undo.
     2865   define input parameter p-version             as character    no-undo.
     2866   define input parameter p-obj-list            as character    no-undo.
     2867   define input parameter p-correspondent       as character    no-undo .
     2868   define input parameter p-write-header        as logical      no-undo .
     2869   define variable OS-time as character no-undo .
     2870   define variable id as character no-undo .
     2871   define buffer buf_db for ub.db.
     2872   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2873   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2874   assign
     2875   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2876   .
     2877   run bgelib-tag-open in this-procedure (
     2878                                        1
     2879                                       ,p-doc-name
     2880                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2881                                         ).
     2882   if p-write-header then do:
     2883     run bgelib-tag-open(2, "Header","").
     2884     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2885     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2886     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2887     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2888     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2889     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2890     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2891     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2892     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2893     run bgelib-tag-close( 2, "Header" ).
     2894   end.
     2895   output stream stmXMLOut close.
     2896   end.
     2897   end procedure.
     2898   procedure xml-cd-write-footer:
     2899   do
     2900   on error undo, return error
     2901   :
     2902   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2903   define input parameter p-xml-file-name as character    no-undo.
     2904   define input parameter p-doc-name      as character    no-undo .
     2905   define variable v-error-num     as integer           no-undo.
     2906   define variable v-md5-signature as character no-undo .
     2907   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2908   run bgelib-tag-close( 0, p-doc-name ).
     2909   put stream stmXMLOut unformatted skip.
     2910   output stream stmXMLOut close.
     2911   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2912   if v-error-num > 0
     2913   then do:
     2914      return error.
     2915   end.
     2916   if opsys = "unix"
     2917   then do:
     2918       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2919   end.
     2920   end.
     2921   end procedure.
     2922   procedure xml-cd-filename :
     2923   do
     2924   on error undo, return error
     2925   :
     2926   define input parameter  p-out               as character no-undo .
     2927   define output parameter p-xml-file-name     as character    no-undo.
     2928   define output parameter p-xml-file-name-path   as character    no-undo.
     2929   define output parameter p-log-file-name     as character    no-undo.
     2930   define output parameter p-locked            as logical      no-undo.
     2931   define variable v-out as character     no-undo.
     2932   define variable loc#log as logical no-undo .
     2933   define variable BadFlag as logical no-undo .
     2934   define variable fq as integer no-undo .
     2935   define variable v-remote as character no-undo .
     2936   assign
     2937   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2938   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2939   p-log-file-name = p-out + "actions.log"
     2940   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2941   .
     2942   end.
     2943   end procedure.
     2944   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2945   define variable v-date-str as character no-undo .
     2946   assign
     2947   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2948                string(Month(p-date), "99":U) + "-":U +
     2949                string(DAY(p-date), "99":U).
     2950   return v-date-str.
     2951   END FUNCTION.
     2952   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2953   define variable v-date-str as character no-undo .
     2954   assign
     2955   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2956                string(Month(p-date), "99":U) + "-":U +
     2957                string(DAY(p-date), "99":U) + chr(32) +
     2958                string(p-time, "HH:MM:SS").
     2959   return v-date-str.
     2960   END FUNCTION.
     2961   function string-to-date returns date ( input p-string  as character):
     2962     define variable v-date as date no-undo .
     2963     assign
     2964     v-date = date(integer(substring(p-string, 4, 2))
     2965                   ,integer(substring(p-string, 1, 2))
     2966                   ,integer(substring(p-string, 7, 4))
     2967                  ) no-error .
     2968     if error-status:error then return ?.
     2969     return v-date.
     2970   END FUNCTION.
     2971   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2972   define variable v-time as integer no-undo init ?.
     2973   define variable v-dop1 as character no-undo .
     2974   define variable v-dop2 as character no-undo .
     2975   assign
     2976   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2977   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2978   no-error .
     2979   if error-status:error then return ?.
     2980   assign
     2981   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2982             integer(entry(2, v-dop2, ";":U)) * 60 +
     2983             integer(entry(3, v-dop2, ";":U)) no-error .
     2984   return v-time.
     2985   END FUNCTION.
