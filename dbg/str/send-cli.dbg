     8550     IF LAST-OF(ub.cash-desk.pos-type) then do:
     8551   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8552   case ub.cash-desk.pos-type:
     8553     when 'IPC-Servis+':U then do:
     8554   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8555     end.
     8556     when 'NCR-GM':U
     8557     then do:
     8558   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8559     _lock-gds:
     8560     DO while ind < 100 :
     8561       run gbl/lock-prc.p (
     8562            input 'pncr':U
     8563           ,input i-obj-code
     8564           ,input 0
     8565           ,input 0
     8566           ,input 'маг':U
     8567           ,input "":U
     8568           ,input "":U
     8569           ,input ("Код объекта" + ",,,":U +
     8570                   "Тип объекта" +  ",,,":U + 'Пересылка дисконтных карт')
     8571           ,input no
     8572           ,buffer lock-batchprocess
     8573           ) no-error .
     8574       if not error-status:error then do:
     8575         leave _lock-gds.
     8576       end.
     8577       run write-log-and-file in p-log-handle (
     8578           input 1
     8579         , input log-file-name
     8580         , input 1
     8581         , input substitute( "Объект &1: Файл для выгрузки данных ЗАНЯТ - Ждите", i-obj-code
     8582                           )
     8583                                           ).
     8584       pause 1.
     8585     end.
     8586       OS-append
     8587       value( out + fname + '.dat':U )
     8588       value( out + "gmrecmnt.dat":U).
     8589       if search(out + 'debug.flg') = ? then do:
     8590         OS-delete value( out + fname + '.dat':U ).
     8591       end.
     8592       if ub.cash-desk.pos-type = 'NCR-AS@R':U then do:
     8593         output stream ibmstream to value( out + "gmrecmnt.ctl":U).
     8594         put unformatted skip.
     8595         output stream ibmstream close.
     8596       end.
     8597       run write-log-and-file in p-log-handle (
     8598             input 1
     8599           , input log-file-name
     8600           , input 1
     8601           , input substitute( "Данные выгружены в файл &1"
     8602                               ,( out + "gmrecmnt.dat":U)
     8603                             )
     8604                                            ).
     8605       if g#news
     8606       or g#auto
     8607       or g#esys
     8608       then do:
     8609         run str/waitpn.w (
     8610                      input (out + "gmrecmnt.dat":U)
     8611                     ,input ( if action = 'U'
     8612                               then ('Ждите - ' + 'добавление дисконтных карт')
     8613                               else ('Ждите - ' + 'удаление дисконтных карт') )
     8614                     ,input ' Подождите 15 сек '
     8615                     ,input 15
     8616                     ) no-error.
     8617       end.
     8618       else do:
     8619         run str/waitp.w (
     8620                      input (out + "gmrecmnt.dat":U)
     8621                     ,input ( if action = 'U'
     8622                               then ('Ждите - ' + 'добавление дисконтных карт')
     8623                               else ('Ждите - ' + 'удаление дисконтных карт') )
     8624                     ,input ' Подождите 15 сек '
     8625                     ,input 'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!'
     8626                     ,input 15
     8627                     )
     8628                     no-error.
     8629       end.
     8630       if error-status:error then do:
     8631           run write-log-and-file in p-log-handle (
     8632                 input 1
     8633               , input log-file-name
     8634               , input 1
     8635               , input substitute( "!!!Прерван обмен информацией с кассой, на кассе осталась устаревшая информация"
     8636                                 )
     8637                                                 ).
     8638           os-delete value( out + "gmrecmnt.dat":U).
     8639           assign
     8640           v-view-log = yes
     8641           .
     8642           return "error":U.
     8643       end.
     8644     end.
