     6841         run bgelib-tag-put in this-procedure ( input 3, input "ClientCode"       , input string(cash-cli.cli-code + 1000000000 * cash-cli.justface), input 1 ).
     6842         run bgelib-tag-put in this-procedure ( input 3, input "CardDisCat"       , input string(v-magia-kat-pcnt), input 1 ).
     6843         run bgelib-tag-put in this-procedure ( input 3, input "CardType"        , input string(cash-cli.card-media), input 1 ).
     6844         run bgelib-tag-put in this-procedure ( input 3, input "CardOperation"   , input string(v-magia-card-operation), input 1 ).
     6845         run bgelib-tag-put in this-procedure ( input 3, input "CardNumber"      , input v-full-number, input 1 ).
     6846         if cash-cli.cli-message <> ?
     6847         then
     6848         run bgelib-tag-put in this-procedure ( input 3, input "CardMessage"     , input string(cash-cli.cli-message), input 1 ).
     6849         run bgelib-tag-put in this-procedure ( input 3, input "CardFiscal"      ,  input string(if cash-cli.fiscal-pay then 1 else 0), input 1 ).
     6850         if v-magia-curr-code <> ? then
     6851         run bgelib-tag-put in this-procedure ( input 3, input "CardCurrCode"    ,  input string(v-magia-curr-code), input 1 ).
     6852         run bgelib-tag-put in this-procedure ( input 3, input "CardMixedPay"    ,  input string(if cash-cli.mixed-pay then 1 else 0), input 1 ).
     6853         run bgelib-tag-put in this-procedure ( input 3, input "CardSaldo"        , input string(cash-cli.current-saldo), input 1 ).
     6854         run bgelib-tag-put in this-procedure ( input 3, input "CardLimit"        , input string(- cash-cli.lim-kr), input 1 ).
     6855         run bgelib-tag-put in this-procedure ( input 3, input "CardLock"         ,
     6856                                             input string(if lookup('тек':U, cash-cli.status_ ) > 0
     6857                                                                 then 0
     6858                                                                 else 1
     6859                                                         )
     6860                                                         , input 1 ).
     6861         run bgelib-tag-close in this-procedure ( input 2, input "Card").
     6862       end.
     6863     end.
     6864     when 'IPC-Servis+':U then  do:
     6865       FIND FIRST ub.dis-card-type No-LOCK WHERE
     6866                   ub.dis-card-type.type = cash-cli.type AND
     6867                   ub.dis-card-type.emitent-host-code = cash-cli.emitent-host-code AND
     6868                   ub.dis-card-type.host-code = 0 AND
     6869                   ub.dis-card-type.obj-type = "":U AND
     6870                   ub.dis-card-type.obj-code = 0 No-ERROR.
     6871       if not cash-cli.mask-card then do:
     6872         PUT UNFORMATTED
     6873         (ub.dis-card-type.dc-pfx + cash-cli.d-card) ","
     6874         '"' caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)")) '"' ","
     6875         string( if cash-cli.d-pcnt-byshop
     6876               then (v-d-pcnt)
     6877               else ( cash-cli.d-pcnt ) , "->>9.99" ) ","
     6878         string( 0, ">>>>>>>>9")
     6879         SKIP.
     6880       end.
     6881     end.
     6882     when 'OMRON':U then do:
     6883       if not cash-cli.mask-card then do:
     6884         PUT unformatted
     6885         string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6886         "000000000000"
     6887         caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6888         fill( " ", 20)
     6889         caps( string( cash-cli.cli-adr , "x(25)" ) )
     6890         caps( string( cash-cli.cli-city , "x(20)" ) )
     6891         string( cash-cli.cli-ind, ">>>>>9" )
     6892         fill(" ", 14)
     6893         fill(" ", 14)
     6894         string(today, "999999")
     6895         (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6896                 (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6897                 else "D":U)
     6898                 else string( action, "x(1)" )
     6899                 )
     6900         string( if cash-cli.d-pcnt-byshop
     6901                 then ( round(v-d-pcnt, 2) * 100 )
     6902                 else ( round(cash-cli.d-pcnt, 2) * 100 )
     6903               , "9999" )
     6904         SKIP
     6905         .
     6906       end.
     6907     end.
     6908     when 'OMRON-NEW':U then  do:
     6909       if not cash-cli.mask-card then do:
     6910         assign
     6911         v-versiond = decimal(p-version)
     6912         no-error .
     6913         if v-versiond >= 33.0 then do:
     6914           PUT unformatted
     6915           string( fill( "0", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6916           "000000000000"
     6917           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6918           fill( " ", 20)
     6919           caps( string( cash-cli.cli-adr , "x(25)" ) )
     6920           caps( string( cash-cli.cli-city , "x(20)" ) )
     6921           string( cash-cli.cli-ind, ">>>>>9" )
     6922           fill(" ", 14)
     6923           fill(" ", 14)
     6924           string(today, "999999")
     6925           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6926                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6927                   else "D":U)
     6928                   else string( action, "x(1)" )
     6929                   )
     6930           string( if cash-cli.d-pcnt-byshop
     6931                   then ( round(v-d-pcnt, 2) * 100 )
     6932                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     6933                 , "9999" )
     6934           replace(string(today, "99/99/9999"), chr(47), "":U)
     6935           '00':U
     6936           '000':U
     6937           fill( chr(32) , 31)
     6938           SKIP.
     6939         end.
     6940         else do:
     6941           PUT unformatted
     6942           string( fill( " ", 12 - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ))
     6943           "000000000000"
     6944           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(20)" ) )
     6945           fill( " ", 20)
     6946           caps( string( cash-cli.cli-adr , "x(25)" ) )
     6947           caps( string( cash-cli.cli-city , "x(20)" ) )
     6948           string( cash-cli.cli-ind, ">>>>>9" )
     6949           fill(" ", 14)
     6950           fill(" ", 14)
     6951           string(today, "999999")
     6952           (if g#news or g#esys or run-from = "O":U or run-from = "E":U then
     6953                   (if lookup('тек':U, cash-cli.status_ ) > 0 then "U":U
     6954                   else "D":U)
     6955                   else string( action, "x(1)" )
     6956                   )
     6957           string( if cash-cli.d-pcnt-byshop
     6958                   then ( round(v-d-pcnt, 2) * 100 )
     6959                   else ( round(cash-cli.d-pcnt, 2) * 100 )
     6960                 , "9999" )
     6961           SKIP
     6962           .
     6963         end.
     6964       end.
     6965     end.
     6966     when 'NCR-GM':U
     6967     or when 'NCR-AS@R':U
     6968     then do:
     6969       if length(cash-cli.d-card) > (if pos-type = 'NCR-GM':U then 10 else 12) then do:
     6970         if not (g#news or g#esys) then  do:
     6971           run write-log-and-file in p-log-handle (
     6972                 input 1
     6973               , input log-file-name
     6974               , input 1
     6975               , input substitute("!Ошибка при пересылке на кассу: Данные по дисконтной карте &1 не могут быть переданы на кассу NCR"
     6976                      , cash-cli.d-card )
     6977                                                 ).
     6978         end.
     6979         return .
     6980       end.
     6981       if cash-cli.kat-pcnt <> 0
     6982       AND (cash-cli.kat-pcnt < 10
     6983       or cash-cli.kat-pcnt > 99)
     6984       then do:
     6985         if not (g#news or g#esys) then  do:
     6986           run write-log-and-file in p-log-handle (
     6987                 input 1
     6988               , input log-file-name
     6989               , input 1
     6990               , input substitute("!Ошибка при пересылке на кассу:&2Данные по дисконтной карте &1 не могут быть переданы на кассу NCR&2" +
     6991                                  "Неверное значение категории карты: &3"
     6992                                  , cash-cli.d-card
     6993                                  , chr(10)
     6994                                  , cash-cli.kat-pcnt
     6995                                  )
     6996                                                 ).
     6997         end.
     6998         return .
     6999       end.
     7000       if not cash-cli.mask-card then do:
     7001         if (g#news or g#esys or run-from = "O":U or run-from = "E":U ) and
     7002             lookup('тек':U, cash-cli.status_ ) = 0  or
     7003             action = "D":U then do:
     7004           PUT stream IBMstream unformatted
     7005           "C1":U
     7006           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7007           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7008           "-":U
     7009           fill("-":U, 61)
     7010           chr(10)
     7011           "C2":U
     7012           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7013           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7014           "-":U
     7015           fill("-":U, 61)
     7016           chr(10)
     7017           .
     7018         end.
     7019         else do:
     7020           PUT stream IBMstream unformatted
     7021           "C1":U
     7022           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7023           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7024           "00":U
     7025           string(cash-cli.kat-pcnt, "99")
     7026           replace(string((if cash-cli.d-pcnt-method = integer('1':U)
     7027                         or cash-cli.d-pcnt-method = integer('3':U)
     7028                         then cash-cli.d-pcnt
     7029                         else 0), "999.9":U ), ".":U, "")
     7030           replace(string((if cash-cli.d-pcnt-method = integer('2':U)
     7031                         or cash-cli.d-pcnt-method = integer('3':U)
     7032                         then cash-cli.cash-d-pcnt
     7033                         else 0), "999.9":U ), ".":U, "")
     7034           "0000":U
     7035           "00000000":U
     7036           replace(string(cash-cli.lim-kr, "999999.99":U ), ".":U, "":U)
     7037           caps( string( entry(1, cash-cli.cli-name, chr(4)), "x(30)" ) )
     7038           chr(10)
     7039           "C2":U
     7040           fill(chr(32), (if pos-type = 'NCR-GM':U then 4 else 2))
     7041           string( fill( chr(32), (if pos-type = 'NCR-GM':U then 10 else 12) - length( trim( cash-cli.d-card ) ) ) + trim( cash-cli.d-card ) )
     7042           fill(chr(32), 2)
     7043           caps( string( cash-cli.cli-adr , "x(30)" ) )
     7044           (if cash-cli.property-value-chr[1] <> '':U
     7045           then (cash-cli.property-value-chr[1] + chr(32) + cash-cli.property-value-chr[2])
     7046           else
     7047           (string( cash-cli.cli-ind, ">>>>>9" ) + chr(32) + caps( string( cash-cli.cli-city , "x(23)" ) ))
     7048           )
     7049           chr(10)
     7050           .
     7051         end.
     7052       end.
     7053     end.
     7054     when 'r-keeper':U then do:
     7055       if g#news
     7056       or g#esys
     7057       or action <> "D"
     7058       and not cash-cli.mask-card
     7059       then do:
     7060         if length(cash-cli.d-card) > 9 then do:
     7061           run write-log-and-file in p-log-handle (
     7062                 input 1
     7063               , input log-file-name
     7064               , input 1
     7065               , input substitute("!Невозможно переслать на кассу типа &1 карту &2: слишком длинный номер карты"
     7066                                 , cash-cli.d-card
     7067                                 , 'r-keeper':U
     7068                                 )
     7069                                                 ).
     7070         end.
     7071         put stream IBMStream unformatted
     7072         cash-cli.d-card chr(44)
     7073         windows-date-format(if cash-cli.valid-date = 12/31/9999
     7074                then (today + 36500)
     7075                else cash-cli.valid-date, v-date-format) chr(44)
     7076         chr(44)
     7077         chr(44)
     7078         chr(44)
     7079         entry(1, cash-cli.cli-name, chr(4)) chr(44)
     7080         (if not cash-cli.credit-card
     7081         then 0
     7082         else 4
     7083         )  chr(44)
     7084       cash-cli.lim-kr
     7085         skip.
     7086       end.
     7087     end.
     7088     when 'MARIA':U then do:
     7089       if p-send-cli then do:
     7090         find first buf_cd-clu EXCLUSIVE-LOCK where
     7091                   buf_cd-clu.obj-type = 'маг':U
     7092               and buf_cd-clu.obj-code = abs((if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code))
     7093               and buf_cd-clu.pos-type = 'MARIA':U
     7094               and buf_cd-clu.clu-type = '':U
     7095               AND buf_cd-clu.cli-type = cash-cli.cli-type
     7096               AND buf_cd-clu.cli-code = cash-cli.cli-code  NO-ERROR.
     7097         if not available buf_cd-clu then do:
     7098           if v-del-mrkt-cli = no then do:
     7099             run write-log-and-file in p-log-handle (
     7100                   input 1
     7101                 , input log-file-name
     7102                 , input 1
     7103                 , input substitute("!!!Клиент &1&2 &3 не включен в число КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     7104                                     "пропускается...."
     7105                                     , cash-cli.cli-type
     7106                                     , cash-cli.cli-code
     7107                                     , cash-cli.obj-name
     7108                                     , pos-type
     7109                                     , 'маг':U
     7110                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     7111                                     , chr(10)
     7112                                     )
     7113                                       ).
     7114           end.
     7115         end.
     7116         assign
     7117         v-clu = buf_cd-clu.clu-code.
     7118         if (buf_cd-clu.to-del and v-del-mrkt-cli)
     7119         or action = "D" then do:
     7120           assign
     7121           v-marketer-action = "D":U.
     7122           if v-del-mrkt-cli then do:
     7123             create temp-cd-clu.
     7124             buffer-copy buf_cd-clu
     7125             to temp-cd-clu
     7126             assign
     7127             buf_cd-clu.charkey_one = v-cd-list-delete
     7128             .
     7129           end.
     7130           else do:
     7131             run write-log-and-file in p-log-handle (
     7132                   input 1
     7133                 , input log-file-name
     7134                 , input 1
     7135                 , input substitute("!!!Клиент &1&2 &3 может быть удален с кассы типа &4 ТОЛЬКО при удалении из числа КЛИЕНТОВ НА КАССЕ &4 &5&6&7" +
     7136                                     "пропускается...."
     7137                                     , cash-cli.cli-type
     7138                                     , cash-cli.cli-code
     7139                                     , cash-cli.obj-name
     7140                                     , pos-type
     7141                                     , 'маг':U
     7142                                     , (if g#news or g#esys then buf_cash-desk.obj-code else i-obj-code)
     7143                                     , chr(10)
     7144                                     )
     7145                                       ).
     7146             v-view-log = yes.
     7147           end.
     7148         end.
     7149         else do:
     7150           assign
     7151           v-marketer-action = action.
     7152           if buf_cd-clu.to-send then do:
     7153             create temp-cd-clu.
     7154             buffer-copy buf_cd-clu
     7155             to temp-cd-clu
     7156             assign
     7157             temp-cd-clu.charkey_two = ""
     7158             temp-cd-clu.to-send = no
     7159             .
     7160           end.
     7161         end.
     7162         run maria-put in this-procedure (
     7163                                         buffer buf_cash-desk
     7164                                       , input out
     7165                                       , input fname
     7166                                       , input yes
     7167                                       , input 0
     7168                                       , input no
     7169                                       , input 1
     7170                                       , input 200
     7171                                       , input string(v-clu)
     7172                                       , input (if v-marketer-action = 'd' then '':U else string(cash-cli.obj-name, "X(18)"))).
     7173         v-maria-discnt-value = string(0, '999').
     7174         if action <> 'D':U  then do:
     7175           _do:
     7176           do v-ii = 1 to 2:
     7177             if v-ii = 1 then
     7178             assign
     7179             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-debet-pay"):buffer-value.
     7180             if v-ii = 2 then
     7181             assign
     7182             v-dc-rule-num = buffer cash-cli:buffer-field("dcr-credit-pay"):buffer-value.
     7183             find first buf_dis-rule no-lock where
     7184               buf_dis-rule.obj-type = 'маг':U
     7185                   AND buf_dis-rule.obj-code = i-obj-code
     7186                   AND buf_dis-rule.rule-num = v-dc-rule-num
     7187                   AND buf_dis-rule.sts = integer('0':U) no-error .
     7188             if available buf_dis-rule then do:
     7189               if buf_dis-rule.discnt-type = integer('13':U) then do:
     7190                 assign
     7191                 v-maria-discnt-value = string('003')
     7192                 .
     7193               end.
     7194               else do:
     7195                 if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
     7196                   assign
     7197                   v-dop = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
     7198                   v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
     7199                   v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
     7200                   v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     7201                   .
     7202                 end.
     7203               end.
     7204             end.
     7205             else do:
     7206             end.
     7207             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     7208           end.
     7209         end.
     7210         else do:
     7211           do v-ii = 1 to 2:
     7212             entry(v-clu + (v-ii - 1) * 200, v-record, chr(4)) = v-maria-discnt-value.
     7213           end.
     7214         end.
     7215       end.
     7216     end.
     7217   END CASE .
     7218   END PROCEDURE .
     7219   PROCEDURE putc-dis-card-mask.
     7220   define parameter buffer buf_cash-desk for ub.cash-desk.
     7221   define input parameter p-pos-type as character no-undo.
     7222   define input parameter p-version as character no-undo .
     7223   end.
     7224   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7225   PROCEDURE   for-cash-cycle:
     7226   DEFINE VARIABLE fname-list as character no-undo .
     7227   DEFINE VARIABLE out-list as character no-undo .
     7228   DEFINE VARIABLE var-file-num as integer no-undo .
     7229   DEFINE VARIABLE v-dir-remote as character no-undo .
     7230   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     7231   define variable v-versiond as decimal no-undo .
     7232   define variable v-clu as character no-undo .
     7233   define variable v-dc-host-code like ub.sysconf.host-code no-undo .
     7234   define variable v-type              as character no-undo .
     7235   define buffer for-cash-desk for ub.cash-desk.
     7236   define buffer buf_cd-clu for ub.cd-clu.
     7237   FOR EACH for-cash-desk NO-LOCK WHERE
     7238           for-cash-desk.db-num = g#db-num AND
     7239           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     7240           for-cash-desk.obj-code = i-obj-code AND
     7241           for-cash-desk.cash-on  = yes
     7242   BREAK
     7243   BY for-cash-desk.db-num
     7244   BY for-cash-desk.obj-code
     7245   BY for-cash-desk.pos-type
     7246   BY for-cash-desk.cash-on
     7247   BY for-cash-desk.cash-num:
     7248      IF (LOOKUP(ub.cash-desk.pos-type,
     7249                 ('NCR-GM':U + chr(44) +
     7250                  'IBM-XML':U + chr(44) +
     7251                  'MAGIA-XML':U + chr(44) +
     7252                  'NCR-AS@R':U )) > 0
     7253        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     7254     if run-from = "E":U then NEXT.
     7255     if LOOKUP(ub.cash-desk.pos-type,
     7256               'MARIA':U
     7257                  ) > 0 then do:
     7258       if for-cash-desk.autonomy = integer('2':U) then do:
     7259         if v-del-mrkt-cli = no then next.
     7260         assign
     7261         v-cd-list-update = for-cash-desk.addr-path
     7262         v-cd-list-delete = for-cash-desk.addr-path
     7263         .
     7264         NEXT.
     7265       end.
     7266       else do:
     7267         if v-cd-list-update = '':U then nExt.
     7268       end.
     7269     end.
     7270     run write-log-and-file in p-log-handle (
     7271           input 1
     7272         , input log-file-name
     7273         , input 1
     7274         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     7275                           )
     7276                                           ).
     7277   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7278   case for-cash-desk.pos-type:
     7279       when 'IBM-XML':U or when 'Autotank':U
     7280     then do:
     7281   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7282   run xml-cd-filename in this-procedure (
     7283         input out
     7284       , output v-xml-file-name
     7285       , output v-xml-file-name-path
     7286       , output v-log-file-name
     7287       , output v-locked
     7288   ).
     7289   run write-log-and-file in p-log-handle (
     7290         input 1
     7291       , input log-file-name
     7292       , input 1
     7293       , input substitute( ("'Пересылка дисконтных карт/клиентов)'" + " &1")
     7294                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
