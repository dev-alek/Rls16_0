     6160     end.
     6161     if last-of(ub.dis-card-property.dt-code) then do:
     6162       cash-cli.has-attrs-lim = yes.
     6163     end.
     6164   end.
     6165       if dc-list.flog = yes then delete dc-list.
     6166       if ( ii  > cdpcknum)   and NOT alllstcs  then do:
     6167         if cr > 0 then do:
     6168           if g#news
     6169           or g#esys
     6170           then do:
     6171             FOR EACH for-shop NO-LOCK where
     6172                     for-shop.host-code = ub.shop.host-code,
     6173                 FIRST for-clients No-LOCK WHERE
     6174                       for-clients.obj-type = 'маг':U
     6175                   AND for-clients.obj-code = for-shop.obj-code
     6176                   AND for-clients.db-num = g#db-num:
     6177               FIND ub.sysconf WHERE
     6178                   ub.sysconf.host-code = ub.shop.host-code NO-LOCK.
     6179               assign
     6180               i-obj-code = for-shop.obj-code
     6181               .
     6182               RUN SENDING in this-procedure no-error.
     6183               if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6184             END.
     6185           end.
     6186           else
     6187           RUN SENDING in this-procedure no-error.
     6188           if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6189         end.
     6190         assign
     6191         start-paket = yes
     6192         cr = 0
     6193         ii = 0
     6194         .
     6195       end.
     6196     END.
     6197   end.
     6198   if (cr > 0 AND (g#news
     6199                   or g#esys
     6200                   or run-from = "S":U
     6201                   or run-from = "O":U
     6202                   or run-from = "E":U
     6203                   )
     6204      )
     6205   or
     6206      (NOT (g#news
     6207            or g#esys
     6208            OR run-from = "S"
     6209            or run-from = "O":U
     6210            or run-from = "E":U)
     6211            AND can-find(first cash-cli)
     6212       ) then do:
     6213     if (g#news or g#esys OR multiple-shops) then do:
     6214       FOR EACH for-shop NO-LOCK where for-shop.host-code = ub.shop.host-code,
     6215               FIRST for-clients No-LOCK WHERE
     6216                     for-clients.obj-type = 'маг':U AND
     6217                     for-clients.obj-code = for-shop.obj-code AND
     6218                     for-clients.db-num = g#db-num,
     6219         first buf_cash-desk no-lock where
     6220              buf_cash-desk.db-num = g#db-num
     6221          AND buf_cash-desk.obj-code = for-clients.obj-code
     6222          AND buf_cash-desk.cash-on = yes   :
     6223         FIND ub.sysconf WHERE
     6224             ub.sysconf.host-code = ub.shop.host-code NO-LOCK.
     6225         assign
     6226         i-obj-code = for-shop.obj-code
     6227         .
     6228         run write-log-and-file in p-log-handle (
     6229               input 1
     6230             , input log-file-name
     6231             , input 1
     6232             , input substitute("Пересылка на кассы &1&2 информации о дисконтных картах", 'маг':U, i-obj-code)
     6233                                                   ).
     6234         RUN SENDING in this-procedure no-error.
     6235         if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6236       END.
     6237     end.
     6238     else do:
     6239       run write-log-and-file in p-log-handle (
     6240                 input 1
     6241               , input log-file-name
     6242               , input 1
     6243               , input substitute("Пересылка на кассы &1&2 информации о дисконтных картах", 'маг':U, i-obj-code)
     6244                                                     ).
     6245       RUN SENDING in this-procedure no-error.
     6246       if error-status:error then do:                                                                            run write-log-and-file in p-log-handle (                                                                      input 1                                                                                               , input log-file-name                                                                                   , input 1                                                                                               , input substitute("&1 &2", error-status:get-message(1), return-value)                                                                      ).                                                              assign                                                                                                  v-view-log = yes                                                                                        .                                                                                                     end.
     6247     end.
     6248   end.
     6249   for each cash-cli:
     6250       delete cash-cli.
     6251   end.
     6252   if p-batch then do:
     6253     if v-view-log then
     6254     run set-view-log in p-log-handle(yes).
     6255   end.
     6256   else do:
     6257   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6258   if v-view-log
     6259   and not g#news
     6260   and not g#auto
     6261   then do:
     6262     message
     6263     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     6264     "!!!Внимательно прочитайте Log-file!!"
     6265     view-as alert-box error .
     6266        define variable v-user-action40   as character no-undo .
     6267     define variable v-printed40       as logical   no-undo .
     6268     run gbl/prnfilen.w
     6269       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     6270       ,input  0
     6271       ,input  (string("./":U) + log-file-name)
     6272       ,input  7
     6273       ,output v-user-action40
     6274       ,output v-printed40
     6275       ) .
     6276   end.
     6277   if v-view-log = true
     6278   and (g#news
     6279   or g#auto)
     6280   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     6281   then do:
     6282      run cb_set-view-log in p-parent-handle ( input yes).
     6283   end.
     6284   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     6285     OS-DELETE value(string("./":U) + log-file-name).
     6286   end.
     6287   end.
     6288   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6289   PROCEDURE putc-2.
     6290   define parameter buffer buf_cash-desk for ub.cash-desk.
     6291   define input parameter pos-type   as character no-undo.
     6292   define input parameter p-version  as character no-undo .
