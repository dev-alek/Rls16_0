     7501       if cash-cli.cli-code eq ?
     7502       then do:
     7503       end.
     7504       else if for-cash-desk.pos-type = 'MARIA':U then do:
     7505       end.
     7506       else do:
     7507         FIND FIRST ub.dis-card-type No-LOCK WHERE
     7508                     ub.dis-card-type.type = cash-cli.type and
     7509                     ub.dis-card-type.emitent-host-code = cash-cli.emitent-host-code AND
     7510                     ub.dis-card-type.host-code = 0 AND
     7511                     ub.dis-card-type.obj-type = "":U AND
     7512                     ub.dis-card-type.obj-code = 0 NO-ERROR.
     7513         if not avail ub.dis-card-type then NEXT _cash-cli.
     7514         if LOOKUP(string(i-obj-code), ub.dis-card-type.dcbyshop) > 0 AND (cash-cli.issue-code <> i-obj-code) then
     7515         NEXT _cash-cli.
     7516       end.
     7517       if first-of(for-cash-desk.obj-code) then do:
     7518         glog = dct-algo-get_dcproperty-value-chr (
     7519                                         input cash-cli.d-card
     7520                                       , input cash-cli.emitent-host-code
     7521                                       , input cash-cli.type
     7522                                       , input 0
     7523                                       , input '':U
     7524                                       , input 0
     7525                                       , output v-property-value-chr
     7526                                         ).
     7527         do v-ii = 1 to min(num-entries(v-property-value-chr), 4):
     7528           if entry(v-ii, v-property-value-chr)  <> chr(63) then do:
     7529             assign
     7530             cash-cli.property-value-chr[v-ii] = v-property-value-chr
     7531             .
     7532           end.
     7533           else do:
     7534             assign
     7535             cash-cli.property-value-chr[v-ii] = '':U
     7536             .
     7537           end.
     7538         end.
     7539       end.
     7540       RUN putc-2 in this-procedure (
     7541                    buffer for-cash-desk
     7542                   ,input for-cash-desk.pos-type
     7543                   ,input for-cash-desk.version
     7544                   ,input first-of(cash-cli.cli-code) ) no-error .
