     5927       cash-cli.cli-inn = trim(ub.person.inn)
     5928       cash-cli.cli-phone = trim(ub.person.phone1)
     5929       cash-cli.cli-ind = ub.person.ind
     5930       cash-cli.phone1  = trim(ub.person.phone1)
     5931       cash-cli.e-mail = trim( ub.person.e-mail )
     5932       cash-cli.fax     = trim( ub.person.fax)
     5933       cash-cli.position  = trim( ub.person.position)
     5934       cash-cli.is-pboul  = ub.person.is-pboul
     5935       cash-cli.okonh     = trim(ub.person.okonh)
     5936       cash-cli.okpo      = trim(ub.person.okpo)
     5937       cash-cli.post-box  = trim(ub.person.post-box)
     5938       cash-cli.justface = 0
     5939       cash-cli.kpp     = ub.person.kpp
     5940       .
     5941     end.
     5942     else do:
     5943       NEXT .
     5944     end.
     5945   end.
     5946   assign
     5947   cash-cli.mask-card     = ub.dis-card.mask-card
     5948   cash-cli.current-saldo =  (if ub.dis-card.credit-card = yes
     5949                               then (if v-curr-r-b = 'base':U
     5950                                     then ub.dis-card.saldo-base
     5951                                     else ub.dis-card.saldo-rubl)
     5952                               else 0)
     5953   cash-cli.current-saldo-rubl = ub.dis-card.saldo-rubl
