     6128   for each ub.dis-card-property no-lock where
     6129             ub.dis-card-property.dtm-code = 27
     6130        and  ub.dis-card-property.d-card = cash-cli.d-card
     6131        AND  ub.dis-card-property.HOST-CODE = 0
     6132        AND  ub.dis-card-property.obj-type = '':U
     6133        AND  ub.dis-card-property.obj-code = 0
     6134     break
