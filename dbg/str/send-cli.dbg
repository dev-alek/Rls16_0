     6109         assign
     6110         cash-cli-attr.dc-limit-l =  buf_dis-card-property.property-value-decimal   .
     6111       end.
     6112       when 6 then do:
     6113       end.
     6114       when 7 then do:
     6115       end.
     6116       when 9 then do:
