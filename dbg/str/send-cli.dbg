     2120                       when chr(4)
     2121                       then do:
     2122                           assign
     2123                               p-out-string = p-out-string + " ":U
     2124                           .
     2125                       end.
     2126                       when chr(5)
     2127                       then do:
     2128                           assign
     2129                               p-out-string = p-out-string + " ":U
     2130                           .
     2131                       end.
     2132                       when chr(6)
     2133                       then do:
     2134                           assign
     2135                               p-out-string = p-out-string + " ":U
     2136                           .
     2137                       end.
     2138                       when chr(7)
     2139                       then do:
     2140                           assign
     2141                               p-out-string = p-out-string + " ":U
     2142                           .
     2143                       end.
     2144                       when chr(8)
     2145                       then do:
     2146                           assign
     2147                               p-out-string = p-out-string + " ":U
     2148                           .
     2149                       end.
     2150                       when chr(9)
     2151                       then do:
     2152                           assign
     2153                               p-out-string = p-out-string + " ":U
     2154                           .
     2155                       end.
     2156                       when chr(29)
     2157                       then do:
     2158                           assign
     2159                               p-out-string = p-out-string + " ":U
     2160                           .
     2161                       end.
     2162                       when chr(10)
     2163                       then do:
     2164                           assign
     2165                               p-out-string = p-out-string + " ":U
     2166                           .
     2167                       end.
     2168                       when chr(13)
     2169                       then do:
     2170                           assign
     2171                               p-out-string = p-out-string + " ":U
     2172                           .
     2173                       end.
     2174                       otherwise do:
     2175                           assign
     2176                               p-out-string = p-out-string + v-current-char
     2177                           .
     2178                       end.
     2179                   end case.
     2180               end.
     2181           end.
     2182       end case.
     2183   end.
     2184   end .
     2185   procedure xmlchar-decode :
     2186   define input parameter p-in-string      as character        no-undo.
     2187   define output parameter p-out-string    as character        no-undo.
     2188       define variable v-position      as integer      no-undo.
     2189       define variable v-last-position as integer      no-undo.
     2190       define variable v-temp-integer  as integer      no-undo.
     2191       define variable v-current-char  as character    no-undo.
     2192       define variable v-next-char     as character    no-undo.
     2193       define variable v-success       as logical      no-undo.
     2194   do
     2195   on error undo, return error
     2196   :
     2197       assign
     2198           p-out-string = "":U
     2199           v-position   = 0
     2200       .
     2201       replace-cycle:
     2202       do while yes
     2203       on error undo, return error
     2204       :
     2205           assign
     2206               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2207           .
     2208           if v-last-position <= v-position
     2209           then do:
     2210               if v-position = 0
     2211               then do:
     2212                   assign
     2213                       p-out-string = p-in-string
     2214                   .
     2215               end.
     2216               else do:
     2217                   assign
     2218                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2219                   .
     2220               end.
     2221               leave replace-cycle.
     2222           end.
     2223           else do:
     2224               assign
     2225                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2226                   v-position      = v-last-position
     2227                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2228               .
     2229               if v-current-char = "#":U
     2230               then do:
     2231                   assign
     2232                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2233                   .
     2234                   if v-last-position > 0
     2235                   then do:
     2236                       run xmlchar-read-integer in this-procedure
     2237                        (
     2238                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2239                           , output v-temp-integer
     2240                           , output v-success
     2241                       ).
     2242                       if v-success = yes
     2243                       and v-temp-integer >= 1
     2244                       and v-temp-integer <= 255
     2245                       then do:
     2246                           assign
     2247                               p-out-string = p-out-string + chr( v-temp-integer )
     2248                               v-position   = v-last-position + 1
     2249                           .
     2250                       end.
     2251                       else do:
     2252                           assign
     2253                               p-out-string = p-out-string + "&":U
     2254                               v-position   = v-position   + 1
     2255                           .
     2256                       end.
     2257                   end.
     2258                   else do:
     2259                       assign
     2260                           p-out-string = p-out-string + "&":U
     2261                           v-position   = v-position   + 1
     2262                       .
     2263                   end.
     2264               end.
     2265               else do:
     2266                   case substring( p-in-string, v-position + 1, 3 )
     2267                   :
     2268                       when "lt;":U
     2269                       then do:
     2270                           assign
     2271                               p-out-string = p-out-string + "<":U
     2272                               v-position   = v-position   + 3
     2273                           .
     2274                       end.
     2275                       when "gt;":U
     2276                       then do:
     2277                           assign
     2278                               p-out-string = p-out-string + ">":U
     2279                               v-position   = v-position   + 3
     2280                           .
     2281                       end.
     2282                       otherwise do:
     2283                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2284                           then do:
     2285                               assign
     2286                                   p-out-string = p-out-string + "&":U
     2287                                   v-position   = v-position   + 4
     2288                               .
     2289                           end.
     2290                           else do:
     2291                               case substring( p-in-string, v-position + 1, 5 )
     2292                               :
     2293                                   when "quot;":U
     2294                                   then do:
     2295                                       assign
     2296                                           p-out-string = p-out-string + '"':U
     2297                                           v-position   = v-position   + 5
     2298                                       .
     2299                                   end.
     2300                                   when "apos;":U
     2301                                   then do:
     2302                                       assign
     2303                                           p-out-string = p-out-string + "'":U
     2304                                           v-position   = v-position   + 5
     2305                                       .
     2306                                   end.
     2307                                   otherwise do:
     2308                                       assign
     2309                                           p-out-string = p-out-string + "&":U
     2310                                       .
     2311                                   end.
     2312                               end case.
     2313                           end.
     2314                       end.
     2315                   end case.
     2316               end.
     2317           end.
     2318       end.
     2319   end.
     2320   end .
     2321   procedure xmlchar-read-integer :
     2322   define input parameter p-input-string      as character        no-undo.
     2323   define output parameter p-output-integer   as integer          no-undo.
     2324   define output parameter p-success       as logical          no-undo.
     2325   do
     2326   on error undo, return error
     2327   :
     2328       assign
     2329           p-output-integer = integer( p-input-string )
     2330       no-error.
     2331       if error-status :error
     2332       then do:
     2333           assign
     2334               p-success           = no
     2335               p-output-integer    = 0
     2336           .
     2337       end.
     2338       else do:
     2339           assign
     2340               p-success           = yes
     2341           .
     2342       end.
     2343   end.
     2344   end.
     2345   define variable v-bgelib-bgeclall           as logical      no-undo.
     2346   define variable v-bgelib-bgedict            as logical      no-undo.
     2347   define temp-table temp_ext-doc-type no-undo
     2348       field edt-key               as integer
     2349       field ext-doc-type          as character
     2350       field ext-doc-type-label    as character
     2351       index pi is primary unique
     2352           edt-key
     2353   .
     2354   define temp-table temp_bgelib_goods no-undo
     2355       field gds-code as integer
     2356       index pi is primary unique
     2357           gds-code
     2358   .
     2359   define temp-table temp_bgelib_clients no-undo
     2360       field obj-type as character
     2361       field obj-code as integer
     2362       index pi is primary unique
     2363           obj-type
     2364           obj-code
     2365   .
     2366   define temp-table temp_bgelib_dis-card no-undo
