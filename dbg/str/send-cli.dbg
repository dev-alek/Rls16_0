     5979                           else no)
     5980   cash-cli.pay-code = ub.dis-card-type.pay-code
     5981   cash-cli.mixed-pay =  ub.dis-card-type.mixed-pay
     5982   cash-cli.sourced-card = ub.dis-card.sourced-card
     5983   cash-cli.valid-date  = (if ub.dis-card.valid-date <> ?
     5984                           then ub.dis-card.valid-date
     5985                           else cash-cli.valid-date)
     5986   .
     5987   if cash-cli.card-media = integer('5':U) then do:
     5988     find first buf_Dis-card-property no-lock where
     5989               buf_Dis-card-property.d-card = cash-cli.d-card
     5990          and buf_Dis-card-property.dtm-code = integer(25)
     5991          and buf_Dis-card-property.node-code = integer(4)
     5992          and buf_Dis-card-property.host-code = 0
     5993          and buf_Dis-card-property.obj-type = ''
     5994          and buf_Dis-card-property.obj-code = 0 no-error.
     5995     if available buf_dis-card-property then
     5996     cash-cli.ef-access-key = buf_Dis-card-property.property-value-character.
     5997     find first buf_Dis-card-property no-lock where
     5998               buf_Dis-card-property.d-card = cash-cli.d-card
     5999          and buf_Dis-card-property.dtm-code = integer(25)
     6000          and buf_Dis-card-property.node-code = integer(3)
     6001          and buf_Dis-card-property.host-code = 0
     6002          and buf_Dis-card-property.obj-type = ''
     6003          and buf_Dis-card-property.obj-code = 0 no-error.
     6004     if available buf_dis-card-property then
     6005     cash-cli.ef-format = buf_Dis-card-property.property-value-integer.
     6006   end.
     6007   CASE ub.dis-card-type.cardname-sent:
