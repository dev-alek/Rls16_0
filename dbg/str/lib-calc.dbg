     1242   end.
     1243   procedure lib-calc_clcrdtax:
     1244   define input  parameter pargds-code      like ub.goods.gds-code         no-undo.
     1245   define input  parameter parext-gds-type  as   character                 no-undo.
     1246   define input  parameter parcli-base-rate like ub.doc-line.cli-base-rate no-undo.
     1247   define input  parameter pardoc-qnty      like ub.doc-line.doc-qnty      no-undo.
     1248   define input  parameter pardensity       like ub.doc-line.doc-density   no-undo.
     1249   define input  parameter parroad-tax-cli  like ub.doc-line.road-tax      no-undo.
     1250   define input  parameter parbase-rate     like ub.trn-doc.base-rate      no-undo.
     1251   define input  parameter parbase-scale    like ub.trn-doc.base-scale     no-undo.
     1252   define input  parameter parexch-rate     like ub.trn-doc.base-rate      no-undo.
     1253   define input  parameter parexch-scale    like ub.trn-doc.base-scale     no-undo.
     1254   define output parameter parroad-tax      like ub.doc-line.road-tax      no-undo.
     1255   define variable varr-b as character no-undo.
     1256   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1258     (output varr-b
     1259     )  .
     1260   define buffer bf_goods for ub.goods.
     1261   find first bf_goods where bf_goods.gds-code = pargds-code no-lock.
     1262   if not hvrdtax (recid(bf_goods)) then return error "Для данного типа товара: " + parext-gds-type + " пересчет налога 3.".
     1263   case parext-gds-type:
     1264   when 'bg':U then do:
     1265     if varr-b = "rubl":u then do:
     1266       assign parroad-tax = parroad-tax-cli
     1267              * parexch-rate / parexch-scale.
     1268     end.
     1269     else do:
     1270       assign parroad-tax = parroad-tax-cli
     1271                / parbase-rate * parbase-scale
     1272              * parexch-rate / parexch-scale.
     1273     end.
     1274   end.
     1275   when 'pp':U then do:
     1276     if varr-b = "rubl":u then do:
     1277       assign parroad-tax = parroad-tax-cli
     1278              * parexch-rate / parexch-scale
     1279              / parcli-base-rate.
     1280     end.
     1281     else do:
     1282       assign parroad-tax = parroad-tax-cli
     1283                / parbase-rate * parbase-scale
     1284              * parexch-rate / parexch-scale
     1285              / parcli-base-rate.
     1286     end.
     1287   end.
     1288   when 'lp':U then do:
     1289     if varr-b = "rubl":u then do:
     1290       assign parroad-tax = parroad-tax-cli
     1291              * parexch-rate / parexch-scale
     1292              * (round(pardoc-qnty * pardensity, 0) / pardoc-qnty).
     1293     end.
     1294     else do:
     1295       assign parroad-tax = parroad-tax-cli
     1296              / parbase-rate * parbase-scale
     1297              * parexch-rate / parexch-scale
     1298              * (round(pardoc-qnty * pardensity, 0) / pardoc-qnty).
     1299     end.
     1300   end.
     1301   when 'kp':U then do:
     1302     if varr-b = "rubl":u then do:
     1303       assign parroad-tax = parroad-tax-cli
     1304              * parexch-rate / parexch-scale
     1305              * pardensity.
     1306     end.
     1307     else do:
     1308       assign parroad-tax = parroad-tax-cli
     1309              / parbase-rate * parbase-scale
     1310              * parexch-rate / parexch-scale
     1311              * pardensity.
     1312     end.
     1313   end.
     1314   otherwise do:
     1315      return error "Для данного типа товара: " + parext-gds-type + " пересчет налога 3.".
     1316   end.
     1317   end case.
     1318   end procedure.
     1319   procedure lib-calc_clcdocqt:
     1320   define input  parameter parext-gds-type  as   character                 no-undo.
     1321   define input  parameter parcli-qnty      like ub.doc-line.cli-qnty      no-undo.
     1322   define input  parameter parcli-base-rate like ub.doc-line.cli-base-rate no-undo.
     1323   define input  parameter pardensity       like ub.doc-line.doc-density       no-undo.
     1324   define output parameter pardoc-qnty      like ub.doc-line.doc-qnty      no-undo.
     1325   case parext-gds-type:
     1326     when 'og':U     or
     1327     when 'os':U then do:
     1328        assign pardoc-qnty = parcli-qnty * parcli-base-rate.
     1329     end.
     1330     when 'sg':U then do:
     1331     end.
     1332     when 'bg':U then do:
     1333        assign pardoc-qnty = parcli-qnty.
     1334     end.
     1335     when 'kp':U then do:
     1336        assign pardoc-qnty = parcli-qnty / pardensity.
     1337     end.
     1338     otherwise do:
     1339        return error "Для данного типа товара: " + parext-gds-type + " пересчет количества в базовых единицах недопустим.".
     1340     end.
     1341   end case.
     1342   end procedure.
     1343   procedure lib-calc_clccliqt:
     1344   define input  parameter parext-gds-type  as   character                 no-undo.
     1345   define input  parameter pardoc-qnty      like ub.doc-line.doc-qnty      no-undo.
     1346   define input  parameter parcli-base-rate like ub.doc-line.cli-base-rate no-undo.
     1347   define input  parameter pardensity       like ub.doc-line.doc-density       no-undo.
     1348   define input  parameter parround         as   integer                   no-undo.
     1349   define output parameter parcli-qnty      like ub.doc-line.cli-qnty      no-undo.
     1350   case parext-gds-type:
     1351     when 'sg':U then do:
     1352     end.
     1353     when 'pp':U then do:
     1354        assign  parcli-qnty = pardoc-qnty / parcli-base-rate.
     1355     end.
     1356     when 'lp':U then do:
     1357        assign parcli-qnty = pardoc-qnty * pardensity .
     1358     end.
     1359     otherwise do:
     1360        return error "Для данного типа товара: " + parext-gds-type + " пересчет кол-ва по ТТН недопустим.".
     1361     end.
     1362   end case.
     1363   end.
     1364   procedure lib-calc_clcdens:
     1365   define input  parameter parext-gds-type  as   character                 no-undo.
     1366   define input  parameter parcli-qnty      like ub.doc-line.cli-qnty      no-undo.
     1367   define input  parameter pardoc-qnty      like ub.doc-line.doc-qnty      no-undo.
     1368   define output parameter pardensity       like ub.doc-line.doc-density   no-undo.
     1369   case parext-gds-type:
     1370     when 'lp':U
     1371     or when 'kp':U then do:
     1372        assign pardensity = parcli-qnty / pardoc-qnty .
     1373     end.
     1374     otherwise do:
     1375        return error "Для данного типа товара: " + parext-gds-type + " пересчет плотности недопустим.".
     1376     end.
     1377   end case.
     1378   end.
     1379   procedure lib-calc_clcclirt:
     1380   define input  parameter parext-gds-type  as   character                 no-undo.
     1381   define input  parameter parcli-qnty      like ub.doc-line.cli-qnty      no-undo.
     1382   define input  parameter pardoc-qnty      like ub.doc-line.doc-qnty      no-undo.
     1383   define input  parameter pardensity       like ub.doc-line.doc-density       no-undo.
     1384   define input  parameter parround         as   integer                   no-undo.
     1385   define output parameter parcli-base-rate like ub.doc-line.cli-base-rate no-undo.
     1386   case parext-gds-type:
     1387     when 'sg':U then do:
     1388        assign parcli-base-rate = 1.
     1389     end.
     1390     when 'bg':U then do:
     1391        assign parcli-base-rate = 1.
     1392     end.
     1393     when 'gg':U then do:
     1394        assign parcli-base-rate = pardoc-qnty / parcli-qnty .
     1395        if parcli-base-rate  = ? then parcli-base-rate = 1.
     1396     end.
     1397     when 'lp':U then do:
     1398        assign parcli-base-rate = 1 / pardensity .
     1399     end.
     1400     when 'kp':U then do:
     1401        assign parcli-base-rate = 1 / pardensity.
     1402     end.
     1403     otherwise do:
     1404        return error "Для данного типа товара: " + parext-gds-type + " пересчет коэф-та поставщика недопустим.".
     1405     end.
     1406   end case.
     1407   end procedure.
     1408   procedure lib-calc_kndinpin:
     1409   define input  parameter pargds-code            like ub.goods.gds-code        no-undo.
     1410   define input  parameter parcli-type            like ub.clients.obj-type      no-undo.
     1411   define input  parameter parcli-code            like ub.clients.obj-code      no-undo.
     1412   define input  parameter parobj-type            like ub.clients.obj-type      no-undo.
     1413   define input  parameter parobj-code            like ub.clients.obj-code      no-undo.
     1414   define output parameter parext-gds-type        as   character      initial ? no-undo.
     1415   define output parameter parcli-qnty-input      as   logical        initial ? no-undo.
     1416   define output parameter pardensity-input       as   logical        initial ? no-undo.
     1417   define output parameter parcli-base-rate-input as   logical        initial ? no-undo.
     1418   define output parameter pardoc-qnty-input      as   logical        initial ? no-undo.
     1419   define output parameter parfact-qnty-input     as   logical        initial ? no-undo.
     1420   define output parameter parprice-cli-input     as   logical        initial ? no-undo.
     1421   define output parameter parbase-price-input    as   logical        initial ? no-undo.
     1422   define output parameter partax-3-input         as   logical        initial ? no-undo.
     1423   define output parameter parcli-qnty-calc       as   character      initial ? no-undo.
     1424   define output parameter pardensity-calc        as   character      initial ? no-undo.
     1425   define output parameter parcli-base-rate-calc  as   character      initial ? no-undo.
     1426   define output parameter pardoc-qnty-calc       as   character      initial ? no-undo.
     1427   define output parameter parfact-qnty-calc      as   character      initial ? no-undo.
     1428   define output parameter parprice-cli-calc      as   character      initial ? no-undo.
     1429   define output parameter parbase-price-calc     as   character      initial ? no-undo.
     1430   define output parameter partax-3-calc          as   character      initial ? no-undo.
     1431   define output parameter parround               as   integer        initial ? no-undo.
     1432   define variable varis-petrolium as logical             no-undo.
     1433   define variable varis-pieces    as logical             no-undo.
     1434   define variable varhvrdtax      as logical             no-undo.
     1435   define variable varupd-fact-qnty as logical   no-undo initial yes.
     1436   define variable varrevision      as logical   no-undo initial no.
     1437   define variable varpercrev       as decimal   no-undo initial ?.
     1438   define variable varauto-tank     as logical   no-undo initial no.
     1439   define variable varpercauto      as decimal   no-undo initial ?.
     1440   define variable varinv           as logical   no-undo initial no.
     1441   define variable varpercinv       as decimal   no-undo initial ?.
     1442   define variable varinv-set       as logical   no-undo initial no.
     1443   define variable stfactplvalue    as character no-undo initial ?.
     1444   define variable stfactpltype     as character no-undo initial ?.
     1445   define variable varvalue         as character no-undo initial ?.
     1446   define variable vartype          as character no-undo initial ?.
     1447   define buffer bf_goods        for ub.goods.
     1448   define buffer bf_units        for ub.units.
     1449   define buffer bf_clients-attr for ub.clients-attr.
     1450   find first bf_goods where bf_goods.gds-code = pargds-code no-lock no-error.
     1451   if not available bf_goods then do:
     1452      return error "Не найден товар с внутренним кодом " + string(pargds-code) + " .".
     1453   end.
     1454   find first bf_units where bf_units.unit-name = bf_goods.unit-base no-lock.
     1455   if hvrdtax (recid(bf_goods)) then assign varhvrdtax = yes.
     1456                                else assign varhvrdtax = no.
     1457   if cross-list(bf_units.type, 'сте':U, ?) then do:
     1458      if bf_goods.cli-base-rate <> 1 then
     1459         return error "Неверно заведен товар стеклопосуда. Коэффициент поставщика: " + string(bf_goods.cli-base-rate) + " .".
     1460      if bf_goods.unit-base <> bf_goods.unit-cli then
     1461         return error "Неверно заведен товар стеклопосуда. Базовая единица: " + bf_goods.unit-base + " не равна единице поставщика " +  bf_goods.unit-cli + " .".
     1462      assign
     1463        parext-gds-type         = 'bg':U
     1464        parcli-qnty-input       = yes
     1465        pardensity-input        = no
     1466        parcli-base-rate-input  = no
     1467        pardoc-qnty-input       = no
     1468        parfact-qnty-input      = yes
     1469        parprice-cli-input      = yes
     1470        parbase-price-input     = no
     1471        partax-3-input          = varhvrdtax
     1472        parcli-qnty-calc        = "doc-qnty":U
     1473        pardensity-calc         = ""
     1474        parcli-base-rate-calc   = ""
     1475        pardoc-qnty-calc        = ""
     1476        parfact-qnty-calc       = ""
     1477        parprice-cli-calc       = "acc-price":U
     1478        parbase-price-calc      = ""
     1479        partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "").
     1480   end.
     1481   else do:
     1482      if cross-list(bf_units.type, '2ед':U, ?) then do:
     1483         assign
     1484           parext-gds-type         = 'gg':U
     1485           parcli-qnty-input       = yes
     1486           pardensity-input        = no
     1487           parcli-base-rate-input  = no
     1488           pardoc-qnty-input       = yes
     1489           parfact-qnty-input      = yes
     1490           parprice-cli-input      = no
     1491           parbase-price-input     = yes
     1492           partax-3-input          = no
     1493           parcli-qnty-calc        = "cli-base-rate,cli-price":U
     1494           pardensity-calc         = ""
     1495           parcli-base-rate-calc   = ""
     1496           pardoc-qnty-calc        = "cli-base-rate,cli-price":U
     1497           parfact-qnty-calc       = ""
     1498           parprice-cli-calc       = ""
     1499           parbase-price-calc      = "cli-price":U
     1500           partax-3-calc           = "".
     1501      end.
     1502      else do:
     1503   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1504     (
     1505        input bf_goods.artic
     1506     ,  input bf_goods.prod-type
     1507     ,  input bf_goods.prod-code
     1508     , output varis-petrolium
     1509     , output varis-pieces
     1510     ) no-error.
     1511         if error-status :error then return error "Ошибка при вызове процедуры is-petrl "
     1512                                   + return-value + error-status :get-message( 1 ) + error-status :get-message( 2 ) + " .".
     1513         if varis-petrolium then do:
     1514            if varis-pieces then do:
     1515               assign
     1516                   parext-gds-type         = 'pp':U
     1517                   parcli-qnty-input       = no
     1518                   pardensity-input        = no
     1519                   parcli-base-rate-input  = yes
     1520                   pardoc-qnty-input       = yes
     1521                   parfact-qnty-input      = yes
     1522                   parprice-cli-input      = no
     1523                   parbase-price-input     = yes
     1524                   partax-3-input          = varhvrdtax
     1525                   parcli-qnty-calc        = ""
     1526                   pardensity-calc         = ""
     1527                   parcli-base-rate-calc   = "cli-qnty,cli-price":U
     1528                   pardoc-qnty-calc        = "cli-qnty":U
     1529                   parfact-qnty-calc       = ""
     1530                   parprice-cli-calc       = ""
     1531                   parbase-price-calc      = "cli-price":U
     1532                   partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "").
     1533            end.
     1534            else do:
     1535   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   run get-ptrl-prop in this-procedure
     1537     ( input parobj-type
     1538     , input parobj-code
     1539     ) .
     1540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1541     (input  'stfactpl'
     1542     ,input  ''
     1543     ,input  ''
     1544     ,input  0
     1545     ,input  ''
     1546     ,input  ''
     1547     ,input  ''
     1548     ,input  no
     1549     ,output stfactplvalue
     1550     ,output stfactpltype
     1551     ) no-error .
     1552               if stfactplvalue <> "":U then do:
     1553   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
     1554     (  input stfactplvalue
     1555     , output varupd-fact-qnty
     1556     , output varrevision
     1557     , output varpercrev
     1558     , output varauto-tank
     1559     , output varpercauto
     1560     , output varinv
     1561     , output varpercinv
     1562     , output varinv-set
     1563     )  .
     1564               end.
     1565               find first bf_clients-attr where
     1566                          bf_clients-attr.obj-type   = parcli-type      and
     1567                          bf_clients-attr.obj-code   = parcli-code      and
     1568                          bf_clients-attr.attr-code  = 'shftrep2':U and
     1569                          bf_clients-attr.attr-value = "yes":U          no-lock no-error.
     1570               if available bf_clients-attr then do:
     1571                 if ptrlprop-expptrl = 'weight':U then do:
     1572                   assign
     1573                     ptrlprop-inpptrl = 'weight':U
     1574                   .
     1575                 end.
     1576                 else do:
     1577                   assign
     1578                     ptrlprop-inpptrl = 'volume':U
     1579                   .
     1580                 end.
     1581               end.
     1582               run gds-attr-value in this-procedure
     1583                 (  input pargds-code
     1584                 ,  input 'fuel-type':U
     1585                 , output varvalue
     1586                 , output vartype
     1587                 ) no-error .
     1588              case varvalue:
     1589                when 'lgas' then do:
     1590                   ptrlprop-inpptrl = 'weight':U.
     1591                end.
     1592                when 'metan' then do:
     1593                   ptrlprop-inpptrl = 'volume':U.
     1594                end.
     1595              end.
     1596               if lookup( ptrlprop-inpptrl, "weight,weight+":U ) > 0 then do:
     1597                 assign
     1598                   parext-gds-type         = 'kp':U
     1599                   parcli-qnty-input       = yes
     1600                   parcli-base-rate-input  = no
     1601                   parfact-qnty-input      = varupd-fact-qnty
     1602                   parprice-cli-input      = yes
     1603                   parbase-price-input     = no
     1604                   partax-3-input          = varhvrdtax
     1605                   parcli-base-rate-calc   = ""
     1606                   parfact-qnty-calc       = "":U
     1607                   parprice-cli-calc       = "acc-price":U
     1608                   parbase-price-calc      = ""
     1609                   partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "")
     1610                 .
     1611                 if ptrlprop-inpptrl = 'weight+':U
     1612                   and bf_goods.unit-base <> bf_goods.unit-cli
     1613                 then do:
     1614                   assign
     1615                     pardensity-input        = no
     1616                     pardoc-qnty-input       = (if bf_goods.unit-base <> bf_goods.unit-cli then true else false)
     1617                     parcli-qnty-calc        = "density,cli-base-rate,acc-price":U
     1618                     pardensity-calc         = "":U
     1619                     pardoc-qnty-calc        = "density,cli-base-rate,acc-price":U
     1620                   .
     1621                 end.
     1622                 else do:
     1623                   assign
     1624                     pardensity-input        = (if bf_goods.unit-base <> bf_goods.unit-cli then true else false)
     1625                     pardoc-qnty-input       = no
     1626                     parcli-qnty-calc        = "doc-qnty,acc-price":U
     1627                     pardensity-calc         = "cli-base-rate,doc-qnty,acc-price":U
     1628                     pardoc-qnty-calc        = "":U
     1629                   .
     1630                 end.
     1631               end.
     1632               else do:
     1633                 assign
     1634                   parext-gds-type         = 'lp':U
     1635                   parcli-base-rate-input  = no
     1636                   pardoc-qnty-input       = yes
     1637                   parfact-qnty-input      = varupd-fact-qnty
     1638                   parprice-cli-input      = no
     1639                   parbase-price-input     = yes
     1640                   partax-3-input          = varhvrdtax
     1641                   parcli-base-rate-calc   = ""
     1642                   parfact-qnty-calc       = ""
     1643                   parprice-cli-calc       = "":U
     1644                   parbase-price-calc      = "cli-price":U
     1645                   partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "")
     1646                 .
     1647                 if ptrlprop-inpptrl = 'volume+':U
     1648                   and bf_goods.unit-base <> bf_goods.unit-cli
     1649                 then do:
     1650                   assign
     1651                     pardensity-input        = no
     1652                     parcli-qnty-input       = (if bf_goods.unit-base <> bf_goods.unit-cli then true else false)
     1653                     parcli-qnty-calc        = "density,cli-base-rate,acc-price":U
     1654                     pardensity-calc         = "":U
     1655                     pardoc-qnty-calc        = "density,cli-base-rate,acc-price":U
     1656                   .
     1657                 end.
     1658                 else do:
     1659                   assign
     1660                     pardensity-input        = (if bf_goods.unit-base <> bf_goods.unit-cli then true else false)
     1661                     parcli-qnty-input       = no
     1662                     parcli-qnty-calc        = ""
     1663                     pardensity-calc         = "cli-qnty,cli-base-rate,acc-price":U
     1664                     pardoc-qnty-calc        = "cli-qnty,cli-base-rate,acc-price":U
     1665                   .
     1666                 end.
     1667               end.
     1668            end.
     1669         end.
     1670         else do:
     1671             if LOOKUP('сер':U, bf_units.type) > 0 then do:
     1672                assign
     1673                  parext-gds-type         = 'sg':U
     1674                  parcli-qnty-input       = no
     1675                  pardensity-input        = no
     1676                  parcli-base-rate-input  = no
     1677                  pardoc-qnty-input       = no
     1678                  parfact-qnty-input      = no
     1679                  parprice-cli-input      = yes
     1680                  parbase-price-input     = no
     1681                  partax-3-input          = varhvrdtax
     1682                  parcli-qnty-calc        = ""
     1683                  pardensity-calc         = ""
     1684                  parcli-base-rate-calc   = ""
     1685                  pardoc-qnty-calc        = ""
     1686                  parfact-qnty-calc       = ""
     1687                  parprice-cli-calc       = "acc-price":U
     1688                  parbase-price-calc      = ""
     1689                  partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "").
     1690             end.
     1691             else do:
     1692                assign
     1693                  parext-gds-type         = (if bf_goods.gds-type = 'у':U then 'os':U else 'og':U)
     1694                  parcli-qnty-input       = yes
     1695                  pardensity-input        = no
     1696                  parcli-base-rate-input  = yes
     1697                  pardoc-qnty-input       = no
     1698                  parfact-qnty-input      = yes
     1699                  parprice-cli-input      = yes
     1700                  parbase-price-input     = no
     1701                  partax-3-input          = varhvrdtax
     1702                  parcli-qnty-calc        = "doc-qnty":U
     1703                  pardensity-calc         = ""
     1704                  parcli-base-rate-calc   = "doc-qnty,acc-price":U
     1705                  pardoc-qnty-calc        = ""
     1706                  parfact-qnty-calc       = ""
     1707                  parprice-cli-calc       = "acc-price":U
     1708                  parbase-price-calc      = ""
     1709                  partax-3-calc           = (if varhvrdtax then "road-tax,acc-price":U else "").
     1710             end.
     1711         end.
     1712      end.
     1713   end.
     1714   end.
     1715   procedure lib-calc_stfactqt :
     1716     define input        parameter parstfactpl          as   character              no-undo .
     1717     define input        parameter pardoc-qnty          like ub.doc-line.doc-qnty   no-undo .
     1718     define input        parameter pardensity           like ub.doc-line.doc-density    no-undo .
     1719     define input        parameter parrvs-before-qnty   like ub.doc-line.fact-qnty  no-undo .
     1720     define input        parameter parrvs-after-qnty    like ub.doc-line.fact-qnty  no-undo .
     1721     define input        parameter parauto-tank-qnty    like ub.doc-line.fact-qnty  no-undo .
     1722     define input        parameter parauto-tank-density like ub.doc-line.fact-density    no-undo .
     1723     define input        parameter parcheck-place       as   logical                no-undo .
     1724     define input-output parameter parfact-qnty         like ub.doc-line.fact-qnty  no-undo .
     1725     define       output parameter parchg               as   logical                no-undo .
     1726     define       output parameter parst-doc            as   logical                no-undo .
     1727     define variable varupdate    as logical no-undo initial yes .
     1728     define variable varrevision  as logical no-undo initial no  .
     1729     define variable varpercrev   as decimal no-undo initial ?   .
     1730     define variable varauto-tank as logical no-undo initial no  .
     1731     define variable varpercauto  as decimal no-undo initial ?   .
     1732     define variable varinv       as logical no-undo initial no  .
     1733     define variable varpercinv   as decimal no-undo initial ?   .
     1734     define variable varinv-set   as logical no-undo initial no  .
     1735     define variable vardelta     as decimal no-undo .
     1736     define variable varnewqt     as decimal no-undo .
     1737     define variable varoldqt     as decimal no-undo .
     1738     do
     1739     on error undo, return error return-value
     1740     :
     1741       if parstfactpl = ""
     1742       then do:
     1743         return .
     1744       end.
     1745   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
     1746     (  input parstfactpl
     1747     , output varupdate
     1748     , output varrevision
     1749     , output varpercrev
     1750     , output varauto-tank
     1751     , output varpercauto
     1752     , output varinv
     1753     , output varpercinv
     1754     , output varinv-set
     1755     ) no-error .
     1756       if error-status :error then do:
     1757         return error substitute( "Ошибка при проверке параметра stfactpl : &1"
     1758                                , return-value
     1759                                ) .
     1760       end.
     1761       assign
     1762         parchg    = no
     1763         parst-doc = no
     1764       .
     1765       if varupdate <> true
     1766         and varrevision <> true
     1767         and varauto-tank <> true
     1768       then do:
     1769         assign
     1770           parfact-qnty = pardoc-qnty
     1771           parst-doc    = true
     1772         .
     1773       end.
     1774       else do:
     1775         if varrevision  = true
     1776         then do:
     1777           assign
     1778             vardelta = pardoc-qnty * varpercrev * 0.01
     1779             varnewqt = parrvs-after-qnty - parrvs-before-qnty
     1780           .
     1781           if varpercrev = 0.00 or
     1782                   pardoc-qnty - varnewqt   > vardelta or
     1783              abs( pardoc-qnty - varnewqt ) > vardelta and parcheck-place = yes
     1784           then do:
     1785             if varnewqt < 0
     1786             then do:
     1787               return error substitute( "Неверное количество по сверкам: &1. Количество должно быть больше 0."
     1788                                      , varnewqt
     1789                                      ) .
     1790             end.
     1791             assign
     1792               parfact-qnty = varnewqt
     1793               parchg       = yes
     1794             .
     1795           end.
     1796           else do:
     1797             if varupdate      <> yes or
     1798                parcheck-place  = yes
     1799             then do:
     1800               assign
     1801                 parfact-qnty = pardoc-qnty
     1802                 parst-doc    = yes
     1803               .
     1804             end.
     1805           end.
     1806         end.
     1807         if varauto-tank = yes
     1808         then do:
     1809           assign
     1810             varoldqt = pardoc-qnty * pardensity
     1811             vardelta = varoldqt * varpercauto * 0.01
     1812             varnewqt = parauto-tank-qnty * parauto-tank-density
     1813           .
     1814           if varpercauto = 0.00 or
     1815                   varoldqt - varnewqt   > vardelta or
     1816              abs( varoldqt - varnewqt ) > vardelta and parcheck-place = yes
     1817           then do:
     1818             assign
     1819               parfact-qnty = parauto-tank-qnty
     1820               parchg       = yes
     1821             .
     1822           end.
     1823           else do:
     1824             if varupdate <> yes
     1825             then do:
     1826               assign
     1827                 parfact-qnty = pardoc-qnty
     1828                 parst-doc    = yes
     1829               .
     1830             end.
     1831           end.
     1832         end.
     1833       end.
     1834     end.
     1835   end procedure.
     1836   procedure lib-calc_chkqtpl :
     1837     define  input parameter p-stfactpl  as character no-undo.
     1838     define output parameter p-update    as logical   no-undo initial true.
     1839     define output parameter p-revision  as logical   no-undo initial false.
     1840     define output parameter p-percrev   as decimal   no-undo initial ?.
     1841     define output parameter p-auto-tank as logical   no-undo initial false.
     1842     define output parameter p-percauto  as decimal   no-undo initial ?.
     1843     define output parameter p-inv       as logical   no-undo initial false.
     1844     define output parameter p-percinv   as decimal   no-undo initial ?.
     1845     define output parameter p-inv-set   as logical   no-undo initial false.
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       define variable v-count    as integer no-undo.
     1850       define variable v-num      as integer no-undo.
     1851       define variable v-cnt-true as integer   no-undo .
     1852       assign
     1853         v-num      = num-entries( p-stfactpl, ";" )
     1854         v-cnt-true = 0
     1855       .
     1856       do v-count = 1 to v-num :
     1857         case trim( entry( 1, trim( entry( v-count, p-stfactpl, ";" ) ), "=" ) ) :
     1858           when "read-only":U then do:
     1859             assign
     1860               p-update = false
     1861             .
     1862           end.
     1863           when "inv-set":U then do:
     1864             assign
     1865               p-inv-set = true
     1866             .
     1867           end.
     1868           when "revision":U  then do:
     1869             assign
     1870               v-cnt-true = v-cnt-true + 1
     1871               p-revision = yes
     1872               p-percrev  = decimal( entry( 2, trim( entry( v-count, p-stfactpl, ";" ) ), "=" ) )
     1873               no-error.
     1874             if error-status :error
     1875               or p-percrev < 0.00
     1876             then do:
     1877               return error "Неверно задан процент отклонения в подпараметре revision параметра stfactpl.".
     1878             end.
     1879           end.
     1880           when "auto-tank":U then do:
     1881             assign
     1882               v-cnt-true  = v-cnt-true + 1
     1883               p-auto-tank = true
     1884               p-percauto  = decimal( entry( 2, trim( entry( v-count, p-stfactpl, ";" ) ), "=" ) )
     1885               no-error.
     1886             if error-status :error
     1887               or p-percauto < 0.00
     1888             then do:
     1889               return error "Неверно задан процент отклонения в подпараметре auto-tank параметра stfactpl.".
     1890             end.
     1891           end.
     1892           when "inv":U then do:
     1893             assign
     1894               p-inv      = true
     1895               p-percinv  = decimal( entry( 2, trim( entry( v-count, p-stfactpl, ";" ) ), "=" ) )
     1896               no-error.
     1897             if error-status :error
     1898               or p-percinv < 0.00
     1899             then do:
     1900               return error "Неверно задан процент отклонения в подпараметре inv параметра stfactpl.".
     1901             end.
     1902           end.
     1903           otherwise             do:
     1904             return error substitute( "Неизвестный подпараметр &1 в параметре stfactpl.", trim( entry( v-count, p-stfactpl, ";" ) ) ).
     1905           end.
     1906         end case.
     1907       end.
     1908       if v-cnt-true > 1 then do:
     1909         return error "Ошибка параметра stfactpl. Нельзя определять установку фактического количества сразу из двух источников измерений." +
     1910                      "(В параметре не должны присутствовать revision, auto-tank, inv одновременно.)".
     1911       end.
     1912     end.
     1913   end procedure.
     1914   procedure lib-calc_lnfactqt :
     1915     define input parameter parparentproc as   widget-handle      no-undo.
     1916     define input parameter parrec-line   as   recid              no-undo.
     1917     define input parameter paris-update  as   logical            no-undo.
     1918     define input parameter parstatus     like ub.trn-doc.status_ no-undo.
     1919     define input parameter parflag       like ub.trn-doc.flag_   no-undo.
     1920     define variable varstfactpl          as   character             no-undo.
     1921     define variable varstfactpltype      as   character             no-undo.
     1922     define variable vardoc-qnty          like ub.doc-line.doc-qnty  no-undo.
     1923     define variable varrvs-before-qnty   like ub.doc-line.fact-qnty no-undo.
     1924     define variable varrvs-after-qnty    like ub.doc-line.fact-qnty no-undo.
     1925     define variable varauto-tank-qnty    like ub.doc-line.fact-qnty no-undo.
     1926     define variable varauto-tank-density as   decimal               no-undo.
     1927     define variable varfact-qnty         like ub.doc-line.fact-qnty no-undo.
     1928     define variable varis-petrol         as   logical               no-undo.
     1929     define variable varis-pieces         as   logical               no-undo.
     1930     define variable varupdate            as   logical initial yes   no-undo.
     1931     define variable varrevision          as   logical initial no    no-undo.
     1932     define variable varpercrev           as   decimal initial ?     no-undo.
     1933     define variable varauto-tank         as   logical initial no    no-undo.
     1934     define variable varpercauto          as   decimal initial ?     no-undo.
     1935     define variable varinv               as   logical initial no    no-undo.
     1936     define variable varpercinv           as   decimal initial ?     no-undo.
     1937     define variable varinv-set           as   logical initial no    no-undo .
     1938     define variable varchg-qnty          like ub.gds-dtl.fact-qnty  no-undo.
     1939     define variable varb-c               as   integer               no-undo.
     1940     define variable varchg               as   logical               no-undo.
     1941     define variable varst-doc            as   logical               no-undo.
     1942     define buffer ln_doc-line        for ub.doc-line.
     1943     define buffer ln_trn-doc         for ub.trn-doc.
     1944     define buffer ln_goods           for ub.goods.
     1945     define buffer ln_doc-line-attr   for ub.doc-line-attr.
     1946     define buffer ln_rvs-doc-before  for ub.rvs-doc.
     1947     define buffer ln_rvs-doc-after   for ub.rvs-doc.
     1948     define buffer ln_rvs-line-before for ub.rvs-line.
     1949     define buffer ln_rvs-line-after  for ub.rvs-line.
     1950     define buffer ln_gds-dtl         for ub.gds-dtl.
     1951     do on error undo, return error :
     1952   find first ln_doc-line where recid (ln_doc-line) = parrec-line.
     1953   find first ln_goods where ln_goods.artic     = ln_doc-line.artic     and
     1954                             ln_goods.prod-type = ln_doc-line.prod-type and
     1955                             ln_goods.prod-code = ln_doc-line.prod-code no-lock.
     1956   if parstatus = 'накл':U and
     1957      parflag   = yes     then do:
     1958   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1959     (
     1960        input ln_goods.artic
     1961     ,  input ln_goods.prod-type
     1962     ,  input ln_goods.prod-code
     1963     , output varis-petrol
     1964     , output varis-pieces
     1965     ) no-error.
     1966      if error-status :error then do:
     1967        return error return-value.
     1968      end.
     1969      if varis-petrol     and
     1970         not varis-pieces then do:
     1971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1972     (input  'stfactpl':U
     1973     ,input  ''
     1974     ,input  ''
     1975     ,input  0
     1976     ,input  ''
     1977     ,input  ''
     1978     ,input  ''
     1979     ,input  no
     1980     ,output varstfactpl
     1981     ,output varstfactpltype
     1982     ) no-error .
     1983        find first ln_goods where ln_goods.artic     = ln_doc-line.artic     and
     1984                                  ln_goods.prod-type = ln_doc-line.prod-type and
     1985                                  ln_goods.prod-code = ln_doc-line.prod-code no-lock.
     1986        find first ln_doc-line-attr where ln_doc-line-attr.doc-code  = ln_doc-line.doc-code and
     1987                                          ln_doc-line-attr.gds-code  = ln_goods.gds-code    and
     1988                                          ln_doc-line-attr.attr-code = "tank-vol":U           no-error.
     1989        if available ln_doc-line-attr then do:
     1990          assign varauto-tank-qnty = decimal (ln_doc-line-attr.attr-value).
     1991        end.
     1992        else do:
     1993          assign varauto-tank-qnty = 0.
     1994        end.
     1995        find first ln_doc-line-attr where ln_doc-line-attr.doc-code  = ln_doc-line.doc-code and
     1996                                          ln_doc-line-attr.gds-code  = ln_goods.gds-code    and
     1997                                          ln_doc-line-attr.attr-code = "tank-weight":U       no-error.
     1998        if available ln_doc-line-attr then do:
     1999          assign varauto-tank-density = decimal (ln_doc-line-attr.attr-value) / varauto-tank-qnty no-error.
     2000        end.
     2001        else do:
     2002          assign varauto-tank-density = ?.
     2003        end.
     2004        if varauto-tank-density = ? then do:
     2005           find first ln_doc-line-attr where ln_doc-line-attr.doc-code  = ln_doc-line.doc-code and
     2006                                          ln_doc-line-attr.gds-code  = ln_goods.gds-code    and
     2007                                          ln_doc-line-attr.attr-code = "tank-density":U       no-error.
     2008            if available ln_doc-line-attr then do:
     2009              assign varauto-tank-density = decimal (ln_doc-line-attr.attr-value)  no-error.
     2010            end.
     2011        end.
     2012        assign
     2013          varrvs-before-qnty = 0
     2014          varrvs-after-qnty  = 0.
     2015        find first ln_rvs-doc-before where ln_rvs-doc-before.rvs-type = 'перед_док':U    and
     2016                                           ln_rvs-doc-before.out-code = ln_doc-line.doc-code no-error.
     2017        if available ln_rvs-doc-before then do:
     2018          find first ln_rvs-doc-after where ln_rvs-doc-after.rvs-type = 'после_док':U     and
     2019                                            ln_rvs-doc-after.out-code = ln_doc-line.doc-code no-error.
     2020          if available ln_rvs-doc-after then do:
     2021            for each ln_rvs-line-before where ln_rvs-line-before.gds-code = ln_goods.gds-code          and
     2022                                              ln_rvs-line-before.rvs-code = ln_rvs-doc-before.rvs-code and
     2023                                              ln_rvs-line-before.obj-type = ln_doc-line.obj-type       and
     2024                                              ln_rvs-line-before.obj-code = ln_doc-line.obj-code       :
     2025                if varrvs-before-qnty = ? then do:
     2026                  assign varrvs-before-qnty = 0.00.
     2027                end.
     2028                assign varrvs-before-qnty = varrvs-before-qnty + ln_rvs-line-before.state-measure-qnty.
     2029            end.
     2030            for each ln_rvs-line-after where ln_rvs-line-after.gds-code = ln_goods.gds-code          and
     2031                                             ln_rvs-line-after.rvs-code = ln_rvs-doc-after.rvs-code  and
     2032                                             ln_rvs-line-after.obj-type = ln_doc-line.obj-type       and
     2033                                             ln_rvs-line-after.obj-code = ln_doc-line.obj-code       :
     2034                if varrvs-after-qnty = ? then do:
     2035                  assign varrvs-after-qnty = 0.00.
     2036                end.
     2037                assign varrvs-after-qnty = varrvs-after-qnty + ln_rvs-line-after.state-measure-qnty.
     2038            end.
     2039          end.
     2040        end.
     2041        assign
     2042          varfact-qnty = ln_doc-line.fact-qnty
     2043          vardoc-qnty  = ln_doc-line.doc-qnty
     2044        .
     2045   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     2046     ( input        varstfactpl
     2047     , input        vardoc-qnty
     2048     , input        ln_doc-line.doc-density
     2049     , input        varrvs-before-qnty
     2050     , input        varrvs-after-qnty
     2051     , input        varauto-tank-qnty
     2052     , input        varauto-tank-density
     2053     , input        no
     2054     , input-output varfact-qnty
     2055     ,       output varchg
     2056     ,       output varst-doc
     2057     )              no-error
     2058   .
     2059        if error-status :error then do:
     2060           return error substitute ("Ошибка при вызове процедуры lib-calc_stfactqt из процедуры lib-calc_lnfactqt: &1.", return-value).
     2061        end.
     2062        if paris-update = yes then do:
     2063          find ln_gds-dtl where ln_gds-dtl.doc-code  = ln_doc-line.doc-code  and
     2064                                ln_gds-dtl.artic     = ln_doc-line.artic     and
     2065                                ln_gds-dtl.prod-type = ln_doc-line.prod-type and
     2066                                ln_gds-dtl.prod-code = ln_doc-line.prod-code .
     2067         assign
     2068            varchg-qnty  = varfact-qnty - ln_gds-dtl.fact-qnty.
     2069          run trg/rsrv-dtl.p ( input        parparentproc,
     2070                           input        ( 'reserv':U + "," + 'no-message':U ),
     2071                           buffer       ln_gds-dtl,
     2072                           input-output varchg-qnty,
     2073                           input-output ln_doc-line.price-base,
     2074                           input-output ln_doc-line.price-rubl,
     2075                           input        varb-c,
     2076                           input "" ) no-error.
     2077          if error-status :error then do:
     2078            return error return-value.
     2079          end.
     2080          assign
     2081            ln_gds-dtl.fact-qnty  = ln_gds-dtl.fact-qnty  + varchg-qnty
     2082            ln_doc-line.fact-qnty = ln_doc-line.fact-qnty + varchg-qnty .
     2083        end.
     2084        else do:
     2085        end.
     2086      end.
     2087   end.
     2088     end.
     2089   end procedure.
     2090   procedure lib-calc_accgdspr:
     2091   define input  parameter parrec-line         as recid     no-undo.
     2092   define input  parameter parupd-price        as logical   no-undo.
     2093   define output parameter paragsum-base-doc   like ub.gds-dtl.price-base no-undo.
     2094   define output parameter paragsum-rubl-doc   like ub.gds-dtl.price-rubl no-undo.
     2095   define output parameter paragsum-base-fact  like ub.gds-dtl.price-base no-undo.
     2096   define output parameter paragsum-rubl-fact  like ub.gds-dtl.price-rubl no-undo.
     2097   define output parameter paragcount          as integer                 no-undo.
     2098   define buffer ag_doc-line for ub.doc-line.
     2099   define buffer ag_gds-dtl  for ub.gds-dtl.
     2100   define buffer ag_goods    for ub.goods.
     2101   define buffer ag_units    for ub.units.
     2102   define buffer ag_parts    for ub.parts.
     2103   define variable varagfact-qnty like ub.parts.fact-qnty   no-undo.
     2104   define variable varagroad-tax  like ub.doc-line.road-tax no-undo.
     2105   define variable varr-b         as   character            no-undo.
     2106   do on error undo, return error return-value :
     2107   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2109     (output varr-b
     2110     )  .
     2111   find first ag_doc-line where recid(ag_doc-line) = parrec-line.
     2112   for each ag_gds-dtl where ag_gds-dtl.doc-code  = ag_doc-line.doc-code
     2113                         and ag_gds-dtl.prod-code = ag_doc-line.prod-code
     2114                         and ag_gds-dtl.prod-type = ag_doc-line.prod-type
     2115                         and ag_gds-dtl.artic     = ag_doc-line.artic :
     2116       if parupd-price <> no then do:
     2117          if parupd-price = yes then do:
     2118   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
