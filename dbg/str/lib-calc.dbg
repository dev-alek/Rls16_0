      418   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      419   define variable ptrlprop-olddens       as logical   no-undo initial false .
      420   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      421   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      422   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      423   define variable ptrlprop-algoincome as integer no-undo init 0.
      424   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      425   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      426   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      427   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      428   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      429   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      430   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      431   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      432   define variable ptrlprop-block-nozzle as logical no-undo init false.
      433   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      434   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      435   procedure get-ptrl-prop :
      436     define input  parameter p-obj-type as character no-undo .
      437     define input  parameter p-obj-code as integer   no-undo .
      438     do
      439     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      440     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      442     :
      443       define variable par-type          as character no-undo.
      444       define variable v-value-character as character no-undo .
      445       define variable v-value-date      as date      no-undo .
      446       define variable v-value-decimal   as decimal   no-undo .
      447       define variable v-value-integer   as integer   no-undo .
      448       define variable v-value-logical   as logical   no-undo .
      449       for each thbjattr_thbj-attr
      450       :
      451         delete thbjattr_thbj-attr .
      452       end.
      453       run adm/shattri.p
      454         ( input "get":U
      455         , input p-obj-type
      456         , input p-obj-code
      457         , input 'petrol':U
      458         , input  ""
      459         , output v-value-character
      460         , output v-value-date
      461         , output v-value-decimal
      462         , output v-value-integer
      463         , output v-value-logical
      464         , output par-type
      465         , input-output table thbjattr_thbj-attr
      466         ) no-error .
      467       for each thbjattr_thbj-attr
      468       on error undo, return error return-value
      469       :
      470         case thbjattr_thbj-attr.prop-code :
      471           when 'denstclc':U then do:
      472             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      473               assign
      474                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      475               .
      476             end.
      477           end.
      478           when 'expptrl':U then do:
      479             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      480               and thbjattr_thbj-attr.prop-value-type = 'character':U
      481             then do:
      482               assign
      483                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      484               .
      485             end.
      486           end.
      487           when 'inpptrl':U then do:
      488             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      489               and thbjattr_thbj-attr.prop-value-type = 'character':U
      490             then do:
      491               assign
      492                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      493               .
      494             end.
      495           end.
      496           when 'autopump':U then do:
      497             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      498               assign
      499                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      500               .
      501             end.
      502           end.
      503           when 'rvsnmter':U then do:
      504             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      505               assign
      506                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      507               .
      508             end.
      509           end.
      510           when 'avtinvpm':U then do:
      511             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      512               assign
      513                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      514               .
      515             end.
      516           end.
      517           when 'invclipt':U then do:
      518             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      519               assign
      520                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      521               .
      522             end.
      523           end.
      524           when 'olddens':U then do:
      525             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      526               assign
      527                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      528               .
      529             end.
      530           end.
      531           when 'algrvspt':U then do:
      532             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      533               assign
      534                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      535               .
      536             end.
      537           end.
      538           when 'temp-for-pomi':U then do:
      539             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      540               assign
      541                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      542               .
      543             end.
      544           end.
      545           when 'algoincome':U then do:
      546             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      547               assign
      548                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      549               .
      550             end.
      551           end.
      552           when 'mand-choice-autocar':U then do:
      553             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      554               assign
      555                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      556               .
      557             end.
      558           end.
      559           when 'block-nozzle':U then do:
      560             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      561               assign
      562                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      563               .
      564             end.
      565           end.
      566           when 'timeout-block-nozzle':U then do:
      567             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      568               assign
      569                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      570               .
      571             end.
      572           end.
      573           when 'Delta-mass-horiz':U then do:
      574             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      575               assign
      576                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      577               .
      578             end.
      579           end.
      580           when 'Delta-mass-vert':U then do:
      581             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      582               assign
      583                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      584               .
      585             end.
      586           end.
      587           when 'calc-free-vol':U then do:
      588             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      589               assign
      590                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      591               .
      592             end.
      593           end.
      594           when 'calc-free-vol-sug':U then do:
      595             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      596               assign
      597                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      598               .
      599             end.
      600           end.
      601           when 'trn-reas-sug':U then do:
      602             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      603               assign
      604                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      605               .
      606             end.
      607           end.
      608                 when 'rvd-own-nb':U then do:
      609             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      610               assign
      611                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      612               .
      613             end.
      614           end.
      615           when 'qr-scan-time':U then do:
      616             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      617               assign
      618                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      619               .
      620             end.
      621           end.
      622           when 'autopump-skip-time':U then do:
      623             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      624               assign
      625                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      626               .
      627             end.
      628           end.
      629         end case.
      630         delete thbjattr_thbj-attr .
      631       end.
      632     end.
      633     return .
      634   end procedure.
      635   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   procedure gds-attr-name :
      637     define input  parameter p-code           as character no-undo .
      638     define output parameter p-type           as character no-undo .
      639     define output parameter p-format         as character no-undo .
      640     define output parameter p-label          as character no-undo .
      641     define output parameter p-user-can-edit  as logical   no-undo .
      642     define output parameter p-output-display as logical   no-undo .
      643     define output parameter p-other          as character no-undo .
      644     do
      645     on error undo, return error
      646     :
      647           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      648         (input  p-code
      649         ,output p-type
      650         ,output p-format
      651         ,output p-label
      652         ,output p-user-can-edit
      653         ,output p-output-display
      654         ,output p-other
      655         ) no-error .
      656       if error-status :error
      657       then do:
      658         undo, return error return-value .
      659       end.
      660     end.
      661   end procedure.
