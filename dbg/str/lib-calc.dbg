      384   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define new global shared variable g#lib-calc as handle no-undo .
      386   function hvrdtax return logical (input parrecid as recid):
      387   define variable varresult as logical no-undo.
      388   run hvrdtax-proc (input parrecid, output varresult).
      389   return varresult.
      390   end function.
      391   procedure hvrdtax-proc:
      392   define input  parameter parrecid  as recid   no-undo.
      393   define output parameter parresult as logical no-undo.
      394   define buffer bf_goods for ub.goods.
      395   define buffer bf_units for ub.units.
      396   define buffer rt_tax   for ub.tax.
      397   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      398   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      399   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      400   if available rt_tax and
      401       can-find(first ub.tax-units No-LOCK WHERE
      402                      ub.tax-units.tax-code = rt_tax.tax-code AND
      403                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      404                                                       else assign parresult = no.
      405   end procedure.
