     2139                 assign
     2140                 varagfact-qnty = varagfact-qnty + ag_parts.fact-qnty
     2141                 .
     2142                 if varr-b = "rubl":u then do:
     2143                   assign
     2144                     varagroad-tax  = varagroad-tax  + ag_parts.road-tax-rubl * ag_parts.fact-qnty.
     2145                 end.
     2146                 else do:
     2147                   assign
     2148                     varagroad-tax  = varagroad-tax  + ag_parts.road-tax-base * ag_parts.fact-qnty.
     2149                 end.
     2150             end.
     2151             assign ag_doc-line.road-tax = varagroad-tax / varagfact-qnty.
     2152          end.
     2153      end.
     2154      assign
