     1216   and g#lib-calc <> this-procedure :handle
     1217   and lookup('lib-calc_clcrdtax':u, g#lib-calc :internal-entries) > 0
     1218   then do:
     1219     message
     1220       vss-workfile vss-revision vss-description skip
     1221       "Попытка повторной загрузки библиотеки для раcчета складских документов" skip
