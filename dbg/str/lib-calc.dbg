     2577          varsum-base-docovpas  = varsum-base-docovpas  + (out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base)                 * out-vatp_gds-dtlas.doc-qnty
     2578          varslt-base-docovpas  = varslt-base-docovpas  + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base                - road-tax-base-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc)                   * out-vatp_gds-dtlas.doc-qnty
     2579          varvat-base-docovpas  = varvat-base-docovpas  + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base                - road-tax-base-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-base-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc)                   * out-vatp_gds-dtlas.doc-qnty
     2580          varvatcons-base-docovpas  = varvatcons-base-docovpas  + (((out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base                - road-tax-base-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-base-saleas - varprice-base-consas) * as_doc-line.cons-vat-pc / (100 + as_doc-line.cons-vat-pc) * out-vatp_gds-dtlas.doc-qnty * varcons-qntyas / varfact-qntyas + ((out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-base - out-vatp_gds-dtlas.discnt-base                - road-tax-base-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-base-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc) * out-vatp_gds-dtlas.doc-qnty * (varfact-qntyas - varcons-qntyas) / varfact-qntyas)
     2581          vardsc-base-docovpas  = vardsc-base-docovpas  + out-vatp_gds-dtlas.discnt-base * out-vatp_gds-dtlas.doc-qnty
     2582         .
     2583         assign
     2584                varsum-rubl-factovpas = varsum-rubl-factovpas + (out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl)                 * out-vatp_gds-dtlas.fact-qnty
     2585          varslt-rubl-factovpas = varslt-rubl-factovpas + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc)                   * out-vatp_gds-dtlas.fact-qnty
     2586          varvat-rubl-factovpas = varvat-rubl-factovpas + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc)                   * out-vatp_gds-dtlas.fact-qnty
     2587          varvatcons-rubl-factovpas = varvatcons-rubl-factovpas + (((out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas - varprice-rubl-consas) * as_doc-line.cons-vat-pc / (100 + as_doc-line.cons-vat-pc) * out-vatp_gds-dtlas.fact-qnty * varcons-qntyas / varfact-qntyas + ((out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc) * out-vatp_gds-dtlas.fact-qnty * (varfact-qntyas - varcons-qntyas) / varfact-qntyas)
     2588          vardsc-rubl-factovpas = vardsc-rubl-factovpas + out-vatp_gds-dtlas.discnt-rubl * out-vatp_gds-dtlas.fact-qnty
     2589          varsum-rubl-docovpas  = varsum-rubl-docovpas  + (out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl)                 * out-vatp_gds-dtlas.doc-qnty
     2590          varslt-rubl-docovpas  = varslt-rubl-docovpas  + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc)                   * out-vatp_gds-dtlas.doc-qnty
     2591          varvat-rubl-docovpas  = varvat-rubl-docovpas  + (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc)                   * out-vatp_gds-dtlas.doc-qnty
     2592          varvatcons-rubl-docovpas  = varvatcons-rubl-docovpas  + (((out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas - varprice-rubl-consas) * as_doc-line.cons-vat-pc / (100 + as_doc-line.cons-vat-pc) * out-vatp_gds-dtlas.doc-qnty * varcons-qntyas / varfact-qntyas + ((out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl) - (if out-vatp-have-vat-sltas = no then 0 else out-vatp_gds-dtlas.price-rubl - out-vatp_gds-dtlas.discnt-rubl                - road-tax-rubl-saleas) * as_doc-line.SLT-pc / (100 + as_doc-line.SLT-pc) - road-tax-rubl-saleas) * as_doc-line.vat-pc / (100 + as_doc-line.vat-pc) * out-vatp_gds-dtlas.doc-qnty * (varfact-qntyas - varcons-qntyas) / varfact-qntyas)
     2593          vardsc-rubl-docovpas  = vardsc-rubl-docovpas  + out-vatp_gds-dtlas.discnt-rubl * out-vatp_gds-dtlas.doc-qnty   .
     2594       end.
     2595       if as_trn-doc.doc-type = 'инв':U then do:
     2596         ASSIGN
     2597                   price-base-with-tax-saleas    = varsum-base-docovpas / varfact-qntyas
     2598           slt-base-saleas               = varslt-base-docovpas / varfact-qntyas
     2599           vat-base-buyeras              = varvat-base-docovpas / varfact-qntyas
     2600           discnt-base-saleas            = vardsc-base-docovpas / varfact-qntyas
     2601           vat-base-saleas               = varvatcons-base-docovpas / varfact-qntyas
     2602                   price-rubl-with-tax-saleas    = varsum-rubl-docovpas / varfact-qntyas
     2603           slt-rubl-saleas               = varslt-rubl-docovpas / varfact-qntyas
     2604           vat-rubl-buyeras              = varvat-rubl-docovpas / varfact-qntyas
     2605           discnt-rubl-saleas            = vardsc-rubl-docovpas / varfact-qntyas
     2606           vat-rubl-saleas               = varvatcons-rubl-docovpas / varfact-qntyas.
     2607       end.
     2608       else do:
     2609         ASSIGN
     2610                   price-base-with-tax-saleas    = varsum-base-factovpas / varfact-qntyas
     2611           slt-base-saleas               = varslt-base-factovpas / varfact-qntyas
     2612           vat-base-buyeras              = varvat-base-factovpas / varfact-qntyas
     2613           discnt-base-saleas            = vardsc-base-factovpas / varfact-qntyas
     2614           vat-base-saleas               = varvatcons-base-factovpas / varfact-qntyas
     2615                   price-rubl-with-tax-saleas    = varsum-rubl-factovpas / varfact-qntyas
     2616           slt-rubl-saleas               = varslt-rubl-factovpas / varfact-qntyas
     2617           vat-rubl-buyeras              = varvat-rubl-factovpas / varfact-qntyas
     2618           discnt-rubl-saleas            = vardsc-rubl-factovpas / varfact-qntyas
     2619           vat-rubl-saleas               = varvatcons-rubl-factovpas / varfact-qntyas.
     2620       end.
     2621     end.
     2622   end.
     2623   assign
     2624     price-base-without-tax-saleas = price-base-with-tax-saleas - vat-base-saleas - slt-base-saleas - road-tax-base-saleas
     2625     price-rubl-without-tax-saleas = price-rubl-with-tax-saleas - vat-rubl-saleas - slt-rubl-saleas - road-tax-rubl-saleas.
     2626   if as_trn-doc.ext-doc-type = 'vt':U
     2627     or as_trn-doc.ext-doc-type = 'vp':U
     2628   then do:
     2629     assign
     2630       parroad-tax-doc                  = (if varr-b = "base" then road-tax-base-saleas else road-tax-rubl-saleas) * as_doc-line.fact-qnty
     2631       parslt-doc-base                  = slt-base-saleas * as_doc-line.fact-qnty
     2632       parvat-doc-base                  = vat-base-saleas * as_doc-line.fact-qnty
     2633       parsum-doc-base                  = (price-base-with-tax-saleas + discnt-base-saleas) * as_doc-line.fact-qnty
     2634       parsum-doc-rubl                  = (price-rubl-with-tax-saleas + discnt-rubl-saleas) * as_doc-line.fact-qnty
     2635       pardiscnt-base-doc               = discnt-base-saleas * as_doc-line.fact-qnty
     2636       pardiscnt-rubl-doc               = discnt-rubl-saleas * as_doc-line.fact-qnty
     2637       parexcise-doc                    = (if varr-b = "base" then excise-base-saleas else excise-rubl-saleas) * as_doc-line.fact-qnty
     2638       parslt-doc-rubl                  = slt-base-saleas * as_doc-line.fact-qnty
     2639       parvat-doc-rubl                  = vat-base-saleas * as_doc-line.fact-qnty.
     2640   end.
     2641   else do:
     2642     assign
     2643       parroad-tax-fact-base            = road-tax-base-saleas * as_doc-line.fact-qnty
     2644       parexcise-fact-base              = excise-base-saleas * as_doc-line.fact-qnty
     2645       parslt-fact-base                 = slt-base-saleas * as_doc-line.fact-qnty
     2646       parvat-fact-base                 = vat-base-saleas * as_doc-line.fact-qnty
     2647       parsum-fact-out-dsc-slt-vat-base = (price-base-with-tax-saleas - vat-base-saleas - slt-base-saleas) * as_doc-line.fact-qnty
     2648       parsum-fact-out-dsc-base         = price-base-with-tax-saleas * as_doc-line.fact-qnty
     2649       parsum-fact-out-dsc-rubl         = price-rubl-with-tax-saleas * as_doc-line.fact-qnty
     2650       pardiscnt-base-fact              = discnt-base-saleas * as_doc-line.fact-qnty
     2651       pardiscnt-rubl-fact              = discnt-rubl-saleas * as_doc-line.fact-qnty
     2652       parroad-tax-fact-rubl            = road-tax-rubl-saleas * as_doc-line.fact-qnty
     2653       parexcise-fact-rubl              = excise-rubl-saleas * as_doc-line.fact-qnty
     2654       parslt-fact-rubl                 = slt-rubl-saleas * as_doc-line.fact-qnty
     2655       parvat-fact-rubl                 = vat-rubl-saleas * as_doc-line.fact-qnty
     2656       parsum-fact-out-dsc-slt-vat-rubl = (price-rubl-with-tax-saleas - vat-rubl-saleas - slt-rubl-saleas) * as_doc-line.fact-qnty
     2657       parroad-tax-fact                 = (if varr-b = "base" then road-tax-base-saleas else road-tax-rubl-saleas) * as_doc-line.fact-qnty
     2658       parexcise-fact                   = (if varr-b = "base" then excise-base-saleas else excise-rubl-saleas) * as_doc-line.fact-qnty.
     2659   end.
     2660   for each as_gds-dtl where as_gds-dtl.artic     = as_doc-line.artic
     2661                         and as_gds-dtl.prod-type = as_doc-line.prod-type
     2662                         and as_gds-dtl.prod-code = as_doc-line.prod-code
     2663                         and as_gds-dtl.doc-code  = as_doc-line.doc-code no-lock:
     2664     assign
     2665       parsum-fact-cur                  =  parsum-fact-cur                  + as_gds-dtl.cur-base * as_gds-dtl.fact-qnty
     2666       parsum-doc-cur                   =  parsum-doc-cur                   + as_gds-dtl.cur-base * as_gds-dtl.doc-qnty
     2667     .
     2668     if varr-b = "rubl":u then do:
     2669       assign
     2670         parov-fact-base                  =  parov-fact-base                  + (as_gds-dtl.cur-base - as_gds-dtl.price-rubl) * as_gds-dtl.fact-qnty
     2671         parov-vat-fact-base              =  parov-vat-fact-base              + (as_gds-dtl.cur-base - as_gds-dtl.price-rubl) * as_gds-dtl.fact-qnty * as_doc-line.vat-pc / ( 100 + as_doc-line.vat-pc)
     2672         parov-doc-base                   =  parov-doc-base                   + (as_gds-dtl.cur-base - as_gds-dtl.price-rubl) * as_gds-dtl.doc-qnty
     2673         parov-vat-doc-base               =  parov-vat-doc-base               + (as_gds-dtl.cur-base - as_gds-dtl.price-rubl) * as_gds-dtl.doc-qnty * as_doc-line.vat-pc / ( 100 + as_doc-line.vat-pc)
     2674       .
     2675     end.
     2676     else do:
     2677       assign
     2678         parov-fact-base                  =  parov-fact-base                  + (as_gds-dtl.cur-base - as_gds-dtl.price-base) * as_gds-dtl.fact-qnty
     2679         parov-vat-fact-base              =  parov-vat-fact-base              + (as_gds-dtl.cur-base - as_gds-dtl.price-base) * as_gds-dtl.fact-qnty * as_doc-line.vat-pc / ( 100 + as_doc-line.vat-pc)
     2680         parov-doc-base                   =  parov-doc-base                   + (as_gds-dtl.cur-base - as_gds-dtl.price-base) * as_gds-dtl.doc-qnty
     2681         parov-vat-doc-base               =  parov-vat-doc-base               + (as_gds-dtl.cur-base - as_gds-dtl.price-base) * as_gds-dtl.doc-qnty * as_doc-line.vat-pc / ( 100 + as_doc-line.vat-pc)
     2682       .
     2683     end.
     2684   end.
     2685   end.
     2686   end procedure.
