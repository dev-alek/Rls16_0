        1   block-level on error undo, throw.
        2   define  input parameter p-obj-type     like ub.clients.obj-type     no-undo .
        3   define  input parameter p-obj-code     like ub.clients.obj-code     no-undo .
        4   define  input parameter p-shift-date   like ub.shift-obj.shift-date no-undo .
        5   define  input parameter p-shift-num    like ub.shift-obj.shift-num  no-undo .
        6   define  input parameter p-gds-code     like ub.goods.gds-code       no-undo .
        7   define  input parameter p-rvs-code     like ub.rvs-doc.rvs-code     no-undo .
        8   define  input parameter p-with-expense as   logical                 no-undo .
        9   define output parameter p-density      as   decimal                 no-undo .
       10   define variable vss-revision    as character no-undo initial "$Revision$":U .
       11   define variable vss-author      as character no-undo initial "$Author$":U .
       12   define variable vss-date        as character no-undo initial "$Date$":U .
       13   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       14   define variable vss-archive     as character no-undo initial "$Archive$":U .
       15   define variable vss-description as character no-undo initial "Расчет средней плотности по топливу за смену на объекте":U .
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define new global shared variable g#lib-trn  as handle no-undo .
       77   define new global shared variable g#lib-trn2 as handle no-undo .
       78   define new global shared variable g#lib-trn3 as handle no-undo .
       79   define new global shared variable g#lib-trn4 as handle no-undo .
       80   define variable is_shift-on       as   logical               no-undo .
       81   define variable is-petrol         as   logical               no-undo .
       82   define variable is-pieces         as   logical               no-undo .
       83   define variable d_fact-order      like ub.rvs-doc.fact-order no-undo .
       84   define variable d_fact-order-prev like ub.rvs-doc.fact-order no-undo .
       85   define variable d_density-acc     as   decimal               no-undo .
       86   define variable j_num-place       as   integer               no-undo .
       87   define variable rec-rvs-doc       as   recid                 no-undo .
       88   define variable varshift-name     as   character             no-undo .
       89   define variable varshift-name-num as   character             no-undo .
       90   define buffer bf_rvs-doc  for ub.rvs-doc .
       91   define buffer bf_cur-doc  for ub.rvs-doc .
       92   define buffer bf_cur-line for ub.rvs-line .
       93   do on error undo, return error :
       94     find first ub.clients no-lock where
       95                ub.clients.obj-type = p-obj-type and
       96                ub.clients.obj-code = p-obj-code no-error .
       97     if not available ub.clients
       98     then do:
       99       return error substitute( "Не найден объект: &1 &2."
      100                              , p-obj-type
      101                              , p-obj-code
      102                              ) .
      103     end.
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      106     (input  p-obj-type
      107     ,input  p-obj-code
      108     ,input  'shift-on=request'
      109     ,output is_shift-on
      110     ) no-error .
      111     if error-status :error
      112     then do:
      113       return error trim( return-value ) +
      114                    trim( error-status :get-message( 1 ) ) +
      115                    trim( error-status :get-message( 2 ) ) +
      116                    trim( error-status :get-message( 3 ) ) +
      117                    trim( error-status :get-message( 4 ) ) +
      118                    trim( error-status :get-message( 5 ) ) .
      119     end.
      120     if is_shift-on <> yes
      121     then do:
      122       return error "На объекте не работают смены." .
      123     end.
      124     find first ub.goods no-lock where
      125                ub.goods.gds-code = p-gds-code no-error .
      126     if not available ub.goods
      127     then do:
      128       return error substitute( "Не найден товар с внутренним кодом &1."
      129                              , p-gds-code
      130                              ) .
      131     end.
      132   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      133     (
      134        input ub.goods.artic
      135     ,  input ub.goods.prod-type
      136     ,  input ub.goods.prod-code
      137     , output is-petrol
      138     , output is-pieces
      139     ) no-error.
      140     if error-status :error
      141     then do:
      142       return error "Ошибка при вызове программы lib-trn_is-petrl из avrgdens.p. " + return-value .
      143     end.
      144     if is-petrol <> yes or
      145        is-pieces <> no
      146     then do:
      147       return error substitute( "Товар &1 &2 &3 не является весовым топливом."
      148                              , ub.goods.artic
      149                              , ub.goods.prod-type
      150                              , ub.goods.prod-code
      151                              ) .
      152     end.
      153     if p-rvs-code <> ?
      154     then do:
      155       find first bf_cur-doc no-lock where
      156                  bf_cur-doc.rvs-code = p-rvs-code no-error .
      157       if not available bf_cur-doc
      158       then do:
      159          return error substitute( "Не найдена сверка с номером &1 ."
      160                                 , p-rvs-code
      161                                 ) .
      162       end.
      163       find first bf_cur-line no-lock where
      164                  bf_cur-line.rvs-code = bf_cur-doc.rvs-code and
      165                  bf_cur-line.gds-code = ub.goods.gds-code   no-error .
      166       if not available bf_cur-line
      167       then do:
      168         return error substitute( "Товар &1 &2 &3 не участвует в сверке &4. Плотность не может быть вычислена. "
      169                                , ub.goods.artic
      170                                , ub.goods.prod-type
      171                                , ub.goods.prod-code
      172                                , bf_cur-doc.rvs-code
      173                                ) .
      174       end.
      175       assign
      176         d_fact-order = bf_cur-doc.fact-order
      177       .
      178     end.
      179     else do:
      180       assign
      181         d_fact-order = ?
      182       .
      183       for each ub.rvs-doc no-lock where
      184                ub.rvs-doc.obj-type   = p-obj-type   and
      185                ub.rvs-doc.obj-code   = p-obj-code   and
      186                ub.rvs-doc.shift-date = p-shift-date and
      187                ub.rvs-doc.shift-num  = p-shift-num  and
      188                ub.rvs-doc.status_    = 'факт':U      and
      189                ub.rvs-doc.rvs-type  <> 'проверка':U
      190         , each ub.rvs-line no-lock where
      191                ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code and
      192                ub.rvs-line.obj-type = ub.rvs-doc.obj-type and
      193                ub.rvs-line.obj-code = ub.rvs-doc.obj-code and
      194                ub.rvs-line.gds-code = ub.goods.gds-code
      195       :
      196         assign
      197           d_fact-order = ub.rvs-doc.fact-order
      198         .
      199         leave .
      200       end.
      201     end.
      202     if d_fact-order <> ? then do:
      203       find last bf_rvs-doc no-lock where
      204                 bf_rvs-doc.obj-type   = p-obj-type   and
      205                 bf_rvs-doc.obj-code   = p-obj-code   and
      206                 bf_rvs-doc.status_    = 'факт':U      and
      207                 bf_rvs-doc.fact-order < d_fact-order and
      208                 bf_rvs-doc.rvs-type   = 'смена':U use-index stat-fact no-error .
      209       assign
      210         d_fact-order-prev = ( if available bf_rvs-doc then bf_rvs-doc.fact-order else 0.00 )
      211       .
      212       assign
      213         j_num-place   = 0
      214         d_density-acc = 0.00
      215         p-density     = 0.00
      216       .
      217       for each ub.rvs-doc no-lock where
      218                ub.rvs-doc.obj-type    = p-obj-type        and
      219                ub.rvs-doc.obj-code    = p-obj-code        and
      220                ub.rvs-doc.status_     = 'факт':U           and
      221                ub.rvs-doc.fact-order <= d_fact-order      and
      222                ub.rvs-doc.fact-order >= d_fact-order-prev and
      223                ub.rvs-doc.rvs-type   <> 'проверка':U
      224         , each ub.rvs-line no-lock where
      225                ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code and
      226                ub.rvs-line.obj-type = ub.rvs-doc.obj-type and
      227                ub.rvs-line.obj-code = ub.rvs-doc.obj-code and
      228                ub.rvs-line.gds-code = p-gds-code
      229       break by ub.rvs-line.obj-type
      230             by ub.rvs-line.obj-code
      231             by ub.rvs-line.pl-code
      232       on error undo, return error
      233       :
      234         assign
      235           d_density-acc = d_density-acc + ( if ub.rvs-line.state-density <> ? then ub.rvs-line.state-density else 0 )
      236           j_num-place   = j_num-place   + 1
      237         .
      238       end.
      239       if p-with-expense = yes
      240       then do:
      241         for each ub.doc-line no-lock where
      242                  ub.doc-line.obj-type      = p-obj-type         and
      243                  ub.doc-line.obj-code      = p-obj-code         and
      244                  ub.doc-line.prod-type     = ub.goods.prod-type and
      245                  ub.doc-line.prod-code     = ub.goods.prod-code and
      246                  ub.doc-line.artic         = ub.goods.artic     and
      247                  ub.doc-line.ext-doc-type  = 'ee':U and
      248                  ub.doc-line.status_       = 'факт':U            and
      249                  ub.doc-line.fact-order   <= d_fact-order       and
      250                  ub.doc-line.fact-order   >= d_fact-order-prev
      251         on error undo, return error
      252         :
      253           assign
      254             d_density-acc = d_density-acc + ( if ub.doc-line.fact-density <> ? then ub.doc-line.fact-density else 0 )
      255             j_num-place   = j_num-place   + 1
      256           .
      257         end.
      258       end.
      259     end.
      260     else do:
      261       find last bf_rvs-doc no-lock where
      262                 bf_rvs-doc.obj-type   = p-obj-type   and
      263                 bf_rvs-doc.obj-code   = p-obj-code   and
      264                 bf_rvs-doc.status_    = 'факт':U      and
      265                 bf_rvs-doc.rvs-type   = 'смена':U use-index stat-fact no-error .
      266       assign
      267         d_fact-order-prev = ( if available bf_rvs-doc then bf_rvs-doc.fact-order else 0.00 )
      268       .
      269       assign
      270         j_num-place   = 0
      271         d_density-acc = 0.00
      272         p-density     = 0.00
      273       .
      274       for each ub.rvs-doc no-lock where
      275                ub.rvs-doc.obj-type    = p-obj-type        and
      276                ub.rvs-doc.obj-code    = p-obj-code        and
      277                ub.rvs-doc.status_     = 'факт':U           and
      278                ub.rvs-doc.fact-order >= d_fact-order-prev and
      279                ub.rvs-doc.rvs-type   <> 'проверка':U
      280         , each ub.rvs-line no-lock where
      281                ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code and
      282                ub.rvs-line.obj-type = ub.rvs-doc.obj-type and
      283                ub.rvs-line.obj-code = ub.rvs-doc.obj-code and
      284                ub.rvs-line.gds-code = p-gds-code
      285       break by ub.rvs-line.obj-type
      286             by ub.rvs-line.obj-code
      287             by ub.rvs-line.pl-code
      288       on error undo, return error
      289       :
      290         assign
      291           d_density-acc = d_density-acc + ( if ub.rvs-line.state-density <> ? then ub.rvs-line.state-density else 0 )
      292           j_num-place   = j_num-place   + 1
      293         .
      294       end.
      295       if p-with-expense = yes
      296       then do:
      297         for each ub.doc-line no-lock where
      298                  ub.doc-line.obj-type      = p-obj-type         and
      299                  ub.doc-line.obj-code      = p-obj-code         and
      300                  ub.doc-line.prod-type     = ub.goods.prod-type and
      301                  ub.doc-line.prod-code     = ub.goods.prod-code and
      302                  ub.doc-line.artic         = ub.goods.artic     and
      303                  ub.doc-line.ext-doc-type  = 'ee':U and
      304                  ub.doc-line.status_       = 'факт':U            and
      305                  ub.doc-line.fact-order   >= d_fact-order-prev
      306         on error undo, return error
      307         :
      308           assign
      309             d_density-acc = d_density-acc + ( if ub.doc-line.fact-density <> ? then ub.doc-line.fact-density else 0 )
      310             j_num-place   = j_num-place   + 1
      311           .
      312         end.
      313       end.
      314     end.
      315     assign
      316       p-density = d_density-acc / j_num-place
      317     .
      318   end.
