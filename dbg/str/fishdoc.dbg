        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo.
        3   define input parameter par-host-code as integer no-undo .
        4   define input parameter par-obj-type as character no-undo .
        5   define input parameter par-obj-code as integer no-undo .
        6   define input parameter trn-doc-code as character no-undo .
        7   define input parameter v-gds-code as integer no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: fishdoc.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/fishdoc.p $":U .
       13   define variable vss-description as character no-undo init " Просмотр документа из финансового блока   ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84     define variable v-cntxt-db-num        as integer   no-undo .
       85     define variable v-cntxt-userid        as character no-undo .
       86     define variable v-cntxt-level         as character no-undo .
       87     define variable v-cntxt-host-code-obj as integer   no-undo .
       88     define variable v-cntxt-obj-type      as character no-undo .
       89     define variable v-cntxt-obj-code      as integer   no-undo .
       90     define variable v-cntxt-db-num-obj    as integer   no-undo .
       91     define variable v-cntxt-is-admin      as logical   no-undo .
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93     run mainmenu_getcntxt in parparentproc
       94       (output v-cntxt-db-num
       95       ,output v-cntxt-userid
       96       ,output v-cntxt-level
       97       ,output v-cntxt-host-code-obj
       98       ,output v-cntxt-obj-type
       99       ,output v-cntxt-obj-code
      100       ,output v-cntxt-db-num-obj
      101       ,output v-cntxt-is-admin
      102       ) .
      103   define variable v-mode as integer no-undo .
      104   define buffer buf_trn-doc for ub.trn-doc .
      105   define buffer buf_c-trn-doc for ub.c-trn-doc.
      106   define buffer buf_goods for ub.goods .
      107   do
      108   on error undo, return error return-value
      109   :
      110     find first buf_trn-doc no-lock where buf_trn-doc.doc-code = trn-doc-code no-error .
      111     if available buf_trn-doc then do:
      112         define variable glog as logical no-undo .
      113         case buf_trn-doc.doc-type
      114         :
      115           when 'при':U
      116           then do:
      117   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   do:
      119     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      120       (input  v-cntxt-db-num
      121       ,input  v-cntxt-userid
      122       ,input  0
      123       ,input  'actn_income_lookup':U
      124       ,input  'object':U
      125       ,input  par-host-code
      126       ,input  par-obj-type
      127       ,input  par-obj-code
      128       ,input  0
      129       ,input  0
      130       ,input  0
      131       ,input  true
      132       ,output glog
      133       )  .
      134   end.
      135           end.
      136           when 'рас':U
      137           then do:
      138   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   do:
      140     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      141       (input  v-cntxt-db-num
      142       ,input  v-cntxt-userid
      143       ,input  0
      144       ,input  'actn_expense_lookup':U
      145       ,input  'object':U
      146       ,input  par-host-code
      147       ,input  par-obj-type
      148       ,input  par-obj-code
      149       ,input  0
      150       ,input  0
      151       ,input  0
      152       ,input  true
      153       ,output glog
      154       )  .
      155   end.
      156           end.
      157           when 'спи':U
      158           then do:
      159   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   do:
      161     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      162       (input  v-cntxt-db-num
      163       ,input  v-cntxt-userid
      164       ,input  0
      165       ,input  'actn_write-off_lookup':U
      166       ,input  'object':U
      167       ,input  par-host-code
      168       ,input  par-obj-type
      169       ,input  par-obj-code
      170       ,input  0
      171       ,input  0
      172       ,input  0
      173       ,input  true
      174       ,output glog
      175       )  .
      176   end.
      177           end.
      178           when 'возврат':U
      179           then do:
      180   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   do:
      182     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      183       (input  v-cntxt-db-num
      184       ,input  v-cntxt-userid
      185       ,input  0
      186       ,input  'actn_return_lookup':U
      187       ,input  'object':U
      188       ,input  par-host-code
      189       ,input  par-obj-type
      190       ,input  par-obj-code
      191       ,input  0
      192       ,input  0
      193       ,input  0
      194       ,input  true
      195       ,output glog
      196       )  .
      197   end.
      198           end.
      199           when 'инв':U
      200           then do:
      201   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   do:
      203     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      204       (input  v-cntxt-db-num
      205       ,input  v-cntxt-userid
      206       ,input  0
      207       ,input  'actn_inventory_lookup':U
      208       ,input  'object':U
      209       ,input  par-host-code
      210       ,input  par-obj-type
      211       ,input  par-obj-code
      212       ,input  0
      213       ,input  0
      214       ,input  0
      215       ,input  true
      216       ,output glog
      217       )  .
      218   end.
      219           end.
      220           otherwise do:
      221             message
      222               vss-workfile vss-revision vss-description skip
      223               "Неизвеснтный тип документа" skip
      224               "Тип документа" buf_trn-doc.doc-type skip
      225               "Код документа" buf_trn-doc.doc-code skip
      226               view-as alert-box error .
      227             undo, return error return-value .
      228           end.
      229         end case .
      230             IF glog <> YES OR ERROR-STATUS:ERROR THEN DO:
      231               RETURN error.
      232             END.
      233     if v-gds-code <> ? then v-mode = 1.
      234                       else v-mode = 0.
      235     if v-mode = 0 then do:
      236         run str/showdoc.p
      237           (input parparentproc
      238           ,input trn-doc-code
      239           ,input ""
      240           ,input ""
      241           ,input 0
      242           ,input true
      243           ) no-error  .
      244           if error-status :error then
      245           message
      246               "Вернулась из процедуры showdoc.p "
      247               error-status :get-message(1)
      248               view-as alert-box error .
      249     end.
      250     else do:
      251     find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
      252           if available buf_goods then do:
      253               run str/showdoc.p
      254                 (input parparentproc
      255                 ,input trn-doc-code
      256                 ,input buf_goods.artic
      257                 ,input buf_goods.prod-type
      258                 ,input buf_goods.prod-code
      259                 ,input true
      260                 ) no-error  .
      261                 if error-status :error then
      262                     message
      263                         "   Вернулась из процедуры showdoc.p "
      264                         error-status :get-message(1)
      265                         view-as alert-box error .
      266           end.
      267     end.
      268     end.
      269     else do:
      270       find first buf_c-trn-doc no-lock where buf_c-trn-doc.doc-code = trn-doc-code no-error .
      271       if available buf_c-trn-doc then do:
      272         run str/c-doc.w ( input parparentproc, input buf_c-trn-doc.doc-code, input buf_c-trn-doc.chip-num ).
      273       end.
      274     end.
      275   end.
