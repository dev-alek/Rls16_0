     3384       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     3385       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     3386       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     3387       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     3388       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     3389       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     3390       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     3391       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     3392       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3393       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     3394       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     3395       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3396       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3397       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3398       .
     3399     assign
     3400       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3401       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3402       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3403       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3404       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3405       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3406       bfsacc_tt-allsum.vat-base-doc        = 0
     3407       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3408       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3409       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     3410       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     3411       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     3412       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     3413       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     3414       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     3415       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     3416       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     3417       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     3418       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     3419       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     3420       bfsacc_tt-allsum.vat-base-cur        = 0
     3421       bfsacc_tt-allsum.vat-rubl-cur        = 0
     3422       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     3423       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     3424       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     3425       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     3426       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     3427       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     3428       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     3429       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     3430       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     3431       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3432       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     3433       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     3434       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3435       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3436       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3437       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3438       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3439       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3440       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3441       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3442       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3443       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     3444       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     3445       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     3446       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     3447       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     3448       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     3449       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     3450       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     3451       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     3452       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3453       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3454       .
     3455   end.
     3456   otherwise do:
     3457     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3458                              cl_tt-clcparts.purch-code,
     3459                              cl_tt-clcparts.part-code,
     3460                              cl_tt-clcparts.out-code,
     3461                              cl_tt-clcparts.in-code,
     3462                              cl_tt-clcparts.artic,
     3463                              cl_tt-clcparts.prod-type,
     3464                              cl_tt-clcparts.prod-code).
     3465   end.
     3466   end case.
     3467   end.
     3468   end procedure.
     3469   procedure clcprtsl_calc-line :
     3470   define input  parameter parrec-line as recid no-undo.
     3471   define variable v-tax-date         as   date                     no-undo.
     3472   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3473   define variable varr-b             as   character                no-undo.
     3474   define variable varr-btype         as   character                no-undo.
     3475   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3476   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3477   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3478   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3479   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3480   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3481   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3482   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3483   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3484   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3485   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3486   define variable varexcise          like ub.price-list.excise     no-undo.
     3487   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3488   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3489   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3490   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3491   define variable v-varsum           as decimal                  no-undo.
     3492   define variable varprice-salef as decimal   no-undo .
     3493   define buffer bf_trn-doc             for ub.trn-doc.
     3494   define buffer bf_doc-line            for ub.doc-line.
     3495   define buffer bf_gds-dtl             for ub.gds-dtl.
     3496   define buffer bf_goods               for ub.goods.
     3497   define buffer bf_parts               for ub.parts.
     3498   define buffer bf_sysconf             for ub.sysconf.
     3499   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3500   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3501   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3502   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3503   define buffer buf_parts        for ub.parts.
     3504   v-calcbypart = no.
     3505   do on error undo, return error return-value :
     3506   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3508     (output varr-b
     3509     )  .
     3510     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3511     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3512     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3513                               bf_goods.prod-type = bf_doc-line.prod-type and
     3514                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3515     if bf_trn-doc.fact-date <> ?        then do:
     3516       assign v-tax-date = bf_trn-doc.fact-date.
     3517     end.
     3518     else do:
     3519       assign v-tax-date = ?.
     3520     end.
     3521   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3523     (input  bf_goods.gds-code
     3524     ,input  '1':U
     3525     ,input  v-tax-date
     3526     ,input  bf_trn-doc.host-code
     3527     ,input  bf_trn-doc.obj-type
     3528     ,input  bf_trn-doc.obj-code
     3529     ,output v-vat-pc
     3530     ) no-error .
     3531     if error-status :error
     3532     or v-vat-pc = ? then do:
     3533        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3534     end.
     3535     if bf_goods.gds-type = 'у':U or
     3536        bf_trn-doc.status_ = 'запрос':U then do:
     3537       for each bf_tt-allsum-line
     3538       on error undo, return error return-value
     3539        :
     3540         delete bf_tt-allsum-line.
     3541       end.
     3542       create bf_tt-allsum-line.
     3543       assign
     3544        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3545       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3546                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3547                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3548                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3549         assign
     3550           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3551           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3552           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3553           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3554           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3555           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3556           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3557           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3558           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3559           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3560           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3561           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3562           bf_tt-allsum-line.vat-cli-acc          =  ?
     3563           .
     3564       end.
     3565       assign
     3566         bf_tt-allsum-line.cli-qnty             =  ?
     3567         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3568         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3569         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3570         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3571         bf_tt-allsum-line.road-tax-base-doc    =  0
     3572         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3573         bf_tt-allsum-line.excise-base-doc      =  0
     3574         bf_tt-allsum-line.excise-rubl-doc      =  0
     3575         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3576         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3577         bf_tt-allsum-line.dsc-base-cur         =  0
     3578         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3579         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3580         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3581         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3582         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3583         bf_tt-allsum-line.road-tax-base-cur    =  0
     3584         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3585         bf_tt-allsum-line.excise-base-cur      =  0
     3586         bf_tt-allsum-line.excise-rubl-cur      =  0
     3587         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3588         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3589         bf_tt-allsum-line.dsc-base-acc         =  0
     3590         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3591         bf_tt-allsum-line.dsc-cli-acc          =  0
     3592         bf_tt-allsum-line.slt-base-acc         =  0
     3593         bf_tt-allsum-line.slt-rubl-acc         =  0
     3594         bf_tt-allsum-line.slt-cli-acc          =  0
     3595         bf_tt-allsum-line.road-tax-base-acc    =  0
     3596         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3597         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3598         bf_tt-allsum-line.excise-base-acc      =  0
