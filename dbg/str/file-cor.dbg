     4829       bf-expp_trn-doc-sum.cost-road-tax-base  = bf-expp_trn-doc-sum.cost-road-tax-base  +  bf-expp_doc-line-sum.cost-road-tax-base
     4830       bf-expp_trn-doc-sum.cost-road-tax-rubl  = bf-expp_trn-doc-sum.cost-road-tax-rubl  +  bf-expp_doc-line-sum.cost-road-tax-rubl
     4831       bf-expp_trn-doc-sum.cost-excise-base    = bf-expp_trn-doc-sum.cost-excise-base    +  bf-expp_doc-line-sum.cost-excise-base
     4832       bf-expp_trn-doc-sum.cost-excise-rubl    = bf-expp_trn-doc-sum.cost-excise-rubl    +  bf-expp_doc-line-sum.cost-excise-rubl
     4833       bf-expp_trn-doc-sum.cost-transport-base = bf-expp_trn-doc-sum.cost-transport-base +  bf-expp_doc-line-sum.cost-transport-base
     4834       bf-expp_trn-doc-sum.cost-transport-rubl = bf-expp_trn-doc-sum.cost-transport-rubl +  bf-expp_doc-line-sum.cost-transport-rubl
     4835       bf-expp_trn-doc-sum.cost-other-base     = bf-expp_trn-doc-sum.cost-other-base     +  bf-expp_doc-line-sum.cost-other-base
     4836       bf-expp_trn-doc-sum.cost-other-rubl     = bf-expp_trn-doc-sum.cost-other-rubl     +  bf-expp_doc-line-sum.cost-other-rubl
     4837     .
     4838   end.
     4839   for each bf-incp_doc-line-sum where bf-incp_doc-line-sum.doc-code     = bf_trn-doc.doc-code     and
     4840                                       bf-incp_doc-line-sum.ext-doc-type = bf_trn-doc.ext-doc-type and
     4841                                       bf-incp_doc-line-sum.obj-type     = bf_trn-doc.obj-type     and
     4842                                       bf-incp_doc-line-sum.obj-code     = bf_trn-doc.obj-code     and
     4843                                       bf-incp_doc-line-sum.sum-type     = 'inp':U     on error undo, return error return-value :
     4844     assign
     4845       bf-incp_trn-doc-sum.fact-qnty           = bf-incp_trn-doc-sum.fact-qnty           +  bf-incp_doc-line-sum.fact-qnty
     4846       bf-incp_trn-doc-sum.cost-sum-base       = bf-incp_trn-doc-sum.cost-sum-base       +  bf-incp_doc-line-sum.cost-sum-base
     4847       bf-incp_trn-doc-sum.cost-sum-rubl       = bf-incp_trn-doc-sum.cost-sum-rubl       +  bf-incp_doc-line-sum.cost-sum-rubl
     4848       bf-incp_trn-doc-sum.cost-vat-base       = bf-incp_trn-doc-sum.cost-vat-base       +  bf-incp_doc-line-sum.cost-vat-base
     4849       bf-incp_trn-doc-sum.cost-vat-rubl       = bf-incp_trn-doc-sum.cost-vat-rubl       +  bf-incp_doc-line-sum.cost-vat-rubl
     4850       bf-incp_trn-doc-sum.cost-slt-base       = bf-incp_trn-doc-sum.cost-slt-base       +  bf-incp_doc-line-sum.cost-slt-base
     4851       bf-incp_trn-doc-sum.cost-slt-rubl       = bf-incp_trn-doc-sum.cost-slt-rubl       +  bf-incp_doc-line-sum.cost-slt-rubl
     4852       bf-incp_trn-doc-sum.cost-road-tax-base  = bf-incp_trn-doc-sum.cost-road-tax-base  +  bf-incp_doc-line-sum.cost-road-tax-base
     4853       bf-incp_trn-doc-sum.cost-road-tax-rubl  = bf-incp_trn-doc-sum.cost-road-tax-rubl  +  bf-incp_doc-line-sum.cost-road-tax-rubl
     4854       bf-incp_trn-doc-sum.cost-excise-base    = bf-incp_trn-doc-sum.cost-excise-base    +  bf-incp_doc-line-sum.cost-excise-base
     4855       bf-incp_trn-doc-sum.cost-excise-rubl    = bf-incp_trn-doc-sum.cost-excise-rubl    +  bf-incp_doc-line-sum.cost-excise-rubl
     4856       bf-incp_trn-doc-sum.cost-transport-base = bf-incp_trn-doc-sum.cost-transport-base +  bf-incp_doc-line-sum.cost-transport-base
     4857       bf-incp_trn-doc-sum.cost-transport-rubl = bf-incp_trn-doc-sum.cost-transport-rubl +  bf-incp_doc-line-sum.cost-transport-rubl
     4858       bf-incp_trn-doc-sum.cost-other-base     = bf-incp_trn-doc-sum.cost-other-base     +  bf-incp_doc-line-sum.cost-other-base
     4859       bf-incp_trn-doc-sum.cost-other-rubl     = bf-incp_trn-doc-sum.cost-other-rubl     +  bf-incp_doc-line-sum.cost-other-rubl
     4860     .
     4861   end.
     4862   run gbl/calc-trn.p (input parparentproc, input recid(bf_trn-doc)) no-error.
     4863   if error-status:error then do:
     4864     undo, return error substitute ("Ошибка при пересчете документа &1", return-value).
     4865   end.
     4866   run waitfram-hide in this-procedure no-error.
     4867   input  stream scan-file close.
     4868   output stream str-log   close.
     4869   output stream str-err   close.
     4870   if varerr then do:
     4871     message "При обработке данных из файла произошли ошибки. Дополнительная информация об ошибках в файле " varscan-name + ".err" " ."
     4872     view-as alert-box error.
     4873     run gbl/prnfilen.w
     4874       (input  "Ошибки и замечания, возникшие при наполнении документа из файла"
     4875       ,input  0
     4876       ,input  varscan-name + ".err"
     4877       ,input  7
     4878       ,output varuser-action
     4879       ,output varprinted
     4880       ).
     4881   end.
     4882   end.
