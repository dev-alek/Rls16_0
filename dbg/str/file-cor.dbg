     3776               varlastcur-base     = varprice-sale
     3777               varlastcur-road-tax = varroad-tax
     3778               varlastcur-excise   = varexcise
     3779               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3780               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3781               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3782               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3783             .
