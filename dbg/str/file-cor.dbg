     3896   procedure clcprtsl_calc-ttable :
     3897   define input parameter paris-doc           as   logical                 no-undo.
     3898   define input parameter paris-cur           as   logical                 no-undo.
     3899   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3900   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3901   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3902   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3903   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3904   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3905   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3906   define input parameter parr-b              as   character               no-undo.
     3907   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3908   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3909   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3910   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3911   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3912   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3913   define buffer bf_tt-allsum      for tt-allsum.
     3914   define buffer bf_tt-clcparts    for tt-clcparts.
     3915   define buffer bf_tt-allsum-line for tt-allsum-line.
     3916   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3917   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3918   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3919   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3920   define variable varexcise          like ub.price-list.excise     no-undo.
     3921   do on error undo, return error return-value :
     3922   for each bf_tt-allsum-line
     3923   on error undo, return error return-value
     3924    :
     3925     delete bf_tt-allsum-line.
