     2428   do on error undo, return error return-value :
     2429   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     2430   for each bf_tt-allsum on error undo, return error return-value :
     2431     delete bf_tt-allsum.
     2432   end.
     2433   assign
     2434     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     2435     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     2436   .
     2437   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2439     (output varinvprbcl
     2440     )  .
     2441     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2442        cl_tt-clcparts.out-code = 'out-zone':U   or
     2443        cl_tt-clcparts.doc-type = 'акт':U then do:
     2444       assign
     2445         in-vatp-have-vat-sltcl = yes.
     2446     end.
     2447     else do:
     2448       find first in-vatp_doc-attrcl no-lock
     2449         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2450           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2451         no-error .
     2452       if not available in-vatp_doc-attrcl then do:
     2453         assign
     2454           in-vatp-have-vat-sltcl = yes.
     2455       end.
     2456       else do:
     2457            in-vatp-have-vat-sltcl = no.
     2458       end.
     2459     end.
     2460     assign
     2461      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     2462      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     2463     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     2464              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     2465     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     2466             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     2467             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     2468             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     2469             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     2470             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     2471             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     2472       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     2473     assign
     2474       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     2475     assign
     2476       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     2477       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     2478       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     2479       transport-cli-loccl  = 0
     2480       other-cli-loccl      = 0
     2481     .
     2482   ASSIGN
     2483             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     2484       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     2485   .
     2486   if paris-doc then do:
     2487     assign
     2488       parartic     = cl_tt-clcparts.artic
     2489       parprod-type = cl_tt-clcparts.prod-type
     2490       parprod-code = cl_tt-clcparts.prod-code
     2491       pardoc-type  = cl_tt-clcparts.doc-type
     2492       pardoc-code  = cl_tt-clcparts.out-code
     2493       parobj-type  = cl_tt-clcparts.obj-type
     2494       parobj-code  = cl_tt-clcparts.obj-code.
     2495   if parext-doc-type = 'ot':U or
     2496      parext-doc-type = ?                 then do:
     2497     assign
     2498      out-vatp-have-vat-sltcl = yes.
     2499   end.
     2500   else do:
     2501     find first out-vatp_doc-attrcl no-lock
     2502       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     2503         and out-vatp_doc-attrcl.attr-code = 'envd':U
     2504         no-error .
     2505     if not available out-vatp_doc-attrcl then do:
     2506       assign
     2507         out-vatp-have-vat-sltcl = yes.
     2508     end.
     2509     else do:
     2510        out-vatp-have-vat-sltcl = no.
     2511     end.
     2512   end.
     2513   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
     2514                                      out-vatp_goodscl.prod-type = parprod-type and
     2515                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
     2516   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2518     (input  parartic
     2519     ,input  parprod-type
     2520     ,input  parprod-code
     2521     ,output varroot-nodecl
     2522     ) no-error .
     2523   if error-status :error then do:
     2524     message
     2525       vss-workfile vss-revision vss-description skip
     2526       "Ошибка при определении корневого признака товара" skip
     2527       "Артикул" parartic parprod-type parprod-code skip
     2528       error-status :get-message(1) skip
     2529       return-value skip
     2530       view-as alert-box error .
     2531     undo, return error .
     2532   end.
     2533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2534     (input  varroot-nodecl
     2535     ,input  'empty-scale=request'
     2536     ,output varempty-scalecl
     2537     ) no-error .
     2538   if error-status :error then do:
     2539     message
     2540       vss-workfile vss-revision vss-description skip
     2541       "Ошибка при определении атрибута признака" skip
     2542       "Артикул" parartic parprod-type parprod-code skip
     2543       "Признак" varroot-nodecl skip
