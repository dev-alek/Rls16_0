     4093   define variable varcode         as   character            no-undo.
     4094   define variable varprice        as   decimal              no-undo.
     4095   define variable varqnty         as   decimal              no-undo.
     4096   define variable varresult       as   character            no-undo.
     4097   define variable vartype-bc      as   character            no-undo.
