     4456                        'reserv':U
     4457                + "," + 'rsrv-single-part':U
     4458                + "," + 'rsrv-in-code':U   + "=" + str-encode(bf-free_parts.in-code,   "", ",=":u)
     4459                + "," + 'rsrv-part-code':U + "=" + str-encode(bf-free_parts.part-code, "", ",=":u)
     4460               , buffer bf_gds-dtl, input-output varfree-qnty, input-output bf_doc-line.price-base, input-output bf_doc-line.price-rubl, -1, "") no-error.
     4461       if error-status :error then do:
     4462         if tt-goods-query.rsrv-qnty = ? then do:
     4463           assign
     4464             varerr = yes.
     4465           put stream str-err unformatted substitute ("Ошибка при вызове процедуры rsrv-dtl &1 по партии &2 &3 &4 &5 &6 &7", return-value, bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_goods.gds-name, bf-free_parts.in-code, bf-free_parts.part-code) skip.
     4466         end.
     4467         undo, next free_parts_cycle.
     4468       end.
     4469       if varfree-qnty <> 0 then do:
     4470         if lookup('сер':U, bf_units.type) > 0 then do:
     4471           find first bf-have_parts where bf-have_parts.obj-type  = tt-free-parts.obj-type  and
     4472                                          bf-have_parts.obj-code  = tt-free-parts.obj-code  and
     4473                                          bf-have_parts.artic     = tt-free-parts.artic     and
     4474                                          bf-have_parts.prod-type = tt-free-parts.prod-type and
     4475                                          bf-have_parts.prod-code = tt-free-parts.prod-code and
     4476                                          bf-have_parts.in-code   = tt-free-parts.out-code  and
     4477                                          bf-have_parts.out-code  = tt-free-parts.out-code  and
     4478                                          bf-have_parts.part-code = tt-free-parts.part-code no-lock no-error.
     4479           if available bf-have_parts then do:
     4480             put stream str-err unformatted substitute ("Товар &1 &2 &3 &4 - серийный. Делаем коррекцию учетной цены по партии с кодом &5. Но в документе уже есть порожденная партия этого товара с таким кодом, либо в данном процессе должны породиться две партии с таким кодом.", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_goods.gds-name, bf-have_parts.part-code).
     4481             undo, next free_parts_cycle.
