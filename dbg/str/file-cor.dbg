        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as   handle              no-undo.
        3   define input  parameter pardoc-code   like ub.trn-doc.doc-code no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: 5baf537283c9, 2487, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        6   define variable vss-date        as character no-undo init "$Date: Пт июн 26 16:47:04 2020 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: file-cor.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/file-cor.p $":U .
        9   define variable vss-description as character no-undo init "Коррекция партий".
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define new global shared variable g#libbcrcn as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76     define variable v-cntxt-db-num        as integer   no-undo .
       77     define variable v-cntxt-userid        as character no-undo .
       78     define variable v-cntxt-level         as character no-undo .
       79     define variable v-cntxt-host-code-obj as integer   no-undo .
       80     define variable v-cntxt-obj-type      as character no-undo .
       81     define variable v-cntxt-obj-code      as integer   no-undo .
       82     define variable v-cntxt-db-num-obj    as integer   no-undo .
       83     define variable v-cntxt-is-admin      as logical   no-undo .
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85     run mainmenu_getcntxt in parparentproc
       86       (output v-cntxt-db-num
       87       ,output v-cntxt-userid
       88       ,output v-cntxt-level
       89       ,output v-cntxt-host-code-obj
       90       ,output v-cntxt-obj-type
       91       ,output v-cntxt-obj-code
       92       ,output v-cntxt-db-num-obj
       93       ,output v-cntxt-is-admin
       94       ) .
       95   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define variable v-waitfram-action01         as character   no-undo .
       97   define variable v-waitfram-action02         as character   no-undo .
       98   define variable v-waitfram-action03         as character   no-undo .
       99   define variable mWaitFramTextBeg            as character   no-undo.
      100   define variable mWaitFramTextEnd            as character   no-undo.
      101   define variable mWaitFramView               as logical     no-undo.
      102   define variable mWaitProcEvent              as logical     no-undo init yes.
      103   define variable mWaitFramInterval           as integer     no-undo init 1 .
      104   define variable mWaitFramStop               as logical     no-undo.
      105   define variable mWaitFramStopUser           as logical     no-undo.
      106   define variable mWaitFramStopTimeOut        as logical     no-undo.
      107   define variable mWaitFramStartProc          as datetime-tz no-undo.
      108   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      109   define button B-WaitFramStop auto-end-key
      110        label "Стоп"
      111        size 10 by 1 tooltip "Остоновить процесс".
      112   define button B-viewProcInfo
      113        label "Информация"
      114        size 15 by 1 tooltip "Информация о процесс".
      115   define frame waitfram
      116     v-waitfram-action01 format "x(72)" no-label skip
      117     v-waitfram-action02 format "x(72)" no-label skip
      118     v-waitfram-action03 format "x(72)" no-label skip
      119     B-viewProcInfo
      120     B-WaitFramStop at row 4 col 30
      121     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      122     .
      123   define new global shared variable mBatchMode as logical no-undo init ?.
      124   define variable mFramBachModHandle as handle no-undo.
      125   mFramBachModHandle = frame waitfram:handle.
      126   define variable mFameOldVis as logical no-undo.
      127   define variable mVisCUrentVin as logical no-undo.
      128   if session:batch-mode
      129   then
      130      mBatchMode = yes.
      131   if mBatchMode = ? then do:
      132     mVisCUrentVin = current-window:visible.
      133     mFameOldVis = mFramBachModHandle:visible.
      134     mFramBachModHandle:visible  = yes.
      135     mBatchMode = mFramBachModHandle:visible ne yes.
      136     mFramBachModHandle:visible = mFameOldVis.
      137     current-window:visible = mVisCUrentVin.
      138   end.
      139    if  log-manager:logfile-name ne ?
      140     then DO:
      141         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      142         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      143         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      144     end.
      145   on choose of B-WaitFramStop in frame waitfram
      146   do:
      147     mWaitFramStop = yes.
      148     mWaitFramStopUser = yes.
      149   end.
      150   function waitfram-check-timeout returns logical():
      151      define variable vtime as int64 no-undo.
      152      if mWaitFramStopTimeOut
      153      then
      154         return yes.
      155      vtime = ( now - mWaitFramStartProc ) / 1000 .
      156      if     mWaitFramTimeOut ne ?
      157         and mWaitFramTimeOut ne 0
      158         and mWaitFramTimeOut lt vtime
      159      then do:
      160         mWaitFramStopTimeOut = yes.
      161      end.
      162      return mWaitFramStopTimeOut.
      163   end.
      164   procedure waitfram-hide :
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       pause 0 before-hide .
      170       if not mBatchMode then
      171         hide frame waitfram .
      172     end.
      173   end procedure.
      174   procedure waitfram-show :
      175     define input  parameter p-message as character no-undo .
      176     define variable v-left-margin as integer   no-undo .
      177     if not session:batch-mode
      178     then do
      179     on error undo, return error return-value
      180     :
      181       if length(p-message) <= 70 then do:
      182         assign
      183           v-left-margin = integer((70 - length(p-message)) / 2)
      184         .
      185         assign
      186           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      187         .
      188         assign
      189           v-waitfram-action01 = " "
      190           v-waitfram-action02 = " "
      191                                    + fill(" ", v-left-margin)
      192                                    + p-message
      193           v-waitfram-action03 = " "
      194         .
      195       end.
      196       else do:
      197         define variable vRindex1 as integer no-undo.
      198         define variable vRindex2 as integer no-undo.
      199         vRindex1 = r-index(p-message," ",70).
      200         if vRindex1 = 0
      201         then
      202            vRindex1 = 70.
      203         if length(p-message)  <= vRindex1 + 70 then do:
      204           assign
      205             v-waitfram-action01 = " "
      206             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      208           .
      209         end.
      210         else do:
      211           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      212           if vRindex2 <= vRindex1
      213           then
      214              vRindex2 = vRindex1 + 70.
      215           assign
      216             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      217             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      218             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      219           .
      220         end.
      221       end.
      222       B-viewProcInfo:visible   in frame waitfram = no.
      223       B-viewProcInfo:sensitive in frame waitfram = no.
      224       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      225       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      226       if  (   mWaitFramView
      227          or  mWaitProcEvent)
      228          and not mBatchMode
      229       then
      230          display
      231             v-waitfram-action01 skip
      232             v-waitfram-action02 skip
      233             v-waitfram-action03 skip
      234          with frame waitfram .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   procedure cur-time :
      331      define output parameter p-today as date      no-undo .
      332      define output parameter p-time  as integer   no-undo .
      333     do
      334     on error undo, return error
      335     :
      336       define variable v-date1 as date      no-undo .
      337       define variable v-date2 as date      no-undo .
      338       define variable v-time  as integer   no-undo .
      339       assign
      340         v-date1 = today
      341         v-time  = time
      342         v-date2 = today
      343       .
      344       if v-date1 <> v-date2
      345       then do:
      346         assign
      347           v-date1 = today
      348           v-time  = v-time
      349         .
      350       end.
      351       assign
      352         p-today = v-date1
      353         p-time  = v-time
      354       .
      355     end.
      356   end.
      357   function cur-time-date returns character
      358   :
      359     return string(today, '99/99/9999':U) .
      360   end.
      361   function cur-time-mjd returns decimal
      362   :
      363     define variable v-date as date      no-undo .
      364     define variable v-time as integer   no-undo .
      365     run cur-time in this-procedure
      366       (output v-date
      367       ,output v-time
      368       ) .
      369     return integer(v-date) - 2400002 + (v-time / 86400) .
      370   end.
      371   function cur-time-get-ending-index returns integer
      372   (input p-number as integer
      373   )
      374   :
      375     if p-number < 0
      376     or p-number = ?
      377     then do:
      378       return 1 .
      379     end.
      380     define variable v-rest as integer   no-undo .
      381     assign
      382       p-number = p-number modulo 100
      383     .
      384     if p-number < 20
      385     then do:
      386       assign
      387         v-rest = p-number
      388       .
      389     end.
      390     else do:
      391       assign
      392         v-rest = p-number modulo 10
      393       .
      394     end.
      395     case v-rest :
      396       when 1
      397       then do:
      398         return 2 .
      399       end.
      400       when 2 or
      401       when 3 or
      402       when 4
      403       then do:
      404         return 3 .
      405       end.
      406       otherwise do:
      407         return 1 .
      408       end.
      409     end case .
      410   end.
      411   procedure cur-time-mjd-to-date :
      412      define input  parameter i-mjd-diff as decimal no-undo.
      413      define output parameter o-Date     as date    no-undo.
      414      define output parameter o-Time     as integer no-undo.
      415      define variable v-day-number as integer   no-undo .
      416      if    i-mjd-diff < 0
      417         or i-mjd-diff = ?
      418      then do:
      419         return "?" .
      420      end.
      421      assign
      422         v-day-number = truncate(i-mjd-diff,0).
      423         o-Date = date(v-day-number + 2400002).
      424         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      425     .
      426   end.
      427   function cur-time-mjd-to-string returns character
      428   (input p-mjd-diff as decimal
      429   )
      430   :
      431     define variable v-day-number as integer   no-undo .
      432     define variable v-seconds    as integer   no-undo .
      433     define variable v-hour       as integer   no-undo .
      434     define variable v-min        as integer   no-undo .
      435     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      436     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      437     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      438     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      439     if p-mjd-diff < 0
      440     or p-mjd-diff = ?
      441     then do:
      442       return "?" .
      443     end.
      444     assign
      445       v-day-number = integer(truncate(p-mjd-diff,0))
      446       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      447     .
      448     if v-seconds > 86400
      449     then do:
      450       assign
      451         v-seconds = 86400 - 1
      452       .
      453     end.
      454     if v-seconds < 0
      455     then do:
      456       assign
      457         v-seconds = 0
      458       .
      459     end.
      460     assign
      461       v-hour = truncate(v-seconds / 3600, 0)
      462     .
      463     assign
      464       v-seconds = v-seconds modulo 3600
      465     .
      466     assign
      467       v-min = truncate(v-seconds / 60, 0)
      468     .
      469     assign
      470       v-seconds = v-seconds modulo 60
      471     .
      472     return
      473         (if v-day-number <> 0
      474           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      475           else ""
      476         )
      477       + (if v-day-number <> 0 or v-hour <> 0
      478           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      479           else ""
      480         )
      481       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      482           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      483           else ""
      484         )
      485       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      486       .
      487   end.
      488   function cur-time-string returns character
      489   :
      490     define variable v-date as date      no-undo .
      491     define variable v-time as integer   no-undo .
      492     run cur-time in this-procedure
      493       (output v-date
      494       ,output v-time
      495       ) .
      496     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      497   end.
      498   function cur-time-string-sec returns character
      499   :
      500     define variable v-date as date      no-undo .
      501     define variable v-time as integer   no-undo .
      502     run cur-time in this-procedure
      503       (output v-date
      504       ,output v-time
      505       ) .
      506     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      507   end.
      508   function cur-time-custom  returns character
      509   (input p-prefix as character
      510   ,input p-date-format as character
      511   ,input p-delimiter as character
      512   ,input p-time-format as character
      513   ,input p-suffix as character
      514   )
      515   :
      516     define variable v-date as date      no-undo .
      517     define variable v-time as integer   no-undo .
      518     run cur-time in this-procedure
      519       (output v-date
      520       ,output v-time
      521       ) .
      522     return
      523       p-prefix
      524       + string(v-date, p-date-format)
      525       + p-delimiter
      526       + string(v-time, p-time-format)
      527       + p-suffix
      528       .
      529   end.
      530   function cur-time-print  returns character
      531   :
      532     define variable v-date as date      no-undo .
      533     define variable v-time as integer   no-undo .
      534     run cur-time in this-procedure
      535       (output v-date
      536       ,output v-time
      537       ) .
      538     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      539   end.
      540   function cur-time-datetime returns datetime
      541   :
      542     define variable v-char as character no-undo .
      543     define variable v-datetime as datetime no-undo .
      544     v-char = cur-time-string().
      545     v-datetime = datetime(v-char).
      546     return  v-datetime.
      547   end.
      548   function cur-time-string-msec returns character
      549   :
      550     define variable v-date as datetime  no-undo .
      551     v-date = now.
      552     return string(v-date) .
      553   end.
      554   function hvrdtax return logical (input parrecid as recid):
      555   define variable varresult as logical no-undo.
      556   run hvrdtax-proc (input parrecid, output varresult).
      557   return varresult.
      558   end function.
      559   procedure hvrdtax-proc:
      560   define input  parameter parrecid  as recid   no-undo.
      561   define output parameter parresult as logical no-undo.
      562   define buffer bf_goods for ub.goods.
      563   define buffer bf_units for ub.units.
      564   define buffer rt_tax   for ub.tax.
      565   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      566   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      567   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      568   if available rt_tax and
      569       can-find(first ub.tax-units No-LOCK WHERE
      570                      ub.tax-units.tax-code = rt_tax.tax-code AND
      571                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      572                                                       else assign parresult = no.
      573   end procedure.
      574   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   function octal-to-char return character
      576   ( p-string as character ) :
      577     def var v-asc     as integer no-undo .
      578     def var v-new-asc as integer no-undo .
      579     def var ind       as integer no-undo .
      580     if length(p-string) <> 3 then do:
      581       return ? .
      582     end.
      583     assign
      584       v-asc = 0
      585     .
      586     do ind = 1 to length(p-string)
      587     :
      588       assign
      589         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      590       .
      591       if v-new-asc < 0 or v-new-asc >= 8 then do:
      592         return ? .
      593       end.
      594       assign
      595         v-asc = v-asc * 8 + v-new-asc
      596       .
      597     end.
      598     return chr(v-asc) .
      599   end function .
      600   function char-to-octal return character
      601   ( p-chr as character ) :
      602     def var v-asc    as integer   no-undo .
      603     def var ind      as integer   no-undo .
      604     def var v-string as character no-undo .
      605     if length(p-chr) <> 1 then do:
      606       return ? .
      607     end.
      608     assign
      609       v-asc    = asc(p-chr)
      610       v-string = ""
      611     .
      612     do ind = 1 to 3
      613     :
      614       assign
      615         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      616       .
      617       assign
      618         v-asc = truncate(v-asc / 8, 0)
      619       .
      620     end.
      621     return v-string .
      622   end.
      623   function str-encode return character
      624   (   p-init-string       as character
      625     , p-encode-char       as character
      626     , p-special-char-list as character
      627   ) :
      628     def var p-encode-string as character no-undo .
      629     def var ind                as integer no-undo .
      630     def var v-num-special-char as integer no-undo .
      631     def var v-special-char     as character no-undo .
      632     if p-encode-char = ?
      633     or p-encode-char = "" then do:
      634       assign
      635         p-encode-char = "~~"
      636       .
      637     end.
      638     if p-init-string = ? then do:
      639       return "?" .
      640     end.
      641     if p-init-string = "?" then do:
      642       return p-encode-char + char-to-octal("?") .
      643     end.
      644     assign
      645       v-num-special-char = length(p-special-char-list)
      646       p-encode-string    = replace(p-init-string
      647                                   ,p-encode-char
      648                                   ,p-encode-char + char-to-octal(p-encode-char)
      649                                   )
      650     .
      651     do ind = 1 to v-num-special-char
      652     :
      653       assign
      654         v-special-char = substring(p-special-char-list, ind, 1)
      655       .
      656       if v-special-char <> p-encode-char then do:
      657         assign
      658           p-encode-string = replace (p-encode-string
      659                                     ,v-special-char
      660                                     ,p-encode-char + char-to-octal(v-special-char)
      661                                     )
      662         .
      663       end.
      664     end.
      665     return p-encode-string .
      666   end.
      667   function str-decode returns character
      668     (p-init-string   as character
      669     ,p-encode-char   as character
      670     ) :
      671     def var p-decode-string as character no-undo .
      672     def var ind                       as integer no-undo .
      673     def var v-num-entries-init-string as integer no-undo .
      674     def var v-sub-phrase              as character no-undo .
      675     def var v-special-char            as character no-undo .
      676     if p-encode-char = ?
      677     or p-encode-char = "" then do:
      678       assign
      679         p-encode-char = "~~"
      680       .
      681     end.
      682     if p-init-string = "?" then do:
      683       return ? .
      684     end.
      685     assign
      686       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      687     .
      688     if v-num-entries-init-string > 1 then do:
      689       assign
      690         p-decode-string = entry(1, p-init-string, p-encode-char)
      691       .
      692       do ind = 2 to v-num-entries-init-string
      693       :
      694         assign
      695           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      696         .
      697         assign
      698           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      699         .
      700         if v-special-char <> ? then do:
      701           assign
      702             p-decode-string = p-decode-string
      703                             + v-special-char
      704                             + substring(v-sub-phrase, 4)
      705           .
      706         end.
      707         else do:
      708           assign
      709             p-decode-string = p-decode-string
      710                             + p-encode-char
      711                             + v-sub-phrase
      712           .
      713         end.
      714       end.
      715     end.
      716     else do:
      717       assign
      718         p-decode-string = p-init-string
      719       .
      720     end.
      721     return p-decode-string .
      722   end.
      723   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   define new global shared variable g#trdcalib as handle no-undo.
      725   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   procedure holdprts-create-parts-supp :
      727     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
      728     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
      729     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
      730     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
      731     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
      732     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
      733     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
      734     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
      735     define buffer buf_parent_trn-doc  for ub.trn-doc .
      736     define buffer buf_child_trn-doc   for ub.trn-doc .
      737     define buffer buf_parts           for ub.parts .
      738     define buffer buf_parts-supp      for ub.parts-supp .
      739     define buffer buf_orig_parts-supp for ub.parts-supp .
      740     define buffer buf_income_trn-doc  for ub.trn-doc .
      741     define buffer buf_income_doc-line for ub.doc-line .
      742     define buffer buf_goods           for ub.goods .
      743       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      744       define buffer   in-vatp-parts    for ub.parts   .
      745       define buffer   in-vatp-doc      for ub.trn-doc .
      746       define buffer   in-vatp-goods    for ub.goods   .
      747       define buffer   in-vatp-sysconf  for ub.sysconf .
      748       define buffer   in-vatp_doc-attr for ub.doc-attr.
      749       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      750       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      751       define variable varinvprb                  as   character              no-undo.
      752       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      753       define variable cli-base-rate              as   decimal                no-undo.
      754       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      755       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      756       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      757       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      758       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      759       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      760       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      761       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      762       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      763       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      764       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      765       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      766       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      767       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      768       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      769       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      770       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      771       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      772       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      773       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      774       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      775       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      776       define variable varinvatp-envd             as   character              no-undo.
      777       define variable varinvatp-type             as   character              no-undo.
      778     do
      779     on error undo, return error return-value
      780     :
      781       find first buf_child_trn-doc no-lock
      782         where buf_child_trn-doc.doc-code = p-in-code
      783         no-error .
      784       if not available buf_child_trn-doc
      785       then do:
      786         return substitute("Не найден исходный документ &1", p-in-code) .
      787       end.
      788       find first buf_parent_trn-doc no-lock
      789         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
      790         no-error .
      791       if not available buf_parent_trn-doc
      792       then do:
      793         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
      794       end.
      795       find first buf_parts-supp exclusive-lock
      796         where buf_parts-supp.in-code   = p-in-code
      797           and buf_parts-supp.artic     = p-artic
      798           and buf_parts-supp.prod-type = p-prod-type
      799           and buf_parts-supp.prod-code = p-prod-code
      800           and buf_parts-supp.part-code = p-part-code
      801         no-error .
      802       if available buf_parts-supp
      803       then do:
      804         message
      805           vss-workfile vss-revision vss-description skip
      806           vss-include-info6 skip
      807           "Попытка повторного создания партии атрибутов" skip
      808           "Документ прихода" p-in-code skip
      809           "Артикул" p-artic p-prod-type p-prod-code skip
      810           "Код партии" p-part-code skip
      811           "Исходный код партии" p-orig-in-code skip
      812           "Исходный код документа" p-orig-part-code skip
      813           view-as alert-box error .
      814         undo, return error .
      815       end.
      816       create buf_parts-supp .
      817       assign
      818         buf_parts-supp.in-code   = p-in-code
      819         buf_parts-supp.artic     = p-artic
      820         buf_parts-supp.prod-type = p-prod-type
      821         buf_parts-supp.prod-code = p-prod-code
      822         buf_parts-supp.part-code = p-part-code
      823       .
      824       assign
      825         buf_parts-supp.orig-in-code   = p-orig-in-code
      826         buf_parts-supp.orig-part-code = p-orig-part-code
      827       .
      828       find first buf_orig_parts-supp share-lock
      829         where buf_orig_parts-supp.in-code   = p-orig-in-code
      830           and buf_orig_parts-supp.artic     = p-artic
      831           and buf_orig_parts-supp.prod-type = p-prod-type
      832           and buf_orig_parts-supp.prod-code = p-prod-code
      833           and buf_orig_parts-supp.part-code = p-orig-part-code
      834         no-error .
      835       if available buf_orig_parts-supp
      836       then do:
      837         buffer-copy buf_orig_parts-supp
      838         except
      839           buf_orig_parts-supp.in-code
      840           buf_orig_parts-supp.artic
      841           buf_orig_parts-supp.prod-type
      842           buf_orig_parts-supp.prod-code
      843           buf_orig_parts-supp.part-code
      844           buf_orig_parts-supp.orig-in-code
      845           buf_orig_parts-supp.orig-part-code
      846         to buf_parts-supp.
      847       end.
      848       else do:
      849         find first buf_parts share-lock
      850           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
      851             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
      852             and buf_parts.artic     = p-artic
      853             and buf_parts.prod-type = p-prod-type
      854             and buf_parts.prod-code = p-prod-code
      855             and buf_parts.in-code   = p-orig-in-code
      856             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
      857             and buf_parts.part-code = p-orig-part-code
      858           no-error .
      859         if not available buf_parts
      860         then do:
      861           message
      862             vss-workfile vss-revision vss-description skip
      863             vss-include-info6 skip
      864             "Ошибка задания входных параметров" skip
      865             "Не найдена исходная партия" skip
      866             "Исходный документ" p-orig-in-code skip
      867             "Артикул" p-artic p-prod-type p-prod-code skip
      868             "Код партии" p-orig-part-code skip
      869             view-as alert-box error .
      870           undo, return error .
      871         end.
      872         define variable v-base-rate         as decimal   no-undo .
      873         define variable v-base-scale        as integer   no-undo .
      874         define variable v-exch-rate         as decimal   no-undo .
      875         define variable v-exch-scale        as integer   no-undo .
      876         define variable v-extended-doc-type as character no-undo .
      877         define variable v-unit-cli          as character no-undo .
      878         find first buf_income_trn-doc no-lock
      879           where buf_income_trn-doc.doc-code = p-orig-in-code
      880           no-error .
      881         if available buf_income_trn-doc
      882         then do:
      883           find first buf_income_doc-line no-lock
      884             where buf_income_doc-line.doc-code  = p-orig-in-code
      885               and buf_income_doc-line.artic     = p-artic
      886               and buf_income_doc-line.prod-type = p-prod-type
      887               and buf_income_doc-line.prod-code = p-prod-code
      888             no-error .
      889           if not available buf_income_doc-line
      890           then do:
      891             message
      892               vss-workfile vss-revision vss-description skip
      893               vss-include-info6 skip
      894               "Не найдена исходная строка документа прихода" skip
      895               "Исходный документ" p-orig-in-code skip
      896               "Артикул" p-artic p-prod-type p-prod-code skip
      897               "Код партии" p-orig-part-code skip
      898               view-as alert-box error .
      899             undo, return error .
      900           end.
      901           assign
      902             v-base-rate         = buf_income_trn-doc.base-rate
      903             v-base-scale        = buf_income_trn-doc.base-scale
      904             v-exch-rate         = buf_income_trn-doc.exch-rate
      905             v-exch-scale        = buf_income_trn-doc.exch-scale
      906             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
      907             v-unit-cli          = buf_income_doc-line.unit-cli
      908           .
      909         end.
      910         else do:
      911           find first buf_goods no-lock
      912             where buf_goods.artic     = buf_parts.artic
      913               and buf_goods.prod-type = buf_parts.prod-type
      914               and buf_goods.prod-code = buf_parts.prod-code
      915             .
      916           assign
      917             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
      918             v-base-scale        = 1
      919             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
      920             v-exch-scale        = 1
      921             v-extended-doc-type = 'ie':U
      922             v-unit-cli          = buf_goods.unit-cli
      923           .
      924         end.
      925          if v-base-rate = ? then v-base-rate = 1.
      926          if v-exch-rate = ? then v-exch-rate = 1.
      927   assign
      928     price-rubl-with-tax-loc = buf_parts.price-rubl
      929     price-base-with-tax-loc = buf_parts.price-base
      930   .
      931   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      933     (output varinvprb
      934     )  .
      935     if buf_parts.out-code = 'free-zone':U     or
      936        buf_parts.out-code = 'out-zone':U   or
      937        buf_parts.doc-type = 'акт':U then do:
      938       assign
      939         in-vatp-have-vat-slt = yes.
      940     end.
      941     else do:
      942       find first in-vatp_doc-attr no-lock
      943         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      944           and in-vatp_doc-attr.attr-code = 'envd':U
      945         no-error .
      946       if not available in-vatp_doc-attr then do:
      947         assign
      948           in-vatp-have-vat-slt = yes.
      949       end.
      950       else do:
      951            in-vatp-have-vat-slt = no.
      952       end.
      953     end.
      954     assign
      955      price-cli-with-tax-loc = buf_parts.price-cli
      956      cli-base-rate          = buf_parts.cli-base-rate.
      957     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      958              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      959     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      960             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      961             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      962             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      963             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      964             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      965             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      966       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      967     assign
      968       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      969     assign
      970       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      971       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      972       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      973       transport-cli-loc  = 0
      974       other-cli-loc      = 0
      975     .
      976   ASSIGN
      977             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      978       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      979   .
      980         assign
      981           buf_parts-supp.PS                = buf_parts.PS
      982           buf_parts-supp.SLT-type          = buf_parts.SLT-type
      983           buf_parts-supp.VAT-type          = buf_parts.VAT-type
      984           buf_parts-supp.base-rate         = v-base-rate
      985           buf_parts-supp.base-scale        = v-base-scale
      986           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
      987           buf_parts-supp.cst-code          = buf_parts.cst-code
      988           buf_parts-supp.doc-qnty          = buf_parts.qnty
      989           buf_parts-supp.exch-code         = buf_parts.exch-code
      990           buf_parts-supp.exch-rate         = v-exch-rate
      991           buf_parts-supp.exch-scale        = v-exch-scale
      992           buf_parts-supp.extended-doc-type = v-extended-doc-type
      993           buf_parts-supp.fact-date         = buf_parts.fact-date
      994           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
      995           buf_parts-supp.last-date         = buf_parts.last-date
      996           buf_parts-supp.pay-code          = buf_parts.pay-code
      997           buf_parts-supp.price-cli         = buf_parts.price-cli
      998           buf_parts-supp.purch-code        = buf_parts.purch-code
      999           buf_parts-supp.supp-code         = buf_parts.supp-code
     1000           buf_parts-supp.supp-type         = buf_parts.supp-type
     1001           buf_parts-supp.unit-cli          = v-unit-cli
     1002         .
     1003         assign
     1004           buf_parts-supp.vat-pc         = vat-pc-loc
     1005           buf_parts-supp.slt-pc         = slt-pc-loc
     1006           buf_parts-supp.price-base     = price-base-with-tax-loc
     1007           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
     1008           buf_parts-supp.vat-base       = vat-base-loc
     1009           buf_parts-supp.vat-rubl       = vat-rubl-loc
     1010           buf_parts-supp.slt-base       = slt-base-loc
     1011           buf_parts-supp.slt-rubl       = slt-rubl-loc
     1012           buf_parts-supp.road-tax-base  = road-tax-base-loc
     1013           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
     1014           buf_parts-supp.transport-base = transport-base-loc
     1015           buf_parts-supp.transport-rubl = transport-rubl-loc
     1016           buf_parts-supp.other-base     = other-base-loc
     1017           buf_parts-supp.other-rubl     = other-rubl-loc
     1018         .
     1019       end.
     1020     end.
     1021   end procedure.
     1022   procedure holdprts-get-part-code :
     1023     define input  parameter p-doc-code       as character no-undo .
     1024     define output parameter p-hold-part-code as integer   no-undo .
     1025     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
     1026     define variable v-attr-value as character no-undo .
     1027     define variable v-attr-type  as character no-undo .
     1028     define buffer buf_trn-doc for ub.trn-doc .
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032       find first buf_trn-doc exclusive-lock
     1033         where buf_trn-doc.doc-code = p-doc-code
     1034         no-error .
     1035       if not available buf_trn-doc
     1036       then do:
     1037         message
     1038           vss-workfile vss-revision vss-description skip
     1039           vss-include-info6 skip
     1040           "Ошибка задания входных параметров" skip
     1041           "Не найден документ" p-doc-code skip
     1042           view-as alert-box error .
     1043         undo, return error .
     1044       end.
     1045   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1046                           input 'hold-part-code':U ,
     1047                          output v-attr-value ,
     1048                          output v-attr-type )  .
     1049       assign
     1050         p-hold-part-code = integer(v-attr-value) + 1
     1051       .
     1052   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     1053                          input 'hold-part-code':U ,
     1054                          input string(p-hold-part-code) )  .
     1055     end.
     1056   end procedure.
     1057   procedure holdprts-validate-document :
     1058     define input  parameter p-doc-code as character no-undo .
     1059     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
     1060     define buffer buf_trn-doc    for ub.trn-doc .
     1061     define buffer parent_trn-doc for ub.trn-doc .
     1062     define buffer buf_parts      for ub.parts .
     1063     define buffer buf_parts-supp for ub.parts-supp .
     1064     do
     1065     on error undo, return error return-value
     1066     :
     1067       find first buf_trn-doc exclusive-lock
     1068         where buf_trn-doc.doc-code = p-doc-code
     1069         no-error .
     1070       if not available buf_trn-doc
     1071       then do:
     1072         message
     1073           vss-workfile vss-revision vss-description skip
     1074           vss-include-info6 skip
     1075           "Ошибка задания входных параметров" skip
     1076           "Не найден документ" p-doc-code skip
     1077           view-as alert-box error .
     1078         undo, return error .
     1079       end.
     1080       find first parent_trn-doc exclusive-lock
     1081         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
     1082         no-error .
     1083       if not available parent_trn-doc
     1084       then do:
     1085         message
     1086           vss-workfile vss-revision vss-description skip
     1087           vss-include-info6 skip
     1088           "Не найден родительский документ" skip
     1089           "Документ" buf_trn-doc.doc-code skip
     1090           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     1091           view-as alert-box error .
     1092         undo, return error .
     1093       end.
     1094       if buf_trn-doc.ext-doc-type <> 'ie':U
     1095       then do:
     1096         return .
     1097       end.
     1098       for each buf_parts share-lock
     1099         where buf_parts.out-code = buf_trn-doc.doc-code
     1100       on error undo, return error
     1101       :
     1102         find first buf_parts-supp share-lock
     1103           where buf_parts-supp.in-code   = buf_parts.in-code
     1104             and buf_parts-supp.artic     = buf_parts.artic
     1105             and buf_parts-supp.prod-type = buf_parts.prod-type
     1106             and buf_parts-supp.prod-code = buf_parts.prod-code
     1107             and buf_parts-supp.part-code = buf_parts.part-code
     1108           no-error .
     1109         if not available buf_parts-supp
     1110         then do:
     1111           message
     1112             vss-workfile vss-revision vss-description skip
     1113             vss-include-info6 skip
     1114             "Не найдена информация о поставщике" skip
     1115             "Документ" buf_trn-doc.doc-code skip
     1116             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     1117             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1118             "Номер партии" buf_parts.part-code skip
     1119             view-as alert-box error .
     1120           undo, return error .
     1121         end.
     1122       end.
     1123       for each buf_parts-supp share-lock
     1124         where buf_parts-supp.in-code = buf_trn-doc.doc-code
     1125       on error undo, return error
     1126       :
     1127         find first buf_parts share-lock
     1128           where buf_parts.out-code  = buf_parts-supp.in-code
     1129             and buf_parts.obj-type  = buf_trn-doc.obj-type
     1130             and buf_parts.obj-code  = buf_trn-doc.obj-code
     1131             and buf_parts.artic     = buf_parts-supp.artic
     1132             and buf_parts.prod-type = buf_parts-supp.prod-type
     1133             and buf_parts.prod-code = buf_parts-supp.prod-code
     1134             and buf_parts.part-code = buf_parts-supp.part-code
     1135           no-error .
     1136         if not available buf_parts
     1137         then do:
     1138           message
     1139             vss-workfile vss-revision vss-description skip
     1140             vss-include-info6 skip
     1141             "Задана информация о поставщике для неизвестной партии" skip
     1142             "Документ" buf_trn-doc.doc-code skip
     1143             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     1144             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1145             "Номер партии" buf_parts.part-code skip
     1146             view-as alert-box error .
     1147           undo, return error .
     1148         end.
     1149       end.
     1150       for each buf_parts share-lock
     1151         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
     1152       on error undo, return error
     1153       :
     1154         if  buf_trn-doc.doc-type = 'при':U
     1155         and buf_parts.qnty = buf_parts.fact-qnty
     1156         then do:
     1157           next.
     1158         end.
     1159         find first buf_parts-supp share-lock
     1160           where buf_parts-supp.orig-in-code   = buf_parts.in-code
     1161             and buf_parts-supp.artic          = buf_parts.artic
     1162             and buf_parts-supp.prod-type      = buf_parts.prod-type
     1163             and buf_parts-supp.prod-code      = buf_parts.prod-code
     1164             and buf_parts-supp.orig-part-code = buf_parts.part-code
     1165           no-error .
     1166         if not available buf_parts-supp
     1167         then do:
     1168           message
     1169             vss-workfile vss-revision vss-description skip
     1170             vss-include-info6 skip
     1171             "Не найдена информация о поставщике для исходной накладной" skip
     1172             "Документ" buf_trn-doc.doc-code skip
     1173             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
     1174             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1175             "Номер партии" buf_parts.part-code skip
     1176             view-as alert-box error .
     1177           undo, return error .
     1178         end.
     1179       end.
     1180     end.
     1181   end procedure.
     1182   procedure holdprts-doc-type :
     1183     define input  parameter p-cat-code as integer   no-undo .
     1184     define input  parameter p-doc-code as character no-undo .
     1185     define output parameter p-is-sale  as logical   no-undo .
     1186     define output parameter p-is-purch as logical   no-undo .
     1187     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
     1188     define buffer buf_trn-doc for ub.trn-doc .
     1189     do
     1190     on error undo, return error return-value
     1191     :
     1192       find first buf_trn-doc no-lock
     1193         where buf_trn-doc.doc-code = p-doc-code
     1194         no-error .
     1195       if not available buf_trn-doc
     1196       then do:
     1197         message
     1198           vss-workfile vss-revision vss-description skip
     1199           vss-include-info6 skip
     1200           "Ошибка задания входных параметров" skip
     1201           "Не найден документ" skip
     1202           "Документ" p-doc-code skip
     1203           "Тип архива" p-cat-code skip
     1204           view-as alert-box error .
     1205         undo, return error .
     1206       end.
     1207       case p-cat-code :
     1208         when 1
     1209         then do:
     1210           define variable v-is-hold as logical   no-undo .
     1211   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     1213     (input  buf_trn-doc.doc-code
     1214     ,output v-is-hold
     1215     )  .
     1216           if v-is-hold = true
     1217           then do:
     1218             assign
     1219               p-is-sale  = false
     1220               p-is-purch = false
     1221             .
     1222           end.
     1223           else do:
     1224             case buf_trn-doc.ext-doc-type :
     1225               when 'ie':U or
     1226               when 'ep':U
     1227               then do:
     1228                 assign
     1229                   p-is-sale  = false
     1230                   p-is-purch = true
     1231                 .
     1232               end.
     1233               when 'ee':U or
     1234               when 'es':U or
     1235               when 're':U or
     1236               when 'rs':U
     1237               then do:
     1238                 assign
     1239                   p-is-sale  = true
     1240                   p-is-purch = false
     1241                 .
     1242               end.
     1243               when 'we':U or
     1244               when 'vt':U or
     1245               when 'vp':U or
     1246               when 'ap':U or
     1247               when 'mp':U or
     1248               when 'pc':U or
     1249               when 'iv':U or
     1250               when 'ev':U or
     1251               when 'io':U or
     1252               when 'eo':U or
     1253               when 'rv':U or
     1254               when 'em':U or
     1255               when 'wm':U or
     1256               when 'im':U
     1257               then do:
     1258                 assign
     1259                   p-is-sale  = false
     1260                   p-is-purch = false
     1261                 .
     1262               end.
     1263               otherwise do:
     1264                 message
     1265                   vss-workfile vss-revision vss-description skip
     1266                   vss-include-info6 skip
     1267                   "Неизвестный тип документа" skip
     1268                   "Документ" buf_trn-doc.doc-code skip
     1269                   "Тип документа" buf_trn-doc.ext-doc-type skip
     1270                   "Тип архива" p-cat-code skip
     1271                   view-as alert-box error .
     1272                 undo, return error .
     1273               end.
     1274             end.
     1275           end.
     1276         end.
     1277         when 2
     1278         then do:
     1279           case buf_trn-doc.ext-doc-type :
     1280             when 'vt':U or
     1281             when 'vp':U
     1282             then do:
     1283               assign
     1284                 p-is-sale  = false
     1285                 p-is-purch = true
     1286               .
     1287             end.
     1288             otherwise do:
     1289               assign
     1290                 p-is-sale  = false
     1291                 p-is-purch = false
     1292               .
     1293             end.
     1294           end.
     1295         end.
     1296         when 3
     1297         then do:
     1298           case buf_trn-doc.ext-doc-type :
     1299             when 'we':U
     1300             then do:
     1301               assign
     1302                 p-is-sale  = false
     1303                 p-is-purch = true
     1304               .
     1305             end.
     1306             otherwise do:
     1307               assign
     1308                 p-is-sale  = false
     1309                 p-is-purch = false
     1310               .
     1311             end.
     1312           end.
     1313         end.
     1314         otherwise do:
     1315           message
     1316             vss-workfile vss-revision vss-description skip
     1317             "Неизвестный тип архивов" skip
     1318             "Документ" buf_trn-doc.doc-code skip
     1319             "Тип документа" buf_trn-doc.ext-doc-type skip
     1320             "Тип архива" p-cat-code skip
     1321             view-as alert-box error .
     1322           undo, return error return-value .
     1323         end.
     1324       end.
     1325     end.
     1326   end procedure.
     1327   procedure holdprts-purch-values :
     1328     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
     1329     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
     1330     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
     1331     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
     1332     define output parameter p-fact-qnty            as decimal   no-undo .
     1333     define output parameter p-purch-sum-base       as decimal   no-undo .
     1334     define output parameter p-purch-sum-rubl       as decimal   no-undo .
     1335     define output parameter p-purch-VAT-base       as decimal   no-undo .
     1336     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
     1337     define output parameter p-purch-SLT-base       as decimal   no-undo .
     1338     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
     1339     define output parameter p-purch-road-tax-base  as decimal   no-undo .
     1340     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
     1341     define output parameter p-purch-excise-base    as decimal   no-undo .
     1342     define output parameter p-purch-excise-rubl    as decimal   no-undo .
     1343     define output parameter p-purch-transport-base as decimal   no-undo .
     1344     define output parameter p-purch-transport-rubl as decimal   no-undo .
     1345     define output parameter p-purch-other-base     as decimal   no-undo .
     1346     define output parameter p-purch-other-rubl     as decimal   no-undo .
     1347     define output parameter p-purch-discnt-base    as decimal   no-undo .
     1348     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
     1349     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
     1350     define variable v-price-base     as decimal   no-undo .
     1351     define variable v-price-rubl     as decimal   no-undo .
     1352     define variable v-VAT-base       as decimal   no-undo .
     1353     define variable v-VAT-rubl       as decimal   no-undo .
     1354     define variable v-SLT-base       as decimal   no-undo .
     1355     define variable v-SLT-rubl       as decimal   no-undo .
     1356     define variable v-road-tax-base  as decimal   no-undo .
     1357     define variable v-road-tax-rubl  as decimal   no-undo .
     1358     define variable v-transport-base as decimal   no-undo .
     1359     define variable v-transport-rubl as decimal   no-undo .
     1360     define variable v-other-base     as decimal   no-undo .
     1361     define variable v-other-rubl     as decimal   no-undo .
     1362     define buffer buf_trn-doc        for ub.trn-doc .
     1363     define buffer buf_parts          for ub.parts .
     1364     define buffer buf_parts-supp     for ub.parts-supp .
     1365     define buffer buf_doc-line       for ub.doc-line .
     1366     define buffer buf_income_trn-doc for ub.trn-doc .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       find first buf_trn-doc no-lock
     1371         where buf_trn-doc.doc-code = p-doc-code
     1372         no-error .
     1373       if not available buf_trn-doc
     1374       then do:
     1375         message
     1376           vss-workfile vss-revision vss-description skip
     1377           vss-include-info6 skip
     1378           "Ошибка задания входных параметров" skip
     1379           "Не найден документ" skip
     1380           "Документ" p-doc-code skip
     1381           view-as alert-box error .
     1382         undo, return error .
     1383       end.
     1384       find first buf_doc-line no-lock
     1385         where buf_doc-line.doc-code  = p-doc-code
     1386           and buf_doc-line.artic     = p-artic
     1387           and buf_doc-line.prod-type = p-prod-type
     1388           and buf_doc-line.prod-code = p-prod-code
     1389         no-error .
     1390       if not available buf_doc-line
     1391       then do:
     1392         message
     1393           vss-workfile vss-revision vss-description skip
     1394           vss-include-info6 skip
     1395           "Ошибка задания входных параметров" skip
     1396           "Не найдена строка документа" skip
     1397           "Документ" p-doc-code skip
     1398           "Артикул" p-artic p-prod-type p-prod-code skip
     1399           view-as alert-box error .
     1400         undo, return error .
     1401       end.
     1402       assign
     1403         p-fact-qnty            = 0
     1404         p-purch-sum-base       = 0
     1405         p-purch-sum-rubl       = 0
     1406         p-purch-VAT-base       = 0
     1407         p-purch-VAT-rubl       = 0
     1408         p-purch-SLT-base       = 0
     1409         p-purch-SLT-rubl       = 0
     1410         p-purch-road-tax-base  = 0
     1411         p-purch-road-tax-rubl  = 0
     1412         p-purch-excise-base    = 0
     1413         p-purch-excise-rubl    = 0
     1414         p-purch-transport-base = 0
     1415         p-purch-transport-rubl = 0
     1416         p-purch-other-base     = 0
     1417         p-purch-other-rubl     = 0
     1418         p-purch-discnt-base    = 0
     1419         p-purch-discnt-rubl    = 0
     1420       .
     1421       for each buf_parts no-lock
     1422         where buf_parts.out-code  = buf_doc-line.doc-code
     1423           and buf_parts.obj-type  = buf_doc-line.obj-type
     1424           and buf_parts.obj-code  = buf_doc-line.obj-code
     1425           and buf_parts.artic     = buf_doc-line.artic
     1426           and buf_parts.prod-type = buf_doc-line.prod-type
     1427           and buf_parts.prod-code = buf_doc-line.prod-code
     1428       on error undo, return error
     1429       :
     1430         define variable v-parts-qnty as decimal   no-undo .
     1431         assign
     1432           v-parts-qnty = buf_parts.fact-qnty
     1433                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
     1434                            then -1
     1435                            else 1
     1436                          )
     1437         .
     1438         find first buf_parts-supp no-lock
     1439           where buf_parts-supp.in-code   = buf_parts.in-code
     1440             and buf_parts-supp.artic     = buf_parts.artic
     1441             and buf_parts-supp.prod-type = buf_parts.prod-type
     1442             and buf_parts-supp.prod-code = buf_parts.prod-code
     1443             and buf_parts-supp.part-code = buf_parts.part-code
     1444           no-error .
     1445         if available buf_parts-supp
     1446         then do:
     1447           assign
     1448             v-price-base     = buf_parts-supp.price-base
     1449             v-price-rubl     = buf_parts-supp.price-rubl
     1450             v-VAT-base       = buf_parts-supp.VAT-base
     1451             v-VAT-rubl       = buf_parts-supp.VAT-rubl
     1452             v-SLT-base       = buf_parts-supp.SLT-base
     1453             v-SLT-rubl       = buf_parts-supp.SLT-rubl
     1454             v-road-tax-base  = buf_parts-supp.road-tax-base
     1455             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
     1456             v-transport-base = buf_parts-supp.transport-base
     1457             v-transport-rubl = buf_parts-supp.transport-rubl
     1458             v-other-base     = buf_parts-supp.other-base
     1459             v-other-rubl     = buf_parts-supp.other-rubl
     1460           .
     1461         end.
     1462         else do:
     1463       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1464       define buffer   in-vatp-parts    for ub.parts   .
     1465       define buffer   in-vatp-doc      for ub.trn-doc .
     1466       define buffer   in-vatp-goods    for ub.goods   .
     1467       define buffer   in-vatp-sysconf  for ub.sysconf .
     1468       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1469       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1470       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1471       define variable varinvprb                  as   character              no-undo.
     1472       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1473       define variable cli-base-rate              as   decimal                no-undo.
     1474       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1475       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1476       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1477       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1478       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1479       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1480       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1481       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1482       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1483       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1484       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1485       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1486       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1487       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1488       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1489       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1490       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1491       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1492       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1493       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1494       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1495       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1496       define variable varinvatp-envd             as   character              no-undo.
     1497       define variable varinvatp-type             as   character              no-undo.
     1498   assign
     1499     price-rubl-with-tax-loc = buf_parts.price-rubl
     1500     price-base-with-tax-loc = buf_parts.price-base
     1501   .
     1502   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1504     (output varinvprb
     1505     )  .
     1506     if buf_parts.out-code = 'free-zone':U     or
     1507        buf_parts.out-code = 'out-zone':U   or
     1508        buf_parts.doc-type = 'акт':U then do:
     1509       assign
     1510         in-vatp-have-vat-slt = yes.
     1511     end.
     1512     else do:
     1513       find first in-vatp_doc-attr no-lock
     1514         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1515           and in-vatp_doc-attr.attr-code = 'envd':U
     1516         no-error .
     1517       if not available in-vatp_doc-attr then do:
     1518         assign
     1519           in-vatp-have-vat-slt = yes.
     1520       end.
     1521       else do:
     1522            in-vatp-have-vat-slt = no.
     1523       end.
     1524     end.
     1525     assign
     1526      price-cli-with-tax-loc = buf_parts.price-cli
     1527      cli-base-rate          = buf_parts.cli-base-rate.
     1528     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1529              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1530     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1531             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1532             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1533             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1534             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1535             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1536             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1537       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1538     assign
     1539       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1540     assign
     1541       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1542       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1543       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1544       transport-cli-loc  = 0
     1545       other-cli-loc      = 0
     1546     .
     1547   ASSIGN
     1548             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1549       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1550   .
     1551           assign
     1552             v-price-base     = price-base-with-tax-loc
     1553             v-price-rubl     = price-rubl-with-tax-loc
     1554             v-VAT-base       = vat-base-loc
     1555             v-VAT-rubl       = vat-rubl-loc
     1556             v-SLT-base       = slt-base-loc
     1557             v-SLT-rubl       = slt-rubl-loc
     1558             v-road-tax-base  = road-tax-base-loc
     1559             v-road-tax-rubl  = road-tax-rubl-loc
     1560             v-transport-base = transport-base-loc
     1561             v-transport-rubl = transport-rubl-loc
     1562             v-other-base     = other-base-loc
     1563             v-other-rubl     = other-rubl-loc
     1564           .
     1565         end.
     1566         assign
     1567           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
     1568           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
     1569           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
     1570           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
     1571           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
     1572           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
     1573           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
     1574           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
     1575           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
     1576           p-purch-excise-base    = p-purch-excise-base    + 0
     1577           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
     1578           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
     1579           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
     1580           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
     1581           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
     1582           p-purch-discnt-base    = p-purch-discnt-base    + 0
     1583           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
     1584         .
     1585       end.
     1586     end.
     1587   end procedure.
     1588   procedure holdprts-sale-values :
