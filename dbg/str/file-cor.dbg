     4099   define variable varrec-line     as   recid                no-undo.
     4100   define variable varn-c          like ub.gds-prt.node-code no-undo.
     4101   define variable varunrsrv-qnty  as   decimal              no-undo.
     4102   define variable l-goods-twounit as   logical              no-undo.
