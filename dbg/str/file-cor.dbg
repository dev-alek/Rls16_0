     4364               "Товар: " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name "."
     4365               "Объект: " bf_trn-doc.obj-type " " bf_trn-doc.obj-code
     4366               "Поставщик " bf_trn-doc.cli-type " " bf_trn-doc.cli-code " " bf_trn-doc.cli-name " "
     4367               (if available bf_contract then "Договор " + bf_contract.contract-prn-code else "")
     4368               "Нет товара от поставщика в свободной зоне на объекте."
