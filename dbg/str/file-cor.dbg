     4391                                  bf-free_parts.obj-code      = bf_trn-doc.obj-code      and
     4392                                  bf-free_parts.rsrv-free     = yes                      and
     4393                                  bf-free_parts.out-code      = 'free-zone':U             and
     4394                                  bf-free_parts.prod-type     = bf_doc-line.prod-type    and
     4395                                  bf-free_parts.prod-code     = bf_doc-line.prod-code    and
     4396                                  bf-free_parts.artic         = bf_doc-line.artic        and
     4397                                  bf-free_parts.contract-code = bf_trn-doc.contract-code on error undo, return error return-value :
     4398   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4400     (input  bf_doc-line.artic
