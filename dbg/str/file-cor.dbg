     4110   do on error undo, return error return-value :
     4111   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code exclusive-lock no-error.
     4112   if not available bf_trn-doc then do:
     4113    return error substitute ("Не найден документ с номером .", pardoc-code).
     4114   end.
     4115   if bf_trn-doc.ext-doc-type <> 'ap':U then do:
     4116     return error substitute ("Документ с номером &1 не является документом коррекции учетной цены.", pardoc-code).
     4117   end.
     4118   system-dialog get-file varscan-txt
     4119     title "Выберите файл со сканера"
     4120     update varlog.
     4121   if not varlog then do:
     4122     return error.
     4123   end.
     4124   if entry (2, varscan-txt, ".") = "err" then do:
     4125     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
     4126     return error.
     4127   end.
     4128   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
     4129                           input 'scanfile':U ,
     4130                          output varvalue ,
     4131                          output vartype ) no-error .
     4132   if lookup (varscan-txt, varvalue) <> 0 then do:
     4133     message "Файл с названием " varscan-txt " уже загружался в документ " bf_trn-doc.doc-code " ." skip
     4134             "Продолжить?" view-as alert-box question buttons yes-no update varlog.
     4135     if varlog <> yes then do:
     4136       return error.
     4137     end.
     4138   end.
     4139   else do:
     4140     assign
     4141       varline-file = varvalue + min (",", varvalue) + varscan-txt no-error.
     4142   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bf_trn-doc.doc-code ,
     4143                          input 'scanfile':U ,
     4144                          input varline-file ) no-error .
     4145   end.
     4146   assign
     4147     varscan-name = entry (1, varscan-txt, ".").
     4148   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4149   define variable varscales-pref as character no-undo .
     4150   define variable varpgscales-pref as character no-undo .
     4151   define variable varscales-pref-type27 as character no-undo.
     4152   varscales-pref  = ?.
     4153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4154     (input  'sclspref':u
     4155     ,input  '':u
     4156     ,input  '':u
     4157     ,input  0
     4158     ,input  '':u
     4159     ,input  '':u
     4160     ,input  '':u
     4161     ,input  no
     4162     ,output varscales-pref
     4163     ,output varscales-pref-type27
     4164     ) no-error .
     4165   if varscales-pref = ? then do:
     4166     assign
     4167     varscales-pref = '21,23,25':U.
     4168   end.
     4169   define variable varpgscales-pref-type27 as character no-undo.
     4170   varpgscales-pref  = ?.
     4171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4172     (input  'scpgpref':u
     4173     ,input  '':u
     4174     ,input  '':u
     4175     ,input  0
     4176     ,input  '':u
     4177     ,input  '':u
     4178     ,input  '':u
     4179     ,input  no
     4180     ,output varpgscales-pref
     4181     ,output varpgscales-pref-type27
     4182     ) no-error .
     4183   if varpgscales-pref = ? then do:
     4184     assign
     4185     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     4186   end.
     4187   input  stream scan-file from value (varscan-txt).
     4188   output stream str-log   to   value (varscan-name + ".log").
     4189   output stream str-err   to   value (varscan-name + ".err").
     4190   put stream str-log unformatted "  " skip.
     4191   put stream str-log unformatted cur-time-string-sec() skip.
     4192   put stream str-log unformatted " " skip skip "Накладная: " bf_trn-doc.doc-code " Расширенный тип: " bf_trn-doc.ext-doc-type  " Статус: " bf_trn-doc.status_ + string (bf_trn-doc.flag_, "+/-") skip skip.
     4193   run waitfram-show in this-procedure ("Считывание файла : " + varscan-txt).
     4194   assign
     4195     vartime = time
     4196     varnum  = 0.
     4197   repeat :
     4198     assign
     4199       varfile-str = "":u.
     4200     import stream scan-file unformatted varfile-str.
     4201     if varfile-str <> "" and
     4202        varfile-str <> ?  then do:
     4203       assign
     4204        varnum = varnum + 1.
     4205       run waitfram-show in this-procedure (substitute("Загрузка файла. Всего считано &1. Время &2.", varnum, string (time - vartime, "hh:mm:ss"))).
     4206       create tt-in.
     4207       assign tt-in.ln  = varnum.
     4208              tt-in.str = varfile-str.
     4209       put stream str-log unformatted tt-in.ln ": Загружена строка " tt-in.str skip.
     4210       release tt-in.
     4211     end.
     4212   end.
     4213   run waitfram-show in this-procedure (substitute ("Разбор данных из файла : &1", varscan-txt)).
     4214   assign
     4215     varnum = 0.
     4216   tt-in_cycle:
     4217   for each tt-in on error undo, return error return-value :
     4218     assign
     4219       varnum = varnum + 1.
     4220     if num-entries(tt-in.str) < 2 or
     4221        num-entries(tt-in.str) > 3 then do:
     4222        put stream str-err unformatted "Ошибка при разборе строки номер " tt-in.ln ". Неверное число параметров в строке " tt-in.str ". Должно быть 2 или 3 параметра в соответствии с форматом 'код,цена[,кол-во]'." skip.
     4223        assign
     4224          varerr = yes.
     4225        next tt-in_cycle.
     4226     end.
     4227     assign
     4228       varcode = entry (1, tt-in.str).
     4229     assign
     4230       varprice = decimal (entry (2, tt-in.str)) no-error.
     4231     if error-status :error then do:
     4232       put stream str-err unformatted "Ошибка при разборе строки номер " tt-in.ln ". Неверный формат цены (2-ой параметр) " tt-in.str ". Он должен соответсвовать формату decimal." skip.
     4233       assign
