     1687       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1688       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1689       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
