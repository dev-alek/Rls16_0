     4496         create bf-new_parts .
     4497         buffer-copy tt-free-parts
     4498         except in-code
     4499                out-code
     4500                part-code
     4501                rsrv-free
     4502                status_
     4503                qnty
     4504                fact-qnty
     4505                real-qnty
     4506                cli-qnty
     4507                price-rubl
     4508                price-base
     4509                road-tax-rubl
     4510                road-tax-base
     4511                transport-rubl
     4512                transport-base
     4513                other-rubl
     4514                other-base
     4515                price-cli
     4516                cli-base-rate
     4517                vat-type
     4518                slt-type
     4519                exch-code
     4520                to bf-new_parts.
     4521         assign
     4522           bf-new_parts.in-code         = bf_trn-doc.doc-code
     4523           bf-new_parts.out-code        = bf_trn-doc.doc-code
     4524           bf-new_parts.part-code       = varpart-code
     4525           bf-new_parts.rsrv-free       = ?
     4526           bf-new_parts.status_         = no
     4527           bf-new_parts.qnty            = - varfree-qnty
     4528           bf-new_parts.fact-qnty       = - varfree-qnty
     4529           bf-new_parts.real-qnty       = 0
     4530           bf-new_parts.price-rubl      = tt-goods-query.price
     4531           bf-new_parts.road-tax-rubl   = tt-free-parts.road-tax-rubl
     4532           bf-new_parts.transport-rubl  = tt-free-parts.transport-rubl
     4533           bf-new_parts.other-rubl      = tt-free-parts.other-rubl
     4534           .
     4535         find first bf_parts-attr where bf_parts-attr.in-code   = tt-free-parts.in-code   and
     4536                                        bf_parts-attr.gds-code  = bf_goods.gds-code       and
     4537                                        bf_parts-attr.part-code = tt-free-parts.part-code no-error.
     4538         if available bf_parts-attr then do:
     4539           assign
     4540             bf-new_parts.price-base      = bf-new_parts.price-rubl     / bf_parts-attr.base-rate * bf_parts-attr.base-scale
     4541             bf-new_parts.road-tax-base   = bf-new_parts.road-tax-rubl  / bf_parts-attr.base-rate * bf_parts-attr.base-scale
     4542             bf-new_parts.transport-base  = bf-new_parts.transport-rubl / bf_parts-attr.base-rate * bf_parts-attr.base-scale
     4543             bf-new_parts.other-base      = bf-new_parts.other-rubl     / bf_parts-attr.base-rate * bf_parts-attr.base-scale
     4544             bf-new_parts.exch-code       = tt-free-parts.exch-code
     4545             bf-new_parts.cli-base-rate   = tt-free-parts.cli-base-rate
     4546             bf-new_parts.cli-qnty        = - varfree-qnty / tt-free-parts.cli-base-rate
     4547             bf-new_parts.vat-type        = 'в т. ч.':U
     4548             bf-new_parts.slt-type        = 'в т. ч.':U
     4549             bf-new_parts.price-cli       = bf-new_parts.price-rubl * bf-new_parts.cli-base-rate / bf_parts-attr.exch-rate * bf_parts-attr.exch-scale
     4550           .
     4551         end.
     4552         else do:
     4553           assign
     4554             bf-new_parts.price-base      = bf-new_parts.price-rubl     / tt-free-parts.price-rubl * tt-free-parts.price-base
     4555             bf-new_parts.road-tax-base   = bf-new_parts.road-tax-rubl  / tt-free-parts.price-rubl * tt-free-parts.price-base
     4556             bf-new_parts.transport-base  = bf-new_parts.transport-rubl / tt-free-parts.price-rubl * tt-free-parts.price-base
     4557             bf-new_parts.other-base      = bf-new_parts.other-rubl     / tt-free-parts.price-rubl * tt-free-parts.price-base
     4558             bf-new_parts.exch-code       = 0
     4559             bf-new_parts.cli-base-rate   = 1
