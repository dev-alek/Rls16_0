     5700   procedure partcopy-rsrv-parts :
     5701     define input  parameter p-doc-code-rowid as rowid no-undo .
     5702     define input  parameter p-parts-rowid    as rowid no-undo .
     5703     define input  parameter p-rsrv-direction as logical   no-undo .
     5704     define input  parameter p-goods-twounit  as logical   no-undo .
     5705     define input  parameter p-is-hold        as logical   no-undo .
     5706     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     5707     define buffer buf_trn-doc for ub.trn-doc .
     5708     define buffer archive_parts for ub.parts .
     5709     define buffer buf_parts   for ub.parts .
     5710     define buffer orig_marking-lines for ub.marking-lines .
     5711     define buffer buf_marking-lines for ub.marking-lines .
     5712     define buffer buf_marking   for ub.marking .
     5713     define buffer buf_goods for ub.goods .
     5714     define variable v-rsrv-code as character no-undo .
     5715     do
     5716     on error undo, return error return-value
     5717     :
     5718       find first buf_trn-doc no-lock
     5719         where rowid(buf_trn-doc) = p-doc-code-rowid
     5720         no-error .
     5721       if not available buf_trn-doc
     5722       then do:
     5723         message
     5724           vss-workfile vss-revision vss-description skip
     5725           vss-include-info23 skip
     5726           "Ошибка задания входных параметров" skip
     5727           "Не найден документ" skip
     5728           "Документ" string(p-doc-code-rowid) skip
     5729           "Партия" string(p-parts-rowid) skip
     5730           error-status :get-message(1) skip
     5731           return-value skip
     5732           view-as alert-box error .
     5733         undo, return error .
     5734       end.
     5735       find first archive_parts
     5736         where rowid(archive_parts) = p-parts-rowid
     5737         no-error .
     5738       if not available archive_parts
     5739       then do:
     5740         message
     5741           vss-workfile vss-revision vss-description skip
     5742           vss-include-info23 skip
     5743           "Ошибка задания входных параметров" skip
     5744           "Не найдена партия" skip
     5745           "Документ" string(p-doc-code-rowid) skip
     5746           "Партия" string(p-parts-rowid) skip
     5747           error-status :get-message(1) skip
     5748           return-value skip
     5749           view-as alert-box error .
     5750         undo, return error .
     5751       end.
     5752       if  archive_parts.out-code <> archive_parts.in-code
     5753       and archive_parts.qnty <> 0
     5754       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     5755       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     5756       then do:
     5757         assign
     5758           v-rsrv-code =
     5759           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5760         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     5761         then 'free-zone':U
     5762         else 'out-zone':U )
     5763         .
     5764         run partcopy in this-procedure
     5765           (input  true
     5766           ,input  v-rsrv-code
     5767           ,buffer archive_parts
     5768           ,buffer buf_parts
     5769           ,input  "news"
     5770           ) no-error .
     5771         if error-status :error
     5772         then do:
     5773           message
     5774             vss-workfile vss-revision vss-description skip
     5775             vss-include-info23 skip
     5776             "Ошибка при создании партии" skip
     5777             "Документ" buf_trn-doc.doc-code skip
     5778             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     5779             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     5780             "Партия" archive_parts.in-code archive_parts.part-code skip
     5781             "Количество" archive_parts.qnty skip
     5782             "Резерв" v-rsrv-code skip
     5783             error-status :get-message(1) skip
     5784             return-value skip
     5785             view-as alert-box error .
     5786           undo, return error .
     5787         end.
     5788         assign
     5789           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     5790                                                     * (if p-rsrv-direction = true
     5791                                                       then 1
     5792                                                       else -1
     5793                                                       )
     5794           buf_parts.fact-qnty = buf_parts.qnty
     5795         .
     5796         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     5797                                        and buf_goods.prod-type = archive_parts.prod-type
     5798                                        and buf_goods.prod-code = archive_parts.prod-code
     5799                                        .
     5800         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5801                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     5802                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     5803                                               and orig_marking-lines.in-code    = archive_parts.in-code
     5804                                               and orig_marking-lines.out-code   = archive_parts.out-code
     5805                                               and orig_marking-lines.part-code  = archive_parts.part-code
     5806                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     5807                                               :
     5808           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     5809                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     5810                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     5811                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     5812                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     5813                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     5814                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     5815                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     5816                                                   no-error .
     5817           if available buf_marking-lines
     5818           then do :
     5819             find current buf_marking-lines exclusive-lock .
     5820             delete buf_marking-lines .
     5821             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5822               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     5823             end .
     5824           end .
     5825           else do :
     5826             create buf_marking-lines .
     5827             assign
     5828               buf_marking-lines.mark       = orig_marking-lines.mark
     5829               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     5830               buf_marking-lines.gds-code   = buf_goods.gds-code
     5831               buf_marking-lines.obj-type   = buf_parts.obj-type
     5832               buf_marking-lines.obj-code   = buf_parts.obj-code
     5833               buf_marking-lines.in-code    = buf_parts.in-code
     5834               buf_marking-lines.out-code   = buf_parts.out-code
     5835               buf_marking-lines.part-code  = buf_parts.part-code
     5836               buf_marking-lines.prt-code   = buf_parts.prt-code
     5837             .
     5838             if buf_parts.out-code <> buf_parts.in-code
     5839             and buf_parts.out-code <> 'free-zone':U
     5840             and buf_parts.out-code <> 'out-zone':U
     5841             then do :
     5842               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     5843               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     5844             end .
     5845             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5846               assign
     5847                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     5848                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     5849               .
     5850             end .
     5851           end .
     5852           release buf_marking-lines no-error .
     5853         end.
     5854         if p-goods-twounit = true
     5855         then do:
     5856           assign
     5857             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     5858                                                     * (if p-rsrv-direction = true
     5859                                                       then 1
     5860                                                       else -1
     5861                                                       )
     5862           .
     5863         end.
     5864         if  buf_parts.qnty      = 0
     5865         and buf_parts.fact-qnty = 0
     5866         then do:
     5867           if p-goods-twounit = true
     5868           then do:
     5869             if buf_parts.cli-qnty <> 0
     5870             then do:
     5871               message
     5872                 vss-workfile vss-revision vss-description skip
     5873                 vss-include-info23 skip
     5874                 "Ошибка при удалении партии" skip
     5875                 "Документ" buf_trn-doc.doc-code skip
     5876                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5877                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5878                 "Партия" buf_parts.in-code buf_parts.part-code skip
     5879                 "Резерв" buf_parts.out-code skip
     5880                 "qnty" buf_parts.qnty skip
     5881                 "fact-qnty" buf_parts.fact-qnty skip
     5882                 "cli-qnty" buf_parts.cli-qnty skip
     5883                 view-as alert-box error .
     5884               undo, return error .
     5885             end.
     5886           end.
     5887           delete buf_parts .
     5888         end.
     5889       end.
     5890     end.
     5891   end procedure.
     5892   procedure partcopy-update-doc-line-tot-fact :
     5893     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5894     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     5895     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5896     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5897     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     5898       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     5899     define buffer buf_doc-line for ub.doc-line .
     5900     do
     5901     on error undo, return error return-value
     5902     :
     5903       find first buf_doc-line exclusive-lock
     5904         where buf_doc-line.doc-code  = p-doc-code
     5905           and buf_doc-line.artic     = p-artic
     5906           and buf_doc-line.prod-type = p-prod-type
     5907           and buf_doc-line.prod-code = p-prod-code
     5908         no-error .
     5909       if error-status :error
     5910       then do:
     5911         message
     5912           vss-workfile vss-revision vss-description skip
     5913           vss-include-info23 skip
     5914           "Ошибка задания входных параметров" skip
     5915           "Не найдена строка документа" skip
     5916           "Документ" p-doc-code skip
     5917           "Артикул" p-artic p-prod-type p-prod-code skip
     5918           error-status :get-message(1) skip
     5919           return-value skip
     5920           view-as alert-box error .
     5921         undo, return error .
     5922       end.
     5923       run partrqst in this-procedure
     5924         (input buf_doc-line.doc-code
     5925         ,input buf_doc-line.obj-type
     5926         ,input buf_doc-line.obj-code
     5927         ,input buf_doc-line.artic
     5928         ,input buf_doc-line.prod-type
     5929         ,input buf_doc-line.prod-code
     5930               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     5931         ) no-error .
     5932       if error-status :error
     5933       then do:
     5934         message
     5935           vss-workfile vss-revision vss-description skip
     5936           vss-include-info23 skip
     5937           "Ошибка при сборе информации по партиям" skip
     5938           "Документ" p-doc-code skip
     5939           "Артикул" p-artic p-prod-type p-prod-code skip
     5940           view-as alert-box error .
     5941         undo, return error .
     5942       end.
     5943       if v-total-parts-fact-qnty <> 0
     5944       then do:
     5945         assign
     5946           buf_doc-line.price-base      = v-total-parts-price-base
     5947                                        / v-total-parts-fact-qnty
     5948           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     5949                                        / v-total-parts-fact-qnty
     5950           buf_doc-line.transport-base  = v-total-parts-transport-base
     5951                                        / v-total-parts-fact-qnty
     5952           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     5953                                        / v-total-parts-fact-qnty
     5954           buf_doc-line.other-base      = v-total-parts-other-base
     5955                                        / v-total-parts-fact-qnty
     5956           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     5957                                        / v-total-parts-fact-qnty
     5958         .
     5959       end.
     5960       else do:
     5961       end.
     5962     end.
     5963   end procedure.
     5964   procedure partcopy-change-purch-code :
     5965     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     5966     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     5967     define parameter buffer buf_orig_parts     for ub.parts .
     5968     define parameter buffer buf1_parts         for ub.parts .
     5969     define parameter buffer buf2_parts         for ub.parts .
     5970     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     5971     define variable var-out-code  like ub.parts.out-code no-undo .
     5972     define variable var-part-code like ub.parts.part-code no-undo .
     5973     define buffer buf_goods        for ub.goods .
     5974     define buffer buf_parts-root   for ub.parts-root.
     5975     define buffer buf_trn-doc      for ub.trn-doc.
     5976     define buffer buf-orig_trn-doc for ub.trn-doc.
     5977     define buffer buf_units        for ub.units .
     5978     do
     5979     on error undo, return error return-value
     5980     :
     5981       if buf_orig_parts.out-code = p-in-code
     5982       then do:
     5983         message
     5984           vss-workfile vss-revision vss-description skip
     5985           vss-include-info23 skip
     5986           "Ошибка задания входных параметров процедуры partcopy" skip
     5987           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     5988           "p-in-code" p-in-code skip
     5989           view-as alert-box error .
     5990         undo, return error .
     5991       end.
     5992       find first buf_trn-doc no-lock
     5993         where buf_trn-doc.doc-code = p-in-code
     5994         .
     5995       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     5996       find first buf_goods no-lock
     5997         where buf_goods.artic = buf_orig_parts.artic
     5998           and buf_goods.prod-type = buf_orig_parts.prod-type
     5999           and buf_goods.prod-code = buf_orig_parts.prod-code
     6000         .
     6001       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     6002       find first buf1_parts exclusive-lock
     6003         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     6004           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     6005           and buf1_parts.artic     = buf_orig_parts.artic
     6006           and buf1_parts.prod-type = buf_orig_parts.prod-type
     6007           and buf1_parts.prod-code = buf_orig_parts.prod-code
     6008           and buf1_parts.in-code   = buf_orig_parts.in-code
     6009           and buf1_parts.out-code  = p-in-code
     6010           and buf1_parts.part-code = buf_orig_parts.part-code
     6011         no-error.
     6012       if not available buf1_parts
     6013       then do:
     6014         create buf1_parts .
     6015         buffer-copy buf_orig_parts to buf1_parts
     6016         assign
     6017           buf1_parts.in-code    = buf_orig_parts.in-code
     6018           buf1_parts.out-code   = p-in-code
     6019           buf1_parts.status_    = no
     6020           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6021           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6022           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     6023           buf1_parts.purch-code = buf_orig_parts.purch-code
     6024           buf1_parts.rsrv-free  = ?
     6025           buf1_parts.status_    = yes
     6026         .
     6027         validate buf1_parts .
     6028       end.
     6029       if  lookup('сер':U, buf_units.type) > 0
     6030       then do:
     6031          var-part-code = buf_orig_parts.part-code.
     6032       end.
     6033       else do:
     6034           run holdprts-get-part-code in this-procedure
     6035             (input  p-in-code
     6036             ,output var-part-code
     6037             ) no-error .
     6038           if error-status :error
     6039           then dO:
     6040             undo, return error return-value.
     6041           end.
     6042       end.
     6043       find first buf2_parts exclusive-lock
     6044         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     6045           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     6046           and buf2_parts.artic     = buf_orig_parts.artic
     6047           and buf2_parts.prod-type = buf_orig_parts.prod-type
     6048           and buf2_parts.prod-code = buf_orig_parts.prod-code
     6049           and buf2_parts.in-code   = p-in-code
     6050           and buf2_parts.out-code  = p-in-code
     6051           and buf2_parts.part-code = var-part-code
     6052         no-error.
     6053       if not available buf2_parts
     6054       then do:
     6055         create buf2_parts .
     6056         buffer-copy buf_orig_parts to buf2_parts
     6057         assign
     6058           buf2_parts.in-code   = p-in-code
     6059           buf2_parts.out-code  = p-in-code
     6060           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6061           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6062           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     6063           buf2_parts.purch-code = p-dest-purch-code
     6064           buf2_parts.part-code  = var-part-code
     6065           buf2_parts.rsrv-free  = ?
     6066           buf2_parts.status_    = yes
     6067         .
     6068         validate buf2_parts .
     6069       end.
     6070       assign
     6071         buf_orig_parts.in-code    = p-in-code
     6072         buf_orig_parts.part-code  = buf2_parts.part-code
     6073         buf_orig_parts.purch-code = buf2_parts.purch-code
     6074       .
     6075       find first buf_parts-root
     6076         where buf_parts-root.doc-code       = p-in-code
     6077           and buf_parts-root.in-code        = p-in-code
     6078           and buf_parts-root.gds-code       = buf_goods.gds-code
     6079           and buf_parts-root.part-code      = buf2_parts.part-code
     6080           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     6081           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6082           and buf_parts-root.orig-part-code = buf1_parts.part-code
     6083         no-error .
     6084       if not available buf_parts-root
     6085       then do:
     6086         create buf_parts-root.
     6087         assign
     6088         buf_parts-root.doc-code       = p-in-code
     6089         buf_parts-root.in-code        = p-in-code
     6090         buf_parts-root.gds-code       = buf_goods.gds-code
     6091         buf_parts-root.part-code      = buf2_parts.part-code
     6092         buf_parts-root.orig-in-code   = buf1_parts.in-code
     6093         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6094         buf_parts-root.orig-part-code = buf1_parts.part-code
     6095         .
     6096       end.
     6097     end.
     6098   end procedure.
     6099   procedure addChildMarkingLines:
     6100     define input parameter iMark as character no-undo.
     6101     define input parameter iSts  as integer   no-undo.
     6102     define parameter buffer buf_marking-lines  for ub.marking-lines.
     6103     define parameter buffer buf_parts          for ub.parts.
     6104     define parameter buffer orig_marking-lines for ub.marking-lines.
     6105     define parameter buffer buf_orig_parts     for ub.parts.
     6106     define parameter buffer buf_goods          for ub.goods.
     6107     define buffer buf_marking-childs        for ub.marking.
     6108     define buffer buf_marking-lines-childs  for ub.marking-lines.
     6109     define buffer buf_marking-chk           for ub.marking-chk.
     6110     define buffer buf_chk-doc               for ub.chk-doc.
     6111     define buffer orig_marking-lines-childs for ub.marking-lines.
     6112     for each buf_marking-childs exclusive-lock where
     6113              buf_marking-childs.mark-parent = iMark :
     6114         find first buf_marking-lines-childs no-lock where
     6115                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6116                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6117                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6118                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6119                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6120                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6121                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6122                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6123         no-error .
     6124         if not available buf_marking-lines-childs then
     6125         do:
     6126           create buf_marking-lines-childs .
     6127           assign
     6128             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6129             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6130             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6131             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6132             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6133             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6134             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6135             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6136             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     6137             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     6138           .
     6139           validate buf_marking-childs.
     6140         end .
     6141         buf_marking-childs.sts = iSts .
     6142         for each buf_marking-chk exclusive-lock where
     6143                  buf_marking-chk.mark begins buf_marking-childs.mark
     6144         :
     6145           for first buf_chk-doc no-lock where
     6146                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     6147                 and buf_chk-doc.out-code = buf_parts.out-code
     6148           :
     6149             buf_marking-chk.sts = 0 .
     6150             validate buf_marking-chk.
     6151           end .
     6152         end .
     6153         if available orig_marking-lines
     6154         then do :
     6155           find first orig_marking-lines-childs exclusive-lock where
     6156                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     6157                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     6158                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     6159                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     6160                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     6161                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     6162                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     6163                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     6164           no-error .
     6165           if available orig_marking-lines-childs then
     6166             delete orig_marking-lines-childs .
     6167         end.
     6168         run addChildMarkingLines in this-procedure (
     6169           buf_marking-childs.mark,
     6170           iSts,
     6171           buffer buf_marking-lines,
     6172           buffer buf_parts,
     6173           buffer orig_marking-lines,
     6174           buffer buf_orig_parts,
     6175           buffer buf_goods
     6176         ).
     6177     end .
     6178   end.
     6179   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6180   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6181   define new global shared variable g#trdcalib as handle no-undo.
     6182   function stsMarkWhenDeleteGoods returns integer
     6183       (input iDocCode as character,
     6184        input iMark as character):
     6185     define variable vValue as character no-undo.
     6186     define variable vType as character no-undo.
     6187     define buffer buf_trn-doc for ub.trn-doc.
     6188     define buffer buf_c-marking for ub.c-marking.
     6189     if iDocCode <> ? then
     6190     do:
     6191         find first buf_trn-doc no-lock where
     6192                    buf_trn-doc.doc-code = iDocCode no-error.
     6193         if avail buf_trn-doc then
     6194         do:
     6195   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6196                           input 'is-return':U ,
     6197                          output vValue ,
     6198                          output vType ) no-error .
     6199            if buf_trn-doc.ext-doc-type = 'we':U or
     6200               buf_trn-doc.ext-doc-type = 'ev':U or
     6201               vValue = "yes" then
     6202            do:
     6203              find last buf_c-marking no-lock where
     6204                        buf_c-marking.mark = iMark
     6205                   use-index pi-2 no-error.
     6206              if avail buf_c-marking and
     6207                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     6208                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     6209                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     6210                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     6211                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     6212                return buf_c-marking.sts .
     6213            end.
     6214         end.
     6215     end.
     6216     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6217   end function.
     6218   procedure partrsrv :
     6219     define input parameter  p-chg-qnty      as decimal   no-undo .
     6220     define input parameter  p-goods-serial  as logical   no-undo .
     6221     define input parameter  p-goods-twounit as logical   no-undo .
     6222     define input parameter  p-unreserv-only as logical   no-undo .
     6223     define parameter buffer buf_orig_parts  for ub.parts .
     6224     define parameter buffer buf_trn-doc     for ub.trn-doc .
     6225     define output parameter p-real-chg-qnty as decimal   no-undo .
     6226     define output parameter p-parts-recid   as recid     no-undo .
     6227     define input  parameter p-mark          as character  no-undo .
     6228     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     6229     define buffer buf_parts  for ub.parts .
     6230     define buffer rsrv-parts for ub.parts .
     6231     define buffer unrsrv-parts for ub.parts .
     6232     define buffer buf_parts-attr for ub.parts-attr .
     6233     define buffer free_marking-lines for ub.marking-lines .
     6234     define variable lok                as logical   no-undo .
     6235     define variable v-sign-chg-qnty    as integer   no-undo .
     6236     define variable v-sign-rsrv-qnty   as integer   no-undo .
     6237     define variable v-rsrv-qnty        as decimal   no-undo .
     6238     define variable v-orig-unrsrv-code as character no-undo .
     6239     define variable v-new-rsrv-code    as character no-undo .
     6240     define variable v-new-unrsrv-code  as character no-undo .
     6241     define variable v-unrsrv-qnty      as decimal   no-undo .
     6242     define variable v-value-character as character no-undo .
     6243     define variable v-value-date      as date no-undo .
     6244     define variable v-value-decimal   as decimal no-undo .
     6245     define variable v-value-integer   as integer no-undo .
     6246     define variable v-izlcstpr        as logical no-undo .
     6247     define variable v-tth             as handle no-undo .
     6248     define variable v-type            as character no-undo .
     6249     define variable part-key-rec      as character no-undo .
     6250     define variable v-part-code-int   as integer no-undo .
     6251     define variable v-old-part-code   as character no-undo .
     6252     define variable v-part-gds-code   as integer   no-undo .
     6253     do transaction
     6254     on error undo, return error
     6255     :
     6256       if buf_trn-doc.ext-doc-type = 'vt':U
     6257       then do :
     6258           delete object v-tth no-error.
     6259           run adm/shattri.p (
     6260              input "get":U
     6261             ,input buf_orig_parts.obj-type
     6262             ,input buf_orig_parts.obj-code
     6263             ,input 'inv-obj':U
     6264             ,input  "izlcstpr"
     6265             ,output v-value-character
     6266             ,output v-value-date
     6267             ,output v-value-decimal
     6268             ,output v-value-integer
     6269             ,output v-izlcstpr
     6270             ,output v-type
     6271             ,INPUT-OUTPUT table-handle v-tth
     6272             ) no-error .
     6273             delete object v-tth no-error.
     6274           if error-status:error then do:
     6275             v-izlcstpr = false .
     6276           end.
     6277       end.
     6278       else do :
     6279           v-izlcstpr = false .
     6280       end.
     6281       assign
     6282         p-parts-recid = ?
     6283       .
     6284       if p-chg-qnty = 0 then do:
     6285         assign
     6286           p-parts-recid = recid(buf_orig_parts)
     6287         .
     6288         return .
     6289       end.
     6290       assign
     6291         v-sign-chg-qnty = 0
     6292       .
     6293       if p-chg-qnty < 0 then do:
     6294         assign
     6295           v-sign-chg-qnty = -1
     6296         .
     6297       end.
     6298       if p-chg-qnty > 0 then do:
     6299         assign
     6300           v-sign-chg-qnty = 1
     6301         .
     6302       end.
     6303       assign
     6304         v-sign-rsrv-qnty = v-sign-chg-qnty
     6305       .
     6306       if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 then do:
     6307         assign
     6308           v-sign-rsrv-qnty = - v-sign-chg-qnty
     6309         .
     6310       end.
     6311       run partcopy in this-procedure
     6312         (input  false
     6313         ,input  buf_trn-doc.doc-code
     6314         ,buffer buf_orig_parts
     6315         ,buffer buf_parts
     6316         ,input  p-mark
     6317         ) no-error .
     6318       if error-status :error then do:
     6319         message
     6320           vss-workfile vss-revision vss-description skip
     6321           "Ошибка при создании партии" skip
     6322           "Объект" buf_orig_parts.obj-type buf_orig_parts.obj-code skip
     6323           "Артикул" buf_orig_parts.artic buf_orig_parts.prod-type buf_orig_parts.prod-code skip
     6324           "Партия" buf_orig_parts.in-code buf_orig_parts.part-code skip
     6325           "Резерв" buf_trn-doc.doc-code skip
     6326           error-status :get-message(1) skip
     6327           return-value skip
     6328           view-as alert-box error .
     6329         undo, return error .
     6330       end.
     6331       if buf_parts.in-code = buf_parts.out-code then do:
     6332         assign
     6333           v-rsrv-qnty = abs(p-chg-qnty)
     6334         .
     6335         if buf_trn-doc.doc-type <> 'инв':U then do:
     6336           if buf_parts.qnty < 0
     6337           or buf_parts.fact-qnty < 0 then do:
     6338             message
     6339               vss-workfile vss-revision vss-description skip
     6340               "Резервирование невозможно" skip
     6341               "Партия зарезервированная за обычным документом имеет отрицательное количество" skip
     6342               view-as alert-box error .
     6343             undo, return error .
     6344           end.
     6345           if v-sign-rsrv-qnty < 0 then do:
     6346             assign
     6347               v-rsrv-qnty = min(abs(buf_parts.qnty), v-rsrv-qnty)
     6348             .
     6349           end.
     6350         end.
     6351         assign
     6352           buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6353           buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6354         .
     6355         if p-goods-twounit = true
     6356         then do:
     6357           if buf_parts.qnty < 0 then do:
     6358             message
     6359               "Порожденная партия ювелирных изделий не может иметь отрицательное количество" skip
     6360               "Количество" buf_parts.qnty skip
     6361               view-as alert-box error .
     6362             undo, return error .
     6363           end.
     6364           if buf_parts.qnty = 0 then do:
     6365             assign
     6366               buf_parts.cli-qnty = 0
     6367             .
     6368           end.
     6369           if  buf_parts.qnty <> 0
     6370           and buf_parts.cli-qnty <> 1
     6371           then do:
     6372             message
     6373               vss-workfile vss-revision vss-description skip
     6374               "Порожденная партия ювелирных изделий должна иметь определенное клиентское количество" skip
     6375               "qnty" buf_parts.qnty skip
     6376               "cli-qnty" buf_parts.cli-qnty skip
     6377               view-as alert-box error .
     6378             undo, return error .
     6379           end.
     6380         end.
     6381         else do:
     6382           if buf_parts.cli-base-rate <> 0
     6383           then do:
     6384             assign
     6385               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6386             .
     6387           end.
     6388           else do:
     6389             assign
     6390               buf_parts.cli-qnty = 0
     6391             .
     6392           end.
     6393         end.
     6394         assign
     6395           p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6396           p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6397         .
     6398       end.
     6399       else do:
     6400         assign
     6401           v-orig-unrsrv-code =
     6402           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6403         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0)
     6404         then 'free-zone':U
     6405         else 'out-zone':U )
     6406           v-new-rsrv-code    =  ( if p-chg-qnty > 0
     6407                                   then 'free-zone':U
     6408                                   else 'out-zone':U
     6409                                 )
     6410           v-new-unrsrv-code  =  ( if p-chg-qnty > 0
     6411                                   then 'out-zone':U
     6412                                   else 'free-zone':U
     6413                                 )
     6414         .
     6415         if v-new-rsrv-code = v-orig-unrsrv-code then do:
     6416           assign
     6417             v-rsrv-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty) )
     6418           .
     6419           if v-izlcstpr and buf_parts.out-code <> v-new-rsrv-code and p-chg-qnty > 0
     6420           then do :
     6421               find first rsrv-parts exclusive-lock
     6422                   where rsrv-parts.obj-type  = buf_parts.obj-type
     6423                     and rsrv-parts.obj-code  = buf_parts.obj-code
     6424                     and rsrv-parts.artic     = buf_parts.artic
     6425                     and rsrv-parts.prod-type = buf_parts.prod-type
     6426                     and rsrv-parts.prod-code = buf_parts.prod-code
     6427                     and rsrv-parts.in-code   = buf_parts.out-code
     6428                     and rsrv-parts.out-code  = v-new-rsrv-code
     6429                     and rsrv-parts.part-code = buf_parts.part-code
     6430                   no-error.
     6431           end.
     6432           if not available rsrv-parts
     6433           then do :
     6434               run partcopy in this-procedure
     6435                 (input  true
     6436                 ,input  v-new-rsrv-code
     6437                 ,buffer buf_parts
     6438                 ,buffer rsrv-parts
     6439                 ,input p-mark
     6440                 ) no-error .
     6441               if error-status :error then do:
     6442                 message
     6443                   vss-workfile vss-revision vss-description skip
     6444                   "Ошибка при создании партии" skip
     6445                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6446                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6447                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6448                   "Резерв" v-new-rsrv-code skip
     6449                   error-status :get-message(1) skip
     6450                   return-value skip
     6451                   view-as alert-box error .
     6452                 undo, return error .
     6453               end.
     6454           end.
     6455           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty > 0)
     6456           then
     6457           assign
     6458             rsrv-parts.qnty      = rsrv-parts.qnty      + v-rsrv-qnty
     6459             rsrv-parts.fact-qnty = rsrv-parts.fact-qnty + v-rsrv-qnty
     6460           .
     6461           if p-goods-twounit = true then do:
     6462             assign
     6463               rsrv-parts.cli-qnty = rsrv-parts.cli-qnty + abs(buf_parts.cli-qnty)
     6464             .
     6465           end.
     6466           else do:
     6467             if rsrv-parts.cli-base-rate <> 0
     6468             then do:
     6469               assign
     6470                 rsrv-parts.cli-qnty = rsrv-parts.fact-qnty / rsrv-parts.cli-base-rate
     6471               .
     6472             end.
     6473             else do:
     6474               assign
     6475                 rsrv-parts.cli-qnty = 0
     6476               .
     6477             end.
     6478           end.
     6479           assign
     6480             buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     6481             buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     6482           .
     6483           if p-goods-twounit = true then do:
     6484             assign
     6485               buf_parts.cli-qnty = 0
     6486             .
     6487           end.
     6488           else do:
     6489             if buf_parts.cli-base-rate <> 0
     6490             then do:
     6491               assign
     6492                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6493               .
     6494             end.
     6495             else do:
     6496               assign
     6497                 buf_parts.cli-qnty = 0
     6498               .
     6499             end.
     6500           end.
     6501           assign
     6502             p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     6503             p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     6504           .
     6505         end.
     6506         if p-chg-qnty <> 0
     6507         and (
     6508              (buf_trn-doc.doc-type = 'инв':U
     6509              and p-unreserv-only = false
     6510              )
     6511             or v-new-unrsrv-code = v-orig-unrsrv-code
     6512             )
     6513         then do:
     6514           if v-izlcstpr and buf_parts.out-code <> v-new-unrsrv-code and p-chg-qnty < 0
     6515           then do :
     6516               find first unrsrv-parts exclusive-lock
     6517                   where unrsrv-parts.obj-type  = buf_parts.obj-type
     6518                     and unrsrv-parts.obj-code  = buf_parts.obj-code
     6519                     and unrsrv-parts.artic     = buf_parts.artic
     6520                     and unrsrv-parts.prod-type = buf_parts.prod-type
     6521                     and unrsrv-parts.prod-code = buf_parts.prod-code
     6522                     and unrsrv-parts.in-code   = buf_parts.in-code
     6523                     and unrsrv-parts.out-code  = v-new-unrsrv-code
     6524                     and unrsrv-parts.part-code = buf_parts.part-code
     6525                   no-error.
     6526           end.
     6527           if not available unrsrv-parts
     6528           then do :
     6529               run partcopy in this-procedure
     6530                 (input  true
     6531                 ,input  v-new-unrsrv-code
     6532                 ,buffer buf_parts
     6533                 ,buffer unrsrv-parts
     6534                 ,input  p-mark
     6535                 ) no-error .
     6536               if error-status :error then do:
     6537                 message
     6538                   vss-workfile vss-revision vss-description skip
     6539                   "Ошибка при создании партии" skip
     6540                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6541                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6542                   "Партия" buf_parts.in-code buf_parts.part-code skip
     6543                   "Резерв" v-new-rsrv-code skip
     6544                   error-status :get-message(1) skip
     6545                   return-value skip
     6546                   view-as alert-box error .
     6547                 undo, return error .
     6548               end.
     6549           end.
     6550           assign
     6551             v-unrsrv-qnty = min( (if unrsrv-parts.qnty > 0
     6552                                   then unrsrv-parts.qnty
     6553                                   else 0
     6554                                   )
     6555                             , abs(p-chg-qnty))
     6556           .
     6557           assign
     6558             buf_parts.qnty      = buf_parts.qnty      + v-unrsrv-qnty * v-sign-rsrv-qnty
     6559             buf_parts.fact-qnty = buf_parts.fact-qnty + v-unrsrv-qnty * v-sign-rsrv-qnty
     6560           .
     6561           if p-goods-twounit = true then do:
     6562             assign
     6563               buf_parts.cli-qnty = buf_parts.cli-qnty + unrsrv-parts.cli-qnty * v-sign-rsrv-qnty
     6564             .
     6565           end.
     6566           else do:
     6567             if buf_parts.cli-base-rate <> 0
     6568             then do:
     6569               assign
     6570                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6571               .
     6572             end.
     6573             else do:
     6574               assign
     6575                 buf_parts.cli-qnty = 0
     6576               .
     6577             end.
     6578           end.
     6579           if num-entries(buf_parts.part-code, "_") = 2
     6580           and buf_parts.qnty > 0
     6581           and buf_parts.out-code <> 'free-zone':U
     6582           and buf_parts.out-code <> 'out-zone':U
     6583           and buf_trn-doc.ext-doc-type = 'vt':U
     6584           then do :
     6585             v-old-part-code = buf_parts.part-code .
     6586             v-part-code-int = 0 .
     6587             buf_parts.part-code = entry(2, buf_parts.part-code, "_") no-error .
     6588             do while error-status:error :
     6589               v-part-code-int = v-part-code-int + 1 .
     6590               buf_parts.part-code = string(integer(entry(2, buf_parts.part-code, "_")) + v-part-code-int) no-error .
     6591             end .
     6592   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6594     (input  buf_parts.artic
