     8361       define input parameter p-value    as decimal   no-undo .
     8362       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8363       find first buf_doc-line-attr exclusive-lock
     8364         where buf_doc-line-attr.doc-code  = p-doc-code
     8365           and buf_doc-line-attr.gds-code  = p-gds-code
     8366           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     8367         no-error .
     8368       if not available buf_doc-line-attr then do:
     8369         create buf_doc-line-attr .
