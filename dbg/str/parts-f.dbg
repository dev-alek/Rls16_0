    11371           "Будет изменена Цена Производителя партии товара" skip
    11372           "во всех документах текущей базы данных" skip
    11373           "Документ" buf_parts.in-code skip
    11374           "Номер " buf_parts.part-code skip
    11375           "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    11376           "Старая Цена Производителя" buf_parts.dop skip
    11377           "" skip
    11378           "Новая Цена Производителя" v-parts-dop skip
    11379           "" skip
    11380           v-warning skip
    11381           "Продолжить?" skip
    11382           view-as alert-box question buttons yes-no update v-ok .
    11383         if v-ok <> true
    11384         then do:
    11385           return .
    11386         end.
    11387         run trg/partdop.p
    11388           (input v-parts-dop
    11389           ,input buf_parts.in-code
    11390           ,input buf_parts.artic
    11391           ,input buf_parts.prod-type
    11392           ,input buf_parts.prod-code
    11393           ,input buf_parts.part-code
    11394           ) .
    11395         if valid-handle(h-call-prog)
    11396         then do:
