    11324     define buffer buf_parts for ub.parts .
    11325     define variable v-create-part as logical   no-undo .
    11326     define variable v-create-obj  as logical   no-undo .
    11327     define variable v-dop-format  as character no-undo .
    11328     define variable v-parts-dop   as character no-undo .
    11329     define variable v-ok          as logical   no-undo .
    11330     define variable v-priceWithVat as decimal   no-undo .
    11331     define variable v-vat-pc       as decimal   no-undo .
    11332     if p-mode <> 'ИЗМЕНЕНИЕ':U
    11333     and v-parts-recid <> ?
    11334     then do:
    11335       find first buf_parts no-lock
    11336         where recid(buf_parts) = v-parts-recid
    11337         no-error .
    11338       if available buf_parts
    11339       then do:
    11340   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partppric in g#library
    11342   (  buffer buf_parts
    11343    , output v-parts-dop
    11344    , output v-priceWithVat
    11345    , output v-vat-pc
    11346           )  .
    11347        run str/d-twopr.w
    11348        ( input-output v-parts-dop ,
    11349          input-output v-priceWithVat
    11350        ) no-error .
    11351         if error-status :error
    11352         then do:
    11353           return .
    11354         end.
    11355         v-parts-dop =  substitute( "&1;&2",v-parts-dop,v-priceWithVat ).
    11356         define variable v-warning as character no-undo .
    11357         define buffer buf_db for ub.db .
    11358         find first buf_db no-lock
    11359           where buf_db.db-num <> 0
    11360           no-error .
    11361         if available buf_db
    11362         then do:
    11363           assign
    11364             v-warning = "ВНИМАНИЕ! Изменения не будут переданы в другие базы данных"
    11365           .
    11366         end.
    11367         assign
    11368           v-ok = false
    11369         .
