    12724           (output v-curr-sv-date
    12725           ) .
    12726       end.
    12727       if v-curr-sv-date <> ?
    12728       then do:
    12729         run gbl/d-inpday.w
    12730           (input ?
    12731           ,input "Выбор даты"
    12732           ,input v-description
    12733           ,input ""
    12734           ,input-output v-curr-sv-date
    12735           ,output v-ok
    12736           ).
    12737         if v-ok = true
    12738         then do:
    12739           assign
    12740             self :screen-value = string(v-curr-sv-date) .
    12741           .
    12742         end.
