     8567         where buf_doc-line-attr.doc-code  = p-doc-code
     8568           and buf_doc-line-attr.gds-code  = p-gds-code
     8569           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     8570         no-error .
     8571       if avail buf_doc-line-attr then do:
     8572         assign
