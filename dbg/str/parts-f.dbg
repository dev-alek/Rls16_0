    13070   PROCEDURE close-window :
    13071     assign
    13072       v-undo-last = true
    13073     .
    13074     apply "go":u to frame Dialog-Frame .
    13075   END PROCEDURE.
    13076   PROCEDURE determine-enable-qnty :
    13077     define input  parameter p-doc-type     like ub.trn-doc.doc-type     no-undo .
    13078     define input  parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
    13079     define input  parameter p-internal     like ub.trn-doc.internal     no-undo .
    13080     define input  parameter p-status_      like ub.trn-doc.status_      no-undo .
    13081     define input  parameter p-flag_        like ub.trn-doc.flag_        no-undo .
    13082     define input  parameter p-disable-qnty as logical   no-undo .
    13083     define output parameter p-enable-qnty  as character no-undo .
    13084     define buffer buf_trn-doc for ub.trn-doc.
    13085     define variable vIsExemplarGoods as logical no-undo.
    13086     define variable v-isweighed as logical   no-undo .
    13087     define variable varvalue as character no-undo .
    13088     define variable vartype  as character no-undo .
    13089     define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    13090     if p-ext-doc-type = 'iv':U then
    13091     do:
    13092       find first buf_trn-doc no-lock where
    13093                  buf_trn-doc.doc-code = p-doc-code.
    13094       run isExemplarGoods in this-procedure
    13095         (buf_trn-doc.obj-type, buf_trn-doc.obj-code, p-gds-code, output vIsExemplarGoods).
    13096       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code).
    13097       RUN gds-attr-value (
    13098                           INPUT p-gds-code,
    13099                           INPUT 'mark-type':U,
    13100                           OUTPUT varvalue,
    13101                           OUTPUT vartype
    13102                           ).
    13103       v-isweighed = WeighedProd(p-gds-code)
    13104                 and varvalue > ""
    13105                 and (EDOParSec:GetIsEDOForType(varvalue)
    13106                   or EDOParSec:GetIsArticForType(varvalue))
    13107       .
    13108       if vIsExemplarGoods
    13109       or v-isweighed
    13110       then do:
    13111         p-enable-qnty = "".
    13112         return.
    13113       end.
    13114     end.
    13115     if  p-doc-type = 'инв':U
    13116     then do:
    13117       if p-ext-doc-type = 'vt':U
    13118       then do:
    13119         if p-status_  = 'разрешен':U
    13120         then do:
    13121           assign
    13122             p-enable-qnty = "qnty":u
    13123           .
    13124         end.
    13125       end.
    13126       else do:
    13127         if  p-status_  = 'накл':U
    13128         and p-disable-qnty = false
    13129         then do:
    13130           assign
    13131             p-enable-qnty = "qnty":u
    13132           .
    13133         end.
    13134         else do:
    13135           assign
    13136             p-enable-qnty = ""
    13137           .
    13138         end.
    13139       end.
    13140       return .
    13141     end.
    13142     if (p-status_  = 'накл':U
    13143         and p-flag_ = yes
    13144         )
    13145     or p-status_ = 'разрешен':U
    13146     then do:
    13147       assign
    13148         p-enable-qnty = "fact-qnty":u
    13149       .
    13150       return .
    13151     end.
    13152     if  p-doc-type = 'при':U
    13153     and p-internal = no
    13154     then do:
    13155       if  p-status_      = 'накл':U
    13156       and p-flag_        = no
    13157       then do:
    13158         assign
    13159           p-enable-qnty = "cli-qnty":u
    13160         .
    13161         return .
    13162       end.
    13163     end.
    13164     if p-status_ = 'факт':U
    13165     then do:
    13166       assign
    13167         p-enable-qnty = ""
    13168       .
    13169       return .
    13170     end.
    13171     assign
    13172       p-enable-qnty = "qnty":u
    13173     .
    13174   END PROCEDURE.
    13175   PROCEDURE disable-fields :
    13176     do with frame Dialog-Frame:
    13177       assign
    13178         parts.PS         :read-only = true
    13179       .
    13180       assign
    13181         b-alc-attr :sensitive = false
    13182         b-alc-attr :visible   = false
    13183       .
    13184       assign
    13185         parts.part-code      :sensitive = false
    13186         parts.cst-code       :sensitive = false
    13187         parts.last-date      :sensitive = false
    13188         b-choose-last-date   :sensitive = false
    13189         fi-last-date-offset  :sensitive = false
    13190         parts.price-cli      :sensitive = false
    13191         parts.price-base     :sensitive = false
    13192         parts.price-rubl     :sensitive = false
    13193         b-edit-price         :sensitive = false
    13194         fi-vat-pc            :sensitive = false
    13195         fi-slt-pc            :sensitive = false
    13196         parts.qnty           :sensitive = false
    13197         parts.fact-qnty      :sensitive = false
    13198         parts.cli-qnty       :sensitive = false
    13199         parts.supp-type      :sensitive = false
    13200         parts.supp-code      :sensitive = false
    13201         r-supp               :sensitive = false
    13202         fi-contract-prn-code :sensitive = false
    13203         r-contract           :sensitive = false
    13204         parts.exch-code      :sensitive = false
    13205         r-exch-code          :sensitive = false
    13206       .
    13207       assign
    13208         fi-vat-pc :fgcolor = ?
    13209         fi-slt-pc :fgcolor = ?
    13210       .
    13211       assign
    13212         b-exit :label in frame Dialog-Frame = "&Выход"
    13213       .
    13214       assign
    13215         b-save               :sensitive = false
    13216         b-quit               :sensitive = false
    13217         b-rest               :sensitive = false
    13218         b-add                :sensitive = false
    13219         b-del                :sensitive = false
    13220       .
    13221       assign
    13222         v-fields-enabled = false
    13223       .
    13224     end.
    13225   END PROCEDURE.
    13226   PROCEDURE disable_UI :
    13227     HIDE FRAME Dialog-Frame.
    13228   END PROCEDURE.
    13229   PROCEDURE display-dependent-info :
    13230     define variable v-fact-qnty as decimal no-undo .
    13231     do with frame Dialog-Frame:
    13232       if v-goods-twounit = false
    13233       then do:
    13234         if parts.cli-qnty :sensitive
    13235         then do:
    13236           assign
    13237             parts.fact-qnty :screen-value = string( decimal(parts.cli-qnty :screen-value)
    13238                                                   * decimal(parts.cli-base-rate :screen-value)
    13239                                                 , parts.fact-qnty :format )
    13240             parts.qnty :screen-value = parts.fact-qnty :screen-value
    13241           .
    13242         end.
    13243         if parts.qnty :sensitive
    13244         then do:
    13245           if parts.cli-qnty :visible = true
    13246           then do:
    13247             assign
    13248               parts.cli-qnty :screen-value = string( decimal(parts.qnty :screen-value)
    13249                                                     / decimal(parts.cli-base-rate :screen-value)
    13250                                                   , parts.cli-qnty :format )
    13251             .
    13252           end.
    13253           if parts.fact-qnty :visible
    13254           then do:
    13255             assign
    13256               parts.fact-qnty :screen-value = parts.qnty :screen-value
    13257             .
    13258           end.
    13259         end.
    13260       end.
    13261       assign
    13262         fi-label-summa :screen-value = string("Сумма " + parts.fact-qnty :label)
    13263         tot-price-rubl :screen-value = string(decimal(parts.fact-qnty :screen-value)
    13264                                               * decimal(parts.price-rubl :screen-value)
    13265                                              , tot-price-cli :format )
    13266         tot-price-base :screen-value = string(decimal(parts.fact-qnty :screen-value)
    13267                                               * decimal(parts.price-base :screen-value)
    13268                                              , tot-price-cli :format )
    13269       .
    13270       if tot-price-cli :visible
    13271       then do:
    13272         assign
    13273           tot-price-cli  :screen-value = string(decimal(parts.cli-qnty :screen-value)
    13274                                                 * decimal(parts.price-cli :screen-value)
    13275                                                , tot-price-cli :format )
    13276         .
    13277       end.
    13278     end.
    13279   END PROCEDURE.
    13280   PROCEDURE display-fields :
    13281     define variable v-frame-title as character no-undo .
    13282     define variable v-host-code like ub.sysconf.host-code no-undo .
    13283     define variable v-base-code like ub.sysconf.base-code no-undo .
    13284     define buffer buf_parts        for ub.parts .
    13285     define buffer buf_doc-line     for ub.doc-line .
    13286     define buffer buf_trn-doc      for ub.trn-doc .
    13287     define buffer buf_goods        for ub.goods .
    13288     define buffer buf_clients      for ub.clients .
    13289     define buffer buf_currency     for ub.currency .
    13290     define buffer buf_supp-clients for ub.clients .
    13291     do with frame Dialog-Frame:
    13292       define variable v-old-immediate-display as logical no-undo .
    13293       assign
    13294         v-old-immediate-display = session:immediate-display
    13295       .
    13296       if v-old-immediate-display = yes
    13297       then do:
    13298         assign
    13299           session:immediate-display = no
    13300         .
    13301       end.
    13302       assign
    13303         parts.price-cli         :screen-value = ""
    13304         parts.price-base        :screen-value = ""
    13305         parts.price-rubl        :screen-value = ""
    13306         parts.cli-qnty          :screen-value = ""
    13307         parts.qnty              :screen-value = ""
    13308         parts.fact-qnty         :screen-value = ""
    13309         parts.cli-base-rate     :screen-value = ""
    13310         parts.part-code         :screen-value = ""
    13311         parts.cst-code          :screen-value = ""
    13312         parts.last-date         :screen-value = ""
    13313         fi-last-date-offset     :screen-value = ""
    13314         parts.PS                :screen-value = ""
    13315         fi-vat-type             :screen-value = ""
    13316         fi-vat-pc               :screen-value = ""
    13317         fi-slt-type             :screen-value = ""
    13318         fi-slt-pc               :screen-value = ""
    13319         fi-unit-cli             :screen-value = ""
    13320         val-price-cli           :screen-value = ""
    13321         val-price-base          :screen-value = ""
    13322         val-base-code           :screen-value = ""
    13323         val-price-rubl          :screen-value = ""
    13324         val-rubl-code           :screen-value = ""
    13325         FI-goods-artic          :screen-value = ""
    13326         FI-goods-prod-type-code :screen-value = ""
    13327         fi-gds-name             :screen-value = ""
    13328         fi-unit                 :screen-value = ""
    13329         fi-unit-2               :screen-value = ""
    13330         fi-clients-name         :screen-value = ""
    13331         FI-b-code               :screen-value = ""
    13332       .
    13333       assign
    13334         v-supp-type                           = ""
    13335         v-supp-code                           = ?
    13336         parts.supp-type         :screen-value = ""
    13337         parts.supp-code         :screen-value = ""
    13338         v-contract-code                       = 0
    13339         fi-contract-prn-code                  = ""
    13340         fi-contract-prn-code    :screen-value = ""
    13341         fi-contract-name        :screen-value = ""
    13342         v-exch-code                           = 0
    13343         v-alc-mark-db-num                     = 0
    13344         v-alc-mark-code                       = 0
    13345         v-alc-bottling-date                   = ?
    13346         v-alc-ref-ab-path                     = ""
    13347         v-alc-quality-certif-path             = ""
    13348         v-alc-certif-path                     = ""
    13349         v-alc-imp-type                        = ""
    13350         v-alc-imp-code                        = 0
    13351       .
    13352       find first buf_currency no-lock
    13353         where buf_currency.curr-code = v-exch-code
    13354         no-error .
    13355       if available buf_currency
    13356       then do:
    13357         assign
    13358           parts.exch-code :screen-value = string(buf_currency.curr-code
    13359                                                 ,parts.exch-code :format
    13360                                                 )
    13361           val-price-cli   :screen-value = string(buf_currency.curr-abbr
    13362                                                 ,val-price-cli  :format
    13363                                                 )
    13364         .
    13365       end.
    13366       find first buf_parts no-lock
    13367         where recid(buf_parts) = v-parts-recid
    13368         no-error .
    13369       if available buf_parts
    13370       then do:
    13371         define variable v-root-node   as integer no-undo .
    13372   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
    13374     (input  buf_parts.artic
    13375     ,input  buf_parts.prod-type
    13376     ,input  buf_parts.prod-code
    13377     ,output v-root-node
    13378     )  .
    13379   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    13381     (input  buf_parts.obj-type
    13382     ,input  buf_parts.obj-code
    13383     ,output v-host-code
    13384     )  .
    13385         define variable v-b-code like ub.bar-code.b-code no-undo .
    13386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
    13387     (buffer buf_parts
    13388     ,output v-b-code
    13389     ) no-error .
    13390         find first buf_clients no-lock
    13391           where buf_clients.obj-type = buf_parts.prod-type
    13392             and buf_clients.obj-code = buf_parts.prod-code
    13393           no-error .
    13394         define variable v-display-cli-info as logical no-undo .
    13395         assign
    13396           v-display-cli-info = (buf_parts.in-code = buf_parts.out-code
    13397                                 and buf_parts.is-supp
    13398                                )
    13399         .
    13400         assign
    13401           fi-unit-cli          :visible = v-display-cli-info
    13402           val-price-cli        :visible = v-display-cli-info
    13403           parts.cli-base-rate  :visible = v-display-cli-info
    13404           parts.exch-code      :visible = v-display-cli-info
    13405           r-exch-code          :visible = v-display-cli-info
    13406           parts.price-cli      :visible = v-display-cli-info
    13407           parts.cli-qnty       :visible = v-display-cli-info
    13408           tot-price-cli        :visible = v-display-cli-info
    13409           FI-label-koefficient :visible = v-display-cli-info
    13410         .
    13411         if v-display-cli-info
    13412         then do:
    13413           assign
    13414             parts.price-cli     :screen-value = string(buf_parts.price-cli
    13415                                                           ,parts.price-cli:format)
    13416             parts.cli-qnty      :screen-value = string(buf_parts.cli-qnty
    13417                                                           ,parts.cli-qnty:format)
    13418           .
    13419           find first buf_doc-line no-lock
    13420             where buf_doc-line.doc-code  = buf_parts.out-code
    13421               and buf_doc-line.artic     = buf_parts.artic
    13422               and buf_doc-line.prod-type = buf_parts.prod-type
    13423               and buf_doc-line.prod-code = buf_parts.prod-code
    13424             no-error .
    13425           if available buf_doc-line
    13426           then do:
    13427             assign
    13428               fi-unit-cli         :screen-value = string(buf_doc-line.unit-cli
    13429                                                             ,fi-unit-cli:format)
    13430             .
    13431           end.
    13432           find first buf_trn-doc no-lock
    13433             where buf_trn-doc.doc-code = buf_parts.out-code
    13434             no-error .
    13435           if available buf_trn-doc
    13436           then do:
    13437             assign
    13438               v-frame-title = "Документ №  " + buf_trn-doc.doc-code
    13439             .
    13440           end.
    13441         end.
    13442         assign
    13443           parts.price-base    :screen-value = string(buf_parts.price-base
    13444                                                         ,parts.price-base :format)
    13445           parts.price-rubl    :screen-value = string(buf_parts.price-rubl
    13446                                                         ,parts.price-rubl :format)
    13447           parts.qnty          :screen-value = string(buf_parts.qnty
    13448                                                         ,parts.qnty :format)
    13449           parts.fact-qnty     :screen-value = string(buf_parts.fact-qnty
    13450                                                         ,parts.fact-qnty :format)
    13451           parts.cli-base-rate :screen-value = string(buf_parts.cli-base-rate
    13452                                                         ,parts.cli-base-rate :format)
    13453           parts.cst-code      :screen-value = string(buf_parts.cst-code
    13454                                                         ,parts.cst-code :format)
    13455           parts.last-date     :screen-value = string(buf_parts.last-date
    13456                                                         ,parts.last-date :format)
    13457           fi-vat-type         :screen-value = string(buf_parts.vat-type
    13458                                                         ,fi-vat-type :format)
    13459           fi-vat-pc           :screen-value = string(buf_parts.VAT-pc
    13460                                                         ,fi-vat-pc :format)
    13461           fi-slt-type         :screen-value = string(buf_parts.slt-type
    13462                                                         ,fi-slt-type :format)
    13463           fi-slt-pc           :screen-value = string(buf_parts.SLT-pc
    13464                                                         ,fi-slt-pc :format)
    13465           parts.PS            :screen-value = string(buf_parts.PS )
    13466           fi-out-code         :screen-value = (if buf_parts.out-code = 'free-zone':U
    13467                                                then "свободно"
    13468                                                else
    13469                                                  ( if buf_parts.out-code = 'out-zone':U
    13470                                                    then "расход"
    13471                                                    else "резерв"
    13472                                                  )
    13473                                               )
    13474           v-alc-mark-db-num                 = buf_parts.mark-db-num
    13475           v-alc-mark-code                   = buf_parts.mark-code
    13476           v-alc-bottling-date               = buf_parts.alc-bottling-date
    13477           v-alc-ref-ab-path                 = buf_parts.alc-ref-ab-path
    13478           v-alc-quality-certif-path         = buf_parts.alc-quality-certif-path
    13479           v-alc-certif-path                 = buf_parts.alc-certif-path
    13480           v-alc-imp-type                    = buf_parts.alc-imp-type
    13481           v-alc-imp-code                    = buf_parts.alc-imp-code
    13482         .
    13483   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partppric in g#library
    13485   (  buffer buf_parts
    13486    , output fi-price-prod
    13487    , output fi-price-prodvat
    13488    , output v-vat-pc
    13489           )  .
    13490         display fi-price-prod fi-price-prodvat  with frame Dialog-Frame .
    13491         define variable v-display-part-code as character no-undo .
    13492         run partsfnc_get-parts-show-code in this-procedure
    13493           (input  buf_parts.part-code
    13494           ,input  buf_parts.mark-db-num
    13495           ,input  buf_parts.mark-code
    13496           ,input  buf_parts.alc-bottling-date
    13497           ,input  v-alcohol-prod
    13498           ,output v-display-part-code
    13499           ) .
    13500         assign
    13501           parts.part-code :screen-value = string(v-display-part-code
    13502                                                 ,parts.part-code :format
    13503                                                 )
    13504         .
    13505         run update-last-date-offset in this-procedure .
    13506         assign
    13507           v-supp-type = buf_parts.supp-type
    13508           v-supp-code = buf_parts.supp-code
    13509         .
    13510         assign
    13511           parts.supp-type     :screen-value = string(v-supp-type
    13512                                                         , parts.supp-type :format )
    13513           parts.supp-code     :screen-value = string(v-supp-code
    13514                                                         , parts.supp-code :format )
    13515         .
    13516         assign
    13517           v-contract-code = buf_parts.contract-code
    13518         .
    13519         if v-contract-code <> 0
    13520         then do:
    13521           define buffer buf_contract for ub.contract .
    13522           find first buf_contract no-lock
    13523             where buf_contract.host-code     = v-host-code
    13524               and buf_contract.contract-code = v-contract-code
    13525             no-error .
    13526           if not available buf_contract
    13527           then do:
    13528             message
    13529               "Не найден контракт" skip
    13530               "Объект" buf_parts.obj-type buf_parts.obj-code skip
    13531               "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    13532               "Партия" buf_parts.in-code buf_parts.part-code skip
    13533               "Документ" buf_parts.out-code skip
    13534               "Код фирмы" v-host-code skip
    13535               "Код контракта" v-contract-code skip
    13536               view-as alert-box error .
    13537           end.
    13538           else do:
    13539             assign
    13540               fi-contract-prn-code               = buf_contract.contract-prn-code
    13541               fi-contract-prn-code :screen-value = string(buf_contract.contract-prn-code
    13542                                                          , fi-contract-prn-code :format )
    13543               fi-contract-name     :screen-value =
    13544                 substitute("&1 Вн.н. &2"
    13545                           ,string(buf_contract.contract-date,'99/99/9999':u)
    13546                           ,v-contract-code)
    13547             .
    13548           end.
    13549         end.
    13550         find buf_currency no-lock
    13551           where buf_currency.curr-code = buf_parts.exch-code
    13552           no-error .
    13553         if available buf_currency
    13554         then do:
    13555           assign
    13556             v-exch-code = buf_parts.exch-code
    13557           .
    13558           run update-exch-code-dependent in this-procedure .
    13559         end.
    13560         find first buf_goods no-lock
    13561           where buf_goods.gds-code = p-gds-code
    13562           .
    13563         find first buf_doc-line no-lock
    13564           where buf_doc-line.doc-code  = p-doc-code
    13565             and buf_doc-line.artic     = buf_goods.artic
    13566             and buf_doc-line.prod-type = buf_goods.prod-type
    13567             and buf_doc-line.prod-code = buf_goods.prod-code
    13568           .
    13569         find first buf_trn-doc no-lock
    13570           where buf_trn-doc.doc-code = buf_doc-line.doc-code
    13571           .
    13572         if buf_trn-doc.doc-type = 'инв':U
    13573         then do:
    13574           define buffer free-parts for ub.parts .
    13575           find first free-parts no-lock
    13576             where free-parts.obj-type  = buf_parts.obj-type
    13577               and free-parts.obj-code  = buf_parts.obj-code
    13578               and free-parts.artic     = buf_parts.artic
    13579               and free-parts.prod-type = buf_parts.prod-type
    13580               and free-parts.prod-code = buf_parts.prod-code
    13581               and free-parts.in-code   = buf_parts.in-code
    13582               and free-parts.out-code  = 'free-zone':U
    13583               and free-parts.part-code = buf_parts.part-code
    13584             no-error .
    13585           define buffer rsrv-parts for ub.parts .
    13586           find first rsrv-parts no-lock
    13587             where rsrv-parts.obj-type  = buf_parts.obj-type
    13588               and rsrv-parts.obj-code  = buf_parts.obj-code
    13589               and rsrv-parts.artic     = buf_parts.artic
    13590               and rsrv-parts.prod-type = buf_parts.prod-type
    13591               and rsrv-parts.prod-code = buf_parts.prod-code
    13592               and rsrv-parts.in-code   = buf_parts.in-code
    13593               and rsrv-parts.out-code  = buf_trn-doc.doc-code
    13594               and rsrv-parts.part-code = buf_parts.part-code
    13595             no-error .
