    12024   ON RETURN OF ub.parts.price-base IN FRAME Dialog-Frame
    12025   DO:
    12026     define variable v-new-price-cli  like ub.parts.price-cli  no-undo .
    12027     define variable v-new-price-base like ub.parts.price-rubl no-undo .
    12028     define variable v-new-price-rubl like ub.parts.price-rubl no-undo .
    12029     if v-can-change-supp <> true
    12030     then do:
    12031       do with frame Dialog-Frame:
    12032         run trg/prc-calc.p
    12033           (input  "price-base":U
    12034           ,input  p-doc-code
    12035           ,input  p-gds-code
    12036           ,input  decimal(parts.price-cli  :screen-value )
    12037           ,input  decimal(parts.price-base :screen-value )
    12038           ,input  decimal(parts.price-rubl :screen-value )
    12039           ,output v-new-price-cli
    12040           ,output v-new-price-base
    12041           ,output v-new-price-rubl
    12042           ) no-error .
    12043         if error-status :error
    12044         then do:
    12045           message
    12046             vss-workfile vss-revision vss-description skip
    12047             "Ошибка при вызове программы пересчета цены prc-calc.p" skip
    12048             error-status :get-message(1) skip
    12049             return-value skip
    12050             view-as alert-box error .
    12051           return .
    12052         end.
    12053         run display-price in this-procedure
    12054           (input v-new-price-cli
    12055           ,input v-new-price-base
    12056           ,input v-new-price-rubl
    12057           ).
    12058       end.
