    15120   PROCEDURE reopen-query :
    15121     define input parameter v-new-parts-recid as recid no-undo .
    15122     if valid-handle(h-call-prog)
    15123     then do:
    15124       run reopen-query in h-call-prog
    15125         .
    15126       run reposition-parts in h-call-prog
    15127         (input  string(v-new-parts-recid)
    15128         ,output v-new-parts-recid
    15129         ).
    15130       apply 'entry':u to b-exit in frame Dialog-Frame .
    15131       if v-new-parts-recid <> ?
    15132       then do:
    15133         define buffer buf_parts for ub.parts .
    15134         find first buf_parts no-lock
    15135           where recid(buf_parts) = v-new-parts-recid
    15136           no-error .
    15137         assign
    15138           v-parts-recid = v-new-parts-recid
    15139         .
    15140         if available buf_parts
    15141         then do:
    15142           run disable-fields .
    15143           run display-fields .
    15144           run enable-fields .
    15145         end.
    15146       end.
    15147     end.
    15148   END PROCEDURE.
    15149   PROCEDURE reposition-parts :
    15150     define input parameter v-direction as character no-undo .
    15151     define variable v-new-parts-recid as recid no-undo .
    15152     if valid-handle(h-call-prog)
    15153     then do:
    15154       run reposition-parts in h-call-prog
    15155         (input  v-direction
    15156         ,output v-new-parts-recid
    15157         ).
    15158       if v-new-parts-recid <> ?
    15159       then do:
    15160         define buffer buf_parts for ub.parts .
    15161         find first buf_parts no-lock
    15162           where recid(buf_parts) = v-new-parts-recid
    15163           no-error .
    15164         assign
    15165           v-parts-recid = v-new-parts-recid
    15166         .
    15167         if available buf_parts
    15168         then do:
    15169           run disable-fields .
    15170           run display-fields .
    15171           run enable-fields .
    15172         end.
    15173       end.
    15174     end.
    15175   END PROCEDURE.
    15176   PROCEDURE update-dependent-price :
    15177     do
    15178     on error undo, return error return-value
    15179     :
    15180       do with frame Dialog-Frame
    15181       :
    15182         if v-can-change-supp = true
    15183         then do:
    15184           if v-enable-price-rubl = false
    15185           then do:
    15186             assign
    15187               parts.price-rubl :screen-value = parts.price-cli :screen-value
    15188             .
    15189           end.
    15190           if v-enable-price-base = false
    15191           then do:
    15192             case v-price-base-source
    15193             :
    15194               when 'price-cli':u
    15195               then do:
    15196                 assign
    15197                   parts.price-base :screen-value = parts.price-cli :screen-value
    15198                 .
    15199               end.
    15200               when 'price-rubl':u
    15201               then do:
    15202                 assign
    15203                   parts.price-base :screen-value = parts.price-rubl :screen-value
    15204                 .
    15205               end.
    15206               otherwise do:
    15207                 message
    15208                   vss-workfile vss-revision vss-description skip
    15209                   "Внутренняя ошибка" skip
    15210                   "Неизвестное значение v-price-base-source" v-price-base-source skip
    15211                   view-as alert-box error .
    15212               end.
    15213             end.
    15214           end.
    15215         end.
    15216       end.
    15217     end.
    15218   END PROCEDURE.
    15219   PROCEDURE update-enable-price-cli :
    15220     do
    15221     on error undo, return error return-value
    15222     :
    15223       do with frame Dialog-Frame
    15224       :
    15225         assign
    15226           fi-contract-prn-code :sensitive = v-enable-contract
    15227           r-contract           :sensitive = v-enable-contract
    15228         .
    15229         if v-display-price-cli = true
    15230         then do:
    15231           assign
    15232             parts.cli-base-rate :screen-value = "1"
    15233           .
    15234           assign
    15235             fi-unit-cli          :visible = true
    15236             val-price-cli        :visible = true
    15237             parts.cli-base-rate  :visible = true
    15238             parts.exch-code      :visible = true
    15239             r-exch-code          :visible = true
    15240             parts.price-cli      :visible = true
    15241             parts.cli-qnty       :visible = true
    15242             tot-price-cli        :visible = true
    15243             FI-label-koefficient :visible = true
    15244           .
    15245           assign
    15246             fi-unit-cli          :sensitive = false
    15247             val-price-cli        :sensitive = false
    15248             parts.cli-base-rate  :sensitive = false
    15249             parts.exch-code      :sensitive = v-enable-cli-exch-code
    15250             r-exch-code          :sensitive = v-enable-cli-exch-code
    15251             parts.price-cli      :sensitive = v-enable-price-cli
    15252             parts.cli-qnty       :sensitive = false
    15253             tot-price-cli        :sensitive = false
    15254             FI-label-koefficient :sensitive = false
    15255           .
    15256           if v-curr-r-b = 'base':U
    15257           then do:
    15258             assign
    15259               parts.price-cli :screen-value = parts.price-base :screen-value
    15260             .
    15261           end.
    15262           else do:
    15263             assign
    15264               parts.price-cli :screen-value = parts.price-rubl :screen-value
    15265             .
    15266           end.
    15267           assign
    15268             parts.cli-qnty :screen-value = parts.fact-qnty :screen-value
    15269           .
    15270         end.
    15271         else do:
    15272           assign
    15273             fi-unit-cli          :sensitive = false
    15274             val-price-cli        :sensitive = false
    15275             parts.cli-base-rate  :sensitive = false
    15276             parts.exch-code      :sensitive = false
    15277             r-exch-code          :sensitive = false
    15278             parts.price-cli      :sensitive = false
    15279             parts.cli-qnty       :sensitive = false
    15280             tot-price-cli        :sensitive = false
    15281             FI-label-koefficient :sensitive = false
    15282           .
    15283           assign
    15284             fi-unit-cli          :visible = false
    15285             val-price-cli        :visible = false
    15286             parts.cli-base-rate  :visible = false
    15287             parts.exch-code      :visible = false
    15288             r-exch-code          :visible = false
    15289             parts.price-cli      :visible = false
    15290             parts.cli-qnty       :visible = false
    15291             tot-price-cli        :visible = false
    15292             FI-label-koefficient :visible = false
    15293           .
    15294         end.
    15295         if parts.exch-code :sensitive
    15296         then do:
    15297           assign
    15298             parts.exch-code :fgcolor = ?
    15299           .
    15300         end.
    15301         else do:
    15302           assign
    15303             parts.exch-code :fgcolor = 4
    15304           .
    15305         end.
    15306       end.
    15307     end.
    15308   END PROCEDURE.
    15309   PROCEDURE update-exch-code-dependent :
    15310     define buffer buf_currency for ub.currency .
    15311     do
    15312     on error undo, return error return-value
    15313     :
    15314       find first buf_currency no-lock
    15315         where buf_currency.curr-code = v-exch-code
    15316         no-error .
    15317       if not available buf_currency then do:
    15318         message
    15319           vss-workfile vss-revision vss-description skip
    15320           "Внутренняя ошибка" skip
    15321           "Неизвестный код валюты" v-exch-code skip
    15322           view-as alert-box error .
    15323         undo, return error return-value .
    15324       end.
    15325       else do:
    15326         do with frame Dialog-Frame
    15327         :
    15328           assign
    15329             parts.exch-code :screen-value = string(buf_currency.curr-code
    15330                                                   ,parts.exch-code :format
    15331                                                   )
    15332             val-price-cli   :screen-value = string(buf_currency.curr-abbr
    15333                                                   ,val-price-cli  :format
    15334                                                   )
    15335           .
    15336         end.
    15337       end.
    15338     end.
    15339   END PROCEDURE.
    15340   PROCEDURE update-exch-code-enable :
    15341     do
    15342     on error undo, return error return-value
    15343     :
    15344       if v-can-change-supp = true
    15345       then do:
    15346         assign
    15347           v-price-base-source = '':u
    15348           v-enable-price-rubl = true
    15349           v-enable-price-base = true
    15350         .
    15351         if v-enable-price-cli = true
    15352         then do:
    15353           if v-exch-code = 0
    15354           then do:
    15355             assign
    15356               v-enable-price-rubl = false
    15357             .
    15358           end.
    15359           else do:
    15360             assign
    15361               v-enable-price-rubl = true
    15362             .
    15363           end.
    15364           if v-exch-code = (input frame Dialog-Frame val-base-code)
    15365           then do:
    15366             assign
    15367               v-enable-price-base = false
    15368               v-price-base-source = 'price-cli':u
    15369             .
    15370           end.
    15371           else do:
    15372             assign
    15373               v-enable-price-base = true
    15374             .
    15375           end.
    15376         end.
    15377         if (input frame Dialog-Frame val-base-code) = 0
    15378         then do:
    15379           assign
    15380             v-enable-price-base = false
    15381             v-price-base-source = 'price-rubl':u
    15382           .
    15383         end.
    15384       end.
    15385       if v-enable-price-rubl = true
    15386       then do:
    15387         assign
    15388           parts.price-rubl :sensitive = true
    15389         .
    15390       end.
    15391       else do:
    15392         assign
    15393           parts.price-rubl :sensitive = false
    15394         .
    15395       end.
    15396       if v-enable-price-base = true
    15397       then do:
    15398         assign
    15399           parts.price-base :sensitive = true
    15400         .
    15401       end.
    15402       else do:
    15403         assign
    15404           parts.price-base :sensitive = false
    15405         .
    15406       end.
    15407       run update-dependent-price in this-procedure .
    15408     end.
    15409   END PROCEDURE.
    15410   PROCEDURE update-last-date-offset :
    15411     do with frame Dialog-Frame
    15412     :
    15413       define variable v-last-date-offset as integer   no-undo .
    15414       define variable v-today     as date      no-undo .
    15415       define variable v-time      as integer   no-undo .
    15416       run cur-time in this-procedure
    15417         (output v-today
    15418         ,output v-time
    15419         ) .
    15420       run godendo-date-to-offset in this-procedure
    15421         (input  v-today
    15422         ,input  (input frame Dialog-Frame parts.last-date)
    15423         ,output v-last-date-offset
    15424         ) .
    15425       assign
    15426         fi-last-date-offset :screen-value = string(v-last-date-offset
    15427                                                   ,fi-last-date-offset :format
    15428                                                   )
    15429       .
    15430     end.
    15431   END PROCEDURE.
    15432   PROCEDURE update-record :
    15433     define output parameter v-close-window    as logical no-undo .
    15434     define variable v-ok as logical   no-undo .
    15435     define buffer buf2_trn-doc for ub.trn-doc  .
    15436     if p-mode <> 'ИЗМЕНЕНИЕ':U
    15437     then do:
    15438       return .
    15439     end.
    15440     define variable v-record-modified as logical no-undo .
    15441     define variable l-edit-reserv     as logical no-undo .
    15442     assign
    15443       v-close-window = false
    15444     .
    15445     run record-modified in this-procedure
    15446       (output v-record-modified
    15447       ) no-error .
    15448     if error-status :error
    15449     then do:
    15450       message
    15451         vss-workfile vss-revision vss-description skip
    15452         "Ошибка при вызове процедуры record-modified" skip
    15453         error-status :get-message(1) skip
    15454         return-value skip
    15455         view-as alert-box error .
    15456       undo, return error .
    15457     end.
    15458     if  v-record-modified = false
    15459     and v-create-part = false
    15460     then do:
    15461       return .
    15462     end.
    15463     define variable v-root-node as integer no-undo .
    15464     define buffer buf_parts    for ub.parts .
    15465     define buffer buf_goods    for ub.goods .
    15466     define buffer buf_doc-line for ub.doc-line .
    15467     define buffer buf_trn-doc  for ub.trn-doc .
    15468     do
    15469     transaction
    15470     on error undo, return error
    15471     :
    15472       if v-can-change-part-code
    15473       then do:
    15474         apply 'leave':u to ub.parts.part-code in frame Dialog-Frame .
    15475         run validate-part-code in this-procedure
    15476           (input v-new-parts-part-code
    15477           ,input v-parts-recid
    15478           ,input p-doc-code
    15479           ,input p-gds-code
    15480           ,input v-goods-serial
    15481           ) no-error .
    15482         if error-status :error
    15483         then do:
    15484           apply 'entry':u to parts.part-code in frame Dialog-Frame .
    15485           undo, return error .
    15486         end.
    15487       end.
    15488       if v-can-change-supp
    15489       then do:
    15490         run validate-supp in this-procedure
    15491           (input (input frame Dialog-Frame parts.supp-type)
    15492           ,input (input frame Dialog-Frame parts.supp-code)
    15493           ) no-error .
    15494         if error-status :error
    15495         then do:
    15496           apply 'entry':u to parts.supp-code.
    15497           undo, return error .
    15498         end.
    15499       end.
    15500       if  parts.price-base :sensitive
    15501       then do:
    15502         if decimal(parts.price-base :screen-value) = ?
    15503         then do:
    15504           message
    15505             substitute("Не задана учётная цена (&1)"
    15506                       ,val-price-base :screen-value
    15507                       ) skip
    15508             view-as alert-box error .
    15509           apply 'entry':u to parts.price-base .
    15510           undo, return error .
    15511         end.
    15512         if decimal(parts.price-base :screen-value) = 0
    15513         then do:
    15514           assign
    15515             v-ok = false
    15516           .
    15517           message
    15518             substitute("Учётная цена (&1) равна нулю"
    15519                       ,val-price-base :screen-value
    15520                       ) skip
    15521             "Партия будет сохранена с нулевой учётной ценой." skip
    15522             "Продолжить?" skip
    15523             view-as alert-box question buttons yes-no update v-ok .
    15524           if v-ok <> true
    15525           then do:
    15526             apply 'entry':u to parts.price-base .
    15527             undo, return error .
    15528           end.
    15529         end.
    15530       end.
    15531       if  parts.price-rubl :sensitive
    15532       then do:
    15533         if decimal(parts.price-rubl :screen-value) = ?
    15534         then do:
    15535           message
    15536             substitute("Не задана учётная цена (&1)"
    15537                       ,val-price-rubl :screen-value
    15538                       ) skip
    15539             view-as alert-box error .
    15540           apply 'entry':u to parts.price-rubl .
    15541           undo, return error .
    15542         end.
    15543         if decimal(parts.price-rubl :screen-value) = 0
    15544         then do:
    15545           assign
    15546             v-ok = false
    15547           .
    15548           message
    15549             substitute("Учётная цена (&1) равна нулю"
    15550                       ,val-price-rubl :screen-value
    15551                       ) skip
    15552             "Партия будет сохранена с нулевой учётной ценой." skip
    15553             "Продолжить?" skip
    15554             view-as alert-box question buttons yes-no update v-ok .
    15555           if v-ok <> true
    15556           then do:
    15557             apply 'entry':u to parts.price-rubl .
    15558             undo, return error .
    15559           end.
    15560         end.
    15561       end.
    15562       if  parts.price-cli :sensitive
    15563       then do:
    15564         if decimal(parts.price-cli :screen-value) = ?
    15565         then do:
    15566           message
    15567             substitute("Не задана цена поставщика (&1)"
    15568                       ,val-price-cli :screen-value
    15569                       ) skip
    15570             view-as alert-box error .
    15571           apply 'entry':u to parts.price-cli .
    15572           undo, return error .
    15573         end.
    15574         if decimal(parts.price-cli :screen-value) = 0
    15575         then do:
    15576           assign
    15577             v-ok = false
    15578           .
    15579           message
    15580             substitute("Цена поставщика (&1) равна нулю"
    15581                       ,val-price-cli :screen-value
    15582                       ) skip
    15583             "Партия будет сохранена с нулевой ценой поставщика." skip
    15584             "Продолжить?" skip
    15585             view-as alert-box question buttons yes-no update v-ok .
    15586           if v-ok <> true
    15587           then do:
    15588             apply 'entry':u to parts.price-cli .
    15589             undo, return error .
    15590           end.
    15591         end.
    15592       end.
    15593       find first buf_trn-doc
    15594         where buf_trn-doc.doc-code = p-doc-code
    15595         .
    15596       find first buf_goods no-lock
    15597         where buf_goods.gds-code = p-gds-code
    15598         .
    15599       find first buf_doc-line no-lock
    15600         where buf_doc-line.doc-code  = p-doc-code
    15601           and buf_doc-line.artic     = buf_goods.artic
    15602           and buf_doc-line.prod-type = buf_goods.prod-type
    15603           and buf_doc-line.prod-code = buf_goods.prod-code
    15604         .
    15605       if v-create-part = true
    15606       then do:
    15607         run partscr in this-procedure
    15608           (input  parparentproc
    15609           ,input  v-cntxt-db-num
    15610           ,input  v-cntxt-userid
    15611           ,input  (input frame Dialog-Frame parts.supp-type)
    15612           ,input  (input frame Dialog-Frame parts.supp-code)
    15613           ,input  v-new-parts-part-code
    15614           ,input  (input frame Dialog-Frame parts.cst-code )
    15615           ,input  (input frame Dialog-Frame parts.PS)
    15616           ,input  substitute("&1;&2"
    15617               , decimal(fi-price-prod :screen-value) * decimal(parts.cli-base-rate :screen-value)
    15618               , decimal(fi-price-prodvat :screen-value) * decimal(parts.cli-base-rate :screen-value)
    15619               )
    15620           ,input  decimal(parts.price-base :screen-value)
    15621           ,input  decimal(parts.price-rubl :screen-value)
    15622           ,input  fi-vat-type :screen-value
    15623           ,input  decimal(fi-vat-pc :screen-value)
    15624           ,input  fi-slt-type :screen-value
    15625           ,input  decimal(fi-slt-pc :screen-value)
    15626           ,input  0
    15627           ,input  'prompt=disable-create':u
    15628           ,input  0
    15629           ,input  (input frame Dialog-Frame parts.last-date )
    15630           ,input  parts.hold-date
    15631           ,input  p-pl-code
    15632           ,buffer buf_doc-line
    15633           ,buffer buf_parts
    15634           ) no-error .
    15635         if error-status :error
    15636         then do:
    15637           message
    15638             vss-workfile vss-revision vss-description skip
    15639             "Ошибка при создании партии" skip
    15640             "Документ" buf_doc-line.price-base skip
    15641             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    15642             error-status :get-message(1) skip
    15643             return-value skip
    15644             view-as alert-box error .
    15645           undo, return error .
    15646         end.
    15647         if not available buf_parts
    15648         and return-value <> ""
    15649         then do:
    15650           message
    15651             "Партия не может быть создана" skip
    15652             return-value skip
    15653             view-as alert-box .
    15654           undo, return error .
    15655         end.
    15656         assign
    15657           v-parts-recid = recid(buf_parts)
    15658         .
    15659       end.
    15660       else do:
    15661         find first buf_parts
    15662           where recid(buf_parts) = v-parts-recid
    15663           .
    15664       end.
    15665       assign
    15666         l-edit-reserv = (buf_parts.out-code = buf_trn-doc.doc-code)
    15667       .
    15668       if buf_parts.in-code = buf_parts.out-code
    15669       then do:
    15670         if parts.part-code :sensitive
    15671         then do:
    15672   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15673   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
    15674     (input  buf_parts.artic
    15675     ,input  buf_parts.prod-type
    15676     ,input  buf_parts.prod-code
    15677     ,output v-root-node
    15678     )  .
    15679           if v-goods-twounit = true
    15680           then do:
    15681             if length(buf_parts.part-code) > 10
    15682             or index(buf_parts.part-code, '#':U ) > 0
    15683             then do:
    15684               message
    15685                 "Код партии ювелирных изделий должен быть меньше или равен 10 символов" skip
    15686                 "И не должен содержать знак" '#':U skip
    15687                 view-as alert-box error .
    15688               apply 'entry':u to parts.part-code .
    15689               undo, return error .
    15690             end.
    15691           end.
    15692           assign
    15693             buf_parts.part-code = string(parts.part-code :screen-value)
    15694           .
    15695         end.
    15696         if v-can-change-part-code
    15697         then do:
    15698           if parts.price-cli :sensitive
    15699           then do:
    15700             assign
    15701               buf_parts.price-cli = decimal(parts.price-cli :screen-value)
    15702             .
    15703           end.
    15704           if fi-vat-pc :sensitive
    15705           then do:
    15706             assign
    15707               buf_parts.vat-pc = decimal(fi-vat-pc :screen-value)
    15708             .
    15709           end.
    15710           if fi-slt-pc :sensitive
    15711           then do:
    15712             assign
    15713               buf_parts.slt-pc = decimal(fi-slt-pc :screen-value)
    15714             .
    15715           end.
    15716           assign
    15717             buf_parts.price-base = decimal(parts.price-base :screen-value)
    15718           .
    15719           assign
    15720             buf_parts.price-rubl = decimal(parts.price-rubl :screen-value)
    15721           .
    15722           if not( buf_trn-doc.doc-type     = 'при':U
    15723                   and buf_trn-doc.internal = false)
    15724           then do:
    15725             if  buf_parts.cli-base-rate = 1
    15726             and buf_parts.exch-code     = 0
    15727             then do:
    15728               assign
    15729                 buf_parts.price-cli = buf_parts.price-rubl
    15730               .
    15731             end.
    15732             else do:
    15733               message
    15734                 vss-workfile vss-revision vss-description skip
    15735                 "Ошибка при создании партии" skip
    15736                 "Документ" buf_doc-line.price-base skip
    15737                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    15738                 "Для порожденной партии cli-base-rate отличен от 1" skip
    15739                 "cli-base-rate" buf_parts.cli-base-rate skip
    15740                 view-as alert-box error .
    15741               undo, return error .
    15742             end.
    15743           end.
    15744         end.
    15745         define variable v-create-old-return as logical no-undo .
    15746         define variable v-reason as character no-undo .
    15747         assign
    15748           v-create-old-return = false
    15749         .
    15750         if v-can-change-supp = true
    15751         then do:
    15752           run partscr_check-valid-supp in this-procedure
    15753             (input  string(parts.supp-type :screen-value)
    15754             ,input  integer(parts.supp-code :screen-value)
    15755             ,input
    15756           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    15757             ,input
    15758           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    15759             ,input  buf_trn-doc.ext-doc-type
    15760             ,output v-create-old-return
