     9381   function setattrUtdlines returns logical
     9382   (idb-num   as integer,
     9383    idoc-id   as integer,
     9384    ilinenum  as integer,
     9385    iattrcode as character,
     9386    iattrval  as character ):
     9387      define buffer utd-lines-attr for utd-lines-attr.
     9388      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9389                                  and utd-lines-attr.doc-id    eq idoc-id
     9390                                  and utd-lines-attr.lineNum   eq ilineNum
     9391                                  and utd-lines-attr.attr-code eq iattrcode
     9392      no-lock no-error.
     9393      if not available utd-lines-attr
     9394      then do:
     9395         if iattrval ne ?
     9396            and iattrval ne ""
     9397         then do:
     9398            create utd-lines-attr.
     9399            assign
     9400               utd-lines-attr.db-num    = idb-num
     9401               utd-lines-attr.doc-id    = idoc-id
     9402               utd-lines-attr.lineNum   = ilineNum
     9403               utd-lines-attr.attr-code = iattrcode
     9404               utd-lines-attr.attr-value = iattrval
     9405            .
     9406         end.
     9407      end.
     9408      else do:
     9409         if utd-lines-attr.attr-value ne iattrval
     9410         then do:
     9411            find current utd-lines-attr exclusive-lock no-error.
     9412            if available utd-lines-attr
     9413            then do:
     9414               if    iattrval eq ?
     9415                  or iattrval eq ""
     9416               then do:
     9417                  delete utd-lines-attr.
     9418               end.
     9419               else do:
     9420                  utd-lines-attr.attr-value = iattrval.
     9421               end.
     9422            end.
     9423         end.
     9424      end.
     9425      release utd-lines-attr.
     9426   end.
