     8109   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8110   procedure lineattr-value :
     8111     do
     8112     on error undo, return error return-value
     8113     :
     8114       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     8115       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8116       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     8117       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     8118       define output parameter p-type     as character no-undo .
     8119       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8120       def var v-format         as character no-undo .
     8121       def var v-fillin_width   as integer   no-undo .
     8122       def var v-fillin_height  as integer   no-undo .
     8123       def var v-label          as character no-undo .
     8124       def var v-user-can-edit  as logical   no-undo .
     8125       def var v-output-display as logical   no-undo .
     8126       def var v-other          as character no-undo .
     8127       run lineattr-code in this-procedure
     8128         (input  p-code
     8129         ,output p-type
     8130         ,output v-format
     8131         ,output v-fillin_width
     8132         ,output v-fillin_height
     8133         ,output v-label
     8134         ,output v-user-can-edit
     8135         ,output v-output-display
     8136         ,output v-other
     8137         ) no-error .
     8138       if error-status :error then do:
     8139         undo, return error return-value .
     8140       end.
     8141       find first buf_doc-line-attr no-lock
     8142         where buf_doc-line-attr.doc-code  = p-doc-code
     8143           and buf_doc-line-attr.gds-code  = p-gds-code
     8144           and buf_doc-line-attr.attr-code = p-code
     8145         no-error .
     8146       if avail buf_doc-line-attr then do:
     8147         assign
     8148           p-value =  buf_doc-line-attr.attr-value
     8149         .
     8150       end.
     8151       else do:
     8152         assign
     8153           p-value = if p-type = 'L':U then "no":U else ""
     8154         .
     8155       end.
     8156     end.
     8157   end procedure.
     8158   procedure lineattr-write :
     8159     do
     8160     on error undo, return error return-value
     8161     :
     8162       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     8163       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8164       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     8165       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     8166       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8167       def var v-type           as character no-undo .
     8168       def var v-format         as character no-undo .
     8169       def var v-fillin_width   as integer   no-undo .
     8170       def var v-fillin_height  as integer   no-undo .
     8171       def var v-label          as character no-undo .
     8172       def var v-user-can-edit  as logical   no-undo .
     8173       def var v-output-display as logical   no-undo .
     8174       def var v-other          as character no-undo .
     8175       run lineattr-code in this-procedure
     8176         (input  p-code
     8177         ,output v-type
     8178         ,output v-format
     8179         ,output v-fillin_width
     8180         ,output v-fillin_height
     8181         ,output v-label
     8182         ,output v-user-can-edit
     8183         ,output v-output-display
     8184         ,output v-other
     8185         ) no-error .
     8186       if error-status :error then do:
     8187         undo, return error return-value .
     8188       end.
     8189       find first buf_doc-line-attr exclusive-lock
     8190         where buf_doc-line-attr.doc-code  = p-doc-code
     8191           and buf_doc-line-attr.gds-code  = p-gds-code
     8192           and buf_doc-line-attr.attr-code = p-code
     8193         no-error .
     8194       if not available buf_doc-line-attr then do:
     8195         create buf_doc-line-attr .
     8196         assign
     8197           buf_doc-line-attr.doc-code  = p-doc-code
     8198           buf_doc-line-attr.gds-code = p-gds-code
     8199           buf_doc-line-attr.attr-code = p-code
     8200         .
     8201       end.
     8202       assign
     8203         buf_doc-line-attr.attr-value = p-value
     8204       .
     8205        release buf_doc-line-attr.
     8206     end.
     8207   end procedure.
     8208   procedure lineattr-exist :
     8209     do
     8210     on error undo, return error return-value
     8211     :
     8212       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     8213       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8214       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     8215       define output parameter p-exist   as logical  no-undo .
     8216       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8217       def var v-type           as character no-undo .
     8218       def var v-format         as character no-undo .
     8219       def var v-fillin_width   as integer   no-undo .
     8220       def var v-fillin_height  as integer   no-undo .
     8221       def var v-label          as character no-undo .
     8222       def var v-user-can-edit  as logical   no-undo .
     8223       def var v-output-display as logical   no-undo .
     8224       def var v-other          as character no-undo .
     8225       run lineattr-code in this-procedure
     8226         (input  p-code
     8227         ,output v-type
     8228         ,output v-format
     8229         ,output v-fillin_width
     8230         ,output v-fillin_height
     8231         ,output v-label
     8232         ,output v-user-can-edit
     8233         ,output v-output-display
     8234         ,output v-other
     8235         ) no-error .
     8236       if error-status :error then do:
     8237         undo, return error return-value .
     8238       end.
     8239       find first buf_doc-line-attr no-lock
     8240         where buf_doc-line-attr.doc-code  = p-doc-code
     8241           and buf_doc-line-attr.gds-code = p-gds-code
     8242           and buf_doc-line-attr.attr-code = p-code
     8243         no-error .
     8244       if  available buf_doc-line-attr then do:
     8245         p-exist = yes.
     8246       end.
     8247     end.
     8248   end procedure.
     8249   procedure lineattr-delete :
     8250     do
     8251     on error undo, return error return-value
     8252     :
     8253       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     8254       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8255       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     8256       define output parameter p-deleted  as logical no-undo.
     8257       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8258       def var v-type           as character no-undo .
     8259       def var v-format         as character no-undo .
     8260       def var v-fillin_width   as integer   no-undo .
     8261       def var v-fillin_height  as integer   no-undo .
     8262       def var v-label          as character no-undo .
     8263       def var v-user-can-edit  as logical   no-undo .
     8264       def var v-output-display as logical   no-undo .
     8265       def var v-other          as character no-undo .
     8266       run lineattr-code in this-procedure
     8267         (input  p-code
     8268         ,output v-type
     8269         ,output v-format
     8270         ,output v-fillin_width
     8271         ,output v-fillin_height
     8272         ,output v-label
     8273         ,output v-user-can-edit
     8274         ,output v-output-display
     8275         ,output v-other
     8276         ) no-error .
     8277       if error-status :error then do:
     8278         undo, return error return-value .
     8279       end.
     8280       find first buf_doc-line-attr exclusive-lock
     8281         where buf_doc-line-attr.doc-code  = p-doc-code
     8282           and buf_doc-line-attr.gds-code  = p-gds-code
     8283           and buf_doc-line-attr.attr-code = p-code
     8284         no-error NO-WAIT.
     8285       if not available buf_doc-line-attr then do:
     8286         p-deleted = no.
     8287       end.
     8288       else do:
     8289         delete buf_doc-line-attr.
     8290         p-deleted = yes.
     8291       end.
     8292     end.
     8293   end procedure.
     8294   procedure lineattr-code :
     8295     do on error undo, return error return-value
     8296     :
     8297       define input  parameter p-code           as character no-undo .
     8298       define output parameter p-type           as character no-undo .
     8299       define output parameter p-format         as character no-undo .
     8300       define output parameter p-fillin_width   as integer   no-undo .
     8301       define output parameter p-fillin_height  as integer   no-undo .
     8302       define output parameter p-label          as character no-undo .
     8303       define output parameter p-user-can-edit  as logical   no-undo .
     8304       define output parameter p-output-display as logical   no-undo .
     8305       define output parameter p-other          as character no-undo .
     8306       case p-code :
     8307               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8308               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8309               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8310               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8311               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     8312               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8313               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8314               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     8315               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     8316               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     8317               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     8318         otherwise do:
     8319           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     8320         end.
     8321       end.
     8322     end.
     8323   end procedure.
     8324   procedure lineattr-value-flora-gds :
     8325     do
     8326     on error undo, return error return-value
     8327     :
     8328       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     8329       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     8330       define input  parameter p-prt-code    as integer   no-undo .
     8331       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     8332       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     8333       define output parameter p-value       as    decimal   no-undo .
     8334       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8335       find first buf_doc-line-attr no-lock
     8336         where buf_doc-line-attr.doc-code  = p-doc-code
     8337           and buf_doc-line-attr.gds-code  = p-gds-code
     8338           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     8339         no-error .
     8340       if avail buf_doc-line-attr then do:
     8341         assign
     8342           p-value = decimal( buf_doc-line-attr.attr-value)
     8343         .
     8344       end.
