    12815   RUN disable_UI.
    12816   PROCEDURE apply-focus-next-entry :
    12817     define input parameter p-widget-handle as handle no-undo .
    12818     define variable v-apply-entry as logical no-undo .
    12819     assign
    12820       v-apply-entry = false
    12821     .
    12822     do with frame Dialog-Frame
    12823     :
    12824           if v-apply-entry   then do:     if parts.cli-qnty :sensitive     then do:       apply 'entry':u to parts.cli-qnty .       return .     end.   end.   if parts.cli-qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12825           if v-apply-entry   then do:     if parts.qnty :sensitive     then do:       apply 'entry':u to parts.qnty .       return .     end.   end.   if parts.qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12826           if v-apply-entry   then do:     if parts.fact-qnty :sensitive     then do:       apply 'entry':u to parts.fact-qnty .       return .     end.   end.   if parts.fact-qnty :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12827           if v-apply-entry   then do:     if parts.part-code :sensitive     then do:       apply 'entry':u to parts.part-code .       return .     end.   end.   if parts.part-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12828           if v-apply-entry   then do:     if parts.cst-code :sensitive     then do:       apply 'entry':u to parts.cst-code .       return .     end.   end.   if parts.cst-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12829           if v-apply-entry   then do:     if parts.supp-type :sensitive     then do:       apply 'entry':u to parts.supp-type .       return .     end.   end.   if parts.supp-type :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12830           if v-apply-entry   then do:     if parts.supp-code :sensitive     then do:       apply 'entry':u to parts.supp-code .       return .     end.   end.   if parts.supp-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12831           if v-apply-entry   then do:     if parts.last-date :sensitive     then do:       apply 'entry':u to parts.last-date .       return .     end.   end.   if parts.last-date :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12832           if v-apply-entry   then do:     if fi-last-date-offset :sensitive     then do:       apply 'entry':u to fi-last-date-offset .       return .     end.   end.   if fi-last-date-offset :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12833           if v-apply-entry   then do:     if fi-contract-prn-code :sensitive     then do:       apply 'entry':u to fi-contract-prn-code .       return .     end.   end.   if fi-contract-prn-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12834           if v-apply-entry   then do:     if parts.price-cli :sensitive     then do:       apply 'entry':u to parts.price-cli .       return .     end.   end.   if parts.price-cli :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12835           if v-apply-entry   then do:     if parts.exch-code :sensitive     then do:       apply 'entry':u to parts.exch-code .       return .     end.   end.   if parts.exch-code :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12836           if v-apply-entry   then do:     if parts.price-rubl :sensitive     then do:       apply 'entry':u to parts.price-rubl .       return .     end.   end.   if parts.price-rubl :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12837           if v-apply-entry   then do:     if parts.price-base :sensitive     then do:       apply 'entry':u to parts.price-base .       return .     end.   end.   if parts.price-base :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12838           if v-apply-entry   then do:     if fi-vat-pc :sensitive     then do:       apply 'entry':u to fi-vat-pc .       return .     end.   end.   if fi-vat-pc :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12839           if v-apply-entry   then do:     if fi-slt-pc :sensitive     then do:       apply 'entry':u to fi-slt-pc .       return .     end.   end.   if fi-slt-pc :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12840           if v-apply-entry   then do:     if b-exit :sensitive     then do:       apply 'entry':u to b-exit .       return .     end.   end.   if b-exit :handle = p-widget-handle   then do:     assign       v-apply-entry = true     .   end.
    12841       assign
    12842         v-apply-entry = true
    12843       .
    12844       if v-apply-entry = true
    12845       then do:
    12846         apply 'entry':u to b-exit .
    12847       end.
    12848     end.
    12849   END PROCEDURE.
    12850   PROCEDURE check-current-modified :
    12851     define variable lok as logical no-undo .
    12852     define variable v-record-modified as logical no-undo .
    12853     if v-fields-enabled
    12854     then do:
    12855       run record-modified in this-procedure
    12856         (output v-record-modified
    12857         ) no-error .
    12858       if error-status :error
    12859       then do:
    12860         message
    12861           vss-workfile vss-revision vss-description skip
    12862           "Ошибка при вызове процедуры record-modified" skip
    12863           error-status :get-message(1) skip
    12864           return-value skip
    12865           view-as alert-box error .
    12866         undo, return error .
    12867       end.
    12868       if v-record-modified = false
    12869       then do:
    12870         return .
    12871       end.
    12872       message
    12873         "Партия была изменена." skip
    12874         "ДА"     chr(9) "сохранить изменения и перейти к другой записи." skip
    12875         "НЕТ"    chr(9) "не сохранять изменения и перейти к другой записи." skip
    12876         "ОТМЕНА" chr(9) "не переходить к другой записи." skip
    12877         view-as alert-box question button yes-no-cancel update lok .
    12878       if lok = true
    12879       then do:
    12880         define variable v-close-window as logical no-undo .
    12881         run update-record in this-procedure
    12882           (output v-close-window
    12883           ) no-error .
    12884         if error-status :error
    12885         then do:
    12886           undo, return error .
    12887         end.
    12888         return .
    12889       end.
    12890       if lok = false
    12891       then do:
    12892         return .
    12893       end.
    12894       if lok = ?
    12895       then do:
    12896         undo, return error .
    12897       end.
    12898     end.
    12899   END PROCEDURE.
    12900   PROCEDURE choose-contract :
    12901     define input  parameter v-supp-type as character no-undo .
    12902     define input  parameter v-supp-code as integer   no-undo .
    12903     define buffer buf_trn-doc for ub.trn-doc .
    12904     define variable v-host-code as integer   no-undo .
    12905     do
    12906     transaction on error undo, return error return-value
    12907     :
    12908       find first buf_trn-doc no-lock
    12909         where buf_trn-doc.doc-code = p-doc-code
    12910         .
    12911   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12912   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12913     (input  buf_trn-doc.obj-type
    12914     ,input  buf_trn-doc.obj-code
    12915     ,output v-host-code
    12916     )  .
    12917       define buffer buf_contract for ub.contract .
    12918       run check-contract-code in this-procedure
    12919         (input  "choose":u
    12920         ,input  v-host-code
    12921         ,input  v-supp-type
    12922         ,input  v-supp-code
    12923         ,input  ?
    12924         ,input  parparentproc
    12925         ,input  buf_trn-doc.doc-date
    12926         ,input  ""
    12927         ,output v-contract-code
    12928         ) no-error .
    12929       if error-status :error
    12930       or v-contract-code = ?
    12931       or v-contract-code = 0
    12932       then do:
    12933         if return-value <> ""
    12934         or error-status :get-message(1) <> ""
    12935         then do:
    12936           message
    12937             "Ошибка при заведении номера договора." skip
    12938             return-value skip
    12939             error-status :get-message(1) skip
    12940             view-as alert-box error.
    12941         end.
    12942         return error.
    12943       end.
    12944       assign
    12945         v-modified-contract-code = true
    12946       .
    12947       find first buf_contract no-lock
    12948         where buf_contract.host-code     = v-host-code
    12949           and buf_contract.contract-code = v-contract-code
    12950         .
    12951       display
    12952         buf_contract.contract-prn-code @ fi-contract-prn-code
    12953         substitute("&1 Вн.н. &2"
    12954                   ,string(buf_contract.contract-date,'99/99/9999':u)
    12955                   ,v-contract-code) @ fi-contract-name
    12956         with frame Dialog-Frame .
    12957       assign
    12958         fi-contract-prn-code
    12959       .
    12960       assign
    12961         v-modified-exch-code = true
    12962         v-exch-code          = buf_contract.curr-code
    12963       .
    12964       run update-exch-code-dependent in this-procedure .
    12965       assign
    12966         v-display-price-cli    = true
    12967         v-enable-price-cli     = true
    12968         v-enable-cli-exch-code = false
    12969       .
    12970       run update-enable-price-cli in this-procedure .
    12971       run update-exch-code-enable in this-procedure .
    12972     end.
    12973   END PROCEDURE.
    12974   PROCEDURE choose-exch-code :
    12975     define input  parameter v-exch-code as integer   no-undo .
    12976     define buffer buf_currency for ub.currency .
    12977     define variable v-repos-recid as recid     no-undo .
    12978     do
    12979     on error undo, return error return-value
    12980     :
    12981       find first buf_currency no-lock
    12982         where buf_currency.curr-code = v-exch-code
    12983         no-error .
    12984       if available buf_currency
    12985       then do:
    12986         assign
    12987           v-repos-recid = recid(buf_currency)
    12988         .
    12989       end.
    12990       else do:
    12991         assign
    12992           v-repos-recid = ?
    12993         .
    12994       end.
    12995       run ref/currency.w
    12996         (input parparentproc
    12997         ,input "b-sel"
    12998         ,input-output v-repos-recid
    12999         ).
    13000       if v-repos-recid <> ?
    13001       then do:
    13002         find first buf_currency no-lock
    13003           where recid( buf_currency ) = v-repos-recid
    13004           no-error .
    13005         if available buf_currency
    13006         then do:
    13007           do with frame Dialog-Frame
    13008           :
    13009             assign
    13010               parts.exch-code :screen-value = string(buf_currency.curr-code
    13011                                                     ,parts.exch-code :format
    13012                                                     )
    13013               val-price-cli   :screen-value = string(buf_currency.curr-abbr
    13014                                                     ,val-price-cli  :format
    13015                                                     )
    13016             .
    13017           end.
    13018         end.
    13019         run validate-exch-code in this-procedure no-error .
    13020         if error-status :error
    13021         then do:
    13022           if error-status :get-message(1) <> ""
    13023           then do:
    13024             message
    13025               vss-workfile vss-revision vss-description skip
    13026               "Ошибка при вызове процедуры" skip
    13027               error-status :get-message(1) skip
    13028               return-value skip
    13029               view-as alert-box error .
    13030           end.
    13031           undo, return no-apply .
    13032         end.
    13033       end.
    13034     end.
    13035   END PROCEDURE.
    13036   PROCEDURE clear-contract-value :
    13037     define buffer buf_currency for ub.currency .
    13038     do
    13039     on error undo, return error return-value
    13040     :
