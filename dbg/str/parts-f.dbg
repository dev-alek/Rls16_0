     8446   procedure lineattr-write-add-line-cli :
     8447   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     8448   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     8449   define input  parameter p-cli-type      as character no-undo .
     8450   define input  parameter p-cli-code      as integer   no-undo .
     8451   define input  parameter p-contract-code as integer   no-undo .
     8452   define input  parameter p-host-code     as integer   no-undo .
     8453   define input  parameter p-exch-code     as integer   no-undo .
     8454   define input  parameter p-exch-rate     as decimal   no-undo .
     8455   define input  parameter p-exch-scale    as integer   no-undo .
     8456   define input  parameter p-sum-cli       as decimal   no-undo .
     8457   define input  parameter p-sum-vat       as decimal   no-undo .
     8458   define buffer buf_doc-line-attr for ub.doc-line-attr .
     8459     do
     8460     on error undo, return error return-value
     8461     :
     8462       find first buf_doc-line-attr exclusive-lock
     8463         where buf_doc-line-attr.doc-code  = p-doc-code
     8464           and buf_doc-line-attr.gds-code  = p-gds-code
     8465           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     8466                                             chr(4) + p-cli-type +
     8467                                             chr(4) + string(p-cli-code) +
     8468                                             chr(4) + string(p-contract-code) +
     8469                                             chr(4) + string(p-host-code)
     8470         no-error .
     8471       if not available buf_doc-line-attr then do:
     8472         create buf_doc-line-attr .
     8473         assign
     8474           buf_doc-line-attr.doc-code  = p-doc-code
     8475           buf_doc-line-attr.gds-code  = p-gds-code
     8476           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     8477                                         chr(4) + p-cli-type +
     8478                                         chr(4) + string(p-cli-code) +
     8479                                         chr(4) + string(p-contract-code) +
     8480                                         chr(4) + string(p-host-code)
     8481         .
     8482       end.
     8483       assign
     8484         buf_doc-line-attr.attr-value =
     8485         string(p-exch-code)  + chr(4) +
     8486         string(p-exch-rate)  + chr(4) +
     8487         string(p-exch-scale) + chr(4) +
     8488         string(p-sum-cli)    + chr(4) +
     8489         string(p-sum-vat)
     8490         .
     8491     end.
     8492   end procedure.
     8493   procedure lineattr-value-add-line-cli :
     8494   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     8495   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     8496   define input   parameter p-cli-type      as character no-undo .
     8497   define input   parameter p-cli-code      as integer   no-undo .
     8498   define input   parameter p-contract-code as integer   no-undo .
     8499   define input   parameter p-host-code     as integer   no-undo .
     8500   define output  parameter p-exch-code     as integer   no-undo .
     8501   define output  parameter p-exch-rate     as decimal   no-undo .
     8502   define output  parameter p-exch-scale    as integer   no-undo .
     8503   define output  parameter p-sum-cli       as decimal   no-undo .
     8504   define output  parameter p-sum-vat       as decimal   no-undo .
     8505   define buffer buf_doc-line-attr for ub.doc-line-attr .
     8506     do
     8507     on error undo, return error return-value
     8508     :
     8509       find first buf_doc-line-attr exclusive-lock
     8510         where buf_doc-line-attr.doc-code  = p-doc-code
     8511           and buf_doc-line-attr.gds-code  = p-gds-code
     8512           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     8513                                             chr(4) + p-cli-type +
     8514                                             chr(4) + string(p-cli-code) +
     8515                                             chr(4) + string(p-contract-code) +
     8516                                             chr(4) + string(p-host-code)
     8517         no-error .
     8518       if available buf_doc-line-attr then do:
     8519        assign
     8520           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     8521           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     8522           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     8523           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     8524           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     8525          .
     8526        end.
     8527     end.
     8528   end procedure.
     8529   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     8530     define variable v-code as character no-undo .
     8531     define variable v-type as character no-undo .
     8532     define variable v-gds-code as integer   no-undo .
     8533   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     8535     (input  local-doc-line.artic
     8536     ,input  local-doc-line.prod-type
     8537     ,input  local-doc-line.prod-code
     8538     ,output v-gds-code
     8539     )  .
     8540     run lineattr-value (
     8541         input   local-doc-line.doc-code ,
     8542         input   v-gds-code              ,
     8543         input   'reason-code':U ,
     8544         output  v-code                  ,
     8545         output  v-type ) .
     8546     find first ub.trn-reason no-lock where
     8547                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     8548     if not available ub.trn-reason then do:
     8549        return "" .
     8550     end.
     8551     else do:
     8552        return ub.trn-reason.reason-name .
     8553     end.
     8554   end function.
     8555   procedure lineattr-value-parts :
     8556     do
