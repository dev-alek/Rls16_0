    12468   run minbtn-set in this-procedure .
    12469   on choose of b-help in frame Dialog-Frame
    12470   do:
    12471     apply "help":u to frame Dialog-Frame .
    12472   end.
    12473   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12474   procedure minbtn-set :
    12475       do
    12476           on error undo, return error return-value
    12477           :
    12478           define variable ii              as integer       no-undo .
    12479           define variable fh              as widget-handle no-undo .
    12480           define variable hh              as widget-handle no-undo .
    12481           define variable v-h             as handle        extent 4 no-undo .
    12482           define variable v-name-button   as character     no-undo .
    12483           define variable v-help-old-x    as decimal       no-undo .
    12484           define variable v-help-old-y    as decimal       no-undo .
    12485           define variable v-help-old-size as decimal       no-undo .
    12486           define variable v-frame-width   as decimal       no-undo .
    12487           define variable jj              as integer       no-undo .
    12488           do
    12489               on error undo, return error
    12490               :
    12491               assign
    12492                   v-frame-width = frame Dialog-Frame:width - 0.3
    12493                   fh            = frame Dialog-Frame:first-child
    12494                   hh            = fh:first-child
    12495                   ii            = 1
    12496                   .
    12497               do while valid-handle(hh):
    12498                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    12499                   do:
    12500                       case lc(hh:name) :
    12501                           when "b-help" then
    12502                               do:
    12503                                   hh:load-image-up("cmp/b-help.bmp":u) .
    12504                                   hh:load-image-down("cmp/b-help.bmp":u) .
    12505                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    12506                                   hh:TOOLTIP = "Помощь" .
    12507                                   v-help-old-x = hh:column .
    12508                                   v-help-old-y = hh:row    .
    12509                                   v-help-old-size = hh:width .
    12510                                   hh:width-chars = 2.5 .
    12511                               end.
    12512                           when "b-print" then
    12513                               do:
    12514                                   hh:load-image("cmp/b-print.bmp":u) .
    12515                                   hh:TOOLTIP = "Печать" .
    12516                                   v-h[ii] = hh:handle .
    12517                                   ii = ii + 1 .
    12518                                   hh:width-chars = 3 .
    12519                               end.
    12520                           when "b-history" or
    12521                           when "b-hist" then
    12522                               do:
    12523                                   hh:load-image("cmp/b-hist.bmp":u) .
    12524                                   hh:TOOLTIP = "История" .
    12525                                   v-h[ii] = hh:handle .
    12526                                   ii = ii + 1 .
    12527                                   hh:width-chars = 3 .
    12528                               end.
    12529                           when "b-sch" then
    12530                               do:
    12531                                   hh:load-image("cmp/b-sch.bmp":u) .
    12532                                   hh:TOOLTIP = "Установка Фильтра" .
    12533                                   v-h[ii] = hh:handle .
    12534                                   ii = ii + 1 .
    12535                                   hh:width-chars = 3 .
    12536                               end.
    12537                           when "b-hist-user" then
    12538                               do:
    12539                                   hh:load-image("cmp/b-hist.bmp":u) .
    12540                                   hh:TOOLTIP = "История пользователя" .
    12541                                   ii = ii + 1 .
    12542                               end.
    12543                       end case.
    12544                   end.
    12545                   hh = hh:next-sibling.
    12546               end.
    12547               b-help:column = v-frame-width - b-help:width-chars.
    12548               jj = 0.
    12549               repeat ii = 4 to 1 by -1 :
    12550                   if valid-handle (v-h[ii] ) then
    12551                   do:
    12552                       jj  = jj + 1 .
    12553                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    12554                       v-h[ii]:row    = v-help-old-y .
    12555                   end.
    12556               end.
    12557           end.
    12558       end.
    12559   end procedure.
    12560   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12561   on ' ' of parts.last-date in frame Dialog-Frame
    12562   do:
    12563     if (can-query (self, "sensitive")
    12564        and
    12565        self :sensitive = true
    12566        )
    12567     or (can-query (self, "read-only")
    12568        and
    12569        self :read-only = false
    12570        )
    12571     then do:
    12572       assign
    12573         self :screen-value = ?
    12574       .
    12575     end.
    12576     return no-apply.
    12577   end.
    12578   on delete-character of parts.last-date in frame Dialog-Frame
    12579   do:
    12580     if (can-query (self, "sensitive")
    12581        and
    12582        self :sensitive = true
    12583        )
    12584     or (can-query (self, "read-only")
    12585        and
