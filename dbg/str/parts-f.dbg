    13998   PROCEDURE display-price :
    13999     define input parameter v-new-price-cli  like ub.parts.price-cli  no-undo .
    14000     define input parameter v-new-price-base like ub.parts.price-rubl no-undo .
    14001     define input parameter v-new-price-rubl like ub.parts.price-rubl no-undo .
    14002     do with frame Dialog-Frame:
    14003       if parts.price-cli :visible
    14004       then do:
    14005         if string(decimal(parts.price-cli :screen-value)
    14006                  ,parts.price-cli :format )
    14007         <> string(v-new-price-cli
    14008                  ,parts.price-cli :format )
    14009         then do:
    14010           assign
    14011             parts.price-cli :screen-value = string(v-new-price-cli
    14012                                                   ,parts.price-cli :format )
    14013           .
    14014         end.
    14015       end.
    14016       if parts.price-base :visible
    14017       then do:
    14018         if string(decimal(parts.price-base :screen-value)
    14019                  ,parts.price-base :format )
    14020         <> string(v-new-price-base
    14021                  ,parts.price-base :format )
    14022         then do:
    14023           assign
    14024             parts.price-base :screen-value = string(v-new-price-base
    14025                                                   ,parts.price-base :format )
    14026           .
    14027         end.
    14028       end.
    14029       if parts.price-rubl :visible
    14030       then do:
    14031         if string(decimal(parts.price-rubl :screen-value)
    14032                  ,parts.price-rubl :format )
    14033         <> string(v-new-price-rubl
    14034                  ,parts.price-rubl :format )
    14035         then do:
    14036           assign
    14037             parts.price-rubl :screen-value = string(v-new-price-rubl
    14038                                                   ,parts.price-rubl :format )
    14039           .
    14040         end.
    14041       end.
    14042     end.
    14043   END PROCEDURE.
    14044   PROCEDURE enable-fields :
    14045     define buffer buf_parts    for ub.parts .
    14046     define buffer buf_doc-line for ub.doc-line .
    14047     define buffer buf_trn-doc  for ub.trn-doc .
    14048     define buffer buf_goods    for ub.goods .
    14049     do with frame Dialog-Frame:
    14050       if p-mode = 'ИЗМЕНЕНИЕ':U
    14051       then do:
    14052         assign
    14053           v-fields-enabled = true
    14054         .
    14055         find first buf_trn-doc no-lock
    14056           where buf_trn-doc.doc-code = p-doc-code
    14057           .
    14058         find first buf_goods no-lock
    14059           where buf_goods.gds-code = p-gds-code
    14060           .
    14061         find first buf_doc-line no-lock
    14062           where buf_doc-line.doc-code  = p-doc-code
    14063             and buf_doc-line.artic     = buf_goods.artic
    14064             and buf_doc-line.prod-type = buf_goods.prod-type
    14065             and buf_doc-line.prod-code = buf_goods.prod-code
    14066           .
    14067         find first buf_parts no-lock
    14068           where recid(buf_parts) = v-parts-recid
    14069           no-error .
    14070         assign
    14071           parts.PS :read-only = false
    14072         .
    14073         define variable l-external-income as logical no-undo .
    14074         assign
    14075           l-external-income = (buf_trn-doc.doc-type = 'при':U
    14076                               and buf_trn-doc.internal = false
    14077                               )
    14078         .
    14079         if  l-external-income = true
    14080         and v-goods-petroleum = true
    14081         then do:
    14082           message
    14083             "Во внешнем приходе топливо нельзя редактировать через партии" skip
    14084             view-as alert-box information .
    14085           undo, return error .
    14086         end.
    14087         assign
    14088           v-can-change-part-code =  ( buf_trn-doc.doc-type    <> 'инв':U
    14089                                       and ((buf_trn-doc.status_   = 'накл':U
    14090                                             and buf_trn-doc.flag_ = no
    14091                                             )
    14092                                             or
    14093                                             (buf_trn-doc.status_ = 'касс':U)
    14094                                           )
    14095                                       and ( (available buf_parts
    14096                                               and buf_parts.in-code = buf_parts.out-code
    14097                                             )
    14098                                             or
    14099                                             v-create-part
    14100                                           )
    14101                                     )
    14102                                     or
    14103                                     ( buf_trn-doc.doc-type    <> 'инв':U
    14104                                       and buf_trn-doc.status_   = 'накл':U
    14105                                       and buf_trn-doc.flag_ = true
    14106                                       and ( (available buf_parts
    14107                                               and buf_parts.in-code = buf_parts.out-code
    14108                                               and buf_parts.qnty = 0
    14109                                             )
    14110                                             or
    14111                                             v-create-part
    14112                                           )
    14113                                     )
    14114                                     or
    14115                                     ( buf_trn-doc.doc-type    = 'инв':U
