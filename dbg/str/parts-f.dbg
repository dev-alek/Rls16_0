     1466                                             or (can-do('инв':U, buf_trn-doc.doc-type)
     1467                                                 and (buf_parts.qnty + p-change-qnty) < 0
     1468                                                 )
     1469                                           then yes
     1470                                           else no
     1471                                         )
     1472                 buf_parts.is-supp       = ( if l-create-old-return then yes else no )
     1473                 buf_parts.pay-code      = buf_trn-doc.pay-code
     1474                 buf_parts.purch-code    = integer('1':U)
     1475                 buf_parts.price-base    = p-part-reserv-base
     1476                 buf_parts.price-rubl    = p-part-reserv-rubl
     1477                 buf_parts.road-tax-base = 0
     1478                 buf_parts.road-tax-rubl = 0
     1479                 buf_parts.cli-base-rate = buf_doc-line.cli-base-rate
     1480                 buf_parts.exch-code     = 0
     1481                 buf_parts.price-cli     = buf_parts.price-rubl
     1482               .
     1483             end.
     1484             validate buf_parts .
     1485           end.
     1486           when "quit":u
     1487           then do:
     1488           end.
     1489         end case .
     1490       end.
     1491       if available buf_parts
     1492       then do:
     1493         if l-fact-qnty
     1494         then do:
     1495           assign
     1496             buf_parts.fact-qnty = buf_parts.fact-qnty + p-change-qnty
     1497           .
     1498         end.
     1499         else do:
     1500           assign
     1501             buf_parts.qnty      = buf_parts.qnty + p-change-qnty
     1502             buf_parts.fact-qnty = buf_parts.qnty
     1503           .
     1504           if buf_trn-doc.doc-type = 'инв':U
     1505           then do:
     1506             assign
     1507               buf_parts.rsrv-free     = ( if buf_parts.qnty < 0
     1508                                           then true
     1509                                           else false
     1510                                         )
     1511             .
     1512           end.
     1513         end.
     1514         if l-goods-twounit = true
     1515         then do:
     1516           if p-cli-qnty <> 0
     1517           then do:
     1518             assign
     1519               buf_parts.cli-qnty = p-cli-qnty
     1520             .
     1521             assign
     1522               buf_parts.cli-base-rate = buf_parts.qnty / buf_parts.cli-qnty
     1523             .
     1524           end.
     1525         end.
     1526         else do:
     1527           if buf_parts.cli-base-rate <> 0
     1528           then do:
     1529             assign
     1530               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     1531             .
     1532           end.
     1533           else do:
     1534             assign
     1535               buf_parts.cli-qnty = 0
     1536             .
     1537           end.
     1538           if abs(buf_parts.cli-qnty - p-cli-qnty) < 0.0011
     1539           then do :
     1540             assign
     1541               buf_parts.cli-qnty = p-cli-qnty
     1542             .
     1543           end .
     1544         end.
     1545         if l-goods-twounit = false
     1546         then do:
     1547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
     1548     (input  'cli-qnty'
     1549     ,input  buf_parts.cli-base-rate
     1550     ,input  buf_parts.cli-qnty
     1551     ,input  buf_parts.qnty
     1552     ,output buf_parts.cli-qnty
     1553     ,output buf_parts.qnty
     1554     ) no-error .
     1555           if error-status :error
     1556           then do:
     1557             message
     1558               "Невозможно пересчитать количество по ТТН" skip
     1559               "Документ" buf_parts.out-code skip
     1560               'Артикул':U buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1561               "Партия" + string(buf_parts.part-code) skip
     1562               return-value skip
     1563               view-as alert-box .
     1564             undo, return error .
     1565           end.
     1566         end.
     1567         if l-goods-serial
     1568         then do:
     1569           if  buf_parts.qnty <> 0
     1570           and buf_parts.qnty <> 1
     1571           then do:
     1572             message
     1573               "Товар серийный." skip
     1574               "Невозможно порождение партии с количеством, отличным от 1."
     1575               view-as alert-box .
     1576             undo, return error .
     1577           end.
     1578         end.
     1579       end.
     1580       return .
     1581     end.
     1582   end procedure.
     1583   procedure partscr_check-valid-supp :
     1584     define input parameter  p-supp-type         like ub.parts.supp-type no-undo .
     1585     define input parameter  p-supp-code         like ub.parts.supp-code no-undo .
     1586     define input parameter  p-trn-doc-supp-type like ub.parts.supp-type no-undo .
     1587     define input parameter  p-trn-doc-supp-code like ub.parts.supp-code no-undo .
     1588     define input parameter  p-extended-doc-type as character no-undo .
     1589     define output parameter p-old-return        as logical no-undo .
     1590     define output parameter p-reason            as character no-undo .
     1591     assign
     1592       p-old-return = false
     1593       p-reason     = ""
     1594     .
     1595     if p-supp-type <> p-trn-doc-supp-type
     1596     or p-supp-code <> p-trn-doc-supp-code
     1597     then do:
     1598       if p-extended-doc-type = 're':U
     1599       or p-extended-doc-type = 'rs':U
     1600       or p-extended-doc-type = 'vt':U
     1601       or p-extended-doc-type = 'vp':U
     1602       then do:
     1603         if p-supp-type = 'чел':U
     1604         or p-supp-type = 'орг':U
     1605         then do:
     1606           assign
     1607             p-old-return = true
     1608           .
     1609         end.
     1610         else do:
     1611           assign
     1612             p-reason = "Поставщиком партии старого возврата может быть только человек или организация"
     1613           .
     1614           return .
     1615         end.
     1616       end.
     1617       else do:
     1618         assign
     1619           p-reason = "Поставщиком порожденной партии может быть только объект документа"
     1620         .
     1621         return .
     1622       end.
     1623     end.
     1624     return .
     1625   end procedure.
     1626   procedure partscr_get-default-values :
     1627     define parameter buffer buf_doc-line for ub.doc-line .
     1628     define output parameter p-vat-type   as character no-undo .
     1629     define output parameter p-vat-pc     as decimal   no-undo .
     1630     define output parameter p-slt-type   as character no-undo .
     1631     define output parameter p-slt-pc     as decimal   no-undo .
     1632     define buffer buf_trn-doc for ub.trn-doc .
     1633     define buffer buf_goods for ub.goods .
     1634     define variable v-vat-pc as decimal   no-undo .
     1635     define variable v-host-code as integer   no-undo .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639       if not available buf_doc-line
     1640       then do:
     1641         message
     1642           vss-workfile vss-revision vss-description skip
     1643           "Ошибка задания входных параметров" skip
     1644           "Не задана строка документа" skip
     1645           view-as alert-box error .
     1646         undo, return error return-value .
     1647       end.
     1648       find first buf_trn-doc no-lock
     1649         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1650         no-error .
     1651       if not available buf_trn-doc
     1652       then do:
     1653         message
     1654           vss-workfile vss-revision vss-description skip
     1655           "Не найден документ" skip
     1656           "Код документа" buf_doc-line.doc-code skip
     1657           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1658           view-as alert-box error .
     1659         undo, return error return-value .
     1660       end.
     1661       find first buf_goods no-lock
     1662         where buf_goods.artic     = buf_doc-line.artic
     1663           and buf_goods.prod-type = buf_doc-line.prod-type
     1664           and buf_goods.prod-code = buf_doc-line.prod-code
     1665         no-error .
     1666       if not available buf_goods
     1667       then do:
     1668         message
     1669           vss-workfile vss-revision vss-description skip
     1670           "Ошибка поиска товара" skip
     1671           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1672           view-as alert-box error .
     1673         undo, return error return-value .
     1674       end.
     1675       if buf_trn-doc.ext-doc-type = 'ie':U
     1676       or buf_trn-doc.ext-doc-type = 'im':U
     1677       then do:
     1678         assign
     1679           p-vat-type = buf_trn-doc.vat-type
     1680           p-vat-pc   = buf_doc-line.vat-pc
     1681           p-slt-type = buf_trn-doc.slt-type
     1682           p-slt-pc   = buf_doc-line.slt-pc
     1683         .
     1684       end.
     1685       else do:
     1686   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1688     (input  buf_doc-line.obj-type
     1689     ,input  buf_doc-line.obj-code
     1690     ,output v-host-code
     1691     )  .
     1692   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1694     (input  buf_goods.gds-code
     1695     ,input  '1':U
     1696     ,input  ?
     1697     ,input  v-host-code
     1698     ,input  buf_trn-doc.obj-type
     1699     ,input  buf_trn-doc.obj-code
     1700     ,output v-vat-pc
     1701     ) no-error .
     1702         assign
     1703           p-vat-type = 'в т. ч.':U
     1704           p-vat-pc   = v-vat-pc
     1705           p-slt-type = 'без':U
     1706           p-slt-pc   = 0
     1707         .
     1708       end.
     1709     end.
     1710   end procedure.
     1711   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   procedure partrqst :
     1713     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     1714     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     1715     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     1716     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     1717     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     1718     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     1719     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     1720     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     1721     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     1722     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     1723     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     1724     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     1725     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     1726     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     1727     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     1728     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     1729     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     1730     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     1731     do
     1732     on error undo, return error return-value
     1733     :
     1734       assign
     1735         p-total-parts-qnty           = 0
     1736         p-total-parts-fact-qnty      = 0
     1737         p-total-parts-cli-qnty       = 0
     1738         p-total-parts-fact-cli-qnty  = 0
     1739         p-total-parts-price-cli      = 0
     1740         p-total-parts-price-base     = 0
     1741         p-total-parts-price-rubl     = 0
     1742         p-total-parts-transport-base = 0
     1743         p-total-parts-transport-rubl = 0
     1744         p-total-parts-other-base     = 0
     1745         p-total-parts-other-rubl     = 0
     1746       .
     1747       define buffer buf_parts for ub.parts .
     1748       for each buf_parts no-lock
     1749         where buf_parts.out-code  = p-doc-code
     1750           and buf_parts.obj-type  = p-obj-type
     1751           and buf_parts.obj-code  = p-obj-code
     1752           and buf_parts.artic     = p-artic
     1753           and buf_parts.prod-type = p-prod-type
     1754           and buf_parts.prod-code = p-prod-code
     1755       on error undo, return error return-value
     1756       :
     1757         define variable v-parts-fact-multiplier as decimal   no-undo .
     1758         assign
     1759           v-parts-fact-multiplier = 1
     1760         .
     1761         if buf_parts.qnty <> 0 then do:
     1762           assign
     1763             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     1764           .
     1765         end.
     1766         assign
     1767           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     1768           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     1769           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     1770           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     1771                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     1772           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     1773           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     1774           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     1775           p-total-parts-transport-base  = p-total-parts-transport-base
     1776                                         + buf_parts.fact-qnty
     1777                                           * (if   buf_parts.transport-base <> ?
     1778                                             then buf_parts.transport-base
     1779                                             else 0
     1780                                             )
     1781           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     1782                                         + buf_parts.fact-qnty
     1783                                           * (if   buf_parts.transport-rubl <> ?
     1784                                             then buf_parts.transport-rubl
     1785                                             else 0
     1786                                             )
     1787           p-total-parts-other-base      = p-total-parts-other-base
     1788                                         + buf_parts.fact-qnty
     1789                                           * (if   buf_parts.other-base <> ?
     1790                                             then buf_parts.other-base
     1791                                             else 0
     1792                                             )
     1793           p-total-parts-other-rubl      = p-total-parts-other-rubl
     1794                                         + buf_parts.fact-qnty
     1795                                           * (if   buf_parts.other-rubl <> ?
     1796                                             then buf_parts.other-rubl
     1797                                             else 0
     1798                                             )
     1799         .
     1800       end.
     1801     end.
     1802   end procedure.
     1803   procedure plgdsfnd :
     1804     define input  parameter p-chk-and-chs    as logical               no-undo .
     1805     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1806     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1807     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1808     define output parameter p-reserv-pl-code as   logical             no-undo .
     1809     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1810     define buffer buf_goods         for ub.goods .
     1811     define buffer buf_pl-gds        for ub.pl-gds .
     1812     define buffer buf_second_pl-gds for ub.pl-gds .
     1813     find first buf_goods no-lock where
     1814                buf_goods.gds-code = p-gds-code no-error .
     1815     if not available buf_goods
     1816     then do:
     1817       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1818     end.
     1819   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1821     (input  p-obj-type
     1822     ,input  p-obj-code
     1823     ,input  buf_goods.artic
     1824     ,input  buf_goods.prod-type
     1825     ,input  buf_goods.prod-code
     1826     ,input  'place-rsrv=request'
     1827     ,output p-reserv-pl-code
     1828     ) no-error .
     1829     if error-status :error
     1830     then do:
     1831       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1832     end.
     1833     if p-reserv-pl-code = no
     1834     then do:
     1835       return .
     1836     end.
     1837     if p-chk-and-chs <> yes
     1838     then do:
     1839       return .
     1840     end.
     1841     find first buf_pl-gds no-lock where
     1842                buf_pl-gds.obj-type = p-obj-type and
     1843                buf_pl-gds.obj-code = p-obj-code and
     1844                buf_pl-gds.gds-code = p-gds-code no-error .
     1845     if not available buf_pl-gds
     1846     then do:
     1847       return error "К товару не привязано ни одного места хранения" .
     1848     end.
     1849     find first buf_second_pl-gds no-lock where
     1850                buf_second_pl-gds.obj-type  = p-obj-type          and
     1851                buf_second_pl-gds.obj-code  = p-obj-code          and
     1852                buf_second_pl-gds.gds-code  = p-gds-code          and
     1853                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1854     if not available buf_second_pl-gds
     1855     then do:
     1856       assign
     1857         p-pl-code = buf_pl-gds.pl-code
     1858       .
     1859     end.
     1860     else do:
     1861       if not valid-handle( parparentproc )
     1862       then do:
     1863         return error "Не выбрано место хранения " + chr(10) .
     1864       end.
     1865       run str/plgdssel.p
     1866         (
     1867            input parparentproc
     1868         ,  input p-obj-type
     1869         ,  input p-obj-code
     1870         ,  input p-gds-code
     1871         , output p-pl-code
     1872         ) no-error .
     1873       if error-status :error
     1874       then do:
     1875         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1876                                , 'plgdssel.p':U
     1877                                , chr(10)
     1878                                , error-status :get-message( 1 )
     1879                                , return-value
     1880                                ) .
     1881       end.
     1882       if p-pl-code = ? or
     1883          p-pl-code = 0
     1884       then do:
     1885         return error "Не выбрано место хранения " + chr(10) .
     1886       end.
     1887     end.
     1888   end procedure.
     1889   function hvrdtax return logical (input parrecid as recid):
     1890   define variable varresult as logical no-undo.
     1891   run hvrdtax-proc (input parrecid, output varresult).
     1892   return varresult.
     1893   end function.
     1894   procedure hvrdtax-proc:
     1895   define input  parameter parrecid  as recid   no-undo.
     1896   define output parameter parresult as logical no-undo.
     1897   define buffer bf_goods for ub.goods.
     1898   define buffer bf_units for ub.units.
     1899   define buffer rt_tax   for ub.tax.
     1900   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1901   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1902   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1903   if available rt_tax and
     1904       can-find(first ub.tax-units No-LOCK WHERE
     1905                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1906                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1907                                                       else assign parresult = no.
     1908   end procedure.
     1909   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1910   procedure gen-key-rec :
     1911     define input  parameter p-tbl-name    as character no-undo.
     1912     define input  parameter p-bh_tbl-name as handle    no-undo.
     1913     define output parameter p-key-rec     as character no-undo.
     1914     do
     1915     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1916     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1917     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1918     :
     1919       define variable fh               as handle    no-undo .
     1920       define variable v-ok             as logical   no-undo .
     1921       define variable v-inform         as character no-undo .
     1922       define variable v-ind            as integer   no-undo .
     1923       define variable v-idx-field-qnty as integer   no-undo .
     1924       if p-tbl-name = ?
     1925         or p-tbl-name = "":U
     1926       then do:
     1927         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info20 ).
     1928       end.
     1929       if not p-bh_tbl-name:available then do:
     1930         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info20, p-tbl-name ).
     1931       end.
     1932       assign
     1933         p-key-rec = p-tbl-name
     1934         v-inform  = p-bh_tbl-name:index-information(1)
     1935         v-ind     = 2
     1936       .
     1937       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1938       on error undo, return error
     1939       :
     1940         assign
     1941           v-inform = p-bh_tbl-name:index-information( v-ind )
     1942           v-ind    = v-ind + 1
     1943         .
     1944       end.
     1945       if v-inform = ?
     1946         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1947         or entry( 3, v-inform, ",":U ) <> "1":U
     1948       then do:
     1949         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, p-tbl-name ).
     1950       end.
     1951       else do:
     1952         assign
     1953           v-idx-field-qnty = num-entries( v-inform ) - 4
     1954         .
     1955         if v-idx-field-qnty < 2 then do:
     1956           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, p-tbl-name ).
     1957         end.
     1958         do v-ind = 1 to v-idx-field-qnty by 2
     1959         on error undo, return error
     1960         :
     1961           assign
     1962             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1963             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1964           .
     1965         end.
     1966       end.
     1967       if p-key-rec = ? then do:
     1968         assign
     1969           p-key-rec = "":U
     1970         .
     1971         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info20, p-tbl-name ).
     1972       end.
     1973     end.
     1974     return.
     1975   end procedure.
     1976   procedure gen-where-keyr-tab :
     1977     define input  parameter i-tableSerach as character no-undo.
     1978     define input  parameter i-tablekey   as character  no-undo.
     1979     define input  parameter p-key-rec    as character  no-undo.
     1980     define input  parameter p-key-handle as handle     no-undo .
     1981     define input  parameter p-db-name    as character  no-undo .
     1982     define input  parameter p-tt-handle  as handle     no-undo .
     1983     define output parameter o-Where      as character  no-undo.
     1984     do
     1985     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1986     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1987     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1988     :
     1989       define variable v-full-tbl-name  as character no-undo .
     1990       define variable bh_tbl-name      as handle    no-undo .
     1991       define variable fh_key           as handle    no-undo .
     1992       define variable fh_search        as handle    no-undo .
     1993       define variable v-field-num      as integer   no-undo .
     1994       define variable v-count-fld      as integer   no-undo .
     1995       define variable v-inform         as character no-undo .
     1996       define variable v-ind            as integer   no-undo .
     1997       define variable v-idx-field-qnty as integer   no-undo .
     1998       define variable v-field-name     as character no-undo .
     1999       define variable v-field-val      as character no-undo .
     2000       define variable v-word-link      as character no-undo .
     2001       define variable vTable           as character no-undo.
     2002       define variable bh_tbl-key       as handle    no-undo .
     2003       assign
     2004         p-key-rec = trim( p-key-rec )
     2005       .
     2006       if p-key-handle <> ? then do:
     2007         if not valid-handle(p-key-handle)
     2008            or p-key-handle:type <> "buffer"
     2009         then do:
     2010           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info20 ).
     2011         end.
     2012         if num-entries( p-key-rec, chr(3) ) > 1
     2013           or p-key-rec = ?
     2014           or p-key-rec = "":U
     2015         then do:
     2016           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info20, p-key-rec ).
     2017         end.
     2018       end.
     2019       else do:
     2020         if p-key-rec = ?
     2021           or p-key-rec = "":U
     2022         then do:
     2023           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     2024         end.
     2025       end.
     2026       assign
     2027         vTable = entry( 1 , p-key-rec, chr(3) )
     2028       .
     2029       if p-tt-handle <> ?
     2030         and ( not valid-handle(p-tt-handle)
     2031               or p-tt-handle:type <> "buffer"
     2032             )
     2033       then do:
     2034         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info20, vTable, chr(10) ).
     2035       end.
     2036       if p-tt-handle = ? then do:
     2037         assign
     2038           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2039         .
     2040         create buffer bh_tbl-name for table v-full-tbl-name .
     2041       end.
     2042       else do:
     2043         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2044       end.
     2045       assign
     2046         v-inform = bh_tbl-name:index-information(1)
     2047         v-ind    = 2
     2048       .
     2049       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2050       on error undo, return error
     2051       :
     2052         assign
     2053           v-inform = bh_tbl-name:index-information( v-ind )
     2054           v-ind    = v-ind + 1
     2055         .
     2056       end.
     2057       if v-inform = ?
     2058         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2059         or entry( 3, v-inform, ",":U ) <> "1":U
     2060       then do:
     2061         delete object bh_tbl-name no-error.
     2062         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info20, vTable ).
     2063       end.
     2064       assign
     2065         v-idx-field-qnty = num-entries( v-inform ) - 4
     2066       .
     2067       if v-idx-field-qnty < 2 then do:
     2068         delete object bh_tbl-name no-error.
     2069         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, vTable ).
     2070       end.
     2071       assign
     2072         o-where     = "where":U
     2073         v-word-link = "":U
     2074         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2075         v-count-fld = 0
     2076       .
     2077       if i-tablekey ne "" and i-tablekey ne ?
     2078       then do:
     2079         assign
     2080           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2081         .
     2082         create buffer bh_tbl-key for table v-full-tbl-name .
     2083       end.
     2084       if i-tableSerach ne "" and i-tableSerach ne ?
     2085       then do:
     2086         delete object bh_tbl-name no-error.
     2087         assign
     2088           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2089         .
     2090         create buffer bh_tbl-name for table v-full-tbl-name .
     2091       end.
     2092       block_where:
     2093       do v-ind = 1 to v-idx-field-qnty by 2
     2094       on error undo, return error
     2095       :
     2096         assign
     2097           v-count-fld = v-count-fld + 1
     2098         .
     2099         if p-key-handle = ?
     2100           and v-count-fld > v-field-num
     2101         then do:
     2102           leave block_where.
     2103         end.
     2104         define variable VfieldKeyTable as handle no-undo.
     2105         assign
     2106           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2107           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2108         .
     2109         if     bh_tbl-key ne ?
     2110         then do:
     2111            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2112            if VfieldKeyTable eq ?
     2113            then next block_where.
     2114         end.
     2115         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2116         then
     2117            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2118         else
     2119            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2120         if p-key-handle = ? then do:
     2121           assign
     2122             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2123           .
     2124         end.
     2125         else do:
     2126           assign
     2127             fh_key = p-key-handle:buffer-field( v-field-name )
     2128           .
     2129           if fh_key = ?
     2130             or not valid-handle( fh_key )
     2131           then do:
     2132             delete object bh_tbl-name.
     2133             if     bh_tbl-key ne ?
     2134             then
     2135                delete object bh_tbl-key.
     2136             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info20, p-key-handle:name, v-field-name ).
     2137           end.
     2138           assign
     2139             v-field-val = fh_key:buffer-value
     2140           .
     2141         end.
     2142         if fh_search:data-type ="character":U then do:
     2143           assign
     2144             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2145             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2146             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2147             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2148             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2149             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2150             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2151             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2152             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2153             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2154             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2155             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2156             v-field-val = substitute( '"&1"', v-field-val )
     2157           .
     2158         end.
     2159         assign
     2160           o-where = substitute( "&1 &2", o-where, v-field-val )
     2161         .
     2162         if v-word-link = "":U then do:
     2163           assign
     2164             v-word-link = "and":U
     2165           .
     2166         end.
     2167       end.
     2168       delete object bh_tbl-name.
     2169       if     bh_tbl-key ne ?
     2170       then
     2171          delete object bh_tbl-key.
     2172       if p-key-handle = ?
     2173         and v-count-fld <> v-field-num
     2174       then do:
     2175         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info20, vTable ).
     2176       end.
     2177     end.
     2178   end procedure.
     2179   procedure gen-hn-keyr-tab :
     2180     define input  parameter i-tableSerach as character no-undo.
     2181     define input  parameter i-tablekey   as character no-undo.
     2182     define input  parameter p-key-rec    as character no-undo.
     2183     define input  parameter p-key-handle as handle    no-undo .
     2184     define input  parameter p-db-name    as character no-undo .
     2185     define input  parameter p-tt-handle  as handle    no-undo .
     2186     define input  parameter p-stts-lock  as integer   no-undo .
     2187     define output parameter o-hn         as handle    no-undo.
     2188     define variable v-full-tbl-name as character no-undo.
     2189     define variable v-where         as character no-undo.
     2190     define variable bh_tbl-name     as handle    no-undo.
     2191     define variable vTable          as character no-undo.
     2192     do
     2193     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2194     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2195     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2196         run gen-where-keyr-tab(i-tableSerach,
     2197                                i-tablekey,
     2198                                p-key-rec,
     2199                                p-key-handle,
     2200                                p-db-name,
     2201                                p-tt-handle,
     2202                                output v-where).
     2203         if i-tableSerach ne "" and i-tableSerach ne ?
     2204         then do:
     2205            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2206            create buffer bh_tbl-name for table v-full-tbl-name .
     2207         end.
     2208         else do:
     2209            if p-tt-handle = ? then do:
     2210               assign
     2211                  vTable = entry( 1 , p-key-rec, chr(3) )
     2212               .
     2213               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2214               create buffer bh_tbl-name for table v-full-tbl-name .
     2215            end.
     2216            else do:
     2217               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2218            end.
     2219         end.
     2220         if p-tt-handle = ? then do:
     2221            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2222         end.
     2223         else do:
     2224            bh_tbl-name:find-first( v-where ) no-error .
     2225         end.
     2226         o-hn = bh_tbl-name.
     2227      end.
     2228   end procedure.
     2229   procedure gen-hn-keyr :
     2230     define input  parameter p-key-rec    as character no-undo.
     2231     define input  parameter p-key-handle as handle    no-undo .
     2232     define input  parameter p-db-name    as character no-undo .
     2233     define input  parameter p-tt-handle  as handle    no-undo .
     2234     define input  parameter p-stts-lock  as integer   no-undo .
     2235     define output parameter o-hn         as handle    no-undo.
     2236     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2237   end.
     2238   procedure gen-row-keyr :
     2239     define input  parameter p-key-rec    as character no-undo.
     2240     define input  parameter p-key-handle as handle    no-undo .
     2241     define input  parameter p-db-name    as character no-undo .
     2242     define input  parameter p-tt-handle  as handle    no-undo .
     2243     define input  parameter p-stts-lock  as integer   no-undo .
     2244     define output parameter p-tbl-row    as rowid     no-undo.
     2245     define output parameter p-tbl-name   as character no-undo.
     2246     define variable vHn as handle no-undo.
     2247       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2248       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2249       p-tbl-name =  vHn:table.
     2250       delete object vHn no-error.
     2251     if p-tbl-row = ? then do:
     2252       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info20, p-tbl-name, p-key-rec ).
     2253     end.
     2254     else do:
     2255       return.
     2256     end.
     2257   end procedure.
     2258   procedure gen-key-fv :
     2259     define input  parameter p-key-rec    as character no-undo .
     2260     define output parameter p-field-list as character no-undo .
     2261     define output parameter p-value-list as character no-undo.
     2262     do
     2263     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2264     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2265     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2266     :
     2267       define variable v-full-tbl-name  as character no-undo .
     2268       define variable bh_tbl-name      as handle    no-undo .
     2269       define variable v-tbl-name       as character no-undo .
     2270       define variable v-field-num      as integer   no-undo .
     2271       define variable v-count-fld      as integer   no-undo .
     2272       define variable v-inform         as character no-undo .
     2273       define variable v-ind            as integer   no-undo .
     2274       define variable v-idx-field-qnty as integer   no-undo .
     2275       define variable v-delim-key      as character no-undo .
     2276       if p-key-rec = ?
     2277         or p-key-rec = "":U
     2278       then do:
     2279         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     2280       end.
     2281       assign
     2282         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2283         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2284       .
     2285       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2286       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info20 ).
     2287       assign
     2288         v-inform = bh_tbl-name:index-information(1)
     2289         v-ind    = 2
     2290       .
     2291       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2292       on error undo, return error
     2293       :
     2294         assign
     2295           v-inform = bh_tbl-name:index-information( v-ind )
     2296           v-ind    = v-ind + 1
     2297         .
     2298       end.
     2299       if v-inform = ?
     2300         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2301         or entry( 3, v-inform, ",":U ) <> "1":U
     2302       then do:
     2303         delete object bh_tbl-name no-error.
     2304         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     2305       end.
     2306       assign
     2307         v-idx-field-qnty = num-entries( v-inform ) - 4
     2308       .
     2309       if v-idx-field-qnty < 2 then do:
     2310         delete object bh_tbl-name no-error.
     2311         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     2312       end.
     2313       assign
     2314         p-field-list = "":U
     2315         p-value-list = "":U
     2316         v-delim-key  = "":U
     2317         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2318         v-count-fld  = 0
     2319       .
     2320       block_where:
     2321       do v-ind = 1 to v-idx-field-qnty by 2
     2322       on error undo, return error
     2323       :
     2324         assign
     2325           v-count-fld = v-count-fld + 1
     2326         .
     2327         if v-count-fld > v-field-num then do:
     2328           leave block_where.
     2329         end.
     2330         assign
     2331           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2332           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2333         .
     2334         if v-ind = 1 then do:
     2335           assign
     2336             v-delim-key = chr(3)
     2337           .
     2338         end.
     2339       end.
     2340       delete object bh_tbl-name.
     2341       if v-count-fld <> v-field-num then do:
     2342         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info20, v-tbl-name ).
     2343       end.
     2344     end.
     2345   end procedure.
     2346   procedure gen-key-field :
     2347     define input  parameter p-table      as character no-undo .
     2348     define output parameter p-field-list as character no-undo .
     2349     do
     2350     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2351     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2352     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2353     :
     2354       define variable v-full-tbl-name  as character no-undo .
     2355       define variable bh_tbl-name      as handle    no-undo .
     2356       define variable v-tbl-name       as character no-undo .
     2357       define variable v-field-num      as integer   no-undo .
     2358       define variable v-count-fld      as integer   no-undo .
     2359       define variable v-inform         as character no-undo .
     2360       define variable v-ind            as integer   no-undo .
     2361       define variable v-idx-field-qnty as integer   no-undo .
     2362       define variable v-delim-key      as character no-undo .
     2363       if p-table = ?
     2364         or p-table = "":U
     2365       then do:
     2366         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info20 ).
     2367       end.
     2368       assign
     2369         v-tbl-name      = p-table
     2370         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2371       .
     2372       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2373       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info20 ).
     2374       assign
     2375         v-inform = bh_tbl-name:index-information(1)
     2376         v-ind    = 2
     2377       .
     2378       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2379       on error undo, return error
     2380       :
     2381         assign
     2382           v-inform = bh_tbl-name:index-information( v-ind )
     2383           v-ind    = v-ind + 1
     2384         .
     2385       end.
     2386       if v-inform = ?
     2387         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2388         or entry( 3, v-inform, ",":U ) <> "1":U
     2389       then do:
     2390         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     2391       end.
     2392       assign
     2393         v-idx-field-qnty = num-entries( v-inform ) - 4
     2394       .
     2395       if v-idx-field-qnty < 2 then do:
     2396         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     2397       end.
     2398       assign
     2399         p-field-list = "":U
     2400         v-delim-key  = "":U
     2401         v-count-fld  = 0
     2402       .
     2403       block_where:
     2404       do v-ind = 1 to v-idx-field-qnty by 2
     2405       on error undo, return error
     2406       :
     2407         assign
     2408           v-count-fld = v-count-fld + 1
     2409         .
     2410         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2411         if v-ind = 1 then do:
     2412           assign
     2413             v-delim-key = chr(3)
     2414           .
     2415         end.
     2416       end.
     2417       delete object bh_tbl-name.
     2418     end.
     2419   end procedure.
     2420   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2421   define variable vss-include-info22 as character format "X(65)" no-undo
     2422   initial "@(#)$Workfile$ $Revision$".
     2423   procedure xmlchar-test :
     2424   define input parameter p-in-string          as character        no-undo.
     2425   define output parameter p-out-string-enc    as character        no-undo.
     2426   define output parameter p-out-string-dec    as character        no-undo.
     2427   do
     2428   on error undo, return error
     2429   :
     2430          run xmlchar-encode in this-procedure
     2431       (
     2432             input p-in-string
     2433           , output p-out-string-enc
     2434       ).
     2435          run xmlchar-decode in this-procedure
     2436       (
     2437             input p-out-string-enc
     2438           , output p-out-string-dec
     2439       ).
     2440   end.
     2441   end .
     2442   procedure xmlchar-encode :
     2443   define input parameter p-in-string      as character        no-undo.
     2444   define output parameter p-out-string    as character        no-undo.
     2445       define variable v-position      as integer      no-undo.
     2446       define variable v-current-char  as character    no-undo.
     2447   do
     2448   on error undo, return error
     2449   :
     2450       assign
     2451           p-out-string = "":U
     2452       .
     2453       case p-in-string
     2454       :
     2455           when ?
     2456           then do:
     2457               assign
     2458                   p-out-string = "?":U
     2459               .
     2460           end.
     2461           when "?":U
     2462           then do:
     2463               assign
     2464                   p-out-string = "&#63;":U
     2465               .
     2466           end.
     2467           otherwise do:
     2468               do v-position = 1 to length( p-in-string )
     2469               :
     2470                   assign
     2471                       v-current-char = substring( p-in-string, v-position, 1 )
     2472                   .
     2473                   case v-current-char
     2474                   :
     2475                       when "&":U
     2476                       then do:
     2477                           assign
     2478                               p-out-string = p-out-string + "&amp;":U
     2479                           .
     2480                       end.
     2481                       when ">":U
     2482                       then do:
     2483                           assign
     2484                               p-out-string = p-out-string + "&gt;":U
     2485                           .
     2486                       end.
     2487                       when "<":U
     2488                       then do:
     2489                           assign
     2490                               p-out-string = p-out-string + "&lt;":U
     2491                           .
     2492                       end.
     2493                       when "'":U
     2494                       then do:
     2495                           assign
     2496                               p-out-string = p-out-string + "&apos;":U
     2497                           .
     2498                       end.
     2499                       when '"':U
     2500                       then do:
     2501                           assign
     2502                               p-out-string = p-out-string + "&quot;":U
     2503                           .
     2504                       end.
     2505                       when chr(1)
     2506                       then do:
     2507                           assign
     2508                               p-out-string = p-out-string + "":U
     2509                           .
     2510                       end.
     2511                       when chr(2)
     2512                       then do:
     2513                           assign
     2514                               p-out-string = p-out-string + "":U
     2515                           .
     2516                       end.
     2517                       when chr(3)
     2518                       then do:
     2519                           assign
     2520                               p-out-string = p-out-string + "":U
     2521                           .
     2522                       end.
     2523                       when chr(4)
     2524                       then do:
     2525                           assign
     2526                               p-out-string = p-out-string + "":U
     2527                           .
     2528                       end.
     2529                       when chr(5)
     2530                       then do:
     2531                           assign
     2532                               p-out-string = p-out-string + "":U
     2533                           .
     2534                       end.
     2535                       when chr(6)
     2536                       then do:
     2537                           assign
     2538                               p-out-string = p-out-string + "":U
     2539                           .
     2540                       end.
     2541                       when chr(7)
     2542                       then do:
     2543                           assign
     2544                               p-out-string = p-out-string + "":U
     2545                           .
     2546                       end.
     2547                       when chr(8)
     2548                       then do:
     2549                           assign
     2550                               p-out-string = p-out-string + "":U
     2551                           .
     2552                       end.
     2553                       when chr(9)
     2554                       then do:
     2555                           assign
     2556                               p-out-string = p-out-string + "":U
     2557                           .
     2558                       end.
     2559                       when chr(29)
     2560                       then do:
     2561                           assign
     2562                               p-out-string = p-out-string + "":U
     2563                           .
     2564                       end.
     2565                       when chr(10)
     2566                       then do:
     2567                           assign
     2568                               p-out-string = p-out-string + "&#10;":U
     2569                           .
     2570                       end.
     2571                       when chr(13)
     2572                       then do:
     2573                           assign
     2574                               p-out-string = p-out-string + "&#13;":U
     2575                           .
     2576                       end.
     2577                       otherwise do:
     2578                           assign
     2579                               p-out-string = p-out-string + v-current-char
     2580                           .
     2581                       end.
     2582                   end case.
     2583               end.
     2584           end.
     2585       end case.
     2586   end.
     2587   end .
     2588   procedure xmlchar-encode-1c :
     2589   define input parameter p-in-string      as character        no-undo.
     2590   define output parameter p-out-string    as character        no-undo.
     2591       define variable v-position      as integer      no-undo.
     2592       define variable v-current-char  as character    no-undo.
     2593   do
     2594   on error undo, return error
     2595   :
     2596       assign
     2597           p-out-string = "":U
     2598       .
     2599       case p-in-string
     2600       :
     2601           when ?
     2602           then do:
     2603               assign
     2604                   p-out-string = "?":U
     2605               .
     2606           end.
     2607           otherwise do:
     2608               do v-position = 1 to length( p-in-string )
     2609               :
     2610                   assign
     2611                       v-current-char = substring( p-in-string, v-position, 1 )
     2612                   .
     2613                   case v-current-char
     2614                   :
     2615                       when chr(1)
     2616                       then do:
     2617                           assign
     2618                               p-out-string = p-out-string + " ":U
     2619                           .
     2620                       end.
     2621                       when chr(2)
     2622                       then do:
     2623                           assign
     2624                               p-out-string = p-out-string + " ":U
     2625                           .
     2626                       end.
     2627                       when chr(3)
     2628                       then do:
     2629                           assign
     2630                               p-out-string = p-out-string + " ":U
     2631                           .
     2632                       end.
     2633                       when chr(4)
     2634                       then do:
     2635                           assign
     2636                               p-out-string = p-out-string + " ":U
     2637                           .
     2638                       end.
     2639                       when chr(5)
     2640                       then do:
     2641                           assign
     2642                               p-out-string = p-out-string + " ":U
     2643                           .
     2644                       end.
     2645                       when chr(6)
     2646                       then do:
     2647                           assign
     2648                               p-out-string = p-out-string + " ":U
     2649                           .
     2650                       end.
     2651                       when chr(7)
     2652                       then do:
     2653                           assign
     2654                               p-out-string = p-out-string + " ":U
     2655                           .
     2656                       end.
     2657                       when chr(8)
     2658                       then do:
     2659                           assign
     2660                               p-out-string = p-out-string + " ":U
     2661                           .
     2662                       end.
     2663                       when chr(9)
     2664                       then do:
     2665                           assign
     2666                               p-out-string = p-out-string + " ":U
     2667                           .
     2668                       end.
     2669                       when chr(29)
     2670                       then do:
     2671                           assign
     2672                               p-out-string = p-out-string + " ":U
     2673                           .
     2674                       end.
     2675                       when chr(10)
     2676                       then do:
     2677                           assign
     2678                               p-out-string = p-out-string + " ":U
     2679                           .
     2680                       end.
     2681                       when chr(13)
     2682                       then do:
     2683                           assign
     2684                               p-out-string = p-out-string + " ":U
     2685                           .
     2686                       end.
     2687                       otherwise do:
     2688                           assign
     2689                               p-out-string = p-out-string + v-current-char
     2690                           .
     2691                       end.
     2692                   end case.
     2693               end.
     2694           end.
     2695       end case.
     2696   end.
     2697   end .
     2698   procedure xmlchar-decode :
     2699   define input parameter p-in-string      as character        no-undo.
     2700   define output parameter p-out-string    as character        no-undo.
     2701       define variable v-position      as integer      no-undo.
     2702       define variable v-last-position as integer      no-undo.
     2703       define variable v-temp-integer  as integer      no-undo.
     2704       define variable v-current-char  as character    no-undo.
     2705       define variable v-next-char     as character    no-undo.
     2706       define variable v-success       as logical      no-undo.
     2707   do
     2708   on error undo, return error
     2709   :
     2710       assign
     2711           p-out-string = "":U
     2712           v-position   = 0
     2713       .
     2714       replace-cycle:
     2715       do while yes
     2716       on error undo, return error
     2717       :
     2718           assign
     2719               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2720           .
     2721           if v-last-position <= v-position
     2722           then do:
     2723               if v-position = 0
     2724               then do:
     2725                   assign
     2726                       p-out-string = p-in-string
     2727                   .
     2728               end.
     2729               else do:
     2730                   assign
     2731                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2732                   .
     2733               end.
     2734               leave replace-cycle.
     2735           end.
     2736           else do:
     2737               assign
     2738                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2739                   v-position      = v-last-position
     2740                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2741               .
     2742               if v-current-char = "#":U
     2743               then do:
     2744                   assign
     2745                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2746                   .
     2747                   if v-last-position > 0
     2748                   then do:
     2749                       run xmlchar-read-integer in this-procedure
     2750                        (
     2751                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2752                           , output v-temp-integer
     2753                           , output v-success
     2754                       ).
     2755                       if v-success = yes
     2756                       and v-temp-integer >= 1
     2757                       and v-temp-integer <= 255
     2758                       then do:
     2759                           assign
     2760                               p-out-string = p-out-string + chr( v-temp-integer )
     2761                               v-position   = v-last-position + 1
     2762                           .
     2763                       end.
     2764                       else do:
     2765                           assign
     2766                               p-out-string = p-out-string + "&":U
     2767                               v-position   = v-position   + 1
     2768                           .
     2769                       end.
     2770                   end.
     2771                   else do:
     2772                       assign
     2773                           p-out-string = p-out-string + "&":U
     2774                           v-position   = v-position   + 1
     2775                       .
     2776                   end.
     2777               end.
     2778               else do:
     2779                   case substring( p-in-string, v-position + 1, 3 )
     2780                   :
     2781                       when "lt;":U
     2782                       then do:
     2783                           assign
     2784                               p-out-string = p-out-string + "<":U
     2785                               v-position   = v-position   + 3
     2786                           .
     2787                       end.
     2788                       when "gt;":U
     2789                       then do:
     2790                           assign
     2791                               p-out-string = p-out-string + ">":U
     2792                               v-position   = v-position   + 3
     2793                           .
     2794                       end.
     2795                       otherwise do:
     2796                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2797                           then do:
     2798                               assign
     2799                                   p-out-string = p-out-string + "&":U
     2800                                   v-position   = v-position   + 4
     2801                               .
     2802                           end.
     2803                           else do:
     2804                               case substring( p-in-string, v-position + 1, 5 )
     2805                               :
     2806                                   when "quot;":U
     2807                                   then do:
     2808                                       assign
     2809                                           p-out-string = p-out-string + '"':U
     2810                                           v-position   = v-position   + 5
     2811                                       .
     2812                                   end.
     2813                                   when "apos;":U
     2814                                   then do:
     2815                                       assign
     2816                                           p-out-string = p-out-string + "'":U
     2817                                           v-position   = v-position   + 5
     2818                                       .
     2819                                   end.
     2820                                   otherwise do:
     2821                                       assign
     2822                                           p-out-string = p-out-string + "&":U
     2823                                       .
     2824                                   end.
     2825                               end case.
     2826                           end.
     2827                       end.
     2828                   end case.
     2829               end.
     2830           end.
     2831       end.
     2832   end.
     2833   end .
     2834   procedure xmlchar-read-integer :
     2835   define input parameter p-input-string      as character        no-undo.
     2836   define output parameter p-output-integer   as integer          no-undo.
     2837   define output parameter p-success       as logical          no-undo.
     2838   do
     2839   on error undo, return error
     2840   :
     2841       assign
     2842           p-output-integer = integer( p-input-string )
     2843       no-error.
     2844       if error-status :error
     2845       then do:
     2846           assign
     2847               p-success           = no
     2848               p-output-integer    = 0
     2849           .
     2850       end.
     2851       else do:
     2852           assign
     2853               p-success           = yes
     2854           .
     2855       end.
     2856   end.
     2857   end.
     2858   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2859   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2860   define new global shared variable g#attr-lib  as handle no-undo .
     2861   define variable v-attr-lib-variable as handle no-undo .
     2862   define variable mMRCCode  as logical    no-undo.
     2863   define variable mTypeMark as character  no-undo.
     2864   function IS-NeedMark returns logical
     2865   ( input ib-code as integer  ,
     2866     input ib-str as character ):
     2867      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2868      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2869                                    and buf_prod-bc-attr.b-str  eq ib-str
     2870                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2871        no-lock no-error.
     2872      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2873   end.
     2874   function repTegforDm return char
     2875   (iDM as char ):
     2876       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2877       define variable vteg as character no-undo.
     2878       define variable oDM as character no-undo.
     2879       define variable vi as integer no-undo.
     2880       oDM = iDm.
     2881       do vi = 1 to num-entries(vTeglist):
     2882          vTeg = entry(vi,vTeglist).
     2883          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2884       end.
     2885       return oDM.
     2886   end.
     2887   function repSpecSimbforDm return char
     2888   (iDM as char ):
     2889       define variable oDM as character no-undo.
     2890     run
     2891       xmlchar-decode(iDM, output oDM).
     2892     return repTegforDm (oDM).
     2893   end.
     2894   function CheckGtin return logical
     2895   (iGtin as char):
     2896      define variable bar_code as character no-undo.
     2897      define variable vGtin as logical no-undo init "yes".
     2898      if length(iGtin) eq 14
     2899      then do:
     2900         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2901         run str/chk-sum.p
     2902          (input-output bar_code ) no-error .
     2903         if iGtin ne  bar_code
     2904         then
     2905            vGtin = no.
     2906      end.
     2907      else
     2908         vGtin = no.
     2909      return vgtin.
     2910   end.
     2911   function repSpecSimbforXlm return char
     2912   (iDM as char ):
     2913       iDM = replace(iDM,chr(29),"").
     2914       return iDM.
     2915   end.
     2916   function getGtinByDM return char
     2917   (IDM as char):
     2918      define variable VTXT as char no-undo.
     2919      define variable vGtin as char no-undo.
     2920      vTXt = IdM.
     2921      vGtin = IDM.
     2922      if    length(vtxt) > 14
     2923      then do:
     2924         if   vtxt begins "(01)"
     2925                or vtxt begins "(02)"
     2926         then
     2927            vGtin = substring(vtxt,5,14).
     2928         else if   (vtxt begins "01"
     2929                or vtxt begins "02" )
     2930                and (   (    substring(iDm,17,2) eq "21"
     2931                         and length(vtxt) >= 21)
     2932                     or substring(iDm,17,2) eq "37"
     2933                     or substring(iDm,17,4) eq "(37)" )
     2934         then do:
     2935            vGtin = substring(vtxt,3,14).
     2936            if not checkGtin(vGtin)
     2937            then
     2938               vGtin = substring(vtxt,1,14).
     2939         end.
     2940         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2941             or length(vtxt) eq 14 + 7 + 4
     2942             or length(vtxt) eq 14 + 7
     2943         then
     2944            vGtin = substring(vtxt,1,14).
     2945      end.
     2946      if not checkGtin(vGtin)
     2947      then
     2948         vGtin = "".
     2949      return vgtin.
     2950   end.
     2951   function getGdsCodeByGtin return int
     2952   (iGtin as char):
     2953      define buffer prod-bc  for ub.prod-bc.
     2954      define buffer bar-code for ub.bar-code.
     2955      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2956      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2957      return if avail bar-code then bar-code.gds-code else ?.
     2958   end.
     2959   function getQntyCodeByGtin return decimal
     2960   (iGtin as char):
     2961      define buffer prod-bc  for ub.prod-bc.
     2962      define buffer bar-code for ub.bar-code.
     2963      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2964      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2965      return if avail bar-code then bar-code.cli-base-rate else ?.
     2966   end.
     2967   function getGdsCodeByDM return int
     2968   (iDm as char):
     2969      define variable vGtin as char no-undo.
     2970      define buffer prod-bc for ub.prod-bc.
     2971      vGtin  = getGtinByDM (IDM ).
     2972      return getGdsCodeByGtin (vGtin).
     2973   end.
     2974   function ChekTypeMarkByGds return logical
     2975   (iGds-code as integer ):
     2976      define buffer goods-attr for ub.goods-attr.
     2977      find first goods-attr where goods-attr.gds-code   = iGds-code
     2978                              and goods-attr.attr-code  = 'mark-type':U
     2979      no-lock no-error.
     2980      if available goods-attr
     2981      then do:
     2982         mTypeMark = goods-attr.attr-value.
     2983         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2984           .
     2985      end.
     2986      else
     2987         return no.
     2988   end.
     2989   function ChekTypeMarkByDm return logical
     2990   (iDM as char ):
     2991      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2992   end.
     2993   function ChekTypeMarkByGtin return logical
     2994   (iGtin as char ):
     2995      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2996   end.
     2997   function GetNextElement return character
     2998     (input iAllTeg        as logical
     2999     ,output oteg          as character
     3000     ,output otegval       as character
     3001     ,input-output pstr    as character
     3002      ):
     3003        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3004        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3005        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3006        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3007        define variable vTeg as character no-undo.
     3008        define variable vLength as integer no-undo.
     3009        define variable vi as integer no-undo.
     3010        define variable vj as integer no-undo.
     3011        define buffer code for ub.code.
     3012        find first code where Code.parent eq "MarkType"
     3013                          and Code.CodeValue   eq mTypeMark
     3014                          no-lock no-error.
     3015        if     available code
     3016           and Code.misc1 ne ""
     3017           and Code.misc1 ne ?
     3018        then do:
     3019           integer (Code.misc1) no-error.
     3020           if not error-status:error
     3021           then
     3022             entry (4,vlistleng) = Code.misc1.
     3023        end.
     3024        if iAllTeg
     3025        then
     3026           assign
     3027              vlistElem     = vlistElem    + vlistElemDop
     3028              vlistleng     = vlistleng    + vlistlengDop
     3029           .
     3030        else if mMRCCode
     3031        then
     3032           assign
     3033              vlistElem     = vlistElem    + ",(8005),8005"
     3034              vlistleng     = vlistleng    + ",000006,0006"
     3035           .
     3036       block-elem:
     3037       do vi = 1 to num-entries(vlistElem):
     3038          vTeg = entry(vi,vlistElem).
     3039          if pstr begins vTeg
     3040          then do:
     3041             if    vTeg eq "21"
     3042             then
     3043                vLength = index(pstr,chr(29)) - 2 no-error.
     3044             if vLength  <= 0
     3045             then
     3046                vLength = int(entry(vi,vlistleng)).
     3047             otegval = substring (pstr,length(vteg) + 1, vLength).
     3048             oteg = replace(replace(vteg,")",""),"(","").
     3049             vTeg = vteg + otegval.
     3050             otegval = replace(otegval,chr(29),"").
     3051             oteg = replace(replace(oteg,")",""),"(","").
     3052             pstr = substring (pstr,length(vTeg)+ 1).
     3053             vTeg = replace(vTeg,chr(29),"").
     3054             leave block-elem.
     3055          end.
     3056          else
     3057             vTeg = "".
     3058       end.
     3059       return vteg.
     3060   end.
     3061   function GetCodeIdent return character
     3062   (iDm as char):
     3063      define variable Velement   as character no-undo init "first".
     3064      define variable oCodeIdent as character no-undo.
     3065      define variable vteg as character no-undo.
     3066      define variable vtegval as character no-undo.
     3067      define variable vGtin as character no-undo.
     3068      define buffer marking for ub.marking.
     3069      for first marking no-lock where
     3070                marking.mark eq iDm
     3071            and marking.unit-ext = "LEVEL2"
     3072      :
     3073        return iDm.
     3074      end.
     3075      vGtin  = getGtinByDM (iDm ).
     3076      ChekTypeMarkByDm(idm).
     3077      if iDm begins 'tech_':U
     3078      then
     3079         oCodeIdent = iDm.
     3080      else if length(iDm) < 21
     3081      then do:
     3082         find first marking where marking.mark eq idm
     3083         no-lock no-error.
     3084         oCodeIdent = if available marking then marking.mark else  ?.
     3085      end.
     3086      else if     length(iDm) eq 29
     3087         and not iDm begins "01"
     3088         and not iDm begins "02"
     3089      then
     3090         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3091      else  if     length(iDm) >= 24
     3092               and (  iDm begins "01"
     3093                   or iDm begins "02")
     3094               and  substring(iDm,17,2) ne "21"
     3095      then do:
     3096         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3097                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3098         then
     3099            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3100         else
     3101            oCodeIdent = iDM.
     3102      end.
     3103      else  if     (   length(iDm) eq 25
     3104                    or length(iDm) eq 21)
     3105               and (not iDm begins "01"
     3106               and  not iDm begins "02")
     3107      then
     3108         oCodeIdent = substring(iDm,1,21).
     3109      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3110      then
     3111         oCodeIdent = substring(iDm,1,21).
     3112      else do while Velement ne "" and idm ne "":
     3113         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3114         oCodeIdent = oCodeIdent + Velement.
     3115      end.
     3116      return oCodeIdent.
     3117   end.
     3118   function GetTegCod return character
     3119   (icodeIdent as char, iTeg as char):
     3120      define variable Velement   as character no-undo init "first".
     3121      define variable oTeg as character no-undo init ?.
     3122      define variable vteg as character no-undo.
     3123      define variable vtegval as character no-undo.
     3124      if     ((length(icodeIdent) eq 21
     3125         and not icodeIdent begins "01"
     3126         and not icodeIdent begins "02")
     3127         or
     3128             ( length(icodeIdent) eq 25
     3129               and not icodeIdent begins "01"
     3130               and not icodeIdent begins "02"))
     3131      then do:
     3132         if iTeg eq "01" or iTeg eq "02"
     3133         then
     3134            oTeg = substring(icodeIdent,1,21).
     3135         else  if  iTeg eq "21"
     3136         then
     3137            oTeg = substring(icodeIdent,15,7).
     3138      end.
     3139      else do:
     3140         ChekTypeMarkByDm(icodeIdent).
     3141         block-teg:
     3142            do while Velement ne "" and icodeIdent ne "":
     3143            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3144            if    Velement begins iTeg
     3145               or Velement begins "(" + iTeg + ")"
     3146            then do:
     3147               oTeg = vtegval.
     3148               leave block-teg.
     3149            end.
     3150         end.
     3151      end.
     3152      return oTeg.
     3153   end.
     3154   function isOAD return logical
     3155   (icodeIdent as character):
     3156      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3157   end.
     3158   function isMark return logical
     3159   (icodeIdent as character):
     3160      define buffer buf_marking for ub.marking.
     3161      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3162             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3163   end.
     3164   function addBracketForCode return character
     3165   (icodeIdent as char):
     3166      define variable Velement   as character no-undo init "first".
     3167      define variable oTeg as character no-undo.
     3168      define variable vteg as character no-undo.
     3169      define variable vtegval as character no-undo.
     3170      define buffer marking for ub.marking.
     3171      find first marking no-lock where
     3172                 marking.mark begins icodeIdent no-error.
     3173      if    not ChekTypeMarkByDm(icodeIdent)
     3174         or length(icodeIdent) le 24
     3175         or (avail marking and marking.unit-ext = "LEVEL2")
     3176      then
     3177         oTeg = icodeIdent.
     3178      else do:
     3179         if (  icodeIdent begins "01"
     3180            or icodeIdent begins "02"
     3181            ) and CheckGtin(substring (icodeIdent,3,14))
     3182            and substring (icodeIdent,17,2) eq "21"
     3183         then do:
     3184            mMRCCode = yes.
     3185            ChekTypeMarkByDm(icodeIdent).
     3186            block-teg:
     3187            do while Velement ne "" and icodeIdent ne "":
     3188               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3189               if vteg ne ""
     3190               then
     3191                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3192            end.
     3193            mMRCCode = no.
     3194         end.
     3195         else do:
     3196            oTeg = icodeIdent.
     3197         end.
     3198      end.
     3199      return oTeg.
     3200   end.
     3201   function getlevelByCodId return int
     3202   (iCode as char):
     3203      define variable vLength as int no-undo.
     3204      define variable vLevel  as int no-undo.
     3205      if not ChekTypeMarkByDM (icode) then return ?.
     3206      vLength = length(iCode).
     3207      if    vLength eq 18
     3208         or vLength eq 20
     3209      then
     3210         Vlevel = 4.
     3211      else if vLength eq 21
     3212      then
     3213         Vlevel = 1.
     3214      else if vLength eq 25
     3215      then do:
     3216         if  iCode begins "01"
     3217         then
     3218            Vlevel = 3.
     3219         else
     3220            Vlevel = 1.
     3221      end.
     3222      else if     vLength >= 26
     3223              and vLength <= 46
     3224      then do:
     3225         if    substring(iCode,17,2) eq "11"
     3226            or substring(iCode,17,2) eq "13"
     3227            or (    substring(iCode,17,2) eq "21"
     3228                and vLength >= 33
     3229                and substring(iCode,26,4) ne "8005")
     3230         then
     3231            Vlevel = 4.
     3232         else if    vLength eq 31
     3233                 or vLength eq 38
     3234                 or vLength eq 39
     3235                 or vLength eq 45
     3236         then
     3237            Vlevel = 1.
     3238         else if    vLength eq 35
     3239                 or vLength eq 43
     3240         then
     3241            Vlevel = 3.
     3242         else
     3243            Vlevel = ?.
     3244      end.
     3245      else
     3246         Vlevel = ?.
     3247      return Vlevel.
     3248   end.
     3249   function getLevelMotpBycodid return character
     3250   (iDm as char):
     3251      define variable vLevel as integer no-undo.
     3252      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3253      vLevel = getlevelByCodId(iDm).
     3254      if    vLevel eq ?
     3255         or vLevel < 1
     3256         or vLevel > 6
     3257      then
     3258         return ?.
     3259      else
     3260         return entry(vlevel,vList).
     3261   end.
     3262   function getLevelUTDByLevelMotp return character
     3263   (iUnit as char):
     3264      define variable vLevel as integer no-undo.
     3265      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3266      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3267      vLevel = lookup(iUnit,vListMOTP).
     3268      if    vLevel eq ?
     3269         or vLevel < 1
     3270         or vLevel > 4
     3271      then
     3272         return ?.
     3273      else
     3274         return entry(vlevel,vListutd).
     3275   end.
     3276   function getLevelMotpByDM return character
     3277   (iDm as char):
     3278      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3279   end.
     3280   function getLevelUTDByCodId return character
     3281   (iDm as char):
     3282      define variable vLevel as integer no-undo.
     3283      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3284      vLevel = getlevelByCodId(iDm).
     3285      if    vLevel eq ?
     3286         or vLevel < 1
     3287         or vLevel > 4
     3288      then
     3289         return ?.
     3290      else
     3291         return entry(vlevel,vList).
     3292   end.
     3293   function getLevelUTDByDM return character
     3294   (iDm as char):
     3295      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3296   end.
     3297   define variable mNotMarkQnty as logical no-undo.
     3298   function getQntyUTDByCodId return decimal
     3299   (iDM as char):
     3300      define variable vLevel as integer no-undo.
     3301      define variable vList as character no-undo init "1,5,10,500".
     3302      define variable vGtin as character no-undo.
     3303      define variable vqnty as decimal no-undo init ?.
     3304      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3305      if vqnty eq ?
     3306      then do:
     3307         if not mNotMarkQnty
     3308         then do:
     3309            define buffer marking for ub.marking.
     3310            define variable vCodident as character no-undo.
     3311            vCodident = GetCodeIdent(idm).
     3312            find first marking where marking.mark begins vCodident no-lock no-error.
     3313            if     available marking
     3314               and marking.box-qnty ne ?
     3315            then
     3316               return marking.box-qnty.
     3317         end.
     3318         vGtin = getGtinByDm(iDM).
     3319         if ChekTypeMarkByGtin (vGtin)
     3320         then do:
     3321            vLevel = getlevelByCodId(iDM).
     3322            if     vLevel >= 1
     3323               and vLevel <= 4
     3324            then
     3325               vqnty = int(entry(vlevel,vList)).
     3326         end.
     3327         else
     3328            vqnty = getQntyCodeByGtin(vgtin).
     3329      end.
     3330      return vqnty.
     3331   end.
     3332   function getQntyUTDByDM return decimal
     3333   (iDm as char):
     3334      define variable vDM as character no-undo.
     3335      if     length (iDm) ne 25
     3336         and length (iDm) ne 29
     3337         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3338      then
     3339         vDM = substring (iDm,1,length (iDm) - 6 ).
     3340      else
     3341         vDM = substring (iDm,1,length (iDm) - 4 ).
     3342      return getQntyUTDByCodId(vDM).
     3343   end.
     3344   function getMRC4 return decimal
     3345   (iMRC as char):
     3346      define variable oMrc     as decimal no-undo init ?.
     3347      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3348      define variable vi       as integer no-undo.
     3349      define variable vfound   as integer no-undo.
     3350      define variable vposStart   as integer no-undo.
     3351      do:
     3352      OMRc = 0.
     3353      do vi = 1 to 4:
     3354         define variable vsimb as character no-undo.
     3355         vsimb = substring(iMRC,vi,1).
     3356         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3357         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3358         if vfound > 0
     3359         then
     3360            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3361         end.
     3362         OMRc = OMRc / 100.
     3363      end.
     3364      return OMRc.
     3365   end.
     3366   function getMRCByDM return decimal
     3367   (iDm as char):
     3368      define variable vMRC     as character no-undo.
     3369      define variable oMrc     as decimal no-undo init ?.
     3370      define variable Velement as character no-undo init "empty".
     3371      define variable vteg as character no-undo.
     3372      define variable vtegval as character no-undo.
     3373      if    length(idm) eq 14 + 7 + 4 + 4
     3374         or length(idm) eq 14 + 7 + 4
     3375      then do:
     3376         vMRC = substring(idm,22,4).
     3377         omrc = getMRC4(vMRC).
     3378      end.
     3379      else do:
     3380          ChekTypeMarkByDm(iDm).
     3381          block-mrc:
     3382          do while Velement ne "" and idm ne "":
     3383             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3384             if Velement begins "8005"
     3385             then do:
     3386                vMRC = substring(Velement,5,6).
     3387                leave block-mrc.
     3388             end.
     3389             else if Velement begins "(8005)"
     3390             then do:
     3391                vMRC = substring(Velement,7,6).
     3392                leave block-mrc.
     3393             end.
     3394          end.
     3395          if vMRC ne ""
     3396          then
     3397             OMRc = dec(vmrc) / 100 no-error.
     3398      end.
     3399      return OMRc.
     3400   end.
     3401   function MoveDate return Date
     3402   (idate as date,
     3403    iMonth as int64):
     3404      define variable vMonth   as int64 no-undo.
     3405      define variable vYear    as int64 no-undo.
     3406      define variable vDateNew as date  no-undo.
     3407       define variable vDay     as int64 no-undo.
     3408       vMonth = month(iDate) + iMonth.
     3409       vYear =  year(iDate).
     3410       if vMonth <= 0
     3411       then assign
     3412          vMonth = vMonth + 12
     3413           vYear  = vYear - 1
     3414       .
     3415       else if vMonth > 12
     3416       then assign
     3417          vMonth = vMonth - 12
     3418           vYear  = vYear + 1
     3419       .
     3420       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3421       do while error-status:error eq yes:
     3422          VDay = vDay + 1.
     3423          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3424       end.
     3425       if VDay > 0
     3426       then
     3427          vDateNew + 1.
     3428       return vDateNew.
     3429   end.
     3430   procedure checkEMRC:
     3431   define input  parameter iDm as character no-undo.
     3432   define output parameter vok as logical   no-undo init yes.
     3433      define variable v-value-emrc as character no-undo.
     3434      define variable v-type-emrc  as character no-undo.
     3435      define variable vDateIso     as character no-undo.
     3436      define variable vMRC         as decimal no-undo.
     3437      define variable vqnty        as decimal no-undo.
     3438      define variable vPrice       as decimal no-undo.
     3439      define variable vparent      as character no-undo.
     3440      define variable vgds-code    as integer no-undo.
     3441      define buffer code for ub.code.
     3442      vMRC = getMRCByDM(iDm).
     3443      if vMRC > 0
     3444      then do:
     3445         vgds-code = getGdsCodeByDM(iDm).
     3446         vqnty     = getQntyUTDByDM(iDm).
     3447               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3448            (
     3449             input   vgds-code
     3450            ,input   'emrc-type':U
     3451            ,output   v-value-emrc
     3452            ,output   v-type-emrc
     3453          ) no-error.
     3454          if     v-value-emrc ne ""
     3455             and v-value-emrc ne ?
     3456          then do:
     3457             vDateIso = iso-date(today).
     3458             vPrice = vMRC / vqnty.
     3459             vparent ="emc" + chr(4) + v-value-emrc.
     3460             find last code where Code.parent      eq vparent
     3461                              and Code.code        le vDateIso
     3462                              and code.status_  eq 0
     3463             no-lock no-error.
     3464             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3465             then
     3466                vOk = true .
     3467             else do:
     3468                 define variable vText      as character no-undo.
     3469                 define variable vDate      as date no-undo.
     3470                 define variable vDateLast  as character no-undo.
     3471                 define variable vDateFirst as character no-undo.
     3472                 define variable vDate3     as date no-undo.
     3473                 vdate = date(code.misc1).
     3474                 vDateLast = code.misc1.
     3475                 vDate3 = MoveDate(today, - 3 ).
     3476                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3477                                      string(vDate3  , "99/99/9999"),
     3478                                      string(vDate   , "99/99/9999")
     3479                                      ).
     3480                 vdateIso = iso-date(vdate3).
     3481                 find last code  where Code.parent      eq vparent
     3482                                   and Code.code        le vDateIso
     3483                                   and code.status_  eq 0 no-lock no-error.
     3484                 if available code
     3485                 then
     3486                    vDateIso = code.code.
     3487                 vDateFirst = vDateIso.
     3488                 vDateLast = iso-date(vdate).
     3489                 define variable vGood as logical no-undo.
     3490                 define variable vDateSale as date no-undo.
     3491                 define buffer bcode for code.
     3492                 for last code where Code.parent   eq vparent
     3493                                 and code.status_  eq 0
     3494                                 and code.code     < vDateLast
     3495                                 and code.code     >= vDateFirst
     3496                 no-lock:
     3497                    find first bcode where bCode.parent   eq vparent
     3498                                       and bcode.status_  eq 0
     3499                                       and bcode.code     > code.code no-lock no-error.
     3500                    if available bcode
     3501                    then do:
     3502                       if vPrice < dec(Code.CodeValue)
     3503                       then
     3504                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3505                                                     chr(10),
     3506                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3507                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3508                                                     ).
     3509                       else do:
     3510                          vGood = yes.
     3511                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3512                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3513                                                     chr(10),
     3514                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3515                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3516                                                     string(         vDateSale            ,"99/99/9999"),
     3517                                                     string(vDateSale - today)
     3518                                                     ).
     3519                       end.
     3520                    end.
     3521                 end.
     3522                 if vgood
     3523                 then do:
     3524                    define variable choice as integer no-undo .
     3525                    run gbl/d-askw.w (input "Уточнение"
     3526                           ,input  vText
     3527                           ,input "|"
     3528                           ,input "Принять|Вернуть"
     3529                           ,input "Принять данный товар|Вернуть товар постащику"
     3530                           ,input 1
     3531                           ,input 2
     3532                           ,output choice) no-error.
     3533                    vok = choice eq 1.
     3534                 end.
     3535                 else
     3536                    vok =false.
     3537             end.
     3538          end.
     3539      end.
     3540   end.
     3541   function addGs2Mark return character
     3542   (iMark as char):
     3543      define variable vDM   as character no-undo.
     3544      define variable vIdx  as integer   no-undo.
     3545      if index(iMark,chr(29),1) > 0
     3546      then return iMark.
     3547      if substring(iMark,26,4) = "8005" then
     3548      do:
     3549        vIdx = index(iMark,"93",26 + 4 + 5).
     3550        if vIdx > 1 then do:
     3551          vDM = substitute("&1&4&2&4&3",
     3552                           substring(iMark,1,25),
     3553                           substring(iMark,26,vIdx - 25 - 1),
     3554                           substring(iMark,vIdx),
     3555                           chr(29)) no-error.
     3556          vIdx = index(vDm,"240",vIdx + 4).
     3557          if vIdx > 0 then
     3558          do:
     3559            vDM = substitute("&1&3&2",
     3560                             substring(vDm,1,vIdx - 1),
     3561                             substring(vDm,vIdx),
     3562                             chr(29)) no-error.
     3563          end.
     3564        end.
     3565        else
     3566          vDM = substitute("&1&3&2",
     3567                           substring(iMark,1,25),
     3568                           substring(iMark,26),
     3569                           chr(29)) no-error.
     3570      end.
     3571      else if substring(iMark,32,2) = "91" then
     3572      do:
     3573        vIdx = index(iMark,"92",32).
     3574        if vIdx > 1 then
     3575          vDM = substitute("&1&4&2&4&3",
     3576                           substring(iMark,1,31),
     3577                           substring(iMark,32,vIdx - 31 - 1),
     3578                           substring(iMark,vIdx),
     3579                           chr(29)) no-error.
     3580        else
     3581          vDM = substitute("&1&3&2",
     3582                           substring(iMark,1,31),
     3583                           substring(iMark,32),
     3584                           chr(29)) no-error.
     3585      end.
     3586      else if substring(iMark,39,2) = "91" then
     3587      do:
     3588        vIdx = index(iMark,"92",38).
     3589        if vIdx > 1 then
     3590          vDM = substitute("&1&4&2&4&3",
     3591                           substring(iMark,1,38),
     3592                           substring(iMark,39,vIdx - 38 - 1),
     3593                           substring(iMark,vIdx),
     3594                           chr(29)) no-error.
     3595        else
     3596          vDM = substitute("&1&3&2",
     3597                           substring(iMark,1,38),
     3598                           substring(iMark,39),
     3599                           chr(29)) no-error.
     3600      end.
     3601      else if substring(iMark,25,2) = "93" then
     3602      do:
     3603        vIdx = index(iMark,"92",25).
     3604        if vIdx > 1 then
     3605          vDM = substitute("&1&4&2&4&3",
     3606                           substring(iMark,1,24),
     3607                           substring(iMark,25,vIdx - 24 - 1),
     3608                           substring(iMark,vIdx),
     3609                           chr(29)) no-error.
     3610        else
     3611          vIdx = index(iMark,"3103",25).
     3612          if vIdx > 0 then
     3613          vDM = substitute("&1&4&2&4&3",
     3614                           substring(iMark,1,24),
     3615                           substring(iMark,25,vIdx - 24 - 1),
     3616                           substring(iMark,vIdx),
     3617                           chr(29)) no-error.
     3618          else
     3619            vDM = substitute("&1&3&2",
     3620                             substring(iMark,1,24),
     3621                             substring(iMark,25),
     3622                             chr(29)) no-error.
     3623      end.
     3624      else if substring(iMark,32,2) = "93" then
     3625      do:
     3626        vDM = substitute("&1&3&2",
     3627              substring(iMark,1,31),
     3628              substring(iMark,32),
     3629              chr(29)) no-error.
     3630      end.
     3631      return if vDM <> "" then vDm else iMark.
     3632   end.
     3633   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3634   procedure partcopy :
     3635     define input parameter  p-free-output-copy as logical   no-undo .
     3636     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     3637     define parameter buffer buf_orig_parts     for ub.parts .
     3638     define parameter buffer buf_parts          for ub.parts .
     3639     define input parameter  p-mark             as character no-undo .
     3640     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     3641     define variable v-value-character as character no-undo .
     3642     define variable v-value-date      as date no-undo .
     3643     define variable v-value-decimal   as decimal no-undo .
     3644     define variable v-value-integer   as integer no-undo .
     3645     define variable v-izlcstpr        as logical no-undo .
     3646     define variable v-tth             as handle no-undo .
     3647     define variable v-type            as character no-undo .
     3648     define variable part-key-rec      as character no-undo .
     3649     define variable orig-part-key-rec as character no-undo .
     3650     define variable del-part-key-rec  as character no-undo .
     3651     define variable objMarks as class excisemarks  no-undo .
     3652     define variable v-parent-mark-sts as integer   no-undo .
     3653     define variable v-mark-sts-list   as character no-undo .
     3654     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     3655     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     3656     define buffer buf_gen-attr for ub.gen-attr .
     3657     define buffer buf1_gen-attr for ub.gen-attr .
     3658     define buffer buf_doc-line  for ub.doc-line .
     3659     define buffer buf_marking for ub.marking .
     3660     define buffer buf_marking-childs for ub.marking .
     3661     define buffer orig_marking-lines for ub.marking-lines .
     3662     define buffer orig_marking-lines-childs for ub.marking-lines .
     3663     define buffer buf_marking-lines for ub.marking-lines .
     3664     define buffer buf_marking-lines-childs for ub.marking-lines .
     3665     define buffer buf_marking-pack for ub.marking .
     3666     define buffer buf_marking-chk for ub.marking-chk .
     3667     define buffer buf_goods for ub.goods .
     3668     define buffer buf_trn-doc for ub.trn-doc .
     3669     define buffer pri_trn-doc for ub.trn-doc .
     3670     define buffer buf_chk-doc for ub.chk-doc .
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       if p-free-output-copy = true
     3675       then do:
     3676         if  p-out-code <> 'free-zone':U
     3677         and p-out-code <> 'out-zone':U
     3678         then do:
     3679           message
     3680             vss-workfile vss-revision vss-description skip
     3681             vss-include-info23 skip
     3682             "Ошибка задания входных параметров процедуры partcopy" skip
     3683             "p-free-output-copy" p-free-output-copy skip
     3684             "p-out-code" p-out-code skip
     3685             view-as alert-box error .
     3686           undo, return error .
     3687         end.
     3688       end.
     3689       if buf_orig_parts.out-code <> p-out-code
     3690       then do:
     3691         find first buf_parts exclusive-lock
     3692           where buf_parts.obj-type  = buf_orig_parts.obj-type
     3693             and buf_parts.obj-code  = buf_orig_parts.obj-code
     3694             and buf_parts.artic     = buf_orig_parts.artic
     3695             and buf_parts.prod-type = buf_orig_parts.prod-type
     3696             and buf_parts.prod-code = buf_orig_parts.prod-code
     3697             and buf_parts.in-code   = buf_orig_parts.in-code
     3698             and buf_parts.out-code  = p-out-code
     3699             and buf_parts.part-code = buf_orig_parts.part-code
     3700           no-error.
     3701         if not available buf_parts
     3702         then do:
     3703           define variable v-rsrv-free as logical   no-undo .
     3704           if p-out-code = 'free-zone':U
     3705           or p-out-code = 'out-zone':U
     3706           then do:
     3707             assign
     3708               v-rsrv-free =
     3709          (if p-out-code = 'free-zone':U then yes else no)
     3710             .
     3711           end.
     3712           else do:
     3713             assign
     3714               v-rsrv-free = ?
     3715             .
     3716           end.
     3717           create buf_parts .
     3718           buffer-copy buf_orig_parts to buf_parts
     3719           assign
     3720             buf_parts.out-code  = p-out-code
     3721             buf_parts.status_   = no
     3722             buf_parts.rsrv-free = v-rsrv-free
     3723             buf_parts.qnty      = 0
     3724             buf_parts.fact-qnty = 0
     3725             buf_parts.real-qnty = 0
     3726             buf_parts.cli-qnty  = 0
     3727           .
     3728           validate buf_parts .
     3729         end.
     3730         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3731                                           ,input (buffer buf_orig_parts:handle)
     3732                                           ,output orig-part-key-rec).
     3733         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3734                                           ,input (buffer buf_parts:handle)
     3735                                           ,output part-key-rec).
     3736         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3737               and ub.gen-attr.p-key =  orig-part-key-rec:
     3738             if not valid-object (objMarks)
     3739               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     3740               if p-out-code = 'free-zone':U
     3741               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     3742                then
     3743               do:
     3744                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3745                   if objMarks:StatusErr
     3746                       then
     3747                   do:
     3748                       message objMarks:ReturnMsg view-as alert-box error.
     3749                       delete object objMarks no-error.
     3750                       undo, return error.
     3751                   end.
     3752               end.
     3753             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     3754             do:
     3755                 if p-mark <> "" then do:
     3756                 if p-out-code = 'free-zone':U then do:
     3757                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     3758                 end.
     3759                 else do:
     3760                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     3761                 end.
     3762                 if objMarks:StatusErr
     3763                   then
     3764                 do:
     3765                   message objMarks:ReturnMsg view-as alert-box error.
     3766                   delete object objMarks no-error.
     3767                   undo, return error.
     3768                 end.
     3769               end.
     3770             end.
     3771             if p-out-code = 'out-zone':U then
     3772             do:
     3773                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     3774                 if objMarks:StatusErr
     3775                     then
     3776                 do:
     3777                     message objMarks:ReturnMsg view-as alert-box error.
     3778                     delete object objMarks no-error.
     3779                     undo, return error.
     3780                 end.
     3781             end.
     3782         end.
     3783         delete object objMarks no-error.
     3784         if p-mark = "news" then return .
     3785         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3786         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     3787         if not available buf_trn-doc
     3788         then
     3789            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     3790         if (
     3791             p-out-code = 'free-zone':U
     3792             and buf_orig_parts.in-code = buf_orig_parts.out-code
     3793            )
     3794         or
     3795            (
     3796             p-out-code = 'free-zone':U
     3797             and available pri_trn-doc
     3798             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     3799            )
     3800         or
     3801            (
     3802             available buf_trn-doc
     3803             and p-out-code = buf_trn-doc.doc-code
     3804             and buf_trn-doc.ext-doc-type = 'vt':U
     3805            )
     3806         or
     3807            (
     3808             p-mark = ""
     3809             and available buf_trn-doc
     3810             and p-out-code = 'free-zone':U
     3811             and buf_trn-doc.ext-doc-type = 'vt':U
     3812            )
     3813         or
     3814            (
     3815             p-mark = ""
     3816             and available buf_trn-doc
     3817             and p-out-code = 'free-zone':U
     3818             and buf_trn-doc.ext-doc-type = 'rs':U
     3819            )
     3820         then do :
     3821           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     3822             and ub.goods.prod-type = buf_parts.prod-type
     3823             and ub.goods.prod-code = buf_parts.prod-code.
     3824           def buffer buf_orig_ml for ub.marking-lines.
     3825           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     3826             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     3827             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     3828             and buf_orig_ml.in-code = buf_orig_parts.in-code
     3829             and buf_orig_ml.out-code = buf_orig_parts.out-code
     3830             and buf_orig_ml.part-code = buf_orig_parts.part-code
     3831             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     3832             if available pri_trn-doc
     3833             and pri_trn-doc.ext-doc-type = 'iv':U
     3834             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3835             then do :
     3836               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     3837                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     3838               end .
     3839               next .
     3840             end .
     3841             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     3842                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     3843                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     3844                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     3845                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     3846                                                   and ub.marking-lines.out-code = p-out-code
     3847                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     3848                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     3849                                                   no-error .
     3850             if not available ub.marking-lines
     3851             then do :
     3852               create ub.marking-lines.
     3853               buffer-copy buf_orig_ml to ub.marking-lines
     3854               assign
     3855                 ub.marking-lines.out-code  = p-out-code
     3856                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     3857               .
     3858               validate ub.marking-lines.
     3859             end .
     3860             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     3861             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     3862               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     3863               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     3864                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     3865                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     3866                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     3867                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3868               then do:
     3869                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3870                 validate buf_marking.
     3871               end.
     3872             end .
     3873           end .
     3874           end.
     3875         end .
     3876         define variable v-doc-type  as character no-undo .
     3877         define variable   v-status    as character no-undo .
     3878         define variable v-fact-qnty   as  decimal no-undo .
     3879         define variable ii    as integer no-undo .
     3880         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     3881                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     3882                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     3883                                        .
     3884         if available pri_trn-doc
     3885         and pri_trn-doc.ext-doc-type = 'rs':U
     3886         then do :
     3887           if p-mark <> ""
     3888           then do :
     3889           end .
     3890           else do :
     3891           end .
     3892         end .
     3893         else do :
     3894           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     3895           and p-mark <> ""
     3896           then do :
     3897             if p-out-code = 'free-zone':U
     3898             then do:
     3899                 if chg-qnty < 0
     3900                 then do :
     3901                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     3902                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     3903                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3904                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3905                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3906                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3907                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3908                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3909                                                           no-error .
     3910                   if available orig_marking-lines
     3911                   then do :
     3912                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     3913                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     3914                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     3915                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     3916                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     3917                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     3918                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     3919                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     3920                                                            no-error .
     3921                     if not available buf_marking-lines
     3922                     then do :
     3923                       create buf_marking-lines .
     3924                       assign
     3925                         buf_marking-lines.mark       = p-mark
     3926                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     3927                         buf_marking-lines.gds-code   = buf_goods.gds-code
     3928                         buf_marking-lines.obj-type   = buf_parts.obj-type
     3929                         buf_marking-lines.obj-code   = buf_parts.obj-code
     3930                         buf_marking-lines.in-code    = buf_parts.in-code
     3931                         buf_marking-lines.out-code   = buf_parts.out-code
     3932                         buf_marking-lines.part-code  = buf_parts.part-code
     3933                         buf_marking-lines.prt-code   = buf_parts.prt-code
     3934                       .
     3935                       validate buf_marking-lines.
     3936                     end .
     3937                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     3938                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3939                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3940                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     3941                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     3942                                                         :
     3943                           assign buf_marking-chk.sts = 0 .
     3944                           validate buf_marking-chk.
     3945                         end .
     3946                       end .
     3947                       if buf_marking.unit-ext <> "UNIT" or
     3948                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     3949                       then do :
     3950                         run addChildMarkingLines in this-procedure (
     3951                           buf_marking.mark,
     3952                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     3953                           buffer buf_marking-lines,
     3954                           buffer buf_parts,
     3955                           buffer orig_marking-lines,
     3956                           buffer buf_orig_parts,
     3957                           buffer buf_goods
     3958                         ).
     3959                       end .
     3960                     end.
     3961                     find current orig_marking-lines exclusive-lock .
     3962                     delete orig_marking-lines .
     3963                   end .
     3964                 end .
     3965             end.
     3966             else do:
     3967               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     3968                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     3969                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     3970                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     3971                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     3972                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     3973                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     3974                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     3975                                                              no-error .
     3976                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     3977                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     3978                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     3979                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     3980                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     3981                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     3982                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     3983                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     3984                                                         no-error .
     3985                 if not available buf_marking-lines
     3986                 then do :
     3987                   create buf_marking-lines .
     3988                   assign
     3989                     buf_marking-lines.mark       = p-mark
     3990                     buf_marking-lines.doc-level  = 1
     3991                     buf_marking-lines.gds-code   = buf_goods.gds-code
     3992                     buf_marking-lines.obj-type   = buf_parts.obj-type
     3993                     buf_marking-lines.obj-code   = buf_parts.obj-code
     3994                     buf_marking-lines.in-code    = buf_parts.in-code
     3995                     buf_marking-lines.out-code   = buf_parts.out-code
     3996                     buf_marking-lines.part-code  = buf_parts.part-code
     3997                     buf_marking-lines.prt-code   = buf_parts.prt-code
     3998                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     3999                   .
     4000                   validate buf_marking-lines.
     4001                 end .
     4002                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4003                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4004                   validate buf_marking.
     4005                   for first buf_marking-childs exclusive-lock where
     4006                             buf_marking-childs.mark = buf_marking.mark-parent:
     4007                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4008                     validate buf_marking-childs.
     4009                   end.
     4010                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4011                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4012                                                     and buf_chk-doc.out-code = buf_parts.out-code
     4013                                                     :
     4014                       if buf_marking-chk.sts <> 2 then
     4015                       do:
     4016                          assign buf_marking-chk.sts = 1 .
     4017                          validate buf_marking-chk.
     4018                       end.
     4019                     end .
     4020                   end .
     4021                   if buf_marking.unit-ext <> "UNIT" or
     4022                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4023                   then do :
     4024                     run addChildMarkingLines in this-procedure (
     4025                       buf_marking.mark,
     4026                       buf_marking.sts,
     4027                       buffer buf_marking-lines,
     4028                       buffer buf_parts,
     4029                       buffer orig_marking-lines,
     4030                       buffer buf_orig_parts,
     4031                       buffer buf_goods
     4032                     ).
     4033                   end .
     4034                 end.
     4035                 if available orig_marking-lines then
     4036                   delete orig_marking-lines .
     4037             end.
     4038           end.
     4039         end .
     4040         if p-out-code = 'out-zone':U
     4041         and trim(p-mark) = ""
     4042         then do :
     4043           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4044                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4045                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4046                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4047                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4048                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4049                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4050                                                 :
     4051             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4052                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     4053                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     4054                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     4055                                                     and buf_marking-lines.out-code   = p-out-code
     4056                                                     no-error .
     4057             if available buf_marking-lines
     4058             then do :
     4059               find current buf_marking-lines exclusive-lock .
     4060               delete buf_marking-lines .
     4061               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4062                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4063                 then do :
     4064                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4065                   validate buf_marking.
     4066                 end.
     4067               end .
     4068             end .
     4069             else do :
     4070               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     4071               create buf_marking-lines .
     4072               assign
     4073                 buf_marking-lines.mark       = orig_marking-lines.mark
     4074                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4075                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4076                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4077                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4078                 buf_marking-lines.in-code    = buf_parts.in-code
     4079                 buf_marking-lines.out-code   = buf_parts.out-code
     4080                 buf_marking-lines.part-code  = buf_parts.part-code
     4081                 buf_marking-lines.prt-code   = buf_parts.prt-code
     4082               .
     4083               validate buf_marking-lines.
     4084               if buf_parts.out-code <> buf_parts.in-code
     4085               and buf_parts.out-code <> 'free-zone':U
     4086               and buf_parts.out-code <> 'out-zone':U
     4087               then do :
     4088                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4089                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4090               end .
     4091               end.
     4092             end .
     4093             release buf_marking-lines no-error .
     4094           end.
     4095         end .
     4096         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     4097         then do:
     4098           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     4099                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     4100                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4101                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4102                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4103                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4104                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4105                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4106                                                   .
     4107             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4108                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     4109                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     4110                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     4111                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     4112                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     4113                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     4114                                                    no-error .
     4115             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     4116               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4117                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     4118               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4119                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     4120               validate ub.marking.
     4121             end.
     4122             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     4123             if available (buf_marking-lines)
     4124             then do:
     4125               assign
     4126                 buf_marking-lines.mark       = p-mark
     4127                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4128                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4129                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4130                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4131                 buf_marking-lines.in-code    = buf_parts.in-code
     4132                 buf_marking-lines.out-code   = buf_parts.out-code
     4133                 buf_marking-lines.part-code  = buf_parts.part-code
     4134               .
     4135               validate buf_marking-lines.
     4136             end.
     4137           end.
     4138         end.
     4139       end.
     4140       else do:
     4141         find first buf_parts exclusive-lock
     4142           where recid(buf_parts) = recid(buf_orig_parts)
     4143           .
     4144       end.
     4145       if p-out-code = 'free-zone':U
     4146       or p-out-code = 'out-zone':U
     4147       then do:
     4148         if buf_parts.rsrv-free <>
     4149          (if buf_parts.out-code = 'free-zone':U then yes else no)
     4150         then do:
     4151           message
     4152             vss-workfile vss-revision vss-description skip
     4153             vss-include-info23 skip
     4154             "Ошибка типа резерва партии" skip
     4155             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     4156             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4157             "Партия" buf_parts.in-code buf_parts.part-code skip
     4158             "Резерв" buf_parts.out-code skip
     4159             "Статус" buf_parts.status_ skip
     4160             "Тип резерва" buf_parts.rsrv-free skip
     4161             view-as alert-box error .
     4162           undo, return error .
     4163         end.
     4164       end.
     4165     end.
     4166   end procedure.
     4167   procedure partcopy-to-childs-mark :
     4168     define parameter buffer buf_ml for ub.marking-lines .
     4169     define parameter buffer buf_orig-ml for ub.marking-lines .
     4170     define input parameter p-out-code as character no-undo .
     4171     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     4172     define buffer buf_ml-childs for ub.marking-lines .
     4173     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     4174       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4175         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     4176       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4177         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     4178       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     4179         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     4180         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     4181         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     4182         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     4183         and buf_ml-childs.part-code = buf_orig-ml.part-code
     4184         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     4185         :
     4186         assign
     4187           buf_ml-childs.out-code  = p-out-code
     4188         .
     4189         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     4190       end.
     4191     end.
     4192   end.
     4193   procedure partcopy-update-parts :
     4194     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4195     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4196     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4197     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4198     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4199     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4200     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     4201     define buffer buf_trn-doc for ub.trn-doc .
     4202     define buffer archive_parts for ub.parts .
     4203     define buffer buf_parts   for ub.parts .
     4204     define buffer orig_marking-lines for ub.marking-lines .
     4205     define buffer buf_marking for ub.marking .
     4206     define buffer buf_goods for ub.goods .
     4207     define variable v-rsrv-code     as character no-undo .
     4208     define variable v-goods-twounit as logical   no-undo .
     4209     define variable v-value-character as character no-undo .
     4210     define variable v-value-date      as date no-undo .
     4211     define variable v-value-decimal   as decimal no-undo .
     4212     define variable v-value-integer   as integer no-undo .
     4213     define variable v-izlcstpr        as logical no-undo .
     4214     define variable v-tth             as handle no-undo .
     4215     define variable v-type            as character no-undo .
     4216     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     4217     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4218     do
     4219     on error undo, return error return-value
     4220     :
     4221       find first buf_trn-doc no-lock
     4222         where buf_trn-doc.doc-code = p-doc-code
     4223         no-error .
     4224       if not available buf_trn-doc
     4225       then do:
     4226         message
     4227           vss-workfile vss-revision vss-description skip
     4228           vss-include-info23 skip
     4229           "Ошибка задания входных параметров" skip
     4230           "Не найден документ" skip
     4231           "Документ" p-doc-code skip
     4232           "Объект" p-obj-type p-obj-code skip
     4233           "Артикул" p-artic p-prod-type p-prod-code skip
     4234           error-status :get-message(1) skip
     4235           return-value skip
     4236           view-as alert-box error .
     4237         undo, return error .
     4238       end.
     4239       find first buf_goods no-lock where buf_goods.artic = p-artic
     4240                                      and buf_goods.prod-type = p-prod-type
     4241                                      and buf_goods.prod-code = p-prod-code
     4242                                      no-error .
     4243       if not available buf_goods
     4244       then do:
     4245         message
     4246           vss-workfile vss-revision vss-description skip
     4247           vss-include-info23 skip
     4248           "Ошибка задания входных параметров" skip
     4249           "Не найден товар" skip
     4250           "Документ" p-doc-code skip
     4251           "Объект" p-obj-type p-obj-code skip
     4252           "Артикул" p-artic p-prod-type p-prod-code skip
     4253           error-status :get-message(1) skip
     4254           return-value skip
     4255           view-as alert-box error .
     4256         undo, return error .
     4257       end.
     4258       if buf_trn-doc.ext-doc-type = 'vt':U
     4259       then do :
     4260           delete object v-tth no-error.
     4261           run adm/shattri.p (
     4262              input "get":U
     4263             ,input buf_trn-doc.obj-type
     4264             ,input buf_trn-doc.obj-code
     4265             ,input 'inv-obj':U
     4266             ,input  "izlcstpr"
     4267             ,output v-value-character
     4268             ,output v-value-date
     4269             ,output v-value-decimal
     4270             ,output v-value-integer
     4271             ,output v-izlcstpr
     4272             ,output v-type
     4273             ,INPUT-OUTPUT table-handle v-tth
     4274             ) no-error .
     4275             delete object v-tth no-error.
     4276           if error-status:error then do:
     4277             v-izlcstpr = false .
     4278           end.
     4279       end.
     4280       else do :
     4281           v-izlcstpr = false .
     4282       end.
     4283   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4285     (input  p-artic
     4286     ,input  p-prod-type
     4287     ,input  p-prod-code
     4288     ,input  'twounit=request':u
     4289     ,output v-goods-twounit
     4290     ) no-error .
     4291       if error-status :error
     4292       then do:
     4293         message
     4294           vss-workfile vss-revision vss-description skip
     4295           vss-include-info23 skip
     4296           "Ошибка при определении атрибута товара" skip
     4297           "Артикул" p-artic p-prod-type p-prod-code skip
     4298           error-status :get-message(1) skip
     4299           return-value skip
     4300           view-as alert-box error .
     4301         undo, return error .
     4302       end.
     4303       define query partcopy-select-parts for archive_parts .
     4304       open query partcopy-select-parts preselect each archive_parts
     4305         where archive_parts.obj-type  = p-obj-type
     4306           and archive_parts.obj-code  = p-obj-code
     4307           and archive_parts.artic     = p-artic
     4308           and archive_parts.prod-type = p-prod-type
     4309           and archive_parts.prod-code = p-prod-code
     4310           and archive_parts.out-code  = p-doc-code
     4311         .
     4312       get first partcopy-select-parts .
     4313       if buf_trn-doc.doc-type = 'при':U
     4314       then do:
     4315         do while available archive_parts
     4316         on error undo, return error return-value
     4317         :
     4318           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4319           or (buf_trn-doc.doc-type = 'инв':U
     4320               and archive_parts.fact-qnty < 0)
     4321           then do:
     4322             assign
     4323               v-rsrv-code = 'out-zone':U
     4324             .
     4325           end.
     4326           else do:
     4327             assign
     4328               v-rsrv-code = 'free-zone':U
     4329             .
     4330           end.
     4331           assign
     4332             archive_parts.status_   = yes
     4333             archive_parts.rsrv-free = ?
     4334           .
     4335           if archive_parts.in-code = p-doc-code
     4336           then do:
     4337             assign
     4338               archive_parts.fact-num  = buf_trn-doc.fact-num
     4339               archive_parts.fact-date = buf_trn-doc.fact-date
     4340               archive_parts.doc-type  = buf_trn-doc.doc-type
     4341             .
     4342           end.
     4343           if archive_parts.fact-qnty <> 0
     4344           then do:
     4345             run partcopy in this-procedure
     4346               (input  true
     4347               ,input  v-rsrv-code
     4348               ,buffer archive_parts
     4349               ,buffer buf_parts
     4350               ,input  ""
     4351               ) no-error .
     4352             if error-status :error
     4353             then do:
     4354               message
     4355                 vss-workfile vss-revision vss-description skip
     4356                 vss-include-info23 skip
     4357                 "Ошибка при создании партии" skip
     4358                 "Документ" p-doc-code skip
     4359                 "Объект" p-obj-type p-obj-code skip
     4360                 "Артикул" p-artic p-prod-type p-prod-code skip
     4361                 "Партия" archive_parts.in-code archive_parts.part-code skip
     4362                 "Резерв" v-rsrv-code skip
     4363                 error-status :get-message(1) skip
     4364                 return-value skip
     4365                 view-as alert-box error .
     4366               undo, return error .
     4367             end.
     4368             assign
     4369               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     4370               buf_parts.fact-qnty = buf_parts.qnty
     4371             .
     4372             if v-goods-twounit = true
     4373             then do:
     4374               assign
     4375                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     4376               .
     4377               case buf_trn-doc.ext-doc-type :
     4378                 when 'ie':U
     4379                 then do:
     4380                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     4381                   then do:
     4382                     message
     4383                       vss-workfile vss-revision vss-description skip
     4384                       vss-include-info23 skip
     4385                       "Клиентское количество для товара," skip
     4386                       "который учитывается по двум единицам измерения" skip
     4387                       "должно равняться единице" skip
     4388                       "Документ" p-doc-code skip
     4389                       "Объект" p-obj-type p-obj-code skip
     4390                       "Артикул" p-artic p-prod-type p-prod-code skip
     4391                       "Партия" archive_parts.in-code archive_parts.part-code skip
     4392                       "Количество по документу" archive_parts.qnty skip
