     4864           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     4865           )
     4866           or buf_trn-doc.ext-doc-type = 'rv':U
     4867           then do:
     4868             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     4869             or (buf_trn-doc.doc-type = 'инв':U
     4870                 and archive_parts.fact-qnty < 0
     4871               )
     4872             then do:
     4873               assign
     4874                 v-rsrv-code = 'free-zone':U
     4875               .
     4876             end.
     4877             else do:
     4878               assign
     4879                 v-rsrv-code = 'out-zone':U
     4880               .
     4881             end.
     4882             if not v-izlcstpr
     4883             then do :
     4884                 run partcopy in this-procedure
     4885                   (input  true
     4886                   ,input  v-rsrv-code
     4887                   ,buffer archive_parts
     4888                   ,buffer buf_parts
     4889                   ,input  ""
     4890                   ) no-error .
     4891                 if error-status :error
     4892                 then do:
     4893                   message
     4894                     vss-workfile vss-revision vss-description skip
     4895                     vss-include-info23 skip
     4896                     "Ошибка при создании партии" skip
     4897                     "Документ" p-doc-code skip
     4898                     "Объект" p-obj-type p-obj-code skip
     4899                     "Артикул" p-artic p-prod-type p-prod-code skip
     4900                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4901                     "Резерв" v-rsrv-code skip
     4902                     error-status :get-message(1) skip
     4903                     return-value skip
     4904                     view-as alert-box error .
     4905                   undo, return error .
     4906                 end.
     4907                 assign
     4908                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     4909                   buf_parts.fact-qnty = buf_parts.qnty
     4910                 .
     4911                 if buf_trn-doc.ext-doc-type = 'rv':U
     4912                 then
     4913                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4914                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     4915                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     4916                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     4917                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     4918                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     4919                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     4920                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4921                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4922                   then
     4923                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4924                 end .
     4925                 if v-goods-twounit = true
     4926                 then do:
     4927                   message
     4928                     vss-workfile vss-revision vss-description skip
     4929                     vss-include-info23 skip
     4930                     "Запрещено порождение партий," skip
     4931                     "который учитывается по двум единицам измерения" skip
     4932                     "Документ" p-doc-code skip
     4933                     "Объект" p-obj-type p-obj-code skip
     4934                     "Артикул" p-artic p-prod-type p-prod-code skip
     4935                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4936                     "Количество по документу" archive_parts.qnty skip
     4937                     "Фактическое количество" archive_parts.fact-qnty skip
     4938                     "Клиентское количество" archive_parts.cli-qnty skip
     4939                     view-as alert-box error .
     4940                   undo, return error .
     4941                 end.
     4942                 else do:
     4943                   if buf_parts.cli-base-rate <> 0
     4944                   then do:
     4945                     assign
     4946                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4947                     .
     4948                   end.
     4949                   else do:
     4950                     assign
     4951                       buf_parts.cli-qnty = 0
     4952                     .
     4953                   end.
     4954                 end.
     4955             end.
     4956           end.
     4957           get next partcopy-select-parts .
     4958         end.
     4959       end.
     4960     end.
     4961   end procedure.
     4962   procedure partcopy-update-parts-delete :
     4963     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
