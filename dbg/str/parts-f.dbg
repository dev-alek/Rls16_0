     9311   function getattrUtdex returns char
     9312   (idb-num   as integer,
     9313    idoc-id   as integer,
     9314    iattrcode as character,
     9315    iExValue  as character  ):
     9316      define buffer utd-attr for utd-attr.
     9317      find first utd-attr where utd-attr.db-num eq idb-num
     9318                            and utd-attr.doc-id eq idoc-id
     9319                            and utd-attr.attr-code eq iattrcode
     9320      no-lock no-error.
     9321      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     9322   end.
     9323   function getattrUtd returns char
     9324   (idb-num   as integer,
     9325    idoc-id   as integer,
     9326    iattrcode as character ):
     9327     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     9328   end.
     9329   function setattrUtd returns logical
     9330   (idb-num   as integer,
     9331    idoc-id   as integer,
     9332    iattrcode as character,
     9333    iattrval  as character ):
     9334      define buffer utd-attr for utd-attr.
     9335      find first utd-attr where utd-attr.db-num eq idb-num
     9336                            and utd-attr.doc-id eq idoc-id
     9337                            and utd-attr.attr-code eq iattrcode
     9338      no-lock no-error.
     9339      if not available utd-attr
     9340      then do:
     9341         create utd-attr.
     9342         assign
     9343            utd-attr.db-num    = idb-num
     9344            utd-attr.doc-id    = idoc-id
     9345            utd-attr.attr-code = iattrcode
     9346            utd-attr.attr-value = iattrval
     9347         .
     9348      end.
     9349      else do:
     9350         if utd-attr.attr-value ne iattrval
     9351         then do:
     9352            find current utd-attr exclusive-lock no-error.
     9353            if available utd-attr
     9354            then
     9355               utd-attr.attr-value = iattrval.
     9356         end.
     9357      end.
     9358      release utd-attr.
     9359   end.
     9360   function GetAttrUtdlinesEx returns char
     9361   (idb-num   as integer,
     9362    idoc-id   as integer,
     9363    ilinenum  as integer,
     9364    iattrcode as character,
     9365    iExValue  as character  ):
     9366      define buffer utd-lines-attr for utd-lines-attr.
     9367      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     9368                                  and utd-lines-attr.doc-id    eq idoc-id
     9369                                  and utd-lines-attr.lineNum   eq ilineNum
     9370                                  and utd-lines-attr.attr-code eq iattrcode
     9371      no-lock no-error.
     9372      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     9373   end.
