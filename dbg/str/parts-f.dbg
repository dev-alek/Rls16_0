    12695     return no-apply .
    12696   end.
    12697   on ctrl-f of parts.last-date in frame Dialog-Frame
    12698   do:
    12699     if (can-query (self, "sensitive")
    12700        and
    12701        self :sensitive = true
    12702        )
    12703     or (can-query (self, "read-only")
    12704        and
    12705        self :read-only = false
    12706        )
    12707     then do:
    12708       if self :handle <> focus :handle
    12709       then do:
    12710         apply "entry":u to self .
    12711       end.
    12712       define variable v-ok            as logical   no-undo .
    12713       define variable v-curr-sv-date  as date      no-undo .
    12714       define variable v-description   as character no-undo .
    12715       assign
