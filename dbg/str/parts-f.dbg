    12453   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12454   on help of frame Dialog-Frame
    12455   do:
    12456     run gbl/app_help.p
    12457       (input this-procedure :file-name
    12458       ,input ''
    12459       ,input ?
    12460       ) no-error.
    12461     if error-status :error then do:
    12462       message
    12463         "Ошибка при вызове помощи"
    12464         error-status :get-message(1)
    12465         view-as alert-box .
