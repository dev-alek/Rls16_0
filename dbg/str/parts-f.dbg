    10898        val-price-base AT ROW 20.96 COL 75.25 COLON-ALIGNED NO-LABEL
    10899        RECT-2 AT ROW 5.83 COL 1
    10900        RECT-3 AT ROW 10.58 COL 1
    10901        RECT-4 AT ROW 17.21 COL 1.25
    10902        RECT-1 AT ROW 2.17 COL 1
    10903        SPACE(0.12) SKIP(17.33)
    10904       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
    10905            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
    10906            TITLE "Партия товара".
    10907   ASSIGN
    10908          FRAME Dialog-Frame:SCROLLABLE       = FALSE
    10909          FRAME Dialog-Frame:HIDDEN           = TRUE.
    10910   ASSIGN
    10911          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    10912   ASSIGN
    10913          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
    10914   ASSIGN
    10915          ub.parts.PS:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
    10916   ON ESC OF FRAME Dialog-Frame
    10917   DO:
    10918     assign
    10919       v-undo-last = true
    10920     .
    10921     apply "go":u to self .
    10922     return no-apply .
    10923   END.
    10924   ON GO OF FRAME Dialog-Frame
    10925   DO:
    10926     define variable v-close-window as logical no-undo .
    10927     if v-undo-last = true
    10928     then do:
    10929       return .
    10930     end.
    10931     run update-record in this-procedure
    10932       (output v-close-window
    10933       ) no-error .
    10934     if error-status :error
    10935     then do:
    10936       undo, return no-apply .
    10937     end.
    10938     assign
    10939       p-parts-recid = v-parts-recid
    10940     .
    10941   END.
    10942   ON WINDOW-CLOSE OF FRAME Dialog-Frame
    10943   DO:
    10944     APPLY "END-ERROR":U TO SELF.
    10945   END.
    10946   ON CHOOSE OF b-add IN FRAME Dialog-Frame
    10947   DO:
    10948   define variable vss-include-info58 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10949   if lookup(self :type
    10950            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    10951            ) = 0
    10952   then do:
    10953     message
    10954       "$Workfile$"
    10955       "Указанному интерфейсному элементу фокус не может быть передан" skip
    10956       "Интерфейсный элемент" self :name  skip
    10957       "Тип" self :type  skip
    10958       "Процедура" this-procedure :file-name skip
    10959       view-as alert-box .
    10960   end.
    10961   else do:
    10962     apply "entry":u to self  .
    10963     if focus :handle <> self :handle  then do:
    10964       return no-apply .
    10965     end.
    10966   end.
    10967     run check-current-modified in this-procedure
    10968       no-error .
    10969     if error-status :error
    10970     then do:
    10971       undo, return no-apply .
    10972     end.
    10973     if p-mode = 'ИЗМЕНЕНИЕ':U
    10974     then do:
    10975       assign
    10976         v-parts-recid     = ?
    10977         v-create-part     = true
    10978       .
    10979       run disable-fields .
    10980       run display-fields .
    10981       run enable-fields .
    10982     end.
    10983   END.
    10984   ON CHOOSE OF b-alc-attr IN FRAME Dialog-Frame
    10985   DO:
    10986   define variable vss-include-info59 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10987   if lookup(self :type
    10988            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    10989            ) = 0
    10990   then do:
    10991     message
    10992       "$Workfile$"
    10993       "Указанному интерфейсному элементу фокус не может быть передан" skip
    10994       "Интерфейсный элемент" self :name  skip
    10995       "Тип" self :type  skip
    10996       "Процедура" this-procedure :file-name skip
    10997       view-as alert-box .
    10998   end.
    10999   else do:
    11000     apply "entry":u to self  .
    11001     if focus :handle <> self :handle  then do:
    11002       return no-apply .
    11003     end.
    11004   end.
    11005       define variable v-save-flag           as logical   no-undo .
    11006       define buffer buf_parts for ub.parts .
    11007       if v-alcohol-prod = true then do:
    11008       find first buf_parts no-lock
    11009         where recid(buf_parts) = v-parts-recid
    11010         no-error .
    11011       if available buf_parts
    11012       then do:
    11013           if buf_parts.status_ then do:
    11014             run str/in-alc.w
    11015                 (input parparentproc
    11016                 ,input 'ИЗМЕНЕНИЕ':U
    11017                 ,input p-gds-code
    11018                 ,buffer buf_parts
    11019                 ,input-output v-alc-mark-db-num
    11020                 ,input-output v-alc-mark-code
    11021                 ,input-output v-alc-bottling-date
    11022                 ,input-output v-alc-ref-ab-path
    11023                 ,input-output v-alc-quality-certif-path
    11024                 ,input-output v-alc-certif-path
    11025                 ,input-output v-alc-imp-type
    11026                 ,input-output v-alc-imp-code
    11027                 ,output       v-save-flag
    11028             ) no-error .
    11029           end.
    11030           else do:
    11031               run str/in-alc.w
    11032               (  input parparentproc
    11033                 ,input p-mode
    11034                 ,input p-gds-code
    11035                 ,buffer buf_parts
    11036                 ,input-output v-alc-mark-db-num
    11037                 ,input-output v-alc-mark-code
    11038                 ,input-output v-alc-bottling-date
    11039                 ,input-output v-alc-ref-ab-path
    11040                 ,input-output v-alc-quality-certif-path
    11041                 ,input-output v-alc-certif-path
    11042                 ,input-output v-alc-imp-type
    11043                 ,input-output v-alc-imp-code
    11044                 ,output       v-save-flag
    11045               ) no-error .
    11046               if error-status :error
    11047               then do:
    11048                 if error-status :get-message(1) <> '':u
    11049                 then do:
    11050                   message
    11051                     vss-workfile vss-revision vss-description skip
    11052                     "Ошибка при вызове процедуры in-alc.w" skip
    11053                     error-status :get-message(1) skip
    11054                     return-value skip
    11055                     view-as alert-box error .
    11056                 end.
    11057                 undo, return no-apply .
    11058               end.
    11059           end.
    11060           define variable v-display-part-code as character no-undo .
    11061           run partsfnc_get-parts-show-code in this-procedure
    11062             (input  v-new-parts-part-code
    11063             ,input  v-alc-mark-db-num
    11064             ,input  v-alc-mark-code
    11065             ,input  v-alc-bottling-date
    11066             ,input  v-alcohol-prod
    11067             ,output v-display-part-code
    11068             ) .
    11069           assign
    11070             parts.part-code :screen-value = string(v-display-part-code
    11071                                                   ,parts.part-code :format
    11072                                                   )
    11073           .
    11074           if p-mode <> 'ПРОСМОТР':U then do:
    11075               if v-save-flag then do:
    11076                 run trg/partps.p ( input p-gds-code
    11077                   , input buf_parts.in-code
    11078                   , input if buf_parts.in-code <> buf_parts.out-code then buf_parts.out-code else ?
    11079                   , input buf_parts.part-code
    11080                   ,input v-alc-mark-db-num
    11081                   ,input v-alc-mark-code
    11082                   ,input v-alc-bottling-date
    11083                   ,input v-alc-ref-ab-path
    11084                   ,input v-alc-quality-certif-path
    11085                   ,input v-alc-certif-path
    11086                   ,input v-alc-imp-type
    11087                   ,input v-alc-imp-code
    11088                   ) no-error .
    11089                 end.
    11090               end.
    11091           else do:
    11092               if v-save-flag then do:
    11093                   if    buf_parts.mark-db-num     <> v-alc-mark-db-num or buf_parts.mark-code <> v-alc-mark-code
    11094                   or    v-alc-bottling-date       <> buf_parts.alc-bottling-date
    11095                   or    v-alc-ref-ab-path         <> buf_parts.alc-ref-ab-path
    11096                   or    v-alc-quality-certif-path <> buf_parts.alc-quality-certif-path
    11097                   or    v-alc-certif-path         <> buf_parts.alc-certif-path
    11098                   or    v-alc-imp-type            <> buf_parts.alc-imp-type
    11099                   or    v-alc-imp-code            <> buf_parts.alc-imp-code
    11100                   then do:
    11101                       define variable chk-message as character no-undo.
    11102                       define variable chk-changes as logical no-undo.
    11103                       chk-message = "ВНИМАНИЕ!" + (if buf_parts.in-code <> buf_parts.out-code then " Изменения только по расходной партии." else " Изменения по всем документам порожденным из исходного." ) + chr(10) + "Вы собираетесь изменить следующие поля:" + chr(10).
    11104                       if buf_parts.mark-db-num     <> v-alc-mark-db-num or buf_parts.mark-code <> v-alc-mark-code then chk-message = chk-message + "- Код марки" + chr(10).
    11105                       if v-alc-bottling-date       <> buf_parts.alc-bottling-date           then chk-message = chk-message + "- Дата розлива" + chr(10).
    11106                       if v-alc-ref-ab-path         <> buf_parts.alc-ref-ab-path             then chk-message = chk-message + "- Справки А, Б" + chr(10).
    11107                       if v-alc-quality-certif-path <> buf_parts.alc-quality-certif-path     then chk-message = chk-message + "- Удостоверение качества" + chr(10).
    11108                       if v-alc-certif-path         <> buf_parts.alc-certif-path             then chk-message = chk-message + "- Сертификат соответствия" + chr(10).
    11109                       if v-alc-imp-code            <> buf_parts.alc-imp-code or v-alc-imp-type            <> buf_parts.alc-imp-type                then chk-message = chk-message + "- Импортер" + chr(10).
    11110                       chk-message = chk-message + "Сохранить изменения?".
    11111                       message chk-message view-as alert-box question button yes-no update chk-changes.
    11112                       if chk-changes then do:
    11113                       run trg/partps.p ( input p-gds-code
    11114                         , input buf_parts.in-code
    11115                         , input if buf_parts.in-code <> buf_parts.out-code then buf_parts.out-code else ?
    11116                         , input buf_parts.part-code
    11117                         ,input v-alc-mark-db-num
    11118                         ,input v-alc-mark-code
    11119                         ,input v-alc-bottling-date
    11120                         ,input v-alc-ref-ab-path
    11121                         ,input v-alc-quality-certif-path
    11122                         ,input v-alc-certif-path
    11123                         ,input v-alc-imp-type
    11124                         ,input v-alc-imp-code
    11125                         ) no-error .
    11126                       end.
    11127                     end.
    11128                   end.
    11129               end.
    11130           end.
    11131           else do:
    11132             message "В начале сохраните партию." view-as alert-box information title "Сообщение".
    11133           end.
    11134       end.
    11135   END.
    11136   ON CHOOSE OF b-cst IN FRAME Dialog-Frame
    11137   DO:
    11138   define variable vss-include-info60 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11139   if lookup(self :type
    11140            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11141            ) = 0
    11142   then do:
    11143     message
    11144       "$Workfile$"
    11145       "Указанному интерфейсному элементу фокус не может быть передан" skip
    11146       "Интерфейсный элемент" self :name  skip
    11147       "Тип" self :type  skip
    11148       "Процедура" this-procedure :file-name skip
    11149       view-as alert-box .
    11150   end.
    11151   else do:
    11152     apply "entry":u to self  .
    11153     if focus :handle <> self :handle  then do:
    11154       return no-apply .
    11155     end.
    11156   end.
    11157     define buffer buf_parts for ub.parts .
    11158     define variable v-create-part     as logical   no-undo .
    11159     define variable v-create-obj      as logical   no-undo .
    11160     define variable v-cst-code-format as character no-undo .
    11161     define variable v-parts-cst-code  as character no-undo .
    11162     define variable v-ok              as logical   no-undo .
    11163     if p-mode <> 'ИЗМЕНЕНИЕ':U
    11164     and v-parts-recid <> ?
    11165     then do:
    11166       find first buf_parts no-lock
    11167         where recid(buf_parts) = v-parts-recid
    11168         no-error .
    11169       if available buf_parts
    11170       then do:
    11171         assign
    11172           v-parts-cst-code = buf_parts.cst-code
    11173         .
    11174         run gbl/d-prompt.w
    11175           ( 'title=':U + "Введите новый ГТД" + '\':U
    11176           + 'text1=':U + "Документ " + str-encode(buf_parts.in-code, "", '\=':U )
    11177             + chr(32) + "Номер " + str-encode(buf_parts.part-code, "", '\=':U ) + '\':U
    11178           + 'text2=' + "Артикул " + str-encode(buf_parts.artic, "", '\=':U )
    11179             + chr(32) + string(buf_parts.prod-type)
    11180             + chr(32) + string(buf_parts.prod-code) + '\':U
    11181           + 'format=' + 'X(60)' + '\':U
    11182           + 'type=character':U
    11183           ,input-output v-parts-cst-code
    11184           ).
    11185         if return-value = 'false':U
    11186         then do:
    11187           return .
    11188         end.
    11189         define variable v-warning as character no-undo .
    11190         define buffer buf_db for ub.db .
    11191         find first buf_db no-lock
    11192           where buf_db.db-num <> 0
    11193           no-error .
    11194         if available buf_db
    11195         then do:
    11196           assign
    11197             v-warning = "ВНИМАНИЕ! Изменения не будут переданы в другие базы данных"
    11198           .
    11199         end.
    11200         assign
    11201           v-ok = false
    11202         .
    11203         message
    11204           "Будет изменен ГТД партии товара" skip
    11205           "во всех документах текущей базы данных" skip
    11206           "Документ" buf_parts.in-code skip
    11207           "Номер " buf_parts.part-code skip
    11208           "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    11209           "Старый ГТД" buf_parts.cst-code skip
    11210           "" skip
    11211           "Новый ГТД" v-parts-cst-code skip
    11212           "" skip
    11213           v-warning skip
    11214           "Продолжить?" skip
    11215           view-as alert-box question buttons yes-no update v-ok .
    11216         if v-ok <> true
    11217         then do:
    11218           return .
    11219         end.
    11220         run trg/partcst.p
    11221           (input v-parts-cst-code
    11222           ,input buf_parts.in-code
    11223           ,input buf_parts.artic
    11224           ,input buf_parts.prod-type
    11225           ,input buf_parts.prod-code
    11226           ,input buf_parts.part-code
    11227           ) .
    11228         if valid-handle(h-call-prog)
    11229         then do:
    11230           run reopen-query in h-call-prog no-error .
    11231           if error-status :error
    11232           then do:
    11233             message
    11234               vss-workfile vss-revision vss-description skip
    11235               "Ошибка при переоткрытии браузера в" h-call-prog :file-name skip
    11236               view-as alert-box error .
    11237           end.
    11238         end.
    11239         message
    11240           "Изменение ГТД завершено" skip
    11241           "ГТД" v-parts-cst-code skip
    11242           view-as alert-box information .
    11243       end.
    11244       run display-fields .
    11245     end.
    11246   END.
    11247   ON CHOOSE OF b-del IN FRAME Dialog-Frame
    11248   DO:
    11249   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11250   if lookup(self :type
    11251            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11252            ) = 0
    11253   then do:
    11254     message
    11255       "$Workfile$"
    11256       "Указанному интерфейсному элементу фокус не может быть передан" skip
    11257       "Интерфейсный элемент" self :name  skip
    11258       "Тип" self :type  skip
    11259       "Процедура" this-procedure :file-name skip
    11260       view-as alert-box .
    11261   end.
    11262   else do:
    11263     apply "entry":u to self  .
    11264     if focus :handle <> self :handle  then do:
    11265       return no-apply .
    11266     end.
    11267   end.
    11268     define variable lok as logical no-undo init false .
    11269     run check-current-modified in this-procedure
    11270       no-error .
    11271     if error-status :error
    11272     then do:
    11273       undo, return no-apply .
    11274     end.
    11275     if v-parts-recid <> ?
    11276     then do:
    11277       message
    11278         "Удалить партию?" SKIP
    11279         "Вы уверены?"
    11280         view-as alert-box question buttons yes-no update lok .
    11281       if lok = false
    11282       then do:
    11283         return .
    11284       end.
    11285       run delete-parts in h-call-prog
    11286         (input v-parts-recid
    11287         ) no-error .
    11288       if error-status :error
    11289       then do:
    11290         message
    11291           "Партия не была удалена" skip
    11292           error-status :get-message(1) skip
    11293           return-value skip
    11294           view-as alert-box .
    11295         return no-apply .
    11296       end.
    11297     end.
    11298     assign
    11299       v-undo-last = true
    11300     .
    11301     apply "go":u to frame Dialog-Frame .
    11302   END.
    11303   ON CHOOSE OF b-dop IN FRAME Dialog-Frame
    11304   DO:
    11305   define variable vss-include-info62 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11306   if lookup(self :type
    11307            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11308            ) = 0
    11309   then do:
    11310     message
    11311       "$Workfile$"
