    11413   END.
    11414   ON CHOOSE OF b-edit-price IN FRAME Dialog-Frame
    11415   DO:
    11416     define variable v-parts-price-base      as decimal   no-undo .
    11417     define variable v-parts-price-rubl      as decimal   no-undo .
    11418     define variable v-orig-parts-price-base as decimal   no-undo .
    11419     define variable v-orig-parts-price-rubl as decimal   no-undo .
    11420     define variable v-action                as character no-undo .
    11421     define variable v-parts-chg-qnty        as decimal   no-undo .
    11422     define buffer buf_trn-doc for ub.trn-doc .
    11423     define buffer buf_goods   for ub.goods .
    11424     define buffer buf_clients for ub.clients .
    11425     if v-can-change-supp = false
    11426     then do:
    11427       assign
    11428         v-parts-price-base = decimal(parts.price-base :screen-value)
    11429         v-parts-price-rubl = decimal(parts.price-rubl :screen-value)
    11430       .
    11431     end.
    11432     else do:
    11433       if v-enable-price-rubl = true
    11434       then do:
    11435         assign
    11436           v-parts-price-rubl = decimal(parts.price-rubl :screen-value)
    11437         .
    11438       end.
    11439       else do:
    11440         if  v-enable-price-cli = true
    11441         and v-exch-code        = 0
    11442         then do:
    11443           assign
    11444             v-parts-price-rubl = decimal(parts.price-cli :screen-value)
    11445           .
    11446         end.
    11447       end.
    11448       if v-enable-price-base = true
    11449       then do:
    11450         assign
    11451           v-parts-price-base = decimal(parts.price-base :screen-value)
    11452         .
    11453       end.
    11454       else do:
    11455         if  v-enable-price-cli = true
    11456         and v-exch-code        = (input frame Dialog-Frame val-base-code)
    11457         then do:
    11458           assign
    11459             v-parts-price-base = decimal(parts.price-cli :screen-value)
    11460           .
    11461         end.
    11462       end.
    11463     end.
    11464     assign
    11465       v-orig-parts-price-base = v-parts-price-base
    11466       v-orig-parts-price-rubl = v-parts-price-rubl
    11467     .
    11468     find first buf_trn-doc no-lock
    11469       where buf_trn-doc.doc-code = p-doc-code
    11470       .
    11471     find first buf_goods no-lock
    11472       where buf_goods.gds-code = p-gds-code
    11473       .
    11474     find first buf_clients no-lock
    11475       where buf_clients.obj-type = parts.supp-type :screen-value
    11476         and buf_clients.obj-code = integer(parts.supp-code :screen-value)
    11477       no-error .
    11478     if not available buf_clients
    11479     then do:
    11480       find first buf_clients no-lock
    11481         where buf_clients.obj-type = buf_trn-doc.obj-type
    11482           and buf_clients.obj-code = buf_trn-doc.obj-code
    11483         .
    11484     end.
    11485     assign
    11486       v-parts-chg-qnty = decimal(parts.qnty :screen-value)
    11487     .
    11488     run trg/in-price.w
    11489       (input parparentproc
    11490       ,input-output v-parts-price-base
    11491       ,input-output v-parts-price-rubl
    11492       ,output v-action
    11493       ,input  buf_trn-doc.obj-type
    11494       ,input  buf_trn-doc.obj-code
    11495       ,input  buf_goods.artic
    11496       ,input  buf_goods.prod-type
    11497       ,input  buf_goods.prod-code
    11498       ,input  buf_clients.obj-type
    11499       ,input  buf_clients.obj-code
    11500       ,input  buf_trn-doc.base-rate
    11501       ,input  buf_trn-doc.base-scale
    11502       ,input  v-parts-chg-qnty
    11503       ) no-error .
    11504     if error-status :error
    11505     then do:
    11506       return no-apply .
    11507     end.
    11508     if v-parts-price-rubl  <> v-orig-parts-price-rubl
    11509     then do:
    11510       if v-enable-price-rubl = true
    11511       then do:
    11512         assign
    11513           parts.price-rubl :screen-value = string(v-parts-price-rubl
    11514                                                 ,parts.price-rubl :format
    11515                                                 )
    11516         .
    11517       end.
    11518       else do:
    11519         if  v-enable-price-cli = true
    11520         and v-exch-code        = 0
    11521         then do:
    11522           assign
    11523             parts.price-cli :screen-value = string(v-parts-price-rubl
    11524                                                   ,parts.price-cli :format
    11525                                                   )
    11526           .
    11527         end.
    11528       end.
    11529     end.
    11530     if v-parts-price-base  <> v-orig-parts-price-base
    11531     then do:
    11532       if v-enable-price-base = true
    11533       then do:
    11534         assign
    11535           parts.price-base :screen-value = string(v-parts-price-base
    11536                                                 ,parts.price-base :format
    11537                                                 )
    11538         .
    11539       end.
    11540       else do:
    11541         if  v-enable-price-cli = true
    11542         and v-exch-code        = (input frame Dialog-Frame val-base-code)
    11543         then do:
    11544           assign
    11545             parts.price-cli :screen-value = string(v-parts-price-base
    11546                                                   ,parts.price-cli :format
    11547                                                   )
    11548           .
    11549         end.
    11550       end.
    11551     end.
    11552     run update-dependent-price in this-procedure .
    11553   END.
