    12587        )
    12588     then do:
    12589       assign
    12590         self :screen-value = ?
    12591       .
    12592     end.
    12593     return no-apply.
    12594   end.
    12595   on ctrl-d of parts.last-date in frame Dialog-Frame
    12596   do:
    12597     define variable v-curr-sv-date as date no-undo .
    12598     if (can-query (self, "sensitive")
    12599        and
    12600        self :sensitive = true
    12601        )
    12602     or (can-query (self, "read-only")
    12603        and
    12604        self :read-only = false
    12605        )
    12606     then do:
    12607       if self :handle <> focus :handle
    12608       then do:
    12609         apply "entry":u to self .
    12610       end.
    12611       run gbl/getcurdt.p
    12612         (output v-curr-sv-date
    12613         ) .
    12614       assign
    12615         self :screen-value = string(v-curr-sv-date) .
    12616       .
    12617     end.
    12618     return no-apply.
    12619   end.
    12620   on ctrl-b of parts.last-date in frame Dialog-Frame
    12621   do:
    12622     if (can-query (self, "sensitive")
    12623        and
    12624        self :sensitive = true
    12625        )
    12626     or (can-query (self, "read-only")
    12627        and
    12628        self :read-only = false
    12629        )
    12630     then do:
    12631       if self :handle <> focus :handle
    12632       then do:
    12633         apply "entry":u to self .
    12634       end.
    12635       define variable v-curr-sv-date as date no-undo .
    12636       define variable v-new-sv-date  as date no-undo .
    12637       assign
    12638         v-curr-sv-date = date(self :screen-value) no-error
    12639       .
    12640       if v-curr-sv-date = ?
    12641       then do:
    12642         run gbl/getcurdt.p
    12643           (output v-curr-sv-date
    12644           ) .
    12645       end.
    12646       if v-curr-sv-date <> ?
    12647       then do:
    12648         assign
    12649           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
    12650         .
    12651         assign
    12652           self :screen-value = string(v-new-sv-date) .
    12653         .
    12654       end.
    12655     end.
    12656     return no-apply .
    12657   end.
    12658   on ctrl-e of parts.last-date in frame Dialog-Frame
    12659   do:
    12660     if (can-query (self, "sensitive")
    12661        and
    12662        self :sensitive = true
    12663        )
    12664     or (can-query (self, "read-only")
    12665        and
    12666        self :read-only = false
    12667        )
    12668     then do:
    12669       if self :handle <> focus :handle
    12670       then do:
    12671         apply "entry":u to self .
    12672       end.
    12673       define variable v-curr-sv-date as date no-undo .
    12674       define variable v-new-sv-date  as date no-undo .
    12675       assign
    12676         v-curr-sv-date = date(self :screen-value) no-error
    12677       .
    12678       if v-curr-sv-date = ?
    12679       then do:
    12680         run gbl/getcurdt.p
    12681           (output v-curr-sv-date
    12682           ) .
