     8371           buf_doc-line-attr.doc-code  = p-doc-code
     8372           buf_doc-line-attr.gds-code  = p-gds-code
     8373           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     8374         .
     8375       end.
     8376       assign
     8377         buf_doc-line-attr.attr-value = string( p-value )
