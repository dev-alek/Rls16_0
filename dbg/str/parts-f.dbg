     6896   procedure partrsrv-need-rsrv :
     6897     define input  parameter p-parts-in-code   as character no-undo .
     6898     define input  parameter p-parts-out-code  as character no-undo .
     6899     define output parameter p-need-rsrv-parts as logical   no-undo .
     6900     do
     6901     on error undo, return error return-value
     6902     :
     6903       if p-parts-out-code <> p-parts-in-code
     6904       then do:
     6905         assign
     6906           p-need-rsrv-parts = true
     6907         .
     6908       end.
     6909       else do:
     6910         assign
     6911           p-need-rsrv-parts = false
     6912         .
     6913       end.
     6914     end.
     6915   end procedure.
     6916   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6917   FUNCTION get-parts-part-code RETURNS CHARACTER
     6918     ( BUFFER buf_parts FOR ub.parts
     6919     , INPUT p-goods-alcohol-prod AS LOGICAL
     6920     ) :
     6921     define variable v-show-part-code as character no-undo .
     6922     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
     6923     then do:
     6924       return '------':u .
     6925     end.
     6926     run partsfnc_get-parts-show-code in this-procedure
     6927       (input  buf_parts.part-code
     6928       ,input  buf_parts.mark-db-num
     6929       ,input  buf_parts.mark-code
     6930       ,input  buf_parts.alc-bottling-date
     6931       ,input  p-goods-alcohol-prod
     6932       ,output v-show-part-code
     6933       ) .
     6934     return v-show-part-code .
     6935   END FUNCTION.
     6936   procedure partsfnc_get-parts-show-code :
     6937     define input  parameter p-part-code          as character no-undo .
     6938     define input  parameter p-mark-db-num        as integer   no-undo .
     6939     define input  parameter p-mark-code          as integer   no-undo .
     6940     define input  parameter p-alc-bottling-date  as date      no-undo .
     6941     define input  parameter p-goods-alcohol-prod as logical   no-undo .
     6942     define output parameter p-show-code          as character no-undo .
     6943     define variable v-alc-mark-name as character no-undo .
     6944     do
     6945     on error undo, return error return-value
     6946     :
     6947       assign
     6948         p-show-code = '':u
     6949       .
     6950       if p-goods-alcohol-prod = true
     6951       then do:
     6952         run alc-lib_mark-name in this-procedure
     6953           (input  p-mark-db-num
     6954           ,input  p-mark-code
     6955           ,output v-alc-mark-name
     6956           ) .
     6957         assign
     6958           p-show-code = substitute('&1,&2':u
     6959                                   ,v-alc-mark-name
     6960                                   ,string(p-alc-bottling-date,'99/99/9999':u)
     6961                                   )
     6962         .
     6963       end.
     6964       else do:
     6965         assign
     6966           p-show-code = p-part-code
     6967         .
     6968       end.
     6969       return '':u .
     6970     end.
     6971   end procedure.
     6972   FUNCTION get-parts-out-code RETURNS CHARACTER
     6973     ( BUFFER buf_parts FOR ub.parts ) :
     6974     case buf_parts.out-code :
     6975       when 'free-zone':U then do:
     6976         return "свободно" .
     6977       end.
     6978       when 'out-zone':U then do:
     6979         return "расход" .
     6980       end.
     6981       otherwise do:
     6982         if buf_parts.doc-type = 'акт':U then do:
     6983           return caps("ЦН") + " № " + buf_parts.out-code .
     6984         end.
     6985         else do:
     6986           define variable v-ext-name       as character no-undo .
     6987           define variable v-trn-doc-status as character no-undo .
     6988           define buffer buf_trn-doc for ub.trn-doc .
     6989           find first buf_trn-doc no-lock
     6990             where buf_trn-doc.doc-code = buf_parts.out-code
     6991             no-error .
     6992           if available buf_trn-doc then do:
     6993   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
     6995     (input  buf_parts.out-code
     6996     ,output v-ext-name
     6997     )  .
     6998             assign
     6999               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
     7000             .
     7001           end.
     7002           else do:
     7003             assign
     7004               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
     7005               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
     7006             .
     7007           end.
     7008           return substitute("&1 № &2 &3"
     7009              ,v-ext-name
     7010              ,buf_parts.out-code
     7011              ,v-trn-doc-status
     7012              ) .
     7013         end.
     7014       end.
     7015     end case .
     7016     return "".
     7017   END FUNCTION.
     7018   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
     7019     ( BUFFER buf_parts FOR ub.parts
     7020     , INPUT p-goods-twounit AS LOGICAL
     7021     ) :
     7022     if p-goods-twounit then do:
     7023       RETURN buf_parts.cli-qnty .
     7024     end.
     7025     else do:
     7026       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
     7027     end.
     7028     RETURN ? .
     7029   END FUNCTION.
     7030   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
     7031     ( BUFFER buf_parts FOR ub.parts
     7032     , INPUT p-goods-twounit AS LOGICAL
     7033     ) :
     7034     if p-goods-twounit then do:
     7035       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
     7036     end.
     7037     else do:
     7038       RETURN buf_parts.cli-base-rate .
     7039     end.
     7040     RETURN ? .
     7041   END FUNCTION.
     7042   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7043   function chkleave returns logical
     7044   (input p-widget-enter as handle
     7045   ,input p-button-list  as character
     7046   ).
     7047     if  valid-handle(p-widget-enter)
     7048     and can-query(p-widget-enter, "name":u)
     7049     and lookup(p-widget-enter :name, p-button-list) > 0
     7050     then do:
     7051       return false .
     7052     end.
     7053     return true .
     7054   end function.
     7055   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7056   function octal-to-char return character
     7057   ( p-string as character ) :
     7058     def var v-asc     as integer no-undo .
     7059     def var v-new-asc as integer no-undo .
     7060     def var ind       as integer no-undo .
     7061     if length(p-string) <> 3 then do:
     7062       return ? .
     7063     end.
     7064     assign
     7065       v-asc = 0
     7066     .
     7067     do ind = 1 to length(p-string)
     7068     :
     7069       assign
     7070         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     7071       .
     7072       if v-new-asc < 0 or v-new-asc >= 8 then do:
     7073         return ? .
     7074       end.
     7075       assign
     7076         v-asc = v-asc * 8 + v-new-asc
     7077       .
     7078     end.
     7079     return chr(v-asc) .
     7080   end function .
     7081   function char-to-octal return character
     7082   ( p-chr as character ) :
     7083     def var v-asc    as integer   no-undo .
     7084     def var ind      as integer   no-undo .
     7085     def var v-string as character no-undo .
     7086     if length(p-chr) <> 1 then do:
     7087       return ? .
     7088     end.
     7089     assign
     7090       v-asc    = asc(p-chr)
     7091       v-string = ""
     7092     .
     7093     do ind = 1 to 3
     7094     :
     7095       assign
     7096         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     7097       .
     7098       assign
     7099         v-asc = truncate(v-asc / 8, 0)
     7100       .
     7101     end.
     7102     return v-string .
     7103   end.
     7104   function str-encode return character
     7105   (   p-init-string       as character
     7106     , p-encode-char       as character
     7107     , p-special-char-list as character
     7108   ) :
     7109     def var p-encode-string as character no-undo .
     7110     def var ind                as integer no-undo .
     7111     def var v-num-special-char as integer no-undo .
     7112     def var v-special-char     as character no-undo .
     7113     if p-encode-char = ?
     7114     or p-encode-char = "" then do:
     7115       assign
     7116         p-encode-char = "~~"
     7117       .
     7118     end.
     7119     if p-init-string = ? then do:
     7120       return "?" .
     7121     end.
     7122     if p-init-string = "?" then do:
     7123       return p-encode-char + char-to-octal("?") .
     7124     end.
     7125     assign
     7126       v-num-special-char = length(p-special-char-list)
     7127       p-encode-string    = replace(p-init-string
     7128                                   ,p-encode-char
     7129                                   ,p-encode-char + char-to-octal(p-encode-char)
     7130                                   )
     7131     .
     7132     do ind = 1 to v-num-special-char
     7133     :
     7134       assign
     7135         v-special-char = substring(p-special-char-list, ind, 1)
     7136       .
     7137       if v-special-char <> p-encode-char then do:
     7138         assign
     7139           p-encode-string = replace (p-encode-string
     7140                                     ,v-special-char
     7141                                     ,p-encode-char + char-to-octal(v-special-char)
     7142                                     )
     7143         .
     7144       end.
     7145     end.
     7146     return p-encode-string .
     7147   end.
     7148   function str-decode returns character
     7149     (p-init-string   as character
     7150     ,p-encode-char   as character
     7151     ) :
     7152     def var p-decode-string as character no-undo .
     7153     def var ind                       as integer no-undo .
     7154     def var v-num-entries-init-string as integer no-undo .
     7155     def var v-sub-phrase              as character no-undo .
     7156     def var v-special-char            as character no-undo .
     7157     if p-encode-char = ?
     7158     or p-encode-char = "" then do:
     7159       assign
     7160         p-encode-char = "~~"
     7161       .
     7162     end.
     7163     if p-init-string = "?" then do:
     7164       return ? .
     7165     end.
     7166     assign
     7167       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     7168     .
     7169     if v-num-entries-init-string > 1 then do:
     7170       assign
     7171         p-decode-string = entry(1, p-init-string, p-encode-char)
     7172       .
     7173       do ind = 2 to v-num-entries-init-string
     7174       :
     7175         assign
     7176           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     7177         .
     7178         assign
     7179           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     7180         .
     7181         if v-special-char <> ? then do:
     7182           assign
     7183             p-decode-string = p-decode-string
     7184                             + v-special-char
     7185                             + substring(v-sub-phrase, 4)
     7186           .
     7187         end.
     7188         else do:
     7189           assign
     7190             p-decode-string = p-decode-string
     7191                             + p-encode-char
     7192                             + v-sub-phrase
     7193           .
     7194         end.
     7195       end.
     7196     end.
     7197     else do:
     7198       assign
     7199         p-decode-string = p-init-string
     7200       .
     7201     end.
     7202     return p-decode-string .
     7203   end.
     7204   procedure check-contract-code :
     7205   define input  parameter parmode           as   character                     no-undo.
     7206   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     7207   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     7208   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     7209   define input  parameter parframe-value    as   character                     no-undo.
     7210   define input  parameter parmenu-handle    as   handle                        no-undo.
     7211   define input  parameter parobj-date       as   date                          no-undo.
     7212   define input  parameter partype-contract  as   character                     no-undo .
     7213   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     7214   define buffer bf_contract     for ub.contract.
     7215   define buffer bf-oth_contract for ub.contract.
     7216   define variable varrid-list as character no-undo.
     7217   define variable varrecid    as recid     no-undo.
     7218   define variable varlog      as logical   no-undo.
     7219   define variable var-args    as char      no-undo.
     7220   define variable var-ext-doc-type as char     no-undo.
     7221   do on error undo, return error return-value :
     7222   var-args = parmode.
     7223   parmode = entry(1, parmode).
     7224   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     7225   if partype-contract = "" or partype-contract = ? then
     7226      partype-contract = 'при':U .
     7227   assign
     7228     parcontract-code = 0
     7229   .
     7230   if parmode = "input":u
     7231   then do:
     7232     if parframe-value = ""
     7233     then do:
     7234       assign
     7235         parcontract-code = 0
     7236       .
     7237     end.
     7238     else do:
     7239       find first bf_contract no-lock
     7240         where bf_contract.host-code         = parhost-code
     7241           and bf_contract.cli-type          = parcli-type
     7242           and bf_contract.cli-code          = parcli-code
     7243           and bf_contract.contract-prn-code = parframe-value
     7244         no-error.
     7245       if available bf_contract
     7246       then do:
     7247         find first bf-oth_contract no-lock
     7248           where bf-oth_contract.host-code          = parhost-code
     7249             and bf-oth_contract.contract-prn-code  = parframe-value
     7250             and bf-oth_contract.cli-type           = parcli-type
     7251             and bf-oth_contract.cli-code           = parcli-code
     7252             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     7253           no-error .
     7254         if available bf-oth_contract
     7255         then do:
     7256           message
     7257             "На фирме " parhost-code skip
     7258             "у контрагента" parcli-type parcli-code skip
     7259             "имеются два контракта с номером" parframe-value skip
     7260           view-as alert-box .
     7261         end.
     7262         else do:
     7263           assign
     7264             parcontract-code = bf_contract.contract-code
     7265           .
     7266         end.
     7267       end.
     7268     end.
     7269   end.
     7270   if parmode <> "input":u
     7271   or parcontract-code = 0
     7272   then do:
     7273     run str/cont-all.w (input parmenu-handle,
     7274                     input parhost-code,
     7275                     input "b-sel",
     7276                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     7277                     input parcli-type,
     7278                     input parcli-code,
     7279                     input ?,
     7280                     input ?,
     7281                     input "current":u,
     7282                     input partype-contract,
     7283                     input-output varrid-list ) no-error.
     7284     if error-status:error then do:
     7285       message "Ошибка при вызове справочника договоров." skip
     7286               return-value                skip
     7287               error-status:get-message(1) skip
     7288               error-status:get-message(2)
     7289       view-as alert-box error.
     7290       return error.
     7291     end.
     7292     assign
     7293       varrecid = integer(entry(1, varrid-list)).
     7294     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     7295     if available bf_contract then do:
     7296       assign
     7297         parcontract-code = bf_contract.contract-code.
     7298     end.
     7299   end.
     7300   if parcontract-code <> 0
     7301   then do:
     7302     if (bf_contract.status_ = 'зкр':U or
     7303         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     7304       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     7305       then do:
     7306           assign
     7307             varlog = no.
     7308           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     7309           view-as alert-box.
     7310           assign
     7311             parcontract-code = 0
     7312           .
     7313       end.
     7314     end.
     7315     if bf_contract.contract-date-beg > parobj-date then do:
     7316       assign
     7317         varlog = no.
     7318       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     7319       view-as alert-box.
     7320       assign
     7321         parcontract-code = 0
     7322       .
     7323     end.
     7324     if parcontract-code <> 0
     7325     then do:
     7326       if bf_contract.cli-type <> parcli-type
     7327       or bf_contract.cli-code <> parcli-code
     7328       then do:
     7329          message "По договору " bf_contract.contract-code
     7330                  ( if bf_contract.doc-type =  'при':U
     7331                    then " поставщиком является "
     7332                    else " покупателем является " )
     7333                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     7334                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     7335          view-as alert-box error.
     7336          assign
     7337            parcontract-code = 0.
     7338       end.
     7339       if parcontract-code <> ? then do:
     7340         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     7341           message "Контракт имеет недопустимый тип." view-as alert-box.
     7342           assign
     7343             parcontract-code = 0.
     7344         end.
     7345       end.
     7346     end.
     7347   end.
     7348   end.
     7349   end procedure.
     7350   procedure cntrcode-get-arg-val:
     7351       def input param p-args as char no-undo.
     7352       def input param p-key as char no-undo.
     7353       def output param p-val as char no-undo.
     7354       def var i as int no-undo.
     7355       def var nums as int no-undo.
     7356       def var key-val as char no-undo.
     7357       nums = num-entries(p-args).
     7358       do i = 1 to nums:
     7359           key-val = entry(i, p-args).
     7360           if key-val begins (p-key + "=") then do:
     7361               p-val = entry(2, key-val, "=").
     7362               return.
     7363           end.
     7364       end.
     7365       p-val = "".
     7366   end.
     7367   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7368   procedure godendo-date-to-offset :
     7369     define input  parameter p-today  as date      no-undo .
     7370     define input  parameter p-date   as date      no-undo .
     7371     define output parameter p-offset as integer   no-undo .
     7372     do
     7373     on error undo, return error return-value
     7374     :
     7375       if p-date  = ?
     7376       or p-today = ?
     7377       then do:
     7378         assign
     7379           p-offset = ?
     7380         .
     7381       end.
     7382       else do:
     7383         assign
     7384           p-offset = p-date - p-today + 1
     7385         .
     7386       end.
     7387     end.
     7388   end procedure.
     7389   procedure godendo-offset-to-date :
     7390     define input  parameter p-today  as date      no-undo .
     7391     define input  parameter p-offset as integer   no-undo .
     7392     define output parameter p-date   as date      no-undo .
     7393     do
     7394     on error undo, return error return-value
     7395     :
     7396       if p-today  = ?
     7397       or p-offset = ?
     7398       then do:
     7399         assign
     7400           p-date = ?
     7401         .
     7402       end.
     7403       else do:
     7404         assign
     7405           p-date = p-offset + p-today - 1
     7406         .
     7407       end.
     7408     end.
     7409   end procedure.
     7410   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7411   procedure sel-date :
     7412     define input  parameter p-date-handle as handle    no-undo .
     7413     define input  parameter p-description as character no-undo .
     7414     do
     7415     on error undo, return error return-value
     7416     :
     7417       if (can-query (p-date-handle, "sensitive")
     7418         and
     7419         p-date-handle :sensitive = true
     7420         )
     7421       or (can-query (p-date-handle, "read-only")
     7422         and
     7423         p-date-handle :read-only = false
     7424         )
     7425       then do:
     7426         if p-date-handle :handle <> focus :handle
     7427         then do:
     7428           apply "entry":u to p-date-handle .
     7429         end.
     7430         define variable v-ok            as logical no-undo .
     7431         define variable v-curr-sv-date as date no-undo .
     7432         assign
     7433           v-curr-sv-date = date(p-date-handle :screen-value) no-error
     7434         .
     7435         if v-curr-sv-date = ?
     7436         then do:
     7437           run gbl/getcurdt.p
     7438             (output v-curr-sv-date
     7439             ) .
     7440         end.
     7441         if v-curr-sv-date <> ?
     7442         then do:
     7443           run gbl/d-inpday.w
     7444             (input ?
     7445             ,input "Выбор даты"
     7446             ,input p-description
     7447             ,input ""
     7448             ,input-output v-curr-sv-date
     7449             ,output v-ok
     7450             ).
     7451           if v-ok = true
     7452           then do:
     7453             assign
     7454               p-date-handle :screen-value = string(v-curr-sv-date) .
     7455             .
     7456           end.
     7457         end.
     7458       end.
     7459     end.
     7460   end procedure.
     7461   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7462   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7463   procedure alc-lib_mark-name :
     7464     define input  parameter p-mark-db-num   as integer   no-undo .
     7465     define input  parameter p-mark-code     as integer   no-undo .
     7466     define output parameter p-mark-name     as character no-undo .
     7467     define buffer buf_ex-mark for ub.ex-mark .
     7468     do
     7469     on error undo, return error return-value
     7470     :
     7471       if p-mark-db-num = ?
     7472       or p-mark-code   = ?
     7473       then do:
     7474         assign
     7475           p-mark-name = '?':u
     7476         .
     7477         return .
     7478       end.
     7479       if  p-mark-db-num = 0
     7480       and p-mark-code   = 0
     7481       then do:
     7482         assign
     7483           p-mark-name = ""
     7484         .
     7485         return .
     7486       end.
     7487       find first buf_ex-mark no-lock
     7488         where buf_ex-mark.db-num    = p-mark-db-num
     7489           and buf_ex-mark.mark-code = p-mark-code
     7490         no-error .
     7491       if available buf_ex-mark
     7492       then do:
     7493         assign
     7494           p-mark-name = substitute('&1':u
     7495                                   ,buf_ex-mark.mark-name
     7496                                   )
     7497         .
     7498       end.
     7499     end.
     7500   end procedure.
     7501   procedure alc-lib_get-new-part-code :
     7502     define input  parameter p-obj-type       as character no-undo .
     7503     define input  parameter p-obj-code       as integer   no-undo .
     7504     define input  parameter p-prod-type      as character no-undo .
     7505     define input  parameter p-prod-code      as integer   no-undo .
     7506     define input  parameter p-artic          as character no-undo .
     7507     define input  parameter p-doc-code       as character no-undo .
     7508     define output parameter p-new-part-code  as character no-undo .
     7509     define variable v-cur-part-code as integer no-undo.
     7510     define variable v-max-part-code as integer no-undo.
     7511     define variable i               as integer no-undo.
     7512     define buffer bf_parts for ub.parts .
     7513     do
     7514     on error undo, return error return-value
     7515     :
     7516       assign
     7517         v-max-part-code = 0
     7518       .
     7519       for each bf_parts no-lock
     7520             where bf_parts.obj-type  = p-obj-type  and
     7521                   bf_parts.obj-code  = p-obj-code  and
     7522                   bf_parts.prod-type = p-prod-type and
     7523                   bf_parts.prod-code = p-prod-code and
     7524                   bf_parts.artic     = p-artic     and
     7525                   bf_parts.out-code  = p-doc-code
     7526         :
     7527         assign
     7528           v-cur-part-code = integer(bf_parts.part-code)
     7529           no-error.
     7530         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     7531           assign
     7532             v-max-part-code = v-cur-part-code
     7533           .
     7534         end.
     7535       end.
     7536       assign
     7537         p-new-part-code = string (v-max-part-code + 1)
     7538       .
     7539     end.
     7540   end procedure.
     7541   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7542   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7543   procedure thbjattr_code :
     7544      define input  parameter p-upper-code     as character no-undo .
     7545      define input  parameter p-code           as character no-undo .
     7546      define output parameter p-label          as character no-undo .
     7547      define output parameter p-user-can-edit  as logical   no-undo .
     7548      define output parameter p-output-display as logical   no-undo .
     7549      define output parameter p-other          as character no-undo .
     7550      define output parameter p-prop-list      as character no-undo .
     7551      define output parameter p-prop-type-list as character no-undo .
     7552      define output parameter p-prop-label-list as character no-undo .
     7553      define output parameter p-global          as logical no-undo .
     7554      define output parameter p-host           as logical no-undo .
     7555      define output parameter p-shop           as logical no-undo .
     7556      define output parameter p-store          as logical no-undo .
     7557      define output parameter p-db             as logical no-undo .
     7558      define variable p-region as logical no-undo.
     7559      run thbjattr_code_reg in this-procedure (
     7560                                               p-upper-code,
     7561                                               p-code,
     7562                                               output p-label,
     7563                                               output p-user-can-edit,
     7564                                               output p-output-display,
     7565                                               output p-other,
     7566                                               output p-prop-list,
     7567                                               output p-prop-type-list,
     7568                                               output p-prop-label-list,
     7569                                               output p-global,
     7570                                               output p-host,
     7571                                               output p-shop,
     7572                                               output p-store,
     7573                                               output p-db,
     7574                                               output p-region
     7575                                               ).
     7576   end procedure.
     7577   procedure thbjattr_code_reg :
     7578   define input  parameter p-upper-code     as character no-undo .
     7579   define input  parameter p-code           as character no-undo .
     7580   define output parameter p-label          as character no-undo .
     7581   define output parameter p-user-can-edit  as logical   no-undo .
     7582   define output parameter p-output-display as logical   no-undo .
     7583   define output parameter p-other          as character no-undo .
