     8381   procedure lineattr-delete-flora-gds :
     8382     do
     8383     on error undo, return error return-value
     8384     :
     8385       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     8386       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8387       define input  parameter p-prt-code    as integer   no-undo .
     8388       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     8389       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     8390       define output parameter p-deleted  as logical no-undo.
     8391       define buffer buf_doc-line-attr for ub.doc-line-attr .
     8392       find first buf_doc-line-attr exclusive-lock
     8393         where buf_doc-line-attr.doc-code  = p-doc-code
     8394           and buf_doc-line-attr.gds-code  = p-gds-code
     8395           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     8396         no-error NO-WAIT.
