    11576   ON CHOOSE OF b-marking IN FRAME Dialog-Frame
    11577   DO:
    11578       define buffer buf_parts for ub.parts .
    11579   define variable p-mode as char no-undo.
    11580   p-mode = 'ПРОСМОТР':U.
    11581   if not available parts then do:
    11582       message
    11583       "Нет партий по товару"
    11584       view-as alert-box.
    11585       return no-apply.
    11586   end.
    11587   define buffer buf_goods for ub.goods .
    11588   define buffer buf_marking-lines for ub.marking-lines .
    11589   define buffer buf_marking for ub.marking .
    11590   define buffer  buf_marking-lines-parent for ub.marking-lines .
    11591   find first buf_goods no-lock where buf_goods.artic = parts.artic and buf_goods.prod-code = parts.prod-code and buf_goods.prod-type = parts.prod-type no-error .
    11592   if available (buf_goods) then do:
    11593       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_goods.gds-code and
    11594                                                buf_marking-lines.in-code = parts.in-code and
    11595                                                buf_marking-lines.out-code = parts.out-code and
    11596                                                buf_marking-lines.part-code = parts.part-code and
    11597                                                buf_marking-lines.prt-code = parts.prt-code and
    11598                                                buf_marking-lines.obj-code = parts.obj-code and
    11599                                                buf_marking-lines.obj-type = parts.obj-type:
    11600         for each buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark :
    11601           create tt-marking-lines .
    11602           assign
    11603             tt-marking-lines.stts        = StatusTHName(buf_marking.sts)
    11604             tt-marking-lines.gds-name    = buf_goods.gds-name
    11605             tt-marking-lines.mark        = buf_marking.mark
    11606             tt-marking-lines.mark-parent = buf_marking.mark-parent
    11607             tt-marking-lines.gds-code    = buf_marking-lines.gds-code
    11608             tt-marking-lines.sts         = buf_marking.sts
    11609             tt-marking-lines.unit        = buf_marking.unit
    11610             tt-marking-lines.unit-ext    = buf_marking.unit-ext
    11611             tt-marking-lines.box-qnty    = buf_marking.box-qnty
    11612             tt-marking-lines.doc-level   = buf_marking-lines.doc-level
    11613             tt-marking-lines.in-code     = parts.in-code
    11614             tt-marking-lines.out-code    = parts.out-code
    11615             tt-marking-lines.obj-code    = parts.obj-code
    11616             tt-marking-lines.obj-type    = parts.obj-type
    11617             tt-marking-lines.prt-code    = parts.prt-code
    11618             .
    11619             if buf_marking.sts = 10
    11620             then do:
    11621               if buf_marking.mark-parent <> ""
    11622               then do :
    11623                 find first buf_marking-lines-parent no-lock where buf_marking-lines-parent.mark = buf_marking.mark-parent
    11624                                                               and buf_marking-lines-parent.gds-code = buf_marking-lines.gds-code
    11625                                                               and buf_marking-lines-parent.obj-type = buf_marking-lines.obj-type
    11626                                                               and buf_marking-lines-parent.obj-code = buf_marking-lines.obj-code
    11627                                                               and buf_marking-lines-parent.in-code  = buf_marking-lines.in-code
    11628                                                               and buf_marking-lines-parent.out-code = buf_marking-lines.out-code
    11629                                                               and buf_marking-lines-parent.part-code = buf_marking-lines.part-code
    11630                                                               and buf_marking-lines-parent.prt-code = buf_marking-lines.prt-code
    11631                                                               and buf_marking-lines-parent.doc-level > 0
    11632                                                               no-error .
    11633                 if available buf_marking-lines-parent
    11634                 then do :
    11635                   tt-marking-lines.doc-level = 2 .
    11636                 end .
    11637                 else do :
    11638                   tt-marking-lines.doc-level = 1 .
    11639                 end .
    11640               end .
    11641               else tt-marking-lines.doc-level = 1 .
    11642             end.
    11643         end.
    11644       end.
    11645   end.
    11646         run str/mark_browse.w (input parparentproc,
    11647           input-output table tt-marking-lines,
    11648           input "",
    11649           input "Марки по: " + "По партии №" + string (parts.part-code) + " по товару - " + string(buf_goods.gds-code) + " " + string (buf_goods.gds-name),
    11650           input 0,
    11651           input ""
    11652           ) no-error .
    11653           empty temp-table tt-marking-lines .
    11654   END.
