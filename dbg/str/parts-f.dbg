    14525   PROCEDURE enable_UI :
    14526     OPEN QUERY Dialog-Frame FOR EACH parts SHARE-LOCK.
    14527     GET FIRST Dialog-Frame.
    14528     DISPLAY fi-vat-pc fi-slt-pc fi-last-date-offset fi-contract-prn-code
    14529             tot-price-cli tot-price-rubl tot-price-base fi-price-prod
    14530             fi-price-prodvat FI-goods-artic fi-gds-name FI-goods-prod-type-code
    14531             FI-clients-name FI-b-code fi-out-code FI-label-kolichestvo
    14532             FI-label-ed-izm FI-label-koefficient fi-unit-cli fi-unit fi-unit-2
    14533             fi-vat-type fi-slt-type fi-supp fi-contract-name FI-label-cena
    14534             FI-label-summa FI-label-val val-price-cli val-rubl-code val-price-rubl
    14535             val-base-code val-price-base
    14536         WITH FRAME Dialog-Frame.
    14537     IF AVAILABLE parts THEN
    14538       DISPLAY parts.PS parts.cli-qnty parts.cli-base-rate parts.qnty parts.fact-qnty
    14539             parts.part-code parts.cst-code parts.supp-type parts.supp-code
    14540             parts.last-date parts.price-cli parts.exch-code parts.price-rubl
    14541             parts.price-base
    14542         WITH FRAME Dialog-Frame.
    14543     ENABLE b-exit b-quit b-prev b-next b-alc-attr b-help RECT-2 RECT-3 RECT-4
    14544            RECT-1 parts.PS fi-vat-pc fi-slt-pc parts.supp-type parts.supp-code
    14545            r-supp parts.last-date b-choose-last-date fi-last-date-offset
    14546            fi-contract-prn-code r-contract b-edit-price fi-price-prod
    14547            fi-price-prodvat FI-goods-artic fi-gds-name FI-goods-prod-type-code
    14548            FI-clients-name FI-b-code fi-out-code FI-label-kolichestvo
    14549            FI-label-ed-izm FI-label-koefficient fi-unit-cli fi-unit fi-unit-2
    14550            fi-vat-type fi-slt-type fi-supp fi-contract-name FI-label-cena
    14551            FI-label-summa FI-label-val val-price-cli val-rubl-code val-price-rubl
    14552            val-base-code val-price-base
    14553         WITH FRAME Dialog-Frame.
    14554     VIEW FRAME Dialog-Frame.
    14555   END PROCEDURE.
    14556   PROCEDURE guess-parts-qnty :
    14557     define parameter buffer buf_doc-line for ub.doc-line .
    14558     define buffer buf_trn-doc for ub.trn-doc .
    14559     define output parameter p-guess-qnty as decimal no-undo .
    14560       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
    14561     run partrqst in this-procedure
    14562       (input  buf_doc-line.doc-code
    14563       ,input  buf_doc-line.obj-type
    14564       ,input  buf_doc-line.obj-code
    14565       ,input  buf_doc-line.artic
    14566       ,input  buf_doc-line.prod-type
    14567       ,input  buf_doc-line.prod-code
    14568           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
    14569       ).
    14570     case v-enable-qnty :
    14571       when "qnty":u
    14572       then do:
    14573         define variable v-chg-qnty as decimal   no-undo .
    14574         if valid-handle(h-call-prog)
    14575         then do:
    14576           run get-attr-chg-qnty in h-call-prog
    14577             (output v-chg-qnty).
    14578         end.
    14579         define variable v-doc-line-qnty as decimal   no-undo .
    14580         find first buf_trn-doc no-lock
    14581           where buf_trn-doc.doc-code = buf_doc-line.doc-code
    14582           .
    14583         if buf_trn-doc.doc-type = 'инв':U
    14584         then do:
    14585           assign
    14586             v-doc-line-qnty = buf_doc-line.fact-qnty
    14587           .
    14588         end.
    14589         else do:
    14590           assign
    14591             v-doc-line-qnty = buf_doc-line.doc-qnty
    14592           .
    14593         end.
    14594         assign
    14595           p-guess-qnty = max(0, v-doc-line-qnty + v-chg-qnty  - v-total-parts-qnty)
    14596         .
    14597       end.
    14598       when "fact-qnty":u
    14599       then do:
    14600         assign
    14601           p-guess-qnty = max(0, buf_doc-line.fact-qnty - v-total-parts-fact-qnty)
    14602         .
    14603       end.
    14604       when "cli-qnty":u
    14605       then do:
    14606         assign
    14607           p-guess-qnty = max(0, buf_doc-line.cli-qnty  - v-total-parts-cli-qnty)
    14608         .
    14609       end.
    14610     end.
    14611   END PROCEDURE.
    14612   PROCEDURE main-block-procedure :
    14613     define variable v-host-code as integer   no-undo .
    14614     do
    14615     on error   undo , return error
    14616     on end-key undo , return error
    14617     :
    14618       define buffer buf_doc-line for ub.doc-line .
    14619       define buffer buf_goods    for ub.goods .
    14620       find first buf_goods no-lock
    14621         where buf_goods.gds-code = p-gds-code
    14622         no-error .
    14623       if not available buf_goods
    14624       then do:
    14625         message
    14626           vss-workfile vss-revision vss-description skip
    14627           "Ошибка задания входных параметров" skip
    14628           "Не найден товар" skip
    14629           "Документ" p-doc-code skip
    14630           "Код товара" p-gds-code skip
    14631           view-as alert-box error .
    14632         undo, return error .
    14633       end.
    14634       find first buf_doc-line no-lock
    14635         where buf_doc-line.doc-code  = p-doc-code
