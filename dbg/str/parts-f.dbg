     9500   def var vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9501   def var vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9502   def var vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9503   function AddUtdErrForTab returns logical
     9504   (idb-num         as integer ,
     9505    idoc-id         as integer ,
     9506    iTab            as character,
     9507    iObj            as handle ,
     9508    iCheckType      as character,
     9509    iCodeErr        as character,
     9510    iCheckObj       as character ):
     9511      define buffer utd-err for utd-err.
     9512      define buffer utd for utd.
     9513      find first utd where utd.db-num     eq idb-num
     9514                       and utd.doc-id     eq idoc-id
     9515                       and utd.Direction  eq 'Outbound'
     9516      no-lock no-error.
     9517      if available utd
     9518      then
     9519         return no.
     9520      define variable vRecKey as character no-undo.
     9521            run gen-key-rec (input iTab,
     9522                             input  iObj,
     9523                             output vRecKey).
     9524      find first utd-err where utd-err.db-num     eq idb-num
     9525                           and utd-err.doc-id     eq idoc-id
     9526                           and utd-err.CheckType  eq iCheckType
     9527                           and utd-err.CodeErr    eq iCodeErr
     9528                           and utd-err.CheckObj   eq iCheckObj
     9529      exclusive-lock no-error.
     9530      if not available utd-err
     9531      then do:
     9532         create utd-err.
     9533         assign
     9534            utd-err.db-num         = idb-num
     9535            utd-err.doc-id         = idoc-id
     9536            utd-err.CheckType      = iCheckType
     9537            utd-err.CodeErr        = iCodeErr
     9538            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     9539            utd-err.reckey         = vRecKey
     9540            utd-err.qnty           = 1
     9541         .
     9542      end.
     9543      else
     9544         utd-err.qnty = utd-err.qnty + 1.
     9545      return utd-err.qnty eq 1.
     9546   end.
     9547   function AddUtdErr returns logical
     9548   (idb-num         as integer ,
     9549    idoc-id         as integer ,
     9550    iObj            as handle ,
     9551    iCheckType      as character,
     9552    iCodeErr        as character,
     9553    iCheckObj       as character ):
     9554      AddUtdErrForTab
     9555         (idb-num,
     9556          idoc-id,
     9557          iObj:table,
     9558          iObj,
     9559          iCheckType,
     9560          iCodeErr,
     9561          iCheckObj).
     9562   end.
     9563   function ClearUtdErrTypeCode returns logical
     9564   (idb-num         as integer,
     9565    idoc-id         as integer ,
     9566    iCheckType      as character,
     9567    iCodeErr        as character
     9568    ):
     9569      define buffer utd-err for utd-err.
     9570      if    iCheckType eq "*"
     9571         or iCheckType eq ?
     9572      then do:
     9573         if     iCodeErr ne ?
     9574            and iCodeErr ne "*"
     9575         then
     9576            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     9577            view-as alert-box.
     9578         else
     9579         for each utd-err where utd-err.db-num  eq idb-num
     9580                            and utd-err.doc-id  eq idoc-id
     9581         exclusive-lock:
     9582            delete utd-err.
     9583         end.
     9584      end.
     9585      else do:
     9586         if    iCodeErr eq ?
     9587            or iCodeErr eq "*"
     9588         then do:
     9589            for each utd-err where utd-err.db-num     eq idb-num
     9590                               and utd-err.doc-id     eq idoc-id
     9591                               and utd-err.CheckType  eq iCheckType
     9592            exclusive-lock:
     9593               delete utd-err.
     9594            end.
     9595         end.
     9596         else do:
     9597            for each utd-err where utd-err.db-num     eq idb-num
     9598                               and utd-err.doc-id     eq idoc-id
     9599                               and utd-err.CheckType  eq iCheckType
     9600                               and ub.utd-err.CodeErr eq iCodeErr
     9601            exclusive-lock:
     9602               delete utd-err.
     9603            end.
     9604         end.
     9605      end.
     9606   end.
     9607   function ClearUtdErr returns logical
     9608   (idb-num         as integer,
     9609    idoc-id         as integer ,
     9610    iCheckType      as character
     9611    ):
     9612      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     9613   end.
     9614   function GetMesError returns character
     9615   (itxt as character,
     9616    iobj as character ):
     9617    define variable vi as integer no-undo.
     9618    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     9619       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     9620    end.
     9621    return itxt.
     9622   end.
     9623   function GetTextErrorType returns character
     9624   (iCheckType as character,
     9625    iCodeErr   as character,
     9626    iChechObj  as character,
     9627    iType      as character  ):
     9628      define buffer code    for code.
     9629      define variable vError as character no-undo.
     9630      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     9631                        and code.code   eq iCodeErr
     9632      no-lock no-error.
     9633      if available code
     9634      then do:
     9635         define variable vType as integer no-undo.
     9636         if code.misc3 eq "error"
     9637         then
     9638            vType = 0.
     9639         else if code.misc3 eq "warning"
     9640         then
     9641            vType = 1.
     9642         else if code.misc3 eq "Hiden"
     9643         then
     9644            vType = 2.
     9645         else
     9646            vtype = int(code.misc3) no-error.
     9647         case itype:
     9648            when "error"
     9649            then do:
     9650               if vtype eq 0
     9651               then
     9652                  vError = GetMesError(Code.CodeValue,iChechObj).
     9653            end.
     9654            when "warning"
     9655            then do:
     9656               if vtype <= 1
     9657               then
     9658                  vError = GetMesError(Code.CodeValue,iChechObj).
     9659            end.
     9660            otherwise do:
     9661               vError = GetMesError(Code.CodeValue,iChechObj).
     9662            end.
     9663         end.
     9664      end.
     9665      else
     9666         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     9667      return vError.
     9668   end.
     9669   function GetTypeError returns integer
     9670   (iCheckType as character,
     9671    iCodeErr   as character):
     9672      define buffer code    for code.
     9673      define variable vType as integer no-undo.
     9674      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     9675                        and code.code   eq iCodeErr
     9676      no-lock no-error.
     9677      if     not available code
     9678         and code.misc3 eq "error"
     9679      then
     9680         vType = 0.
     9681      else if code.misc3 eq "warning"
     9682      then
     9683         vType = 1.
     9684      else if code.misc3 eq "Hiden"
     9685      then
     9686         vType = 2.
     9687      else
     9688         vtype = int(code.misc3) no-error.
     9689      return vtype.
     9690   end.
     9691   function GetTextError returns character
     9692   (iCheckType as character,
     9693    iCodeErr   as character,
     9694    iChechObj  as character ):
     9695      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     9696   end.
     9697   function GetErrForUtdStr returns character
     9698   (idb-num     as integer ,
     9699    idoc-id     as integer ,
     9700    iCheckType  as character
     9701    ):
     9702      define buffer utd-err for utd-err.
     9703      define buffer code    for code.
     9704      define variable vHQry as handle no-undo.
     9705      define variable vError as longchar no-undo.
     9706      define variable vErrorOne as longchar  no-undo.
     9707      define variable oError as character no-undo.
     9708      create query vHQry.
     9709      vHQry:set-buffers(buffer utd-err:handle).
     9710      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     9711                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     9712                               + if    iCheckType eq "*"
     9713                                    or iCheckType eq ?
     9714                                 then       ""
     9715                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     9716      vHQry:query-open().
     9717      vHQry:get-first().
     9718      QRY-BLOCK:
     9719      repeat while not vHQry:query-off-end:
     9720         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     9721         if     vErrorOne ne ""
     9722            and vErrorOne ne ?
     9723         then
     9724            vError = vError + ", " + vErrorOne.
     9725         vHQry:get-next().
     9726      end.
     9727      oError = substring(vError,3,4002).
     9728      return oError.
     9729   end.
     9730   function GetErrJsonForUtd returns character
     9731   (idb-num         as integer ,
     9732    idoc-id         as integer ,
     9733    iCheckType      as character
     9734    ):
     9735      define buffer utd-err for utd-err.
     9736      define variable vHQry as handle no-undo.
     9737      define variable vError as longchar no-undo.
     9738      define variable oError as character no-undo.
     9739      create query vHQry.
     9740      define variable vi as integer no-undo.
     9741      vHQry:set-buffers(buffer utd-err:handle).
     9742      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     9743                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     9744                               + if    iCheckType eq "*"
     9745                                    or iCheckType eq ?
     9746                                 then       ""
     9747                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     9748      vHQry:query-open().
     9749      vHQry:get-first().
     9750      QRY-BLOCK:
     9751      repeat while not vHQry:query-off-end:
     9752         define variable vErrorOne as character no-undo.
     9753         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     9754         if     vErrorOne ne ?
     9755            and vErrorOne ne ""
     9756         then do:
     9757            vi = vi + 1.
     9758            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     9759                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     9760                            + '","ТекстОш":"' + vErrorOne + '"}'.
     9761         end.
     9762         vHQry:get-next().
     9763      end.
     9764      for first utd where utd.db-num eq idb-num
     9765                      and utd.doc-id eq idoc-id
     9766                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     9767      no-lock,
     9768         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     9769                                  and utd-marking-lines.doc-id eq idoc-id
     9770                                  and utd-marking-lines.doc-level eq 1
     9771      no-lock,
     9772         first marking where marking.mark eq utd-marking-lines.mark
     9773                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     9774      no-lock:
     9775         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     9776         if     vErrorOne ne ?
     9777            and vErrorOne ne ""
     9778         then do:
     9779            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     9780                            + '","ОбъектОш":"' + marking.mark
     9781                            + '","ТекстОш":"' + vErrorOne + '"}'.
     9782         end.
     9783      end.
     9784      if vError ne ""
     9785      then
     9786         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     9787      return oError.
     9788   end.
     9789   function GetErrJsonForUtdReturn returns character
     9790   (idb-num         as integer ,
     9791    idoc-id         as integer ,
     9792    iCheckType      as character
     9793    ):
     9794      define buffer utd-err for utd-err.
     9795      define variable vHQry as handle no-undo.
     9796      define variable vError as longchar no-undo.
     9797      define variable oError as character no-undo.
     9798      define variable vi as integer no-undo.
     9799      create query vHQry.
     9800      vHQry:set-buffers(buffer utd-err:handle).
     9801      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     9802                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     9803                               + if    iCheckType eq "*"
     9804                                    or iCheckType eq ?
     9805                                 then       ""
     9806                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     9807      vHQry:query-open().
     9808      vHQry:get-first().
     9809      QRY-BLOCK:
     9810      repeat while not vHQry:query-off-end:
     9811         define variable vErrorOne as character no-undo.
     9812         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     9813         if     vErrorOne ne ?
     9814            and vErrorOne ne ""
     9815         then do:
     9816            vi = vi + 1.
     9817            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     9818                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     9819                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     9820         end.
     9821         vHQry:get-next().
     9822      end.
     9823      if vError ne ""
     9824      then
     9825         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     9826      return oError.
     9827   end.
     9828   function GetCodeTextError returns character
     9829   (iCheckType as character,
     9830    iCodeErr   as character,
     9831    iChechObj  as character,
     9832    output oCode as character,
     9833    output ovalue as character ):
     9834      define buffer code    for code.
     9835      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     9836                        and code.code   eq iCodeErr
     9837      no-lock no-error.
     9838      if     available code
     9839      then do:
     9840         define variable vi as integer no-undo init ?.
     9841         vi = int(Code.misc3) no-error.
     9842         if    code.misc3 ne "error"
     9843            and vi ne 0
     9844         then
     9845            oCode = ?.
     9846         else if     Code.misc1 ne ?
     9847                 and Code.misc1 ne ""
     9848         then
     9849            assign
     9850               oCode  = GetMesError(Code.misc1,iChechObj)
     9851               ovalue = GetMesError(Code.misc2,iChechObj)
     9852            .
     9853      end.
     9854      return if oCode eq ""
     9855             then ""
     9856             else (oCode + "_" + ovalue).
     9857   end.
     9858   define temp-table TT-err no-undo
     9859     field code_ as character
     9860     field text_ as character
     9861   index code_ code_.
     9862   function GetErrTxtForUtd returns character
     9863   (idb-num         as integer ,
     9864    idoc-id         as integer ,
     9865    iCheckType      as character
     9866    ):
     9867      define buffer utd-err for utd-err.
     9868      define variable vHQry as handle no-undo.
     9869      define variable oError as character no-undo.
     9870      create query vHQry.
     9871      define variable vi as integer no-undo.
     9872      for each tt-err :
     9873         delete tt-err.
     9874      end.
     9875      vHQry:set-buffers(buffer utd-err:handle).
     9876      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     9877                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     9878                               + if    iCheckType eq "*"
     9879                                    or iCheckType eq ?
     9880                                 then       ""
     9881                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     9882      vHQry:query-open().
     9883      vHQry:get-first().
     9884      define variable vcode as character no-undo.
     9885      define variable vvalue as character no-undo.
     9886      QRY-BLOCK:
     9887      repeat while not vHQry:query-off-end:
     9888         vi = vi + 1.
     9889         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     9890         if vcode ne ?
     9891         then do:
     9892            find first tt-err where tt-err.code eq vcode
     9893            no-error.
     9894            if not available tt-err
     9895            then do:
     9896               create tt-err.
     9897               assign
     9898                  tt-err.code_ = vcode
     9899                  tt-err.text_ = vvalue
     9900               .
     9901            end.
     9902            else
     9903               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     9904         end.
     9905         vHQry:get-next().
     9906      end.
     9907     find first utd where utd.db-num eq idb-num
     9908                         and utd.doc-id eq idoc-id
     9909         no-lock.
     9910      define buffer cancel_utd-lines for utd-lines.
     9911      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     9912                                  and cancel_utd-lines.doc-id eq idoc-id
     9913      no-lock:
     9914         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     9915         then do:
     9916            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     9917                                        and utd-marking-lines.doc-id eq idoc-id
     9918                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     9919            no-lock,
     9920               first marking where marking.mark eq utd-marking-lines.mark
     9921                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     9922            no-lock:
     9923               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     9924               find first tt-err where tt-err.code eq vcode
     9925               no-error.
     9926               if not available tt-err
     9927               then do:
     9928                  create tt-err.
     9929                  assign
     9930                     tt-err.code_ = vcode
     9931                     tt-err.text_ = vvalue
     9932                  .
     9933               end.
     9934               else
     9935                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     9936            end.
     9937         end.
     9938         else do:
     9939            define variable vqnty as decimal no-undo.
     9940            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     9941            if vqnty eq ? then vqnty = 0.
     9942            if vqnty ne cancel_utd-lines.Quantity
     9943            then do:
     9944               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     9945               find first tt-err where tt-err.code eq vcode
     9946               no-error.
     9947               if not available tt-err
     9948               then do:
     9949                  create tt-err.
     9950                  assign
     9951                     tt-err.code_ = vcode
     9952                     tt-err.text_ = vvalue
     9953                  .
     9954               end.
     9955               else
     9956                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     9957            end.
     9958         end.
     9959      end.
     9960      for each tt-err:
     9961         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     9962      end.
     9963      return oError.
     9964   end.
     9965   define variable mFormatErr as character no-undo init "text".
     9966   function GetErrForUtd returns character
     9967   (idb-num         as integer ,
     9968    idoc-id         as integer ,
     9969    iType           as character
     9970    ):
     9971      if mFormatErr eq "text"
     9972      then
     9973         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     9974      else do:
     9975         if itype eq "return"
     9976         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     9977         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     9978      end.
     9979   end.
     9980   function GetErrComText returns longchar
     9981   (icomment as character,
     9982    itext    as longchar ):
     9983       define variable vText as longchar no-undo.
     9984      if mFormatErr eq "text"
     9985      then do:
     9986         if icomment ne ""
     9987         then
     9988            icomment = substitute("comment:|&1|",icomment).
     9989         vText = icomment + itext.
     9990      end.
     9991      else do:
     9992         icomment = if icomment begins  '"'
     9993                    then icomment
     9994                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     9995         vText = icomment + "," + itext.
     9996         vText = "~{" + trim(vText,",") + "~}".
     9997      end.
     9998      return vText.
     9999   end.
    10000   function CheckTypeForMarkLineType returns logical
    10001   (iObj            as handle,
    10002    iCheckType      as character,
    10003    iCodeErr        as character ,
    10004    iTypeErr        as character ):
    10005      define variable vRecKey-markLine as character no-undo.
    10006      define variable vGoodMark        as logical no-undo.
    10007      define variable vdb-num          as integer no-undo.
    10008      define variable vdoc-id          as integer no-undo.
    10009      define variable vlinenum         as integer no-undo.
    10010      define variable vErrorOne as character no-undo.
    10011      define buffer buf_utd-err for utd-err.
    10012      run gen-key-rec (input "utd-marking-lines",
    10013                       input  iObj,
    10014                       output vRecKey-markLine).
    10015      vGoodMark = yes.
    10016      vdb-num = iObj::db-num.
    10017      vdoc-id = iObj::doc-id.
    10018      vlinenum = iObj::linenum.
    10019      block-mark-err:
    10020      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10021                               and buf_utd-err.db-num = vdb-num
    10022                               and buf_utd-err.reckey = vRecKey-markLine
    10023                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10024                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10025      no-lock:
    10026         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10027         if     vErrorOne ne ?
    10028            and vErrorOne ne ""
    10029         then do:
    10030            vGoodMark = no.
    10031            leave block-mark-err.
    10032         end.
    10033      end.
    10034      return not vGoodMark.
    10035   end.
    10036   function CheckErrForMarkLineType returns logical
    10037   (iObj            as handle,
    10038    iType           as character  ):
    10039      return CheckTypeForMarkLineType (iObj,iType,"*","error").
    10040   end.
    10041   function CheckErrForMarkLine returns logical
    10042   (iObj            as handle):
    10043      return CheckErrForMarkLineType(iObj,"*").
    10044   end.
    10045   function CheckErrForLineTypeCode returns logical
    10046   (iObj                 as handle,
    10047    iCheckType           as character,
    10048    iCodeErr             as character,
    10049    iTypeErr             as character,
    10050    iOneErr              as logical):
    10051      define variable vRecKey-line     as character no-undo.
    10052      define buffer buf_utd-err for utd-err.
    10053      define variable vUtdlineError as logical no-undo.
    10054      define variable vErrorOne as character no-undo.
    10055            run gen-key-rec (input "utd-lines",
    10056                             input  iObj,
    10057                             output vRecKey-line).
    10058         define variable vdb-num as integer no-undo.
    10059         define variable vdoc-id as integer no-undo.
    10060         define variable vlinenum as integer no-undo.
    10061         vdb-num = iObj::db-num.
    10062         vdoc-id = iObj::doc-id.
    10063         vlinenum = iObj::linenum.
    10064         block-err:
    10065         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10066                                  and buf_utd-err.db-num = vdb-num
    10067                                  and buf_utd-err.reckey = vRecKey-line
    10068                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
    10069                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
    10070         no-lock:
    10071            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
    10072            if     vErrorOne ne ?
    10073               and vErrorOne ne ""
    10074            then do:
    10075               vUtdlineError = yes.
    10076               leave block-err.
    10077            end.
    10078         end.
    10079         if  not vUtdlineError
    10080         then do:
    10081            define variable vGoodMark as logical no-undo.
    10082            vGoodMark = yes.
    10083            block-line-err:
    10084            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
    10085                                         and utd-marking-lines.doc-id  eq vdoc-id
    10086                                         and utd-marking-lines.LineNum eq vLineNum
    10087            no-lock:
    10088               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
    10089               if     vGoodMark
    10090                  and iOneErr eq no
    10091               then
    10092                  leave block-line-err.
    10093               if     iOneErr = yes
    10094                  and not vGoodMark
    10095               then
    10096                  leave block-line-err.
    10097            end.
    10098            vUtdlineError = not vGoodMark.
    10099         end.
    10100      return vUtdlineError.
    10101   end.
    10102   function getErrForLineType returns character
    10103   (iObj            as handle,
    10104    iType           as character  ):
    10105      define variable vRecKey-line     as character no-undo.
    10106      define buffer buf_utd-err for utd-err.
    10107      define variable vUtdlineError as logical no-undo.
    10108      define variable vErrorOne as character no-undo.
    10109      define variable oError as character no-undo.
    10110            run gen-key-rec (input "utd-lines",
    10111                             input  iObj,
    10112                             output vRecKey-line).
    10113         define variable vdb-num as integer no-undo.
    10114         define variable vdoc-id as integer no-undo.
    10115         define variable vlinenum as integer no-undo.
    10116         vdb-num = iObj::db-num.
    10117         vdoc-id = iObj::doc-id.
    10118         vlinenum = iObj::linenum.
    10119         block-err:
    10120         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
    10121                                  and buf_utd-err.db-num = vdb-num
    10122                                  and buf_utd-err.reckey = vRecKey-line
    10123                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
    10124         no-lock:
    10125            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
    10126            if     vErrorOne ne ?
    10127               and vErrorOne ne ""
    10128            then do:
    10129               oError = oError + vErrorOne + " ".
    10130            end.
    10131         end.
    10132      return oError.
    10133   end.
    10134   function CheckErrForLineType returns logical
    10135   (iObj            as handle,
    10136    iType           as character  ):
    10137       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
    10138   end.
    10139   function CheckErrForLine returns logical
    10140   (iObj            as handle):
    10141      return CheckErrForLineType(iobj,"*").
    10142   end.
    10143   function CheckErrForUtd returns logical
    10144   (idb-num         as integer ,
    10145    idoc-id         as integer ):
    10146      for each utd-lines where utd-lines.db-num eq idb-num
    10147                           and utd-lines.doc-id eq idoc-id
    10148      no-lock :
    10149         if not CheckErrForLine (buffer ub.utd-lines:handle)
    10150         then
    10151            return no.
    10152      end.
    10153      return yes.
    10154   end.
    10155   function CheckMarkUtd-28rel return logical
    10156    (input idb-num as integer,
    10157    input idoc-id as integer):
    10158    define buffer utd                   for utd.
    10159    define buffer utd-lines             for utd-lines.
    10160    define buffer utd-marking-lines     for utd-marking-lines.
    10161    define variable v-par-type as character no-undo.
    10162    define variable vgdsNoMark as logical no-undo.
    10163    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10164      define variable v-par-val  as character no-undo.
    10165      find first utd where utd.db-num eq idb-num
    10166                       and utd.doc-id eq idoc-id
    10167      no-lock no-error.
    10168      if available utd
    10169      then do:
    10170         if     utd.obj-code ne ?
    10171            and utd.obj-type ne ?
    10172         then do:
    10173            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10174            Block-utd-lines:
    10175            for each utd-lines where utd-lines.db-num eq idb-num
    10176                                 and utd-lines.doc-id eq idoc-id
    10177            no-lock:
    10178               if     utd-lines.gds-code ne ?
    10179                  and utd-lines.gds-code ne 0
    10180               then do:
    10181                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10182                       ( utd-lines.gds-code,
    10183                         'mark-type':U,
    10184                          output v-par-val,
    10185                          output v-par-type
    10186                       ).
    10187                  if     EDOParSec:IsEdo
    10188                     and EDOParSec:GetIsEDOForType(v-par-val)
    10189                  then do:
    10190                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
    10191                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
    10192                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
    10193                                                    and length(utd-marking-lines.mark) > 13
    10194                     no-lock no-error.
    10195                     if     avail utd-marking-lines
    10196                        and not CheckErrForLine(buffer utd-lines:handle)
    10197                     then
    10198                        leave Block-utd-lines.
    10199                  end.
    10200                  else
    10201                     vgdsNoMark = yes.
    10202               end.
    10203            end.
    10204            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
    10205            if vgdsNoMark then return available utd-lines . else return yes .
    10206         end.
    10207      end.
    10208      return yes.
    10209   end.
    10210   function CheckMarkUtd return logical
    10211    (input idb-num  as integer,
    10212     input idoc-id  as integer):
    10213     define buffer utd-lines             for ub.utd-lines.
    10214     block-line:
    10215     for each utd-lines where utd-lines.db-num eq idb-num
    10216                          and utd-lines.doc-id eq idoc-id
    10217     no-lock:
    10218        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
    10219        then
    10220           leave block-line.
    10221     end.
    10222     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
    10223     return available utd-lines.
    10224   end.
    10225   function CheckNotMarkUtd return logical
    10226    (input idb-num  as integer,
    10227     input idoc-id  as integer):
    10228     define buffer utd-lines             for ub.utd-lines.
    10229     for each utd-lines where utd-lines.db-num eq idb-num
    10230                          and utd-lines.doc-id eq idoc-id
    10231     no-lock:
    10232        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    10233        then
    10234           return yes.
    10235     end.
    10236     return no.
    10237   end.
    10238   function CheckMarkUtdLine return logical
    10239    (input idb-num  as integer,
    10240     input idoc-id  as integer,
    10241     input iLineNum as integer):
    10242    define buffer utd                   for utd.
    10243    define buffer utd-lines             for utd-lines.
    10244    define buffer utd-marking-lines     for utd-marking-lines.
    10245    define variable v-par-type as character no-undo.
    10246    define variable vMarking        as logical no-undo.
    10247    define variable vArtic          as logical no-undo.
    10248    define variable vTransitional   as logical no-undo.
    10249    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10250      define variable v-par-val  as character no-undo.
    10251      find first utd where utd.db-num eq idb-num
    10252                       and utd.doc-id eq idoc-id
    10253      no-lock no-error.
    10254      if available utd
    10255      then do:
    10256         if     utd.obj-code ne ?
    10257            and utd.obj-type ne ?
    10258         then do:
    10259            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
    10260            Block-utd-lines:
    10261            for each utd-lines where utd-lines.db-num   eq idb-num
    10262                                 and utd-lines.doc-id   eq idoc-id
    10263                                 and utd-lines.LineNum  eq iLineNum
    10264            no-lock:
    10265               if     utd-lines.gds-code ne ?
    10266                  and utd-lines.gds-code ne 0
    10267               then do:
    10268                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10269                       ( utd-lines.gds-code,
    10270                         'mark-type':U,
    10271                          output v-par-val,
    10272                          output v-par-type
    10273                       ).
    10274                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
    10275                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
    10276                  if vMarking
    10277                  then do:
    10278                     block-marking:
    10279                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10280                                                    and utd-marking-lines.doc-id   eq idoc-id
    10281                                                    and utd-marking-lines.LineNum  eq iLineNum
    10282                                                    and length(utd-marking-lines.mark) > 13
    10283                     no-lock:
    10284                        if isOAD(utd-marking-lines.mark)
    10285                        then do:
    10286                           assign
    10287                              vArtic   = yes
    10288                              vMarking = no
    10289                           .
    10290                           leave block-marking.
    10291                        end.
    10292                     end.
    10293                  end.
    10294                  if vArtic
    10295                  then do:
    10296                     block-artic:
    10297                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10298                                                    and utd-marking-lines.doc-id   eq idoc-id
    10299                                                    and utd-marking-lines.LineNum  eq iLineNum
    10300                                                    and length(utd-marking-lines.mark) > 13
    10301                     no-lock:
    10302                        if isMark(utd-marking-lines.mark)
    10303                        then do:
    10304                           assign
    10305                              vArtic   = no
    10306                              vMarking = yes
    10307                           .
    10308                           leave block-artic.
    10309                        end.
    10310                     end.
    10311                  end.
    10312                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
    10313                  if vTransitional
    10314                  then do:
    10315                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
    10316                                                    and utd-marking-lines.doc-id   eq idoc-id
    10317                                                    and utd-marking-lines.LineNum  eq iLineNum
    10318                                                    and length(utd-marking-lines.mark) > 13
    10319                     no-lock no-error.
    10320                     if not available utd-marking-lines
    10321                     then assign
    10322                        vMarking = no
    10323                        vArtic   = no
    10324                     .
    10325                  end.
    10326               end.
    10327               else
    10328                  assign
    10329                     vMarking      = yes
    10330                     vArtic        = no
    10331                     vTransitional = no
    10332                  .
    10333               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
    10334               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
    10335               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
    10336            end.
    10337         end.
    10338      end.
    10339      return vMarking or vArtic.
    10340   end.
    10341   function getMarkUtdLine return logical
    10342    (input  idb-num  as integer,
    10343     input  idoc-id  as integer,
    10344     input  iLineNum as integer,
    10345     output oMarking        as logical,
    10346     output oArtic          as logical,
    10347     output oTransitional   as logical):
    10348     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
    10349     oArtic        = not oMarking
    10350            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
    10351     oTransitional = (oMarking or oArtic)
    10352            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
    10353   end.
    10354   function CheckMarking return logical
    10355    (input idb-num as integer,
    10356    input idoc-id as integer,
    10357    input iTypeErr as character ):
    10358     define variable vMarkutd as logical no-undo.
    10359     define variable vCrErr   as logical no-undo.
    10360     define buffer utd-lines         for utd-lines.
    10361     define buffer utd-marking-lines for utd-marking-lines.
    10362     define buffer marking           for marking.
    10363     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
    10364      block-line:
    10365      for each utd-lines where utd-lines.db-num eq idb-num
    10366                           and utd-lines.doc-id eq idoc-id
    10367      no-lock:
    10368         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
    10369         then do:
    10370            for each utd-marking-lines
    10371                     where utd-marking-lines.db-num  = utd-lines.db-num
    10372                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    10373                       and utd-marking-lines.LineNum = utd-lines.LineNum
    10374            no-lock:
    10375               if isMark(utd-marking-lines.mark)
    10376               then do:
    10377                  find first marking where marking.mark eq utd-marking-lines.mark
    10378                  no-lock no-error.
    10379                  if not available marking
    10380                  then do:
    10381                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
    10382                     vCrErr = yes.
    10383                     next block-line.
    10384                  end.
    10385               end.
    10386            end.
    10387         end.
    10388      end.
    10389      return vCrErr.
    10390   end.
    10391   function CheckMarkForType return logical
    10392    (input idb-num   as integer,
    10393     input idoc-id   as integer):
    10394      define variable vMarking        as logical no-undo.
    10395      define variable vArtic          as logical no-undo.
    10396      define variable vTransitional   as logical no-undo.
    10397      define buffer utd-lines         for utd-lines.
    10398      define buffer utd-marking-lines for utd-marking-lines.
    10399      block-line:
    10400      for each utd-lines where utd-lines.db-num eq idb-num
    10401                           and utd-lines.doc-id eq idoc-id
    10402      no-lock:
    10403         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
    10404                          output vMarking         , output vArtic          , output vTransitional).
    10405         for each utd-marking-lines
    10406                     where utd-marking-lines.db-num  = utd-lines.db-num
    10407                       and utd-marking-lines.doc-id  = utd-lines.doc-id
    10408                       and utd-marking-lines.LineNum = utd-lines.LineNum
    10409         no-lock:
    10410            if length(utd-marking-lines.mark) < 14
    10411            then do:
    10412               if (vMarking or vArtic) and not vTransitional
    10413               then
    10414                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    10415            end.
    10416            else if not isMark(utd-marking-lines.mark)
    10417            then do:
    10418               if vMarking
    10419               then
    10420                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
    10421            end.
    10422            else do:
    10423            end.
    10424         end.
    10425      end.
    10426   end.
    10427   function WeighedProd return logical
    10428      ( input p-gds-code as integer) :
    10429      define variable v-par-val  as character no-undo.
    10430      define variable v-par-type as character no-undo.
    10431              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10432               ( p-gds-code,
    10433                 'weighed-gds':U,
    10434                  output v-par-val,
    10435                  output v-par-type
    10436               ).
    10437      return logical(v-par-val).
    10438   end.
    10439   function WghProdVariable return logical
    10440       (input p-obj-type as char,
    10441        input p-obj-code as integer,
    10442        input p-gds-code as integer) :
    10443      define variable v-wgh-val  as character no-undo.
    10444      define variable v-par-val  as character no-undo.
    10445      define variable v-par-type as character no-undo.
    10446      define variable vMarking        as logical no-undo.
    10447      define variable vArtic          as logical no-undo.
    10448      define variable vTransitional   as logical no-undo.
    10449      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    10450         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10451           ( p-gds-code,
    10452             'weighed-gds':U,
    10453              output v-wgh-val,
    10454              output v-par-type
    10455           ).
    10456       if logical(v-wgh-val) = yes then do:
    10457           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
    10458               ( p-gds-code,
    10459                 'mark-type':U,
    10460                  output v-par-val,
    10461                  output v-par-type
    10462               ).
    10463           if v-par-val <> "" then do:
    10464               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
    10465               assign
    10466                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
    10467                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
    10468                  .
    10469           end.
    10470      end.
    10471      if v-wgh-val > "" and (vMarking or vArtic)
    10472      then return yes.
    10473      else return no.
    10474   end.
    10475   function MarkWeight return decimal
    10476      ( input p-mark as character) :
    10477      define buffer  buf_marking-attr for  ub.marking-attr.
    10478      define variable vMarkWeight as decimal no-undo.
    10479      vMarkWeight = 0.
    10480      if p-mark <> "" and p-mark <> ?
    10481      then do:
    10482          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
    10483                                        and buf_marking-attr.attr-code eq "weight"
    10484             no-lock no-error.
    10485          if not available buf_marking-attr
    10486          then do :
    10487            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
    10488                                          and buf_marking-attr.attr-code eq "weight"
    10489               no-lock no-error.
    10490          end .
    10491          if avail buf_marking-attr
    10492          then vMarkWeight = dec(buf_marking-attr.attr-value).
    10493      end.
    10494      return vMarkWeight.
    10495   end.
