      394     define input  parameter p-pl-code          as integer   no-undo .
      395     define parameter buffer buf_doc-line       for ub.doc-line .
      396     define parameter buffer buf_parts          for ub.parts .
      397     define variable vss-description as character no-undo initial "$Workfile$ $Revision$ Процедура создания партии".
      398     define variable v-price-cli                like ub.doc-line.price-rubl no-undo.
      399     define variable v-price-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      400     define variable v-price-road-tax           like ub.doc-line.price-rubl no-undo.
      401     define variable v-price-other-exp          like ub.doc-line.price-rubl no-undo.
      402     define variable v-price-transport-exp      like ub.doc-line.price-rubl no-undo.
      403     define variable v-price-without-abs        like ub.doc-line.price-rubl no-undo.
      404     define variable v-price-slt                like ub.doc-line.price-rubl no-undo.
      405     define variable v-price-no-slt             like ub.doc-line.price-rubl no-undo.
      406     define variable v-price-vat                like ub.doc-line.price-rubl no-undo.
      407     define variable v-price-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      408     define variable v-price-rubl               like ub.doc-line.price-rubl no-undo.
      409     define variable v-price-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      410     define variable v-price-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      411     define variable v-price-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      412     define variable v-price-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      413     define variable v-price-slt-rubl           like ub.doc-line.price-rubl no-undo.
      414     define variable v-price-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      415     define variable v-price-vat-rubl           like ub.doc-line.price-rubl no-undo.
      416     define variable v-price-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      417     define variable v-price-base               like ub.doc-line.price-base no-undo.
      418     define variable v-price-road-tax-base      like ub.doc-line.price-base no-undo.
      419     define variable v-price-other-exp-base     like ub.doc-line.price-base no-undo.
      420     define variable v-price-transport-exp-base like ub.doc-line.price-base no-undo.
      421     define variable v-price-without-abs-base   like ub.doc-line.price-base no-undo.
      422     define variable v-price-slt-base           like ub.doc-line.price-base no-undo.
      423     define variable v-price-no-slt-base        like ub.doc-line.price-base no-undo.
      424     define variable v-price-vat-base           like ub.doc-line.price-base no-undo.
      425     define variable v-price-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      426     define variable l-fact-qnty              as logical   no-undo .
      427     define variable v-action                 as character no-undo .
      428     define variable l-need-create-old-return as logical   no-undo init false .
      429     define variable l-create-old-return      as logical   no-undo init false .
      430     define variable v-izlcstpr        as character no-undo .
      431     define variable l-goods-serial           as logical   no-undo .
      432     define variable l-goods-twounit          as logical   no-undo .
      433     define variable l-reserv-pl-code         as logical   no-undo .
      434     define variable l-goods-bottle           as logical   no-undo .
      435     define buffer buf_trn-doc  for ub.trn-doc .
      436     define buffer buf_goods    for ub.goods .
      437     define variable v-prompt-price       as character no-undo .
      438     define variable v-check-right        as logical   no-undo .
      439     define variable v-ind                as integer   no-undo .
      440     define variable v-num-entries-action as integer   no-undo .
      441     define variable v-option             as character no-undo .
      442     define variable v-type as character no-undo .
      443     do
      444     on error undo, return error return-value
      445     :
      446       assign
      447         v-check-right = true
      448       .
      449       if not available buf_doc-line
      450       then do:
      451         message
      452           vss-workfile vss-revision vss-description skip
      453           "Ошибка задания входных параметров" skip
      454           "Не задана строка документа" skip
      455           view-as alert-box error .
      456         undo, return error return-value .
      457       end.
      458       if p-supp-type = ?
      459       or p-supp-type = ''
      460       then do:
      461         message
      462           vss-workfile vss-revision vss-description skip
      463           "Ошибка задания входных параметров" skip
      464           "Параметр p-supp-type имеет неопределенное значение" skip
      465           "Документ" buf_doc-line.doc-code skip
      466           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      467           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      468           view-as alert-box error .
      469         undo, return error return-value .
      470       end.
      471       if p-supp-code = ?
      472       or p-supp-code = 0
      473       then do:
      474         message
      475           vss-workfile vss-revision vss-description skip
      476           "Ошибка задания входных параметров" skip
      477           "Параметр p-supp-code имеет неопределенное значение" skip
      478           "Документ" buf_doc-line.doc-code skip
      479           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      480           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      481           view-as alert-box error .
      482         undo, return error return-value .
      483       end.
      484       if p-part-code = ?
      485       then do:
      486         message
      487           vss-workfile vss-revision vss-description skip
      488           "Ошибка задания входных параметров" skip
      489           "Параметр p-part-code имеет неопределенное значение" skip
      490           "Документ" buf_doc-line.doc-code skip
      491           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      492           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      493           view-as alert-box error .
      494         undo, return error return-value .
      495       end.
      496       if p-cst-code = ?
      497       then do:
      498         message
      499           vss-workfile vss-revision vss-description skip
      500           "Ошибка задания входных параметров" skip
      501           "Параметр p-cst-code имеет неопределенное значение" skip
