    16255         then do:
    16256   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitqnty in g#library
    16258     (input buf_goods.unit-cli
    16259     ,input buf_parts.artic
    16260     ,input buf_parts.prod-type
    16261     ,input buf_parts.prod-code
    16262     ,input 'Ед.изм. поставщика'
    16263     ,input buf_parts.cli-qnty
    16264     ) no-error .
    16265           if error-status :error
    16266           then do:
    16267             message
    16268               "Не прошел контроль количества товара" skip
    16269               "Попробуйте ввести другое количество" skip
    16270               view-as alert-box information .
    16271             undo, return error .
    16272           end.
    16273         end.
    16274   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16275   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitqnty in g#library
    16276     (input buf_goods.unit-base
    16277     ,input buf_parts.artic
    16278     ,input buf_parts.prod-type
    16279     ,input buf_parts.prod-code
    16280     ,input ''
    16281     ,input buf_parts.fact-qnty
    16282     ) no-error .
    16283         if error-status :error
    16284         then do:
    16285           message
    16286             "Не прошел контроль количества товара" skip
    16287             "Попробуйте ввести другое количество" skip
    16288             view-as alert-box information .
    16289           undo, return error .
    16290         end.
    16291       end.
    16292     end.
    16293     assign
    16294       v-create-part = false
    16295     .
    16296     if valid-handle(h-call-prog)
    16297     then do:
    16298       run data-changed in h-call-prog .
    16299     end.
    16300   END PROCEDURE.
    16301   PROCEDURE validate-contract :
    16302     define variable v-host-code as integer   no-undo .
    16303     define buffer buf_trn-doc for ub.trn-doc .
    16304     define buffer buf_contract for ub.contract .
    16305     do
    16306     on error undo, return error return-value
    16307     :
    16308       find first buf_trn-doc no-lock
    16309         where buf_trn-doc.doc-code = p-doc-code
    16310         .
    16311   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    16313     (input  buf_trn-doc.obj-type
    16314     ,input  buf_trn-doc.obj-code
    16315     ,output v-host-code
    16316     )  .
    16317       if input frame Dialog-Frame fi-contract-prn-code <> fi-contract-prn-code
    16318       then do:
    16319         run validate-supp in this-procedure
    16320           (input (input frame Dialog-Frame parts.supp-type)
    16321           ,input (input frame Dialog-Frame parts.supp-code)
    16322           ) no-error .
    16323         if error-status :error
    16324         then do:
    16325           message
    16326             "Неправильно задан поставщик" skip
    16327             "" (input frame Dialog-Frame parts.supp-type)
    16328               (input frame Dialog-Frame parts.supp-code) skip
    16329             view-as alert-box error .
    16330           undo, return no-apply .
    16331         end.
    16332         run check-contract-code in this-procedure
    16333           (input  "input":u
    16334           ,input  v-host-code
    16335           ,input  (input frame Dialog-Frame parts.supp-type)
    16336           ,input  (input frame Dialog-Frame parts.supp-code)
    16337           ,input  input frame Dialog-Frame fi-contract-prn-code
    16338           ,input  parparentproc
    16339           ,input  buf_trn-doc.doc-date
    16340           ,input  ""
    16341           ,output v-contract-code
    16342           ) no-error .
    16343         if error-status :error
    16344         or v-contract-code = ?
    16345         then do:
    16346           if return-value <> ""
    16347           or error-status :get-message(1) <> ""
    16348           then do:
    16349             message
    16350               "Ошибка при заведении номера договора." skip
    16351               return-value skip
    16352               error-status :get-message(1)
    16353             view-as alert-box error .
    16354           end.
    16355           return error .
    16356         end.
    16357         assign
    16358           v-modified-contract-code = true
    16359         .
    16360         if v-contract-code <> 0
    16361         then do:
    16362           find first buf_contract no-lock
    16363             where buf_contract.host-code     = v-host-code
    16364               and buf_contract.contract-code = v-contract-code
    16365             .
    16366           display
    16367             buf_contract.contract-prn-code @ fi-contract-prn-code
    16368             substitute("&1 Вн.н. &2"
    16369                       ,string(buf_contract.contract-date,'99/99/9999':u)
    16370                       ,v-contract-code) @ fi-contract-name
    16371             with frame Dialog-Frame .
    16372           assign
    16373             v-enable-cli-exch-code = false
    16374             v-modified-exch-code   = true
    16375             v-exch-code            = buf_contract.curr-code
    16376           .
    16377           run update-exch-code-dependent in this-procedure .
    16378           run update-enable-price-cli    in this-procedure .
    16379           run update-exch-code-enable    in this-procedure .
    16380         end.
    16381         else do:
    16382           display
    16383             "" @ fi-contract-prn-code
    16384             "" @ fi-contract-name
    16385             with frame Dialog-Frame .
    16386           assign
    16387             v-enable-cli-exch-code = true
    16388             v-modified-exch-code   = true
    16389             v-exch-code            = 0
    16390           .
    16391           run update-exch-code-dependent in this-procedure .
    16392           run update-enable-price-cli    in this-procedure .
    16393           run update-exch-code-enable    in this-procedure .
    16394         end.
    16395         assign
    16396           fi-contract-prn-code
    16397         .
    16398       end.
    16399     end.
    16400   END PROCEDURE.
    16401   PROCEDURE validate-exch-code :
    16402     define buffer buf_currency for ub.currency .
    16403     do
    16404     on error undo, return error return-value
    16405     :
    16406       if input frame Dialog-Frame parts.exch-code <> v-exch-code
    16407       then do:
    16408         find first buf_currency no-lock
    16409           where buf_currency.curr-code = input frame Dialog-Frame parts.exch-code
    16410           no-error .
    16411         if not available buf_currency
    16412         then do:
    16413           message
    16414             "Неизвестный код валюты" skip
    16415             "Код валюты" input frame Dialog-Frame parts.exch-code skip
    16416             view-as alert-box error .
    16417           apply 'entry':u to parts.exch-code in frame Dialog-Frame .
    16418           undo, return error return-value .
    16419         end.
    16420         else do:
    16421           assign
    16422             v-modified-exch-code          = true
    16423             v-exch-code                   = buf_currency.curr-code
    16424           .
    16425           run update-exch-code-dependent in this-procedure .
    16426           run update-exch-code-enable    in this-procedure .
    16427         end.
    16428       end.
    16429     end.
    16430   END PROCEDURE.
    16431   PROCEDURE validate-part-code :
    16432     define input parameter p-new-part-code  as character no-undo .
    16433     define input parameter p-parts-recid    as recid     no-undo .
    16434     define input parameter p-doc-code       as character no-undo .
    16435     define input parameter p-gds-code       as integer   no-undo .
    16436     define input parameter p-goods-serial   as logical   no-undo .
    16437     define buffer buf_goods    for ub.goods .
    16438     define buffer buf_doc-line for ub.doc-line .
    16439     define buffer lookup_parts for ub.parts .
    16440     find first buf_goods no-lock
    16441       where buf_goods.gds-code = p-gds-code
    16442       .
    16443     find first buf_doc-line no-lock
    16444       where buf_doc-line.doc-code  = p-doc-code
    16445         and buf_doc-line.artic     = buf_goods.artic
    16446         and buf_doc-line.prod-type = buf_goods.prod-type
    16447         and buf_doc-line.prod-code = buf_goods.prod-code
    16448       .
    16449     find first lookup_parts no-lock
    16450       where lookup_parts.obj-type  = buf_doc-line.obj-type
    16451         and lookup_parts.obj-code  = buf_doc-line.obj-code
    16452         and lookup_parts.artic     = buf_doc-line.artic
    16453         and lookup_parts.prod-type = buf_doc-line.prod-type
    16454         and lookup_parts.prod-code = buf_doc-line.prod-code
    16455         and lookup_parts.in-code   = buf_doc-line.doc-code
    16456         and lookup_parts.out-code  = buf_doc-line.doc-code
    16457         and lookup_parts.part-code = p-new-part-code
    16458         and recid (lookup_parts) <> p-parts-recid
    16459       no-error .
    16460     if available lookup_parts
    16461     then do:
    16462       define variable v-show-part-code as character no-undo .
    16463       if p-new-part-code = '':u
    16464       then do:
    16465         assign
    16466           v-show-part-code = '------':u
    16467         .
    16468       end.
    16469       else do:
    16470         assign
    16471           v-show-part-code = p-new-part-code
    16472         .
    16473       end.
    16474       message
    16475         "Партия с номером <<" + v-show-part-code + ">> уже есть"
    16476         view-as alert-box error .
    16477       undo, return error .
    16478     end.
    16479     if  p-goods-serial  = true
    16480     and p-new-part-code = ""
    16481     then do:
    16482       message
    16483         "Для серийных товаров - серийный номер обязателен"
    16484         view-as alert-box error .
    16485       undo, return error .
    16486     end.
    16487   END PROCEDURE.
    16488   PROCEDURE validate-supp :
    16489     define input parameter p-supp-type like ub.parts.supp-type no-undo .
    16490     define input parameter p-supp-code like ub.parts.supp-code no-undo .
    16491     def buffer buf_supp-clients for ub.clients .
    16492     define variable v-create-old-return as logical   no-undo .
    16493     define variable v-reason            as character no-undo .
    16494     do
    16495     on error undo, return error return-value
    16496     :
    16497       if  v-supp-type = p-supp-type
    16498       and v-supp-code = p-supp-code
    16499       then do:
    16500         return .
    16501       end.
    16502       find buf_supp-clients  no-lock
    16503         where buf_supp-clients.obj-type = p-supp-type
    16504           and buf_supp-clients.obj-code = p-supp-code
    16505         no-error.
    16506       if not available buf_supp-clients
    16507       then do:
    16508         if p-supp-type = ""
    16509         or p-supp-type = ?
    16510         or p-supp-code = 0
    16511         or p-supp-code = ?
    16512         then do:
    16513           message
    16514             "Не задан тип или код поставщика" skip
    16515             p-supp-type p-supp-code skip
    16516             view-as alert-box information .
    16517         end.
    16518         else do:
    16519           message
    16520             "Неправильный код или тип поставщика" skip
    16521             p-supp-type p-supp-code skip
    16522             view-as alert-box information .
    16523         end.
    16524         apply 'entry':u to parts.supp-type in frame Dialog-Frame.
    16525         return error.
    16526       end.
    16527       if buf_supp-clients.stts <> 0
    16528       then do:
    16529         message
    16530           "Клиент" buf_supp-clients.obj-name "удален" skip
    16531           "Выберите другого клиента" skip
    16532           view-as alert-box information .
    16533         return error .
    16534       end.
    16535       define buffer buf_trn-doc for ub.trn-doc .
    16536       find first buf_trn-doc no-lock
    16537         where buf_trn-doc.doc-code = p-doc-code
    16538         .
    16539       run partscr_check-valid-supp in this-procedure
    16540         (input  p-supp-type
    16541         ,input  p-supp-code
    16542         ,input
    16543           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    16544         ,input
    16545           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    16546         ,input  buf_trn-doc.ext-doc-type
    16547         ,output v-create-old-return
    16548         ,output v-reason
    16549         ).
    16550       if v-reason <> ""
    16551       then do:
    16552         message
    16553           v-reason
    16554           view-as alert-box error .
    16555         undo, return error .
    16556       end.
    16557       assign
    16558         v-supp-type = p-supp-type
    16559         v-supp-code = p-supp-code
    16560       .
    16561       run clear-contract-value in this-procedure .
    16562       assign
    16563         fi-supp :screen-value = buf_supp-clients.obj-name
    16564         fi-supp :modified     = false
    16565       .
    16566       if v-create-old-return = true
    16567       then do:
    16568         assign
    16569           v-display-price-cli    = true
    16570           v-enable-price-cli     = true
    16571           v-enable-cli-exch-code = true
    16572         .
    16573         if v-is-fin = true
    16574         then do:
    16575           assign
    16576             v-enable-contract    = true
    16577           .
    16578         end.
    16579         else do:
    16580           assign
    16581             v-enable-contract    = false
    16582           .
    16583         end.
    16584       end.
    16585       else do:
    16586         assign
    16587           v-display-price-cli    = false
    16588           v-enable-price-cli     = false
    16589           v-enable-cli-exch-code = false
    16590           v-enable-contract      = false
    16591         .
    16592       end.
    16593       run update-enable-price-cli in this-procedure .
    16594       run update-exch-code-enable in this-procedure .
    16595     end.
    16596   END PROCEDURE.
