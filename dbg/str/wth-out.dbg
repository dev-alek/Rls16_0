        1   block-level on error undo, throw.
        2   define parameter buffer buf_wth-doc for ub.wth-doc.
        3   define parameter buffer buf_out_wth-doc for ub.wth-doc.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: wth-out.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/wth-out.p $":U .
        9   define variable vss-description as character no-undo init "Создание документов внутреннего перемещения".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#library  as handle no-undo .
       65   define new global shared variable g#library2 as handle no-undo .
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable same_db as logical   no-undo initial no .
       80   define variable v-base-code         like ub.currency.curr-code no-undo .
       81   DEFINE VARIABLE vardoc-rec as recid no-undo .
       82   DEFINE VARIABLE varline-rec as recid no-undo .
       83   DEFINE VARIABLE vardtl-rec as recid no-undo .
       84   DEFINE VARIABLE varparts-rec as recid no-undo .
       85   DEFINE VARIABLE f-date     AS DATE NO-UNDO.
       86   DEFINE VARIABLE f-time     AS INT  NO-UNDO.
       87   DEFINE VARIABLE s-date     AS DATE NO-UNDO.
       88   DEFINE VARIABLE s-num      AS INT  NO-UNDO.
       89   DEFINE VARIABLE s-name     AS CHAR NO-UNDO.
       90   DEFINE VARIABLE is-parts   AS log  NO-UNDO.
       91   DEFINE VARIABLE is-dtl     AS log  NO-UNDO.
       92   define buffer doc-obj      for ub.clients .
       93   define buffer buf_cliobj   for ub.clients .
       94   define buffer buf_wth-line for ub.wth-line.
       95   define buffer buf_wth-dtl  for ub.wth-dtl.
       96   define buffer buf_wth-parts   for ub.wth-parts.
       97   define buffer buf_out_wth-line for ub.wth-line.
       98   define buffer buf_out_wth-dtl  for ub.wth-dtl.
       99   define buffer buf_wth-par      for ub.wth-par.
      100   define temp-table tt-par-dtl  no-undo like ub.wth-par
      101   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
      102   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
      103   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
      104   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
      105   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
      106   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
      107   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
      108   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
      109   FIELD w-p-code     like ub.wth-dtl.w-p-code
      110   FIELD doc-code     like ub.wth-dtl.doc-code
      111   FIELD gds-code     like ub.wth-gds.gds-code
      112   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
      113   INDEX tt-i1                        par-feat par-unit par-val
      114   INDEX tt-i2                        doc-sum  q-ty-doc
      115   .
      116   define temp-table tt-wth-line no-undo like ub.wth-line.
      117   define temp-table tt-wth-parts no-undo like ub.wth-parts.
      118   define variable v-ext-type as char no-undo.
      119   define variable v-doc-code as char no-undo.
      120   define variable v-today    as date no-undo.
      121   _main:
      122   do on error undo _main, return error return-value
      123      on stop undo _main, return error:
      124     find current buf_wth-doc  no-error .
      125     if not available buf_wth-doc then do:
      126       message
      127         vss-workfile vss-revision vss-description skip
      128         "Ошибка задания входных параметров" skip
      129         "Не найден документ" skip
      130         view-as alert-box .
      131       undo, return error .
      132     end.
      133     define variable v-host-code like buf_wth-doc.host-code no-undo .
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      136     (input  buf_wth-doc.obj-type
      137     ,input  buf_wth-doc.obj-code
      138     ,output v-host-code
      139     ) no-error .
      140     if error-status :error then do:
      141       message
      142         vss-workfile vss-revision vss-description skip
      143         "Ошибка при определении кода фирмы для объекта с которого происходит перемещение" skip
      144         "Документ внутреннего перемещения" buf_wth-doc.doc-code skip
      145         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      146         view-as alert-box error .
      147       undo, return error .
      148     end.
      149   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      151     (input  v-host-code
      152     ,output v-base-code
      153     ) no-error .
      154     if error-status :error then do:
      155       message
      156         vss-workfile vss-revision vss-description skip
      157         "Ошибка при определении кода базовой валюты для фирмы" skip
      158         "Документ внутреннего перемещения" buf_wth-doc.doc-code skip
      159         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      160         view-as alert-box error .
      161       undo, return error .
      162     end.
      163     define variable v-cli-host-code like buf_wth-doc.host-code no-undo .
      164   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      166     (input  buf_wth-doc.cli-type
      167     ,input  buf_wth-doc.cli-code
      168     ,output v-cli-host-code
      169     ) no-error .
      170     if error-status :error then do:
      171       message
      172         vss-workfile vss-revision vss-description skip
      173         "Ошибка при определении кода фирмы для объекта на который происходит перемещение" skip
      174         "Документ внутреннего перемещения" buf_wth-doc.doc-code skip
      175         "Объект" buf_wth-doc.cli-type buf_wth-doc.cli-code skip
      176         view-as alert-box error .
      177       undo, return error .
      178     end.
      179     if v-cli-host-code <> v-host-code then do:
      180       message
      181         vss-workfile vss-revision vss-description skip
      182         "Документ " buf_wth-doc.doc-code skip
      183         "Фирма объекта откуда происходит перемещение" skip
      184         "не совпадает с фирмой, куда происходит перемещение" skip
      185         "v-host-code"     v-host-code     skip
      186         "v-cli-host-code" v-cli-host-code skip
      187         "Закрытие документа невозможно" skip
      188         view-as alert-box error .
      189       undo, return error .
      190     end.
      191     find ub.clients no-lock
      192       where ub.clients.obj-type = buf_wth-doc.cli-type
      193         and ub.clients.obj-code = buf_wth-doc.cli-code
      194       no-error .
      195     if not available ub.clients then do:
      196       message
      197         vss-workfile vss-revision vss-description skip
      198         "Неизвестный клиент" skip
      199         "Документ " buf_wth-doc.doc-code skip
      200         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      201         "Клиент" buf_wth-doc.cli-code buf_wth-doc.cli-type skip
      202         view-as alert-box .
      203       undo, return error .
      204     end.
      205     if  buf_wth-doc.cli-type <> 'скл':U
      206     and buf_wth-doc.cli-type <> 'маг':U
      207     then do:
      208       message
      209         vss-workfile vss-revision vss-description skip
      210         "Клиент документа внутреннего перемещения не является объектом"
      211         "Документ " buf_wth-doc.doc-code skip
      212         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      213         "Клиент" buf_wth-doc.cli-code buf_wth-doc.cli-type skip
      214         view-as alert-box error .
      215       undo, return error .
      216     end.
      217     find doc-obj no-lock
      218       where doc-obj.obj-type = buf_wth-doc.obj-type
      219         and doc-obj.obj-code = buf_wth-doc.obj-code
      220       no-error .
      221     if not available doc-obj then do:
      222       message
      223         vss-workfile vss-revision vss-description skip
      224         "Неизвестный объект" skip
      225         "Документ " buf_wth-doc.doc-code skip
      226         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      227         "Клиент" buf_wth-doc.cli-code buf_wth-doc.cli-type skip
      228         view-as alert-box .
      229       undo, return error .
      230     end.
      231     if  buf_wth-doc.obj-type <> 'скл':U
      232     and buf_wth-doc.obj-type <> 'маг':U
      233     then do:
      234       message
      235         vss-workfile vss-revision vss-description skip
      236         "Объект документа внутреннего перемещения не является объектом"
      237         "Документ " buf_wth-doc.doc-code skip
      238         "Объект" buf_wth-doc.obj-type buf_wth-doc.obj-code skip
      239         "Клиент" buf_wth-doc.cli-code buf_wth-doc.cli-type skip
      240         view-as alert-box error .
      241       undo, return error .
      242     end.
      243     if doc-obj.db-num = clients.db-num
      244     and clients.db-num > 0 then do:
      245       assign
      246         same_db = yes
      247       .
      248     end.
      249     if (doc-obj.db-num > 0 and g#db-num = 0 and same_db = no )
      250     or (doc-obj.db-num = 0 and g#db-num = 0)
      251     or (g#db-num > 0 and same_db = yes)
      252     then do:
      253     end.
      254     else do:
      255       return.
      256     end.
      257   if buf_wth-doc.doc-type = 'при':U and not buf_wth-doc.exter and not buf_wth-doc.inter then do:
      258     if can-find(first buf_wth-parts where
      259                 buf_wth-parts.out-code = buf_wth-doc.doc-code
      260                 and (buf_wth-parts.fact-rangeFrom <> buf_wth-parts.doc-rangeFrom or
      261                      buf_wth-parts.fact-rangeTo <> buf_wth-parts.doc-rangeTo or buf_wth-parts.stts = 1 )
      262                 )
      263     or can-find(first buf_wth-line where
      264                 buf_wth-line.doc-code = buf_wth-doc.doc-code
      265                 and buf_wth-line.doc-sum <> buf_wth-line.fact-sum)
      266     then.
      267     else return.
      268   end.
      269   if buf_wth-doc.ext-doc-type = 'pc':U then do:
      270     run str/wth-inc1.p ( input yes,
      271                     input-output vardoc-rec,
      272                     input        'ДОБАВЛЕНИЕ':U,
      273                     input "":U ,
      274                     input buf_wth-doc.host-code,
      275                     input buf_wth-doc.obj-type,
      276                     input buf_wth-doc.obj-code,
      277                     input "":U,
      278                     input 0 ,
      279                     input buf_wth-doc.doc-date,
      280                     input buf_wth-doc.fact-date,
      281                     input buf_wth-doc.shift-date,
      282                     input buf_wth-doc.shift-num,
      283                     input buf_wth-doc.shift-name,
      284                     input buf_wth-doc.operator,
      285                     input buf_wth-doc.deliver,
      286                     input buf_wth-doc.receiver,
      287                     input 'рас':U,
      288                     input buf_wth-doc.auto-fill,
      289                     input buf_wth-doc.exter_,
      290                     input buf_wth-doc.inter_,
      291                     input buf_wth-doc.doc-code,
      292                     input 'док.МЦ':U,
      293                     input yes,
      294                     input 0,
      295                     input 0,
      296                     input buf_wth-doc.PS,
      297                     input 'накл':U,
      298                     input no  ,
      299                     'ep':U) .
      300   end.
      301   else  if buf_wth-doc.obj-type = buf_wth-doc.cli-type and
      302              buf_wth-doc.obj-code = buf_wth-doc.cli-code and
      303              buf_wth-doc.inter_ = yes
      304   then do:
      305     if  buf_wth-doc.ext-doc-type = 'ej':U then v-ext-type = 'ij':U.
      306     else if  buf_wth-doc.ext-doc-type = 'ij':U then v-ext-type = 'ej':U.
      307     else if  buf_wth-doc.ext-doc-type = 'oj':U then v-ext-type = 'pj':U.
      308     else if  buf_wth-doc.ext-doc-type = 'jj':U then v-ext-type = 'fj':U.
      309        run str/wth-inc1.p ( input yes,
      310                     input-output vardoc-rec,
      311                     input        'ДОБАВЛЕНИЕ':U,
      312                     input replace(buf_wth-doc.doc-code, "-", "=") ,
      313                     input buf_wth-doc.host-code,
      314                     input buf_wth-doc.obj-type,
      315                     input buf_wth-doc.obj-code,
      316                     input buf_wth-doc.cli-type,
      317                     input buf_wth-doc.cli-code,
      318                     input buf_wth-doc.doc-date,
      319                     input buf_wth-doc.fact-date,
      320                     input buf_wth-doc.shift-date,
      321                     input buf_wth-doc.shift-num,
      322                     input buf_wth-doc.shift-name,
      323                     input buf_wth-doc.operator,
      324                     input buf_wth-doc.deliver,
      325                     input buf_wth-doc.receiver,
      326                     input (if buf_wth-doc.doc-type = 'при':U then 'рас':U else 'при':U),
      327                     input buf_wth-doc.auto-fill,
      328                     input buf_wth-doc.exter_,
      329                     input buf_wth-doc.inter_,
      330                     input buf_wth-doc.doc-code,
      331                     input 'док.МЦ':U,
      332                     input yes,
      333                     input 0,
      334                     input 0,
      335                     input buf_wth-doc.PS,
      336                     input 'накл':U,
      337                     input no ,
      338                     input v-ext-type ) no-error .
      339   end.
      340   else do:
      341   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      343     (input  buf_wth-doc.cli-type
      344     ,input  buf_wth-doc.cli-code
      345     ,output v-today
      346     )  .
      347     assign f-date = v-today.
      348     run gbl/factdate.p (
      349                        INPUT        buf_wth-doc.cli-type
      350                       ,INPUT        buf_wth-doc.cli-code
      351                       ,INPUT-OUTPUT f-date
      352                       ,INPUT-OUTPUT f-time
      353                       ,INPUT-OUTPUT s-date
      354                       ,INPUT-OUTPUT s-num
      355                       ,INPUT-OUTPUT s-name
      356                       ,INPUT        YES
      357                         ) NO-ERROR.
      358     IF ERROR-STATUS:ERROR THEN DO:
      359       return error return-value.
      360     END.
      361     if  buf_wth-doc.ext-doc-type = 'ep':U then v-ext-type = 'ip':U.
      362     else if  buf_wth-doc.ext-doc-type = 'ip':U  then v-ext-type = 'rp':U.
      363     else if  buf_wth-doc.ext-doc-type = 'ef':U then v-ext-type = 'ff':U.
      364     else if  buf_wth-doc.ext-doc-type = 'ff':U then v-ext-type = 'rf':U.
      365     else if  buf_wth-doc.ext-doc-type = 'ii':U then v-ext-type = 'rj':U.
      366     else if  buf_wth-doc.ext-doc-type = 'ei':U then v-ext-type = 'ii':U.
      367     if buf_wth-doc.doc-type = 'рас':U     then v-doc-code = replace(buf_wth-doc.doc-code, "-", "=").
      368     else if buf_wth-doc.doc-type = 'при':U then v-doc-code = replace(buf_wth-doc.doc-code, "=", "*").
      369     run str/wth-inc1.p ( input yes,
      370                     input-output vardoc-rec,
      371                     input 'ДОБАВЛЕНИЕ':U,
      372                     input v-doc-code,
      373                     input buf_wth-doc.host-code,
      374                     input buf_wth-doc.cli-type,
      375                     input buf_wth-doc.cli-code,
      376                     input buf_wth-doc.obj-type,
      377                     input buf_wth-doc.obj-code,
      378                     input buf_wth-doc.doc-date,
      379                     input f-date,
      380                     input s-date,
      381                     input s-num,
      382                     input s-name,
      383                     input buf_wth-doc.operator,
      384                     input buf_wth-doc.deliver,
      385                     input buf_wth-doc.receiver,
      386                     input (if buf_wth-doc.doc-type = 'при':U then 'возврат':U else 'при':U),
      387                     input buf_wth-doc.auto-fill,
      388                     input buf_wth-doc.exter_,
      389                     input buf_wth-doc.inter_,
      390                     input buf_wth-doc.doc-code,
      391                     input 'док.МЦ':U,
      392                     input yes,
      393                     input 0,
      394                     input 0,
      395                     input buf_wth-doc.PS,
      396                     input 'накл':U,
      397                     input no,
      398                     input v-ext-type) no-error .
      399   end.
      400     if error-status:error then do:
      401       undo _main, return error return-value + chr(10) + error-status:get-message(1) .
      402     end.
      403     FIND FIRST buf_out_wth-doc where
      404               recid(buf_out_wth-doc) = vardoc-rec No-ERROR.
      405     if not avail buf_out_wth-doc then do:
      406       undo _main, return error.
      407     end.
      408     for each buf_wth-line No-LOCK WHERE
      409             buf_wth-line.doc-code = buf_wth-doc.doc-code:
      410       for each tt-par-dtl:
      411         delete tt-par-dtl.
      412       end.
      413       is-parts = no.
      414       is-dtl   = no.
      415       for each buf_wth-dtl no-lock where
      416               buf_wth-dtl.doc-code = buf_wth-doc.doc-code AND
      417               buf_wth-dtl.wth-code = buf_wth-line.wth-code AND
      418               buf_wth-dtl.w-p-code = buf_wth-line.w-p-code
      419               , first buf_wth-par no-lock where
      420                       buf_wth-par.wth-code = buf_wth-dtl.wth-code
      421                   and buf_wth-par.par-code = buf_wth-dtl.par-code
      422                      :
      423         for each buf_wth-parts no-lock where
      424           buf_wth-parts.out-code = buf_wth-line.doc-code and
      425           buf_wth-parts.wth-code = buf_wth-line.wth-code and
      426           buf_wth-parts.w-p-code = buf_wth-line.w-p-code  and
      427           buf_wth-parts.par-code = buf_wth-dtl.par-code
      428           :
      429           if buf_out_wth-doc.doc-type = 'возврат':U
      430             and buf_wth-parts.fact-rangeFrom = buf_wth-parts.doc-rangeFrom
      431             and buf_wth-parts.fact-rangeTo = buf_wth-parts.doc-rangeTo
      432             and buf_wth-parts.stts = 0
      433           then next.
      434           if (buf_out_wth-doc.doc-type = 'возврат':U and (buf_wth-parts.doc-rangeFrom <> buf_wth-parts.fact-rangeFrom  or buf_wth-parts.stts = 1))
      435             or buf_out_wth-doc.doc-type <> 'возврат':U then do:
      436                run str/wthpartp.p (  'ДОБАВЛЕНИЕ':U,
      437                          buf_out_wth-doc.obj-type    ,
      438                          buf_out_wth-doc.obj-code    ,
      439                          buf_wth-line.out-code       ,
      440                          buf_wth-parts.wth-code      ,
      441                          buf_wth-parts.par-code      ,
      442                          buf_wth-parts.in-code       ,
      443                          buf_out_wth-doc.doc-code ,
      444                          buf_wth-parts.ser-code      ,
      445                          buf_wth-parts.db-num        ,
      446                          buf_wth-parts.doc-rangeFrom,
      447                          ( if buf_wth-doc.doc-type = 'возврат':U and buf_wth-parts.stts = 0 then buf_wth-parts.fact-rangeFrom - 1 else buf_wth-parts.fact-RangeTo ) ,
      448                          buf_wth-parts.doc-rangeFrom,
      449                          ( if buf_wth-doc.doc-type = 'возврат':U and buf_wth-parts.stts = 0 then buf_wth-parts.fact-rangeFrom - 1 else buf_wth-parts.fact-RangeTo ) ,
      450                          buf_out_wth-doc.host-code     ,
      451                          buf_out_wth-doc.contract-code     ,
      452                          buf_wth-parts.price-rubl   ,
      453                          buf_wth-parts.price-base   ,
      454                          buf_wth-parts.supp-type    ,
      455                          buf_wth-parts.supp-code    ,
      456                          buf_wth-parts.in-obj-type    ,
      457                          buf_wth-parts.in-obj-code    ,
      458                          buf_out_wth-doc.ext-doc-type     ,
      459                          buf_wth-parts.gds-code    ,
      460                          0,
      461                          buf_wth-parts.beg-dt     ,
      462                          buf_wth-parts.end-dt     ,
      463                          buf_wth-parts.vat-pc     ,
      464                          buf_wth-parts.cli-code    ,
      465                          buf_wth-parts.cli-type    ,
      466                          buf_wth-parts.out-obj-code    ,
      467                          buf_wth-parts.out-obj-type    ,
      468                          buf_wth-parts.sale-obj-code   ,
      469                          buf_wth-parts.sale-obj-type   ,
      470                          buf_out_wth-doc.doc-code ,
      471                          yes,
      472                          buf_out_wth-doc.doc-type ,
      473                         input-output varparts-rec
      474                       ) no-error.
      475             if error-status:error then do:
      476               undo _main, return error "Ошибка при создании партии. " + return-value + chr(10) + error-status:get-message(1).
      477             end.
      478           end.
      479           else if (buf_out_wth-doc.doc-type = 'возврат':U and buf_wth-parts.doc-rangeTo <> buf_wth-parts.fact-rangeTo)
      480           then do:
      481                run str/wthpartp.p (  'ДОБАВЛЕНИЕ':U ,
      482                          buf_out_wth-doc.obj-type      ,
      483                          buf_out_wth-doc.obj-code      ,
      484                          buf_wth-line.out-code       ,
      485                          buf_wth-parts.wth-code      ,
      486                          buf_wth-parts.par-code      ,
      487                          buf_wth-parts.in-code        ,
      488                          buf_out_wth-doc.doc-code ,
      489                          buf_wth-parts.ser-code      ,
      490                          buf_wth-parts.db-num        ,
      491                          buf_wth-parts.fact-rangeTo + 1,
      492                          buf_wth-parts.doc-rangeTo  ,
      493                          buf_wth-parts.fact-rangeTo + 1,
      494                          buf_wth-parts.doc-rangeTo  ,
      495                          buf_out_wth-doc.host-code     ,
      496                          buf_out_wth-doc.contract-code     ,
      497                          buf_wth-parts.price-rubl    ,
      498                          buf_wth-parts.price-base    ,
      499                          buf_wth-parts.supp-type    ,
      500                          buf_wth-parts.supp-code    ,
      501                          buf_wth-parts.in-obj-type    ,
      502                          buf_wth-parts.in-obj-code    ,
      503                          buf_out_wth-doc.ext-doc-type     ,
      504                          buf_wth-parts.gds-code    ,
      505                          0,
      506                          buf_wth-parts.beg-dt   ,
      507                          buf_wth-parts.end-dt   ,
      508                          buf_wth-parts.vat-pc   ,
      509                          buf_wth-parts.cli-code  ,
      510                          buf_wth-parts.cli-type  ,
      511                          buf_wth-parts.out-obj-code  ,
      512                          buf_wth-parts.out-obj-type  ,
      513                          buf_wth-parts.sale-obj-code ,
      514                          buf_wth-parts.sale-obj-type ,
      515                          buf_out_wth-doc.doc-code ,
      516                          yes,
      517                          buf_out_wth-doc.doc-type ,
      518                         input-output varparts-rec
      519                       ) no-error.
      520             if error-status:error then do:
      521               undo _main, return error return-value + chr(10) + error-status:get-message(1).
      522             end.
      523           end.
      524           is-parts = yes.
      525         end.
      526         create tt-par-dtl.
      527         buffer-copy buf_wth-dtl to tt-par-dtl.
      528         assign
      529             tt-par-dtl.doc-code = buf_out_wth-doc.doc-code
      530             tt-par-dtl.w-p-code = buf_wth-line.out-code
      531             tt-par-dtl.par-rate = buf_wth-par.par-rate
      532         .
      533         if is-parts then do:
      534   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   assign
      536   tt-par-dtl.q-ty-doc  = 0
      537   tt-par-dtl.q-ty-fact = 0
      538   tt-par-dtl.doc-sum   = 0
      539   tt-par-dtl.fact-sum  = 0
      540   tt-par-dtl.sum-gds-rubl = 0
      541   tt-par-dtl.sum-gds-base = 0
      542   .
      543   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-par-dtl.w-p-code
      544                          and buf_wth-parts.wth-code = tt-par-dtl.wth-code
      545                          and buf_wth-parts.par-code = tt-par-dtl.par-code
      546                          and buf_wth-parts.out-code = tt-par-dtl.doc-code
      547                          and buf_wth-parts.stts = 0 :
      548      assign
      549     tt-par-dtl.q-ty-doc     =  tt-par-dtl.q-ty-doc  + buf_wth-parts.qnty-doc
      550     tt-par-dtl.q-ty-fact    =  tt-par-dtl.q-ty-fact + buf_wth-parts.fact-qnty
      551     tt-par-dtl.sum-gds-rubl =  tt-par-dtl.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
      552     tt-par-dtl.sum-gds-base =  tt-par-dtl.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
      553     no-error
      554     .
      555   end.
      556   assign
      557     tt-par-dtl.doc-sum     =  tt-par-dtl.q-ty-doc  * tt-par-dtl.par-rate
      558     tt-par-dtl.fact-sum    =  tt-par-dtl.q-ty-fact * tt-par-dtl.par-rate
      559     no-error
      560     .
      561         end.
      562         else if buf_out_wth-doc.doc-type = 'возврат':U then do:
      563           tt-par-dtl.doc-sum = tt-par-dtl.doc-sum - tt-par-dtl.fact-sum.
      564           tt-par-dtl.fact-sum = tt-par-dtl.doc-sum.
      565         end.
      566         is-dtl = yes.
      567       end.
      568       create tt-wth-line.
      569       buffer-copy buf_wth-line to tt-wth-line.
      570       assign
      571         tt-wth-line.doc-code = buf_out_wth-doc.doc-code
      572         tt-wth-line.w-p-code = buf_wth-line.out-code
      573         tt-wth-line.out-code = buf_wth-line.w-p-code
      574         .
      575         if is-dtl then do:
      576   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   assign
      578   tt-wth-line.doc-sum   = 0
      579   tt-wth-line.fact-sum  = 0
      580   tt-wth-line.sum-gds-rubl = 0
      581   tt-wth-line.sum-gds-base = 0
      582   tt-wth-line.price-rubl   = 0
      583   tt-wth-line.price-base   = 0.
      584   for each tt-par-dtl no-lock where tt-par-dtl.w-p-code = tt-wth-line.w-p-code
      585                          and tt-par-dtl.wth-code = tt-wth-line.wth-code
      586                          and tt-par-dtl.doc-code = tt-wth-line.doc-code
      587                          :
      588     assign
      589     tt-wth-line.doc-sum      =  tt-wth-line.doc-sum  + tt-par-dtl.doc-sum
      590     tt-wth-line.fact-sum     =  tt-wth-line.fact-sum + tt-par-dtl.fact-sum
      591     tt-wth-line.sum-gds-rubl =  tt-wth-line.sum-gds-rubl + tt-par-dtl.sum-gds-rubl
      592     tt-wth-line.sum-gds-base =  tt-wth-line.sum-gds-base + tt-par-dtl.sum-gds-base
      593     .
      594   end.
      595   assign
      596     tt-wth-line.price-rubl  =  tt-wth-line.sum-gds-rubl / tt-wth-line.fact-sum
      597     tt-wth-line.price-base  =  tt-wth-line.sum-gds-base / tt-wth-line.fact-sum
      598     .
      599         end.
      600         else if buf_out_wth-doc.doc-type = 'возврат':U then do:
      601           tt-wth-line.doc-sum = tt-wth-line.doc-sum - tt-wth-line.fact-sum.
      602           tt-wth-line.fact-sum = tt-wth-line.doc-sum  .
      603         end.
      604        run str/wth-lnc1.p (input-output varline-rec,
      605                     input  'ДОБАВЛЕНИЕ':U,
      606                     no,
      607                     buf_out_wth-doc.doc-code,
      608                     buf_wth-line.wth-code,
      609                     buf_wth-line.out-code,
      610                     buf_wth-line.w-p-code,
      611                     tt-wth-line.doc-sum,
      612                     tt-wth-line.fact-sum,
      613                     input table tt-par-dtl,
      614                     no  ,
      615                     buf_wth-line.ext-doc-type,
      616                     input tt-wth-line.sum-gds-rubl,
      617                     input tt-wth-line.sum-gds-base
      618                     ) no-error .
      619       if error-status:error then dO:
      620         undo _main, return error 'Ошибка при создании линии  ' + return-value + chr(10) + error-status:get-message(1) .
      621       end.
      622     END.
      623   end.
