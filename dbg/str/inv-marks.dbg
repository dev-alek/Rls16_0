        1   using ibs.th.str.alcohol.*.
        2   define temp-table tt-marks
        3       field exciseMark   as character label "Марка"    format "X(150)"
        4       field alc-code     as character label "Алк. код" format "X(20)"
        5       field artic        as character label "Артикл"   format "X(20)"
        6       field prod-type    as character
        7       field prod-code    as integer
        8       field gds-code     as integer
        9       field doc-code     as character
       10       field partID       as character
       11       field refB         as character
       12       field rowid-part   as rowid
       13       field line-num     as integer
       14       field isCurr       as logical
       15       index pi as primary unique
       16           exciseMark
       17   .
       18   define temp-table tt-alc-qnty
       19       field artic        as character label "Артикл"   format "X(20)"
       20       field prod-type    as character
       21       field prod-code    as integer
       22       field gds-code     as integer
       23       field alc-code     as character label "Алк. код" format "X(20)"
       24       field qnty         as integer   label "Кол."
       25       field isCurr       as logical
       26       index pi as primary unique
       27           artic prod-type prod-code alc-code
       28   .
       29   define temp-table TempTrnDoc no-undo
       30     field line-num     as integer
       31     field ext-doc-code as character
       32     field doc-date     as date
       33     field ext-doc-type as character
       34     field cli-type     as character
       35     field cli-code     as integer
       36     field obj-type     as character
       37     field obj-code     as integer
       38     field ps           as character
       39     field Status_      as character
       40     field Flags_       as integer
       41     index pi line-num ext-doc-code .
       42   define temp-table TempDocLine no-undo
       43     field line-num     as integer
       44     field gds-code     as integer
       45     field doc-qnty     as decimal
       46     field fact-qnty    as decimal
       47     field price-rubl   as decimal
       48     field RowSum       as decimal
       49     field vat-pc       as decimal
       50     field b-code       as character
       51     field is-tsd-qnty  as logical   init no
       52     field aclMarksList as character
       53     field PartIDTH     as character
       54     field Flags_       as integer
       55     field NotDict      as logical
       56     index pi
       57     line-num
       58     gds-code
       59     .
       60   define temp-table TempDocLineIsTSD like TempDocLine.
       61   define temp-table TempDocLineTSD no-undo
       62     field gds-code     as integer
       63     field doc-qnty     as decimal
       64     field fact-qnty    as decimal
       65     field artic        as character
       66     field prod-code    as integer
       67     field prod-type    as character
       68     field Flags_error  as logical
       69     field mark-type    as character
       70     field mark         as character
       71     field mark-parent  as character
       72     index pi
       73     artic
       74     prod-code
       75     prod-type
       76     mark
       77     .
       78   define temp-table TempMarkLine no-undo
       79     field DocName    as character
       80     field MarkCode   as character
       81     field PartIDTH   as character
       82     field Sts        as character
       83     field MarkParent as character
       84     field QntyBox    as character
       85     index pi
       86     DocName
       87     MarkCode
       88     .
       89     define temp-table TempTSDSetting no-undo
       90     field sn   as character
       91     field obj-code  as integer
       92     field obj-type as character
       93     field version_ as character
       94     field lastDate as datetime
       95     index pi
       96     sn
       97     .
       98   define input parameter parparentproc as widget-handle no-undo.
       99   define input parameter p-trn-code as character no-undo.
      100   define input parameter p-recid as recid no-undo.
      101   define buffer buf_trn-doc for ub.trn-doc.
      102   define buffer buf_parts for ub.parts.
      103   define buffer buf_doc-line for ub.doc-line.
      104   define buffer buf_gds for ub.goods.
      105   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106     define variable v-cntxt-db-num        as integer   no-undo .
      107     define variable v-cntxt-userid        as character no-undo .
      108     define variable v-cntxt-level         as character no-undo .
      109     define variable v-cntxt-host-code-obj as integer   no-undo .
      110     define variable v-cntxt-obj-type      as character no-undo .
      111     define variable v-cntxt-obj-code      as integer   no-undo .
      112     define variable v-cntxt-db-num-obj    as integer   no-undo .
      113     define variable v-cntxt-is-admin      as logical   no-undo .
      114   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     run mainmenu_getcntxt in parparentproc
      116       (output v-cntxt-db-num
      117       ,output v-cntxt-userid
      118       ,output v-cntxt-level
      119       ,output v-cntxt-host-code-obj
      120       ,output v-cntxt-obj-type
      121       ,output v-cntxt-obj-code
      122       ,output v-cntxt-db-num-obj
      123       ,output v-cntxt-is-admin
      124       ) .
      125   define variable excMarks as class excisemarks no-undo.
      126   define new shared variable g#auto-user-id as character no-undo .
      127   define new shared variable g#LogStr       as character no-undo .
      128   DEFINE BUTTON btn_accept
      129        LABEL "Сохр."
      130        SIZE 6 BY 1.
      131   DEFINE BUTTON btn_imp
      132        LABEL "Импорт"
      133        SIZE 7 BY 1.
      134   DEFINE BUTTON Btn_OK AUTO-GO
      135        LABEL "Выход"
      136        SIZE 6 BY 1
      137        BGCOLOR 8 .
      138   DEFINE QUERY BROWSE-2 FOR
      139         tt-alc-qnty SCROLLING.
      140   DEFINE QUERY BROWSE-5 FOR
      141         tt-alc-qnty SCROLLING.
      142   DEFINE BROWSE BROWSE-2
      143     QUERY BROWSE-2 DISPLAY
      144     tt-alc-qnty.artic
      145     tt-alc-qnty.alc-code
      146     tt-alc-qnty.qnty
      147       WITH NO-ROW-MARKERS SEPARATORS SIZE 53 BY 23.5
      148            TITLE "Импортировано" ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      149   DEFINE BROWSE BROWSE-5
      150     QUERY BROWSE-5 DISPLAY
      151     tt-alc-qnty.artic
      152     tt-alc-qnty.alc-code
      153     tt-alc-qnty.qnty
      154       WITH NO-ROW-MARKERS SEPARATORS SIZE 53 BY 23.5
      155            TITLE "Текущее состояние" FIT-LAST-COLUMN.
      156   DEFINE FRAME Dialog-Frame
      157        Btn_OK AT ROW 1.08 COL 1.25
      158        btn_accept AT ROW 1.08 COL 7.25 WIDGET-ID 2
      159        btn_imp AT ROW 1.08 COL 13.5 WIDGET-ID 4
      160        BROWSE-2 AT ROW 2.25 COL 1.5 WIDGET-ID 200
      161        BROWSE-5 AT ROW 2.25 COL 55.5 WIDGET-ID 300
      162        SPACE(0.49) SKIP(0.24)
      163       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      164            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      165            TITLE "Марки по партии."
      166            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      167   ASSIGN
      168          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      169          FRAME Dialog-Frame:HIDDEN           = TRUE.
      170   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      171   DO:
      172     APPLY "END-ERROR":U TO SELF.
      173   END.
      174   ON CHOOSE OF btn_accept IN FRAME Dialog-Frame
      175   DO:
      176     define variable v-ok-doc as integer no-undo.
      177     define variable isClear  as logical no-undo.
      178     find first buf_trn-doc where buf_trn-doc.doc-code = p-trn-code no-lock.
      179     create TempTrnDoc.
      180     assign
      181       TempTrnDoc.doc-date = buf_trn-doc.doc-date
      182       TempTrnDoc.ext-doc-type = buf_trn-doc.ext-doc-type
      183       TempTrnDoc.ext-doc-code = buf_trn-doc.doc-code
      184       TempTrnDoc.cli-type = ""
      185       TempTrnDoc.cli-code = -2
      186       TempTrnDoc.obj-type = buf_trn-doc.obj-type
      187       TempTrnDoc.obj-code = buf_trn-doc.obj-code
      188       TempTrnDoc.ps = string (isClear)
      189     .
      190     for each buf_doc-line no-lock where buf_doc-line.doc-code = p-trn-code:
      191       find first buf_gds no-lock where buf_gds.artic = buf_doc-line.artic
      192         and buf_gds.prod-type = buf_doc-line.prod-type
      193         and buf_gds.prod-code = buf_doc-line.prod-code
      194       .
      195       create TempDocLine.
      196       assign
      197         TempDocLine.line-num  = buf_doc-line.line-num
      198         TempDocLine.gds-code  = buf_gds.gds-code
      199         TempDocLine.fact-qnty = buf_doc-line.fact-qnty
      200         .
      201     end.
      202     run ibs/th/skt/Adapters/AdapteeProcOra-i506.p
      203       (
      204         table TempTrnDoc,
      205         table TempDocLine,
      206         table tt-marks,
      207         v-cntxt-userid
      208       ) no-error.
      209     if error-status:error
      210     then do:
      211       message "Ошикба: " return-value view-as alert-box error.
      212     end.
      213   END.
      214   ON CHOOSE OF btn_imp IN FRAME Dialog-Frame
      215   DO:
      216     run str/imp-marks-temp.p (output table tt-marks, output table tt-alc-qnty, p-trn-code).
      217     OPEN QUERY BROWSE-2 FOR EACH tt-alc-qnty where tt-alc-qnty.isCurr = false.    OPEN QUERY BROWSE-5 FOR EACH tt-alc-qnty where tt-alc-qnty.isCurr = true.
      218   END.
      219   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      220   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      221   MAIN-BLOCK:
      222   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      223      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      224     excMarks = new excisemarks (v-cntxt-obj-type, v-cntxt-obj-code).
      225     if p-recid = ?
      226     then do:
      227       for each buf_doc-line where buf_doc-line.doc-code = p-trn-code:
      228         for each buf_parts no-lock where
      229           buf_parts.obj-type = buf_doc-line.obj-type and
      230           buf_parts.obj-code = buf_doc-line.obj-code and
      231           buf_parts.artic = buf_doc-line.artic and
      232           buf_parts.prod-type = buf_doc-line.prod-type and
      233           buf_parts.prod-code = buf_doc-line.prod-code and
      234           buf_parts.out-code = buf_doc-line.doc-code:
      235           excMarks:GetTableMarksForPartsAppend(buffer buf_parts, input-output table tt-marks).
      236         end.
      237       end.
      238     end.
      239     RUN enable_UI.
      240     WAIT-FOR GO OF FRAME Dialog-Frame.
      241   END.
      242   RUN disable_UI.
      243   PROCEDURE disable_UI :
      244     HIDE FRAME Dialog-Frame.
      245   END PROCEDURE.
      246   PROCEDURE enable_UI :
      247     ENABLE Btn_OK btn_accept btn_imp BROWSE-2 BROWSE-5
      248         WITH FRAME Dialog-Frame.
      249     VIEW FRAME Dialog-Frame.
      250     OPEN QUERY BROWSE-2 FOR EACH tt-alc-qnty where tt-alc-qnty.isCurr = false.    OPEN QUERY BROWSE-5 FOR EACH tt-alc-qnty where tt-alc-qnty.isCurr = true.
      251   END PROCEDURE.
