      247   index pi IS PRIMARY unique ID db-num
      248   .
      249   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   DEFINE new shared TEMP-TABLE thbjattr-list no-undo like ub.thbj-attr .
      251   define new shared var sendEMRC   as logical no-undo.
      252   define new shared var settingUpd as logical no-undo.
      253   define new shared var sendMarkType as logical no-undo.
      254   define new shared var sendGisMt as logical no-undo.
      255   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure send-to-cash:
      257     if not can-find(first ub.cash-desk where
      258                     ub.cash-desk.db-num = ibs.th.gbl.gbl-var:g#db-num AND
      259                     ub.cash-desk.cash-on = yes) then return.
      260     do
      261     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      262     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      263     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      264     :
      265       if can-find(first gds-list no-lock)
      266       or can-find(first gdsolist no-lock)
      267       or can-find(first bc-list no-lock)
      268       or can-find(first pbc-list no-lock)
      269       or can-find(first cash-txn no-lock)
      270       or can-find(first cash-txr no-lock)
      271       or can-find(first dc-list no-lock)
      272       or can-find(first dc-dis-card-mask no-lock)
      273       or can-find(first stpl-list no-lock)
      274       or can-find(first pdf-list no-lock)
      275       or can-find(first cash-pay-list no-lock)
      276       or can-find(first ext-classif-list no-lock)
      277       or can-find(first c-ext-classif-list no-lock)
      278       or can-find(first PromoAction-list no-lock)
      279       or can-find(first thbjattr-list no-lock)
      280       or sendEMRC
      281       or settingUpd
      282       or sendMarkType
      283       then do:
      284         run str/diallog.w (
      285                            input parparentproc
      286                           ,input ?
      287                           ,input 'str/sendnall.p':U
      288                           ,input string(ibs.th.gbl.gbl-var:g#db-num)
      289                           ,input yes
      290                           ,input '':U
      291                           ,input 'Отправка информации на кассу') no-error .
      292       end.
      293     end.
      294   end procedure.
      295   procedure fill-setting :
      296      define input parameter i-obj      as character no-undo .
      297      define input parameter i-obj-type as character no-undo .
      298      define input parameter i-obj-code as integer   no-undo .
      299      define input parameter i-parent   as character no-undo .
      300      define input parameter i-code     as character no-undo .
      301      define buffer buf_thbj-attr for ub.thbj-attr.
      302      define buffer buf_sys-ctrl for ub.sys-ctrl.
      303      define buffer buf_clients for ub.clients.
      304      define variable v-db-num    as integer no-undo.
      305      define variable v-shop-code as integer no-undo.
      306      define variable v-reg-code  as integer no-undo.
      307      settingUpd = yes.
      308      sendGisMt = no.
      309      if i-obj = "thbj-attr"
      310      then do:
      311         v-db-num  = ibs.th.gbl.gbl-var:g#db-num.
      312         if v-db-num <> 0 then do:
      313             find first buf_clients no-lock
      314                  where buf_clients.obj-type = 'маг':U
      315                    and buf_clients.db-num   = v-db-num
      316                no-error.
      317             if available buf_clients then v-shop-code = buf_clients.obj-code.
      318         end.
      319      end.
      320      if i-obj = "thbj-attr" and
      321         (i-parent = 'gisMT':U or i-parent = 'marking':U)
      322      then do:
      323         if i-parent = 'gisMT':U and i-obj-type = "" and i-obj-code = 0 then do:
      324             if not can-find(first buf_thbj-attr no-lock where
      325                                   buf_thbj-attr.obj-type = 'БД':U
      326                               and buf_thbj-attr.obj-code = v-db-num
      327                               and buf_thbj-attr.upper-prop-code = i-parent
      328                               and buf_thbj-attr.prop-code = i-code)
      329             then sendGisMt = yes.
      330         end.
      331         if i-parent = 'gisMT':U and i-obj-type = 'регион':U then do:
      332             sendGisMt = yes.
      333         end.
      334         else if (i-parent = 'gisMT':U and i-obj-type = 'БД':U and i-obj-code = v-db-num)
      335            then sendGisMt = yes.
      336         else if i-parent = 'marking':U and i-obj-type = 'маг':U and i-obj-code = v-shop-code
      337            then sendGisMt = yes.
      338         else if i-parent = 'marking':U and i-obj-type = "" then do:
      339             if not can-find(first buf_thbj-attr no-lock where
      340                                   buf_thbj-attr.obj-type = 'маг':U
      341                               and buf_thbj-attr.obj-code = v-shop-code
      342                               and buf_thbj-attr.upper-prop-code = i-parent
      343                               and buf_thbj-attr.prop-code = i-code)
      344             then sendGisMt = yes.
      345         end.
      346         if sendGisMt = yes then do:
      347             if not can-find(first thbjattr-list where
      348                                   thbjattr-list.obj-type = i-obj-type
      349                               and thbjattr-list.obj-code = i-obj-code
      350                               and thbjattr-list.upper-prop-code = i-parent
      351                               and thbjattr-list.prop-code = i-code)
      352             then do:
      353                 create thbjattr-list.
      354                 assign
      355                    thbjattr-list.obj-type = i-obj-type
      356                    thbjattr-list.obj-code = i-obj-code
      357                    thbjattr-list.upper-prop-code = i-parent
      358                    thbjattr-list.prop-code = i-code
      359                    .
      360             end.
      361         end.
      362      end.
      363   end procedure.
      364   procedure fill-code :
      365      define input parameter i-parent as character no-undo .
      366      define input parameter i-code   as character no-undo .
      367      if i-parent begins "EMC"
      368      then
      369         sendEMRC = yes.
      370      if i-parent begins "MarkType"
      371      then
      372         sendMarkType = yes.
      373   end procedure.
      374   procedure fill-gds-list :
      375   define parameter buffer buf_goods for ub.goods.
      376   do
      377   on error undo, return error
      378   :
      379     for first gds-list where gds-list.gds-code = buf_goods.gds-code:
      380       delete gds-list.
      381     end.
      382     create gds-list.
      383     buffer-copy buf_goods to gds-list no-error.
      384     if error-status:error then message error-status:get-message(1) view-as alert-box.
      385     release gds-list.
      386   end.
      387   end procedure.
      388   procedure fill-dc-list :
      389   define parameter buffer buf_dis-card for ub.dis-card .
      390   do
      391   on error undo, return error
      392   :
      393     find first dc-list where
      394               dc-list.d-card = buf_dis-card.d-card no-lock no-error.
      395     if not available dc-list then do:
      396       create dc-list.
      397       buffer-copy buf_dis-card to dc-list.
      398       release dc-list.
      399     end.
      400   end.
      401   end procedure.
      402   procedure fill-dc-list-mask :
      403   define parameter buffer buf_dis-card-mask for ub.dis-card-mask .
      404   do
      405   on error undo, return error
      406   :
      407      find first dc-list where
      408               dc-list.d-card = buf_dis-card-mask.mask no-lock no-error.
      409      if not available dc-list
      410      then do:
      411         find first ub.dis-card no-lock where
      412                    ub.dis-card.d-card = buf_dis-card-mask.mask no-error .
      413         if  available dis-card
      414         then
      415            run fill-dc-list(buffer dis-card) .
      416      end.
      417     find first dc-dis-card-mask where
      418                dc-dis-card-mask.mask-num = buf_dis-card-mask.mask-num no-lock no-error.
      419     buffer-copy buf_dis-card-mask to dc-dis-card-mask.
      420     release dc-dis-card-mask.
      421   end.
      422   end procedure.
      423   procedure fill-dc-list-mask-attr :
      424   define parameter buffer buf_dis-card-mask-attr for ub.dis-card-mask-attr .
      425   define buffer dis-card-mask for ub.dis-card-mask .
      426   do
      427   on error undo, return error
      428   :
      429     find first dc-dis-card-mask where
      430                dc-dis-card-mask.mask-num = buf_dis-card-mask-attr.mask-num no-lock no-error.
      431     if not available dc-dis-card-mask
      432     then do:
      433        find first dis-card-mask where dis-card-mask.mask-num eq buf_dis-card-mask-attr.mask-num no-lock no-error.
      434        if available dis-card-mask
      435        then
      436           run  fill-dc-list-mask (buffer dis-card-mask).
      437     end.
      438     find first dc-dis-card-mask-attr where
      439               dc-dis-card-mask-attr.mask-num  = buf_dis-card-mask-attr.mask-num
      440          and  dc-dis-card-mask-attr.attr-code = buf_dis-card-mask-attr.attr-code
      441               no-lock no-error.
      442     buffer-copy buf_dis-card-mask-attr to dc-dis-card-mask-attr.
      443     release dc-dis-card-mask-attr.
      444   end.
      445   end procedure.
      446   procedure fill-dc-list-attr :
      447   define input parameter p-d-card as character no-undo .
      448   define input parameter p-emitent-host-code as integer no-undo .
      449   do
      450   on error undo, return error
      451   :
      452     find first dc-list where
      453               dc-list.d-card = p-d-card no-error .
      454     if not avail dc-list then do:
      455       create dc-list.
      456       assign
      457       dc-list.d-card = p-d-card
      458       dc-list.emitent-host-code = p-emitent-host-code
      459       .
      460       release dc-list.
      461     end.
      462   end.
      463   end procedure.
      464   procedure fill-cash-pay :
      465   define input parameter p-cdpay-code as integer no-undo .
      466   define input parameter p-curr-code  as integer no-undo .
      467   do
      468   on error undo, return error
      469   :
      470     if not can-find( cash-pay-list where cash-pay-list.cdpay-code = p-cdpay-code
      471                                      and cash-pay-list.curr-code  = p-curr-code )
      472     then do:
      473       create cash-pay-list.
      474       assign
      475          cash-pay-list.cdpay-code = p-cdpay-code
      476          cash-pay-list.curr-code  = p-curr-code
      477       .
      478       release cash-pay-list.
      479     end.
      480   end.
      481   end procedure.
      482   procedure fill-PromoAction :
      483   define input parameter p-id as int64 no-undo .
      484   define input parameter p-db-num  as integer no-undo .
      485   do
      486   on error undo, return error
      487   :
      488     if not can-find( PromoAction-list where PromoAction-list.id = p-id
      489                                         and PromoAction-list.db-num  = p-db-num )
      490     then do:
      491       create PromoAction-list.
      492       assign
      493          PromoAction-list.id = p-id
      494          PromoAction-list.db-num  = p-db-num
      495       .
      496       release PromoAction-list.
      497     end.
      498   end.
      499   end procedure.
      500   procedure fill-ext-classif:
      501   define input parameter p-db-num as integer no-undo .
      502   define input parameter p-Key#One  as integer no-undo .
      503   define input parameter p-Key#Two  as integer no-undo .
      504   define input parameter p-CharKey_One  as character no-undo .
      505   do
      506   on error undo, return error
      507   :
      508     if not can-find( ext-classif-list where ext-classif-list.db-num = p-db-num
      509                                      and ext-classif-list.Key#One  = p-Key#One
      510                                      and ext-classif-list.Key#Two = p-Key#Two
      511                                      and ext-classif-list.CharKey_One = p-CharKey_One )
      512     then do:
      513       create ext-classif-list.
      514       assign
      515       ext-classif-list.db-num = p-db-num
      516       ext-classif-list.Key#One  = p-Key#One
      517       ext-classif-list.Key#Two = p-Key#Two
      518       ext-classif-list.CharKey_One = p-CharKey_One
      519       .
      520       release ext-classif-list.
      521     end.
      522   end.
      523   end procedure.
      524   procedure fill-c-ext-classif:
      525   define input parameter p-db-num as integer no-undo .
      526   define input parameter p-Key#One  as integer no-undo .
      527   define input parameter p-Key#Two  as integer no-undo .
      528   define input parameter p-CharKey_One  as character no-undo .
      529   define input parameter p-chip-num as integer no-undo .
      530   do
      531   on error undo, return error
      532   :
      533     if not can-find( c-ext-classif-list where c-ext-classif-list.db-num = p-db-num
      534                                      and c-ext-classif-list.Key#One  = p-Key#One
      535                                      and c-ext-classif-list.Key#Two = p-Key#Two
      536                                      and c-ext-classif-list.CharKey_One = p-CharKey_One
      537                                      and c-ext-classif-list.chip-num = p-chip-num )
      538     then do:
      539       create c-ext-classif-list.
      540       assign
      541           c-ext-classif-list.db-num = p-db-num
      542           c-ext-classif-list.Key#One  = p-Key#One
      543           c-ext-classif-list.Key#Two = p-Key#Two
      544           c-ext-classif-list.CharKey_One = p-CharKey_One
      545           c-ext-classif-list.chip-num = p-chip-num
      546       .
      547       release c-ext-classif-list.
      548     end.
      549   end.
      550   end procedure.
      551   procedure fill-g-list :
      552   define input parameter p-gds-code as integer no-undo .
      553   define input parameter p-obj-type as character no-undo .
      554   define input parameter p-obj-code as integer no-undo .
      555   define buffer buf_goods for ub.goods.
      556   do
      557   on error undo, return error
      558   :
      559     find first gds-list where
      560               gds-list.gds-code = p-gds-code no-error .
      561     if not avail gds-list then do:
      562       if p-obj-type = 'маг':U then do:
      563         find first gdsolist where
      564                   gdsolist.gds-code = p-gds-code
      565             AND  gdsolist.obj-type = p-obj-type
      566             AND  gdsolist.obj-code = p-obj-code   no-error .
      567       end.
      568       else do:
      569         find first buf_goods no-lock where
      570                     buf_goods.gds-code = p-gds-code no-error .
      571         create gds-list.
      572         buffer-copy buf_goods to gds-list.
      573       end.
      574     end.
      575     if p-obj-type = 'маг':U and not avail gdsolist then do:
      576       find first gdsolist where
      577                 gdsolist.gds-code = p-gds-code
      578           AND  gdsolist.obj-type = p-obj-type
      579           AND  gdsolist.obj-code = p-obj-code   no-error .
      580       if not available gdsolist then do:
      581         find first buf_goods no-lock where
      582                     buf_goods.gds-code = p-gds-code no-error .
      583         if avail buf_goods then do:
      584           create gdsolist.
      585           buffer-copy buf_goods to gdsolist
      586           assign
      587           gdsolist.obj-type = p-obj-type
      588           gdsolist.obj-code = p-obj-code
      589           .
      590         end.
      591       end.
      592     end.
      593     if avail gdsolist then do:
      594       assign
      595       gdsolist.to-del = no
      596       .
      597       release gdsolist.
      598     end.
      599     if avail gds-list then do:
      600       assign
      601       gds-list.to-del = no
      602       .
      603       release gds-list.
      604     end.
      605   end.
      606   end procedure.
      607   procedure fill-cash-txn :
      608   define parameter buffer buf_tax for ub.tax.
      609   do
      610   on error undo, return error
      611   :
      612     if not can-find( cash-txn where
      613                     cash-txn.tax-code = buf_tax.tax-code
      614                 and cash-txn.tax-name = buf_tax.tax-name
      615                    ) then do:
      616       create cash-txn.
      617       assign
      618       cash-txn.tax-code = buf_tax.tax-code
      619       cash-txn.tax-name = buf_tax.tax-name
      620       .
      621       release cash-txn.
      622     end.
      623   end.
      624   end procedure.
      625   procedure fill-cash-txr :
      626   define input parameter p-tax-code as integer no-undo .
      627   define input parameter p-rate-code as integer no-undo .
      628   define input parameter p-status_ as character no-undo .
      629   define input parameter p-host-code as integer no-undo .
      630   define input parameter p-obj-type as character no-undo .
      631   define input parameter p-obj-code as integer no-undo .
      632   define input parameter p-tax-type as character no-undo .
      633   define input parameter p-value as decimal no-undo .
      634   define input parameter p-crf as integer no-undo .
      635   define input parameter p-rec as recid no-undo .
      636   define buffer buf_tax for ub.tax.
      637   do
      638   on error undo, return error
      639   :
      640     find first cash-txr where
      641             cash-txr.tax-code = p-tax-code
      642         AND cash-txr.host-code = p-host-code
      643         AND cash-txr.rate-code = p-rate-code
      644         AND cash-txr.obj-type = p-obj-type
      645         AND cash-txr.obj-code = p-obj-code
      646         AND cash-txr.rc = p-rec no-error .
      647     if not avail cash-txr then do:
      648       find first  cash-txn where
      649                       cash-txn.tax-code = p-tax-code no-error .
      650       if not available cash-txn then do:
      651         find first buf_tax no-lock where buf_tax.tax-code = p-tax-code.
      652         create cash-txn.
      653         assign
      654         cash-txn.tax-code = buf_tax.tax-code
      655         cash-txn.tax-name = buf_tax.tax-name
      656         .
      657         release cash-txn.
      658         define variable II as integer no-undo.
      659         find last  cash-txr where cash-txr.crf > 0 no-error.
      660         if available cash-txr
      661         then
      662            II = cash-txr.crf + 1.
      663         else
      664            II = 1.
      665            _tax-rate:
      666         FOR EACH ub.tax-rate NO-LOCK WHERE
      667                             ub.tax-rate.tax-code = buf_tax.tax-code
      668                         and ub.tax-rate.status_  <>   'удал':U:
      669                           create cash-txr.
      670                           assign
      671                           cash-txr.tax-code = tax-rate.tax-code
      672                           cash-txr.rate-code = tax-rate.rate-code
      673                           cash-txr.tax-type = buf_tax.tax-type
      674                           cash-txr.host-code = p-host-code
      675                           cash-txr.obj-type = p-obj-type
      676                           cash-txr.obj-code = p-obj-code
      677                           cash-txr.status_ = tax-rate.status_
      678                           cash-txr.rc = RECID(tax-rate)
      679                           cash-txr.crf = ii
      680                           ii = ii + 1
      681                           .
      682   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      684     (input  recid(ub.tax-rate)
      685     ,input  0
      686     ,input  0
      687     ,input  ?
      688     ,input  p-host-code
      689     ,input  p-obj-type
      690     ,input  p-obj-code
      691     ,output cash-txr.rate-value
      692     ) no-error .
      693                           if error-status:error then next _tax-rate.
      694          END.
      695       end.
      696       else do:
      697          for each cash-txr where cash-txr.tax-code = tax-rate.tax-code:
      698             delete cash-txr.
      699          end.
      700          _tax-rate2:
      701           FOR EACH ub.tax-rate NO-LOCK WHERE
      702                             ub.tax-rate.tax-code = buf_tax.tax-code
      703                         and ub.tax-rate.status_  <>   'удал':U:
      704                           create cash-txr.
      705                           assign
      706                           cash-txr.tax-code = tax-rate.tax-code
      707                           cash-txr.rate-code = tax-rate.rate-code
      708                           cash-txr.tax-type = buf_tax.tax-type
      709                           cash-txr.host-code = p-host-code
      710                           cash-txr.obj-type = p-obj-type
      711                           cash-txr.obj-code = p-obj-code
      712                           cash-txr.status_ = tax-rate.status_
      713                           cash-txr.rc = RECID(tax-rate)
      714                           cash-txr.crf = ii
      715                           ii = ii + 1
      716                           .
      717   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      719     (input  recid(ub.tax-rate)
      720     ,input  0
      721     ,input  0
      722     ,input  ?
      723     ,input  p-host-code
      724     ,input  p-obj-type
      725     ,input  p-obj-code
      726     ,output cash-txr.rate-value
      727     ) no-error .
      728                           if error-status:error then next _tax-rate2.
      729          END.
      730       end.
      731       find first cash-txr where
      732             cash-txr.tax-code = p-tax-code
      733         AND cash-txr.rate-code = p-rate-code
      734         no-error .
      735       if not avail cash-txr and  p-status_ <> 'удал':U
      736       then do:
      737          create cash-txr.
      738          assign
      739          cash-txr.tax-code  = p-tax-code
      740          cash-txr.rate-code = p-rate-code
      741          cash-txr.host-code = p-host-code
      742          cash-txr.obj-type  = p-obj-type
      743          cash-txr.obj-code  = p-obj-code
      744          cash-txr.tax-type  = p-tax-type
      745          cash-txr.crf       = p-crf
      746          cash-txr.rc        = p-rec
      747          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
      748          .
      749       end.
      750       if  avail cash-txr
      751       then do:
      752          if p-status_ eq 'удал':U
      753          then
      754             delete cash-txr.
      755          else assign
      756          cash-txr.tax-code  = p-tax-code
      757          cash-txr.rate-code = p-rate-code
      758          cash-txr.host-code = p-host-code
      759          cash-txr.obj-type  = p-obj-type
      760          cash-txr.obj-code  = p-obj-code
      761          cash-txr.tax-type  = p-tax-type
      762          cash-txr.crf       = p-crf
      763          cash-txr.rc        = p-rec
      764          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
      765          .
      766       end.
      767       release cash-txr.
      768     end.
      769   end.
      770   end procedure.
      771   procedure fill-stpl-list :
      772   define parameter buffer buf_stop-list for ub.stop-list.
      773   do
      774   on error undo, return error
      775   :
      776     find first stpl-list where
      777               stpl-list.classif-type =  buf_stop-list.classif-type
      778           and stpl-list.stop-list-code = buf_stop-list.stop-list-code no-error .
      779     if not avail stpl-list then do:
      780       create stpl-list.
      781       buffer-copy buf_stop-list
      782       to stpl-list.
      783       release stpl-list.
      784     end.
      785   end.
      786   end procedure.
      787   procedure fill-pbc-list :
      788   define input parameter p-rc as recid no-undo .
      789   define input parameter p-gds-code as integer no-undo .
      790   define input parameter p-b-code as integer no-undo .
      791   define input parameter p-b-str as character no-undo .
      792   define input parameter p-bc-on as logical no-undo .
      793   define input parameter p-del as logical no-undo .
      794   do
      795   on error undo, return error
      796   :
      797     if p-bc-on = false
      798     or p-del = yes
      799     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
      800                               no-lock ) then do:
      801       find first pbc-list where pbc-list.rc = p-rc no-error.
      802       if not available pbc-list then do:
      803         create pbc-list.
      804       end.
      805       assign
      806       pbc-list.b-code = p-b-code
      807       pbc-list.b-str = p-b-str
      808       pbc-list.rc = p-rc
      809       pbc-list.bc-on = p-bc-on
      810       pbc-list.del = p-del
      811       .
      812       release pbc-list .
      813     end.
      814   end.
      815   end procedure.
      816   procedure fill-bar-code :
      817   define input parameter p-b-code as integer no-undo .
      818   define input parameter p-gds-code as integer no-undo .
      819   define input parameter p-del as logical no-undo .
      820   define input parameter p-node-code as integer no-undo .
      821   define input parameter p-in-code as character no-undo .
      822   define input parameter p-part-code as character no-undo .
      823   define input parameter p-cli-base-rate as decimal no-undo .
      824   define input parameter p-unit-cli as character no-undo .
      825   do
      826   on error undo, return error
      827   :
      828     if p-del = yes
      829     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
      830                               no-lock ) then do:
      831       find first bc-list where
      832               bc-list.b-code = p-b-code and bc-list.del = p-del no-error.
      833       if not avail bc-list then do:
      834         create bc-list.
      835         assign
      836         bc-list.gds-code = p-gds-code
      837         bc-list.b-code = p-b-code
      838         bc-list.node-code = p-node-code
      839         bc-list.in-code = p-in-code
      840         bc-list.part-code = p-part-code
      841         bc-list.cli-base-rate = p-cli-base-rate
      842         bc-list.unit-cli = p-unit-cli
      843         bc-list.del = p-del
      844         .
      845       end.
      846     end.
      847   end.
      848   end procedure.
      849   procedure fill-pdf :
      850   define input parameter p-plt-id as integer no-undo .
      851   define input parameter p-plt-db-num as integer no-undo .
      852   define input parameter p-pdf-id as integer no-undo .
      853   define input parameter p-pdf-db-num as integer no-undo .
      854   define input parameter p-del as logical no-undo .
      855   define buffer buf_pdf-list for pdf-list.
      856   do
      857   on error undo, return error
      858   :
      859     find first pdf-list where
      860              pdf-list.plt-id = p-plt-id
      861          and pdf-list.plt-db-num = p-plt-db-num
      862          and pdf-list.pdf-id = p-pdf-id
      863          and pdf-list.pdf-db = p-pdf-db-num no-error.
      864     if not available pdf-list then do:
      865       find last buf_pdf-list use-index oi no-error.
      866       create pdf-list.
      867       assign
      868       pdf-list.plt-id = p-plt-id
      869       pdf-list.plt-db-num = p-plt-db-num
      870       pdf-list.pdf-id = p-pdf-id
      871       pdf-list.pdf-db = p-pdf-db-num
      872       pdf-list.to-del = p-del
      873       pdf-list.order-num = (if available buf_pdf-list then buf_pdf-list.order-num + 1 else 1)
      874       .
      875       release pdf-list.
      876     end.
      877   end.
      878   end procedure.
      879   for each ub.goods no-lock:
      880       run fill-gds-list(buffer ub.goods).
      881   end.
      882   run send-to-cash.
