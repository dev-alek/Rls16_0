      754   DEFINE VARIABLE f-tank-density AS DECIMAL FORMAT "9.9999999999":U INITIAL ?
      755        LABEL "Плотность топлива"
      756        VIEW-AS FILL-IN
      757        SIZE 14 BY 1 NO-UNDO.
      758   DEFINE VARIABLE f-tank-density-pomi AS DECIMAL FORMAT "9.9999999999":U INITIAL ?
      759        LABEL "Плотность топлива для ПО МИ"
      760        VIEW-AS FILL-IN
      761        SIZE 14 BY 1 NO-UNDO.
      762   DEFINE VARIABLE f-tank-temp AS DECIMAL FORMAT "->9.999":U INITIAL ?
      763        LABEL "Температура"
      764        VIEW-AS FILL-IN
      765        SIZE 7.38 BY 1 NO-UNDO.
      766   DEFINE VARIABLE f-tank-vol AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.999":U INITIAL 0
      767        LABEL "Объем топлива"
      768        VIEW-AS FILL-IN
