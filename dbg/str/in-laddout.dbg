      673        VIEW-AS FILL-IN
      674        SIZE 14 BY 1 NO-UNDO.
      675   DEFINE VARIABLE f-autoent-obj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL ?
      676        LABEL "Автопредприятие"
      677        VIEW-AS FILL-IN
      678        SIZE 11 BY 1 NO-UNDO.
      679   DEFINE VARIABLE f-autoent-obj-name AS CHARACTER FORMAT "X(256)":U
      680        VIEW-AS FILL-IN
      681        SIZE 43.88 BY 1.04 NO-UNDO.
      682   DEFINE VARIABLE f-autoent-obj-type AS CHARACTER FORMAT "X(3)":U
      683        VIEW-AS FILL-IN
