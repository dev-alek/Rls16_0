      591   define input-output parameter p-place-si          as   character             no-undo .
      592   define input-output parameter p-tank-density-pomi as   character             no-undo .
      593   define input-output parameter p-certif-fuel       as   character             no-undo .
      594   define input-output parameter p-norm-doc          as   character             no-undo .
      595   define input-output parameter p-num-passport      as   character             no-undo .
      596   define input-output parameter p-validity-certif   as   character             no-undo .
      597   define input-output parameter p-passport-plotn    as   character             no-undo .
      598   define input-output parameter p-num-plotn         as   character             no-undo .
      599   define input-output parameter p-date-pov-plotn    like ub.rvs-line.real-date no-undo .
      600   define       output parameter p-was-setting       as   logical               no-undo initial no .
      601   define variable v-log as logical no-undo .
      602   define variable v-autoent-obj-type as character no-undo.
      603   define variable v-autoent-obj-code as integer no-undo.
      604   define variable v-last-gds-code like ub.goods.gds-code no-undo .
      605   define variable pomi-licvalue as character no-undo.
      606   define variable pomi-lictype  as character no-undo.
      607   define stream outstream.
      608     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      609       define variable v-answ as logical no-undo .
      610       if ( p-unit-base-cli-eq = true
      611            and p-density = 1.0
      612          )
      613         or ( p-unit-base-cli-eq = false
      614              and p-density <> ?
      615              and p-density > 0.0
      616              and p-density < 1.0
      617            )
      618       then do:
      619         assign
      620           v-answ = true
      621         .
      622       end.
      623       else do:
      624         assign
      625           v-answ = false
      626         .
      627       end.
      628       return v-answ.
      629     end function.
      630   define buffer buf_goods for ub.goods .
      631   DEFINE BUTTON b-auto-tank
