      691        VIEW-AS FILL-IN
      692        SIZE 14 BY 1 NO-UNDO.
      693   DEFINE VARIABLE f-date-end AS DATE FORMAT "99/99/99":U
      694        LABEL "Дата конца слива"
      695        VIEW-AS FILL-IN
      696        SIZE 10 BY .88 NO-UNDO.
      697   DEFINE VARIABLE f-date-start AS DATE FORMAT "99/99/99":U
      698        LABEL "Дата начала слива"
      699        VIEW-AS FILL-IN
      700        SIZE 10 BY .88 NO-UNDO.
      701   DEFINE VARIABLE f-diameter AS DECIMAL FORMAT "->>>,>>9.99":U INITIAL 0
      702        LABEL "Внутренний диаметр горловины"
      703        VIEW-AS FILL-IN
      704        SIZE 14 BY 1 NO-UNDO.
      705   DEFINE VARIABLE f-fio AS CHARACTER FORMAT "X(256)":U
      706        LABEL "Ф.И.О. водителя-экспедитора"
      707        VIEW-AS FILL-IN
      708        SIZE 49.5 BY 1 NO-UNDO.
      709   DEFINE VARIABLE f-hour-end AS INTEGER FORMAT "99":U INITIAL ?
      710        LABEL "Время конца слива"
      711        VIEW-AS FILL-IN
      712        SIZE 3 BY 1 NO-UNDO.
      713   DEFINE VARIABLE f-hour-income AS INTEGER FORMAT "99":U INITIAL ?
      714        LABEL "Время прибытия на АЗС"
      715        VIEW-AS FILL-IN
      716        SIZE 3 BY 1 NO-UNDO.
      717   DEFINE VARIABLE f-hour-pour AS INTEGER FORMAT "99":U INITIAL ?
