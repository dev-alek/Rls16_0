      780        VIEW-AS FILL-IN
      781        SIZE 14 BY 1 NO-UNDO.
      782   DEFINE VARIABLE f-place-si AS INTEGER FORMAT ">>>,>>9":U INITIAL 0
      783        LABEL "Средство измерения"
      784        VIEW-AS FILL-IN
      785        SIZE 5.63 BY 1 NO-UNDO.
      786   DEFINE RECTANGLE RECT-1
      787        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      788        SIZE 80.25 BY 8.25.
      789   DEFINE RECTANGLE RECT-3
      790        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      791        SIZE 80.13 BY 4.21.
      792   DEFINE FRAME Dialog-Frame
      793        b-save AT ROW 1 COL 2
      794        b-quit AT ROW 1 COL 12
      795        b-help AT ROW 1 COL 71
      796        f-autoent-obj-code AT ROW 2.46 COL 16 COLON-ALIGNED
      797        f-autoent-obj-type AT ROW 2.46 COL 27.75 COLON-ALIGNED NO-LABEL
      798        f-autoent-obj-name AT ROW 2.46 COL 36 COLON-ALIGNED NO-LABEL
      799        b-clients AT ROW 2.58 COL 34.5
      800        f-car-num AT ROW 3.75 COL 20 COLON-ALIGNED
      801        f-car-vol AT ROW 3.75 COL 65.75 COLON-ALIGNED
      802        b-auto-tank AT ROW 3.79 COL 36.38
      803        f-tests AT ROW 4.92 COL 20.13 COLON-ALIGNED
      804        f-fio AT ROW 6.04 COL 30 COLON-ALIGNED
      805        f-ptbocode AT ROW 7.25 COL 16 COLON-ALIGNED
      806        f-ptbotype AT ROW 7.25 COL 27.75 COLON-ALIGNED NO-LABEL
      807        f-ptboname AT ROW 7.25 COL 36 COLON-ALIGNED NO-LABEL
      808        b-ptb AT ROW 7.38 COL 34.5
      809        f-hour-pour AT ROW 8.25 COL 73 COLON-ALIGNED
      810        f-min-pour AT ROW 8.25 COL 76.5 COLON-ALIGNED NO-LABEL
      811        f-item-pour AT ROW 9.5 COL 1.5 NO-LABEL
      812        f-tank-water AT ROW 11.71 COL 64.75 COLON-ALIGNED
      813        f-mouth AT ROW 11.79 COL 20.75 COLON-ALIGNED
      814        f-tank-vol AT ROW 12.96 COL 20.63 COLON-ALIGNED
      815        f-tank-temp AT ROW 12.96 COL 64.75 COLON-ALIGNED
      816        f-tank-density AT ROW 14.13 COL 20.5 COLON-ALIGNED
      817        b-calc AT ROW 14.13 COL 37.5 WIDGET-ID 22
      818        f-tank-weight AT ROW 14.13 COL 64.75 COLON-ALIGNED
      819        f-a-b-tarir AT ROW 15.13 COL 64.75 COLON-ALIGNED WIDGET-ID 2
      820        f-place-si AT ROW 16.25 COL 20.5 COLON-ALIGNED WIDGET-ID 16
      821        r-sr-izm AT ROW 16.25 COL 28.5 WIDGET-ID 18
      822        f-diameter AT ROW 16.25 COL 64.75 COLON-ALIGNED WIDGET-ID 20
      823        f-tank-density-pomi AT ROW 17.5 COL 29.5 COLON-ALIGNED WIDGET-ID 24
      824        f-hour-income AT ROW 19.54 COL 71.75 COLON-ALIGNED
      825        f-min-income AT ROW 19.54 COL 75.38 COLON-ALIGNED NO-LABEL
      826        f-date-start AT ROW 21.25 COL 19.75 COLON-ALIGNED
      827        f-hour-start AT ROW 21.25 COL 71.75 COLON-ALIGNED
      828        f-min-start AT ROW 21.25 COL 75.38 COLON-ALIGNED NO-LABEL
      829        f-date-end AT ROW 22.33 COL 19.75 COLON-ALIGNED
      830        f-hour-end AT ROW 22.33 COL 71.75 COLON-ALIGNED
      831        f-min-end AT ROW 22.33 COL 75.38 COLON-ALIGNED NO-LABEL
      832        "Характеристики цистерны" VIEW-AS TEXT
      833             SIZE 23.63 BY .75 AT ROW 10.75 COL 26.25
      834        "Примечание к нефтебазе" VIEW-AS TEXT
      835             SIZE 25.5 BY 1 AT ROW 8.5 COL 1.5
      836        RECT-3 AT ROW 19.25 COL 1.5
      837        RECT-1 AT ROW 10.71 COL 1.5
      838        SPACE(0.12) SKIP(4.74)
      839       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      840            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      841            TITLE "Дополнительная информация по приемке топлива"
      842            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
      843   ASSIGN
      844          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      845          FRAME Dialog-Frame:HIDDEN           = TRUE.
      846   ON GO OF FRAME Dialog-Frame
      847   DO:
      848     define variable stfactplvalue as character no-undo initial ? .
      849     define variable stfactpltype  as character no-undo initial ? .
      850     define variable v-update      as logical   no-undo initial true .
      851     define variable v-revision    as logical   no-undo initial false .
      852     define variable v-percrev     as decimal   no-undo initial ? .
      853     define variable v-auto-tank   as logical   no-undo initial false .
      854     define variable v-percauto    as decimal   no-undo initial ? .
      855     define variable v-inv         as logical   no-undo initial false .
      856     define variable v-percinv     as decimal   no-undo initial ? .
      857     define variable v-inv-set     as logical   no-undo initial false .
      858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      859     (input  'stfactpl'
      860     ,input  ''
      861     ,input  ''
      862     ,input  0
      863     ,input  ''
      864     ,input  ''
      865     ,input  ''
      866     ,input  no
      867     ,output stfactplvalue
      868     ,output stfactpltype
      869     ) no-error .
      870     if error-status :error then do:
      871     end.
      872     if stfactplvalue <> "":U then do:
      873   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_chkqtpl in g#lib-calc
      874     (  input stfactplvalue
      875     , output v-update
      876     , output v-revision
      877     , output v-percrev
      878     , output v-auto-tank
      879     , output v-percauto
      880     , output v-inv
      881     , output v-percinv
      882     , output v-inv-set
      883     )  .
      884     end.
      885     if v-auto-tank = true
      886       or v-inv = true
      887     then do:
      888       if input frame Dialog-Frame f-car-vol <= 0 or
      889          input frame Dialog-Frame f-car-vol = ?
      890       then do:
      891         message "Объем по паспорту в литрах должен быть больше 0." view-as alert-box .
      892         apply "entry" to f-car-vol in frame Dialog-Frame .
      893         return no-apply .
      894       end.
      895       if input frame Dialog-Frame f-tank-vol <= 0 or
      896          input frame Dialog-Frame f-tank-vol  = ?
      897       then do:
      898         message "Объем топлива должен быть больше 0." view-as alert-box .
      899         apply "entry" to f-tank-vol in frame Dialog-Frame .
      900         return no-apply .
      901       end.
      902       if input frame Dialog-Frame f-tank-weight <= 0 or
      903          input frame Dialog-Frame f-tank-weight  = ?
      904       then do:
      905         message "Вес топлива должен быть больше 0." view-as alert-box .
      906         apply "entry" to f-tank-weight in frame Dialog-Frame .
      907         return no-apply .
      908       end.
      909       if input frame Dialog-Frame f-tank-density = ?
      910         or Valid-Density( input frame Dialog-Frame f-tank-density, (buf_goods.unit-base = buf_goods.unit-cli) ) <> yes
      911       then do:
      912         message "Плотность должна быть больше 0 и меньше 1." view-as alert-box .
      913         apply "entry" to f-tank-density in frame Dialog-Frame .
      914         return no-apply .
      915       end.
      916     end.
      917     if input frame Dialog-Frame f-tank-density <> ?
      918       and Valid-Density( input frame Dialog-Frame f-tank-density, (buf_goods.unit-base = buf_goods.unit-cli) ) <> yes
      919     then do:
      920       message "Плотность должна быть больше 0 и меньше 1." view-as alert-box .
      921       apply "entry" to f-tank-density in frame Dialog-Frame .
      922       return no-apply .
      923     end.
      924     if input frame Dialog-Frame f-hour-pour <> ?
      925       and input frame Dialog-Frame f-hour-pour > 24
      926     then do:
      927        message "Неверно заведено поле <<час>>." view-as alert-box .
      928        apply "entry" to f-hour-pour in frame Dialog-Frame .
      929        return no-apply .
      930     end.
      931     if input frame Dialog-Frame f-hour-start <> ?
      932       and input frame Dialog-Frame f-hour-start > 24
      933     then do:
      934        message "Неверно заведено поле <<час>>." view-as alert-box .
      935        apply "entry" to f-hour-start in frame Dialog-Frame .
      936        return no-apply .
      937     end.
      938     if input frame Dialog-Frame f-hour-income > 24
      939     then do:
      940        message "Неверно заведено поле <<час>>." view-as alert-box .
      941        apply "entry" to f-hour-income in frame Dialog-Frame .
      942        return no-apply .
      943     end.
      944     if input frame Dialog-Frame f-hour-end > 24
      945     then do:
      946        message "Неверно заведено поле час." view-as alert-box .
      947        apply "entry" to f-hour-end in frame Dialog-Frame .
      948        return no-apply .
      949     end.
      950     if input frame Dialog-Frame f-min-pour > 60
      951     then do:
      952        message "Неверно заведено поле <<минуты>>." view-as alert-box .
      953        apply "entry" to f-min-pour in frame Dialog-Frame .
      954        return no-apply .
      955     end.
      956     if input frame Dialog-Frame f-min-income > 60
      957     then do:
      958        message "Неверно заведено поле <<минуты>>." view-as alert-box .
      959        apply "entry" to f-min-income in frame Dialog-Frame .
      960        return no-apply .
      961     end.
      962     if input frame Dialog-Frame f-min-start > 60
      963     then do:
      964        message "Неверно заведено поле <<минуты>>." view-as alert-box .
      965        apply "entry" to f-min-start in frame Dialog-Frame .
      966        return no-apply .
      967     end.
      968     if input frame Dialog-Frame f-min-end > 60
      969     then do:
      970        message "Неверно заведено поле <<минуты>>." view-as alert-box .
      971        apply "entry" to f-min-end in frame Dialog-Frame .
      972        return no-apply .
      973     end.
      974     assign frame Dialog-Frame f-car-num f-car-vol f-tests
      975                                f-autoent-obj-type f-autoent-obj-code
      976                                f-item-pour f-hour-pour f-min-pour
      977                                f-hour-income f-min-income
      978                                f-hour-start f-min-start
      979                                f-hour-end f-min-end
      980                                f-date-start f-date-end
      981                                f-tank-vol f-tank-temp
      982                                f-tank-water f-tank-density
      983                                f-mouth f-fio
      984                                f-ptbocode
      985                                f-ptbotype
      986                                f-a-b-tarir
      987     .
      988     find clients no-lock where
      989          clients.obj-type = f-autoent-obj-type and
      990          clients.obj-code = f-autoent-obj-code no-error .
      991     if not available clients
      992     then do:
      993       assign
      994         v-log = no
      995       .
      996       message "Не найдено автопредприятие " f-autoent-obj-type " " f-autoent-obj-code " ." skip
      997               "Cохраняемся без ссылки на автопредприятие?"
      998       view-as alert-box question buttons yes-no update v-log .
      999       if v-log <> yes
     1000       then do:
     1001         return no-apply .
     1002       end.
     1003       assign
     1004         f-autoent-obj-type = ""
     1005         f-autoent-obj-code = ?
     1006       .
     1007     end.
     1008     find clients no-lock where
     1009          clients.obj-type = f-ptbotype and
     1010          clients.obj-code = f-ptbocode no-error .
     1011     if not available clients
     1012     then do:
     1013       assign
     1014         v-log = no
     1015       .
     1016       message "Не найдена нефтебаза " f-ptbotype " " f-ptbocode " ." skip
     1017               "Cохраняемся без ссылки на нефтебазу?"
     1018       view-as alert-box question buttons yes-no update v-log .
     1019       if v-log <> yes
     1020       then do:
     1021         return no-apply .
     1022       end.
     1023       assign
     1024         f-ptbotype = ""
     1025         f-ptbocode = ?
     1026       .
     1027     end.
     1028     assign
     1029       f-tank-weight = f-tank-vol * f-tank-density
     1030     .
     1031     assign
     1032       p-car-num          = f-car-num
     1033       p-car-vol          = string( f-car-vol )
     1034       p-tests            = f-tests
     1035       p-autoent-obj-type = f-autoent-obj-type
     1036       p-autoent-obj-code = string( f-autoent-obj-code )
     1037       p-item-pour        = f-item-pour
     1038       p-time-pour        = string( f-hour-pour,   "99":U ) + ":" + string( f-min-pour,   "99":U )
     1039       p-time-income      = string( f-hour-income, "99":U ) + ":" + string( f-min-income, "99":U )
     1040       p-time-start       = f-hour-start * 3600 + f-min-start * 60
     1041       p-time-end         = f-hour-end   * 3600 + f-min-end   * 60
     1042       p-date-start       = f-date-start
     1043       p-date-end         = f-date-end
     1044       p-mouth            = string( f-mouth )
     1045       p-fio              = f-fio
     1046       p-ptbotype         = f-ptbotype
     1047       p-ptbocode         = string( f-ptbocode     )
     1048       p-tank-vol         = string( f-tank-vol     )
     1049       p-tank-temp        = string( f-tank-temp    )
     1050       p-tank-water       = string( f-tank-water   )
     1051       p-tank-density     = string( f-tank-density )
     1052       p-tank-weight      = string( f-tank-weight  )
     1053       p-a-b-tarir        = string( f-a-b-tarir    )
     1054       p-diameter         = string( f-diameter     )
     1055       p-place-si         = string( f-place-si     )
     1056       p-tank-density-pomi = string( f-tank-density-pomi )
     1057     no-error .
     1058     assign
     1059       p-was-setting = yes
     1060     .
     1061   END.
     1062   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1063   DO:
     1064     APPLY "END-ERROR":U TO SELF.
     1065   END.
     1066   ON CHOOSE OF b-auto-tank IN FRAME Dialog-Frame
     1067   DO:
     1068   define variable v-rec-tank as recid     no-undo.
     1069   define variable v-rec-meas as recid     no-undo.
     1070   assign v-rec-tank = ?
     1071          v-rec-meas = ?.
     1072   if v-autoent-obj-code <> 0 and v-autoent-obj-code <> ?
     1073   and can-find (first auto-tank-attr no-lock where auto-tank-attr.attr-code = "auto-firm"
     1074                                                and auto-tank-attr.attr-value = v-autoent-obj-type + string(v-autoent-obj-code))
     1075   then do :
     1076     run str/auto-tn.w (input parparentproc,
     1077                   input "b-sel",
     1078                   input v-autoent-obj-type,
     1079                   input v-autoent-obj-code,
     1080                   output v-rec-tank,
     1081                   output v-rec-meas) no-error.
     1082   end.
     1083   else do :
     1084     message
     1085     "Вы не указали автопредприятие или для " skip
     1086     "указанного автопредприятия нет автоцистерн."   skip
     1087     "Справочник будет открыт для всех автоцистерн." skip
     1088     view-as alert-box information.
     1089     run str/auto-tn.w (input parparentproc,
     1090                   input "b-sel",
     1091                   input "",
     1092                   input 0,
     1093                   output v-rec-tank,
     1094                   output v-rec-meas) no-error.
     1095   end.
     1096   if v-rec-tank <> ? then do:
     1097     find first auto-tank where recid (auto-tank) = v-rec-tank no-lock.
     1098     assign
     1099         f-car-num    = auto-tank.auto-num
     1100         f-car-vol    = auto-tank.brutto-qnty
     1101         f-tank-vol   = f-car-vol
     1102     .
     1103     display f-car-num f-car-vol with frame Dialog-Frame.
     1104     if v-rec-meas <> ? then do:
     1105       find first auto-tank-meas where recid (auto-tank-meas) = v-rec-meas no-lock.
     1106       assign
     1107           f-tank-vol = auto-tank-meas.meas-qnty
     1108       .
     1109     end.
     1110     assign
     1111         f-mouth    = f-tank-vol - f-car-vol
     1112     .
     1113     display
     1114       f-tank-vol
     1115       f-mouth
     1116     with frame Dialog-Frame.
     1117   end.
     1118   END.
     1119   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     1120   DO:
     1121     define variable ToolType                as integer no-undo.
     1122     define variable DeltaAbs_R              as decimal no-undo.
     1123     define variable DeltaAbs_Tv             as decimal no-undo.
     1124     define variable DeltaAbs_Tr             as decimal no-undo.
     1125     define variable temp-for-pomi           as integer no-undo.
     1126     define variable error-string            as character no-undo.
     1127     define variable v-mm as com-handle.
     1128     define variable v-proc as character no-undo.
     1129     define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     1130     assign
     1131     f-car-vol
     1132     f-tank-vol
     1133     f-a-b-tarir
     1134     f-diameter
     1135     f-tank-temp
     1136     f-tank-density-pomi
     1137     .
     1138     IF pomi-licvalue = "yes" THEN DO :
     1139       _trpomi :
     1140         do on error undo, return no-apply :
     1141         find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = f-place-si no-error.
     1142         if not available buf_sr-izmerenia then do :
     1143           message
     1144             substitute( 'Не найдено средство измерения с кодом &1', f-place-si ) skip
     1145           view-as alert-box error.
     1146           undo _trpomi, return no-apply  .
     1147         end.
     1148         else do :
     1149           assign
     1150             ToolType               = buf_sr-izmerenia.sr-type-id
     1151             DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     1152             DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     1153             DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     1154             .
     1155         end.
     1156         find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1157   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1158   run get-ptrl-prop in this-procedure
     1159     ( input trn-doc.obj-type
     1160     , input trn-doc.obj-code
     1161     ) .
     1162         if not error-status :error then do:
     1163           if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     1164                                         else temp-for-pomi = 20 .
     1165         end.
     1166         v-proc = "Rosneft.MethodOfMetering31" .
     1167         RELEASE OBJECT v-mm NO-ERROR.
     1168         v-mm = ?.
     1169         CREATE value("Rosneft.MethodOfMetering31") v-mm no-error.
     1170         IF ERROR-STATUS:ERROR
     1171         OR NOT VALID-HANDLE(v-mm)
     1172         THEN DO:
     1173           RELEASE OBJECT v-mm NO-ERROR.
     1174           v-mm = ?.
     1175           message
     1176             substitute( 'Не удается подключиться к COM-серверу библиотеки для работы с ПО МИ ' ) skip
     1177           view-as alert-box error.
     1178           undo _trpomi, return no-apply .
     1179         END.
     1180         ELSE DO :
     1181           if f-car-vol = ? or f-car-vol = 0 then do :
     1182             message
     1183               "Заполнены не все поля, необходимые " skip
     1184               "для работы библиотеки ПО МИ"         skip
     1185               "Введите Объем по паспорту в литрах"  skip
     1186             view-as alert-box error.
     1187             apply "entry" to f-car-vol in frame Dialog-Frame .
     1188             undo _trpomi, return no-apply  .
     1189           end.
     1190           if f-a-b-tarir = ? or f-a-b-tarir = 0 then do :
     1191             message
     1192               "Заполнены не все поля, необходимые " skip
     1193               "для работы библиотеки ПО МИ"         skip
     1194               "Введите Уровень цистерны относительно тарировочной планки"  skip
     1195             view-as alert-box error.
     1196             apply "entry" to f-a-b-tarir in frame Dialog-Frame .
     1197             undo _trpomi, return no-apply  .
     1198           end.
     1199           if f-diameter = ? or f-diameter = 0 then do :
     1200             message
     1201               "Заполнены не все поля, необходимые " skip
     1202               "для работы библиотеки ПО МИ"         skip
     1203               "Введите Внутренний диаметр горловины"  skip
     1204             view-as alert-box error.
     1205             apply "entry" to f-diameter in frame Dialog-Frame .
     1206             undo _trpomi, return no-apply  .
     1207           end.
     1208           if f-tank-temp = ? then do :
     1209             message
     1210               "Заполнены не все поля, необходимые " skip
     1211               "для работы библиотеки ПО МИ"         skip
     1212               "Введите Температуру"  skip
     1213             view-as alert-box error.
     1214             apply "entry" to f-tank-temp in frame Dialog-Frame .
     1215             undo _trpomi, return no-apply  .
     1216           end.
     1217           if f-tank-density-pomi = ? or f-tank-density-pomi = 0 then do :
     1218             message
     1219               "Заполнены не все поля, необходимые " skip
     1220               "для работы библиотеки ПО МИ"         skip
     1221               "Введите Плотность топлива для ПО МИ"  skip
     1222             view-as alert-box error.
     1223             apply "entry" to f-tank-density-pomi in frame Dialog-Frame .
     1224             undo _trpomi, return no-apply  .
     1225           end.
     1226           ASSIGN
     1227             v-mm:V_real                 = f-car-vol
     1228             v-mm:DeltaH                 = f-a-b-tarir
     1229             v-mm:Dgor                   = f-diameter
     1230             v-mm:Tv                     = f-tank-temp
     1231             v-mm:Tr                     = f-tank-temp
     1232             v-mm:R                      = ( f-tank-density-pomi * 1000 )
     1233             v-mm:Tcy                    = temp-for-pomi
     1234             v-mm:ToolType               = ToolType
     1235             v-mm:A_Reservoir            = 0.0000125
     1236             v-mm:DeltaOtn_V             = 0.4
     1237             v-mm:DeltaAbs_R             = DeltaAbs_R
     1238             v-mm:DeltaAbs_Tv            = DeltaAbs_Tv
     1239             v-mm:DeltaAbs_Tr            = DeltaAbs_Tr
     1240           .
     1241           output stream outstream to value ("pomi.log") append.
     1242           put stream outstream
     1243                                        cur-time-string()       skip
     1244             'Процедура'                v-proc                  skip
     1245             'V_real                 =' f-car-vol               skip
     1246             'DeltaH                 =' f-a-b-tarir             skip
     1247             'Dgor                   =' f-diameter              skip
     1248             'Tv                     =' f-tank-temp             skip
     1249             'Tr                     =' f-tank-temp             skip
     1250             'R                      =' ( f-tank-density-pomi * 1000 ) skip
     1251             'Tcy                    =' temp-for-pomi           skip
     1252             'ToolType               =' ToolType                skip
     1253             'A_Reservoir            =' 0.0000125               skip
     1254             'DeltaOtn_V             =' 0.4                     skip
     1255             'DeltaAbs_R             =' DeltaAbs_R              skip
     1256             'DeltaAbs_Tv            =' DeltaAbs_Tv             skip
     1257             'DeltaAbs_Tr            =' DeltaAbs_Tr             skip
     1258           .
     1259           output stream outstream close.
     1260           v-mm:Exec() .
     1261           if v-mm:Result <> 0 then do :
     1262             error-string = v-mm:ResultDetail .
     1263             output stream outstream to value ("pomi.log") append.
     1264               put stream outstream error-string format "x(1024)" skip.
     1265             output stream outstream close.
     1266             RELEASE OBJECT v-mm NO-ERROR.
     1267             v-mm = ?.
     1268             message
     1269               substitute('Ошибка работы библиотеки ПО МИ &1',error-string) skip
     1270             view-as alert-box error.
     1271             undo _trpomi, return no-apply  .
     1272           end.
     1273           else do :
     1274             assign
     1275               f-tank-density    = decimal(v-mm:Rcy) / 1000
     1276               f-tank-vol        = v-mm:Vcy
     1277               f-tank-weight     = v-mm:Mcy
     1278             .
     1279             display
     1280               f-tank-density
     1281               f-tank-vol
     1282               f-tank-weight
     1283             with frame Dialog-Frame.
     1284             output stream outstream to value ("pomi.log") append.
     1285               put stream outstream
     1286               "v-mm:Rcy" f-tank-density      skip
     1287               "v-mm:Vcy" f-tank-vol          skip
     1288               "v-mm:Mcy" f-tank-weight       skip .
     1289             output stream outstream close.
     1290             RELEASE OBJECT v-mm NO-ERROR.
     1291             v-mm = ?.
     1292           end.
     1293         END.
     1294       end.
     1295     END.
     1296     enable
     1297     f-tank-density
     1298     with frame Dialog-Frame.
     1299   END.
     1300   ON CHOOSE OF b-clients IN FRAME Dialog-Frame
     1301   DO:
     1302   define variable ref-list as character no-undo.
     1303   define variable ref-rec  as recid     no-undo.
     1304   find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1305      run ref/cli-all.w (parparentproc
     1306                   , "b-sel"
     1307                   , 'орг':U
     1308                   , ?
     1309                   , ?
     1310                   , ?
     1311                   , ?
     1312                   , substitute("auto-tank-for-supp=&1&2",ub.trn-doc.cli-type,ub.trn-doc.cli-code)
     1313                   , output ref-list) .
     1314   if ref-list <> "" then do:
     1315     ref-rec = integer (ref-list).
     1316     find clients where recid ( clients ) = ref-rec no-lock.
     1317     disp clients.obj-code @ f-autoent-obj-code
     1318          clients.obj-type @ f-autoent-obj-type
     1319          clients.obj-name @ f-autoent-obj-name with frame Dialog-Frame.
     1320     assign
     1321       v-autoent-obj-type = clients.obj-type
     1322       v-autoent-obj-code = clients.obj-code
     1323     .
     1324   end.
     1325   END.
     1326   ON CHOOSE OF b-ptb IN FRAME Dialog-Frame
     1327   DO:
     1328   define variable ref-list as character no-undo.
     1329   define variable ref-rec  as recid     no-undo.
     1330   find first ub.trn-doc no-lock where ub.trn-doc.doc-code = p-doc-code no-error.
     1331      run ref/cli-all.w (parparentproc
     1332                   , "b-sel"
     1333                   , 'орг':U
     1334                   , ?
     1335                   , ?
     1336                   , ?
     1337                   , ?
     1338                   , substitute("tank-farm-for-supp=&1&2",ub.trn-doc.cli-type,ub.trn-doc.cli-code)
     1339                   , output ref-list) .
     1340   if ref-list <> "" then do:
     1341     ref-rec = integer (ref-list).
     1342     find clients where recid ( clients ) = ref-rec no-lock.
     1343     disp clients.obj-code @ f-ptbocode
     1344          clients.obj-type @ f-ptbotype
     1345          clients.obj-name @ f-ptboname with frame Dialog-Frame.
     1346   end.
     1347   END.
     1348   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1349   DO:
     1350   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   if lookup(self :type
     1352            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1353            ) = 0
     1354   then do:
     1355     message
     1356       "$Workfile$"
     1357       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1358       "Интерфейсный элемент" self :name  skip
     1359       "Тип" self :type  skip
     1360       "Процедура" this-procedure :file-name skip
     1361       view-as alert-box .
     1362   end.
     1363   else do:
     1364     apply "entry":u to self  .
     1365     if focus :handle <> self :handle  then do:
     1366       return no-apply .
     1367     end.
     1368   end.
     1369     apply "LEAVE":U to f-car-vol      in frame Dialog-Frame .
     1370     apply "LEAVE":U to f-tank-density in frame Dialog-Frame .
     1371   END.
     1372   ON LEAVE OF f-autoent-obj-code IN FRAME Dialog-Frame
     1373   DO:
     1374     run disp-obj-name.
     1375   END.
     1376   ON RETURN OF f-autoent-obj-code IN FRAME Dialog-Frame
     1377   DO:
     1378   run disp-obj-name.
     1379   apply "entry" to f-autoent-obj-code in frame Dialog-Frame.
     1380   return no-apply.
     1381   END.
     1382   ON LEAVE OF f-autoent-obj-type IN FRAME Dialog-Frame
     1383   DO:
     1384       run disp-obj-name.
     1385   END.
     1386   ON return OF f-autoent-obj-type IN FRAME Dialog-Frame
     1387   DO:
     1388     run disp-obj-name.
     1389     apply "entry" to f-car-num in frame Dialog-Frame.
     1390   return no-apply.
     1391   END.
     1392   ON return OF f-car-num IN FRAME Dialog-Frame
     1393   DO:
     1394     apply "entry" to f-car-vol in frame Dialog-Frame.
     1395   return no-apply.
     1396   END.
     1397   ON LEAVE OF f-car-vol IN FRAME Dialog-Frame
     1398   DO:
     1399       if pomi-licvalue <> "yes" then do:
     1400           display input frame Dialog-Frame f-car-vol + input frame Dialog-Frame f-mouth @ f-tank-vol with frame Dialog-Frame.
     1401           display input frame Dialog-Frame f-tank-vol *
     1402               input frame Dialog-Frame f-tank-density @ f-tank-weight with frame Dialog-Frame.
     1403       end.
     1404   END.
     1405   ON return OF f-car-vol IN FRAME Dialog-Frame
     1406   DO:
     1407     apply "entry" to f-tests in frame Dialog-Frame.
     1408   return no-apply.
     1409   END.
     1410   ON return OF f-date-end IN FRAME Dialog-Frame
     1411   DO:
     1412       apply "entry" to f-hour-end in frame Dialog-Frame.
     1413   return no-apply.
     1414   END.
     1415   ON return OF f-date-start IN FRAME Dialog-Frame
     1416   DO:
     1417     apply "entry" to f-hour-start in frame Dialog-Frame.
     1418   return no-apply.
     1419   END.
     1420   ON LEAVE OF f-hour-end IN FRAME Dialog-Frame
     1421   DO:
     1422     if input frame Dialog-Frame f-hour-end > 24
     1423     then do:
     1424        message "Неверно заведено поле час." view-as alert-box .
     1425        apply "entry" to f-hour-end in frame Dialog-Frame .
     1426        return no-apply .
     1427     end.
     1428   END.
     1429   ON return OF f-hour-end IN FRAME Dialog-Frame
     1430   DO:
     1431       apply "entry" to f-min-end in frame Dialog-Frame.
     1432   return no-apply.
     1433   END.
     1434   ON LEAVE OF f-hour-income IN FRAME Dialog-Frame
     1435   DO:
     1436     if input frame Dialog-Frame f-hour-income > 24
     1437     then do:
     1438        message "Неверно заведено поле <<час>>." view-as alert-box .
     1439        apply "entry" to f-hour-income in frame Dialog-Frame .
     1440        return no-apply .
     1441     end.
     1442   END.
     1443   ON return OF f-hour-income IN FRAME Dialog-Frame
     1444   DO:
     1445           apply "entry" to f-min-income in frame Dialog-Frame.
     1446   return no-apply.
     1447   END.
     1448   ON LEAVE OF f-hour-pour IN FRAME Dialog-Frame
     1449   DO:
     1450     if input frame Dialog-Frame f-hour-pour > 24
     1451     then do:
     1452        message "Неверно заведено поле <<час>>." view-as alert-box .
     1453        apply "entry" to f-hour-pour in frame Dialog-Frame .
     1454        return no-apply .
     1455     end.
     1456   END.
     1457   ON return OF f-hour-pour IN FRAME Dialog-Frame
     1458   DO:
     1459         apply "entry" to f-min-pour in frame Dialog-Frame.
     1460   return no-apply.
     1461   END.
     1462   ON LEAVE OF f-hour-start IN FRAME Dialog-Frame
     1463   DO:
     1464     if input frame Dialog-Frame f-hour-start > 24
     1465     then do:
     1466        message "Неверно заведено поле <<час>>." view-as alert-box .
     1467        apply "entry" to f-hour-start in frame Dialog-Frame .
     1468        return no-apply .
     1469     end.
     1470   END.
     1471   ON return OF f-hour-start IN FRAME Dialog-Frame
     1472   DO:
     1473   apply "entry" to f-min-start in frame Dialog-Frame.
     1474   return no-apply.
     1475   END.
     1476   ON return OF f-item-pour IN FRAME Dialog-Frame
     1477   DO:
     1478       apply "entry" to f-hour-pour in frame Dialog-Frame.
     1479   return no-apply.
     1480   END.
     1481   ON LEAVE OF f-min-end IN FRAME Dialog-Frame
     1482   DO:
     1483     if input frame Dialog-Frame f-min-end > 60
     1484     then do:
     1485        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     1486        apply "entry" to f-min-end in frame Dialog-Frame .
     1487        return no-apply .
     1488     end.
     1489   END.
     1490   ON return OF f-min-end IN FRAME Dialog-Frame
     1491   DO:
     1492       apply "entry" to b-save in frame Dialog-Frame.
     1493   return no-apply.
     1494   END.
     1495   ON LEAVE OF f-min-income IN FRAME Dialog-Frame
     1496   DO:
     1497     if input frame Dialog-Frame f-min-income > 60
     1498     then do:
     1499        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     1500        apply "entry" to f-min-income in frame Dialog-Frame .
     1501        return no-apply .
     1502     end.
     1503   END.
     1504   ON return OF f-min-income IN FRAME Dialog-Frame
     1505   DO:
     1506           apply "entry" to f-date-start in frame Dialog-Frame.
     1507   return no-apply.
     1508   END.
     1509   ON LEAVE OF f-min-pour IN FRAME Dialog-Frame
     1510   DO:
     1511     if input frame Dialog-Frame f-min-pour > 60
     1512     then do:
     1513        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     1514        apply "entry" to f-min-pour in frame Dialog-Frame .
     1515        return no-apply .
     1516     end.
     1517   END.
     1518   ON return OF f-min-pour IN FRAME Dialog-Frame
     1519   DO:
     1520   apply "entry" to f-mouth in frame Dialog-Frame.
     1521   return no-apply.
     1522   END.
     1523   ON LEAVE OF f-min-start IN FRAME Dialog-Frame
     1524   DO:
     1525     if input frame Dialog-Frame f-min-start > 60
     1526     then do:
     1527        message "Неверно заведено поле <<минуты>>." view-as alert-box .
     1528        apply "entry" to f-min-start in frame Dialog-Frame .
     1529        return no-apply .
     1530     end.
     1531   END.
     1532   ON return OF f-min-start IN FRAME Dialog-Frame
     1533   DO:
     1534     apply "entry" to f-date-end in frame Dialog-Frame.
     1535   return no-apply.
     1536   END.
     1537   ON LEAVE OF f-mouth IN FRAME Dialog-Frame
     1538   DO:
     1539       display input frame Dialog-Frame f-car-vol + input frame Dialog-Frame f-mouth @ f-tank-vol with frame Dialog-Frame.
     1540       display input frame Dialog-Frame f-tank-vol *
     1541             input frame Dialog-Frame f-tank-density @ f-tank-weight with frame Dialog-Frame.
     1542   END.
     1543   ON return OF f-mouth IN FRAME Dialog-Frame
     1544   DO:
     1545   apply "entry" to f-tank-density in frame Dialog-Frame.
     1546   return no-apply.
     1547   END.
     1548   ON LEAVE OF f-ptbocode IN FRAME Dialog-Frame
     1549   DO:
     1550     run disp-f-ptboname.
     1551   END.
     1552   ON RETURN OF f-ptbocode IN FRAME Dialog-Frame
     1553   DO:
     1554       run disp-f-ptboname.
     1555   apply "entry" to f-ptbocode in frame Dialog-Frame.
     1556   return no-apply.
     1557   END.
     1558   ON LEAVE OF f-ptbotype IN FRAME Dialog-Frame
     1559   DO:
     1560       run disp-f-ptboname.
     1561   END.
     1562   ON return OF f-ptbotype IN FRAME Dialog-Frame
     1563   DO:
     1564       run disp-f-ptboname.
     1565       apply "entry" to f-hour-pour in frame Dialog-Frame.
     1566   return no-apply.
     1567   END.
     1568   ON LEAVE OF f-tank-density IN FRAME Dialog-Frame
     1569   DO:
     1570       display input frame Dialog-Frame f-tank-vol *
     1571             input frame Dialog-Frame f-tank-density @ f-tank-weight with frame Dialog-Frame.
     1572   END.
     1573   ON return OF f-tank-density IN FRAME Dialog-Frame
     1574   DO:
     1575         apply "entry" to f-tank-temp in frame Dialog-Frame.
     1576   return no-apply.
     1577   END.
     1578   ON return OF f-tank-temp IN FRAME Dialog-Frame
     1579   DO:
     1580         apply "entry" to f-hour-income in frame Dialog-Frame.
     1581   return no-apply.
     1582   END.
     1583   ON return OF f-tank-vol IN FRAME Dialog-Frame
     1584   DO:
     1585         apply "entry" to f-tank-water in frame Dialog-Frame.
     1586   return no-apply.
     1587   END.
     1588   ON return OF f-tank-water IN FRAME Dialog-Frame
     1589   DO:
     1590         apply "entry" to f-tank-density in frame Dialog-Frame.
     1591   return no-apply.
     1592   END.
     1593   ON return OF f-tank-weight IN FRAME Dialog-Frame
     1594   DO:
     1595         apply "entry" to b-save in frame Dialog-Frame.
     1596   return no-apply.
     1597   END.
     1598   ON return OF f-tests IN FRAME Dialog-Frame
     1599   DO:
     1600       apply "entry" to f-item-pour in frame Dialog-Frame.
     1601   return no-apply.
     1602   END.
     1603   ON CHOOSE OF r-sr-izm IN FRAME Dialog-Frame
     1604   DO:
     1605     define variable v-node-code as integer no-undo.
     1606     define variable v-sr-type as character no-undo.
     1607     v-node-code = 0 .
     1608     run ref/sr-izm.w (input parparentproc ,
     1609                       input ""            ,
     1610                       input 'ПРОСМОТР':U     ,
     1611                       input ""            ,
     1612                       input ""            ,
     1613                       input-output v-node-code,
     1614                       output v-sr-type) no-error.
     1615     if v-node-code <> 0 and v-node-code <> ? then do :
     1616       f-place-si = v-node-code.
     1617       f-place-si:screen-value = string(v-node-code).
     1618     end.
     1619   END.
     1620   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1621   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1622   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1623   on help of frame Dialog-Frame
     1624   do:
     1625     run gbl/app_help.p
     1626       (input this-procedure :file-name
     1627       ,input ''
     1628       ,input ?
     1629       ) no-error.
     1630     if error-status :error then do:
     1631       message
     1632         "Ошибка при вызове помощи"
     1633         error-status :get-message(1)
     1634         view-as alert-box .
     1635     end.
     1636   end.
     1637   run minbtn-set in this-procedure .
     1638   on choose of b-help in frame Dialog-Frame
     1639   do:
     1640     apply "help":u to frame Dialog-Frame .
     1641   end.
     1642   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1643   procedure minbtn-set :
     1644       do
     1645           on error undo, return error return-value
     1646           :
     1647           define variable ii              as integer       no-undo .
     1648           define variable fh              as widget-handle no-undo .
     1649           define variable hh              as widget-handle no-undo .
     1650           define variable v-h             as handle        extent 4 no-undo .
     1651           define variable v-name-button   as character     no-undo .
     1652           define variable v-help-old-x    as decimal       no-undo .
     1653           define variable v-help-old-y    as decimal       no-undo .
     1654           define variable v-help-old-size as decimal       no-undo .
     1655           define variable v-frame-width   as decimal       no-undo .
     1656           define variable jj              as integer       no-undo .
     1657           do
     1658               on error undo, return error
     1659               :
     1660               assign
     1661                   v-frame-width = frame Dialog-Frame:width - 0.3
     1662                   fh            = frame Dialog-Frame:first-child
     1663                   hh            = fh:first-child
     1664                   ii            = 1
     1665                   .
     1666               do while valid-handle(hh):
     1667                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1668                   do:
     1669                       case lc(hh:name) :
     1670                           when "b-help" then
     1671                               do:
     1672                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1673                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1674                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1675                                   hh:TOOLTIP = "Помощь" .
     1676                                   v-help-old-x = hh:column .
     1677                                   v-help-old-y = hh:row    .
     1678                                   v-help-old-size = hh:width .
     1679                                   hh:width-chars = 2.5 .
     1680                               end.
     1681                           when "b-print" then
     1682                               do:
     1683                                   hh:load-image("cmp/b-print.bmp":u) .
     1684                                   hh:TOOLTIP = "Печать" .
     1685                                   v-h[ii] = hh:handle .
     1686                                   ii = ii + 1 .
     1687                                   hh:width-chars = 3 .
     1688                               end.
     1689                           when "b-history" or
     1690                           when "b-hist" then
     1691                               do:
     1692                                   hh:load-image("cmp/b-hist.bmp":u) .
     1693                                   hh:TOOLTIP = "История" .
     1694                                   v-h[ii] = hh:handle .
     1695                                   ii = ii + 1 .
     1696                                   hh:width-chars = 3 .
     1697                               end.
     1698                           when "b-sch" then
     1699                               do:
     1700                                   hh:load-image("cmp/b-sch.bmp":u) .
     1701                                   hh:TOOLTIP = "Установка Фильтра" .
     1702                                   v-h[ii] = hh:handle .
     1703                                   ii = ii + 1 .
     1704                                   hh:width-chars = 3 .
     1705                               end.
     1706                           when "b-hist-user" then
     1707                               do:
     1708                                   hh:load-image("cmp/b-hist.bmp":u) .
     1709                                   hh:TOOLTIP = "История пользователя" .
     1710                                   ii = ii + 1 .
     1711                               end.
     1712                       end case.
     1713                   end.
     1714                   hh = hh:next-sibling.
     1715               end.
     1716               b-help:column = v-frame-width - b-help:width-chars.
     1717               jj = 0.
     1718               repeat ii = 4 to 1 by -1 :
     1719                   if valid-handle (v-h[ii] ) then
     1720                   do:
     1721                       jj  = jj + 1 .
     1722                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1723                       v-h[ii]:row    = v-help-old-y .
     1724                   end.
     1725               end.
     1726           end.
     1727       end.
     1728   end procedure.
     1729   MAIN-BLOCK:
     1730   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1731      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1732     find first buf_goods no-lock
     1733       where buf_goods.gds-code = p-gds-code
     1734       .
     1735     if p-mode = "set-attr":U then do:
     1736       run loc-get-set-attr in this-procedure
     1737         ( input p-mode
     1738         ) no-error .
     1739       if error-status :error then do:
     1740         message
     1741           vss-workfile vss-revision vss-description skip
     1742           "Ошибка при сохранении дополнительной информации" skip
     1743           error-status :get-message(1) skip
     1744           return-value skip
     1745           view-as alert-box error .
     1746       end.
     1747       return .
     1748     end.
     1749     if p-mode = "get-attr":U then do:
     1750       run loc-get-set-attr in this-procedure
     1751         ( input p-mode
     1752         ) no-error .
     1753       if error-status :error then do:
     1754         message
     1755           vss-workfile vss-revision vss-description skip
     1756           "Ошибка при чтении дополнительной информации" skip
     1757           error-status :get-message(1) skip
     1758           return-value skip
     1759           view-as alert-box error .
     1760       end.
     1761       return .
     1762     end.
     1763     if can-find (first ub.doc-line no-lock where ub.doc-line.doc-code = p-doc-code and ub.doc-line.doc-density <> 0) then do:
     1764       find first ub.doc-line no-lock where ub.doc-line.doc-code = p-doc-code
     1765                                        and ub.doc-line.artic = buf_goods.artic
     1766                                        and ub.doc-line.prod-code = buf_goods.prod-code
     1767                                        and ub.doc-line.prod-type = buf_goods.prod-type no-error.
     1768       if ub.doc-line.line-num > 1 then do :
     1769         run loc-get-set-attr in this-procedure
     1770           ( input "get-attr":U
     1771           ) no-error .
     1772         if error-status :error then do:
     1773           message
     1774             vss-workfile vss-revision vss-description skip
     1775             "Ошибка при чтении дополнительной информации" skip
     1776             error-status :get-message(1) skip
     1777             return-value skip
     1778             view-as alert-box error .
     1779         end.
     1780         if not ( ( p-car-num <> "" and p-car-num <> "?" ) or
     1781                  ( p-tests <> "" and p-tests <> "?" ) or
     1782                  ( p-car-vol <> "" and p-car-vol <> "?" ) or
     1783                  ( p-autoent-obj-type <> "" and p-autoent-obj-type <> "?" ) or
     1784                  ( p-autoent-obj-code <> "" and p-autoent-obj-code <> "?" ) or
     1785                  ( p-ptbotype <> "" and p-ptbotype <> "?" ) or
     1786                  ( p-ptbocode <> "" and p-ptbocode <> "?" )
     1787                  )
     1788         then do :
     1789           find first ub.doc-line no-lock where ub.doc-line.doc-code = p-doc-code
     1790                                           and ub.doc-line.doc-density <> 0
     1791                                           and ub.doc-line.line-num = 1 no-error.
     1792           find first buf_goods where buf_goods.artic     = ub.doc-line.artic
     1793                                 and buf_goods.prod-code = ub.doc-line.prod-code
     1794                                 and buf_goods.prod-type = ub.doc-line.prod-type no-error.
     1795           assign
     1796           v-last-gds-code = p-gds-code.
     1797           p-gds-code = buf_goods.gds-code
     1798           .
     1799           run loc-get-set-attr in this-procedure
     1800             ( input "get-attr":U
     1801             ) no-error .
     1802           if error-status :error then do:
     1803             message
     1804               vss-workfile vss-revision vss-description skip
     1805               "Ошибка при чтении дополнительной информации" skip
     1806               error-status :get-message(1) skip
     1807               return-value skip
     1808               view-as alert-box error .
     1809           end.
     1810           assign
     1811             p-car-vol      = "0"
     1812             p-item-pour    = ""
     1813             p-time-pour    = ""
     1814             p-time-income  = ""
     1815             p-time-start   = 0
     1816             p-time-end     = 0
     1817             p-date-start   = ?
     1818             p-date-end     = ?
     1819             p-mouth        = ""
     1820             p-tank-vol     = ""
     1821             p-tank-temp    = ""
     1822             p-tank-water   = ""
     1823             p-tank-density = ""
     1824             p-tank-weight  = ""
     1825             p-a-b-tarir    = ""
     1826             p-gds-code     = v-last-gds-code
     1827             p-diameter     = ""
     1828             p-place-si     = ""
     1829             p-tank-density-pomi = ""
     1830             .
     1831         end.
     1832       end.
     1833     end.
     1834     find first buf_goods no-lock
     1835       where buf_goods.gds-code = p-gds-code
     1836       .
     1837     assign
     1838       f-car-num = p-car-num
     1839       f-tests = p-tests
     1840     .
     1841     assign
     1842       f-car-vol = decimal(p-car-vol) no-error
     1843     .
     1844     if error-status:error then
     1845       message "Неверно задан объем автоцистерны по паспорту " p-car-vol " ."
     1846       view-as alert-box error.
     1847     assign
     1848       f-autoent-obj-type = p-autoent-obj-type
     1849     .
     1850     if f-autoent-obj-type = "" then do:
     1851       assign
     1852         f-autoent-obj-type = 'орг':U
     1853       .
     1854     end.
     1855     assign
     1856       f-autoent-obj-code = integer(p-autoent-obj-code) no-error
     1857     .
     1858     if error-status:error then do:
     1859       message
     1860         "Неверно указан код клиента " p-autoent-obj-code " ."
     1861         view-as alert-box error.
     1862     end.
     1863     else do:
     1864       find first clients no-lock
     1865         where clients.obj-type = f-autoent-obj-type
     1866           and clients.obj-code = f-autoent-obj-code
     1867         no-error.
     1868       if available clients then do:
     1869         assign
     1870           f-autoent-obj-name = clients.obj-name
     1871         .
     1872       end.
     1873       else do:
     1874         assign
     1875           f-autoent-obj-name = ?
     1876         .
     1877       end.
     1878     end.
     1879     assign
     1880       f-ptbotype = p-ptbotype
     1881     .
     1882     if f-ptbotype = "" then do:
     1883       assign
     1884         f-ptbotype = 'орг':U
     1885       .
     1886     end.
     1887     assign
     1888       f-ptbocode = integer( p-ptbocode ) no-error
     1889     .
     1890     if error-status:error then do:
     1891       message
     1892         "Неверно указан код нефтебазы " p-ptbocode " ."
     1893         view-as alert-box error.
     1894     end.
     1895     else do:
     1896       find first clients no-lock
     1897         where clients.obj-type = f-ptbotype
     1898           and clients.obj-code = f-ptbocode
     1899         no-error.
     1900       if available clients then assign f-ptboname = clients.obj-name.
     1901       else assign f-ptboname = ?.
     1902     end.
     1903     assign f-item-pour = p-item-pour.
     1904     assign
     1905     f-tank-vol  = decimal(p-tank-vol) no-error.
     1906     if error-status:error then
     1907       message "Неверно определен объем в цистерне " p-tank-vol " . "
     1908       view-as alert-box.
     1909     assign
     1910     f-tank-temp  = decimal(p-tank-temp) no-error.
     1911     if error-status:error then
     1912       message "Неверно определена температура в цистерне " p-tank-temp " . "
     1913       view-as alert-box.
     1914     assign
     1915     f-tank-water  = decimal(p-tank-water) no-error.
     1916     if error-status:error then
     1917       message "Неверно определен объем воды в цистерне " p-tank-water " . "
     1918       view-as alert-box.
     1919     assign
     1920     f-tank-density  = decimal(p-tank-density) no-error.
     1921     if error-status:error then
     1922       message "Неверно определена плотность в цистерне " p-tank-density " . "
     1923       view-as alert-box.
     1924     assign
     1925     f-tank-weight  = decimal(p-tank-weight) no-error.
     1926     if error-status:error then
     1927       message "Неверно определен вес в цистерне " p-tank-weight " . "
     1928       view-as alert-box.
     1929     assign f-hour-pour = integer(substring(p-time-pour, 1, 2)) no-error.
     1930     if error-status:error then do:
     1931       message "Неверное время налива " p-time-pour
     1932       view-as alert-box.
     1933       assign f-hour-pour = 0
     1934               f-min-pour  = 0.
     1935     end.
     1936     else do:
     1937       assign f-min-pour = integer(substring(p-time-pour, 4, 2)) no-error.
     1938       if error-status:error then do:
     1939           message "Неверное время налива " p-time-pour
     1940           view-as alert-box.
     1941           assign f-hour-pour = 0
     1942                 f-min-pour  = 0.
     1943       end.
     1944     end.
     1945     assign f-hour-income = integer(substring(p-time-income, 1, 2)) no-error.
     1946     if error-status:error then do:
     1947       message "Неверное время налива " p-time-income
     1948       view-as alert-box.
     1949       assign f-hour-income = 0
     1950               f-min-income  = 0.
     1951     end.
     1952     else do:
     1953       assign f-min-income = integer(substring(p-time-income, 4, 2)) no-error.
     1954       if error-status:error then do:
     1955           message "Неверное время налива " p-time-income
     1956           view-as alert-box.
     1957           assign f-hour-income = 0
     1958                 f-min-income  = 0.
     1959       end.
     1960     end.
     1961     assign
     1962     f-date-start = p-date-start
     1963     f-date-end   = p-date-end
     1964     f-hour-start = integer( truncate( p-time-start / 3600 , 0 ) )
     1965     f-min-start  = integer( ( p-time-start - f-hour-start * 3600 ) / 60 )
     1966     f-hour-end   = integer( truncate( p-time-end / 3600 , 0 ) )
     1967     f-min-end    = integer( ( p-time-end - f-hour-end * 3600 ) / 60).
     1968     assign
     1969       f-mouth = decimal (p-mouth) no-error.
     1970     if error-status:error then
     1971       message "Неверно определен объем топлива в горловине " p-mouth " . "
     1972       view-as alert-box.
     1973     assign
     1974       f-fio = p-fio
     1975       f-ptbocode = integer( p-ptbocode )
     1976       f-ptbotype = p-ptbotype
     1977     .
     1978     assign
     1979     f-a-b-tarir  = decimal(p-a-b-tarir) no-error.
     1980     if error-status:error then
     1981       message "Неверно определен уровень цистерны относительно тарировочной планки " p-a-b-tarir " . "
     1982       view-as alert-box.
     1983     assign
     1984     f-diameter = decimal (p-diameter) no-error.
     1985     if error-status:error then
     1986       message "Неверно определен внутренний диаметр горловины" p-diameter " . "
     1987       view-as alert-box.
     1988     assign
     1989     f-place-si = integer(p-place-si) no-error.
     1990     if error-status:error then
     1991       message "Неверно определено средство измерения" p-place-si " . "
     1992       view-as alert-box.
     1993     f-tank-density-pomi = decimal(p-tank-density-pomi) no-error.
     1994     if error-status:error then
     1995       message "Неверно определена плотность топлива для ПО ИМ" p-tank-density-pomi " . "
     1996       view-as alert-box.
     1997     RUN enable_UI.
     1998     display
     1999       f-car-num f-car-vol f-tests f-autoent-obj-type f-autoent-obj-code f-autoent-obj-name
     2000       f-item-pour f-hour-pour f-min-pour
     2001       f-hour-income f-min-income
     2002       f-date-start f-hour-start f-min-start
     2003       f-date-end f-hour-end f-min-end
     2004       f-tank-vol f-tank-temp f-tank-water f-tank-density
     2005       f-tank-weight
     2006       f-mouth    f-fio
     2007       f-ptbocode
     2008       f-ptbotype
     2009       f-a-b-tarir
     2010       with frame Dialog-Frame.
     2011     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     2012       disable
     2013         f-car-num f-car-vol f-tests f-autoent-obj-type f-autoent-obj-code
     2014         f-item-pour  f-tank-vol f-tank-temp f-tank-water f-tank-density
     2015         f-tank-weight f-hour-pour f-min-pour
     2016         f-hour-income f-min-income
     2017         f-date-start f-hour-start f-min-start
     2018         f-date-end f-hour-end f-min-end
     2019         b-save
     2020         b-clients
     2021         b-auto-tank
     2022         f-mouth f-fio
     2023         f-ptbocode
     2024         f-ptbotype
     2025         f-a-b-tarir
     2026         with frame Dialog-Frame.
     2027     end.
     2028     run gbl/conf-rd.p ("pomi-lic", "", "", 0, "", "", "", no, output pomi-licvalue, output pomi-lictype) no-error.
     2029     if not error-status:error and pomi-licvalue = "yes" then do :
     2030       disable
     2031         f-tank-water
     2032         f-mouth
     2033         f-tank-density
     2034         with frame Dialog-Frame.
     2035       display
     2036         f-diameter
     2037         f-place-si
     2038         f-tank-density-pomi
     2039         b-calc
     2040         with frame Dialog-Frame.
     2041       enable
     2042         f-diameter
     2043         f-place-si
     2044         f-tank-density-pomi
     2045         b-calc
     2046         with frame Dialog-Frame.
     2047     end.
     2048     WAIT-FOR GO OF FRAME Dialog-Frame.
     2049   END.
     2050   RUN disable_UI.
     2051   PROCEDURE disable_UI :
     2052     HIDE FRAME Dialog-Frame.
     2053   END PROCEDURE.
     2054   PROCEDURE disp-f-ptboname :
     2055     find clients where clients.obj-code = input frame Dialog-Frame f-ptbocode and
     2056                        clients.obj-type = input frame Dialog-Frame f-ptbotype no-lock no-error.
     2057     if available clients then
     2058     disp clients.obj-name @ f-ptboname with frame Dialog-Frame.
     2059     else do:
     2060         display ? @ f-ptboname with frame Dialog-Frame.
     2061         apply "choose" to b-ptb in frame Dialog-Frame.
     2062     end.
     2063   END PROCEDURE.
     2064   PROCEDURE disp-obj-name :
     2065     find clients where clients.obj-code = input frame Dialog-Frame f-autoent-obj-code and
     2066                        clients.obj-type = input frame Dialog-Frame f-autoent-obj-type no-lock no-error.
     2067     if available clients then
     2068     disp clients.obj-name @ f-autoent-obj-name with frame Dialog-Frame.
     2069     else do:
     2070         display ? @ f-autoent-obj-name with frame Dialog-Frame.
     2071         apply "choose" to b-clients in frame Dialog-Frame.
     2072     end.
     2073   END PROCEDURE.
     2074   PROCEDURE enable_UI :
     2075     DISPLAY f-autoent-obj-code f-autoent-obj-type f-autoent-obj-name f-car-num
     2076             f-car-vol f-tests f-fio f-ptbocode f-ptbotype f-ptboname f-hour-pour
     2077             f-min-pour f-item-pour f-tank-water f-mouth f-tank-vol f-tank-temp
     2078             f-tank-density f-tank-weight f-a-b-tarir
     2079             f-hour-income f-min-income f-date-start
     2080             f-hour-start f-min-start f-date-end f-hour-end f-min-end
     2081         WITH FRAME Dialog-Frame.
     2082     ENABLE b-save b-quit b-help RECT-3 RECT-1 f-autoent-obj-code
     2083            f-autoent-obj-type b-clients f-car-num f-car-vol b-auto-tank f-tests
     2084            f-fio f-ptbocode f-ptbotype b-ptb f-hour-pour f-min-pour f-item-pour
     2085            f-tank-water f-mouth f-tank-temp f-tank-density f-a-b-tarir
     2086            r-sr-izm f-hour-income
     2087            f-min-income f-date-start f-hour-start f-min-start f-date-end
     2088            f-hour-end f-min-end
     2089         WITH FRAME Dialog-Frame.
     2090     VIEW FRAME Dialog-Frame.
     2091   END PROCEDURE.
