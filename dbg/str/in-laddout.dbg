      139   procedure get-ptrl-prop :
      140     define input  parameter p-obj-type as character no-undo .
      141     define input  parameter p-obj-code as integer   no-undo .
      142     do
      143     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      144     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      145     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      146     :
      147       define variable par-type          as character no-undo.
      148       define variable v-value-character as character no-undo .
      149       define variable v-value-date      as date      no-undo .
      150       define variable v-value-decimal   as decimal   no-undo .
      151       define variable v-value-integer   as integer   no-undo .
      152       define variable v-value-logical   as logical   no-undo .
      153       for each thbjattr_thbj-attr
      154       :
      155         delete thbjattr_thbj-attr .
      156       end.
      157       run adm/shattri.p
      158         ( input "get":U
      159         , input p-obj-type
      160         , input p-obj-code
      161         , input 'petrol':U
      162         , input  ""
      163         , output v-value-character
      164         , output v-value-date
      165         , output v-value-decimal
      166         , output v-value-integer
      167         , output v-value-logical
      168         , output par-type
      169         , input-output table thbjattr_thbj-attr
      170         ) no-error .
      171       for each thbjattr_thbj-attr
      172       on error undo, return error return-value
      173       :
      174         case thbjattr_thbj-attr.prop-code :
      175           when 'denstclc':U then do:
      176             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      177               assign
      178                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      179               .
      180             end.
      181           end.
      182           when 'expptrl':U then do:
      183             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      184               and thbjattr_thbj-attr.prop-value-type = 'character':U
      185             then do:
      186               assign
      187                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      188               .
      189             end.
      190           end.
      191           when 'inpptrl':U then do:
      192             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      193               and thbjattr_thbj-attr.prop-value-type = 'character':U
      194             then do:
      195               assign
      196                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      197               .
      198             end.
      199           end.
      200           when 'autopump':U then do:
      201             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      202               assign
      203                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      204               .
      205             end.
      206           end.
      207           when 'rvsnmter':U then do:
      208             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      209               assign
      210                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      211               .
      212             end.
      213           end.
      214           when 'avtinvpm':U then do:
      215             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      216               assign
      217                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      218               .
      219             end.
      220           end.
      221           when 'invclipt':U then do:
      222             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      223               assign
      224                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      225               .
      226             end.
      227           end.
      228           when 'olddens':U then do:
      229             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      230               assign
      231                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      232               .
      233             end.
      234           end.
      235           when 'algrvspt':U then do:
      236             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      237               assign
      238                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      239               .
      240             end.
      241           end.
      242           when 'temp-for-pomi':U then do:
      243             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      244               assign
      245                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      246               .
      247             end.
      248           end.
      249           when 'algoincome':U then do:
      250             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      251               assign
      252                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      253               .
      254             end.
      255           end.
      256           when 'mand-choice-autocar':U then do:
      257             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      258               assign
      259                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      260               .
      261             end.
      262           end.
      263           when 'block-nozzle':U then do:
      264             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      265               assign
      266                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      267               .
      268             end.
      269           end.
      270           when 'timeout-block-nozzle':U then do:
      271             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      272               assign
      273                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      274               .
      275             end.
      276           end.
      277           when 'Delta-mass-horiz':U then do:
      278             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      279               assign
      280                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      281               .
      282             end.
      283           end.
      284           when 'Delta-mass-vert':U then do:
      285             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      286               assign
      287                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      288               .
      289             end.
      290           end.
      291           when 'calc-free-vol':U then do:
      292             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      293               assign
      294                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      295               .
      296             end.
      297           end.
      298           when 'calc-free-vol-sug':U then do:
      299             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      300               assign
      301                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      302               .
      303             end.
      304           end.
      305           when 'trn-reas-sug':U then do:
      306             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      307               assign
      308                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      309               .
      310             end.
      311           end.
      312                 when 'rvd-own-nb':U then do:
      313             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      314               assign
      315                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      316               .
      317             end.
      318           end.
      319           when 'qr-scan-time':U then do:
      320             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      321               assign
      322                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      323               .
      324             end.
      325           end.
      326           when 'autopump-skip-time':U then do:
      327             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      328               assign
      329                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      330               .
      331             end.
      332           end.
      333         end case.
      334         delete thbjattr_thbj-attr .
      335       end.
      336     end.
      337     return .
      338   end procedure.
      339   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   procedure cur-time :
      341      define output parameter p-today as date      no-undo .
      342      define output parameter p-time  as integer   no-undo .
      343     do
      344     on error undo, return error
      345     :
      346       define variable v-date1 as date      no-undo .
      347       define variable v-date2 as date      no-undo .
      348       define variable v-time  as integer   no-undo .
      349       assign
      350         v-date1 = today
      351         v-time  = time
      352         v-date2 = today
      353       .
      354       if v-date1 <> v-date2
      355       then do:
      356         assign
      357           v-date1 = today
      358           v-time  = v-time
      359         .
      360       end.
      361       assign
      362         p-today = v-date1
      363         p-time  = v-time
      364       .
      365     end.
      366   end.
      367   function cur-time-date returns character
      368   :
      369     return string(today, '99/99/9999':U) .
      370   end.
      371   function cur-time-mjd returns decimal
      372   :
      373     define variable v-date as date      no-undo .
      374     define variable v-time as integer   no-undo .
      375     run cur-time in this-procedure
      376       (output v-date
      377       ,output v-time
      378       ) .
      379     return integer(v-date) - 2400002 + (v-time / 86400) .
      380   end.
      381   function cur-time-get-ending-index returns integer
      382   (input p-number as integer
      383   )
      384   :
      385     if p-number < 0
      386     or p-number = ?
      387     then do:
      388       return 1 .
      389     end.
      390     define variable v-rest as integer   no-undo .
      391     assign
      392       p-number = p-number modulo 100
      393     .
      394     if p-number < 20
      395     then do:
      396       assign
      397         v-rest = p-number
      398       .
      399     end.
      400     else do:
      401       assign
      402         v-rest = p-number modulo 10
      403       .
      404     end.
      405     case v-rest :
      406       when 1
      407       then do:
      408         return 2 .
      409       end.
      410       when 2 or
      411       when 3 or
      412       when 4
      413       then do:
      414         return 3 .
      415       end.
      416       otherwise do:
      417         return 1 .
      418       end.
      419     end case .
      420   end.
      421   procedure cur-time-mjd-to-date :
      422      define input  parameter i-mjd-diff as decimal no-undo.
      423      define output parameter o-Date     as date    no-undo.
      424      define output parameter o-Time     as integer no-undo.
      425      define variable v-day-number as integer   no-undo .
      426      if    i-mjd-diff < 0
      427         or i-mjd-diff = ?
      428      then do:
      429         return "?" .
      430      end.
      431      assign
      432         v-day-number = truncate(i-mjd-diff,0).
      433         o-Date = date(v-day-number + 2400002).
      434         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      435     .
      436   end.
      437   function cur-time-mjd-to-string returns character
      438   (input p-mjd-diff as decimal
      439   )
      440   :
      441     define variable v-day-number as integer   no-undo .
      442     define variable v-seconds    as integer   no-undo .
      443     define variable v-hour       as integer   no-undo .
      444     define variable v-min        as integer   no-undo .
      445     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      446     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      447     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      448     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      449     if p-mjd-diff < 0
      450     or p-mjd-diff = ?
      451     then do:
      452       return "?" .
      453     end.
      454     assign
      455       v-day-number = integer(truncate(p-mjd-diff,0))
      456       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      457     .
      458     if v-seconds > 86400
      459     then do:
      460       assign
      461         v-seconds = 86400 - 1
      462       .
      463     end.
      464     if v-seconds < 0
      465     then do:
      466       assign
      467         v-seconds = 0
      468       .
      469     end.
      470     assign
      471       v-hour = truncate(v-seconds / 3600, 0)
      472     .
      473     assign
      474       v-seconds = v-seconds modulo 3600
      475     .
      476     assign
      477       v-min = truncate(v-seconds / 60, 0)
      478     .
      479     assign
      480       v-seconds = v-seconds modulo 60
      481     .
      482     return
      483         (if v-day-number <> 0
      484           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      485           else ""
      486         )
      487       + (if v-day-number <> 0 or v-hour <> 0
      488           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      489           else ""
      490         )
      491       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      492           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      493           else ""
      494         )
      495       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      496       .
      497   end.
      498   function cur-time-string returns character
      499   :
      500     define variable v-date as date      no-undo .
      501     define variable v-time as integer   no-undo .
      502     run cur-time in this-procedure
      503       (output v-date
      504       ,output v-time
      505       ) .
      506     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      507   end.
      508   function cur-time-string-sec returns character
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      517   end.
      518   function cur-time-custom  returns character
      519   (input p-prefix as character
      520   ,input p-date-format as character
      521   ,input p-delimiter as character
      522   ,input p-time-format as character
      523   ,input p-suffix as character
      524   )
      525   :
      526     define variable v-date as date      no-undo .
      527     define variable v-time as integer   no-undo .
      528     run cur-time in this-procedure
      529       (output v-date
      530       ,output v-time
      531       ) .
      532     return
      533       p-prefix
      534       + string(v-date, p-date-format)
      535       + p-delimiter
      536       + string(v-time, p-time-format)
      537       + p-suffix
      538       .
      539   end.
      540   function cur-time-print  returns character
      541   :
      542     define variable v-date as date      no-undo .
      543     define variable v-time as integer   no-undo .
      544     run cur-time in this-procedure
      545       (output v-date
      546       ,output v-time
      547       ) .
      548     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      549   end.
      550   function cur-time-datetime returns datetime
      551   :
      552     define variable v-char as character no-undo .
      553     define variable v-datetime as datetime no-undo .
      554     v-char = cur-time-string().
      555     v-datetime = datetime(v-char).
      556     return  v-datetime.
      557   end.
      558   function cur-time-string-msec returns character
      559   :
      560     define variable v-date as datetime  no-undo .
      561     v-date = now.
      562     return string(v-date) .
      563   end.
      564   define input        parameter parparentproc       as   handle                no-undo .
      565   define input        parameter p-mode              as   character             no-undo .
