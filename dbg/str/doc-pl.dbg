     1455   ON CHOOSE OF b-exit IN FRAME f-doc-pl
     1456   DO:
     1457   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   if lookup(self :type
     1459            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1460            ) = 0
     1461   then do:
     1462     message
     1463       "$Workfile$"
     1464       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1465       "Интерфейсный элемент" self :name  skip
     1466       "Тип" self :type  skip
     1467       "Процедура" this-procedure :file-name skip
     1468       view-as alert-box .
     1469   end.
     1470   else do:
     1471     apply "entry":u to self  .
     1472     if focus :handle <> self :handle  then do:
     1473       return no-apply .
     1474     end.
     1475   end.
     1476     define variable v-quit as logical   no-undo .
     1477     apply "leave" to loc-t-doc-pl.pl-code in frame f-doc-pl.
     1478     if loc-t-doc-pl.pl-code = ?
     1479       or loc-t-doc-pl.pl-code = 0
     1480     then do:
     1481       message
     1482         "Не указано место хранения." skip
     1483         "Хотите выйти без сохранения?" skip
     1484         view-as alert-box question buttons yes-no update v-quit.
     1485       if v-quit = true then do:
     1486         apply "choose" to b-quit in frame f-doc-pl.
     1487       end.
     1488       return no-apply.
     1489     end.
     1490     if p-upd-field = "rest":U
     1491       or p-upd-field = "rest-fact":U
     1492     then do:
     1493       assign
     1494         loc-t-doc-pl.doc-qnty     = loc-t-doc-pl.fact-qnty
     1495         loc-t-doc-pl.cli-doc-qnty = loc-t-doc-pl.cli-fact-qnty
     1496         loc-t-doc-pl.cli-qnty     = loc-t-doc-pl.cli-doc-qnty
     1497       .
     1498       if f-doc-pl-rest-density :sensitive = true then do:
     1499         if loc-t-doc-pl.rest-af-qnty <> 0.0
     1500           and loc-t-doc-pl.cli-rest-af-qnty <> 0.0
     1501           and absolute( loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty - f-doc-pl-rest-density ) > 0.00001
     1502         then do:
     1503           message
     1504             "Указанная плотность не соответствует расчетной." skip
     1505             substitute( "Расчетная: &1", loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty ) skip
     1506             substitute( "Задана: &1", f-doc-pl-rest-density ) skip
     1507             view-as alert-box error .
     1508           apply "entry" to f-doc-pl-rest-density in frame f-doc-pl.
     1509           return no-apply .
     1510         end.
     1511         if valid-density( f-doc-pl-rest-density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true then do:
     1512           message
     1513             "Значение плотности не корректно." skip
     1514             substitute( 'Плотность "стало": &1', f-doc-pl-rest-density ) skip
     1515             view-as alert-box error .
     1516           apply "entry" to f-doc-pl-rest-density in frame f-doc-pl.
     1517           return no-apply .
     1518         end.
     1519       end.
     1520     end.
     1521     if p-upd-field <> "rest":U
     1522       and p-upd-field <> "rest-fact":U
     1523       and p-upd-field <> "fact-doc":U
     1524       and loc-t-doc-pl.cli-doc-qnty = 0.0
     1525       and loc-t-doc-pl.doc-qnty = 0.0
     1526     then do:
     1527       message
     1528         "Указаны нулевые количества, запись будет удалена." skip
     1529         "Хотите продолжить редактирование?" skip
     1530         view-as alert-box question buttons yes-no update v-quit.
     1531       if v-quit = true then do:
     1532         return no-apply.
     1533       end.
     1534       else do:
     1535         if available buf-upd_tt-doc-pl then do:
     1536           delete buf-upd_tt-doc-pl .
     1537         end.
     1538       end.
     1539     end.
     1540     else do:
     1541       if not available buf-upd_tt-doc-pl then do:
     1542         create buf-upd_tt-doc-pl .
     1543       end.
     1544       buffer-copy loc-t-doc-pl to buf-upd_tt-doc-pl .
     1545     end.
     1546   END.
     1547   ON CHOOSE OF b-place IN FRAME f-doc-pl
     1548   DO:
     1549   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   if lookup(self :type
     1551            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1552            ) = 0
     1553   then do:
     1554     message
     1555       "$Workfile$"
     1556       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1557       "Интерфейсный элемент" self :name  skip
     1558       "Тип" self :type  skip
     1559       "Процедура" this-procedure :file-name skip
     1560       view-as alert-box .
     1561   end.
     1562   else do:
     1563     apply "entry":u to self  .
     1564     if focus :handle <> self :handle  then do:
     1565       return no-apply .
     1566     end.
     1567   end.
     1568     define variable v-rid-list as character no-undo .
     1569     define variable v-pl-code  as integer   no-undo .
     1570     define variable ref-rec    as recid     no-undo .
     1571     define variable v-value    as character no-undo .
     1572     define variable v-value2   as character no-undo .
     1573     define variable v-ok       as logical   no-undo .
     1574     define variable ii         as integer   no-undo .
     1575     define buffer buf_pl-gds for ub.pl-gds .
     1576     define buffer buf_place for ub.place .
     1577     define buffer buf_place-attr for ub.place-attr .
     1578     run ref/pl-gdss.w
     1579       ( input parparentproc
     1580        ,input "b-sel"
     1581        ,input buf-obj_clients.obj-type
     1582        ,input buf-obj_clients.obj-code
     1583        ,input ( if v-is-ptrl = "yes":U then 'топ':U else 'ТОВАР':U )
     1584        ,input recid( buf_goods )
     1585        ,input ?
     1586        ,output v-rid-list
     1587       ) no-error .
     1588     assign
     1589       ref-rec = integer( entry( 1, v-rid-list ) ) no-error
     1590     .
     1591     if error-status :error then do:
     1592       assign
     1593         ref-rec = ?
     1594       .
     1595     end.
     1596     find first buf_pl-gds no-lock
     1597       where recid( buf_pl-gds ) = ref-rec
     1598       no-error .
     1599     if available buf_pl-gds then do:
     1600       v-pl-code = buf_pl-gds.pl-code .
     1601       if loc-t-doc-pl.pl-code = v-pl-code then do:
     1602         return no-apply .
     1603       end.
     1604       run placelib_get-attr  (
     1605          input "place-is-main"
     1606         ,input buf_pl-gds.obj-code
     1607         ,input buf_pl-gds.obj-type
     1608         ,input buf_pl-gds.pl-code
     1609         ,output v-value
     1610         ,output v-ok      )
     1611       no-error.
     1612       if v-ok
     1613       and not logical(v-value)
     1614       then do :
     1615         run placelib_get-attr  (
     1616            input "place-com-tanks"
     1617           ,input buf_pl-gds.obj-code
     1618           ,input buf_pl-gds.obj-type
     1619           ,input buf_pl-gds.pl-code
     1620           ,output v-value
     1621           ,output v-ok      )
     1622         no-error.
     1623         if v-ok
     1624         and v-value > ""
     1625         then do ii = 1 to num-entries(v-value) :
     1626           find first buf_place no-lock where buf_place.obj-type = buf_pl-gds.obj-type
     1627                                          and buf_place.obj-code = buf_pl-gds.obj-code
     1628                                          and buf_place.loc1     = entry(ii, v-value)
     1629                                          and buf_place.status_  = ""
     1630                                          no-error .
     1631           if available buf_place
     1632           then do :
     1633             run placelib_get-attr  (
     1634                input "place-is-main"
     1635               ,input buf_place.obj-code
     1636               ,input buf_place.obj-type
     1637               ,input buf_place.pl-code
     1638               ,output v-value2
     1639               ,output v-ok      )
     1640             no-error.
     1641             if v-ok
     1642             and logical(v-value2)
     1643             then do :
     1644               v-pl-code = buf_place.pl-code .
     1645               leave .
     1646             end .
     1647           end .
     1648         end .
     1649       end .
     1650       if loc-t-doc-pl.pl-code = v-pl-code then do:
     1651         return no-apply .
     1652       end.
     1653       assign
     1654         loc-t-doc-pl.pl-code :screen-value = string( v-pl-code, loc-t-doc-pl.pl-code :format )
     1655       .
     1656       apply "leave" to loc-t-doc-pl.pl-code in frame f-doc-pl .
     1657     end.
     1658     apply "value-changed" to loc-t-doc-pl.pl-code in frame f-doc-pl.
     1659   END.
     1660   ON CHOOSE OF b-qnty IN FRAME f-doc-pl
     1661   DO:
     1662   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1663   if lookup(self :type
     1664            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1665            ) = 0
     1666   then do:
     1667     message
     1668       "$Workfile$"
