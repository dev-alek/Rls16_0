       66   define variable vss-revision    as character no-undo initial "$Revision$":U .
       67   define variable vss-author      as character no-undo initial "$Author$":U .
       68   define variable vss-date        as character no-undo initial "$Date$":U .
       69   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       70   define variable vss-archive     as character no-undo initial "$Archive$":U .
       71   define variable vss-description as character no-undo initial "Складское место с товарами с указанием количеств":U .
       72   procedure vss-get-info :
       73     define output parameter p-vss-revision    like vss-revision    no-undo .
       74     define output parameter p-vss-author      like vss-author      no-undo .
       75     define output parameter p-vss-date        like vss-date        no-undo .
       76     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       77     define output parameter p-vss-archive     like vss-archive     no-undo .
       78     define output parameter p-vss-description like vss-description no-undo .
       79     assign
       80       p-vss-revision    = vss-revision
       81       p-vss-author      = vss-author
       82       p-vss-date        = vss-date
       83       p-vss-workfile    = vss-workfile
       84       p-vss-archive     = vss-archive
       85       p-vss-description = vss-description
       86     .
       87   end procedure.
       88   procedure vss-get-parameters :
       89     define output parameter p-vss-parameters as character no-undo .
       90   end procedure.
       91   define new global shared variable g#vssrevis-logger as handle    no-undo .
       92   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       93   define variable v-vssrevis-logger                   as handle    no-undo .
       94   procedure vss-logevent :
       95     define input  parameter p-extra-paramters as character no-undo .
       96     define variable v-vssrevis-parameters as character no-undo .
       97     do
       98     on error undo, return error return-value
       99     :
      100       if  valid-handle(v-vssrevis-logger)
      101       and v-vssrevis-logger :get-signature("logevent") <> ""
      102       then do:
      103         run vss-get-parameters in this-procedure
      104           (output v-vssrevis-parameters
      105           ).
      106         run logevent in v-vssrevis-logger
      107           (input vss-workfile
      108           ,input vss-revision
      109           ,input v-vssrevis-parameters
      110           ,input p-extra-paramters
      111           ).
      112       end.
      113     end.
      114   end procedure.
      115   assign
      116     v-vssrevis-logger = g#vssrevis-logger
      117   .
      118   if  valid-handle(v-vssrevis-logger)
      119   and v-vssrevis-logger :get-signature("logevent") <> ""
      120   then do:
      121     assign
      122       v-vssrevis-logevent = true
      123     .
      124     run vss-logevent in this-procedure (input vss-description) .
      125   end.
      126   define new global shared variable g#language as character no-undo .
      127   if g#language <> '' and g#language <> 'rus':U then do:
      128     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      129   end.
      130   procedure proc-alt-shift-f2:
      131     if not ibs.th.gbl.gbl-var:rcode
      132   then
      133     run gbl\inidebug.p .
      134   end.
      135   procedure proc-alt-shift-f3:
      136     run gbl/prvssinf.p
      137       ( input this-procedure
      138       ) .
      139   end.
      140   define variable v-inform-launched as logical no-undo initial false .
      141   procedure proc-alt-shift-f4:
      142     define variable v-action as character no-undo .
      143     if v-inform-launched = false then do:
      144       assign
      145         v-inform-launched = true
      146       .
      147       run gbl/d-inform.w
      148         (  input self
      149         ,  input this-procedure
      150         , output v-action
      151         ) no-error .
      152       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      153       assign
      154         v-inform-launched = false
      155       .
      156     end.
      157   end.
      158   procedure proc-alt-f1:
      159     run gbl/corrhelp.p
      160       (input this-procedure
      161       ) .
      162   end .
      163   on alt-shift-f2 anywhere do:
      164     run proc-alt-shift-f2.
      165   end.
      166   on alt-shift-f3 anywhere do:
      167     run proc-alt-shift-f3 in this-procedure .
      168   end.
      169   on alt-shift-f4 anywhere do:
      170     run proc-alt-shift-f4 in this-procedure.
      171   end.
      172   on alt-f1 anywhere do:
      173     run proc-alt-f1 in this-procedure .
      174   end.
