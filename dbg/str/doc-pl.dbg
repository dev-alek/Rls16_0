     2537       define input  parameter p-add-rest-af-qnty     like ub.doc-pl.rest-af-qnty     no-undo .
     2538       define input  parameter p-add-cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty no-undo .
     2539       assign
     2540         f-tot-doc-pl-cli-qnty         = p-add-cli-qnty
     2541         f-tot-doc-pl-doc-qnty         = p-add-doc-qnty
     2542         f-tot-doc-pl-cli-doc-qnty     = p-add-cli-doc-qnty
     2543         f-tot-doc-pl-fact-qnty        = p-add-fact-qnty
     2544         f-tot-doc-pl-cli-fact-qnty    = p-add-cli-fact-qnty
     2545         f-tot-doc-pl-rest-af-qnty     = p-add-rest-af-qnty
     2546         f-tot-doc-pl-cli-rest-af-qnty = p-add-cli-rest-af-qnty
     2547       .
     2548       for each tt-doc-pl no-lock
     2549       :
     2550         assign
     2551           f-tot-doc-pl-cli-qnty         = f-tot-doc-pl-cli-qnty         + tt-doc-pl.cli-qnty
     2552           f-tot-doc-pl-doc-qnty         = f-tot-doc-pl-doc-qnty         + tt-doc-pl.doc-qnty
     2553           f-tot-doc-pl-cli-doc-qnty     = f-tot-doc-pl-cli-doc-qnty     + tt-doc-pl.cli-doc-qnty
     2554           f-tot-doc-pl-fact-qnty        = f-tot-doc-pl-fact-qnty        + tt-doc-pl.fact-qnty
     2555           f-tot-doc-pl-cli-fact-qnty    = f-tot-doc-pl-cli-fact-qnty    + tt-doc-pl.cli-fact-qnty
     2556           f-tot-doc-pl-rest-af-qnty     = f-tot-doc-pl-rest-af-qnty     + tt-doc-pl.rest-af-qnty
     2557           f-tot-doc-pl-cli-rest-af-qnty = f-tot-doc-pl-cli-rest-af-qnty + tt-doc-pl.cli-rest-af-qnty
     2558         .
     2559       end.
     2560       if f-tot-doc-pl-rest-af-qnty <> 0.0
     2561         and f-tot-doc-pl-cli-rest-af-qnty <> 0.0
     2562       then do:
     2563         assign
     2564           f-tot-doc-pl-rest-density = f-tot-doc-pl-cli-rest-af-qnty / f-tot-doc-pl-rest-af-qnty
     2565         .
     2566       end.
     2567       else do:
     2568         assign
     2569           f-tot-doc-pl-rest-density = p-doc-line-rest-density
     2570         .
     2571       end.
     2572       display
     2573         f-tot-doc-pl-cli-qnty         when f-tot-doc-pl-cli-qnty         :visible = true
     2574         f-tot-doc-pl-doc-qnty         when f-tot-doc-pl-doc-qnty         :visible = true
     2575         f-tot-doc-pl-cli-doc-qnty     when f-tot-doc-pl-cli-doc-qnty     :visible = true
     2576         f-tot-doc-pl-fact-qnty        when f-tot-doc-pl-fact-qnty        :visible = true
     2577         f-tot-doc-pl-cli-fact-qnty    when f-tot-doc-pl-cli-fact-qnty    :visible = true
     2578         f-tot-doc-pl-rest-af-qnty     when f-tot-doc-pl-rest-af-qnty     :visible = true
     2579         f-tot-doc-pl-cli-rest-af-qnty when f-tot-doc-pl-cli-rest-af-qnty :visible = true
     2580         f-tot-doc-pl-rest-density     when f-tot-doc-pl-rest-density     :visible = true
     2581         with frame f-doc-pl
     2582       .
     2583       if f-tot-doc-pl-doc-qnty :visible = true
     2584         and f-doc-line-doc-qnty :visible = true
     2585       then do:
     2586         if ( p-upd-units = "base":U
     2587             and f-tot-doc-pl-doc-qnty <> f-doc-line-doc-qnty
     2588           )
     2589           or
     2590           ( p-upd-units = "cli":U
     2591             and absolute( f-tot-doc-pl-doc-qnty - f-doc-line-doc-qnty ) > 0.001
     2592           )
     2593         then do:
     2594           assign
     2595             f-tot-doc-pl-doc-qnty :fgcolor = 12
     2596             f-doc-line-doc-qnty   :fgcolor = 12
     2597           .
     2598         end.
     2599         else do:
     2600           assign
     2601             f-tot-doc-pl-doc-qnty :fgcolor = ?
     2602             f-doc-line-doc-qnty   :fgcolor = ?
     2603           .
     2604         end.
     2605       end.
     2606       if f-tot-doc-pl-cli-doc-qnty :visible = true
     2607         and f-doc-line-cli-doc-qnty :visible = true
     2608       then do:
     2609         if ( p-upd-units = "base":U
     2610             and absolute( f-tot-doc-pl-cli-doc-qnty - f-doc-line-cli-doc-qnty ) > 0.001
     2611            )
     2612            or
     2613            ( p-upd-units = "cli":U
     2614              and f-tot-doc-pl-cli-doc-qnty <> f-doc-line-cli-doc-qnty
     2615            )
     2616         then do:
