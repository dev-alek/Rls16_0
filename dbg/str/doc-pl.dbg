     2651       end.
     2652       if f-tot-doc-pl-fact-qnty :visible = true
     2653         and f-doc-line-fact-qnty :visible = true
     2654       then do:
     2655         if f-tot-doc-pl-fact-qnty <> f-doc-line-fact-qnty then do:
     2656           assign
     2657             f-tot-doc-pl-fact-qnty :fgcolor = 12
     2658             f-doc-line-fact-qnty   :fgcolor = 12
     2659           .
     2660         end.
     2661         else do:
     2662           assign
     2663             f-tot-doc-pl-fact-qnty :fgcolor = ?
     2664             f-doc-line-fact-qnty   :fgcolor = ?
     2665           .
     2666         end.
     2667       end.
     2668       if f-tot-doc-pl-cli-fact-qnty :visible = true
     2669         and f-doc-line-cli-fact-qnty :visible = true
     2670       then do:
     2671         if absolute( f-tot-doc-pl-cli-fact-qnty - f-doc-line-cli-fact-qnty ) > 0.001 then do:
     2672           assign
     2673             f-tot-doc-pl-cli-fact-qnty :fgcolor = 12
     2674             f-doc-line-cli-fact-qnty   :fgcolor = 12
     2675           .
     2676         end.
     2677         else do:
     2678           assign
     2679             f-tot-doc-pl-cli-fact-qnty :fgcolor = ?
     2680             f-doc-line-cli-fact-qnty   :fgcolor = ?
     2681           .
     2682         end.
     2683       end.
     2684       if f-tot-doc-pl-rest-af-qnty :visible = true
     2685         and f-doc-line-rest-af-qnty :visible = true
     2686       then do:
     2687         if f-tot-doc-pl-rest-af-qnty <> f-doc-line-rest-af-qnty then do:
     2688           assign
     2689             f-tot-doc-pl-rest-af-qnty :fgcolor = 12
     2690             f-doc-line-rest-af-qnty   :fgcolor = 12
     2691           .
     2692         end.
     2693         else do:
     2694           assign
     2695             f-tot-doc-pl-rest-af-qnty :fgcolor = ?
     2696             f-doc-line-rest-af-qnty   :fgcolor = ?
     2697           .
     2698         end.
     2699       end.
     2700       if f-tot-doc-pl-cli-rest-af-qnty :visible = true
     2701         and f-doc-line-cli-rest-af-qnty :visible = true
     2702       then do:
     2703         if absolute( f-tot-doc-pl-cli-rest-af-qnty - f-doc-line-cli-rest-af-qnty ) > 0.001 then do:
     2704           assign
     2705             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = 12
