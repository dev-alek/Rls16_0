     2877       f-doc-line-fact-qnty        = p-doc-line-fact-qnty
     2878       f-doc-line-cli-fact-qnty    = p-doc-line-fact-cli-qnty
     2879       f-doc-line-rest-af-qnty     = p-doc-line-rest-af-qnty
     2880       f-doc-line-cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     2881     .
     2882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2883     (input  'is-ptrl':U
     2884     ,input  ''
     2885     ,input  ''
     2886     ,input  0
     2887     ,input  ''
     2888     ,input  ''
     2889     ,input  ''
