     2707           .
     2708         end.
     2709         else do:
     2710           assign
     2711             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = ?
     2712             f-doc-line-cli-rest-af-qnty   :fgcolor = ?
     2713           .
     2714         end.
     2715       end.
     2716     end procedure.
     2717     procedure get-from-rvs :
     2718       define input  parameter p-doc-code               like ub.trn-doc.doc-code                no-undo .
     2719       define input  parameter p-gds-code               like ub.rvs-line.gds-code               no-undo .
     2720       define input  parameter p-pl-code                like ub.rvs-line.pl-code                no-undo .
     2721       define output parameter p-state-measure-qnty     like ub.rvs-line.state-measure-qnty     no-undo .
     2722       define output parameter p-measure-qnty           like ub.rvs-line.measure-qnty           no-undo .
     2723       define output parameter p-state-measure-cli-qnty like ub.rvs-line.state-measure-cli-qnty no-undo .
     2724       define output parameter p-measure-cli-qnty       like ub.rvs-line.measure-cli-qnty       no-undo .
     2725       define output parameter p-state-density          like ub.rvs-line.state-density          no-undo .
     2726       define output parameter p-measure-density        like ub.rvs-line.density                no-undo .
     2727       define output parameter p-label                  as   character                          no-undo .
     2728       do
     2729       on error  undo, return error substitute( "&1 (disp-from-rvs). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2730       on stop   undo, return error substitute( "&1 (disp-from-rvs). stop", vss-workfile )
     2731       on endkey undo, return error substitute( "&1 (disp-from-rvs). endkey", vss-workfile )
     2732       :
     2733         define buffer rvs_trn-doc  for ub.trn-doc .
     2734         define buffer bef_rvs-doc  for ub.rvs-doc  .
     2735         define buffer aft_rvs-doc  for ub.rvs-doc  .
     2736         define buffer bef_rvs-line for ub.rvs-line .
     2737         define buffer aft_rvs-line for ub.rvs-line .
     2738         assign
     2739           p-state-measure-qnty     = 0
     2740           p-measure-qnty           = 0
     2741           p-state-measure-cli-qnty = 0
     2742           p-measure-cli-qnty       = 0
     2743           p-label                  = "":U
     2744         .
     2745         case buf_trn-doc.doc-type :
     2746           when 'при':U then do:
     2747             for each bef_rvs-doc no-lock
     2748               where bef_rvs-doc.out-code  = p-doc-code
     2749                 and bef_rvs-doc.rvs-type  = 'перед_док':U
     2750             :
     2751               for each bef_rvs-line no-lock
     2752                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     2753                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     2754                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     2755                   and bef_rvs-line.pl-code  = p-pl-code
     2756                   and bef_rvs-line.gds-code = p-gds-code
     2757               :
     2758                 assign
     2759                   p-state-measure-qnty     = p-state-measure-qnty     - bef_rvs-line.state-measure-qnty
     2760                   p-measure-qnty           = p-measure-qnty           - bef_rvs-line.measure-qnty
     2761                   p-state-measure-cli-qnty = p-state-measure-cli-qnty - bef_rvs-line.state-measure-cli-qnty
     2762                   p-measure-cli-qnty       = p-measure-cli-qnty       - bef_rvs-line.measure-cli-qnty
     2763                 .
     2764               end .
     2765             end .
     2766             for each aft_rvs-doc no-lock
     2767               where aft_rvs-doc.out-code  = p-doc-code
     2768                 and aft_rvs-doc.rvs-type  = 'после_док':U
     2769             :
     2770               for each aft_rvs-line no-lock
     2771                 where aft_rvs-line.rvs-code = aft_rvs-doc.rvs-code
     2772                   and aft_rvs-line.obj-type = aft_rvs-doc.obj-type
     2773                   and aft_rvs-line.obj-code = aft_rvs-doc.obj-code
     2774                   and aft_rvs-line.pl-code  = p-pl-code
     2775                   and aft_rvs-line.gds-code = p-gds-code
     2776               :
     2777                 assign
     2778                   p-state-measure-qnty     = p-state-measure-qnty     + aft_rvs-line.state-measure-qnty
     2779                   p-measure-qnty           = p-measure-qnty           + aft_rvs-line.measure-qnty
     2780                   p-state-measure-cli-qnty = p-state-measure-cli-qnty + aft_rvs-line.state-measure-cli-qnty
     2781                   p-measure-cli-qnty       = p-measure-cli-qnty       + aft_rvs-line.measure-cli-qnty
     2782                 .
     2783               end.
     2784             end .
     2785             assign
     2786               p-state-density          = p-state-measure-cli-qnty / p-state-measure-qnty
     2787               p-measure-density        = p-measure-cli-qnty / p-measure-qnty
     2788             .
     2789             assign
     2790               p-label = "По сверкам":U
     2791             .
     2792           end.
     2793           when 'инв':U then do:
     2794             find first rvs_trn-doc no-lock
     2795               where rvs_trn-doc.doc-code = p-doc-code
     2796               .
     2797             find first bef_rvs-doc no-lock
     2798               where bef_rvs-doc.rvs-code = rvs_trn-doc.out-code
     2799               no-error .
     2800             if available bef_rvs-doc then do:
     2801               assign
     2802                 p-label = "По сверке":U
     2803               .
     2804               find first bef_rvs-line no-lock
     2805                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     2806                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     2807                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     2808                   and bef_rvs-line.pl-code  = p-pl-code
     2809                   and bef_rvs-line.gds-code = p-gds-code
     2810                 no-error .
     2811               if available bef_rvs-line then do:
     2812                 assign
     2813                   p-state-measure-qnty     = bef_rvs-line.state-measure-qnty
     2814                   p-measure-qnty           = bef_rvs-line.measure-qnty
     2815                   p-state-measure-cli-qnty = bef_rvs-line.state-measure-cli-qnty
     2816                   p-measure-cli-qnty       = bef_rvs-line.measure-cli-qnty
     2817                   p-state-density          = bef_rvs-line.state-density
     2818                   p-measure-density        = bef_rvs-line.density
     2819                 .
     2820               end.
     2821             end.
     2822           end.
     2823         end case.
     2824       end.
     2825     end procedure.
     2826   MAIN-BLOCK:
     2827   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2828      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
