     2443   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2444   procedure minbtn-set :
     2445       do
     2446           on error undo, return error return-value
     2447           :
     2448           define variable ii              as integer       no-undo .
     2449           define variable fh              as widget-handle no-undo .
     2450           define variable hh              as widget-handle no-undo .
     2451           define variable v-h             as handle        extent 4 no-undo .
     2452           define variable v-name-button   as character     no-undo .
     2453           define variable v-help-old-x    as decimal       no-undo .
     2454           define variable v-help-old-y    as decimal       no-undo .
     2455           define variable v-help-old-size as decimal       no-undo .
     2456           define variable v-frame-width   as decimal       no-undo .
     2457           define variable jj              as integer       no-undo .
     2458           do
     2459               on error undo, return error
     2460               :
     2461               assign
     2462                   v-frame-width = frame f-doc-pl:width - 0.3
     2463                   fh            = frame f-doc-pl:first-child
     2464                   hh            = fh:first-child
     2465                   ii            = 1
     2466                   .
     2467               do while valid-handle(hh):
     2468                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2469                   do:
     2470                       case lc(hh:name) :
     2471                           when "b-help" then
     2472                               do:
     2473                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2474                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2475                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2476                                   hh:TOOLTIP = "Помощь" .
     2477                                   v-help-old-x = hh:column .
     2478                                   v-help-old-y = hh:row    .
     2479                                   v-help-old-size = hh:width .
     2480                                   hh:width-chars = 2.5 .
     2481                               end.
     2482                           when "b-print" then
     2483                               do:
     2484                                   hh:load-image("cmp/b-print.bmp":u) .
     2485                                   hh:TOOLTIP = "Печать" .
     2486                                   v-h[ii] = hh:handle .
     2487                                   ii = ii + 1 .
     2488                                   hh:width-chars = 3 .
     2489                               end.
     2490                           when "b-history" or
     2491                           when "b-hist" then
     2492                               do:
     2493                                   hh:load-image("cmp/b-hist.bmp":u) .
     2494                                   hh:TOOLTIP = "История" .
     2495                                   v-h[ii] = hh:handle .
     2496                                   ii = ii + 1 .
     2497                                   hh:width-chars = 3 .
     2498                               end.
     2499                           when "b-sch" then
     2500                               do:
     2501                                   hh:load-image("cmp/b-sch.bmp":u) .
     2502                                   hh:TOOLTIP = "Установка Фильтра" .
     2503                                   v-h[ii] = hh:handle .
     2504                                   ii = ii + 1 .
     2505                                   hh:width-chars = 3 .
     2506                               end.
     2507                           when "b-hist-user" then
     2508                               do:
     2509                                   hh:load-image("cmp/b-hist.bmp":u) .
     2510                                   hh:TOOLTIP = "История пользователя" .
     2511                                   ii = ii + 1 .
     2512                               end.
     2513                       end case.
     2514                   end.
     2515                   hh = hh:next-sibling.
     2516               end.
     2517               b-help:column = v-frame-width - b-help:width-chars.
     2518               jj = 0.
     2519               repeat ii = 4 to 1 by -1 :
     2520                   if valid-handle (v-h[ii] ) then
     2521                   do:
     2522                       jj  = jj + 1 .
     2523                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2524                       v-h[ii]:row    = v-help-old-y .
     2525                   end.
     2526               end.
     2527           end.
     2528       end.
     2529   end procedure.
     2530   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2531     procedure disp-total :
     2532       define input  parameter p-add-cli-qnty         like ub.doc-pl.cli-qnty         no-undo .
     2533       define input  parameter p-add-doc-qnty         like ub.doc-pl.doc-qnty         no-undo .
     2534       define input  parameter p-add-cli-doc-qnty     like ub.doc-pl.cli-doc-qnty     no-undo .
     2535       define input  parameter p-add-fact-qnty        like ub.doc-pl.fact-qnty        no-undo .
