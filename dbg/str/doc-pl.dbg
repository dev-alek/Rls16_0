     2337             .
     2338         end.
     2339         else do:
     2340           display
     2341             f-rvs-density
     2342             f-rvs-measure-cli-qnty
     2343             f-rvs-state-density
     2344             f-rvs-state-measure-cli-qnty
     2345             with frame f-doc-pl.
     2346         end.
     2347       end.
     2348       find first buf_place no-lock
     2349         where buf_place.obj-type = buf-obj_clients.obj-type
     2350           and buf_place.obj-code = buf-obj_clients.obj-code
     2351           and buf_place.pl-code  = loc-t-doc-pl.pl-code
     2352           and buf_place.status_ <> 'удал':U
     2353         no-error .
     2354       if available buf_place then do:
     2355         display
     2356           buf_place.pl-name
     2357           buf_place.loc1
     2358           buf_place.loc2
     2359           buf_place.loc3
     2360           buf_place.loc4
     2361           with frame f-doc-pl.
     2362       end.
     2363     end.
     2364   END.
     2365   ON LEAVE OF loc-t-doc-pl.rest-af-qnty IN FRAME f-doc-pl
     2366   or return of loc-t-doc-pl.rest-af-qnty in frame f-doc-pl
