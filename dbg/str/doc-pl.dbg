     3147           f-tot-doc-label
     3148           f-doc-line-fact-qnty
     3149           f-doc-line-cli-fact-qnty   when buf_goods.unit-base <> buf_goods.unit-cli
     3150           f-doc-line-fact-density    when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3151           with frame f-doc-pl
     3152           .
     3153       end.
     3154     end case.
     3155     if v-is-ptrl = "yes"
     3156     then do:
     3157       rvsinvObj = new rvsinvsub ().
     3158       assign
     3159         rvsinvObj:RvsCode = buf_trn-doc.out-code
     3160         rvsinvObj:ObjCode = loc-t-doc-pl.obj-code
     3161         rvsinvObj:ObjType = loc-t-doc-pl.obj-type
     3162         rvsinvObj:PlCode = loc-t-doc-pl.pl-code
     3163         rvsinvObj:GdsCode = loc-t-doc-pl.gds-code
     3164       .
     3165       if rvsinvObj:RvsInvStrObj:FillSub(rvsinvObj)
     3166       then do:
     3167           assign
     3168             f-tot-doc-pl-rest-af-qnty     :row in frame f-doc-pl   = f-tot-doc-pl-doc-qnty :row in frame f-doc-pl - 1
     3169             f-tot-doc-pl-rest-af-qnty     :handle :side-label-handle :row in frame f-doc-pl = f-tot-doc-pl-doc-qnty :row in frame f-doc-pl - 1
     3170             f-tot-doc-pl-cli-rest-af-qnty :row in frame f-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-doc-pl
     3171             f-tot-doc-pl-rest-density     :row in frame f-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-doc-pl
     3172           .
     3173           assign
     3174             frame f-doc-pl :height-chars = frame f-doc-pl :height-chars + 1
     3175             rect-tot :height-chars in frame f-doc-pl = 4.5
     3176           .
     3177           if rvsinvObj:Diff < 0
     3178           then do:
     3179             assign
     3180               f-otrnebal = absolute (rvsinvObj:Diff)
     3181               f-otrmetrerr = rvsinvObj:MeterErrWast
     3182               f-nedos = rvsinvObj:DeficitOver
     3183               f-wastcli = rvsinvObj:NaturWast
     3184               f-wast-tp = rvsinvObj:TPWast
     3185             .
     3186           end.
     3187           else do:
     3188             assign
     3189               f-polnebal = absolute (rvsinvObj:Diff)
     3190               f-polmetrerr = rvsinvObj:MeterErrWast
     3191               f-izlish = rvsinvObj:DeficitOver
     3192             .
     3193           end.
     3194           display
     3195           f-otrnebal
     3196           f-polnebal
     3197           f-lblnebal
     3198           f-lblpolnebal
     3199           f-lblotrnebal
     3200           f-lblmetrerr
     3201           f-polmetrerr
     3202           f-otrmetrerr
     3203           f-lblwastcli
     3204           f-wastcli
     3205           f-lblwast-tp
     3206           f-wast-tp
     3207           f-lbldiff
     3208           f-izlish
     3209           f-nedos
     3210             with frame f-doc-pl
     3211           .
     3212           hide
     3213             f-tot-doc-pl-fact-qnty
     3214             f-tot-doc-pl-cli-fact-qnty
     3215           in frame f-doc-pl
     3216           .
     3217         if rvsinvObj:Diff < 0
     3218         then do:
     3219           f-otrnebal = rvsinvObj:Diff.
     3220         end.
     3221         else do:
     3222         end.
     3223       end.
     3224     end.
     3225     if buf_trn-doc.doc-type = 'при':U
     3226       and buf_trn-doc.internal = false
     3227     then do:
     3228       assign
     3229         loc-t-doc-pl.cli-qnty   :label in frame f-doc-pl = substitute( "по ТТН (&1)", p-doc-line-unit-cli )
     3230       .
     3231       display
     3232         loc-t-doc-pl.cli-qnty
     3233         with frame f-doc-pl.
     3234         .
     3235     end.
     3236     case p-upd-field :
     3237       when "rest":U
     3238       or when "rest-fact":U
     3239       then do:
     3240         assign
     3241           loc-t-doc-pl.fact-qnty        :label in frame f-doc-pl = substitute( "Разница" )
     3242           loc-t-doc-pl.rest-af-qnty     :row in frame f-doc-pl   = loc-t-doc-pl.doc-qnty :row in frame f-doc-pl
     3243           loc-t-doc-pl.rest-af-qnty     :handle :side-label-handle :row in frame f-doc-pl = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     3244           loc-t-doc-pl.cli-rest-af-qnty :row in frame f-doc-pl   = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     3245           f-doc-pl-rest-density         :row in frame f-doc-pl   = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     3246         .
     3247         display
     3248           loc-t-doc-pl.fact-qnty
     3249           loc-t-doc-pl.rest-af-qnty
     3250           loc-t-doc-pl.cli-fact-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     3251           loc-t-doc-pl.cli-rest-af-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3252           f-doc-pl-rest-density         when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3253           with frame f-doc-pl.
     3254           .
     3255       end.
     3256       when "doc":U then do:
     3257         display
     3258           loc-t-doc-pl.doc-qnty
     3259           loc-t-doc-pl.cli-doc-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3260           f-doc-pl-doc-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3261           with frame f-doc-pl
     3262           .
     3263       end.
     3264       when "fact":U then do:
     3265         display
     3266           loc-t-doc-pl.doc-qnty
     3267           loc-t-doc-pl.fact-qnty
     3268           loc-t-doc-pl.cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     3269           loc-t-doc-pl.cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3270           f-doc-pl-doc-density       when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3271           f-doc-pl-fact-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3272           with frame f-doc-pl
     3273           .
     3274       end.
     3275       when "fact-doc":U then do:
     3276         display
     3277           loc-t-doc-pl.fact-qnty
     3278           loc-t-doc-pl.cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3279           f-doc-pl-fact-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3280           with frame f-doc-pl
     3281           .
     3282       end.
     3283     end case.
     3284     if p-mode = 'ПРОСМОТР':U
     3285       or buf_trn-doc.status_ = 'факт':U
     3286     then do:
     3287       disable
     3288         all
     3289         with frame f-doc-pl
     3290       .
     3291       enable
     3292         b-quit
     3293         b-help
     3294         with frame f-doc-pl
     3295       .
     3296     end.
     3297     else do:
     3298       if p-mode = 'АВТОИЗМЕНЕНИЕ':U then do:
     3299         assign
     3300           v-msg-on = true
     3301         .
     3302       end.
     3303       else do:
     3304         assign
     3305           v-msg-on = false
     3306         .
     3307       end.
     3308       find first buf_rvs-doc no-lock
     3309         where buf_rvs-doc.out-code = buf_trn-doc.doc-code
     3310           and ( buf_rvs-doc.rvs-type = 'перед_док':U
     3311                 or buf_rvs-doc.rvs-type = 'после_док':U
     3312               )
     3313         no-error .
     3314       if p-upd-field = "doc":U
     3315         or p-upd-field = "fact":U
     3316         or p-upd-field = "fact-doc":U
     3317       then do:
     3318         enable
     3319           b-qnty
     3320           with frame f-doc-pl.
     3321         if ( ( buf_trn-doc.doc-type = 'при':U
     3322               and not available buf_rvs-doc
     3323             )
     3324             or buf_trn-doc.doc-type <> 'при':U
     3325           )
     3326         then do:
     3327           enable
     3328             loc-t-doc-pl.pl-code
     3329             b-place
     3330             with frame f-doc-pl.
     3331           if loc-t-doc-pl.pl-code = ? then do:
     3332             apply "choose" to b-place in frame f-doc-pl .
     3333           end.
     3334         end.
     3335       end.
     3336       case p-upd-field :
     3337         when "rest":U then do:
     3338           if buf_goods.unit-base <> buf_goods.unit-cli then do:
     3339             enable
     3340               f-doc-pl-rest-density
     3341               with frame f-doc-pl.
     3342           end.
     3343           if p-upd-units = "cli":U
     3344             and loc-t-doc-pl.cli-rest-af-qnty :visible = true
     3345           then do:
     3346             enable
     3347               loc-t-doc-pl.cli-rest-af-qnty
     3348               with frame f-doc-pl.
     3349           end.
     3350           else do:
     3351             enable
     3352               loc-t-doc-pl.rest-af-qnty
     3353               with frame f-doc-pl.
     3354           end.
     3355         end.
     3356         when "rest-fact":U then do:
     3357           if loc-t-doc-pl.cli-fact-qnty :visible = true then do:
     3358             enable
     3359               loc-t-doc-pl.cli-fact-qnty
     3360               with frame f-doc-pl.
     3361           end.
     3362           if loc-t-doc-pl.fact-qnty :visible = true then do:
     3363             enable
     3364               loc-t-doc-pl.fact-qnty
     3365               with frame f-doc-pl.
     3366           end.
     3367         end.
     3368         when "doc":U then do:
     3369           if p-upd-units = "cli":U
     3370             and loc-t-doc-pl.cli-doc-qnty :visible = true
     3371           then do:
     3372             enable
     3373               loc-t-doc-pl.cli-doc-qnty
     3374               with frame f-doc-pl.
     3375             apply "leave" to loc-t-doc-pl.cli-doc-qnty in frame f-doc-pl .
     3376           end.
     3377           else do:
     3378             enable
     3379               loc-t-doc-pl.doc-qnty
     3380               with frame f-doc-pl.
     3381             apply "leave" to loc-t-doc-pl.doc-qnty in frame f-doc-pl .
     3382           end.
     3383         end.
     3384         when "fact":U
     3385         or when "fact-doc":U
     3386         then do:
     3387           if p-upd-units = "cli":U
     3388             and loc-t-doc-pl.cli-fact-qnty :visible = true
     3389           then do:
     3390             enable
     3391               loc-t-doc-pl.cli-fact-qnty
     3392               with frame f-doc-pl.
     3393             apply "leave" to loc-t-doc-pl.cli-fact-qnty in frame f-doc-pl .
     3394           end.
     3395           else do:
     3396             enable
     3397               loc-t-doc-pl.fact-qnty
     3398               with frame f-doc-pl.
     3399             apply "leave" to loc-t-doc-pl.fact-qnty in frame f-doc-pl .
     3400           end.
     3401         end.
     3402       end case.
     3403       assign
     3404         v-msg-on = true
     3405       .
     3406     end.
     3407     apply "value-changed" to loc-t-doc-pl.pl-code in frame f-doc-pl.
     3408     WAIT-FOR GO OF FRAME f-doc-pl.
     3409   END.
     3410   RUN disable_UI.
     3411   delete loc-t-doc-pl .
     3412   PROCEDURE calc-qnty :
     3413   do
     3414     on error undo, return error return-value
     3415     :
     3416       case p-upd-field :
     3417         when "rest":U then do:
     3418           assign
     3419             loc-t-doc-pl.fact-qnty     = loc-t-doc-pl.rest-af-qnty - loc-t-doc-pl.rest-bf-qnty
     3420             loc-t-doc-pl.cli-fact-qnty = loc-t-doc-pl.cli-rest-af-qnty - loc-t-doc-pl.cli-rest-bf-qnty
     3421           .
     3422         end.
     3423         when "rest-fact":U then do:
     3424           assign
     3425             loc-t-doc-pl.rest-af-qnty     = loc-t-doc-pl.rest-bf-qnty + loc-t-doc-pl.fact-qnty
     3426             loc-t-doc-pl.cli-rest-af-qnty = loc-t-doc-pl.cli-rest-bf-qnty + loc-t-doc-pl.cli-fact-qnty
     3427           .
     3428           if loc-t-doc-pl.rest-af-qnty <> 0.0
     3429             and loc-t-doc-pl.cli-rest-af-qnty <> 0.0
     3430           then do:
     3431             assign
     3432               f-doc-pl-rest-density = loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty
     3433             .
     3434           end.
     3435           else do:
     3436             assign
     3437               f-doc-pl-rest-density = p-doc-line-rest-density
     3438             .
     3439           end.
     3440         end.
     3441       end case.
     3442       display
     3443         loc-t-doc-pl.cli-qnty         when loc-t-doc-pl.cli-qnty :visible = true
     3444         loc-t-doc-pl.doc-qnty         when loc-t-doc-pl.doc-qnty :visible = true
     3445         loc-t-doc-pl.cli-doc-qnty     when loc-t-doc-pl.cli-doc-qnty :visible = true
     3446         loc-t-doc-pl.fact-qnty        when loc-t-doc-pl.fact-qnty :visible = true
     3447         loc-t-doc-pl.cli-fact-qnty    when loc-t-doc-pl.cli-fact-qnty :visible = true
     3448         loc-t-doc-pl.rest-af-qnty     when loc-t-doc-pl.rest-af-qnty :visible = true
     3449         loc-t-doc-pl.cli-rest-af-qnty when loc-t-doc-pl.cli-rest-af-qnty :visible = true
     3450         f-doc-pl-rest-density         when f-doc-pl-rest-density :visible = true
     3451         with frame f-doc-pl.
     3452     end.
     3453   END PROCEDURE.
     3454   PROCEDURE disable_UI :
     3455     HIDE FRAME f-doc-pl.
     3456   END PROCEDURE.
     3457   PROCEDURE enable_UI :
     3458     DISPLAY f-prod-name f-units-base
     3459         WITH FRAME f-doc-pl.
     3460     IF AVAILABLE buf-obj_clients THEN
     3461       DISPLAY buf-obj_clients.obj-type buf-obj_clients.obj-code
     3462             buf-obj_clients.obj-name
     3463         WITH FRAME f-doc-pl.
     3464     IF AVAILABLE buf_goods THEN
     3465       DISPLAY buf_goods.gds-code buf_goods.gds-name buf_goods.artic
     3466             buf_goods.prod-type buf_goods.prod-code
     3467         WITH FRAME f-doc-pl.
     3468     IF AVAILABLE buf_place THEN
     3469       DISPLAY buf_place.pl-name buf_place.loc1 buf_place.loc2 buf_place.loc3
     3470             buf_place.loc4
     3471         WITH FRAME f-doc-pl.
     3472     IF AVAILABLE loc-t-doc-pl THEN
     3473       DISPLAY loc-t-doc-pl.pl-code
     3474         WITH FRAME f-doc-pl.
     3475     ENABLE b-exit b-quit b-help
     3476         WITH FRAME f-doc-pl.
     3477   END PROCEDURE.
