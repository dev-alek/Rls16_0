     2620           .
     2621         end.
     2622         else do:
     2623           assign
     2624             f-tot-doc-pl-cli-doc-qnty :fgcolor = ?
     2625             f-doc-line-cli-doc-qnty   :fgcolor = ?
     2626           .
     2627         end.
     2628       end.
     2629       if f-tot-doc-pl-cli-qnty :visible = true
