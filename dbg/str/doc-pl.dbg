      763   function is-sug returns logical
      764           (input p-gds-code as integer):
      765   define variable result as logical no-undo.
      766   define variable c-value as character no-undo.
      767   define variable c-type as character no-undo.
      768   do on error undo, return error:
      769           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      770         (input  p-gds-code
      771         ,input  'fuel-type':U
      772         ,output c-value
      773         ,output c-type) no-error.
      774   end.
      775   result = logical(c-value = 'lgas':U) no-error.
      776   return result.
      777   end function.
      778   procedure placelib_write-attr:
      779   define input  parameter p-code     like ub.place-attr.attr-code .
      780   define input  parameter p-obj-code like ub.place-attr.obj-code .
      781   define input  parameter p-obj-type like ub.place-attr.obj-type .
      782   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      783   define input  parameter p-value    like ub.place-attr.attr-value .
      784   define output parameter p-ok       as logical.
      785   define buffer buf_place-attr for ub.place-attr .
      786     do on error undo, return error return-value :
      787        p-ok = false.
      788        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      789                                                   and buf_place-attr.obj-code    = p-obj-code
      790                                                   and buf_place-attr.obj-type    = p-obj-type
      791                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      792        if not available buf_place-attr then do :
      793           create buf_place-attr.
      794           assign
      795             buf_place-attr.attr-code   = p-code
      796             buf_place-attr.attr-value  = p-value
      797             buf_place-attr.obj-code    = p-obj-code
      798             buf_place-attr.obj-type    = p-obj-type
      799             buf_place-attr.pl-code     = p-pl-code
      800           .
      801           p-ok = true.
      802        end.
      803        else do:
      804           buf_place-attr.attr-value  = p-value .
      805           p-ok = true.
      806        end.
      807     end.
      808   end.
      809   procedure placelib_get-attr:
      810   define input  parameter  p-code     like ub.place-attr.attr-code .
      811   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      812   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      813   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      814   define output parameter  p-value    like ub.place-attr.attr-value .
      815   define output parameter  p-ok       as logical.
      816   define buffer buf_place-attr for ub.place-attr .
      817     do on error undo, return error return-value :
      818        p-ok = false.
      819        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      820                                                   and buf_place-attr.obj-code    = p-obj-code
      821                                                   and buf_place-attr.obj-type    = p-obj-type
      822                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      823        if available buf_place-attr then do :
      824          p-value = buf_place-attr.attr-value.
      825          p-ok = true.
      826        end.
      827        else do :
      828          p-ok = false.
      829        end.
      830     end.
      831   end.
      832   procedure placelib_del-attr:
      833   define input parameter  p-code     like ub.place-attr.attr-code .
      834   define input parameter  p-obj-code like ub.place-attr.obj-code .
      835   define input parameter  p-obj-type like ub.place-attr.obj-type .
      836   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      837   define input parameter  p-value    like ub.place-attr.attr-value .
      838   define output parameter p-ok       as logical.
      839   define buffer buf_place-attr for ub.place-attr .
      840     do on error undo, return error return-value :
      841        p-ok = false.
      842        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      843                                                   and buf_place-attr.obj-code    = p-obj-code
      844                                                   and buf_place-attr.obj-type    = p-obj-type
      845                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      846        if available buf_place-attr then do :
      847           delete buf_place-attr.
      848           p-ok = true.
      849        end.
      850     end.
      851   end.
      852     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      853       define variable v-answ as logical no-undo .
      854       if ( p-unit-base-cli-eq = true
      855            and p-density = 1.0
      856          )
      857         or ( p-unit-base-cli-eq = false
      858              and p-density <> ?
      859              and p-density > 0.0
      860              and p-density < 1.0
      861            )
      862       then do:
      863         assign
      864           v-answ = true
      865         .
      866       end.
      867       else do:
      868         assign
      869           v-answ = false
      870         .
      871       end.
      872       return v-answ.
      873     end function.
