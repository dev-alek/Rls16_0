     2633             and absolute( f-tot-doc-pl-cli-qnty - f-doc-line-cli-qnty ) > 0.001
     2634            )
     2635            or
     2636            ( p-upd-units = "cli":U
     2637              and f-tot-doc-pl-cli-qnty <> f-doc-line-cli-qnty
     2638            )
     2639         then do:
     2640           assign
     2641             f-tot-doc-pl-cli-qnty :fgcolor = 12
     2642             f-doc-line-cli-qnty   :fgcolor = 12
     2643           .
     2644         end.
     2645         else do:
     2646           assign
     2647             f-tot-doc-pl-cli-qnty :fgcolor = ?
     2648             f-doc-line-cli-qnty   :fgcolor = ?
     2649           .
