        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения складского места":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      113   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      114   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      115   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      116   define frame fr-D-place-8
      117     ub.c-place.pl-code  at row  1.25 col  9.50 colon-aligned view-as fill-in    size-chars 10.50 by 1.00                         fgcolor  4
      118     ub.c-place.pl-name  at row  1.25 col 39.50 colon-aligned view-as fill-in    size-chars 58.00 by 1.00                         fgcolor  4
      119     ub.c-place.loc1     at row  2.50 col  9.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00
      120     ub.c-place.loc2     at row  3.75 col  9.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00
      121     ub.c-place.loc3     at row  5.00 col  9.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00
      122     ub.c-place.loc4     at row  6.25 col  9.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00
      123     ub.c-place.add-qnty at row  7.75 col 39.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00    label "Дополнительное кол-во(в трубопроводе)" fgcolor 12
      124     ub.c-place.max-qnty at row  9.00 col 39.50 colon-aligned view-as fill-in    size-chars 11.63 by 1.00    label "Максимальное количество" fgcolor 12
      125     ub.c-place.is-meas  at row 10.25 col  2.50          view-as toggle-box size-chars  23.50 by 1.00
      126     ub.c-place.PS       at row 11.75 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars  98.25 by 3.50 no-label                bgcolor 15
      127     r-rect-0          at row 15.75 col  1.50
      128       Btn_Exit        at row 16.00 col  2.50
      129       Btn_OK          at row 16.00 col 78.00
      130     b-help       at row 16.00 col 88.75
      131   with view-as dialog-box side-labels no-underline three-d scrollable
      132        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      133   assign frame fr-D-place-8 :scrollable = no.
      134   on choose of Btn_OK in frame fr-D-place-8 do:
      135   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   if lookup(self :type
      137            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      138            ) = 0
      139   then do:
      140     message
      141       "$Workfile$"
      142       "Указанному интерфейсному элементу фокус не может быть передан" skip
      143       "Интерфейсный элемент" self :name  skip
      144       "Тип" self :type  skip
      145       "Процедура" this-procedure :file-name skip
      146       view-as alert-box .
      147   end.
      148   else do:
      149     apply "entry":u to self  .
      150     if focus :handle <> self :handle  then do:
      151       return no-apply .
      152     end.
      153   end.
      154     apply "GO":U to frame fr-D-place-8.
      155   end.
      156   on choose of Btn_Exit in frame fr-D-place-8 do:
      157   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   if lookup(self :type
      159            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      160            ) = 0
      161   then do:
      162     message
      163       "$Workfile$"
      164       "Указанному интерфейсному элементу фокус не может быть передан" skip
      165       "Интерфейсный элемент" self :name  skip
      166       "Тип" self :type  skip
      167       "Процедура" this-procedure :file-name skip
      168       view-as alert-box .
      169   end.
      170   else do:
      171     apply "entry":u to self  .
      172     if focus :handle <> self :handle  then do:
      173       return no-apply .
      174     end.
      175   end.
      176   end.
      177   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   on F1 of frame fr-D-place-8 anywhere do:
      179     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-place-8. END.
      180     return no-apply.
      181   end.
      182   if valid-handle( active-window ) and frame fr-D-place-8 :parent = ? then frame fr-D-place-8 :parent = active-window.
      183   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      184   on window-close of frame fr-D-place-8 do: apply "END-ERROR":U to self. end.
      185   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   on help of frame fr-D-place-8
      187   do:
      188     run gbl/app_help.p
      189       (input this-procedure :file-name
      190       ,input ''
      191       ,input ?
      192       ) no-error.
      193     if error-status :error then do:
      194       message
      195         "Ошибка при вызове помощи"
      196         error-status :get-message(1)
      197         view-as alert-box .
      198     end.
      199   end.
      200   run minbtn-set in this-procedure .
      201   on choose of b-help in frame fr-D-place-8
      202   do:
      203     apply "help":u to frame fr-D-place-8 .
      204   end.
      205   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   procedure minbtn-set :
      207       do
      208           on error undo, return error return-value
      209           :
      210           define variable ii              as integer       no-undo .
      211           define variable fh              as widget-handle no-undo .
      212           define variable hh              as widget-handle no-undo .
      213           define variable v-h             as handle        extent 4 no-undo .
      214           define variable v-name-button   as character     no-undo .
      215           define variable v-help-old-x    as decimal       no-undo .
      216           define variable v-help-old-y    as decimal       no-undo .
      217           define variable v-help-old-size as decimal       no-undo .
      218           define variable v-frame-width   as decimal       no-undo .
      219           define variable jj              as integer       no-undo .
      220           do
      221               on error undo, return error
      222               :
      223               assign
      224                   v-frame-width = frame fr-D-place-8:width - 0.3
      225                   fh            = frame fr-D-place-8:first-child
      226                   hh            = fh:first-child
      227                   ii            = 1
      228                   .
      229               do while valid-handle(hh):
      230                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      231                   do:
      232                       case lc(hh:name) :
      233                           when "b-help" then
      234                               do:
      235                                   hh:load-image-up("cmp/b-help.bmp":u) .
      236                                   hh:load-image-down("cmp/b-help.bmp":u) .
      237                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      238                                   hh:TOOLTIP = "Помощь" .
      239                                   v-help-old-x = hh:column .
      240                                   v-help-old-y = hh:row    .
      241                                   v-help-old-size = hh:width .
      242                                   hh:width-chars = 2.5 .
      243                               end.
      244                           when "b-print" then
      245                               do:
      246                                   hh:load-image("cmp/b-print.bmp":u) .
      247                                   hh:TOOLTIP = "Печать" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-history" or
      253                           when "b-hist" then
      254                               do:
      255                                   hh:load-image("cmp/b-hist.bmp":u) .
      256                                   hh:TOOLTIP = "История" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-sch" then
      262                               do:
      263                                   hh:load-image("cmp/b-sch.bmp":u) .
      264                                   hh:TOOLTIP = "Установка Фильтра" .
      265                                   v-h[ii] = hh:handle .
      266                                   ii = ii + 1 .
      267                                   hh:width-chars = 3 .
      268                               end.
      269                           when "b-hist-user" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История пользователя" .
      273                                   ii = ii + 1 .
      274                               end.
      275                       end case.
      276                   end.
      277                   hh = hh:next-sibling.
      278               end.
      279               b-help:column = v-frame-width - b-help:width-chars.
      280               jj = 0.
      281               repeat ii = 4 to 1 by -1 :
      282                   if valid-handle (v-h[ii] ) then
      283                   do:
      284                       jj  = jj + 1 .
      285                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      286                       v-h[ii]:row    = v-help-old-y .
      287                   end.
      288               end.
      289           end.
      290       end.
      291   end procedure.
      292   Main-Block:
      293   do on error   undo Main-Block, leave Main-Block
      294      on end-key undo Main-Block, leave Main-Block :
      295     if p-mode <> 'ПРОСМОТР':U then do:
      296       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      297               "Неверное значение параметра вызова p-mode:" p-mode
      298       view-as alert-box error.
      299       undo Main-Block, return error.
      300     end.
      301     find ub.c-place no-lock where recid( ub.c-place ) = p-rec-id no-error.
      302     if not available ub.c-place then do:
      303       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      304               "Карточка истории складского места не найдена!"
      305       view-as alert-box error.
      306       undo Main-Block, leave Main-Block.
      307     end.
      308     assign frame fr-D-place-8 :title = "Карточка изменения складского места " +
      309       substitute( '"&1" (объект "&2" &3) -- &4', ub.c-place.pl-name, ub.c-place.obj-type, ub.c-place.obj-code, p-mode ).
      310     display ub.c-place.pl-code
      311             ub.c-place.pl-name
      312             ub.c-place.loc1
      313             ub.c-place.loc2
      314             ub.c-place.loc3
      315             ub.c-place.loc4
      316             ub.c-place.is-meas
      317             ub.c-place.add-qnty
      318             ub.c-place.max-qnty
      319             ub.c-place.PS
      320     with frame fr-D-place-8.
      321     enable ub.c-place.PS Btn_Exit b-help with frame fr-D-place-8.
      322     assign ub.c-place.PS :read-only in frame fr-D-place-8 = yes.
      323     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-place-8. end.
      324     wait-for go of frame fr-D-place-8.
      325   end.
      326   hide frame fr-D-place-8 no-pause.
