        1   block-level on error undo, throw.
        2   define input parameter    p-mode            AS   character NO-UNDO.
        3   define input PARAMETER    p-obj-type        LIKE ub.wth-parts.obj-type.
        4   define input PARAMETER    p-obj-code        LIKE ub.wth-parts.obj-code.
        5   define input parameter    p-w-p-code        LIKE ub.wth-parts.w-p-code.
        6   define input parameter    p-wth-code        LIKE ub.wth-parts.wth-code.
        7   define input parameter    p-par-code        LIKE ub.wth-parts.par-code.
        8   define input parameter    p-in-code         LIKE ub.wth-parts.in-code .
        9   define input parameter    p-out-code        LIKE ub.wth-parts.out-code.
       10   define input parameter    p-ser-code        LIKE ub.wth-parts.ser-code.
       11   define input parameter    p-db-num          LIKE ub.wth-parts.db-num  .
       12   define input parameter    p-Fact-RangeFrom  LIKE ub.wth-parts.Fact-RangeFrom.
       13   define input parameter    p-Fact-RangeTo    LIKE ub.wth-parts.Fact-RangeTo.
       14   define input parameter    p-Doc-RangeFrom   LIKE ub.wth-parts.doc-RangeFrom.
       15   define input parameter    p-Doc-RangeTo     LIKE ub.wth-parts.doc-RangeTo.
       16   define input parameter    p-host-code       LIKE ub.wth-parts.host-code  .
       17   define input parameter    p-contract-code   LIKE ub.wth-parts.contract-code.
       18   define input parameter    p-price-rubl      LIKE ub.wth-parts.price-rubl .
       19   define input parameter    p-price-base      LIKE ub.wth-parts.price-base .
       20   define input parameter    p-supp-type       LIKE ub.wth-parts.supp-type  .
       21   define input parameter    p-supp-code       LIKE ub.wth-parts.supp-code  .
       22   define input parameter    p-in-obj-type     LIKE ub.wth-parts.in-obj-type.
       23   define input parameter    p-in-obj-code     LIKE ub.wth-parts.in-obj-code.
       24   define input parameter    p-ext-doc-type    LIKE ub.wth-parts.ext-doc-type.
       25   define input parameter    p-gds-code        LIKE ub.wth-parts.gds-code   .
       26   define input parameter    p-stts            LIKE ub.wth-parts.stts       .
       27   define input parameter    p-beg-dt          LIKE ub.wth-parts.beg-dt     .
       28   define input parameter    p-end-dt          LIKE ub.wth-parts.end-dt     .
       29   define input parameter    p-vat-pc          LIKE ub.wth-parts.vat-pc     .
       30   define input parameter    p-cli-code        LIKE ub.wth-parts.cli-code   .
       31   define input parameter    p-cli-type        LIKE ub.wth-parts.cli-type   .
       32   define input parameter    p-out-obj-code    LIKE ub.wth-parts.out-obj-code.
       33   define input parameter    p-out-obj-type    LIKE ub.wth-parts.out-obj-type.
       34   define input parameter    p-sale-obj-code   LIKE ub.wth-parts.sale-obj-code.
       35   define input parameter    p-sale-obj-type   LIKE ub.wth-parts.sale-obj-type.
       36   define input parameter    p-doc-code        LIKE ub.wth-parts.doc-code.
       37   define input parameter    p-silent          as logical   no-undo .
       38   define input parameter    p-type            LIKE ub.wth-parts.type.
       39   define input-output parameter p-rec         as recid     no-undo .
       40   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       41   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       42   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       43   define variable vss-workfile    as character no-undo init "$Workfile: wthpartp.p $":U .
       44   define variable vss-archive     as character no-undo init "$Archive: str/wthpartp.p $":U .
       45   define variable vss-description as character no-undo init "Сохранение партии МЦ".
       46   procedure vss-get-info :
       47     define output parameter p-vss-revision    like vss-revision    no-undo .
       48     define output parameter p-vss-author      like vss-author      no-undo .
       49     define output parameter p-vss-date        like vss-date        no-undo .
       50     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       51     define output parameter p-vss-archive     like vss-archive     no-undo .
       52     define output parameter p-vss-description like vss-description no-undo .
       53     assign
       54       p-vss-revision    = vss-revision
       55       p-vss-author      = vss-author
       56       p-vss-date        = vss-date
       57       p-vss-workfile    = vss-workfile
       58       p-vss-archive     = vss-archive
       59       p-vss-description = vss-description
       60     .
       61   end procedure.
       62   procedure vss-get-parameters :
       63     define output parameter p-vss-parameters as character no-undo .
       64   end procedure.
       65   define new global shared variable g#vssrevis-logger as handle    no-undo .
       66   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       67   define variable v-vssrevis-logger                   as handle    no-undo .
       68   procedure vss-logevent :
       69     define input  parameter p-extra-paramters as character no-undo .
       70     define variable v-vssrevis-parameters as character no-undo .
       71     do
       72     on error undo, return error return-value
       73     :
       74       if  valid-handle(v-vssrevis-logger)
       75       and v-vssrevis-logger :get-signature("logevent") <> ""
       76       then do:
       77         run vss-get-parameters in this-procedure
       78           (output v-vssrevis-parameters
       79           ).
       80         run logevent in v-vssrevis-logger
       81           (input vss-workfile
       82           ,input vss-revision
       83           ,input v-vssrevis-parameters
       84           ,input p-extra-paramters
       85           ).
       86       end.
       87     end.
       88   end procedure.
       89   assign
       90     v-vssrevis-logger = g#vssrevis-logger
       91   .
       92   if  valid-handle(v-vssrevis-logger)
       93   and v-vssrevis-logger :get-signature("logevent") <> ""
       94   then do:
       95     assign
       96       v-vssrevis-logevent = true
       97     .
       98     run vss-logevent in this-procedure (input vss-description) .
       99   end.
      100   define new global shared variable g#language as character no-undo .
      101   if g#language <> '' and g#language <> 'rus':U then do:
      102     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      103   end.
      104   define new global shared variable g#library  as handle no-undo .
      105   define new global shared variable g#library2 as handle no-undo .
      106   define   shared variable g#auto as logical no-undo.
      107   define   shared variable g#news as logical no-undo.
      108   define   shared variable g#oxml as logical no-undo.
      109   define   shared variable g#esys as logical no-undo.
      110   define   shared variable g#news-source-db as integer no-undo.
      111   define   shared variable g#esys-source-esys as integer no-undo.
      112   define   shared variable g#db-num as integer   no-undo .
      113   define   shared variable g#userid as character no-undo .
      114   define   shared variable g#passwd as character no-undo .
      115   DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
      116   define buffer buf_wealth    for ub.wealth.
      117   define buffer buf_wth-par   for ub.wth-par.
      118   define buffer buf_wth-doc   for ub.wth-doc.
      119   define buffer buf_wth-gds   for ub.wth-gds.
      120   define buffer b_wth-parts   for ub.wth-parts.
      121   define variable v-mess    as character    no-undo.
      122   if p-mode  = 'ДОБАВЛЕНИЕ':U then p-rec = ?.
      123     if p-wth-code > 0 then.
      124     else do:
      125         v-mess =  "Не указан код МЦ" .
      126       run err-mess in this-procedure ( input-output v-mess).
      127       return error (if p-silent = yes then v-mess else 'wth-code':U).
      128     end.
      129     if p-doc-RangeTo - p-doc-RangeFrom + 1 > 0 THEN.
      130     else do:
      131           v-mess =  "Некорректно указаны фактические границы диапазона" .
      132       run err-mess in this-procedure ( input-output v-mess).
      133       return error (if p-silent = yes then v-mess else 'doc-RangeFrom':U).
      134     end.
      135     if p-fact-RangeTo - p-fact-RangeFrom + 1 > 0 THEN.
      136     else do:
      137           v-mess =  "Некорректно указаны границы диапазона" .
      138       run err-mess in this-procedure ( input-output v-mess).
      139       return error (if p-silent = yes then v-mess else 'fact-RangeFrom':U).
      140     end.
      141     if p-doc-rangeFrom > p-fact-rangeFrom
      142         or p-doc-rangeTo   < p-fact-rangeTo  then do:
      143       v-mess =  substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.',chr(10),p-doc-rangeFrom,p-doc-rangeTo).
      144       run err-mess in this-procedure ( input-output v-mess).
      145       return error (if p-silent = yes then v-mess else 'fact-RangeFrom':U).
      146     end.
      147     if p-ser-code > 0 then.
      148     else do:
      149             v-mess =  "Не указана серия МЦ" .
      150       run err-mess in this-procedure ( input-output v-mess).
      151       return error (if p-silent = yes then v-mess else 'ser-code':U).
      152     end.
      153     find first buf_wealth no-lock where
      154             buf_wealth.wth-code = p-wth-code no-error .
      155     if not available buf_wealth then do:
      156           v-mess = substitute("Не найдена МЦ &1!",p-wth-code).
      157       run err-mess in this-procedure ( input-output v-mess).
      158       return error (if p-silent = yes then v-mess else 'wth-code':U).
      159     end.
      160     if p-par-code > 0 then.
      161     else do:
      162             v-mess =  "Не указан код номинала МЦ" .
      163       run err-mess in this-procedure ( input-output v-mess).
      164       return error (if p-silent = yes then v-mess else 'par-code':U).
      165     end.
      166     find first buf_wth-par no-lock where
      167             buf_wth-par.par-code = p-par-code
      168             and buf_wth-par.wth-code = p-wth-code no-error .
      169     if not available buf_wth-par then do:
      170       v-mess =   substitute("Не найден номинал МЦ с кодом &1 и кодом МЦ &2!",p-par-code,p-wth-code).
      171       run err-mess in this-procedure ( input-output v-mess).
      172       return error (if p-silent = yes then v-mess else 'par-code':U).
      173     end.
      174     IF LOOKUP(p-out-code, 'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 THEN DO:
      175         find first buf_wth-doc no-lock where
      176                 buf_wth-doc.doc-code = p-out-code no-error .
      177         if not available buf_wth-doc then do:
      178           v-mess =  substitute("Не найден Документ МЦ с кодом &1 !",p-out-code).
      179           run err-mess in this-procedure ( input-output v-mess).
      180           return error (if p-silent = yes then v-mess else 'out-code':U).
      181         end.
      182     END.
      183     else do:
      184         find first buf_wth-doc no-lock where
      185                 buf_wth-doc.doc-code = p-doc-code no-error .
      186     end.
      187     find first buf_wth-gds no-lock where
      188             buf_wth-gds.wth-code = p-wth-code
      189         and buf_wth-gds.gds-code = p-gds-code no-error .
      190     if not available buf_wth-gds then do:
      191           v-mess =  substitute("Не найдена Связка товара &2 c МЦ с кодом &1 !",p-wth-code,p-gds-code).
      192           run err-mess in this-procedure ( input-output v-mess).
      193           return error (if p-silent = yes then v-mess else 'gds-code':U).
      194     end.
      195     if p-beg-dt <> ? and p-end-dt <> ? and p-beg-dt > p-end-dt then do:
      196           v-mess =  substitute('Неверно указан срок действия партии: &1 - &2!',p-beg-dt,p-end-dt).
      197           run err-mess in this-procedure ( input-output v-mess).
      198           return error (if p-silent = yes then v-mess else 'beg-dt':U).
      199     end.
      200    if p-mode = 'ИЗМЕНЕНИЕ':U
      201    then do:
      202       FIND FIRST buf_wth-parts no-LOCK WHERE recid(buf_wth-parts) = p-rec  no-error.
      203       if not available buf_wth-parts then return error substitute('Неверно указаны параметры. Не найдена партия с recid &1',p-rec).
      204       if buf_wth-parts.ser-code = p-ser-code and buf_wth-parts.db-num = p-db-num then.
      205       else do:
      206               v-mess =  substitute("Нельзя изменить код Серии или № БД в партии МЦ &1" +
      207                                  "старый код серии - &2 № БД - &3"
      208                                  ,chr(10)
      209                                  , buf_wth-parts.ser-code
      210                                  , buf_wth-parts.db-num).
      211   .
      212           run err-mess in this-procedure ( input-output v-mess).
      213           return error (if p-silent = yes then v-mess else 'gds-code':U).
      214       end.
      215    end.
      216    find first b_wth-parts no-lock where
      217                    b_wth-parts.obj-type = p-obj-type
      218                and b_wth-parts.obj-code = p-obj-code
      219                and b_wth-parts.w-p-code = p-w-p-code
      220                and b_wth-parts.wth-code = p-wth-code
      221                and b_wth-parts.par-code = p-par-code
      222                and ((buf_wth-doc.ext-doc-type <> 'ie':U and b_wth-parts.in-code  = p-in-code)
      223                     or   buf_wth-doc.ext-doc-type = 'ie':U)
      224                and b_wth-parts.out-code = p-out-code
      225                and b_wth-parts.ser-code = p-ser-code
      226                and b_wth-parts.db-num   = p-db-num
      227                and ((b_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
      228                        and b_wth-parts.fact-rangeTo >= p-fact-rangeFrom )
      229                     or (b_wth-parts.fact-rangeFrom <= p-fact-rangeTo
      230                         and b_wth-parts.fact-rangeTo >= p-fact-rangeTo )
      231                     or (b_wth-parts.fact-rangeFrom >= p-fact-rangeFrom
      232                         and b_wth-parts.fact-rangeTo <= p-fact-rangeTo )
      233                     )
      234                and recid(b_wth-parts) <> p-rec
      235                no-error.
      236      if available b_wth-parts then do:
      237       if g#news  then  do:
      238       p-in-code = p-in-code + 'фальшивый':U.
      239       end.
      240       else do:
      241           v-mess =  substitute('Существует партия с пересекающимся диапазоном. &1 Указанный диапазон: &2 - &3&1Диапазон существующей партии: &4 - &5&1
      242                                документ порождения - &6 &1
      243                                документ/зона - &7' ,
      244                               chr(10)
      245                               ,p-fact-rangeFrom
      246                               ,p-fact-rangeTo
      247                               ,b_wth-parts.fact-rangeFrom
      248                               ,b_wth-parts.fact-rangeTo
      249                               ,p-in-code
      250                               ,p-out-code) .
      251           run err-mess in this-procedure ( input-output v-mess).
      252           return error (if p-silent = yes then v-mess else 'fact-rangeFrom':U).
      253       end.
      254      end.
      255   main-block:
      256   do
      257   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      258   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      259   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      260   :
      261   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      262       create buf_wth-parts.
      263   END.
      264   ELSE DO:
      265       FIND FIRST buf_wth-parts WHERE recid(buf_wth-parts) = p-rec EXCLUSIVE-LOCK.
      266   END.
      267       assign
      268           buf_wth-parts.obj-type        =   p-obj-type
      269           buf_wth-parts.obj-code        =   p-obj-code
      270           buf_wth-parts.w-p-code        =   p-w-p-code
      271           buf_wth-parts.wth-code        =   p-wth-code
      272           buf_wth-parts.par-code        =   p-par-code
      273           buf_wth-parts.in-code         =   p-in-code
      274           buf_wth-parts.out-code        =   p-out-code
      275           buf_wth-parts.ser-code        =   p-ser-code
      276           buf_wth-parts.db-num          =   p-db-num
      277           buf_wth-parts.Fact-RangeFrom  =   p-Fact-RangeFrom
      278           buf_wth-parts.Fact-RangeTo    =   p-Fact-RangeTo
      279           buf_wth-parts.doc-RangeFrom   =   p-Doc-RangeFrom
      280           buf_wth-parts.doc-RangeTo     =   p-Doc-RangeTo
      281           buf_wth-parts.host-code       =   p-host-code
      282           buf_wth-parts.contract-code   =   p-contract-code
      283           buf_wth-parts.price-rubl      =   IF p-price-rubl = ? THEN 0 ELSE p-price-rubl
      284           buf_wth-parts.price-base      =   IF p-price-base = ? THEN 0 ELSE p-price-base
      285           buf_wth-parts.supp-type       =   p-supp-type
      286           buf_wth-parts.supp-code       =   p-supp-code
      287           buf_wth-parts.in-obj-type     =   p-in-obj-type
      288           buf_wth-parts.in-obj-code     =   p-in-obj-code
      289           buf_wth-parts.ext-doc-type    =   p-ext-doc-type
      290           buf_wth-parts.gds-code        =   p-gds-code
      291           buf_wth-parts.stts            =   p-stts
      292           buf_wth-parts.beg-dt          =   p-beg-dt
      293           buf_wth-parts.end-dt          =   p-end-dt
      294           buf_wth-parts.vat-pc          =   p-vat-pc
      295           buf_wth-parts.cli-code        =   p-cli-code
      296           buf_wth-parts.cli-type        =   p-cli-type
      297           buf_wth-parts.out-obj-code    =   p-out-obj-code
      298           buf_wth-parts.out-obj-type    =   p-out-obj-type
      299           buf_wth-parts.sale-obj-code   =   p-sale-obj-code
      300           buf_wth-parts.sale-obj-type   =   p-sale-obj-type
      301           buf_wth-parts.doc-code        =   p-doc-code
      302           buf_wth-parts.type            =   p-type
      303          .
      304           if available buf_wth-doc then do:
      305           assign
      306             buf_wth-parts.fact-date       =   buf_wth-doc.fact-date
      307             buf_wth-parts.fact-num        =   buf_wth-doc.fact-num
      308             buf_wth-parts.fact-order      =   buf_wth-doc.fact-order
      309             buf_wth-parts.shift-num       =   buf_wth-doc.shift-num
      310             buf_wth-parts.shift-date      =   buf_wth-doc.shift-date
      311             buf_wth-parts.ext-doc-type    =   buf_wth-doc.ext-doc-type
      312           .
      313           IF LOOKUP(p-out-code, 'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0 THEN
      314           case buf_wth-doc.ext-doc-type:
      315             when 'ie':U then assign
      316                                       buf_wth-parts.in-obj-type     =   buf_wth-doc.obj-type
      317                                       buf_wth-parts.in-obj-code     =   buf_wth-doc.obj-code
      318                                       buf_wth-parts.supp-type       =   buf_wth-doc.cli-type
      319                                       buf_wth-parts.supp-code       =   buf_wth-doc.cli-code
      320                                       buf_wth-parts.in-code         =   buf_wth-doc.doc-code
      321                                              .
      322             when 'ee':U then assign
      323                     buf_wth-parts.cli-code        =   buf_wth-doc.cli-code
      324                     buf_wth-parts.cli-type        =   buf_wth-doc.cli-type
      325                     buf_wth-parts.sale-obj-code   =   buf_wth-doc.obj-code
      326                     buf_wth-parts.sale-obj-type   =   buf_wth-doc.obj-type
      327                    .
      328             when 'pc':U or when 'pz':U then assign
      329                     buf_wth-parts.out-obj-code   =   buf_wth-doc.obj-code
      330                     buf_wth-parts.out-obj-type   =   buf_wth-doc.obj-type
      331                    .
      332             when 'ps':U then assign
      333                     buf_wth-parts.out-obj-code   =   buf_wth-doc.cli-code
      334                     buf_wth-parts.out-obj-type   =   buf_wth-doc.cli-type
      335                    .
      336             when 'xc':U  then do:
      337                if buf_wth-parts.type = 'при':U then assign
      338                     buf_wth-parts.out-obj-code   =   buf_wth-doc.obj-code
      339                     buf_wth-parts.out-obj-type   =   buf_wth-doc.obj-type
      340                    .
      341                else assign
      342                     buf_wth-parts.cli-code        =   buf_wth-doc.cli-code
      343                     buf_wth-parts.cli-type        =   buf_wth-doc.cli-type
      344                     buf_wth-parts.sale-obj-code   =   buf_wth-doc.obj-code
      345                     buf_wth-parts.sale-obj-type   =   buf_wth-doc.obj-type
      346                    .
      347             end.
      348           end case.
      349         end.
      350         case buf_wth-parts.out-code:
      351           when 'free-zone':U then assign
      352                     buf_wth-parts.cli-code        =   0
      353                     buf_wth-parts.cli-type        =   '':U
      354                     buf_wth-parts.sale-obj-code   =   0
      355                     buf_wth-parts.sale-obj-type   =   '':U
      356                     buf_wth-parts.out-obj-code    =   0
      357                     buf_wth-parts.out-obj-type    =   '':U
      358                     buf_wth-parts.beg-dt          = ?
      359                     buf_wth-parts.end-dt          = ?
      360                     buf_wth-parts.price-rubl      = 0
      361                     buf_wth-parts.price-base      = 0
      362                     .
      363           when 'cli-zone':U then assign
      364                     buf_wth-parts.out-obj-code    =   0
      365                     buf_wth-parts.out-obj-type    =   '':U
      366                     buf_wth-parts.obj-code        = buf_wth-parts.cli-code
      367                     buf_wth-parts.obj-type        = buf_wth-parts.cli-type
      368                     buf_wth-parts.w-p-code        = 0
      369              .
      370         end case.
      371         find first b_wth-parts no-lock where
      372                    b_wth-parts.obj-type = buf_wth-parts.obj-type
      373                and b_wth-parts.obj-code = buf_wth-parts.obj-code
      374                and b_wth-parts.w-p-code = buf_wth-parts.w-p-code
      375                and b_wth-parts.wth-code = buf_wth-parts.wth-code
      376                and b_wth-parts.par-code = buf_wth-parts.par-code
      377                and b_wth-parts.in-code  = buf_wth-parts.in-code
      378                and b_wth-parts.out-code = buf_wth-parts.out-code
      379                and b_wth-parts.ser-code = buf_wth-parts.ser-code
      380                and b_wth-parts.db-num   = buf_wth-parts.db-num
      381                and b_wth-parts.stts   = buf_wth-parts.stts
      382                and b_wth-parts.fact-rangeTo = buf_wth-parts.fact-rangeFrom - 1
      383                 and b_wth-parts.doc-code = buf_wth-parts.doc-code
      384                                       no-error.
      385         if available b_wth-parts then do:
      386           find current b_wth-parts exclusive-lock.
      387           assign
      388           buf_wth-parts.fact-rangeFrom =  b_wth-parts.fact-rangeFrom
      389           buf_wth-parts.doc-rangeFrom =  b_wth-parts.doc-rangeFrom
      390           .
      391           delete b_wth-parts no-error.
      392           if error-status:error then undo, return error return-value.
      393         end.
      394         find first b_wth-parts exclusive-lock where
      395                    b_wth-parts.obj-type = buf_wth-parts.obj-type
      396                and b_wth-parts.obj-code = buf_wth-parts.obj-code
      397                and b_wth-parts.w-p-code = buf_wth-parts.w-p-code
      398                and b_wth-parts.wth-code = buf_wth-parts.wth-code
      399                and b_wth-parts.par-code = buf_wth-parts.par-code
      400                and b_wth-parts.in-code  = buf_wth-parts.in-code
      401                and b_wth-parts.out-code = buf_wth-parts.out-code
      402                and b_wth-parts.doc-code = buf_wth-parts.doc-code
      403                and b_wth-parts.ser-code = buf_wth-parts.ser-code
      404                and b_wth-parts.db-num   = buf_wth-parts.db-num
      405                and b_wth-parts.stts   = buf_wth-parts.stts
      406                and b_wth-parts.fact-rangeFrom = buf_wth-parts.fact-rangeTo + 1
      407                and b_wth-parts.fact-rangeTo >= buf_wth-parts.fact-rangeTo + 1
      408                no-error.
      409         if available b_wth-parts then do:
      410         assign
      411           buf_wth-parts.fact-rangeTo =  b_wth-parts.fact-rangeTo
      412           buf_wth-parts.doc-rangeTo =  b_wth-parts.doc-rangeTo
      413           .
      414           delete b_wth-parts no-error.
      415           if error-status:error then undo, return error return-value.
      416         end.
      417       assign
      418        buf_wth-parts.fact-qnty       =  buf_wth-parts.fact-rangeTo - buf_wth-parts.fact-RangeFrom + 1
      419        buf_wth-parts.qnty-doc        =  buf_wth-parts.doc-rangeTo  - buf_wth-parts.doc-RangeFrom  + 1
      420        .
      421       p-rec = RECID (buf_wth-parts).
      422   end.
      423   PROCEDURE err-mess:
      424     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      425     CASE p-silent:
      426       when yes then do:
      427         assign
      428         p-mess = substitute("Партия МЦ: Код серии &1-&2 Код МЦ &4 Диапазон &5 - &6&3&7"
      429                            , p-ser-code
      430                            , p-db-num
      431                            , chr(10)
      432                            , p-wth-code
      433                            , p-Fact-RangeFrom
      434                            , p-Fact-RangeTo
      435                            , p-mess)
      436         .
      437       end.
      438       when no then do:
      439         message
      440         p-mess
      441         view-as alert-box error .
      442       end.
      443     end.
      444   END PROCEDURE.
