        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter par-mode AS CHARACTER NO-UNDO.
        4   define input parameter parobj-type like ub.clients.obj-type no-undo.
        5   define input parameter parobj-code like ub.clients.obj-code no-undo.
        6   DEF VAR vss-revision    AS CHAR NO-UNDO INIT "$Revision: aea5316774be, 0, rls $":U.
        7   DEF VAR vss-author      AS CHAR NO-UNDO INIT "$Author: expertek $":U.
        8   DEF VAR vss-date        AS CHAR NO-UNDO INIT "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        9   DEF VAR vss-workfile    AS CHAR NO-UNDO INIT "$Workfile: chckwthr.p $":U.
       10   DEF VAR vss-archive     AS CHAR NO-UNDO INIT "$Archive: str/chckwthr.p $":U.
       11   DEF VAR vss-description AS CHAR NO-UNDO INIT "Запуск процедуры ргждения чека МЦ":U.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73     define variable v-cntxt-db-num        as integer   no-undo .
       74     define variable v-cntxt-userid        as character no-undo .
       75     define variable v-cntxt-level         as character no-undo .
       76     define variable v-cntxt-host-code-obj as integer   no-undo .
       77     define variable v-cntxt-obj-type      as character no-undo .
       78     define variable v-cntxt-obj-code      as integer   no-undo .
       79     define variable v-cntxt-db-num-obj    as integer   no-undo .
       80     define variable v-cntxt-is-admin      as logical   no-undo .
       81   define variable v-doc-rec as recid no-undo .
       82   define variable next-prev as character no-undo .
       83   define variable loc#log as logical no-undo .
       84   do
       85   on error undo, return error return-value
       86   :
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88     run mainmenu_getcntxt in parparentproc
       89       (output v-cntxt-db-num
       90       ,output v-cntxt-userid
       91       ,output v-cntxt-level
       92       ,output v-cntxt-host-code-obj
       93       ,output v-cntxt-obj-type
       94       ,output v-cntxt-obj-code
       95       ,output v-cntxt-db-num-obj
       96       ,output v-cntxt-is-admin
       97       ) .
       98     define variable v-chk-act-host-code as integer   no-undo .
       99   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      101     (input  parobj-type
      102     ,input  parobj-code
      103     ,output v-chk-act-host-code
      104     )  .
      105   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   do:
      107     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      108       (input  v-cntxt-db-num
      109       ,input  v-cntxt-userid
      110       ,input  0
      111       ,input  'actn_wth-receipt_input':U
      112       ,input  'object':U
      113       ,input  v-chk-act-host-code
      114       ,input  parobj-type
      115       ,input  parobj-code
      116       ,input  0
      117       ,input  0
      118       ,input  0
      119       ,input  true
      120       ,output loc#log
      121       )  .
      122   end.
      123     if loc#log <> true
      124     then do:
      125       return .
      126     end.
      127     run str/checkwth.w (
      128                     input parparentproc
      129                     ,input par-mode
      130                     ,input parobj-type
      131                     ,input parobj-code
      132                     ,input-output v-doc-rec
      133                     ,input ?
      134                     ,input-output next-prev
      135                     ) no-error.
      136     if error-status :error
      137     then do:
      138       return error.
      139     end.
      140   end.
