     1210   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1211   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     1212   def var vl_bin as char no-undo init "".
     1213   if vl_int < 0 OR vl_int = ? then return ?.
     1214   do while vl_int > 0:
     1215     assign
     1216     vl_bin = (if vl_int modulo 2 = 0
     1217                 then "0":U
     1218                 else "1":U) + vl_bin
     1219     vl_int = truncate(vl_int / 2,0).
     1220   end.
     1221   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     1222   END FUNCTION.
     1223   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     1224                                    input vl_binm as character):
     1225   DEFINE VARIABLE vl_bin as character no-undo.
     1226   DEFINE VARIABLE ii as integer no-undo.
     1227   DEFINE VARIABLE ii-len as integer no-undo.
     1228   DEFINE VARIABLE ii-lenm as integer no-undo.
     1229   DEFINE VARIABLE mchar as character no-undo.
     1230   DEFINE VARIABLE ichar as character no-undo.
     1231   if vl_binm = ? then return ?.
     1232   vl_bin = CIntBinS(vl_int).
     1233   if vl_bin = ? then return ?.
     1234   assign
     1235   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     1236   ii-lenm = LENGTH(vl_binm)
     1237   ii-len = LENGTH(vl_bin) - ii-lenm
     1238   .
     1239   if II-LENM > 32 THEN RETURN ?.
     1240   DO II = 1 to II-LENm:
     1241     assign
     1242     mchar = SUBSTR(vl_binm, ii, 1)
     1243     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     1244     .
     1245     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     1246     IF ichar <> mchar AND mchar <> "X":U then return no.
     1247   END.
     1248   return yes.
     1249   END FUNCTION.
