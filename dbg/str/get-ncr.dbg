     2200             current-cas-shift-name = buf_shift-cash.shift-name
     2201             current-cas-shift-date = buf_shift-cash.shift-date
     2202             .
     2203           end.
     2204           else do:
     2205             current-pay-desk = -1.
     2206           end.
     2207         end.
     2208       end.
     2209     end.
     2210   end procedure.
