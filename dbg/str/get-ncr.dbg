     2258   procedure proc-gds-discnt :
     2259   DEFINE VARIABLE var-discnt as decimal no-undo .
     2260   DEFINE VARIABLE var-discnt-type as integer no-undo .
     2261   DEFINE VARIABLE var-gds-for-discnt as decimal no-undo .
     2262     do
     2263     on error undo, return error
     2264     :
     2265       if exist or not is-in-check or was-deleted then return.
     2266       assign
     2267       t-c-d =  - dec(substr(n-entry[11], 9, 10 )) / 100
     2268       no-error
     2269       .
     2270       if error-status:error or trim( substr(n-entry[10], 1, 16  )) <> bc-buf then do:
     2271         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2272       end.
     2273       assign
     2274       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2275                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2276                     int( substr(n-entry[4], 5, 2) )
     2277       var-gds-for-discnt = (ub.chk-gds.src-price - ub.chk-gds.src-discnt) * ub.chk-gds.src-qnty
     2278       .
     2279       assign
     2280       ub.chk-gds.src-discnt = ub.chk-gds.src-discnt + t-c-d / ub.chk-gds.src-qnty
     2281       netto-for-sub-d = netto-for-sub-d - t-c-d
     2282       .
     2283       case code3:
     2284         when "0":U then do:
     2285           case code2:
     2286             when "0":U then do:
     2287               assign
     2288               var-discnt-type = integer('7':U)
     2289               .
     2290             end.
     2291             when "1":U then do:
     2292               assign
     2293               var-discnt-type = integer('2':U)
     2294               .
     2295             end.
     2296             when "2":U then do:
     2297               assign
     2298               var-discnt-type = integer('5':U)
     2299               .
     2300             end.
     2301             when "3":U then do:
     2302               assign
     2303               var-discnt-type = integer('0':U)
     2304               .
     2305             end.
     2306             when "7":U then do:
     2307               assign
     2308               var-discnt-type = integer('6':U)
     2309               .
     2310             end.
     2311             when "8":U then do:
     2312               assign
     2313               var-discnt-type = integer('1':U)
     2314               .
     2315             end.
     2316           END CASE.
     2317         end.
     2318         when "1":U then do:
     2319           assign
     2320           var-discnt-type = integer('8':U)
     2321           .
     2322         end.
     2323         when "2":U then do:
     2324           assign
     2325           var-discnt-type = integer('8':U)
     2326           .
     2327         end.
     2328         when "3":U then do:
     2329           assign
     2330           var-discnt-type = integer('10':U)
     2331           .
     2332         end.
     2333         when "5":U then do:
     2334           assign
     2335           var-discnt-type = integer('4':U)
     2336           .
     2337         end.
     2338         when "6":U then do:
     2339           assign
     2340           var-discnt-type = integer('2':U)
     2341           .
     2342         end.
     2343         when "7":U then do:
     2344           assign
     2345           var-discnt-type = integer('9':U)
     2346           .
     2347         end.
     2348         when "8":U then do:
     2349           assign
     2350           var-discnt-type = integer('999':U)
     2351           .
     2352         end.
     2353       END CASE.
     2354       create ub.chk-discnt.
     2355       assign
     2356       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2357       ub.chk-discnt.record-type = 0
     2358       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2359       ub.chk-discnt.line-num = ub.chk-gds.line-num
     2360       ub.chk-discnt.time-oper = time-oper_
     2361       ub.chk-discnt.line-type = integer('1':U)
     2362       ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (t-c-d > 0 )
     2363       ub.chk-discnt.pass-discnt = integer('0':U)
     2364       ub.chk-discnt.value-type = if code2 = "3":U
     2365                               then integer('1':U)
     2366                               else (if code2 = "2":U then
     2367                                     integer('2':U)
     2368                                     else integer('0':U)
     2369                                     )
     2370       ub.chk-discnt.discnt-type = var-discnt-type
     2371       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2372       ub.chk-discnt.discnt-value-abs = t-c-d
     2373       ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2374       ub.chk-discnt.object-sum = var-gds-for-discnt
     2375       ub.chk-discnt.discnt-value-pcnt = if var-gds-for-discnt <> 0
     2376                                      then t-c-d / var-gds-for-discnt * 100
     2377                                      else 0
     2378       ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2379       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2380       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2381       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2382       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2383       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2384       var-discnt-id = var-discnt-id + 1
     2385       .
     2386     end.
     2387   end procedure.
     2388   procedure proc-gds-discnt-as-r :
     2389   DEFINE VARIABLE var-discnt as decimal no-undo .
     2390   DEFINE VARIABLE var-discnt-type as integer no-undo .
     2391   DEFINE VARIABLE var-gds-for-discnt as decimal no-undo .
     2392   DEFINE VARIABLE codechr as character no-undo .
     2393   DEFINE VARIABLE curr-string-qnty1 as decimal no-undo .
     2394   DEFINE VARIABLE curr-string-qnty2 as decimal no-undo .
     2395   DEFINE VARIABLE curr-string-qntys as decimal no-undo .
     2396   define variable discnt-sign as character no-undo .
     2397   define variable v-discnt-value-abs as decimal no-undo .
     2398   define variable v-discnt-value-pcnt as decimal no-undo .
     2399     do
     2400     on error undo, return error
     2401     :
     2402       if exist or not is-in-check or was-deleted then return.
     2403       assign
     2404       discnt-sign = substr(n-entry[10], 26, 1 )
     2405       t-c-d = (if discnt-sign = '<'
     2406                or discnt-sign = '-'
     2407                then 1
     2408                else ( - 1)
     2409                ) *
     2410                dec(substr(n-entry[10], 27, 9 )) / 100
     2411       codechr = substr(n-entry[10], 22, 1)
     2412       curr-string-qntys = int(substr(n-entry[10], 17, 1 ) + "1":U)
     2413       curr-string-qnty1 = int(substr(n-entry[10], 18, 4 ))
     2414       curr-string-qnty2 = int(substr(n-entry[10], 23, 3 ))
     2415       curr-string-qnty = if codechr = ".":U
     2416                           then
     2417                           (curr-string-qnty1 + curr-string-qnty2 / 1000 )
     2418                           else
     2419                           (curr-string-qnty1 * (int(codechr) * 100 + curr-string-qnty2 / 10 ))
     2420       curr-string-qnty = curr-string-qntys * curr-string-qnty
     2421       no-error
     2422       .
     2423       if error-status:error or trim( substr(n-entry[10], 1, 16  )) <> bc-buf then do:
     2424         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2425       end.
     2426       assign
     2427       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2428                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2429                     int( substr(n-entry[4], 5, 2) )
     2430       var-gds-for-discnt = (ub.chk-gds.src-price - ub.chk-gds.src-discnt) * ub.chk-gds.src-qnty
     2431       .
     2432       case code2:
     2433         when '0'
     2434         or
     2435         when '1' then do:
     2436           assign
     2437           ub.chk-gds.src-discnt = ub.chk-gds.src-discnt + t-c-d
     2438           netto-for-sub-d = netto-for-sub-d - t-c-d * curr-string-qnty
     2439           v-discnt-value-abs = t-c-d * curr-string-qnty
     2440           v-discnt-value-pcnt =  if var-gds-for-discnt <> 0
     2441                                  then v-discnt-value-abs / var-gds-for-discnt * 100
     2442                                  else 0
     2443           .
     2444         end.
     2445         otherwise do:
     2446           assign
     2447           ub.chk-gds.src-discnt = ub.chk-gds.src-discnt + t-c-d / ub.chk-gds.src-qnty
     2448           netto-for-sub-d = netto-for-sub-d - t-c-d
     2449           v-discnt-value-abs = t-c-d
     2450           v-discnt-value-pcnt =  if var-gds-for-discnt <> 0
     2451                                 then t-c-d / var-gds-for-discnt * 100
     2452                                 else 0
     2453           .
     2454         end.
     2455       END CASE.
     2456       CASE code2:
     2457         when '0':U then dO:
     2458           CASE code3:
     2459             when '1':U then do:
     2460               assign
     2461               var-discnt-type = integer('8':U)
     2462               .
     2463             end.
     2464             when '2':U then do:
     2465               assign
     2466               var-discnt-type = integer('999':U)
     2467               .
     2468             end.
     2469             when '3':U then do:
     2470               assign
     2471               var-discnt-type = integer('10':U)
     2472               .
     2473             end.
     2474             when '5':U then do:
     2475               assign
     2476               var-discnt-type = integer('4':U)
     2477               .
     2478             end.
     2479             when '6':U then do:
     2480               assign
     2481               var-discnt-type = integer('2':U)
     2482               .
     2483             end.
     2484             when '7':U then do:
     2485               assign
     2486               var-discnt-type = integer('9':U)
     2487               .
     2488             end.
     2489             when '8':U then do:
     2490               assign
     2491               var-discnt-type = integer('999':U)
     2492               .
     2493             end.
     2494           END CASE.
     2495         end.
     2496         when '7':U then do:
     2497           assign
     2498           var-discnt-type = integer('6':U)
     2499           .
     2500         end.
     2501         when '8':U then do:
     2502           assign
     2503           var-discnt-type = integer('1':U)
     2504           .
     2505         end.
     2506         when '1':U then do:
     2507           assign
     2508           var-discnt-type = integer('999':U)
     2509           .
     2510         end.
     2511         when '2':U then do:
     2512           assign
     2513           var-discnt-type = integer('5':U)
     2514           .
     2515         end.
     2516         when '3':U then do:
     2517           assign
     2518           var-discnt-type = integer('2':U)
     2519           .
     2520         end.
     2521         when '4':U then do:
     2522           assign
     2523           var-discnt-type = integer('999':U)
     2524           .
     2525         end.
     2526         when '5':U then do:
     2527           assign
     2528           var-discnt-type = integer('10':U)
     2529           .
     2530         end.
     2531       END CASE.
     2532       create ub.chk-discnt.
     2533       assign
     2534       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2535       ub.chk-discnt.record-type = 0
     2536       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2537       ub.chk-discnt.line-num = ub.chk-gds.line-num
     2538       ub.chk-discnt.time-oper = time-oper_
     2539       ub.chk-discnt.line-type = integer('1':U)
     2540       ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (t-c-d > 0 )
     2541       ub.chk-discnt.pass-discnt = integer('0':U)
     2542       ub.chk-discnt.value-type = if code2 = "3":U
     2543                               then integer('1':U)
     2544                               else (if code2 = "2":U then
     2545                                     integer('2':U)
     2546                                     else integer('0':U)
     2547                                     )
     2548       ub.chk-discnt.discnt-type = var-discnt-type
     2549       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2550       ub.chk-discnt.discnt-value-abs = v-discnt-value-abs
     2551       ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2552       ub.chk-discnt.object-sum = var-gds-for-discnt
     2553       ub.chk-discnt.discnt-value-pcnt = v-discnt-value-pcnt
     2554       ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2555       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2556       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2557       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2558       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2559       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2560       var-discnt-id = var-discnt-id + 1
     2561       .
     2562     end.
     2563   end procedure.
     2564   procedure proc-set-salesman :
     2565     do
