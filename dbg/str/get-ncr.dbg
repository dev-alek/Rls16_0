     1275   FUNCTION convert-discount returns integer
     1276                                             ( input p-disc-reason as integer
     1277                                             , input p-disc-type  as integer
     1278                                             , input p-line-type as integer) :
     1279   define variable v-disc-type as integer no-undo .
     1280   if p-line-type = integer('1':U)
     1281   or p-line-type = integer('0':U)
     1282   then do:
     1283     if p-disc-type = 0
     1284     or p-disc-type = 1
     1285     or p-disc-type = 2
     1286     then do:
     1287       if p-disc-reason <> 0 then
     1288       p-disc-type = p-disc-reason
     1289       .
     1290     end.
     1291   end.
     1292   if p-line-type = integer('3':U)
     1293   or p-line-type = integer('2':U) then do:
     1294     if p-disc-type = 101
     1295     or p-disc-type = 102
     1296     then do:
     1297       if p-disc-reason <> 0 then
     1298       p-disc-type = p-disc-reason
     1299       .
     1300     end.
     1301   end.
     1302   if p-disc-reason <> 0 then do:
     1303     CASE p-disc-reason:
     1304       when 0 then do:
     1305         return integer('0':U).
     1306       end.
     1307       when 1 then do:
     1308         return integer('11':U).
     1309       end.
     1310       when 2 then do:
     1311         return integer('1':U).
     1312       end.
     1313       when 3 or when 15 then do:
     1314         return integer('7':U).
     1315       end.
     1316       when 4 then do:
     1317         return integer('4':U).
     1318       end.
     1319       when 5 then do:
     1320         return integer('12':U).
     1321       end.
     1322       when 6 then do:
     1323         return integer('3':U).
     1324       end.
     1325       when 7 then do:
     1326         return integer('13':U).
     1327       end.
     1328       when 8
     1329       or
     1330       when 9
     1331       or
     1332       when 10
     1333       then do:
     1334         return integer('20':U).
     1335       end.
     1336       when 11
     1337       then do:
     1338         return integer('21':U).
     1339       end.
     1340       when 13
     1341       then do:
     1342         return integer('22':U).
     1343       end.
     1344       when 16 then do:
     1345         return integer('23':U).
     1346       end.
     1347     END CASE.
     1348   end.
     1349   CASE p-disc-type:
     1350     when 0 then do:
     1351       return integer('0':U).
     1352     end.
     1353     when 1 then do:
     1354       return integer('13':U).
     1355     end.
     1356     when 2 then do:
     1357       return integer('2':U).
     1358     end.
     1359     when 3 then do:
     1360       return integer('4':U).
     1361     end.
     1362     when 4 then do:
     1363       return integer('12':U).
     1364     end.
     1365     when 5 then do:
     1366       return integer('1':U).
     1367     end.
     1368     when 6 then do:
     1369       return integer('3':U).
     1370     end.
     1371     when 7 then do:
     1372       return integer('14':U).
     1373     end.
     1374     when 8 then do:
     1375       return integer('15':U).
     1376     end.
     1377     when 9 then do:
     1378       return integer('16':U).
     1379     end.
     1380     when 101 then do:
     1381       return integer('13':U).
     1382     end.
     1383     when 102 then do:
     1384       return integer('5':U).
     1385     end.
     1386     when 103 then do:
     1387       return integer('1':U).
     1388     end.
     1389     when 104 then do:
     1390       return integer('5':U).
     1391     end.
     1392     when 105 then do:
     1393       return integer('1':U).
     1394     end.
     1395     when 106 then do:
     1396       return integer('1':U).
     1397     end.
     1398   END CASE.
     1399   END FUNCTION.
     1400   run get-general-parameters in this-procedure .
     1401   procedure get-general-parameters :
     1402   define buffer buf_get-chkc_context for get-chkc_context.
     1403   do
     1404   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1405   :
     1406     for each buf_get-chkc_context:
     1407       delete buf_get-chkc_context.
     1408     end.
     1409     create buf_get-chkc_context.
     1410   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     1412     (input  p-obj-type
     1413     ,input  p-obj-code
     1414     ,input  buffer buf_get-chkc_context:handle
     1415     ) no-error .
     1416     if error-status:error then do:
     1417       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     1418                                      , chr(10)
     1419                                      , error-status:get-message(1)
     1420                                      , return-value ).
     1421     end.
     1422     find first buf_get-chkc_context.
     1423     assign
     1424     buf_get-chkc_context.parparentproc = parparentproc
     1425     buf_get-chkc_context.p-log-handle = p-log-handle
     1426     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     1427     .
     1428     release buf_get-chkc_context.
     1429     find first get-chkc_context.
     1430   end.
     1431   end procedure.
     1432   get-chkc_context.pos-type = p-pos-type.
     1433   RUN get-ncr-c in this-procedure (file_) no-error .
     1434   if error-status:error then return no-apply.
     1435   PROCEDURE get-ncr-c.
     1436   def input parameter filename as char no-undo.
     1437   run get-ncr-parameters in this-procedure no-error.
     1438   if error-status:error then return error.
     1439   run gbl/filename.p (
     1440                   input filename
     1441                  ,output v-full-path
     1442                  ,output v-path
     1443                  ,output v-file-name
     1444                  ,output v-file-name-no-ext
     1445                  ,output v-file-name-ext
     1446                  ) no-error .
     1447   if error-status:error then return error.
     1448   error-status:error = FALSE.
     1449   input stream ChkStream from value( filename ).
     1450   _repeat:
     1451   REPEAT :
     1452   _line:
     1453   DO TRANSACTION:
     1454     import stream ChkStream unformatted ss.
     1455     assign
     1456     var-file-line-num = var-file-line-num + 1
     1457     .
     1458     if ss = "" or ss = ? then do:
     1459       n-entry[1] = "".
     1460       leave _line.
     1461     end.
     1462     DO ii = 1 to num-entries(ss, chr(58)):
     1463       assign
     1464       n-entry[ii] = entry(ii, ss, chr(58))
     1465       .
     1466     END.
     1467     DO ii = (num-entries(ss, chr(58)) + 1) to 25:
     1468         assign
     1469         n-entry[ii] = "".
     1470     END.
     1471     assign
     1472     ii = num-entries(ss, chr(58))    .
     1473     if trim(n-entry[8]) <> "":u  then do:
     1474       assign
     1475       code1 = substr(n-entry[8], 1, 1)
     1476       code2 = substr(n-entry[8], 2, 1)
     1477       code3 = substr(n-entry[8], 3, 1)
     1478       .
     1479     end.
     1480     else do:
     1481       assign
     1482       code1 = "":U
     1483       code2 = "":U
     1484       code3 = "":U
     1485       .
     1486     end.
     1487   END.
     1488   DO TRANSACTION :
     1489     CASE n-entry[7]:
     1490       when 'F':U then do:
     1491         if code1 = gbl-type and action-code = substr(n-entry[11], 1, 2) then do:
     1492           assign
     1493           gbl-type = "":U
     1494           action-code = "":U
     1495           is-in-check = no
     1496           .
     1497           run proc-end in this-procedure (if ub.chk-doc.chk-type = integer('11':U)
     1498                                           then string(0)
     1499                                           else string ( dec(substr(n-entry[11], 9, 10)) - v-disc-round) ) no-error .
     1500         end.
     1501         else do:
     1502           assign
     1503           gbl-type = "":U
     1504           action-code = "":U
     1505           is-in-check = no
     1506           .
     1507           release ub.chk-doc no-error .
     1508           release ub.chk-gds no-error .
     1509           release ub.chk-pay no-error .
     1510           release ub.chk-discnt no-error .
     1511           if avail ub.chk-doc then do:
     1512             ub.chk-doc.correct = no.
     1513           end.
     1514           release ub.chk-pay  no-error .
     1515         end.
     1516       end.
     1517       when 'H':U then  do:
     1518         run proc-start in this-procedure no-error .
     1519       end.
     1520       when "T":U then do:
     1521         CASE gbl-type:
     1522           when "1":U then do:
     1523             run proc-tender in this-procedure(input 0, input NOT (not exist and is-in-check) ) no-error .
     1524           end.
     1525           when "0":U then do:
     1526             run proc-tender in this-procedure(input 1, input Not (not mc-exist and is-in-check) ) no-error .
     1527           end.
     1528           otherwise do:
     1529           end.
     1530         END CASE.
     1531       end.
     1532       when "S":U then  do:
     1533         run proc-sale in this-procedure no-error .
     1534       end.
     1535       when "D":U then do:
     1536         if trim(n-entry[8]) = "120" then do :
     1537           v-disc-round = dec( substr(n-entry[11], 9 , 10 )).
     1538         end.
     1539         else do :
     1540           run proc-cash-discount in this-procedure no-error .
     1541         end.
     1542       end.
     1543       when "I":U then do:
     1544         run proc-inv in this-procedure .
     1545       end.
     1546       when "C":U then do:
     1547         if available ub.chk-gds then do:
     1548           case p-pos-type:
     1549             when 'NCR-GM':U then do:
     1550               run proc-gds-discnt in this-procedure no-error .
     1551             end.
     1552             when 'NCR-AS@R':U then do:
     1553               run proc-gds-discnt-as-r in this-procedure no-error .
     1554             end.
     1555           end case.
     1556         end.
     1557       end.
     1558       when "P":U then do:
     1559         run proc-set-salesman in this-procedure no-error .
     1560       end.
     1561       when "W":U then do:
     1562         if p-pos-type = 'NCR-AS@R':U
     1563         and v-version-dec >= 2.6 then do:
     1564         end.
     1565         else do:
     1566           run proc-without-discount in this-procedure no-error .
     1567         end.
     1568       end.
     1569       when "A":U or
     1570       when "B":U or
     1571       when "G":U or
     1572       when "L":U or
     1573       when "M":U or
     1574       when "N":U or
     1575       when "V":U or
     1576       when "O":U or
     1577       when "X":U or
     1578       when "U":U or
     1579       when "R":U or
     1580       when "Q":U or
     1581       when "J":U or
     1582       when "K":U
     1583       then do:
     1584       end.
     1585       otherwise do:
     1586         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1587       end.
     1588       END CASE .
     1589     END.
     1590   END .
     1591   assign
     1592   error-status:error = false.
     1593   input stream ChkStream close.
     1594   END PROCEDURE.
     1595   PROCEDURE get-ncr-parameters:
     1596   define variable v-index as integer no-undo .
     1597   if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     1598     run write-log-and-file in p-log-handle (
     1599           input 1
     1600         , input log-file-name
     1601         , input 1
     1602         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен, а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо."
     1603                            , get-chkc_context.obj-type
     1604                            , get-chkc_context.obj-code
     1605                             )).
     1606     assign
     1607     p-view-log = yes
     1608     .
     1609     undo, return .
     1610   end.
     1611   if get-chkc_context.t-shft > 0 and get-chkc_context.shift-on = yes then do:
     1612     run write-log-and-file in p-log-handle (
     1613           input 1
     1614         , input log-file-name
     1615         , input 1
     1616         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен,&3" +
     1617                             "а настройка СМЕЩЕННЫЕ СМЕНЫ НА КАССЕ&3" +
     1618                             "(АРМ Администратор - Справочники - Магазины - Параметры - время начала пересменки)&3" +
     1619                             "включена - это недопустимо."
     1620                            , get-chkc_context.obj-type
     1621                            , get-chkc_context.obj-code
     1622                            , chr(10)
     1623                             )).
     1624     assign
     1625     p-view-log = yes
     1626     .
     1627     undo, return .
     1628   end.
     1629   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1630     (input  'is-cdinv'
     1631     ,input  0
     1632     ,input  '':U
     1633     ,input  0
     1634     ,input  '':U
     1635     ,input  '':U
     1636     ,input  '':U
     1637     ,input  NO
     1638     ,output is-cdinv
     1639     ,output par-type
     1640     ) NO-ERROR .
     1641   if is-wth = yes then do:
     1642     accept-types =  "0,1":U.
     1643   end.
     1644   else do:
     1645     accept-types =  "1":U.
     1646   end.
     1647   if logical(is-cdinv) then accept-types = accept-types + ",5":U.
     1648   if annu-check then
     1649   accept-types = accept-types + ",2":U.
     1650   assign
     1651   v-version-dec = decimal(p-version)
     1652   no-error .
     1653   END PROCEDURE.
     1654   procedure proc-start :
     1655     do
     1656     on error undo, return error
     1657     :
     1658       assign
     1659       gbl-type = code1
     1660       action-code = substr(n-entry[11], 1, 2)
     1661       no-error
     1662       .
     1663       if can-do(accept-types,  gbl-type ) then do:
     1664         assign
     1665         sales-man_ = 0
     1666         v-flag-salesman  = no
     1667         chk-date_  =   date(
     1668                                       int( substr( n-ENTRY[3], 3, 2 ) ),
     1669                                       int( substr( n-ENTRY[3], 5, 2 ) ),
     1670                                       int( substr( n-ENTRY[3], 1, 2 )) + 2000
     1671                                       )
     1672         chk-time_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 + int( substr( n-entry[4], 3, 2 ) ) * 60  +
     1673                       int( substr(n-entry[4], 5, 2) )
     1674         shift-date_ = chk-date_
     1675         shift-num_ = 0
     1676         shift-name_ = '':U
     1677         shop-code = ( if get-chkc_context.hnum
     1678                       then int( trim(  n-entry[1] ) )
     1679                       else p-obj-code )
     1680         shop-type = ( if get-chkc_context.hnum then 'маг':U else p-obj-type )
     1681         chk-num_ = int( trim( n-entry[5] ) )
     1682         pay-desk_ = int( trim( n-entry[2] ) )
     1683         cashier_ = int( trim( n-entry[9] ) )
     1684         chk-type_ = (if gbl-type = "2"
     1685                     then  integer('8':U)
     1686                     else (if gbl-type = "5"
     1687                           then integer('11':U)
     1688                           else (
     1689                                 if code2 = "0":U
     1690                                 then integer('1':U)
     1691                                 else (if code2 = "5":U or code2 = "6":U
     1692                                       then integer('6':U)
     1693                                       else 0)
     1694                                )
     1695                          )
     1696                   )
     1697         d-card_ = (if gbl-type = "5" then "" else trim( n-entry[10]))
     1698         no-error
     1699         .
     1700         if error-status:error then do:
     1701           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1702         end.
     1703       end.
     1704       else do:
     1705         assign
     1706         exist = yes
     1707         gbl-type = "":U
     1708         .
     1709       end.
     1710       if is-wth and lookup(gbl-type, "0,6,7,9":U) > 0 then do:
     1711         assign
     1712         mc-for-chk-type = ""
     1713         mc-exist = yes
     1714         wth-type = 0
     1715         .
     1716         CASE action-code:
     1717           when "10":U or
     1718           when "15":U then do:
     1719             wth-type = 3.
     1720           end.
     1721           when "11":U then do:
     1722             wth-type = 2.
     1723           end.
     1724           when "06":U then do:
     1725             wth-type = 5.
     1726           end.
     1727           when "09":U then do:
     1728             wth-type = 7.
     1729           end.
     1730           when "14":U then do:
     1731             wth-type = 4.
     1732           end.
     1733           when "12":U then do:
     1734             wth-type = 4.
     1735           end.
     1736           when "13":U then do:
     1737             wth-type = 4.
     1738           end.
     1739           when "40":U then do:
     1740             wth-type = 4.
     1741           end.
     1742           when "50":U then do:
     1743             wth-type = 4.
     1744           end.
     1745         END CASE.
     1746         FIND  ub.chk-doc where
     1747               ub.chk-doc.obj-type = shop-type and
     1748               ub.chk-doc.obj-code = shop-code and
     1749               ub.chk-doc.chk-date = chk-date_ and
     1750               ub.chk-doc.pay-desk = pay-desk_ and
     1751               ub.chk-doc.chk-time = chk-time_ and
     1752               ub.chk-doc.chk-num  = chk-num_  and
     1753               ub.chk-doc.sales-man = sales-man_
     1754               NO-ERROR NO-WAIT.
     1755         IF NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc then do:
     1756           assign
     1757           mc-exist = no
     1758           cr = 0
     1759           lll = lll + 1 .
     1760           CREATE ub.chk-doc.
     1761           assign
     1762           ub.chk-doc.office = ?
     1763           ub.chk-doc.chk-type = 0
     1764           is-in-check = yes
     1765           lng = 0
     1766           lnp = 0
     1767           ub.chk-doc.obj-code = shop-code
     1768           ub.chk-doc.obj-type = shop-type
     1769           ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     1770                                 then string(next-value(s-chk, ub ))
     1771                                 else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     1772           ub.chk-doc.chk-num = chk-num_
     1773           ub.chk-doc.chk-date = chk-date_
     1774           ub.chk-doc.chk-time = chk-time_
     1775           ub.chk-doc.sales-man = sales-man_
     1776           ub.chk-doc.pay-desk = pay-desk_
     1777           ub.chk-doc.cashier = cashier_
     1778           ub.chk-doc.discnt = 0
     1779           ub.chk-doc.shift-date = shift-date_
     1780           ub.chk-doc.src-shift-date = shift-date_
     1781           ub.chk-doc.shift-num = shift-num_
     1782           ub.chk-doc.shift-name = shift-name_
     1783           ub.chk-doc.src-shift-name = shift-name_
     1784           ub.chk-doc.z-number = 0
     1785           ub.chk-doc.chk-type = wth-type
     1786           ub.chk-doc.cash-rate = 1
     1787           ub.chk-doc.cash-scale = 1
     1788           ub.chk-doc.tot-doc = 0
     1789           ub.chk-doc.netto = 0
     1790           ub.chk-doc.discnt = 0
     1791           ub.chk-doc.d-pcnt = 0
     1792           ub.chk-doc.src-d-pcnt = 0
     1793           ub.chk-doc.doc-qnty = 0
     1794           ub.chk-doc.src-tot-doc = 0
     1795           ub.chk-doc.src-d-mask = ''
     1796           ub.chk-doc.d-mask = ''
     1797           ub.chk-doc.d-card = ''
     1798           ub.chk-doc.src-d-card = ''
     1799           ub.chk-doc.src-cli-type = ?
     1800           ub.chk-doc.src-cli-code = ?
     1801           ub.chk-doc.cli-type = ?
     1802           ub.chk-doc.cli-code = ?
     1803           ub.chk-doc.doc-num2 = ?
     1804           ub.chk-doc.out-2-code = ?
     1805           no-error
     1806           .
     1807           if error-status:error then
     1808           ub.chk-doc.correct = no.
     1809           assign
     1810           naz-rate = 1
     1811           no-error.
     1812           mc-prev-code = ub.chk-doc.doc-code.
     1813         end.
     1814         else
     1815         mc-curr-chk-type = 0 .
     1816       end.
     1817       if lookup( gbl-type, "1":U ) > 0
     1818       or (logical(is-cdinv)
     1819       and  LOOKUP(gbl-type,  "5":U ) > 0)
     1820       then do:
     1821         assign
     1822         for-chk-type = ""
     1823         tot-d-pcnt = 0
     1824         exist = yes
     1825         .
     1826         FIND  ub.chk-doc where
     1827               ub.chk-doc.obj-type = shop-type and
     1828               ub.chk-doc.obj-code = shop-code and
     1829               ub.chk-doc.chk-date = chk-date_ and
     1830               ub.chk-doc.pay-desk = pay-desk_ and
     1831               ub.chk-doc.chk-time = chk-time_ and
     1832               ub.chk-doc.chk-num = chk-num_   and
     1833               ub.chk-doc.sales-man = sales-man_
     1834               NO-ERROR NO-WAIT.
     1835         IF NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc then do:
     1836           assign
     1837           exist = no
     1838           cr = 0
     1839           lll = lll + 1 .
     1840           CREATE ub.chk-doc.
     1841           assign
     1842           ub.chk-doc.office = ?
     1843           is-in-check = yes
     1844           var-returns = "":U
     1845           lng = 0
     1846           lnp = 0
     1847           sub-d = 0
     1848           netto-for-sub-d = 0
     1849           var-discnt-id = 0
     1850           ub.chk-doc.obj-code = shop-code
     1851           ub.chk-doc.obj-type = shop-type
     1852           ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     1853                                             then string(next-value(s-chk, ub ))
     1854                                             else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     1855           ub.chk-doc.chk-num = chk-num_
     1856           ub.chk-doc.chk-date = chk-date_
     1857           ub.chk-doc.chk-time = chk-time_
     1858           ub.chk-doc.sales-man = sales-man_
     1859           ub.chk-doc.pay-desk = pay-desk_
     1860           ub.chk-doc.cashier = cashier_
     1861           ub.chk-doc.discnt = 0
     1862           ub.chk-doc.src-d-card = (if ub.chk-doc.chk-type = integer('11':U) then '':U else d-card_)
     1863           ub.chk-doc.shift-date = shift-date_
     1864           ub.chk-doc.src-shift-date = shift-date_
     1865           ub.chk-doc.shift-num = shift-num_
     1866           ub.chk-doc.shift-name = shift-name_
     1867           ub.chk-doc.src-shift-name = shift-name_
     1868           ub.chk-doc.cash-rate =  1
     1869           ub.chk-doc.cash-scale = 1
     1870           ub.chk-doc.z-number = 0
     1871           ub.chk-doc.chk-type = chk-type_
     1872           ub.chk-doc.correct = yes
     1873           ub.chk-doc.src-d-pcnt = 0
     1874           .
     1875           prev-code = ub.chk-doc.doc-code.
     1876         end.
     1877       end.
     1878     end.
     1879   end procedure.
     1880   procedure proc-sale :
     1881   DEFINE VARIABLE codechr as character no-undo .
     1882   DEFINE VARIABLE curr-string-qnty1 as decimal no-undo .
     1883   DEFINE VARIABLE curr-string-qnty2 as decimal no-undo .
     1884   DEFINE VARIABLE curr-string-qntys as decimal no-undo .
     1885   define variable v-found as logical no-undo .
     1886   define buffer del_chk-gds for ub.chk-gds.
     1887   define buffer del_chk-discnt for ub.chk-discnt.
     1888     do
     1889     on error undo, return error
     1890     :
     1891       if exist or not is-in-check then return.
     1892       assign
     1893       was-deleted = no
     1894       codechr = substr(n-entry[10], 22, 1)
     1895       curr-string-qntys = int(substr(n-entry[10], 17, 1 ) + "1":U)
     1896       curr-string-qnty1 = int(substr(n-entry[10], 18, 4 ))
     1897       curr-string-qnty2 = int(substr(n-entry[10], 23, 3 ))
     1898       curr-string-qnty = if codechr = ".":U
     1899                           then
     1900                           (curr-string-qnty1 + curr-string-qnty2 / 1000 )
     1901                           else
     1902                           (curr-string-qnty1 * (int(codechr) * 100 + curr-string-qnty2 / 10 ))
     1903       curr-string-qnty = curr-string-qntys * curr-string-qnty
     1904       bc-buf = trim( substr(n-entry[10], 1, 16  ))
     1905       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     1906                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     1907                     int( substr(n-entry[4], 5, 2) )
     1908       pass-gds_ = (if code3 = "0":U or code3 = "8"
     1909                   then 1
     1910                   else 0
     1911                   )
     1912       no-error
     1913       .
     1914       CASE p-pos-type:
     1915         when 'NCR-GM':U then do:
     1916           assign
     1917           sum-from-check = dec(substr( n-entry[10], 26, 10 )) / 100
     1918           price-from-check = abs(sum-from-check / curr-string-qnty)
     1919           .
     1920         end.
     1921         when 'NCR-AS@R':U then do:
     1922           assign
     1923           price-from-check = dec(substr( n-entry[10], 26, 10 )) / 100
     1924           sum-from-check = price-from-check * curr-string-qnty
     1925           .
     1926         end.
     1927       END CASE.
     1928       if error-status:error then do:
     1929         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1930       end.
     1931       if code2 = "7":U then do:
     1932         _del_chk-gds:
     1933         for each del_chk-gds where
     1934                  del_chk-gds.doc-code = ub.chk-doc.doc-code:
     1935           if del_chk-gds.src-code = bc-buf and
     1936              del_chk-gds.src-qnty =  - curr-string-qnty and
     1937             del_chk-gds.src-sum = - sum-from-check and
     1938             lookup(string(del_chk-gds.line-num), var-returns) = 0
     1939             then do:
     1940             create ub.chk-gds.
     1941             buffer-copy del_chk-gds except line-num to ub.chk-gds
     1942             assign
     1943             lng = lng + 1
     1944             ub.chk-gds.src-qnty = - del_chk-gds.src-qnty
     1945             ub.chk-gds.src-sum = - del_chk-gds.src-sum
     1946             ub.chk-gds.line-num = lng
     1947             ub.chk-gds.line-sign = not del_chk-gds.line-sign
     1948             was-deleted = yes
     1949             var-returns = var-returns + chr(44) + string(del_chk-gds.line-num)
     1950             .
     1951             define variable v-wd-sum as decimal no-undo .
     1952             for each tt-wd where
     1953                     tt-wd.line-num = del_chk-gds.line-num:
     1954               assign
     1955               v-wd-sum = v-wd-sum + tt-wd.wd-sum .
     1956             end.
     1957             netto-for-sub-d = netto-for-sub-d + ub.chk-gds.src-sum - ub.chk-gds.src-discnt * ub.chk-gds.src-qnty + v-wd-sum.
     1958             for each del_chk-discnt No-LOCK WHERE
     1959                      del_chk-discnt.doc-code = ub.chk-doc.doc-code AND
     1960                      del_chk-discnt.line-num = del_chk-gds.line-num AND
     1961                      del_chk-discnt.object-line-num = del_chk-gds.line-num AND
     1962                      del_chk-discnt.record-type = 0
     1963                      :
     1964               create ub.chk-discnt.
     1965               buffer-copy del_chk-discnt to ub.chk-discnt
     1966               assign
     1967               ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     1968               ub.chk-discnt.discnt-value-abs = - del_chk-discnt.discnt-value-abs
     1969               ub.chk-discnt.discnt-value-pcnt = - del_chk-discnt.discnt-value-pcnt
     1970               ub.chk-discnt.object-qnty = - del_chk-discnt.object-qnty
     1971               ub.chk-discnt.object-sum = - del_chk-discnt.object-sum
     1972               .
     1973             END.
     1974             for each del_chk-discnt WHERE
     1975                      del_chk-discnt.doc-code = ub.chk-doc.doc-code AND
     1976                      del_chk-discnt.line-num >= del_chk-gds.line-num AND
     1977                      del_chk-discnt.object-line-num = 0 AND
     1978                      del_chk-discnt.record-type = 0:
     1979               assign
     1980               del_chk-discnt.object-sum = del_chk-discnt.object-sum -
     1981                                           del_chk-gds.src-qnty * (del_chk-gds.src-price - del_chk-gds.src-discnt)
     1982               del_chk-discnt.discnt-value-pcnt = if del_chk-discnt.object-sum = 0
     1983                                           then 0
     1984                                           else del_chk-discnt.discnt-value-abs / del_chk-discnt.object-sum  * 100
     1985               .
     1986             end.
     1987             find first tt-wd where
     1988                       tt-wd.line-num = del_chk-gds.line-num no-error .
     1989             if not avail tt-wd then do:
     1990               create tt-wd.
     1991               assign
     1992               tt-wd.doc-code = del_chk-gds.doc-code
     1993               tt-wd.record-type = 0
     1994               tt-wd.line-type  = integer('7':U)
     1995               tt-wd.discnt-id = 0
     1996               tt-wd.line-num = del_chk-gds.line-num
     1997               tt-wd.wd-sum   = 0
     1998               .
     1999               create ub.chk-discnt.
     2000               assign
     2001               ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2002               ub.chk-discnt.record-type = 0
     2003               ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2004               ub.chk-discnt.line-num = del_chk-gds.line-num
     2005               ub.chk-discnt.time-oper = time-oper_
     2006               ub.chk-discnt.line-type = integer('7':U)
     2007               ub.chk-discnt.line-sign = no
     2008               ub.chk-discnt.pass-discnt = integer('0':U)
     2009               ub.chk-discnt.value-type = integer('2':U)
     2010               ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     2011                                         then integer('1':U)
     2012                                         else integer('5':U)
     2013               ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2014               ub.chk-discnt.discnt-value-abs = 0
     2015               ub.chk-discnt.discnt-value-pcnt = 0
     2016               ub.chk-discnt.object-line-num = del_chk-gds.line-num
     2017               ub.chk-discnt.object-sum = - del_chk-gds.src-qnty * (del_chk-gds.src-price - del_chk-gds.src-discnt)
     2018               ub.chk-discnt.object-qnty = del_chk-gds.src-qnty
     2019               ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2020               ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2021               ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2022               ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2023               ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2024               var-discnt-id = var-discnt-id + 1
     2025               .
     2026             end.
     2027             else do:
     2028               assign
     2029               tt-wd.wd-sum = 0
     2030               .
     2031             end.
     2032             v-found = yes.
     2033             LEAVE _del_chk-gds.
     2034           end.
     2035         end.
     2036         if v-found then do:
     2037           create tt-wd.
     2038           assign
     2039           tt-wd.line-num = ub.chk-gds.line-num
     2040           tt-wd.discnt-id = 0
     2041           tt-wd.doc-code = ub.chk-gds.doc-code
     2042           tt-wd.record-type = 0
     2043           tt-wd.line-type  = integer('7':U)
     2044           tt-wd.wd-sum   = 0
     2045           .
     2046           create ub.chk-discnt.
     2047           assign
     2048           ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2049           ub.chk-discnt.record-type = 0
     2050           ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2051           ub.chk-discnt.line-num = ub.chk-gds.line-num
     2052           ub.chk-discnt.time-oper = time-oper_
     2053           ub.chk-discnt.line-type = integer('7':U)
     2054           ub.chk-discnt.line-sign = no
     2055           ub.chk-discnt.pass-discnt = integer('0':U)
     2056           ub.chk-discnt.value-type = integer('2':U)
     2057           ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     2058                                     then integer('1':U)
     2059                                     else integer('5':U)
     2060           ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2061           ub.chk-discnt.discnt-value-abs = 0
     2062           ub.chk-discnt.discnt-value-pcnt = 0
     2063           ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2064           ub.chk-discnt.object-sum = - ub.chk-gds.src-qnty * (chk-gds.src-price - ub.chk-gds.src-discnt)
     2065           ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2066           ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2067           ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2068           ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2069           ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2070           ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2071           var-discnt-id = var-discnt-id + 1
     2072           .
     2073         end.
     2074       end.
     2075       if not v-found then do:
     2076         CREATE ub.chk-gds.
     2077         assign
     2078         lng = lng + 1
     2079         ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2080         ub.chk-gds.line-num = lng
     2081         ub.chk-gds.grp-code = 0
     2082         ub.chk-gds.chk-date = ub.chk-doc.chk-date
     2083         ub.chk-gds.b-code = 0
     2084         ub.chk-gds.src-code = bc-buf
     2085         ub.chk-gds.is-error = no
     2086         ub.chk-gds.src-price = price-from-check
     2087         ub.chk-gds.src-qnty = curr-string-qnty
     2088         ub.chk-gds.doc-qnty = 0
     2089         ub.chk-gds.src-sum  =  sum-from-check
     2090         ub.chk-gds.src-discnt = 0
     2091         ub.chk-gds.pump = 0
     2092         ub.chk-gds.road-tax = 0
     2093         ub.chk-gds.time-oper =  time-oper_
     2094         ub.chk-gds.pass-gds = pass-gds_
     2095         ub.chk-gds.sales-man = sales-man_
     2096         ub.chk-doc.sales-man = (if not v-flag-salesman
     2097                             and
     2098                             (
     2099                             ub.chk-doc.sales-man = 0
     2100                             or ub.chk-doc.sales-man = sales-man_)
     2101                             then sales-man_
     2102                             else 0)
     2103         v-flag-salesman   = (if not v-flag-salesman  and sales-man_ <> 0
     2104                             then yes
     2105                             else v-flag-salesman)
     2106         ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2107                             then (chk-gds.src-qnty >= 0)
     2108                             else (chk-gds.src-qnty <= 0)
     2109                             )
     2110         ub.chk-gds.line-type = '':U
     2111         netto-for-sub-d = netto-for-sub-d + ub.chk-gds.src-sum - ub.chk-gds.src-discnt * ub.chk-gds.src-qnty
     2112         .
     2113       end.
     2114     end.
     2115   end procedure.
     2116   procedure proc-cash-discount :
     2117   DEFINE VARIABLE var-sub-d as decimal no-undo .
     2118   DEFINE VARIABLE var-lng as integer no-undo .
     2119   DEFINE VARIABLE var-str-dec as decimal no-undo .
     2120   define buffer buf_chk-gds for ub.chk-gds.
     2121     do
     2122     on error undo, return error
     2123     :
     2124       if exist or not is-in-check then return.
     2125       assign
     2126       var-sub-d =  - dec( substr(n-entry[11], 9 , 10 )) / 100
     2127       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2128                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2129                     int( substr(n-entry[4], 5, 2) )
     2130       no-error .
     2131       if error-status:error then do:
     2132         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2133       end.
     2134       if var-sub-d = 0 then return.
     2135       create ub.chk-discnt.
     2136       assign
     2137       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2138       ub.chk-discnt.record-type = 0
     2139       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2140       ub.chk-discnt.line-num = ub.chk-gds.line-num
     2141       ub.chk-discnt.time-oper = time-oper_
     2142       ub.chk-discnt.line-type = (if code2 = "5":U or code2 = "6":U
     2143                               then integer('2':U)
     2144                               else integer('3':U)
     2145                               )
     2146       ub.chk-discnt.line-sign = yes
     2147       ub.chk-discnt.pass-discnt = integer('0':U)
     2148       ub.chk-discnt.value-type = if code2 = "5":U or code2 = "7":U
     2149                               then integer('2':U)
     2150                               else (if code2 = '6':U or code2 = '8'
     2151                                     then integer('1':U)
     2152                                     else integer('0':U)
     2153                                    )
     2154       ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     2155                                 then integer('1':U)
     2156                                 else integer('5':U)
     2157       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2158       ub.chk-discnt.discnt-value-abs = var-sub-d
     2159       ub.chk-discnt.discnt-value-pcnt = if netto-for-sub-d = 0
     2160                                       then 0
     2161                                       else var-sub-d * 100 / netto-for-sub-d
     2162       ub.chk-discnt.object-line-num = 0
     2163       ub.chk-discnt.object-sum = netto-for-sub-d
     2164       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2165       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2166       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2167       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2168       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2169       var-discnt-id = var-discnt-id + 1
     2170       sub-d = sub-d + var-sub-d
     2171       netto-for-sub-d = netto-for-sub-d - var-sub-d
     2172       .
     2173       release ub.chk-discnt.
     2174     end.
     2175   end procedure.
     2176   procedure proc-13 :
     2177     do
     2178     on error undo, return error
     2179     :
     2180       if get-chkc_context.cas-shft then do:
     2181         if current-pay-desk <> pay-desk_
     2182         or NOT (current-cas-shift-name =  shift-name_
     2183             AND current-cas-shift-date = shift-date_)
     2184         OR not avail buf_shift-cash then do:
     2185   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2186   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_get-cash-shift in g#libchkvl
     2187     (input  buffer get-chkc_context:handle
     2188     ,buffer buf_shift-cash
     2189     ,input  pay-desk_
     2190     ,input  shift-date_
     2191     ,input  shift-name_
     2192     ,input z-num_
     2193     ,input chk-date_
     2194     ,input chk-time_
     2195     ,input shift-open-time_
     2196       ) no-error .
     2197           if available buf_shift-cash then do:
