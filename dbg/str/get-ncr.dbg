      671   procedure get-last-check-date-time :
      672       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      673       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      674       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      675       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      676       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      677       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      678       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      679       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      680       define variable v-character as character no-undo .
      681       define variable v-date      as date      no-undo .
      682       define variable v-decimal   as decimal   no-undo .
      683       define variable v-integer   as integer   no-undo .
      684       define variable v-logical   as logical   no-undo .
      685       define variable v-attr-type as character no-undo .
      686       define buffer buf_chk-doc     for ub.chk-doc.
      687       define buffer buf_c-cash-desk for ub.c-cash-desk.
      688       do
      689           on error undo, return error
      690           :
      691           run cd-attr-value in this-procedure (
      692               input g#db-num
      693               ,input p-obj-code
      694               ,input p-pos-type
      695               ,input p-cash-num
      696               ,input 'MAGIA-XML_operative':U
      697               ,input 'last-check-date-time':U
      698               ,output v-character
      699               ,output v-date
      700               ,output v-decimal
      701               ,output v-integer
      702               ,output v-logical
      703               ,output v-attr-type     ) no-error.
      704           if v-character = "":U
      705               or v-character = ?
      706               then
      707           do:
      708               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      709                   buf_c-cash-desk.db-num = g#db-num
      710                   AND buf_c-cash-desk.pos-type = p-pos-type
      711                   AND buf_c-cash-desk.cash-num = p-cash-num
      712                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      713                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      714               if available buf_c-cash-desk then
      715               do:
      716                   assign
      717                       p-date = buf_c-cash-desk.corr-date
      718                       p-time = buf_c-cash-desk.corr-time
      719                       .
      720               end.
      721               else
      722               do:
      723                   find first buf_chk-doc no-lock where
      724                       buf_chk-doc.obj-type = 'маг':U
      725                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      726                   if not available buf_chk-doc then
      727                   do:
      728                       return error.
      729                   end.
      730                   assign
      731                       p-date = buf_chk-doc.chk-date - 1
      732                       p-time = buf_chk-doc.chk-time
      733                       .
      734               end.
      735           end.
      736           else
      737           do:
      738               assign
      739                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      740           no-error .
      741               if error-status:error then return error .
      742           end.
      743       end.
      744   end procedure.
      745   procedure get-last-check-params :
      746       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      747       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      748       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      749       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      750       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      751       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      752       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      753       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      754       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      755       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      756       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      757       define variable v-character as character no-undo .
      758       define variable v-date      as date      no-undo .
      759       define variable v-decimal   as decimal   no-undo .
      760       define variable v-integer   as integer   no-undo .
      761       define variable v-logical   as logical   no-undo .
      762       define variable v-attr-type as character no-undo .
      763       define buffer buf_chk-doc     for ub.chk-doc.
      764       define buffer buf_c-cash-desk for ub.c-cash-desk.
      765       do
      766           on error undo, return error
      767           :
      768           run cd-attr-value in this-procedure (
      769               input g#db-num
      770               ,input p-obj-code
      771               ,input p-pos-type
      772               ,input p-cash-num
      773               ,input if p-pos-type eq 'IBM-XML':U
      774               then 'IBM-XML_operative':U
      775               else 'AUTOTANK_operative':U
      776               ,input if p-pos-type = 'IBM-XML':U
      777               then 'last-check-params':U
      778               else 'last-check-params':U
      779               ,output v-character
      780               ,output v-date
      781               ,output v-decimal
      782               ,output v-integer
      783               ,output v-logical
      784               ,output v-attr-type     ) no-error.
      785           if v-character = "":U
      786               or v-character = ?
      787               then
      788           do:
      789               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      790                   buf_c-cash-desk.db-num = g#db-num
      791                   AND buf_c-cash-desk.pos-type = p-pos-type
      792                   AND buf_c-cash-desk.cash-num = p-cash-num
      793                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      794                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      795               if available buf_c-cash-desk then
      796               do:
      797                   assign
      798                       p-date = buf_c-cash-desk.corr-date
      799                       p-time = buf_c-cash-desk.corr-time
      800                       .
      801               end.
      802               else
      803               do:
      804                   find first buf_chk-doc no-lock where
      805                       buf_chk-doc.obj-type = 'маг':U
      806                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      807                   if not available buf_chk-doc then
      808                   do:
      809                       return error.
      810                   end.
      811                   assign
      812                       p-date      = buf_chk-doc.chk-date - 1
      813                       p-time      = buf_chk-doc.chk-time
      814                       p-shift-num = buf_chk-doc.shift-num
      815                       p-z-count   = buf_chk-doc.z-number
      816                       p-chk-num   = buf_chk-doc.chk-num
      817                       .
      818               end.
      819           end.
      820           else
      821           do:
      822               assign
      823                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      824                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      825                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      826                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      827                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      828                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      829           no-error .
      830               if error-status:error then return error .
      831           end.
      832       end.
      833   end procedure.
      834   procedure get-last-report-params :
      835       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      836       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      837       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      838       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      839       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      840       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      841       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      842       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      843       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      844       define variable v-character as character no-undo .
      845       define variable v-date      as date      no-undo .
      846       define variable v-decimal   as decimal   no-undo .
      847       define variable v-integer   as integer   no-undo .
      848       define variable v-logical   as logical   no-undo .
      849       define variable v-date1     as character no-undo .
      850       define variable v-date2     as character no-undo .
      851       define variable v-attr-type as character no-undo .
      852       define buffer buf_chk-slip-head for ub.chk-slip-head.
      853       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      854       do
      855           on error undo, return error
      856           :
      857           run cd-attr-value in this-procedure (
      858               input g#db-num
      859               ,input p-obj-code
      860               ,input p-pos-type
      861               ,input p-cash-num
      862               ,input if p-pos-type eq 'IBM-XML':U
      863               then 'IBM-XML_operative':U
      864               else 'AUTOTANK_operative':U
      865               ,input if p-pos-type = 'IBM-XML':U
      866               then 'last-report-params':U
      867               else 'last-report-params':U
      868               ,output v-character
      869               ,output v-date
      870               ,output v-decimal
      871               ,output v-integer
      872               ,output v-logical
      873               ,output v-attr-type     ) no-error.
      874           if v-character = "":U
      875               or v-character = ?
      876               then
      877           do:
      878               find last buf_chk-slip-head no-lock where
      879                   buf_chk-slip-head.obj-code = p-obj-code
      880                   and buf_chk-slip-head.cash-num = p-cash-num
      881                   and buf_chk-slip-head.db-num = p-db-num
      882                   and buf_chk-slip-head.is-report = 1 no-error.
      883               if not available buf_chk-slip-head then
      884               do:
      885                   return error.
      886               end.
      887               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      888               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      889                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      890                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      891                   + " " + entry(1,v-date2,".") .
      892               assign
      893                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      894                   p-shift-num = buf_chk-slip-head.CashShiftNum
      895                   .
      896           end.
      897           else
      898           do:
      899               assign
      900                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      901                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      902                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      903           no-error .
      904               if error-status:error then return error .
      905           end.
      906       end.
      907   end procedure.
      908   procedure get-last-check-maria :
      909       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      910       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      911       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      912       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      913       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      914       define output parameter p-num-recs as integer no-undo .
      915       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      916       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      917       define output parameter p-p-num-recs as integer no-undo .
      918       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      919       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      920       define variable v-character as character no-undo .
      921       define variable v-date      as date      no-undo .
      922       define variable v-decimal   as decimal   no-undo .
      923       define variable v-integer   as integer   no-undo .
      924       define variable v-logical   as logical   no-undo .
      925       define variable v-attr-type as character no-undo .
      926       define buffer buf_chk-doc     for ub.chk-doc.
      927       define buffer buf_c-cash-desk for ub.c-cash-desk.
      928       do
      929           on error undo, return error
      930           :
      931           run cd-attr-value in this-procedure (
      932               input p-db-num
      933               ,input p-obj-code
      934               ,input 'MARIA':U
      935               ,input p-cash-num
      936               ,input 'MARIA_operative':U
      937               ,input 'last-check-maria':U
      938               ,output v-character
      939               ,output v-date
      940               ,output v-decimal
      941               ,output v-integer
      942               ,output v-logical
      943               ,output v-attr-type     ) no-error.
      944           if v-character = "":U
      945               or v-character = ?
      946               then
      947           do:
      948               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      949                   buf_c-cash-desk.db-num = p-db-num
      950                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      951                   AND buf_c-cash-desk.cash-num = p-cash-num
      952                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      953                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      954               if available buf_c-cash-desk then
      955               do:
      956                   assign
      957                       p-date   = buf_c-cash-desk.corr-date
      958                       p-p-date = buf_c-cash-desk.corr-date
      959                       .
      960               end.
      961               else
      962               do:
      963                   find first buf_chk-doc no-lock where
      964                       buf_chk-doc.obj-type = 'маг':U
      965                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      966                   if not available buf_chk-doc then
      967                   do:
      968                       assign
      969                           p-date       = 01/01/1990
      970                           p-z-count    = 1
      971                           p-num-recs   = 0
      972                           p-p-date     = 01/01/1990
      973                           p-p-z-count  = 1
      974                           p-p-num-recs = 0
      975                           .
      976                   end.
      977                   assign
      978                       p-date       = buf_chk-doc.chk-date - 1
      979                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      980                       p-num-recs   = 0
      981                       p-p-date     = buf_chk-doc.chk-date - 1
      982                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      983                       p-p-num-recs = 0
      984                       .
      985               end.
      986           end.
      987           else
      988           do:
      989               assign
      990                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      991                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      992                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      993                         )
      994                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      995                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      996                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      997                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      998                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      999                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
     1000                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1001                         )
     1002                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1003                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1004                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1005                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1006           no-error .
     1007               if error-status:error then return error .
     1008           end.
     1009       end.
     1010   end procedure.
