     2574   procedure proc-without-discount :
     2575   DEFINE VARIABLE var-wd-sum as decimal no-undo .
     2576     do
     2577     on error undo, return error
     2578     :
     2579       if exist or not is-in-check or was-deleted then return.
     2580       assign
     2581       var-wd-sum = (dec(substr( n-entry[10], 26, 10 )) / 100)
     2582       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2583                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2584                     int( substr(n-entry[4], 5, 2) )
     2585       no-error
     2586       .
     2587       if error-status:error or trim( substr(n-entry[10], 1, 16  )) <> bc-buf then do:
     2588         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2589       end.
     2590       if var-wd-sum = 0 then return.
     2591       create tt-wd.
     2592       assign
     2593       tt-wd.line-num = ub.chk-gds.line-num
     2594       tt-wd.wd-sum   = var-wd-sum
     2595       tt-wd.doc-code = ub.chk-gds.doc-code
     2596       tt-wd.record-type = 0
     2597       tt-wd.line-type  = integer('7':U)
     2598       .
     2599       create ub.chk-discnt.
     2600       assign
     2601       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2602       ub.chk-discnt.record-type = 0
     2603       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2604       ub.chk-discnt.line-num = ub.chk-gds.line-num
     2605       ub.chk-discnt.time-oper = time-oper_
     2606       ub.chk-discnt.line-type = integer('7':U)
     2607       ub.chk-discnt.line-sign = no
     2608       ub.chk-discnt.pass-discnt = integer('0':U)
     2609       ub.chk-discnt.value-type = integer('2':U)
     2610       ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     2611                                 then integer('1':U)
     2612                                 else integer('5':U)
     2613       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2614       ub.chk-discnt.discnt-value-abs = 0
     2615       ub.chk-discnt.discnt-value-pcnt = 0
     2616       ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2617       ub.chk-discnt.object-sum = - var-wd-sum
     2618       ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2619       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2620       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2621       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2622       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2623       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2624       var-discnt-id = var-discnt-id + 1
     2625       netto-for-sub-d = netto-for-sub-d - var-wd-sum
     2626       .
     2627       release ub.chk-discnt.
     2628     end.
     2629   end procedure.
     2630   procedure proc-inv :
     2631   DEFINE VARIABLE codechr as character no-undo .
     2632   DEFINE VARIABLE curr-string-qnty1 as decimal no-undo .
     2633   DEFINE VARIABLE curr-string-qnty2 as decimal no-undo .
     2634   DEFINE VARIABLE curr-string-qntys as decimal no-undo .
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638      if exist
     2639      or not is-in-check
     2640      or not get-chkc_context.is-cdinv then return.
     2641       assign
     2642       codechr = substr(n-entry[10], 22, 1)
     2643       curr-string-qnty1 = int(substr(n-entry[10], 17, 5 ))
     2644       curr-string-qnty2 = int(substr(n-entry[10], 23, 3 ))
     2645       curr-string-qnty = if codechr = ".":U
     2646                         then
     2647                         (curr-string-qnty1 + curr-string-qnty2 / 1000 )
     2648                         else
     2649                         (curr-string-qnty1 * (int(codechr) * 100 + curr-string-qnty2 / 10 ))
     2650       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2651                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2652                     int( substr(n-entry[4], 5, 2) )
     2653       pass-gds_ = (if code3 = "0":U or code3 = "8"
     2654                   then 1
     2655                   else 0
     2656                   )
     2657       no-error
     2658       .
     2659       assign
     2660       bc-buf = trim( substr(n-entry[10], 1, 16  ))
     2661       .
     2662       CASE p-pos-type:
     2663         when 'NCR-GM':U then do:
     2664           assign
     2665           sum-from-check = dec(substr( n-entry[10], 26, 10 )) / 100
     2666           price-from-check = abs(sum-from-check / curr-string-qnty)
     2667           .
     2668         end.
     2669         when 'NCR-AS@R':U then do:
     2670           assign
     2671           price-from-check = dec(substr( n-entry[10], 26, 10 )) / 100
     2672           sum-from-check = price-from-check * curr-string-qnty
     2673           .
     2674         end.
     2675       END CASE.
     2676       if error-status:error then do:
     2677         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2678       end.
     2679       CREATE ub.chk-gds.
     2680       assign
     2681       lng = lng + 1
     2682       ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2683       ub.chk-gds.line-num = lng
     2684       ub.chk-gds.grp-code = 0
     2685       ub.chk-gds.chk-date = ub.chk-doc.chk-date
     2686       ub.chk-gds.b-code = 0
     2687       ub.chk-gds.src-code = bc-buf
     2688       ub.chk-gds.is-error = no
     2689       ub.chk-gds.src-price = price-from-check
     2690       ub.chk-gds.src-qnty = curr-string-qnty
     2691       ub.chk-gds.doc-qnty = 0
     2692       ub.chk-gds.src-sum  =  sum-from-check
     2693       ub.chk-gds.src-discnt = 0
     2694       ub.chk-gds.pump = 0
     2695       ub.chk-gds.road-tax = 0
     2696       ub.chk-gds.time-oper =  time-oper_
     2697       ub.chk-gds.pass-gds = pass-gds_
     2698       ub.chk-gds.sales-man = sales-man_
     2699       ub.chk-doc.sales-man = (if not v-flag-salesman
     2700                           and
     2701                           (
     2702                           ub.chk-doc.sales-man = 0
     2703                           or ub.chk-doc.sales-man = sales-man_)
     2704                           then sales-man_
     2705                           else 0)
     2706       v-flag-salesman   = (if not v-flag-salesman  and sales-man_ <> 0
     2707                           then yes
     2708                           else v-flag-salesman)
     2709       ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2710                           then (chk-gds.src-qnty >= 0)
     2711                           else (chk-gds.src-qnty <= 0)
     2712                           )
     2713       ub.chk-gds.line-type = '':U
     2714       netto-for-sub-d = netto-for-sub-d + ub.chk-gds.src-sum
     2715       .
     2716     end.
     2717   end procedure.
     2718   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2719   procedure proc-tender :
     2720   define input parameter par-mode as integer no-undo .
     2721   define input parameter loc-exist as logical no-undo .
     2722     do
     2723     on error undo, return error
     2724     :
     2725       if loc-exist then return.
     2726       if p-pos-type <> 'NCR-AS@R':U
     2727       and (code3 = '2') then return.
     2728       assign
     2729       tot_sum = dec( substr(n-entry[11], 9, 10) ) / 100
     2730       pay_code = int( substr(n-entry[11], 1, 2) )
     2731       curr_code = ( if pay_code = 1
     2732                     then 0
     2733                     else ?
     2734                     )
     2735       tot_sum = (if par-mode = 1 AND
     2736                     (ub.chk-doc.chk-type = integer('2':U) OR
     2737                     ub.chk-doc.chk-type = integer('5':U))
     2738                   then - 1
     2739                   else 1 ) * tot_sum
     2740       time-oper_ =  int( substr( n-entry[4], 1, 2 ) ) * 3600 +
     2741                     int( substr( n-entry[4], 3, 2 ) ) * 60  +
     2742                     int( substr(n-entry[4], 5, 2) )
     2743       pass-pay_ = int(substr(n-entry[8], 3, 1))
     2744       pay-card_ = trim(n-entry[10])
     2745       no-error
     2746       .
     2747       if error-status:error then do:
     2748         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2749       end.
     2750       if curr_code = ? then
     2751       FIND FIRST ub.cash-pay WHERE
     2752                 ub.cash-pay.cdpay-code = pay_code no-lock no-error .
     2753       else
     2754       FIND FIRST ub.cash-pay WHERE
     2755                 ub.cash-pay.cdpay-code = pay_code AND
     2756                 ub.cash-pay.curr-code = 0  NO-LOCK NO-ERROR.
     2757       assign
     2758       curr_code = if available ub.cash-pay
     2759                   then ub.cash-pay.curr-code
     2760                   else 0
     2761       .
     2762       CASE par-mode:
     2763         when 1 then do:
     2764           if code2 <> "6":U
     2765           or (p-pos-type = 'NCR-AS@R':U and code3 <> "4")
     2766              then do:
     2767             FIND ub.chk-pay WHERE
     2768                   ub.chk-pay.doc-code = ub.chk-doc.doc-code AND
     2769                   ub.chk-pay.curr-code = curr_code AND
     2770                   ub.chk-pay.pay-code = pay_code      NO-ERROR.
     2771             if NOT available ub.chk-pay then  do:
     2772               CREATE ub.chk-pay .
     2773               assign
     2774               lnp = lnp + 1
     2775               ub.chk-pay.doc-code = ub.chk-doc.doc-code
     2776               ub.chk-pay.line-num = lnp
     2777               ub.chk-pay.chk-date = ub.chk-doc.chk-date
     2778               ub.chk-pay.obj-code = shop-code
     2779               ub.chk-pay.obj-type = shop-type
     2780               ub.chk-pay.tot-rubl = 0
     2781               ub.chk-pay.tot-sum = 0
     2782               ub.chk-pay.tot-base = 0
     2783               ub.chk-pay.pay-code = pay_code
     2784               ub.chk-pay.curr-code = curr_code
     2785               ub.chk-pay.time-oper = time-oper_
     2786               ub.chk-pay.cash-rate = 1
     2787               ub.chk-pay.bank-rate = 1
     2788               ub.chk-pay.bank-scale = 1
     2789               ub.chk-pay.line-type = "":U
     2790               ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('2':U)
     2791                                     or ub.chk-doc.chk-type =  integer('5':U)
     2792                                     then (chk-pay.tot-sum <= 0)
     2793                                     else (chk-pay.tot-sum >= 0)
     2794                                     )
     2795               ub.chk-pay.is-error = no
     2796               ub.chk-pay.pass-pay = pass-pay_
     2797               ub.chk-pay.pay-card = ''
     2798               .
     2799             end.
     2800             assign
     2801             ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + tot_sum
     2802             .
     2803           end.
     2804         end.
     2805         when 0 then do:
     2806           FIND ub.chk-pay WHERE
     2807                 ub.chk-pay.doc-code = ub.chk-doc.doc-code AND
     2808                 ub.chk-pay.curr-code = curr_code AND
     2809                 ub.chk-pay.pay-code = pay_code      NO-ERROR.
     2810           if NOT available ub.chk-pay
     2811           then  do:
     2812             CREATE ub.chk-pay .
     2813             assign
     2814             lnp = lnp + 1
     2815             ub.chk-pay.doc-code = ub.chk-doc.doc-code
     2816             ub.chk-pay.line-num = lnp
     2817             ub.chk-pay.chk-date = ub.chk-doc.chk-date
     2818             ub.chk-pay.obj-code = shop-code
     2819             ub.chk-pay.obj-type = shop-type
     2820             ub.chk-pay.tot-rubl = 0
     2821             ub.chk-pay.tot-sum = 0
     2822             ub.chk-pay.tot-base = 0
     2823             ub.chk-pay.pay-code = pay_code
     2824             ub.chk-pay.curr-code = curr_code
     2825             ub.chk-pay.time-oper = time-oper_
     2826             ub.chk-pay.cash-rate = 1
     2827             ub.chk-pay.bank-rate = 1
     2828             ub.chk-pay.bank-scale = 1
     2829             ub.chk-pay.pass-pay = 0
     2830             ub.chk-pay.pay-card = pay-card_
     2831             ub.chk-pay.line-type = "":U
     2832             ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2833                                 then (chk-pay.tot-sum >= 0)
     2834                                 else (chk-pay.tot-sum <= 0)
     2835                                 )
     2836             ub.chk-pay.is-error = no
     2837             .
     2838           end.
     2839           assign
     2840           ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + tot_sum
     2841           .
     2842         end.
     2843       END CASE.
     2844     end.
     2845   end procedure.
