        1   define input  parameter parParentProc as handle no-undo .
        2   define input  parameter p-recid as recid no-undo .
        3   define output parameter p-mode as character no-undo .
        4   define output parameter p-ask as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Параметры закрытия ДНЦ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     run mainmenu_getcntxt in parparentproc
      127       (output v-cntxt-db-num
      128       ,output v-cntxt-userid
      129       ,output v-cntxt-level
      130       ,output v-cntxt-host-code-obj
      131       ,output v-cntxt-obj-type
      132       ,output v-cntxt-obj-code
      133       ,output v-cntxt-db-num-obj
      134       ,output v-cntxt-is-admin
      135       ) .
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define temp-table x_obj-group no-undo like ub.clients  .
      138   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      139   procedure metod-gop-obj :
      140     do
      141     on error undo, return error return-value
      142     :
      143   define input  parameter p-cntxt-db-num as integer   no-undo .
      144   define input  parameter p-gop-id       as integer   no-undo .
      145   define input  parameter p-gop-db-num   as integer   no-undo .
      146   define buffer buf1_clients for ub.clients  .
      147   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      148   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      149   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      150   for each  x_obj-group : delete x_obj-group. end.
      151   if p-gop-id = 0 or p-gop-id = ?  then do:
      152      if p-cntxt-db-num = 0  then do:
      153           for each buf1_clients no-lock where
      154                   (buf1_clients.obj-type = 'маг':U  or
      155                    buf1_clients.obj-type = 'скл':U  )
      156                   and
      157                   buf1_clients.db-num >= 0  and
      158                   buf1_clients.stts = 0
      159                   :
      160             create x_obj-group .
      161             assign
      162               x_obj-group.obj-code   = buf1_clients.obj-code
      163               x_obj-group.obj-type   = buf1_clients.obj-type
      164               x_obj-group.obj-name   = buf1_clients.obj-name
      165               x_obj-group.db-num     = buf1_clients.db-num
      166             .
      167           end.
      168      end.
      169      else do:
      170           for each buf1_clients no-lock where
      171                   (buf1_clients.obj-type = 'маг':U  or
      172                    buf1_clients.obj-type = 'скл':U  ) and
      173                    buf1_clients.db-num = p-cntxt-db-num  and
      174                    buf1_clients.stts = 0
      175                   :
      176             create x_obj-group .
      177             assign
      178               x_obj-group.obj-code   = buf1_clients.obj-code
      179               x_obj-group.obj-type   = buf1_clients.obj-type
      180               x_obj-group.obj-name   = buf1_clients.obj-name
      181               x_obj-group.db-num     = buf1_clients.db-num
      182             .
      183           end.
      184      end.
      185   end.
      186   else do:
      187         for each buf_db-grp-obj-price  where
      188                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      189                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      190                 buf_db-grp-obj-price.stts = 0  no-lock :
      191           for each buf1_clients no-lock where
      192                  (buf1_clients.obj-type = 'маг':U  or
      193                   buf1_clients.obj-type = 'скл':U  ) and
      194                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      195                   buf1_clients.stts = 0
      196                   :
      197             create x_obj-group .
      198             assign
      199               x_obj-group.obj-code   = buf1_clients.obj-code
      200               x_obj-group.obj-type   = buf1_clients.obj-type
      201               x_obj-group.obj-name   = buf1_clients.obj-name
      202               x_obj-group.db-num     = buf1_clients.db-num
      203             .
      204           end.
      205         end.
      206       for each buf_host-grp-obj-price where
      207               buf_host-grp-obj-price.gop-id     = p-gop-id and
      208               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      209               buf_host-grp-obj-price.stts = 0
      210               no-lock :
      211         for each buf1_clients no-lock where
      212                (buf1_clients.obj-type = 'маг':U  or
      213                 buf1_clients.obj-type = 'скл':U  ) and
      214                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      215                 buf1_clients.stts = 0
      216                 :
      217             find first x_obj-group no-lock  where
      218                       x_obj-group.obj-code   = buf1_clients.obj-code and
      219                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      220             if not available  x_obj-group then   create x_obj-group .
      221             assign
      222               x_obj-group.obj-code   = buf1_clients.obj-code
      223               x_obj-group.obj-type   = buf1_clients.obj-type
      224               x_obj-group.obj-name   = buf1_clients.obj-name
      225               x_obj-group.db-num     = buf1_clients.db-num
      226             .
      227         end.
      228       end.
      229       for each buf_obj-grp-obj-price where
      230               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      231               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      232               buf_obj-grp-obj-price.stts = 0
      233               no-lock :
      234         for each buf1_clients no-lock where
      235                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      236                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      237                   buf1_clients.stts     = 0
      238                   :
      239             find first  x_obj-group no-lock  where
      240                         x_obj-group.obj-code   = buf1_clients.obj-code and
      241                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      242             if not available  x_obj-group then   create x_obj-group .
      243             assign
      244               x_obj-group.obj-code   = buf1_clients.obj-code
      245               x_obj-group.obj-type   = buf1_clients.obj-type
      246               x_obj-group.obj-name   = buf1_clients.obj-name
      247               x_obj-group.db-num     = buf1_clients.db-num
      248             .
      249         end.
      250       end.
      251   end.
      252   end.
      253   end procedure.
      254   procedure metod-obj-in-gop :
      255   define input  parameter p-curr-db-num as integer   no-undo .
      256   define input  parameter p-obj-type as character no-undo .
      257   define input  parameter p-obj-code as integer   no-undo .
      258   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      259     do
      260     on error undo, return error return-value
      261     :
      262       empty temp-table x_grp-obj-price.
      263       for each buf_grp-obj-price where
      264                buf_grp-obj-price.stts = 0
      265                no-lock :
      266                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      267                  for each x_obj-group where
      268                           x_obj-group.obj-type = p-obj-type and
      269                           x_obj-group.obj-code = p-obj-code :
      270                       create  x_grp-obj-price.
      271                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      272                  end.
      273       end.
      274     end.
      275   end procedure.
      276   procedure metod-delobj-usr :
      277   define input  parameter p-pdf-id  as integer   no-undo .
      278   define input  parameter p-pdf-db  as integer   no-undo .
      279   define input  parameter p-plt-id  as integer   no-undo .
      280   define input  parameter p-plt-db-num as integer   no-undo .
      281   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      282     do
      283     on error undo, return error return-value
      284     :
      285   for each buf_price-doc-forming-attr no-lock  where
      286            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      287            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      288            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      289            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      290            buf_price-doc-forming-attr.attr-code begins "obj" :
      291      for each x_obj-group  where
      292               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      293               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      294        delete x_obj-group.
      295      end.
      296   end.
      297     if not can-find (first x_obj-group) then do:
      298        return "nullobj" .
      299     end.
      300   end.
      301   end procedure.
      302   procedure metod-obj-pdf :
      303   define input  parameter p-cntxt-db-num as integer   no-undo .
      304   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      305   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      306   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      307   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      308   define buffer buf_price-list-type for ub.price-list-type  .
      309   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      310     do
      311     on error undo, return error return-value
      312     :
      313    for each  x_obj-group : delete x_obj-group. end.
      314    find first buf_price-list-type no-lock where
      315               buf_price-list-type.plt-id = p-plt-id and
      316               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      317   if error-status :error then return error return-value .
      318    find first buf_price-doc-forming no-lock where
      319               buf_price-doc-forming.plt-id     = p-plt-id and
      320               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      321               buf_price-doc-forming.pdf-id     = p-pdf-id and
      322               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      323               no-error .
      324   if error-status :error then return error return-value .
      325     run metod-gop-obj in this-procedure (
      326         p-cntxt-db-num,
      327         buf_price-list-type.gop-id ,
      328         buf_price-list-type.gop-db-num
      329         ) no-error .
      330     run metod-delobj-usr in this-procedure (
      331       buf_price-doc-forming.pdf-id ,
      332       buf_price-doc-forming.pdf-db ,
      333       buf_price-doc-forming.plt-id ,
      334       buf_price-doc-forming.plt-db-num
      335       ) no-error .
      336     end.
      337   end procedure.
      338   DEFINE BUTTON B-Help
      339        LABEL "&Помощь"
      340        SIZE 10 BY 1
      341        BGCOLOR 8 .
      342   DEFINE BUTTON B-Quit AUTO-END-KEY
      343        LABEL "&Отмена"
      344        SIZE 10 BY 1
      345        BGCOLOR 8 .
      346   DEFINE BUTTON B-save AUTO-GO
      347        LABEL "&Ввод"
      348        SIZE 10 BY 1
      349        BGCOLOR 8 .
      350   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      351        VIEW-AS RADIO-SET VERTICAL
      352        RADIO-BUTTONS
      353             "ПРИКАЗ", 1,
      354   "АКТ", 2
      355        SIZE 10.5 BY 2 NO-UNDO.
      356   DEFINE VARIABLE TOGGLE-1 AS LOGICAL INITIAL yes
      357        LABEL "Диалог во время закрытия"
      358        VIEW-AS TOGGLE-BOX
      359        SIZE 27 BY .83 NO-UNDO.
      360   DEFINE FRAME Dialog-Frame
      361        B-save AT ROW 1 COL 1
      362        B-Quit AT ROW 1 COL 11
      363        B-Help AT ROW 1 COL 42.5
      364        RADIO-SET-1 AT ROW 4 COL 6 NO-LABEL
      365        TOGGLE-1 AT ROW 6.75 COL 6
      366        "Закрывать переоценки до статуса :" VIEW-AS TEXT
      367             SIZE 33 BY .67 AT ROW 3.25 COL 3.5
      368             FGCOLOR 4
      369        SPACE(16.49) SKIP(6.57)
      370       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      371            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      372            TITLE "Как закрыть переоценки при закрытии ДНЦ"
      373            DEFAULT-BUTTON B-Quit.
      374   ASSIGN
      375          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      376          FRAME Dialog-Frame:HIDDEN           = TRUE.
      377   ON GO OF FRAME Dialog-Frame
      378   DO:
      379     assign radio-set-1 toggle-1 .
      380     find first ubflt.usr-flt exclusive-lock
      381             where ubflt.usr-flt.user-name  = v-cntxt-userid
      382               and ubflt.usr-flt.call-point = "pdf-cask.w"
      383               no-error.
      384               if not available ubflt.usr-flt then do :
      385                 create ubflt.usr-flt.
      386               end.
      387               assign
      388                 ubflt.usr-flt.user-name  = v-cntxt-userid
      389                 ubflt.usr-flt.call-point = "pdf-cask.w"
      390                 ubflt.usr-flt.list_ = RADIO-SET-1:screen-value + chr(4) + TOGGLE-1:screen-value
      391               .
      392     if radio-set-1 = 2
      393         then p-mode = 'факт':U  .
      394         else p-mode = 'приказ':U .
      395      p-ask =  not ( toggle-1 ).
      396   END.
      397   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      398   DO:
      399     APPLY "END-ERROR":U TO SELF.
      400   END.
      401   ON CHOOSE OF B-Quit IN FRAME Dialog-Frame
      402   DO:
      403     p-mode = ?.
      404     p-ask   = ?.
      405   END.
      406   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      407   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      408   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   on help of frame Dialog-Frame
      410   do:
      411     run gbl/app_help.p
      412       (input this-procedure :file-name
      413       ,input ''
      414       ,input ?
      415       ) no-error.
      416     if error-status :error then do:
      417       message
      418         "Ошибка при вызове помощи"
      419         error-status :get-message(1)
      420         view-as alert-box .
      421     end.
      422   end.
      423   run minbtn-set in this-procedure .
      424   on choose of b-help in frame Dialog-Frame
      425   do:
      426     apply "help":u to frame Dialog-Frame .
      427   end.
      428   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   procedure minbtn-set :
      430       do
      431           on error undo, return error return-value
      432           :
      433           define variable ii              as integer       no-undo .
      434           define variable fh              as widget-handle no-undo .
      435           define variable hh              as widget-handle no-undo .
      436           define variable v-h             as handle        extent 4 no-undo .
      437           define variable v-name-button   as character     no-undo .
      438           define variable v-help-old-x    as decimal       no-undo .
      439           define variable v-help-old-y    as decimal       no-undo .
      440           define variable v-help-old-size as decimal       no-undo .
      441           define variable v-frame-width   as decimal       no-undo .
      442           define variable jj              as integer       no-undo .
      443           do
      444               on error undo, return error
      445               :
      446               assign
      447                   v-frame-width = frame Dialog-Frame:width - 0.3
      448                   fh            = frame Dialog-Frame:first-child
      449                   hh            = fh:first-child
      450                   ii            = 1
      451                   .
      452               do while valid-handle(hh):
      453                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      454                   do:
      455                       case lc(hh:name) :
      456                           when "b-help" then
      457                               do:
      458                                   hh:load-image-up("cmp/b-help.bmp":u) .
      459                                   hh:load-image-down("cmp/b-help.bmp":u) .
      460                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      461                                   hh:TOOLTIP = "Помощь" .
      462                                   v-help-old-x = hh:column .
      463                                   v-help-old-y = hh:row    .
      464                                   v-help-old-size = hh:width .
      465                                   hh:width-chars = 2.5 .
      466                               end.
      467                           when "b-print" then
      468                               do:
      469                                   hh:load-image("cmp/b-print.bmp":u) .
      470                                   hh:TOOLTIP = "Печать" .
      471                                   v-h[ii] = hh:handle .
      472                                   ii = ii + 1 .
      473                                   hh:width-chars = 3 .
      474                               end.
      475                           when "b-history" or
      476                           when "b-hist" then
      477                               do:
      478                                   hh:load-image("cmp/b-hist.bmp":u) .
      479                                   hh:TOOLTIP = "История" .
      480                                   v-h[ii] = hh:handle .
      481                                   ii = ii + 1 .
      482                                   hh:width-chars = 3 .
      483                               end.
      484                           when "b-sch" then
      485                               do:
      486                                   hh:load-image("cmp/b-sch.bmp":u) .
      487                                   hh:TOOLTIP = "Установка Фильтра" .
      488                                   v-h[ii] = hh:handle .
      489                                   ii = ii + 1 .
      490                                   hh:width-chars = 3 .
      491                               end.
      492                           when "b-hist-user" then
      493                               do:
      494                                   hh:load-image("cmp/b-hist.bmp":u) .
      495                                   hh:TOOLTIP = "История пользователя" .
      496                                   ii = ii + 1 .
      497                               end.
      498                       end case.
      499                   end.
      500                   hh = hh:next-sibling.
      501               end.
      502               b-help:column = v-frame-width - b-help:width-chars.
      503               jj = 0.
      504               repeat ii = 4 to 1 by -1 :
      505                   if valid-handle (v-h[ii] ) then
      506                   do:
      507                       jj  = jj + 1 .
      508                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      509                       v-h[ii]:row    = v-help-old-y .
      510                   end.
      511               end.
      512           end.
      513       end.
      514   end procedure.
      515   MAIN-BLOCK:
      516   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      517      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      518     run init-proc in this-procedure .
      519     RUN enable_UI.
      520     WAIT-FOR GO OF FRAME Dialog-Frame.
      521   END.
      522   RUN disable_UI.
      523   PROCEDURE disable_UI :
      524     HIDE FRAME Dialog-Frame.
      525   END PROCEDURE.
      526   PROCEDURE enable_UI :
      527     DISPLAY RADIO-SET-1 TOGGLE-1
      528         WITH FRAME Dialog-Frame .
      529     ENABLE B-Quit B-save B-Help RADIO-SET-1 TOGGLE-1
      530         WITH FRAME Dialog-Frame.
      531     VIEW FRAME Dialog-Frame.
      532   END PROCEDURE.
      533   PROCEDURE init-proc :
      534   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      535   define buffer buf_price-list-type for ub.price-list-type  .
      536   define buffer ch_price-list-type  for ub.price-list-type  .
      537   define variable v-obj-db as integer   no-undo .
      538   find first    buf_price-doc-forming no-lock where
      539                 recid (buf_price-doc-forming) = p-recid no-error .
      540   find first buf_price-list-type no-lock where
      541              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
      542              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
      543                 empty temp-table  x_obj-group.
      544                 run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf_price-list-type.gop-id , buf_price-list-type.gop-db-num) .
      545                 run metod-delobj-usr in this-procedure (
      546                     buf_price-doc-forming.pdf-id ,
      547                     buf_price-doc-forming.pdf-db ,
      548                     buf_price-doc-forming.plt-id ,
      549                     buf_price-doc-forming.plt-db-num
      550                     ) .
      551                 for each x_obj-group :
      552   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      554     (input  x_obj-group.obj-type
      555     ,input  x_obj-group.obj-code
      556     ,output v-obj-db
      557     )  .
      558                    if v-obj-db <> v-cntxt-db-num  and v-cntxt-db-num = 0 then do:
      559                       message "Объект " x_obj-group.obj-type x_obj-group.obj-code "принадлежит другой БД"  skip
      560                       "Закрыть переоценки можно до ПРИКАЗа !" view-as alert-box information .
      561                        RADIO-SET-1:DELETE ( entry(3,RADIO-SET-1:radio-buttons ) ) in frame Dialog-Frame .
      562                        run read-ubflt in this-procedure .
      563                        return.
      564                    end.
      565                    if v-obj-db <> v-cntxt-db-num  and v-cntxt-db-num <> 0 then do:
      566                       delete  x_obj-group.
      567                    end.
      568                 end.
      569                 if buf_price-list-type.under-type-list = 0 then do:
      570                   for each ch_price-list-type no-lock where
      571                             ch_price-list-type.stts            = integer('0':U) and
      572                             ch_price-list-type.plt-main-id     = buf_price-list-type.plt-id and
      573                             ch_price-list-type.plt-main-db-num = buf_price-list-type.plt-db-num :
      574                             empty temp-table  x_obj-group.
      575                             run metod-gop-obj in this-procedure ( v-cntxt-db-num,  ch_price-list-type.gop-id , ch_price-list-type.gop-db-num) .
      576                             run metod-delobj-usr in this-procedure (
      577                                 buf_price-doc-forming.pdf-id ,
      578                                 buf_price-doc-forming.pdf-db ,
      579                                 buf_price-doc-forming.plt-id ,
      580                                 buf_price-doc-forming.plt-db-num
      581                                 ) .
      582                             for each x_obj-group :
      583   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      585     (input  x_obj-group.obj-type
      586     ,input  x_obj-group.obj-code
      587     ,output v-obj-db
      588     )  .
      589                               if v-obj-db <> v-cntxt-db-num and v-cntxt-db-num = 0  then do:
      590                                   message "Есть объекты принадлежащие другой БД " skip
      591                                   "Закрыть переоценки можно до ПРИКАЗа !" view-as alert-box information .
      592                                   RADIO-SET-1:DELETE ( entry(3,RADIO-SET-1:radio-buttons ) ) in frame Dialog-Frame .
      593                               run read-ubflt in this-procedure .
      594                               return.
      595                               end.
      596                               if v-obj-db <> v-cntxt-db-num  and v-cntxt-db-num <> 0 then do:
      597                                   delete  x_obj-group.
      598                               end.
      599                             end.
      600                   end.
      601                 end.
      602   run read-ubflt in this-procedure .
      603   END PROCEDURE.
      604   procedure read-ubflt :
      605     define variable par-pr-rdc-q as character no-undo.
      606     define variable par-type     as character no-undo.
      607     find first ubflt.usr-flt no-lock
      608             where ubflt.usr-flt.user-name  = v-cntxt-userid
      609               and ubflt.usr-flt.call-point = "pdf-cask.w"
      610               no-error.
      611               if available ubflt.usr-flt then do:
      612                 if num-entries(RADIO-SET-1:radio-buttons in frame Dialog-Frame) = 2 then do:
      613                   assign
      614                     TOGGLE-1 = logical(entry(2, ubflt.usr-flt.list_, chr(4)))
      615                   .
      616                 end.
      617                 else do:
      618                   assign
      619                     RADIO-SET-1  = integer(entry(1, ubflt.usr-flt.list_, chr(4)))
      620                     TOGGLE-1 = logical(entry(2, ubflt.usr-flt.list_, chr(4)))
      621                   .
      622                 end.
      623               end.
      624               else do:
      625                 if not (num-entries(RADIO-SET-1:radio-buttons in frame Dialog-Frame)) = 2 then do:
      626                   assign
      627                     RADIO-SET-1 = 2
      628                   .
      629                 end.
      630                 assign
      631                   TOGGLE-1 = yes
      632                 .
      633               end.
      634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      635     (input  'pr-rdc-q'
      636     ,input  v-cntxt-host-code-obj
      637     ,input  v-cntxt-obj-type
      638     ,input  v-cntxt-obj-code
      639     ,input  ''
      640     ,input  ''
      641     ,input  ''
      642     ,input  no
      643     ,output par-pr-rdc-q
      644     ,output par-type
      645     ) no-error .
      646    .
      647     if par-pr-rdc-q <> "" and logical(par-pr-rdc-q) then TOGGLE-1 = yes .
      648   end procedure.
