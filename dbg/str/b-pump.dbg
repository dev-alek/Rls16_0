        1   CREATE WIDGET-POOL.
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Smart browser общения с ТРК".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable varmes-log as logical no-undo.
      132   define variable parparentproc as widget-handle no-undo .
      133   define variable varobj-type like ub.clients.obj-type no-undo.
      134   define variable varobj-code like ub.clients.obj-code no-undo.
      135   define variable varbuttons  as   character        no-undo.
      136   define variable varps-upd   as   logical          no-undo.
      137   procedure pumpdv:
      138   define input parameter parobj-type  like ub.clients.obj-type   no-undo.
      139   define input parameter parobj-code  like ub.clients.obj-code   no-undo.
      140   define input parameter parpump-code like ub.pump.pump-code no-undo.
      141   define buffer bf_clients        for ub.clients.
      142   define buffer bf_pump           for ub.pump.
      143   define buffer bf_pl-pump        for ub.pl-pump.
      144   define buffer bf_pump-nozzle    for ub.pump-nozzle.
      145   define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
      146   define buffer bf_pl-gds-pump    for ub.pl-gds-pump.
      147   define variable varrec-id as recid no-undo.
      148   define variable varmes-log as logical no-undo.
      149   define variable varobj-type like ub.clients.obj-type no-undo.
      150   define variable varobj-code like ub.clients.obj-code no-undo.
      151   define variable varbuttons  as   character        no-undo.
      152   define variable varps-upd   as   logical          no-undo.
      153   find first bf_clients where bf_clients.obj-type = parobj-type and
      154                               bf_clients.obj-code = parobj-code no-lock no-error.
      155   if not available bf_clients then
      156      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      157   find first bf_pump where bf_pump.obj-type  = parobj-type    and
      158                            bf_pump.obj-code  = parobj-code    and
      159                            bf_pump.pump-code = parpump-code no-lock no-error.
      160   if not available bf_pump then
      161      return error SUBSTITUTE("Не найден пистолет с номером &1", parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      162   assign varrec-id = RECID(bf_pump).
      163   run chkcsptr (input parobj-type,
      164                 input parobj-code) no-error.
      165   if error-status:error then return error trim(return-value) +
      166                                           trim(error-status:get-message(1)) +
      167                                           trim(error-status:get-message(2)) +
      168                                           trim(error-status:get-message(3)) +
      169                                           trim(error-status:get-message(4)) +
      170                                           trim(error-status:get-message(5)).
      171   tr:
      172   do transaction on error undo tr, return error
      173                  on stop  undo tr, return error
      174                  on quit  undo tr, return error :
      175     for each bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = parobj-type    and
      176                                      bf_pl-pump-nozzle.obj-code    = parobj-code    and
      177                                      bf_pl-pump-nozzle.pump-code   = parpump-code   exclusive-lock
      178                                      on error undo tr, return error
      179                                      on stop  undo tr, return error
      180                                      on quit  undo tr, return error :
      181         delete bf_pl-pump-nozzle.
      182     end.
      183     for each bf_pl-gds-pump    where bf_pl-gds-pump.obj-type       = parobj-type    and
      184                                      bf_pl-gds-pump.obj-code       = parobj-code    and
      185                                      bf_pl-gds-pump.pump-code      = parpump-code   exclusive-lock
      186                                      on error undo tr, return error
      187                                      on stop  undo tr, return error
      188                                      on quit  undo tr, return error :
      189         delete bf_pl-gds-pump.
      190     end.
      191     for each bf_pl-pump        where bf_pl-pump.obj-type           = parobj-type    and
      192                                      bf_pl-pump.obj-code           = parobj-code    and
      193                                      bf_pl-pump.pump-code          = parpump-code   exclusive-lock
      194                                      on error undo tr, return error
      195                                      on stop  undo tr, return error
      196                                      on quit  undo tr, return error :
      197         delete bf_pl-pump.
      198     end.
      199     for each bf_pump-nozzle    where bf_pump-nozzle.obj-type       = parobj-type    and
      200                                      bf_pump-nozzle.obj-code       = parobj-code    and
      201                                      bf_pump-nozzle.pump-code      = parpump-code exclusive-lock
      202                                      on error undo tr, return error
      203                                      on stop  undo tr, return error
      204                                      on quit  undo tr, return error :
      205         delete bf_pump-nozzle.
      206     end.
      207     find first bf_pump where RECID(bf_pump) = varrec-id exclusive-lock.
      208     delete bf_pump.
      209   end.
      210   end procedure.
      211   procedure chkcsptr:
      212   define input parameter parobj-type   like ub.clients.obj-type     no-undo.
      213   define input parameter parobj-code   like ub.clients.obj-code     no-undo.
      214   define variable        varretobjat   as   character            no-undo.
      215   define variable        varshift-date like ub.shift-obj.shift-date no-undo.
      216   define variable        varshift-num  like ub.shift-obj.shift-num  no-undo.
      217   define buffer bf_clients   for ub.clients.
      218   define buffer bf_shift-obj for ub.shift-obj.
      219   define buffer bf_rvs-doc   for ub.rvs-doc.
      220   find first bf_clients where bf_clients.obj-type = parobj-type and
      221                               bf_clients.obj-code = parobj-code no-lock no-error.
      222   if not available bf_clients then return error "Нет такого объекта " + parobj-type +
      223                                                 " "                   + string(parobj-code) + ".".
      224   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      226     (input  parobj-type
      227     ,input  parobj-code
      228     ,input  'shift-on=request'
      229     ,output varretobjat
      230     ) no-error .
      231   if error-status:error then  return error "Ошибка при вызове файла library.p: objat".
      232   if varretobjat <> "yes" then do:
      233      return error "Фатальная ошибка. На объекте " + parobj-type + " " + string(parobj-code) + " не включены смены.".
      234   end.
      235   find first bf_shift-obj
      236        where bf_shift-obj.obj-type = parobj-type
      237          and bf_shift-obj.obj-code = parobj-code
      238          and bf_shift-obj.status_  = 'тек':U
      239         use-index pi no-error .
      240   if available bf_shift-obj then do:
      241      find first bf_rvs-doc where bf_rvs-doc.obj-type   = parobj-type             and
      242                                  bf_rvs-doc.obj-code   = parobj-code             and
      243                                  bf_rvs-doc.shift-date = bf_shift-obj.shift-date and
      244                                  bf_rvs-doc.shift-num  = bf_shift-obj.shift-num  and
      245                                  bf_rvs-doc.status_    = 'факт':U                 and
      246                                  bf_rvs-doc.rvs-type   = 'смена':U            no-lock no-error.
      247      if not available bf_rvs-doc then
      248      return error "Смена открыта и не сделан документ сверки типа 'смена' за текущую смену.".
      249   end.
      250   end procedure.
      251         define variable v-chk-act-host-code as integer   no-undo .
      252         define variable glog                as logical   no-undo .
      253         define variable v-userid            as character no-undo .
      254         define variable v-db-num            as integer   no-undo .
      255         define variable v-host-code         as integer   no-undo .
      256         define variable v-obj-type          as character no-undo .
      257         define variable v-obj-code          as integer   no-undo .
      258   RUN set-attribute-list (
      259       'Keys-Accepted = ,
      260        Keys-Supplied = ':U).
      261   RUN set-attribute-list (
      262       'SortBy-Options = ""':U).
      263   DEFINE BUTTON b-add
      264        LABEL "&Добавить"
      265        SIZE 10 BY 1.
      266   DEFINE BUTTON b-del
      267        LABEL "&Удалить"
      268        SIZE 10 BY 1.
      269   DEFINE BUTTON b-help
      270        LABEL "&Помощь"
      271        SIZE 10 BY 1.
      272   DEFINE BUTTON b-hist
      273        LABEL "&История"
      274        SIZE 10 BY 1.
      275   DEFINE VARIABLE varps AS CHARACTER FORMAT "X(256)":U
      276        VIEW-AS FILL-IN
      277        SIZE 46.25 BY 1.88 NO-UNDO.
      278   DEFINE QUERY br_table FOR
      279         ub.pump SCROLLING.
      280   DEFINE BROWSE br_table
      281     QUERY br_table NO-LOCK DISPLAY
      282         ub.pump.pump-code
      283       WITH NO-ASSIGN SEPARATORS SIZE 12 BY 7.29.
      284   DEFINE FRAME F-Main
      285        br_table AT ROW 1 COL 1
      286        varps AT ROW 8.42 COL 1 NO-LABEL
      287        b-add AT ROW 10.54 COL 1.38
      288        b-del AT ROW 10.54 COL 11.75
      289        b-hist AT ROW 10.54 COL 22.13
      290        b-help AT ROW 10.54 COL 32.5
      291       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      292            SIDE-LABELS NO-UNDERLINE THREE-D
      293            AT COL 1 ROW 1 SCROLLABLE
      294            BGCOLOR 8 FGCOLOR 0 .
      295   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      296   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      297   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      298   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      299   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      300   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      301   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      302   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      303   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      304   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      305   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      306         adm-object-hdl = FRAME F-Main:HANDLE.
      307   RUN ensure-broker.
      308   THIS-PROCEDURE:ADM-DATA =
      309        'ADM1.1~`':U +
      310        'SmartObject~`':U +
      311        '~`':U +
      312        'YES~`':U +
      313        '~`':U +
      314        'ub.pump~`':U +
      315        '~`':U +
      316        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      317           + "~`":U +
      318        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      319        'Record-Source,Record-Target,TableIO-Target~`':U +
      320        '~`':U +
      321        '~`~`~`~`~`~`~`~`~`~`~`':U +
      322        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      323            THEN "^^":U
      324        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      325             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      326   PROCEDURE adm-apply-entry :
      327     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      328   END PROCEDURE.
      329   PROCEDURE adm-destroy :
      330    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      331   END PROCEDURE.
      332   PROCEDURE adm-disable :
      333       DISABLE br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      334       RUN dispatch ('disable-fields':U).
      335       RUN set-attribute-list ('ENABLED=no':U).
      336       RETURN.
      337   END PROCEDURE.
      338   PROCEDURE adm-edit-attribute-list :
      339         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      340         RETURN.
      341   END PROCEDURE.
      342   PROCEDURE adm-enable :
      343       ENABLE UNLESS-HIDDEN br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      344       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      345       RUN set-attribute-list ('ENABLED=yes':U).
      346       RETURN.
      347   END PROCEDURE.
      348   PROCEDURE adm-exit :
      349        RUN notify ('exit':U).
      350     RETURN.
      351   END PROCEDURE.
      352   PROCEDURE adm-hide :
      353     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      354   END PROCEDURE.
      355   PROCEDURE adm-initialize :
      356     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      357   END PROCEDURE.
      358   PROCEDURE adm-show-errors :
      359       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      360       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      361           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      362       END.
      363       RETURN.
      364   END PROCEDURE.
      365   PROCEDURE adm-UIB-mode :
      366     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      367   END PROCEDURE.
      368   PROCEDURE adm-view :
      369     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      370   END PROCEDURE.
      371   PROCEDURE dispatch :
      372       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      373       RUN broker-dispatch IN adm-broker-hdl
      374           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      375       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      376   END PROCEDURE.
      377   PROCEDURE ensure-broker :
      378   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      379   IF RETURN-VALUE NE "ADM-Broker":U THEN
      380   DO:
      381       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      382       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      383   END.
      384   END PROCEDURE.
      385   PROCEDURE get-attribute :
      386     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      387     RUN broker-get-attribute IN adm-broker-hdl
      388         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      389     RETURN RETURN-VALUE.
      390   END PROCEDURE.
      391   PROCEDURE get-attribute-list :
      392     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      393     RUN broker-get-attribute-list IN adm-broker-hdl
      394         (INPUT THIS-PROCEDURE,
      395          INPUT ?,
      396          OUTPUT p-attr-list) NO-ERROR.
      397     RETURN.
      398   END PROCEDURE.
      399   PROCEDURE new-state :
      400     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      401     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      402     RETURN.
      403   END PROCEDURE.
      404   PROCEDURE notify :
      405     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      406     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      407     IF RETURN-VALUE = "ADM-ERROR":U THEN
      408         RETURN "ADM-ERROR":U.
      409     RETURN.
      410   END PROCEDURE.
      411   PROCEDURE set-attribute-list :
      412     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      413     RUN ensure-broker.
      414     RUN broker-set-attribute-list IN adm-broker-hdl
      415         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      416     RETURN.
      417   END PROCEDURE.
      418   PROCEDURE set-position :
      419       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      420       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      421       IF VALID-HANDLE(adm-object-hdl) THEN
      422       DO:
      423         ASSIGN adm-object-hdl:ROW    =   p-row
      424                adm-object-hdl:COLUMN =   p-col.
      425       END.
      426       RETURN.
      427   END PROCEDURE.
      428     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      429     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      430     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      431     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      432     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      433     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      434     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      435     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      436     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      437     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      438     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      439     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      440     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      441     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      442     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      443     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      444     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      445     IF "":U = "":U THEN
      446       RUN modify-list-attribute IN adm-broker-hdl
      447         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      448     RUN use-create-on-add(?).
      449   PROCEDURE adm-add-record :
      450       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      451          "must have at least one Enabled Table to perform Add.":U
      452          VIEW-AS ALERT-BOX ERROR.
      453       RETURN.
      454   END PROCEDURE.
      455   PROCEDURE adm-assign-record :
      456    MESSAGE
      457          "Object ":U THIS-PROCEDURE:FILE-NAME
      458            "must have at least one Enabled Table to perform Assign.":U
      459              VIEW-AS ALERT-BOX ERROR.
      460      RETURN.
      461     END PROCEDURE.
      462   PROCEDURE adm-assign-statement :
      463     RETURN.
      464   END PROCEDURE.
      465   PROCEDURE adm-cancel-record :
      466      RETURN.
      467     END PROCEDURE.
      468   PROCEDURE adm-copy-record :
      469       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      470        "must have at least one Enabled Table to perform Copy.":U
      471          VIEW-AS ALERT-BOX ERROR.
      472       RETURN.
      473   END PROCEDURE.
      474   PROCEDURE adm-create-record :
      475      RETURN.
      476   END PROCEDURE.
      477   PROCEDURE adm-current-changed :
      478     RETURN.
      479   END PROCEDURE.
      480   PROCEDURE adm-delete-record :
      481    MESSAGE
      482          "Object ":U THIS-PROCEDURE:FILE-NAME
      483            "must have at least one Enabled Table to perform Delete.":U
      484              VIEW-AS ALERT-BOX ERROR.
      485       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      486       RETURN.
      487   END PROCEDURE.
      488   PROCEDURE adm-disable-fields :
      489         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      490       RETURN.
      491   END PROCEDURE.
      492   PROCEDURE adm-enable-fields :
      493       RETURN.
      494   END PROCEDURE.
      495   PROCEDURE adm-end-update :
      496     RETURN.
      497   END PROCEDURE.
      498   PROCEDURE adm-reset-record :
      499       RETURN.
      500   END PROCEDURE.
      501   PROCEDURE adm-update-record :
      502       MESSAGE
      503         "Object ":U THIS-PROCEDURE:FILE-NAME
      504           "must have at least one Enabled Table to perform Update.":U
      505             VIEW-AS ALERT-BOX ERROR.
      506      RETURN.
      507   END PROCEDURE.
      508   PROCEDURE check-modified :
      509   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      510   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      511   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      512   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      513     IF check-state = "check":U THEN
      514     DO:
      515       RUN get-link-handle IN adm-broker-hdl
      516         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      517            OUTPUT group-target-list).
      518       IF group-target-list NE "":U THEN
      519       DO i = 1 TO NUM-ENTRIES(group-target-list):
      520         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      521         RUN check-modified IN curr-widget ('group-check':U).
      522         IF RETURN-VALUE NE "":U THEN
      523         DO:
      524           RUN check-modified-message(RETURN-VALUE).
      525           RETURN "":U.
      526         END.
      527       END.
      528     END.
      529     RETURN "":U.
      530   END PROCEDURE.
      531   PROCEDURE check-modified-message :
      532     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      533        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      534           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      535        IF RETURN-VALUE = "YES":U THEN
      536           RUN notify ('view,CONTAINER-SOURCE':U).
      537        MESSAGE IF p-changed-table NE ? THEN
      538           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      539           ELSE "Current values have been changed."
      540           SKIP "  Do you wish to save those changes?"
      541           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      542        IF ANS THEN
      543        DO:
      544           IF group-assign-target THEN
      545             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      546           ELSE RUN dispatch('update-record':U).
      547           IF RETURN-VALUE = "ADM-ERROR":U THEN
      548           DO:
      549               MESSAGE "Changes to the previous record were not saved."
      550                 VIEW-AS ALERT-BOX ERROR.
      551               IF group-assign-target THEN
      552                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      553               ELSE RUN dispatch ('cancel-record':U).
      554           END.
      555        END.
      556        ELSE DO:
      557          IF group-assign-target THEN
      558             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      559          ELSE RUN dispatch('cancel-record':U).
      560        END.
      561        RETURN.
      562   END PROCEDURE.
      563   PROCEDURE get-rowid :
      564       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      565       ASSIGN
      566       p-table   =   adm-first-table.
      567       RETURN.
      568   END PROCEDURE.
      569   PROCEDURE init-group-assign :
      570       RUN request-attribute IN adm-broker-hdl
      571         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      572       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      573         group-assign-target = yes.
      574       ELSE group-assign-target = no.
      575       RETURN.
      576   END PROCEDURE.
      577   PROCEDURE set-editors :
      578       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      579       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      580       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      581       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      582       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      583       DO WHILE VALID-HANDLE (curr-widget):
      584           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      585              curr-widget:HIDDEN = no THEN DO:
      586             CASE p-field-setting:
      587               WHEN "INITIALIZE":U THEN
      588               DO:
      589                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      590                     read-only-list +
      591                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      592                        STRING(curr-widget).
      593               END.
      594               WHEN "DISABLE":U OR
      595               WHEN "ENABLE":U THEN
      596               DO:
      597                   curr-widget:SENSITIVE = yes.
      598                   RUN get-attribute ('Read-Only-Editors':U).
      599                   IF RETURN-VALUE = ? OR
      600                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      601                       curr-widget:READ-ONLY =
      602                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      603               END.
      604               WHEN "CLEAR":U THEN
      605                   curr-widget:SCREEN-VALUE = "":U.
      606             END CASE.
      607           END.
      608           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      609       END.
      610       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      611         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      612           + '"':U).
      613       RETURN.
      614   END PROCEDURE.
      615   PROCEDURE use-check-modified-all :
      616    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      617     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      618     RETURN.
      619   END PROCEDURE.
      620   PROCEDURE use-create-on-add :
      621   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      622      RETURN.
      623   END PROCEDURE.
      624   PROCEDURE use-initial-lock :
      625     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      626     ASSIGN adm-initial-lock = p-attr-value.
      627     RETURN.
      628   END PROCEDURE.
      629   PROCEDURE adm-display-fields :
      630         IF AVAILABLE ub.pump THEN
      631             DISPLAY ub.pump.pump-code WITH BROWSE br_table
      632               NO-ERROR.
      633         DISPLAY UNLESS-HIDDEN varps
      634             WITH FRAME F-Main NO-ERROR.
      635       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      636       RETURN.
      637   END PROCEDURE.
      638   PROCEDURE adm-open-query :
      639               RUN dispatch ('open-query-cases':U).
      640           adm-query-opened = yes.
      641           IF NUM-RESULTS("br_table":U) = 0 THEN
      642               RUN new-state ('no-record-available,SELF':U).
      643           ELSE DO:
      644               RUN new-state ('record-available,SELF':U).
      645               RUN new-state ('first-record,SELF':U).
      646           END.
      647           IF NOT adm-updating-record THEN
      648               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      649     RETURN.
      650   END PROCEDURE.
      651   PROCEDURE adm-row-changed :
      652         IF VALID-HANDLE(adm-object-hdl) THEN
      653           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      654         RUN notify ('row-available':U).
      655         RETURN.
      656   END PROCEDURE.
      657   PROCEDURE reposition-query :
      658       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      659       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      660       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      661       IF table-name <> ? THEN
      662           REPOSITION br_table TO ROWID table-name NO-ERROR.
      663       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      664       RETURN.
      665   END PROCEDURE.
      666     adm-sts = br_table:SET-REPOSITIONED-ROW
      667       (br_table:DOWN,"CONDITIONAL":U).
      668     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      669   PROCEDURE set-size :
      670     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      671     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      672     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      673     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      674     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      675     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      676     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      677     ASSIGN pd_height = MAX(pd_height, 2.0)
      678            pd_width  = MAX(pd_width, 2.0)
      679            hBrowse     = br_table:HANDLE IN FRAME F-Main
      680            hFieldGroup = hBrowse:PARENT
      681            htmpWidget  = hFieldGroup:FIRST-CHILD
      682            hFrame      = hFieldGroup:PARENT.
      683     Search-For-Siblings:
      684     REPEAT WHILE VALID-HANDLE(htmpWidget):
      685       IF htmpWidget NE hBrowse THEN DO:
      686         IF htmpWidget:TYPE NE "BUTTON" OR
      687            htmpWidget:X    NE 4 OR
      688            htmpWidget:Y    NE 4 THEN DO:
      689           RETURN.
      690         END.
      691       END.
      692       htmpWidget = htmpWidget:NEXT-SIBLING.
      693     END.
      694     IF pd_width < hBrowse:WIDTH THEN
      695       ASSIGN hBrowse:WIDTH = pd_width
      696              hFrame:WIDTH  = pd_width     NO-ERROR.
      697     ELSE
      698       ASSIGN hFrame:WIDTH  = pd_width
      699              hBrowse:WIDTH = pd_width     NO-ERROR.
      700     IF pd_height < hBrowse:HEIGHT THEN
      701       ASSIGN hBrowse:HEIGHT = pd_height
      702              hFrame:HEIGHT  = pd_height     NO-ERROR.
      703     ELSE
      704       ASSIGN hFrame:HEIGHT  = pd_height
      705              hBrowse:HEIGHT = pd_height     NO-ERROR.
      706   END PROCEDURE.
      707   ASSIGN
      708          FRAME F-Main:SCROLLABLE       = FALSE
      709          FRAME F-Main:HIDDEN           = TRUE.
      710   ON CHOOSE OF b-add IN FRAME F-Main
      711   DO:
      712   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   do:
      714     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      715       (input  v-db-num
      716       ,input  v-userid
      717       ,input  0
      718       ,input  'actn_pump-reference_work':U
      719       ,input  'object':U
      720       ,input  v-host-code
      721       ,input  v-obj-type
      722       ,input  v-obj-code
      723       ,input  0
      724       ,input  0
      725       ,input  0
      726       ,input  true
      727       ,output glog
      728       )  .
      729   end.
      730     if NOT glog then return no-apply.
      731   define variable varrec-id as recid no-undo.
      732     CASE "pump"
      733     :
      734      WHEN "nozzle" THEN DO:
      735        run str/d-nozzle.w (input  varobj-type,
      736                        input  varobj-code,
      737                        output varrec-id) no-error.
      738      END.
      739      WHEN "plpmnz" THEN DO:
      740        run str/d-plpmnz.w
      741         ( input parparentproc
      742          ,input varobj-type
      743          ,input varobj-code
      744          ,output varrec-id
      745         ) no-error.
      746      END.
      747      WHEN "plpump" THEN DO:
      748        run str/d-plpump.w
      749         ( input parparentproc
      750          ,input varobj-type
      751          ,input varobj-code
      752          ,output varrec-id
      753         ) no-error.
      754      END.
      755      WHEN "pump" THEN DO:
      756        run str/d-pump.w
      757         ( input parparentproc
      758          ,input varobj-type
      759          ,input  varobj-code
      760          ,output varrec-id
      761         ) no-error.
      762      END.
      763      WHEN "pumpnz" THEN DO:
      764        run str/d-pumpnz.w
      765         ( input parparentproc
      766          ,input varobj-type
      767          ,input varobj-code
      768          ,output varrec-id
      769         ) no-error.
      770      END.
      771      OTHERWISE DO:
      772   message
      773     vss-workfile vss-revision vss-description skip
      774     "Неверное имя файла d-pump.w." skip
      775     "-----------Cистемная ошибка------------" skip
      776     return-value skip
      777     "------Ошибка исполнения программы------" skip
      778     trim(error-status :get-message(1)) +
      779     trim(error-status :get-message(2)) +
      780     trim(error-status :get-message(3)) +
      781     trim(error-status :get-message(4)) +
      782     trim(error-status :get-message(5)) skip
      783     view-as alert-box error .
      784        return no-apply.
      785      END.
      786     END CASE.
      787     if error-status:error then do:
      788   message
      789     vss-workfile vss-revision vss-description skip
      790     "Ошибка при вызове файла d-pump.w." skip
      791     "-----------Cистемная ошибка------------" skip
      792     return-value skip
      793     "------Ошибка исполнения программы------" skip
      794     trim(error-status :get-message(1)) +
      795     trim(error-status :get-message(2)) +
      796     trim(error-status :get-message(3)) +
      797     trim(error-status :get-message(4)) +
      798     trim(error-status :get-message(5)) skip
      799     view-as alert-box error .
      800        return no-apply.
      801     end.
      802     if varrec-id <> ? then do:
      803        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      804        REPOSITION br_table to recid varrec-id.
      805     end.
      806   END.
      807   ON CHOOSE OF b-del IN FRAME F-Main
      808   DO:
      809   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   do:
      811     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      812       (input  v-db-num
      813       ,input  v-userid
      814       ,input  0
      815       ,input  'actn_pump-reference_work':U
      816       ,input  'object':U
      817       ,input  v-host-code
      818       ,input  v-obj-type
      819       ,input  v-obj-code
      820       ,input  0
      821       ,input  0
      822       ,input  0
      823       ,input  true
      824       ,output glog
      825       )  .
      826   end.
      827     if NOT glog then return no-apply.
      828   if available ub.pump then do:
      829      assign varmes-log = no.
      830      message "Вы хотите удалить запись <<ТРК>> с номером " ub.pump.pump-code " ?" skip
      831              "ПРИ ЭТОМ БУДУТ УДАЛЕНЫ ВСЕ СВЯЗИ ТРК С РЕЗЕРВУАРАМИ, ТОВАРАМИ И ПИСТОЛЕТАМИ!!!" skip
      832              "Вы уверены?"
      833              view-as alert-box question buttons yes-no update varmes-log.
      834     if varmes-log = yes then do:
      835        run pumpdv (input ub.pump.obj-type,
      836                    input ub.pump.obj-code,
      837                    input ub.pump.pump-code) no-error.
      838        if error-status:error then do:
      839   message
      840     vss-workfile vss-revision vss-description skip
      841     "Ошибка при удалении ТРК." skip
      842     "-----------Cистемная ошибка------------" skip
      843     return-value skip
      844     "------Ошибка исполнения программы------" skip
      845     trim(error-status :get-message(1)) +
      846     trim(error-status :get-message(2)) +
      847     trim(error-status :get-message(3)) +
      848     trim(error-status :get-message(4)) +
      849     trim(error-status :get-message(5)) skip
      850     view-as alert-box error .
      851           return no-apply.
      852        end.
      853        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      854     end.
      855   end.
      856   END.
      857   ON CHOOSE OF b-hist IN FRAME F-Main
      858   DO:
      859     define variable v-rec-list as character no-undo.
      860     if available ub.pump then do:
      861         run ref/cpmphist.w (
      862                          INPUT parParentProc
      863                        , input ub.pump.obj-type
      864                        , input ub.pump.obj-code
      865                        , input "":U
      866                        , "one":U
      867                        , input ub.pump.obj-type
      868                        , input ub.pump.obj-code
      869                        , input ub.pump.pump-code
      870                        , input 0
      871                        , input 0
      872                        , input 0
      873                        , input '':U
      874                        , input-output v-rec-list
      875                        ) no-error .
      876     end.
      877     apply "entry" to browse br_table.
      878   END.
      879   ON ROW-ENTRY OF br_table IN FRAME F-Main
      880   DO:
      881   END.
      882   ON ROW-LEAVE OF br_table IN FRAME F-Main
      883   DO:
      884   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      885   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      886   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      887     widget-enter = last-event:widget-enter.
      888     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      889     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      890       THEN widget-frame = widget-enter:FRAME.
      891     IF ((NOT VALID-HANDLE(widget-enter)) OR
      892         (widget-parent:TYPE = "BROWSE":U) OR
      893         (NOT VALID-HANDLE(widget-frame)) OR
      894         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      895     THEN DO:
      896         IF adm-brs-in-update THEN
      897         DO:
      898           MESSAGE
      899           "You must complete or cancel the update before leaving the current row."
      900               VIEW-AS ALERT-BOX WARNING.
      901           RETURN NO-APPLY.
      902         END.
      903         IF br_table:CURRENT-ROW-MODIFIED  OR
      904           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      905         DO:
      906           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      907           THEN DO:
      908             MESSAGE
      909             "Current record has been changed. " SKIP
      910             "Do you wish to save those changes?"
      911               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      912             IF l-save THEN
      913             DO:
      914                RUN dispatch('update-record':U).
      915                IF RETURN-VALUE = "ADM-ERROR":U THEN
      916                    RETURN NO-APPLY.
      917             END.
      918             ELSE RUN dispatch ('cancel-record':U).
      919           END.
      920           ELSE DO:
      921             RUN dispatch('update-record':U).
      922             IF RETURN-VALUE = "ADM-ERROR":U THEN
      923                 RETURN NO-APPLY.
      924           END.
      925         END.
      926     END.
      927   END.
      928   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      929   DO:
      930   RUN get-attribute('ADM-NEW-RECORD':U).
      931   IF RETURN-VALUE NE "YES":U THEN
      932     RUN notify ('row-available':U).
      933       RUN state-recid-pump.
      934   END.
      935   ON LEAVE OF varps IN FRAME F-Main
      936   DO:
      937     define buffer bf_pump for ub.pump.
      938     if available ub.pump then do:
      939       if ub.pump.ps <> input frame F-Main varps then do:
      940         if varps-upd = no then do:
      941             message
      942               "Вы не можете изменять примечание!"
      943               view-as alert-box.
      944             display
      945               ub.pump.ps @ varps
      946               with frame F-Main
      947             .
      948         end.
      949         else do:
      950           assign
      951             varmes-log = yes
      952           .
      953           message
      954             "Вы хотите изменить примечание к " "ТРК"
      955             view-as alert-box question buttons yes-no update varmes-log.
      956           if varmes-log = true then do:
      957             do transaction
      958             on error  undo, retry
      959             on stop   undo, retry
      960             on endkey undo, retry
      961             :
      962               if retry then do:
      963                 message
      964                   vss-workfile vss-revision vss-description skip(1)
      965                   "Ошибка при сохранении PS!!!" skip
      966                   error-status :get-message(1) skip
      967                   return-value skip
      968                   view-as alert-box error .
      969                 return no-apply.
      970               end.
      971               find first bf_pump exclusive-lock
      972                 where recid(bf_pump) = recid(ub.pump)
      973               .
      974               assign
      975                 frame F-Main varps
      976               .
      977               assign
      978                 bf_pump.ps = varps
      979               .
      980             end.
      981           end.
      982           else do:
      983             assign
      984               varps = ub.pump.ps
      985             .
      986             display
      987               varps
      988               with frame F-Main
      989             .
      990           end.
      991         end.
      992       end.
      993     end.
      994   END.
      995   if not this-procedure :persistent
      996   then do:
      997     message
      998       vss-workfile vss-revision vss-description skip
      999       "Ошибка при запуске процедуры" skip
     1000       "Данную процедуру следует запускать только с параметром persistent" skip
     1001       view-as alert-box error .
     1002     undo, return error .
     1003   end.
     1004   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1005   on help of frame F-Main
     1006   do:
     1007     run gbl/app_help.p
     1008       (input this-procedure :file-name
     1009       ,input ''
     1010       ,input ?
     1011       ) no-error.
     1012     if error-status :error then do:
     1013       message
     1014         "Ошибка при вызове помощи"
     1015         error-status :get-message(1)
     1016         view-as alert-box .
     1017     end.
     1018   end.
     1019   run minbtn-set in this-procedure .
     1020   on choose of b-help in frame F-Main
     1021   do:
     1022     apply "help":u to frame F-Main .
     1023   end.
     1024   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   procedure minbtn-set :
     1026       do
     1027           on error undo, return error return-value
     1028           :
     1029           define variable ii              as integer       no-undo .
     1030           define variable fh              as widget-handle no-undo .
     1031           define variable hh              as widget-handle no-undo .
     1032           define variable v-h             as handle        extent 4 no-undo .
     1033           define variable v-name-button   as character     no-undo .
     1034           define variable v-help-old-x    as decimal       no-undo .
     1035           define variable v-help-old-y    as decimal       no-undo .
     1036           define variable v-help-old-size as decimal       no-undo .
     1037           define variable v-frame-width   as decimal       no-undo .
     1038           define variable jj              as integer       no-undo .
     1039           do
     1040               on error undo, return error
     1041               :
     1042               assign
     1043                   v-frame-width = frame F-Main:width - 0.3
     1044                   fh            = frame F-Main:first-child
     1045                   hh            = fh:first-child
     1046                   ii            = 1
     1047                   .
     1048               do while valid-handle(hh):
     1049                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1050                   do:
     1051                       case lc(hh:name) :
     1052                           when "b-help" then
     1053                               do:
     1054                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1055                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1056                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1057                                   hh:TOOLTIP = "Помощь" .
     1058                                   v-help-old-x = hh:column .
     1059                                   v-help-old-y = hh:row    .
     1060                                   v-help-old-size = hh:width .
     1061                                   hh:width-chars = 2.5 .
     1062                               end.
     1063                           when "b-print" then
     1064                               do:
     1065                                   hh:load-image("cmp/b-print.bmp":u) .
     1066                                   hh:TOOLTIP = "Печать" .
     1067                                   v-h[ii] = hh:handle .
     1068                                   ii = ii + 1 .
     1069                                   hh:width-chars = 3 .
     1070                               end.
     1071                           when "b-history" or
     1072                           when "b-hist" then
     1073                               do:
     1074                                   hh:load-image("cmp/b-hist.bmp":u) .
     1075                                   hh:TOOLTIP = "История" .
     1076                                   v-h[ii] = hh:handle .
     1077                                   ii = ii + 1 .
     1078                                   hh:width-chars = 3 .
     1079                               end.
     1080                           when "b-sch" then
     1081                               do:
     1082                                   hh:load-image("cmp/b-sch.bmp":u) .
     1083                                   hh:TOOLTIP = "Установка Фильтра" .
     1084                                   v-h[ii] = hh:handle .
     1085                                   ii = ii + 1 .
     1086                                   hh:width-chars = 3 .
     1087                               end.
     1088                           when "b-hist-user" then
     1089                               do:
     1090                                   hh:load-image("cmp/b-hist.bmp":u) .
     1091                                   hh:TOOLTIP = "История пользователя" .
     1092                                   ii = ii + 1 .
     1093                               end.
     1094                       end case.
     1095                   end.
     1096                   hh = hh:next-sibling.
     1097               end.
     1098               b-help:column = v-frame-width - b-help:width-chars.
     1099               jj = 0.
     1100               repeat ii = 4 to 1 by -1 :
     1101                   if valid-handle (v-h[ii] ) then
     1102                   do:
     1103                       jj  = jj + 1 .
     1104                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1105                       v-h[ii]:row    = v-help-old-y .
     1106                   end.
     1107               end.
     1108           end.
     1109       end.
     1110   end procedure.
     1111   PROCEDURE adm-open-query-cases :
     1112     OPEN QUERY br_table FOR EACH ub.pump WHERE ub.pump.obj-type = varobj-type and                                             ub.pump.obj-code = varobj-code NO-LOCK       INDEXED-REPOSITION.
     1113   END PROCEDURE.
     1114   PROCEDURE adm-row-available :
     1115     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1116     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1117     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1118     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1119     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1120     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1121     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1122     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1123     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1124     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1125     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1126     IF adm-updating-record THEN RETURN.
     1127     RUN get-attribute ('FIELDS-ENABLED':U).
     1128     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1129     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1130         OUTPUT link-handle) NO-ERROR.
     1131     IF link-handle = "":U THEN
     1132         RETURN.
     1133     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1134     IF NUM-ENTRIES(link-handle) > 1 THEN
     1135         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1136             "encountered more than one RECORD-SOURCE.":U SKIP
     1137             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1138                VIEW-AS ALERT-BOX ERROR.
     1139     RUN get-attribute ('Key-Name':U).
     1140     key-name = RETURN-VALUE.
     1141     IF key-name = "":U THEN key-name = ?.
     1142     IF key-name NE ? THEN DO:
     1143       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1144         NO-ERROR.
     1145       IF key-value NE ? THEN
     1146         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1147     END.
     1148   IF VALID-HANDLE (adm-object-hdl) THEN
     1149       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1150     IF key-name ne ? OR different-row
     1151     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1152     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1153   END PROCEDURE.
     1154   PROCEDURE disable_UI :
     1155     HIDE FRAME F-Main.
     1156     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1157   END PROCEDURE.
     1158   PROCEDURE local-initialize :
     1159   RUN request-attribute IN adm-broker-hdl
     1160       (INPUT THIS-PROCEDURE,
     1161        INPUT 'Container-Source':U,
     1162        INPUT 'parparentproc':U) NO-ERROR.
     1163   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "parparentproc" + " для получения данных." view-as alert-box error. return error.                    end.
     1164   assign parparentproc = widget-handle(return-value).
     1165   RUN request-attribute IN adm-broker-hdl
     1166       (INPUT THIS-PROCEDURE,
     1167        INPUT 'Container-Source':U,
     1168        INPUT 'obj-type':U) NO-ERROR.
     1169   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-type" + " для получения данных." view-as alert-box error. return error.                    end.
     1170   assign varobj-type = return-value.
     1171   RUN request-attribute IN adm-broker-hdl
     1172       (INPUT THIS-PROCEDURE,
     1173        INPUT 'Container-Source':U,
     1174        INPUT 'obj-code':U) NO-ERROR.
     1175   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-code" + " для получения данных." view-as alert-box error. return error.                    end.
     1176   assign varobj-code = integer(return-value).
     1177   RUN request-attribute IN adm-broker-hdl
     1178       (INPUT THIS-PROCEDURE,
     1179        INPUT 'Container-Source':U,
     1180        INPUT 'buttons':U) NO-ERROR.
     1181   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "buttons" + " для получения данных." view-as alert-box error. return error.                    end.
     1182   assign varbuttons = return-value.
     1183   assign varbuttons = replace (varbuttons, "|", ",").
     1184   if lookup('b-add', varbuttons) = 0 then do:
     1185     assign
     1186       b-add:sensitive in frame F-Main = no
     1187       b-add:visible   in frame F-Main = no
     1188       varps:read-only in frame F-Main = yes
     1189       varps-upd                    = no
     1190     .
     1191   end.
     1192   else do:
     1193     assign
     1194       varps-upd = yes
     1195     .
     1196   end.
     1197   if lookup('b-del', varbuttons) = 0 then
     1198      assign b-del:sensitive in frame F-Main = no
     1199             b-del:visible   in frame F-Main = no.
     1200     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1201   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202     run mainmenu_getcntxt in parparentproc
     1203       (output v-cntxt-db-num
     1204       ,output v-cntxt-userid
     1205       ,output v-cntxt-level
     1206       ,output v-cntxt-host-code-obj
     1207       ,output v-cntxt-obj-type
     1208       ,output v-cntxt-obj-code
     1209       ,output v-cntxt-db-num-obj
     1210       ,output v-cntxt-is-admin
     1211       ) .
     1212         assign
     1213           v-db-num    = v-cntxt-db-num
     1214           v-host-code = v-cntxt-host-code-obj
     1215           v-obj-code  = v-cntxt-obj-code
     1216           v-obj-type  = v-cntxt-obj-type
     1217           v-userid    = v-cntxt-userid
     1218           .
     1219     RUN state-recid-pump.
     1220   END PROCEDURE.
     1221   PROCEDURE send-key :
     1222   END PROCEDURE.
     1223   PROCEDURE send-records :
     1224     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1225     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1226     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1227     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1228     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1229     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1230         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1231         CASE ENTRY(i, p-tbl-list):
     1232       WHEN "ub.pump":U THEN p-rowid-list = p-rowid-list +
     1233           IF AVAILABLE ub.pump THEN STRING(ROWID(ub.pump))
     1234           ELSE "?":U.
     1235           OTHERWISE
     1236           DO:
     1237               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1238                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1239               IF link-handle NE "":U THEN
     1240               DO:
     1241                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1242                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1243                               "encountered more than one RECORD-SOURCE.":U SKIP
     1244                               "The first will be used.":U
     1245                               VIEW-AS ALERT-BOX ERROR.
     1246                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1247                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1248                   p-rowid-list = p-rowid-list + rowid-string.
     1249               END.
     1250               ELSE
     1251               DO:
     1252                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1253                           "does not match tables in send-records":U
     1254                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1255                           "Check that objects are linked properly and that":U
     1256                           "database qualification is consistent.":U
     1257                       VIEW-AS ALERT-BOX ERROR.
     1258                   RETURN ERROR.
     1259               END.
     1260           END.
     1261           END CASE.
     1262       END.
     1263   END PROCEDURE.
     1264   PROCEDURE state-changed :
     1265     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1266     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1267     CASE p-state:
     1268       WHEN "update-begin":U THEN
     1269       DO:
     1270           adm-brs-in-update = yes.
     1271           RUN dispatch ('enable-fields':U).
     1272           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1273           DO:
     1274             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1275             RUN new-state('update-complete':U).
     1276           END.
     1277           ELSE DO:
     1278             RUN dispatch ('apply-entry':U).
     1279             RUN new-state('update':U).
     1280           END.
     1281       END.
     1282       WHEN "update":U THEN
     1283         DO:
     1284           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1285           RUN get-link-handle IN adm-broker-hdl
     1286               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1287                   NO-ERROR.
     1288           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1289             br_table:SENSITIVE IN FRAME F-Main = no.
     1290         END.
     1291       WHEN "update-complete":U THEN DO:
     1292           br_table:SENSITIVE IN FRAME F-Main = yes.
     1293           adm-brs-in-update = no.
     1294           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1295           IF RETURN-VALUE NE "YES":U THEN
     1296           DO:
     1297             IF NUM-RESULTS("br_table":U) NE ? AND
     1298                NUM-RESULTS("br_table":U) NE 0
     1299             THEN DO:
     1300               GET CURRENT br_table.
     1301               RUN dispatch ('row-changed':U).
     1302             END.
     1303           END.
     1304           RUN new-state ('update-complete':U).
     1305       END.
     1306       WHEN "delete-complete":U THEN DO:
     1307          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1308          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1309          IF NUM-RESULTS("br_table":U) = 0 THEN
     1310            RUN notify('row-available':U).
     1311       END.
     1312       WHEN   'first-record':U        OR
     1313         WHEN 'last-record':U         OR
     1314         WHEN 'only-record':U         OR
     1315         WHEN 'not-first-or-last':U   OR
     1316         WHEN 'no-record-available':U OR
     1317         WHEN 'no-external-record-available':U THEN
     1318           RUN set-attribute-list('Query-Position=':U + p-state).
     1319     END CASE.
     1320   END PROCEDURE.
     1321   PROCEDURE state-recid-pump :
     1322   if available ub.pump then do:
     1323        assign varPS = ub.pump.pS.
     1324        display varPS with frame F-Main.
     1325        run set-attribute-list ("recid-pump=" + string(recid(ub.pump))).
     1326        run notify ('recid-pump,recid-pump-target':u).
     1327     end.
     1328   END PROCEDURE.
