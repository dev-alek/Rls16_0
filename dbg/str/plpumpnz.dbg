        1   CREATE WIDGET-POOL.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter  parbuttons as character no-undo.
        4   define output parameter parrec-id  as recid     no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Главное окно для справочников резервуар-ТРК-пистолеты".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     run mainmenu_getcntxt in parparentproc
      127       (output v-cntxt-db-num
      128       ,output v-cntxt-userid
      129       ,output v-cntxt-level
      130       ,output v-cntxt-host-code-obj
      131       ,output v-cntxt-obj-type
      132       ,output v-cntxt-obj-code
      133       ,output v-cntxt-db-num-obj
      134       ,output v-cntxt-is-admin
      135       ) .
      136   DEFINE VARIABLE h_b-nozzle AS HANDLE NO-UNDO.
      137   DEFINE VARIABLE h_b-plpmnz AS HANDLE NO-UNDO.
      138   DEFINE VARIABLE h_b-plpump AS HANDLE NO-UNDO.
      139   DEFINE VARIABLE h_b-pump AS HANDLE NO-UNDO.
      140   DEFINE VARIABLE h_b-pumpnz AS HANDLE NO-UNDO.
      141   DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
      142   DEFINE BUTTON b-exit AUTO-GO
      143        LABEL "&Выход"
      144        SIZE 10 BY 1
      145        BGCOLOR 8 .
      146   DEFINE BUTTON b-help
      147        LABEL "&Помощь"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE FRAME D-Dialog
      151        b-exit AT ROW 1 COL 1
      152        b-help AT ROW 1 COL 11
      153        SPACE(77.74) SKIP(13.24)
      154       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      155            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      156            TITLE "Справочники резервуар-ТРК-пистолет ТРК"
      157            DEFAULT-BUTTON b-exit.
      158   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      159   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      160   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      161   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      162   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      163   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      164   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      165   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      166       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      167   RUN ensure-broker.
      168   THIS-PROCEDURE:ADM-DATA =
      169        'ADM1.1~`':U +
      170        'SmartDialog~`':U +
      171        'DIALOG-BOX~`':U +
      172        'NO ~`':U +
      173        '~`':U +
      174        '~`':U +
      175        '~`':U +
      176        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      177           + "~`":U +
      178        'Layout,Hide-on-Init~`':U +
      179        '~`':U +
      180        '~`':U +
      181        '~`~`~`~`~`~`~`~`~`~`~`':U +
      182        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      183            THEN "^^":U
      184        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      185             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      186   PROCEDURE adm-apply-entry :
      187     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      188   END PROCEDURE.
      189   PROCEDURE adm-destroy :
      190    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      191   END PROCEDURE.
      192   PROCEDURE adm-disable :
      193       DISABLE b-exit b-help WITH FRAME D-Dialog.
      194       RUN dispatch ('disable-fields':U).
      195       RUN set-attribute-list ('ENABLED=no':U).
      196       RETURN.
      197   END PROCEDURE.
      198   PROCEDURE adm-edit-attribute-list :
      199         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      200         RETURN.
      201   END PROCEDURE.
      202   PROCEDURE adm-enable :
      203       ENABLE UNLESS-HIDDEN b-exit b-help WITH FRAME D-Dialog.
      204       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      205       RUN set-attribute-list ('ENABLED=yes':U).
      206       RETURN.
      207   END PROCEDURE.
      208   PROCEDURE adm-exit :
      209        RUN notify ('exit':U).
      210     RETURN.
      211   END PROCEDURE.
      212   PROCEDURE adm-hide :
      213     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      214   END PROCEDURE.
      215   PROCEDURE adm-initialize :
      216     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      217   END PROCEDURE.
      218   PROCEDURE adm-show-errors :
      219       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      220       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      221           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      222       END.
      223       RETURN.
      224   END PROCEDURE.
      225   PROCEDURE adm-UIB-mode :
      226     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      227   END PROCEDURE.
      228   PROCEDURE adm-view :
      229     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      230   END PROCEDURE.
      231   PROCEDURE dispatch :
      232       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      233       RUN broker-dispatch IN adm-broker-hdl
      234           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      235       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      236   END PROCEDURE.
      237   PROCEDURE ensure-broker :
      238   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      239   IF RETURN-VALUE NE "ADM-Broker":U THEN
      240   DO:
      241       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      242       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      243   END.
      244   END PROCEDURE.
      245   PROCEDURE get-attribute :
      246     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      247     RUN broker-get-attribute IN adm-broker-hdl
      248         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      249     RETURN RETURN-VALUE.
      250   END PROCEDURE.
      251   PROCEDURE get-attribute-list :
      252     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      253     RUN broker-get-attribute-list IN adm-broker-hdl
      254         (INPUT THIS-PROCEDURE,
      255          INPUT ?,
      256          OUTPUT p-attr-list) NO-ERROR.
      257     RETURN.
      258   END PROCEDURE.
      259   PROCEDURE new-state :
      260     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      261     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      262     RETURN.
      263   END PROCEDURE.
      264   PROCEDURE notify :
      265     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      266     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      267     IF RETURN-VALUE = "ADM-ERROR":U THEN
      268         RETURN "ADM-ERROR":U.
      269     RETURN.
      270   END PROCEDURE.
      271   PROCEDURE set-attribute-list :
      272     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      273     RUN ensure-broker.
      274     RUN broker-set-attribute-list IN adm-broker-hdl
      275         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      276     RETURN.
      277   END PROCEDURE.
      278   PROCEDURE set-position :
      279       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      280       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      281       IF VALID-HANDLE(adm-object-hdl) THEN
      282       DO:
      283           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      284           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      285           DO:
      286             IF p-row = 0 THEN p-row =
      287               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      288             IF p-col = 0 THEN p-col =
      289               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      290           END.
      291           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      292           DO:
      293             parent-hdl = adm-object-hdl:PARENT.
      294             IF p-row = 0 THEN p-row =
      295               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      296                 parent-hdl:ROW.
      297             IF p-col = 0 THEN p-col =
      298               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      299                 parent-hdl:COL.
      300           END.
      301           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      302           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      303         ASSIGN adm-object-hdl:ROW    =   p-row
      304                adm-object-hdl:COLUMN =   p-col.
      305       END.
      306       RETURN.
      307   END PROCEDURE.
      308   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      309       STRING(adm-object-hdl)).
      310   PAUSE 0 BEFORE-HIDE.
      311   PROCEDURE adm-change-page :
      312     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      313     END PROCEDURE.
      314   PROCEDURE delete-page :
      315     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      316     RUN broker-delete-page IN adm-broker-hdl
      317         (INPUT THIS-PROCEDURE, INPUT p-page#).
      318     END PROCEDURE.
      319   PROCEDURE init-object :
      320     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      321     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      322     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      323     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      324     RUN broker-init-object IN adm-broker-hdl
      325         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      326          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      327     RETURN.
      328   END PROCEDURE.
      329   PROCEDURE init-pages :
      330     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      331     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      332         INPUT p-page-list) NO-ERROR.
      333     END PROCEDURE.
      334   PROCEDURE select-page :
      335     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      336     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      337         INPUT p-page#) NO-ERROR.
      338     END PROCEDURE.
      339   PROCEDURE view-page :
      340     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      341     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      342         INPUT p-page#).
      343     END PROCEDURE.
      344   ASSIGN
      345          FRAME D-Dialog:SCROLLABLE       = FALSE
      346          FRAME D-Dialog:HIDDEN           = TRUE.
      347   ON WINDOW-CLOSE OF FRAME D-Dialog
      348   DO:
      349     APPLY "END-ERROR":U TO SELF.
      350   END.
      351   run set-attribute-list ('parparentproc='  + string(parparentproc)).
      352   run set-attribute-list ('obj-type=' + string(v-cntxt-obj-type)).
      353   run set-attribute-list ('obj-code=' + string(v-cntxt-obj-code)).
      354   run set-attribute-list ('buttons='  + string(parbuttons)).
      355   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   on help of frame D-Dialog
      357   do:
      358     run gbl/app_help.p
      359       (input this-procedure :file-name
      360       ,input ''
      361       ,input ?
      362       ) no-error.
      363     if error-status :error then do:
      364       message
      365         "Ошибка при вызове помощи"
      366         error-status :get-message(1)
      367         view-as alert-box .
      368     end.
      369   end.
      370   run minbtn-set in this-procedure .
      371   on choose of b-help in frame D-Dialog
      372   do:
      373     apply "help":u to frame D-Dialog .
      374   end.
      375   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure minbtn-set :
      377       do
      378           on error undo, return error return-value
      379           :
      380           define variable ii              as integer       no-undo .
      381           define variable fh              as widget-handle no-undo .
      382           define variable hh              as widget-handle no-undo .
      383           define variable v-h             as handle        extent 4 no-undo .
      384           define variable v-name-button   as character     no-undo .
      385           define variable v-help-old-x    as decimal       no-undo .
      386           define variable v-help-old-y    as decimal       no-undo .
      387           define variable v-help-old-size as decimal       no-undo .
      388           define variable v-frame-width   as decimal       no-undo .
      389           define variable jj              as integer       no-undo .
      390           do
      391               on error undo, return error
      392               :
      393               assign
      394                   v-frame-width = frame D-Dialog:width - 0.3
      395                   fh            = frame D-Dialog:first-child
      396                   hh            = fh:first-child
      397                   ii            = 1
      398                   .
      399               do while valid-handle(hh):
      400                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      401                   do:
      402                       case lc(hh:name) :
      403                           when "b-help" then
      404                               do:
      405                                   hh:load-image-up("cmp/b-help.bmp":u) .
      406                                   hh:load-image-down("cmp/b-help.bmp":u) .
      407                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      408                                   hh:TOOLTIP = "Помощь" .
      409                                   v-help-old-x = hh:column .
      410                                   v-help-old-y = hh:row    .
      411                                   v-help-old-size = hh:width .
      412                                   hh:width-chars = 2.5 .
      413                               end.
      414                           when "b-print" then
      415                               do:
      416                                   hh:load-image("cmp/b-print.bmp":u) .
      417                                   hh:TOOLTIP = "Печать" .
      418                                   v-h[ii] = hh:handle .
      419                                   ii = ii + 1 .
      420                                   hh:width-chars = 3 .
      421                               end.
      422                           when "b-history" or
      423                           when "b-hist" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История" .
      427                                   v-h[ii] = hh:handle .
      428                                   ii = ii + 1 .
      429                                   hh:width-chars = 3 .
      430                               end.
      431                           when "b-sch" then
      432                               do:
      433                                   hh:load-image("cmp/b-sch.bmp":u) .
      434                                   hh:TOOLTIP = "Установка Фильтра" .
      435                                   v-h[ii] = hh:handle .
      436                                   ii = ii + 1 .
      437                                   hh:width-chars = 3 .
      438                               end.
      439                           when "b-hist-user" then
      440                               do:
      441                                   hh:load-image("cmp/b-hist.bmp":u) .
      442                                   hh:TOOLTIP = "История пользователя" .
      443                                   ii = ii + 1 .
      444                               end.
      445                       end case.
      446                   end.
      447                   hh = hh:next-sibling.
      448               end.
      449               b-help:column = v-frame-width - b-help:width-chars.
      450               jj = 0.
      451               repeat ii = 4 to 1 by -1 :
      452                   if valid-handle (v-h[ii] ) then
      453                   do:
      454                       jj  = jj + 1 .
      455                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      456                       v-h[ii]:row    = v-help-old-y .
      457                   end.
      458               end.
      459           end.
      460       end.
      461   end procedure.
      462   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      463       MESSAGE "A SmartDialog is not intended ":U SKIP
      464               "to be run Persistent or to be placed ":U SKIP
      465               "in another SmartObject at UIB design time.":U
      466               VIEW-AS ALERT-BOX ERROR.
      467       RUN disable_UI.
      468       DELETE PROCEDURE THIS-PROCEDURE.
      469       RETURN.
      470   END.
      471   RUN dispatch ('create-objects':U).
      472   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      473   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      474   MAIN-BLOCK:
      475   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      476      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      477     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      478     WAIT-FOR GO OF FRAME D-Dialog.
      479   END.
      480   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      481   PROCEDURE adm-create-objects :
      482     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      483     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      484     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      485     CASE adm-current-page:
      486       WHEN 0 THEN DO:
      487          RUN init-object IN THIS-PROCEDURE (
      488                INPUT  'adm/objects/folder.w':U ,
      489                INPUT  FRAME D-Dialog:HANDLE ,
      490                INPUT  'FOLDER-LABELS = ':U + 'РезТРКПист|РезТРК|ТРКПист|ТРК|Пистолеты' + ',
      491                        FOLDER-TAB-TYPE = 1':U ,
      492                OUTPUT h_folder ).
      493          RUN set-position IN h_folder ( 2.79 , 1.00 ) NO-ERROR.
      494          RUN set-size IN h_folder ( 12.42 , 97.63 ) NO-ERROR.
      495          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
      496       END.
      497       WHEN 1 THEN DO:
      498          RUN init-object IN THIS-PROCEDURE (
      499                INPUT  'str/b-plpmnz.w':U ,
      500                INPUT  FRAME D-Dialog:HANDLE ,
      501                INPUT  'Layout = ':U ,
      502                OUTPUT h_b-plpmnz ).
      503          RUN set-position IN h_b-plpmnz ( 3.96 , 1.13 ) NO-ERROR.
      504          RUN set-size IN h_b-plpmnz ( 10.54 , 97.25 ) NO-ERROR.
      505       END.
      506       WHEN 2 THEN DO:
      507          RUN init-object IN THIS-PROCEDURE (
      508                INPUT  'str/b-plpump.w':U ,
      509                INPUT  FRAME D-Dialog:HANDLE ,
      510                INPUT  'Layout = ':U ,
      511                OUTPUT h_b-plpump ).
      512          RUN set-position IN h_b-plpump ( 3.96 , 14.75 ) NO-ERROR.
      513          RUN set-size IN h_b-plpump ( 10.54 , 46.25 ) NO-ERROR.
      514       END.
      515       WHEN 3 THEN DO:
      516          RUN init-object IN THIS-PROCEDURE (
      517                INPUT  'str/b-pumpnz.w':U ,
      518                INPUT  FRAME D-Dialog:HANDLE ,
      519                INPUT  'Layout = ':U ,
      520                OUTPUT h_b-pumpnz ).
      521          RUN set-position IN h_b-pumpnz ( 3.96 , 14.75 ) NO-ERROR.
      522          RUN set-size IN h_b-pumpnz ( 10.54 , 46.25 ) NO-ERROR.
      523       END.
      524       WHEN 4 THEN DO:
      525          RUN init-object IN THIS-PROCEDURE (
      526                INPUT  'str/b-pump.w':U ,
      527                INPUT  FRAME D-Dialog:HANDLE ,
      528                INPUT  'Layout = ':U ,
      529                OUTPUT h_b-pump ).
      530          RUN set-position IN h_b-pump ( 3.88 , 14.88 ) NO-ERROR.
      531          RUN set-size IN h_b-pump ( 10.54 , 46.25 ) NO-ERROR.
      532       END.
      533       WHEN 5 THEN DO:
      534          RUN init-object IN THIS-PROCEDURE (
      535                INPUT  'str/b-nozzle.w':U ,
      536                INPUT  FRAME D-Dialog:HANDLE ,
      537                INPUT  'Layout = ':U ,
      538                OUTPUT h_b-nozzle ).
      539          RUN set-position IN h_b-nozzle ( 4.04 , 14.63 ) NO-ERROR.
      540          RUN set-size IN h_b-nozzle ( 10.54 , 46.25 ) NO-ERROR.
      541       END.
      542     END CASE.
      543     IF adm-current-page eq 0
      544     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
      545   END PROCEDURE.
      546   PROCEDURE adm-row-available :
      547     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      548     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      549     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      550     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      551     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      552     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      553     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      554     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      555     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      556     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      557     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      558     IF adm-updating-record THEN RETURN.
      559     RUN get-attribute ('FIELDS-ENABLED':U).
      560     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      561     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      562         OUTPUT link-handle) NO-ERROR.
      563     IF link-handle = "":U THEN
      564         RETURN.
      565     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      566     IF NUM-ENTRIES(link-handle) > 1 THEN
      567         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      568             "encountered more than one RECORD-SOURCE.":U SKIP
      569             "The first - ":U record-source-hdl:file-name " - will be used.":U
      570                VIEW-AS ALERT-BOX ERROR.
      571     RUN get-attribute ('Key-Name':U).
      572     key-name = RETURN-VALUE.
      573     IF key-name = "":U THEN key-name = ?.
      574     IF key-name NE ? THEN DO:
      575       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      576         NO-ERROR.
      577       IF key-value NE ? THEN
      578         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      579     END.
      580   IF VALID-HANDLE (adm-object-hdl) THEN
      581       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      582   RUN notify IN THIS-PROCEDURE ('row-available':U).
      583   END PROCEDURE.
      584   PROCEDURE disable_UI :
      585     HIDE FRAME D-Dialog.
      586   END PROCEDURE.
      587   PROCEDURE enable_UI :
      588     ENABLE b-exit b-help
      589         WITH FRAME D-Dialog.
      590     VIEW FRAME D-Dialog.
      591   END PROCEDURE.
      592   PROCEDURE send-records :
      593   END PROCEDURE.
      594   PROCEDURE state-changed :
      595     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      596     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      597   END PROCEDURE.
