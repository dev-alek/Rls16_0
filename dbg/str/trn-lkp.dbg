        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter t-rid         as recid  no-undo .
        4   define input  parameter parline-rec   as recid  no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: trn-lkp.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/trn-lkp.p $":U .
       10   define variable vss-description as character no-undo init "Ïğîñìîòğ ñêëàäñêîãî äîêóìåíòà".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#trdcalib as handle no-undo.
       71   define variable varnext-prev as logical no-undo.
       72   define variable br-handle    as handle  no-undo.
       73   define variable bf-handle    as handle  no-undo.
       74   define variable varvalue-oldsuppcntr as character no-undo .
       75   define variable vartype-oldsuppcntr  as character no-undo .
       76   do
       77   on error undo, return error return-value
       78   :
       79   define new shared buffer t-doc for ub.trn-doc.
       80     open query br-docs for each t-doc where recid (t-doc) = t-rid no-lock.
       81     get first br-docs .
       82     case t-doc.doc-type :
       83       when 'ïğè':U then do:
       84         if t-doc.internal = yes then do:
       85           run str/out-doc.w (input parparentproc, input-output t-rid, input 'ÏĞÎÑÌÎÒĞ':U, input ?, input 'ïğè':U, input yes, input-output varnext-prev, input t-doc.ext-doc-type, input ?, input-output parline-rec, input br-handle, input bf-handle, input t-doc.status_).
       86         end.
       87         else do:
       88           run str/in-doc.w  (input parparentproc, input-output t-rid, input 'ÏĞÎÑÌÎÒĞ':U, input 'èíâ':U, input no, input-output varnext-prev, input t-doc.ext-doc-type, input ?, input-output parline-rec, input br-handle , input bf-handle, input t-doc.status_).
       89         end.
       90       end.
       91       when 'ñïè':U or
       92       when 'âîçâğàò':U    or
       93       when 'ğàñ':U   then do:
       94         run str/out-doc.w (input parparentproc, input-output t-rid, input 'ÏĞÎÑÌÎÒĞ':U, input ?, input t-doc.doc-type, input t-doc.internal, input-output varnext-prev, input t-doc.ext-doc-type, input ?, input-output parline-rec, input br-handle, input bf-handle , input t-doc.status_).
       95       end.
       96       when 'èíâ':U then do:
       97         if t-doc.ext-doc-type = 'vt':U then do:
       98           run str/inv-doc.w (input parparentproc, input-output t-rid, input 'ÏĞÎÑÌÎÒĞ':U, input 'èíâ':U, input no, input-output varnext-prev, input ?, input ?, input-output parline-rec, input br-handle , input bf-handle) .
       99         end.
      100         else do:
      101           if t-doc.ext-doc-type = 'vp':U then do:
      102   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
      103                           input 'olsuppcntr':U ,
      104                          output varvalue-oldsuppcntr ,
      105                          output vartype-oldsuppcntr ) no-error .
      106              run str/peresort.w
      107                     (input        parparentproc,
      108                     input-output t-rid,
      109                     input        'ÏĞÎÑÌÎÒĞ':U,
      110                     input        'vp':U,
      111                     input-output varnext-prev,
      112                     input-output parline-rec,
      113                     input        br-handle,
      114                     input        bf-handle,
      115                     input        t-doc.obj-type,
      116                     input        t-doc.obj-code,
      117                     input        t-doc.cli-type,
      118                     input        t-doc.cli-code,
      119                     input        (if varvalue-oldsuppcntr = "yes":u then yes else no),
      120                     input        t-doc.contract-code    ) .
      121           end.
      122           else do:
      123             run str/corparts.w (input parparentproc, input-output t-rid, input 'ÏĞÎÑÌÎÒĞ':U, input t-doc.ext-doc-type, input ?, input-output varnext-prev, input-output parline-rec, input br-handle , input bf-handle).
      124           end.
      125         end.
      126       end.
      127     end.
      128   end.
