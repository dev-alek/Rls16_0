        1   DEFINE NEW SHARED BUFFER buf_c-price-doc FOR ub.c-price-doc.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define input parameter p-host-code AS integer no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define   shared variable g#auto as logical no-undo.
      116   define   shared variable g#news as logical no-undo.
      117   define   shared variable g#oxml as logical no-undo.
      118   define   shared variable g#esys as logical no-undo.
      119   define   shared variable g#news-source-db as integer no-undo.
      120   define   shared variable g#esys-source-esys as integer no-undo.
      121   define   shared variable g#db-num as integer   no-undo .
      122   define   shared variable g#userid as character no-undo .
      123   define   shared variable g#passwd as character no-undo .
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      376   procedure fltopend_fltopend :
      377   define input parameter p-parent-handle as handle no-undo .
      378   define input parameter p-qh as handle no-undo .
      379   define input parameter p-flt-open-open-query  as character no-undo .
      380   define input parameter p-where-cond as character no-undo .
      381   define input parameter p-use-indFIRST-query-tail as character no-undo .
      382   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      383   define input parameter p-indexed-reposition as character no-undo .
      384     do
      385     on error undo, return error
      386     :
      387   define variable v-prepare-string as character no-undo .
      388   define variable glog as logical no-undo .
      389   assign
      390   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      391                      p-where-cond + chr(32)  +
      392                      p-use-indFIRST-query-tail + chr(32) +
      393                      p-use-ind-sort-clmn-by + chr(32) +
      394                      p-indexed-reposition
      395   .
      396   assign
      397   glog = p-qh:query-prepare(v-prepare-string) no-error .
      398   if not glog
      399   or error-status:error then do:
      400     message error-status:get-message(1) view-as alert-box .
      401     undo, return error .
      402   end.
      403   assign
      404   glog = p-qh:query-open no-error .
      405   if not glog
      406   or error-status:error then do:
      407     message error-status:get-message(1) view-as alert-box .
      408     undo, return error .
      409   end.
      410     end.
      411   end procedure.
      412   procedure fltopend_fltfindd :
      413   define input parameter p-parent-handle as handle no-undo .
      414   define input parameter p-qh as handle no-undo .
      415   define input parameter p-rowid as rowid no-undo .
      416   define input parameter p-next as logical no-undo .
      417   define input parameter p-lock as integer no-undo .
      418   define input parameter p-bh as handle no-undo .
      419   define input parameter p-where-cond as character no-undo .
      420   define input parameter p-use-index-phrase as character no-undo .
      421   define variable glog as logical no-undo .
      422   define variable v-qh as handle no-undo .
      423   define variable v-bh as handle no-undo .
      424   define variable v-recid as recid no-undo .
      425   define variable v-prepare-string as character no-undo .
      426   do
      427   on error undo, return error
      428   on stop undo, return error
      429   :
      430     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      431     create buffer v-bh for table p-bh buffer-name p-bh:name.
      432     create query v-qh.
      433     v-qh:set-buffers(v-bh).
      434     v-prepare-string = substitute("for each &1 &2 &3"
      435                                     ,v-bh:name
      436                                     ,p-where-cond
      437                                     ,p-use-index-phrase).
      438     glog = v-qh:query-prepare(v-prepare-string) no-error.
      439     if not glog then do:
      440       delete object v-qh.
      441       delete object v-bh.
      442       undo, return error .
      443     end.
      444     glog = v-qh:query-open no-error .
      445     if not glog then do:
      446       delete object v-qh.
      447       delete object v-bh.
      448       undo, return error .
      449     end.
      450     if p-next then do:
      451       v-qh:reposition-to-rowid(p-rowid) no-error .
      452       glog = v-qh:get-next( p-lock) no-error .
      453       glog = v-qh:get-next( p-lock) no-error .
      454       if not glog or v-qh:query-off-end = yes then do:
      455         glog = v-qh:get-first( p-lock) no-error .
      456       end.
      457     end.
      458     else do:
      459       glog = v-qh:get-first( p-lock) no-error .
      460     end.
      461     v-recid = v-bh:recid no-error .
      462     delete object v-qh.
      463     delete object v-bh.
      464     return string(v-recid) .
      465   end.
      466   end procedure.
      467   procedure fltopend_fltfindq :
      468   define input parameter p-parent-handle as handle no-undo .
      469   define input parameter p-qh as handle no-undo .
      470   define input parameter p-next as logical no-undo .
      471   define input parameter p-lock as integer no-undo .
      472   define input parameter p-flt-open-open-query  as character no-undo .
      473   define input parameter p-where-cond as character no-undo .
      474   define input parameter p-use-indFIRST-query-tail as character no-undo .
      475   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      476   define input parameter p-indexed-reposition as character no-undo .
      477   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      478   define variable glog as logical no-undo .
      479   define variable v-qh as handle no-undo .
      480   define variable v-bh as handle no-undo extent 18.
      481   define variable v-rowid as rowid no-undo extent 18.
      482   define variable v-ii as integer no-undo .
      483   define variable v-prepare-string as character no-undo .
      484   do
      485   on error undo, return error
      486   on stop undo, return error
      487   :
      488     create query v-qh.
      489     do v-ii = 1 to p-qh:num-buffers:
      490       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      491       assign
      492       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      493       no-error.
      494       v-qh:add-buffer(v-bh[v-ii]).
      495     end.
      496     assign
      497     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      498                       p-where-cond + chr(32)  +
      499                       p-use-indFIRST-query-tail + chr(32) +
      500                       p-use-ind-sort-clmn-by + chr(32) +
      501                       p-indexed-reposition
      502     .
      503     glog = v-qh:query-prepare( v-prepare-string) no-error .
      504     if not glog then do:
      505       delete object v-qh.
      506       do v-ii = 1 to p-qh:num-buffers:
      507         delete object v-bh[v-ii].
      508       end.
      509       undo, return error .
      510     end.
      511     glog = v-qh:query-open no-error .
      512     if not glog then do:
      513       delete object v-qh.
      514       do v-ii = 1 to p-qh:num-buffers:
      515         delete object v-bh[v-ii].
      516       end.
      517       undo, return error .
      518     end.
      519     if p-next then do:
      520       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      521       glog = v-qh:get-next( p-lock) no-error .
      522       glog = v-qh:get-next( p-lock) no-error .
      523       if not glog or v-qh:query-off-end = yes then do:
      524         glog = v-qh:get-first( p-lock) no-error .
      525       end.
      526     end.
      527     else do:
      528       glog = v-qh:get-first( p-lock) no-error .
      529     end.
      530     do v-ii = 1 to p-qh:num-buffers:
      531       assign
      532       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      533       no-error.
      534     end.
      535     delete object v-qh.
      536     do v-ii = 1 to p-qh:num-buffers:
      537       delete object v-bh[v-ii].
      538     end.
      539   end.
      540   end procedure.
      541   define variable sort-column-name as character no-undo .
      542   define variable filter-point as character no-undo init "Список удаленных переоценок" .
      543   define variable filter-point0 as character no-undo init "Список_удаленных_переоценок" .
      544   define variable p-open-query     as logical   no-undo .
      545   define variable l-query-was-opened as logical no-undo init true .
      546   define variable doc-rec as recid no-undo .
      547   define variable p-find-next      as logical   no-undo .
      548   define variable p-find-condition as character no-undo .
      549   DEFINE BUTTON B-Cancel AUTO-END-KEY
      550        LABEL "Вы&ход"
      551        SIZE 10 BY 1
      552        BGCOLOR 8 .
      553   DEFINE BUTTON B-Help
      554        LABEL "Помо&щь"
      555        SIZE 10 BY 1
      556        BGCOLOR 8 .
      557   DEFINE BUTTON B-History
      558        LABEL "&История"
      559        SIZE 10 BY 1
      560        BGCOLOR 8 .
      561   DEFINE new shared QUERY br-ovr FOR
      562         buf_c-price-doc SCROLLING.
      563   DEFINE BROWSE br-ovr
      564     QUERY br-ovr NO-LOCK DISPLAY
      565         buf_c-price-doc.doc-num   COLUMN-LABEL  '№ Переоценки'    FORMAT "X(14)":U
      566     buf_c-price-doc.status_   COLUMN-LABEL  'Статус'    FORMAT "X(8)":U
      567     buf_c-price-doc.doc-date   COLUMN-LABEL  'Дата!док.'    FORMAT "99/99/99":U
      568     buf_c-price-doc.fact-date   COLUMN-LABEL  'Факт'    FORMAT "99/99/99":U
      569     buf_c-price-doc.host-code   COLUMN-LABEL  'Фирма'    FORMAT "99999":U
      570     buf_c-price-doc.obj-type   COLUMN-LABEL  'Тип'    FORMAT "X(3)":U
      571     buf_c-price-doc.obj-code   COLUMN-LABEL  'Код'    FORMAT "99999":U
      572     buf_c-price-doc.out-code   COLUMN-LABEL  'ПН'    FORMAT "X(14)":U
      573     buf_c-price-doc.corr-date   COLUMN-LABEL  'Дата посл.!корр.'    FORMAT "99/99/99":U
      574     buf_c-price-doc.corr-doc-code  COLUMN-LABEL  'Номер !док.корр.'   FORMAT "X(14)":U
      575     buf_c-price-doc.corr-man  COLUMN-LABEL  'Удалил'   FORMAT "X(8)":U
      576     buf_c-price-doc.creid  COLUMN-LABEL  'Создал'   FORMAT "X(8)":U
      577     buf_c-price-doc.is-corr  COLUMN-LABEL  'Корр.в!статусе АКТ'   FORMAT "yes/no":U
      578     buf_c-price-doc.is-del-act  COLUMN-LABEL  'Удален в !статусе АКТ'   FORMAT "yes/no":U
      579     ENABLE
      580         buf_c-price-doc.doc-num
      581       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.25 BY 17.25 EXPANDABLE.
      582   DEFINE FRAME Dialog-Frame
      583        B-Cancel AT ROW 1 COL 1
      584        B-History AT ROW 1 COL 11
      585        B-Help AT ROW 1 COL 89
      586        br-ovr AT ROW 2 COL 1
      587        ub.buf_c-price-doc.PS AT ROW 19.5 COL 1 NO-LABEL
      588             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      589             SIZE 97.5 BY 3.25
      590        SPACE(0.75) SKIP(0.04)
      591       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      592            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      593            TITLE "Удаленные переоценки"
      594            CANCEL-BUTTON B-Cancel.
      595   ASSIGN
      596          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      597          FRAME Dialog-Frame:HIDDEN           = TRUE.
      598   ASSIGN
      599          br-ovr:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      600   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      601   DO:
      602     APPLY "END-ERROR":U TO SELF.
      603   END.
      604   ON CHOOSE OF B-History IN FRAME Dialog-Frame
      605   DO:
      606     run str/pr-cdoc.w (parParentProc , buf_c-price-doc.host-code,  buf_c-price-doc.doc-num) .
      607   END.
      608   ON VALUE-CHANGED OF br-ovr IN FRAME Dialog-Frame
      609   DO:
      610     DISPLAY buf_c-price-doc.PS WITH FRAME Dialog-Frame.
      611   END.
      612   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      613   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      614   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   on help of frame Dialog-Frame
      616   do:
      617     run gbl/app_help.p
      618       (input this-procedure :file-name
      619       ,input ''
      620       ,input ?
      621       ) no-error.
      622     if error-status :error then do:
      623       message
      624         "Ошибка при вызове помощи"
      625         error-status :get-message(1)
      626         view-as alert-box .
      627     end.
      628   end.
      629   run minbtn-set in this-procedure .
      630   on choose of b-help in frame Dialog-Frame
      631   do:
      632     apply "help":u to frame Dialog-Frame .
      633   end.
      634   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure minbtn-set :
      636       do
      637           on error undo, return error return-value
      638           :
      639           define variable ii              as integer       no-undo .
      640           define variable fh              as widget-handle no-undo .
      641           define variable hh              as widget-handle no-undo .
      642           define variable v-h             as handle        extent 4 no-undo .
      643           define variable v-name-button   as character     no-undo .
      644           define variable v-help-old-x    as decimal       no-undo .
      645           define variable v-help-old-y    as decimal       no-undo .
      646           define variable v-help-old-size as decimal       no-undo .
      647           define variable v-frame-width   as decimal       no-undo .
      648           define variable jj              as integer       no-undo .
      649           do
      650               on error undo, return error
      651               :
      652               assign
      653                   v-frame-width = frame Dialog-Frame:width - 0.3
      654                   fh            = frame Dialog-Frame:first-child
      655                   hh            = fh:first-child
      656                   ii            = 1
      657                   .
      658               do while valid-handle(hh):
      659                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      660                   do:
      661                       case lc(hh:name) :
      662                           when "b-help" then
      663                               do:
      664                                   hh:load-image-up("cmp/b-help.bmp":u) .
      665                                   hh:load-image-down("cmp/b-help.bmp":u) .
      666                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      667                                   hh:TOOLTIP = "Помощь" .
      668                                   v-help-old-x = hh:column .
      669                                   v-help-old-y = hh:row    .
      670                                   v-help-old-size = hh:width .
      671                                   hh:width-chars = 2.5 .
      672                               end.
      673                           when "b-print" then
      674                               do:
      675                                   hh:load-image("cmp/b-print.bmp":u) .
      676                                   hh:TOOLTIP = "Печать" .
      677                                   v-h[ii] = hh:handle .
      678                                   ii = ii + 1 .
      679                                   hh:width-chars = 3 .
      680                               end.
      681                           when "b-history" or
      682                           when "b-hist" then
      683                               do:
      684                                   hh:load-image("cmp/b-hist.bmp":u) .
      685                                   hh:TOOLTIP = "История" .
      686                                   v-h[ii] = hh:handle .
      687                                   ii = ii + 1 .
      688                                   hh:width-chars = 3 .
      689                               end.
      690                           when "b-sch" then
      691                               do:
      692                                   hh:load-image("cmp/b-sch.bmp":u) .
      693                                   hh:TOOLTIP = "Установка Фильтра" .
      694                                   v-h[ii] = hh:handle .
      695                                   ii = ii + 1 .
      696                                   hh:width-chars = 3 .
      697                               end.
      698                           when "b-hist-user" then
      699                               do:
      700                                   hh:load-image("cmp/b-hist.bmp":u) .
      701                                   hh:TOOLTIP = "История пользователя" .
      702                                   ii = ii + 1 .
      703                               end.
      704                       end case.
      705                   end.
      706                   hh = hh:next-sibling.
      707               end.
      708               b-help:column = v-frame-width - b-help:width-chars.
      709               jj = 0.
      710               repeat ii = 4 to 1 by -1 :
      711                   if valid-handle (v-h[ii] ) then
      712                   do:
      713                       jj  = jj + 1 .
      714                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      715                       v-h[ii]:row    = v-help-old-y .
      716                   end.
      717               end.
      718           end.
      719       end.
      720   end procedure.
      721   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      722   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      723   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      724   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      725   define variable v-diasize-current-frame-width  as decimal   no-undo .
      726   define variable v-diasize-current-frame-height as decimal   no-undo .
      727   define variable v-diasize-change-size          as logical   no-undo .
      728   define variable v-diasize-resize-button        as handle    no-undo .
      729   define variable v-diasize-wndmax               as logical   no-undo .
      730   define variable v-diasize-wndstore             as logical   no-undo .
      731   define variable v-diasize-proc-name            as character no-undo .
      732   define variable v-diasize-browse-handle        as handle    no-undo .
      733   define variable v-diasize-browse-number        as integer   no-undo .
      734   define variable v-diasize-need-full-display    as logical   no-undo init false .
      735   define temp-table temp-diasize-handle no-undo
      736     field handle-value  as handle
      737     field save-position as decimal
      738     index xpk is primary unique handle-value
      739     .
      740   define temp-table temp-browse-handle no-undo
      741     field browse-type   as character
      742     field browse-number as integer
      743     field browse-handle as handle
      744     field original-size as decimal
      745     index xpk is primary unique browse-type browse-number
      746     index xie browse-type browse-handle
      747   .
      748   procedure diasize_change-height :
      749     define input  parameter p-change-value  as decimal   no-undo .
      750     define input  parameter p-move-resize   as logical   no-undo .
      751     define variable v-field-group-handle    as handle    no-undo .
      752     define variable v-object-handle         as handle    no-undo .
      753     define variable v-frame-height          as decimal   no-undo .
      754     define variable v-frame-virtual-height  as decimal   no-undo .
      755     define variable v-browse-height         as decimal   no-undo .
      756     define variable v-window-height         as decimal   no-undo .
      757     define variable v-window-virtual-height as decimal   no-undo .
      758     define variable v-change-sign           as integer   no-undo .
      759     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      760     define buffer buf_temp-browse-handle  for temp-browse-handle .
      761     if p-change-value > 0
      762     then do:
      763       if frame Dialog-Frame :height + p-change-value
      764           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      765       then do:
      766         assign
      767           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      768                           - (frame Dialog-Frame :height-chars)
      769         .
      770         if p-change-value <= 0
      771         then do:
      772           run diasize_position-resize-button in this-procedure .
      773           return .
      774         end.
      775       end.
      776     end.
      777     if p-change-value < 0
      778     then do:
      779       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      780       then do:
      781         assign
      782           p-change-value = v-diasize-orig-frame-height
      783                          - (frame Dialog-Frame :height-chars)
      784         .
      785         if p-change-value >= 0
      786         then do:
      787           run diasize_position-resize-button in this-procedure .
      788           return .
      789         end.
      790       end.
      791     end.
      792     if p-change-value >= 0
      793     then do:
      794       assign
      795         v-change-sign = 1
      796       .
      797     end.
      798     else do:
      799       assign
      800         v-change-sign = -1
      801       .
      802     end.
      803     assign
      804       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      805     .
      806     if p-change-value = 0
      807     then do:
      808       run diasize_position-resize-button in this-procedure .
      809       return .
      810     end.
      811     move_block:
      812     do
      813     on error undo move_block, retry move_block
      814     :
      815       if retry
      816       then do:
      817         do
      818         on error undo move_block, leave move_block
      819         :
      820           if p-change-value > 0
      821           then do:
      822             for each buf_temp-diasize-handle
      823             on error undo, next
      824             :
      825               assign
      826                 v-object-handle = buf_temp-diasize-handle.handle-value
      827               .
      828               if v-object-handle <> v-diasize-resize-button
      829               then do:
      830                 assign
      831                   v-object-handle :row = buf_temp-diasize-handle.save-position
      832                 .
      833               end.
      834             end.
      835             assign
      836               v-diasize-browse-handle :height = v-browse-height
      837             .
      838             for each buf_temp-browse-handle
      839               where buf_temp-browse-handle.browse-type = 'height':u
      840             on error undo, next
      841             :
      842               assign
      843                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      844               .
      845             end.
      846             assign
      847               frame Dialog-Frame :height = v-frame-height
      848             .
      849             if frame Dialog-Frame :scrollable = true
      850             then do:
      851               assign
      852                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      853               .
      854             end.
      855             run diasize_position-resize-button in this-procedure .
      856           end.
      857           else do:
      858             if frame Dialog-Frame :scrollable = true
      859             then do:
      860               assign
      861                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      862               .
      863             end.
      864             assign
      865               frame Dialog-Frame :height = v-frame-height
      866             .
      867             assign
      868               v-diasize-browse-handle :height = v-browse-height
      869             .
      870             for each buf_temp-browse-handle
      871               where buf_temp-browse-handle.browse-type = 'height':u
      872             on error undo, next
      873             :
      874               assign
      875                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      876               .
      877             end.
      878             for each buf_temp-diasize-handle
      879             on error undo, next
      880             :
      881               assign
      882                 v-object-handle = buf_temp-diasize-handle.handle-value
      883               .
      884               if v-object-handle <> v-diasize-resize-button
      885               then do:
      886                 assign
      887                   v-object-handle :row = buf_temp-diasize-handle.save-position
      888                 .
      889               end.
      890             end.
      891             run diasize_position-resize-button in this-procedure .
      892           end.
      893           assign
      894             v-diasize-change-size = false
      895           .
      896           leave move_block .
      897         end.
      898       end.
      899       assign
      900         v-diasize-need-full-display = true
      901       .
      902       if v-diasize-change-size = false
      903       then do:
      904         assign
      905           v-diasize-change-size = true
      906         .
      907       end.
      908       else do:
      909         return .
      910       end.
      911       assign
      912         v-frame-height = frame Dialog-Frame :height
      913         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      914         v-browse-height = v-diasize-browse-handle :height
      915       .
      916       for each buf_temp-browse-handle
      917         where buf_temp-browse-handle.browse-type = 'height':u
      918       :
      919         assign
      920           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      921         .
      922       end.
      923       for each buf_temp-diasize-handle
      924       :
      925         delete buf_temp-diasize-handle .
      926       end.
      927       assign
      928         v-field-group-handle = frame Dialog-Frame :first-child
      929       .
      930       do while valid-handle(v-field-group-handle)
      931       :
      932         assign
      933           v-object-handle = v-field-group-handle :first-child
      934         .
      935         do while valid-handle(v-object-handle)
      936         :
      937           if  v-object-handle <> v-diasize-browse-handle :handle
      938           and can-query(v-object-handle, "row")
      939           and can-query(v-object-handle, "height")
      940           and ( v-object-handle :row > v-diasize-browse-handle :row )
      941           then do:
      942             find first buf_temp-browse-handle
      943               where buf_temp-browse-handle.browse-type   = 'height':u
      944                 and buf_temp-browse-handle.browse-handle = v-object-handle
      945               no-error .
      946             if available buf_temp-browse-handle
      947             then do:
      948             end.
      949             else do:
      950               create buf_temp-diasize-handle .
      951               assign
      952                 buf_temp-diasize-handle.handle-value  = v-object-handle
      953                 buf_temp-diasize-handle.save-position = v-object-handle :row
      954               .
      955             end.
      956           end.
      957           assign
      958             v-object-handle = v-object-handle :next-sibling
      959           .
      960         end.
      961         assign
      962           v-field-group-handle = v-field-group-handle :next-sibling
      963         .
      964       end.
      965       do with frame Dialog-Frame
      966       :
      967         hide v-diasize-resize-button .
      968         assign
      969           v-diasize-resize-button :row    = 1
      970           v-diasize-resize-button :column = 1
      971         .
      972       end.
      973       if p-change-value > 0
      974       then do:
      975         if frame Dialog-Frame :scrollable = true
      976         then do:
      977           assign
      978             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      979             no-error .
      980           if error-status :error
      981           or error-status :get-message(1) <> ""
      982           then do:
      983             undo move_block, retry move_block .
      984           end.
      985         end.
      986         assign
      987           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      988           no-error .
      989         if error-status :error
      990         or error-status :get-message(1) <> ""
      991         then do:
      992           undo move_block, retry move_block .
      993         end.
      994         assign
      995           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      996           no-error .
      997         if error-status :error
      998         or error-status :get-message(1) <> ""
      999         then do:
     1000           undo move_block, retry move_block .
     1001         end.
     1002         for each buf_temp-browse-handle
     1003           where buf_temp-browse-handle.browse-type = 'height':u
     1004         on error undo move_block, retry move_block
     1005         :
     1006           assign
     1007             buf_temp-browse-handle.browse-handle :height
     1008               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1009             no-error .
     1010           if error-status :error
     1011           or error-status :get-message(1) <> ""
     1012           then do:
     1013             undo move_block, retry move_block .
     1014           end.
     1015         end.
     1016         for each buf_temp-diasize-handle
     1017         on error undo move_block, retry move_block
     1018         :
     1019           assign
     1020             v-object-handle = buf_temp-diasize-handle.handle-value
     1021           .
     1022           if v-object-handle <> v-diasize-resize-button
     1023           then do:
     1024             assign
     1025               v-object-handle :row = v-object-handle :row + p-change-value
     1026               no-error .
     1027             if error-status :error
     1028             or error-status :get-message(1) <> ""
     1029             then do:
     1030               undo move_block, retry move_block .
     1031             end.
     1032           end.
     1033         end.
     1034       end.
     1035       else do:
     1036         for each buf_temp-diasize-handle
     1037         on error undo move_block, retry move_block
     1038         :
     1039           assign
     1040             v-object-handle = buf_temp-diasize-handle.handle-value
     1041           .
     1042           if v-object-handle <> v-diasize-resize-button
     1043           then do:
     1044             assign
     1045               v-object-handle :row = v-object-handle :row + p-change-value
     1046               no-error .
     1047             if error-status :error
     1048             or error-status :get-message(1) <> ""
     1049             then do:
     1050               undo move_block, retry move_block .
     1051             end.
     1052           end.
     1053         end.
     1054         assign
     1055           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1056           no-error .
     1057         if error-status :error
     1058         or error-status :get-message(1) <> ""
     1059         then do:
     1060           undo move_block, retry move_block .
     1061         end.
     1062         for each buf_temp-browse-handle
     1063           where buf_temp-browse-handle.browse-type = 'height':u
     1064         on error undo move_block, retry move_block
     1065         :
     1066           assign
     1067             buf_temp-browse-handle.browse-handle :height
     1068               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1069             no-error .
     1070           if error-status :error
     1071           or error-status :get-message(1) <> ""
     1072           then do:
     1073             undo move_block, retry move_block .
     1074           end.
     1075         end.
     1076         assign
     1077           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1078           no-error .
     1079         if error-status :error
     1080         or error-status :get-message(1) <> ""
     1081         then do:
     1082           undo move_block, retry move_block .
     1083         end.
     1084         if frame Dialog-Frame :scrollable = true
     1085         then do:
     1086           assign
     1087             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1088             no-error .
     1089           if error-status :error
     1090           or error-status :get-message(1) <> ""
     1091           then do:
     1092             undo move_block, retry move_block .
     1093           end.
     1094         end.
     1095       end.
     1096       if p-move-resize = true
     1097       then do:
     1098         run diasize_position-resize-button in this-procedure .
     1099       end.
     1100       if v-diasize-wndstore = true
     1101       then do:
     1102         if connected("ub") = true
     1103         then do:
     1104           define variable v-cntxt-db-num        as integer   no-undo .
     1105           define variable v-cntxt-userid        as character no-undo .
     1106           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1107                                             , OUTPUT v-cntxt-userid
     1108                                             ) .
     1109           run gbl/wndsizew.p
     1110             (input  v-cntxt-db-num
     1111             ,input  v-cntxt-userid
     1112             ,input  v-diasize-proc-name
     1113             ,input  'height':u
     1114             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1115             ) .
     1116         end.
     1117       end.
     1118     end.
     1119     assign
     1120       v-diasize-change-size = false
     1121     .
     1122   end procedure.
     1123   procedure diasize_set-height :
     1124     define input  parameter p-new-height  as decimal   no-undo .
     1125     define input  parameter p-move-resize as logical   no-undo .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       run diasize_change-height in this-procedure
     1130         (input  (p-new-height - frame Dialog-Frame :height)
     1131         ,input  p-move-resize
     1132         ) .
     1133     end.
     1134   end procedure.
     1135   procedure diasize_change-width :
     1136     define input  parameter p-change-value as decimal   no-undo .
     1137     define input  parameter p-move-resize  as logical   no-undo .
     1138     define variable v-field-group-handle   as handle    no-undo .
     1139     define variable v-object-handle        as handle    no-undo .
     1140     define variable v-frame-width          as decimal   no-undo .
     1141     define variable v-frame-virtual-width  as decimal   no-undo .
     1142     define variable v-browse-width         as decimal   no-undo .
     1143     define variable v-window-width         as decimal   no-undo .
     1144     define variable v-window-virtual-width as decimal   no-undo .
     1145     define variable v-change-sign          as integer   no-undo .
     1146     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1147     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1148     if p-change-value > 0
     1149     then do:
     1150       if frame Dialog-Frame :width + p-change-value >
     1151           session :width-chars
     1152       then do:
     1153         assign
     1154           p-change-value = session :width-chars - frame Dialog-Frame :width
     1155         .
     1156         if p-change-value <= 0
     1157         then do:
     1158           run diasize_position-resize-button in this-procedure .
     1159           return .
     1160         end.
     1161       end.
     1162     end.
     1163     if p-change-value < 0
     1164     then do:
     1165       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1166       then do:
     1167         assign
     1168           p-change-value = v-diasize-orig-frame-width
     1169                          - frame Dialog-Frame :width
     1170         .
     1171         if p-change-value >= 0
     1172         then do:
     1173           run diasize_position-resize-button in this-procedure .
     1174           return .
     1175         end.
     1176       end.
     1177     end.
     1178     if p-change-value >= 0
     1179     then do:
     1180       assign
     1181         v-change-sign = 1
     1182       .
     1183     end.
     1184     else do:
     1185       assign
     1186         v-change-sign = -1
     1187       .
     1188     end.
     1189     assign
     1190       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1191     .
     1192     if p-change-value = 0
     1193     then do:
     1194       run diasize_position-resize-button in this-procedure .
     1195       return .
     1196     end.
     1197     move_block:
     1198     do
     1199     on error undo move_block, leave move_block
     1200     :
     1201       if retry
     1202       then do:
     1203         do
     1204         on error undo move_block, leave move_block
     1205         :
     1206           if p-change-value > 0
     1207           then do:
     1208             for each buf_temp-diasize-handle
     1209             on error undo, next
     1210             :
     1211               assign
     1212                 v-object-handle = buf_temp-diasize-handle.handle-value
     1213               .
     1214               if v-object-handle <> v-diasize-resize-button
     1215               then do:
     1216                 assign
     1217                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1218                 .
     1219               end.
     1220             end.
     1221             assign
     1222               v-diasize-browse-handle :width = v-browse-width
     1223             .
     1224             for each buf_temp-browse-handle
     1225               where buf_temp-browse-handle.browse-type = 'width':u
     1226             on error undo, next
     1227             :
     1228               assign
     1229                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1230               .
     1231             end.
     1232             assign
     1233               frame Dialog-Frame :width = v-frame-width
     1234             .
     1235             if frame Dialog-Frame :scrollable = true
     1236             then do:
     1237               assign
     1238                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1239               .
     1240             end.
     1241             run diasize_position-resize-button in this-procedure .
     1242           end.
     1243           else do:
     1244             if frame Dialog-Frame :scrollable = true
     1245             then do:
     1246               assign
     1247                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1248               .
     1249             end.
     1250             assign
     1251               frame Dialog-Frame :width = v-frame-width
     1252             .
     1253             for each buf_temp-browse-handle
     1254               where buf_temp-browse-handle.browse-type = 'width':u
     1255             on error undo, next
     1256             :
     1257               assign
     1258                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1259               .
     1260             end.
     1261             assign
     1262               v-diasize-browse-handle :width = v-browse-width
     1263             .
     1264             for each buf_temp-diasize-handle
     1265             on error undo, next
     1266             :
     1267               assign
     1268                 v-object-handle = buf_temp-diasize-handle.handle-value
     1269               .
     1270               if v-object-handle <> v-diasize-resize-button
     1271               then do:
     1272                 assign
     1273                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1274                 .
     1275               end.
     1276             end.
     1277             run diasize_position-resize-button in this-procedure .
     1278           end.
     1279           assign
     1280             v-diasize-change-size = false
     1281           .
     1282           leave move_block .
     1283         end.
     1284       end.
     1285       assign
     1286         v-diasize-need-full-display = true
     1287       .
     1288       if v-diasize-change-size = false
     1289       then do:
     1290         assign
     1291           v-diasize-change-size = true
     1292         .
     1293       end.
     1294       else do:
     1295         return .
     1296       end.
     1297       assign
     1298         v-frame-width = frame Dialog-Frame :width
     1299         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1300         v-browse-width = v-diasize-browse-handle :width
     1301       .
     1302       for each buf_temp-browse-handle
     1303         where buf_temp-browse-handle.browse-type = 'width':u
     1304       :
     1305         assign
     1306           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1307         .
     1308       end.
     1309       for each buf_temp-diasize-handle
     1310       :
     1311         delete buf_temp-diasize-handle .
     1312       end.
     1313       assign
     1314         v-field-group-handle = frame Dialog-Frame :first-child
     1315       .
     1316       do while valid-handle(v-field-group-handle)
     1317       :
     1318         assign
     1319           v-object-handle = v-field-group-handle :first-child
     1320         .
     1321         do while valid-handle(v-object-handle)
     1322         :
     1323           if  v-object-handle <> v-diasize-browse-handle :handle
     1324           and v-object-handle <> v-diasize-resize-button
     1325           and can-query(v-object-handle, "row")
     1326           and can-query(v-object-handle, "height")
     1327           and ( v-object-handle :col + v-object-handle :width
     1328                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1329               )
     1330           then do:
     1331             find first buf_temp-browse-handle
     1332               where buf_temp-browse-handle.browse-type   = 'width':u
     1333                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1334               no-error .
     1335             if available buf_temp-browse-handle
     1336             then do:
     1337             end.
     1338             else do:
     1339               create buf_temp-diasize-handle .
     1340               assign
     1341                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1342                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1343               .
     1344             end.
     1345           end.
     1346           assign
     1347             v-object-handle = v-object-handle :next-sibling
     1348           .
     1349         end.
     1350         assign
     1351           v-field-group-handle = v-field-group-handle :next-sibling
     1352         .
     1353       end.
     1354       do with frame Dialog-Frame
     1355       :
     1356         hide v-diasize-resize-button .
     1357         v-diasize-resize-button :row = 1.
     1358         v-diasize-resize-button :column = 1.
     1359       end.
     1360       if p-change-value > 0
     1361       then do:
     1362         if frame Dialog-Frame :scrollable = true
     1363         then do:
     1364           assign
     1365             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1366             no-error .
     1367           if error-status :error
     1368           or error-status :get-message(1) <> ""
     1369           then do:
     1370             undo move_block, retry move_block.
     1371           end.
     1372         end.
     1373         assign
     1374           frame Dialog-Frame :width = v-frame-width + p-change-value
     1375           no-error .
     1376         if error-status :error
     1377         or error-status :get-message(1) <> ""
     1378         then do:
     1379           undo move_block, retry move_block.
     1380         end.
     1381         assign
     1382           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1383         no-error .
     1384         if error-status :error
     1385         or error-status :get-message(1) <> ""
     1386         then do:
     1387           undo move_block, retry move_block.
     1388         end.
     1389         for each buf_temp-browse-handle
     1390           where buf_temp-browse-handle.browse-type = 'width':u
     1391         on error undo move_block, retry move_block
     1392         :
     1393           assign
     1394             buf_temp-browse-handle.browse-handle :width
     1395               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1396             no-error .
     1397           if error-status :error
     1398           or error-status :get-message(1) <> ""
     1399           then do:
     1400             undo move_block, retry move_block .
     1401           end.
     1402         end.
     1403         for each buf_temp-diasize-handle
     1404         on error undo move_block, retry move_block
     1405         :
     1406           assign
     1407             v-object-handle = buf_temp-diasize-handle.handle-value
     1408           .
     1409           if v-object-handle <> v-diasize-resize-button
     1410           then do:
     1411             assign
     1412               v-object-handle :col = v-object-handle :col + p-change-value
     1413               no-error .
     1414             if error-status :error
     1415             or error-status :get-message(1) <> ""
     1416             then do:
     1417               undo move_block, retry move_block .
     1418             end.
     1419           end.
     1420         end.
     1421       end.
     1422       else do:
     1423         for each buf_temp-diasize-handle
     1424         on error undo move_block, retry move_block
     1425         :
     1426           assign
     1427             v-object-handle = buf_temp-diasize-handle.handle-value
     1428           .
     1429           if v-object-handle <> v-diasize-resize-button
     1430           then do:
     1431             assign
     1432               v-object-handle :col = v-object-handle :col + p-change-value
     1433               no-error .
     1434             if error-status :error
     1435             or error-status :get-message(1) <> ""
     1436             then do:
     1437               undo move_block, retry move_block .
     1438             end.
     1439           end.
     1440         end.
     1441         for each buf_temp-browse-handle
     1442           where buf_temp-browse-handle.browse-type = 'width':u
     1443         on error undo move_block, retry move_block
     1444         :
     1445           assign
     1446             buf_temp-browse-handle.browse-handle :width
     1447               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1448             no-error .
     1449           if error-status :error
     1450           or error-status :get-message(1) <> ""
     1451           then do:
     1452             undo move_block, retry move_block .
     1453           end.
     1454         end.
     1455         assign
     1456           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1457           no-error .
     1458         if error-status :error
     1459         or error-status :get-message(1) <> ""
     1460         then do:
     1461           undo move_block, retry move_block.
     1462         end.
     1463         assign
     1464           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1465         no-error .
     1466         if error-status :error
     1467         or error-status :get-message(1) <> ""
     1468         then do:
     1469           undo move_block, retry move_block.
     1470         end.
     1471         if frame Dialog-Frame :scrollable = true
     1472         then do:
     1473           assign
     1474             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1475           no-error .
     1476           if error-status :error
     1477           or error-status :get-message(1) <> ""
     1478           then do:
     1479             undo move_block, retry move_block.
     1480           end.
     1481         end.
     1482       end.
     1483       if p-move-resize
     1484       then do:
     1485         run diasize_position-resize-button in this-procedure .
     1486       end.
     1487       if v-diasize-wndstore = true
     1488       then do:
     1489         if connected("ub") = true
     1490         then do:
     1491           define variable v-cntxt-db-num        as integer   no-undo .
     1492           define variable v-cntxt-userid        as character no-undo .
     1493           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1494                                             , OUTPUT v-cntxt-userid
     1495                                             ) .
     1496           run gbl/wndsizew.p
     1497             (input  v-cntxt-db-num
     1498             ,input  v-cntxt-userid
     1499             ,input  v-diasize-proc-name
     1500             ,input  'width':u
     1501             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1502             ) .
     1503         end.
     1504       end.
     1505     end.
     1506     assign
     1507       v-diasize-change-size = false
     1508     .
     1509   end procedure.
     1510   procedure diasize_set-width :
     1511     define input  parameter p-new-width  as decimal   no-undo .
     1512     define input  parameter p-move-resize as logical   no-undo .
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       run diasize_change-width in this-procedure
     1517         (input  (p-new-width - frame Dialog-Frame :width)
     1518         ,input  p-move-resize
     1519         ) .
     1520     end.
     1521   end procedure.
     1522   procedure diasize_position-resize-button :
     1523     do with frame Dialog-Frame
     1524     :
     1525       hide v-diasize-resize-button .
     1526       assign
     1527         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1528                     - 1
     1529                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1530         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1531                     - 1
     1532                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1533       .
     1534       view v-diasize-resize-button .
     1535     end.
     1536   end procedure.
     1537   on alt-right anywhere
     1538   do:
     1539     run diasize_change-width in this-procedure
     1540       (input 1
     1541       ,input true
     1542       ) .
     1543     return no-apply .
     1544   end.
     1545   on alt-left anywhere
     1546   do:
     1547     run diasize_change-width in this-procedure
     1548       (input -1
     1549       ,input true
     1550       ) .
     1551     return no-apply .
     1552   end.
     1553   on alt-down anywhere
     1554   do:
     1555     run diasize_change-height in this-procedure
     1556       (input 1
     1557       ,input true
     1558       ) .
     1559     return no-apply .
     1560   end.
     1561   on alt-up anywhere
     1562   do:
     1563     run diasize_change-height in this-procedure
     1564       (input -1
     1565       ,input true
     1566       ) .
     1567     return no-apply .
     1568   end.
     1569   on alt-enter of frame Dialog-Frame
     1570   do:
     1571     run diasize_maximize in this-procedure
     1572       (input  ?
     1573       ).
     1574     return no-apply .
     1575   end.
     1576   procedure diasize_end-move :
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       define variable v-row-delta as decimal   no-undo .
     1581       define variable v-col-delta as decimal   no-undo .
     1582       define variable v-new-row as decimal   no-undo .
     1583       define variable v-new-col as decimal   no-undo .
     1584       assign
     1585         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1586         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1587       .
     1588       assign
     1589         v-row-delta = v-new-row - frame Dialog-Frame :height
     1590         v-col-delta = v-new-col - frame Dialog-Frame :width
     1591       .
     1592       run diasize_change-height in this-procedure
     1593         (input v-row-delta
     1594         ,input true
     1595         ) .
     1596       run diasize_change-width in this-procedure
     1597         (input v-col-delta
     1598         ,input true
     1599         ) .
     1600     end.
     1601   end procedure.
     1602   procedure diasize_maximize :
     1603     define input  parameter p-action as logical   no-undo .
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       if p-action = ?
     1608       then do:
     1609         if v-diasize-need-maximize = true
     1610         then do:
     1611           assign
     1612             p-action = true
     1613           .
     1614         end.
     1615         else do:
     1616           assign
     1617             p-action = false
     1618           .
     1619         end.
     1620       end.
     1621       if p-action = true
     1622       then do:
     1623         run diasize_change-height in this-procedure
     1624           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1625               - frame Dialog-Frame :height-chars
     1626           ,input true
     1627           ) .
     1628         run diasize_change-width in this-procedure
     1629           (input session :width-chars
     1630               - frame Dialog-Frame :width-chars
     1631           ,input true
     1632           ) .
     1633         assign
     1634           v-diasize-need-maximize = false
     1635         .
     1636       end.
     1637       else do:
     1638         run diasize_change-width in this-procedure
     1639           (input v-diasize-orig-frame-width
     1640               - frame Dialog-Frame :width-chars
     1641           ,input true
     1642           ) .
     1643         run diasize_change-height in this-procedure
     1644           (input v-diasize-orig-frame-height
     1645               - frame Dialog-Frame :height-chars
     1646           ,input true
     1647           ) .
     1648         assign
     1649           v-diasize-need-maximize = true
     1650         .
     1651       end.
     1652     end.
     1653   end procedure.
     1654   procedure diasize_restore-orig-size :
     1655     do
     1656     on error undo, return error return-value
     1657     :
     1658       assign
     1659         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1660         v-diasize-current-frame-height = frame Dialog-Frame :height
     1661       .
     1662       run diasize_set-height in this-procedure
     1663         (input  v-diasize-orig-frame-height
     1664         ,input  true
     1665         ) .
     1666       run diasize_set-width in this-procedure
     1667         (input  v-diasize-orig-frame-width
     1668         ,input  true
     1669         ) .
     1670     end.
     1671   end procedure.
     1672   procedure diasize_restore-current-size :
     1673     do
     1674     on error undo, return error return-value
     1675     :
     1676       run diasize_set-height in this-procedure
     1677         (input  v-diasize-current-frame-height
     1678         ,input  true
     1679         ) .
     1680       run diasize_set-width in this-procedure
     1681         (input  v-diasize-current-frame-width
     1682         ,input  true
     1683         ) .
     1684     end.
     1685   end procedure.
     1686   procedure diasize_set-browse-handle :
     1687     define input  parameter p-browse-handle as handle   no-undo .
     1688     define buffer buf_temp-browse-handle for temp-browse-handle .
     1689     do
     1690     on error undo, return error return-value
     1691     :
     1692       assign
     1693         v-diasize-browse-handle = p-browse-handle
     1694       .
     1695       for each buf_temp-browse-handle
     1696       on error undo, return error return-value
     1697       :
     1698         delete buf_temp-browse-handle .
     1699       end.
     1700     end.
     1701   end procedure.
     1702   procedure diasize_add_browse :
     1703     define input  parameter p-browse-type   as character no-undo .
     1704     define input  parameter p-browse-handle as handle    no-undo .
     1705     define buffer buf_temp-browse-handle for temp-browse-handle .
     1706     do
     1707     on error undo, return error return-value
     1708     :
     1709       assign
     1710         v-diasize-browse-number = v-diasize-browse-number + 1
     1711       .
     1712       create buf_temp-browse-handle .
     1713       assign
     1714         buf_temp-browse-handle.browse-type   = p-browse-type
     1715         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1716         buf_temp-browse-handle.browse-handle = p-browse-handle
     1717       .
     1718     end.
     1719   end procedure.
     1720   procedure diasize_init :
     1721     define variable v-default-value    as logical   no-undo .
     1722     define variable v-restore-saved    as logical   no-undo .
     1723     define variable v-resize-value-str as character no-undo .
     1724     do
     1725     on error undo, return error return-value
     1726     :
     1727       do with frame Dialog-Frame
     1728       :
     1729         assign
     1730           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1731           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1732           v-diasize-browse-handle     = browse br-ovr :handle
     1733         .
     1734         create button v-diasize-resize-button
     1735         assign
     1736           parent        = frame Dialog-Frame :first-child
     1737           label         = "s"
     1738           height-pixels = 16
     1739           width-pixels  = 16
     1740           visible       = true
     1741           sensitive     = true
     1742           movable       = true
     1743           triggers:
     1744             on end-move persistent run diasize_end-move in this-procedure .
     1745           end triggers.
     1746         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1747         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1748         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1749         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1750         assign
     1751           v-diasize-wndmax = false
     1752         .
     1753         if connected("ub") = true
     1754         then do:
     1755           define variable v-cntxt-db-num        as integer   no-undo .
     1756           define variable v-cntxt-userid        as character no-undo .
     1757           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1758                                             , OUTPUT v-cntxt-userid
     1759                                             ) .
     1760           run gbl/wndpar_r.p
     1761             (input  v-cntxt-db-num
     1762             ,input  v-cntxt-userid
     1763             ,input  'wndmax':U
     1764             ,output v-diasize-wndmax
     1765             ,output v-default-value
     1766             ) .
     1767         end.
     1768         assign
     1769           v-diasize-wndstore = false
     1770         .
     1771         if connected("ub") = true
     1772         then do:
     1773           run gbl/wndpar_r.p
     1774             (input  v-cntxt-db-num
     1775             ,input  v-cntxt-userid
     1776             ,input  'wndstore':U
     1777             ,output v-diasize-wndstore
     1778             ,output v-default-value
     1779             ) .
     1780         end.
     1781         assign
     1782           v-diasize-proc-name = entry(1, program-name(2), '.')
     1783         .
     1784         if v-diasize-wndstore = true
     1785         then do:
     1786           assign
     1787             v-restore-saved = false
     1788           .
     1789           if connected("ub") = true
     1790           then do:
     1791             run gbl/wndsizer.p
     1792               (input  v-cntxt-db-num
     1793               ,input  v-cntxt-userid
     1794               ,input  v-diasize-proc-name
     1795               ,input  'height':u
     1796               ,output v-resize-value-str
     1797               ) .
     1798             if v-resize-value-str <> '':U
     1799             then do:
     1800               run diasize_change-height in this-procedure
     1801                 (input  integer(v-resize-value-str)
     1802                 ,input  true
     1803                 ) .
     1804               assign
     1805                 v-restore-saved = true
     1806               .
     1807             end.
     1808           end.
     1809           if connected("ub") = true
     1810           then do:
     1811             run gbl/wndsizer.p
     1812               (input  v-cntxt-db-num
     1813               ,input  v-cntxt-userid
     1814               ,input  v-diasize-proc-name
     1815               ,input  'width':u
     1816               ,output v-resize-value-str
     1817               ) .
     1818             if v-resize-value-str <> '':U
     1819             then do:
     1820               run diasize_change-width in this-procedure
     1821                 (input  integer(v-resize-value-str)
     1822                 ,input  true
     1823                 ) .
     1824               assign
     1825                 v-restore-saved = true
     1826               .
     1827             end.
     1828           end.
     1829           if v-restore-saved <> true
     1830           then do:
     1831             if v-diasize-wndmax = true
     1832             then do:
     1833               run diasize_maximize in this-procedure
     1834                 (input  true
     1835                 ) .
     1836             end.
     1837           end.
     1838         end.
     1839         else do:
     1840           if v-diasize-wndmax = true
     1841           then do:
     1842             run diasize_maximize in this-procedure
     1843               (input  true
     1844               ) .
     1845           end.
     1846         end.
     1847       end.
     1848     end.
     1849   end procedure.
     1850   procedure diasize_need-full-display :
     1851     define output parameter p-need-full-display as logical   no-undo .
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       assign
     1856         p-need-full-display = v-diasize-need-full-display
     1857       .
     1858       assign
     1859         v-diasize-need-full-display = false
     1860       .
     1861     end.
     1862   end procedure.
     1863   procedure get-context :
     1864      define output parameter p-db-num as integer          no-undo.
     1865      define output parameter p-user-id as character        no-undo.
     1866      define variable v-login               as character    no-undo.
     1867      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1868      define buffer buf_user-login  for ub.user-login .
     1869      do
     1870      on error undo, return error
     1871      :
     1872            FIND FIRST buf_sys-ctrl no-lock.
     1873            ASSIGN
     1874               v-login = USERID("ub")
     1875               p-db-num = buf_sys-ctrl.db-num
     1876            .
     1877            FIND FIRST buf_user-login
     1878                 WHERE buf_user-login.db-num = p-db-num
     1879                   AND buf_user-login.user-login = v-login
     1880                 no-lock
     1881                 no-error
     1882                 .
     1883            IF AVAILABLE buf_user-login
     1884            THEN DO:
     1885               assign
     1886                  p-user-id = buf_user-login.user-id
     1887               .
     1888            END.
     1889      end.
     1890   end procedure.
     1891       run diasize_init in this-procedure .
     1892   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1893   DEF VAR cur-clmn-numbr-ovr as INT EXTENT 14 no-undo.
     1894   DEF VAR varmvibr-ovr       as INT no-undo.
     1895   DEF VAR varmvjbr-ovr       as INT no-undo.
     1896   DEF VAR varmvkbr-ovr       as INT no-undo.
     1897   DEF VAR varmvlbr-ovr       as INT no-undo.
     1898   DEF VAR move-elementbr-ovr as INT no-undo.
     1899   def var jjbr-ovr           as int no-undo.
     1900   do varmvibr-ovr = 1 to EXTENT(cur-clmn-numbr-ovr):
     1901     ASSIGN cur-clmn-numbr-ovr[varmvibr-ovr] = varmvibr-ovr.
     1902   END.
     1903   RUN start-mv-clmnbr-ovr.
     1904   PROCEDURE start-mv-clmnbr-ovr:
     1905   def var old-session as logical no-undo.
     1906      old-session = SESSION:IMMEDIATE-DISPLAY.
     1907      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1908      SESSION:IMMEDIATE-DISPLAY = old-session.
     1909   END.
     1910   ON ctrl-cursor-right OF BROWSE br-ovr do:
     1911     RUN re-move-clmnbr-ovr ( 2, 14).
     1912   END.
     1913   ON ctrl-cursor-left OF BROWSE br-ovr do:
     1914     RUN re-move-clmnbr-ovr (14, 2).
     1915   END.
     1916   PROCEDURE re-move-clmnbr-ovr:
     1917     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1918     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1919     DO varmvibr-ovr = 1 TO EXTENT(cur-clmn-numbr-ovr):
     1920       if cur-clmn-numbr-ovr[varmvibr-ovr] = source-column THEN cur-clmn-numbr-ovr[varmvibr-ovr] = -1.
     1921     END.
     1922     if br-ovr:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     1923     if source-column > target-column THEN
     1924     DO varmvjbr-ovr = source-column - 1 to target-column BY -1:
     1925       DO varmvibr-ovr = 1 TO EXTENT(cur-clmn-numbr-ovr):
     1926           if cur-clmn-numbr-ovr[varmvibr-ovr] = varmvjbr-ovr THEN DO:
     1927             cur-clmn-numbr-ovr[varmvibr-ovr] = cur-clmn-numbr-ovr[varmvibr-ovr] + 1.
     1928           END.
     1929       END.
     1930     END.
     1931     ELSE
     1932     DO varmvjbr-ovr = source-column + 1 to target-column:
     1933       DO varmvibr-ovr = 1 TO EXTENT(cur-clmn-numbr-ovr):
     1934         if cur-clmn-numbr-ovr[varmvibr-ovr] = varmvjbr-ovr THEN DO:
     1935           cur-clmn-numbr-ovr[varmvibr-ovr] = cur-clmn-numbr-ovr[varmvibr-ovr] - 1.
     1936         END.
     1937       END.
     1938     END.
     1939     DO varmvibr-ovr = 1 TO EXTENT(cur-clmn-numbr-ovr):
     1940       if cur-clmn-numbr-ovr[varmvibr-ovr] = -1 THEN cur-clmn-numbr-ovr[varmvibr-ovr] = target-column.
     1941     END.
     1942   END PROCEDURE.
     1943   PROCEDURE ch-clmnbr-ovr:
     1944     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1945     if cur-clmn-loc <= 2 then do:
     1946       return .
     1947     end.
     1948     DO varmvibr-ovr = 1 TO EXTENT(cur-clmn-numbr-ovr):
     1949       if cur-clmn-numbr-ovr[varmvibr-ovr] = cur-clmn-loc THEN move-elementbr-ovr = varmvibr-ovr.
     1950     END.
     1951     RUN re-move-clmnbr-ovr (cur-clmn-loc, 2).
     1952   END PROCEDURE.
     1953   PROCEDURE mv-brw-defaultbr-ovr:
     1954   def var old-session as logical no-undo.
     1955     old-session = SESSION:IMMEDIATE-DISPLAY.
     1956     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1957     do varmvlbr-ovr = 2 to EXTENT(cur-clmn-numbr-ovr):
     1958       RUN re-move-clmnbr-ovr (cur-clmn-numbr-ovr[varmvlbr-ovr], varmvlbr-ovr).
     1959     END.
     1960     RUN start-mv-clmnbr-ovr.
     1961     SESSION:IMMEDIATE-DISPLAY = old-session.
     1962   END PROCEDURE.
     1963   .
     1964   def var sort-labelbr-ovr   as character no-undo .
     1965   def var sort-clmnbr-ovr    as handle    no-undo .
     1966   def var cur-clmnbr-ovr     as handle    no-undo .
     1967   def var cur-clmn-locbr-ovr as integer   no-undo .
     1968   def var re-querybr-ovr     as logical   initial no no-undo .
     1969   on start-search, ctrl-o of br-ovr in frame Dialog-Frame do:
     1970      run sort-brbr-ovr
     1971        (input (if available c-price-doc
     1972                then recid(c-price-doc)
     1973                else ?
     1974               )
     1975        ).
     1976   end.
     1977   PROCEDURE sort-brbr-ovr :
     1978     define input parameter p-recid as recid no-undo .
     1979     if re-querybr-ovr = no then do:
     1980       assign
     1981          cur-clmnbr-ovr = br-ovr:current-column in frame Dialog-Frame
     1982       .
     1983       if sort-clmnbr-ovr <> ? then sort-clmnbr-ovr:column-fgcolor = 0.
     1984       if cur-clmnbr-ovr = sort-clmnbr-ovr then do:
     1985         assign
     1986            sort-labelbr-ovr = ""
     1987            sort-clmnbr-ovr = ?
     1988         .
     1989        end.
     1990        else do:
     1991          assign
     1992            sort-labelbr-ovr = cur-clmnbr-ovr:label
     1993            sort-clmnbr-ovr  = cur-clmnbr-ovr
     1994            sort-clmnbr-ovr:column-fgcolor = 4
     1995          .
     1996        end.
     1997      end.
     1998     assign
     1999       cur-clmn-locbr-ovr = 1
     2000     .
     2001     def var column-handle as handle no-undo .
     2002     column-handle = br-ovr:first-column.
     2003     do while valid-handle(column-handle) :
     2004       if column-handle = cur-clmnbr-ovr then do:
     2005         leave .
     2006       end.
     2007       column-handle = column-handle:NEXT-COLUMN.
     2008       assign
     2009         cur-clmn-locbr-ovr = cur-clmn-locbr-ovr + 1
     2010       .
     2011     end.
     2012     case sort-labelbr-ovr:
     2013           when '№ Переоценки'  then DO:   assign     sort-column-name = "buf_c-price-doc.doc-num"   .   run OpenBr.   . END.
     2014           when 'Статус'  then DO:   assign     sort-column-name = "buf_c-price-doc.status_"   .   run OpenBr.   . END.
     2015           when 'Дата!док.'  then DO:   assign     sort-column-name = "buf_c-price-doc.doc-date"   .   run OpenBr.   . END.
     2016           when 'Факт'  then DO:   assign     sort-column-name = "buf_c-price-doc.fact-date"   .   run OpenBr.   . END.
     2017           when 'Фирма'  then DO:   assign     sort-column-name = "buf_c-price-doc.host-code"   .   run OpenBr.   . END.
     2018           when 'Тип'  then DO:   assign     sort-column-name = "buf_c-price-doc.obj-type"   .   run OpenBr.   . END.
     2019           when 'Код'  then DO:   assign     sort-column-name = "buf_c-price-doc.obj-code"   .   run OpenBr.   . END.
     2020           when 'ПН'  then DO:   assign     sort-column-name = "buf_c-price-doc.out-code"   .   run OpenBr.   . END.
     2021           when 'Дата посл.!корр.'  then DO:   assign     sort-column-name = "buf_c-price-doc.corr-date"   .   run OpenBr.   . END.
     2022           when 'Номер !док.корр.'  then DO:   assign     sort-column-name = "buf_c-price-doc.corr-doc-code"   .   run OpenBr.   . END.
     2023           when 'Удалил'  then DO:   assign     sort-column-name = "buf_c-price-doc.corr-man"   .   run OpenBr.   . END.
     2024           when 'Создал'  then DO:   assign     sort-column-name = "buf_c-price-doc.creid"   .   run OpenBr.   . END.
     2025           when 'Корр.в!статусе АКТ'  then DO:   assign     sort-column-name = "buf_c-price-doc.is-corr"   .   run OpenBr.   . END.
     2026           when 'Удален в !статусе АКТ'  then DO:   assign     sort-column-name = "buf_c-price-doc.is-del-act"   .   run OpenBr.   . END.
     2027       otherwise do:
     2028         assign
     2029           sort-column-name = ""
     2030         .
     2031         run OpenBr.
     2032           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-ovr') then do:
     2033             run mv-brw-defaultbr-ovr.
     2034           end.
     2035         if sort-labelbr-ovr <> "" then do:
     2036           assign
     2037             cur-clmnbr-ovr:column-fgcolor = 0
     2038           .
     2039         end.
     2040         assign
     2041           cur-clmn-locbr-ovr = ?
     2042         .
     2043       end.
     2044     end case.
     2045       if cur-clmn-locbr-ovr <> ? then do:
     2046         if can-do( this-procedure:internal-entries, 'ch-clmnbr-ovr') then do:
     2047           run ch-clmnbr-ovr in this-procedure (cur-clmn-locbr-ovr).
     2048         end.
     2049       end.
     2050     if p-recid <> ? then do:
     2051       reposition br-ovr to recid p-recid no-error.
     2052       apply "value-changed" to br-ovr in frame Dialog-Frame.
     2053     end.
     2054     apply "entry" to br-ovr in frame Dialog-Frame.
     2055   END PROCEDURE.
     2056   procedure re-open-query-srt-clmnbr-ovr:
     2057   if cur-clmnbr-ovr = ? then do:
     2058      run OpenBr.
     2059   end.
     2060   else do:
     2061      assign re-querybr-ovr = yes.
     2062      run sort-brbr-ovr
     2063        (input (if available c-price-doc
     2064                then recid(c-price-doc)
     2065                else ?
     2066               )
     2067        ).
     2068      assign re-querybr-ovr = no.
     2069   end.
     2070   end.
     2071   MAIN-BLOCK:
     2072   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2073      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2074     buf_c-price-doc.doc-num:read-only in browse br-ovr = true .
     2075     run enable_ui.
     2076     run openbr.
     2077     wait-for go of frame Dialog-Frame.
     2078   end.
     2079   run disable_ui.
     2080   PROCEDURE disable_UI :
     2081     HIDE FRAME Dialog-Frame.
     2082   END PROCEDURE.
     2083   PROCEDURE enable_UI :
     2084     IF AVAILABLE buf_c-price-doc THEN
     2085       DISPLAY buf_c-price-doc.PS
     2086         WITH FRAME Dialog-Frame.
     2087     ENABLE B-Cancel B-History B-Help br-ovr buf_c-price-doc.PS
     2088         WITH FRAME Dialog-Frame.
     2089     VIEW FRAME Dialog-Frame.
     2090     OPEN QUERY br-ovr FOR EACH buf_c-price-doc       WHERE buf_c-price-doc.host-code = p-host-code and buf_c-price-doc.is-del = true NO-LOCK INDEXED-REPOSITION.
     2091   END PROCEDURE.
     2092   PROCEDURE openbr :
     2093   define buffer buf_clients for ub.clients  .
     2094   def var sort-column-phrase as character no-undo .
     2095   case sort-column-name :
     2096     when "" then do:
     2097       assign
     2098         sort-column-phrase = ""
     2099       .
     2100     end.
     2101     otherwise do:
     2102       assign
     2103         sort-column-phrase = "by " + sort-column-name
     2104       .
     2105     end.
     2106   end case.
     2107   define variable l-open-query as logical   no-undo .
     2108          find first buf_clients no-lock where buf_clients.obj-code = p-host-code and buf_clients.obj-type = 'орг':U no-error .
     2109          if not available buf_clients then return .
     2110          ASSIGN frame Dialog-Frame:TITLE = "Удаленные переоценки   ФИРМА: " + buf_clients.obj-name  + " код: " +  string(p-host-code).
     2111   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2112   define variable  l-disable-where-8  as logical   no-undo .
     2113   define variable  l-filter-open-8    as logical   .
     2114   define variable  flt-rec-8       as recid     no-undo .
     2115   define variable  filter-name-8      as character no-undo .
     2116   define variable  where-phrase-8     as character no-undo .
     2117   define variable  sort-phrase-8      as character no-undo .
     2118   define variable  where-phrase-rus-8 as character no-undo .
     2119   define variable  sort-phrase-rus-8  as character no-undo .
     2120     run waitfram-show in this-procedure
     2121       (input "ЖДИТЕ ..."
     2122       ).
     2123   run gbl/flt-get.p
     2124     (input filter-point
     2125     ,output flt-rec-8
     2126     ,output filter-name-8
     2127     ,output where-phrase-8
     2128     ,output sort-phrase-8
     2129     ,output where-phrase-rus-8
     2130     ,output sort-phrase-rus-8
     2131     ).
     2132   if p-open-query then do:
     2133       run set-filter-name in this-procedure
     2134         (INPUT filter-name-8
     2135         ) no-error .
     2136     assign
     2137       l-filter-open-8 = false
     2138     .
     2139     if flt-rec-8 <> ?
     2140       or sort-column-phrase > ""
     2141     then do:
     2142       define variable  parameter-2-8 as character no-undo .
     2143       define variable  parameter-3-8 as character no-undo .
     2144       define variable  parameter-4-8 as character no-undo .
     2145       define variable  parameter-5-8 as character no-undo .
     2146       define variable  parameter-6-8 as character no-undo .
     2147       define variable  parameter-7-8 as character no-undo .
     2148         assign
     2149         parameter-3-8 =
     2150                                 "FOR EACH buf_c-price-doc"
     2151         parameter-4-8 =
     2152           (
     2153             if (" buf_c-price-doc.host-code = p-host-code  AND buf_c-price-doc.is-del = TRUE " + " " + where-phrase-8) <> ""
     2154             then  substitute (' buf_c-price-doc.host-code = &1  AND buf_c-price-doc.is-del = TRUE ' , p-host-code )  + " " + where-phrase-8
     2155             else "true"
     2156           )
     2157         parameter-5-8 = (" " + "" + " " + "")
     2158         parameter-6-8 = if sort-phrase-8 = ''
     2159                              then
     2160           (
     2161           " " + " USE-INDEX del " +
     2162             " " + sort-column-phrase +
     2163           " " + " "
     2164           )
     2165                              else
     2166           (
     2167           " " + " USE-INDEX del " +
     2168             " " + sort-column-phrase +
     2169           " " + sort-phrase-8
     2170           )
     2171         parameter-7-8 =
     2172           " indexed-reposition  "
     2173       .
     2174       do
     2175       on stop undo, leave
     2176       on error undo, leave
     2177       :
     2178         assign
     2179           l-disable-where-8 =
     2180             (" buf_c-price-doc.host-code = p-host-code  AND buf_c-price-doc.is-del = TRUE " + " " + where-phrase-8 = "")
     2181         .
     2182         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2183                             ,input query br-ovr:handle
     2184                             ,input parameter-3-8
     2185                             ,input parameter-4-8
     2186                             ,input parameter-5-8
     2187                             ,input parameter-6-8
     2188                             ,input parameter-7-8
     2189                             )
     2190         .
     2191         assign
     2192           l-filter-open-8 = true
     2193         .
     2194       end.
     2195       if l-filter-open-8 = false then do:
     2196         message
     2197           "Ошибка при фильтрации / сортировке" skip
     2198           "Будут показаны записи без учета фильтра" skip
     2199           view-as alert-box .
     2200       end.
     2201       else do:
     2202           assign
     2203             l-query-was-opened = true
     2204           .
     2205       end.
     2206     end.
     2207     if l-filter-open-8 = false then do:
     2208       OPEN QUERY br-ovr FOR EACH buf_c-price-doc
     2209         where  buf_c-price-doc.host-code = p-host-code  AND buf_c-price-doc.is-del = TRUE
     2210          USE-INDEX del
     2211         indexed-reposition
     2212     .
     2213         assign
     2214           l-query-was-opened = true
     2215         .
     2216     end.
     2217   end.
     2218   else do:
     2219     assign
     2220       doc-rec = recid( buf_c-price-doc )
     2221     .
     2222     do
     2223     on stop undo, leave
     2224     on error undo, leave
     2225     :
     2226       if query br-ovr:handle:get-buffer-handle(1) = (buffer buf_c-price-doc:handle) then do:
     2227         assign
     2228         parameter-2-8 = (if p-find-next then "true":u else "false":u )
     2229         parameter-4-8 =
     2230           "where ":u +  substitute (' buf_c-price-doc.host-code = &1  AND buf_c-price-doc.is-del = TRUE ' , p-host-code )  + " ":u + where-phrase-8 + " ":u + p-find-condition + " " + ""
     2231         parameter-5-8 = " USE-INDEX del "
     2232       .
     2233         run fltopend_fltfindd in this-procedure  (
     2234                             input this-procedure:handle
     2235                             ,input query br-ovr:handle
     2236                             ,input rowid(buf_c-price-doc)
     2237                             ,input logical(parameter-2-8)
     2238                             ,input no-lock
     2239                             ,input (buffer buf_c-price-doc:handle)
     2240                             ,input parameter-4-8
     2241                             ,input parameter-5-8
     2242                             ) no-error.
     2243         .
     2244         assign
     2245           doc-rec = integer(return-value)
     2246           v-fltopend-rowid[1] = ?
     2247         .
     2248       end.
     2249       else do:
     2250         assign
     2251         parameter-2-8 = (if p-find-next then "true":u else "false":u )
     2252         parameter-3-8 =  "FOR EACH buf_c-price-doc"
     2253         parameter-4-8 =
     2254           (
     2255             if (" buf_c-price-doc.host-code = p-host-code  AND buf_c-price-doc.is-del = TRUE " + " " + where-phrase-8) <> ""
     2256             then  substitute (' buf_c-price-doc.host-code = &1  AND buf_c-price-doc.is-del = TRUE ' , p-host-code )  + " " + where-phrase-8
     2257             else "true"
     2258           )
     2259         parameter-5-8 = (" " + "" + " " + "" + " " + p-find-condition)
     2260         parameter-6-8 = if sort-phrase-8 = ''
     2261                              then
     2262           (
     2263           " " + " USE-INDEX del " +
     2264             " " + sort-column-phrase +
     2265           " " + " "
     2266           )
     2267                              else
     2268           (
     2269           " " + " USE-INDEX del " +
     2270             " " + sort-column-phrase +
     2271           " " + sort-phrase-8
     2272           )
     2273         parameter-7-8 =
     2274           " indexed-reposition  "
     2275       .
     2276         run fltopend_fltfindq in this-procedure  (
     2277                             input this-procedure:handle
     2278                             ,input query br-ovr:handle
     2279                             ,input logical(parameter-2-8)
     2280                             ,input no-lock
     2281                             ,input parameter-3-8
     2282                             ,input parameter-4-8
     2283                             ,input parameter-5-8
     2284                             ,input parameter-6-8
     2285                             ,input parameter-7-8
     2286                             ,output v-fltopend-rowid
     2287                             ) no-error.
     2288         .
     2289         doc-rec = ?.
     2290       end.
     2291       assign
     2292         l-query-was-opened = true
     2293       .
     2294     end.
     2295   end.
     2296     run waitfram-hide in this-procedure .
     2297   if not p-open-query then
     2298   REPOSITION br-ovr to recid doc-rec No-ERROR.
     2299   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2300   query br-ovr:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     2301   END PROCEDURE.
     2302   PROCEDURE Set-filter-name :
     2303    define input parameter p-filter-name as character no-undo .
     2304   end procedure.
