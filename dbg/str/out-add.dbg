      772             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      773             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      774             .
      775         end.
      776       end case.
      777     end.
      778   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
