     1372   procedure xmlchar-test :
     1373   define input parameter p-in-string          as character        no-undo.
     1374   define output parameter p-out-string-enc    as character        no-undo.
     1375   define output parameter p-out-string-dec    as character        no-undo.
     1376   do
     1377   on error undo, return error
     1378   :
     1379          run xmlchar-encode in this-procedure
     1380       (
     1381             input p-in-string
     1382           , output p-out-string-enc
     1383       ).
     1384          run xmlchar-decode in this-procedure
     1385       (
     1386             input p-out-string-enc
     1387           , output p-out-string-dec
     1388       ).
     1389   end.
     1390   end .
     1391   procedure xmlchar-encode :
     1392   define input parameter p-in-string      as character        no-undo.
     1393   define output parameter p-out-string    as character        no-undo.
     1394       define variable v-position      as integer      no-undo.
     1395       define variable v-current-char  as character    no-undo.
     1396   do
     1397   on error undo, return error
     1398   :
     1399       assign
     1400           p-out-string = "":U
     1401       .
     1402       case p-in-string
     1403       :
     1404           when ?
     1405           then do:
     1406               assign
     1407                   p-out-string = "?":U
     1408               .
     1409           end.
     1410           when "?":U
     1411           then do:
     1412               assign
     1413                   p-out-string = "&#63;":U
     1414               .
     1415           end.
     1416           otherwise do:
     1417               do v-position = 1 to length( p-in-string )
     1418               :
     1419                   assign
     1420                       v-current-char = substring( p-in-string, v-position, 1 )
     1421                   .
     1422                   case v-current-char
     1423                   :
     1424                       when "&":U
     1425                       then do:
     1426                           assign
     1427                               p-out-string = p-out-string + "&amp;":U
     1428                           .
     1429                       end.
     1430                       when ">":U
     1431                       then do:
     1432                           assign
     1433                               p-out-string = p-out-string + "&gt;":U
     1434                           .
     1435                       end.
     1436                       when "<":U
     1437                       then do:
     1438                           assign
     1439                               p-out-string = p-out-string + "&lt;":U
     1440                           .
     1441                       end.
     1442                       when "'":U
     1443                       then do:
     1444                           assign
     1445                               p-out-string = p-out-string + "&apos;":U
     1446                           .
     1447                       end.
     1448                       when '"':U
     1449                       then do:
     1450                           assign
     1451                               p-out-string = p-out-string + "&quot;":U
     1452                           .
     1453                       end.
     1454                       when chr(1)
     1455                       then do:
     1456                           assign
     1457                               p-out-string = p-out-string + "":U
     1458                           .
     1459                       end.
     1460                       when chr(2)
     1461                       then do:
     1462                           assign
     1463                               p-out-string = p-out-string + "":U
     1464                           .
     1465                       end.
     1466                       when chr(3)
     1467                       then do:
     1468                           assign
     1469                               p-out-string = p-out-string + "":U
     1470                           .
     1471                       end.
     1472                       when chr(4)
     1473                       then do:
     1474                           assign
     1475                               p-out-string = p-out-string + "":U
     1476                           .
     1477                       end.
     1478                       when chr(5)
     1479                       then do:
     1480                           assign
     1481                               p-out-string = p-out-string + "":U
     1482                           .
     1483                       end.
     1484                       when chr(6)
     1485                       then do:
     1486                           assign
     1487                               p-out-string = p-out-string + "":U
     1488                           .
     1489                       end.
     1490                       when chr(7)
     1491                       then do:
     1492                           assign
     1493                               p-out-string = p-out-string + "":U
     1494                           .
     1495                       end.
     1496                       when chr(8)
     1497                       then do:
     1498                           assign
     1499                               p-out-string = p-out-string + "":U
     1500                           .
     1501                       end.
     1502                       when chr(9)
     1503                       then do:
     1504                           assign
     1505                               p-out-string = p-out-string + "":U
     1506                           .
     1507                       end.
     1508                       when chr(29)
     1509                       then do:
     1510                           assign
     1511                               p-out-string = p-out-string + "":U
     1512                           .
     1513                       end.
     1514                       when chr(10)
     1515                       then do:
     1516                           assign
     1517                               p-out-string = p-out-string + "&#10;":U
     1518                           .
     1519                       end.
     1520                       when chr(13)
     1521                       then do:
     1522                           assign
     1523                               p-out-string = p-out-string + "&#13;":U
     1524                           .
     1525                       end.
     1526                       otherwise do:
     1527                           assign
     1528                               p-out-string = p-out-string + v-current-char
     1529                           .
     1530                       end.
     1531                   end case.
     1532               end.
     1533           end.
     1534       end case.
     1535   end.
     1536   end .
     1537   procedure xmlchar-encode-1c :
     1538   define input parameter p-in-string      as character        no-undo.
     1539   define output parameter p-out-string    as character        no-undo.
     1540       define variable v-position      as integer      no-undo.
     1541       define variable v-current-char  as character    no-undo.
     1542   do
     1543   on error undo, return error
     1544   :
     1545       assign
     1546           p-out-string = "":U
     1547       .
     1548       case p-in-string
     1549       :
     1550           when ?
     1551           then do:
     1552               assign
     1553                   p-out-string = "?":U
     1554               .
     1555           end.
     1556           otherwise do:
     1557               do v-position = 1 to length( p-in-string )
     1558               :
     1559                   assign
     1560                       v-current-char = substring( p-in-string, v-position, 1 )
     1561                   .
     1562                   case v-current-char
     1563                   :
     1564                       when chr(1)
     1565                       then do:
     1566                           assign
     1567                               p-out-string = p-out-string + " ":U
     1568                           .
     1569                       end.
     1570                       when chr(2)
     1571                       then do:
     1572                           assign
     1573                               p-out-string = p-out-string + " ":U
     1574                           .
     1575                       end.
     1576                       when chr(3)
     1577                       then do:
     1578                           assign
     1579                               p-out-string = p-out-string + " ":U
     1580                           .
     1581                       end.
     1582                       when chr(4)
     1583                       then do:
     1584                           assign
     1585                               p-out-string = p-out-string + " ":U
     1586                           .
     1587                       end.
     1588                       when chr(5)
     1589                       then do:
     1590                           assign
     1591                               p-out-string = p-out-string + " ":U
     1592                           .
     1593                       end.
     1594                       when chr(6)
     1595                       then do:
     1596                           assign
     1597                               p-out-string = p-out-string + " ":U
     1598                           .
     1599                       end.
     1600                       when chr(7)
     1601                       then do:
     1602                           assign
     1603                               p-out-string = p-out-string + " ":U
     1604                           .
     1605                       end.
     1606                       when chr(8)
     1607                       then do:
     1608                           assign
     1609                               p-out-string = p-out-string + " ":U
     1610                           .
     1611                       end.
     1612                       when chr(9)
     1613                       then do:
     1614                           assign
     1615                               p-out-string = p-out-string + " ":U
     1616                           .
     1617                       end.
     1618                       when chr(29)
     1619                       then do:
     1620                           assign
     1621                               p-out-string = p-out-string + " ":U
     1622                           .
     1623                       end.
     1624                       when chr(10)
     1625                       then do:
     1626                           assign
     1627                               p-out-string = p-out-string + " ":U
     1628                           .
     1629                       end.
     1630                       when chr(13)
     1631                       then do:
     1632                           assign
     1633                               p-out-string = p-out-string + " ":U
     1634                           .
     1635                       end.
     1636                       otherwise do:
     1637                           assign
     1638                               p-out-string = p-out-string + v-current-char
     1639                           .
     1640                       end.
     1641                   end case.
     1642               end.
     1643           end.
     1644       end case.
     1645   end.
     1646   end .
     1647   procedure xmlchar-decode :
     1648   define input parameter p-in-string      as character        no-undo.
     1649   define output parameter p-out-string    as character        no-undo.
     1650       define variable v-position      as integer      no-undo.
     1651       define variable v-last-position as integer      no-undo.
     1652       define variable v-temp-integer  as integer      no-undo.
     1653       define variable v-current-char  as character    no-undo.
     1654       define variable v-next-char     as character    no-undo.
     1655       define variable v-success       as logical      no-undo.
     1656   do
     1657   on error undo, return error
     1658   :
     1659       assign
     1660           p-out-string = "":U
     1661           v-position   = 0
     1662       .
     1663       replace-cycle:
     1664       do while yes
     1665       on error undo, return error
     1666       :
     1667           assign
     1668               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1669           .
     1670           if v-last-position <= v-position
     1671           then do:
     1672               if v-position = 0
     1673               then do:
     1674                   assign
     1675                       p-out-string = p-in-string
     1676                   .
     1677               end.
     1678               else do:
     1679                   assign
     1680                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1681                   .
     1682               end.
     1683               leave replace-cycle.
     1684           end.
     1685           else do:
     1686               assign
     1687                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1688                   v-position      = v-last-position
     1689                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1690               .
     1691               if v-current-char = "#":U
     1692               then do:
     1693                   assign
     1694                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1695                   .
     1696                   if v-last-position > 0
     1697                   then do:
     1698                       run xmlchar-read-integer in this-procedure
     1699                        (
     1700                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1701                           , output v-temp-integer
     1702                           , output v-success
     1703                       ).
     1704                       if v-success = yes
     1705                       and v-temp-integer >= 1
     1706                       and v-temp-integer <= 255
     1707                       then do:
     1708                           assign
     1709                               p-out-string = p-out-string + chr( v-temp-integer )
     1710                               v-position   = v-last-position + 1
     1711                           .
     1712                       end.
     1713                       else do:
     1714                           assign
     1715                               p-out-string = p-out-string + "&":U
     1716                               v-position   = v-position   + 1
     1717                           .
     1718                       end.
     1719                   end.
     1720                   else do:
     1721                       assign
     1722                           p-out-string = p-out-string + "&":U
     1723                           v-position   = v-position   + 1
     1724                       .
     1725                   end.
     1726               end.
     1727               else do:
     1728                   case substring( p-in-string, v-position + 1, 3 )
     1729                   :
     1730                       when "lt;":U
     1731                       then do:
     1732                           assign
     1733                               p-out-string = p-out-string + "<":U
     1734                               v-position   = v-position   + 3
     1735                           .
     1736                       end.
     1737                       when "gt;":U
     1738                       then do:
     1739                           assign
     1740                               p-out-string = p-out-string + ">":U
     1741                               v-position   = v-position   + 3
     1742                           .
     1743                       end.
     1744                       otherwise do:
     1745                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1746                           then do:
     1747                               assign
     1748                                   p-out-string = p-out-string + "&":U
     1749                                   v-position   = v-position   + 4
     1750                               .
     1751                           end.
     1752                           else do:
     1753                               case substring( p-in-string, v-position + 1, 5 )
     1754                               :
     1755                                   when "quot;":U
     1756                                   then do:
     1757                                       assign
     1758                                           p-out-string = p-out-string + '"':U
     1759                                           v-position   = v-position   + 5
     1760                                       .
     1761                                   end.
     1762                                   when "apos;":U
     1763                                   then do:
     1764                                       assign
     1765                                           p-out-string = p-out-string + "'":U
     1766                                           v-position   = v-position   + 5
     1767                                       .
     1768                                   end.
     1769                                   otherwise do:
     1770                                       assign
     1771                                           p-out-string = p-out-string + "&":U
     1772                                       .
     1773                                   end.
     1774                               end case.
     1775                           end.
     1776                       end.
     1777                   end case.
     1778               end.
     1779           end.
     1780       end.
     1781   end.
     1782   end .
     1783   procedure xmlchar-read-integer :
     1784   define input parameter p-input-string      as character        no-undo.
     1785   define output parameter p-output-integer   as integer          no-undo.
     1786   define output parameter p-success       as logical          no-undo.
     1787   do
     1788   on error undo, return error
     1789   :
     1790       assign
     1791           p-output-integer = integer( p-input-string )
     1792       no-error.
     1793       if error-status :error
     1794       then do:
     1795           assign
     1796               p-success           = no
     1797               p-output-integer    = 0
     1798           .
     1799       end.
     1800       else do:
     1801           assign
     1802               p-success           = yes
     1803           .
     1804       end.
     1805   end.
     1806   end.
     1807   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1808   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1809   define variable mMRCCode  as logical    no-undo.
     1810   define variable mTypeMark as character  no-undo.
     1811   function IS-NeedMark returns logical
     1812   ( input ib-code as integer  ,
     1813     input ib-str as character ):
     1814      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1815      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1816                                    and buf_prod-bc-attr.b-str  eq ib-str
     1817                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1818        no-lock no-error.
     1819      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1820   end.
     1821   function repTegforDm return char
     1822   (iDM as char ):
     1823       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1824       define variable vteg as character no-undo.
     1825       define variable oDM as character no-undo.
     1826       define variable vi as integer no-undo.
     1827       oDM = iDm.
     1828       do vi = 1 to num-entries(vTeglist):
     1829          vTeg = entry(vi,vTeglist).
     1830          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1831       end.
     1832       return oDM.
     1833   end.
     1834   function repSpecSimbforDm return char
     1835   (iDM as char ):
     1836       define variable oDM as character no-undo.
     1837     run
     1838       xmlchar-decode(iDM, output oDM).
     1839     return repTegforDm (oDM).
     1840   end.
     1841   function CheckGtin return logical
     1842   (iGtin as char):
     1843      define variable bar_code as character no-undo.
     1844      define variable vGtin as logical no-undo init "yes".
     1845      if length(iGtin) eq 14
     1846      then do:
     1847         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1848         run str/chk-sum.p
     1849          (input-output bar_code ) no-error .
     1850         if iGtin ne  bar_code
     1851         then
     1852            vGtin = no.
     1853      end.
     1854      else
     1855         vGtin = no.
     1856      return vgtin.
     1857   end.
     1858   function repSpecSimbforXlm return char
     1859   (iDM as char ):
     1860       iDM = replace(iDM,chr(29),"").
     1861       return iDM.
     1862   end.
     1863   function getGtinByDM return char
     1864   (IDM as char):
     1865      define variable VTXT as char no-undo.
     1866      define variable vGtin as char no-undo.
     1867      vTXt = IdM.
     1868      vGtin = IDM.
     1869      if    length(vtxt) > 14
     1870      then do:
     1871         if   vtxt begins "(01)"
     1872                or vtxt begins "(02)"
     1873         then
     1874            vGtin = substring(vtxt,5,14).
     1875         else if   (vtxt begins "01"
     1876                or vtxt begins "02" )
     1877                and (   (    substring(iDm,17,2) eq "21"
     1878                         and length(vtxt) >= 21)
     1879                     or substring(iDm,17,2) eq "37"
     1880                     or substring(iDm,17,4) eq "(37)" )
     1881         then do:
     1882            vGtin = substring(vtxt,3,14).
     1883            if not checkGtin(vGtin)
     1884            then
     1885               vGtin = substring(vtxt,1,14).
     1886         end.
     1887         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1888             or length(vtxt) eq 14 + 7 + 4
     1889             or length(vtxt) eq 14 + 7
     1890         then
     1891            vGtin = substring(vtxt,1,14).
     1892      end.
     1893      if not checkGtin(vGtin)
     1894      then
     1895         vGtin = "".
     1896      return vgtin.
     1897   end.
     1898   function getGdsCodeByGtin return int
     1899   (iGtin as char):
     1900      define buffer prod-bc  for ub.prod-bc.
     1901      define buffer bar-code for ub.bar-code.
     1902      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1903      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1904      return if avail bar-code then bar-code.gds-code else ?.
     1905   end.
     1906   function getQntyCodeByGtin return decimal
     1907   (iGtin as char):
     1908      define buffer prod-bc  for ub.prod-bc.
     1909      define buffer bar-code for ub.bar-code.
     1910      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1911      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1912      return if avail bar-code then bar-code.cli-base-rate else ?.
     1913   end.
     1914   function getGdsCodeByDM return int
     1915   (iDm as char):
     1916      define variable vGtin as char no-undo.
     1917      define buffer prod-bc for ub.prod-bc.
     1918      vGtin  = getGtinByDM (IDM ).
     1919      return getGdsCodeByGtin (vGtin).
     1920   end.
     1921   function ChekTypeMarkByGds return logical
     1922   (iGds-code as integer ):
     1923      define buffer goods-attr for ub.goods-attr.
     1924      find first goods-attr where goods-attr.gds-code   = iGds-code
     1925                              and goods-attr.attr-code  = 'mark-type':U
     1926      no-lock no-error.
     1927      if available goods-attr
     1928      then do:
     1929         mTypeMark = goods-attr.attr-value.
     1930         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1931           .
     1932      end.
     1933      else
     1934         return no.
     1935   end.
     1936   function ChekTypeMarkByDm return logical
     1937   (iDM as char ):
     1938      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1939   end.
     1940   function ChekTypeMarkByGtin return logical
     1941   (iGtin as char ):
     1942      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1943   end.
     1944   function GetNextElement return character
     1945     (input iAllTeg        as logical
     1946     ,output oteg          as character
     1947     ,output otegval       as character
     1948     ,input-output pstr    as character
     1949      ):
     1950        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1951        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1952        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1953        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1954        define variable vTeg as character no-undo.
     1955        define variable vLength as integer no-undo.
     1956        define variable vi as integer no-undo.
     1957        define variable vj as integer no-undo.
     1958        define buffer code for ub.code.
     1959        find first code where Code.parent eq "MarkType"
     1960                          and Code.CodeValue   eq mTypeMark
     1961                          no-lock no-error.
     1962        if     available code
     1963           and Code.misc1 ne ""
     1964           and Code.misc1 ne ?
     1965        then do:
     1966           integer (Code.misc1) no-error.
     1967           if not error-status:error
     1968           then
     1969             entry (4,vlistleng) = Code.misc1.
     1970        end.
     1971        if iAllTeg
     1972        then
     1973           assign
     1974              vlistElem     = vlistElem    + vlistElemDop
     1975              vlistleng     = vlistleng    + vlistlengDop
     1976           .
     1977        else if mMRCCode
     1978        then
     1979           assign
     1980              vlistElem     = vlistElem    + ",(8005),8005"
     1981              vlistleng     = vlistleng    + ",000006,0006"
     1982           .
     1983       block-elem:
     1984       do vi = 1 to num-entries(vlistElem):
     1985          vTeg = entry(vi,vlistElem).
     1986          if pstr begins vTeg
     1987          then do:
     1988             if    vTeg eq "21"
     1989             then
     1990                vLength = index(pstr,chr(29)) - 2 no-error.
     1991             if vLength  <= 0
     1992             then
     1993                vLength = int(entry(vi,vlistleng)).
     1994             otegval = substring (pstr,length(vteg) + 1, vLength).
     1995             oteg = replace(replace(vteg,")",""),"(","").
     1996             vTeg = vteg + otegval.
     1997             otegval = replace(otegval,chr(29),"").
     1998             oteg = replace(replace(oteg,")",""),"(","").
     1999             pstr = substring (pstr,length(vTeg)+ 1).
     2000             vTeg = replace(vTeg,chr(29),"").
     2001             leave block-elem.
     2002          end.
     2003          else
     2004             vTeg = "".
     2005       end.
     2006       return vteg.
     2007   end.
     2008   function GetCodeIdent return character
     2009   (iDm as char):
     2010      define variable Velement   as character no-undo init "first".
     2011      define variable oCodeIdent as character no-undo.
     2012      define variable vteg as character no-undo.
     2013      define variable vtegval as character no-undo.
     2014      define variable vGtin as character no-undo.
     2015      define buffer marking for ub.marking.
     2016      for first marking no-lock where
     2017                marking.mark eq iDm
     2018            and marking.unit-ext = "LEVEL2"
     2019      :
     2020        return iDm.
     2021      end.
     2022      vGtin  = getGtinByDM (iDm ).
     2023      ChekTypeMarkByDm(idm).
     2024      if iDm begins 'tech_':U
     2025      then
     2026         oCodeIdent = iDm.
     2027      else if length(iDm) < 21
     2028      then do:
     2029         find first marking where marking.mark eq idm
     2030         no-lock no-error.
     2031         oCodeIdent = if available marking then marking.mark else  ?.
     2032      end.
     2033      else if     length(iDm) eq 29
     2034         and not iDm begins "01"
     2035         and not iDm begins "02"
     2036      then
     2037         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2038      else  if     length(iDm) >= 24
     2039               and (  iDm begins "01"
     2040                   or iDm begins "02")
     2041               and  substring(iDm,17,2) ne "21"
     2042      then do:
     2043         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2044                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2045         then
     2046            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2047         else
     2048            oCodeIdent = iDM.
     2049      end.
     2050      else  if     (   length(iDm) eq 25
     2051                    or length(iDm) eq 21)
     2052               and (not iDm begins "01"
     2053               and  not iDm begins "02")
     2054      then
     2055         oCodeIdent = substring(iDm,1,21).
     2056      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2057      then
     2058         oCodeIdent = substring(iDm,1,21).
     2059      else do while Velement ne "" and idm ne "":
     2060         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2061         oCodeIdent = oCodeIdent + Velement.
     2062      end.
     2063      return oCodeIdent.
     2064   end.
     2065   function GetTegCod return character
     2066   (icodeIdent as char, iTeg as char):
     2067      define variable Velement   as character no-undo init "first".
     2068      define variable oTeg as character no-undo init ?.
     2069      define variable vteg as character no-undo.
     2070      define variable vtegval as character no-undo.
     2071      if     ((length(icodeIdent) eq 21
     2072         and not icodeIdent begins "01"
     2073         and not icodeIdent begins "02")
     2074         or
     2075             ( length(icodeIdent) eq 25
     2076               and not icodeIdent begins "01"
     2077               and not icodeIdent begins "02"))
     2078      then do:
     2079         if iTeg eq "01" or iTeg eq "02"
     2080         then
     2081            oTeg = substring(icodeIdent,1,21).
     2082         else  if  iTeg eq "21"
     2083         then
     2084            oTeg = substring(icodeIdent,15,7).
     2085      end.
     2086      else do:
     2087         ChekTypeMarkByDm(icodeIdent).
     2088         block-teg:
     2089            do while Velement ne "" and icodeIdent ne "":
     2090            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2091            if    Velement begins iTeg
     2092               or Velement begins "(" + iTeg + ")"
     2093            then do:
     2094               oTeg = vtegval.
     2095               leave block-teg.
     2096            end.
     2097         end.
     2098      end.
     2099      return oTeg.
     2100   end.
     2101   function isOAD return logical
     2102   (icodeIdent as character):
     2103      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2104   end.
     2105   function isMark return logical
     2106   (icodeIdent as character):
     2107      define buffer buf_marking for ub.marking.
     2108      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2109             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2110   end.
     2111   function addBracketForCode return character
     2112   (icodeIdent as char):
     2113      define variable Velement   as character no-undo init "first".
     2114      define variable oTeg as character no-undo.
     2115      define variable vteg as character no-undo.
     2116      define variable vtegval as character no-undo.
     2117      define buffer marking for ub.marking.
     2118      find first marking no-lock where
     2119                 marking.mark begins icodeIdent no-error.
     2120      if    not ChekTypeMarkByDm(icodeIdent)
     2121         or length(icodeIdent) le 24
     2122         or (avail marking and marking.unit-ext = "LEVEL2")
     2123      then
     2124         oTeg = icodeIdent.
     2125      else do:
     2126         if (  icodeIdent begins "01"
     2127            or icodeIdent begins "02"
     2128            ) and CheckGtin(substring (icodeIdent,3,14))
     2129            and substring (icodeIdent,17,2) eq "21"
     2130         then do:
     2131            mMRCCode = yes.
     2132            ChekTypeMarkByDm(icodeIdent).
     2133            block-teg:
     2134            do while Velement ne "" and icodeIdent ne "":
     2135               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2136               if vteg ne ""
     2137               then
     2138                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2139            end.
     2140            mMRCCode = no.
     2141         end.
     2142         else do:
     2143            oTeg = icodeIdent.
     2144         end.
     2145      end.
     2146      return oTeg.
     2147   end.
     2148   function getlevelByCodId return int
     2149   (iCode as char):
     2150      define variable vLength as int no-undo.
     2151      define variable vLevel  as int no-undo.
     2152      if not ChekTypeMarkByDM (icode) then return ?.
     2153      vLength = length(iCode).
     2154      if    vLength eq 18
     2155         or vLength eq 20
     2156      then
     2157         Vlevel = 4.
     2158      else if vLength eq 21
     2159      then
     2160         Vlevel = 1.
     2161      else if vLength eq 25
     2162      then do:
     2163         if  iCode begins "01"
     2164         then
     2165            Vlevel = 3.
     2166         else
     2167            Vlevel = 1.
     2168      end.
     2169      else if     vLength >= 26
     2170              and vLength <= 46
     2171      then do:
     2172         if    substring(iCode,17,2) eq "11"
     2173            or substring(iCode,17,2) eq "13"
     2174            or (    substring(iCode,17,2) eq "21"
     2175                and vLength >= 33
     2176                and substring(iCode,26,4) ne "8005")
     2177         then
     2178            Vlevel = 4.
     2179         else if    vLength eq 31
     2180                 or vLength eq 38
     2181                 or vLength eq 39
     2182                 or vLength eq 45
     2183         then
     2184            Vlevel = 1.
     2185         else if    vLength eq 35
     2186                 or vLength eq 43
     2187         then
     2188            Vlevel = 3.
     2189         else
     2190            Vlevel = ?.
     2191      end.
     2192      else
     2193         Vlevel = ?.
     2194      return Vlevel.
     2195   end.
     2196   function getLevelMotpBycodid return character
     2197   (iDm as char):
     2198      define variable vLevel as integer no-undo.
     2199      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2200      vLevel = getlevelByCodId(iDm).
     2201      if    vLevel eq ?
     2202         or vLevel < 1
     2203         or vLevel > 6
     2204      then
     2205         return ?.
     2206      else
     2207         return entry(vlevel,vList).
     2208   end.
     2209   function getLevelUTDByLevelMotp return character
     2210   (iUnit as char):
     2211      define variable vLevel as integer no-undo.
     2212      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2213      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2214      vLevel = lookup(iUnit,vListMOTP).
     2215      if    vLevel eq ?
     2216         or vLevel < 1
     2217         or vLevel > 4
     2218      then
     2219         return ?.
     2220      else
     2221         return entry(vlevel,vListutd).
     2222   end.
     2223   function getLevelMotpByDM return character
     2224   (iDm as char):
     2225      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2226   end.
     2227   function getLevelUTDByCodId return character
     2228   (iDm as char):
     2229      define variable vLevel as integer no-undo.
     2230      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2231      vLevel = getlevelByCodId(iDm).
     2232      if    vLevel eq ?
     2233         or vLevel < 1
     2234         or vLevel > 4
     2235      then
     2236         return ?.
     2237      else
     2238         return entry(vlevel,vList).
     2239   end.
     2240   function getLevelUTDByDM return character
     2241   (iDm as char):
     2242      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2243   end.
     2244   define variable mNotMarkQnty as logical no-undo.
     2245   function getQntyUTDByCodId return decimal
     2246   (iDM as char):
     2247      define variable vLevel as integer no-undo.
     2248      define variable vList as character no-undo init "1,5,10,500".
     2249      define variable vGtin as character no-undo.
     2250      define variable vqnty as decimal no-undo init ?.
     2251      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2252      if vqnty eq ?
     2253      then do:
     2254         if not mNotMarkQnty
     2255         then do:
     2256            define buffer marking for ub.marking.
     2257            define variable vCodident as character no-undo.
     2258            vCodident = GetCodeIdent(idm).
     2259            find first marking where marking.mark begins vCodident no-lock no-error.
     2260            if     available marking
     2261               and marking.box-qnty ne ?
     2262            then
     2263               return marking.box-qnty.
     2264         end.
     2265         vGtin = getGtinByDm(iDM).
     2266         if ChekTypeMarkByGtin (vGtin)
     2267         then do:
     2268            vLevel = getlevelByCodId(iDM).
     2269            if     vLevel >= 1
     2270               and vLevel <= 4
     2271            then
     2272               vqnty = int(entry(vlevel,vList)).
     2273         end.
     2274         else
     2275            vqnty = getQntyCodeByGtin(vgtin).
     2276      end.
     2277      return vqnty.
     2278   end.
     2279   function getQntyUTDByDM return decimal
     2280   (iDm as char):
     2281      define variable vDM as character no-undo.
     2282      if     length (iDm) ne 25
     2283         and length (iDm) ne 29
     2284         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2285      then
     2286         vDM = substring (iDm,1,length (iDm) - 6 ).
     2287      else
     2288         vDM = substring (iDm,1,length (iDm) - 4 ).
     2289      return getQntyUTDByCodId(vDM).
     2290   end.
     2291   function getMRC4 return decimal
     2292   (iMRC as char):
     2293      define variable oMrc     as decimal no-undo init ?.
     2294      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2295      define variable vi       as integer no-undo.
     2296      define variable vfound   as integer no-undo.
     2297      define variable vposStart   as integer no-undo.
     2298      do:
     2299      OMRc = 0.
     2300      do vi = 1 to 4:
     2301         define variable vsimb as character no-undo.
     2302         vsimb = substring(iMRC,vi,1).
     2303         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2304         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2305         if vfound > 0
     2306         then
     2307            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2308         end.
     2309         OMRc = OMRc / 100.
     2310      end.
     2311      return OMRc.
     2312   end.
     2313   function getMRCByDM return decimal
     2314   (iDm as char):
     2315      define variable vMRC     as character no-undo.
     2316      define variable oMrc     as decimal no-undo init ?.
     2317      define variable Velement as character no-undo init "empty".
     2318      define variable vteg as character no-undo.
     2319      define variable vtegval as character no-undo.
     2320      if    length(idm) eq 14 + 7 + 4 + 4
     2321         or length(idm) eq 14 + 7 + 4
     2322      then do:
     2323         vMRC = substring(idm,22,4).
     2324         omrc = getMRC4(vMRC).
     2325      end.
     2326      else do:
     2327          ChekTypeMarkByDm(iDm).
     2328          block-mrc:
     2329          do while Velement ne "" and idm ne "":
     2330             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2331             if Velement begins "8005"
     2332             then do:
     2333                vMRC = substring(Velement,5,6).
     2334                leave block-mrc.
     2335             end.
     2336             else if Velement begins "(8005)"
     2337             then do:
     2338                vMRC = substring(Velement,7,6).
     2339                leave block-mrc.
     2340             end.
     2341          end.
     2342          if vMRC ne ""
     2343          then
     2344             OMRc = dec(vmrc) / 100 no-error.
     2345      end.
     2346      return OMRc.
     2347   end.
     2348   function MoveDate return Date
     2349   (idate as date,
     2350    iMonth as int64):
     2351      define variable vMonth   as int64 no-undo.
     2352      define variable vYear    as int64 no-undo.
     2353      define variable vDateNew as date  no-undo.
     2354       define variable vDay     as int64 no-undo.
     2355       vMonth = month(iDate) + iMonth.
     2356       vYear =  year(iDate).
     2357       if vMonth <= 0
     2358       then assign
     2359          vMonth = vMonth + 12
     2360           vYear  = vYear - 1
     2361       .
     2362       else if vMonth > 12
     2363       then assign
     2364          vMonth = vMonth - 12
     2365           vYear  = vYear + 1
     2366       .
     2367       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2368       do while error-status:error eq yes:
     2369          VDay = vDay + 1.
     2370          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2371       end.
     2372       if VDay > 0
     2373       then
     2374          vDateNew + 1.
     2375       return vDateNew.
     2376   end.
     2377   procedure checkEMRC:
     2378   define input  parameter iDm as character no-undo.
     2379   define output parameter vok as logical   no-undo init yes.
     2380      define variable v-value-emrc as character no-undo.
     2381      define variable v-type-emrc  as character no-undo.
     2382      define variable vDateIso     as character no-undo.
     2383      define variable vMRC         as decimal no-undo.
     2384      define variable vqnty        as decimal no-undo.
     2385      define variable vPrice       as decimal no-undo.
     2386      define variable vparent      as character no-undo.
     2387      define variable vgds-code    as integer no-undo.
     2388      define buffer code for ub.code.
     2389      vMRC = getMRCByDM(iDm).
     2390      if vMRC > 0
     2391      then do:
     2392         vgds-code = getGdsCodeByDM(iDm).
     2393         vqnty     = getQntyUTDByDM(iDm).
     2394               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2395            (
     2396             input   vgds-code
     2397            ,input   'emrc-type':U
     2398            ,output   v-value-emrc
     2399            ,output   v-type-emrc
     2400          ) no-error.
     2401          if     v-value-emrc ne ""
     2402             and v-value-emrc ne ?
     2403          then do:
     2404             vDateIso = iso-date(today).
     2405             vPrice = vMRC / vqnty.
     2406             vparent ="emc" + chr(4) + v-value-emrc.
     2407             find last code where Code.parent      eq vparent
     2408                              and Code.code        le vDateIso
     2409                              and code.status_  eq 0
     2410             no-lock no-error.
     2411             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2412             then
     2413                vOk = true .
     2414             else do:
     2415                 define variable vText      as character no-undo.
     2416                 define variable vDate      as date no-undo.
     2417                 define variable vDateLast  as character no-undo.
     2418                 define variable vDateFirst as character no-undo.
     2419                 define variable vDate3     as date no-undo.
     2420                 vdate = date(code.misc1).
     2421                 vDateLast = code.misc1.
     2422                 vDate3 = MoveDate(today, - 3 ).
     2423                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2424                                      string(vDate3  , "99/99/9999"),
     2425                                      string(vDate   , "99/99/9999")
     2426                                      ).
     2427                 vdateIso = iso-date(vdate3).
     2428                 find last code  where Code.parent      eq vparent
     2429                                   and Code.code        le vDateIso
     2430                                   and code.status_  eq 0 no-lock no-error.
     2431                 if available code
     2432                 then
     2433                    vDateIso = code.code.
     2434                 vDateFirst = vDateIso.
     2435                 vDateLast = iso-date(vdate).
     2436                 define variable vGood as logical no-undo.
     2437                 define variable vDateSale as date no-undo.
     2438                 define buffer bcode for code.
     2439                 for last code where Code.parent   eq vparent
     2440                                 and code.status_  eq 0
     2441                                 and code.code     < vDateLast
     2442                                 and code.code     >= vDateFirst
     2443                 no-lock:
     2444                    find first bcode where bCode.parent   eq vparent
     2445                                       and bcode.status_  eq 0
     2446                                       and bcode.code     > code.code no-lock no-error.
     2447                    if available bcode
     2448                    then do:
     2449                       if vPrice < dec(Code.CodeValue)
     2450                       then
     2451                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2452                                                     chr(10),
     2453                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2454                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2455                                                     ).
     2456                       else do:
     2457                          vGood = yes.
     2458                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2459                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2460                                                     chr(10),
     2461                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2462                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2463                                                     string(         vDateSale            ,"99/99/9999"),
     2464                                                     string(vDateSale - today)
     2465                                                     ).
     2466                       end.
     2467                    end.
     2468                 end.
     2469                 if vgood
     2470                 then do:
     2471                    define variable choice as integer no-undo .
     2472                    run gbl/d-askw.w (input "Уточнение"
     2473                           ,input  vText
     2474                           ,input "|"
     2475                           ,input "Принять|Вернуть"
     2476                           ,input "Принять данный товар|Вернуть товар постащику"
     2477                           ,input 1
     2478                           ,input 2
     2479                           ,output choice) no-error.
     2480                    vok = choice eq 1.
     2481                 end.
     2482                 else
     2483                    vok =false.
     2484             end.
     2485          end.
     2486      end.
     2487   end.
     2488   function addGs2Mark return character
     2489   (iMark as char):
     2490      define variable vDM   as character no-undo.
     2491      define variable vIdx  as integer   no-undo.
     2492      if index(iMark,chr(29),1) > 0
     2493      then return iMark.
     2494      if substring(iMark,26,4) = "8005" then
     2495      do:
     2496        vIdx = index(iMark,"93",26 + 4 + 5).
     2497        if vIdx > 1 then do:
     2498          vDM = substitute("&1&4&2&4&3",
     2499                           substring(iMark,1,25),
     2500                           substring(iMark,26,vIdx - 25 - 1),
     2501                           substring(iMark,vIdx),
     2502                           chr(29)) no-error.
     2503          vIdx = index(vDm,"240",vIdx + 4).
     2504          if vIdx > 0 then
     2505          do:
     2506            vDM = substitute("&1&3&2",
     2507                             substring(vDm,1,vIdx - 1),
     2508                             substring(vDm,vIdx),
     2509                             chr(29)) no-error.
     2510          end.
     2511        end.
     2512        else
     2513          vDM = substitute("&1&3&2",
     2514                           substring(iMark,1,25),
     2515                           substring(iMark,26),
     2516                           chr(29)) no-error.
     2517      end.
     2518      else if substring(iMark,32,2) = "91" then
     2519      do:
     2520        vIdx = index(iMark,"92",32).
     2521        if vIdx > 1 then
     2522          vDM = substitute("&1&4&2&4&3",
     2523                           substring(iMark,1,31),
     2524                           substring(iMark,32,vIdx - 31 - 1),
     2525                           substring(iMark,vIdx),
     2526                           chr(29)) no-error.
     2527        else
     2528          vDM = substitute("&1&3&2",
     2529                           substring(iMark,1,31),
     2530                           substring(iMark,32),
     2531                           chr(29)) no-error.
     2532      end.
     2533      else if substring(iMark,39,2) = "91" then
     2534      do:
     2535        vIdx = index(iMark,"92",38).
     2536        if vIdx > 1 then
     2537          vDM = substitute("&1&4&2&4&3",
     2538                           substring(iMark,1,38),
     2539                           substring(iMark,39,vIdx - 38 - 1),
     2540                           substring(iMark,vIdx),
     2541                           chr(29)) no-error.
     2542        else
     2543          vDM = substitute("&1&3&2",
     2544                           substring(iMark,1,38),
     2545                           substring(iMark,39),
     2546                           chr(29)) no-error.
     2547      end.
     2548      else if substring(iMark,25,2) = "93" then
     2549      do:
     2550        vIdx = index(iMark,"92",25).
     2551        if vIdx > 1 then
     2552          vDM = substitute("&1&4&2&4&3",
     2553                           substring(iMark,1,24),
     2554                           substring(iMark,25,vIdx - 24 - 1),
     2555                           substring(iMark,vIdx),
     2556                           chr(29)) no-error.
     2557        else
     2558          vIdx = index(iMark,"3103",25).
     2559          if vIdx > 0 then
     2560          vDM = substitute("&1&4&2&4&3",
     2561                           substring(iMark,1,24),
     2562                           substring(iMark,25,vIdx - 24 - 1),
     2563                           substring(iMark,vIdx),
     2564                           chr(29)) no-error.
     2565          else
     2566            vDM = substitute("&1&3&2",
     2567                             substring(iMark,1,24),
     2568                             substring(iMark,25),
     2569                             chr(29)) no-error.
     2570      end.
     2571      else if substring(iMark,32,2) = "93" then
     2572      do:
     2573        vDM = substitute("&1&3&2",
     2574              substring(iMark,1,31),
     2575              substring(iMark,32),
     2576              chr(29)) no-error.
     2577      end.
     2578      return if vDM <> "" then vDm else iMark.
     2579   end.
     2580   define buffer t-doc      for ub.trn-doc .
     2581   define buffer p-doc-line for ub.doc-line .
     2582   define buffer p-goods    for ub.goods .
     2583   define buffer bf_gds-obj for ub.gds-obj .
     2584   define buffer bf-parts   for ub.parts .
     2585   define buffer bf_doc-pl  for ub.doc-pl .
     2586   define buffer bf_parts   for ub.parts.
     2587   define buffer bf_marking-lines for ub.marking-lines .
     2588   define buffer in_parts   for ub.parts.
     2589   define variable part-list                                 as   character initial ""       no-undo.
     2590   define variable add-sens                                  as   logical                    no-undo.
     2591   define variable g-type                                    as   character initial ?        no-undo.
     2592   define variable qnty-str                                  as   character                  no-undo.
     2593   define variable rate                                      as   decimal                    no-undo.
     2594   define variable is-all                                    as   logical                    no-undo.
     2595   define variable b-c                                       as   integer                    no-undo.
     2596   define variable line-mode                                 as   character                  no-undo.
     2597   define variable v-is-return                               as   logical                    no-undo.
     2598   def var mess as char no-undo.
     2599   procedure proc-code.
     2600   define input parameter pl-str as char no-undo.
     2601   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
     2602   define input parameter parscales-pref as character no-undo.
     2603   define input parameter parpgscales-pref as character no-undo.
     2604   define buffer b-bar-code for ub.bar-code.
     2605   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
     2606   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
     2607   define variable varres        as logical         no-undo.
     2608   define variable var-code-temp like ub.place.pl-code no-undo.
     2609   define buffer pc-goods for ub.goods.
     2610   define variable g-log-char as character no-undo.
     2611   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
     2612   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
     2613   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
     2614   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
     2615   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
     2616   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
     2617   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
     2618   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
     2619   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
     2620   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
     2621   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
     2622   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
     2623   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
     2624   define variable lns-cnt                 as   integer               no-undo.
     2625   IF mode-proc = "PLACE" THEN DO:
     2626       do lns-cnt = 1 to num-entries (part-list):
     2627         find ub.bar-code where ub.bar-code.b-code  = integer (entry (lns-cnt, part-list)) no-lock.
     2628         find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
     2629         RUN plgdsfnd (input  no,
     2630                       input  v-cntxt-obj-type,
     2631                       input  v-cntxt-obj-code,
     2632                       input  pc-goods.gds-code,
     2633                       output varres,
     2634                       output var-code-temp) no-error.
     2635        if varres = yes or error-status:error then do:
     2636             MESSAGE "Нельзя перемещать партии товара по складским местам "
     2637             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     2638             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "
     2639           VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2640         end.
     2641         else
     2642         for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
     2643                          and ub.parts.obj-code  = v-cntxt-obj-code
     2644                          and ub.parts.artic     = pc-goods.artic
     2645                          and ub.parts.prod-type = pc-goods.prod-type
     2646                          and ub.parts.prod-code = pc-goods.prod-code
     2647                          and ub.parts.in-code   = ub.bar-code.in-code
     2648                          and ub.parts.part-code = ub.bar-code.part-code
     2649                          and ub.parts.rsrv-free = yes:
     2650           ub.parts.pl-code = ub.place.pl-code.
     2651         end.
     2652       end.
     2653       part-list = "".
     2654   END.
     2655   ELSE DO:
     2656     if add-sens = ? then part-list = if part-list = "" then string (b-c) else part-list + "," + string (b-c).
     2657     else do:
     2658       if ub.goods.gds-type <> 'т':U and (t-doc.doc-type <> 'рас':U or t-doc.internal) then do:
     2659         MESSAGE "Услуга не соответствует типу данной накладной."
     2660           VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2661         return error.
     2662       end.
     2663       if g-type = ? then g-type = ub.goods.gds-type.
     2664       if g-type <> ub.goods.gds-type then do:
     2665         MESSAGE "Тип товара не соответствует типу данной накладной."
     2666           VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2667         return error.
     2668       end.
     2669       assign g-log-char = "yes".
     2670       do transaction on error undo , leave:
     2671          define variable tempmess as character no-undo.
     2672          define buffer bf_doc-line for ub.doc-line.
     2673          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
     2674                                    ub.doc-line.artic     = ub.goods.artic     and
     2675                                    ub.doc-line.prod-type = ub.goods.prod-type and
     2676                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
     2677          if available ub.doc-line then do:
     2678             assign
     2679             mode-create = no
     2680             varprice-cli-old       = ub.doc-line.price-cli
     2681             varprice-rubl-old      = ub.doc-line.price-rubl
     2682             varprice-base-old      = ub.doc-line.price-base
     2683             varcli-qnty-old        = ub.doc-line.cli-qnty
     2684             varcli-base-rate-old   = ub.doc-line.cli-base-rate
     2685             varfact-qnty-old       = ub.doc-line.fact-qnty
     2686             vardoc-qnty-old        = ub.doc-line.doc-qnty
     2687             varvat-pc-old          = ub.doc-line.vat-pc
     2688             varslt-pc-old          = ub.doc-line.slt-pc
     2689             varroad-tax-old        = ub.doc-line.road-tax
     2690             varexcise-old          = ub.doc-line.excise
     2691             vartransport-rubl-old  = ub.doc-line.transport-rubl
     2692             varother-rubl-old      = ub.doc-line.other-rubl.
     2693          end.
     2694          else mode-create = yes.
     2695   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-scn in g#lib-trn
     2696     ( input  parparentproc
     2697      ,input  recid(t-doc)
     2698      ,input  bar-code.b-code
     2699      ,input  decimal(qnty-str) * rate
     2700      ,input  is-all
     2701      ,input  add-sens
     2702      ,input  line-mode
     2703      ,output tempmess
     2704      ,output g-log-char
     2705     ) no-error .
     2706          assign
     2707          mess = mess + tempmess.
     2708          if error-status:error then do:
     2709            assign
     2710            mess = mess + return-value.
     2711            MESSAGE "Ошибка"
     2712              VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2713            return error.
     2714          end.
     2715          else do:
     2716            if pl-str <> "" then run store-place in this-procedure ( input pl-str
     2717                                                                    ,input parscales-pref
     2718                                                                    ,input parpgscales-pref
     2719                                                                    ).
     2720          end.
     2721          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
     2722                                    ub.doc-line.artic     = ub.goods.artic     and
     2723                                    ub.doc-line.prod-type = ub.goods.prod-type and
     2724                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
     2725          if t-doc.doc-type = 'при':U then do:
     2726            if mode-create then do:
     2727   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     2728     (
     2729      input parparentproc
     2730     ,input recid(doc-line)
     2731     ,input t-doc.doc-code
     2732     ,input ub.doc-line.artic
     2733     ,input ub.doc-line.prod-type
     2734     ,input ub.doc-line.prod-code
     2735     ,input 0
     2736     ,input 0
     2737     ,input 0
     2738     ,input 0
     2739     ,input 0
     2740     ,input 0
     2741     ,input 0
     2742     ,input 0
     2743     ,input 0
     2744     ,input 0
     2745     ,input 0
     2746     ,input 0
     2747     ,input 0
     2748     ,input 'create'
     2749     ,input ''
     2750     ) no-error.
     2751               if error-status:error then return error return-value.
     2752            end.
     2753            else do:
     2754   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     2755     (
