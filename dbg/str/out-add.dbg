     4015             for each bf_doc-pl exclusive-lock
     4016               where bf_doc-pl.obj-type = ub.gds-dtl.obj-type
     4017                 and bf_doc-pl.obj-code = ub.gds-dtl.obj-code
     4018                 and bf_doc-pl.out-code = ub.gds-dtl.doc-code
