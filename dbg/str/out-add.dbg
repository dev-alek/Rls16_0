      688     define variable v-cntxp-db-num          as integer   no-undo .
      689     define variable v-cntxp-userid          as character no-undo .
      690     define variable v-cntxp-level           as character no-undo .
      691     define variable v-cntxp-db-num-obj      as integer   no-undo .
      692     define variable v-cntxp-is-admin        as logical   no-undo .
      693     define buffer bf-cntxp_store for ub.store.
      694     define buffer bf-cntxp_shop  for ub.shop.
      695     define buffer bf-cntxp_sysconf for ub.sysconf.
      696   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697     run mainmenu_getcntxt in parparentproc
      698       (output v-cntxp-db-num
      699       ,output v-cntxp-userid
      700       ,output v-cntxp-level
      701       ,output v-cntxp-curr-host-code
      702       ,output v-cntxp-obj-type
      703       ,output v-cntxp-obj-code
      704       ,output v-cntxp-db-num-obj
      705       ,output v-cntxp-is-admin
      706       ) .
      707     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      708        v-cntxp-obj-code <> 0 then do:
      709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      710     (input  'is-prt'
      711     ,input  0
      712     ,input  ''
      713     ,input  0
      714     ,input  ''
      715     ,input  ''
      716     ,input  ''
      717     ,input  yes
      718     ,output v-cntxp-conf-par
      719     ,output v-cntxp-par-type
      720     ) no-error .
      721       case v-cntxp-obj-type :
      722         when 'скл':U then do:
