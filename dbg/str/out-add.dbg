        1   block-level on error undo, throw.
        2   define input parameter ParParentProc as handle    no-undo .
        3   define input parameter pardoc-rec    as recid     no-undo .
        4   define input parameter parline-rec   as recid     no-undo .
        5   define input parameter parprt-rec    as recid     no-undo .
        6   define input parameter pargds-rec    as recid     no-undo .
        7   define input parameter work-mode     as character no-undo format "x(30)":U .
        8   define input parameter parvalue      as character no-undo .
        9   define variable vss-revision    as character no-undo initial "$Revision: 91c8196f6fee, 3209, rls $":U .
       10   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
       11   define variable vss-date        as character no-undo initial "$Date: 2022/12/27 12:54:28 $":U .
       12   define variable vss-workfile    as character no-undo initial "$Workfile: out-add.p $":U .
       13   define variable vss-archive     as character no-undo initial "$Archive: str/out-add.p $":U .
       14   define variable vss-description as character no-undo initial "Добавление строк в РН, СН, ВН при заданном товаре":U .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2':u,work-mode,parvalue)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
       80   define variable gp-price-sale like ub.price-list.price-sale no-undo.
       81   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
       82   define variable gp-excise     like ub.price-list.excise     no-undo.
       83   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
       84   define variable gp-fact-order as decimal   no-undo .
       85   define variable gp-price-sale-parts as decimal   no-undo .
       86     define temp-table  tt-tax no-undo
       87   field tax-code    like ub.tax.tax-code
       88   FIELD individual  like ub.tax.individual
       89   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       90   field rate-code   like ub.tax-rate.rate-code
       91   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       92   FIELD tax-type    like ub.tax.tax-type
       93   field rate-value  like ub.tax-rate-value.rate-value
       94   FIELD tax-rate-gds-rc  as recid
       95   FIELD to-cashdesk like ub.tax.to-cashdesk
       96   index tax-code is unique primary tax-code.
       97   define new global shared variable g#lib-trn  as handle no-undo .
       98   define new global shared variable g#lib-trn2 as handle no-undo .
       99   define new global shared variable g#lib-trn3 as handle no-undo .
      100   define new global shared variable g#lib-trn4 as handle no-undo .
      101   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define new global shared variable g#lib-calc as handle no-undo .
      103   define new global shared variable g#libbcrcn as handle no-undo .
      104   function cross-list returns logical (
      105     input parfirst-stream  as character,
      106     input parsecond-stream as character,
      107     input pardelim         as character).
      108     if pardelim = ""
      109     or pardelim = ?
      110     then do:
      111       assign
      112         pardelim = ","
      113       .
      114     end.
      115     define variable vari            as integer no-undo .
      116     define variable varresult-cross as logical no-undo .
      117     assign
      118       varresult-cross = no
      119     .
      120     def var v-num-parfirst-stream as integer no-undo .
      121     assign
      122       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      123     .
      124     do vari = 1 to v-num-parfirst-stream
      125     :
      126       if lookup(entry(vari, parfirst-stream, pardelim)
      127                ,parsecond-stream
      128                ,pardelim
      129                ) > 0 then do:
      130         assign
      131           varresult-cross = yes
      132         .
      133         leave.
      134       end.
      135     end.
      136     return varresult-cross .
      137   end function.
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   procedure lineattr-value :
      140     do
      141     on error undo, return error return-value
      142     :
      143       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      144       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      145       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      146       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      147       define output parameter p-type     as character no-undo .
      148       define buffer buf_doc-line-attr for ub.doc-line-attr .
      149       def var v-format         as character no-undo .
      150       def var v-fillin_width   as integer   no-undo .
      151       def var v-fillin_height  as integer   no-undo .
      152       def var v-label          as character no-undo .
      153       def var v-user-can-edit  as logical   no-undo .
      154       def var v-output-display as logical   no-undo .
      155       def var v-other          as character no-undo .
      156       run lineattr-code in this-procedure
      157         (input  p-code
      158         ,output p-type
      159         ,output v-format
      160         ,output v-fillin_width
      161         ,output v-fillin_height
      162         ,output v-label
      163         ,output v-user-can-edit
      164         ,output v-output-display
      165         ,output v-other
      166         ) no-error .
      167       if error-status :error then do:
      168         undo, return error return-value .
      169       end.
      170       find first buf_doc-line-attr no-lock
      171         where buf_doc-line-attr.doc-code  = p-doc-code
      172           and buf_doc-line-attr.gds-code  = p-gds-code
      173           and buf_doc-line-attr.attr-code = p-code
      174         no-error .
      175       if avail buf_doc-line-attr then do:
      176         assign
      177           p-value =  buf_doc-line-attr.attr-value
      178         .
      179       end.
      180       else do:
      181         assign
      182           p-value = if p-type = 'L':U then "no":U else ""
      183         .
      184       end.
      185     end.
      186   end procedure.
      187   procedure lineattr-write :
      188     do
      189     on error undo, return error return-value
      190     :
      191       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      192       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      193       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      194       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      195       define buffer buf_doc-line-attr for ub.doc-line-attr .
      196       def var v-type           as character no-undo .
      197       def var v-format         as character no-undo .
      198       def var v-fillin_width   as integer   no-undo .
      199       def var v-fillin_height  as integer   no-undo .
      200       def var v-label          as character no-undo .
      201       def var v-user-can-edit  as logical   no-undo .
      202       def var v-output-display as logical   no-undo .
      203       def var v-other          as character no-undo .
      204       run lineattr-code in this-procedure
      205         (input  p-code
      206         ,output v-type
      207         ,output v-format
      208         ,output v-fillin_width
      209         ,output v-fillin_height
      210         ,output v-label
      211         ,output v-user-can-edit
      212         ,output v-output-display
      213         ,output v-other
      214         ) no-error .
      215       if error-status :error then do:
      216         undo, return error return-value .
      217       end.
      218       find first buf_doc-line-attr exclusive-lock
      219         where buf_doc-line-attr.doc-code  = p-doc-code
      220           and buf_doc-line-attr.gds-code  = p-gds-code
      221           and buf_doc-line-attr.attr-code = p-code
      222         no-error .
      223       if not available buf_doc-line-attr then do:
      224         create buf_doc-line-attr .
      225         assign
      226           buf_doc-line-attr.doc-code  = p-doc-code
      227           buf_doc-line-attr.gds-code = p-gds-code
      228           buf_doc-line-attr.attr-code = p-code
      229         .
      230       end.
      231       assign
      232         buf_doc-line-attr.attr-value = p-value
      233       .
      234        release buf_doc-line-attr.
      235     end.
      236   end procedure.
      237   procedure lineattr-exist :
      238     do
      239     on error undo, return error return-value
      240     :
      241       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      242       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      243       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      244       define output parameter p-exist   as logical  no-undo .
      245       define buffer buf_doc-line-attr for ub.doc-line-attr .
      246       def var v-type           as character no-undo .
      247       def var v-format         as character no-undo .
      248       def var v-fillin_width   as integer   no-undo .
      249       def var v-fillin_height  as integer   no-undo .
      250       def var v-label          as character no-undo .
      251       def var v-user-can-edit  as logical   no-undo .
      252       def var v-output-display as logical   no-undo .
      253       def var v-other          as character no-undo .
      254       run lineattr-code in this-procedure
      255         (input  p-code
      256         ,output v-type
      257         ,output v-format
      258         ,output v-fillin_width
      259         ,output v-fillin_height
      260         ,output v-label
      261         ,output v-user-can-edit
      262         ,output v-output-display
      263         ,output v-other
      264         ) no-error .
      265       if error-status :error then do:
      266         undo, return error return-value .
      267       end.
      268       find first buf_doc-line-attr no-lock
      269         where buf_doc-line-attr.doc-code  = p-doc-code
      270           and buf_doc-line-attr.gds-code = p-gds-code
      271           and buf_doc-line-attr.attr-code = p-code
      272         no-error .
      273       if  available buf_doc-line-attr then do:
      274         p-exist = yes.
      275       end.
      276     end.
      277   end procedure.
      278   procedure lineattr-delete :
      279     do
      280     on error undo, return error return-value
      281     :
      282       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      283       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      284       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      285       define output parameter p-deleted  as logical no-undo.
      286       define buffer buf_doc-line-attr for ub.doc-line-attr .
      287       def var v-type           as character no-undo .
      288       def var v-format         as character no-undo .
      289       def var v-fillin_width   as integer   no-undo .
      290       def var v-fillin_height  as integer   no-undo .
      291       def var v-label          as character no-undo .
      292       def var v-user-can-edit  as logical   no-undo .
      293       def var v-output-display as logical   no-undo .
      294       def var v-other          as character no-undo .
      295       run lineattr-code in this-procedure
      296         (input  p-code
      297         ,output v-type
      298         ,output v-format
      299         ,output v-fillin_width
      300         ,output v-fillin_height
      301         ,output v-label
      302         ,output v-user-can-edit
      303         ,output v-output-display
      304         ,output v-other
      305         ) no-error .
      306       if error-status :error then do:
      307         undo, return error return-value .
      308       end.
      309       find first buf_doc-line-attr exclusive-lock
      310         where buf_doc-line-attr.doc-code  = p-doc-code
      311           and buf_doc-line-attr.gds-code  = p-gds-code
      312           and buf_doc-line-attr.attr-code = p-code
      313         no-error NO-WAIT.
      314       if not available buf_doc-line-attr then do:
      315         p-deleted = no.
      316       end.
      317       else do:
      318         delete buf_doc-line-attr.
      319         p-deleted = yes.
      320       end.
      321     end.
      322   end procedure.
      323   procedure lineattr-code :
      324     do on error undo, return error return-value
      325     :
      326       define input  parameter p-code           as character no-undo .
      327       define output parameter p-type           as character no-undo .
      328       define output parameter p-format         as character no-undo .
      329       define output parameter p-fillin_width   as integer   no-undo .
      330       define output parameter p-fillin_height  as integer   no-undo .
      331       define output parameter p-label          as character no-undo .
      332       define output parameter p-user-can-edit  as logical   no-undo .
      333       define output parameter p-output-display as logical   no-undo .
      334       define output parameter p-other          as character no-undo .
      335       case p-code :
      336               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      337               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      338               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      339               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      340               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      341               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      342               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      343               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      344               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      345               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      346               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      347         otherwise do:
      348           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      349         end.
      350       end.
      351     end.
      352   end procedure.
      353   procedure lineattr-value-flora-gds :
      354     do
      355     on error undo, return error return-value
      356     :
      357       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      358       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      359       define input  parameter p-prt-code    as integer   no-undo .
      360       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      361       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      362       define output parameter p-value       as    decimal   no-undo .
      363       define buffer buf_doc-line-attr for ub.doc-line-attr .
      364       find first buf_doc-line-attr no-lock
      365         where buf_doc-line-attr.doc-code  = p-doc-code
      366           and buf_doc-line-attr.gds-code  = p-gds-code
      367           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      368         no-error .
      369       if avail buf_doc-line-attr then do:
      370         assign
      371           p-value = decimal( buf_doc-line-attr.attr-value)
      372         .
      373       end.
      374       else do:
      375         assign
      376           p-value = 0
      377         .
      378       end.
      379     end.
      380   end procedure.
      381   procedure lineattr-write-flora-gds :
      382     do
      383     on error undo, return error return-value
      384     :
      385       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      386       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      387       define input parameter p-prt-code    as integer   no-undo .
      388       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      389       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      390       define input parameter p-value    as decimal   no-undo .
      391       define buffer buf_doc-line-attr for ub.doc-line-attr .
      392       find first buf_doc-line-attr exclusive-lock
      393         where buf_doc-line-attr.doc-code  = p-doc-code
      394           and buf_doc-line-attr.gds-code  = p-gds-code
      395           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      396         no-error .
      397       if not available buf_doc-line-attr then do:
      398         create buf_doc-line-attr .
      399         assign
      400           buf_doc-line-attr.doc-code  = p-doc-code
      401           buf_doc-line-attr.gds-code  = p-gds-code
      402           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      403         .
      404       end.
      405       assign
      406         buf_doc-line-attr.attr-value = string( p-value )
      407       .
      408     end.
      409   end procedure.
      410   procedure lineattr-delete-flora-gds :
      411     do
      412     on error undo, return error return-value
      413     :
      414       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      415       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      416       define input  parameter p-prt-code    as integer   no-undo .
      417       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      418       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      419       define output parameter p-deleted  as logical no-undo.
      420       define buffer buf_doc-line-attr for ub.doc-line-attr .
      421       find first buf_doc-line-attr exclusive-lock
      422         where buf_doc-line-attr.doc-code  = p-doc-code
      423           and buf_doc-line-attr.gds-code  = p-gds-code
      424           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      425         no-error NO-WAIT.
      426       if not available buf_doc-line-attr then do:
      427         p-deleted = no.
      428       end.
      429       else do:
      430         delete buf_doc-line-attr.
      431         p-deleted = yes.
      432       end.
      433     end.
      434   end procedure.
      435   procedure lineattr-delete-flora-all :
      436     do
      437     on error undo, return error return-value
      438     :
      439       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      440       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      441       define input  parameter p-prt-code    as integer   no-undo .
      442       define buffer buf_doc-line-attr for ub.doc-line-attr .
      443       for each buf_doc-line-attr exclusive-lock
      444         where buf_doc-line-attr.doc-code  = p-doc-code
      445           and buf_doc-line-attr.gds-code  = p-gds-code
      446           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      447        :
      448         delete buf_doc-line-attr.
      449       end.
      450    end.
      451   end procedure.
      452   procedure lineattr-exist-flora-gds :
      453     do
      454     on error undo, return error return-value
      455     :
      456       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      457       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      458       define input  parameter p-prt-code    as integer   no-undo .
      459       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      460       define output parameter p-exist as logical   no-undo .
      461       define buffer buf_doc-line-attr for ub.doc-line-attr .
      462       p-exist = false .
      463       find first buf_doc-line-attr no-lock
      464         where buf_doc-line-attr.doc-code  = p-doc-code
      465           and buf_doc-line-attr.gds-code  = p-gds-code
      466           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      467         no-error .
      468       if avail buf_doc-line-attr then do:
      469         assign
      470          p-exist = true
      471         .
      472       end.
      473     end.
      474   end procedure.
      475   procedure lineattr-write-add-line-cli :
      476   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      477   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      478   define input  parameter p-cli-type      as character no-undo .
      479   define input  parameter p-cli-code      as integer   no-undo .
      480   define input  parameter p-contract-code as integer   no-undo .
      481   define input  parameter p-host-code     as integer   no-undo .
      482   define input  parameter p-exch-code     as integer   no-undo .
      483   define input  parameter p-exch-rate     as decimal   no-undo .
      484   define input  parameter p-exch-scale    as integer   no-undo .
      485   define input  parameter p-sum-cli       as decimal   no-undo .
      486   define input  parameter p-sum-vat       as decimal   no-undo .
      487   define buffer buf_doc-line-attr for ub.doc-line-attr .
      488     do
      489     on error undo, return error return-value
      490     :
      491       find first buf_doc-line-attr exclusive-lock
      492         where buf_doc-line-attr.doc-code  = p-doc-code
      493           and buf_doc-line-attr.gds-code  = p-gds-code
      494           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      495                                             chr(4) + p-cli-type +
      496                                             chr(4) + string(p-cli-code) +
      497                                             chr(4) + string(p-contract-code) +
      498                                             chr(4) + string(p-host-code)
      499         no-error .
      500       if not available buf_doc-line-attr then do:
      501         create buf_doc-line-attr .
      502         assign
      503           buf_doc-line-attr.doc-code  = p-doc-code
      504           buf_doc-line-attr.gds-code  = p-gds-code
      505           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      506                                         chr(4) + p-cli-type +
      507                                         chr(4) + string(p-cli-code) +
      508                                         chr(4) + string(p-contract-code) +
      509                                         chr(4) + string(p-host-code)
      510         .
      511       end.
      512       assign
      513         buf_doc-line-attr.attr-value =
      514         string(p-exch-code)  + chr(4) +
      515         string(p-exch-rate)  + chr(4) +
      516         string(p-exch-scale) + chr(4) +
      517         string(p-sum-cli)    + chr(4) +
      518         string(p-sum-vat)
      519         .
      520     end.
      521   end procedure.
      522   procedure lineattr-value-add-line-cli :
      523   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      524   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      525   define input   parameter p-cli-type      as character no-undo .
      526   define input   parameter p-cli-code      as integer   no-undo .
      527   define input   parameter p-contract-code as integer   no-undo .
      528   define input   parameter p-host-code     as integer   no-undo .
      529   define output  parameter p-exch-code     as integer   no-undo .
      530   define output  parameter p-exch-rate     as decimal   no-undo .
      531   define output  parameter p-exch-scale    as integer   no-undo .
      532   define output  parameter p-sum-cli       as decimal   no-undo .
      533   define output  parameter p-sum-vat       as decimal   no-undo .
      534   define buffer buf_doc-line-attr for ub.doc-line-attr .
      535     do
      536     on error undo, return error return-value
      537     :
      538       find first buf_doc-line-attr exclusive-lock
      539         where buf_doc-line-attr.doc-code  = p-doc-code
      540           and buf_doc-line-attr.gds-code  = p-gds-code
      541           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      542                                             chr(4) + p-cli-type +
      543                                             chr(4) + string(p-cli-code) +
      544                                             chr(4) + string(p-contract-code) +
      545                                             chr(4) + string(p-host-code)
      546         no-error .
      547       if available buf_doc-line-attr then do:
      548        assign
      549           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      550           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      551           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      552           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      553           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      554          .
      555        end.
      556     end.
      557   end procedure.
      558   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      559     define variable v-code as character no-undo .
      560     define variable v-type as character no-undo .
      561     define variable v-gds-code as integer   no-undo .
      562   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      564     (input  local-doc-line.artic
      565     ,input  local-doc-line.prod-type
      566     ,input  local-doc-line.prod-code
      567     ,output v-gds-code
      568     )  .
      569     run lineattr-value (
      570         input   local-doc-line.doc-code ,
      571         input   v-gds-code              ,
      572         input   'reason-code':U ,
      573         output  v-code                  ,
      574         output  v-type ) .
      575     find first ub.trn-reason no-lock where
      576                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      577     if not available ub.trn-reason then do:
      578        return "" .
      579     end.
      580     else do:
      581        return ub.trn-reason.reason-name .
      582     end.
      583   end function.
      584   procedure lineattr-value-parts :
      585     do
      586     on error undo, return error return-value
      587     :
      588       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      589       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      590       define input  parameter p-part-code   as character no-undo .
      591       define input  parameter p_in-code     as character no-undo .
      592       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      593       define output parameter p-value       as    decimal   no-undo .
      594       define buffer buf_doc-line-attr for ub.doc-line-attr .
      595       find first buf_doc-line-attr no-lock
      596         where buf_doc-line-attr.doc-code  = p-doc-code
      597           and buf_doc-line-attr.gds-code  = p-gds-code
      598           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      599         no-error .
      600       if avail buf_doc-line-attr then do:
      601         assign
      602           p-value = decimal( buf_doc-line-attr.attr-value)
      603         .
      604       end.
      605       else do:
      606         assign
      607           p-value = 0
      608         .
      609       end.
      610     end.
      611   end procedure.
      612   procedure lineattr-write-parts :
      613     do
      614     on error undo, return error return-value
      615     :
      616       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      617       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      618       define input parameter p-part-code  as character no-undo .
      619       define input parameter p_in-code    as character no-undo .
      620       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      621       define input parameter p-value      as decimal   no-undo .
      622       define buffer buf_doc-line-attr for ub.doc-line-attr .
      623       find first buf_doc-line-attr exclusive-lock
      624         where buf_doc-line-attr.doc-code  = p-doc-code
      625           and buf_doc-line-attr.gds-code  = p-gds-code
      626           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      627         no-error .
      628       if not available buf_doc-line-attr then do:
      629         create buf_doc-line-attr .
      630         assign
      631           buf_doc-line-attr.doc-code  = p-doc-code
      632           buf_doc-line-attr.gds-code  = p-gds-code
      633           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      634         .
      635       end.
      636       assign
      637         buf_doc-line-attr.attr-value = string( p-value )
      638       .
      639     end.
      640   end procedure.
