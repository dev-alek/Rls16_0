      730             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      731             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      732             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      733             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      734             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      735             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      736             v-cntxp-load-time       = bf-cntxp_store.load-time
      737             v-cntxp-holidays        = bf-cntxp_store.holidays
      738             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      739             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      740             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      741             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      742             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      743             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      744             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      745             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      746             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      747             .
      748         end.
      749         when 'маг':U then do:
      750           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      751           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      752           assign
      753             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      754             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      755             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      756             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      757             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      758             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      759             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      760             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      761             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      762             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      763             v-cntxp-load-time       = bf-cntxp_shop.load-time
      764             v-cntxp-holidays        = bf-cntxp_shop.holidays
      765             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      766             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      767             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      768             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      769             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      770             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
