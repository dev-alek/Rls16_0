     2787   procedure store-place:
     2788   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
     2789   define input parameter parscales-pref as character no-undo.
     2790   define input parameter parpgscales-pref as character no-undo.
     2791   define variable pl-c as int no-undo.
     2792   define variable varres        as logical         no-undo.
     2793   define variable var-code-temp like ub.place.pl-code no-undo.
     2794   define variable varresult   as character       no-undo.
     2795   define variable vartype-bc  as character       no-undo.
     2796   define variable varweight   as decimal         no-undo.
     2797   define buffer pc-goods for ub.goods.
     2798   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     2799   (
     2800    input  parparentproc
     2801   ,input  pl-str
     2802   ,input  ?
     2803   ,input  v-cntxt-obj-type
     2804   ,input  v-cntxt-obj-code
     2805   ,input  yes
     2806   ,input  no
     2807   ,input  parscales-pref
     2808   ,input  parpgscales-pref
     2809   ,output varresult
     2810   ,output vartype-bc
     2811   ,output varweight
     2812   ,buffer ub.bar-code
     2813   ,buffer ub.prod-bc
     2814   ,buffer ub.place
     2815   ) no-error.
     2816   if error-status:error then do:
     2817     return error "Ошибка при разборе бар-кода: " + pl-str.
     2818   end.
     2819   if available place then do:
     2820     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
     2821     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
     2822     RUN plgdsfnd (input  no,
     2823                   input  v-cntxt-obj-type,
     2824                   input  v-cntxt-obj-code,
     2825                   input  pc-goods.gds-code,
     2826                   output varres,
     2827                   output var-code-temp) no-error.
     2828     if varres = yes or error-status:error then do:
     2829         MESSAGE "Нельзя перемещать партии товара по складским местам "
     2830             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
     2831             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "
     2832           VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2833     end.
     2834     else
     2835     for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
     2836                      and ub.parts.obj-code  = v-cntxt-obj-code
     2837                      and ub.parts.artic     = pc-goods.artic
     2838                      and ub.parts.prod-type = pc-goods.prod-type
     2839                      and ub.parts.prod-code = pc-goods.prod-code
     2840                      and ub.parts.in-code   = ub.bar-code.in-code
     2841                      and ub.parts.part-code = ub.bar-code.part-code:
     2842       if ub.parts.rsrv-free or
     2843          ub.parts.out-code = t-doc.doc-code then ub.parts.pl-code = ub.place.pl-code.
     2844     end.
     2845   end.
     2846   end procedure.
     2847   procedure plgdsfnd :
     2848     define input  parameter p-chk-and-chs    as logical               no-undo .
     2849     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     2850     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     2851     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     2852     define output parameter p-reserv-pl-code as   logical             no-undo .
     2853     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     2854     define buffer buf_goods         for ub.goods .
     2855     define buffer buf_pl-gds        for ub.pl-gds .
     2856     define buffer buf_second_pl-gds for ub.pl-gds .
     2857     find first buf_goods no-lock where
     2858                buf_goods.gds-code = p-gds-code no-error .
     2859     if not available buf_goods
     2860     then do:
     2861       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     2862     end.
     2863   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2865     (input  p-obj-type
     2866     ,input  p-obj-code
     2867     ,input  buf_goods.artic
     2868     ,input  buf_goods.prod-type
     2869     ,input  buf_goods.prod-code
     2870     ,input  'place-rsrv=request'
     2871     ,output p-reserv-pl-code
     2872     ) no-error .
     2873     if error-status :error
     2874     then do:
     2875       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     2876     end.
     2877     if p-reserv-pl-code = no
     2878     then do:
     2879       return .
     2880     end.
     2881     if p-chk-and-chs <> yes
     2882     then do:
     2883       return .
     2884     end.
     2885     find first buf_pl-gds no-lock where
     2886                buf_pl-gds.obj-type = p-obj-type and
     2887                buf_pl-gds.obj-code = p-obj-code and
     2888                buf_pl-gds.gds-code = p-gds-code no-error .
     2889     if not available buf_pl-gds
     2890     then do:
     2891       return error "К товару не привязано ни одного места хранения" .
     2892     end.
     2893     find first buf_second_pl-gds no-lock where
     2894                buf_second_pl-gds.obj-type  = p-obj-type          and
     2895                buf_second_pl-gds.obj-code  = p-obj-code          and
     2896                buf_second_pl-gds.gds-code  = p-gds-code          and
     2897                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     2898     if not available buf_second_pl-gds
     2899     then do:
     2900       assign
     2901         p-pl-code = buf_pl-gds.pl-code
     2902       .
     2903     end.
     2904     else do:
     2905       run str/plgdssel.p
     2906         (
     2907            input parparentproc
     2908         ,  input p-obj-type
     2909         ,  input p-obj-code
     2910         ,  input p-gds-code
     2911         , output p-pl-code
     2912         ) no-error .
     2913       if error-status :error
     2914       then do:
     2915         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     2916                                , 'plgdssel.p':U
     2917                                , chr(10)
     2918                                , error-status :get-message( 1 )
     2919                                , return-value
     2920                                ) .
     2921       end.
     2922       if p-pl-code = ? or
     2923          p-pl-code = 0
     2924       then do:
     2925         return error "Не выбрано место хранения " + chr(10) .
     2926       end.
     2927     end.
     2928   end procedure.
