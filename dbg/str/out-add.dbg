      788   define new global shared variable g#attr-lib  as handle no-undo .
      789   define variable v-attr-lib-variable as handle no-undo .
      790   procedure gds-attr-name :
      791     define input  parameter p-code           as character no-undo .
      792     define output parameter p-type           as character no-undo .
      793     define output parameter p-format         as character no-undo .
      794     define output parameter p-label          as character no-undo .
      795     define output parameter p-user-can-edit  as logical   no-undo .
      796     define output parameter p-output-display as logical   no-undo .
      797     define output parameter p-other          as character no-undo .
      798     do
