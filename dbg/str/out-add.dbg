     4028                 , buffer       ub.gds-dtl
     4029                 , input-output d_unrv-qty
     4030                 , input-output p-doc-line.price-base
     4031                 , input-output p-doc-line.price-rubl
     4032                 , input        -1
     4033                 , input       if parvalue begins 'scan-mark' then entry(2,parvalue,chr(3)) else ""
     4034                 ) no-error .
     4035               if error-status :error
     4036               then do:
     4037                 undo, return error .
