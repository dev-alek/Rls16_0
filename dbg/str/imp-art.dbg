        1   block-level on error undo, throw.
        2   define input parameter parParentProc  as widget-handle no-undo.
        3   define input parameter parchoice        as integer             no-undo.
        4   define input parameter parInputFileName as character           no-undo.
        5   define input parameter parInputCoding   as character           no-undo.
        6   define input parameter pare-code        like trn-doc.exch-code no-undo.
        7   define input parameter pardoc-code      like trn-doc.doc-code  no-undo.
        8   define input parameter parcli-type   like ub.trn-doc.cli-type  no-undo.
        9   define input parameter parcli-code   like ub.trn-doc.cli-code  no-undo.
       10   define input parameter parhost-code  like ub.trn-doc.host-code no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: imp-art.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: str/imp-art.p $":U .
       16   define variable vss-description as character no-undo init "Импорт доп. БК, внеш. ПН".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define new shared stream inp.
      301   define new shared stream err.
      302   define new shared stream wrn.
      303   define variable g#log as logical   no-undo .
      304   define variable ref-rec as recid no-undo .
      305   def var InputFileName  as char         no-undo.
      306   def var InputCoding    as char         no-undo.
      307   def var InputMode      as char         no-undo.
      308   def var v-message-text as char         no-undo.
      309   def var choice         as integer      no-undo.
      310   def var e-code  like trn-doc.exch-code no-undo.
      311   def var doc-num like price-doc.doc-num no-undo.
      312   define variable vartemp-ext as character no-undo.
      313   v-message-text =
      314       "Форматы файла импорта <параметр в угловых скобках требуется не во всех импортах>[параметр в квадратных скобках может быть опущен][[параметр обязателен при условии импорта в определенную цель]]:" + chr(10)
      315     + chr(10)
      316     + "<артикул>;[доп-бар-код];<количество>;<цена>;[ГТД];[едизм];[коэффициент];[НДС]" + chr(10)
      317     + chr(10)
      318     + "Описание параметров:"                                                                                                     + chr(10)
      319     + "Артикул поставщика - внешний артикул товара - ОБЯЗАТЕЛЬНОЕ ПОЛЕ."                                                                                                + chr(10)
      320     + "Доп-бар-код - любой собственный или дополнительный бар-код или код товара, признака для которой импортируется товар."  + chr(10)
      321     + "цена и количество- ОБЯЗАТЕЛЬНЫЕ ПОЛЯ."                                                                    + chr(10)
      322     + "НДС - проценты НДС поставщика."                                                                    + chr(10)
      323     + "После последней строки требуется Enter."                                                                                  + chr(10)
      324     + chr(10)
      325     + "Импорт внешней ПН :"                       + chr(10)
      326     + "Если едизм не указан, будут использованы едизм и коэффициент из карточки товара."                                 + chr(10)
      327     + "Если данный товар (признак) уже есть в ПН, то будут переписаны заново: цена, едизм, коэффициент, НДС, НСП."       + chr(10)
      328     + "Количество в этом случае суммируется."                                                                                    + chr(10)
      329     + chr(10)
      330     + "Пример :"                                     + chr(10)
      331     + "арт-1;3249443208100;10000;3;ГТД;шт;1;18"      + chr(10)
      332     + "арт-1;;10000;3;;;;"                           + chr(10)
      333     .
      334   run gbl/d-prompt.w (
      335       'title=Импорт ПН из внешнего текстового файла для товаров\'
      336     + 'type=editor\'
      337     + 'fillin_width=96\'
      338     + 'fillin_height=15\'
      339     + 'readonly=yes\'
      340     , input-output v-message-text).
      341   if return-value = 'false':u then
      342     return error.
      343   if parInputFileName <> ? then assign InputFileName = parInputFileName.
      344   else do:
      345      SYSTEM-DIALOG GET-FILE InputFileName
      346                    TITLE   "Файл с Доп. бар-кодами"
      347                    FILTERS "Текстовый файл (*.adb)"   "*.adb",
      348                            "Текстовый файл (*.txt)"   "*.txt",
      349                            "Все файлы (*.*)"          "*.*"
      350                    MUST-EXIST
      351                    USE-FILENAME
      352                    default-extension ".txt"
      353                    UPDATE g#log.
      354      if not g#log then return error.
      355   end.
      356   InputFileName = trim (string (InputFileName)) .
      357   assign
      358   vartemp-ext = entry (2, InputFileName, ".") no-error.
      359   if error-status:error then do:
      360     message "Файл без расширения не может быть обработан. Переименуйте его."
      361             view-as alert-box error.
      362     return error.
      363   end.
      364   if entry (2, InputFileName, ".") = "err" then do:
      365     message "Файл с расширением '.err' не может быть обработан. Переименуйте его."
      366             view-as alert-box error.
      367     return error.
      368   end.
      369   if entry (2, InputFileName, ".") = "wrn" then do:
      370     message "Файл с расширением '.wrn' не может быть обработан. Переименуйте его."
      371             view-as alert-box error.
      372     return error.
      373   end.
      374   if parInputCoding <> ? then do:
      375      if parInputCoding <> "1251"   and
      376         parInputCoding <> "KOI8-R" then do:
      377         message "Указан неверный формат файла: " parInputCoding " ." view-as alert-box.
      378         return error.
      379      end.
      380      assign InputCoding = parInputCoding.
      381   end.
      382   else do:
      383      g#log = yes.
      384      message "Выберите входной формат файла: YES - 1251, NO - KOI8-R" view-as alert-box question
      385              buttons YES-NO update g#log.
      386      if g#log then
      387         InputCoding = "1251".
      388      else
      389         InputCoding = "KOI8-R".
      390   end.
      391   output stream err TO value (entry (1, InputFileName, ".") + ".err").
      392   output stream wrn TO value (entry (1, InputFileName, ".") + ".wrn").
      393   run run-choice no-error.
      394   if error-status:error then return error.
      395   output stream err close.
      396   output stream wrn close.
      397   procedure run-choice:
      398   def var frame-title as char           no-undo.
      399   def var count-upd   as int init 0     no-undo.
      400   def var counter     as int init 0     no-undo.
      401   def var count-all   as int init 0     no-undo.
      402   DEFINE VARIABLE loc-ref-list as character no-undo .
      403   case InputCoding :
      404     when "1251" then
      405       input stream inp FROM value (InputFileName) convert source "1251".
      406     when "KOI8-R" then
      407       input stream inp FROM value (InputFileName) convert source "KOI8-R".
      408     otherwise
      409       return error.
      410   end case.
      411       assign
      412         InputMode = "input-way-bill"
      413         frame-title = "внешней ПН (артикул поставщика)"
      414         .
      415       if pare-code <> ? then do:
      416          find first currency where currency.curr-code = pare-code no-lock no-error.
      417          if not available currency then do:
      418             message "Задан неверный код валюты: " pare-code " ." view-as alert-box error.
      419             return error.
      420          end.
      421          assign e-code = pare-code.
      422       end.
      423       else do:
      424          assign
      425          ref-rec = ?.
      426          run ref/currency.w (input parParentProc, "b-sel", input-output ref-rec).
      427          if ref-rec = ? then
      428            return error.
      429          find currency where recid (currency) = ref-rec no-lock.
      430          e-code = currency.curr-code.
      431       end.
      432   frame-title = "Импорт "      + frame-title +
      433                 " из файла: "  + InputFileName +
      434                 " Кодировка: " + InputCoding +
      435                 " Дата: "      + cur-time-string()
      436                 .
      437   run str/imd-art.p (input  parParentProc ,
      438                  input  frame-title,
      439                  input  doc-num,
      440                  input  e-code,
      441                  input  (if pardoc-code = ? then "import" else pardoc-code),
      442                  input  parcli-type,
      443                  input  parcli-code,
      444                  input  parhost-code,
      445                  output count-upd,
      446                  output counter,
      447                  output count-all) no-error.
      448   if error-status:error then
      449     return error.
      450   input  stream inp close.
      451   output stream err close.
      452   output stream wrn close.
      453   message frame-title skip (2)
      454           "Просмотрено :" count-all skip
      455           "Закачано :"    counter skip
      456           "Изменено :"    count-upd skip (2)
      457           "Информация об ошибках находится в файле :" entry (1, InputFileName, ".") + ".err"
      458           "Информация о предупреждениях находится в файле :" entry (1, InputFileName, ".") + ".wrn"
      459           view-as alert-box .
      460   define variable varuser-action as character no-undo.
      461   define variable varis-printed  as logical   no-undo.
      462   run gbl/prnfilen.w
      463     (input  "Ошибки"
      464     ,input  0
      465     ,input  entry (1, InputFileName, ".") + ".err"
      466     ,input  7
      467     ,output varuser-action
      468     ,output varis-printed
      469     ).
      470   run gbl/prnfilen.w
      471     (input  "Замечания"
      472     ,input  0
      473     ,input  entry (1, InputFileName, ".") + ".wrn"
      474     ,input  7
      475     ,output varuser-action
      476     ,output varis-printed
      477     ).
      478   end procedure.
