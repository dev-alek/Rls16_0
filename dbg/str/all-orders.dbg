     9401   ON CHOOSE OF b-send IN FRAME d-order
     9402       DO:
     9403           define variable ii           as integer   no-undo .
     9404           define variable log-res      as logical   no-undo .
     9405           define variable p-ok         as logical   no-undo .
     9406           define variable qntyNew      as integer   no-undo .
     9407           define variable qntyNull     as integer   no-undo .
     9408           define variable errorRidList as character no-undo .
     9409           define variable ridList      as character no-undo .
     9410           define buffer bf_order     for ub.order-doc .
     9411           define buffer buf_X_order  for X_order .
     9412           define buffer X_order-line for ub.order-line .
     9413   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9414   do:
     9415     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9416       (input  v-cntxt-db-num
     9417       ,input  v-cntxt-userid
     9418       ,input  0
     9419       ,input  'actn_pmnt-ord-doc_update':U
     9420       ,input  'object':U
     9421       ,input  v-cntxt-host-code-obj
     9422       ,input  v-cntxt-obj-type
     9423       ,input  v-cntxt-obj-code
     9424       ,input  0
     9425       ,input  0
     9426       ,input  0
     9427       ,input  true
     9428       ,output log-res
     9429       )  .
     9430   end.
     9431           if not log-res then return no-apply .
     9432           if v-rid-list = "" then
     9433           do:
     9434               if X_order.sts <> StatusOrder:NewStatus:KeyIntDB then
     9435               do:
     9436                   message "Заказ уже был отправлен."
     9437                       view-as alert-box.
     9438                   return no-apply .
     9439               end.
     9440               find first X_order-line no-lock where X_order-line.doc-code = X_order.doc-code and
     9441                   X_order-line.db-num = X_order.db-num and X_order-line.order-qnty <= 0 no-error .
     9442               if not available (X_order-line) then
     9443               do:
     9444                   message "Вы уверены, что хотите отправить заказ поставщику?"
     9445                       view-as alert-box question buttons yes-no update p-ok.
     9446                   if p-ok then
     9447                   do:
     9448                       run bge\send1cerp.p (parparentproc,
     9449                           this-procedure,
     9450                           this-procedure,
     9451                           "order",
     9452                           (buffer X_order:handle),
     9453                           ?,
     9454                           ?) no-error.
     9455                       if  error-status:error then
     9456                       do:
     9457                           message return-value
     9458                               view-as alert-box.
     9459                           return .
     9460                       end.
     9461                       X_order.sts = StatusOrder:Sended:KeyIntDB .
     9462                       find first bf_order exclusive-lock where bf_order.doc-code = X_order.doc-code and
     9463                           bf_order.db-num = X_order.db-num no-error .
     9464                       if available (bf_order) then
     9465                       do:
     9466                           bf_order.sts = X_order.sts .
     9467                           release bf_order.
     9468                       end.
     9469                   end.
     9470                   else return no-apply.
     9471               end.
     9472               else
     9473               do:
     9474                   message "Количество товара в заказе не может быть отрицательным или равным нулю"
     9475                       view-as alert-box .
     9476                   return no-apply .
     9477               end.
     9478           end.
     9479           else
     9480           do:
     9481               do ii = 1 to num-entries (v-rid-list):
     9482                   find first buf_X_order no-lock where recid(buf_X_order) = integer(entry (ii,v-rid-list)) no-error .
     9483                   if buf_X_order.sts <> StatusOrder:NewStatus:KeyIntDB then
     9484                   do:
     9485                       qntyNew = qntyNew + 1 .
     9486                       next .
     9487                   end.
     9488                   find first X_order-line no-lock where
     9489                       X_order-line.db-num = buf_X_order.db-num and
     9490                       X_order-line.doc-code = buf_X_order.doc-code and
     9491                       X_order-line.order-qnty <= 0 no-error .
     9492                   if available (X_order-line) then
     9493                   do:
     9494                       qntyNull = qntyNull + 1 .
     9495                       if errorRidList = "" then errorRidList = string(recid(buf_X_order)) .
     9496                       else errorRidList = errorRidList + "," + string(recid(buf_X_order)) .
     9497                       next .
     9498                   end.
     9499                       if ridList = "" then ridList = string(recid(buf_X_order)) .
     9500                       else ridList = ridList + "," + string(recid(buf_X_order)) .
     9501               end.
     9502               if qntyNull = (ii - 1) then
     9503               do:
     9504                   message "Отправлять можно заказы только c положительным количеством товара."
     9505                       view-as alert-box.
     9506                   return no-apply .
     9507               end.
     9508               if qntyNew = (ii - 1) then
     9509               do:
     9510                   message "Отправлять можно только новые заказы."
     9511                       view-as alert-box.
     9512                   return no-apply .
     9513               end.
     9514               if (qntyNew + qntyNull) = (ii - 1) then
     9515               do:
     9516                   message "Отправлять можно заказы только c положительным количеством товара."
     9517                       view-as alert-box.
     9518                   message "Отправлять можно только новые заказы."
     9519                       view-as alert-box.
     9520                   return no-apply .
     9521               end.
     9522               if errorRidList <> "" then do:
     9523                   do ii = 1 to num-entries (errorRidList):
     9524                       find first buf_X_order no-lock where recid(buf_X_order) = integer(entry (ii,errorRidList)) no-error .
     9525                      message "В заказе c кодом ТН " + string(buf_X_order.doc-code) + " не должно быть строк с количеством <= 0"
     9526                       view-as alert-box.
     9527                   end.
     9528               end.
     9529               if qntyNew > 0 then do:
     9530                   message "Отправлять можно только новые заказы."
     9531                       view-as alert-box.
     9532               end.
     9533               if ridList <> "" then do:
     9534               message "Вы уверены, что хотите отправить выбранные заказы поставщику?"
     9535                   view-as alert-box question buttons yes-no update p-ok.
     9536               end.
     9537               if p-ok then
     9538               do:
     9539                   do ii = 1 to num-entries (ridList):
     9540                       find first buf_X_order no-lock where recid(buf_X_order) = integer(entry (ii,ridList)) no-error .
     9541                   find first X_order-line no-lock where
     9542                       X_order-line.db-num = buf_X_order.db-num and
     9543                       X_order-line.doc-code = buf_X_order.doc-code and
     9544                       X_order-line.order-qnty <= 0 no-error .
     9545                   if available (X_order-line) then
     9546                   do:
     9547                       qntyNull = qntyNull + 1 .
     9548                       next .
     9549                   end.
     9550                       run bge\send1cerp.p (parparentproc,
     9551                           this-procedure,
     9552                           this-procedure,
     9553                           "order",
     9554                           (buffer buf_X_order:handle),
     9555                           ?,
     9556                           ?) no-error.
     9557                       if  error-status:error then
     9558                       do:
     9559                           message return-value
     9560                               view-as alert-box.
     9561                           next .
     9562                       end.
     9563                       buf_X_order.sts = StatusOrder:Sended:KeyIntDB .
     9564                       find first bf_order exclusive-lock where bf_order.doc-code = buf_X_order.doc-code and
     9565                           bf_order.db-num = buf_X_order.db-num no-error .
     9566                       if available (bf_order) then
     9567                       do:
     9568                           bf_order.sts = buf_X_order.sts .
     9569                           release bf_order.
     9570                       end.
     9571                   end.
     9572               end.
     9573               else return no-apply.
     9574           end.
     9575           v-rid-list = "" .
     9576           disable b-del with frame d-order .
     9577           run init-sort .
     9578       END.
     9579   ON CHOOSE OF b-update IN FRAME d-order
     9580       DO:
     9581           define variable Log-Res as logical no-undo init "true".
     9582           if available (X_order) then
     9583           do:
     9584   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9585   do:
     9586     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9587       (input  v-cntxt-db-num
     9588       ,input  v-cntxt-userid
     9589       ,input  0
