     1445                       then do:
     1446                           assign
     1447                               p-out-string = p-out-string + " ":U
     1448                           .
     1449                       end.
     1450                       when chr(4)
     1451                       then do:
     1452                           assign
     1453                               p-out-string = p-out-string + " ":U
     1454                           .
     1455                       end.
     1456                       when chr(5)
     1457                       then do:
     1458                           assign
     1459                               p-out-string = p-out-string + " ":U
     1460                           .
     1461                       end.
     1462                       when chr(6)
     1463                       then do:
     1464                           assign
     1465                               p-out-string = p-out-string + " ":U
     1466                           .
     1467                       end.
     1468                       when chr(7)
     1469                       then do:
     1470                           assign
     1471                               p-out-string = p-out-string + " ":U
     1472                           .
     1473                       end.
     1474                       when chr(8)
     1475                       then do:
     1476                           assign
     1477                               p-out-string = p-out-string + " ":U
     1478                           .
     1479                       end.
     1480                       when chr(9)
     1481                       then do:
     1482                           assign
     1483                               p-out-string = p-out-string + " ":U
     1484                           .
     1485                       end.
     1486                       when chr(29)
     1487                       then do:
     1488                           assign
     1489                               p-out-string = p-out-string + " ":U
     1490                           .
     1491                       end.
     1492                       when chr(10)
     1493                       then do:
     1494                           assign
     1495                               p-out-string = p-out-string + " ":U
     1496                           .
     1497                       end.
     1498                       when chr(13)
     1499                       then do:
     1500                           assign
     1501                               p-out-string = p-out-string + " ":U
     1502                           .
     1503                       end.
     1504                       otherwise do:
     1505                           assign
     1506                               p-out-string = p-out-string + v-current-char
     1507                           .
     1508                       end.
     1509                   end case.
     1510               end.
     1511           end.
     1512       end case.
     1513   end.
     1514   end .
     1515   procedure xmlchar-decode :
     1516   define input parameter p-in-string      as character        no-undo.
     1517   define output parameter p-out-string    as character        no-undo.
     1518       define variable v-position      as integer      no-undo.
     1519       define variable v-last-position as integer      no-undo.
     1520       define variable v-temp-integer  as integer      no-undo.
     1521       define variable v-current-char  as character    no-undo.
     1522       define variable v-next-char     as character    no-undo.
     1523       define variable v-success       as logical      no-undo.
     1524   do
     1525   on error undo, return error
     1526   :
     1527       assign
     1528           p-out-string = "":U
     1529           v-position   = 0
     1530       .
     1531       replace-cycle:
     1532       do while yes
     1533       on error undo, return error
     1534       :
     1535           assign
     1536               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1537           .
     1538           if v-last-position <= v-position
     1539           then do:
     1540               if v-position = 0
     1541               then do:
     1542                   assign
     1543                       p-out-string = p-in-string
     1544                   .
     1545               end.
     1546               else do:
     1547                   assign
     1548                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1549                   .
     1550               end.
     1551               leave replace-cycle.
     1552           end.
     1553           else do:
     1554               assign
     1555                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1556                   v-position      = v-last-position
     1557                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1558               .
     1559               if v-current-char = "#":U
     1560               then do:
     1561                   assign
     1562                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1563                   .
     1564                   if v-last-position > 0
     1565                   then do:
     1566                       run xmlchar-read-integer in this-procedure
     1567                        (
     1568                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1569                           , output v-temp-integer
     1570                           , output v-success
     1571                       ).
     1572                       if v-success = yes
     1573                       and v-temp-integer >= 1
     1574                       and v-temp-integer <= 255
     1575                       then do:
     1576                           assign
     1577                               p-out-string = p-out-string + chr( v-temp-integer )
     1578                               v-position   = v-last-position + 1
     1579                           .
     1580                       end.
     1581                       else do:
     1582                           assign
     1583                               p-out-string = p-out-string + "&":U
     1584                               v-position   = v-position   + 1
     1585                           .
     1586                       end.
     1587                   end.
     1588                   else do:
     1589                       assign
     1590                           p-out-string = p-out-string + "&":U
     1591                           v-position   = v-position   + 1
     1592                       .
     1593                   end.
     1594               end.
     1595               else do:
     1596                   case substring( p-in-string, v-position + 1, 3 )
     1597                   :
     1598                       when "lt;":U
     1599                       then do:
     1600                           assign
     1601                               p-out-string = p-out-string + "<":U
     1602                               v-position   = v-position   + 3
     1603                           .
     1604                       end.
     1605                       when "gt;":U
     1606                       then do:
     1607                           assign
     1608                               p-out-string = p-out-string + ">":U
     1609                               v-position   = v-position   + 3
     1610                           .
     1611                       end.
     1612                       otherwise do:
     1613                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1614                           then do:
     1615                               assign
     1616                                   p-out-string = p-out-string + "&":U
     1617                                   v-position   = v-position   + 4
     1618                               .
     1619                           end.
     1620                           else do:
     1621                               case substring( p-in-string, v-position + 1, 5 )
     1622                               :
     1623                                   when "quot;":U
     1624                                   then do:
     1625                                       assign
     1626                                           p-out-string = p-out-string + '"':U
     1627                                           v-position   = v-position   + 5
     1628                                       .
     1629                                   end.
     1630                                   when "apos;":U
     1631                                   then do:
     1632                                       assign
     1633                                           p-out-string = p-out-string + "'":U
     1634                                           v-position   = v-position   + 5
     1635                                       .
     1636                                   end.
     1637                                   otherwise do:
     1638                                       assign
     1639                                           p-out-string = p-out-string + "&":U
     1640                                       .
     1641                                   end.
     1642                               end case.
     1643                           end.
     1644                       end.
     1645                   end case.
     1646               end.
     1647           end.
     1648       end.
     1649   end.
     1650   end .
     1651   procedure xmlchar-read-integer :
     1652   define input parameter p-input-string      as character        no-undo.
     1653   define output parameter p-output-integer   as integer          no-undo.
     1654   define output parameter p-success       as logical          no-undo.
     1655   do
     1656   on error undo, return error
     1657   :
     1658       assign
     1659           p-output-integer = integer( p-input-string )
     1660       no-error.
     1661       if error-status :error
     1662       then do:
     1663           assign
     1664               p-success           = no
     1665               p-output-integer    = 0
     1666           .
     1667       end.
     1668       else do:
     1669           assign
     1670               p-success           = yes
     1671           .
     1672       end.
     1673   end.
     1674   end.
     1675   define variable mMRCCode  as logical    no-undo.
     1676   define variable mTypeMark as character  no-undo.
     1677   function IS-NeedMark returns logical
     1678   ( input ib-code as integer  ,
     1679     input ib-str as character ):
     1680      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1681      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1682                                    and buf_prod-bc-attr.b-str  eq ib-str
     1683                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1684        no-lock no-error.
     1685      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1686   end.
     1687   function repTegforDm return char
     1688   (iDM as char ):
     1689       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1690       define variable vteg as character no-undo.
     1691       define variable oDM as character no-undo.
     1692       define variable vi as integer no-undo.
     1693       oDM = iDm.
     1694       do vi = 1 to num-entries(vTeglist):
     1695          vTeg = entry(vi,vTeglist).
     1696          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1697       end.
     1698       return oDM.
     1699   end.
     1700   function repSpecSimbforDm return char
     1701   (iDM as char ):
     1702       define variable oDM as character no-undo.
     1703     run
     1704       xmlchar-decode(iDM, output oDM).
     1705     return repTegforDm (oDM).
     1706   end.
     1707   function CheckGtin return logical
     1708   (iGtin as char):
     1709      define variable bar_code as character no-undo.
     1710      define variable vGtin as logical no-undo init "yes".
     1711      if length(iGtin) eq 14
     1712      then do:
     1713         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1714         run str/chk-sum.p
     1715          (input-output bar_code ) no-error .
     1716         if iGtin ne  bar_code
     1717         then
     1718            vGtin = no.
     1719      end.
     1720      else
     1721         vGtin = no.
     1722      return vgtin.
     1723   end.
     1724   function repSpecSimbforXlm return char
     1725   (iDM as char ):
     1726       iDM = replace(iDM,chr(29),"").
     1727       return iDM.
     1728   end.
     1729   function getGtinByDM return char
     1730   (IDM as char):
     1731      define variable VTXT as char no-undo.
     1732      define variable vGtin as char no-undo.
     1733      vTXt = IdM.
     1734      vGtin = IDM.
     1735      if    length(vtxt) > 14
     1736      then do:
     1737         if   vtxt begins "(01)"
     1738                or vtxt begins "(02)"
     1739         then
     1740            vGtin = substring(vtxt,5,14).
     1741         else if   (vtxt begins "01"
     1742                or vtxt begins "02" )
     1743                and (   (    substring(iDm,17,2) eq "21"
     1744                         and length(vtxt) >= 21)
     1745                     or substring(iDm,17,2) eq "37"
     1746                     or substring(iDm,17,4) eq "(37)" )
     1747         then do:
     1748            vGtin = substring(vtxt,3,14).
     1749            if not checkGtin(vGtin)
     1750            then
     1751               vGtin = substring(vtxt,1,14).
     1752         end.
     1753         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1754             or length(vtxt) eq 14 + 7 + 4
     1755             or length(vtxt) eq 14 + 7
     1756         then
     1757            vGtin = substring(vtxt,1,14).
     1758      end.
     1759      if not checkGtin(vGtin)
     1760      then
     1761         vGtin = "".
     1762      return vgtin.
     1763   end.
     1764   function getGdsCodeByGtin return int
     1765   (iGtin as char):
     1766      define buffer prod-bc  for ub.prod-bc.
     1767      define buffer bar-code for ub.bar-code.
     1768      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1769      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1770      return if avail bar-code then bar-code.gds-code else ?.
     1771   end.
     1772   function getQntyCodeByGtin return decimal
     1773   (iGtin as char):
     1774      define buffer prod-bc  for ub.prod-bc.
     1775      define buffer bar-code for ub.bar-code.
     1776      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1777      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1778      return if avail bar-code then bar-code.cli-base-rate else ?.
     1779   end.
     1780   function getGdsCodeByDM return int
     1781   (iDm as char):
     1782      define variable vGtin as char no-undo.
     1783      define buffer prod-bc for ub.prod-bc.
     1784      vGtin  = getGtinByDM (IDM ).
     1785      return getGdsCodeByGtin (vGtin).
     1786   end.
     1787   function ChekTypeMarkByGds return logical
     1788   (iGds-code as integer ):
     1789      define buffer goods-attr for ub.goods-attr.
     1790      find first goods-attr where goods-attr.gds-code   = iGds-code
     1791                              and goods-attr.attr-code  = 'mark-type':U
     1792      no-lock no-error.
     1793      if available goods-attr
     1794      then do:
     1795         mTypeMark = goods-attr.attr-value.
     1796         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1797           .
     1798      end.
     1799      else
     1800         return no.
     1801   end.
     1802   function ChekTypeMarkByDm return logical
     1803   (iDM as char ):
     1804      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1805   end.
     1806   function ChekTypeMarkByGtin return logical
     1807   (iGtin as char ):
     1808      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1809   end.
     1810   function GetNextElement return character
     1811     (input iAllTeg        as logical
     1812     ,output oteg          as character
     1813     ,output otegval       as character
     1814     ,input-output pstr    as character
     1815      ):
     1816        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1817        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1818        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1819        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1820        define variable vTeg as character no-undo.
     1821        define variable vLength as integer no-undo.
     1822        define variable vi as integer no-undo.
     1823        define variable vj as integer no-undo.
     1824        define buffer code for ub.code.
     1825        find first code where Code.parent eq "MarkType"
     1826                          and Code.CodeValue   eq mTypeMark
     1827                          no-lock no-error.
     1828        if     available code
     1829           and Code.misc1 ne ""
     1830           and Code.misc1 ne ?
     1831        then do:
     1832           integer (Code.misc1) no-error.
     1833           if not error-status:error
     1834           then
     1835             entry (4,vlistleng) = Code.misc1.
     1836        end.
     1837        if iAllTeg
     1838        then
     1839           assign
     1840              vlistElem     = vlistElem    + vlistElemDop
     1841              vlistleng     = vlistleng    + vlistlengDop
     1842           .
     1843        else if mMRCCode
     1844        then
     1845           assign
     1846              vlistElem     = vlistElem    + ",(8005),8005"
     1847              vlistleng     = vlistleng    + ",000006,0006"
     1848           .
     1849       block-elem:
     1850       do vi = 1 to num-entries(vlistElem):
     1851          vTeg = entry(vi,vlistElem).
     1852          if pstr begins vTeg
     1853          then do:
     1854             if    vTeg eq "21"
     1855             then
     1856                vLength = index(pstr,chr(29)) - 2 no-error.
     1857             if vLength  <= 0
     1858             then
     1859                vLength = int(entry(vi,vlistleng)).
     1860             otegval = substring (pstr,length(vteg) + 1, vLength).
     1861             oteg = replace(replace(vteg,")",""),"(","").
     1862             vTeg = vteg + otegval.
     1863             otegval = replace(otegval,chr(29),"").
     1864             oteg = replace(replace(oteg,")",""),"(","").
     1865             pstr = substring (pstr,length(vTeg)+ 1).
     1866             vTeg = replace(vTeg,chr(29),"").
     1867             leave block-elem.
     1868          end.
     1869          else
     1870             vTeg = "".
     1871       end.
     1872       return vteg.
     1873   end.
     1874   function GetCodeIdent return character
     1875   (iDm as char):
     1876      define variable Velement   as character no-undo init "first".
     1877      define variable oCodeIdent as character no-undo.
     1878      define variable vteg as character no-undo.
     1879      define variable vtegval as character no-undo.
     1880      define variable vGtin as character no-undo.
     1881      define buffer marking for ub.marking.
     1882      for first marking no-lock where
     1883                marking.mark eq iDm
     1884            and marking.unit-ext = "LEVEL2"
     1885      :
     1886        return iDm.
     1887      end.
     1888      vGtin  = getGtinByDM (iDm ).
     1889      ChekTypeMarkByDm(idm).
     1890      if iDm begins 'tech_':U
     1891      then
     1892         oCodeIdent = iDm.
     1893      else if length(iDm) < 21
     1894      then do:
     1895         find first marking where marking.mark eq idm
     1896         no-lock no-error.
     1897         oCodeIdent = if available marking then marking.mark else  ?.
     1898      end.
     1899      else if     length(iDm) eq 29
     1900         and not iDm begins "01"
     1901         and not iDm begins "02"
     1902      then
     1903         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1904      else  if     length(iDm) >= 24
     1905               and (  iDm begins "01"
     1906                   or iDm begins "02")
     1907               and  substring(iDm,17,2) ne "21"
     1908      then do:
     1909         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1910                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1911         then
     1912            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1913         else
     1914            oCodeIdent = iDM.
     1915      end.
     1916      else  if     (   length(iDm) eq 25
     1917                    or length(iDm) eq 21)
     1918               and (not iDm begins "01"
     1919               and  not iDm begins "02")
     1920      then
     1921         oCodeIdent = substring(iDm,1,21).
     1922      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1923      then
     1924         oCodeIdent = substring(iDm,1,21).
     1925      else do while Velement ne "" and idm ne "":
     1926         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1927         oCodeIdent = oCodeIdent + Velement.
     1928      end.
     1929      return oCodeIdent.
     1930   end.
     1931   function GetTegCod return character
     1932   (icodeIdent as char, iTeg as char):
     1933      define variable Velement   as character no-undo init "first".
     1934      define variable oTeg as character no-undo init ?.
     1935      define variable vteg as character no-undo.
     1936      define variable vtegval as character no-undo.
     1937      if     ((length(icodeIdent) eq 21
     1938         and not icodeIdent begins "01"
     1939         and not icodeIdent begins "02")
     1940         or
     1941             ( length(icodeIdent) eq 25
     1942               and not icodeIdent begins "01"
     1943               and not icodeIdent begins "02"))
     1944      then do:
     1945         if iTeg eq "01" or iTeg eq "02"
     1946         then
     1947            oTeg = substring(icodeIdent,1,21).
     1948         else  if  iTeg eq "21"
     1949         then
     1950            oTeg = substring(icodeIdent,15,7).
     1951      end.
     1952      else do:
     1953         ChekTypeMarkByDm(icodeIdent).
     1954         block-teg:
     1955            do while Velement ne "" and icodeIdent ne "":
     1956            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1957            if    Velement begins iTeg
     1958               or Velement begins "(" + iTeg + ")"
     1959            then do:
     1960               oTeg = vtegval.
     1961               leave block-teg.
     1962            end.
     1963         end.
     1964      end.
     1965      return oTeg.
     1966   end.
     1967   function isOAD return logical
     1968   (icodeIdent as character):
     1969      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1970   end.
     1971   function isMark return logical
     1972   (icodeIdent as character):
     1973      define buffer buf_marking for ub.marking.
     1974      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1975             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1976   end.
     1977   function addBracketForCode return character
     1978   (icodeIdent as char):
     1979      define variable Velement   as character no-undo init "first".
     1980      define variable oTeg as character no-undo.
     1981      define variable vteg as character no-undo.
     1982      define variable vtegval as character no-undo.
     1983      define buffer marking for ub.marking.
     1984      find first marking no-lock where
     1985                 marking.mark begins icodeIdent no-error.
     1986      if    not ChekTypeMarkByDm(icodeIdent)
     1987         or length(icodeIdent) le 24
     1988         or (avail marking and marking.unit-ext = "LEVEL2")
     1989      then
     1990         oTeg = icodeIdent.
     1991      else do:
     1992         if (  icodeIdent begins "01"
     1993            or icodeIdent begins "02"
     1994            ) and CheckGtin(substring (icodeIdent,3,14))
     1995            and substring (icodeIdent,17,2) eq "21"
     1996         then do:
     1997            mMRCCode = yes.
     1998            ChekTypeMarkByDm(icodeIdent).
     1999            block-teg:
     2000            do while Velement ne "" and icodeIdent ne "":
     2001               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2002               if vteg ne ""
     2003               then
     2004                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2005            end.
     2006            mMRCCode = no.
     2007         end.
     2008         else do:
     2009            oTeg = icodeIdent.
     2010         end.
     2011      end.
     2012      return oTeg.
     2013   end.
     2014   function getlevelByCodId return int
     2015   (iCode as char):
     2016      define variable vLength as int no-undo.
     2017      define variable vLevel  as int no-undo.
     2018      if not ChekTypeMarkByDM (icode) then return ?.
     2019      vLength = length(iCode).
     2020      if    vLength eq 18
     2021         or vLength eq 20
     2022      then
     2023         Vlevel = 4.
     2024      else if vLength eq 21
     2025      then
     2026         Vlevel = 1.
     2027      else if vLength eq 25
     2028      then do:
     2029         if  iCode begins "01"
     2030         then
     2031            Vlevel = 3.
     2032         else
     2033            Vlevel = 1.
     2034      end.
     2035      else if     vLength >= 26
     2036              and vLength <= 46
     2037      then do:
     2038         if    substring(iCode,17,2) eq "11"
     2039            or substring(iCode,17,2) eq "13"
     2040            or (    substring(iCode,17,2) eq "21"
     2041                and vLength >= 33
     2042                and substring(iCode,26,4) ne "8005")
     2043         then
     2044            Vlevel = 4.
     2045         else if    vLength eq 31
     2046                 or vLength eq 38
     2047                 or vLength eq 39
     2048                 or vLength eq 45
     2049         then
     2050            Vlevel = 1.
     2051         else if    vLength eq 35
     2052                 or vLength eq 43
     2053         then
     2054            Vlevel = 3.
     2055         else
     2056            Vlevel = ?.
     2057      end.
     2058      else
     2059         Vlevel = ?.
     2060      return Vlevel.
     2061   end.
     2062   function getLevelMotpBycodid return character
     2063   (iDm as char):
     2064      define variable vLevel as integer no-undo.
     2065      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2066      vLevel = getlevelByCodId(iDm).
     2067      if    vLevel eq ?
     2068         or vLevel < 1
     2069         or vLevel > 6
     2070      then
     2071         return ?.
     2072      else
     2073         return entry(vlevel,vList).
     2074   end.
     2075   function getLevelUTDByLevelMotp return character
     2076   (iUnit as char):
     2077      define variable vLevel as integer no-undo.
     2078      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2079      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2080      vLevel = lookup(iUnit,vListMOTP).
     2081      if    vLevel eq ?
     2082         or vLevel < 1
     2083         or vLevel > 4
     2084      then
     2085         return ?.
     2086      else
     2087         return entry(vlevel,vListutd).
     2088   end.
     2089   function getLevelMotpByDM return character
     2090   (iDm as char):
     2091      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2092   end.
     2093   function getLevelUTDByCodId return character
     2094   (iDm as char):
     2095      define variable vLevel as integer no-undo.
     2096      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2097      vLevel = getlevelByCodId(iDm).
     2098      if    vLevel eq ?
     2099         or vLevel < 1
     2100         or vLevel > 4
     2101      then
     2102         return ?.
     2103      else
     2104         return entry(vlevel,vList).
     2105   end.
     2106   function getLevelUTDByDM return character
     2107   (iDm as char):
     2108      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2109   end.
     2110   define variable mNotMarkQnty as logical no-undo.
     2111   function getQntyUTDByCodId return decimal
     2112   (iDM as char):
     2113      define variable vLevel as integer no-undo.
     2114      define variable vList as character no-undo init "1,5,10,500".
     2115      define variable vGtin as character no-undo.
     2116      define variable vqnty as decimal no-undo init ?.
     2117      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2118      if vqnty eq ?
     2119      then do:
     2120         if not mNotMarkQnty
     2121         then do:
     2122            define buffer marking for ub.marking.
     2123            define variable vCodident as character no-undo.
     2124            vCodident = GetCodeIdent(idm).
     2125            find first marking where marking.mark begins vCodident no-lock no-error.
     2126            if     available marking
     2127               and marking.box-qnty ne ?
     2128            then
     2129               return marking.box-qnty.
     2130         end.
     2131         vGtin = getGtinByDm(iDM).
     2132         if ChekTypeMarkByGtin (vGtin)
     2133         then do:
     2134            vLevel = getlevelByCodId(iDM).
     2135            if     vLevel >= 1
     2136               and vLevel <= 4
     2137            then
     2138               vqnty = int(entry(vlevel,vList)).
     2139         end.
     2140         else
     2141            vqnty = getQntyCodeByGtin(vgtin).
     2142      end.
     2143      return vqnty.
     2144   end.
     2145   function getQntyUTDByDM return decimal
     2146   (iDm as char):
     2147      define variable vDM as character no-undo.
     2148      if     length (iDm) ne 25
     2149         and length (iDm) ne 29
     2150         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2151      then
     2152         vDM = substring (iDm,1,length (iDm) - 6 ).
     2153      else
     2154         vDM = substring (iDm,1,length (iDm) - 4 ).
     2155      return getQntyUTDByCodId(vDM).
     2156   end.
     2157   function getMRC4 return decimal
     2158   (iMRC as char):
     2159      define variable oMrc     as decimal no-undo init ?.
     2160      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2161      define variable vi       as integer no-undo.
     2162      define variable vfound   as integer no-undo.
     2163      define variable vposStart   as integer no-undo.
     2164      do:
     2165      OMRc = 0.
     2166      do vi = 1 to 4:
     2167         define variable vsimb as character no-undo.
     2168         vsimb = substring(iMRC,vi,1).
     2169         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2170         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2171         if vfound > 0
     2172         then
     2173            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2174         end.
     2175         OMRc = OMRc / 100.
     2176      end.
     2177      return OMRc.
     2178   end.
     2179   function getMRCByDM return decimal
     2180   (iDm as char):
     2181      define variable vMRC     as character no-undo.
     2182      define variable oMrc     as decimal no-undo init ?.
     2183      define variable Velement as character no-undo init "empty".
     2184      define variable vteg as character no-undo.
     2185      define variable vtegval as character no-undo.
     2186      if    length(idm) eq 14 + 7 + 4 + 4
     2187         or length(idm) eq 14 + 7 + 4
     2188      then do:
     2189         vMRC = substring(idm,22,4).
     2190         omrc = getMRC4(vMRC).
     2191      end.
     2192      else do:
     2193          ChekTypeMarkByDm(iDm).
     2194          block-mrc:
     2195          do while Velement ne "" and idm ne "":
     2196             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2197             if Velement begins "8005"
     2198             then do:
     2199                vMRC = substring(Velement,5,6).
     2200                leave block-mrc.
     2201             end.
     2202             else if Velement begins "(8005)"
     2203             then do:
     2204                vMRC = substring(Velement,7,6).
     2205                leave block-mrc.
     2206             end.
     2207          end.
     2208          if vMRC ne ""
     2209          then
     2210             OMRc = dec(vmrc) / 100 no-error.
     2211      end.
     2212      return OMRc.
     2213   end.
     2214   function MoveDate return Date
     2215   (idate as date,
     2216    iMonth as int64):
     2217      define variable vMonth   as int64 no-undo.
     2218      define variable vYear    as int64 no-undo.
     2219      define variable vDateNew as date  no-undo.
     2220       define variable vDay     as int64 no-undo.
     2221       vMonth = month(iDate) + iMonth.
     2222       vYear =  year(iDate).
     2223       if vMonth <= 0
     2224       then assign
     2225          vMonth = vMonth + 12
     2226           vYear  = vYear - 1
     2227       .
     2228       else if vMonth > 12
     2229       then assign
     2230          vMonth = vMonth - 12
     2231           vYear  = vYear + 1
     2232       .
     2233       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2234       do while error-status:error eq yes:
     2235          VDay = vDay + 1.
     2236          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2237       end.
     2238       if VDay > 0
     2239       then
     2240          vDateNew + 1.
     2241       return vDateNew.
     2242   end.
     2243   procedure checkEMRC:
     2244   define input  parameter iDm as character no-undo.
     2245   define output parameter vok as logical   no-undo init yes.
     2246      define variable v-value-emrc as character no-undo.
     2247      define variable v-type-emrc  as character no-undo.
     2248      define variable vDateIso     as character no-undo.
     2249      define variable vMRC         as decimal no-undo.
     2250      define variable vqnty        as decimal no-undo.
     2251      define variable vPrice       as decimal no-undo.
     2252      define variable vparent      as character no-undo.
     2253      define variable vgds-code    as integer no-undo.
     2254      define buffer code for ub.code.
     2255      vMRC = getMRCByDM(iDm).
     2256      if vMRC > 0
     2257      then do:
     2258         vgds-code = getGdsCodeByDM(iDm).
     2259         vqnty     = getQntyUTDByDM(iDm).
     2260               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2261            (
     2262             input   vgds-code
     2263            ,input   'emrc-type':U
     2264            ,output   v-value-emrc
     2265            ,output   v-type-emrc
     2266          ) no-error.
     2267          if     v-value-emrc ne ""
     2268             and v-value-emrc ne ?
     2269          then do:
     2270             vDateIso = iso-date(today).
     2271             vPrice = vMRC / vqnty.
     2272             vparent ="emc" + chr(4) + v-value-emrc.
     2273             find last code where Code.parent      eq vparent
     2274                              and Code.code        le vDateIso
     2275                              and code.status_  eq 0
     2276             no-lock no-error.
     2277             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2278             then
     2279                vOk = true .
     2280             else do:
     2281                 define variable vText      as character no-undo.
     2282                 define variable vDate      as date no-undo.
     2283                 define variable vDateLast  as character no-undo.
     2284                 define variable vDateFirst as character no-undo.
     2285                 define variable vDate3     as date no-undo.
     2286                 vdate = date(code.misc1).
     2287                 vDateLast = code.misc1.
     2288                 vDate3 = MoveDate(today, - 3 ).
     2289                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2290                                      string(vDate3  , "99/99/9999"),
     2291                                      string(vDate   , "99/99/9999")
     2292                                      ).
     2293                 vdateIso = iso-date(vdate3).
     2294                 find last code  where Code.parent      eq vparent
     2295                                   and Code.code        le vDateIso
     2296                                   and code.status_  eq 0 no-lock no-error.
     2297                 if available code
     2298                 then
     2299                    vDateIso = code.code.
     2300                 vDateFirst = vDateIso.
     2301                 vDateLast = iso-date(vdate).
     2302                 define variable vGood as logical no-undo.
     2303                 define variable vDateSale as date no-undo.
     2304                 define buffer bcode for code.
     2305                 for last code where Code.parent   eq vparent
     2306                                 and code.status_  eq 0
     2307                                 and code.code     < vDateLast
     2308                                 and code.code     >= vDateFirst
     2309                 no-lock:
     2310                    find first bcode where bCode.parent   eq vparent
     2311                                       and bcode.status_  eq 0
     2312                                       and bcode.code     > code.code no-lock no-error.
     2313                    if available bcode
     2314                    then do:
     2315                       if vPrice < dec(Code.CodeValue)
     2316                       then
     2317                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2318                                                     chr(10),
     2319                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2320                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2321                                                     ).
     2322                       else do:
     2323                          vGood = yes.
     2324                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2325                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2326                                                     chr(10),
     2327                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2328                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2329                                                     string(         vDateSale            ,"99/99/9999"),
     2330                                                     string(vDateSale - today)
     2331                                                     ).
     2332                       end.
     2333                    end.
     2334                 end.
     2335                 if vgood
     2336                 then do:
     2337                    define variable choice as integer no-undo .
     2338                    run gbl/d-askw.w (input "Уточнение"
     2339                           ,input  vText
     2340                           ,input "|"
     2341                           ,input "Принять|Вернуть"
     2342                           ,input "Принять данный товар|Вернуть товар постащику"
     2343                           ,input 1
     2344                           ,input 2
     2345                           ,output choice) no-error.
     2346                    vok = choice eq 1.
     2347                 end.
     2348                 else
     2349                    vok =false.
     2350             end.
     2351          end.
     2352      end.
     2353   end.
     2354   function addGs2Mark return character
     2355   (iMark as char):
     2356      define variable vDM   as character no-undo.
     2357      define variable vIdx  as integer   no-undo.
     2358      if index(iMark,chr(29),1) > 0
     2359      then return iMark.
     2360      if substring(iMark,26,4) = "8005" then
     2361      do:
     2362        vIdx = index(iMark,"93",26 + 4 + 5).
     2363        if vIdx > 1 then do:
     2364          vDM = substitute("&1&4&2&4&3",
     2365                           substring(iMark,1,25),
     2366                           substring(iMark,26,vIdx - 25 - 1),
     2367                           substring(iMark,vIdx),
     2368                           chr(29)) no-error.
     2369          vIdx = index(vDm,"240",vIdx + 4).
     2370          if vIdx > 0 then
     2371          do:
     2372            vDM = substitute("&1&3&2",
     2373                             substring(vDm,1,vIdx - 1),
     2374                             substring(vDm,vIdx),
     2375                             chr(29)) no-error.
     2376          end.
     2377        end.
     2378        else
     2379          vDM = substitute("&1&3&2",
     2380                           substring(iMark,1,25),
     2381                           substring(iMark,26),
     2382                           chr(29)) no-error.
     2383      end.
     2384      else if substring(iMark,32,2) = "91" then
     2385      do:
     2386        vIdx = index(iMark,"92",32).
     2387        if vIdx > 1 then
     2388          vDM = substitute("&1&4&2&4&3",
     2389                           substring(iMark,1,31),
     2390                           substring(iMark,32,vIdx - 31 - 1),
     2391                           substring(iMark,vIdx),
     2392                           chr(29)) no-error.
     2393        else
     2394          vDM = substitute("&1&3&2",
     2395                           substring(iMark,1,31),
     2396                           substring(iMark,32),
     2397                           chr(29)) no-error.
     2398      end.
     2399      else if substring(iMark,39,2) = "91" then
     2400      do:
     2401        vIdx = index(iMark,"92",38).
     2402        if vIdx > 1 then
     2403          vDM = substitute("&1&4&2&4&3",
     2404                           substring(iMark,1,38),
     2405                           substring(iMark,39,vIdx - 38 - 1),
     2406                           substring(iMark,vIdx),
     2407                           chr(29)) no-error.
     2408        else
     2409          vDM = substitute("&1&3&2",
     2410                           substring(iMark,1,38),
     2411                           substring(iMark,39),
     2412                           chr(29)) no-error.
     2413      end.
     2414      else if substring(iMark,25,2) = "93" then
     2415      do:
     2416        vIdx = index(iMark,"92",25).
     2417        if vIdx > 1 then
     2418          vDM = substitute("&1&4&2&4&3",
     2419                           substring(iMark,1,24),
     2420                           substring(iMark,25,vIdx - 24 - 1),
     2421                           substring(iMark,vIdx),
     2422                           chr(29)) no-error.
     2423        else
     2424          vIdx = index(iMark,"3103",25).
     2425          if vIdx > 0 then
     2426          vDM = substitute("&1&4&2&4&3",
     2427                           substring(iMark,1,24),
     2428                           substring(iMark,25,vIdx - 24 - 1),
     2429                           substring(iMark,vIdx),
     2430                           chr(29)) no-error.
     2431          else
     2432            vDM = substitute("&1&3&2",
     2433                             substring(iMark,1,24),
     2434                             substring(iMark,25),
     2435                             chr(29)) no-error.
     2436      end.
     2437      else if substring(iMark,32,2) = "93" then
     2438      do:
     2439        vDM = substitute("&1&3&2",
     2440              substring(iMark,1,31),
     2441              substring(iMark,32),
     2442              chr(29)) no-error.
     2443      end.
     2444      return if vDM <> "" then vDm else iMark.
     2445   end.
     2446   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   function AddUtdErrForTab returns logical
     2448   (idb-num         as integer ,
     2449    idoc-id         as integer ,
     2450    iTab            as character,
     2451    iObj            as handle ,
     2452    iCheckType      as character,
     2453    iCodeErr        as character,
     2454    iCheckObj       as character ):
     2455      define buffer utd-err for utd-err.
     2456      define buffer utd for utd.
     2457      find first utd where utd.db-num     eq idb-num
     2458                       and utd.doc-id     eq idoc-id
     2459                       and utd.Direction  eq 'Outbound'
     2460      no-lock no-error.
     2461      if available utd
     2462      then
     2463         return no.
     2464      define variable vRecKey as character no-undo.
     2465            run gen-key-rec (input iTab,
     2466                             input  iObj,
     2467                             output vRecKey).
     2468      find first utd-err where utd-err.db-num     eq idb-num
     2469                           and utd-err.doc-id     eq idoc-id
     2470                           and utd-err.CheckType  eq iCheckType
     2471                           and utd-err.CodeErr    eq iCodeErr
     2472                           and utd-err.CheckObj   eq iCheckObj
     2473      exclusive-lock no-error.
     2474      if not available utd-err
     2475      then do:
     2476         create utd-err.
     2477         assign
     2478            utd-err.db-num         = idb-num
     2479            utd-err.doc-id         = idoc-id
     2480            utd-err.CheckType      = iCheckType
     2481            utd-err.CodeErr        = iCodeErr
     2482            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2483            utd-err.reckey         = vRecKey
     2484            utd-err.qnty           = 1
     2485         .
     2486      end.
     2487      else
     2488         utd-err.qnty = utd-err.qnty + 1.
     2489      return utd-err.qnty eq 1.
     2490   end.
     2491   function AddUtdErr returns logical
     2492   (idb-num         as integer ,
     2493    idoc-id         as integer ,
     2494    iObj            as handle ,
     2495    iCheckType      as character,
     2496    iCodeErr        as character,
     2497    iCheckObj       as character ):
     2498      AddUtdErrForTab
     2499         (idb-num,
     2500          idoc-id,
     2501          iObj:table,
     2502          iObj,
     2503          iCheckType,
     2504          iCodeErr,
     2505          iCheckObj).
     2506   end.
     2507   function ClearUtdErrTypeCode returns logical
     2508   (idb-num         as integer,
     2509    idoc-id         as integer ,
     2510    iCheckType      as character,
     2511    iCodeErr        as character
     2512    ):
     2513      define buffer utd-err for utd-err.
     2514      if    iCheckType eq "*"
     2515         or iCheckType eq ?
     2516      then do:
     2517         if     iCodeErr ne ?
     2518            and iCodeErr ne "*"
     2519         then
     2520            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2521            view-as alert-box.
     2522         else
     2523         for each utd-err where utd-err.db-num  eq idb-num
     2524                            and utd-err.doc-id  eq idoc-id
     2525         exclusive-lock:
     2526            delete utd-err.
     2527         end.
     2528      end.
     2529      else do:
     2530         if    iCodeErr eq ?
     2531            or iCodeErr eq "*"
     2532         then do:
     2533            for each utd-err where utd-err.db-num     eq idb-num
     2534                               and utd-err.doc-id     eq idoc-id
     2535                               and utd-err.CheckType  eq iCheckType
     2536            exclusive-lock:
     2537               delete utd-err.
     2538            end.
     2539         end.
     2540         else do:
     2541            for each utd-err where utd-err.db-num     eq idb-num
     2542                               and utd-err.doc-id     eq idoc-id
     2543                               and utd-err.CheckType  eq iCheckType
     2544                               and ub.utd-err.CodeErr eq iCodeErr
     2545            exclusive-lock:
     2546               delete utd-err.
     2547            end.
     2548         end.
     2549      end.
     2550   end.
     2551   function ClearUtdErr returns logical
     2552   (idb-num         as integer,
     2553    idoc-id         as integer ,
     2554    iCheckType      as character
     2555    ):
     2556      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2557   end.
     2558   function GetMesError returns character
     2559   (itxt as character,
     2560    iobj as character ):
     2561    define variable vi as integer no-undo.
     2562    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2563       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2564    end.
     2565    return itxt.
     2566   end.
     2567   function GetTextErrorType returns character
     2568   (iCheckType as character,
     2569    iCodeErr   as character,
     2570    iChechObj  as character,
     2571    iType      as character  ):
     2572      define buffer code    for code.
     2573      define variable vError as character no-undo.
     2574      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2575                        and code.code   eq iCodeErr
     2576      no-lock no-error.
     2577      if available code
     2578      then do:
     2579         define variable vType as integer no-undo.
     2580         if code.misc3 eq "error"
     2581         then
     2582            vType = 0.
     2583         else if code.misc3 eq "warning"
     2584         then
     2585            vType = 1.
     2586         else if code.misc3 eq "Hiden"
     2587         then
     2588            vType = 2.
     2589         else
     2590            vtype = int(code.misc3) no-error.
     2591         case itype:
     2592            when "error"
     2593            then do:
     2594               if vtype eq 0
     2595               then
     2596                  vError = GetMesError(Code.CodeValue,iChechObj).
     2597            end.
     2598            when "warning"
     2599            then do:
     2600               if vtype <= 1
     2601               then
     2602                  vError = GetMesError(Code.CodeValue,iChechObj).
     2603            end.
     2604            otherwise do:
     2605               vError = GetMesError(Code.CodeValue,iChechObj).
     2606            end.
     2607         end.
     2608      end.
     2609      else
     2610         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2611      return vError.
     2612   end.
     2613   function GetTypeError returns integer
     2614   (iCheckType as character,
     2615    iCodeErr   as character):
     2616      define buffer code    for code.
     2617      define variable vType as integer no-undo.
     2618      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2619                        and code.code   eq iCodeErr
     2620      no-lock no-error.
     2621      if     not available code
     2622         and code.misc3 eq "error"
     2623      then
     2624         vType = 0.
     2625      else if code.misc3 eq "warning"
     2626      then
     2627         vType = 1.
     2628      else if code.misc3 eq "Hiden"
     2629      then
     2630         vType = 2.
     2631      else
     2632         vtype = int(code.misc3) no-error.
     2633      return vtype.
     2634   end.
     2635   function GetTextError returns character
     2636   (iCheckType as character,
     2637    iCodeErr   as character,
     2638    iChechObj  as character ):
     2639      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2640   end.
     2641   function GetErrForUtdStr returns character
     2642   (idb-num     as integer ,
     2643    idoc-id     as integer ,
     2644    iCheckType  as character
     2645    ):
     2646      define buffer utd-err for utd-err.
     2647      define buffer code    for code.
     2648      define variable vHQry as handle no-undo.
     2649      define variable vError as longchar no-undo.
     2650      define variable vErrorOne as longchar  no-undo.
     2651      define variable oError as character no-undo.
     2652      create query vHQry.
     2653      vHQry:set-buffers(buffer utd-err:handle).
     2654      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2655                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2656                               + if    iCheckType eq "*"
     2657                                    or iCheckType eq ?
     2658                                 then       ""
     2659                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2660      vHQry:query-open().
     2661      vHQry:get-first().
     2662      QRY-BLOCK:
     2663      repeat while not vHQry:query-off-end:
     2664         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2665         if     vErrorOne ne ""
     2666            and vErrorOne ne ?
     2667         then
     2668            vError = vError + ", " + vErrorOne.
     2669         vHQry:get-next().
     2670      end.
     2671      oError = substring(vError,3,4002).
     2672      return oError.
     2673   end.
     2674   function GetErrJsonForUtd returns character
     2675   (idb-num         as integer ,
     2676    idoc-id         as integer ,
     2677    iCheckType      as character
     2678    ):
     2679      define buffer utd-err for utd-err.
     2680      define variable vHQry as handle no-undo.
     2681      define variable vError as longchar no-undo.
     2682      define variable oError as character no-undo.
     2683      create query vHQry.
     2684      define variable vi as integer no-undo.
     2685      vHQry:set-buffers(buffer utd-err:handle).
     2686      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2687                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2688                               + if    iCheckType eq "*"
     2689                                    or iCheckType eq ?
     2690                                 then       ""
     2691                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2692      vHQry:query-open().
     2693      vHQry:get-first().
     2694      QRY-BLOCK:
     2695      repeat while not vHQry:query-off-end:
     2696         define variable vErrorOne as character no-undo.
     2697         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2698         if     vErrorOne ne ?
     2699            and vErrorOne ne ""
     2700         then do:
     2701            vi = vi + 1.
     2702            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2703                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2704                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2705         end.
     2706         vHQry:get-next().
     2707      end.
     2708      for first utd where utd.db-num eq idb-num
     2709                      and utd.doc-id eq idoc-id
     2710                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2711      no-lock,
     2712         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2713                                  and utd-marking-lines.doc-id eq idoc-id
     2714                                  and utd-marking-lines.doc-level eq 1
     2715      no-lock,
     2716         first marking where marking.mark eq utd-marking-lines.mark
     2717                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2718      no-lock:
     2719         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2720         if     vErrorOne ne ?
     2721            and vErrorOne ne ""
     2722         then do:
     2723            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2724                            + '","ОбъектОш":"' + marking.mark
     2725                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2726         end.
     2727      end.
     2728      if vError ne ""
     2729      then
     2730         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2731      return oError.
     2732   end.
     2733   function GetErrJsonForUtdReturn returns character
     2734   (idb-num         as integer ,
     2735    idoc-id         as integer ,
     2736    iCheckType      as character
     2737    ):
     2738      define buffer utd-err for utd-err.
     2739      define variable vHQry as handle no-undo.
     2740      define variable vError as longchar no-undo.
     2741      define variable oError as character no-undo.
     2742      define variable vi as integer no-undo.
     2743      create query vHQry.
     2744      vHQry:set-buffers(buffer utd-err:handle).
     2745      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2746                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2747                               + if    iCheckType eq "*"
     2748                                    or iCheckType eq ?
     2749                                 then       ""
     2750                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2751      vHQry:query-open().
     2752      vHQry:get-first().
     2753      QRY-BLOCK:
     2754      repeat while not vHQry:query-off-end:
     2755         define variable vErrorOne as character no-undo.
     2756         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2757         if     vErrorOne ne ?
     2758            and vErrorOne ne ""
     2759         then do:
     2760            vi = vi + 1.
     2761            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2762                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2763                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2764         end.
     2765         vHQry:get-next().
     2766      end.
     2767      if vError ne ""
     2768      then
     2769         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2770      return oError.
     2771   end.
     2772   function GetCodeTextError returns character
     2773   (iCheckType as character,
     2774    iCodeErr   as character,
     2775    iChechObj  as character,
     2776    output oCode as character,
     2777    output ovalue as character ):
     2778      define buffer code    for code.
     2779      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2780                        and code.code   eq iCodeErr
     2781      no-lock no-error.
     2782      if     available code
     2783      then do:
     2784         define variable vi as integer no-undo init ?.
     2785         vi = int(Code.misc3) no-error.
     2786         if    code.misc3 ne "error"
     2787            and vi ne 0
     2788         then
     2789            oCode = ?.
     2790         else if     Code.misc1 ne ?
     2791                 and Code.misc1 ne ""
     2792         then
     2793            assign
     2794               oCode  = GetMesError(Code.misc1,iChechObj)
     2795               ovalue = GetMesError(Code.misc2,iChechObj)
     2796            .
     2797      end.
     2798      return if oCode eq ""
     2799             then ""
     2800             else (oCode + "_" + ovalue).
     2801   end.
     2802   define temp-table TT-err no-undo
     2803     field code_ as character
     2804     field text_ as character
     2805   index code_ code_.
     2806   function GetErrTxtForUtd returns character
     2807   (idb-num         as integer ,
     2808    idoc-id         as integer ,
     2809    iCheckType      as character
     2810    ):
     2811      define buffer utd-err for utd-err.
     2812      define variable vHQry as handle no-undo.
     2813      define variable oError as character no-undo.
     2814      create query vHQry.
     2815      define variable vi as integer no-undo.
     2816      for each tt-err :
     2817         delete tt-err.
     2818      end.
     2819      vHQry:set-buffers(buffer utd-err:handle).
     2820      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2821                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2822                               + if    iCheckType eq "*"
     2823                                    or iCheckType eq ?
     2824                                 then       ""
     2825                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2826      vHQry:query-open().
     2827      vHQry:get-first().
     2828      define variable vcode as character no-undo.
     2829      define variable vvalue as character no-undo.
     2830      QRY-BLOCK:
     2831      repeat while not vHQry:query-off-end:
     2832         vi = vi + 1.
     2833         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2834         if vcode ne ?
     2835         then do:
     2836            find first tt-err where tt-err.code eq vcode
     2837            no-error.
     2838            if not available tt-err
     2839            then do:
     2840               create tt-err.
     2841               assign
     2842                  tt-err.code_ = vcode
     2843                  tt-err.text_ = vvalue
     2844               .
     2845            end.
     2846            else
     2847               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2848         end.
     2849         vHQry:get-next().
     2850      end.
     2851     find first utd where utd.db-num eq idb-num
     2852                         and utd.doc-id eq idoc-id
     2853         no-lock.
     2854      define buffer cancel_utd-lines for utd-lines.
     2855      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2856                                  and cancel_utd-lines.doc-id eq idoc-id
     2857      no-lock:
     2858         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2859         then do:
     2860            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2861                                        and utd-marking-lines.doc-id eq idoc-id
     2862                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2863            no-lock,
     2864               first marking where marking.mark eq utd-marking-lines.mark
     2865                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2866            no-lock:
     2867               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2868               find first tt-err where tt-err.code eq vcode
     2869               no-error.
     2870               if not available tt-err
     2871               then do:
     2872                  create tt-err.
     2873                  assign
     2874                     tt-err.code_ = vcode
     2875                     tt-err.text_ = vvalue
     2876                  .
     2877               end.
     2878               else
     2879                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2880            end.
     2881         end.
     2882         else do:
     2883            define variable vqnty as decimal no-undo.
     2884            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2885            if vqnty eq ? then vqnty = 0.
     2886            if vqnty ne cancel_utd-lines.Quantity
     2887            then do:
     2888               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2889               find first tt-err where tt-err.code eq vcode
     2890               no-error.
     2891               if not available tt-err
     2892               then do:
     2893                  create tt-err.
     2894                  assign
     2895                     tt-err.code_ = vcode
     2896                     tt-err.text_ = vvalue
     2897                  .
     2898               end.
     2899               else
     2900                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2901            end.
     2902         end.
     2903      end.
     2904      for each tt-err:
     2905         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2906      end.
     2907      return oError.
     2908   end.
     2909   define variable mFormatErr as character no-undo init "text".
     2910   function GetErrForUtd returns character
     2911   (idb-num         as integer ,
     2912    idoc-id         as integer ,
     2913    iType           as character
     2914    ):
     2915      if mFormatErr eq "text"
     2916      then
     2917         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2918      else do:
     2919         if itype eq "return"
     2920         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2921         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2922      end.
     2923   end.
     2924   function GetErrComText returns longchar
     2925   (icomment as character,
     2926    itext    as longchar ):
     2927       define variable vText as longchar no-undo.
     2928      if mFormatErr eq "text"
     2929      then do:
     2930         if icomment ne ""
     2931         then
     2932            icomment = substitute("comment:|&1|",icomment).
     2933         vText = icomment + itext.
     2934      end.
     2935      else do:
     2936         icomment = if icomment begins  '"'
     2937                    then icomment
     2938                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2939         vText = icomment + "," + itext.
     2940         vText = "~{" + trim(vText,",") + "~}".
     2941      end.
     2942      return vText.
     2943   end.
     2944   function CheckTypeForMarkLineType returns logical
     2945   (iObj            as handle,
     2946    iCheckType      as character,
     2947    iCodeErr        as character ,
     2948    iTypeErr        as character ):
     2949      define variable vRecKey-markLine as character no-undo.
     2950      define variable vGoodMark        as logical no-undo.
     2951      define variable vdb-num          as integer no-undo.
     2952      define variable vdoc-id          as integer no-undo.
     2953      define variable vlinenum         as integer no-undo.
     2954      define variable vErrorOne as character no-undo.
     2955      define buffer buf_utd-err for utd-err.
     2956      run gen-key-rec (input "utd-marking-lines",
     2957                       input  iObj,
     2958                       output vRecKey-markLine).
     2959      vGoodMark = yes.
     2960      vdb-num = iObj::db-num.
     2961      vdoc-id = iObj::doc-id.
     2962      vlinenum = iObj::linenum.
     2963      block-mark-err:
     2964      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2965                               and buf_utd-err.db-num = vdb-num
     2966                               and buf_utd-err.reckey = vRecKey-markLine
     2967                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2968                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2969      no-lock:
     2970         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2971         if     vErrorOne ne ?
     2972            and vErrorOne ne ""
     2973         then do:
     2974            vGoodMark = no.
     2975            leave block-mark-err.
     2976         end.
     2977      end.
     2978      return not vGoodMark.
     2979   end.
     2980   function CheckErrForMarkLineType returns logical
     2981   (iObj            as handle,
     2982    iType           as character  ):
     2983      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2984   end.
     2985   function CheckErrForMarkLine returns logical
     2986   (iObj            as handle):
     2987      return CheckErrForMarkLineType(iObj,"*").
     2988   end.
     2989   function CheckErrForLineTypeCode returns logical
     2990   (iObj                 as handle,
     2991    iCheckType           as character,
     2992    iCodeErr             as character,
     2993    iTypeErr             as character,
     2994    iOneErr              as logical):
     2995      define variable vRecKey-line     as character no-undo.
     2996      define buffer buf_utd-err for utd-err.
     2997      define variable vUtdlineError as logical no-undo.
     2998      define variable vErrorOne as character no-undo.
     2999            run gen-key-rec (input "utd-lines",
     3000                             input  iObj,
     3001                             output vRecKey-line).
     3002         define variable vdb-num as integer no-undo.
     3003         define variable vdoc-id as integer no-undo.
     3004         define variable vlinenum as integer no-undo.
     3005         vdb-num = iObj::db-num.
     3006         vdoc-id = iObj::doc-id.
     3007         vlinenum = iObj::linenum.
     3008         block-err:
     3009         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3010                                  and buf_utd-err.db-num = vdb-num
     3011                                  and buf_utd-err.reckey = vRecKey-line
     3012                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3013                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3014         no-lock:
     3015            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3016            if     vErrorOne ne ?
     3017               and vErrorOne ne ""
     3018            then do:
     3019               vUtdlineError = yes.
     3020               leave block-err.
     3021            end.
     3022         end.
     3023         if  not vUtdlineError
     3024         then do:
     3025            define variable vGoodMark as logical no-undo.
     3026            vGoodMark = yes.
     3027            block-line-err:
     3028            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3029                                         and utd-marking-lines.doc-id  eq vdoc-id
     3030                                         and utd-marking-lines.LineNum eq vLineNum
     3031            no-lock:
     3032               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3033               if     vGoodMark
     3034                  and iOneErr eq no
     3035               then
     3036                  leave block-line-err.
     3037               if     iOneErr = yes
     3038                  and not vGoodMark
     3039               then
     3040                  leave block-line-err.
     3041            end.
     3042            vUtdlineError = not vGoodMark.
     3043         end.
     3044      return vUtdlineError.
     3045   end.
     3046   function getErrForLineType returns character
     3047   (iObj            as handle,
     3048    iType           as character  ):
     3049      define variable vRecKey-line     as character no-undo.
     3050      define buffer buf_utd-err for utd-err.
     3051      define variable vUtdlineError as logical no-undo.
     3052      define variable vErrorOne as character no-undo.
     3053      define variable oError as character no-undo.
     3054            run gen-key-rec (input "utd-lines",
     3055                             input  iObj,
     3056                             output vRecKey-line).
     3057         define variable vdb-num as integer no-undo.
     3058         define variable vdoc-id as integer no-undo.
     3059         define variable vlinenum as integer no-undo.
     3060         vdb-num = iObj::db-num.
     3061         vdoc-id = iObj::doc-id.
     3062         vlinenum = iObj::linenum.
     3063         block-err:
     3064         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3065                                  and buf_utd-err.db-num = vdb-num
     3066                                  and buf_utd-err.reckey = vRecKey-line
     3067                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3068         no-lock:
     3069            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3070            if     vErrorOne ne ?
     3071               and vErrorOne ne ""
     3072            then do:
     3073               oError = oError + vErrorOne + " ".
     3074            end.
     3075         end.
     3076      return oError.
     3077   end.
     3078   function CheckErrForLineType returns logical
     3079   (iObj            as handle,
     3080    iType           as character  ):
     3081       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3082   end.
     3083   function CheckErrForLine returns logical
     3084   (iObj            as handle):
     3085      return CheckErrForLineType(iobj,"*").
     3086   end.
     3087   function CheckErrForUtd returns logical
     3088   (idb-num         as integer ,
     3089    idoc-id         as integer ):
     3090      for each utd-lines where utd-lines.db-num eq idb-num
     3091                           and utd-lines.doc-id eq idoc-id
     3092      no-lock :
     3093         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3094         then
     3095            return no.
     3096      end.
     3097      return yes.
     3098   end.
     3099   function CheckMarkUtd-28rel return logical
     3100    (input idb-num as integer,
     3101    input idoc-id as integer):
     3102    define buffer utd                   for utd.
     3103    define buffer utd-lines             for utd-lines.
     3104    define buffer utd-marking-lines     for utd-marking-lines.
     3105    define variable v-par-type as character no-undo.
     3106    define variable vgdsNoMark as logical no-undo.
     3107    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3108      define variable v-par-val  as character no-undo.
     3109      find first utd where utd.db-num eq idb-num
     3110                       and utd.doc-id eq idoc-id
     3111      no-lock no-error.
     3112      if available utd
     3113      then do:
     3114         if     utd.obj-code ne ?
     3115            and utd.obj-type ne ?
     3116         then do:
     3117            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3118            Block-utd-lines:
     3119            for each utd-lines where utd-lines.db-num eq idb-num
     3120                                 and utd-lines.doc-id eq idoc-id
     3121            no-lock:
     3122               if     utd-lines.gds-code ne ?
     3123                  and utd-lines.gds-code ne 0
     3124               then do:
     3125                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3126                       ( utd-lines.gds-code,
     3127                         'mark-type':U,
     3128                          output v-par-val,
     3129                          output v-par-type
     3130                       ).
     3131                  if     EDOParSec:IsEdo
     3132                     and EDOParSec:GetIsEDOForType(v-par-val)
     3133                  then do:
     3134                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3135                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3136                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3137                                                    and length(utd-marking-lines.mark) > 13
     3138                     no-lock no-error.
     3139                     if     avail utd-marking-lines
     3140                        and not CheckErrForLine(buffer utd-lines:handle)
     3141                     then
     3142                        leave Block-utd-lines.
     3143                  end.
     3144                  else
     3145                     vgdsNoMark = yes.
     3146               end.
     3147            end.
     3148            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3149            if vgdsNoMark then return available utd-lines . else return yes .
     3150         end.
     3151      end.
     3152      return yes.
     3153   end.
     3154   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3155   define temp-table tt-utd-mark no-undo like utd-marking-lines
     3156     field side as character.
     3157   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3158   function CheckMarkUtd return logical
     3159    (input idb-num  as integer,
     3160     input idoc-id  as integer):
     3161     define buffer utd-lines             for ub.utd-lines.
     3162     block-line:
     3163     for each utd-lines where utd-lines.db-num eq idb-num
     3164                          and utd-lines.doc-id eq idoc-id
     3165     no-lock:
     3166        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3167        then
     3168           leave block-line.
     3169     end.
     3170     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3171     return available utd-lines.
     3172   end.
     3173   function CheckNotMarkUtd return logical
     3174    (input idb-num  as integer,
     3175     input idoc-id  as integer):
     3176     define buffer utd-lines             for ub.utd-lines.
     3177     for each utd-lines where utd-lines.db-num eq idb-num
     3178                          and utd-lines.doc-id eq idoc-id
     3179     no-lock:
     3180        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3181        then
     3182           return yes.
     3183     end.
     3184     return no.
     3185   end.
     3186   function CheckMarkUtdLine return logical
     3187    (input idb-num  as integer,
     3188     input idoc-id  as integer,
     3189     input iLineNum as integer):
     3190    define buffer utd                   for utd.
     3191    define buffer utd-lines             for utd-lines.
     3192    define buffer utd-marking-lines     for utd-marking-lines.
     3193    define variable v-par-type as character no-undo.
     3194    define variable vMarking        as logical no-undo.
     3195    define variable vArtic          as logical no-undo.
     3196    define variable vTransitional   as logical no-undo.
     3197    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3198      define variable v-par-val  as character no-undo.
     3199      find first utd where utd.db-num eq idb-num
     3200                       and utd.doc-id eq idoc-id
     3201      no-lock no-error.
     3202      if available utd
     3203      then do:
     3204         if     utd.obj-code ne ?
     3205            and utd.obj-type ne ?
     3206         then do:
     3207            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3208            Block-utd-lines:
     3209            for each utd-lines where utd-lines.db-num   eq idb-num
     3210                                 and utd-lines.doc-id   eq idoc-id
     3211                                 and utd-lines.LineNum  eq iLineNum
     3212            no-lock:
     3213               if     utd-lines.gds-code ne ?
     3214                  and utd-lines.gds-code ne 0
     3215               then do:
     3216                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3217                       ( utd-lines.gds-code,
     3218                         'mark-type':U,
     3219                          output v-par-val,
     3220                          output v-par-type
     3221                       ).
     3222                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3223                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3224                  if vMarking
     3225                  then do:
     3226                     block-marking:
     3227                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3228                                                    and utd-marking-lines.doc-id   eq idoc-id
     3229                                                    and utd-marking-lines.LineNum  eq iLineNum
     3230                                                    and length(utd-marking-lines.mark) > 13
     3231                     no-lock:
     3232                        if isOAD(utd-marking-lines.mark)
     3233                        then do:
     3234                           assign
     3235                              vArtic   = yes
     3236                              vMarking = no
     3237                           .
     3238                           leave block-marking.
     3239                        end.
     3240                     end.
     3241                  end.
     3242                  if vArtic
     3243                  then do:
     3244                     block-artic:
     3245                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3246                                                    and utd-marking-lines.doc-id   eq idoc-id
     3247                                                    and utd-marking-lines.LineNum  eq iLineNum
     3248                                                    and length(utd-marking-lines.mark) > 13
     3249                     no-lock:
     3250                        if isMark(utd-marking-lines.mark)
     3251                        then do:
     3252                           assign
     3253                              vArtic   = no
     3254                              vMarking = yes
     3255                           .
     3256                           leave block-artic.
     3257                        end.
     3258                     end.
     3259                  end.
     3260                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3261                  if vTransitional
     3262                  then do:
     3263                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3264                                                    and utd-marking-lines.doc-id   eq idoc-id
     3265                                                    and utd-marking-lines.LineNum  eq iLineNum
     3266                                                    and length(utd-marking-lines.mark) > 13
     3267                     no-lock no-error.
     3268                     if not available utd-marking-lines
     3269                     then assign
     3270                        vMarking = no
     3271                        vArtic   = no
     3272                     .
     3273                  end.
     3274               end.
     3275               else
     3276                  assign
     3277                     vMarking      = yes
     3278                     vArtic        = no
     3279                     vTransitional = no
     3280                  .
     3281               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3282               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3283               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3284            end.
     3285         end.
     3286      end.
     3287      return vMarking or vArtic.
     3288   end.
     3289   function getMarkUtdLine return logical
     3290    (input  idb-num  as integer,
     3291     input  idoc-id  as integer,
     3292     input  iLineNum as integer,
     3293     output oMarking        as logical,
     3294     output oArtic          as logical,
     3295     output oTransitional   as logical):
     3296     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3297     oArtic        = not oMarking
     3298            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3299     oTransitional = (oMarking or oArtic)
     3300            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3301   end.
     3302   function CheckMarking return logical
     3303    (input idb-num as integer,
     3304    input idoc-id as integer,
     3305    input iTypeErr as character ):
     3306     define variable vMarkutd as logical no-undo.
     3307     define variable vCrErr   as logical no-undo.
     3308     define buffer utd-lines         for utd-lines.
     3309     define buffer utd-marking-lines for utd-marking-lines.
     3310     define buffer marking           for marking.
     3311     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3312      block-line:
     3313      for each utd-lines where utd-lines.db-num eq idb-num
     3314                           and utd-lines.doc-id eq idoc-id
     3315      no-lock:
     3316         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3317         then do:
     3318            for each utd-marking-lines
     3319                     where utd-marking-lines.db-num  = utd-lines.db-num
     3320                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3321                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3322            no-lock:
     3323               if isMark(utd-marking-lines.mark)
     3324               then do:
     3325                  find first marking where marking.mark eq utd-marking-lines.mark
     3326                  no-lock no-error.
     3327                  if not available marking
     3328                  then do:
     3329                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3330                     vCrErr = yes.
     3331                     next block-line.
     3332                  end.
     3333               end.
     3334            end.
     3335         end.
     3336      end.
     3337      return vCrErr.
     3338   end.
     3339   function CheckMarkForType return logical
     3340    (input idb-num   as integer,
     3341     input idoc-id   as integer):
     3342      define variable vMarking        as logical no-undo.
     3343      define variable vArtic          as logical no-undo.
     3344      define variable vTransitional   as logical no-undo.
     3345      define buffer utd-lines         for utd-lines.
     3346      define buffer utd-marking-lines for utd-marking-lines.
     3347      block-line:
     3348      for each utd-lines where utd-lines.db-num eq idb-num
     3349                           and utd-lines.doc-id eq idoc-id
     3350      no-lock:
     3351         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3352                          output vMarking         , output vArtic          , output vTransitional).
     3353         for each utd-marking-lines
     3354                     where utd-marking-lines.db-num  = utd-lines.db-num
     3355                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3356                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3357         no-lock:
     3358            if length(utd-marking-lines.mark) < 14
     3359            then do:
     3360               if (vMarking or vArtic) and not vTransitional
     3361               then
     3362                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3363            end.
     3364            else if not isMark(utd-marking-lines.mark)
     3365            then do:
     3366               if vMarking
     3367               then
     3368                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3369            end.
     3370            else do:
     3371            end.
     3372         end.
     3373      end.
     3374   end.
     3375   function WeighedProd return logical
     3376      ( input p-gds-code as integer) :
     3377      define variable v-par-val  as character no-undo.
     3378      define variable v-par-type as character no-undo.
     3379              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3380               ( p-gds-code,
     3381                 'weighed-gds':U,
     3382                  output v-par-val,
     3383                  output v-par-type
     3384               ).
     3385      return logical(v-par-val).
     3386   end.
     3387   function WghProdVariable return logical
     3388       (input p-obj-type as char,
     3389        input p-obj-code as integer,
     3390        input p-gds-code as integer) :
     3391      define variable v-wgh-val  as character no-undo.
     3392      define variable v-par-val  as character no-undo.
     3393      define variable v-par-type as character no-undo.
     3394      define variable vMarking        as logical no-undo.
     3395      define variable vArtic          as logical no-undo.
     3396      define variable vTransitional   as logical no-undo.
     3397      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3398         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3399           ( p-gds-code,
     3400             'weighed-gds':U,
     3401              output v-wgh-val,
     3402              output v-par-type
     3403           ).
     3404       if logical(v-wgh-val) = yes then do:
     3405           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3406               ( p-gds-code,
     3407                 'mark-type':U,
     3408                  output v-par-val,
     3409                  output v-par-type
     3410               ).
     3411           if v-par-val <> "" then do:
     3412               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3413               assign
     3414                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3415                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3416                  .
     3417           end.
     3418      end.
     3419      if v-wgh-val > "" and (vMarking or vArtic)
     3420      then return yes.
     3421      else return no.
     3422   end.
     3423   function MarkWeight return decimal
     3424      ( input p-mark as character) :
     3425      define buffer  buf_marking-attr for  ub.marking-attr.
     3426      define variable vMarkWeight as decimal no-undo.
     3427      vMarkWeight = 0.
     3428      if p-mark <> "" and p-mark <> ?
     3429      then do:
     3430          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3431                                        and buf_marking-attr.attr-code eq "weight"
     3432             no-lock no-error.
     3433          if not available buf_marking-attr
     3434          then do :
     3435            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3436                                          and buf_marking-attr.attr-code eq "weight"
     3437               no-lock no-error.
     3438          end .
     3439          if avail buf_marking-attr
     3440          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3441      end.
     3442      return vMarkWeight.
     3443   end.
     3444   function CheckQnty returns logical
     3445   (  input idb-num  as integer,
     3446      input idoc-id  as integer,
     3447      input iErrType as character
     3448   ):
     3449      if iErrType ne "loadUTD"
     3450      then do:
     3451         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3452         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3453         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3454      end.
     3455      if iErrType ne "CheckQnty"
     3456      then do:
     3457         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3458         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3459         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3460      end.
     3461      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3462      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3463      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3464      define buffer marking               for marking.
     3465      define buffer utd-lines             for utd-lines.
     3466      define buffer utd-marking-lines     for utd-marking-lines.
     3467      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3468      block-line:
     3469      for each utd-lines where utd-lines.db-num eq idb-num
     3470                           and utd-lines.doc-id eq idoc-id
     3471      no-lock:
     3472         define variable Vflagmark as logical no-undo.
     3473         find first buf_utd-marking-lines
     3474                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3475                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3476                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3477                         and length(buf_utd-marking-lines.mark) > 13
     3478         no-lock no-error.
     3479         if not available buf_utd-marking-lines
     3480         then
     3481            next block-line.
     3482         define variable vqntyMark as integer no-undo.
     3483         define variable vqntyOAD  as integer no-undo.
     3484         vqntyMark = 0.
     3485         vqntyOAD  = 0.
     3486         block-mark:
     3487         for each utd-marking-lines
     3488              where utd-marking-lines.db-num  = utd-lines.db-num
     3489                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3490                and utd-marking-lines.LineNum = utd-lines.LineNum
     3491                and length(utd-marking-lines.mark) > 13
     3492                and utd-marking-lines.doc-level  = 1
     3493         no-lock:
     3494            if isMark(utd-marking-lines.mark)
     3495            then do:
     3496               find first marking where marking.mark eq utd-marking-lines.mark
     3497               no-lock no-error.
     3498               if available marking
     3499               then do:
     3500                  if marking.box-qnty ne ?
     3501                  then
     3502                     vqntyMark = vqntyMark + marking.box-qnty.
     3503               end.
     3504            end.
     3505            else do:
     3506               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3507                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3508                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3509                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3510                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3511               no-lock no-error.
     3512               if available utd-marking-lines-attr
     3513               then
     3514                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3515            end.
     3516         end.
     3517         if     utd-lines.gds-code   gt 0
     3518            and utd-lines.gds-code   ne ?
     3519            and vqntyMark            ne 0
     3520         then do:
     3521            if utd-lines.Quantity  < vqntyMark
     3522            then
     3523               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3524            else if utd-lines.Quantity  <> vqntyMark
     3525            then
     3526               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3527         end.
     3528         else if     utd-lines.gds-code   gt 0
     3529            and utd-lines.gds-code   ne ?
     3530            and vqntyOAD ne 0
     3531            and utd-lines.Quantity  ne vqntyOAD
     3532         then
     3533            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3534      end.
     3535   end.
     3536   function CheckGds returns logical
     3537   (  input idb-num   as integer,
     3538      input idoc-id   as integer,
     3539      input iobj-type as character,
     3540      input iobj-code as integer,
     3541      input iErrType as character
     3542   ):
     3543      if iErrType ne "loadUTD"
     3544      then do:
     3545         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3546         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3547         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3548         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3549         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3550         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3551         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3552         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3553         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3554         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3555         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3556      end.
     3557      if iErrType ne "CheckGds"
     3558      then do:
     3559         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3560         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3561         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3562         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3563         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3564         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3565         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3566         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3567         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3568         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3569         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3570      end.
     3571      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3572      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3573      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3574      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3575      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3576      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3577      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3578      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3579      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3580      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3581      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3582      define variable v-par-type as character no-undo.
     3583      define variable v-par-val  as character no-undo.
     3584      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3585      define buffer marking               for marking.
     3586      define buffer utd-lines             for utd-lines.
     3587      define buffer buf_utd-lines         for utd-lines.
     3588      define buffer utd-marking-lines     for utd-marking-lines.
     3589      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3590      define variable vGdsCode as integer no-undo.
     3591      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3592      block-line:
     3593      for each utd-lines where utd-lines.db-num eq idb-num
     3594                           and utd-lines.doc-id eq idoc-id
     3595      no-lock:
     3596         vGdsCode = ?.
     3597         define variable Vflagmark as logical no-undo.
     3598         define variable VflagOAD  as logical no-undo.
     3599         assign
     3600            Vflagmark = no
     3601            VflagOAD = no
     3602         .
     3603         block-mark:
     3604         for each utd-marking-lines
     3605                  where utd-marking-lines.db-num  = utd-lines.db-num
     3606                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3607                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3608         no-lock:
     3609            if    isMark(utd-marking-lines.mark)
     3610               or isOAD (utd-marking-lines.mark)
     3611            then do:
     3612               define variable vnewGdsCode as integer no-undo.
     3613               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3614               if isMark(utd-marking-lines.mark)
     3615               then do:
     3616                  Vflagmark = yes.
     3617                  find first marking where marking.mark eq utd-marking-lines.mark
     3618                  no-lock no-error.
     3619                  if not available marking
     3620                  then do:
     3621                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3622                     next block-mark.
     3623                  end.
     3624                  if vnewGdsCode eq ?
     3625                  then
     3626                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3627                  if    marking.gds-code eq 0
     3628                     or marking.gds-code eq ?
     3629                     or marking.sts eq 0
     3630                     or marking.sts eq ?
     3631                     or marking.box-qnty eq ?
     3632                     or (marking.gds-code ne vnewGdsCode
     3633                         and vnewGdsCode ne ?
     3634                         and vnewGdsCode ne 0)
     3635                  then do:
     3636                     find first marking where marking.mark eq utd-marking-lines.mark
     3637                     exclusive-lock no-error.
     3638                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3639                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3640                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3641                     if    marking.gds-ext-id eq ""
     3642                        or marking.gds-ext-id eq ?
     3643                     then do:
     3644                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3645                     end.
     3646                     else if    marking.gds-code eq 0
     3647                             or marking.gds-code eq ?
     3648                     then
     3649                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3650                     else if     marking.sts eq 0
     3651                             or  marking.sts eq ?
     3652                     then
     3653                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3654                  end.
     3655                  if utd-marking-lines.doc-level eq 1
     3656                  then do:
     3657                     if marking.box-qnty eq ?
     3658                     then
     3659                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3660                  end.
     3661               end.
     3662               else do:
     3663                  VflagOAD = yes.
     3664                  define variable vQnty as decimal no-undo.
     3665                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3666                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3667                                          utd-marking-lines.doc-id,
     3668                                          utd-marking-lines.LineNum,
     3669                                          utd-marking-lines.mark,
     3670                                          "box-qnty",
     3671                                           string(vQnty)).
     3672                  define variable vgtin as character no-undo.
     3673                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3674                  if getQntyCodeByGtin(vgtin) ne 1
     3675                  then
     3676                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3677               end.
     3678               if utd-marking-lines.gds-code ne vnewGdsCode
     3679               and vnewGdsCode ne ?
     3680               and vnewGdsCode ne 0
     3681               then do:
     3682                  find first buf_utd-marking-lines
     3683                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3684                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3685                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3686                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3687                  exclusive-lock no-error.
     3688                  if available buf_utd-marking-lines
     3689                  then do:
     3690                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3691                  end.
     3692               end.
     3693            end.
     3694            else  do:
     3695               define variable vgdsbar as integer no-undo.
     3696               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3697               if    utd-marking-lines.gds-code ne vgdsbar
     3698               then do:
     3699                  find first buf_utd-marking-lines
     3700                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3701                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3702                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3703                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3704                  exclusive-lock no-error.
     3705                  if available buf_utd-marking-lines
     3706                  then do:
     3707                     buf_utd-marking-lines.gds-code = vgdsbar.
     3708                  end.
     3709               end.
     3710               if vgdsbar ne ?
     3711               then do:
     3712                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3713                            ( vgdsbar,
     3714                              'mark-type':U,
     3715                              output v-par-val,
     3716                              output v-par-type
     3717                             ).
     3718                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3719                       or  EDOParSec:GetIsArticForType(v-par-val))
     3720                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3721                   and     EDOParSec:IsEdo
     3722                  then do:
     3723                     AddUtdErr(utd-marking-lines.db-num,
     3724                               utd-marking-lines.doc-id,
     3725                               buffer utd-marking-lines:handle,
     3726                               iErrType,
     3727                               "MarkingForTypeEDO",
     3728                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3729                  end.
     3730               end.
     3731            end.
     3732            if vGdsCode eq ?
     3733            then
     3734               vGdsCode = utd-marking-lines.gds-code.
     3735            if vGdsCode ne utd-marking-lines.gds-code
     3736            and utd-marking-lines.gds-code > 0
     3737            then do:
     3738               vGdsCode = -1.
     3739            end.
     3740         end.
     3741         if  vGdsCode = -1
     3742         then do:
     3743            vGdsCode = ?.
     3744            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3745            next block-line.
     3746         end.
     3747         if vGdsCode ne ?
     3748         then do:
     3749                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3750                      ( vGdsCode,
     3751                        'mark-type':U,
     3752                        output v-par-val,
     3753                        output v-par-type
     3754                       ).
     3755            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3756                and(
     3757                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3758                     and not Vflagmark)
     3759                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3760                     and not VflagOAD
     3761                     and not Vflagmark))
     3762            then do:
     3763               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3764            end.
     3765         end.
     3766         if utd-lines.gds-code ne vGdsCode
     3767         then do:
     3768            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3769                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3770                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3771            exclusive-lock no-error.
     3772            if available buf_utd-lines
     3773            then
     3774               buf_utd-lines.gds-code = vGdsCode.
     3775            release buf_utd-lines.
     3776         end.
     3777         define variable VBarCode as character no-undo.
     3778         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3779         if VBarCode ne ?
     3780         then do:
     3781            if num-entries(VBarCode," ") > 0
     3782            then
     3783               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3784            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3785            if vgdsbar eq ? or vgdsbar eq 0
     3786            then do:
     3787               AddUtdErr(utd-lines.db-num,
     3788                         utd-lines.doc-id,
     3789                         buffer utd-lines:handle,
     3790                         iErrType,
     3791                         "NotFindGdsForBarCode",
     3792                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3793            end.
     3794            else do:
     3795               if    utd-lines.gds-code eq ?
     3796                  or utd-lines.gds-code eq 0
     3797               then do:
     3798                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3799                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3800                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3801                  exclusive-lock no-error.
     3802                  if available buf_utd-lines
     3803                  then
     3804                     buf_utd-lines.gds-code = vgdsbar.
     3805                  release buf_utd-lines.
     3806               end.
     3807               else if utd-lines.gds-code ne vgdsbar
     3808               then do:
     3809                  AddUtdErr(utd-lines.db-num,
     3810                         utd-lines.doc-id,
     3811                         buffer utd-lines:handle,
     3812                         iErrType,
     3813                         "NotEqGgsForLineAndMark",
     3814                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3815               end.
     3816            end.
     3817         end.
     3818         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3819         then
     3820            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3821      end.
     3822   end.
     3823   function GetUtdLineForOrig return logical
     3824   (input idb-num as integer,
     3825    input idoc-id as integer,
     3826    input ilineNum as integer,
     3827    input idb-numOrig as integer,
     3828    input idoc-idOrig as integer,
     3829    buffer edoc-lines for utd-lines):
     3830      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3831      block-mark:
     3832      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3833                                   and utd-marking-lines.doc-id  eq idoc-id
     3834                                   and utd-marking-lines.LineNum eq iLineNum
     3835                                   and utd-marking-lines.site eq "-"
     3836      no-lock:
     3837         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3838                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3839                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3840                     no-lock no-error.
     3841         if available edoc-marking-lines
     3842         then do:
     3843            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3844                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3845                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3846            no-lock no-error.
     3847               leave block-mark.
     3848          end.
     3849      end.
     3850       if not available edoc-lines
     3851       then do:
     3852          find  first  utd-lines where utd-lines.db-num      = idb-num
     3853                                   and utd-lines.doc-id      = idoc-id
     3854                                   and utd-lines.LineNum     = ilinenum
     3855             no-lock no-error.
     3856          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3857                                  and edoc-lines.doc-id      = idoc-idOrig
     3858                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3859          no-lock no-error.
     3860       end.
     3861       if not available edoc-lines
     3862       then
     3863          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3864                                  and edoc-lines.doc-id      = idoc-idOrig
     3865                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3866          no-lock no-error.
     3867   end.
     3868   function GetLastUTDinPack returns logical
     3869   (input idb-num as integer,
     3870    input idoc-id as integer,
     3871    output odb-num as integer,
     3872    output odoc-id as integer ) forward.
     3873   function getObgFns return logical
     3874   (input iDocumentNumber   as character ,
     3875    input iFnsParticipantId as character ,
     3876    input ikpp              as character ,
     3877    output ohost-code       as integer,
     3878    output oobj-type        as character ,
     3879    output oobj-code        as integer ,
     3880    output otext            as character  ):
     3881       define buffer ext-classif   for ext-classif.
     3882       define buffer clients       for clients.
     3883       define buffer buf_clients   for clients.
     3884       define buffer clients-attr  for clients-attr.
     3885       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3886                                and ext-classif.charkey_three eq iFnsParticipantId
     3887       no-lock no-error.
     3888       if available ext-classif
     3889       then do:
     3890          if ext-classif.CharKey_One eq 'маг':U
     3891          then do:
     3892             assign
     3893                oobj-type = ext-classif.CharKey_One
     3894                oobj-code = ext-classif.Key#_One
     3895             .
     3896             find first clients
     3897                  where clients.obj-type   = ext-classif.CharKey_One
     3898                    and clients.obj-code   = ext-classif.Key#_One
     3899             no-lock no-error .
     3900             if available clients
     3901             then
     3902                ohost-code =  clients.host-code.
     3903          end.
     3904          else do:
     3905             find first clients
     3906                  where clients.obj-type   = ext-classif.CharKey_One
     3907                    and clients.obj-code   = ext-classif.Key#_One
     3908                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3909             no-lock no-error .
     3910             if not available clients
     3911             then do:
     3912                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3913                return no.
     3914             end.
     3915             ohost-code = ext-classif.Key#_One.
     3916             block-cl:
     3917             for each clients-attr
     3918                where clients-attr.attr-code  = 'kpp':U
     3919                  and clients-attr.obj-type   = 'маг':U
     3920                  and clients-attr.attr-value = ikpp
     3921                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3922                                             and buf_clients.obj-code   = clients-attr.obj-code
     3923                                             and buf_clients.host-code  = ohost-code)
     3924             no-lock :
     3925                leave block-cl.
     3926             end.
     3927             if     available clients
     3928                and clients.obj-type eq 'маг':U
     3929             then do:
     3930                assign
     3931                   oobj-type = clients.obj-type
     3932                   oobj-code = clients.obj-code
     3933                .
     3934             end.
     3935             else if available clients-attr
     3936             then do:
     3937                assign
     3938                   oobj-type = clients-attr.obj-type
     3939                   oobj-code = clients-attr.obj-code
     3940                .
     3941             end.
     3942             else do:
     3943                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3944                return yes.
     3945             end.
     3946          end.
     3947       end.
     3948       else do:
     3949          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3950          return no.
     3951       end.
     3952       return ?.
     3953   end.
     3954   function CheckUcdForReturn return logical
     3955   (input idb-numUcd as integer,
     3956    input idoc-idUcd as integer,
     3957    input idb-numRet as integer,
     3958    input idoc-idRet as integer  ):
     3959       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3960                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3961                                    and utd-marking-lines.doc-level eq 1
     3962       no-lock:
     3963          create tt-utd-mark.
     3964          buffer-copy utd-marking-lines to tt-utd-mark
     3965          assign
     3966             tt-utd-mark.side = "+"
     3967          .
     3968       end.
     3969       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3970                                    and utd-marking-lines.doc-id eq idoc-idRet
     3971                                    and utd-marking-lines.doc-level eq 1
     3972       no-lock:
     3973          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3974          no-lock no-error.
     3975          if available tt-utd-mark
     3976          then
     3977             tt-utd-mark.side = "".
     3978          else do:
     3979             create tt-utd-mark.
     3980             buffer-copy utd-marking-lines to tt-utd-mark
     3981             assign
     3982                tt-utd-mark.side = "-"
     3983             .
     3984          end.
     3985       end.
     3986       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3987       no-lock:
     3988          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3989       end.
     3990       for each tt-utd-mark:
     3991          delete tt-utd-mark.
     3992       end.
     3993   end.
     3994   function GetLastUTDinPackAft returns logical
     3995   (input idb-num as integer,
     3996    input idoc-id as integer,
     3997    output odb-num as integer,
     3998    output odoc-id as integer ) forward.
     3999   function SaturateAndCheckUTD return character
     4000   (input idb-num as integer,
     4001    input idoc-id as integer  ):
     4002      define buffer clients-attr          for clients-attr.
     4003      define buffer clients               for clients.
     4004      define buffer Utd                   for Utd.
     4005      define buffer utd_ret               for ub.utd.
     4006      define buffer utd-lines             for utd-lines.
     4007      define buffer buf_utd-lines         for utd-lines.
     4008      define buffer buf_utddoc-lines      for utd-lines.
     4009      define buffer marking               for marking.
     4010      define buffer marking-lines         for marking-lines.
     4011      define buffer utd-marking-lines     for utd-marking-lines.
     4012      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4013      define buffer contract              for contract.
     4014      define buffer old_utd               for Utd.
     4015      define variable vError as character no-undo.
     4016      define variable vGdsCode as integer no-undo.
     4017      define variable vcli-type as character no-undo.
     4018      define variable vcli-code as integer no-undo.
     4019      define variable vhost-code as integer no-undo init ?.
     4020      define variable vcontract-code as integer no-undo.
     4021      define variable vobj-type as character no-undo init ?.
     4022      define variable vobj-code as integer no-undo init ?.
     4023      define variable volddb-num as integer no-undo.
     4024      define variable volddoc-id as integer no-undo.
     4025      define variable vMark as logical no-undo.
     4026      define variable VUcd as logical no-undo.
     4027      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4028      define variable v-par-type as character no-undo.
     4029      define variable v-par-val  as character no-undo.
     4030      define variable VFileMark as logical no-undo.
     4031      define variable vunit     as int no-undo.
     4032      define variable vunitCode as character no-undo.
     4033      define variable vMarkingUtd as logical no-undo.
     4034      find first Utd where utd.db-num eq idb-num
     4035                       and utd.doc-id eq idoc-id
     4036      no-lock no-error.
     4037      if available Utd
     4038      then do:
     4039         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     4040         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     4041         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     4042         assign
     4043               vobj-type  = utd.obj-type
     4044               vobj-code  = utd.obj-code
     4045               vhost-code = utd.host-code
     4046         .
     4047         do:
     4048            define variable vtext       as character no-undo.
     4049            define variable vhost-code1 as integer   no-undo.
     4050            define variable vobj-type1  as character no-undo.
     4051            define variable vobj-code1  as integer   no-undo.
     4052             getObgFns
     4053                       (input utd.DocumentNumber ,
     4054                        input utd.obj-FnsParticipantId ,
     4055                        input utd.obj-kpp,
     4056                        output vhost-code1,
     4057                        output vobj-type1,
     4058                        output vobj-code1,
     4059                        output vtext ).
     4060            assign
     4061               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     4062               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     4063               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     4064            .
     4065            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     4066            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     4067            block-line:
     4068            for each utd-lines where utd-lines.db-num eq utd.db-num
     4069                                 and utd-lines.doc-id eq utd.doc-id
     4070            no-lock:
     4071               vGdsCode =?.
     4072               define variable vNotMarkForLine as logical no-undo.
     4073               vNotMarkForLine = no.
     4074               if not VUcd
     4075               then do:
     4076                  find first utd-marking-lines
     4077                       where utd-marking-lines.db-num  = utd-lines.db-num
     4078                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     4079                         and utd-marking-lines.LineNum = utd-lines.LineNum
     4080                  no-lock no-error.
     4081                  if not available utd-marking-lines
     4082                  then do:
     4083                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     4084                     vNotMarkForLine = yes.
     4085                  end.
     4086               end.
     4087               block-mark:
     4088               for each utd-marking-lines
     4089                  where utd-marking-lines.db-num  = utd-lines.db-num
     4090                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4091                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4092               no-lock:
     4093                  vMark = yes.
     4094                  if     isMark(utd-marking-lines.mark)
     4095                     and utd-marking-lines.gds-code  ne 0
     4096                     and utd-marking-lines.gds-code ne ?
     4097                  then do:
     4098                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4099                           ( utd-marking-lines.gds-code,
     4100                            'mark-type':U,
     4101                            output v-par-val,
     4102                            output v-par-type
     4103                            ).
     4104                      if     not VFileMark
     4105                         and not VUcd
     4106                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     4107                      then do:
     4108                          AddUtdErr(utd.db-num,
     4109                                     utd.doc-id,
     4110                                     buffer utd-marking-lines:handle,
     4111                                     "loadUtd",
     4112                                     "NotON_NSCHFDOPPRMARK",
     4113                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4114                     end.
     4115                  end.
     4116               end.
     4117               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     4118               then do :
     4119                  if     VUcd
     4120                  then do:
     4121                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     4122                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     4123                     if available buf_utddoc-lines
     4124                     then do:
     4125                        vGdsCode = buf_utddoc-lines.gds-code.
     4126                        vunitCode = buf_utddoc-lines.UnitCode.
     4127                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4128                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4129                        then
     4130                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4131                               "loadUtd",
     4132                               "UcdUnitChangForUtd",
     4133                               string(utd-lines.LineNum )                  + chr(4) +
     4134                               buf_utddoc-lines.UnitCode                   + chr(4) +
     4135                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4136                     end.
     4137                     if     utd-lines.UnitCode ne ?
     4138                        and utd-lines.UnitCode ne ""
     4139                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4140                     then
     4141                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4142                               "loadUtd",
     4143                               "UcdUnitChang",
     4144                               string(utd-lines.LineNum )                  + chr(4) +
     4145                               utd-lines.UnitCode                          + chr(4) +
     4146                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4147                  end.
     4148               end.
     4149               else
     4150                  vGdsCode = utd-lines.gds-code.
     4151               define variable vValText as character no-undo.
     4152               define variable vValDec  as decimal no-undo.
     4153               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     4154               if VValText = ?
     4155               then do:
     4156                  vValDec = utd-lines.Quantity.
     4157                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     4158               end.
     4159               else
     4160                  vValDec = dec(VValText).
     4161               release bar-code .
     4162               if     vGdsCode > 0 and vGdsCode ne ?
     4163               then do:
     4164                  assign
     4165                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     4166                     vunit = ?
     4167                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     4168                  no-error.
     4169                  if vunit ne 0 and vunit ne ?
     4170                  then do:
     4171                     find units where units.OKEI eq vunit no-lock no-error.
     4172                     if available units
     4173                     then
     4174                        vunitCode = units.unit-name.
     4175                  end.
     4176                  find first bar-code where bar-code.gds-code eq vGdsCode
     4177                                        and bar-code.unit-cli eq vUnitCode
     4178                  no-lock no-error.
     4179                  if not available bar-code
     4180                  then
     4181                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4182                               "loadUtd",
     4183                               "Unit",
     4184                               string(utd-lines.LineNum )                  + chr(4) +
     4185                               string(vGdsCode)                            + chr(4) +
     4186                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     4187                               vunitCode).
     4188               end.
     4189               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     4190               then do:
     4191                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4192                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4193                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4194                  exclusive-lock no-error.
     4195                  if available buf_utd-lines
     4196                  then do:
     4197                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     4198                     release buf_utd-lines.
     4199                  end.
     4200               end.
     4201               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     4202               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     4203               if     not VUcd
     4204                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     4205               then
     4206                  vMarkingUtd = yes .
     4207            end.
     4208            if not VUcd
     4209            then
     4210               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4211            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4212                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4213            no-lock no-error.
     4214            if available ext-classif
     4215            then
     4216               assign
     4217                  vcli-type = ext-classif.CharKey_One
     4218                  vcli-code = ext-classif.Key#_One
     4219               .
     4220            else do:
     4221               assign
     4222                 vcli-type = ?
     4223                 vcli-code = ?
     4224               .
     4225               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4226            end.
     4227            find first contract  where contract.host-code eq vhost-code
     4228                                   and contract.cli-type  eq vcli-type
     4229                                   and contract.cli-code  eq vcli-code
     4230                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4231            no-lock no-error.
     4232            define variable VContractEdo as logical no-undo init yes.
     4233            if available contract
     4234            then do:
     4235               assign
     4236                  VContractEdo = contract.whole-send-news > 0
     4237                  vcontract-code = contract.contract-code
     4238               .
     4239               if not VContractEdo
     4240               then
     4241                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4242            end.
     4243            else do:
     4244               vcontract-code = ?.
     4245            end.
     4246         end.
     4247         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4248         then do:
     4249            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4250         end.
     4251         define variable vdoc-code as character no-undo init ?.
     4252         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4253         then do:
     4254            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4255                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4256                                 and utd_ret.Timestamp             le utd.Timestamp
     4257                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4258            no-lock no-error.
     4259            if available utd_ret
     4260            then do:
     4261               vdoc-code = utd_ret.doc-code.
     4262               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4263            end.
     4264         end.
     4265      end.
     4266      find current utd exclusive-lock no-error.
     4267      if available utd
     4268      then do:
     4269         assign
     4270            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4271            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4272            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4273            utd.contract-code = vcontract-code when vcontract-code ne ?
     4274            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4275            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4276            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4277         .
     4278         if   ( utd.contract-code eq ?
     4279            or utd.contract-code eq 0)
     4280            and not vucd
     4281         then
     4282            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4283         if utd.host-code eq ?
     4284            or utd.host-code eq 0
     4285         then
     4286            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4287         if utd.obj-code eq ?
     4288            or utd.obj-code eq 0
     4289         then
     4290            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4291      end.
     4292      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4293      if vError eq ""
     4294      then do:
     4295         if utd.sts eq 0 or utd.sts eq ?
     4296         then
     4297            utd.sts = if VUcd
     4298                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4299                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4300         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4301         then do:
     4302            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4303         end.
     4304         if     not VUcd
     4305            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4306         then do:
     4307            if not vMarkingUtd
     4308            then
     4309               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4310         end.
     4311      end.
     4312      else do:
     4313         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4314         then
     4315            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4316      end.
     4317      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4318         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4319      then
     4320         utd.sts-edi = ?.
     4321      else if     (not vMark and  not vucd) or not VContractEdo
     4322              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4323      then
     4324         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4325      release utd no-error.
     4326      if error-status:error
     4327      then
     4328         return error return-value.
     4329      return vError.
     4330   end.
     4331   function ReCheckload returns logical
     4332   (idb-num as integer,
     4333    idoc-id as integer,
     4334    iload   as logical ):
     4335      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4336      define buffer buf_c-utd for ub.c-utd .
     4337      define buffer buf_utd   for ub.utd .
     4338      find first buf_utd where buf_utd.db-num eq idb-num
     4339                           and buf_utd.doc-id eq idoc-id
     4340      exclusive-lock no-error.
     4341      if available buf_utd
     4342      then do:
     4343         if    iload
     4344            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4345         then do:
     4346            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4347            if  error-status:error then
     4348            do:
     4349               message return-value view-as alert-box.
     4350            end.
     4351         end.
     4352         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4353            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4354            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4355            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4356         then do:
     4357            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4358                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4359                                              buf_c-utd.sts    eq buf_utd.sts and
     4360                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4361            no-error .
     4362            if available (buf_c-utd)
     4363            then do:
     4364               buf_utd.sts = buf_c-utd.sts .
     4365               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4366            end.
     4367            else do:
     4368               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4369                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4370               then
     4371                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4372               else
     4373                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4374               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4375            end.
     4376         end.
     4377         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4378         then do:
     4379            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4380                                     input buf_utd.doc-id) .
     4381         end.
     4382      end.
     4383      release buf_utd.
     4384      unsubscribe "getNextseq".
     4385   end.
     4386   function ReCheck returns logical
     4387   (idb-num as integer,
     4388    idoc-id as integer ):
     4389      ReCheckload(idb-num,idoc-id,no).
     4390   end.
     4391   function GetLastUTDForPac returns logical
     4392   (iPackegeId as character ,
     4393    iTimestamp as datetime,
     4394    output odb-num as integer,
     4395    output odoc-id as integer ):
     4396      define buffer buf_utd for utd.
     4397      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4398                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4399                                and Buf_utd.Timestamp gt iTimestamp
     4400      no-lock no-error.
     4401      if available  buf_utd
     4402      then
     4403         assign
     4404            odb-num = buf_utd.db-num
     4405            odoc-id = buf_utd.doc-id
     4406         no-error.
     4407      else
     4408         assign
     4409            odb-num = ?
     4410            odoc-id = ?
     4411         no-error.
     4412   end.
     4413   function GetprevUTDForPac returns logical
     4414   (iPackegeId as character ,
     4415    iTimestamp as datetime,
     4416    output odb-num as integer,
     4417    output odoc-id as integer ):
     4418      define buffer buf_utd for utd.
     4419      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4420                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4421                                and Buf_utd.Timestamp < iTimestamp
     4422      no-lock no-error.
     4423      if available  buf_utd
     4424      then
     4425         assign
     4426            odb-num = buf_utd.db-num
     4427            odoc-id = buf_utd.doc-id
     4428         no-error.
     4429      else
     4430         assign
     4431            odb-num = ?
     4432            odoc-id = ?
     4433         no-error.
     4434   end.
     4435   function GetLastUTDinPackAft returns logical
     4436   (input idb-num as integer,
     4437    input idoc-id as integer,
     4438    output odb-num as integer,
     4439    output odoc-id as integer ):
     4440      define buffer buf_utd for utd.
     4441      define buffer     utd for utd.
     4442      find first utd where utd.db-num eq idb-num
     4443                       and utd.doc-id eq idoc-id
     4444      no-lock no-error.
     4445      if available utd
     4446      then do:
     4447         if utd.PackageId eq ""
     4448         then do:
     4449            assign
     4450               odb-num = utd.db-num
     4451               odoc-id = utd.doc-id
     4452            .
     4453            return yes.
     4454         end.
     4455         else do:
     4456            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4457            if    odb-num eq ?
     4458               or odoc-id eq ?
     4459            then do:
     4460               assign
     4461                  odb-num = utd.db-num
     4462                  odoc-id = utd.doc-id
     4463               .
     4464               return yes.
     4465            end.
     4466            else
     4467               return odoc-id = utd.doc-id.
     4468         end.
     4469      end.
     4470      return ?.
     4471   end.
     4472   function GetLastUTDinPackbef returns logical
     4473   (input idb-num as integer,
     4474    input idoc-id as integer,
     4475    output odb-num as integer,
     4476    output odoc-id as integer ):
     4477      define buffer buf_utd for utd.
     4478      define buffer     utd for utd.
     4479      find first utd where utd.db-num eq idb-num
     4480                       and utd.doc-id eq idoc-id
     4481      no-lock no-error.
     4482      if available utd
     4483      then do:
     4484         if utd.PackageId eq ""
     4485         then do:
     4486            assign
     4487               odb-num = utd.db-num
     4488               odoc-id = utd.doc-id
     4489            .
     4490            return yes.
     4491         end.
     4492         else do:
     4493            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4494            if    odb-num eq ?
     4495               or odoc-id eq ?
     4496            then do:
     4497               assign
     4498                  odb-num = utd.db-num
     4499                  odoc-id = utd.doc-id
     4500               .
     4501               return yes.
     4502            end.
     4503            else
     4504               return odoc-id = utd.doc-id.
     4505         end.
     4506      end.
     4507      return ?.
     4508   end.
     4509   function GetLastUTDinPack returns logical
     4510   (input idb-num as integer,
     4511    input idoc-id as integer,
     4512    output odb-num as integer,
     4513    output odoc-id as integer ):
     4514      define buffer buf_utd for utd.
     4515      define buffer     utd for utd.
     4516      find first utd where utd.db-num eq idb-num
     4517                       and utd.doc-id eq idoc-id
     4518      no-lock no-error.
     4519      if available utd
     4520      then do:
     4521         if utd.PackageId eq ""
     4522         then do:
     4523            assign
     4524               odb-num = utd.db-num
     4525               odoc-id = utd.doc-id
     4526            .
     4527            return yes.
     4528         end.
     4529         else do:
     4530            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4531            if    odb-num eq ?
     4532               or odoc-id eq ?
     4533            then do:
     4534               assign
     4535                  odb-num = utd.db-num
     4536                  odoc-id = utd.doc-id
     4537               .
     4538               return yes.
     4539            end.
     4540            else
     4541               return odoc-id = utd.doc-id.
     4542         end.
     4543      end.
     4544      return ?.
     4545   end.
     4546   function delMark returns logical
     4547   ( buffer utd-marking-lines for utd-marking-lines ):
     4548      define buffer buf_utd-marking-line for utd-marking-lines.
     4549      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4550         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4551                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4552                                           and buf_utd-marking-line.mark      eq marking.mark
     4553         no-lock no-error.
     4554         if available  buf_utd-marking-line
     4555         then do:
     4556            delMark(buffer buf_utd-marking-line).
     4557            delete buf_utd-marking-line.
     4558         end.
     4559      end.
     4560   end.
     4561   function addMark returns logical
     4562   ( buffer utd-marking-lines for utd-marking-lines ):
     4563      define buffer buf_utd-marking-line for utd-marking-lines.
     4564      define buffer par_utd-marking-line for utd-marking-lines.
     4565      define buffer buf_utd for ub.utd .
     4566      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4567         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4568                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4569                                           and buf_utd-marking-line.mark      eq marking.mark
     4570         no-lock no-error.
     4571         if available  buf_utd-marking-line
     4572         then do:
     4573            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4574            then do:
     4575               find current  buf_utd-marking-line exclusive-lock no-error.
     4576               if available buf_utd-marking-line
     4577               then
     4578                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4579            end.
     4580         end.
     4581         else do:
     4582            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4583                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4584                                         no-error .
     4585            create buf_utd-marking-line.
     4586            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4587            assign
     4588               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4589               buf_utd-marking-line.mark      = marking.mark
     4590               buf_utd-marking-line.gds-code  = marking.Gds-code
     4591               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4592                                               then marking.sts
     4593                                               else
     4594                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4595                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4596                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4597                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4598                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4599                                                else marking.sts
     4600            .
     4601            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4602            do:
     4603              for first par_utd-marking-line no-lock where
     4604                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4605                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4606                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4607                    and par_utd-marking-line.mark    = marking.mark-parent
     4608                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4609              :
     4610                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4611              end.
     4612            end.
     4613         end.
     4614         addMark(buffer buf_utd-marking-line).
     4615      end.
     4616   end.
     4617   function UnLockUTDMarkbuf returns logical
     4618   (buffer old_utd for utd,
     4619    iAll as logical ):
     4620      define variable voldkey    as character no-undo.
     4621         run gen-key-rec (input "utd",
     4622                          input  buffer old_utd:handle,
     4623                          output voldkey).
     4624      for each marking where marking.loc-key eq voldkey
     4625      exclusive-lock:
     4626         if    iAll
     4627            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4628                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4629         then do:
     4630            marking.loc-key = "".
     4631            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4632         end.
     4633      end.
     4634   end.
     4635   function UnLockUTDMark returns logical
     4636   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4637      define buffer old_utd for utd.
     4638      find first old_utd where old_utd.db-num eq idb-num
     4639                           and old_utd.db-num eq idoc-id
     4640      no-lock no-error.
     4641      if available old_utd
     4642      then do:
     4643         UnLockUTDMarkbuf(buffer old_utd,iall).
     4644      end.
     4645   end.
     4646   function changSts returns logical
     4647   (idb-num as integer ,
     4648    idoc-id as integer ,
     4649    old_sts_edo as character ,
     4650    new_sts_edo as character  ):
     4651      if     old_sts_edo ne new_sts_edo
     4652         and ( new_sts_edo eq "RevocationAccepted"
     4653              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4654              )
     4655      then
     4656         UnLockUTDMark(idb-num,idoc-id,yes).
     4657      if     old_sts_edo ne new_sts_edo
     4658         and ( new_sts_edo eq "WithRecipientSignature"
     4659           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4660              )
     4661      then
     4662         UnLockUTDMark(idb-num,idoc-id,no).
     4663   end.
     4664   function SetLockUTDMark returns logical
     4665   (idb-num as integer ,idoc-id as integer ):
     4666      define buffer new_utd for utd.
     4667      define buffer old_utd for utd.
     4668      define variable volddb-num as integer no-undo.
     4669      define variable volddoc-id as integer no-undo.
     4670      define variable voldkey    as character no-undo.
     4671      define variable vnewkey    as character no-undo.
     4672      find first new_utd where new_utd.db-num eq idb-num
     4673                           and new_utd.doc-id eq idoc-id
     4674      no-lock no-error.
     4675      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4676      then do trans:
     4677         find first old_utd where old_utd.db-num eq volddb-num
     4678                              and old_utd.doc-id eq volddoc-id
     4679         no-lock no-error.
     4680            run gen-key-rec (input "utd",
     4681                             input  buffer new_utd:handle,
     4682                             output vnewkey).
     4683            run gen-key-rec (input "utd",
     4684                             input  buffer old_utd:handle,
     4685                             output voldkey).
     4686         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4687                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4688         no-lock:
     4689            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4690            if available  marking
     4691            then do:
     4692               if    marking.loc-key eq ""
     4693                  or marking.loc-key eq ?
     4694                  or marking.loc-key eq voldkey
     4695               then do:
     4696                  find current marking exclusive-lock no-error.
     4697                  if available marking
     4698                  then do:
     4699                     marking.loc-key = vnewkey.
     4700                     release marking.
     4701                  end.
     4702               end.
     4703               else if marking.loc-key ne vnewkey
     4704               then do:
     4705                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4706               end.
     4707            end.
     4708         end.
     4709         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4710      end.
     4711   end.
     4712   function CheckedocMark return logical
     4713   (input idb-numorig as integer,
     4714    input idoc-idorig as integer,
     4715    input idb-numedoc as integer,
     4716    input idoc-idedoc as integer  ):
     4717       define variable VChekOk    as logical   no-undo init yes.
     4718       define variable vMarkUtd   as logical   no-undo.
     4719       define variable v-par-type as character no-undo.
     4720       define variable v-par-val  as character no-undo.
     4721       define buffer buf_utd-attr      for utd-attr.
     4722       define buffer buf_utd           for utd.
     4723       define buffer utd-marking-lines for utd-marking-lines.
     4724       define buffer utd-lines         for utd-lines.
     4725       define buffer marking           for marking.
     4726       define buffer edoc-lines        for utd-lines.
     4727          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     4728                                       and utd-marking-lines.doc-id    eq idoc-idorig
     4729                                       and utd-marking-lines.doc-level eq 1
     4730                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     4731          no-lock:
     4732             if    isMark (utd-marking-lines.mark)
     4733             then do:
     4734                create tt-utd-mark.
     4735                buffer-copy utd-marking-lines to tt-utd-mark
     4736                assign
     4737                   tt-utd-mark.side = "+"
     4738                .
     4739             end.
     4740          end.
     4741          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     4742                                       and utd-marking-lines.doc-id eq idoc-idedoc
     4743                                       and utd-marking-lines.doc-level eq 1
     4744          no-lock:
     4745             if    isMark (utd-marking-lines.mark)
     4746             then do:
     4747                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4748                no-lock no-error.
     4749                if available tt-utd-mark
     4750                then
     4751                   tt-utd-mark.side = "".
     4752                else do:
     4753                   create tt-utd-mark.
     4754                   buffer-copy utd-marking-lines to tt-utd-mark
     4755                   assign
     4756                      tt-utd-mark.side = "-"
     4757                   .
     4758                end.
     4759             end.
     4760          end.
     4761          for each tt-utd-mark where  tt-utd-mark.side ne ""
     4762          no-lock:
     4763             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     4764             VChekOk = no.
     4765          end.
     4766          for each utd-lines where utd-lines.db-num    eq idb-numorig
     4767                               and utd-lines.doc-id    eq idoc-idorig
     4768          no-lock:
     4769             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     4770                                     and edoc-lines.doc-id eq idoc-idedoc
     4771                                     and edoc-lines.LineNum eq utd-lines.LineNum
     4772             no-lock no-error.
     4773             define variable VUtdlinequentity as decimal no-undo.
     4774             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     4775             if     VUtdlinequentity eq ?
     4776                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     4777             then
     4778                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     4779          end.
     4780       for each tt-utd-mark:
     4781          delete tt-utd-mark.
     4782       end.
     4783   end.
     4784   function CheckEdoc returns character
     4785   (idb-numOrig as integer ,
     4786    idoc-idOrig as integer,
     4787    idb-num as integer ,
     4788    idoc-id as integer ):
     4789      define buffer utd  for ub.utd.
     4790      define buffer utd-lines  for ub.utd-lines.
     4791      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4792      define buffer edoc-lines for ub.utd-lines.
     4793      define variable vSts as integer no-undo.
     4794      define variable vMarkutd as logical no-undo.
     4795      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4796      Block-line:
     4797      for each utd-lines where utd-lines.db-num eq idb-num
     4798                           and utd-lines.doc-id eq idoc-id
     4799      exclusive-lock:
     4800         define variable ismarkin as logical no-undo.
     4801         define variable isOAD as logical no-undo.
     4802         define variable isper as logical no-undo.
     4803         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     4804              output ismarkin, output isOAD, output isper).
     4805         if    utd-lines.Price                eq 0
     4806            or utd-lines.Total                eq 0
     4807            or utd-lines.TotalWithVatExcluded eq 0
     4808            or utd-lines.Quantity             eq 0
     4809         then do:
     4810            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4811                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4812                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4813            no-lock:
     4814               if    isMark(utd-marking-lines.mark)
     4815                  or isOad(utd-marking-lines.mark)
     4816               then do:
     4817                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     4818                  next Block-line.
     4819               end.
     4820            end.
     4821            delete utd-lines.
     4822         end.
     4823         else if   ( utd-lines.Total                ne 0
     4824                 or utd-lines.Quantity             ne 0)
     4825                 and ismarkin or isOAD
     4826         then do:
     4827            Block-mark:
     4828            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4829                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4830                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4831            no-lock:
     4832               if  (isOAD and
     4833                     isMark(utd-marking-lines.mark)
     4834                  or isOad(utd-marking-lines.mark) )
     4835                  or (ismarkin and
     4836                     isMark(utd-marking-lines.mark))
     4837               then do:
     4838                  leave Block-mark.
     4839               end.
     4840            end.
     4841            if not available utd-marking-lines
     4842            then
     4843               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     4844         end.
     4845      end.
     4846      for each utd-lines where utd-lines.db-num eq idb-numOrig
     4847                           and utd-lines.doc-id eq idoc-idOrig
     4848      no-lock:
     4849         find first edoc-lines where edoc-lines.db-num eq idb-num
     4850                                 and edoc-lines.doc-id eq idoc-id
     4851                                 and edoc-lines.LineNum eq utd-lines.LineNum
     4852         no-lock no-error.
     4853         if     available edoc-lines
     4854         then do:
     4855            if edoc-lines.Quantity ne 0
     4856            then do:
     4857               if edoc-lines.Price ne utd-lines.Price
     4858               then
     4859                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     4860            end.
     4861         end.
     4862         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4863         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     4864      end.
     4865      define variable vError as character no-undo.
     4866      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     4867      if vError ne ""
     4868      then
     4869         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     4870      else
     4871         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4872      find first utd where utd.db-num eq idb-num
     4873                       and utd.doc-id eq idoc-id
     4874      exclusive-lock no-error.
     4875      if available utd
     4876      then do:
     4877         utd.sts = vsts.
     4878      end.
     4879   end.
     4880   function CrEdoc returns character
     4881   (iPack as character ,
     4882    iTimestamp as datetime):
     4883      define variable vdb-num as integer no-undo.
     4884      define variable vdoc-id as integer no-undo.
     4885      define buffer utd  for ub.utd.
     4886      define buffer edoc for ub.utd.
     4887      define buffer utd_ret   for ub.utd.
     4888      define buffer utd-attr  for ub.utd-attr.
     4889      define buffer edoc-attr for ub.utd-attr.
     4890      define buffer utd-lines  for ub.utd-lines.
     4891      define buffer edoc-lines for ub.utd-lines.
     4892      define buffer utd-lines-attr  for ub.utd-lines-attr.
     4893      define buffer edoc-lines-attr for ub.utd-lines-attr.
     4894      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4895      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4896      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     4897      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     4898      define variable vTimestamp  as datetime no-undo.
     4899      find last utd where utd.PackageId eq iPack
     4900                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4901                      and utd.Timestamp ge iTimestamp
     4902      no-lock no-error.
     4903      if available utd
     4904      then
     4905         return "Есть документ позже".
     4906      find last utd where utd.PackageId eq iPack
     4907                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4908                      and utd.Timestamp le iTimestamp
     4909      no-lock no-error.
     4910      if not available utd
     4911      then
     4912         return "Не найден УКД".
     4913      define variable vdb-numOrig as integer no-undo.
     4914      define variable vdoc-idOrig as integer no-undo.
     4915      find last utd where utd.PackageId eq iPack
     4916                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4917                      and utd.Timestamp le iTimestamp
     4918      no-lock no-error.
     4919      if available utd
     4920      then do:
     4921         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4922         MySeqUtd = ?.
     4923         vTimestamp = utd.Timestamp.
     4924         create edoc.
     4925         vdb-num = utd.db-num.
     4926         vdoc-id = utd.doc-id.
     4927         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     4928         assign
     4929            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4930            edoc.Timestamp = iTimestamp + 1
     4931            edoc.AmendmentRequested = no
     4932            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     4933         .
     4934         validate edoc.
     4935         for each utd-attr where utd-attr.db-num eq vdb-num
     4936                             and utd-attr.doc-id eq vdoc-id
     4937                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     4938                             and utd-attr.attr-code ne "sendcode"
     4939         no-lock:
     4940            create edoc-attr.
     4941            buffer-copy utd-attr except doc-id db-num to edoc-attr
     4942            assign
     4943               edoc-attr.db-num = edoc.db-num
     4944               edoc-attr.doc-id = edoc.doc-id
     4945            .
     4946         end.
     4947         for each utd-lines where utd-lines.db-num eq vdb-num
     4948                              and utd-lines.doc-id eq vdoc-id
     4949         no-lock:
     4950            create edoc-lines.
     4951            buffer-copy utd-lines except doc-id db-num to edoc-lines
     4952            assign
     4953               edoc-lines.db-num = edoc.db-num
     4954               edoc-lines.doc-id = edoc.doc-id
     4955            .
     4956            release edoc-lines.
     4957         end.
     4958         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     4959                                   and utd-lines-attr.doc-id eq vdoc-id
     4960         no-lock:
     4961            create edoc-lines-attr.
     4962            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     4963            assign
     4964               edoc-lines-attr.db-num = edoc.db-num
     4965               edoc-lines-attr.doc-id = edoc.doc-id
     4966            .
     4967         end.
     4968         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     4969                                      and utd-marking-lines.doc-id eq vdoc-id
     4970                                      and utd-marking-lines.doc-level eq 1
     4971         no-lock:
     4972            create edoc-marking-lines.
     4973            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4974            assign
     4975               edoc-marking-lines.db-num = edoc.db-num
     4976               edoc-marking-lines.doc-id = edoc.doc-id
     4977            .
     4978         end.
     4979         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     4980                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     4981         no-lock:
     4982            if utd-marking-lines-attr.attr-code eq "box-qnty"
     4983            then do:
     4984                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     4985                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     4986                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     4987                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     4988                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     4989                no-lock no-error.
     4990            end.
     4991            if not avail edoc-marking-lines-attr
     4992            then do:
     4993                create edoc-marking-lines-attr.
     4994                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     4995                assign
     4996                   edoc-marking-lines-attr.db-num = vdb-num
     4997                   edoc-marking-lines-attr.doc-id = vdoc-id
     4998                .
     4999            end.
     5000            release edoc-marking-lines-attr.
     5001         end.
     5002         for each utd where utd.PackageId eq iPack
     5003                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     5004                        and utd.Timestamp gt vTimestamp
     5005                        and utd.Timestamp le iTimestamp
     5006                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     5007                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     5008                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     5009                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     5010                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5011                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     5012         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     5013            edoc.Total = edoc.Total + utd.total.
     5014            edoc.Vat = edoc.Vat + utd.Vat.
     5015            edoc.DocumentDate = utd.DocumentDate.
     5016            edoc.Timestamp = utd.Timestamp + 1.
     5017            for each utd-lines where utd-lines.db-num     = utd.db-num
     5018                                 and utd-lines.doc-id     = utd.doc-id
     5019            no-lock:
     5020               block-mark:
     5021               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5022                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5023                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5024                                            and utd-marking-lines.site eq "-"
     5025                                            no-lock:
     5026                  if isOAD(utd-marking-lines.mark)
     5027                  then do:
     5028                     define variable VOAD as character no-undo.
     5029                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5030                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5031                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     5032                                                  and edoc-marking-lines.mark   begins VOAD
     5033                     no-lock no-error.
     5034                  end.
     5035                  else
     5036                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5037                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5038                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5039                        no-lock no-error.
     5040                  if available edoc-marking-lines
     5041                  then do:
     5042                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     5043                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     5044                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     5045                     exclusive-lock no-error.
     5046                     leave block-mark.
     5047                  end.
     5048               end.
     5049               if not available edoc-lines
     5050               then
     5051                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     5052                                          and edoc-lines.doc-id      = edoc.doc-id
     5053                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     5054                  exclusive-lock no-error.
     5055               if not available edoc-lines
     5056               then do:
     5057                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     5058                                         and edoc-lines.doc-id      = edoc.doc-id
     5059                  no-lock no-error.
     5060                  define variable vline as integer no-undo.
     5061                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     5062                  create edoc-lines.
     5063                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     5064                  assign
     5065                     edoc-lines.db-num = edoc.db-num
     5066                     edoc-lines.doc-id = edoc.doc-id
     5067                     edoc-lines.linenum = vline
     5068                  .
     5069               end.
     5070               else
     5071                  assign
     5072                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     5073                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     5074                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     5075                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     5076                  .
     5077               define variable Vqnty as decimal no-undo.
     5078               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     5079                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     5080               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     5081               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     5082                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5083               then
     5084                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5085                      "loadUtd",
     5086                      "UcdUnitChangForUtd",
     5087                      string(edoc-lines.LineNum )                  + chr(4) +
     5088                      edoc-lines.UnitCode                   + chr(4) +
     5089                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5090               if     utd-lines.UnitCode ne ?
     5091                  and utd-lines.UnitCode ne ""
     5092                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5093               then
     5094                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5095                         "loadUtd",
     5096                         "UcdUnitChang",
     5097                         string(edoc-lines.LineNum )                  + chr(4) +
     5098                         utd-lines.UnitCode                          + chr(4) +
     5099                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5100               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5101                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5102                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5103               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     5104                  if utd-marking-lines.site eq "-"
     5105                  then do:
     5106                     if isOAD(utd-marking-lines.mark)
     5107                     then do:
     5108                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5109                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5110                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5111                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5112                        exclusive-lock no-error.
     5113                        if not available edoc-marking-lines
     5114                        then
     5115                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5116                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     5117                                                        and edoc-marking-lines.mark   begins VOAD
     5118                           exclusive-lock no-error.
     5119                        if not available edoc-marking-lines
     5120                        then
     5121                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5122                        else do:
     5123                           define variable v37tegdoc as character no-undo.
     5124                           define variable v37tegedoc as character no-undo.
     5125                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5126                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5127                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     5128                           if error-status:error
     5129                           then
     5130                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5131                              view-as alert-box.
     5132                           else if vqnty = 0
     5133                           then
     5134                              delete edoc-marking-lines.
     5135                           else do:
     5136                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5137                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5138                                             edoc-marking-lines.doc-id,
     5139                                             edoc-marking-lines.LineNum,
     5140                                             edoc-marking-lines.mark,
     5141                                             "box-qnty",
     5142                                              string(vQnty)).
     5143                           end.
     5144                        end.
     5145                     end.
     5146                     else do:
     5147                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5148                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5149                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5150                        exclusive-lock no-error.
     5151                        if available edoc-marking-lines
     5152                        then
     5153                           delete edoc-marking-lines.
     5154                        else
     5155                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5156                     end.
     5157                  end.
     5158                  else if utd-marking-lines.site eq "+"
     5159                  then do:
     5160                     if isOAD(utd-marking-lines.mark)
     5161                     then do:
     5162                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5163                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5164                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5165                                                     and edoc-marking-lines.mark   begins VOAD
     5166                        exclusive-lock no-error.
     5167                        if available edoc-marking-lines
     5168                        then do:
     5169                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5170                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5171                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     5172                           if error-status:error
     5173                           then
     5174                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5175                              view-as alert-box.
     5176                           else if vqnty = 0
     5177                           then
     5178                              delete edoc-marking-lines.
     5179                           else do:
     5180                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5181                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5182                                             edoc-marking-lines.doc-id,
     5183                                             edoc-marking-lines.LineNum,
     5184                                             edoc-marking-lines.mark,
     5185                                             "box-qnty",
     5186                                              string(vQnty)).
     5187                           end.
     5188                        end.
     5189                        else do:
     5190                           create edoc-marking-lines.
     5191                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5192                           assign
     5193                              edoc-marking-lines.db-num = edoc.db-num
     5194                              edoc-marking-lines.doc-id = edoc.doc-id
     5195                           .
     5196                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5197                                             edoc-marking-lines.doc-id,
     5198                                             edoc-marking-lines.LineNum,
     5199                                             edoc-marking-lines.mark,
     5200                                             "box-qnty",
     5201                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     5202                        end.
     5203                     end.
     5204                     else do:
     5205                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5206                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5207                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5208                     no-lock no-error.
     5209                     if not available edoc-marking-lines
     5210                     then do:
     5211                        create edoc-marking-lines.
     5212                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     5213                        assign
     5214                           edoc-marking-lines.db-num  = edoc-lines.db-num
     5215                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     5216                           edoc-marking-lines.linenum = edoc-lines.linenum
     5217                        .
     5218                     end.
     5219                     else
     5220                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5221                  end.
     5222               end.
     5223               release edoc-lines.
     5224            end.
     5225            release edoc-lines.
     5226         end.
     5227         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     5228                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     5229                                 and utd_ret.Timestamp             le utd.Timestamp
     5230                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5231            no-lock no-error.
     5232         if not avail utd_ret
     5233         then
     5234            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5235      end.
     5236      for each utd where utd.PackageId eq iPack
     5237                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5238                        and utd.Timestamp < iTimestamp
     5239         exclusive-lock:
     5240            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5241            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5242         end.
     5243         unsubscribe "getNextseq".
     5244      end.
     5245   end.
     5246   define variable Mext-sys as integer no-undo init ?.
     5247   define variable mdb-num-local as integer no-undo.
     5248   run gbl/getdbnum.p (output mdb-num-local).
     5249   function  getExtSys returns integer
     5250   ():
     5251      define buffer ext-system      for ext-system.
     5252      define buffer ext-system-attr for ext-system-attr.
     5253      Mext-sys = ?.
     5254      block-sys-obj:
     5255      for each ext-system where ext-system.esys-type eq 12
     5256                            and ext-system.db-num    eq mdb-num-local
     5257      no-lock:
     5258          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5259                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5260                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5261          no-lock no-error.
     5262          if     available ext-system-attr
     5263             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5264          then do:
     5265             Mext-sys = ext-system-attr.esys-id.
     5266             leave block-sys-obj.
     5267          end.
     5268      end.
     5269      if Mext-sys eq ?
     5270      then do:
     5271         block-sys-host:
     5272         for each ext-system where ext-system.esys-type eq 12
     5273                               and ext-system.db-num    eq mdb-num-local
     5274         no-lock:
     5275             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5276                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5277                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5278             no-lock no-error.
     5279             if     available ext-system-attr
     5280                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5281             then do:
     5282                Mext-sys = ext-system-attr.esys-id.
     5283                leave block-sys-host.
     5284             end.
     5285         end.
     5286      end.
     5287      return Mext-sys.
     5288   end.
     5289   function  getExtAttr returns character
     5290   (input icode as character ):
     5291      define variable oValue as character no-undo.
     5292      define variable vtype as character no-undo.
     5293      define buffer ext-system for ext-system.
     5294      get-key-value section "ProxyServ" key icode value oValue.
     5295      if oValue eq ?
     5296      then do:
     5297         if Mext-sys eq ?
     5298         then
     5299            getExtSys ().
     5300         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5301                                         and ext-system.esys-id eq Mext-sys no-error.
     5302         if available ext-system
     5303         then do:
     5304                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5305            (ext-system.esys-id,
     5306             mdb-num-local,
     5307             icode,
     5308             output oValue,
     5309             output vtype) no-error.
     5310          end.
     5311      end.
     5312      return if oValue eq ? then "" else oValue .
     5313   end.
     5314   function  SetExtAttr returns character
     5315   (input icode   as character,
     5316    input iValue  as character):
     5317      define variable vtype as character no-undo.
     5318      define buffer ext-system for ext-system.
     5319      if Mext-sys eq ?
     5320      then
     5321         getExtSys ().
     5322      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5323                                      and ext-system.esys-id eq Mext-sys no-error.
     5324      if available ext-system
     5325      then do:
     5326          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5327         (ext-system.esys-id,
     5328          mdb-num-local,
     5329          icode,
     5330          iValue) no-error.
     5331       end.
     5332   end.
     5333   define stream File-stream.
     5334   function PutMes returns character
     5335   (idext as character ):
     5336      if valid-handle(mPublishHand)
     5337      then
     5338         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5339      else do:
     5340         if idext begins "error"
     5341         then do:
     5342            message substring (idext,6)
     5343               view-as alert-box.
     5344            if mDiadocApi ne ?
     5345            then
     5346               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5347         end.
     5348         output stream File-stream to "diadoc_user.log" append.
     5349         put stream File-stream unformatted now " " idext skip.
     5350         output stream File-stream close.
     5351      end.
     5352   end.
     5353   function PutErr returns character
     5354   (idext as character ):
     5355      define variable vi as integer no-undo.
     5356      define variable vnumerr as integer no-undo.
     5357      define variable vtext as character extent 25 no-undo .
     5358      if error-status:num-messages > 0 then do:
     5359         vnumerr = error-status:num-messages.
     5360         vnumerr = min(vnumerr,extent(vtext)).
     5361         do vi = 1 to vnumerr:
     5362            vtext[vi] = error-status:get-message(vi).
     5363         end.
     5364         idext = idext + chr(10) + "Ошибка: [":U.
     5365         do vi = 1 to vnumerr:
     5366            idext = idext + chr(10) + vtext[vi] no-error.
     5367         end.
     5368         idext = idext +  chr(10) +  " ]" no-error.
     5369         if not  idext begins "Error"
     5370         then
     5371            idext = "Error " + idext.
     5372         PutMes(idext).
     5373      end.
     5374   end.
     5375   function PutStat returns character
     5376   (itext as character,
     5377    iflag as logical):
     5378      if valid-handle(mPublishHand)
     5379      then
     5380         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5381      PutMes(itext).
     5382   end.
     5383   function chekStop returns logical
     5384   ( ):
     5385      define variable oStop as logical no-undo.
     5386      if valid-handle(mPublishHand)
     5387      then
     5388         publish "StopProc" from mPublishHand (output oStop).
     5389      return oStop.
     5390   end.
     5391   function  putloggetdesc returns logical
     5392   (is1 as character ,is2 as character ,
     5393   is3 as character ):
     5394   end.
     5395   function  getdesc returns logical
     5396   (input iObj as component-handle):
     5397      if iObj eq ? then return false.
     5398      if mdebug
     5399      then do:
     5400      output stream File-stream to "diadoc_load.txt" append.
     5401      define variable vReflector as component-handle no-undo.
     5402      define variable vDescobj  as component-handle no-undo.
     5403      define variable vPropertyNames  as component-handle no-undo.
     5404      define variable vMethodsNames as component-handle no-undo.
     5405      define variable vMethodDesc as component-handle no-undo.
     5406      define variable vMethodsName as character  no-undo.
     5407      define variable vPropertyValue as char no-undo.
     5408      create "Diadoc.Reflector" vReflector.
     5409      vDescobj = vReflector:Describe(iObj).
     5410     put   stream File-stream  unformatted skip (1)
     5411      "------------------------------------------" skip
     5412      vDescobj:GetInterfaceName() skip.
     5413      define variable vPropertyName as character no-undo.
     5414      define variable vPropertyType as character no-undo.
     5415      .
     5416      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5417      putloggetdesc("property","","").
     5418      define variable vi as integer no-undo.
     5419      define variable vii as integer no-undo.
     5420     put stream File-stream  unformatted skip "property" skip.
     5421     vPropertyNames = vDescobj:GetPropertiesNames().
     5422      vi= vPropertyNames:count.
     5423      do vi= 1 to vPropertyNames:count :
     5424         vPropertyName = "".
     5425         vPropertyType = "".
     5426         vPropertyValue = "".
     5427         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5428         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5429         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5430         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5431        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5432      end.
     5433      release object vPropertyNames.
     5434      put stream File-stream  unformatted skip "method" skip.
     5435      vMethodsNames = vDescobj:GetMethodsNames().
     5436      vi = vMethodsNames:count.
     5437      do vi = 1 to vMethodsNames:count :
     5438         vMethodsName = "".
     5439         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5440         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5441         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5442         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5443         do vii  = 1 to vMethodDesc:args:count:
     5444            define variable varg as character no-undo.
     5445            varg = "".
     5446            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5447            put stream File-stream  unformatted " args " varg  skip .
     5448            putloggetdesc(" args ",varg, "").
     5449         end.
     5450         release object vMethodDesc.
     5451      end.
     5452      release object vMethodsNames.
     5453      put stream File-stream  unformatted "end---------------------------------------" skip.
     5454      output stream File-stream close.
     5455      release object vDescobj.
     5456      release object vReflector.
     5457      end.
     5458      return true.
     5459   end.
     5460   function getxsddocum returns logical
     5461   (iOrganization as component-handle):
     5462      if iOrganization eq ? then return false.
     5463      define variable vDocumentTypes as component-handle no-undo.
     5464      define variable vDocumentType as component-handle no-undo.
     5465      define variable vFunctions as component-handle no-undo.
     5466      define variable vFunction as component-handle no-undo.
     5467      define variable vVersions as component-handle no-undo.
     5468      define variable vVersion as component-handle no-undo.
     5469      define variable vTitles as component-handle no-undo.
     5470      define variable vTitle as component-handle no-undo.
     5471      define variable vi as integer no-undo.
     5472      define variable vii as integer no-undo.
     5473      define variable viii as integer no-undo.
     5474      define variable viiii as integer no-undo.
     5475      if mdebug
     5476      then do:
     5477      output stream File-stream to "diadoc_doc.txt" append.
     5478      vDocumentTypes = iOrganization:GetDocumentTypes().
     5479      do vi =1 to vDocumentTypes:count:
     5480         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5481         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5482         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5483         vFunctions = vDocumentType:Functions.
     5484         do vii =1 to vFunctions:count:
     5485            vFunction = vFunctions:GetItem(vii - 1 ).
     5486            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     5487            vVersions = vFunction:Versions.
     5488            do viii =1 to vVersions:count:
     5489               vVersion = vVersions:GetItem(viii - 1 ).
     5490               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     5491               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     5492               vTitles  = vVersion:Titles.
     5493               do viiii =1 to vTitles:count:
     5494                  vTitle = vTitles:GetItem(viiii - 1 ).
     5495                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     5496                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     5497                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     5498                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     5499                  release object vTitle.
     5500               end.
     5501              release object vTitles.
     5502               release object vVersion.
     5503            end.
     5504            release object vVersions.
     5505            release object vFunction.
     5506         end.
     5507         release object vFunctions.
     5508         release object vDocumentType.
     5509      end.
     5510      release object vDocumentTypes.
     5511      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     5512     output stream File-stream close.
     5513     end.
     5514      return true.
     5515   end.
     5516   function GetDocTitleType returns character
     5517   (iOrganizationGuid as character ,
     5518   itype as character ,
     5519   ifunction as character,
     5520   iversion as character
     5521   ):
     5522      if iOrganizationGuid eq ? then return "".
     5523      define variable vOrganization  as component-handle no-undo.
     5524      define variable vDocumentTypes as component-handle no-undo.
     5525      define variable vDocumentType  as component-handle no-undo.
     5526      define variable vFunctions     as component-handle no-undo.
     5527      define variable vFunction      as component-handle no-undo.
     5528      define variable vVersions      as component-handle no-undo.
     5529      define variable vVersion       as component-handle no-undo.
     5530      define variable vTitles        as component-handle no-undo.
     5531      define variable vTitle         as component-handle no-undo.
     5532      define variable vi             as integer no-undo.
     5533      define variable vii            as integer no-undo.
     5534      define variable viii           as integer no-undo.
     5535      define variable viiii          as integer no-undo.
     5536      define variable oTitleType as character no-undo.
     5537      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     5538      if vOrganization eq ? then return "".
     5539      vDocumentTypes = vOrganization:GetDocumentTypes().
     5540      do vi =1 to vDocumentTypes:count:
     5541         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5542         if vDocumentType:name eq iType
     5543         then do:
     5544            vFunctions = vDocumentType:Functions.
     5545            do vii =1 to vFunctions:count:
     5546               vFunction = vFunctions:GetItem(vii - 1 ).
     5547               if vFunction:name eq ifunction
     5548               then do:
     5549                  vVersions = vFunction:Versions.
     5550                  do viii =1 to vVersions:count:
     5551                     vVersion = vVersions:GetItem(viii - 1 ).
     5552                     if vVersion:version eq iversion
     5553                     then do:
     5554                        vTitles  = vVersion:Titles.
     5555                        do viiii =1 to vTitles:count:
     5556                           vTitle = vTitles:GetItem(viiii - 1 ).
     5557                           oTitleType = oTitleType + "," + vTitle:type.
     5558                           release object vTitle.
     5559                        end.
     5560                        release object vTitles.
     5561                     end.
     5562                     release object vVersion.
     5563                  end.
     5564                  release object vVersions.
     5565               end.
     5566               release object vFunction.
     5567            end.
     5568            release object vFunctions.
     5569         end.
     5570         release object vDocumentType.
     5571      end.
     5572      release object vDocumentTypes.
     5573      release object vOrganization.
     5574      return left-trim(oTitleType,",").
     5575   end.
     5576   define temp-table tt-type no-undo
     5577             field id as char
     5578             field name as character
     5579             index pi id .
     5580   define temp-table tt-Class no-undo like tt-type.
     5581   function crcode returns character
     5582   ():
     5583      define variable vtypelist as character no-undo.
     5584      define variable vtypename as character no-undo.
     5585      define variable vi as integer no-undo.
     5586      vtypelist =
     5587                 "UniversalTransferDocument|"
     5588                + "UniversalTransferDocumentRevision|"
     5589                + "UniversalCorrectionDocument|"
     5590                + "UniversalCorrectionDocumentRevision"
     5591                .
     5592      vtypename =
     5593                 "УПД|"
     5594                + "Исправление УПД|"
     5595                + "УКД|"
     5596                + "Исправление УКД"
     5597                .
     5598      do vi = 1 to num-entries(vtypelist,"|"):
     5599         create tt-type.
     5600         assign
     5601            tt-type.id   =  entry(vi,vtypelist,"|")
     5602            tt-type.name =  entry(vi,vtypename,"|")
     5603         .
     5604      end.
     5605      vtypelist = "Inbound|"
     5606                + "Outbound|"
     5607                + "Proxy".
     5608      vtypename = "входящий документ|"
     5609                + "исходящий документ|"
     5610                + "документ, переданный через промежуточного получателя|".
     5611      do vi = 1 to num-entries(vtypelist,"|"):
     5612         create tt-Class.
     5613         assign
     5614            tt-Class.id   =  entry(vi,vtypelist,"|")
     5615            tt-Class.name =  entry(vi,vtypename,"|")
     5616         .
     5617      end.
     5618   end.
     5619   crcode().
     5620   function getOrganizationInfo returns character
     5621   (input iContAgent as component-handle,
     5622                                                   output oinn as character,
     5623                                                   output oKpp as character,
     5624                                                   output oFnsParticipantId as character,
     5625                                                   output oOrgName as character,
     5626                                                   output oAdditionalInfo as character,
     5627                                                   output OarddrRus as character
     5628                                                    ):
     5629      define variable vi as integer no-undo.
     5630      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     5631      define variable vAddrRus                        as component-handle no-undo.
     5632      if iContAgent ne ?
     5633      then do:
     5634         getdesc(iContAgent).
     5635         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     5636         oinn = vContAgentOrganizationDetails:Inn.
     5637         oKpp = vContAgentOrganizationDetails:Kpp.
     5638         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     5639         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     5640         getdesc(vContAgentOrganizationDetails).
     5641         oOrgName = vContAgentOrganizationDetails:OrgName.
     5642         getdesc(vContAgentOrganizationDetails:Address).
     5643         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     5644         getdesc(vAddrRus ).
     5645         if vAddrRus ne ?
     5646         then do:
     5647            if vAddrRus:ZipCode ne ""
     5648            then
     5649               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     5650            if vAddrRus:Region ne ""
     5651            then
     5652               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     5653            if vAddrRus:Territory ne ""
     5654            then
     5655               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     5656            if vAddrRus:City ne ""
     5657            then
     5658               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     5659            if vAddrRus:Locality ne ""
     5660            then
     5661               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     5662            if vAddrRus:Street ne ""
     5663            then
     5664               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     5665            if vAddrRus:Block ne ""
     5666            then
     5667               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     5668            if vAddrRus:Building ne ""
     5669            then
     5670               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     5671            if vAddrRus:Apartment ne ""
     5672            then
     5673               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     5674         end.
     5675         release object vAddrRus.
     5676         release object vContAgentOrganizationDetails.
     5677      end.
     5678   end.
     5679   function ConectByCertif return component-handle
     5680   (iThumbprint as character ):
     5681     if mDiadocApi eq ? then return ?.
     5682     if iThumbprint eq ""
     5683     then do:
     5684        release object mDiadocConnection no-error.
     5685        return ?.
     5686     end.
     5687      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     5688      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     5689      define variable vSSl as character no-undo.
     5690      vSSl =  getextAttr('diadoc-ssl':U).
     5691      if vSSl ne ""
     5692         and logical(vSSl)
     5693      then
     5694         mDiadocApi:VerifySslCertificate = no.
     5695      if mDiadocApi:ApiClientId eq ""
     5696         or  mDiadocApi:ServerUrl eq ""
     5697      then do:
     5698        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     5699        view-as alert-box.
     5700        release object mDiadocConnection no-error.
     5701        return ?.
     5702     end.
     5703     define variable VProxy as character no-undo.
     5704      vProxy =  getextAttr('proxy-addr':U).
     5705      if     vProxy ne ""
     5706         and vProxy ne ?
     5707      then do:
     5708         mDiadocApi:ProxyMode =  "UseProxy".
     5709         mDiadocApi:ProxySettings:Url = vProxy.
     5710         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5711         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5712      end.
     5713      define variable vtest as component-handle no-undo.
     5714      vtest = mDiadocApi:TestConnection2().
     5715      if not vtest:ConnectionSuccess
     5716      then do:
     5717         PutMes(vtest:ErrorText).
     5718      end.
     5719      else
     5720         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     5721      if mDiadocConnection eq ?
     5722      then
     5723         PutErr("DiadocApi:CreateConnectionByCertificate:").
     5724      release object vtest.
     5725      return mDiadocConnection.
     5726   end.
     5727   function ConectByLogin return component-handle
     5728   ():
     5729      define variable vSSl as character no-undo.
     5730      if mDiadocApi eq ? then return ?.
     5731      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     5732      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     5733      if mDiadocApi:ApiClientId eq ""
     5734         or  mDiadocApi:ServerUrl eq ""
     5735      then do:
     5736        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     5737        release object mDiadocConnection no-error.
     5738        return ?.
     5739     end.
     5740     vSSl =  getextAttr('diadoc-ssl':U).
     5741     if vSSl ne ""
     5742        and logical(vSSl)
     5743     then
     5744         mDiadocApi:VerifySslCertificate = no.
     5745     define variable VProxy as character no-undo.
     5746      vProxy =  getextAttr('proxy-addr':U).
     5747      if     vProxy ne ""
     5748         and vProxy ne ?
     5749      then do:
     5750         mDiadocApi:ProxyMode =  "UseProxy".
     5751         mDiadocApi:ProxySettings:Url = vProxy.
     5752         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5753         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5754      end.
     5755      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     5756      define variable vi as integer no-undo.
     5757      if mDiadocConnection eq ?
     5758      then
     5759         PutErr("DiadocAPI:CreateConnectionByLogin").
     5760      return mDiadocConnection.
     5761   end.
     5762   function GetDocumforid returns character
     5763   (input  iorg as character ,
     5764    input  idoc-id as character ,
     5765    output oDocument      as component-handle
     5766     ):
     5767      define variable vOrganization  as component-handle no-undo.
     5768      define variable vDocument      as component-handle no-undo.
     5769      define buffer utd           for ub.utd.
     5770      if
     5771             iorg  ne ?
     5772         and iorg  ne ""
     5773         and idoc-id ne ?
     5774         and idoc-id ne ""
     5775      then do:
     5776         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     5777         if vOrganization ne ?
     5778         then do:
     5779            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     5780            if oDocument eq ?
     5781            then
     5782               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     5783         end.
     5784         else do:
     5785            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     5786            return "Нет доступа к организации " + iorg.
     5787         end.
     5788      end.
     5789      else
     5790         return "Нет доступа к организации не ЭДО".
     5791      release object vOrganization no-error.
     5792      return "".
     5793   end.
     5794   function GetDocum returns character
     5795   (input  idb-num as integer,
     5796    input  idoc-id as integer,
     5797    output oDocument      as component-handle
     5798     ):
     5799      define variable vOrganization  as component-handle no-undo.
     5800      define variable vDocument      as component-handle no-undo.
     5801      define buffer utd           for ub.utd.
     5802      find first utd where utd.db-num eq idb-num
     5803                       and utd.doc-id eq idoc-id
     5804      no-lock no-error.
     5805      if     available utd
     5806         and utd.OrganizationExt ne ?
     5807         and utd.OrganizationExt ne ""
     5808         and utd.DocumentExt ne ?
     5809         and utd.DocumentExt ne ""
     5810      then do:
     5811         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     5812         if vOrganization ne ?
     5813         then do:
     5814            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     5815            if oDocument eq ?
     5816            then
     5817               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     5818            release object vOrganization no-error.
     5819         end.
     5820         else do:
     5821            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     5822            return "Нет доступа к организации " + utd.OrganizationExt.
     5823         end.
     5824      end.
     5825      else
     5826         return "Нет доступа к организации не ЭДО".
     5827      return "".
     5828   end.
     5829   function GetFirstUTDinPack returns logical
     5830   (input idb-num as integer,
     5831    input idoc-id as integer,
     5832    output odb-num as integer,
     5833    output odoc-id as integer ):
     5834      define buffer buf_utd for utd.
     5835      define buffer     utd for utd.
     5836      find first utd where utd.db-num eq idb-num
     5837                       and utd.doc-id eq idoc-id
     5838      no-lock no-error.
     5839      if available utd
     5840      then do:
     5841         if utd.PackageId eq ""
     5842         then do:
     5843            assign
     5844               odb-num = utd.db-num
     5845               odoc-id = utd.doc-id
     5846            .
     5847            return yes.
     5848         end.
     5849         else do:
     5850            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     5851                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5852            no-lock.
     5853            assign
     5854               odb-num = buf_utd.db-num
     5855               odoc-id = buf_utd.doc-id
     5856            .
     5857            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     5858         end.
     5859      end.
     5860      return ?.
     5861   end.
     5862   function AddOADLine returns integer
     5863   (iDb-num  as integer ,
     5864    iDoc-id  as integer ,
     5865    ilinenum as integer ,
     5866    iGtin    as char,
     5867    iQnty    as int,
     5868    isite    as character ):
     5869       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5870       define variable vnewMark as character no-undo.
     5871       define variable vQnty    as integer   no-undo.
     5872       vnewMark = "02" + iGtin + "37" + string(iQnty).
     5873       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     5874                                      and utd-marking-lines.db-num     = idb-num
     5875                                      and utd-marking-lines.doc-id     = idoc-id
     5876                                      and utd-marking-lines.Linenum    = iLinenum
     5877       exclusive-lock no-error.
     5878       if available utd-marking-lines
     5879       then do:
     5880          delete utd-marking-lines.
     5881          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     5882       end.
     5883       else do:
     5884          create utd-marking-lines.
     5885          assign
     5886             utd-marking-lines.mark      = vnewMark
     5887             utd-marking-lines.db-num    = idb-num
     5888             utd-marking-lines.doc-id    = idoc-id
     5889             utd-marking-lines.Linenum   = iLinenum
     5890             utd-marking-lines.site      = isite
     5891             utd-marking-lines.doc-level = 1
     5892             utd-marking-lines.gds-code  = ?
     5893          .
     5894          vQnty = iQnty.
     5895       end.
     5896       return vQnty.
     5897    end.
     5898   function addMarkforUtd returns recid
     5899   (iDb-num  as integer ,
     5900    iDoc-id  as integer ,
     5901    ilinenum as integer ,
     5902    iMark as character  ,
     5903    isite   as character,
     5904    iUtdType as character    ):
     5905       define buffer     marking            for ub.marking.
     5906       define buffer     marking-attr       for ub.marking-attr.
     5907       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5908       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5909       define variable vMRC  as decimal no-undo.
     5910       define variable vQnty as decimal no-undo.
     5911      define variable vRec as recid no-undo.
     5912      if     imark ne "-"
     5913         and imark ne ""
     5914         and imark ne ?
     5915      then do:
     5916         imark = repTegforDm(imark).
     5917         vQnty = getQntyUTDByCodId(imark) .
     5918         find first utd-marking-lines where utd-marking-lines.mark       = imark
     5919                                        and utd-marking-lines.db-num     = idb-num
     5920                                        and utd-marking-lines.doc-id     = idoc-id
     5921                                        and utd-marking-lines.Linenum    = iLinenum
     5922         exclusive-lock no-error.
     5923         if not available utd-marking-lines
     5924         then do:
     5925            create utd-marking-lines.
     5926            assign
     5927               utd-marking-lines.mark      = imark
     5928               utd-marking-lines.db-num    = idb-num
     5929               utd-marking-lines.doc-id    = idoc-id
     5930               utd-marking-lines.Linenum   = iLinenum
     5931               utd-marking-lines.site      = isite
     5932               utd-marking-lines.doc-level = 1
     5933               utd-marking-lines.gds-code  = ?
     5934            .
     5935            create utd-marking-lines-attr.
     5936            assign
     5937               utd-marking-lines-attr.mark      = imark
     5938               utd-marking-lines-attr.db-num    = idb-num
     5939               utd-marking-lines-attr.doc-id    = idoc-id
     5940               utd-marking-lines-attr.Linenum   = iLinenum
     5941               utd-marking-lines-attr.attr-code = "box-qnty"
     5942               utd-marking-lines-attr.attr-value = string(vQnty)
     5943            .
     5944            vRec = recid(utd-marking-lines).
     5945            release utd-marking-lines-attr.
     5946            release utd-marking-lines.
     5947         end.
     5948         else do:
     5949            if    (    isite eq "-"
     5950               and utd-marking-lines.site eq "+")
     5951            or (    isite eq "+"
     5952               and utd-marking-lines.site eq "-")
     5953            then
     5954               delete utd-marking-lines.
     5955            else if isOAD (imark)
     5956            then do:
     5957               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     5958               create utd-marking-lines-attr.
     5959               assign
     5960                  utd-marking-lines-attr.mark      = imark
     5961                  utd-marking-lines-attr.db-num    = idb-num
     5962                  utd-marking-lines-attr.doc-id    = idoc-id
     5963                  utd-marking-lines-attr.Linenum   = iLinenum
     5964                  utd-marking-lines-attr.attr-code = "box-qnty"
     5965                  utd-marking-lines-attr.attr-value = string(vQnty)
     5966               .
     5967            end.
     5968            vRec = recid(utd-marking-lines).
     5969            release utd-marking-lines.
     5970         end.
     5971         if isMark (imark)
     5972         then do:
     5973            find first marking where marking.mark eq iMark exclusive-lock no-error.
     5974            if not available marking
     5975            then do:
     5976               create marking.
     5977               marking.mark = iMark.
     5978               marking.gds-code = ?.
     5979               marking.unit     = getLevelUTDByCodId(marking.mark) .
     5980            end.
     5981            assign
     5982              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     5983                                      getLevelMotpByCodId(marking.mark)
     5984                                   else marking.unit-ext
     5985              marking.box-qnty   = vQnty
     5986              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     5987            .
     5988            if        (     iUtdType eq "UniversalTransferDocument"
     5989                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     5990            then
     5991               marking.sts = ?.
     5992         end.
     5993      end.
     5994      return vRec.
     5995   end.
     5996   function isSaleMarkInUpak returns logical
     5997   (iMark    as char ):
     5998      define buffer buf_marking       for ub.marking.
     5999      for each buf_marking no-lock where
     6000               buf_marking.mark-parent = iMark
     6001      :
     6002        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     6003           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     6004          return true.
     6005        if isSaleMarkInUpak(buf_marking.mark) then
     6006          return true.
     6007      end.
     6008      return false.
     6009    end.
     6010   function setStatusUpak returns logical
     6011   (iDbNum   as integer ,
     6012    iDocId   as integer ,
     6013    iLineNum as integer ,
     6014    iMark    as char ,
     6015    iSts     as integer):
     6016      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6017      define buffer buf_marking           for ub.marking.
     6018      for each buf_marking exclusive-lock where
     6019               buf_marking.mark-parent = iMark,
     6020         first buf_utd-marking-lines exclusive-lock where
     6021               buf_utd-marking-lines.doc-id  = iDocId
     6022           and buf_utd-marking-lines.db-num  = iDbNum
     6023           and buf_utd-marking-lines.lineNum = iLineNum
     6024           and buf_utd-marking-lines.mark = buf_marking.mark
     6025      :
     6026        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     6027      end.
     6028      for first buf_utd-marking-lines exclusive-lock where
     6029                buf_utd-marking-lines.doc-id  = iDocId
     6030            and buf_utd-marking-lines.db-num  = iDbNum
     6031            and buf_utd-marking-lines.lineNum = iLineNum
     6032            and buf_utd-marking-lines.mark = iMark,
     6033          first buf_marking exclusive-lock where
     6034                buf_marking.mark = buf_utd-marking-lines.mark
     6035      :
     6036        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     6037        then do:
     6038          assign
     6039            buf_utd-marking-lines.sts = iSts
     6040            buf_marking.sts           = iSts
     6041          .
     6042        end.
     6043      end.
     6044      return true.
     6045   end.
     6046   define temp-table tt-recid no-undo
     6047             field orgid as char
     6048             field docid as char
     6049             field parent as char
     6050             field stamp as datetime
     6051             index pi orgid docid
     6052             index parent parent  stamp.
     6053   function ProcessSystemMessStart return component-handle
     6054   (IStartStop as logical):
     6055      if mDiadocConnection eq ? then
     6056      define variable vOrganizationList as component-handle no-undo.
     6057      define variable vOrganization as component-handle no-undo.
     6058      define variable vReceiptGenerationProcess as component-handle no-undo.
     6059      define variable vi as integer no-undo.
     6060      if mDiadocConnection ne ?
     6061      then do:
     6062         vOrganizationList = mDiadocConnection:GetOrganizationList().
     6063          do vi = 1 to vOrganizationList:count:
     6064             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6065             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     6066             release object vOrganization.
     6067             if IStartStop
     6068             then
     6069                vReceiptGenerationProcess:Start().
     6070             else
     6071                vReceiptGenerationProcess:Stop().
     6072             release object vReceiptGenerationProcess.
     6073          end.
     6074          release object vOrganizationList.
     6075      end.
     6076   end.
     6077   procedure  changeIdToGuid :
     6078   define input  parameter iOrganization as component-handle no-undo.
     6079      define variable vOrgId   as character no-undo.
     6080      define variable vOrgGuid as character no-undo.
     6081      define buffer utd for utd.
     6082      assign
     6083         vOrgId   = iOrganization:id.
     6084         vOrgGuid = iOrganization:guid
     6085      no-error.
     6086      if     error-status:num-messages eq 0
     6087         and vOrgId   ne ""
     6088         and vOrgGuid ne ""
     6089      then do:
     6090         define variable vfirst as logical no-undo init yes.
     6091         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     6092            find next utd.
     6093            if vfirst
     6094            then do:
     6095               PutMes("Конвертация документов").
     6096               vfirst = no.
     6097            end.
     6098            utd.OrganizationExt = vOrgGuid.
     6099            validate utd.
     6100            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     6101         end.
     6102         if not vfirst
     6103         then
     6104            PutMes("Конвертация документов завершина.").
     6105      end.
     6106   end.
     6107   procedure getNewUpd :
     6108      define variable VLastDate as date no-undo init ?.
     6109      define variable vDocument     as component-handle no-undo.
     6110      define variable vYear         as integer no-undo.
     6111      define variable vMonth        as integer no-undo.
     6112      define variable vDay          as integer no-undo.
     6113      define variable vBegLoadDate  as date    no-undo.
     6114      define variable vLastLoadDate as date    no-undo.
     6115      define buffer utd for utd.
     6116      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     6117      find first sys-ctrl no-lock.
     6118      if VLastDate eq ?
     6119      then
     6120         VLastDate = sys-ctrl.cut-date + 3.
     6121      else if sys-ctrl.cut-date ne ?
     6122      then
     6123         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     6124      vLastLoadDate = VLastDate.
     6125      for each tt-recid:
     6126         delete tt-recid.
     6127      end.
     6128      if chekStop() then return "Остановка пользователем".
     6129       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     6130      if chekStop() then return "Остановка пользователем".
     6131      if VLastDate ne ?
     6132      then do:
     6133         setextAttr('diadoc-lastload':U,string(VLastDate)).
     6134         vYear = year(vLastLoadDate).
     6135         vMonth = month(vLastLoadDate) - 2.
     6136         vDay   = day(vLastLoadDate).
     6137         if vMonth <= 0 then
     6138            assign
     6139               vMonth = vMonth + 12
     6140               vYear  = vYear - 1
     6141               .
     6142         repeat:
     6143            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     6144            if error-status:error then
     6145               vDay = vDay - 1.
     6146            else
     6147               leave.
     6148         end.
     6149         vBegLoadDate = vBegLoadDate + 1.
     6150      end.
     6151      block-rec:
     6152      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     6153         if  tt-recid.parent eq ""
     6154         then next  block-rec.
     6155         if first-of (tt-recid.parent)
     6156         then do:
     6157            for each utd where utd.PackageId eq tt-recid.parent
     6158            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     6159               if chekStop() then return "Остановка пользователем".
     6160               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6161               then do:
     6162                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6163                  MySeqUtd = ?.
     6164                  CrEdoc(utd.PackageId,utd.Timestamp).
     6165                  unsubscribe "getNextseq".
     6166                  next block-rec.
     6167               end.
     6168            end.
     6169         end.
     6170      end.
     6171      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     6172                                                                                        string(vBegLoadDate)
     6173                                                                                     else "?")
     6174                                                                                     + " по " +
     6175                                                                                     (if vLastLoadDate <> ? then
     6176                                                                                         string(vLastLoadDate)
     6177                                                                                      else
     6178                                                                                         "?")
     6179                                                                                      ).
     6180      define variable vobj as character no-undo.
     6181      vobj = getExtAttr('host-code':U).
     6182      if vobj ne "0"
     6183      then
     6184          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6185                         and utd.host-code eq int(vobj)
     6186                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6187                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6188                              )
     6189          no-lock break by utd.OrganizationExt:
     6190             if chekStop() then return "Остановка пользователем".
     6191             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6192             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6193                                   and tt-recid.docid = utd.DocumentExt
     6194                    no-error.
     6195             if     not available tt-recid
     6196                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6197             then do:
     6198                 run  UpdateUTDInformOne(vDocument).
     6199                release object vDocument no-error.
     6200             end.
     6201          end.
     6202      vobj = getExtAttr('obj':U).
     6203      if vobj ne ""
     6204      then
     6205          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6206                         and utd.obj-type + string(utd.obj-code) eq vobj
     6207          no-lock break by utd.OrganizationExt:
     6208             if chekStop() then return "Остановка пользователем".
     6209             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6210             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6211                                   and tt-recid.docid = utd.DocumentExt
     6212                    no-error.
     6213             if     not available tt-recid
     6214                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6215             then do:
     6216                 run  UpdateUTDInformOne(vDocument).
     6217                release object vDocument no-error.
     6218             end.
     6219          end.
     6220   end.
     6221   procedure  SendAuto:
     6222    define variable vOrganization as component-handle no-undo.
     6223    define variable vOrganizationList as component-handle no-undo.
     6224    define variable vi as integer no-undo.
     6225      if mDiadocConnection eq ?
     6226      then do:
     6227         message "По данному сертификату не удалось подключиться к Диадок"
     6228         view-as alert-box.
     6229      end.
     6230      else do:
     6231         for each tt-recid:
     6232            delete tt-recid.
     6233         end.
     6234         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6235         if vOrganizationList eq ? then return error ?.
     6236         vi = vOrganizationList:Count()no-error.
     6237         if vi eq ?
     6238         then
     6239            return error ?.
     6240         do vi = 1 to vOrganizationList:Count() :
     6241            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6242            define variable vorgid as character no-undo.
     6243            vorgid = vOrganization:guid.
     6244            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6245                           and utd.host-code eq v-cntxt-host-code-obj
     6246                           and utd.OrganizationExt eq vorgid
     6247            no-lock:
     6248                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6249            end.
     6250            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6251                           and utd.host-code eq v-cntxt-host-code-obj
     6252                           and utd.OrganizationExt eq vorgid
     6253            no-lock:
     6254                run  updOneUTD(utd.db-num,utd.doc-id).
     6255            end.
     6256         end.
     6257      end.
     6258   end.
     6259   procedure SendAccept:
     6260      define input  parameter iTypeAccept     as character no-undo.
     6261      define input  parameter iReplyTask      as component-handle no-undo.
     6262      define input  parameter iOrganizationGuid as character no-undo.
     6263      define input  parameter iWorkflowId     as integer no-undo.
     6264      define input  parameter iTitleTypes    as character  no-undo.
     6265      define output parameter oOperationCode as character no-undo.
     6266      define variable vContentItems as component-handle no-undo.
     6267      define variable vContentItem  as component-handle no-undo.
     6268      define variable vSigner       as component-handle no-undo.
     6269      define variable vBuyerTitle   as component-handle no-undo.
     6270      define variable vEmployee     as component-handle no-undo.
     6271      define variable vContentOperCode as component-handle no-undo.
     6272      define variable vOrganization   as component-handle no-undo.
     6273      define variable vUserperm   as component-handle no-undo.
     6274      define variable vi as integer no-undo.
     6275     define variable vdate as date no-undo.
     6276     define variable vDocumentCreator as character no-undo.
     6277     define variable vDocumentCreatorBase as character no-undo.
     6278     define variable vOperationCode as character no-undo.
     6279     define variable vOperationContenttext as character no-undo.
     6280     define variable vOperationContent as character no-undo.
     6281     define variable vThumbprint as character no-undo.
     6282     define variable vJobTitle   as character no-undo.
     6283     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6284     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6285     if vOrganization eq ?
     6286     then do:
     6287        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6288        if vdate eq ?
     6289        then
     6290           return error "".
     6291     end.
     6292     else do:
     6293        define variable vTitleType as character no-undo.
     6294        define variable vSignSet   as component-handle no-undo.
     6295        define variable vSeller as logical no-undo.
     6296        vUserperm = vOrganization:GetUserPermissions().
     6297        vJobTitle = vUserperm:JobTitle.
     6298        release object vUserperm.
     6299        blk-tit:
     6300        do vi = 1 to num-entries(iTitleTypes):
     6301           vTitleType = entry(vi,iTitleTypes).
     6302           vSeller = index(vTitleType,"Seller") > 0.
     6303           if vSeller
     6304           then
     6305              next blk-tit.
     6306           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6307           if error-status:num-messages > 0
     6308           then do:
     6309              define variable vTasksetSign   as component-handle no-undo.
     6310              define variable vTasksetSignDetal   as component-handle no-undo.
     6311              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6312              getdesc(vTasksetSign).
     6313              vTasksetSign:DocumentTitleType = vTitleType.
     6314              getdesc(vTasksetSign).
     6315              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6316              getdesc(vTasksetSignDetal).
     6317              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6318              vTasksetSignDetal:SignerType = "LegalEntity" .
     6319              vTasksetSignDetal:SignerInfo = "".
     6320              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6321              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6322              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6323              getdesc(vTasksetSignDetal).
     6324              release object vTasksetSignDetal.
     6325              vTasksetSign:send() no-error.
     6326              if error-status:num-messages > 0 then do:
     6327                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6328              end.
     6329              release object vTasksetSign.
     6330           end.
     6331           else do:
     6332              getdesc(vSignSet).
     6333              release object vSignSet.
     6334           end.
     6335        end.
     6336        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6337                            then "2"
     6338                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6339                            then "3"
     6340                            else "1".
     6341        vdate = today.
     6342        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6343        release object vOrganization.
     6344     end.
     6345     if    vJobTitle eq ?
     6346        or vJobTitle eq ""
     6347     then
     6348        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6349      if (   iWorkflowId = 3
     6350         or iWorkflowId = 5
     6351         or iWorkflowId = 8
     6352         or iWorkflowId = 11
     6353         or iWorkflowId = 12
     6354         or iWorkflowId = 13
     6355         or iWorkflowId = 16)
     6356         and iReplyTask ne ?
     6357      then do:
     6358         getdesc(iReplyTask).
     6359         vContentItems = iReplyTask:ContentItems.
     6360         getdesc(vContentItems).
     6361         do vi = 1 to vContentItems:count:
     6362            getdesc(vContentItems:GetItem(vi - 1 )).
     6363            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6364            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6365            getdesc(vContentItem).
     6366            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6367            getdesc(vBuyerTitle).
     6368              if vBuyerTitle eq ?
     6369            then do:
     6370               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6371               getdesc(vBuyerTitle).
     6372               vOperationContenttext = "C изменением стоимости согласен".
     6373            end.
     6374            else do:
     6375               oOperationCode = vOperationContent.
     6376      vOperationContenttext = if vOperationContent eq "1"
     6377                          then "Принято без разногласий"
     6378                          else if vOperationContent eq "2"
     6379                          then "Принято с разногласиями"
     6380                          else if vOperationContent eq "3"
     6381                          then "Товары не приняты"
     6382                          else vOperationContent.
     6383               getdesc(vBuyerTitle).
     6384               vEmployee = vBuyerTitle:Employee.
     6385               getdesc(vEmployee).
     6386               define variable vUser   as component-handle no-undo.
     6387               vUser = mDiadocConnection:GetMyUser().
     6388               getdesc(vUser).
     6389               vEmployee:position        = vJobTitle    .
     6390               vEmployee:FirstName       = vUser:FirstName  .
     6391               vEmployee:LastName        = vUser:LastName   .
     6392               vEmployee:MiddleName      = vUser:MiddleName .
     6393               vEmployee:EmployeeBase     = "Должностные обязанности".
     6394               release object vUser.
     6395               getdesc(vEmployee).
     6396               getdesc(mDiadocConnection:Certificate).
     6397               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6398               getdesc(vBuyerTitle:ContentOperCode).
     6399               vContentOperCode = vBuyerTitle:ContentOperCode.
     6400               vContentOperCode:TotalCode = vOperationContent.
     6401               vBuyerTitle:OperationCode   = oOperationCode.
     6402               release object vContentOperCode.
     6403               release object vEmployee.
     6404            end.
     6405            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6406            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6407            vBuyerTitle:OperationContent =  vOperationContenttext.
     6408            vBuyerTitle:AcceptanceDate   = vdate.
     6409            getdesc(vBuyerTitle).
     6410            getdesc(vBuyerTitle:Signers).
     6411            vSigner = vBuyerTitle:Signers:additems().
     6412            getdesc(vSigner).
     6413            getdesc(vSigner:SignerReference).
     6414            getdesc(vSigner:SignerDetails).
     6415            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6416            vSigner:SignerReference:boxid = iOrganizationGuid.
     6417            getdesc(vSigner:SignerReference).
     6418            release object vBuyerTitle no-error.
     6419            release object vContentItem.
     6420         end.
     6421         release object vContentItems.
     6422      end.
     6423   end.
     6424   function SendAnswer returns character
     6425   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6426      define variable vContent       as component-handle no-undo.
     6427      define variable vContentItems  as component-handle no-undo.
     6428      define variable vSigner        as component-handle no-undo.
     6429      define variable vSignTask      as component-handle no-undo.
     6430      define variable vOrganization  as component-handle no-undo.
     6431      define variable vUserperm      as component-handle no-undo.
     6432      define variable vUser          as component-handle no-undo.
     6433      define variable vi as integer no-undo.
     6434      if     itypeAnswer ne "AcceptRevocation"
     6435         and iReplyTask  ne ?
     6436      then do:
     6437         getdesc(iReplyTask).
     6438         vContentItems = iReplyTask:ContentItems.
     6439         getdesc(vContentItems).
     6440         do vi = 1 to vContentItems:count:
     6441            getdesc(vContentItems:GetItem(vi - 1 )).
     6442            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6443            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6444            vContent:comment =  imes.
     6445           getdesc(vContent).
     6446            vSigner = vContent:Signer.
     6447            getdesc(vSigner).
     6448            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6449            vUserperm = vOrganization:GetUserPermissions().
     6450            define variable vJobTitle as character no-undo.
     6451            vJobTitle = vUserperm:JobTitle.
     6452            if    vJobTitle eq ?
     6453               or vJobTitle eq ""
     6454            then
     6455               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6456            release object vUserperm.
     6457            release object vOrganization.
     6458            vUser = mDiadocConnection:GetMyUser().
     6459            getdesc(vUser).
     6460            vSigner:Surname    = vUser:FirstName.
     6461            vSigner:FirstName  = vUser:LastName.
     6462            vSigner:Patronymic = vUser:MiddleName.
     6463            vSigner:JobTitle   = vJobTitle.
     6464            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6465            getdesc(vSigner).
     6466            release object vUser.
     6467            release object vSigner.
     6468            release object vContent.
     6469         end.
     6470         release object vContentItems.
     6471      end.
     6472   end.
     6473   procedure send:
     6474      define input  parameter iDocument as component-handle no-undo.
     6475      define input  parameter iTypeAnswer as character no-undo.
     6476      define input  parameter icomment as character no-undo.
     6477      define output parameter oOperationCode as character no-undo.
     6478      define variable vReplyTask    as component-handle no-undo.
     6479      define variable vTypeAnswer as character no-undo.
     6480      define variable vTypeAnswer_orig as character no-undo.
     6481      define variable Vmes as longchar  no-undo.
     6482      define variable vOrganizationGuid as character no-undo.
     6483      define variable vDocumentid as character no-undo.
     6484      define variable vi as integer no-undo.
     6485      if iDocument ne ?
     6486      then do:
     6487         case iTypeAnswer:
     6488            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     6489            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     6490            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     6491            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     6492            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     6493            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     6494            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     6495            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     6496            otherwise vTypeAnswer = iTypeAnswer .
     6497         end case.
     6498         vTypeAnswer_orig = vTypeAnswer.
     6499         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     6500            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     6501         then
     6502            vTypeAnswer =  "AcceptDocument".
     6503         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     6504         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     6505         vOrganizationGuid = iDocument:OrganizationGuid.
     6506         vDocumentid     = iDocument:DocumentId.
     6507         getdesc(iDocument).
     6508         if vTypeAnswer =  "AcceptDocument"
     6509         then do:
     6510            define variable vtitletype as character no-undo.
     6511            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     6512            run sendAccept in this-procedure (vTypeAnswer_orig,
     6513                                              vReplyTask,
     6514                                              iDocument:OrganizationGuid,
     6515                                              iDocument:WorkflowId,
     6516                                              vtitletype,
     6517                                              output oOperationCode ) no-error.
     6518            if error-status:error
     6519            then
     6520               return error "".
     6521         end.
     6522         else do:
     6523            find first utd where utd.DocumentExt     = vDocumentid
     6524                             and utd.OrganizationExt = vOrganizationGuid
     6525            no-lock no-error.
     6526            if available utd
     6527            then do:
     6528               if   vTypeAnswer ne  "CorrectionRequest"
     6529                   and vTypeAnswer ne  "RejectDocument"
     6530               then
     6531                  icomment = "".
     6532               if vTypeAnswer eq  "RejectDocument"
     6533               then do:
     6534                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     6535                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     6536               end.
     6537               else do:
     6538                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     6539                   Vmes = GetErrComText(icomment,Vmes).
     6540               end.
     6541               if mFlaftest
     6542               then do:
     6543                  output stream File-stream to "SendAnswer.txt" .
     6544                  put stream File-stream unformatted string(Vmes).
     6545                  output stream File-stream close.
     6546                  message "сформирован файл " search("SendAnswer.txt")
     6547                  view-as alert-box.
     6548                  return error "ничего не отправляем".
     6549               end.
     6550               else
     6551                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     6552               if error-status:error
     6553               then
     6554                  return error "".
     6555               end.
     6556            end.
     6557         if not mFlaftest
     6558         then do:
     6559            getdesc(vReplyTask).
     6560             vReplyTask:Send() no-error.
     6561            if error-status:num-messages > 0 then do:
     6562               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     6563               release object vReplyTask.
     6564               return error "Ошибка при выполнение дейстия с документом".
     6565            end.
     6566         end.
     6567      end.
     6568   end.
     6569   procedure SendReceiptsAsync :
     6570   define input  parameter idb-num as integer no-undo.
     6571   define input  parameter idoc-id as integer no-undo.
     6572      define variable vDocument as component-handle no-undo.
     6573      define buffer utd for utd.
     6574      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6575      then do:
     6576         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6577         define variable vAsyncResult   as component-handle no-undo.
     6578         vAsyncResult = vDocument:SendReceiptsAsync().
     6579         release object vDocument.
     6580         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6581         find first utd where utd.db-num eq idb-num
     6582                          and utd.doc-id eq idoc-id
     6583         exclusive-lock no-error.
     6584         if available utd
     6585         then do:
     6586            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6587            then do:
     6588                run  UpdateUTDInformOne(vDocument).
     6589               release object vDocument.
     6590            end.
     6591            utd.flagRI = yes.
     6592       end.
     6593         PutMes(vAsyncResult:Result).
     6594         release object vAsyncResult.
     6595         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6596         then do:
     6597             run  UpdateUTDInformOne(vDocument).
     6598            release object vDocument.
     6599         end.
     6600      end.
     6601   end.
     6602   procedure SendAnsver:
     6603      define input  parameter idb-num as integer no-undo.
     6604      define input  parameter idoc-id as integer no-undo.
     6605      define input  parameter iTypeAnswer as character no-undo.
     6606      define input  parameter iComment as character no-undo.
     6607      define variable vSendcode as character no-undo.
     6608      define variable vDocument as component-handle no-undo.
     6609      define buffer utd for utd.
     6610      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6611      then do:
     6612         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     6613          run   SendReceiptsAsync(idb-num,idoc-id).
     6614            find first utd where utd.db-num eq idb-num
     6615                                   and utd.doc-id eq idoc-id
     6616                  no-lock.
     6617         if      (not utd.AmendmentRequested
     6618             and  iTypeAnswer eq "CorrectionRequest")
     6619             or iTypeAnswer ne "CorrectionRequest"
     6620         then do:
     6621             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     6622            if error-status:error
     6623            then do:
     6624               release object vDocument.
     6625               return error return-value.
     6626            end.
     6627            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     6628         end.
     6629         else
     6630            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     6631         release object vDocument.
     6632         if     vSendcode ne ?
     6633            and vSendcode ne ""
     6634         then
     6635            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     6636         if not mFlaftest
     6637         then do:
     6638            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6639            then do:
     6640                run   UpdateUTDInformOne(vDocument).
     6641               release object vDocument.
     6642            end.
     6643            if    iTypeAnswer eq "CorrectionRequest"
     6644               or iTypeAnswer eq "AcceptRevocation"
     6645               or iTypeAnswer eq "RejectRevocation"
     6646               or iTypeAnswer eq "RejectDocument"
     6647               or iTypeAnswer eq "AcceptDocument"
     6648               or iTypeAnswer eq "AcceptDocumentWithDisc"
     6649               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     6650            then do:
     6651               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6652               then do:
     6653                   run  UpdateUTDInformOne(vDocument).
     6654                  release object vDocument.
     6655               end.
     6656               if   not mFlaftest
     6657               then do trans:
     6658                  find first utd where utd.db-num eq idb-num
     6659                                   and utd.doc-id eq idoc-id
     6660                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6661                  exclusive-lock no-error.
     6662                  if available utd
     6663                  then do :
     6664                     case iTypeAnswer:
     6665                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6666                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6667                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     6668                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     6669                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     6670                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6671                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6672                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6673                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6674                     end case.
     6675                     if iTypeAnswer eq "CorrectionRequest"
     6676                     then do:
     6677                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     6678                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6679                        then do:
     6680                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     6681                        end.
     6682                     end.
     6683                  end.
     6684               end.
     6685            end.
     6686         end.
     6687      end.
     6688   end.
     6689   procedure  SendResponse :
     6690      define input  parameter idb-num as integer no-undo.
     6691      define input  parameter idoc-id as integer no-undo.
     6692      define input  parameter iAccept as logical no-undo.
     6693      define input  parameter itestMod as logical no-undo.
     6694       define buffer utd for utd.
     6695       define buffer buf_utd for utd.
     6696       itestMod = not itestMod.
     6697       define variable vreturn as logical no-undo.
     6698       find first utd where utd.db-num eq idb-num
     6699                        and utd.doc-id eq idoc-id
     6700       no-lock no-error.
     6701       if available utd
     6702       then do:
     6703          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     6704          then do:
     6705             if     iAccept
     6706                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     6707                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     6708             then do:
     6709                vreturn = yes.
     6710                if itestMod
     6711                then do:
     6712                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     6713                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     6714                                      and buf_utd.Timestamp <= utd.Timestamp
     6715                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     6716                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6717                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     6718                   no-lock :
     6719                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     6720                      if error-status:error then return error return-value.
     6721                   end.
     6722                end.
     6723             end.
     6724          end.
     6725          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     6726          then do:
     6727             if iAccept
     6728             then do:
     6729                vreturn = yes.
     6730                if itestMod
     6731                then do:
     6732                   define variable vsend as logical no-undo.
     6733                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     6734                   if vsend
     6735                   then
     6736                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     6737                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     6738                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     6739                   no-lock no-error.
     6740                   if available buf_utd
     6741                   then do:
     6742                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     6743                      then do:
     6744                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     6745                         if error-status:error then return error return-value.
     6746                      end.
     6747                   end.
     6748                   run bge/sendutd.p(
     6749                        parparentproc,
     6750                        mDiadocConnection:Certificate:Thumbprint,
     6751                        idb-num,
     6752                        idoc-id) no-error.
     6753                   if error-status:error then return error return-value.
     6754                   do trans :
     6755                      find first utd where utd.db-num eq idb-num
     6756                                       and utd.doc-id eq idoc-id
     6757                      exclusive-lock no-error.
     6758                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     6759                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     6760                   end.
     6761                end.
     6762             end.
     6763          end.
     6764          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6765          then do:
     6766             if iAccept
     6767             then do:
     6768                vreturn = yes.
     6769                if itestMod
     6770                then
     6771                    run  SendReceiptsAsync(idb-num,idoc-id).
     6772             end.
     6773          end.
     6774          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     6775          then do:
     6776             if not iAccept
     6777             then do:
     6778                vreturn = yes.
     6779                if itestMod
     6780                then do:
     6781                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6782                   if error-status:error then return error return-value.
     6783                end.
     6784             end.
     6785          end.
     6786          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     6787          then do:
     6788             vreturn = yes.
     6789             if iAccept
     6790             then do:
     6791                if itestMod
     6792                then do:
     6793                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     6794                   if error-status:error then return error return-value.
     6795                end.
     6796             end.
     6797             else do:
     6798                if itestMod
     6799                then do:
     6800                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     6801                   if error-status:error then return error return-value.
     6802                end.
     6803             end.
     6804          end.
     6805          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     6806                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     6807          then do:
     6808             vreturn = yes.
     6809             if iAccept
     6810             then do:
     6811                if itestMod
     6812                then do:
     6813                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     6814                   if error-status:error then return error return-value.
     6815                end.
     6816             end.
     6817             else do:
     6818                if itestMod
     6819                then do:
     6820                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6821                   if error-status:error then return error return-value.
     6822                end.
     6823             end.
     6824          end.
     6825          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6826          then do:
     6827             if iAccept
     6828             then do:
     6829                vreturn = yes.
     6830                if itestMod
     6831                then do:
     6832                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6833                   if error-status:error then return error return-value.
     6834                end.
     6835             end.
     6836          end.
     6837          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     6838          then do:
     6839             if iAccept
     6840             then do:
     6841                vreturn = yes.
     6842                if itestMod
     6843                then do:
     6844                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     6845                   if error-status:error then return error return-value.
     6846                end.
     6847             end.
     6848          end.
     6849          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     6850          then do:
     6851             if iAccept
     6852             then do:
     6853                vreturn = yes.
     6854                if itestMod
     6855                then do:
     6856                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     6857                   if error-status:error then return error return-value.
     6858                end.
     6859             end.
     6860          end.
     6861          if itestmod and not vreturn
     6862          then do:
     6863             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     6864                                utd.db-num,
     6865                                utd.doc-id,
     6866                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     6867                                if iAccept then "Подписать" else "Отказать",
     6868                                utd.DocumentNumber)
     6869                                ).
     6870          end.
     6871       end.
     6872       return string(vreturn).
     6873   end.
     6874   define temp-table tt-pack no-undo
     6875             field orgid as char
     6876             field docid as char
     6877             field packid as char
     6878             field stamp as datetime
     6879             index pi packid   stamp   orgid  docid
     6880             .
     6881   function CheckLoad returns logical
     6882   (iDocument as component-handle,
     6883    output ohost-code as integer ,
     6884    output oObj-type  as character  ,
     6885    output oObj-code  as integer ):
     6886      define variable vFlag as logical no-undo.
     6887      define variable vDocumentChild as component-handle no-undo.
     6888      define variable vContent as component-handle no-undo.
     6889      define variable vConsignees as component-handle no-undo.
     6890      define variable vfilename as character no-undo.
     6891      oObj-type  = ?.
     6892      oObj-code  = ?.
     6893      ohost-code = ?.
     6894      define buffer ext-classif   for ext-classif.
     6895      define buffer clients       for clients.
     6896      define buffer buf_clients   for clients.
     6897      define buffer clients-attr  for clients-attr.
     6898      if   iDocument:type eq "UniversalTransferDocument"
     6899        or iDocument:type eq "UniversalTransferDocumentRevision"
     6900      then main-block :
     6901      do on error undo main-block, return error:
     6902         getdesc(iDocument).
     6903         vfilename = iDocument:filename.
     6904         if iDocument:Direction eq "Inbound"
     6905         then do:
     6906            define variable vOrganizationGuid as character no-undo.
     6907            define variable vDocumentid as character no-undo.
     6908            vOrganizationGuid = iDocument:OrganizationGuid.
     6909            vDocumentid     = iDocument:DocumentId.
     6910            find first utd where utd.DocumentExt     = vDocumentid
     6911                             and utd.OrganizationExt = vOrganizationGuid
     6912            no-lock no-error .
     6913            if available utd
     6914            then do:
     6915               assign
     6916                  Oobj-type = utd.obj-type
     6917                  Oobj-code = utd.obj-code
     6918                  ohost-code = utd.host-code.
     6919               .
     6920            end.
     6921            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     6922            getdesc(vDocumentChild).
     6923            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6924               and ohost-code ne 0 and ohost-code ne ?)
     6925            then vFlag = no.
     6926            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6927               and (ohost-code eq 0 and ohost-code eq ?))
     6928            then do:
     6929                find first clients  where clients.obj-type   = Oobj-type
     6930                                      and clients.obj-code   = Oobj-code
     6931                no-lock no-error .
     6932                if available clients
     6933                then
     6934                   ohost-code =  clients.host-code.
     6935                vFlag = no.
     6936            end.
     6937            else if vDocumentChild ne ?
     6938            then do:
     6939               if iDocument:version  eq "utd820_05_01_01"
     6940               then do:
     6941                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     6942               end.
     6943               else
     6944                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     6945               release object vDocumentChild.
     6946               if vContent ne ?
     6947               then do:
     6948                  getdesc(vContent).
     6949                  define variable vFnsParticipantId as character no-undo.
     6950                  define variable vinn as character no-undo.
     6951                  define variable vkpp as character no-undo.
     6952                  define variable vorgname as character no-undo.
     6953                  define variable vAddrOrg as character no-undo.
     6954                  define variable vAdditionalInfo as character no-undo.
     6955                  if iDocument:version  eq "utd820_05_01_01"
     6956                  then do:
     6957                     getdesc(vContent:Sellers).
     6958                     getdesc(vContent:Sellers:Seller).
     6959                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     6960                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     6961                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6962                  end.
     6963                  else do:
     6964                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     6965                  end.
     6966                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6967                                           and ext-classif.charkey_three eq vFnsParticipantId
     6968                  no-lock no-error.
     6969                  if available ext-classif
     6970                  then do:
     6971                     find first clients
     6972                       where clients.obj-type   = ext-classif.CharKey_One
     6973                         and clients.obj-code   = ext-classif.Key#_One
     6974                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     6975                     no-lock no-error .
     6976                     if not available clients
     6977                     then do:
     6978                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6979                        return no.
     6980                     end.
     6981                  end.
     6982                  else do:
     6983                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6984                     return no.
     6985                  end.
     6986                  if iDocument:version  eq "utd820_05_01_01"
     6987                  then do:
     6988                     getdesc(vContent:Buyers).
     6989                     getdesc(vContent:Buyers:Buyer).
     6990                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     6991                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     6992                  end.
     6993                  else do:
     6994                     vConsignees = vContent:Consignees.
     6995                     getdesc(vConsignees).
     6996                     getdesc(vConsignees:Consignee).
     6997                     if vConsignees:Consignee:count > 0
     6998                     then do:
     6999                        getdesc(vConsignees:Consignee:GetItem(0)).
     7000                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7001                     end.
     7002                     release object vConsignees.
     7003                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     7004                  end.
     7005                  release object vContent.
     7006                  define variable otext as character no-undo.
     7007                  vFlag = getObgFns
     7008                             (input iDocument:DocumentNumber ,
     7009                              input vFnsParticipantId ,
     7010                              input vkpp,
     7011                              output ohost-code,
     7012                              output oobj-type,
     7013                              output oobj-code,
     7014                              output otext ).
     7015                  if otext ne "" and otext ne ?
     7016                  then
     7017                     PutMes( otext).
     7018                  if vFlag  eq no
     7019                  then
     7020                     return vFlag .
     7021               end.
     7022               else do:
     7023                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     7024                  return no.
     7025               end.
     7026            end.
     7027            else do:
     7028               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7029               return no.
     7030            end.
     7031         end.
     7032         else
     7033            return yes.
     7034         if ohost-code eq ? or ohost-code eq 0
     7035         then do:
     7036            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7037            return no.
     7038         end.
     7039      end.
     7040      else do:
     7041         define variable vdb-num as integer no-undo.
     7042         define variable vdoc-id as integer no-undo.
     7043         define variable vpack as character no-undo init ?.
     7044         define variable vcli-type as character no-undo.
     7045         define variable vcli-code as integer no-undo.
     7046         define variable vfns as character no-undo.
     7047         define variable vchar as character no-undo.
     7048         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     7049         if vDocumentChild eq ?
     7050         then do:
     7051            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7052            return no.
     7053         end.
     7054         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     7055         if vContent ne ?
     7056         then do:
     7057            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     7058            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7059                                     and ext-classif.charkey_three eq vFns
     7060            no-lock no-error.
     7061            if available ext-classif
     7062            then do:
     7063               assign
     7064                  vcli-type = ext-classif.CharKey_One
     7065                  vcli-code = ext-classif.Key#_One
     7066               .
     7067               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7068               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     7069               release object vContent.
     7070            end.
     7071            else do:
     7072                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7073                     return no.
     7074                  end.
     7075         end.
     7076         else do:
     7077            PutErr("Error Ошибка получения данных из Диадок Seller").
     7078            return no.
     7079         end.
     7080         release object vDocumentChild.
     7081         define buffer     utd for utd.
     7082         find first utd where utd.db-num eq vdb-num
     7083                          and utd.doc-id eq vdoc-id
     7084         no-lock no-error.
     7085         if available utd
     7086         then do:
     7087            assign
     7088               oobj-type  = utd.obj-type
     7089               oobj-code  = utd.obj-code
     7090               ohost-code = utd.host-code
     7091               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     7092            .
     7093         end.
     7094         else do:
     7095            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     7096            return no.
     7097         end.
     7098      end.
     7099      if  yes
     7100      then do:
     7101         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7102         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     7103         if     not EDOParSec:IsEdo
     7104            and vfilename begins "ON_NSCHFDOPPRMARK_"
     7105         then do:
     7106            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     7107            vFlag = no.
     7108         end.
     7109         else if     not EDOParSec:IsEdoNotmark
     7110                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     7111         then do:
     7112            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     7113            vFlag = no.
     7114         end.
     7115         else
     7116            vFlag = yes.
     7117      end.
     7118      return vFlag.
     7119   end.
     7120   procedure  UpdateUTDInformOne :
     7121      define input  parameter iDocument as component-handle no-undo.
     7122      define variable vOrganizationGuid as character no-undo.
     7123      define variable vDocumentId as character no-undo.
     7124      define variable vi as integer no-undo.
     7125      define variable vii as integer no-undo.
     7126      define variable viii as integer no-undo.
     7127      define variable vtext as longchar no-undo.
     7128      define buffer utd           for ub.utd.
     7129      define buffer old_utd           for ub.utd.
     7130      define buffer utd-lines      for ub.utd-lines.
     7131      define buffer marking       for ub.marking.
     7132      define buffer marking-lines for ub.marking-lines.
     7133      define buffer utd-marking-lines for ub.utd-marking-lines.
     7134      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     7135      define variable vDocumentChild               as component-handle no-undo.
     7136      define variable vContent                     as component-handle no-undo.
     7137      define variable vValues                      as component-handle no-undo.
     7138      define variable vSellers                     as component-handle no-undo.
     7139      define variable vConsignees                  as component-handle no-undo.
     7140      define variable vInvoiceTable                as component-handle no-undo.
     7141      define variable vItems                       as component-handle no-undo.
     7142      define variable vExtendedInvoiceItem         as component-handle no-undo.
     7143      define variable vItemIdentificationNumber    as component-handle no-undo.
     7144      define variable vTransferBaseCol             as component-handle no-undo.
     7145      define variable vTransferBase                as component-handle no-undo.
     7146      define variable vorgname as character no-undo.
     7147      define variable vAddrOrg as character no-undo.
     7148      define variable vAdditionalInfo as character no-undo.
     7149      define variable volddb-num as integer no-undo.
     7150      define variable volddoc-id as integer no-undo.
     7151      define variable vunits  as component-handle no-undo.
     7152      define variable vunit   as component-handle no-undo.
     7153      define variable VValue  as character        no-undo.
     7154      define variable vsite   as character        no-undo.
     7155      define variable vNewUtd as logical          no-undo.
     7156      if iDocument eq ?
     7157      then
     7158        return.
     7159      vOrganizationGuid = iDocument:OrganizationGuid.
     7160      vDocumentid     = iDocument:DocumentId.
     7161      find first utd where utd.DocumentExt     = vDocumentid
     7162                       and utd.OrganizationExt = vOrganizationGuid
     7163      no-lock no-error .
     7164      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     7165                            and tt-recid.docid eq vDocumentid
     7166      no-lock no-error.
     7167      if not available tt-recid
     7168      then do trans:
     7169         if iDocument  ne ?
     7170            and (
     7171                     iDocument:type eq "UniversalTransferDocument"
     7172                  or iDocument:type eq "UniversalTransferDocumentRevision"
     7173                  or iDocument:type eq "UniversalCorrectionDocument"
     7174                 )
     7175         then do:
     7176            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7177            define variable vhost-code as integer   no-undo.
     7178            define variable vobj-type  as character no-undo.
     7179            define variable vobj-code  as integer   no-undo.
     7180            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     7181            then do:
     7182               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7183               create tt-recid.
     7184               assign
     7185                  tt-recid.orgid = vOrganizationGuid
     7186                  tt-recid.docid = vDocumentid
     7187               .
     7188               return.
     7189            end.
     7190            find first utd where utd.DocumentExt     = vDocumentid
     7191                             and utd.OrganizationExt = vOrganizationGuid
     7192            no-lock no-error  .
     7193            if available utd
     7194            then do:
     7195               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7196                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     7197               then do:
     7198                  create tt-recid.
     7199                  assign
     7200                     tt-recid.orgid = vOrganizationGuid.
     7201                     tt-recid.docid = vDocumentid
     7202                  .
     7203                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7204               end.
     7205               find current utd exclusive-lock no-error  no-wait  .
     7206               if  not available  utd
     7207               then do:
     7208                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     7209                  return.
     7210               end.
     7211            end.
     7212            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7213            MySeqUtd = ?.
     7214            if     not available  utd
     7215            then do:
     7216               create utd.
     7217               assign
     7218                  utd.DocumentExt      = vDocumentid
     7219                  utd.OrganizationExt  = vOrganizationGuid
     7220                  vNewUtd              = yes
     7221               .
     7222               validate utd.
     7223            end.
     7224            assign
     7225               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     7226               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     7227               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     7228            .
     7229            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7230            utd.RevocationStatus = iDocument:RevocationStatus.
     7231            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7232            utd.TypeId           = iDocument:type.
     7233            utd.CounteragentId   = iDocument:Counteragent:guid.
     7234            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7235            utd.sts-edi = ?.
     7236            utd.DocumentNumber = iDocument:DocumentNumber.
     7237            utd.DocumentDate   = date(iDocument:DocumentDate).
     7238            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7239            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     7240            utd.Direction      = iDocument:Direction.
     7241            utd.ModifyDate = today.
     7242            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     7243            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     7244                             or iDocument:type eq "UniversalTransferDocumentRevision"
     7245                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7246                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     7247            getdesc(iDocument).
     7248            getdesc(iDocument:Counteragent).
     7249            getdesc(iDocument:RecipientReceiptMetadata).
     7250            getdesc(iDocument:ConfirmationMetadata).
     7251            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     7252            if iDocument:type ne "UniversalTransferDocumentRevision"
     7253            then do:
     7254                   utd.Revised = logical(iDocument:Revised).
     7255                   utd.Corrected = logical(iDocument:Corrected).
     7256            end.
     7257            vDocumentChild = iDocument:GetDynamicContent("Seller").
     7258            getdesc(vDocumentChild).
     7259            if   iDocument:type eq "UniversalTransferDocument"
     7260              or iDocument:type eq "UniversalTransferDocumentRevision"
     7261            then do:
     7262               utd.Total = iDocument:total.
     7263               utd.Vat = iDocument:Vat.
     7264            end.
     7265            else do:
     7266               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     7267               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     7268            end.
     7269            find first utd-lines where utd-lines.db-num     = utd.db-num
     7270                                   and utd-lines.doc-id     = utd.doc-id
     7271                                   no-lock no-error.
     7272            if     (   vNewUtd
     7273                    or utd.Direction ne "Inbound"
     7274                    or not available utd-lines)
     7275               and vDocumentChild ne ?
     7276            then do:
     7277               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7278               then do:
     7279                  if iDocument:version  eq "utd820_05_01_01"
     7280                  then do:
     7281                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     7282                  end.
     7283                  else
     7284                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7285                  if vContent ne ?
     7286                  then do:
     7287                     getdesc(vContent).
     7288                     define variable vInfoCount as integer no-undo.
