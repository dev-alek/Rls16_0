     8860       SIZE 3 BY 1.
     8861   DEFINE VARIABLE c-status     AS CHARACTER FORMAT "X(256)":U INITIAL "0"
     8862       LABEL "Статус"
     8863       VIEW-AS COMBO-BOX INNER-LINES 5
     8864       LIST-ITEM-PAIRS "Все","0",
     8865       "Новый","1",
     8866       "Отправлен","2",
     8867       "Подтверждено без изменений","3",
     8868       "Есть изменения","4",
     8869       "Отклонен","5",
     8870       "Ожидает поставку","6",
     8871       "Поставка принята","7",
     8872       "Получено поставщиком","8"
     8873       DROP-DOWN-LIST
     8874       SIZE 32 BY 1 NO-UNDO.
     8875   DEFINE VARIABLE cli-code     AS CHARACTER FORMAT "x(20)"
