    10685           then do:
    10686             undo move_block, retry move_block .
    10687           end.
    10688         end.
    10689         for each buf_temp-diasize-handle
    10690         on error undo move_block, retry move_block
    10691         :
    10692           assign
    10693             v-object-handle = buf_temp-diasize-handle.handle-value
    10694           .
    10695           if v-object-handle <> v-diasize-resize-button
    10696           then do:
    10697             assign
    10698               v-object-handle :col = v-object-handle :col + p-change-value
    10699               no-error .
    10700             if error-status :error
    10701             or error-status :get-message(1) <> ""
    10702             then do:
    10703               undo move_block, retry move_block .
    10704             end.
    10705           end.
    10706         end.
    10707       end.
    10708       else do:
    10709         for each buf_temp-diasize-handle
    10710         on error undo move_block, retry move_block
    10711         :
    10712           assign
    10713             v-object-handle = buf_temp-diasize-handle.handle-value
    10714           .
    10715           if v-object-handle <> v-diasize-resize-button
    10716           then do:
    10717             assign
    10718               v-object-handle :col = v-object-handle :col + p-change-value
    10719               no-error .
    10720             if error-status :error
    10721             or error-status :get-message(1) <> ""
    10722             then do:
    10723               undo move_block, retry move_block .
    10724             end.
    10725           end.
    10726         end.
    10727         for each buf_temp-browse-handle
    10728           where buf_temp-browse-handle.browse-type = 'width':u
    10729         on error undo move_block, retry move_block
    10730         :
    10731           assign
    10732             buf_temp-browse-handle.browse-handle :width
    10733               = buf_temp-browse-handle.browse-handle :width + p-change-value
    10734             no-error .
    10735           if error-status :error
    10736           or error-status :get-message(1) <> ""
    10737           then do:
    10738             undo move_block, retry move_block .
    10739           end.
    10740         end.
    10741         assign
    10742           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
    10743           no-error .
    10744         if error-status :error
    10745         or error-status :get-message(1) <> ""
    10746         then do:
    10747           undo move_block, retry move_block.
    10748         end.
    10749         assign
    10750           frame d-order :width = frame d-order :width + p-change-value
    10751         no-error .
    10752         if error-status :error
    10753         or error-status :get-message(1) <> ""
    10754         then do:
    10755           undo move_block, retry move_block.
    10756         end.
    10757         if frame d-order :scrollable = true
    10758         then do:
    10759           assign
    10760             frame d-order :virtual-width = frame d-order :virtual-width + p-change-value
    10761           no-error .
    10762           if error-status :error
    10763           or error-status :get-message(1) <> ""
    10764           then do:
    10765             undo move_block, retry move_block.
    10766           end.
    10767         end.
    10768       end.
    10769       if p-move-resize
    10770       then do:
    10771         run diasize_position-resize-button in this-procedure .
    10772       end.
    10773       if v-diasize-wndstore = true
    10774       then do:
    10775         if connected("ub") = true
    10776         then do:
    10777           define variable v-cntxt-db-num        as integer   no-undo .
    10778           define variable v-cntxt-userid        as character no-undo .
    10779           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    10780                                             , OUTPUT v-cntxt-userid
    10781                                             ) .
    10782           run gbl/wndsizew.p
    10783             (input  v-cntxt-db-num
    10784             ,input  v-cntxt-userid
    10785             ,input  v-diasize-proc-name
    10786             ,input  'width':u
    10787             ,input  string(frame d-order :width - v-diasize-orig-frame-width)
    10788             ) .
    10789         end.
    10790       end.
    10791     end.
    10792     assign
    10793       v-diasize-change-size = false
    10794     .
    10795   end procedure.
    10796   procedure diasize_set-width :
    10797     define input  parameter p-new-width  as decimal   no-undo .
    10798     define input  parameter p-move-resize as logical   no-undo .
    10799     do
    10800     on error undo, return error return-value
    10801     :
    10802       run diasize_change-width in this-procedure
    10803         (input  (p-new-width - frame d-order :width)
    10804         ,input  p-move-resize
    10805         ) .
    10806     end.
    10807   end procedure.
    10808   procedure diasize_position-resize-button :
    10809     do with frame d-order
    10810     :
    10811       hide v-diasize-resize-button .
    10812       assign
    10813         v-diasize-resize-button :row = frame d-order :height - v-diasize-resize-button :height
    10814                     - 1
    10815                     - (frame d-order :border-bottom-pixels / session :pixels-per-row)
    10816         v-diasize-resize-button :col = frame d-order :width - v-diasize-resize-button :width
    10817                     - 1
    10818                     - (frame d-order :border-right-pixels / session :pixels-per-column)
    10819       .
    10820       view v-diasize-resize-button .
    10821     end.
    10822   end procedure.
    10823   on alt-right anywhere
    10824   do:
    10825     run diasize_change-width in this-procedure
    10826       (input 1
    10827       ,input true
    10828       ) .
    10829     return no-apply .
    10830   end.
    10831   on alt-left anywhere
    10832   do:
    10833     run diasize_change-width in this-procedure
    10834       (input -1
    10835       ,input true
    10836       ) .
    10837     return no-apply .
    10838   end.
    10839   on alt-down anywhere
    10840   do:
    10841     run diasize_change-height in this-procedure
    10842       (input 1
    10843       ,input true
    10844       ) .
    10845     return no-apply .
    10846   end.
    10847   on alt-up anywhere
    10848   do:
    10849     run diasize_change-height in this-procedure
    10850       (input -1
    10851       ,input true
    10852       ) .
    10853     return no-apply .
    10854   end.
    10855   on alt-enter of frame d-order
    10856   do:
    10857     run diasize_maximize in this-procedure
    10858       (input  ?
    10859       ).
    10860     return no-apply .
    10861   end.
    10862   procedure diasize_end-move :
    10863     do
    10864     on error undo, return error return-value
    10865     :
    10866       define variable v-row-delta as decimal   no-undo .
    10867       define variable v-col-delta as decimal   no-undo .
    10868       define variable v-new-row as decimal   no-undo .
    10869       define variable v-new-col as decimal   no-undo .
    10870       assign
    10871         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    10872         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    10873       .
    10874       assign
    10875         v-row-delta = v-new-row - frame d-order :height
    10876         v-col-delta = v-new-col - frame d-order :width
    10877       .
    10878       run diasize_change-height in this-procedure
    10879         (input v-row-delta
    10880         ,input true
    10881         ) .
    10882       run diasize_change-width in this-procedure
    10883         (input v-col-delta
    10884         ,input true
    10885         ) .
    10886     end.
    10887   end procedure.
    10888   procedure diasize_maximize :
    10889     define input  parameter p-action as logical   no-undo .
    10890     do
    10891     on error undo, return error return-value
    10892     :
    10893       if p-action = ?
    10894       then do:
    10895         if v-diasize-need-maximize = true
    10896         then do:
    10897           assign
    10898             p-action = true
    10899           .
    10900         end.
    10901         else do:
    10902           assign
    10903             p-action = false
    10904           .
    10905         end.
    10906       end.
    10907       if p-action = true
    10908       then do:
    10909         run diasize_change-height in this-procedure
    10910           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    10911               - frame d-order :height-chars
    10912           ,input true
    10913           ) .
    10914         run diasize_change-width in this-procedure
    10915           (input session :width-chars
    10916               - frame d-order :width-chars
    10917           ,input true
    10918           ) .
    10919         assign
    10920           v-diasize-need-maximize = false
    10921         .
    10922       end.
    10923       else do:
    10924         run diasize_change-width in this-procedure
    10925           (input v-diasize-orig-frame-width
    10926               - frame d-order :width-chars
    10927           ,input true
    10928           ) .
    10929         run diasize_change-height in this-procedure
    10930           (input v-diasize-orig-frame-height
    10931               - frame d-order :height-chars
    10932           ,input true
    10933           ) .
    10934         assign
    10935           v-diasize-need-maximize = true
    10936         .
    10937       end.
    10938     end.
    10939   end procedure.
    10940   procedure diasize_restore-orig-size :
    10941     do
    10942     on error undo, return error return-value
    10943     :
    10944       assign
    10945         v-diasize-current-frame-width  = frame d-order :width
    10946         v-diasize-current-frame-height = frame d-order :height
    10947       .
    10948       run diasize_set-height in this-procedure
    10949         (input  v-diasize-orig-frame-height
    10950         ,input  true
    10951         ) .
    10952       run diasize_set-width in this-procedure
    10953         (input  v-diasize-orig-frame-width
    10954         ,input  true
    10955         ) .
    10956     end.
    10957   end procedure.
    10958   procedure diasize_restore-current-size :
    10959     do
    10960     on error undo, return error return-value
    10961     :
    10962       run diasize_set-height in this-procedure
    10963         (input  v-diasize-current-frame-height
    10964         ,input  true
    10965         ) .
    10966       run diasize_set-width in this-procedure
    10967         (input  v-diasize-current-frame-width
    10968         ,input  true
    10969         ) .
    10970     end.
    10971   end procedure.
    10972   procedure diasize_set-browse-handle :
    10973     define input  parameter p-browse-handle as handle   no-undo .
    10974     define buffer buf_temp-browse-handle for temp-browse-handle .
    10975     do
    10976     on error undo, return error return-value
    10977     :
    10978       assign
    10979         v-diasize-browse-handle = p-browse-handle
    10980       .
    10981       for each buf_temp-browse-handle
    10982       on error undo, return error return-value
    10983       :
    10984         delete buf_temp-browse-handle .
    10985       end.
    10986     end.
    10987   end procedure.
    10988   procedure diasize_add_browse :
    10989     define input  parameter p-browse-type   as character no-undo .
    10990     define input  parameter p-browse-handle as handle    no-undo .
    10991     define buffer buf_temp-browse-handle for temp-browse-handle .
    10992     do
    10993     on error undo, return error return-value
    10994     :
    10995       assign
    10996         v-diasize-browse-number = v-diasize-browse-number + 1
    10997       .
    10998       create buf_temp-browse-handle .
    10999       assign
    11000         buf_temp-browse-handle.browse-type   = p-browse-type
    11001         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    11002         buf_temp-browse-handle.browse-handle = p-browse-handle
    11003       .
    11004     end.
    11005   end procedure.
    11006   procedure diasize_init :
    11007     define variable v-default-value    as logical   no-undo .
    11008     define variable v-restore-saved    as logical   no-undo .
    11009     define variable v-resize-value-str as character no-undo .
    11010     do
    11011     on error undo, return error return-value
    11012     :
    11013       do with frame d-order
    11014       :
    11015         assign
    11016           v-diasize-orig-frame-height = frame d-order :height
    11017           v-diasize-orig-frame-width  = frame d-order :width
    11018           v-diasize-browse-handle     = browse br-order :handle
    11019         .
    11020         create button v-diasize-resize-button
    11021         assign
    11022           parent        = frame d-order :first-child
    11023           label         = "s"
    11024           height-pixels = 16
    11025           width-pixels  = 16
    11026           visible       = true
    11027           sensitive     = true
    11028           movable       = true
    11029           triggers:
    11030             on end-move persistent run diasize_end-move in this-procedure .
    11031           end triggers.
    11032         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    11033         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    11034         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    11035         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    11036         assign
    11037           v-diasize-wndmax = false
    11038         .
    11039         if connected("ub") = true
    11040         then do:
    11041           define variable v-cntxt-db-num        as integer   no-undo .
    11042           define variable v-cntxt-userid        as character no-undo .
    11043           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    11044                                             , OUTPUT v-cntxt-userid
    11045                                             ) .
    11046           run gbl/wndpar_r.p
    11047             (input  v-cntxt-db-num
    11048             ,input  v-cntxt-userid
    11049             ,input  'wndmax':U
    11050             ,output v-diasize-wndmax
    11051             ,output v-default-value
    11052             ) .
    11053         end.
    11054         assign
    11055           v-diasize-wndstore = false
    11056         .
    11057         if connected("ub") = true
    11058         then do:
    11059           run gbl/wndpar_r.p
    11060             (input  v-cntxt-db-num
    11061             ,input  v-cntxt-userid
    11062             ,input  'wndstore':U
    11063             ,output v-diasize-wndstore
    11064             ,output v-default-value
    11065             ) .
    11066         end.
    11067         assign
    11068           v-diasize-proc-name = entry(1, program-name(2), '.')
    11069         .
    11070         if v-diasize-wndstore = true
    11071         then do:
    11072           assign
    11073             v-restore-saved = false
    11074           .
    11075           if connected("ub") = true
    11076           then do:
    11077             run gbl/wndsizer.p
    11078               (input  v-cntxt-db-num
    11079               ,input  v-cntxt-userid
    11080               ,input  v-diasize-proc-name
    11081               ,input  'height':u
    11082               ,output v-resize-value-str
    11083               ) .
    11084             if v-resize-value-str <> '':U
    11085             then do:
    11086               run diasize_change-height in this-procedure
    11087                 (input  integer(v-resize-value-str)
    11088                 ,input  true
    11089                 ) .
    11090               assign
    11091                 v-restore-saved = true
    11092               .
    11093             end.
    11094           end.
    11095           if connected("ub") = true
    11096           then do:
    11097             run gbl/wndsizer.p
    11098               (input  v-cntxt-db-num
    11099               ,input  v-cntxt-userid
    11100               ,input  v-diasize-proc-name
    11101               ,input  'width':u
    11102               ,output v-resize-value-str
    11103               ) .
    11104             if v-resize-value-str <> '':U
    11105             then do:
    11106               run diasize_change-width in this-procedure
    11107                 (input  integer(v-resize-value-str)
    11108                 ,input  true
    11109                 ) .
    11110               assign
    11111                 v-restore-saved = true
    11112               .
    11113             end.
    11114           end.
    11115           if v-restore-saved <> true
    11116           then do:
    11117             if v-diasize-wndmax = true
    11118             then do:
    11119               run diasize_maximize in this-procedure
    11120                 (input  true
    11121                 ) .
    11122             end.
    11123           end.
    11124         end.
    11125         else do:
    11126           if v-diasize-wndmax = true
    11127           then do:
    11128             run diasize_maximize in this-procedure
    11129               (input  true
    11130               ) .
    11131           end.
    11132         end.
    11133       end.
    11134     end.
    11135   end procedure.
    11136   procedure diasize_need-full-display :
    11137     define output parameter p-need-full-display as logical   no-undo .
    11138     do
    11139     on error undo, return error return-value
    11140     :
    11141       assign
    11142         p-need-full-display = v-diasize-need-full-display
    11143       .
    11144       assign
    11145         v-diasize-need-full-display = false
    11146       .
    11147     end.
    11148   end procedure.
    11149   procedure get-context :
    11150      define output parameter p-db-num as integer          no-undo.
    11151      define output parameter p-user-id as character        no-undo.
    11152      define variable v-login               as character    no-undo.
    11153      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    11154      define buffer buf_user-login  for ub.user-login .
    11155      do
    11156      on error undo, return error
    11157      :
    11158            FIND FIRST buf_sys-ctrl no-lock.
    11159            ASSIGN
    11160               v-login = USERID("ub")
    11161               p-db-num = buf_sys-ctrl.db-num
    11162            .
    11163            FIND FIRST buf_user-login
    11164                 WHERE buf_user-login.db-num = p-db-num
    11165                   AND buf_user-login.user-login = v-login
    11166                 no-lock
    11167                 no-error
    11168                 .
    11169            IF AVAILABLE buf_user-login
    11170            THEN DO:
    11171               assign
    11172                  p-user-id = buf_user-login.user-id
    11173               .
    11174            END.
    11175      end.
    11176   end procedure.
    11177       run diasize_init in this-procedure .
    11178   MAIN-BLOCK:
    11179   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    11180       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
    11181   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11182   on ' ' of Date-Start in frame d-order
    11183   do:
    11184     if (can-query (self, "sensitive")
    11185        and
    11186        self :sensitive = true
    11187        )
    11188     or (can-query (self, "read-only")
    11189        and
    11190        self :read-only = false
    11191        )
    11192     then do:
    11193       assign
    11194         self :screen-value = ?
    11195       .
    11196     end.
    11197     return no-apply.
    11198   end.
    11199   on delete-character of Date-Start in frame d-order
    11200   do:
    11201     if (can-query (self, "sensitive")
    11202        and
    11203        self :sensitive = true
    11204        )
    11205     or (can-query (self, "read-only")
    11206        and
    11207        self :read-only = false
    11208        )
    11209     then do:
    11210       assign
    11211         self :screen-value = ?
    11212       .
    11213     end.
    11214     return no-apply.
    11215   end.
    11216   on ctrl-d of Date-Start in frame d-order
    11217   do:
    11218     define variable v-curr-sv-date as date no-undo .
    11219     if (can-query (self, "sensitive")
    11220        and
    11221        self :sensitive = true
    11222        )
    11223     or (can-query (self, "read-only")
    11224        and
    11225        self :read-only = false
    11226        )
    11227     then do:
    11228       if self :handle <> focus :handle
    11229       then do:
    11230         apply "entry":u to self .
    11231       end.
    11232       run gbl/getcurdt.p
    11233         (output v-curr-sv-date
    11234         ) .
    11235       assign
    11236         self :screen-value = string(v-curr-sv-date) .
    11237       .
    11238     end.
    11239     return no-apply.
    11240   end.
    11241   on ctrl-b of Date-Start in frame d-order
    11242   do:
    11243     if (can-query (self, "sensitive")
    11244        and
    11245        self :sensitive = true
    11246        )
    11247     or (can-query (self, "read-only")
    11248        and
    11249        self :read-only = false
    11250        )
    11251     then do:
    11252       if self :handle <> focus :handle
    11253       then do:
    11254         apply "entry":u to self .
    11255       end.
    11256       define variable v-curr-sv-date as date no-undo .
    11257       define variable v-new-sv-date  as date no-undo .
    11258       assign
    11259         v-curr-sv-date = date(self :screen-value) no-error
    11260       .
    11261       if v-curr-sv-date = ?
    11262       then do:
    11263         run gbl/getcurdt.p
    11264           (output v-curr-sv-date
    11265           ) .
    11266       end.
    11267       if v-curr-sv-date <> ?
    11268       then do:
    11269         assign
    11270           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
    11271         .
    11272         assign
    11273           self :screen-value = string(v-new-sv-date) .
    11274         .
    11275       end.
    11276     end.
    11277     return no-apply .
    11278   end.
    11279   on ctrl-e of Date-Start in frame d-order
    11280   do:
    11281     if (can-query (self, "sensitive")
    11282        and
    11283        self :sensitive = true
    11284        )
    11285     or (can-query (self, "read-only")
    11286        and
    11287        self :read-only = false
    11288        )
    11289     then do:
    11290       if self :handle <> focus :handle
    11291       then do:
    11292         apply "entry":u to self .
    11293       end.
    11294       define variable v-curr-sv-date as date no-undo .
    11295       define variable v-new-sv-date  as date no-undo .
    11296       assign
    11297         v-curr-sv-date = date(self :screen-value) no-error
    11298       .
    11299       if v-curr-sv-date = ?
    11300       then do:
    11301         run gbl/getcurdt.p
    11302           (output v-curr-sv-date
    11303           ) .
    11304       end.
    11305       if v-curr-sv-date <> ?
    11306       then do:
    11307         run gbl/lastdate.p
    11308           (input  v-curr-sv-date
    11309           ,output v-new-sv-date
    11310           ).
    11311         assign
    11312           self :screen-value = string(v-new-sv-date) .
    11313         .
    11314       end.
    11315     end.
    11316     return no-apply .
