     9090                           gds-list.contract = buf_X_order.contract-prn-code .
     9091                           gds-list.contract-code = buf_X_order.contract-code .
     9092                       end.
     9093                   end.
     9094               end.
     9095               if bf_order.params <> "" then
     9096                   run crt-orderLine (
     9097                       input bf_order.params,
     9098                       input bf_order.doc-code,
     9099                       input bf_order.db-num,
     9100                       input table tt-gds-list) no-error .
     9101               for each ub.order-doc-attr no-lock where
     9102                   ub.order-doc-attr.db-num = buf_X_order.db-num and
     9103                   ub.order-doc-attr.doc-code = buf_X_order.doc-code and
     9104                   ub.order-doc-attr.attr-code <> "copyOrder":
     9105                   create bf_order-attr .
     9106                   bf_order-attr.doc-code = bf_order.doc-code .
     9107                   buffer-copy ub.order-doc-attr except doc-code to bf_order-attr .
     9108               end.
     9109               for each ub.order-line-attr no-lock where
     9110                   ub.order-line-attr.db-num   = buf_X_order.db-num and
     9111                   ub.order-line-attr.doc-code = buf_X_order.doc-code:
