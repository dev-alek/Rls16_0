      532   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   procedure gen-key-rec :
      534     define input  parameter p-tbl-name    as character no-undo.
      535     define input  parameter p-bh_tbl-name as handle    no-undo.
      536     define output parameter p-key-rec     as character no-undo.
      537     do
      538     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      539     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      540     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      541     :
      542       define variable fh               as handle    no-undo .
      543       define variable v-ok             as logical   no-undo .
      544       define variable v-inform         as character no-undo .
      545       define variable v-ind            as integer   no-undo .
      546       define variable v-idx-field-qnty as integer   no-undo .
      547       if p-tbl-name = ?
      548         or p-tbl-name = "":U
      549       then do:
      550         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      551       end.
      552       if not p-bh_tbl-name:available then do:
      553         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      554       end.
      555       assign
      556         p-key-rec = p-tbl-name
      557         v-inform  = p-bh_tbl-name:index-information(1)
      558         v-ind     = 2
      559       .
      560       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      561       on error undo, return error
      562       :
      563         assign
      564           v-inform = p-bh_tbl-name:index-information( v-ind )
      565           v-ind    = v-ind + 1
      566         .
      567       end.
      568       if v-inform = ?
      569         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      570         or entry( 3, v-inform, ",":U ) <> "1":U
      571       then do:
      572         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      573       end.
      574       else do:
      575         assign
      576           v-idx-field-qnty = num-entries( v-inform ) - 4
      577         .
      578         if v-idx-field-qnty < 2 then do:
      579           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      580         end.
      581         do v-ind = 1 to v-idx-field-qnty by 2
      582         on error undo, return error
      583         :
      584           assign
      585             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      586             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      587           .
      588         end.
      589       end.
      590       if p-key-rec = ? then do:
      591         assign
      592           p-key-rec = "":U
      593         .
      594         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      595       end.
      596     end.
      597     return.
      598   end procedure.
      599   procedure gen-where-keyr-tab :
      600     define input  parameter i-tableSerach as character no-undo.
      601     define input  parameter i-tablekey   as character  no-undo.
      602     define input  parameter p-key-rec    as character  no-undo.
      603     define input  parameter p-key-handle as handle     no-undo .
      604     define input  parameter p-db-name    as character  no-undo .
      605     define input  parameter p-tt-handle  as handle     no-undo .
      606     define output parameter o-Where      as character  no-undo.
      607     do
      608     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      609     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      610     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      611     :
      612       define variable v-full-tbl-name  as character no-undo .
      613       define variable bh_tbl-name      as handle    no-undo .
      614       define variable fh_key           as handle    no-undo .
      615       define variable fh_search        as handle    no-undo .
      616       define variable v-field-num      as integer   no-undo .
      617       define variable v-count-fld      as integer   no-undo .
      618       define variable v-inform         as character no-undo .
      619       define variable v-ind            as integer   no-undo .
      620       define variable v-idx-field-qnty as integer   no-undo .
      621       define variable v-field-name     as character no-undo .
      622       define variable v-field-val      as character no-undo .
      623       define variable v-word-link      as character no-undo .
      624       define variable vTable           as character no-undo.
      625       define variable bh_tbl-key       as handle    no-undo .
      626       assign
      627         p-key-rec = trim( p-key-rec )
      628       .
      629       if p-key-handle <> ? then do:
      630         if not valid-handle(p-key-handle)
      631            or p-key-handle:type <> "buffer"
      632         then do:
      633           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      634         end.
      635         if num-entries( p-key-rec, chr(3) ) > 1
      636           or p-key-rec = ?
      637           or p-key-rec = "":U
      638         then do:
      639           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      640         end.
      641       end.
      642       else do:
      643         if p-key-rec = ?
      644           or p-key-rec = "":U
      645         then do:
      646           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      647         end.
      648       end.
      649       assign
      650         vTable = entry( 1 , p-key-rec, chr(3) )
      651       .
      652       if p-tt-handle <> ?
      653         and ( not valid-handle(p-tt-handle)
      654               or p-tt-handle:type <> "buffer"
      655             )
      656       then do:
      657         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      658       end.
      659       if p-tt-handle = ? then do:
      660         assign
      661           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      662         .
      663         create buffer bh_tbl-name for table v-full-tbl-name .
      664       end.
      665       else do:
      666         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      667       end.
      668       assign
      669         v-inform = bh_tbl-name:index-information(1)
      670         v-ind    = 2
      671       .
      672       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      673       on error undo, return error
      674       :
      675         assign
      676           v-inform = bh_tbl-name:index-information( v-ind )
      677           v-ind    = v-ind + 1
      678         .
      679       end.
      680       if v-inform = ?
      681         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      682         or entry( 3, v-inform, ",":U ) <> "1":U
      683       then do:
      684         delete object bh_tbl-name no-error.
      685         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      686       end.
      687       assign
      688         v-idx-field-qnty = num-entries( v-inform ) - 4
      689       .
      690       if v-idx-field-qnty < 2 then do:
      691         delete object bh_tbl-name no-error.
      692         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      693       end.
      694       assign
      695         o-where     = "where":U
      696         v-word-link = "":U
      697         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      698         v-count-fld = 0
      699       .
      700       if i-tablekey ne "" and i-tablekey ne ?
      701       then do:
      702         assign
      703           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      704         .
      705         create buffer bh_tbl-key for table v-full-tbl-name .
      706       end.
      707       if i-tableSerach ne "" and i-tableSerach ne ?
      708       then do:
      709         delete object bh_tbl-name no-error.
      710         assign
      711           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      712         .
      713         create buffer bh_tbl-name for table v-full-tbl-name .
      714       end.
      715       block_where:
      716       do v-ind = 1 to v-idx-field-qnty by 2
      717       on error undo, return error
      718       :
      719         assign
      720           v-count-fld = v-count-fld + 1
      721         .
      722         if p-key-handle = ?
      723           and v-count-fld > v-field-num
      724         then do:
      725           leave block_where.
      726         end.
      727         define variable VfieldKeyTable as handle no-undo.
      728         assign
      729           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      730           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      731         .
      732         if     bh_tbl-key ne ?
      733         then do:
      734            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      735            if VfieldKeyTable eq ?
      736            then next block_where.
      737         end.
      738         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      739         then
      740            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      741         else
      742            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      743         if p-key-handle = ? then do:
      744           assign
      745             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      746           .
      747         end.
      748         else do:
      749           assign
      750             fh_key = p-key-handle:buffer-field( v-field-name )
      751           .
      752           if fh_key = ?
      753             or not valid-handle( fh_key )
      754           then do:
      755             delete object bh_tbl-name.
      756             if     bh_tbl-key ne ?
      757             then
      758                delete object bh_tbl-key.
      759             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      760           end.
      761           assign
      762             v-field-val = fh_key:buffer-value
      763           .
      764         end.
      765         if fh_search:data-type ="character":U then do:
      766           assign
      767             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      768             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      769             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      770             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      771             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      772             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      773             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      774             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      775             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      776             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      777             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      778             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      779             v-field-val = substitute( '"&1"', v-field-val )
      780           .
      781         end.
      782         assign
      783           o-where = substitute( "&1 &2", o-where, v-field-val )
      784         .
      785         if v-word-link = "":U then do:
      786           assign
      787             v-word-link = "and":U
      788           .
      789         end.
      790       end.
      791       delete object bh_tbl-name.
      792       if     bh_tbl-key ne ?
      793       then
      794          delete object bh_tbl-key.
      795       if p-key-handle = ?
      796         and v-count-fld <> v-field-num
      797       then do:
      798         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
      799       end.
      800     end.
      801   end procedure.
      802   procedure gen-hn-keyr-tab :
      803     define input  parameter i-tableSerach as character no-undo.
      804     define input  parameter i-tablekey   as character no-undo.
      805     define input  parameter p-key-rec    as character no-undo.
      806     define input  parameter p-key-handle as handle    no-undo .
      807     define input  parameter p-db-name    as character no-undo .
      808     define input  parameter p-tt-handle  as handle    no-undo .
      809     define input  parameter p-stts-lock  as integer   no-undo .
      810     define output parameter o-hn         as handle    no-undo.
      811     define variable v-full-tbl-name as character no-undo.
      812     define variable v-where         as character no-undo.
      813     define variable bh_tbl-name     as handle    no-undo.
      814     define variable vTable          as character no-undo.
      815     do
      816     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      817     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      818     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      819         run gen-where-keyr-tab(i-tableSerach,
      820                                i-tablekey,
      821                                p-key-rec,
      822                                p-key-handle,
      823                                p-db-name,
      824                                p-tt-handle,
      825                                output v-where).
      826         if i-tableSerach ne "" and i-tableSerach ne ?
      827         then do:
      828            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      829            create buffer bh_tbl-name for table v-full-tbl-name .
      830         end.
      831         else do:
      832            if p-tt-handle = ? then do:
      833               assign
      834                  vTable = entry( 1 , p-key-rec, chr(3) )
      835               .
      836               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      837               create buffer bh_tbl-name for table v-full-tbl-name .
      838            end.
      839            else do:
      840               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      841            end.
      842         end.
      843         if p-tt-handle = ? then do:
      844            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      845         end.
      846         else do:
      847            bh_tbl-name:find-first( v-where ) no-error .
      848         end.
      849         o-hn = bh_tbl-name.
      850      end.
      851   end procedure.
      852   procedure gen-hn-keyr :
      853     define input  parameter p-key-rec    as character no-undo.
      854     define input  parameter p-key-handle as handle    no-undo .
      855     define input  parameter p-db-name    as character no-undo .
      856     define input  parameter p-tt-handle  as handle    no-undo .
      857     define input  parameter p-stts-lock  as integer   no-undo .
      858     define output parameter o-hn         as handle    no-undo.
      859     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      860   end.
      861   procedure gen-row-keyr :
      862     define input  parameter p-key-rec    as character no-undo.
      863     define input  parameter p-key-handle as handle    no-undo .
      864     define input  parameter p-db-name    as character no-undo .
      865     define input  parameter p-tt-handle  as handle    no-undo .
      866     define input  parameter p-stts-lock  as integer   no-undo .
      867     define output parameter p-tbl-row    as rowid     no-undo.
      868     define output parameter p-tbl-name   as character no-undo.
      869     define variable vHn as handle no-undo.
      870       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      871       p-tbl-row = if vHn:available then vHn:rowid else ?.
      872       p-tbl-name =  vHn:table.
      873       delete object vHn no-error.
      874     if p-tbl-row = ? then do:
      875       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
      876     end.
      877     else do:
      878       return.
      879     end.
      880   end procedure.
      881   procedure gen-key-fv :
      882     define input  parameter p-key-rec    as character no-undo .
      883     define output parameter p-field-list as character no-undo .
      884     define output parameter p-value-list as character no-undo.
      885     do
      886     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      887     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      888     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      889     :
      890       define variable v-full-tbl-name  as character no-undo .
      891       define variable bh_tbl-name      as handle    no-undo .
      892       define variable v-tbl-name       as character no-undo .
      893       define variable v-field-num      as integer   no-undo .
      894       define variable v-count-fld      as integer   no-undo .
      895       define variable v-inform         as character no-undo .
      896       define variable v-ind            as integer   no-undo .
      897       define variable v-idx-field-qnty as integer   no-undo .
      898       define variable v-delim-key      as character no-undo .
      899       if p-key-rec = ?
      900         or p-key-rec = "":U
      901       then do:
      902         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      903       end.
      904       assign
      905         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      906         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      907       .
      908       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      909       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
      910       assign
      911         v-inform = bh_tbl-name:index-information(1)
      912         v-ind    = 2
      913       .
      914       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      915       on error undo, return error
      916       :
      917         assign
      918           v-inform = bh_tbl-name:index-information( v-ind )
      919           v-ind    = v-ind + 1
      920         .
      921       end.
      922       if v-inform = ?
      923         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      924         or entry( 3, v-inform, ",":U ) <> "1":U
      925       then do:
      926         delete object bh_tbl-name no-error.
      927         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
      928       end.
      929       assign
      930         v-idx-field-qnty = num-entries( v-inform ) - 4
      931       .
      932       if v-idx-field-qnty < 2 then do:
      933         delete object bh_tbl-name no-error.
      934         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
      935       end.
      936       assign
      937         p-field-list = "":U
      938         p-value-list = "":U
      939         v-delim-key  = "":U
      940         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      941         v-count-fld  = 0
      942       .
      943       block_where:
      944       do v-ind = 1 to v-idx-field-qnty by 2
      945       on error undo, return error
      946       :
      947         assign
      948           v-count-fld = v-count-fld + 1
      949         .
      950         if v-count-fld > v-field-num then do:
      951           leave block_where.
      952         end.
      953         assign
      954           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      955           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      956         .
      957         if v-ind = 1 then do:
      958           assign
      959             v-delim-key = chr(3)
      960           .
      961         end.
      962       end.
      963       delete object bh_tbl-name.
      964       if v-count-fld <> v-field-num then do:
      965         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
      966       end.
      967     end.
      968   end procedure.
      969   procedure gen-key-field :
      970     define input  parameter p-table      as character no-undo .
      971     define output parameter p-field-list as character no-undo .
      972     do
      973     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      974     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      975     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      976     :
      977       define variable v-full-tbl-name  as character no-undo .
      978       define variable bh_tbl-name      as handle    no-undo .
      979       define variable v-tbl-name       as character no-undo .
      980       define variable v-field-num      as integer   no-undo .
      981       define variable v-count-fld      as integer   no-undo .
      982       define variable v-inform         as character no-undo .
      983       define variable v-ind            as integer   no-undo .
      984       define variable v-idx-field-qnty as integer   no-undo .
      985       define variable v-delim-key      as character no-undo .
      986       if p-table = ?
      987         or p-table = "":U
      988       then do:
      989         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
      990       end.
      991       assign
      992         v-tbl-name      = p-table
      993         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      994       .
      995       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      996       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
      997       assign
      998         v-inform = bh_tbl-name:index-information(1)
      999         v-ind    = 2
     1000       .
     1001       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1002       on error undo, return error
     1003       :
     1004         assign
     1005           v-inform = bh_tbl-name:index-information( v-ind )
     1006           v-ind    = v-ind + 1
     1007         .
     1008       end.
     1009       if v-inform = ?
     1010         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1011         or entry( 3, v-inform, ",":U ) <> "1":U
     1012       then do:
     1013         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1014       end.
     1015       assign
     1016         v-idx-field-qnty = num-entries( v-inform ) - 4
     1017       .
     1018       if v-idx-field-qnty < 2 then do:
     1019         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1020       end.
     1021       assign
     1022         p-field-list = "":U
     1023         v-delim-key  = "":U
     1024         v-count-fld  = 0
     1025       .
     1026       block_where:
     1027       do v-ind = 1 to v-idx-field-qnty by 2
     1028       on error undo, return error
     1029       :
     1030         assign
     1031           v-count-fld = v-count-fld + 1
     1032         .
     1033         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1034         if v-ind = 1 then do:
     1035           assign
     1036             v-delim-key = chr(3)
     1037           .
     1038         end.
     1039       end.
     1040       delete object bh_tbl-name.
     1041     end.
     1042   end procedure.
     1043   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   function getattrUtdex returns char
     1045   (idb-num   as integer,
     1046    idoc-id   as integer,
     1047    iattrcode as character,
     1048    iExValue  as character  ):
     1049      define buffer utd-attr for utd-attr.
     1050      find first utd-attr where utd-attr.db-num eq idb-num
     1051                            and utd-attr.doc-id eq idoc-id
     1052                            and utd-attr.attr-code eq iattrcode
     1053      no-lock no-error.
     1054      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1055   end.
     1056   function getattrUtd returns char
     1057   (idb-num   as integer,
     1058    idoc-id   as integer,
     1059    iattrcode as character ):
     1060     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1061   end.
     1062   function setattrUtd returns logical
     1063   (idb-num   as integer,
     1064    idoc-id   as integer,
     1065    iattrcode as character,
     1066    iattrval  as character ):
     1067      define buffer utd-attr for utd-attr.
     1068      find first utd-attr where utd-attr.db-num eq idb-num
     1069                            and utd-attr.doc-id eq idoc-id
     1070                            and utd-attr.attr-code eq iattrcode
     1071      no-lock no-error.
     1072      if not available utd-attr
     1073      then do:
     1074         create utd-attr.
     1075         assign
     1076            utd-attr.db-num    = idb-num
     1077            utd-attr.doc-id    = idoc-id
     1078            utd-attr.attr-code = iattrcode
     1079            utd-attr.attr-value = iattrval
     1080         .
     1081      end.
     1082      else do:
     1083         if utd-attr.attr-value ne iattrval
     1084         then do:
     1085            find current utd-attr exclusive-lock no-error.
     1086            if available utd-attr
     1087            then
     1088               utd-attr.attr-value = iattrval.
     1089         end.
     1090      end.
     1091      release utd-attr.
     1092   end.
     1093   function GetAttrUtdlinesEx returns char
