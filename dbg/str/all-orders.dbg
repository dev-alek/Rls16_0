      438   procedure sel-date :
      439     define input  parameter p-date-handle as handle    no-undo .
      440     define input  parameter p-description as character no-undo .
      441     do
      442     on error undo, return error return-value
      443     :
      444       if (can-query (p-date-handle, "sensitive")
      445         and
      446         p-date-handle :sensitive = true
      447         )
      448       or (can-query (p-date-handle, "read-only")
      449         and
      450         p-date-handle :read-only = false
      451         )
      452       then do:
      453         if p-date-handle :handle <> focus :handle
      454         then do:
      455           apply "entry":u to p-date-handle .
      456         end.
      457         define variable v-ok            as logical no-undo .
      458         define variable v-curr-sv-date as date no-undo .
      459         assign
      460           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      461         .
      462         if v-curr-sv-date = ?
      463         then do:
      464           run gbl/getcurdt.p
      465             (output v-curr-sv-date
      466             ) .
      467         end.
      468         if v-curr-sv-date <> ?
      469         then do:
      470           run gbl/d-inpday.w
      471             (input ?
      472             ,input "Выбор даты"
      473             ,input p-description
      474             ,input ""
      475             ,input-output v-curr-sv-date
      476             ,output v-ok
      477             ).
      478           if v-ok = true
      479           then do:
      480             assign
      481               p-date-handle :screen-value = string(v-curr-sv-date) .
      482             .
      483           end.
      484         end.
      485       end.
      486     end.
      487   end procedure.
