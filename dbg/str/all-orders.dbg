     9900   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9901   on help of frame d-order
     9902   do:
     9903     run gbl/app_help.p
     9904       (input this-procedure :file-name
     9905       ,input ''
     9906       ,input ?
     9907       ) no-error.
     9908     if error-status :error then do:
     9909       message
     9910         "Ошибка при вызове помощи"
     9911         error-status :get-message(1)
     9912         view-as alert-box .
     9913     end.
     9914   end.
     9915   run minbtn-set in this-procedure .
     9916   on choose of b-help in frame d-order
     9917   do:
     9918     apply "help":u to frame d-order .
     9919   end.
     9920   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9921   procedure minbtn-set :
     9922       do
     9923           on error undo, return error return-value
     9924           :
     9925           define variable ii              as integer       no-undo .
     9926           define variable fh              as widget-handle no-undo .
     9927           define variable hh              as widget-handle no-undo .
     9928           define variable v-h             as handle        extent 4 no-undo .
     9929           define variable v-name-button   as character     no-undo .
     9930           define variable v-help-old-x    as decimal       no-undo .
     9931           define variable v-help-old-y    as decimal       no-undo .
     9932           define variable v-help-old-size as decimal       no-undo .
     9933           define variable v-frame-width   as decimal       no-undo .
     9934           define variable jj              as integer       no-undo .
     9935           do
     9936               on error undo, return error
     9937               :
     9938               assign
     9939                   v-frame-width = frame d-order:width - 0.3
     9940                   fh            = frame d-order:first-child
     9941                   hh            = fh:first-child
     9942                   ii            = 1
     9943                   .
     9944               do while valid-handle(hh):
     9945                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     9946                   do:
     9947                       case lc(hh:name) :
     9948                           when "b-help" then
     9949                               do:
     9950                                   hh:load-image-up("cmp/b-help.bmp":u) .
     9951                                   hh:load-image-down("cmp/b-help.bmp":u) .
     9952                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     9953                                   hh:TOOLTIP = "Помощь" .
     9954                                   v-help-old-x = hh:column .
     9955                                   v-help-old-y = hh:row    .
     9956                                   v-help-old-size = hh:width .
     9957                                   hh:width-chars = 2.5 .
     9958                               end.
     9959                           when "b-print" then
     9960                               do:
     9961                                   hh:load-image("cmp/b-print.bmp":u) .
     9962                                   hh:TOOLTIP = "Печать" .
     9963                                   v-h[ii] = hh:handle .
     9964                                   ii = ii + 1 .
     9965                                   hh:width-chars = 3 .
     9966                               end.
     9967                           when "b-history" or
     9968                           when "b-hist" then
     9969                               do:
     9970                                   hh:load-image("cmp/b-hist.bmp":u) .
     9971                                   hh:TOOLTIP = "История" .
     9972                                   v-h[ii] = hh:handle .
     9973                                   ii = ii + 1 .
     9974                                   hh:width-chars = 3 .
     9975                               end.
     9976                           when "b-sch" then
     9977                               do:
     9978                                   hh:load-image("cmp/b-sch.bmp":u) .
     9979                                   hh:TOOLTIP = "Установка Фильтра" .
     9980                                   v-h[ii] = hh:handle .
     9981                                   ii = ii + 1 .
     9982                                   hh:width-chars = 3 .
     9983                               end.
     9984                           when "b-hist-user" then
     9985                               do:
     9986                                   hh:load-image("cmp/b-hist.bmp":u) .
     9987                                   hh:TOOLTIP = "История пользователя" .
     9988                                   ii = ii + 1 .
     9989                               end.
     9990                       end case.
     9991                   end.
     9992                   hh = hh:next-sibling.
     9993               end.
     9994               b-help:column = v-frame-width - b-help:width-chars.
     9995               jj = 0.
     9996               repeat ii = 4 to 1 by -1 :
     9997                   if valid-handle (v-h[ii] ) then
     9998                   do:
     9999                       jj  = jj + 1 .
    10000                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    10001                       v-h[ii]:row    = v-help-old-y .
    10002                   end.
    10003               end.
    10004           end.
    10005       end.
    10006   end procedure.
    10007   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    10008   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    10009   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    10010   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    10011   define variable v-diasize-current-frame-width  as decimal   no-undo .
    10012   define variable v-diasize-current-frame-height as decimal   no-undo .
    10013   define variable v-diasize-change-size          as logical   no-undo .
    10014   define variable v-diasize-resize-button        as handle    no-undo .
    10015   define variable v-diasize-wndmax               as logical   no-undo .
    10016   define variable v-diasize-wndstore             as logical   no-undo .
    10017   define variable v-diasize-proc-name            as character no-undo .
    10018   define variable v-diasize-browse-handle        as handle    no-undo .
    10019   define variable v-diasize-browse-number        as integer   no-undo .
    10020   define variable v-diasize-need-full-display    as logical   no-undo init false .
    10021   define temp-table temp-diasize-handle no-undo
    10022     field handle-value  as handle
    10023     field save-position as decimal
    10024     index xpk is primary unique handle-value
    10025     .
    10026   define temp-table temp-browse-handle no-undo
    10027     field browse-type   as character
    10028     field browse-number as integer
    10029     field browse-handle as handle
    10030     field original-size as decimal
    10031     index xpk is primary unique browse-type browse-number
    10032     index xie browse-type browse-handle
    10033   .
    10034   procedure diasize_change-height :
    10035     define input  parameter p-change-value  as decimal   no-undo .
    10036     define input  parameter p-move-resize   as logical   no-undo .
    10037     define variable v-field-group-handle    as handle    no-undo .
    10038     define variable v-object-handle         as handle    no-undo .
    10039     define variable v-frame-height          as decimal   no-undo .
    10040     define variable v-frame-virtual-height  as decimal   no-undo .
    10041     define variable v-browse-height         as decimal   no-undo .
    10042     define variable v-window-height         as decimal   no-undo .
    10043     define variable v-window-virtual-height as decimal   no-undo .
    10044     define variable v-change-sign           as integer   no-undo .
    10045     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    10046     define buffer buf_temp-browse-handle  for temp-browse-handle .
    10047     if p-change-value > 0
    10048     then do:
    10049       if frame d-order :height + p-change-value
    10050           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    10051       then do:
    10052         assign
    10053           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    10054                           - (frame d-order :height-chars)
    10055         .
    10056         if p-change-value <= 0
    10057         then do:
    10058           run diasize_position-resize-button in this-procedure .
    10059           return .
    10060         end.
    10061       end.
    10062     end.
    10063     if p-change-value < 0
    10064     then do:
