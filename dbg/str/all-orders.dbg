     9316   ON CHOOSE OF b-mark IN FRAME d-order
     9317       DO:
     9318           define variable loc#log as logical no-undo .
     9319           if available X_order then
     9320           do:
     9321   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9322   define variable v-str-recid24 as character no-undo .
     9323   define variable v-num-entry24 as integer   no-undo .
     9324   assign
     9325     v-str-recid24 = trim( string( recid( X_order ) , "->>>>>>>>>>>9":U ) )
     9326     v-num-entry24 = lookup( v-str-recid24 , v-rid-list )
     9327   .
     9328   if v-num-entry24 > 0 then do:
     9329     assign
     9330       entry( v-num-entry24, v-rid-list ) = "":U
     9331       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     9332     .
     9333   end.
     9334   else do:
     9335     assign
     9336       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid24
     9337     .
     9338   end.
     9339               row_order = rowid(X_order).
     9340               loc#log = br-order:refresh() .
     9341               reposition br-order to rowid row_order.
     9342               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     9343               do:
     9344                   loc#log = br-order:select-next-row ().
     9345                   apply "VALUE-CHANGED" to br-order in frame d-order.
     9346               end.
     9347               if num-entries( v-rid-list ) = 0 then
     9348               do:
     9349                   hide mark-num in frame d-order.
     9350                   enable b-copy with frame d-order .
     9351               end.
     9352               else
     9353               do:
     9354                   if num-entries (v-rid-list) > 1 then disable b-copy with frame d-order .
     9355                   else enable b-copy with frame d-order .
     9356                   display
     9357                       num-entries( v-rid-list ) @ mark-num
     9358                       with frame d-order.
     9359               end.
     9360           end.
     9361           apply "entry" to br-order in frame d-order.
     9362       END.
