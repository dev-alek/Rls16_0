     8936       b-send AT ROW 1 COL 61.5 WIDGET-ID 30
     8937       b-reset AT ROW 1 COL 71.5 WIDGET-ID 30
     8938       b-sch AT ROW 1 COL 114 WIDGET-ID 16
     8939       b-help AT ROW 1 COL 121 WIDGET-ID 18
     8940       b-hist AT ROW 1 COL 128 WIDGET-ID 18
     8941       b-date-Start AT ROW 2.46 COL 26.13 WIDGET-ID 252
     8942       date-Start AT ROW 2.5 COL 13.13 COLON-ALIGNED WIDGET-ID 238
     8943       Date-End AT ROW 2.5 COL 32.5 COLON-ALIGNED WIDGET-ID 36
     8944       b-date-End AT ROW 2.5 COL 45.75 WIDGET-ID 250
     8945       c-status AT ROW 2.5 COL 97 COLON-ALIGNED WIDGET-ID 228
     8946       b-cli AT ROW 3.61 COL 26.13 WIDGET-ID 240
     8947       statusNotif AT ROW 1 COL 99 WIDGET-ID 240
     8948       cli-code AT ROW 3.67 COL 13.13 COLON-ALIGNED WIDGET-ID 244
     8949       cli-type AT ROW 3.67 COL 27.75 COLON-ALIGNED NO-LABEL WIDGET-ID 248
     8950       cli-name AT ROW 3.67 COL 80.5 RIGHT-ALIGNED NO-LABEL WIDGET-ID 246
     8951       num-order AT ROW 3.67 COL 97 COLON-ALIGNED WIDGET-ID 254
     8952       num-contract AT ROW 4.79 COL 97 COLON-ALIGNED WIDGET-ID 256
     8953       r-goods AT ROW 4.96 COL 15.38 NO-LABEL WIDGET-ID 260
     8954       bt-no-sel-all AT ROW 6 COL 5 WIDGET-ID 22 NO-TAB-STOP
     8955       bt-not-sel-desel-all AT ROW 6 COL 8 WIDGET-ID 24 NO-TAB-STOP
     8956       b-mark AT ROW 6 COL 11 WIDGET-ID 26 NO-TAB-STOP
     8957       f-mark AT ROW 6 COL 13.13 COLON-ALIGNED NO-LABEL WIDGET-ID 258
     8958       b-markGoods AT ROW 6 COL 71.5 WIDGET-ID 266
     8959       br-order AT ROW 7 COL 1.5 WIDGET-ID 200
     8960       mark-num AT ROW 6 COL 1 NO-LABEL WIDGET-ID 20
     8961       SPACE(127.12) SKIP(23.10)
     8962       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     8963       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     8964       TITLE "Реестр заказов" WIDGET-ID 100.
     8965   ASSIGN
     8966       FRAME d-order:SCROLLABLE = FALSE
     8967       FRAME d-order:HIDDEN     = TRUE.
     8968   ASSIGN
     8969       br-order:COLUMN-RESIZABLE IN FRAME d-order = TRUE.
     8970   ON WINDOW-CLOSE OF FRAME d-order
     8971       DO:
     8972           APPLY "END-ERROR":U TO SELF.
     8973       END.
     8974   ON CHOOSE OF b-add IN FRAME d-order
     8975       DO:
     8976           define variable varlog as logical no-undo .
     8977   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8978   do:
     8979     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8980       (input  v-cntxt-db-num
     8981       ,input  v-cntxt-userid
     8982       ,input  0
     8983       ,input  'actn_pmnt-ord-doc_add-def':U
     8984       ,input  'object':U
     8985       ,input  v-cntxt-host-code-obj
     8986       ,input  v-cntxt-obj-type
     8987       ,input  v-cntxt-obj-code
     8988       ,input  0
     8989       ,input  0
     8990       ,input  0
     8991       ,input  true
     8992       ,output varlog
     8993       )  .
     8994   end.
     8995           if not varlog then return no-apply .
     8996           run rep/g-rsrvPlan.p (parparentproc, yes) no-error .
     8997           run init-sort .
     8998       END.
     8999   ON CHOOSE OF b-cli IN FRAME d-order
     9000       DO:
     9001           define variable v-types   as character no-undo .
     9002           define variable ref-list  as character no-undo .
     9003           define variable ref-rec   as integer   no-undo .
     9004           def    var      supp-type as character no-undo.
     9005           run ref/cli-all.w (parparentproc
     9006               , "b-sel,b-add"
     9007               , ?
     9008               , ?
     9009               , ?
     9010               , ?
     9011               , ?
     9012               , ?
     9013               , output ref-list) .
     9014           if ref-list <> "" then
     9015           do:
     9016               ref-rec = integer (ref-list).
     9017               find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     9018               assign
     9019                   cli-code = string(ub.clients.obj-code)
     9020                   cli-type = ub.clients.obj-type
     9021                   cli-name = ub.clients.obj-name
     9022                   .
     9023               display cli-code with frame d-order.
     9024               display ub.clients.obj-type @ cli-type with frame d-order.
     9025               display ub.clients.obj-name @ cli-name with frame d-order .
     9026               v-cli = true .
     9027               run init-sort .
     9028           end.
     9029       END.
     9030   ON CHOOSE OF b-copy IN FRAME d-order
     9031       DO:
