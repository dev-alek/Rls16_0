    11627   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11628   do:
    11629     br-order :SET-REPOSITIONED-ROW(9, "CONDITIONAL") .
    11630   end.
    11631   find first db-attr no-lock where db-attr.db-num = v-cntxt-db-num and
    11632       db-attr.attr-code = "orderStatusNitif" no-error .
    11633   if not available (db-attr) then statusNotif = true .
    11634   else statusNotif = logical (db-attr.attr-value) .
    11635   StatusOrder =  new ibs.th.str.order.sts.order().
    11636   Date-Start = today - 14 .
    11637   Date-End = today .
    11638   for each buf_order exclusive-lock where buf_order.obj-code = v-cntxt-obj-code and
    11639       buf_order.obj-type = v-cntxt-obj-type and
    11640       buf_order.db-num = v-cntxt-db-num and
    11641       buf_order.sts = StatusOrder:NewStatus:KeyIntDB and
    11642       buf_order.doc-date < datetime (today - 1):
    11643       delete buf_order .
    11644   end.
    11645   for each buf_order no-lock where buf_order.obj-code = v-cntxt-obj-code and
    11646       buf_order.obj-type = v-cntxt-obj-type and
    11647       buf_order.db-num = v-cntxt-db-num:
    11648       create X_order .
    11649       buffer-copy buf_order to X_order .
    11650   end.
    11651   extent (bcol) = ?.
    11652   hbrowse = browse br-order:handle.
    11653   extent (bcol) = hbrowse:num-columns.
    11654   bcol[1] = hbrowse:first-column.
    11655   do ii = 1 to extent (bcol).
    11656       bcol[ii] = hbrowse:get-browse-column (ii).
    11657   end.
    11658   run init-temp .
    11659   RUN enable_UI.
    11660   run init-sort .
    11661   WAIT-FOR GO OF FRAME d-order.
    11662   END.
    11663   RUN disable_UI.
    11664   PROCEDURE init-temp :
    11665       define variable ii         as integer   no-undo .
    11666       define variable Status_    as character no-undo .
    11667       define variable Status_EDI as character no-undo .
    11668       define variable Edoc_type  as character no-undo .
    11669       Status_ = "Все" + chr(44) + '-1':U .
    11670       do ii = 1 to StatusOrder:mapType:GetItemByLab(ii):
    11671           if StatusOrder:CurrProp:KeyIntDB >= 50
    11672               and StatusOrder:CurrProp:KeyIntDB < 60
    11673               then next .
    11674           Status_ = Status_ + chr(44) + StatusOrder:CurrProp:Label_ + chr(44) + string(StatusOrder:CurrProp:KeyIntDB) .
    11675       end.
    11676       ASSIGN
    11677           c-status:LIST-ITEM-PAIRS  in frame d-order = Status_ .
    11678       c-status = "-1" .
    11679   END PROCEDURE.
    11680   PROCEDURE disable_UI :
    11681       HIDE FRAME d-order.
    11682   END PROCEDURE.
    11683   PROCEDURE enable_UI :
    11684       DISPLAY date-Start Date-End c-status cli-code cli-type cli-name num-order
    11685           num-contract r-goods f-mark mark-num statusNotif
    11686           WITH FRAME d-order.
    11687       ENABLE b-exit b-add b-update b-lookup b-copy b-del b-send b-reset b-sch
    11688           b-help b-hist b-date-Start date-Start Date-End b-date-End c-status statusNotif
    11689           b-cli cli-code cli-type cli-name num-order num-contract r-goods b-mark
    11690           f-mark b-markGoods br-order mark-num bt-not-sel-desel-all bt-no-sel-all
    11691           WITH FRAME d-order.
    11692       hide b-markGoods b-sch b-sel in frame d-order .
    11693       VIEW FRAME d-order.
    11694       OPEN QUERY br-order FOR EACH X_order no-lock by X_order.doc-code desc INDEXED-REPOSITION.
    11695   END PROCEDURE.
    11696   PROCEDURE init-sort :
    11697       define variable vInt      as logical   no-undo.
    11698       define variable vi        as integer   no-undo.
    11699       define variable vGdsCode  as integer   no-undo.
    11700       define variable vGtin     as character no-undo.
    11701       define variable vMark     as character no-undo.
    11702       define variable vMarkGtin as character no-undo.
    11703       define variable vGdsName  as character no-undo .
    11704       define variable vOkGoods  as logical   no-undo .
    11705       define variable vDbNumCur as integer   no-undo.
    11706       define variable vCodeCur  as integer   no-undo.
    11707       define buffer goods       for ub.goods.
    11708       define buffer bar-code    for ub.bar-code.
    11709       define buffer prod-bc     for ub.prod-bc.
    11710       define buffer marking     for ub.marking .
    11711       define buffer order-line  for ub.order-line .
    11712       define buffer buf_X_order for X_order .
    11713       if avail X_order then
    11714           assign
    11715               vDbNumCur = X_order.db-num
    11716               vCodeCur  = X_order.doc-code
    11717               .
    11718       for each X_order:
    11719           delete X_order .
    11720       end.
    11721       mark-num = 0.
    11722       display mark-num with frame d-order.
    11723       hide mark-num in frame d-order.
    11724       for each buf_order no-lock where buf_order.obj-code = v-cntxt-obj-code and
    11725           buf_order.obj-type = v-cntxt-obj-type and
    11726           buf_order.db-num = v-cntxt-db-num:
    11727           create X_order .
    11728           buffer-copy buf_order to X_order .
    11729       end.
    11730       if f-mark <> "" then
    11731       do:
    11732           case r-goods:
    11733               when 0 then
    11734                   do:
    11735                       int(f-mark) no-error.
    11736                       vInt = not error-status:error.
    11737                       if vInt
    11738                           then
    11739                           find first goods where goods.gds-code eq int(f-mark) no-lock no-error.
    11740                       if available goods
    11741                           then
    11742                       do:
    11743                           vGdsCode  = goods.gds-code.
    11744                       end.
    11745                       else
    11746                       do:
    11747                           if vInt
    11748                               then
    11749                               find first bar-code where bar-code.b-code eq int(f-mark) no-lock no-error.
    11750                           if available bar-code
    11751                               then
    11752                           do:
    11753                               vGdsCode  = bar-code.gds-code.
    11754                           end.
    11755                           else
    11756                           do:
    11757                               block-fill:
    11758                               do vi = 0 to 10:
    11759                                   find first prod-bc where prod-bc.b-str eq fill("0",vi) + f-mark no-lock no-error.
    11760                                   if available prod-bc
    11761                                       then
    11762                                       leave block-fill.
    11763                               end.
    11764                               if available prod-bc
    11765                                   then
    11766                               do:
    11767                                   if prod-bc.bc-on-type = 'GTIN':U
    11768                                       then
    11769                                       vGdsCode = prod-bc.b-code.
    11770                                   else
    11771                                   do:
    11772                                       find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
    11773                                       if available bar-code
    11774                                           then
    11775                                           vGdsCode  = bar-code.gds-code.
    11776                                   end.
    11777                               end.
    11778                               else
    11779                               do:
    11780                                   vMark     = getcodeident(f-mark).
    11781                                   vMarkGtin = getGtinByDM (f-mark).
    11782                                   if vMark = ? and vMarkGtin = "" then
    11783                                   do:
    11784                                       for each X_order:
    11785                                           delete X_order .
    11786                                       end.
    11787                                   end.
    11788                               end.
    11789                           end.
    11790                       end.
    11791                   end.
    11792               otherwise
    11793               do:
    11794                   vGdsName = prep-nameorcode(f-mark) .
    11795               end.
    11796           end case .
    11797       end.
    11798       if vMark <> ""
    11799           then
    11800       do:
    11801           find first marking where marking.mark     begins vMark
    11802               no-lock no-error.
    11803           if not available marking
    11804               then
    11805               find first marking where marking.mark     begins "02" + vMarkGtin + "37"
    11806                   no-lock no-error.
    11807           if available marking
    11808               then
    11809           do :
    11810               vGdsCode = marking.gds-code .
    11811           end .
    11812       end.
    11813       if vGdsCode <> 0 then
    11814       do:
    11815           for each X_order:
    11816               find first order-line where order-line.db-num  = X_order.db-num
    11817                   and order-line.doc-code   = X_order.doc-code
    11818                   and order-line.gds-code = vGdsCode
    11819                   no-lock no-error.
    11820               if available (order-line) then next .
    11821               else delete X_order .
    11822           end.
    11823       end.
    11824       if vGdsName <> "" then
    11825       do:
    11826           for each X_order:
    11827               vOkGoods = false .
    11828               for each order-line where order-line.db-num  = X_order.db-num
    11829                   and order-line.doc-code   = X_order.doc-code no-lock,
    11830                   first goods where goods.gds-code = order-line.gds-code and
    11831                   goods.gds-name contains vGdsName no-lock :
    11832                   vOkGoods = true .
    11833                   leave .
    11834               end.
    11835               if not vOkGoods then delete X_order .
    11836           end.
    11837       end.
    11838       if num-contract <> "" then
    11839       do:
    11840           for each X_order :
    11841               if X_order.contract-prn-code begins num-contract then next .
    11842               else delete X_order .
    11843           end.
    11844       end.
    11845       if c-status <> "-1" then
    11846       do:
    11847           for each X_order where X_order.sts <> integer(c-status):
    11848               delete X_order .
    11849           end.
    11850       end.
    11851       if date-Start <> ? and Date-End <> ? then
    11852       do:
    11853           for each X_order where date-Start > date(X_order.doc-date) or Date-End < date(X_order.doc-date):
    11854               delete X_order .
    11855           end.
    11856       end.
    11857       if v-cli then
    11858       do:
    11859           for each X_order where X_order.cli-code <> integer(cli-code) and X_order.cli-type = cli-type :
    11860               delete X_order .
    11861           end.
    11862       end.
    11863       else
    11864       do:
    11865           if cli-code <> "" then
    11866           do:
    11867               for each X_order where X_order.cli-code <> integer(cli-code):
    11868                   delete X_order .
    11869               end.
    11870           end.
    11871           if cli-name <> "" then
    11872           do:
    11873               for each X_order :
    11874                   if X_order.cli-name begins cli-name then next .
    11875                   else delete X_order .
    11876               end.
    11877           end.
    11878       end.
    11879       if num-order <> "" then
    11880       do:
    11881           for each X_order:
    11882               if string(X_order.order-item) begins num-order then next .
    11883               else delete X_order .
    11884           end.
    11885       end.
    11886       v-cli = false .
    11887       apply "CHOOSE":U to bt-not-sel-desel-all IN FRAME d-order.
    11888       OPEN QUERY br-order FOR EACH X_order no-lock by X_order.doc-code desc INDEXED-REPOSITION.
    11889       br-order:refresh () in frame d-order no-error .
    11890       if vCodeCur <> 0 then
    11891           find first buf_X_order no-lock where
    11892               buf_X_order.db-num   = vDbNumCur
    11893               and buf_X_order.doc-code = vCodeCur
    11894               no-error.
    11895       if avail buf_X_order then do:
    11896           reposition br-order to rowid rowid(buf_X_order).
    11897           if buf_X_order.sts = StatusOrder:NewStatus:KeyIntDB then
    11898           do:
    11899               enable b-del with frame d-order .
    11900           end.
    11901           else disable b-del with frame d-order .
    11902       end .
    11903       else do:
    11904           reposition br-order to row 1.
    11905           enable b-del with frame d-order .
    11906       end.
    11907   END PROCEDURE.
    11908   FUNCTION cli-name RETURNS character
    11909       (cli-code as integer, cli-type as character ):
    11910       define variable v-cli-name as character no-undo.
    11911       find first ub.clients no-lock where ub.clients.obj-code = cli-code and
    11912           ub.clients.obj-type = cli-type no-error .
    11913       if available (ub.clients) then
    11914       do:
    11915           v-cli-name = ub.clients.obj-name .
    11916       end.
    11917       return v-cli-name.
    11918   end function.
    11919   FUNCTION get-sts RETURNS character
    11920       (p-sts as integer ):
    11921       define variable v-sts as character no-undo.
    11922       v-sts = StatusOrder:GetLabel(p-sts) .
    11923       return v-sts.
    11924   end function.
    11925   FUNCTION num-doc RETURNS character
    11926       (p-doc-code as integer, p-db-num as integer):
    11927       return string(p-doc-code).
    11928   end function.
    11929   FUNCTION user-name RETURNS character
    11930       (p-user-id as character ):
    11931       define variable v-user-name as character no-undo.
    11932       find first ub.user-account no-lock where ub.user-account.user-id = p-user-id no-error .
    11933       if available (ub.user-account) then
    11934       do:
    11935           v-user-name = ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name .
    11936       end.
    11937       return v-user-name.
    11938   end function.
    11939   FUNCTION prep-nameorcode RETURNS CHARACTER
    11940       ( input p-nameorcode as character ) :
    11941       define variable v-nameorcode as character no-undo .
    11942       define variable nameorcode   as character no-undo .
    11943       if trim(p-nameorcode) = '' then  return ''.
    11944       v-nameorcode = trim( trim( p-NameOrCode) , "*" ) .
    11945       if index(v-NameOrCode, chr(34) ,1 ) = 1
    11946           and R-index(v-NameOrCode, chr(34) ,1 ) = 1 then
    11947       do:
    11948           assign
    11949               v-NameOrCode = trim(v-NameOrCode, chr(34))
    11950               .
    11951           nameorcode = v-nameorcode.
    11952       end.
    11953       define variable v-dopi as character no-undo .
    11954       assign
    11955           v-dopi = substring(v-NameOrCode, length(v-NameOrCode), 1)
    11956           .
    11957       if index("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя", v-dopi) > 0
    11958           or index("1234567890", v-dopi) > 0
    11959           then
    11960       do:
    11961           v-NameOrCode = v-NameOrCOde + "*".
    11962       end.
    11963       v-NameOrCode = LC(v-NameOrCode).
    11964       RETURN v-nameorcode.
    11965   END FUNCTION.
