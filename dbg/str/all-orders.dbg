     9608                       )  .
     9609                   run init-sort .
     9610               end.
     9611               else
     9612               do:
     9613                   message "Редактировать заказ можно только в статусе: 'Новый'"
     9614                       view-as alert-box.
     9615                   return .
     9616               end.
     9617           end.
     9618           else
     9619           do:
     9620               message "Не выбран заказ"
     9621                   view-as alert-box.
     9622               return no-apply .
     9623           end.
     9624           if X_order.sts = StatusOrder:NewStatus:KeyIntDB then
     9625           do:
     9626               enable b-del with frame d-order .
     9627           end.
     9628           else disable b-del with frame d-order .
     9629       END.
