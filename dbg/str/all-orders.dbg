     7664                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vExtendedInvoiceItem:Price:OriginalValue)).
     7665                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue)).
     7666                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vExtendedInvoiceItem:TaxRate:OriginalValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:OriginalValue,"/"),"%")))).
     7667                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vExtendedInvoiceItem:Vat:OriginalValue)).
     7668                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vExtendedInvoiceItem:Subtotal:OriginalValue)).
     7669                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"UnitCode_old", vExtendedInvoiceItem:UnitName:OriginalValue).
     7670                            end.
     7671                            vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7672                            getdesc(vunits).
     7673                            do vii = 1 to vunits:count:
     7674                               vunit = vunits:GETITEM(vii - 1).
     7675                               getdesc(vunit).
     7676                               if     vunit:Id eq "штрихкод"
     7677                                   or vunit:Id eq "ean"
     7678                               then do:
     7679                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7680                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7681                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7682                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     7683                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     7684                                  no-lock no-error.
     7685                                  if not available utd-marking-lines
     7686                                  then do:
     7687                                    vtext = vunit:Value.
     7688                                    do viii = 1 to num-entries(vtext," "):
     7689                                       VValue = entry(viii,vtext," ").
     7690                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     7691                                    end.
     7692                                 end.
     7693                              end.
     7694                              release object  vunit.
     7695                           end.
     7696                           release object  vunits.
     7697                            release object vExtendedInvoiceItem.
     7698                         end.
     7699                         release object vItems.
     7700                     end.
     7701                     release object vContent.
     7702                  end.
     7703                  else do:
     7704                     create tt-recid.
     7705                     assign
     7706                        tt-recid.orgid = vOrganizationGuid
     7707                        tt-recid.docid = vDocumentid
     7708                     .
     7709                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     7710                     release object vDocumentChild.
     7711                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     7712                  end.
     7713               end.
     7714            end.
     7715            release object vDocumentChild.
     7716            define variable vsetPAck as logical no-undo.
     7717            define variable vcli-type as character no-undo.
     7718            define variable vcli-code as integer no-undo.
     7719            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7720                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     7721            no-lock no-error.
     7722            if available ext-classif
     7723            then do:
     7724               assign
     7725                  vcli-type = ext-classif.CharKey_One
     7726                  vcli-code = ext-classif.Key#_One
     7727               .
     7728               define variable vPack as character no-undo.
     7729               if   iDocument:type eq "UniversalTransferDocument"
     7730               then
     7731                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     7732               else if iDocument:type eq "UniversalTransferDocumentRevision"
     7733               then
     7734                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     7735               else
     7736                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7737               if vPack ne utd.PackageId
     7738               then
     7739                  assign
     7740                     vsetPAck      = yes
     7741                     utd.PackageId = vPack
     7742                  .
     7743            end.
     7744            if vNewUtd or vsetPAck then do:
     7745               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7746               then do:
     7747                  if vNewUtd  then do:
     7748                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7749                     find first old_utd where old_utd.db-num eq volddb-num
     7750                                          and old_utd.doc-id eq volddoc-id
     7751                        no-lock no-error.
     7752                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     7753                                                  and utd-marking-lines.doc-id eq utd.doc-id
     7754                     exclusive-lock:
     7755                        if available old_utd
     7756                           and utd.db-num ne volddb-num
     7757                           and utd.doc-id ne volddoc-id
     7758                        then
     7759                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     7760                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     7761                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     7762                           no-lock no-error.
     7763                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     7764                     end.
     7765                     validate utd.
     7766                     ReCheckload( utd.db-num, utd.doc-id,yes).
     7767                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7768                  end.
     7769               end.
     7770               else do:
     7771                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7772                  find first old_utd where old_utd.db-num eq volddb-num
     7773                                       and old_utd.doc-id eq volddoc-id
     7774                  no-lock no-error.
     7775                  if not available old_utd
     7776                     or (   utd.db-num eq volddb-num
     7777                        and utd.doc-id eq volddoc-id)
     7778                  then
     7779                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     7780                  else do:
     7781                      assign
     7782                          utd.obj-inn               = old_utd.obj-inn
     7783                          utd.obj-kpp               = old_utd.obj-kpp
     7784                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     7785                          utd.obj-info              = old_utd.obj-info
     7786                          utd.parentDocumentExt     = old_utd.DocumentExt
     7787                          utd.parentOrganizationExt = old_utd.OrganizationExt
     7788                          utd.contract-code         = old_utd.contract-code
     7789                      .
     7790                  end.
     7791                  validate utd.
     7792                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     7793               end.
     7794            end.
     7795            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7796            find first old_utd where old_utd.db-num eq volddb-num
     7797                                 and old_utd.doc-id eq volddoc-id
     7798            no-lock no-error.
     7799            if available old_utd
     7800            then
     7801               assign
     7802                  utd.parentDocumentExt     = old_utd.DocumentExt
     7803                  utd.parentOrganizationExt = old_utd.OrganizationExt
     7804               .
     7805            create tt-recid.
     7806            assign
     7807               tt-recid.orgid = vOrganizationGuid
     7808               tt-recid.docid = vDocumentid
     7809            .
     7810            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     7811            then do:
     7812               tt-recid.parent = utd.PackageId.
     7813               tt-recid.stamp  = utd.Timestamp.
     7814            end.
     7815            release utd no-error.
     7816            if error-status:error
     7817            then
     7818               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     7819            else
     7820               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7821            unsubscribe "getNextseq".
     7822         end.
     7823      end.
     7824   end.
     7825   function packetupdd returns date
     7826   (iOrganization as component-handle, iDocument as component-handle):
     7827      define variable VPack as character no-undo.
     7828      define variable vorgid as character no-undo.
     7829      define variable vdocid as character no-undo.
     7830      define variable vstamp as datetime no-undo.
     7831      define variable VPack2 as character no-undo.
     7832      define variable vorgid2 as character no-undo.
     7833      define variable vdocid2 as character no-undo.
     7834      define variable vstamp2 as datetime no-undo.
     7835      define variable VPackage as component-handle no-undo.
     7836      define variable vi as integer no-undo.
     7837      define variable vDocument as component-handle no-undo.
     7838      define variable vDocuments as component-handle no-undo.
     7839         VPack = iDocument:PackageId.
     7840         vorgid = iDocument:OrganizationGuid.
     7841         vdocid = iDocument:DocumentId.
     7842         vstamp = iDocument:Timestamp.
     7843         find first tt-pack where tt-pack.packid eq VPack
     7844                              and tt-pack.stamp  eq vstamp
     7845                              and tt-pack.orgid  eq vorgid
     7846                              and tt-pack.docid  eq vdocid
     7847         no-lock no-error.
     7848         if not available tt-pack
     7849         then do:
     7850            create tt-pack.
     7851            assign
     7852               tt-pack.packid = VPack
     7853               tt-pack.stamp  = vstamp
     7854               tt-pack.orgid  = vorgid
     7855               tt-pack.docid  = vdocid
     7856            .
     7857         end.
     7858         getdesc(iDocument ).
     7859         getdesc(iDocument:InitialDocumentIds ).
     7860         vDocuments = iDocument:InitialDocumentIds.
     7861         do vi= 1 to vDocuments:Count:
     7862            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     7863            getdesc(vDocument ).
     7864            vorgid2 = vDocument:OrganizationGuid.
     7865            vdocid2 = vDocument:DocumentId.
     7866            vstamp2 = vDocument:Timestamp.
     7867            find first tt-pack where tt-pack.packid eq VPack
     7868                                 and tt-pack.stamp  eq vstamp2
     7869                                 and tt-pack.orgid  eq vorgid2
     7870                                 and tt-pack.docid  eq vdocid2
     7871            no-lock no-error.
     7872            if not available tt-pack
     7873            then do:
     7874               create tt-pack.
     7875               assign
     7876                  tt-pack.packid = VPack
     7877                  tt-pack.stamp  = vstamp2
     7878                  tt-pack.orgid  = vorgid2
     7879                  tt-pack.docid  = vdocid2
     7880               .
     7881            end.
     7882            release object vDocument.
     7883         end.
     7884         release object vDocuments.
     7885   end.
     7886   procedure UpdateUTDInform:
     7887      define input  parameter ibeg-date as date no-undo.
     7888      define input  parameter iend-date as date no-undo.
     7889      define output parameter odatelast as date no-undo.
     7890      define variable vOrganizationList as component-handle no-undo.
     7891      define variable vOrganization as component-handle no-undo.
     7892      define variable vDocumentsTask as component-handle no-undo.
     7893      define variable vDocumentList  as component-handle no-undo.
     7894      define variable vDocumentchildList  as component-handle no-undo.
     7895      define variable vDocument       as component-handle no-undo.
     7896      define buffer ext-classif_obj for ext-classif.
     7897      define buffer ext-classif_Cli  for ext-classif.
     7898      define variable vi  as integer no-undo.
     7899      define variable vii as integer no-undo.
     7900      odatelast = ibeg-date.
     7901      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     7902      if vOrganizationList eq ? then return error ?.
     7903      vi = vOrganizationList:Count()no-error.
     7904      if vi eq ?
     7905      then
     7906         return error ?.
     7907      for each tt-recid:
     7908         delete tt-recid.
     7909      end.
     7910      for each tt-pack:
     7911         delete tt-pack.
     7912      end.
     7913      do vi = 1 to vOrganizationList:Count() :
     7914         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     7915         getdesc(vOrganization).
     7916         run changeIdtoGuid(vOrganization).
     7917         vDocumentsTask = vOrganization:GetDocumentsTask().
     7918                     vDocumentsTask:FromSendDate = ibeg-date  .
     7919                     vDocumentsTask:ToSendDate   = iend-date.
     7920                     for each tt-type, each tt-Class:
     7921                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     7922                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     7923                                          chr(10),
     7924                                          ibeg-date ,
     7925                                          iend-date,
     7926                                          if tt-type .id eq "Any" then "" else tt-type.name,
     7927                                          tt-Class.name)).
     7928                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     7929                         if vDocumentList ne ?
     7930                         then do:
     7931                           do vii= 1 to vDocumentList:Count:
     7932                              if chekStop() then return ?.
     7933                              vDocument = vDocumentList:GetItem(vii - 1).
     7934                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     7935                              odatelast = min(odatelast,today).
     7936                              packetupdd(vOrganization, vDocument).
     7937                              release object vDocument.
     7938                            end.
     7939                            release object vDocumentList.
     7940                         end.
     7941                      end.
     7942                      define variable VAlldoc    as integer no-undo.
     7943                      define variable vprocessed as integer no-undo.
     7944                      for each tt-pack :
     7945                         VAlldoc = VAlldoc + 1.
     7946                      end.
     7947                      for each tt-pack :
     7948                          if chekStop() then return ?.
     7949                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     7950                         then do:
     7951                             run  UpdateUTDInformOne(vDocument).
     7952                            release object vDocument.
     7953                        end.
     7954                        vprocessed = vprocessed + 1.
     7955                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     7956                     end.
     7957         release object vOrganization.
     7958         release object vDocumentsTask.
     7959      end.
     7960      release object vOrganizationList.
     7961   end.
     7962   procedure updOneUTD:
     7963      define input  parameter idb-num as integer no-undo.
     7964      define input  parameter idoc-id as integer no-undo.
     7965      define variable vDocument as component-handle no-undo.
     7966      define buffer utd for utd.
     7967      for each tt-recid:
     7968         delete tt-recid.
     7969      end.
     7970      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7971      then do:
     7972          run  UpdateUTDInformOne(vDocument).
     7973         release object vDocument.
     7974      end.
     7975   end.
     7976   function CRnewDocum return character
     7977   (
     7978   iOrgGuid as character,
     7979   iContGuid as character,
     7980   iTypeUTD as character,
     7981    iFile as character
     7982    ):
     7983   define variable vOrganization as component-handle no-undo.
     7984   define variable vSendTask as component-handle no-undo.
     7985       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     7986       if vOrganization ne ?
     7987       then do:
     7988          vSendTask = vOrganization:CreatePackageSendTask2().
     7989          getdesc(vSendTask).
     7990          vSendTask:CounteragentId = iContGuid  .
     7991          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     7992          vSendTask:Send()no-error.
     7993          if error-status:num-messages > 0 then do:
     7994             PutErr("ERROR Ошибка отправки документа").
     7995             return error "ERROR Ошибка отправки документа".
     7996          end.
     7997          else do:
     7998             PutMes("Документ отправлен успешно.").
     7999             message "Документ отправлен успешно."
     8000             view-as alert-box.
     8001          end.
     8002          release object vSendTask.
     8003         release object vOrganization .
     8004      end.
     8005   end.
     8006   procedure MySeqForUtd:
     8007      define input  parameter iTable       as character no-undo.
     8008      define input  parameter iseqnamehist as character no-undo.
     8009      define input  parameter idb-name     as character no-undo.
     8010      define output parameter Oseq         as int64 no-undo.
     8011      if iTable begins "utd"
     8012      then do:
     8013         if myseqUtd eq ?
     8014         then
     8015            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     8016         Oseq = myseqUtd.
     8017      end.
     8018      else
     8019         Oseq = ?.
     8020      return.
     8021   end.
     8022   define variable v-rid-list      as character no-undo .
     8023   define variable row_order       as rowid     no-undo .
     8024   define variable recid_order     as integer   no-undo .
     8025   define variable ii              as integer   no-undo .
     8026   define variable v-cli           as logical   no-undo .
     8027   define variable filter-point    as character no-undo.
     8028   define variable Status_         as character no-undo .
     8029   DEFINE buffer buf_order for ub.order-doc.
     8030   define buffer buf_goods for ub.goods .
     8031   define variable bcol    as handle extent no-undo.
     8032   define variable hBrowse as handle no-undo.
     8033   define buffer db-attr for ub.db-attr .
     8034   define variable StatusOrder as class ibs.th.str.order.sts.order no-undo .
     8035   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8036   procedure factord :
     8037     define input  parameter p-fact-date            as date    no-undo .
     8038     define input  parameter p-fact-time            as integer no-undo .
     8039     define input  parameter p-fact-num             as integer no-undo .
     8040     define input  parameter p-shift-date           as date    no-undo .
     8041     define input  parameter p-shift-num            as integer no-undo .
     8042     define input  parameter p-shift-on             as logical no-undo .
     8043     define output parameter p-fact-order           as decimal no-undo .
     8044     define output parameter p-shift-end-fact-order as decimal no-undo .
     8045     define output parameter p-day-end-fact-order   as decimal no-undo .
     8046     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     8047     if p-fact-date = ?
     8048     then do:
     8049       return error "Не указана фактическая дата" .
     8050     end.
     8051     define variable v-fact-date-num as integer no-undo .
     8052     assign
     8053       v-fact-date-num = integer(p-fact-date)
     8054     .
     8055     if p-fact-num = ?
     8056     or p-fact-num = 0
     8057     then do:
     8058       return error "Не задан p-fact-num " + string(p-fact-num) .
     8059     end.
     8060     if p-fact-num < 0
     8061     then do:
     8062       return error "Отрицательный fact-num " + string(p-fact-num) .
     8063     end.
     8064     if p-fact-num >= 100000000
     8065     then do:
     8066       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     8067     end.
     8068     if p-shift-on = true
     8069     then do:
     8070       if p-shift-date = ?
     8071       then do:
     8072         return error "Не задана дата смены" .
     8073       end.
     8074       if p-shift-num = ?
     8075       or p-shift-num = 0
     8076       then do:
     8077         return error "Не задан номер смены" .
     8078       end.
     8079     end.
     8080     else do:
     8081       assign
     8082         p-shift-date = p-fact-date
     8083         p-shift-num  = 24
     8084       .
     8085     end.
     8086     define variable v-shift-offset as integer no-undo .
     8087     if p-shift-date = p-fact-date
     8088     then do:
     8089       assign
     8090         v-shift-offset = 1
     8091       .
     8092     end.
     8093     if p-shift-date < p-fact-date
     8094     then do:
     8095       assign
     8096         v-shift-offset = 0
     8097       .
     8098     end.
     8099     if p-shift-date > p-fact-date
     8100     then do:
     8101       message
     8102         vss-workfile vss-revision vss-description skip
     8103         "Неправильная дата закрытия смены" skip
     8104         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     8105         view-as alert-box error .
     8106       undo, return error
     8107         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     8108           ,string(p-fact-date, '99/99/9999':U)
     8109           ,string(p-shift-date, '99/99/9999':U)
     8110           )
     8111       .
     8112     end.
     8113     if p-shift-num < 1
     8114     or p-shift-num > 24
     8115     then do:
     8116       message
     8117         vss-workfile vss-revision vss-description skip
     8118         "Неправильный номер смены" skip
     8119         "p-shift-num" p-shift-num skip
     8120         view-as alert-box error .
     8121       undo, return error return-value .
     8122     end.
     8123     assign
     8124       p-fact-order           = v-fact-date-num
     8125                              + v-shift-offset * 0.5
     8126                              + p-shift-num    * 0.02 - 0.01
     8127                              + p-fact-num     * 0.0000000001
     8128       p-shift-end-fact-order = v-fact-date-num
     8129                              + v-shift-offset * 0.5
     8130                              + p-shift-num    * 0.02
     8131       p-day-end-fact-order   = v-fact-date-num
     8132                              + 0.99
     8133     .
     8134     if p-fact-order           <= v-fact-date-num
     8135     or p-shift-end-fact-order <= v-fact-date-num
     8136     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     8137     or p-shift-end-fact-order >= p-day-end-fact-order
     8138     then do:
     8139       message
     8140         vss-workfile vss-revision vss-description skip
     8141         "Внутренняя ошибка при генерации фактического номера" skip
     8142         "p-fact-date"            p-fact-date            skip
     8143         "p-fact-time"            p-fact-time            skip
     8144         "p-fact-num"             p-fact-num             skip
     8145         "p-shift-date"           p-shift-date           skip
     8146         "p-shift-num"            p-shift-num            skip
     8147         "p-shift-on"             p-shift-on             skip
     8148         "p-shift-end-fact-order" p-shift-end-fact-order skip
     8149         "p-day-end-fact-order"   p-day-end-fact-order   skip
     8150         "v-fact-date-num"        v-fact-date-num        skip
     8151         view-as alert-box error .
     8152       undo, return error return-value .
     8153     end.
     8154   end procedure.
     8155   procedure day-begin-fact-order :
     8156     define input  parameter p-fact-date            as date    no-undo .
     8157     define output parameter p-day-begin-fact-order as decimal no-undo .
     8158     do
     8159     on error undo, return error return-value
     8160     :
     8161       if p-fact-date = ?
     8162       then do:
     8163         assign
     8164           p-day-begin-fact-order = 0
     8165         .
     8166       end.
     8167       else do:
     8168         assign
     8169           p-day-begin-fact-order = integer(p-fact-date)
     8170         .
     8171       end.
     8172     end.
     8173   end procedure.
     8174   procedure factord-max-fact-order :
     8175     define output parameter p-max-fact-order as decimal   no-undo .
     8176     do
     8177     on error undo, return error return-value
     8178     :
     8179       run day-begin-fact-order in this-procedure
     8180         (input  date(1, 1, 5000)
     8181         ,output p-max-fact-order
     8182         ) .
     8183     end.
     8184   end procedure.
     8185   procedure factord-cut-archive :
     8186     define input  parameter p-obj-type             as character no-undo .
     8187     define input  parameter p-obj-code             as integer   no-undo .
     8188     define input  parameter p-fact-date            as date      no-undo .
     8189     define output parameter p-shift-on             as logical   no-undo .
     8190     define output parameter p-shift-date           as date      no-undo .
     8191     define output parameter p-shift-num            as integer   no-undo .
     8192     define output parameter p-day-end-fact-order   as decimal   no-undo .
     8193     define output parameter p-shift-end-fact-order as decimal   no-undo .
     8194     define variable v-fact-order as decimal   no-undo .
     8195     define buffer buf_shift-obj for ub.shift-obj .
     8196     do
     8197     on error undo, return error return-value
     8198     :
     8199   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8201     (input  p-obj-type
     8202     ,input  p-obj-code
     8203     ,input  'shift-on=request'
     8204     ,output p-shift-on
     8205     ) no-error .
     8206       if error-status :error
     8207       then do:
     8208         message
     8209           vss-workfile vss-revision vss-description skip
     8210           "Ошибка при определении атрибута объекта" skip
     8211           "Объект" p-obj-type p-obj-code skip
     8212           error-status :get-message(1) skip
     8213           return-value skip
     8214           view-as alert-box error .
     8215         undo, return error return-value .
     8216       end.
     8217       if p-shift-on = false
     8218       then do:
     8219         assign
     8220           p-shift-date               = ?
     8221           p-shift-num                = 0
     8222         .
     8223       end.
     8224       else do:
     8225         find first buf_shift-obj share-lock
     8226           where buf_shift-obj.obj-type   = p-obj-type
     8227             and buf_shift-obj.obj-code   = p-obj-code
     8228             and buf_shift-obj.shift-date > p-fact-date
     8229           use-index pi
     8230           no-error .
     8231         if not available buf_shift-obj
     8232         or buf_shift-obj.status_ <> 'зкр':U
     8233         then do:
     8234           message
     8235             vss-workfile vss-revision vss-description skip
     8236             "Невозможно вычислить последнюю смену" skip
     8237             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     8238             "Объект" p-obj-type p-obj-code skip
     8239             "Дата" p-fact-date skip
     8240             view-as alert-box error .
     8241           undo, return error return-value .
     8242         end.
     8243         find last buf_shift-obj share-lock
     8244           where buf_shift-obj.obj-type = p-obj-type
     8245             and buf_shift-obj.obj-code = p-obj-code
     8246             and buf_shift-obj.shift-date <= p-fact-date
     8247           use-index pi
     8248           no-error .
     8249         if available buf_shift-obj
     8250         then do:
     8251           if  buf_shift-obj.status_ = 'зкр':U
     8252           then do:
     8253             assign
     8254               p-shift-date = buf_shift-obj.shift-date
     8255               p-shift-num  = buf_shift-obj.shift-num
     8256             .
     8257           end.
     8258           else do:
     8259             message
     8260               vss-workfile vss-revision vss-description skip
     8261               "Невозможно вычислить последнюю смену" skip
     8262               "Статус смены отличен от статуса" 'зкр':U skip
     8263               "Объект" p-obj-type p-obj-code skip
     8264               "Дата" p-fact-date skip
     8265               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     8266               view-as alert-box error .
     8267             undo, return error return-value .
     8268           end.
     8269         end.
     8270         else do:
     8271           assign
     8272             p-shift-date = p-fact-date - 1
     8273             p-shift-num  = 1
     8274           .
     8275         end.
     8276       end.
     8277       run factord in this-procedure
     8278         (input  p-fact-date
     8279         ,input  1
     8280         ,input  1
     8281         ,input  p-shift-date
     8282         ,input  p-shift-num
     8283         ,input  p-shift-on
     8284         ,output v-fact-order
     8285         ,output p-shift-end-fact-order
     8286         ,output p-day-end-fact-order
     8287         ) no-error .
     8288       if error-status :error
     8289       then do:
     8290         message
     8291           vss-workfile vss-revision vss-description skip
     8292           "Ошибка при вызове процедуры factord"
     8293           error-status :get-message(1) skip
     8294           return-value skip
     8295           view-as alert-box error .
     8296         undo, return error return-value .
     8297       end.
     8298     end.
     8299   end procedure.
     8300   procedure factord-lock-shift :
     8301     define input  parameter p-obj-type  as character no-undo .
     8302     define input  parameter p-obj-code  as integer   no-undo .
     8303     define input  parameter p-fact-date as date      no-undo .
     8304     define parameter buffer buf_shift-obj for ub.shift-obj .
     8305     define variable v-shift-on      as logical   no-undo .
     8306     define variable v-extra-message as character no-undo .
     8307     define variable v-error as character no-undo .
     8308     do
     8309     on error undo, return error return-value
     8310     :
     8311   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8313     (input  p-obj-type
     8314     ,input  p-obj-code
     8315     ,input  'shift-on=request'
     8316     ,output v-shift-on
     8317     ) no-error .
     8318       if error-status :error
     8319       then do:
     8320         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     8321         undo, return error v-error .
     8322       end.
     8323       if v-shift-on = true
     8324       then do:
     8325         find first buf_shift-obj share-lock
     8326           where buf_shift-obj.obj-type   = p-obj-type
     8327             and buf_shift-obj.obj-code   = p-obj-code
     8328             and buf_shift-obj.shift-date > p-fact-date
     8329           use-index pi
     8330           no-error .
     8331         if not available buf_shift-obj
     8332         or buf_shift-obj.status_ <> 'зкр':U
     8333         then do:
     8334           find last buf_shift-obj
     8335             where buf_shift-obj.obj-type = p-obj-type
     8336               and buf_shift-obj.obj-code = p-obj-code
     8337               and buf_shift-obj.status_  = 'зкр':U
     8338             use-index stts
     8339             no-error .
     8340           if available buf_shift-obj
     8341           then do:
     8342             assign
     8343               v-extra-message =
     8344                     substitute("Дата начала последеней закрытой смены на объекте &1"
     8345                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     8346                               )
     8347             .
     8348           end.
     8349           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     8350           undo, return error v-error .
     8351         end.
     8352       end.
     8353     end.
     8354   end procedure.
     8355   procedure factord-end-day :
     8356     define input  parameter p-fact-date            as date    no-undo .
     8357     define output parameter p-day-end-fact-order   as decimal no-undo .
     8358     do
     8359     on error undo, return error return-value
     8360     :
     8361       if p-fact-date = ?
     8362       then do:
     8363         return error "Не указана фактическая дата" .
     8364       end.
     8365       assign
     8366         p-day-end-fact-order = integer(p-fact-date) + 0.99
     8367       .
     8368     end.
     8369   end procedure.
     8370   procedure factord-to-date :
     8371     define input  parameter p-fact-order as decimal no-undo .
     8372     define output parameter p-fact-date  as date    no-undo .
     8373     define variable v-ref-date  as date      no-undo .
     8374     define variable v-ref-delta as integer   no-undo .
     8375     do
     8376     on error undo, return error return-value
     8377     :
     8378       if p-fact-order = ?
     8379       or p-fact-order = 0
     8380       then do:
     8381         return error "Не указан fact-order" .
     8382       end.
     8383       assign
     8384         v-ref-date  = date(1, 1, 2000)
     8385       .
     8386       assign
     8387         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     8388       .
     8389       assign
     8390         p-fact-date = v-ref-date + v-ref-delta
     8391       .
     8392     end.
     8393   end procedure.
     8394   procedure factord-to-fact-num :
     8395     define input  parameter p-fact-order as decimal no-undo .
     8396     define output parameter p-fact-num   as integer no-undo .
     8397     define variable v-fact-order-trunc as decimal no-undo .
     8398     do
     8399     on error undo, return error return-value
     8400     :
     8401       if p-fact-order = ?
     8402       or p-fact-order = 0
     8403       then do:
     8404         return error "Не указан fact-order" .
     8405       end.
     8406       assign
     8407        v-fact-order-trunc = truncate(p-fact-order, 2)
     8408       .
     8409       assign
     8410         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     8411       .
     8412     end.
     8413   end procedure.
     8414   procedure factord-to-shift-num :
     8415     define input  parameter p-fact-order as decimal no-undo .
     8416     define output parameter p-shift-num   as integer no-undo .
     8417     define variable  p-shift-numd  as decimal   no-undo .
     8418     define variable v-fact-order-trunc as decimal no-undo .
     8419     do
     8420     on error undo, return error return-value
     8421     :
     8422       if p-fact-order = ?
     8423       or p-fact-order = 0
     8424       then do:
     8425         return error "Не указан fact-order" .
     8426       end.
     8427       assign
     8428        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     8429       .
     8430       if v-fact-order-trunc < 0.5 then do:
     8431         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     8432       end.
     8433       assign
     8434         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     8435         .
     8436        assign
     8437         p-shift-num = truncate (p-shift-numd , 0)
     8438       .
     8439     end.
     8440   end procedure.
     8441   function round-maxInt returns decimal
     8442       (input p-dec as decimal) forward.
     8443   function round-maxDec returns decimal
     8444       (input p-dec as decimal) forward.
     8445   function round-minInt returns decimal
     8446       (input p-dec as decimal) forward.
     8447   define variable rPeriodZakaz       as integer   no-undo .
     8448   define variable vDaySale           as integer   no-undo .
     8449   define variable pGarantDay         as integer   no-undo .
     8450   define variable pDelDayGoods       as logical   no-undo .
     8451   define variable typeDocChoose      as character no-undo .
     8452   define variable dateZakaz          as character no-undo .
     8453   define variable zakazPeriod        as character no-undo .
     8454   define variable qntyPeriod         as integer   no-undo .
     8455   define variable pDateOrder         as date      no-undo .
     8456   define variable vLine              as integer   no-undo .
     8457   define variable vDateStart         as date      no-undo .
     8458   define variable vDateEnd           as date      no-undo .
     8459   define variable periodDate         as date      no-undo .
     8460   define variable v-fact-orderStart  as decimal   no-undo .
     8461   define variable v-fact-orderEnd    as decimal   no-undo .
     8462   define variable v-fact-order-start as decimal   no-undo .
     8463   define variable v-fact-order-end   as decimal   no-undo .
     8464   define buffer buf_PromoGoogs      for ub.PromoGoods .
     8465   define buffer buf_PromoAction     for ub.PromoAction .
     8466   define buffer buf_stk-line        for ub.stk-line .
     8467   define buffer buf_trn-doc         for ub.trn-doc .
     8468   define buffer buf_goods-attr      for ub.goods-attr .
     8469   define buffer buf_cli-gds         for ub.cli-gds .
     8470   define buffer buf_temp-gds-qnty   for temp-gds-qnty .
     8471   define buffer buf_doc-line        for ub.doc-line .
     8472   define buffer buf_order-line      for ub.order-line .
     8473   define buffer buf_order-doc       for ub.order-doc .
     8474   define buffer buf_contract-specif for ub.contract-specif .
     8475   procedure crt-orderLine:
     8476       define input parameter par-params      as character no-undo .
     8477       define input parameter pDocCode as integer no-undo .
     8478       define input parameter pDbNum as integer no-undo .
     8479       define input parameter table for tt-gds-list .
     8480       define variable kk as integer no-undo .
     8481       define variable ii as integer no-undo .
     8482       pDateOrder = date(entry(1,par-params,chr(4))) .
     8483       rPeriodZakaz = integer(entry(2,par-params,chr(4))) .
     8484       vDaySale = integer (entry(3,par-params,chr(4))) .
     8485       pGarantDay = integer(entry(4,par-params,chr(4))) .
     8486       pDelDayGoods = logical(entry(5,par-params,chr(4))) .
     8487       typeDocChoose = entry(6,par-params,chr(4)) .
     8488       dateZakaz = entry(7,par-params,chr(4)) .
     8489       find first buf_order-doc no-lock where buf_order-doc.doc-code = pDocCode and
     8490           buf_order-doc.db-num = pDbNum no-error .
     8491       find last buf_order-line no-lock where buf_order-line.doc-code = pDocCode and
     8492           buf_order-line.db-num = pDbNum no-error .
     8493       if available (buf_order-line) then vLine = buf_order-line.line-num .
     8494       do kk = 1 to num-entries (dateZakaz,chr(7)):
     8495           zakazPeriod = entry(kk,dateZakaz,chr(7)) .
     8496           create tt-dateZakaz .
     8497           assign
     8498               tt-dateZakaz.id        = kk
     8499               tt-dateZakaz.dateStart = date(entry(1,zakazPeriod,chr(8)))
     8500               tt-dateZakaz.dateEnd   = date(entry(2,zakazPeriod,chr(8)))
     8501               .
     8502       end.
     8503       for each tt-dateZakaz:
     8504           qntyPeriod = qntyPeriod + 1 .
     8505           if tt-dateZakaz.dateStart < vDateStart or vDateStart = ? then vDateStart = tt-dateZakaz.dateStart .
     8506           if tt-dateZakaz.dateEnd > vDateEnd or vDateEnd = ? then vDateEnd = tt-dateZakaz.dateEnd .
     8507       end.
     8508       for each gds-list:
     8509           for first buf_goods-attr no-lock where buf_goods-attr.gds-code = gds-list.gds-code and
     8510               buf_goods-attr.attr-code = 'min-zapas':U:
     8511               gds-list.minZapas = decimal (buf_goods-attr.attr-value) .
     8512           end.
     8513       end.
     8514       for each gds-list:
     8515           find first tt-zakaz no-lock where tt-zakaz.gds-code = gds-list.gds-code no-error .
     8516           if available (tt-zakaz) then next .
     8517           create tt-zakaz .
     8518           assign
     8519               tt-zakaz.gds-code          = gds-list.gds-code
     8520               tt-zakaz.artic             = gds-list.artic
     8521               tt-zakaz.gds-name          = gds-list.gds-name
     8522               tt-zakaz.prod-code         = gds-list.prod-code
     8523               tt-zakaz.prod-type         = gds-list.prod-type
     8524               tt-zakaz.garant-stock      = 0
     8525               tt-zakaz.minZapas          = gds-list.minZapas
     8526               tt-zakaz.ostatokDay        = 0
     8527               tt-zakaz.ostatokGoods      = 0
     8528               tt-zakaz.rest              = 0
     8529               tt-zakaz.qntyDay           = kk - 1
     8530               tt-zakaz.qntyDaySale       = 0
     8531               tt-zakaz.average-sales     = 0
     8532               tt-zakaz.order-qnty        = 0
     8533               tt-zakaz.volMinZapas       = 0
     8534               tt-zakaz.sales             = 0
     8535               tt-zakaz.volume-goods      = 0
     8536               tt-zakaz.contract-prn-code = gds-list.contract
     8537               tt-zakaz.contract-code     = gds-list.contract-code
     8538               .
     8539           for each buf_cli-gds no-lock where buf_cli-gds.artic = gds-list.artic and
     8540               buf_cli-gds.prod-code = gds-list.prod-code and
     8541               buf_cli-gds.prod-type = gds-list.prod-type:
     8542               tt-zakaz.rest = tt-zakaz.rest + buf_cli-gds.supp-qnty .
     8543           end.
     8544           empty temp-table temp-gds-qnty .
     8545           if pDelDayGoods then run ost-gds-day(vDateStart, vDateEnd, gds-list.gds-code, v-cntxt-obj-type, v-cntxt-obj-code, tt-zakaz.rest) .
     8546           for each tt-dateZakaz:
     8547               run day-begin-fact-order in this-procedure ( input tt-dateZakaz.dateStart
     8548                   , output v-fact-order-start
     8549                   ).
     8550               run factord-end-day in this-procedure ( input tt-dateZakaz.dateEnd
     8551                   , output v-fact-order-end
     8552                   ).
     8553               if pDelDayGoods then
     8554               do:
     8555                   for each buf_temp-gds-qnty where buf_temp-gds-qnty.gds-code = gds-list.gds-code and
     8556                       buf_temp-gds-qnty.ost > 0 and
     8557                       buf_temp-gds-qnty.day >= tt-dateZakaz.dateStart and
     8558                       buf_temp-gds-qnty.day <= tt-dateZakaz.dateEnd:
     8559                       tt-zakaz.qntyDayGoods = tt-zakaz.qntyDayGoods + 1 .
     8560                   end.
     8561               end.
     8562               else tt-zakaz.qntyDayGoods = tt-dateZakaz.dateEnd - tt-dateZakaz.dateStart + 1.
     8563               do ii = 0 to num-entries (typeDocChoose,chr(7)):
     8564                   for each buf_doc-line no-lock
     8565                       where
     8566                       buf_doc-line.ext-doc-type = entry(ii,typeDocChoose,chr(7)) and
     8567                       buf_doc-line.obj-code = v-cntxt-obj-code and
     8568                       buf_doc-line.obj-type = v-cntxt-obj-type and
     8569                       buf_doc-line.artic = gds-list.artic and
     8570                       buf_doc-line.prod-code = gds-list.prod-code and
     8571                       buf_doc-line.prod-type = gds-list.prod-type and
     8572                       buf_doc-line.fact-order >= v-fact-order-start and
     8573                       buf_doc-line.fact-order <= v-fact-order-end :
     8574                       tt-zakaz.qntyDaySale = tt-zakaz.qntyDaySale + 1 .
     8575                       case entry(ii,typeDocChoose,chr(7)):
     8576                           when   'ie':U  or
     8577                           when   'im':U     then
     8578                               do:
     8579                                   tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8580                               end.
     8581                           when  'we':U      then
     8582                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8583                           when  'wm':U       then
     8584                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8585                           when  'em':U       then
     8586                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8587                           when  'ev':U      then
     8588                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8589                           when  'rv':U  then
     8590                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     8591                           when  'ee':U      then
     8592                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8593                           when  're':U  then
     8594                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     8595                           when  'es':U     then
     8596                               tt-zakaz.sales = tt-zakaz.sales + buf_doc-line.fact-qnty .
     8597                           when  'rs':U then
     8598                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     8599                           when  'we':U then
     8600                               tt-zakaz.sales = tt-zakaz.sales - buf_doc-line.fact-qnty .
     8601                       end case.
     8602                   end.
     8603               end.
     8604           end.
     8605           if tt-zakaz.qntyDayGoods <> 0 then tt-zakaz.average-sales = round-maxDec(tt-zakaz.sales / tt-zakaz.qntyDayGoods) .
     8606           if tt-zakaz.qntyDayGoods <> 0 then
     8607           do:
     8608               if tt-zakaz.rest > -1 then
     8609               do:
     8610                   tt-zakaz.ostatokDay = tt-zakaz.rest - ((integer(pDateOrder - date(today)) * tt-zakaz.average-sales)) .
     8611                   if tt-zakaz.ostatokDay < 0 then tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale).
     8612                   else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.ostatokDay) .
     8613               end.
     8614               else tt-zakaz.volume-goods = round-maxInt(tt-zakaz.average-sales * vDaySale - tt-zakaz.rest).
     8615               if tt-zakaz.qntyDaySale <> 0 then
     8616               do:
     8617                   tt-zakaz.volMinZapas = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.minZapas) .
     8618                   tt-zakaz.garant-stock = pGarantDay * tt-zakaz.average-sales .
     8619                   tt-zakaz.order-qnty = round-maxInt(tt-zakaz.volume-goods + tt-zakaz.minZapas + tt-zakaz.garant-stock) .
     8620                   if tt-zakaz.average-sales <> 0 then tt-zakaz.ostatokGoods = round-minInt(tt-zakaz.rest / tt-zakaz.average-sales) .
     8621               end.
     8622               else tt-zakaz.volume-goods = 0 .
     8623           end.
     8624           for each buf_PromoGoogs no-lock where buf_PromoGoogs.gds-code = gds-list.gds-code,
     8625               first buf_PromoAction no-lock where buf_PromoAction.id = buf_PromoGoogs.idAction and
     8626               buf_PromoAction.end-date >= today and buf_PromoAction.beg-date <= today and buf_PromoAction.Status_ = 1:
     8627               tt-zakaz.promo = true .
     8628           end.
     8629           find first buf_goods no-lock where
     8630               buf_goods.gds-code = tt-zakaz.gds-code.
     8631           create buf_order-line.
     8632           assign
     8633               vLine                        = vLine + 1
     8634               buf_order-line.doc-code      = pDocCode
     8635               buf_order-line.db-num        = pDbNum
     8636               buf_order-line.line-num      = vLine
     8637               buf_order-line.gds-code      = tt-zakaz.gds-code
     8638               buf_order-line.artic         = tt-zakaz.artic
     8639               buf_order-line.prod-type     = if avail buf_goods then buf_goods.prod-type else ""
     8640               buf_order-line.prod-code     = if avail buf_goods then buf_goods.prod-code else 0
     8641               buf_order-line.order-qnty    = tt-zakaz.order-qnty
     8642               buf_order-line.fact-qnty     = tt-zakaz.order-qnty
     8643               buf_order-line.rest          = tt-zakaz.rest
     8644               buf_order-line.sales         = tt-zakaz.sales
     8645               buf_order-line.average-sales = tt-zakaz.average-sales
     8646               buf_order-line.stock-goods   = if tt-zakaz.average-sales = 0 and tt-zakaz.ostatokDay <> 0 then -1 else integer(tt-zakaz.ostatokGoods)
     8647               buf_order-line.volume-goods  = tt-zakaz.volume-goods
     8648               buf_order-line.volume-stock  = if tt-zakaz.minZapas > tt-zakaz.rest then tt-zakaz.minZapas else tt-zakaz.volMinZapas
     8649               buf_order-line.min-stock     = tt-zakaz.minZapas
     8650               buf_order-line.garant-stock  = tt-zakaz.garant-stock
     8651               buf_order-line.promo         = tt-zakaz.promo
     8652               .
     8653           validate buf_order-line.
     8654       end .
     8655   end procedure .
     8656   procedure ost-gds-day :
     8657       do
     8658           on error undo, return error return-value
     8659           :
     8660           define input parameter p-dateStart as decimal no-undo .
     8661           define input parameter p-dateEnd as decimal no-undo .
     8662           define input parameter p-gds-code like ub.goods.gds-code no-undo .
     8663           define input parameter p-obj-type as character no-undo .
     8664           define input parameter p-obj-code as integer no-undo .
     8665           define input parameter p-ost-today as decimal no-undo .
     8666           define variable vOst as decimal no-undo .
     8667           define buffer p_goods     for ub.goods .
     8668           define buffer p-doc-line  for ub.doc-line .
     8669           define buffer pc-gds-obj  for ub.c-gds-obj .
     8670           define buffer pc-gds-obj2 for ub.c-gds-obj .
     8671           find first p_goods no-lock where p_goods.gds-code = p-gds-code no-error .
     8672           if error-status :error then return error .
     8673           do periodDate = vDateStart to vDateEnd:
     8674               create temp-gds-qnty .
     8675               assign
     8676                   temp-gds-qnty.day      = periodDate
     8677                   temp-gds-qnty.gds-code = p_goods.gds-code
     8678                   .
     8679               find first pc-gds-obj no-lock where pc-gds-obj.gds-code = p_goods.gds-code and
     8680                   pc-gds-obj.obj-code = p-obj-code and
     8681                   pc-gds-obj.obj-type = p-obj-type and
     8682                   pc-gds-obj.corr-date = periodDate no-error .
     8683               if not available (pc-gds-obj) then
     8684               do:
     8685                   find last pc-gds-obj2 no-lock where pc-gds-obj2.gds-code = p_goods.gds-code and
     8686                       pc-gds-obj2.obj-code = p-obj-code and
     8687                       pc-gds-obj2.obj-type = p-obj-type and
     8688                       pc-gds-obj2.corr-date < periodDate no-error .
     8689                   if available (pc-gds-obj2) then temp-gds-qnty.ost = pc-gds-obj2.fact-qnty .
     8690               end.
     8691               else temp-gds-qnty.ost = pc-gds-obj.fact-qnty .
     8692           end.
     8693       end.
     8694   end procedure.
     8695   function round-maxInt returns decimal
     8696       (input p-dec as decimal):
     8697       define variable p-int as decimal no-undo .
     8698       if absolute(p-dec - TRUNCATE (p-dec, 0)) < 0.5
     8699           then
     8700       do:
     8701           if p-dec > 0 then p-int = integer (p-dec + 0.4) .
     8702           else p-int = integer(p-dec) .
     8703       end .
     8704       else
     8705       do:
     8706           if p-dec < 0 then p-int = integer (p-dec + 0.4) .
     8707           else p-int = integer(p-dec) .
     8708       end.
     8709       return p-int .
     8710   end function.
     8711   function round-minInt returns decimal
     8712       (input p-dec as decimal):
     8713       define variable p-int as decimal no-undo .
     8714       if absolute(p-dec - TRUNCATE (p-dec, 0)) > 0.5
     8715           then
     8716       do:
     8717           if p-dec > 0 then p-int = integer (p-dec - 0.4) .
     8718           else p-int = integer(p-dec) .
     8719       end .
     8720       else
     8721       do:
     8722           if p-dec < 0 then p-int = integer (p-dec - 0.4) .
     8723           else p-int = integer(p-dec) .
     8724       end.
     8725       return p-int .
     8726   end function.
     8727   function round-maxDec returns decimal
     8728       (input p-dec as decimal):
     8729       define variable p-int as decimal no-undo .
     8730       if p-dec - TRUNCATE (p-dec, 1) > 0
     8731           then
     8732       do:
     8733           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     8734           else p-int = TRUNCATE (p-dec, 1) + 0.1 .
     8735       end.
     8736       else
     8737       do:
     8738           if p-dec - TRUNCATE (p-dec, 1) > 0
     8739               then
     8740           do:
     8741               p-int = TRUNCATE (p-dec, 1) - 0.1.
     8742           end.
     8743           else
     8744           do:
     8745               assign
     8746                   p-int = TRUNCATE (p-dec, 1) .
     8747               .
     8748           end.
     8749       end.
     8750       return p-int .
     8751   end function.
     8752   function round-minDec returns decimal
     8753       (input p-dec as decimal):
     8754       define variable p-int as decimal no-undo .
     8755       if p-dec - TRUNCATE (p-dec, 1) < 0
     8756           then
     8757       do:
     8758           if TRUNCATE (p-dec, 1) = 0 then p-int = TRUNCATE (p-dec, 1) .
     8759           else p-int = TRUNCATE (p-dec, 1) - 0.1 .
     8760       end.
     8761       else
     8762       do:
     8763           if p-dec - TRUNCATE (p-dec, 1) > 0
     8764               then
     8765           do:
     8766               p-int = TRUNCATE (p-dec, 1) - 0.1.
     8767           end.
     8768           else
     8769           do:
     8770               assign
     8771                   p-int = p-dec
     8772                   .
     8773           end.
     8774       end.
     8775       return p-int .
     8776   end function.
