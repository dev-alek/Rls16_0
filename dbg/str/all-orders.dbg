     9113                   bf_order-line-attr.doc-code = bf_order.doc-code .
     9114                   buffer-copy ub.order-line-attr except doc-code to bf_order-line-attr .
     9115               end.
     9116               create bf_order-attr .
     9117               assign
     9118                   bf_order-attr.doc-code   = bf_order.doc-code
     9119                   bf_order-attr.db-num     = bf_order.db-num
     9120                   bf_order-attr.attr-code  = "copyOrder"
     9121                   bf_order-attr.attr-value = string(buf_X_order.doc-code)
     9122                   .
     9123               OPEN QUERY br-order FOR EACH X_order no-lock by X_order.doc-code desc INDEXED-REPOSITION.
     9124               release bf_order .
     9125               release bf_order-line .
     9126               release bf_order-attr .
     9127               release X_order.
     9128               run init-sort .
