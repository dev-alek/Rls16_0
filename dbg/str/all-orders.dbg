     1240   procedure xmlchar-test :
     1241   define input parameter p-in-string          as character        no-undo.
     1242   define output parameter p-out-string-enc    as character        no-undo.
     1243   define output parameter p-out-string-dec    as character        no-undo.
     1244   do
     1245   on error undo, return error
     1246   :
     1247          run xmlchar-encode in this-procedure
     1248       (
     1249             input p-in-string
     1250           , output p-out-string-enc
     1251       ).
     1252          run xmlchar-decode in this-procedure
     1253       (
     1254             input p-out-string-enc
     1255           , output p-out-string-dec
     1256       ).
     1257   end.
     1258   end .
     1259   procedure xmlchar-encode :
     1260   define input parameter p-in-string      as character        no-undo.
     1261   define output parameter p-out-string    as character        no-undo.
     1262       define variable v-position      as integer      no-undo.
     1263       define variable v-current-char  as character    no-undo.
     1264   do
     1265   on error undo, return error
     1266   :
     1267       assign
     1268           p-out-string = "":U
     1269       .
     1270       case p-in-string
     1271       :
     1272           when ?
     1273           then do:
     1274               assign
     1275                   p-out-string = "?":U
     1276               .
     1277           end.
     1278           when "?":U
     1279           then do:
     1280               assign
     1281                   p-out-string = "&#63;":U
     1282               .
     1283           end.
     1284           otherwise do:
     1285               do v-position = 1 to length( p-in-string )
     1286               :
     1287                   assign
     1288                       v-current-char = substring( p-in-string, v-position, 1 )
     1289                   .
     1290                   case v-current-char
     1291                   :
     1292                       when "&":U
     1293                       then do:
     1294                           assign
     1295                               p-out-string = p-out-string + "&amp;":U
     1296                           .
     1297                       end.
     1298                       when ">":U
     1299                       then do:
     1300                           assign
     1301                               p-out-string = p-out-string + "&gt;":U
     1302                           .
     1303                       end.
     1304                       when "<":U
     1305                       then do:
     1306                           assign
     1307                               p-out-string = p-out-string + "&lt;":U
     1308                           .
     1309                       end.
     1310                       when "'":U
     1311                       then do:
     1312                           assign
     1313                               p-out-string = p-out-string + "&apos;":U
     1314                           .
     1315                       end.
     1316                       when '"':U
     1317                       then do:
     1318                           assign
     1319                               p-out-string = p-out-string + "&quot;":U
     1320                           .
     1321                       end.
     1322                       when chr(1)
     1323                       then do:
     1324                           assign
     1325                               p-out-string = p-out-string + "":U
     1326                           .
     1327                       end.
     1328                       when chr(2)
     1329                       then do:
     1330                           assign
     1331                               p-out-string = p-out-string + "":U
     1332                           .
     1333                       end.
     1334                       when chr(3)
     1335                       then do:
     1336                           assign
     1337                               p-out-string = p-out-string + "":U
     1338                           .
     1339                       end.
     1340                       when chr(4)
     1341                       then do:
     1342                           assign
     1343                               p-out-string = p-out-string + "":U
     1344                           .
     1345                       end.
     1346                       when chr(5)
     1347                       then do:
     1348                           assign
     1349                               p-out-string = p-out-string + "":U
     1350                           .
     1351                       end.
     1352                       when chr(6)
     1353                       then do:
     1354                           assign
     1355                               p-out-string = p-out-string + "":U
     1356                           .
     1357                       end.
     1358                       when chr(7)
     1359                       then do:
     1360                           assign
     1361                               p-out-string = p-out-string + "":U
     1362                           .
     1363                       end.
     1364                       when chr(8)
     1365                       then do:
     1366                           assign
     1367                               p-out-string = p-out-string + "":U
     1368                           .
     1369                       end.
     1370                       when chr(9)
     1371                       then do:
     1372                           assign
     1373                               p-out-string = p-out-string + "":U
     1374                           .
     1375                       end.
     1376                       when chr(29)
     1377                       then do:
     1378                           assign
     1379                               p-out-string = p-out-string + "":U
     1380                           .
     1381                       end.
     1382                       when chr(10)
     1383                       then do:
     1384                           assign
     1385                               p-out-string = p-out-string + "&#10;":U
     1386                           .
     1387                       end.
     1388                       when chr(13)
     1389                       then do:
     1390                           assign
     1391                               p-out-string = p-out-string + "&#13;":U
     1392                           .
     1393                       end.
     1394                       otherwise do:
     1395                           assign
     1396                               p-out-string = p-out-string + v-current-char
     1397                           .
     1398                       end.
     1399                   end case.
     1400               end.
     1401           end.
     1402       end case.
     1403   end.
     1404   end .
     1405   procedure xmlchar-encode-1c :
     1406   define input parameter p-in-string      as character        no-undo.
     1407   define output parameter p-out-string    as character        no-undo.
     1408       define variable v-position      as integer      no-undo.
     1409       define variable v-current-char  as character    no-undo.
     1410   do
     1411   on error undo, return error
     1412   :
     1413       assign
     1414           p-out-string = "":U
     1415       .
     1416       case p-in-string
     1417       :
     1418           when ?
     1419           then do:
     1420               assign
     1421                   p-out-string = "?":U
     1422               .
     1423           end.
     1424           otherwise do:
     1425               do v-position = 1 to length( p-in-string )
     1426               :
     1427                   assign
     1428                       v-current-char = substring( p-in-string, v-position, 1 )
     1429                   .
     1430                   case v-current-char
     1431                   :
     1432                       when chr(1)
     1433                       then do:
