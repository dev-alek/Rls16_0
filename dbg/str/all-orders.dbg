     8917       mark-string( input recid(X_order), input v-rid-list) column-label "*" format "X(1)":U
     8918       X_order.order-item column-label "№ заказа" FORMAT "X(12)":U width 12
     8919       get-sts(X_order.sts) column-label "Статус" FORMAT "X(256)":U width 15
     8920       X_order.order-date column-label "Дата поставки" FORMAT "99/99/9999":U width 15
     8921       X_order.doc-date column-label "Дата создания" FORMAT "99/99/9999":U width 15
     8922       X_order.cli-code column-label "Код пост-ка" format ">>>999":U width 12
     8923       cli-name(X_order.cli-code, X_order.cli-type) column-label "Поставщик" FORMAT "x(256)":U width 30
     8924       X_order.contract-prn-code column-label "Номер договора" FORMAT "x(256)":U width 30
     8925       user-name(X_order.user-id) column-label "Исполнитель" FORMAT "x(256)":U width 30
     8926       X_order.doc-code column-label "№ заказа в ТН" FORMAT ">>>>>>>>>9":U width 15
     8927       WITH NO-ROW-MARKERS SEPARATORS SIZE 130 BY 23.08 FIT-LAST-COLUMN.
     8928   DEFINE FRAME d-order
     8929       b-exit AT ROW 1 COL 1.5 WIDGET-ID 4
