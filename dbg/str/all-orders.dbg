     1114   function setattrUtdlines returns logical
     1115   (idb-num   as integer,
     1116    idoc-id   as integer,
     1117    ilinenum  as integer,
     1118    iattrcode as character,
     1119    iattrval  as character ):
     1120      define buffer utd-lines-attr for utd-lines-attr.
     1121      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1122                                  and utd-lines-attr.doc-id    eq idoc-id
     1123                                  and utd-lines-attr.lineNum   eq ilineNum
     1124                                  and utd-lines-attr.attr-code eq iattrcode
     1125      no-lock no-error.
     1126      if not available utd-lines-attr
     1127      then do:
     1128         if iattrval ne ?
     1129            and iattrval ne ""
     1130         then do:
     1131            create utd-lines-attr.
     1132            assign
     1133               utd-lines-attr.db-num    = idb-num
     1134               utd-lines-attr.doc-id    = idoc-id
     1135               utd-lines-attr.lineNum   = ilineNum
     1136               utd-lines-attr.attr-code = iattrcode
     1137               utd-lines-attr.attr-value = iattrval
     1138            .
     1139         end.
     1140      end.
     1141      else do:
     1142         if utd-lines-attr.attr-value ne iattrval
     1143         then do:
     1144            find current utd-lines-attr exclusive-lock no-error.
     1145            if available utd-lines-attr
     1146            then do:
     1147               if    iattrval eq ?
     1148                  or iattrval eq ""
     1149               then do:
     1150                  delete utd-lines-attr.
     1151               end.
     1152               else do:
     1153                  utd-lines-attr.attr-value = iattrval.
     1154               end.
     1155            end.
     1156         end.
     1157      end.
     1158      release utd-lines-attr.
     1159   end.
