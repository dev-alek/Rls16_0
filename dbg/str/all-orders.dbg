      133     run proc-alt-shift-f2.
      134   end.
      135   on alt-shift-f3 anywhere do:
      136     run proc-alt-shift-f3 in this-procedure .
      137   end.
      138   on alt-shift-f4 anywhere do:
      139     run proc-alt-shift-f4 in this-procedure.
      140   end.
      141   on alt-f1 anywhere do:
      142     run proc-alt-f1 in this-procedure .
      143   end.
      144   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define variable v-waitfram-action01         as character   no-undo .
      146   define variable v-waitfram-action02         as character   no-undo .
      147   define variable v-waitfram-action03         as character   no-undo .
      148   define variable mWaitFramTextBeg            as character   no-undo.
      149   define variable mWaitFramTextEnd            as character   no-undo.
      150   define variable mWaitFramView               as logical     no-undo.
      151   define variable mWaitProcEvent              as logical     no-undo init yes.
      152   define variable mWaitFramInterval           as integer     no-undo init 1 .
      153   define variable mWaitFramStop               as logical     no-undo.
      154   define variable mWaitFramStopUser           as logical     no-undo.
      155   define variable mWaitFramStopTimeOut        as logical     no-undo.
      156   define variable mWaitFramStartProc          as datetime-tz no-undo.
      157   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      158   define button B-WaitFramStop auto-end-key
      159        label "Стоп"
      160        size 10 by 1 tooltip "Остоновить процесс".
      161   define button B-viewProcInfo
      162        label "Информация"
      163        size 15 by 1 tooltip "Информация о процесс".
      164   define frame waitfram
      165     v-waitfram-action01 format "x(72)" no-label skip
      166     v-waitfram-action02 format "x(72)" no-label skip
      167     v-waitfram-action03 format "x(72)" no-label skip
      168     B-viewProcInfo
      169     B-WaitFramStop at row 4 col 30
      170     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      171     .
      172   define new global shared variable mBatchMode as logical no-undo init ?.
      173   define variable mFramBachModHandle as handle no-undo.
      174   mFramBachModHandle = frame waitfram:handle.
      175   define variable mFameOldVis as logical no-undo.
      176   define variable mVisCUrentVin as logical no-undo.
      177   if session:batch-mode
      178   then
      179      mBatchMode = yes.
      180   if mBatchMode = ? then do:
      181     mVisCUrentVin = current-window:visible.
      182     mFameOldVis = mFramBachModHandle:visible.
      183     mFramBachModHandle:visible  = yes.
      184     mBatchMode = mFramBachModHandle:visible ne yes.
      185     mFramBachModHandle:visible = mFameOldVis.
      186     current-window:visible = mVisCUrentVin.
      187   end.
      188    if  log-manager:logfile-name ne ?
      189     then DO:
      190         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      191         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      192         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      193     end.
      194   on choose of B-WaitFramStop in frame waitfram
      195   do:
      196     mWaitFramStop = yes.
      197     mWaitFramStopUser = yes.
      198   end.
      199   function waitfram-check-timeout returns logical():
      200      define variable vtime as int64 no-undo.
      201      if mWaitFramStopTimeOut
      202      then
      203         return yes.
      204      vtime = ( now - mWaitFramStartProc ) / 1000 .
      205      if     mWaitFramTimeOut ne ?
      206         and mWaitFramTimeOut ne 0
      207         and mWaitFramTimeOut lt vtime
      208      then do:
      209         mWaitFramStopTimeOut = yes.
      210      end.
      211      return mWaitFramStopTimeOut.
      212   end.
      213   procedure waitfram-hide :
      214     if not session:batch-mode
      215     then do
      216     on error undo, return error return-value
      217     :
      218       pause 0 before-hide .
      219       if not mBatchMode then
      220         hide frame waitfram .
      221     if     not mWaitFramView
      222        and mWaitProcEvent
      223     then
      224       process events .
      225     end.
      226   end procedure.
      227   procedure waitfram-show :
      228     define input  parameter p-message as character no-undo .
      229     define variable v-left-margin as integer   no-undo .
      230     if not session:batch-mode
      231     then do
      232     on error undo, return error return-value
      233     :
      234       if length(p-message) <= 70 then do:
      235         assign
      236           v-left-margin = integer((70 - length(p-message)) / 2)
      237         .
      238         assign
      239           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      240         .
      241         assign
      242           v-waitfram-action01 = " "
      243           v-waitfram-action02 = " "
      244                                    + fill(" ", v-left-margin)
      245                                    + p-message
      246           v-waitfram-action03 = " "
      247         .
      248       end.
      249       else do:
      250         define variable vRindex1 as integer no-undo.
      251         define variable vRindex2 as integer no-undo.
      252         vRindex1 = r-index(p-message," ",70).
      253         if vRindex1 = 0
      254         then
      255            vRindex1 = 70.
      256         if length(p-message)  <= vRindex1 + 70 then do:
      257           assign
      258             v-waitfram-action01 = " "
      259             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      260             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      261           .
      262         end.
      263         else do:
      264           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      265           if vRindex2 <= vRindex1
      266           then
      267              vRindex2 = vRindex1 + 70.
      268           assign
      269             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      270             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      271             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      272           .
      273         end.
      274       end.
      275       B-viewProcInfo:visible   in frame waitfram = no.
      276       B-viewProcInfo:sensitive in frame waitfram = no.
      277       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      278       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      279       if  (   mWaitFramView
      280          or  mWaitProcEvent)
      281          and not mBatchMode
      282       then
      283          display
      284             v-waitfram-action01 skip
      285             v-waitfram-action02 skip
      286             v-waitfram-action03 skip
      287          with frame waitfram .
      288       if     mWaitFramView
      289          then do:
      290             if     mWaitFramInterval ne ?
      291                and not mBatchMode
      292             then
      293                wait-for go of frame waitfram pause mWaitFramInterval.
      294          end.
      295          else
      296             if     mWaitProcEvent
      297                and not mBatchMode
      298             then
      299                process events .
      300     end.
      301   end procedure.
      302      procedure waitfram-show-this:
      303         define input  parameter iInterval as int64 no-undo.
      304         define variable vtime as int64 no-undo.
      305         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      306         mWaitFramInterval = iInterval.
      307         run waitfram-show (substitute("&1&2 &3&4" ,
      308                                       mWaitFramTextBeg ,
      309                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      310                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      311                                       mWaitFramTextEnd
      312                                      )
      313                           ).
      314      end.
      315      procedure WaitFramRunPause:
      316         define input  parameter iInterval as dec no-undo.
      317         define variable vStart  as datetime-tz no-undo.
      318         define variable vend    as datetime-tz no-undo.
      319         define variable vint as int64 no-undo.
      320         define variable vOk as logical no-undo.
      321         vStart = now.
      322         vend   = vStart.
      323         publish "WaitFramPause" (iInterval,output vOk).
      324         vend   =  now.
      325         vint = vend - vStart.
      326         vint = iInterval - vint / 1000.
      327         if     not mWaitFramStop
      328            and (   vint > 0
      329                 or (    not vOk
      330                     and iInterval eq ?
      331                     )
      332                 )
      333         then
      334            run waitfram-show-this (iInterval).
      335         vend   =  now.
      336         vint = vend - vStart.
      337         vint = iInterval - vint / 1000.
      338         if     not mWaitFramStop
      339            and vint > 0
      340         then do:
      341            run gbl/pause.p (vint * 1000).
      342         end.
      343         if iInterval ne ?
      344         then
      345            publish "WaitFramStop".
      346         waitfram-check-timeout().
      347      end.
      348      procedure WaitFramWaitFor:
      349         define input  parameter iInterval as dec no-undo.
      350         assign
      351            mWaitFramStartProc   = now
      352            mWaitFramStopUser    = no
      353            mWaitFramStopTimeOut = no
      354         .
      355         block-wait:
      356         do while not mWaitFramStop:
      357            run WaitFramRunPause (iInterval).
      358            if  waitfram-check-timeout()
      359            then do:
      360               leave block-wait.
      361            end.
      362         end.
      363         run waitfram-hide.
      364      end.
      365   procedure waitfram-join :
      366     define input  parameter p-line-1  as character no-undo .
      367     define input  parameter p-line-2  as character no-undo .
      368     define input  parameter p-line-3  as character no-undo .
      369     define output parameter p-message as character no-undo .
      370     do
      371     on error undo, return error return-value
      372     :
      373       assign
      374         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      375                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      376                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      377       .
      378     end.
      379   end procedure.
      380   function waitfram-join-function returns character
      381     (input p-line-1 as character
      382     ,input p-line-2 as character
      383     ,input p-line-3 as character
      384     ).
      385     define variable v-message as character no-undo .
      386     run waitfram-join in this-procedure
      387       (input  p-line-1
      388       ,input  p-line-2
      389       ,input  p-line-3
      390       ,output v-message
      391       ) .
      392     return v-message .
      393   end function .
