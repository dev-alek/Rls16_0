     9078               empty temp-table gds-list.
     9079               for each ub.order-line no-lock where
     9080                   ub.order-line.db-num = buf_X_order.db-num and
     9081                   ub.order-line.doc-code = buf_X_order.doc-code:
     9082                   find first buf_goods no-lock where buf_goods.gds-code = ub.order-line.gds-code no-error .
     9083                   if available (buf_goods) then
     9084                   do:
     9085                       find first gds-list where gds-list.gds-code = buf_goods.gds-code and gds-list.contract = buf_X_order.contract-prn-code no-error .
     9086                       if not available (gds-list) then
