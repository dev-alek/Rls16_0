     5094                   input  ub.goods.prod-type  ,
     5095                   input  ub.goods.prod-code  ,
     5096                   input  ub.prt-obj.prt-code ,
     5097                   output old-val ,
     5098                   output v-fact-order
     5099                   ).
     5100           end.
     5101           else
     5102           do:
     5103               old-val = 0.
     5104               v-fact-order  = ub.trn-doc.fact-order.
     5105           end.
     5106       end.
