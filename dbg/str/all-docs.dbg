     8332                             ,input 'trn-doc-image':U
     8333                             ,input 'trn-doc-image':U
     8334                             ,input-output v-part-num
     8335                             ,input 'data':U
     8336                             ,input-output v-blob-db-num
     8337                             ,input-output v-int64-id
     8338                             ,input v-file-imafe-name
     8339                             ) no-error .
     8340         if error-status :error then do:
     8341           message
