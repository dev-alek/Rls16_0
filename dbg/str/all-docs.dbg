    21595   procedure proc-m_gen-13 :
    21596   define buffer bf_sysconf for ub.sysconf.
    21597   define buffer bf_trn-doc for ub.trn-doc.
    21598   define variable vari as integer no-undo.
    21599   define variable vardoc-code as integer no-undo.
    21600   define variable varneed-incfo as logical no-undo.
    21601   define buffer bf_parts    for ub.parts.
    21602   define buffer bf_contract for ub.contract.
    21603   do
    21604   on error undo, return error return-value
    21605   :
    21606   if mark-list = "" then do:
    21607     if available t-doc then do:
    21608       assign
    21609         mark-list = string(recid(t-doc)).
    21610     end.
    21611   end.
    21612   vari-cycle:
    21613   do vari = 1 to num-entries (mark-list):
    21614     assign
    21615       vardoc-code = integer(entry (vari, mark-list)).
    21616     find first bf_trn-doc where recid(bf_trn-doc) = vardoc-code exclusive-lock.
    21617     find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
    21618     if bf_trn-doc.status_ <> 'факт':U then do:
    21619       message "Документ " bf_trn-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
    21620       view-as alert-box.
    21621       next.
    21622     end.
    21623     if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    21624       message "Главная БД для фирмы по документу с кодом " bf_trn-doc.doc-code " не является текущей БД." skip
    21625               "Текущая БД: " v-cntxt-db-num skip
    21626               "Главная БД фирмы: " bf_sysconf.firm-db-num
    21627       view-as alert-box error.
    21628       return error.
    21629     end.
    21630     if bf_trn-doc.need-incfo = 2 then do:
    21631       assign
    21632         varneed-incfo = no.
    21633       for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code on error undo, return error return-value :
    21634         if bf_parts.contract-code <> 0 then do:
    21635           find first bf_contract where bf_contract.host-code     = bf_trn-doc.host-code   and
    21636                                        bf_contract.contract-code = bf_parts.contract-code no-lock no-error.
    21637           if available bf_contract then do:
    21638             if lookup (bf_contract.usl-opl, 'По факту поставки,Отсрочка платежа (по поставке)') > 0 then do:
    21639               assign
    21640                 varneed-incfo = yes.
    21641             end.
    21642           end.
    21643         end.
    21644       end.
    21645       if varneed-incfo then do:
    21646         assign
    21647           bf_trn-doc.need-incfo      = 1
    21648           bf_trn-doc.need-expfo      = 0
    21649           bf_trn-doc.need-incorexpfo = 1
    21650         .
