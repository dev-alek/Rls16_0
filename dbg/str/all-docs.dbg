     5205           ub.gds-dtl.doc-code  = ub.trn-doc.doc-code   and
     5206           ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     5207           ub.gds-dtl.prod-type = ub.doc-line.prod-type and
     5208           ub.gds-dtl.artic     = ub.doc-line.artic     and
     5209           ub.gds-dtl.prt-code  = ub.gds-prt.node-code  no-error.
     5210       assign
     5211           varnew_gds-dtl = ( not available ub.gds-dtl ).
     5212   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     5213     ( input ub.doc-line.obj-code
