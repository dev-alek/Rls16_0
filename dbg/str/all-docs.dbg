     8787   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8788   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
     8789     (input  parparentproc
     8790     ,input  t-doc.doc-code
     8791     ,output table gds-list
     8792     ) no-error .
     8793       if error-status :error
     8794         then
     8795       do:
     8796         find t-doc no-lock
     8797           where recid( t-doc) = pardoc-rec
     8798           .
     8799         return no-apply.
     8800       end.
     8801       find t-doc
     8802         no-lock where recid( t-doc ) = pardoc-rec.
     8803       if t-doc.status_ = 'факт':U then
     8804       do:
     8805         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8806           ub.inv-doc-attr.attr-code = 'ItogInv' no-error .
     8807         if available(ub.inv-doc-attr) then
     8808         do:
     8809           for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code begins ub.inv-doc-attr.attr-value:
     8810             if entry(2,ub.trn-doc.doc-code,"/") = "и" then next .
     8811             delete ub.trn-doc .
     8812           end.
     8813         for each del_inv-doc-attr exclusive-lock where del_inv-doc-attr.attr-value = t-doc.doc-code and
     8814         del_inv-doc-attr.attr-code = "MultiTSD":
     8815          find first ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = del_inv-doc-attr.doc-code no-error .
     8816          if available (ub.trn-doc) then delete ub.trn-doc .
     8817         end.
     8818         end.
     8819         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8820           ub.inv-doc-attr.attr-code = 'ItogInvManual' no-error .
     8821         if available(ub.inv-doc-attr) then
     8822         do:
     8823           for each bf_inv-doc-attr no-LOCK where bf_inv-doc-attr.attr-value = t-doc.doc-code and
     8824             bf_inv-doc-attr.attr-code = 'ManualTSD':
     8825             for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = bf_inv-doc-attr.doc-code:
     8826               if docCode = "" then docCode = ub.trn-doc.doc-code .
     8827               else docCode = docCode + ";" + ub.trn-doc.doc-code .
     8828               delete ub.trn-doc .
     8829               for first curr_inv-doc-attr EXCLUSIVE-LOCK where curr_inv-doc-attr.attr-code = bf_inv-doc-attr.attr-code and
     8830               curr_inv-doc-attr.doc-code = bf_inv-doc-attr.doc-code:
     8831               delete bf_inv-doc-attr .
     8832               end.
     8833             end.
     8834           end.
     8835           define variable dd as integer no-undo .
     8836           do dd = 1 to num-entries(docCode,";"):
     8837                 for first bf_inv-doc-attr no-lock where bf_inv-doc-attr.attr-code = 'isManualError' and
     8838                     bf_inv-doc-attr.doc-code = entry(dd,docCode,";") + "-M" :
     8839                     message "В системе есть ошибочные накладные инвентаризации." skip
     8840                         "Удалить их?"  view-as alert-box question buttons yes-no update v-ok as logical .
     8841                     if v-ok then
     8842                     do:
     8843                         for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = bf_inv-doc-attr.doc-code:
     8844                             delete ub.trn-doc .
     8845                         end.
     8846                     end.
     8847                 end.
     8848             end.
     8849         end.
     8850       end.
     8851       if t-doc.status_ = 'разрешен':U then
     8852       do:
     8853         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8854           ub.inv-doc-attr.attr-code = 'ItogInvManual' no-error .
     8855         if available(ub.inv-doc-attr) then
     8856         do:
     8857           do ii = 1 to num-entries(ub.inv-doc-attr.attr-value):
     8858             create bf_inv-doc-attr .
     8859             assign
     8860               bf_inv-doc-attr.attr-code  = 'ManualTSD'
     8861               bf_inv-doc-attr.doc-code   = entry(ii,ub.inv-doc-attr.attr-value)
     8862               bf_inv-doc-attr.attr-value = t-doc.doc-code
     8863               .
     8864           end.
     8865         end.
     8866       end.
     8867       run UI-on in this-procedure ( input "open" ) .
     8868       reposition br-docs to recid pardoc-rec no-error.
     8869     END.
     8870   procedure plgdsfnd :
     8871     define input  parameter p-chk-and-chs    as logical               no-undo .
     8872     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     8873     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     8874     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     8875     define output parameter p-reserv-pl-code as   logical             no-undo .
     8876     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     8877     define buffer buf_goods         for ub.goods .
     8878     define buffer buf_pl-gds        for ub.pl-gds .
     8879     define buffer buf_second_pl-gds for ub.pl-gds .
     8880     find first buf_goods no-lock where
     8881                buf_goods.gds-code = p-gds-code no-error .
     8882     if not available buf_goods
     8883     then do:
     8884       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     8885     end.
     8886   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     8888     (input  p-obj-type
     8889     ,input  p-obj-code
     8890     ,input  buf_goods.artic
     8891     ,input  buf_goods.prod-type
     8892     ,input  buf_goods.prod-code
     8893     ,input  'place-rsrv=request'
     8894     ,output p-reserv-pl-code
     8895     ) no-error .
     8896     if error-status :error
     8897     then do:
     8898       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     8899     end.
     8900     if p-reserv-pl-code = no
     8901     then do:
     8902       return .
     8903     end.
     8904     if p-chk-and-chs <> yes
     8905     then do:
     8906       return .
     8907     end.
     8908     find first buf_pl-gds no-lock where
     8909                buf_pl-gds.obj-type = p-obj-type and
     8910                buf_pl-gds.obj-code = p-obj-code and
     8911                buf_pl-gds.gds-code = p-gds-code no-error .
     8912     if not available buf_pl-gds
     8913     then do:
     8914       return error "К товару не привязано ни одного места хранения" .
     8915     end.
     8916     find first buf_second_pl-gds no-lock where
     8917                buf_second_pl-gds.obj-type  = p-obj-type          and
     8918                buf_second_pl-gds.obj-code  = p-obj-code          and
     8919                buf_second_pl-gds.gds-code  = p-gds-code          and
     8920                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     8921     if not available buf_second_pl-gds
     8922     then do:
     8923       assign
     8924         p-pl-code = buf_pl-gds.pl-code
     8925       .
     8926     end.
     8927     else do:
     8928       if not valid-handle( parparentproc )
     8929       then do:
     8930         return error "Не выбрано место хранения " + chr(10) .
     8931       end.
     8932       run str/plgdssel.p
     8933         (
     8934            input parparentproc
     8935         ,  input p-obj-type
     8936         ,  input p-obj-code
     8937         ,  input p-gds-code
     8938         , output p-pl-code
     8939         ) no-error .
     8940       if error-status :error
     8941       then do:
     8942         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     8943                                , 'plgdssel.p':U
     8944                                , chr(10)
     8945                                , error-status :get-message( 1 )
     8946                                , return-value
     8947                                ) .
     8948       end.
     8949       if p-pl-code = ? or
     8950          p-pl-code = 0
     8951       then do:
     8952         return error "Не выбрано место хранения " + chr(10) .
     8953       end.
     8954     end.
     8955   end procedure.
