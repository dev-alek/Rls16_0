    23638       then do:
    23639   define variable vss-include-info257 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    23640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    23641     (input  buf_doc-line.obj-type
    23642     ,input  buf_doc-line.obj-code
    23643     ,input  buf_doc-line.artic
    23644     ,input  buf_doc-line.prod-type
    23645     ,input  buf_doc-line.prod-code
    23646     ,input  'place-rsrv=request'
    23647     ,output l-reserv-pl-code
    23648     ) no-error .
    23649         if l-reserv-pl-code = yes then do:
    23650           assign
    23651             v-rvs-list = "":U
    23652           .
    23653           if buf_trn-doc.doc-type = 'при':U then do:
    23654             for each buf_rvs-doc no-lock
    23655               where buf_rvs-doc.out-code = buf_trn-doc.doc-code
    23656             on error undo, return error return-value
    23657             :
    23658               if v-rvs-list <> "":U then do:
    23659                 assign
    23660                   v-rvs-list = v-rvs-list + chr(44)
    23661                 .
    23662               end.
    23663               assign
    23664                 v-rvs-list = v-rvs-list + substitute( "&1", buf_rvs-doc.rvs-code )
    23665               .
    23666             end.
    23667           end.
    23668           for each buf_doc-pl no-lock
    23669             where buf_doc-pl.obj-type = buf_doc-line.obj-type
    23670               and buf_doc-pl.obj-code = buf_doc-line.obj-code
    23671               and buf_doc-pl.out-code = buf_doc-line.doc-code
    23672               and buf_doc-pl.gds-code = buf_goods.gds-code
    23673           on error undo, return error return-value
    23674           :
    23675             run trg/lockplgd.p
    23676               ( input buf_doc-line.obj-type
    23677               , input buf_doc-line.obj-code
    23678               , input buf_doc-pl.pl-code
    23679               , input buf_goods.gds-code
    23680               , input "check-rvs-on=false"
    23681               , input v-rvs-list
    23682               , input false
    23683               ) no-error .
    23684             if error-status :error then do:
    23685               message
    23686                 vss-workfile vss-revision vss-description skip
    23687                 "Товар заблокирован на складском месте" skip
    23688                 error-status :get-message(1) skip
    23689                 return-value skip
    23690                 view-as alert-box error .
    23691               return error .
    23692             end.
    23693           end.
    23694         end.
    23695       end.
    23696       if p-check-inv = yes then do:
    23697         define variable l-inv-on as logical no-undo .
    23698   define variable vss-include-info258 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    23699   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    23700     (input  buf_doc-line.obj-type
    23701     ,input  buf_doc-line.obj-code
    23702     ,input  buf_doc-line.artic
    23703     ,input  buf_doc-line.prod-type
    23704     ,input  buf_doc-line.prod-code
    23705     ,input  'inv-on=request'
    23706     ,output l-inv-on
    23707     ) no-error .
    23708         if error-status :error then do:
    23709           message
    23710             vss-workfile vss-revision vss-description skip
    23711             "Ошибка получения признака товара на объекте" skip
    23712             error-status :get-message(1) skip
    23713             return-value skip
    23714             view-as alert-box error .
    23715           return no-apply .
    23716         end.
    23717         if l-inv-on then do:
    23718           define variable v-doc-with-inv as logical no-undo .
    23719           assign
    23720             v-doc-with-inv = false
    23721           .
    23722           for each inv_doc-line no-lock
    23723             where ( inv_doc-line.obj-type      = buf_doc-line.obj-type
    23724                     and inv_doc-line.obj-code  = buf_doc-line.obj-code
    23725                     and inv_doc-line.artic     = buf_doc-line.artic
    23726                     and inv_doc-line.prod-type = buf_doc-line.prod-type
    23727                     and inv_doc-line.prod-code = buf_doc-line.prod-code
    23728                     and inv_doc-line.status_   = 'разрешен':U
    23729                   )
    23730                or ( inv_doc-line.obj-type      = buf_doc-line.obj-type
    23731                     and inv_doc-line.obj-code  = buf_doc-line.obj-code
    23732                     and inv_doc-line.artic     = buf_doc-line.artic
    23733                     and inv_doc-line.prod-type = buf_doc-line.prod-type
    23734                     and inv_doc-line.prod-code = buf_doc-line.prod-code
    23735                     and inv_doc-line.status_   = 'нередакт':U
    23736                   )
    23737           ,first inv_trn-doc no-lock
    23738             where inv_trn-doc.doc-code     = inv_doc-line.doc-code
    23739           :
    23740             if inv_trn-doc.doc-type     = 'инв':U
    23741               and ( inv_trn-doc.status_    = 'разрешен':U
    23742                     or inv_trn-doc.status_ = 'нередакт':U
    23743                   )
    23744               and inv_trn-doc.flag_        = true
    23745               and inv_trn-doc.ext-doc-type = 'vt':U
    23746             then do:
    23747               if inv_trn-doc.doc-code begins buf_trn-doc.out-code
    23748               then do:
    23749                 assign
    23750                   v-doc-with-inv = true
    23751                 .
    23752               end.
    23753               else do:
    23754                 find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.attr-code = 'invMultDevice' and
    23755                 ub.inv-doc-attr.doc-code = inv_trn-doc.doc-code and
    23756                 ub.inv-doc-attr.attr-value = string(true) no-error .
    23757                 if not available(ub.inv-doc-attr) then do:
    23758                 vErrorMessage = substitute(
    23759                   "Товар: &1 &2 &3~n&4~nна объекте &5 &6~nсейчас в инвентаризации (Документ № &7).",
    23760                   buf_goods.artic,
    23761                   buf_goods.prod-type,
    23762                   buf_goods.prod-code,
    23763                   buf_goods.gds-name,
    23764                   inv_doc-line.obj-type,
    23765                   inv_doc-line.obj-code,
    23766                   inv_doc-line.doc-code
    23767                 ).
    23768                   message vErrorMessage view-as alert-box information .
    23769                 return error vErrorMessage.
    23770               end.
    23771             end.
    23772           end.
    23773           end.
    23774           for each inv_doc-line no-lock
    23775             where inv_doc-line.obj-type  = buf_doc-line.obj-type
    23776               and inv_doc-line.obj-code  = buf_doc-line.obj-code
    23777               and inv_doc-line.artic     = buf_doc-line.artic
    23778               and inv_doc-line.prod-type = buf_doc-line.prod-type
    23779               and inv_doc-line.prod-code = buf_doc-line.prod-code
    23780               and inv_doc-line.status_   = 'накл':U
    23781           ,first inv_trn-doc no-lock
    23782             where inv_trn-doc.doc-code     = inv_doc-line.doc-code
    23783               and inv_trn-doc.doc-type     = 'инв':U
    23784               and inv_trn-doc.status_      = 'накл':U
    23785               and inv_trn-doc.flag_        = false
    23786               and inv_trn-doc.ext-doc-type = 'ap':U
    23787           :
    23788             vErrorMessage = substitute(
    23789                   "Товар: &1 &2 &3~n&4~nна объекте &5 &6~nсейчас в коррекции учетных цен (Документ № &7).",
    23790                   buf_goods.artic,
    23791                   buf_goods.prod-type,
    23792                   buf_goods.prod-code,
    23793                   buf_goods.gds-name,
    23794                   inv_doc-line.obj-type,
    23795                   inv_doc-line.obj-code,
    23796                   inv_doc-line.doc-code
    23797                 ).
    23798               message vErrorMessage view-as alert-box information .
    23799             return error vErrorMessage.
    23800           end.
    23801           for each inv_doc-line no-lock
    23802             where inv_doc-line.obj-type  = buf_doc-line.obj-type
    23803               and inv_doc-line.obj-code  = buf_doc-line.obj-code
    23804               and inv_doc-line.artic     = buf_doc-line.artic
    23805               and inv_doc-line.prod-type = buf_doc-line.prod-type
    23806               and inv_doc-line.prod-code = buf_doc-line.prod-code
    23807               and inv_doc-line.status_   = 'накл':U
    23808           ,first inv_trn-doc no-lock
    23809             where inv_trn-doc.doc-code     = inv_doc-line.doc-code
    23810               and inv_trn-doc.doc-type     = 'инв':U
    23811               and inv_trn-doc.status_      = 'накл':U
    23812               and inv_trn-doc.flag_        = false
    23813               and inv_trn-doc.ext-doc-type = 'vp':U
    23814           :
    23815             vErrorMessage = substitute(
    23816               "Товар :&1 &2 &3~n&4~nна объекте &5 &6~nсейчас в пересортице (Документ № &7).",
    23817               buf_goods.artic,
    23818               buf_goods.prod-type,
    23819               buf_goods.prod-code,
    23820               buf_goods.gds-name,
    23821               inv_doc-line.obj-type,
    23822               inv_doc-line.obj-code,
    23823               inv_doc-line.doc-code).
    23824                 message vErrorMessage view-as alert-box information .
    23825             return error vErrorMessage.
    23826           end.
    23827           if v-doc-with-inv = false then do:
    23828             vErrorMessage = substitute(
    23829                   "Товар: &1 &2 &3~nна объекте &4 &5~nотмечен, как принадлежащий документу с типом инвентаризация~n~
    23830   Документ коррекции учетных цен не найден.",
    23831                   buf_goods.artic,
    23832                   buf_goods.prod-type,
    23833                   buf_goods.prod-code,
    23834                   inv_doc-line.obj-type,
    23835                   inv_doc-line.obj-code
    23836                 ).
    23837               message vErrorMessage view-as alert-box information .
    23838             return error vErrorMessage.
    23839           end.
    23840         end.
    23841       end.
    23842       if false  then do:
    23843         for each inv_doc-line no-lock
    23844           where inv_doc-line.obj-type     = buf_doc-line.obj-type
    23845             and inv_doc-line.obj-code     = buf_doc-line.obj-code
    23846             and inv_doc-line.artic        = buf_doc-line.artic
    23847             and inv_doc-line.prod-type    = buf_doc-line.prod-type
    23848             and inv_doc-line.prod-code    = buf_doc-line.prod-code
    23849             and inv_doc-line.ext-doc-type = 'vt':U
    23850             and inv_doc-line.status_      = 'разрешен':U
    23851             and inv_doc-line.doc-code     <> vardoc-code
    23852         ,first ub.trn-doc no-lock
    23853           where ub.trn-doc.doc-code       = inv_doc-line.doc-code
    23854             and ub.trn-doc.flag_          = no
    23855         :
    23856           vErrorMessage = substitute(
    23857             "На объекте &1 &2~nсуществует инвентаризация (Документ №&3) по товару~n&4 &5 &6~n&7~nНаходящаяся в статусе ~"&8&9~".",
    23858             inv_doc-line.obj-type,
    23859             inv_doc-line.obj-code,
    23860             inv_doc-line.doc-code,
    23861             buf_goods.artic,
    23862             buf_goods.prod-type,
    23863             buf_goods.prod-code,
    23864             buf_goods.gds-name,
    23865             STRING(ub.trn-doc.status_),
    23866             STRING(ub.trn-doc.flag_, "+/-")
    23867           ).
    23868               message vErrorMessage view-as alert-box information .
    23869           return error vErrorMessage.
    23870         end.
    23871       end.
    23872     end.
    23873       for each buf_doc-line no-lock
    23874       where buf_doc-line.doc-code = vardoc-code
    23875     :
    23876         for each gds-obj exclusive-lock where gds-obj.artic = buf_doc-line.artic and
    23877           gds-obj.prod-code = buf_doc-line.prod-code and
    23878           gds-obj.prod-type = buf_doc-line.prod-type and
    23879           gds-obj.obj-code = buf_doc-line.obj-code and
    23880           gds-obj.obj-type = buf_doc-line.obj-type:
    23881           assign
    23882             gds-obj.inv-on = true
    23883             gds-obj.in-ov  = true .
    23884         end.
    23885       end.
    23886       run str/clcsumga.p ( input buf_trn-doc.doc-code ).
    23887       find first t-doc where t-doc.doc-code = vardoc-code no-error .
    23888       for first ub.inv-doc-attr exclusive-lock where
    23889       ub.inv-doc-attr.doc-code = vardoc-code and
    23890       ub.inv-doc-attr.attr-code = "notMes":
    23891         delete ub.inv-doc-attr .
    23892       end.
    23893       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
    23894         ub.inv-doc-attr.attr-code = 'ItogInv' no-error .
    23895       if available(ub.inv-doc-attr) then
    23896       do:
    23897         for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = ub.inv-doc-attr.attr-value:
    23898           delete ub.trn-doc .
    23899         end.
    23900       end.
    23901     end.
    23902   end procedure.
    23903   procedure loc-cr-gds-dtl :
    23904     define variable n-c like ub.gds-prt.node-code          no-undo.
    23905     find first ub.gds-dtl where
    23906                ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
    23907                ub.gds-dtl.artic     = ub.doc-line.artic     and
    23908                ub.gds-dtl.prod-code = ub.doc-line.prod-code and
    23909                ub.gds-dtl.prod-type = ub.doc-line.prod-type no-error.
    23910     if not available ub.gds-dtl then do:
    23911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
    23912     (input  ub.goods.prt-root
    23913     ,output n-c
    23914     )  .
    23915   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
    23916     ( input ub.doc-line.obj-code
    23917      ,input ub.doc-line.obj-type
    23918      ,input t-doc.doc-code
    23919      ,input ub.doc-line.artic
    23920      ,input ub.doc-line.prod-code
    23921      ,input ub.doc-line.prod-type
    23922      ,input n-c
    23923      ,input yes
    23924     )  .
