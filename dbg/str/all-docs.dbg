     2523   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   function getattrUtdex returns char
     2525   (idb-num   as integer,
     2526    idoc-id   as integer,
     2527    iattrcode as character,
     2528    iExValue  as character  ):
     2529      define buffer utd-attr for utd-attr.
     2530      find first utd-attr where utd-attr.db-num eq idb-num
     2531                            and utd-attr.doc-id eq idoc-id
     2532                            and utd-attr.attr-code eq iattrcode
     2533      no-lock no-error.
     2534      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2535   end.
     2536   function getattrUtd returns char
     2537   (idb-num   as integer,
     2538    idoc-id   as integer,
     2539    iattrcode as character ):
     2540     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2541   end.
     2542   function setattrUtd returns logical
     2543   (idb-num   as integer,
     2544    idoc-id   as integer,
     2545    iattrcode as character,
     2546    iattrval  as character ):
     2547      define buffer utd-attr for utd-attr.
     2548      find first utd-attr where utd-attr.db-num eq idb-num
     2549                            and utd-attr.doc-id eq idoc-id
     2550                            and utd-attr.attr-code eq iattrcode
     2551      no-lock no-error.
     2552      if not available utd-attr
     2553      then do:
     2554         create utd-attr.
     2555         assign
     2556            utd-attr.db-num    = idb-num
     2557            utd-attr.doc-id    = idoc-id
     2558            utd-attr.attr-code = iattrcode
     2559            utd-attr.attr-value = iattrval
     2560         .
     2561      end.
     2562      else do:
     2563         if utd-attr.attr-value ne iattrval
     2564         then do:
     2565            find current utd-attr exclusive-lock no-error.
     2566            if available utd-attr
     2567            then
     2568               utd-attr.attr-value = iattrval.
     2569         end.
     2570      end.
     2571      release utd-attr.
     2572   end.
     2573   function GetAttrUtdlinesEx returns char
     2574   (idb-num   as integer,
     2575    idoc-id   as integer,
     2576    ilinenum  as integer,
     2577    iattrcode as character,
     2578    iExValue  as character  ):
     2579      define buffer utd-lines-attr for utd-lines-attr.
