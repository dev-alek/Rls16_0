     9024   define variable vss-include-info117 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9025   procedure minbtn-set :
     9026       do
     9027           on error undo, return error return-value
     9028           :
     9029           define variable ii              as integer       no-undo .
     9030           define variable fh              as widget-handle no-undo .
     9031           define variable hh              as widget-handle no-undo .
     9032           define variable v-h             as handle        extent 4 no-undo .
     9033           define variable v-name-button   as character     no-undo .
     9034           define variable v-help-old-x    as decimal       no-undo .
     9035           define variable v-help-old-y    as decimal       no-undo .
     9036           define variable v-help-old-size as decimal       no-undo .
     9037           define variable v-frame-width   as decimal       no-undo .
     9038           define variable jj              as integer       no-undo .
     9039           do
     9040               on error undo, return error
     9041               :
     9042               assign
     9043                   v-frame-width = frame d-all-docs:width - 0.3
     9044                   fh            = frame d-all-docs:first-child
     9045                   hh            = fh:first-child
     9046                   ii            = 1
     9047                   .
     9048               do while valid-handle(hh):
     9049                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     9050                   do:
     9051                       case lc(hh:name) :
     9052                           when "b-help" then
     9053                               do:
     9054                                   hh:load-image-up("cmp/b-help.bmp":u) .
     9055                                   hh:load-image-down("cmp/b-help.bmp":u) .
     9056                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     9057                                   hh:TOOLTIP = "Помощь" .
     9058                                   v-help-old-x = hh:column .
     9059                                   v-help-old-y = hh:row    .
     9060                                   v-help-old-size = hh:width .
     9061                                   hh:width-chars = 2.5 .
     9062                               end.
     9063                           when "b-print" then
     9064                               do:
     9065                                   hh:load-image("cmp/b-print.bmp":u) .
     9066                                   hh:TOOLTIP = "Печать" .
     9067                                   v-h[ii] = hh:handle .
     9068                                   ii = ii + 1 .
     9069                                   hh:width-chars = 3 .
     9070                               end.
     9071                           when "b-history" or
     9072                           when "b-hist" then
     9073                               do:
     9074                                   hh:load-image("cmp/b-hist.bmp":u) .
     9075                                   hh:TOOLTIP = "История" .
     9076                                   v-h[ii] = hh:handle .
     9077                                   ii = ii + 1 .
     9078                                   hh:width-chars = 3 .
     9079                               end.
     9080                           when "b-sch" then
     9081                               do:
     9082                                   hh:load-image("cmp/b-sch.bmp":u) .
     9083                                   hh:TOOLTIP = "Установка Фильтра" .
     9084                                   v-h[ii] = hh:handle .
     9085                                   ii = ii + 1 .
     9086                                   hh:width-chars = 3 .
     9087                               end.
     9088                           when "b-hist-user" then
     9089                               do:
     9090                                   hh:load-image("cmp/b-hist.bmp":u) .
     9091                                   hh:TOOLTIP = "История пользователя" .
     9092                                   ii = ii + 1 .
     9093                               end.
     9094                       end case.
     9095                   end.
     9096                   hh = hh:next-sibling.
     9097               end.
     9098               b-help:column = v-frame-width - b-help:width-chars.
     9099               jj = 0.
     9100               repeat ii = 4 to 1 by -1 :
     9101                   if valid-handle (v-h[ii] ) then
     9102                   do:
     9103                       jj  = jj + 1 .
     9104                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     9105                       v-h[ii]:row    = v-help-old-y .
     9106                   end.
     9107               end.
     9108           end.
     9109       end.
     9110   end procedure.
