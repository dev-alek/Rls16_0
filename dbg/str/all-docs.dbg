     8484                           ,input v-blob-uniq-key-rec
     8485                           ,input 'trn-doc-image':U
     8486                           ,input 'trn-doc-image':U
     8487                           ,input-output v-part-num
     8488                           ,input 'data':U
     8489                           ,input-output v-blob-db-num
     8490                           ,input-output v-int64-id
     8491                           ,input ?
     8492                           ) no-error .
     8493         if error-status :error then do:
     8494            message
     8495              vss-workfile vss-revision vss-description skip
     8496              error-status :get-message(1) skip
