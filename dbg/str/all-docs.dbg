     8271   ON CHOOSE OF b-filter-ext IN FRAME d-all-docs
     8272   DO:
     8273     if r-2 = 1 then r-2 = 2 .
     8274                else r-2 = 1.
     8275     if r-2 = 2 then do:
     8276        find first doc-list where doc-list.doc-code = "" no-error .
     8277        if available doc-list then delete doc-list.
     8278        release doc-list .
     8279       run str/fext-trn.w
     8280           ( parparentproc ,
     8281           v-cntxt-host-code-obj,
     8282           v-cntxt-obj-type,
     8283           v-cntxt-obj-code
     8284           ).
     8285       if not can-find (first doc-list ) then  do:
     8286           create doc-list.
     8287           doc-list.doc-code = "" .
     8288           release doc-list .
     8289           message "Расширенный фильтр пуст!" view-as alert-box information .
     8290       end.
     8291       b-filter-ext:LOAD-IMAGE ("cmp/b-sche.bmp") .
     8292        find last doc-list-hist.
     8293        b-filter-ext:tooltip =  doc-list-hist.des .
     8294     end.
     8295     else do:
     8296        b-filter-ext:LOAD-IMAGE ("cmp/b-schef.bmp") .
     8297        b-filter-ext:tooltip = "Расширенный фильтр не установлен" .
     8298     end.
