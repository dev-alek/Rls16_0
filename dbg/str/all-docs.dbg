    21672   procedure proc-m_gen-14 :
    21673   define buffer bf_sysconf for ub.sysconf.
    21674   define buffer bf_trn-doc for ub.trn-doc.
    21675   define variable vari as integer no-undo.
    21676   define variable vardoc-code as integer no-undo.
    21677   define variable varneed-expfo as logical no-undo.
    21678   define buffer bf_parts    for ub.parts.
    21679   define buffer bf_contract for ub.contract.
    21680   do
    21681   on error undo, return error return-value
    21682   :
    21683   if mark-list = "" then do:
    21684     if available t-doc then do:
    21685       assign
    21686         mark-list = string(recid(t-doc)).
    21687     end.
    21688   end.
    21689   vari-cycle:
    21690   do vari = 1 to num-entries (mark-list):
    21691     assign
    21692       vardoc-code = integer(entry (vari, mark-list)).
    21693     find first bf_trn-doc where recid(bf_trn-doc) = vardoc-code exclusive-lock.
    21694     find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
    21695     if bf_trn-doc.status_ <> 'факт':U then do:
