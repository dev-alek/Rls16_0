     7078   function is-mes returns logical
     7079           (input doc-code as character):
     7080   define variable result as logical no-undo init no.
     7081   find first ub.inv-doc-attr no-lock where
     7082   ub.inv-doc-attr.doc-code = doc-code and
     7083   ub.inv-doc-attr.attr-code = "notMes" and
     7084   ub.inv-doc-attr.attr-value = string(true) no-error .
     7085   if available (ub.inv-doc-attr) then result = true.
     7086   return result.
     7087   end function.
