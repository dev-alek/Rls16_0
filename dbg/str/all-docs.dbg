    23929                  ub.gds-dtl.prod-type = ub.doc-line.prod-type and
    23930                  ub.gds-dtl.prt-code  = n-c.
    23931       assign
    23932         ub.gds-dtl.fact-qnty = ub.doc-line.doc-qnty
    23933         ub.gds-dtl.doc-qnty  = 0
    23934       .
