    23394   procedure itogInvDoc :
    23395     define input parameter par-docCode as character no-undo .
    23396     define input parameter par-list as character no-undo .
    23397     define output parameter pardoc-rec   as recid     no-undo .
    23398     define variable vardoc-code  as character no-undo .
    23399     define variable ii           as integer   no-undo .
    23400     define variable line-rec     as recid     no-undo .
    23401     define variable old-line-rec as recid     no-undo .
    23402     define variable chg-qnty     like ub.doc-line.fact-qnty no-undo .
    23403     define variable p-document-fact-order like ub.trn-doc.fact-order no-undo .
    23404     define variable can-process   as logical no-undo .
    23405     define variable p-fact-close  as logical no-undo .
    23406     define variable p-is-news     as logical no-undo .
    23407     define variable l-reserv-pl-code as logical no-undo .
    23408     define variable v-rvs-list    as character no-undo .
    23409     define variable p-check-inv   as logical no-undo init yes.
    23410     define variable vErrorMessage as character no-undo .
    23411     define buffer buf_trn-doc      for ub.trn-doc .
    23412     define buffer bf_trn-doc       for ub.trn-doc .
    23413     define buffer buf_doc-line     for ub.doc-line .
    23414     define buffer bf_doc-line      for ub.doc-line .
    23415     define buffer old_doc-line     for ub.doc-line .
    23416     define buffer buf_trn-doc-sum  for ub.trn-doc-sum .
    23417     define buffer buf_doc-line-sum for ub.doc-line-sum .
    23418     define buffer bf_inv-doc-attr  for ub.inv-doc-attr .
    23419     define buffer buf_goods        for ub.goods .
    23420     define buffer buf_gds-obj      for ub.gds-obj .
    23421     define buffer buf_rvs-doc      for ub.rvs-doc .
    23422     define buffer buf_doc-pl       for ub.doc-pl .
    23423     define buffer inv_doc-line     for ub.doc-line .
    23424     define buffer inv_trn-doc      for ub.trn-doc .
    23425     do on error undo, return error return-value :
    23426       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = par-docCode no-error .
    23427       if not available (buf_trn-doc) then do:
    23428         message "Не выбран документ для создания итогового документа"
    23429           view-as alert-box.
    23430           return error .
    23431       end.
    23432       if num-entries (buf_trn-doc.doc-code,"/") > 0 then vardoc-code
    23433        = entry (1,buf_trn-doc.doc-code,"/") + "/и" .
    23434       else vardoc-code = buf_trn-doc.doc-code + "/и" .
    23435       if buf_trn-doc.status_ = 'накл':U then
    23436       do:
    23437       end.
    23438       create ub.trn-doc .
    23439       assign
    23440         ub.trn-doc.doc-code = vardoc-code
    23441         ub.trn-doc.out-code = buf_trn-doc.doc-code
    23442         .
    23443       if buf_trn-doc.status_ = 'накл':U then
    23444       do:
    23445         ub.trn-doc.status_ = 'накл':U.
    23446         ub.trn-doc.flag_    = no .
    23447       end.
    23448       else
    23449       do:
    23450         ub.trn-doc.status_ = 'накл':U.
    23451         ub.trn-doc.flag_    = true .
    23452       end.
    23453       buffer-copy buf_trn-doc except doc-code status_ flag_ out-code to ub.trn-doc .
    23454       release ub.trn-doc .
    23455       create ub.inv-doc-attr .
    23456       assign
    23457         ub.inv-doc-attr.doc-code   = vardoc-code
    23458         ub.inv-doc-attr.attr-code  = 'ItogInv'
    23459         ub.inv-doc-attr.attr-value = par-docCode
    23460         .
    23461       create ub.inv-doc-attr .
    23462       assign
    23463         ub.inv-doc-attr.doc-code   = vardoc-code
    23464         ub.inv-doc-attr.attr-code  = 'notMes'
    23465         ub.inv-doc-attr.attr-value = string(true)
    23466         .
    23467       do ii = 1 to num-entries (par-list):
    23468       create ub.inv-doc-attr .
    23469       assign
    23470       ub.inv-doc-attr.doc-code = entry(ii,par-list)
    23471       ub.inv-doc-attr.attr-code = "MultiTSD"
    23472       ub.inv-doc-attr.attr-value = vardoc-code .
    23473       end.
    23474       for each bf_inv-doc-attr no-lock where bf_inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    23475       bf_inv-doc-attr.attr-code <> "invMultDevice":
    23476           create ub.inv-doc-attr.
    23477           assign
    23478           ub.inv-doc-attr.doc-code = vardoc-code
    23479           ub.inv-doc-attr.attr-code = bf_inv-doc-attr.attr-code
    23480           ub.inv-doc-attr.attr-value = bf_inv-doc-attr.attr-value
    23481           .
    23482       end.
    23483       for each buf_doc-line no-lock where buf_doc-line.doc-code = par-docCode:
    23484         create ub.doc-line .
    23485         assign
    23486           ub.doc-line.doc-code  = vardoc-code
    23487           ub.doc-line.artic     = buf_doc-line.artic
    23488           ub.doc-line.prod-code = buf_doc-line.prod-code
    23489           ub.doc-line.prod-type = buf_doc-line.prod-type
    23490           ub.doc-line.line-num  = buf_doc-line.line-num
    23491           .
    23492         buffer-copy buf_doc-line except doc-code artic prod-code prod-type line-num to ub.doc-line .
    23493         create tt-line.
    23494         tt-line.fact-qnty = - buf_doc-line.doc-qnty .
    23495         tt-line.doc-qnty  = 0 .
    23496         buffer-copy ub.doc-line except doc-qnty fact-qnty to tt-line .
    23497         for first ub.gds-obj exclusive-lock where ub.gds-obj.artic = buf_doc-line.artic and
    23498         ub.gds-obj.prod-code = buf_doc-line.prod-code and
    23499         ub.gds-obj.prod-type = buf_doc-line.prod-type and
    23500         ub.gds-obj.obj-code = buf_doc-line.obj-code and
    23501         ub.gds-obj.obj-type = buf_doc-line.obj-type:
    23502           ub.gds-obj.inv-on = false .
    23503         end.
    23504         release ub.doc-line .
    23505       end.
    23506         for each ub.parts exclusive-lock where ub.parts.in-code = par-docCode :
    23507         delete ub.parts .
    23508         end.
    23509   define variable vss-include-info254 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    23510   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
    23511     (input  parparentproc
    23512     ,input  vardoc-code
    23513     ,output table gds-list
    23514     ) no-error .
    23515     if error-status:error then return error .
    23516       do ii = 1 to num-entries(par-list):
    23517         for each bf_doc-line no-lock where bf_doc-line.doc-code = entry(ii,par-list):
    23518           find first tt-line exclusive-lock where
    23519             tt-line.doc-code = vardoc-code and
    23520             tt-line.artic = bf_doc-line.artic and
    23521             tt-line.prod-code = bf_doc-line.prod-code and
    23522             tt-line.prod-type = bf_doc-line.prod-type no-error .
    23523           if not available(tt-line) then
    23524           do:
    23525           end.
    23526           tt-line.doc-qnty = tt-line.doc-qnty + bf_doc-line.doc-qnty .
    23527           tt-line.fact-qnty = tt-line.fact-qnty + bf_doc-line.doc-qnty .
    23528         end.
    23529       end.
    23530       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = vardoc-code .
    23531       pardoc-rec = recid(buf_trn-doc) .
    23532       for each tt-line no-lock where tt-line.doc-code = buf_trn-doc.doc-code:
    23533         find first ub.goods no-lock where ub.goods.artic = tt-line.artic and
    23534           ub.goods.prod-code = tt-line.prod-code and
    23535           ub.goods.prod-type = tt-line.prod-type no-error .
    23536         if tt-line.fact-qnty <> 0 then
    23537         do:
    23538           find first ub.doc-line no-lock where ub.doc-line.doc-code = tt-line.doc-code and
    23539             ub.doc-line.artic = tt-line.artic and
    23540             ub.doc-line.prod-code = tt-line.prod-code and
    23541             ub.doc-line.prod-type = tt-line.prod-type no-error .
    23542           if not available (ub.doc-line) then
    23543           do:
    23544             next .
    23545           end.
    23546           find first ub.goods no-lock where ub.goods.artic = doc-line.artic and
    23547             ub.goods.prod-code = doc-line.prod-code and
    23548             ub.goods.prod-type = doc-line.prod-type no-error .
    23549           line-rec = recid(doc-line) .
    23550           find first old_doc-line no-lock where old_doc-line.doc-code = par-docCode and
    23551             old_doc-line.artic = ub.doc-line.artic and
    23552             old_doc-line.prod-code = ub.doc-line.prod-code and
    23553             old_doc-line.prod-type = ub.doc-line.prod-type no-error .
    23554           old-line-rec = recid(old_doc-line) .
    23555           find first ub.units   no-lock where ub.units.unit-name    = ub.goods.unit-base.
    23556           find       ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
    23557           run invMulti(
    23558             input parparentproc,
    23559             input pardoc-rec,
    23560             input line-rec,
    23561             input recid(ub.goods),
    23562             input recid (ub.gds-prt),
    23563             input tt-line.fact-qnty,
    23564             input 'корн':U).
    23565         end.
    23566       end.
    23567     for each buf_doc-line no-lock
    23568       where buf_doc-line.doc-code = vardoc-code
    23569     :
    23570       find first buf_goods no-lock
    23571         where buf_goods.artic     = buf_doc-line.artic
    23572           and buf_goods.prod-type = buf_doc-line.prod-type
    23573           and buf_goods.prod-code = buf_doc-line.prod-code
    23574         no-error .
    23575       if error-status :error then do:
    23576         message
    23577           vss-workfile vss-revision vss-description skip
    23578           "Не найден товар" skip
    23579           "Документ" buf_doc-line.doc-code skip
    23580           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    23581           error-status :get-message(1) skip
    23582           return-value skip
    23583           view-as alert-box error .
    23584         return error .
    23585       end.
    23586   define variable vss-include-info255 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    23587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
    23588     (input  buf_doc-line.obj-type
    23589     ,input  buf_doc-line.obj-code
    23590     ,input  buf_doc-line.artic
    23591     ,input  buf_doc-line.prod-type
    23592     ,input  buf_doc-line.prod-code
    23593     ,buffer buf_gds-obj
    23594     ) no-error .
    23595       if error-status :error then do:
    23596         message
    23597           vss-workfile vss-revision vss-description skip
    23598           "Невозможно найти gds-obj" skip
    23599           error-status :get-message(1) skip
    23600           return-value skip
    23601           view-as alert-box error .
    23602         return error .
    23603       end.
    23604       find current buf_gds-obj exclusive-lock .
    23605       release buf_gds-obj .
    23606   define variable vss-include-info256 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    23607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
    23608     (input buf_doc-line.obj-type
    23609     ,input buf_doc-line.obj-code
    23610     ,input buf_doc-line.artic
    23611     ,input buf_doc-line.prod-type
    23612     ,input buf_doc-line.prod-code
    23613     ,input ?
    23614     ,input ''
    23615     ) no-error .
    23616       if error-status :error then do:
    23617         message
    23618           vss-workfile vss-revision vss-description skip
    23619           "Ошибка при проверке целостности товара" skip
    23620           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
    23621           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    23622           error-status :get-message(1) skip
    23623           view-as alert-box .
    23624         return error .
    23625       end.
    23626   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_gdnorsrv in g#lib-trn4
    23627     (  input buf_doc-line.artic
