     7581         f-nsf  (recid(t-doc)) column-label "Счет-фактура поставщика: Номер" format "x(71)"
     7582         f-addsum  (recid(t-doc)) column-label "Дополнительные суммы посчитанные по документу" format "x(255)"
     7583         f-clcasol  (recid(t-doc)) column-label "On-line расчет дополнительных сумм основных и после документа" format "x(3)"
     7584         f-clcaswt  (recid(t-doc)) column-label "On-line расчет естественной убыли" format "x(3)"
     7585         f-scanfile  (recid(t-doc)) column-label "Загруженные в документ сканерные файлы" format "x(3)"
     7586         f-indoclnsum  (recid(t-doc)) column-label "Заводить внешнюю приходную накладную через суммы" format "x(3)"
     7587         f-purchlimit  (recid(t-doc)) column-label "Есть в документе ограничение по типам кодов приобретения для резервирования" format "x(3)"
     7588         f-purchcodelist  (recid(t-doc)) column-label "Список кодов типов приобретения" format "x(3)"
     7589         f-expense_own  (recid(t-doc)) column-label "Расходы не включаемые в учетную цену" format "x(20)"
     7590         f-envd  (recid(t-doc)) column-label "Единый налог на вмененный доход" format "x(4)"
     7591         f-1ord_time  (recid(t-doc)) column-label "Время выполнения заказа" format "x(6)"
     7592         f-4dchek  (recid(t-doc)) column-label "Дата чека предоплаты" format "x(11)"
     7593         f-2befpay  (recid(t-doc)) column-label "Сумма предоплаты" format "x(22)"
     7594         f-3ord_Nchek  (recid(t-doc)) column-label "№ чека предоплаты" format "x(70)"
     7595         f-5deliv  (recid(t-doc)) column-label "Сумма доставки (баз.вал.)" format "x(22)"
     7596         f-6sumwrk  (recid(t-doc)) column-label "Наценка за работу,%" format "x(22)"
     7597         f-7sumsrk  (recid(t-doc)) column-label "Наценка за срочность,%" format "x(22)"
     7598         f-8ord_adr  (recid(t-doc)) column-label "Адрес доставки" format "x(70)"
     7599         f-9ord_hwo  (recid(t-doc)) column-label "Кому" format "x(70)"
     7600         f-fbroperator  (recid(t-doc)) column-label "Код оператора документа производства" format "x(10)"
     7601         f-fbrauto  (recid(t-doc)) column-label "Документ создан автоматически" format "x(4)"
     7602         f-rsrv-doc-list  (recid(t-doc)) column-label "Список документов по которым производилось резервирование" format "x(42)"
     7603         f-3postdchek  (recid(t-doc)) column-label "Дата чека доплаты" format "x(14)"
     7604         f-1postpay  (recid(t-doc)) column-label "Сумма доплаты" format "x(22)"
     7605         f-2postNchek  (recid(t-doc)) column-label "№ чека доплаты" format "x(70)"
     7606         f-0rsrv-date  (recid(t-doc)) column-label "Дата выполнения " format "x(11)"
     7607         f-21ord_phone  (recid(t-doc)) column-label "Контактный телефон" format "x(70)"
     7608         f-4ord_dl  (recid(t-doc)) column-label "Требуется доставка" format "x(3)"
     7609         f-22ord_contact  (recid(t-doc)) column-label "Контактное лицо" format "x(70)"
     7610         f-m_inc  (recid(t-doc)) column-label "Метод включения транспортных и пр расходов в ПН" format "x(3)"
     7611         f-QntyPlace  (recid(t-doc)) column-label "Количество мест" format "x(9)"
     7612         f-discnt-stop  (recid(t-doc)) column-label "Сумма итого со скидкой наценкой и доставкой" format "x(3)"
     7613         f-discnt-other  (recid(t-doc)) column-label "Перерассчитывать скидку по документу удалив доставку " format "x(3)"
     7614         f-DFinDoc  (recid(t-doc)) column-label "Расчетный документ: Дата" format "x(11)"
     7615         f-NFinDoc  (recid(t-doc)) column-label "Расчетный документ: Номер" format "x(71)"
     7616         f-PlaceStorage  (recid(t-doc)) column-label "Место хранения " format "x(70)"
     7617         f-Packer  (recid(t-doc)) column-label "Упаковщик" format "x(70)"
     7618         f-Dispath  (recid(t-doc)) column-label "Способ отгрузки" format "x(70)"
     7619         f-price-target  (recid(t-doc)) column-label "Внутренний расход по цене приемника" format "x(4)"
     7620         f-edi  (recid(t-doc)) column-label "Статус EDI" format "x(10)"
     7621         f-ddov  (recid(t-doc)) column-label "Доверенность: Дата" format "x(11)"
     7622         f-ndov  (recid(t-doc)) column-label "Доверенность: Номер" format "x(71)"
     7623         f-Recipient  (recid(t-doc)) column-label "Грузополучатель" format "x(71)"
     7624         f-Auto  (recid(t-doc)) column-label "Автомобиль: Марка, Номер" format "x(71)"
     7625         f-Driver  (recid(t-doc)) column-label "Автомобиль: Водитель" format "x(71)"
     7626         f-print-num  (recid(t-doc)) column-label "Номер документа для печати" format "x(71)"
     7627         f-olsuppcntr  (recid(t-doc)) column-label "Документ пересортицы делается по тем же контрагентам и договорам" format "x(3)"
     7628         f-nosn  (recid(t-doc)) column-label "Документ-основание. Наименование" format "x(70)"
     7629         t-doc.sys-date column-label 'Дата изменения'
     7630         f-nosn  (recid(t-doc)) column-label "Документ-основание. Наименование" format "x(70)"
     7631         closed-backdated (recid(t-doc)) column-label 'Закрыт задним числом'
     7632         f-delivery-date  (recid(t-doc)) column-label "Дата доставки" format "9999/99/99"
     7633       enable t-doc.ship-date with size 98.5 by 13.5 separators.
     7634   DEFINE FRAME d-all-docs
     7635        b-quit AT ROW 1 COL  2
     7636        b-mark AT ROW 1 COL 10
     7637        b-sel  AT ROW 1 COL 13
     7638        b-rep  AT ROW 1 COL 21
     7639        b-bc   AT ROW 1 COL 30
     7640        b-akt  AT ROW 1 COL 39
     7641        b-ext  AT ROW 1 COL 47
     7642        b-pay  AT ROW 1 COL 55
     7643        b-sch  AT ROW 1 COL 90
     7644        b-help AT ROW 1 COL 90
     7645        b-add    AT ROW 2.3 COL  2
     7646        b-lkp    AT ROW 2.3 COL 11.5
     7647        b-chg    AT ROW 2.3 COL 21
     7648        b-del    AT ROW 2.3 COL 30
     7649        b-close  AT ROW 2.3 COL 39
     7650        b-open   AT ROW 2.3 COL 47
     7651        b-copy   AT ROW 2.3 COL 92
     7652        b-unrv   AT ROW 2.3 COL 55
     7653        b-exp    AT ROW 2.3 COL 64
     7654        b-f-ed   AT ROW 2.3 COL 72
     7655        b-to-inv AT ROW 2.3 COL 81
     7656        b-to-update AT ROW 2.3 COL 90
     7657        b-covdocs AT ROW 2.3 COL  81
     7658        b-history    AT ROW 2.3 COL 90
     7659        b-print  AT ROW 2.3 COL 98
     7660        b-uf     AT ROW 1 COL 82
     7661        b-filter-ext     AT ROW 1 COL 85
     7662        b-scaner         AT ROW 2.3 COL 98
     7663        r-scaner         AT ROW 2.3   COL 98
     7664        br-docs  AT ROW 3.5 COL 1
     7665        sch-code at row 19 col 2 label "&Начало номера"   VIEW-AS FILL-IN SIZE 15 BY 1 fgcolor 4
     7666        sch-date at row 19 col 33 label "Д&ата"
     7667        sch-fact at row 19 col 51 label "Фа&кт"   VIEW-AS FILL-IN SIZE 10 BY 1 fgcolor 4
     7668        sch-objcode at row 19 col 70 label "&Контрагент" VIEW-AS FILL-IN SIZE 11.5 BY 1 fgcolor 4
     7669        sch-objtype at row 19 col 94 no-label
     7670        sch-sum at row 20.1 col 2 label "&Сумма факт   "    VIEW-AS FILL-IN SIZE 15 BY 1 fgcolor 4
     7671        sch-num at row 19 col 80 label "Найдено" fgcolor 12
     7672        ub.pay-type.obj-name at row 17 col 5 COLON-ALIGNED LABEL "Опл" VIEW-AS FILL-IN SIZE 34 BY 1 fgcolor 4
     7673        obj-name at row 17 col 55 COLON-ALIGNED LABEL "Объект" VIEW-AS FILL-IN SIZE 34 BY 1 fgcolor 4
     7674        boss-name at row 18 col 5 COLON-ALIGNED LABEL "М-р" VIEW-AS FILL-IN SIZE 19 BY 1 fgcolor 4
     7675        agnt-name at row 18 col 30 COLON-ALIGNED LABEL "Исп" VIEW-AS FILL-IN SIZE 18 BY 1 fgcolor 4
     7676        wrkr-name at row 18 col 55 COLON-ALIGNED LABEL "Кл-к" VIEW-AS FILL-IN SIZE 18 BY 1 fgcolor 4
     7677        v-user-name at row 18 col 80 COLON-ALIGNED LABEL "Опер" VIEW-AS FILL-IN SIZE 16 BY 1 fgcolor 4
     7678        ed-notes AT ROW 21.2 COL 1 no-label bgcolor 8 fgcolor 4
     7679       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     7680            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     7681            DEFAULT-BUTTON b-quit.
     7682   def var sort-labelbr-docs   as character no-undo .
     7683   def var sort-clmnbr-docs    as handle    no-undo .
     7684   def var cur-clmnbr-docs     as handle    no-undo .
     7685   def var cur-clmn-locbr-docs as integer   no-undo .
     7686   def var re-querybr-docs     as logical   initial no no-undo .
     7687   on start-search, ctrl-o of br-docs in frame d-all-docs do:
     7688      run sort-brbr-docs
     7689        (input (if available t-doc
     7690                then recid(t-doc)
     7691                else ?
     7692               )
     7693        ).
     7694   end.
     7695   PROCEDURE sort-brbr-docs :
     7696     define input parameter p-recid as recid no-undo .
     7697     if re-querybr-docs = no then do:
     7698       assign
     7699          cur-clmnbr-docs = br-docs:current-column in frame d-all-docs
     7700       .
     7701       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     7702       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     7703         assign
     7704            sort-labelbr-docs = ""
     7705            sort-clmnbr-docs = ?
     7706         .
     7707        end.
     7708        else do:
     7709          assign
     7710            sort-labelbr-docs = cur-clmnbr-docs:label
     7711            sort-clmnbr-docs  = cur-clmnbr-docs
     7712            sort-clmnbr-docs:column-fgcolor = 4
     7713          .
     7714        end.
     7715      end.
     7716     assign
     7717       cur-clmn-locbr-docs = 1
     7718     .
     7719     def var column-handle as handle no-undo .
     7720     column-handle = br-docs:first-column.
     7721     do while valid-handle(column-handle) :
     7722       if column-handle = cur-clmnbr-docs then do:
     7723         leave .
     7724       end.
     7725       column-handle = column-handle:NEXT-COLUMN.
     7726       assign
     7727         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     7728       .
     7729     end.
     7730     case sort-labelbr-docs:
     7731           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7732           when 'Т'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1first-symb-type&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7733           when 'Стат'  then DO:    assign       sort-column-name = "t-doc.status_"     .     run ui-on ('open').   . END.
     7734           when 'OK'  then DO:    assign       sort-column-name = "t-doc.flag_"     .     run ui-on ('open').   . END.
     7735           when 'Номер'  then DO:    assign       sort-column-name = "t-doc.doc-code"     .     run ui-on ('open').   . END.
     7736           when 'Дата'  then DO:    assign       sort-column-name = "t-doc.doc-date"     .     run ui-on ('open').   . END.
     7737           when 'Факт'  then DO:    assign       sort-column-name = "t-doc.fact-date"     .     run ui-on ('open').   . END.
     7738           when 'Смена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-day-month&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7739           when '№'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7740           when 'В'  then DO:    assign       sort-column-name = "t-doc.internal"     .     run ui-on ('open').   . END.
     7741           when 'Контрагент'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fcli-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7742           when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1object-label&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7743           when 'У'  then DO:    assign       sort-column-name = "t-doc.office"     .     run ui-on ('open').   . END.
     7744           when 'Кол-во по док.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-doc-qnty&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7745           when 'Кол-во факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-fact-qnty&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7746           when '$'  then DO:    assign       sort-column-name = "t-doc.print-rubl"     .     run ui-on ('open').   . END.
     7747           when 'Сумма по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-sum&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7748           when 'Скидка по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7749           when 'Сумма факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7750           when 'Скидка факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7751           when 'К оплате факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-pay-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7752           when 'НДС'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-vat&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7753           when 'Сумма учет.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-acc&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7754           when 'Скидка (%)'  then DO:    assign       sort-column-name = "t-doc.discnt-pc"     .     run ui-on ('open').   . END.
     7755           when 'Тип скидки'  then DO:    assign       sort-column-name = "t-doc.discnt-type"     .     run ui-on ('open').   . END.
     7756           when 'Курс'  then DO:    assign       sort-column-name = "t-doc.base-rate"     .     run ui-on ('open').   . END.
     7757           when 'А'  then DO:    assign       sort-column-name = "t-doc.ov"     .     run ui-on ('open').   . END.
     7758           when 'Авт. переоц. (прод.)'  then DO:    assign       sort-column-name = "t-doc.tot-ov"     .     run ui-on ('open').   . END.
     7759           when 'Инв.'  then DO:    assign       sort-column-name = "t-doc.inv-num"     .     run ui-on ('open').   . END.
     7760           when 'Запрос'  then DO:    assign       sort-column-name = "t-doc.ord-num"     .     run ui-on ('open').   . END.
     7761           when 'Отгрузка приход'  then DO:    assign       sort-column-name = "t-doc.ship-num"     .     run ui-on ('open').   . END.
     7762           when 'Дата отгр'  then DO:    assign       sort-column-name = "t-doc.ship-date"     .     run ui-on ('open').   . END.
     7763           when 'На док-т'  then DO:    assign       sort-column-name = "t-doc.out-code"     .     run ui-on ('open').   . END.
     7764           when 'Внеш.сист'  then DO:    assign       sort-column-name = "t-doc.acc-date"     .     run ui-on ('open').   . END.
     7765           when 'Экспорт'  then DO:    assign       sort-column-name = "t-doc.bge-date"     .     run ui-on ('open').   . END.
     7766           when 'Резерв отгрузка'  then DO:    assign       sort-column-name = "t-doc.rsrv-date"     .     run ui-on ('open').   . END.
     7767           when 'ФО поставка'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-postavka&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7768           when 'ФО реализация'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-realiz&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7769           when 'Счет-фактура'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1factur&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7770           when 'ФО покупателя'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-buyer&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     7771           when 'Номер партии для документа межфирменного перемещения'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'hold-part-code')     .     run ui-on ('open').   . END.
     7772           when 'Доверенность'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dov')     .     run ui-on ('open').   . END.
     7773           when 'Дата приходной накладной поставщика'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dids')     .     run ui-on ('open').   . END.
     7774           when 'Номер приходной накладной поставщика'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'nids')     .     run ui-on ('open').   . END.
     7775           when 'Договор: Дата'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'ddog')     .     run ui-on ('open').   . END.
     7776           when 'Договор: Номер'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'ndog')     .     run ui-on ('open').   . END.
     7777           when 'Счет-фактура поставщика: Дата'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dsf')     .     run ui-on ('open').   . END.
     7778           when 'Счет-фактура поставщика: Номер'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'nsf')     .     run ui-on ('open').   . END.
     7779           when 'Дополнительные суммы посчитанные по документу'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'addsum')     .     run ui-on ('open').   . END.
     7780           when 'On-line расчет дополнительных сумм основных и после документа'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'clcasol')     .     run ui-on ('open').   . END.
     7781       otherwise do:
     7782         assign
     7783           sort-column-name = ""
     7784         .
     7785         run ui-on ('open').
     7786           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     7787             run mv-brw-defaultbr-docs.
     7788           end.
     7789         if sort-labelbr-docs <> "" then do:
     7790           assign
     7791             cur-clmnbr-docs:column-fgcolor = 0
     7792           .
     7793         end.
     7794         assign
     7795           cur-clmn-locbr-docs = ?
     7796         .
     7797       end.
     7798     end case.
     7799       if cur-clmn-locbr-docs <> ? then do:
     7800         if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
     7801           run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
     7802         end.
     7803       end.
     7804     if p-recid <> ? then do:
     7805       reposition br-docs to recid p-recid no-error.
     7806       apply "value-changed" to br-docs in frame d-all-docs.
     7807     end.
     7808     apply "entry" to br-docs in frame d-all-docs.
     7809   END PROCEDURE.
     7810   procedure re-open-query-srt-clmnbr-docs:
     7811   if cur-clmnbr-docs = ? then do:
     7812      run ui-on ('open').
     7813   end.
     7814   else do:
     7815      assign re-querybr-docs = yes.
     7816      run sort-brbr-docs
     7817        (input (if available t-doc
     7818                then recid(t-doc)
     7819                else ?
     7820               )
     7821        ).
     7822      assign re-querybr-docs = no.
     7823   end.
     7824   end.
     7825   ASSIGN
     7826     FRAME d-all-docs :SCROLLABLE       = FALSE
     7827    FRAME d-all-docs :visible      = FALSE
     7828   .
     7829   ASSIGN b-exp :POPUP-MENU IN FRAME d-all-docs = MENU m-export :HANDLE.
     7830   ASSIGN b-exp :MENU-MOUSE = 1.
