     5273   gp-price-sale-parts = gp-price-sale.
     5274   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5275   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     5276     (input  ub.gds-dtl.obj-type
     5277     ,input  ub.gds-dtl.obj-code
     5278     ,input  gp-b-code
     5279     ,input  0
     5280     ,input  gp-fact-order
     5281     ,output gp-doc-num
     5282     ,output gp-price-sale-parts
     5283     ,output gp-road-tax
     5284     ,output gp-excise
     5285     ) no-error .
     5286   if error-status:error then do:
     5287     return error.
     5288   end.
     5289   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     5290       gp-price-sale = gp-price-sale-parts.
     5291    end.
     5292           if gp-price-sale <> ? then
     5293           do:
     5294               ASSIGN
     5295                   ub.doc-line.excise   = gp-excise
     5296                   ub.doc-line.road-tax = gp-road-tax.
     5297               if varr-b = "rubl":U then
     5298               do:
     5299                   ASSIGN
     5300                       ub.gds-dtl.price-rubl = gp-price-sale.
     5301               end.
     5302               else
     5303               do:
     5304                   ASSIGN
     5305                       ub.gds-dtl.price-base = gp-price-sale.
     5306               end.
     5307           end.
     5308           else
     5309           do:
     5310               if v-fact-order = 0  then
     5311               do:
     5312                   message "Невозможно рассчитать fact-order.  Возможно не открыта смена на объекте "  view-as alert-box error .
     5313               end.
     5314               else
     5315               do:
     5316                   run factord-to-date in this-procedure ( v-fact-order , output v-fact-order-day1 ) .
     5317                   message substitute("Нет цены для товара &1  &4 (признак &2) на дату &3. Сделайте переоценку " , ub.goods.artic , ub.gds-dtl.prt-code, string(v-fact-order-day1, "99/99/9999" ) , ub.goods.gds-name )  view-as alert-box .
     5318                   if varr-b = "rubl":U then
     5319                   do:
     5320                       ASSIGN
     5321                           ub.gds-dtl.price-rubl = 0.
     5322                   end.
     5323                   else
     5324                   do:
     5325                       ASSIGN
     5326                           ub.gds-dtl.price-base = 0.
     5327                   end.
     5328               end.
     5329           end.
     5330           if varr-b = "base":U then
     5331           do:
     5332               assign
     5333                   ub.gds-dtl.price-rubl = ub.gds-dtl.price-base * ub.trn-doc.base-rate / ub.trn-doc.base-scale.
     5334           end.
     5335           else
     5336           do:
     5337               assign
     5338                   ub.gds-dtl.price-base = ub.gds-dtl.price-rubl / ub.trn-doc.base-rate * ub.trn-doc.base-scale.
     5339           end.
     5340       end.
     5341       if v-expptr <> ? then
     5342       do:
     5343           define variable v-fact-qnty     as decimal no-undo .
     5344           define variable v-fact-cli-qnty as decimal no-undo .
     5345           define variable v-rest-qnty     as decimal no-undo .
     5346           define variable v-rest-cli-qnty as decimal no-undo .
     5347           assign
     5348               v-rest-qnty     = 0.0
     5349               v-rest-cli-qnty = 0.0
     5350               .
     5351           for each ub.doc-pl exclusive-lock
     5352               where ub.doc-pl.out-code  = ub.doc-line.doc-code
     5353               and ub.doc-pl.gds-code  = ub.goods.gds-code
     5354               on error undo, return error return-value
     5355               :
     5356               assign
     5357                   old-pl-qnty = (- ub.doc-pl.doc-qnty)
     5358                   .
     5359               if old-pl-qnty <> 0.0 then
     5360               do:
     5361                   run trg/rsrv-dtl.p
     5362                       ( input parparentproc
     5363                       ,input 'reserv':U + "," + 'plcode':U + "=" + string(ub.doc-pl.pl-code) + ',' + 'negative-check':U + "=1"
     5364                       ,buffer ub.gds-dtl
     5365                       ,input-output old-pl-qnty
     5366                       ,input-output ub.doc-line.price-base
     5367                       ,input-output ub.doc-line.price-rubl
     5368                       ,-1
     5369                       ,""
     5370                       ) no-error.
     5371                   if error-status :error then
     5372                   do:
     5373                       assign
     5374                           v-err-msg = substitute( "Ошибка при разрезервировании.&1&2", chr(10), return-value )
     5375                           .
     5376                   end.
     5377                   else
     5378                   do:
     5379                       if old-pl-qnty <> (- ub.doc-pl.doc-qnty) then
     5380                       do:
     5381                           assign
     5382                               v-err-msg = substitute( "Не удалось снять резервы по ранее зарезервированному количеству.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     5383                                         , chr(10)
     5384                                         , (- ub.doc-pl.doc-qnty)
     5385                                         , old-pl-qnty
     5386                                         )
     5387                               .
     5388                       end.
     5389                   end.
     5390                   if v-err-msg <> "":U then
     5391                   do:
     5392                       message
     5393                           vss-workfile vss-revision vss-description skip
     5394                           v-err-msg skip
     5395                           view-as alert-box error .
     5396                       undo, return error v-err-msg .
     5397                   end.
     5398               end.
     5399               find first tt-doc-pl
     5400                   where tt-doc-pl.out-code = ub.doc-pl.out-code
     5401                   and tt-doc-pl.gds-code = ub.doc-pl.gds-code
     5402                   and tt-doc-pl.pl-code  = ub.doc-pl.pl-code
     5403                   .
     5404               buffer-copy tt-doc-pl to ub.doc-pl .
     5405               assign
     5406                   new-pl-qnty = ub.doc-pl.doc-qnty
     5407                   .
     5408               if new-pl-qnty <> 0.0 then
     5409               do:
     5410                   run trg/rsrv-dtl.p
     5411                       ( input parparentproc
     5412                       ,input 'reserv':U + "," + 'plcode':U + "=" + string(ub.doc-pl.pl-code) + ',' + 'negative-check':U + "=1"
     5413                       ,buffer ub.gds-dtl
     5414                       ,input-output new-pl-qnty
     5415                       ,input-output ub.doc-line.price-base
     5416                       ,input-output ub.doc-line.price-rubl
     5417                       ,-1
     5418                       ,""
     5419                       ) no-error.
     5420                   if error-status :error then
     5421                   do:
     5422                       assign
     5423                           v-err-msg = substitute( "Ошибка при резервировании.&1&2", chr(10), return-value )
     5424                           .
     5425                   end.
     5426                   else
     5427                   do:
     5428                       if new-pl-qnty <> ub.doc-pl.doc-qnty then
     5429                       do:
     5430                           assign
     5431                               v-err-msg = substitute( "Не удалось зарезервировать все запрошенное количество.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     5432                                         , chr(10)
     5433                                         , ub.doc-pl.doc-qnty - old-pl-qnty
     5434                                         , new-pl-qnty - old-pl-qnty
     5435                                         )
     5436                               .
     5437                       end.
     5438                   end.
     5439                   if v-err-msg <> "":U then
     5440                   do:
     5441                       message
     5442                           vss-workfile vss-revision vss-description skip
     5443                           v-err-msg skip
     5444                           view-as alert-box error .
     5445                       undo, return error v-err-msg .
     5446                   end.
     5447               end.
     5448               assign
     5449                   v-fact-qnty     = v-fact-qnty     + ub.doc-pl.fact-qnty
     5450                   v-fact-cli-qnty = v-fact-cli-qnty + ub.doc-pl.cli-fact-qnty
     5451                   v-rest-qnty     = v-rest-qnty     + ub.doc-pl.rest-af-qnty
     5452                   v-rest-cli-qnty = v-rest-cli-qnty + ub.doc-pl.cli-rest-af-qnty
     5453                   .
     5454           end.
     5455           if v-rest-qnty <> 0.0
     5456               and v-rest-cli-qnty <> 0.0
     5457               then
     5458           do:
     5459               assign
     5460                   ub.doc-line.doc-density  = v-rest-cli-qnty / v-rest-qnty
     5461                   ub.doc-line.fact-density = ub.doc-line.doc-density
     5462                   .
     5463           end.
     5464           assign
     5465               ub.gds-dtl.fact-qnty      = v-rest-qnty
     5466               ub.doc-line.doc-qnty      = v-rest-qnty
     5467               ub.inv-line.wast-cli-qnty = v-rest-cli-qnty
     5468               ub.gds-dtl.doc-qnty       = v-fact-qnty
     5469               ub.doc-line.fact-qnty     = v-fact-qnty
     5470               ub.doc-line.cli-qnty      = v-fact-cli-qnty
     5471               .
     5472       end.
     5473       else
     5474       do:
     5475           IF ub.trn-doc.flag_ = YES THEN
     5476           DO:
     5477               run trg/rsrv-dtl.p ( input        parParentProc,
     5478                   input        'reserv':U,
     5479                   buffer       ub.gds-dtl,
     5480                   input-output chg-qnty,
     5481                   input-output ub.doc-line.price-base,
     5482                   input-output ub.doc-line.price-rubl,
     5483                   input        -1,
     5484                   input        ""  ).
     5485               assign
     5486                   ub.gds-dtl.fact-qnty  = ub.gds-dtl.fact-qnty  + chg-qnty
     5487                   ub.gds-dtl.doc-qnty   = ub.gds-dtl.fact-qnty  - old-val
     5488                   ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty  + chg-qnty
     5489                   ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty.
     5490           END.
     5491           ELSE
     5492           DO:
     5493               run trg/rsrv-dtl.p ( input        parParentProc,
     5494                   input        'reserv':U,
     5495                   buffer       ub.gds-dtl,
     5496                   input-output chg-qnty,
     5497                   input-output ub.doc-line.price-base,
     5498                   input-output ub.doc-line.price-rubl,
     5499                   input        -1                    ,
     5500                   input        ""     ).
     5501               assign
     5502                   ub.gds-dtl.fact-qnty  = ub.gds-dtl.fact-qnty  + chg-qnty
     5503                   ub.gds-dtl.doc-qnty   = ub.gds-dtl.doc-qnty   + chg-qnty
     5504                   ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty  + chg-qnty
     5505                   ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty.
     5506           END.
     5507       end.
     5508       assign
     5509           prt-rec = recid( ub.gds-dtl ).
     5510       if ub.gds-dtl.doc-qnty = 0 then
     5511       do:
     5512           delete ub.gds-dtl.
     5513           assign
     5514               prt-rec = ?.
     5515       end.
     5516       assign
     5517           ub.doc-line.prt-OK = no.
     5518       find ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
     5519       for each ub.gds-dtl where
     5520           ub.gds-dtl.prod-code = ub.goods.prod-code   and
     5521           ub.gds-dtl.prod-type = ub.goods.prod-type   and
     5522           ub.gds-dtl.artic     = ub.goods.artic       and
     5523           ub.gds-dtl.doc-code  = ub.doc-line.doc-code :
     5524           if ub.gds-dtl.doc-qnty <> 0 and ub.gds-dtl.prt-code <> ub.gds-prt.node-code then
     5525           do:
     5526               assign
     5527                   ub.doc-line.prt-OK = yes.
     5528           end.
     5529       end.
     5530   end procedure.
     5531   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
