     2713   def var vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2714   define variable vss-include-info26 as character format "X(65)" no-undo
     2715   initial "@(#)$Workfile$ $Revision$".
     2716   procedure xmlchar-test :
     2717   define input parameter p-in-string          as character        no-undo.
     2718   define output parameter p-out-string-enc    as character        no-undo.
     2719   define output parameter p-out-string-dec    as character        no-undo.
     2720   do
     2721   on error undo, return error
     2722   :
     2723          run xmlchar-encode in this-procedure
     2724       (
     2725             input p-in-string
     2726           , output p-out-string-enc
     2727       ).
     2728          run xmlchar-decode in this-procedure
     2729       (
     2730             input p-out-string-enc
     2731           , output p-out-string-dec
     2732       ).
     2733   end.
     2734   end .
     2735   procedure xmlchar-encode :
     2736   define input parameter p-in-string      as character        no-undo.
     2737   define output parameter p-out-string    as character        no-undo.
     2738       define variable v-position      as integer      no-undo.
     2739       define variable v-current-char  as character    no-undo.
     2740   do
     2741   on error undo, return error
     2742   :
     2743       assign
     2744           p-out-string = "":U
     2745       .
     2746       case p-in-string
     2747       :
     2748           when ?
     2749           then do:
     2750               assign
     2751                   p-out-string = "?":U
     2752               .
     2753           end.
     2754           when "?":U
     2755           then do:
     2756               assign
     2757                   p-out-string = "&#63;":U
     2758               .
     2759           end.
     2760           otherwise do:
     2761               do v-position = 1 to length( p-in-string )
     2762               :
     2763                   assign
     2764                       v-current-char = substring( p-in-string, v-position, 1 )
     2765                   .
     2766                   case v-current-char
     2767                   :
     2768                       when "&":U
     2769                       then do:
     2770                           assign
     2771                               p-out-string = p-out-string + "&amp;":U
     2772                           .
     2773                       end.
     2774                       when ">":U
     2775                       then do:
     2776                           assign
     2777                               p-out-string = p-out-string + "&gt;":U
     2778                           .
     2779                       end.
     2780                       when "<":U
     2781                       then do:
     2782                           assign
     2783                               p-out-string = p-out-string + "&lt;":U
     2784                           .
     2785                       end.
     2786                       when "'":U
     2787                       then do:
     2788                           assign
     2789                               p-out-string = p-out-string + "&apos;":U
     2790                           .
     2791                       end.
     2792                       when '"':U
     2793                       then do:
     2794                           assign
     2795                               p-out-string = p-out-string + "&quot;":U
     2796                           .
     2797                       end.
     2798                       when chr(1)
     2799                       then do:
     2800                           assign
     2801                               p-out-string = p-out-string + "":U
     2802                           .
     2803                       end.
     2804                       when chr(2)
     2805                       then do:
     2806                           assign
     2807                               p-out-string = p-out-string + "":U
     2808                           .
     2809                       end.
     2810                       when chr(3)
     2811                       then do:
     2812                           assign
     2813                               p-out-string = p-out-string + "":U
     2814                           .
     2815                       end.
     2816                       when chr(4)
     2817                       then do:
     2818                           assign
     2819                               p-out-string = p-out-string + "":U
     2820                           .
     2821                       end.
     2822                       when chr(5)
     2823                       then do:
     2824                           assign
     2825                               p-out-string = p-out-string + "":U
     2826                           .
     2827                       end.
     2828                       when chr(6)
     2829                       then do:
     2830                           assign
     2831                               p-out-string = p-out-string + "":U
     2832                           .
     2833                       end.
     2834                       when chr(7)
     2835                       then do:
     2836                           assign
     2837                               p-out-string = p-out-string + "":U
     2838                           .
     2839                       end.
     2840                       when chr(8)
     2841                       then do:
     2842                           assign
     2843                               p-out-string = p-out-string + "":U
     2844                           .
     2845                       end.
     2846                       when chr(9)
     2847                       then do:
     2848                           assign
     2849                               p-out-string = p-out-string + "":U
     2850                           .
     2851                       end.
     2852                       when chr(29)
     2853                       then do:
     2854                           assign
     2855                               p-out-string = p-out-string + "":U
     2856                           .
     2857                       end.
     2858                       when chr(10)
     2859                       then do:
     2860                           assign
     2861                               p-out-string = p-out-string + "&#10;":U
     2862                           .
     2863                       end.
     2864                       when chr(13)
     2865                       then do:
     2866                           assign
     2867                               p-out-string = p-out-string + "&#13;":U
     2868                           .
     2869                       end.
     2870                       otherwise do:
     2871                           assign
     2872                               p-out-string = p-out-string + v-current-char
     2873                           .
     2874                       end.
     2875                   end case.
     2876               end.
     2877           end.
     2878       end case.
     2879   end.
     2880   end .
     2881   procedure xmlchar-encode-1c :
     2882   define input parameter p-in-string      as character        no-undo.
     2883   define output parameter p-out-string    as character        no-undo.
     2884       define variable v-position      as integer      no-undo.
     2885       define variable v-current-char  as character    no-undo.
     2886   do
     2887   on error undo, return error
     2888   :
     2889       assign
     2890           p-out-string = "":U
     2891       .
     2892       case p-in-string
     2893       :
     2894           when ?
     2895           then do:
     2896               assign
     2897                   p-out-string = "?":U
     2898               .
     2899           end.
     2900           otherwise do:
     2901               do v-position = 1 to length( p-in-string )
     2902               :
     2903                   assign
     2904                       v-current-char = substring( p-in-string, v-position, 1 )
     2905                   .
     2906                   case v-current-char
     2907                   :
     2908                       when chr(1)
     2909                       then do:
     2910                           assign
     2911                               p-out-string = p-out-string + " ":U
     2912                           .
     2913                       end.
     2914                       when chr(2)
     2915                       then do:
     2916                           assign
     2917                               p-out-string = p-out-string + " ":U
     2918                           .
     2919                       end.
     2920                       when chr(3)
     2921                       then do:
     2922                           assign
     2923                               p-out-string = p-out-string + " ":U
     2924                           .
     2925                       end.
     2926                       when chr(4)
     2927                       then do:
     2928                           assign
     2929                               p-out-string = p-out-string + " ":U
     2930                           .
     2931                       end.
     2932                       when chr(5)
     2933                       then do:
     2934                           assign
     2935                               p-out-string = p-out-string + " ":U
     2936                           .
     2937                       end.
     2938                       when chr(6)
     2939                       then do:
     2940                           assign
     2941                               p-out-string = p-out-string + " ":U
     2942                           .
     2943                       end.
     2944                       when chr(7)
     2945                       then do:
     2946                           assign
     2947                               p-out-string = p-out-string + " ":U
     2948                           .
     2949                       end.
     2950                       when chr(8)
     2951                       then do:
     2952                           assign
     2953                               p-out-string = p-out-string + " ":U
     2954                           .
     2955                       end.
     2956                       when chr(9)
     2957                       then do:
     2958                           assign
     2959                               p-out-string = p-out-string + " ":U
     2960                           .
     2961                       end.
     2962                       when chr(29)
     2963                       then do:
     2964                           assign
     2965                               p-out-string = p-out-string + " ":U
     2966                           .
     2967                       end.
     2968                       when chr(10)
     2969                       then do:
     2970                           assign
     2971                               p-out-string = p-out-string + " ":U
     2972                           .
     2973                       end.
     2974                       when chr(13)
     2975                       then do:
     2976                           assign
     2977                               p-out-string = p-out-string + " ":U
     2978                           .
     2979                       end.
     2980                       otherwise do:
     2981                           assign
     2982                               p-out-string = p-out-string + v-current-char
     2983                           .
     2984                       end.
     2985                   end case.
     2986               end.
     2987           end.
     2988       end case.
     2989   end.
     2990   end .
     2991   procedure xmlchar-decode :
     2992   define input parameter p-in-string      as character        no-undo.
     2993   define output parameter p-out-string    as character        no-undo.
     2994       define variable v-position      as integer      no-undo.
     2995       define variable v-last-position as integer      no-undo.
     2996       define variable v-temp-integer  as integer      no-undo.
     2997       define variable v-current-char  as character    no-undo.
     2998       define variable v-next-char     as character    no-undo.
     2999       define variable v-success       as logical      no-undo.
     3000   do
     3001   on error undo, return error
     3002   :
     3003       assign
     3004           p-out-string = "":U
     3005           v-position   = 0
     3006       .
     3007       replace-cycle:
     3008       do while yes
     3009       on error undo, return error
     3010       :
     3011           assign
     3012               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3013           .
     3014           if v-last-position <= v-position
     3015           then do:
     3016               if v-position = 0
     3017               then do:
     3018                   assign
     3019                       p-out-string = p-in-string
     3020                   .
     3021               end.
     3022               else do:
     3023                   assign
     3024                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3025                   .
     3026               end.
     3027               leave replace-cycle.
     3028           end.
     3029           else do:
     3030               assign
     3031                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3032                   v-position      = v-last-position
     3033                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3034               .
     3035               if v-current-char = "#":U
     3036               then do:
     3037                   assign
     3038                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3039                   .
     3040                   if v-last-position > 0
     3041                   then do:
     3042                       run xmlchar-read-integer in this-procedure
     3043                        (
     3044                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3045                           , output v-temp-integer
     3046                           , output v-success
     3047                       ).
     3048                       if v-success = yes
     3049                       and v-temp-integer >= 1
     3050                       and v-temp-integer <= 255
     3051                       then do:
     3052                           assign
     3053                               p-out-string = p-out-string + chr( v-temp-integer )
     3054                               v-position   = v-last-position + 1
     3055                           .
     3056                       end.
     3057                       else do:
     3058                           assign
     3059                               p-out-string = p-out-string + "&":U
     3060                               v-position   = v-position   + 1
     3061                           .
     3062                       end.
     3063                   end.
     3064                   else do:
     3065                       assign
     3066                           p-out-string = p-out-string + "&":U
     3067                           v-position   = v-position   + 1
     3068                       .
     3069                   end.
     3070               end.
     3071               else do:
     3072                   case substring( p-in-string, v-position + 1, 3 )
     3073                   :
     3074                       when "lt;":U
     3075                       then do:
     3076                           assign
     3077                               p-out-string = p-out-string + "<":U
     3078                               v-position   = v-position   + 3
     3079                           .
     3080                       end.
     3081                       when "gt;":U
     3082                       then do:
     3083                           assign
     3084                               p-out-string = p-out-string + ">":U
     3085                               v-position   = v-position   + 3
     3086                           .
     3087                       end.
     3088                       otherwise do:
     3089                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3090                           then do:
     3091                               assign
     3092                                   p-out-string = p-out-string + "&":U
     3093                                   v-position   = v-position   + 4
     3094                               .
     3095                           end.
     3096                           else do:
     3097                               case substring( p-in-string, v-position + 1, 5 )
     3098                               :
     3099                                   when "quot;":U
     3100                                   then do:
     3101                                       assign
     3102                                           p-out-string = p-out-string + '"':U
     3103                                           v-position   = v-position   + 5
     3104                                       .
     3105                                   end.
     3106                                   when "apos;":U
     3107                                   then do:
     3108                                       assign
     3109                                           p-out-string = p-out-string + "'":U
     3110                                           v-position   = v-position   + 5
     3111                                       .
     3112                                   end.
     3113                                   otherwise do:
     3114                                       assign
     3115                                           p-out-string = p-out-string + "&":U
     3116                                       .
     3117                                   end.
     3118                               end case.
     3119                           end.
     3120                       end.
     3121                   end case.
     3122               end.
     3123           end.
     3124       end.
     3125   end.
     3126   end .
     3127   procedure xmlchar-read-integer :
     3128   define input parameter p-input-string      as character        no-undo.
     3129   define output parameter p-output-integer   as integer          no-undo.
     3130   define output parameter p-success       as logical          no-undo.
     3131   do
     3132   on error undo, return error
     3133   :
     3134       assign
     3135           p-output-integer = integer( p-input-string )
     3136       no-error.
     3137       if error-status :error
     3138       then do:
     3139           assign
     3140               p-success           = no
     3141               p-output-integer    = 0
     3142           .
     3143       end.
     3144       else do:
     3145           assign
     3146               p-success           = yes
     3147           .
     3148       end.
     3149   end.
     3150   end.
     3151   define variable mMRCCode  as logical    no-undo.
     3152   define variable mTypeMark as character  no-undo.
     3153   function IS-NeedMark returns logical
     3154   ( input ib-code as integer  ,
     3155     input ib-str as character ):
     3156      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3157      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3158                                    and buf_prod-bc-attr.b-str  eq ib-str
     3159                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3160        no-lock no-error.
     3161      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3162   end.
     3163   function repTegforDm return char
     3164   (iDM as char ):
     3165       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3166       define variable vteg as character no-undo.
     3167       define variable oDM as character no-undo.
     3168       define variable vi as integer no-undo.
     3169       oDM = iDm.
     3170       do vi = 1 to num-entries(vTeglist):
     3171          vTeg = entry(vi,vTeglist).
     3172          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3173       end.
     3174       return oDM.
     3175   end.
     3176   function repSpecSimbforDm return char
     3177   (iDM as char ):
     3178       define variable oDM as character no-undo.
     3179     run
     3180       xmlchar-decode(iDM, output oDM).
     3181     return repTegforDm (oDM).
     3182   end.
     3183   function CheckGtin return logical
     3184   (iGtin as char):
     3185      define variable bar_code as character no-undo.
     3186      define variable vGtin as logical no-undo init "yes".
     3187      if length(iGtin) eq 14
     3188      then do:
     3189         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3190         run str/chk-sum.p
     3191          (input-output bar_code ) no-error .
     3192         if iGtin ne  bar_code
     3193         then
     3194            vGtin = no.
     3195      end.
     3196      else
     3197         vGtin = no.
     3198      return vgtin.
     3199   end.
     3200   function repSpecSimbforXlm return char
     3201   (iDM as char ):
     3202       iDM = replace(iDM,chr(29),"").
     3203       return iDM.
     3204   end.
     3205   function getGtinByDM return char
     3206   (IDM as char):
     3207      define variable VTXT as char no-undo.
     3208      define variable vGtin as char no-undo.
     3209      vTXt = IdM.
     3210      vGtin = IDM.
     3211      if    length(vtxt) > 14
     3212      then do:
     3213         if   vtxt begins "(01)"
     3214                or vtxt begins "(02)"
     3215         then
     3216            vGtin = substring(vtxt,5,14).
     3217         else if   (vtxt begins "01"
     3218                or vtxt begins "02" )
     3219                and (   (    substring(iDm,17,2) eq "21"
     3220                         and length(vtxt) >= 21)
     3221                     or substring(iDm,17,2) eq "37"
     3222                     or substring(iDm,17,4) eq "(37)" )
     3223         then do:
     3224            vGtin = substring(vtxt,3,14).
     3225            if not checkGtin(vGtin)
     3226            then
     3227               vGtin = substring(vtxt,1,14).
     3228         end.
     3229         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3230             or length(vtxt) eq 14 + 7 + 4
     3231             or length(vtxt) eq 14 + 7
     3232         then
     3233            vGtin = substring(vtxt,1,14).
     3234      end.
     3235      if not checkGtin(vGtin)
     3236      then
     3237         vGtin = "".
     3238      return vgtin.
     3239   end.
     3240   function getGdsCodeByGtin return int
     3241   (iGtin as char):
     3242      define buffer prod-bc  for ub.prod-bc.
     3243      define buffer bar-code for ub.bar-code.
     3244      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3245      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3246      return if avail bar-code then bar-code.gds-code else ?.
     3247   end.
     3248   function getQntyCodeByGtin return decimal
     3249   (iGtin as char):
     3250      define buffer prod-bc  for ub.prod-bc.
     3251      define buffer bar-code for ub.bar-code.
     3252      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3253      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3254      return if avail bar-code then bar-code.cli-base-rate else ?.
     3255   end.
     3256   function getGdsCodeByDM return int
     3257   (iDm as char):
     3258      define variable vGtin as char no-undo.
     3259      define buffer prod-bc for ub.prod-bc.
     3260      vGtin  = getGtinByDM (IDM ).
     3261      return getGdsCodeByGtin (vGtin).
     3262   end.
     3263   function ChekTypeMarkByGds return logical
     3264   (iGds-code as integer ):
     3265      define buffer goods-attr for ub.goods-attr.
     3266      find first goods-attr where goods-attr.gds-code   = iGds-code
     3267                              and goods-attr.attr-code  = 'mark-type':U
     3268      no-lock no-error.
     3269      if available goods-attr
     3270      then do:
     3271         mTypeMark = goods-attr.attr-value.
     3272         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3273           .
     3274      end.
     3275      else
     3276         return no.
     3277   end.
     3278   function ChekTypeMarkByDm return logical
     3279   (iDM as char ):
     3280      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3281   end.
     3282   function ChekTypeMarkByGtin return logical
     3283   (iGtin as char ):
     3284      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3285   end.
     3286   function GetNextElement return character
     3287     (input iAllTeg        as logical
     3288     ,output oteg          as character
     3289     ,output otegval       as character
     3290     ,input-output pstr    as character
     3291      ):
     3292        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3293        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3294        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3295        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3296        define variable vTeg as character no-undo.
     3297        define variable vLength as integer no-undo.
     3298        define variable vi as integer no-undo.
     3299        define variable vj as integer no-undo.
     3300        define buffer code for ub.code.
     3301        find first code where Code.parent eq "MarkType"
     3302                          and Code.CodeValue   eq mTypeMark
     3303                          no-lock no-error.
     3304        if     available code
     3305           and Code.misc1 ne ""
     3306           and Code.misc1 ne ?
     3307        then do:
     3308           integer (Code.misc1) no-error.
     3309           if not error-status:error
     3310           then
     3311             entry (4,vlistleng) = Code.misc1.
     3312        end.
     3313        if iAllTeg
     3314        then
     3315           assign
     3316              vlistElem     = vlistElem    + vlistElemDop
     3317              vlistleng     = vlistleng    + vlistlengDop
     3318           .
     3319        else if mMRCCode
     3320        then
     3321           assign
     3322              vlistElem     = vlistElem    + ",(8005),8005"
     3323              vlistleng     = vlistleng    + ",000006,0006"
     3324           .
     3325       block-elem:
     3326       do vi = 1 to num-entries(vlistElem):
     3327          vTeg = entry(vi,vlistElem).
     3328          if pstr begins vTeg
     3329          then do:
     3330             if    vTeg eq "21"
     3331             then
     3332                vLength = index(pstr,chr(29)) - 2 no-error.
     3333             if vLength  <= 0
     3334             then
     3335                vLength = int(entry(vi,vlistleng)).
     3336             otegval = substring (pstr,length(vteg) + 1, vLength).
     3337             oteg = replace(replace(vteg,")",""),"(","").
     3338             vTeg = vteg + otegval.
     3339             otegval = replace(otegval,chr(29),"").
     3340             oteg = replace(replace(oteg,")",""),"(","").
     3341             pstr = substring (pstr,length(vTeg)+ 1).
     3342             vTeg = replace(vTeg,chr(29),"").
     3343             leave block-elem.
     3344          end.
     3345          else
     3346             vTeg = "".
     3347       end.
     3348       return vteg.
     3349   end.
     3350   function GetCodeIdent return character
     3351   (iDm as char):
     3352      define variable Velement   as character no-undo init "first".
     3353      define variable oCodeIdent as character no-undo.
     3354      define variable vteg as character no-undo.
     3355      define variable vtegval as character no-undo.
     3356      define variable vGtin as character no-undo.
     3357      define buffer marking for ub.marking.
     3358      for first marking no-lock where
     3359                marking.mark eq iDm
     3360            and marking.unit-ext = "LEVEL2"
     3361      :
     3362        return iDm.
     3363      end.
     3364      vGtin  = getGtinByDM (iDm ).
     3365      ChekTypeMarkByDm(idm).
     3366      if iDm begins 'tech_':U
     3367      then
     3368         oCodeIdent = iDm.
     3369      else if length(iDm) < 21
     3370      then do:
     3371         find first marking where marking.mark eq idm
     3372         no-lock no-error.
     3373         oCodeIdent = if available marking then marking.mark else  ?.
     3374      end.
     3375      else if     length(iDm) eq 29
     3376         and not iDm begins "01"
     3377         and not iDm begins "02"
     3378      then
     3379         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3380      else  if     length(iDm) >= 24
     3381               and (  iDm begins "01"
     3382                   or iDm begins "02")
     3383               and  substring(iDm,17,2) ne "21"
     3384      then do:
     3385         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3386                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3387         then
     3388            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3389         else
     3390            oCodeIdent = iDM.
     3391      end.
     3392      else  if     (   length(iDm) eq 25
     3393                    or length(iDm) eq 21)
     3394               and (not iDm begins "01"
     3395               and  not iDm begins "02")
     3396      then
     3397         oCodeIdent = substring(iDm,1,21).
     3398      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3399      then
     3400         oCodeIdent = substring(iDm,1,21).
     3401      else do while Velement ne "" and idm ne "":
     3402         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3403         oCodeIdent = oCodeIdent + Velement.
     3404      end.
     3405      return oCodeIdent.
     3406   end.
     3407   function GetTegCod return character
     3408   (icodeIdent as char, iTeg as char):
     3409      define variable Velement   as character no-undo init "first".
     3410      define variable oTeg as character no-undo init ?.
     3411      define variable vteg as character no-undo.
     3412      define variable vtegval as character no-undo.
     3413      if     ((length(icodeIdent) eq 21
     3414         and not icodeIdent begins "01"
     3415         and not icodeIdent begins "02")
     3416         or
     3417             ( length(icodeIdent) eq 25
     3418               and not icodeIdent begins "01"
     3419               and not icodeIdent begins "02"))
     3420      then do:
     3421         if iTeg eq "01" or iTeg eq "02"
     3422         then
     3423            oTeg = substring(icodeIdent,1,21).
     3424         else  if  iTeg eq "21"
     3425         then
     3426            oTeg = substring(icodeIdent,15,7).
     3427      end.
     3428      else do:
     3429         ChekTypeMarkByDm(icodeIdent).
     3430         block-teg:
     3431            do while Velement ne "" and icodeIdent ne "":
     3432            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3433            if    Velement begins iTeg
     3434               or Velement begins "(" + iTeg + ")"
     3435            then do:
     3436               oTeg = vtegval.
     3437               leave block-teg.
     3438            end.
     3439         end.
     3440      end.
     3441      return oTeg.
     3442   end.
     3443   function isOAD return logical
     3444   (icodeIdent as character):
     3445      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3446   end.
     3447   function isMark return logical
     3448   (icodeIdent as character):
     3449      define buffer buf_marking for ub.marking.
     3450      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3451             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3452   end.
     3453   function addBracketForCode return character
     3454   (icodeIdent as char):
     3455      define variable Velement   as character no-undo init "first".
     3456      define variable oTeg as character no-undo.
     3457      define variable vteg as character no-undo.
     3458      define variable vtegval as character no-undo.
     3459      define buffer marking for ub.marking.
     3460      find first marking no-lock where
     3461                 marking.mark begins icodeIdent no-error.
     3462      if    not ChekTypeMarkByDm(icodeIdent)
     3463         or length(icodeIdent) le 24
     3464         or (avail marking and marking.unit-ext = "LEVEL2")
     3465      then
     3466         oTeg = icodeIdent.
     3467      else do:
     3468         if (  icodeIdent begins "01"
     3469            or icodeIdent begins "02"
     3470            ) and CheckGtin(substring (icodeIdent,3,14))
     3471            and substring (icodeIdent,17,2) eq "21"
     3472         then do:
     3473            mMRCCode = yes.
     3474            ChekTypeMarkByDm(icodeIdent).
     3475            block-teg:
     3476            do while Velement ne "" and icodeIdent ne "":
     3477               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3478               if vteg ne ""
     3479               then
     3480                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3481            end.
     3482            mMRCCode = no.
     3483         end.
     3484         else do:
     3485            oTeg = icodeIdent.
     3486         end.
     3487      end.
     3488      return oTeg.
     3489   end.
     3490   function getlevelByCodId return int
     3491   (iCode as char):
     3492      define variable vLength as int no-undo.
     3493      define variable vLevel  as int no-undo.
     3494      if not ChekTypeMarkByDM (icode) then return ?.
     3495      vLength = length(iCode).
     3496      if    vLength eq 18
     3497         or vLength eq 20
     3498      then
     3499         Vlevel = 4.
     3500      else if vLength eq 21
     3501      then
     3502         Vlevel = 1.
     3503      else if vLength eq 25
     3504      then do:
     3505         if  iCode begins "01"
     3506         then
     3507            Vlevel = 3.
     3508         else
     3509            Vlevel = 1.
     3510      end.
     3511      else if     vLength >= 26
     3512              and vLength <= 46
     3513      then do:
     3514         if    substring(iCode,17,2) eq "11"
     3515            or substring(iCode,17,2) eq "13"
     3516            or (    substring(iCode,17,2) eq "21"
     3517                and vLength >= 33
     3518                and substring(iCode,26,4) ne "8005")
     3519         then
     3520            Vlevel = 4.
     3521         else if    vLength eq 31
     3522                 or vLength eq 38
     3523                 or vLength eq 39
     3524                 or vLength eq 45
     3525         then
     3526            Vlevel = 1.
     3527         else if    vLength eq 35
     3528                 or vLength eq 43
     3529         then
     3530            Vlevel = 3.
     3531         else
     3532            Vlevel = ?.
     3533      end.
     3534      else
     3535         Vlevel = ?.
     3536      return Vlevel.
     3537   end.
     3538   function getLevelMotpBycodid return character
     3539   (iDm as char):
     3540      define variable vLevel as integer no-undo.
     3541      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3542      vLevel = getlevelByCodId(iDm).
     3543      if    vLevel eq ?
     3544         or vLevel < 1
     3545         or vLevel > 6
     3546      then
     3547         return ?.
     3548      else
     3549         return entry(vlevel,vList).
     3550   end.
     3551   function getLevelUTDByLevelMotp return character
     3552   (iUnit as char):
     3553      define variable vLevel as integer no-undo.
     3554      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3555      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3556      vLevel = lookup(iUnit,vListMOTP).
     3557      if    vLevel eq ?
     3558         or vLevel < 1
     3559         or vLevel > 4
     3560      then
     3561         return ?.
     3562      else
     3563         return entry(vlevel,vListutd).
     3564   end.
     3565   function getLevelMotpByDM return character
     3566   (iDm as char):
     3567      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3568   end.
     3569   function getLevelUTDByCodId return character
     3570   (iDm as char):
     3571      define variable vLevel as integer no-undo.
     3572      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3573      vLevel = getlevelByCodId(iDm).
     3574      if    vLevel eq ?
     3575         or vLevel < 1
     3576         or vLevel > 4
     3577      then
     3578         return ?.
     3579      else
     3580         return entry(vlevel,vList).
     3581   end.
     3582   function getLevelUTDByDM return character
     3583   (iDm as char):
     3584      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3585   end.
     3586   define variable mNotMarkQnty as logical no-undo.
     3587   function getQntyUTDByCodId return decimal
     3588   (iDM as char):
     3589      define variable vLevel as integer no-undo.
     3590      define variable vList as character no-undo init "1,5,10,500".
     3591      define variable vGtin as character no-undo.
     3592      define variable vqnty as decimal no-undo init ?.
     3593      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3594      if vqnty eq ?
     3595      then do:
     3596         if not mNotMarkQnty
     3597         then do:
     3598            define buffer marking for ub.marking.
     3599            define variable vCodident as character no-undo.
     3600            vCodident = GetCodeIdent(idm).
     3601            find first marking where marking.mark begins vCodident no-lock no-error.
     3602            if     available marking
     3603               and marking.box-qnty ne ?
     3604            then
     3605               return marking.box-qnty.
     3606         end.
     3607         vGtin = getGtinByDm(iDM).
     3608         if ChekTypeMarkByGtin (vGtin)
     3609         then do:
     3610            vLevel = getlevelByCodId(iDM).
     3611            if     vLevel >= 1
     3612               and vLevel <= 4
     3613            then
     3614               vqnty = int(entry(vlevel,vList)).
     3615         end.
     3616         else
     3617            vqnty = getQntyCodeByGtin(vgtin).
     3618      end.
     3619      return vqnty.
     3620   end.
     3621   function getQntyUTDByDM return decimal
     3622   (iDm as char):
     3623      define variable vDM as character no-undo.
     3624      if     length (iDm) ne 25
     3625         and length (iDm) ne 29
     3626         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3627      then
     3628         vDM = substring (iDm,1,length (iDm) - 6 ).
     3629      else
     3630         vDM = substring (iDm,1,length (iDm) - 4 ).
     3631      return getQntyUTDByCodId(vDM).
     3632   end.
     3633   function getMRC4 return decimal
     3634   (iMRC as char):
     3635      define variable oMrc     as decimal no-undo init ?.
     3636      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3637      define variable vi       as integer no-undo.
     3638      define variable vfound   as integer no-undo.
     3639      define variable vposStart   as integer no-undo.
     3640      do:
     3641      OMRc = 0.
     3642      do vi = 1 to 4:
     3643         define variable vsimb as character no-undo.
     3644         vsimb = substring(iMRC,vi,1).
     3645         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3646         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3647         if vfound > 0
     3648         then
     3649            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3650         end.
     3651         OMRc = OMRc / 100.
     3652      end.
     3653      return OMRc.
     3654   end.
     3655   function getMRCByDM return decimal
     3656   (iDm as char):
     3657      define variable vMRC     as character no-undo.
     3658      define variable oMrc     as decimal no-undo init ?.
     3659      define variable Velement as character no-undo init "empty".
     3660      define variable vteg as character no-undo.
     3661      define variable vtegval as character no-undo.
     3662      if    length(idm) eq 14 + 7 + 4 + 4
     3663         or length(idm) eq 14 + 7 + 4
     3664      then do:
     3665         vMRC = substring(idm,22,4).
     3666         omrc = getMRC4(vMRC).
     3667      end.
     3668      else do:
     3669          ChekTypeMarkByDm(iDm).
     3670          block-mrc:
     3671          do while Velement ne "" and idm ne "":
     3672             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3673             if Velement begins "8005"
     3674             then do:
     3675                vMRC = substring(Velement,5,6).
     3676                leave block-mrc.
     3677             end.
     3678             else if Velement begins "(8005)"
     3679             then do:
     3680                vMRC = substring(Velement,7,6).
     3681                leave block-mrc.
     3682             end.
     3683          end.
     3684          if vMRC ne ""
     3685          then
     3686             OMRc = dec(vmrc) / 100 no-error.
     3687      end.
     3688      return OMRc.
     3689   end.
     3690   function MoveDate return Date
     3691   (idate as date,
     3692    iMonth as int64):
     3693      define variable vMonth   as int64 no-undo.
     3694      define variable vYear    as int64 no-undo.
     3695      define variable vDateNew as date  no-undo.
     3696       define variable vDay     as int64 no-undo.
     3697       vMonth = month(iDate) + iMonth.
     3698       vYear =  year(iDate).
     3699       if vMonth <= 0
     3700       then assign
     3701          vMonth = vMonth + 12
     3702           vYear  = vYear - 1
     3703       .
     3704       else if vMonth > 12
     3705       then assign
     3706          vMonth = vMonth - 12
     3707           vYear  = vYear + 1
     3708       .
     3709       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3710       do while error-status:error eq yes:
     3711          VDay = vDay + 1.
     3712          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3713       end.
     3714       if VDay > 0
     3715       then
     3716          vDateNew + 1.
     3717       return vDateNew.
     3718   end.
     3719   procedure checkEMRC:
     3720   define input  parameter iDm as character no-undo.
     3721   define output parameter vok as logical   no-undo init yes.
     3722      define variable v-value-emrc as character no-undo.
     3723      define variable v-type-emrc  as character no-undo.
     3724      define variable vDateIso     as character no-undo.
     3725      define variable vMRC         as decimal no-undo.
     3726      define variable vqnty        as decimal no-undo.
     3727      define variable vPrice       as decimal no-undo.
     3728      define variable vparent      as character no-undo.
     3729      define variable vgds-code    as integer no-undo.
     3730      define buffer code for ub.code.
     3731      vMRC = getMRCByDM(iDm).
     3732      if vMRC > 0
     3733      then do:
     3734         vgds-code = getGdsCodeByDM(iDm).
     3735         vqnty     = getQntyUTDByDM(iDm).
     3736               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3737            (
     3738             input   vgds-code
     3739            ,input   'emrc-type':U
     3740            ,output   v-value-emrc
     3741            ,output   v-type-emrc
     3742          ) no-error.
     3743          if     v-value-emrc ne ""
     3744             and v-value-emrc ne ?
     3745          then do:
     3746             vDateIso = iso-date(today).
     3747             vPrice = vMRC / vqnty.
     3748             vparent ="emc" + chr(4) + v-value-emrc.
     3749             find last code where Code.parent      eq vparent
     3750                              and Code.code        le vDateIso
     3751                              and code.status_  eq 0
     3752             no-lock no-error.
     3753             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3754             then
     3755                vOk = true .
     3756             else do:
     3757                 define variable vText      as character no-undo.
     3758                 define variable vDate      as date no-undo.
     3759                 define variable vDateLast  as character no-undo.
     3760                 define variable vDateFirst as character no-undo.
     3761                 define variable vDate3     as date no-undo.
     3762                 vdate = date(code.misc1).
     3763                 vDateLast = code.misc1.
     3764                 vDate3 = MoveDate(today, - 3 ).
     3765                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3766                                      string(vDate3  , "99/99/9999"),
     3767                                      string(vDate   , "99/99/9999")
     3768                                      ).
     3769                 vdateIso = iso-date(vdate3).
     3770                 find last code  where Code.parent      eq vparent
     3771                                   and Code.code        le vDateIso
     3772                                   and code.status_  eq 0 no-lock no-error.
     3773                 if available code
     3774                 then
     3775                    vDateIso = code.code.
     3776                 vDateFirst = vDateIso.
     3777                 vDateLast = iso-date(vdate).
     3778                 define variable vGood as logical no-undo.
     3779                 define variable vDateSale as date no-undo.
     3780                 define buffer bcode for code.
     3781                 for last code where Code.parent   eq vparent
     3782                                 and code.status_  eq 0
     3783                                 and code.code     < vDateLast
     3784                                 and code.code     >= vDateFirst
     3785                 no-lock:
     3786                    find first bcode where bCode.parent   eq vparent
     3787                                       and bcode.status_  eq 0
     3788                                       and bcode.code     > code.code no-lock no-error.
     3789                    if available bcode
     3790                    then do:
     3791                       if vPrice < dec(Code.CodeValue)
     3792                       then
     3793                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3794                                                     chr(10),
     3795                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3796                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3797                                                     ).
     3798                       else do:
     3799                          vGood = yes.
     3800                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3801                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3802                                                     chr(10),
     3803                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3804                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3805                                                     string(         vDateSale            ,"99/99/9999"),
     3806                                                     string(vDateSale - today)
     3807                                                     ).
     3808                       end.
     3809                    end.
     3810                 end.
     3811                 if vgood
     3812                 then do:
     3813                    define variable choice as integer no-undo .
     3814                    run gbl/d-askw.w (input "Уточнение"
     3815                           ,input  vText
     3816                           ,input "|"
     3817                           ,input "Принять|Вернуть"
     3818                           ,input "Принять данный товар|Вернуть товар постащику"
     3819                           ,input 1
     3820                           ,input 2
     3821                           ,output choice) no-error.
     3822                    vok = choice eq 1.
     3823                 end.
     3824                 else
     3825                    vok =false.
     3826             end.
     3827          end.
     3828      end.
     3829   end.
     3830   function addGs2Mark return character
     3831   (iMark as char):
     3832      define variable vDM   as character no-undo.
     3833      define variable vIdx  as integer   no-undo.
     3834      if index(iMark,chr(29),1) > 0
     3835      then return iMark.
     3836      if substring(iMark,26,4) = "8005" then
     3837      do:
     3838        vIdx = index(iMark,"93",26 + 4 + 5).
     3839        if vIdx > 1 then do:
     3840          vDM = substitute("&1&4&2&4&3",
     3841                           substring(iMark,1,25),
     3842                           substring(iMark,26,vIdx - 25 - 1),
     3843                           substring(iMark,vIdx),
     3844                           chr(29)) no-error.
     3845          vIdx = index(vDm,"240",vIdx + 4).
     3846          if vIdx > 0 then
     3847          do:
     3848            vDM = substitute("&1&3&2",
     3849                             substring(vDm,1,vIdx - 1),
     3850                             substring(vDm,vIdx),
     3851                             chr(29)) no-error.
     3852          end.
     3853        end.
     3854        else
     3855          vDM = substitute("&1&3&2",
     3856                           substring(iMark,1,25),
     3857                           substring(iMark,26),
     3858                           chr(29)) no-error.
     3859      end.
     3860      else if substring(iMark,32,2) = "91" then
     3861      do:
     3862        vIdx = index(iMark,"92",32).
     3863        if vIdx > 1 then
     3864          vDM = substitute("&1&4&2&4&3",
     3865                           substring(iMark,1,31),
     3866                           substring(iMark,32,vIdx - 31 - 1),
     3867                           substring(iMark,vIdx),
     3868                           chr(29)) no-error.
     3869        else
     3870          vDM = substitute("&1&3&2",
     3871                           substring(iMark,1,31),
     3872                           substring(iMark,32),
     3873                           chr(29)) no-error.
     3874      end.
     3875      else if substring(iMark,39,2) = "91" then
     3876      do:
     3877        vIdx = index(iMark,"92",38).
     3878        if vIdx > 1 then
     3879          vDM = substitute("&1&4&2&4&3",
     3880                           substring(iMark,1,38),
     3881                           substring(iMark,39,vIdx - 38 - 1),
     3882                           substring(iMark,vIdx),
     3883                           chr(29)) no-error.
     3884        else
     3885          vDM = substitute("&1&3&2",
     3886                           substring(iMark,1,38),
     3887                           substring(iMark,39),
     3888                           chr(29)) no-error.
     3889      end.
     3890      else if substring(iMark,25,2) = "93" then
     3891      do:
     3892        vIdx = index(iMark,"92",25).
     3893        if vIdx > 1 then
     3894          vDM = substitute("&1&4&2&4&3",
     3895                           substring(iMark,1,24),
     3896                           substring(iMark,25,vIdx - 24 - 1),
     3897                           substring(iMark,vIdx),
     3898                           chr(29)) no-error.
     3899        else
     3900          vIdx = index(iMark,"3103",25).
     3901          if vIdx > 0 then
     3902          vDM = substitute("&1&4&2&4&3",
     3903                           substring(iMark,1,24),
     3904                           substring(iMark,25,vIdx - 24 - 1),
     3905                           substring(iMark,vIdx),
     3906                           chr(29)) no-error.
     3907          else
     3908            vDM = substitute("&1&3&2",
     3909                             substring(iMark,1,24),
     3910                             substring(iMark,25),
     3911                             chr(29)) no-error.
     3912      end.
     3913      else if substring(iMark,32,2) = "93" then
     3914      do:
     3915        vDM = substitute("&1&3&2",
     3916              substring(iMark,1,31),
     3917              substring(iMark,32),
     3918              chr(29)) no-error.
     3919      end.
     3920      return if vDM <> "" then vDm else iMark.
     3921   end.
     3922   def var vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3923   function AddUtdErrForTab returns logical
     3924   (idb-num         as integer ,
     3925    idoc-id         as integer ,
     3926    iTab            as character,
     3927    iObj            as handle ,
     3928    iCheckType      as character,
     3929    iCodeErr        as character,
     3930    iCheckObj       as character ):
     3931      define buffer utd-err for utd-err.
     3932      define buffer utd for utd.
     3933      find first utd where utd.db-num     eq idb-num
     3934                       and utd.doc-id     eq idoc-id
     3935                       and utd.Direction  eq 'Outbound'
     3936      no-lock no-error.
     3937      if available utd
     3938      then
     3939         return no.
     3940      define variable vRecKey as character no-undo.
     3941            run gen-key-rec (input iTab,
     3942                             input  iObj,
     3943                             output vRecKey).
     3944      find first utd-err where utd-err.db-num     eq idb-num
     3945                           and utd-err.doc-id     eq idoc-id
     3946                           and utd-err.CheckType  eq iCheckType
     3947                           and utd-err.CodeErr    eq iCodeErr
     3948                           and utd-err.CheckObj   eq iCheckObj
     3949      exclusive-lock no-error.
     3950      if not available utd-err
     3951      then do:
     3952         create utd-err.
     3953         assign
     3954            utd-err.db-num         = idb-num
     3955            utd-err.doc-id         = idoc-id
     3956            utd-err.CheckType      = iCheckType
     3957            utd-err.CodeErr        = iCodeErr
     3958            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3959            utd-err.reckey         = vRecKey
     3960            utd-err.qnty           = 1
     3961         .
     3962      end.
     3963      else
     3964         utd-err.qnty = utd-err.qnty + 1.
     3965      return utd-err.qnty eq 1.
     3966   end.
     3967   function AddUtdErr returns logical
     3968   (idb-num         as integer ,
     3969    idoc-id         as integer ,
     3970    iObj            as handle ,
     3971    iCheckType      as character,
     3972    iCodeErr        as character,
     3973    iCheckObj       as character ):
     3974      AddUtdErrForTab
     3975         (idb-num,
     3976          idoc-id,
     3977          iObj:table,
     3978          iObj,
     3979          iCheckType,
     3980          iCodeErr,
     3981          iCheckObj).
     3982   end.
     3983   function ClearUtdErrTypeCode returns logical
     3984   (idb-num         as integer,
     3985    idoc-id         as integer ,
     3986    iCheckType      as character,
     3987    iCodeErr        as character
     3988    ):
     3989      define buffer utd-err for utd-err.
     3990      if    iCheckType eq "*"
     3991         or iCheckType eq ?
     3992      then do:
     3993         if     iCodeErr ne ?
     3994            and iCodeErr ne "*"
     3995         then
     3996            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3997            view-as alert-box.
     3998         else
     3999         for each utd-err where utd-err.db-num  eq idb-num
     4000                            and utd-err.doc-id  eq idoc-id
     4001         exclusive-lock:
     4002            delete utd-err.
     4003         end.
     4004      end.
     4005      else do:
     4006         if    iCodeErr eq ?
     4007            or iCodeErr eq "*"
     4008         then do:
     4009            for each utd-err where utd-err.db-num     eq idb-num
     4010                               and utd-err.doc-id     eq idoc-id
     4011                               and utd-err.CheckType  eq iCheckType
     4012            exclusive-lock:
     4013               delete utd-err.
     4014            end.
     4015         end.
     4016         else do:
     4017            for each utd-err where utd-err.db-num     eq idb-num
     4018                               and utd-err.doc-id     eq idoc-id
     4019                               and utd-err.CheckType  eq iCheckType
     4020                               and ub.utd-err.CodeErr eq iCodeErr
     4021            exclusive-lock:
     4022               delete utd-err.
     4023            end.
     4024         end.
     4025      end.
     4026   end.
     4027   function ClearUtdErr returns logical
     4028   (idb-num         as integer,
     4029    idoc-id         as integer ,
     4030    iCheckType      as character
     4031    ):
     4032      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     4033   end.
     4034   function GetMesError returns character
     4035   (itxt as character,
     4036    iobj as character ):
     4037    define variable vi as integer no-undo.
     4038    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     4039       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     4040    end.
     4041    return itxt.
     4042   end.
     4043   function GetTextErrorType returns character
     4044   (iCheckType as character,
     4045    iCodeErr   as character,
     4046    iChechObj  as character,
     4047    iType      as character  ):
     4048      define buffer code    for code.
     4049      define variable vError as character no-undo.
     4050      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4051                        and code.code   eq iCodeErr
     4052      no-lock no-error.
     4053      if available code
     4054      then do:
     4055         define variable vType as integer no-undo.
     4056         if code.misc3 eq "error"
     4057         then
     4058            vType = 0.
     4059         else if code.misc3 eq "warning"
     4060         then
     4061            vType = 1.
     4062         else if code.misc3 eq "Hiden"
     4063         then
     4064            vType = 2.
     4065         else
     4066            vtype = int(code.misc3) no-error.
     4067         case itype:
     4068            when "error"
     4069            then do:
     4070               if vtype eq 0
     4071               then
     4072                  vError = GetMesError(Code.CodeValue,iChechObj).
     4073            end.
     4074            when "warning"
     4075            then do:
     4076               if vtype <= 1
     4077               then
     4078                  vError = GetMesError(Code.CodeValue,iChechObj).
     4079            end.
     4080            otherwise do:
     4081               vError = GetMesError(Code.CodeValue,iChechObj).
     4082            end.
     4083         end.
     4084      end.
     4085      else
     4086         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     4087      return vError.
     4088   end.
     4089   function GetTypeError returns integer
     4090   (iCheckType as character,
     4091    iCodeErr   as character):
     4092      define buffer code    for code.
     4093      define variable vType as integer no-undo.
     4094      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4095                        and code.code   eq iCodeErr
     4096      no-lock no-error.
     4097      if     not available code
     4098         and code.misc3 eq "error"
     4099      then
     4100         vType = 0.
     4101      else if code.misc3 eq "warning"
     4102      then
     4103         vType = 1.
     4104      else if code.misc3 eq "Hiden"
     4105      then
     4106         vType = 2.
     4107      else
     4108         vtype = int(code.misc3) no-error.
     4109      return vtype.
     4110   end.
     4111   function GetTextError returns character
     4112   (iCheckType as character,
     4113    iCodeErr   as character,
     4114    iChechObj  as character ):
     4115      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     4116   end.
     4117   function GetErrForUtdStr returns character
     4118   (idb-num     as integer ,
     4119    idoc-id     as integer ,
     4120    iCheckType  as character
     4121    ):
     4122      define buffer utd-err for utd-err.
     4123      define buffer code    for code.
     4124      define variable vHQry as handle no-undo.
     4125      define variable vError as longchar no-undo.
     4126      define variable vErrorOne as longchar  no-undo.
     4127      define variable oError as character no-undo.
     4128      create query vHQry.
     4129      vHQry:set-buffers(buffer utd-err:handle).
     4130      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4131                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4132                               + if    iCheckType eq "*"
     4133                                    or iCheckType eq ?
     4134                                 then       ""
     4135                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4136      vHQry:query-open().
     4137      vHQry:get-first().
     4138      QRY-BLOCK:
     4139      repeat while not vHQry:query-off-end:
     4140         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4141         if     vErrorOne ne ""
     4142            and vErrorOne ne ?
     4143         then
     4144            vError = vError + ", " + vErrorOne.
     4145         vHQry:get-next().
     4146      end.
     4147      oError = substring(vError,3,4002).
     4148      return oError.
     4149   end.
     4150   function GetErrJsonForUtd returns character
     4151   (idb-num         as integer ,
     4152    idoc-id         as integer ,
     4153    iCheckType      as character
     4154    ):
     4155      define buffer utd-err for utd-err.
     4156      define variable vHQry as handle no-undo.
     4157      define variable vError as longchar no-undo.
     4158      define variable oError as character no-undo.
     4159      create query vHQry.
     4160      define variable vi as integer no-undo.
     4161      vHQry:set-buffers(buffer utd-err:handle).
     4162      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4163                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4164                               + if    iCheckType eq "*"
     4165                                    or iCheckType eq ?
     4166                                 then       ""
     4167                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4168      vHQry:query-open().
     4169      vHQry:get-first().
     4170      QRY-BLOCK:
     4171      repeat while not vHQry:query-off-end:
     4172         define variable vErrorOne as character no-undo.
     4173         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4174         if     vErrorOne ne ?
     4175            and vErrorOne ne ""
     4176         then do:
     4177            vi = vi + 1.
     4178            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     4179                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     4180                            + '","ТекстОш":"' + vErrorOne + '"}'.
     4181         end.
     4182         vHQry:get-next().
     4183      end.
     4184      for first utd where utd.db-num eq idb-num
     4185                      and utd.doc-id eq idoc-id
     4186                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     4187      no-lock,
     4188         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     4189                                  and utd-marking-lines.doc-id eq idoc-id
     4190                                  and utd-marking-lines.doc-level eq 1
     4191      no-lock,
     4192         first marking where marking.mark eq utd-marking-lines.mark
     4193                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4194      no-lock:
     4195         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     4196         if     vErrorOne ne ?
     4197            and vErrorOne ne ""
     4198         then do:
     4199            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     4200                            + '","ОбъектОш":"' + marking.mark
     4201                            + '","ТекстОш":"' + vErrorOne + '"}'.
     4202         end.
     4203      end.
     4204      if vError ne ""
     4205      then
     4206         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     4207      return oError.
     4208   end.
     4209   function GetErrJsonForUtdReturn returns character
     4210   (idb-num         as integer ,
     4211    idoc-id         as integer ,
     4212    iCheckType      as character
     4213    ):
     4214      define buffer utd-err for utd-err.
     4215      define variable vHQry as handle no-undo.
     4216      define variable vError as longchar no-undo.
     4217      define variable oError as character no-undo.
     4218      define variable vi as integer no-undo.
     4219      create query vHQry.
     4220      vHQry:set-buffers(buffer utd-err:handle).
     4221      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4222                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4223                               + if    iCheckType eq "*"
     4224                                    or iCheckType eq ?
     4225                                 then       ""
     4226                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4227      vHQry:query-open().
     4228      vHQry:get-first().
     4229      QRY-BLOCK:
     4230      repeat while not vHQry:query-off-end:
     4231         define variable vErrorOne as character no-undo.
     4232         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4233         if     vErrorOne ne ?
     4234            and vErrorOne ne ""
     4235         then do:
     4236            vi = vi + 1.
     4237            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     4238                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     4239                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     4240         end.
     4241         vHQry:get-next().
     4242      end.
     4243      if vError ne ""
     4244      then
     4245         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     4246      return oError.
     4247   end.
     4248   function GetCodeTextError returns character
     4249   (iCheckType as character,
     4250    iCodeErr   as character,
     4251    iChechObj  as character,
     4252    output oCode as character,
     4253    output ovalue as character ):
     4254      define buffer code    for code.
     4255      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4256                        and code.code   eq iCodeErr
     4257      no-lock no-error.
     4258      if     available code
     4259      then do:
     4260         define variable vi as integer no-undo init ?.
     4261         vi = int(Code.misc3) no-error.
     4262         if    code.misc3 ne "error"
     4263            and vi ne 0
     4264         then
     4265            oCode = ?.
     4266         else if     Code.misc1 ne ?
     4267                 and Code.misc1 ne ""
     4268         then
     4269            assign
     4270               oCode  = GetMesError(Code.misc1,iChechObj)
     4271               ovalue = GetMesError(Code.misc2,iChechObj)
     4272            .
     4273      end.
     4274      return if oCode eq ""
     4275             then ""
     4276             else (oCode + "_" + ovalue).
     4277   end.
     4278   define temp-table TT-err no-undo
     4279     field code_ as character
     4280     field text_ as character
     4281   index code_ code_.
     4282   function GetErrTxtForUtd returns character
     4283   (idb-num         as integer ,
     4284    idoc-id         as integer ,
     4285    iCheckType      as character
     4286    ):
     4287      define buffer utd-err for utd-err.
     4288      define variable vHQry as handle no-undo.
     4289      define variable oError as character no-undo.
     4290      create query vHQry.
     4291      define variable vi as integer no-undo.
     4292      for each tt-err :
     4293         delete tt-err.
     4294      end.
     4295      vHQry:set-buffers(buffer utd-err:handle).
     4296      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4297                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4298                               + if    iCheckType eq "*"
     4299                                    or iCheckType eq ?
     4300                                 then       ""
     4301                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4302      vHQry:query-open().
     4303      vHQry:get-first().
     4304      define variable vcode as character no-undo.
     4305      define variable vvalue as character no-undo.
     4306      QRY-BLOCK:
     4307      repeat while not vHQry:query-off-end:
     4308         vi = vi + 1.
     4309         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     4310         if vcode ne ?
     4311         then do:
     4312            find first tt-err where tt-err.code eq vcode
     4313            no-error.
     4314            if not available tt-err
     4315            then do:
     4316               create tt-err.
     4317               assign
     4318                  tt-err.code_ = vcode
     4319                  tt-err.text_ = vvalue
     4320               .
     4321            end.
     4322            else
     4323               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4324         end.
     4325         vHQry:get-next().
     4326      end.
     4327     find first utd where utd.db-num eq idb-num
     4328                         and utd.doc-id eq idoc-id
     4329         no-lock.
     4330      define buffer cancel_utd-lines for utd-lines.
     4331      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     4332                                  and cancel_utd-lines.doc-id eq idoc-id
     4333      no-lock:
     4334         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     4335         then do:
     4336            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     4337                                        and utd-marking-lines.doc-id eq idoc-id
     4338                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     4339            no-lock,
     4340               first marking where marking.mark eq utd-marking-lines.mark
     4341                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4342            no-lock:
     4343               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     4344               find first tt-err where tt-err.code eq vcode
     4345               no-error.
     4346               if not available tt-err
     4347               then do:
     4348                  create tt-err.
     4349                  assign
     4350                     tt-err.code_ = vcode
     4351                     tt-err.text_ = vvalue
     4352                  .
     4353               end.
     4354               else
     4355                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4356            end.
     4357         end.
     4358         else do:
     4359            define variable vqnty as decimal no-undo.
     4360            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     4361            if vqnty eq ? then vqnty = 0.
     4362            if vqnty ne cancel_utd-lines.Quantity
     4363            then do:
     4364               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     4365               find first tt-err where tt-err.code eq vcode
     4366               no-error.
     4367               if not available tt-err
     4368               then do:
     4369                  create tt-err.
     4370                  assign
     4371                     tt-err.code_ = vcode
     4372                     tt-err.text_ = vvalue
     4373                  .
     4374               end.
     4375               else
     4376                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4377            end.
     4378         end.
     4379      end.
     4380      for each tt-err:
     4381         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     4382      end.
     4383      return oError.
     4384   end.
     4385   define variable mFormatErr as character no-undo init "text".
     4386   function GetErrForUtd returns character
     4387   (idb-num         as integer ,
     4388    idoc-id         as integer ,
     4389    iType           as character
     4390    ):
     4391      if mFormatErr eq "text"
     4392      then
     4393         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     4394      else do:
     4395         if itype eq "return"
     4396         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     4397         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     4398      end.
     4399   end.
     4400   function GetErrComText returns longchar
     4401   (icomment as character,
     4402    itext    as longchar ):
     4403       define variable vText as longchar no-undo.
     4404      if mFormatErr eq "text"
     4405      then do:
     4406         if icomment ne ""
     4407         then
     4408            icomment = substitute("comment:|&1|",icomment).
     4409         vText = icomment + itext.
     4410      end.
     4411      else do:
     4412         icomment = if icomment begins  '"'
     4413                    then icomment
     4414                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     4415         vText = icomment + "," + itext.
     4416         vText = "~{" + trim(vText,",") + "~}".
     4417      end.
     4418      return vText.
     4419   end.
     4420   function CheckTypeForMarkLineType returns logical
     4421   (iObj            as handle,
     4422    iCheckType      as character,
     4423    iCodeErr        as character ,
     4424    iTypeErr        as character ):
     4425      define variable vRecKey-markLine as character no-undo.
     4426      define variable vGoodMark        as logical no-undo.
     4427      define variable vdb-num          as integer no-undo.
     4428      define variable vdoc-id          as integer no-undo.
     4429      define variable vlinenum         as integer no-undo.
     4430      define variable vErrorOne as character no-undo.
     4431      define buffer buf_utd-err for utd-err.
     4432      run gen-key-rec (input "utd-marking-lines",
     4433                       input  iObj,
     4434                       output vRecKey-markLine).
     4435      vGoodMark = yes.
     4436      vdb-num = iObj::db-num.
     4437      vdoc-id = iObj::doc-id.
     4438      vlinenum = iObj::linenum.
     4439      block-mark-err:
     4440      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4441                               and buf_utd-err.db-num = vdb-num
     4442                               and buf_utd-err.reckey = vRecKey-markLine
     4443                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     4444                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     4445      no-lock:
     4446         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     4447         if     vErrorOne ne ?
     4448            and vErrorOne ne ""
     4449         then do:
     4450            vGoodMark = no.
     4451            leave block-mark-err.
     4452         end.
     4453      end.
     4454      return not vGoodMark.
     4455   end.
     4456   function CheckErrForMarkLineType returns logical
     4457   (iObj            as handle,
     4458    iType           as character  ):
     4459      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     4460   end.
     4461   function CheckErrForMarkLine returns logical
     4462   (iObj            as handle):
     4463      return CheckErrForMarkLineType(iObj,"*").
     4464   end.
     4465   function CheckErrForLineTypeCode returns logical
     4466   (iObj                 as handle,
     4467    iCheckType           as character,
     4468    iCodeErr             as character,
     4469    iTypeErr             as character,
     4470    iOneErr              as logical):
     4471      define variable vRecKey-line     as character no-undo.
     4472      define buffer buf_utd-err for utd-err.
     4473      define variable vUtdlineError as logical no-undo.
     4474      define variable vErrorOne as character no-undo.
     4475            run gen-key-rec (input "utd-lines",
     4476                             input  iObj,
     4477                             output vRecKey-line).
     4478         define variable vdb-num as integer no-undo.
     4479         define variable vdoc-id as integer no-undo.
     4480         define variable vlinenum as integer no-undo.
     4481         vdb-num = iObj::db-num.
     4482         vdoc-id = iObj::doc-id.
     4483         vlinenum = iObj::linenum.
     4484         block-err:
     4485         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4486                                  and buf_utd-err.db-num = vdb-num
     4487                                  and buf_utd-err.reckey = vRecKey-line
     4488                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     4489                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     4490         no-lock:
     4491            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     4492            if     vErrorOne ne ?
     4493               and vErrorOne ne ""
     4494            then do:
     4495               vUtdlineError = yes.
     4496               leave block-err.
     4497            end.
     4498         end.
     4499         if  not vUtdlineError
     4500         then do:
     4501            define variable vGoodMark as logical no-undo.
     4502            vGoodMark = yes.
     4503            block-line-err:
     4504            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     4505                                         and utd-marking-lines.doc-id  eq vdoc-id
     4506                                         and utd-marking-lines.LineNum eq vLineNum
     4507            no-lock:
     4508               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     4509               if     vGoodMark
     4510                  and iOneErr eq no
     4511               then
     4512                  leave block-line-err.
     4513               if     iOneErr = yes
     4514                  and not vGoodMark
     4515               then
     4516                  leave block-line-err.
     4517            end.
     4518            vUtdlineError = not vGoodMark.
     4519         end.
     4520      return vUtdlineError.
     4521   end.
     4522   function getErrForLineType returns character
     4523   (iObj            as handle,
     4524    iType           as character  ):
     4525      define variable vRecKey-line     as character no-undo.
     4526      define buffer buf_utd-err for utd-err.
     4527      define variable vUtdlineError as logical no-undo.
     4528      define variable vErrorOne as character no-undo.
     4529      define variable oError as character no-undo.
     4530            run gen-key-rec (input "utd-lines",
     4531                             input  iObj,
     4532                             output vRecKey-line).
     4533         define variable vdb-num as integer no-undo.
     4534         define variable vdoc-id as integer no-undo.
     4535         define variable vlinenum as integer no-undo.
     4536         vdb-num = iObj::db-num.
     4537         vdoc-id = iObj::doc-id.
     4538         vlinenum = iObj::linenum.
     4539         block-err:
     4540         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4541                                  and buf_utd-err.db-num = vdb-num
     4542                                  and buf_utd-err.reckey = vRecKey-line
     4543                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     4544         no-lock:
     4545            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     4546            if     vErrorOne ne ?
     4547               and vErrorOne ne ""
     4548            then do:
     4549               oError = oError + vErrorOne + " ".
     4550            end.
     4551         end.
     4552      return oError.
     4553   end.
     4554   function CheckErrForLineType returns logical
     4555   (iObj            as handle,
     4556    iType           as character  ):
     4557       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     4558   end.
     4559   function CheckErrForLine returns logical
     4560   (iObj            as handle):
     4561      return CheckErrForLineType(iobj,"*").
     4562   end.
     4563   function CheckErrForUtd returns logical
     4564   (idb-num         as integer ,
     4565    idoc-id         as integer ):
     4566      for each utd-lines where utd-lines.db-num eq idb-num
     4567                           and utd-lines.doc-id eq idoc-id
     4568      no-lock :
     4569         if not CheckErrForLine (buffer ub.utd-lines:handle)
     4570         then
     4571            return no.
     4572      end.
     4573      return yes.
     4574   end.
     4575   function CheckMarkUtd-28rel return logical
     4576    (input idb-num as integer,
     4577    input idoc-id as integer):
     4578    define buffer utd                   for utd.
     4579    define buffer utd-lines             for utd-lines.
     4580    define buffer utd-marking-lines     for utd-marking-lines.
     4581    define variable v-par-type as character no-undo.
     4582    define variable vgdsNoMark as logical no-undo.
     4583    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4584      define variable v-par-val  as character no-undo.
     4585      find first utd where utd.db-num eq idb-num
     4586                       and utd.doc-id eq idoc-id
     4587      no-lock no-error.
     4588      if available utd
     4589      then do:
     4590         if     utd.obj-code ne ?
     4591            and utd.obj-type ne ?
     4592         then do:
     4593            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     4594            Block-utd-lines:
     4595            for each utd-lines where utd-lines.db-num eq idb-num
     4596                                 and utd-lines.doc-id eq idoc-id
     4597            no-lock:
     4598               if     utd-lines.gds-code ne ?
     4599                  and utd-lines.gds-code ne 0
     4600               then do:
     4601                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4602                       ( utd-lines.gds-code,
     4603                         'mark-type':U,
     4604                          output v-par-val,
     4605                          output v-par-type
     4606                       ).
     4607                  if     EDOParSec:IsEdo
     4608                     and EDOParSec:GetIsEDOForType(v-par-val)
     4609                  then do:
     4610                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4611                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4612                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     4613                                                    and length(utd-marking-lines.mark) > 13
     4614                     no-lock no-error.
     4615                     if     avail utd-marking-lines
     4616                        and not CheckErrForLine(buffer utd-lines:handle)
     4617                     then
     4618                        leave Block-utd-lines.
     4619                  end.
     4620                  else
     4621                     vgdsNoMark = yes.
     4622               end.
     4623            end.
     4624            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     4625            if vgdsNoMark then return available utd-lines . else return yes .
     4626         end.
     4627      end.
     4628      return yes.
     4629   end.
     4630   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4631   define temp-table tt-return
     4632     field db-num as integer
     4633     field doc-id as integer
     4634     field mark like marking.mark
     4635   index docid db-num doc-id.
     4636   define temp-table tt-prts
     4637     field rec-id-line as recid
     4638     field rec-id as recid
     4639     field doc-code as character
     4640   index docid doc-code rec-id.
     4641   function  canUtdReturn returns logical
     4642   (input idoc-code as character ):
     4643      define variable Vflag as logical no-undo.
     4644      find first trn-doc where trn-doc.doc-code     eq idoc-code
     4645                           and trn-doc.ext-doc-type eq 'ee':U
     4646      no-lock no-error.
     4647      find first utd where utd.doc-code eq trn-doc.doc-code
     4648                       and utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB no-lock no-error.
     4649      if         available trn-doc
     4650         and not available utd
     4651      then
     4652         Vflag = yes.
     4653      return Vflag.
     4654   end.
     4655   define variable mySeqUtd as int64 no-undo init ?.
     4656   procedure MySeqForUtd:
     4657      define input  parameter iTable       as character no-undo.
     4658      define input  parameter iseqnamehist as character no-undo.
     4659      define input  parameter idb-name     as character no-undo.
     4660      define output parameter Oseq         as int64 no-undo.
     4661      if iTable begins "utd"
     4662      then do:
     4663         if myseqUtd eq ?
     4664         then
     4665            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     4666         Oseq = myseqUtd.
     4667      end.
     4668      else
     4669         Oseq = ?.
     4670      return.
     4671   end.
     4672   function  crUtdReturn returns logical
     4673   (input idoc-code as character ):
     4674      define buffer trn-doc               for ub.trn-doc.
     4675      define buffer doc-line              for ub.doc-line.
     4676      define buffer parts                 for ub.parts.
     4677      define buffer buf_parts             for ub.parts.
     4678      define buffer goods                 for ub.goods.
     4679      define buffer marking-lines         for ub.marking-lines.
     4680      define buffer marking               for ub.marking.
     4681      define buffer utd                   for ub.utd.
     4682      define buffer Buf_utd               for ub.utd.
     4683      define buffer utd-lines             for ub.utd-lines.
     4684      define buffer Buf_utd-lines         for ub.utd-lines.
     4685      define buffer utd-marking-lines     for ub.utd-marking-lines.
     4686      define buffer Buf_utd-marking-lines for ub.utd-marking-lines.
     4687      define variable vi as integer no-undo.
     4688      define variable vFlag as logical no-undo.
     4689      define variable vdb-num as integer no-undo.
     4690      define variable vdoc-id as integer no-undo.
     4691      define variable vvalue  as character no-undo.
     4692      define variable vType   as character no-undo.
     4693      define variable vUTDReturn as logical no-undo.
     4694      for each  tt-prts:
     4695         delete  tt-prts.
     4696      end.
     4697      find first trn-doc where trn-doc.doc-code     eq idoc-code
     4698                           and trn-doc.ext-doc-type eq 'ee':U
     4699      no-lock no-error.
     4700   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
     4701                           input 'edo-return':U ,
     4702                          output vvalue ,
     4703                          output vType ) no-error .
     4704      vUTDReturn = logical(vvalue) no-error.
     4705      if not vUTDReturn
     4706      then
     4707         return no.
     4708      find first utd where utd.doc-code eq trn-doc.doc-code
     4709                       and utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB no-lock no-error.
     4710      if         available trn-doc
     4711         and not available utd
     4712      then do:
     4713         for each doc-line where doc-line.doc-code eq trn-doc.doc-code no-lock,
     4714            each parts where parts.out-code  = doc-line.doc-code
     4715                          and parts.obj-type  = doc-line.obj-type
     4716                          and parts.obj-code  = doc-line.obj-code
     4717                          and parts.artic     = doc-line.artic
     4718                          and parts.prod-type = doc-line.prod-type
     4719                          and parts.prod-code = doc-line.prod-code
     4720         no-lock:
     4721            define variable v-rowid    as rowid no-undo.
     4722            define variable v-tbl-name as character no-undo.
     4723            find first gen-attr where gen-attr.table-name = 'parts':U
     4724                                  and gen-attr.p-key      =  "parts"                + chr(3) +
     4725    parts.obj-type           + chr(3) +
     4726    string(parts.obj-code)   + chr(3) +
     4727    parts.artic              + chr(3) +
     4728    parts.prod-type          + chr(3) +
     4729    string(parts.prod-code)  + chr(3) +
     4730    parts.In-code            + chr(3) +
     4731    parts.Out-code           + chr(3) +
     4732    parts.part-Code          + chr(3) +
     4733    string(parts.prt-code)
     4734                                  and gen-attr.attr-code  = "in-part-key"
     4735            no-lock no-error.
     4736            if available gen-attr
     4737            then do:
     4738               run gen-row-keyr in this-procedure (
     4739                                              input  gen-attr.attr-value
     4740                                              ,input ?
     4741                                              ,input  "ub"
     4742                                              ,input  ?
     4743                                              ,input  no-lock
     4744                                              ,output v-rowid
     4745                                              ,output v-tbl-name ) .
     4746               find first buf_parts where rowid(buf_parts) eq v-rowid no-lock no-error.
     4747            end.
     4748            create tt-prts.
     4749            assign
     4750               tt-prts.rec-id-line = recid(doc-line)
     4751               tt-prts.rec-id   = recid(parts)
     4752               tt-prts.doc-code = if available  buf_parts then buf_parts.in-code  else ""
     4753            .
     4754            release  buf_parts.
     4755         end.
     4756         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4757         do trans:
     4758            block-part:
     4759            for each tt-prts,
     4760               first doc-line where recid(doc-line) eq tt-prts.rec-id-line no-lock,
     4761               first parts where recid(parts) eq tt-prts.rec-id no-lock
     4762            break by  tt-prts.doc-code by tt-prts.rec-id-line:
     4763               find first goods where goods.artic eq parts.artic
     4764                                  and goods.prod-type eq parts.prod-type
     4765                                  and goods.prod-code eq parts.prod-code
     4766               no-lock no-error.
     4767               if not available goods
     4768               then do:
     4769                  message "Не найден товар по поcтавщику " parts.prod-type  parts.prod-code " с аркиклом "  parts.artic
     4770                     view-as alert-box.
     4771                  next block-part.
     4772               end.
     4773               else do:
     4774                  if first-of(tt-prts.doc-code)
     4775                  then do:
     4776                     if    not  available buf_utd
     4777                           or trn-doc.reason-code ne 23
     4778                     then do:
     4779                        if tt-prts.doc-code <> "" then
     4780                        find first utd where utd.doc-code eq tt-prts.doc-code no-lock no-error.
     4781                        if tt-prts.doc-code <> ""
     4782                           and available utd
     4783                        then do:
     4784                           MySeqUtd = ?.
     4785                           vFlag = yes.
     4786                           create buf_utd.
     4787                           buffer-copy utd  except Timestamp
     4788                                                   RevocationStatus
     4789                                                   RecipientResponseStatus
     4790                                                   ReceiptStatus
     4791                                                   ModifyTime
     4792                                                   ModifyDate
     4793                                                   LoadTime
     4794                                                   LoadDate
     4795                                                   EDocType
     4796                                                   DocumentExt
     4797                                                   db-num
     4798                                                   doc-id
     4799                                                   AdditInfo
     4800                                                   doc-code
     4801                                                   sts
     4802                           to buf_utd
     4803                           assign
     4804                              buf_utd.parentDocumentExt     = utd.DocumentExt
     4805                              buf_utd.parentOrganizationExt = utd.OrganizationExt
     4806                              buf_utd.doc-code              = trn-doc.doc-code
     4807                              buf_utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4808                              buf_utd.DocumentDate    = today
     4809                              buf_utd.DocumentNumber  = "Возврат № " + trn-doc.doc-code + (if trn-doc.reason-code ne 23 then " по УПД № " + utd.DocumentNumber + " за " + string(utd.DocumentDate,"99/99/9999") else "")
     4810                              buf_utd.Direction       = "Inbound"
     4811                           .
     4812                           validate buf_utd.
     4813                           define variable mTypeUtd as character no-undo.
     4814                           if   trn-doc.reason-code eq 23
     4815                           then assign
     4816                             buf_utd.PackageId = ""
     4817                             mTypeUtd = "СЧФДОП"
     4818                           .
     4819                           else if trn-doc.reason-code eq 25
     4820                           then
     4821                              mTypeUtd = "ДОП".
     4822                           else
     4823                              mTypeUtd = "".
     4824                           if   mTypeUtd ne ""
     4825                           then
     4826                              setattrutd (buf_utd.db-num,buf_utd.doc-id,"TypeUTD",mTypeUtd).
     4827                           buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:newstatus:KeyIntDB.
     4828                           Buf_utd.sts-edi               = if utd.AmendmentRequested
     4829                                                           then ObjSrv:Env:Utd:Sts:edi:AvailAdjustment:KeyIntDB
     4830                                                           else ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB.
     4831                           assign
     4832                              vdb-num = Buf_utd.db-num
     4833                              vdoc-id = Buf_utd.doc-id
     4834                              vi      = 0
     4835                           .
     4836                        end.
     4837                        else do:
     4838                           MySeqUtd = ?.
     4839                           vFlag = yes.
     4840                           create buf_utd.
     4841                           assign
     4842                              buf_utd.contract-code   = parts.contract-code
     4843                              buf_utd.doc-code        = trn-doc.doc-code
     4844                              buf_utd.DocumentDate    = today
     4845                              buf_utd.DocumentNumber  = "Возврат № " + trn-doc.doc-code + " по накладной " + parts.in-code
     4846                              buf_utd.EDocType        = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4847                              buf_utd.host-code       = parts.host-code
     4848                              buf_utd.obj-type        = parts.obj-type
     4849                              buf_utd.obj-code        = parts.obj-code
     4850                              buf_utd.cli-type        = trn-doc.cli-type
     4851                              buf_utd.cli-code        = trn-doc.cli-code
     4852                           .
     4853                           validate buf_utd.
     4854                           if   trn-doc.reason-code eq 23
     4855                           then assign
     4856                              buf_utd.PackageId = ""
     4857                              mTypeUtd = "СЧФДОП"
     4858                           .
     4859                           else if trn-doc.reason-code eq 25
     4860                           then
     4861                              mTypeUtd = "ДОП".
     4862                           else
     4863                              mTypeUtd = "".
     4864                           if   mTypeUtd ne ""
     4865                           then
     4866                              setattrutd (buf_utd.db-num,buf_utd.doc-id,"TypeUTD",mTypeUtd).
     4867                           buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:newstatus:KeyIntDB.
     4868                           Buf_utd.sts-edi         = ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB.
     4869                           assign
     4870                              vdb-num = Buf_utd.db-num
     4871                              vdoc-id = Buf_utd.doc-id
     4872                              vi      = 0
     4873                           .
     4874                        end.
     4875                     end.
     4876                  end.
     4877                  if first-of(tt-prts.rec-id-line)
     4878                  then do:
     4879                     find first gds-dtl where gds-dtl.doc-code  = doc-line.doc-code
     4880                                          and gds-dtl.artic     = doc-line.artic
     4881                                          and gds-dtl.prod-code = doc-line.prod-code
     4882                                          and gds-dtl.prod-type = doc-line.prod-type
     4883                     no-lock no-error.
     4884                     create buf_utd-lines.
     4885                     assign
     4886                        vi                      = vi + 1
     4887                        buf_utd-lines.Article   = parts.artic
     4888                        buf_utd-lines.db-num    = buf_utd.db-num
     4889                        buf_utd-lines.doc-id    = buf_utd.doc-id
     4890                        buf_utd-lines.LineNum   = vi
     4891                        buf_utd-lines.gds-code     = goods.gds-code
     4892                        buf_utd-lines.ProductCode  = goods.gds-name
     4893                        buf_utd-lines.Quantity     = if available gds-dtl then gds-dtl.fact-qnty  else doc-line.fact-qnty
     4894                        buf_utd-lines.TaxRate      = doc-line.VAT-pc
     4895                        buf_utd-lines.Total        = (if available gds-dtl then gds-dtl.price-rubl else doc-line.price-rubl) * buf_utd-lines.Quantity
     4896                        buf_utd-lines.UnitCode     = goods.unit-base
     4897                        buf_utd-lines.Vat          = buf_utd-lines.Total * buf_utd-lines.TaxRate / (100 + buf_utd-lines.TaxRate)
     4898                        buf_utd-lines.TotalWithVatExcluded = buf_utd-lines.Total  - buf_utd-lines.Vat
     4899                        buf_utd-lines.Price                = buf_utd-lines.TotalWithVatExcluded / buf_utd-lines.Quantity
     4900                     .
     4901                  end.
     4902                  else do:
     4903                     find first buf_utd-lines where buf_utd-lines.db-num    = buf_utd.db-num
     4904                                                and buf_utd-lines.doc-id    = buf_utd.doc-id
     4905                                                and buf_utd-lines.LineNum   = vi
     4906                     no-lock.
     4907                  end.
     4908                  for each marking-lines where marking-lines.gds-code   = goods.gds-code
     4909                                           and marking-lines.obj-type   = parts.obj-type
     4910                                           and marking-lines.obj-code   = parts.obj-code
     4911                                           and marking-lines.in-code    = parts.in-code
     4912                                           and marking-lines.out-code   = parts.out-code
     4913                                           and marking-lines.part-code  = parts.part-code
     4914                                           and marking-lines.doc-level  = 1
     4915                  no-lock:
     4916                     create buf_utd-marking-lines.
     4917                     assign
     4918                        buf_utd-marking-lines.db-num     = buf_utd.db-num
     4919                        buf_utd-marking-lines.doc-id     = buf_utd.doc-id
     4920                        buf_utd-marking-lines.site       = "-"
     4921                        buf_utd-marking-lines.doc-level  = marking-lines.doc-level
     4922                        buf_utd-marking-lines.gds-code   = goods.gds-code
     4923                        buf_utd-marking-lines.LineNum    = buf_utd-lines.LineNum
     4924                        buf_utd-marking-lines.mark       = marking-lines.mark
     4925                        buf_utd-marking-lines.sts        = marking-lines.sts
     4926                     .
     4927                     if buf_utd-marking-lines.doc-level eq 1
     4928                     then
     4929                        AddUtdErr(buf_utd.db-num,buf_utd.doc-id,buffer buf_utd-marking-lines:handle,"return","Mark",marking-lines.mark + chr(4) + buf_utd-lines.ProductCode).
     4930                     release buf_utd-marking-lines.
     4931                  end.
     4932                  if last-of(tt-prts.rec-id-line)
     4933                  then do:
     4934                     release buf_utd-lines.
     4935                  end.
     4936                  if last-of(tt-prts.doc-code)
     4937                  then do:
     4938                     buf_utd.Total = 0.
     4939                     buf_utd.Vat   = 0.
     4940                     for each buf_utd-lines where buf_utd-lines.db-num eq buf_utd.db-num
     4941                                           and buf_utd-lines.doc-id eq buf_utd.doc-id
     4942                     no-lock:
     4943                        buf_utd.Total = buf_utd.Total + buf_utd-lines.Total.
     4944                        buf_utd.Vat   = buf_utd.Vat   + buf_utd-lines.Vat.
     4945                     end.
     4946                     if trn-doc.reason-code ne 23
     4947                     then
     4948                        release buf_utd.
     4949                  end.
     4950               end.
     4951            end.
     4952         end.
     4953         release buf_utd.
     4954         unsubscribe "getNextseq".
     4955         for each buf_utd where buf_utd.doc-code eq trn-doc.doc-code
     4956                            and buf_utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4957         exclusive-lock:
     4958            if    buf_utd.CounteragentId  eq ?
     4959               or buf_utd.CounteragentId  eq ""
     4960               or buf_utd.OrganizationExt eq ?
     4961               or buf_utd.OrganizationExt eq ""
     4962            then
     4963               buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:RequireFilling:KeyIntDB.
     4964            else
     4965               buf_utd.sts             = ObjSrv:Env:Utd:Sts:th:SignatureRequired:KeyIntDB.
     4966         end.
     4967      end.
     4968      for each  tt-prts:
     4969         delete  tt-prts.
     4970      end.
     4971      return vFlag.
     4972   end.
