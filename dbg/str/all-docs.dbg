     8505     run entry-notes in this-procedure.
     8506   end.
     8507   on leave of ed-notes in frame d-all-docs
     8508   do:
     8509     run local-notes.
     8510   end.
     8511   on return, mouse-select-dblclick of ed-notes in frame d-all-docs do:
     8512     apply "entry" to br-docs in frame d-all-docs.
     8513     return no-apply.
     8514   end.
     8515   on return, mouse-select-dblclick of br-docs in frame d-all-docs do:
     8516     apply "choose" to b-lkp in frame d-all-docs.
     8517   end.
     8518   on value-changed of br-docs do:
     8519     run local-value-changed.
     8520   end.
     8521   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile: trn-clos.i $ $Revision: aea5316774be, 0, rls $".
     8522   on choose of b-open in frame d-all-docs
     8523     do:
     8524       define buffer bf_inv-doc-attr for ub.inv-doc-attr .
     8525       define buffer buf_doc-line-attr for doc-line-attr.
     8526       DEFINE buffer curr_inv-doc-attr for ub.inv-doc-attr .
     8527       find current t-doc no-lock no-error. if not available t-doc then do:    return no-apply. end. assign pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = pardoc-rec exclusive.   end. if t-doc.status_      = 'факт':U                     or          t-doc.status_      = 'готов':U                    or          t-doc.status_      = 'отказ':U                 or          t-doc.status_      = 'нередакт':U                or          t-doc.status_      = 'прво':U             or          t-doc.ext-doc-type = 'es':U     or          t-doc.ext-doc-type = 'rs':U then do:    find t-doc where recid (t-doc) = pardoc-rec no-lock.    message "Данный документ закрыт по факту или не может быть обработан в этом списке." view-as alert-box.    return no-apply. end.
     8528       assign
     8529         pardoc-rec = recid (t-doc)
     8530         .
     8531       if t-doc.status_ = 'разрешен':U then
     8532       do:
     8533         find first ub.inv-doc-attr no-lock where (ub.inv-doc-attr.attr-code = "ItogInv" or ub.inv-doc-attr.attr-code = "ItogInvManual")and
     8534           ub.inv-doc-attr.doc-code = t-doc.doc-code no-error .
     8535         if available (ub.inv-doc-attr) then
     8536         do:
     8537           message "Этот документ запрещено открывать!" skip
     8538             "Номер документа" t-doc.doc-code
     8539             view-as alert-box information .
     8540           return .
     8541         end.
     8542         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8543         ub.inv-doc-attr.attr-code = 'invMultDevice' no-error .
     8544         if available (ub.inv-doc-attr) then
     8545         do:
     8546           message "Этот документ запрещено открывать!" skip
     8547             "Номер документа" t-doc.doc-code
     8548             view-as alert-box information .
     8549           return .
     8550         end.
     8551       end.
     8552   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8553   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-open in g#lib-trn4
     8554     (input  parparentproc
     8555     ,input  t-doc.doc-code
     8556     ,output table gds-list
     8557     ) no-error .
     8558       if error-status :error
     8559         then
     8560       do:
     8561         find t-doc no-lock
     8562           where recid( t-doc) = pardoc-rec
     8563           .
     8564         return no-apply.
     8565       end.
     8566       find t-doc no-lock
     8567         where recid( t-doc) = pardoc-rec
     8568         .
     8569       if t-doc.status_ = 'накл':U then
     8570       do:
     8571         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8572           ub.inv-doc-attr.attr-code = 'ItogInvManual' no-error .
     8573         if available(ub.inv-doc-attr) then
     8574         do:
     8575           for each bf_inv-doc-attr exclusive-lock where bf_inv-doc-attr.attr-value = t-doc.doc-code and
     8576             bf_inv-doc-attr.attr-code = 'ManualTSD':
     8577             delete bf_inv-doc-attr .
     8578           end.
     8579         end.
     8580         for each buf_doc-line-attr exclusive-lock where buf_doc-line-attr.doc-code = t-doc.doc-code and
     8581             buf_doc-line-attr.attr-code = 'tsd-qnty':
     8582             delete buf_doc-line-attr .
     8583           end.
     8584       end.
     8585       run UI-on in this-procedure ( input "open" ).
     8586       return no-apply.
     8587     END.
     8588   ON CHOOSE OF b-close IN FRAME d-all-docs
     8589     DO:
     8590       define buffer bf_inv-doc-attr for ub.inv-doc-attr .
     8591       define buffer curr_inv-doc-attr for ub.inv-doc-attr .
     8592       define buffer del_inv-doc-attr for ub.inv-doc-attr .
     8593       define variable p-ok as logical no-undo .
     8594       define variable ii      as integer   no-undo .
     8595       define variable docCode as character no-undo .
     8596       find current t-doc no-lock no-error. if not available t-doc then do:    return no-apply. end. assign pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = pardoc-rec exclusive.   end. if t-doc.status_      = 'факт':U                     or          t-doc.status_      = 'готов':U                    or          t-doc.status_      = 'отказ':U                 or          t-doc.status_      = 'нередакт':U                or          t-doc.status_      = 'прво':U             or          t-doc.ext-doc-type = 'es':U     or          t-doc.ext-doc-type = 'rs':U then do:    find t-doc where recid (t-doc) = pardoc-rec no-lock.    message "Данный документ закрыт по факту или не может быть обработан в этом списке." view-as alert-box.    return no-apply. end.
     8597       assign
     8598         pardoc-rec = recid (t-doc)
     8599         .
     8600       if t-doc.doc-type = 'инв':U and t-doc.status_ = 'разрешен':U then
     8601       do:
     8602         define variable is-pos   as logical   no-undo .
     8603         define variable is-date  as logical   no-undo .
     8604         define variable is-fio   as logical   no-undo .
     8605         define variable is-check as logical   no-undo .
     8606         define variable is-mes   as character no-undo .
     8607         define buffer fio_inv-doc-attr    for ub.inv-doc-attr .
     8608         define buffer pos_inv-doc-attr    for ub.inv-doc-attr .
     8609         define buffer prikaz_inv-doc-attr for ub.inv-doc-attr .
     8610         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8611           ub.inv-doc-attr.attr-code = "invTech" and
     8612           ub.inv-doc-attr.attr-value = string(true) no-error .
     8613         if not available (ub.inv-doc-attr) then
     8614         do:
     8615           if not can-find (first prikaz_inv-doc-attr no-lock where prikaz_inv-doc-attr.doc-code = t-doc.doc-code and
     8616             prikaz_inv-doc-attr.attr-code = 'trdcattr-prikaz-date':U and
     8617             prikaz_inv-doc-attr.attr-value <> "") then
     8618           do:
     8619             is-date = true .
     8620             is-check = true .
     8621           end.
     8622           if not can-find (first fio_inv-doc-attr no-lock where fio_inv-doc-attr.doc-code = t-doc.doc-code and
     8623             (fio_inv-doc-attr.attr-code = 'trdcattr-fio-agent':U or
     8624             fio_inv-doc-attr.attr-code = 'trdcattr-fio-player1':U or
     8625             fio_inv-doc-attr.attr-code = 'trdcattr-fio-player2':U or
     8626             fio_inv-doc-attr.attr-code = 'trdcattr-fio-player3':U) and
     8627             fio_inv-doc-attr.attr-value <> "") then
     8628           do:
     8629             is-fio = true .
     8630             is-check = true .
     8631           end.
     8632           if not can-find (first fio_inv-doc-attr no-lock where fio_inv-doc-attr.doc-code = t-doc.doc-code and
     8633             (fio_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U or
     8634             fio_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U or
     8635             fio_inv-doc-attr.attr-code = 'trdcattr-pos-player2':U or
     8636             fio_inv-doc-attr.attr-code = 'trdcattr-pos-player3':U) and
     8637             fio_inv-doc-attr.attr-value <> "")then
     8638           do:
     8639             is-pos = true .
     8640             is-check = true .
     8641           end.
     8642           if is-check then
     8643           do:
     8644             is-mes = "Ошибка при закрытии документа инвентаризации." .
     8645             if is-date then
     8646             do:
     8647               is-mes = is-mes + chr(10) + "Не указана дата приказа." .
     8648             end.
     8649             if is-fio then
     8650             do:
     8651               is-mes = is-mes + chr(10) + "Не указано ФИО." .
     8652             end.
     8653             if is-pos then
     8654             do:
     8655               is-mes = is-mes + chr(10) + "Не указана должность." .
     8656             end.
     8657           end.
     8658           find first fio_inv-doc-attr no-lock where
     8659             fio_inv-doc-attr.doc-code = t-doc.doc-code and
     8660             fio_inv-doc-attr.attr-code = 'trdcattr-fio-agent':U and
     8661             fio_inv-doc-attr.attr-value <> "" no-error .
     8662           if not available (fio_inv-doc-attr) then
     8663           do:
     8664             find first pos_inv-doc-attr no-lock where
     8665               pos_inv-doc-attr.doc-code = t-doc.doc-code and
     8666               pos_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U and
     8667               pos_inv-doc-attr.attr-value <> "" no-error .
     8668             if available (pos_inv-doc-attr) then
     8669             do:
     8670               if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     8671               is-mes = is-mes + "Не заполнена ФИО председателя комиссии." + chr(10).
     8672             end.
     8673           end.
     8674           else
     8675           do:
     8676             find first pos_inv-doc-attr no-lock where
     8677               pos_inv-doc-attr.doc-code = t-doc.doc-code and
     8678               pos_inv-doc-attr.attr-code = 'trdcattr-pos-agent':U and
     8679               pos_inv-doc-attr.attr-value <> "" no-error .
     8680             if not available (pos_inv-doc-attr) then
     8681             do:
     8682               if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     8683               is-mes = is-mes + "Не заполнена должность председателя комиссии." + chr(10).
     8684             end.
     8685           end.
     8686           find first fio_inv-doc-attr no-lock where
     8687             fio_inv-doc-attr.doc-code = t-doc.doc-code and
     8688             fio_inv-doc-attr.attr-code = 'trdcattr-fio-player1':U and
     8689             fio_inv-doc-attr.attr-value <> "" no-error .
     8690           if not available (fio_inv-doc-attr) then
     8691           do:
     8692             find first pos_inv-doc-attr no-lock where
     8693               pos_inv-doc-attr.doc-code = t-doc.doc-code and
     8694               pos_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U and
     8695               pos_inv-doc-attr.attr-value <> "" no-error .
     8696             if available (pos_inv-doc-attr) then
     8697             do:
     8698               if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     8699               is-mes = is-mes + "Не заполнена ФИО первого участника комиссии." + chr(10).
     8700             end.
     8701           end.
     8702           else
     8703           do:
     8704             find first pos_inv-doc-attr no-lock where
     8705               pos_inv-doc-attr.doc-code = t-doc.doc-code and
     8706               pos_inv-doc-attr.attr-code = 'trdcattr-pos-player1':U and
     8707               pos_inv-doc-attr.attr-value <> "" no-error .
     8708             if not available (pos_inv-doc-attr) then
     8709             do:
     8710               if is-mes = "" then is-mes = "Ошибка при закрытии документа инвентаризации." .
     8711               is-mes = is-mes + "Не заполнена должность первого участника комиссии." + chr(10).
     8712             end.
     8713           end.
     8714           find first fio_inv-doc-attr no-lock where
     8715             fio_inv-doc-attr.doc-code = t-doc.doc-code and
     8716             fio_inv-doc-attr.attr-code = 'trdcattr-fio-player2':U and
     8717             fio_inv-doc-attr.attr-value <> "" no-error .
     8718           if not available (fio_inv-doc-attr) then
     8719           do:
     8720             find first pos_inv-doc-attr no-lock where
     8721               pos_inv-doc-attr.doc-code = t-doc.doc-code and
     8722               pos_inv-doc-attr.attr-code = 'trdcattr-pos-player2':U and
     8723               pos_inv-doc-attr.attr-value <> "" no-error .
     8724             if available (pos_inv-doc-attr) then
     8725             do:
