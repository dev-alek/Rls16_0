     1949   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1950   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1951   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1952   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1953   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
