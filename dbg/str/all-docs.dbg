     2594   function setattrUtdlines returns logical
     2595   (idb-num   as integer,
     2596    idoc-id   as integer,
     2597    ilinenum  as integer,
     2598    iattrcode as character,
     2599    iattrval  as character ):
     2600      define buffer utd-lines-attr for utd-lines-attr.
     2601      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2602                                  and utd-lines-attr.doc-id    eq idoc-id
     2603                                  and utd-lines-attr.lineNum   eq ilineNum
     2604                                  and utd-lines-attr.attr-code eq iattrcode
     2605      no-lock no-error.
     2606      if not available utd-lines-attr
     2607      then do:
     2608         if iattrval ne ?
     2609            and iattrval ne ""
     2610         then do:
     2611            create utd-lines-attr.
     2612            assign
     2613               utd-lines-attr.db-num    = idb-num
     2614               utd-lines-attr.doc-id    = idoc-id
     2615               utd-lines-attr.lineNum   = ilineNum
     2616               utd-lines-attr.attr-code = iattrcode
     2617               utd-lines-attr.attr-value = iattrval
     2618            .
     2619         end.
     2620      end.
     2621      else do:
     2622         if utd-lines-attr.attr-value ne iattrval
     2623         then do:
     2624            find current utd-lines-attr exclusive-lock no-error.
     2625            if available utd-lines-attr
     2626            then do:
     2627               if    iattrval eq ?
     2628                  or iattrval eq ""
     2629               then do:
     2630                  delete utd-lines-attr.
     2631               end.
     2632               else do:
