     7969       ON ROW-DISPLAY OF br-docs IN FRAME d-all-docs
     7970         DO:
     7971           define buffer color_inv-doc-attr for ub.inv-doc-attr .
     7972           if AVAILABLE (t-doc) and t-doc.status_ = 'запрос':U then
     7973           do:
     7974             find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     7975               ub.inv-doc-attr.attr-code = "isManual" and ub.inv-doc-attr.attr-value = string(true) no-error .
     7976             if available (ub.inv-doc-attr) then
     7977             do:
     7978               find first color_inv-doc-attr no-lock where color_inv-doc-attr.doc-code = t-doc.doc-code and
     7979               color_inv-doc-attr.attr-code = "ManualTSD" and ub.inv-doc-attr.attr-value <> "" no-error .
     7980               if available (color_inv-doc-attr) then do:
     7981               do ii = 1 to extent (bcol):
     7982                 if valid-handle (bcol[ii])
     7983                   then
     7984                 do:
     7985                   assign
     7986                     bcol[ii]:fgcolor = BROWN_COLOR.
     7987                 end.
     7988               end.
     7989               end.
     7990               else do:
     7991               do ii = 1 to extent (bcol):
     7992                 if valid-handle (bcol[ii])
     7993                   then
     7994                 do:
     7995                   assign
     7996                     bcol[ii]:fgcolor = BLUE_COLOR.
     7997                 end.
     7998               end.
     7999               end.
     8000             end.
     8001             find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     8002               ub.inv-doc-attr.attr-code = "isManualError" and ub.inv-doc-attr.attr-value = string(true) no-error .
