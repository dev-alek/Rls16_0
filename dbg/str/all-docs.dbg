     6111   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6112   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     6113   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     6114   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
     6115   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
     6116   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
     6117   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     6118   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     6119   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     6120   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     6121   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
     6122   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
     6123   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
     6124   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
     6125   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
     6126   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
     6127   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
     6128   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
     6129   define variable v-sale             as   logical               no-undo.
     6130   define variable bcol                                as   handle                        extent no-undo.
     6131   define variable hBrowse                             as   handle                        no-undo.
     6132   define variable ii                                  as   integer                       no-undo.
     6133     define buffer bf_trn-doc        for ub.trn-doc .
     6134     define buffer buf_doc-line      for ub.doc-line .
     6135   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6136   function total-fact return decimal  ~
     6137   ( input p-rec as recid  ) . ~
     6138   def buffer t-d for ub.trn-doc . ~
     6139   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return ? . ~
     6140   return (if t-d.print-rubl then t-d.tot-sale else t-d.tot-fact). ~
     6141   end function. ~
     6142   function first-symb-type return char  ~
     6143   ( input p-rec as recid  ) . ~
     6144   def buffer t-d for ub.trn-doc . ~
     6145   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     6146   return (substring (t-d.doc-type, 1, 1)).                    ~
     6147   end function. ~
     6148   function day-month return char ~
     6149   ( input p-rec as recid  ) . ~
     6150   def buffer t-d for ub.trn-doc . ~
     6151   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     6152   return (substring ((string (t-d.doc-date)), 1, 5)).        ~
     6153   end function.  ~
     6154   function shift-day-month return char ~
     6155   ( input p-rec as recid  ) . ~
     6156   def buffer t-d for ub.trn-doc . ~
     6157   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     6158   return (substring ((string (t-d.shift-date)), 1, 5)).      ~
     6159   end function.  ~
     6160   function object-label return char  ~
     6161   ( input p-rec as recid  ) . ~
     6162   def buffer t-d for ub.trn-doc . ~
     6163   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     6164   return (trim (t-d.obj-type)  + string (t-d.obj-code)). ~
     6165   end function.  ~
     6166   function fcli-name return character   ~
     6167   ( input p-rec as recid  ) . ~
     6168   def buffer t-d for ub.trn-doc . ~
     6169   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     6170   return t-d.cli-name .  ~
     6171   end function.
     6172   function total-pay-fact return character
     6173   ( input p-rec as recid  ) .
     6174   def buffer loc-t-doc for ub.trn-doc .
     6175   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return chr(1) .
     6176   if loc-t-doc.doc-type = 'инв':U then return "" .
     6177   if (loc-t-doc.ext-doc-type = 'es':U or loc-t-doc.ext-doc-type = 'rs':U) and v-sale <> yes then return "?" .
     6178   if loc-t-doc.doc-type = 'при':U and
     6179      loc-t-doc.internal = no        then do:
     6180     return string ( loc-t-doc.tot-calc , "->,>>>,>>>,>>>,>>9.99" ).
     6181   end.
     6182   else do:
     6183     return string( ( if loc-t-doc.print-rubl then (loc-t-doc.tot-sale - loc-t-doc.discnt-rubl) else (loc-t-doc.tot-fact - loc-t-doc.tot-calc) ) , "->,>>>,>>>,>>>,>>9.99" ).
     6184   end.
     6185   end function.
     6186   function total-acc return decimal
     6187   ( input p-rec as recid  ) .
     6188   def buffer loc-t-doc for ub.trn-doc .
     6189   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ? .
     6190     if (loc-t-doc.ext-doc-type = 'es':U or loc-t-doc.ext-doc-type = 'rs':U) and v-sale <> yes then return ?.
     6191     return (if loc-t-doc.print-rubl then loc-t-doc.fact-rubl else loc-t-doc.fact-base).
     6192   end function.
     6193   function shift-name return character
     6194   ( input p-rec as recid  ) .
     6195   def buffer loc-t-doc for ub.trn-doc .
     6196   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ? .
     6197     if loc-t-doc.shift-date = ? then do:
     6198       return "":u.
     6199     end.
     6200     else do:
     6201       if loc-t-doc.shift-num = integer(loc-t-doc.shift-name) then do:
     6202         return loc-t-doc.shift-name.
     6203       end.
     6204       else do:
     6205         return loc-t-doc.shift-name + "(" + string(loc-t-doc.shift-num) + ")".
     6206       end.
     6207     end.
     6208   end function.
     6209   function closed-backdated return character
     6210   ( input p-rec as recid ) .
     6211   def buffer loc-t-doc for ub.trn-doc .
     6212   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ?.
     6213     return ( if loc-t-doc.is-back-date then "+" else "" ).
     6214   end function.
     6215   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
