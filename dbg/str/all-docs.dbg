    10558   procedure OpenBr :
    10559   define input parameter p-open-query     as logical   no-undo .
    10560   define input parameter p-find-next      as logical   no-undo .
    10561   define input parameter p-find-condition as character no-undo .
    10562   define input parameter fnc              as character no-undo.
    10563   case sort-column-name :
    10564   when "" then do:
    10565   assign
    10566     sort-column-phrase = ""
    10567   .
    10568   end.
    10569   otherwise do:
    10570   assign
    10571     sort-column-phrase = "by " + sort-column-name
    10572   .
    10573   end.
    10574   end case.
    10575   assign
    10576     parschdoc-code  = (if available sch-inv  then sch-inv.doc-code   else ?)
    10577     parschcurr-code = (if available sch-curr then sch-curr.curr-code else ?)
    10578     parschobj-code  = (if available sch-pay  then sch-pay.obj-code   else ?)
    10579     parschcli-type  = (if available sch-cli  then sch-cli.obj-type   else ?)
    10580     parschcli-code  = (if available sch-cli  then sch-cli.obj-code   else ?)
    10581   .
    10582   define variable l-open-query as logical   no-undo .
    10583   if v-is-lgas then do:
    10584     run modes-lgas (
    10585       p-open-query     ,
    10586       p-find-next      ,
    10587       p-find-condition ,
    10588       fnc              ).
    10589   end.
    10590     else do:
    10591     if can-do ('работа':U + "," + 'фирма':U + "," + 'объект':U + "," + 'выбор':U, parlist-mode) then do:
    10592       run modes-1-a (
    10593         p-open-query     ,
    10594         p-find-next      ,
    10595         p-find-condition ,
    10596         fnc              ).
    10597     end.
    10598     else do:
    10599       if can-do ('ТИП':U + "," + 'статус':U + "," + 'status-all' +  "," + 'status-all-hold' + "," + 'ФЛАГ':U + "," + 'ВНУ':U + "," + 'отгрузка':U + "," + "invert":u, parlist-mode) then do:
    10600         run modes-1-b (
    10601           p-open-query     ,
    10602           p-find-next      ,
    10603           p-find-condition ,
    10604           fnc              ).
    10605       end.
    10606       else do:
    10607         if can-do( 'счет-фактура':U + "-host," + 'счет-фактура':U + "-obj"  + ",no-def,yes-gen-incfo,yes-gen-expfo,yes-gen-fo,yes-gen-buyer" , parlist-mode ) then do:
    10608           run modes-2 (
    10609             p-open-query     ,
    10610             p-find-next      ,
    10611             p-find-condition ,
    10612             fnc              ).
    10613         end.
    10614         else do:
    10615           if parlist-mode = "client-income":u then do:
    10616             if fnc = "open" then do:
    10617               assign
    10618                 frame d-all-docs:title = "Приходы от контрагента : " + sch-cli.obj-name
    10619                 objects = 1
    10620               .
    10621               assign filter-point = parlist-mode + chr(4) + parlist-mode + chr(4) + "yes".
    10622   define variable vss-include-info124 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10623   define variable  l-disable-where-125  as logical   no-undo .
    10624   define variable  l-filter-open-125    as logical   .
    10625   define variable  flt-rec-125       as recid     no-undo .
    10626   define variable  filter-name-125      as character no-undo .
    10627   define variable  where-phrase-125     as character no-undo .
    10628   define variable  sort-phrase-125      as character no-undo .
    10629   define variable  where-phrase-rus-125 as character no-undo .
    10630   define variable  sort-phrase-rus-125  as character no-undo .
    10631   run gbl/flt-get.p
    10632     (input filter-point
    10633     ,output flt-rec-125
    10634     ,output filter-name-125
    10635     ,output where-phrase-125
    10636     ,output sort-phrase-125
    10637     ,output where-phrase-rus-125
    10638     ,output sort-phrase-rus-125
    10639     ).
    10640   if p-open-query then do:
    10641       run set-filter-name in this-procedure
    10642         (INPUT filter-name-125
    10643         ) no-error .
    10644     assign
    10645       l-filter-open-125 = false
    10646     .
    10647     if flt-rec-125 <> ?
    10648       or sort-column-phrase > ""
    10649     then do:
    10650       define variable  parameter-2-125 as character no-undo .
    10651       define variable  parameter-3-125 as character no-undo .
    10652       define variable  parameter-4-125 as character no-undo .
    10653       define variable  parameter-5-125 as character no-undo .
    10654       define variable  parameter-6-125 as character no-undo .
    10655       define variable  parameter-7-125 as character no-undo .
    10656         assign
    10657         parameter-3-125 =
    10658                                 "FOR EACH t-doc"
    10659         parameter-4-125 =
    10660           (
    10661             if ("t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type                              " + " " + where-phrase-125) <> ""
    10662             then  substitute ( '                                t-doc.cli-type  = &1&2&1                             and t-doc.cli-code  = &3                            and t-doc.host-code = &4                             and t-doc.ext-doc-type = &1&5&1                            ', chr(34), parschcli-type , parschcli-code, par-host-code , parext-doc-type  ) + " " + where-phrase-125
    10663             else "true"
    10664           )
    10665         parameter-5-125 = (" " + " use-index cli-date " + " " + substitute(' , first temp-trn-doc where (&1 = 1 or t-doc.doc-code = temp-trn-doc.doc-code ) ' , r-2 ))
    10666         parameter-6-125 = if sort-phrase-125 = ''
    10667                              then
    10668           (
    10669           " " + "" +
    10670             " " + sort-column-phrase +
    10671           " " + ""
    10672           )
    10673                              else
    10674           (
    10675           " " + "" +
    10676             " " + sort-column-phrase +
    10677           " " + sort-phrase-125
    10678           )
    10679         parameter-7-125 =
    10680           "   "
    10681       .
    10682       do
    10683       on stop undo, leave
    10684       on error undo, leave
    10685       :
    10686         assign
    10687           l-disable-where-125 =
    10688             ("t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type                              " + " " + where-phrase-125 = "")
    10689         .
    10690         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    10691                             ,input query br-docs:handle
    10692                             ,input parameter-3-125
    10693                             ,input parameter-4-125
    10694                             ,input parameter-5-125
    10695                             ,input parameter-6-125
    10696                             ,input parameter-7-125
    10697                             )
    10698         .
    10699         assign
    10700           l-filter-open-125 = true
    10701         .
    10702       end.
    10703       if l-filter-open-125 = false then do:
    10704         message
