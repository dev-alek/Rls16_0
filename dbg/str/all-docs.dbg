    21979   procedure proc-m_gen-18 :
    21980   define buffer bf_trn-doc for ub.trn-doc.
    21981   define variable vari as integer no-undo.
    21982   define variable vardoc-code as integer no-undo.
    21983   define variable varneed-factur as logical no-undo.
    21984   define buffer bf_contract for ub.contract.
    21985   do
    21986   on error undo, return error return-value
    21987   :
    21988     if mark-list = "" then do:
    21989       if available t-doc then assign mark-list = string(recid(t-doc)).
    21990     end.
    21991   vari-cycle:
    21992     do vari = 1 to num-entries (mark-list):
    21993       assign vardoc-code = integer(entry (vari, mark-list)) .
    21994       find first bf_trn-doc where recid(bf_trn-doc) = vardoc-code exclusive-lock.
    21995       if bf_trn-doc.status_ <> 'факт':U then do:
    21996         message "Документ " bf_trn-doc.status_ " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
    21997         next vari-cycle.
    21998       end.
    21999       if bf_trn-doc.cr-db-num <> v-cntxt-db-num then do:
    22000         message "БД документа с кодом " bf_trn-doc.doc-code " не coвпадает с текущей БД." skip
    22001                 "Текущая БД: " v-cntxt-db-num skip "БД док-та: " bf_trn-doc.cr-db-num  " . Пропускаем."
    22002         view-as alert-box error.
    22003         next vari-cycle.
    22004       end.
    22005       if bf_trn-doc.need-factur = 2 then do:
    22006         if bf_trn-doc.contract-code <> 0 then do:
    22007           find first bf_contract where bf_contract.host-code     = bf_trn-doc.host-code   and
    22008                                        bf_contract.contract-code = bf_trn-doc.contract-code no-lock no-error.
    22009           if available bf_contract then do:
    22010             if bf_trn-doc.ext-doc-type = 'ie':U and
    22011               ( bf_contract.gen-factur = 1 or bf_contract.gen-factur = 11 or bf_contract.gen-factur = 101 or bf_contract.gen-factur = 111 )
    22012              or bf_trn-doc.ext-doc-type = 'pc':U and
    22013               ( bf_contract.gen-factur = 4 or bf_contract.gen-factur = 14 or bf_contract.gen-factur = 104 or bf_contract.gen-factur = 114 )
    22014               then do:
    22015               assign bf_trn-doc.need-factur = 1  .
    22016               reposition br-docs to recid recid(bf_trn-doc) no-error.
    22017               if not error-status:error then display factur (recid(bf_trn-doc)) @ varfactur with browse br-docs.
    22018             end.
    22019             else message "По документу " bf_trn-doc.doc-code " нет договоров для генерации счета-фактуры."  view-as alert-box.
    22020           end.
    22021         end.
    22022       end.
    22023       else do:
    22024         message "Документ " bf_trn-doc.doc-code "не имеет признака 'не опред' генерация счета-фактуры."
    22025         view-as alert-box.
    22026         next vari-cycle.
    22027       end.
    22028     end.
    22029     assign mark-list = "" .
    22030   end.
    22031   end procedure.
    22032   procedure local-export :
    22033     define variable varxmldocfl      as character no-undo.
    22034     define variable varxmldocfl-type as character no-undo.
    22035   define variable v-file-name as character no-undo .
    22036     if not available t-doc then do:
    22037       message "Неправильный выбор документа." view-as alert-box error.
    22038       return no-apply.
    22039     end.
    22040     run str/xml-doc.p ( input t-doc.doc-code, input ? ) no-error.
    22041     if error-status :error
    22042     then do:
    22043       if error-status :get-message( 1 ) <> ""
    22044       then do:
    22045         message
    22046           vss-workfile vss-revision vss-description skip
    22047           "Ошибка при вызове программы xml-doc.p" skip
    22048           error-status :get-message( 1 ) skip
    22049           return-value
    22050         view-as alert-box error .
    22051       end.
    22052       else do:
    22053         message
    22054           return-value
    22055         view-as alert-box information .
    22056       end.
    22057       return no-apply .
    22058     end.
    22059   assign
    22060   v-file-name =  str-encode ( replace(t-doc.doc-code , "*", "$")
    22061                             , ""
    22062                             , '\/:*?"<>|':U
    22063                             ) + ".xml".
    22064     if search( "xml-doc.bat" ) <> ? then do:
    22065       define variable v-sys-key   as character         no-undo.
    22066   define variable vss-include-info250 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
    22067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
    22068     (output v-sys-key
    22069     ) no-error .
    22070       os-command silent value(search ("xml-doc.bat") + chr(32) + chr(34) +  v-file-name + chr(34) + chr(32)  + v-sys-key + chr(32) + v-cntxt-userid ).
    22071     end.
    22072     else do:
    22073       if search( v-file-name ) <> ? then do:
    22074       message
    22075       substitute("Документ выгружен в файл &1"
    22076                   ,v-file-name
    22077                 )
    22078       view-as alert-box.
    22079       end.
    22080     end.
    22081   end procedure.
    22082   procedure entry-notes :
    22083   if not available t-doc then do:
    22084     message "Неправильный выбор документа.".
    22085     return no-apply.
    22086   end.
    22087   pardoc-rec = recid (t-doc).
    22088   if t-doc.status_ <> 'факт':U and t-doc.discnt-type <> 'касс':U and substring (t-doc.PS, 1, 1) = "@" then
    22089     message "Чтобы программа не могла заново переписать Ваше примечание, удалите знак @.".
    22090   end.
    22091   procedure local-notes:
    22092   define variable v-updated as logical no-undo .
    22093   do on stop undo, return no-apply:
    22094     find t-d-b where recid (t-d-b) = pardoc-rec exclusive no-error no-wait.
    22095     if not available t-d-b then do:
    22096        message "Запись захвачена другим пользователем." skip
    22097                "Редактирование запрещено."
    22098        view-as alert-box.
    22099     end.
    22100     else do:
    22101       if t-d-b.status_ <> 'факт':U
    22102       and ((t-d-b.discnt-type = 'касс':U
    22103            or LOOKUP(t-d-b.ext-doc-type, 'we,we,we,we,ee':U) > 0)
    22104            and
    22105            t-d-b.PS begins chr(4))  then do:
    22106         message
    22107         "Примечание к данному документу в данном статусе не может быть отредактировано пользователем."
    22108         view-as alert-box.
    22109       end.
    22110       else
    22111       assign
    22112       t-d-b.PS = input frame d-all-docs ed-notes
    22113       v-updated = yes
    22114       .
    22115     end.
    22116     if not v-updated then do:
    22117       ed-notes:edit-undo().
    22118     end.
    22119   end.
    22120   end procedure.
    22121   procedure local-value-changed :
    22122   if available t-doc then do:
    22123     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.boss no-lock no-error.
    22124     if available cli-buf then boss-name = cli-buf.obj-name. else boss-name = ?.
    22125     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.agnt no-lock no-error.
    22126     if available cli-buf then agnt-name = cli-buf.obj-name. else agnt-name = ?.
    22127     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.wrkr no-lock no-error.
    22128     if available cli-buf then wrkr-name = cli-buf.obj-name. else wrkr-name = ?.
    22129   define variable vss-include-info251 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    22130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
    22131     (input  t-doc.creid
    22132     ,output v-user-name
    22133     )  .
    22134     find ub.pay-type where ub.pay-type.obj-code = t-doc.pay-code no-lock no-error.
    22135     if available ub.pay-type then disp ub.pay-type.obj-name with frame d-all-docs.
    22136     else disp ? @ ub.pay-type.obj-name with frame d-all-docs.
    22137     ed-notes = t-doc.PS.
    22138     find cli-buf where cli-buf.obj-type = t-doc.obj-type and cli-buf.obj-code = t-doc.obj-code no-lock no-error.
    22139     if available cli-buf then obj-name = cli-buf.obj-name. else obj-name = ?.
    22140     disp ed-notes obj-name boss-name agnt-name wrkr-name  v-user-name with frame d-all-docs.
    22141     if pardoc-rec <> recid (t-doc) then do:
    22142       sch-num = 0.
    22143       hide sch-num in frame d-all-docs.
    22144     end.
    22145    define buffer buf_blob-bind for ub.blob-bind  .
    22146    define variable v-blob-uniq-key-rec as character no-undo .
    22147     run gen-key-rec in this-procedure (
    22148          input  'trn-doc':U
    22149         ,input  buffer t-doc:handle
    22150         ,output v-blob-uniq-key-rec ).
    22151    if can-find (first buf_blob-bind no-lock where
    22152                   buf_blob-bind.uniq-key-rec = v-blob-uniq-key-rec and
    22153                   buf_blob-bind.field-name_  = 'trn-doc-image':U ) then
    22154       display r-scaner with frame d-all-docs .
    22155       else hide r-scaner in frame d-all-docs .
    22156   end.
    22157   else
    22158      hide r-scaner in frame d-all-docs .
    22159   end procedure.
    22160   procedure local-sel :
    22161   if not available t-doc then do:
    22162     message "Неправильный выбор документа.".
    22163     return error.
    22164   end.
    22165   if mark-list <> "" then do:
    22166     assign pardoc-rec = recid (t-doc).
    22167   end.
    22168   else do:
    22169     mark-list = string(recid(t-doc)).
    22170     assign pardoc-rec = recid (t-doc).
    22171   end.
    22172   apply "go" to frame d-all-docs.
    22173   end procedure.
    22174   procedure local-start-main :
    22175   find sch-pay where recid (sch-pay) = pardoc-rec no-lock no-error.
    22176   find sch-curr where recid (sch-curr) = pardoc-rec no-lock no-error.
    22177   find sch-cli where recid (sch-cli) = pardoc-rec no-lock no-error.
    22178   if parlist-mode = 'Контрагент':U and available sch-cli and (sch-cli.obj-type = 'скл':U or sch-cli.obj-type = 'маг':U) then do:
    22179     if sch-cli.obj-type = 'скл':U then do:
    22180       find ub.store where ub.store.obj-code = sch-cli.obj-code no-lock.
    22181       if ub.store.host-code <> par-host-code then do:
    22182         message "Список документов, в которых данный склад является контрагентом, смотрите из той фирмы, к которой он относится.".
    22183         return error.
    22184       end.
    22185     end.
    22186     else do:
    22187       find ub.shop where ub.shop.obj-code = sch-cli.obj-code no-lock.
    22188       if ub.shop.host-code <> par-host-code then do:
    22189         message "Список документов, в которых данный магазин является контрагентом, смотрите из той фирмы, к которой он относится.".
    22190         return error.
    22191       end.
    22192     end.
    22193   end.
    22194   find sch-inv where recid (sch-inv) = pardoc-rec no-lock no-error.
    22195   if can-do ('МЕШАЮТ':U + ",МЕНЕДЖЕР,ИСПОЛНИТЕЛЬ,КЛАДОВЩИК," + 'Контрагент':U + ",ВАЛЮТА,ОПЛАТА",
    22196                  parlist-mode) then
    22197     pardoc-rec = ?.
    22198   end procedure.
    22199   procedure local-conf-rd:
    22200   define buffer bf_clients for ub.clients.
    22201   define buffer bf_shop    for ub.shop.
    22202   define buffer bf_store   for ub.store.
