     2581                                  and utd-lines-attr.doc-id    eq idoc-id
     2582                                  and utd-lines-attr.lineNum   eq ilineNum
     2583                                  and utd-lines-attr.attr-code eq iattrcode
     2584      no-lock no-error.
     2585      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2586   end.
