    20270       ,input  t-doc.obj-type
    20271       ,input  t-doc.obj-code
    20272       ,input  0
    20273       ,input  0
    20274       ,input  0
    20275       ,input  true
    20276       ,output varlog
    20277       )  .
    20278   end.
    20279       end.
    20280       when 'инв':U
    20281       then do:
    20282   define variable vss-include-info231 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20283   do:
    20284     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    20285       (input  v-cntxt-db-num
    20286       ,input  v-cntxt-userid
    20287       ,input  0
    20288       ,input  'actn_inventory_chgfact':U
    20289       ,input  'object':U
    20290       ,input  t-doc.host-code
    20291       ,input  t-doc.obj-type
    20292       ,input  t-doc.obj-code
    20293       ,input  0
    20294       ,input  0
    20295       ,input  0
    20296       ,input  true
    20297       ,output varlog
    20298       )  .
    20299   end.
    20300       end.
    20301       otherwise do:
    20302         message
    20303           vss-workfile vss-revision vss-description skip
    20304           "Неизвестный тип документа" skip
    20305           "Тип документа" partype skip
    20306           view-as alert-box error .
    20307         undo, return error return-value .
    20308       end.
    20309     end case.
    20310   end.
    20311   if not varlog then return .
    20312   assign
    20313     vardoc-mode = 'ИЗМЕНЕНИЕ':U
    20314     .
    20315   case t-doc.doc-type :
    20316     when 'при':U then do:
    20317       if t-doc.internal = yes then do:
    20318         run str/out-doc.w
    20319             ( input        parparentproc
    20320             , input-output pardoc-rec
    20321             , input        vardoc-mode
    20322             , input        ?
    20323             , input        'при':U
    20324             , input        yes
    20325             , input-output varnext-prev
    20326             , input        parext-doc-type
    20327             , input        paris-hold
    20328             , input-output varline-rec
    20329             , input        br-handle
    20330             , input        bf-handle
    20331             , input        t-doc.status_   ).
    20332       end.
    20333       else do:
    20334         run str/in-doc.w
    20335           ( input        parparentproc
    20336           , input-output pardoc-rec
    20337           , input        vardoc-mode
    20338           , input        'при':U
    20339           , input        no
    20340           , input-output varnext-prev
    20341           , input        t-doc.ext-doc-type
    20342           , input        paris-hold
    20343           , input-output varline-rec
    20344           , input        br-handle
    20345           , input        bf-handle
    20346           , input        t-doc.status_).
    20347       end.
    20348     end.
    20349     when 'рас':U   or
    20350     when 'возврат':U    or
    20351     when 'спи':U then do:
    20352       if t-doc.status_ = 'запрос':U then do:
    20353         run gbl/calc-trn.p (input parparentproc, input recid(t-doc)).
    20354       end.
    20355       if t-doc.is-flora = true then do:
    20356          message "Заказ на исполнение. Корректируется в соответствующем режиме." view-as alert-box information .
    20357          return .
    20358       end .
    20359       else do:
    20360         run str/out-doc.w (input parparentproc,
    20361                  input-output pardoc-rec,
    20362                  input vardoc-mode,
    20363                  input ?,
    20364                  input t-doc.doc-type,
    20365                  input yes,
    20366                  input-output varnext-prev,
    20367                  input t-doc.ext-doc-type,
    20368                  input paris-hold,
    20369                  input-output varline-rec,
    20370                  input br-handle,
    20371                  input bf-handle,
    20372                  input t-doc.status_).
    20373       end.
    20374     end.
    20375     when 'инв':U then do:
    20376         case t-doc.ext-doc-type :
    20377             when 'vt':U then do:
    20378                 if t-doc.status_ = 'разрешен':U then run proc-check-inv .
    20379                 run str/inv-doc.w
    20380                   (input parparentproc,
    20381                    input-output pardoc-rec,
    20382                    input vardoc-mode,
    20383                    input 'инв':U,
    20384                    input no,
    20385                    input-output varnext-prev,
    20386                    input parext-doc-type,
    20387                    input paris-hold,
    20388                    input-output varline-rec,
    20389                    input br-handle,
    20390                    input bf-handle
    20391                    ) no-error.
    20392             end.
    20393             when 'vp':U then do:
    20394   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    20395                           input 'olsuppcntr':U ,
    20396                          output varvalue-oldsuppcntr ,
    20397                          output vartype-oldsuppcntr ) no-error .
    20398                 run str/peresort.w
    20399                         (input       parparentproc,
    20400                         input-output pardoc-rec,
    20401                         input        'ИЗМЕНЕНИЕ':U,
    20402                         input        'vp':U,
    20403                         input-output varnext-prev,
    20404                         input-output varline-rec,
    20405                         input        br-handle,
    20406                         input        bf-handle,
    20407                         input        t-doc.obj-type,
    20408                         input        t-doc.obj-code,
    20409                         input        t-doc.cli-type,
    20410                         input        t-doc.cli-code,
    20411                         input        (if varvalue-oldsuppcntr = "yes":u then yes else no),
    20412                         input        t-doc.contract-code
    20413                         ) no-error.
    20414               end.
    20415               otherwise do:
    20416                     run str/corparts.w
    20417                       ( input        parparentproc,
    20418                         input-output pardoc-rec,
    20419                         input        vardoc-mode,
    20420                         input        parext-doc-type,
    20421                         input        paris-hold,
    20422                         input-output varnext-prev,
    20423                         input-output varline-rec,
    20424                         input        br-handle ,
    20425                         input        bf-handle
    20426                         ) no-error  .
    20427                         if error-status :error then message
    20428                           vss-workfile vss-revision vss-description skip
    20429                           error-status :get-message(1) skip
    20430                           return-value skip
    20431                           ""
    20432                           view-as alert-box error
    20433                         .
    20434               end.
    20435         end.
    20436     end.
    20437   end.
    20438   if available t-doc then do:
    20439     if t-doc.creid <> v-cntxt-userid or true then do:
    20440       run str/trn-hist.p
    20441         (buffer t-doc ,
    20442         input  par-obj-type ,
    20443         input  par-obj-code ,
    20444         input  "Изменение документа"
    20445         ) no-error .
    20446       if error-status :error
    20447       then do:
    20448         message
    20449           error-status :get-message(1) skip
    20450           return-value skip
    20451           "Внимание"
    20452           view-as alert-box error .
    20453       end.
    20454     end.
    20455   end.
    20456   apply "entry" to br-docs in frame d-all-docs.
    20457   if error-status:error then do:
    20458     find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20459     return error.
    20460   end.
    20461   run UI-on ("open").
    20462    end.
    20463   end procedure.
    20464   procedure proc-b-unrv :
    20465    do
    20466    on error undo, return error return-value
    20467    :
    20468   define variable rid-list as character no-undo.
    20469   define buffer bf_doc-line for ub.doc-line.
    20470   define buffer bf_gds-dtl  for ub.gds-dtl.
    20471   define variable varchg-inv  as logical   no-undo.
    20472   define variable v-is-ptrl   as character no-undo.
    20473   define variable v-data-type as character no-undo.
    20474   define variable is-petrol   as logical   no-undo.
    20475   define variable is-pieces   as logical   no-undo.
    20476   find current t-doc no-lock no-error. if not available t-doc then do:    return no-apply. end. assign pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = pardoc-rec exclusive.   end. if t-doc.status_      = 'факт':U                     or          t-doc.status_      = 'готов':U                    or          t-doc.status_      = 'отказ':U                 or          t-doc.status_      = 'нередакт':U                or          t-doc.status_      = 'прво':U             or          t-doc.ext-doc-type = 'es':U     or          t-doc.ext-doc-type = 'rs':U then do:    find t-doc where recid (t-doc) = pardoc-rec no-lock.    message "Данный документ закрыт по факту или не может быть обработан в этом списке." view-as alert-box.    return no-apply. end.
    20477   define variable vss-include-info232 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20478   do:
    20479     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    20480       (input  v-cntxt-db-num
    20481       ,input  v-cntxt-userid
    20482       ,input  0
    20483       ,input  'actn_doc-reserv':U
    20484       ,input  'object':U
    20485       ,input  par-host-code
    20486       ,input  par-obj-type
    20487       ,input  par-obj-code
    20488       ,input  0
    20489       ,input  0
    20490       ,input  0
    20491       ,input  true
    20492       ,output varlog
    20493       )  .
    20494   end.
    20495   if not varlog then return .
    20496   if t-doc.doc-type = 'при':U and
    20497      t-doc.internal             and
    20498      t-doc.status_ = 'запрос':U and
    20499      not t-doc.flag_            then do:
    20500      varlog = no.
    20501      message "Документ №" t-doc.doc-code skip "Смена объекта и закрытие запроса ?   Вы уверены ?"
    20502      view-as alert-box question buttons OK-Cancel update varlog.
    20503      if varlog <> yes then do:   find t-doc no-lock where recid( t-doc ) = pardoc-rec.   return no-apply. end.
    20504      run ref/cli-all.w (parparentproc
    20505                    ,  "b-sel"
    20506                    , 'скл':U
    20507                    , ?
    20508                    , ?
    20509                    , ?
    20510                    , ?
    20511                    , ?
    20512                   , output rid-list) .
    20513      find t-doc where recid (t-doc) = pardoc-rec.
    20514      if rid-list = "" then do:
    20515        find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20516        message "Новый объект не выбран.".
    20517        return error.
    20518      end.
    20519      find ub.clients where recid (ub.clients) = integer (rid-list) no-lock.
    20520      if ub.clients.obj-type <> 'скл':U and ub.clients.obj-type <> 'маг':U then do:
    20521        find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20522        message "Нужно выбрать склад или магазин.".
    20523        return error.
    20524      end.
    20525      if ub.clients.obj-type = par-obj-type and ub.clients.obj-code = par-obj-code then do:
    20526        find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20527        message "Выбран текущий объект.".
    20528        return error.
    20529      end.
    20530      tr:
    20531      do transaction on error undo tr, return error return-value :
    20532        assign
    20533          t-doc.flag_ = yes
    20534          t-doc.cli-code = par-obj-code
    20535          t-doc.cli-type = par-obj-type
    20536          t-doc.obj-code = ub.clients.obj-code
    20537          t-doc.obj-type = ub.clients.obj-type.
    20538        for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code
    20539                             on error undo tr, return error
    20540                             on stop  undo tr, return error :
    20541            assign bf_doc-line.obj-type = t-doc.obj-type
    20542                   bf_doc-line.obj-code = t-doc.obj-code.
    20543        end.
    20544        for each bf_gds-dtl where bf_gds-dtl.doc-code = t-doc.doc-code
    20545                             on error undo tr, return error
    20546                             on stop  undo tr, return error :
    20547            assign bf_gds-dtl.obj-type = t-doc.obj-type
    20548                   bf_gds-dtl.obj-code = t-doc.obj-code.
    20549        end.
    20550      end.
    20551   end.
    20552   else do:
    20553     if t-doc.doc-type = 'инв':U
    20554     then do:
    20555       if t-doc.fact-date <> ? and  t-doc.fact-date < today then do:
    20556         message "Для документа , закрываемого задним числом эта функция недоступна " view-as alert-box .
    20557         return.
    20558       end.
    20559       if t-doc.ext-doc-type = 'vt':U
    20560       then do:
    20561   define variable vss-include-info233 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20562   do:
    20563     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    20564       (input  v-cntxt-db-num
    20565       ,input  v-cntxt-userid
    20566       ,input  0
    20567       ,input  'actn_inventory_permission':U
    20568       ,input  'object':U
    20569       ,input  t-doc.host-code
    20570       ,input  t-doc.obj-type
    20571       ,input  t-doc.obj-code
    20572       ,input  0
    20573       ,input  0
    20574       ,input  0
    20575       ,input  true
    20576       ,output varlog
    20577       )  .
    20578   end.
    20579         if not varlog
    20580         then do:
    20581           return error .
    20582         end.
    20583         assign
    20584           varlog = no
    20585         .
    20586         if  t-doc.status_ = 'накл':U
    20587         and not t-doc.flag_
    20588         then do:
    20589           message
    20590             "Недопустимая функция резерв в статусе накл -"
    20591             view-as alert-box.
    20592           return error.
    20593         end.
    20594         if t-doc.status_ = 'разрешен':U and not t-doc.flag_ then do:
    20595            message
    20596             "Документ №" t-doc.doc-code skip (2)
    20597             "Переход к документу инвентаризации (Статус разр+)?" skip
    20598             "Вы уверены?"
    20599             view-as alert-box question buttons OK-Cancel update varlog .
    20600         end.
    20601         else do:
    20602            message
    20603             "Документ №" t-doc.doc-code skip (2)
    20604             "Переход к документу пересортицы (Статус разр-)?" skip
    20605             "Вы уверены?"
    20606             view-as alert-box question buttons OK-Cancel update varlog .
    20607         end.
    20608         if varlog <> yes then do:   find t-doc no-lock where recid( t-doc ) = pardoc-rec.   return no-apply. end.
    20609         run str/trn-stat.p (input parparentproc,
    20610                         input this-procedure ,
    20611                         input '<резервирование по документу>':U,
    20612                         input t-doc.doc-code,
    20613                         input ?,
    20614                         input v-cntxt-db-num,
    20615                         input ?,
    20616                         input ?,
    20617                         input ?,
    20618                         input ?,
    20619                         input yes,
    20620                         output varchg-inv,
    20621                         output table gds-list) no-error.
    20622         if error-status:error then do:
    20623            message "Ошибка при операции с инвентаризацией " t-doc.doc-code skip
    20624            return-value skip
    20625            error-status :get-message(1) skip
    20626            error-status :get-message(2)
    20627            view-as alert-box error.
    20628            return error.
    20629         end.
    20630         if varchg-inv = yes then do:
    20631            assign varlog = no.
    20632            message "За время пребывания в статусе разр- было движение товаров, участвующих в инвентаризации." SKIP
    20633            "Показать список товаров по которым было движение?"
    20634             view-as alert-box question buttons yes-no update varlog .
    20635            if varlog then run str/gds-list.w (input parparentproc, input par-host-code, input par-obj-type, input par-obj-code).
    20636         end.
    20637       end.
    20638       else do:
    20639          message
    20640            vss-workfile vss-revision vss-description skip
    20641            "Данная функция недопустима для документа с расширенным типом: " t-doc.ext-doc-type skip
    20642            return-value
    20643            view-as alert-box error.
    20644          undo, return no-apply .
    20645       end.
    20646     end.
    20647     else do:
    20648       run str/out-unrv.w (input parparentproc, input t-doc.doc-code).
    20649     end.
    20650   end.
    20651   find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20652   run str/trn-hist.p
    20653     (buffer t-doc ,
    20654     input  par-obj-type ,
    20655     input  par-obj-code ,
    20656     input  "Резерв"
    20657     ) no-error .
    20658   if error-status :error then
    20659   message
    20660     vss-workfile vss-revision vss-description skip
    20661     error-status :get-message(1) skip
    20662     return-value skip
    20663     "Ошибка"
    20664     view-as alert-box error
    20665   .
    20666   find t-doc where recid (t-doc) = pardoc-rec no-lock.
    20667   run UI-on ("open").
    20668   end.
    20669   end procedure.
    20670   procedure proc-b-akt :
    20671    do
    20672    on error undo, return error return-value
    20673   :
    20674   varnext-prev = no.
    20675   br-handle = br-docs:handle in frame d-all-docs .
    20676   do while varnext-prev <> ?:
    20677     if not available t-doc then do:
    20678       message "Неправильный выбор документа.".
    20679       return error.
    20680     end.
    20681     if t-doc.doc-type = 'инв':U then do:
    20682        message "Данный документ являлся инвентаризацией или коррекцией партий. Переоценка не возможна."
    20683        view-as alert-box.
    20684        return error.
    20685     end.
    20686   define variable vss-include-info234 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    20687   do:
    20688     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    20689       (input  v-cntxt-db-num
    20690       ,input  v-cntxt-userid
    20691       ,input  0
    20692       ,input  'actn_overvalue_lookup':U
    20693       ,input  'object':U
    20694       ,input  t-doc.host-code
    20695       ,input  t-doc.obj-type
    20696       ,input  t-doc.obj-code
    20697       ,input  0
    20698       ,input  0
    20699       ,input  0
    20700       ,input  true
    20701       ,output varlog
    20702       )  .
    20703   end.
    20704     if not varlog then return no-apply.
    20705     bf-handle = buffer t-doc:handle in frame d-all-docs .
    20706      run str/trn-pr.w
    20707        (input parparentproc ,
    20708         input recid(t-doc) ,
    20709         input 'ПРОСМОТР':U ,
    20710         input-output varnext-prev ,
    20711         input ? ,
    20712         input ? ,
    20713         input ? ,
    20714         input br-handle ,
    20715         input bf-handle)
    20716         no-error .
    20717    if error-status :error then do:
    20718      message
    20719        vss-workfile vss-revision vss-description skip
    20720        error-status :get-message(1) skip
    20721        return-value skip
    20722        ""
    20723        view-as alert-box error
    20724      .
    20725      return error return-value .
    20726    end.
    20727   end.
    20728   if br-handle = ? then reposition br-docs to recid pardoc-rec no-error.
    20729   apply "entry" to br-docs in frame d-all-docs.
    20730   apply "iteration-changed" to br-docs in frame d-all-docs.
    20731    end.
    20732   end procedure.
    20733   procedure proc-b-lkp :
    20734   define variable varvalue-oldsuppcntr as character no-undo.
    20735   define variable vartype-oldsuppcntr  as character no-undo.
    20736    do
    20737    on error undo, return error return-value
    20738    :
    20739   varnext-prev = no.
    20740   br-handle = br-docs:handle  in frame d-all-docs .
    20741   bf-handle = buffer t-doc:handle in frame d-all-docs .
    20742   do while varnext-prev <> ?:
    20743     if not available t-doc then do:
    20744       message "Неправильный выбор документа.".
    20745       return error.
    20746     end.
    20747     case t-doc.doc-type :
    20748       when 'при':U
    20749       then do:
