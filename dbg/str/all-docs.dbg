     9749       end.
     9750       if p-change-value > 0
     9751       then do:
     9752         if frame d-all-docs :scrollable = true
     9753         then do:
     9754           assign
     9755             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     9756             no-error .
     9757           if error-status :error
     9758           or error-status :get-message(1) <> ""
     9759           then do:
     9760             undo move_block, retry move_block.
     9761           end.
     9762         end.
     9763         assign
     9764           frame d-all-docs :width = v-frame-width + p-change-value
     9765           no-error .
     9766         if error-status :error
     9767         or error-status :get-message(1) <> ""
     9768         then do:
     9769           undo move_block, retry move_block.
     9770         end.
     9771         assign
     9772           v-diasize-browse-handle :width = v-browse-width + p-change-value
     9773         no-error .
     9774         if error-status :error
     9775         or error-status :get-message(1) <> ""
     9776         then do:
     9777           undo move_block, retry move_block.
     9778         end.
     9779         for each buf_temp-browse-handle
     9780           where buf_temp-browse-handle.browse-type = 'width':u
     9781         on error undo move_block, retry move_block
     9782         :
     9783           assign
     9784             buf_temp-browse-handle.browse-handle :width
     9785               = buf_temp-browse-handle.browse-handle :width + p-change-value
     9786             no-error .
     9787           if error-status :error
     9788           or error-status :get-message(1) <> ""
     9789           then do:
     9790             undo move_block, retry move_block .
     9791           end.
     9792         end.
     9793         for each buf_temp-diasize-handle
     9794         on error undo move_block, retry move_block
     9795         :
     9796           assign
     9797             v-object-handle = buf_temp-diasize-handle.handle-value
     9798           .
     9799           if v-object-handle <> v-diasize-resize-button
     9800           then do:
     9801             assign
     9802               v-object-handle :col = v-object-handle :col + p-change-value
     9803               no-error .
     9804             if error-status :error
     9805             or error-status :get-message(1) <> ""
     9806             then do:
     9807               undo move_block, retry move_block .
     9808             end.
     9809           end.
     9810         end.
     9811       end.
     9812       else do:
     9813         for each buf_temp-diasize-handle
     9814         on error undo move_block, retry move_block
     9815         :
     9816           assign
     9817             v-object-handle = buf_temp-diasize-handle.handle-value
     9818           .
     9819           if v-object-handle <> v-diasize-resize-button
     9820           then do:
     9821             assign
     9822               v-object-handle :col = v-object-handle :col + p-change-value
     9823               no-error .
     9824             if error-status :error
     9825             or error-status :get-message(1) <> ""
     9826             then do:
     9827               undo move_block, retry move_block .
     9828             end.
     9829           end.
     9830         end.
     9831         for each buf_temp-browse-handle
     9832           where buf_temp-browse-handle.browse-type = 'width':u
     9833         on error undo move_block, retry move_block
     9834         :
     9835           assign
     9836             buf_temp-browse-handle.browse-handle :width
     9837               = buf_temp-browse-handle.browse-handle :width + p-change-value
     9838             no-error .
     9839           if error-status :error
     9840           or error-status :get-message(1) <> ""
     9841           then do:
     9842             undo move_block, retry move_block .
     9843           end.
     9844         end.
     9845         assign
     9846           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     9847           no-error .
     9848         if error-status :error
     9849         or error-status :get-message(1) <> ""
     9850         then do:
     9851           undo move_block, retry move_block.
     9852         end.
     9853         assign
     9854           frame d-all-docs :width = frame d-all-docs :width + p-change-value
     9855         no-error .
     9856         if error-status :error
     9857         or error-status :get-message(1) <> ""
     9858         then do:
     9859           undo move_block, retry move_block.
     9860         end.
     9861         if frame d-all-docs :scrollable = true
     9862         then do:
     9863           assign
     9864             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     9865           no-error .
     9866           if error-status :error
     9867           or error-status :get-message(1) <> ""
     9868           then do:
     9869             undo move_block, retry move_block.
     9870           end.
     9871         end.
     9872       end.
     9873       if p-move-resize
     9874       then do:
     9875         run diasize_position-resize-button in this-procedure .
     9876       end.
     9877       if v-diasize-wndstore = true
     9878       then do:
     9879         if connected("ub") = true
     9880         then do:
     9881           define variable v-cntxt-db-num        as integer   no-undo .
     9882           define variable v-cntxt-userid        as character no-undo .
     9883           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     9884                                             , OUTPUT v-cntxt-userid
     9885                                             ) .
     9886           run gbl/wndsizew.p
     9887             (input  v-cntxt-db-num
     9888             ,input  v-cntxt-userid
     9889             ,input  v-diasize-proc-name
     9890             ,input  'width':u
     9891             ,input  string(frame d-all-docs :width - v-diasize-orig-frame-width)
     9892             ) .
     9893         end.
     9894       end.
     9895     end.
     9896     assign
     9897       v-diasize-change-size = false
     9898     .
     9899   end procedure.
     9900   procedure diasize_set-width :
     9901     define input  parameter p-new-width  as decimal   no-undo .
     9902     define input  parameter p-move-resize as logical   no-undo .
     9903     do
     9904     on error undo, return error return-value
     9905     :
     9906       run diasize_change-width in this-procedure
     9907         (input  (p-new-width - frame d-all-docs :width)
     9908         ,input  p-move-resize
     9909         ) .
     9910     end.
     9911   end procedure.
     9912   procedure diasize_position-resize-button :
     9913     do with frame d-all-docs
     9914     :
     9915       hide v-diasize-resize-button .
     9916       assign
     9917         v-diasize-resize-button :row = frame d-all-docs :height - v-diasize-resize-button :height
     9918                     - 1
     9919                     - (frame d-all-docs :border-bottom-pixels / session :pixels-per-row)
     9920         v-diasize-resize-button :col = frame d-all-docs :width - v-diasize-resize-button :width
     9921                     - 1
     9922                     - (frame d-all-docs :border-right-pixels / session :pixels-per-column)
     9923       .
     9924       view v-diasize-resize-button .
     9925     end.
     9926   end procedure.
     9927   on alt-right anywhere
     9928   do:
     9929     run diasize_change-width in this-procedure
     9930       (input 1
     9931       ,input true
     9932       ) .
     9933     return no-apply .
     9934   end.
     9935   on alt-left anywhere
     9936   do:
     9937     run diasize_change-width in this-procedure
     9938       (input -1
     9939       ,input true
     9940       ) .
     9941     return no-apply .
     9942   end.
     9943   on alt-down anywhere
     9944   do:
     9945     run diasize_change-height in this-procedure
     9946       (input 1
     9947       ,input true
     9948       ) .
     9949     return no-apply .
     9950   end.
     9951   on alt-up anywhere
     9952   do:
     9953     run diasize_change-height in this-procedure
     9954       (input -1
     9955       ,input true
     9956       ) .
     9957     return no-apply .
     9958   end.
     9959   on alt-enter of frame d-all-docs
     9960   do:
     9961     run diasize_maximize in this-procedure
     9962       (input  ?
     9963       ).
     9964     return no-apply .
     9965   end.
     9966   procedure diasize_end-move :
     9967     do
     9968     on error undo, return error return-value
     9969     :
     9970       define variable v-row-delta as decimal   no-undo .
     9971       define variable v-col-delta as decimal   no-undo .
     9972       define variable v-new-row as decimal   no-undo .
     9973       define variable v-new-col as decimal   no-undo .
     9974       assign
     9975         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     9976         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     9977       .
     9978       assign
     9979         v-row-delta = v-new-row - frame d-all-docs :height
     9980         v-col-delta = v-new-col - frame d-all-docs :width
     9981       .
     9982       run diasize_change-height in this-procedure
     9983         (input v-row-delta
     9984         ,input true
     9985         ) .
     9986       run diasize_change-width in this-procedure
     9987         (input v-col-delta
     9988         ,input true
     9989         ) .
     9990     end.
     9991   end procedure.
     9992   procedure diasize_maximize :
     9993     define input  parameter p-action as logical   no-undo .
     9994     do
     9995     on error undo, return error return-value
     9996     :
     9997       if p-action = ?
     9998       then do:
     9999         if v-diasize-need-maximize = true
    10000         then do:
    10001           assign
    10002             p-action = true
    10003           .
    10004         end.
    10005         else do:
    10006           assign
    10007             p-action = false
    10008           .
    10009         end.
    10010       end.
    10011       if p-action = true
    10012       then do:
    10013         run diasize_change-height in this-procedure
    10014           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    10015               - frame d-all-docs :height-chars
    10016           ,input true
    10017           ) .
    10018         run diasize_change-width in this-procedure
    10019           (input session :width-chars
    10020               - frame d-all-docs :width-chars
    10021           ,input true
    10022           ) .
    10023         assign
    10024           v-diasize-need-maximize = false
    10025         .
    10026       end.
    10027       else do:
    10028         run diasize_change-width in this-procedure
    10029           (input v-diasize-orig-frame-width
    10030               - frame d-all-docs :width-chars
    10031           ,input true
    10032           ) .
    10033         run diasize_change-height in this-procedure
    10034           (input v-diasize-orig-frame-height
    10035               - frame d-all-docs :height-chars
    10036           ,input true
    10037           ) .
    10038         assign
    10039           v-diasize-need-maximize = true
    10040         .
    10041       end.
    10042     end.
    10043   end procedure.
    10044   procedure diasize_restore-orig-size :
    10045     do
    10046     on error undo, return error return-value
    10047     :
    10048       assign
    10049         v-diasize-current-frame-width  = frame d-all-docs :width
    10050         v-diasize-current-frame-height = frame d-all-docs :height
    10051       .
    10052       run diasize_set-height in this-procedure
    10053         (input  v-diasize-orig-frame-height
    10054         ,input  true
    10055         ) .
    10056       run diasize_set-width in this-procedure
    10057         (input  v-diasize-orig-frame-width
    10058         ,input  true
    10059         ) .
    10060     end.
    10061   end procedure.
    10062   procedure diasize_restore-current-size :
    10063     do
    10064     on error undo, return error return-value
    10065     :
    10066       run diasize_set-height in this-procedure
    10067         (input  v-diasize-current-frame-height
    10068         ,input  true
    10069         ) .
    10070       run diasize_set-width in this-procedure
    10071         (input  v-diasize-current-frame-width
    10072         ,input  true
    10073         ) .
    10074     end.
    10075   end procedure.
    10076   procedure diasize_set-browse-handle :
    10077     define input  parameter p-browse-handle as handle   no-undo .
    10078     define buffer buf_temp-browse-handle for temp-browse-handle .
    10079     do
    10080     on error undo, return error return-value
    10081     :
    10082       assign
    10083         v-diasize-browse-handle = p-browse-handle
    10084       .
    10085       for each buf_temp-browse-handle
    10086       on error undo, return error return-value
    10087       :
    10088         delete buf_temp-browse-handle .
    10089       end.
    10090     end.
    10091   end procedure.
    10092   procedure diasize_add_browse :
    10093     define input  parameter p-browse-type   as character no-undo .
    10094     define input  parameter p-browse-handle as handle    no-undo .
    10095     define buffer buf_temp-browse-handle for temp-browse-handle .
    10096     do
    10097     on error undo, return error return-value
    10098     :
    10099       assign
    10100         v-diasize-browse-number = v-diasize-browse-number + 1
    10101       .
    10102       create buf_temp-browse-handle .
    10103       assign
    10104         buf_temp-browse-handle.browse-type   = p-browse-type
    10105         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    10106         buf_temp-browse-handle.browse-handle = p-browse-handle
    10107       .
    10108     end.
    10109   end procedure.
    10110   procedure diasize_init :
    10111     define variable v-default-value    as logical   no-undo .
    10112     define variable v-restore-saved    as logical   no-undo .
    10113     define variable v-resize-value-str as character no-undo .
    10114     do
    10115     on error undo, return error return-value
    10116     :
    10117       do with frame d-all-docs
    10118       :
    10119         assign
    10120           v-diasize-orig-frame-height = frame d-all-docs :height
    10121           v-diasize-orig-frame-width  = frame d-all-docs :width
    10122           v-diasize-browse-handle     = browse br-docs :handle
    10123         .
    10124         create button v-diasize-resize-button
    10125         assign
    10126           parent        = frame d-all-docs :first-child
    10127           label         = "s"
    10128           height-pixels = 16
    10129           width-pixels  = 16
    10130           visible       = true
    10131           sensitive     = true
    10132           movable       = true
    10133           triggers:
    10134             on end-move persistent run diasize_end-move in this-procedure .
    10135           end triggers.
    10136         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    10137         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    10138         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    10139         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    10140         assign
    10141           v-diasize-wndmax = false
    10142         .
    10143         if connected("ub") = true
    10144         then do:
    10145           define variable v-cntxt-db-num        as integer   no-undo .
    10146           define variable v-cntxt-userid        as character no-undo .
    10147           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    10148                                             , OUTPUT v-cntxt-userid
    10149                                             ) .
    10150           run gbl/wndpar_r.p
    10151             (input  v-cntxt-db-num
    10152             ,input  v-cntxt-userid
    10153             ,input  'wndmax':U
    10154             ,output v-diasize-wndmax
    10155             ,output v-default-value
    10156             ) .
    10157         end.
    10158         assign
    10159           v-diasize-wndstore = false
    10160         .
    10161         if connected("ub") = true
    10162         then do:
    10163           run gbl/wndpar_r.p
    10164             (input  v-cntxt-db-num
    10165             ,input  v-cntxt-userid
    10166             ,input  'wndstore':U
    10167             ,output v-diasize-wndstore
    10168             ,output v-default-value
    10169             ) .
    10170         end.
    10171         assign
    10172           v-diasize-proc-name = entry(1, program-name(2), '.')
    10173         .
    10174         if v-diasize-wndstore = true
    10175         then do:
    10176           assign
    10177             v-restore-saved = false
    10178           .
    10179           if connected("ub") = true
    10180           then do:
    10181             run gbl/wndsizer.p
    10182               (input  v-cntxt-db-num
    10183               ,input  v-cntxt-userid
    10184               ,input  v-diasize-proc-name
    10185               ,input  'height':u
    10186               ,output v-resize-value-str
    10187               ) .
    10188             if v-resize-value-str <> '':U
    10189             then do:
    10190               run diasize_change-height in this-procedure
    10191                 (input  integer(v-resize-value-str)
    10192                 ,input  true
    10193                 ) .
    10194               assign
    10195                 v-restore-saved = true
    10196               .
    10197             end.
    10198           end.
    10199           if connected("ub") = true
    10200           then do:
    10201             run gbl/wndsizer.p
    10202               (input  v-cntxt-db-num
    10203               ,input  v-cntxt-userid
    10204               ,input  v-diasize-proc-name
    10205               ,input  'width':u
    10206               ,output v-resize-value-str
    10207               ) .
    10208             if v-resize-value-str <> '':U
    10209             then do:
    10210               run diasize_change-width in this-procedure
    10211                 (input  integer(v-resize-value-str)
    10212                 ,input  true
    10213                 ) .
    10214               assign
    10215                 v-restore-saved = true
    10216               .
    10217             end.
    10218           end.
    10219           if v-restore-saved <> true
    10220           then do:
    10221             if v-diasize-wndmax = true
    10222             then do:
    10223               run diasize_maximize in this-procedure
    10224                 (input  true
    10225                 ) .
    10226             end.
    10227           end.
    10228         end.
    10229         else do:
    10230           if v-diasize-wndmax = true
    10231           then do:
    10232             run diasize_maximize in this-procedure
    10233               (input  true
    10234               ) .
    10235           end.
    10236         end.
    10237       end.
    10238     end.
    10239   end procedure.
    10240   procedure diasize_need-full-display :
    10241     define output parameter p-need-full-display as logical   no-undo .
    10242     do
    10243     on error undo, return error return-value
    10244     :
    10245       assign
    10246         p-need-full-display = v-diasize-need-full-display
    10247       .
    10248       assign
    10249         v-diasize-need-full-display = false
    10250       .
    10251     end.
    10252   end procedure.
    10253   procedure get-context :
    10254      define output parameter p-db-num as integer          no-undo.
    10255      define output parameter p-user-id as character        no-undo.
    10256      define variable v-login               as character    no-undo.
    10257      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    10258      define buffer buf_user-login  for ub.user-login .
    10259      do
    10260      on error undo, return error
    10261      :
    10262            FIND FIRST buf_sys-ctrl no-lock.
    10263            ASSIGN
    10264               v-login = USERID("ub")
    10265               p-db-num = buf_sys-ctrl.db-num
    10266            .
    10267            FIND FIRST buf_user-login
    10268                 WHERE buf_user-login.db-num = p-db-num
    10269                   AND buf_user-login.user-login = v-login
    10270                 no-lock
    10271                 no-error
    10272                 .
    10273            IF AVAILABLE buf_user-login
    10274            THEN DO:
    10275               assign
    10276                  p-user-id = buf_user-login.user-id
    10277               .
    10278            END.
    10279      end.
    10280   end procedure.
    10281       run diasize_init in this-procedure .
    10282   define variable vss-include-info119 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10283   on f5 of frame d-all-docs anywhere
    10284   do:
    10285      assign v-doc-rec = ?. if available t-doc then v-doc-rec = recid(t-doc). run UI-on in this-procedure ('open') . reposition br-docs to recid v-doc-rec no-error. apply 'entry' to br-docs.
    10286       apply "VALUE-CHANGED" to br-docs.
    10287   end.
    10288   main-block:
    10289   do on error   undo main-block, leave main-block
    10290      on end-key undo main-block, leave main-block:
    10291     define variable tt as integer   no-undo .
    10292     tt = time.
    10293     run local-start-main in this-procedure.
    10294     run local-conf-rd    in this-procedure.
    10295   run init-browse-p  in this-procedure .
    10296   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10297   DEF VAR cur-clmn-numbr-docs as INT EXTENT 99 no-undo.
    10298   DEF VAR varmvibr-docs       as INT no-undo.
    10299   DEF VAR varmvjbr-docs       as INT no-undo.
    10300   DEF VAR varmvkbr-docs       as INT no-undo.
    10301   DEF VAR varmvlbr-docs       as INT no-undo.
    10302   DEF VAR move-elementbr-docs as INT no-undo.
    10303   def var jjbr-docs           as int no-undo.
    10304   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
    10305     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
    10306   END.
    10307   RUN start-mv-clmnbr-docs.
    10308   PROCEDURE start-mv-clmnbr-docs:
    10309   def var old-session as logical no-undo.
    10310      old-session = SESSION:IMMEDIATE-DISPLAY.
    10311      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
    10312          IF  true = true  THEN DO:
    10313      DO jjbr-docs = NUM-ENTRIES(v-order-column) TO 1 BY -1:
    10314        RUN re-move-clmnbr-docs ( cur-clmn-numbr-docs[INTEGER(ENTRY (jjbr-docs, v-order-column))] , 1).
    10315      END.
    10316          END.
    10317      SESSION:IMMEDIATE-DISPLAY = old-session.
    10318   END.
    10319   ON ctrl-cursor-right OF BROWSE br-docs do:
    10320     RUN re-move-clmnbr-docs ( 1, 99).
    10321   END.
    10322   ON ctrl-cursor-left OF BROWSE br-docs do:
    10323     RUN re-move-clmnbr-docs (99, 1).
    10324   END.
    10325   PROCEDURE re-move-clmnbr-docs:
    10326     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
    10327     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
    10328     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
    10329       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
    10330     END.
    10331     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME d-all-docs then.
    10332     if source-column > target-column THEN
    10333     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
    10334       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
    10335           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
    10336             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
    10337           END.
    10338       END.
    10339     END.
    10340     ELSE
    10341     DO varmvjbr-docs = source-column + 1 to target-column:
    10342       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
    10343         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
    10344           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
    10345         END.
    10346       END.
    10347     END.
    10348     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
    10349       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
    10350     END.
    10351   END PROCEDURE.
    10352   PROCEDURE ch-clmnbr-docs:
    10353     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
    10354     if cur-clmn-loc <= 1 then do:
    10355       return .
    10356     end.
    10357     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
    10358       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
    10359     END.
    10360     RUN re-move-clmnbr-docs (cur-clmn-loc, 1).
    10361   END PROCEDURE.
    10362   PROCEDURE mv-brw-defaultbr-docs:
    10363   def var old-session as logical no-undo.
    10364     old-session = SESSION:IMMEDIATE-DISPLAY.
    10365     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
    10366     do varmvlbr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
    10367       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
    10368     END.
    10369     RUN start-mv-clmnbr-docs.
    10370     SESSION:IMMEDIATE-DISPLAY = old-session.
    10371   END PROCEDURE.
    10372   .
    10373     run local-enable     in this-procedure.
    10374   define variable vss-include-info121 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10375   do:
    10376     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10377       (input  v-cntxt-db-num
    10378       ,input  v-cntxt-userid
    10379       ,input  0
    10380       ,input  'actn_sale_lookup':U
    10381       ,input  'object':U
    10382       ,input  par-host-code
    10383       ,input  par-obj-type
    10384       ,input  par-obj-code
    10385       ,input  0
    10386       ,input  0
    10387       ,input  0
    10388       ,input  false
    10389       ,output v-sale
    10390       )  .
    10391   end.
    10392   run create-button  in this-procedure .
    10393     extent (bcol) = ?.
    10394     hbrowse = browse br-docs:handle.
    10395     extent (bcol) = hbrowse:num-columns.
    10396     bcol[1] = hbrowse:first-column.
    10397     do ii = 1 to extent (bcol).
    10398       bcol[ii] = hbrowse:get-browse-column (ii).
    10399     end.
    10400   run UI-on          in this-procedure ('open').
    10401   WAIT-FOR GO OF FRAME d-all-docs focus br-docs.
    10402   end.
    10403   RUN disable_UI.
    10404   PROCEDURE disable_UI :
    10405     HIDE FRAME d-all-docs.
    10406   END PROCEDURE.
    10407   PROCEDURE UI-on :
    10408   define input parameter fnc as character no-undo.
    10409   assign t-doc.ship-date:read-only in browse br-docs = yes.
    10410   if fnc = "open" then do:
    10411     frame d-all-docs:title = "ВСЕ  ДОКУМЕНТЫ".
    10412     sch-num = 0.
    10413     hide sch-num in frame d-all-docs.
    10414   end.
    10415   else do:
    10416     assign
    10417       pardoc-rec = ?.
    10418   end.
    10419   if lookup( parlist-mode, 'работа,фирма,объект,выбор,ТИП,статус,ФЛАГ,ВНУ,отгрузка,invert,status-all,status-all-hold':U ) > 0 then do:
    10420     run enb-1 (fnc).
    10421   end.
    10422   else
    10423   if lookup( parlist-mode, 'счет-фактура-host,счет-фактура-obj':U ) = 0 then do:
    10424     run enb-2 (fnc).
    10425   end.
    10426   if fnc <> "open"   and
    10427      available t-d-b then do:
    10428     assign
    10429       pardoc-rec = recid (t-d-b).
    10430   end.
    10431   run openbr( yes, no, '':U, fnc).
    10432   end procedure.
    10433   PROCEDURE local-mark:
    10434     if not available t-doc then do:
    10435       message "Неправильный выбор строки.".
    10436       return error.
    10437     end.
    10438   define variable vss-include-info122 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10439   define variable v-str-recid123 as character no-undo .
    10440   define variable v-num-entry123 as integer   no-undo .
    10441   assign
    10442     v-str-recid123 = trim( string( recid( t-doc ) , "->>>>>>>>>>>9":U ) )
    10443     v-num-entry123 = lookup( v-str-recid123 , mark-list )
    10444   .
    10445   if v-num-entry123 > 0 then do:
    10446     assign
    10447       entry( v-num-entry123, mark-list ) = "":U
    10448       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    10449     .
    10450   end.
    10451   else do:
    10452     assign
    10453       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid123
    10454     .
    10455   end.
    10456     br-docs:refresh() in frame d-all-docs.
    10457   END PROCEDURE.
