     8300   END.
     8301   ON CHOOSE OF MENU-ITEM m-scaner-file in menu m-scaner DO:
     8302   define variable v-blob-uniq-key-rec as character no-undo .
     8303   define variable v-part-num as integer   no-undo .
     8304   define variable v-blob-db-num as integer   no-undo .
     8305   define variable v-int64-id as int64 no-undo .
     8306   define variable v-file-imafe-name as character no-undo .
     8307     if not available t-doc then return .
     8308     message
     8309       'Вы хотите изображение из файла  записать  в БД по документу №' t-doc.doc-code
     8310       '?'
     8311       view-as alert-box question
     8312       buttons yes-no
     8313       update v-ok as logical
     8314       .
     8315       if v-ok = false then return .
     8316         define variable glog as logical   no-undo .
     8317         system-dialog get-file v-file-imafe-name
     8318           title "Выберите файл с изображением"
     8319               filters "jpg" "*.jpg"
     8320               update glog.
