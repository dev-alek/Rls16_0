     7533   define browse br-docs query br-docs no-lock display
     7534         mark-string (recid(t-doc))  column-label '*'  format "x(1)"
     7535         first-symb-type (recid(t-doc))  column-label 'Т'  format "x(1)"
     7536         t-doc.status_  column-label 'Стат'  format "x(4)"
     7537         t-doc.flag_  column-label 'OK'  format "+/-"
     7538         t-doc.doc-code  column-label 'Номер'  format "x(14)"
     7539         t-doc.doc-date  column-label 'Дата'  format "99/99/99"
     7540         t-doc.fact-date  column-label 'Факт'
     7541         shift-day-month (recid(t-doc))  column-label 'Смена'  format "x(5)"
     7542         shift-name (recid(t-doc))  column-label '№'  format "x(6)"
     7543         t-doc.internal column-label 'В' format "+/-"
     7544         fcli-name (recid(t-doc)) column-label 'Контрагент' format "x(70)" width 26
     7545         object-label (recid(t-doc)) column-label 'Объект' format "x(9)"
     7546         t-doc.office column-label 'У' format "+/-"
     7547         total-doc-qnty (recid(t-doc)) column-label 'Кол-во по док.' FORMAT "->>,>>>,>>9.<<<"
     7548         total-fact-qnty (recid(t-doc)) column-label 'Кол-во факт' FORMAT "->>,>>>,>>9.<<<"
     7549         t-doc.print-rubl column-label '$' format "-/$"
     7550         total-sum (recid(t-doc)) column-label 'Сумма по док' format "->,>>>,>>>,>>>,>>9.99"
     7551         total-dsc (recid(t-doc)) column-label 'Скидка по док' format "->,>>>,>>>,>>>,>>9.99"
     7552         total-fact (recid(t-doc)) column-label 'Сумма факт' format "->,>>>,>>>,>>>,>>9.99"
     7553         total-dsc-fact (recid(t-doc)) column-label 'Скидка факт' format "->,>>>,>>>,>>>,>>9.99"
     7554         total-pay-fact (recid(t-doc)) column-label 'К оплате факт' format "x(21)"
     7555         total-vat (recid(t-doc)) column-label 'НДС' format "->,>>>,>>>,>>>,>>9.99"
     7556         total-acc (recid(t-doc)) column-label 'Сумма учет.' format "->,>>>,>>>,>>>,>>9.99"
     7557         t-doc.discnt-pc column-label 'Скидка (%)' format "->,>>9.99"
     7558         t-doc.discnt-type column-label 'Тип скидки'
     7559         t-doc.base-rate column-label 'Курс'
     7560         t-doc.ov column-label 'А'
     7561         t-doc.tot-ov column-label 'Авт. переоц. (прод.)' format "->,>>>,>>>,>>>,>>9.99"
     7562         t-doc.inv-num column-label 'Инв.'
     7563         t-doc.ord-num column-label 'Запрос'
     7564         t-doc.ship-num column-label 'Отгрузка приход'
     7565         t-doc.ship-date column-label 'Дата отгр'
     7566         t-doc.out-code column-label 'На док-т'
     7567         t-doc.acc-date column-label 'Внеш.сист'
     7568         t-doc.bge-date column-label 'Экспорт'
