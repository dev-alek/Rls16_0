     2053   procedure uf-get :
     2054     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2055     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2056     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2057     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2058     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2059     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2060     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2061     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2062     do
     2063     on error undo, return error
     2064     :
     2065       define buffer buf_usr-flt for ubflt.usr-flt .
     2066       define variable v-use-List_     as logical   no-undo .
     2067       define variable v-type-List_     as character no-undo .
     2068       define variable v-format-List_   as character no-undo .
     2069       define variable v-use-Naim      as logical   no-undo .
     2070       define variable v-type-Naim      as character no-undo .
     2071       define variable v-format-Naim    as character no-undo .
     2072       define variable v-use-print-graft as logical   no-undo .
     2073       define variable v-use-sort-gr     as logical   no-undo .
     2074       define variable v-use-type-price  as logical   no-undo .
     2075       define variable v-use-type-val    as logical   no-undo .
     2076       define variable v-label          as character no-undo .
     2077       define variable v-tooltip        as character no-undo .
     2078       define variable v-user-can-edit  as logical   no-undo .
     2079       define variable v-output-display as logical   no-undo .
     2080       define variable v-other          as character no-undo .
     2081       run uf-name in this-procedure
     2082          (input  entry(1, p-code, chr(4))
     2083         ,output v-use-List_
     2084         ,output v-type-List_
     2085         ,output v-format-List_
     2086         ,output v-use-Naim
     2087         ,output v-type-Naim
     2088         ,output v-format-Naim
     2089         ,output v-use-print-graft
     2090         ,output v-use-sort-gr
     2091         ,output v-use-type-price
     2092         ,output v-use-type-val
     2093         ,output v-label
     2094         ,output v-tooltip
     2095         ,output v-user-can-edit
     2096         ,output v-output-display
     2097         ,output v-other
     2098         ) no-error .
     2099       if error-status :error then do:
     2100         undo, return error return-value .
     2101       end.
     2102       find first buf_usr-flt no-lock where
     2103                  buf_usr-flt.Call-point     = p-code AND
     2104                  buf_usr-flt.user-name       = p-user-name
     2105         no-error .
     2106       if avail buf_usr-flt then do:
     2107         assign
     2108         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2109         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2110         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2111         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2112         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2113         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2114         .
     2115       end.
     2116       else do:
     2117         assign
     2118         p-List_        = (if v-use-List_       then "":U                    else ?)
     2119         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2120         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2121         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2122         p-type-price   = (if v-use-type-price  then no                      else ?)
     2123         p-type-val     = (if v-use-List_       then no                      else ?)
     2124         .
     2125       end.
     2126     end.
     2127   end procedure.
     2128   procedure uf-set :
     2129     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2130     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2131     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2132     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2133     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2134     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2135     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2136     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2137     do
     2138     on error undo, return error
     2139     :
     2140       define buffer buf_usr-flt for ubflt.usr-flt .
     2141       define variable v-use-List_     as logical   no-undo .
     2142       define variable v-type-List_     as character no-undo .
     2143       define variable v-format-List_   as character no-undo .
     2144       define variable v-use-Naim      as logical   no-undo .
     2145       define variable v-type-Naim      as character no-undo .
     2146       define variable v-format-Naim    as character no-undo .
     2147       define variable v-use-print-graft as logical   no-undo .
     2148       define variable v-use-sort-gr   as logical   no-undo .
     2149       define variable v-use-type-price as logical   no-undo .
     2150       define variable v-use-type-val  as logical   no-undo .
     2151       define variable v-tooltip        as character no-undo .
     2152       define variable v-label          as character no-undo .
     2153       define variable v-user-can-edit  as logical   no-undo .
     2154       define variable v-output-display as logical   no-undo .
     2155       define variable v-other          as character no-undo .
     2156       run uf-name in this-procedure
     2157         (input  entry(1, p-code, chr(4))
     2158         ,output v-use-List_
     2159         ,output v-type-List_
     2160         ,output v-format-List_
     2161         ,output v-use-Naim
     2162         ,output v-type-Naim
     2163         ,output v-format-Naim
     2164         ,output v-use-print-graft
     2165         ,output v-use-sort-gr
     2166         ,output v-use-type-price
     2167         ,output v-use-type-val
     2168         ,output v-label
     2169         ,output v-tooltip
     2170         ,output v-user-can-edit
     2171         ,output v-output-display
     2172         ,output v-other
     2173         ) no-error .
     2174       if error-status :error then do:
     2175         undo, return error return-value .
     2176       end.
     2177       find first buf_usr-flt where
     2178                  buf_usr-flt.Call-point     = p-code AND
     2179                  buf_usr-flt.user-name       = p-user-name
     2180         no-error .
     2181       if not avail buf_usr-flt then do:
     2182           create buf_usr-flt .
     2183           assign
     2184           buf_usr-flt.call-point = p-code
     2185           buf_usr-flt.user-name  = p-user-name
     2186           .
     2187       end.
     2188       if avail buf_usr-flt then do:
     2189        assign
     2190        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2191        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2192        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2193        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2194        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2195        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2196       .
     2197       release buf_usr-flt.
     2198       end.
     2199       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2200     end.
     2201   end procedure.
     2202   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2203   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2204   procedure fltopend_fltopend :
     2205   define input parameter p-parent-handle as handle no-undo .
     2206   define input parameter p-qh as handle no-undo .
     2207   define input parameter p-flt-open-open-query  as character no-undo .
     2208   define input parameter p-where-cond as character no-undo .
     2209   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2210   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2211   define input parameter p-indexed-reposition as character no-undo .
     2212     do
     2213     on error undo, return error
     2214     :
     2215   define variable v-prepare-string as character no-undo .
     2216   define variable glog as logical no-undo .
     2217   assign
     2218   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2219                      p-where-cond + chr(32)  +
     2220                      p-use-indFIRST-query-tail + chr(32) +
     2221                      p-use-ind-sort-clmn-by + chr(32) +
     2222                      p-indexed-reposition
     2223   .
     2224   assign
     2225   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2226   if not glog
     2227   or error-status:error then do:
     2228     message error-status:get-message(1) view-as alert-box .
     2229     undo, return error .
     2230   end.
     2231   assign
     2232   glog = p-qh:query-open no-error .
     2233   if not glog
     2234   or error-status:error then do:
     2235     message error-status:get-message(1) view-as alert-box .
     2236     undo, return error .
     2237   end.
     2238     end.
     2239   end procedure.
     2240   procedure fltopend_fltfindd :
     2241   define input parameter p-parent-handle as handle no-undo .
     2242   define input parameter p-qh as handle no-undo .
     2243   define input parameter p-rowid as rowid no-undo .
     2244   define input parameter p-next as logical no-undo .
     2245   define input parameter p-lock as integer no-undo .
     2246   define input parameter p-bh as handle no-undo .
     2247   define input parameter p-where-cond as character no-undo .
     2248   define input parameter p-use-index-phrase as character no-undo .
     2249   define variable glog as logical no-undo .
     2250   define variable v-qh as handle no-undo .
     2251   define variable v-bh as handle no-undo .
     2252   define variable v-recid as recid no-undo .
     2253   define variable v-prepare-string as character no-undo .
     2254   do
     2255   on error undo, return error
     2256   on stop undo, return error
     2257   :
     2258     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2259     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2260     create query v-qh.
     2261     v-qh:set-buffers(v-bh).
     2262     v-prepare-string = substitute("for each &1 &2 &3"
     2263                                     ,v-bh:name
     2264                                     ,p-where-cond
     2265                                     ,p-use-index-phrase).
     2266     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2267     if not glog then do:
     2268       delete object v-qh.
     2269       delete object v-bh.
     2270       undo, return error .
     2271     end.
     2272     glog = v-qh:query-open no-error .
     2273     if not glog then do:
     2274       delete object v-qh.
     2275       delete object v-bh.
     2276       undo, return error .
     2277     end.
     2278     if p-next then do:
     2279       v-qh:reposition-to-rowid(p-rowid) no-error .
     2280       glog = v-qh:get-next( p-lock) no-error .
     2281       glog = v-qh:get-next( p-lock) no-error .
     2282       if not glog or v-qh:query-off-end = yes then do:
     2283         glog = v-qh:get-first( p-lock) no-error .
     2284       end.
     2285     end.
     2286     else do:
     2287       glog = v-qh:get-first( p-lock) no-error .
     2288     end.
     2289     v-recid = v-bh:recid no-error .
     2290     delete object v-qh.
     2291     delete object v-bh.
     2292     return string(v-recid) .
     2293   end.
     2294   end procedure.
     2295   procedure fltopend_fltfindq :
     2296   define input parameter p-parent-handle as handle no-undo .
     2297   define input parameter p-qh as handle no-undo .
     2298   define input parameter p-next as logical no-undo .
     2299   define input parameter p-lock as integer no-undo .
     2300   define input parameter p-flt-open-open-query  as character no-undo .
     2301   define input parameter p-where-cond as character no-undo .
     2302   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2303   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2304   define input parameter p-indexed-reposition as character no-undo .
     2305   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2306   define variable glog as logical no-undo .
     2307   define variable v-qh as handle no-undo .
     2308   define variable v-bh as handle no-undo extent 18.
     2309   define variable v-rowid as rowid no-undo extent 18.
     2310   define variable v-ii as integer no-undo .
     2311   define variable v-prepare-string as character no-undo .
     2312   do
     2313   on error undo, return error
     2314   on stop undo, return error
     2315   :
     2316     create query v-qh.
     2317     do v-ii = 1 to p-qh:num-buffers:
     2318       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2319       assign
     2320       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2321       no-error.
     2322       v-qh:add-buffer(v-bh[v-ii]).
     2323     end.
     2324     assign
     2325     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2326                       p-where-cond + chr(32)  +
     2327                       p-use-indFIRST-query-tail + chr(32) +
     2328                       p-use-ind-sort-clmn-by + chr(32) +
     2329                       p-indexed-reposition
     2330     .
     2331     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2332     if not glog then do:
     2333       delete object v-qh.
     2334       do v-ii = 1 to p-qh:num-buffers:
     2335         delete object v-bh[v-ii].
     2336       end.
     2337       undo, return error .
     2338     end.
     2339     glog = v-qh:query-open no-error .
     2340     if not glog then do:
     2341       delete object v-qh.
     2342       do v-ii = 1 to p-qh:num-buffers:
     2343         delete object v-bh[v-ii].
     2344       end.
     2345       undo, return error .
     2346     end.
     2347     if p-next then do:
     2348       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2349       glog = v-qh:get-next( p-lock) no-error .
     2350       glog = v-qh:get-next( p-lock) no-error .
     2351       if not glog or v-qh:query-off-end = yes then do:
     2352         glog = v-qh:get-first( p-lock) no-error .
     2353       end.
     2354     end.
     2355     else do:
     2356       glog = v-qh:get-first( p-lock) no-error .
     2357     end.
     2358     do v-ii = 1 to p-qh:num-buffers:
     2359       assign
     2360       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2361       no-error.
     2362     end.
     2363     delete object v-qh.
     2364     do v-ii = 1 to p-qh:num-buffers:
     2365       delete object v-bh[v-ii].
     2366     end.
     2367   end.
     2368   end procedure.
     2369   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   function octal-to-char return character
     2371   ( p-string as character ) :
     2372     def var v-asc     as integer no-undo .
     2373     def var v-new-asc as integer no-undo .
     2374     def var ind       as integer no-undo .
     2375     if length(p-string) <> 3 then do:
     2376       return ? .
     2377     end.
     2378     assign
     2379       v-asc = 0
     2380     .
     2381     do ind = 1 to length(p-string)
     2382     :
     2383       assign
     2384         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2385       .
     2386       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2387         return ? .
     2388       end.
     2389       assign
     2390         v-asc = v-asc * 8 + v-new-asc
     2391       .
     2392     end.
     2393     return chr(v-asc) .
     2394   end function .
     2395   function char-to-octal return character
     2396   ( p-chr as character ) :
     2397     def var v-asc    as integer   no-undo .
     2398     def var ind      as integer   no-undo .
     2399     def var v-string as character no-undo .
     2400     if length(p-chr) <> 1 then do:
     2401       return ? .
     2402     end.
     2403     assign
     2404       v-asc    = asc(p-chr)
     2405       v-string = ""
     2406     .
     2407     do ind = 1 to 3
     2408     :
     2409       assign
     2410         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2411       .
     2412       assign
     2413         v-asc = truncate(v-asc / 8, 0)
     2414       .
     2415     end.
     2416     return v-string .
     2417   end.
     2418   function str-encode return character
     2419   (   p-init-string       as character
     2420     , p-encode-char       as character
     2421     , p-special-char-list as character
     2422   ) :
     2423     def var p-encode-string as character no-undo .
     2424     def var ind                as integer no-undo .
     2425     def var v-num-special-char as integer no-undo .
     2426     def var v-special-char     as character no-undo .
     2427     if p-encode-char = ?
     2428     or p-encode-char = "" then do:
     2429       assign
     2430         p-encode-char = "~~"
     2431       .
     2432     end.
     2433     if p-init-string = ? then do:
     2434       return "?" .
     2435     end.
     2436     if p-init-string = "?" then do:
     2437       return p-encode-char + char-to-octal("?") .
     2438     end.
     2439     assign
     2440       v-num-special-char = length(p-special-char-list)
     2441       p-encode-string    = replace(p-init-string
     2442                                   ,p-encode-char
     2443                                   ,p-encode-char + char-to-octal(p-encode-char)
     2444                                   )
     2445     .
     2446     do ind = 1 to v-num-special-char
     2447     :
     2448       assign
     2449         v-special-char = substring(p-special-char-list, ind, 1)
     2450       .
     2451       if v-special-char <> p-encode-char then do:
     2452         assign
     2453           p-encode-string = replace (p-encode-string
     2454                                     ,v-special-char
     2455                                     ,p-encode-char + char-to-octal(v-special-char)
     2456                                     )
     2457         .
     2458       end.
     2459     end.
     2460     return p-encode-string .
     2461   end.
     2462   function str-decode returns character
     2463     (p-init-string   as character
     2464     ,p-encode-char   as character
     2465     ) :
     2466     def var p-decode-string as character no-undo .
     2467     def var ind                       as integer no-undo .
     2468     def var v-num-entries-init-string as integer no-undo .
     2469     def var v-sub-phrase              as character no-undo .
     2470     def var v-special-char            as character no-undo .
     2471     if p-encode-char = ?
     2472     or p-encode-char = "" then do:
     2473       assign
     2474         p-encode-char = "~~"
     2475       .
     2476     end.
     2477     if p-init-string = "?" then do:
     2478       return ? .
     2479     end.
     2480     assign
     2481       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2482     .
     2483     if v-num-entries-init-string > 1 then do:
     2484       assign
     2485         p-decode-string = entry(1, p-init-string, p-encode-char)
     2486       .
     2487       do ind = 2 to v-num-entries-init-string
     2488       :
     2489         assign
     2490           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2491         .
     2492         assign
     2493           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2494         .
     2495         if v-special-char <> ? then do:
     2496           assign
     2497             p-decode-string = p-decode-string
     2498                             + v-special-char
     2499                             + substring(v-sub-phrase, 4)
     2500           .
     2501         end.
     2502         else do:
     2503           assign
     2504             p-decode-string = p-decode-string
     2505                             + p-encode-char
     2506                             + v-sub-phrase
     2507           .
     2508         end.
     2509       end.
     2510     end.
     2511     else do:
     2512       assign
     2513         p-decode-string = p-init-string
     2514       .
     2515     end.
     2516     return p-decode-string .
     2517   end.
     2518   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2519   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
