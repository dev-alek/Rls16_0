     1914             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1915             .
     1916         end.
     1917         when 'маг':U then do:
     1918           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1919           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
