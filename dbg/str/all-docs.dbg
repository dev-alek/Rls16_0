    21192       mark-list = ""
    21193       .
    21194    run UI-on ("open").
    21195    end.
    21196   end procedure.
    21197   procedure proc-m_gen-22 :
    21198    do
    21199    on error undo, return error return-value
    21200    :
    21201    if num-entries(mark-list) = 0 then do:
    21202       message "Не выделено ни одной накладной для генерации финансовых обязательств !".
    21203       return error .
    21204    end.
    21205    run str/gen-fbuy.w (
    21206        input parparentproc,
    21207        input par-host-code,
    21208        input mark-list,
    21209        input ""
    21210    )   .
    21211     assign
    21212       mark-list = ""
    21213       .
    21214    run UI-on ("open").
    21215    end.
    21216   end procedure.
    21217   procedure proc-m_gen-8 :
    21218   define buffer bf_sysconf for ub.sysconf.
    21219   define buffer bf_trn-doc for ub.trn-doc.
    21220   define variable vari as integer no-undo.
    21221   define variable vardoc-code as integer no-undo.
    21222   do
    21223   on error undo, return error return-value
    21224   :
    21225   if mark-list = "" then do:
    21226     if available t-doc then do:
    21227       assign
    21228         mark-list = string(recid(t-doc)).
    21229     end.
    21230   end.
    21231   vari-cycle:
    21232   do vari = 1 to num-entries (mark-list):
    21233     assign
    21234       vardoc-code = integer(entry (vari, mark-list)).
    21235     find first bf_trn-doc where recid(bf_trn-doc) = vardoc-code exclusive-lock.
    21236     if bf_trn-doc.status_ <> 'факт':U then do:
    21237       message "Документ " bf_trn-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
    21238       view-as alert-box.
    21239       next vari-cycle.
    21240     end.
    21241     find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
    21242     if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    21243       message "Главная БД для фирмы по документу с кодом " bf_trn-doc.doc-code " не является текущей БД." skip
    21244               "Текущая БД: " v-cntxt-db-num skip
    21245               "Главная БД фирмы: " bf_sysconf.firm-db-num
    21246       view-as alert-box error.
    21247       next vari-cycle.
    21248     end.
    21249     if bf_trn-doc.cr-incfo = yes then do:
    21250       message "По документу " bf_trn-doc.doc-code " уже генерилось финансовое обязательство от " bf_trn-doc.incfo-date " числа."
    21251       view-as alert-box.
    21252       next vari-cycle.
    21253     end.
    21254     else do:
    21255       if bf_trn-doc.need-incfo = 1 or
    21256          bf_trn-doc.need-incfo = 2 then do:
    21257         assign
    21258           bf_trn-doc.need-incfo = 0.
    21259         if bf_trn-doc.need-expfo = 0 then do:
    21260           assign
    21261             bf_trn-doc.need-incorexpfo = 0.
    21262         end.
    21263       end.
    21264       else do:
    21265         message "Данный документ не нуждался в генерации финобязательств по поставке."
    21266         view-as alert-box.
    21267         next vari-cycle.
    21268       end.
    21269       reposition br-docs to recid recid(bf_trn-doc) no-error.
    21270       if not error-status:error then do:
    21271         display fo-postavka (recid( bf_trn-doc)) @ varpost with browse br-docs.
    21272       end.
    21273     end.
    21274   end.
    21275   assign
    21276     mark-list = "".
    21277   end.
    21278   end.
