    21704       view-as alert-box error.
    21705       return error.
    21706     end.
    21707     if bf_trn-doc.need-expfo = 2 then do:
    21708       assign
    21709         varneed-expfo = no.
    21710       for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code on error undo, return error return-value :
    21711         if bf_parts.contract-code <> 0 then do:
    21712           find first bf_contract where bf_contract.host-code     = bf_trn-doc.host-code   and
    21713                                        bf_contract.contract-code = bf_parts.contract-code no-lock no-error.
    21714           if available bf_contract then do:
    21715             if lookup (bf_contract.usl-opl, 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)') > 0 then do:
    21716               assign
    21717                 varneed-expfo = yes.
    21718             end.
    21719           end.
    21720         end.
    21721       end.
    21722       if varneed-expfo then do:
    21723         assign
    21724           bf_trn-doc.need-expfo      = 1
    21725           bf_trn-doc.need-incfo      = 0
    21726           bf_trn-doc.need-incorexpfo = 1
    21727         .
