    18501   define variable vss-include-info200 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18502   define variable  l-disable-where-201  as logical   no-undo .
    18503   define variable  l-filter-open-201    as logical   .
    18504   define variable  flt-rec-201       as recid     no-undo .
    18505   define variable  filter-name-201      as character no-undo .
    18506   define variable  where-phrase-201     as character no-undo .
    18507   define variable  sort-phrase-201      as character no-undo .
    18508   define variable  where-phrase-rus-201 as character no-undo .
    18509   define variable  sort-phrase-rus-201  as character no-undo .
    18510   run gbl/flt-get.p
    18511     (input filter-point
    18512     ,output flt-rec-201
    18513     ,output filter-name-201
    18514     ,output where-phrase-201
    18515     ,output sort-phrase-201
    18516     ,output where-phrase-rus-201
    18517     ,output sort-phrase-rus-201
    18518     ).
    18519   if p-open-query then do:
    18520       run set-filter-name in this-procedure
    18521         (INPUT filter-name-201
    18522         ) no-error .
    18523     assign
    18524       l-filter-open-201 = false
    18525     .
    18526     if flt-rec-201 <> ?
    18527       or sort-column-phrase > ""
    18528     then do:
    18529       define variable  parameter-2-201 as character no-undo .
    18530       define variable  parameter-3-201 as character no-undo .
    18531       define variable  parameter-4-201 as character no-undo .
    18532       define variable  parameter-5-201 as character no-undo .
    18533       define variable  parameter-6-201 as character no-undo .
    18534       define variable  parameter-7-201 as character no-undo .
    18535         assign
    18536         parameter-3-201 =
    18537                                 "FOR EACH t-doc"
    18538         parameter-4-201 =
    18539           (
    18540             if ("t-doc.obj-type = par-obj-type
    18541                      and t-doc.obj-code = par-obj-code
    18542                      and t-doc.status_ = 'разрешен':U
    18543                      and (t-doc.doc-type = 'рас':U or t-doc.doc-type = 'спи':U)
    18544                      " + " " + where-phrase-201) <> ""
    18545             then  substitute ( '                            t-doc.obj-type  = &1&2&1                         and t-doc.obj-code  = &3                             and t-doc.status_   = &1&4&1                         and (t-doc.doc-type =  &1&5&1 or t-doc.doc-type =  &1&6&1 )                       ', chr(34), par-obj-type , par-obj-code , 'разрешен':U , 'рас':U, 'спи':U )  + " " + where-phrase-201
    18546             else "true"
    18547           )
    18548         parameter-5-201 = (" " + "use-index obj-load " + " " + substitute(' , first temp-trn-doc where (&1 = 1 or t-doc.doc-code = temp-trn-doc.doc-code ) ' , r-2 ))
    18549         parameter-6-201 = if sort-phrase-201 = ''
    18550                              then
    18551           (
    18552           " " + "" +
    18553             " " + sort-column-phrase +
    18554           " " + ""
    18555           )
    18556                              else
    18557           (
    18558           " " + "" +
    18559             " " + sort-column-phrase +
    18560           " " + sort-phrase-201
    18561           )
    18562         parameter-7-201 =
    18563           "   "
    18564       .
    18565       do
    18566       on stop undo, leave
    18567       on error undo, leave
    18568       :
    18569         assign
    18570           l-disable-where-201 =
    18571             ("t-doc.obj-type = par-obj-type
    18572                      and t-doc.obj-code = par-obj-code
    18573                      and t-doc.status_ = 'разрешен':U
    18574                      and (t-doc.doc-type = 'рас':U or t-doc.doc-type = 'спи':U)
    18575                      " + " " + where-phrase-201 = "")
    18576         .
    18577         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    18578                             ,input query br-docs:handle
    18579                             ,input parameter-3-201
    18580                             ,input parameter-4-201
    18581                             ,input parameter-5-201
    18582                             ,input parameter-6-201
    18583                             ,input parameter-7-201
    18584                             )
    18585         .
    18586         assign
    18587           l-filter-open-201 = true
    18588         .
    18589       end.
    18590       if l-filter-open-201 = false then do:
    18591         message
    18592           "Ошибка при фильтрации / сортировке" skip
    18593           "Будут показаны записи без учета фильтра" skip
    18594           view-as alert-box .
    18595       end.
    18596       else do:
    18597           assign
    18598             l-query-was-opened = true
    18599           .
    18600       end.
    18601     end.
    18602     if l-filter-open-201 = false then do:
    18603       open query br-docs for each t-doc
    18604         where t-doc.obj-type = par-obj-type
    18605                      and t-doc.obj-code = par-obj-code
    18606                      and t-doc.status_ = 'разрешен':U
    18607                      and (t-doc.doc-type = 'рас':U or t-doc.doc-type = 'спи':U)
    18608       use-index obj-load
    18609       , first temp-trn-doc where (r-2 = 1 or t-doc.doc-code = temp-trn-doc.doc-code )
    18610     .
    18611         assign
    18612           l-query-was-opened = true
    18613         .
    18614     end.
    18615   end.
    18616   else do:
    18617     assign
    18618       pardoc-rec = recid( t-doc )
    18619     .
    18620     do
    18621     on stop undo, leave
    18622     on error undo, leave
    18623     :
    18624       if query br-docs:handle:get-buffer-handle(1) = (buffer t-doc:handle) then do:
    18625         assign
    18626         parameter-2-201 = (if p-find-next then "true":u else "false":u )
    18627         parameter-4-201 =
    18628           "where ":u +  substitute ( '                            t-doc.obj-type  = &1&2&1                         and t-doc.obj-code  = &3                             and t-doc.status_   = &1&4&1                         and (t-doc.doc-type =  &1&5&1 or t-doc.doc-type =  &1&6&1 )                       ', chr(34), par-obj-type , par-obj-code , 'разрешен':U , 'рас':U, 'спи':U )  + " ":u + where-phrase-201 + " ":u + p-find-condition + " " + "use-index obj-load "
    18629         parameter-5-201 = ""
    18630       .
    18631         run fltopend_fltfindd in this-procedure  (
    18632                             input this-procedure:handle
    18633                             ,input query br-docs:handle
    18634                             ,input rowid(t-doc)
    18635                             ,input logical(parameter-2-201)
    18636                             ,input no-lock
    18637                             ,input (buffer t-doc:handle)
    18638                             ,input parameter-4-201
    18639                             ,input parameter-5-201
    18640                             ) no-error.
    18641         .
    18642         assign
    18643           pardoc-rec = integer(return-value)
    18644           v-fltopend-rowid[1] = ?
    18645         .
    18646       end.
    18647       else do:
    18648         assign
    18649         parameter-2-201 = (if p-find-next then "true":u else "false":u )
    18650         parameter-3-201 =  "FOR EACH t-doc"
    18651         parameter-4-201 =
    18652           (
    18653             if ("t-doc.obj-type = par-obj-type
    18654                      and t-doc.obj-code = par-obj-code
    18655                      and t-doc.status_ = 'разрешен':U
    18656                      and (t-doc.doc-type = 'рас':U or t-doc.doc-type = 'спи':U)
    18657                      " + " " + where-phrase-201) <> ""
    18658             then  substitute ( '                            t-doc.obj-type  = &1&2&1                         and t-doc.obj-code  = &3                             and t-doc.status_   = &1&4&1                         and (t-doc.doc-type =  &1&5&1 or t-doc.doc-type =  &1&6&1 )                       ', chr(34), par-obj-type , par-obj-code , 'разрешен':U , 'рас':U, 'спи':U )  + " " + where-phrase-201
    18659             else "true"
    18660           )
    18661         parameter-5-201 = (" " + "use-index obj-load " + " " + substitute(' , first temp-trn-doc where (&1 = 1 or t-doc.doc-code = temp-trn-doc.doc-code ) ' , r-2 ) + " " + p-find-condition)
    18662         parameter-6-201 = if sort-phrase-201 = ''
    18663                              then
    18664           (
    18665           " " + "" +
    18666             " " + sort-column-phrase +
    18667           " " + ""
    18668           )
    18669                              else
    18670           (
    18671           " " + "" +
    18672             " " + sort-column-phrase +
    18673           " " + sort-phrase-201
    18674           )
    18675         parameter-7-201 =
    18676           "   "
    18677       .
    18678         run fltopend_fltfindq in this-procedure  (
    18679                             input this-procedure:handle
    18680                             ,input query br-docs:handle
    18681                             ,input logical(parameter-2-201)
    18682                             ,input no-lock
    18683                             ,input parameter-3-201
    18684                             ,input parameter-4-201
    18685                             ,input parameter-5-201
    18686                             ,input parameter-6-201
    18687                             ,input parameter-7-201
    18688                             ,output v-fltopend-rowid
    18689                             ) no-error.
    18690         .
    18691         pardoc-rec = ?.
    18692       end.
    18693       assign
    18694         l-query-was-opened = true
    18695       .
    18696     end.
    18697   end.
    18698       end.
    18699     end.
    18700   end.
    18701   end procedure.
    18702   PROCEDURE enb-1 :
    18703   define input parameter fnc as character no-undo.
    18704   case parlist-mode :
    18705     when 'объект':U then do:
    18706       if fnc = "open" then do:
    18707         enable b-chg b-del b-close b-open b-unrv with frame d-all-docs.
    18708         if not (varis-hold = yes                     and
    18709                 paris-hold = yes                     and
    18710                 parext-doc-type = 'ie':U )   then do:
    18711           enable b-add with frame d-all-docs.
    18712         end.
    18713       end.
    18714     end.
    18715     when "invert":u then do:
    18716       if fnc = "open" then do:
    18717         enable b-open with frame d-all-docs.
    18718       end.
    18719     end.
    18720     when 'ТИП':U then do:
    18721       if varhold <> "yes" then do:
    18722         if fnc = "open" then do:
    18723           enable b-chg b-del b-add b-close b-open b-unrv with frame d-all-docs.
    18724         end.
    18725       end.
    18726       else do:
    18727         if paris-hold = no then do:
    18728           if fnc = "open" then do:
    18729             enable b-chg b-del b-close b-add b-open b-unrv with frame d-all-docs.
    18730           end.
    18731         end.
    18732         else do:
    18733           if fnc = "open" then do:
    18734             enable b-chg b-del b-close b-open b-unrv with frame d-all-docs.
    18735             if parext-doc-type <> 'ie':U then do:
    18736               enable b-add with frame d-all-docs.
    18737             end.
    18738           end.
    18739         end.
    18740       end.
    18741     end.
    18742     when 'status-all' then do:
    18743         if fnc = "open" then do:
    18744           enable b-chg b-del b-add b-close b-open b-unrv WITH FRAME d-all-docs.
    18745         end.
    18746     end.
    18747     when 'status-all-hold' then do:
    18748         if fnc = "open" then do:
    18749         end.
    18750     end.
    18751     when 'статус':U then do:
    18752       if varhold <> "yes" then do:
    18753         if fnc = "open" then do:
    18754           enable b-chg b-del b-add b-close b-open b-unrv WITH FRAME d-all-docs.
    18755         end.
    18756       end.
    18757       else do:
    18758         if paris-hold = no then do:
    18759           if fnc = "open" then do:
    18760             enable b-chg b-del b-add b-close b-open b-unrv with frame d-all-docs.
    18761           end.
    18762         end.
    18763         else do:
    18764           if fnc = "open" then do:
    18765             enable b-chg b-del b-close b-open b-unrv with frame d-all-docs.
    18766             if parext-doc-type <> 'ie':U then do:
    18767               enable b-add with frame d-all-docs.
    18768             end.
    18769           end.
    18770         end.
    18771       end.
    18772     end.
    18773     when 'ФЛАГ':U then do:
    18774       if varhold <> "yes" then do:
    18775         if fnc = "open" then do:
    18776           enable b-chg b-add b-del b-close b-open b-unrv with frame d-all-docs.
    18777         end.
    18778       end.
    18779       else do:
    18780         if paris-hold = no then do:
    18781           if fnc = "open" then do:
    18782             enable b-chg b-del b-close b-add b-open b-unrv with frame d-all-docs.
    18783           end.
    18784         end.
    18785         else do:
    18786           if fnc = "open" then do:
    18787             enable b-chg b-del b-close b-open b-unrv with frame d-all-docs.
    18788             if parext-doc-type <> 'ie':U    then do:
    18789               enable b-add with frame d-all-docs.
    18790             end.
    18791           end.
    18792         end.
    18793       end.
    18794     end.
    18795     when 'ВНУ':U then do:
    18796       if fnc = "open" then do:
    18797         enable b-chg b-del b-close b-open b-unrv with frame d-all-docs.
    18798         if not (varis-hold = yes                     and
    18799                 paris-hold = yes                     and
    18800                 parext-doc-type = 'ie':U )   then do:
    18801           enable b-add with frame d-all-docs.
    18802         end.
    18803       end.
    18804     end.
    18805   end case.
    18806   if parext-doc-type = 'ie':U and b-add:sensitive in frame d-all-docs = true
    18807   then do:
    18808     enable b-copy with frame d-all-docs.
    18809     display b-copy with frame d-all-docs.
    18810   end.
    18811   end procedure.
    18812   procedure enb-2 :
    18813   define input parameter fnc as character no-undo.
    18814   if parlist-mode = 'МЕШАЮТ':U then do:
    18815    if fnc = "open" then do:
    18816      ENABLE b-chg b-del b-close b-open b-unrv WITH FRAME d-all-docs.
    18817    end.
    18818   end.
    18819   end procedure.
    18820   PROCEDURE proc-find-code :
    18821   define input parameter par-next as logical no-undo.
    18822   define input parameter pardoc-code like ub.inkas.inkas-code no-undo.
    18823   display
    18824   "  /  /":U @ sch-date
    18825   "  /  /":U @ sch-fact
    18826   '' @ sch-objtype
    18827   '' @ sch-objcode
    18828   '' @ sch-sum
    18829   with frame d-all-docs.
    18830   assign
    18831   pardoc-code = chr(34) + pardoc-code + chr(34).
    18832   run OpenBr in this-procedure
    18833     (input false
    18834     ,input par-next
    18835     ,input substitute(" and t-doc.doc-code   begins &1 ", pardoc-code)
    18836     ,input "open"
    18837     ).
    18838   apply "entry":u to sch-code in frame d-all-docs .
    18839   end procedure.
    18840   procedure proc-find-date :
    18841   define input parameter par-next as logical no-undo.
    18842   define input parameter par-date like ub.inkas.doc-date no-undo.
    18843   define input parameter parwhat-date as character no-undo.
    18844   define variable var-datechr as character no-undo.
    18845   display
    18846   '':u @ sch-code
    18847   '':u @ sch-objcode
    18848   '':u @ sch-objtype
    18849   '':u @ sch-sum
    18850   with frame d-all-docs.
    18851   assign
    18852   var-datechr = string(day(par-date)) + chr(47) +
    18853                 string(month(par-date)) + chr(47) +
    18854                 string(year(par-date)).
    18855   case parwhat-date:
    18856     when "doc-date":u then do:
    18857       display
    18858       "  /  /":u @ sch-fact
    18859       with frame d-all-docs.
    18860       run openbr in this-procedure
    18861       (input false
    18862       ,input true
    18863       ,input substitute("and t-doc.doc-date = &1 "
    18864         , var-datechr)
    18865       , "open"
    18866       ).
    18867       apply "entry":u to sch-date in frame d-all-docs.
    18868     end.
    18869     when "fact-date":u then do:
    18870       display
    18871       "  /  /":u @ sch-date
    18872       with frame d-all-docs.
    18873       run openbr in this-procedure
    18874         (input false
    18875         ,input true
    18876         ,input substitute("and t-doc.fact-date = &1 "
    18877         , var-datechr)
    18878         , "open"
    18879         ).
    18880       apply "entry":u to sch-fact in frame d-all-docs.
    18881     end.
    18882   end.
    18883   end procedure.
    18884   PROCEDURE proc-find-cli :
    18885   define input parameter parcli-type like ub.clients.obj-type no-undo.
    18886   define input parameter parcli-code like ub.clients.obj-code no-undo.
    18887   display
    18888   '':u @ sch-code
    18889   "  /  /":U @ sch-date
    18890   "  /  /":U @ sch-fact
    18891   '':u  @ sch-sum
    18892   with frame d-all-docs.
    18893   run OpenBr in this-procedure
    18894     (input false
    18895     ,input yes
    18896     ,input substitute("and t-doc.cli-type = '&1' and t-doc.cli-code = &2", parcli-type, parcli-code)
    18897     ,input "open"
    18898     ).
    18899   apply "entry":u to sch-objtype in frame d-all-docs .
    18900   end procedure.
    18901   PROCEDURE proc-find-sum :
    18902   define input parameter parsum as decimal no-undo.
    18903   display
    18904   '':u @ sch-code
    18905   "  /  /":U @ sch-date
    18906   "  /  /":U @ sch-fact
    18907   '':u @ sch-objtype
    18908   '':u @ sch-objcode
    18909   with frame d-all-docs.
    18910   run OpenBr in this-procedure
    18911     (input false
    18912     ,input yes
    18913     ,input substitute("and (t-doc.print-rubl = yes and round(t-doc.tot-sale, 2) = &1 or t-doc.print-rubl = no and round(t-doc.tot-fact, 2) = &1)", parsum)
    18914     ,input "open"
    18915     ).
    18916   apply "entry":u to sch-sum in frame d-all-docs .
    18917   end procedure.
    18918   PROCEDURE set-filter-name :
    18919     define input parameter p-filter-name as character no-undo .
    18920     do with frame d-all-docs:
    18921       if p-filter-name > "" then do:
    18922         assign
    18923           frame d-all-docs:title
    18924             = frame d-all-docs:title + "   ФИЛЬТР: " + p-filter-name.
    18925         .
    18926         assign
    18927           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
    18928         .
    18929       end.
    18930       else do:
    18931         assign
    18932           b-sch :TOOLTIP = ""
    18933         .
    18934       end.
    18935     end.
    18936   END PROCEDURE.
    18937   procedure local-add:
    18938   define buffer bf_clients for ub.clients.
    18939   define buffer bf_sysconf for ub.sysconf.
    18940   define variable varis-active as logical   no-undo.
    18941   define variable v-dead-doc   as character no-undo initial no.
    18942   define variable v-type       as character no-undo initial ?.
    18943   define variable varno-change-cli-cntr as logical              no-undo.
    18944   define variable varcli-type           as character            no-undo.
    18945   define variable varcli-code           as integer              no-undo.
    18946   define variable varcontract-code      as integer              no-undo.
    18947   define variable varset-cli-contr      as logical              no-undo.
    18948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    18949     (input  'dead-doc'
    18950     ,input  ''
    18951     ,input  ''
    18952     ,input  0
    18953     ,input  ''
    18954     ,input  ''
    18955     ,input  ''
    18956     ,input  no
    18957     ,output v-dead-doc
    18958     ,output v-type
    18959     ) no-error .
    18960   if  error-status :error  = false then do:
    18961       if v-dead-doc = "yes"  then  do:
    18962         message "В системе установлен запрет на ввод документов!"
    18963         view-as alert-box error .
    18964         return error  .
    18965       end.
    18966   end.
    18967   if not vardoc-mode = 'КОПИРОВАНИЕ':U
    18968     then assign vardoc-mode = 'ДОБАВЛЕНИЕ':U.
    18969   if parinternal then do:
    18970     if partype = ? or partype = "?" then
    18971       partype = 'рас':U.
    18972     if partype = 'возврат':U then do:
    18973       message "Для внутреннего перемещения можно создать только расход."
    18974                       "Приход и возврат создаются автоматически.".
    18975       return error.
    18976     end.
    18977   end.
    18978   if parext-doc-type = 'io':U then do:
    18979     message "Для внутриобъектного перемещения можно создать только расход."
    18980                       "Приход создаётся автоматически."
    18981     view-as alert-box.
    18982     return error.
    18983   end.
    18984   if parext-doc-type = 'em':U     or
    18985      parext-doc-type = 'wm':U     or
    18986      parext-doc-type = 'im':U     then do:
    18987     message "Документ производство нельзя добавить из данного интерфейса." view-as alert-box.
    18988     return error.
    18989   end.
    18990   if parext-doc-type = 'es':U     or
    18991      parext-doc-type = 'rs':U then do:
    18992     message "Складские документы 'продажа-возврат по кассе' генерятся автоматически из документов продажи."
    18993     view-as alert-box.
    18994     return error.
    18995   end.
    18996   if parext-doc-type = 'pc':U then do:
    18997     message "Документ коррекциии типа приобретения генерится автоматически при реализации товара."
    18998     view-as alert-box.
    18999     return error.
    19000   end.
    19001   if parext-doc-type = 'mp':U then do:
    19002     message "Документ корректировки отрицательных партий генерится автоматически при приходе товара от поставщика."
