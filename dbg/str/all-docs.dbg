        1   define input  parameter parparentproc   as   handle               no-undo.
        2   define input  parameter par-host-code   as   integer     no-undo .
        3   define input  parameter par-obj-type    as   character no-undo .
        4   define input  parameter par-obj-code    as   integer   no-undo .
        5   define input  parameter parlist-mode    as   character            no-undo.
        6   define input  parameter parstat         as   character            no-undo.
        7   define input  parameter partype         as   character            no-undo.
        8   define input  parameter parflag         as   logical              no-undo.
        9   define input  parameter parinternal     as   logical              no-undo.
       10   define input  parameter bttns           as   character            no-undo.
       11   define input  parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
       12   define input  parameter paris-hold      as   logical              no-undo.
       13   define input  parameter pardoc-rec      as   recid                no-undo.
       14   define output parameter mark-list       as   character            no-undo.
       15   define variable vss-revision    as character no-undo initial "$Revision: 6298093c26d2, 2419, rls $":U .
       16   define variable vss-author      as character no-undo initial "$Author: druban $":U .
       17   define variable vss-date        as character no-undo initial "$Date: Ср июн 10 21:13:46 2020 +0300 $":U .
       18   define variable vss-workfile    as character no-undo initial "$Workfile: all-docs.w $":U .
       19   define variable vss-archive     as character no-undo initial "$Archive: str/all-docs.w $":U .
       20   define variable vss-description as character no-undo initial "Список документов":U .
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39       assign
       40         p-vss-parameters = substitute('&1|&2',bttns,parext-doc-type)
       41       .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      125   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      126   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      127   define variable gp-excise     like ub.price-list.excise     no-undo.
      128   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      129   define variable gp-fact-order as decimal   no-undo .
      130   define variable gp-price-sale-parts as decimal   no-undo .
      131   define new global shared variable g#language as character no-undo .
      132   if g#language <> '' and g#language <> 'rus':U then do:
      133     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      134   end.
      135   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure gen-key-rec :
      137     define input  parameter p-tbl-name    as character no-undo.
      138     define input  parameter p-bh_tbl-name as handle    no-undo.
      139     define output parameter p-key-rec     as character no-undo.
      140     do
      141     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      142     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      143     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      144     :
      145       define variable fh               as handle    no-undo .
      146       define variable v-ok             as logical   no-undo .
      147       define variable v-inform         as character no-undo .
      148       define variable v-ind            as integer   no-undo .
      149       define variable v-idx-field-qnty as integer   no-undo .
      150       if p-tbl-name = ?
      151         or p-tbl-name = "":U
      152       then do:
      153         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      154       end.
      155       if not p-bh_tbl-name:available then do:
      156         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      157       end.
      158       assign
      159         p-key-rec = p-tbl-name
      160         v-inform  = p-bh_tbl-name:index-information(1)
      161         v-ind     = 2
      162       .
      163       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      164       on error undo, return error
      165       :
      166         assign
      167           v-inform = p-bh_tbl-name:index-information( v-ind )
      168           v-ind    = v-ind + 1
      169         .
      170       end.
      171       if v-inform = ?
      172         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      173         or entry( 3, v-inform, ",":U ) <> "1":U
      174       then do:
      175         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      176       end.
      177       else do:
      178         assign
      179           v-idx-field-qnty = num-entries( v-inform ) - 4
      180         .
      181         if v-idx-field-qnty < 2 then do:
      182           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      183         end.
      184         do v-ind = 1 to v-idx-field-qnty by 2
      185         on error undo, return error
      186         :
      187           assign
      188             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      189             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      190           .
      191         end.
      192       end.
      193       if p-key-rec = ? then do:
      194         assign
      195           p-key-rec = "":U
      196         .
      197         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      198       end.
      199     end.
      200     return.
      201   end procedure.
      202   procedure gen-where-keyr-tab :
      203     define input  parameter i-tableSerach as character no-undo.
      204     define input  parameter i-tablekey   as character  no-undo.
      205     define input  parameter p-key-rec    as character  no-undo.
      206     define input  parameter p-key-handle as handle     no-undo .
      207     define input  parameter p-db-name    as character  no-undo .
      208     define input  parameter p-tt-handle  as handle     no-undo .
      209     define output parameter o-Where      as character  no-undo.
      210     do
      211     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      212     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      213     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      214     :
      215       define variable v-full-tbl-name  as character no-undo .
      216       define variable bh_tbl-name      as handle    no-undo .
      217       define variable fh_key           as handle    no-undo .
      218       define variable fh_search        as handle    no-undo .
      219       define variable v-field-num      as integer   no-undo .
      220       define variable v-count-fld      as integer   no-undo .
      221       define variable v-inform         as character no-undo .
      222       define variable v-ind            as integer   no-undo .
      223       define variable v-idx-field-qnty as integer   no-undo .
      224       define variable v-field-name     as character no-undo .
      225       define variable v-field-val      as character no-undo .
      226       define variable v-word-link      as character no-undo .
      227       define variable vTable           as character no-undo.
      228       define variable bh_tbl-key       as handle    no-undo .
      229       assign
      230         p-key-rec = trim( p-key-rec )
      231       .
      232       if p-key-handle <> ? then do:
      233         if not valid-handle(p-key-handle)
      234            or p-key-handle:type <> "buffer"
      235         then do:
      236           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      237         end.
      238         if num-entries( p-key-rec, chr(3) ) > 1
      239           or p-key-rec = ?
      240           or p-key-rec = "":U
      241         then do:
      242           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      243         end.
      244       end.
      245       else do:
      246         if p-key-rec = ?
      247           or p-key-rec = "":U
      248         then do:
      249           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      250         end.
      251       end.
      252       assign
      253         vTable = entry( 1 , p-key-rec, chr(3) )
      254       .
      255       if p-tt-handle <> ?
      256         and ( not valid-handle(p-tt-handle)
      257               or p-tt-handle:type <> "buffer"
      258             )
      259       then do:
      260         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      261       end.
      262       if p-tt-handle = ? then do:
      263         assign
      264           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      265         .
      266         create buffer bh_tbl-name for table v-full-tbl-name .
      267       end.
      268       else do:
      269         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      270       end.
      271       assign
      272         v-inform = bh_tbl-name:index-information(1)
      273         v-ind    = 2
      274       .
      275       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      276       on error undo, return error
      277       :
      278         assign
      279           v-inform = bh_tbl-name:index-information( v-ind )
      280           v-ind    = v-ind + 1
      281         .
      282       end.
      283       if v-inform = ?
      284         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      285         or entry( 3, v-inform, ",":U ) <> "1":U
      286       then do:
      287         delete object bh_tbl-name no-error.
      288         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      289       end.
      290       assign
      291         v-idx-field-qnty = num-entries( v-inform ) - 4
      292       .
      293       if v-idx-field-qnty < 2 then do:
      294         delete object bh_tbl-name no-error.
      295         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      296       end.
      297       assign
      298         o-where     = "where":U
      299         v-word-link = "":U
      300         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      301         v-count-fld = 0
      302       .
      303       if i-tablekey ne "" and i-tablekey ne ?
      304       then do:
      305         assign
      306           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      307         .
      308         create buffer bh_tbl-key for table v-full-tbl-name .
      309       end.
      310       if i-tableSerach ne "" and i-tableSerach ne ?
      311       then do:
      312         delete object bh_tbl-name no-error.
      313         assign
      314           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      315         .
      316         create buffer bh_tbl-name for table v-full-tbl-name .
      317       end.
      318       block_where:
      319       do v-ind = 1 to v-idx-field-qnty by 2
      320       on error undo, return error
      321       :
      322         assign
      323           v-count-fld = v-count-fld + 1
      324         .
      325         if p-key-handle = ?
      326           and v-count-fld > v-field-num
      327         then do:
      328           leave block_where.
      329         end.
      330         define variable VfieldKeyTable as handle no-undo.
      331         assign
      332           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      333           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      334         .
      335         if     bh_tbl-key ne ?
      336         then do:
      337            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      338            if VfieldKeyTable eq ?
      339            then next block_where.
      340         end.
      341         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      342         then
      343            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      344         else
      345            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      346         if p-key-handle = ? then do:
      347           assign
      348             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      349           .
      350         end.
      351         else do:
      352           assign
      353             fh_key = p-key-handle:buffer-field( v-field-name )
      354           .
      355           if fh_key = ?
      356             or not valid-handle( fh_key )
      357           then do:
      358             delete object bh_tbl-name.
      359             if     bh_tbl-key ne ?
      360             then
      361                delete object bh_tbl-key.
      362             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      363           end.
      364           assign
      365             v-field-val = fh_key:buffer-value
      366           .
      367         end.
      368         if fh_search:data-type ="character":U then do:
      369           assign
      370             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      371             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      372             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      373             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      374             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      375             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      376             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      377             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      378             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      379             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      380             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      381             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      382             v-field-val = substitute( '"&1"', v-field-val )
      383           .
      384         end.
      385         assign
      386           o-where = substitute( "&1 &2", o-where, v-field-val )
      387         .
      388         if v-word-link = "":U then do:
      389           assign
      390             v-word-link = "and":U
      391           .
      392         end.
      393       end.
      394       delete object bh_tbl-name.
      395       if     bh_tbl-key ne ?
      396       then
      397          delete object bh_tbl-key.
      398       if p-key-handle = ?
      399         and v-count-fld <> v-field-num
      400       then do:
      401         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      402       end.
      403     end.
      404   end procedure.
      405   procedure gen-hn-keyr-tab :
      406     define input  parameter i-tableSerach as character no-undo.
      407     define input  parameter i-tablekey   as character no-undo.
      408     define input  parameter p-key-rec    as character no-undo.
      409     define input  parameter p-key-handle as handle    no-undo .
      410     define input  parameter p-db-name    as character no-undo .
      411     define input  parameter p-tt-handle  as handle    no-undo .
      412     define input  parameter p-stts-lock  as integer   no-undo .
      413     define output parameter o-hn         as handle    no-undo.
      414     define variable v-full-tbl-name as character no-undo.
      415     define variable v-where         as character no-undo.
      416     define variable bh_tbl-name     as handle    no-undo.
      417     define variable vTable          as character no-undo.
      418     do
      419     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      420     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      421     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      422         run gen-where-keyr-tab(i-tableSerach,
      423                                i-tablekey,
      424                                p-key-rec,
      425                                p-key-handle,
      426                                p-db-name,
      427                                p-tt-handle,
      428                                output v-where).
      429         if i-tableSerach ne "" and i-tableSerach ne ?
      430         then do:
      431            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      432            create buffer bh_tbl-name for table v-full-tbl-name .
      433         end.
      434         else do:
      435            if p-tt-handle = ? then do:
      436               assign
      437                  vTable = entry( 1 , p-key-rec, chr(3) )
      438               .
      439               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      440               create buffer bh_tbl-name for table v-full-tbl-name .
      441            end.
      442            else do:
      443               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      444            end.
      445         end.
      446         if p-tt-handle = ? then do:
      447            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      448         end.
      449         else do:
      450            bh_tbl-name:find-first( v-where ) no-error .
      451         end.
      452         o-hn = bh_tbl-name.
      453      end.
      454   end procedure.
      455   procedure gen-hn-keyr :
      456     define input  parameter p-key-rec    as character no-undo.
      457     define input  parameter p-key-handle as handle    no-undo .
      458     define input  parameter p-db-name    as character no-undo .
      459     define input  parameter p-tt-handle  as handle    no-undo .
      460     define input  parameter p-stts-lock  as integer   no-undo .
      461     define output parameter o-hn         as handle    no-undo.
      462     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      463   end.
      464   procedure gen-row-keyr :
      465     define input  parameter p-key-rec    as character no-undo.
      466     define input  parameter p-key-handle as handle    no-undo .
      467     define input  parameter p-db-name    as character no-undo .
      468     define input  parameter p-tt-handle  as handle    no-undo .
      469     define input  parameter p-stts-lock  as integer   no-undo .
      470     define output parameter p-tbl-row    as rowid     no-undo.
      471     define output parameter p-tbl-name   as character no-undo.
      472     define variable vHn as handle no-undo.
      473       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      474       p-tbl-row = if vHn:available then vHn:rowid else ?.
      475       p-tbl-name =  vHn:table.
      476       delete object vHn no-error.
      477     if p-tbl-row = ? then do:
      478       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      479     end.
      480     else do:
      481       return.
      482     end.
      483   end procedure.
      484   procedure gen-key-fv :
      485     define input  parameter p-key-rec    as character no-undo .
      486     define output parameter p-field-list as character no-undo .
      487     define output parameter p-value-list as character no-undo.
      488     do
      489     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      490     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      491     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      492     :
      493       define variable v-full-tbl-name  as character no-undo .
      494       define variable bh_tbl-name      as handle    no-undo .
      495       define variable v-tbl-name       as character no-undo .
      496       define variable v-field-num      as integer   no-undo .
      497       define variable v-count-fld      as integer   no-undo .
      498       define variable v-inform         as character no-undo .
      499       define variable v-ind            as integer   no-undo .
      500       define variable v-idx-field-qnty as integer   no-undo .
      501       define variable v-delim-key      as character no-undo .
      502       if p-key-rec = ?
      503         or p-key-rec = "":U
      504       then do:
      505         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      506       end.
      507       assign
      508         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      509         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      510       .
      511       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      512       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      513       assign
      514         v-inform = bh_tbl-name:index-information(1)
      515         v-ind    = 2
      516       .
      517       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      518       on error undo, return error
      519       :
      520         assign
      521           v-inform = bh_tbl-name:index-information( v-ind )
      522           v-ind    = v-ind + 1
      523         .
      524       end.
      525       if v-inform = ?
      526         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      527         or entry( 3, v-inform, ",":U ) <> "1":U
      528       then do:
      529         delete object bh_tbl-name no-error.
      530         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      531       end.
      532       assign
      533         v-idx-field-qnty = num-entries( v-inform ) - 4
      534       .
      535       if v-idx-field-qnty < 2 then do:
      536         delete object bh_tbl-name no-error.
      537         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      538       end.
      539       assign
      540         p-field-list = "":U
      541         p-value-list = "":U
      542         v-delim-key  = "":U
      543         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      544         v-count-fld  = 0
      545       .
      546       block_where:
      547       do v-ind = 1 to v-idx-field-qnty by 2
      548       on error undo, return error
      549       :
      550         assign
      551           v-count-fld = v-count-fld + 1
      552         .
      553         if v-count-fld > v-field-num then do:
      554           leave block_where.
      555         end.
      556         assign
      557           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      558           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      559         .
      560         if v-ind = 1 then do:
      561           assign
      562             v-delim-key = chr(3)
      563           .
      564         end.
      565       end.
      566       delete object bh_tbl-name.
      567       if v-count-fld <> v-field-num then do:
      568         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      569       end.
      570     end.
      571   end procedure.
      572   procedure gen-key-field :
      573     define input  parameter p-table      as character no-undo .
      574     define output parameter p-field-list as character no-undo .
      575     do
      576     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      577     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      578     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      579     :
      580       define variable v-full-tbl-name  as character no-undo .
      581       define variable bh_tbl-name      as handle    no-undo .
      582       define variable v-tbl-name       as character no-undo .
      583       define variable v-field-num      as integer   no-undo .
      584       define variable v-count-fld      as integer   no-undo .
      585       define variable v-inform         as character no-undo .
      586       define variable v-ind            as integer   no-undo .
      587       define variable v-idx-field-qnty as integer   no-undo .
      588       define variable v-delim-key      as character no-undo .
      589       if p-table = ?
      590         or p-table = "":U
      591       then do:
      592         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      593       end.
      594       assign
      595         v-tbl-name      = p-table
      596         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      597       .
      598       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      599       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      600       assign
      601         v-inform = bh_tbl-name:index-information(1)
      602         v-ind    = 2
      603       .
      604       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      605       on error undo, return error
      606       :
      607         assign
      608           v-inform = bh_tbl-name:index-information( v-ind )
      609           v-ind    = v-ind + 1
      610         .
      611       end.
      612       if v-inform = ?
      613         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      614         or entry( 3, v-inform, ",":U ) <> "1":U
      615       then do:
      616         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      617       end.
      618       assign
      619         v-idx-field-qnty = num-entries( v-inform ) - 4
      620       .
      621       if v-idx-field-qnty < 2 then do:
      622         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      623       end.
      624       assign
      625         p-field-list = "":U
      626         v-delim-key  = "":U
      627         v-count-fld  = 0
      628       .
      629       block_where:
      630       do v-ind = 1 to v-idx-field-qnty by 2
      631       on error undo, return error
      632       :
      633         assign
      634           v-count-fld = v-count-fld + 1
      635         .
      636         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      637         if v-ind = 1 then do:
      638           assign
      639             v-delim-key = chr(3)
      640           .
      641         end.
      642       end.
      643       delete object bh_tbl-name.
      644     end.
      645   end procedure.
      646   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   procedure fltfield-clear :
      648     define output parameter loc-fld as character no-undo.
      649     define output parameter loc-lab as character no-undo .
      650     define output parameter loc-spr as character no-undo .
      651     define output parameter loc-dim as character no-undo .
      652     assign
      653       loc-fld = ""
      654       loc-lab = ""
      655       loc-spr = ""
      656       loc-dim = "0"
      657     .
      658   end procedure .
      659   procedure fltfield-add :
      660     define input        parameter par-fld as character no-undo.
      661     define input        parameter par-lab as character no-undo .
      662     define input        parameter par-spr as character no-undo .
      663     define input-output parameter loc-fld as character no-undo.
      664     define input-output parameter loc-lab as character no-undo .
      665     define input-output parameter loc-spr as character no-undo .
      666     define input-output parameter loc-dim as character no-undo .
      667     do
      668     on error undo, return error
      669     :
      670       assign
      671       loc-fld = if loc-dim = '0'
      672                 then par-fld
      673                 else (loc-fld + chr(44) + par-fld)
      674       loc-lab = if loc-dim = '0'
      675                 then par-lab
      676                 else (loc-lab + chr(44) + par-lab)
      677       loc-spr = if loc-dim = '0'
      678                 then par-spr
      679                 else (loc-spr + chr(44) + par-spr)
      680       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      681                 string(integer(if num-entries(loc-dim) > 1
      682                               then entry(2, loc-dim)
      683                               else entry(1, loc-dim)
      684                               ) + 1)
      685       no-error
      686       .
      687     end.
      688   end procedure.
      689     define temp-table  tt-tax no-undo
      690   field tax-code    like ub.tax.tax-code
      691   FIELD individual  like ub.tax.individual
      692   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      693   field rate-code   like ub.tax-rate.rate-code
      694   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      695   FIELD tax-type    like ub.tax.tax-type
      696   field rate-value  like ub.tax-rate-value.rate-value
      697   FIELD tax-rate-gds-rc  as recid
      698   FIELD to-cashdesk like ub.tax.to-cashdesk
      699   index tax-code is unique primary tax-code.
      700   define new global shared variable g#library  as handle no-undo .
      701   define new global shared variable g#library2 as handle no-undo .
      702   define new global shared variable g#lib-trn  as handle no-undo .
      703   define new global shared variable g#lib-trn2 as handle no-undo .
      704   define new global shared variable g#lib-trn3 as handle no-undo .
      705   define new global shared variable g#lib-trn4 as handle no-undo .
      706   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      708   procedure partslib-clear-temp-parts :
      709     define buffer buf_temp-parts for temp-parts .
      710     do
      711     on error undo, return error
      712     :
      713       for each buf_temp-parts
      714       on error undo, return error
      715       :
      716         delete buf_temp-parts .
      717       end.
      718     end.
      719   end procedure.
      720   procedure partslib-create-temp-parts :
      721     define parameter buffer buf_parts       for ub.parts .
      722     define parameter buffer buf_temp-parts  for temp-parts .
      723     define input  parameter p-goods-twounit as logical   no-undo .
      724     define variable v-base-part-code as character no-undo .
      725     do
      726     on error undo, return error
      727     :
      728       if p-goods-twounit = true
      729       then do:
      730         assign
      731           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      732         .
      733       end.
      734       else do:
      735         assign
      736           v-base-part-code = buf_parts.part-code
      737         .
      738       end.
      739       find first buf_temp-parts exclusive-lock
      740         where buf_temp-parts.obj-type  = buf_parts.obj-type
      741           and buf_temp-parts.obj-code  = buf_parts.obj-code
      742           and buf_temp-parts.artic     = buf_parts.artic
      743           and buf_temp-parts.prod-type = buf_parts.prod-type
      744           and buf_temp-parts.prod-code = buf_parts.prod-code
      745           and buf_temp-parts.in-code   = buf_parts.in-code
      746           and buf_temp-parts.out-code  = 'free-zone':U
      747           and buf_temp-parts.part-code = v-base-part-code
      748         no-error.
      749       if not available buf_temp-parts
      750       then do:
      751         create buf_temp-parts .
      752         buffer-copy buf_parts to buf_temp-parts
      753         assign
      754           buf_temp-parts.out-code  = 'free-zone':U
      755           buf_temp-parts.part-code = v-base-part-code
      756           buf_temp-parts.rsrv-free = yes
      757           buf_temp-parts.status_   = no
      758           buf_temp-parts.qnty      = 0
      759           buf_temp-parts.fact-qnty = 0
      760           buf_temp-parts.real-qnty = 0
      761           buf_temp-parts.cli-qnty  = 0
      762         .
      763       end.
      764     end.
      765   end procedure.
      766   procedure partslib-init-temp-parts :
      767     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      768     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      769     define input parameter p-artic           like ub.parts.artic     no-undo .
      770     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      771     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      772     define buffer buf_parts      for ub.parts .
      773     define buffer buf_temp-parts for temp-parts .
      774     define variable v-goods-twounit    as logical   no-undo .
      775     do
      776     on error undo, return error
      777     :
      778   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      780     (input  p-artic
      781     ,input  p-prod-type
      782     ,input  p-prod-code
      783     ,input  'twounit=request':u
      784     ,output v-goods-twounit
      785     ) no-error .
      786       if error-status :error
      787       then do:
      788         message
      789           vss-workfile vss-revision vss-description skip
      790           vss-include-info3 skip
      791           "Ошибка при определении атрибута товара" skip
      792           "Артикул" p-artic p-prod-type p-prod-code skip
      793           "twounit=request" skip
      794           error-status :get-message(1) skip
      795           return-value skip
      796           view-as alert-box error .
      797         undo, return error return-value .
      798       end.
      799       run partslib-clear-temp-parts in this-procedure .
      800       for each buf_parts
      801         where buf_parts.obj-type  = p-obj-type
      802           and buf_parts.obj-code  = p-obj-code
      803           and buf_parts.artic     = p-artic
      804           and buf_parts.prod-type = p-prod-type
      805           and buf_parts.prod-code = p-prod-code
      806           and buf_parts.rsrv-free = yes
      807           and buf_parts.status_   = no
      808           and buf_parts.in-code   <> buf_parts.out-code
      809       on error undo, return error
      810       :
      811         run partslib-create-temp-parts in this-procedure
      812           (buffer buf_parts
      813           ,buffer buf_temp-parts
      814           ,input  v-goods-twounit
      815           ) .
      816         define variable v-parts-qnty          as decimal   no-undo .
      817         define variable v-parts-cli-qnty      as decimal   no-undo .
      818         define variable v-parts-free-qnty     as decimal   no-undo .
      819         define variable v-parts-free-cli-qnty as decimal   no-undo .
      820         if buf_parts.out-code = 'free-zone':U
      821         then do:
      822           assign
      823             v-parts-qnty          = buf_parts.qnty
      824             v-parts-cli-qnty      = buf_parts.cli-qnty
      825             v-parts-free-qnty     = buf_parts.qnty
      826             v-parts-free-cli-qnty = buf_parts.cli-qnty
      827           .
      828         end.
      829         else do:
      830           assign
      831             v-parts-qnty          = abs(buf_parts.qnty)
      832             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      833             v-parts-free-qnty     = 0
      834             v-parts-free-cli-qnty = 0
      835           .
      836         end.
      837         assign
      838           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      839           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      840           buf_temp-parts.real-qnty     = 0
      841           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      842           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      843           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      844         .
      845       end.
      846     end.
      847   end procedure.
      848   procedure partslib-init-temp-parts-by-factord :
      849     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      850     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      851     define input parameter p-artic              like ub.parts.artic     no-undo .
      852     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      853     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      854     define input parameter p-fact-order         as decimal   no-undo .
      855     define input parameter p-include-fact-order as logical   no-undo .
      856     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      857     define buffer buf_gds-obj  for ub.gds-obj .
      858     do
      859     on error undo, return error
      860     :
      861       do transaction
      862       on error undo, return error
      863       :
      864   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      866     (input  p-obj-type
      867     ,input  p-obj-code
      868     ,input  p-artic
      869     ,input  p-prod-type
      870     ,input  p-prod-code
      871     ,buffer buf_gds-obj
      872     ) no-error .
      873         if error-status :error
      874         then do:
      875           message
      876             vss-workfile vss-revision vss-description skip
      877             vss-include-info3 skip
      878             "Невозможно найти товар на объекте" skip
      879             "Объект" p-obj-type p-obj-code skip
      880             "Артикул" p-artic p-prod-type p-prod-code skip
      881             error-status :get-message(1) skip
      882             return-value skip
      883             view-as alert-box error .
      884           undo, return error .
      885         end.
      886         find current buf_gds-obj exclusive-lock .
      887       end.
      888       run partslib-init-temp-parts in this-procedure
      889         (input p-obj-type
      890         ,input p-obj-code
      891         ,input p-artic
      892         ,input p-prod-type
      893         ,input p-prod-code
      894         ) no-error .
      895       if error-status :error
      896       then do:
      897         message
      898           vss-workfile vss-revision vss-description skip
      899           vss-include-info3 skip
      900           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      901           "Объект" p-obj-type p-obj-code skip
      902           "Артикул" p-artic p-prod-type p-prod-code skip
      903           "p-fact-order" p-fact-order skip
      904           view-as alert-box error .
      905         undo, return error .
      906       end.
      907       if p-include-fact-order = true
      908       then do:
      909         assign
      910           p-fact-order = p-fact-order - 0.0000000001
      911         .
      912       end.
      913       define variable v-max-fact-order as character no-undo .
      914       run factord-max-fact-order in this-procedure
      915         (output v-max-fact-order
      916         ) no-error .
      917       if error-status :error
      918       then do:
      919         message
      920           vss-workfile vss-revision vss-description skip
      921           vss-include-info3 skip
      922           "Ошибка при вызове процедуры factord-max-fact-order" skip
      923           "Объект" p-obj-type p-obj-code skip
      924           "Артикул" p-artic p-prod-type p-prod-code skip
      925           "p-fact-order" p-fact-order skip
      926           view-as alert-box error .
      927         undo, return error .
      928       end.
      929       run partslib-update-by-factord in this-procedure
      930         (input p-obj-type
      931         ,input p-obj-code
      932         ,input p-artic
      933         ,input p-prod-type
      934         ,input p-prod-code
      935         ,input p-fact-order
      936         ,input v-max-fact-order
      937         ,input false
      938         ) no-error .
      939       if error-status :error
      940       then do:
      941         message
      942           vss-workfile vss-revision vss-description skip
      943           vss-include-info3 skip
      944           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      945           "Объект" p-obj-type p-obj-code skip
      946           "Артикул" p-artic p-prod-type p-prod-code skip
      947           "p-fact-order" p-fact-order skip
      948           "v-max-fact-order" v-max-fact-order skip
      949           view-as alert-box error .
      950         undo, return error .
      951       end.
      952     end.
      953   end procedure.
      954   procedure partslib-update-by-factord :
      955     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      956     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      957     define input parameter p-artic              like ub.parts.artic     no-undo .
      958     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      959     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      960     define input parameter p-start-fact-order   as decimal   no-undo .
      961     define input parameter p-end-fact-order     as decimal   no-undo .
      962     define input parameter p-lock-gds-obj       as logical   no-undo .
      963     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      964     define buffer buf_gds-obj  for ub.gds-obj .
      965     define buffer buf_doc-line for ub.doc-line .
      966     define variable v-total-parts-qnty as decimal   no-undo .
      967     define variable v-goods-gds-goods  as logical   no-undo .
      968     define variable v-goods-twounit    as logical   no-undo .
      969     do
      970     on error undo, return error
      971     :
      972       if p-start-fact-order > p-end-fact-order
      973       then do:
      974         message
      975           vss-workfile vss-revision vss-description skip
      976           vss-include-info3 skip
      977           "Ошибка задания входных параметров" skip
      978           "Начало интервала превышает конец интервала" skip
      979           "Объект" p-obj-type p-obj-code skip
      980           "Артикул" p-artic p-prod-type p-prod-code skip
      981           "p-start-fact-order" p-start-fact-order skip
      982           "p-end-fact-order"   p-end-fact-order skip
      983           view-as alert-box error .
      984         undo, return error .
      985       end.
      986       if p-lock-gds-obj = true
      987       then do:
      988         do transaction
      989         on error undo, return error
      990         :
      991   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      993     (input  p-obj-type
      994     ,input  p-obj-code
      995     ,input  p-artic
      996     ,input  p-prod-type
      997     ,input  p-prod-code
      998     ,buffer buf_gds-obj
      999     ) no-error .
     1000           if error-status :error
     1001           then do:
     1002             message
     1003               vss-workfile vss-revision vss-description skip
     1004               vss-include-info3 skip
     1005               "Невозможно найти gds-obj" skip
     1006               error-status :get-message(1) skip
     1007               return-value skip
     1008               view-as alert-box error .
     1009             undo, return error .
     1010           end.
     1011           find current buf_gds-obj exclusive-lock .
     1012         end.
     1013       end.
     1014   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1016     (input  p-artic
     1017     ,input  p-prod-type
     1018     ,input  p-prod-code
     1019     ,input  'gds-goods=request':u
     1020     ,output v-goods-gds-goods
     1021     ) no-error .
     1022       if error-status :error
     1023       then do:
     1024         message
     1025           vss-workfile vss-revision vss-description skip
     1026           vss-include-info3 skip
     1027           "Ошибка при определении атрибута товара" skip
     1028           "Артикул" p-artic p-prod-type p-prod-code skip
     1029           "gds-goods=request" skip
     1030           error-status :get-message(1) skip
     1031           return-value skip
     1032           view-as alert-box error .
     1033         undo, return error return-value .
     1034       end.
     1035   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1037     (input  p-artic
     1038     ,input  p-prod-type
     1039     ,input  p-prod-code
     1040     ,input  'twounit=request':u
     1041     ,output v-goods-twounit
     1042     ) no-error .
     1043       if error-status :error
     1044       then do:
     1045         message
     1046           vss-workfile vss-revision vss-description skip
     1047           vss-include-info3 skip
     1048           "Ошибка при определении атрибута товара" skip
     1049           "Артикул" p-artic p-prod-type p-prod-code skip
     1050           "twounit=request" skip
     1051           error-status :get-message(1) skip
     1052           return-value skip
     1053           view-as alert-box error .
     1054         undo, return error return-value .
     1055       end.
     1056       for each buf_doc-line no-lock
     1057         where buf_doc-line.obj-type   = p-obj-type
     1058           and buf_doc-line.obj-code   = p-obj-code
     1059           and buf_doc-line.artic      = p-artic
     1060           and buf_doc-line.prod-type  = p-prod-type
     1061           and buf_doc-line.prod-code  = p-prod-code
     1062           and buf_doc-line.status_    = 'факт':U
     1063           and buf_doc-line.fact-order > p-start-fact-order
     1064           and buf_doc-line.fact-order <= p-end-fact-order
     1065       on error undo, return error
     1066       :
     1067         run partslib-process-document in this-procedure
     1068           (input  buf_doc-line.doc-code
     1069           ,input  p-obj-type
     1070           ,input  p-obj-code
     1071           ,input  p-artic
     1072           ,input  p-prod-type
     1073           ,input  p-prod-code
     1074           ,input  v-goods-gds-goods
     1075           ,input  v-goods-twounit
     1076           ,output v-total-parts-qnty
     1077           ) no-error .
     1078         if error-status :error
     1079         then do:
     1080           message
     1081             vss-workfile vss-revision vss-description skip
     1082             vss-include-info3 skip
     1083             "Ошибка при вызове процедуры partslib-process-document" skip
     1084             "Документ" buf_doc-line.doc-code skip
     1085             "Объект" p-obj-type p-obj-code skip
     1086             "Артикул" p-artic p-prod-type p-prod-code skip
     1087             "p-start-fact-order" p-start-fact-order skip
     1088             "p-end-fact-order" p-end-fact-order skip
     1089             error-status :get-message(1) skip
     1090             return-value skip
     1091             view-as alert-box error .
     1092           undo, return error return-value .
     1093         end.
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure partslib-process-document :
     1098     define input  parameter p-doc-code         as character no-undo .
     1099     define input  parameter p-obj-type         as character no-undo .
     1100     define input  parameter p-obj-code         as integer   no-undo .
     1101     define input  parameter p-artic            as character no-undo .
     1102     define input  parameter p-prod-type        as character no-undo .
     1103     define input  parameter p-prod-code        as integer   no-undo .
     1104     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1105     define input  parameter p-goods-twounit    as logical   no-undo .
     1106     define output parameter p-total-parts-qnty as decimal   no-undo .
     1107     define variable v-parts-sign as integer   no-undo .
     1108     define buffer buf_trn-doc    for ub.trn-doc .
     1109     define buffer buf_doc-line   for ub.doc-line .
     1110     define buffer buf_parts      for ub.parts .
     1111     define buffer buf_temp-parts for temp-parts .
     1112     do
     1113     on error undo, return error return-value
     1114     :
     1115       find first buf_trn-doc no-lock
     1116         where buf_trn-doc.doc-code = p-doc-code
     1117         no-error .
     1118       if not available buf_trn-doc
     1119       then do:
     1120         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1121                                      ,p-doc-code
     1122                                      ) .
     1123       end.
     1124       case buf_trn-doc.doc-type
     1125       :
     1126         when 'при':U or
     1127         when 'возврат':U or
     1128         when 'инв':U
     1129         then do:
     1130           assign
     1131             v-parts-sign = -1
     1132           .
     1133         end.
     1134         when 'рас':U or
     1135         when 'спи':U
     1136         then do:
     1137           assign
     1138             v-parts-sign = 1
     1139           .
     1140         end.
     1141         otherwise do:
     1142           undo, return error substitute("Неизвестный тип документа &1"
     1143                                       ,buf_trn-doc.doc-type
     1144                                       ) .
     1145         end.
     1146       end.
     1147       find first buf_doc-line no-lock
     1148         where buf_doc-line.doc-code  = p-doc-code
     1149           and buf_doc-line.artic     = p-artic
     1150           and buf_doc-line.prod-type = p-prod-type
     1151           and buf_doc-line.prod-code = p-prod-code
     1152         no-error .
     1153       if not available buf_doc-line
     1154       then do:
     1155         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1156                                      ,p-doc-code
     1157                                      ,artic
     1158                                      ,prod-type
     1159                                      ,prod-code
     1160                                      ) .
     1161       end.
     1162       assign
     1163         p-total-parts-qnty = 0
     1164       .
     1165       if p-goods-gds-goods = true
     1166       then do:
     1167         for each buf_parts no-lock
     1168           where buf_parts.out-code  = p-doc-code
     1169             and buf_parts.obj-type  = p-obj-type
     1170             and buf_parts.obj-code  = p-obj-code
     1171             and buf_parts.artic     = p-artic
     1172             and buf_parts.prod-type = p-prod-type
     1173             and buf_parts.prod-code = p-prod-code
     1174         on error undo, return error
     1175         :
     1176           run partslib-create-temp-parts in this-procedure
     1177             (buffer buf_parts
     1178             ,buffer buf_temp-parts
     1179             ,input  p-goods-twounit
     1180             ) .
     1181           assign
     1182             p-total-parts-qnty        = p-total-parts-qnty
     1183                                       + v-parts-sign * buf_parts.fact-qnty
     1184             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1185                                       + v-parts-sign * buf_parts.fact-qnty
     1186             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1187                                       + v-parts-sign * buf_parts.fact-qnty
     1188             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1189                                       + v-parts-sign * buf_parts.cli-qnty
     1190           .
     1191           if buf_temp-parts.qnty = 0
     1192           then do:
     1193             delete buf_temp-parts .
     1194           end.
     1195         end.
     1196       end.
     1197       else do:
     1198         assign
     1199           p-total-parts-qnty = p-total-parts-qnty
     1200                              + v-parts-sign * buf_doc-line.fact-qnty
     1201         .
     1202       end.
     1203     end.
     1204   end procedure.
     1205   procedure partslib-init-temp-parts-by-date :
     1206     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1207     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1208     define input parameter p-artic           like ub.parts.artic     no-undo .
     1209     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1210     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1211     define input parameter p-fact-date       as date      no-undo .
     1212     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1213     do
     1214     on error undo, return error
     1215     :
     1216       define variable v-fact-order                as decimal   no-undo .
     1217       define variable v-shift-end-fact-order      as decimal   no-undo .
     1218       define variable v-day-end-fact-order        as decimal   no-undo .
     1219       run factord in this-procedure
     1220         (input  p-fact-date
     1221         ,input  1
     1222         ,input  1
     1223         ,input  ?
     1224         ,input  0
     1225         ,input  false
     1226         ,output v-fact-order
     1227         ,output v-shift-end-fact-order
     1228         ,output v-day-end-fact-order
     1229         ) no-error .
     1230       if error-status :error
     1231       then do:
     1232         message
     1233           vss-workfile vss-revision vss-description skip
     1234           vss-include-info3 skip
     1235           "Ошибка при определении момента времени, на который требуется остаток" skip
     1236           "Объект" p-obj-type p-obj-code skip
     1237           "Артикул" p-artic p-prod-type p-prod-code skip
     1238           "Дата" p-fact-date skip
     1239           view-as alert-box error .
     1240         undo, return error .
     1241       end.
     1242       run partslib-init-temp-parts-by-factord in this-procedure
     1243         (input p-obj-type
     1244         ,input p-obj-code
     1245         ,input p-artic
     1246         ,input p-prod-type
     1247         ,input p-prod-code
     1248         ,input v-day-end-fact-order
     1249         ,input false
     1250         ) no-error .
     1251       if error-status :error
     1252       then do:
     1253         message
     1254           vss-workfile vss-revision vss-description skip
     1255           vss-include-info3 skip
     1256           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1257           "Объект" p-obj-type p-obj-code skip
     1258           "Артикул" p-artic p-prod-type p-prod-code skip
     1259           "Дата" p-fact-date skip
     1260           view-as alert-box error .
     1261         undo, return error .
     1262       end.
     1263     end.
     1264   end procedure.
     1265   procedure partslib-calc-cost :
     1266     define output parameter p-fact-qnty      as decimal   no-undo .
     1267     define output parameter p-vat-pc         as decimal   no-undo .
     1268     define output parameter p-slt-pc         as decimal   no-undo .
     1269     define output parameter p-sum-base       as decimal   no-undo .
     1270     define output parameter p-sum-rubl       as decimal   no-undo .
     1271     define output parameter p-vat-base       as decimal   no-undo .
     1272     define output parameter p-vat-rubl       as decimal   no-undo .
     1273     define output parameter p-slt-base       as decimal   no-undo .
     1274     define output parameter p-slt-rubl       as decimal   no-undo .
     1275     define output parameter p-road-tax-base  as decimal   no-undo .
     1276     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1277     define output parameter p-transport-base as decimal   no-undo .
     1278     define output parameter p-transport-rubl as decimal   no-undo .
     1279     define output parameter p-other-base     as decimal   no-undo .
     1280     define output parameter p-other-rubl     as decimal   no-undo .
     1281     define output parameter p-excise-base    as decimal   no-undo .
     1282     define output parameter p-excise-rubl    as decimal   no-undo .
     1283     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1284     do
     1285     on error undo, return error return-value
     1286     :
     1287       define buffer buf_temp-parts for temp-parts .
     1288       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1289       define buffer   in-vatp-parts    for ub.parts   .
     1290       define buffer   in-vatp-doc      for ub.trn-doc .
     1291       define buffer   in-vatp-goods    for ub.goods   .
     1292       define buffer   in-vatp-sysconf  for ub.sysconf .
     1293       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1294       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1295       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1296       define variable varinvprb                  as   character              no-undo.
     1297       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1298       define variable cli-base-rate              as   decimal                no-undo.
     1299       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1300       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1301       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1302       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1303       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1304       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1305       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1306       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1307       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1308       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1309       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1310       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1311       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1312       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1313       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1314       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1315       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1316       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1317       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1318       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1319       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1320       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1321       define variable varinvatp-envd             as   character              no-undo.
     1322       define variable varinvatp-type             as   character              no-undo.
     1323       for each buf_temp-parts
     1324       on error undo, return error
     1325       :
     1326   assign
     1327     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1328     price-base-with-tax-loc = buf_temp-parts.price-base
     1329   .
     1330   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1332     (output varinvprb
     1333     )  .
     1334     if buf_temp-parts.out-code = 'free-zone':U     or
     1335        buf_temp-parts.out-code = 'out-zone':U   or
     1336        buf_temp-parts.doc-type = 'акт':U then do:
     1337       assign
     1338         in-vatp-have-vat-slt = yes.
     1339     end.
     1340     else do:
     1341       find first in-vatp_doc-attr no-lock
     1342         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1343           and in-vatp_doc-attr.attr-code = 'envd':U
     1344         no-error .
     1345       if not available in-vatp_doc-attr then do:
     1346         assign
     1347           in-vatp-have-vat-slt = yes.
     1348       end.
     1349       else do:
     1350            in-vatp-have-vat-slt = no.
     1351       end.
     1352     end.
     1353     assign
     1354      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1355      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1356     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1357              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1358     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1359             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1360             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1361             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1362             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1363             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1364             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1365       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1366     assign
     1367       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1368     assign
     1369       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1370       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1371       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1372       transport-cli-loc  = 0
     1373       other-cli-loc      = 0
     1374     .
     1375   ASSIGN
     1376             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1377       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1378   .
     1379         assign
     1380           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1381           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1382           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1383           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1384           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1385           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1386           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1387           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1388           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1389           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1390           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1391           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1392           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1393           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1394           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1395           p-excise-base    = p-excise-base    + 0
     1396           p-excise-rubl    = p-excise-rubl    + 0
     1397         .
     1398       end.
     1399       if p-fact-qnty      = ?
     1400       or p-sum-base       = ?
     1401       or p-sum-rubl       = ?
     1402       or p-vat-base       = ?
     1403       or p-vat-rubl       = ?
     1404       or p-slt-base       = ?
     1405       or p-slt-rubl       = ?
     1406       or p-road-tax-base  = ?
     1407       or p-road-tax-rubl  = ?
     1408       or p-transport-base = ?
     1409       or p-transport-rubl = ?
     1410       or p-other-base     = ?
     1411       or p-other-rubl     = ?
     1412       or p-excise-base    = ?
     1413       or p-excise-rubl    = ?
     1414       then do:
     1415         message
     1416           vss-workfile vss-revision vss-description skip
     1417           vss-include-info3 skip
     1418           "Программа in-vatp.i вернула неопределенные значения" skip
     1419           "p-fact-qnty"      p-fact-qnty      skip
     1420           "p-sum-base"       p-sum-base       skip
     1421           "p-sum-rubl"       p-sum-rubl       skip
     1422           "p-vat-base"       p-vat-base       skip
     1423           "p-vat-rubl"       p-vat-rubl       skip
     1424           "p-slt-base"       p-slt-base       skip
     1425           "p-slt-rubl"       p-slt-rubl       skip
     1426           "p-road-tax-base"  p-road-tax-base  skip
     1427           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1428           "p-transport-base" p-transport-base skip
     1429           "p-transport-rubl" p-transport-rubl skip
     1430           "p-other-base"     p-other-base     skip
     1431           "p-other-rubl"     p-other-rubl     skip
     1432           "p-excise-base"    p-excise-base    skip
     1433           "p-excise-rubl"    p-excise-rubl    skip
     1434           view-as alert-box error .
     1435         undo, return error .
     1436       end.
     1437     end.
     1438   end procedure.
     1439   define new global shared variable g#libbcrcn as handle no-undo .
     1440   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1441   procedure doc-code:
     1442   define input  parameter parmode          as   character           no-undo.
     1443   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1444   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1445   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1446   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1447   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1448   define variable vardb-remote     as   logical             no-undo.
     1449   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1450   define variable v-delimiter as character no-undo .
     1451   do
     1452   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1453   :
     1454   find first buf_sys-ctrl no-lock .
     1455   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1456     CASE parmode:
     1457       when "main":u then do:
     1458         if vardb-remote then do:
     1459           assign
     1460             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1461         end.
     1462         else do:
     1463           assign
     1464             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1465         end.
     1466       end.
     1467       when "trio" then do:
     1468         assign
     1469           pardoc-code = replace (parroot-doc-code, "=", "*").
     1470       end.
     1471       otherwise do:
     1472         assign
     1473         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1474         no-error
     1475         .
     1476         if error-status:error  then do:
     1477           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1478                                         ,chr(10)
     1479                                         ,parmode
     1480                                         ).
     1481         end.
     1482         if num-entries(parmode) = 1
     1483         and parmode <> "chip":U
     1484         and parmode <> "chip_s":U
     1485         then do:
     1486           assign
     1487           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1488         end.
     1489         else if (lookup("chip":U, parmode) > 0
     1490                  or
     1491                  lookup("chip_s":U, parmode) > 0) then do:
     1492           assign
     1493             vartemp-doc-code = parroot-doc-code.
     1494           do while true:
     1495             if index (vartemp-doc-code , ".") = 0 then
     1496               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1497             else
     1498               vartemp-doc-code  =
     1499               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1500               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1501               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1502             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1503           end.
     1504           assign
     1505             pardoc-code = vartemp-doc-code.
     1506         end.
     1507       end.
     1508     end CASE.
     1509     if pardoc-code = '':U
     1510     or (parroot-doc-code <> '':U
     1511     and pardoc-code = parroot-doc-code) then do:
     1512       undo, return error substitute("Ошибка при генерации номера документа&1"
     1513                                     ,chr(10)).
     1514     end.
     1515   end.
     1516   end. // procedure/method
     1517   function get-doc-code-int64 returns int64
     1518     ( input p-doc-code as character ) :
     1519     define variable v-ind              as integer   no-undo .
     1520     define variable v-num-entries      as integer   no-undo .
     1521     define variable v-doc-code-int64   as int64     no-undo .
     1522     define variable v-canonic-doc-code as character no-undo .
     1523     assign
     1524       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1525       v-canonic-doc-code = p-doc-code
     1526     .
     1527     do v-ind = 1 to v-num-entries
     1528     :
     1529       assign
     1530         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1531       .
     1532     end.
     1533     assign
     1534       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1535     .
     1536     return v-doc-code-int64 .
     1537   end. // function/method
     1538   define new global shared variable g#lib-farh as handle no-undo .
     1539   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   define variable v-waitfram-action01         as character   no-undo .
     1541   define variable v-waitfram-action02         as character   no-undo .
     1542   define variable v-waitfram-action03         as character   no-undo .
     1543   define variable mWaitFramTextBeg            as character   no-undo.
     1544   define variable mWaitFramTextEnd            as character   no-undo.
     1545   define variable mWaitFramView               as logical     no-undo.
     1546   define variable mWaitProcEvent              as logical     no-undo init yes.
     1547   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1548   define variable mWaitFramStop               as logical     no-undo.
     1549   define variable mWaitFramStopUser           as logical     no-undo.
     1550   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1551   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1552   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1553   define button B-WaitFramStop auto-end-key
     1554        label "Стоп"
     1555        size 10 by 1 tooltip "Остоновить процесс".
     1556   define button B-viewProcInfo
     1557        label "Информация"
     1558        size 15 by 1 tooltip "Информация о процесс".
     1559   define frame waitfram
     1560     v-waitfram-action01 format "x(72)" no-label skip
     1561     v-waitfram-action02 format "x(72)" no-label skip
     1562     v-waitfram-action03 format "x(72)" no-label skip
     1563     B-viewProcInfo
     1564     B-WaitFramStop at row 4 col 30
     1565     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1566     .
     1567   define new global shared variable mBatchMode as logical no-undo init ?.
     1568   define variable mFramBachModHandle as handle no-undo.
     1569   mFramBachModHandle = frame waitfram:handle.
     1570   define variable mFameOldVis as logical no-undo.
     1571   define variable mVisCUrentVin as logical no-undo.
     1572   if session:batch-mode
     1573   then
     1574      mBatchMode = yes.
     1575   if mBatchMode = ? then do:
     1576     mVisCUrentVin = current-window:visible.
     1577     mFameOldVis = mFramBachModHandle:visible.
     1578     mFramBachModHandle:visible  = yes.
     1579     mBatchMode = mFramBachModHandle:visible ne yes.
     1580     mFramBachModHandle:visible = mFameOldVis.
     1581     current-window:visible = mVisCUrentVin.
     1582   end.
     1583    if  log-manager:logfile-name ne ?
     1584     then DO:
     1585         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1586         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1587         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1588     end.
     1589   on choose of B-WaitFramStop in frame waitfram
     1590   do:
     1591     mWaitFramStop = yes.
     1592     mWaitFramStopUser = yes.
     1593   end.
     1594   function waitfram-check-timeout returns logical():
     1595      define variable vtime as int64 no-undo.
     1596      if mWaitFramStopTimeOut
     1597      then
     1598         return yes.
     1599      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1600      if     mWaitFramTimeOut ne ?
     1601         and mWaitFramTimeOut ne 0
     1602         and mWaitFramTimeOut lt vtime
     1603      then do:
     1604         mWaitFramStopTimeOut = yes.
     1605      end.
     1606      return mWaitFramStopTimeOut.
     1607   end.
     1608   procedure waitfram-hide :
     1609     if not session:batch-mode
     1610     then do
     1611     on error undo, return error return-value
     1612     :
     1613       pause 0 before-hide .
     1614       if not mBatchMode then
     1615         hide frame waitfram .
     1616     end.
     1617   end procedure.
     1618   procedure waitfram-show :
     1619     define input  parameter p-message as character no-undo .
     1620     define variable v-left-margin as integer   no-undo .
     1621     if not session:batch-mode
     1622     then do
     1623     on error undo, return error return-value
     1624     :
     1625       if length(p-message) <= 70 then do:
     1626         assign
     1627           v-left-margin = integer((70 - length(p-message)) / 2)
     1628         .
     1629         assign
     1630           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1631         .
     1632         assign
     1633           v-waitfram-action01 = " "
     1634           v-waitfram-action02 = " "
     1635                                    + fill(" ", v-left-margin)
     1636                                    + p-message
     1637           v-waitfram-action03 = " "
     1638         .
     1639       end.
     1640       else do:
     1641         define variable vRindex1 as integer no-undo.
     1642         define variable vRindex2 as integer no-undo.
     1643         vRindex1 = r-index(p-message," ",70).
     1644         if vRindex1 = 0
     1645         then
     1646            vRindex1 = 70.
     1647         if length(p-message)  <= vRindex1 + 70 then do:
     1648           assign
     1649             v-waitfram-action01 = " "
     1650             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1651             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1652           .
     1653         end.
     1654         else do:
     1655           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1656           if vRindex2 <= vRindex1
     1657           then
     1658              vRindex2 = vRindex1 + 70.
     1659           assign
     1660             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1661             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1662             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1663           .
     1664         end.
     1665       end.
     1666       B-viewProcInfo:visible   in frame waitfram = no.
     1667       B-viewProcInfo:sensitive in frame waitfram = no.
     1668       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1669       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1670       if  (   mWaitFramView
     1671          or  mWaitProcEvent)
     1672          and not mBatchMode
     1673       then
     1674          display
     1675             v-waitfram-action01 skip
     1676             v-waitfram-action02 skip
     1677             v-waitfram-action03 skip
     1678          with frame waitfram .
     1679     end.
     1680   end procedure.
     1681      procedure waitfram-show-this:
     1682         define input  parameter iInterval as int64 no-undo.
     1683         define variable vtime as int64 no-undo.
     1684         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1685         mWaitFramInterval = iInterval.
     1686         run waitfram-show (substitute("&1&2 &3&4" ,
     1687                                       mWaitFramTextBeg ,
     1688                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1689                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1690                                       mWaitFramTextEnd
     1691                                      )
     1692                           ).
     1693      end.
     1694      procedure WaitFramRunPause:
     1695         define input  parameter iInterval as dec no-undo.
     1696         define variable vStart  as datetime-tz no-undo.
     1697         define variable vend    as datetime-tz no-undo.
     1698         define variable vint as int64 no-undo.
     1699         define variable vOk as logical no-undo.
     1700         vStart = now.
     1701         vend   = vStart.
     1702         publish "WaitFramPause" (iInterval,output vOk).
     1703         vend   =  now.
     1704         vint = vend - vStart.
     1705         vint = iInterval - vint / 1000.
     1706         if     not mWaitFramStop
     1707            and (   vint > 0
     1708                 or (    not vOk
     1709                     and iInterval eq ?
     1710                     )
     1711                 )
     1712         then
     1713            run waitfram-show-this (iInterval).
     1714         vend   =  now.
     1715         vint = vend - vStart.
     1716         vint = iInterval - vint / 1000.
     1717         if     not mWaitFramStop
     1718            and vint > 0
     1719         then do:
     1720            run gbl/pause.p (vint * 1000).
     1721         end.
     1722         if iInterval ne ?
     1723         then
     1724            publish "WaitFramStop".
     1725         waitfram-check-timeout().
     1726      end.
     1727      procedure WaitFramWaitFor:
     1728         define input  parameter iInterval as dec no-undo.
     1729         assign
     1730            mWaitFramStartProc   = now
     1731            mWaitFramStopUser    = no
     1732            mWaitFramStopTimeOut = no
     1733         .
     1734         block-wait:
     1735         do while not mWaitFramStop:
     1736            run WaitFramRunPause (iInterval).
     1737            if  waitfram-check-timeout()
     1738            then do:
     1739               leave block-wait.
     1740            end.
     1741         end.
     1742         run waitfram-hide.
     1743      end.
     1744   procedure waitfram-join :
     1745     define input  parameter p-line-1  as character no-undo .
     1746     define input  parameter p-line-2  as character no-undo .
     1747     define input  parameter p-line-3  as character no-undo .
     1748     define output parameter p-message as character no-undo .
     1749     do
     1750     on error undo, return error return-value
     1751     :
     1752       assign
     1753         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1754                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1755                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1756       .
     1757     end.
     1758   end procedure.
     1759   function waitfram-join-function returns character
     1760     (input p-line-1 as character
     1761     ,input p-line-2 as character
     1762     ,input p-line-3 as character
     1763     ).
     1764     define variable v-message as character no-undo .
     1765     run waitfram-join in this-procedure
     1766       (input  p-line-1
     1767       ,input  p-line-2
     1768       ,input  p-line-3
     1769       ,output v-message
     1770       ) .
     1771     return v-message .
     1772   end function .
     1773   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
