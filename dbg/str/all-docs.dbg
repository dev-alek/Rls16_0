    19926   procedure proc-b-ext :
    19927    do
    19928    on error undo, return error return-value
    19929    :
    19930       define variable v-list-index     as integer   no-undo .
    19931       define variable v-trn-doc-recid  as recid     no-undo .
    19932       for each temp_recid-list
    19933       :
    19934         delete temp_recid-list.
    19935       end.
    19936       if available t-doc
    19937       then do:
    19938         assign
    19939           v-trn-doc-recid = recid( t-doc )
    19940         .
    19941         do v-list-index = 1 to num-entries( mark-list )
    19942         :
    19943           create temp_recid-list .
    19944           assign
    19945             temp_recid-list.string-trn-doc-recid = entry( v-list-index, mark-list )
    19946           .
    19947         end.
    19948       end.
    19949       else do:
    19950         assign
    19951           v-trn-doc-recid = 0
    19952         .
    19953       end.
    19954       run str/run-ext.p
    19955         (input  v-trn-doc-recid
    19956         ,input  table temp_recid-list
    19957         ,input  'документы':U
    19958         ,input  ""
    19959         ,output v-ext-button-label
    19960         ) no-error.
    19961       if error-status :error
    19962       then do:
    19963         undo, return error return-value .
    19964       end.
    19965    end.
    19966   end procedure.
