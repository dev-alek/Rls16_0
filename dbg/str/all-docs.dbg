     5071           where ub.prt-obj.prt-code  = ub.gds-prt.node-code
     5072           and ub.prt-obj.prod-code = ub.goods.prod-code
     5073           and ub.prt-obj.prod-type = ub.goods.prod-type
     5074           and ub.prt-obj.artic     = ub.goods.artic
     5075           and ub.prt-obj.obj-code  = store-code
     5076           and ub.prt-obj.obj-type  = store-type
     5077           no-error.
     5078       if ub.trn-doc.fact-date = ? then
     5079       do:
     5080           assign
     5081               old-val      = ( if available ub.prt-obj then ub.prt-obj.fact-qnty else 0 )
     5082               v-fact-order = integer ( ub.trn-doc.doc-date ) + 0.99
     5083               .
     5084       end.
