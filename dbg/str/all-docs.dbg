    22204     (input  'is-bge'
    22205     ,input  ''
    22206     ,input  ''
    22207     ,input  0
    22208     ,input  ''
    22209     ,input  ''
    22210     ,input  ''
    22211     ,input  no
    22212     ,output is-bgevalue
    22213     ,output is-bgetype
    22214     ) no-error .
    22215   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    22216     (input  'is-fin'
    22217     ,input  ''
    22218     ,input  ''
    22219     ,input  0
    22220     ,input  ''
    22221     ,input  ''
    22222     ,input  ''
    22223     ,input  no
    22224     ,output is-finvalue
    22225     ,output is-fintype
    22226     ) no-error .
    22227   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    22228     (input  'holding'
    22229     ,input  ''
    22230     ,input  ''
    22231     ,input  0
    22232     ,input  ''
    22233     ,input  ''
    22234     ,input  ''
    22235     ,input  no
    22236     ,output varhold
    22237     ,output varhold-type
    22238     ) no-error .
    22239   if par-obj-type <> "" and
    22240      par-obj-code <> 0  then do:
    22241     find first bf_clients where bf_clients.obj-type = par-obj-type and
    22242                                 bf_clients.obj-code = par-obj-code no-lock.
    22243     if bf_clients.obj-type = 'маг':U then do:
    22244       find first bf_shop where bf_shop.obj-code = bf_clients.obj-code no-lock.
    22245       assign
    22246         v_shift = string(bf_shop.shift-on).
    22247     end.
    22248     else do:
    22249       find first bf_store where bf_store.obj-code = bf_clients.obj-code no-lock.
    22250       assign
    22251         v_shift = string(bf_store.shift-on).
    22252     end.
    22253   end.
    22254   else do:
    22255     assign
    22256       v_shift = "no":u.
    22257   end.
    22258   end procedure.
    22259   procedure local-enable :
    22260   define variable v-alcohol-value as character no-undo.
    22261   define variable v-alcohol-type  as character no-undo.
    22262   ENABLE
    22263   b-mark when lookup("b-mark":U, bttns) > 0
    22264   b-sel when lookup("b-sel":U, bttns) > 0
    22265   b-quit b-lkp b-print b-exp b-history b-sch b-help br-docs b-rep b-f-ed
    22266   sch-code sch-date sch-fact sch-objtype sch-objcode sch-sum ed-notes b-uf b-filter-ext b-scaner
    22267   b-akt WITH FRAME d-all-docs.
    22268   hide b-copy in FRAME d-all-docs.
    22269   if parext-doc-type = 'vt':U then do:
    22270     enable b-to-inv b-to-update with frame d-all-docs .
    22271   end.
    22272   else do:
    22273     hide b-to-inv b-to-update in frame d-all-docs .
    22274   end.
    22275   assign
    22276     v-is-lgas = true when lookup('is-lgas-corr':U, bttns) > 0.
    22277   run make-sf-button.
    22278   if is-bgevalue = "yes" or is-finvalue = "yes" then do:
    22279     enable b-pay with frame d-all-docs.
    22280     if is-finvalue = "no" then do:
    22281       assign menu-item m_gen-6 :sensitive  in menu popup-menu-b-pay = no.
    22282       assign menu-item m_gen-8 :sensitive  in menu popup-menu-b-pay = no.
    22283       assign menu-item m_gen-9 :sensitive  in menu popup-menu-b-pay = no.
    22284       assign menu-item m_gen-19 :sensitive  in menu popup-menu-b-pay = no.
    22285       assign menu-item m_gen-11 :sensitive in menu popup-menu-b-pay = no.
    22286       assign menu-item m_gen-12 :sensitive in menu popup-menu-b-pay = no.
    22287       assign menu-item m_gen-20 :sensitive in menu popup-menu-b-pay = no.
    22288       menu-item m_gen-22 :sensitive in menu POPUP-MENU-b-pay = false.
    22289       menu-item m_gen-19 :sensitive in menu POPUP-MENU-b-pay = false.
    22290       menu-item m_gen-21 :sensitive in menu POPUP-MENU-b-pay = false.
    22291     end.
    22292     else do:
    22293     if v-cntxt-db-num <> 0 then
    22294     assign
    22295       MENU-ITEM m_gen-6  :sensitive in menu POPUP-MENU-b-pay = false
    22296       MENU-ITEM m_gen-8  :sensitive in menu POPUP-MENU-b-pay = false
    22297       MENU-ITEM m_gen-9  :sensitive in menu POPUP-MENU-b-pay = false
    22298       MENU-ITEM m_gen-11 :sensitive in menu POPUP-MENU-b-pay = false
    22299       MENU-ITEM m_gen-12 :sensitive in menu POPUP-MENU-b-pay = false
    22300       MENU-ITEM m_gen-13 :sensitive in menu POPUP-MENU-b-pay = false
    22301       MENU-ITEM m_gen-14 :sensitive in menu POPUP-MENU-b-pay = false
    22302     .
    22303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    22304     (input  'is-finby'
    22305     ,input  ''
    22306     ,input  ''
    22307     ,input  0
    22308     ,input  ''
    22309     ,input  ''
    22310     ,input  ''
    22311     ,input  no
    22312     ,output par-is-finby
    22313     ,output par-type
    22314     ) no-error .
    22315   if error-status :error then
    22316     assign
    22317       par-is-finby = 'no' .
    22318     .
    22319     assign
    22320       is-finby = lookup(par-is-finby, "true,yes":U) > 0
    22321     .
    22322     if is-finby = false then
    22323         assign
    22324           menu-item m_gen-22 :sensitive in menu POPUP-MENU-b-pay = false
    22325           menu-item m_gen-19 :sensitive in menu POPUP-MENU-b-pay = false
    22326           menu-item m_gen-20 :sensitive in menu POPUP-MENU-b-pay = false
    22327           menu-item m_gen-21 :sensitive in menu POPUP-MENU-b-pay = false
    22328         .
    22329       run make-fo-button.
    22330     end.
    22331   END.
    22332   if parext-doc-type = 'ie':U or parext-doc-type = 'pc':U then do:
    22333     assign menu-item m_gen-15 :sensitive in menu popup-menu-b-pay = yes.
    22334     assign menu-item m_gen-16 :sensitive in menu popup-menu-b-pay = yes.
    22335     assign menu-item m_gen-17 :sensitive in menu popup-menu-b-pay = yes.
    22336     assign menu-item m_gen-18 :sensitive in menu popup-menu-b-pay = yes.
    22337   end.
    22338   else do:
    22339     assign menu-item m_gen-15 :sensitive in menu popup-menu-b-pay = no.
    22340     assign menu-item m_gen-16 :sensitive in menu popup-menu-b-pay = no.
    22341     assign menu-item m_gen-17 :sensitive in menu popup-menu-b-pay = no.
    22342     assign menu-item m_gen-18 :sensitive in menu popup-menu-b-pay = no.
    22343   end.
    22344   if par-obj-type = 'скл':U or par-obj-type = 'маг':U then do:
    22345     enable b-bc WITH FRAME d-all-docs.
    22346   end.
    22347   run str/run-ext.p ( input ?
    22348                   , input table temp_recid-list
    22349                   , input 'документы':U
    22350                   , input "init"
    22351                   , output v-ext-button-label
    22352                   ) no-error.
    22353   if error-status :error
    22354   then do:
    22355       assign
    22356           b-ext :visible   = no
    22357       .
    22358           hide b-ext in frame d-all-docs .
    22359   end.
    22360   else do:
    22361       assign
    22362           b-ext :label     = v-ext-button-label
    22363           b-ext :visible   = yes
    22364           b-ext :sensitive = yes
    22365       .
    22366   end.
    22367   if not(
    22368    parinternal = true        and
    22369    partype     = 'при':U   and
    22370    parstat     = 'запрос':U )
    22371   then do:
    22372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    22373     (input  'alcohol':u
    22374     ,input  0
    22375     ,input  ''
    22376     ,input  0
    22377     ,input  ''
    22378     ,input  ''
    22379     ,input  ''
    22380     ,input  no
    22381     ,output v-alcohol-value
    22382     ,output v-alcohol-type
    22383     ) no-error .
    22384     if (not error-status:error) and (lookup(v-alcohol-value, 'true,yes':u)) > 0 then do:
    22385       enable b-covdocs WITH FRAME d-all-docs.
    22386     end.
    22387     else do:
    22388       hide b-covdocs in FRAME d-all-docs.
    22389     end.
    22390   end.
    22391   end procedure.
    22392   procedure make-fo-button :
    22393    do
    22394    on error undo, return error return-value
    22395    :
    22396   define variable  but-fo  as widget-handle.
    22397      create button but-fo
    22398      assign
    22399         row = 1
    22400         column = 64
    22401         HEIGHT-CHARS = 1
    22402         WIDTH-CHARS = 9
    22403         label = "Фин.Об&яз"
    22404         tooltip = "Список Фин.обязательств по накладной"
    22405         frame = frame d-all-docs:handle
    22406         sensitive = true
    22407         visible = true
    22408           triggers:
    22409             on choose persistent run list-fo.
    22410           end triggers.
    22411    end.
    22412   end procedure.
    22413   procedure list-fo :
    22414    do
    22415    on error undo, return error return-value
    22416    :
    22417   find current t-doc no-lock no-error .
    22418   if available t-doc then
    22419   run str/fi-trns.w (
    22420       input parparentproc,
    22421       input par-host-code,
    22422       input ?              ,
    22423       input t-doc.doc-code ,
    22424       input "trn-doc":U
    22425       ) .
    22426    end.
    22427   end procedure.
    22428   procedure make-sf-button :
    22429    do
    22430    on error undo, return error return-value
    22431    :
    22432   define variable  but-sf  as widget-handle.
    22433      create button but-sf
    22434      assign
    22435         row = 1
    22436         column = 73
    22437         HEIGHT-CHARS = 1
    22438         WIDTH-CHARS = 9
    22439         label = "СчетФакт"
    22440         tooltip = "Список Счетов-фактур по накладной"
    22441         frame = frame d-all-docs:handle
    22442         sensitive = true
    22443         visible = true
    22444           triggers:
    22445             on choose persistent run list-sf.
    22446           end triggers.
    22447    end.
    22448   end procedure.
    22449   procedure list-sf :
    22450    do
    22451    on error undo, return error return-value
    22452    :
    22453   define variable v-rid-list as character no-undo .
    22454   find current t-doc no-lock no-error .
    22455   if available t-doc then
    22456     run str/s-f-docs.w
    22457       ( input parparentproc,
    22458         input par-host-code,
    22459         ?,
    22460         ?,
    22461         ?,
    22462         "td" ,
    22463         t-doc.ext-doc-type,
    22464         t-doc.doc-code,
    22465         "" ,
    22466         input "in-doc",
    22467         input-output v-rid-list
    22468         ) no-error .
    22469    end.
    22470   end procedure.
    22471   procedure create-button :
    22472    do
    22473    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
    22474    :
    22475   if not(
    22476    parinternal = true        and
    22477    partype     = 'при':U   and
    22478    parstat     = 'запрос':U ) then return .
    22479   define variable  but1  as widget-handle.
    22480      create button but1
    22481      assign
    22482         row = 2.3
    22483         column = 92
    22484         height-chars = 1
    22485         width-chars = 7
    22486         label = "Рас&х+"
    22487         tooltip = "Формирование внут.расходного запроса"
    22488         frame = frame d-all-docs:handle
    22489         sensitive = true
    22490         visible = true
    22491           triggers:
    22492             on choose persistent run proc-rash-zapr.
    22493           end triggers.
    22494    end.
    22495   end procedure.
    22496   procedure proc-rash-zapr :
    22497    do
    22498    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
    22499    :
    22500    find current t-doc no-lock no-error .
    22501       if available t-doc then  do:
    22502           run cus/ord-mrz.p
    22503              ( input parparentproc ,
    22504                input recid(t-doc))
    22505                .
    22506       end.
    22507    end.
    22508   end procedure.
    22509   procedure proc-m_to-inv :
    22510     define buffer buf_trn-doc for ub.trn-doc .
    22511     define buffer bf_trn-doc  for ub.trn-doc .
    22512     define variable ii          as integer   no-undo .
    22513     define variable ll          as integer   no-undo .
    22514     define variable list-trn    as character no-undo .
    22515     define variable trnDocCode  as character no-undo .
    22516     define variable errorTrnDoc as character no-undo .
    22517     define variable misTrnDoc   as character no-undo .
    22518     define variable glog        as logical   no-undo .
    22519     define variable isManual    as logical   no-undo .
    22520     define variable isMultiTSD  as logical   no-undo .
    22521     define variable trn-doc     as character no-undo .
    22522     define variable isItogInv   as recid no-undo init ?.
    22523     define buffer error_inv-doc-attr for ub.inv-doc-attr .
    22524     define buffer error_trn-doc for ub.trn-doc .
    22525     do on error undo, return error return-value :
    22526       if not available t-doc and mark-list = "" then
    22527       do:
    22528         message "Не выбран документ." view-as alert-box.
    22529         return error.
    22530       end.
    22531       if mark-list = "" then
    22532       do:
    22533         assign
    22534           pardoc-rec = recid( t-doc ).
    22535           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
    22536               ub.inv-doc-attr.attr-code = 'invMultDevice' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22537           if available (ub.inv-doc-attr) then
    22538           do:
    22539               isMultiTSD = true .
    22540               find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
    22541                   ub.inv-doc-attr.attr-code = 'isManual' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22542               if available (ub.inv-doc-attr) then
    22543               do:
    22544                   message "Выбранный документ уже включен в итоговую инвентаризацию"
    22545                       view-as alert-box.
    22546                   return error .
    22547               end.
    22548           end.
    22549         else
    22550         do:
    22551           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
    22552             ub.inv-doc-attr.attr-code = 'isManual' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22553           if available (ub.inv-doc-attr) then isManual = true .
    22554         end.
    22555         if isMultiTSD and not isManual then do:
    22556         find first buf_trn-doc no-lock where t-doc.doc-code = entry(1,buf_trn-doc.doc-code,"/") and
    22557         num-entries(buf_trn-doc.doc-code,"/") > 1 and buf_trn-doc.status_ = 'запрос':U and
    22558         not buf_trn-doc.flag_ no-error .
    22559         if not available (buf_trn-doc) then
    22560         do:
    22561           message "У выбранного документа нет документов для объединения"
    22562             view-as alert-box.
    22563           return error .
    22564         end.
    22565         else
    22566         do:
    22567           for each bf_trn-doc no-lock where t-doc.doc-code = entry(1,bf_trn-doc.doc-code,"/") and
    22568             num-entries(buf_trn-doc.doc-code,"/") > 1 and bf_trn-doc.status_ = 'запрос':U and not bf_trn-doc.flag_:
    22569             list-trn = list-trn + "," + string(bf_trn-doc.doc-code) .
    22570           end.
    22571           list-trn = trim(list-trn,",") .
    22572         end.
    22573         trnDocCode = t-doc.doc-code .
    22574         end.
    22575         if isManual and not isMultiTSD then do:
    22576           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
    22577           ub.inv-doc-attr.attr-code = "ManualTSD" no-error .
    22578           if available (ub.inv-doc-attr) then do:
    22579             message "На основе документа инвентаризации " + string(t-doc.doc-code) + " уже сформирована итоговая инвентаризация" view-as alert-box.
    22580             mark-list = "" .
    22581             run UI-on in this-procedure ( input "open" ).
    22582             return error.
    22583           end.
    22584           list-trn = t-doc.doc-code .
    22585         end.
    22586         if isManual and isMultiTSD then do:
    22587             message "Выбранные документы относятся к разным инвентаризациям"  view-as alert-box.
    22588             mark-list = "" .
    22589             run UI-on in this-procedure ( input "open" ).
    22590             return error.
    22591         end.
    22592         if t-doc.status_ <> 'факт':U then do:
    22593         message "После создания итогового документа по инвентаризации " + list-trn + " все включенные документы будут заблокированы." skip
    22594           "Внести изменения в полученный документ инвентаризации можно будет вручную или с помощью корректирующего документа, созданного на ТСД" skip
    22595           "Продолжить?"
    22596           view-as alert-box QUESTION buttons YES-NO update glog.
    22597         if not glog then
    22598         do:
    22599           mark-list = "" .
    22600           run UI-on in this-procedure ( input "open" ).
    22601           return .
    22602         end.
    22603         end.
    22604       end.
    22605       else
    22606       do:
    22607         do ii = 1 to num-entries(mark-list):
    22608           find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer(entry(ii,mark-list)) no-error .
    22609           if not available (buf_trn-doc) then
    22610           do:
    22611             message "Не найден документ." view-as alert-box.
    22612             mark-list = "" .
    22613             run UI-on in this-procedure ( input "open" ).
    22614             return error.
    22615           end.
    22616           if buf_trn-doc.status_ = 'запрос':U and not buf_trn-doc.flag_ then
    22617           do:
    22618         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22619           ub.inv-doc-attr.attr-code = 'invMultDevice' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22620         if available (ub.inv-doc-attr) then do:
    22621         isMultiTSD = true .
    22622            find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22623             ub.inv-doc-attr.attr-code = 'isManual' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22624           if available (ub.inv-doc-attr) then do:
    22625               message "Выбранный документ уже включен в итоговую инвентаризацию"
    22626               view-as alert-box.
    22627               return error .
    22628           end.
    22629         end.
    22630         else do:
    22631           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22632             ub.inv-doc-attr.attr-code = 'isManual' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22633           if available (ub.inv-doc-attr) then isManual = true .
    22634           else do:
    22635           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22636             ub.inv-doc-attr.attr-code = 'isManualError' and ub.inv-doc-attr.attr-value = string(true) no-error .
    22637           if available (ub.inv-doc-attr) then do:
    22638           do ll = 1 to num-entries(mark-list):
    22639             find first error_trn-doc no-lock where recid(error_trn-doc) = integer(entry(ll,mark-list)) no-error .
    22640             if available (error_trn-doc) then do:
    22641             for first error_inv-doc-attr no-lock where error_inv-doc-attr.doc-code = error_trn-doc.doc-code and
    22642             error_inv-doc-attr.attr-code = 'isManualError' and error_inv-doc-attr.attr-value = string(true):
    22643             if errorTrnDoc = '' then errorTrnDoc = error_inv-doc-attr.doc-code .
    22644             else errorTrnDoc = errorTrnDoc + ", "  + error_inv-doc-attr.doc-code .
    22645             end.
    22646             end.
    22647           end.
    22648                 message "Выбраны документы" + errorTrnDoc + ", не подлежащие включению в итоговую инвентаризацию! Инвентаризация не создана!"  view-as alert-box.
    22649                 mark-list = "" .
    22650                 run UI-on in this-procedure ( input "open" ).
    22651                 return error.
    22652           end.
    22653           else do:
    22654                 message "Выбраны документы, не подлежащие включению в итоговую инвентаризацию! Инвентаризация не создана!"  view-as alert-box.
    22655                 mark-list = "" .
    22656                 run UI-on in this-procedure ( input "open" ).
    22657                 return error.
    22658           end.
    22659           end.
    22660         end.
    22661             if isManual and isMultiTSD then
    22662             do:
    22663                 message "Выбранные документы относятся к разным инвентаризациям"  view-as alert-box.
    22664                 mark-list = "" .
    22665                 run UI-on in this-procedure ( input "open" ).
    22666                 return error.
    22667             end.
    22668           if  isMultiTSD and not isManual then do:
    22669             if trnDocCode = "" then trnDocCode = entry(1,buf_trn-doc.doc-code,"/").
    22670             else
    22671             do:
    22672               if trnDocCode <> entry(1,buf_trn-doc.doc-code,"/") then
    22673               do:
    22674                 message "Выбранные документы относятся к разным инвентаризациям"  view-as alert-box.
    22675                 mark-list = "" .
    22676                 run UI-on in this-procedure ( input "open" ).
    22677                 return error.
    22678               end.
    22679             end.
    22680             end.
    22681           end.
    22682           else
    22683           do:
    22684         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22685           (ub.inv-doc-attr.attr-code = 'ItogInvManual' or ub.inv-doc-attr.attr-code = 'ItogInv') and ub.inv-doc-attr.attr-value <> "" no-error .
    22686         if available (ub.inv-doc-attr) and buf_trn-doc.status_ = 'разрешен':U and isItogInv = ? then
    22687         isItogInv = recid(buf_trn-doc) .
    22688         else
    22689         do:
    22690             message "Выбраны документы, не подлежащие включению в итоговую инвентаризацию! Инвентаризация не создана!" view-as alert-box.
    22691             mark-list = "" .
    22692             run UI-on in this-procedure ( input "open" ).
    22693             return error.
    22694           end.
    22695           end.
    22696           if isManual and not isMultiTSD then do:
    22697           find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = buf_trn-doc.doc-code and
    22698           ub.inv-doc-attr.attr-code = "ManualTSD" no-error .
    22699           if available (ub.inv-doc-attr) then do:
    22700             message "На основе документа инвентаризации " + string(buf_trn-doc.doc-code) + " уже сформирована итоговая инвентаризация" view-as alert-box.
    22701             mark-list = "" .
    22702             run UI-on in this-procedure ( input "open" ).
    22703             return error.
    22704           end.
    22705           end.
    22706           if isItogInv <> recid(buf_trn-doc) then
    22707           list-trn = list-trn + "," + string(buf_trn-doc.doc-code) .
    22708         end.
    22709         list-trn = trim(list-trn,",").
    22710         if isMultiTSD then do:
    22711         find first bf_trn-doc no-lock where bf_trn-doc.doc-code = trnDocCode no-error .
    22712         if not available (bf_trn-doc) then do:
    22713             message "По инвентаризации " + string(trnDocCode) + " уже создана итоговая инвентаризация " + string(trnDocCode) + "/и" skip
    22714             "Необходимые изменения можно внести вручную в " + string(trnDocCode) + "/и"
    22715              view-as alert-box.
    22716             mark-list = "" .
    22717             run UI-on in this-procedure ( input "open" ).
    22718             return error.
    22719         end.
    22720         for each bf_trn-doc no-lock where trnDocCode = entry(1,bf_trn-doc.doc-code,"/") and
    22721         num-entries(buf_trn-doc.doc-code,"/") > 1 and bf_trn-doc.status_ = 'запрос':U and not bf_trn-doc.flag_:
    22722           if lookup(string(bf_trn-doc.doc-code),list-trn) = 0 then
    22723           do:
    22724             misTrnDoc = misTrnDoc + ", "  + bf_trn-doc.doc-code .
    22725           end.
    22726         end.
    22727         if misTrnDoc <> "" then
    22728         do:
    22729           list-trn <> trim(misTrnDoc,", ") .
    22730           message "По инвентаризации " + trnDocCode + " есть другие загруженные документы:" + misTrnDoc skip
    22731             "При продолжении они будут проигнорированы." skip
    22732             "Продолжить?"
    22733             view-as alert-box QUESTION buttons YES-NO update glog.
    22734           if not glog then
    22735           do:
    22736             mark-list = "" .
    22737             run UI-on in this-procedure ( input "open" ).
    22738             return .
    22739           end.
    22740         end.
    22741           message "После создания итогового документа по инвентаризации " + trnDocCode + " все включенные документы будут заблокированы." skip
    22742           "Внести изменения в полученный документ инвентаризации можно будет вручную или с помощью корректирующего документа, созданного на ТСД" skip
    22743           "Продолжить?"
    22744             view-as alert-box QUESTION buttons YES-NO update glog.
    22745           if not glog then
    22746           do:
    22747             mark-list = "" .
    22748             run UI-on in this-procedure ( input "open" ).
    22749             return .
    22750           end.
    22751         end.
    22752       end.
    22753       list-trn = trim(list-trn,",").
    22754       if isManual and isItogInv = ? then run itogInvDocManual(list-trn, output pardoc-rec).
    22755       else if isManual and isItogInv <> ? then run correctItogInvDoc(isItogInv, list-trn, output pardoc-rec).
    22756       else run itogInvDoc(trnDocCode, list-trn, output pardoc-rec).
    22757       mark-list = "" .
    22758       apply "ENTRY":U to br-docs in frame d-all-docs.
    22759       if error-status :error then
    22760       do:
    22761         find t-doc no-lock where recid( t-doc ) = pardoc-rec.
    22762         return error.
    22763       end.
    22764       find t-doc no-lock where recid( t-doc ) = pardoc-rec.
    22765       run UI-on in this-procedure ( input "open" ).
    22766     end.
    22767   end procedure.
    22768   procedure itogInvDocManual :
    22769     define input parameter par-list as character no-undo .
    22770     define output parameter pardoc-rec as recid no-undo .
    22771     define variable vardoc-code  as character no-undo .
    22772     define variable ii           as integer   no-undo .
    22773     define variable line-rec     as recid     no-undo .
    22774     define variable old-line-rec as recid     no-undo .
    22775     define variable chg-qnty     like ub.doc-line.fact-qnty no-undo .
    22776     define buffer buf_trn-doc       for ub.trn-doc .
    22777     define buffer bf_trn-doc        for ub.trn-doc .
    22778     define buffer buf_doc-line      for ub.doc-line .
    22779     define buffer bf_doc-line       for ub.doc-line .
    22780     define buffer old_doc-line      for ub.doc-line .
    22781     define buffer buf_trn-doc-sum   for ub.trn-doc-sum .
    22782     define buffer buf_doc-line-sum  for ub.doc-line-sum .
    22783     define buffer bf_curr-accnt     for ub.curr-accnt .
    22784     define buffer bf_sysconf        for ub.sysconf .
    22785     define buffer buf_marking-lines for ub.marking-lines .
    22786     define variable vismsg         as logical   no-undo init true.
    22787     define variable lns-cnt        as integer   no-undo.
    22788     define variable v-marking-type as character no-undo.
    22789     define variable v-type         as character no-undo.
    22790     define variable v-is-marking   as logical   no-undo init false.
    22791     define variable vartime        as integer   no-undo.
    22792     define variable varmessage     as character no-undo.
    22793     define variable nn as integer no-undo .
    22794     do on error undo, return error return-value :
    22795       empty temp-table tt-gds-list .
    22796   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvdoc in g#lib-trn3
    22797   (input  v-cntxt-obj-type
    22798   ,input  v-cntxt-obj-code
    22799   ,input  v-cntxt-userid
    22800   ,output pardoc-rec
    22801   ) no-error.
    22802       if error-status :error then
    22803       do:
    22804         return error.
    22805       end.
    22806       find bf_trn-doc where recid(bf_trn-doc) = pardoc-rec .
    22807       assign
    22808         bf_trn-doc.tot-calc = ?.
    22809       assign
    22810         bf_trn-doc.PS      = par-list
    22811         .
    22812       create ub.inv-doc-attr .
    22813       assign
    22814         ub.inv-doc-attr.doc-code   = bf_trn-doc.doc-code
    22815         ub.inv-doc-attr.attr-code  = 'ItogInvManual'
    22816         ub.inv-doc-attr.attr-value = par-list
    22817         .
    22818       create ub.inv-doc-attr .
    22819       assign
    22820         ub.inv-doc-attr.doc-code   = bf_trn-doc.doc-code
    22821         ub.inv-doc-attr.attr-code  = 'notMes'
    22822         ub.inv-doc-attr.attr-value = string(true)
    22823         .
    22824       assign
    22825         vartime = time
    22826         lns-cnt = 0
    22827         .
    22828         do ii = 1 to num-entries(par-list):
    22829           for each buf_doc-line no-lock where buf_doc-line.doc-code = entry(ii,par-list,","):
    22830             find first tt-gds-list where tt-gds-list.artic = buf_doc-line.artic and
    22831             tt-gds-list.prod-code = buf_doc-line.prod-code and
    22832             tt-gds-list.prod-type = buf_doc-line.prod-type no-error .
    22833             if not available (tt-gds-list) then do:
    22834               nn = nn + 1 .
    22835               find first ub.goods no-lock where ub.goods.artic = buf_doc-line.artic and
    22836               ub.goods.prod-code = buf_doc-line.prod-code and
    22837               ub.goods.prod-type = buf_doc-line.prod-type no-error .
    22838               create tt-gds-list.
    22839                 BUFFER-COPY ub.goods to tt-gds-list .
    22840                 assign tt-gds-list.nn = nn .
    22841             assign
    22842             tt-gds-list.doc-qnty = tt-gds-list.doc-qnty + buf_doc-line.doc-qnty
    22843             tt-gds-list.fact-qnty = tt-gds-list.fact-qnty + buf_doc-line.fact-qnty
    22844             .
    22845             tt-gds-list.itog-qnty = tt-gds-list.doc-qnty - tt-gds-list.fact-qnty .
    22846             end.
    22847             else do:
    22848             assign
    22849             tt-gds-list.doc-qnty = tt-gds-list.doc-qnty + buf_doc-line.doc-qnty
    22850             tt-gds-list.fact-qnty = tt-gds-list.doc-qnty - tt-gds-list.itog-qnty
    22851             .
    22852             end.
    22853           end.
    22854         end.
    22855       tr:
    22856       for each tt-gds-list
    22857         break by tt-gds-list.nn
    22858         on error undo tr, next tr
    22859         :
    22860         find ub.goods no-lock
    22861           where  ub.goods.gds-code = tt-gds-list.gds-code .
    22862         assign
    22863           lns-cnt = lns-cnt + 1
    22864           .
    22865         run gds-attr-value (
    22866           input ub.goods.gds-code,
    22867           input 'mark-type':U,
    22868           output v-marking-type,
    22869           output v-type
    22870           ).
    22871         if can-find (first ub.doc-line where ub.doc-line.doc-code = bf_trn-doc.doc-code)
    22872           then
    22873         do:
    22874           if v-marking-type <> "" and v-marking-type <> "not-type" and
    22875             ((not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(bf_trn-doc.obj-type, bf_trn-doc.obj-code):GetIsMarkingForType(v-marking-type) and (v-is-marking = true))
    22876             or (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(bf_trn-doc.obj-type, bf_trn-doc.obj-code):GetIsMarkingForType(v-marking-type) and v-is-marking = false))
    22877             then
    22878           do:
    22879             message
    22880               substitute("Ошибка при добавлении строки инвентаризации. Совместное добавление товаров, подлежащих маркировке и не подлежащих маркировке, запрещено.") skip
    22881               view-as alert-box error .
    22882             undo tr, next tr.
    22883           end.
    22884         end.
    22885         else
    22886         do:
    22887           if v-marking-type <> "" and v-marking-type <> "not-type" then
    22888           do:
    22889             if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(bf_trn-doc.obj-type, bf_trn-doc.obj-code):GetIsMarkingForType(v-marking-type)
    22890               then v-is-marking = true.
    22891           end.
    22892         end.
    22893         find first bf_doc-line where
    22894           bf_doc-line.doc-code  = bf_trn-doc.doc-code         and
    22895           bf_doc-line.artic     = ub.goods.artic     and
    22896           bf_doc-line.prod-type = ub.goods.prod-type and
    22897           bf_doc-line.prod-code = ub.goods.prod-code no-error.
    22898         if available bf_doc-line then
    22899         do:
    22900           undo tr, next tr.
    22901         end.
    22902         run waitfram-join in this-procedure (  input "Добавление товаров в документ инвентаризации.",
    22903           input substitute( " Добавлено &1.", lns-cnt - 1 ),
    22904           input substitute( " Время &1.", string( time - vartime, "hh:mm:ss":U ) ),
    22905           output varmessage ).
    22906         run waitfram-show in this-procedure (  input varmessage ).
    22907   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
    22908   (input  parparentproc
    22909   ,input  bf_trn-doc.doc-code
    22910   ,input  ub.goods.artic
    22911   ,input  ub.goods.prod-type
    22912   ,input  ub.goods.prod-code
    22913   ,output line-rec
    22914   ) no-error.
    22915         if error-status :error then
    22916         do:
    22917           run waitfram-hide in this-procedure.
    22918           message
    22919             vss-workfile vss-revision vss-description skip
    22920             substitute("Ошибка при добавлении строки инвентаризации") skip
    22921             error-status :get-message(1) skip
    22922             return-value skip
    22923             view-as alert-box error .
    22924           undo tr, next tr.
    22925         end.
    22926         find first ub.doc-line where recid( ub.doc-line ) = line-rec.
    22927         assign
    22928           ub.doc-line.prt-OK = ?
    22929           .
    22930         if t-doc.status_ = 'разрешен':U and
    22931           t-doc.flag_   = no           then
    22932         do:
    22933   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_filinvln in g#lib-trn2
    22934   (input  ub.doc-line.doc-code,
    22935    input  ub.doc-line.artic,
    22936    input  ub.doc-line.prod-type,
    22937    input  ub.doc-line.prod-code,
    22938    input  this-procedure:handle
    22939   ) no-error
    22940   .
    22941           if error-status :error then
    22942           do:
    22943             run waitfram-hide in this-procedure.
    22944             message "Ошибка при заполнении сумм по строке товара: "
    22945               ub.doc-line.artic " " ub.doc-line.prod-type " " ub.doc-line.prod-code skip
    22946               return-value skip
    22947               view-as alert-box error.
    22948             undo tr, next tr .
    22949           end.
    22950         end.
    22951       end.
    22952   define variable vss-include-info252 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    22953   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
    22954     (input  parparentproc
    22955     ,input  bf_trn-doc.doc-code
    22956     ,output table gds-list
    22957     ) no-error .
    22958     if error-status :error then do:
    22959       return .
    22960     end.
    22961   define variable vss-include-info253 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    22962   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
    22963     (input  parparentproc
    22964     ,input  bf_trn-doc.doc-code
    22965     ,output table gds-list
    22966     ) no-error .
    22967       if error-status :error then do:
    22968       return .
    22969     end.
    22970     for each tt-gds-list:
    22971       for first ub.doc-line exclusive-lock where ub.doc-line.doc-code = bf_trn-doc.doc-code and
    22972       ub.doc-line.artic = tt-gds-list.artic and ub.doc-line.prod-code = tt-gds-list.prod-code and
    22973       ub.doc-line.prod-type = tt-gds-list.prod-type:
    22974                 if tt-gds-list.fact-qnty <> 0 then
    22975         do:
    22976           find first ub.goods no-lock where ub.goods.artic = doc-line.artic and
    22977             ub.goods.prod-code = doc-line.prod-code and
    22978             ub.goods.prod-type = doc-line.prod-type no-error .
    22979           line-rec = recid(doc-line) .
    22980           find first old_doc-line no-lock where old_doc-line.doc-code = bf_trn-doc.doc-code and
    22981             old_doc-line.artic = ub.doc-line.artic and
    22982             old_doc-line.prod-code = ub.doc-line.prod-code and
    22983             old_doc-line.prod-type = ub.doc-line.prod-type no-error .
    22984           old-line-rec = recid(old_doc-line) .
    22985           find first ub.units   no-lock where ub.units.unit-name    = ub.goods.unit-base.
    22986           find       ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
    22987           run invMulti(
    22988             input parparentproc,
    22989             input pardoc-rec,
    22990             input line-rec,
    22991             input recid(ub.goods),
    22992             input recid (ub.gds-prt),
    22993             input tt-gds-list.fact-qnty,
    22994             input 'корн':U).
    22995         end.
    22996       end.
    22997       end.
    22998       run str/clcsumga.p ( input bf_trn-doc.doc-code ).
    22999         for first ub.inv-doc-attr exclusive-lock where
    23000       ub.inv-doc-attr.doc-code = bf_trn-doc.doc-code and
    23001       ub.inv-doc-attr.attr-code = "notMes":
    23002         delete ub.inv-doc-attr .
    23003       end.
    23004       do ii = 1 to num-entries (par-list):
    23005       create ub.inv-doc-attr .
    23006       assign
    23007       ub.inv-doc-attr.doc-code = entry(ii,par-list)
    23008       ub.inv-doc-attr.attr-code = "ManualTSD"
    23009       ub.inv-doc-attr.attr-value = bf_trn-doc.doc-code .
    23010       end.
    23011     end.
    23012   end procedure.
    23013   procedure correctItogInvDoc :
    23014       define input parameter par-ItogInv as recid no-undo .
    23015       define input parameter par-list as character no-undo .
    23016       define output parameter pardoc-rec as recid no-undo .
    23017       define variable vardoc-code  as character no-undo .
    23018       define variable ii           as integer   no-undo .
    23019       define variable line-rec     as recid     no-undo .
    23020       define variable old-line-rec as recid     no-undo .
    23021       define variable chg-qnty     like ub.doc-line.fact-qnty no-undo .
    23022       define buffer buf_trn-doc       for ub.trn-doc .
    23023       define buffer bf_doc-line       for ub.doc-line .
    23024       define buffer old_doc-line      for ub.doc-line .
    23025       define buffer buf_trn-doc-sum   for ub.trn-doc-sum .
    23026       define buffer buf_doc-line-sum  for ub.doc-line-sum .
    23027       define buffer bf_curr-accnt     for ub.curr-accnt .
    23028       define buffer bf_sysconf        for ub.sysconf .
    23029       define buffer buf_marking-lines for ub.marking-lines .
    23030       define variable vismsg                     as logical   no-undo init true.
    23031       define variable lns-cnt                    as integer   no-undo.
    23032       define variable v-marking-type             as character no-undo.
    23033       define variable v-type                     as character no-undo.
    23034       define variable v-is-marking               as logical   no-undo init false.
    23035       define variable vartime                    as integer   no-undo.
    23036       define variable varmessage                 as character no-undo.
    23037       define variable p-question                 as integer   no-undo .
    23038       define variable p-first                    as logical   no-undo .
    23039       define variable nn                         as integer   no-undo .
    23040       define variable is-Manual                  as logical   no-undo .
    23041       define variable i-total-parts_fact-baseold as decimal   no-undo.
    23042       define variable i-total-parts_fact-rublold as decimal   no-undo.
    23043       define variable i-total-parts_fact-qntyold as decimal   no-undo.
    23044       do on error undo, return error return-value :
    23045           empty temp-table tt-gds-list .
    23046           empty temp-table tt-gds-list2 .
    23047           find bf_trn-doc where recid(bf_trn-doc) = par-ItogInv .
    23048           pardoc-rec = par-ItogInv.
    23049           assign
    23050               bf_trn-doc.tot-calc = ?.
    23051           if bf_trn-doc.PS = "" then bf_trn-doc.PS      = par-list .
    23052           else bf_trn-doc.PS      = bf_trn-doc.PS + "," + par-list .
    23053       if num-entries (par-list) > 1 then do:
    23054       run gbl/d-askw_inv.w (
    23055                    input "Корректировка документа"
    23056                   ,input "Корректировка документа итоговой инвентаризации " + bf_trn-doc.doc-code + ". " + chr(10) + chr(10) + "При использовании нескольких корректирующих документов одновременно функция «Заменить» не доступна. Для использования функции «Заменить» — вам необходимо применять документы коррекции по одному, последовательно."
    23057                   ,input "|"
    23058                   ,input "Объединить|Отмена"
    23059                   ,input "Суммировать значения по строкам документа коррекции " + par-list + " и итогового документа инвентаризации|Отказ от корректировки итоговой инвентаризации"
    23060                   ,input 1
    23061                   ,input 2
    23062                   ,output p-question).
    23063                   if p-question = 2 then p-question = 3 .
    23064       end.
    23065       else do:
    23066       run gbl/d-askw_inv.w (
    23067                    input "Корректировка документа"
    23068                   ,input "Корректировка документа итоговой инвентаризации " + bf_trn-doc.doc-code
    23069                   ,input "|"
    23070                   ,input "Объединить|Заменить|Отмена"
    23071                   ,input "Суммировать значения по строкам документа коррекции " + par-list + " и итогового документа инвентаризации|Заменить значения по строкам итогового документа инвентаризации на значения по строкам документа коррекции  " + par-list + "|Отказ от корректировки итоговой инвентаризации"
    23072                   ,input 1
    23073                   ,input 3
    23074                   ,output p-question).
    23075        end.
    23076   if p-question = 3 then return .
    23077           create ub.inv-doc-attr .
    23078           assign
    23079               ub.inv-doc-attr.doc-code   = bf_trn-doc.doc-code
    23080               ub.inv-doc-attr.attr-code  = 'notMes'
    23081               ub.inv-doc-attr.attr-value = string(true)
    23082               .
    23083           create ub.inv-doc-attr .
    23084           assign
    23085               ub.inv-doc-attr.doc-code   = bf_trn-doc.doc-code
    23086               ub.inv-doc-attr.attr-code  = 'correctItogInv'
    23087               ub.inv-doc-attr.attr-value = string(true)
    23088               .
    23089           assign
    23090               vartime = time
    23091               lns-cnt = 0
    23092               .
    23093           for each buf_doc-line no-lock where buf_doc-line.doc-code = bf_trn-doc.doc-code:
    23094               find first ub.goods no-lock where ub.goods.artic = buf_doc-line.artic and
    23095                   ub.goods.prod-code = buf_doc-line.prod-code and
    23096                   ub.goods.prod-type = buf_doc-line.prod-type no-error .
    23097               create tt-gds-list.
    23098               BUFFER-COPY ub.goods to tt-gds-list .
    23099               assign
    23100                   tt-gds-list.doc-qnty  = buf_doc-line.doc-qnty
    23101                   tt-gds-list.fact-qnty = buf_doc-line.fact-qnty
    23102                   .
    23103               tt-gds-list.itog-qnty = tt-gds-list.doc-qnty - tt-gds-list.fact-qnty .
    23104               nn = nn + 1 .
    23105           end.
    23106         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = bf_trn-doc.doc-code and
    23107           (ub.inv-doc-attr.attr-code = 'ItogInvManual' or ub.inv-doc-attr.attr-code = 'ItogInv') and ub.inv-doc-attr.attr-value <> "" no-error .
    23108         if available (ub.inv-doc-attr) then do:
    23109             if ub.inv-doc-attr.attr-code = 'ItogInvManual' then do:
    23110                 is-Manual = true .
    23111                 do ii = 1 to num-entries (par-list):
    23112                     create ub.inv-doc-attr .
    23113                     assign
    23114                         ub.inv-doc-attr.doc-code   = entry(ii,par-list)
    23115                         ub.inv-doc-attr.attr-code  = "ManualTSD"
    23116                         ub.inv-doc-attr.attr-value = bf_trn-doc.doc-code .
    23117                 end.
    23118             end.
    23119             else do:
    23120                 is-Manual = false .
    23121                 do ii = 1 to num-entries (par-list):
    23122                     create ub.inv-doc-attr .
    23123                     assign
    23124                         ub.inv-doc-attr.doc-code   = entry(ii,par-list)
    23125                         ub.inv-doc-attr.attr-code  = "MultiTSD"
    23126                         ub.inv-doc-attr.attr-value = bf_trn-doc.doc-code .
    23127                     create inv-doc-attr .
    23128                     assign
    23129                         inv-doc-attr.doc-code   = entry(ii,par-list)
    23130                         inv-doc-attr.attr-code  = "invMultDevice"
    23131                         inv-doc-attr.attr-value = string(true) .
    23132                 end.
    23133             end.
    23134         end.
    23135       assign
    23136       bf_trn-doc.status_ = 'накл':U
    23137       bf_trn-doc.flag_ = yes
    23138       .
    23139       release bf_trn-doc.
    23140       find bf_trn-doc where recid(bf_trn-doc) = par-ItogInv .
    23141           do ii = 1 to num-entries(par-list):
    23142               for each buf_doc-line no-lock where buf_doc-line.doc-code = entry(ii,par-list,","):
    23143                   find first tt-gds-list2 where tt-gds-list2.artic = buf_doc-line.artic and
    23144                       tt-gds-list2.prod-code = buf_doc-line.prod-code and
    23145                       tt-gds-list2.prod-type = buf_doc-line.prod-type no-error .
    23146                   if not available (tt-gds-list2) then
    23147                   do:
    23148                       nn = nn + 1 .
    23149                       find first ub.goods no-lock where ub.goods.artic = buf_doc-line.artic and
    23150                           ub.goods.prod-code = buf_doc-line.prod-code and
    23151                           ub.goods.prod-type = buf_doc-line.prod-type no-error .
    23152                       create tt-gds-list2.
    23153                       BUFFER-COPY ub.goods to tt-gds-list2 .
    23154                       assign
    23155                           tt-gds-list2.nn = nn .
    23156                       assign
    23157                           tt-gds-list2.doc-qnty  = tt-gds-list2.doc-qnty + buf_doc-line.doc-qnty
    23158                           tt-gds-list2.fact-qnty = tt-gds-list2.fact-qnty + buf_doc-line.fact-qnty
    23159                           .
    23160                       tt-gds-list2.itog-qnty = tt-gds-list2.doc-qnty - tt-gds-list2.fact-qnty .
    23161                   end.
    23162                   else
    23163                   do:
    23164                       assign
    23165                           tt-gds-list2.doc-qnty  = tt-gds-list2.doc-qnty + buf_doc-line.doc-qnty
    23166                           tt-gds-list2.fact-qnty = tt-gds-list2.doc-qnty - tt-gds-list2.itog-qnty
    23167                           .
    23168                   end.
    23169               end.
    23170           end.
    23171           for each tt-gds-list2 no-lock:
    23172               find first tt-gds-list where tt-gds-list.gds-code = tt-gds-list2.gds-code no-error .
    23173               if not available (tt-gds-list) then
    23174               do:
    23175                   create tt-gds-list .
    23176                   buffer-copy tt-gds-list2 to tt-gds-list .
    23177               end.
    23178               else
    23179               do:
    23180                   if p-question = 1 then
    23181                   do:
    23182                       assign
    23183                           tt-gds-list.doc-qnty  = tt-gds-list.doc-qnty + tt-gds-list2.doc-qnty
    23184                           tt-gds-list.fact-qnty = tt-gds-list.doc-qnty - tt-gds-list.itog-qnty
    23185                           .
    23186                   end.
    23187                   else
    23188                   do:
    23189                       assign
    23190                           tt-gds-list.doc-qnty  = tt-gds-list2.doc-qnty
    23191                           tt-gds-list.fact-qnty = tt-gds-list2.fact-qnty
    23192                           .
    23193                       tt-gds-list.itog-qnty = tt-gds-list.doc-qnty - tt-gds-list.fact-qnty .
    23194                   end.
    23195               end.
    23196           end.
    23197           for each buf_doc-line exclusive-lock where buf_doc-line.doc-code = bf_trn-doc.doc-code:
    23198               find first ub.goods where ub.goods.artic     = buf_doc-line.artic     and
    23199                   ub.goods.prod-type = buf_doc-line.prod-type and
    23200                   ub.goods.prod-code = buf_doc-line.prod-code no-lock.
    23201               for each ub.marking-attr exclusive-lock where (ub.marking-attr.attr-code = "inv-doc" or ub.marking-attr.attr-code = "inv-doc-scan")
    23202                   and can-find (first ub.marking where ub.marking.mark = ub.marking-attr.mark and ub.marking.gds-code = ub.goods.gds-code):
    23203                   delete ub.marking-attr.
    23204               end.
    23205               for each ub.utd no-lock where ub.utd.doc-code = buf_doc-line.doc-code:
    23206                   for each ub.utd-lines exclusive-lock where ub.utd-lines.db-num = ub.utd.db-num
    23207                       and ub.utd-lines.doc-id =  ub.utd.doc-id and ub.utd-lines.gds-code = ub.goods.gds-code:
    23208                       for each ub.utd-lines-attr exclusive-lock where ub.utd-lines-attr.db-num = ub.utd-lines.db-num
    23209                           and ub.utd-lines-attr.doc-id = ub.utd-lines.doc-id
    23210                           and ub.utd-lines-attr.LineNum = ub.utd-lines.LineNum:
    23211                           delete ub.utd-lines-attr.
    23212                       end.
    23213                       for each ub.utd-marking-lines exclusive-lock where ub.utd-marking-lines.db-num = ub.utd-lines.db-num
    23214                           and ub.utd-marking-lines.doc-id = ub.utd-lines.doc-id
    23215                           and ub.utd-marking-lines.LineNum = ub.utd-lines.LineNum:
    23216                           delete ub.utd-marking-lines.
    23217                       end.
    23218                       delete ub.utd-lines.
    23219                   end.
    23220               end.
    23221               run local-reclcinv in this-procedure ( input "old":U ).
    23222               run local-reclcinv in this-procedure ( input "delete":U ).
    23223               run str/dellninv.p ( buffer buf_doc-line ).
    23224           end.
    23225           tr:
    23226           for each tt-gds-list
    23227               break by tt-gds-list.nn
    23228               on error undo tr, next tr
    23229               :
    23230               find ub.goods no-lock
    23231                   where  ub.goods.gds-code = tt-gds-list.gds-code .
    23232               assign
    23233                   lns-cnt = lns-cnt + 1
    23234                   .
    23235               run gds-attr-value (
    23236                   input ub.goods.gds-code,
    23237                   input 'mark-type':U,
    23238                   output v-marking-type,
    23239                   output v-type
    23240                   ).
    23241               if can-find (first ub.doc-line where ub.doc-line.doc-code = bf_trn-doc.doc-code)
    23242                   then
    23243               do:
    23244                   if v-marking-type <> "" and v-marking-type <> "not-type" and
    23245                       ((not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(bf_trn-doc.obj-type, bf_trn-doc.obj-code):GetIsMarkingForType(v-marking-type) and (v-is-marking = true))
    23246                       or (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(bf_trn-doc.obj-type, bf_trn-doc.obj-code):GetIsMarkingForType(v-marking-type) and v-is-marking = false))
    23247                       then
    23248                   do:
    23249                       message
    23250                           substitute("Ошибка при добавлении строки инвентаризации. Совместное добавление товаров, подлежащих маркировке и не подлежащих маркировке, запрещено.") skip
    23251                           view-as alert-box error .
    23252                       undo tr, next tr.
    23253                   end.
    23254               end.
    23255               else
    23256               do:
