    21171         pardoc-rec = recid (t-doc).
    21172         run str/d-alcdoc.w (pardoc-rec).
    21173       end.
    21174       apply "entry" to br-docs in frame d-all-docs.
    21175     end.
    21176   end procedure.
    21177   procedure proc-m_gen-6 :
