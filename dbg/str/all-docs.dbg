     8351   ON CHOOSE OF MENU-ITEM m-scaner-add in menu m-scaner DO:
     8352   define variable v-blob-uniq-key-rec as character no-undo .
     8353   define variable v-part-num as integer   no-undo .
     8354   define variable v-blob-db-num as integer   no-undo .
     8355   define variable v-int64-id as int64 no-undo .
     8356   define variable p-exe-name as character no-undo .
     8357   define variable p-fl-name as character no-undo .
     8358   define variable p-jpg-name as character no-undo .
     8359     p-exe-name = string(session :temp-directory) + 'qscan.exe' .
     8360     p-fl-name  = string(session :temp-directory) + 'qs_done.dat' .
     8361     p-jpg-name = string(session :temp-directory) + 'qs.jpg' .
     8362     if not available t-doc then return .
     8363     message
     8364       'Вы хотите сканировать бумажный носитель и записать его изображение в БД по документу №' t-doc.doc-code
     8365       '?'
     8366       view-as alert-box question
     8367       buttons yes-no
     8368       update v-ok as logical
     8369       .
     8370       if v-ok = false then return .
     8371       assign
     8372         FILE-INFO :FILE-NAME = p-exe-name
     8373       .
     8374       IF INDEX(FILE-INFO:FILE-TYPE, "F")  = 0 then  do:
     8375         message 'Не обнаружено программы для сканирования '
     8376         p-exe-name
     8377         view-as alert-box information .
     8378         return .
     8379       end.
     8380       define variable chr-res    as character no-undo .
     8381       define variable v-cmd-line as character no-undo .
     8382       define variable v-tmp-f as character no-undo .
     8383       v-cmd-line =  substitute(p-exe-name + ' ShowUI filename &1&2&1' ,  chr(34) , p-jpg-name ) .
     8384       run gbl/syn6.p
     8385         (input v-cmd-line
     8386         ,input p-fl-name
     8387         ,input "Ждите! ..."
     8388         ,output chr-res
     8389         ) no-error .
     8390       run gen-key-rec in this-procedure (
     8391            input  'trn-doc':U
     8392           ,input  buffer t-doc:handle
     8393           ,output v-blob-uniq-key-rec ).
     8394         v-blob-db-num = ? .
     8395         v-int64-id = 0 .
     8396         run gbl/file2blb.p ( input 'ДОБАВЛЕНИЕ':U
     8397                             ,input  "yes"
     8398                             ,input (buffer t-doc:handle)
     8399                             ,input v-blob-uniq-key-rec
     8400                             ,input 'trn-doc-image':U
     8401                             ,input 'trn-doc-image':U
     8402                             ,input-output v-part-num
     8403                             ,input 'data':U
     8404                             ,input-output v-blob-db-num
     8405                             ,input-output v-int64-id
     8406                             ,input p-jpg-name
     8407                             ) no-error .
     8408         if error-status :error then do:
     8409           message
     8410             vss-workfile vss-revision vss-description skip
     8411             error-status :get-message(1) skip
     8412             return-value skip
     8413             "Ошибка записи BLOB в   БД"
     8414             view-as alert-box error
     8415           .
     8416         end.
     8417         run local-value-changed .
