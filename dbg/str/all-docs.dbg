    21850           message "БД документа с кодом " bf_trn-doc.doc-code " не coвпадает с текущей БД." skip
    21851                 "Текущая БД: " v-cntxt-db-num skip "БД док-та: " v-doc-db-num
    21852           view-as alert-box error.
    21853           next.
    21854         end.
    21855         if bf_trn-doc.cr-factur = yes then do:
    21856            message "По документу " bf_trn-doc.doc-code " уже создавался счет-фактура от " bf_trn-doc.factur-date " числа." view-as alert-box.
    21857         end.
