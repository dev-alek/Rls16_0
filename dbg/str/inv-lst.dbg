        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        6   define input param inv-code like trn-doc.doc-code no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: 6e7a63c8908d, 2425, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        9   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:46 2020 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: inv-lst.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/inv-lst.p $":U .
       12   define variable vss-description as character no-undo init "Формирование списка документов, мешающих инвентаризации ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define new shared temp-table gds-list no-undo like ub.goods
       73     field qnty   as decimal
       74     field to-del as logical
       75     field order-num as integer
       76     field to-sel as logical
       77     field promo-code as character
       78     field ActionId  as int64
       79     field db-num as integer
       80     index art  is primary unique artic prod-type prod-code
       81     index code is         unique gds-code
       82     index oi order-num
       83     index isel to-sel
       84     .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define  new shared  temp-table gds-list-hist no-undo
       87   field list-table as character
       88   field id as integer
       89   field line as integer
       90   field hist-mode as character
       91   field des as character
       92   field num-recs as integer
       93   field option_ as character
       94   field item_ as character
       95   field status_ as character
       96   field num-add as integer
       97   field num-ignored as integer
       98   field done as logical
       99   field err_ as logical
      100   field err-mes as character
      101   index pi is primary
      102   id
      103   line
      104   index isdone
      105   done
      106   .
      107   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   define variable v-waitfram-action01         as character   no-undo .
      109   define variable v-waitfram-action02         as character   no-undo .
      110   define variable v-waitfram-action03         as character   no-undo .
      111   define variable mWaitFramTextBeg            as character   no-undo.
      112   define variable mWaitFramTextEnd            as character   no-undo.
      113   define variable mWaitFramView               as logical     no-undo.
      114   define variable mWaitProcEvent              as logical     no-undo init yes.
      115   define variable mWaitFramInterval           as integer     no-undo init 1 .
      116   define variable mWaitFramStop               as logical     no-undo.
      117   define variable mWaitFramStopUser           as logical     no-undo.
      118   define variable mWaitFramStopTimeOut        as logical     no-undo.
      119   define variable mWaitFramStartProc          as datetime-tz no-undo.
      120   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      121   define button B-WaitFramStop auto-end-key
      122        label "Стоп"
      123        size 10 by 1 tooltip "Остоновить процесс".
      124   define button B-viewProcInfo
      125        label "Информация"
      126        size 15 by 1 tooltip "Информация о процесс".
      127   define frame waitfram
      128     v-waitfram-action01 format "x(72)" no-label skip
      129     v-waitfram-action02 format "x(72)" no-label skip
      130     v-waitfram-action03 format "x(72)" no-label skip
      131     B-viewProcInfo
      132     B-WaitFramStop at row 4 col 30
      133     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      134     .
      135   define new global shared variable mBatchMode as logical no-undo init ?.
      136   define variable mFramBachModHandle as handle no-undo.
      137   mFramBachModHandle = frame waitfram:handle.
      138   define variable mFameOldVis as logical no-undo.
      139   define variable mVisCUrentVin as logical no-undo.
      140   if session:batch-mode
      141   then
      142      mBatchMode = yes.
      143   if mBatchMode = ? then do:
      144     mVisCUrentVin = current-window:visible.
      145     mFameOldVis = mFramBachModHandle:visible.
      146     mFramBachModHandle:visible  = yes.
      147     mBatchMode = mFramBachModHandle:visible ne yes.
      148     mFramBachModHandle:visible = mFameOldVis.
      149     current-window:visible = mVisCUrentVin.
      150   end.
      151    if  log-manager:logfile-name ne ?
      152     then DO:
      153         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      154         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      155         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      156     end.
      157   on choose of B-WaitFramStop in frame waitfram
      158   do:
      159     mWaitFramStop = yes.
      160     mWaitFramStopUser = yes.
      161   end.
      162   function waitfram-check-timeout returns logical():
      163      define variable vtime as int64 no-undo.
      164      if mWaitFramStopTimeOut
      165      then
      166         return yes.
      167      vtime = ( now - mWaitFramStartProc ) / 1000 .
      168      if     mWaitFramTimeOut ne ?
      169         and mWaitFramTimeOut ne 0
      170         and mWaitFramTimeOut lt vtime
      171      then do:
      172         mWaitFramStopTimeOut = yes.
      173      end.
      174      return mWaitFramStopTimeOut.
      175   end.
      176   procedure waitfram-hide :
      177     if not session:batch-mode
      178     then do
      179     on error undo, return error return-value
      180     :
      181       pause 0 before-hide .
      182       if not mBatchMode then
      183         hide frame waitfram .
      184     if     not mWaitFramView
      185        and mWaitProcEvent
      186     then
      187       process events .
      188     end.
      189   end procedure.
      190   procedure waitfram-show :
      191     define input  parameter p-message as character no-undo .
      192     define variable v-left-margin as integer   no-undo .
      193     if not session:batch-mode
      194     then do
      195     on error undo, return error return-value
      196     :
      197       if length(p-message) <= 70 then do:
      198         assign
      199           v-left-margin = integer((70 - length(p-message)) / 2)
      200         .
      201         assign
      202           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      203         .
      204         assign
      205           v-waitfram-action01 = " "
      206           v-waitfram-action02 = " "
      207                                    + fill(" ", v-left-margin)
      208                                    + p-message
      209           v-waitfram-action03 = " "
      210         .
      211       end.
      212       else do:
      213         define variable vRindex1 as integer no-undo.
      214         define variable vRindex2 as integer no-undo.
      215         vRindex1 = r-index(p-message," ",70).
      216         if vRindex1 = 0
      217         then
      218            vRindex1 = 70.
      219         if length(p-message)  <= vRindex1 + 70 then do:
      220           assign
      221             v-waitfram-action01 = " "
      222             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      223             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      224           .
      225         end.
      226         else do:
      227           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      228           if vRindex2 <= vRindex1
      229           then
      230              vRindex2 = vRindex1 + 70.
      231           assign
      232             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      233             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      234             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      235           .
      236         end.
      237       end.
      238       B-viewProcInfo:visible   in frame waitfram = no.
      239       B-viewProcInfo:sensitive in frame waitfram = no.
      240       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      241       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      242       if  (   mWaitFramView
      243          or  mWaitProcEvent)
      244          and not mBatchMode
      245       then
      246          display
      247             v-waitfram-action01 skip
      248             v-waitfram-action02 skip
      249             v-waitfram-action03 skip
      250          with frame waitfram .
      251       if     mWaitFramView
      252          then do:
      253             if     mWaitFramInterval ne ?
      254                and not mBatchMode
      255             then
      256                wait-for go of frame waitfram pause mWaitFramInterval.
      257          end.
      258          else
      259             if     mWaitProcEvent
      260                and not mBatchMode
      261             then
      262                process events .
      263     end.
      264   end procedure.
      265      procedure waitfram-show-this:
      266         define input  parameter iInterval as int64 no-undo.
      267         define variable vtime as int64 no-undo.
      268         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      269         mWaitFramInterval = iInterval.
      270         run waitfram-show (substitute("&1&2 &3&4" ,
      271                                       mWaitFramTextBeg ,
      272                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      273                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      274                                       mWaitFramTextEnd
      275                                      )
      276                           ).
      277      end.
      278      procedure WaitFramRunPause:
      279         define input  parameter iInterval as dec no-undo.
      280         define variable vStart  as datetime-tz no-undo.
      281         define variable vend    as datetime-tz no-undo.
      282         define variable vint as int64 no-undo.
      283         define variable vOk as logical no-undo.
      284         vStart = now.
      285         vend   = vStart.
      286         publish "WaitFramPause" (iInterval,output vOk).
      287         vend   =  now.
      288         vint = vend - vStart.
      289         vint = iInterval - vint / 1000.
      290         if     not mWaitFramStop
      291            and (   vint > 0
      292                 or (    not vOk
      293                     and iInterval eq ?
      294                     )
      295                 )
      296         then
      297            run waitfram-show-this (iInterval).
      298         vend   =  now.
      299         vint = vend - vStart.
      300         vint = iInterval - vint / 1000.
      301         if     not mWaitFramStop
      302            and vint > 0
      303         then do:
      304            run gbl/pause.p (vint * 1000).
      305         end.
      306         if iInterval ne ?
      307         then
      308            publish "WaitFramStop".
      309         waitfram-check-timeout().
      310      end.
      311      procedure WaitFramWaitFor:
      312         define input  parameter iInterval as dec no-undo.
      313         assign
      314            mWaitFramStartProc   = now
      315            mWaitFramStopUser    = no
      316            mWaitFramStopTimeOut = no
      317         .
      318         block-wait:
      319         do while not mWaitFramStop:
      320            run WaitFramRunPause (iInterval).
      321            if  waitfram-check-timeout()
      322            then do:
      323               leave block-wait.
      324            end.
      325         end.
      326         run waitfram-hide.
      327      end.
      328   procedure waitfram-join :
      329     define input  parameter p-line-1  as character no-undo .
      330     define input  parameter p-line-2  as character no-undo .
      331     define input  parameter p-line-3  as character no-undo .
      332     define output parameter p-message as character no-undo .
      333     do
      334     on error undo, return error return-value
      335     :
      336       assign
      337         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      338                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      339                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      340       .
      341     end.
      342   end procedure.
      343   function waitfram-join-function returns character
      344     (input p-line-1 as character
      345     ,input p-line-2 as character
      346     ,input p-line-3 as character
      347     ).
      348     define variable v-message as character no-undo .
      349     run waitfram-join in this-procedure
      350       (input  p-line-1
      351       ,input  p-line-2
      352       ,input  p-line-3
      353       ,output v-message
      354       ) .
      355     return v-message .
      356   end function .
      357   define variable fill-gds-list as log no-undo.
      358   define variable doc-cnt as integer no-undo.
      359   define variable lns-cnt as integer no-undo .
      360   define variable line-rec as recid no-undo .
      361   fill-gds-list = no.
      362   message
      363   "Сформировать также и список ТОВАРОВ, мешающих инвентаризации?" skip (2)
      364   "Да - сформировать, Нет - пропустить"
      365   view-as alert-box question buttons YES-NO update fill-gds-list.
      366   lst-calc:
      367   do on stop undo lst-calc, return error on error undo lst-calc, return error :
      368     run waitfram-show in this-procedure ("Очистка старого списка документов.  ЖДИТЕ ...").
      369     for each trn-doc where trn-doc.inv-num = inv-code
      370          on stop undo lst-calc, return error on error undo lst-calc, return error :
      371       if trn-doc.status_ = 'запрос':U then next.
      372       if trn-doc.doc-type = 'инв':U and trn-doc.status_ = 'накл':U then next.
      373       trn-doc.inv-num = "".
      374     end.
      375     run waitfram-show in this-procedure ("Формирование списка документов, мешающих инвентаризации.  ЖДИТЕ ...").
      376     assign
      377       doc-cnt = 0
      378       lns-cnt = 0
      379       .
      380     for each doc-line where doc-line.doc-code = inv-code no-lock,
      381    each parts no-lock
      382           where
      383               (     parts.prod-type = doc-line.prod-type
      384                 and parts.prod-code = doc-line.prod-code
      385                 and parts.artic     = doc-line.artic
      386                 and parts.obj-type  = doc-line.obj-type
      387                 and parts.obj-code  = doc-line.obj-code
      388                 and parts.rsrv-free = true
      389                 and parts.status_   = false
      390                 and parts.out-code  <> 'free-zone':U
      391                 and parts.out-code  <> inv-code
      392               )
      393               or
      394               (     parts.prod-type = doc-line.prod-type
      395                 and parts.prod-code = doc-line.prod-code
      396                 and parts.artic     = doc-line.artic
      397                 and parts.obj-type  = doc-line.obj-type
      398                 and parts.obj-code  = doc-line.obj-code
      399                 and parts.rsrv-free = false
      400                 and parts.status_   = false
      401                 and parts.out-code  <> 'out-zone':U
      402                 and parts.out-code  <> inv-code
      403               )
      404          on stop undo lst-calc, return error on error undo lst-calc, return error :
      405       find trn-doc where trn-doc.doc-code = parts.out-code no-error.
      406       if not available trn-doc or trn-doc.inv-num = inv-code then next.
      407       trn-doc.inv-num = inv-code.
      408       doc-cnt = doc-cnt + 1.
      409       if fill-gds-list then do:
      410           find first goods no-lock
      411                where goods.artic     = doc-line.artic
      412                  and goods.prod-type = doc-line.prod-type
      413                  and goods.prod-code = doc-line.prod-code
      414           .
      415   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   find gds-list
      417     where gds-list.prod-type = goods.prod-type
      418       and gds-list.prod-code = goods.prod-code
      419       and gds-list.artic     = goods.artic
      420     no-error .
      421   if available gds-list then do:
      422     assign
      423       gds-list.to-del = no
      424     .
      425   end.
      426   else do:
      427     define variable v-last3 as integer no-undo .
      428     find last gds-list use-index oi no-error.
      429     if available gds-list then do:
      430       v-last3 = gds-list.order-num .
      431     end.
      432     else do:
      433       v-last3 = 0 .
      434     end.
      435     create gds-list .
      436     buffer-copy goods to gds-list
      437     assign
      438       gds-list.to-del = no
      439       gds-list.order-num = v-last3 + 1
      440     .
      441     assign
      442       lns-cnt = lns-cnt + 1
      443       line-rec = recid (gds-list)
      444     .
      445   end.
      446       end.
      447       if (doc-cnt modulo 5 = 0) or (lns-cnt modulo 5 = 0) then
      448         run waitfram-show in this-procedure ("Документов в списке : " + string (doc-cnt) + "     Товаров в списке : " + string (lns-cnt)).
      449     end.
      450     run waitfram-hide in this-procedure .
      451   end.
      452   message
      453   "Мешают включению инвентаризации :" doc-cnt "документов," skip
      454   "Или :" lns-cnt "товаров.".
      455   if fill-gds-list then do:
      456     run str/gds-list.w (parparentproc, p-curr-host-code, p-curr-obj-type, p-curr-obj-code).
      457   end.
