        1   DEFINE TEMP-TABLE temp-obj NO-UNDO LIKE ub.inkas
        2          field fact-order as decimal
        3          field c-inkas-code like ub.c-inkas.inkas-code
        4          field chip-num like ub.c-inkas.chip-num
        5          field orig-inkas-code like ub.inkas.inkas-code
        6          field orig-fact-order as decimal
        7          field orig-c-inkas-code like ub.c-inkas.inkas-code
        8          field orig-chip-num like ub.c-inkas.chip-num
        9          field is-new as logical
       10          index pi is unique primary
       11          obj-type obj-code inkas-code
       12          index idel
       13          is-del.
       14   define input parameter parparentproc as widget-handle no-undo .
       15   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
       17   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
       18   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
       19   define input parameter p-cre-db-num     as integer      no-undo .
       20   define input parameter p-task-type      as character    no-undo.
       21   define input parameter p-task-num       as integer      no-undo.
       22   define input parameter p-action         as character    no-undo.
       23   define output parameter p-cancel        as logical      no-undo.
       24   define output parameter p-params        as character    no-undo.
       25   define variable vss-revision    as character no-undo init "$Revision$":U .
       26   define variable vss-author      as character no-undo init "$Author$":U .
       27   define variable vss-date        as character no-undo init "$Date$":U .
       28   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       29   define variable vss-archive     as character no-undo init "$Archive$":U .
       30   define variable vss-description as character no-undo init "Параметры досылки файлов, недошедших до POS IBM-XML".
       31   procedure vss-get-info :
       32     define output parameter p-vss-revision    like vss-revision    no-undo .
       33     define output parameter p-vss-author      like vss-author      no-undo .
       34     define output parameter p-vss-date        like vss-date        no-undo .
       35     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       36     define output parameter p-vss-archive     like vss-archive     no-undo .
       37     define output parameter p-vss-description like vss-description no-undo .
       38     assign
       39       p-vss-revision    = vss-revision
       40       p-vss-author      = vss-author
       41       p-vss-date        = vss-date
       42       p-vss-workfile    = vss-workfile
       43       p-vss-archive     = vss-archive
       44       p-vss-description = vss-description
       45     .
       46   end procedure.
       47   procedure vss-get-parameters :
       48     define output parameter p-vss-parameters as character no-undo .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define variable v-waitfram-action01         as character   no-undo .
       87   define variable v-waitfram-action02         as character   no-undo .
       88   define variable v-waitfram-action03         as character   no-undo .
       89   define variable mWaitFramTextBeg            as character   no-undo.
       90   define variable mWaitFramTextEnd            as character   no-undo.
       91   define variable mWaitFramView               as logical     no-undo.
       92   define variable mWaitProcEvent              as logical     no-undo init yes.
       93   define variable mWaitFramInterval           as integer     no-undo init 1 .
       94   define variable mWaitFramStop               as logical     no-undo.
       95   define variable mWaitFramStopUser           as logical     no-undo.
       96   define variable mWaitFramStopTimeOut        as logical     no-undo.
       97   define variable mWaitFramStartProc          as datetime-tz no-undo.
       98   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       99   define button B-WaitFramStop auto-end-key
      100        label "Стоп"
      101        size 10 by 1 tooltip "Остоновить процесс".
      102   define button B-viewProcInfo
      103        label "Информация"
      104        size 15 by 1 tooltip "Информация о процесс".
      105   define frame waitfram
      106     v-waitfram-action01 format "x(72)" no-label skip
      107     v-waitfram-action02 format "x(72)" no-label skip
      108     v-waitfram-action03 format "x(72)" no-label skip
      109     B-viewProcInfo
      110     B-WaitFramStop at row 4 col 30
      111     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      112     .
      113   define new global shared variable mBatchMode as logical no-undo init ?.
      114   define variable mFramBachModHandle as handle no-undo.
      115   mFramBachModHandle = frame waitfram:handle.
      116   define variable mFameOldVis as logical no-undo.
      117   define variable mVisCUrentVin as logical no-undo.
      118   if session:batch-mode
      119   then
      120      mBatchMode = yes.
      121   if mBatchMode = ? then do:
      122     mVisCUrentVin = current-window:visible.
      123     mFameOldVis = mFramBachModHandle:visible.
      124     mFramBachModHandle:visible  = yes.
      125     mBatchMode = mFramBachModHandle:visible ne yes.
      126     mFramBachModHandle:visible = mFameOldVis.
      127     current-window:visible = mVisCUrentVin.
      128   end.
      129    if  log-manager:logfile-name ne ?
      130     then DO:
      131         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      132         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      133         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      134     end.
      135   on choose of B-WaitFramStop in frame waitfram
      136   do:
      137     mWaitFramStop = yes.
      138     mWaitFramStopUser = yes.
      139   end.
      140   function waitfram-check-timeout returns logical():
      141      define variable vtime as int64 no-undo.
      142      if mWaitFramStopTimeOut
      143      then
      144         return yes.
      145      vtime = ( now - mWaitFramStartProc ) / 1000 .
      146      if     mWaitFramTimeOut ne ?
      147         and mWaitFramTimeOut ne 0
      148         and mWaitFramTimeOut lt vtime
      149      then do:
      150         mWaitFramStopTimeOut = yes.
      151      end.
      152      return mWaitFramStopTimeOut.
      153   end.
      154   procedure waitfram-hide :
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       pause 0 before-hide .
      160       if not mBatchMode then
      161         hide frame waitfram .
      162     if     not mWaitFramView
      163        and mWaitProcEvent
      164     then
      165       process events .
      166     end.
      167   end procedure.
      168   procedure waitfram-show :
      169     define input  parameter p-message as character no-undo .
      170     define variable v-left-margin as integer   no-undo .
      171     if not session:batch-mode
      172     then do
      173     on error undo, return error return-value
      174     :
      175       if length(p-message) <= 70 then do:
      176         assign
      177           v-left-margin = integer((70 - length(p-message)) / 2)
      178         .
      179         assign
      180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      181         .
      182         assign
      183           v-waitfram-action01 = " "
      184           v-waitfram-action02 = " "
      185                                    + fill(" ", v-left-margin)
      186                                    + p-message
      187           v-waitfram-action03 = " "
      188         .
      189       end.
      190       else do:
      191         define variable vRindex1 as integer no-undo.
      192         define variable vRindex2 as integer no-undo.
      193         vRindex1 = r-index(p-message," ",70).
      194         if vRindex1 = 0
      195         then
      196            vRindex1 = 70.
      197         if length(p-message)  <= vRindex1 + 70 then do:
      198           assign
      199             v-waitfram-action01 = " "
      200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      202           .
      203         end.
      204         else do:
      205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      206           if vRindex2 <= vRindex1
      207           then
      208              vRindex2 = vRindex1 + 70.
      209           assign
      210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      213           .
      214         end.
      215       end.
      216       B-viewProcInfo:visible   in frame waitfram = no.
      217       B-viewProcInfo:sensitive in frame waitfram = no.
      218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       if  (   mWaitFramView
      221          or  mWaitProcEvent)
      222          and not mBatchMode
      223       then
      224          display
      225             v-waitfram-action01 skip
      226             v-waitfram-action02 skip
      227             v-waitfram-action03 skip
      228          with frame waitfram .
      229       if     mWaitFramView
      230          then do:
      231             if     mWaitFramInterval ne ?
      232                and not mBatchMode
      233             then
      234                wait-for go of frame waitfram pause mWaitFramInterval.
      235          end.
      236          else
      237             if     mWaitProcEvent
      238                and not mBatchMode
      239             then
      240                process events .
      241     end.
      242   end procedure.
      243      procedure waitfram-show-this:
      244         define input  parameter iInterval as int64 no-undo.
      245         define variable vtime as int64 no-undo.
      246         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      247         mWaitFramInterval = iInterval.
      248         run waitfram-show (substitute("&1&2 &3&4" ,
      249                                       mWaitFramTextBeg ,
      250                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      251                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      252                                       mWaitFramTextEnd
      253                                      )
      254                           ).
      255      end.
      256      procedure WaitFramRunPause:
      257         define input  parameter iInterval as dec no-undo.
      258         define variable vStart  as datetime-tz no-undo.
      259         define variable vend    as datetime-tz no-undo.
      260         define variable vint as int64 no-undo.
      261         define variable vOk as logical no-undo.
      262         vStart = now.
      263         vend   = vStart.
      264         publish "WaitFramPause" (iInterval,output vOk).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and (   vint > 0
      270                 or (    not vOk
      271                     and iInterval eq ?
      272                     )
      273                 )
      274         then
      275            run waitfram-show-this (iInterval).
      276         vend   =  now.
      277         vint = vend - vStart.
      278         vint = iInterval - vint / 1000.
      279         if     not mWaitFramStop
      280            and vint > 0
      281         then do:
      282            run gbl/pause.p (vint * 1000).
      283         end.
      284         if iInterval ne ?
      285         then
      286            publish "WaitFramStop".
      287         waitfram-check-timeout().
      288      end.
      289      procedure WaitFramWaitFor:
      290         define input  parameter iInterval as dec no-undo.
      291         assign
      292            mWaitFramStartProc   = now
      293            mWaitFramStopUser    = no
      294            mWaitFramStopTimeOut = no
      295         .
      296         block-wait:
      297         do while not mWaitFramStop:
      298            run WaitFramRunPause (iInterval).
      299            if  waitfram-check-timeout()
      300            then do:
      301               leave block-wait.
      302            end.
      303         end.
      304         run waitfram-hide.
      305      end.
      306   procedure waitfram-join :
      307     define input  parameter p-line-1  as character no-undo .
      308     define input  parameter p-line-2  as character no-undo .
      309     define input  parameter p-line-3  as character no-undo .
      310     define output parameter p-message as character no-undo .
      311     do
      312     on error undo, return error return-value
      313     :
      314       assign
      315         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      316                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      317                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      318       .
      319     end.
      320   end procedure.
      321   function waitfram-join-function returns character
      322     (input p-line-1 as character
      323     ,input p-line-2 as character
      324     ,input p-line-3 as character
      325     ).
      326     define variable v-message as character no-undo .
      327     run waitfram-join in this-procedure
      328       (input  p-line-1
      329       ,input  p-line-2
      330       ,input  p-line-3
      331       ,output v-message
      332       ) .
      333     return v-message .
      334   end function .
      335   define new global shared variable g#language as character no-undo .
      336   if g#language <> '' and g#language <> 'rus':U then do:
      337     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      338   end.
      339   define new global shared variable g#library  as handle no-undo .
      340   define new global shared variable g#library2 as handle no-undo .
      341   define   shared variable g#auto as logical no-undo.
      342   define   shared variable g#news as logical no-undo.
      343   define   shared variable g#oxml as logical no-undo.
      344   define   shared variable g#esys as logical no-undo.
      345   define   shared variable g#news-source-db as integer no-undo.
      346   define   shared variable g#esys-source-esys as integer no-undo.
      347   define   shared variable g#db-num as integer   no-undo .
      348   define   shared variable g#userid as character no-undo .
      349   define   shared variable g#passwd as character no-undo .
      350   procedure proc-alt-shift-f2:
      351     if not ibs.th.gbl.gbl-var:rcode
      352   then
      353     run gbl\inidebug.p .
      354   end.
      355   procedure proc-alt-shift-f3:
      356     run gbl/prvssinf.p
      357       ( input this-procedure
      358       ) .
      359   end.
      360   define variable v-inform-launched as logical no-undo initial false .
      361   procedure proc-alt-shift-f4:
      362     define variable v-action as character no-undo .
      363     if v-inform-launched = false then do:
      364       assign
      365         v-inform-launched = true
      366       .
      367       run gbl/d-inform.w
      368         (  input self
      369         ,  input this-procedure
      370         , output v-action
      371         ) no-error .
      372       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      373       assign
      374         v-inform-launched = false
      375       .
      376     end.
      377   end.
      378   procedure proc-alt-f1:
      379     run gbl/corrhelp.p
      380       (input this-procedure
      381       ) .
      382   end .
      383   on alt-shift-f2 anywhere do:
      384     run proc-alt-shift-f2.
      385   end.
      386   on alt-shift-f3 anywhere do:
      387     run proc-alt-shift-f3 in this-procedure .
      388   end.
      389   on alt-shift-f4 anywhere do:
      390     run proc-alt-shift-f4 in this-procedure.
      391   end.
      392   on alt-f1 anywhere do:
      393     run proc-alt-f1 in this-procedure .
      394   end.
      395   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   define temp-table temp-schedule-free no-undo
      397   field free-id as character
      398   field free-task-name as character
      399   field proc-run-name as character
      400   field proc-param-edit-name as character
      401   field conf-param as character
      402   field is-gbd as logical
      403   field is-ubd as logical
      404   field enable-concurrent-0 as logical
      405   field enable-concurrent-db as logical
      406   field other-info as character
      407   field enc-key as character
      408   field is-rum as logical
      409   index pi is unique primary
      410   free-id.
      411   procedure schedule-attr-name :
      412   do
      413     on error undo, return error
      414     :
      415     define input  parameter p-code           as character no-undo .
      416     define output parameter p-type           as character no-undo .
      417     define output parameter p-format         as character no-undo .
      418     define output parameter p-label          as character no-undo .
      419     define output parameter p-user-can-edit  as logical   no-undo .
      420     define output parameter p-output-display as logical   no-undo .
      421     define output parameter p-other          as character no-undo .
      422       if index(p-code, chr(4)) > 0 then do:
      423         p-code = entry(1, p-code, chr(4)).
      424       end.
      425       case p-code :
      426               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      427               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      428               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      429               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      430               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      431               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      432               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      433               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      434               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      435         otherwise do:
      436           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      437         end.
      438       end.
      439     end.
      440   end procedure.
      441   procedure schedule-attr-tooltip :
      442   do
      443     on error undo, return error
      444     :
      445       define input  parameter p-code    as character no-undo .
      446       define output parameter p-tooltip as character no-undo .
      447       define output parameter p-label   as character no-undo .
      448       if index(p-code, chr(4)) > 0 then do:
      449         p-code = entry(1, p-code, chr(4)).
      450       end.
      451       case p-code :
      452               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      453               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      454               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      455               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      456               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      457               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      458               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      459               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      460               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      461         otherwise do:
      462               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      463         end.
      464       end.
      465     end.
      466   end procedure.
      467   procedure schedule-attr-value :
      468   do
      469   on error undo, return error return-value
      470   :
      471   define input parameter  p-cre-db-num as integer    no-undo.
      472   define input parameter  p-task-type  as character  no-undo.
      473   define input parameter  p-task-num   as integer    no-undo.
      474   define input parameter  p-code       as character  no-undo.
      475   define output parameter p-value      as character  no-undo.
      476   define output parameter p-type       as character  no-undo.
      477       define variable v-format         as character no-undo .
      478       define variable v-label          as character no-undo .
      479       define variable v-user-can-edit  as logical   no-undo .
      480       define variable v-output-display as logical   no-undo .
      481       define variable v-other          as character no-undo .
      482       define buffer buf_schedule-attr for ub.schedule-attr.
      483       run schedule-attr-name in this-procedure (
      484             input  p-code
      485           , output p-type
      486           , output v-format
      487           , output v-label
      488           , output v-user-can-edit
      489           , output v-output-display
      490           , output v-other
      491       ) no-error .
      492       if error-status :error
      493       then do:
      494           undo, return error return-value .
      495       end.
      496       if p-code begins ('schd-free-id':U + chr(4))
      497       and entry(2, p-code, chr(4)) = '':U then do:
      498         find first buf_schedule-attr no-lock
      499             where buf_schedule-attr.cre-db-num = p-cre-db-num
      500               and buf_schedule-attr.task-type  = p-task-type
      501               and buf_schedule-attr.task-num   = p-task-num
      502               and buf_schedule-attr.attr-code  begins p-code
      503         no-error .
      504       end.
      505       else do:
      506         find first buf_schedule-attr no-lock
      507             where buf_schedule-attr.cre-db-num = p-cre-db-num
      508               and buf_schedule-attr.task-type  = p-task-type
      509               and buf_schedule-attr.task-num   = p-task-num
      510               and buf_schedule-attr.attr-code  = p-code
      511         no-error .
      512       end.
      513       if available buf_schedule-attr
      514       then do:
      515           assign
      516               p-value = buf_schedule-attr.attr-value
      517           .
      518       end.
      519       else do:
      520         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      521            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      522         end.
      523         else do:
      524           assign
      525               p-value = if p-type = 'L':U then "no":U else ""
      526           .
      527         end.
      528       end.
      529   end.
      530   end procedure.
      531   procedure schedule-attr-write :
      532   do
      533   on error undo, return error
      534   :
      535   define input parameter p-cre-db-num  as integer   no-undo.
      536   define input parameter p-task-type   as character no-undo.
      537   define input parameter p-task-num    as integer   no-undo.
      538   define input parameter p-code        as character no-undo.
      539   define input parameter p-value       as character no-undo.
      540       define variable v-type              as character                no-undo.
      541       define variable v-format            as character                no-undo.
      542       define variable v-label             as character                no-undo.
      543       define variable v-user-can-edit     as logical                  no-undo.
      544       define variable v-output-display    as logical                  no-undo.
      545       define variable v-other             as character                no-undo.
      546       define buffer buf_schedule-attr for ub.schedule-attr .
      547       run schedule-attr-name in this-procedure (
      548             input  p-code
      549           , output v-type
      550           , output v-format
      551           , output v-label
      552           , output v-user-can-edit
      553           , output v-output-display
      554           , output v-other
      555       ) no-error.
      556       if error-status :error
      557       then do:
      558           undo, return error return-value.
      559       end.
      560       find first buf_schedule-attr exclusive-lock
      561            where buf_schedule-attr.cre-db-num = p-cre-db-num
      562              and buf_schedule-attr.task-type  = p-task-type
      563              and buf_schedule-attr.task-num   = p-task-num
      564              and buf_schedule-attr.attr-code  = p-code
      565       no-error.
      566       if not available buf_schedule-attr
      567       then do:
      568           create buf_schedule-attr.
      569           assign
      570             buf_schedule-attr.cre-db-num = p-cre-db-num
      571             buf_schedule-attr.task-type  = p-task-type
      572             buf_schedule-attr.task-num   = p-task-num
      573             buf_schedule-attr.attr-code  = p-code
      574             buf_schedule-attr.attr-value = p-value
      575           .
      576       end.
      577       else do:
      578           assign
      579               buf_schedule-attr.attr-value = p-value
      580           .
      581       end.
      582   end.
      583   end procedure.
      584   procedure schedule-attr-delete :
      585   do
      586   on error undo, return error
      587   :
      588   define input  parameter p-cre-db-num  as integer   no-undo.
      589   define input  parameter p-task-type   as character no-undo.
      590   define input  parameter p-task-num    as integer   no-undo.
      591   define input  parameter p-code        as character no-undo.
      592   define output parameter p-deleted     as logical   no-undo.
      593       define buffer buf_schedule-attr for ub.schedule-attr .
      594       define variable v-type              as character                no-undo.
      595       define variable v-format            as character                no-undo.
      596       define variable v-label             as character                no-undo.
      597       define variable v-user-can-edit     as logical                  no-undo.
      598       define variable v-output-display    as logical                  no-undo.
      599       define variable v-other             as character                no-undo.
      600       run schedule-attr-name in this-procedure (
      601             input p-code
      602           , output v-type
      603           , output v-format
      604           , output v-label
      605           , output v-user-can-edit
      606           , output v-output-display
      607           , output v-other
      608       ) no-error .
      609       if error-status :error
      610       then do:
      611           undo, return error return-value .
      612       end.
      613       find first buf_schedule-attr exclusive-lock
      614            where buf_schedule-attr.cre-db-num = p-cre-db-num
      615              and buf_schedule-attr.task-type  = p-task-type
      616              and buf_schedule-attr.task-num   = p-task-num
      617              and buf_schedule-attr.attr-code  = p-code
      618       no-error.
      619       if not available buf_schedule-attr
      620       then do:
      621           assign
      622               p-deleted = no
      623           .
      624       end.
      625       else do:
      626           delete buf_schedule-attr.
      627           assign
      628               p-deleted = yes
      629           .
      630       end.
      631   end.
      632   end procedure.
      633   procedure schedule-attr-news :
      634   do
      635   on error undo, return error
      636   :
      637       define input  parameter p-code           as character no-undo .
      638       define output parameter p-news           as logical   no-undo .
      639       if index(p-code, chr(4)) > 0 then do:
      640         p-code = entry(1, p-code, chr(4)).
      641       end.
      642       case p-code :
      643               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      644               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      645               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      646               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      647               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      648               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      649               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      650               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      651               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      652         otherwise do:
      653           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      654         end.
      655       end.
      656   end.
      657   end procedure.
      658   procedure schedule-attr-extract-logical :
      659   do
      660   on error undo, return error
      661   :
      662   define input  parameter p-parameter-number   as integer      no-undo.
      663   define input  parameter p-parameter-list     as character    no-undo.
      664   define output parameter p-parameter-value   as logical      no-undo.
      665       if num-entries( p-parameter-list ) > p-parameter-number - 1
      666       then do:
      667           assign
      668               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      669           .
      670       end.
      671       else do:
      672           assign
      673               p-parameter-value   = no
      674           .
      675       end.
      676   end.
      677   end procedure.
      678   procedure schedule-attr-get-free-id :
      679   do
      680   on error undo, return error return-value
      681   :
      682     define input  parameter p-cre-db-num  as integer   no-undo.
      683     define input  parameter p-task-type   as character no-undo.
      684     define input  parameter p-task-num    as integer   no-undo.
      685     define output parameter p-free-id     as character no-undo.
      686     define buffer buf_schedule-attr for ub.schedule-attr.
      687     find first buf_schedule-attr no-lock
      688         where buf_schedule-attr.cre-db-num = p-cre-db-num
      689           and buf_schedule-attr.task-type  = p-task-type
      690           and buf_schedule-attr.task-num   = p-task-num
      691           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      692     no-error .
      693     if available buf_schedule-attr then
      694     assign
      695     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      696     no-error
      697     .
      698   end.
      699   end procedure.
      700   procedure schedule-attr-get-free-props :
      701     define input parameter p-free-id as character no-undo .
      702     define output parameter p-value as character no-undo .
      703     define buffer buf_temp-schedule-free for temp-schedule-free.
      704     do
      705     on error undo, return error return-value
      706     :
      707       find first buf_temp-schedule-free no-lock no-error .
      708       if not available buf_temp-schedule-free then do:
      709         run schedule-attr-fill-free-props in this-procedure .
      710       end.
      711       find first buf_temp-schedule-free where
      712               buf_temp-schedule-free.free-id = p-free-id no-error.
      713       if available buf_temp-schedule-free then do:
      714         assign
      715         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      716                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      717                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      718                   buf_temp-schedule-free.conf-param           + chr(4) +
      719                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      720                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      721                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      722                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      723                   buf_temp-schedule-free.other-info
      724         .
      725       end.
      726       else do:
      727        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      728                              "id произвольной задачи - &5"
      729                              ,vss-workfile
      730                              ,vss-revision
      731                              ,vss-description
      732                              ,chr(10)
      733                              ,p-free-id).
      734       end.
      735     end.
      736   end procedure.
      737   procedure schedule-attr-is-rum-free-id :
      738   define input parameter p-free-id as character no-undo .
      739   define output parameter p-is-rum as logical no-undo .
      740   define buffer buf_temp-schedule-free for temp-schedule-free.
      741   do
      742   on error undo, return error
      743   :
      744       find first buf_temp-schedule-free no-lock no-error .
      745       if not available buf_temp-schedule-free then do:
      746         run schedule-attr-fill-free-props in this-procedure .
      747       end.
      748       find first buf_temp-schedule-free where
      749               buf_temp-schedule-free.free-id = p-free-id no-error.
      750       if available buf_temp-schedule-free
      751       and buf_temp-schedule-free.is-rum
      752       then do:
      753         p-is-rum = yes.
      754       end.
      755   end.
      756   end procedure.
      757   procedure schedule-attr-fill-free-props :
      758   define variable v-path                    as character                no-undo .
      759   DEFINE VARIABLE v-full-path               as character                no-undo .
      760   DEFINE VARIABLE v-file-name               as character                no-undo .
      761   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      762   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      763   define buffer buf_temp-schedule-free for temp-schedule-free.
      764   define variable v-answer as logical no-undo .
      765     do
      766     on error undo, return error substitute("&1 &2 &3&4&5&4"
      767                                           ,vss-workfile
      768                                           ,vss-revision
      769                                           ,vss-description
      770                                           ,chr(10)
      771                                           ,error-status:get-message(1) )
      772     :
      773       run gbl/filename.p (
      774                       input 'cmp/shd-free.d'
      775                     ,output v-full-path
      776                     ,output v-path
      777                     ,output v-file-name
      778                     ,output v-file-name-no-ext
      779                     ,output v-file-name-ext
      780                     ) .
      781       input from value(v-full-path).
      782       repeat :
      783         create buf_temp-schedule-free.
      784         import buf_temp-schedule-free.
      785       END.
      786       input close.
      787       _ff:
      788       for each buf_temp-schedule-free :
      789         if buf_temp-schedule-free.free-id = '':U then do:
      790            delete buf_temp-schedule-free.
      791            next _ff.
      792          end.
      793          run schedule-attr-check-enc in this-procedure (
      794                                                       input  buf_temp-schedule-free.free-id
      795                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      796                                                               buf_temp-schedule-free.proc-param-edit-name +
      797                                                               buf_temp-schedule-free.conf-param +
      798                                                               string(buf_temp-schedule-free.is-gbd) +
      799                                                               string(buf_temp-schedule-free.is-ubd) +
      800                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      801                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      802                                                               string(buf_temp-schedule-free.other-info)
      803                                                               )
      804                                                       ,input  buf_temp-schedule-free.enc-key
      805                                                       ,output v-answer    ) no-error .
      806          if error-status:error
      807          or not v-answer then delete buf_temp-schedule-free.
      808        end.
      809     end.
      810   end procedure.
      811   Function schedule-attr-reverse returns character (str as character).
      812      define variable rev_incl_s as character init "" no-undo .
      813      define variable rev_incl_i as integer no-undo .
      814      define variable rev_incl_l as integer no-undo .
      815      rev_incl_l = length(str).
      816      do rev_incl_i = 1 to rev_incl_l:
      817         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      818      end.
      819      return rev_incl_s.
      820   end.
      821   procedure schedule-attr-check-enc.
      822     define input  parameter p-free-id   as character no-undo .
      823     define input  parameter p-value     as character no-undo .
      824     define input  parameter p-enc-value as character no-undo .
      825     define output parameter p-answer    as logical   no-undo .
      826     define variable tmp         as character no-undo .
      827     define variable v-enc-value as character no-undo .
      828     assign
      829     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      830     .
      831     run schedule-attr-pswd-enc in this-procedure
      832       ( input tmp
      833        ,output v-enc-value
      834       ) no-error .
      835     if error-status:error then do:
      836       message
      837         vss-workfile vss-revision vss-description skip
      838         "Ошибка при вызове процедуры pswd-enc" skip
      839         return-value skip
      840         error-status :get-message(1) skip
      841         view-as alert-box error .
      842       undo, return error .
      843     end.
      844     if v-enc-value = p-enc-value then do:
      845       assign
      846         p-answer = true
      847       .
      848     end.
      849     else do:
      850       assign
      851         p-answer = false
      852       .
      853     end.
      854   end.
      855   procedure schedule-attr-conf-enc.
      856     define input  parameter p-free-id   as character no-undo .
      857     define input  parameter p-value     as character no-undo .
      858     define output parameter p-enc-value as character no-undo .
      859     define variable tmp         as character no-undo .
      860     assign
      861       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      862     .
      863     run schedule-attr-pswd-enc in this-procedure
      864       ( input tmp
      865        ,output p-enc-value
      866       ) no-error .
      867     if error-status:error then do:
      868       message
      869         vss-workfile vss-revision vss-description skip
      870         "Ошибка при вызове процедуры pswd-enc" skip
      871         return-value skip
      872         error-status :get-message(1) skip
      873         view-as alert-box error .
      874       undo, return error .
      875     end.
      876   end procedure.
      877   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   procedure schedule-attr-pswd-enc :
      879     define input parameter  pswd     as character no-undo .
      880     define output parameter enc-pswd as character no-undo .
      881     do
      882     on error undo, return error return-value
      883     :
      884       assign
      885         enc-pswd = encode(pswd + string(index(pswd, "k")))
      886       .
      887     end.
      888   end procedure.
      889   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   procedure cur-time :
      891      define output parameter p-today as date      no-undo .
      892      define output parameter p-time  as integer   no-undo .
      893     do
      894     on error undo, return error
      895     :
      896       define variable v-date1 as date      no-undo .
      897       define variable v-date2 as date      no-undo .
      898       define variable v-time  as integer   no-undo .
      899       assign
      900         v-date1 = today
      901         v-time  = time
      902         v-date2 = today
      903       .
      904       if v-date1 <> v-date2
      905       then do:
      906         assign
      907           v-date1 = today
      908           v-time  = v-time
      909         .
      910       end.
      911       assign
      912         p-today = v-date1
      913         p-time  = v-time
      914       .
      915     end.
      916   end.
      917   function cur-time-date returns character
      918   :
      919     return string(today, '99/99/9999':U) .
      920   end.
      921   function cur-time-mjd returns decimal
      922   :
      923     define variable v-date as date      no-undo .
      924     define variable v-time as integer   no-undo .
      925     run cur-time in this-procedure
      926       (output v-date
      927       ,output v-time
      928       ) .
      929     return integer(v-date) - 2400002 + (v-time / 86400) .
      930   end.
      931   function cur-time-get-ending-index returns integer
      932   (input p-number as integer
      933   )
      934   :
      935     if p-number < 0
      936     or p-number = ?
      937     then do:
      938       return 1 .
      939     end.
      940     define variable v-rest as integer   no-undo .
      941     assign
      942       p-number = p-number modulo 100
      943     .
      944     if p-number < 20
      945     then do:
      946       assign
      947         v-rest = p-number
      948       .
      949     end.
      950     else do:
      951       assign
      952         v-rest = p-number modulo 10
      953       .
      954     end.
      955     case v-rest :
      956       when 1
      957       then do:
      958         return 2 .
      959       end.
      960       when 2 or
      961       when 3 or
      962       when 4
      963       then do:
      964         return 3 .
      965       end.
      966       otherwise do:
      967         return 1 .
      968       end.
      969     end case .
      970   end.
      971   procedure cur-time-mjd-to-date :
      972      define input  parameter i-mjd-diff as decimal no-undo.
      973      define output parameter o-Date     as date    no-undo.
      974      define output parameter o-Time     as integer no-undo.
      975      define variable v-day-number as integer   no-undo .
      976      if    i-mjd-diff < 0
      977         or i-mjd-diff = ?
      978      then do:
      979         return "?" .
      980      end.
      981      assign
      982         v-day-number = truncate(i-mjd-diff,0).
      983         o-Date = date(v-day-number + 2400002).
      984         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      985     .
      986   end.
      987   function cur-time-mjd-to-string returns character
      988   (input p-mjd-diff as decimal
      989   )
      990   :
      991     define variable v-day-number as integer   no-undo .
      992     define variable v-seconds    as integer   no-undo .
      993     define variable v-hour       as integer   no-undo .
      994     define variable v-min        as integer   no-undo .
      995     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      996     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      997     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      998     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      999     if p-mjd-diff < 0
     1000     or p-mjd-diff = ?
     1001     then do:
     1002       return "?" .
     1003     end.
     1004     assign
     1005       v-day-number = integer(truncate(p-mjd-diff,0))
     1006       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1007     .
     1008     if v-seconds > 86400
     1009     then do:
     1010       assign
     1011         v-seconds = 86400 - 1
     1012       .
     1013     end.
     1014     if v-seconds < 0
     1015     then do:
     1016       assign
     1017         v-seconds = 0
     1018       .
     1019     end.
     1020     assign
     1021       v-hour = truncate(v-seconds / 3600, 0)
     1022     .
     1023     assign
     1024       v-seconds = v-seconds modulo 3600
     1025     .
     1026     assign
     1027       v-min = truncate(v-seconds / 60, 0)
     1028     .
     1029     assign
     1030       v-seconds = v-seconds modulo 60
     1031     .
     1032     return
     1033         (if v-day-number <> 0
     1034           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1035           else ""
     1036         )
     1037       + (if v-day-number <> 0 or v-hour <> 0
     1038           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1039           else ""
     1040         )
     1041       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1042           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1043           else ""
     1044         )
     1045       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1046       .
     1047   end.
     1048   function cur-time-string returns character
     1049   :
     1050     define variable v-date as date      no-undo .
     1051     define variable v-time as integer   no-undo .
     1052     run cur-time in this-procedure
     1053       (output v-date
     1054       ,output v-time
     1055       ) .
     1056     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1057   end.
     1058   function cur-time-string-sec returns character
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1067   end.
     1068   function cur-time-custom  returns character
     1069   (input p-prefix as character
     1070   ,input p-date-format as character
     1071   ,input p-delimiter as character
     1072   ,input p-time-format as character
     1073   ,input p-suffix as character
     1074   )
     1075   :
     1076     define variable v-date as date      no-undo .
     1077     define variable v-time as integer   no-undo .
     1078     run cur-time in this-procedure
     1079       (output v-date
     1080       ,output v-time
     1081       ) .
     1082     return
     1083       p-prefix
     1084       + string(v-date, p-date-format)
     1085       + p-delimiter
     1086       + string(v-time, p-time-format)
     1087       + p-suffix
     1088       .
     1089   end.
     1090   function cur-time-print  returns character
     1091   :
     1092     define variable v-date as date      no-undo .
     1093     define variable v-time as integer   no-undo .
     1094     run cur-time in this-procedure
     1095       (output v-date
     1096       ,output v-time
     1097       ) .
     1098     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1099   end.
     1100   function cur-time-datetime returns datetime
     1101   :
     1102     define variable v-char as character no-undo .
     1103     define variable v-datetime as datetime no-undo .
     1104     v-char = cur-time-string().
     1105     v-datetime = datetime(v-char).
     1106     return  v-datetime.
     1107   end.
     1108   function cur-time-string-msec returns character
     1109   :
     1110     define variable v-date as datetime  no-undo .
     1111     v-date = now.
     1112     return string(v-date) .
     1113   end.
     1114   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   PROCEDURE verify-ini-entry:
     1116   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1117   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1118   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1119   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1120   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1121   define variable v-mess as character no-undo .
     1122   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1123   if ini-entry-value = ? and ini-key-name begins "spl"
     1124   then
     1125   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1126   if ini-entry-value = ? and ini-key-name begins "sav"
     1127   then
     1128   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1129   if ini-entry-value = ? then do:
     1130     assign
     1131     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1132                       , chr(10)
     1133                       , ini-section-name
     1134                       , ini-key-name
     1135                       , error-msg-text).
     1136       if not silence then do:
     1137         message
     1138         v-mess
     1139         view-as alert-box ERROR  .
     1140         return error.
     1141       end.
     1142       else do:
     1143         return error v-mess.
     1144       end.
     1145   end.
     1146   END PROCEDURE.
     1147   PROCEDURE verify-file:
     1148   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1149   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1150   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1151   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1152   file-info:file-name = filename.
     1153   found = NOT (file-info:full-pathname = ?).
     1154   if NOT found  then do:
     1155     if not silence then do:
     1156       message error-msg-text
     1157       view-as alert-box ERROR.
     1158       return error.
     1159     end.
     1160     else return error error-msg-text.
     1161   end.
     1162   END PROCEDURE.
     1163   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164     define variable v-cntxt-db-num        as integer   no-undo .
     1165     define variable v-cntxt-userid        as character no-undo .
     1166     define variable v-cntxt-level         as character no-undo .
     1167     define variable v-cntxt-host-code-obj as integer   no-undo .
     1168     define variable v-cntxt-obj-type      as character no-undo .
     1169     define variable v-cntxt-obj-code      as integer   no-undo .
     1170     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1171     define variable v-cntxt-is-admin      as logical   no-undo .
     1172   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   procedure low-ascii :
     1174   define input parameter p-string as character no-undo .
     1175   define input parameter p-silence as logical no-undo .
     1176   define variable ii as integer no-undo .
     1177   define variable v-symbol as character no-undo .
     1178   define variable v-mess as character no-undo .
     1179     do
     1180     on error undo, return error return-value
     1181     :
     1182        do ii = 1 to length(p-string):
     1183          v-symbol = substring(p-string, ii, 1).
     1184          if asc(v-symbol) > 127 then do:
     1185             v-mess =  substitute("Неверный символ &1 в строке &2", v-symbol, p-string).
     1186             if not p-silence then do:
     1187               message
     1188               v-mess
     1189               view-as alert-box error .
     1190             end.
     1191             undo, return error .
     1192          end.
     1193        end.
     1194     end.
     1195   end procedure.
     1196   DEFINE VARIABLE v-dir AS CHARACTER NO-UNDO.
     1197   DEFINE BUTTON b-dir-sel
     1198        IMAGE-UP FILE "btn-down-arrow":U
     1199        IMAGE-DOWN FILE "btn-down-arrow":U
     1200        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1201        LABEL "..."
     1202        SIZE 3.63 BY 1.04.
     1203   DEFINE BUTTON B-exit AUTO-GO
     1204        LABEL "&Ввод"
     1205        SIZE 10 BY 1
     1206        BGCOLOR 8 .
     1207   DEFINE BUTTON B-Help
     1208        LABEL "Помо&щь"
     1209        SIZE 10 BY 1
     1210        BGCOLOR 8 .
     1211   DEFINE BUTTON b-quit AUTO-END-KEY
     1212        LABEL "&Отмена"
     1213        SIZE 10 BY 1
     1214        BGCOLOR 8 .
     1215   DEFINE VARIABLE f-rs-dir-label AS CHARACTER FORMAT "X(256)":U INITIAL "Настройка директории недоставленных до кассы файлов"
     1216         VIEW-AS TEXT
     1217        SIZE 51 BY .67
     1218        FGCOLOR 4  NO-UNDO.
     1219   DEFINE VARIABLE v-dir-name AS CHARACTER FORMAT "X(256)":U
     1220        LABEL "Директория"
     1221        VIEW-AS FILL-IN
     1222        SIZE 82.5 BY 1
     1223        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1224   DEFINE VARIABLE rs-dir AS CHARACTER
     1225        VIEW-AS RADIO-SET VERTICAL
     1226        RADIO-BUTTONS
     1227             "берется из Ini-файла ([kassa-ibm-xml] out=)\undelivered", "ini",
     1228   "привязана к строке расписания", "other"
     1229        SIZE 65 BY 2 NO-UNDO.
     1230   DEFINE FRAME Dialog-Frame
     1231        B-exit AT ROW 1 COL 1
     1232        b-quit AT ROW 1 COL 11
     1233        B-Help AT ROW 1 COL 54.88
     1234        rs-dir AT ROW 4 COL 2 NO-LABEL
     1235        b-dir-sel AT ROW 5 COL 70
     1236        v-dir-name AT ROW 7.25 COL 13 COLON-ALIGNED
     1237        f-rs-dir-label AT ROW 2.75 COL 2.5 COLON-ALIGNED NO-LABEL
     1238        SPACE(42.24) SKIP(5.53)
     1239       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1240            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1241            TITLE "Параметры досылки файлов, недоставленных до POS IBM-XML"
     1242            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1243   ASSIGN
     1244          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1245          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1246   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1247   DO:
     1248     APPLY "END-ERROR":U TO SELF.
     1249   END.
     1250   ON CHOOSE OF b-dir-sel IN FRAME Dialog-Frame
     1251   DO:
     1252     define variable c-dir-name  as character no-undo.
     1253     define variable c-dir-type  as character no-undo.
     1254     define variable l-can-write as logical   no-undo.
     1255   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1256   if lookup(self :type
     1257            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1258            ) = 0
     1259   then do:
     1260     message
     1261       "$Workfile$"
     1262       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1263       "Интерфейсный элемент" self :name  skip
     1264       "Тип" self :type  skip
     1265       "Процедура" this-procedure :file-name skip
     1266       view-as alert-box .
     1267   end.
     1268   else do:
     1269     apply "entry":u to self  .
     1270     if focus :handle <> self :handle  then do:
     1271       return no-apply .
     1272     end.
     1273   end.
     1274     run gbl/dir-sel.p ( output c-dir-name, output c-dir-type, output l-can-write ).
     1275     if c-dir-name = '':U or c-dir-name = ? or
     1276        c-dir-type = '':U or c-dir-type = ? then do:
     1277       return no-apply.
     1278     end.
     1279     if l-can-write <> yes then do:
     1280       message 'Вы не имеете права писать в выбранную директорию:' c-dir-name view-as alert-box error.
     1281       return no-apply.
     1282     end.
     1283     assign  v-dir-name = c-dir-name.
     1284     display v-dir-name with frame Dialog-Frame.
     1285       .
     1286   END.
     1287   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1288   DO:
     1289     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1290     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1291     APPLY "GO" TO FRAME Dialog-Frame.
     1292   END.
     1293   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1294   DO:
     1295         assign
     1296           p-cancel = yes
     1297       .
     1298   END.
     1299   ON VALUE-CHANGED OF rs-dir IN FRAME Dialog-Frame
     1300   DO:
     1301     ASSIGN
     1302     rs-dir.
     1303     CASE rs-dir:
     1304         WHEN 'ini' THEN DO:
     1305            HIDE
     1306            b-dir-sel
     1307            IN FRAME Dialog-Frame.
     1308         END.
     1309         OTHERWISE DO:
     1310             DISPLAY
     1311             b-dir-sel
     1312             with FRAME Dialog-Frame.
     1313             ENABLE
     1314             b-dir-sel
     1315             with FRAME Dialog-Frame.
     1316        END.
     1317     END CASE.
     1318   END.
     1319   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1320   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1321   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   on help of frame Dialog-Frame
     1323   do:
     1324     run gbl/app_help.p
     1325       (input this-procedure :file-name
     1326       ,input ''
     1327       ,input ?
     1328       ) no-error.
     1329     if error-status :error then do:
     1330       message
     1331         "Ошибка при вызове помощи"
     1332         error-status :get-message(1)
     1333         view-as alert-box .
     1334     end.
     1335   end.
     1336   run minbtn-set in this-procedure .
     1337   on choose of b-help in frame Dialog-Frame
     1338   do:
     1339     apply "help":u to frame Dialog-Frame .
     1340   end.
     1341   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   procedure minbtn-set :
     1343       do
     1344           on error undo, return error return-value
     1345           :
     1346           define variable ii              as integer       no-undo .
     1347           define variable fh              as widget-handle no-undo .
     1348           define variable hh              as widget-handle no-undo .
     1349           define variable v-h             as handle        extent 4 no-undo .
     1350           define variable v-name-button   as character     no-undo .
     1351           define variable v-help-old-x    as decimal       no-undo .
     1352           define variable v-help-old-y    as decimal       no-undo .
     1353           define variable v-help-old-size as decimal       no-undo .
     1354           define variable v-frame-width   as decimal       no-undo .
     1355           define variable jj              as integer       no-undo .
     1356           do
     1357               on error undo, return error
     1358               :
     1359               assign
     1360                   v-frame-width = frame Dialog-Frame:width - 0.3
     1361                   fh            = frame Dialog-Frame:first-child
     1362                   hh            = fh:first-child
     1363                   ii            = 1
     1364                   .
     1365               do while valid-handle(hh):
     1366                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1367                   do:
     1368                       case lc(hh:name) :
     1369                           when "b-help" then
     1370                               do:
     1371                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1372                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1373                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1374                                   hh:TOOLTIP = "Помощь" .
     1375                                   v-help-old-x = hh:column .
     1376                                   v-help-old-y = hh:row    .
     1377                                   v-help-old-size = hh:width .
     1378                                   hh:width-chars = 2.5 .
     1379                               end.
     1380                           when "b-print" then
     1381                               do:
     1382                                   hh:load-image("cmp/b-print.bmp":u) .
     1383                                   hh:TOOLTIP = "Печать" .
     1384                                   v-h[ii] = hh:handle .
     1385                                   ii = ii + 1 .
     1386                                   hh:width-chars = 3 .
     1387                               end.
     1388                           when "b-history" or
     1389                           when "b-hist" then
     1390                               do:
     1391                                   hh:load-image("cmp/b-hist.bmp":u) .
     1392                                   hh:TOOLTIP = "История" .
     1393                                   v-h[ii] = hh:handle .
     1394                                   ii = ii + 1 .
     1395                                   hh:width-chars = 3 .
     1396                               end.
     1397                           when "b-sch" then
     1398                               do:
     1399                                   hh:load-image("cmp/b-sch.bmp":u) .
     1400                                   hh:TOOLTIP = "Установка Фильтра" .
     1401                                   v-h[ii] = hh:handle .
     1402                                   ii = ii + 1 .
     1403                                   hh:width-chars = 3 .
     1404                               end.
     1405                           when "b-hist-user" then
     1406                               do:
     1407                                   hh:load-image("cmp/b-hist.bmp":u) .
     1408                                   hh:TOOLTIP = "История пользователя" .
     1409                                   ii = ii + 1 .
     1410                               end.
     1411                       end case.
     1412                   end.
     1413                   hh = hh:next-sibling.
     1414               end.
     1415               b-help:column = v-frame-width - b-help:width-chars.
     1416               jj = 0.
     1417               repeat ii = 4 to 1 by -1 :
     1418                   if valid-handle (v-h[ii] ) then
     1419                   do:
     1420                       jj  = jj + 1 .
     1421                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1422                       v-h[ii]:row    = v-help-old-y .
     1423                   end.
     1424               end.
     1425           end.
     1426       end.
     1427   end procedure.
     1428   MAIN-BLOCK:
     1429   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1430      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1431   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432     run mainmenu_getcntxt in parparentproc
     1433       (output v-cntxt-db-num
     1434       ,output v-cntxt-userid
     1435       ,output v-cntxt-level
     1436       ,output v-cntxt-host-code-obj
     1437       ,output v-cntxt-obj-type
     1438       ,output v-cntxt-obj-code
     1439       ,output v-cntxt-db-num-obj
     1440       ,output v-cntxt-is-admin
     1441       ) .
     1442     if p-mode = 'shd':U then do:
     1443       assign
     1444       frame Dialog-Frame :title = frame Dialog-Frame :title +
     1445                         substitute(". &1: Задача номер &2"
     1446                         , p-task-type
     1447                         , p-task-num )
     1448       .
     1449     end.
     1450     run init-param-values in this-procedure (
     1451         input p-cre-db-num
     1452       , input p-task-type
     1453       , input p-task-num
     1454       , OUTPUT v-dir-name).
     1455     RUN init-fields in this-procedure .
     1456     RUN Myenable in this-procedure .
     1457     apply "value-changed" to rs-dir.
     1458     WAIT-FOR GO OF FRAME Dialog-Frame.
     1459   END.
     1460   RUN disable_UI.
     1461   PROCEDURE attach-attr-to-schedule-line :
     1462   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1463   define buffer buf_schedule      for ub.schedule.
     1464   define buffer buf_schedule-attr for ub.schedule-attr.
     1465   define buffer lock-batchprocess for ub.batchprocess.
     1466   CASE p-mode:
     1467     when 'shd':U then do:
     1468         run gbl/lock-prc.p
     1469             (input 'schd':U
     1470             ,input 'rsndxibm':U
     1471             ,input 0
     1472             ,input 0
     1473             ,input '':U
     1474             ,input ""
     1475             ,input ""
     1476             ,input (
     1477                     "Досылка файлов, недоставленных до POS IBM-XML"
     1478                   )
     1479             ,input yes
     1480             ,buffer lock-batchprocess
     1481             ) no-error .
     1482         FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1483                    buf_schedule-attr.cre-db-num = p-cre-db-num
     1484                and buf_schedule-attr.task-type  = p-task-type
     1485                and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'rsndxibm') NO-ERROR.
     1486         IF AVAILABLE  buf_schedule-attr
     1487             AND buf_schedule-attr.task-num <> p-task-num
     1488             AND buf_schedule-attr.task-num <> - 1
     1489             and p-task-num <> - 1
     1490             THEN DO:
     1491           MESSAGE
     1492           substitute("Уже есть расписание для досылки файлов, недоставленных до POS IBM-XML. номер расписания &1"
     1493                      ,buf_schedule-attr.task-num)
     1494           VIEW-AS ALERT-BOX ERROR.
     1495           UNDO, RETURN ERROR.
     1496         END.
     1497         find first buf_schedule no-lock
     1498              where buf_schedule.cre-db-num = p-cre-db-num
     1499                and buf_schedule.task-type  = p-task-type
     1500                and buf_schedule.task-num   = p-task-num
     1501         no-error.
     1502         if not available buf_schedule
     1503         and (  p-task-type   <> 'autofree':U
     1504             or p-task-num    <> -1 )
     1505         then do:
     1506             message
     1507               vss-workfile vss-revision vss-description
     1508               skip "Не найдена строка расписания."
     1509               skip return-value
     1510               skip trim(error-status :get-message(1))
     1511                    trim(error-status :get-message(2))
     1512                    trim(error-status :get-message(3))
     1513             view-as alert-box error.
     1514             undo, return error .
     1515         end.
     1516       run schedule-attr-write in this-procedure (
     1517             input p-cre-db-num
     1518           , input p-task-type
     1519           , input p-task-num
     1520           , input 'schedule-param-list':U
     1521           , input p-param-list
     1522       ).
     1523     end.
     1524     when 'run':U then do:
     1525       p-params = p-param-list.
     1526     end.
     1527   END CASE.
     1528   END PROCEDURE.
     1529   PROCEDURE disable_UI :
     1530     HIDE FRAME Dialog-Frame.
     1531   END PROCEDURE.
     1532   PROCEDURE enable_UI :
     1533     DISPLAY rs-dir v-dir-name f-rs-dir-label
     1534         WITH FRAME Dialog-Frame.
     1535     ENABLE B-exit b-quit B-Help rs-dir b-dir-sel
     1536         WITH FRAME Dialog-Frame.
     1537     VIEW FRAME Dialog-Frame.
     1538   END PROCEDURE.
     1539   PROCEDURE init-fields :
     1540   DEFINE VARIABLE v-out AS CHARACTER NO-UNDO.
     1541   DEFINE VARIABLE glog AS logical NO-UNDO.
     1542   ASSIGN
     1543   rs-dir = (if v-dir = 'ini' then v-dir else 'other').
     1544   IF rs-dir = "ini":u THEN DO:
     1545       run verify-ini-entry in this-procedure (
     1546                                            INPUT  'out'
     1547                                           ,INPUT  'kassa-ibm-xml'
     1548                                           ,INPUT substitute("отсутствует параметр &1 секция &2 в ini-файле"
     1549                                                             , 'out'
     1550                                                             , 'kassa-ibm-xml')
     1551                                           ,INPUT no
     1552                                           ,output v-out) no-error .
     1553       if error-status:error or v-out = ? then return error return-value .
     1554       RUN verify-file in this-procedure (
     1555                                          input v-out
     1556                                         ,input substitute("Не найден каталог &1 параметр &2, секция &3 ini-файла"
     1557                                                       , v-out
     1558                                                       , 'kassa-ibm-xml'
     1559                                                      , 'out')
     1560                                         ,input no
     1561                                         ,output glog) no-error.
     1562       if error-status:error or not glog then return error return-value .
     1563     v-dir-name = v-out + "undelivered":U.
     1564   END.
     1565   ELSE DO:
     1566       RUN verify-file in this-procedure (
     1567                                          input v-dir
     1568                                         ,input substitute("Не найден каталог &1"
     1569                                                       , v-dir
     1570                                                       )
     1571                                         ,input no
     1572                                         ,output glog) no-error.
     1573       if error-status:error or not glog then do:
     1574         v-dir-name = "".
     1575       end.
     1576       else do:
     1577         v-dir-name = v-dir.
     1578      end.
     1579   END.
     1580   END PROCEDURE.
     1581   PROCEDURE init-param-values :
     1582   do
     1583   on error undo, return error
     1584   :
     1585   define input parameter p-cre-db-num             as integer      no-undo .
     1586   define input parameter p-task-type              as character    no-undo.
     1587   define input parameter p-task-num               as integer      no-undo.
     1588   define output parameter p-dir                   as character    no-undo.
     1589   define variable v-param-list    as character     no-undo.
     1590   define variable v-param-type    as character     no-undo.
     1591   define variable ii as integer   no-undo .
     1592   define variable v-entry  as character no-undo .
     1593   define variable v-task-num as integer   no-undo .
     1594   define buffer buf_schedule for ub.schedule.
     1595   define buffer buf_schedule-attr for ub.schedule-attr.
     1596     CASE p-mode:
     1597       when 'shd':U then do:
     1598         if p-task-num > 0 then do:
     1599           v-task-num = p-task-num.
     1600         end.
     1601         else do:
     1602           for each buf_schedule no-lock where
     1603                   buf_schedule.cre-db-num = p-cre-db-num
     1604               AND buf_schedule.task-type = p-task-type,
     1605               first buf_schedule-attr no-lock where
     1606                     buf_schedule-attr.cre-db-num = p-cre-db-num
     1607                 AND buf_schedule-attr.task-type = p-task-type
     1608                 AND buf_schedule-attr.task-num = buf_schedule.task-num
     1609                 AND buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'rsndxibm') :
     1610              v-task-num = buf_schedule.task-num.
     1611              leave .
     1612           end.
     1613         end.
     1614         if v-task-num > 0 then do:
     1615           run schedule-attr-value in this-procedure (
     1616                 input p-cre-db-num
     1617               , input p-task-type
     1618               , input v-task-num
     1619               , input 'schedule-param-list':U
     1620               , output v-param-list
     1621               , output v-param-type
     1622           ) NO-ERROR.
     1623         end.
     1624         if v-param-list = '':U then
     1625         v-param-list = 'ini' .
     1626       END.
     1627       WHEN 'run' THEN DO:
     1628         assign
     1629         v-param-list = 'ini'.
     1630       END.
     1631     END CASE.
     1632     ASSIGN
     1633     v-dir = entry(1, v-param-list, chr(4))
     1634     .
     1635   END.
     1636   END PROCEDURE.
     1637   PROCEDURE MyEnable :
     1638   CASE p-mode:
     1639       WHEN 'run':U THEN DO:
     1640           ASSIGN
     1641           rs-dir:RADIO-BUTTONS IN FRAME Dialog-Frame
     1642                                = "берется из Ini-файла ([kassa-IBM-XML] out=)\undelivered" + chr(44) +
     1643                                  "ini":U + chr(44) +
     1644                                  "задать директорию недоставленных файлов" + chr(44) +
     1645                                  "other".
     1646       END.
     1647       WHEN 'shd':U THEN DO:
     1648           ASSIGN
     1649           rs-dir:RADIO-BUTTONS = "берется из Ini-файла ([kassa-IBM-XML] out=)\undelivered" + chr(44) +
     1650                                  "ini":U + chr(44) +
     1651                                  "задать директорию недоставленных файлов" + chr(44) +
     1652                                  "other".
     1653       END.
     1654   END CASE.
     1655   DISPLAY
     1656   rs-dir
     1657   f-rs-dir-label
     1658   v-dir-name
     1659   WITH FRAME Dialog-Frame.
     1660   ENABLE
     1661   B-exit
     1662   b-quit
     1663   B-Help
     1664   rs-dir
     1665   b-dir-sel WHEN rs-dir <> 'Ini':U
     1666   WITH FRAME Dialog-Frame.
     1667   VIEW FRAME Dialog-Frame.
     1668   END PROCEDURE.
     1669   PROCEDURE proc-save :
     1670   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1671   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     1672   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     1673   define variable ii as integer   no-undo .
     1674   define variable v-exists as logical no-undo .
     1675   ASSIGN
     1676   FRAME Dialog-Frame
     1677   rs-dir
     1678   .
     1679   IF rs-dir <> 'ini' THEN DO:
     1680       ASSIGN
     1681       v-dir-name.
     1682       RUN verify-file in this-procedure
     1683                                         ( input v-dir-name
     1684                                         , input substitute("Не найден каталог &1"
     1685                                                       , v-dir-name)
     1686                                         ,input no
     1687                                         ,output glog) no-error.
     1688      if error-status:error or not glog then do:
     1689          v-dir-name = '':U.
     1690       end.
     1691       run low-ascii in this-procedure ( input v-dir-name, input no ) no-error .
     1692       if error-status:error then do:
     1693         v-dir-name = '':U.
     1694         undo, return error.
     1695       end.
     1696       else
     1697       v-dir = v-dir-name.
     1698   END.
     1699   ASSIGN
     1700   v-param-list = (IF rs-dir = 'ini' THEN 'ini' ELSE v-dir-name).
     1701   IF p-mode = 'shd' THEN DO:
     1702       run attach-attr-to-schedule-line in this-procedure (
     1703             INPUT v-param-list
     1704             ) NO-ERROR.
     1705     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1706   END.
     1707   END PROCEDURE.
