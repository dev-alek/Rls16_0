      417   define  stream PrnLibStream.
      418   procedure prn-lib-prn-file :
      419     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      420     define input parameter p-DIsabledoptions as integer no-undo .
      421     define variable v-report-name as character no-undo .
      422     define variable v-user-action as character no-undo .
      423     define variable v-printed     as logical   no-undo .
      424     define variable v-exist       as logical   no-undo .
