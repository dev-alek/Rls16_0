     4124   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     4125   DO:
     4126   END.
     4127   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     4128   DO:
     4129   define variable glog as logical no-undo .
     4130   define variable rep-rec as recid no-undo .
     4131   rep-rec = recid(X_wth-parts).
     4132           run str/wthpartl.w (
     4133                            input parparentproc
     4134                           ,input p-curr-host-code
     4135                           ,input p-curr-obj-type
     4136                           ,input p-curr-obj-code
     4137                           ,INPUT 'ПРОСМОТР':U
     4138                           ,INPUT X_wth-parts.w-p-code
     4139                           ,INPUT X_wth-parts.wth-code
     4140                           ,INPUT X_wth-parts.par-code
     4141                           ,INPUT X_wth-parts.in-code
     4142                           ,INPUT X_wth-parts.out-code
     4143                           ,INPUT X_wth-parts.ser-code
     4144                           ,INPUT X_wth-parts.db-num
     4145                           ,INPUT X_wth-parts.fact-rangeFrom
     4146                           ,INPUT X_wth-parts.fact-rangeTo
     4147                           ,INPUT   X_wth-parts.type
     4148                           ,input-output rep-rec).
     4149   if rep-rec <> ? then do:
     4150     v-prt-rec = rep-rec.
     4151     RUn OpenBr in this-procedure .
     4152     apply "entry" to BR-parts in frame Dialog-Frame.
     4153   end.
     4154   else do:
     4155     apply "entry" to BR-parts in frame Dialog-Frame.
     4156     return no-apply.
     4157   end.
     4158   END.
     4159   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     4160   DO:
     4161    define variable glog as logical no-undo .
     4162      if available X_wth-parts then do:
     4163   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4164   define variable v-str-recid31 as character no-undo .
     4165   define variable v-num-entry31 as integer   no-undo .
     4166   assign
     4167     v-str-recid31 = trim( string( recid( X_wth-parts ) , "->>>>>>>>>>>9":U ) )
     4168     v-num-entry31 = lookup( v-str-recid31 , rid-list )
     4169   .
     4170   if v-num-entry31 > 0 then do:
     4171     assign
     4172       entry( v-num-entry31, rid-list ) = "":U
     4173       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4174     .
     4175   end.
     4176   else do:
     4177     assign
     4178       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid31
     4179     .
     4180   end.
     4181        br-parts:refresh().
     4182        if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     4183                glog = br-parts:select-next-row ().
     4184                apply "iteration-changed" to br-parts in frame Dialog-Frame.
     4185            end.
     4186      end.
     4187      apply "entry" to br-parts in frame Dialog-Frame.
     4188   END.
     4189   ON CHOOSE OF B-mark-all IN FRAME Dialog-Frame
     4190   DO:
     4191    define variable glog as logical no-undo .
     4192    GET FIRST br-parts NO-LOCK.
     4193    rid-list = ''.
     4194    selectBlock:
     4195    DO WHILE not QUERY-OFF-END("br-parts":U)  :
     4196      if available X_wth-parts then do on error undo, leave selectBlock :
     4197   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4198   define variable v-str-recid33 as character no-undo .
     4199   define variable v-num-entry33 as integer   no-undo .
     4200   assign
     4201     v-str-recid33 = trim( string( recid( X_wth-parts ) , "->>>>>>>>>>>9":U ) )
     4202     v-num-entry33 = lookup( v-str-recid33 , rid-list )
     4203   .
     4204   if v-num-entry33 > 0 then do:
     4205     assign
     4206       entry( v-num-entry33, rid-list ) = "":U
     4207       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4208     .
     4209   end.
     4210   else do:
     4211     assign
     4212       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid33
     4213     .
     4214   end.
     4215      end.
     4216      get next br-parts no-lock.
     4217    END.
     4218    br-parts:refresh() no-error.
     4219    apply "entry" to br-parts in frame Dialog-Frame.
     4220   END.
     4221   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     4222   DO:
     4223    define variable doc-rec as recid no-undo .
     4224        doc-rec = recid( X_wth-parts ).
     4225      run PrintProc in this-procedure no-error.
     4226      reposition br-parts to recid doc-rec no-error.
     4227      apply "entry" to br-parts in frame Dialog-Frame.
     4228   END.
     4229   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     4230   DO:
     4231   if p-coll-point <> 'document':U then run save-position in this-procedure.
     4232   END.
     4233   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     4234   DO:
     4235     assign
     4236     tbl = 'wth-parts'
     4237     join-tbl = 'X_wth-parts'
     4238     dim = '0':U
     4239     fld = '':U
     4240     lab = '':U
     4241     spr = '':U
     4242     .
     4243     run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     4244     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4245     run fltfield-add in this-procedure('ser-code', '', '',
     4246     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4247     run fltfield-add in this-procedure('gds-code', '', '',
     4248     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4249     run fltfield-add in this-procedure('fact-date', '', '',
     4250     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4251     run fltfield-add in this-procedure('fact-rangeFrom', 'Диапазон с', '',
     4252     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4253     run fltfield-add in this-procedure('fact-rangeTo', 'Диапазон по', '',
     4254     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4255     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4256     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4257     run fltfield-add in this-procedure('w-p-code', '', '',
     4258     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4259     run fltfield-add in this-procedure('in-code', 'Номер порожд. док-та', '',
     4260     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4261     run fltfield-add in this-procedure('doc-code', 'Номер док-та', '',
     4262     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4263     run fltfield-add in this-procedure('contract-code', 'Номер договора', '',
     4264     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4265     run fltfield-add in this-procedure('cli-type*cli-code', 'Покупатель', 'cli',
     4266     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4267     run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'cli',
     4268     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4269     run fltfield-add in this-procedure('sale-obj-type*sale-obj-code', 'Объект реализации', 'cli',
     4270     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4271     run fltfield-add in this-procedure('out-obj-type*out-obj-code', 'Объект погашения', 'cli',
     4272     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4273     run fltfield-add in this-procedure('type', 'Тип док-та', '',
     4274     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4275     run fltfield-add in this-procedure('ext-doc-type', 'Расш. тип док-та', '',
     4276     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4277     run fltfield-add in this-procedure('beg-dt', 'Дата начала срока годности', '',
     4278     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4279     run fltfield-add in this-procedure('end-dt', 'Дата конца срока годности', '',
     4280     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4281     run fltfield-add in this-procedure('shift-date', 'Дата смены', '',
     4282     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4283     run fltfield-add in this-procedure('shift-num', 'Порядок смены', '',
     4284     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4285       DO on stop undo, leave:
     4286           run gbl/filter.w ( input parparentproc
     4287                            , input filter-point
     4288                            , input tbl
     4289                            , input join-tbl
     4290                            , input  fld
     4291                            , input lab
     4292                            , input spr
     4293                            , input dim).
     4294           RUN OpenBr in this-procedure .
     4295       END .
     4296   END.
     4297   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     4298   DO:
     4299       if  available X_wth-parts AND (rid-list = ""  or
     4300           b-mark:sensitive = no)
     4301       then
     4302       rid-list = string( recid( X_wth-parts ) ) .
     4303   END.
     4304   ON RETURN OF bar-str IN FRAME Dialog-Frame
     4305   DO:
     4306   define variable v-ser-code  as integer      no-undo.
     4307   define variable v-db-num    as integer      no-undo.
     4308   define variable v-stts      as integer      no-undo.
     4309   define variable v-wth-code  as integer      no-undo.
     4310   define variable v-gds-code  as integer      no-undo.
     4311   define variable v-par-code  as integer      no-undo.
     4312   define variable v-zone      as character    no-undo.
     4313   define variable v-fromDate  as date         no-undo.
     4314   define variable v-ToDate    as date         no-undo.
     4315   define variable v-rangeNum  as integer      no-undo.
     4316   define variable parline-rec    as recid     no-undo.
     4317   define variable parparts-rec    as recid    no-undo.
     4318   define variable v-start-rec as integer      no-undo.
     4319   define variable v-qstrnum as int no-undo.
     4320   define variable v-cur-recX as recid no-undo.
     4321   assign frame Dialog-Frame bar-str .
     4322   if not available x_wth-parts then return.
     4323     run str/wthidnt.p ( input bar-str
     4324             ,output v-ser-code
     4325             ,output v-db-num
     4326             ,output v-stts
     4327             ,output v-wth-code
     4328             ,output v-gds-code
     4329             ,output v-par-code
     4330             ,output v-zone
     4331             ,output v-FromDate
     4332             ,output v-ToDate
     4333             ,output v-rangeNum
     4334             ) no-error.
     4335   if error-status:error then do:
     4336      message error-status:get-message(1) + chr(32) + return-value.
     4337      undo, return .
     4338   end.
     4339   apply 'entry':U to br-parts.
     4340   v-cur-recX =  recid(x_wth-parts).
     4341     get next br-parts .
     4342     findBlock: do:
     4343       do while available x_wth-parts and v-cur-recX  <>  recid(x_wth-parts):
     4344           if  x_wth-parts.ser-code =  v-ser-code
     4345           and x_wth-parts.db-num   =  v-db-num
     4346           and x_wth-parts.wth-code =  v-wth-code
     4347           and x_wth-parts.gds-code =  v-gds-code
     4348           and x_wth-parts.par-code =  v-par-code
     4349           and x_wth-parts.fact-RangeFrom <= v-rangeNum
     4350           and x_wth-parts.fact-RangeTo >= v-rangeNum
     4351           then do:
     4352            if not available x_wth-parts then message '2' view-as alert-box.
     4353               reposition br-parts to recid  recid(x_wth-parts).
     4354               leave findBlock.
     4355           end.
     4356          get next br-parts.
     4357          if not available x_wth-parts then get first br-parts.
     4358       end.
     4359       if p-coll-point =   'document'  then
     4360       message substitute( "В данном списке нет талона с указанным штрих-кодом: &1", bar-str ) view-as alert-box warning.
     4361     end.
     4362   apply 'entry':U to br-parts.
     4363   bar-str:screen-value = '':U.
     4364   return no-apply.
     4365   END.
     4366   ON MOUSE-SELECT-DBLCLICK, return OF br-parts IN FRAME Dialog-Frame
     4367   DO:
     4368       IF b-chg:SENSITIVE THEN APPLY "choose":U TO b-chg.
     4369     ELSE APPLY "choose":U TO b-lkp.
     4370   END.
     4371   ON ROW-DISPLAY OF br-parts IN FRAME Dialog-Frame
     4372   DO:
     4373   def var v-font as integer no-undo init ?.
     4374   if available X_wth-parts then do:
     4375     IF X_wth-parts.in-code = 'фальшивый':U and lookup(X_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN
     4376     v-font = 12.
     4377     if  lookup(X_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0  then
     4378     v-font = 7.
     4379     ASSIGN v-SerDb:FGCOLOR IN BROWSE br-parts = v-font
     4380          X_wth-parts.fact-rangeFrom:FGCOLOR IN BROWSE br-parts = v-font
     4381          X_wth-parts.fact-rangeTo:FGCOLOR IN BROWSE br-parts = v-font
     4382          X_wth-parts.fact-qnty:FGCOLOR IN BROWSE br-parts = v-font
     4383          X_wth-parts.in-code:FGCOLOR IN BROWSE br-parts = v-font
     4384          v-out-name:FGCOLOR IN BROWSE br-parts = v-font
     4385          v-obj-name:FGCOLOR IN BROWSE br-parts = v-font
     4386          v-w-p-name:FGCOLOR IN BROWSE br-parts = v-font
     4387          v-serName :FGCOLOR IN BROWSE br-parts = v-font.
     4388     if X_wth-parts.stts = 1 then do:
     4389          X_wth-parts.fact-rangeFrom:screen-value IN BROWSE br-parts = '?'.
     4390          X_wth-parts.fact-rangeTo:screen-value IN BROWSE br-parts = '?'.
     4391          X_wth-parts.fact-qnty:screen-value IN BROWSE br-parts = '0'.
     4392     end.
     4393   end.
     4394   END.
     4395   ON VALUE-CHANGED OF br-parts IN FRAME Dialog-Frame
     4396   DO:
     4397     IF AVAILABLE X_wth-parts THEN DO WITH FRAME Dialog-Frame:
     4398         FIND FIRST b-wealth WHERE b-wealth.wth-code = X_wth-parts.wth-code NO-LOCK NO-ERROR.
     4399         IF AVAILABLE b-wealth THEN DISP b-wealth.wth-name @ fl-wth-name.
     4400         ELSE fl-wth-name:SCREEN-VALUE = '?':U.
     4401         FIND FIRST b-wth-par WHERE b-wth-par.wth-code =  X_wth-parts.wth-code AND b-wth-par.par-code = X_wth-parts.par-code NO-LOCK NO-ERROR.
     4402         IF AVAILABLE b-wth-par THEN do:
     4403             DISP SUBSTITUTE("&1 &2",b-wth-par.par-val,b-wth-par.par-unit) @ fl-par-val
     4404                            (if X_wth-parts.price-rubl > 0 then  trim(string(X_wth-parts.price-rubl / b-wth-par.par-val,"->>>,>9.99")) else '':U)  @ fl-par-price.
     4405         END.
     4406         ELSE fl-par-val:SCREEN-VALUE = '?':U.
     4407         FIND FIRST b-goods WHERE b-goods.gds-code = X_wth-parts.gds-code NO-LOCK NO-ERROR.
     4408         IF AVAILABLE b-goods THEN DO:
     4409                                   disp  b-goods.gds-name  @ fl-gds.
     4410         END.
     4411         ELSE   ASSIGN fl-gds:SCREEN-VALUE = '?':U.
     4412         ENABLE b-lkp
     4413                b-del WHEN p-coll-point = 'document':U AND p-edit-mode = 'ИЗМЕНЕНИЕ':U
     4414                b-chg WHEN p-coll-point = 'document':U AND p-edit-mode = 'ИЗМЕНЕНИЕ':U.
     4415         if lookup(X_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 then do:
     4416                  display  X_wth-parts.doc-code @ fl-doc-code
     4417                           X_wth-parts.fact-date @ fl-doc-date
     4418                        ENTRY(LOOKUP(X_wth-parts.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) @ fl-doc-ext-type
     4419               .
     4420         end.
     4421         else do:
     4422            display  X_wth-parts.out-code @ fl-doc-code
     4423                     X_wth-parts.fact-date @ fl-doc-date
     4424                     ENTRY(LOOKUP(X_wth-parts.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) @ fl-doc-ext-type
     4425             no-error .
     4426         end.
     4427         if X_wth-parts.stts = 1 and p-edit-mode <> 'ПРОСМОТР':U then do:
     4428           b-del:label = 'Восстанов'.
     4429         end.
     4430         else b-del:label = 'Удалить'.
     4431     END.
     4432     ELSE DO:
     4433         DISABLE b-lkp b-chg b-del WITH FRAME Dialog-Frame.
     4434     END.
     4435   END.
     4436   ON VALUE-CHANGED OF rsfl-ch IN FRAME Dialog-Frame
     4437   DO:
     4438     if self:screen-value = '2' then do:
     4439       hide rsfl-obj Fn-rs-obj in frame Dialog-Frame  .
     4440       v-w-p-name:visible in browse br-parts = no.
     4441       v-out-name:visible in browse br-parts = no.
     4442       X_wth-parts.in-code:visible in browse br-parts = no.
     4443     end.
     4444     else do:
     4445       if p-coll-point <> 'document' then view rsfl-obj Fn-rs-obj in frame Dialog-Frame  .
     4446       v-w-p-name:visible in browse br-parts = yes.
     4447       v-out-name:visible in browse br-parts = yes.
     4448       X_wth-parts.in-code:visible in browse br-parts = yes.
     4449     end.
     4450       RUn OpenBr in this-procedure .
     4451   END.
     4452   ON VALUE-CHANGED OF rsfl-obj IN FRAME Dialog-Frame
     4453   DO:
     4454       RUn OpenBr in this-procedure .
     4455   END.
     4456    on "ANY-PRINTABLE":U of br-parts anywhere  do:
     4457       bar-str:screen-value = bar-str:screen-value + last-event:label.
     4458       apply "entry" to bar-str in frame Dialog-Frame.
     4459       apply "end" to bar-str in frame Dialog-Frame.
     4460    end.
     4461   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4462   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4463   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4464     run mainmenu_getcntxt in parparentproc
     4465       (output v-cntxt-db-num
     4466       ,output v-cntxt-userid
     4467       ,output v-cntxt-level
     4468       ,output v-cntxt-host-code-obj
     4469       ,output v-cntxt-obj-type
     4470       ,output v-cntxt-obj-code
     4471       ,output v-cntxt-db-num-obj
     4472       ,output v-cntxt-is-admin
     4473       ) .
     4474   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4475   on help of frame Dialog-Frame
     4476   do:
     4477     run gbl/app_help.p
     4478       (input this-procedure :file-name
     4479       ,input ''
     4480       ,input ?
     4481       ) no-error.
     4482     if error-status :error then do:
     4483       message
     4484         "Ошибка при вызове помощи"
     4485         error-status :get-message(1)
     4486         view-as alert-box .
     4487     end.
     4488   end.
     4489   run minbtn-set in this-procedure .
     4490   on choose of b-help in frame Dialog-Frame
     4491   do:
     4492     apply "help":u to frame Dialog-Frame .
     4493   end.
     4494   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4495   procedure minbtn-set :
     4496       do
     4497           on error undo, return error return-value
     4498           :
     4499           define variable ii              as integer       no-undo .
     4500           define variable fh              as widget-handle no-undo .
     4501           define variable hh              as widget-handle no-undo .
     4502           define variable v-h             as handle        extent 4 no-undo .
     4503           define variable v-name-button   as character     no-undo .
     4504           define variable v-help-old-x    as decimal       no-undo .
     4505           define variable v-help-old-y    as decimal       no-undo .
     4506           define variable v-help-old-size as decimal       no-undo .
     4507           define variable v-frame-width   as decimal       no-undo .
     4508           define variable jj              as integer       no-undo .
     4509           do
     4510               on error undo, return error
     4511               :
     4512               assign
     4513                   v-frame-width = frame Dialog-Frame:width - 0.3
     4514                   fh            = frame Dialog-Frame:first-child
     4515                   hh            = fh:first-child
     4516                   ii            = 1
     4517                   .
     4518               do while valid-handle(hh):
     4519                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4520                   do:
     4521                       case lc(hh:name) :
     4522                           when "b-help" then
     4523                               do:
     4524                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4525                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4526                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4527                                   hh:TOOLTIP = "Помощь" .
     4528                                   v-help-old-x = hh:column .
     4529                                   v-help-old-y = hh:row    .
     4530                                   v-help-old-size = hh:width .
     4531                                   hh:width-chars = 2.5 .
     4532                               end.
     4533                           when "b-print" then
     4534                               do:
     4535                                   hh:load-image("cmp/b-print.bmp":u) .
     4536                                   hh:TOOLTIP = "Печать" .
     4537                                   v-h[ii] = hh:handle .
     4538                                   ii = ii + 1 .
     4539                                   hh:width-chars = 3 .
     4540                               end.
     4541                           when "b-history" or
     4542                           when "b-hist" then
     4543                               do:
     4544                                   hh:load-image("cmp/b-hist.bmp":u) .
     4545                                   hh:TOOLTIP = "История" .
     4546                                   v-h[ii] = hh:handle .
     4547                                   ii = ii + 1 .
     4548                                   hh:width-chars = 3 .
     4549                               end.
     4550                           when "b-sch" then
     4551                               do:
     4552                                   hh:load-image("cmp/b-sch.bmp":u) .
     4553                                   hh:TOOLTIP = "Установка Фильтра" .
     4554                                   v-h[ii] = hh:handle .
     4555                                   ii = ii + 1 .
     4556                                   hh:width-chars = 3 .
     4557                               end.
     4558                           when "b-hist-user" then
     4559                               do:
     4560                                   hh:load-image("cmp/b-hist.bmp":u) .
     4561                                   hh:TOOLTIP = "История пользователя" .
     4562                                   ii = ii + 1 .
     4563                               end.
     4564                       end case.
     4565                   end.
     4566                   hh = hh:next-sibling.
     4567               end.
     4568               b-help:column = v-frame-width - b-help:width-chars.
     4569               jj = 0.
     4570               repeat ii = 4 to 1 by -1 :
     4571                   if valid-handle (v-h[ii] ) then
     4572                   do:
     4573                       jj  = jj + 1 .
     4574                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4575                       v-h[ii]:row    = v-help-old-y .
     4576                   end.
     4577               end.
     4578           end.
     4579       end.
     4580   end procedure.
     4581   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4582   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4583   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4584   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4585   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4586   define variable v-diasize-current-frame-height as decimal   no-undo .
     4587   define variable v-diasize-change-size          as logical   no-undo .
     4588   define variable v-diasize-resize-button        as handle    no-undo .
     4589   define variable v-diasize-wndmax               as logical   no-undo .
     4590   define variable v-diasize-wndstore             as logical   no-undo .
     4591   define variable v-diasize-proc-name            as character no-undo .
     4592   define variable v-diasize-browse-handle        as handle    no-undo .
     4593   define variable v-diasize-browse-number        as integer   no-undo .
     4594   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4595   define temp-table temp-diasize-handle no-undo
     4596     field handle-value  as handle
     4597     field save-position as decimal
     4598     index xpk is primary unique handle-value
     4599     .
     4600   define temp-table temp-browse-handle no-undo
     4601     field browse-type   as character
     4602     field browse-number as integer
     4603     field browse-handle as handle
     4604     field original-size as decimal
     4605     index xpk is primary unique browse-type browse-number
     4606     index xie browse-type browse-handle
     4607   .
     4608   procedure diasize_change-height :
     4609     define input  parameter p-change-value  as decimal   no-undo .
     4610     define input  parameter p-move-resize   as logical   no-undo .
     4611     define variable v-field-group-handle    as handle    no-undo .
     4612     define variable v-object-handle         as handle    no-undo .
     4613     define variable v-frame-height          as decimal   no-undo .
     4614     define variable v-frame-virtual-height  as decimal   no-undo .
     4615     define variable v-browse-height         as decimal   no-undo .
     4616     define variable v-window-height         as decimal   no-undo .
     4617     define variable v-window-virtual-height as decimal   no-undo .
     4618     define variable v-change-sign           as integer   no-undo .
     4619     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4620     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4621     if p-change-value > 0
     4622     then do:
     4623       if frame Dialog-Frame :height + p-change-value
     4624           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4625       then do:
     4626         assign
     4627           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4628                           - (frame Dialog-Frame :height-chars)
     4629         .
     4630         if p-change-value <= 0
     4631         then do:
     4632           run diasize_position-resize-button in this-procedure .
     4633           return .
     4634         end.
     4635       end.
     4636     end.
     4637     if p-change-value < 0
     4638     then do:
     4639       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4640       then do:
     4641         assign
     4642           p-change-value = v-diasize-orig-frame-height
     4643                          - (frame Dialog-Frame :height-chars)
     4644         .
     4645         if p-change-value >= 0
     4646         then do:
     4647           run diasize_position-resize-button in this-procedure .
     4648           return .
     4649         end.
     4650       end.
     4651     end.
     4652     if p-change-value >= 0
     4653     then do:
     4654       assign
     4655         v-change-sign = 1
     4656       .
     4657     end.
     4658     else do:
     4659       assign
     4660         v-change-sign = -1
     4661       .
     4662     end.
     4663     assign
     4664       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4665     .
     4666     if p-change-value = 0
     4667     then do:
     4668       run diasize_position-resize-button in this-procedure .
     4669       return .
     4670     end.
     4671     move_block:
     4672     do
     4673     on error undo move_block, retry move_block
     4674     :
     4675       if retry
     4676       then do:
     4677         do
     4678         on error undo move_block, leave move_block
     4679         :
     4680           if p-change-value > 0
     4681           then do:
     4682             for each buf_temp-diasize-handle
     4683             on error undo, next
     4684             :
     4685               assign
     4686                 v-object-handle = buf_temp-diasize-handle.handle-value
     4687               .
     4688               if v-object-handle <> v-diasize-resize-button
     4689               then do:
     4690                 assign
     4691                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4692                 .
     4693               end.
     4694             end.
     4695             assign
     4696               v-diasize-browse-handle :height = v-browse-height
     4697             .
     4698             for each buf_temp-browse-handle
     4699               where buf_temp-browse-handle.browse-type = 'height':u
     4700             on error undo, next
     4701             :
     4702               assign
     4703                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4704               .
     4705             end.
     4706             assign
     4707               frame Dialog-Frame :height = v-frame-height
     4708             .
     4709             if frame Dialog-Frame :scrollable = true
     4710             then do:
     4711               assign
     4712                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4713               .
     4714             end.
     4715             run diasize_position-resize-button in this-procedure .
     4716           end.
     4717           else do:
     4718             if frame Dialog-Frame :scrollable = true
     4719             then do:
     4720               assign
     4721                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4722               .
     4723             end.
     4724             assign
     4725               frame Dialog-Frame :height = v-frame-height
     4726             .
     4727             assign
     4728               v-diasize-browse-handle :height = v-browse-height
     4729             .
     4730             for each buf_temp-browse-handle
     4731               where buf_temp-browse-handle.browse-type = 'height':u
     4732             on error undo, next
     4733             :
     4734               assign
     4735                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4736               .
     4737             end.
     4738             for each buf_temp-diasize-handle
     4739             on error undo, next
     4740             :
     4741               assign
     4742                 v-object-handle = buf_temp-diasize-handle.handle-value
     4743               .
     4744               if v-object-handle <> v-diasize-resize-button
     4745               then do:
     4746                 assign
     4747                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4748                 .
     4749               end.
     4750             end.
     4751             run diasize_position-resize-button in this-procedure .
     4752           end.
     4753           assign
     4754             v-diasize-change-size = false
     4755           .
     4756           leave move_block .
     4757         end.
     4758       end.
     4759       assign
     4760         v-diasize-need-full-display = true
     4761       .
     4762       if v-diasize-change-size = false
     4763       then do:
     4764         assign
     4765           v-diasize-change-size = true
     4766         .
     4767       end.
     4768       else do:
     4769         return .
     4770       end.
     4771       assign
     4772         v-frame-height = frame Dialog-Frame :height
     4773         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4774         v-browse-height = v-diasize-browse-handle :height
     4775       .
     4776       for each buf_temp-browse-handle
     4777         where buf_temp-browse-handle.browse-type = 'height':u
     4778       :
     4779         assign
     4780           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4781         .
     4782       end.
     4783       for each buf_temp-diasize-handle
     4784       :
     4785         delete buf_temp-diasize-handle .
     4786       end.
     4787       assign
     4788         v-field-group-handle = frame Dialog-Frame :first-child
     4789       .
     4790       do while valid-handle(v-field-group-handle)
     4791       :
     4792         assign
     4793           v-object-handle = v-field-group-handle :first-child
     4794         .
     4795         do while valid-handle(v-object-handle)
     4796         :
     4797           if  v-object-handle <> v-diasize-browse-handle :handle
     4798           and can-query(v-object-handle, "row")
     4799           and can-query(v-object-handle, "height")
     4800           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4801           then do:
     4802             find first buf_temp-browse-handle
     4803               where buf_temp-browse-handle.browse-type   = 'height':u
     4804                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4805               no-error .
     4806             if available buf_temp-browse-handle
     4807             then do:
     4808             end.
     4809             else do:
     4810               create buf_temp-diasize-handle .
     4811               assign
     4812                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4813                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4814               .
     4815             end.
     4816           end.
     4817           assign
     4818             v-object-handle = v-object-handle :next-sibling
     4819           .
     4820         end.
     4821         assign
     4822           v-field-group-handle = v-field-group-handle :next-sibling
     4823         .
     4824       end.
     4825       do with frame Dialog-Frame
     4826       :
     4827         hide v-diasize-resize-button .
     4828         assign
     4829           v-diasize-resize-button :row    = 1
     4830           v-diasize-resize-button :column = 1
     4831         .
     4832       end.
     4833       if p-change-value > 0
     4834       then do:
     4835         if frame Dialog-Frame :scrollable = true
     4836         then do:
     4837           assign
     4838             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4839             no-error .
     4840           if error-status :error
     4841           or error-status :get-message(1) <> ""
     4842           then do:
     4843             undo move_block, retry move_block .
     4844           end.
     4845         end.
     4846         assign
     4847           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4848           no-error .
     4849         if error-status :error
     4850         or error-status :get-message(1) <> ""
     4851         then do:
     4852           undo move_block, retry move_block .
     4853         end.
     4854         assign
     4855           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4856           no-error .
     4857         if error-status :error
     4858         or error-status :get-message(1) <> ""
     4859         then do:
     4860           undo move_block, retry move_block .
     4861         end.
     4862         for each buf_temp-browse-handle
     4863           where buf_temp-browse-handle.browse-type = 'height':u
     4864         on error undo move_block, retry move_block
     4865         :
     4866           assign
     4867             buf_temp-browse-handle.browse-handle :height
     4868               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4869             no-error .
     4870           if error-status :error
     4871           or error-status :get-message(1) <> ""
     4872           then do:
     4873             undo move_block, retry move_block .
     4874           end.
     4875         end.
     4876         for each buf_temp-diasize-handle
     4877         on error undo move_block, retry move_block
     4878         :
     4879           assign
     4880             v-object-handle = buf_temp-diasize-handle.handle-value
     4881           .
     4882           if v-object-handle <> v-diasize-resize-button
     4883           then do:
     4884             assign
     4885               v-object-handle :row = v-object-handle :row + p-change-value
     4886               no-error .
     4887             if error-status :error
     4888             or error-status :get-message(1) <> ""
     4889             then do:
     4890               undo move_block, retry move_block .
     4891             end.
     4892           end.
     4893         end.
     4894       end.
     4895       else do:
     4896         for each buf_temp-diasize-handle
     4897         on error undo move_block, retry move_block
     4898         :
     4899           assign
     4900             v-object-handle = buf_temp-diasize-handle.handle-value
     4901           .
     4902           if v-object-handle <> v-diasize-resize-button
     4903           then do:
     4904             assign
     4905               v-object-handle :row = v-object-handle :row + p-change-value
     4906               no-error .
     4907             if error-status :error
     4908             or error-status :get-message(1) <> ""
     4909             then do:
     4910               undo move_block, retry move_block .
     4911             end.
     4912           end.
     4913         end.
     4914         assign
     4915           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4916           no-error .
     4917         if error-status :error
     4918         or error-status :get-message(1) <> ""
     4919         then do:
     4920           undo move_block, retry move_block .
     4921         end.
     4922         for each buf_temp-browse-handle
     4923           where buf_temp-browse-handle.browse-type = 'height':u
     4924         on error undo move_block, retry move_block
     4925         :
     4926           assign
     4927             buf_temp-browse-handle.browse-handle :height
     4928               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4929             no-error .
     4930           if error-status :error
     4931           or error-status :get-message(1) <> ""
     4932           then do:
     4933             undo move_block, retry move_block .
     4934           end.
     4935         end.
     4936         assign
     4937           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4938           no-error .
     4939         if error-status :error
     4940         or error-status :get-message(1) <> ""
     4941         then do:
     4942           undo move_block, retry move_block .
     4943         end.
     4944         if frame Dialog-Frame :scrollable = true
     4945         then do:
     4946           assign
     4947             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4948             no-error .
     4949           if error-status :error
     4950           or error-status :get-message(1) <> ""
     4951           then do:
     4952             undo move_block, retry move_block .
     4953           end.
     4954         end.
     4955       end.
     4956       if p-move-resize = true
     4957       then do:
     4958         run diasize_position-resize-button in this-procedure .
     4959       end.
     4960       if v-diasize-wndstore = true
     4961       then do:
     4962         if connected("ub") = true
     4963         then do:
     4964           define variable v-cntxt-db-num        as integer   no-undo .
     4965           define variable v-cntxt-userid        as character no-undo .
     4966           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4967                                             , OUTPUT v-cntxt-userid
     4968                                             ) .
     4969           run gbl/wndsizew.p
     4970             (input  v-cntxt-db-num
     4971             ,input  v-cntxt-userid
     4972             ,input  v-diasize-proc-name
     4973             ,input  'height':u
     4974             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4975             ) .
     4976         end.
     4977       end.
     4978     end.
     4979     assign
     4980       v-diasize-change-size = false
     4981     .
     4982   end procedure.
     4983   procedure diasize_set-height :
     4984     define input  parameter p-new-height  as decimal   no-undo .
     4985     define input  parameter p-move-resize as logical   no-undo .
     4986     do
     4987     on error undo, return error return-value
     4988     :
     4989       run diasize_change-height in this-procedure
     4990         (input  (p-new-height - frame Dialog-Frame :height)
     4991         ,input  p-move-resize
     4992         ) .
     4993     end.
     4994   end procedure.
     4995   procedure diasize_change-width :
     4996     define input  parameter p-change-value as decimal   no-undo .
     4997     define input  parameter p-move-resize  as logical   no-undo .
     4998     define variable v-field-group-handle   as handle    no-undo .
     4999     define variable v-object-handle        as handle    no-undo .
     5000     define variable v-frame-width          as decimal   no-undo .
     5001     define variable v-frame-virtual-width  as decimal   no-undo .
     5002     define variable v-browse-width         as decimal   no-undo .
     5003     define variable v-window-width         as decimal   no-undo .
     5004     define variable v-window-virtual-width as decimal   no-undo .
     5005     define variable v-change-sign          as integer   no-undo .
     5006     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5007     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5008     if p-change-value > 0
     5009     then do:
     5010       if frame Dialog-Frame :width + p-change-value >
     5011           session :width-chars
     5012       then do:
     5013         assign
     5014           p-change-value = session :width-chars - frame Dialog-Frame :width
     5015         .
     5016         if p-change-value <= 0
     5017         then do:
     5018           run diasize_position-resize-button in this-procedure .
     5019           return .
     5020         end.
     5021       end.
     5022     end.
     5023     if p-change-value < 0
     5024     then do:
     5025       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5026       then do:
     5027         assign
     5028           p-change-value = v-diasize-orig-frame-width
     5029                          - frame Dialog-Frame :width
     5030         .
     5031         if p-change-value >= 0
     5032         then do:
     5033           run diasize_position-resize-button in this-procedure .
     5034           return .
     5035         end.
     5036       end.
     5037     end.
     5038     if p-change-value >= 0
     5039     then do:
     5040       assign
     5041         v-change-sign = 1
     5042       .
     5043     end.
     5044     else do:
     5045       assign
     5046         v-change-sign = -1
     5047       .
     5048     end.
     5049     assign
     5050       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5051     .
     5052     if p-change-value = 0
     5053     then do:
     5054       run diasize_position-resize-button in this-procedure .
     5055       return .
     5056     end.
     5057     move_block:
     5058     do
     5059     on error undo move_block, leave move_block
     5060     :
     5061       if retry
     5062       then do:
     5063         do
     5064         on error undo move_block, leave move_block
     5065         :
     5066           if p-change-value > 0
     5067           then do:
     5068             for each buf_temp-diasize-handle
     5069             on error undo, next
     5070             :
     5071               assign
     5072                 v-object-handle = buf_temp-diasize-handle.handle-value
     5073               .
     5074               if v-object-handle <> v-diasize-resize-button
     5075               then do:
     5076                 assign
     5077                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5078                 .
     5079               end.
     5080             end.
     5081             assign
     5082               v-diasize-browse-handle :width = v-browse-width
     5083             .
     5084             for each buf_temp-browse-handle
     5085               where buf_temp-browse-handle.browse-type = 'width':u
     5086             on error undo, next
     5087             :
     5088               assign
     5089                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5090               .
     5091             end.
     5092             assign
     5093               frame Dialog-Frame :width = v-frame-width
     5094             .
     5095             if frame Dialog-Frame :scrollable = true
     5096             then do:
     5097               assign
     5098                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5099               .
     5100             end.
     5101             run diasize_position-resize-button in this-procedure .
     5102           end.
     5103           else do:
     5104             if frame Dialog-Frame :scrollable = true
     5105             then do:
     5106               assign
     5107                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5108               .
     5109             end.
     5110             assign
     5111               frame Dialog-Frame :width = v-frame-width
     5112             .
     5113             for each buf_temp-browse-handle
     5114               where buf_temp-browse-handle.browse-type = 'width':u
     5115             on error undo, next
     5116             :
     5117               assign
     5118                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5119               .
     5120             end.
     5121             assign
     5122               v-diasize-browse-handle :width = v-browse-width
     5123             .
     5124             for each buf_temp-diasize-handle
     5125             on error undo, next
     5126             :
     5127               assign
     5128                 v-object-handle = buf_temp-diasize-handle.handle-value
     5129               .
     5130               if v-object-handle <> v-diasize-resize-button
     5131               then do:
     5132                 assign
     5133                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5134                 .
     5135               end.
     5136             end.
     5137             run diasize_position-resize-button in this-procedure .
     5138           end.
     5139           assign
     5140             v-diasize-change-size = false
     5141           .
     5142           leave move_block .
     5143         end.
     5144       end.
     5145       assign
     5146         v-diasize-need-full-display = true
     5147       .
     5148       if v-diasize-change-size = false
     5149       then do:
     5150         assign
     5151           v-diasize-change-size = true
     5152         .
     5153       end.
     5154       else do:
     5155         return .
     5156       end.
     5157       assign
     5158         v-frame-width = frame Dialog-Frame :width
     5159         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5160         v-browse-width = v-diasize-browse-handle :width
     5161       .
     5162       for each buf_temp-browse-handle
     5163         where buf_temp-browse-handle.browse-type = 'width':u
     5164       :
     5165         assign
     5166           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5167         .
     5168       end.
     5169       for each buf_temp-diasize-handle
     5170       :
     5171         delete buf_temp-diasize-handle .
     5172       end.
     5173       assign
     5174         v-field-group-handle = frame Dialog-Frame :first-child
     5175       .
     5176       do while valid-handle(v-field-group-handle)
     5177       :
     5178         assign
     5179           v-object-handle = v-field-group-handle :first-child
     5180         .
     5181         do while valid-handle(v-object-handle)
     5182         :
     5183           if  v-object-handle <> v-diasize-browse-handle :handle
     5184           and v-object-handle <> v-diasize-resize-button
     5185           and can-query(v-object-handle, "row")
     5186           and can-query(v-object-handle, "height")
     5187           and ( v-object-handle :col + v-object-handle :width
     5188                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5189               )
     5190           then do:
     5191             find first buf_temp-browse-handle
     5192               where buf_temp-browse-handle.browse-type   = 'width':u
     5193                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5194               no-error .
     5195             if available buf_temp-browse-handle
     5196             then do:
     5197             end.
     5198             else do:
     5199               create buf_temp-diasize-handle .
     5200               assign
     5201                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5202                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5203               .
     5204             end.
     5205           end.
     5206           assign
     5207             v-object-handle = v-object-handle :next-sibling
     5208           .
     5209         end.
     5210         assign
     5211           v-field-group-handle = v-field-group-handle :next-sibling
     5212         .
     5213       end.
     5214       do with frame Dialog-Frame
     5215       :
     5216         hide v-diasize-resize-button .
     5217         v-diasize-resize-button :row = 1.
     5218         v-diasize-resize-button :column = 1.
     5219       end.
     5220       if p-change-value > 0
     5221       then do:
     5222         if frame Dialog-Frame :scrollable = true
     5223         then do:
     5224           assign
     5225             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5226             no-error .
     5227           if error-status :error
     5228           or error-status :get-message(1) <> ""
     5229           then do:
     5230             undo move_block, retry move_block.
     5231           end.
     5232         end.
     5233         assign
     5234           frame Dialog-Frame :width = v-frame-width + p-change-value
     5235           no-error .
     5236         if error-status :error
     5237         or error-status :get-message(1) <> ""
     5238         then do:
     5239           undo move_block, retry move_block.
     5240         end.
     5241         assign
     5242           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5243         no-error .
     5244         if error-status :error
     5245         or error-status :get-message(1) <> ""
     5246         then do:
     5247           undo move_block, retry move_block.
     5248         end.
     5249         for each buf_temp-browse-handle
     5250           where buf_temp-browse-handle.browse-type = 'width':u
     5251         on error undo move_block, retry move_block
     5252         :
     5253           assign
     5254             buf_temp-browse-handle.browse-handle :width
     5255               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5256             no-error .
     5257           if error-status :error
     5258           or error-status :get-message(1) <> ""
     5259           then do:
     5260             undo move_block, retry move_block .
     5261           end.
     5262         end.
     5263         for each buf_temp-diasize-handle
     5264         on error undo move_block, retry move_block
     5265         :
     5266           assign
     5267             v-object-handle = buf_temp-diasize-handle.handle-value
     5268           .
     5269           if v-object-handle <> v-diasize-resize-button
     5270           then do:
     5271             assign
     5272               v-object-handle :col = v-object-handle :col + p-change-value
     5273               no-error .
     5274             if error-status :error
     5275             or error-status :get-message(1) <> ""
     5276             then do:
     5277               undo move_block, retry move_block .
     5278             end.
     5279           end.
     5280         end.
     5281       end.
     5282       else do:
     5283         for each buf_temp-diasize-handle
     5284         on error undo move_block, retry move_block
     5285         :
     5286           assign
     5287             v-object-handle = buf_temp-diasize-handle.handle-value
     5288           .
     5289           if v-object-handle <> v-diasize-resize-button
     5290           then do:
     5291             assign
     5292               v-object-handle :col = v-object-handle :col + p-change-value
     5293               no-error .
     5294             if error-status :error
     5295             or error-status :get-message(1) <> ""
     5296             then do:
     5297               undo move_block, retry move_block .
     5298             end.
     5299           end.
     5300         end.
     5301         for each buf_temp-browse-handle
     5302           where buf_temp-browse-handle.browse-type = 'width':u
     5303         on error undo move_block, retry move_block
     5304         :
     5305           assign
     5306             buf_temp-browse-handle.browse-handle :width
     5307               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5308             no-error .
     5309           if error-status :error
     5310           or error-status :get-message(1) <> ""
     5311           then do:
     5312             undo move_block, retry move_block .
     5313           end.
     5314         end.
     5315         assign
     5316           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5317           no-error .
     5318         if error-status :error
     5319         or error-status :get-message(1) <> ""
     5320         then do:
     5321           undo move_block, retry move_block.
     5322         end.
     5323         assign
     5324           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5325         no-error .
     5326         if error-status :error
     5327         or error-status :get-message(1) <> ""
     5328         then do:
     5329           undo move_block, retry move_block.
     5330         end.
     5331         if frame Dialog-Frame :scrollable = true
     5332         then do:
     5333           assign
     5334             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5335           no-error .
     5336           if error-status :error
     5337           or error-status :get-message(1) <> ""
     5338           then do:
     5339             undo move_block, retry move_block.
     5340           end.
     5341         end.
     5342       end.
     5343       if p-move-resize
     5344       then do:
     5345         run diasize_position-resize-button in this-procedure .
     5346       end.
     5347       if v-diasize-wndstore = true
     5348       then do:
     5349         if connected("ub") = true
     5350         then do:
     5351           define variable v-cntxt-db-num        as integer   no-undo .
     5352           define variable v-cntxt-userid        as character no-undo .
     5353           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5354                                             , OUTPUT v-cntxt-userid
     5355                                             ) .
     5356           run gbl/wndsizew.p
     5357             (input  v-cntxt-db-num
     5358             ,input  v-cntxt-userid
     5359             ,input  v-diasize-proc-name
     5360             ,input  'width':u
     5361             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5362             ) .
     5363         end.
     5364       end.
     5365     end.
     5366     assign
     5367       v-diasize-change-size = false
     5368     .
     5369   end procedure.
     5370   procedure diasize_set-width :
     5371     define input  parameter p-new-width  as decimal   no-undo .
     5372     define input  parameter p-move-resize as logical   no-undo .
     5373     do
     5374     on error undo, return error return-value
     5375     :
     5376       run diasize_change-width in this-procedure
     5377         (input  (p-new-width - frame Dialog-Frame :width)
     5378         ,input  p-move-resize
     5379         ) .
     5380     end.
     5381   end procedure.
     5382   procedure diasize_position-resize-button :
     5383     do with frame Dialog-Frame
     5384     :
     5385       hide v-diasize-resize-button .
     5386       assign
     5387         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5388                     - 1
     5389                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5390         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5391                     - 1
     5392                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5393       .
     5394       view v-diasize-resize-button .
     5395     end.
     5396   end procedure.
     5397   on alt-right anywhere
     5398   do:
     5399     run diasize_change-width in this-procedure
     5400       (input 1
     5401       ,input true
     5402       ) .
     5403     return no-apply .
     5404   end.
     5405   on alt-left anywhere
     5406   do:
     5407     run diasize_change-width in this-procedure
     5408       (input -1
     5409       ,input true
     5410       ) .
     5411     return no-apply .
     5412   end.
     5413   on alt-down anywhere
     5414   do:
     5415     run diasize_change-height in this-procedure
     5416       (input 1
     5417       ,input true
     5418       ) .
     5419     return no-apply .
     5420   end.
     5421   on alt-up anywhere
     5422   do:
     5423     run diasize_change-height in this-procedure
     5424       (input -1
     5425       ,input true
     5426       ) .
     5427     return no-apply .
     5428   end.
     5429   on alt-enter of frame Dialog-Frame
     5430   do:
     5431     run diasize_maximize in this-procedure
     5432       (input  ?
     5433       ).
     5434     return no-apply .
     5435   end.
     5436   procedure diasize_end-move :
     5437     do
     5438     on error undo, return error return-value
     5439     :
     5440       define variable v-row-delta as decimal   no-undo .
     5441       define variable v-col-delta as decimal   no-undo .
     5442       define variable v-new-row as decimal   no-undo .
     5443       define variable v-new-col as decimal   no-undo .
     5444       assign
     5445         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5446         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5447       .
     5448       assign
     5449         v-row-delta = v-new-row - frame Dialog-Frame :height
     5450         v-col-delta = v-new-col - frame Dialog-Frame :width
     5451       .
     5452       run diasize_change-height in this-procedure
     5453         (input v-row-delta
     5454         ,input true
     5455         ) .
     5456       run diasize_change-width in this-procedure
     5457         (input v-col-delta
     5458         ,input true
     5459         ) .
     5460     end.
     5461   end procedure.
     5462   procedure diasize_maximize :
     5463     define input  parameter p-action as logical   no-undo .
     5464     do
     5465     on error undo, return error return-value
     5466     :
     5467       if p-action = ?
     5468       then do:
     5469         if v-diasize-need-maximize = true
     5470         then do:
     5471           assign
     5472             p-action = true
     5473           .
     5474         end.
     5475         else do:
     5476           assign
     5477             p-action = false
     5478           .
     5479         end.
     5480       end.
     5481       if p-action = true
     5482       then do:
     5483         run diasize_change-height in this-procedure
     5484           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5485               - frame Dialog-Frame :height-chars
     5486           ,input true
     5487           ) .
     5488         run diasize_change-width in this-procedure
     5489           (input session :width-chars
     5490               - frame Dialog-Frame :width-chars
     5491           ,input true
     5492           ) .
     5493         assign
     5494           v-diasize-need-maximize = false
     5495         .
     5496       end.
     5497       else do:
     5498         run diasize_change-width in this-procedure
     5499           (input v-diasize-orig-frame-width
     5500               - frame Dialog-Frame :width-chars
     5501           ,input true
     5502           ) .
     5503         run diasize_change-height in this-procedure
     5504           (input v-diasize-orig-frame-height
     5505               - frame Dialog-Frame :height-chars
     5506           ,input true
     5507           ) .
     5508         assign
     5509           v-diasize-need-maximize = true
     5510         .
     5511       end.
     5512     end.
     5513   end procedure.
     5514   procedure diasize_restore-orig-size :
     5515     do
     5516     on error undo, return error return-value
     5517     :
     5518       assign
     5519         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5520         v-diasize-current-frame-height = frame Dialog-Frame :height
     5521       .
     5522       run diasize_set-height in this-procedure
     5523         (input  v-diasize-orig-frame-height
     5524         ,input  true
     5525         ) .
     5526       run diasize_set-width in this-procedure
     5527         (input  v-diasize-orig-frame-width
     5528         ,input  true
     5529         ) .
     5530     end.
     5531   end procedure.
     5532   procedure diasize_restore-current-size :
     5533     do
     5534     on error undo, return error return-value
     5535     :
     5536       run diasize_set-height in this-procedure
     5537         (input  v-diasize-current-frame-height
     5538         ,input  true
     5539         ) .
     5540       run diasize_set-width in this-procedure
     5541         (input  v-diasize-current-frame-width
     5542         ,input  true
     5543         ) .
     5544     end.
     5545   end procedure.
     5546   procedure diasize_set-browse-handle :
     5547     define input  parameter p-browse-handle as handle   no-undo .
     5548     define buffer buf_temp-browse-handle for temp-browse-handle .
     5549     do
     5550     on error undo, return error return-value
     5551     :
     5552       assign
     5553         v-diasize-browse-handle = p-browse-handle
     5554       .
     5555       for each buf_temp-browse-handle
     5556       on error undo, return error return-value
     5557       :
     5558         delete buf_temp-browse-handle .
     5559       end.
     5560     end.
     5561   end procedure.
     5562   procedure diasize_add_browse :
     5563     define input  parameter p-browse-type   as character no-undo .
     5564     define input  parameter p-browse-handle as handle    no-undo .
     5565     define buffer buf_temp-browse-handle for temp-browse-handle .
     5566     do
     5567     on error undo, return error return-value
     5568     :
     5569       assign
     5570         v-diasize-browse-number = v-diasize-browse-number + 1
     5571       .
     5572       create buf_temp-browse-handle .
     5573       assign
     5574         buf_temp-browse-handle.browse-type   = p-browse-type
     5575         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5576         buf_temp-browse-handle.browse-handle = p-browse-handle
     5577       .
     5578     end.
     5579   end procedure.
     5580   procedure diasize_init :
     5581     define variable v-default-value    as logical   no-undo .
     5582     define variable v-restore-saved    as logical   no-undo .
     5583     define variable v-resize-value-str as character no-undo .
     5584     do
     5585     on error undo, return error return-value
     5586     :
     5587       do with frame Dialog-Frame
     5588       :
     5589         assign
     5590           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5591           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5592           v-diasize-browse-handle     = browse br-parts :handle
     5593         .
     5594         create button v-diasize-resize-button
     5595         assign
     5596           parent        = frame Dialog-Frame :first-child
     5597           label         = "s"
     5598           height-pixels = 16
     5599           width-pixels  = 16
     5600           visible       = true
     5601           sensitive     = true
     5602           movable       = true
     5603           triggers:
     5604             on end-move persistent run diasize_end-move in this-procedure .
     5605           end triggers.
     5606         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5607         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5608         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5609         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5610         assign
     5611           v-diasize-wndmax = false
     5612         .
     5613         if connected("ub") = true
     5614         then do:
     5615           define variable v-cntxt-db-num        as integer   no-undo .
     5616           define variable v-cntxt-userid        as character no-undo .
     5617           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5618                                             , OUTPUT v-cntxt-userid
     5619                                             ) .
     5620           run gbl/wndpar_r.p
     5621             (input  v-cntxt-db-num
     5622             ,input  v-cntxt-userid
     5623             ,input  'wndmax':U
     5624             ,output v-diasize-wndmax
     5625             ,output v-default-value
     5626             ) .
     5627         end.
     5628         assign
     5629           v-diasize-wndstore = false
     5630         .
     5631         if connected("ub") = true
     5632         then do:
     5633           run gbl/wndpar_r.p
     5634             (input  v-cntxt-db-num
     5635             ,input  v-cntxt-userid
     5636             ,input  'wndstore':U
     5637             ,output v-diasize-wndstore
     5638             ,output v-default-value
     5639             ) .
     5640         end.
     5641         assign
     5642           v-diasize-proc-name = entry(1, program-name(2), '.')
     5643         .
     5644         if v-diasize-wndstore = true
     5645         then do:
     5646           assign
     5647             v-restore-saved = false
     5648           .
     5649           if connected("ub") = true
     5650           then do:
     5651             run gbl/wndsizer.p
     5652               (input  v-cntxt-db-num
     5653               ,input  v-cntxt-userid
     5654               ,input  v-diasize-proc-name
     5655               ,input  'height':u
     5656               ,output v-resize-value-str
     5657               ) .
     5658             if v-resize-value-str <> '':U
     5659             then do:
     5660               run diasize_change-height in this-procedure
     5661                 (input  integer(v-resize-value-str)
     5662                 ,input  true
     5663                 ) .
     5664               assign
     5665                 v-restore-saved = true
     5666               .
     5667             end.
     5668           end.
     5669           if connected("ub") = true
     5670           then do:
     5671             run gbl/wndsizer.p
     5672               (input  v-cntxt-db-num
     5673               ,input  v-cntxt-userid
     5674               ,input  v-diasize-proc-name
     5675               ,input  'width':u
     5676               ,output v-resize-value-str
     5677               ) .
     5678             if v-resize-value-str <> '':U
     5679             then do:
     5680               run diasize_change-width in this-procedure
     5681                 (input  integer(v-resize-value-str)
     5682                 ,input  true
     5683                 ) .
     5684               assign
     5685                 v-restore-saved = true
     5686               .
     5687             end.
     5688           end.
     5689           if v-restore-saved <> true
     5690           then do:
     5691             if v-diasize-wndmax = true
     5692             then do:
     5693               run diasize_maximize in this-procedure
     5694                 (input  true
     5695                 ) .
     5696             end.
     5697           end.
     5698         end.
     5699         else do:
     5700           if v-diasize-wndmax = true
     5701           then do:
     5702             run diasize_maximize in this-procedure
     5703               (input  true
     5704               ) .
     5705           end.
     5706         end.
     5707       end.
     5708     end.
     5709   end procedure.
     5710   procedure diasize_need-full-display :
     5711     define output parameter p-need-full-display as logical   no-undo .
     5712     do
     5713     on error undo, return error return-value
     5714     :
     5715       assign
     5716         p-need-full-display = v-diasize-need-full-display
     5717       .
     5718       assign
     5719         v-diasize-need-full-display = false
     5720       .
     5721     end.
     5722   end procedure.
     5723   procedure get-context :
     5724      define output parameter p-db-num as integer          no-undo.
     5725      define output parameter p-user-id as character        no-undo.
     5726      define variable v-login               as character    no-undo.
     5727      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5728      define buffer buf_user-login  for ub.user-login .
     5729      do
     5730      on error undo, return error
     5731      :
     5732            FIND FIRST buf_sys-ctrl no-lock.
     5733            ASSIGN
     5734               v-login = USERID("ub")
     5735               p-db-num = buf_sys-ctrl.db-num
     5736            .
     5737            FIND FIRST buf_user-login
     5738                 WHERE buf_user-login.db-num = p-db-num
     5739                   AND buf_user-login.user-login = v-login
     5740                 no-lock
     5741                 no-error
     5742                 .
     5743            IF AVAILABLE buf_user-login
     5744            THEN DO:
     5745               assign
     5746                  p-user-id = buf_user-login.user-id
     5747               .
     5748            END.
     5749      end.
     5750   end procedure.
     5751       run diasize_init in this-procedure .
     5752   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5753   procedure set-filter-name :
     5754   define input parameter p-filter-name as character no-undo .
     5755     do with frame Dialog-Frame:
     5756       if p-filter-name > "" then do:
     5757         assign
     5758           frame Dialog-Frame:title
     5759             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     5760         .
     5761         assign
     5762           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     5763         .
     5764       end.
     5765       else do:
     5766         assign
     5767           b-sch :tooltip = ""
     5768         .
     5769       end.
     5770     end.
     5771   end procedure.
     5772   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5773   on INS of frame Dialog-Frame anywhere do:
     5774     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     5775     return no-apply.
     5776   end.
     5777   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5778   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     5779     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     5780     return no-apply.
     5781   end.
     5782   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5783   on F4 of frame Dialog-Frame anywhere do:
     5784     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     5785     return no-apply.
     5786   end.
     5787   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5788   on F8 of frame Dialog-Frame anywhere do:
     5789     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     5790     return no-apply.
     5791   end.
     5792   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5793   on F2 of frame Dialog-Frame anywhere do:
     5794     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     5795     return no-apply.
     5796   end.
     5797   define variable vss-include-info44 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5798   on F2 of frame Dialog-Frame anywhere do:
     5799     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     5800     return no-apply.
     5801   end.
     5802   define variable vss-include-info45 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5803   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     5804     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     5805     return no-apply.
     5806   end.
     5807   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5808   do:
     5809     br-parts :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5810   end.
     5811   CASE p-coll-point:
     5812       WHEN 'Номинал МЦ':U or when 'Серии МЦ':U or when 'Место хранения МЦ':U THEN DO:
     5813         if p-edit-mode = 'ДОБАВЛЕНИЕ':U or  p-edit-mode = 'ИЗМЕНЕНИЕ':U then do:
     5814           message vss-workfile vss-revision vss-description skip
     5815           substitute('Неверные параметры вызова (p-coll-point = "&2",p-edit-mode = "&3" ). Возможен только режим &1.','ПРОСМОТР':U,p-coll-point, p-edit-mode)
     5816           view-as alert-box ERROR.
     5817           return.
     5818         end.
     5819       END.
     5820       WHEN "document":U THEN DO:
     5821       END.
     5822       OTHERWISE DO:
     5823           message vss-workfile vss-revision vss-description skip
     5824           "Неверный вызов - p-coll-point=" p-coll-point
     5825           view-as alert-box ERROR.
     5826           return.
     5827       END.
     5828   END CASE.
     5829   if p-edit-mode = 'ИЗМЕНЕНИЕ':U or p-edit-mode = 'ДОБАВЛЕНИЕ':U
     5830   then do:
     5831     TRANSACTION-MAIN-BLOCK:
     5832     DO TRANSACTION
     5833     ON ERROR   UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     5834     ON END-KEY UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     5835     :
     5836       run main-block-procedure no-error .
     5837       if error-status :error
     5838       then do:
     5839           undo, return error .
     5840       end.
     5841     END.
     5842   end.
     5843   ELSE if p-edit-mode = 'ПРОСМОТР':U THEN do:
     5844     MAIN-BLOCK:
     5845     DO
     5846     ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5847     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5848     :
     5849      run main-block-procedure no-error .
     5850       if error-status :error
     5851       then do:
     5852         LEAVE MAIN-BLOCK .
     5853       end.
     5854     END.
     5855   end.
     5856   else do:
     5857         message vss-workfile vss-revision vss-description skip
     5858         "Неверный параметр вызова - p-edit-mode=" p-edit-mode
     5859         view-as alert-box error.
     5860         return.
     5861   end.
     5862   RUN disable_UI.
     5863   PROCEDURE disable_UI :
     5864     HIDE FRAME Dialog-Frame.
     5865   END PROCEDURE.
     5866   PROCEDURE enable_UI :
     5867     DISPLAY rsfl-ch rsfl-obj bar-str fl-wth-name fl-par-val fl-gds fl-par-price
     5868             fl-doc-code fl-doc-date fl-doc-ext-type text-sts Fn-rs-obj
     5869         WITH FRAME Dialog-Frame.
     5870     ENABLE b-exit b-quit B-mark B-mark-all B-cancel-mark B-sel b-lkp B-add B-chg
     5871            B-del B-sch B-print B-hist B-Help RECT-1 RECT-8 rsfl-obj br-parts
     5872            bar-str fl-wth-name fl-par-val fl-par-price fl-doc-code fl-doc-date
     5873            fl-doc-ext-type text-sts Fn-rs-obj
     5874         WITH FRAME Dialog-Frame.
     5875     VIEW FRAME Dialog-Frame.
     5876     OPEN QUERY br-parts FOR EACH X_wth-parts NO-LOCK INDEXED-REPOSITION.
     5877   END PROCEDURE.
     5878   PROCEDURE load-position :
     5879   define variable v-current-zone-string      as character    no-undo.
     5880   define variable v-current-obj-string       as character    no-undo.
     5881   define variable v-void-logical              as logical      no-undo.
     5882   define variable v-void-character            as character    no-undo.
     5883   define variable v-found                     as logical      no-undo.
     5884   do   with frame Dialog-Frame
     5885   on error undo, return error
     5886   :
     5887       run uf-get (
     5888            input 'wthps-zone':U
     5889           , input v-cntxt-userid
     5890           , output v-current-zone-string
     5891           , output v-void-character
     5892           , output v-void-logical
     5893           , output v-void-logical
     5894           , output v-void-logical
     5895           , output v-void-logical
     5896       ) no-error.
     5897       if not error-status :error  then rsfl-ch:screen-value =  v-current-zone-string.
     5898       run uf-get (
     5899             input 'wthparts-obj':U
     5900           , input v-cntxt-userid
     5901           , output v-current-obj-string
     5902           , output v-void-character
     5903           , output v-void-logical
     5904           , output v-void-logical
     5905           , output v-void-logical
     5906           , output v-void-logical
     5907       ) no-error.
     5908       if not error-status :error  then rsfl-obj:screen-value =  v-current-obj-string.
     5909    end.
     5910   END PROCEDURE.
     5911   PROCEDURE main-block-procedure :
     5912   if p-wth-code > 0 or p-coll-point = 'Номинал МЦ':U then do:
     5913     find first b-wealth where b-wealth.wth-code = p-wth-code no-lock no-error.
     5914     if not available b-wealth then do:
     5915       message substitute("Не найдена МЦ с кодом &1!",p-wth-code)
     5916       view-as alert-box error.
     5917       return error.
     5918     end.
     5919   end.
     5920   if p-par-code > 0 or p-coll-point = 'Номинал МЦ':U then do:
     5921     find first b-wth-par where b-wth-par.wth-code = p-wth-code
     5922                             and  b-wth-par.par-code = p-par-code
     5923     no-lock no-error.
     5924     if not available b-wth-par then do:
     5925       message substitute("Не найден номинал МЦ. Код номинала: &1, Код МЦ: &2!",p-par-code, p-wth-code)
     5926       view-as alert-box error.
     5927       return error.
     5928     end.
     5929   end.
     5930   if p-ser-code > 0 or p-coll-point = 'Серии МЦ':U then do:
     5931     find first b-wth-ser where b-wth-ser.ser-code = p-ser-code
     5932                              and b-wth-ser.db-num = p-db-num
     5933     no-lock no-error.
     5934     if not available b-wth-ser then do:
     5935       message substitute("Не найдена серия МЦ. Код серии &1-&2!",p-ser-code, p-db-num)
     5936       view-as alert-box error.
     5937       return error.
     5938     end.
     5939   end.
     5940   if p-coll-point = 'document':U then do:
     5941     if p-edit-mode = 'ПРОСМОТР':U then
     5942     FIND FIRST b-wth-doc WHERE b-wth-doc.doc-code = p-wth-doc NO-LOCK NO-ERROR.
     5943     ELSE FIND FIRST b-wth-doc WHERE b-wth-doc.doc-code = p-wth-doc exclusive-lock NO-ERROR.
     5944     if not available b-wth-doc then do:
     5945       message substitute("Не найден документ с номером &1!",p-wth-doc)
     5946       view-as alert-box error.
     5947       return error.
     5948     end.
     5949   end.
     5950   run MyEnable.
     5951   apply "value-changed":U to rsfl-ch in frame Dialog-Frame.
     5952   wait-for 'go' of frame    Dialog-Frame  .
     5953   END PROCEDURE.
     5954   PROCEDURE MyEnable :
     5955   br-parts:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 4 .
     5956   DEF VAR rs-list AS CHAR.
     5957   enable rsfl-obj with frame   Dialog-Frame.
     5958   rsfl-ch:DELETE("все") IN FRAME Dialog-Frame.
     5959   IF p-coll-point = 'document' THEN DO:
     5960       FIND FIRST b-wth-doc WHERE b-wth-doc.doc-code = p-wth-doc NO-LOCK NO-ERROR.
     5961       IF AVAILABLE b-wth-doc THEN do:
     5962           CASE b-wth-doc.ext-doc-type:
     5963               WHEN 'ie':U OR WHEN 'ip':U or when 'ff':U
     5964               or WHEN 'rp':U or WHEN 'rf':U
     5965               or when 'fj':U or when 'pj':U  THEN DO:
     5966                   rsfl-ch:ADD-LAST("Документ",0).
     5967               END.
     5968               WHEN 'ee':U or when 'ef':U or when 'jj':U THEN DO:
     5969                   rsfl-ch:ADD-LAST("Все",11).
     5970                   rsfl-ch:ADD-LAST("Документ",0).
     5971                   rsfl-ch:ADD-LAST("Свободная зона ", 1).
     5972               END.
     5973               WHEN 'ep':U or when 'oj':U THEN DO:
     5974                   rsfl-ch:ADD-LAST("Все",13).
     5975                   rsfl-ch:ADD-LAST("Документ",0).
     5976                   rsfl-ch:ADD-LAST("Зона погашения", 3).
     5977               END.
     5978               WHEN 'pc':U THEN DO:
     5979                   rsfl-ch:ADD-LAST("Все",12).
     5980                   rsfl-ch:ADD-LAST("Документ",0).
     5981                   rsfl-ch:ADD-LAST("Зона покупателей", 2).
     5982               END.
     5983               WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     5984                   rsfl-ch:ADD-LAST("Все",12).
     5985                   rsfl-ch:ADD-LAST("Документ",0).
     5986                   rsfl-ch:ADD-LAST("Зона покупателей", 2).
     5987               END.
     5988               WHEN 'df':U THEN DO:
     5989                   rsfl-ch:ADD-LAST("Все",11).
     5990                   rsfl-ch:ADD-LAST("Документ",0).
     5991                   rsfl-ch:ADD-LAST("Свободная. зона", 1).
     5992               END.
     5993               WHEN 'dp':U THEN DO:
     5994                   rsfl-ch:ADD-LAST("Все",13).
     5995                   rsfl-ch:ADD-LAST("Документ",0).
     5996                   rsfl-ch:ADD-LAST("Зона погашения", 3).
     5997               END.
     5998               WHEN 'xc':U THEN DO:
     5999                 if p-type = 'при':U then do:
     6000                   rsfl-ch:ADD-LAST("Все",12).
     6001                   rsfl-ch:ADD-LAST("Документ",0).
     6002                   rsfl-ch:ADD-LAST("Зона покупателей", 2).
     6003                 end.
     6004                 else do:
     6005                   rsfl-ch:ADD-LAST("Все",11).
     6006                   rsfl-ch:ADD-LAST("Документ",0).
     6007                   rsfl-ch:ADD-LAST("Свободная зона", 1).
     6008                 end.
     6009               END.
     6010               OTHERWISE DO:
     6011                   MESSAGE substitute("Неверный вызов - ext-doc-type =  :&1&2&3"
     6012                                        , b-wth-doc.ext-doc-type
     6013                                        , error-status:get-message(1)
     6014                                        , return-value
     6015                                      ) VIEW-AS ALERT-BOX ERROR.
     6016                   RETURN ERROR.
     6017               END.
     6018           END CASE.
     6019           if b-wth-doc.doc-type = 'при':U and b-wth-doc.exter_ =  no then do:
     6020             br-parts:MOVE-COLUMN(14,6).
     6021             br-parts:MOVE-COLUMN(15,7).
     6022             br-parts:MOVE-COLUMN(16,8).
     6023           end.
     6024       END.
     6025   END.
     6026   ELSE if p-coll-point = 'Место хранения МЦ':U THEN DO:
     6027       rsfl-ch:ADD-LAST("Все", 0).
     6028       rsfl-ch:ADD-LAST("Свободная зона", 1).
     6029       rsfl-ch:ADD-LAST("Зона погашения", 3).
     6030       rsfl-ch:ADD-LAST("Зона уничтожения", 4).
     6031       view b-doc-code in frame  Dialog-Frame.
     6032       hide rsfl-obj
     6033            Fn-rs-obj in frame  Dialog-Frame.
     6034   END.
     6035   ELSE DO:
     6036       rsfl-ch:ADD-LAST("Все", 0).
     6037       rsfl-ch:ADD-LAST("Свободная зона", 1).
     6038       rsfl-ch:ADD-LAST("Зона покупателей", 2).
     6039       rsfl-ch:ADD-LAST("Зона погашения", 3).
     6040       rsfl-ch:ADD-LAST("Зона уничтожения", 4).
     6041       view b-doc-code in frame  Dialog-Frame.
     6042   END.
     6043   ENABLE b-exit when not p-edit-mode = 'ПРОСМОТР':U or p-coll-point ne 'document':U
     6044       b-quit when  p-coll-point = 'document':U
     6045       rsfl-ch
     6046       b-lkp
     6047       br-parts
     6048       b-sch
     6049       b-hist
     6050       b-print
     6051       b-help
     6052       bar-str
     6053       text-sts
     6054       b-mark when p-coll-point = 'document':U and p-edit-mode  <> 'ПРОСМОТР':U
     6055       b-mark-all when p-coll-point = 'document':U and p-edit-mode  <> 'ПРОСМОТР':U
     6056       B-cancel-mark  when p-coll-point = 'document':U and p-edit-mode  <> 'ПРОСМОТР':U
     6057       b-add WHEN p-coll-point = 'document':U AND p-edit-mode <> 'ПРОСМОТР':U and not( b-wth-doc.exter_ = no and  b-wth-doc.doc-type = 'при':U)
     6058       b-chg WHEN p-coll-point = 'document':U AND p-edit-mode = 'ИЗМЕНЕНИЕ':U
     6059       b-del WHEN p-coll-point = 'document':U AND p-edit-mode = 'ИЗМЕНЕНИЕ':U
     6060       b-doc-code  WHEN  not p-coll-point = 'document':U
     6061       rsfl-obj when p-coll-point <> 'Место хранения МЦ':U
     6062   WITH FRAME Dialog-Frame.
     6063   text-sts:screen-value = 'Статус:'.
     6064   if p-coll-point = 'document':U then do:
     6065       disable rsfl-ch when p-edit-mode = 'ПРОСМОТР':U
     6066               rsfl-obj
     6067       with frame Dialog-Frame.
     6068       rsfl-ch:row = 2.7.
     6069       text-sts:row = 2.7.
     6070       text-sts:move-to-top().
     6071       hide rsfl-obj in frame  Dialog-Frame.
     6072       if p-edit-mode = 'ПРОСМОТР':U then  do:
     6073         b-quit:label = 'Выход'.
     6074         rsfl-ch:screen-value = '0'.
     6075       end.
     6076   end.
     6077   else do:
     6078     run load-position in this-procedure.
     6079     Fn-rs-obj:screen-value = 'Объект:'.
     6080     b-exit:label = 'Выход'.
     6081   end.
     6082   END PROCEDURE.
     6083   PROCEDURE OpenBr :
     6084   define variable l-query-was-opened as logical no-undo .
     6085   DEF VAR rsfl-par  AS INT.
     6086   DEF VAR zone-list AS CHAR.
     6087   DEFINE VARIABLE cur-wth-name AS CHARACTER NO-UNDO.
     6088   DEFINE VARIABLE cur-par-val AS INTEGER NO-UNDO.
     6089   DEFINE VARIABLE cur-par-unit AS CHARACTER NO-UNDO.
     6090   DEFINE VARIABLE cur-ser-name AS CHARACTER NO-UNDO.
     6091   DEFINE VARIABLE cur-wth-ext-doc-type AS character NO-UNDO.
     6092   DEFINE VARIABLE cur-wth-ext-doc-type-text AS character NO-UNDO.
     6093   DEFINE VARIABLE cur-wth-doc-code AS CHARACTER NO-UNDO.
