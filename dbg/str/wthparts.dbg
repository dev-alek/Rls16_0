     3921        SIZE 97 BY 1.5.
     3922   DEFINE QUERY br-parts FOR
     3923         X_wth-parts SCROLLING.
     3924   DEFINE BROWSE br-parts
     3925     QUERY br-parts NO-LOCK DISPLAY
     3926         mark-string( recid(X_wth-parts), rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     3927         get-ser-name(X_wth-parts.ser-code,X_wth-parts.db-num) @ v-serName COLUMN-LABEL "Серия"  FORMAT "X(10)":U
     3928         X_wth-parts.fact-rangeFrom  COLUMN-LABEL "Диапазон с" FORMAT "->>>>>>>>9":U
     3929         X_wth-parts.fact-rangeTo  COLUMN-LABEL "по" FORMAT "->>>>>>>>9":U
     3930         X_wth-parts.fact-qnty  FORMAT "->,>>>,>>9":U  COLUMN-LABEL "Колич." WIDTH 8
     3931         get-cli-name(X_wth-parts.obj-type,X_wth-parts.obj-code ) @ v-obj-name   COLUMN-LABEL "Объект"     FORMAT "X(26)":U
     3932         get-w-p-name(X_wth-parts.w-p-code, X_wth-parts.obj-type,X_wth-parts.obj-code) @ v-w-p-name COLUMN-LABEL "МХ"  FORMAT "X(12)":U
     3933         get-wthparts-out-code(X_wth-parts.out-code) @ v-out-name COLUMN-LABEL "Документ\зона"
     3934         X_wth-parts.in-code COLUMN-LABEL "Док. порожд." FORMAT "X(10)":U
     3935         X_wth-parts.price-rubl FORMAT "->>>,>>9.99":U   COLUMN-LABEL "Цена талона"
     3936         X_wth-parts.beg-dt   COLUMN-LABEL "Срок годн. с" format "99/99/99"
     3937         X_wth-parts.end-dt   COLUMN-LABEL "Срок годн. по"  format "99/99/99"
     3938         get-cli-name(X_wth-parts.sale-obj-type,X_wth-parts.sale-obj-code )  COLUMN-LABEL "Объект реализ."   FORMAT "X(14)":U
     3939         get-cli-name(X_wth-parts.cli-type,X_wth-parts.cli-code )   COLUMN-LABEL "Покупатель"     FORMAT "X(14)":U
     3940         get-cli-name(X_wth-parts.out-obj-type,X_wth-parts.out-obj-code )   COLUMN-LABEL "Объект погаш."   FORMAT "X(14)":U
     3941         X_wth-parts.fact-date FORMAT "99/99/99":U  COLUMN-LABEL "Факт. дата"
     3942         X_wth-parts.shift-date FORMAT "99/99/99":U
     3943         X_wth-parts.shift-num FORMAT ">9":U
     3944         get-cli-name(X_wth-parts.in-obj-type,X_wth-parts.out-obj-code )  COLUMN-LABEL "Объект нач. приобрет."   FORMAT "X(14)":U
     3945         get-cli-name(X_wth-parts.supp-type,X_wth-parts.supp-code )    COLUMN-LABEL "Поставщик"    FORMAT "X(14)":U
     3946         X_wth-parts.doc-code COLUMN-LABEL "Документ"
     3947         X_wth-parts.doc-rangeFrom FORMAT "->,>>>,>>>,>>9":U  column-label 'Диапазон с (док.)'
     3948         X_wth-parts.doc-rangeTo FORMAT "->,>>>,>>>,>>9":U    column-label 'Диапазон по (док.)'
     3949         X_wth-parts.qnty-doc FORMAT "->>>,>>>,>>9":U   column-label 'Кол-во (док.)'
     3950         X_wth-parts.price-base FORMAT "->>,>>>,>>9.99":U
     3951         X_wth-parts.VAT-pc FORMAT ">9.9<%":U
     3952         X_wth-parts.host-code COLUMN-LABEL "Код фирмы" FORMAT ">>>>>>>>9":U
     3953         ENTRY(LOOKUP(X_wth-parts.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) FORMAT "X(18)":U   column-label 'Расш. тип'
     3954         X_wth-parts.fact-num FORMAT "->,>>>,>>9":U
     3955         X_wth-parts.fact-order FORMAT "9999999999999999999999.9999999999":U
     3956         X_wth-parts.wth-code
     3957         X_wth-parts.par-code
     3958         substitute('&1-&2',X_wth-parts.ser-code,X_wth-parts.db-num) @ v-SerDb COLUMN-LABEL "Код серии"
     3959         X_wth-parts.stts FORMAT ">9":U
     3960         X_wth-parts.TYPE
     3961       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 12.25
     3962            FONT 2 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
     3963   DEFINE FRAME Dialog-Frame
     3964        b-exit AT ROW 1 COL 1 WIDGET-ID 18
     3965        b-quit AT ROW 1 COL 11 WIDGET-ID 20
     3966        B-mark AT ROW 1 COL 21 WIDGET-ID 12
     3967        B-mark-all AT ROW 1 COL 24 WIDGET-ID 316
     3968        B-cancel-mark AT ROW 1 COL 27 WIDGET-ID 318
     3969        B-sel AT ROW 1 COL 30 WIDGET-ID 16
     3970        b-lkp AT ROW 1 COL 40 WIDGET-ID 22
     3971        B-add AT ROW 1 COL 50 WIDGET-ID 2
     3972        B-chg AT ROW 1 COL 60 WIDGET-ID 4
     3973        B-del AT ROW 1 COL 70 WIDGET-ID 6
     3974        B-sch AT ROW 1 COL 82 WIDGET-ID 60
     3975        B-print AT ROW 1 COL 86.5 WIDGET-ID 14
     3976        B-hist AT ROW 1 COL 90.5 WIDGET-ID 10
     3977        B-Help AT ROW 1 COL 94 WIDGET-ID 8
     3978        rsfl-ch AT ROW 2.25 COL 11 NO-LABEL WIDGET-ID 62
     3979        rsfl-obj AT ROW 3 COL 11 NO-LABEL WIDGET-ID 292
     3980        br-parts AT ROW 4 COL 1 WIDGET-ID 200
     3981        bar-str AT ROW 16.38 COL 16.5 COLON-ALIGNED NO-LABEL WIDGET-ID 320
     3982        fl-wth-name AT ROW 17.75 COL 4.5 COLON-ALIGNED WIDGET-ID 50
     3983        fl-par-val AT ROW 17.75 COL 40 COLON-ALIGNED WIDGET-ID 52
     3984        fl-gds AT ROW 17.75 COL 57 COLON-ALIGNED WIDGET-ID 58
     3985        fl-par-price AT ROW 17.75 COL 82 COLON-ALIGNED WIDGET-ID 326
     3986        b-doc-code AT ROW 19.25 COL 2.5 WIDGET-ID 308
     3987        fl-doc-code AT ROW 19.25 COL 14.5 COLON-ALIGNED WIDGET-ID 304
     3988        fl-doc-date AT ROW 19.25 COL 29 COLON-ALIGNED WIDGET-ID 324
     3989        fl-doc-ext-type AT ROW 19.25 COL 42.5 COLON-ALIGNED NO-LABEL WIDGET-ID 302
     3990        text-sts AT ROW 2.25 COL 1.13 COLON-ALIGNED NO-LABEL WIDGET-ID 314
     3991        Fn-rs-obj AT ROW 3.17 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 312
     3992        "Штрих-код:" VIEW-AS TEXT
     3993             SIZE 10.5 BY .67 AT ROW 16.58 COL 6.63 WIDGET-ID 328
     3994             FGCOLOR 4
     3995        RECT-1 AT ROW 17.5 COL 1 WIDGET-ID 300
     3996        RECT-8 AT ROW 19 COL 1 WIDGET-ID 310
     3997        SPACE(0.00) SKIP(0.07)
     3998       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3999            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4000            TITLE "Партии серийных МЦ" WIDGET-ID 100.
     4001   ASSIGN
     4002          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4003          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4004   ASSIGN
     4005          b-doc-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4006   ASSIGN
     4007          fl-doc-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4008   ASSIGN
     4009          fl-doc-ext-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4010   ASSIGN
     4011          rsfl-ch:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4012   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4013   DO:
     4014     APPLY "END-ERROR":U TO SELF.
     4015   END.
     4016   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     4017   DO:
     4018   define variable glog as logical  no-undo .
     4019   if not available b-wth-doc then return.
     4020   run proc-add in this-procedure.
     4021   RUn OpenBr in this-procedure .
     4022   apply "entry" to BR-parts in frame Dialog-Frame.
     4023   return no-apply.
     4024   END.
     4025   ON CHOOSE OF B-cancel-mark IN FRAME Dialog-Frame
     4026   DO:
     4027    rid-list = ''.
     4028    br-parts:refresh() no-error.
     4029    apply "entry" to br-parts in frame Dialog-Frame.
     4030   END.
     4031   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     4032   DO:
     4033   define variable glog as logical no-undo .
     4034   define variable rep-rec as recid no-undo .
     4035   If not available X_wth-parts then return.
     4036   rep-rec = recid(X_wth-parts).
     4037   run str/wthpartl.w (
     4038                    input parparentproc
     4039                   ,input p-curr-host-code
     4040                   ,input p-curr-obj-type
     4041                   ,input p-curr-obj-code
     4042                   ,INPUT 'ИЗМЕНЕНИЕ':U
     4043                   ,INPUT p-w-p-code
     4044                   ,INPUT X_wth-parts.wth-code
     4045                   ,INPUT X_wth-parts.par-code
     4046                   ,INPUT X_wth-parts.in-code
     4047                   ,INPUT p-wth-doc
     4048                   ,INPUT X_wth-parts.ser-code
     4049                   ,INPUT X_wth-parts.db-num
     4050                   ,INPUT X_wth-parts.fact-rangeFrom
     4051                   ,INPUT X_wth-parts.fact-rangeTo
     4052                   ,INPUT p-type
     4053                   ,input-output rep-rec).
     4054   if rep-rec <> ? then do:
     4055     v-prt-rec = rep-rec.
     4056     RUn OpenBr in this-procedure .
     4057     apply "entry" to BR-parts in frame Dialog-Frame.
     4058   end.
     4059   else do:
     4060     apply "entry" to BR-parts in frame Dialog-Frame.
     4061     return no-apply.
     4062   end.
     4063   END.
     4064   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     4065   DO:
     4066    define variable del-rec as recid no-undo.
     4067    define variable glog     as logical no-undo .
     4068    define variable rep-rec as recid no-undo .
     4069    define buffer buf_wth-ser for ub.wth-ser.
     4070    if not available X_wth-parts then do:
     4071      message "Неправильно выбрана строка.".
     4072      return no-apply.
     4073    end.
     4074    run proc-del in this-procedure.
     4075       RUn OpenBr in this-procedure .
     4076       apply "entry" to BR-parts in frame Dialog-Frame.
     4077   END.
     4078   ON CHOOSE OF b-doc-code IN FRAME Dialog-Frame
     4079   DO:
     4080   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4081   if lookup(self :type
     4082            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4083            ) = 0
     4084   then do:
     4085     message
     4086       "$Workfile$"
     4087       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4088       "Интерфейсный элемент" self :name  skip
     4089       "Тип" self :type  skip
     4090       "Процедура" this-procedure :file-name skip
     4091       view-as alert-box .
     4092   end.
     4093   else do:
     4094     apply "entry":u to self  .
     4095     if focus :handle <> self :handle  then do:
     4096       return no-apply .
     4097     end.
     4098   end.
     4099     run show-doc-code in this-procedure .
     4100   END.
     4101   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     4102   DO:
     4103   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4104   if lookup(self :type
     4105            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4106            ) = 0
