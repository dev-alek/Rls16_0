     1129   procedure thbjattr_manual-edit :
     1130   define input  parameter p-ucode          as character no-undo .
     1131   define input  parameter p-code           as character no-undo .
     1132   define output parameter p-section-num    as integer no-undo .
     1133   do
     1134   on error undo, return error return-value
     1135   :
     1136       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1137       (input  p-ucode
     1138       ,input  p-code
     1139       ,output  p-section-num
     1140       ) no-error .
     1141     if error-status :error
     1142     then do:
     1143       undo, return error return-value .
     1144     end.
     1145   end.
     1146   end procedure.
     1147   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   procedure factord :
     1152     define input  parameter p-fact-date            as date    no-undo .
     1153     define input  parameter p-fact-time            as integer no-undo .
     1154     define input  parameter p-fact-num             as integer no-undo .
     1155     define input  parameter p-shift-date           as date    no-undo .
     1156     define input  parameter p-shift-num            as integer no-undo .
     1157     define input  parameter p-shift-on             as logical no-undo .
     1158     define output parameter p-fact-order           as decimal no-undo .
     1159     define output parameter p-shift-end-fact-order as decimal no-undo .
     1160     define output parameter p-day-end-fact-order   as decimal no-undo .
     1161     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1162     if p-fact-date = ?
     1163     then do:
     1164       return error "Не указана фактическая дата" .
     1165     end.
     1166     define variable v-fact-date-num as integer no-undo .
     1167     assign
     1168       v-fact-date-num = integer(p-fact-date)
     1169     .
     1170     if p-fact-num = ?
     1171     or p-fact-num = 0
     1172     then do:
     1173       return error "Не задан p-fact-num " + string(p-fact-num) .
     1174     end.
     1175     if p-fact-num < 0
     1176     then do:
     1177       return error "Отрицательный fact-num " + string(p-fact-num) .
     1178     end.
     1179     if p-fact-num >= 100000000
     1180     then do:
     1181       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1182     end.
     1183     if p-shift-on = true
     1184     then do:
     1185       if p-shift-date = ?
     1186       then do:
     1187         return error "Не задана дата смены" .
     1188       end.
     1189       if p-shift-num = ?
     1190       or p-shift-num = 0
     1191       then do:
     1192         return error "Не задан номер смены" .
     1193       end.
     1194     end.
     1195     else do:
     1196       assign
     1197         p-shift-date = p-fact-date
     1198         p-shift-num  = 24
     1199       .
     1200     end.
     1201     define variable v-shift-offset as integer no-undo .
     1202     if p-shift-date = p-fact-date
     1203     then do:
     1204       assign
     1205         v-shift-offset = 1
     1206       .
     1207     end.
     1208     if p-shift-date < p-fact-date
     1209     then do:
     1210       assign
     1211         v-shift-offset = 0
     1212       .
     1213     end.
     1214     if p-shift-date > p-fact-date
     1215     then do:
     1216       message
     1217         vss-workfile vss-revision vss-description skip
     1218         "Неправильная дата закрытия смены" skip
     1219         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1220         view-as alert-box error .
     1221       undo, return error
     1222         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1223           ,string(p-fact-date, '99/99/9999':U)
     1224           ,string(p-shift-date, '99/99/9999':U)
     1225           )
     1226       .
     1227     end.
     1228     if p-shift-num < 1
     1229     or p-shift-num > 24
     1230     then do:
     1231       message
     1232         vss-workfile vss-revision vss-description skip
     1233         "Неправильный номер смены" skip
     1234         "p-shift-num" p-shift-num skip
     1235         view-as alert-box error .
     1236       undo, return error return-value .
     1237     end.
     1238     assign
     1239       p-fact-order           = v-fact-date-num
     1240                              + v-shift-offset * 0.5
     1241                              + p-shift-num    * 0.02 - 0.01
     1242                              + p-fact-num     * 0.0000000001
     1243       p-shift-end-fact-order = v-fact-date-num
     1244                              + v-shift-offset * 0.5
     1245                              + p-shift-num    * 0.02
     1246       p-day-end-fact-order   = v-fact-date-num
     1247                              + 0.99
     1248     .
     1249     if p-fact-order           <= v-fact-date-num
     1250     or p-shift-end-fact-order <= v-fact-date-num
     1251     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1252     or p-shift-end-fact-order >= p-day-end-fact-order
     1253     then do:
     1254       message
     1255         vss-workfile vss-revision vss-description skip
     1256         "Внутренняя ошибка при генерации фактического номера" skip
     1257         "p-fact-date"            p-fact-date            skip
     1258         "p-fact-time"            p-fact-time            skip
     1259         "p-fact-num"             p-fact-num             skip
     1260         "p-shift-date"           p-shift-date           skip
     1261         "p-shift-num"            p-shift-num            skip
     1262         "p-shift-on"             p-shift-on             skip
     1263         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1264         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1265         "v-fact-date-num"        v-fact-date-num        skip
     1266         view-as alert-box error .
     1267       undo, return error return-value .
     1268     end.
     1269   end procedure.
     1270   procedure day-begin-fact-order :
     1271     define input  parameter p-fact-date            as date    no-undo .
     1272     define output parameter p-day-begin-fact-order as decimal no-undo .
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       if p-fact-date = ?
     1277       then do:
     1278         assign
     1279           p-day-begin-fact-order = 0
     1280         .
     1281       end.
     1282       else do:
     1283         assign
     1284           p-day-begin-fact-order = integer(p-fact-date)
     1285         .
     1286       end.
     1287     end.
     1288   end procedure.
     1289   procedure factord-max-fact-order :
     1290     define output parameter p-max-fact-order as decimal   no-undo .
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294       run day-begin-fact-order in this-procedure
     1295         (input  date(1, 1, 5000)
     1296         ,output p-max-fact-order
     1297         ) .
     1298     end.
     1299   end procedure.
     1300   procedure factord-cut-archive :
     1301     define input  parameter p-obj-type             as character no-undo .
     1302     define input  parameter p-obj-code             as integer   no-undo .
     1303     define input  parameter p-fact-date            as date      no-undo .
     1304     define output parameter p-shift-on             as logical   no-undo .
     1305     define output parameter p-shift-date           as date      no-undo .
     1306     define output parameter p-shift-num            as integer   no-undo .
     1307     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1308     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1309     define variable v-fact-order as decimal   no-undo .
     1310     define buffer buf_shift-obj for ub.shift-obj .
     1311     do
     1312     on error undo, return error return-value
     1313     :
     1314   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1316     (input  p-obj-type
     1317     ,input  p-obj-code
     1318     ,input  'shift-on=request'
     1319     ,output p-shift-on
     1320     ) no-error .
     1321       if error-status :error
     1322       then do:
     1323         message
     1324           vss-workfile vss-revision vss-description skip
     1325           "Ошибка при определении атрибута объекта" skip
     1326           "Объект" p-obj-type p-obj-code skip
     1327           error-status :get-message(1) skip
     1328           return-value skip
     1329           view-as alert-box error .
     1330         undo, return error return-value .
     1331       end.
     1332       if p-shift-on = false
     1333       then do:
     1334         assign
     1335           p-shift-date               = ?
     1336           p-shift-num                = 0
     1337         .
     1338       end.
     1339       else do:
     1340         find first buf_shift-obj share-lock
     1341           where buf_shift-obj.obj-type   = p-obj-type
     1342             and buf_shift-obj.obj-code   = p-obj-code
     1343             and buf_shift-obj.shift-date > p-fact-date
     1344           use-index pi
     1345           no-error .
     1346         if not available buf_shift-obj
     1347         or buf_shift-obj.status_ <> 'зкр':U
     1348         then do:
     1349           message
     1350             vss-workfile vss-revision vss-description skip
     1351             "Невозможно вычислить последнюю смену" skip
     1352             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1353             "Объект" p-obj-type p-obj-code skip
     1354             "Дата" p-fact-date skip
     1355             view-as alert-box error .
     1356           undo, return error return-value .
     1357         end.
     1358         find last buf_shift-obj share-lock
     1359           where buf_shift-obj.obj-type = p-obj-type
     1360             and buf_shift-obj.obj-code = p-obj-code
     1361             and buf_shift-obj.shift-date <= p-fact-date
     1362           use-index pi
     1363           no-error .
     1364         if available buf_shift-obj
     1365         then do:
     1366           if  buf_shift-obj.status_ = 'зкр':U
     1367           then do:
     1368             assign
     1369               p-shift-date = buf_shift-obj.shift-date
     1370               p-shift-num  = buf_shift-obj.shift-num
     1371             .
     1372           end.
     1373           else do:
     1374             message
     1375               vss-workfile vss-revision vss-description skip
     1376               "Невозможно вычислить последнюю смену" skip
     1377               "Статус смены отличен от статуса" 'зкр':U skip
     1378               "Объект" p-obj-type p-obj-code skip
     1379               "Дата" p-fact-date skip
     1380               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1381               view-as alert-box error .
     1382             undo, return error return-value .
     1383           end.
     1384         end.
     1385         else do:
     1386           assign
     1387             p-shift-date = p-fact-date - 1
     1388             p-shift-num  = 1
     1389           .
     1390         end.
     1391       end.
     1392       run factord in this-procedure
     1393         (input  p-fact-date
     1394         ,input  1
     1395         ,input  1
     1396         ,input  p-shift-date
     1397         ,input  p-shift-num
     1398         ,input  p-shift-on
     1399         ,output v-fact-order
     1400         ,output p-shift-end-fact-order
     1401         ,output p-day-end-fact-order
     1402         ) no-error .
     1403       if error-status :error
     1404       then do:
     1405         message
     1406           vss-workfile vss-revision vss-description skip
     1407           "Ошибка при вызове процедуры factord"
     1408           error-status :get-message(1) skip
     1409           return-value skip
     1410           view-as alert-box error .
     1411         undo, return error return-value .
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure factord-lock-shift :
     1416     define input  parameter p-obj-type  as character no-undo .
     1417     define input  parameter p-obj-code  as integer   no-undo .
     1418     define input  parameter p-fact-date as date      no-undo .
     1419     define parameter buffer buf_shift-obj for ub.shift-obj .
     1420     define variable v-shift-on      as logical   no-undo .
     1421     define variable v-extra-message as character no-undo .
     1422     define variable v-error as character no-undo .
     1423     do
     1424     on error undo, return error return-value
     1425     :
     1426   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1428     (input  p-obj-type
     1429     ,input  p-obj-code
     1430     ,input  'shift-on=request'
     1431     ,output v-shift-on
     1432     ) no-error .
     1433       if error-status :error
     1434       then do:
     1435         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1436         undo, return error v-error .
     1437       end.
     1438       if v-shift-on = true
     1439       then do:
     1440         find first buf_shift-obj share-lock
     1441           where buf_shift-obj.obj-type   = p-obj-type
     1442             and buf_shift-obj.obj-code   = p-obj-code
     1443             and buf_shift-obj.shift-date > p-fact-date
     1444           use-index pi
     1445           no-error .
     1446         if not available buf_shift-obj
     1447         or buf_shift-obj.status_ <> 'зкр':U
     1448         then do:
     1449           find last buf_shift-obj
     1450             where buf_shift-obj.obj-type = p-obj-type
     1451               and buf_shift-obj.obj-code = p-obj-code
     1452               and buf_shift-obj.status_  = 'зкр':U
     1453             use-index stts
     1454             no-error .
     1455           if available buf_shift-obj
     1456           then do:
     1457             assign
     1458               v-extra-message =
     1459                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1460                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1461                               )
     1462             .
     1463           end.
     1464           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1465           undo, return error v-error .
     1466         end.
     1467       end.
     1468     end.
     1469   end procedure.
     1470   procedure factord-end-day :
     1471     define input  parameter p-fact-date            as date    no-undo .
     1472     define output parameter p-day-end-fact-order   as decimal no-undo .
     1473     do
     1474     on error undo, return error return-value
     1475     :
     1476       if p-fact-date = ?
     1477       then do:
     1478         return error "Не указана фактическая дата" .
     1479       end.
     1480       assign
     1481         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1482       .
     1483     end.
     1484   end procedure.
     1485   procedure factord-to-date :
     1486     define input  parameter p-fact-order as decimal no-undo .
     1487     define output parameter p-fact-date  as date    no-undo .
     1488     define variable v-ref-date  as date      no-undo .
     1489     define variable v-ref-delta as integer   no-undo .
     1490     do
     1491     on error undo, return error return-value
     1492     :
     1493       if p-fact-order = ?
     1494       or p-fact-order = 0
     1495       then do:
     1496         return error "Не указан fact-order" .
     1497       end.
     1498       assign
     1499         v-ref-date  = date(1, 1, 2000)
     1500       .
     1501       assign
     1502         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1503       .
     1504       assign
     1505         p-fact-date = v-ref-date + v-ref-delta
     1506       .
     1507     end.
     1508   end procedure.
     1509   procedure factord-to-fact-num :
     1510     define input  parameter p-fact-order as decimal no-undo .
     1511     define output parameter p-fact-num   as integer no-undo .
     1512     define variable v-fact-order-trunc as decimal no-undo .
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       if p-fact-order = ?
     1517       or p-fact-order = 0
     1518       then do:
     1519         return error "Не указан fact-order" .
     1520       end.
     1521       assign
     1522        v-fact-order-trunc = truncate(p-fact-order, 2)
     1523       .
     1524       assign
     1525         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1526       .
     1527     end.
     1528   end procedure.
     1529   procedure factord-to-shift-num :
     1530     define input  parameter p-fact-order as decimal no-undo .
     1531     define output parameter p-shift-num   as integer no-undo .
     1532     define variable  p-shift-numd  as decimal   no-undo .
     1533     define variable v-fact-order-trunc as decimal no-undo .
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       if p-fact-order = ?
     1538       or p-fact-order = 0
     1539       then do:
     1540         return error "Не указан fact-order" .
     1541       end.
     1542       assign
     1543        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1544       .
     1545       if v-fact-order-trunc < 0.5 then do:
     1546         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1547       end.
     1548       assign
     1549         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1550         .
     1551        assign
     1552         p-shift-num = truncate (p-shift-numd , 0)
     1553       .
     1554     end.
     1555   end procedure.
     1556   procedure fact-order-mpl :
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560   define input  parameter p-doc-date as date     no-undo .
     1561   define input  parameter p-obj-type as character no-undo .
     1562   define input  parameter p-obj-code as integer   no-undo .
     1563   define output parameter p-fact-order as decimal   no-undo .
     1564   define variable v-fact-date            as date    no-undo .
     1565   define variable v-fact-time            as integer no-undo .
     1566   define variable v-fact-order           as decimal no-undo .
     1567   define variable v-shift-end-fact-order as decimal no-undo .
     1568   define variable v-day-end-fact-order   as decimal no-undo .
     1569   define variable l-shift-on as logical no-undo .
     1570   define variable l-date as date      no-undo .
     1571   define variable l-time as integer   no-undo .
     1572   define variable shift-date as date      no-undo .
     1573   define variable shift-num  as integer   no-undo .
     1574   define variable shift-name as character no-undo .
     1575   define variable max-fact-order as decimal   no-undo .
     1576   define buffer buf_global-state for ub.global-state  .
     1577   find first buf_global-state no-lock no-error .
     1578   if not available buf_global-state then do:
     1579      message
     1580        "Не заданы параметры ценообразования!"
     1581        view-as alert-box error
     1582      .
     1583      return error return-value .
     1584   end.
     1585     run cur-time in this-procedure
     1586     ( output v-fact-date ,
     1587       output v-fact-time  ).
     1588   if p-doc-date = ? then do:
     1589   if buf_global-state.pl-use-sys-date-time  = true then do:
     1590         run factord in this-procedure
     1591           (input  v-fact-date
     1592           ,input  v-fact-time
     1593           ,input  v-fact-time
     1594           ,input  ?
     1595           ,input  ?
     1596           ,input  false
     1597           ,output v-fact-order
     1598           ,output v-shift-end-fact-order
     1599           ,output v-day-end-fact-order
     1600           ) no-error .
     1601         if error-status :error
     1602         or v-fact-order = ?
     1603         or v-fact-order = 0 then do:
     1604           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1605         end.
     1606         p-fact-order = v-fact-order .
     1607   end.
     1608   else do:
     1609   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1611     (input  p-obj-type
     1612     ,input  p-obj-code
     1613     ,input  'shift-on=request'
     1614     ,output l-shift-on
     1615     ) no-error .
     1616         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1617         if p-doc-date <> ? then do:
     1618         end.
     1619          run gbl/factdate.p
     1620          ( input        p-obj-type  ,
     1621            input        p-obj-code  ,
     1622            input-output v-fact-date ,
     1623            input-output v-fact-time ,
     1624            input-output shift-date      ,
     1625            input-output shift-num       ,
     1626            input-output shift-name      ,
     1627            input        yes
     1628            ) no-error .
     1629         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1630         run factord in this-procedure
     1631           (input  v-fact-date
     1632           ,input  v-fact-time
     1633           ,input  v-fact-time
     1634           ,input  shift-date
     1635           ,input  shift-num
     1636           ,input  l-shift-on
     1637           ,output v-fact-order
     1638           ,output v-shift-end-fact-order
     1639           ,output v-day-end-fact-order
     1640           ) no-error .
     1641         if error-status :error
     1642         or v-fact-order = ?
     1643         or v-fact-order = 0 then do:
     1644           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1645         end.
     1646         p-fact-order = v-fact-order .
     1647   end.
     1648   end.
     1649   else do:
     1650          run gbl/factdate.p
     1651          ( input        p-obj-type  ,
     1652            input        p-obj-code  ,
     1653            input-output v-fact-date ,
     1654            input-output v-fact-time ,
     1655            input-output shift-date      ,
     1656            input-output shift-num       ,
     1657            input-output shift-name      ,
     1658            input        yes
     1659            ) no-error .
     1660         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1661         v-fact-date = p-doc-date .
     1662         run factord in this-procedure
     1663           (input  v-fact-date
     1664           ,input  v-fact-time
     1665           ,input  v-fact-time
     1666           ,input  shift-date
     1667           ,input  shift-num
     1668           ,input  l-shift-on
     1669           ,output v-fact-order
     1670           ,output v-shift-end-fact-order
     1671           ,output v-day-end-fact-order
     1672           ) no-error .
     1673         if error-status :error
     1674         or v-fact-order = ?
     1675         or v-fact-order = 0 then do:
     1676           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1677         end.
     1678         p-fact-order = v-fact-order .
     1679   end.
     1680     end.
     1681   end procedure.
     1682   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1683   field sale-qnty as decimal
     1684   field sale-sum  as decimal
     1685   field sale-tnv  as decimal
     1686   field price-sale-base as decimal
     1687   field price-sale-rubl as decimal
     1688   field road-tax-base   as decimal
     1689   field road-tax-rubl   as decimal
     1690   field excise-base as decimal
     1691   field excise-rubl as decimal
     1692   field date-1 as date
     1693   field date-2 as date
     1694   field shift-1 as int
     1695   field shift-2 as int
     1696   field time-1 as int
     1697   field time-2 as int
     1698   field grp-name as char
     1699   field interv-name as char
     1700   field pay-name as char
     1701   field unit-cli as char
     1702   index pi
     1703   plt-priority DESCENDING
     1704   fact-order DESCENDING
     1705   qnty-from asc
     1706   sum-from asc
     1707   turnover-from asc
     1708   date-1 DESCENDING
     1709   time-1 DESCENDING
     1710   date-2 DESCENDING
     1711   time-2 DESCENDING
     1712   type-price DESCENDING
     1713   .
     1714   procedure mpl-autoprice :
     1715   define input  parameter p-only-b-code as logical   no-undo .
     1716   define input  parameter p-cli-type    as character no-undo .
     1717   define input  parameter p-cli-code    as integer   no-undo .
     1718   define input  parameter p-main-b-code as integer   no-undo .
     1719   define input  parameter p-b-code      as integer   no-undo .
     1720   define input  parameter p-obj-type    as character no-undo .
     1721   define input  parameter p-obj-code    as integer   no-undo .
     1722   define input  parameter p-qnty-doc    as decimal   no-undo .
     1723   define input  parameter p-sum-doc     as decimal   no-undo .
     1724   define input  parameter p-vid-pay        as character no-undo .
     1725   define input  parameter p-cash-pay-type  as character no-undo .
     1726   define input  parameter p-fact-order  as decimal   no-undo .
     1727   define output parameter p-plt-id          as integer   no-undo .
     1728   define output parameter p-plt-db-num      as integer   no-undo .
     1729   define output parameter p-pdf-id          as integer   no-undo .
     1730   define output parameter p-pdf-db-num      as integer   no-undo .
     1731   define output parameter p-sale-price-base as decimal   no-undo .
     1732   define output parameter p-sale-price-rubl as decimal   no-undo .
     1733   define output parameter p-road-tax-base as decimal   no-undo .
     1734   define output parameter p-road-tax-rubl as decimal   no-undo .
     1735   define output parameter p-excise-base   as decimal   no-undo .
     1736   define output parameter p-excise-rubl   as decimal   no-undo .
     1737   define variable v-cli-oborot-ALL as decimal   no-undo .
     1738   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1739   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1740   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1741   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1742   define buffer buf_price-all              for ub.price-all  .
     1743   define buffer buf_goods                  for ub.goods      .
     1744   define buffer buf_global-state           for ub.global-state  .
     1745   define buffer buf_buyer-group            for ub.buyer-group  .
     1746   define buffer buf_turnover-group         for ub.turnover-group  .
     1747   define buffer buf_main-code              for ub.bar-code  .
     1748   define buffer buf_bar-code               for ub.bar-code  .
     1749   define buffer buf_pay-type               for ub.pay-type  .
     1750   define buffer buf_cash-pay               for ub.cash-pay  .
     1751   define variable to-day          as date      no-undo .
     1752   define variable v-base-rate0    as decimal   no-undo .
     1753   define variable v-base-scale0   as decimal   no-undo .
     1754   define variable v-exch-rate0    as decimal   no-undo .
     1755   define variable v-exch-scale0   as decimal   no-undo .
     1756   define variable v-base-rate     as decimal   no-undo .
     1757   define variable v-base-scale    as decimal   no-undo .
     1758   define variable v-exch-rate     as decimal   no-undo .
     1759   define variable v-exch-scale    as decimal   no-undo .
     1760   define variable v-host-code     as integer   no-undo .
     1761   define variable v-curr-abbr     as character no-undo .
     1762   define variable v-grp-name      as character no-undo .
     1763   define variable v-date-1        as date      no-undo .
     1764   define variable v-date-2        as date      no-undo .
     1765   define variable v-interv        as character no-undo .
     1766   define variable v-pay-name      as character no-undo .
     1767   define variable v-cli-oborot    as decimal   no-undo .
     1768   define variable v-trn-pay-code  as integer   no-undo .
     1769   define variable v-cash-pay-curr as integer   no-undo .
     1770   define variable v-cash-pay-code as integer   no-undo .
     1771   do
     1772   on error undo, return error return-value
     1773   :
     1774   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1775   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1776   if p-fact-order = ? then do:
     1777     run fact-order-mpl (
     1778         input   today       ,
     1779         input   p-obj-type  ,
     1780         input   p-obj-code  ,
     1781         output  p-fact-order ).
     1782   end.
     1783   if p-vid-pay <> "" then do:
     1784      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1785      if available buf_pay-type
     1786         then v-trn-pay-code = buf_pay-type.obj-code.
     1787         else v-trn-pay-code =  0.
     1788   end.
     1789   else v-trn-pay-code = 0 .
     1790   if p-cash-pay-type <> "" then do:
     1791      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1792      if available buf_pay-type
     1793         then
     1794           assign
     1795             v-cash-pay-curr = buf_cash-pay.curr-code
     1796             v-cash-pay-code = buf_cash-pay.cdpay-code
     1797           .
     1798         else
     1799           assign
     1800             v-cash-pay-curr = 0
     1801             v-cash-pay-code = 0
     1802             .
     1803   end.
     1804   else
     1805     assign
     1806       v-cash-pay-curr = 0
     1807       v-cash-pay-code = 0
     1808       .
     1809   for each tt_price-all  : delete tt_price-all . end.
     1810   assign
     1811     p-plt-id             = ?
     1812     p-plt-db-num         = ?
     1813     p-pdf-id             = ?
     1814     p-pdf-db-num         = ?
     1815     p-sale-price-base    = ?
     1816     p-sale-price-rubl    = ?
     1817     v-cli-oborot         = 0
     1818   .
     1819   find first buf_global-state no-lock no-error .
     1820   if not available buf_global-state then do:
     1821      message
     1822        "Не заданы параметры ценообразования!"
     1823        view-as alert-box error
     1824      .
     1825      return error return-value .
     1826   end.
     1827   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1828   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1829     (input  p-obj-type
     1830     ,input  p-obj-code
     1831     ,output to-day
     1832     )  .
     1833   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1834   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1835     (input  p-obj-type
     1836     ,input  p-obj-code
     1837     ,output v-host-code
     1838     )  .
     1839   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1841     (input  v-host-code
     1842     ,input  to-day
     1843     ,output v-base-rate0
     1844     ,output v-base-scale0
     1845     )  .
     1846     v-cli-oborot-ALL  = 0 .
     1847     for each buf_turnover-buyer-main no-lock  where
     1848              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1849              buf_turnover-buyer-main.cli-code = p-cli-code
     1850              :
     1851              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1852     end.
     1853   for each buf_price-all no-lock where
     1854            buf_price-all.obj-type = p-obj-type and
     1855            buf_price-all.obj-code = p-obj-code and
     1856            buf_price-all.gds-code = buf_goods.gds-code and
     1857            buf_price-all.status_  = 'акт':U  and
     1858          ( p-only-b-code = false   or
     1859          ( buf_price-all.b-code = p-main-b-code or
     1860            buf_price-all.b-code = p-b-code))    and
     1861           ( p-only-b-code = true  or
     1862             buf_price-all.b-code = p-b-code)
     1863             and
     1864             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1865           ( buf_price-all.fact-order-sys-to = ? or
     1866             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1867           :
     1868            v-interv   = "" .
     1869            v-grp-name = "" .
     1870            v-pay-name = "" .
     1871            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1872            if buf_price-all.bgr-id > 0 then do:
     1873               find first buf_buyer-group no-lock where
     1874                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1875                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1876               if available buf_buyer-group then do:
     1877                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1878                  find first buf_buyer-in-buyer-group no-lock where
     1879                             buf_buyer-in-buyer-group.stts         = 0 and
     1880                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1881                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1882                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1883                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1884                             no-error .
     1885                             if not available buf_buyer-in-buyer-group then do:
     1886                                v-grp-name = "".
     1887                                next.
     1888                             end.
     1889                             v-grp-name = buf_buyer-group.name .
     1890                  end.
     1891               end.
     1892               else do:
     1893                    v-grp-name = "".
     1894                    next.
     1895               end.
     1896            end.
     1897            if buf_price-all.tog-id > 0 then do:
     1898               find first buf_turnover-group no-lock where
     1899                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1900                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1901               if available buf_turnover-group then do:
     1902                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1903                     v-cli-oborot = v-cli-oborot-all  .
     1904                     find first buf1_tnv-in-turnover-group no-lock where
     1905                                buf1_tnv-in-turnover-group.stts       =  0     and
     1906                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1907                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1908                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1909                     find first buf2_tnv-in-turnover-group no-lock where
     1910                                buf2_tnv-in-turnover-group.stts       =  0     and
     1911                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1912                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1913                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1914                     if not (available buf1_tnv-in-turnover-group and
     1915                             available buf2_tnv-in-turnover-group ) then do:
     1916                             v-grp-name = "".
     1917                             next .
     1918                     end.
     1919                     v-grp-name = buf_turnover-group.name.
     1920                  end.
     1921               end.
     1922               else do:
     1923                    v-grp-name = "".
     1924                    next.
     1925               end.
     1926            end.
     1927            if buf_price-all.plt-fix-cource-crc-base = true then
     1928               assign
     1929                 v-base-rate  = buf_price-all.pdf-base-rate
     1930                 v-base-scale = buf_price-all.pdf-base-scale
     1931               .
     1932               else
     1933               assign
     1934                 v-base-rate  = v-base-rate0
     1935                 v-base-scale = v-base-scale0
     1936               .
     1937            if buf_price-all.plt-fix-cource-crc-doc = true then
     1938               assign
     1939                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1940                 v-exch-scale = buf_price-all.pdf-exch-scale
     1941               .
     1942               else do:
     1943   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1945     (input  buf_price-all.curr-code
     1946     ,input  to-day
     1947     ,output v-exch-rate0
     1948     ,output v-exch-scale0
     1949     ,output v-curr-abbr
     1950     )  .
     1951               assign
     1952                 v-exch-rate  = v-exch-rate0
     1953                 v-exch-scale = v-exch-scale0
     1954                 .
     1955              end.
     1956              v-date-1 = date ( "" )  .
     1957              if buf_price-all.fact-order-sys-from > 0 then do:
     1958                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1959                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1960                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1961              end.
     1962              v-date-2 =  date ( "" )  .
     1963              if buf_price-all.fact-order-sys-to > 0 then do:
     1964                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1965                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1966                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1967              end.
     1968              if buf_price-all.qnty-from <> ? then do :
     1969                 if not (
     1970                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1971                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1972                 ) then do:
     1973                        v-interv = "".
     1974                        next.
     1975                 end.
     1976                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1977              end.
     1978              if buf_price-all.sum-from <> ? then do :
     1979                 if not (
     1980                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1981                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1982                 ) then do:
     1983                    v-interv = "".
     1984                    next.
     1985                 end.
     1986                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1987              end.
     1988              if buf_price-all.turnover-from <> ? then do :
     1989                 if not (
     1990                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1991                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1992                 ) then do:
     1993                    v-interv = "".
     1994                    next.
     1995                 end.
     1996                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1997              end.
     1998              if buf_price-all.use-pay-type = 1 then do :
     1999                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     2000                    v-pay-name = "" .
     2001                    next.
     2002                  end.
     2003                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     2004              end.
     2005              if buf_price-all.use-cash-pay = 1 then do :
     2006                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     2007                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     2008                   v-pay-name = "" .
     2009                   next.
     2010                 end.
     2011                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     2012              end.
     2013             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2014             create tt_price-all .
     2015             buffer-copy buf_price-all to tt_price-all
     2016             assign
     2017               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     2018               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     2019               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     2020               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     2021               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     2022               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     2023               tt_price-all.price-sale     = buf_price-all.price-sale
     2024               tt_price-all.road-tax       = buf_price-all.road-tax
     2025               tt_price-all.excise         = buf_price-all.excise
     2026               tt_price-all.pdf-exch-rate   = v-exch-rate
     2027               tt_price-all.pdf-exch-scale  = v-exch-scale
     2028               tt_price-all.pdf-base-rate   = v-base-rate
     2029               tt_price-all.pdf-base-scale  = v-base-scale
     2030               tt_price-all.grp-name        = v-grp-name
     2031               tt_price-all.date-1          = v-date-1
     2032               tt_price-all.shift-1         = buf_price-all.start-shift-num
     2033               tt_price-all.time-1          = buf_price-all.start-sys-time
     2034               tt_price-all.date-2          = v-date-2
     2035               tt_price-all.shift-2         = buf_price-all.end-shift-num
     2036               tt_price-all.time-2          = buf_price-all.end-sys-time
     2037               tt_price-all.interv-name     = v-interv
     2038               tt_price-all.pay-name        = v-pay-name
     2039               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     2040             .
     2041   end.
     2042   define variable vt-plt-id as integer   no-undo .
     2043   define variable vt-plt-db as integer   no-undo .
     2044   define variable vt-pdf-id as integer   no-undo .
     2045   define variable vt-pdf-db as integer   no-undo .
     2046   define buffer neos_price-all for tt_price-all  .
     2047   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     2048       if available tt_price-all then do:
     2049        assign
     2050          vt-plt-id = tt_price-all.plt-id
     2051          vt-plt-db = tt_price-all.plt-db-num
     2052          vt-pdf-id = tt_price-all.pdf-id
     2053          vt-pdf-db = tt_price-all.pdf-db
     2054        .
     2055        if tt_price-all.b-code = p-b-code then do:
     2056             assign
     2057               p-plt-id           = tt_price-all.plt-id
     2058               p-plt-db-num       = tt_price-all.plt-db-num
     2059               p-pdf-id           = tt_price-all.pdf-id
     2060               p-pdf-db-num       = tt_price-all.pdf-db
     2061               p-sale-price-base  = tt_price-all.price-sale-base
     2062               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2063               p-road-tax-base    = tt_price-all.road-tax-base
     2064               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2065               p-excise-base      = tt_price-all.excise-base
     2066               p-excise-rubl      = tt_price-all.excise-rubl
     2067               .
     2068        end.
     2069        else do:
     2070          find first neos_price-all where
     2071                     neos_price-all.b-code     = p-b-code  and
     2072                     neos_price-all.plt-id     = vt-plt-id and
     2073                     neos_price-all.plt-db-num = vt-plt-db and
     2074                     neos_price-all.pdf-id     = vt-pdf-id and
     2075                     neos_price-all.pdf-db     = vt-pdf-db
     2076                     use-index pi no-error .
     2077            if available neos_price-all then do:
     2078             assign
     2079               p-plt-id           = tt_price-all.plt-id
     2080               p-plt-db-num       = tt_price-all.plt-db-num
     2081               p-pdf-id           = tt_price-all.pdf-id
     2082               p-pdf-db-num       = tt_price-all.pdf-db
     2083               p-sale-price-base  = neos_price-all.price-sale-base
     2084               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     2085               p-road-tax-base    = neos_price-all.road-tax-base
     2086               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     2087               p-excise-base      = neos_price-all.excise-base
     2088               p-excise-rubl      = neos_price-all.excise-rubl
     2089               .
     2090            end.
     2091            else do:
     2092                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2093                 if error-status :error    then do:
     2094                   message "Не найден бар-код" p-b-code view-as alert-box error .
     2095                   return error return-value .
     2096                 end.
     2097             assign
     2098               p-plt-id           = tt_price-all.plt-id
     2099               p-plt-db-num       = tt_price-all.plt-db-num
     2100               p-pdf-id           = tt_price-all.pdf-id
     2101               p-pdf-db-num       = tt_price-all.pdf-db
     2102               p-sale-price-base  = tt_price-all.price-sale-base
     2103               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2104               p-road-tax-base    = tt_price-all.road-tax-base
     2105               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2106               p-excise-base      = tt_price-all.excise-base
     2107               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     2108               .
     2109            end.
     2110        end.
     2111     end.
     2112   end.
     2113   end procedure.
     2114   procedure mpl-tpl-auto :
     2115   define input  parameter p-b-code     as integer   no-undo .
     2116   define input  parameter p-obj-type   as character no-undo .
     2117   define input  parameter p-obj-code   as integer   no-undo .
     2118   define input  parameter p-plt-id     as integer   no-undo .
     2119   define input  parameter p-plt-db-num as integer   no-undo .
     2120   define input  parameter p-fact-order as decimal   no-undo .
     2121   define output parameter p-sale-price as decimal   no-undo .
     2122   define output parameter p-pdf-id     as integer   no-undo .
     2123   define output parameter p-pdf-db-num as integer   no-undo .
     2124     do
     2125     on error undo, return error return-value
     2126     :
     2127   if p-fact-order = ? then do:
     2128     run fact-order-mpl (
     2129         input   today       ,
     2130         input   p-obj-type  ,
     2131         input   p-obj-code  ,
     2132         output  p-fact-order ) .
     2133   end.
     2134   assign
     2135     p-pdf-id      = ?
     2136     p-pdf-db-num  = ?
     2137     p-sale-price  = ?
     2138   .
     2139   define buffer buf_bar-code for ub.bar-code  .
     2140   define buffer buf_goods for ub.goods  .
     2141   find first buf_bar-code no-lock where
     2142              buf_bar-code.b-code = p-b-code
     2143              no-error .
     2144   if error-status :error then return error return-value .
     2145   find first buf_goods no-lock where
     2146              buf_goods.gds-code = buf_bar-code.gds-code
     2147              no-error .
     2148   if error-status :error then return error return-value .
     2149   define variable v-main-b-code as integer   no-undo .
     2150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2151     (input  buf_goods.gds-code
     2152     ,input  ?
     2153     ,output v-main-b-code
     2154     )  .
     2155   define buffer buf_price-all for ub.price-all  .
     2156   for each tt_price-all : delete tt_price-all. end.
     2157       for each buf_price-all no-lock where
     2158               buf_price-all.plt-id     = p-plt-id                 and
     2159               buf_price-all.plt-db-num = p-plt-db-num             and
     2160               buf_price-all.obj-type   = p-obj-type               and
     2161               buf_price-all.obj-code   = p-obj-code               and
     2162               buf_price-all.gds-code   = buf_goods.gds-code       and
     2163             ( buf_price-all.b-code = v-main-b-code or
     2164               buf_price-all.b-code = p-b-code)    and
     2165               buf_price-all.status_    = 'акт':U         and
     2166               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2167             ( buf_price-all.fact-order-sys-to = ? or
     2168               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2169               :
     2170                 create tt_price-all .
     2171                 buffer-copy buf_price-all to tt_price-all
     2172                 assign
     2173                   tt_price-all.price-sale  = buf_price-all.price-sale
     2174                 .
     2175       end.
     2176   define variable vt-plt-id as integer   no-undo .
     2177   define variable vt-plt-db as integer   no-undo .
     2178   define variable vt-pdf-id as integer   no-undo .
     2179   define variable vt-pdf-db as integer   no-undo .
     2180   define buffer neos_price-all for tt_price-all  .
     2181   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2182       if available tt_price-all then do:
     2183        assign
     2184          vt-plt-id = tt_price-all.plt-id
     2185          vt-plt-db = tt_price-all.plt-db-num
     2186          vt-pdf-id = tt_price-all.pdf-id
     2187          vt-pdf-db = tt_price-all.pdf-db
     2188        .
     2189        if tt_price-all.b-code = p-b-code then do:
     2190             assign
     2191               p-plt-id           = tt_price-all.plt-id
     2192               p-plt-db-num       = tt_price-all.plt-db-num
     2193               p-pdf-id           = tt_price-all.pdf-id
     2194               p-pdf-db-num       = tt_price-all.pdf-db
     2195               p-sale-price       = tt_price-all.price-sale
     2196               .
     2197        end.
     2198        else do:
     2199          find first neos_price-all where
     2200                     neos_price-all.b-code     = p-b-code  and
     2201                     neos_price-all.plt-id     = vt-plt-id and
     2202                     neos_price-all.plt-db-num = vt-plt-db and
     2203                     neos_price-all.pdf-id     = vt-pdf-id and
     2204                     neos_price-all.pdf-db     = vt-pdf-db
     2205                     use-index pi no-error .
     2206            if available neos_price-all then do:
     2207             assign
     2208               p-plt-id           = tt_price-all.plt-id
     2209               p-plt-db-num       = tt_price-all.plt-db-num
     2210               p-pdf-id           = tt_price-all.pdf-id
     2211               p-pdf-db-num       = tt_price-all.pdf-db
     2212               p-sale-price       = neos_price-all.price-sale
     2213               .
     2214            end.
     2215            else do:
     2216           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2217           if error-status :error    then do:
     2218              message "Не найден бар-код" p-b-code view-as alert-box error .
     2219              return error return-value .
     2220           end.
     2221             assign
     2222               p-plt-id           = tt_price-all.plt-id
     2223               p-plt-db-num       = tt_price-all.plt-db-num
     2224               p-pdf-id           = tt_price-all.pdf-id
     2225               p-pdf-db-num       = tt_price-all.pdf-db
     2226               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2227               .
     2228            end.
     2229        end.
     2230     end.
     2231     end.
     2232   end procedure.
     2233   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2235   procedure wthcattr-sprcli :
     2236   define input parameter parparentproc  as widget-handle no-undo.
     2237   define input parameter p-mode  as character no-undo.
     2238   define input-output parameter p-value as character no-undo .
     2239   define output parameter p-setted as logical no-undo .
     2240     DEFINE VARIABLE v-value as character no-undo .
     2241     define variable v-cli-type as character no-undo .
     2242     define variable v-cli-code as integer no-undo .
     2243     define buffer buf_clients   for ub.clients.
     2244     define variable v_rid as character no-undo.
     2245     define variable ref-rec as recid no-undo .
     2246     do
     2247     on error undo, return error
     2248     :
     2249         v-value = p-value.
     2250      if p-value <> '':U then do:
     2251       assign
     2252       v-cli-type = substring(p-value, 1, 3)
     2253       v-cli-code = integer(substring(p-value, 4))
     2254       no-error.
     2255       if error-status:error then do:
     2256         assign
     2257         v-cli-type = '':U
     2258         v-cli-code = 0
     2259         .
     2260       end.
     2261      end.
     2262      FIND FIRST buf_clients NO-LOCK WHERE
     2263               buf_clients.obj-type = v-cli-type AND
     2264               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2265      IF available(buf_clients) then do:
     2266       run ref/cli-all.w (
     2267                   input parparentproc
     2268                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2269                  ,input v-cli-type
     2270                  ,input 'все':U
     2271                  ,input 'все':U
     2272                  ,input RECID( buf_clients )
     2273                  ,input ",,,,,,NO"
     2274                  ,input ?
     2275                  ,OUTPUT v_rid ).
     2276     END.
     2277     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2278       run ref/cli-all.w (
     2279                    input parparentproc
     2280                   ,INPUT "b-sel":U
     2281                  ,input  v-cli-type
     2282                  ,input 'все':U
     2283                  ,input 'текущие':U
     2284                  ,input ?
     2285                  ,input ",,,,,,NO"
     2286                  ,input ?
     2287                  ,OUTPUT v_rid ).
     2288     END.
     2289     else do:
     2290       message
     2291       if p-value = "":U then 'Атрибут не задан!'
     2292       else substitute('Не найден клиент &1',p-value)
     2293       view-as alert-box warning.
     2294     end.
     2295     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2296       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2297       IF ERROR-STATUS:ERROR THEN DO:
     2298           RETURN NO-APPLY.
     2299       END.
     2300       FIND FIRST buf_clients NO-LOCK WHERE
     2301                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2302       IF AVAIL buf_clients THEN DO:
     2303         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2304       end.
     2305     end.
     2306     if v-value <> p-value then do:
     2307       p-value = v-value.
     2308       p-setted = yes.
     2309     end.
     2310     end.
     2311   end procedure.
     2312     define new global shared variable g#wthcalib as handle no-undo.
     2313   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     2314   define variable v-tth as handle no-undo .
     2315   assign
     2316   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2317   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     2318   Procedure wth-doc-close:
     2319       define input parameter p-rec        as recid     no-undo .
     2320       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     2325       if not available cur-wth-parts then return error substitute("Не найдена партия").
     2326       CASE cur-wth-parts.ext-doc-type:
     2327           WHEN 'ie':U or when 'rf':U or when 'ff':U
     2328           OR WHEN 'fj':U
     2329           THEN DO:
     2330              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     2331           END.
     2332           WHEN 'ee':U THEN DO:
     2333               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2334           END.
     2335           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     2336             OR WHEN 'ip':U OR WHEN 'pc':U
     2337             OR WHEN 'pj':U
     2338              THEN DO:
     2339               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2340           END.
     2341           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     2342             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     2343           end.
     2344           when 'ep':U or when 'ef':U
     2345           OR WHEN 'oj':U or when 'jj':U
     2346           then .
     2347           when 'xc':U then do:
     2348             if cur-wth-parts.type = 'при':U then
     2349                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     2350             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     2351           end.
     2352           OTHERWISE DO:
     2353               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     2354                                    , cur-wth-parts.ext-doc-type
     2355                                       ).
     2356           END.
     2357       END CASE.
     2358       RELEASE cur-wth-parts.
     2359       END.
     2360   END.
     2361   PROCEDURE wth-parts-close:
     2362       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2363       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2364       define variable v-rec as recid.
     2365       if bfrom_wth-parts.stts  = 1 then return.
     2366          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     2367                     INPUT     bfrom_wth-parts.obj-type,
     2368                     INPUT     bfrom_wth-parts.obj-code,
     2369                     INPUT     bfrom_wth-parts.w-p-code,
     2370                     INPUT     bfrom_wth-parts.wth-code,
     2371                     INPUT     bfrom_wth-parts.par-code,
     2372                     INPUT     bfrom_wth-parts.in-code ,
     2373                     INPUT     p-zone,
     2374                     INPUT     bfrom_wth-parts.ser-code,
     2375                     INPUT     bfrom_wth-parts.db-num  ,
     2376                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2377                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2378                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2379                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     2380                     INPUT     bfrom_wth-parts.host-code     ,
     2381                     INPUT     bfrom_wth-parts.contract-code               ,
     2382                     INPUT     bfrom_wth-parts.price-rubl    ,
     2383                     INPUT     bfrom_wth-parts.price-base    ,
     2384                     INPUT     bfrom_wth-parts.supp-type,
     2385                     INPUT     bfrom_wth-parts.supp-code,
     2386                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2387                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2388                     INPUT     bfrom_wth-parts.ext-doc-type,
     2389                     INPUT     bfrom_wth-parts.gds-code,
     2390                     INPUT     bfrom_wth-parts.stts               ,
     2391                     INPUT     bfrom_wth-parts.beg-dt        ,
     2392                     INPUT     bfrom_wth-parts.end-dt        ,
     2393                     INPUT     bfrom_wth-parts.vat-pc        ,
     2394                     INPUT     bfrom_wth-parts.cli-code,
     2395                     INPUT     bfrom_wth-parts.cli-type,
     2396                     INPUT     bfrom_wth-parts.out-obj-code,
     2397                     INPUT     bfrom_wth-parts.out-obj-type,
     2398                     INPUT     bfrom_wth-parts.sale-obj-code,
     2399                     INPUT     bfrom_wth-parts.sale-obj-type,
     2400                     INPUT     bfrom_wth-parts.out-code ,
     2401                     INPUT  yes,
     2402                     INPUT     '':U ,
     2403                     INPUT-OUTPUT v-rec
     2404                     ) no-error.
     2405       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2406   END.
     2407   Procedure wth-doc-razrez:
     2408       define input parameter p-rec as recid NO-UNDO.
     2409       define input parameter p-doc-del AS log NO-UNDO.
     2410       define variable v-mess AS CHAR NO-UNDO.
     2411       define variable p-silent AS LOG INIT NO NO-UNDO.
     2412       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     2413       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2414       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     2415     do
     2416     on error undo, return error return-value
     2417     :
     2418       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     2419                                 EXCLUSIVE-LOCK .
     2420       IF AVAILABLE cur-wth-parts THEN DO:
     2421           CASE cur-wth-parts.ext-doc-type:
     2422               WHEN 'ie':U or when 'ip':U or when 'rp':U
     2423               or when 'ff':U or when 'rf':U
     2424               or when 'fj':U or when 'pj':U
     2425               THEN DO:
     2426                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     2427               END.
     2428               WHEN 'ee':U or when 'ef':U or when 'jj':U
     2429               THEN DO:
     2430                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     2431               END.
     2432               WHEN 'ep':U or when 'oj':U THEN DO:
     2433                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     2434               END.
     2435               WHEN 'pc':U THEN DO:
     2436                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2437               END.
     2438               WHEN 'dp':U THEN DO:
     2439                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     2440               END.
     2441               WHEN 'df':U THEN DO:
     2442                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     2443               END.
     2444               WHEN 'dc':U THEN DO:
     2445                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     2446               END.
     2447               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     2448                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     2449               END.
     2450               when 'xc':U then do:
     2451                 if cur-wth-parts.type = 'при':U then
     2452                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     2453                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     2454               end.
     2455               OTHERWISE DO:
     2456                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     2457                                        , cur-wth-parts.ext-doc-type
     2458                                        , error-status:get-message(1)
     2459                                        , return-value
     2460                                        ).
     2461               END.
     2462           END CASE.
     2463       END.
     2464     END.
     2465   END.
     2466   PROCEDURE wth-parts-raz:
     2467       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     2468       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     2469       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     2470       define variable v-mes as char no-undo.
     2471       define variable v-rec as recid no-undo.
     2472       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     2473     do
     2474     on error undo, return error return-value
     2475     :
     2476       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     2477                                      ,bfrom_wth-parts.ser-code
     2478                                      ,bfrom_wth-parts.db-num
     2479                                      ,bfrom_wth-parts.doc-rangeFrom
     2480                                      ,bfrom_wth-parts.doc-rangeTo).
     2481       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     2482           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     2483                                , error-status:get-message(1)
     2484                                , bfrom_wth-parts.out-code
     2485                                , return-value
     2486                                ,chr(10)
     2487                                ,v-mes
     2488                                ).
     2489       END.
     2490       v-rec = recid(bfrom_wth-parts).
     2491       CASE bfrom_wth-parts.ext-doc-type:
     2492           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     2493               delete bfrom_wth-parts NO-ERROR.
     2494               if error-status:error then do:
     2495                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2496                                      , error-status:get-message(1)
     2497                                      , chr(10)
     2498                                      , return-value
     2499                                      ,v-mes
     2500                                      ).
     2501               END.
     2502           END.
     2503           when 'rp':U or when 'rf':U then do:
     2504             if p-doc-del then do:
     2505               delete bfrom_wth-parts NO-ERROR.
     2506               if error-status:error then do:
     2507                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2508                                      , error-status:get-message(1)
     2509                                      , chr(10)
     2510                                      , return-value
     2511                                      ,v-mes
     2512                                      ).
     2513               END.
     2514             end.
     2515             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     2516           end.
     2517           when 'ip':U or when 'ff':U then do:
     2518             if p-doc-del then do:
     2519               delete bfrom_wth-parts NO-ERROR.
     2520               if error-status:error then do:
     2521                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     2522                                      , error-status:get-message(1)
     2523                                      , chr(10)
     2524                                      , return-value
     2525                                      ,v-mes
     2526                                      ).
     2527               END.
     2528             end.
     2529             else do:
     2530               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2531                     INPUT     bfrom_wth-parts.obj-type,
     2532                     INPUT     bfrom_wth-parts.obj-code,
     2533                     INPUT     bfrom_wth-parts.w-p-code,
     2534                     INPUT     bfrom_wth-parts.wth-code,
     2535                     INPUT     bfrom_wth-parts.par-code,
     2536                     INPUT     bfrom_wth-parts.in-code ,
     2537                     INPUT     bfrom_wth-parts.out-code,
     2538                     INPUT     bfrom_wth-parts.ser-code,
     2539                     INPUT     bfrom_wth-parts.db-num  ,
     2540                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2541                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2542                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     2543                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     2544                     INPUT     bfrom_wth-parts.host-code     ,
     2545                     INPUT     bfrom_wth-parts.contract-code ,
     2546                     INPUT     bfrom_wth-parts.price-rubl    ,
     2547                     INPUT     bfrom_wth-parts.price-base    ,
     2548                     INPUT     bfrom_wth-parts.supp-type,
     2549                     INPUT     bfrom_wth-parts.supp-code,
     2550                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2551                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2552                     INPUT     bfrom_wth-parts.ext-doc-type,
     2553                     INPUT     bfrom_wth-parts.gds-code,
     2554                     INPUT     1            ,
     2555                     INPUT     bfrom_wth-parts.beg-dt        ,
     2556                     INPUT     bfrom_wth-parts.end-dt        ,
     2557                     INPUT     bfrom_wth-parts.vat-pc        ,
     2558                     INPUT     bfrom_wth-parts.cli-code,
     2559                     INPUT     bfrom_wth-parts.cli-type,
     2560                     INPUT     bfrom_wth-parts.out-obj-code,
     2561                     INPUT     bfrom_wth-parts.out-obj-type,
     2562                     INPUT     bfrom_wth-parts.sale-obj-code,
     2563                     INPUT     bfrom_wth-parts.sale-obj-type,
     2564                     INPUT     bfrom_wth-parts.doc-code ,
     2565                     INPUT  yes,
     2566                     INPUT     bfrom_wth-parts.type ,
     2567                     INPUT-OUTPUT v-rec
     2568                     ) no-error.
     2569                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2570             end.
     2571           end.
     2572           OTHERWISE DO:
     2573            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2574                     INPUT     bfrom_wth-parts.obj-type,
     2575                     INPUT     bfrom_wth-parts.obj-code,
     2576                     INPUT     bfrom_wth-parts.w-p-code,
     2577                     INPUT     bfrom_wth-parts.wth-code,
     2578                     INPUT     bfrom_wth-parts.par-code,
     2579                     INPUT     bfrom_wth-parts.in-code ,
     2580                     INPUT     p-zone,
     2581                     INPUT     bfrom_wth-parts.ser-code,
     2582                     INPUT     bfrom_wth-parts.db-num  ,
     2583                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2584                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2585                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2586                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2587                     INPUT     bfrom_wth-parts.host-code     ,
     2588                     INPUT     bfrom_wth-parts.contract-code ,
     2589                     INPUT     bfrom_wth-parts.price-rubl    ,
     2590                     INPUT     bfrom_wth-parts.price-base    ,
     2591                     INPUT     bfrom_wth-parts.supp-type,
     2592                     INPUT     bfrom_wth-parts.supp-code,
     2593                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2594                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2595                     INPUT     bfrom_wth-parts.ext-doc-type,
     2596                     INPUT     bfrom_wth-parts.gds-code,
     2597                     INPUT     bfrom_wth-parts.stts             ,
     2598                     INPUT     bfrom_wth-parts.beg-dt        ,
     2599                     INPUT     bfrom_wth-parts.end-dt        ,
     2600                     INPUT     bfrom_wth-parts.vat-pc        ,
     2601                     INPUT     bfrom_wth-parts.cli-code,
     2602                     INPUT     bfrom_wth-parts.cli-type,
     2603                     INPUT     bfrom_wth-parts.out-obj-code,
     2604                     INPUT     bfrom_wth-parts.out-obj-type,
     2605                     INPUT     bfrom_wth-parts.sale-obj-code,
     2606                     INPUT     bfrom_wth-parts.sale-obj-type,
     2607                     INPUT     bfrom_wth-parts.doc-code ,
     2608                     INPUT  yes,
     2609                     INPUT      "":U ,
     2610                     INPUT-OUTPUT v-rec
     2611                     ) no-error.
     2612       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2613           END.
     2614       END CASE.
     2615     END.
     2616   END.
     2617   procedure wth-parts-rezerv:
     2618       define input parameter        p-param            as logical no-undo.
     2619       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2620       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2621       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2622       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2623       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2624       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2625       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2626       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2627       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2628       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2629       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2630       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2631       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2632       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2633       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2634       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2635       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2636       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2637       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2638       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2639       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2640       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2641       define input-output parameter p-rec        as recid     no-undo .
     2642     define buffer bfrom_wth-parts   for ub.wth-parts.
     2643     define buffer bufr_wth-doc      for ub.wth-doc.
     2644     define variable v-rec    as recid        no-undo.
     2645     define variable v-recDop as recid        no-undo.
     2646     define variable v-zone   as character    no-undo.
     2647     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2648     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2649     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2650     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2651     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2652     define variable v-mpl-date         as date      no-undo.
     2653     empty temp-table tt-wthlib-parts.
     2654   main-block:
     2655   do  transaction
     2656   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2657   on stop   undo main-block, return error
     2658   on endkey undo main-block, return error
     2659   :
     2660   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2661   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2662     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2663           then do:
     2664        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2665                     INPUT  p-obj-type,
     2666                     INPUT  p-obj-code,
     2667                     INPUT  p-w-p-code,
     2668                     INPUT  p-wth-code,
     2669                     INPUT  p-par-code,
     2670                     INPUT  p-in-code,
     2671                     INPUT  p-doc-code,
     2672                     INPUT  p-ser-code,
     2673                     INPUT  p-db-num  ,
     2674                     INPUT  p-Fact-RangeFrom ,
     2675                     INPUT  p-fact-rangeTo  ,
     2676                     INPUT  p-Fact-RangeFrom ,
     2677                     INPUT  p-fact-rangeTo ,
     2678                     INPUT  p-host-code     ,
     2679                     INPUT  0   ,
     2680                     INPUT  p-price-rubl    ,
     2681                     INPUT  p-price-base    ,
     2682                     INPUT  '':U,
     2683                     INPUT  0,
     2684                     INPUT  p-obj-type      ,
     2685                     INPUT  p-obj-code      ,
     2686                     INPUT  p-ext-doc-type,
     2687                     INPUT  p-gds-code,
     2688                     INPUT  0           ,
     2689                     INPUT  p-beg-dt        ,
     2690                     INPUT  p-end-dt        ,
     2691                     INPUT  p-vat-pc      ,
     2692                     INPUT  0,
     2693                     INPUT  '':U,
     2694                     INPUT  0,
     2695                     INPUT  '':U,
     2696                     INPUT  0,
     2697                     INPUT  '':U,
     2698                     INPUT  p-doc-code,
     2699                     INPUT  yes,
     2700                     INPUT p-type,
     2701                     INPUT-OUTPUT p-rec
     2702                     ) no-error.
     2703                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2704     end.
     2705     else do:
     2706       if p-rec <> ? then do:
     2707         find first bfrom_wth-parts exclusive-lock where
     2708                   recid(bfrom_wth-parts) = p-rec no-error.
     2709         if  available bfrom_wth-parts
     2710           and bfrom_wth-parts.wth-code = p-wth-code
     2711           and bfrom_wth-parts.par-code = p-par-code
     2712           and bfrom_wth-parts.ser-code = p-ser-code
     2713           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2714         then.
     2715         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2716         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2717                                      ,bfrom_wth-parts.ser-code
     2718                                      ,bfrom_wth-parts.db-num
     2719                                      ,bfrom_wth-parts.doc-rangeFrom
     2720                                      ,bfrom_wth-parts.doc-rangeTo).
     2721         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2722         if available bfrom_wth-parts
     2723            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2724            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2725         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2726                                            ,chr(10)
     2727                                            ,bfrom_wth-parts.doc-rangeFrom
     2728                                            ,bfrom_wth-parts.doc-rangeTo
     2729                                            ,p-fact-rangeFrom
     2730                                            ,p-fact-rangeTo).
     2731       end.
     2732       else do:
     2733         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2734           for first bfrom_wth-parts no-lock where
     2735                                     bfrom_wth-parts.wth-code = p-wth-code
     2736                                 and bfrom_wth-parts.par-code = p-par-code
     2737                                 and bfrom_wth-parts.ser-code = p-ser-code
     2738                                 and bfrom_wth-parts.db-num = p-db-num
     2739                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2740                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2741                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2742                                 and bfrom_wth-parts.stts = 0
     2743                                 and bfrom_wth-parts.cli-code = p-cli-code
     2744                                 and bfrom_wth-parts.cli-type = p-cli-type
     2745                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2746                                 use-index  wth-idnt:
     2747                                 p-rec = recid(bfrom_wth-parts).
     2748            end.
     2749           If p-rec = ? and p-in-code > '' then do:
     2750              for first bfrom_wth-parts no-lock where
     2751                                     bfrom_wth-parts.wth-code = p-wth-code
     2752                                 and bfrom_wth-parts.par-code = p-par-code
     2753                                 and bfrom_wth-parts.ser-code = p-ser-code
     2754                                 and bfrom_wth-parts.db-num = p-db-num
     2755                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2756                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2757                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2758                                 and bfrom_wth-parts.stts = 0
     2759                                 and bfrom_wth-parts.cli-code = p-cli-code
     2760                                 and bfrom_wth-parts.cli-type = p-cli-type
     2761                                 use-index  wth-idnt:
     2762                                 p-rec = recid(bfrom_wth-parts).
     2763                 end.
     2764           end.
     2765                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2766                   recid(bfrom_wth-parts) = p-rec no-error.
     2767         end.
     2768         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2769           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2770                                 and bfrom_wth-parts.par-code = p-par-code
     2771                                 and bfrom_wth-parts.ser-code = p-ser-code
     2772                                 and bfrom_wth-parts.db-num = p-db-num
     2773                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2774                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2775                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2776                                 and bfrom_wth-parts.stts = 0
     2777                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2778                                 use-index wth-idnt:
     2779                                 p-rec = recid(bfrom_wth-parts).
     2780            end.
     2781           If p-rec = ? and p-in-code > '' then do:
     2782            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2783                                 and bfrom_wth-parts.par-code = p-par-code
     2784                                 and bfrom_wth-parts.ser-code = p-ser-code
     2785                                 and bfrom_wth-parts.db-num = p-db-num
     2786                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2787                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2788                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2789                                 and bfrom_wth-parts.stts = 0
     2790                                 :
     2791                                 p-rec = recid(bfrom_wth-parts).
     2792            end.
     2793           end.
     2794           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2795                   recid(bfrom_wth-parts) = p-rec no-error.
     2796         end.
     2797         else do:
     2798           CASE p-ext-doc-type:
     2799                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2800                   or when 'jj':U THEN DO:
     2801                       v-zone = 'free-zone':U.
     2802                   END.
     2803                   WHEN 'ep':U or when 'oj':U THEN DO:
     2804                       v-zone = 'put-zone':U.
     2805                   END.
     2806                   WHEN 'df':U THEN DO:
     2807                       v-zone = 'free-zone':U.
     2808                   END.
     2809                   WHEN 'dp':U  THEN DO:
     2810                       v-zone = 'put-zone':U.
     2811                   END.
     2812                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2813                       v-zone = 'cli-zone':U.
     2814                   END.
     2815                   OTHERWISE DO:
     2816                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2817                                            , p-ext-doc-type
     2818                                               ).
     2819                   END.
     2820           END CASE.
     2821           find first bfrom_wth-parts no-lock where
     2822                                     bfrom_wth-parts.wth-code = p-wth-code
     2823                                 and bfrom_wth-parts.obj-code = p-obj-code
     2824                                 and bfrom_wth-parts.obj-type = p-obj-type
     2825                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2826                                 and bfrom_wth-parts.par-code = p-par-code
     2827                                 and bfrom_wth-parts.ser-code = p-ser-code
     2828                                 and bfrom_wth-parts.db-num = p-db-num
     2829                                 and bfrom_wth-parts.out-code = v-zone
     2830                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2831                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2832                                 and bfrom_wth-parts.stts = 0
     2833                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2834                                 no-error.
     2835          If not available bfrom_wth-parts and p-in-code > '' then do:
     2836                  find first bfrom_wth-parts no-lock where
     2837                                     bfrom_wth-parts.wth-code = p-wth-code
     2838                                 and bfrom_wth-parts.obj-code = p-obj-code
     2839                                 and bfrom_wth-parts.obj-type = p-obj-type
     2840                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2841                                 and bfrom_wth-parts.par-code = p-par-code
     2842                                 and bfrom_wth-parts.ser-code = p-ser-code
     2843                                 and bfrom_wth-parts.db-num = p-db-num
     2844                                 and bfrom_wth-parts.out-code = v-zone
     2845                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2846                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2847                                 and bfrom_wth-parts.stts = 0
     2848                                 no-error.
     2849          end.
     2850         end.
     2851       end.
     2852       if not available bfrom_wth-parts then do:
     2853            if g#news then do:
     2854             return error 'forged':U.
     2855            end.
     2856            else
     2857             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2858                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2859                                           p-fact-rangeTo).
     2860       end.
     2861       p-rec = recid(bfrom_wth-parts).
     2862       find current bfrom_wth-parts exclusive-lock.
     2863       create tt-wthlib-parts.
     2864       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2865           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2866                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2867                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2868                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2869                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2870       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2871           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2872               RUN init_prtdate ( INPUT p-obj-type
     2873                                                 ,INPUT p-obj-code
     2874                                                 ,INPUT p-ser-code
     2875                                                 ,INPUT p-db-num
     2876                                                 ,INPUT bufr_wth-doc.doc-date
     2877                                                 ,OUTPUT v-beg-dt
     2878                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2879               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2880           END.
     2881           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2882             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2883                                ,bufr_wth-doc.doc-date
     2884                                , v-beg-dt
     2885                                , output v-mpl-date) no-error.
     2886               RUN INIT_prtprice (
     2887                             p-host-code
     2888                           , p-obj-type
     2889                           , p-obj-code
     2890                           , p-cli-type
     2891                           , p-cli-code
     2892                           , p-wth-code
     2893                           , p-gds-code
     2894                           , p-par-code
     2895                           , v-mpl-date
     2896                           , OUTPUT  v-vat-pc
     2897                           , OUTPUT  v-price-rubl
     2898                           , OUTPUT  v-price-base
     2899                   ) NO-ERROR.
     2900             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2901           END.
     2902       END.
     2903         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2904                     INPUT     p-obj-type,
     2905                     INPUT     p-obj-code,
     2906                     INPUT     p-w-p-code,
     2907                     INPUT     bfrom_wth-parts.wth-code,
     2908                     INPUT     bfrom_wth-parts.par-code,
     2909                     INPUT     bfrom_wth-parts.in-code ,
     2910                     INPUT     p-doc-code,
     2911                     INPUT     bfrom_wth-parts.ser-code,
     2912                     INPUT     bfrom_wth-parts.db-num  ,
     2913                     INPUT     p-Fact-RangeFrom ,
     2914                     INPUT     p-fact-rangeTo  ,
     2915                     INPUT     p-Fact-RangeFrom ,
     2916                     INPUT     p-fact-rangeTo ,
     2917                     INPUT     bfrom_wth-parts.host-code     ,
     2918                     INPUT     bfrom_wth-parts.contract-code               ,
     2919                     INPUT     v-price-rubl ,
     2920                     INPUT     v-price-base  ,
     2921                     INPUT     bfrom_wth-parts.supp-type,
     2922                     INPUT     bfrom_wth-parts.supp-code,
     2923                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2924                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2925                     INPUT     p-ext-doc-type,
     2926                     INPUT     bfrom_wth-parts.gds-code,
     2927                     INPUT     0              ,
     2928                     INPUT     v-beg-dt    ,
     2929                     INPUT     v-end-dt   ,
     2930                     INPUT     v-vat-pc    ,
     2931                     INPUT     bfrom_wth-parts.cli-code,
     2932                     INPUT     bfrom_wth-parts.cli-type,
     2933                     INPUT     bfrom_wth-parts.out-obj-code,
     2934                     INPUT     bfrom_wth-parts.out-obj-type,
     2935                     INPUT     bfrom_wth-parts.sale-obj-code,
     2936                     INPUT     bfrom_wth-parts.sale-obj-type,
     2937                     INPUT     bfrom_wth-parts.doc-code,
     2938                     INPUT     yes,
     2939                     INPUT     p-type,
     2940                     INPUT-OUTPUT p-rec
     2941                     ) no-error.
     2942       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2943       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2944       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2945                     INPUT     tt-wthlib-parts.obj-type,
     2946                     INPUT     tt-wthlib-parts.obj-code,
     2947                     INPUT     tt-wthlib-parts.w-p-code,
     2948                     INPUT     tt-wthlib-parts.wth-code,
     2949                     INPUT     tt-wthlib-parts.par-code,
     2950                     INPUT     tt-wthlib-parts.in-code ,
     2951                     INPUT     tt-wthlib-parts.out-code,
     2952                     INPUT     tt-wthlib-parts.ser-code,
     2953                     INPUT     tt-wthlib-parts.db-num  ,
     2954                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2955                     INPUT     p-fact-rangeFrom - 1  ,
     2956                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2957                     INPUT     p-fact-rangeFrom - 1,
     2958                     INPUT     tt-wthlib-parts.host-code     ,
     2959                     INPUT     tt-wthlib-parts.contract-code               ,
     2960                     INPUT     tt-wthlib-parts.price-rubl    ,
     2961                     INPUT     tt-wthlib-parts.price-base    ,
     2962                     INPUT     tt-wthlib-parts.supp-type,
     2963                     INPUT     tt-wthlib-parts.supp-code,
     2964                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2965                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2966                     INPUT     tt-wthlib-parts.ext-doc-type,
     2967                     INPUT     tt-wthlib-parts.gds-code,
     2968                     INPUT     tt-wthlib-parts.stts               ,
     2969                     INPUT     tt-wthlib-parts.beg-dt        ,
     2970                     INPUT     tt-wthlib-parts.end-dt        ,
     2971                     INPUT     tt-wthlib-parts.vat-pc        ,
     2972                     INPUT     tt-wthlib-parts.cli-code,
     2973                     INPUT     tt-wthlib-parts.cli-type,
     2974                     INPUT     tt-wthlib-parts.out-obj-code,
     2975                     INPUT     tt-wthlib-parts.out-obj-type,
     2976                     INPUT     tt-wthlib-parts.sale-obj-code,
     2977                     INPUT     tt-wthlib-parts.sale-obj-type,
     2978                     INPUT     tt-wthlib-parts.doc-code,
     2979                     INPUT  yes,
     2980                     INPUT    tt-wthlib-parts.type,
     2981                     INPUT-OUTPUT v-recDop
     2982                     ) no-error.
     2983       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2984       end.
     2985       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2986               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2987                     INPUT     tt-wthlib-parts.obj-type,
     2988                     INPUT     tt-wthlib-parts.obj-code,
     2989                     INPUT     tt-wthlib-parts.w-p-code,
     2990                     INPUT     tt-wthlib-parts.wth-code,
     2991                     INPUT     tt-wthlib-parts.par-code,
     2992                     INPUT     tt-wthlib-parts.in-code ,
     2993                     INPUT     tt-wthlib-parts.out-code,
     2994                     INPUT     tt-wthlib-parts.ser-code,
     2995                     INPUT     tt-wthlib-parts.db-num  ,
     2996                     INPUT     p-fact-rangeTo + 1 ,
     2997                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2998                     INPUT     p-fact-rangeTo + 1 ,
     2999                     INPUT     tt-wthlib-parts.fact-rangeTo,
     3000                     INPUT     tt-wthlib-parts.host-code     ,
     3001                     INPUT     tt-wthlib-parts.contract-code               ,
     3002                     INPUT     tt-wthlib-parts.price-rubl    ,
     3003                     INPUT     tt-wthlib-parts.price-base    ,
     3004                     INPUT     tt-wthlib-parts.supp-type,
     3005                     INPUT     tt-wthlib-parts.supp-code,
     3006                     INPUT     tt-wthlib-parts.in-obj-type      ,
     3007                     INPUT     tt-wthlib-parts.in-obj-code      ,
     3008                     INPUT     tt-wthlib-parts.ext-doc-type,
     3009                     INPUT     tt-wthlib-parts.gds-code,
     3010                     INPUT     tt-wthlib-parts.stts               ,
     3011                     INPUT     tt-wthlib-parts.beg-dt        ,
     3012                     INPUT     tt-wthlib-parts.end-dt        ,
     3013                     INPUT     tt-wthlib-parts.vat-pc        ,
     3014                     INPUT     tt-wthlib-parts.cli-code,
     3015                     INPUT     tt-wthlib-parts.cli-type,
     3016                     INPUT     tt-wthlib-parts.out-obj-code,
     3017                     INPUT     tt-wthlib-parts.out-obj-type,
     3018                     INPUT     tt-wthlib-parts.sale-obj-code,
     3019                     INPUT     tt-wthlib-parts.sale-obj-type,
     3020                     INPUT     tt-wthlib-parts.doc-code,
     3021                     INPUT     yes,
     3022                     INPUT     tt-wthlib-parts.type,
     3023                     INPUT-OUTPUT v-recDop
     3024                     ) no-error.
     3025         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3026       end.
     3027     end.
     3028   end.
     3029   end procedure.
     3030   procedure wth-parts-inter-edit:
     3031     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     3032     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     3033     define input-output parameter p-rec        as recid     no-undo .
     3034     define buffer bfrom_wth-parts   for ub.wth-parts.
     3035     define variable v-recDop as recid        no-undo.
     3036     do on error undo, return error:
     3037         find first bfrom_wth-parts exclusive-lock where
     3038                   recid(bfrom_wth-parts) = p-rec no-error.
     3039         if not available bfrom_wth-parts then return error
     3040           substitute('Не найдена партия (recid &1)', p-rec).
     3041         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     3042            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     3043            return error 'Нельзя увеличивать границы диапазона.'.
     3044         end.
     3045         empty temp-table tt-wthlib-parts.
     3046         create tt-wthlib-parts.
     3047         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     3048         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     3049                     INPUT     bfrom_wth-parts.obj-type,
     3050                     INPUT     bfrom_wth-parts.obj-code,
     3051                     INPUT     bfrom_wth-parts.w-p-code,
     3052                     INPUT     bfrom_wth-parts.wth-code,
     3053                     INPUT     bfrom_wth-parts.par-code,
     3054                     INPUT     bfrom_wth-parts.in-code ,
     3055                     INPUT     bfrom_wth-parts.doc-code,
     3056                     INPUT     bfrom_wth-parts.ser-code,
     3057                     INPUT     bfrom_wth-parts.db-num  ,
     3058                     INPUT     p-Fact-RangeFrom ,
     3059                     INPUT     p-fact-rangeTo  ,
     3060                     INPUT     p-Fact-RangeFrom ,
     3061                     INPUT     p-fact-rangeTo ,
     3062                     INPUT     bfrom_wth-parts.host-code     ,
     3063                     INPUT     bfrom_wth-parts.contract-code               ,
     3064                     INPUT     bfrom_wth-parts.price-rubl  ,
     3065                     INPUT     bfrom_wth-parts.price-base    ,
     3066                     INPUT     bfrom_wth-parts.supp-type,
     3067                     INPUT     bfrom_wth-parts.supp-code,
     3068                     INPUT     bfrom_wth-parts.in-obj-type      ,
     3069                     INPUT     bfrom_wth-parts.in-obj-code      ,
     3070                     INPUT     bfrom_wth-parts.ext-doc-type,
     3071                     INPUT     bfrom_wth-parts.gds-code,
     3072                     INPUT     0              ,
     3073                     INPUT     bfrom_wth-parts.beg-dt      ,
     3074                     INPUT     bfrom_wth-parts.end-dt      ,
     3075                     INPUT     bfrom_wth-parts.vat-pc      ,
     3076                     INPUT     bfrom_wth-parts.cli-code,
     3077                     INPUT     bfrom_wth-parts.cli-type,
     3078                     INPUT     bfrom_wth-parts.out-obj-code,
     3079                     INPUT     bfrom_wth-parts.out-obj-type,
     3080                     INPUT     bfrom_wth-parts.sale-obj-code,
     3081                     INPUT     bfrom_wth-parts.sale-obj-type,
     3082                     INPUT     bfrom_wth-parts.doc-code,
     3083                     INPUT     yes,
     3084                     INPUT     bfrom_wth-parts.type,
     3085                     INPUT-OUTPUT p-rec
     3086                     ) no-error.
     3087       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3088       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     3089       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     3090                     INPUT     tt-wthlib-parts.obj-type,
     3091                     INPUT     tt-wthlib-parts.obj-code,
     3092                     INPUT     tt-wthlib-parts.w-p-code,
     3093                     INPUT     tt-wthlib-parts.wth-code,
     3094                     INPUT     tt-wthlib-parts.par-code,
     3095                     INPUT     tt-wthlib-parts.in-code ,
     3096                     INPUT     tt-wthlib-parts.out-code,
     3097                     INPUT     tt-wthlib-parts.ser-code,
     3098                     INPUT     tt-wthlib-parts.db-num  ,
     3099                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     3100                     INPUT     p-fact-rangeFrom - 1  ,
     3101                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     3102                     INPUT     p-fact-rangeFrom - 1,
     3103                     INPUT     tt-wthlib-parts.host-code     ,
     3104                     INPUT     tt-wthlib-parts.contract-code               ,
     3105                     INPUT     tt-wthlib-parts.price-rubl    ,
     3106                     INPUT     tt-wthlib-parts.price-base    ,
     3107                     INPUT     tt-wthlib-parts.supp-type,
     3108                     INPUT     tt-wthlib-parts.supp-code,
     3109                     INPUT     tt-wthlib-parts.in-obj-type      ,
     3110                     INPUT     tt-wthlib-parts.in-obj-code      ,
     3111                     INPUT     tt-wthlib-parts.ext-doc-type,
     3112                     INPUT     tt-wthlib-parts.gds-code,
     3113                     INPUT     1             ,
     3114                     INPUT     tt-wthlib-parts.beg-dt        ,
     3115                     INPUT     tt-wthlib-parts.end-dt        ,
     3116                     INPUT     tt-wthlib-parts.vat-pc        ,
     3117                     INPUT     tt-wthlib-parts.cli-code,
     3118                     INPUT     tt-wthlib-parts.cli-type,
     3119                     INPUT     tt-wthlib-parts.out-obj-code,
     3120                     INPUT     tt-wthlib-parts.out-obj-type,
     3121                     INPUT     tt-wthlib-parts.sale-obj-code,
     3122                     INPUT     tt-wthlib-parts.sale-obj-type,
     3123                     INPUT     tt-wthlib-parts.doc-code,
     3124                     INPUT  yes,
     3125                     INPUT    tt-wthlib-parts.type,
     3126                     INPUT-OUTPUT v-recDop
     3127                     ) no-error.
     3128       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3129       end.
     3130       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     3131               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     3132                     INPUT     tt-wthlib-parts.obj-type,
     3133                     INPUT     tt-wthlib-parts.obj-code,
     3134                     INPUT     tt-wthlib-parts.w-p-code,
     3135                     INPUT     tt-wthlib-parts.wth-code,
     3136                     INPUT     tt-wthlib-parts.par-code,
     3137                     INPUT     tt-wthlib-parts.in-code ,
     3138                     INPUT     tt-wthlib-parts.out-code,
     3139                     INPUT     tt-wthlib-parts.ser-code,
     3140                     INPUT     tt-wthlib-parts.db-num  ,
     3141                     INPUT     p-fact-rangeTo + 1 ,
     3142                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     3143                     INPUT     p-fact-rangeTo + 1 ,
     3144                     INPUT     tt-wthlib-parts.fact-rangeTo,
     3145                     INPUT     tt-wthlib-parts.host-code     ,
     3146                     INPUT     tt-wthlib-parts.contract-code               ,
     3147                     INPUT     tt-wthlib-parts.price-rubl    ,
     3148                     INPUT     tt-wthlib-parts.price-base    ,
     3149                     INPUT     tt-wthlib-parts.supp-type,
     3150                     INPUT     tt-wthlib-parts.supp-code,
     3151                     INPUT     tt-wthlib-parts.in-obj-type      ,
     3152                     INPUT     tt-wthlib-parts.in-obj-code      ,
     3153                     INPUT     tt-wthlib-parts.ext-doc-type,
     3154                     INPUT     tt-wthlib-parts.gds-code,
     3155                     INPUT     1             ,
     3156                     INPUT     tt-wthlib-parts.beg-dt        ,
     3157                     INPUT     tt-wthlib-parts.end-dt        ,
     3158                     INPUT     tt-wthlib-parts.vat-pc        ,
     3159                     INPUT     tt-wthlib-parts.cli-code,
     3160                     INPUT     tt-wthlib-parts.cli-type,
     3161                     INPUT     tt-wthlib-parts.out-obj-code,
     3162                     INPUT     tt-wthlib-parts.out-obj-type,
     3163                     INPUT     tt-wthlib-parts.sale-obj-code,
     3164                     INPUT     tt-wthlib-parts.sale-obj-type,
     3165                     INPUT     tt-wthlib-parts.doc-code,
     3166                     INPUT     yes,
     3167                     INPUT     tt-wthlib-parts.type,
     3168                     INPUT-OUTPUT v-recDop
     3169                     ) no-error.
     3170         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3171         end.
     3172     end.
     3173   end procedure.
     3174   PROCEDURE INIT_prtdate:
     3175       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     3176       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     3177       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     3178       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     3179       define input parameter        p-date                AS DATE no-undo .
     3180       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     3181       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     3182       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     3183       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     3184       define variable v-value-character as character no-undo .
     3185       define variable v-value-date as date no-undo .
     3186       define variable v-value-decimal as decimal no-undo .
     3187       define variable v-value-integer as INTEGER no-undo .
     3188       define variable v-value-logical AS LOGICAL no-undo .
     3189       define variable v-param-type as character no-undo .
     3190       FIND FIRST buf_wth-ser NO-LOCK
     3191           WHERE buf_wth-ser.ser-code = p-ser-code
     3192           AND buf_wth-ser.db-num = p-db-num.
     3193       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     3194           p-beg-dt = buf_wth-ser.beg-dt.
     3195       END.
     3196       IF buf_wth-ser.chk-edt = 2 THEN DO:
     3197           p-end-dt = buf_wth-ser.end-dt.
     3198       END.
     3199       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     3200           run adm/shattri.p (
     3201               input "get":U
     3202               ,input  p-obj-type
     3203               ,input  p-obj-code
     3204               ,input  'wthdoc_obj':U
     3205               ,input  'rangerule':U
     3206               ,output v-value-character
     3207               ,output v-value-date
     3208               ,output v-value-decimal
     3209               ,output v-value-integer
     3210               ,output v-value-logical
     3211               ,output v-param-type
     3212               ,INPUT-OUTPUT table-handle v-tth
     3213               ) no-error .
     3214           IF not error-status:error  then do:
     3215               v-rangeRule =  v-value-integer.
     3216           END.
     3217           CASE v-rangeRule:
     3218           WHEN 1 THEN DO:
     3219               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     3220                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     3221               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     3222                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     3223               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     3224                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     3225           END.
     3226           when 2 then do:
     3227             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     3228                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     3229             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     3230                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     3231                        .
     3232           end.
     3233           WHEN 3 THEN DO:
     3234               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     3235                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     3236               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     3237                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     3238               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     3239                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     3240               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     3241                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     3242           END.
     3243           when 4 then do:
     3244                p-beg-dt = p-date.
     3245                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     3246           end.
     3247           END CASE.
     3248       END.
     3249   END.
     3250   PROCEDURE INIT_prtprice:
     3251   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     3252   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     3253   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     3254   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     3255   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     3256   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     3257   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     3258   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     3259   define input parameter        p-date                AS DATE no-undo .
     3260   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     3261   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     3262   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     3263   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     3264   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     3265   DEF VAR v-cash-type-pay AS CHAR no-undo.
     3266   define variable p-plt-id AS INT no-undo.
     3267   define variable  p-plt-db-num   AS INT no-undo.
     3268   define variable  p-pdf-id  AS INT no-undo.
     3269   define variable  p-pdf-db-num AS INT no-undo.
     3270   define variable  p-sale-price-base AS DEC no-undo.
     3271   define variable  p-sale-price-rubl AS DEC no-undo.
     3272   define variable  p-road-tax-base AS DEC no-undo.
     3273   define variable  p-road-tax-rubl AS DEC no-undo.
     3274   define variable  p-excise-base AS DEC no-undo.
     3275   define variable  p-excise-rubl AS DEC no-undo.
     3276   define variable  p-fact-order  AS DEC no-undo.
     3277   do on error undo, return error return-value :
     3278     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     3279                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     3280     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     3281     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     3282     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     3283     ELSE v-cash-type-pay = ?.
     3284     run fact-order-mpl (
     3285         INPUT p-date ,
     3286         INPUT p-obj-type ,
     3287         INPUT p-obj-code ,
     3288         OUTPUT p-fact-order
     3289         ) no-error .
     3290     if error-status:error then do:
     3291       message   return-value skip error-status:get-message(1)
     3292       skip  'Получение цены из множественного прайс-листа отклонено.'
     3293       view-as alert-box.
     3294       return.
     3295     end.
     3296   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3298     (input  p-gds-code
     3299     ,input  '1':U
     3300     ,input  ?
     3301     ,input  p-host-code
     3302     ,input  p-obj-type
     3303     ,input  p-obj-code
     3304     ,output p-vat-pc
     3305     ) no-error .
     3306     run mpl-autoprice in this-procedure
     3307       ( input    false
     3308         ,input   p-cli-type
     3309         ,input   p-cli-code
     3310         ,input   p-gds-code
     3311         ,input   p-gds-code
     3312         ,input   p-obj-type
     3313         ,input   p-obj-code
     3314         ,input   0
     3315         ,input   0
     3316         ,input   ""
     3317         ,input   v-cash-type-pay
     3318         ,input   p-fact-order
     3319         ,output  p-plt-id
     3320         ,output  p-plt-db-num
     3321         ,output  p-pdf-id
     3322         ,output  p-pdf-db-num
     3323         ,output  p-sale-price-base
     3324         ,output  p-sale-price-rubl
     3325         ,output  p-road-tax-base
     3326         ,output  p-road-tax-rubl
     3327         ,output  p-excise-base
     3328         ,output  p-excise-rubl
     3329         ) no-error .
     3330     if error-status:error then do:
     3331       message   return-value skip error-status:get-message(1) view-as alert-box.
     3332       return.
     3333     end.
     3334     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     3335     p-price-base = p-sale-price-base * b-wth-par.par-val.
     3336   end.
     3337   END.
     3338   procedure  set-wthmpl-date:
     3339   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     3340   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     3341   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     3342   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     3343   define variable v-atrValue      as character no-undo .
     3344   define variable v-atrDsf      as CHARACTER no-undo .
     3345   define variable v-atrType     as character no-undo .
     3346   do on error undo, return error return-value :
     3347   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3348                           input 'wthdsf':U ,
     3349                          output v-atrValue ,
     3350                          output v-atrType )  .
     3351     p-date = date(v-atrValue) no-error.
     3352     if p-date = ? then p-date = p-beg-dt no-error.
     3353     if p-date = ? then p-date = p-doc-date.
     3354   end.
     3355   end procedure.
     3356   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   FUNCTION mark-string RETURNS CHARACTER
     3358     ( input p-recid as recid, input mark-list as character  ) :
     3359     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     3360   END FUNCTION.
     3361   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3362   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     3363   procedure fltopend_fltopend :
     3364   define input parameter p-parent-handle as handle no-undo .
     3365   define input parameter p-qh as handle no-undo .
     3366   define input parameter p-flt-open-open-query  as character no-undo .
     3367   define input parameter p-where-cond as character no-undo .
     3368   define input parameter p-use-indFIRST-query-tail as character no-undo .
     3369   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     3370   define input parameter p-indexed-reposition as character no-undo .
     3371     do
     3372     on error undo, return error
     3373     :
     3374   define variable v-prepare-string as character no-undo .
     3375   define variable glog as logical no-undo .
     3376   assign
     3377   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     3378                      p-where-cond + chr(32)  +
     3379                      p-use-indFIRST-query-tail + chr(32) +
     3380                      p-use-ind-sort-clmn-by + chr(32) +
     3381                      p-indexed-reposition
     3382   .
     3383   assign
     3384   glog = p-qh:query-prepare(v-prepare-string) no-error .
     3385   if not glog
     3386   or error-status:error then do:
     3387     message error-status:get-message(1) view-as alert-box .
     3388     undo, return error .
     3389   end.
     3390   assign
     3391   glog = p-qh:query-open no-error .
     3392   if not glog
     3393   or error-status:error then do:
     3394     message error-status:get-message(1) view-as alert-box .
     3395     undo, return error .
     3396   end.
     3397     end.
     3398   end procedure.
     3399   procedure fltopend_fltfindd :
     3400   define input parameter p-parent-handle as handle no-undo .
     3401   define input parameter p-qh as handle no-undo .
     3402   define input parameter p-rowid as rowid no-undo .
     3403   define input parameter p-next as logical no-undo .
     3404   define input parameter p-lock as integer no-undo .
     3405   define input parameter p-bh as handle no-undo .
     3406   define input parameter p-where-cond as character no-undo .
     3407   define input parameter p-use-index-phrase as character no-undo .
     3408   define variable glog as logical no-undo .
     3409   define variable v-qh as handle no-undo .
     3410   define variable v-bh as handle no-undo .
     3411   define variable v-recid as recid no-undo .
     3412   define variable v-prepare-string as character no-undo .
     3413   do
     3414   on error undo, return error
     3415   on stop undo, return error
     3416   :
     3417     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     3418     create buffer v-bh for table p-bh buffer-name p-bh:name.
     3419     create query v-qh.
     3420     v-qh:set-buffers(v-bh).
     3421     v-prepare-string = substitute("for each &1 &2 &3"
     3422                                     ,v-bh:name
     3423                                     ,p-where-cond
     3424                                     ,p-use-index-phrase).
     3425     glog = v-qh:query-prepare(v-prepare-string) no-error.
     3426     if not glog then do:
     3427       delete object v-qh.
     3428       delete object v-bh.
     3429       undo, return error .
     3430     end.
     3431     glog = v-qh:query-open no-error .
     3432     if not glog then do:
     3433       delete object v-qh.
     3434       delete object v-bh.
     3435       undo, return error .
     3436     end.
     3437     if p-next then do:
     3438       v-qh:reposition-to-rowid(p-rowid) no-error .
     3439       glog = v-qh:get-next( p-lock) no-error .
     3440       glog = v-qh:get-next( p-lock) no-error .
     3441       if not glog or v-qh:query-off-end = yes then do:
     3442         glog = v-qh:get-first( p-lock) no-error .
     3443       end.
     3444     end.
     3445     else do:
     3446       glog = v-qh:get-first( p-lock) no-error .
     3447     end.
     3448     v-recid = v-bh:recid no-error .
     3449     delete object v-qh.
     3450     delete object v-bh.
     3451     return string(v-recid) .
     3452   end.
     3453   end procedure.
     3454   procedure fltopend_fltfindq :
     3455   define input parameter p-parent-handle as handle no-undo .
     3456   define input parameter p-qh as handle no-undo .
     3457   define input parameter p-next as logical no-undo .
     3458   define input parameter p-lock as integer no-undo .
     3459   define input parameter p-flt-open-open-query  as character no-undo .
     3460   define input parameter p-where-cond as character no-undo .
     3461   define input parameter p-use-indFIRST-query-tail as character no-undo .
     3462   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     3463   define input parameter p-indexed-reposition as character no-undo .
     3464   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     3465   define variable glog as logical no-undo .
     3466   define variable v-qh as handle no-undo .
     3467   define variable v-bh as handle no-undo extent 18.
     3468   define variable v-rowid as rowid no-undo extent 18.
     3469   define variable v-ii as integer no-undo .
     3470   define variable v-prepare-string as character no-undo .
     3471   do
     3472   on error undo, return error
     3473   on stop undo, return error
     3474   :
     3475     create query v-qh.
     3476     do v-ii = 1 to p-qh:num-buffers:
     3477       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     3478       assign
     3479       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     3480       no-error.
     3481       v-qh:add-buffer(v-bh[v-ii]).
     3482     end.
     3483     assign
     3484     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     3485                       p-where-cond + chr(32)  +
     3486                       p-use-indFIRST-query-tail + chr(32) +
     3487                       p-use-ind-sort-clmn-by + chr(32) +
     3488                       p-indexed-reposition
     3489     .
     3490     glog = v-qh:query-prepare( v-prepare-string) no-error .
     3491     if not glog then do:
     3492       delete object v-qh.
     3493       do v-ii = 1 to p-qh:num-buffers:
     3494         delete object v-bh[v-ii].
     3495       end.
     3496       undo, return error .
     3497     end.
     3498     glog = v-qh:query-open no-error .
     3499     if not glog then do:
     3500       delete object v-qh.
     3501       do v-ii = 1 to p-qh:num-buffers:
     3502         delete object v-bh[v-ii].
     3503       end.
     3504       undo, return error .
     3505     end.
     3506     if p-next then do:
     3507       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     3508       glog = v-qh:get-next( p-lock) no-error .
     3509       glog = v-qh:get-next( p-lock) no-error .
     3510       if not glog or v-qh:query-off-end = yes then do:
     3511         glog = v-qh:get-first( p-lock) no-error .
     3512       end.
     3513     end.
     3514     else do:
     3515       glog = v-qh:get-first( p-lock) no-error .
     3516     end.
     3517     do v-ii = 1 to p-qh:num-buffers:
     3518       assign
     3519       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     3520       no-error.
     3521     end.
     3522     delete object v-qh.
     3523     do v-ii = 1 to p-qh:num-buffers:
     3524       delete object v-bh[v-ii].
     3525     end.
     3526   end.
     3527   end procedure.
     3528   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3529   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     3530   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     3531   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     3532   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     3533   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     3534   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     3535   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     3536   procedure uf-name :
     3537     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     3538     define output parameter p-use-List_     as logical   no-undo .
     3539     define output parameter p-type-List_     as character no-undo .
     3540     define output parameter p-format-List_   as character no-undo .
     3541     define output parameter p-use-Naim      as logical   no-undo .
     3542     define output parameter p-type-Naim      as character no-undo .
     3543     define output parameter p-format-Naim    as character no-undo .
     3544     define output parameter p-use-print-graft as logical   no-undo .
     3545     define output parameter p-use-sort-gr   as logical   no-undo .
     3546     define output parameter p-use-type-price as logical   no-undo .
     3547     define output parameter p-use-type-val  as logical   no-undo .
     3548     define output parameter p-label          as character no-undo .
     3549     define output parameter p-tooltip        as character no-undo .
     3550     define output parameter p-user-can-edit  as logical   no-undo .
     3551     define output parameter p-output-display as logical   no-undo .
     3552     define output parameter p-other          as character no-undo .
     3553     do
     3554     on error undo, return error
     3555     :
     3556       case p-code :
