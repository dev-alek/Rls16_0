     1057       ,input  p-value-decimal
     1058       ,input  p-value-integer
     1059       ,input  p-value-logical
     1060       ) no-error .
     1061     if error-status :error
     1062     then do:
     1063       undo, return error return-value .
     1064     end.
     1065   end.
     1066   end procedure.
     1067   procedure thbjattr_set-section :
     1068   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1069   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1070   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
