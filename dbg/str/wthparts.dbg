     6845       on stop undo, leave
     6846       on error undo, leave
     6847       :
     6848         assign
     6849           l-disable-where-60 =
     6850             (" X_wth-parts.wth-code = p-wth-code and X_wth-parts.w-p-code = p-w-p-code             and X_wth-parts.par-code = p-par-code and X_wth-parts.obj-type = p-curr-obj-type and X_wth-parts.obj-code = p-curr-obj-code             and (if rsfl-par >= 10 then  (X_wth-parts.out-code = p-wth-doc or X_wth-parts.out-code = entry(rsfl-par - 10, zone-list)) else (if rsfl-par = 0 then (X_wth-parts.out-code = p-wth-doc) else (X_wth-parts.out-code = entry(rsfl-par,zone-list))) ) " + " " + where-phrase-60 = "")
     6851         .
     6852         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     6853                             ,input QUERY br-parts:handle
     6854                             ,input parameter-3-60
     6855                             ,input parameter-4-60
     6856                             ,input parameter-5-60
     6857                             ,input parameter-6-60
     6858                             ,input parameter-7-60
     6859                             )
     6860         .
     6861         assign
     6862           l-filter-open-60 = true
     6863         .
     6864       end.
     6865       if l-filter-open-60 = false then do:
     6866         message
     6867           "Ошибка при фильтрации / сортировке" skip
     6868           "Будут показаны записи без учета фильтра" skip
     6869           view-as alert-box .
     6870       end.
     6871       else do:
     6872           assign
     6873             l-query-was-opened = true
     6874           .
     6875       end.
     6876     end.
     6877     if l-filter-open-60 = false then do:
     6878       OPEN QUERY br-parts FOR EACH X_wth-parts NO-LOCK
     6879         where  X_wth-parts.wth-code = p-wth-code and X_wth-parts.w-p-code = p-w-p-code             and X_wth-parts.par-code = p-par-code and X_wth-parts.obj-type = p-curr-obj-type and X_wth-parts.obj-code = p-curr-obj-code             and (if rsfl-par >= 10 then  (X_wth-parts.out-code = p-wth-doc or X_wth-parts.out-code = entry(rsfl-par - 10, zone-list)) else (if rsfl-par = 0 then (X_wth-parts.out-code = p-wth-doc) else (X_wth-parts.out-code = entry(rsfl-par,zone-list))) )
     6880          by X_wth-parts.fact-rangefrom
     6881     .
     6882         assign
     6883           l-query-was-opened = true
     6884         .
     6885     end.
     6886     run waitfram-hide in this-procedure .
     6887         end.
     6888       end.
     6889   END CASE.
     6890   if v-prt-rec <> ? then reposition br-parts to recid v-prt-rec no-error.
     6891   apply "entry" to br-parts in frame Dialog-Frame.
     6892   run waitfram-hide in this-procedure .
     6893   APPLY "VALUE-CHANGED":U to br-parts.
     6894   END PROCEDURE.
     6895   PROCEDURE PrintProc :
     6896   define variable date_string     as      char    no-undo.
     6897   define variable Line                as      char    no-undo.
     6898   define variable for-time as char.
     6899   define variable v-obj    as character    no-undo.
     6900   define variable v-cli    as character    no-undo.
     6901   define variable v-sum-tot as integer     no-undo.
     6902   define variable v-price   as character no-undo.
     6903   DEFINE FRAME Wth-List
     6904   v-serName                  column-label "Серия"  format "x(10)"
     6905   fl-par-val                 column-label "Номинал"  format "x(5)"
     6906   X_wth-parts.fact-rangeFrom column-label "Диапазон с"  format ">>>>>>>>"
     6907   X_wth-parts.fact-rangeTo   column-label "Диапазон по" format ">>>>>>>>"
     6908   v-w-p-name                 COLUMN-LABEL "MX"     FORMAT "X(14)":U
     6909   v-obj                      column-label "Объект"
     6910   v-obj-name                 COLUMN-LABEL "Объект"     FORMAT "X(14)":U
     6911   v-out-name                 column-label "Зона"
     6912   X_wth-parts.in-code        column-label "Накл. порожд."
     6913   v-cli                      column-label "Покупатель"  format 'x(20)'
     6914   v-price                    column-label "Цена за ед."  format 'x(12)'
     6915   X_wth-parts.beg-dt         column-label "Срок годн. с"
     6916   X_wth-parts.end-dt         column-label "Срок годн. по"
     6917   X_wth-parts.fact-date      column-label "Факт. дата"
     6918   HEADER  date_string AT 5 format "X(35)"
     6919   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     6920   Line format "X(190)" AT 1
     6921   with width 198 down stream-io use-text    .
     6922   Line = fill("-", 190).
     6923   date_string = cur-time-print() .
     6924   run prn-lib-open-stream  in this-procedure (
     6925                                                input parParentProc
     6926                                               ,input 62
     6927                                               ,input yes
     6928                                               ,input no
     6929                                               ).
     6930   PUT  STREAM PrnLibStream
     6931   SPACE(25) ( frame Dialog-Frame:title )
     6932   format "x(90)" SKIP(1) .
     6933   FORM HEADER
     6934   Line AT 1 SKIP
     6935   "Продолжение - на следующей странице" AT 30 SKIP
     6936   with FRAME BottomFrame width 198 PAGE-BOTTOM NO-LABELS NO-BOX .
     6937   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6938   FORM with FRAME Wth-List  .
     6939   run waitfram-show in this-procedure ( input "Ждите...").
     6940   v-sum-tot = 0.
     6941   GET first BR-parts.
     6942   DO WHILE available X_wth-parts :
     6943         FIND FIRST b-wealth WHERE b-wealth.wth-code = X_wth-parts.wth-code NO-LOCK NO-ERROR.
     6944         IF AVAILABLE b-wealth THEN fl-wth-name =  b-wealth.wth-name.
     6945         ELSE fl-wth-name = '?':U.
     6946         FIND FIRST b-wth-par WHERE b-wth-par.wth-code =  X_wth-parts.wth-code AND b-wth-par.par-code = X_wth-parts.par-code NO-LOCK NO-ERROR.
     6947         IF AVAILABLE b-wth-par THEN assign fl-par-val =  SUBSTITUTE("&1&2",b-wth-par.par-val,b-wth-par.par-unit).
     6948     Display STREAM PrnLibStream
     6949          fl-par-val
     6950         get-ser-name(X_wth-parts.ser-code,X_wth-parts.db-num) @ v-serName
     6951         X_wth-parts.fact-rangeFrom
     6952         X_wth-parts.fact-rangeTo
     6953         get-w-p-name(X_wth-parts.w-p-code, X_wth-parts.obj-type,X_wth-parts.obj-code) @ v-w-p-name
     6954         substitute('&1 &2',X_wth-parts.obj-type,X_wth-parts.obj-code) @ v-obj
     6955         get-cli-name(X_wth-parts.obj-type,X_wth-parts.obj-code ) @ v-obj-name   COLUMN-LABEL "Объект"     FORMAT "X(14)":U
     6956               get-wthparts-out-code(X_wth-parts.out-code) @ v-out-name
     6957         X_wth-parts.in-code
     6958         get-cli-name(X_wth-parts.cli-type,X_wth-parts.cli-code ) @ v-cli
     6959         if X_wth-parts.price-rubl > 0 then trim(string((X_wth-parts.price-rubl / b-wth-par.par-val),"->>,>>9.99")) else '':U @ v-price
     6960         X_wth-parts.beg-dt
     6961         X_wth-parts.end-dt
     6962         X_wth-parts.fact-date
     6963     with FRAME Wth-List .
     6964     v-sum-tot = v-sum-tot + X_wth-parts.fact-rangeTo - X_wth-parts.fact-rangeFrom + 1.
     6965     DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     6966     GET next BR-parts.
     6967   END.
     6968   UNDERLINE  STREAM PrnLibStream
     6969       v-serName
     6970      fl-par-val
     6971        X_wth-parts.fact-rangeFrom
     6972      X_wth-parts.fact-rangeTo
     6973       v-w-p-name
     6974       v-obj
     6975       v-obj-name
     6976       v-out-name
     6977       X_wth-parts.in-code
     6978       v-cli
     6979       v-price
     6980       X_wth-parts.beg-dt
     6981       X_wth-parts.end-dt
     6982       X_wth-parts.fact-date
     6983   with FRAME Wth-List .
     6984    put STREAM PrnLibStream
     6985     "ИТОГО    " at 20 v-sum-tot at 30 .
     6986   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6987   HIDE  STREAM PrnLibStream FRAME CheckList.
     6988   output  STREAM PrnLibStream CLOSE.
     6989   run waitfram-hide in this-procedure .
     6990   run prn-lib-prn-file in this-procedure (
     6991                                             input parParentProc
     6992                                             ,input 0
     6993                                             ).
     6994   END PROCEDURE.
     6995   PROCEDURE proc-add :
     6996   define variable rep-rec as recid no-undo.
     6997   define variable v-i as int       no-undo.
     6998   define variable v-addrid-list as char no-undo.
     6999   if b-wth-doc.ext-doc-type = 'ie':U then do:
     7000     run str/wthpartl.w (
     7001                    input parparentproc
     7002                   ,input p-curr-host-code
     7003                   ,input p-curr-obj-type
     7004                   ,input p-curr-obj-code
     7005                   ,INPUT 'ДОБАВЛЕНИЕ':U
     7006                   ,INPUT p-w-p-code
     7007                   ,INPUT p-wth-code
     7008                   ,INPUT p-par-code
     7009                   ,INPUT p-wth-doc
     7010                   ,INPUT p-wth-doc
     7011                   ,INPUT 0
     7012                   ,INPUT 0
     7013                   ,INPUT 0
     7014                   ,INPUT 0
     7015                   ,INPUT p-type
     7016                   ,input-output rep-rec).
     7017     if rep-rec <> ? then
     7018     v-prt-rec = rep-rec.
     7019   end.
     7020   else do:
     7021       if  available X_wth-parts AND (rid-list = ""  or
     7022           b-mark:sensitive in frame Dialog-Frame= no)
     7023       then
     7024       rid-list = string( recid( X_wth-parts ) ) .
     7025       v-addrid-list = rid-list.
     7026       list-block:
     7027       do v-i = 1 to num-entries(v-addrid-list,chr(44)):
     7028         rep-rec = int(entry(v-i,v-addrid-list,chr(44))).
     7029         for first b-wth-parts no-lock where recid(b-wth-parts) = rep-rec:
     7030           RUN wth-parts-rezerv ( yes
     7031                                 ,b-wth-parts.fact-rangeFrom
     7032                                 ,b-wth-parts.fact-RangeTo
     7033                                 ,b-wth-parts.beg-dt
     7034                                 ,b-wth-parts.end-dt
     7035                                 ,b-wth-parts.ser-code
     7036                                 ,b-wth-parts.db-num
     7037                                 ,b-wth-parts.price-rubl
     7038                                 ,b-wth-parts.price-base
     7039                                 ,b-wth-parts.vat-pc
     7040                                 ,b-wth-doc.host-code
     7041                                 ,b-wth-doc.obj-type
     7042                                 ,b-wth-doc.obj-code
     7043                                 ,p-w-p-code
     7044                                 ,b-wth-parts.wth-code
     7045                                 ,b-wth-parts.par-code
     7046                                 ,b-wth-parts.in-code
     7047                                 ,b-wth-doc.doc-code
     7048                                 ,b-wth-doc.cli-type
     7049                                 ,b-wth-doc.cli-code
     7050                                 ,b-wth-doc.ext-doc-type
     7051                                 ,b-goods.gds-code
     7052                                 ,p-type
     7053                                 ,INPUT-OUTPUT rep-rec
     7054                                 ) no-error .
     7055           if error-status:error then do:
     7056             if v-i =  num-entries(v-addrid-list,chr(44)) then do:
     7057               MESSAGE RETURN-VALUE
     7058               VIEW-AS ALERT-BOX error.
     7059               leave list-block.
     7060             end.
     7061             else do:
     7062               MESSAGE RETURN-VALUE skip
     7063                       "Продолжить добавление линий в документ?"
     7064               VIEW-AS ALERT-BOX question buttons yes-no update choice as log.
     7065               if choice then.
     7066               else leave list-block.
     7067             end.
     7068           end.
     7069           v-prt-rec = rep-rec.
     7070         end.
     7071         assign
     7072           entry( lookup(string(rep-rec),rid-list),rid-list ) = "":U
     7073           rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     7074         .
     7075       end.
     7076   end.
     7077   END PROCEDURE.
     7078   PROCEDURE proc-del :
     7079   define variable v-i as int no-undo.
     7080   define variable v-delrid-list as char no-undo.
     7081   define variable rep-rec as recid no-undo.
     7082   if  available X_wth-parts AND (rid-list = ""  or
     7083       b-mark:sensitive in frame Dialog-Frame = no)
     7084   then
     7085   rid-list = string( recid( X_wth-parts ) ) .
     7086   v-delrid-list = rid-list.
     7087   if num-entries(v-delrid-list,chr(44)) = 1 then do:
     7088       message
     7089          substitute("Удалить партию из документа. Вы уверены?&1Партия:&1Код МЦ &2&1Код серии&3-&4&1Диапазон &5-&6",
     7090                     chr(10)
     7091                    ,X_wth-parts.wth-code
     7092                    ,X_wth-parts.ser-code
     7093                    ,X_wth-parts.db-num
     7094                    ,X_wth-parts.fact-rangeFrom
     7095                    ,X_wth-parts.fact-rangeTo)
     7096          view-as alert-box question buttons OK-Cancel update choice as log.
     7097          if not choice then do:
     7098            apply "entry" to br-parts in frame Dialog-Frame.
     7099            return no-apply.
     7100          end.
     7101   end.
     7102   else do:
     7103     message substitute('Вы действительно хотите удалить &1 партий из документа?',num-entries(v-delrid-list,chr(44)))
     7104          view-as alert-box question buttons OK-Cancel update choice .
     7105          if not choice then do:
     7106            apply "entry" to br-parts in frame Dialog-Frame.
     7107            return no-apply.
     7108          end.
     7109   end.
     7110   list-block:
     7111   do v-i = 1 to num-entries(v-delrid-list,chr(44)):
     7112     rep-rec = int(entry(v-i,v-delrid-list,chr(44))).
     7113     for first b-wth-parts no-lock where recid(b-wth-parts) = rep-rec:
     7114       if b-wth-parts.stts = 0 then do:
     7115           run  wth-doc-razrez ( input RECID(b-wth-parts),
     7116                                 input no ) no-error.
     7117           if error-status:error then DO:
     7118             if v-i = num-entries(v-delrid-list,chr(44)) then do:
     7119               MESSAGE RETURN-VALUE skip
     7120                     Error-status:get-message(1)
     7121               VIEW-AS ALERT-BOX ERROR.
     7122             end.
     7123             else do:
     7124               MESSAGE RETURN-VALUE skip
     7125                     Error-status:get-message(1)  skip
     7126                     'Продолжить удаление?'
     7127               VIEW-AS ALERT-BOX question buttons yes-no update choice.
     7128               if choice then.
     7129               else leave list-block.
     7130             end.
     7131           end.
     7132       end.
     7133       else do:
     7134         run str/wthpartp.p  ( INPUT  'ИЗМЕНЕНИЕ':U,
     7135                               INPUT  b-wth-parts.obj-type,
     7136                               INPUT  b-wth-parts.obj-code,
     7137                               INPUT  b-wth-parts.w-p-code,
     7138                               INPUT  b-wth-parts.wth-code,
     7139                               INPUT  b-wth-parts.par-code,
     7140                               INPUT  b-wth-parts.in-code ,
     7141                               INPUT  b-wth-parts.out-code,
     7142                               INPUT  b-wth-parts.ser-code,
     7143                               INPUT  b-wth-parts.db-num  ,
     7144                               INPUT  b-wth-parts.Fact-RangeFrom ,
     7145                               INPUT  b-wth-parts.fact-rangeTo   ,
     7146                               INPUT  b-wth-parts.doc-RangeFrom ,
     7147                               INPUT  b-wth-parts.doc-rangeTo  ,
     7148                               INPUT  b-wth-parts.host-code     ,
     7149                               INPUT  b-wth-parts.contract-code ,
     7150                               INPUT  b-wth-parts.price-rubl    ,
     7151                               INPUT  b-wth-parts.price-base    ,
     7152                               INPUT  b-wth-parts.supp-type,
     7153                               INPUT  b-wth-parts.supp-code,
     7154                               INPUT  b-wth-parts.in-obj-type      ,
     7155                               INPUT  b-wth-parts.in-obj-code      ,
     7156                               INPUT  b-wth-parts.ext-doc-type,
     7157                               INPUT  b-wth-parts.gds-code,
     7158                               INPUT  0            ,
     7159                               INPUT  b-wth-parts.beg-dt        ,
     7160                               INPUT  b-wth-parts.end-dt        ,
     7161                               INPUT  b-wth-parts.vat-pc        ,
     7162                               INPUT  b-wth-parts.cli-code,
     7163                               INPUT  b-wth-parts.cli-type,
     7164                               INPUT  b-wth-parts.out-obj-code,
     7165                               INPUT  b-wth-parts.out-obj-type,
     7166                               INPUT  b-wth-parts.sale-obj-code,
     7167                               INPUT  b-wth-parts.sale-obj-type,
     7168                               INPUT  b-wth-parts.doc-code ,
     7169                               INPUT  yes,
     7170                               INPUT   b-wth-parts.type ,
     7171                               INPUT-OUTPUT rep-rec
     7172                     ) no-error.
     7173         if error-status:error then do:
     7174           if v-i = num-entries(v-delrid-list,chr(44)) then do:
     7175             MESSAGE RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     7176           end.
     7177           else do:
     7178             MESSAGE RETURN-VALUE  skip
     7179                     'Продолжить удаление?'
     7180               VIEW-AS ALERT-BOX question buttons yes-no update choice.
     7181               if choice then.
     7182               else leave list-block.
     7183           end.
     7184         end.
     7185       end.
     7186       v-prt-rec = rep-rec.
     7187     end.
     7188     assign
     7189       entry( lookup(string(rep-rec),rid-list),rid-list ) = "":U
     7190       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     7191     .
     7192   end.
     7193   END PROCEDURE.
     7194   PROCEDURE save-position :
     7195    do
     7196   with frame Dialog-Frame
     7197   on error undo, return error
     7198   :
     7199   assign rsfl-ch rsfl-obj.
     7200           run uf-set (
     7201                 input 'wthps-zone':U
     7202               , input v-cntxt-userid
     7203               , input string( rsfl-ch )
     7204               , input 'wthps-zone':U
     7205               , input no
     7206               , input no
     7207               , input no
     7208               , input no
     7209           ) no-error .
     7210                 run uf-set (
     7211                 input 'wthparts-obj':U
     7212               , input v-cntxt-userid
     7213               , input string( rsfl-obj )
     7214               , input 'wthparts-obj':U
     7215               , input no
     7216               , input no
     7217               , input no
     7218               , input no
     7219           )  no-error.
     7220   end.
     7221   END PROCEDURE.
     7222   PROCEDURE show-doc-code :
     7223   if not self:sensitive then return.
     7224    for first b-wth-doc no-lock where b-wth-doc.doc-code = fl-doc-code:screen-value in frame Dialog-Frame:
     7225     run str/wthd-lkp.p (INPUT parparentproc ,
     7226                         input recid(b-wth-doc)) no-error.
     7227     if error-status:error then do:
     7228       message return-value skip
     7229       error-status:get-message(1)
     7230       view-as alert-box error.
     7231     end.
     7232    end.
     7233   END PROCEDURE.
     7234   FUNCTION get-cli-name RETURNS CHARACTER
     7235     ( f-cli-type AS CHAR, f-cli-code as int  ) :
     7236   For FIRST b-clients WHERE b-clients.obj-type = f-cli-type AND
     7237                          b-clients.obj-code = f-cli-code NO-LOCK:
     7238     return   b-clients.obj-name.
     7239   end.
     7240   RETURN "".
     7241   END FUNCTION.
     7242   FUNCTION get-ser-name RETURNS CHARACTER
     7243     ( pfser-code AS INT, pfser-db AS INT ) :
     7244   FOR FIRST buf_wth-ser NO-LOCK WHERE buf_wth-ser.ser-code = pfser-code
     7245                          AND  buf_wth-ser.db-num =  pfser-db:
     7246       RETURN buf_wth-ser.series.
     7247   END.
     7248     RETURN "".
     7249   END FUNCTION.
     7250   FUNCTION get-w-p-name RETURNS CHARACTER
     7251     ( vf-w-p-code AS int ,vf-obj-type as char, vf-obj-code as int ) :
     7252   if vf-w-p-code = 0 or vf-w-p-code = ? then return "":U.
     7253   for first buf_wth-place no-lock where buf_wth-place.w-p-code = vf-w-p-code
     7254                                     and buf_wth-place.obj-type = vf-obj-type
     7255                                     and buf_wth-place.obj-code = vf-obj-code:
     7256     return buf_wth-place.w-p-name.
     7257   end.
     7258   return string(vf-w-p-code).
     7259   END FUNCTION.
     7260   FUNCTION get-wthparts-out-code RETURNS CHARACTER
     7261     ( vf-out-code AS CHAR ) :
     7262   CASE vf-out-code:
     7263       WHEN 'free-zone':U   THEN RETURN 'свободно'.
     7264       WHEN 'out-zone':U THEN RETURN 'списано'.
     7265       WHEN 'put-zone':U    THEN RETURN 'погашено'.
     7266       WHEN 'cli-zone':U    THEN RETURN 'у клиента'.
     7267       WHEN 'фальшивый':U      THEN RETURN 'фальш.'.
     7268   END CASE.
     7269   RETURN vf-out-code.
     7270   END FUNCTION.
