     3862        LABEL "Вы&бор"
     3863        SIZE 10 BY 1.
     3864   DEFINE VARIABLE bar-str AS CHARACTER FORMAT "X(256)":U
     3865        VIEW-AS FILL-IN
     3866        SIZE 14 BY 1 NO-UNDO.
     3867   DEFINE VARIABLE fl-doc-code AS CHARACTER FORMAT "X(256)":U
