     3897   DEFINE VARIABLE Fn-rs-obj AS CHARACTER FORMAT "X(256)":U
     3898         VIEW-AS TEXT
     3899        SIZE 7.5 BY .67
     3900        FGCOLOR 4  NO-UNDO.
     3901   DEFINE VARIABLE text-sts AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     3902         VIEW-AS TEXT
     3903        SIZE 7.5 BY .67
     3904        FGCOLOR 4  NO-UNDO.
     3905   DEFINE VARIABLE rsfl-ch AS INTEGER
     3906        VIEW-AS RADIO-SET HORIZONTAL
     3907        RADIO-BUTTONS
     3908             "Все", 0
     3909        SIZE 83.5 BY .75 NO-UNDO.
     3910   DEFINE VARIABLE rsfl-obj AS INTEGER
     3911        VIEW-AS RADIO-SET HORIZONTAL
     3912        RADIO-BUTTONS
     3913             "Текущий объект", 1,
     3914   "Все объекты", 2
     3915        SIZE 47.5 BY 1 NO-UNDO.
