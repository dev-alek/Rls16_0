     3632   end procedure.
     3633   procedure uf-get :
     3634     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     3635     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     3636     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     3637     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     3638     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     3639     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     3640     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     3641     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     3642     do
     3643     on error undo, return error
     3644     :
     3645       define buffer buf_usr-flt for ubflt.usr-flt .
     3646       define variable v-use-List_     as logical   no-undo .
     3647       define variable v-type-List_     as character no-undo .
     3648       define variable v-format-List_   as character no-undo .
     3649       define variable v-use-Naim      as logical   no-undo .
     3650       define variable v-type-Naim      as character no-undo .
     3651       define variable v-format-Naim    as character no-undo .
     3652       define variable v-use-print-graft as logical   no-undo .
     3653       define variable v-use-sort-gr     as logical   no-undo .
     3654       define variable v-use-type-price  as logical   no-undo .
     3655       define variable v-use-type-val    as logical   no-undo .
     3656       define variable v-label          as character no-undo .
     3657       define variable v-tooltip        as character no-undo .
     3658       define variable v-user-can-edit  as logical   no-undo .
     3659       define variable v-output-display as logical   no-undo .
     3660       define variable v-other          as character no-undo .
     3661       run uf-name in this-procedure
     3662          (input  entry(1, p-code, chr(4))
     3663         ,output v-use-List_
     3664         ,output v-type-List_
     3665         ,output v-format-List_
     3666         ,output v-use-Naim
     3667         ,output v-type-Naim
     3668         ,output v-format-Naim
     3669         ,output v-use-print-graft
     3670         ,output v-use-sort-gr
     3671         ,output v-use-type-price
     3672         ,output v-use-type-val
     3673         ,output v-label
     3674         ,output v-tooltip
     3675         ,output v-user-can-edit
     3676         ,output v-output-display
     3677         ,output v-other
     3678         ) no-error .
     3679       if error-status :error then do:
     3680         undo, return error return-value .
     3681       end.
     3682       find first buf_usr-flt no-lock where
     3683                  buf_usr-flt.Call-point     = p-code AND
     3684                  buf_usr-flt.user-name       = p-user-name
     3685         no-error .
     3686       if avail buf_usr-flt then do:
     3687         assign
     3688         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     3689         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     3690         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     3691         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     3692         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     3693         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     3694         .
     3695       end.
     3696       else do:
     3697         assign
     3698         p-List_        = (if v-use-List_       then "":U                    else ?)
     3699         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     3700         p-print-graft  = (if v-use-print-graft then no                      else ?)
     3701         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     3702         p-type-price   = (if v-use-type-price  then no                      else ?)
     3703         p-type-val     = (if v-use-List_       then no                      else ?)
     3704         .
     3705       end.
     3706     end.
     3707   end procedure.
     3708   procedure uf-set :
     3709     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     3710     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     3711     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     3712     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     3713     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     3714     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     3715     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     3716     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     3717     do
     3718     on error undo, return error
     3719     :
     3720       define buffer buf_usr-flt for ubflt.usr-flt .
     3721       define variable v-use-List_     as logical   no-undo .
     3722       define variable v-type-List_     as character no-undo .
     3723       define variable v-format-List_   as character no-undo .
     3724       define variable v-use-Naim      as logical   no-undo .
     3725       define variable v-type-Naim      as character no-undo .
     3726       define variable v-format-Naim    as character no-undo .
     3727       define variable v-use-print-graft as logical   no-undo .
     3728       define variable v-use-sort-gr   as logical   no-undo .
     3729       define variable v-use-type-price as logical   no-undo .
     3730       define variable v-use-type-val  as logical   no-undo .
     3731       define variable v-tooltip        as character no-undo .
     3732       define variable v-label          as character no-undo .
     3733       define variable v-user-can-edit  as logical   no-undo .
     3734       define variable v-output-display as logical   no-undo .
     3735       define variable v-other          as character no-undo .
     3736       run uf-name in this-procedure
     3737         (input  entry(1, p-code, chr(4))
     3738         ,output v-use-List_
     3739         ,output v-type-List_
     3740         ,output v-format-List_
     3741         ,output v-use-Naim
     3742         ,output v-type-Naim
     3743         ,output v-format-Naim
     3744         ,output v-use-print-graft
     3745         ,output v-use-sort-gr
     3746         ,output v-use-type-price
     3747         ,output v-use-type-val
     3748         ,output v-label
     3749         ,output v-tooltip
     3750         ,output v-user-can-edit
     3751         ,output v-output-display
     3752         ,output v-other
     3753         ) no-error .
     3754       if error-status :error then do:
     3755         undo, return error return-value .
     3756       end.
     3757       find first buf_usr-flt where
     3758                  buf_usr-flt.Call-point     = p-code AND
     3759                  buf_usr-flt.user-name       = p-user-name
     3760         no-error .
     3761       if not avail buf_usr-flt then do:
     3762           create buf_usr-flt .
     3763           assign
     3764           buf_usr-flt.call-point = p-code
     3765           buf_usr-flt.user-name  = p-user-name
     3766           .
     3767       end.
     3768       if avail buf_usr-flt then do:
     3769        assign
     3770        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     3771        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     3772        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     3773        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     3774        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     3775        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     3776       .
     3777       release buf_usr-flt.
     3778       end.
     3779       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     3780     end.
     3781   end procedure.
     3782   define variable filter-label as character no-undo init "Материальные_ценности" .
     3783   define variable filter-label0 as character no-undo init "Материальные_ценности" .
     3784   define variable filter-point0 as character no-undo init "Парти_МЦ" .
     3785   define variable filter-point as character no-undo init "Парти_МЦ" .
     3786   define variable sort-column-name as character no-undo .
     3787   define variable v-prt-rec  as recid no-undo .
     3788   DEFINE VARIABLE v-out-name AS CHAR NO-UNDO format 'x(12)':U.
     3789   define variable rid-list   as character no-undo .
     3790   define variable v-SerDb    as character    no-undo.
     3791   define variable v-SerName  as character    no-undo.
     3792   DEFINE VARIABLE v-w-p-name AS CHAR NO-UNDO .
     3793   define variable v-obj-name as char no-undo.
     3794   DEFINE BUFFER b-wth-doc   FOR ub.wth-doc.
     3795   DEFINE BUFFER b-wealth    FOR ub.wealth.
