     1073   on error undo, return error return-value
     1074   :
     1075       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
     1076       (input  p-obj-type
     1077       ,input  p-obj-code
     1078       ,input  p-upper-code
     1079       ,input  table-handle p-tth
     1080       ) no-error .
     1081     if error-status :error
