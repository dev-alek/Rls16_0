        1   def var vss-revision    as character no-undo init "$Revision$":u .
        2   def var vss-author      as character no-undo init "$Author$":u .
        3   def var vss-date        as character no-undo init "$Date$":u .
        4   def var vss-workfile    as character no-undo init "$Workfile$":u .
        5   def var vss-archive     as character no-undo init "$Archive$":u .
        6   def var vss-description as character no-undo init "Карточка договора - реквизиты" .
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define input  parameter parParentProc      AS WIDGET-HANDLE NO-UNDO.
      113   define input  parameter p-host-code        as integer   no-undo .
      114   define input  parameter p-type             as integer   no-undo .
      115   define input  parameter ref-mode           as character no-undo .
      116   define input  parameter p-obj-code         as integer   no-undo .
      117   define input  parameter p-obj-type         as character no-undo .
      118   define input-output parameter p-obj-name     as character no-undo .
      119   define input-output parameter p-code-schet   as integer   no-undo .
      120   define input-output parameter p-code-schet-2 as integer   no-undo .
      121   define input-output parameter p-kpp          as character no-undo .
      122   define input-output parameter p-inn          as character no-undo .
      123   define input-output parameter p-addres       as character no-undo .
      124   define input-output parameter p-sign         as character no-undo .
      125   define input-output parameter p-sign-post    as character no-undo .
      126   define input-output parameter p-point-io-code   as integer   no-undo .
      127   define input-output parameter p-db-num as integer   no-undo .
      128   define variable ri-schet    as recid  no-undo .
      129   define variable ri-schet-2  as recid  no-undo .
      130   define variable v-current-db-num as integer   no-undo .
      131   define buffer buf_point-io for ub.point-io .
      132   DEFINE BUTTON b-add
      133        LABEL "О&бновить"
      134        SIZE 10 BY 1.
      135   DEFINE BUTTON b-bank
      136        LABEL "&Счет"
      137        SIZE 10 BY 1.
      138   DEFINE BUTTON b-bank-2
      139        LABEL "С&чет"
      140        SIZE 10 BY 1.
      141   DEFINE BUTTON b-exit AUTO-GO
      142        LABEL "&Отмена":L
      143        SIZE 10 BY 1.
      144   DEFINE BUTTON B-Help
      145        LABEL "Помо&щь"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON b-OK AUTO-GO
      149        LABEL "&Ввод ":L
      150        SIZE 10 BY 1.
      151   DEFINE BUTTON BUTTON-point-io
      152        IMAGE-UP FILE "btn-down-arrow":U
      153        IMAGE-DOWN FILE "btn-down-arrow":U
      154        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      155        LABEL "2"
      156        SIZE 2.88 BY 1.
      157   DEFINE VARIABLE addres AS CHARACTER FORMAT "X(100)"
      158        LABEL "Адрес"
      159         VIEW-AS TEXT
      160        SIZE 61.25 BY .79.
      161   DEFINE VARIABLE bank-name AS CHARACTER FORMAT "X(40)"
      162        LABEL "Банк"
      163         VIEW-AS TEXT
      164        SIZE 49.5 BY .79.
      165   DEFINE VARIABLE bank-name-2 AS CHARACTER FORMAT "X(40)"
      166        LABEL "в банке"
      167         VIEW-AS TEXT
      168        SIZE 58 BY .79.
      169   DEFINE VARIABLE bik AS CHARACTER FORMAT "X(18)"
      170        LABEL "БИК"
      171         VIEW-AS TEXT
      172        SIZE 23 BY .79.
      173   DEFINE VARIABLE c-schet AS CHARACTER FORMAT "X(20)"
      174        LABEL "Кор.счет"
      175         VIEW-AS TEXT
      176        SIZE 29.63 BY .79.
      177   DEFINE VARIABLE curr AS CHARACTER FORMAT "X(20)"
      178        LABEL "Валюта"
      179         VIEW-AS TEXT
      180        SIZE 15.38 BY .79.
      181   DEFINE VARIABLE curr-2 AS CHARACTER FORMAT "X(20)"
      182        LABEL "Валюта"
      183         VIEW-AS TEXT
      184        SIZE 15.38 BY .79.
      185   DEFINE VARIABLE point-io-name AS CHARACTER FORMAT "X(56)":U
      186        VIEW-AS FILL-IN
      187        SIZE 35 BY 1 NO-UNDO.
      188   DEFINE VARIABLE inn AS CHARACTER FORMAT "X(15)"
      189        LABEL ""
      190         VIEW-AS TEXT
      191        SIZE 28.25 BY .79.
      192   DEFINE VARIABLE kpp AS CHARACTER FORMAT "X(15)"
      193        LABEL ""
      194         VIEW-AS TEXT
      195        SIZE 28.25 BY .79.
      196   DEFINE VARIABLE name AS CHARACTER FORMAT "X(40)"
      197        LABEL "Наименование"
      198         VIEW-AS TEXT
      199        SIZE 41 BY .79.
      200   DEFINE VARIABLE r-schet AS CHARACTER FORMAT "X(20)"
      201        LABEL "Рас.счет"
      202         VIEW-AS TEXT
      203        SIZE 27.5 BY .79.
      204   DEFINE VARIABLE r-schet-2 AS CHARACTER FORMAT "X(20)"
      205        LABEL "Р/C"
      206         VIEW-AS TEXT
      207        SIZE 24.13 BY .79.
      208   DEFINE VARIABLE sign AS CHARACTER FORMAT "X(20)"
      209        LABEL "ФИО"
      210        VIEW-AS FILL-IN
      211        SIZE 26.5 BY 1.
      212   DEFINE VARIABLE sign-post AS CHARACTER FORMAT "X(20)"
      213        LABEL "Должность"
      214        VIEW-AS FILL-IN
      215        SIZE 24.63 BY 1.
      216   DEFINE VARIABLE point-io-code AS INTEGER FORMAT "99999" INITIAL 0
      217        LABEL "Пункт отгрузки/доставки"
      218        VIEW-AS FILL-IN
      219        SIZE 6.75 BY 1 NO-UNDO.
      220   DEFINE RECTANGLE RECT-2
      221        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      222        SIZE 68.88 BY 3.63.
      223   DEFINE RECTANGLE RECT-3
      224        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      225        SIZE 69 BY 2.79.
      226   DEFINE FRAME Dialog-Frame
      227        b-OK AT ROW 1.04 COL 2
      228        b-exit AT ROW 1.04 COL 12
      229        b-add AT ROW 1.04 COL 22.13
      230        B-Help AT ROW 1.08 COL 60
      231        b-bank AT ROW 5.79 COL 60
      232        b-bank-2 AT ROW 9.79 COL 60
      233        sign-post AT ROW 12.5 COL 10.88 COLON-ALIGNED
      234        sign AT ROW 12.5 COL 42.5 COLON-ALIGNED
      235        point-io-code AT ROW 13.88 COL 24.88 COLON-ALIGNED
      236        BUTTON-point-io AT ROW 13.88 COL 33.38
      237        point-io-name AT ROW 13.88 COL 34 COLON-ALIGNED NO-LABEL
      238        name AT ROW 2.08 COL 14 COLON-ALIGNED
      239        inn AT ROW 3.21 COL 5.5 COLON-ALIGNED
      240        kpp AT ROW 3.21 COL 40.25 COLON-ALIGNED
      241        addres AT ROW 4.29 COL 2.38
      242        bank-name AT ROW 6 COL 7.13 COLON-ALIGNED
      243        bik AT ROW 7 COL 6.13 COLON-ALIGNED
      244        r-schet AT ROW 7 COL 40.5 COLON-ALIGNED
      245        c-schet AT ROW 8 COL 11.5 COLON-ALIGNED
      246        curr AT ROW 8 COL 52.5 COLON-ALIGNED
      247        r-schet-2 AT ROW 10 COL 5.25 COLON-ALIGNED
      248        curr-2 AT ROW 10 COL 41 COLON-ALIGNED
      249        bank-name-2 AT ROW 11 COL 9.5 COLON-ALIGNED
      250        "Реквизиты договора" VIEW-AS TEXT
      251             SIZE 18.25 BY .92 AT ROW 5 COL 26.63
      252             FGCOLOR 4
      253        "Текущий счет" VIEW-AS TEXT
      254             SIZE 12.88 BY .92 AT ROW 9 COL 29.38
      255             FGCOLOR 4
      256        RECT-2 AT ROW 5.42 COL 1.88
      257        RECT-3 AT ROW 9.42 COL 1.75
      258        SPACE(0.74) SKIP(2.99)
      259       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      260            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      261            TITLE "Реквизиты".
      262   ASSIGN
      263          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      264          FRAME Dialog-Frame:HIDDEN           = TRUE.
      265   ASSIGN
      266          point-io-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      267   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      268   DO:
      269     APPLY "END-ERROR":U TO SELF.
      270   END.
      271   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      272   DO:
      273     find first ub.clients no-lock where ub.clients.obj-type = p-obj-type and ub.clients.obj-code = p-obj-code no-error .
      274     if p-obj-type = 'орг':U then do:
      275       if p-host-code = p-obj-code then do:
      276         define buffer buf_sysconf for ub.sysconf .
      277         find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code .
      278         assign
      279           sign-post = buf_sysconf.pay-sign-post
      280           sign      = buf_sysconf.pay-sign
      281         .
      282       end.
      283       find first ub.firm no-lock where ub.firm.firm-code = p-obj-code no-error.
      284       if available ub.firm then assign    inn = ub.firm.inn    addres = ub.firm.addres1       kpp = ub.firm.kpp .
      285     end.
      286     else do:
      287       find first ub.person no-lock where ub.person.psn-code = p-obj-code no-error.
      288       if available ub.person then   assign   inn = ub.person.inn   addres = ub.person.address    kpp = ub.person.kpp .
      289     end.
      290     assign name = ub.clients.obj-name .
      291     display name inn addres kpp sign sign-post with frame Dialog-Frame.
      292   END.
      293   ON CHOOSE OF b-bank IN FRAME Dialog-Frame
      294   DO:
      295     find first ub.clients no-lock where ub.clients.obj-type = p-obj-type and ub.clients.obj-code = p-obj-code no-error .
      296     if not available ub.clients then return.
      297     define variable rid-list as  char no-undo .
      298     define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
      299     if ri-schet <> ? then assign rid-list = string(ri-schet) .
      300     run ref/finschts.w (input parParentProc, input p-host-code, input "b-sel,b-add", input "cmp-host", input p-obj-type,
      301                    input p-obj-code, input 0, input p-host-code, input 0, input-output v-status_, input-output rid-list).
      302     if rid-list <> "" then do:
      303       find first ub.fin-schet no-lock where RECID(fin-schet) = int (rid-list) no-error .
      304       if available ub.fin-schet then do:
      305         if ub.fin-schet.status_ = 'удал':U then message "Вы выбрали удаленный счет!"  view-as alert-box.
      306         find first ub.fin-bank no-lock where ub.fin-bank.host-code = ub.fin-schet.host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
      307         find first ub.currency no-lock where ub.currency.curr-code = ub.fin-schet.curr-code .
      308         assign
      309           ri-schet   = int (rid-list)
      310           p-code-schet = ub.fin-schet.code-schet
      311           bank-name  = ub.fin-bank.short-name
      312           bik        = ub.fin-bank.bik
      313           c-schet    = ub.fin-schet.c-schet
      314           r-schet    = ub.fin-schet.r-schet
      315           curr       = ub.currency.curr-abbr
      316         .
      317       end.
      318     end.
      319     else assign  ri-schet = ?  p-code-schet = ?  bank-name = ""    bik = ""  c-schet = ""   r-schet = "" curr = "" .
      320     display bank-name bik c-schet r-schet curr with frame Dialog-Frame.
      321   END.
      322   ON CHOOSE OF b-bank-2 IN FRAME Dialog-Frame
      323   DO:
      324     find first ub.clients no-lock where ub.clients.obj-type = p-obj-type and ub.clients.obj-code = p-obj-code no-error .
      325     if not available ub.clients then return.
      326     define variable rid-list as  char no-undo .
      327     define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
      328     if ri-schet-2 <> ? then
      329     assign rid-list = string(ri-schet-2) .
      330     run ref/finschts.w (input parParentProc, input p-host-code, input "b-sel,b-add", input "cmp-host", input p-obj-type,
      331                    input p-obj-code, input 0, input p-host-code, input 0, input-output v-status_, input-output rid-list).
      332     if rid-list <> "" then do:
      333       find first ub.fin-schet no-lock where RECID(fin-schet) = int (rid-list) no-error .
      334       if available ub.fin-schet then do:
      335         if ub.fin-schet.status_ = 'удал':U then message "Вы выбрали удаленный счет!"  view-as alert-box.
      336         find first ub.fin-bank no-lock where ub.fin-bank.host-code = ub.fin-schet.host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
      337         find first ub.currency no-lock where ub.currency.curr-code = ub.fin-schet.curr-code .
      338         assign
      339           ri-schet-2   = int (rid-list)
      340           p-code-schet-2 = ub.fin-schet.code-schet
      341           bank-name-2  = ub.fin-bank.short-name
      342           r-schet-2    = ub.fin-schet.r-schet
      343           curr-2       = ub.currency.curr-abbr
      344         .
      345       end.
      346     end.
      347     else assign  ri-schet-2 = ?  p-code-schet-2 = ?  bank-name-2 = ""   r-schet-2 = "" curr-2 = ""   .
      348     display bank-name-2 curr-2  r-schet-2 with frame Dialog-Frame.
      349   END.
      350   ON CHOOSE OF b-OK IN FRAME Dialog-Frame
      351   DO:
      352     if ref-mode <> 'ПРОСМОТР':U and ref-mode <> "history" then do:
      353       assign inn name addres kpp  sign  sign-post .
      354       assign
      355         p-obj-name  = name
      356         p-kpp       = kpp
      357         p-inn       = inn
      358         p-addres    = addres
      359         p-sign      = sign
      360         p-sign-post = sign-post
      361         p-point-io-code = point-io-code
      362         p-db-num    = v-current-db-num
      363       .
      364     end.
      365   END.
      366   ON CHOOSE OF BUTTON-point-io IN FRAME Dialog-Frame
      367   DO:
      368     define variable ri-list as character no-undo.
      369   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   if lookup(self :type
      371            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      372            ) = 0
      373   then do:
      374     message
      375       "$Workfile$"
      376       "Указанному интерфейсному элементу фокус не может быть передан" skip
      377       "Интерфейсный элемент" self :name  skip
      378       "Тип" self :type  skip
      379       "Процедура" this-procedure :file-name skip
      380       view-as alert-box .
      381   end.
      382   else do:
      383     apply "entry":u to self  .
      384     if focus :handle <> self :handle  then do:
      385       return no-apply .
      386     end.
      387   end.
      388     if available buf_point-io then  assign ri-list = string(recid(buf_point-io)) .
      389     run ref/point-io.w
      390           (input  parparentproc
      391           ,input  "b-add,b-sel"
      392           ,input  v-current-db-num
      393           ,input  p-obj-type
      394           ,input  p-obj-code
      395           ,input  'объект':U
      396           ,input  'all'
      397           ,input-output ri-list
      398           ).
      399     if ri-list <> "":U then do:
      400       FIND FIRST buf_point-io WHERE recid( buf_point-io ) = integer(entry(1, ri-list)) NO-LOCK .
      401       assign
      402         point-io-code = buf_point-io.point-code
      403         point-io-name = buf_point-io.point-name
      404       .
      405     end.
      406     else do:
      407       assign
      408         point-io-code = 0
      409         point-io-name = ""
      410       .
      411     end.
      412     display point-io-code  point-io-name  with frame Dialog-Frame .
      413     apply "CHOOSE"  to sign-post  IN FRAME Dialog-Frame .
      414   END.
      415   ON LEAVE OF point-io-code IN FRAME Dialog-Frame
      416   DO:
      417     assign point-io-code .
      418     if point-io-code > 0 then do:
      419       find first buf_point-io no-lock
      420         where buf_point-io.point-code = point-io-code
      421           and buf_point-io.db-num        = v-current-db-num
      422           and buf_point-io.cli-type      = p-obj-type
      423          and buf_point-io.cli-code      = p-obj-code
      424       no-error .
      425       if available buf_point-io then do:
      426         assign
      427           point-io-code = buf_point-io.point-code
      428           point-io-name = buf_point-io.point-name
      429         .
      430         display point-io-code  point-io-name  with frame Dialog-Frame .
      431       end.
      432       else apply "CHOOSE"  to BUTTON-point-io  IN FRAME Dialog-Frame .
      433     end.
      434   END.
      435   ON RETURN OF point-io-code IN FRAME Dialog-Frame
      436   DO:
      437     assign point-io-code .
      438     find first buf_point-io no-lock
      439       where buf_point-io.point-code = point-io-code
      440         and buf_point-io.db-num  = v-current-db-num
      441         and buf_point-io.cli-type      = p-obj-type
      442         and buf_point-io.cli-code      = p-obj-code
      443     no-error .
      444     if available buf_point-io then do:
      445       assign
      446         point-io-code = buf_point-io.point-code
      447         point-io-name = buf_point-io.point-name
      448       .
      449       display point-io-code  point-io-name  with frame Dialog-Frame .
      450     end.
      451     else apply "CHOOSE"  to BUTTON-point-io  IN FRAME Dialog-Frame .
      452   END.
      453   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      454   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      455   MAIN-BLOCK:
      456   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      457      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      458   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   on help of frame Dialog-Frame
      460   do:
      461     run gbl/app_help.p
      462       (input this-procedure :file-name
      463       ,input ''
      464       ,input ?
      465       ) no-error.
      466     if error-status :error then do:
      467       message
      468         "Ошибка при вызове помощи"
      469         error-status :get-message(1)
      470         view-as alert-box .
      471     end.
      472   end.
      473   run minbtn-set in this-procedure .
      474   on choose of b-help in frame Dialog-Frame
      475   do:
      476     apply "help":u to frame Dialog-Frame .
      477   end.
      478   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure minbtn-set :
      480       do
      481           on error undo, return error return-value
      482           :
      483           define variable ii              as integer       no-undo .
      484           define variable fh              as widget-handle no-undo .
      485           define variable hh              as widget-handle no-undo .
      486           define variable v-h             as handle        extent 4 no-undo .
      487           define variable v-name-button   as character     no-undo .
      488           define variable v-help-old-x    as decimal       no-undo .
      489           define variable v-help-old-y    as decimal       no-undo .
      490           define variable v-help-old-size as decimal       no-undo .
      491           define variable v-frame-width   as decimal       no-undo .
      492           define variable jj              as integer       no-undo .
      493           do
      494               on error undo, return error
      495               :
      496               assign
      497                   v-frame-width = frame Dialog-Frame:width - 0.3
      498                   fh            = frame Dialog-Frame:first-child
      499                   hh            = fh:first-child
      500                   ii            = 1
      501                   .
      502               do while valid-handle(hh):
      503                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      504                   do:
      505                       case lc(hh:name) :
      506                           when "b-help" then
      507                               do:
      508                                   hh:load-image-up("cmp/b-help.bmp":u) .
      509                                   hh:load-image-down("cmp/b-help.bmp":u) .
      510                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      511                                   hh:TOOLTIP = "Помощь" .
      512                                   v-help-old-x = hh:column .
      513                                   v-help-old-y = hh:row    .
      514                                   v-help-old-size = hh:width .
      515                                   hh:width-chars = 2.5 .
      516                               end.
      517                           when "b-print" then
      518                               do:
      519                                   hh:load-image("cmp/b-print.bmp":u) .
      520                                   hh:TOOLTIP = "Печать" .
      521                                   v-h[ii] = hh:handle .
      522                                   ii = ii + 1 .
      523                                   hh:width-chars = 3 .
      524                               end.
      525                           when "b-history" or
      526                           when "b-hist" then
      527                               do:
      528                                   hh:load-image("cmp/b-hist.bmp":u) .
      529                                   hh:TOOLTIP = "История" .
      530                                   v-h[ii] = hh:handle .
      531                                   ii = ii + 1 .
      532                                   hh:width-chars = 3 .
      533                               end.
      534                           when "b-sch" then
      535                               do:
      536                                   hh:load-image("cmp/b-sch.bmp":u) .
      537                                   hh:TOOLTIP = "Установка Фильтра" .
      538                                   v-h[ii] = hh:handle .
      539                                   ii = ii + 1 .
      540                                   hh:width-chars = 3 .
      541                               end.
      542                           when "b-hist-user" then
      543                               do:
      544                                   hh:load-image("cmp/b-hist.bmp":u) .
      545                                   hh:TOOLTIP = "История пользователя" .
      546                                   ii = ii + 1 .
      547                               end.
      548                       end case.
      549                   end.
      550                   hh = hh:next-sibling.
      551               end.
      552               b-help:column = v-frame-width - b-help:width-chars.
      553               jj = 0.
      554               repeat ii = 4 to 1 by -1 :
      555                   if valid-handle (v-h[ii] ) then
      556                   do:
      557                       jj  = jj + 1 .
      558                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      559                       v-h[ii]:row    = v-help-old-y .
      560                   end.
      561               end.
      562           end.
      563       end.
      564   end procedure.
      565   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      567     (output v-current-db-num
      568     )  .
      569     ASSIGN inn :LABEL IN FRAME Dialog-Frame = "ИНН"
      570            kpp :LABEL IN FRAME Dialog-Frame = "КПП".
      571     RUN enable_UI.
      572     run go-proc no-error.
      573     if error-status:error then return no-apply.
      574     WAIT-FOR GO OF FRAME Dialog-Frame.
      575   END.
      576   RUN disable_UI.
      577   PROCEDURE disable_UI :
      578     HIDE FRAME Dialog-Frame.
      579   END PROCEDURE.
      580   PROCEDURE enable_UI :
      581     DISPLAY sign-post sign point-io-code point-io-name name inn kpp addres bank-name
      582             bik r-schet c-schet curr r-schet-2 curr-2 bank-name-2
      583         WITH FRAME Dialog-Frame.
      584     ENABLE b-OK b-exit b-add B-Help RECT-2 RECT-3 b-bank b-bank-2 sign-post sign
      585            point-io-code BUTTON-point-io point-io-name name kpp bank-name bik r-schet
      586            c-schet curr r-schet-2 curr-2 bank-name-2
      587         WITH FRAME Dialog-Frame.
      588     VIEW FRAME Dialog-Frame.
      589   END PROCEDURE.
      590   PROCEDURE go-proc :
      591     find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = p-code-schet no-error .
      592     if available ub.fin-schet then do:
      593       find first ub.currency no-lock where ub.currency.curr-code = ub.fin-schet.curr-code .
      594       find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
      595       assign
      596         ri-schet   = recid (fin-schet)
      597         bank-name  = ub.fin-bank.short-name
      598         bik        = ub.fin-bank.bik
      599         name       = p-obj-name
      600         c-schet    = ub.fin-schet.c-schet
      601         r-schet    = ub.fin-schet.r-schet
      602         curr       = ub.currency.curr-abbr
      603       .
      604     end.
      605     else assign  ri-schet = ?  p-code-schet = ?  bank-name = ""    bik = ""  c-schet = ""   r-schet = "" curr = "" .
      606     display bank-name kpp bik c-schet r-schet curr with frame Dialog-Frame.
      607     find first ub.fin-schet no-lock where ub.fin-schet.host-code = p-host-code and ub.fin-schet.code-schet = p-code-schet-2 no-error .
      608     if available ub.fin-schet then do:
      609       find first ub.currency no-lock where ub.currency.curr-code = ub.fin-schet.curr-code .
      610       find first ub.fin-bank no-lock where ub.fin-bank.host-code = p-host-code and ub.fin-bank.code-bank = ub.fin-schet.code-bank no-error .
      611       assign
      612         ri-schet-2   = recid (fin-schet)
      613         p-code-schet-2 = ub.fin-schet.code-schet
      614         bank-name-2  = ub.fin-bank.short-name
      615         r-schet-2    = ub.fin-schet.r-schet
      616         curr-2       = ub.currency.curr-abbr
      617       .
      618     end.
      619     else assign  ri-schet-2 = ?  p-code-schet-2 = ?  bank-name-2 = ""   r-schet-2 = ""  curr-2 = "" .
      620     display bank-name-2  r-schet-2  curr-2  with frame Dialog-Frame.
      621     define variable str      as character no-undo .
      622     find first ub.clients no-lock where ub.clients.obj-type = p-obj-type and ub.clients.obj-code = p-obj-code no-error .
      623     case p-type :
      624       when 0 then do:
      625         assign str = "Реквизиты фирмы "       + p-obj-name + " код " + string(p-obj-code) .
      626       end.
      627       when 1 then do:
      628         assign str = "Реквизиты контрагента " + p-obj-name + " (" + p-obj-type + " " + string(p-obj-code) + ")" .
      629       end.
      630       when 2 then do:
      631         assign str = "Реквизиты посредника "  + p-obj-name + " (" + p-obj-type + " " + string(p-obj-code) + ")" .
      632       end.
      633       when 3 then do:
      634         assign str = "Реквизиты агента "      + p-obj-name + " (" + p-obj-type + " " + string(p-obj-code) + ")" .
      635       end.
      636     end.
      637     ASSIGN frame Dialog-Frame:TITLE = str.
      638     if ref-mode = 'ПРОСМОТР':U or ref-mode = "history"  then do:
      639       disable b-bank b-bank-2 inn addres sign sign-post b-add point-io-code point-io-name BUTTON-point-io with frame Dialog-Frame.
      640       b-OK:label in frame Dialog-Frame = "&Выход " .
      641       b-exit:visible = no .
      642     end.
      643     if ref-mode = 'ИЗМЕНЕНИЕ':U then do:
      644       if ri-schet <> ? then disable b-bank with frame Dialog-Frame.
      645     end.
      646     if p-point-io-code > 0 then do:
      647       find first buf_point-io no-lock
      648         where buf_point-io.point-code = p-point-io-code
      649           and buf_point-io.db-num     = v-current-db-num
      650           and buf_point-io.cli-type   = p-obj-type
      651           and buf_point-io.cli-code   = p-obj-code
      652       no-error .
      653     end.
      654     else do:
      655       find first buf_point-io no-lock
      656         where buf_point-io.point-code = p-point-io-code
      657           and buf_point-io.db-num     = v-current-db-num
      658           and buf_point-io.cli-type   = p-obj-type
      659           and buf_point-io.cli-code   = p-obj-code
      660           and buf_point-io.is-default = yes
      661       no-error .
      662     end.
      663     if available buf_point-io then do:
      664       assign
      665         point-io-code = buf_point-io.point-code
      666         point-io-name = buf_point-io.point-name
      667       .
      668       display point-io-code  point-io-name  with frame Dialog-Frame .
      669     end.
      670     assign
      671       name      = p-obj-name
      672       inn       = p-inn
      673       addres    = p-addres
      674       sign      = p-sign
      675       sign-post = p-sign-post
      676       kpp       = p-kpp
      677     .
      678     display sign-post sign point-io-code point-io-name name inn kpp addres bank-name bik r-schet c-schet curr r-schet-2 curr-2 bank-name-2 with frame Dialog-Frame.
      679   END PROCEDURE.
