        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: scnblstr.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: str/scnblstr.p $":U .
       10   define variable vss-description as character no-undo initial "‘ормирование списка бар-кодов и ƒопЅк с количествами".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   def  new shared  temp-table scnblist no-undo like ub.goods
       82     field b-code as integer
       83     field b-str  as character
       84     field f-name like ub.gds-prt.f-name
       85     field bc-cli-base-rate like ub.bar-code.cli-base-rate
       86     field bc-cr-db-num     like ub.bar-code.cr-db-num
       87     field in-code       like ub.bar-code.in-code
       88     field node-code     like ub.bar-code.node-code
       89     field part-code     like ub.bar-code.part-code
       90     field stts_         like ub.bar-code.stts_
       91     field bc-unit-cli      like ub.bar-code.unit-cli
       92     field bc-on-type    like ub.prod-bc.bc-on-type
       93     field bc-on         like ub.prod-bc.bc-on
       94     field pbc-cr-db-num     like ub.prod-bc.cr-db-num
       95     field qnty   as decimal
       96     field to-del as logical
       97     field order-num as integer
       98     field loc-ean as logical
       99     index pi  is primary unique b-code b-str
      100     index art artic prod-type prod-code
      101     index code gds-code
      102     index oi order-num
      103     index ibc-on-type bc-on-type
      104     index iprt
      105     gds-code
      106     node-code
      107     part-code
      108     in-code
      109     unit-cli
      110     b-str
      111     index iprt2
      112     gds-code
      113     node-code
      114     unit-cli
      115     part-code
      116     in-code
      117     b-str
      118     .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define   new shared   temp-table scnblist-hist no-undo
      121   field list-table as character
      122   field id as integer
      123   field line as integer
      124   field hist-mode as character
      125   field des as character
      126   field num-recs as integer
      127   field option_ as character
      128   field item_ as character
      129   field status_ as character
      130   field num-add as integer
      131   field num-ignored as integer
      132   field done as logical
      133   field err_ as logical
      134   field err-mes as character
      135   index pi is primary
      136   id
      137   line
      138   index isdone
      139   done
      140   .
      141   run str/scnblist.w (
      142                      input parparentproc
      143                     ,input p-curr-obj-type
      144                     ,input p-curr-obj-code
      145                     ,input ''
      146                     ).
