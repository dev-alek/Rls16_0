        1   define temp-table tt-table no-undo
        2   field f1 as character format "x(10)"
        3   field f2 as character format "x(80)"
        4   field f3 as character format "x(80)"
        5   field f4 as character format "x(80)"
        6   .
        7   define input  parameter table for tt-table .
        8   define input  parameter p-title as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Просмотр временной таблицы ".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   DEFINE BUTTON B-exit AUTO-END-KEY
      119        LABEL "Выход"
      120        SIZE 12 BY 1.
      121   DEFINE BUTTON B-Help
      122        LABEL "Помощь"
      123        SIZE 12 BY 1
      124        BGCOLOR 8 .
      125   DEFINE QUERY BROWSE-4 FOR
      126         tt-table SCROLLING.
      127   DEFINE BROWSE BROWSE-4
      128     QUERY BROWSE-4 DISPLAY
      129         tt-table.f1
      130   tt-table.f2
      131   tt-table.f3
      132   tt-table.f4
      133       WITH NO-ROW-MARKERS SEPARATORS SIZE 64.13 BY 15 EXPANDABLE.
      134   DEFINE FRAME Dialog-Frame
      135        B-exit AT ROW 1 COL 1
      136        B-Help AT ROW 1 COL 52.5
      137        BROWSE-4 AT ROW 2 COL 1
      138        SPACE(0.00) SKIP(0.16)
      139       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      140            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      141            TITLE "Просмотр ТТ"
      142            CANCEL-BUTTON B-exit.
      143   ASSIGN
      144          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      145          FRAME Dialog-Frame:HIDDEN           = TRUE.
      146   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      147   DO:
      148     APPLY "END-ERROR":U TO SELF.
      149   END.
      150   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      151   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      152   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   on help of frame Dialog-Frame
      154   do:
      155     run gbl/app_help.p
      156       (input this-procedure :file-name
      157       ,input ''
      158       ,input ?
      159       ) no-error.
      160     if error-status :error then do:
      161       message
      162         "Ошибка при вызове помощи"
      163         error-status :get-message(1)
      164         view-as alert-box .
      165     end.
      166   end.
      167   run minbtn-set in this-procedure .
      168   on choose of b-help in frame Dialog-Frame
      169   do:
      170     apply "help":u to frame Dialog-Frame .
      171   end.
      172   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   procedure minbtn-set :
      174       do
      175           on error undo, return error return-value
      176           :
      177           define variable ii              as integer       no-undo .
      178           define variable fh              as widget-handle no-undo .
      179           define variable hh              as widget-handle no-undo .
      180           define variable v-h             as handle        extent 4 no-undo .
      181           define variable v-name-button   as character     no-undo .
      182           define variable v-help-old-x    as decimal       no-undo .
      183           define variable v-help-old-y    as decimal       no-undo .
      184           define variable v-help-old-size as decimal       no-undo .
      185           define variable v-frame-width   as decimal       no-undo .
      186           define variable jj              as integer       no-undo .
      187           do
      188               on error undo, return error
      189               :
      190               assign
      191                   v-frame-width = frame Dialog-Frame:width - 0.3
      192                   fh            = frame Dialog-Frame:first-child
      193                   hh            = fh:first-child
      194                   ii            = 1
      195                   .
      196               do while valid-handle(hh):
      197                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      198                   do:
      199                       case lc(hh:name) :
      200                           when "b-help" then
      201                               do:
      202                                   hh:load-image-up("cmp/b-help.bmp":u) .
      203                                   hh:load-image-down("cmp/b-help.bmp":u) .
      204                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      205                                   hh:TOOLTIP = "Помощь" .
      206                                   v-help-old-x = hh:column .
      207                                   v-help-old-y = hh:row    .
      208                                   v-help-old-size = hh:width .
      209                                   hh:width-chars = 2.5 .
      210                               end.
      211                           when "b-print" then
      212                               do:
      213                                   hh:load-image("cmp/b-print.bmp":u) .
      214                                   hh:TOOLTIP = "Печать" .
      215                                   v-h[ii] = hh:handle .
      216                                   ii = ii + 1 .
      217                                   hh:width-chars = 3 .
      218                               end.
      219                           when "b-history" or
      220                           when "b-hist" then
      221                               do:
      222                                   hh:load-image("cmp/b-hist.bmp":u) .
      223                                   hh:TOOLTIP = "История" .
      224                                   v-h[ii] = hh:handle .
      225                                   ii = ii + 1 .
      226                                   hh:width-chars = 3 .
      227                               end.
      228                           when "b-sch" then
      229                               do:
      230                                   hh:load-image("cmp/b-sch.bmp":u) .
      231                                   hh:TOOLTIP = "Установка Фильтра" .
      232                                   v-h[ii] = hh:handle .
      233                                   ii = ii + 1 .
      234                                   hh:width-chars = 3 .
      235                               end.
      236                           when "b-hist-user" then
      237                               do:
      238                                   hh:load-image("cmp/b-hist.bmp":u) .
      239                                   hh:TOOLTIP = "История пользователя" .
      240                                   ii = ii + 1 .
      241                               end.
      242                       end case.
      243                   end.
      244                   hh = hh:next-sibling.
      245               end.
      246               b-help:column = v-frame-width - b-help:width-chars.
      247               jj = 0.
      248               repeat ii = 4 to 1 by -1 :
      249                   if valid-handle (v-h[ii] ) then
      250                   do:
      251                       jj  = jj + 1 .
      252                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      253                       v-h[ii]:row    = v-help-old-y .
      254                   end.
      255               end.
      256           end.
      257       end.
      258   end procedure.
      259   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      260   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      261   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      262   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      263   define variable v-diasize-current-frame-width  as decimal   no-undo .
      264   define variable v-diasize-current-frame-height as decimal   no-undo .
      265   define variable v-diasize-change-size          as logical   no-undo .
      266   define variable v-diasize-resize-button        as handle    no-undo .
      267   define variable v-diasize-wndmax               as logical   no-undo .
      268   define variable v-diasize-wndstore             as logical   no-undo .
      269   define variable v-diasize-proc-name            as character no-undo .
      270   define variable v-diasize-browse-handle        as handle    no-undo .
      271   define variable v-diasize-browse-number        as integer   no-undo .
      272   define variable v-diasize-need-full-display    as logical   no-undo init false .
      273   define temp-table temp-diasize-handle no-undo
      274     field handle-value  as handle
      275     field save-position as decimal
      276     index xpk is primary unique handle-value
      277     .
      278   define temp-table temp-browse-handle no-undo
      279     field browse-type   as character
      280     field browse-number as integer
      281     field browse-handle as handle
      282     field original-size as decimal
      283     index xpk is primary unique browse-type browse-number
      284     index xie browse-type browse-handle
      285   .
      286   procedure diasize_change-height :
      287     define input  parameter p-change-value  as decimal   no-undo .
      288     define input  parameter p-move-resize   as logical   no-undo .
      289     define variable v-field-group-handle    as handle    no-undo .
      290     define variable v-object-handle         as handle    no-undo .
      291     define variable v-frame-height          as decimal   no-undo .
      292     define variable v-frame-virtual-height  as decimal   no-undo .
      293     define variable v-browse-height         as decimal   no-undo .
      294     define variable v-window-height         as decimal   no-undo .
      295     define variable v-window-virtual-height as decimal   no-undo .
      296     define variable v-change-sign           as integer   no-undo .
      297     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      298     define buffer buf_temp-browse-handle  for temp-browse-handle .
      299     if p-change-value > 0
      300     then do:
      301       if frame Dialog-Frame :height + p-change-value
      302           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      303       then do:
      304         assign
      305           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      306                           - (frame Dialog-Frame :height-chars)
      307         .
      308         if p-change-value <= 0
      309         then do:
      310           run diasize_position-resize-button in this-procedure .
      311           return .
      312         end.
      313       end.
      314     end.
      315     if p-change-value < 0
      316     then do:
      317       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      318       then do:
      319         assign
      320           p-change-value = v-diasize-orig-frame-height
      321                          - (frame Dialog-Frame :height-chars)
      322         .
      323         if p-change-value >= 0
      324         then do:
      325           run diasize_position-resize-button in this-procedure .
      326           return .
      327         end.
      328       end.
      329     end.
      330     if p-change-value >= 0
      331     then do:
      332       assign
      333         v-change-sign = 1
      334       .
      335     end.
      336     else do:
      337       assign
      338         v-change-sign = -1
      339       .
      340     end.
      341     assign
      342       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      343     .
      344     if p-change-value = 0
      345     then do:
      346       run diasize_position-resize-button in this-procedure .
      347       return .
      348     end.
      349     move_block:
      350     do
      351     on error undo move_block, retry move_block
      352     :
      353       if retry
      354       then do:
      355         do
      356         on error undo move_block, leave move_block
      357         :
      358           if p-change-value > 0
      359           then do:
      360             for each buf_temp-diasize-handle
      361             on error undo, next
      362             :
      363               assign
      364                 v-object-handle = buf_temp-diasize-handle.handle-value
      365               .
      366               if v-object-handle <> v-diasize-resize-button
      367               then do:
      368                 assign
      369                   v-object-handle :row = buf_temp-diasize-handle.save-position
      370                 .
      371               end.
      372             end.
      373             assign
      374               v-diasize-browse-handle :height = v-browse-height
      375             .
      376             for each buf_temp-browse-handle
      377               where buf_temp-browse-handle.browse-type = 'height':u
      378             on error undo, next
      379             :
      380               assign
      381                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      382               .
      383             end.
      384             assign
      385               frame Dialog-Frame :height = v-frame-height
      386             .
      387             if frame Dialog-Frame :scrollable = true
      388             then do:
      389               assign
      390                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      391               .
      392             end.
      393             run diasize_position-resize-button in this-procedure .
      394           end.
      395           else do:
      396             if frame Dialog-Frame :scrollable = true
      397             then do:
      398               assign
      399                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      400               .
      401             end.
      402             assign
      403               frame Dialog-Frame :height = v-frame-height
      404             .
      405             assign
      406               v-diasize-browse-handle :height = v-browse-height
      407             .
      408             for each buf_temp-browse-handle
      409               where buf_temp-browse-handle.browse-type = 'height':u
      410             on error undo, next
      411             :
      412               assign
      413                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      414               .
      415             end.
      416             for each buf_temp-diasize-handle
      417             on error undo, next
      418             :
      419               assign
      420                 v-object-handle = buf_temp-diasize-handle.handle-value
      421               .
      422               if v-object-handle <> v-diasize-resize-button
      423               then do:
      424                 assign
      425                   v-object-handle :row = buf_temp-diasize-handle.save-position
      426                 .
      427               end.
      428             end.
      429             run diasize_position-resize-button in this-procedure .
      430           end.
      431           assign
      432             v-diasize-change-size = false
      433           .
      434           leave move_block .
      435         end.
      436       end.
      437       assign
      438         v-diasize-need-full-display = true
      439       .
      440       if v-diasize-change-size = false
      441       then do:
      442         assign
      443           v-diasize-change-size = true
      444         .
      445       end.
      446       else do:
      447         return .
      448       end.
      449       assign
      450         v-frame-height = frame Dialog-Frame :height
      451         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      452         v-browse-height = v-diasize-browse-handle :height
      453       .
      454       for each buf_temp-browse-handle
      455         where buf_temp-browse-handle.browse-type = 'height':u
      456       :
      457         assign
      458           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      459         .
      460       end.
      461       for each buf_temp-diasize-handle
      462       :
      463         delete buf_temp-diasize-handle .
      464       end.
      465       assign
      466         v-field-group-handle = frame Dialog-Frame :first-child
      467       .
      468       do while valid-handle(v-field-group-handle)
      469       :
      470         assign
      471           v-object-handle = v-field-group-handle :first-child
      472         .
      473         do while valid-handle(v-object-handle)
      474         :
      475           if  v-object-handle <> v-diasize-browse-handle :handle
      476           and can-query(v-object-handle, "row")
      477           and can-query(v-object-handle, "height")
      478           and ( v-object-handle :row > v-diasize-browse-handle :row )
      479           then do:
      480             find first buf_temp-browse-handle
      481               where buf_temp-browse-handle.browse-type   = 'height':u
      482                 and buf_temp-browse-handle.browse-handle = v-object-handle
      483               no-error .
      484             if available buf_temp-browse-handle
      485             then do:
      486             end.
      487             else do:
      488               create buf_temp-diasize-handle .
      489               assign
      490                 buf_temp-diasize-handle.handle-value  = v-object-handle
      491                 buf_temp-diasize-handle.save-position = v-object-handle :row
      492               .
      493             end.
      494           end.
      495           assign
      496             v-object-handle = v-object-handle :next-sibling
      497           .
      498         end.
      499         assign
      500           v-field-group-handle = v-field-group-handle :next-sibling
      501         .
      502       end.
      503       do with frame Dialog-Frame
      504       :
      505         hide v-diasize-resize-button .
      506         assign
      507           v-diasize-resize-button :row    = 1
      508           v-diasize-resize-button :column = 1
      509         .
      510       end.
      511       if p-change-value > 0
      512       then do:
      513         if frame Dialog-Frame :scrollable = true
      514         then do:
      515           assign
      516             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      517             no-error .
      518           if error-status :error
      519           or error-status :get-message(1) <> ""
      520           then do:
      521             undo move_block, retry move_block .
      522           end.
      523         end.
      524         assign
      525           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      526           no-error .
      527         if error-status :error
      528         or error-status :get-message(1) <> ""
      529         then do:
      530           undo move_block, retry move_block .
      531         end.
      532         assign
      533           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      534           no-error .
      535         if error-status :error
      536         or error-status :get-message(1) <> ""
      537         then do:
      538           undo move_block, retry move_block .
      539         end.
      540         for each buf_temp-browse-handle
      541           where buf_temp-browse-handle.browse-type = 'height':u
      542         on error undo move_block, retry move_block
      543         :
      544           assign
      545             buf_temp-browse-handle.browse-handle :height
      546               = buf_temp-browse-handle.browse-handle :height + p-change-value
      547             no-error .
      548           if error-status :error
      549           or error-status :get-message(1) <> ""
      550           then do:
      551             undo move_block, retry move_block .
      552           end.
      553         end.
      554         for each buf_temp-diasize-handle
      555         on error undo move_block, retry move_block
      556         :
      557           assign
      558             v-object-handle = buf_temp-diasize-handle.handle-value
      559           .
      560           if v-object-handle <> v-diasize-resize-button
      561           then do:
      562             assign
      563               v-object-handle :row = v-object-handle :row + p-change-value
      564               no-error .
      565             if error-status :error
      566             or error-status :get-message(1) <> ""
      567             then do:
      568               undo move_block, retry move_block .
      569             end.
      570           end.
      571         end.
      572       end.
      573       else do:
      574         for each buf_temp-diasize-handle
      575         on error undo move_block, retry move_block
      576         :
      577           assign
      578             v-object-handle = buf_temp-diasize-handle.handle-value
      579           .
      580           if v-object-handle <> v-diasize-resize-button
      581           then do:
      582             assign
      583               v-object-handle :row = v-object-handle :row + p-change-value
      584               no-error .
      585             if error-status :error
      586             or error-status :get-message(1) <> ""
      587             then do:
      588               undo move_block, retry move_block .
      589             end.
      590           end.
      591         end.
      592         assign
      593           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      594           no-error .
      595         if error-status :error
      596         or error-status :get-message(1) <> ""
      597         then do:
      598           undo move_block, retry move_block .
      599         end.
      600         for each buf_temp-browse-handle
      601           where buf_temp-browse-handle.browse-type = 'height':u
      602         on error undo move_block, retry move_block
      603         :
      604           assign
      605             buf_temp-browse-handle.browse-handle :height
      606               = buf_temp-browse-handle.browse-handle :height + p-change-value
      607             no-error .
      608           if error-status :error
      609           or error-status :get-message(1) <> ""
      610           then do:
      611             undo move_block, retry move_block .
      612           end.
      613         end.
      614         assign
      615           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      616           no-error .
      617         if error-status :error
      618         or error-status :get-message(1) <> ""
      619         then do:
      620           undo move_block, retry move_block .
      621         end.
      622         if frame Dialog-Frame :scrollable = true
      623         then do:
      624           assign
      625             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      626             no-error .
      627           if error-status :error
      628           or error-status :get-message(1) <> ""
      629           then do:
      630             undo move_block, retry move_block .
      631           end.
      632         end.
      633       end.
      634       if p-move-resize = true
      635       then do:
      636         run diasize_position-resize-button in this-procedure .
      637       end.
      638       if v-diasize-wndstore = true
      639       then do:
      640         if connected("ub") = true
      641         then do:
      642           define variable v-cntxt-db-num        as integer   no-undo .
      643           define variable v-cntxt-userid        as character no-undo .
      644           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      645                                             , OUTPUT v-cntxt-userid
      646                                             ) .
      647           run gbl/wndsizew.p
      648             (input  v-cntxt-db-num
      649             ,input  v-cntxt-userid
      650             ,input  v-diasize-proc-name
      651             ,input  'height':u
      652             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      653             ) .
      654         end.
      655       end.
      656     end.
      657     assign
      658       v-diasize-change-size = false
      659     .
      660   end procedure.
      661   procedure diasize_set-height :
      662     define input  parameter p-new-height  as decimal   no-undo .
      663     define input  parameter p-move-resize as logical   no-undo .
      664     do
      665     on error undo, return error return-value
      666     :
      667       run diasize_change-height in this-procedure
      668         (input  (p-new-height - frame Dialog-Frame :height)
      669         ,input  p-move-resize
      670         ) .
      671     end.
      672   end procedure.
      673   procedure diasize_change-width :
      674     define input  parameter p-change-value as decimal   no-undo .
      675     define input  parameter p-move-resize  as logical   no-undo .
      676     define variable v-field-group-handle   as handle    no-undo .
      677     define variable v-object-handle        as handle    no-undo .
      678     define variable v-frame-width          as decimal   no-undo .
      679     define variable v-frame-virtual-width  as decimal   no-undo .
      680     define variable v-browse-width         as decimal   no-undo .
      681     define variable v-window-width         as decimal   no-undo .
      682     define variable v-window-virtual-width as decimal   no-undo .
      683     define variable v-change-sign          as integer   no-undo .
      684     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      685     define buffer buf_temp-browse-handle  for temp-browse-handle .
      686     if p-change-value > 0
      687     then do:
      688       if frame Dialog-Frame :width + p-change-value >
      689           session :width-chars
      690       then do:
      691         assign
      692           p-change-value = session :width-chars - frame Dialog-Frame :width
      693         .
      694         if p-change-value <= 0
      695         then do:
      696           run diasize_position-resize-button in this-procedure .
      697           return .
      698         end.
      699       end.
      700     end.
      701     if p-change-value < 0
      702     then do:
      703       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      704       then do:
      705         assign
      706           p-change-value = v-diasize-orig-frame-width
      707                          - frame Dialog-Frame :width
      708         .
      709         if p-change-value >= 0
      710         then do:
      711           run diasize_position-resize-button in this-procedure .
      712           return .
      713         end.
      714       end.
      715     end.
      716     if p-change-value >= 0
      717     then do:
      718       assign
      719         v-change-sign = 1
      720       .
      721     end.
      722     else do:
      723       assign
      724         v-change-sign = -1
      725       .
      726     end.
      727     assign
      728       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      729     .
      730     if p-change-value = 0
      731     then do:
      732       run diasize_position-resize-button in this-procedure .
      733       return .
      734     end.
      735     move_block:
      736     do
      737     on error undo move_block, leave move_block
      738     :
      739       if retry
      740       then do:
      741         do
      742         on error undo move_block, leave move_block
      743         :
      744           if p-change-value > 0
      745           then do:
      746             for each buf_temp-diasize-handle
      747             on error undo, next
      748             :
      749               assign
      750                 v-object-handle = buf_temp-diasize-handle.handle-value
      751               .
      752               if v-object-handle <> v-diasize-resize-button
      753               then do:
      754                 assign
      755                   v-object-handle :col = buf_temp-diasize-handle.save-position
      756                 .
      757               end.
      758             end.
      759             assign
      760               v-diasize-browse-handle :width = v-browse-width
      761             .
      762             for each buf_temp-browse-handle
      763               where buf_temp-browse-handle.browse-type = 'width':u
      764             on error undo, next
      765             :
      766               assign
      767                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      768               .
      769             end.
      770             assign
      771               frame Dialog-Frame :width = v-frame-width
      772             .
      773             if frame Dialog-Frame :scrollable = true
      774             then do:
      775               assign
      776                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      777               .
      778             end.
      779             run diasize_position-resize-button in this-procedure .
      780           end.
      781           else do:
      782             if frame Dialog-Frame :scrollable = true
      783             then do:
      784               assign
      785                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      786               .
      787             end.
      788             assign
      789               frame Dialog-Frame :width = v-frame-width
      790             .
      791             for each buf_temp-browse-handle
      792               where buf_temp-browse-handle.browse-type = 'width':u
      793             on error undo, next
      794             :
      795               assign
      796                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      797               .
      798             end.
      799             assign
      800               v-diasize-browse-handle :width = v-browse-width
      801             .
      802             for each buf_temp-diasize-handle
      803             on error undo, next
      804             :
      805               assign
      806                 v-object-handle = buf_temp-diasize-handle.handle-value
      807               .
      808               if v-object-handle <> v-diasize-resize-button
      809               then do:
      810                 assign
      811                   v-object-handle :col = buf_temp-diasize-handle.save-position
      812                 .
      813               end.
      814             end.
      815             run diasize_position-resize-button in this-procedure .
      816           end.
      817           assign
      818             v-diasize-change-size = false
      819           .
      820           leave move_block .
      821         end.
      822       end.
      823       assign
      824         v-diasize-need-full-display = true
      825       .
      826       if v-diasize-change-size = false
      827       then do:
      828         assign
      829           v-diasize-change-size = true
      830         .
      831       end.
      832       else do:
      833         return .
      834       end.
      835       assign
      836         v-frame-width = frame Dialog-Frame :width
      837         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      838         v-browse-width = v-diasize-browse-handle :width
      839       .
      840       for each buf_temp-browse-handle
      841         where buf_temp-browse-handle.browse-type = 'width':u
      842       :
      843         assign
      844           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      845         .
      846       end.
      847       for each buf_temp-diasize-handle
      848       :
      849         delete buf_temp-diasize-handle .
      850       end.
      851       assign
      852         v-field-group-handle = frame Dialog-Frame :first-child
      853       .
      854       do while valid-handle(v-field-group-handle)
      855       :
      856         assign
      857           v-object-handle = v-field-group-handle :first-child
      858         .
      859         do while valid-handle(v-object-handle)
      860         :
      861           if  v-object-handle <> v-diasize-browse-handle :handle
      862           and v-object-handle <> v-diasize-resize-button
      863           and can-query(v-object-handle, "row")
      864           and can-query(v-object-handle, "height")
      865           and ( v-object-handle :col + v-object-handle :width
      866                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      867               )
      868           then do:
      869             find first buf_temp-browse-handle
      870               where buf_temp-browse-handle.browse-type   = 'width':u
      871                 and buf_temp-browse-handle.browse-handle = v-object-handle
      872               no-error .
      873             if available buf_temp-browse-handle
      874             then do:
      875             end.
      876             else do:
      877               create buf_temp-diasize-handle .
      878               assign
      879                 buf_temp-diasize-handle.handle-value  = v-object-handle
      880                 buf_temp-diasize-handle.save-position = v-object-handle :col
      881               .
      882             end.
      883           end.
      884           assign
      885             v-object-handle = v-object-handle :next-sibling
      886           .
      887         end.
      888         assign
      889           v-field-group-handle = v-field-group-handle :next-sibling
      890         .
      891       end.
      892       do with frame Dialog-Frame
      893       :
      894         hide v-diasize-resize-button .
      895         v-diasize-resize-button :row = 1.
      896         v-diasize-resize-button :column = 1.
      897       end.
      898       if p-change-value > 0
      899       then do:
      900         if frame Dialog-Frame :scrollable = true
      901         then do:
      902           assign
      903             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      904             no-error .
      905           if error-status :error
      906           or error-status :get-message(1) <> ""
      907           then do:
      908             undo move_block, retry move_block.
      909           end.
      910         end.
      911         assign
      912           frame Dialog-Frame :width = v-frame-width + p-change-value
      913           no-error .
      914         if error-status :error
      915         or error-status :get-message(1) <> ""
      916         then do:
      917           undo move_block, retry move_block.
      918         end.
      919         assign
      920           v-diasize-browse-handle :width = v-browse-width + p-change-value
      921         no-error .
      922         if error-status :error
      923         or error-status :get-message(1) <> ""
      924         then do:
      925           undo move_block, retry move_block.
      926         end.
      927         for each buf_temp-browse-handle
      928           where buf_temp-browse-handle.browse-type = 'width':u
      929         on error undo move_block, retry move_block
      930         :
      931           assign
      932             buf_temp-browse-handle.browse-handle :width
      933               = buf_temp-browse-handle.browse-handle :width + p-change-value
      934             no-error .
      935           if error-status :error
      936           or error-status :get-message(1) <> ""
      937           then do:
      938             undo move_block, retry move_block .
      939           end.
      940         end.
      941         for each buf_temp-diasize-handle
      942         on error undo move_block, retry move_block
      943         :
      944           assign
      945             v-object-handle = buf_temp-diasize-handle.handle-value
      946           .
      947           if v-object-handle <> v-diasize-resize-button
      948           then do:
      949             assign
      950               v-object-handle :col = v-object-handle :col + p-change-value
      951               no-error .
      952             if error-status :error
      953             or error-status :get-message(1) <> ""
      954             then do:
      955               undo move_block, retry move_block .
      956             end.
      957           end.
      958         end.
      959       end.
      960       else do:
      961         for each buf_temp-diasize-handle
      962         on error undo move_block, retry move_block
      963         :
      964           assign
      965             v-object-handle = buf_temp-diasize-handle.handle-value
      966           .
      967           if v-object-handle <> v-diasize-resize-button
      968           then do:
      969             assign
      970               v-object-handle :col = v-object-handle :col + p-change-value
      971               no-error .
      972             if error-status :error
      973             or error-status :get-message(1) <> ""
      974             then do:
      975               undo move_block, retry move_block .
      976             end.
      977           end.
      978         end.
      979         for each buf_temp-browse-handle
      980           where buf_temp-browse-handle.browse-type = 'width':u
      981         on error undo move_block, retry move_block
      982         :
      983           assign
      984             buf_temp-browse-handle.browse-handle :width
      985               = buf_temp-browse-handle.browse-handle :width + p-change-value
      986             no-error .
      987           if error-status :error
      988           or error-status :get-message(1) <> ""
      989           then do:
      990             undo move_block, retry move_block .
      991           end.
      992         end.
      993         assign
      994           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      995           no-error .
      996         if error-status :error
      997         or error-status :get-message(1) <> ""
      998         then do:
      999           undo move_block, retry move_block.
     1000         end.
     1001         assign
     1002           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1003         no-error .
     1004         if error-status :error
     1005         or error-status :get-message(1) <> ""
     1006         then do:
     1007           undo move_block, retry move_block.
     1008         end.
     1009         if frame Dialog-Frame :scrollable = true
     1010         then do:
     1011           assign
     1012             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1013           no-error .
     1014           if error-status :error
     1015           or error-status :get-message(1) <> ""
     1016           then do:
     1017             undo move_block, retry move_block.
     1018           end.
     1019         end.
     1020       end.
     1021       if p-move-resize
     1022       then do:
     1023         run diasize_position-resize-button in this-procedure .
     1024       end.
     1025       if v-diasize-wndstore = true
     1026       then do:
     1027         if connected("ub") = true
     1028         then do:
     1029           define variable v-cntxt-db-num        as integer   no-undo .
     1030           define variable v-cntxt-userid        as character no-undo .
     1031           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1032                                             , OUTPUT v-cntxt-userid
     1033                                             ) .
     1034           run gbl/wndsizew.p
     1035             (input  v-cntxt-db-num
     1036             ,input  v-cntxt-userid
     1037             ,input  v-diasize-proc-name
     1038             ,input  'width':u
     1039             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1040             ) .
     1041         end.
     1042       end.
     1043     end.
     1044     assign
     1045       v-diasize-change-size = false
     1046     .
     1047   end procedure.
     1048   procedure diasize_set-width :
     1049     define input  parameter p-new-width  as decimal   no-undo .
     1050     define input  parameter p-move-resize as logical   no-undo .
     1051     do
     1052     on error undo, return error return-value
     1053     :
     1054       run diasize_change-width in this-procedure
     1055         (input  (p-new-width - frame Dialog-Frame :width)
     1056         ,input  p-move-resize
     1057         ) .
     1058     end.
     1059   end procedure.
     1060   procedure diasize_position-resize-button :
     1061     do with frame Dialog-Frame
     1062     :
     1063       hide v-diasize-resize-button .
     1064       assign
     1065         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1066                     - 1
     1067                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1068         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1069                     - 1
     1070                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1071       .
     1072       view v-diasize-resize-button .
     1073     end.
     1074   end procedure.
     1075   on alt-right anywhere
     1076   do:
     1077     run diasize_change-width in this-procedure
     1078       (input 1
     1079       ,input true
     1080       ) .
     1081     return no-apply .
     1082   end.
     1083   on alt-left anywhere
     1084   do:
     1085     run diasize_change-width in this-procedure
     1086       (input -1
     1087       ,input true
     1088       ) .
     1089     return no-apply .
     1090   end.
     1091   on alt-down anywhere
     1092   do:
     1093     run diasize_change-height in this-procedure
     1094       (input 1
     1095       ,input true
     1096       ) .
     1097     return no-apply .
     1098   end.
     1099   on alt-up anywhere
     1100   do:
     1101     run diasize_change-height in this-procedure
     1102       (input -1
     1103       ,input true
     1104       ) .
     1105     return no-apply .
     1106   end.
     1107   on alt-enter of frame Dialog-Frame
     1108   do:
     1109     run diasize_maximize in this-procedure
     1110       (input  ?
     1111       ).
     1112     return no-apply .
     1113   end.
     1114   procedure diasize_end-move :
     1115     do
     1116     on error undo, return error return-value
     1117     :
     1118       define variable v-row-delta as decimal   no-undo .
     1119       define variable v-col-delta as decimal   no-undo .
     1120       define variable v-new-row as decimal   no-undo .
     1121       define variable v-new-col as decimal   no-undo .
     1122       assign
     1123         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1124         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1125       .
     1126       assign
     1127         v-row-delta = v-new-row - frame Dialog-Frame :height
     1128         v-col-delta = v-new-col - frame Dialog-Frame :width
     1129       .
     1130       run diasize_change-height in this-procedure
     1131         (input v-row-delta
     1132         ,input true
     1133         ) .
     1134       run diasize_change-width in this-procedure
     1135         (input v-col-delta
     1136         ,input true
     1137         ) .
     1138     end.
     1139   end procedure.
     1140   procedure diasize_maximize :
     1141     define input  parameter p-action as logical   no-undo .
     1142     do
     1143     on error undo, return error return-value
     1144     :
     1145       if p-action = ?
     1146       then do:
     1147         if v-diasize-need-maximize = true
     1148         then do:
     1149           assign
     1150             p-action = true
     1151           .
     1152         end.
     1153         else do:
     1154           assign
     1155             p-action = false
     1156           .
     1157         end.
     1158       end.
     1159       if p-action = true
     1160       then do:
     1161         run diasize_change-height in this-procedure
     1162           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1163               - frame Dialog-Frame :height-chars
     1164           ,input true
     1165           ) .
     1166         run diasize_change-width in this-procedure
     1167           (input session :width-chars
     1168               - frame Dialog-Frame :width-chars
     1169           ,input true
     1170           ) .
     1171         assign
     1172           v-diasize-need-maximize = false
     1173         .
     1174       end.
     1175       else do:
     1176         run diasize_change-width in this-procedure
     1177           (input v-diasize-orig-frame-width
     1178               - frame Dialog-Frame :width-chars
     1179           ,input true
     1180           ) .
     1181         run diasize_change-height in this-procedure
     1182           (input v-diasize-orig-frame-height
     1183               - frame Dialog-Frame :height-chars
     1184           ,input true
     1185           ) .
     1186         assign
     1187           v-diasize-need-maximize = true
     1188         .
     1189       end.
     1190     end.
     1191   end procedure.
     1192   procedure diasize_restore-orig-size :
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196       assign
     1197         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1198         v-diasize-current-frame-height = frame Dialog-Frame :height
     1199       .
     1200       run diasize_set-height in this-procedure
     1201         (input  v-diasize-orig-frame-height
     1202         ,input  true
     1203         ) .
     1204       run diasize_set-width in this-procedure
     1205         (input  v-diasize-orig-frame-width
     1206         ,input  true
     1207         ) .
     1208     end.
     1209   end procedure.
     1210   procedure diasize_restore-current-size :
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       run diasize_set-height in this-procedure
     1215         (input  v-diasize-current-frame-height
     1216         ,input  true
     1217         ) .
     1218       run diasize_set-width in this-procedure
     1219         (input  v-diasize-current-frame-width
     1220         ,input  true
     1221         ) .
     1222     end.
     1223   end procedure.
     1224   procedure diasize_set-browse-handle :
     1225     define input  parameter p-browse-handle as handle   no-undo .
     1226     define buffer buf_temp-browse-handle for temp-browse-handle .
     1227     do
     1228     on error undo, return error return-value
     1229     :
     1230       assign
     1231         v-diasize-browse-handle = p-browse-handle
     1232       .
     1233       for each buf_temp-browse-handle
     1234       on error undo, return error return-value
     1235       :
     1236         delete buf_temp-browse-handle .
     1237       end.
     1238     end.
     1239   end procedure.
     1240   procedure diasize_add_browse :
     1241     define input  parameter p-browse-type   as character no-undo .
     1242     define input  parameter p-browse-handle as handle    no-undo .
     1243     define buffer buf_temp-browse-handle for temp-browse-handle .
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       assign
     1248         v-diasize-browse-number = v-diasize-browse-number + 1
     1249       .
     1250       create buf_temp-browse-handle .
     1251       assign
     1252         buf_temp-browse-handle.browse-type   = p-browse-type
     1253         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1254         buf_temp-browse-handle.browse-handle = p-browse-handle
     1255       .
     1256     end.
     1257   end procedure.
     1258   procedure diasize_init :
     1259     define variable v-default-value    as logical   no-undo .
     1260     define variable v-restore-saved    as logical   no-undo .
     1261     define variable v-resize-value-str as character no-undo .
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       do with frame Dialog-Frame
     1266       :
     1267         assign
     1268           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1269           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1270           v-diasize-browse-handle     = browse BROWSE-4 :handle
     1271         .
     1272         create button v-diasize-resize-button
     1273         assign
     1274           parent        = frame Dialog-Frame :first-child
     1275           label         = "s"
     1276           height-pixels = 16
     1277           width-pixels  = 16
     1278           visible       = true
     1279           sensitive     = true
     1280           movable       = true
     1281           triggers:
     1282             on end-move persistent run diasize_end-move in this-procedure .
     1283           end triggers.
     1284         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1285         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1286         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1287         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1288         assign
     1289           v-diasize-wndmax = false
     1290         .
     1291         if connected("ub") = true
     1292         then do:
     1293           define variable v-cntxt-db-num        as integer   no-undo .
     1294           define variable v-cntxt-userid        as character no-undo .
     1295           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1296                                             , OUTPUT v-cntxt-userid
     1297                                             ) .
     1298           run gbl/wndpar_r.p
     1299             (input  v-cntxt-db-num
     1300             ,input  v-cntxt-userid
     1301             ,input  'wndmax':U
     1302             ,output v-diasize-wndmax
     1303             ,output v-default-value
     1304             ) .
     1305         end.
     1306         assign
     1307           v-diasize-wndstore = false
     1308         .
     1309         if connected("ub") = true
     1310         then do:
     1311           run gbl/wndpar_r.p
     1312             (input  v-cntxt-db-num
     1313             ,input  v-cntxt-userid
     1314             ,input  'wndstore':U
     1315             ,output v-diasize-wndstore
     1316             ,output v-default-value
     1317             ) .
     1318         end.
     1319         assign
     1320           v-diasize-proc-name = entry(1, program-name(2), '.')
     1321         .
     1322         if v-diasize-wndstore = true
     1323         then do:
     1324           assign
     1325             v-restore-saved = false
     1326           .
     1327           if connected("ub") = true
     1328           then do:
     1329             run gbl/wndsizer.p
     1330               (input  v-cntxt-db-num
     1331               ,input  v-cntxt-userid
     1332               ,input  v-diasize-proc-name
     1333               ,input  'height':u
     1334               ,output v-resize-value-str
     1335               ) .
     1336             if v-resize-value-str <> '':U
     1337             then do:
     1338               run diasize_change-height in this-procedure
     1339                 (input  integer(v-resize-value-str)
     1340                 ,input  true
     1341                 ) .
     1342               assign
     1343                 v-restore-saved = true
     1344               .
     1345             end.
     1346           end.
     1347           if connected("ub") = true
     1348           then do:
     1349             run gbl/wndsizer.p
     1350               (input  v-cntxt-db-num
     1351               ,input  v-cntxt-userid
     1352               ,input  v-diasize-proc-name
     1353               ,input  'width':u
     1354               ,output v-resize-value-str
     1355               ) .
     1356             if v-resize-value-str <> '':U
     1357             then do:
     1358               run diasize_change-width in this-procedure
     1359                 (input  integer(v-resize-value-str)
     1360                 ,input  true
     1361                 ) .
     1362               assign
     1363                 v-restore-saved = true
     1364               .
     1365             end.
     1366           end.
     1367           if v-restore-saved <> true
     1368           then do:
     1369             if v-diasize-wndmax = true
     1370             then do:
     1371               run diasize_maximize in this-procedure
     1372                 (input  true
     1373                 ) .
     1374             end.
     1375           end.
     1376         end.
     1377         else do:
     1378           if v-diasize-wndmax = true
     1379           then do:
     1380             run diasize_maximize in this-procedure
     1381               (input  true
     1382               ) .
     1383           end.
     1384         end.
     1385       end.
     1386     end.
     1387   end procedure.
     1388   procedure diasize_need-full-display :
     1389     define output parameter p-need-full-display as logical   no-undo .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       assign
     1394         p-need-full-display = v-diasize-need-full-display
     1395       .
     1396       assign
     1397         v-diasize-need-full-display = false
     1398       .
     1399     end.
     1400   end procedure.
     1401   procedure get-context :
     1402      define output parameter p-db-num as integer          no-undo.
     1403      define output parameter p-user-id as character        no-undo.
     1404      define variable v-login               as character    no-undo.
     1405      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1406      define buffer buf_user-login  for ub.user-login .
     1407      do
     1408      on error undo, return error
     1409      :
     1410            FIND FIRST buf_sys-ctrl no-lock.
     1411            ASSIGN
     1412               v-login = USERID("ub")
     1413               p-db-num = buf_sys-ctrl.db-num
     1414            .
     1415            FIND FIRST buf_user-login
     1416                 WHERE buf_user-login.db-num = p-db-num
     1417                   AND buf_user-login.user-login = v-login
     1418                 no-lock
     1419                 no-error
     1420                 .
     1421            IF AVAILABLE buf_user-login
     1422            THEN DO:
     1423               assign
     1424                  p-user-id = buf_user-login.user-id
     1425               .
     1426            END.
     1427      end.
     1428   end procedure.
     1429       run diasize_init in this-procedure .
     1430   MAIN-BLOCK:
     1431   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1432      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1433      find first tt-table no-error .
     1434      if not available tt-table then do:
     1435         message "Нет данных !!! "  view-as alert-box information .
     1436         return .
     1437      end.
     1438      if tt-table.f1 = "" then  tt-table.f1:visible  in browse BROWSE-4 = false .
     1439      if tt-table.f2 = "" then  tt-table.f2:visible  in browse BROWSE-4 = false .
     1440      if tt-table.f3 = "" then  tt-table.f3:visible  in browse BROWSE-4 = false .
     1441      if tt-table.f4 = "" then  tt-table.f4:visible  in browse BROWSE-4 = false .
     1442      frame Dialog-Frame:TITLE  = entry(1 , p-title , chr(4) ).
     1443      if tt-table.f1 <> "" then tt-table.f1 :label  = entry( 2 , p-title , chr(4) ).
     1444      if tt-table.f2 <> "" then tt-table.f2 :label  = entry( 3 , p-title , chr(4) ).
     1445      if tt-table.f3 <> "" then tt-table.f3 :label  = entry( 4 , p-title , chr(4) ).
     1446      if tt-table.f4 <> "" then tt-table.f4 :label  = entry( 5 , p-title , chr(4) ).
     1447     run enable_UI in this-procedure .
     1448     WAIT-FOR GO OF FRAME Dialog-Frame.
     1449   END.
     1450   run disable_UI in this-procedure .
     1451   PROCEDURE disable_UI :
     1452     HIDE FRAME Dialog-Frame.
     1453   END PROCEDURE.
     1454   PROCEDURE enable_UI :
     1455     ENABLE B-exit B-Help BROWSE-4
     1456         WITH FRAME Dialog-Frame.
     1457     VIEW FRAME Dialog-Frame.
     1458     OPEN QUERY BROWSE-4 FOR EACH tt-table .
     1459   END PROCEDURE.
