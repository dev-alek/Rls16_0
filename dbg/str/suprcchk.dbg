      701   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      703                                                       ,input p-range-type as character
      704                                                       ,input p-code as integer):
      705   define variable v-seq-val as integer no-undo .
      706   define buffer buf_code-range for ub.code-range.
      707   find first buf_code-range no-lock where
      708             buf_code-range.db-num = p-db-num
      709       and  buf_code-range.range-type = p-range-type
      710       and  buf_code-range.stts = 'u'
      711       and buf_code-range.first-code <= p-code
      712       and buf_code-range.last-code >= p-code no-error .
      713   if available buf_code-range then return yes.
      714   CASE p-range-type:
      715     when 'pngb':U then do:
      716       v-seq-val = current-value(s-pngb-code, ub).
      717     end.
      718     when 'fmgb':U then do:
      719       v-seq-val = current-value(s-fmgb-code, ub).
      720     end.
      721   END CASE.
      722   if p-code <= v-seq-val then do:
      723     find first buf_code-range no-lock where
      724               buf_code-range.db-num = p-db-num
      725         and  buf_code-range.range-type = p-range-type
      726         and  buf_code-range.stts = 'a'
      727         and buf_code-range.first-code <= p-code
      728         no-error .
      729    if available buf_code-range then return yes.
      730   end.
      731   find first buf_code-range no-lock where
      732             buf_code-range.db-num = p-db-num
      733       and  buf_code-range.range-type = p-range-type
      734       and  buf_code-range.stts = 'f'
      735       and buf_code-range.first-code <= p-code
      736       and buf_code-range.last-code >= p-code
      737       no-error .
      738   if available buf_code-range then return yes.
      739   return no.
      740   END FUNCTION.
      741   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      742                                                       ,input p-range-type as character
      743                                                       ,input p-code as integer):
      744   define variable v-seq-val as integer no-undo .
      745   define buffer buf_code-range for ub.code-range.
      746   CASE p-range-type:
      747     when 'pngb':U then do:
      748       v-seq-val = current-value(s-pngb-code, ub).
      749     end.
      750     when 'fmgb':U then do:
      751       v-seq-val = current-value(s-fmgb-code, ub).
      752     end.
      753   END CASE.
      754   if p-code <= v-seq-val then do:
      755     find first buf_code-range no-lock where
      756               buf_code-range.db-num = p-db-num
      757         and  buf_code-range.range-type = p-range-type
      758         and buf_code-range.first-code <= p-code
      759         and buf_code-range.last-code >= p-code no-error .
      760     if available buf_code-range then return yes.
      761   end.
      762   return no.
      763   END FUNCTION.
      764   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      765                                                       ,input p-db-num as integer
      766                                                       ,input p-staff-code as integer
      767                                                       ,input p-date as date
      768                                                        ):
      769   define buffer buf_staff for ub.staff.
      770   if p-date = ? then do:
      771     p-date = today .
      772   end.
      773   find first buf_staff no-lock where
      774             buf_staff.role = p-role
      775         and buf_staff.role-level = 'db':U
      776         and buf_staff.db-num = p-db-num
      777         and buf_staff.staff-code = p-staff-code
      778         and buf_staff.date-end >= p-date use-index pi  no-error .
      779   if available buf_staff then do:
      780     return buf_staff.psn-code.
      781   end.
      782   return 0.
      783   end FUNCTION.
      784   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      785                                                             ,input p-db-num as integer
      786                                                             ,input p-date as date
      787                                                                 ):
      788   define buffer buf_staff for ub.staff.
      789   define buffer buf2_staff for ub.staff.
      790   if p-date = ? then do:
      791     p-date = today .
      792   end.
      793   for each  buf_staff no-lock where
      794             buf_staff.role = p-role
      795         and buf_staff.db-num = p-db-num,
      796   first buf2_staff no-lock where
      797         buf2_staff.role = p-role
      798     and buf2_staff.role-level = 'db':U
      799     and buf2_staff.staff-code = buf_staff.staff-code
      800     and buf2_staff.date-start <= p-date
      801     and buf2_staff.date-end >= p-date
      802   by buf_staff.staff-code
      803   by date-start descending:
      804     return buf_staff.staff-code.
      805   end.
      806   end FUNCTION.
      807   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      808                                                  ,input p-db-num as integer
      809                                                  ,input p-psn-code as integer
      810                                                  ,input p-date as date
      811                                                  ,output p-c-password as character
      812                                                        ):
      813   define buffer buf_staff for ub.staff.
      814   if p-date = ? then do:
      815     p-date = today .
      816   end.
      817   find first buf_staff no-lock where
      818             buf_staff.role = p-role
      819         and buf_staff.role-level = 'db':U
      820         and buf_staff.db-num = p-db-num
      821        and buf_staff.date-end >= p-date
      822        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      823   if available buf_staff
      824   then do:
      825     assign
      826     p-c-password = buf_staff.password.
      827     return buf_staff.staff-code.
      828   end.
      829   p-c-password = ''.
      830   return 0.
      831   end FUNCTION.
      832   FUNCTION gbclcode-is-psn-role returns integer (
      833                                                 input p-role as character
      834                                                 ,input p-psn-code as integer
      835                                                 ,input p-date as date
      836                                                     ):
      837   define buffer buf_staff for ub.staff.
      838   if p-date = ? then do:
      839     p-date = today .
      840   end.
      841   for each buf_staff no-lock where
      842             buf_staff.psn-code = p-psn-code
      843        and  buf_staff.role = p-role
      844   by buf_staff.role-level
      845   by buf_staff.date-start
      846        :
      847     if  buf_staff.date-start <= p-date and
      848     buf_staff.date-end >= p-date  then do:
      849       return buf_staff.staff-code.
      850     end.
      851   end.
      852   return 0.
      853   end FUNCTION.
      854   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      855   define variable v-role-name as character no-undo .
      856   assign
      857   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      858   no-error .
      859   return v-role-name.
      860   END.
      861   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      862   FUNCTION gbclcode-get-position returns character ( input p-role as character
      863                                                     ,input p-role-level as character
      864                                                     ,input p-work-place as character
      865                                                     ,input p-staff-code as integer
      866                                                                ):
      867   define variable v-role-name as character no-undo .
      868   define variable v-role-level as character no-undo .
      869   define variable v-staff-code as integer no-undo .
      870   assign
      871   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      872   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      873   v-staff-code = p-staff-code
      874   no-error .
      875   return substitute("&1, &2, Код &3"
      876                   ,v-role-name
      877                   ,v-role-level
      878                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      879   END.
      880   FUNCTION gbclcode-get-work-place returns character (
      881                                                   input p-role as character
      882                                                  ,input p-role-level as character
      883                                                  ,input p-db-num as integer
      884                                                  ,input p-host-code as integer
      885                                                  ,input p-obj-type as character
      886                                                  ,input p-obj-code as integer
      887                                                  ) :
      888   define variable v-work-place as character no-undo .
      889   define variable v-obj-type as character no-undo .
      890     case p-role-level:
      891       when 'db':U then do:
      892         v-work-place = string(p-db-num, "99999").
      893       end.
      894       when 'firm':U then do:
      895         v-work-place = string(p-host-code, "99999").
      896       end.
      897       when 'object':U then do:
      898         assign
      899         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      900         .
      901       end.
      902     END CASE.
      903     return v-work-place.
      904   END FUNCTION.
      905   FUNCTION gbclcode-get-level-last-code returns integer (
      906                                                           input p-role as character
      907                                                         , input p-role-level as character
      908                                                         , input p-work-place as character
      909                                                         , input p-date-start as date
      910                                                         ):
      911   DEFINE VARIABLE v-today as date no-undo .
      912   define buffer buf_staff for ub.staff.
      913   if p-work-place = chr(63) then return ?.
      914   if p-date-start = ? then do:
      915     v-today = today .
      916   end.
      917   else do:
      918     v-today = p-date-start.
      919   end.
      920   find last buf_staff no-lock where
      921             buf_staff.role = p-role
      922        and  buf_staff.role-level = p-role-level
      923        and  buf_staff.work-place = p-work-place
      924        and  buf_staff.date-start <= v-today + 1
      925        and  buf_staff.date-end >= v-today + 1
      926        use-index pi  no-error .
      927   if available buf_staff
      928   then return buf_staff.staff-code.
      929   return 0.
      930   end FUNCTION.
      931   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   define variable paycardv as character no-undo .
      933   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
      934   define variable kk as integer no-undo .
      935   define variable pay-card-num as character no-undo .
      936   define buffer buf_cash-pay for ub.cash-pay.
      937   find first buf_cash-pay no-lock where
      938              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
      939          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
      940   if not avail buf_cash-pay then return "":U.
      941   if p-pay-card = "":u
      942   or p-pay-card = ? then return "":U.
      943   assign
      944   pay-card-num = "":U
      945   .
      946   _kk:
      947   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
      948     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
      949       assign
      950       pay-card-num = p-pay-card
      951       .
      952       return pay-card-num.
      953     end.
      954   end.
      955   if pay-card-num = "":u then do:
      956     if length(p-pay-card) > 4 then
      957     assign
      958     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
      959                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
      960     .
      961     else
      962     return fill("*":U, length(p-pay-card)).
      963   end.
      964   return pay-card-num.
      965   END FUNCTION.
