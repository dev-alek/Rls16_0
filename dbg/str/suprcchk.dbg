     1468   ON VALUE-CHANGED OF Cb-chk-type IN FRAME Dialog-Frame
     1469   DO:
     1470     IF CAN-FIND(FIRST tt-chk-gds WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code)
     1471     OR CAN-FIND(FIRST tt-chk-pay WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code)
     1472         THEN DO:
     1473         MESSAGE
     1474         "Установить тип чека можно только в самом начале процесса создания чека" SKIP
     1475         "когда еще не созданы товарные строки и строк оплаты"
     1476         VIEW-AS ALERT-BOX ERROR.
     1477         display cb-chk-type
     1478         with frame Dialog-Frame .
     1479         RETURN NO-APPLY.
     1480     END.
     1481     ASSIGN
     1482     CB-chk-type
     1483     .
     1484     if cb-chk-type = '8':U then do:
     1485       if get-chkc_context.annu-check = no then do:
     1486         message
     1487         substitute("Чек типа &1 можно получить только если включен параметр <принимать аннулированные чеки>&2" +
     1488                     "АРМ Администратор-Справочники-Магазины-Параметры-Опции закачки чеков&2" +
     1489                     "или&2" +
     1490                     "АРМ Администратор-Список фирм-Параметры-Опции закачки чеков"
     1491                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     1492                   , chr(10)
     1493                   )
     1494         view-as alert-box error .
     1495         assign
     1496         cb-chk-type = '1':U.
     1497         display
     1498         cb-chk-type
     1499         with frame Dialog-Frame .
     1500         return no-apply.
     1501       end.
     1502     end.
     1503     if lookup(cb-chk-type, '14,15,16,17,36':U) > 0 then do:
     1504       if ptrl-check = no then do:
     1505         message
     1506         substitute("Чек типа &1 можно получить только если включен параметр <принимать специф.чеки АЗК>&2" +
     1507                     "АРМ Администратор-Справочники-Магазины-Параметры-Опции закачки чеков&2" +
     1508                     "или&2" +
     1509                     "АРМ Администратор-Список фирм-Параметры-Опции закачки чеков"
     1510                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     1511                   , chr(10)
     1512                   )
     1513         view-as alert-box error .
     1514         assign
     1515         cb-chk-type = '1':U.
     1516         display
     1517         cb-chk-type
     1518         with frame Dialog-Frame .
     1519         return no-apply.
     1520       end.
     1521     end.
     1522     if cb-chk-type = '69':U
     1523     or cb-chk-type = '96':U then do:
     1524       if not ub.shop.is-catering then do:
     1525         message
     1526         substitute("Чек типа &1 можно получить только на объекте, на котором включена опция РЕСТОРАН&2"
     1527                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     1528         view-as alert-box error .
     1529         assign
     1530         cb-chk-type = '1':U.
     1531         display
     1532         cb-chk-type
     1533         with frame Dialog-Frame .
     1534         return no-apply.
     1535       end.
     1536     end.
     1537     assign
     1538     tt-chk-doc.chk-type = integer(CB-chk-type)
     1539     locked_c-chk-doc.chk-type = integer(CB-chk-type).
     1540     case CB-chk-type:
     1541       when '96':U
     1542       or when '69':U
     1543       then do:
     1544         ASSIGN
     1545         b-discnt:SENSITIVE IN FRAME Dialog-Frame = YES
     1546         .
     1547       end.
     1548       WHEN  '14':U
     1549       OR
     1550       WHEN  '16':U
     1551       OR
     1552       WHEN  '15':U
     1553       OR
     1554       WHEN  '17':U
     1555       OR
     1556       WHEN  '36':U THEN DO:
     1557            assign
     1558            b-discnt:SENSITIVE IN FRAME Dialog-Frame = NO
     1559            .
     1560       end.
     1561       otherwise do:
     1562           if v-is-catering then
     1563           ASSIGN
     1564           b-discnt:SENSITIVE IN FRAME Dialog-Frame = YES
     1565           .
     1566       END.
     1567     END CASE.
     1568   END.
