      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      102                                                                     input  orders as integer):
      103   define variable  round-m-sum as decimal no-undo.
      104   if orders >= 0 then
      105   round-m-sum = round(mysum,orders).
      106   else
      107   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      108   return round-m-sum.
      109   END FUNCTION.
