     1570   DO:
     1571     assign corr-date.
     1572   END.
     1573   ON LEAVE OF f-cause-corr IN FRAME Dialog-Frame
     1574   DO:
     1575     assign f-cause-corr.
     1576   END.
     1577   ON LEAVE OF f-num-corr IN FRAME Dialog-Frame
     1578   DO:
     1579     assign f-num-corr.
     1580   END.
     1581   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1582   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1583   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1584   on help of frame Dialog-Frame
     1585   do:
     1586     run gbl/app_help.p
     1587       (input this-procedure :file-name
     1588       ,input ''
     1589       ,input ?
     1590       ) no-error.
     1591     if error-status :error then do:
     1592       message
     1593         "Ошибка при вызове помощи"
     1594         error-status :get-message(1)
     1595         view-as alert-box .
     1596     end.
     1597   end.
     1598   run minbtn-set in this-procedure .
     1599   on choose of b-help in frame Dialog-Frame
     1600   do:
     1601     apply "help":u to frame Dialog-Frame .
     1602   end.
     1603   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1604   procedure minbtn-set :
     1605       do
     1606           on error undo, return error return-value
     1607           :
     1608           define variable ii              as integer       no-undo .
     1609           define variable fh              as widget-handle no-undo .
     1610           define variable hh              as widget-handle no-undo .
     1611           define variable v-h             as handle        extent 4 no-undo .
     1612           define variable v-name-button   as character     no-undo .
     1613           define variable v-help-old-x    as decimal       no-undo .
     1614           define variable v-help-old-y    as decimal       no-undo .
     1615           define variable v-help-old-size as decimal       no-undo .
     1616           define variable v-frame-width   as decimal       no-undo .
     1617           define variable jj              as integer       no-undo .
     1618           do
     1619               on error undo, return error
     1620               :
     1621               assign
     1622                   v-frame-width = frame Dialog-Frame:width - 0.3
     1623                   fh            = frame Dialog-Frame:first-child
     1624                   hh            = fh:first-child
     1625                   ii            = 1
     1626                   .
     1627               do while valid-handle(hh):
     1628                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1629                   do:
     1630                       case lc(hh:name) :
     1631                           when "b-help" then
     1632                               do:
     1633                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1634                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1635                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1636                                   hh:TOOLTIP = "Помощь" .
     1637                                   v-help-old-x = hh:column .
     1638                                   v-help-old-y = hh:row    .
     1639                                   v-help-old-size = hh:width .
     1640                                   hh:width-chars = 2.5 .
     1641                               end.
     1642                           when "b-print" then
     1643                               do:
     1644                                   hh:load-image("cmp/b-print.bmp":u) .
     1645                                   hh:TOOLTIP = "Печать" .
     1646                                   v-h[ii] = hh:handle .
     1647                                   ii = ii + 1 .
     1648                                   hh:width-chars = 3 .
     1649                               end.
     1650                           when "b-history" or
     1651                           when "b-hist" then
     1652                               do:
     1653                                   hh:load-image("cmp/b-hist.bmp":u) .
     1654                                   hh:TOOLTIP = "История" .
     1655                                   v-h[ii] = hh:handle .
     1656                                   ii = ii + 1 .
     1657                                   hh:width-chars = 3 .
     1658                               end.
     1659                           when "b-sch" then
     1660                               do:
     1661                                   hh:load-image("cmp/b-sch.bmp":u) .
     1662                                   hh:TOOLTIP = "Установка Фильтра" .
     1663                                   v-h[ii] = hh:handle .
     1664                                   ii = ii + 1 .
     1665                                   hh:width-chars = 3 .
     1666                               end.
     1667                           when "b-hist-user" then
     1668                               do:
     1669                                   hh:load-image("cmp/b-hist.bmp":u) .
     1670                                   hh:TOOLTIP = "История пользователя" .
     1671                                   ii = ii + 1 .
     1672                               end.
     1673                       end case.
     1674                   end.
     1675                   hh = hh:next-sibling.
     1676               end.
     1677               b-help:column = v-frame-width - b-help:width-chars.
     1678               jj = 0.
     1679               repeat ii = 4 to 1 by -1 :
     1680                   if valid-handle (v-h[ii] ) then
     1681                   do:
     1682                       jj  = jj + 1 .
     1683                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1684                       v-h[ii]:row    = v-help-old-y .
     1685                   end.
     1686               end.
     1687           end.
     1688       end.
     1689   end procedure.
     1690   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1691   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1692   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1693   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1694   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1695   define variable v-diasize-current-frame-height as decimal   no-undo .
     1696   define variable v-diasize-change-size          as logical   no-undo .
     1697   define variable v-diasize-resize-button        as handle    no-undo .
     1698   define variable v-diasize-wndmax               as logical   no-undo .
     1699   define variable v-diasize-wndstore             as logical   no-undo .
     1700   define variable v-diasize-proc-name            as character no-undo .
