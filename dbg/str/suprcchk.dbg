      973   FIELD src-price-netto like ub.chk-gds.price-base
      974   FIELD src-sum-netto like ub.chk-doc.netto
      975   FIELD d-pcnt like ub.chk-doc.d-pcnt
      976   FIELD price-netto like ub.chk-gds.price-base
      977   FIELD sum-netto like ub.chk-doc.netto
